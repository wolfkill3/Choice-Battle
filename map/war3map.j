function ShadowStormCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1
local real y1
local real a
local real f=GetUnitFacing(u)
local real dmg=GetHeroAgi(u,true)*0.075
local real time=LoadReal(h,id,6)
local player p=GetOwningPlayer(u)
if time>0 then
call SetUnitXY_1(l__d,x,y, false)
call SetUnitFacing(l__d,f)
call UnitApplyTimedLife(CreateUnit(p,'e08A',x,y,GetRandomReal(0,359)),'BTLF',0.3)
call GroupEnumUnitsInRange(G,x,y,250,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
set x1=GetUnitX(E)
set y1=GetUnitY(E)
set a=Atan2(y-y1,x-x1)+1.2
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetUnitX(E,x1+45*Cos(a))
call SetUnitY(E,y1+45*Sin(a))
endif
call GroupRemoveUnit(G,E)
endloop
call SaveReal(h,id,6,time-0.03)
else
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set p=null
set u=null
set t=null
endfunction
