//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
set soundplay=SndN(2054) // Sound\Music\mp3Music\GonGW.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call TimerStart(t,0.1,true,function ScissorsCast2)
set u=null
set p=null
set c=null
set t=null
endfunction
