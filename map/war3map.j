function CrystalStrykeInoriCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local group g=LoadGroupHandle(h,id,60)
local group gn=LoadGroupHandle(h,id,61)
local integer i=0
local real x=LoadReal(h,id,50)
local real y=LoadReal(h,id,51)
local real x1=0
local real y1=0
local real x2
local real y2
local real dist
local real f=0
local real dmg=GetHeroInt(u,true)*(GetUnitAbilityLevel(u,'A0UJ')+1)+100
local integer l__idg=GetHandleId(g)
local player p=GetOwningPlayer(u)
loop
set i=i+1
exitwhen i>6
set n=LoadUnitHandle(h,id,1+i)
set f=(GetUnitFacing(n)+7.5)*bj_DEGTORAD
set dist=LoadReal(h,id,StringHash("dist"+I2S(i)))+60
call SaveReal(h,id,StringHash("Dist"+I2S(i)),dist)
set x1=x+dist*Cos(f)
set y1=y+dist*Sin(f)
call SetUnitFacing(n,f*bj_RADTODEG)
call DestroyEffect(AddSpecialEffect("war3mapImported\\jiejin.mdx",x1,y1))
call SetUnitX(n,x1)
call SetUnitY(n,y1)
endloop
call GroupEnumUnitsInRange(g,x,y,dist,Base)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set ide=GetHandleId(E)
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 2, "stun")
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",E,"chest"))
call SaveUnitHandle(h,l__idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
if dist>=500 then
call ForGroup(gn,function KillGroup2)
call DestroyGroup(g)
call DestroyGroup(gn)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
set gn=null
set u=null
set g=null
set t=null
set p=null
endfunction
