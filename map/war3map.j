        call SetFrameParent( SpectacleCaptainSelect0Text, SpectacleCaptainSelect0 )
        call SetFrameText( SpectacleCaptainSelect0Text, "First pick to "+udg_Color[1]+GetPlayerName(Player(0))+"|r")
        call ShowFrame( SpectacleCaptainSelect0Text, GetPlayerId(GetLocalPlayer())==10 or GetPlayerId(GetLocalPlayer())==11 )
        call SetFrameRelativePoint( SpectacleCaptainSelect0Text, FRAMEPOINT_CENTER, SpectacleCaptainSelect0, FRAMEPOINT_CENTER, .00011, .0 ) 

        set tOnPress = CreateTrigger( )
        set tOnUnPress = CreateTrigger( )
        set tOnClick = CreateTrigger( )
        call TriggerRegisterFrameEvent( tOnPress, SpectacleCaptainSelect0, FRAMEEVENT_MOUSE_DOWN )
        call TriggerRegisterFrameEvent( tOnUnPress, SpectacleCaptainSelect0, FRAMEEVENT_MOUSE_UP )
        call TriggerRegisterFrameEvent( tOnClick, SpectacleCaptainSelect0, FRAMEEVENT_CONTROL_CLICK )

        call TriggerAddAction( tOnPress, function OnButtonPress )
        call TriggerAddAction( tOnUnPress, function OnButtonUnpress )
        call TriggerAddAction( tOnClick, function OnButtonSelectTeam )

        set SpectacleCaptainSelect1=CreateFrameByType( "SIMPLEBUTTON", "TavernSelectPlayer2", null, "", 0 )
        call ClearFrameAllPoints( SpectacleCaptainSelect1 )
        call SetFrameTexture( SpectacleCaptainSelect1, "checkbox-depressed2.blp", 0, true )
        call SetFrameTexture( SpectacleCaptainSelect1, "checkbox-depressed2.blp", 1, true )
        call SetFrameTexture( SpectacleCaptainSelect1, "checkbox-depressed2.blp", 2, true )
        call SetFrameSize( SpectacleCaptainSelect1, .12, .035 )
        call ShowFrame( SpectacleCaptainSelect1, GetPlayerId(GetLocalPlayer())==10 or GetPlayerId(GetLocalPlayer())==11 )
        call SetFramePriority( SpectacleCaptainSelect1, 7 )
        call SetFrameRelativePoint( SpectacleCaptainSelect1, FRAMEPOINT_CENTER, TavernHeroFrame, FRAMEPOINT_TOP, 0.15, -.112 )

        set SpectacleCaptainSelect1Text=CreateFrameByType( "SIMPLETEXT", "TavernSelectPlayerText2", SpectacleCaptainSelect1, "", 0 )
        call ClearFrameAllPoints( SpectacleCaptainSelect1Text )
        call SetFrameBlendMode( SpectacleCaptainSelect1Text, 0, BLEND_MODE_BLEND )
        call SetFrameFont( SpectacleCaptainSelect1Text, "Fonts\\FRIZQT__.TTF", .01, 0 )
        call SetFrameTextAlignment( SpectacleCaptainSelect1Text, TEXT_JUSTIFY_CENTER, TEXT_JUSTIFY_MIDDLE )
        call SetFrameTextColour( SpectacleCaptainSelect1Text, 0xFFFFA500 )
        call SetFrameParent( SpectacleCaptainSelect1Text, SpectacleCaptainSelect1 )
        call SetFrameText( SpectacleCaptainSelect1Text, "First pick to "+udg_Color[6]+GetPlayerName(Player(5))+"|r")
        call ShowFrame( SpectacleCaptainSelect1Text, GetPlayerId(GetLocalPlayer())==10 or GetPlayerId(GetLocalPlayer())==11 )
        call SetFrameRelativePoint( SpectacleCaptainSelect1Text, FRAMEPOINT_CENTER, SpectacleCaptainSelect1, FRAMEPOINT_CENTER, .00011, .0 ) 

        set tOnPress = CreateTrigger( )
        set tOnUnPress = CreateTrigger( )
        set tOnClick = CreateTrigger( )
        call TriggerRegisterFrameEvent( tOnPress, SpectacleCaptainSelect1, FRAMEEVENT_MOUSE_DOWN )
        call TriggerRegisterFrameEvent( tOnUnPress, SpectacleCaptainSelect1, FRAMEEVENT_MOUSE_UP )
        call TriggerRegisterFrameEvent( tOnClick, SpectacleCaptainSelect1, FRAMEEVENT_CONTROL_CLICK )

        call TriggerAddAction( tOnPress, function OnButtonPress )
        call TriggerAddAction( tOnUnPress, function OnButtonUnpress )
        call TriggerAddAction( tOnClick, function OnButtonSelectTeam )

        set i=0
        loop
        exitwhen i>=9
        set TavernPlayerPickAllow[i]=false
        set i=i+1
        endloop
        call SetFrameColourEx( TavernHeroRandom,0, 0xFF404040 )
        call SetFrameColourEx( TavernHeroRandom,1, 0xFF404040 )
        call SetFrameColourEx( TavernHeroRandom,2, 0xFF404040 )
        call SetFrameColourEx( TavernHeroPick,0, 0xFF902020 )
        call SetFrameColourEx( TavernHeroPick,1, 0xFF902020 )
        call SetFrameColourEx( TavernHeroPick,2, 0xFF902020 )
        call SetFrameText( TavernHeroPickText, "Ban")
        // set TavernPlayerPickAllow[team]=true
        // if GetLocalPlayer()==Player(team) then
        //     call SetFrameColourEx( TavernHeroPick,0, 0xFFFF2020 )
        //     call SetFrameColourEx( TavernHeroPick,1, 0xFFFF2020 )
        //     call SetFrameColourEx( TavernHeroPick,2, 0xFFFF2020 )
        // endif
        set cmb=false
        set udg_RM=true
        set cmi=8
        set cmi2=8
        //call DisableTrigger(gg_trg_MoveHeroes)
        call TimerStart(udg_Timer4, 60.0,false,null) //Start
        call ShowFrame( GetOriginFrame( ORIGIN_FRAME_MULTIBOARD, 0 ), false ) 
        set udg_Captain=CreateTimerDialog(udg_Timer4)
        call LANG_TdTitle(udg_Captain,"Осталось времени:","Time left:")
        call TimerDialogDisplay(udg_Captain,true)
        call DisplayTopMessage(GetLocalPlayer(),"Captain Mode")
        call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,Lng("Судьи выбирают команду, которая будет выбирать первой.","The judges choose the team to pick first."))
    else
        set cmp=GetRandomInt(1,2)
        if cmp==1 then
            set Globalteam = 0
        elseif cmp==2 then
            set Globalteam = 5
        endif
        set i=0
        loop
        exitwhen i>=9
        call W3MMD_Lite_Set_String(Player(i),"Game_Mode","Captain Mode")
        set TavernPlayerPickAllow[i]=false
        set i=i+1
        endloop
        call SetFrameColourEx( TavernHeroRandom,0, 0xFF404040 )
        call SetFrameColourEx( TavernHeroRandom,1, 0xFF404040 )
        call SetFrameColourEx( TavernHeroRandom,2, 0xFF404040 )
        call SetFrameColourEx( TavernHeroPick,0, 0xFF902020 )
        call SetFrameColourEx( TavernHeroPick,1, 0xFF902020 )
        call SetFrameColourEx( TavernHeroPick,2, 0xFF902020 )
        call SetFrameText( TavernHeroPickText, "Ban")
        // set TavernPlayerPickAllow[Globalteam]=true
        // if GetLocalPlayer()==Player(Globalteam) then
        //     call SetFrameColourEx( TavernHeroPick,0, 0xFFFF2020 )
        //     call SetFrameColourEx( TavernHeroPick,1, 0xFFFF2020 )
        //     call SetFrameColourEx( TavernHeroPick,2, 0xFFFF2020 )
        // endif
        set cmb=true
        set cmi=8
        set cmi2=8
        //call DisableTrigger(gg_trg_MoveHeroes)
        call TimerStart(udg_Timer4,  20,false,null) //Start
        call ShowFrame( GetOriginFrame( ORIGIN_FRAME_MULTIBOARD, 0 ), false ) 
        set udg_Captain=CreateTimerDialog(udg_Timer4)
        call LANG_TdTitle(udg_Captain,"Осталось времени на подготовку:","Time left to prepare:")
        call TimerDialogDisplay(udg_Captain,true)
        call DisplayTopMessage(GetLocalPlayer(),"Captain Mode")
        if cmp==1 then
            call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,Lng("Подготовка, начинает первая команда.","Preparations, the first team begins."))
            // call AddFrameText(TavernChat,"Очередь первой команды.")
        elseif cmp==2 then
            call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,Lng("Подготовка, начинает вторая команда.","Preparations, the second team begins."))
            // call AddFrameText(TavernChat,"Очередь второй команды.")
        endif
    endif
endif
