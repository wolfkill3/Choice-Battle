set u=null
set p=null
set c=null
endfunction
function BeeStrikeCond takes nothing returns boolean
return GetSpellAbilityId()=='A0LL' and udg_B==true
endfunction
function BeeStrikeCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=LoadReal(h,id,5)
local real dmg=(GetUnitAbilityLevel(u,'A0LL')+4)*GetHeroAgi(u,true)
local player p=GetOwningPlayer(u)
local real time=LoadReal(h,id,7)
local real mt=LoadReal(h,id,8)
if mt>0 and UnitIsAlive(u)then
set x1=x1-40*Cos(a)
set y1=y1-40*Sin(a)
call SetUnitXY_1(u,x1,y1, false)
if time<0 then
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call PauseUnit(u,true)
call SetUnitInvulnerable(c,true)
call SetUnitInvulnerable(u,true)
set x1=x1+53*Cos(a)
set y1=y1+53*Sin(a)
call SetUnitXY_1(c,x1,y1, false)
call UnitApplyTimedLife(CreateUnit(p,'e0HD',x,y,a*bj_RADTODEG),'BTLF',0.3)
call UnitApplyTimedLife(CreateUnit(p,'e0HE',x,y,a*bj_RADTODEG),'BTLF',0.3)
call UnitApplyTimedLife(CreateUnit(p,'e0HC',x1,y1,a*bj_RADTODEG),'BTLF',0.5)
call UnitApplyTimedLife(CreateUnit(p,'e0HB',x1,y1,GetRandomReal(0,359)),'BTLF',0.5)
call UnitApplyTimedLife(CreateUnit(p,'e0HA',x1,y1,GetRandomReal(0,359)),'BTLF',0.5)
set n=CreateUnit(p,'e0GZ',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.2)
call SetUnitVertexColor(n,190,255,255,50)
call SetUnitAnimation(n,"attack")
set n=CreateUnit(p,'e0H9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.6)
call SetUnitVertexColor(n,200,200,200,70)
call SaveReal(h,id,7,mt)
call SaveReal(h,id,8,mt-0.2)
endif
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitAnimation(u,"attack")
call SaveReal(h,id,7,LoadReal(h,id,7)-3)
else
call Push3(c,35,a,600,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\KillerBeeSwords.mdx",c,"chest"))
call SetUnitInvulnerable(c,false)
call SetUnitInvulnerable(u,false)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call PauseUnit(u,false)
call myCustomDamage(u,c,dmg,false,false,null,null,null)
call SetControlToUnit(u,c,2, "stun")
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitVertexColor(u,255,255,255,255)
call FlushChildHashtable(h,id)
call SetUnitTimeScale(u,1)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function BeeStrikeCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
    call PauseUnit(c,true)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
    call PauseUnit(u,true)
    call SetUnitInvulnerable(c,true)
    call SetUnitInvulnerable(u,true)
    call SaveUnitHandle(h,id,0,u)
    call SaveUnitHandle(h,id,1,c)
    call SaveReal(h,id,7,10)
    call SaveReal(h,id,8,10)
    call SaveReal(h,id,5,Atan2(y1-y,x1-x))
    call SetUnitXY_1(u,x1,y1, false)
    call SetUnitVertexColor(u,255,255,255,125)
    call SetUnitTimeScale(u,3)
    call SetUnitAnimation(u,"attack")
    set soundplay=SndN(1502) // Sound\Music\mp3Music\HachibiAttacking.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call TimerStart(t,0.04,true,function BeeStrikeCast2)
else
    call SetUnitXY_1(u,x1,y1, false)
    call SetUnitTimeScale(u,1)
    call SetUnitInvulnerable(u,false)
    call PauseUnit(u,false)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
    call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
    call SetUnitFlyHeight(u,0,0)
    call SetUnitFlyHeight(c,0,0)
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(h,id)
endif
set t=null
set u=null
set p=null
set c=null
endfunction
function BeeStrikeInit takes nothing returns nothing
endfunction
function HachibiStrikeEnd2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,5)
local unit l__d=LoadUnitHandle(h,id,0)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
call UnitApplyTimedLife(CreateUnit(p,'e03X',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03W',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e08R',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03Y',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e08N',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e09L',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e09M',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitRemoveAbility(u,'A0GJ')
call SetUnitFlyHeight(u,0,0)
call SetUnitInvulnerable(l__d,false)
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
call PauseUnit(l__d,false)
call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,false)
call myCustomDamage(u,l__d,(3+GetUnitAbilityLevel(u,'A0LC'))*GetHeroAgi(u,true),false,false,null,null,null)
call SetUnitTurnSpeed(u,0.60)
call SetUnitVertexColor(u,255,255,255,255)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
set p=null
set l__d=null
set u=null
endfunction
function Push_HachibiStrike2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local unit u=LoadUnitHandle(h,id,5)
local real speed=LoadReal(h,id,1)
local real a=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real dist=LoadReal(h,id,3)
local player p=GetOwningPlayer(u)
if dist>0 and IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SaveReal(h,id,3,dist-speed)
call SaveReal(h,id,1,speed-speed*0.03)
call DestroyEffect(AddSpecialEffect(LoadStr(h,id,4),x,y))
else
call PauseTimer(t)
call SetUnitXY_1(u,x,y, false)
call SetUnitFlyHeight(u,300,0)
call SetUnitAnimation(u,"Attack Slam")
call TimerStart(t,0.2,false,function HachibiStrikeEnd2)
endif
set p=null
set u=null
set l__d=null
set t=null
endfunction
function Push_HachibiStrike takes unit l__d,real speed,real angle,real dist,string l__s,unit u returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle)
call SaveReal(h,id,3,dist)
call SaveStr(h,id,4,l__s)
call SaveUnitHandle(h,id,5,u)
call TimerStart(t,0.03,true,function Push_HachibiStrike2)
set t=null
endfunction
function CondHachibiStrike takes nothing returns boolean
return GetSpellAbilityId()=='A0LC' and udg_B==true
endfunction
function HachibiStrikeAct2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit d1=LoadUnitHandle(h,id,5)
local unit d2=LoadUnitHandle(h,id,6)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real x2=0
local real y2=0
local integer i=LoadInteger(h,id,2)
local player p=GetOwningPlayer(u)
local real a=0
local real f
if i<21 and GetWidgetLife(c)>0 and GetWidgetLife(u)>0 and udg_B==true and DU2==true then
set a=Atan2(y1-GetUnitY(u),x1-GetUnitX(u))
call Push3(c,25,a,55,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
call UnitApplyTimedLife(CreateUnit(p,'e0HA',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",x1,y1))
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call PauseUnit(u,true)
call SetUnitInvulnerable(c,true)
call SetUnitInvulnerable(u,true)
set f=GetRandomReal(0,359)*bj_DEGTORAD
set x2=x1+100*Cos(f)
set y2=y1+100*Sin(f)
call SetUnitXY_1(u,x2,y2, false)
call SetUnitAnimation(u,"attack")
set f=GetRandomReal(0,359)*bj_DEGTORAD
set x2=x1+100*Cos(f)
set y2=y1+100*Sin(f)
call SetUnitX(d1,x2)
call SetUnitY(d1,y2)
call SetUnitAnimation(d1,"attack")
set f=GetRandomReal(0,359)*bj_DEGTORAD
set x2=x1+100*Cos(f)
set y2=y1+100*Sin(f)
call SetUnitX(d2,x2)
call SetUnitY(d2,y2)
call SetUnitAnimation(d2,"attack")
call SaveInteger(h,id,2,i+1)
else
call DestroyTimer(t)
call RemoveUnit(d1)
call RemoveUnit(d2)
set a=Atan2(y1-GetUnitY(u),x1-GetUnitX(u))
call Push_HachibiStrike(c,40,a,600,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",u)
call FlushChildHashtable(h,id)
endif
set d1=null
set d2=null
set p=null
set u=null
set c=null
set t=null
endfunction
function HachibiStrikeAct takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real f=GetUnitFacing(u)
local player p=GetOwningPlayer(u)
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
    call UnitAddAbility(u,'A0GJ')
    call SetUnitVertexColor(u,255,255,255,100)
    call SaveUnitHandle(h,id,0,u)
    call SaveUnitHandle(h,id,1,c)
    set n=CreateUnit(p,'e0GZ',x,y,f)
    call UnitAddAbility(n,'A0GJ')
    call SetUnitVertexColor(n,255,255,255,100)
    call SaveUnitHandle(h,id,5,n)
    set n=CreateUnit(p,'e0GZ',x,y,f)
    call UnitAddAbility(n,'A0GJ')
