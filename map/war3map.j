return GetSpellAbilityId()=='A0DA' and udg_B
endfunction
function MillionStabCast3 takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(h,id,0)
        local unit c=LoadUnitHandle(h,id,1)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        local real x1=GetUnitX(c)
        local real y1=GetUnitY(c)
        local real x2
        local real y2
        local real r=LoadReal(h,id,2)
        local real a=Atan2(y1-y,x1-x)
        local real l__d=GetRandomReal(-30,30)
        local player p=GetOwningPlayer(u)
        local real dmg=100+GetHeroStr(u,true)*(1+GetUnitAbilityLevel(u,'A0DA'))
        local boolean b=LoadBoolean(h,id,7)
        // if GetUnitAbilityLevel(u,'A28U')>0 and GetUnitState(u,UNIT_STATE_LIFE)<=GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.25 then
                // set dmg=dmg+dmg*.2
        // else
        if GetUnitAbilityLevel(u,'A28U')>0 then
                set dmg=dmg+dmg*.1
        endif
        if r<120 then
            call SetUnitInvulnerable(u,true)
            set x2=x1-150*Cos(a)
            set y2=y1-150*Sin(a)
            call SetUnitXY_1(u,x2,y2, false)
            call SetUnitXY_1(c,x2+150*Cos(a),y2+150*Sin(a),false)
            call PauseUnit(c,true)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
            call SaveReal(h,id,2,r+2)
            if r< 60 then
                call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",x+(120+r)*Cos(a+(145-r)*bj_DEGTORAD),y+(120+r)*Sin(a+(145-r)*bj_DEGTORAD)))
                call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",x+(120+r)*Cos(a+(215+r)*bj_DEGTORAD),y+(120+r)*Sin(a+(215+r)*bj_DEGTORAD)))
            else
                if r< 110 then
                    call SetUnitTimeScale(u,0.15)
                    call DestroyEffect(AddSpecialEffectTarget("az_hit-red-blade.mdx",c,"chest"))
                    call DestroyEffect(AddSpecialEffectTarget("Minato-37.mdx",c,"chest"))
                    call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",c,"chest"))
                else
                    call SetUnitTimeScale(u,2)
                endif
            endif
            call SetUnitFacing(u,a*bj_RADTODEG)
        else
            call PauseUnit(c,false)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
            call SetUnitInvulnerable(u,false)
            call PauseUnit(u,false)
            call Push(c,50,a,150)
            call myCustomDamage(u,c,dmg,false,false,null,null,null)
            call PauseTimer(t)
            call DestroyTimer(t)
            call FlushChildHashtable(h,id)
            call SetUnitTimeScale(u,1)
            call UnitRemoveAbility(u,'A0DB')
        endif
        set p=null
        set u=null
        set c=null
        set t=null
endfunction
function MillionStabCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real x2
local real y2
local real r=LoadReal(h,id,2)
local real a=Atan2(y1-y,x1-x)
local real l__d=GetRandomReal(-30,30)
local player p=GetOwningPlayer(u)
local real dmg=100+GetHeroStr(u,true)*(2+GetUnitAbilityLevel(u,'A0DA'))
local boolean b=LoadBoolean(h,id,7)
// if GetUnitAbilityLevel(u,'A28U')>0 and GetUnitState(u,UNIT_STATE_LIFE)<=GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.25 then
// set dmg=dmg+dmg*.2
// else
if GetUnitAbilityLevel(u,'A28U')>0 then
set dmg=dmg+dmg*.1
endif
if SR(x,y,x1,y1)>100 then
set x=x+50*Cos(a)
set y=y+50*Sin(a)
call UnitRemoveAbility(u,'A2VJ')
call SetUnitXY_1(u,x,y, false)
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",x,y))
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",x+120*Cos(a+145*bj_DEGTORAD),y+120*Sin(a+145*bj_DEGTORAD)))
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",x+120*Cos(a+215*bj_DEGTORAD),y+120*Sin(a+215*bj_DEGTORAD)))
elseif SR(x,y,x1,y1)<100 and b==false then
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
call SetUnitTimeScale(u,0.68)
call SaveBoolean(h,id,7,true)
call SetUnitInvulnerable(u,true)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call PauseTimer(t)
call TimerStart(t,0.03,true,function MillionStabCast3)
else
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call SetUnitTimeScale(u,1)
call UnitRemoveAbility(u,'A0DB')
endif
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function MillionStabCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call PauseUnit(u,true)
call SetUnitTimeScale(u,2)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveBoolean(h,id,7,false)
call UnitAddAbility(u,'A0DB')
call SetUnitInvulnerable(u,true)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\EffectW.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
if GetUnitTypeId(u)=='H01M' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\DanteW.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
elseif GetUnitTypeId(u)=='H21M' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\DTDanteW.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
call SetUnitAnimationByIndex(u,7)
call SetUnitTimeScale(u,0.01)
call TimerStart(t,0.02,true,function MillionStabCast2)
set t=null
set u=null
set c=null
endfunction
