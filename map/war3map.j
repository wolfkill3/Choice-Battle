local real y=GetUnitY(Gon)
local timer t=CreateTimer()
//local integer id=GetHandleId(t)
if GetUnitAbilityLevel(Gon,'A0U8')==1 then
//call SaveUnitHandle(h,GetHandleId(Gon),StringHash("kill"),GetKillingUnit())
//call PauseUnit(Gon,false)
//call UnitRemoveBuffs(Gon,false,true)
call UnitAddAbility(Gon,'S008')
call IssueImmediateOrder(Gon, "bearform")
call UnitRemoveAbility(Gon,'S008')
call CheckUnitBonusRange(Gon)
//call GroupEnumUnitsInRange(G,x,y,400,Base)
//loop
//set E=FirstOfGroup(G)
//exitwhen E==null
//if Condition_Base(p,E)then
//call SetControlToUnit(Gon,E, 4, "stun")
