//Danzo Function

function DamageAoeOneTimeDanzoE takes unit damager,real x0,real y0,real range,real damage,group gr1 returns nothing
local integer id=GetHandleId(GetExpiredTimer())
call GroupClear(G)
call GroupEnumUnitsInRange(G,x0,y0,range,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if Condition_Base(GetOwningPlayer(damager),n0) and IsUnitInGroup(n0,gr1)==false then
//call UnitStop(n0)
if GetUnitAbilityLevel(n0,'DST2')>0 then
set damage=damage*1.3
endif



call myCustomDamage(damager,n0,damage,false,false,null,null,null)
call SetControlToUnit(damager,n0, 0.1, "stun")

if GetUnitAbilityLevel(n0,'BDSE')==0 then
call UnitAddAbility(n0,'ADSE')
call UnitRemoveAbility(n0,'ADSE')
endif
call GroupAddUnit(gr1,n0)
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
call SaveGroupHandle(HH,id,4,gr1)
set damager=null
set gr1=null
endfunction

function DamageAoeOneTimeDanzoQET takes unit damager,real x0,real y0,real range,real damage,group gr1 returns nothing
local integer id=GetHandleId(GetExpiredTimer())
call GroupClear(G)
call GroupEnumUnitsInRange(G,x0,y0,range,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if Condition_Base(GetOwningPlayer(damager),n0) and IsUnitInGroup(n0,gr1)==false then
if GetUnitAbilityLevel(n0,'DST2')>0 then
set damage=damage*1.3
endif
call myCustomDamage(damager,n0,damage,false,false,null,null,null)
call GroupAddUnit(gr1,n0)
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
call SaveGroupHandle(HH,id,4,gr1)
set damager=null
set gr1=null
endfunction

function DamageAoeOneTime3DanzoQ takes unit damager,real x0,real y0,real range,real damage,group gr1,integer time0,integer speed0,real facing0 returns nothing
local integer id=GetHandleId(GetExpiredTimer())
call GroupClear(G)
call GroupEnumUnitsInRange(G,x0,y0,range,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if Condition_Base(GetOwningPlayer(damager),n0) and IsUnitInGroup(n0,gr1)==false  then
call UnitStop(n0)
if GetUnitAbilityLevel(n0,'DST2')>0 then
set damage=damage*1.3
endif
call myCustomDamage(damager,n0,damage,false,false,null,null,null)
call PushTimed(n0,facing0,time0,speed0)
call GroupAddUnit(gr1,n0)
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
call SaveGroupHandle(HH,id,4,gr1)
set damager=null
set gr1=null
endfunction
//Danzo end Function
