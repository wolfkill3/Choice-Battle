function MadaraChoice_Act takes nothing returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local unit caster=GetTriggerUnit()
    local unit c=GetSpellTargetUnit()
    local real facing
    call SaveUnitHandle(HH,id,1,caster)
    if c==null then
        set facing=Angle2(GetUnitX(caster),GetUnitY(caster),GetLocationX(GetSpellTargetLoc()),GetLocationY(GetSpellTargetLoc()))
        call SaveReal(HH,id,11,GetLocationX(GetSpellTargetLoc()))
        call SaveReal(HH,id,12,GetLocationY(GetSpellTargetLoc()))
    else
        call SaveUnitHandle(HH,id,2,c)
        set facing=Angle2(GetUnitX(caster),GetUnitY(caster),GetUnitX(c),GetUnitY(c))
    endif
    call SaveReal(HH,id,3,facing)

   //MadaraQ
    if GetSpellAbilityId()=='MUQ1' then
        call PauseUnit(caster,true)
            call SetUnitInvulnerable(caster,true)
        call SaveReal(HH,id,35,25*(GetUnitAbilityLevel(caster,'MUQ1'))+(1+GetUnitAbilityLevel(caster,'MUQ1'))*GetHeroInt(caster,true))
        call TimerStart(t,0.02,true,function MadaraQSharinganAct)
    endif
        
    if GetSpellAbilityId()=='MUQ2' then
        call SaveReal(HH,id,35,(2+GetUnitAbilityLevel(caster,'MUQ2'))*GetHeroInt(caster,true))
        call TimerStart(t,0.02,true,function MadaraQRinneganAct)
    endif        
   //MadaraW
    if GetSpellAbilityId()=='MUW1' then
        call PauseUnit(caster,true)
            call SetUnitInvulnerable(caster,true)
        call SaveReal(HH,id,35,GetUnitAbilityLevel(caster,'MUW1')*50+(GetUnitAbilityLevel(caster,'MUW1')+1)*GetHeroInt(caster,true))
        call TimerStart(t,0.02,true,function MadaraWSharinganAct)
    endif
    if GetSpellAbilityId()=='MUW2' then
        if LoadGroupHandle(HH,GetHandleId(caster),StringHash("MadWGroup"))!=null then
            call ForGroup(LoadGroupHandle(HH,GetHandleId(caster),StringHash("MadWGroup")),function RemoveUnitGroup)
            call DestroyGroup(LoadGroupHandle(HH,GetHandleId(caster),StringHash("MadWGroup")))
            call RemoveSavedHandle(HH,GetHandleId(caster),StringHash("MadWGroup"))
        endif
        if LoadGroupHandle(HH,GetHandleId(caster),StringHash("MadWGroup1"))!=null then
            call ForGroup(LoadGroupHandle(HH,GetHandleId(caster),StringHash("MadWGroup1")),function RemoveUnitGroup)
            call DestroyGroup(LoadGroupHandle(HH,GetHandleId(caster),StringHash("MadWGroup1")))
            call RemoveSavedHandle(HH,GetHandleId(caster),StringHash("MadWGroup1"))
        endif
        if LoadBoolean(HH,GetHandleId(caster),StringHash("MadaraSusT2"))==false then
            call SetUnitAnimationByIndex(caster,7)
        else
            call SetUnitAnimationByIndex(caster,2)
        endif
        call SaveGroupHandle(HH,id,4,CreateGroup())
        call SaveGroupHandle(HH,GetHandleId(caster),StringHash("MadWGroup"),CreateGroup())
        call SaveGroupHandle(HH,GetHandleId(caster),StringHash("MadWGroup1"),CreateGroup())
        call PauseUnit(caster,false)
        call SetUnitPathing(caster,true)
                    set soundplay=CreateSound("war3mapimported\\MadaraW2.mp3",false,false,true,12700,12700,"")
                            call StartSound(soundplay)
                            call KillSoundWhenDone(soundplay)
        call EffectCreateAndMove(true,"Madara\\az_slb.mdl",GetRandomReal(0,360),1.5,2,0.8,100,100,100,0,-50,caster,0,facing)
        call EffectCreateAndMove(true,"Madara\\WindCircleFaster.mdl",facing,1,1.5,0.75,100,100,100,40,0,caster,0,facing)
        call EffectCreateAndMove(true,"Madara\\ShockWaveBlack.mdl",facing,1,2.5,0.75,100,100,100,0,0,caster,0,facing)
        set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
        call MoveUnit(n0,n0,200,facing)
        call SaveUnitHandle(HH,id,20,n0)
        set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
        call MoveUnit(n0,n0,200,facing)
        call MoveUnit(n0,n0,150,facing+90)
        call SaveUnitHandle(HH,id,21,n0)
        set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
        call MoveUnit(n0,n0,200,facing)
        call MoveUnit(n0,n0,150,facing-90)
        call SaveUnitHandle(HH,id,22,n0)
        set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
        call MoveUnit(n0,n0,200,facing)
        call MoveUnit(n0,n0,300,facing+90)
        call SaveUnitHandle(HH,id,23,n0)
        set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
        call MoveUnit(n0,n0,200,facing)
        call MoveUnit(n0,n0,300,facing-90)
        call SaveUnitHandle(HH,id,24,n0)
        set n0=null
        call SaveReal(HH,id,36,GetUnitAbilityLevel(caster,'MUW2'))
        call SaveReal(HH,id,35,GetHeroInt(caster,true)*(1+GetUnitAbilityLevel(caster,'MUW2')))
        call TimerStart(t,0.02,true,function MadaraWRinneganAct)
    endif
        
//MadaraE
    if GetSpellAbilityId()=='MUE2' then
        call PauseUnit(caster,true)
            call SetUnitInvulnerable(caster,true)
        call SaveReal(HH,id,35,(GetUnitAbilityLevel(caster,'MUE2')+3)*GetHeroInt(caster,true))
        call TimerStart(t,0.02,true,function MadaraERinneganAct)
    endif
    
    if GetSpellAbilityId()=='MUE1' then
        call PauseUnit(caster,true)
            call SetUnitInvulnerable(caster,true)
        call SaveReal(HH,id,11,GetUnitAbilityLevel(caster,'MUE1'))
        call SaveReal(HH,id,35,(GetUnitAbilityLevel(caster,'MUE1')+3)*0.35*GetHeroInt(caster,true))
        call TimerStart(t,0.02,true,function MadaraESharinganAct)
    endif
//
         
//MadaraT
    if GetSpellAbilityId()=='MUT2' then
        call PauseUnit(caster,true)
        call SetUnitInvulnerable(caster,true)
        call TimerStart(t,0.02,true,function MadaraTRinneganAct)
    endif
    
    if GetSpellAbilityId()=='MUT1' then
        call UnitAddAbility(caster, 'AMUN')
        call IssueImmediateOrder(caster,"bearform")
        call UnitRemoveAbility(caster, 'AMUN')
            call UnitRemoveBuffs(caster,false,true)
        call MadaraSusanoAct(caster,3)
        call TimerStart(t,0.02,true,function MadaraTSharinganAct)
    endif
//
        
    if GetSpellAbilityId()=='AMUG' then
        call PauseUnit(caster,true)
        call SaveBoolean(HH,GetHandleId(caster),StringHash("MadaraG"),true)
        call SaveBoolean(HH,GetHandleId(caster),ANTITARGET_ABILITY,true)
        call TimerStart(t,0.02,true,function MadaraGAct)
    endif
        
    if GetSpellAbilityId()=='AMUR' then
        call MadaraSusanoAct(caster,1)
        call PauseUnit(caster,true)
        call TimerStart(t,0.02,true,function MadaraRAct)
    endif        
        //madaraF
    if GetSpellAbilityId()=='A0N1' then
        
        if LoadBoolean(HH,GetHandleId(caster),StringHash("MadaraF"))==true then
        //A0N1
            call SaveBoolean(HH,GetHandleId(caster),StringHash("MadaraF"),false)
            call SetUnitAbilityLevel(caster,'A2D4',1)
            set n0=CreateUnit(GetOwningPlayer(caster),'e12W',GetUnitX(caster),GetUnitY(caster),facing)
            call SetUnitModel(n0,"Madara\\SusanooBonesMadara.mdl")
            call SaveUnitHandle(HH,GetHandleId(caster),StringHash("MadaraBone"),n0)
            call UnitSize(n0,1,1,1)
            call UnitSpeed(n0,1.5)
            call SaveUnitHandle(HH,id,20,n0)
            set n0=CreateUnit(GetOwningPlayer(caster),'e12W',GetUnitX(caster),GetUnitY(caster),facing)
            call SetUnitModel(n0,"Madara\\Madara-huitu-30.mdl")
            call UnitSize(n0,1.5,1,1)
            call SaveUnitHandle(HH,id,2,n0)
            set n0=null
            call TimerStart(t,0.02,true,function MadaraFBoneAct)
        else
                
            call SaveBoolean(HH,GetHandleId(caster),StringHash("MadaraF"),true)
            call SetUnitAbilityLevel(caster,'A2D4',2)
            if LoadUnitHandle(HH,GetHandleId(caster),StringHash("MadaraBone"))!=null then
            call RemoveUnit(LoadUnitHandle(HH,GetHandleId(caster),StringHash("MadaraBone")))
            endif
            set n0=CreateUnit(GetOwningPlayer(caster),'e12W',GetUnitX(caster),GetUnitY(caster),facing)
            call SetUnitModel(n0,"Madara\\Rinnegan.mdl")
            call UnitSize(n0,1.5,1,1)
            call SaveUnitHandle(HH,id,2,n0)
            set n0=null
            call TimerStart(t,0.02,true,function MadaraFRinneganAct)
            call UnitStop(caster)
                
        endif   
        
    endif
        
        
    set t=null
    set c=null
    set caster=null
endfunction
function MadaraChoice_Cond takes nothing returns boolean
        local boolean cond1=GetSpellAbilityId()=='AMUG' or GetSpellAbilityId()=='AMUR' or GetSpellAbilityId()=='A0N1' or GetSpellAbilityId()=='MUQ1' or GetSpellAbilityId()=='MUQ2' or GetSpellAbilityId()=='MUW1' or GetSpellAbilityId()=='MUW2' or GetSpellAbilityId()=='MUE1' or GetSpellAbilityId()=='MUE2' or GetSpellAbilityId()=='MUT1' or GetSpellAbilityId()=='MUT2'
        if cond1 then
                return true
        else
                return false
        endif
endfunction
function InitTrig_MadaraChoice takes nothing returns nothing
        local trigger trig=CreateTrigger()
        local integer index
        set index=0
        loop
        call TriggerRegisterPlayerUnitEvent(trig,Player(index),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
        set index=index+1
        exitwhen index==bj_MAX_PLAYER_SLOTS
        endloop
        call TriggerAddCondition(trig,Condition(function MadaraChoice_Cond))
        call TriggerAddAction(trig,function MadaraChoice_Act)
        set trig=null
        set index=0
endfunction

//========== Madara END

