set t=null
set p=null
endfunction
function CastNC takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local group g=CreateGroup()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local integer i
local integer lvl=GetUnitAbilityLevel(u,'A0BM')
local real c=0.2
call GroupEnumUnitsInRange(G,x,y,500,Base)
loop
set E=FirstOfGroup(G)
set ide=GetHandleId(E)
if IsUnitEnemy(E,p)and IsUnitType(E,UNIT_TYPE_HERO)then
set i=GetHeroAgi(E,false)
call SetHeroAgi(E,i-R2I(I2R(i)*c),false)
call SaveInteger(HH,ide,StringHash("makaagi"),R2I(I2R(i)*c))
set i=GetHeroStr(E,false)
call SetHeroStr(E,i-R2I(I2R(i)*c),false)
call SaveInteger(HH,ide,StringHash("makastr"),R2I(I2R(i)*c))
set i=GetHeroInt(E,false)
call SetHeroInt(E,i-R2I(I2R(i)*c),false)
call SaveInteger(HH,ide,StringHash("makaint"),R2I(I2R(i)*c))
elseif(IsUnitAlly(E,p)or E==u)and IsUnitType(E,UNIT_TYPE_HERO)then
set i=GetHeroAgi(E,false)
call SetHeroAgi(E,i+R2I(I2R(i)*c),false)
call SaveInteger(HH,ide,StringHash("makaagi"),R2I(I2R(i)*c))
set i=GetHeroStr(E,false)
call SetHeroStr(E,i+R2I(I2R(i)*c),false)
call SaveInteger(HH,ide,StringHash("makastr"),R2I(I2R(i)*c))
set i=GetHeroInt(E,false)
call SetHeroInt(E,i+R2I(I2R(i)*c),false)
call SaveInteger(HH,ide,StringHash("makaint"),R2I(I2R(i)*c))
endif
call GroupAddUnit(g,E)
call GroupRemoveUnit(G,E)
exitwhen E==null
endloop
set n=CreateUnit(p,'h019',x,y,0)
call UnitAddAbility(n,'A0BQ')
call SetUnitAbilityLevel(n,'A0BQ',lvl)
call UnitApplyTimedLife(n,0,1)
call IssueImmediateOrderById(n,852285)
set n=CreateUnit(p,'h019',x,y,0)
call UnitAddAbility(n,'A0BP')
call SetUnitAbilityLevel(n,'A0BP',lvl)
call UnitApplyTimedLife(n,0,1)
call IssueImmediateOrderById(n,852285)
set n=CreateUnit(p,'h019',x,y,0)
call UnitAddAbility(n,'A0BN')
call SetUnitAbilityLevel(n,'A0BN',lvl)
call UnitApplyTimedLife(n,0,1)
call IssueImmediateOrder(n,"battleroar")
set n=CreateUnit(p,'h019',x,y,0)
call UnitAddAbility(n,'A0BO')
call SetUnitAbilityLevel(n,'A0BO',lvl)
call UnitApplyTimedLife(n,0,1)
call IssueImmediateOrder(n,"battleroar")
call UnitApplyTimedLife(CreateUnit(p,'e050',x,y,0),1,3)
call UnitApplyTimedLife(CreateUnit(p,0x65303631,x,y,0),1,3)
call UnitApplyTimedLife(CreateUnit(p,0x65304632,x,y,0),1,3)
call SaveUnitHandle(HH,id,0,u)
call SaveGroupHandle(HH,id,1,g)
call SaveInteger(HH,id,5,0)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\MakaSoulResonans.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,1,true,function CastNC2)
set g=null
set u=null
set t=null
set p=null
endfunction
