return GetSpellAbilityId()=='A0X2' and udg_B==true 
endfunction
function AlastorItemCast1 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local player p=GetOwningPlayer(u)
local integer rand2=GetRandomInt(-1,0)
local real a=LoadReal(h,id,1)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
if rand2==0 then
set rand2=1
endif
call ShowUnit(u,true)
call UnitRemoveAbility(u, 'AoSV')
call UnitRemoveAbility(u, 'A1SV')
call SetUnitXY_1(u,x1+250*Cos((a+rand2*90)*bj_DEGTORAD),y1+250*Sin((a+rand2*90)*bj_DEGTORAD),false)
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\SteamTank\\SteamTankImpact.mdl",GetUnitX(u),GetUnitY(u)))
set n=CreateIllusionFromUnit(u)
call SetUnitFacingInstant(n,a)
call SetIllusionDamageReceived(n,2)
call UnitAddAbility(n,'A2X2')
call UnitApplyTimedLife(n,'B04X',15)
call SetUnitXY_1(n,x1+250*Cos((a-rand2*90)*bj_DEGTORAD),y1+250*Sin((a-rand2*90)*bj_DEGTORAD),false)
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\SteamTank\\SteamTankImpact.mdl",GetUnitX(n),GetUnitY(n)))
if p==GetLocalPlayer()then
call ClearSelection()
call SelectUnit(u,true)
endif
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
if GetUnitTypeId(u)=='H05A' or GetUnitTypeId(u)=='H05B' then
if GetUnitAbilityLevel(u,'A13D')<6 then
call SetPlayerAbilityAvailable(p,'A13B',false)
elseif GetUnitAbilityLevel(u,'A0IH')>0 then
call SetPlayerAbilityAvailable(p,'A237',true)
else
call SetPlayerAbilityAvailable(p,'A13B',true)
endif
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set t=null
set p=null
set u=null
endfunction
function AlastorItemCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
call SaveUnitHandle(h,id,0,u)
call SetUnitFacingInstant(u,GetUnitFacing(u))
call SaveReal(h,id,1,GetUnitFacing(u))
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
set EFF=AddSpecialEffect("war3mapImported\\magmaburst.mdx",x,y)
call RemoveEffect(EFF,0.5,true,CreateTimer())
call UnitRemoveBuffs(u,false,true)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call ShowUnit(u,false)
call TimerStart(t,.5,false,function AlastorItemCast1)
set t=null
set u=null
endfunction
