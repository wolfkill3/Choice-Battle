call SetUnitModel(n0,"Sabrac\\afb_aura_smoke_red.mdl")
call UnitSize(n0,0.7,1,1)
call UnitColor(n0,100,100,100,0)
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call SetUnitFlyHeight(n0,0,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=null
endif
call MoveUnit(caster,LoadUnitHandle(HH,id,20),0,facing)


if CheckUnitInvisible(caster)==true then
   
    if GetUnitAbilityLevel( LoadUnitHandle(HH,id,20) ,'A0A1')==0 then
      call UnitAddAbility( LoadUnitHandle(HH,id,20) ,'A0A1')
    endif

else

   if GetUnitAbilityLevel( LoadUnitHandle(HH,id,20) ,'A0A1')==1 then
     call UnitRemoveAbility( LoadUnitHandle(HH,id,20) ,'A0A1')
   endif

endif




if LoadBoolean(HH,GetHandleId(caster),SH_SabracEReverse)==true or LoadUnitHandle(HH,GetHandleId(caster),REVERSE_TARGET)!=null then
if LoadUnitHandle(HH,GetHandleId(LoadUnitHandle(HH,id,30)),SH_SabracZoneU)!=null and SR(GetUnitX(caster),GetUnitY(caster),GetUnitX(LoadUnitHandle(HH,GetHandleId(LoadUnitHandle(HH,id,30)),SH_SabracZoneU)),GetUnitY(LoadUnitHandle(HH,GetHandleId(LoadUnitHandle(HH,id,30)),SH_SabracZoneU)))<1500 then
set damage=damage*2
endif
call SaveBoolean(HH,GetHandleId(caster),ANTITARGET_ABILITY,false)
call SabracStackOneTime(caster,GetUnitX(caster),GetUnitY(caster),500)
call DamageAoeOneTime0(LoadUnitHandle(HH,id,30),GetUnitX(caster),GetUnitY(caster),500,damage)
call EffectCreateAndMove(true,"Sabrac\\kurumi-15.mdl",GetRandomReal(0,360),1,2,0.6,100,100,100,0,-50,caster,0,facing)
call EffectCreateAndMove(true,"Sabrac\\az_siwen3.mdl",GetRandomReal(0,360),1,1.5,0.6,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"Sabrac\\HakkeStart2.mdl",facing,1,1,1,100,100,100,60,0,caster,0,facing)
call EffectCreateAndMove(true,"Sabrac\\bymutou-hongse3.mdl",facing,1,2,0.5,100,100,100,40,0,caster,0,facing)
set soundplay=SndN(3885) // Sound\Music\mp3Music\SabracEW.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call UnitRemoveAbility(caster,'BSaR')
call RemoveSavedHandle(HH,GetHandleId(caster),REVERSE_TARGET)
call SaveBoolean(HH,GetHandleId(caster),SH_SabracEReverse,false)
endif
if GetUnitAbilityLevel(caster,'BSaR')==0 or (time>0.02 and  udg_B==false) or UnitIsAlive(caster)==false then
//if((GetLocalPlayer()==GetOwningPlayer(caster) or GetPlayerAlliance(GetOwningPlayer(caster),GetLocalPlayer(),ALLIANCE_SHARED_CONTROL)) and GetUnitSelected(GetLocalPlayer())==caster )then
//call DisplayTextToPlayer(GetLocalPlayer(),0,0,"Reverse end")
//endif
call SaveBoolean(HH,GetHandleId(caster),ANTITARGET_ABILITY,false)
call RemoveUnit(LoadUnitHandle(HH,id,20))
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
set caster=null
set casterOriginal=null
endfunction
function SabracFExp1 takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real time1=LoadReal(HH,id,6)
local real x0=LoadReal(HH,id,11)
local real y0=LoadReal(HH,id,12)
set time=time+0.02
call SaveReal(HH,id,5,time)
if time>1 then
set time1=time1+0.02
if time1==0.2 then
call DamageAoeOneTime0(caster,x0,y0,LoadReal(HH,id,16),LoadReal(HH,id,15)*0.06)
set time1=0
endif
call SaveReal(HH,id,6,time1)
endif
if time<1 then
call GroupClear(G)
call GroupEnumUnitsInRange(G,x0,y0,1500,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if SR(GetUnitX(n0),GetUnitY(n0),LoadReal(HH,id,11),LoadReal(HH,id,12))>300 and IsUnitEnemy(n0,GetOwningPlayer(caster))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false then
call MoveUnit(n0,n0,25,Angle2(GetUnitX(n0),GetUnitY(n0),x0,y0))
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
endif
if time==0.04 then
call EffectCreateAndMove(true,"Sabrac\\fanty (86).mdl",facing,1,2,1,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"Sabrac\\HakkeStart2.mdl",facing,4,3,0.2,100,100,100,30,0,caster,0,facing)
endif
if time==1 then
call EffectCreateAndMove(true,"Sabrac\\File00000003.mdl",facing,4,3,0.4,100,100,100,60,0,caster,0,facing)
call EffectCreateAndMove(true,"Sabrac\\chushou_black.mdl",facing,4,6,0.4,100,100,100,60,0,caster,0,facing)
call SabracStackOneTime(caster,LoadReal(HH,id,11),LoadReal(HH,id,12),LoadReal(HH,id,16))
endif
if time<5 then
call SetUnitState(caster,UNIT_STATE_LIFE,10000)
call MoveAoe1(x0,y0,caster,0,facing)
call SetUnitInvulnerable(caster,true)
call PauseUnit(caster,true)
endif
if time==5 then

call SetUnitInvulnerable(caster,false)
call PauseUnit(caster,false)


if udg_B==true then
call SetUnitState(caster,UNIT_STATE_LIFE,1)
call SetUnitTargetable(caster,true)
call UnitAddAbility(caster,'A0WR')
call myCustomDamage(LoadUnitHandle(HH,GetHandleId( caster ),SH_SabracFKillU),caster,1000,false,false,null,null,null)
call UnitRemoveAbility(caster,'A0WR')

endif
//call KillUnit(caster)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
set caster=null
endfunction






function SabracFExp takes unit caster0,real x00,real y00,real aoe00,real damage00 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(HH,id,1,caster0)
call SaveReal(HH,id,11,x00)
call SaveReal(HH,id,12,y00)
call SaveReal(HH,id,16,aoe00)
set soundplay=SndN(3888) // Sound\Music\mp3Music\SabracF_Death.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set soundplay=SndN(3890) // Sound\Music\mp3Music\SabracG.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set n0=CreateUnit(GetOwningPlayer(caster0),'e200',x00,y00,GetUnitFacing(caster0))
call SetUnitModel(n0,"Sabrac\\file00004747.mdl")
call UnitSize(n0,9,1,1)
call MyRemoveUnit(n0,5)
set n0=null
call SaveReal(HH,id,15,damage00)
call SetUnitInvulnerable(caster0,true)
call PauseUnit(caster0,true)
call TimerStart(t,0.02,true,function SabracFExp1)
set caster0=null
set t=null
endfunction
function SabracFAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit Dummy=LoadUnitHandle(HH,id,20)
local real time=LoadReal(HH,id,5)
local real time1=LoadReal(HH,id,6)
local integer swords=0
local unit casterOriginal=LoadUnitHandle(HH,id,30)
local unit SabracClone=LoadUnitHandle(HH,GetHandleId(casterOriginal),SH_SabracTU)
set time=time+0.02
call SaveReal(HH,id,5,time)
set time1=time1+0.02
if time1==1 then
set time1=0
if SR(GetUnitX(casterOriginal),GetUnitY(casterOriginal),GetUnitX(Dummy),GetUnitY(Dummy))<1500 then
call HealTextTag(casterOriginal,casterOriginal,0.4*GetHeroInt(casterOriginal,true)*myCustomMana2(casterOriginal,1),"HealthRes")
call SetUnitState(casterOriginal,UNIT_STATE_LIFE,GetUnitState(casterOriginal,UNIT_STATE_LIFE)+0.4*GetHeroInt(casterOriginal,true))
//call HealText(0.5*GetHeroInt(casterOriginal,true),casterOriginal)
call HealTextTag(casterOriginal,casterOriginal,0.4*GetHeroAgi(casterOriginal,true)*myCustomMana2(casterOriginal,1),"ManaRes")
call SetUnitState(casterOriginal,UNIT_STATE_MANA,GetUnitState(casterOriginal,UNIT_STATE_MANA)+0.4*GetHeroAgi(casterOriginal,true))
//call HealTextMana(0.5*GetHeroAgi(casterOriginal,true),casterOriginal)
endif
if SabracClone!=null then
if SR(GetUnitX(SabracClone),GetUnitY(SabracClone),GetUnitX(Dummy),GetUnitY(Dummy))<1500 then
call HealTextTag(SabracClone,SabracClone,0.4*GetHeroInt(SabracClone,true)*myCustomMana2(SabracClone,1),"HealthRes")
call SetUnitState(SabracClone,UNIT_STATE_LIFE,GetUnitState(SabracClone,UNIT_STATE_LIFE)+0.4*GetHeroInt(SabracClone,true))
//call HealText(0.5*GetHeroInt(SabracClone,true),SabracClone)
call HealTextTag(SabracClone,SabracClone,0.4*GetHeroAgi(SabracClone,true)*myCustomMana2(SabracClone,1),"ManaRes")
call SetUnitState(SabracClone,UNIT_STATE_MANA,GetUnitState(SabracClone,UNIT_STATE_MANA)+0.4*GetHeroAgi(SabracClone,true))
//call HealTextMana(0.5*GetHeroAgi(SabracClone,true),SabracClone)
endif
endif
endif
call SaveReal(HH,id,6,time1)
if LoadBoolean(HH,GetHandleId(casterOriginal),SH_SabracFdie)==true and SR(GetUnitX(casterOriginal),GetUnitY(casterOriginal),GetUnitX(Dummy),GetUnitY(Dummy))<1500 then
call SetUnitState(casterOriginal,UNIT_STATE_LIFE,10000)
call SabracFExp(casterOriginal,GetUnitX(Dummy),GetUnitY(Dummy),1500,10*(GetHeroAgi(casterOriginal,true)+GetHeroStr(casterOriginal,true)+GetHeroInt(casterOriginal,true)))
call SaveBoolean(HH,GetHandleId(casterOriginal),SH_SabracFdie,false)
endif
if UnitIsAlive(casterOriginal)==false or Dummy==null or udg_B==false or DU2==false then
call SaveUnitHandle(HH,GetHandleId(casterOriginal),SH_SabracZoneU,null)
call RemoveUnit(Dummy)
call RemoveUnit(LoadUnitHandle(HH,id,21))
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
set caster=null
set casterOriginal=null
set SabracClone=null
set Dummy=null
endfunction


function DamageAoeOneTime0Pure takes unit damager,real x0,real y0,real range,real damage returns nothing
call GroupClear(G)
call GroupEnumUnitsInRange(G,x0,y0,range,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if  Condition_Base(GetOwningPlayer(damager),n0)  then
call myCustomDamage(damager,n0,damage,false,false,null, DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_WHOKNOWS)
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
set damager=null                    
endfunction


function SabracGAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit casterOriginal=LoadUnitHandle(HH,id,30)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real time1=0
local real MpCur
local real MpMax
local real HpMax
local real HpCur
local unit SabracClone=LoadUnitHandle(HH,GetHandleId(casterOriginal),SH_SabracTU)
set time=time+0.02
call SaveReal(HH,id,5,time)
set MpCur=GetUnitState(casterOriginal,UNIT_STATE_MANA)
set MpMax=GetUnitState(casterOriginal,UNIT_STATE_MAX_MANA)
set HpMax=GetUnitState(casterOriginal,UNIT_STATE_MAX_LIFE)
set HpCur=GetUnitState(casterOriginal,UNIT_STATE_LIFE)
if time==0.02 then

call StartAbilityCooldown(GetUnitAbility(caster,'SaG1'), 80)
if caster!=casterOriginal then
call StartAbilityCooldown(GetUnitAbility(casterOriginal,'SaG1'), 80)
endif


call SabracStackOneTime(casterOriginal,LoadReal(HH,id,11),LoadReal(HH,id,12),1500)
endif

if HpCur>HpMax*0.7 then
call SetUnitState(casterOriginal,UNIT_STATE_LIFE,HpMax*0.69)
endif

if MpCur>MpMax*0.7 then
call SetUnitState(casterOriginal,UNIT_STATE_MANA,MpMax*0.69)
endif



if SabracClone!=null then
set MpCur=GetUnitState(SabracClone,UNIT_STATE_MANA)
set MpMax=GetUnitState(SabracClone,UNIT_STATE_MAX_MANA)
set HpMax=GetUnitState(SabracClone,UNIT_STATE_MAX_LIFE)
set HpCur=GetUnitState(SabracClone,UNIT_STATE_LIFE)


if HpCur>HpMax*0.7 then
call SetUnitState(SabracClone,UNIT_STATE_LIFE,HpMax*0.69)
endif

if MpCur>MpMax*0.7 then
call SetUnitState(SabracClone,UNIT_STATE_MANA,MpMax*0.69)
endif

endif




if time<=4 then
set time1=LoadReal(HH,id,6)
set time1=time1-0.02
if time1==0 then
set time1=0.2

call DamageAoeOneTime0Pure(casterOriginal,LoadReal(HH,id,11),LoadReal(HH,id,12),1500,LoadReal(HH,id,15)*0.05)


endif
call SaveReal(HH,id,6,time1)
endif
if time==4 then
//call UnitColor(LoadUnitHandle(HH,GetHandleId(casterOriginal),StringHash("SabracZoneU")),100,100,100,0)


//call UnitColor(LoadUnitHandle(HH,GetHandleId(casterOriginal),StringHash("SabracZoneU")),100,100,100,0)

if(GetLocalPlayer()==GetOwningPlayer(casterOriginal))then
call UnitColor(LoadUnitHandle(HH,GetHandleId(casterOriginal),SH_SabracZoneU),100,100,100,0)
endif



endif
if time>=30 or udg_B==false or DU2==false then
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
set caster=null
set casterOriginal=null
set SabracClone=null
endfunction



function SabracRFlySwords1 takes nothing returns nothing
