    call TriggerRegisterFrameEvent( tOnUnPress, SpectacleTeamSelect1, FRAMEEVENT_MOUSE_UP )
    call TriggerRegisterFrameEvent( tOnClick, SpectacleTeamSelect1, FRAMEEVENT_CONTROL_CLICK )

    call TriggerAddAction( tOnPress, function OnButtonPress )
    call TriggerAddAction( tOnUnPress, function OnButtonUnpress )
    call TriggerAddAction( tOnClick, function OnButtonChangeTeam1 )
    
    set ClassBarFrame=CreateFrameByType("SIMPLEGRID", "ClassBarGrid", GetOriginFrame( ORIGIN_FRAME_CONSOLE_UI, 0 ), "", 0)
    call ClearFrameAllPoints( ClassBarFrame )
