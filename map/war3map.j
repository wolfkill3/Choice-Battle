call UnitAddAbility(u,'A1DS')
call UnitMakeAbilityPermanent(u,true,'A1DS')
call ShowAbility2('A1DS',true)
call UnitAddAbility(u,'A1DT')
call UnitMakeAbilityPermanent(u,true,'A1DT')
