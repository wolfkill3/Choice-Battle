set n=CreateUnit(p,0x65305258,x,y,GetRandomReal(0,359))
call SetUnitFlyHeight(n,fh,0)
call UnitApplyTimedLife(n,'BTLF',0.13)
call SetUnitTimeScale(n,3)
else
call PauseTimer(t)
call TimerStart(t,0.2,false,function LightningStrikeKilluaCast4)
endif
set p=null
set u=null
set t=null
endfunction
