function HibariGChoice_Act takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit caster=GetTriggerUnit()
local real x0=GetUnitX(caster)
local real y0=GetUnitY(caster)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real damage=(GetHeroAgi(caster,true)+50)*(GetUnitAbilityLevel(caster,'A06A'))+100
local real facing=Angle2(x0,y0,x1,y1)
call SaveUnitHandle(HH,id,1,caster)
call SaveReal(HH,id,11,x1)
call SaveReal(HH,id,12,y1)
call SaveReal(HH,id,3,facing)




if GetSpellAbilityId()=='KHG1' then
call UnitRemoveAbility(caster,'KHG1')
call UnitAddAbility(caster,'KHG2')

call TimerStart(t,0.02,false,function AbilNull)
endif

if GetSpellAbilityId()=='KHG2' then
call UnitRemoveAbility(caster,'KHG2')
call UnitAddAbility(caster,'KHG3')

call TimerStart(t,0.02,false,function AbilNull)
endif

if GetSpellAbilityId()=='KHG3' then
call UnitRemoveAbility(caster,'KHG3')
call UnitAddAbility(caster,'KHG1')

call TimerStart(t,0.02,false,function AbilNull)
endif

if GetSpellAbilityId()=='HiW1' then
if GetUnitAbilityLevel(caster,'KHG1')>0 then
call UnitAddAbility(caster,'KHW2')
call SetUnitAttackRangeByIndex(caster, 0, 600)
call TimerStart(t,0.02,true,function HibarGW1)
endif

if GetUnitAbilityLevel(caster,'KHG2')>0 then
call UnitAddAbility(caster,'KHW3')
call TimerStart(t,0.02,true,function HibarGW2)
endif

if GetUnitAbilityLevel(caster,'KHG3')>0 then
call UnitAddAbility(caster,'KHW4')
call TimerStart(t,0.02,true,function HibarGW3)
endif

endif

if GetSpellAbilityId()=='A06A' then





if GetUnitAbilityLevel(caster,'KHG1')>0 then


set soundplay=CreateSound("Sound\\Music\\mp3Music\\HibariQ2.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)

call HibariGQ1(1,caster,x1,y1,facing,damage*1.2,true)
call HibariGQ1(1,caster,PolX(x1,300,facing-90),PolY(y1,300,facing-90),facing,damage*0.2,false)
call HibariGQ1(1,caster,PolX(x1,300,facing+90),PolY(y1,300,facing+90),facing,damage*0.2,false)
endif

if GetUnitAbilityLevel(caster,'KHG2')>0 then

set soundplay=CreateSound("Sound\\Music\\mp3Music\\HibariQ.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)

call HibariGQ1(2,caster,PolX(x1,150,facing-90),PolY(y1,150,facing-90),facing,damage*0.6,true)
call HibariGQ1(2,caster,PolX(x1,150,facing+90),PolY(y1,150,facing+90),facing,damage*0.6,true)
endif

if GetUnitAbilityLevel(caster,'KHG3')>0 then

set soundplay=CreateSound("Sound\\Music\\mp3Music\\HibariQ3.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)



call HibariGQ1(3,caster,x1,y1,facing,damage,true)
endif

call TimerStart(t,0.02,false,function AbilNull)
endif






set t=null
set caster=null
endfunction
function HibariGChoice_Cond takes nothing returns boolean
if GetSpellAbilityId()=='A06A' or GetSpellAbilityId()=='HiW1' or GetSpellAbilityId()=='HibE' or GetSpellAbilityId()=='KHG1' or GetSpellAbilityId()=='KHG2' or GetSpellAbilityId()=='KHG3' then
return true
else
return false
endif
endfunction
function InitTrig_HibariG takes nothing returns nothing
local trigger HibariGChoice=CreateTrigger()
local integer index
set index=0
loop
call TriggerRegisterPlayerUnitEvent(HibariGChoice,Player(index),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set index=index+1
exitwhen index==bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddCondition(HibariGChoice,Condition(function HibariGChoice_Cond))
call TriggerAddAction(HibariGChoice,function HibariGChoice_Act)
set HibariGChoice=null
set index=0
endfunction
