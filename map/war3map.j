        call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e0LH',x1,y1,0),1,1)
        call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e0LJ',x1,y1,0),1,1)
