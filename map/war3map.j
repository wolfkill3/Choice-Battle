return GetSpellAbilityId()=='A0QE' and udg_B==true
endfunction
function RestronationCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local integer ip=GetPlayerId(GetOwningPlayer(u))
local player p=GetOwningPlayer(u)
local real x=LoadReal(h,id,4)
local real y=LoadReal(h,id,5)
local real a=LoadReal(h,id,6)
local integer i=0
call UnitApplyTimedLife(CreateUnit(p,'e0HQ',x,y,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0HO',x,y,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0HP',x,y,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0HR',x,y,GetRandomReal(0,359)),'BTLF',2)
call UnitRemoveAbility(u,'Aeth')
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call SetUnitInvulnerable(c,false)
call ShowUnit(c,false)
call ShowUnit(c,true)
call SetUnitXY_1(c,x,y, false)
call HealTextTag(u,c,GetUnitState(c,UNIT_STATE_MAX_LIFE)*0.5*myCustomHeal2(c,1),"HealthRes")
call SetUnitState(c,UNIT_STATE_LIFE,GetUnitState(c,UNIT_STATE_MAX_LIFE)*0.5)
call IssuePointOrder(c,"move",x+500*Cos(a),y+500*Sin(a))
call UnitRemoveAbility(c,'A0QL')
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set u=null
set c=null
set t=null
endfunction
function RestronationCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(p)
local integer i=0
local real a=Atan2(y1-y,x1-x)
if 20>GetUnitLifePercent(c)then
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call SetUnitInvulnerable(c,true)
call IllusionStrikeFade(c,2.4)
call UnitApplyTimedLife(CreateUnit(p,'e0HQ',x,y,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0HO',x,y,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0HP',x,y,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0HR',x,y,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0OU',x-300*Cos(a),y-300*Sin(a),a*bj_RADTODEG),'BTLF',2)
call SaveReal(h,id,4,x-300*Cos(a))
call SaveReal(h,id,5,y-300*Sin(a))
call SaveReal(h,id,6,a)
call TimerStart(t,1.8,false,function RestronationCast2)
else
call IssueImmediateOrder(u,"Stop")
call DisplayTextToPlayer(p,0,0,Lng("|cFFFF0000Здоровье этого юнита выше 20%!|r","|cFFFF0000This unit's health is over 20%!|r"))
endif
set u=null
set p=null
set c=null
set t=null
endfunction
