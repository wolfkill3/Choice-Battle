function TLiCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
call SetUnitInvulnerable(u,true)
call PauseUnit(u,true)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveReal(h,id,2,0.6)
call SaveReal(h,id,3,0.3)
call SaveReal(h,id,4,x)
call SaveReal(h,id,5,y)
call SaveReal(h,id,6,3.55)
set n=CreateUnit(p,'e0RV',x,y,0)
call SetUnitVertexColor(n,255,255,255,125)
call SetUnitScale(n,2.7,2.7,2.7)
call UnitApplyTimedLife(n,'BTLF',5)
call SetUnitTimeScale(n,0.2)
set n=CreateUnit(p,'e125',x,y,a*bj_RADTODEG)
call LiCloneEffect(n,1.1,1.15,1.9,150)
call SetUnitAnimation(n,"Spell Slam One")
call SetUnitAnimation(u,"Spell Slam One")
set soundplay=SndN(2685) // Sound\Music\mp3Music\ShuwenUltimate.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.1,true,function TLiCast2)
set t=null
set c=null
set p=null
set u=null
endfunction
function InitTrig_TLi takes nothing returns nothing
set gg_trg_TLi=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_TLi,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_TLi,Condition(function TLiCond))
call TriggerAddAction(gg_trg_TLi,function TLiCast)
endfunction
function CloudMareCond takes nothing returns boolean
return GetSpellAbilityId()=='A04H' and udg_B==true and GetUnitTypeId(GetTriggerUnit())!='H007'
endfunction
function CloudMareCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
call GroupEnumUnitsInRange(G,x,y,900,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call ComboChecker(E,3,5, false )
endif
call GroupRemoveUnit(G,E)
endloop
set p=null
set u=null
set n=null
endfunction
function CloudMareInit takes nothing returns nothing
set gg_trg_CMare=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_CMare,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_CMare,Condition(function CloudMareCond))
call TriggerAddAction(gg_trg_CMare,function CloudMareCast)
endfunction
function TradeGoldCond takes nothing returns boolean
return GetTradeGold()>0
endfunction
function TradeGold takes nothing returns nothing
local player p=GetTradeSource()
local player p2=GetTradeTarget()
local integer i1=GetPlayerId(p)
local integer i2=GetPlayerId(p2)
local integer gold12=LoadInteger(HPlayer,i1,i2)
local integer gold21=LoadInteger(HPlayer,i2,i1)
local integer goldround12=LoadInteger(HPlayer,i1+20,i2+20)
local integer goldround21=LoadInteger(HPlayer,i2+20,i1+20)
local integer GoldInt
local integer GoldInt2
local integer GoldCurrentLimit
call SetTradeGold(GetTradeGold()-ModuloInteger(GetTradeGold(),10)) 
if GetTradeGold()>0 then
    set GoldInt=GetTradeGold()
    set GoldInt2=GetTradeGold()
    // call BJDebugMsg(GetPlayerName(Player(i1)) + "  gold12 " + I2S(gold12)+"    goldround12 "+I2S(goldround12)+"    goldlimit1 "+I2S(GoldLimit[i1]))
    // call BJDebugMsg(GetPlayerName(Player(i2)) + "  gold21 " + I2S(gold21)+"    goldround21 "+I2S(goldround21)+"    goldlimit2 "+I2S(GoldLimit[i2]))
    if GoldLimit[i2]+gold21==0 then
        call DisplayTimedWarningMessage(p,10,Lng("У игрока исчерпан лимит на получение золота.","The player has reached the limit for receiving gold."))
    endif
    if GetTradeGold()>GoldLimit[i2]+gold21 then
        //call BJDebugMsg("1")
        //call BJDebugMsg(I2S(GetTradeGold()))
        //call BJDebugMsg(" ")
        //call BJDebugMsg(I2S(GoldLimit[i2]))
        //call BJDebugMsg(I2S(gold21))
        if gold21>0 then
            call SetTradeGold(GoldLimit[i2]+gold21) 
            call SaveInteger(HPlayer,i1,i2,gold12+GoldLimit[i2]+gold21)
            call SaveInteger(HPlayer,i2,i1,gold21-GoldLimit[i2]-gold21)
            call SaveInteger(HPlayer,i1+20,i2+20,goldround12+GoldLimit[i2]+gold21)
            call SaveInteger(HPlayer,i2+20,i1+20,goldround21-GoldLimit[i2]-gold21)
        else
            call SetTradeGold(GoldLimit[i2]) 
            call SaveInteger(HPlayer,i1,i2,gold12+GoldLimit[i2])
            call SaveInteger(HPlayer,i2,i1,gold21-GoldLimit[i2])
            call SaveInteger(HPlayer,i1+20,i2+20,goldround12+GoldLimit[i2])
            call SaveInteger(HPlayer,i2+20,i1+20,goldround21-GoldLimit[i2])
        endif
        if GoldLimit[i1]+LoadInteger(HPlayer,i1+20,i2+20)<GoldTotalLimit[i1] then
            set GoldLimit[i1]=GoldLimit[i1]+LoadInteger(HPlayer,i1+20,i2+20)
        else
            set GoldLimit[i1]=GoldTotalLimit[i1]
        endif
        //call BJDebugMsg(" ")
        //call BJDebugMsg(I2S(GoldLimit[i1]))
        set GoldLimit[i2]=0
    else
        if gold21>0 then
            if GoldInt<=gold21 then
                //call BJDebugMsg("2")
                set gold21=gold21-GoldInt
                set gold12=gold12+GoldInt
                set goldround21=goldround21-GoldInt
                set goldround12=goldround12+GoldInt
                set GoldInt2=GoldInt+goldround21
                set GoldLimit[i1]=GoldLimit[i1]+GoldInt2
                call SaveInteger(HPlayer,i1,i2,gold12)
                call SaveInteger(HPlayer,i2,i1,gold21)
                call SaveInteger(HPlayer,i1+20,i2+20,goldround12)
                call SaveInteger(HPlayer,i2+20,i1+20,goldround21)
            else
                //call BJDebugMsg("3")
                set GoldInt=goldround21-GoldInt
                set GoldLimit[i2]=GoldLimit[i2]+GoldInt
                set GoldLimit[i1]=GoldLimit[i1]-GoldInt
                call SaveInteger(HPlayer,i1,i2,gold12+GetTradeGold())
                call SaveInteger(HPlayer,i2,i1,gold21-GetTradeGold())
                call SaveInteger(HPlayer,i1+20,i2+20,goldround12+GetTradeGold())
                call SaveInteger(HPlayer,i2+20,i1+20,goldround21-GetTradeGold())
            endif
        else
            //call BJDebugMsg("4")
            set gold12=LoadInteger(HPlayer,i1,i2)
            set gold21=LoadInteger(HPlayer,i2,i1)
            set goldround12=LoadInteger(HPlayer,i1+20,i2+20)
            set goldround21=LoadInteger(HPlayer,i2+20,i1+20)
            set GoldLimit[i2]=GoldLimit[i2]-GoldInt
            call SaveInteger(HPlayer,i1,i2,gold12+GoldInt)
            call SaveInteger(HPlayer,i2,i1,gold21-GoldInt)
            call SaveInteger(HPlayer,i1+20,i2+20,goldround12+GoldInt)
            call SaveInteger(HPlayer,i2+20,i1+20,goldround21-GoldInt)
        endif
    endif
    set gold12=LoadInteger(HPlayer,i1,i2)
    set gold21=LoadInteger(HPlayer,i2,i1)
    set goldround12=LoadInteger(HPlayer,i1+20,i2+20)
    set goldround21=LoadInteger(HPlayer,i2+20,i1+20)
    // call BJDebugMsg(GetPlayerName(Player(i1)) + "  gold12 " + I2S(gold12)+"    goldround12 "+I2S(goldround12)+"    goldlimit1 "+I2S(GoldLimit[i1]))
    // call BJDebugMsg(GetPlayerName(Player(i2)) + "  gold21 " + I2S(gold21)+"    goldround21 "+I2S(goldround21)+"    goldlimit2 "+I2S(GoldLimit[i2]))
endif
set p=null
set p2=null
endfunction
function TrageGoldInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerEvent(t,Player(i),EVENT_PLAYER_TRADE_RESOURCE)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddCondition(t,Condition(function TradeGoldCond))
call TriggerAddAction(t,function TradeGold)
set t=null
endfunction
