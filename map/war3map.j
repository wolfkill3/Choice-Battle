//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SetUnitTimeScale(u,.15)
call SetUnitAnimation(u,"attack")
endif
call TimerStart(t,1.2,false,function ARoarCast1)
set u=null
set t=null
endfunction
