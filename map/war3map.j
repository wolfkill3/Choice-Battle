function OrochimaruTCast takes nothing returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local unit u=GetTriggerUnit()
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetSpellTargetX()
    local real y1=GetSpellTargetY()
    local real a=Atan2(y1-y,x1-x)
    local player p=GetOwningPlayer(u)
    local group g=CreateGroup()
    if SR(x,y,x1,y1)<1500 then
    set x=x1-1500*Cos(a)
    set y=y1-1500*Sin(a)
    call SetUnitXY_1(u,x,y, false)
    endif
    call SaveUnitHandle(h,id,0,u)
    call SaveReal(h,id,1,x)
    call SaveReal(h,id,2,y)
    call SaveReal(h,id,3,x1)
    call SaveReal(h,id,4,y1)
    call SaveReal(h,id,5,a)
    call SaveGroupHandle(h,id,6,g)
    call PauseUnit(u,true)
    call SetUnitAnimationByIndex(u,5)
    set n=CreateUnit(p,0x6F723038,x,y,a*bj_RADTODEG)
    call SetUnitTimeScale(n,0.5)
    call UnitApplyTimedLife(n,1,1.3)
    set n=CreateUnit(p,'ed0O',x,y,0)
    call SetUnitVertexColor(n,255,255,255,155)
    call SetUnitScale(n,1.2,1.2,1.2)
    call UnitApplyTimedLife(n,1,1.3)
    call SetUnitInvulnerable(u,true)
    set soundplay=CreateSound("Sound\\Music\\mp3Music\\OrochimaruT1.mp3",false,false,true,12700,12700,"")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    call TimerStart(t,0.5,false,function OrochimaruTCast2)
    set t=null
    set u=null
    set p=null
    set g=null
endfunction
function InitTrig_OrochimaruT takes nothing returns nothing
    set gg_trg_OrochimaruT=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_OrochimaruT,EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_OrochimaruT,Condition(function OrochimaruTCond))
    call TriggerAddAction(gg_trg_OrochimaruT,function OrochimaruTCast)
endfunction
function OrochimaruVCond takes nothing returns boolean
    return GetSpellAbilityId()=='OM14' and udg_B==true and DU==true
endfunction
function OrochimaruVCast4 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit c=LoadUnitHandle(h,id,1)
    local unit l__d=LoadUnitHandle(h,id,2)
    local unit d2=LoadUnitHandle(h,id,5)
    local player p=GetOwningPlayer(u)
    local integer perc=LoadInteger(h,id,4)
    local integer i=1
    local integer rp=0
    local real x=GetUnitX(l__d)
    local real y=GetUnitY(l__d)
    local real x3=GetUnitX(u)
    local real y3=GetUnitY(u)
    local real x1=GetUnitX(c)
    local real y1=GetUnitY(c)
    local real sr=SR(x3,y3,x1,y1)
    local real x2
    local real y2
    local real mh=GetUnitState(u,UNIT_STATE_MAX_LIFE)
    local real hpcof
    local real he=GetUnitState(u,UNIT_STATE_LIFE)
    local real a=Atan2(y1-y3,x1-x3)
    local group g=LoadGroupHandle(h,id,3)
    call PauseUnit(u,false)
    call UnitRemoveBuffs(u,true,true)
    if UnitHasItemOfTypeBJ(u, 'I03A') and GetWidgetLife(u)>0 and IsUnitIllusion(u)==false then
        set AlastorPos=0
        loop
        exitwhen AlastorPos==6 or GetItemTypeId(UnitItemInSlot(u,AlastorPos)) == 'I03A'
        set AlastorPos=AlastorPos+1
        endloop
        set Alastor=GetItemOfTypeFromUnitBJ(u,'I03A')
        call UnitRemoveItem(u,Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(u, 'I03A',AlastorPos)
    endif
    call UnitAddAbility(u,'A0WR')
    call SetUnitInvulnerable(u,false)
    if udg_B==true then
    call myCustomDamage(c,u,mh*he,false,false,null,DAMAGE_TYPE_UNIVERSAL,null)
    endif
    call UnitRemoveAbility(u,'A0WR')
    call ForGroup(g,function KillGroup)
    call RemoveUnit(LoadUnitHandle(h,id,7))
    call FlushChildHashtable(h,id)
    call DestroyTimer(t)
    call DestroyGroup(g)
    set g=null
    set t=null
    set u=null
    set l__d=null
    set d2=null
    set c=null
    set p=null
endfunction
function OrochimaruVCast3 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit c=LoadUnitHandle(h,id,1)
    local unit l__d=LoadUnitHandle(h,id,2)
    local unit d2=LoadUnitHandle(h,id,5)
    local real time=LoadReal(h,id,8)
    local player p=GetOwningPlayer(u)
    local integer perc=LoadInteger(h,id,4)
    local integer i=1
    local integer rp=0
    local real x=GetUnitX(l__d)
    local real y=GetUnitY(l__d)
    local real x3=GetUnitX(u)
    local real y3=GetUnitY(u)
    local real x1=GetUnitX(c)
    local real y1=GetUnitY(c)
    local real sr=SR(x3,y3,x1,y1)
    local real x2
    local real y2
    local real mh=GetUnitState(u,UNIT_STATE_MAX_LIFE)
    local real hpcof
    local real he=GetUnitState(u,UNIT_STATE_LIFE)
    local real a=Atan2(y1-y3,x1-x3)
    local group g=LoadGroupHandle(h,id,3)
    if GetWidgetLife(u)>mh*0.006+1 and UnitIsAlive(c) and time<5 then
    if GetUnitStatePercent(u,UNIT_STATE_LIFE,UNIT_STATE_MAX_LIFE)>=GetUnitStatePercent(c,UNIT_STATE_LIFE,UNIT_STATE_MAX_LIFE)then
    set hpcof=GetUnitStatePercent(c,UNIT_STATE_LIFE,UNIT_STATE_MAX_LIFE)/GetUnitStatePercent(u,UNIT_STATE_LIFE,UNIT_STATE_MAX_LIFE)
    else
    set hpcof=GetUnitStatePercent(u,UNIT_STATE_LIFE,UNIT_STATE_MAX_LIFE)/GetUnitStatePercent(c,UNIT_STATE_LIFE,UNIT_STATE_MAX_LIFE)
    endif
    set rp=R2I(hpcof*(perc))+20
    if rp>perc then
    set rp=perc
    endif
    if rp<20 then
    set rp=20
    endif
    loop
    exitwhen i>=perc
    set E=LoadUnitHandle(h,id,rp+i)
    call SetUnitVertexColor(E,255,255,255,0)
    set i=i+1
    endloop
    set E=LoadUnitHandle(h,id,rp)
    call SetUnitVertexColor(E,255,255,255,155)
    set x2=GetUnitX(E)
    set y2=GetUnitY(E)
    call SetUnitX(l__d,x2)
    call SetUnitY(l__d,y2)
    call SetUnitX(d2,x2)
    call SetUnitY(d2,y2)
    call SetUnitX(l__d,x2)
    call SetUnitY(l__d,y2)
    call SetUnitX(d2,x2)
    call SetUnitY(d2,y2)
    call SaveReal(h,id,8,time+0.02)
    call SetUnitState(u,UNIT_STATE_LIFE,he-mh*0.006)
    call PauseUnit(c,false)
    call SetUnitInvulnerable(c,false)
    call myCustomDamage(u,c,mh*0.006,false,false,null,null,null)
    call SetUnitInvulnerable(c,true)
    call PauseUnit(c,true)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
    else
    call SetUnitInvulnerable(u,false)
    call SetUnitInvulnerable(c,false)
    call PauseTimer(t)
    call RemoveUnit(l__d)
    call RemoveUnit(d2)
    call PauseUnit(c,false)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
    call UnitRemoveAbility(u,0x6f726536)
    set n=CreateUnit(p,'or03',x3,y3,GetRandomReal(0,359))
    call UnitApplyTimedLife(n,1,0.5)
    set n=CreateUnit(p,'or04',x3,y3,GetRandomReal(0,359))
    call UnitApplyTimedLife(n,1,0.75)
    call TimerStart(t,0.5,false,function OrochimaruVCast4)
    endif
    set g=null
    set t=null
    set u=null
    set l__d=null
    set d2=null
    set c=null
    set p=null
endfunction
function OrochimaruVCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit c=LoadUnitHandle(h,id,1)
    local unit l__d=LoadUnitHandle(h,id,2)
    local player p=GetOwningPlayer(u)
    local integer perc=LoadInteger(h,id,4)+1
    local real x=GetUnitX(l__d)
    local real y=GetUnitY(l__d)
    local real x1=GetUnitX(c)
    local real y1=GetUnitY(c)
    local real x2
    local real y2
    local real a=Atan2(y1-y,x1-x)
    local group g=LoadGroupHandle(h,id,3)
    if SR(x,y,x1,y1)>30 then
    set x=x+20*Cos(a)
    set y=y+20*Sin(a)
    call SetUnitX(l__d,x)
    call SetUnitY(l__d,y)
    set n=CreateUnit(p,0x6F723434,x,y,a*bj_RADTODEG)
    call SetUnitVertexColor(n,255,255,255,155)
    call SaveUnitHandle(h,id,perc,n)
    call GroupAddUnit(g,n)
    call SaveInteger(h,id,4,perc)
    else
    call SetUnitTimeScale(LoadUnitHandle(h,id,7),0)
    call PauseTimer(t)
    set n=CreateUnit(p,0x6F723435,x1,y1,a*bj_RADTODEG)
    call SaveUnitHandle(h,id,5,n)
    call TimerStart(t,0.02,true,function OrochimaruVCast3)
    endif
    set g=null
    set t=null
    set u=null
    set l__d=null
    set c=null
    set p=null
endfunction
function OrochimaruVCast takes nothing returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local unit u=GetTriggerUnit()
    local unit c=GetSpellTargetUnit()
    local player p=GetOwningPlayer(u)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetUnitX(c)
    local real y1=GetUnitY(c)
    local real x2
    local real y2
    local real a=Atan2(y1-y,x1-x)
    local group g=CreateGroup()
    if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
        set x2=x-150*Cos(a)
        set y2=y-150*Sin(a)
        set n=CreateUnit(p,0x6F723432,x2,y2,a*bj_RADTODEG)
        call GroupAddUnit(g,n)
        call SaveUnitHandle(h,id,0,u)
        call SaveUnitHandle(h,id,1,c)
        set n=CreateUnit(p,0x6F723433,x,y,a*bj_RADTODEG)
        call SaveUnitHandle(h,id,2,n)
        call SetUnitVertexColor(n,255,255,255,155)
        call SaveGroupHandle(h,id,3,g)
        call SaveInteger(h,id,4,19)
        call PauseUnit(u,true)
        call PauseUnit(c,true)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
        call SetUnitInvulnerable(u,true)
        call SetUnitInvulnerable(c,true)
        set n=CreateUnit(p,0x6F723038,x,y,a*bj_RADTODEG)
        call SetUnitTimeScale(n,0.3)
        call GroupAddUnit(g,n)
        set n=CreateUnit(p,'ed0O',x,y,0)
        call SetUnitVertexColor(n,255,255,255,155)
        call SetUnitTimeScale(n,0.5)
        call SaveReal(h,id,8,0)
        call SetUnitScale(n,1.5,1.5,1.5)
        call SaveUnitHandle(h,id,7,n)
        call UnitAddAbility(u,0x6f726536)
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\OrochimaruV.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        call TimerStart(t,0.02,true,function OrochimaruVCast2)
    else
        call GroupClear(g)
        call DestroyGroup(g)
        call PauseTimer(t)
        call SetUnitFlyHeight(u,0,0)
        call DestroyTimer(t)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
        call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
        call FlushChildHashtable(h,id)
    endif
    set t=null
    set u=null
    set c=null
    set g=null
    set p=null
endfunction
function InitTrig_OrochimaruV takes nothing returns nothing
    set gg_trg_OrochimaruV=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_OrochimaruV,EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_OrochimaruV,Condition(function OrochimaruVCond))
    call TriggerAddAction(gg_trg_OrochimaruV,function OrochimaruVCast)
    endfunction
