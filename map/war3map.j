call EffectCreateAndMove(true,"BlackGoku\\HakkeStart2.mdl",facing,1,0.8,1.5,100,100,100,50,0,caster,0,facing)
call EffectCreateAndMove(true,"Others\\windNewFaw6.mdl",facing,1,GetRandomReal(1.5,2),GetRandomReal(1.5,3),100,100,100,30,0,caster,0,facing)
