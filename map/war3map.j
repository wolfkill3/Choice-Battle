function PushRasenRengan4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real a=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real dist=LoadReal(h,id,3)
local player p=GetOwningPlayer(l__d)
if dist>0 and udg_B==true and l__d!=null then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SaveReal(h,id,3,dist-speed)
call SaveReal(h,id,1,speed-speed*0.03)
set n=CreateUnit(p,'e0SC',x,y,a*bj_RADTODEG)
call SetUnitAnimation(n,"death")
call SetUnitScale(n,1,1,1)
call UnitApplyTimedLife(n,'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0SA',x,y,a*bj_RADTODEG),'BTLF',2)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set t=null
endfunction
function PushRasenRengan3 takes unit l__d,real speed,real angle,real dist returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle)
call SaveReal(h,id,3,dist)
call TimerStart(t,0.03,true,function PushRasenRengan4)
set t=null
endfunction
function RasenRenganCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,22)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local real dmg=((GetUnitAbilityLevel(u,'A0V8')+2)*GetHeroStr(u,true))
local player p=GetOwningPlayer(u)
local real dist=SR(x,y,x1,y1)
if dist>60 and UnitIsAlive(u)and UnitIsAlive(c) and IsTerrainPathable(GetUnitX(u),GetUnitY(u),PATHING_TYPE_FLYABILITY)==false then
call PauseUnit(u,true)
set x=x+45*Cos(a)
set y=y+45*Sin(a)
call SetUnitXY_1(u,x,y, false)
call SetUnitFacing(u,a*bj_RADTODEG)
set n=CreateUnit(p,'e0S9',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.25)
call SetUnitTimeScale(n,2)
call SetUnitVertexColor(n,255,255,255,125)
call SetUnitAnimation(n,"Spell Three")
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,0.65,0.65,0.65)
call SetUnitVertexColor(n,150,200,255,50)
set n=CreateUnit(p,'e0RR',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitVertexColor(n,255,255,255,50)
call SaveReal(h,id,2,dist+60)
else
call UnitApplyTimedLife(CreateUnit(p,'e0SA',x1,y1,a*bj_RADTODEG),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0SB',x1,y1,a*bj_RADTODEG),'BTLF',2)
set n=CreateUnit(p,'e0SC',x1,y1,a*bj_RADTODEG)
call SetUnitAnimation(n,"death")
call UnitApplyTimedLife(n,'BTLF',1)
set n=CreateUnit(p,'e0SD',x1,y1,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,2)
call UnitApplyTimedLife(CreateUnit(p,'e0SE',x1,y1,a*bj_RADTODEG),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0SF',x1,y1,a*bj_RADTODEG),'BTLF',2)
call PushRasenRengan3(c,35,a,450)
call SetUnitInvulnerable(u,false)
call SetControlToUnit(u,c,1, "stun")
call PauseUnit(u,false)
call SetUnitAnimation(u,"Spell Throw")
call UnitRemoveAbility(u,'A0V0')
call SetUnitInvulnerable(u,false)
call myCustomDamage(Hero[GetPlayerId(p)],c,dmg,false,false,null,null,null)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set c=null
set u=null
set t=null
endfunction
function RasenRenganCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,22)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,5)
local real y1=LoadReal(h,id,6)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real dmg=LoadReal(h,id,4)
local real dist=LoadReal(h,id,2)
local real scale=LoadReal(h,id,10)
local real time=LoadReal(h,id,17)
if time>0 then
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
