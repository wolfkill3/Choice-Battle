                        call SetSpecialEffectVertexColour(EFF,ColorPercentT(100,255),ColorPercentT(100,255),ColorPercentT(100,255),ColorPercentT((100),255))
                        call SetSpecialEffectZ(EFF,100)
                        call EffectLifeTime(EFF,0.5)
                        call MoveEffect(c,EFF,cjlocgn_00000000,LoadReal(HH,id,3))
                        call MoveEffect(c,EFF,cjlocgn_00000001,cjlocgn_00000002)
                        call SetSpecialEffectFacing(EFF,cjlocgn_00000003)
                        set EFF=AddSpecialEffect("war3mapImported\\CF2.mdl",GetUnitX(c),GetUnitY(c))
                        call SetSpecialEffectScale(EFF,GetRandomReal(0.3,0.4))
                        call SetSpecialEffectTimeScale(EFF,GetRandomReal(0.6,0.8))
                        call SetSpecialEffectVertexColour(EFF,ColorPercentT(100,255),ColorPercentT(70,255),ColorPercentT(70,255),ColorPercentT((100-GetRandomInt(30,40)),255))
                        call SetSpecialEffectZ(EFF,100)
                        call EffectLifeTime(EFF,0.5)
                        call MoveEffect(c,EFF,cjlocgn_00000000,LoadReal(HH,id,3))
                        call MoveEffect(c,EFF,cjlocgn_00000001,cjlocgn_00000002)
                        call SetSpecialEffectFacing(EFF,cjlocgn_00000003)
                endif
                if i1>=10 then
                        call UnitSpeed(u,2.5)
                        call UnitSpeed(c,1.5)
                        call SetUnitAnimation(c,"Death")
                        set i1=0
                endif
                call SaveInteger(HH,id,6,i1)
