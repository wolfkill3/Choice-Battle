call SaveEffectHandle(HH,idu,StringHash("yamatoEffect3"),AddSpecialEffectTarget("Abilities\\Weapons\\WaterElementalMissile\\WaterElementalMissile.mdl",u,"right hand"))
call SaveReal(HH,idu,StringHash("yamatotime"),0)
call SaveReal(HH,idu,StringHash("yamato"),1)
