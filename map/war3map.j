function DogDeathAct takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local integer i
set i=0
loop
exitwhen i>15
call SaveInteger(HH,GetHandleId(u),TextDamageValueHash+i,0)
call SaveStr(HH,GetHandleId(u),i+TextDmgValueTextHash,"")
set i=i+1
endloop
call SetTextTagVelocity(LoadTextTagHandle(HH,GetHandleId(u),TextTagTargetHash),0.2*Cos(1.571),0.2*Sin(1.571))
call SetTextTagFadepoint(LoadTextTagHandle(HH,GetHandleId(u),TextTagTargetHash),0.5)
call SetTextTagLifespan(LoadTextTagHandle(HH,GetHandleId(u),TextTagTargetHash),0.2)
call RemoveSavedHandle(HH,GetHandleId(u),TextTagTargetHash)
call UnitApplyTimedLife(CreateUnit(p,'e0KE',x,y,GetRandomReal(0,359)),'BTLF',0.3)
call UnitApplyTimedLife(CreateUnit(p,'e0KG',x,y,GetRandomReal(0,359)),'BTLF',0.5)
call RemoveUnit(u)
set u=null
set p=null
