if SR(GetUnitY(E),y,GetUnitX(E),x)<340 then
call SetUnitXY_1(E,GetUnitX(E)+5*Cos(Atan2(GetUnitY(E)-y,GetUnitX(E)-x)),GetUnitY(E)+5*Sin(Atan2(GetUnitY(E)-y,GetUnitX(E)-x)),false)
elseif SR(GetUnitY(E),y,GetUnitX(E),x)>=340 and SR(GetUnitY(E),y,GetUnitX(E),x)<400 then
call SetUnitXY_1(E,GetUnitX(E)-5*Cos(Atan2(GetUnitY(E)-y,GetUnitX(E)-x)),GetUnitY(E)-5*Sin(Atan2(GetUnitY(E)-y,GetUnitX(E)-x)),false)
endif
elseif Condition_Base(p,E) then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
