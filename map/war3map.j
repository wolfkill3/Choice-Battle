endfunction
function ArcueidFCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real time=LoadReal(h,id,2)
local real per=LoadReal(h,id,3)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
if UnitIsAlive(l__d)and UnitIsAlive(u)==false and udg_B==true and DU2==true then
    call SetUnitInvulnerable(l__d,true)
    call SetUnitState(l__d,UNIT_STATE_LIFE,time)
    call SaveReal(h,id,3,per-0.2)
    if per<0 then
        call SaveReal(h,id,3,0.99)
        call SaveReal(h,id,2,time-1)
    endif
else
    if udg_B==true then
        call ReviveHero(u,x,y,false)
        call SetUnitControlCount(u, 11,0)
        call SetUnitState(u,UNIT_STATE_LIFE,1)
        call SetUnitState(u,UNIT_STATE_MANA,1)
        call HealTextTag(u,u,GetUnitState(u,UNIT_STATE_MAX_LIFE)*myCustomHeal2(u,1),"HealthRes")
        call HealTextTag(u,u,GetUnitState(u,UNIT_STATE_MAX_MANA)*myCustomMana2(u,1),"ManaRes")
        call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_MAX_LIFE))
        call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MAX_MANA))
        if GetLocalPlayer()==p then
            call ClearSelection()
            call SelectUnit(u,true)
        endif
        call SetUnitFacing(u,f)
        set bjLCG=CreateGroup()
        call GroupEnumUnitsInRect(bjLCG, bj_mapInitialPlayableArea, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            if IsUnitType(E,UNIT_TYPE_HERO)and IsUnitAlly(E,p)==false and E!=u then
                if GetUnitAbilityLevel(E, 'A1FA')==0 then
                    call UnitAddAbility(E,'A1FA')
                    call UnitMakeAbilityPermanent(E,true,'A1FA')
                endif
                call SetUnitAbilityLevel(E,     'A1FA', GetUnitAbilityLevel(u, 'A1F9'))
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIil\\AIilTarget.mdl",E,"origin"))
            endif
            call GroupRemoveUnit(bjLCG, E)
        endloop 
        call DestroyGroup(bjLCG)
    endif
    call RemoveUnit(l__d)
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(h,id)
endif
set t=null
set u=null
set l__d=null
set p=null
endfunction
