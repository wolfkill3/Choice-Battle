call UnitSpeed(n0,1)
call MyRemoveUnit(n0,1.5)
set n0=null
call SaveInteger(HH,id,25,GetRandomInt(1,2))
call SetUnitPathing(caster,true)
if LoadBoolean(HH,GetHandleId(caster),StringHash("MadaraSusT2"))==true then
call SetUnitAnimationByIndex(caster,2)
else
call SetUnitAnimationByIndex(caster,1)
endif
set soundplay=CreateSound("war3mapimported\\MadaraE2.mp3",false,false,true,12700,12700,"")
                        call StartSound(soundplay)
                        call KillSoundWhenDone(soundplay)
call EffectCreateAndMove(true,"Madara\\az_siwen2.mdl",facing,1,1.25,0.5,100,100,100,30,100,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\HakenSaber2.mdl",facing,1,1.5,0.5,100,100,100,30,0,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\WindNewFaw4.mdl",facing,1,1.25,0.5,100,100,100,30,0,caster,0,facing)
endif
endif
set t=null
set caster=null
endfunction

