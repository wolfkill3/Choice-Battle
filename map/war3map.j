function RagingBoltCond takes nothing returns boolean
return GetSpellAbilityId()=='A0RY'
endfunction
function RagingBoltCast2 takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(h,id,0)
        local real x1=LoadReal(h,id,5)
        local real y1=LoadReal(h,id,6)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        local unit l__d=LoadUnitHandle(h,id,1)
        local player p=GetOwningPlayer(u)
        local real dmg=(1+GetUnitAbilityLevel(u,'A0RY'))*GetHeroStr(u,true)+GetUnitAbilityLevel(u,'A0RY')*75
        local real he=GetUnitFlyHeight(l__d)-35
        local group g=LoadGroupHandle(h,id,7)
        local real time=LoadReal(h,id,8)
        local integer l__idg=GetHandleId(g)
        local integer act=LoadInteger(h, id, SH_Act)
        call MoveLightningEx(LoadLightningHandle(h,id,2),false,x,y,GetUnitZCustom(u)+75,x1,y1,GetUnitZCustom(l__d))
        call MoveLightningEx(LoadLightningHandle(h,id,3),false,x,y,GetUnitZCustom(u)+75,x1,y1,GetUnitZCustom(l__d))
        call MoveLightningEx(LoadLightningHandle(h,id,4),false,x,y,GetUnitZCustom(u)+75,x1,y1,GetUnitZCustom(l__d))
        if act==0 then
                if time<1 then
                        call SaveReal(h,id,8,time+0.05)
                else
                        call SaveInteger(h, id, SH_Act, act+1)
                        call SaveReal(h,id,8,0.0)
                endif
        else
                if he>30 then
                        call SetUnitFlyHeight(l__d,he,0)
                else
                        call SaveReal(h,id,8,time+0.05)
                        if time>1.2 then
                                call KillUnit(LoadUnitHandle(h, id, 10))
                                call MyRemoveUnit(LoadUnitHandle(h, id, 10), 1.5)
                                call PauseTimer(t)
                                call RemoveUnit(l__d)
                                call DestroyLightning(LoadLightningHandle(h,id,2))
                                call DestroyLightning(LoadLightningHandle(h,id,3))
                                call DestroyLightning(LoadLightningHandle(h,id,4))
                                // call SetUnitInvulnerable(u,false)
                                // call PauseUnit(u,false)
                                call DestroyTimer(t)
                                call DestroyGroup(g)
                                call FlushChildHashtable(h,id)
                                call FlushChildHashtable(h,l__idg)
                        endif
                        call GroupEnumUnitsInRange(g,x1,y1,500,Base)
                        loop
                        set E=FirstOfGroup(g)
                        set ide=GetHandleId(E)
                        exitwhen E==null
                                if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,ide)then
                                        call myCustomDamage(u,E,dmg,false,false,null,null,null)
                                        call SetControlToUnit(E,E, 2, "stun")
                                        set n=CreateUnit(p, 'd054', GetUnitX(E), GetUnitY(E), GetRandomInt(0, 360))
                                        call SetUnitScale(n, 1.2, 1.2, 1.2)
                                        call SetUnitFlyHeight(n, 50, 0)
                                        call UnitApplyTimedLife(n,'BTLF', 0.65)
                                        call MyRemoveUnit(n, 1.5)
                                        call SaveUnitHandle(h,l__idg,ide,E)
                                endif
                                call GroupRemoveUnit(g,E)
                        endloop
                        call UnitApplyTimedLife(CreateUnit(p,'e0QI',x1,y1,GetRandomReal(0,359)),'BTLF',0.01)
                        call UnitApplyTimedLife(CreateUnit(p,'e0QG',x1,y1,GetRandomReal(0,359)),'BTLF',0.01)
                        call UnitApplyTimedLife(CreateUnit(p,'e0QK',x1,y1,GetRandomReal(0,359)),'BTLF',0.5)
                        set n=CreateUnit(p, 'd054', x1+GetRandomReal(-400, 400), y1+GetRandomReal(-400, 400), GetRandomInt(0, 360))
                        call SetUnitScale(n, 0.7, 0.7, 0.7)
                        call SetUnitFlyHeight(n, 5, 0)
                        call UnitApplyTimedLife(n,'BTLF', 0.65)
                        call MyRemoveUnit(n, 1.5)
                endif
        endif
        set g=null
        set l__d=null
        set p=null
        set u=null
        set t=null
endfunction
function RagingBoltCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
// call PauseUnit(u,true)
// call SetUnitInvulnerable(u,true)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,CreateUnit(GetOwningPlayer(u),'e0QF',x1,y1,0))
set n=CreateUnit(GetOwningPlayer(u), 'd055',x1,y1,0)
call SaveUnitHandle(h, id, 10, n)
call SaveLightningHandle(h,id,2,AddLightningEx("AFOD",false,x,y,GetUnitZCustom(u)+75,x1,y1,500))
call SaveLightningHandle(h,id,3,AddLightningEx("AFOD",false,x,y,GetUnitZCustom(u)+75,x1,y1,500))
call SaveLightningHandle(h,id,4,AddLightningEx("AFOD",false,x,y,GetUnitZCustom(u)+75,x1,y1,500))
call SaveReal(h,id,5,x1)
call SaveReal(h,id,6,y1)
call SaveGroupHandle(h,id,7,CreateGroup())
call SaveReal(h,id,8,0)
set soundplay=SndN(1987) // Sound\Music\mp3Music\Laxus Raging Bolt.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.05,true,function RagingBoltCast2)
set u=null
set t=null
endfunction

function LaxusNewSpellsCast takes nothing returns nothing
        if GetSpellAbilityId()=='LaxD' then
                call LaxusD_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY(), CreateTimer()) // Laxus E new
        endif
endfunction

function LaxusNewSpellsInit takes nothing returns nothing
        local trigger t=CreateTrigger()
        local integer i=0
        loop
                call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
                set i=i+1
                exitwhen i>=bj_MAX_PLAYER_SLOTS
        endloop
        call TriggerAddAction(t,function LaxusNewSpellsCast)
        set t=null
endfunction
function Trig_Imperor_Conditions takes nothing returns boolean
local integer i=GetSpellAbilityId()
return GetUnitAbilityLevel(GetTriggerUnit(),'A16P')>0 and GetHeroLevel(GetTriggerUnit())>11 and(i=='A0SY' or i=='A0SX' or i=='A0SW' or i=='A0SS' or i=='A0SP')
endfunction
function Trig_Imperor_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local integer i=GetRandomInt(1,4)
local integer is=GetRandomInt(1,1+R2I(GetHeroLevel(u)/7))
local integer l__s=0
if GetSpellAbilityId()=='A0SP' then
set is=GetRandomInt(1,1+R2I(GetHeroLevel(u)/35))
endif
loop
exitwhen l__s==is
if i==1 then
set x=x+GetRandomReal(-300,300)
set y=y+GetRandomReal(-300,300)
set n=CreateUnit(p,'h05T',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',10)
call SetUnitBaseDamageByIndex(n,0,50+R2I(GetHeroStr(u,true)*0.3))
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
elseif i==2 then
set x=x+GetRandomReal(-300,300)
set y=y+GetRandomReal(-300,300)
set n=CreateUnit(p,'h05U',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',10)
call SetUnitBaseDamageByIndex(n,0,50+R2I(GetHeroStr(u,true)*0.3))
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
elseif i==3 then
set x=x+GetRandomReal(-300,300)
set y=y+GetRandomReal(-300,300)
set n=CreateUnit(p,'h05V',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',10)
call SetUnitBaseDamageByIndex(n,0,50+R2I(GetHeroStr(u,true)*0.3))
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
elseif i==4 then
set x=x+GetRandomReal(-300,300)
set y=y+GetRandomReal(-300,300)
set n=CreateUnit(p,'h05W',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',10)
call SetUnitBaseDamageByIndex(n,0,50+R2I(GetHeroStr(u,true)*0.3))
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
endif
set i=GetRandomInt(1,4)
set l__s=l__s+1
endloop
set p=null
set u=null
endfunction
function InitTrig_Imperor takes nothing returns nothing
set gg_trg_Imperor=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Imperor,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_Imperor,Condition(function Trig_Imperor_Conditions))
