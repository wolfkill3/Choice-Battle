function PaperCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local trigger tt=CreateTrigger()
local real a=GetUnitFacing(u)*bj_DEGTORAD
local real ang=150*bj_DEGTORAD
local real damage = ((GetUnitAbilityLevel(u,'A0U4')+2)*GetHeroStr(u,true)+50)
if GetUnitAbilityLevel(u,'A0U5') > 0 then
        set damage = damage * (1.125+0.025*GetUnitAbilityLevel(u,'A0U5'))
endif
call SaveUnitHandle(h,id,0,u)
call SaveTriggerHandle(h,id,1,tt)
call SaveReal(h,id,4,damage)
call SaveReal(h,id,2,2700)
call SaveReal(h,id,10,1.25)
call SaveReal(h,id,17,1.7)
call SetUnitTimeScale(u,0)
call SetUnitInvulnerable(u,true)
call SaveGroupHandle(h,id,12,CreateGroup())
set n=CreateUnit(p,'e0RD',x+65*Cos(a-ang),y+65*Sin(a-ang),a*bj_RADTODEG)
call SaveUnitHandle(h,id,7,n)
if GetUnitTypeId(u)=='H04B' then
call SetUnitFlyHeight(n,110,0)
endif
call SetUnitScale(n,0.2,0.2,0.2)
if GetUnitTypeId(u)!='H04B' then
set soundplay=SndN(2052) // Sound\Music\mp3Music\JajankenBase.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
set soundplay=SndN(2059) // Sound\Music\mp3Music\GonGQ.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call UnitAddAbility(u,'A1FU') //Slow
call UnitAddAbility(u,'Pet1')
call SetUnitAcquireRange(u,51)
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_POINT_ORDER)
call StartAbilityCooldown(GetUnitAbility(u,'A0U4'),GetAbilityRemainingCooldown(GetUnitAbility(u,'A0U4')))
call TriggerAddAction(tt,function GonPaperStopOrders)
call TimerStart(t,0.1,true,function PaperCast2)
set u=null
set p=null
set t=null
set tt=null
endfunction
