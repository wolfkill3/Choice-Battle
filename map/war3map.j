function CambioEffectCond takes nothing returns boolean
return GetLearnedSkill()=='A0HC'
endfunction
function CambioEffectAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local integer i=0
local integer idu=GetHandleId(u)
local integer strh=TIME_HASH
local integer hs=LoadInteger(HH,idu,StringHash("d"))
local real f=0
local real time=LoadReal(HH,idu,strh)+0.04
local integer ids=0
local real ml=GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.05
set txt=LoadTextTagHandle(HH,id,1)
if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
call SaveReal(HH,idu,strh,time)
call HealTextTag(u,u,(GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.0025)*hs*0.04*myCustomHeal2(u,1),"HealthRes")
call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+(GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.0025)*hs*0.04)
endif
if hs>=3 and hs<=5 then
set ids=0x41304845
elseif hs>=6 and hs<=8 then
set ids=0x41304846
elseif hs>8 then
set ids=0x41304847
endif
if GetUnitAbilityLevel(u,0x41304845)>0 and hs>5 then
call UnitRemoveAbility(u,0x41304845)
elseif GetUnitAbilityLevel(u,0x41304846)>0 and hs>8 then
call UnitRemoveAbility(u,0x41304846)
elseif GetUnitAbilityLevel(u,0x41304846)>0 and hs<8 then
call UnitRemoveAbility(u,0x41304847)
endif
if time>=25 then
call SaveReal(HH,idu,strh,0)
call UnitRemoveAbility(u,'A1A3')
if hs>0 then
call SaveInteger(HH,idu,StringHash("d"),hs-1)
endif
endif
call SetTextTagPos(txt,GetUnitX(u)-190*Cos(f),GetUnitY(u)-190*Sin(f),GetUnitFlyHeight(u)+100+(10.5*0.08)/10)
if GetUnitAbilityLevel(u,'A1A3')>0 then
if GetUnitAbilityLevel(u,0x41304845)==0 and GetUnitAbilityLevel(u,0x41304846)==0 and GetUnitAbilityLevel(u,0x41304847)==0 then
call UnitAddAbility(u,ids)
endif
if GetLocalPlayer()==GetOwningPlayer(u)then
call SetTextTagVisibility(txt,true)
endif
else
call SaveInteger(HH,idu,StringHash("d"),0)
call UnitRemoveAbility(u,0x41304845)
call UnitRemoveAbility(u,0x41304846)
call UnitRemoveAbility(u,0x41304847)
call SetTextTagVisibility(txt,false)
call DestroyTextTag(txt)
endif
if hs<10 then
loop
exitwhen i>=10
if i<hs then
call SetTextTagText(txt,s,(10.5*0.08)/10)
set s=s+"|cFFFFFF00•|r"
else
set s=s+"•"
call SetTextTagText(txt,s,(10.5*0.08)/10)
endif
set i=i+1
endloop
else
set s="|cFFFFFF00••••••••••|r"
call SetTextTagText(txt,s,(10.5*0.08)/10)
endif
set s=null
set t=null
set u=null
endfunction
function CambioEffectStart takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local integer i=1
local integer idu=GetHandleId(u)
set txt=CreateTextTag()
set s="•"
loop
exitwhen i>=11
call SetTextTagText(txt,s,(10.5*0.08)/10)
set s=s+"•"
set i=i+1
endloop
call SetTextTagVisibility(txt,false)
if GetLocalPlayer()==p then
call SetTextTagVisibility(txt,true)
endif
call SetTextTagPosUnit(txt,u,(10.5*0.08)/10)
call SetTextTagColor(txt,255,255,255,255)
call SaveUnitHandle(HH,id,0,u)
call SaveTextTagHandle(HH,id,1,txt)
call SaveInteger(HH,GetHandleId(u),StringHash("d"),0)
call SaveReal(HH,GetHandleId(u),TIME_HASH,0)
call TimerStart(t,0.04,true,function CambioEffectAct)
set txt=null
set s=null
set t=null
set u=null
set p=null
endfunction
function InitCambioEffect takes nothing returns nothing
endfunction
