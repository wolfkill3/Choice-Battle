function AOCCond takes nothing returns boolean
return GetSpellAbilityId()=='A191' and udg_B==true
endfunction
function AOCCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local group g=LoadGroupHandle(h,id,1)
local integer i=1
local real r=0
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local real time=LoadReal(h,id,4)
local real dmg=GetUnitState(u,UNIT_STATE_MAX_MANA)*(0.02+0.005*GetUnitAbilityLevel(u,'A191'))/1.5
local player p=GetOwningPlayer(u)
call SaveReal(h,id,4,time+0.1)
if time>0.5 then
call SetUnitInvulnerable(u,true)
call GroupEnumUnitsInRange(G,x,y,900,Base)
set r=GetRandomReal(-1,1)
set n=CreateUnit(p,'e08J',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.5)
call SetUnitScale(n,1.5+r,1.5+r,1.5+r)
call SetUnitFlyHeight(n,GetRandomReal(0,350),0)
call SetUnitTimeScale(n,1.5)
call SetUnitVertexColor(n,0,0,0,125)
set r=GetRandomReal(0,2)
set n=CreateUnit(p,'e08J',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.5)
call SetUnitScale(n,1.5+r,1.5+r,1.5+r)
call SetUnitFlyHeight(n,GetRandomReal(0,350),0)
call SetUnitTimeScale(n,1.5)
call SetUnitVertexColor(n,0,0,0,125)
set r=GetRandomReal(-1.4,0.5)
set n=CreateUnit(p,'e08J',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.5)
call SetUnitScale(n,1.5+r,1.5+r,1.5+r)
call SetUnitFlyHeight(n,GetRandomReal(0,350),0)
call SetUnitTimeScale(n,1.5)
call SetUnitVertexColor(n,0,0,0,125)
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl",x+GetRandomReal(-450,450),y+GetRandomReal(-450,450)))
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl",x+GetRandomReal(-450,450),y+GetRandomReal(-450,450)))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\CarrionSwarm\\CarrionSwarmDamage.mdl",x+GetRandomReal(-450,450),y+GetRandomReal(-450,450)))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\CarrionSwarm\\CarrionSwarmDamage.mdl",x+GetRandomReal(-450,450),y+GetRandomReal(-450,450)))
set n=CreateUnit(p,'e0BX',x,y,GetRandomReal(0,359))
call SetUnitScale(n,3,3,3)
call SetUnitTimeScale(n,2)
call SetUnitFlyHeight(n,350,0)
call UnitApplyTimedLife(n,'BTLF',0.45)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl",E,"chest"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\CarrionSwarm\\CarrionSwarmDamage.mdl",E,"origin"))
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(G,E)
endloop
if time>2.5 then
call SetUnitFlyHeight(u,0,0)
call SetUnitTimeScale(u,1)
call DestroyGroup(g)
call RemoveUnit(LoadUnitHandle(h,id,2))
call DestroyTimer(t)
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
call FlushChildHashtable(h,id)
endif
endif
set g=null
set u=null
set t=null
set p=null
endfunction
function AOCCast takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=0
local real y1=0
local real a=0
local player p=GetOwningPlayer(u)
local group g=CreateGroup()
local integer i=1
local real f=(360/30)*bj_DEGTORAD
local integer l__s=SH_block
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveReal(h,id,4,0)
set n=CreateUnit(p,'e0BX',x,y,0)
call SetUnitTimeScale(n,0.2)
call SetUnitScale(n,4,4,4)
call SaveUnitHandle(h,id,2,n)
call SetUnitTimeScale(u,1)
call SetUnitInvulnerable(u,true)
call PauseUnit(u,true)
call SetUnitAnimation(u,"morph")
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,1,g)
call SetUnitFlyHeight(u,350,500)
call TimerStart(t,.1,true,function AOCCast2)
set p=null
set u=null
set t=null
endfunction
function InitTrig_AOC takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function AOCCond))
call TriggerAddAction(t,function AOCCast)
set t=null
endfunction
function TimeSealCond takes nothing returns boolean
return GetSpellAbilityId()=='A0TB'
endfunction
function TimeSealCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real time=LoadReal(h,id,2)
local real x=LoadReal(h,id,5)
local real y=LoadReal(h,id,6)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local boolean yuin=LoadBoolean(h,id,7)
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(p)
if time<4 then
if SR(y1,x1,y,x)<1200 then
call SaveBoolean(h,id,7,true)
set yuin=true
elseif SR(y1,x1,y,x)>=1200 and yuin==true then
call SetUnitInvulnerable(u,false)
call SaveBoolean(h,id,7,false)
set yuin=false
elseif SR(y1,x1,y,x)>=1200 and yuin==false then
call SaveBoolean(h,id,7,false)
set yuin=false
endif
call GroupEnumUnitsInRange(G,x,y,1200,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if E!=u then
call SetControlToUnit(E,E,0.5,"stun")
elseif IsUnitInvulnerable(E)==false and yuin==true then
call SetUnitInvulnerable(E,true)
endif
call GroupRemoveUnit(G,E)
endloop
call SaveReal(h,id,2,time+0.1)
else
call SetUnitInvulnerable(u,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set t=null
set u=null
endfunction
function TimeSealCast takes nothing returns nothing
local timer t=CreateTimer()
local unit u=GetTriggerUnit()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(p)
local real a=0
local integer i=0
local real x1
local real y1
local real f=(3.6)*bj_DEGTORAD
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,0)
set n=CreateUnit(p,'e06G',x,y,0)
call UnitApplyTimedLife(n,'BTLF',7)
call SetUnitTimeScale(n,0.1)
call UnitApplyTimedLife(CreateUnit(p,'e0R3',x,y,0),'BTLF',5)
call UnitApplyTimedLife(CreateUnit(p,'e0R3',x,y,0),'BTLF',5)
call UnitApplyTimedLife(CreateUnit(p,'e0R5',x,y,0),'BTLF',5)
loop
exitwhen i>=100
set x1=x+1100*Cos((i*f))
set y1=y+1100*Sin((i*f))
set a=Atan2(y-y1,x-x1)
call UnitApplyTimedLife(CreateUnit(p,'e0R4',x1,y1,0),'BTLF',5)
set i=i+1
endloop
set soundplay=SndN(2017) // Sound\Music\mp3Music\YujiUltimate.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call UnitAddAbility(u,0x41305854)
call SaveReal(h,id,5,x)
call SaveReal(h,id,6,y)
call SaveBoolean(h,id,7,true)
call TimerStart(t,0.1,true,function TimeSealCast2)
set t=null
set p=null
set u=null
endfunction
function EnergyShieldCond takes nothing returns boolean
return GetSpellAbilityId()=='A0T4'
endfunction
function EnergyShieldCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local integer idd=GetHandleId(l__d)
local integer i=LoadInteger(h,id,3)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real dmg=(LoadReal(h,idd,SH_ysp3)-LoadReal(h,idd,SH_ysp1))
if i<10 then
call SaveInteger(h,id,3,i+1)
else
if GetUnitAbilityLevel(l__d,'A0T5')>0 then
call GroupEnumUnitsInRange(G,x,y,500,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call PoisonDamage3(u,E,dmg,12,"war3mapImported\\amaterasu2.mdx","origin")
endif
call GroupRemoveUnit(G,E)
endloop
call DestroyEffect(AddSpecialEffect("war3mapImported\\NetherStrike.mdx",x,y))
call DestroyEffect(AddSpecialEffect("war3mapImported\\DarkNova.mdx",x,y))
call DestroyEffect(AddSpecialEffect("war3mapImported\\Death Release.mdx",x,y))
call UnitApplyTimedLife(CreateUnit(p,'e029',x,y,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e029',x,y,GetRandomReal(0,359)),'BTLF',2)
endif
call UnitRemoveAbility(l__d,'A0T5')
call PauseTimer(t)
call DestroyTimer(t)
call RemoveSavedHandle(h,idd,SH_ysp2)
call RemoveSavedReal(h,idd,SH_ysp1)
call RemoveSavedReal(h,idd,SH_ysp3)
call FlushChildHashtable(h,id)
endif
set u=null
set l__d=null
set t=null
endfunction
function EnergyShieldCast takes nothing returns nothing
local timer t=CreateTimer()
local unit u=GetTriggerUnit()
local unit l__d=GetSpellTargetUnit()
local integer id=GetHandleId(t)
local integer idd=GetHandleId(l__d)
call SaveUnitHandle(h,id,1,l__d)
call SaveUnitHandle(h,id,0,u)
call UnitAddAbility(l__d,'A0T5')
call SaveReal(h,idd,SH_ysp1,(GetUnitAbilityLevel(u,'A0T4')*200)+200+0.3*GetUnitState(l__d,UNIT_STATE_MAX_LIFE))
if IsUnitEnemy(l__d,GetOwningPlayer(u))then
call SaveReal(h,idd,SH_ysp3,1.35*((GetUnitAbilityLevel(u,'A0T4')*200)+200+0.3*GetUnitState(l__d,UNIT_STATE_MAX_LIFE)))
else
call SaveReal(h,idd,SH_ysp3,1*((GetUnitAbilityLevel(u,'A0T4')*200)+200+0.3*GetUnitState(l__d,UNIT_STATE_MAX_LIFE)))
endif
call SaveUnitHandle(h,idd,SH_ysp2,u)
set soundplay=SndN(2019) // Sound\Music\mp3Music\YujiShield.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,1,true,function EnergyShieldCast2)
set t=null
set u=null
set l__d=null
endfunction
