call DestroyEffect(EFF)
set EFF=AddSpecialEffect("feathercrow.mdl", x+GetRandomReal(100,200)*Cos(a+deg90),y+GetRandomReal(100,200)*Sin(a+deg90))
call SetSpecialEffectScale(EFF , 0.5)
call SetSpecialEffectZ(EFF , 100)
call DestroyEffect(EFF)
set EFF=AddSpecialEffect("feathercrow.mdl", x+GetRandomReal(200,300)*Cos(a-deg90),y+GetRandomReal(200,300)*Sin(a-deg90))
call SetSpecialEffectScale(EFF , 0.5)
call SetSpecialEffectZ(EFF , 50)
call DestroyEffect(EFF)
set EFF=AddSpecialEffect("feathercrow.mdl", x+GetRandomReal(100,200)*Cos(a-deg90),y+GetRandomReal(100,200)*Sin(a-deg90))
call SetSpecialEffectScale(EFF , 0.5)
call SetSpecialEffectZ(EFF , 100)
call DestroyEffect(EFF)
