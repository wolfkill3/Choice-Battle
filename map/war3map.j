function Parasite2Cond takes nothing returns boolean
return GetSpellAbilityId()=='A1AL'
endfunction
function Parasite2Cast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,4)
local unit c=LoadUnitHandle(h,GetHandleId(u),SH_par)
local real dmg=GetHeroInt(u,true)*(0.5*GetUnitAbilityLevel(u,'A1AL')+2)
local real x=GetUnitX(c)
local real y=GetUnitY(c)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real x2=GetUnitX(l__d)
local real y2=GetUnitY(l__d)
local real a=LoadReal(h,id,1)
local real dist=LoadReal(h,id,2)
local real rd=LoadReal(h,id,3)
local integer cond=LoadInteger(h,id,5)
local group g=LoadGroupHandle(h,id,9)
local integer l__idg=GetHandleId(g)
local player p=GetOwningPlayer(u)
if GetHeroInt(u,true)*4+550>dist and rd>dist then
call SaveReal(h,id,2,dist+75)
if IsTerrainPathable(x+75*Cos(a),y+75*Sin(a),PATHING_TYPE_FLYABILITY)==false then
set x=x+75*Cos(a)
set y=y+75*Sin(a)
else
set x=x-15*Cos(a)
set y=y-15*Sin(a)
endif
call SetUnitXY_1(c,x,y, false)
call SetUnitFlyHeight(l__d,GetUnitFlyHeight(c)+75,0)
if cond==1 then
call SetUnitXY_1(l__d,x,y, false)
call SaveInteger(h,id,5,2)
elseif cond==2 then
call SetUnitXY_1(l__d,x1,y1, false)
call SaveInteger(h,id,5,1)
endif
if c==u then
set n=CreateUnit(p,'e0ZH',x,y,45+a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,-45+a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
else
set n=CreateUnit(p,'e0ZH',x,y,180+a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
endif
call GroupEnumUnitsInRange(G,x,y,150,Base)
call GroupRemoveUnit(G,c)
loop
set E=FirstOfGroup(G)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,ide)then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",E,"chest"))
if c==u then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
else
call myCustomDamage(u,E,dmg*1.25,false,false,null,null,null)
call SetControlToUnit(E,E, 2, "stun")
endif
call SaveUnitHandle(h,l__idg,ide,E)
endif
call GroupRemoveUnit(G,E)
endloop
else
call SetUnitTimeScale(u,1)
call PauseTimer(t)
if IsUnitEnemy(c,p)then
call myCustomDamage(u,c,dmg*0.75,false,false,null,null,null)
endif
if c==u then
endif
call DestroyGroup(g)
call UnitRemoveAbility(c,'A1AH')
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call KillUnit(l__d)
call RemoveSavedHandle(h,GetHandleId(u),SH_par)
endif
set l__d=null
set g=null
set u=null
set p=null
set t=null
    set c=null
endfunction
function Parasite2Cast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=LoadUnitHandle(h,GetHandleId(u),SH_par)
local real x=GetUnitX(c)
local real y=GetUnitY(c)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,a)
call SaveReal(h,id,2,0)
call SaveInteger(h,id,5,1)
call SaveGroupHandle(h,id,9,CreateGroup())
call SaveReal(h,id,3,SR(x,y,x1,y1))
call SaveUnitHandle(h,id,4,CreateUnit(p,'e10D',x,y,a*bj_RADTODEG))
if IsUnitEnemy(c,GetOwningPlayer(u))then
call IssueImmediateOrder(c,"stop")
endif
if c==u then
    call IssueImmediateOrder(u,"stop")
call SetUnitAnimation(u,"spell five")
set n=CreateUnit(p,'e10N',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.5)
call SetUnitTimeScale(n,2)
endif
call SetUnitTimeScale(u,3)
call UnitAddAbility(c,'A1AH')
call SaveUnitHandle(h,GetHandleId(u),SH_par,c)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1AK',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1AL',false)
set soundplay=SndN(2560) // Sound\Music\mp3Music\Doflamingo22.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.015,true,function Parasite2Cast2)
set u=null
set p=null
set c=null
set t=null
endfunction
