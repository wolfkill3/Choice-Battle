function LaxusNewSpellsInit takes nothing returns nothing
        local trigger t=CreateTrigger()
        local integer i=0
        loop
                call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
                set i=i+1
                exitwhen i>=bj_MAX_PLAYER_SLOTS
        endloop
        call TriggerAddAction(t,function LaxusNewSpellsCast)
        set t=null
endfunction
function Trig_Imperor_Conditions takes nothing returns boolean
local integer i=GetSpellAbilityId()
return GetUnitAbilityLevel(GetTriggerUnit(),0x41313650)>0 and GetHeroLevel(GetTriggerUnit())>11 and(i=='A0SY' or i==0x41305358 or i==0x41305357 or i=='A0SS' or i=='A0SP')
endfunction
function Trig_Imperor_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local integer i=GetRandomInt(1,4)
local integer is=GetRandomInt(1,1+R2I(GetHeroLevel(u)/7))
local integer l__s=0
if GetSpellAbilityId()=='A0SP' then
set is=GetRandomInt(1,1+R2I(GetHeroLevel(u)/35))
endif
loop
exitwhen l__s==is
if i==1 then
set x=x+GetRandomReal(-300,300)
set y=y+GetRandomReal(-300,300)
set n=CreateUnit(p,'h05T',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,10)
call SetUnitBaseDamageByIndex(n,0,50+R2I(GetHeroStr(u,true)*0.3))
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
elseif i==2 then
set x=x+GetRandomReal(-300,300)
set y=y+GetRandomReal(-300,300)
set n=CreateUnit(p,'h05U',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,10)
call SetUnitBaseDamageByIndex(n,0,50+R2I(GetHeroStr(u,true)*0.3))
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
elseif i==3 then
set x=x+GetRandomReal(-300,300)
set y=y+GetRandomReal(-300,300)
set n=CreateUnit(p,'h05V',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,10)
call SetUnitBaseDamageByIndex(n,0,50+R2I(GetHeroStr(u,true)*0.3))
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
elseif i==4 then
set x=x+GetRandomReal(-300,300)
set y=y+GetRandomReal(-300,300)
set n=CreateUnit(p,'h05W',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,10)
call SetUnitBaseDamageByIndex(n,0,50+R2I(GetHeroStr(u,true)*0.3))
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
endif
set i=GetRandomInt(1,4)
set l__s=l__s+1
endloop
set p=null
set u=null
endfunction
function InitTrig_Imperor takes nothing returns nothing
set gg_trg_Imperor=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Imperor,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_Imperor,Condition(function Trig_Imperor_Conditions))
call TriggerAddAction(gg_trg_Imperor,function Trig_Imperor_Actions)
endfunction
