function MaxCombCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=LoadReal(h,id,5)
local real dmg=(3+GetUnitAbilityLevel(u,'A02X'))*GetHeroStr(u,true)
local player p=GetOwningPlayer(u)
local real time=LoadReal(h,id,7)
local real mt=LoadReal(h,id,8)
local real dist=GetRandomReal(-100,100)
local real a2=a+90*bj_DEGTORAD
if mt>0 and UnitIsAlive(u)then
set x1=x1-40*Cos(a)
set y1=y1-40*Sin(a)
call SetUnitXY_1(u,x1,y1, false)
if time<0 then
set x1=x1+53*Cos(a)
set y1=y1+53*Sin(a)
call SetUnitXY_1(c,x1,y1, false)
call UnitApplyTimedLife(CreateUnit(p,'e0B1',x1,y1,GetRandomReal(0,359)),1,0.4)
call UnitApplyTimedLife(CreateUnit(p,'e0B4',x1,y1,GetRandomReal(0,359)),1,0.4)
set n=CreateUnit(p,'e01P',x1+dist*Cos(a2),y1+dist*Sin(a2),a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,0.4)
call SetUnitTimeScale(n,4)
call SetUnitAnimation(n,"attack")
call SetUnitVertexColor(n,255,255,255,100)
set n=CreateUnit(p,'e0B2',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitVertexColor(n,255,220,40,50)
call SaveReal(h,id,7,mt)
call SaveReal(h,id,8,mt-0.2)
endif
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitAnimation(u,"attack")
call SaveReal(h,id,7,LoadReal(h,id,7)-3)
else
call UnitApplyTimedLife(CreateUnit(p,'e0AX',x1,y1,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e0AW',x1,y1,GetRandomReal(0,359)),1,0.01)
call UnitApplyTimedLife(CreateUnit(p,'e0B1',x1,y1,GetRandomReal(0,359)),1,0.4)
call UnitApplyTimedLife(CreateUnit(p,'e0B4',x1,y1,GetRandomReal(0,359)),1,0.4)
call UnitApplyTimedLife(CreateUnit(p,'e0AZ',x1,y1,GetRandomReal(0,359)),1,0.4)
call UnitApplyTimedLife(CreateUnit(p,'e0B3',x1,y1,GetRandomReal(0,359)),1,0.4)
call SetUnitInvulnerable(u,false)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call PauseUnit(u,false)
call Push3(c,35,a,200,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
call myCustomDamage(u,c,dmg,false,false,null,null,null)
call SetControlToUnit(u,c,2, "stun")
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitVertexColor(u,255,255,255,255)
call FlushChildHashtable(h,id)
call SetUnitTimeScale(u,1)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function MaxCombCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call PauseUnit(u,true)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveReal(h,id,7,6)
call SaveReal(h,id,8,6)
call SaveReal(h,id,5,Atan2(y1-y,x1-x))
call SetUnitXY_1(u,x1,y1, false)
call SetUnitInvulnerable(u,true)
call SetUnitVertexColor(u,255,255,255,125)
call SetUnitTimeScale(u,3)
call SetUnitAnimation(u,"attack")
set soundplay=CreateSound("Sound\\Music\\mp3Music\\MaximumCombination.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call UnitApplyTimedLife(CreateUnit(p,'e0AX',x,y,GetRandomReal(0,359)),1,1)
call TimerStart(t,0.04,true,function MaxCombCast2)
else
call SetUnitXY_1(u,x1,y1, false)
call SetUnitAnimation(u,"attack")
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitVertexColor(u,255,255,255,255)
call FlushChildHashtable(h,id)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
call SetUnitTimeScale(u,1)
endif
set t=null
set u=null
set p=null
set c=null
