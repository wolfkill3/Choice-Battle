endfunction
function EchoRitmCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,100)
local group g=LoadGroupHandle(h,id,60)
local group gn=LoadGroupHandle(h,id,61)
local integer i=0
local real x=LoadReal(h,id,50)
local real y=LoadReal(h,id,51)
local real x1=0
local real y1=0
local real x2
local real y2
local real x3=GetUnitX(c)
local real y3=GetUnitY(c)
local real dist=LoadReal(h,id,101)
local real f=0
local real dmg=GetHeroAgi(u,true)*(GetUnitAbilityLevel(u,0x41305552)+2)
local integer l__idg=GetHandleId(g)
local player p=GetOwningPlayer(u)
local real speed=LoadReal(h,id,102)
loop
set i=i+1
exitwhen i>6
set n=LoadUnitHandle(h,id,1+i)
set f=Atan2(y-GetUnitY(n),x-GetUnitX(n))*bj_RADTODEG-90
set x1=GetUnitX(n)+speed*Cos(f*bj_DEGTORAD)
set y1=GetUnitY(n)+speed*Sin(f*bj_DEGTORAD)
call SetUnitFacing(n,f)
call SetUnitX(n,x1)
call SetUnitY(n,y1)
set n=CreateUnit(p,0x65305255,x1,y1,f)
call UnitApplyTimedLife(n,1,0.15)
call SetUnitTimeScale(n,2)
call SetUnitVertexColor(n,255,255,255,50)
call SetUnitAnimation(n,"walk")
endloop
set n=CreateUnit(p,0x65305257,x,y,f*bj_RADTODEG)
call UnitApplyTimedLife(n,1,0.3)
call SetUnitTimeScale(n,2)
call IssueImmediateOrder(c,"stop")
call SaveReal(h,id,101,dist+0.03)
call SaveReal(h,id,102,speed+0.66)
if dist>=2 then
call PauseTimer(t)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
set i=0
loop
set E=FirstOfGroup(gn)
exitwhen E==null
call Slash_EchoRitm(E,75,0,Atan2(y-GetUnitY(E),x-GetUnitX(E)),500,40,0,0,0,0)
call GroupRemoveUnit(gn,E)
endloop
call ShowUnit(u,true)
if GetLocalPlayer()==p then
call SelectUnit(u,true)
endif
call SetUnitX(u,x3)
call SetUnitY(u,y3)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x3,y3,GetRandomReal(0,359)),1,2)
call UnitApplyTimedLife(CreateUnit(p,'e04D',x3,y3,GetRandomReal(0,359)),1,2)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x3,y3,GetRandomReal(0,359)),1,2)
call UnitApplyTimedLife(CreateUnit(p,'e04D',x3,y3,GetRandomReal(0,359)),1,2)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x3,y3,GetRandomReal(0,359)),1,2)
call UnitApplyTimedLife(CreateUnit(p,'e04D',x3,y3,GetRandomReal(0,359)),1,2)
call UnitApplyTimedLife(CreateUnit(p,'e0HM',x3,y3,GetRandomReal(0,359)),1,1.4)
call myCustomDamage(u,c,dmg,false,false,null,null,null)
call DestroyGroup(g)
call DestroyGroup(gn)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
set gn=null
set u=null
set g=null
set t=null
set c=null
set p=null
endfunction
