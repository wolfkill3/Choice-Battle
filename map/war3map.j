call EffectCreateAndMove(true,"Others\\HakkeStart2.mdl",facing,1.5,0.5,0.5,100,100,100,60,0,caster,0,facing)
endif
if time>5 and time<5.2 then
call MoveUnit(caster,caster,60,LoadReal(HH,id,3))
endif
if time==5.2 then
set facing=facing
call SaveReal(HH,id,3,facing)
call UnitSpeed(caster,1)
call SetUnitAnimationByIndex(caster,5)
call SetUnitFacingInstant(caster,facing)
endif
if time==5.08 or time==5.16 or time==5.3 or time==5.36 then
call EffectCreateAndMove(true,"Aizen\\File0000 (644).mdl",facing,1,1,0.85,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove90(true,"BlackGoku\\wind3.mdl",facing+180,1,0.75,1.5,100,100,100,0,100,caster,0,facing)
endif
