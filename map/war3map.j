// ---- инвентарь: как игровая панель предметов — один сверху, ниже сетка 3x3 ----
set ShInvName=Sh_Cap(ShInv,Lng("|c00FFFF00Инвентарь|r","|c00FFFF00Inventory|r"))
call BlzFrameClearAllPoints(ShInvName)
