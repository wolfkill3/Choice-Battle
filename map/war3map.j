function CastIFW2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real a=LoadReal(h,id,4)
local real dist=LoadReal(h,id,5)
local real x=GetUnitX(l__d)+60*Cos(a)
local real y=GetUnitY(l__d)+60*Sin(a)
local real dmg=(GetHeroInt(u,true))*(I2R(LoadInteger(h,id,5))+1)+50*I2R(LoadInteger(h,id,5))
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,3)
if dist<1500 and IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
call SetUnitXY_1(l__d,x,y, false)
if ModuloReal(dist,120)<60 then
set n=CreateUnit(p,'e059',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,1)
call SetUnitTimeScale(n,0.1)
call UnitApplyTimedLife(CreateUnit(p,'e057',x,y,GetRandomReal(0,360)),1,2)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl",x,y))
endif
call GroupEnumUnitsInRange(g,x,y,175,Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
set n=CreateUnit(p,'h019',x,y,GetRandomReal(0,359))
call UnitAddAbility(n,0x41304135)
call UnitApplyTimedLife(n,1,2)
call IssueTargetOrder(n,"soulburn",E)
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
call SaveReal(h,id,5,dist+60)
else
call UnitApplyTimedLife(CreateUnit(p,0x65303346,x,y,GetRandomReal(0,359)),'BHwe',1)
call RemoveUnit(l__d)
call FlushChildHashtable(h,GetHandleId(g))
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
