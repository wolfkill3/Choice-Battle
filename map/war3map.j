function Trig_Final_Shot_Actions2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit d1=LoadUnitHandle(h,id,1)
    local unit d2=LoadUnitHandle(h,id,7)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=LoadReal(h,id,5)
    local real y1=LoadReal(h,id,6)
    local real i=LoadReal(h,id,7)
    local real f=LoadReal(h,id,8)*bj_RADTODEG
    local real r=0
    local group gn=LoadGroupHandle(h,id,25)
    local group g=LoadGroupHandle(h,id,26)
    local group gn2=LoadGroupHandle(h,id,27)
    local player p=GetOwningPlayer(u)
    local real dmg=GetHeroInt(u,true)*1.0
    local real mm=GetUnitState(u,UNIT_STATE_MAX_MANA)*0.0125
    if OrderId2String(GetUnitCurrentOrder(u))=="channel"and GetUnitState(u,UNIT_STATE_MANA)>20 then
        call SetUnitXY_1(u,x1,y1, false)
        call SetUnitFacingInstant(u,f)
        call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-mm)
        loop
            exitwhen r==13
            call UnitApplyTimedLife(CreateUnit(p,0x65303130,x+r*150*Cos(f*bj_DEGTORAD),y+r*150*Sin(f*bj_DEGTORAD),f),0x42544C46,0.25)
            call UnitApplyTimedLife(CreateUnit(p,0x6530524C,x+r*150*Cos(f*bj_DEGTORAD),y+r*150*Sin(f*bj_DEGTORAD),GetRandomReal(0,359)),0x42544C46,0.4)
            call GroupEnumUnitsInRange(gn,x+r*150*Cos(f*bj_DEGTORAD),y+r*150*Sin(f*bj_DEGTORAD),230,Base)
            loop
                set E=FirstOfGroup(gn)
                exitwhen E==null
                if Condition_Base(p,E)then
                    call GroupAddUnit(g,E)
                endif
                call GroupRemoveUnit(gn,E)
            endloop
            set r=r+1
        endloop
    loop
        set E=FirstOfGroup(g)
        exitwhen E==null
        if Condition_Base(p,E)then
        call myCustomDamage(u,E,dmg,false,false,null,null,null)
        call SetControlToUnit(E,E,0.6,"stun")
        if IsUnitInGroup(E,gn2)==false then
        call GroupAddUnit(gn2,E)
        endif
        endif
        call GroupRemoveUnit(g,E)
    endloop
    else
    loop
    set E=FirstOfGroup(gn2)
    exitwhen E==null
    call GroupRemoveUnit(gn2,E)
    endloop
    call DestroyTimer(t)
    call RemoveUnit(d1)
    call RemoveUnit(d2)
    call DestroyGroup(gn)
    call DestroyGroup(g)
    call DestroyGroup(gn2)
    call FlushChildHashtable(h,id)
    call SetUnitInvulnerable(u,false)
    endif
    set d1=null
    set d2=null
    set p=null
    set u=null
    set t=null
    set gn=null
    set g=null
    set gn2=null
endfunction
function Trig_Final_Shot_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real f=Atan2(y1-y,x1-x)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit l__d=CreateUnit(GetOwningPlayer(u),0x65303059,x+50*Cos(f*bj_DEGTORAD),y+50*Sin(f*bj_DEGTORAD),f*bj_RADTODEG)
call UnitAddAbility(l__d,'Arav')
call SetUnitInvulnerable(u,true)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,7,CreateUnit(GetOwningPlayer(u),0x6530305A,x+50*Cos(f+180*bj_DEGTORAD),y+50*Sin(f+180*bj_DEGTORAD),f*bj_RADTODEG+180))
call SaveUnitHandle(h,id,1,l__d)
call SaveReal(h,id,2,GetSpellTargetX())
call SaveReal(h,id,3,GetSpellTargetY())
call SaveReal(h,id,5,x)
call SaveReal(h,id,6,y)
call SaveReal(h,id,8,f)
call SaveBoolean(h,id,4,true)
call SaveGroupHandle(h,id,25,CreateGroup())
call SaveGroupHandle(h,id,26,CreateGroup())
call SaveGroupHandle(h,id,27,CreateGroup())
set soundplay=CreateSound("Sound\\Music\\mp3Music\\BlackBurning.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,.25,true,function Trig_Final_Shot_Actions2)
set u=null
set l__d=null
set t=null
endfunction
