function Trig_AH_Actions takes nothing returns nothing
if AH==false then
    set AH=true
    call DisplayTextToPlayer(GetLocalPlayer(),0,0,"Antihack On")
    call AntiHackEnable(true)
else
    set AH=false
    call DisplayTextToPlayer(GetLocalPlayer(),0,0,"Antihack Off")
    call AntiHackEnable(false)
endif
endfunction
