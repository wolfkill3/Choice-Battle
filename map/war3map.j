call SetUnitTimeScale(n,0.4)
call SetUnitVertexColor(n,255,230,100,50)
endif
call SetUnitX(l__d,x+65*Cos(a-deg90))
call SetUnitY(l__d,y+65*Sin(a-deg90))
call SaveReal(h,id,17,time-0.1)
else
if GetUnitTypeId(u)!='H04B' then
