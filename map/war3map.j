function TGilCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real rx=0
local real ry=0
local real x1=0
local real y1=0
local real time=LoadReal(h,id,3)
local real a=GetUnitFacing(u)*bj_DEGTORAD-deg90
local player p=GetOwningPlayer(u)
local real st=LoadReal(h,id,4)
local real sc=0
local real he=GetUnitFlyHeight(u)
local trigger tt=LoadTriggerHandle(h, id, SH_OrderTrigger)
call SetControlToUnit(u,u,0.1,"doomdebug")
if time>0 then
if time<3 then
    if he<750 then
        call SetUnitFlyHeight(u,he+20,0)
    else
        call SetUnitTimeScale(u,0)
        if LoadInteger(h,id,5)!=1 then
            set x1=x-25*Cos(a+deg90)
            set y1=y-25*Sin(a+deg90)
            set x1=x1+50*Cos(a)
            set y1=y1+50*Sin(a)
            set n=CreateUnit(p,'e14G',x1,y1,GetRandomReal(0,359))
            call SetUnitTimeScale(n,0.25)
            call SetUnitFlyHeight(n,he+300,0)
            call UnitApplyTimedLife(n,'BTLF',1.6)
            set n=CreateUnit(p,'e14H',x1,y1,GetRandomReal(0,359))
            call SetUnitTimeScale(n,0.3)
            call SetUnitFlyHeight(n,he+250,0)
            call UnitApplyTimedLife(n,'BTLF',1.6)
            set n=CreateUnit(p,'e14J',x,y,GetRandomReal(0,359))
            call SetUnitTimeScale(n,1)
            call SetUnitFlyHeight(n,he,0)
            call SetUnitScale(n,3.5,3.5,3.5)
            call SetUnitVertexColor(n,255,255,255,125)
            call UnitApplyTimedLife(n,'BTLF',4.1)
            set n=CreateUnit(p,'e14G',x1,y1,GetRandomReal(0,359))
            call SetUnitTimeScale(n,0.25)
            call SetUnitFlyHeight(n,he+300,0)
            call UnitApplyTimedLife(n,'BTLF',1.6)
            set n=CreateUnit(p,'e14I',x1,y1,GetRandomReal(0,359))
            call SetUnitTimeScale(n,1)
            call SetUnitFlyHeight(n,he+300,0)
            call SetUnitScale(n,0.7,0.7,0.7)
            call UnitApplyTimedLife(n,'BTLF',1.6)
            call SaveInteger(h,id,5,1)
            call UnitRemoveAbility(u,'A1FU')
            call UnitRemoveAbility(u,'Pet1')
            call TriggerClearActions(tt)
            call DestroyTrigger(tt)
            call UnitRemoveAbility(u,'B00A')
            call UnitRemoveAbility(u,'B02Z')
            call SetUnitAcquireRange(u,1500)
            call PauseUnit(u,true)
            call SetUnitInvulnerable(u,true)
        endif
    endif
endif
if time<3.5 and LoadInteger(h,id,9)==0 then
call SetUnitInvulnerable(u,true)
set n=CreateUnit(p,'e14U',x+80*Cos(a+deg90),y+80*Sin(a+deg90),a*bj_RADTODEG)
call SetUnitTimeScale(n,1)
call SetUnitFlyHeight(n,he+125,0)
call UnitApplyTimedLife(n,'BTLF',1.2)
call SetUnitScale(n,1.3,1.3,1.3)
call SetUnitVertexColor(n,255,255,255,180)
call SaveInteger(h,id,9,1)
endif
call SaveReal(h,id,3,time-0.03)
call SaveReal(h,id,4,st+0.03)
if st>0.35 then
set sc=GetRandomReal(0.5,1.1)
set rx=GetRandomReal(-600,600)
set ry=GetRandomReal(-600,600)
set n=CreateUnit(p,'e0OZ',x+rx,y+ry,GetRandomReal(0,359))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl",x+rx,y+ry))
call SetUnitTimeScale(n,0.4)
call SetUnitScale(n,sc,sc,sc)
call SetUnitFlyHeight(n,0,0)
call SetUnitFlyHeight(n,5000,GetRandomReal(200,2000))
call UnitApplyTimedLife(n,'BTLF',1.6)
set sc=GetRandomReal(0.5,1.1)
set rx=GetRandomReal(-600,600)
set ry=GetRandomReal(-600,600)
set n=CreateUnit(p,'e0OZ',x+rx,y+ry,GetRandomReal(0,359))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl",x+rx,y+ry))
call SetUnitTimeScale(n,0.4)
call SetUnitScale(n,sc,sc,sc)
call SetUnitFlyHeight(n,0,0)
call SetUnitFlyHeight(n,5000,GetRandomReal(200,2000))
call UnitApplyTimedLife(n,'BTLF',1.6)
set sc=GetRandomReal(0.5,1.1)
set rx=GetRandomReal(-600,600)
set ry=GetRandomReal(-600,600)
set n=CreateUnit(p,'e0OZ',x+rx,y+ry,GetRandomReal(0,359))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl",x+rx,y+ry))
call SetUnitTimeScale(n,0.4)
call SetUnitScale(n,sc,sc,sc)
call SetUnitFlyHeight(n,0,0)
call SetUnitFlyHeight(n,5000,GetRandomReal(200,2000))
call UnitApplyTimedLife(n,'BTLF',1.6)
call SaveReal(h,id,4,0)
endif
else
call PauseTimer(t)
call SetUnitTimeScale(u,1)
call TimerStart(t,0.5,false,function TGilCast4)
endif
set p=null
set t=null
set tt=null
set u=null
endfunction
