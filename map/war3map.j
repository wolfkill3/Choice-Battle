call UnitApplyTimedLife(CreateUnit(p,'e029',x,y,GetRandomReal(0,359)),1,2)
call GroupEnumUnitsInRange(g,x,y,400,Base)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Moria3.mp3",false,false,true,12700,12700,"")
