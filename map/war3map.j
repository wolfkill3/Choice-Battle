elseif GetUnitAbilityLevel(u,'A08E')>0 then
call UnitRemoveAbility(u,'A08E')
elseif GetUnitAbilityLevel(u,'A08H')>0 then
call UnitRemoveAbility(u,'A08H')
elseif GetUnitAbilityLevel(u,'A08G')>0 then
call UnitRemoveAbility(u,'A08G')
endif
call UnitAddAbility(u,gdy[ra])
call SetUnitAbilityLevel(u,gdy[ra],lvl)
set abya[id]=gdy[ra]
if ra==1 then
set soundplay=SndN(938) // Sound\Music\mp3Music\ShigureSouenRyu1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
elseif ra==2 then
set soundplay=SndN(940) // Sound\Music\mp3Music\ShigureSouenRyu2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
elseif ra==3 then
set soundplay=SndN(942) // Sound\Music\mp3Music\ShigureSouenRyu3.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
elseif ra==4 then
set soundplay=SndN(944) // Sound\Music\mp3Music\ShigureSouenRyu4.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
set u=null
endfunction
