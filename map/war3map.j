function HellSpiritCond takes nothing returns boolean
return GetSpellAbilityId()=='A0XK' and udg_B==true and GetUnitTypeId(GetTriggerUnit())=='H01G'
endfunction
function HellSpiritMissleFly2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local unit d1=LoadUnitHandle(h,id,9)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=angle
local real dist=LoadReal(h,id,6)
local real mh=LoadReal(h,id,5)
local real rad=LoadReal(h,id,7)
local real rd=SR(x,y,x1,y1)
local player p=GetOwningPlayer(d1)
local integer idu=GetPlayerId(p)
local real dmg=12*GetHeroStr(Hero[idu],true)
local real cof=rd/dist
local real a2=(a-3.14)
local real time=LoadReal(h,id,11)
if rd>speed+30 and udg_B==true and UnitIsAlive(l__d)and time<dist then
set n=CreateUnit(p,'e0U8',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitFlyHeight(n,mh*cof,0)
set x=x+speed*Cos(a)
set y=y+speed*Sin(a)
call SaveReal(h,id,11,time+speed)
call SetUnitXY_1(l__d,x,y, false)
call SaveReal(h,id,1,speed*1.02)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,mh*cof,0)
call SetUnitX(d1,x)
call SetUnitY(d1,y)
call SetUnitFacing(d1,a*bj_RADTODEG)
call SetUnitFlyHeight(d1,mh*cof,0)
else
call UnitApplyTimedLife(CreateUnit(p,'e06C',x,y,a2*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e06D',x,y,a2*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e06B',x,y,a2*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e06J',x,y,a2*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e06I',x,y,a2*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e067',x,y,a2*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e06H',x,y,a2*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e06I',x,y,a2*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e06H',x,y,a2*bj_RADTODEG),'BTLF',1)
call PauseUnit(l__d,false)
call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,false)
call myCustomDamage(Hero[idu],l__d,dmg,false,false,null,null,null)
call SetControlToUnit(Hero[idu],l__d,2,"stun")
call SetUnitX(Hero[idu],x+100*Cos(a))
call SetUnitY(Hero[idu],y+100*Sin(a))
call SetUnitFacing(Hero[idu],a2*bj_RADTODEG)
call SetUnitAnimation(Hero[idu],"attack")
call Push(l__d,60,a2,1000)
call ShakeCamera(0.5,20)
call SetUnitFlyHeight(l__d,0,0)
call RemoveUnit(d1)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set d1=null
set p=null
set l__d=null
set t=null
endfunction
function HellSpiritMissleFly takes unit l__d,unit d1,real speed,real angle,real x,real y,real mh,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveUnitHandle(h,id,9,d1)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,mh)
call SaveReal(h,id,6,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,8,dmg)
call SaveReal(h,id,11,0)
call TimerStart(t,0.03,true,function HellSpiritMissleFly2)
set t=null
endfunction
function HellSpiritCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=LoadReal(h,id,15)
local player p=GetOwningPlayer(u)
local real fh=GetUnitFlyHeight(c)+40
local real sc=GetRandomReal(1,4)
local real time=LoadReal(h,id,5)
call SaveReal(h,id,5,time+0.15)
if fh<700 and UnitIsAlive(c) and time<3 then
call SetUnitXY_1(c,x+75*Cos(a),y+75*Sin(a), false)
call SetUnitFlyHeight(c,fh,0)
call SetUnitFlyHeight(u,fh,0)
set n=CreateUnit(p,'e0YK',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,125)
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitFlyHeight(n,fh,0)
set n=CreateUnit(p,'e0YK',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,125)
call SetUnitScale(n,sc,sc,sc)
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitAnimation(u,"attack")
else
call UnitRemoveAbility(u,'A0O1')
call UnitMakeAbilityPermanent(u,false,'A0O1')
set n=CreateUnit(p,'e0MY',x,y,GetRandomReal(0,359))
call HellSpiritMissleFly(c,n,25,a,x1+1000*Cos(a),y1+1000*Sin(a),700,0)
set n=CreateUnit(p,'e0ME',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitFlyHeight(n,GetUnitFlyHeight(c),0)
call SetUnitAnimation(u,"spell slam")
call SetUnitFlyHeight(u,0,700)
call SetUnitInvulnerable(u,false)
call SetUnitInvulnerable(c,false)
call UnitRemoveAbility(c,'A0QL')
call PauseUnit(u,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function HellSpiritCast takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real f=GetUnitFacing(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call PauseUnit(u,true)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call SetUnitInvulnerable(u,true)
call SetUnitInvulnerable(c,true)
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveReal(h,id,7,0)
call SaveReal(h,id,15,a)
call SetUnitX(u,x1-75*Cos(a))
call SetUnitY(u,y1-75*Sin(a))
set n=CreateUnit(p,'e0U9',x1+300*Cos(a),y1+300*Sin(a),a-bj_PI/2)
call SetUnitTimeScale(n,0.3)
call SetUnitAnimation(n,"Birth")
call UnitApplyTimedLife(n,'BTLF',3)
set n=CreateUnit(p,'e0U9',x1-100*Cos(a),y1-100*Sin(a),a-bj_PI/2)
call SetUnitTimeScale(n,0.4)
call SetUnitAnimation(n,"Birth")
call UnitApplyTimedLife(n,'BTLF',3)
set n=CreateUnit(p,'e0U9',x1-500*Cos(a),y1-500*Sin(a),a-bj_PI/2)
call SetUnitTimeScale(n,0.5)
call SetUnitAnimation(n,"Birth")
call UnitApplyTimedLife(n,'BTLF',3)
set n=CreateUnit(p,'e0UA',x1-400*Cos(a-bj_PI/2),y1-400*Sin(a-bj_PI/2),(a-bj_PI/2)*bj_RADTODEG)
call SetUnitTimeScale(n,0.5)
call SetUnitAnimation(n,"Birth")
call UnitApplyTimedLife(n,'BTLF',3)
call UnitAddAbility(c,'A0QL')
call UnitAddAbility(c,'Arav')
call UnitRemoveAbility(c,'Arav')
call UnitAddAbility(u,'Arav')
call UnitRemoveAbility(u,'Arav')
call UnitAddAbility(u,'A0O8')
set soundplay=SndN(1065) // Sound\Music\mp3Music\BlackStarUltimate.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.15,true,function HellSpiritCast3)
else
call SetUnitX(u,x1-75*Cos(a))
call SetUnitY(u,y1-75*Sin(a))
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
call SetUnitInvulnerable(c,false)
call PauseTimer(t)
call DestroyTimer(t)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set t=null
set p=null
set c=null
set n=null
endfunction
