function IMRCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(p)
local integer i=0
call MissUnit(u,GetSpellTargetUnit(),7,0.3,false)
call SlowUnit(u,GetSpellTargetUnit(),0.5,0.5,7,2,false)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,GetHandleId(Hero[ip]),SH_IMR,GetSpellTargetUnit())
set n=CreateUnit(p,'h019',x,y,GetRandomReal(0,359))
call UnitAddAbility(n,'A09U')
call UnitApplyTimedLife(n,'BTLF',2)
call IssueTargetOrder(n,"invisibility",u)
loop
// set n=CreateUnit(p,'h019',x,y,GetRandomReal(0,359))
// call UnitAddAbility(n,'A09T')
// call UnitApplyTimedLife(n,'BTLF',2)
// call IssueTargetOrderById(n,852274,u)
set n=CreateIllusionFromUnit(u)
call SetUnitFacingInstant(n,GetUnitFacing(u))
call UnitCancelTimedLife(n)
call UnitApplyTimedLife(n,'B01N',7.5)
call SetIllusionDamageDealt(n,0.15)
call SetIllusionDamageReceived(n,1)
call SetUnitCurrentSight(n,600)
call SetUnitUseFood(n,true)
set i=i+1
exitwhen i>=3*GetUnitAbilityLevel(u,'A09S')
endloop
call UnitRemoveAbility(u, 'B01M')
set soundplay=SndN(999) // Sound\Music\mp3Music\ViperQ.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,1,false,function IMRCast2)
if u==GetSpellTargetUnit() then
        set t=CreateTimer()
        call SaveUnitHandle(h,GetHandleId(t),0,u)
        call TimerStart(t,0.05,false,function IMRCast2_Self)
endif
set u=null
set p=null
set t=null
endfunction
