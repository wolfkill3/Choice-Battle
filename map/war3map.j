function TimeLapseStart takes nothing returns nothing
local integer time
local integer ti=1
local integer id
// call BenchmarkStart()
call GroupEnumUnitsInRect(GGlobal,bj_mapInitialPlayableArea,Base)
loop
set E=GroupForEachUnit(GGlobal)
set id=GetHandleId(E)
set time=LoadInteger(h,id,'HerT')
if LoadReal(HH,id,'AAcd')>0 then
    call SaveReal(HH,id,'AAcd',LoadReal(HH,id,'AAcd')-0.2)
else
    call SaveReal(HH,id,'AAcd',0)
endif
// call BJDebugMsg(GetUnitName(E)+"  "+R2S(LoadReal(HH,id,'AAcd')))
if time<20 then
call SaveInteger(h,id,'HerT',time+1)
endif
call SaveReal(h,id,'tpx_'+time,GetUnitX(E))
call SaveReal(h,id,'tpy_'+time,GetUnitY(E))
loop
exitwhen ti>time
call SaveReal(h,id,'tpx_'+ti,LoadReal(h,id,'tpx_'+(ti+1)))
call SaveReal(h,id,'tpy_'+ti,LoadReal(h,id,'tpy_'+(ti+1)))
set ti=ti+1
endloop
set ti=1
exitwhen E==null
endloop
call GroupClear(GGlobal)
// call BenchmarkEnd()
// call BJDebugMsg(BenchmarkGetElapsed(2))
// call BenchmarkReset()
endfunction
