call SetUnitScale(n,0.65,0.65,0.65)
call SetUnitVertexColor(n,150,200,255,50)
set n=CreateUnit(p,'e0RR',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitVertexColor(n,255,255,255,50)
call SaveReal(h,id,17,time-0.1)
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\RasenShurikenThrow.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
