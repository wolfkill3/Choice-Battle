function SetCameraAct takes nothing returns nothing
    local integer i=GetPlayerId(GetTriggerPlayer())
    local string s = SubString(GetEventPlayerChatString(), 5, 10)
    if GetLocalPlayer() == GetTriggerPlayer() and StringLength(GetEventPlayerChatString()) < 11 and S2R(s) <= 6000. and S2R(s) >= 100. then
        call SetCameraField(CAMERA_FIELD_TARGET_DISTANCE, S2R(s), 0.5) //1700+(400*S2R(s))
        set SetCamera[i]=S2R(s)
        call SetCameraField(CAMERA_FIELD_FARZ, 9000, 0.5)
        call DisplayTextToPlayer(GetTriggerPlayer(),0,0,"|c00157BF9Camera Height is set to:|c00FF0000 "+s+"|r")
    endif
    //set n =  CreateUnit(Player(0), 'H112',0,0,0)
    //call SetHeroLevel(n,30,true)
endfunction

function Trig_ArenaCamera1_Actions takes nothing returns nothing
    local integer i=0   
    loop
    exitwhen i>=11
        call SetCameraFieldForPlayer(Player(i),CAMERA_FIELD_ROTATION,90.0,0.0)
        call SetCameraFieldForPlayer(Player(i),CAMERA_FIELD_ANGLE_OF_ATTACK,304.0,0.0)
        call SetCameraFieldForPlayer(Player(i),CAMERA_FIELD_TARGET_DISTANCE, SetCamera[i],0)
        call SetCameraFieldForPlayer(Player(i),CAMERA_FIELD_FARZ, 9000, 0.5)
        set i=i+1
    endloop
endfunction

function Trig_ArenaCamera2_Actions takes nothing returns nothing
    local integer i=0   
    loop
    exitwhen i>=11
        call SetCameraFieldForPlayer(Player(i),CAMERA_FIELD_ROTATION,90.0,0.0)
        call SetCameraFieldForPlayer(Player(i),CAMERA_FIELD_ANGLE_OF_ATTACK,304.0,0.0)
        if SetCamera[i]<2867 then
            call SetCameraFieldForPlayer(Player(i),CAMERA_FIELD_TARGET_DISTANCE, 2867,0.6)
        else
            call SetCameraFieldForPlayer(Player(i),CAMERA_FIELD_TARGET_DISTANCE, SetCamera[i],0)
        endif
        call SetCameraFieldForPlayer(Player(i),CAMERA_FIELD_FARZ, 9000, 0.5)
        set i=i+1
    endloop
endfunction

