function FrendaToysCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local integer i=0
local real r=0
local integer r2=GetRandomInt(0,3)
local real l__d=0
local real a=Atan2(y-y1,x-x1)*bj_DEGTORAD
local real dmg=0.05*GetHeroInt(u,true)+0.05*GetHeroInt(u,true)*GetUnitAbilityLevel(u,0x41313951)
loop
exitwhen i>4+GetUnitAbilityLevel(u,'A19R')
set l__d= 170+I2R((i-1)/3)*170
set r=r2+i*2
set n=CreateUnit(p,'e0ZV',x1,y1,0)
call PauseUnit(n,true)
call UnitAddAbility(n,'A0QL')
call UnitAddAbility(n,'A1C3')
call UnitMakeAbilityPermanent(n,true,'A0QL')
call SetUnitTimeScale(n,0)
call UnitAddType(n,UNIT_TYPE_STRUCTURE)
call SetUnitInvulnerable(n,true)
call SetUnitFlyHeight(n,95,0)
if i==0 then
call FrendaToysMissleFly(n,35,GetRandomReal(-1,1),x,y,200,250,dmg)
else
call FrendaToysMissleFly(n,35,GetRandomReal(-1,1),x+l__d*Cos(r),y+l__d*Sin(r),GetRandomReal(150,350),250,dmg)
endif
set i=i+1
endloop
