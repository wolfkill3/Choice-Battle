function TGilCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real rx=0
local real ry=0
local real x1=0
local real y1=0
local real time=LoadReal(h,id,3)
local real a=GetUnitFacing(u)*bj_DEGTORAD-deg90
local player p=GetOwningPlayer(u)
local real st=LoadReal(h,id,4)
local real sc=0
local real he=GetUnitFlyHeight(u)
local trigger tt=LoadTriggerHandle(h, id, StringHash("OrderTrigger"))
call SetControlToUnit(u,u,0.1,"doom")
if time>0 then
if time<3 then
    if he<750 then
        call SetUnitFlyHeight(u,he+20,0)
    else
        call SetUnitTimeScale(u,0)
        if LoadInteger(h,id,5)!=1 then
            set x1=x-25*Cos(a+deg90)
            set y1=y-25*Sin(a+deg90)
            set x1=x1+50*Cos(a)
