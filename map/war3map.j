set n0=null
endif


endif
if time==2.1 then

set x0=PolX(LoadReal(HH,id,11),1900,facing)
set y0=PolY(LoadReal(HH,id,12),1900,facing)

if IsTerrainPathable(x0,y0,PATHING_TYPE_FLYABILITY)==false then
