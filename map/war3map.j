call SetUnitAnimationPerTime(n,3.55-time3,"Spell Slam Two",1+(3.55-time3)/10)
call SaveReal(h,id,3,0.25)
endif
else
call UnitApplyTimedLife(CreateUnit(p,'e0RH',x1,y1,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0RK',x1,y1,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0RN',x1,y1,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0XQ',x1,y1,(a*bj_RADTODEG)),'BTLF',4)
