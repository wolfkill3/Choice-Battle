return GetSpellAbilityId()=='A02Y'
endfunction
function HachPoundHoCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=LoadReal(h,id,1)
local real y=LoadReal(h,id,2)
local real a=Atan2(LoadReal(h,id,4)-y,LoadReal(h,id,3)-x)
local real l__d=LoadReal(h,id,5)
local group g=LoadGroupHandle(h,id,6)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroStr(u,true)*(1+GetUnitAbilityLevel(u,'A02Y'))+50*GetUnitAbilityLevel(u,'A02Y')
if l__d<2500 then
set x=x+l__d*Cos(a)
set y=y+l__d*Sin(a)
set n=CreateUnit(p,'e0U1',x,y,(a*bj_RADTODEG))
call UnitApplyTimedLife(n,'BTLF',1.5)
set n=CreateUnit(p,'e0TZ',x,y,(a*bj_RADTODEG))
call UnitApplyTimedLife(n,'BTLF',1.5)
set n=CreateUnit(p,'e0U0',x,y,(a*bj_RADTODEG))
call UnitApplyTimedLife(n,'BTLF',1.5)
set n=CreateUnit(p,'e0U2',x,y,(a*bj_RADTODEG))
call UnitApplyTimedLife(n,'BTLF',1.5)
call SetUnitTimeScale(n,0.25)
call SetUnitAnimation(n,"death")
call SetUnitVertexColor(n,75,200,255,75)
call SaveReal(h,id,5,l__d+50)
call GroupEnumUnitsInRange(g,x,y,200,Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set ide=GetHandleId(E)
if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",E,"chest"))
endif
call GroupRemoveUnit(g,E)
endloop
else
set idg=GetHandleId(g)
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,idg)
endif
set p=null
set u=null
set g=null
set t=null
endfunction
