local real l__d=LoadReal(h,id,5)
local group g=LoadGroupHandle(h,id,6)
local player p=GetOwningPlayer(u)
local real dmg=(GetUnitAbilityLevel(u,'A152')+3)*GetHeroStr(u,true)
local real time=LoadReal(h,id,7)
if time<0.81 then
call SaveReal(h,id,7,time+0.01)
if time==0.8 then
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
endif
else
if l__d<2100 then
set x=x+l__d*Cos(a)
set y=y+l__d*Sin(a)
call DestroyEffect(AddSpecialEffect("war3mapImported\\Slam.mdl",x,y))
