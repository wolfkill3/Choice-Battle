function HeroSkin takes unit u returns integer
local integer retUnitId
local integer id=GetUnitTypeId(u)
set retUnitId=id
if id=='H06X' then
set retUnitId='H05D'
elseif id=='H06V' then
set retUnitId='H04L'
elseif id=='H06Z' or id=='H16Z' then
set retUnitId='H06Y'
elseif id=='H05C' or id=='H05E' or id=='H15C' then
set retUnitId='H06P'
elseif id=='H06R' then
set retUnitId='H044'
elseif id=='H26B' or id=='H16B' then
set retUnitId='H06B'
elseif id=='H12M' then
set retUnitId='H02M'
elseif id=='H14H' then
set retUnitId='H04H'
elseif id=='H06S' or id=='H070' then
set retUnitId='H059'
elseif id=='H06Q' then
set retUnitId='H053'
elseif id=='H01H' then
set retUnitId='H06N'
elseif id=='H05B' then
set retUnitId='H05A'
elseif id=='H06D' then
set retUnitId='H012'
elseif id=='H064' then
set retUnitId='H03R'
elseif id=='Ho1O' then
set retUnitId='Ho0O'
elseif id=='H05X' then
set retUnitId='H02U'
elseif id=='H05Y' then
set retUnitId='H02F'
elseif id=='H12G' then
set retUnitId='H02G'
endif
return retUnitId
endfunction
function BuffUnpausePet1 takes nothing returns nothing
local buff buf=HandleListGetEnumBuff()
call PauseBuff(buf,false)
set buf=null
endfunction
function BuffPausePet1 takes nothing returns nothing
local buff buf=HandleListGetEnumBuff()
local real b=GetBuffRemainingDuration(buf)
call PauseBuff(buf,true)
set buf=null
endfunction

function PlayerAssistGold takes nothing returns nothing
local player p=GetEnumPlayer()
local integer HLid=GetHandleId(PlayerH)
local real goldas=LoadReal(HH,HLid,0)
call SetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)+R2I(goldas))
call ForceRemovePlayer(PlayerH,p)
set p=null
endfunction

function PauseBuffFunc takes nothing returns nothing
local buff buf=HandleListGetEnumBuff()
local integer HLid=GetHandleId(bufh)
local integer bid=GetHandleId(buf)
local boolean state=LoadBoolean(HH,HLid,0)
call PauseBuff(buf,state)
set buf=null
endfunction

function ItemDoubleClickCond takes nothing returns boolean
return GetSpellAbilityId()=='A048' or GetSpellAbilityId()=='A15E' or GetSpellAbilityId()=='A10Q' or GetSpellAbilityId()=='A0HL' or GetSpellAbilityId()=='A0WJ' or GetSpellAbilityId()=='A09A'
endfunction
function ItemDoubleClickCast takes nothing returns nothing
    local unit u=GetTriggerUnit()
    if GetSpellTargetItem()==GetAbilityOwningItem(GetSpellAbility()) then
        call IssueImmediateOrder(u,"stop")
        call UnitUseItemTarget(u,GetAbilityOwningItem(GetSpellAbility()),u)
    elseif GetSpellTargetItem()!=null then
        call IssueImmediateOrder(u,"stop")
    endif
    set u=null
endfunction
function ItemDoubleClickInit takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_SPELL_CHANNEL)
call TriggerAddCondition(t,Condition(function ItemDoubleClickCond))
call TriggerAddAction(t,function ItemDoubleClickCast)
set t=null
endfunction

// Shop32: курсор в поиске магазина — горячие клавиши карты у этого игрока молчат.
// Значение локальное: проверять только внутри блоков GetLocalPlayer(), где нет
// изменений состояния игры, иначе будет рассинхрон.
function Sh_Typing takes nothing returns boolean
return ShSearch!=null and IsFrameFocused(ShSearch)
endfunction

function Trig_Sync_Actions takes nothing returns nothing
local player p=GetTriggerPlayer()
if GetLocalPlayer() == p and not Sh_Typing() then
call SaveReal(HSYNC,GetHandleId(p),c_MOUSE_X,GetMouseWorldX())
call SaveReal(HSYNC,GetHandleId(p),c_MOUSE_Y,GetMouseWorldY())
call SyncSavedReal(HSYNC, GetHandleId(p), c_MOUSE_X)
call SyncSavedReal(HSYNC, GetHandleId(p), c_MOUSE_Y)
set p=null
endif
endfunction

function IsEmoteBought takes player p, integer i returns boolean
if i<30 or BaseEmoteCond(p) then
return true
else
return false
endif
endfunction

function ShowEmote takes nothing returns nothing //
local framehandle SFrame=HandleListGetEnumFrame()
if IsEmoteBought(P,GetFrameContext(SFrame))==false then
if P==GetLocalPlayer() and IsFrameVisible(EmoteBarFrame)==true then
call ShowFrame(SFrame,true)
endif
else
if P==GetLocalPlayer() and IsFrameVisible(EmoteBarFrame)==true then
call ShowFrame(SFrame,false)
endif
endif
set SFrame=null
endfunction
function HideEmote takes nothing returns nothing
local framehandle SFrame=HandleListGetEnumFrame()
if P==GetLocalPlayer() and IsFrameVisible(EmoteBarFrame)==true and IsEmoteBought(P,GetFrameContext(SFrame)) then
call ShowFrame(SFrame,false)
endif
set SFrame=null
endfunction
function ShowStatus takes nothing returns nothing //
local framehandle SFrame=HandleListGetEnumFrame()
if LoadReal(HH, GetHandleId(HandleListGetEnumFrame()), c_DURATION)>0 then
if P==GetLocalPlayer() and IsFrameVisible(StatusBarFrame)==true then
call ShowFrame(SFrame,true)
endif
else
if P==GetLocalPlayer() and IsFrameVisible(StatusBarFrame)==true then
call ShowFrame(SFrame,false)
endif
endif
set SFrame=null
endfunction
function HideStatus takes nothing returns nothing
local framehandle SFrame=HandleListGetEnumFrame()
if P==GetLocalPlayer() and IsFrameVisible(StatusBarFrame)==true  then
call ShowFrame(SFrame,false)
endif
set SFrame=null
endfunction
function HideId takes nothing returns nothing
local framehandle SFrame=HandleListGetEnumFrame()
if P==GetLocalPlayer() then
call ShowFrame(SFrame,false)
endif
set SFrame=null
endfunction
function OnButtonHover2 takes nothing returns nothing
    local framehandle but = GetTriggerFrame( )
    local framehandle but2 = GetFrameChild( but,0 )    
    local framehandle cursor = GetOriginFrame( ORIGIN_FRAME_CURSOR_FRAME, 0 )
    local integer bid = GetHandleId( but2 )
    local player p = GetTriggerPlayer( )
    if p == GetLocalPlayer( ) then
        if but2 != null then
            if not LoadBoolean( HH, bid, 'hvrr' ) then
                call ShowFrame(but2,true)
                call SaveBoolean( HH, bid, 'hvrr', true )
            endif
        endif
    endif
    set p = null
    set but = null
    set but2 = null
    set cursor=null
endfunction

function OnButtonUnHover2Handler takes nothing returns nothing
    local integer hid = GetHandleId( GetExpiredTimer( ) )
    local player p = LoadPlayerHandle( HH, hid, '+ply' )
    local framehandle but = LoadFrameHandle( HH, hid, '+frm' )
    local framehandle cursor = GetOriginFrame( ORIGIN_FRAME_CURSOR_FRAME, 0 )
    local integer bid = GetHandleId( but )

    if p == GetLocalPlayer( ) then
        if but != null then
            if LoadBoolean( HH, bid, 'hvrr' ) then
                call ShowFrame(but,false)
                call SaveBoolean( HH, bid, 'hvrr', false )
            endif
        endif
    endif

    set p = null
    set but = null
    set cursor = null
endfunction

function OnButtonUnHover2 takes nothing returns nothing
    local player p = GetTriggerPlayer( )
    local framehandle but = GetTriggerFrame( )
    local framehandle but2 = GetFrameChild( but,0 )   
    local timer tmr = LoadTimerHandle( HH, GetHandleId( but2 ), '+tmr' )

    if tmr == null then
        set tmr = CreateTimer( )
        call SaveTimerHandle( HH, GetHandleId( but2 ), '+tmr', tmr )
        call SavePlayerHandle( HH, GetHandleId( tmr ), '+ply', p )
        call SaveFrameHandle( HH, GetHandleId( tmr ), '+frm', but2 )
    endif

    call TimerStart( tmr, .01, false, function OnButtonUnHover2Handler )

    set p = null
    set but = null
    set but2 = null
endfunction

function OnEmoteHover takes nothing returns nothing
    local player p = GetTriggerPlayer( )
    local framehandle cursor = GetOriginFrame( ORIGIN_FRAME_CURSOR_FRAME, 0 )
    local framehandle but = GetTriggerFrame( ) //GetFrameContext(but)
    local integer i=0
    if p == GetLocalPlayer( ) then
        call SetFrameSpriteColour( cursor, 0xFF00FF00 )
