function BansheeBlastMissleMovePoint2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
local player p=GetOwningPlayer(l__d)
local integer idu=GetPlayerId(p)
local real dmg=LoadReal(h,id,5)
local unit u=LoadUnitHandle(h,id,6)
local integer Dp1=LoadInteger(h,id,9)
local unit n1
local unit n2
local unit n3
if SR(x,y,x1,y1)>speed+30 then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SaveReal(h,id,1,speed+1)
else
if Dp1>0 then
call GroupEnumUnitsInRange(G,x1,y1,165,Base)
else
call GroupEnumUnitsInRange(G,x1,y1,150,Base)
endif
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E) then
call myCustomDamage(Hero[idu],E,dmg,false,false,null,null,null)
call SlowUnit(Hero[idu],E,0.5,0,5,0,false)
endif
call GroupRemoveUnit(G,E)
endloop
set n1=CreateUnit(p,'e0LG',x1,y1,a*bj_RADTODEG)
if Dp1>0 then
call SetUnitVertexColor(n1,15,15,255,250)
endif 
call UnitApplyTimedLife(n1,'BHwe',3)
set n2=CreateUnit(p,'e0G3',x1,y1,a*bj_RADTODEG)
if Dp1>0 then
call SetUnitVertexColor(n2,15,15,255,250)
endif
call UnitApplyTimedLife(n2,'BHwe',3)
set n3=CreateUnit(p,'e0LF',x1,y1,a*bj_RADTODEG)
if Dp1>0 then
call SetUnitVertexColor(n3,15,15,255,250)
endif
call UnitApplyTimedLife(n3,'BHwe',3)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\PunchStrike.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set p=null
set l__d=null
set n2=null
set n1=null
set n3=null
set t=null
endfunction
function BansheeBlastMissleMovePoint takes unit l__d,real speed,real angle,real x,real y,real dmg, unit u, integer Dp1 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,6,u)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,dmg)
call SaveInteger(h,id,9,Dp1)
call TimerStart(t,.028,true,function BansheeBlastMissleMovePoint2)
set t=null
endfunction
function BansheeBlastCond takes nothing returns boolean
return GetSpellAbilityId()=='A0RD'
endfunction
function BansheeBlastCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local real a=Atan2(y1-y,x1-x)
local real dist=LoadReal(h,id,7)
local player p=GetOwningPlayer(u)
local integer Dp1
local real dmg=(1+.3*GetUnitAbilityLevel(u,'A0RD'))*GetHeroAgi(u,true)
if GetUnitAbilityLevel(u,'A176')>0 then
set dmg=dmg+0.25*GetHeroAgi(u,true)
set Dp1=1
else
set Dp1=0
endif
if dist<5 then
if GetUnitAbilityLevel(u,'A176')>0 then
set n=CreateUnit(p,0x72555733,x+45*Cos(a),y+45*Sin(a),a*bj_RADTODEG)
call SetUnitScale(n,1,1,1)
else
set n=CreateUnit(p,'e0M1',x+45*Cos(a),y+45*Sin(a),a*bj_RADTODEG)
call SetUnitScale(n,0.5,0.5,0.5)
endif
call SaveReal(h,id,7,dist+1)
call BansheeBlastMissleMovePoint(n,40,0,x1+GetRandomReal(-205,205),y1+GetRandomReal(-205,205),dmg,u,Dp1)
else
call PauseUnit (u,false)
call SetUnitTimeScale(u,1)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set t=null
endfunction
function BansheeBlastCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,GetSpellTargetX())
call SaveReal(h,id,3,GetSpellTargetY())
call PauseUnit(u,true)
call TimerStart(t,0.01,true,function BansheeBlastCast2)
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
    set soundplay=CreateSound("Sound\\Music\\mp3Music\\BansheeBlast.mp3",false,false,true,12700,12700,"")
else
    set soundplay=CreateSound("Sound\\Music\\mp3Music\\Vegitto\\BansheeBlast-jap.mp3",false,false,true,12700,12700,"")
endif
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
set u=null
set t=null
endfunction
function InitTrig_BansheeBlast takes nothing returns nothing
set gg_trg_BansheeBlast=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_BansheeBlast,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_BansheeBlast,Condition(function BansheeBlastCond))
call TriggerAddAction(gg_trg_BansheeBlast,function BansheeBlastCast)
endfunction


function MisakaRemoveElectrification takes unit newCaster, unit newTarget, real newDamage returns nothing
        local real true_damage = GetHeroAgi(newCaster, true)*2
        local real damage = GetHeroAgi(newCaster, true)*2 + newDamage
        if GetUnitAbilityLevel(newTarget, 'MiMp')>=1 and UnitIsAlive(newTarget) then
                set n=CreateUnit(GetOwningPlayer(newCaster), 'dH50', GetUnitX(newTarget), GetUnitY(newTarget), GetRandomInt(0, 360))
                call SetUnitScale(n, 2, 2, 2)
                call SetUnitFlyHeight(n, 40, 0)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(newCaster), 'dH51', GetUnitX(newTarget), GetUnitY(newTarget), GetRandomInt(0, 360))
                call SetUnitScale(n, 0.75, 0.75, 0.75)
                call MyRemoveUnit(n, 1.5)
                call UnitRemoveAbility(newTarget, 'MiMp')
                call myCustomDamage(newCaster, newTarget, damage, false , false , null , null , null)
                call SetControlToUnit(newCaster, newTarget, 1, "stun")
                // if GetWidgetLife(newTarget)>true_damage then
                        // call SetWidgetLife(newTarget, GetWidgetLife(newTarget)-true_damage)
                        // call UnitRemoveAbility(newTarget, 'MiMp')
                        // call SetControlToUnit(newCaster, newTarget, 2, "stun")
                // else
                        // call UnitRemoveAbility(newTarget, 'MiMp')
                        // call UnitAddAbility(newTarget, 'A0WR')
                        // call myCustomDamage(newCaster, newTarget, true_damage, false , false , null , DAMAGE_TYPE_UNKNOWN , null)
                        // call SetControlToUnit(newCaster, newTarget, 2, "stun")
                        // call UnitRemoveAbility(newTarget, 'A0WR')
                // endif
        else
                call myCustomDamage(newCaster, newTarget, newDamage, false , false , null , null , null)
        endif
endfunction

function MisakaAddElectrification takes unit newCaster, unit newTarget, real newDamage returns nothing
	if GetHeroLevel(newCaster)>=12 and UnitIsAlive(newTarget) then
		if GetUnitAbilityLevel(newTarget, 'MiMp')>=1 then
			call MisakaRemoveElectrification(newCaster, newTarget, newDamage)
		else
			call myCustomDamage(newCaster, newTarget, newDamage, false , false , null , null , null)
            call SlowUnit(newCaster,newTarget,0.35,0.5,5,0,false)
			set n=CreateUnit(GetOwningPlayer(newCaster), 'dH52', GetUnitX(newTarget), GetUnitY(newTarget), GetRandomInt(0, 360))
			call SetUnitScale(n, 1.5, 1.5, 1.5)
			call MyRemoveUnit(n, 1.5)
			call RemoveEffect(AddSpecialEffectTarget("by_wood_effect_yuba21.mdx", newTarget, "chest"), 1.5, true, CreateTimer())
			call DestroyEffect(AddSpecialEffectTarget("M_ExD_LightingSlash.mdx", newTarget, "chest"))
		endif
	endif
endfunction

function LevelSixCond takes nothing returns boolean
return GetSpellAbilityId()=='A10N'
endfunction
function LevelSixCast2 takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(h,id,0)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        local player p=GetOwningPlayer(u)
        if UnitIsAlive(u) then
            set n=CreateUnit(p,'e08J',x,y,GetRandomReal(0,359))
            call UnitApplyTimedLife(n,'B001',0.25)
            call SetUnitScale(n,0.75,0.75,0.75)
            call SetUnitTimeScale(n,3)
            call SetUnitVertexColor(n,0,0,0,125)
            if CheckUnitInvisible(u) then
                call UnitAddAbility(n,'A0A1')
            endif
            set n=CreateUnit(p,'e0F3',x+GetRandomReal(-75,75),y+GetRandomReal(-75,75),0)
            call UnitApplyTimedLife(n,1,0.25)
            call SetUnitTimeScale(n,3)
            if CheckUnitInvisible(u) then
                call UnitAddAbility(n,'A0A1')
            endif
            if GetUnitAbilityLevel(u,'MisF')==0 or udg_B==false then
                call SetWidgetMana(u, GetWidgetMana(u)+60)
                if LoadStr(h, id, StringHash("MisakaModel"))=="MisakaMikotoExD.mdl" then
                    call UnitAddAbility(u, 'SS04')
                    call IssueImmediateOrder(u, "bearform")
                    call UnitRemoveAbility(u, 'SS04')
                else
                    call UnitAddAbility(u, 'SS06')
                    call IssueImmediateOrder(u, "bearform")
                    call UnitRemoveAbility(u, 'SS06')
                endif
                if GetUnitTypeId(u)=='H044' or GetUnitTypeId(u)=='H06R' then
                    call FlushChildHashtable(h,id)
                    call UnitRemoveAbility(u, 'B05A')
                    call PauseTimer(t)
                    call DestroyTimer(t)
                endif
            endif
        endif
        set p=null
        set t=null
        set u=null
endfunction
function LevelSixCast takes nothing returns nothing
        local unit u=GetTriggerUnit()
        local timer t=CreateTimer()
        local integer id=GetHandleId(t)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        local player p=GetOwningPlayer(u)
        //call SetUnitVertexColor(u,155,155,155,225)
        if GetUnitAbilityLevel(u, 'MisF')==1 then
            call IssueImmediateOrder(u, "stop")
            call SetWidgetMana(u, GetWidgetMana(u)+450)
            call StartAbilityCooldown(GetUnitAbility(u, 'A10N'), 5)
        else
            //call SetUnitScale(u, 1.1, 1.1, 1.1)
            //call SetUnitModel(u, "MisakaLvl6.mdx")
            if GetUnitTypeId(u)=='H044' then
                call UnitAddAbility(u, 'SS03')
                call IssueImmediateOrder(u, "bearform")
                call UnitRemoveAbility(u, 'SS03')
                call SaveStr(h, id, StringHash("MisakaModel"), "MisakaMikotoExD.mdl")
                call SaveReal(h, id, StringHash("MisakaModelScale"), 0.65)
            else
                call UnitAddAbility(u, 'SS05')
                call IssueImmediateOrder(u, "bearform")
                call UnitRemoveAbility(u, 'SS05')
                call SaveStr(h, id, StringHash("MisakaModel"), "MisakaMeido.mdl")
                call SaveReal(h, id, StringHash("MisakaModelScale"), 0.95)
            endif
            call UnitAddAbility(u,'MisF')
            call UnitRemoveAbilityTimedPause(u,'MisF',15)
            call CreateModeIndicatorWithPauseForm(u, "ReplaceableTextures\\CommandButtons\\BTNMisakaF.blp", 15)
            set n=CreateUnit(p, 'dH53', x, y, GetRandomInt(0, 360))
            call SetUnitFlyHeight(n, 20, 0)
            call SetUnitScale(n, 1.5, 1.5, 1.5)
            call SetUnitTimeScale(n, 0.6)
            call MyRemoveUnit(n, 1.0)
            set n=CreateUnit(p, 'dH53', x, y, GetRandomInt(0, 360))
            call SetUnitFlyHeight(n, 20, 0)
            call SetUnitScale(n, 2.5, 2.5, 2.5)
            call SetUnitTimeScale(n, 0.6)
            call MyRemoveUnit(n, 1.0)
            
            //call UnitApplyTimedLife(CreateUnit(p,'e03X',x,y,GetRandomReal(0,359)),1,1)
            call UnitApplyTimedLife(CreateUnit(p,'e03W',x,y,GetRandomReal(0,359)),1,1)
            call UnitApplyTimedLife(CreateUnit(p,'e08R',x,y,GetRandomReal(0,359)),1,1)
            call UnitApplyTimedLife(CreateUnit(p,'e03Y',x,y,GetRandomReal(0,359)),1,1)
            call UnitApplyTimedLife(CreateUnit(p,'e08N',x,y,GetRandomReal(0,359)),1,1)
            call SaveUnitHandle(h,id,0,u)
            // set soundplay=CreateSound("Sound\\Music\\mp3Music\\MisakaG.mp3",false,false,true,12700,12700,"")
            // call StartSound(soundplay)
            // call KillSoundWhenDone(soundplay)
            set soundplay=CreateSound("Sound\\war3mapImported\\Misaka F.mp3", false, false, true, 12700, 12700, "")
            call StartSound(soundplay)
            call KillSoundWhenDone(soundplay)
            call TimerStart(t,0.08,true,function LevelSixCast2)
        endif
        set u=null
        set p=null
        set t=null
endfunction
function RailgunCond takes nothing returns boolean
return GetSpellAbilityId()=='A0RQ' and udg_B==true
endfunction
function RailgunCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=LoadReal(h,id,1)
local real y=LoadReal(h,id,2)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real a=Atan2(LoadReal(h,id,4)-y,LoadReal(h,id,3)-x)
local real l__d=LoadReal(h,id,5)
local real dmg2=LoadReal(h,id,10)
local group g=LoadGroupHandle(h,id,6)
local player p=GetOwningPlayer(u)
local real dmg=10*GetHeroAgi(u,true)+125+dmg2
if l__d<3000 then
set x=x+l__d*Cos(a)
set y=y+l__d*Sin(a)
set n=CreateUnit(p,'e0Q1',x,y,(a*bj_RADTODEG))
call UnitApplyTimedLife(n,1,0.35)
set n=CreateUnit(p,'e0Q2',x,y,(a*bj_RADTODEG))
call UnitApplyTimedLife(n,1,0.75)
set n=CreateUnit(p,'e0Q4',x,y,(a*bj_RADTODEG))
call UnitApplyTimedLife(n,1,0.75)
if dmg2>0 then
set n=CreateUnit(p,'e08J',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'B001',0.5)
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitTimeScale(n,1.5)
call SetUnitVertexColor(n,0,0,0,125)
call UnitApplyTimedLife(CreateUnit(p,'e0F5',x1+GetRandomReal(-75,75),y1+GetRandomReal(-75,75),0),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e0F3',x+GetRandomReal(-75,75),y+GetRandomReal(-75,75),0),1,1)
endif
call SaveReal(h,id,5,l__d+90)
call GroupEnumUnitsInRange(g,x,y,250,Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set ide=GetHandleId(E)
if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
        if GetUnitTypeId(E)=='H04H' then
                if GetRandomReal(0,100)>33 then
                        call Push3(E,100,a,2655-l__d,"")
                        // call myCustomDamage(u,E,dmg,false,false,null,null,null)
                        call SaveUnitHandle(h,idg,ide,E)
                        call SetControlToUnit(E,E, 2, "stun")
                        call MisakaAddElectrification(u, E, dmg)
                endif
        else
                call Push3(E,100,a,2655,"")
                // call myCustomDamage(u,E,dmg,false,false,null,null,null)
                call SaveUnitHandle(h,idg,ide,E)
                call SetControlToUnit(E,E, 2, "stun")
                call MisakaAddElectrification(u, E, dmg)
        endif
endif
call GroupRemoveUnit(g,E)
endloop
else
set x=x+l__d*Cos(a)
set y=y+l__d*Sin(a)
call StartSound(soundStr[47])
call UnitApplyTimedLife(CreateUnit(p,'e0NJ',x,y,GetRandomReal(0,359)),1,3)
//call UnitApplyTimedLife(CreateUnit(p,'e0NK',x,y,GetRandomReal(0,359)),1,5)
call UnitApplyTimedLife(CreateUnit(p,'e0NI',x,y,GetRandomReal(0,359)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0NL',x,y,GetRandomReal(0,359)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0NM',x,y,GetRandomReal(0,359)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0MI',x,y,GetRandomReal(0,359)),1,0.75)
set idg=GetHandleId(g)
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,idg)
endif
set p=null
set u=null
set g=null
set t=null
endfunction
function RailgunCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
local player p=GetOwningPlayer(u)
call SaveGroupHandle(h,id,6,CreateGroup())
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,x)
call SaveReal(h,id,8,2)
call SaveReal(h,id,2,y)
call SaveReal(h,id,3,GetSpellTargetX())
call SaveReal(h,id,4,GetSpellTargetY())
call SaveReal(h,id,10,0)
call UnitApplyTimedLife(CreateUnit(p,0x65304C4F,x,y,GetRandomReal(0,359)),1,1)
if GetUnitAbilityLevel(u,0x42303541)>0 then
        call SaveReal(h,id,10,GetHeroInt(u,true)*2)
        set soundplay=CreateSound("Sound\\war3mapImported\\Misaka TF.mp3", false, false, true, 12700, 12700, "")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
else
        set soundplay=CreateSound("Sound\\war3mapImported\\Misaka T.mp3", false, false, true, 12700, 12700, "")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
endif
// set soundplay=CreateSound("Sound\\Music\\mp3Music\\Railgun.mp3",false,false,true,12700,12700,"")
// call StartSound(soundplay)
// call KillSoundWhenDone(soundplay)
call TimerStart(t,0.035,true,function RailgunCast2)
set p=null
set u=null
set t=null
endfunction
function LightningBarrierCond takes nothing returns boolean
return GetSpellAbilityId()=='A0RP'
endfunction
function LightningBarrierCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local group g=LoadGroupHandle(h,id,1)
local integer idu=GetHandleId(u)
local integer i=1
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local real dist
local real dmg2=LoadReal(h,id,10)
local real dmg=(GetUnitAbilityLevel(u,'A0RP')+4)*GetHeroAgi(u,true)+dmg2
local integer l__idg=GetHandleId(g)
local real f
local player p=GetOwningPlayer(u)
local integer l__ide
loop
exitwhen i>15
set dist=LoadReal(h,id,StringHash("dist"+I2S(i)))+200
call SaveReal(h,id,StringHash("dist"+I2S(i)),dist)
set f=(24*i)*bj_DEGTORAD
call DestroyEffect(AddSpecialEffect(" ",x+dist*Cos(f),y+dist*Sin(f)))
call DestroyEffect(AddSpecialEffect("war3mapImported\\lightning boom.mdl",x+dist*Cos(f),y+dist*Sin(f)))
set i=i+1
endloop
call GroupEnumUnitsInRange(g,x,y,dist,Base)
set n=CreateUnit(p,0x65305058,x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,1)
call UnitScale(n,0.01,5.0,0.75)
if dmg2>0 then
call UnitApplyTimedLife(CreateUnit(p,'e0F5',x+GetRandomReal(-dist/2,dist/2),y+GetRandomReal(-dist/2,dist/2),0),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e0F3',x+GetRandomReal(-dist/2,dist/2),y+GetRandomReal(-dist/2,dist/2),0),1,1)
endif
loop
set E=FirstOfGroup(g)
set l__ide=GetHandleId(E)
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,l__ide)then
// call myCustomDamage(u,E,dmg,false,false,null,null,null)
call MisakaAddElectrification(u, E, dmg)
call SaveUnitHandle(h,l__idg,l__ide,E)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
call PauseUnit(u,true)
if dist>=1000 then
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
set u=null
set g=null
set t=null
set p=null
endfunction
function LightningBarrierCast takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
