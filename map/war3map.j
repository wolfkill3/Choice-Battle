call RemoveUnit(Heart2)
call RemoveUnit(Heart3)


call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
set caster=null
set Heart1=null
set Heart2=null
set Heart3=null
endfunction
