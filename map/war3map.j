endfunction
function EKiyoCast4 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit c=LoadUnitHandle(h,id,1)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetUnitX(c)
    local real y1=GetUnitY(c)
    local real a=LoadReal(h,id,4)-180*bj_DEGTORAD
    local real dmg=GetHeroStr(u,true)*(2+GetUnitAbilityLevel(u,'Ao7E'))
    local real time=LoadReal(h,id,2)+0.03
    local real f=GetUnitFacing(u)
    local player p=GetOwningPlayer(u)
    if time==0.03 and UnitIsAlive(u)==true and UnitIsAlive(c)==true then
        call SetUnitAnimationByIndex(u,18)
    endif
    if time<0.65 and UnitIsAlive(u)==true and UnitIsAlive(c)==true then
    set x=x+(5+(SR(x,y,x1,y1)/10)) * Cos(a)
    set y=y+(5+(SR(x,y,x1,y1)/10)) * Sin(a)
    call SetUnitFacingInstant(u,a*bj_RADTODEG)
    call SetUnitFlyHeight(u,ParabolaZ2(180,0,40,LoadReal(h,id,5),time*1100),0)
    call SetUnitXY_1(u,x,y, false)
    call SaveReal(h,id,2,time)
    if GetUnitFlyHeight(u)<100 then
    set EFF=AddSpecialEffect("nitu.mdx",x,y)
    call SetSpecialEffectScale(EFF , 1.2)
    call SetSpecialEffectFacing(EFF , a*bj_RADTODEG+180)
    call SetSpecialEffectAlphaTimed(EFF , 255,255,255,75, 2)
    call RemoveEffect(EFF,0.2,true,CreateTimer())
    endif
    else
    call SetUnitAnimation(u,"Stand")
    call SetUnitFlyHeight(u,0,100)
    call PauseUnit(u,false)
    call PauseUnit(c,false)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
    call SetUnitInvulnerable(u,false)
    call SetUnitInvulnerable(c,false)
    call myCustomDamage(u,c,dmg,false,false,null,null,null)
    call SetControlToUnit(u,c,1.5,"stun")
    if GetHeroLevel(u)>12 and udg_B==true  then
        call SaveInteger(HH, GetHandleId(u) ,StringHash("BonusSTR"),LoadInteger(HH, GetHandleId(u) ,StringHash("BonusSTR"))+2)
        call SetHeroStr(u,GetHeroStr(u,false)+2,true)
        call SaveInteger(HH, GetHandleId(u) ,StringHash("BonusAGI"),LoadInteger(HH, GetHandleId(u) ,StringHash("BonusAGI"))+1)
        call SetHeroAgi(u,GetHeroAgi(u,false)+1,true)
    endif
    call SlowUnit(u,c,0.5,0.,5,2,false)
    call SetUnitTimeScale(u,1)
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(h,id)
    endif
    set p=null
    set u=null
    set c=null
    set t=null
endfunction
function EKiyoCast3 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit c=LoadUnitHandle(h,id,1)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetUnitX(c)
    local real y1=GetUnitY(c)
    local real a=LoadReal(h,id,4)
    local real he=LoadReal(h,id,3)
    local real time=LoadReal(h,id,2)+0.03
    local real f=GetUnitFacing(u)
    local real dmg=GetHeroStr(u,true)*(3+GetUnitAbilityLevel(u,'Ao7E'))
    local player p=GetOwningPlayer(u)
    if time<0.3 and UnitIsAlive(u)==true and UnitIsAlive(c)==true then
    set x=x+(50-time*130)*Cos(a)
    set y=y+(50-time*130)*Sin(a)
    call SetUnitFlyHeight(u,ParabolaZ2(120,250,10,LoadReal(h,id,5),time*600),0)
    call SetUnitXY_1(u,x,y, false)
    call SaveReal(h,id,2,time)
    if GetUnitFlyHeight(u)<100 then
    set EFF=AddSpecialEffect("nitu.mdx",x,y)
    call SetSpecialEffectScale(EFF , 1.2)
    call SetSpecialEffectFacing(EFF , a*bj_RADTODEG)
    call SetSpecialEffectAlphaTimed(EFF , 255,255,255,75, 2)
    call RemoveEffect(EFF,0.2,true,CreateTimer())
    endif
    elseif time>=0.3 and time<0.5 and UnitIsAlive(u)==true and UnitIsAlive(c)==true then
    call SaveReal(h,id,2,time)
    call SetUnitFlyHeight(u,GetUnitFlyHeight(u)+time*80,0)
    if time>0.31 and time<=0.33 then 
    call SetUnitTimeScale(u,1.8)
    call SetUnitAnimation(u,"Attack Slam")
    call SaveReal(h,id,5,250)
    endif
    if time>0.46 and UnitIsAlive(u)==true and UnitIsAlive(c)==true then
    set EFF=AddSpecialEffect("war3mapImported\\dash sfx.mdl", x1,y1)
    call SetSpecialEffectScale(EFF , 0.8)
    call SetSpecialEffectFacing(EFF , a  * bj_RADTODEG-180)
    call SetSpecialEffectZ(EFF , 280)
    call RemoveEffect(EFF,0.4,true,CreateTimer())
    call SetUnitTimeScale(u,1.2)
    endif
    elseif SR(x,y,x1,y1)>((time-0.2)*100) and time>=0.5 and time<1.5 and UnitIsAlive(u)==true and UnitIsAlive(c)==true then
    set x=x+((time-0.3)*110)*Cos(a-180*bj_DEGTORAD)
    set y=y+((time-0.3)*110)*Sin(a-180*bj_DEGTORAD)
    call SetUnitFlyHeight(u,ParabolaZ2(260,180,210,LoadReal(h,id,5),(time-0.5)*400),0)
    call SaveReal(h,id,2,time)
    call SetUnitXY_1(u,x,y, false)
    call SetUnitFacingInstant(u,a*bj_RADTODEG-180)
    else
    call UnitRemoveAbilityTimed(u,'A2GN',0.2)
    call SaveReal(h,id,5,1000)
    call SetUnitX(u,x1)
    call SetUnitY(u,y1)
    call SetUnitX(c,x1+70*Cos(a-180*bj_DEGTORAD))
    call SetUnitY(c,y1+70*Sin(a-180*bj_DEGTORAD))
    call Push5(c,90,a-180*bj_DEGTORAD,900,"")
    call SaveReal(h,id,2,0)
    call PauseTimer(t)
    call TimerStart(t,0.03,true,function EKiyoCast4)
    endif
    set p=null
    set u=null
    set c=null
    set t=null
endfunction
function EKiyoCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit c=LoadUnitHandle(h,id,1)
    //local unit l__d=LoadUnitHandle(h,id,12)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetUnitX(c)
    local real y1=GetUnitY(c)
    local real a=Atan2(y1-y,x1-x)
    local real time=LoadReal(h,id,2)+0.03
    local real f=GetUnitFacing(u)
    local player p=GetOwningPlayer(u)
    if time==0.03 then
        call SetUnitAnimationByIndex(u,18)
    endif
    if SR(x,y,x1,y1)>150 and UnitIsAlive(u)==true and UnitIsAlive(c)==true and time<3 then
    set x=x+90*Cos(a)
    set y=y+90*Sin(a)
    call SetUnitFacingInstant(u,a*bj_RADTODEG)
    call SetUnitFlyHeight(u,ParabolaZ2(0,120,350,LoadReal(h,id,5),SR(x,y,x1,y1)),0)
    call SetUnitXY_1(u,x,y, false)
    //call SetUnitX(l__d,x)
    //call SetUnitY(l__d,y)
    call SaveReal(h,id,2,time)
    //call SetUnitFacing(l__d,a*bj_RADTODEG)
    if GetUnitFlyHeight(u)<100 then
    set EFF=AddSpecialEffect("nitu.mdx",x,y)
    call SetSpecialEffectScale(EFF , 1.2)
    call SetSpecialEffectFacing(EFF , a*bj_RADTODEG)
    call SetSpecialEffectAlphaTimed(EFF , 255,255,255,75, 2)
    call RemoveEffect(EFF,0.2,true,CreateTimer())
    endif
    else
        if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
            if time>=3 then
                set x=x1-90*Cos(a)
                set y=y1-90*Sin(a)
                call SetUnitXY_1(u,x,y, false)
            endif
            call SaveReal(h,id,2,0)
            call SaveReal(h,id,3,GetUnitFlyHeight(u))
            call SaveReal(h,id,4,a)
            call SaveReal(h,id,5,300)
            //call UnitRemoveAbility(l__d,'ore2')
            //call SetUnitTimeScale(l__d,1)
            //call SetUnitAnimationByIndex(l__d,25)
            call PauseTimer(t)
            call TimerStart(t,0.03,true,function EKiyoCast3)
        else
            call PauseUnit(u,false)
            call PauseUnit(c,false)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
            call SetUnitInvulnerable(u,false)
            call SetUnitInvulnerable(c,false)
            call UnitRemoveAbility(u,'A2GN')
            call SetUnitVertexColor(u,255,255,255,255)
            call SetUnitTimeScale(u,1)
            call PauseTimer(t)
            call SetUnitFlyHeight(u,0,0)
            call DestroyTimer(t)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
            call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
            call FlushChildHashtable(h,id)
        endif
    endif
    //set l__d=null
    set p=null
    set u=null
    set c=null
    set t=null
endfunction
function EKiyoCast takes nothing returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local unit u=GetTriggerUnit()
    local unit c=GetSpellTargetUnit()
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetUnitX(c)
    local real y1=GetUnitY(c)
    local real f=GetUnitFacing(u)
