call SaveReal(h,id,7,y1)
call SaveReal(h,id,9,0)
call SaveReal(h,id,11,1000)
call SaveReal(h,id,4,SR(x,y,x1,y1))
call SaveReal(h,id,5,0.1)
call SaveGroupHandle(h,id,10,CreateGroup())
