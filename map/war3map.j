function PartisanCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local group g=CreateGroup()
local real r=GetRandomReal(0,7)
local real l__d=GetRandomReal(-400,400)
local real l__s=GetRandomReal(75,200)
local real dmg=((3+GetUnitAbilityLevel(u,'A0KW'))*GetHeroInt(u,true))/8+15
local integer i=0
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
loop
exitwhen i>=8
set n=CreateUnit(p,'e0GE',x+l__d*Cos(r),y+l__d*Sin(r),a*bj_RADTODEG)
set r=GetRandomReal(0,7)
set l__d=GetRandomReal(-400,400)
set l__s=GetRandomReal(75,200)
call SetUnitFlyHeight(n,l__s,0)
call GroupAddUnit(g,n)
set i=i+1
endloop
call SetUnitInvulnerable(u,true)
call PauseUnit(u,true)
set n=CreateUnit(p,'e0GI',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,0.5)
set n=CreateUnit(p,'e0GG',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,0.5)
set n=CreateUnit(p,'e0GH',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,1)
set n=CreateUnit(p,'e0GF',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitTimeScale(n,0.25)
set soundplay=SndN(1473) // Sound\Music\mp3Music\AokijiPartisan.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveGroupHandle(h,id,2,g)
call TimerStart(t,2,false,function PartisanCast2)
set t=null
set u=null
set p=null
set g=null
set c=null
endfunction
