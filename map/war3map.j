        exitwhen i>8
            if GetFrameGridFrame(DebuffFrameGrid, 0, i)==null then
                call SetFrameGridFrame( DebuffFrameGrid, 0, i, GetFrameGridFrame(DebuffFrameGrid, 0, i+1) )
            endif
            set i=i+1
        endloop
    endif
endif
