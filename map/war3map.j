function DanzoFAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local real time=LoadReal(HH,id,5)
local real time1=LoadReal(HH,id,6)
local real DanzoIzanagiDuration=LoadReal(HH,GetHandleId(caster),StringHash("DanzoF"))
local boolean DanzoIzanagiAct=LoadBoolean(HH,GetHandleId(caster),StringHash("DanzoFBool"))
local boolean DanzoIzanagiDie=LoadBoolean(HH,GetHandleId(caster),StringHash("DanzoFDie"))
if DanzoIzanagiDie==true then
call SaveBoolean(HH,GetHandleId(caster),StringHash("DanzoFDie"),false)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call IzanagiDie(caster)
endif
if IsUnitPaused(caster)==false then
set time=time+0.02
set time1=time1+0.02
if DanzoIzanagiDuration==36 or DanzoIzanagiDuration==32 or DanzoIzanagiDuration==28 or DanzoIzanagiDuration==24 or DanzoIzanagiDuration==20 or DanzoIzanagiDuration==16 or DanzoIzanagiDuration==12 or DanzoIzanagiDuration==6 or DanzoIzanagiDuration==4 or DanzoIzanagiDuration==40 then
if GetUnitState(caster,UNIT_STATE_MANA)>GetUnitState(caster,UNIT_STATE_MAX_MANA)*0.07 then
call SetUnitState(caster,UNIT_STATE_MANA,GetUnitState(caster,UNIT_STATE_MANA)-GetUnitState(caster,UNIT_STATE_MAX_MANA)*0.07)
else
call UnitRemoveAbility(caster,'BDSF')
call IssueImmediateOrder(caster,"manashieldoff")
endif
endif
if DanzoIzanagiDuration==36 or DanzoIzanagiDuration==32 or DanzoIzanagiDuration==28 or DanzoIzanagiDuration==24 or DanzoIzanagiDuration==20 or DanzoIzanagiDuration==16 or DanzoIzanagiDuration==12 or DanzoIzanagiDuration==6 or DanzoIzanagiDuration==4 or DanzoIzanagiDuration==0 then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\DanzoF1.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call SaveReal(HH,GetHandleId(caster),StringHash("DanzoFHPNew"),GetUnitState(caster,UNIT_STATE_LIFE))
call HealTextTag(caster,caster,(LoadReal(HH,GetHandleId(caster),StringHash("DanzoFHP"))-GetUnitState(caster,UNIT_STATE_LIFE))*myCustomHeal2(caster,1),"HealthRes")
call SetUnitState(caster,UNIT_STATE_LIFE,LoadReal(HH,GetHandleId(caster),StringHash("DanzoFHP")))
endif
set DanzoIzanagiDuration=DanzoIzanagiDuration-0.02
call SaveReal(HH,GetHandleId(caster),StringHash("DanzoF"),DanzoIzanagiDuration)
if time1==1 then
set time1=0
endif
call SaveReal(HH,id,6,time1)
if GetUnitAbilityLevel(caster,'BDSF')==0 then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\DanzoFOff.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call UnitCreateAndMove(caster,'ds26',caster,GetUnitFacing(caster),1,1,0.8,100,100,100,60,100,caster,0,GetUnitFacing(caster))
call UnitCreateAndMove(caster,'ds27',caster,GetUnitFacing(caster),1,0.8,0.6,100,100,100,60,0,caster,0,GetUnitFacing(caster))
call UnitCreateAndMove(caster,'ds04',caster,GetUnitFacing(caster),1,0.6,1,100,100,100,70,0,caster,0,GetUnitFacing(caster))
call AddUnitAnimationProperties(caster,"alternate",false)
set DanzoIzanagiDuration=R2I(DanzoIzanagiDuration*0.2)*5+4
call SaveBoolean(HH,GetHandleId(caster),StringHash("DanzoFBool"),false)
call SaveReal(HH,GetHandleId(caster),StringHash("DanzoF"),DanzoIzanagiDuration)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
if DanzoIzanagiDuration<=0 then
call UnitCreateAndMove(caster,'ds26',caster,GetUnitFacing(caster),1,1,0.8,100,100,100,60,100,caster,0,GetUnitFacing(caster))
call UnitCreateAndMove(caster,'ds27',caster,GetUnitFacing(caster),1,0.8,0.6,100,100,100,60,0,caster,0,GetUnitFacing(caster))
call UnitCreateAndMove(caster,'ds04',caster,GetUnitFacing(caster),1,0.6,1,100,100,100,70,0,caster,0,GetUnitFacing(caster))
call AddUnitAnimationProperties(caster,"alternate",false)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\DanzoIzanagi.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call IssueImmediateOrder(caster,"manashieldoff")
call SaveBoolean(HH,GetHandleId(caster),StringHash("DanzoFBool"),false)
call SaveReal(HH,GetHandleId(caster),StringHash("DanzoF"),0)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
endif
call SaveReal(HH,id,5,time)
set t=null
set caster=null
endfunction


function DanzoGAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real x0=GetUnitX(caster)
local real y0=GetUnitY(caster)
local real damage=LoadReal(HH,id,15)
set time=time+0.02
call SaveReal(HH,id,5,time)
if time<1 then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call GroupClear(G)
call GroupEnumUnitsInRange(G,x0,y0,350,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if SR(GetUnitX(n0),GetUnitY(n0),x0,y0)>150 and Condition_Base(GetOwningPlayer(caster),n0) then
call MoveUnit(n0,n0,10,Angle2(GetUnitX(n0),GetUnitY(n0),x0,y0))
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
endif
if time==0.02 then
set n0=CreateUnit(GetOwningPlayer(caster),'ds01',GetUnitX(caster),GetUnitY(caster),facing)
call UnitSize(n0,1,1,1)
call SetUnitAnimationByIndex(n0,0)
call MoveUnit(n0,n0,75,facing+90)
call SetUnitFlyHeight(n0,100,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=null
call UnitSpeed(caster,1)
if LoadBoolean(HH,GetHandleId(caster),StringHash("DanzoFBool"))==true then
call SetUnitAnimationByIndex(caster,26)
else
call SetUnitAnimationByIndex(caster,25)
endif
endif
if time==0.02 or time==0.2 or time==0.4 or time==0.6 then
call UnitCreateAndMove(caster,'ds30',caster,GetRandomReal(0,360),1,1.25,0.5,100,100,100,50,0,caster,0,facing)
endif
if time==1 then
call SetUnitAnimationByIndex(caster,7)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
call SetUnitPathing(caster,true)
call UnitCreateAndMove(caster,'ds26',caster,GetRandomReal(0,360),1,1.5,0.75,100,100,100,0,0,caster,0,facing)
call UnitCreateAndMove(caster,'ds03',caster,GetRandomReal(0,360),1,2,0.8,100,100,100,0,0,caster,0,facing)
call UnitCreateAndMove(caster,'ds29',caster,GetRandomReal(0,360),1,1.5,0.8,100,100,100,30,0,caster,0,facing)
call GroupClear(G)
call GroupEnumUnitsInRange(G,x0,y0,350,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if Condition_Base(GetOwningPlayer(caster),n0) then

call myCustomDamage(caster,n0,damage,false,false,null,null,null)

endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
endif
if time>1 then
set x0=GetUnitX(LoadUnitHandle(HH,id,20))
set y0=GetUnitY(LoadUnitHandle(HH,id,20))
call GroupClear(G)
call GroupEnumUnitsInRange(G,x0,y0,200,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
set facing=Angle2(x0,y0,GetUnitX(n0),GetUnitY(n0))
if Condition_Base(GetOwningPlayer(caster),n0) then
if SR(x0,y0,GetUnitX(n0),GetUnitY(n0))<250 then
if SR(x0,y0,GetUnitX(n0),GetUnitY(n0))>150 then
call MoveAoe1(x0,y0,n0,150,facing)
endif
endif
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
endif
if time==6 then
call SetUnitAnimationByIndex(LoadUnitHandle(HH,id,20),2)
call MyRemoveUnit(LoadUnitHandle(HH,id,20),1)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set t=null
set caster=null
endfunction


function DanzoQ1Act takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local unit Dummy=null
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real damage=LoadReal(HH,id,15)
local real distance
set time=time+0.02
set distance=LoadReal(HH,id,8)
call SaveReal(HH,id,5,time)
if distance==2000 then
call DestroyGroup(LoadGroupHandle(HH,id,4))
call UnitColor(LoadUnitHandle(HH,id,20),100,100,100,100)
call MyRemoveUnit(LoadUnitHandle(HH,id,20),3)
call RemoveUnit(LoadUnitHandle(HH,id,21))
call RemoveUnit(LoadUnitHandle(HH,id,22))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
else
if time==0.02 then
if LoadBoolean(HH,GetHandleId(caster),StringHash("DanzoFBool"))==true then
call SetUnitAnimationByIndex(caster,13)
else
call SetUnitAnimationByIndex(caster,24)
endif
call UnitCreateAndMove(caster,'ds32',caster,facing,0.7,1.5,0.75,100,100,100,0,0,caster,0,facing)
call UnitCreateAndMove(caster,'ds24',caster,facing,1,1,0.5,100,100,100,0,0,caster,0,facing)
endif
if time<0.3 then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
endif
if time==0.3 then
call UnitCreateAndMove(caster,'ds43',caster,facing,1,0.4,0.8,100,100,100,0,150,caster,100,facing)
call UnitCreateAndMove(caster,'ds22',caster,facing,1,0.5,0.6,100,100,100,0,100,caster,50,facing)
if GetRandomInt(1,2)==1 and GetHeroLevel(caster)>12 then
call DanzoGPassive(caster,facing,GetHeroInt(caster,true)*2)
endif
call SaveGroupHandle(HH,id,4,CreateGroup())
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
set n0=CreateUnit(GetOwningPlayer(caster),'ds41',GetUnitX(caster),GetUnitY(caster),facing)
call UnitSize(n0,0.35,1,1)
call MoveUnit(n0,n0,200,facing)
call SetUnitFlyHeight(n0,200,0)
call SaveUnitHandle(HH,id,22,n0)
set n0=CreateUnit(GetOwningPlayer(caster),'ds46',GetUnitX(caster),GetUnitY(caster),facing)
call UnitSize(n0,0.4,1,1)
call MoveUnit(n0,n0,200,facing)
call SetUnitFlyHeight(n0,220,0)
call SaveUnitHandle(HH,id,21,n0)
set n0=CreateUnit(GetOwningPlayer(caster),'ds46',GetUnitX(caster),GetUnitY(caster),facing)
call UnitSize(n0,0.4,1,1)
call MoveUnit(n0,n0,200,facing)
call SetUnitFlyHeight(n0,150,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=null
endif
if time>0.3 then
set Dummy=LoadUnitHandle(HH,id,20)
call MoveUnit(Dummy,Dummy,40,facing)
call UnitSize(Dummy,0.35+(time-0.2)*0.75,1,1)
call MoveUnit(Dummy,LoadUnitHandle(HH,id,21),0,facing)
call UnitSize(LoadUnitHandle(HH,id,21),0.4+(time-0.2)*0.75,1,1)
call MoveUnit(Dummy,LoadUnitHandle(HH,id,22),-50,facing)
call UnitSize(LoadUnitHandle(HH,id,22),0.4+(time-0.2)*0.75,1,1)
call SaveReal(HH,id,8,distance+40)
call DamageAoeOneTime3DanzoQ(caster,GetUnitX(Dummy),GetUnitY(Dummy),200+(time-0.3)*300,damage,LoadGroupHandle(HH,id,4),R2I((1.35-time)*25),10,facing)
endif
endif
set t=null
set Dummy=null
set caster=null
endfunction
function DanzoTQPush takes nothing returns nothing
