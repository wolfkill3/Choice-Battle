function UFastStrikeCond takes nothing returns boolean
return GetSpellAbilityId()=='A0RV' and udg_B==true
endfunction
function UFastStrikeCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit c=LoadUnitHandle(h,id,1)
    local real x=LoadReal(h,id,2)
    local real y=LoadReal(h,id,3)
    local real x1=GetUnitX(c)
    local real y1=GetUnitY(c)
    local real a=LoadReal(h,id,4)
    local player p=GetOwningPlayer(u)
    local real dist=LoadReal(h,id,100)
    local boolean mod = GetUnitTypeId(u)=='H04J'
    if dist<1000 then
        call PauseUnit(u,true)
        call PauseUnit(c,true)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
        call SetUnitX(c,x1+35*Cos(a))
        call SetUnitY(c,y1+35*Sin(a))
        call SaveReal(h,id,100,dist+25)
        call DestroyEffect(AddSpecialEffect("war3mapImported\\EarthSmash.mdx",x1,y1))
        call SetUnitXY_1(u,x1,y1, false)
        call SetUnitFacing(u,a*bj_RADTODEG)
        if mod==false then
            call SetUnitAnimation(u,"attack")
        endif
        set n=CreateUnit(p,'e0H9',x1,y1,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',0.7)
        call SetUnitVertexColor(n,200,200,200,70)
    else
        call SetUnitTimeScale(u,1)
        call PauseUnit(u,false)
        if mod then
            call SetUnitAnimationByIndex(u, 21)
        else
            call SetUnitAnimation(u,"attack")
        endif
        call Push(c,50,a,650)
        call UnitApplyTimedLife(CreateUnit(p,'e0QA',x1,y1,a*bj_RADTODEG),'BTLF',3)
        call UnitApplyTimedLife(CreateUnit(p,'e0QC',x1,y1,a*bj_RADTODEG),'BTLF',3)
        set n=CreateUnit(p,0x65305142,x1,y1,a*bj_RADTODEG)
        call UnitApplyTimedLife(n,'BTLF',3)
        call SetUnitTimeScale(n,2.3)
        set n=CreateUnit(p,'d019',x1+200*Cos(a),y1+200*Sin(a),a*bj_RADTODEG)
        call SetUnitTimeScale(n, 0.8)
        call SetUnitFlyHeight(n, 200, 0) 
        call SetUnitScale(n, 1+B2I_ExD(mod)*0.6, 1+B2I_ExD(mod)*0.6, 1+B2I_ExD(mod)*0.6)
        call MyRemoveUnit(n, 1.5)
        call ShakeCamera(0.1, 10)
        if mod then
            set n=CreateUnit(p,'d019',x1+200*Cos(a),y1+200*Sin(a), GetRandomInt(0, 360))
            call SetUnitTimeScale(n, 0.8)
            call SetUnitFlyHeight(n, 200, 0) 
            call SetUnitScale(n, 1.5, 1.5, 1.5)
            call MyRemoveUnit(n, 1.5)
        endif
        call PauseUnit(c,false)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
        call myCustomDamage(u,c,(3+GetUnitAbilityLevel(u,'A0RV'))*GetHeroAgi(u,true),false,false,null,null,null)
        call SetControlToUnit(u,c,3, "stun")
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
    endif
    set p=null
    set u=null
    set c=null
    set t=null
endfunction

function UFastStrike_WaitTime takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=LoadReal(h,id,4)
local player p=GetOwningPlayer(u)
local real dist=LoadReal(h,id,100)
local boolean mod = GetUnitTypeId(u)=='H04J'
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
    set n=CreateUnit(p, 'dH18', x, y, a*bj_RADTODEG)
    call MyRemoveUnit(n, 1.5)
    set n=CreateUnit(p, 'dM04', x, y, a*bj_RADTODEG)
    call SetUnitTimeScale(n, 0.7)
    call MyRemoveUnit(n, 1.5)
    set n=CreateUnit(p, 'dM20', x, y, a*bj_RADTODEG)
    call SetUnitTimeScale(n, 0.8)
    call SetUnitScale(n, 1.2, 1.2, 1.2)
    call MyRemoveUnit(n, 1.5)

    set n=CreateUnit(p, 'dM06', x1, y1, a*bj_RADTODEG)
    call SetUnitTimeScale(n, 0.8)
    call MyRemoveUnit(n, 1.5)
    if mod then
        call SetUnitScale(n, 1.7, 1.7, 1.7)
        call ShakeCamera(0.1, 10)
        call UnitApplyTimedLife(CreateUnit(p,'e0QA',x1,y1,a*bj_RADTODEG),'BTLF',3)
        call UnitApplyTimedLife(CreateUnit(p,'e0QC',x1,y1,a*bj_RADTODEG),'BTLF',3)
        call SetUnitAnimationByIndex(u, 20)
        call SetUnitTimeScale(u, 1.0)
        set n=CreateUnit(p, 'd014', x, y, AU(u, c)*bj_RADTODEG)
        call MyRemoveUnit(n, 1.5)
    else
        call SetUnitScale(n, 1.2, 1.2, 1.2)
        call ShakeCamera(0.1, 5)
        call SetUnitTimeScale(u, 2.0)
    endif
    call SetUnitInvulnerable(u, false)
    call PauseUnit(c,true)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
    call SetUnitXY_1(u,x1,y1, false)
    call TimerStart(t,0.03,true,function UFastStrikeCast2)
else
    set n=CreateUnit(p, 'dH18', x, y, a*bj_RADTODEG)
    call MyRemoveUnit(n, 1.5)
    set n=CreateUnit(p, 'dM04', x, y, a*bj_RADTODEG)
    call SetUnitTimeScale(n, 0.7)
    call MyRemoveUnit(n, 1.5)
    set n=CreateUnit(p, 'dM20', x, y, a*bj_RADTODEG)
    call SetUnitTimeScale(n, 0.8)
    call SetUnitScale(n, 1.2, 1.2, 1.2)
    call MyRemoveUnit(n, 1.5)

    set n=CreateUnit(p, 'dM06', x1, y1, a*bj_RADTODEG)
    call SetUnitTimeScale(n, 0.8)
    call MyRemoveUnit(n, 1.5)
    call SetUnitTimeScale(u,1)
    call SetUnitXY_1(u,x1,y1, false)
    call PauseUnit(u,false)
    call SetUnitInvulnerable(u,false)
    call PauseUnit(c,false)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
    call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
    call PauseTimer(t)
    call DestroyTimer(t)
    call SetUnitVertexColor(u,255,255,255,255)
    call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set c=null
set t=null
endfunction

function UFastStrikeCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real f=GetUnitFacing(u)
local boolean mod = GetUnitTypeId(u)=='H04J'
set n=CreateUnit(p, 'dH18', x, y, AU(u, c)*bj_RADTODEG)
call MyRemoveUnit(n, 1.5)
call PauseUnit(u,true)
call SetUnitInvulnerable(u, true)
if mod then
        call SetUnitAnimationByIndex(u, 10)
        call SetUnitTimeScale(u, 1.2)
else
        call SetUnitAnimationByIndex(u, 2)
endif
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveReal(h,id,2,x1)
call SaveReal(h,id,3,y1)
call SaveReal(h,id,4,Atan2(y1-y,x1-x))
call SaveReal(h,id,100,0)
set soundplay=SndN(1956) // Sound\Music\mp3Music\UlquiorraE.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.2,false,function UFastStrike_WaitTime)
set t=null
set u=null
set p=null
set c=null
endfunction
function InitTrig_UFastStrike takes nothing returns nothing
set gg_trg_UFastStrike=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_UFastStrike,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_UFastStrike,Condition(function UFastStrikeCond))
call TriggerAddAction(gg_trg_UFastStrike,function UFastStrikeCast)
endfunction
function LanzoDelRampagoCond takes nothing returns boolean
return GetSpellAbilityId()=='A0RU' and udg_B==true
endfunction
function LanzoDelRampagoCast2 takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(h,id,0)
        local unit l__d=LoadUnitHandle(h,id,1)
        local player p=GetOwningPlayer(u)
        local integer idu=GetPlayerId(p)
        local real x=LoadReal(h,id,3)
        local real y=LoadReal(h,id,4)
        local real x1=GetUnitX(l__d)
        local real y1=GetUnitY(l__d)
        local real f=GetUnitFacing(l__d)
        local real a=LoadReal(h,id,8)
        local real dmg=GetHeroAgi(u,true)*12
        local real Range=LoadReal(h,id,9)
        local real speed=LoadReal(h,id,11)
        local integer i=0
        if Range<4000 and UnitIsAlive(l__d)then
                set x1=x1+speed*Cos(a)
                set y1=y1+speed*Sin(a)
                // if Range>1000 then
                        // set a=a*GetRandomReal(0.95, 1.05)
                        // call SaveReal(h, id, 8, a)
                // endif
                call SetUnitXY_1(l__d,x1,y1, false)
                call SaveReal(h,id,3,x1)
                call SaveReal(h,id,4,y1)
                call SetUnitFacing(l__d,a*bj_RADTODEG)
                call SaveReal(h,id,9,Range+speed)
                call SaveReal(h,id,11,speed+1)
                call GroupEnumUnitsInRange(DG,x1,y1,140,Base)
                loop
                set E=FirstOfGroup(DG)
                exitwhen E==null
                        if Condition_Base(p,E)then
                                call RemoveUnit(l__d)
                        endif
                call GroupRemoveUnit(DG,E)
                endloop
        else
                call ShakeCamera(0.1, 15)
                call GroupEnumUnitsInRange(DG,x,y,800,Base)
                loop
                set E=FirstOfGroup(DG)
                exitwhen E==null
                        if Condition_Base(p,E)then
                                call myCustomDamage(u,E,dmg,false,false,null,null,null)
                        endif
                call GroupRemoveUnit(DG,E)
                endloop
                call UnitApplyTimedLife(CreateUnit(p,0x65305138,x,y,GetRandomReal(0,359)),'BTLF',3)
                call UnitApplyTimedLife(CreateUnit(p,0x65305139,x,y,GetRandomReal(0,359)),'BTLF',3)
                call RemoveUnit(l__d)
                call FlushChildHashtable(h,id)
                call PauseTimer(t)
                call DestroyTimer(t)
        endif
        set u=null
        set p=null
        set t=null
        set l__d=null
endfunction

function UlquiorraT_WaitTimer takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(h,id,0)
        local player p=GetOwningPlayer(u)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        local real a=LoadReal(h,id,8)
        local integer time=LoadInteger(h, id, 20)
        call SaveInteger(h, id, 20, time+1)
        if time==1 then
                call ShakeCamera(0.1, 5)
                call SaveReal(h, id, 8, a)
                call SetUnitFacing(u, a*bj_RADTODEG)
                call SetUnitAnimationByIndex(u, 16)
                call SetUnitTimeScale(u, 1.0)
                set soundplay=SndN(1958) // Sound\Music\mp3Music\LanzaDelRelampagoThrow.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        elseif time==2 then
                set n=CreateUnit(GetOwningPlayer(u),'dM04',x,y,a*bj_RADTODEG)
                call SetUnitTimeScale(n, 0.8)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(u),'dM11',x,y,a*bj_RADTODEG)
                call SetUnitVertexColor(n, 0, 255, 175, 200)
                call MyRemoveUnit(n, 1.5)
                call ShakeCamera(0.1, 10)
                set n=CreateUnit(GetOwningPlayer(u),'e0Q7',x,y,a*bj_RADTODEG)
                call SaveUnitHandle(h,id,1,n)
                call PauseUnit(u, false)
                call SetUnitInvulnerable(u, false)
                call PauseTimer(t)
                call TimerStart(t,0.02,true,function LanzoDelRampagoCast2)
        endif
        set t=null
        set u=null
        set p=null
endfunction

function CastLanzoDelRampago takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
set n=CreateUnit(p, 'dM30', x, y, GetRandomInt(0, 360))
call SetUnitVertexColor(n, 0, 255, 175, 255)
call MyRemoveUnit(n, 1.5)
set n=CreateUnit(p, 'dM30', x, y, GetRandomInt(0, 360))
call SetUnitVertexColor(n, 0, 255, 175, 255)
call SetUnitScale(n, 1.5, 1.5, 1.5)
call MyRemoveUnit(n, 1.5)
set n=CreateUnit(p, 'dM32', x, y, GetRandomInt(0, 360))
call SetUnitVertexColor(n, 255, 255, 255, 100)
call UnitScale(n, 0.5, 1.7, 0.5)
call UnitApplyTimedLife(n,'BTLF', 1.0)
call MyRemoveUnit(n, 1.5)
call PauseUnit(u, true)
call SetUnitInvulnerable(u, true)
call SetUnitAnimationByIndex(u, 15)
call SetUnitTimeScale(u, 1.25)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,8,a)
call SaveReal(h,id,11,50)
call RemoveEffect(AddSpecialEffectTarget("war3mapImported\\UlkiorraSpear.mdl", u, "right hand"), 0.8, true, CreateTimer())
call TimerStart(t,0.1,true,function UlquiorraT_WaitTimer)
set u=null
set p=null
set t=null
endfunction
function InitTrig_LanzoDelRampago takes nothing returns nothing
set gg_trg_LanzoDelRampago=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_LanzoDelRampago,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_LanzoDelRampago,Condition(function LanzoDelRampagoCond))
call TriggerAddAction(gg_trg_LanzoDelRampago,function CastLanzoDelRampago)
endfunction


function IchigoVaster_OvertimeForm_Periodic takes nothing returns nothing
    local timer t               =GetExpiredTimer()
    local integer id            =GetHandleId(t)
    local unit caster           =LoadUnitHandle(HH, id, c_CASTER)
    local player p              =LoadPlayerHandle(HH, id, c_PLAYER)
    local integer idp           =GetHandleId(p)
    local string mode_name      =LoadStr(HH, id, c_NAME)
    local framehandle NewFrame  =LoadFrameHandle(HH, idp,StringHash(mode_name))
    local real duration         =LoadReal(HH, GetHandleId(NewFrame), c_DURATION)-0.05
    local integer position         =LoadInteger(HH, id, c_POSITION)
    if position>0 then
        if LoadBoolean(HH,idp,position-1)==false then
        call SaveBoolean(HH,idp,position-1,true)
        call SaveBoolean(HH,idp,position,false)
        call SaveInteger(HH, id, c_POSITION,position-1)
        set position=position-1
        endif
    endif
    if IsUnitPaused(caster)==false and IsUnitHidden(caster)==false and GetUnitAbilityLevel(caster,'Pet1')==0 then
        call SaveReal           (HH, GetHandleId(NewFrame), c_DURATION, duration)
        call StatusIndicatorText(NewFrame, idp, mode_name, duration)
    endif
    call StatusIndicatorPlace(NewFrame, position)
    if duration<=0 or udg_B==false or DU2==false or UnitIsAlive(caster)==false then
        if udg_B and UnitIsAlive(caster) then
			call PauseUnit(caster, false)
			call ShowAbility2('IcQ1', true)
			call ShowAbility2('IcW1', true)
			call ShowAbility2('IcE1', true)
			call ShowAbility2('IcR1', true)
			call ShowAbility2('IcT1', true)
			call UnitAddAbility(caster, 'IcT7')
			call IssueImmediateOrder(caster, "bearform")
			call UnitRemoveAbility(caster, 'IcT7')
            call CheckUnitBonusRange(caster)
            call SetHeroAgi(caster,GetHeroAgi(caster,false)-20,true)
            call SetHeroStr(caster,GetHeroStr(caster,false)-20,true)
		endif
        call ShowFrame( NewFrame, false )
        call SaveReal(HH, GetHandleId(NewFrame), c_DURATION, 0)
        call SaveReal(HH, GetHandleId(LoadFrameHandle(HH, idp,StringHash(mode_name+"2"))), c_DURATION, 0)
        call SaveBoolean(HH,idp,position,false)
        call FlushChildHashtable(HH, id)
        call DestroyTimer(t)
    endif
    set t=null
    set caster=null
    set NewFrame=null
    set p=null
endfunction

function IchigoVaster_OvertimeForm takes unit newCaster, string newString, real newDur returns nothing
        local timer newTimer        = CreateTimer()
        local integer id            = GetHandleId(newTimer)
    local framehandle NewFrame  = null
    local framehandle NewFrameText  = null
    local player p              =GetOwningPlayer(newCaster)
    local integer idp           =GetHandleId(p)    
    local integer i=23
    local integer j=0
    if LoadFrameHandle(HH, idp,StringHash(newString))==null then    
        set NewFrame = CreateFrameByType( "SIMPLEBUTTON", newString, StatusBarFrame, "", 0 )
        call ClearFrameAllPoints( NewFrame )
        call SetFrameTexture( NewFrame, newString, 0, true )
        call SetFrameTexture( NewFrame, newString, 1, true )
        call SetFrameTexture( NewFrame, newString, 2, true )
        call SetFrameSize( NewFrame, .019, .019 )
        call SetFramePriority( NewFrame, 7 )
        call HandleListAddHandle(StatusBarFrameList[GetPlayerId(p)],NewFrame)
        call SetFrameParent(NewFrame,StatusBarFrame)
        call ShowFrame( NewFrame, GetOwningPlayer(GetUnitSelected(GetLocalPlayer()))==GetOwningPlayer(newCaster) and (IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(newCaster)) or GetPlayerId(GetLocalPlayer())==10 or GetPlayerId(GetLocalPlayer())==11))
        call ShowFrame( NewFrameText, GetOwningPlayer(GetUnitSelected(GetLocalPlayer()))==GetOwningPlayer(newCaster) and (IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(newCaster)) or GetPlayerId(GetLocalPlayer())==10 or GetPlayerId(GetLocalPlayer())==11))
        call SaveFrameHandle(HH,idp,StringHash(newString),NewFrame)
        call StatusIndicatorTooltip(NewFrame, newString)
        //call SaveReal               (HH, GetHandleId(NewFrame), c_DURATION, 2)
        
        set NewFrameText=CreateFrameByType( "SIMPLETEXT", newString+"1", NewFrame, "", 0 )
        call ClearFrameAllPoints( NewFrameText )
        call SetFrameBlendMode( NewFrameText, 0, BLEND_MODE_BLEND )
        call SetFrameFont( NewFrameText, "Fonts\\FRIZQT__.TTF", .008, 0 )
        call SetFrameTextAlignment( NewFrameText, TEXT_JUSTIFY_CENTER, TEXT_JUSTIFY_LEFT )
        call SetFrameText( NewFrameText, R2SW(newDur,2, 1) )
        call SetFrameTextColour( NewFrameText, 0xFFFFA500 )
        call HandleListAddHandle(StatusBarFrameList[GetPlayerId(p)],NewFrameText)
        call ShowFrame( NewFrameText, GetOwningPlayer(GetUnitSelected(GetLocalPlayer()))==GetOwningPlayer(newCaster) and (IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(newCaster)) or GetPlayerId(GetLocalPlayer())==10 or GetPlayerId(GetLocalPlayer())==11))
        call SaveFrameHandle(HH,idp,StringHash(newString+"2"),NewFrameText)
    else
        if LoadReal(HH, GetHandleId(NewFrame), c_DURATION)<=0 then
            set NewFrame=LoadFrameHandle(HH, idp,StringHash(newString))
            set NewFrameText=LoadFrameHandle(HH, idp,StringHash(newString+"2"))
            call SetFrameText( NewFrameText, R2SW(newDur,2, 1) )
            call ShowFrame( NewFrame, GetOwningPlayer(GetUnitSelected(GetLocalPlayer()))==GetOwningPlayer(newCaster) and (IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(newCaster)) or GetPlayerId(GetLocalPlayer())==10 or GetPlayerId(GetLocalPlayer())==11))
            call ShowFrame( NewFrameText, GetOwningPlayer(GetUnitSelected(GetLocalPlayer()))==GetOwningPlayer(newCaster) and (IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(newCaster)) or GetPlayerId(GetLocalPlayer())==10 or GetPlayerId(GetLocalPlayer())==11))
        endif
    endif
    if LoadReal(HH, GetHandleId(NewFrame), c_DURATION)<=0 then
        loop
            exitwhen i==0
            if LoadBoolean(HH,idp,i)==false then
            call SaveBoolean(HH,idp,i,true)
            call SaveBoolean(HH,idp,i+1,false)
            set j=i
            endif
            set i=i-1
        endloop
        call SetFrameRelativePoint( NewFrame, FRAMEPOINT_CENTER, StatusBarFrame, FRAMEPOINT_LEFT, 0.017+j*0.025, 0.005 )
        call SetFrameRelativePoint( NewFrameText, FRAMEPOINT_BOTTOM, NewFrame, FRAMEPOINT_BOTTOM, .0, -.01 )
        call SaveUnitHandle         (HH, id, c_CASTER, newCaster)
        call SavePlayerHandle       (HH, id, c_PLAYER, GetOwningPlayer(newCaster))
        call SaveReal               (HH, GetHandleId(NewFrame), c_DURATION, newDur)
        call SaveReal               (HH, GetHandleId(NewFrameText), c_DURATION, newDur)
        call SaveInteger            (HH, id, c_POSITION, j)
        call SaveInteger(HH,GetHandleId(NewFrame),SB_POS,0)
        call RemoveSavedString(HH,GetHandleId(NewFrame),SB_TXT)
        call SaveStr                (HH, id, c_NAME, newString)
        call TimerStart             (newTimer, 0.05, true, function IchigoVaster_OvertimeForm_Periodic)
    else
        call SaveReal           (HH, GetHandleId(NewFrame), c_DURATION, newDur)
        call SaveReal           (HH, GetHandleId(NewFrameText), c_DURATION, newDur)
    endif
    set newTimer=null
    set p=null
    set NewFrame=null
    set NewFrameText=null
endfunction

function IchigoVaster_Ressurection takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id = GetHandleId(newTimer)
    local unit caster = LoadUnitHandle(h, id, 0)
    local unit orihime = LoadUnitHandle(h, id, 2)
    local real time   = LoadReal(h, id, 1)+0.1
    call SaveReal(h, id, 1, time)
    if time==0.2 then 
        call SetUnitAnimation(caster, "death")
    endif
	if time<7.0 and UnitIsAlive(caster) then
		call PauseUnit(caster, true)
		call SetUnitInvulnerable(caster, true)
        call HealTextTag(orihime,caster,GetWidgetMaxLife(caster)*0.0043*myCustomHeal2(caster,1),"HealthRes")
        call HealTextTag(orihime,caster,GetWidgetMaxMana(caster)*0.0043*myCustomMana2(caster,1),"ManaRes")
		call SetWidgetLife(caster, GetWidgetLife(caster)+GetWidgetMaxLife(caster)*0.0043)
		call SetWidgetMana(caster, GetWidgetMana(caster)+GetWidgetMaxMana(caster)*0.0043)
	else
		if UnitIsAlive(caster) and udg_B then
			call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectCaster.mdl", caster, "origin"))
			call PauseUnit(caster, false)
			call SetUnitInvulnerable(caster, false)
			call ShowAbility2('IcQ1', false)
			call ShowAbility2('IcW1', false)
			call ShowAbility2('IcE1', false)
			call ShowAbility2('IcR1', false)
			call ShowAbility2('IcT1', false)
            call SetHeroAgi(caster,GetHeroAgi(caster,false)+20,true)
		    call SetHeroStr(caster,GetHeroStr(caster,false)+20,true)
			call UnitAddAbility(caster, 'IcT6')
			call IssueImmediateOrder(caster, "bearform")
			call UnitRemoveAbility(caster, 'IcT6')
			call SetUnitAnimationByIndex(caster, 15)
            call IchigoVaster_OvertimeForm(caster, "war3mapImported\\BTNHollowIchigo.blp", 70)
            call CheckUnitBonusRange(caster)
        endif
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call FlushChildHashtable(h, id)
        call PauseTimer(newTimer)
        call DestroyTimer(newTimer)
    endif
    set newTimer = null
    set orihime   = null
    set caster   = null
endfunction

function OrehimeT_IchigoVaster takes unit u, unit newCaster returns nothing
        local timer newTimer = CreateTimer()
        local integer id    = GetHandleId(newTimer)
        local real caster_x = GetUnitX(newCaster)
        local real caster_y = GetUnitY(newCaster)
        local player p = GetOwningPlayer(newCaster)
        if UnitIsAlive(newCaster)==false then
                call SaveBoolean(h, id, 10, true)
                call ReviveHero(newCaster, caster_x, caster_y, false)
                call SetUnitControlCount(newCaster, 11,0)
        else
                call SaveBoolean(h, id, 10, false)
        endif
        call SetUnitState(newCaster,UNIT_STATE_LIFE,1)
        call SetUnitState(newCaster,UNIT_STATE_MANA,1)
        call HealTextTag(u,newCaster,GetWidgetMaxLife(newCaster)*0.1*myCustomHeal2(newCaster,1),"HealthRes")
        call HealTextTag(u,newCaster,GetWidgetMaxMana(newCaster)*0.2*myCustomMana2(newCaster,1),"ManaRes")
        call SetWidgetLife(newCaster, GetWidgetMaxLife(newCaster)*0.1)
        call SetWidgetMana(newCaster, GetWidgetMaxMana(newCaster)*0.2)
    call RemoveTransformation(newCaster)
        if GetUnitTypeId(newCaster)=='HIc2' then
                call SaveBoolean(HH, GetHandleId(newCaster), 9595, true)
        endif
        call SetUnitInvulnerable(newCaster, true)
        call SetUnitAnimation(newCaster, "death")
        call PauseUnit(newCaster, true)
        set n=CreateUnit(p,'e10S',caster_x,caster_y,GetUnitFacing(newCaster))
        call UnitApplyTimedLife(n,'BTLF',7)
        call SetUnitVertexColor(n,255,0,0,255)
        call SetUnitTimeScale(n,0.25)
        set n=CreateUnit(p,'e11E',caster_x,caster_y,GetUnitFacing(newCaster))
        call UnitApplyTimedLife(n,'BTLF',7)
        call SetUnitTimeScale(n,0.5)
        set n=CreateUnit(p,'e11D',caster_x,caster_y,GetUnitFacing(newCaster))
        call UnitApplyTimedLife(n,'BTLF',7)
        call SetUnitTimeScale(n,0.5)
        set n=CreateUnit(p,'e11C',caster_x,caster_y,GetUnitFacing(newCaster))
        call UnitApplyTimedLife(n,'BTLF',7)
        call SetUnitTimeScale(n,0.25)
        call UnitApplyTimedLife(CreateUnit(p,'e12A',caster_x,caster_y,GetRandomReal(0,359)),'BTLF',4)
        set soundplay=SndN(1961) // Sound\Music\mp3Music\OriSecret2.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        
        call SaveUnitHandle(h, id, 0, newCaster)
        call SaveUnitHandle(h, id, 2, u)
        call SaveReal(h, id, 1, 0.0)
        call TimerStart(newTimer, 0.1, true, function IchigoVaster_Ressurection)
        set p=null
        set newTimer=null
endfunction

function CeroOscurasCond takes nothing returns boolean
return GetSpellAbilityId()=='A0RR' and udg_B==true and GetUnitTypeId(GetTriggerUnit())=='H04J'
endfunction
function CeroOscurasCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=LoadReal(h,id,1)
local real y=LoadReal(h,id,2)
local real a=Atan2(LoadReal(h,id,4)-y,LoadReal(h,id,3)-x)
local real l__d=LoadReal(h,id,5)
local group g=LoadGroupHandle(h,id,6)
local player p=GetOwningPlayer(u)
local real dmg=(GetUnitAbilityLevel(u,'A0RR')+3)*(GetHeroAgi(u,true))+50+GetUnitAbilityLevel(u,'A0RR')*50
local real l__s=LoadReal(h,id,8)
local real speed=LoadReal(h,id,14)
if l__d<3000 then
set x=x+l__d*Cos(a)
set y=y+l__d*Sin(a)
set n=CreateUnit(p,0x65305135,x,y,(a*bj_RADTODEG))
call SetUnitScale(n,l__s,l__s,l__s)
call SaveReal(h,id,8,l__s+0.15)
call SaveReal(h,id,14,speed+1.5)
call UnitApplyTimedLife(n,'BTLF',1)
call SaveReal(h,id,5,l__d+speed)
call GroupEnumUnitsInRange(g,x,y,150+15*l__s,Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set ide=GetHandleId(E)
    if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
        call myCustomDamage(u,E,dmg,false,false,null,null,null)
        call SaveUnitHandle(h,idg,ide,E)
    endif
        call GroupRemoveUnit(g,E)
endloop
else
set idg=GetHandleId(g)
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,idg)
endif
set p=null
set u=null
set g=null
set t=null
endfunction
function CeroOscurasCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
local player p=GetOwningPlayer(u)
set x=x+75*Cos(a)
set y=y+75*Sin(a)
call UnitApplyTimedLife(CreateUnit(p,0x65305136,x,y,a*bj_RADTODEG),'BTLF',0.45)
call SaveGroupHandle(h,id,6,CreateGroup())
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,x)
call SaveReal(h,id,8,0.75)
call SaveReal(h,id,14,30)
call SaveReal(h,id,2,y)
call SaveReal(h,id,3,GetSpellTargetX())
call SaveReal(h,id,4,GetSpellTargetY())
set soundplay=SndN(1963) // Sound\Music\mp3Music\CeroOscuras.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.013,true,function CeroOscurasCast2)
set p=null
set u=null
set t=null
endfunction
function InitTrig_CeroOscuras takes nothing returns nothing
set gg_trg_CeroOscuras=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_CeroOscuras,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_CeroOscuras,Condition(function CeroOscurasCond))
call TriggerAddAction(gg_trg_CeroOscuras,function CeroOscurasCast)
endfunction
function CeroBCond takes nothing returns boolean
return GetSpellAbilityId()=='A0RR' and udg_B==true and GetUnitTypeId(GetTriggerUnit())=='H045'
endfunction
function CeroBCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=LoadReal(h,id,1)
local real y=LoadReal(h,id,2)
local real a=Atan2(LoadReal(h,id,4)-y,LoadReal(h,id,3)-x)
local real l__d=LoadReal(h,id,5)
local group g=LoadGroupHandle(h,id,6)
local player p=GetOwningPlayer(u)
local real dmg=(GetUnitAbilityLevel(u,'A0RR')+1)*(GetHeroAgi(u,true))+50+GetUnitAbilityLevel(u,'A0RR')*50
local real l__s=LoadReal(h,id,8)
local real speed=LoadReal(h,id,14)
if l__d<3000 then
set x=x+l__d*Cos(a)
set y=y+l__d*Sin(a)
set n=CreateUnit(p,0x6530544A,x,y,(a*bj_RADTODEG))
call SetUnitColor(n,PLAYER_COLOR_LIGHT_BLUE)
call SetUnitScale(n,l__s+0.5,l__s+0.5,l__s+0.5)
call SaveReal(h,id,8,l__s+0.15)
call SaveReal(h,id,14,speed+1.5)
call UnitApplyTimedLife(n,'BTLF',1)
call SaveReal(h,id,5,l__d+speed)
call GroupEnumUnitsInRange(g,x,y,150+15*l__s,Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set ide=GetHandleId(E)
        //if (GetUnitTypeId(E)=='HIc1' or GetUnitTypeId(E)=='HIc2' or GetUnitTypeId(E)=='HIc3') and dmg>GetWidgetLife(E) and GetHeroLevel(E)>=25 and E!=LoadUnitHandle(h,idg,ide)then
        //      call OrehimeT_IchigoVaster(E)
        //      call SaveUnitHandle(h,idg,ide,E)
        //else
                if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
                        call myCustomDamage(u,E,dmg,false,false,null,null,null)
                        call SaveUnitHandle(h,idg,ide,E)
                endif
        //endif
        call GroupRemoveUnit(g,E)
endloop
else
set idg=GetHandleId(g)
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,idg)
endif
set p=null
set u=null
set g=null
set t=null
endfunction
function CeroBCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
local player p=GetOwningPlayer(u)
set x=x+75*Cos(a)
set y=y+75*Sin(a)
call SaveGroupHandle(h,id,6,CreateGroup())
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,x)
call SaveReal(h,id,8,0.75)
call SaveReal(h,id,14,30)
call SaveReal(h,id,2,y)
call SaveReal(h,id,3,GetSpellTargetX())
call SaveReal(h,id,4,GetSpellTargetY())
set soundplay=SndN(1965) // Sound\Music\mp3Music\UlqCero.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.013,true,function CeroBCast2)
set p=null
set u=null
set t=null
endfunction
function InitTrig_CeroB takes nothing returns nothing
set gg_trg_CeroB=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_CeroB,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_CeroB,Condition(function CeroBCond))
call TriggerAddAction(gg_trg_CeroB,function CeroBCast)
endfunction


function LaxusD_Act2_Periodic takes nothing returns nothing
	local integer id = GetHandleId(GetExpiredTimer())
    local unit caster = LoadUnitHandle(h, id, CasterHash)
    local unit target = LoadUnitHandle(h, id, TargetHash)
	local real angle = LoadReal(h, id, AngleHash)
	local real time = LoadReal(h, id, TIME_HASH)
	local real damage = 150 + GetHeroStr(caster, true)*(GetUnitAbilityLevel(caster, 'LaxD')+2)
	local integer loop_index = 1
	if time<1 then
		call SaveReal(h, id, TIME_HASH, time+0.01)
		call SetUnitX(target, GetUnitX(target)+10*Cos(angle))
		call SetUnitY(target, GetUnitY(target)+10*Sin(angle))
		call SetUnitX(caster, GetUnitX(target)-60*Cos(angle))
		call SetUnitY(caster, GetUnitY(target)-60*Sin(angle))
        call SetUnitInvulnerable(caster, true)
        call PauseUnit(caster, true)
        call SetUnitInvulnerable(target, true)
        call PauseUnit(target, true)
        call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
		if time==0.6 then
			call UnitAddAbility(caster, 'Arav')
			call UnitRemoveAbility(caster, 'Arav')
			call SetUnitFlyHeight(caster, 600, 3000)
		endif
		if time==0.85 then
			call SetUnitFlyHeight(caster, 0, 3000)
			call SetUnitAnimationByIndex(caster, 8)
		endif
		if LoadInteger(h, id, EffectPeriodHash)==0 then
			set n=CreateUnit(GetOwningPlayer(caster),'e0QG',GetUnitX(caster), GetUnitY(caster),GetRandomReal(0,359))
			call UnitApplyTimedLife(n,'BTLF',0.01)
			call SetUnitScale(n,0.75,0.75,0.75)
			call SetUnitVertexColor(n,255,255,255,25)
			call MyRemoveUnit(n, 1)
			set n=CreateUnit(GetOwningPlayer(caster),'e0QG',GetUnitX(caster), GetUnitY(caster),GetRandomReal(0,359))
			call UnitApplyTimedLife(n,'BTLF',0.01)
			call SetUnitScale(n,1.2,1.2,1.2)
			call SetUnitVertexColor(n,255,255,255,50)
			call MyRemoveUnit(n, 1)
			set n=CreateUnit(GetOwningPlayer(caster),'e0QH',GetUnitX(caster), GetUnitY(caster),GetRandomReal(0,359))
			call UnitApplyTimedLife(n,'BTLF',0.5)
			call SetUnitScale(n,1.2,1.2,1.2)
			call SetUnitFlyHeight(n,75,0)
			call MyRemoveUnit(n, 1)
			set n=CreateUnit(GetOwningPlayer(caster),'dR45',GetUnitX(caster), GetUnitY(caster),GetRandomReal(0,359))
			call SetUnitScale(n, 0.7, 0.7, 0.7)
			call MyRemoveUnit(n, 1.5)
			if GetRandomInt(0, 4)==0 then
				set n=CreateUnit(GetOwningPlayer(caster),'d054',GetUnitX(caster)+GetRandomInt(-200, 200), GetUnitY(caster)+GetRandomInt(-200, 200),GetRandomReal(0,359))
				call SetUnitScale(n, 0.5, 0.5, 0.5)
				call UnitApplyTimedLife(n,'BTLF', 0.3)
				call MyRemoveUnit(n, 1.5)
			endif
			call SaveInteger(h, id, EffectPeriodHash, 2)
		else
			call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash)-1)
		endif
	else
		call SetUnitTimeScale(caster, 1)
		call ShakeCamera(0.2, 15)
		// set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dAl2', GetUnitX(target) + 50 * Cos(angle), GetUnitY(target) + 50 * Sin(angle), angle * bj_RADTODEG)
		// call SetUnitModel(bjLCU , "white-qiquan-new.mdl")
		// call SetUnitFlyHeight(bjLCU, 160, 0)
		// call SetUnitScale(bjLCU, 1.2, 1.2, 1.2)
		// call MyRemoveUnit(bjLCU , 1.5)
		loop
		exitwhen loop_index==3
			set bjLCU=CreateUnit(GetOwningPlayer(caster), 'e0QG', GetUnitX(target) + 50 * Cos(angle), GetUnitY(target) + 50 * Sin(angle), angle * bj_RADTODEG)
			call SetUnitScale(bjLCU, 1.0+loop_index/1.5, 1.0+loop_index/1.5, 1.0+loop_index/1.5)
			call UnitApplyTimedLife(bjLCU,'BTLF',0.05)
			call SetUnitTimeScale(bjLCU, 0.90)
			call SetUnitFlyHeight(bjLCU, 50, 0)
			call SetUnitVertexColor(bjLCU,255,255,255,50)
			call MyRemoveUnit(bjLCU, 1.5)
			set bjLCU=CreateUnit(GetOwningPlayer(caster), 'e0QI', GetUnitX(target) + 50 * Cos(angle), GetUnitY(target) + 50 * Sin(angle), angle * bj_RADTODEG)
			call SetUnitScale(bjLCU, 0.6+loop_index/1.5, 0.6+loop_index/1.5, 0.6+loop_index/1.5)
			call UnitApplyTimedLife(bjLCU,'BTLF',0.05)
			call SetUnitTimeScale(bjLCU, 0.90)
			call SetUnitFlyHeight(bjLCU, 50, 0)
			call SetUnitVertexColor(bjLCU,255,255,255,50)
			call MyRemoveUnit(bjLCU, 1.5)
		set loop_index = loop_index + 1
		endloop
		set bjLCU=CreateUnit(GetOwningPlayer(caster), 'e0QH', GetUnitX(target) + 50 * Cos(angle), GetUnitY(target) + 50 * Sin(angle), angle * bj_RADTODEG)
		call SetUnitScale(bjLCU, 2.2, 2.2, 2.2)
		call UnitApplyTimedLife(bjLCU,'BTLF',0.1)
		call SetUnitVertexColor(bjLCU,255,255,255,50)
		call MyRemoveUnit(bjLCU, 1.5)
		
		set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH21', GetUnitX(target), GetUnitY(target), angle * bj_RADTODEG)
		call SetUnitScale(bjLCU, 1.35, 1.35, 1.35)
		call SetUnitFlyHeight(bjLCU, 75, 0)
		call MyRemoveUnit(bjLCU, 1.5)
		set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH02', GetUnitX(target), GetUnitY(target), angle * bj_RADTODEG)
		call SetUnitFlyHeight(bjLCU, 75, 0)
		call MyRemoveUnit(bjLCU, 1.5)
		set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR37', GetUnitX(target), GetUnitY(target), angle * bj_RADTODEG)
		call SetUnitFlyHeight(bjLCU, 75, 0)
		call SetUnitScale(bjLCU, 2, 2, 2)
		call MyRemoveUnit(bjLCU, 1.5)
		set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH02', GetUnitX(target), GetUnitY(target), angle * bj_RADTODEG)
		call SetUnitFlyHeight(bjLCU, 75, 0)
		call SetUnitScale(bjLCU, 3, 3, 3)
		call MyRemoveUnit(bjLCU, 1.5)
		set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH22', GetUnitX(target), GetUnitY(target), angle * bj_RADTODEG)
		call SetUnitFlyHeight(bjLCU, 50, 0)
		call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
		call MyRemoveUnit(bjLCU, 1.5)
		set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH23', GetUnitX(target), GetUnitY(target), angle * bj_RADTODEG)
		call SetUnitFlyHeight(bjLCU, 75, 0)
		call SetUnitScale(bjLCU, 1.6, 1.6, 1.6)
		call MyRemoveUnit(bjLCU, 1.5)
		set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH24', GetUnitX(target), GetUnitY(target), angle * bj_RADTODEG)
		call SetUnitFlyHeight(bjLCU, 25, 0)
		call SetUnitScale(bjLCU, 3.1, 3.1, 3.1)
		call SetUnitTimeScale(bjLCU, 0.85)
		call MyRemoveUnit(bjLCU, 1.5)
		set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH25', GetUnitX(target), GetUnitY(target), angle * bj_RADTODEG)
		call SetUnitFlyHeight(bjLCU, 75, 0)
		call SetUnitScale(bjLCU, 1.1, 1.1, 1.1)
		call SetUnitTimeScale(bjLCU, 0.85)
		call MyRemoveUnit(bjLCU, 1.5)
		set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH26', GetUnitX(target), GetUnitY(target), angle * bj_RADTODEG)
		call SetUnitFlyHeight(bjLCU, 75, 0)
		call SetUnitScale(bjLCU, 2.5, 2.5, 2.5)
		call SetUnitTimeScale(bjLCU, 0.85)
		call MyRemoveUnit(bjLCU, 1.5)
		set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH13', GetUnitX(target), GetUnitY(target), angle * bj_RADTODEG)
		call SetUnitScale(bjLCU, 1.65, 1.65, 1.65)
		call SetUnitVertexColor(bjLCU, 255, 255, 255, 150)
		call UnitApplyTimedLife(bjLCU, 'BTLF', 0.6)
		call MyRemoveUnit(bjLCU, 1.5)
		set bjLCU=CreateUnit(GetOwningPlayer(caster), 'd054', GetUnitX(target)+GetRandomInt(-300, 300), GetUnitY(target)+GetRandomInt(-300, 300), angle * bj_RADTODEG)
		call SetUnitScale(bjLCU, 1.1, 1.1, 1.1)
		call UnitApplyTimedLife(bjLCU, 'BTLF', 0.9)
		call SetUnitFlyHeight(bjLCU, 25, 0)
		call MyRemoveUnit(bjLCU, 1.5)
		set bjLCU=CreateUnit(GetOwningPlayer(caster), 'd054', GetUnitX(target)+GetRandomInt(-300, 300), GetUnitY(target)+GetRandomInt(-300, 300), angle * bj_RADTODEG)
		call SetUnitScale(bjLCU, 1.1, 1.1, 1.1)
		call SetUnitFlyHeight(bjLCU, 25, 0)
		call UnitApplyTimedLife(bjLCU, 'BTLF', 0.8)
		call MyRemoveUnit(bjLCU, 1.5)
		set bjLCU=CreateUnit(GetOwningPlayer(caster), 'd054', GetUnitX(target)+GetRandomInt(-300, 300), GetUnitY(target)+GetRandomInt(-300, 300), angle * bj_RADTODEG)
		call SetUnitScale(bjLCU, 1.1, 1.1, 1.1)
		call SetUnitFlyHeight(bjLCU, 25, 0)
		call UnitApplyTimedLife(bjLCU, 'BTLF', 0.8)
		call MyRemoveUnit(bjLCU, 1.5)
		
		call SetUnitInvulnerable(caster, false)
		call PauseUnit(caster, false)
		call SetUnitFlyHeight(caster, 0, 0)
		call SetUnitInvulnerable(target, false)
		call PauseUnit(target,false)
        call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
		call myCustomDamage(caster, target, damage, false , false , null , null , null)
		call SetControlToUnit(caster, target, 1, "silenceTE")
		// call Push(caster, 60, angle-180*bj_DEGTORAD, 750)
		// call Push(target, 60, angle, 350)
		call IssueImmediateOrder(caster, "stop")
		call FlushChildHashtable(h, id)
		call DestroyTimer(GetExpiredTimer())
	endif
    set caster = null
    set target = null
endfunction

function LaxusD_Periodic takes nothing returns nothing
	local integer id = GetHandleId(GetExpiredTimer())
    local unit caster   = LoadUnitHandle(h, id, CasterHash)
	local real distance = LoadReal(h, id, SH_Distance)
	local real caster_x = GetUnitX(caster)
	local real caster_y = GetUnitY(caster)
	local real angle = LoadReal(h, id, AngleHash)
	if distance<1000 then
        call SetUnitInvulnerable(caster, true)
        call PauseUnit(caster, true)
		call SetUnitX(caster, caster_x+35*Cos(angle))
		call SetUnitY(caster, caster_y+35*Sin(angle))
		call SaveReal(h, id, SH_Distance, distance+35)
		if LoadInteger(h, id, EffectPeriodHash)<=0 then
			set bjLCU = CreateUnit(GetOwningPlayer(caster), 'dH17', caster_x, caster_y, angle*bj_RADTODEG)
			call SetUnitVertexColor(bjLCU, 255, 255, 255, 85)
			call SetUnitAnimationByIndex(bjLCU, 6)
			call SetUnitTimeScale(bjLCU, 2)
			call MyRemoveUnit(bjLCU, 0.11)
			set bjLCU = CreateUnit(GetOwningPlayer(caster), 'dR45', caster_x, caster_y, angle*bj_RADTODEG)
			call SetUnitScale(bjLCU, 0.7, 0.7, 0.7)
			call MyRemoveUnit(bjLCU, 1)
			call SaveInteger(h, id, EffectPeriodHash, 1)
		else
			call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash)-1)
		endif
		set bjLCG = LoadGroupHandle(h, id, GroupHash)
		call GroupEnumUnitsInRange(bjLCG, caster_x, caster_y, 125, Base)
		loop
		set bjLCU = FirstOfGroup(bjLCG)
		exitwhen bjLCU==null
			if Condition_Base(GetOwningPlayer(caster), bjLCU) and IsUnitInvulnerable(bjLCU)==false then
				call SaveReal(h, id, SH_Distance, 9999)
                if LoadBoolean(HH,GetHandleId(bjLCU),ANTITARGET_ABILITY)==false then
                    call SaveUnitHandle(h, id, TargetHash, bjLCU)
                else
                    call SaveBoolean(HH,GetHandleId(LoadUnitHandle(h, id, CasterHash)),DASH_USER,false)
                    call SaveUnitHandle(HH,GetHandleId(bjLCU),REVERSE_TARGET,LoadUnitHandle(h, id, CasterHash))
                endif
				call GroupClear(bjLCG)
			endif
			call GroupRemoveUnit(bjLCG, bjLCU)
		endloop
	else
		set n=CreateUnit(GetOwningPlayer(caster), 'd053', caster_x, caster_y, angle*bj_RADTODEG)
		call UnitApplyTimedLife(n,'BTLF', 0.4)
		call MyRemoveUnit(n, 1.5)
		if LoadUnitHandle(h, id, TargetHash)==null then
			call SetUnitInvulnerable(caster, false)
			call PauseUnit(caster, false)
			call IssueImmediateOrder(caster, "stop")
			if GetUnitAbilityLevel(caster, 'LaxD')==5 then
				call StartAbilityCooldown(GetUnitAbility(caster, 'LaxD'), 12)
			endif
			set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH18', caster_x, caster_y, GetRandomInt(0, 360))
			call SetUnitScale(bjLCU, 0.85, 0.85, 0.85)
			call SetUnitVertexColor(bjLCU, 255, 255, 255, 300)
			call MyRemoveUnit(bjLCU, 1.5)
		else
            call SetUnitInvulnerable(caster, true)
            call PauseUnit(caster, true)
			call SetUnitInvulnerable(LoadUnitHandle(h, id, TargetHash), true)
			call PauseUnit(LoadUnitHandle(h, id, TargetHash), true)
			call SaveBoolean(HH,GetHandleId(LoadUnitHandle(h, id, TargetHash)),TARGET_ABILITY,true)
			set bjLCU = CreateUnit(GetOwningPlayer(caster), 'dH01', caster_x+100*Cos(angle), caster_y+100*Sin(angle), angle*bj_RADTODEG)
			call SetUnitFlyHeight(bjLCU, 75, 0)
			call SetUnitScale(bjLCU, 1.75, 1.75, 1.75)
			call MyRemoveUnit(bjLCU, 2)
			set bjLCU = CreateUnit(GetOwningPlayer(caster), 'dH20', caster_x+100*Cos(angle), caster_y+100*Sin(angle), angle*bj_RADTODEG)
			call SetUnitFlyHeight(bjLCU, 75, 0)
			call SetUnitScale(bjLCU, 1.90, 1.90, 1.90)
			call SetUnitTimeScale(bjLCU, 2)
			call MyRemoveUnit(bjLCU, 2)
			set bjLCU = CreateUnit(GetOwningPlayer(caster), 'dH20', caster_x+100*Cos(angle), caster_y+100*Sin(angle), angle*bj_RADTODEG)
			call SetUnitFlyHeight(bjLCU, 75, 0)
			call SetUnitScale(bjLCU, 1.75, 1.75, 1.75)
			call SetUnitTimeScale(bjLCU, 2)
			call MyRemoveUnit(bjLCU, 2)
			set bjLCU = CreateUnit(GetOwningPlayer(caster), 'dR42', caster_x, caster_y, angle*bj_RADTODEG)
			call SetUnitFlyHeight(bjLCU, 100, 0)
			call SetUnitTimeScale(bjLCU, 0.65)
			call MyRemoveUnit(bjLCU, 1.5)
		
			set bjLCT = CreateTimer()
			call SaveReal(h, GetHandleId(bjLCT), AngleHash, angle)
			call SaveUnitHandle(h, GetHandleId(bjLCT), CasterHash, caster)
			call SaveUnitHandle(h, GetHandleId(bjLCT), TargetHash, LoadUnitHandle(h, id, TargetHash))
			call TimerStart(bjLCT, 0.01, true, function LaxusD_Act2_Periodic)
			set bjLCT = null
			set soundplay=SndByPath("Sound\\war3mapImported\\LaxusD_Target"+I2S(GetRandomInt(1,2))+".mp3")
			call StartSound(soundplay)
			//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
		endif
		if GetUnitAbilityLevel(caster,'LAE1')>0 then
			call SetUnitVertexColor(caster,255,255,25,255)
		else
			call SetUnitVertexColor(caster,255,255,255,255)
		endif
		call SetUnitTimeScale(caster, 1)
		call DestroyGroup(LoadGroupHandle(h, id, GroupHash))
		call FlushChildHashtable(h, id)
		call DestroyTimer(GetExpiredTimer())
	endif
    set caster = null
endfunction

function LaxusD_Cast takes unit newCaster, real point_x, real point_y, timer newTimer returns nothing
        local integer id = GetHandleId(newTimer)
        local real caster_x = GetUnitX(newCaster)
        local real caster_y = GetUnitY(newCaster)
        local real angle = AtanPoint(caster_x, caster_y, point_x, point_y)
        call ShakeCamera(0.1, 5)
        set soundplay=SndByPath("Sound\\war3mapImported\\LaxusD_Voice"+I2S(GetRandomInt(1,3))+".mp3")
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR64', GetUnitX(newCaster) + 50 * Cos(angle), GetUnitY(newCaster) + 50 * Sin(angle), angle * bj_RADTODEG)
        call SetUnitFlyHeight(bjLCU, 160, 0)
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dH19', GetUnitX(newCaster) + 50 * Cos(angle), GetUnitY(newCaster) + 50 * Sin(angle), angle * bj_RADTODEG)
        call SetUnitFlyHeight(bjLCU, 160, 0)
        call SetUnitScale(bjLCU, 0.75, 0.75, 0.75)
        call SetUnitVertexColor(bjLCU, 255, 255, 255, 140)
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dH18', GetUnitX(newCaster), GetUnitY(newCaster), angle * bj_RADTODEG)
        call SetUnitScale(bjLCU, 0.85, 0.85, 0.85)
        call SetUnitVertexColor(bjLCU, 255, 255, 255, 200)
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR88', GetUnitX(newCaster), GetUnitY(newCaster), angle * bj_RADTODEG)
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR42', GetUnitX(newCaster), GetUnitY(newCaster), angle * bj_RADTODEG)
        call SetUnitScale(bjLCU, 0.75, 0.75, 0.75)
        call SetUnitFlyHeight(bjLCU, 0.75, 0)
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'd053', GetUnitX(newCaster), GetUnitY(newCaster), angle * bj_RADTODEG+45)
        call UnitApplyTimedLife(bjLCU, 'BTLF', 0.4)
        call SetUnitFlyHeight(bjLCU, 50, 0)
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'd053', GetUnitX(newCaster), GetUnitY(newCaster), angle * bj_RADTODEG-45)
        call UnitApplyTimedLife(bjLCU, 'BTLF', 0.4)
        call SetUnitFlyHeight(bjLCU, 50, 0)
        call MyRemoveUnit(bjLCU , 1.5)
        if GetUnitAbilityLevel(newCaster,'LAE1')>0 then
                call SetUnitVertexColor(newCaster,255,255,25,100)
        else
                call SetUnitVertexColor(newCaster,255,255,255,100)
        endif
        call SetUnitInvulnerable(newCaster, true)
        call PauseUnit(newCaster, true)
        call SaveUnitHandle(h, id, CasterHash, newCaster)
        call SetUnitAnimationByIndex(newCaster, 6)
        call SetUnitTimeScale(newCaster, 1.75)
        call SaveReal(h, id, AngleHash, angle)
        call SaveGroupHandle(h, id, GroupHash, CreateGroup())
        call TimerStart(newTimer, 0.01, true, function LaxusD_Periodic)
endfunction

function LaxusRStopOrders2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
call IssueImmediateOrder(u,"stop")
call SetUnitFacing(u,Atan2(LoadReal(h,id,1)-GetUnitY(u),LoadReal(h,id,2)-GetUnitX(u))*bj_RADTODEG)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
set t=null
set u=null
endfunction
function LaxusRStopOrders takes nothing returns nothing
local unit u=GetOrderedUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
if GetOrderTargetUnit()==null then
call SaveReal(h,id,2,GetOrderPointX())
call SaveReal(h,id,1,GetOrderPointY())
else
call SaveReal(h,id,2,GetUnitX(GetOrderTargetUnit()))
call SaveReal(h,id,1,GetUnitY(GetOrderTargetUnit()))
endif
//call SetUnitAnimation(u,"Spell Channel One")
call TimerStart(t,0.001,false,function LaxusRStopOrders2)
set u=null
set t=null
endfunction

function DragonRoarCond takes nothing returns boolean
return GetSpellAbilityId()=='A0SG' and udg_B==true
endfunction
function DragonRoarCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real a=LoadReal(h,id,11)
local real dist=LoadReal(h,id,2)
local real x=GetUnitX(l__d)+45*Cos(a)
local real y=GetUnitY(l__d)+45*Sin(a)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real dmg=LoadReal(h,id,4)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,12)
local real s1=LoadReal(h,id,13)
local real s2=LoadReal(h,id,10)
local real s3=LoadReal(h,id,14)
local real s4=LoadReal(h,id,15)
if dist>0 and RectContainsUnit(WorldBoundsR(),l__d)and UnitIsAlive(l__d)then
call SetUnitXY_1(l__d,x,y, false)
call SetUnitScale(l__d,s2,s2,s2)
call SaveReal(h,id,10,s2+0.09)
call SaveReal(h,id,13,s1+0.05)
call SaveReal(h,id,14,s3+5.45)
call SaveReal(h,id,15,s4+0.05)
set n=CreateUnit(p,'e0QG',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,255,255,255,75)
set n=CreateUnit(p,'e0QG',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitVertexColor(n,255,255,255,50)
set n=CreateUnit(p,'e0QG',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,2,2,2)
call SetUnitVertexColor(n,255,255,255,25)
set n=CreateUnit(p,'e0QO',x1,y1,GetRandomReal(0,359))
call SetUnitTimeScale(n,3)
call UnitApplyTimedLife(n,'BTLF',0.1)
set n=CreateUnit(p,'e0SZ',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,0.35)
call SetUnitAnimation(n,"death")
call SetUnitScale(n,s1,s1,s1)
set n=CreateUnit(p,'e0QH',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitScale(n,s2,s2,s2)
set n=CreateUnit(p,'e0T0',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitScale(n,s4,s4,s4)
if GetRandomInt(0, 4)==0 then
        set n=CreateUnit(p,'d054',x,y,GetRandomInt(0, 360))
        call UnitApplyTimedLife(n,'BTLF',1.2)
        call SetUnitFlyHeight(n, 50, 0)
        call SetUnitScale(n,s4/2,s4/2,s4/2)
        call MyRemoveUnit(n, 2)
endif
call GroupEnumUnitsInRange(g,x,y,s3,Base)
set idg=GetHandleId(g)
call SaveReal(h,id,2,dist-45)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 2, "stun")
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
else
call SetUnitTimeScale(u,1)
call RemoveUnit(l__d)
call FlushChildHashtable(h,GetHandleId(g))
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
function DragonRoarCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,5)
local real y1=LoadReal(h,id,6)
local real a=GetUnitFacing(u)*bj_DEGTORAD
local player p=GetOwningPlayer(u)
local real dmg=LoadReal(h,id,4)
local real dist=LoadReal(h,id,2)
local real scale=LoadReal(h,id,10)
local real tm=GetWidgetMana(u)
local real mana=GetUnitState(u,UNIT_STATE_MAX_MANA)*0.01
local real time=LoadReal(h,id,18)+0.1
local trigger tt=LoadTriggerHandle(h, id, 20)
call SaveReal(h,id,11,GetUnitFacing(u)*bj_DEGTORAD)
if time<=2 then
call SetControlToUnit(u, u, 0.11, "doomdebug")
set n=CreateUnit(p,'e0QG',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,255,255,255,75)
set n=CreateUnit(p,'e0QG',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitVertexColor(n,255,255,255,50)
set n=CreateUnit(p,'e0QG',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,2,2,2)
call SetUnitVertexColor(n,255,255,255,25)
set n=CreateUnit(p,'e0QO',x,y,GetRandomReal(0,359))
call SetUnitTimeScale(n,3)
call UnitApplyTimedLife(n,'BTLF',0.1)
call SetUnitXY_1(l__d,x,y, false)
call SetUnitInvulnerable(u,true)
call SaveReal(h,id,18,time)
else
//call UnitRemoveAbility(u,'A0NP')
call SetUnitTimeScale(u,3)
call UnitRemoveAbility(u,'A1FU')
call UnitRemoveAbility(u,'Pet1')
call UnitRemoveAbility(u,'B00A')
call UnitRemoveAbility(u,'B02Z')
call SetUnitAcquireRange(u, 600)
call IssueImmediateOrder(u, "stop")
call RemoveUnit(l__d)
call SaveUnitHandle(h,id,7,CreateUnit(p,'e0QH',x+65*Cos(a),y+65*Sin(a),a*bj_RADTODEG))
set n=CreateUnit(p,'e0SY',x+75*Cos(a),y+75*Sin(a),a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1.5)
call SetUnitTimeScale(n,2)
call SetUnitInvulnerable(u,false)
call TriggerClearActions(tt)
call DestroyTrigger(tt)
call PauseTimer(t)
call TimerStart(t,0.02,true,function DragonRoarCast3)
endif
set l__d=null
set p=null
set u=null
set t=null
set tt=null
endfunction
function DragonRoarCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local trigger tt=CreateTrigger()
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,5,x1)
call SaveReal(h,id,6,y1)
call SaveReal(h,id,4,(GetUnitAbilityLevel(u,'A0SG')+3)*GetHeroStr(u,true))
call SaveReal(h,id,2,2000)
call SaveReal(h,id,10,0.75)
call SaveReal(h,id,13,0.4)
call SaveReal(h,id,14,150)
call SaveReal(h,id,15,0.3)
call SaveReal(h,id,11,a)
call SaveReal(h,id,18,0)
call SetUnitTimeScale(u,0)
call SetUnitInvulnerable(u,true)
//call PauseUnit(u,true)
call SaveGroupHandle(h,id,12,CreateGroup())
call SetUnitAnimation(u,"spell two")
call SetUnitTimeScale(u,0.1)
set soundplay=SndN(1977) // Sound\Music\mp3Music\Laxus Roar Fire.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SaveUnitHandle(h,id,7,CreateUnit(p,'e0SX',x,y,a*bj_RADTODEG))
//call UnitAddAbility(u,'A0NP')
call UnitAddAbility(u,'A1FU') //Slow
call UnitAddAbility(u,'Pet1')
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_POINT_ORDER)
call SaveTriggerHandle(h, id, 20, tt)
call SetUnitAcquireRange(u, 51)
call TriggerAddAction(tt,function LaxusRStopOrders)
call TimerStart(t,0.1,true,function DragonRoarCast2)
set u=null
set p=null
set t=null
set tt=null
endfunction
function SecretRoaringThunderCond takes nothing returns boolean
return GetSpellAbilityId()=='A0ZG'
endfunction
