function IchigoShikaiT_MorfPeriodic takes nothing returns nothing
    local integer id  = GetHandleId(GetExpiredTimer())
    local unit caster = LoadUnitHandle(h, id, 0)
    local real caster_x = GetUnitX(caster)
    local real caster_y = GetUnitY(caster)
    local real time     = LoadReal(h, id, 1)
    local boolean shikai = LoadBoolean(HH, GetHandleId(caster), 9595)
    if UnitIsAlive(caster) and RectContainsUnit(gg_rct_HibariFight, caster)==false then 
        
        if shikai or udg_B==false then
            call ShowAbility2('IcQ1', true)
            call ShowAbility2('IcW1', true)
            call ShowAbility2('IcE1', true)
            call ShowAbility2('IcR1', true)
            call ShowAbility2('IcT1', true)
			call StartAbilityCooldown(GetUnitAbility(caster, 'IcT1'), 40)
            call UnitRemoveAbility(caster, 'IcF3')
            call UnitRemoveAbility(caster, 'IcF4')
            call SetUnitAbilityLevel(caster, 'IcF2', 1)
			call SetHeroAgi(caster,GetHeroAgi(caster,false)-20,true)
		    call SetHeroStr(caster,GetHeroStr(caster,false)-20,true)

            call StartAbilityCooldown(GetUnitAbility(caster, 'IcQ1'), GetAbilityRemainingCooldown(GetUnitAbility(caster, 'IcQ3')))
            call StartAbilityCooldown(GetUnitAbility(caster, 'IcW1'), GetAbilityRemainingCooldown(GetUnitAbility(caster, 'IcW2')))
            call StartAbilityCooldown(GetUnitAbility(caster, 'IcE1'), GetAbilityRemainingCooldown(GetUnitAbility(caster, 'IcE2')))
            call StartAbilityCooldown(GetUnitAbility(caster, 'IcR1'), GetAbilityRemainingCooldown(GetUnitAbility(caster, 'IcR2')))
                        
            if IsUnitPaused(caster)==false then
                call IssueImmediateOrder(caster, "stop")
                call UnitAddAbility(caster, 'IcT4')
                call IssueImmediateOrder(caster, "bearform")
                call UnitRemoveAbility(caster, 'IcT4')
            else
                call PauseUnit(caster, false)
                call IssueImmediateOrder(caster, "stop")
                call UnitAddAbility(caster, 'IcT4')
                call IssueImmediateOrder(caster, "bearform")
                call UnitRemoveAbility(caster, 'IcT4')
                if udg_B==true then
                call PauseUnit(caster, true)
                endif
            endif
            call CheckUnitBonusRange(caster)            
            set n=CreateUnit(GetOwningPlayer(caster), 'd006', caster_x, caster_y, GetRandomInt(0, 360))
            call SetUnitScale(n, 1.5, 1.5, 1.5)
            call MyRemoveUnit(n, 1.5)
        call RemoveSavedBoolean(HH, GetHandleId(caster), 9595)
        call FlushChildHashtable(h, id)
        call PauseTimer(GetExpiredTimer())
        call DestroyTimer(GetExpiredTimer())
                        // set rfhr[GetHandleId(GetOwningPlayer(caster))]=0
                        // set bjLCT=CreateTimer()
                        // set id=GetHandleId(bjLCT)
                        // call SaveInteger(h, id, 0, GetHandleId(GetOwningPlayer(caster)))
                        // call TimerStart(bjLCT, 0.2, false, function Ichigo_FixRFH)
                        // set bjLCT=null
        endif
                
    endif
    set caster=null
endfunction

function IchigoShikaiT_Periodic takes nothing returns nothing
    local integer id  = GetHandleId(GetExpiredTimer())
    local unit caster = LoadUnitHandle(h, id, 0)
    local real caster_x = GetUnitX(caster)
    local real caster_y = GetUnitY(caster)
    local real time     = LoadReal(h, id, 1)
    local real angle    = 0.0
    call SaveReal(h, id, 1, time+0.2)
    if time<3.0 then
        call PauseUnit(caster, true)
        set n=CreateUnit(GetOwningPlayer(caster), 'dM05', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 0.5+time/2.5, 0.5+time/2.5, 0.5+time/2.5)
        call SetUnitVertexColor(n, 255, 255, 255, 140)
        call MyRemoveUnit(n, 1.5)
        set n=LoadUnitHandle(h, id, 2)
        call SetUnitX(n, caster_x)
        call SetUnitY(n, caster_y)
        call SetUnitScale(n, 1.0+time/1.5, 1.0+time/1.5, 1.0+time/1.5)
        set n=LoadUnitHandle(h, id, 3)
        call SetUnitX(n, caster_x)
        call SetUnitY(n, caster_y)
        call SetUnitScale(n, 1.0+time*1.3, 1.0+time*1.3, 1.0+time*1.3)
        set n=null
    endif
        if time==1.6 then
                set n=CreateUnit(GetOwningPlayer(caster), 'd063', caster_x, caster_y, GetRandomInt(0, 360))
        call UnitScale(n, 0.5, 1.5, 0.5)
                call UnitApplyTimedLife(n,'BTLF', 2)
        call MyRemoveUnit(n, 3.5)
        endif
    if time==3.0 then
        call ShakeCamera(0.1, 10)
        
        call RemoveUnit(LoadUnitHandle(h, id, 2))
        call RemoveUnit(LoadUnitHandle(h, id, 3))
        call PauseUnit(caster, false)
        call IssueImmediateOrder(caster, "stop")
        call SetHeroAgi(caster,GetHeroAgi(caster,false)+20,true)
		call SetHeroStr(caster,GetHeroStr(caster,false)+20,true)
        call ShowAbility2('IcQ1', false)
        call ShowAbility2('IcW1', false)
        call ShowAbility2('IcE1', false)
        call ShowAbility2('IcR1', false)
        call ShowAbility2('IcT1', false)
        call StartAbilityCooldown(GetUnitAbility(caster, 'IcQ3'), (0.01+GetAbilityRemainingCooldown(GetUnitAbility(caster, 'IcQ1')))/2)
        call StartAbilityCooldown(GetUnitAbility(caster, 'IcW2'), (0.01+GetAbilityRemainingCooldown(GetUnitAbility(caster, 'IcW1')))/2)
        call StartAbilityCooldown(GetUnitAbility(caster, 'IcE2'), (0.01+GetAbilityRemainingCooldown(GetUnitAbility(caster, 'IcE1')))/2)
        call StartAbilityCooldown(GetUnitAbility(caster, 'IcR2'), (0.01+GetAbilityRemainingCooldown(GetUnitAbility(caster, 'IcR1')))/2)
        call UnitAddAbility(caster, 'IcT3')
        call IssueImmediateOrder(caster, "bearform")
        call UnitRemoveAbility(caster, 'IcT3')
        call UnitAddAbility(caster, 'IcF3')
        call UnitMakeAbilityPermanent(caster, true, 'IcF3')
        call SetUnitAbilityLevel(caster, 'IcF2', 2)
        call CheckUnitBonusRange(caster)        
        call PauseUnit(caster, true)
        call SetUnitInvulnerable(caster, true)
        call RemoveEffect(AddSpecialEffectTarget("EffBank.mdl", caster, "origin"), 6, true, CreateTimer())
        set n=CreateUnit(GetOwningPlayer(caster), 'd001',  caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 2.5, 2.5, 2.5)
        call SetUnitFlyHeight(n, 20, 0)
        call MyRemoveUnit(n, 2.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'd003',  caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 3, 3, 3)
        call MyRemoveUnit(n, 2.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'd003',  caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 3, 3, 3)
        call MyRemoveUnit(n, 2.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'd032',  caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 3.5, 3.5, 3.5)
        call SetUnitFlyHeight(n, 200, 0)
        call MyRemoveUnit(n, 2.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'd033',  caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 3, 3, 3)
        call SetUnitTimeScale(n, 0.5)
        call SetUnitFlyHeight(n, 5, 0)
        call MyRemoveUnit(n, 1.85)
        
        set n=CreateUnit(GetOwningPlayer(caster), 'd034' , caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 3, 3, 3)
        call SaveUnitHandle(h, id, 10, n)
    endif
    if time==5.0 then
        call SetUnitAnimationByIndex(caster, 6)
        // set n=CreateUnit(GetOwningPlayer(caster), 'd032',  caster_x, caster_y, GetRandomInt(0, 360))
        // call SetUnitScale(n, 3.5, 3.5, 3.5)
        // call SetUnitFlyHeight(n, 200, 0)
        // call MyRemoveUnit(n, 2.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'dM30', caster_x, caster_y, GetRandomInt(0, 360))
        call UnitScale(n, 1.0, 3.0, 0.2)
        call MyRemoveUnit(n, 2.0)
        set n=CreateUnit(GetOwningPlayer(caster), 'dM30', caster_x, caster_y, GetRandomInt(0, 360))
        call MyRemoveUnit(n, 2.0)
        set n=CreateUnit(GetOwningPlayer(caster), 'dM30', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 2, 2, 2)
        call MyRemoveUnit(n, 2.0)
        set angle=0.0
        loop
        exitwhen angle==360*bj_DEGTORAD
            set n=CreateUnit(GetOwningPlayer(caster), 'dM40', caster_x+350*Cos(angle), caster_y+350*Sin(angle), angle*bj_RADTODEG+180)
            call SetUnitScale(n, 1.5, 1.5, 1.5)
            call SetUnitVertexColor(n, 255, 255, 255, 180)
            call MyRemoveUnit(n, 1.5)
            set n=CreateUnit(GetOwningPlayer(caster), 'dM40', caster_x+650*Cos(angle), caster_y+650*Sin(angle), angle*bj_RADTODEG+180)
            call SetUnitScale(n, 2.5, 2.5, 2.5)
            call SetUnitVertexColor(n, 255, 255, 255, 180)
            call MyRemoveUnit(n, 1.5)
        set angle=angle+30*bj_DEGTORAD
        endloop
                
        call RemoveUnit(LoadUnitHandle(h, id, 10))
        call ShakeCamera(0.1, 10)
        call PauseUnit(caster, false)
                call SetUnitInvulnerable(caster, false)
        call PauseTimer(GetExpiredTimer())
        call TimerStart(GetExpiredTimer(), 0.03, true, function IchigoShikaiT_MorfPeriodic)
    endif
    set caster=null
endfunction

function IchigoShikaiT_Cast takes unit newCaster returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local real caster_x  = GetUnitX(newCaster)
    local real caster_y  = GetUnitY(newCaster)
        if GetPlayerName(GetOwningPlayer(newCaster))=="Uriska" then
                if GetRandomInt(0, 1)==0 then
                        set soundplay=SndN(305) // Sound\war3mapImported\IchigoT0RARE.mp3
                else
                        set soundplay=SndN(4121) // Sound\war3mapImported\IchigoT_Uriska.wav
                endif
        else
                if GetRandomReal(1, 10)<=1.5 then
                        set soundplay=SndN(305) // Sound\war3mapImported\IchigoT0RARE.mp3
                else
                        set soundplay=SndByPath("Sound\\war3mapImported\\IchigoT"+I2S(GetRandomInt(1, 2))+".mp3")
                endif
        endif
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd001', caster_x, caster_y, GetRandomInt(0, 360))
    call SetUnitScale(n, 1.2, 1.2, 1.2)
    call MyRemoveUnit(n, 1.5)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd004', caster_x, caster_y, GetRandomInt(0, 360))
    call SaveUnitHandle(h, id, 2, n)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd005', caster_x, caster_y, GetRandomInt(0, 360))
    call SaveUnitHandle(h, id, 3, n)
    call RemoveEffect(AddSpecialEffectTarget("AZ_Alleria_R4.mdl", newCaster, "origin"), 3, true, CreateTimer())
    call PauseUnit(newCaster, true)
        call SetUnitInvulnerable(newCaster, true)
    call FrozenMinusManaIchigoCast(newCaster)
        call UnitRemoveAbility(newCaster, 'IcQ2')
    call SetUnitAnimationByIndex(newCaster, 8)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(h, id, 1, 0)
    call TimerStart(newTimer, 0.2, true, function IchigoShikaiT_Periodic)
    set newTimer=null
endfunction


//====== BANKAI ICHIGO
function IchigoBankaiD1_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local unit caster = LoadUnitHandle(HH, id, 0)
    local real time = LoadReal(HH, GetHandleId(caster), 1122)
    call SaveReal(HH, GetHandleId(caster), 1122, time-0.1)
    if time<0 or GetUnitAbilityLevel(caster, 'IcD2')==0 or LoadInteger(HH, GetHandleId(caster), 1123)>5 then
        call UnitRemoveAbility(caster, 'IcD3')
        call ShowAbility2('IcD2', true)
        if LoadInteger(HH, GetHandleId(caster), 1123)>5 then
        call StartAbilityCooldown(GetUnitAbility(caster, 'IcD2'), 15)
        endif
        call DestroyEffect(LoadEffectHandle(HH, id, 3))
        call DestroyEffect(LoadEffectHandle(HH, id, 4))
        call RemoveSavedReal(HH, GetHandleId(caster), 1122)
        call RemoveSavedInteger(HH, GetHandleId(caster), 1123)
        call FlushChildHashtable(HH, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
endfunction

function IchigoBankaiD1_Cast takes unit newCaster returns nothing
    local timer newTimer = CreateTimer()
    local integer id = GetHandleId(newTimer)
    call ShowAbility2('IcD2', false)
    call UnitAddAbility(newCaster, 'IcD3')
    call UnitMakeAbilityPermanent(newCaster, true, 'IcD3')
    call StartAbilityCooldown(GetUnitAbility(newCaster, 'IcD3'), 0.5)
    call SaveUnitHandle(HH, id, 0, newCaster)
    call SaveReal(HH, GetHandleId(newCaster), 1122, 15)
    call SaveInteger(HH, GetHandleId(newCaster), 1123, 1)
    call SaveEffectHandle(HH, id, 3, AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl", newCaster, "right foot"))
    call SaveEffectHandle(HH, id, 4, AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl", newCaster, "left foot"))
    call TimerStart(newTimer, 0.1, true, function IchigoBankaiD1_Periodic)
    set newTimer=null
endfunction

function IchigoBankaiF_Cast takes unit newCaster returns nothing
    local integer spell_lvl = GetUnitAbilityLevel(newCaster, 'IcF2')
    if spell_lvl == 1 then
        call UnitAddAbility(newCaster, 'IcF3')
        call UnitMakeAbilityPermanent(newCaster, true, 'IcF3')
        call SetUnitAbilityLevel(newCaster, 'IcF2', 2)
    elseif spell_lvl == 2 then
        call UnitRemoveAbility(newCaster, 'IcF3')
        call UnitAddAbility(newCaster, 'IcF4')
        call UnitMakeAbilityPermanent(newCaster, true, 'IcF4')
        call SetUnitAbilityLevel(newCaster, 'IcF2', 3)
    elseif spell_lvl == 3 then
        call UnitRemoveAbility(newCaster, 'IcF3')
        call UnitRemoveAbility(newCaster, 'IcF4')
        call SetUnitAbilityLevel(newCaster, 'IcF2', 1)
    endif
endfunction

function IchigoBankaiQ_Counter_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local unit caster = LoadUnitHandle(HH, id, 0)
    local real time = LoadReal(HH, id, 1)
    call SaveReal(HH, id, 1, time-0.1)
    if time<0 or GetUnitAbilityLevel(caster, 'IcQ6')==0 then
        call UnitRemoveAbility(caster, 'IcQ6')
        call UnitRemoveAbility(caster, 'IcQ5')
        call UnitRemoveAbility(caster, 'IcQ4')
        call ShowAbility2('IcQ3', true)
        call DestroyEffect(LoadEffectHandle(HH, id, 3))
                call DestroyEffect(LoadEffectHandle(HH, id, 4))
        call FlushChildHashtable(HH, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
endfunction


function IchigoBankaiQ_Counter takes unit newCaster returns nothing
    local timer newTimer = CreateTimer()
    local integer id = GetHandleId(newTimer)
    call UnitAddAbility(newCaster, 'IcQ6')
    call UnitMakeAbilityPermanent(newCaster, true, 'IcQ6')
    call ShowAbility2('IcQ3', false)
    call UnitAddAbility(newCaster, 'IcQ4')
    call UnitMakeAbilityPermanent(newCaster, true, 'IcQ4')
    call StartAbilityCooldown(GetUnitAbility(newCaster, 'IcQ4'), 0.5)
    call SaveUnitHandle(HH, id, 0, newCaster)
    call SaveReal(HH, id, 1, 30)
    //call SaveEffectHandle(HH, id, 3, AddSpecialEffectTarget("Abilities\\Weapons\\DragonHawkMissile\\DragonHawkMissile.mdl", newCaster, "hand left"))
        call SaveEffectHandle(HH, id, 3, AddSpecialEffectTarget("BDEF_102_Attach.mdl", newCaster, "hand right"))
        call SaveEffectHandle(HH, id, 4, AddSpecialEffectTarget("BDEF_102_Attach.mdl", newCaster, "hand right"))
    call TimerStart(newTimer, 0.1, true, function IchigoBankaiQ_Counter_Periodic)
    set newTimer=null
endfunction

function IchigoBankaiQ3_Periodic takes nothing returns nothing
    local integer id = GetHandleId(GetExpiredTimer())
    local unit dummy = LoadUnitHandle(h, id, 3)
    local unit caster = LoadUnitHandle(h, id, 0)
    local real point_x  = LoadReal(h, id, 9)
    local real point_y  = LoadReal(h, id, 10)
    local real angle    = LoadReal(h, id, 1)
    local real distance = LoadReal(h, id, 2)
    local real effect_period = LoadReal(h, id, 7)
    if GetUnitFlyHeight(dummy)>2 then
        call SetUnitFlyHeight(dummy, GetUnitFlyHeight(dummy)-22.5, 0)
        call SetUnitX(dummy, GetUnitX(dummy)+30*Cos(angle))
        call SetUnitY(dummy, GetUnitY(dummy)+30*Sin(angle))
        call SetUnitFlyHeight(LoadUnitHandle(h, id, 8), GetUnitFlyHeight(dummy), 0)
        call SetUnitX(LoadUnitHandle(h, id, 8), GetUnitX(dummy))
        call SetUnitY(LoadUnitHandle(h, id, 8), GetUnitY(dummy))
    else
        call KillUnit(dummy)
        call KillUnit(LoadUnitHandle(h, id, 8))
        call MyRemoveUnit(dummy, 1.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, 8), 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'd020', point_x, point_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 2, 2, 2)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'd021', point_x, point_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'd009', point_x, point_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 2.5, 2.5, 2.5)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'd022', point_x, point_y, GetRandomInt(0, 360))
        //call SetUnitScale(n, 1.5, 1.5, 1.5)
                call SetUnitVertexColor(n, 255, 0, 0, 255)
        call MyRemoveUnit(n, 1.5)
        //set n=CreateUnit(GetOwningPlayer(caster), 'dM28', point_x, point_y, GetRandomInt(0, 360))
        call ShakeCamera(0.1, 10)
        set bjLCG=LoadGroupHandle(h, id, 5)
        call GroupEnumUnitsInRange(bjLCG, point_x, point_y, 500, Base)
        loop
            set E=FirstOfGroup(bjLCG)
            exitwhen E==null
            if Condition_Base(GetOwningPlayer(caster), E) then
                call myCustomDamage(caster, E, GetHeroStr(caster, true)*4.5, false,false,null,null,null)
                call SetControlToUnit(LoadUnitHandle(h, id, 0), E, 1.5, "stun")
            endif
            call GroupRemoveUnit(bjLCG, E)
        endloop
        call DestroyGroup(bjLCG)
        call FlushChildHashtable(h, id)
        call PauseTimer(GetExpiredTimer())
        call DestroyTimer(GetExpiredTimer())
    endif
    set dummy=null
    set caster=null
endfunction

function IchigoBankaiQ3_TimerWait takes nothing returns nothing
    local integer id = GetHandleId(GetExpiredTimer())
    local unit caster = LoadUnitHandle(h, id, 0)
    local real caster_x = GetUnitX(caster)
    local real caster_y = GetUnitY(caster)
    local real point_x = LoadReal(h, id, 9)
    local real point_y = LoadReal(h, id, 10)
    local real angle   = LoadReal(h, id, 1)
    call PauseUnit(caster, false)
    call SetUnitInvulnerable(caster, false)
    call UnitRemoveAbility(caster, 'IcQ6')
    call SetUnitFlyHeight(caster, 0, 0)
    set n=CreateUnit(GetOwningPlayer(caster), 'd011', caster_x, caster_y, GetRandomInt(0, 360))
    call MyRemoveUnit(n, 1.5)
    call PauseTimer(GetExpiredTimer())
    call TimerStart(GetExpiredTimer(), 0.015, true, function IchigoBankaiQ3_Periodic)
    set caster=null
endfunction

function IchigoBankaiQ3_Cast takes unit newCaster, real point_x, real point_y returns nothing
    local timer newTimer = CreateTimer()
    local integer id = GetHandleId(newTimer)
    local real caster_x = GetUnitX(newCaster)
    local real caster_y = GetUnitY(newCaster)
    local real angle    = AP(caster_x, caster_y, point_x, point_y)
                if GetUnitTypeId(newCaster)=='HIc3' then
                        call RemoveEffect(AddSpecialEffectTarget("BDEF (152).mdl", newCaster, "origin"), 2, true, CreateTimer())
                        set soundplay=SndN(4123) // Sound\war3mapImported\VastoQ3.mp3
                        call StartSound(soundplay)
                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                else
                        set soundplay=SndN(4125) // Sound\war3mapImported\IchigoTQ3.mp3
                        call StartSound(soundplay)
                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                endif
    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, 8)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd011', caster_x, caster_y, GetRandomInt(0, 360))
    call MyRemoveUnit(n, 1.5)
    call RemoveEffect(AddSpecialEffectTarget("supershinythingyhg2.mdl", newCaster, "right hand"), 1.5, true, CreateTimer())
    set caster_x=point_x-1000*Cos(angle)
    set caster_y=point_y-1000*Sin(angle)
    call UnitAddAbility(newCaster, 'Arav')
    call UnitRemoveAbility(newCaster, 'Arav')
    call SetUnitX(newCaster, caster_x)
    call SetUnitY(newCaster, caster_y)
    call SetUnitFlyHeight(newCaster, 700, 0)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd011', caster_x, caster_y, GetRandomInt(0, 360))
    call SetUnitFlyHeight(n, 710, 0)
    call MyRemoveUnit(n, 1.5)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd023', caster_x, caster_y, angle*bj_RADTODEG)
    call SetUnitFlyHeight(n, 720, 0)
    call SetUnitScale(n, 2.5, 2.5, 2.5)
    call MyRemoveUnit(n, 1.5)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd067', caster_x, caster_y, angle*bj_RADTODEG)
    call SetUnitFlyHeight(n, 720, 0)
    call SaveUnitHandle(h, id, 3, n)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd067', caster_x, caster_y, angle*bj_RADTODEG)
    call SetUnitFlyHeight(n, 720, 0)
    call SaveUnitHandle(h, id, 8, n)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(h, id, 1, angle)
    call SaveReal(h, id, 2, 0)
    call SaveGroupHandle(h, id, 5, CreateGroup())
    call SaveReal(h, id, 7, 0)
    call SaveReal(h, id, 9, point_x)
    call SaveReal(h, id, 10, point_y)
    call TimerStart(newTimer, 0.4, false, function IchigoBankaiQ3_TimerWait)
    set newTimer=null
endfunction


function IchigoBankaiQ2_Periodic2 takes nothing returns nothing
    local integer id = GetHandleId(GetExpiredTimer())
    local unit dummy = LoadUnitHandle(h, id, 3)
    local real dummy_x  = GetUnitX(dummy)
    local real dummy_y  = GetUnitY(dummy)
    local real angle    = LoadReal(h, id, 1)
    local real distance = LoadReal(h, id, 2)
    local real effect_period = LoadReal(h, id, 7)
    if distance<=1500 then
        call SaveReal(h, id, 2, distance+50)
        call SetUnitX(dummy, dummy_x+50*Cos(angle))
        call SetUnitY(dummy, dummy_y+50*Sin(angle))
        call SetUnitX(LoadUnitHandle(h, id, 10), dummy_x-30*Cos(angle))
        call SetUnitY(LoadUnitHandle(h, id, 10), dummy_y-30*Sin(angle))
        call SetUnitX(LoadUnitHandle(h, id, 6), dummy_x+200*Cos(angle))
        call SetUnitY(LoadUnitHandle(h, id, 6), dummy_y+200*Sin(angle))
        set bjLCG=LoadGroupHandle(h, id, 4)
        call GroupEnumUnitsInRange(bjLCG, dummy_x, dummy_y, 225, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            if Condition_Base(GetOwningPlayer(dummy),E) and IsUnitInGroup(E, LoadGroupHandle(h, id, 5))==false then
                call myCustomDamage(LoadUnitHandle(h, id, 0), E, GetHeroStr(LoadUnitHandle(h, id, 0), true)*4.5, false,false,null,null,null)
                call SetControlToUnit(LoadUnitHandle(h, id, 0), E, 1.5, "stun")
                call DestroyEffect(AddSpecialEffectTarget("FantasyBattle (1642).mdl",E,"chest"))
                set n=CreateUnit(GetOwningPlayer(dummy), 'd018', GetUnitX(E), GetUnitY(E), angle*bj_RADTODEG)
                call MyRemoveUnit(n, 1.5)
                call GroupAddUnit(LoadGroupHandle(h, id, 5), E)
            endif
            if IsUnitAlly(E, GetOwningPlayer(dummy))==false then
                call SetUnitX(E, GetUnitX(E)+50*Cos(angle))
                call SetUnitY(E, GetUnitY(E)+50*Sin(angle))
            endif
            call GroupRemoveUnit(bjLCG, E)
        endloop
        if effect_period<=0 then
            set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, 0)), 'd010', dummy_x+200*Cos(angle), dummy_y+200*Sin(angle), angle*bj_RADTODEG)
            call SetUnitScale(n, 1.5, 1.5, 1.5)
            call MyRemoveUnit(n, 1.5)
            call SaveReal(h, id, 7, 6)
        else
            call SaveReal(h, id, 7, effect_period-1)
        endif
    else
        call SaveBoolean(HH,GetHandleId(LoadUnitHandle(h, id, 0)),DASH_USER,false)
        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, 0)), 'd009', dummy_x+200*Cos(angle), dummy_y+200*Sin(angle), angle*bj_RADTODEG)
        call SetUnitTimeScale(n, 0.7)
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call MyRemoveUnit(n, 1.0)
        call UnitApplyTimedLife(dummy, 'BTLF', 0.1)
        call UnitApplyTimedLife(LoadUnitHandle(h, id, 6), 'BTLF', 0.1)
        call KillUnit(LoadUnitHandle(h, id, 10))
        call MyRemoveUnit(dummy, 0.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, 6), 1.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, 10), 1.5)
        call GroupClear(LoadGroupHandle(h, id, 5))
        call DestroyGroup(LoadGroupHandle(h, id, 4))
        call DestroyGroup(LoadGroupHandle(h, id, 5))
        call FlushChildHashtable(h, id)
        call PauseTimer(GetExpiredTimer())
        call DestroyTimer(GetExpiredTimer())
    endif
    set dummy=null
endfunction

function IchigoBankaiQ2_Periodic takes nothing returns nothing
    local integer id = GetHandleId(GetExpiredTimer())
    local unit caster   = LoadUnitHandle(h, id, 0)
    local unit dummy    = LoadUnitHandle(h, id, 3)
    local real angle    = LoadReal(h, id, 1)
    local real distance = LoadReal(h, id, 2)
    local real effect_period = LoadReal(h, id, 7)
    if LoadBoolean(HH,GetHandleId(caster),DASH_USER)==true then
        if distance<=500 then
            call SaveReal(h, id, 2, distance+40)
            call SetUnitX(caster, GetUnitX(caster)+40*Cos(angle))
            call SetUnitY(caster, GetUnitY(caster)+40*Sin(angle))
            call SetUnitX(dummy, GetUnitX(caster))
            call SetUnitY(dummy, GetUnitY(caster))
            call SetUnitX(LoadUnitHandle(h, id, 10), GetUnitX(caster)+15*Cos(angle))
            call SetUnitY(LoadUnitHandle(h, id, 10), GetUnitY(caster)+15*Cos(angle))
            call SetUnitX(LoadUnitHandle(h, id, 6), GetUnitX(caster))
            call SetUnitY(LoadUnitHandle(h, id, 6), GetUnitY(caster))
            set bjLCG=LoadGroupHandle(h, id, 4)
            call GroupEnumUnitsInRange(bjLCG, GetUnitX(caster), GetUnitY(caster), 225, Base)
            loop
            set E=FirstOfGroup(bjLCG)
            exitwhen E==null
                if Condition_Base(GetOwningPlayer(dummy),E) and IsUnitInGroup(E, LoadGroupHandle(h, id, 5))==false then
                    if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
                        call myCustomDamage(LoadUnitHandle(h, id, 0), E, GetHeroStr(caster, true)*4.5, false,false,null,null,null)
                        call DestroyEffect(AddSpecialEffectTarget("AFB (2454).mdl",E,"chest"))
                        set n=CreateUnit(GetOwningPlayer(dummy), 'd019', GetUnitX(E), GetUnitY(E), angle*bj_RADTODEG)
                        call MyRemoveUnit(n, 1.5)
                        call SetControlToUnit(caster, E, 1.5, "stun")
                        call GroupAddUnit(LoadGroupHandle(h, id, 5), E)
                    else
                        call SaveBoolean(HH,GetHandleId(caster),DASH_USER,false)
                        call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,caster)
                    endif
                endif
                if IsUnitAlly(E, GetOwningPlayer(dummy))==false then
                    call SetUnitX(E, GetUnitX(E)+50*Cos(angle))
                    call SetUnitY(E, GetUnitY(E)+50*Sin(angle))
                endif
                call GroupRemoveUnit(bjLCG, E)
            endloop
            if effect_period<=0 then
                set n=CreateUnit(GetOwningPlayer(caster), 'd016', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG)
                call SetUnitTimeScale(n, 1.3)
                call SetUnitScale(n, 2.5, 2.5, 2.5)
                call SetUnitFlyHeight(n, 150, 0)
                call MyRemoveUnit(n, 1.0)
                call SaveReal(h, id, 7, 1)
            else
                call SaveReal(h, id, 7, effect_period-1)
            endif
        else
            set n=CreateUnit(GetOwningPlayer(caster), 'd014', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG)
            call MyRemoveUnit(n, 1.5)
            call PauseUnit(caster, false)
            //call SetUnitInvulnerable(caster, false)
            call PauseTimer(GetExpiredTimer())
            call TimerStart(GetExpiredTimer(), 0.02, true, function IchigoBankaiQ2_Periodic2)
        endif
    else
        call SaveBoolean(HH,GetHandleId(caster),DASH_USER,false)
        call UnitApplyTimedLife(dummy, 'BTLF', 0.1)
        call UnitApplyTimedLife(LoadUnitHandle(h, id, 6), 'BTLF', 0.1)
        call KillUnit(LoadUnitHandle(h, id, 10))
        call MyRemoveUnit(dummy, 0.5)
        call GroupClear(LoadGroupHandle(h, id, 5))
        call DestroyGroup(LoadGroupHandle(h, id, 4))
        call DestroyGroup(LoadGroupHandle(h, id, 5))
        call FlushChildHashtable(h, id)
        call PauseTimer(GetExpiredTimer())
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
    set dummy=null
endfunction

function IchigoBankaiQ2_WaitTime takes nothing returns nothing
    local integer id = GetHandleId(GetExpiredTimer())
    local unit caster = LoadUnitHandle(h, id, 0)
    local real caster_x = GetUnitX(caster)
    local real caster_y = GetUnitY(caster)
    local real angle    = LoadReal(h, id, 1)
    call ShakeCamera(0.1, 5)
    set n=CreateUnit(GetOwningPlayer(caster), 'dM04', caster_x, caster_y, angle*bj_RADTODEG)
    call SetUnitTimeScale(n, 0.7)
    //call SetUnitScale(n, 1.2, 1.2, 1.2)
    call SetUnitFlyHeight(n, 150, 0)
    call MyRemoveUnit(n, 1.5)
    call UnitRemoveAbility(caster, 'IcQ4')
    call UnitAddAbility(caster, 'IcQ5')
    call StartAbilityCooldown(GetUnitAbility(caster, 'IcQ5'), 0.5)
    call UnitMakeAbilityPermanent(caster, true, 'IcQ5')
    call PauseTimer(GetExpiredTimer())
    call TimerStart(GetExpiredTimer(), 0.02, true, function IchigoBankaiQ2_Periodic)
    set caster=null
endfunction

function IchigoBankaiQ2_Cast takes unit newCaster, real point_x, real point_y returns nothing
    local timer newTimer = CreateTimer()
    local integer id = GetHandleId(newTimer)
    local real caster_x = GetUnitX(newCaster)
    local real caster_y = GetUnitY(newCaster)
    local real angle    = AP(caster_x, caster_y, point_x, point_y)
    if GetUnitTypeId(newCaster)=='HIc3' then
        call RemoveEffect(AddSpecialEffectTarget("BDEF (152).mdl", newCaster, "origin"), 2, true, CreateTimer())
        set soundplay=SndN(4127) // Sound\war3mapImported\VastoQ2.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    else
        set soundplay=SndN(4129) // Sound\war3mapImported\IchigoTQ2.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    endif
    call PauseUnit(newCaster, true)
    //call SetUnitInvulnerable(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, GetRandomInt(7, 8))
    call RemoveEffect(AddSpecialEffectTarget("supershinythingyhg2.mdl", newCaster, "right hand"), 1.5, true, CreateTimer())
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd015', caster_x+50*Cos(angle), caster_y+50*Sin(angle), angle*bj_RADTODEG)
    call SetUnitScale(n, 2.5, 2.5, 2.5)
    call SetUnitFlyHeight(n, 150, 0)
    call MyRemoveUnit(n, 1.8)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd009', caster_x, caster_y, angle*bj_RADTODEG)
    call SetUnitTimeScale(n, 0.7)
    call SetUnitScale(n, 1.2, 1.2, 1.2)
    call MyRemoveUnit(n, 1.0)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd013', caster_x, caster_y, angle*bj_RADTODEG)
    call SetUnitFlyHeight(n, 150, 0)
    call SaveUnitHandle(h, id, 3, n)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd013', caster_x, caster_y, angle*bj_RADTODEG)
    call SetUnitFlyHeight(n, 150, 0)
    call SaveUnitHandle(h, id, 10, n)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd008', caster_x, caster_y, angle*bj_RADTODEG)
    call SetUnitScale(n, 1.5, 1.5, 1.5)
    //call SetUnitFlyHeight(n, 150, 0)
    call SaveUnitHandle(h, id, 6, n)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(h, id, 1, angle)
    call SaveReal(h, id, 2, 0)
    call SaveGroupHandle(h, id, 4, CreateGroup())
    call SaveGroupHandle(h, id, 5, CreateGroup())
    call SaveReal(h, id, 7, 0)
    call SaveBoolean(HH,GetHandleId(newCaster),DASH_USER,true)
    call TimerStart(newTimer, 0.2, false, function IchigoBankaiQ2_WaitTime)
    set newTimer=null
endfunction

function IchigoBankaiQ1_Periodic takes nothing returns nothing
    local integer id = GetHandleId(GetExpiredTimer())
    local unit dummy = LoadUnitHandle(h, id, 3)
    local real dummy_x  = GetUnitX(dummy)
    local real dummy_y  = GetUnitY(dummy)
    local real angle    = LoadReal(h, id, 1)
    local real distance = LoadReal(h, id, 2)
    local real effect_period = LoadReal(h, id, 7)
    if distance<1750 then
        call SaveReal(h, id, 2, distance+50)
        call SetUnitX(dummy, dummy_x+50*Cos(angle))
        call SetUnitY(dummy, dummy_y+50*Sin(angle))
        call SetUnitX(LoadUnitHandle(h, id, 6), dummy_x+200*Cos(angle))
        call SetUnitY(LoadUnitHandle(h, id, 6), dummy_y+200*Sin(angle))
        call SetUnitX(LoadUnitHandle(h, id, 8), dummy_x+85*Cos(angle))
        call SetUnitY(LoadUnitHandle(h, id, 8), dummy_y+85*Sin(angle))
        call SetUnitX(LoadUnitHandle(h, id, 10), dummy_x+50*Cos(angle))
        call SetUnitY(LoadUnitHandle(h, id, 10), dummy_y+50*Sin(angle))
        set bjLCG=LoadGroupHandle(h, id, 4)
        call GroupEnumUnitsInRange(bjLCG, dummy_x, dummy_y, 225, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            if Condition_Base(GetOwningPlayer(dummy),E) and IsUnitInGroup(E, LoadGroupHandle(h, id, 5))==false then
                call myCustomDamage(LoadUnitHandle(h, id, 0), E, GetHeroStr(LoadUnitHandle(h, id, 0), true)*4.5, false,false,null,null,null)
                call Push3(E , 50 , angle , 125 , "")
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\Purge\\PurgeBuffTarget.mdl",E,"chest"))
                set n=CreateUnit(GetOwningPlayer(dummy), 'd018', GetUnitX(E), GetUnitY(E), angle*bj_RADTODEG)
                call MyRemoveUnit(n, 1.5)
                call GroupAddUnit(LoadGroupHandle(h, id, 5), E)
            endif
            call GroupRemoveUnit(bjLCG, E)
        endloop
        if effect_period<=0 then
            set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, 0)), 'd010', dummy_x+200*Cos(angle), dummy_y+200*Sin(angle), angle*bj_RADTODEG)
            call SetUnitScale(n, 1.5, 1.5, 1.5)
            call MyRemoveUnit(n, 1.5)
            call SaveReal(h, id, 7, 4)
        else
            call SaveReal(h, id, 7, effect_period-1)
        endif
    else
        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, 0)), 'd009', dummy_x+200*Cos(angle), dummy_y+200*Sin(angle), angle*bj_RADTODEG)
        call SetUnitTimeScale(n, 0.7)
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call MyRemoveUnit(n, 1.0)
        call UnitApplyTimedLife(dummy, 'BTLF', 0.1)
        call KillUnit(LoadUnitHandle(h, id, 6))
        call UnitApplyTimedLife(LoadUnitHandle(h, id, 8), 'BTLF', 0.1)
        call KillUnit(LoadUnitHandle(h, id, 10))
        call MyRemoveUnit(dummy, 0.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, 6), 1.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, 8), 1.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, 10), 1.5)
        call GroupClear(LoadGroupHandle(h, id, 5))
        call DestroyGroup(LoadGroupHandle(h, id, 4))
        call DestroyGroup(LoadGroupHandle(h, id, 5))
        call FlushChildHashtable(h, id)
        call PauseTimer(GetExpiredTimer())
        call DestroyTimer(GetExpiredTimer())
    endif
    set dummy=null
endfunction

function IchigoBankaiQ1_WaitTime takes nothing returns nothing
    local integer id = GetHandleId(GetExpiredTimer())
    local unit caster = LoadUnitHandle(h, id, 0)
    local real caster_x = GetUnitX(caster)
    local real caster_y = GetUnitY(caster)
    local real angle    = LoadReal(h, id, 1)
    set n=CreateUnit(GetOwningPlayer(caster), 'dM04', caster_x, caster_y, angle*bj_RADTODEG)
    call SetUnitTimeScale(n, 0.7)
    call SetUnitFlyHeight(n, 150, 0)
    call MyRemoveUnit(n, 1.5)
    set n=CreateUnit(GetOwningPlayer(caster), 'd065', caster_x, caster_y, angle*bj_RADTODEG)
    call SaveUnitHandle(h, id, 10, n)
    call IchigoBankaiQ_Counter(caster)
    call PauseTimer(GetExpiredTimer())
    call TimerStart(GetExpiredTimer(), 0.02, true, function IchigoBankaiQ1_Periodic)
    set caster=null
endfunction

function IchigoBankaiQ1_Cast takes unit newCaster, real point_x, real point_y returns nothing
    local timer newTimer = CreateTimer()
    local integer id = GetHandleId(newTimer)
    local real caster_x = GetUnitX(newCaster)
    local real caster_y = GetUnitY(newCaster)
    local real angle    = AP(caster_x, caster_y, point_x, point_y)
    if GetUnitTypeId(newCaster)=='HIc3' then
        call RemoveEffect(AddSpecialEffectTarget("BDEF (152).mdl", newCaster, "origin"), 2, true, CreateTimer())
        set soundplay=SndN(4131) // Sound\war3mapImported\VastoQ1.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    else
        set soundplay=SndN(4133) // Sound\war3mapImported\IchigoTQ1.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    endif
    call RemoveEffect(AddSpecialEffectTarget("supershinythingyhg2.mdl", newCaster, "right hand"), 1.5, true, CreateTimer())
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd017', caster_x, caster_y, angle*bj_RADTODEG)
    call SetUnitScale(n, 2, 2, 2)
    call SetUnitFlyHeight(n, 170, 0)
    call MyRemoveUnit(n, 1.6)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd007', caster_x, caster_y, angle*bj_RADTODEG)
    call SaveUnitHandle(h, id, 8, n)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd009', caster_x, caster_y, angle*bj_RADTODEG)
    call SetUnitTimeScale(n, 0.7)
    call SetUnitScale(n, 1.2, 1.2, 1.2)
    call MyRemoveUnit(n, 1.0)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd007', caster_x, caster_y, angle*bj_RADTODEG)
    call SaveUnitHandle(h, id, 3, n)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd008', caster_x, caster_y, angle*bj_RADTODEG)
    call SetUnitScale(n, 1.5, 1.5, 1.5)
    //call SetUnitFlyHeight(n, 150, 0)
    call SaveUnitHandle(h, id, 6, n)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(h, id, 1, angle)
    call SaveReal(h, id, 2, 0)
    call SaveGroupHandle(h, id, 4, CreateGroup())
    call SaveGroupHandle(h, id, 5, CreateGroup())
    call SaveReal(h, id, 7, 0)
    call TimerStart(newTimer, 0.2, false, function IchigoBankaiQ1_WaitTime)
    set newTimer=null
endfunction

function IchigoBankaiW_Periodic takes nothing returns nothing
    local integer id  = GetHandleId(GetExpiredTimer())
    local unit caster = LoadUnitHandle(h, id, 0)
    local real caster_x = GetUnitX(caster)
    local real caster_y = GetUnitY(caster)
    local real time     = LoadReal(h, id, 1)
    if time>0 and UnitIsAlive(caster) and GetUnitAbilityLevel(caster, 'IcB1')>0 then
        call PauseUnit(caster, true)
        if LoadBoolean(HH,GetHandleId(caster),TARGET_ABILITY)==false then
            call SaveReal(h, id, 1, time-0.05)
        endif
        if ModuloReal(time,0.2)<0.05 then
            set n=CreateUnit(GetOwningPlayer(caster), 'dM05', caster_x, caster_y, GetRandomInt(0, 360))
            call SetUnitScale(n, 0.5, 0.5, 0.5)
            call SetUnitVertexColor(n, 255, 255, 255, 140)
            call MyRemoveUnit(n, 1.5)
        endif
        if LoadUnitHandle(HH,GetHandleId(caster),REVERSE_TARGET)!=null then
            call IchigoBankaiW_Counter(caster, LoadUnitHandle(HH,GetHandleId(caster),REVERSE_TARGET))
            call RemoveSavedHandle(HH,GetHandleId(caster),REVERSE_TARGET)
        endif
    else
        if LoadBoolean(HH,GetHandleId(caster),ANTITARGET_ABILITY)==true then
            call SetControlToUnit(caster , caster , 0.5 , "doomdebug")
        endif
        call DestroyEffect(LoadEffectHandle(h, id, 3))
        call DestroyEffect(LoadEffectHandle(h, id, 4))
        call SaveBoolean(HH,GetHandleId(caster),ANTITARGET_ABILITY,false)
        call PauseUnit(caster, false)
        call UnitRemoveAbility(caster, 'IcB1')
        call FlushChildHashtable(h, id)
        call PauseTimer(GetExpiredTimer())
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
endfunction

function IchigoBankaiW_Cast takes unit newCaster returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local real caster_x  = GetUnitX(newCaster)
    local real caster_y  = GetUnitY(newCaster)
    set soundplay=SndN(4135) // Sound\war3mapImported\IchigoTW1.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd001', caster_x, caster_y, GetRandomInt(0, 360))
    call SetUnitScale(n, 1.2, 1.2, 1.2)
    call MyRemoveUnit(n, 1.5)
    set bjLCE=AddSpecialEffectTarget("az_airfloww111.mdl", newCaster, "origin")
    call SaveEffectHandle(h, id, 3, bjLCE)
    set bjLCE=AddSpecialEffectTarget("az_airfloww111.mdl", newCaster, "origin")
    call SaveEffectHandle(h, id, 4, bjLCE)
    call UnitAddAbility(newCaster, 'IcB1')
    call UnitMakeAbilityPermanent(newCaster, true, 'IcB1')
    call PauseUnit(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, 4)
    call SaveBoolean(HH,GetHandleId(newCaster),ANTITARGET_ABILITY,true)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(h, id, 1, 2.0)
    call TimerStart(newTimer, 0.05, true, function IchigoBankaiW_Periodic)
    set newTimer=null
endfunction

function IchigoBankaiW_Target takes unit newCaster, unit newTarget returns nothing
        local timer newTimer = CreateTimer()
        local integer id     = GetHandleId(newTimer)
        local real caster_x  = GetUnitX(newCaster)
        local real caster_y  = GetUnitY(newCaster)
        local real angle     =  AU(newCaster, newTarget)
        local real damage    = GetHeroStr(newCaster, true)*8
                        
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd001', caster_x, caster_y, GetRandomInt(0, 360))
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd074', caster_x+200*Cos(angle), caster_y+200*Sin(angle), angle*bj_RADTODEG)
        call SetUnitScale(n, 2, 2, 2)
        call SetUnitFlyHeight(n, 75, 0)
        call UnitApplyTimedLife(n,'BTLF', 0.2)
        call MyRemoveUnit(n, 1.5)
        call UnitRemoveAbility(newCaster, 'IcB1')
        call PauseUnit(newCaster, true)
        call SetUnitInvulnerable(newCaster, true)
        call SetUnitAnimationByIndex(newCaster, 3)
        call SaveUnitHandle(h, id, 0, newCaster)
        call SaveUnitHandle(h, id, 1, newTarget)
        call SaveReal      (h, id, 2, 0.8)
        call SaveReal      (h, id, 3, angle)
        call SaveReal      (h, id, 9, damage)
        call TimerStart(newTimer, 0.02, true, function IchigoBankaiW_CounterPeriodic)
        set newTimer=null
endfunction

function IchigoBankaiE_SIPeriodic takes nothing returns nothing
        local integer id = GetHandleId(GetExpiredTimer())
        local unit dummy = LoadUnitHandle(h, id, 1)
        local real time  = LoadReal(h, id, 2)+0.02
        local real angle = GetUnitFacing(dummy)*bj_DEGTORAD
        call SaveReal(h, id, 2, time)
        if time<0.3 then
                call SetUnitX(dummy, GetUnitX(dummy)+25*Cos(angle))
                call SetUnitY(dummy, GetUnitY(dummy)+25*Sin(angle))
        else
                set n=CreateUnit(GetOwningPlayer(dummy), 'd042', GetUnitX(dummy), GetUnitY(dummy), GetRandomInt(0, 360))
                call SetUnitScale(n, 1, 1, 1)
                call MyRemoveUnit(n, 1.0)
                call RemoveUnit(dummy)
                call FlushChildHashtable(h, id)
                call PauseTimer(GetExpiredTimer())
                call DestroyTimer(GetExpiredTimer())
        endif
        set dummy=null
endfunction

function IchigoBankaiE_SingleImage takes unit newCaster, unit newTarget, real angle returns nothing
        local timer newTimer = CreateTimer()
        local integer id     = GetHandleId(newTimer)
        local real random_real = GetRandomReal(50, 400)
        local real point_x = GetUnitX(newTarget) + random_real*Cos(angle)
        local real point_y = GetUnitY(newTarget) + random_real*Sin(angle)
        local real i       = 1
        if GetRandomInt(0, 1)==0 then
                set i=-1
        endif
        set angle = angle + GetRandomInt(35, 140)*i * bj_DEGTORAD
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd044', point_x, point_y, angle*bj_RADTODEG)
        call SetUnitVertexColor(n, 255, 255, 255, 165)
        call SetUnitAnimationByIndex(n, 2)
        call SetUnitScale(n, 1.1, 1.1, 1.1)
        call SetUnitFlyHeight(n, 5, 0)
        call SaveUnitHandle     (h, id, 1, n)
        call SaveReal           (h, id, 2, 0.0)
        call TimerStart(newTimer, 0.02, true, function IchigoBankaiE_SIPeriodic)
        set newTimer=null
endfunction


function IchigoBankaiE_Periodic2 takes nothing returns nothing
	local integer id = GetHandleId(GetExpiredTimer())
	local unit caster = LoadUnitHandle(h, id, 0)
	local unit target = LoadUnitHandle(h, id, 1)
	local boolean b_act = LoadBoolean(h, id, 11)
	local real time     = LoadReal(h, id, 3)+0.02
	local real damage   = GetHeroStr(caster, true)*7.5
	call SaveReal(h, id, 3, time)
	
	if time<1.0 then
		call IssueImmediateOrder(target, "stop")
        call SetControlToUnit(target, target, 0.2, "silence")
		if time==0.7 then
			call SetUnitAnimationByIndex(caster, GetRandomInt(7, 8))
		endif
	else
		if b_act then
			set damage=damage*1.35
			set n=CreateUnit(GetOwningPlayer(caster), 'd037', GetUnitX(target), GetUnitY(target), AU(caster, target)*bj_RADTODEG)
			call SetUnitFlyHeight(n, 50, 0)
			call SetUnitScale(n, 1.5, 1.5, 1.5)
			call MyRemoveUnit(n, 1.5)
			set n=CreateUnit(GetOwningPlayer(caster), 'd021', GetUnitX(target), GetUnitY(target), AU(caster, target)*bj_RADTODEG)
			call SetUnitFlyHeight(n, 50, 0)
			call SetUnitScale(n, 1.5, 1.5, 1.5)
			call MyRemoveUnit(n, 1.5)
			set n=CreateUnit(GetOwningPlayer(caster), 'd040', GetUnitX(target), GetUnitY(target), AU(caster, target)*bj_RADTODEG)
			call SetUnitFlyHeight(n, 5, 0)
			//call SetUnitScale(n, 1.5, 1.5, 1.5)
			call UnitApplyTimedLife(n,'BTLF', 1.0)
			call MyRemoveUnit(n, 2)
			call ShakeCamera(0.5, 15)
			call Push3(target , 30 , AU(caster, target) , 200 , "")
		else
			call Push3(target , 30 , AU(caster, target) , 100 , "")
			call ShakeCamera(0.5, 10)
		endif
		set soundplay=SndN(4137) // Sound\war3mapImported\IchigoTE2.mp3
		call StartSound(soundplay)
		//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
		set n=CreateUnit(GetOwningPlayer(caster), 'd036', GetUnitX(target), GetUnitY(target), AU(caster, target)*bj_RADTODEG+55)
		call SetUnitFlyHeight(n, 150, 0)
		call SetUnitScale(n, 2, 2, 2)
		call MyRemoveUnit(n, 1.5)
		set n=CreateUnit(GetOwningPlayer(caster), 'd038', GetUnitX(caster), GetUnitY(caster), AU(caster, target)*bj_RADTODEG)
		call SetUnitFlyHeight(n, 50, 0)
		call MyRemoveUnit(n, 1.5)
		set n=CreateUnit(GetOwningPlayer(caster), 'd018', GetUnitX(caster), GetUnitY(caster), AU(caster, target)*bj_RADTODEG)
		call SetUnitFlyHeight(n, 50, 0)
		call SetUnitScale(n, 2, 2, 2)
		call MyRemoveUnit(n, 1.5)
		set n=CreateUnit(GetOwningPlayer(caster), 'd010', GetUnitX(target), GetUnitY(target), AU(caster, target)*bj_RADTODEG)
		call SetUnitFlyHeight(n, 5, 0)
		call SetUnitScale(n, 2, 2, 2)
		call MyRemoveUnit(n, 1.5)
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call myCustomDamage(caster, target, damage, false,false,null,null,null)
        call SetControlToUnit(target, target, 1.0, "stun")
        call FlushChildHashtable(h, id)
        call PauseTimer(GetExpiredTimer())
        call DestroyTimer(GetExpiredTimer())
        endif
        set caster=null
        set target=null
endfunction

function IchigoBankaiE_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local unit caster = LoadUnitHandle(h, id, 0) 
    local unit target = LoadUnitHandle(h, id, 1)
    local real target_x= GetUnitX(target)
    local real target_y= GetUnitY(target)
    local real angle= AP(target_x, target_y, LoadReal(h, id, 7), LoadReal(h, id, 8))
    local real time= LoadReal(h, id, 3)+0.02
    local integer eff_period= LoadInteger(h, id, 5)
    local integer eff_period2= LoadInteger(h, id, 6)
    
    call SaveReal(h, id, 3, time)
    
    if time<2.5 and UnitIsAlive(target) and SquareRootPoint(target_x, target_y, LoadReal(h, id, 7), LoadReal(h, id, 8))<500 then
        call IchigoBankaiE_SingleImage(caster, target, angle+GetRandomInt(0, 360)*bj_DEGTORAD)
    else
        call KillUnit(LoadUnitHandle(h, id, 9))
        call KillUnit(LoadUnitHandle(h, id, 10))
        call MyRemoveUnit(LoadUnitHandle(h, id, 9), 1.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, 10), 1.5)
        call ShowUnit(caster, true)
        if GetLocalPlayer()==GetOwningPlayer(caster) then
            call ClearSelection()
            call SelectUnit(caster, true)
        endif
        call SaveReal(h, id, 3, 0.0)
        if UnitIsAlive(target) then
            call SetUnitX(caster, target_x+150*Cos(angle))
            call SetUnitY(caster, target_y+150*Sin(angle))
            if LoadBoolean(HH,GetHandleId(target),ANTITARGET_ABILITY)==false then
                call PauseUnit(caster, true)
                call SetUnitInvulnerable(caster, true)
                call SetUnitFacing(caster, angle*bj_RADTODEG-180)
                if SquareRootPoint(target_x, target_y, LoadReal(h, id, 7), LoadReal(h, id, 8))<500 then
                    call SaveBoolean(h, id, 11, false)
                else
                    set n=CreateUnit(GetOwningPlayer(caster), 'd020', GetUnitX(caster), GetUnitY(caster), AU(caster, target)*bj_RADTODEG)
                    call SetUnitFlyHeight(n, 5, 0)
                    //call SetUnitScale(n, 1.5, 1.5, 1.5)
                    call MyRemoveUnit(n, 1.5)
                    call SaveBoolean(h, id, 11, true)
                endif
                set n=CreateUnit(GetOwningPlayer(caster), 'd011', GetUnitX(caster), GetUnitY(caster), 0)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'dM30', GetUnitX(caster), GetUnitY(caster), 0)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'd009', GetUnitX(caster), GetUnitY(caster), 0)
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call MyRemoveUnit(n, 1.5)
                call PauseTimer(GetExpiredTimer())
                call TimerStart(GetExpiredTimer(), 0.02, true, function IchigoBankaiE_Periodic2)
            else
                set n=CreateUnit(GetOwningPlayer(caster), 'd011', GetUnitX(caster), GetUnitY(caster), 0)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'dM30', GetUnitX(caster), GetUnitY(caster), 0)
                call MyRemoveUnit(n, 1.5)
                call SetUnitVertexColor(caster, 255, 255, 255, 255)
                call SetUnitFlyHeight(caster, 0, 0)
		        call SetUnitFlyHeight(target, 0, 0)
                call PauseUnit(caster,false)
                call SaveUnitHandle(HH,GetHandleId(target),REVERSE_TARGET,caster)
                call SetUnitInvulnerable(caster,false)
                call FlushChildHashtable(h,id)
                call DestroyTimer(GetExpiredTimer())
            endif    
        else
            set n=CreateUnit(GetOwningPlayer(caster), 'd011', LoadReal(h, id, 7), LoadReal(h, id, 8), 0)
            call MyRemoveUnit(n, 1.5)
            set n=CreateUnit(GetOwningPlayer(caster), 'dM30', LoadReal(h, id, 7), LoadReal(h, id, 8), 0)
            call MyRemoveUnit(n, 1.5)
            call PauseUnit(caster, false)
            call SetUnitInvulnerable(caster, false)
            call SetUnitX(caster, LoadReal(h, id, 7))
            call SetUnitY(caster, LoadReal(h, id, 8))
            call FlushChildHashtable(h, id)
            call PauseTimer(GetExpiredTimer())
            call DestroyTimer(GetExpiredTimer())
        endif
    endif
    set caster=null
    set target=null
endfunction

function IchigoBankaiE_Cast takes unit newCaster, unit newTarget returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local real caster_x  = GetUnitX(newCaster)
    local real caster_y  = GetUnitY(newCaster)
    local real damage    = GetHeroStr(newCaster, true)*6
    set soundplay=SndN(4140) // Sound\war3mapImported\IchigoTE1.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd011', caster_x, caster_y, 0)
    //call SetUnitScale(n, 1.5, 1.5, 1.5)
    call MyRemoveUnit(n, 1.5)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM30', caster_x, caster_y, 0)
    //call SetUnitScale(n, 1.5, 1.5, 1.5)
    call MyRemoveUnit(n, 1.5)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd043', GetUnitX(newTarget), GetUnitY(newTarget), 0)
    call SetUnitScale(n, 5.5, 5.5, 5.5)
    call SetUnitVertexColor(n, 255, 255, 255, 150)
    call SetUnitFlyHeight(n, 50, 0)
    call SaveUnitHandle(h, id, 9, n)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd043', GetUnitX(newTarget), GetUnitY(newTarget), 0)
    call SetUnitScale(n, 5.5, 5.5, 5.5)
    call SetUnitFlyHeight(n, 50, 0)
    call SaveUnitHandle(h, id, 10, n)
    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
    call ShowUnit(newCaster, false)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveUnitHandle(h, id, 1, newTarget)
    call SaveReal      (h, id, 2, damage)
    call SaveReal      (h, id, 3, 0.0)
    call SaveReal      (h, id, 7, GetUnitX(newTarget))
    call SaveReal      (h, id, 8, GetUnitY(newTarget))
    call TimerStart(newTimer, 0.02, true, function IchigoBankaiE_Periodic)
    set newTimer=null
endfunction

function IchigoBankaiR_Periodic2 takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local unit caster = LoadUnitHandle(h, id, 0) 
    local unit target = LoadUnitHandle(h, id, 1)
    local real caster_x= GetUnitX(caster)
    local real caster_y= GetUnitY(caster)
    local real target_x= GetUnitX(target)
    local real target_y= GetUnitY(target)
    local real angle= LoadReal(h, id, 4)
    local real time= LoadReal(h, id, 3)
    local integer eff_period= LoadInteger(h, id, 5)
    local integer eff_period2= LoadInteger(h, id, 6)
    local real bonus_damage = LoadReal(h, id, 2)*(1-GetWidgetLife(target)/GetWidgetMaxLife(target))
    if time < 2.75 and IsUnitAlive(caster)==true and IsUnitAlive(target)==true  then
        call SaveReal(h, id, 3, time + 0.02)
        call PauseUnit(caster, true)
        call PauseUnit(target,true)
        call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
        call SetUnitInvulnerable(caster, true)
        call SetUnitInvulnerable(target, true)
        call SetUnitX(LoadUnitHandle(h, id, 5), caster_x)
        call SetUnitY(LoadUnitHandle(h, id, 5), caster_y)
                        
        if time == 0.1 then
                        // set n=CreateUnit(GetOwningPlayer(caster), 'd014', target_x, target_y, angle*bj_DEGTORAD)
                        // call SetUnitScale(n, 1.5, 1.5, 1.5)
                        // call SetUnitFlyHeight(n, 10, 0)
                        // call MyRemoveUnit(n, 1.5)
        endif
        if time == 0.8 then
            call ShakeCamera(0.3 , 10)
            call RengokuE_Shifting(caster , target , angle , 300 , CreateTimer())
            // call SetUnitX(caster, target_x - 100 * Cos(angle))
            // call SetUnitY(caster, target_y - 100 * Sin(angle))
            set caster_x=GetUnitX(caster)
            set caster_y=GetUnitY(caster)
        endif
        if time > 0.0 then
            set angle = LoadReal(h, id, 4)
            if LoadInteger(h, id, 34)==0 then
                    set angle = GetRandomInt(0, 360)*bj_DEGTORAD
                    call SaveReal(h, id, 4, angle)
                    call SaveInteger(h, id, 34, 30)
            else
                    call SaveInteger(h, id, 34, LoadInteger(h, id, 34)-1)
            endif
                        //call RengokuE_Shifting(caster , target , angle , 100 , CreateTimer())
            call SetUnitX(target, target_x + 25 * Cos(angle))
            call SetUnitY(target, target_y + 25 * Sin(angle))
            call SetUnitX(caster, target_x - 100 * Cos(angle))
            call SetUnitY(caster, target_y - 100 * Sin(angle))
            call SetUnitFacing(caster, AU(caster, target)*bj_RADTODEG)
            
            if eff_period2 == 0 then
                set n=CreateUnit(GetOwningPlayer(caster), 'd036', target_x, target_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call SetUnitFlyHeight(n, 200, 0)
                call MyRemoveUnit(n, 1.5)
                                set n=CreateUnit(GetOwningPlayer(caster), 'dM20', target_x, target_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call SetUnitFlyHeight(n, 5, 0)
                call MyRemoveUnit(n, 1.5)
                                
                call SaveInteger(h, id, 6, 3)
            else
                call SaveInteger(h, id, 6, eff_period2 - 1)
            endif
                        
            if eff_period == 0 then
                set n=CreateUnit(GetOwningPlayer(caster), 'd035', target_x, target_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 0.55, 0.55, 0.55)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'd010', target_x, target_y, angle*bj_DEGTORAD)
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call SetUnitFlyHeight(n, 20, 0)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'd018', target_x, target_y, angle*bj_DEGTORAD)
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call SetUnitFlyHeight(n, 75, 0)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'd048', target_x, target_y, angle*bj_DEGTORAD)
                call SetUnitScale(n, 1.0, 1.0, 1.0)
                call SetUnitTimeScale(n, 1.25)
                call SetUnitFlyHeight(n, 25, 0)
                call UnitApplyTimedLife(n,'BTLF', 1.0)
                call MyRemoveUnit(n, 1.5)
                                
                call SaveInteger(h, id, 5, 7)
                if GetRandomInt(0, 3) == 0 then
                    call SetUnitAnimation(caster, "attack")
                endif
            else
                call SaveInteger(h, id, 5, eff_period - 1)
            endif
        endif
    else
        call ShowUnit(caster, true)
        if GetLocalPlayer()==GetOwningPlayer(caster) then
            call ClearSelection()
            call SelectUnit(caster, true)
        endif
        call ShakeCamera(0.3 , 15)
        call RengokuE_Shifting(caster , target , angle , 300 , CreateTimer())
        set n=CreateUnit(GetOwningPlayer(caster), 'd037', target_x, target_y, GetRandomInt(0, 360))
        //call SetUnitScale(n, 2.5, 2.5, 2.5)
        call SetUnitFlyHeight(n, 50, 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'd037', target_x, target_y, GetRandomInt(0, 360))
        //call SetUnitScale(n, 2.5, 2.5, 2.5)
        call SetUnitFlyHeight(n, 50, 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'd037', target_x, target_y, GetRandomInt(0, 360))
        //call SetUnitScale(n, 2.5, 2.5, 2.5)
        call SetUnitFlyHeight(n, 50, 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'd032', target_x, target_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 2.5, 2.5, 2.5)
        call SetUnitFlyHeight(n, 150, 0)
        call MyRemoveUnit(n, 1.5)

        set n=CreateUnit(GetOwningPlayer(caster), 'd021', target_x, target_y, GetRandomInt(0, 360)) 
        call SetUnitScale(n, 1.8, 1.8, 1.8)
        call SetUnitFlyHeight(n, 10, 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'd009', target_x, target_y, GetRandomInt(0, 360)) 
        call SetUnitScale(n, 1.8, 1.8, 1.8)
        call SetUnitFlyHeight(n, 10, 0)
        call MyRemoveUnit(n, 1.5)

        set n=CreateUnit(GetOwningPlayer(caster), 'dM11', caster_x, caster_y,  AU(caster, target)*bj_RADTODEG)
        call SetUnitFlyHeight(n, 75, 0)
        call SetUnitScale(n, 1.0, 1.0, 1.0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'd020', caster_x, caster_y,  AU(caster, target)*bj_RADTODEG)
        call SetUnitFlyHeight(n, 75, 0)
        call SetUnitAnimationByIndex(n, 1)
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call MyRemoveUnit(n, 1.5)

        set n=CreateUnit(GetOwningPlayer(caster), 'd066', target_x, target_y,  AU(caster, target)*bj_RADTODEG)
        call SetUnitFlyHeight(n, 100, 0)
        call SetUnitTimeScale(n, 0.75)
        call SetUnitScale(n, 2, 2, 2)
        call MyRemoveUnit(n, 1.5)



        call RemoveUnit(LoadUnitHandle(h, id, 5))
        call PauseUnit(caster, false)
        call PauseUnit(target,false)
        call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
        call SetUnitInvulnerable(caster, false)
        call SetUnitInvulnerable(target, false)
        if (1-GetWidgetLife(target)/GetWidgetMaxLife(target))>0.5 then
            set bonus_damage=LoadReal(h, id, 2)*0.5
        endif
        call myCustomDamage(caster, target, LoadReal(h, id, 2)+bonus_damage, false,false,null,null,null)
        call FlushChildHashtable(h, id)
        call PauseTimer(GetExpiredTimer())
        call DestroyTimer(GetExpiredTimer())
    endif
    set target=null
    set caster=null
endfunction

function IchigoBankaiR_Periodic1 takes nothing returns nothing
        local integer id = GetHandleId(GetExpiredTimer())
        local unit caster = LoadUnitHandle(h, id, 0)
        local real caster_x = GetUnitX(caster)
        local real caster_y = GetUnitY(caster)
        local real time = LoadReal(h, id, 3)+0.02
        local integer eff_period= LoadInteger(h, id, 5)
        local real angle   = AU(caster, LoadUnitHandle(h, id, 1))
        call SaveReal(h, id, 3, time)
        if time<2 and IsUnitAlive(caster)==true and IsUnitAlive(LoadUnitHandle(h, id, 1))==true then
            call PauseUnit(caster, true)
            call SetUnitInvulnerable(caster, true)
            if time<1.3 then
                call SetUnitFacing(caster, AU(caster, LoadUnitHandle(h, id, 1))*bj_RADTODEG)
                call SetUnitX(LoadUnitHandle(h, id, 5), caster_x)
                call SetUnitY(LoadUnitHandle(h, id, 5), caster_y)
        
                if eff_period == 0 then
                    set n=CreateUnit(GetOwningPlayer(caster), 'dM42', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360)) 
                    call SetUnitScale(n, 1+time*0.8, 1+time*0.8, 1+time*0.8)
                    call SetUnitVertexColor(n, 255, 150, 150, 75)
                    call SetUnitFlyHeight(n, 10, 0)
                    call MyRemoveUnit(n, 1.5)
                    set n=CreateUnit(GetOwningPlayer(caster), 'd009', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360)) 
                    call SetUnitScale(n, 1+time*0.8, 1+time*0.8, 1+time*0.8)
                    call SetUnitFlyHeight(n, 10, 0)
                    call MyRemoveUnit(n, 1.5)
                    set n=CreateUnit(GetOwningPlayer(caster), 'd020', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360)) 
                    //call SetUnitScale(n, 1.5, 1.5, 1.5)
                    call SetUnitFlyHeight(n, 10, 0)
                    call MyRemoveUnit(n, 1.5)
                            
                    call SaveInteger(h, id, 5, 7)
                else
                    call SaveInteger(h, id, 5, eff_period - 1)
                endif
            endif
                
            if time==1.5 then
                if LoadBoolean(HH,GetHandleId(LoadUnitHandle(h, id, 1)),ANTITARGET_ABILITY)==false then
                    call ShowUnit(caster, false)
                    set n=CreateUnit(GetOwningPlayer(caster), 'd020', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360)) 
                    call SetUnitScale(n, 1.5, 1.5, 1.5)
                    call SetUnitFlyHeight(n, 10, 0)
                    call MyRemoveUnit(n, 1.5)
                    set n=CreateUnit(GetOwningPlayer(caster), 'd021', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360)) 
                    call SetUnitScale(n, 1.8, 1.8, 1.8)
                    call SetUnitFlyHeight(n, 10, 0)
                    call MyRemoveUnit(n, 1.5)
                    set n=CreateUnit(GetOwningPlayer(caster), 'd009', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360)) 
                    call SetUnitScale(n, 1.8, 1.8, 1.8)
                    call SetUnitFlyHeight(n, 10, 0)
                    call MyRemoveUnit(n, 1.5)
                            
                    set n=CreateUnit(GetOwningPlayer(caster), 'dM30', GetUnitX(caster), GetUnitY(caster),  AU(caster, LoadUnitHandle(h, id, 1))*bj_RADTODEG)
                    call SetUnitFlyHeight(n, 30, 0)
                    call SetUnitScale(n, 1.5, 1.5, 1.5)
                    call MyRemoveUnit(n, 1.5)
                    set n=CreateUnit(GetOwningPlayer(caster), 'dM30', GetUnitX(caster), GetUnitY(caster),  AU(caster, LoadUnitHandle(h, id, 1))*bj_RADTODEG)
                    call SetUnitFlyHeight(n, 30, 0)
                    call SetUnitScale(n, 1.5, 1.5, 1.5)
                    call MyRemoveUnit(n, 1.5)
                    set n=CreateUnit(GetOwningPlayer(caster), 'dM38', GetUnitX(caster), GetUnitY(caster),  AU(caster, LoadUnitHandle(h, id, 1))*bj_RADTODEG)
                    call SetUnitFlyHeight(n, 30, 0)
                    call SetUnitScale(n, 1.5, 1.5, 1.5)
                    call MyRemoveUnit(n, 1.5)
                    
                    set n=CreateUnit(GetOwningPlayer(caster), 'd011', GetUnitX(caster), GetUnitY(caster),  AU(caster, LoadUnitHandle(h, id, 1))*bj_RADTODEG)
                    call SetUnitFlyHeight(n, 20, 0)
                    call SetUnitScale(n, 1.5, 1.5, 1.5)
                    call MyRemoveUnit(n, 1.5)
                else
                    call StopSound(LoadSoundHandle(h, id, 102), false, true) // звук из массива — останавливаем, не удаляем
                    set angle = AU(caster, LoadUnitHandle(h, id, 1))
                    call SetUnitX(caster, GetUnitX(LoadUnitHandle(h, id, 1))-150*Cos(angle))
                    call SetUnitY(caster, GetUnitY(LoadUnitHandle(h, id, 1))-150*Sin(angle))
                    call RemoveUnit(LoadUnitHandle(h, id, 5))
                    call PauseUnit(caster, false)
                    call PauseUnit(LoadUnitHandle(h, id, 1),false)
                    call SaveUnitHandle(HH,GetHandleId(LoadUnitHandle(h, id, 1)),REVERSE_TARGET,caster)
                    call SaveBoolean(HH,GetHandleId(LoadUnitHandle(h, id, 1)),TARGET_ABILITY,false)
                    call SetUnitInvulnerable(caster, false)
                    call SetUnitInvulnerable(LoadUnitHandle(h, id, 1), false)
                    call FlushChildHashtable(h, id)
                    call PauseTimer(GetExpiredTimer())
                    call DestroyTimer(GetExpiredTimer())
                endif
            endif
                
        elseif IsUnitAlive(caster)==true and IsUnitAlive(LoadUnitHandle(h, id, 1))==true then
            call ShakeCamera(0.3 , 15)
            set n=CreateUnit(GetOwningPlayer(caster), 'd036', GetUnitX(LoadUnitHandle(h, id, 1)), GetUnitY(LoadUnitHandle(h, id, 1)),  GetRandomInt(0, 360))
            call SetUnitScale(n, 2.5, 2.5, 2.5)
            call SetUnitFlyHeight(n, 200, 0)
            call MyRemoveUnit(n, 2.5)
            set n=CreateUnit(GetOwningPlayer(caster), 'd037', GetUnitX(LoadUnitHandle(h, id, 1)), GetUnitY(LoadUnitHandle(h, id, 1)),  GetRandomInt(0, 360))
            call SetUnitScale(n, 1.5, 1.5, 1.5)
            call SetUnitFlyHeight(n, 5, 0)
            call MyRemoveUnit(n, 2.5)
            set n=CreateUnit(GetOwningPlayer(caster), 'd037', GetUnitX(LoadUnitHandle(h, id, 1)), GetUnitY(LoadUnitHandle(h, id, 1)),   GetRandomInt(0, 360))
            call SetUnitScale(n, 1.5, 1.5, 1.5)
            call SetUnitFlyHeight(n, 5, 0)
            call MyRemoveUnit(n, 2.5)
            set n=CreateUnit(GetOwningPlayer(caster), 'd037', GetUnitX(LoadUnitHandle(h, id, 1)), GetUnitY(LoadUnitHandle(h, id, 1)),  GetRandomInt(0, 360))
            call SetUnitScale(n, 1.5, 1.5, 1.5)
            call SetUnitFlyHeight(n, 5, 0)
            call MyRemoveUnit(n, 2.5)
                    
            set n=CreateUnit(GetOwningPlayer(caster), 'd032', GetUnitX(LoadUnitHandle(h, id, 1)), GetUnitY(LoadUnitHandle(h, id, 1)),  GetRandomInt(0, 360))
            call SetUnitScale(n, 2.5, 2.5, 2.5)
            call SetUnitFlyHeight(n, 150, 0)
            call MyRemoveUnit(n, 2.5)
                    
            set n=CreateUnit(GetOwningPlayer(caster), 'd010', GetUnitX(caster), GetUnitY(caster),  AU(caster, LoadUnitHandle(h, id, 1))*bj_RADTODEG)
            call SetUnitFlyHeight(n, 20, 0)
            call SetUnitScale(n, 1.8, 1.8, 1.8)
            call MyRemoveUnit(n, 2.5)
                    
            set n=CreateUnit(GetOwningPlayer(caster), 'd014', GetUnitX(caster), GetUnitY(caster),  AU(caster, LoadUnitHandle(h, id, 1))*bj_RADTODEG)
            call SetUnitFlyHeight(n, 50, 0)
            call MyRemoveUnit(n, 2.5)
                    
                    
            set angle = AU(caster, LoadUnitHandle(h, id, 1))
            call SetUnitX(caster, GetUnitX(LoadUnitHandle(h, id, 1))-150*Cos(angle))
            call SetUnitY(caster, GetUnitY(LoadUnitHandle(h, id, 1))-150*Sin(angle))
            call PauseUnit(LoadUnitHandle(h, id, 1), true)
            call SaveBoolean(HH,GetHandleId(LoadUnitHandle(h, id, 1)),TARGET_ABILITY,true)
            call SetUnitInvulnerable(LoadUnitHandle(h, id, 1), true)
            call SaveReal(h, id, 3, 0.0)
            call SaveReal(h, id, 4, angle)
            call SaveInteger(h, id, 34, 30)
            call PauseTimer(GetExpiredTimer())
            call TimerStart(GetExpiredTimer(), 0.02, true, function IchigoBankaiR_Periodic2)
        else
            call StopSound(LoadSoundHandle(h, id, 102), false, true) // звук из массива — останавливаем, не удаляем
            call RemoveUnit(LoadUnitHandle(h, id, 5))
            call ShowUnit(caster, true)
            if GetLocalPlayer()==GetOwningPlayer(caster) then
                call ClearSelection()
                call SelectUnit(caster, true)
            endif
            call PauseUnit(caster, false)
            call PauseUnit(LoadUnitHandle(h, id, 1),false)
            call SaveBoolean(HH,GetHandleId(LoadUnitHandle(h, id, 1)),TARGET_ABILITY,false)
            call SetUnitInvulnerable(caster, false)
            call SetUnitInvulnerable(LoadUnitHandle(h, id, 1), false)
            call FlushChildHashtable(h, id)
            call PauseTimer(GetExpiredTimer())
            call DestroyTimer(GetExpiredTimer())
        endif
        set caster=null
endfunction

function IchigoBankaiR_Cast takes unit newCaster, unit newTarget returns nothing
        local timer newTimer = CreateTimer()
        local integer id     = GetHandleId(newTimer)
        local real caster_x  = GetUnitX(newCaster)
        local real caster_y  = GetUnitY(newCaster)
        local real damage    = GetHeroStr(newCaster, true)*9
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dM32', caster_x, caster_y,  0)
        call SetUnitFlyHeight(n, 10, 0)
        call SetUnitVertexColor(n, 255, 255, 255, 100)
        call SetUnitScale(n, 2, 2, 2)
        call UnitApplyTimedLife(n,'BTLF', 2)
        call MyRemoveUnit(n, 2.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd041', caster_x, caster_y,  0)
        call SetUnitFlyHeight(n, 10, 0)
        call SetUnitVertexColor(n, 255, 255, 255, 100)
        call SaveUnitHandle(h, id, 5, n)
                
        call PauseUnit(newCaster, true)
        call SetUnitInvulnerable(newCaster, true)
        call DestroyEffect(AddSpecialEffectTarget("supershinythingyhg2.mdl", newCaster, "chest"))
        call DestroyEffect(AddSpecialEffectTarget("AZ_Alleria_R3.mdl", newCaster, "hand"))
        call SaveUnitHandle(h, id, 0, newCaster)
        call SaveUnitHandle(h, id, 1, newTarget)
        call SaveReal      (h, id, 2, damage)
        call SaveReal      (h, id, 3, 0.0)
        if GetUnitTypeId(newCaster)=='HIc3' then
            call SaveReal  (h, id, 3, 1.1)
            call RemoveEffect(AddSpecialEffectTarget("BDEF (152).mdl", newCaster, "origin"), 4, true, CreateTimer())
            set soundplay=SndN(4142) // Sound\war3mapImported\VastoT.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay)
        else
            if GetRandomInt(0, 1)==0 then
                set soundplay=SndN(4144) // Sound\war3mapImported\IchigoTR.mp3
            else
                set soundplay=SndN(4146) // Sound\war3mapImported\IchigoTR2.mp3
            endif
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay)
        endif
        call SaveSoundHandle(h, id, 102, soundplay)
        call TimerStart(newTimer, 0.02, true, function IchigoBankaiR_Periodic1)
        set newTimer=null
endfunction


function IchigoBankaiD_Indicator takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local unit newCaster=LoadUnitHandle(h, id, 0)
    local real waste=LoadReal(h, id, 1)
    call TextTagFull3("-" + I2S(R2I(waste)) , newCaster , 0 , 170 , 255 , 255 , GetOwningPlayer(newCaster) , 0.03)
    call FlushChildHashtable(h, id)
    call DestroyTimer(GetExpiredTimer())
    set newCaster=null
endfunction

function IchigoBankaiD_CalculateMana takes unit newCaster returns nothing
    local integer stack = LoadInteger(HH, GetHandleId(newCaster), 1123)
    local real manacost = 100
    local real waste = 100
    local integer i=0
    loop
    exitwhen i>=stack
        set waste = waste + 0.10*waste
        set i=i+1
    endloop
    call SetWidgetMana(newCaster, GetWidgetMana(newCaster)-(waste-100))
    call SaveInteger(HH, GetHandleId(newCaster), 1123, stack+1)
    set bjLCT=CreateTimer()
    call SaveUnitHandle(h, GetHandleId(bjLCT), 0, newCaster)
    call SaveReal(h, GetHandleId(bjLCT), 1, waste)
    call TimerStart(bjLCT, 0.02, false, function IchigoBankaiD_Indicator)
endfunction

function IchigoVasterW_Cast takes unit newCaster, unit newTarget returns nothing
    local real caster_x = GetUnitX(newCaster)
    local real caster_y = GetUnitY(newCaster)
    local real target_x = GetUnitX(newTarget)
    local real target_y = GetUnitY(newTarget)
    local real angle    = AU(newCaster, newTarget)
    local real damage   = GetHeroStr(newCaster, true)*2 + GetUnitTotalDamage(newCaster)*3
    set soundplay=SndN(4148) // Sound\war3mapImported\Sonido.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set soundplay=SndN(4150) // Sound\war3mapImported\VastoW.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call SetUnitXY(newCaster, target_x-150*Cos(angle), target_y-150*Sin(angle))
    
    if LoadBoolean(HH,GetHandleId(newTarget),ANTITARGET_ABILITY)==false then
        call myCustomDamage(newCaster, newTarget, damage, false,false,null,null,null)
        call SetControlToUnit(newTarget, newTarget, 2.0, "silenceTE")
        call SlowUnit(newCaster,newTarget,0.9,0,2,2,false)
        call UnitAddAbility(newTarget,'Ao53')
        call UnitRemoveAbilityTimedPause(newTarget,'Ao53',2)
        call UnitAddAbility(newTarget,'Ao3Z')
        call UnitRemoveAbilityTimedPause(newTarget,'Ao3Z',2)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd042', caster_x, caster_y, 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd042', GetUnitX(newCaster), GetUnitY(newCaster), 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd068', target_x, target_y, 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd070', target_x, target_y, 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd021', target_x, target_y, 0)
        call SetUnitScale(n, 2, 2, 2)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd010', target_x, target_y, 0)
        call SetUnitScale(n, 2, 2, 2)
        call MyRemoveUnit(n, 1.5)
        
        call RemoveEffect(AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl", newCaster, "rallypoint"), 2, true, CreateTimer())
        call RemoveEffect(AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl", newCaster, "first sprite"), 2, true, CreateTimer())
        call RemoveEffect(AddSpecialEffectTarget("BDEF_102_Attach.mdl", newCaster, "hand right"), 2, true, CreateTimer())
    else
        call SaveUnitHandle(HH,GetHandleId(newTarget),REVERSE_TARGET,newCaster)
    endif
endfunction

function IchigoVasterE_Periodic takes nothing returns nothing
	local timer t=GetExpiredTimer()
	local integer id=GetHandleId(t)
	local unit u=LoadUnitHandle(h,id,0)
	local real x=GetUnitX(u)
	local real y=GetUnitY(u)
	local player p=GetOwningPlayer(u)
	local real dmg=(1.3+.2*5)*(GetHeroStr(u,true))*0.2
	if GetUnitCurrentOrder(u)==OrderId("curse")then
		call GroupEnumUnitsInRange(G,x,y,800,Base)
		call SetUnitInvulnerable(u,true)
		call SetUnitAnimation(u,"stand")
		call UnitApplyTimedLife(CreateUnit(p,'e0J9',x,y,GetRandomReal(0,359)),'BTLF',1)
		call UnitApplyTimedLife(CreateUnit(p,'e0JD',x,y,GetRandomReal(0,359)),'BTLF',1)
		call UnitApplyTimedLife(CreateUnit(p,'e0JB',x,y,GetRandomReal(0,359)),'BTLF',1)
		loop
		set E=FirstOfGroup(G)
		exitwhen E==null
		if Condition_Base(p,E)then
			call myCustomDamage(u,E,dmg,false,false,null,null,null)
            call SlowUnit(u,E,0.5,0,5,0,false)
		endif
		call GroupRemoveUnit(G,E)
		endloop
		
		call SetUnitInvulnerable(u,true)
		if LoadInteger(h, id, 1)>=3 then
            call HealTextTag(u,u,GetWidgetMaxLife(u)*0.01*0.68*myCustomHeal2(u,1),"HealthRes")
			call SetWidgetLife(u, GetWidgetLife(u)+GetWidgetMaxLife(u)*0.01*0.68)
			call SaveInteger(h, id, 1, 0)
		else
			call SaveInteger(h, id, 1, LoadInteger(h, id, 1)+1)
		endif
	else
		call DestroyEffect(LoadEffectHandle(h, id, 2))
		call SetUnitInvulnerable(u,false)
		call PauseTimer(t)
		call DestroyTimer(t)
		call FlushChildHashtable(h,id)
	endif
	set p=null
	set u=null
	set t=null
endfunction
function IchigoVasterE_Cast takes unit u returns nothing
        local timer t=CreateTimer()
        local integer id=GetHandleId(t)
        call SaveUnitHandle(h,id,0,u)
        call SaveInteger(h, id, 1, 0) 
        call SaveEffectHandle(h, id, 2, AddSpecialEffectTarget("chushou_by_wood_effect_huozhu_black.mdl", u, "origin"))
        call ShakeCamera(0.2, 10)
        set soundplay=SndN(4152) // Sound\Music\mp3Music\HollowRoar.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        set n=CreateUnit(GetOwningPlayer(u), 'd061', GetUnitX(u), GetUnitY(u), GetRandomInt(0, 360))
        call UnitScale(n, 0.5, 2, 0.5)
        call UnitApplyTimedLife(n,'BTLF', 1.7)
        call MyRemoveUnit(n, 2.5)
        call SetUnitInvulnerable(u,true)
        call TimerStart(t,0.17,true,function IchigoVasterE_Periodic)
        set u=null
        set t=null
endfunction

function IchigoVasterR_Periodic takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(h,id,0)
        local unit l__d=LoadUnitHandle(h,id,1)
        local real a=LoadReal(h,id,4)
        local real dist=LoadReal(h,id,10)
        local real x=GetUnitX(l__d)+65*Cos(a)
        local real y=GetUnitY(l__d)+65*Sin(a)
        local real dmg=10*GetHeroStr(u,true)
        local player p=GetOwningPlayer(u)
        local group g=LoadGroupHandle(h,id,3)
        local integer eff_period = LoadInteger(h, id, 12)
        if dist>0 and IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
                call SetUnitXY_1(l__d,x,y, false)
                //call UnitApplyTimedLife(CreateUnit(p,'e0J2',x,y,GetRandomReal(0,359)),'BTLF',3)
                //call UnitApplyTimedLife(CreateUnit(p,'e0J5',x,y,GetRandomReal(0,359)),'BTLF',4)

		set soundplay=SndN(4154) // Sound\Music\mp3Music\Hit.wav
		call StartSound(soundplay)
		//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
		//call UnitApplyTimedLife(CreateUnit(p,'e0J4',x,y,GetRandomReal(0,359)),'BTLF',4)
		//call UnitApplyTimedLife(CreateUnit(p,'e0J3',x,y,GetRandomReal(0,359)),'BTLF',4)
		if dist<2700 then
			set n=CreateUnit(p, 'd062', x, y, 0)
			call SetUnitScale(n, 2, 2, 2)
			call SetUnitFlyHeight(n, 50, 0)
			call UnitApplyTimedLife(n,'BTLF', 1.3)
			call MyRemoveUnit(n, 1.7)
		endif
		
		if eff_period == 0 then
			set n=CreateUnit(GetOwningPlayer(u), 'dR99', x+50*Cos(a+45*bj_DEGTORAD), y+50*Sin(a+45*bj_DEGTORAD), a*bj_RADTODEG-120)
			call SetUnitScale(n, 2, 2, 2)
			call UnitApplyTimedLife(n,'BTLF', 1.5)
			set n=CreateUnit(GetOwningPlayer(u), 'dR99', x+50*Cos(a-45*bj_DEGTORAD), y+50*Sin(a-45*bj_DEGTORAD), a*bj_RADTODEG+120)
			call SetUnitScale(n, 2, 2, 2)
			call UnitApplyTimedLife(n,'BTLF', 1.5)
			call SaveInteger(h, id, 12, 2)
		else
			call SaveInteger(h, id, 12, eff_period-1)
		endif
		
		call GroupEnumUnitsInRange(g,x,y,350,Base)
		set idg=GetHandleId(g)
		call SaveReal(h,id,10,dist-65)
		loop
			set E=FirstOfGroup(g)
			set ide=GetHandleId(E)
			if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
				call myCustomDamage(u,E,dmg,false,false,null,null,null)
				call SaveUnitHandle(h,idg,ide,E)
				call SetControlToUnit(E,E, 3, "stun")
			endif
			call GroupRemoveUnit(g,E)
		exitwhen E==null
		endloop
	else
		call SetTerrainFogExBJ(0,6000.00,10000,0,1,1,1)
		call SetUnitInvulnerable(u,false)
		call RemoveUnit(l__d)
		call FlushChildHashtable(h,GetHandleId(g))
		call DestroyGroup(g)
		call PauseTimer(t)
		call DestroyTimer(t)
		call FlushChildHashtable(h,id)
	endif
	set g=null
	set u=null
	set t=null
	set l__d=null
	set p=null
endfunction

function IchigoVasterR_WaitTime takes nothing returns nothing
    local integer id = GetHandleId(GetExpiredTimer())
    local unit caster   = LoadUnitHandle(h, id, 0)
    local unit dummy    = LoadUnitHandle(h, id, 12)
    local real caster_x = GetUnitX(caster)
    local real caster_y = GetUnitY(caster)
    local real angle = GetUnitFacing(caster)*bj_DEGTORAD
    local real time  = LoadReal(h, id, 11)+0.05
    local trigger tt = LoadTriggerHandle(h, id, 10)
    local integer eff_period = LoadInteger(h, id, 12)
    
    call SaveReal(h, id, 11, time)
    
    if time<1.25 then
        call SetControlToUnit(caster, caster, 0.25, "doomdebug")
        call SetUnitX(dummy, caster_x+150*Cos(angle))
        call SetUnitY(dummy, caster_y+150*Sin(angle))
        if eff_period<=0 then
            call SetUnitAnimationByIndex(caster, 14)
            set n=CreateUnit(GetOwningPlayer(caster), 'd060', GetUnitX(dummy), GetUnitY(dummy), angle*bj_RADTODEG)
            call SetUnitScale(n, 4.5, 4.5, 4.5)
            call SetUnitTimeScale(n, 0.6)
            call SetUnitFlyHeight(n, 250, 0)
            call SetUnitAnimationByIndex(n, GetRandomInt(0, 16))
            call MyRemoveUnit(n, 2)
            call SaveInteger(h, id, 12, 1)
        else
            call SaveInteger(h, id, 12, eff_period-1)
        endif
    else
        set n=CreateUnit(GetOwningPlayer(caster), 'd059', GetUnitX(dummy), GetUnitY(dummy), angle*bj_RADTODEG)
        call SetUnitTimeScale(n, 0.6)
        call SetUnitScale(n, 1.6, 1.6, 1.6)
        call MyRemoveUnit(n, 2)
        set n=CreateUnit(GetOwningPlayer(caster), 'dR42', GetUnitX(dummy), GetUnitY(dummy), angle*bj_RADTODEG)
        call SetUnitTimeScale(n, 0.6)
        call SetUnitScale(n, 1.6, 1.6, 1.6)
        call MyRemoveUnit(n, 2)
        call KillUnit(dummy)
        call MyRemoveUnit(dummy, 1.2)
        
        call SetUnitTimeScale(caster,1) 
        call SaveReal(h,id,4,angle)
        call SetUnitAcquireRange(caster,600)
        call UnitRemoveAbility(caster,'A1FU')
        call UnitRemoveAbility(caster,'Pet1')
        call UnitRemoveAbility(caster,'B00A')
        
        call ShakeCamera(0.5,20)
        call SaveUnitHandle(h,id,1,CreateUnit(GetOwningPlayer(caster),'e0J6',caster_x,caster_y,angle*bj_RADTODEG))
        call TriggerClearActions(tt)
        call DestroyTrigger(tt)
        
        call PauseTimer(GetExpiredTimer())
        call TimerStart(GetExpiredTimer(), 0.01, true, function IchigoVasterR_Periodic)
    endif
    set caster=null
    set dummy=null
    set tt=null
endfunction

function IchigoVasterR_Cast takes unit u, real x1, real y1  returns nothing
        local timer t=CreateTimer()
        local integer id=GetHandleId(t)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        local real a=Atan2(y1-y,x1-x)
        local player p=GetOwningPlayer(u)
        local trigger tt=CreateTrigger()
        call SaveUnitHandle(h,id,0,u)
        call SaveGroupHandle(h,id,3,CreateGroup())
        call SaveReal(h,id,10,3000)
        call SetUnitInvulnerable(u,true)
        
        set n=CreateUnit(p,'dM32',x,y,GetRandomReal(0,359))
        call SetUnitVertexColor(n, 255, 255, 255, 210)
        call SetUnitScale(n, 3, 3, 3)
        call UnitApplyTimedLife(n,'BTLF', 1.8)
        call MyRemoveUnit(n, 3)
        set n=CreateUnit(p,'d058',x+150*Cos(a),y+150*Sin(a),GetRandomReal(0,359))
        call UnitScale(n, 0.1, 1.3, 1.1)
        call SetUnitFlyHeight(n, 60, 2000)
        call SaveUnitHandle(h, id, 12, n)
        
        //call PauseUnit(u,true)
        call SetUnitAnimationByIndex(u, 14)
        set soundplay=SndN(4157) // Sound\Music\mp3Music\IchigoR.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять

        call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_TARGET_ORDER)
        call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_POINT_ORDER)
        call TriggerAddAction(tt,function HichigoRStopOrders)
        call SaveTriggerHandle(h, id, 10, tt)
        
        call SetUnitAcquireRange(u,51)
        call UnitAddAbility(u,'A1FU') //Slow
        call UnitAddAbility(u,'Pet1')
        call SetUnitTimeScale(u,3)

        call RemoveEffect(AddSpecialEffectTarget("buff-txblack.mdl", u, "origin"), 1.5, true, CreateTimer())
        call TimerStart(t, 0.05, true, function IchigoVasterR_WaitTime)
        
        set u=null
        set p=null
        set t=null
        set tt=null
endfunction

function Trig_IchigoInt_Actions takes nothing returns nothing
    if GetSpellAbilityId()=='IcF1' then
        call IchigoShikaiF_Cast(GetSpellAbilityUnit())
    endif
    if GetSpellAbilityId()=='IcD2' then
        call IchigoBankaiD1_Cast(GetSpellAbilityUnit())
    endif
    if GetSpellAbilityId()=='IcQ1' then
        call IchigoShikaiQ_Cast(GetSpellAbilityUnit())
    endif
    if GetSpellAbilityId()=='IcQ2' then
        call IchigoShikaiQ1_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    endif
    if GetSpellAbilityId()=='IcW1' then
        call IchigoShikaiW_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    endif
    if GetSpellAbilityId()=='IcE1' then
        call IchigoShikaiE_Cast(GetSpellAbilityUnit(), GetSpellTargetUnit())
    endif
    if GetSpellAbilityId()=='IcR1' then
        call IchigoShikaiR_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    endif
    if GetSpellAbilityId()=='IcT2' then
        call SaveBoolean(HH, GetHandleId(GetSpellAbilityUnit()), 9595, true)
    endif
    
    if GetSpellAbilityId()=='IcD3' then
        call SaveReal(HH, GetHandleId(GetSpellAbilityUnit()), 1122, 15)
        call IchigoBankaiD_CalculateMana(GetSpellAbilityUnit())
    endif
    if GetSpellAbilityId()=='IcF2' then
        call IchigoBankaiF_Cast(GetSpellAbilityUnit())
    endif
    if GetSpellAbilityId()=='IcF6' then
        call UnitRemoveAbility(GetSpellAbilityUnit(), 'IcF4')
        call UnitAddAbility(GetSpellAbilityUnit(), 'IcF3')
        call UnitMakeAbilityPermanent(GetSpellAbilityUnit(), true, 'IcF3')
        call UnitRemoveAbilityTimed_ExD(GetSpellAbilityUnit(), 'IcF3', 10)
        call IssueImmediateOrder(GetSpellAbilityUnit(), "stop")
        call StartAbilityCooldown(GetUnitAbility(GetSpellAbilityUnit(), 'IcF6'), 30)
        call SetWidgetMana(GetSpellAbilityUnit(), GetWidgetMana(GetSpellAbilityUnit())-300)
    endif
    if GetSpellAbilityId()=='IcF7' then
        call UnitRemoveAbility(GetSpellAbilityUnit(), 'IcF3')
        call UnitAddAbility(GetSpellAbilityUnit(), 'IcF4')
        call UnitMakeAbilityPermanent(GetSpellAbilityUnit(), true, 'IcF4')
        call UnitRemoveAbilityTimed_ExD(GetSpellAbilityUnit(), 'IcF4', 10)
        call IssueImmediateOrder(GetSpellAbilityUnit(), "stop")
        call StartAbilityCooldown(GetUnitAbility(GetSpellAbilityUnit(), 'IcF7'), 30)
        call SetWidgetMana(GetSpellAbilityUnit(), GetWidgetMana(GetSpellAbilityUnit())-300)
    endif
    if GetSpellAbilityId()=='IcQ3' then
        call IchigoBankaiQ1_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    endif
    if GetSpellAbilityId()=='IcQ4' then
        call IchigoBankaiQ2_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    endif
    if GetSpellAbilityId()=='IcQ5' then
        call IchigoBankaiQ3_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    endif
    if GetSpellAbilityId()=='IcW2' and GetSpellAbilityUnit()!=GetSpellTargetUnit() then
        call IchigoBankaiW_Target(GetSpellAbilityUnit(), GetSpellTargetUnit())
    elseif GetSpellAbilityId()=='IcW2' then
        call IchigoBankaiW_Cast(GetSpellAbilityUnit())
    endif
    if GetSpellAbilityId()=='IcE2' then
        call IchigoBankaiE_Cast(GetSpellAbilityUnit(), GetSpellTargetUnit())
    endif
    if GetSpellAbilityId()=='IcR2' or GetSpellAbilityId()=='IcT5' then
        call IchigoBankaiR_Cast(GetSpellAbilityUnit(), GetSpellTargetUnit())
    endif
    if GetSpellAbilityId()=='IcT1' then
        call IchigoShikaiT_Cast(GetSpellAbilityUnit())
    endif
    if GetSpellAbilityId()=='IcW3' then
        call IchigoVasterW_Cast(GetSpellAbilityUnit(), GetSpellTargetUnit())
    endif
    if GetSpellAbilityId()=='IcE3' then
        call IchigoVasterE_Cast(GetSpellAbilityUnit())
    endif
    if GetSpellAbilityId()=='IcR3' then
        call IchigoVasterR_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    endif
        
    if GetSpellAbilityId()=='IcD4' then
        set soundplay=SndN(4148) // Sound\war3mapImported\Sonido.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    endif
        
    if GetSpellAbilityId()=='IcD3'  or GetSpellAbilityId()=='IcD2' then
        set soundplay=SndN(4159) // Sound\war3mapImported\Shunpo.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    endif
endfunction

//===========================================================================
function InitTrig_IchigoInt takes nothing returns nothing
    local trigger trig  = CreateTrigger(  )
    local integer index = 0
    loop
        call TriggerRegisterPlayerUnitEvent(trig, Player(index), EVENT_PLAYER_UNIT_SPELL_EFFECT, null)
        set index = index + 1
        exitwhen index == bj_MAX_PLAYER_SLOTS
    endloop
    call TriggerAddAction( trig, function Trig_IchigoInt_Actions )
    set trig=null
endfunction

//===========================================================================
//=========== Karna Int ЧАС ПРОЕБАЛИ НА ЭТУ ХУЕТУ БЛЯТЬ
//===========================================================================

function KarnaD_Periodic takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit caster    = LoadUnitHandle(h, id, 0)
    local integer c_id   = GetHandleId(caster)
    local real duration  = LoadReal(h, c_id, Shield_KarnaD)-0.1
    if duration>0 then
        if IsUnitPaused(caster)==false then
            call SaveReal(h, c_id, Shield_KarnaD, duration)
        endif
    else
        call DestroyEffect(LoadEffectHandle(h, id, 1))
        call UnitRemoveAbility(caster, 'ReFm')
        call UnitRemoveAbility(caster, 'KaA0')
        call SaveReal(h, c_id, Shield_KarnaD, 0.0)
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set caster = null
    set newTimer = null
endfunction

function KarnaD_Active takes unit newCaster returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id   = GetHandleId(newCaster)
    local real duration  = LoadReal(h, c_id, Shield_KarnaD)
    if LoadInteger(HH, c_id, Stack_KarnaD)==0 then
        call DestroyTimer(newTimer)
        call DisplayTimedTextToPlayer(GetOwningPlayer(newCaster), 0, 0, 3, Lng("|c00FF80C0Нет вспышек праны!|r","|c00FF80C0No prana bursts!|r"))
        call StartAbilityCooldown(GetUnitAbility(newCaster , 'KaA2' ), 0.5)
    else
        call SaveInteger(HH, c_id, Stack_KarnaD, LoadInteger(HH, c_id, Stack_KarnaD)-1)

        set soundplay=SndByPath("Sound\\Music\\mp3Music\\KarnaD"+I2S(GetRandomInt(1, 2))+".mp3")
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять

        if duration==0.0 then
            call UnitAddAbility(newCaster, 'ReFm')
            call UnitAddAbility(newCaster, 'KaA0')
            call SaveUnitHandle(h, id, 0, newCaster)
            call SaveEffectHandle(h, id, 1, AddSpecialEffectTarget("Soundwaveshield.mdl", newCaster, "origin"))
            call TimerStart(newTimer, 0.1, true, function KarnaD_Periodic)
        else
            call DestroyTimer(newTimer)
        endif
        set bjLCG = CreateGroup()
        call GroupEnumUnitsInRange(bjLCG, GetUnitX(newCaster), GetUnitY(newCaster), 350, Base)
        loop
        set E = FirstOfGroup(bjLCG)
        exitwhen E == null
            if Condition_Base(GetOwningPlayer(newCaster) , E) then
                call myCustomDamage(newCaster, E, GetHeroAgi(newCaster, true)*2 , false , false , null , null , null)
            endif
        call GroupRemoveUnit(bjLCG, E)
        endloop
        call DestroyGroup(bjLCG)
        call SaveReal(h, c_id, Shield_KarnaD, 1.0)

        if LoadBoolean(h, GetHandleId(newCaster), KarnaF_Reload) then
            call RemoveEffect(AddSpecialEffectTarget("AZ_LCguanyu_T1.mdl", newCaster, "chest"), 1, true, CreateTimer())
        endif
        set n = CreateUnit(GetOwningPlayer(newCaster), 'dR36', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
        call SetUnitScale(n, 2, 2, 2)
        call MyRemoveUnit(n, 3.5)
        set n = CreateUnit(GetOwningPlayer(newCaster), 'dR36', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
        call SetUnitScale(n, 4, 4, 4)
        call MyRemoveUnit(n, 3.5)
        set n = CreateUnit(GetOwningPlayer(newCaster), 'dR13', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
        call SetUnitScale(n, 1.7, 1.7, 1.7)
        call MyRemoveUnit(n, 3.5)
        set n = CreateUnit(GetOwningPlayer(newCaster), 'dRe9', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call UnitApplyTimedLife(n,'BTLF', 1.0)
        call MyRemoveUnit(n, 3.5)
        set n = CreateUnit(GetOwningPlayer(newCaster), 'dRe9', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
        call UnitScale(n, 1, 4, 0.5)
        call UnitApplyTimedLife(n,'BTLF', 1.0)
        call MyRemoveUnit(n, 3.5)
        set n = CreateUnit(GetOwningPlayer(newCaster), 'd102', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
        call SetUnitScale(n, 1.8, 1.8, 1.8)
        call UnitApplyTimedLife(n,'BTLF', 0.5)
        call MyRemoveUnit(n, 1.0)
        set n = CreateUnit(GetOwningPlayer(newCaster), 'd103', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call SetUnitFlyHeight(n, 150, 0)
        call MyRemoveUnit(n, 3.5)
        set n = CreateUnit(GetOwningPlayer(newCaster), 'd104', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
        call SetUnitScale(n, 1.0, 1.0, 1.0)
        call SetUnitFlyHeight(n, 150, 0)
        call MyRemoveUnit(n, 3.5)
        set n = CreateUnit(GetOwningPlayer(newCaster), 'dH62', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
        call SetUnitScale(n, 1.0, 1.0, 1.0)
        call SetUnitFlyHeight(n, 0, 0)
        call MyRemoveUnit(n, 3.5)
        set n = CreateUnit(GetOwningPlayer(newCaster), 'dH62', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
        call SetUnitScale(n, 2.0, 2.0, 2.0)
        call SetUnitFlyHeight(n, 0, 0)
        call MyRemoveUnit(n, 3.5)
    endif
    set newTimer = null
endfunction


function KarnaDStack_Periodic takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    caster = LoadUnitHandle(HH, id, 0)
    local integer c_id   = GetHandleId(caster)
    local integer stack  = LoadInteger(HH, id, 1)
    local real    duration = LoadReal(HH, id, 2)+0.1
    if stack>0 then
        call SaveReal(HH, id, 2, duration)
        if stack!=LoadInteger(HH, c_id, Stack_KarnaD) then
            //call SaveReal(h, id, 2, 0)
            call SaveInteger(HH, id, 1, LoadInteger(HH, c_id, Stack_KarnaD))
            set duration = 0
        endif
        if duration>=5.0 then
            call SaveInteger(HH, c_id, Stack_KarnaD, stack-1)
            call SaveInteger(HH, id, 1, LoadInteger(HH, c_id, Stack_KarnaD))
            call SaveReal(HH, id, 2, 0)
        endif
    else
        call SaveInteger(HH, c_id, Stack_KarnaD, 0)
        call FlushChildHashtable(HH, id)
        call DestroyTimer(newTimer)
    endif
    set newTimer = null
    set caster   = null
endfunction


function KarnaD_AddStack takes unit newCaster returns nothing
    local timer newTimer = null
    local integer c_id   = GetHandleId(newCaster)
    local integer stack  = LoadInteger(HH, c_id, Stack_KarnaD)
    if GetHeroLevel(newCaster)>=12 then // Карна F пассивка на автухи
        if GetUnitAbilityLevel(newCaster, 'KaAC')==0 then
            call UnitAddAbility(newCaster, 'KaAC')
        endif
    endif
    // Добавить таймер сброса стаков
    if stack==0 then
        set newTimer = CreateTimer()
        call SaveUnitHandle(HH, GetHandleId(newTimer), 0, newCaster)
        call SaveInteger(HH, GetHandleId(newTimer), 1, 1)
        call TimerStart(newTimer, 0.1, true, function KarnaDStack_Periodic)
    endif
    call SaveInteger(HH, c_id, Stack_KarnaD, stack+1)
    set newTimer = null
endfunction


function Soul_Eater_Effect takes unit newCaster, unit newTarget returns nothing
    local real caster_x = GetUnitX(newCaster)
    local real caster_y = GetUnitY(newCaster)
    local real target_x = GetUnitX(newTarget)
    local real target_y = GetUnitY(newTarget)
    local real angle    = (GetUnitFacing(newCaster)+180)*bj_DEGTORAD
    set n=CreateUnit(Player(14), GetUnitTypeId(newTarget), caster_x, caster_y, GetUnitFacing(newTarget))
    call UnitAddAbility(n,'Aloc')
    call UnitApplyTimedLife(n,'BTLF',0.4)
    call SetUnitVertexColor(n,255,255,255,140)
    call IssueTargetOrder(n,"attack",newCaster)
    call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(newTarget), 'e085', caster_x, caster_y, 0), 'BTLF', 1)
    call SetUnitX(newTarget, caster_x+100*Cos(angle))
    call SetUnitY(newTarget, caster_y+100*Sin(angle))
    call SetUnitFacing(newTarget,Atan2(target_y-caster_y, target_x-caster_x)*bj_RADTODEG)
    call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(newTarget), 'e085', caster_x, caster_y, 0), 'BTLF', 1)
endfunction

function GenkshiPassiveX2 takes unit newCaster, unit newTarget returns nothing
    local real caster_x = GetUnitX(newCaster)
    local real caster_y = GetUnitY(newCaster)
    local real target_x = GetUnitX(newTarget)
    local real target_y = GetUnitY(newTarget)
    local real angle    = 0.0
    local integer caster_id = GetPlayerId(GetOwningPlayer(newCaster))
    local integer target_id = GetPlayerId(GetOwningPlayer(newTarget))
    // set n=CreateUnit(GetOwningPlayer(newTarget),'h019',caster_x,caster_y,0)
    // call UnitApplyTimedLife(n,'BTLF',1)
    // call UnitAddAbility(n,'A0M0')
    call RemoveSavedReal(h,GetHandleId(Hero[target_id]),SH_FM1)
    call RemoveSavedReal(h,GetHandleId(Hero[target_id]),SH_FM2)
    call RemoveSavedHandle(h,GetHandleId(Hero[target_id]),SH_FMc)
    call SaveReal(h,GetHandleId(Hero[target_id]),SH_FMx,caster_x)
    call SaveReal(h,GetHandleId(Hero[target_id]),SH_FMy,caster_y)
    call SaveUnitHandle(h,GetHandleId(Hero[target_id]),SH_FMc,newCaster)
    // call IssueTargetOrderById(n,852274,newTarget)
    set n=CreateIllusionFromUnit(newTarget)
    call SetUnitFacingInstant(n,GetUnitFacing(newTarget))
    call UnitCancelTimedLife(n)
    call SetUnitCurrentSight(n,600)
    call SetUnitUseFood(n,true)
    call UnitApplyTimedLife(n,'B03Q',4)
    call SetIllusionDamageDealt(n,0.2)
    call SetIllusionDamageReceived(n,2.5)
    call SetUnitXY_1(n,target_x,target_y,false)
    call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(newTarget),'e085',caster_x,caster_y,0),'BTLF',1)
    call myCustomDamage(Hero[target_id],newCaster,GetHeroInt(Hero[target_id],true),false,false,null,null,null)
    set angle=(GetUnitFacing(Hero[caster_id])+180)*bj_DEGTORAD

    call SetUnitX(newTarget, caster_x+100*Cos(angle))
    call SetUnitY(newTarget, caster_y+100*Sin(angle))
    call SetUnitFacing(newTarget,Atan2(GetUnitY(Hero[caster_id])-caster_y,GetUnitX(Hero[caster_id])-caster_x)*bj_RADTODEG)
    call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(newTarget),'e085',caster_x,caster_y,0),'BTLF',1)
endfunction

function Karna_ModifAttack takes unit newCaster, unit newTarget, real attack_factor, real newDamage, real par_modif_factor, boolean canMiss returns boolean
	local real damage          = GetUnitTotalDamage(newCaster) * attack_factor
	local real bonus_damage    = 0.0
	local real currect_damage  = damage
	local real current_damage  = GetUnitTotalDamage(newCaster)
	local boolean fatal_damage = false
	local boolean miss         = false
    local boolean first_crit   = false
    local boolean soul_eater_miss = false
    local boolean yamato       = false
	local real critchance_dmg  = 0.0
	local real crit_damage     = 0.0     // крит урон, база 0.0
    local real crit_factor     = 0.3     // модификаторы крита, процент
    local real heal_factor     = 0.6     // модификаторы хилла, процент
	local real heal            = 0.0
    local real modif_factor    = par_modif_factor
    local real max_crit_count  = 90
	local integer crit_count   = 0 
    local string text_damage   = ""

    if IsUnitInvulnerable(newTarget) then
        set damage=0
        set miss=true
    endif
    if attack_factor>1.0 then
        set damage = GetUnitTotalDamage(newCaster)
    endif
	if canMiss then	// Миссы в целом
	
        if GetUnitAbilityLevel(newCaster, 'A3IG')==0 and GetUnitAbilityLevel(newCaster, 'A6HR')==0 then // Патриот анти-миссы 
            if (UnitHasItemOfTypeBJ(newTarget, 'I03E') or UnitHasItemOfTypeBJ(newTarget, 'I03F') or GetUnitAbilityLevel(newTarget, 'KIJ2')>0 or GetUnitAbilityLevel(newTarget, 'KIJ4')>0) and GetRandomInt(0, 99)<35 then	// Туфли или Комплект Анбу - уклонение
                set damage=0
                set miss=true
            endif
            
            if GetUnitAbilityLevel(newTarget, 'A14R')>0 or GetUnitAbilityLevel(newCaster, 'B037')>0 or GetUnitAbilityLevel(newCaster, 'cb10')>0 then	// Демон Глаз активка или слепота
                set damage=0
                set miss=true
            endif
            
            if GetUnitAbilityLevel(newCaster, 'cb12')>0 then 		// Промахи все
                call SaveReal(HH,GetHandleId(bufh),0,1)
                call HandleListEnumUnitBuffs(bufh,newCaster,Condition(function MissBool))
                call HandleListForEach(bufh,function MissBuff)
                if LoadReal(HH,GetHandleId(bufh),0)==0 then
                    set damage=0
                    set miss=true
                endif
                call FlushChildHashtable(HH,GetHandleId(bufh))
                call HandleListClear(bufh)	
            endif
        endif

        if GetUnitAbilityLevel(newCaster,'Bwul')==0 and GetUnitAbilityLevel(newCaster,'A1WT')==0 then

            if miss==false and(UnitHasItemOfTypeBJ(newTarget,'I02E')or GetUnitAbilityLevel(newTarget,'KID4')>0)and GetRandomIntMem(0,100)<10 then // Пожиратель Душ, D ранг
                set miss = true
                set soul_eater_miss = true
            endif
            if miss==false and(UnitHasItemOfTypeBJ(newTarget,'I02F')or GetUnitAbilityLevel(newTarget,'KID6')>0)and GetRandomIntMem(0,100)<15 then // Пожиратель Душ, C ранг
                set miss = true
                set soul_eater_miss = true
            endif
            if miss==false and(UnitHasItemOfTypeBJ(newTarget,'I02G')or GetUnitAbilityLevel(newTarget,'KID8')>0)and GetRandomIntMem(0,100)<20 then // Пожиратель Душ, B ранг
                set miss = true
                set soul_eater_miss = true
            endif
            if miss==false and(UnitHasItemOfTypeBJ(newTarget,'I02H')or GetUnitAbilityLevel(newTarget,'KIE0')>0)and GetRandomIntMem(0,100)<25 then // Пожиратель Душ, A ранг
                set miss = true
                set soul_eater_miss = true
            endif
            if miss==false and(UnitHasItemOfTypeBJ(newTarget,'I02I')or GetUnitAbilityLevel(newTarget,'KIE2')>0)and GetRandomIntMem(0,100)<25 then // Пожиратель Душ, Запечатанный
                set miss = true
                set soul_eater_miss = true
            endif
            if miss==false and(UnitHasItemOfTypeBJ(newTarget,'I02J')or GetUnitAbilityLevel(newTarget,'KIE4')>0)and GetRandomIntMem(0,100)<35 then // Пожиратель Душ, True
                set miss = true
                set soul_eater_miss = true
            endif
            if miss==false and(UnitHasItemOfTypeBJ(newTarget,'I02K')or GetUnitAbilityLevel(newTarget,'KIE4')>0)and GetRandomIntMem(0,100)<35 then // Пожиратель Душ, True Активный
                set miss = true
                set soul_eater_miss = true
            endif
            
            if soul_eater_miss then
                call Soul_Eater_Effect(newCaster, newTarget)
            endif
            
            // GenkshiPassive
            if miss==false and (GetUnitAbilityLevel(newTarget,'A0LZ')>0 and GetRandomIntMem(0,100)<10+R2I(GetHeroLevel(newTarget)*0.6)) then
                set miss = true
                call GenkshiPassiveX2(newCaster, newTarget)
            endif
        endif
	endif
    
	if IsUnitType(newCaster,UNIT_TYPE_HERO) and IsUnitIllusion(newCaster)==false and miss==false then
	
        if UnitHasItemOfTypeBJ(newCaster, 'I01J') and GetRandomIntMem(0,100)<15 then	// Меч C ранга
            set crit_damage=crit_damage+(0.5*crit_factor)
            set crit_count = crit_count + 1
        endif
        if UnitHasItemOfTypeBJ(newCaster, 'I01I') and GetRandomIntMem(0,100)<15 then	// Меч B ранга
            set crit_damage=crit_damage+(0.75*crit_factor)
            set crit_count = crit_count + 1
        endif
        if UnitHasItemOfTypeBJ(newCaster, 'I01K') and GetRandomIntMem(0,100)<15 then	// Меч A ранга
            set crit_damage=crit_damage+(1.0*crit_factor)
            set crit_count = crit_count + 1
        endif
        if UnitHasItemOfTypeBJ(newCaster, 'I01L') and GetRandomIntMem(0,100)<15 then	// Закаленный меч
            set crit_damage=crit_damage+(1.0*crit_factor)
            set crit_count = crit_count + 1
        endif
        if UnitHasItemOfTypeBJ(newCaster, 'I01O') and GetRandomIntMem(0,100)<20 then	// Сандай Китецу
            set crit_damage=crit_damage+(1.5*crit_factor)
            set crit_count = crit_count + 1
        endif
        if UnitHasItemOfTypeBJ(newCaster, 'I01Q') and GetRandomIntMem(0,100)<20 then	// Сюсуй
            set crit_damage=crit_damage+(1.5*crit_factor)
            set crit_count = crit_count + 1
        endif
        if UnitHasItemOfTypeBJ(newCaster, 'I01U') and GetRandomIntMem(0,100)<20 then	// Фэнг
            set crit_damage=crit_damage+(1.5*crit_factor)
            set crit_count = crit_count + 1
        endif
        if UnitHasItemOfTypeBJ(newCaster, 'I01S') and GetRandomIntMem(0,100)<30 then	// Темный Экскалибур
            set crit_damage=crit_damage+(1.5*crit_factor)
            set crit_count = crit_count + 1
        endif
    	if GetUnitAbilityLevel(newCaster,'WAE1')>0 and GetRandomIntMem(0,100)<30*(1+B2R_ExD(first_crit)) and max_crit_count>crit_count then	// Waver F
            set crit_damage=crit_damage+(0.5*crit_factor)
            set crit_count = crit_count + 1
        endif
        if UnitHasItemOfTypeBJ(newCaster, 'I02V') then	// Ямато
            call Essence(newCaster,newTarget,1)
            if (LoadReal(HH,GetHandleId(newCaster),SH_yamato)==1 or GetRandomIntMem(0,100)<15) then
                set crit_damage=crit_damage+(2.0*crit_factor)
                call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",newTarget,"chest"))
                call SaveReal(HH,GetHandleId(newCaster),SH_yamato,0)
                //call AllTextTag("|c000080FFYAMATO!|r" , newTarget)
                set yamato = true
            endif
        endif
    
        // критический урон
        if attack_factor<1.0 then
            set damage = damage*attack_factor
            set damage = damage + (damage * crit_damage)
        else
            set damage = damage + (current_damage * crit_damage)
        endif
        //
	
        if UnitHaveShield(newCaster,newTarget,damage)==false then
            if UnitHasItemOfTypeBJ(newCaster, 'I031') and IsUnitType(newTarget,UNIT_TYPE_HERO) and IsUnitIllusion(newTarget)==false then 	// Патриот
                set bjLCT=CreateTimer()
                    call SetHeroAgi(newCaster,GetHeroAgi(newCaster,false)+3,true)
                    call SetHeroStr(newCaster,GetHeroStr(newCaster,false)+3,true)
                    call SetHeroInt(newCaster,GetHeroInt(newCaster,false)+3,true)
                    if GetUnitTypeId(newTarget)=='H00Q' then
                        call SetHeroAgi(Hero[GetPlayerId(GetOwningPlayer(newTarget))],GetHeroAgi(Hero[GetPlayerId(GetOwningPlayer(newTarget))],false)-3,true)
                        call SetHeroStr(Hero[GetPlayerId(GetOwningPlayer(newTarget))],GetHeroStr(Hero[GetPlayerId(GetOwningPlayer(newTarget))],false)-3,true)
                        call SetHeroInt(Hero[GetPlayerId(GetOwningPlayer(newTarget))],GetHeroInt(Hero[GetPlayerId(GetOwningPlayer(newTarget))],false)-3,true)
                        call SaveUnitHandle(h,GetHandleId(bjLCT), 0, newTarget)
                    else
                        call SetHeroAgi(newTarget,GetHeroAgi(newTarget,false)-3,true)
                        call SetHeroStr(newTarget,GetHeroStr(newTarget,false)-3,true)
                        call SetHeroInt(newTarget,GetHeroInt(newTarget,false)-3,true)
                        call SaveUnitHandle(h,GetHandleId(bjLCT), 0, newTarget)
                    endif
                    call SaveUnitHandle(h,GetHandleId(bjLCT), 1, newCaster)
                    call TimerStart(bjLCT, 5, false, function VergilPatriot_ModifEnd)
                set bjLCT=null
                //set damage=damage-damage*0.3
            endif
            
            if UnitHasItemOfTypeBJ(newCaster, 'I04F') then 				// Экскалибур
                call HealTextTag(newCaster,newCaster,damage*0.2*heal_factor*myCustomHeal2(newCaster,1),"HealthRes")
                call SetWidgetLife(newCaster, GetWidgetLife(newCaster)+myCustomDamage2(newTarget, damage*0.2))
                set bjLCT=CreateTimer()
                    call SetUnitArmour(newTarget, GetUnitArmour(newTarget)-4)
                    call SaveUnitHandle(h,GetHandleId(bjLCT), 0, newTarget)
                    call SaveUnitHandle(h,GetHandleId(bjLCT), 1, newCaster)
                    call TimerStart(bjLCT, 10, false, function VergilExcalibur_ModifEnd)
                set bjLCT=null
            endif
            
            if UnitHasItemOfTypeBJ(newCaster, 'I01S') and GetRandomInt(0, 9)<=3 then 				// Темный Экскалибур
                if LoadBoolean(h, GetHandleId(newCaster), SH_ItemDarkExc_CD)==false then
                    set bjLCT=CreateTimer()
                    call SaveBoolean(h, GetHandleId(newCaster), SH_ItemDarkExc_CD, true)
                    call UnitRemoveAbility(newCaster, 'A26R')
                    call UnitAddAbility(newCaster,'A26R')
                    call SaveUnitHandle(h,GetHandleId(bjLCT),0,newCaster)
                    call TimerStart(bjLCT,3,false,function VergilDarkExcalibur_ModifEnd)
                    set bjLCT=null
                endif
            endif
            
            if GetUnitAbilityLevel(newCaster, 'A26R')>0 then										// Темный Экскалибур Хилл
                call HealTextTag(newCaster,newCaster,damage*0.5*heal_factor*myCustomHeal2(newCaster,1),"HealthRes")
                call SetWidgetLife(newCaster, GetWidgetLife(newCaster)+myCustomDamage2(newTarget, damage*0.5*heal_factor))
            endif
            
            if GetUnitAbilityLevel(newCaster, 'B06N')>0 then										// Жанна Альтер Хилл
                call HealTextTag(newCaster,newCaster,damage*0.3*heal_factor*myCustomHeal2(newCaster,1),"HealthRes")
                call SetWidgetLife(newCaster, GetWidgetLife(newCaster)+myCustomDamage2(newTarget, damage*0.3*heal_factor))
            endif
            
            if UnitHasItemOfTypeBJ(newCaster, 'I03O') then 				// Самехада: Чистый Урон
                set bonus_damage=(150+GetUnitTotalDamage(newCaster)*0.4)*modif_factor
                if GetWidgetLife(newTarget)>bonus_damage then
                    //call SetWidgetLife(newTarget, GetWidgetLife(newTarget)-bonus_damage)
                    call CustomTrueDamage(newCaster, newTarget, bonus_damage)
                else
                    set fatal_damage=true
                endif
            endif
            
            if UnitHasItemOfTypeBJ(newCaster, 'I03B') or UnitHasItemOfTypeBJ(newCaster, 'I03F') then				// Меч Анбу
                set bonus_damage=55*modif_factor
                if GetWidgetLife(newTarget)>bonus_damage then
                    //call SetWidgetLife(newTarget, GetWidgetLife(newTarget)-bonus_damage)
                    call CustomTrueDamage(newCaster, newTarget, bonus_damage)
                else
                    set fatal_damage=true
                endif
            endif
            
            if UnitHasItemOfTypeBJ(newCaster, 'I050') then				// Гегецебури
                set bonus_damage=80*modif_factor
                if GetWidgetLife(newTarget)>bonus_damage then
                    //call SetWidgetLife(newTarget, GetWidgetLife(newTarget)-bonus_damage)
                    call CustomTrueDamage(newCaster, newTarget, bonus_damage)
                else
                    set fatal_damage=true
                endif
                call DestroyEffect(AddSpecialEffect("war3mapImported\\Cleave.mdx",GetUnitX(newTarget),GetUnitY(newTarget)))
                if GetRandomIntMem(0,100)<20 or LoadReal(HH,GetHandleId(newCaster),'AAcd')==0 then
                    call SetControlToUnit(newTarget, newTarget, 1.0, "stun")
                    call SetControlToUnit(newTarget, newTarget, 0.2,"stunbkb")
                endif
            endif
            
            if GetUnitAbilityLevel(newCaster,'WAE4')==0 and GetUnitAbilityLevel(newCaster,'WAE1')>0 then
                call SetControlToUnit(newTarget,newTarget, 0.3, "stun")
                call UnitAddAbility(newCaster,'WAE4')
                call UnitRemoveAbilityTimed(newCaster,'WAE4',0.7)
                call myCustomDamage(newCaster,newTarget,GetHeroInt(newCaster,true)*modif_factor,false,false,null,null,null)
                set damage = damage * 1.5 * modif_factor
            endif
            
            if UnitHasItemOfTypeBJ(newCaster, 'I03N') then 				// Самехада: Манажор
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Feedback\\ArcaneTowerAttack.mdl", newTarget,"origin"))
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl", newTarget,"chest"))
                if GetWidgetMana(newTarget)>0 then
                    call HealTextTag(newCaster,newCaster,GetWidgetMana(newTarget)*0.16*heal_factor*myCustomHeal2(newCaster,1),"HealthRes")
                    call SetWidgetLife(newCaster, GetWidgetLife(newCaster)+GetWidgetMana(newTarget)*0.16*heal_factor)
                endif
                call SetWidgetMana(newTarget, GetWidgetMana(newTarget)-GetWidgetMana(newTarget)*0.08*modif_factor)
            endif
            
            if UnitHasItemOfTypeBJ(newCaster, 'I01U') and GetRandomInt(1, 100)<=45 then 		// Feng
                call PoisonDamage5(newCaster,newTarget, 2.5*GetHeroInt(newCaster,true)*modif_factor, 6, "Abilities\\Weapons\\PoisonSting\\PoisonStingTarget.mdl", "chest")
                call SlowUnit(newCaster,newTarget,0.5,0.,1*modif_factor,1,false)
            endif
            if UnitHasItemOfTypeBJ(newCaster, 'I01Q') and (GetRandomInt(1, 100)<=20 or GetUnitAbilityLevel(newCaster,'A06K')>0) then 		// Сюсуй
                call Shusui_Cast(newCaster, 1.0)
            endif
            if UnitHasItemOfTypeBJ(newTarget,'I05O')or UnitHasItemOfTypeBJ(newTarget,'I05P')or UnitHasItemOfTypeBJ(newTarget,'I05Q')or UnitHasItemOfTypeBJ(newTarget,'I05R')or UnitHasItemOfTypeBJ(newTarget,'I05S')or UnitHasItemOfTypeBJ(newTarget,'I05T') or GetUnitAbilityLevel(newTarget, 'KIT8')>0 or GetUnitAbilityLevel(newTarget, 'KIU0')>0 or GetUnitAbilityLevel(newTarget, 'KIU2')>0 or GetUnitAbilityLevel(newTarget, 'KIU4')>0 or GetUnitAbilityLevel(newTarget, 'KIU6')>0 or GetUnitAbilityLevel(newTarget, 'KIU8')>0 then
                call RainMare_Actions(newCaster,newTarget)
            endif
            if UnitHasItemOfTypeBJ(newTarget, 'I03C') and UnitHasItemOfTypeBJ(newTarget, 'I03F')==false then	// Жилет Анбу у таргета
                set damage=damage-25
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Heal\\HealTarget.mdl", newTarget,"origin"))
            endif
            
            if UnitHasItemOfTypeBJ(newTarget, 'I03F') then														// Комплект Анбу у таргета
                set damage=damage-50
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Heal\\HealTarget.mdl", newTarget,"origin"))
            endif

            if (UnitHasItemOfTypeBJ(newTarget,'IAoF') or GetUnitAbilityLevel(newTarget,'KI1A')>0) then                                                                                                          // Комплект Анбу у таргета
                set damage=damage-(60+5*round)
            endif

            if (UnitHasItemOfTypeBJ(newTarget,'I03Z')or GetUnitAbilityLevel(newTarget,'KIL2')>0) then
                set damage=damage-15
            endif

            if (UnitHasItemOfTypeBJ(newTarget,'I040')or GetUnitAbilityLevel(newTarget,'KIL4')>0) then
                set damage=damage-20
            endif
            
            if UnitHasItemOfTypeBJ(newTarget, 'I060') then														// Облако Маре D ранг
                set damage=damage-20
            endif
            
            if UnitHasItemOfTypeBJ(newTarget, 'I061') then														// Облако Маре C ранг
                set damage=damage-40
            endif
            
            if UnitHasItemOfTypeBJ(newTarget, 'I062') then														// Облако Маре B ранг
                set damage=damage-60
            endif
            
            if UnitHasItemOfTypeBJ(newTarget, 'I063') then														// Облако Маре A ранг
                set damage=damage-80
            endif
                
            if UnitHasItemOfTypeBJ(newTarget, 'I064') then														// Облако Маре Фальшивое
                set damage=damage-100
            endif
            
            if UnitHasItemOfTypeBJ(newTarget, 'I065') then														// Облако Маре Истинное
                set damage=damage-120
            endif
        
        endif
	endif

    if attack_factor<=1.0 then
        set damage = damage + newDamage
    else
        set damage = damage + newDamage + current_damage*(attack_factor-1)
    endif

	if miss then
		call AllTextTag("|c00C0C0C0Miss!|r" , newTarget)
        set damage = 0
    else
        call SaveReal(HH,GetHandleId(newCaster),'AAcd',10)
        // Текст над головой
        if crit_count>0 then
            if crit_count>1 then
                set text_damage = "|c00880a0aCRIT!x"+I2S(crit_count)+"|r"
            else
                set text_damage = "|c00880a0aCRIT!|r"
            endif
        endif
        if yamato and (crit_count>1) then
            set text_damage = text_damage + " + |c000080FFYAMATO!|r"
         elseif yamato then
            set text_damage = "|c000080FFYAMATO!|r"
        endif
        call AllTextTag(text_damage , newTarget)
	endif
	
	if fatal_damage==false then
		if damage>0 then
			call myCustomDamage(newCaster,newTarget,damage,false,false,null,null,null)
        else
            if miss==false then
                call myCustomDamage(newCaster,newTarget,10,false,false,null,null,null)
            endif
		endif
	else
		call UnitRemoveBuffs(newTarget,true,true)
		call UnitAddAbility(newTarget,'A0WR')
        call DamageIndicatorFunction(newCaster,newTarget,damage)
		call myCustomDamage(newCaster, newTarget, GetWidgetMaxLife(newTarget),false,false,null,null,null)
		call UnitRemoveAbility(newTarget,'A0WR')
		//call AllTextTag("|c000080FFSCUM!|r" , newTarget)
	endif	
	return miss
endfunction

function Sinon_ModifAttack takes unit newCaster, unit newTarget, real attack_factor, real newDamage, real modif_factor, boolean overcharge returns boolean
	local real damage          = GetUnitTotalDamage(newCaster) * attack_factor
	local real bonus_damage    = 0.0
	local real current_damage  = GetUnitTotalDamage(newCaster)
	local boolean fatal_damage = false
	local boolean miss         = false
    local boolean first_crit   = true
    local boolean backstab     = false
	local real heal            = 0.0
	local real critchance_dmg  = 0.0
    local real crit_damage     = 0.0     // крит урон, база 0.0
    local real crit_factor     = 1.0     // модификаторы крита, процент
    local real max_crit_count  = 2
    local real heal_factor     = 0.6     // модификаторы хилла, процент
    local string text_damage   = ""
    local boolean yamato       = false
    local boolean fragility    = false
	local integer crit_count   = 0 
    
    if IsUnitInvulnerable(newTarget) then
        set damage=0
        set miss=true
    endif

	// if GetUnitAbilityLevel(newCaster, 'A3IG')==0 then	// Патриот анти-миссы и миссы в целом
	
		// if (UnitHasItemOfTypeBJCustom(newTarget, 'I03E') or UnitHasItemOfTypeBJCustom(newTarget, 'I03F') or GetUnitAbilityLevel(newTarget, 'KIJ2')>0 or GetUnitAbilityLevel(newTarget, 'KIJ4')>0) and GetRandomInt(0, 99)<=49 then	// Туфли или Комплект Анбу - уклонение
			// set damage=0
			// set miss=true
		// endif
		
		// if GetUnitAbilityLevel(newTarget, 'A14R')>0 then									// Демон Глаз активка
			// set damage=0
			// set miss=true
		// endif
		
		// if GetUnitAbilityLevel(newCaster, 'B063')>0 and GetRandomInt(0, 99)<=49  then 		// Синон промах 50%	
			// set damage=0
			// set miss=true
		// endif
		
		// if GetUnitAbilityLevel(newCaster, 'MaEb')>0 then 									// Мадока 100% промах
			// set damage=0
			// set miss=true
		// endif
		
	// endif
    
    // Усиление урона от автоатаки крит шансом
    set critchance_dmg = damage*CalculateCritChance(newCaster)
    set damage = damage //+ critchance_dmg
    //

	if IsUnitType(newCaster,UNIT_TYPE_HERO) and IsUnitIllusion(newCaster)==false and miss==false then
	
    if UnitHasItemOfTypeBJ(newCaster, 'I02V') then	// Ямато
        call Essence(newCaster,newTarget,1)
        if (LoadReal(HH,GetHandleId(newCaster),SH_yamato)==1 or GetRandomIntMem(0,100)<15*(1+B2R_ExD(first_crit))) and max_crit_count>crit_count then
            set crit_damage=crit_damage+(2.0*crit_factor)
            set first_crit = false
            call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",newTarget,"chest"))
            call SaveReal(HH,GetHandleId(newCaster),SH_yamato,0)
            set yamato = true
            set crit_count = crit_count + 1
        endif
    endif
	if UnitHasItemOfTypeBJ(newCaster, 'IBSI') and GetRandomIntMem(0,100)<15*(1+B2R_ExD(first_crit)) and max_crit_count>crit_count then	// Бастер Меч
		set crit_damage=crit_damage+(1*crit_factor)
        set first_crit = false
		set crit_count = crit_count + 1
	endif
    if UnitHasItemOfTypeBJ(newCaster, 'I01U') and GetRandomIntMem(0,100)<20*(1+B2R_ExD(first_crit)) and max_crit_count>crit_count then	// Фэнг
		set crit_damage=crit_damage+(1*crit_factor)
        set first_crit = false
		set crit_count = crit_count + 1
	endif
    if UnitHasItemOfTypeBJ(newCaster, 'I01Q') and GetRandomIntMem(0,100)<20*(1+B2R_ExD(first_crit)) and max_crit_count>crit_count then	// Сюсуй
		set crit_damage=crit_damage+(1*crit_factor)
        set first_crit = false
		set crit_count = crit_count + 1
	endif
	if UnitHasItemOfTypeBJ(newCaster, 'I01S') and GetRandomIntMem(0,100)<30*(1+B2R_ExD(first_crit)) and max_crit_count>crit_count then	// Темный Экскалибур
		set crit_damage=crit_damage+(1*crit_factor)
        set first_crit = false
		set crit_count = crit_count + 1
	endif
	if UnitHasItemOfTypeBJ(newCaster, 'I01O') and GetRandomIntMem(0,100)<20*(1+B2R_ExD(first_crit)) and max_crit_count>crit_count then	// Сандай Китецу
		set crit_damage=crit_damage+(1*crit_factor)
        set first_crit = false
		set crit_count = crit_count + 1
	endif
	if UnitHasItemOfTypeBJ(newCaster, 'I01L') and GetRandomIntMem(0,100)<15*(1+B2R_ExD(first_crit)) and max_crit_count>crit_count then	// Закаленный меч
		set crit_damage=crit_damage+(1*crit_factor)
        set first_crit = false
		set crit_count = crit_count + 1
	endif
	if UnitHasItemOfTypeBJ(newCaster, 'I01K') and GetRandomIntMem(0,100)<15*(1+B2R_ExD(first_crit)) and max_crit_count>crit_count then	// Меч A ранга
		set crit_damage=crit_damage+(1.0*crit_factor)
        set first_crit = false
		set crit_count = crit_count + 1
	endif
	if UnitHasItemOfTypeBJ(newCaster, 'I01I') and GetRandomIntMem(0,100)<15*(1+B2R_ExD(first_crit)) and max_crit_count>crit_count then	// Меч B ранга
		set crit_damage=crit_damage+(0.75*crit_factor)
        set first_crit = false
		set crit_count = crit_count + 1
	endif
	if UnitHasItemOfTypeBJ(newCaster, 'I01J') and GetRandomIntMem(0,100)<15*(1+B2R_ExD(first_crit)) and max_crit_count>crit_count then	// Меч C ранга
		set crit_damage=crit_damage+(0.5*crit_factor)
        set first_crit = false
		set crit_count = crit_count + 1
	endif
	if GetUnitAbilityLevel(newCaster,'WAE1')>0 and GetRandomIntMem(0,100)<30*(1+B2R_ExD(first_crit)) and max_crit_count>crit_count then	// Waver F
		set crit_damage=crit_damage+(0.5*crit_factor)
        set first_crit = false
		set crit_count = crit_count + 1
	endif
	if (UnitHasItemOfTypeBJ(newTarget,'IAoF') or GetUnitAbilityLevel(newTarget,'KI1A')>0) and GetRandomIntMem(0,100)<30*(1+B2R_ExD(first_crit)) and max_crit_count>crit_count then	// Waver F
		if crit_damage>(1*crit_factor) then
            set crit_damage=crit_damage-(1*crit_factor)
        else
            set crit_damage=0
        endif
	endif
	//call BJDebugMsg(R2S(crit_damage))
    // критический урон
    if attack_factor<1.0 then
        set current_damage = current_damage*attack_factor
    endif
    set damage = damage + (current_damage * crit_damage)
    //
	
	if modif_factor>0.0 and UnitHaveShield(newCaster,newTarget,damage)==false then
	
		if UnitHasItemOfTypeBJ(newCaster, 'I031') and IsUnitType(newTarget,UNIT_TYPE_HERO) and IsUnitIllusion(newTarget)==false then 	// Патриот
			set bjLCT=CreateTimer()
				call SetHeroAgi(newCaster,GetHeroAgi(newCaster,false)+3,true)
				call SetHeroStr(newCaster,GetHeroStr(newCaster,false)+3,true)
				call SetHeroInt(newCaster,GetHeroInt(newCaster,false)+3,true)
				if GetUnitTypeId(newTarget)=='H00Q' then
                    call SetHeroAgi(Hero[GetPlayerId(GetOwningPlayer(newTarget))],GetHeroAgi(Hero[GetPlayerId(GetOwningPlayer(newTarget))],false)-3,true)
                    call SetHeroStr(Hero[GetPlayerId(GetOwningPlayer(newTarget))],GetHeroStr(Hero[GetPlayerId(GetOwningPlayer(newTarget))],false)-3,true)
                    call SetHeroInt(Hero[GetPlayerId(GetOwningPlayer(newTarget))],GetHeroInt(Hero[GetPlayerId(GetOwningPlayer(newTarget))],false)-3,true)
                    call SaveUnitHandle(h,GetHandleId(bjLCT), 0, newTarget)
                else
                    call SetHeroAgi(newTarget,GetHeroAgi(newTarget,false)-3,true)
                    call SetHeroStr(newTarget,GetHeroStr(newTarget,false)-3,true)
                    call SetHeroInt(newTarget,GetHeroInt(newTarget,false)-3,true)
                    call SaveUnitHandle(h,GetHandleId(bjLCT), 0, newTarget)
                endif
				call SaveUnitHandle(h,GetHandleId(bjLCT), 1, newCaster)
				call TimerStart(bjLCT, 5*modif_factor, false, function VergilPatriot_ModifEnd)
			set bjLCT=null
			//set damage=damage-damage*0.3
		endif
		
		if UnitHasItemOfTypeBJ(newCaster, 'I04F') then 				// Экскалибур
            call HealTextTag(newCaster,newCaster,damage*0.2*heal_factor*myCustomHeal2(newCaster,1),"HealthRes")
			call SetWidgetLife(newCaster, GetWidgetLife(newCaster)+myCustomDamage2(newTarget, damage*0.2))
			set bjLCT=CreateTimer()
				call SetUnitArmour(newTarget, GetUnitArmour(newTarget)-4)
				call SaveUnitHandle(h,GetHandleId(bjLCT), 0, newTarget)
				call SaveUnitHandle(h,GetHandleId(bjLCT), 1, newCaster)
				call TimerStart(bjLCT, 10*modif_factor, true, function SinonExcalibur_ModifEnd)
			set bjLCT=null
		endif
		
		if UnitHasItemOfTypeBJ(newCaster, 'I01S') and GetRandomInt(0, 9)<=3 then 				// Темный Экскалибур
			if LoadBoolean(h, GetHandleId(newCaster), SH_ItemDarkExc_CD)==false then
				set bjLCT=CreateTimer()
				call SaveBoolean(h, GetHandleId(newCaster), SH_ItemDarkExc_CD, true)
				call UnitRemoveAbility(newCaster, 'A26R')
				call UnitAddAbility(newCaster,'A26R')
				call SaveUnitHandle(h,GetHandleId(bjLCT),0,newCaster)
				call TimerStart(bjLCT,3,false,function VergilDarkExcalibur_ModifEnd)
				set bjLCT=null
			endif
		endif
		
		if GetUnitAbilityLevel(newCaster, 'A26R')>0 then										// Темный Экскалибур Хилл
            call HealTextTag(newCaster,newCaster,damage*0.5*heal_factor*myCustomHeal2(newCaster,1),"HealthRes")
			call SetWidgetLife(newCaster, GetWidgetLife(newCaster)+myCustomDamage2(newTarget, damage*0.5*heal_factor))
		endif
		
		if GetUnitAbilityLevel(newCaster, 'B06N')>0 then										// Жанна Альтер Хилл
            call HealTextTag(newCaster,newCaster,damage*0.3*heal_factor*myCustomHeal2(newCaster,1),"HealthRes")
			call SetWidgetLife(newCaster, GetWidgetLife(newCaster)+myCustomDamage2(newTarget, damage*0.3*heal_factor))
		endif
		
		if UnitHasItemOfTypeBJ(newCaster, 'I03O') then 				// Самехада: Чистый Урон
			set bonus_damage=(150+GetUnitTotalDamage(newCaster)*0.4)*modif_factor
			if GetWidgetLife(newTarget)>bonus_damage then
				//call SetWidgetLife(newTarget, GetWidgetLife(newTarget)-bonus_damage)
				call CustomTrueDamage(newCaster, newTarget, bonus_damage)
			else
				set fatal_damage=true
			endif
		endif
		
		if UnitHasItemOfTypeBJ(newCaster, 'I03B') or UnitHasItemOfTypeBJ(newCaster, 'I03F') then				// Меч Анбу
			set bonus_damage=55*modif_factor
			if GetWidgetLife(newTarget)>bonus_damage then
				//call SetWidgetLife(newTarget, GetWidgetLife(newTarget)-bonus_damage)
				call CustomTrueDamage(newCaster, newTarget, bonus_damage)
			else
				set fatal_damage=true
			endif
		endif
		
		if UnitHasItemOfTypeBJ(newCaster, 'I050') then				// Гегецебури
			set bonus_damage=80*modif_factor
			if GetWidgetLife(newTarget)>bonus_damage then
				//call SetWidgetLife(newTarget, GetWidgetLife(newTarget)-bonus_damage)
				call CustomTrueDamage(newCaster, newTarget, bonus_damage)
			else
				set fatal_damage=true
			endif
			call DestroyEffect(AddSpecialEffect("war3mapImported\\Cleave.mdx",GetUnitX(newTarget),GetUnitY(newTarget)))
            if GetRandomIntMem(0,100)<20 or LoadReal(HH,GetHandleId(newCaster),'AAcd')==0 then
                call SetControlToUnit(newTarget, newTarget, 1.0, "stun")
                call SetControlToUnit(newTarget, newTarget, 0.2, "stunbkb")
            endif
		endif
		
		if GetUnitAbilityLevel(newCaster,'WAE4')==0 and GetUnitAbilityLevel(newCaster,'WAE1')>0 then
			call SetControlToUnit(newTarget,newTarget, 0.3, "stun")
			call UnitAddAbility(newCaster,'WAE4')
			call UnitRemoveAbilityTimed(newCaster,'WAE4',0.7)
			set damage = damage + GetHeroInt(newCaster,true) * modif_factor
		endif
		
		if UnitHasItemOfTypeBJ(newCaster, 'I03N') then 				// Самехада: Манажор
			call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Feedback\\ArcaneTowerAttack.mdl", newTarget,"origin"))
			call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl", newTarget,"chest"))
			if GetWidgetMana(newTarget)>0 then
                call HealTextTag(newCaster,newCaster,(GetWidgetMana(newTarget)*0.16*modif_factor)*heal_factor*myCustomHeal2(newCaster,1),"HealthRes")
				call SetWidgetLife(newCaster, GetWidgetLife(newCaster)+(GetWidgetMana(newTarget)*0.16*modif_factor)*heal_factor)
			endif
			call SetWidgetMana(newTarget, GetWidgetMana(newTarget)-GetWidgetMana(newTarget)*0.08*modif_factor)
		endif
		
		if UnitHasItemOfTypeBJ(newCaster, 'I01U') and GetRandomInt(1, 100)<=45 then 		// Feng
			call PoisonDamage5(newCaster,newTarget, 2.5*GetHeroInt(newCaster,true)*modif_factor, 3, "Abilities\\Weapons\\PoisonSting\\PoisonStingTarget.mdl", "chest")
			call SlowUnit(newCaster,newTarget,0.5,0.,1*modif_factor,1,false)
		endif
		if UnitHasItemOfTypeBJ(newCaster, 'I01Q') and (GetRandomInt(1, 100)<=20 or GetUnitAbilityLevel(newCaster,'A06K')>0) then 		// Сюсуй
			call Shusui_Cast(newCaster, modif_factor)
		endif
        if UnitHasItemOfTypeBJ(newTarget,'I05O')or UnitHasItemOfTypeBJ(newTarget,'I05P')or UnitHasItemOfTypeBJ(newTarget,'I05Q')or UnitHasItemOfTypeBJ(newTarget,'I05R')or UnitHasItemOfTypeBJ(newTarget,'I05S')or UnitHasItemOfTypeBJ(newTarget,'I05T') or GetUnitAbilityLevel(newTarget, 'KIT8')>0 or GetUnitAbilityLevel(newTarget, 'KIU0')>0 or GetUnitAbilityLevel(newTarget, 'KIU2')>0 or GetUnitAbilityLevel(newTarget, 'KIU4')>0 or GetUnitAbilityLevel(newTarget, 'KIU6')>0 or GetUnitAbilityLevel(newTarget, 'KIU8')>0 then
            call RainMare_Actions(newCaster,newTarget)
        endif
		// if UnitHasItemOfTypeBJ(newTarget, 'I03C') and UnitHasItemOfTypeBJ(newTarget, 'I03F')==false then	// Жилет Анбу у таргета
			// set damage=damage-25
			// call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Heal\\HealTarget.mdl", newTarget,"origin"))
		// endif
		
		// if UnitHasItemOfTypeBJ(newTarget, 'I03F') then														// Комплект Анбу у таргета
			// set damage=damage-50
			// call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Heal\\HealTarget.mdl", newTarget,"origin"))
		// endif
		
		// if UnitHasItemOfTypeBJ(newTarget, 'I060') then														// Облако Маре D ранг
			// set damage=damage-20
		// endif
		
		// if UnitHasItemOfTypeBJ(newTarget, 'I061') then														// Облако Маре C ранг
			// set damage=damage-40
		// endif
		
		// if UnitHasItemOfTypeBJ(newTarget, 'I062') then														// Облако Маре B ранг
			// set damage=damage-60
		// endif
		
		// if UnitHasItemOfTypeBJ(newTarget, 'I063') then														// Облако Маре A ранг
			// set damage=damage-80
		// endif
			
		// if UnitHasItemOfTypeBJ(newTarget, 'I064') then														// Облако Маре Фальшивое
			// set damage=damage-100
		// endif
		
		// if UnitHasItemOfTypeBJ(newTarget, 'I065') then														// Облако Маре Истинное
			// set damage=damage-120
		// endif
		
		endif
	endif
	
    set damage = damage + newDamage

    if damage>0 then                
        if overcharge then                  // Сверхзаряд Синон
            set damage = damage + (GetWidgetMaxLife(newTarget)-GetWidgetLife(newTarget))*0.2
        endif

        // Попадение в спину
        if (GetUnitFacing(newTarget)-GetUnitFacing(newCaster))<=75 and(GetUnitFacing(newTarget)-GetUnitFacing(newCaster))>=-75 then
            set damage = damage*1.15
            set backstab = true
        endif

        // Хрупкость -15% маг реза
        if GetUnitAbilityLevel(newTarget, 'SNT1')>0 then
            set fragility = true
            call UnitAddAbility(newTarget, 'SNT2')
			set soundplay=SndN(4165) // Sound\Music\mp3Music\SinonThit.mp3
			call StartSound(soundplay)
			//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        endif
    endif


	if miss then
		call AllTextTag("|c00C0C0C0Miss!|r" , newTarget)
        set damage = 0
    else
        call SaveReal(HH,GetHandleId(newCaster),'AAcd',10)
        if attack_factor>0.5 then
            // Текст над головой
            if first_crit==false then
				if crit_count>1 then
					set text_damage = "|c00880a0aCRIT!x"+I2S(crit_count)+"|r"
				else
					set text_damage = "|c00880a0aCRIT!|r"
				endif
            endif
            if backstab and first_crit==false then
                set text_damage = text_damage + " + |c007a02dbBACKSTAB!|r"
            elseif backstab then
                set text_damage = "|c007a02dbBACKSTAB!|r"
            endif
            // if yamato and (first_crit==false or backstab) then
            //     set text_damage = text_damage + " + |c000080FFYAMATO!|r"
            // elseif yamato then
            //     set text_damage = "|c000080FFYAMATO!|r"
            // endif
            if fragility and (first_crit==false or backstab) then
                set text_damage = text_damage + " + |c00009eceFRAGILITY!|r"
            elseif fragility then
                set text_damage = "|c00009eceFRAGILITY!|r"
            endif
            if overcharge and (fragility or first_crit==false or backstab) then
                set text_damage = text_damage + " + |c00007cceOVERCHARGE!|r"
            elseif overcharge then
                set text_damage = "|c00007cceOVERCHARGE!|r"
            endif
            call AllTextTag(text_damage , newTarget)
        endif
	endif
	
	
	if fatal_damage==false then
		if damage>0 then
			call myCustomDamage(newCaster,newTarget,damage,false,false,null,null,null)
        else
            if miss==false then
                call myCustomDamage(newCaster,newTarget,10,false,false,null,null,null)
            endif
		endif
	else
		call UnitRemoveBuffs(newTarget,true,true)
		call UnitAddAbility(newTarget,'A0WR')
        call DamageIndicatorFunction(newCaster,newTarget,damage)
		call myCustomDamage(newCaster, newTarget, GetWidgetMaxLife(newTarget),false,false,null,null,null)
		call UnitRemoveAbility(newTarget,'A0WR')
		//call AllTextTag("|c000080FFSCUM!|r" , newTarget)
	endif	
    if fragility then
        call UnitRemoveAbility(newTarget, 'SNT2')
        call UnitRemoveAbility(newTarget, 'SNT1')
        call UnitRemoveAbility(newTarget, 'B16W')
    endif
	return miss
endfunction

function KarnaQ_Periodic takes nothing returns nothing 
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    caster = LoadUnitHandle(h, id, 0)
    local integer c_id   = GetHandleId(caster)
    local real    duration = LoadReal(h, id, 1)+0.02
    local real    angle    = 0.0
    local real    damage   = LoadReal(HH, c_id, KarnaQ_Damage)
	local real    damage_force = 1+GetUnitAbilityLevel(caster, 'KaA3')*0.3
    local integer index    = 0
    local integer eff_period = LoadInteger(h, id, 12)
    if duration<8.0 and damage>0 then
        call SaveReal(h, id, 1, duration)
        if duration==2.0 then
            call RemoveEffect(AddSpecialEffectTarget("supershinythingyhg2.mdl", caster, "weapon"), 0.8, true, CreateTimer())
            call UnitAddAbility(caster, 'KaA5')
            call SetUnitAbilityLevel(caster, 'KaA5', GetUnitAbilityLevel(caster,'KaA4'))
            call UnitRemoveAbility(caster, 'KaA4')
        endif
        if duration<2.0 then
            //call SaveReal(HH, c_id, KarnaQ_Damage, damage+2.5*0.02/2)
            call SaveReal(HH, c_id, KarnaQ_Damage, 1.0+duration/2*damage_force)
            if eff_period<=0 then
                set n=CreateUnit(GetOwningPlayer(caster), 'd060', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG)
                call SetUnitScale(n, 2.5, 2.5, 2.5)
                call SetUnitTimeScale(n, 0.6)
                call SetUnitFlyHeight(n, 250, 0)
                call SetUnitAnimationByIndex(n, GetRandomInt(0, 16))
                call MyRemoveUnit(n, 2)
                call SaveInteger(h, id, 12, 1)
            else
                call SaveInteger(h, id, 12, eff_period-1)
            endif
        else
            call DestroyEffect(AddSpecialEffectTarget("krk (1965).mdl", caster, "weapon"))
        endif
		
		call SetUnitXY(LoadUnitHandle(h, id, 20), GetUnitX(caster), GetUnitY(caster))
    else
		call RemoveUnit(LoadUnitHandle(h, id, 20))
        call UnitRemoveAbility(caster, 'KaA4')
        call UnitRemoveAbility(caster, 'KaA5')
        call ShowAbility2('KaA3', true)
        if damage<=0 then
            call StartAbilityCooldown(GetUnitAbility(caster, 'KaA3'), GetAbilityCooldown(GetUnitAbility(caster, 'KaA3')))
        endif
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set newTimer = null
    set caster   = null
endfunction

function KarnaQ_Cast takes unit newCaster returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id   = GetHandleId(newCaster)
    local real caster_x  = GetUnitX(newCaster)
    local real caster_y  = GetUnitY(newCaster)
    local real angle     = GetUnitFacing(newCaster)*bj_DEGTORAD
    local integer index  = 0
    call CreateModeIndicatorKarnaQ(newCaster, "ReplaceableTextures\\CommandButtons\\BTNKarnaQ_Cast.blp", 8.0)
    set soundplay=SndN(4167) // Sound\Music\mp3Music\KarnaQ0.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
	set n = CreateUnit(GetOwningPlayer(newCaster), 'd130', caster_x, caster_y, 0)
	call UnitScale(n, 0.1, 10.0, 0.15)
	call UnitAddAbility(n, 'A0A1')
	call SaveUnitHandle(h, id, 20, n)
    call UnitAddAbility(newCaster, 'KaA4')
    call SetUnitAbilityLevel(newCaster, 'KaA4', GetUnitAbilityLevel(newCaster,'KaA3'))
    call ShowAbility2('KaA3', false)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(HH, c_id, KarnaQ_Damage, 1.0)
    call TimerStart(newTimer, 0.02, true, function KarnaQ_Periodic)
    set newTimer = null
endfunction


function KarnaQ_LaserBlastAct takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    caster = LoadUnitHandle(h, id, 0)
    local real    point_x = LoadReal(h, id, 1)
    local real    point_y = LoadReal(h, id, 2)
    local boolean second_anim   = LoadBoolean(h, id, 4)
    local real    damage        = GetHeroAgi(caster, true)*(1+GetHeroLevel(caster)*0.1)
    //set damage = damage + damage*0.3*(damage_factor-1.0)/8.3

    set n = CreateUnit(GetOwningPlayer(caster), 'dR36', point_x, point_y, GetRandomInt(0, 360))
    call SetUnitScale(n, 2, 2, 2)
    call MyRemoveUnit(n, 3.5)
    set n = CreateUnit(GetOwningPlayer(caster), 'd107', point_x, point_y, GetRandomInt(0, 360))
    call SetUnitScale(n, 0.35, 0.35, 0.35)
    call UnitApplyTimedLife(n,'BTLF', 0.5)
    call MyRemoveUnit(n, 1.0)
    set n = CreateUnit(GetOwningPlayer(caster), 'd108', point_x, point_y, GetRandomInt(0, 360))
    call SetUnitScale(n, 0.5, 0.5, 0.5)
    call MyRemoveUnit(n, 3.5)
    //set n = CreateUnit(GetOwningPlayer(caster), 'd109', point_x, point_y, GetRandomInt(0, 360))
    //call SetUnitScale(n, 1.0, 1.0, 1.0)
    //call SetUnitVertexColor(n, 255, 0, 0, 255)
    //call MyRemoveUnit(n, 3.5)
    // set n = CreateUnit(GetOwningPlayer(caster), 'dR36', point_x, point_y, GetRandomInt(0, 360))
    // call SetUnitScale(n, 2, 2, 2)
    // call MyRemoveUnit(n, 3.5)
    // set n = CreateUnit(GetOwningPlayer(caster), 'd021', point_x, point_y, GetRandomInt(0, 360))
    // call SetUnitScale(n, 1, 1, 1)
    // call MyRemoveUnit(n, 3.5)
    // set n = CreateUnit(GetOwningPlayer(caster), 'dM28', point_x, point_y, GetRandomInt(0, 360))
    // call SetUnitScale(n, 1, 1, 1)
    // call SetUnitVertexColor(n, 255, 255, 255, 170)
    // call MyRemoveUnit(n, 3.5)
    // set n = CreateUnit(GetOwningPlayer(caster), 'dRe9', point_x, point_y, GetRandomInt(0, 360))
    // call SetUnitScale(n, 2, 2, 2)
    // call UnitApplyTimedLife(n,'BTLF', 2.0)
    // call MyRemoveUnit(n, 3.5)

    call GroupEnumUnitsInRange(G, point_x, point_y, 200, Base)
    loop
    set E=FirstOfGroup(G)
    exitwhen E==null
        if Condition_Base(GetOwningPlayer(caster), E) and GetUnitAbilityLevel(E, 'KaAW')==0 then
            // if GetUnitAbilityLevel(caster, 'KaAC')>0 then
            //     call UnitRemoveAbility(caster,'KaAC')
            //     call UnitRemoveAbility(caster,'kaA1')
            //     set damage = damage + GetHeroAgi(caster, true)*2
            //     set n=CreateUnit(GetOwningPlayer(caster), 'd032', GetUnitX(E), GetUnitY(E), GetRandomInt(0, 360))
            //     call SetUnitScale(n, 4, 4, 4)
            //     call SetUnitVertexColor(n, 255, 150, 100, 255)
            //     call SetUnitFlyHeight(n, 100, 0)
            //     call MyRemoveUnit(n, 2.5)
            // endif
            call myCustomDamage(caster, E, damage, false,false,null,null,null)
            call SetControlToUnit(E, E, 1.0, "stun")
            call UnitAddAbility(E, 'KaAW')
            call UnitMakeAbilityPermanent(E, true, 'KaAW')
            call UnitRemoveAbilityTimed(E, 'KaAW', 0.2)
        endif
    call GroupRemoveUnit(G, E)
    endloop

    call FlushChildHashtable(h, id)
    call DestroyTimer(newTimer)
    set newTimer = null
    set caster   = null
endfunction

function KarnaQ_LaserBlast takes unit newCaster, real point_x, real point_y, boolean second_anim returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)

    set n = CreateUnit(GetOwningPlayer(newCaster), 'd105', point_x, point_y, GetRandomInt(0, 360))
    call SetUnitScale(n, 1.0, 1.0, 1.0)
    call UnitApplyTimedLife(n,'BTLF', 0.5)
    call MyRemoveUnit(n, 1.0)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(h, id, 1, point_x)
    call SaveReal(h, id, 2, point_y)
    call SaveBoolean(h, id, 4, second_anim)
    call TimerStart(newTimer, 1.0, false, function KarnaQ_LaserBlastAct)
    set newTimer = null
endfunction

function KarnaQ1_Periodic2 takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    caster = LoadUnitHandle(h, id, 0)
    local unit    dummy  = LoadUnitHandle(h, id, 5)
    local real    distance = LoadReal(h, id, 4)
    local real    angle    = LoadReal(h, id, 2)
    local real    damage_factor = LoadReal(h, id, 1)
    local real    damage        = GetHeroAgi(caster, true)*GetUnitAbilityLevel(caster, 'KaA3')
    local integer eff_period    = LoadInteger(h, id, 6)
    //set damage = damage + damage*0.3*(damage_factor-1.0)/8.3
    if distance>0 and LoadBoolean(HH,GetHandleId(caster),DASH_USER)==true then
        call SetUnitX(dummy, GetUnitX(dummy)+50*Cos(angle))
        call SetUnitY(dummy, GetUnitY(dummy)+50*Sin(angle))
        call SaveReal(h, id, 4, distance-50)
        call GroupEnumUnitsInRange(G, GetUnitX(dummy), GetUnitY(dummy), 220, Base)
        loop
            set E=FirstOfGroup(G)
            exitwhen E==null
            if Condition_Base(GetOwningPlayer(caster), E) and GetUnitAbilityLevel(E, 'KaAW')==0 then
                if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
                    // if GetUnitAbilityLevel(caster, 'KaAC')>0 then
                    //     call UnitRemoveAbility(caster,'KaAC')
                    //     call UnitRemoveAbility(caster,'kaA1')
                    //     set damage = damage + GetHeroAgi(caster, true)*2
                    //     set n=CreateUnit(GetOwningPlayer(caster), 'd032', GetUnitX(E), GetUnitY(E), GetRandomInt(0, 360))
                    //     call SetUnitScale(n, 4, 4, 4)
                    //     call SetUnitVertexColor(n, 255, 150, 100, 255)
                    //     call SetUnitFlyHeight(n, 100, 0)
                    //     call MyRemoveUnit(n, 2.5)
                    // endif
                    if Karna_ModifAttack(caster, E, damage_factor, damage, 0.6, false) then
                        if GetUnitAbilityLevel(caster,'BoPB')>0 then
                            call Push5(E,35,AU(caster,E),70,"")
                        endif
                        if GetUnitAbilityLevel(caster,'BoPD')>0 then
                            call Push5(E,35,AU(E,caster),70,"")
                        endif
                    endif
                    call SetControlToUnit(E, E, 2, "stun")
                    call UnitAddAbility(E, 'KaAW')
                    call UnitMakeAbilityPermanent(E, true, 'KaAW')
                    call UnitRemoveAbilityTimed(E, 'KaAW', 0.2)
                    call AGilPush(E,20,angle,200)
                else
                    call SaveBoolean(HH,GetHandleId(caster),DASH_USER,false)
                    call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,caster)
                endif
            endif
            call GroupRemoveUnit(G, E)
        endloop
			// set n=CreateUnit(GetOwningPlayer(caster), 'd062', GetUnitX(dummy), GetUnitY(dummy), 0)
			// call SetUnitScale(n, 0.5, 0.5, 0.5)
			// call SetUnitFlyHeight(n, 50, 0)
			// call UnitApplyTimedLife(n,'BTLF', 1.3)
			// call MyRemoveUnit(n, 1.7)
            // set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH05', GetUnitX(dummy), GetUnitY(dummy), angle*bj_RADTODEG)
            // call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
            // call MyRemoveUnit(bjLCU, 1.5)
            // set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH06', GetUnitX(dummy), GetUnitY(dummy), angle*bj_RADTODEG)
            // call SetUnitScale(bjLCU, 1.2, 1.2, 1.2)
            // call SetUnitTimeScale(bjLCU, 0.6)
            // call SetUnitFlyHeight(bjLCU, 50, 0)
            // call MyRemoveUnit(bjLCU, 1.5)
            // set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dRe9', GetUnitX(dummy), GetUnitY(dummy), angle*bj_RADTODEG)
            // call SetUnitScale(bjLCU, 3.25, 3.25, 3.25)
            // call UnitApplyTimedLife(bjLCU, 'BTLF', 1.0)
            // call MyRemoveUnit(bjLCU, 3.0)
            // if eff_period<=0 then
            //     call KarnaQ_LaserBlast(caster, GetUnitX(dummy), GetUnitY(dummy), damage_factor, false)
            //     call SaveInteger(h, id, 6, 4)
            // else
            //     call SaveInteger(h, id, 6, eff_period - 1)
            // endif
    else
        call SaveBoolean(HH,GetHandleId(caster),DASH_USER,false)
        call MyRemoveUnit(dummy, 1.0)
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set newTimer = null
    set caster   = null
    set dummy=null
endfunction

function KarnaQ1_Periodic1 takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    caster = LoadUnitHandle(h, id, 0)
    local real    angle  = LoadReal(h, id, 2)
    local real    duration = LoadReal(h, id, 3)-0.1
    if duration>0 then
        call SaveReal(h, id, 3, duration)
    else
        call ShakeCamera(0.3, 10)
        set n=CreateUnit(GetOwningPlayer(caster), 'd131', GetUnitX(caster)+200*Cos(angle), GetUnitY(caster)+200*Sin(angle), angle*bj_RADTODEG)
        call SetUnitFlyHeight(n, 100, 0)
        call UnitScale(n, 0.1, 2.0, 0.2)
        call UnitApplyTimedLife(n,'BTLF', 0.4)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'd131', GetUnitX(caster)+200*Cos(angle), GetUnitY(caster)+200*Sin(angle), angle*bj_RADTODEG)
        call SetUnitFlyHeight(n, 100, 0)
        call SetUnitScale(n, 2.0, 2.0, 2.0)
        call KillUnit(n)
        call MyRemoveUnit(n, 1.5)

        set n=CreateUnit(GetOwningPlayer(caster), 'dR39', GetUnitX(caster)+150*Cos(angle), GetUnitY(caster)+150*Sin(angle), angle*bj_RADTODEG+90)
        call SetUnitFlyHeight(n, 50, 0)
        call UnitScale(n, 0.1, 1.1, 0.2)
        call MyRemoveUnit(n, 1.4)
        set n=CreateUnit(GetOwningPlayer(caster), 'dR39', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG+90)
        call SetUnitFlyHeight(n, 50, 0)
        call UnitScale(n, 0.1, 1.3, 0.2)
        call MyRemoveUnit(n, 1.4)

        set n=CreateUnit(GetOwningPlayer(caster), 'dR39', GetUnitX(caster)+150*Cos(angle), GetUnitY(caster)+150*Sin(angle), angle*bj_RADTODEG+90)
        call SetUnitFlyHeight(n, 50, 0)
        call UnitScale(n, 0.1, 1.5, 0.2)
        call MyRemoveUnit(n, 1.4)
        
        set n=CreateUnit(GetOwningPlayer(caster), 'dAlb', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG)
        call SetUnitFlyHeight(n, 0, 0)
        call SaveUnitHandle(h, id, 5, n)
        call SetUnitFacing(caster, LoadReal(h, id, 2)*bj_RADTODEG)
        call SetUnitTimeScale(caster, 1.0)
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call SaveBoolean(HH,GetHandleId(caster),DASH_USER,true)
        call PauseTimer(newTimer)
        call TimerStart(newTimer, 0.005, true, function KarnaQ1_Periodic2)
    endif
    set newTimer = null
    set caster   = null
endfunction

function KarnaQ1_Cast takes unit newCaster, real point_x, real point_y returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local real caster_x  = GetUnitX(newCaster)
    local real caster_y  = GetUnitY(newCaster)
    local real angle     = AP(caster_x, caster_y, point_x, point_y)
    local integer index  = 0

    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, 13)
    if SquareRootPoint(caster_x, caster_y, point_x, point_y)>1000 then
        set point_x=caster_x+1000*Cos(angle)
        set point_y=caster_y+1000*Sin(angle)
    endif
	call RengokuE_Shifting(newCaster, newCaster, angle, SquareRootPoint(caster_x, caster_y, point_x, point_y), CreateTimer())
	set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dH05', caster_x, caster_y, angle*bj_RADTODEG)
	call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
	call MyRemoveUnit(bjLCU, 1.5)
	set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dH06', caster_x, caster_y, angle*bj_RADTODEG)
	call SetUnitScale(bjLCU, 1.2, 1.2, 1.2)
	call SetUnitTimeScale(bjLCU, 0.6)
	call SetUnitFlyHeight(bjLCU, 50, 0)
	call MyRemoveUnit(bjLCU, 1.5)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dRe9', caster_x, caster_y, angle*bj_RADTODEG)
	call SetUnitScale(bjLCU, 3.25, 3.25, 3.25)
    call UnitApplyTimedLife(bjLCU, 'BTLF', 1.0)
	call MyRemoveUnit(bjLCU, 3.0)

    set soundplay=SndN(4169) // Sound\Music\mp3Music\KarnaQ1.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять

    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(h, id, 1, LoadReal(HH, GetHandleId(newCaster), KarnaQ_Damage)) // фулл урон спелла
    call SaveReal(h, id, 2, angle)
    call SaveReal(h, id, 3, 0.5)  // время ожидания первого акта
    call SaveReal(h, id, 4, 350) // дальность спелла
    call SaveReal(HH, GetHandleId(newCaster), KarnaQ_Damage, 0.0)
    call TimerStart(newTimer, 0.1, true, function KarnaQ1_Periodic1)
    set newTimer = null
endfunction



function KarnaQ2_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
	local unit caster=LoadUnitHandle(h, id, c_CASTER)
    local real caster_x= GetUnitX(caster)
    local real caster_y= GetUnitY(caster)
    local real angle= LoadReal(h, id, c_ANGLE)
    local real time= LoadReal(h, id, c_TIME)
    local string combination= LoadStr(h, id, 16)
    local integer eff_period= LoadInteger(h, id, c_EFFPERIOD)
    local real    damage_factor = LoadReal(h, id, c_DAMAGE)
    local real    damage        = GetHeroAgi(caster, true)*GetUnitAbilityLevel(caster, 'KaA3')
    //set damage = damage + damage*0.3*(damage_factor-1.0)/8.3
    if time < 20 then
        call SaveReal(h, id, c_TIME, time + 1)
        // if time == 1 then
        //     call SetUnitAnimationByIndex(LoadUnitHandle(h, id, c_CASTER), 9)
        // endif
        if time < 18 then
            set bjLCU=LoadUnitHandle(h, id, 16)
            call SetUnitX(bjLCU , caster_x + 200 * Cos(angle - ( 90 - time * 11 ) * bj_DEGTORAD))
            call SetUnitY(bjLCU , caster_y + 200 * Sin(angle - ( 90 - time * 11 ) * bj_DEGTORAD))
            set bjLCU=LoadUnitHandle(h, id, 17)
            call SetUnitX(bjLCU , caster_x + 325 * Cos(angle - ( 90 - time * 11 ) * bj_DEGTORAD))
            call SetUnitY(bjLCU , caster_y + 325 * Sin(angle - ( 90 - time * 11 ) * bj_DEGTORAD))
            set bjLCU=LoadUnitHandle(h, id, 18)
            call SetUnitX(bjLCU , caster_x + 450 * Cos(angle - ( 90 - time * 11 ) * bj_DEGTORAD))
            call SetUnitY(bjLCU , caster_y + 450 * Sin(angle - ( 90 - time * 11 ) * bj_DEGTORAD))
            call SetUnitFacing(LoadUnitHandle(h, id, c_DUMMY1), angle * bj_RADTODEG - 95 + time * 4)
            call SetUnitFacing(LoadUnitHandle(h, id, c_DUMMY2), angle * bj_RADTODEG - 95 + time * 4)
            call SetUnitFacing(LoadUnitHandle(h, id, c_DUMMY3), angle * bj_RADTODEG - 95 + time * 4)
            call SetUnitFacing(LoadUnitHandle(h, id, c_DUMMY4), angle * bj_RADTODEG - 95 + time * 4)
            if combination == "E" then
                if eff_period == 0 then
					set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR99', caster_x+150*Cos(angle-(90-time*11)*bj_DEGTORAD), caster_y+150*Sin(angle-(90-time*11)*bj_DEGTORAD), 140 + angle * bj_RADTODEG + 33 + time * 4)
					call SetUnitScale(bjLCU, 0.8, 0.8, 0.8)
					call SetUnitVertexColor(bjLCU, 255, 255, 255, 100)
					call MyRemoveUnit(bjLCU, 1.5)
					set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR99', caster_x + 300 * Cos(angle - ( 90 - time * 11 ) * bj_DEGTORAD), caster_y + 300 * Sin(angle - ( 90 - time * 11 ) * bj_DEGTORAD), 140 + angle * bj_RADTODEG + 33 + time * 4)
					call SetUnitVertexColor(bjLCU, 255, 255, 255, 100)
					call MyRemoveUnit(bjLCU, 1.5)
					set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR99', caster_x + 450 * Cos(angle - ( 90 - time * 11 ) * bj_DEGTORAD), caster_y + 450 * Sin(angle - ( 90 - time * 11 ) * bj_DEGTORAD), 140 + angle * bj_RADTODEG + 33 + time * 4)
					call SetUnitScale(bjLCU, 1.3, 1.3, 1.3)
					call SetUnitVertexColor(bjLCU, 255, 255, 255, 100)
					call MyRemoveUnit(bjLCU, 1.5)
			
                    call SaveInteger(h, id, c_EFFPERIOD, 3)
                else
                    call SaveInteger(h, id, c_EFFPERIOD, eff_period - 1)
                endif
            endif
            set bjLCG=LoadGroupHandle(h, id, c_GROUP1)
            call GroupEnumUnitsInRange(bjLCG, caster_x + 350 * Cos(angle - ( 49 - time * 5 ) * bj_DEGTORAD), caster_y + 350 * Sin(angle - ( 49 - time * 5 ) * bj_DEGTORAD), 400, Base)
            loop
            set bjLCU=FirstOfGroup(bjLCG)
            exitwhen bjLCU == null
                if Condition_Base(GetOwningPlayer(caster) , bjLCU) and IsUnitInGroup(bjLCU, LoadGroupHandle(h, id, c_GROUP2)) == false then
                    if Karna_ModifAttack(caster, bjLCU, damage_factor, damage, 0.6, false) then
                        if GetUnitAbilityLevel(caster,'BoPB')>0 then
                            call Push5(bjLCU,35,AU(caster,bjLCU),70,"")
                        endif
                        if GetUnitAbilityLevel(caster,'BoPD')>0 then
                            call Push5(bjLCU,35,AU(bjLCU,caster),70,"")
                        endif
                    endif
                    call RengokuW_EW_Act(caster, bjLCU , LoadReal(h, id, 19) , null, 800)
                    call SetControlToUnit(bjLCU, bjLCU, 2.0, "stun")
                    call SlowUnit(caster,bjLCU,0.5,0.5,3,0,false)
                    //call RengokuE_Shifting(caster , bjLCU , LoadReal(h, id, 19) , 150 , CreateTimer())
					// set n=CreateUnit(GetOwningPlayer(caster), 'dAlb', GetUnitX(bjLCU), GetUnitY(bjLCU), 0)
                    // call UnitAddAbility(n, 'RenS')
                    // call IssueTargetOrder(n, "slow", bjLCU)
                    // call MyRemoveUnit(n , 1.25)
					set n=CreateUnit(GetOwningPlayer(caster), 'dR36', GetUnitX(bjLCU), GetUnitY(bjLCU), GetRandomInt(0, 360))
					call SetUnitScale(n, 2, 2, 2)
					call MyRemoveUnit(n, 1.5)
                    set n=CreateUnit(GetOwningPlayer(caster), 'dH04', GetUnitX(bjLCU), GetUnitY(bjLCU), 0)
                    call SetUnitScale(n, 2, 2, 2)
                    call MyRemoveUnit(n, 1.5)
                    call GroupAddUnit(LoadGroupHandle(h, id, c_GROUP2), bjLCU)
                endif
                call GroupRemoveUnit(bjLCG, bjLCU)
            endloop
        endif
    else
        call KillUnit(LoadUnitHandle(h, id, 16))
        call KillUnit(LoadUnitHandle(h, id, 17))
        call KillUnit(LoadUnitHandle(h, id, 18))
		call MyRemoveUnit(LoadUnitHandle(h, id, 16), 1.5)
		call MyRemoveUnit(LoadUnitHandle(h, id, 17), 1.5)
		call MyRemoveUnit(LoadUnitHandle(h, id, 18), 1.5)
        call DestroyGroup(LoadGroupHandle(h, id, c_GROUP1))
        call DestroyGroup(LoadGroupHandle(h, id, c_GROUP2))
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        //call SetUnitTimeScale(LoadUnitHandle(h, id, CasterHash), 1.0)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
	set caster=null
endfunction


function KarnaQ2_WaitTime takes nothing returns nothing 
    local timer   newTimer = GetExpiredTimer()
    local integer id= GetHandleId(newTimer)
	local unit caster=LoadUnitHandle(h, id, c_CASTER)
    local real caster_x= GetUnitX(caster)
    local real caster_y= GetUnitY(caster)
    local real angle= LoadReal(h, id, c_ANGLE)

    call ShakeCamera(0.3 , 10)
    call SetUnitTimeScale(caster, 1.0)

    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR42', caster_x, caster_y, angle*bj_RADTODEG)
	call SetUnitVertexColor(bjLCU, 255, 255, 255, 100)
	call SetUnitFlyHeight(bjLCU, 100, 0)
	call MyRemoveUnit(bjLCU, 1.5)

    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'd119', caster_x - 50 * Cos(angle), caster_y - 50 * Sin(angle), angle * bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 200, 0)
    call SetUnitScale(bjLCU, 3.5, 3.5, 3.5)
    call SetUnitTimeScale(bjLCU, 0.65)
    call SaveUnitHandle(h, id, c_DUMMY1, bjLCU)
    call MyRemoveUnit(bjLCU , 3)
    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'd119', caster_x - 80 * Cos(angle), caster_y - 80 * Sin(angle), angle * bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 200, 0)
    call SetUnitScale(bjLCU, 3.2, 3.2, 3.2)
    call SetUnitTimeScale(bjLCU, 0.65)
    call SaveUnitHandle(h, id, c_DUMMY2, bjLCU)
    call MyRemoveUnit(bjLCU , 3)
    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'd119', caster_x - 130 * Cos(angle), caster_y - 130 * Sin(angle), angle * bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 200, 0)
    call SetUnitScale(bjLCU, 2.8, 2.8, 2.8)
    call SetUnitTimeScale(bjLCU, 0.65)
    call SaveUnitHandle(h, id, c_DUMMY3, bjLCU)
    call MyRemoveUnit(bjLCU , 3)
    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'd119', caster_x - 130 * Cos(angle), caster_y - 130 * Sin(angle), angle * bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 200, 0)
    call SetUnitScale(bjLCU, 2.2, 2.2, 2.2)
    call SetUnitTimeScale(bjLCU, 0.65)
    call SaveUnitHandle(h, id, c_DUMMY4, bjLCU)
    call MyRemoveUnit(bjLCU , 3)
    
	set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dRe9', caster_x+150*Cos(angle), caster_y+150*Sin(angle), angle*bj_RADTODEG)
	call SetUnitScale(bjLCU, 3.25, 3.25, 3.25)
	call SaveUnitHandle(h, id, 16, bjLCU)

	set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dRe9', caster_x+150*Cos(angle), caster_y+150*Sin(angle), angle*bj_RADTODEG)
	call SetUnitScale(bjLCU, 3.75, 3.75, 3.75)
	call SaveUnitHandle(h, id, 17, bjLCU)

	set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dRe9', caster_x+150*Cos(angle), caster_y+150*Sin(angle), angle*bj_RADTODEG)
	call SetUnitScale(bjLCU, 4, 4, 4)
	call SaveUnitHandle(h, id, 18, bjLCU)

    call TimerStart(newTimer, 0.02, true, function KarnaQ2_Periodic)
    set newTimer = null
    set caster   = null
endfunction

function KarnaQ2_Cast takes unit newCaster,real point_x,real point_y returns nothing
    local timer  newTimer = CreateTimer()
    local integer id= GetHandleId(newTimer)
    local integer id_caster= GetHandleId(newCaster)
    local real caster_x= GetUnitX(newCaster)
    local real caster_y= GetUnitY(newCaster)
    local real angle= AP(caster_x , caster_y , point_x , point_y)
    local string RengokuQWE_Comb= "E"
    local real full_damage= GetUnitAbilityLevel(newCaster, 'RenW') * GetHeroAgi(newCaster, true) + 60 * GetUnitAbilityLevel(newCaster, 'RenW') 


    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, 8)
    call SetUnitTimeScale(newCaster, 1.5)
    if SquareRootPoint(caster_x, caster_y, point_x, point_y)>1000 then
        set point_x=caster_x+1000*Cos(angle)
        set point_y=caster_y+1000*Sin(angle)
    endif
	call RengokuE_Shifting(newCaster, newCaster, angle, SquareRootPoint(caster_x, caster_y, point_x, point_y), CreateTimer())
	
	set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dH05', caster_x, caster_y, angle*bj_RADTODEG)
	call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
	call MyRemoveUnit(bjLCU, 1.5)
	set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dH06', caster_x, caster_y, angle*bj_RADTODEG)
	call SetUnitScale(bjLCU, 1.2, 1.2, 1.2)
	call SetUnitTimeScale(bjLCU, 0.6)
	call SetUnitFlyHeight(bjLCU, 50, 0)
	call MyRemoveUnit(bjLCU, 1.5)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dRe9', caster_x, caster_y, angle*bj_RADTODEG)
	call SetUnitScale(bjLCU, 3.25, 3.25, 3.25)
    call UnitApplyTimedLife(bjLCU, 'BTLF', 1.0)
	call MyRemoveUnit(bjLCU, 3.0)

    set soundplay=SndN(4171) // Sound\Music\mp3Music\KarnaQ2.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    

    call SaveUnitHandle(h, id, c_CASTER, newCaster)
    call SaveReal(h, id, c_ANGLE, angle)
    call SaveReal(h, id, 19, angle)
    call SaveReal(h, id, c_DAMAGE, LoadReal(HH, GetHandleId(newCaster), KarnaQ_Damage)) // фулл урон спелла
    call SaveReal(HH, GetHandleId(newCaster), KarnaQ_Damage, 0.0)
    call SaveStr(h, id, 16, RengokuQWE_Comb)
    call SaveGroupHandle(h, id, c_GROUP1, CreateGroup())
    call SaveGroupHandle(h, id, c_GROUP2, CreateGroup())
    call TimerStart(newTimer, 0.45, false, function KarnaQ2_WaitTime)
    set newTimer = null
endfunction

function KarnaQ1_LPeriodic2 takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    caster = LoadUnitHandle(h, id, 0)
    local unit    dummy  = LoadUnitHandle(h, id, 5)
    local real    distance = LoadReal(h, id, 4)
    local real    angle    = LoadReal(h, id, 2)
    local real    damage        = GetHeroAgi(caster, true)*(0.75+GetHeroLevel(caster)*0.05)
    local integer eff_period    = LoadInteger(h, id, 6)
    //set damage = damage + damage*0.3*(damage_factor-1.0)/8.3
    if distance>0 then
		call SetUnitOrientation(LoadUnitHandle(h, id, 105), angle * bj_RADTODEG, -0.0325*distance, 0)
        call SetUnitX(dummy, GetUnitX(dummy)+40*Cos(angle))
        call SetUnitY(dummy, GetUnitY(dummy)+40*Sin(angle))
        call SaveReal(h, id, 4, distance-40)
        call GroupEnumUnitsInRange(G, GetUnitX(dummy), GetUnitY(dummy), 125, Base)
        loop
        set E=FirstOfGroup(G)
        exitwhen E==null
            if Condition_Base(GetOwningPlayer(caster), E) and GetUnitAbilityLevel(E, 'KaAW')==0 then
                // if GetUnitAbilityLevel(caster, 'KaAC')>0 then
                //     call UnitRemoveAbility(caster,'KaAC')
                //     call UnitRemoveAbility(caster,'kaA1')
                //     set damage = damage + GetHeroAgi(caster, true)*2
                //     set n=CreateUnit(GetOwningPlayer(caster), 'd032', GetUnitX(E), GetUnitY(E), GetRandomInt(0, 360))
                //     call SetUnitScale(n, 4, 4, 4)
                //     call SetUnitVertexColor(n, 255, 150, 100, 255)
                //     call SetUnitFlyHeight(n, 100, 0)
                //     call MyRemoveUnit(n, 2.5)
                // endif
                call myCustomDamage(caster, E, damage, false,false,null,null,null)
                call SetControlToUnit(E, E, 1.0, "stun")
                call UnitAddAbility(E, 'KaAW')
                call UnitMakeAbilityPermanent(E, true, 'KaAW')
                call UnitRemoveAbilityTimed(E, 'KaAW', 0.2)
                call AGilPush(E,10,angle,50)
                // set n=CreateUnit(GetOwningPlayer(caster), 'dAlb', GetUnitX(E), GetUnitY(E), 0)
				// call UnitAddAbility(n, 'RenS')
				// call IssueTargetOrder(n, "slow", E)
				// call MyRemoveUnit(n , 1.25)
                call SlowUnit(caster,E,0.5,0.5,3,0,false)
            endif
        call GroupRemoveUnit(G, E)
        endloop
			// set n=CreateUnit(GetOwningPlayer(caster), 'd062', GetUnitX(dummy), GetUnitY(dummy), 0)
			// call SetUnitScale(n, 0.2, 0.2, 0.2)
			// call SetUnitFlyHeight(n, 140, 0)
			// call UnitApplyTimedLife(n,'BTLF', 0.3)
			// call MyRemoveUnit(n, 1.7)
			// set n=CreateUnit(GetOwningPlayer(caster), 'd062', GetUnitX(dummy)+20*Cos(angle), GetUnitY(dummy)+20*Sin(angle), 0)
			// call SetUnitScale(n, 0.2, 0.2, 0.2)
			// call SetUnitFlyHeight(n, 140, 0)
			// call UnitApplyTimedLife(n,'BTLF', 0.3)
			// call MyRemoveUnit(n, 1.7)
			// set n=CreateUnit(GetOwningPlayer(caster), 'd062', GetUnitX(dummy)-20*Cos(angle), GetUnitY(dummy)-20*Sin(angle), 0)
			// call SetUnitScale(n, 0.2, 0.2, 0.2)
			// call SetUnitFlyHeight(n, 140, 0)
			// call UnitApplyTimedLife(n,'BTLF', 0.3)
			// call MyRemoveUnit(n, 1.7)

            if eff_period<=0 then
                call KarnaQ_LaserBlast(caster, GetUnitX(dummy), GetUnitY(dummy), false)
                call SaveInteger(h, id, 6, 4)
            else
                call SaveInteger(h, id, 6, eff_period - 1)
            endif
    else
		call SetUnitTimeScale(n, 0.4)
		call KillUnit(LoadUnitHandle(h, id, 105))
        call RemoveUnit(dummy)
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set newTimer = null
    set caster   = null
    set dummy=null
endfunction

function KarnaQ1_LPeriodic1 takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    caster = LoadUnitHandle(h, id, 0)
    local real    duration = LoadReal(h, id, 3)-0.1
    local real    angle    = LoadReal(h, id, 2)

    if duration>0 then
        call SaveReal(h, id, 3, duration)
    else
        set n=CreateUnit(GetOwningPlayer(caster), 'dM04', GetUnitX(caster)+50*Cos(angle), GetUnitY(caster)+50*Sin(angle), angle * bj_RADTODEG)
        call SetUnitFlyHeight(n, 150, 0)
        call SetUnitScale(n, 0.6, 0.6, 0.6)
        call SetUnitTimeScale(n, 0.7)
        call SetUnitVertexColor(n, 255, 255, 255, 170)
        call MyRemoveUnit(n , 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'd106', GetUnitX(caster)+50*Cos(angle), GetUnitY(caster)+50*Sin(angle), angle * bj_RADTODEG)
        call SetUnitFlyHeight(n, 150, 0)
        call SetUnitScale(n, 0.5, 0.5, 0.5)
		call UnitEnableAutoOrientation(n, false)
		call SaveUnitHandle(h, id, 105, n)
        call MyRemoveUnit(n , 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'dH38', GetUnitX(caster)+50*Cos(angle), GetUnitY(caster)+50*Sin(angle), angle * bj_RADTODEG)
        call SetUnitFlyHeight(n, 150, 0)
        call SetUnitVertexColor(n, 255, 255, 255, 170)
        call MyRemoveUnit(n , 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'dAlb', GetUnitX(caster)+50*Cos(angle), GetUnitY(caster)+50*Sin(angle), 0)
        call SetUnitScale(n, 0.2, 0.2, 0.2)
        call SetUnitFlyHeight(n, 50, 0)
        call SaveUnitHandle(h, id, 5, n)
        call SetUnitFacing(caster, LoadReal(h, id, 2)*bj_RADTODEG)
        call SetUnitTimeScale(caster, 1.0)
        call PauseUnit(caster, false)
        call PauseTimer(newTimer)
        call TimerStart(newTimer, 0.005, true, function KarnaQ1_LPeriodic2)
    endif
    set newTimer = null
    set caster   = null
endfunction

function KarnaQ1_Laser takes unit newCaster, real point_x, real point_y returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local real caster_x  = GetUnitX(newCaster)
    local real caster_y  = GetUnitY(newCaster)
    local real angle     = AP(caster_x, caster_y, point_x, point_y)
    local integer index  = 0
    set soundplay=SndN(4173) // Sound\Music\mp3Music\KarnaQ_Laser.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять

    call PauseUnit(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, 14)
    call SetUnitTimeScale(newCaster, 3.2)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(h, id, 2, angle)
    call SaveReal(h, id, 3, 0.5)  // время ожидания первого акта
    call SaveReal(h, id, 4, 2500) // дальность спелла
    //call SaveReal(HH, GetHandleId(newCaster), KarnaQ_Damage, 0.0)
    call TimerStart(newTimer, 0.1, true, function KarnaQ1_LPeriodic1)
    set newTimer = null
endfunction
function KarnaW1_Periodic takes nothing returns nothing 
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    caster = LoadUnitHandle(h, id, 0)
    local integer c_id   = GetHandleId(caster)
    local real    duration = LoadReal(h, id, 1)+0.02
    local real    angle    = 0.0
    local group   g_swords = LoadGroupHandle(HH, c_id, KarnaW_Swords)
    local integer index    = 0
    if duration<10.0 and FirstOfGroup(g_swords)!=null then
        if IsUnitPaused(caster)==false then
            call SaveReal(h, id, 1, duration)
        endif
        set bjLCG = CopyGroup(g_swords)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            set angle = LoadReal(HH, GetHandleId(E), 0)
            call SetUnitX(E, GetUnitX(caster)+200*Cos(angle+Deg2Rad(2)))
            call SetUnitY(E, GetUnitY(caster)+200*Sin(angle+Deg2Rad(2)))
            call SetUnitFacing(E, AU(caster, E)*bj_RADTODEG)
            call SaveReal(HH, GetHandleId(E), 0, AU(caster, E))
            call GroupRemoveUnit(bjLCG, E)
        endloop
        call DestroyGroup(bjLCG)
    else
        loop
        set E=FirstOfGroup(g_swords)
        exitwhen E==null
            call RemoveSavedReal(HH, GetHandleId(E), 0)
            call RemoveUnit(E)
            call GroupRemoveUnit(g_swords, E)
        endloop
        call UnitRemoveAbility(caster, 'A0QW')
        call UnitRemoveAbility(caster, 'KaA7')
        call ShowAbility2('KaA6', true)
        if duration>0 then
            call StartAbilityCooldown(GetUnitAbility(caster, 'KaA6'), GetAbilityCooldown(GetUnitAbility(caster, 'KaA6')))
        endif
        call SetUnitAcquireRange(caster, 600)
        call SetUnitAttackRangeByIndex(caster, 0, 200+B2I(UnitHasBow(caster))*(200*0.3+50))
        call SetUnitWeaponTypeByIndex(caster, 0, ConvertWeaponType(1))
        call TriggerClearActions(LoadTriggerHandle(h, id, 9))
        call TriggerClearActions(LoadTriggerHandle(h, id, 10))
        call DestroyTrigger(LoadTriggerHandle(h, id, 9))
        //call DestroyTrigger(LoadTriggerHandle(h, id, 10))
        call DestroyGroup(g_swords)
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set newTimer = null
    set caster   = null
    set g_swords = null
endfunction

function KarnaWProjectileCond takes nothing returns boolean
return GetUnitTypeId(GetTriggerProjectileSource())=='HKar' and GetUnitAbilityLevel((GetTriggerProjectileSource()),'A0QW')>0
endfunction
function KarnaWProjectileAct takes nothing returns nothing
call KillProjectile(GetTriggerProjectile())
endfunction

function KarnaWAttackActCond takes nothing returns boolean
return GetUnitTypeId(GetAttacker())=='HKar'
endfunction


function KarnaWAttack_Periodic takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    d_sword  = LoadUnitHandle(h, id, 3)
    local real    angle    = AU(d_sword, LoadUnitHandle(h, id, 2)) //LoadReal(h, id, 6)
    local real    distance = LoadReal(h, id, 5)
    local real    dummy_x  = GetUnitX(d_sword)
    local real    dummy_y  = GetUnitY(d_sword)
    if distance>0 and LoadUnitHandle(h, id, 2)!=null and GetWidgetLife(LoadUnitHandle(h, id, 2))>=1 then
        call SetUnitX(d_sword, dummy_x+60*Cos(angle))
        call SetUnitY(d_sword, dummy_y+60*Sin(angle))
        call SetUnitFacing(d_sword, angle*bj_RADTODEG)
        // call SetUnitX(LoadUnitHandle(h, id, 7), dummy_x+80*Cos(angle))
        // call SetUnitY(LoadUnitHandle(h, id, 7), dummy_y+80*Sin(angle))

        call SaveReal(h, id, 5, distance-60)
        set bjLCG = CreateGroup()
        call GroupEnumUnitsInRange(bjLCG, dummy_x, dummy_y, 100, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            if Condition_Base(GetOwningPlayer(d_sword), E) then
                call SaveReal(h, id, 5, 0)
                call SaveReal(h, id, 6, angle)
                call GroupClear(bjLCG)
                call SetUnitX(d_sword, dummy_x+40*Cos(angle))
                call SetUnitY(d_sword, dummy_y+40*Sin(angle))
            endif
            call GroupRemoveUnit(bjLCG, E)
        endloop
        call DestroyGroup(bjLCG)
    else
        set angle = LoadReal(h, id, 6)
        set n=CreateUnit(GetOwningPlayer(d_sword), 'd052', dummy_x, dummy_y, angle*bj_RADTODEG+120)
        call SetUnitScale(n, 5, 5, 5)
        call SetUnitFlyHeight(n, 150, 0)
        call MyRemoveUnit(n, 2.5)
        set n=CreateUnit(GetOwningPlayer(d_sword), 'dR13', dummy_x, dummy_y, angle*bj_RADTODEG+120)
        call SetUnitScale(n, 0.5, 0.5, 0.5)
        call SetUnitFlyHeight(n, 0, 0)
        call MyRemoveUnit(n, 3.5)
        set n = CreateUnit(GetOwningPlayer(d_sword), 'd111', dummy_x, dummy_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 0.8, 0.8, 0.8)
        call SetUnitTimeScale(n, 0.8)
        call SetUnitFlyHeight(n, 0, 0)
        call SetUnitVertexColor(n, 255, 0, 0, 255)
        call MyRemoveUnit(n, 1.5)
        if LoadBoolean(h, id, 0)==true then //== Эффекты при активной F
            set n=CreateUnit(GetOwningPlayer(d_sword), 'd032', dummy_x, dummy_y, angle*bj_RADTODEG+120)
            call SetUnitScale(n, 2, 2, 2)
            call SetUnitVertexColor(n, 255, 150, 100, 255)
            call SetUnitFlyHeight(n, 100, 0)
            call MyRemoveUnit(n, 2.5)
        endif
        call GroupEnumUnitsInRange(G, dummy_x, dummy_y, 150, Base)
        loop
        set E=FirstOfGroup(G)
        exitwhen E==null
        if Condition_Base(GetOwningPlayer(d_sword), E) then
            if Karna_ModifAttack(LoadUnitHandle(h, id, 1), E, 0.25+GetUnitAbilityLevel(LoadUnitHandle(h, id, 1), 'KaA6')*0.05, LoadReal(h, id, 4), 0.6, true) then
                if GetUnitAbilityLevel(LoadUnitHandle(h, id, 1),'BoPB')>0 then
                    call Push5(E,35,AU(LoadUnitHandle(h, id, 1),E),70,"")
                endif
                if GetUnitAbilityLevel(LoadUnitHandle(h, id, 1),'BoPD')>0 then
                    call Push5(E,35,AU(E,LoadUnitHandle(h, id, 1)),70,"")
                endif
            endif
            call AGilPush(E,10,angle,40)
		elseif IsUnitAlly(E, GetOwningPlayer(LoadUnitHandle(h, id, 1)))==true and GetWidgetLife(E)<=GetWidgetMaxLife(E)*0.1 then
			if Karna_ModifAttack(LoadUnitHandle(h, id, 1), E, 0.25+GetUnitAbilityLevel(LoadUnitHandle(h, id, 1), 'KaA6')*0.05, LoadReal(h, id, 4), 0.6, false) then
                if GetUnitAbilityLevel(LoadUnitHandle(h, id, 1),'BoPB')>0 then
                    call Push5(E,35,AU(LoadUnitHandle(h, id, 1),E),70,"")
                endif
                if GetUnitAbilityLevel(LoadUnitHandle(h, id, 1),'BoPD')>0 then
                    call Push5(E,35,AU(E,LoadUnitHandle(h, id, 1)),70,"")
                endif
            endif
        endif
        call GroupRemoveUnit(G, E)
        endloop
        //call RemoveUnit(LoadUnitHandle(h, id, 7))
        call RemoveUnit(d_sword)
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set newTimer = null
    set d_sword  = null
endfunction

function KarnaWAttack_WaitTime takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    d_sword = LoadUnitHandle(h, id, 3)
    local real    angle   = AU(d_sword, LoadUnitHandle(h, id, 2))
    set n = CreateUnit(GetOwningPlayer(d_sword), 'dR42', GetUnitX(d_sword), GetUnitY(d_sword), angle*bj_RADTODEG)
    call SetUnitScale(n, 0.75, 0.75, 0.75)
	call SetUnitTimeScale(n, 0.75)
	call MyRemoveUnit(n , 1.5)
    // set n = CreateUnit(GetOwningPlayer(d_sword), 'd099', GetUnitX(d_sword), GetUnitY(d_sword), angle*bj_RADTODEG+180)
    // call SetUnitScale(n, 1.5, 1.5, 1.5)
	// call SetUnitFlyHeight(n, GetUnitFlyHeight(d_sword), 0)
    // call SetUnitTimeScale(n, 2.0)
	// call SaveUnitHandle(h, id, 7, n)
    call SetUnitFacingInstant(d_sword, angle*bj_RADTODEG)
    call SaveReal(h, id, 6, angle)
    call TimerStart(newTimer, 0.01, true, function KarnaWAttack_Periodic)
    set newTimer = null
    set d_sword  = null
endfunction

function KarnaWAttackAct takes nothing returns nothing
    local unit source = GetAttacker()
    local unit target = GetTriggerUnit()
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id   = GetHandleId(source)
    local group   g_swords = LoadGroupHandle(HH, c_id, KarnaW_Swords)
    local unit    d_sword  = FirstOfGroup(g_swords)
    local real    damage   = GetHeroAgi(source, true) * (GetUnitAbilityLevel(source, 'KaA6')*0.2)
    if d_sword!=null then
        call GroupRemoveUnit(g_swords, d_sword)
        set n = CreateUnit(GetOwningPlayer(source), 'd110', GetUnitX(d_sword), GetUnitY(d_sword), AU(d_sword, target)*bj_RADTODEG)
        call SetUnitScale(n, 1.0, 1.0, 1.0)
        call SetUnitFlyHeight(n, GetUnitFlyHeight(d_sword), 0)
        call RemoveUnit(d_sword)
        set d_sword = n
        if GetUnitAbilityLevel(source, 'KaAC')>0 then
            call UnitRemoveAbility(source,'KaAC')
            call UnitRemoveAbility(source,'kaA1')
            set damage = damage + GetHeroAgi(source, true)*2
            call SaveBoolean(h, id, 0, true)
        endif
        call SaveUnitHandle(h, id, 1, source)
        call SaveUnitHandle(h, id, 2, target)
        call SaveUnitHandle(h, id, 3, d_sword)
        call SaveReal(h, id, 4, damage)
        call SaveReal(h, id, 5, 10000)
        call TimerStart(newTimer, 0.0, false, function KarnaWAttack_WaitTime)
    else
        call DestroyTimer(newTimer)
    endif
    set source = null
    set target = null
    set g_swords = null
endfunction

function KarnaW1_Cast takes unit newCaster returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id   = GetHandleId(newCaster)
    local real caster_x  = GetUnitX(newCaster)
    local real caster_y  = GetUnitY(newCaster)
    local real angle     = GetUnitFacing(newCaster)*bj_DEGTORAD
    local group g_swords = CreateGroup()
    local integer index  = 1
    local trigger trigger1 = CreateTrigger()
    local trigger trigger2 = CreateTrigger()

    call CreateModeIndicatorKarnaW(newCaster, "ReplaceableTextures\\CommandButtons\\BTNKarnaW1.blp", 10.0)
    set soundplay=SndN(4175) // Sound\Music\mp3Music\KarnaW1.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять

    loop
	exitwhen index==7
        set n = CreateUnit(GetOwningPlayer(newCaster), 'd114', caster_x+200*Cos(angle+Deg2Rad(index*60)), caster_y+200*Sin(angle+Deg2Rad(index*60)), angle+index*60)
        call SetUnitScale(n, 1.0, 1.0, 1.0)
        //call SetUnitVertexColor(n, 255, 255, 150, 255)
        call SetUnitFacing(n, GetUnitFacing(n)+360)
        call SetUnitFlyHeight(n, 250, 0)
        call GroupAddUnit(g_swords, n)
        call SaveReal(HH, GetHandleId(n), 0, AU(newCaster, n))
        set n = CreateUnit(GetOwningPlayer(newCaster), 'd111', caster_x+200*Cos(angle+Deg2Rad(index*60)), caster_y+200*Sin(angle+Deg2Rad(index*60)), angle+index*60)
        call SetUnitScale(n, 0.8, 0.8, 0.8)
        call SetUnitTimeScale(n, 0.8)
        call SetUnitFlyHeight(n, 0, 0)
        call SetUnitVertexColor(n, 255, 0, 0, 255)
        call MyRemoveUnit(n, 1.5)
    set index = index + 1
	endloop
    
    call UnitAddAbility(newCaster, 'A0QW')
	call UnitMakeAbilityPermanent(newCaster, true, 'A0QW')
    call UnitAddAbility(newCaster, 'KaA7')
	call UnitMakeAbilityPermanent(newCaster, true, 'KaA7')
    call SetUnitAbilityLevel(newCaster, 'KaA7', GetUnitAbilityLevel(newCaster,'KaA6'))
    call ShowAbility2( 'KaA6', false)
    call SaveGroupHandle(HH, c_id, KarnaW_Swords, g_swords)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveTriggerHandle(h, id, 9, trigger1)
    call SaveTriggerHandle(h, id, 10, trigger2)

    //== Триггеры на автоатаку
    call SetUnitAcquireRange(newCaster, 1500+B2I(UnitHasBow(newCaster))*(1500*0.3+50))
    call SetUnitAttackRangeByIndex(newCaster, 0, 1500+B2I(UnitHasBow(newCaster))*(1500*0.3+50))
    call SetUnitWeaponTypeByIndex(newCaster, 0, ConvertWeaponType(5))

    call TriggerAddAction(trigger1,function KarnaWAttackAct)
    call TriggerAddCondition(trigger1,Condition(function KarnaWAttackActCond))
    call TriggerRegisterAnyUnitEventBJ(trigger1, EVENT_PLAYER_UNIT_ATTACKED)
    if KarnaW1==false then
    call TriggerAddAction(trigger2,function KarnaWProjectileAct)
    call TriggerAddCondition(trigger2,Condition(function KarnaWProjectileCond))
    call TriggerRegisterAnyUnitEventBJ(trigger2, EVENT_PLAYER_UNIT_PROJECTILE_LAUNCH)
    set KarnaW1=true
    else
    call DestroyTrigger(trigger2)
    endif
    call TimerStart(newTimer, 0.02, true, function KarnaW1_Periodic)

    set newTimer = null
    set g_swords = null
    set trigger1 = null
    set trigger2 = null
endfunction


function KarnaW2_Periodic takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    caster = LoadUnitHandle(h, id, -1)
    local integer c_id   = GetHandleId(caster)
    local real    duration = LoadReal(h, id, 10)+0.02
    local real    periodic = LoadReal(h, id, 11)+0.02
    local real    point_x  = LoadReal(h, id, 8)
    local real    point_y  = LoadReal(h, id, 9)
    local real    angle    = 0.0
    local integer index    = LoadInteger(h, id, 7)
    local real    damage   = GetHeroAgi(caster, true) * (0.05+0.15*GetUnitAbilityLevel(caster, 'KaA6'))
    local integer i        = 0

    call SaveReal(h, id, 10, duration)
    if index>=0 then
        loop
        set E=LoadUnitHandle(h, id, i)
        exitwhen i>index
            set angle = LoadReal(HH, GetHandleId(E), 0)
            call SetUnitX(E, point_x+LoadReal(h, id, 12)*Cos(angle+Deg2Rad(3)))
            call SetUnitY(E, point_y+LoadReal(h, id, 12)*Sin(angle+Deg2Rad(3)))
            call SetUnitFacing(E, AP(GetUnitX(E), GetUnitY(E), point_x, point_y)*bj_RADTODEG)
            call SaveReal(HH, GetHandleId(E), 0, AP(point_x, point_y, GetUnitX(E), GetUnitY(E)))
            set i = i + 1
        endloop
    endif

    if duration>=0.5 then
        call SaveReal(h, id, 11, periodic)
        if index>=0 then
            if periodic>0.15 then
                call SaveReal(h, id, 11, 0)
                set E = LoadUnitHandle(h, id, index)
                call SetUnitFlyHeight(E, 0, 3000)
                set angle = LoadReal(HH, GetHandleId(E), 0)
                call RemoveSavedReal(HH, GetHandleId(E), 0)
                call MyRemoveUnit(E, 0.5)
                // call SetUnitX(E, point_x)
                // call SetUnitY(E, point_y)
                set n=CreateUnit(GetOwningPlayer(caster), 'd113', point_x, point_y, angle*bj_RADTODEG)
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call SetUnitFlyHeight(n, 0, 0)
                call MyRemoveUnit(n, 2.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'd115', point_x, point_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 2.5, 2.5, 2.5)
                call SetUnitVertexColor(n, 255, 0, 0, 255)
                call SetUnitFlyHeight(n, 0, 0)
                call MyRemoveUnit(n, 2.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'd111', point_x, point_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call SetUnitVertexColor(n, 255, 0, 0, 255)
                call SetUnitFlyHeight(n, 0, 0)
                call MyRemoveUnit(n, 2.5)
                // set n=CreateUnit(GetOwningPlayer(caster), 'd052', point_x, point_y, GetRandomInt(0, 360))
                // call SetUnitScale(n, 8, 8, 8)
                // call SetUnitFlyHeight(n, 150, 0)
                // call MyRemoveUnit(n, 2.5)
                // set n=CreateUnit(GetOwningPlayer(caster), 'dR13', point_x, point_y, GetRandomInt(0, 360))
                // call SetUnitScale(n, 3.5, 3.5, 3.5)
                // call SetUnitFlyHeight(n, 0, 0)
                // call MyRemoveUnit(n, 3.5)
                 if index==0 then
                    call ShakeCamera(0.1, 15)
                    set n=CreateUnit(GetOwningPlayer(caster), 'dH21', point_x, point_y, GetRandomInt(0, 360))
                    call SetUnitScale(n, 1.5, 1.5, 1.5)
                    call KillUnit(n)
                    call MyRemoveUnit(n, 3.5)
                    set n=CreateUnit(GetOwningPlayer(caster), 'dR41', point_x, point_y, GetRandomInt(0, 360))
                    call SetUnitScale(n, 0.8, 0.8, 0.8)
                    call SetUnitFlyHeight(n, 0, 0)
                    call MyRemoveUnit(n, 3.5)
                else
                    call ShakeCamera(0.1, 10)
                endif
                set bjLCG = CreateGroup()
                call GroupEnumUnitsInRange(bjLCG, point_x, point_y, 400, Base)
                loop
                set E=FirstOfGroup(bjLCG)
                exitwhen E==null
                    if Condition_Base(GetOwningPlayer(caster) , E) then
                        if GetUnitAbilityLevel(caster, 'KaAC')>0 then
                            call UnitRemoveAbility(caster,'KaAC')
                            call UnitRemoveAbility(caster,'kaB1')
                            set damage = damage + GetHeroAgi(caster, true)*2
                            set n=CreateUnit(GetOwningPlayer(caster), 'd032', point_x, point_y, GetRandomInt(0, 360))
                            call SetUnitScale(n, 4, 4, 4)
                            call SetUnitVertexColor(n, 255, 150, 100, 255)
                            call SetUnitFlyHeight(n, 100, 0)
                            call MyRemoveUnit(n, 2.5)
                        endif
                        if Karna_ModifAttack(caster, E, 0.5, damage, 0.3, false) then
                            if GetUnitAbilityLevel(caster,'BoPB')>0 then
                                call Push5(E,35,AU(caster,E),70,"")
                            endif
                            if GetUnitAbilityLevel(caster,'BoPD')>0 then
                                call Push5(E,35,AU(E,caster),70,"")
                            endif
                        endif
                        if index==0 then
                            call SetControlToUnit(E, E, 0.5, "stun")
                        else
                            call SetControlToUnit(E, E, 0.1, "stun")
                        endif
                    endif
                call GroupRemoveUnit(bjLCG, E)
                endloop
                call DestroyGroup(bjLCG)
                call SaveInteger(h, id, 7, index-1)
            endif
        else
            call FlushChildHashtable(h, id)
            call DestroyTimer(newTimer)
        endif
    endif

    set newTimer = null
    set caster   = null
endfunction

function KarnaW2_Cast takes unit newCaster, real point_x, real point_y returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id   = GetHandleId(newCaster)
    local real angle     = GetUnitFacing(newCaster)*bj_DEGTORAD
    local group g_swords = LoadGroupHandle(HH, c_id, KarnaW_Swords)
    local integer index  = 0
    local integer i      = 0
    local real    newA   = 0

    set soundplay=SndN(4177) // Sound\Music\mp3Music\KarnaW2.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять

    loop
    set E=FirstOfGroup(g_swords)
    exitwhen E==null
        call RemoveSavedReal(HH, GetHandleId(E), 0)
        call GroupRemoveUnit(g_swords, E)
        call RemoveUnit(E)
        set index = index + 1
    endloop

    set newA  = 360/index
    loop
    exitwhen i>=index
        set E=CreateUnit(GetOwningPlayer(newCaster), 'd112', point_x+(80+(index*20))*Cos(Deg2Rad(i*newA)), point_y+(80+(index*20))*Sin(Deg2Rad(i*newA)), 0)
        call SetUnitFacingInstant(E, AP(GetUnitX(E), GetUnitY(E), point_x, point_y)*bj_RADTODEG)
        call SetUnitFlyHeight(E, 350, 0)
        call SaveUnitHandle(h, id, i, E)
        call SaveReal(HH, GetHandleId(E), 0, AP(point_x, point_y, GetUnitX(E), GetUnitY(E)))
    set i=i+1
    endloop
    // call BJDebugMsg("count spear1: "+I2S(i))
    // call BJDebugMsg("count spear2: "+I2S(index))
    call SaveUnitHandle(h, id, -1, newCaster)
    call SaveInteger(h, id, 7, index-1)
    call SaveReal(h, id, 8, point_x)
    call SaveReal(h, id, 9, point_y)
    call SaveReal(h, id, 10, 0.0)
    call SaveReal(h, id, 12, 80+(index*20))
    call TimerStart(newTimer, 0.02, true, function KarnaW2_Periodic)
    set newTimer = null
    set g_swords = null
endfunction


function CalculateAngleTriangle takes real height, real length returns real
    // local real angle_y  = Deg2Rad(90.0)                                                             // Угол основной стороны, у нас он всегда 90 градусов
    // local real distance = SquareRoot(Pow(height,2) + Pow(length,2) - 2*height*length*Cos(angle_y))  // Длина отрезка от юнита до точки
    // local real angle_b  = (Pow(distance,2)+Pow(height, 2)-Pow(length,2))/(2*height*distance)
    // call BJDebugMsg(R2S(height))
    // call BJDebugMsg(R2S(length))
    // call BJDebugMsg(R2S(distance))
    // call BJDebugMsg(R2S(MathDistanceBetweenPoints(0, height, length, 0)))
    // call BJDebugMsg(R2S(MathAngleBetweenPoints(0, height, length, 0)))
    // call BJDebugMsg(R2S(angle_b))
    // // call BJDebugMsg(R2S(Cos(angle_b)))
    // call BJDebugMsg(R2S(Rad2Deg(angle_b)))
    return MathAngleBetweenPoints(0, height, length, 0)
    //return (-90+Rad2Deg(angle_b))
endfunction


function KarnaE_Periodic2 takes nothing returns nothing
    local timer   newTimer = GetExpiredTimer()
    local integer id       = GetHandleId(newTimer)
    local unit    caster   = LoadUnitHandle(h, id, CasterHash)
    local integer c_id     = GetHandleId(caster)
    local real    distance = LoadReal(h, id, SH_Distance)
    local real    angle    = LoadReal(h, id,  AngleHash )
    local real    time     = LoadReal(h, id, TIME_HASH)
    local real    damage   = GetHeroAgi(caster, true)*(2+GetUnitAbilityLevel(caster, 'KaA8'))
    local trigger newTrigger = null
    if time<=2.0 then
        call SetUnitInvulnerable(caster, true)
        call SetControlToUnit(caster, caster, 0.11, "doomdebug")
        call SaveReal(h, id, TIME_HASH, time+0.05)


        if time<1.0 then 
            call SetUnitFlyHeight(caster, GetUnitFlyHeight(caster)+90*time, 0)
            call SetUnitX(caster, GetUnitX(caster)+10*Cos(angle))
            call SetUnitY(caster, GetUnitY(caster)+10*Sin(angle))
        endif

        if time==1.5 then
            call ShakeCamera(0.1, 15)
            call SaveReal(h, id, SH_Fly, GetUnitFlyHeight(caster)/(0.5/0.05))
            call SaveReal(h, id, SH_Speed, SquareRootUnit(caster, LoadUnitHandle(HH, c_id, KarnaT_Circle))/(0.5/0.05))
            call SaveReal(h, id,  AngleHash , AU(caster, LoadUnitHandle(HH, c_id, KarnaT_Circle)))
            set angle = AU(caster, LoadUnitHandle(HH, c_id, KarnaT_Circle))
            call SetUnitFacing(caster, angle*bj_RADTODEG)
            set n = CreateUnit(GetOwningPlayer(caster), 'dR26', GetUnitX(caster)+150*Cos(angle), GetUnitY(caster)+150*Sin(angle), angle * bj_RADTODEG)
            call SetUnitFlyHeight(n, GetUnitFlyHeight(caster), 0)
            call UnitScale(n, 0.1, 0.6, 0.5)
            call UnitEnableAutoOrientation(n, false)
            call SetUnitOrientation(n, angle * bj_RADTODEG, CalculateAngleTriangle(GetUnitFlyHeight(caster), SquareRootUnit(caster, LoadUnitHandle(HH, c_id, KarnaT_Circle))), 0)
            call MyRemoveUnit(n, 1.5)

            set n = CreateUnit(GetOwningPlayer(caster), 'dR95', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
            call SetUnitFlyHeight(n, GetUnitFlyHeight(caster), 0)
            call SetUnitScale(n, 0.8, 0.8, 0.8)
            call UnitEnableAutoOrientation(n, false)
            call SetUnitOrientation(n, angle * bj_RADTODEG, CalculateAngleTriangle(GetUnitFlyHeight(caster), SquareRootUnit(caster, LoadUnitHandle(HH, c_id, KarnaT_Circle))), 0)
            call MyRemoveUnit(n, 1.5)
            set n = CreateUnit(GetOwningPlayer(caster), 'd125', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
            call SetUnitFlyHeight(n, GetUnitFlyHeight(caster), 0)
            call SetUnitScale(n, 2, 2, 2)
            call UnitEnableAutoOrientation(n, false)
            call SetUnitOrientation(n, angle * bj_RADTODEG, CalculateAngleTriangle(GetUnitFlyHeight(caster), SquareRootUnit(caster, LoadUnitHandle(HH, c_id, KarnaT_Circle)))-90, 0)
            call MyRemoveUnit(n, 1.5)
            set n = CreateUnit(GetOwningPlayer(caster), 'dM04', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
            call SetUnitFlyHeight(n, GetUnitFlyHeight(caster), 0)
            call SetUnitScale(n, 2, 2, 2)
            call UnitEnableAutoOrientation(n, false)
            call SetUnitOrientation(n, angle * bj_RADTODEG, CalculateAngleTriangle(GetUnitFlyHeight(caster), SquareRootUnit(caster, LoadUnitHandle(HH, c_id, KarnaT_Circle)))-90, 0)
            call MyRemoveUnit(n, 1.5)
        endif

        if time>1.5 then
            call SetUnitX(caster, GetUnitX(caster)+LoadReal(h, id, SH_Speed)*Cos(angle))
            call SetUnitY(caster, GetUnitY(caster)+LoadReal(h, id, SH_Speed)*Sin(angle))
            call SetUnitFlyHeight(caster, GetUnitFlyHeight(caster)-LoadReal(h, id, SH_Fly), 0)
            // set n = LoadUnitHandle(h, id, StringHash("EffectUnit"))
            // call SetUnitX(n, GetUnitX(caster))
            // call SetUnitY(n, GetUnitY(caster))
            // call SetUnitFlyHeight(n, GetUnitFlyHeight(caster), 0)

            call RemoveUnit(LoadUnitHandle(HH, c_id, KarnaT_Circle))
            call RemoveSavedHandle(HH, c_id, KarnaT_Circle)
            set newTrigger = LoadTriggerHandle(h, id, 99)
            call TriggerClearActions(newTrigger)
            call DestroyTrigger(newTrigger)
        endif

        set bjLCG = CopyGroup(LoadGroupHandle(h, id,  GroupHash ))
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            call SetUnitFlyHeight(E, GetUnitFlyHeight(caster), 0)
            call SetUnitX(E, GetUnitX(caster)+70*Cos(LoadReal(HH, GetHandleId(E), KarnaE_Index)))
            call SetUnitY(E, GetUnitY(caster)+70*Sin(LoadReal(HH, GetHandleId(E), KarnaE_Index)))
            call PauseUnit(E, true)
            call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,true)
            call SetControlToUnit(E, E, 0.11, "heavystun")
            // call SetControlToUnit(E, E, 0.11, "stun")
        call GroupRemoveUnit(bjLCG, E)
        endloop
        call DestroyGroup(bjLCG)

    else
        set n=CreateUnit(GetOwningPlayer(caster), 'dH21', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call KillUnit(n)
        call MyRemoveUnit(n, 3.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'dR41', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
        call SetUnitScale(n, 1.0, 1.0, 1.0)
        call SetUnitFlyHeight(n, 5, 0)
        call MyRemoveUnit(n, 3.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'dR41', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
        call SetUnitScale(n, 1.2, 1.2, 1.2)
        call SetUnitFlyHeight(n, 0, 0)
        call MyRemoveUnit(n, 3.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'd125', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
        call SetUnitScale(n, 3, 3, 3)
        call SetUnitFlyHeight(n, 0, 0)
        call MyRemoveUnit(n, 3.5)

        call ShakeCamera(0.1, 15)
        call SetUnitFlyHeight(caster, 0, 0)
        set bjLCG = CopyGroup(LoadGroupHandle(h, id,  GroupHash ))
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            call SetUnitFlyHeight(E, 0, 0)
            call PauseUnit(E, false)
            call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,false)
            call RemoveSavedReal(HH, GetHandleId(E), KarnaE_Index)
        call GroupRemoveUnit(bjLCG, E)
        endloop
        call DestroyGroup(bjLCG)

        set bjLCG = CreateGroup()
        call GroupEnumUnitsInRange(bjLCG, GetUnitX(caster), GetUnitY(caster), 500, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            if Condition_Base(GetOwningPlayer(caster), E) then
                
                call myCustomDamage(caster, E, damage, false,false,null,null,null)
                call SetControlToUnit(E, E, 2.0, "stun")
            endif
        call GroupRemoveUnit(bjLCG, E)
        endloop
        call DestroyGroup(bjLCG)

        call DestroyEffect(LoadEffectHandle(h, id, SH_Effect0))
        call UnitRemoveAbility(caster, 'A1FU') //Slow
        call UnitRemoveAbility(caster, 'Pet1')
        call SetUnitAcquireRange(caster, 600)
        call UnitRemoveAbility(caster, 'B00A')
        call DestroyGroup(LoadGroupHandle(h, id,  GroupHash ))
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call SetUnitVertexColor(caster, 255, 255, 255, 255)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
    set newTimer=null
    set newTrigger=null
endfunction

function KarnaE_StopOrders2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    call IssueImmediateOrder(u,"stop")
    call SetUnitFacing(u,Atan2(LoadReal(h,id,1)-GetUnitY(u),LoadReal(h,id,2)-GetUnitX(u))*bj_RADTODEG)
    //call SetUnitAnimationByIndex(u, 17)
    call FlushChildHashtable(h,id)
    call DestroyTimer(t)
    set t=null
    set u=null
endfunction

function KarnaE_StopOrders takes nothing returns nothing
    local unit u=GetOrderedUnit()
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    call SaveUnitHandle(h,id,0,u)
    if GetOrderTargetUnit()==null then
        call SaveReal(h,id,2,GetOrderPointX())
        call SaveReal(h,id,1,GetOrderPointY())
    else
        call SaveReal(h,id,2,GetUnitX(GetOrderTargetUnit()))
        call SaveReal(h,id,1,GetUnitY(GetOrderTargetUnit()))
    endif
    if SquareRootPoint(GetUnitX(u), GetUnitY(u), LoadReal(h,id,2), LoadReal(h,id,1))>1200 then
        call SaveReal(h,id,2,GetUnitX(u)+1200*Cos(AP(GetUnitX(u), GetUnitY(u), LoadReal(h,id,2), LoadReal(h,id,1))))
        call SaveReal(h,id,1,GetUnitY(u)+1200*Sin(AP(GetUnitX(u), GetUnitY(u), LoadReal(h,id,2), LoadReal(h,id,1))))
    endif
    call SetUnitX(LoadUnitHandle(HH, GetHandleId(u), KarnaT_Circle), LoadReal(h, id, 2))
    call SetUnitY(LoadUnitHandle(HH, GetHandleId(u), KarnaT_Circle), LoadReal(h, id, 1))
    call TimerStart(t,0.001,false,function KarnaE_StopOrders2)
    set u=null
    set t=null
endfunction

function KarnaE_Periodic1 takes nothing returns nothing
    local timer   newTimer = GetExpiredTimer()
    local integer id       = GetHandleId(newTimer)
    local real    distance = LoadReal(h, id, SH_Distance)
    local real    angle    = LoadReal(h, id,  AngleHash )
    local unit    caster   = LoadUnitHandle(h, id, CasterHash)
    local trigger newTrigger = null

    if distance < 1200 and LoadBoolean(HH,GetHandleId(caster),DASH_USER)==true then
        call SetUnitX(caster, GetUnitX(caster) + 45 * Cos(angle))
        call SetUnitY(caster, GetUnitY(caster) + 45 * Sin(angle))
        call SetUnitX(LoadUnitHandle(h, id, SH_EffectUnit), GetUnitX(caster)-100*Cos(angle))
        call SetUnitY(LoadUnitHandle(h, id, SH_EffectUnit), GetUnitY(caster)-100*Sin(angle))
        call SaveReal(h, id, SH_Distance, distance + 45)
        if LoadInteger(h, id,  EffectPeriodHash ) == 0 then
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dM11', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
            call SetUnitFlyHeight(bjLCU, 150, 0)
            call SetUnitVertexColor(bjLCU, 255, 255, 255, 140)
            call SetUnitScale(bjLCU, 0.6, 0.6, 0.6)
            call MyRemoveUnit(bjLCU , 1.5)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dM29', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
            call SetUnitVertexColor(bjLCU, 255, 255, 255, 180)
            call MyRemoveUnit(bjLCU , 1.5)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'd117', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG - 180)
            call SetUnitVertexColor(bjLCU, 255, 255, 255, 180)
            call SetUnitScale(bjLCU, 0.7, 0.7, 0.7)
            call SetUnitFlyHeight(bjLCU, 25, 0)
            call MyRemoveUnit(bjLCU , 1.5)
            call SaveInteger(h, id,  EffectPeriodHash , 2)
        else
            call SaveInteger(h, id,  EffectPeriodHash , LoadInteger(h, id,  EffectPeriodHash ) - 1)
        endif
        set bjLCG = CreateGroup() //LoadGroupHandle(h, id,  GroupHash )
        call GroupEnumUnitsInRange(bjLCG, GetUnitX(caster)+100*Cos(angle), GetUnitY(caster)+100*Sin(angle), 150, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            if Condition_Base(GetOwningPlayer(caster), E) and IsUnitInGroup(E, LoadGroupHandle(h, id,  GroupHash ))==false then
                if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
                    if IsUnitInvulnerable(E)==false then
                        call GroupAddUnit(LoadGroupHandle(h, id,  GroupHash ), E)
                        call SaveReal(HH, GetHandleId(E), KarnaE_Index, AU(caster, E))
                    endif
                else
                    call SaveBoolean(HH,GetHandleId(caster),DASH_USER,false)
                    call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,caster)
                    call MyRemoveUnit(LoadUnitHandle(h, id, SH_EffectUnit), 1.5)
                    call DestroyEffect(LoadEffectHandle(h, id, SH_Effect0))
                    call DestroyGroup(LoadGroupHandle(h, id,  GroupHash ))
                    call PauseUnit(caster, false)
                    call SetUnitInvulnerable(caster, false)
                    call SetUnitVertexColor(caster, 255, 255, 255, 255)
                    call FlushChildHashtable(h, id)
                    call DestroyTimer(GetExpiredTimer())
                endif
            endif
        call GroupRemoveUnit(bjLCG, E)
        endloop
        call DestroyGroup(bjLCG)
        set bjLCG = CopyGroup(LoadGroupHandle(h, id,  GroupHash ))
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            call SetUnitX(E, GetUnitX(caster)+70*Cos(LoadReal(HH, GetHandleId(E), KarnaE_Index)))
            call SetUnitY(E, GetUnitY(caster)+70*Sin(LoadReal(HH, GetHandleId(E), KarnaE_Index)))
            call SetControlToUnit(E, E, 0.11, "doomdebug")
        call GroupRemoveUnit(bjLCG, E)
        endloop
        call DestroyGroup(bjLCG)
        //KarnaE_Index
    else
        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dM30', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
        call SetUnitScale(bjLCU, 0.85, 0.85, 0.85)
        call SetUnitVertexColor(bjLCU, 255, 255, 255, 200)
        call MyRemoveUnit(bjLCU , 1.5)
        if FirstOfGroup(LoadGroupHandle(h, id,  GroupHash ))==null then
            if LoadBoolean(h, GetHandleId(caster), KarnaF_Reload) then
                call StartAbilityCooldown(GetUnitAbility(caster, 'KaA8'), GetAbilityRemainingCooldown(GetUnitAbility(caster, 'KaA8'))*0.5)
            endif
            call MyRemoveUnit(LoadUnitHandle(h, id, SH_EffectUnit), 1.5)
            call DestroyEffect(LoadEffectHandle(h, id, SH_Effect0))
            call DestroyGroup(LoadGroupHandle(h, id,  GroupHash ))
            call SaveBoolean(HH,GetHandleId(caster),DASH_USER,false)
            call PauseUnit(caster, false)
            call SetUnitInvulnerable(caster, false)
            call SetUnitVertexColor(caster, 255, 255, 255, 255)
            call FlushChildHashtable(h, id)
            call DestroyTimer(GetExpiredTimer())
        else
            call SaveBoolean(HH,GetHandleId(caster),DASH_USER,false)
            call RemoveUnit(LoadUnitHandle(h, id, SH_EffectUnit))
            set n = CreateUnit(GetOwningPlayer(caster), 'dR26', GetUnitX(caster)+150*Cos(angle), GetUnitY(caster)+150*Sin(angle), angle * bj_RADTODEG)
            call SetUnitFlyHeight(n, 75, 0)
            call UnitScale(n, 0.1, 0.6, 0.5)
            call UnitEnableAutoOrientation(n, false)
            call SetUnitOrientation(n, angle * bj_RADTODEG, -280, 0)
            call MyRemoveUnit(n, 1.5)
            set n = CreateUnit(GetOwningPlayer(caster), 'dR95', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
            call SetUnitFlyHeight(n, 0, 0)
            call SetUnitScale(n, 0.7, 0.7, 0.7)
            call UnitEnableAutoOrientation(n, false)
            call SetUnitOrientation(n, angle * bj_RADTODEG, -280, 0)
            call MyRemoveUnit(n, 1.5)

            set n = CreateUnit(GetOwningPlayer(caster), 'd130', GetUnitX(caster)+800*Cos(angle), GetUnitY(caster)+800*Sin(angle), 0)
            call UnitScale(n, 1.0, 3.0, 0.5)
            call SaveUnitHandle(HH, GetHandleId(caster), KarnaT_Circle, n)
            call PauseUnit(caster, false)
            set bjLCG = CopyGroup(LoadGroupHandle(h, id,  GroupHash ))
            loop
            set E=FirstOfGroup(bjLCG)
            exitwhen E==null
                call UnitAddAbility(E, 'Arav')
                call UnitRemoveAbility(E, 'Arav')
            call GroupRemoveUnit(bjLCG, E)
            endloop
            call DestroyGroup(bjLCG)
            call SaveReal(h, id, TIME_HASH, 0.0)
            call SaveReal(h, id, SH_Fly,  0.0)
            call PauseTimer(GetExpiredTimer())
            call TimerStart(GetExpiredTimer(), 0.02, true, function KarnaE_Periodic2)
            set newTrigger = CreateTrigger()
            call SetUnitAcquireRange(caster, 51)
            call UnitAddAbility(caster, 'A1FU') //Slow
            call UnitAddAbility(caster, 'Pet1')
            call TriggerRegisterUnitEvent(newTrigger, caster, EVENT_UNIT_ISSUED_TARGET_ORDER)
            call TriggerRegisterUnitEvent(newTrigger, caster, EVENT_UNIT_ISSUED_POINT_ORDER)
            call TriggerAddAction(newTrigger,function KarnaE_StopOrders)
            call SaveTriggerHandle(h, id, 99, newTrigger)
        endif
    endif
    set caster=null
    set newTimer=null
    set newTrigger=null
endfunction

function KarnaE_WaitTime takes nothing returns nothing
    local timer   newTimer = GetExpiredTimer()
    local integer id       = GetHandleId(newTimer)
    local real    distance = LoadReal(h, id, SH_Distance)
    local real    angle    = LoadReal(h, id,  AngleHash )
    local unit    caster   = LoadUnitHandle(h, id, CasterHash)
    local real    caster_x = GetUnitX(caster)
    local real    caster_y = GetUnitY(caster)
    local real    waittime = LoadReal(h, id, SH_Wait)-0.05
    if waittime>0.0 then
        call SaveReal(h, id, SH_Wait, waittime)
        call SetUnitInvulnerable(caster, true)
        if LoadInteger(h, id,  EffectPeriodHash ) == 0 then
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'd118', caster_x, caster_y, GetRandomInt(0, 360))
            call SetUnitVertexColor(bjLCU, 255, 255, 255, 180)
            call SetUnitScale(bjLCU, 0.5, 0.5, 0.5)
            call SetUnitTimeScale(bjLCU, 1.5)
            call SetUnitFlyHeight(bjLCU, 10, 0)
            call MyRemoveUnit(bjLCU , 1.5)
            call SaveInteger(h, id,  EffectPeriodHash , 3)
        else
            call SaveInteger(h, id,  EffectPeriodHash , LoadInteger(h, id,  EffectPeriodHash ) - 1)
        endif
    else
        call ShakeCamera(0.1, 10)
        set soundplay=SndN(4179) // Sound\Music\mp3Music\KarnaE2.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять

        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dM04', caster_x, caster_y, angle * bj_RADTODEG)
        call SetUnitFlyHeight(bjLCU, 150, 0)
        call SetUnitScale(bjLCU, 0.8, 0.8, 0.8)
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dM11', caster_x, caster_y, angle * bj_RADTODEG)
        call SetUnitFlyHeight(bjLCU, 150, 0)
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR95', caster_x, caster_y, angle * bj_RADTODEG)
        call SetUnitFlyHeight(bjLCU, 0, 0)
        call SetUnitScale(bjLCU, 0.8, 0.8, 0.8)
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR26', caster_x, caster_y, angle * bj_RADTODEG)
        call SetUnitFlyHeight(bjLCU, 0, 0)
        call SetUnitScale(bjLCU, 0.6, 0.6, 0.6)
        call SaveUnitHandle(h, id, SH_EffectUnit, bjLCU)
        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dM30', caster_x, caster_y, angle * bj_RADTODEG)
        call SetUnitScale(bjLCU, 0.85, 0.85, 0.85)
        call SetUnitVertexColor(bjLCU, 255, 255, 255, 200)
        call MyRemoveUnit(bjLCU , 1.5)
        call SetUnitVertexColor(caster, 255, 255, 255, 110)
        call SaveBoolean(HH,GetHandleId(caster),DASH_USER,true)
        call PauseTimer(newTimer)
        call TimerStart(newTimer, 0.01, true, function KarnaE_Periodic1)
    endif
    set newTimer = null
    set caster   = null
endfunction

function KarnaE_Cast takes unit newCaster, real point_x, real point_y returns nothing
    local timer   newTimer = CreateTimer()
    local integer id    = GetHandleId(newTimer)
    local real caster_x = GetUnitX(newCaster)
    local real caster_y = GetUnitY(newCaster)
    local real angle    = AtanPoint(caster_x , caster_y , point_x , point_y)
	local real distance = 0
    set soundplay=SndN(4182) // Sound\Music\mp3Music\KarnaE1.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять

    set bjLCE = AddSpecialEffectTarget("Karna_Wings.mdl", newCaster, "chest")
    call SaveEffectHandle(h, id, SH_Effect0, bjLCE)
    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, 6)
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call SaveReal(h, id,  AngleHash , angle)
	call SaveReal(h, id, SH_Distance, distance)
    if LoadBoolean(h, GetHandleId(newCaster), KarnaF_Reload)==false then
        call SaveReal(h, id, SH_Wait, 0.8)
    else
        call SaveReal(h, id, SH_Wait, 0.0)
    endif
    call SaveGroupHandle(h, id,  GroupHash , CreateGroup())
    call TimerStart(newTimer, 0.05, true, function KarnaE_WaitTime)
    set newTimer = null
endfunction
function KarnaR_Periodic takes nothing returns nothing
	local timer t=GetExpiredTimer()
	local integer id=GetHandleId(t)
	local unit u=LoadUnitHandle(h,id,0)
	local unit l__d=LoadUnitHandle(h,id,1)
	local player p=GetOwningPlayer(u)
	local integer idu=GetPlayerId(p)
	local real x=LoadReal(h,id,3)
	local real y=LoadReal(h,id,4)
	local real x1=GetUnitX(l__d)
	local real y1=GetUnitY(l__d)
	local real f=GetUnitFacing(l__d)
	local real a=LoadReal(h,id,8)
	local real dmg=GetHeroAgi(u,true)*12
	local real Range=LoadReal(h,id,9)
	local real speed=LoadReal(h,id,11)
	local integer i=0
	if Range<4000 and UnitIsAlive(l__d)then
		set x1=x1+speed*Cos(a)
		set y1=y1+speed*Sin(a)
		// if Range>1000 then
			// set a=a*GetRandomReal(0.95, 1.05)
			// call SaveReal(h, id, 8, a)
		// endif
		call SetUnitXY_1(l__d,x1,y1, false)
		call SetUnitXY_1(LoadUnitHandle(h, id, 20),x1,y1, false)
		call SaveReal(h,id,3,x1)
		call SaveReal(h,id,4,y1)
		call SetUnitFacing(l__d,a*bj_RADTODEG)
		call SaveReal(h,id,9,Range+speed)
		call SaveReal(h,id,11,speed+2)
		call GroupEnumUnitsInRange(DG,x1,y1,150,Base)
		loop
		set E=FirstOfGroup(DG)
		exitwhen E==null
			if Condition_Base(p,E)then
				call RemoveUnit(l__d)
			endif
		call GroupRemoveUnit(DG,E)
		endloop
	else
        set soundplay=SndN(4184) // Sound\Music\mp3Music\KarnaR_Blast.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
		call ShakeCamera(0.2, 15)
		call GroupEnumUnitsInRange(DG,x,y,800,Base)
		loop
		set E=FirstOfGroup(DG)
		exitwhen E==null
			if Condition_Base(p,E)then
                // if GetWidgetLife(E) < GetWidgetMaxLife(E) then
                    set dmg =  GetWidgetLife(E)- (GetWidgetLife(E)/GetWidgetMaxLife(E))*100 
                    set dmg = dmg * (0.075+0.025*GetUnitAbilityLevel(u, 'KaAA'))
                    //call UnitAddAbility(E,'A0WR')
                    //call DamageIndicatorFunction(u, E, dmg)
                    call myCustomDamage(u,E, GetHeroAgi(u, true)*(3+GetUnitAbilityLevel(u, 'KaAA'))+dmg, false,false,null,null,null)
                    //call UnitRemoveAbility(E,'A0WR')
                // else
                //     call myCustomDamage(u,E, GetHeroAgi(u, true)*(3+GetUnitAbilityLevel(u, 'KaAA')), false,false,null,null,null)
                // endif
			endif
		call GroupRemoveUnit(DG,E)
		endloop
        set n=CreateUnit(p,'kaTB',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',3.5)
        set n=CreateUnit(p,'kaTD',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',3.5)
        set n=CreateUnit(p,'kaTC',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',3.5)
        set n=CreateUnit(p,'kaTG',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',3.5)
        call SetUnitTimeScale(n,1)
		// set n = CreateUnit(GetOwningPlayer(u), 'dR28', x,y, GetRandomInt(0, 360))
        // call SetUnitScale(n, 1.5, 1.5, 1.5)
        // call MyRemoveUnit(n, 3.5)
		// set n = CreateUnit(GetOwningPlayer(u), 'dRe9', x,y, GetRandomInt(0, 360))
        // call SetUnitScale(n, 5, 5, 5)
        // call UnitApplyTimedLife(n,'BTLF', 2.0)
        // call MyRemoveUnit(n, 3.5)
		// set n = CreateUnit(GetOwningPlayer(u), 'dRe9', x,y, GetRandomInt(0, 360))
        // call SetUnitScale(n, 10, 10, 10)
        // call UnitApplyTimedLife(n,'BTLF', 2.0)
        // call MyRemoveUnit(n, 3.5)
		// set n = CreateUnit(GetOwningPlayer(u), 'dR12', x,y, GetRandomInt(0, 360))
        // call SetUnitScale(n, 3, 3, 3)
        // call UnitApplyTimedLife(n,'BTLF', 2.0)
        // call MyRemoveUnit(n, 3.5)
		call KillUnit(l__d)
        call MyRemoveUnit(l__d, 1.5)
		call RemoveUnit(LoadUnitHandle(h, id, 20))
		call FlushChildHashtable(h,id)
		call PauseTimer(t)
		call DestroyTimer(t)
	endif
	set u=null
	set p=null
	set t=null
	set l__d=null
endfunction

function KarnaR_WaitTimer takes nothing returns nothing
	local timer t=GetExpiredTimer()
	local integer id=GetHandleId(t)
	local unit u=LoadUnitHandle(h,id,0)
	local player p=GetOwningPlayer(u)
	local real x=GetUnitX(u)
	local real y=GetUnitY(u)
	local real a=LoadReal(h,id,8)
	local integer time=LoadInteger(h, id, 20)
	call SaveInteger(h, id, 20, time+1)
	if time==1 then
		call ShakeCamera(0.1, 5)
		call SaveReal(h, id, 8, a)
		call SetUnitFacing(u, a*bj_RADTODEG)
		//call SetUnitAnimationByIndex(u, 16)
		// set soundplay=CreateSound("Sound\\Music\\mp3Music\\LanzaDelRelampagoThrow.mp3",false,false,true,12700,12700,"")
		// call StartSound(soundplay)
		// call KillSoundWhenDone(soundplay)
	elseif time==2 then
		call ShakeCamera(0.1, 10)
		call SetUnitTimeScale(u, 1.0)
		set n=CreateUnit(GetOwningPlayer(u),'dM04',x,y,a*bj_RADTODEG)
		call MyRemoveUnit(n, 1.5)
		set n=CreateUnit(GetOwningPlayer(u),'dM11',x,y,a*bj_RADTODEG)
		call SetUnitVertexColor(n, 255, 255, 255, 200)
		call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(u),'d116', x+50*Cos(a), y+50*Sin(a), a*bj_RADTODEG)
        call SetUnitFlyHeight(n, 150, 0)
        call UnitApplyTimedLife(n,'BTLF', 0.2)
        call SetUnitTimeScale(n, 1.4)
        call MyRemoveUnit(n, 1.5)
		set n=CreateUnit(GetOwningPlayer(u),'d116',x,y,a*bj_RADTODEG)
        //call SetUnitScale(n, 1.5, 1.5, 1.5)
        call SetUnitFlyHeight(n, 150, 0)
        call SetUnitAnimation(n, "Spell One")
		call SaveUnitHandle(h,id,1,n)
		set n=CreateUnit(GetOwningPlayer(u),'d110',x,y,a*bj_RADTODEG)
        call SetUnitScale(n, 1.2, 1.2, 1.2)
        call SetUnitFlyHeight(n, 150, 0)
        //call SetUnitVertexColor(n, 255, 255, 150, 255)
		call SaveUnitHandle(h,id,20,n)
		call PauseUnit(u, false)
		call SetUnitInvulnerable(u, false)
		call PauseTimer(t)
		call TimerStart(t,0.02,true,function KarnaR_Periodic)
	endif
	set t=null
	set u=null
	set p=null
endfunction

function KarnaR_Cast takes unit u, real x1, real y1 returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real a=Atan2(y1-y,x1-x)
    local player p=GetOwningPlayer(u)
    set soundplay=SndN(4187) // Sound\Music\mp3Music\KarnaR_Start.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set n=CreateUnit(p, 'dM30', x, y, GetRandomInt(0, 360))
    //call SetUnitVertexColor(n, 255, 255, 10, 255)
    call MyRemoveUnit(n, 1.5)
    set n=CreateUnit(p, 'dM30', x, y, GetRandomInt(0, 360))
    //call SetUnitVertexColor(n, 255, 255, 10, 255)
    call SetUnitScale(n, 1.5, 1.5, 1.5)
    call MyRemoveUnit(n, 1.5)
    set n=CreateUnit(p, 'dM32', x, y, GetRandomInt(0, 360))
    call SetUnitVertexColor(n, 255, 255, 255, 100)
    call UnitScale(n, 0.5, 1.7, 0.5)
    call UnitApplyTimedLife(n,'BTLF', 1.0)
    call MyRemoveUnit(n, 1.5)
    call PauseUnit(u, true)
    call SetUnitInvulnerable(u, true)
    call SetUnitAnimationByIndex(u, 15)
    //call SetUnitTimeScale(u, 4.0)
    call SaveUnitHandle(h,id,0,u)
    call SaveReal(h,id,3,x)
    call SaveReal(h,id,4,y)
    call SaveReal(h,id,8,a)
    call SaveReal(h,id,11,50)
    call RemoveEffect(AddSpecialEffectTarget("KarnaWeaponW2.mdl", u, "right hand"), 0.8, true, CreateTimer())
    call TimerStart(t,0.2,true,function KarnaR_WaitTimer)
    set u=null
    set p=null
    set t=null
endfunction

function KarnaT_FReloadEnd takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    caster = LoadUnitHandle(h, id, 0)
    call SaveBoolean(h, GetHandleId(caster), KarnaF_Reload, false)
    call FlushChildHashtable(h, id)
    call DestroyTimer(newTimer)
    set newTimer = null
endfunction

function KarnaT_StartFReload takes unit newCaster, real duration returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id   = GetHandleId(newCaster)
    call CreateModeIndicatorForm(newCaster, "ReplaceableTextures\\CommandButtons\\BTNKarnaT.blp", duration)
    call SaveBoolean(h, c_id, KarnaF_Reload, true)
    call SaveUnitHandle(h, id, 0, newCaster)
    call TimerStart(newTimer, duration, false, function KarnaT_FReloadEnd)
    set newTimer = null
endfunction

function KarnaT_Periodic2 takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id   = GetHandleId(LoadUnitHandle(h, id, 0))
    local unit    caster = LoadUnitHandle(h, id, 0)
    local real    point_x = LoadReal(h, id, 6)
    local real    point_y = LoadReal(h, id, 7)
    local real    angle    = GetUnitFacing(caster)*bj_DEGTORAD
    local real    duration = LoadReal(h, id, 1)-0.5
    local real    damage   = GetHeroAgi(caster, true)*8 / 4

    if duration>=0 then
        call SaveReal(h, id, 1, duration)
        call SetUnitInvulnerable(caster, true)

        // set n = CreateUnit(GetOwningPlayer(caster), 'dR12', point_x, point_y, angle*bj_RADTODEG)
        // call SetUnitScale(n, 5, 5, 5)
        // call UnitApplyTimedLife(n,'BTLF', 5.0)
        // call MyRemoveUnit(n, 9.0)
        // set n = CreateUnit(GetOwningPlayer(caster), 'd105', point_x, point_y, 45)
        // call SetUnitScale(n, 10, 10, 10)
        // call UnitApplyTimedLife(n,'BTLF', 5.0)
        // call MyRemoveUnit(n, 9.0)
        // set n = CreateUnit(GetOwningPlayer(caster), 'd105', point_x, point_y, 90)
        // call SetUnitScale(n, 10, 10, 10)
        // call UnitApplyTimedLife(n,'BTLF', 5.0)
        // call MyRemoveUnit(n, 9.0)

        set n = CreateUnit(GetOwningPlayer(caster), 'd125', point_x, point_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 5, 5, 5)
        call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd125', point_x, point_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 5, 5, 5)
        call SetUnitFlyHeight(n, 500, 0)
        call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd125', point_x, point_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 5, 5, 5)
        call SetUnitFlyHeight(n, 800, 0)
        call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'dR13', point_x, point_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 8, 8, 8)
        call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'dR13', point_x, point_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 8, 8, 8)
        call SetUnitFlyHeight(n, 500, 0)
        call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'dR13', point_x, point_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 8, 8, 8)
        call SetUnitFlyHeight(n, 800, 0)
        call MyRemoveUnit(n, 5.0)

        set bjLCG = CreateGroup()
        call GroupEnumUnitsInRange(bjLCG, point_x, point_y, 800, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            if Condition_Base(GetOwningPlayer(caster), E) then
                call IssueImmediateOrder(E,"stop")
                call myCustomDamage(caster, E, damage, false, false, null, null, null)
                call SetControlToUnit(E,E,0.1,"stun")
                if GetUnitAbilityLevel(E, 'KaAD')==0 then
                    //call Essence(caster, E, 10)
                    call ReduceHeal(caster, E, 0.5, 30)
                    call UnitAddAbility(E, 'KaAD')
                    call UnitMakeAbilityPermanent(E, true, 'KaAD')
                    call UnitRemoveAbilityTimed(E, 'KaAD', 2.5)
                endif
            endif
        call GroupRemoveUnit(bjLCG, E)
        endloop
        call DestroyGroup(bjLCG)
    else
        call KarnaT_StartFReload(caster, 20.0)
        call KarnaD_AddStack(caster)
        call SetUnitOrientation(caster, angle * bj_RADTODEG, 0, 0)
        call UnitEnableAutoOrientation(caster, true)
        

        set n = CreateUnit(GetOwningPlayer(caster), 'dR41', point_x, point_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call SetUnitTimeScale(n, 0.7)
        call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'dM32', point_x, point_y, angle*bj_RADTODEG)
        call UnitScale(n, 10.0, 0.0, 2.5)
        call SetUnitVertexColor(n, 255, 255, 255, 200)
        call UnitApplyTimedLife(n,'BTLF', 2.5)
        call MyRemoveUnit(n, 5.0)

        call SetUnitFlyHeight(caster, 0, 3000)
        call KillUnit(LoadUnitHandle(h, id, 3))
        call MyRemoveUnit(LoadUnitHandle(h, id, 3), 1.5)
        call RemoveUnit(LoadUnitHandle(h, id, 4))
        call KillUnit(LoadUnitHandle(h, id, 5))
        call MyRemoveUnit(LoadUnitHandle(h, id, 5), 1.5)
        call KillUnit(LoadUnitHandle(h, id, 8))
        call MyRemoveUnit(LoadUnitHandle(h, id, 8), 1.5)
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set caster = null
    set newTimer = null
endfunction

function KarnaT_Periodic1 takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id   = GetHandleId(LoadUnitHandle(h, id, 0))
    local unit    caster = LoadUnitHandle(h, id, 0)
    local real    caster_x = GetUnitX(caster)
    local real    caster_y = GetUnitY(caster)
    local real    angle    = GetUnitFacing(caster)*bj_DEGTORAD
    local real    duration = LoadReal(h, id, 1)-0.1
    local trigger newTrigger = LoadTriggerHandle(h, id, 99)
    local real    damage     = GetHeroAgi(caster, true)*2 *0.1

    if duration>=0 then
        call SetUnitInvulnerable(caster, true)
        call PauseUnit(caster, true)
        if GetOwningPlayer(caster)==GetLocalPlayer()then
            call ClearSelection()
            call SetUnitVertexColor(LoadUnitHandle(HH, c_id, KarnaT_Circle),255,255,255,255)
            call SelectUnit(LoadUnitHandle(HH, c_id, KarnaT_Circle),true)
        endif
        call SetUnitBonusMoveSpeedPercent(LoadUnitHandle(HH, c_id, KarnaT_Circle),500)
        if duration==2.0 then
            set n = CreateUnit(GetOwningPlayer(caster), 'd126', caster_x-100*Cos(angle), caster_y-100*Sin(angle), angle*bj_RADTODEG)
            call SetUnitScale(n, 5, 5, 5)
            call SetUnitFlyHeight(n, GetUnitFlyHeight(caster), 0)
            call MyRemoveUnit(n, 5.0)
            set n = CreateUnit(GetOwningPlayer(caster), 'd125', caster_x, caster_y, angle*bj_RADTODEG)
            call SetUnitScale(n, 5, 5, 5)
            call MyRemoveUnit(n, 5.0)
            set n = CreateUnit(GetOwningPlayer(caster), 'dR12', caster_x, caster_y, angle*bj_RADTODEG)
            call SetUnitScale(n, 5, 5, 5)
            call UnitApplyTimedLife(n,'BTLF', 5.0)
            call MyRemoveUnit(n, 9.0)
            set n = CreateUnit(GetOwningPlayer(caster), 'dR13', caster_x, caster_y, angle*bj_RADTODEG)
            call SetUnitScale(n, 8, 8, 8)
            call MyRemoveUnit(n, 5.0)
            set n = CreateUnit(GetOwningPlayer(caster), 'd105', caster_x, caster_y, 45)
            call SetUnitScale(n, 10, 10, 10)
            call UnitApplyTimedLife(n,'BTLF', 5.0)
            call MyRemoveUnit(n, 9.0)
            // set n = CreateUnit(GetOwningPlayer(caster), 'd105', caster_x, caster_y, 90)
            // call SetUnitScale(n, 10, 10, 10)
            // call UnitApplyTimedLife(n,'BTLF', 5.0)
            // call MyRemoveUnit(n, 9.0)
            set n = LoadUnitHandle(HH, c_id, KarnaT_Circle)
            call SetUnitFacing(caster, AU(caster, n)*bj_RADTODEG)
            call SetUnitAnimationByIndex(caster, 31)

        endif   

            set n = LoadUnitHandle(HH, c_id, KarnaT_Circle)
            call SetUnitFacing(caster, AU(caster, n)*bj_RADTODEG)
            set n = LoadUnitHandle(h, id, 8)
            call SetUnitVertexColor(n, 255, 255, 255, 255-R2I(duration*24))

        set n = LoadUnitHandle(h, id, 3)
        call SetUnitX(n, caster_x - 100*Cos(angle))
        call SetUnitY(n, caster_y - 100*Sin(angle))
        call SetUnitFacing(n, angle*bj_RADTODEG)
        //call SetUnitFlyHeight(n, GetUnitFlyHeight(caster)+100, 0)
        set n = LoadUnitHandle(h, id, 4)
        call SetUnitX(n, caster_x - 100*Cos(angle))
        call SetUnitY(n, caster_y - 100*Sin(angle))
        call SetUnitFacing(n, angle*bj_RADTODEG)
        //call SetUnitFlyHeight(n, GetUnitFlyHeight(caster)+100, 0)
        set n = LoadUnitHandle(h, id, 5)
        call SetUnitX(n, caster_x)
        call SetUnitY(n, caster_y)
        call SaveReal(h, id, 1, duration)

        call GroupEnumUnitsInRange(G, caster_x, caster_y, 1000, Base)
        loop
        set E=FirstOfGroup(G)
        exitwhen E==null
            if Condition_Base(GetOwningPlayer(caster), E) then
                call myCustomDamage(caster, E, damage, false, false, null, null, null)
            endif
            call GroupRemoveUnit(G, E)
        endloop
        call SetControlToUnit(caster, caster, 0.11,"doomdebug")
    else
        if GetOwningPlayer(caster)==GetLocalPlayer()then
            call ClearSelection()
            call SelectUnit(caster, true)
        endif
        call ShakeCamera(2.0, 15)
        call IssueImmediateOrder(caster, "stop")
        call PauseUnit(caster, true)
        call SetUnitInvulnerable(caster, true)
        call SetUnitAnimationByIndex(caster, 32)
        call UnitEnableAutoOrientation(caster, false)
        call SetUnitOrientation(caster, angle * bj_RADTODEG, CalculateAngleTriangle(GetUnitFlyHeight(caster), SquareRootUnit(caster, LoadUnitHandle(HH, c_id, KarnaT_Circle))), 0)
      

        set n = CreateUnit(GetOwningPlayer(caster), 'd132', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG)
        call SetUnitVertexColor(n, 255, 100, 0, 255)
        call SetUnitFlyHeight(n, GetUnitFlyHeight(caster)-250, 0)
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call UnitEnableAutoOrientation(n, false)
        call UnitApplyTimedLife(n,'BTLF', 2.0)
        call SetUnitOrientation(n, angle * bj_RADTODEG, CalculateAngleTriangle(GetUnitFlyHeight(caster), SquareRootUnit(caster, LoadUnitHandle(HH, c_id, KarnaT_Circle))), 0)
        call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd132', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG)
        call SetUnitVertexColor(n, 255, 100, 0, 255)
        call SetUnitFlyHeight(n, GetUnitFlyHeight(caster)-250, 0)
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call UnitEnableAutoOrientation(n, false)
        call UnitApplyTimedLife(n,'BTLF', 2.0)
        call SetUnitOrientation(n, angle * bj_RADTODEG, CalculateAngleTriangle(GetUnitFlyHeight(caster), SquareRootUnit(caster, LoadUnitHandle(HH, c_id, KarnaT_Circle))), 0)
        call MyRemoveUnit(n, 5.0)

        set caster_x = GetUnitX(LoadUnitHandle(HH, c_id, KarnaT_Circle))
        set caster_y = GetUnitY(LoadUnitHandle(HH, c_id, KarnaT_Circle))
    
        set bjLCG = CreateGroup()
        call GroupEnumUnitsInRange(bjLCG, caster_x, caster_y, 800, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            if Condition_Base(GetOwningPlayer(caster), E) then
                call IssueImmediateOrder(E,"stop")
                call SetControlToUnit(E,E,1.0,"stun")
                call myCustomDamage(caster, E, GetHeroAgi(caster, true)*6, false, false, null, null, null)
            endif
        call GroupRemoveUnit(bjLCG, E)
        endloop
        call DestroyGroup(bjLCG)


        set n = CreateUnit(GetOwningPlayer(caster), 'dM32', caster_x, caster_y, angle*bj_RADTODEG)
        call UnitScale(n, 0.5, 10.0, 0.5)
        call UnitApplyTimedLife(n,'BTLF', 2.5)
        //call SetUnitVertexColor(n, 255, 255, 255, 200)
        call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'dR41', caster_x, caster_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call SetUnitTimeScale(n, 0.7)
        call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd108', caster_x, caster_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 2, 2, 2)
        call MyRemoveUnit(n, 2.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd128', caster_x, caster_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 2.2, 2.2, 2.2)
        call UnitApplyTimedLife(n,'BTLF', 2.5)
        call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd129', caster_x, caster_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 2, 2, 2)
        call MyRemoveUnit(n, 3.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd127', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 2, 2, 2)
        call SetUnitVertexColor(n, 255, 150, 0, 255)
        call UnitApplyTimedLife(n,'BTLF', 2.5)
        call MyRemoveUnit(n, 4.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd127', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 3.5, 3.5, 3.5)
        call SetUnitVertexColor(n, 255, 150, 0, 255)
        call UnitApplyTimedLife(n,'BTLF', 2.5)
        call MyRemoveUnit(n, 4.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd127', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 5, 5, 5)
        call SetUnitVertexColor(n, 255, 150, 0, 255)
        call UnitApplyTimedLife(n,'BTLF', 2.5)
        call MyRemoveUnit(n, 4.0)

        call SaveReal(h, id, 1, 2.0)
        call SaveReal(h, id, 6, GetUnitX(LoadUnitHandle(HH, c_id, KarnaT_Circle)))
        call SaveReal(h, id, 7, GetUnitY(LoadUnitHandle(HH, c_id, KarnaT_Circle)))

        call RemoveUnit(LoadUnitHandle(HH, c_id, KarnaT_Circle))
        call RemoveSavedHandle(HH, c_id, KarnaT_Circle)
        call TriggerClearActions(newTrigger)
        call DestroyTrigger(newTrigger)
        call UnitRemoveAbility(caster, 'A1FU') //Slow
        call UnitRemoveAbility(caster, 'Pet1')
        call SetUnitAcquireRange(caster, 600)
        call UnitRemoveAbility(caster, 'B00A')

        call PauseTimer(newTimer)
        call TimerStart(newTimer, 0.5, true, function KarnaT_Periodic2)
    endif
    set caster = null
    set newTimer = null
    set newTrigger = null
endfunction

function KarnaT_StopOrders2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    call IssueImmediateOrder(u,"stop")
    //call SetUnitFacing(u,Atan2(LoadReal(h,id,1)-GetUnitY(u),LoadReal(h,id,2)-GetUnitX(u))*bj_RADTODEG)
    call SetUnitAnimationByIndex(u, 17)
    call FlushChildHashtable(h,id)
    call DestroyTimer(t)
    set t=null
    set u=null
endfunction

function KarnaT_StopOrders takes nothing returns nothing
    local unit u=GetOrderedUnit()
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    call SaveUnitHandle(h,id,0,u)
    if GetOrderTargetUnit()==null then
        call SaveReal(h,id,2,GetOrderPointX())
        call SaveReal(h,id,1,GetOrderPointY())
    else
        call SaveReal(h,id,2,GetUnitX(GetOrderTargetUnit()))
        call SaveReal(h,id,1,GetUnitY(GetOrderTargetUnit()))
    endif
    call TimerStart(t,0.001,false,function KarnaT_StopOrders2)
    set u=null
    set t=null
endfunction

function KarnaT_Cast takes unit newCaster, real point_x, real point_y returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id     = GetHandleId(newCaster)
    local real    caster_x = GetUnitX(newCaster)
    local real    caster_y = GetUnitY(newCaster)
    local real    angle    = AP(caster_x, caster_y, point_x, point_y)
    local trigger newTrigger = CreateTrigger()

    set soundplay=SndN(4189) // Sound\Music\mp3Music\KarnaT.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять

    call SetUnitFlyHeight(newCaster, 1000, 800)
    
    call PauseUnit(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, 34)
    set n = CreateUnit(GetOwningPlayer(newCaster), 'dR12', caster_x, caster_y, angle*bj_RADTODEG)
    call SetUnitScale(n, 5, 5, 5)
    call UnitApplyTimedLife(n,'BTLF', 10.0)
    call MyRemoveUnit(n, 13.0)
    set n = CreateUnit(GetOwningPlayer(newCaster), 'd105', caster_x, caster_y, angle*bj_RADTODEG)
    call UnitScale(n, 0.1, 2.0, 6.0)
    call UnitApplyTimedLife(n,'BTLF', 10.0)
    call MyRemoveUnit(n, 13.0)

    set n = CreateUnit(GetOwningPlayer(newCaster), 'd123', caster_x-100*Cos(angle), caster_y-100*Sin(angle), angle*bj_RADTODEG)
    call UnitScale(n, 0.1, 2.0, 6.0)
    call SetUnitFlyHeight(n, 1000, 900)
    call SaveUnitHandle(h, id, 3, n)
    set n = CreateUnit(GetOwningPlayer(newCaster), 'd124', caster_x-100*Cos(angle), caster_y-100*Sin(angle), angle*bj_RADTODEG)
    call UnitScale(n, 0.1, 3.0, 6.0)
    call SetUnitFlyHeight(n, 1000, 900)
    call SaveUnitHandle(h, id, 4, n)
    set n = CreateUnit(GetOwningPlayer(newCaster), 'dR14', caster_x, caster_y, angle*bj_RADTODEG)
    call UnitScale(n, 0.1, 2.0, 6.0)
    call SaveUnitHandle(h, id, 5, n)
    set n = CreateUnit(GetOwningPlayer(newCaster), 'dM32', caster_x, caster_y, angle*bj_RADTODEG)
    call UnitScale(n, 0.1, 10.0, 6.0)
    call SetUnitVertexColor(n, 255, 255, 255, 0)
    call SaveUnitHandle(h, id, 8, n)
    set n = CreateUnit(GetOwningPlayer(newCaster), 'd122', point_x, point_y, 0)
    call SetUnitScale(n, 1.0, 7.1, 2.0)
    call SetUnitMoveSpeed(n, 522)
    call SetUnitPathing(n, false)
    call SetUnitVertexColor(n,255,255,255,0)
    call SetUnitScale(n, 7.1, 7.1, 7.1)
    //call SetUnitVertexColor(n,255,255,255,0)
    call SaveUnitHandle(HH, c_id, KarnaT_Circle, n)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(h, id, 1, 10.0)
    call SaveTriggerHandle(h, id, 99, newTrigger)
    call TimerStart(newTimer, 0.1, true, function KarnaT_Periodic1)

    //call TriggerRegisterPlayerKeyEvent( newTrigger, GetOwningPlayer(newCaster), OSKEY_T, 0 ,true )
    call SetUnitAcquireRange(newCaster, 51)
    call UnitAddAbility(newCaster, 'A1FU') //Slow
    call UnitAddAbility(newCaster, 'Pet1')
    call TriggerRegisterUnitEvent(newTrigger, newCaster, EVENT_UNIT_ISSUED_TARGET_ORDER)
    call TriggerRegisterUnitEvent(newTrigger, newCaster, EVENT_UNIT_ISSUED_POINT_ORDER)
    call TriggerAddAction(newTrigger,function KarnaT_StopOrders)
    
    set newTimer   = null
    set newTrigger = null
endfunction



function KarnaT2_Pillar_Periodic takes nothing returns nothing
	local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id   = GetHandleId(LoadUnitHandle(h, id, 0))
    local unit    caster = LoadUnitHandle(h, id, 0)
    local real    point_x = GetUnitX(caster)
    local real    point_y = GetUnitY(caster)
    local real    angle    = GetUnitFacing(caster)*bj_DEGTORAD
    local real    duration = LoadReal(h, id, 1)-0.5
    local real    damage   = GetHeroAgi(caster, true)*6 / 4

    if duration>=0 then
        call SaveReal(h, id, 1, duration)
        call SetUnitInvulnerable(caster, true)

		call SetUnitXY(LoadUnitHandle(h, id, 4), point_x, point_y)
		call SetUnitFlyHeight(LoadUnitHandle(h, id, 4), GetUnitFlyHeight(caster)+500, 0)
		call SetUnitXY(LoadUnitHandle(h, id, 5), point_x, point_y)
		call SetUnitFlyHeight(LoadUnitHandle(h, id, 5), GetUnitFlyHeight(caster)+500, 0)
        // set n = CreateUnit(GetOwningPlayer(caster), 'dR12', point_x, point_y, angle*bj_RADTODEG)
        // call SetUnitScale(n, 5, 5, 5)
        // call UnitApplyTimedLife(n,'BTLF', 5.0)
        // call MyRemoveUnit(n, 9.0)
        // set n = CreateUnit(GetOwningPlayer(caster), 'd105', point_x, point_y, 45)
        // call SetUnitScale(n, 10, 10, 10)
        // call UnitApplyTimedLife(n,'BTLF', 5.0)
        // call MyRemoveUnit(n, 9.0)
        // set n = CreateUnit(GetOwningPlayer(caster), 'd105', point_x, point_y, 90)
        // call SetUnitScale(n, 10, 10, 10)
        // call UnitApplyTimedLife(n,'BTLF', 5.0)
        // call MyRemoveUnit(n, 9.0)

        set n = CreateUnit(GetOwningPlayer(caster), 'd125', point_x, point_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 5, 5, 5)
        call MyRemoveUnit(n, 5.0)
        // set n = CreateUnit(GetOwningPlayer(caster), 'd125', point_x, point_y, angle*bj_RADTODEG)
        // call SetUnitScale(n, 5, 5, 5)
        // call SetUnitFlyHeight(n, 500, 0)
        // call MyRemoveUnit(n, 5.0)
        // set n = CreateUnit(GetOwningPlayer(caster), 'd125', point_x, point_y, angle*bj_RADTODEG)
        // call SetUnitScale(n, 5, 5, 5)
        // call SetUnitFlyHeight(n, 800, 0)
        // call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'dR13', point_x, point_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 8, 8, 8)
        call MyRemoveUnit(n, 5.0)
        // set n = CreateUnit(GetOwningPlayer(caster), 'dR13', point_x, point_y, angle*bj_RADTODEG)
        // call SetUnitScale(n, 8, 8, 8)
        // call SetUnitFlyHeight(n, 500, 0)
        // call MyRemoveUnit(n, 5.0)
        // set n = CreateUnit(GetOwningPlayer(caster), 'dR13', point_x, point_y, angle*bj_RADTODEG)
        // call SetUnitScale(n, 8, 8, 8)
        // call SetUnitFlyHeight(n, 800, 0)
        // call MyRemoveUnit(n, 5.0)


        set bjLCG = CreateGroup()
        call GroupEnumUnitsInRange(bjLCG, point_x, point_y, 1000, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            if Condition_Base(GetOwningPlayer(caster), E) then
                call IssueImmediateOrder(E,"stop")
                call SetControlToUnit(E,E,0.5,"stun")
                call myCustomDamage(caster, E, damage, false, false, null, null, null)
                if GetUnitAbilityLevel(E, 'KaAD')==0 then
                    //call Essence(caster, E, 10)
                    call ReduceHeal(caster, E, 0.5, 30)
                    call UnitAddAbility(E, 'KaAD')
                    call UnitMakeAbilityPermanent(E, true, 'KaAD')
                    call UnitRemoveAbilityTimed(E, 'KaAD', 2.5)
                endif
            endif
        call GroupRemoveUnit(bjLCG, E)
        endloop
        call DestroyGroup(bjLCG)
    else
		call KillUnit(LoadUnitHandle(h, id, 4))
		call MyRemoveUnit(LoadUnitHandle(h, id, 4), 1.5)
		call RemoveUnit(LoadUnitHandle(h, id, 5))
		
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call KarnaT_StartFReload(caster, 20.0)
        call SetUnitAnimationByIndex(caster, 23)
		
        set n = CreateUnit(GetOwningPlayer(caster), 'dR41', point_x, point_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call SetUnitTimeScale(n, 0.7)
        call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'dM32', point_x, point_y, angle*bj_RADTODEG)
        call UnitScale(n, 10.0, 0.0, 2.5)
        call SetUnitVertexColor(n, 255, 255, 255, 200)
        call UnitApplyTimedLife(n,'BTLF', 2.5)
        call MyRemoveUnit(n, 5.0)

        call SetUnitFlyHeight(caster, 0, 3000)
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set caster = null
    set newTimer = null
endfunction

function KarnaT2_Pillar_WaitTime takes nothing returns nothing
    local timer newTimer   = GetExpiredTimer()
    local integer id       = GetHandleId(newTimer)
    local unit    caster   = LoadUnitHandle(h, id, 0)
	local real    caster_x = GetUnitX(caster)
	local real    caster_y = GetUnitY(caster)
    local real    angle    = GetUnitFacing(caster)*bj_DEGTORAD
    local real    duration = LoadReal(h, id, 1)-0.1
	
	call SetUnitXY(LoadUnitHandle(h, id, 4), caster_x, caster_y)
	call SetUnitFlyHeight(LoadUnitHandle(h, id, 4), GetUnitFlyHeight(caster)+500, 0)
	call SetUnitXY(LoadUnitHandle(h, id, 5), caster_x, caster_y)
	call SetUnitFlyHeight(LoadUnitHandle(h, id, 5), GetUnitFlyHeight(caster)+500, 0)
	
    if duration>0 then
        call SaveReal(h, id, 1, duration)
    else
		set soundplay=SndN(4191) // Sound\Music\mp3Music\KarnaT2_Sound.mp3
		call StartSound(soundplay)
		
		set n = CreateUnit(GetOwningPlayer(caster), 'dM32', caster_x, caster_y, angle*bj_RADTODEG)
        call UnitScale(n, 0.5, 10.0, 0.5)
        call UnitApplyTimedLife(n,'BTLF', 2.5)
        //call SetUnitVertexColor(n, 255, 255, 255, 200)
        call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'dR41', caster_x, caster_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 1.8, 1.8, 1.8)
        call SetUnitTimeScale(n, 0.7)
        call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd108', caster_x, caster_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 2.2, 2.2, 2.2)
        call MyRemoveUnit(n, 2.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd128', caster_x, caster_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 2.5, 2.5, 2.5)
        call UnitApplyTimedLife(n,'BTLF', 2.5)
        call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd129', caster_x, caster_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 2.2, 2.2, 2.2)
        call MyRemoveUnit(n, 3.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd127', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 2.2, 2.2, 2.2)
        call SetUnitVertexColor(n, 255, 150, 0, 255)
        call UnitApplyTimedLife(n,'BTLF', 2.5)
        call MyRemoveUnit(n, 4.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd127', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 3.7, 3.7, 3.7)
        call SetUnitVertexColor(n, 255, 150, 0, 255)
        call UnitApplyTimedLife(n,'BTLF', 2.5)
        call MyRemoveUnit(n, 4.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd127', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 5.2, 5.2, 5.2)
        call SetUnitVertexColor(n, 255, 150, 0, 255)
        call UnitApplyTimedLife(n,'BTLF', 2.5)
        call MyRemoveUnit(n, 4.0)
		call SaveReal(h, id, 1, 2.0)
        call ShakeCamera(2.0, 15)
        call PauseTimer(newTimer)
        call TimerStart(newTimer, 0.5, true, function KarnaT2_Pillar_Periodic)
		
		set bjLCG = CreateGroup()
        call GroupEnumUnitsInRange(bjLCG, caster_x, caster_y, 800, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            if Condition_Base(GetOwningPlayer(caster), E) then
                call IssueImmediateOrder(E,"stop")
                call SetControlToUnit(E,E,1.0,"stun")
                call myCustomDamage(caster, E, GetHeroAgi(caster, true)*6, false, false, null, null, null)
            endif
        call GroupRemoveUnit(bjLCG, E)
        endloop
        call DestroyGroup(bjLCG)
    endif
    set newTimer = null
    set caster   = null
endfunction



function KarnaT2_Pillar takes unit newCaster returns nothing
	local timer newTimer = CreateTimer()
	local integer id = GetHandleId(newTimer)
	local real caster_x = GetUnitX(newCaster)
	local real caster_y = GetUnitY(newCaster)
	
	call UnitRemoveAbility(newCaster, 'KaAG')
	set n = CreateUnit(GetOwningPlayer(newCaster), 'd123', caster_x, caster_y, 0)
	call UnitScale(n, 0.1, 3.5, 1.0)
	call SetUnitFlyHeight(n, 500, 0)
	call SaveUnitHandle(h, id, 4, n)
	call UnitEnableAutoOrientation(n, false)
	call SetUnitOrientation(n, GetUnitFacing(newCaster), -90, 0)
	set n = CreateUnit(GetOwningPlayer(newCaster), 'd124', caster_x, caster_y, 0)
	call UnitScale(n, 0.1, 4.5, 1.0)
	call SetUnitFlyHeight(n, 500, 0)
	call SaveUnitHandle(h, id, 5, n)
	call UnitEnableAutoOrientation(n, false)
	call SetUnitOrientation(n, GetUnitFacing(newCaster), -90, 0)
	
	call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
	
	set soundplay=SndN(4194) // Sound\Music\mp3Music\KarnaT2_Voice.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
	call SetUnitAnimationByIndex(newCaster, 21)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(h, id, 1, 1.2)  // время ожидания первого акта
    call TimerStart(newTimer, 0.1, true, function KarnaT2_Pillar_WaitTime)
endfunction


function KarnaT2_Laser_Periodic takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit d1=LoadUnitHandle(h,id,1)
    local unit d2=LoadUnitHandle(h,id,11)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=LoadReal(h,id,5)
    local real y1=LoadReal(h,id,6)
    local real x3=GetUnitX(LoadUnitHandle(HH, GetHandleId(u), TsunaR_Circle))
    local real y3=GetUnitY(LoadUnitHandle(HH, GetHandleId(u), TsunaR_Circle))
    local real x2=0
    local real y2=0
    local real i=LoadReal(h,id,7)
    local real f=GetUnitFacing(u)*bj_DEGTORAD //Atan2(y3-y,x3-x)
    local boolean b=LoadBoolean(h,id,10)
    local real r=0
    local group g=LoadGroupHandle(h,id,7)
    local integer l__idg=GetHandleId(g)
    local player p=GetOwningPlayer(u)
    local real dmg=GetHeroAgi(u,true)*6 *0.075
    local trigger newTrigger=LoadTriggerHandle(h, id, 100)
    local unit dummy = LoadUnitHandle(HH, GetHandleId(u), TsunaR_Circle)
    local boolean visual_fix = LoadBoolean(h, id, 102)
    local real angle = AU(u, dummy)
    local real caster_facing = GetUnitFacing(u)*bj_DEGTORAD
    local real turn_speed = (36 / 13.3) // первое значение - градусы в секунду 
	local real duration = LoadReal(h, id, 200)
	
    if duration<2.0 and GetWidgetLife(LoadUnitHandle(HH, GetHandleId(u), TsunaR_Circle))>1.0 then
		
        call SetUnitInvulnerable(u, true)
        call PauseUnit(u, true)
        if GetOwningPlayer(u)==GetLocalPlayer()then
            call ClearSelection()
            call SelectUnit(dummy,true)
        endif
        call SetUnitBonusMoveSpeedPercent(dummy,500)
        call SetUnitMaxMana(dummy, GetWidgetMaxMana(u))
        call SetWidgetMana(dummy, GetWidgetMana(u))

		set n = LoadUnitHandle(h, id, 30)
        call SetUnitX(n, x - 100*Cos(caster_facing))
        call SetUnitY(n, y - 100*Sin(caster_facing))
        call SetUnitFacing(n, caster_facing*bj_RADTODEG)
        call SetUnitFlyHeight(n, GetUnitFlyHeight(u)+100, 0)
		call DummyAutoInvisible(n, u)
		
        set n = LoadUnitHandle(h, id, 40)
        call SetUnitX(n, x - 100*Cos(caster_facing))
        call SetUnitY(n, y - 100*Sin(caster_facing))
        call SetUnitFacing(n, caster_facing*bj_RADTODEG)
        call SetUnitFlyHeight(n, GetUnitFlyHeight(u)+100, 0)
		call DummyAutoInvisible(n, u)
		
        if Rad2Deg(angle)<0 then
            set angle = Deg2Rad(Rad2Deg(angle)+360)
        endif

        if (Rad2Deg(angle)-GetUnitFacing(u))>180 then
            if GetUnitFacing(u)<180 then
                set angle = Deg2Rad(Rad2Deg(angle)-360)
            endif
        elseif (GetUnitFacing(u)-Rad2Deg(angle))>180 then
            set angle = Deg2Rad(Rad2Deg(angle)+360)
        endif
        
        if GetUnitFacing(u)<Rad2Deg(angle) then
            if GetUnitFacing(u)+turn_speed>=Rad2Deg(angle) then
                call SetUnitFacing(u, Rad2Deg(angle))
            else
                call SetUnitFacing(u, GetUnitFacing(u)+turn_speed)
            endif
        elseif GetUnitFacing(u)>Rad2Deg(angle) then
            if GetUnitFacing(u)-turn_speed<=Rad2Deg(angle) then
                call SetUnitFacing(u, Rad2Deg(angle))
            else
                call SetUnitFacing(u, GetUnitFacing(u)-turn_speed)
            endif
        endif
        set angle = Deg2Rad(GetUnitFacing(u))
        set f = Deg2Rad(GetUnitFacing(u))
		
        call SetUnitXY_1(u,x1,y1, false)
        if visual_fix==false then
            call SaveBoolean(h, id, 102, true)
        else
            call SaveBoolean(h, id, 102, false)
            if i<7 then
                call SaveReal(h,id,7,i+1)
            else
                if b==false then
					call SetUnitAnimationByIndex(u, 32)
                    set soundplay=SndN(4191) // Sound\Music\mp3Music\KarnaT2_Sound.mp3
                    call StartSound(soundplay)
                    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                    //set d2=CreateUnit(p,'e90K',x+25*Cos(f),y+25*Sin(f),f*bj_RADTODEG)
                    set d1=CreateUnit(p,'d132',x+100*Cos(caster_facing),y+100*Sin(caster_facing),caster_facing*bj_RADTODEG)
                    call SetUnitFlyHeight(d1, 0, 0)
					call SetUnitVertexColor(d1, 255, 100, 0, 255)
                    call UnitScale(d1, 0.1, 1.3, 0.1)
                    call SaveUnitHandle(h,id,1,d1)
                    call UnitAddAbility(d1,'Arav')
                    set d2=CreateUnit(p,'d132',x+100*Cos(caster_facing),y+100*Sin(caster_facing),caster_facing*bj_RADTODEG)
                    call SetUnitFlyHeight(d2, 0, 0)
                    call UnitScale(d2, 0.1, 1.3, 0.15)
                    call SaveUnitHandle(h,id,11,d2)
                    call UnitAddAbility(d2,'Arav')
					call SetUnitVertexColor(d1, 255, 100, 0, 255)
                    //call SetUnitVertexColor(d2,255,50,50,255)
                    call SaveBoolean(h,id,10,true)
					set n = CreateUnit(GetOwningPlayer(u), 'd126', x-100*Cos(caster_facing), y-100*Sin(caster_facing), caster_facing*bj_RADTODEG)
					call SetUnitScale(n, 5, 5, 5)
					call SetUnitFlyHeight(n, GetUnitFlyHeight(u), 0)
					call MyRemoveUnit(n, 5.0)
					set n = CreateUnit(GetOwningPlayer(u), 'd125', x, y, y*bj_RADTODEG)
					call SetUnitScale(n, 5, 5, 5)
					call MyRemoveUnit(n, 5.0)
                endif
            endif
            if b==true then
				call SaveReal(h, id, 200, duration+0.075)
				call SetUnitXY_1(d1,x+100*Cos(caster_facing),y+100*Sin(caster_facing), false)
				call SetUnitFacingInstant(d1,caster_facing*bj_RADTODEG)
                call SetUnitXY_1(d2,x+100*Cos(caster_facing),y+100*Sin(caster_facing), false)
                call SetUnitFacingInstant(d2,caster_facing*bj_RADTODEG)
                loop
                exitwhen r==12
                    set x2=80*Cos(f)+x+r*245*Cos(f)
                    set y2=80*Sin(f)+y+r*245*Sin(f)
                    if r>2 then
                        set n=CreateUnit(p,'e00L',x2,y2,f*bj_RADTODEG)
                        call UnitApplyTimedLife(n,'BHwe',0.25)
                        call SetUnitTimeScale(n,2)
                    endif
                    call SaveReal(h,id,7,i+1)
                    call GroupEnumUnitsInRange(g,x2,y2,325,Base)
                    set r=r+1
                    loop
                        set E=FirstOfGroup(g)
                        set ide=GetHandleId(E)
                        if Condition_Base(p,E) and E!=LoadUnitHandle(h,l__idg,ide)then
                            call SaveUnitHandle(h,l__idg,ide,E)
                            call myCustomDamage(u,E,dmg,false,false,null,null,null)
                            call SetControlToUnit(u,E,0.55,"stun")
							if GetUnitAbilityLevel(E, 'KaAD')==0 then
								//call Essence(caster, E, 10)
								call ReduceHeal(u, E, 0.5, 30)
								call UnitAddAbility(E, 'KaAD')
								call UnitMakeAbilityPermanent(E, true, 'KaAD')
								call UnitRemoveAbilityTimed(E, 'KaAD', 2.5)
							endif
                        endif
                        call GroupRemoveUnit(g,E)
                    exitwhen E==null
                    endloop
                endloop
                call FlushChildHashtable(h,l__idg)
            endif
        endif
    else
		call KarnaT_StartFReload(u, 20.0)
        call SetUnitInvulnerable(u, false)
        call PauseUnit(u, false)
        call IssueImmediateOrder(u, "stop")
        if GetOwningPlayer(u)==GetLocalPlayer()then
            call ClearSelection()
            call SelectUnit(u,true)
        endif
        call RemoveUnit(LoadUnitHandle(HH, GetHandleId(u), TsunaR_Circle))
        call RemoveSavedHandle(HH, GetHandleId(u), TsunaR_Circle)
        call TriggerClearActions(newTrigger)
        call DestroyTrigger(newTrigger)
        call GroupClear(g)
        call DestroyGroup(g)
        //call UnitRemoveAbility(u,'A0GZ')
        call DestroyTimer(t)
        call RemoveUnit(d1)
        call KillUnit(d2)
        call MyRemoveUnit(d2, 1.5)
		call KillUnit(LoadUnitHandle(h, id, 30))
		call MyRemoveUnit(LoadUnitHandle(h, id, 30), 1.5)
		call RemoveUnit(LoadUnitHandle(h, id, 40))
        call FlushChildHashtable(h,id)
    endif
    set d1=null
    set d2=null
    set g=null
    set p=null
    set u=null
    set t=null
    set newTrigger=null
    set dummy=null
endfunction


function KarnaT2_Laser takes unit newCaster, real x1, real y1 returns nothing
    local real x=GetUnitX(newCaster)
    local real y=GetUnitY(newCaster)
    local real f=Atan2(y1-y,x1-x)
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local trigger newTrigger=CreateTrigger()
    local real angle = 0
    //call UnitAddAbility(newCaster,'A0GZ')
	call UnitRemoveAbility(newCaster, 'KaAG')
	call SaveBoolean(h, GetHandleId(newCaster), KarnaF_Reload, false)
	
    call SetUnitFacingInstant(newCaster, f*bj_RADTODEG)
    call SaveUnitHandle(h,id,0,newCaster)

    call SaveReal(h,id,2,x1)
    call SaveReal(h,id,3,y1)
    call SaveReal(h,id,5,x)
    call SaveReal(h,id,6,y)
    call SaveGroupHandle(h,id,7,CreateGroup())
    call SaveBoolean(h,id,4,true)
    call SetUnitAnimationByIndex(newCaster, 31)
    set soundplay=SndN(4194) // Sound\Music\mp3Music\KarnaT2_Voice.mp3
    call StartSound(soundplay)

    call TimerStart(t,0.075,true,function KarnaT2_Laser_Periodic)
        set n = CreateUnit(GetOwningPlayer(newCaster), 'd122', x1, y1, 0)
        call SetUnitMoveSpeed(n, 522)
        call SetUnitPathing(n, false)
        call UnitScale(n, 1.0, 3.0, 0.5)
        call SetUnitMaxMana(n, GetWidgetMaxMana(newCaster))
        call SetWidgetMana(n, GetWidgetMana(newCaster))
        call SaveUnitHandle(HH, GetHandleId(newCaster), TsunaR_Circle, n)

        call SaveTriggerHandle(h, id, 100, newTrigger)
        call TriggerRegisterUnitEvent(newTrigger, n, EVENT_UNIT_ISSUED_TARGET_ORDER)
        call TriggerRegisterUnitEvent(newTrigger, n, EVENT_UNIT_ISSUED_POINT_ORDER)
        call TriggerAddAction(newTrigger,function TsunaR_Order)
		
	set n = CreateUnit(GetOwningPlayer(newCaster), 'dR12', x, y, angle*bj_RADTODEG)
    call SetUnitScale(n, 5, 5, 5)
    call UnitApplyTimedLife(n,'BTLF', 4.0)
    call MyRemoveUnit(n, 13.0)
    set n = CreateUnit(GetOwningPlayer(newCaster), 'd105', x, y, angle*bj_RADTODEG)
    call UnitScale(n, 0.1, 2.0, 2.0)
    call UnitApplyTimedLife(n,'BTLF', 4.0)
    call MyRemoveUnit(n, 13.0)
	
	set n = CreateUnit(GetOwningPlayer(newCaster), 'd123', x-100*Cos(angle), y-100*Sin(angle), angle*bj_RADTODEG)
    call UnitScale(n, 0.1, 2.0, 1.0)
    call SaveUnitHandle(h, id, 30, n)
    set n = CreateUnit(GetOwningPlayer(newCaster), 'd124', x-100*Cos(angle), y-100*Sin(angle), angle*bj_RADTODEG)
    call UnitScale(n, 0.1, 3.0, 1.0)
    call SaveUnitHandle(h, id, 40, n)
	
    set newCaster=null
    set t=null
    set newTrigger=null
endfunction


function KarnaT1_Periodic2 takes nothing returns nothing
	local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id   = GetHandleId(LoadUnitHandle(h, id, 0))
    local unit    caster = LoadUnitHandle(h, id, 0)
    local real    caster_x = GetUnitX(caster)
    local real    caster_y = GetUnitY(caster)
    local real    angle    = GetUnitFacing(caster)*bj_DEGTORAD
    local real    duration = LoadReal(h, id, 1)+0.02
    local real    damage     = GetHeroAgi(caster, true)*2 *0.02

    if duration<=10 and GetWidgetLife(caster)>=1 and GetUnitAbilityLevel(caster, 'KaAG')>0 then
		
        set n = LoadUnitHandle(h, id, 3)
        call SetUnitX(n, caster_x - 100*Cos(angle))
        call SetUnitY(n, caster_y - 100*Sin(angle))
        call SetUnitFacing(n, angle*bj_RADTODEG)
        call SetUnitFlyHeight(n, GetUnitFlyHeight(caster)+100, 0)
		call DummyAutoInvisible(n, caster)
		
        set n = LoadUnitHandle(h, id, 4)
        call SetUnitX(n, caster_x - 100*Cos(angle))
        call SetUnitY(n, caster_y - 100*Sin(angle))
        call SetUnitFacing(n, angle*bj_RADTODEG)
        call SetUnitFlyHeight(n, GetUnitFlyHeight(caster)+100, 0)
		call DummyAutoInvisible(n, caster)

        call SaveReal(h, id, 1, duration)
	elseif GetUnitAbilityLevel(caster, 'KaAG')>0 then
		call KarnaT_StartFReload(caster, 20.0)
		call UnitRemoveAbility(caster, 'KaAG')
		call ShowAbility2('KaAF', true)
		call KillUnit(LoadUnitHandle(h, id, 3))
        call MyRemoveUnit(LoadUnitHandle(h, id, 3), 1.5)
        call RemoveUnit(LoadUnitHandle(h, id, 4))
		call FlushChildHashtable(h, id)
		call DestroyTimer(newTimer)
	else
		call ShowAbility2('KaAF', true)
		call KillUnit(LoadUnitHandle(h, id, 3))
        call MyRemoveUnit(LoadUnitHandle(h, id, 3), 1.5)
        call RemoveUnit(LoadUnitHandle(h, id, 4))
		call FlushChildHashtable(h, id)
		call DestroyTimer(newTimer)
	endif
    set newTimer=null
    set caster=null
endfunction

function KarnaT1_Periodic takes nothing returns nothing
	local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id   = GetHandleId(LoadUnitHandle(h, id, 0))
    local unit    caster = LoadUnitHandle(h, id, 0)
    local real    caster_x = GetUnitX(caster)
    local real    caster_y = GetUnitY(caster)
    local real    angle    = GetUnitFacing(caster)*bj_DEGTORAD
    local real    duration = LoadReal(h, id, 1)-0.02
    local real    damage     = GetHeroAgi(caster, true)*2 *0.2

    if duration>=0 and GetWidgetLife(caster)>=1 then
        call SaveBoolean(h, GetHandleId(caster), KarnaF_Reload, true)
        // if duration==2.0 then
            // set n = CreateUnit(GetOwningPlayer(caster), 'd126', caster_x-100*Cos(angle), caster_y-100*Sin(angle), angle*bj_RADTODEG)
            // call SetUnitScale(n, 5, 5, 5)
            // call SetUnitFlyHeight(n, GetUnitFlyHeight(caster), 0)
            // call MyRemoveUnit(n, 5.0)
            // set n = CreateUnit(GetOwningPlayer(caster), 'd125', caster_x, caster_y, angle*bj_RADTODEG)
            // call SetUnitScale(n, 5, 5, 5)
            // call MyRemoveUnit(n, 5.0)
            // set n = CreateUnit(GetOwningPlayer(caster), 'dR12', caster_x, caster_y, angle*bj_RADTODEG)
            // call SetUnitScale(n, 5, 5, 5)
            // call UnitApplyTimedLife(n,'BTLF', 5.0)
            // call MyRemoveUnit(n, 9.0)
            // set n = CreateUnit(GetOwningPlayer(caster), 'dR13', caster_x, caster_y, angle*bj_RADTODEG)
            // call SetUnitScale(n, 8, 8, 8)
            // call MyRemoveUnit(n, 5.0)
            // set n = CreateUnit(GetOwningPlayer(caster), 'd105', caster_x, caster_y, 45)
            // call SetUnitScale(n, 10, 10, 10)
            // call UnitApplyTimedLife(n,'BTLF', 5.0)
            // call MyRemoveUnit(n, 9.0)
        // endif   

		set n = LoadUnitHandle(h, id, 8)
		call SetUnitVertexColor(n, 255, 255, 255, 255-R2I(duration*48))
		call DummyAutoInvisible(n, caster)
		
        set n = LoadUnitHandle(h, id, 3)
        call SetUnitX(n, caster_x - 100*Cos(angle))
        call SetUnitY(n, caster_y - 100*Sin(angle))
        call SetUnitFacing(n, angle*bj_RADTODEG)
        call SetUnitFlyHeight(n, GetUnitFlyHeight(caster)+100, 0)
		call DummyAutoInvisible(n, caster)
		
        set n = LoadUnitHandle(h, id, 4)
        call SetUnitX(n, caster_x - 100*Cos(angle))
        call SetUnitY(n, caster_y - 100*Sin(angle))
        call SetUnitFacing(n, angle*bj_RADTODEG)
        call SetUnitFlyHeight(n, GetUnitFlyHeight(caster)+100, 0)
		call DummyAutoInvisible(n, caster)
		
        set n = LoadUnitHandle(h, id, 5)
        call SetUnitX(n, caster_x)
        call SetUnitY(n, caster_y)
		call DummyAutoInvisible(n, caster)
        call SaveReal(h, id, 1, duration)

		if LoadInteger(h, id, 100)<=0 then
			call GroupEnumUnitsInRange(G, caster_x, caster_y, 1000, Base)
			loop
			set E=FirstOfGroup(G)
			exitwhen E==null
				if Condition_Base(GetOwningPlayer(caster), E) then
					call myCustomDamage(caster, E, damage, false, false, null, null, null)
				endif
				call GroupRemoveUnit(G, E)
			endloop
			call SaveInteger(h, id, 100, 10)
		else
			call SaveInteger(h, id, 100, LoadInteger(h, id, 100)-1)
		endif
    elseif GetWidgetLife(caster)>=1 then
		set n = CreateUnit(GetOwningPlayer(caster), 'd126', caster_x-100*Cos(angle), caster_y-100*Sin(angle), angle*bj_RADTODEG)
		call SetUnitScale(n, 5, 5, 5)
		call SetUnitFlyHeight(n, GetUnitFlyHeight(caster), 0)
		call MyRemoveUnit(n, 5.0)
		set n = CreateUnit(GetOwningPlayer(caster), 'd125', caster_x, caster_y, angle*bj_RADTODEG)
		call SetUnitScale(n, 5, 5, 5)
		call MyRemoveUnit(n, 5.0)
		set n = CreateUnit(GetOwningPlayer(caster), 'dR12', caster_x, caster_y, angle*bj_RADTODEG)
		call SetUnitScale(n, 5, 5, 5)
		call UnitApplyTimedLife(n,'BTLF', 5.0)
		call MyRemoveUnit(n, 9.0)
		set n = CreateUnit(GetOwningPlayer(caster), 'dR13', caster_x, caster_y, angle*bj_RADTODEG)
		call SetUnitScale(n, 8, 8, 8)
		call MyRemoveUnit(n, 5.0)
		set n = CreateUnit(GetOwningPlayer(caster), 'd105', caster_x, caster_y, 45)
		call SetUnitScale(n, 10, 10, 10)
		call UnitApplyTimedLife(n,'BTLF', 5.0)
		call MyRemoveUnit(n, 9.0)
        call KillUnit(LoadUnitHandle(h, id, 5))
        call MyRemoveUnit(LoadUnitHandle(h, id, 5), 1.5)
        call KillUnit(LoadUnitHandle(h, id, 8))
        call MyRemoveUnit(LoadUnitHandle(h, id, 8), 1.5)
		call PauseTimer(newTimer)
		call TimerStart(newTimer, 0.02, true, function KarnaT1_Periodic2)
		call UnitAddAbility(caster, 'KaAG')
		call SetUnitAbilityLevel(caster, 'KaAG', GetUnitAbilityLevel(caster,'KaAF'))
		call ShowAbility2('KaAF', false)
		call CreateModeIndicatorForm(caster, "ReplaceableTextures\\CommandButtons\\BTNKarnaT2.blp", 10.0)
	else
		call SaveBoolean(h, GetHandleId(caster), KarnaF_Reload, false)
		call KillUnit(LoadUnitHandle(h, id, 5))
        call MyRemoveUnit(LoadUnitHandle(h, id, 5), 1.5)
        call KillUnit(LoadUnitHandle(h, id, 8))
        call MyRemoveUnit(LoadUnitHandle(h, id, 8), 1.5)
		call KillUnit(LoadUnitHandle(h, id, 3))
        call MyRemoveUnit(LoadUnitHandle(h, id, 3), 1.5)
        call RemoveUnit(LoadUnitHandle(h, id, 4))
		call FlushChildHashtable(h, id)
		call DestroyTimer(newTimer)
    endif
    set caster = null
    set newTimer = null
endfunction

function KarnaT1_Cast takes unit newCaster returns nothing
	local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id     = GetHandleId(newCaster)
    local real    caster_x = GetUnitX(newCaster)
    local real    caster_y = GetUnitY(newCaster)
	local real    angle    = GetUnitFacing(newCaster)*bj_DEGTORAD
	
	call KarnaD_AddStack(newCaster)
	call SaveBoolean(h, GetHandleId(newCaster), KarnaF_Reload, true)
	
    set soundplay=SndN(4196) // Sound\Music\mp3Music\KarnaT1.mp3
    call StartSound(soundplay)
	
	call SetUnitAnimationByIndex(newCaster, 34)
    set n = CreateUnit(GetOwningPlayer(newCaster), 'dR12', caster_x, caster_y, angle*bj_RADTODEG)
    call SetUnitScale(n, 5, 5, 5)
    call UnitApplyTimedLife(n,'BTLF', 4.0)
    call MyRemoveUnit(n, 13.0)
    set n = CreateUnit(GetOwningPlayer(newCaster), 'd105', caster_x, caster_y, angle*bj_RADTODEG)
    call UnitScale(n, 0.1, 2.0, 2.0)
    call UnitApplyTimedLife(n,'BTLF', 4.0)
    call MyRemoveUnit(n, 13.0)
	
	set n = CreateUnit(GetOwningPlayer(newCaster), 'd123', caster_x-100*Cos(angle), caster_y-100*Sin(angle), angle*bj_RADTODEG)
    call UnitScale(n, 0.1, 1.0, 6.0)
    call SaveUnitHandle(h, id, 3, n)
    set n = CreateUnit(GetOwningPlayer(newCaster), 'd124', caster_x-100*Cos(angle), caster_y-100*Sin(angle), angle*bj_RADTODEG)
    call UnitScale(n, 0.1, 1.5, 6.0)
    call SaveUnitHandle(h, id, 4, n)
    set n = CreateUnit(GetOwningPlayer(newCaster), 'dR14', caster_x, caster_y, angle*bj_RADTODEG)
    call UnitScale(n, 0.1, 2.0, 6.0)
	call SetUnitVertexColor(n, 255, 255, 255, 150)
    call SaveUnitHandle(h, id, 5, n)
    set n = CreateUnit(GetOwningPlayer(newCaster), 'dM32', caster_x, caster_y, angle*bj_RADTODEG)
    call UnitScale(n, 0.1, 2.0, 6.0)
    call SetUnitVertexColor(n, 255, 255, 255, 0)
    call SaveUnitHandle(h, id, 8, n)
	
	call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(h, id, 1, 7.0)
    call TimerStart(newTimer, 0.02, true, function KarnaT1_Periodic)
endfunction


function Trig_KarnaInt_Actions takes nothing returns nothing
    // 'KaA2' - D Карны, 'KaA3' - Q Каст Карны, 'KaA4' - Q1, 'KaA5' - Q2, 'KaA6' - W1, 'KaA7' - W2, 'KaA8' - E1, 'KaA9' - E2, 'KaAA' - R,  'KaAB' - T 

    if GetSpellAbilityId()=='KaA2' then
        call KarnaD_Active(GetSpellAbilityUnit())
    endif

    if GetSpellAbilityId()=='KaA3' or GetSpellAbilityId()=='KaA3' or GetSpellAbilityId()=='KaA6' or GetSpellAbilityId()=='KaA8' or GetSpellAbilityId()=='KaAA' or GetSpellAbilityId()=='KaA1' then
        call KarnaD_AddStack(GetSpellAbilityUnit())
    endif

    if GetSpellAbilityId()=='KaA3' then
        call KarnaQ_Cast(GetSpellAbilityUnit())
    endif
    
    if GetSpellAbilityId()=='KaA4' then
        call KarnaQ1_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    endif

    if GetSpellAbilityId()=='KaA5' then
        call KarnaQ2_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    endif
    
    if GetSpellAbilityId()=='KaA1' then
        call KarnaQ1_Laser(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    endif

    if GetSpellAbilityId()=='KaA6' then
        call KarnaW1_Cast(GetSpellAbilityUnit())
    endif

    if GetSpellAbilityId()=='KaA7' then
        call KarnaW2_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    endif
    
    if GetSpellAbilityId()=='KaA8' then
        call KarnaE_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    endif

    if GetSpellAbilityId()=='KaAA' then
        call KarnaR_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    endif

    if GetSpellAbilityId()=='KaAB' then
        call KarnaT_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    endif
	
    if GetSpellAbilityId()=='KaAF' then
        call KarnaT1_Cast(GetSpellAbilityUnit())
    endif
	
    if GetSpellAbilityId()=='KaAG' then
		if GetSpellTargetUnit()==null then
			call KarnaT2_Laser(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
		elseif GetSpellTargetUnit()==GetSpellAbilityUnit() then
			call KarnaT2_Pillar(GetSpellAbilityUnit())
		else
			call KarnaT2_Laser(GetSpellAbilityUnit(), GetUnitX(GetSpellTargetUnit()), GetUnitY(GetSpellTargetUnit()))
		endif
    endif
endfunction

//===========================================================================
function InitTrig_KarnaInt takes nothing returns nothing
    local trigger trig  = CreateTrigger(  )
    local integer index = 0
    loop
        call TriggerRegisterPlayerUnitEvent(trig, Player(index), EVENT_PLAYER_UNIT_SPELL_EFFECT, null)
        set index = index + 1
        exitwhen index == bj_MAX_PLAYER_SLOTS
    endloop
    call TriggerAddAction( trig, function Trig_KarnaInt_Actions )
    set trig=null
endfunction
//===========================================================================
//===========
function ShiendoCond takes nothing returns boolean
return GetSpellAbilityId()=='A17M' and udg_B
endfunction
function ShiendoCast2 takes nothing returns nothing // SinonE
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=LoadReal(h,id,2)
    local real y1=LoadReal(h,id,3)
    local real x2=LoadReal(h,id,12)
    local real y2=LoadReal(h,id,13)
    local real x3=0
    local real y3=0
    local real sr2=SR1(x2,y2,x,y)
    local real a2=Atan2(y2-y,x2-x)
    local integer l__s=LoadInteger(h,id,7)
    local real f=GetUnitFacing(u)
    local player p=GetOwningPlayer(u)
    local real dmg = GetHeroAgi(u,true)*GetUnitAbilityLevel(u,'A17M')
    local real dist=SR1(x,y,x1,y1)
    local real dist4=SR1(x,y,x2,y2)
    local real dist3=SR1(x,y,x2,y2)
    local real a=Atan2(y1-y,x1-x)
    local real he=0
    local real se=0
    local integer is=R2I(sr2/20)
    local integer is2=R2I(sr2/20)+1
    local real he2=GetUnitFlyHeight(u)
    local real dist2=LoadReal(h,id,100)
    if dist2>50.00 and udg_B==true and DU2==true then
        if l__s==0 then
            call SaveReal(h,id,100,dist2-(40-he2/19))
            call SetUnitX(u,x+(40-he2/19)*Cos(a))
            call SetUnitY(u,y+(40-he2/19)*Sin(a))
            set he=ParabolaZ(650,LoadReal(h,id,4),dist2)
        else
            call SaveReal(h,id,100,dist2-40)
            call SetUnitXY_1(u,x+40*Cos(a),y+40*Sin(a), true)
            set he=ParabolaZ(650,LoadReal(h,id,4),dist2)
        endif
        call SetUnitFlyHeight(u,he,0)
        if he>550 and l__s==0 then
            call SaveInteger(h,id,7,1)
            call SetUnitTimeScale(u,1.45)
            loop
            exitwhen is<0
                set x3=x+(sr2/20)*is*Cos(a2)
                set y3=y+(sr2/20)*is*Sin(a2)
                set n=CreateUnit(p,'e06L',x3,y3,a2*bj_RADTODEG)
                set dist3=SR1(x3,y3,x2,y2)
                call UnitApplyTimedLife(n,'BTLF',1)
                call SetUnitScale(n,0.3,0.3,0.3)
                call SetUnitTimeScale(n,1)
                call SetUnitFlyHeight(n,he*dist3/dist4,0)
                set is=is-1
            endloop
            call GroupEnumUnitsInRange(DG,x2,y2,400,Base)
            loop
                set E=FirstOfGroup(DG)
                exitwhen E==null
                if Condition_Base(p,E)then
                    if Sinon_ModifAttack(u, E, 1.0, dmg, 1.0, false) then
                        if GetUnitAbilityLevel(u,'BoPB')>0 then
                            call Push5(E,35,AU(u,E),70,"")
                        endif
                        if GetUnitAbilityLevel(u,'BoPD')>0 then
                            call Push5(E,35,AU(E,u),70,"")
                        endif
                    endif
                    call SetControlToUnit(E, E, 2, "stun")
                endif
                call GroupRemoveUnit(DG,E)
            endloop
            call UnitApplyTimedLife(CreateUnit(p,'e0NJ',x2,y2,GetRandomReal(0,359)),'BTLF',3)
            call UnitApplyTimedLife(CreateUnit(p,'e0NK',x2,y2,GetRandomReal(0,359)),'BTLF',6)
            call UnitApplyTimedLife(CreateUnit(p,'e0NI',x2,y2,GetRandomReal(0,359)),'BTLF',3)
            call UnitApplyTimedLife(CreateUnit(p,'e0NL',x2,y2,GetRandomReal(0,359)),'BTLF',3)
            call UnitApplyTimedLife(CreateUnit(p,'e0NM',x2,y2,GetRandomReal(0,359)),'BTLF',3)
            call UnitApplyTimedLife(CreateUnit(p,'e0MI',x2,y2,GetRandomReal(0,359)),'BTLF',1)
        endif
    else
        call PauseUnit(u,false)
        call SetUnitInvulnerable(u,false)
        call SetUnitFlyHeight(u,0,0)
        call SetUnitTimeScale(u,1)
        call FlushChildHashtable(h,id)
        call PauseTimer(t)
        call DestroyTimer(t)
    endif
    set u=null
    set t=null
    set p=null
endfunction
function ShiendoCast takes nothing returns nothing
    local unit u=GetSpellAbilityUnit()
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local real f=GetUnitFacing(u)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=x+1500*Cos((f+180)*bj_DEGTORAD)
    local real y1=y+1500*Sin((f+180)*bj_DEGTORAD)
    call DestroyEffect(AddSpecialEffect("war3mapImported\\TealSlam.mdl",x,y))
    call PauseUnit(u,true)
    call UnitAddAbility(u,'Arav')
    call UnitRemoveAbility(u,'Arav')
    call SaveUnitHandle(h,id,0,u)
    call SetUnitInvulnerable(u,true)
    call SaveReal(h,id,2,x1)
    call SaveReal(h,id,3,y1)
    call SaveReal(h,id,12,x)
    call SaveReal(h,id,13,y)
    call SaveInteger(h,id,7,0)
    call SetUnitTimeScale(u,2.4)
    call SaveReal(h,id,4,SR(x,y,x1,y1))
    call SaveReal(h,id,100,SR(x,y,x1,y1))
    call SetUnitAnimation(u,"Spell slam")
    call TimerStart(t,0.025,true,function ShiendoCast2)
    set soundplay=SndN(4198) // Sound\Music\mp3Music\SinonUlt.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set u=null
    set t=null
endfunction
function SinonW_SSPeriodic takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    bullet = LoadUnitHandle(h, id, 2)
    local real    angle  = LoadReal(h, id, 1)
    local real    distance = LoadReal(h, id, 3)
    local real    damage   = GetUnitAbilityLevel(LoadUnitHandle(h, id, 0), 'SNW1')*2 + 3
    call SaveReal(h, id, 3, distance+55)

    if distance<1500 then
        call SetUnitXY(bullet, GetUnitX(bullet)+55*Cos(angle), GetUnitY(bullet)+55*Sin(angle))

        set bjLCG = LoadGroupHandle(h, id, 4)
        call GroupEnumUnitsInRange(bjLCG, GetUnitX(bullet), GetUnitY(bullet), 115, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            if Condition_Base(GetOwningPlayer(bullet), E) and IsUnitInvulnerable(E)==false  then
                
                if Sinon_ModifAttack(LoadUnitHandle(h, id, 0), E, 0.06, damage, 0.00, false) then
                    if GetUnitAbilityLevel(LoadUnitHandle(h, id, 0),'BoPB')>0 then
                        call Push5(E,35,AU(LoadUnitHandle(h, id, 0),E),70,"")
                    endif
                    if GetUnitAbilityLevel(LoadUnitHandle(h, id, 0),'BoPD')>0 then
                        call Push5(E,35,AU(E,LoadUnitHandle(h, id, 0)),70,"")
                    endif
                endif
                call SetControlToUnit(E, E, 0.06, "stun")
                call Push3(E, 20, angle, 20, "null")
                call GroupClear(bjLCG)
                call SaveReal(h, id, 3, 5050)
                set n = CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, 0)), 'd237', GetUnitX(E), GetUnitY(E), Rad2Deg(angle))
                call SetUnitFlyHeight(n, 85, 0)
                call MyRemoveUnit(n, 1.5)
                call SaveBoolean(h, id, 10, true)
            endif
        call GroupRemoveUnit(bjLCG, E)
        endloop
    else
        if LoadBoolean(h, id, 10)==false then
            set n = CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, 0)), 'd237', GetUnitX(bullet), GetUnitY(bullet), Rad2Deg(angle))
            call SetUnitFlyHeight(n, 85, 0)
            call SetUnitScale(n, 0.75, 0.75, 0.75)
            call MyRemoveUnit(n, 1.5)
        endif
        call KillUnit(bullet)
        call MyRemoveUnit(bullet, 0.5)
        call DestroyGroup(LoadGroupHandle(h, id, 4))
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set newTimer = null
    set bullet = null
endfunction

function SinonW_SingleShot takes unit newCaster, real angle returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local real    caster_x = GetUnitX(newCaster)
    local real    caster_y = GetUnitY(newCaster)
    set angle = angle + Deg2Rad(GetRandomReal(-5, 5))

    set n = CreateUnit(GetOwningPlayer(newCaster), 'd237', caster_x+60*Cos(angle), caster_y+60*Sin(angle), Rad2Deg(angle))
    call SetUnitFlyHeight(n, 85, 0)
    call MyRemoveUnit(n, 1.5)

    set n = CreateUnit(GetOwningPlayer(newCaster), 'd236', caster_x, caster_y, Rad2Deg(angle))
    call SetUnitFlyHeight(n, 85, 0)
    call SetUnitScale(n, 0.75, 0.75, 0.75)
    call SaveUnitHandle(h, id, 2, n)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(h, id, 1, angle)
    call SaveGroupHandle(h, id, 4, CreateGroup())
    call TimerStart(newTimer, 0.02, true, function SinonW_SSPeriodic)
    set newTimer = null
endfunction

function SinonW_Periodic takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    caster = LoadUnitHandle(h, id, 0)
    local unit    dummy  = LoadUnitHandle(HH, GetHandleId(caster), TsunaR_Circle)
    local real    angle  = AU(caster, dummy)
    local real    duration = LoadReal(h, id, 2) - 0.01
    local real    periodic = LoadReal(h, id, 3)
    local real    time     = LoadReal(h, id, 5) - 0.01
    local real    caster_facing = GetUnitFacing(caster)*bj_DEGTORAD
    local real    turn_speed = (180 / 50) // первое значение - градусы в секунду 
    local trigger newTrigger = LoadTriggerHandle(h, id, 100)

    if duration>=0 and GetUnitCurrentOrder(caster)==OrderId("channel") then

        if GetOwningPlayer(caster)==GetLocalPlayer() and ModuloReal(duration,0.07)<0.02 then
            call ClearSelection()
            call SelectUnit(dummy,true)
        endif
        call SetUnitBonusMoveSpeedPercent(dummy,500)
        call SetUnitMaxMana(dummy, GetWidgetMaxMana(caster))
        call SetWidgetMana(dummy, GetWidgetMana(caster))

        if Rad2Deg(angle)<0 then
            set angle = Deg2Rad(Rad2Deg(angle)+360)
        endif

        if (Rad2Deg(angle)-GetUnitFacing(caster))>180 then
            if GetUnitFacing(caster)<180 then
                set angle = Deg2Rad(Rad2Deg(angle)-360)
            endif
        elseif (GetUnitFacing(caster)-Rad2Deg(angle))>180 then
            set angle = Deg2Rad(Rad2Deg(angle)+360)
        endif

        if GetUnitFacing(caster)<Rad2Deg(angle) then
            if GetUnitFacing(caster)+turn_speed>=Rad2Deg(angle) then
                call SetUnitFacingInstant(caster, Rad2Deg(angle))
            else
                call SetUnitFacingInstant(caster, GetUnitFacing(caster)+turn_speed)
            endif
        elseif GetUnitFacing(caster)>Rad2Deg(angle) then
            if GetUnitFacing(caster)-turn_speed<=Rad2Deg(angle) then
                call SetUnitFacingInstant(caster, Rad2Deg(angle))
            else
                call SetUnitFacingInstant(caster, GetUnitFacing(caster)-turn_speed)
            endif
        endif

        set angle = Deg2Rad(GetUnitFacing(caster))

        call SaveReal(h, id, 2, duration)
        if time<=0 then
            call SinonW_SingleShot(caster, angle)
            call SaveReal(h, id, 5, periodic)
            call SaveInteger(h, id, 200, LoadInteger(h, id, 200)+1)
        else
            call SaveReal(h, id, 5, time)
        endif
    else
        // call BJDebugMsg("Overall shots: "+I2S(LoadInteger(h, id, 200)))
        call IssueImmediateOrder(caster, "stop")
        call StopSound(LoadSoundHandle(h, id, 102), false, true) // звук из массива — останавливаем, не удаляем
        set soundplay=SndN(4200) // Sound\Music\mp3Music\SinonWend.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        if GetOwningPlayer(caster)==GetLocalPlayer()then
            call ClearSelection()
            call SelectUnit(caster, true)
        endif
        call RemoveUnit(LoadUnitHandle(HH, GetHandleId(caster), TsunaR_Circle))
        call RemoveSavedHandle(HH, GetHandleId(caster), TsunaR_Circle)
        call TriggerClearActions(newTrigger)
        call DestroyTrigger(newTrigger)
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set newTimer = null
    set newTrigger = null
    set caster = null
    set dummy=null
endfunction

function SinonW_Order takes nothing returns nothing
    local unit u=GetOrderedUnit()
    local unit caster=Hero[GetPlayerId(GetOwningPlayer(u))]
    local real point_x = 0.0
    local real point_y = 0.0
    local real angle   = 0
    if GetOrderTargetUnit()==null then
        set point_x = GetOrderPointX()
        set point_y = GetOrderPointY()
    else
        set point_x = GetUnitX(GetOrderTargetUnit())
        set point_y = GetUnitY(GetOrderTargetUnit())
    endif
	if u!=null then
		call SetUnitX(u, point_x)
		call SetUnitY(u, point_y)
		call IssueImmediateOrder(u, "stop")
	endif
    set u=null
    set caster=null
endfunction

function SinonW_Cast takes unit newCaster, real point_x, real point_y returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local real caster_x  = GetUnitX(newCaster)
    local real caster_y  = GetUnitY(newCaster)
    local real angle     = AtanPoint(caster_x, caster_y, point_x, point_y)
    local real duration  = 0.5 + GetUnitAbilityLevel(newCaster, 'SNW1')*0.5 // AbilityId W Sinon
    local real caster_as = GetUnitAttackSpeed(newCaster)
    local real shot_reload = 0.1
    local trigger newTrigger = CreateTrigger()
    if caster_as>5.0 then
        set caster_as = 5.0
    endif
    set caster_as = (caster_as-1.0)
    set shot_reload = 0.1 - caster_as/80
    // call BJDebugMsg("Current Attack Speed: "+R2S(GetUnitAttackSpeed(newCaster)))
    // call BJDebugMsg("Caster AS: "+R2S(caster_as))
    // call BJDebugMsg("Shot reload BASE: "+R2S(0.1))
    // call BJDebugMsg("Shot reload Current: "+R2S(shot_reload))

    call SetUnitAnimationByIndex(newCaster, 13)
    call SetUnitFacingInstant(newCaster, angle*bj_RADTODEG)
    set soundplay=SndN(4203) // Sound\Music\mp3Music\SinonW.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay)
    call SaveSoundHandle(h, id, 102, soundplay)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(h, id, 1, angle)
    call SaveReal(h, id, 2, duration)
    call SaveReal(h, id, 3, shot_reload)
    call TimerStart(newTimer, 0.01, true, function SinonW_Periodic)

    set n = CreateUnit(GetOwningPlayer(newCaster), 'd141', point_x, point_y, 0)
    call SetUnitMoveSpeed(n, 522)
    call SetUnitPathing(n, false)
    call UnitScale(n, 1.0, 3.0, 0.5)
    call SetUnitMaxMana(n, GetWidgetMaxMana(newCaster))
    call SetWidgetMana(n, GetWidgetMana(newCaster))
    call SaveUnitHandle(HH, GetHandleId(newCaster), TsunaR_Circle, n)
    call SaveTriggerHandle(h, id, 100, newTrigger)
    if GetOwningPlayer(newCaster)==GetLocalPlayer() then
        call ClearSelection()
        call SelectUnit(n,true)
    endif
    call TriggerRegisterUnitEvent(newTrigger, n, EVENT_UNIT_ISSUED_TARGET_ORDER)
    call TriggerRegisterUnitEvent(newTrigger, n, EVENT_UNIT_ISSUED_POINT_ORDER)
    call TriggerAddAction(newTrigger,function SinonW_Order)

    set newTimer = null
    set newTrigger = null
endfunction

function SinonPrefire_Periodic takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit caster    = LoadUnitHandle(h, id, 0)
    local real distance  = LoadReal(h, id, 1)
    local real angle     = LoadReal(h, id, 2)
    local unit dummy     = LoadUnitHandle(h, id, 3)
    local integer color  = LoadInteger(h, id, 4)
    local real point_x   = GetUnitX(dummy) 
    local real point_y   = GetUnitY(dummy)
    if distance>0 then
        set n = CreateUnit(GetOwningPlayer(caster), 'd143', point_x, point_y, Rad2Deg(angle))
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call SetUnitFlyHeight(n, 50, 0)
        call MyRemoveUnit(n, 0.35)
        if color==0 then
            call SetUnitVertexColor(n, 235, 25, 25, 200)
        elseif color==1 then
            call SetUnitVertexColor(n, 128, 0, 255, 200)
        elseif color==2 then
            call SetUnitVertexColor(n, 20, 100, 255, 200)
        endif
        call SaveReal(h, id, 1, distance-130)
        if IsTerrainPathable(point_x, point_y, PATHING_TYPE_FLYABILITY) then
            call SaveReal(h, id, 1, 0)
        endif
        call SetUnitXY(dummy, point_x+130*Cos(angle), point_y+130*Sin(angle))
    else
        call RemoveUnit(dummy)
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif

    set caster = null
    set dummy  = null
    set newTimer=null
endfunction

function Sinon_Prefire takes unit newCaster, real newDistance, real newAngle, integer color returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)

    set n = CreateUnit(GetOwningPlayer(newCaster), 'd143', GetUnitX(newCaster)+100*Cos(newAngle), GetUnitY(newCaster)+100*Sin(newAngle), newAngle*bj_RADTODEG)
    if color==0 then
        call SetUnitVertexColor(n, 235, 25, 25, 200)
    elseif color==1 then
        call SetUnitVertexColor(n, 128, 0, 255, 200)
    elseif color==2 then
        call SetUnitVertexColor(n, 20, 100, 255, 200)
    endif
    call SaveUnitHandle(h, id, 3, n)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(h, id, 1, newDistance-100)
    call SaveReal(h, id, 2, newAngle)
    call SaveInteger(h, id, 4, color)
    call TimerStart(newTimer, 0.001, true, function SinonPrefire_Periodic)
    set newTimer = null
endfunction

function SinonR_Periodic takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    caster = LoadUnitHandle(h, id, 0)
    local unit    bullet = LoadUnitHandle(h, id, 4)
    local boolean last_crit = LoadBoolean(h, id, 3)
    local boolean q_buff    = LoadBoolean(h, id, 1)
    local real    distance  = LoadReal(h, id, 6)
    local real    angle     = LoadReal(h, id, 2)
	local integer effect_period = LoadInteger(h, id,  EffectHash )
	
    if distance<5000 then
        call SaveReal(h, id, 6, distance+50)
        call SetUnitXY(bullet, GetUnitX(bullet)+50*Cos(angle), GetUnitY(bullet)+50*Sin(angle))
		
		call SaveInteger(h, id,  EffectHash , effect_period - 1)
		if effect_period == 0 then
			set n=CreateUnit(GetOwningPlayer(caster), 'dBel', GetUnitX(bullet), GetUnitY(bullet), angle*bj_RADTODEG-120)
			call UnitApplyTimedLife(n,'BTLF', 1.5)
			
			call SaveInteger(h, id,  EffectHash , 1)
		endif
		
        set bjLCG = LoadGroupHandle(h, id, 5)
        call GroupEnumUnitsInRange(bjLCG, GetUnitX(bullet), GetUnitY(bullet), 115, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            if Condition_Base(GetOwningPlayer(caster), E) and IsUnitInvulnerable(E)==false then
                //call SetControlToUnit(E, E, 0.5+B2I_ExD(q_buff), "stun")
                if q_buff then
                    call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\jiejinmao.mdx",caster,"Right Hand"))
                    call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx", E, "origin"))
                endif
                set soundplay=SndN(4205) // Sound\Music\mp3Music\SinonHit.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                set n = CreateUnit(GetOwningPlayer(caster), 'd238', GetUnitX(E), GetUnitY(E), Rad2Deg(angle))
                call SetUnitFlyHeight(n, 85, 0)
                call SetUnitScale(n, 1.1+B2R_ExD(last_crit)*0.5, 1.1+B2R_ExD(last_crit)*0.5, 1.1+B2R_ExD(last_crit)*0.5)
                call MyRemoveUnit(n, 1.5)
                if last_crit then
                    set n = CreateUnit(GetOwningPlayer(caster), 'd140', GetUnitX(E), GetUnitY(E), Rad2Deg(angle))
                    call SetUnitFlyHeight(n, 85, 0)
                    call SetUnitScale(n, 1.1, 1.1, 1.1)
                    call MyRemoveUnit(n, 1.5)
                endif
                if Sinon_ModifAttack(caster, E, 1.0, GetHeroAgi(caster, true)*2, 1.0, last_crit) then
                    if GetUnitAbilityLevel(caster,'BoPB')>0 then
                        call Push5(E,35,AU(caster,E),70,"")
                    endif
                    if GetUnitAbilityLevel(caster,'BoPD')>0 then
                        call Push5(E,35,AU(E,caster),70,"")
                    endif
                endif
                call Push3(E, 20, angle, 150, "null")
                call GroupClear(bjLCG)
                call SaveReal(h, id, 6, 5050)
            endif
        call GroupRemoveUnit(bjLCG, E)
        endloop
    else
        // set soundplay=CreateSound("Sound\\Music\\mp3Music\\SinonAmmo.mp3", false, false, true, 12700, 12700, "")
        // call StartSound(soundplay)
        // call KillSoundWhenDone(soundplay)
        call KillUnit(bullet)
        call MyRemoveUnit(bullet, 0.1)
        call DestroyGroup(LoadGroupHandle(h, id, 5))
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set newTimer = null
    set bullet   = null
    set caster   = null
endfunction

function SinonR_WaitTime takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local integer ammo   = LoadInteger(HH, GetHandleId(LoadUnitHandle(h, id, 0)), Sinon_Ammo)-1
    local unit    caster = LoadUnitHandle(h, id, 0)
    local real    angle  = LoadReal(h, id, 2)
    local real   caster_x = GetUnitX(caster)
    local real   caster_y = GetUnitY(caster)
    local boolean last_crit = false
    if ammo==0 then
        set last_crit = true
    endif
    call PauseUnit(caster, false)
    //call SetUnitInvulnerable(caster, false)
	call ShakeCamera(0.2, 10)
    set soundplay=SndN(4208) // Sound\Music\mp3Music\SinonR.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    
    set n = CreateUnit(GetOwningPlayer(caster), 'd237', caster_x+50*Cos(angle), caster_y+50*Sin(angle), Rad2Deg(angle))
    call SetUnitFlyHeight(n, 85, 0)
    call SetUnitScale(n, 1.5, 1.5, 1.5)
    call MyRemoveUnit(n, 1.5)
    
    set n = CreateUnit(GetOwningPlayer(caster), 'd142', caster_x+80*Cos(angle), caster_y+80*Sin(angle), Rad2Deg(angle))
    call SetUnitFlyHeight(n, 65, 0)
	call SetUnitTimeScale(n, 1.2)
    //call SetUnitScale(n, 1.5, 1.5, 1.5)
    call MyRemoveUnit(n, 1.5)

    set n = CreateUnit(GetOwningPlayer(caster), 'd236', caster_x, caster_y, Rad2Deg(angle))
    call SetUnitFlyHeight(n, 75, 0)
    call SaveUnitHandle(h, id, 4, n)
    call SaveInteger(HH, GetHandleId(caster), Sinon_Ammo, ammo)
    call SaveBoolean(h, id, 3, last_crit)
    call SaveGroupHandle(h, id, 5, CreateGroup())

    call PauseTimer(newTimer)
    call TimerStart(newTimer, 0.005, true, function SinonR_Periodic)
    set newTimer = null
    set caster = null
endfunction

function SinonR_Cast takes unit newCaster, real point_x, real point_y returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local real caster_x  = GetUnitX(newCaster)
    local real caster_y  = GetUnitY(newCaster)
    local real angle     = AtanPoint(caster_x, caster_y, point_x, point_y)
    local integer ammo   = LoadInteger(HH, GetHandleId(newCaster), Sinon_Ammo)-1
    local boolean q_buff = false
    call PauseUnit(newCaster, true)
    //call SetUnitInvulnerable(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, 9)
    
    if GetUnitAbilityLevel(newCaster, 'A17K')>0 then
        set q_buff = true
    endif
    if ammo==0 then
        call Sinon_Prefire(newCaster, 5000, angle, 1)
    else
        call Sinon_Prefire(newCaster, 5000, angle, 0)
    endif
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveBoolean(h, id, 1, q_buff)
    call SaveReal(h, id, 2, angle)
    call TimerStart(newTimer, 0.25, false, function SinonR_WaitTime)
    set newTimer = null
endfunction

function SinonT_Periodic takes nothing returns nothing
	local integer id   = GetHandleId(GetExpiredTimer())
    local unit caster  = LoadUnitHandle(h, id, CasterHash)
	local real point_x = GetUnitX(caster)
	local real point_y = GetUnitY(caster)
	local real angle   = LoadReal(h, id,  AngleHash )
	local real time    = LoadReal(h, id, TIME_HASH)
    local integer ammo         = LoadInteger(HH, GetHandleId(caster), Sinon_Ammo)-2
	local integer EffectPeriod = LoadInteger(h, id, SH_EffectButo)
	local boolean second_act   = LoadBoolean(h, id, SH_SecondAct)
    local boolean last_crit    = LoadBoolean(h, id, 102)
    local boolean q_buff       = LoadBoolean(h, id, 101)

	if time<=1.1 then
		call SaveReal(h, id, TIME_HASH, time+0.005)
		if time<=0.25 then
			call SaveInteger(h, id,  EffectPeriodHash , LoadInteger(h, id,  EffectPeriodHash )-1)
			if LoadInteger(h, id,  EffectPeriodHash )<=0 then
				set n=CreateUnit(GetOwningPlayer(caster), 'dR52', point_x, point_y, GetRandomInt(0,360))
				call SetUnitScale(n, 1.25, 1.25, 1.25)
				call SetUnitVertexColor(n, 255, 255, 255, 150)
				call MyRemoveUnit(n, 1.5)
				call SaveInteger(h, id,  EffectPeriodHash , 32)
			endif
		else
			set soundplay=SndN(4210) // Sound\Music\mp3Music\SinonT.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
			call ShakeCamera(0.2, 20)
			
			//call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(caster),'e0DX', point_x, point_y,GetRandomReal(0,359)),'BTLF',1.5)
			
			set n=CreateUnit(GetOwningPlayer(caster), 'dR42', point_x, point_y, angle*bj_RADTODEG)
			call SetUnitScale(n, 1.25, 1.25, 1.25)
			call SetUnitTimeScale(n, 0.55)
			call MyRemoveUnit(n, 1.5)
			
			set n = CreateUnit(GetOwningPlayer(caster), 'd142', point_x+80*Cos(angle), point_y+80*Sin(angle), Rad2Deg(angle))
			call SetUnitFlyHeight(n, 65, 0)
			call SetUnitTimeScale(n, 1.2)
			call MyRemoveUnit(n, 1.5)
			set n = CreateUnit(GetOwningPlayer(caster), 'd142', point_x+80*Cos(angle), point_y+80*Sin(angle), Rad2Deg(angle))
			call SetUnitFlyHeight(n, 65, 0)
			call SetUnitTimeScale(n, 1.0)
			call SetUnitScale(n, 1.2, 1.2, 1.2)
			call MyRemoveUnit(n, 1.5)
	
			call SaveReal(h, id, TIME_HASH, 12)
			call SaveBoolean(h, id, SH_SecondAct, true)
			set bjLCU = CreateUnit(GetOwningPlayer(caster), 'd236', point_x, point_y, angle*bj_RADTODEG)
			call SetUnitFlyHeight(n, 75, 0)
			call SaveUnitHandle(h, id,  DummyHash , bjLCU)
			call PauseUnit(caster, false)
			//call SetUnitInvulnerable(caster, false)
			call IssueImmediateOrder(caster, "stop")
            call SetUnitAnimationByIndex(caster, 9)
            call SetUnitTimeScale(caster, 1.0)

            call SaveInteger(HH, GetHandleId(caster), Sinon_Ammo, ammo)
            if ammo<=0 then
                call SaveBoolean(h, id, 102, true)
                if ammo<0 then
                    call SaveInteger(HH, GetHandleId(caster), Sinon_Ammo, 0)
                endif
            endif
		endif
	else
		if second_act then
			set bjLCU = LoadUnitHandle(h, id,  DummyHash )
			set point_x = GetUnitX(bjLCU)+65*Cos(angle)
			set point_y = GetUnitY(bjLCU)+65*Sin(angle)
			if IsTerrainPathable(point_x, point_y, PATHING_TYPE_FLYABILITY)==false then
				call SetUnitX(bjLCU, point_x)
				call SetUnitY(bjLCU, point_y)
				call SaveInteger(h, id, SH_EffectButo, EffectPeriod - 1)
				if EffectPeriod == 0 then
					// set n=CreateUnit(GetOwningPlayer(caster), 'dR99', point_x+50*Cos(angle+90*bj_DEGTORAD), point_y+50*Sin(angle+90*bj_DEGTORAD), angle*bj_RADTODEG-120)
					// call UnitApplyTimedLife(n,'BTLF', 1.5)
					// set n=CreateUnit(GetOwningPlayer(caster), 'dR99', point_x+50*Cos(angle-90*bj_DEGTORAD), point_y+50*Sin(angle-90*bj_DEGTORAD), angle*bj_RADTODEG+120)
					// call UnitApplyTimedLife(n,'BTLF', 1.5)
					
					set n=CreateUnit(GetOwningPlayer(caster), 'dBel', point_x, point_y, angle*bj_RADTODEG-120)
					call UnitApplyTimedLife(n,'BTLF', 1.5)
					set n=CreateUnit(GetOwningPlayer(caster), 'd142', point_x, point_y, angle*bj_RADTODEG)
					call SetUnitTimeScale(n, 1.3)
					call SetUnitScale(n, 0.7, 0.7, 0.7)
					call UnitApplyTimedLife(n,'BTLF', 1.5)
					
					set n=CreateUnit(GetOwningPlayer(caster), 'dR42', point_x, point_y, angle*bj_RADTODEG)
					call SetUnitScale(n, 0.25, 0.25, 0.25)
					call SetUnitTimeScale(n, 0.6)
					call UnitApplyTimedLife(n,'BTLF', 1.5)
					call SaveInteger(h, id, SH_EffectButo, 2)
				endif
				// set n=CreateUnit(GetOwningPlayer(bjLCU),'e0DY', point_x, point_y,(angle*bj_RADTODEG))
				// call SetUnitScale(n,3.75,3.6,75.75)
				// call UnitApplyTimedLife(n,'BTLF',1)
				// call MyRemoveUnit(n, 1.5)

				set bjLCG=LoadGroupHandle(h, id,  GroupHash )
				call GroupEnumUnitsInRange(bjLCG, point_x, point_y, 175, Base)
				loop
				set E=FirstOfGroup(bjLCG)
				exitwhen E==null
				set ide=GetHandleId(E)
				if Condition_Base(GetOwningPlayer(bjLCU),E)and E!=LoadUnitHandle(h, GetHandleId(bjLCG),ide) and IsUnitInvulnerable(E)==false then
					call SetControlToUnit(E, E, 1.0, "stun")
                    if q_buff then
                        call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\jiejinmao.mdx",caster,"Right Hand"))
                        call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx", E, "origin"))
                    endif
                    set soundplay=SndN(4205) // Sound\Music\mp3Music\SinonHit.mp3
                    call StartSound(soundplay)
                    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                    if Sinon_ModifAttack(caster, E, 1.25, GetHeroAgi(caster, true)*3, 1.0, last_crit) then
                        if GetUnitAbilityLevel(caster,'BoPB')>0 then
                            call Push5(E,35,AU(caster,E),70,"")
                        endif
                        if GetUnitAbilityLevel(caster,'BoPD')>0 then
                            call Push5(E,35,AU(E,caster),70,"")
                        endif
                    endif
                    call UnitAddAbility(E, 'SNT1')
                    call UnitMakeAbilityPermanent(E, true, 'SNT1')
                    call UnitRemoveAbilityTimed_ExD(E, 'SNT1', 5.0)
                    call UnitRemoveAbilityTimed_ExD(E, 'B16W', 5.0)
                    call Push3(E, 40, angle, 200, "null")
					call SaveUnitHandle(h,GetHandleId(bjLCG),ide,E)
                    set n = CreateUnit(GetOwningPlayer(caster), 'd238', GetUnitX(E), GetUnitY(E), Rad2Deg(angle))
                    call SetUnitFlyHeight(n, 85, 0)
                    call SetUnitScale(n, 1.1+B2R_ExD(last_crit)*0.5, 1.1+B2R_ExD(last_crit)*0.5, 1.1+B2R_ExD(last_crit)*0.5)
                    call MyRemoveUnit(n, 1.5)
                    if last_crit then
                        set n = CreateUnit(GetOwningPlayer(caster), 'd140', GetUnitX(E), GetUnitY(E), Rad2Deg(angle))
                        call SetUnitFlyHeight(n, 85, 0)
                        call SetUnitScale(n, 1.1, 1.1, 1.1)
                        call MyRemoveUnit(n, 1.5)
                    endif
				endif
				call GroupRemoveUnit(bjLCG,E)
				endloop
			else
				call KillUnit(bjLCU)
				call MyRemoveUnit(bjLCU, 1)
				call SaveBoolean(h, id, SH_SecondAct, false)
			endif
		else
			call KillUnit(LoadUnitHandle(h, id, SH_Effect0))
			call MyRemoveUnit(LoadUnitHandle(h, id, SH_Effect0), 1.5)
			call FlushChildHashtable(h, GetHandleId(LoadGroupHandle(h, id,  GroupHash )))
			call DestroyGroup(LoadGroupHandle(h, id,  GroupHash ))
			call FlushChildHashtable(h, id)
			call DestroyTimer(GetExpiredTimer())
		endif
	endif
    set caster = null
endfunction


function SinonT_Cast takes unit newCaster, real point_x, real point_y returns nothing
    local timer newTimer = CreateTimer()
	local integer id = GetHandleId(newTimer)
	local integer id_caster = GetHandleId(newCaster)
    local integer ammo   = LoadInteger(HH, GetHandleId(newCaster), Sinon_Ammo)-2
	local real angle = AtanPoint(GetUnitX(newCaster), GetUnitY(newCaster), point_x, point_y)

	set n=CreateUnit(GetOwningPlayer(newCaster), 'dR20', GetUnitX(newCaster), GetUnitY(newCaster), 0)
	call SetUnitVertexColor(n, 255, 255, 255, 150)
	call SetUnitScale(n, 2, 2, 2)
	call SaveUnitHandle(h, id, SH_Effect0, n)

	if GetUnitAbilityLevel(newCaster, 'A17K')>0 then
        call SaveBoolean(h, id, 101, true)
    endif
    if ammo==0 then
        call Sinon_Prefire(newCaster, 99999, angle, 1)
    else
        call Sinon_Prefire(newCaster, 99999, angle, 0)
    endif
	call PauseUnit(newCaster, true)
	//call SetUnitInvulnerable(newCaster, true)
	call SetUnitAnimationByIndex(newCaster, 5)
    call SetUnitTimeScale(newCaster, 1.5)
	call SaveUnitHandle(h, id, CasterHash, newCaster)
	call SaveReal(h, id,  AngleHash , angle)
	call SaveGroupHandle(h, id,  GroupHash , CreateGroup())
	call TimerStart(newTimer, 0.005, true, function SinonT_Periodic)
    set newTimer = null
endfunction

function Sinon_ARPeriodic takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    caster = LoadUnitHandle(h, id, 0)
    local real    time   = LoadReal(h, id, 1)+0.1
    call SaveReal(h, id, 1, time)
    if GetUnitCurrentOrder(caster)==OrderId("chainlightning")then
        if time>=1.0 then
            call IssueImmediateOrder(caster, "stop")
            call SaveInteger(HH, GetHandleId(caster), Sinon_Ammo, LoadInteger(HH, GetHandleId(caster), Sinon_Ammo)+3)
            if LoadInteger(HH, GetHandleId(caster), Sinon_Ammo)>7 then
                call SaveInteger(HH, GetHandleId(caster), Sinon_Ammo, 7)
            endif
            call UnitAddAbility(caster, 'A222')
            call UnitMakeAbilityPermanent(caster, true, 'A222')
            call UnitRemoveAbilityTimed_ExD(caster, 'A222', 5.0)
            call StartAbilityCooldown(GetUnitAbility(caster, 'A2DC'), 25.0)
			set n = CreateUnit(GetOwningPlayer(caster), 'dM30', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
			call MyRemoveUnit(n, 1.5)
        endif
    else
        if time<1.0 then
            call StopSound(LoadSoundHandle(h, id, 2), false, true) // звук из массива — останавливаем, не удаляем
        endif
        call SetUnitTimeScale(caster, 1.0)
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set newTimer=null
    set caster=null
endfunction

function Sinon_AmmoReload takes unit newCaster returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    call SetUnitAnimationByIndex(newCaster, 11)
    call SetUnitTimeScale(newCaster, 0.5)
    set soundplay=SndN(4213) // Sound\Music\mp3Music\SinonF.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay)
    call SaveSoundHandle(h, id, 2, soundplay)
    call SaveUnitHandle(h, id, 0, newCaster)
    call TimerStart(newTimer, 0.1, true, function Sinon_ARPeriodic)
    set newTimer = null
endfunction

function Sinon_Cast takes nothing returns nothing
	if GetSpellAbilityId() == 'A2DC' then
        call Sinon_AmmoReload(GetSpellAbilityUnit())
    endif
	if GetSpellAbilityId() == 'SNW1' then
        call SinonW_Cast(GetSpellAbilityUnit() , GetSpellTargetX() , GetSpellTargetY())
    endif
	if GetSpellAbilityId() == 'SNW2' then    // Отмена W Sinon
		call KillUnit(GetSpellAbilityUnit())
        call IssueImmediateOrder(Hero[GetPlayerId(GetOwningPlayer(GetSpellAbilityUnit()))], "stop")
	endif
	if GetSpellAbilityId() == 'A270' then
        if LoadInteger(HH, GetHandleId(GetSpellAbilityUnit()), Sinon_Ammo)>0 then
            call SinonR_Cast(GetSpellAbilityUnit() , GetSpellTargetX() , GetSpellTargetY())
        else
            call SetWidgetMana(GetSpellAbilityUnit(), GetWidgetMana(GetSpellAbilityUnit())+BlzGetUnitAbilityManaCost(GetSpellAbilityUnit(), 'A270', GetUnitAbilityLevel(GetSpellAbilityUnit(), 'A270')))
            call DisplayTimedWarningMessage(GetOwningPlayer(GetSpellAbilityUnit()),3,Lng("|c003f4c77Магазин пуст!|r","|c003f4c77Magazine is empty!|r"))
            set soundplay=SndN(4215) // Sound\Music\mp3Music\SinonEmpty.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        endif
    endif
	if GetSpellAbilityId() == 'A2ZD' then
        if LoadInteger(HH, GetHandleId(GetSpellAbilityUnit()), Sinon_Ammo)>=2 then
            call SinonT_Cast(GetSpellAbilityUnit() , GetSpellTargetX() , GetSpellTargetY())
        elseif LoadInteger(HH, GetHandleId(GetSpellAbilityUnit()), Sinon_Ammo)==1 then
            call SetWidgetMana(GetSpellAbilityUnit(), GetWidgetMana(GetSpellAbilityUnit())+BlzGetUnitAbilityManaCost(GetSpellAbilityUnit(), 'A2ZD', GetUnitAbilityLevel(GetSpellAbilityUnit(), 'A2ZD')))
            call DisplayTimedWarningMessage(GetOwningPlayer(GetSpellAbilityUnit()),3,Lng("|c003f4c77Недостаточно патронов!|r","|c003f4c77Not enough ammo!|r"))
            set soundplay=SndN(4215) // Sound\Music\mp3Music\SinonEmpty.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        else
            call SetWidgetMana(GetSpellAbilityUnit(), GetWidgetMana(GetSpellAbilityUnit())+BlzGetUnitAbilityManaCost(GetSpellAbilityUnit(), 'A2ZD', GetUnitAbilityLevel(GetSpellAbilityUnit(), 'A2ZD')))
            call DisplayTimedWarningMessage(GetOwningPlayer(GetSpellAbilityUnit()),3,Lng("|c003f4c77Магазин пуст!|r","|c003f4c77Magazine is empty!|r"))
            set soundplay=SndN(4215) // Sound\Music\mp3Music\SinonEmpty.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        endif
    endif
endfunction

function InitTrig_SinonInt takes nothing returns nothing
    local trigger trig= CreateTrigger()
    local integer index= 0
    loop
        call TriggerRegisterPlayerUnitEvent(trig, Player(index), EVENT_PLAYER_UNIT_SPELL_EFFECT, null)
        set index=index + 1
        exitwhen index == bj_MAX_PLAYER_SLOTS
    endloop
    call TriggerAddAction(trig, function Sinon_Cast)
	set trig=null
endfunction

//===========================================================================
//===========
//===========================================================================
//function InitTrig_BelfegorShield takes nothing returns nothing
//local trigger trig=CreateTrigger()
//call AnyUnitDamagedEvent(trig)
//call TriggerAddAction(trig,function Trig_BelfegorShield_Actions)
//endfunction

    function WendyE2 takes nothing returns nothing
        local integer id= (GetHandleId(GetExpiredTimer())) // INLINED!!
        local real time= LoadFloat("Time")
        local real x= LoadFloat("x")
        local real y= LoadFloat("y")
        local real x1= GetUnitX(LoadUnitHandle(HH,MUIHandle(),CasterHash))
        local real y1= GetUnitY(LoadUnitHandle(HH,MUIHandle(),CasterHash))
        local real dmg= ((3+GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash),'WE08'))*GetHeroInt(LoadUnitHandle(HH,MUIHandle(),CasterHash),true))
        local real ang= LoadFloat("ang")
        local real dist= SR(x1 , y1 , x , y)
        local real tick= LoadFloat("tick")
        local real tick2= LoadFloat("tick2")
        local real ang2= Atan2(y - y1, x - x1)
        
        if time == 0. then
            call SaveReal(HH, id, TickHash, 0.)
            call SaveReal(HH, id, SH_tick2, 0.)
            call SaveReal(HH, id, SH_interval, 0.1)
            call SaveBoolean(HH, id, SH_checker, false)
            call SaveBoolean(HH, id, SH_checker2, false)
            call SetUnitAnimationByIndex(LoadUnitHandle(HH,MUIHandle(),CasterHash), 14)
            call SetUnitTimeScale(LoadUnitHandle(HH,MUIHandle(),CasterHash), 2)
        endif
        if time>4 and LoadUnit("Target") == null then
            call SaveBoolean(HH, id, SH_checker2, true) 
        endif
        if dist > 300 and LoadBoolean(HH, id, SH_checker) == false then
            if tick >= 0.3 then
                call SaveReal(HH, id, SH_interval, 0.15)
            endif
            
                    if tick2 < 0.05 then
                        call SaveReal(HH, id, SH_tick2, tick2 + 0.01)
                    else
                        call SaveReal(HH, id, SH_tick2, 0.)
                        set EFF=AddSpecialEffect("war3mapImported\\Hashirama_MADARAa (73)2.mdx", x1, y1)
                        call SetSpecialEffectScale(EFF , 1)
                        call SetSpecialEffectTimeScale(EFF , 1)
                        call SetSpecialEffectFacing(EFF , GetUnitFacing(LoadUnitHandle(HH,MUIHandle(),CasterHash)))
                        call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 150 , 5)
                    endif
            
            if tick < LoadFloat("interval") then
                if tick == 0 then
                    if dist > 425 then
                        set EFF=AddSpecialEffect("war3mapImported\\BY_Wood_Eff_Ord_DanGe_Wid_ChongFengQiLiu.mdl", x1, y1)
                        call SetSpecialEffectScale(EFF , 1)
                        call SetSpecialEffectTimeScale(EFF , 2)
                        call SetSpecialEffectFacing(EFF , ( ang + 1 ) * bj_RADTODEG)
                        call SetSpecialEffectZ(EFF , 50)
                        call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 200 , 5)
                        set EFF=AddSpecialEffect("war3mapImported\\BY_Wood_Eff_Ord_DanGe_Dus_Kuosan_1_2_1.mdl", x1, y1)
                        call SetSpecialEffectScale(EFF , 1)
                        call SetSpecialEffectTimeScale(EFF , 2)
                        call SetSpecialEffectFacing(EFF , ( ang + 1 ) * bj_RADTODEG)
                        call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 150 , 5)
                        
                    endif
                endif
                call SetUnitXY_1(LoadUnitHandle(HH,MUIHandle(),CasterHash) , x1 + 25 * Cos(ang + 1) , y1 + 25 * Sin(ang + 1) , true)
                call SetUnitFacingInstant(LoadUnitHandle(HH,MUIHandle(),CasterHash) , bj_RADTODEG * ( ang + 1 ))
                call SaveReal(HH, id, TickHash, tick + 0.01)
            elseif tick > LoadFloat("interval") and tick <= 0.3 then
                if tick == LoadFloat("interval") + 0.01 then
                    if dist > 425 then
                        set EFF=AddSpecialEffect("war3mapImported\\BY_Wood_Eff_Ord_DanGe_Wid_ChongFengQiLiu.mdl", x1, y1)
                        call SetSpecialEffectScale(EFF , 1)
                        call SetSpecialEffectTimeScale(EFF , 2)
                        call SetSpecialEffectFacing(EFF , ( ang - 1 ) * bj_RADTODEG)
                        call SetSpecialEffectZ(EFF , 50)
                        call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 200 , 5)
                        set EFF=AddSpecialEffect("war3mapImported\\BY_Wood_Eff_Ord_DanGe_Dus_Kuosan_1_2_1.mdl", x1, y1)
                        call SetSpecialEffectScale(EFF , 1)
                        call SetSpecialEffectTimeScale(EFF , 2)
                        call SetSpecialEffectFacing(EFF , ( ang - 1 ) * bj_RADTODEG)
                        call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 150 , 5)
                    endif
                endif
                call SetUnitXY_1(LoadUnitHandle(HH,MUIHandle(),CasterHash) , x1 + 25 * Cos(ang - 1) , y1 + 25 * Sin(ang - 1) , true)
                call SetUnitFacingInstant(LoadUnitHandle(HH,MUIHandle(),CasterHash) , bj_RADTODEG * ( ang - 1 ))
                call SaveReal(HH, id, TickHash, tick + 0.01)
            elseif tick >= 0.3 then
                call SaveReal(HH, id, TickHash, 0.)
            endif
            
            if tick == 0. then
                set soundplay=SndN(4217) // Sound\Music\mp3Music\WendyE1.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            elseif tick == 0.15 then
                set soundplay=SndN(4219) // Sound\Music\mp3Music\WendyE2.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            endif
        else
            if LoadBoolean(HH, id, SH_checker) == false then
                set soundplay=SndN(4217) // Sound\Music\mp3Music\WendyE1.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                set EFF=AddSpecialEffect("war3mapImported\\BY_Wood_Eff_Ord_DanGe_Wid_ChongFengQiLiu.mdl", x1, y1)
                call SetSpecialEffectScale(EFF , 1)
                call SetSpecialEffectTimeScale(EFF , 2)
                call SetSpecialEffectFacing(EFF , ( ang2 ) * bj_RADTODEG)
                call SetSpecialEffectZ(EFF , 50)
                call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 200 , 5)
                set EFF=AddSpecialEffect("war3mapImported\\BY_Wood_Eff_Ord_DanGe_Dus_Kuosan_1_2_1.mdl", x1, y1)
                call SetSpecialEffectScale(EFF , 1)
                call SetSpecialEffectTimeScale(EFF , 2)
                call SetSpecialEffectFacing(EFF , ( ang2 ) * bj_RADTODEG)
                call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 150 , 5)
                set EFF=AddSpecialEffect("war3mapImported\\Hashirama_MADARAa (73)2.mdx", x1 + 150 * Cos(ang2), y1 + 150 * Sin(ang2))
                call SetSpecialEffectScale(EFF , 1)
                call SetSpecialEffectTimeScale(EFF , 1)
                call SetSpecialEffectFacing(EFF , ( ang2 ) * bj_RADTODEG)
                call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 150 , 5)
                set EFF=AddSpecialEffect("war3mapImported\\Hashirama_MADARAa (73)2.mdx", x1 + 350 * Cos(ang2), y1 + 350 * Sin(ang2))
                call SetSpecialEffectScale(EFF , 2)
                call SetSpecialEffectTimeScale(EFF , 1)
                call SetSpecialEffectFacing(EFF , ( ang2 ) * bj_RADTODEG)
                call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 150 , 5)
            endif
            call SaveBoolean(HH, id, SH_checker, true)
            if LoadBoolean(HH, id, SH_checker2) == false then
                call SetUnitXY_1(LoadUnitHandle(HH,MUIHandle(),CasterHash) , x1 + 25 * Cos(ang2) , y1 + 25 * Sin(ang2) , true)
                call SetUnitFacingInstant(LoadUnitHandle(HH,MUIHandle(),CasterHash) , bj_RADTODEG * ang2)
                if dist <= 50 then
                    call SaveBoolean(HH, id, SH_checker2, true)
                    call SaveReal(HH, id, TickHash, 0.)
                    call SetUnitAnimationByIndex(LoadUnitHandle(HH,MUIHandle(),CasterHash), 16)
                    call SetUnitTimeScale(LoadUnitHandle(HH,MUIHandle(),CasterHash), 1)
                endif
            endif
        endif
        
        if LoadUnit("Target") == null then
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, x1, y1, 250, Base)
            loop
                set SysUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen SysUnit == null
                if GetWidgetLife(SysUnit) > 0.405 and SysUnit!= LoadUnitHandle(HH,MUIHandle(),CasterHash) then
                    if Condition_Base(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)),SysUnit) and LoadUnit("Target") == null and IsUnitInvulnerable(SysUnit) == false then
                        if LoadBoolean(HH,GetHandleId(SysUnit),ANTITARGET_ABILITY)==false then
                            call SaveAgentHandle(HH, id, TargetHash, SysUnit)
                            set soundplay=SndN(4221) // Sound\Music\mp3Music\WendyE3.mp3
                            call StartSound(soundplay)
                            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                            call SaveBoolean(HH, id, SH_checker, true)
                            call SaveBoolean(HH, id, SH_checker2, true)
                            call SetUnitTimeScale(LoadUnitHandle(HH,MUIHandle(),CasterHash), 0.5)
                        else
                            call SaveUnitHandle(HH,GetHandleId(SysUnit),REVERSE_TARGET,LoadUnitHandle(HH,MUIHandle(),CasterHash))
                            call SetUnitTimeScale(LoadUnitHandle(HH,MUIHandle(),CasterHash), 1)
                            call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
                            call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
                            call Clear(id)
                        endif
                    endif
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, SysUnit)
            endloop
            call GroupClear(bj_lastCreatedGroup)
            call DestroyGroup(bj_lastCreatedGroup)
        endif
        
        call SaveReal(HH, id, TIME_HASH, time + 0.01)
        call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), true)
        call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), true)
        
        if LoadUnit("Target") != null then
            if tick < 1.1 then
                call SaveReal(HH, id, TickHash, tick + 0.01)
                call PauseUnit(LoadUnit("Target"), true)
                call SaveBoolean(HH,GetHandleId(LoadUnit("Target")),TARGET_ABILITY,true)
                call SetUnitInvulnerable(LoadUnit("Target"), true)
                if SR(x1 , y1 , GetUnitX(LoadUnit("Target")) , GetUnitY(LoadUnit("Target"))) > 70 then
                    call SetUnitXY_1(LoadUnitHandle(HH,MUIHandle(),CasterHash) , x1 + 2 * Cos(Atan2(GetUnitY(LoadUnit("Target")) - y1, GetUnitX(LoadUnit("Target")) - x1)) , y1 + 2 * Sin(Atan2(GetUnitY(LoadUnit("Target")) - y1, GetUnitX(LoadUnit("Target")) - x1)) , true)
                    call SetUnitFacingInstant(LoadUnitHandle(HH,MUIHandle(),CasterHash) , bj_RADTODEG * Atan2(GetUnitY(LoadUnit("Target")) - y1, GetUnitX(LoadUnit("Target")) - x1))
                else
                    call SaveReal(HH, id, TickHash, 1.11)
                endif
            else
            
                if tick == 1.11 then
                    call SetUnitAnimationByIndex(LoadUnitHandle(HH,MUIHandle(),CasterHash), 15)
                    call SaveReal(HH, id, TickHash, 1.12)
                    set EFF=AddSpecialEffect("chongfeng2.mdl", x1, y1)
                    call SetSpecialEffectScale(EFF , 1)
                    call SetSpecialEffectTimeScale(EFF , 1)
                    call SetSpecialEffectFacing(EFF , ( ( Atan2(GetUnitY(LoadUnit("Target")) - y1, GetUnitX(LoadUnit("Target")) - x1) ) * bj_RADTODEG ))
                    call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 150 , 5)
                    set EFF=AddSpecialEffect("cf2.mdx", GetUnitX(LoadUnit("Target")), GetUnitY(LoadUnit("Target")))
                    call SetSpecialEffectScale(EFF , 1)
                    call SetSpecialEffectTimeScale(EFF , 1)
                    call SetSpecialEffectFacing(EFF , ( ( Atan2(GetUnitY(LoadUnit("Target")) - y1, GetUnitX(LoadUnit("Target")) - x1) ) * bj_RADTODEG ))
                    call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 150 , 5)
                    set EFF=AddSpecialEffect("war3mapImported\\by_wood_gongchengsipai_5.mdl", GetUnitX(LoadUnit("Target")), GetUnitY(LoadUnit("Target")))
                    call SetSpecialEffectScale(EFF , 1)
                    call SetSpecialEffectTimeScale(EFF , 0.8)
                    call SetSpecialEffectFacing(EFF , ( ( Atan2(GetUnitY(LoadUnit("Target")) - y1, GetUnitX(LoadUnit("Target")) - x1) ) * bj_RADTODEG ))
                    call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 150 , 5)
                    call PauseUnit(LoadUnit("Target"), false)
                    call SaveBoolean(HH,GetHandleId(LoadUnit("Target")),TARGET_ABILITY,false)
                    call SetUnitInvulnerable(LoadUnit("Target"), false)
                    call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
                    call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
                    call myCustomDamage(LoadUnitHandle(HH,MUIHandle(),CasterHash), LoadUnit("Target"), dmg, false, false, null, null, null)
                    call SetControlToUnit(LoadUnit("Target"),LoadUnit("Target"), 2, "stun")
                    call SetUnitTimeScale(LoadUnitHandle(HH,MUIHandle(),CasterHash), 2)
                   
                endif
                if tick < 1.4 then
                    call SaveReal(HH, id, TickHash, tick + 0.01)
                    call SetUnitXY_1(LoadUnit("Target") , GetUnitX(LoadUnit("Target")) + 15 * Cos(Atan2(GetUnitY(LoadUnit("Target")) - y1, GetUnitX(LoadUnit("Target")) - x1)) , GetUnitY(LoadUnit("Target")) + 15 * Sin(Atan2(GetUnitY(LoadUnit("Target")) - y1, GetUnitX(LoadUnit("Target")) - x1)) , true)
                else
                    set EFF=AddSpecialEffect("az_slb.mdl", GetUnitX(LoadUnit("Target")), GetUnitY(LoadUnit("Target")))
                    call SetSpecialEffectScale(EFF , 1)
                    call SetSpecialEffectTimeScale(EFF , 1)
                    call SetSpecialEffectFacing(EFF , ( ( Atan2(GetUnitY(LoadUnit("Target")) - y1, GetUnitX(LoadUnit("Target")) - x1) ) * bj_RADTODEG ))
                    call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 150 , 5)
                    call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
                    call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
                    call PauseUnit(LoadUnit("Target"), false)
                    call SaveBoolean(HH,GetHandleId(LoadUnit("Target")),TARGET_ABILITY,false)
                    call SetUnitInvulnerable(LoadUnit("Target"), false)
                    call Clear(id)
                endif
            endif
        endif
        
        if ( LoadBoolean(HH, id, SH_checker2) == true and LoadUnit("Target") == null ) then
            call SetUnitTimeScale(LoadUnitHandle(HH,MUIHandle(),CasterHash), 1)
            call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
            call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
            call Clear(id)
        endif
    endfunction
    
    function WendyT2 takes nothing returns nothing
        local integer id= (GetHandleId(GetExpiredTimer())) // INLINED!!
        local real time= LoadFloat("Time")
        local real x= LoadFloat("x")
        local real y= LoadFloat("y")
        local real x1= GetUnitX(LoadUnitHandle(HH,MUIHandle(),CasterHash))
        local real y1= GetUnitY(LoadUnitHandle(HH,MUIHandle(),CasterHash))
        local integer tick= LoadInt("tick")
        local real dmg= 4*GetHeroInt(LoadUnitHandle(HH,MUIHandle(),CasterHash),true)
        local real ang= LoadFloat("ang")
        local real ang2= LoadFloat("ang2")
        // группа создаётся только на тике с поиском целей (раньше — каждый тик, и 2 из 3 не удалялись)
        local group g2=null
        local real ang3= 0
        
        if time == 0. then
            set soundplay=SndN(4223) // Sound\Music\mp3Music\WendyT2.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            set EFF=AddSpecialEffect("war3mapImported\\aya-wind2.mdl", x, y)
            call SetSpecialEffectScale(EFF , 3.3)
            call SetSpecialEffectTimeScale(EFF , 1.)
            call SetSpecialEffectZ(EFF , - 50)
            call SetSpecialEffectVertexColour(EFF , 255 , 255 , 255 , 150)
            call SaveAgentHandle(HH, id, SH_eff, EFF)
            call SaveReal(HH, id, SH_ang2, ang)
        endif
        
        call SaveReal(HH, id, TIME_HASH, time + 0.04)
        
        if time == 3. then
            call SetSpecialEffectAlphaTimed(LoadEffect("eff") , 255 , 255 , 255 , 150 , 1)
        endif
        
        if time < 4. then
            if tick < 2 then
                call SaveInteger(HH, id, TickHash, tick + 1)
            else
                call SaveInteger(HH, id, TickHash, 0)
                set EFF=AddSpecialEffect("white-qiquan-new.mdl", x, y)
                call SetSpecialEffectScale(EFF , GetRandomReal(3, 5))
                call SetSpecialEffectTimeScale(EFF , GetRandomReal(0.5, 2))
                call SetSpecialEffectZ(EFF , GetRandomReal(0.5, 400))
                call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 150 , 4)
                set EFF=AddSpecialEffect("war3mapImported\\fuzzystomp4.mdx", x, y)
                call SetSpecialEffectScale(EFF , GetRandomReal(1, 3))
                call SetSpecialEffectTimeScale(EFF , GetRandomReal(0.5, 2))
                call SetSpecialEffectZ(EFF , GetRandomReal(0.5, 400))
                call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 150 , 4)
                set g2=CreateGroup()
                call GroupEnumUnitsInRange(g2, x, y, 750, Base)
                loop
                    set SysUnit=FirstOfGroup(g2)
                    exitwhen SysUnit == null
                    if GetWidgetLife(SysUnit) > 0.405 and SysUnit != LoadUnitHandle(HH,MUIHandle(),CasterHash) and Condition_Base(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)),SysUnit)  then
                        call SaveReal(HH, id, SH_ang, ang - 0.14)
                        if LoadFloat("fh") < 500 then
                            call SaveReal(HH, id, SH_fh, LoadFloat("fh") + 4)
                        endif
                        if LoadBoolean(HH,GetHandleId(SysUnit),DoflaTHash)==false then
                            call SetUnitXY_1(SysUnit , GetUnitX(SysUnit) - 25 * Cos(Atan2(GetUnitY(SysUnit) - ( y - 250 * Sin(ang) ), GetUnitX(SysUnit) - ( x - 250 * Cos(ang) ))) , GetUnitY(SysUnit) - 25 * Sin(Atan2(GetUnitY(SysUnit) - ( y - 250 * Sin(ang) ), GetUnitX(SysUnit) - ( x - 250 * Cos(ang) ))) , false)
                        endif
                        call myCustomDamage(LoadUnitHandle(HH,MUIHandle(),CasterHash), SysUnit, dmg * 0.092, false, false, null, null, null)
                        if IsUnitInvulnerable(SysUnit)==false then
                            if GetUnitCurrentOrder(SysUnit)!=0 then
                                call IssueImmediateOrder(SysUnit,"stop")
                            endif
                            call SetControlToUnit(SysUnit,SysUnit,0.06,"stunbkb")
                        endif
                        if time < 3.5 then
                            call UnitAddAbility(SysUnit, 'Arav')
                            if GetUnitFlyHeight(SysUnit)<500 then
                            call SetUnitFlyHeight(SysUnit, GetUnitFlyHeight(SysUnit) + LoadFloat("fh"), 0)
                            endif
                            call UnitRemoveAbility(SysUnit, 'Arav')
                        else
                            call UnitAddAbility(SysUnit, 'Arav')
                            call SetUnitFlyHeight(SysUnit, 0, 1100)
                            call UnitRemoveAbility(SysUnit, 'Arav')
                        endif
                    endif
                    call GroupRemoveUnit(g2, SysUnit)
                endloop
                call DestroyGroup(g2)
            endif
        endif
        
        if time > 6. then
            call DestroyGroup(g2)
            call Clear(id)
        endif
        set g2=null
    endfunction
    
   function WendyT takes nothing returns nothing
        local integer id= (GetHandleId(GetExpiredTimer())) // INLINED!!
        local real time= LoadFloat("Time")
        local real x= GetUnitX(LoadUnitHandle(HH,MUIHandle(),CasterHash))
        local real y= GetUnitY(LoadUnitHandle(HH,MUIHandle(),CasterHash))
        
        if time == 0. then
            call SetUnitAnimationByIndex(LoadUnitHandle(HH,MUIHandle(),CasterHash), 10)
            set soundplay=SndN(4225) // Sound\Music\mp3Music\WendyT.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            call SaveReal(HH, id, TickHash, 0.)
        endif
        
        if time < 2 then
            call SaveReal(HH, id, TIME_HASH, time + 0.01)
        endif
        
        if IsUnitPaused(LoadUnitHandle(HH,MUIHandle(),CasterHash)) == false and IsUnitHidden(LoadUnitHandle(HH,MUIHandle(),CasterHash))==false and time >= 2 then
            call SaveReal(HH, id, TIME_HASH, time + 0.01)
            if udg_B==false then
                call SaveReal(HH, id, TIME_HASH, time + 27)
            endif
        endif
        
        if time < 2 then
            call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), true)
            call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), true)
            if LoadFloat("tick") < 0.08 then
                call SaveReal(HH, id, TickHash, LoadFloat("tick") + 0.01)
            else
                set EFF=AddSpecialEffect("BY_Wood_Eff_Ord_DanGe_Wav_Kuosan_1_2_0.25s.mdx", x, y)
                call SetSpecialEffectScale(EFF , GetRandomReal(1.5, 2.5))
                call SetSpecialEffectTimeScale(EFF , GetRandomReal(0.5, 1.5))
                call SetSpecialEffectOrientation(EFF , GetRandomReal(0, 359),0,0)
                call SetSpecialEffectZ(EFF , GetRandomReal(0, 200))
                call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 155 , 5)
                set EFF=AddSpecialEffect("BY_Wood_Eff_Ord_DanGe_Dus_Kuosan_1_2_1.mdx", x, y)
                call SetSpecialEffectScale(EFF , GetRandomReal(0.5, 1.5))
                call SetSpecialEffectTimeScale(EFF , GetRandomReal(0.5, 1.5))
                call SetSpecialEffectOrientation(EFF , GetRandomReal(0, 359),0,0)
                call SetSpecialEffectZ(EFF , GetRandomReal(0, 200))
                call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 155 , 5)
                set EFF=AddSpecialEffect("BY_Wood_Eff_Ord_DanGe_Dus_Kuosan_1_2_1.mdx", x, y)
                call SetSpecialEffectScale(EFF , GetRandomReal(0.5, 1.5))
                call SetSpecialEffectTimeScale(EFF , GetRandomReal(0.5, 1.5))
                call SetSpecialEffectOrientation(EFF , GetRandomReal(0, 359),0,0)
                call SetSpecialEffectZ(EFF , GetRandomReal(0, 200))
                call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 155 , 5)
                set EFF=AddSpecialEffect("rasengan_eff4.mdx", x, y)
                call SetSpecialEffectScale(EFF , GetRandomReal(1.5, 2.5))
                call SetSpecialEffectTimeScale(EFF , GetRandomReal(0.5, 1.5))
                call SetSpecialEffectOrientation(EFF , GetRandomReal(0, 359),0,0)
                call SetSpecialEffectZ(EFF , GetRandomReal(0, 20))
                call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 155 , 5)
                call SaveReal(HH, id, TickHash, 0.)
            endif
        endif
        
        if time == 2 then
            call UnitAddAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03')
            call SetPlayerAbilityAvailable(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)), 'WE06', false)
            call UnitAddAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WE07')
            call SetPlayerAbilityAvailable(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)), 'WE03', false)
            call UnitAddAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WE08')
            call SetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WE08',GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WE03'))
            call UnitAddAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WE09')
            call AddUnitAnimationProperties(LoadUnitHandle(HH,MUIHandle(),CasterHash), "alternate", true)
            call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
            call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
            call CreateModeIndicatorWithPauseForm(LoadUnitHandle(HH,MUIHandle(),CasterHash), "ReplaceableTextures\\CommandButtons\\BTNWendyT.blp", 25.0)
            set EFF=AddSpecialEffect("hehehehehe31.MDx", x, y)
            call SetSpecialEffectScale(EFF , 1)
            call SetSpecialEffectTimeScale(EFF , 2)
            call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 5)
            set EFF=AddSpecialEffect("war3mapImported\\by_wood_effect_yuanbanlin_sand2.mdx", x, y)
            call SetSpecialEffectScale(EFF , 3)
            call SetSpecialEffectTimeScale(EFF , 2)
            call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 5)
        endif
        
        if time > 27. then
            call UnitRemoveAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03')
            call UnitRemoveAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'BW03')
            call SetPlayerAbilityAvailable(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)), 'WE06', true)
            call UnitRemoveAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WE07')
            call SetPlayerAbilityAvailable(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)), 'WE03', true)
            call UnitRemoveAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WE08')
            call UnitRemoveAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WE09')
            call AddUnitAnimationProperties(LoadUnitHandle(HH,MUIHandle(),CasterHash), "alternate", false)
            call SetUnitAnimationByIndex(LoadUnitHandle(HH,MUIHandle(),CasterHash), 1)
            call Clear(id)
        endif
    endfunction
    
    function WendyR takes nothing returns nothing
        local integer id= (GetHandleId(GetExpiredTimer())) // INLINED!!
        local real time= LoadFloat("Time")
        local real x= LoadFloat("x")
        local real y= LoadFloat("y")
        local real x1= GetUnitX(LoadUnitHandle(HH,MUIHandle(),CasterHash))
        local real y1= GetUnitY(LoadUnitHandle(HH,MUIHandle(),CasterHash))
        local integer tick= LoadInt("tick")
        local real dmg= ((6+GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash),'WE05'))*GetHeroInt(LoadUnitHandle(HH,MUIHandle(),CasterHash),true))
        local real ang= LoadFloat("ang")
        
        if time == 0. then
            call SaveAgentHandle(HH, id, GroupHash, CreateGroup())
            set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)), 'cdm1', x1, y1, ang * bj_RADTODEG)
            call SaveAgentHandle(HH, id, DummyHash, n)
            set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)), 'cdm1', x, y, ang * bj_RADTODEG)
            call SaveAgentHandle(HH, id, Dummy1Hash, n)
            if GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') > 0 then
                call SetUnitAnimation(LoadUnitHandle(HH,MUIHandle(),CasterHash), "Spell one alternate")
            else
                call SetUnitAnimation(LoadUnitHandle(HH,MUIHandle(),CasterHash), "Spell one")
            endif
            call SetUnitTimeScale(LoadUnitHandle(HH,MUIHandle(),CasterHash), 0.5)
            set soundplay=SndN(4227) // Sound\Music\mp3Music\WendyR.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            call SaveInteger(HH, id, TickHash, 0)
            set EFF=AddSpecialEffect("war3mapImported\\az_airflowwEnd.mdx", x, y)
            call SetSpecialEffectScale(EFF , 3.3)
            call SetSpecialEffectTimeScale(EFF , 2.)
            call SetSpecialEffectZ(EFF , - 350)
            call SetSpecialEffectVertexColour(EFF , 70 , 240 , 255 , 255)
            call SaveAgentHandle(HH, id, SH_eff, EFF)
            set EFF=AddSpecialEffect("MC Wendy.mdx", x1, y1)
            call SetSpecialEffectScale(EFF , 1.5)
            call SetSpecialEffectTimeScale(EFF , 1)
            call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 1)
            set EFF=AddSpecialEffect("war3mapImported\\by_wood_effect_yuanbanlin_sand2.mdx", x1, y1)
            call SetSpecialEffectScale(EFF , 1)
            call SetSpecialEffectTimeScale(EFF , 2)
            call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 9)
            set EFF=AddSpecialEffect("war3mapImported\\BY_Wood_Eff_Ord_DanGe_Wav_Kuosan_1_3_0.5s.mdl", x1, y1)
            call SetSpecialEffectScale(EFF , 0.3)
            call SetSpecialEffectTimeScale(EFF , 2)
            call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 8)
            set EFF=AddSpecialEffect("war3mapImported\\rasengan_eff4.mdl", x1, y1)
            call SetSpecialEffectScale(EFF , 2)
            call SetSpecialEffectTimeScale(EFF , 1)
            call SetSpecialEffectVertexColour(EFF , 255 , 255 , 255 , 150)
            call SetSpecialEffectFacing(EFF , GetRandomReal(0, 359))
            call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 150 , 5)
            //war3mapImported\dingzhi_by_wood_effect_kuosanqiliu.mdx
            set EFF=AddSpecialEffect("war3mapImported\\dingzhi_by_wood_effect_kuosanqiliu.mdx", x, y)
            call SetSpecialEffectScale(EFF , 2.)
            call SetSpecialEffectTimeScale(EFF , 2.)
            call SetSpecialEffectVertexColour(EFF , 255 , 255 , 255 , 25)
            call SetSpecialEffectZ(EFF , - 2)
            call SaveAgentHandle(HH, id, SH_eff3, EFF)
            call SaveReal(HH, id, AngleHash, 0.)
        endif
        
        call SaveReal(HH, id, TIME_HASH, time + 0.01)
        
        if time == 0.4 then
            call SetSpecialEffectTimeScale(LoadEffect("eff3") , 0.)
        endif
        
        if time < 4. then
        
            if LoadFloat("angle") < 359. then
                call SaveReal(HH, id, AngleHash, LoadFloat("angle") + 5.)
                call SetSpecialEffectFacing(LoadEffect("eff3") , LoadFloat("angle"))
            else
                call SaveReal(HH, id, AngleHash, 0.)
            endif
        
            if tick < 10 then
                call SaveInteger(HH, id, TickHash, tick + 1)
            else
                call SaveInteger(HH, id, TickHash, 0)
                set EFF=AddSpecialEffect("war3mapImported\\disruptor_e2.mdx", x, y)
                call SetSpecialEffectScale(EFF , GetRandomReal(1.2, 1.5))
                call SetSpecialEffectTimeScale(EFF , 1.2)
                call SetSpecialEffectZ(EFF , GetRandomReal(0, 200))
                call SetSpecialEffectVertexColour(EFF , 70 , 240 , 255 , 150)
                call SetSpecialEffectAlphaTimed(EFF , 70 , 240 , 255 , 150 , 3)
                call SetSpecialEffectFacing(EFF , GetRandomReal(0, 359))
            endif
            
            set bj_lastCreatedGroup=CreateGroup() //
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, x, y, 550, Base)
            loop
                set SysUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen SysUnit == null
                    if GetWidgetLife(SysUnit) > 0.405 and SysUnit != LoadUnitHandle(HH,MUIHandle(),CasterHash) and Condition_Base(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)),SysUnit) and IsUnitInvulnerable(SysUnit)==false then
                        if SR(GetUnitX(SysUnit) , GetUnitY(SysUnit) , x , y) > 330 and SR(GetUnitX(SysUnit) , GetUnitY(SysUnit) , x , y) < 440 then
                            call SetUnitX(SysUnit, GetUnitX(SysUnit) + 30 * Cos(Atan2(y - GetUnitY(SysUnit), x - GetUnitX(SysUnit))))
                            call SetUnitY(SysUnit, GetUnitY(SysUnit) + 30 * Sin(Atan2(y - GetUnitY(SysUnit), x - GetUnitX(SysUnit))))
                        endif
                        if SR(GetUnitX(SysUnit) , GetUnitY(SysUnit) , x , y) >= 441 then
                            call SetUnitX(SysUnit, GetUnitX(SysUnit) - 30 * Cos(Atan2(y - GetUnitY(SysUnit), x - GetUnitX(SysUnit))))
                            call SetUnitY(SysUnit, GetUnitY(SysUnit) - 30 * Sin(Atan2(y - GetUnitY(SysUnit), x - GetUnitX(SysUnit))))
                        endif
                    endif
                    call GroupRemoveUnit(bj_lastCreatedGroup, SysUnit)
            endloop
            call GroupClear(bj_lastCreatedGroup)
            call DestroyGroup(bj_lastCreatedGroup)
        endif
        
        if time == 4.01 then
            //call SetSpecialEffectVertexColour(LoadEffect("eff") , 70 , 240 , 255 , 255)
            set EFF=AddSpecialEffect("war3mapImported\\BY_Wood_Eff_Ord_DanGe_Dus_Kuosan_1_2_1.mdl", x1 + 30 * Cos(ang - 0.6), y1 + 30 * Sin(ang - 0.6))
            call SetSpecialEffectScale(EFF , 1.5)
            //call SetSpecialEffectFacing(EFF , ( ang - 0.6 ) * bj_RADTODEG)
            call SetSpecialEffectTimeScale(EFF , 1)
            call RemoveEffect(EFF,9,true,CreateTimer())
            set EFF=AddSpecialEffect("war3mapImported\\BY_Wood_Eff_Ord_DanGe_Dus_Kuosan_1_2_1.mdl", x1 + 30 * Cos(ang + 0.6), y1 + 30 * Sin(ang + 0.6))
            call SetSpecialEffectScale(EFF , 1.5)
            //call SetSpecialEffectFacing(EFF , ( ang + 0.6 ) * bj_RADTODEG)
            call SetSpecialEffectTimeScale(EFF , 1)
            call RemoveEffect(EFF,9,true,CreateTimer())
            set EFF=AddSpecialEffect("war3mapImported\\BY_Wood_Eff_Ord_DanGe_Dus_Kuosan_1_2_1.mdl", x1 + 30 * Cos(ang), y1 + 30 * Sin(ang))
            call SetSpecialEffectScale(EFF , 2)
            call SetSpecialEffectFacing(EFF ,  ang * bj_RADTODEG)
            call SetSpecialEffectTimeScale(EFF , 1)
            call RemoveEffect(EFF,9,true,CreateTimer())
            set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)), 'cdm2', x1 + 100 * Cos(ang), y1 + 100 * Sin(ang), ang * bj_RADTODEG)
            call SetUnitAnimationByIndex(n , 1)
            call SetUnitTimeScale(n , 1.5)
            call UnitApplyTimedLife(n,'BTLF',2)
            //call SetSpecialEffectAnimationByIndex(EFF , 1)
        endif
        if time >= 4.01 and time<4.20 then
            call SetUnitXY_1(LoadUnit("Dummy") , GetUnitX(LoadUnit("Dummy")) + 100 * Cos(ang) , GetUnitY(LoadUnit("Dummy")) + 100 * Sin(ang) , false)
            set bj_lastCreatedGroup=CreateGroup()
                //call BJDebugMsg("1")
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(LoadUnit("Dummy")), GetUnitY(LoadUnit("Dummy")), 400, Base)
            loop
                set SysUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen SysUnit == null
                if IsUnitInGroup(SysUnit, LoadGroup("group")) == false and SysUnit!=LoadUnitHandle(HH,MUIHandle(),CasterHash) and Condition_Base(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)),SysUnit) then
                        //call BJDebugMsg("3")
                            //call BJDebugMsg("4")
                    call myCustomDamage(LoadUnitHandle(HH,MUIHandle(),CasterHash), SysUnit, dmg, false, false, null, null, null)
                    call SetControlToUnit(SysUnit,SysUnit, 3, "stun")
                    call GroupAddUnit(LoadGroup("group"), SysUnit)
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, SysUnit)
                    //call BJDebugMsg("2")
            endloop
            call GroupClear(bj_lastCreatedGroup)
            call DestroyGroup(bj_lastCreatedGroup)
        endif
        
        if time == 4. then
            call SetSpecialEffectTimeScale(LoadEffect("eff3") , 5.)
            call RemoveEffect(LoadEffect("eff3"),1,true,CreateTimer())
        endif
        
        if time < 5. then
            call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), true)
            call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), true)
        endif
        
        if time > 5. then
            call UnitApplyTimedLife(LoadUnit("Dummy"),'BTLF',0.5)
            call UnitApplyTimedLife(LoadUnit("Dummy1"),'BTLF',0.5)
            call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
            call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
            call SetSpecialEffectAlphaTimed(LoadEffect("eff") , 70 , 240 , 255 , 255 , 5)
            call GroupClear(LoadGroup("group"))
            call DestroyGroup(LoadGroup("group"))
            call RemoveSavedHandle(HH, id, SH_eff)
            call RemoveSavedHandle(HH, id, GroupHash)
            call RemoveSavedHandle(HH, id, DummyHash)
            call RemoveSavedHandle(HH, id, Dummy1Hash)
            call RemoveSavedHandle(HH, id, SH_eff3)
            call SetUnitTimeScale(LoadUnitHandle(HH,MUIHandle(),CasterHash), 1)
            call Clear(id)
        endif
    endfunction
    
    function WendyF takes nothing returns nothing
        local integer id= (GetHandleId(GetExpiredTimer())) // INLINED!!
        local real time= LoadFloat("Time")
        local real x= LoadFloat("x")
        local real y= LoadFloat("y")
        local real x1= GetUnitX(LoadUnitHandle(HH,MUIHandle(),CasterHash))
        local real y1= GetUnitY(LoadUnitHandle(HH,MUIHandle(),CasterHash))
        local integer i= 0
        
        if time == 0. then
            if GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') > 0 then
                call SetUnitAnimation(LoadUnitHandle(HH,MUIHandle(),CasterHash), "Spell one alternate")
                set soundplay=SndN(4229) // Sound\Music\mp3Music\WendyFa.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            else
                set soundplay=SndN(4231) // Sound\Music\mp3Music\WendyF.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                call SetUnitAnimation(LoadUnitHandle(HH,MUIHandle(),CasterHash), "Spell one")
            endif
            call SetUnitTimeScale(LoadUnitHandle(HH,MUIHandle(),CasterHash), 2)
            call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), true)
            call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), true)
            call SaveInteger(HH, id, SH_id, 0)
            set EFF=AddSpecialEffect("war3mapImported\\BY_Wood_Eff_Ord_DanGe_Wav_Kuosan_1_3_0.5s.mdl", x1, y1)
            call SetSpecialEffectScale(EFF , 0.3)
            call SetSpecialEffectTimeScale(EFF , 0.5)
            call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 8)
        endif
        
        call SaveReal(HH, id, TIME_HASH, time + 0.01)
        
        if time == 0.1 then
            set EFF=AddSpecialEffect("war3mapImported\\BY_Wood_Eff_Ord_DanGe_Wav_Kuosan_1_3_0.5s.mdl", x, y)
            call SetSpecialEffectScale(EFF , 0.5)
            call SetSpecialEffectTimeScale(EFF , 0.5)
            call SetSpecialEffectAlphaTimed(EFF , 70 , 230 , 255 , 255 , 8)
            set EFF=AddSpecialEffect("war3mapImported\\3shadowassault(lightzi)waveblue.mdl", x, y)
            call SetSpecialEffectScale(EFF , 1)
            call SetSpecialEffectTimeScale(EFF , 0.5)
            call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 2)
            set EFF=AddSpecialEffect("war3mapImported\\blue-blink.mdl", x, y)
            call SetSpecialEffectScale(EFF , 4)
            call SetSpecialEffectTimeScale(EFF , 0.5)
            call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 2)
            call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
            call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, x, y, 400, Base)
            loop
                set SysUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen SysUnit == null
                    if GetWidgetLife(SysUnit) > 0.405 and IsUnitAlly(SysUnit, GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash))) then
                        call SaveAgentHandle(HH, id, SH_Ally + LoadInt("id"), SysUnit)
                        call UnitAddAbility(SysUnit, 'WB02')
                        set EFF=AddSpecialEffect("war3mapImported\\blue-blink.mdl", GetUnitX(SysUnit), GetUnitY(SysUnit))
                        call SetSpecialEffectScale(EFF , 2)
                        call SetSpecialEffectTimeScale(EFF , 1)
                        call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 5)
                        call SaveInteger(HH, id, SH_id, LoadInt("id") + 1)
                    endif
                    call GroupRemoveUnit(bj_lastCreatedGroup, SysUnit)
            endloop
            call GroupClear(bj_lastCreatedGroup)
            call DestroyGroup(bj_lastCreatedGroup)
        endif
        
        if time > 12. then
            loop
                exitwhen i == LoadInt("id")
                call UnitRemoveAbility(LoadUnitHandle(HH, id, SH_Ally + i), 'WB02')
                call UnitRemoveAbility(LoadUnitHandle(HH, id, SH_Ally + i), 'BW01')
                call RemoveSavedHandle(HH, id, SH_Ally + i)
                set i=i + 1
            endloop
            call SetUnitTimeScale(LoadUnitHandle(HH,MUIHandle(),CasterHash), 1)
            call Clear(id)
        endif
    endfunction
    
    function WendyE takes nothing returns nothing
        local integer id= (GetHandleId(GetExpiredTimer())) // INLINED!!
        local real time= LoadFloat("Time")
        local real x= LoadFloat("x")
        local real y= LoadFloat("y")
        local real x1= GetUnitX(LoadUnitHandle(HH,MUIHandle(),CasterHash))
        local real y1= GetUnitY(LoadUnitHandle(HH,MUIHandle(),CasterHash))
        local real x2= GetUnitX(LoadUnit("Target"))
        local real y2= GetUnitY(LoadUnit("Target"))
        local real ang= Atan2(y2 - y1, x2 - x1)
        local real chp= GetUnitState(LoadUnit("Target"), UNIT_STATE_LIFE)
        local real mhp= GetUnitState(LoadUnit("Target"), UNIT_STATE_MAX_LIFE)
        local real cmp2= GetUnitState(LoadUnit("Target"), UNIT_STATE_MANA)
        local real mmp= GetUnitState(LoadUnit("Target"), UNIT_STATE_MAX_MANA)
        local integer i= 0
        
        if time == 0. then
            if GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') > 0 then
                call SetUnitAnimation(LoadUnitHandle(HH,MUIHandle(),CasterHash), "Spell one alternate")
            else
                call SetUnitAnimation(LoadUnitHandle(HH,MUIHandle(),CasterHash), "Spell one")
            endif
            set soundplay=SndN(4233) // Sound\Music\mp3Music\WendyE.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), true)
            call SetUnitTimeScale(LoadUnitHandle(HH,MUIHandle(),CasterHash), 1.1)
        endif
        
        call SaveReal(HH, id, TIME_HASH, time + 0.01)
        
        if time == 0.3 then
            set EFF=AddSpecialEffect("MC Wendy.mdx", x, y)
            call SetSpecialEffectScale(EFF , 1)
            call SetSpecialEffectZ(EFF , 250)
            call SetSpecialEffectTimeScale(EFF , 1)
            call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 2)
            call DestroyEffect(EFF)
            set EFF=AddSpecialEffect("war3mapImported\\by_wood_effect_yuanbanlin_sand2.mdx", x, y)
            call SetSpecialEffectScale(EFF , 1)
            call SetSpecialEffectTimeScale(EFF , 0.7)
            call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 9)
            call DestroyEffect(EFF)
        endif
        
        if time == 0.8 then
            call SetUnitTimeScale(LoadUnitHandle(HH,MUIHandle(),CasterHash), 2)
        endif
        
        if time < 1.1 then
            call SetUnitFacing(LoadUnitHandle(HH,MUIHandle(),CasterHash), ang * bj_RADTODEG)
        endif
        
        if time == 1.1 then
            loop
                set EFF=AddSpecialEffect("nitu.mdx", x + 100 * Cos(( i * 45 ) * bj_DEGTORAD), y + 100 * Sin(( i * 45 ) * bj_DEGTORAD))
                call SetSpecialEffectScale(EFF , 1)
                call SetSpecialEffectFacing(EFF , ( i * 45 ) + 180)
                call SetSpecialEffectTimeScale(EFF , 2)
                call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 100 , 2)
                call DestroyEffect(EFF)
                set i=i + 1
                exitwhen i == 8
            endloop
            set EFF=AddSpecialEffect("war3mapImported\\vaz_pafeathermoon_b.mdx", x, y)
            call SetSpecialEffectScale(EFF , 3)
            call SetSpecialEffectTimeScale(EFF , 0.5)
            call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 2)
            call DestroyEffect(EFF)
            set EFF=AddSpecialEffect("war3mapImported\\rasengan_eff4.mdx", x, y)
            call SetSpecialEffectScale(EFF , 1)
            call SetSpecialEffectTimeScale(EFF , 1)
            call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 2)
            call DestroyEffect(EFF)
            call SetUnitTimeScale(LoadUnitHandle(HH,MUIHandle(),CasterHash), 1)
            call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
            set EFF=AddSpecialEffect("war3mapImported\\az_airfloww11.mdx", x2, y2)
            call SaveAgentHandle(HH, id, EffectHash, EFF)
        endif
        
        if time >= 1.1 and time < 6.1 then
            call SetSpecialEffectX(LoadEffect("Effect") , x2)
            call SetSpecialEffectY(LoadEffect("Effect") , y2)
            call HealTextTag(LoadUnitHandle(HH,MUIHandle(),CasterHash),LoadUnit("Target"),(  mhp * (0.02+(0.005*GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash),'WE03') ) ) * 0.01 )*myCustomHeal2(LoadUnit("Target"),1),"HealthRes")
            call HealTextTag(LoadUnitHandle(HH,MUIHandle(),CasterHash),LoadUnit("Target"),(  mmp * (0.02+(0.005*GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash),'WE03') ) ) * 0.01 )*myCustomMana2(LoadUnit("Target"),1),"ManaRes")
            call SetUnitState(LoadUnit("Target"), UNIT_STATE_LIFE, chp + (  mhp * (0.02+(0.005*GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash),'WE03') ) ) * 0.01 ))
            call SetUnitState(LoadUnit("Target"), UNIT_STATE_MANA, cmp2 + (  mmp * (0.02+(0.005*GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash),'WE03') ) ) * 0.01 ))
            if GetWidgetLife(LoadUnit("Target"))>=mhp*0.75 then
                call UnitRemoveBuffs(LoadUnit("Target"),false,true)
            endif
        endif
        
        if time > 6.1 then
            call DestroyEffect(LoadEffect("Effect"))
            call Clear(id)
        endif
    endfunction
    
    function WendyW takes nothing returns nothing
        local integer id= (GetHandleId(GetExpiredTimer())) // INLINED!!
        local real dist= LoadFloat("dist")
        local real x1= GetUnitX(LoadUnit("Dummy1"))
        local real y1= GetUnitY(LoadUnit("Dummy1"))
        local real x2= GetUnitX(LoadUnit("Dummy2"))
        local real y2= GetUnitY(LoadUnit("Dummy2"))
        local real x3= LoadFloat("xt")
        local real y3= LoadFloat("yt")
        local real sr= SquareRoot(( x1 - x3 ) * ( x1 - x3 ) + ( y1 - y3 ) * ( y1 - y3 ))
        local real ang1= Atan2(y3 - y1, x3 - x1)
        local real ang2= Atan2(y3 - y2, x3 - x2)
        local real tick= LoadFloat("tick")
        local real dmg= ((2+GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash),'WE02'))*GetHeroInt(LoadUnitHandle(HH,MUIHandle(),CasterHash),true))
        
        if dist == 0. then
            call SetUnitTimeScale(LoadUnitHandle(HH,MUIHandle(),CasterHash), 1.)
            if GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') > 0 then
                call SetUnitAnimation(LoadUnitHandle(HH,MUIHandle(),CasterHash), "Spell two alternate")
            else
                call SetUnitAnimation(LoadUnitHandle(HH,MUIHandle(),CasterHash), "Spell two")
            endif
            set soundplay=SndN(4235) // Sound\Music\mp3Music\WendyW.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            set EFF=AddSpecialEffect("war3mapImported\\by_wood_effect_yuanbanlin_sand2.mdx", GetUnitX(LoadUnitHandle(HH,MUIHandle(),CasterHash)), GetUnitY(LoadUnitHandle(HH,MUIHandle(),CasterHash)))
            call SetSpecialEffectScale(EFF , 1)
            call SetSpecialEffectTimeScale(EFF , 0.3)
            call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 6)
        endif
        
        call SaveReal(HH, id, SH_dist, dist + 0.01)
        
        if dist < 0.5 then
            call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), true)
        endif
        
        if dist == 0.5 then
            call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
            set EFF=AddSpecialEffect("war3mapImported\\BY_Wood_Eff_Ord_DanGe_Dus_Kuosan_1_2_1.mdl", x1 + 30 * Cos(ang1 + 0.6), y1 + 30 * Sin(ang1 + 0.6))
            if GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') > 0 then
                call SetSpecialEffectScale(EFF , 1.9)
            else
                call SetSpecialEffectScale(EFF , 0.9)
            endif
            call SetSpecialEffectFacing(EFF , ( ang1 + 0.6 ) * bj_RADTODEG)
            call SetSpecialEffectTimeScale(EFF , 1)
            call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 9)
            set EFF=AddSpecialEffect("war3mapImported\\BY_Wood_Eff_Ord_DanGe_Dus_Kuosan_1_2_1.mdl", x2 + 30 * Cos(ang2 - 0.6), y2 + 30 * Sin(ang2 - 0.6))
            if GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') > 0 then
                call SetSpecialEffectScale(EFF , 1.9)
            else
                call SetSpecialEffectScale(EFF , 0.9)
            endif
            call SetSpecialEffectFacing(EFF , ( ang2 - 0.6 ) * bj_RADTODEG)
            call SetSpecialEffectTimeScale(EFF , 1)
            call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 9)
        endif
        
        if dist >= 0.5 and sr > 55 then
            call SetUnitXY_1(LoadUnit("Dummy1") , x1 + 21 * Cos(ang1 + 0.6) , y1 + 21 * Sin(ang1 + 0.6) , false)
            call SetUnitXY_1(LoadUnit("Dummy2") , x2 + 21 * Cos(ang2 - 0.6) , y2 + 21 * Sin(ang2 - 0.6) , false)
            if tick < 0.02 then
                call SaveReal(HH, id, TickHash, tick + 0.01)
            else
                call SaveReal(HH, id, TickHash, 0.)
                set EFF=AddSpecialEffect("WeatherEffect5.mdx", x1 + 50 * Cos(ang1), y1 + 50 * Sin(ang1))
                if GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') > 0 then
                    call SetSpecialEffectScale(EFF , GetRandomReal(0.9, 1.5))
                else
                    call SetSpecialEffectScale(EFF , GetRandomReal(0.5, 0.9))
                endif
                call SetSpecialEffectFacing(EFF , ( ang1 + 0.6 ) * bj_RADTODEG)
                call SetSpecialEffectZ(EFF , 140)
                call SetSpecialEffectTimeScale(EFF , 2)
                call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 6)
                set EFF=AddSpecialEffect("WeatherEffect5.mdx", x2 + 50 * Cos(ang2), y2 + 50 * Sin(ang2))
                call SetSpecialEffectScale(EFF , GetRandomReal(0.5, 0.9))
                call SetSpecialEffectFacing(EFF , ( ang2 - 0.6 ) * bj_RADTODEG)
                call SetSpecialEffectZ(EFF , 140)
                if GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') > 0 then
                    call SetSpecialEffectScale(EFF , GetRandomReal(0.9, 1.5))
                else
                    call SetSpecialEffectScale(EFF , GetRandomReal(0.5, 0.9))
                endif
                call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 6)
            endif
        else
            if dist >= 0.5 and sr <= 55 then
            set EFF=AddSpecialEffect("WeatherEffect4.mdx", x3, y3)
            if GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') > 0 then
                call SetSpecialEffectScale(EFF , 4.0)
            else
                call SetSpecialEffectScale(EFF , 2.3)
            endif
            call SetSpecialEffectFacing(EFF , ( ang1 + 0.6 ) * bj_RADTODEG)
            call SetSpecialEffectZ(EFF , 1)
            call SetSpecialEffectTimeScale(EFF , GetRandomReal(0.5, 0.8))
            call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 3)
            set EFF=AddSpecialEffect("WeatherEffect4.mdx", x3, y3)
            if GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') > 0 then
                call SetSpecialEffectScale(EFF , 2.6)
            else
                call SetSpecialEffectScale(EFF , 1.3)
            endif
            call SetSpecialEffectFacing(EFF , ( ang1 + 0.6 ) * bj_RADTODEG)
            call SetSpecialEffectZ(EFF , 1)
            call SetSpecialEffectTimeScale(EFF , GetRandomReal(0.5, 0.8))
            call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 3)
            set EFF=AddSpecialEffect("DustWave.mdx", x3, y3)
            if GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') > 0 then
                call SetSpecialEffectScale(EFF , 4.0)
            else
                call SetSpecialEffectScale(EFF , 2.4)
            endif
            call SetSpecialEffectFacing(EFF , 0)
            call SetSpecialEffectZ(EFF , 1)
            call SetSpecialEffectTimeScale(EFF , 3)
            call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 7)
            set EFF=AddSpecialEffect("DustWave.mdx", x3, y3)
            if GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') > 0 then
                call SetSpecialEffectScale(EFF , 4.2)
            else
                call SetSpecialEffectScale(EFF , 2.5)
            endif
            call SetSpecialEffectFacing(EFF , 90)
            call SetSpecialEffectZ(EFF , 1)
            call SetSpecialEffectTimeScale(EFF , 3)
            call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 7)
            set EFF=AddSpecialEffect("DustWave.mdx", x3, y3)
            if GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') > 0 then
                call SetSpecialEffectScale(EFF , 3.0)
            else
                call SetSpecialEffectScale(EFF , 1.5)
            endif
            call SetSpecialEffectFacing(EFF , 0)
            call SetSpecialEffectZ(EFF , 1)
            call SetSpecialEffectTimeScale(EFF , 3)
            call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 7)
            set EFF=AddSpecialEffect("DustWave.mdx", x3, y3)
            if GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') > 0 then
                call SetSpecialEffectScale(EFF , 3.0)
            else
                call SetSpecialEffectScale(EFF , 1.5)
            endif
            call SetSpecialEffectFacing(EFF , 90)
            call SetSpecialEffectZ(EFF , 1)
            call SetSpecialEffectTimeScale(EFF , 3)
            call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 7)
            set EFF=AddSpecialEffect("war3mapImported\\by_wood_effect_yuanbanlin_sand2.mdx", x3, y3)
            if GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') > 0 then
                call SetSpecialEffectScale(EFF , 1.2)
            else
                call SetSpecialEffectScale(EFF , 0.6)
            endif
            call SetSpecialEffectTimeScale(EFF , 0.7)
            call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 9)
            set EFF=AddSpecialEffect("war3mapImported\\by_wood_effect_yuanbanlin_sand2.mdx", x3, y3)
            call SetSpecialEffectScale(EFF , 1.2)
            if GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') > 0 then
                call SetSpecialEffectScale(EFF , 1.5)
            else
                call SetSpecialEffectScale(EFF , 0.8)
            endif
            call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 9)
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, x3, y3, 330 + ( GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') * 170 ), Base)
            loop
                set SysUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen SysUnit == null
                    if SysUnit!=LoadUnitHandle(HH,MUIHandle(),CasterHash) then
                        if Condition_Base(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)),SysUnit) then
                            if GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') > 0 then
                                call Push3(SysUnit,10,Atan2(y3-GetUnitY(SysUnit),x3-GetUnitX(SysUnit)),150,"null")
                                call myCustomDamage(LoadUnitHandle(HH,MUIHandle(),CasterHash), SysUnit, dmg + 1.5*GetHeroInt(LoadUnitHandle(HH,MUIHandle(),CasterHash),true), false, false, null, null, null)
                            else
                                call Push3(SysUnit,10,Atan2(y3-GetUnitY(SysUnit),x3-GetUnitX(SysUnit)),110,"null")
                                call myCustomDamage(LoadUnitHandle(HH,MUIHandle(),CasterHash), SysUnit, dmg, false, false, null, null, null)
                            endif
                            call GroupAddUnit(bj_lastCreatedGroup, SysUnit)
                        endif
                    endif
                    call GroupRemoveUnit(bj_lastCreatedGroup, SysUnit)
            endloop
            call GroupClear(bj_lastCreatedGroup)
            call DestroyGroup(bj_lastCreatedGroup)
            call SetUnitTimeScale(LoadUnitHandle(HH,MUIHandle(),CasterHash), 1)
            call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
            call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
            call UnitApplyTimedLife(LoadUnit("Dummy1"),'BTLF',0.5)
            call RemoveSavedHandle(HH, id, Dummy1Hash)
            call UnitApplyTimedLife(LoadUnit("Dummy2"),'BTLF',0.5)
            call RemoveSavedHandle(HH, id, Dummy2Hash)
            call Clear(id)
            endif
        endif
    endfunction

    function WendyQ takes nothing returns nothing
        local integer id= (GetHandleId(GetExpiredTimer())) // INLINED!!
        local real dist= LoadFloat("dist")
        local real x= GetUnitX(LoadUnit("Dummy"))
        local real y= GetUnitY(LoadUnit("Dummy"))
        local real ang= LoadFloat("ang")
        local real tick= LoadFloat("tick")
        local real tick2= LoadFloat("tick2")
        local real scale= LoadFloat("scale")
        local real dmg= ((1+GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash),'WE01'))*GetHeroInt(LoadUnitHandle(HH,MUIHandle(),CasterHash),true))+50
        
        if tick2 == 0. then
            if GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') > 0 then
                call SetUnitTimeScale(LoadUnitHandle(HH,MUIHandle(),CasterHash), 1.)
                call SetUnitAnimationByIndex(LoadUnitHandle(HH,MUIHandle(),CasterHash), 19) //8
                set soundplay=SndN(4237) // Sound\Music\mp3Music\WendyQa.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                call SaveReal(HH, id, SH_ti, ( 1. + ( GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') - 0.4 ) ))
            else
                call SetUnitTimeScale(LoadUnitHandle(HH,MUIHandle(),CasterHash), 1.6)
                call SetUnitAnimationByIndex(LoadUnitHandle(HH,MUIHandle(),CasterHash), 7) //8
                set soundplay=SndN(4239) // Sound\Music\mp3Music\WendyQ1.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                call SaveReal(HH, id, SH_ti, 1.)
            endif
            call SaveAgentHandle(HH, id, GroupHash, CreateGroup())
        endif
        
        if tick2 < LoadFloat("ti") then
            call SaveReal(HH, id, SH_tick2, tick2 + 0.01)
            if tick2 == 0.8 then
                set EFF=AddSpecialEffect("war3mapImported\\MC Wendy.mdx", x + 10 * Cos(ang), y + 10 * Sin(ang))
                call SetSpecialEffectScale(EFF , 0.6)
                call SetSpecialEffectFacing(EFF , ang * bj_RADTODEG + 180 - 21)
                call SetSpecialEffectZ(EFF , 150)
                call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 100 , 1)
                if GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') > 0 then
                    call SetSpecialEffectScale(EFF , 1)
                else
                    set soundplay=SndN(4241) // Sound\Music\mp3Music\WendyQ2.mp3
                    call StartSound(soundplay)
                    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                endif
            endif
            call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), true)
            call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), true)
        else
            if dist < 1 then
                set EFF=AddSpecialEffect("nitu.mdx", x, y)
                if GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') > 0 then
                    call SetSpecialEffectScale(EFF , 1.8)
                else
                    call SetSpecialEffectScale(EFF , 1)
                endif
                call SetSpecialEffectFacing(EFF , ang * bj_RADTODEG)
                call SetSpecialEffectTimeScale(EFF , 1.3)
                call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 100 , 1)
                set EFF=AddSpecialEffect("nitu.mdx", x, y)
                if GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') > 0 then
                    call SetSpecialEffectScale(EFF , 1.8)
                else
                    call SetSpecialEffectScale(EFF , 1)
                endif
                call SetSpecialEffectFacing(EFF , ang * bj_RADTODEG + 45)
                call SetSpecialEffectTimeScale(EFF , 1.3)
                call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 100 , 1)
                set EFF=AddSpecialEffect("nitu.mdx", x, y)
                if GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') > 0 then
                    call SetSpecialEffectScale(EFF , 1.8)
                else
                    call SetSpecialEffectScale(EFF , 1)
                endif
                call SetSpecialEffectFacing(EFF , ang * bj_RADTODEG - 45)
                call SetSpecialEffectTimeScale(EFF , 1.3)
                call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 100 , 1)
            endif
            if dist < ( 2100. + ( GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') * 700 ) ) then
                call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), true)
                call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), true)
                if GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') == 0 then
                    call SetUnitXY_1(LoadUnit("Dummy") , x + 25 * Cos(ang) , y + 25 * Sin(ang) , false)
                    call SaveReal(HH, id, SH_dist, dist + 25.)
                else
                    call SetUnitXY_1(LoadUnit("Dummy") , x + 40 * Cos(ang) , y + 40 * Sin(ang) , false)
                    call SaveReal(HH, id, SH_dist, dist + 40.)
                endif
                
                if tick < 0.03 + ( GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') * 0.00 ) then
                    call SaveReal(HH, id, TickHash, tick + 0.01)
                else
                    call SaveReal(HH, id, TickHash, 0.)
                    set EFF=AddSpecialEffect("WeatherEffect5.mdx", x + 50 * Cos(ang), y + 50 * Sin(ang))
                    call SetSpecialEffectFacing(EFF , ang * bj_RADTODEG)
                    call SetSpecialEffectZ(EFF , 140)
                    call SetSpecialEffectTimeScale(EFF , 0.6)
                    if GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') == 0 then
                        call SetSpecialEffectScale(EFF , 0.2 + scale)
                        call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 3)
                    else
                        call SetSpecialEffectScale(EFF , 0.5 + scale)
                        call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 2)
                    endif
                    if GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') == 0 then
                        
                        set EFF=AddSpecialEffect("war3mapImported\\File000023201.mdx", x, y)
                        call SetSpecialEffectScale(EFF , 0.3 + ( scale / 2.8 ))
                        call SetSpecialEffectZ(EFF , 60)
                        call SetSpecialEffectTimeScale(EFF , 2)
                        call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 3)
                    else
                        set EFF=AddSpecialEffect("war3mapImported\\File000023201.mdx", x, y)
                        call SetSpecialEffectScale(EFF , 0.5 + ( scale / 2.7 ))
                        call SetSpecialEffectZ(EFF , 60)
                        call SetSpecialEffectTimeScale(EFF , 2)
                        call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 2)
                    endif
                    call DestroyEffect(EFF)
                    if GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') > 0 then
                        call SaveReal(HH, id, SH_scale, scale + 0.15)
                    else
                        call SaveReal(HH, id, SH_scale, scale + 0.07)
                    endif
                endif
                set bj_lastCreatedGroup=CreateGroup()
                call GroupEnumUnitsInRange(bj_lastCreatedGroup, x, y, 120 + ( ( 60 + ( GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') * 40 ) ) * scale ), Base)
                loop
                    set SysUnit=FirstOfGroup(bj_lastCreatedGroup)
                    exitwhen SysUnit == null
                    if IsUnitInGroup(SysUnit, LoadGroup("group")) == false and SysUnit!=LoadUnitHandle(HH,MUIHandle(),CasterHash) then
                        if Condition_Base(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)),SysUnit) then
                            if GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') > 0 then
                                call myCustomDamage(LoadUnitHandle(HH,MUIHandle(),CasterHash), SysUnit, dmg + 1.5*GetHeroInt(LoadUnitHandle(HH,MUIHandle(),CasterHash),true), false, false, null, null, null)
                            else
                                call myCustomDamage(LoadUnitHandle(HH,MUIHandle(),CasterHash), SysUnit, dmg, false, false, null, null, null)
                            endif
                            call GroupAddUnit(LoadGroup("group"), SysUnit)
                        elseif IsUnitAlly(SysUnit,GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash))) then
                            if GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'WB03') > 0 then
                                call HealTextTag(LoadUnitHandle(HH,MUIHandle(),CasterHash),SysUnit,  0.50*(dmg + 1.5*GetHeroInt(LoadUnitHandle(HH,MUIHandle(),CasterHash),true))*myCustomHeal2(SysUnit,1),"HealthRes")
                                call SetUnitState(SysUnit,UNIT_STATE_LIFE,GetUnitState(SysUnit, UNIT_STATE_LIFE)+0.50*(dmg + 1.5*GetHeroInt(LoadUnitHandle(HH,MUIHandle(),CasterHash),true)))
                                //call myCustomDamage(LoadUnitHandle(HH,MUIHandle(),CasterHash), SysUnit, dmg + 1.5*GetHeroInt(LoadUnitHandle(HH,MUIHandle(),CasterHash),true), false, false, null, null, null)
                            else
                                call HealTextTag(LoadUnitHandle(HH,MUIHandle(),CasterHash),SysUnit,  0.50*dmg*myCustomHeal2(SysUnit,1),"HealthRes")
                                call SetUnitState(SysUnit,UNIT_STATE_LIFE,GetUnitState(SysUnit, UNIT_STATE_LIFE)+0.50*dmg)
                                //call myCustomDamage(LoadUnitHandle(HH,MUIHandle(),CasterHash), SysUnit, dmg, false, false, null, null, null)
                            endif
                            call GroupAddUnit(LoadGroup("group"), SysUnit)
                        endif
                    endif
                    call GroupRemoveUnit(bj_lastCreatedGroup, SysUnit)
                endloop
                call GroupClear(bj_lastCreatedGroup)
                call DestroyGroup(bj_lastCreatedGroup)
            else
                call GroupClear(LoadGroup("group"))
                call DestroyGroup(LoadGroup("group"))
                call SetUnitTimeScale(LoadUnitHandle(HH,MUIHandle(),CasterHash), 1)
                call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
                call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
                call UnitApplyTimedLife(LoadUnit("Dummy"),'BTLF',0.5)
                call RemoveSavedHandle(HH, id, DummyHash)
                call RemoveSavedHandle(HH, id, GroupHash)
                call Clear(id)
            endif
        endif
    endfunction

    function WendyCondition takes nothing returns nothing
        local integer hId= GetPlayerId(GetTriggerPlayer())
        local integer id
        local integer AID= GetSpellAbilityId()
        local real x= GetUnitX(GetTriggerUnit())
        local real y= GetUnitY(GetTriggerUnit())
        local real x1= GetSpellTargetX()
        local real y1= GetSpellTargetY()
        local real ang= Atan2(y1 - y, x1 - x)
        
        if AID == 'WE01' then
            set id=NewTimer(hId)
            set n=CreateUnit(GetTriggerPlayer(), 'cdm1', x + 30 * Cos(ang), y + 30 * Sin(ang), ang * bj_RADTODEG)
            call SaveAgentHandle(HH, id, DummyHash, n)
            call SaveAgentHandle(HH, id, CasterHash, GetTriggerUnit())
            call SaveReal(HH, id, SH_dist, 0.)
            call SaveReal(HH, id, SH_ang, ang)
            call SaveReal(HH, id, TickHash, 0.)
            call SaveReal(HH, id, SH_tick2, 0.)
            call SaveReal(HH, id, SH_scale, 0.4)
            call TimerStart(LoadTimer(hId), .01, true, function WendyQ)
        elseif AID == 'WE02' then
            set id=NewTimer(hId)
            set n=CreateUnit(GetTriggerPlayer(), 'cdm1', x + 70 * Cos(ang + ( 90 * bj_DEGTORAD )), y + 70 * Sin(ang + ( 90 * bj_DEGTORAD )), ang * bj_RADTODEG)
            call SaveAgentHandle(HH, id, Dummy1Hash, n)
            set n=CreateUnit(GetTriggerPlayer(), 'cdm1', x + 70 * Cos(ang - ( 90 * bj_DEGTORAD )), y + 70 * Sin(ang - ( 90 * bj_DEGTORAD )), ang * bj_RADTODEG)
            call SaveAgentHandle(HH, id, Dummy2Hash, n)
            call SaveAgentHandle(HH, id, CasterHash, GetTriggerUnit())
            call SaveReal(HH, id, SH_dist, 0.)
            call SaveReal(HH, id, TickHash, 0.)
            call SaveReal(HH, id, SH_ang, ang)
            call SaveReal(HH, id, SH_xt, x1)
            call SaveReal(HH, id, SH_yt, y1)
            call SaveReal(HH, id, SH_scale, 0.4)
            call TimerStart(LoadTimer(hId), .01, true, function WendyW)
        elseif AID == 'WE03' then
            set id=NewTimer(hId)
            call SaveAgentHandle(HH, id, CasterHash, GetTriggerUnit())
            call SaveAgentHandle(HH, id, TargetHash, GetSpellTargetUnit())
            call SaveReal(HH, id, SH_x, x)
            call SaveReal(HH, id, SH_y, y)
            call SaveReal(HH, id, TIME_HASH, 0.)
            call TimerStart(LoadTimer(hId), .01, true, function WendyE)
        elseif AID == 'WE04' then
            set id=NewTimer(hId)
            call SaveAgentHandle(HH, id, CasterHash, GetTriggerUnit())
            call SaveReal(HH, id, SH_x, x1)
            call SaveReal(HH, id, SH_y, y1)
            call SaveReal(HH, id, TIME_HASH, 0.)
            call TimerStart(LoadTimer(hId), .01, true, function WendyF)
        elseif AID == 'WE05' then
            set id=NewTimer(hId)
            call SaveAgentHandle(HH, id, CasterHash, GetTriggerUnit())
            call SaveReal(HH, id, SH_x, x1)
            call SaveReal(HH, id, SH_y, y1)
            call SaveReal(HH, id, TIME_HASH, 0.)
            call SaveReal(HH, id, SH_ang, ang)
            call TimerStart(LoadTimer(hId), .01, true, function WendyR)
        elseif AID == 'WE06' then
            set id=NewTimer(hId)
            call SaveAgentHandle(HH, id, CasterHash, GetTriggerUnit())
            call SaveReal(HH, id, TIME_HASH, 0.)
            call TimerStart(LoadTimer(hId), .01, true, function WendyT)
        elseif AID == 'WE07' then
            set id=NewTimer(hId)
            call SaveAgentHandle(HH, id, CasterHash, GetTriggerUnit())
            call SaveReal(HH, id, SH_x, x1)
            call SaveReal(HH, id, SH_y, y1)
            call SaveReal(HH, id, TIME_HASH, 0.)
            call SaveReal(HH, id, SH_ang, ang)
            call TimerStart(LoadTimer(hId), .04, true, function WendyT2)
        elseif AID == 'WE08' then
            set id=NewTimer(hId)
            call SaveAgentHandle(HH, id, CasterHash, GetTriggerUnit())
            call SaveReal(HH, id, SH_x, x1)
            call SaveReal(HH, id, SH_y, y1)
            call SaveReal(HH, id, TIME_HASH, 0.)
            call SaveReal(HH, id, SH_ang, ang)
            call TimerStart(LoadTimer(hId), .01, true, function WendyE2)
        endif
    endfunction 

    function GintokiQ takes nothing returns nothing
        local integer id= (GetHandleId(GetExpiredTimer())) // INLINED!!
        local real dist= LoadFloat("dist")
        local real x1= LoadFloat("x")
        local real y1= LoadFloat("y")        
        local real x2= LoadFloat("xt")
        local real y2= LoadFloat("yt")
        local real sr= SquareRoot(( x2 - x1 ) * ( x2 - x1 ) + ( y2 - y1 ) * ( y2 - y1 ))
        local real ang= LoadFloat("ang")
        local real time3= LoadFloat("time3")
        local real time2= LoadFloat("time2")
        local real scale= LoadFloat("scale")
        local integer lvl=GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash),'GIQ0')
        local real dmg= ((2+lvl)*GetHeroAgi(LoadUnitHandle(HH,MUIHandle(),CasterHash),true))
        local integer i= 0
        
        if time2 == 0. then
            call SetUnitTimeScale(LoadUnitHandle(HH,MUIHandle(),CasterHash), 4)
            call SetUnitAnimationByIndex(LoadUnitHandle(HH,MUIHandle(),CasterHash), 16) //8
            call SaveReal(HH, id, SH_ti, 1.)
            call SaveAgentHandle(HH, id, GroupHash, CreateGroup())
            call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), true)
            call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), true)
        endif
        call SaveReal(HH, id, SH_time2, time2 + 0.01)
        if time2 == 0.25 then
            set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)), 'gT00', x1 + 10 * Cos(ang), y1 + 10 * Sin(ang), ang * bj_RADTODEG)
            call SaveAgentHandle(HH, id, DummyHash, n)
            set soundplay=SndN(4243) // Sound\Music\mp3Music\[ANP]SakataGintokiR01.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        endif
        if time2==0.35 then
            call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
            call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
            call SetUnitTimeScale(LoadUnitHandle(HH,MUIHandle(),CasterHash), 1)
        endif
        if time2>0.25 then
            if time3==1 and time2>0.35 then
                call Clear(id)
            endif
            if SquareRoot(( GetUnitX(LoadUnit("Dummy")) - x2 ) * ( GetUnitX(LoadUnit("Dummy")) - x2 ) + ( GetUnitY(LoadUnit("Dummy")) - y2 ) * ( GetUnitY(LoadUnit("Dummy")) - y2 )) > 65 and udg_B==true and DU2==true then
                call SaveReal(HH, id, SH_dist, dist + 7)
                call SetUnitXY_1(LoadUnit("Dummy") , GetUnitX(LoadUnit("Dummy")) + 10 * Cos(ang) , GetUnitY(LoadUnit("Dummy")) + 10 * Sin(ang) , false)
                call SetUnitFlyHeight(LoadUnit("Dummy"),ParabolaZ(500,sr-30,sr-30-dist)+150,0)
            elseif time3==0 or udg_B==false then
                set soundplay=SndN(4245) // Sound\Music\mp3Music\[ANP]SakataGintokiR02.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                set bj_lastCreatedGroup=CreateGroup()
                call GroupEnumUnitsInRange(bj_lastCreatedGroup, x2, y2, 550, Base)
                loop
                set SysUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen SysUnit == null
                    if SysUnit!=LoadUnitHandle(HH,MUIHandle(),CasterHash) then
                        if Condition_Base(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)),SysUnit) and udg_B==true and DU2==true then
                            call myCustomDamage(LoadUnitHandle(HH,MUIHandle(),CasterHash), SysUnit, dmg, false, false, null, null, null)
                            call SetControlToUnit(SysUnit,SysUnit,2,"stun")
                        endif
                    endif
                    call GroupRemoveUnit(bj_lastCreatedGroup, SysUnit)
                endloop
                call GroupClear(bj_lastCreatedGroup)
                call DestroyGroup(bj_lastCreatedGroup)
                set EFF=AddSpecialEffect("[ANP]NewMassiveEX.mdl", x2, y2)
                call SetSpecialEffectScale(EFF , 2)
                call DestroyEffect(EFF)
                call UnitApplyTimedLife(LoadUnit("Dummy"),'BTLF',0.1)
                call RemoveSavedHandle(HH, id, DummyHash)
                call SaveReal(HH, id, SH_time3, 1)
            endif
        endif
    endfunction

    function GintokiW takes nothing returns nothing
        local integer id= (GetHandleId(GetExpiredTimer())) // INLINED!!
        local real x= GetUnitX(LoadUnitHandle(HH,MUIHandle(),CasterHash))
        local real y= GetUnitY(LoadUnitHandle(HH,MUIHandle(),CasterHash))
        local real time= LoadFloat("Time")
        local real dmg= ((3+GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash),'GIW0'))*GetHeroAgi(LoadUnitHandle(HH,MUIHandle(),CasterHash),true))
        
        if time == 0 then
            call SetUnitAnimationByIndex(LoadUnitHandle(HH,MUIHandle(),CasterHash), 29)
            set soundplay=SndN(4247) // Sound\Music\mp3Music\[ANP]SakataGintokiE1.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), true)
            call SaveAgentHandle(HH, id, GroupHash, CreateGroup())
        endif
        if time == 0.2 then
            set soundplay=SndN(4249) // Sound\Music\mp3Music\GintokiW2.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            set EFF=AddSpecialEffect("war3mapImported\\fireworkswhite.mdx", x, y)
            call SetSpecialEffectZ(EFF , 360)
            call SetSpecialEffectVertexColour(EFF , GetRandomInt(50,255) , GetRandomInt(50,255) , GetRandomInt(50,255) , 250)
            call DestroyEffect(EFF)
        endif
        if time == 0.4 then
            set EFF = AddSpecialEffect("war3mapImported\\DustWave.mdx",x,y)
            call SetSpecialEffectScale(EFF , 1.5)
            call SetSpecialEffectFacing(EFF , GetRandomReal(0,359))
            call DestroyEffect(EFF)
            call GroupEnumUnitsInRange(LoadGroup("group"), x, y, 400, Base)
            set idg=GetHandleId(LoadGroup("group"))
            loop
            set SysUnit=FirstOfGroup(LoadGroup("group"))
            set ide=GetHandleId(SysUnit)
            exitwhen SysUnit == null
                if Condition_Base(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)),SysUnit) and SysUnit!=LoadUnitHandle(HH,idg,ide) then
                    call SaveUnitHandle(HH,idg,ide,SysUnit)
                    call Push3(SysUnit,50,Atan2(GetUnitY(SysUnit)-y,GetUnitX(SysUnit)-x),300,"null")
                    call myCustomDamage(LoadUnitHandle(HH,MUIHandle(),CasterHash), SysUnit, dmg, false, false, null, null, null)
                    call SetControlToUnit(SysUnit,SysUnit,2.0,"stun")
                    call SlowUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash),SysUnit,0.5,0.,5,2,false)
                endif
                call GroupRemoveUnit(LoadGroup("group"), SysUnit)
            endloop
            call GroupEnumUnitsInRange(G, x, y, 500+100*GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash),'GIW0'), Base)
            loop
            set E=FirstOfGroup(G)
            exitwhen E==null
                if IsUnitAlly(E,GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash))) then
                    call UnitAddAbility(E,'GIW1')
                    call SetUnitAbilityLevel(E,'GIW1',GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash),'GIW0'))
                    call UnitRemoveAbilityTimedPause(E,'GIW1',10)
                endif
                call GroupRemoveUnit(G, E)
            endloop
        endif
        call SaveReal(HH, id, TIME_HASH, time + 0.01)
        if time == 0.7 then
            call SetUnitAnimation(LoadUnitHandle(HH,MUIHandle(),CasterHash),"Stand")
            call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
            call GroupClear(LoadGroup("group"))
            call DestroyGroup(LoadGroup("group"))
            call RemoveSavedHandle(HH, id, GroupHash)
            call Clear(id)
            call Clear(idg)
        endif
        

    endfunction

    function GintokiE takes nothing returns nothing
        local integer id= (GetHandleId(GetExpiredTimer())) // INLINED!!
        local real x= GetUnitX(LoadUnitHandle(HH,MUIHandle(),CasterHash))
        local real y= GetUnitY(LoadUnitHandle(HH,MUIHandle(),CasterHash))
        local real ang= GetUnitFacing(LoadUnitHandle(HH,MUIHandle(),CasterHash))*bj_DEGTORAD
        local real time= LoadFloat("Time")
        local real tick= LoadFloat("tick")
        local integer ic=GetHandleId(LoadUnitHandle(HH,MUIHandle(),CasterHash))
        local real dmg= GetHeroAgi(LoadUnitHandle(HH,MUIHandle(),CasterHash),true)
        local trigger t=LoadTriggerHandle(HH,id,1)
        
        if time==0 then
            call UnitAddType(LoadUnitHandle(HH,MUIHandle(),CasterHash),UNIT_TYPE_FLYING)
            call SetUnitPathing(LoadUnitHandle(HH,MUIHandle(),CasterHash),false)
            call SaveReal(HH,ic,SH_GinAnge,ang)
            call SetAbilityCastPoint(GetUnitAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'A0UZ'), 2)
            call SetAbilityCastPoint(GetUnitAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'GIQ0'), 2)
            call SetAbilityCastPoint(GetUnitAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'GIT0'), 2)
            call StartAbilityCooldown(GetUnitAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash),'GIE1'), 0.2)
            call TriggerRegisterUnitEvent(t,LoadUnitHandle(HH,MUIHandle(),CasterHash),EVENT_UNIT_ISSUED_TARGET_ORDER)
            call TriggerRegisterUnitEvent(t,LoadUnitHandle(HH,MUIHandle(),CasterHash),EVENT_UNIT_ISSUED_POINT_ORDER)
            call TriggerAddAction(t,function GintokiBikeStopOrders)
            call UnitAddAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash),'A1FU')
            call UnitAddAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash),'Pet1')
            call SetUnitAcquireRange(LoadUnitHandle(HH,MUIHandle(),CasterHash),51)
            call SetUnitAnimation(LoadUnitHandle(HH,MUIHandle(),CasterHash),"Spell Throw One")
            set soundplay=SndN(4251) // Sound\Music\mp3Music\[ANP]SakataGintokiT1.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), true)
            call SetPlayerAbilityAvailable(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)), 'GIE0', false)
            call UnitAddAbilityTimed3(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'GIE1',0.5)
            call SetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'GIE1',GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'GIE0'))
        endif
        if time<7 then
            call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), true)
            call SaveReal(HH, id, TIME_HASH, time + 0.01)
            if BikeData == 0 then
                call SaveReal(HH, id, TIME_HASH, 10)
            endif
            call SetUnitXY_1(LoadUnitHandle(HH,MUIHandle(),CasterHash) , x + 12 * Cos(ang) , y + 12 * Sin(ang) , true)
            if tick<0.11 then
                call SaveReal(HH, id, TickHash, tick + 0.01)
            else
                call SetUnitFacingTimed(LoadUnitHandle(HH,MUIHandle(),CasterHash),LoadReal(HH,ic,SH_GinAnge),0.02)
                set EFF=AddSpecialEffect("BY_Wood_GongChengSiPai_5.mdx", x, y)
                call SetSpecialEffectScale(EFF , 0.5)
                call SetSpecialEffectTimeScale(EFF , 1)
                call SetSpecialEffectFacing(EFF , ang  * bj_RADTODEG)
                call DestroyEffect(EFF)
                call IssueImmediateOrder(LoadUnitHandle(HH,MUIHandle(),CasterHash),"stop")
                call SaveReal(HH, id, TickHash, 0.)
                call GroupEnumUnitsInRange(G, x, y, 110, Base)
                loop
                set SysUnit=FirstOfGroup(G)
                exitwhen SysUnit == null
                    if SysUnit!=LoadUnitHandle(HH,MUIHandle(),CasterHash) then
                        if Condition_Base(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)),SysUnit) then
                            if LoadBoolean(HH,GetHandleId(SysUnit),ANTITARGET_ABILITY)==false then    
                                call myCustomDamage(LoadUnitHandle(HH,MUIHandle(),CasterHash), SysUnit, dmg, false, false, null, null, null)
                                call Push3(SysUnit,20,Atan2(GetUnitY(SysUnit)-y,GetUnitX(SysUnit)-x),60,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
                            else
                                call SaveUnitHandle(HH,GetHandleId(SysUnit),REVERSE_TARGET,LoadUnitHandle(HH,MUIHandle(),CasterHash))
                                call SetAbilityCastPoint(GetUnitAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'GIQ0'), 0.1)
                                call SetAbilityCastPoint(GetUnitAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'GIT0'), 0.15)
                                call SetAbilityCastPoint(GetUnitAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'A0UZ'), 0.01)
                                call SetUnitAcquireRange(LoadUnitHandle(HH,MUIHandle(),CasterHash),600)
                                call UnitRemoveAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash),'A1FU')
                                call UnitRemoveAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash),'Pet1')
                                call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
                                call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
                                if BikeData!=0 then
                                    call SetUnitAnimation(LoadUnitHandle(HH,MUIHandle(),CasterHash),"Spell Throw Three")
                                    call SetControlToUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash),LoadUnitHandle(HH,MUIHandle(),CasterHash),1,"stun")
                                endif
                                call UnitRemoveAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash),'B00A')
                                call SetPlayerAbilityAvailable(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)), 'GIE0', true)
                                call UnitRemoveAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'GIE1')
                                call SetUnitPathing(LoadUnitHandle(HH,MUIHandle(),CasterHash),true)
                                call UnitRemoveType(LoadUnitHandle(HH,MUIHandle(),CasterHash),UNIT_TYPE_FLYING)
                                call TriggerClearActions(t)
                                call DestroyTrigger(t)
                                call Clear(id)
                                call Clear(ic)
                                set BikeData=0
                            endif
                        endif
                    endif
                    call GroupRemoveUnit(G, SysUnit)
                endloop
                call GroupClear(G)
            endif
        endif
        if time == 1.8 then
            set soundplay=SndN(4253) // Sound\Music\mp3Music\GintokiE2.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        endif
        if time > 0.2 and time < 6 then
        call SetUnitAnimationByIndex(LoadUnitHandle(HH,MUIHandle(),CasterHash), 17) 
        endif
        if time == 5 then
            call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), true)
            set soundplay=SndN(4255) // Sound\Music\mp3Music\[ANP]SakataGintokiT3.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        endif
        if time == 6 then
        call SetUnitAnimation(LoadUnitHandle(HH,MUIHandle(),CasterHash),"Spell Throw Two")
        endif
        if time >= 7 then
            call SetAbilityCastPoint(GetUnitAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'GIQ0'), 0.1)
            call SetAbilityCastPoint(GetUnitAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'GIT0'), 0.15)
            call SetAbilityCastPoint(GetUnitAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'A0UZ'), 0.01)
            call SetUnitAcquireRange(LoadUnitHandle(HH,MUIHandle(),CasterHash),600)
            call UnitRemoveAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash),'A1FU')
            call UnitRemoveAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash),'Pet1')
            call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
            call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
            if BikeData!=0 then
                call SetUnitAnimation(LoadUnitHandle(HH,MUIHandle(),CasterHash),"Spell Throw Three")
                call SetControlToUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash),LoadUnitHandle(HH,MUIHandle(),CasterHash),1,"stun")
            endif
            call UnitRemoveAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash),'B00A')
            call SetPlayerAbilityAvailable(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)), 'GIE0', true)
            call UnitRemoveAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'GIE1')
            call SetUnitPathing(LoadUnitHandle(HH,MUIHandle(),CasterHash),true)
            call UnitRemoveType(LoadUnitHandle(HH,MUIHandle(),CasterHash),UNIT_TYPE_FLYING)
            call TriggerClearActions(t)
            call DestroyTrigger(t)
            call Clear(id)
            call Clear(ic)
            set BikeData=0
        endif
        set t=null
    endfunction

    function GintokiE2 takes nothing returns nothing
        local integer id= (GetHandleId(GetExpiredTimer()))
        local real dist= LoadFloat("dist")
        local real x= GetUnitX(LoadUnit("Dummy"))
        local real y= GetUnitY(LoadUnit("Dummy"))
        local real ang= LoadFloat("ang")
        local real time= LoadFloat("Time")
        local real tick= LoadFloat("tick")
        local real dmg= ((3+GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash),'GIE0'))*GetHeroAgi(LoadUnitHandle(HH,MUIHandle(),CasterHash),true))
        
        if time==0 then
            set soundplay=SndN(4257) // Sound\Music\mp3Music\[ANP]SakataGintokiT2.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            set BikeData=0
            set EFF=AddSpecialEffect("BY_Wood_GongChengSiPai_5.mdx", x, y)
            call SetSpecialEffectScale(EFF , 1.4)
            call SetSpecialEffectTimeScale(EFF , 1)
            call SetSpecialEffectFacing(EFF , ang  * bj_RADTODEG)
            call SetSpecialEffectZ(EFF , 50)
            call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 200 , 5)
            call DestroyEffect(EFF)
            
        endif
        call SaveReal(HH, id, TIME_HASH, time + 0.01)
        if time==0.2 then
            call SetUnitAnimation(LoadUnit("Dummy"),"Spell Alternate")
            call SetUnitAnimation(LoadUnitHandle(HH,MUIHandle(),CasterHash),"Spell Alternateex")
        endif
        if dist <= 1000 then //and UnitIsAlive(LoadUnit("Dummy"))
            call SaveReal(HH, id, SH_dist, dist + 14)
            call SetUnitXY_1(LoadUnit("Dummy") , x + 14 * Cos(ang) , y + 14 * Sin(ang) , true)
            if tick<0.06 then
                call SaveReal(HH, id, TickHash, tick + 0.01)
            else
                set EFF=AddSpecialEffect("BY_Wood_GongChengSiPai_5.mdx", x, y)
                call SetSpecialEffectScale(EFF , 0.5)
                call SetSpecialEffectTimeScale(EFF , 1)
                call SetSpecialEffectFacing(EFF , ang  * bj_RADTODEG)
                call DestroyEffect(EFF)
            endif
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, x, y, 120, Base)
            loop
                set SysUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen SysUnit == null
                if Condition_Base(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)),SysUnit) then
                    call SaveReal(HH, id, SH_dist, dist+600)
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, SysUnit)
            endloop
            call GroupClear(bj_lastCreatedGroup)
            call DestroyGroup(bj_lastCreatedGroup)
        else
            call UnitApplyTimedLife(LoadUnit("Dummy"),'BTLF',0.1)
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, x, y, 300, Base)
            loop
                set SysUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen SysUnit == null
                if Condition_Base(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)),SysUnit) then
                    call myCustomDamage(LoadUnitHandle(HH,MUIHandle(),CasterHash), SysUnit, dmg, false, false, null, null, null)
                    call SetControlToUnit(SysUnit,SysUnit,2,"stun")
                    call GroupAddUnit(bj_lastCreatedGroup, SysUnit)
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, SysUnit)
            endloop
            set EFF=AddSpecialEffect("[ANP]NewMassiveEX.mdl", x, y)
            call DestroyEffect(EFF)
            call GroupClear(bj_lastCreatedGroup)
            call DestroyGroup(bj_lastCreatedGroup)
            call Clear(id)
        endif
    endfunction

    function GintokiF takes nothing returns nothing
        local integer id= (GetHandleId(GetExpiredTimer())) // INLINED!!
        local real x= GetUnitX(LoadUnitHandle(HH,MUIHandle(),CasterHash))
        local real y= GetUnitY(LoadUnitHandle(HH,MUIHandle(),CasterHash))
        local real x1= GetUnitX(LoadUnit("Dummy1"))
        local real y1= GetUnitY(LoadUnit("Dummy1"))
        local real x2= GetUnitX(LoadUnit("Dummy2"))
        local real y2= GetUnitY(LoadUnit("Dummy2"))
        local real ang= LoadFloat("ang")
        local real time= LoadFloat("Time")
        local real tick= LoadFloat("tick")
        local real dist= LoadFloat("dist")
        local real dmg= 1*GetHeroAgi(LoadUnitHandle(HH,MUIHandle(),CasterHash),true)
        
        if time == 0 then
            call SetUnitAnimationByIndex(LoadUnitHandle(HH,MUIHandle(),CasterHash), 29)
            set soundplay=SndN(4259) // Sound\Music\mp3Music\[ANP]SakataGintokiE01.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        endif
        if GinTData == 0 then
            if time < 9.65 then
                if dist<=200 then
                    if dist>180 then
                        call SaveReal(HH, id, SH_dist, (dist + 4.13)*1.08)
                    else
                        call SaveReal(HH, id, SH_dist, (dist + 2.13)*1.07)
                    endif
                else
                    if dist>200 and dist<=220 then
                        call SaveReal(HH, id, SH_dist, (dist - 0.5) / 1.005)
                    else
                        call SaveReal(HH, id, SH_dist, (dist - 3.13) / 1.03)
                    endif
                endif
            endif
        else
            if time < 9.65 then
                if dist<=400 then
                    if dist>350 then
                        call SaveReal(HH, id, SH_dist, (dist + 4.13)*1.09)
                    else
                        call SaveReal(HH, id, SH_dist, (dist + 2.13)*1.05)
                    endif
                else
                    if dist>400 and dist<=420 then
                        call SaveReal(HH, id, SH_dist, (dist - 0.5) / 1.005)
                    else
                        call SaveReal(HH, id, SH_dist, (dist - 3.13) / 1.03)
                    endif
                endif
            endif
        endif
        call SaveReal(HH, id, SH_ang, ang + (dist / 120) * bj_DEGTORAD)
        call SetUnitXY_1(LoadUnit("Dummy1") , x - dist * Cos(Atan2(y - ( y1 + 45 * Sin(ang) ), x - ( x1 + 45 * Cos(ang) ))) , y - dist * Sin(Atan2(y - ( y1 + 45 * Sin(ang) ), x - ( x1 + 45 * Cos(ang) ))) , false)
        call SetUnitXY_1(LoadUnit("Dummy2") , x - dist * Cos(Atan2(y - ( y2 + 45 * Sin(ang- ( 180 * bj_DEGTORAD )) ), x - ( x2 + 45 * Cos(ang- ( 180 * bj_DEGTORAD )) ))) , y - dist * Sin(Atan2(y - ( y2 + 45 * Sin(ang- ( 180 * bj_DEGTORAD )) ), x - ( x2 + 45 * Cos(ang- ( 180 * bj_DEGTORAD )) ))) , false)
        if time < 10 then
            if tick<0.1 then
                call SaveReal(HH, id, TickHash, tick + 0.01)
            else
                call SaveReal(HH, id, TickHash, 0)
                call GroupEnumUnitsInRange(G, x1, y1, 120+GinTData*60, Base)
                loop
                set SysUnit=FirstOfGroup(G)
                exitwhen SysUnit == null
                    if SysUnit!=LoadUnitHandle(HH,MUIHandle(),CasterHash) then
                        if Condition_Base(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)),SysUnit) then
                            call myCustomDamage(LoadUnitHandle(HH,MUIHandle(),CasterHash), SysUnit, dmg, false, false, null, null, null)
                            call SetControlToUnit(SysUnit,SysUnit,0.15,"stun")
                            call GroupAddUnit(G, SysUnit)
                        endif
                    endif
                    call GroupRemoveUnit(G, SysUnit)
                endloop
                call GroupClear(G)
                call GroupEnumUnitsInRange(G1, x2, y2, 120+GinTData*60, Base)
                loop
                set SysUnit=FirstOfGroup(G1)
                exitwhen SysUnit == null
                    if SysUnit!=LoadUnitHandle(HH,MUIHandle(),CasterHash) then
                        if Condition_Base(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)),SysUnit) then
                            call myCustomDamage(LoadUnitHandle(HH,MUIHandle(),CasterHash), SysUnit, dmg, false, false, null, null, null)
                            call SetControlToUnit(SysUnit,SysUnit,0.15,"stun")
                            call GroupAddUnit(G1, SysUnit)
                        endif
                    endif
                    call GroupRemoveUnit(G1, SysUnit)
                endloop
                call GroupClear(G1)
            endif
        endif
        call SaveReal(HH, id, TIME_HASH, time + 0.01)
        if IsUnitAlive(LoadUnitHandle(HH,MUIHandle(),CasterHash))==false then
        call SaveReal(HH, id, TIME_HASH, time + 10)
        endif
        if time >= 9.65 and dist>15 then
            call SaveReal(HH, id, SH_dist, (dist - 1.23) / 1.05)
        else
            if time >= 9.65 and dist<=15 then
                call UnitApplyTimedLife(LoadUnit("Dummy1"),'BTLF',0.1)
                call RemoveSavedHandle(HH, id, Dummy1Hash)
                call UnitApplyTimedLife(LoadUnit("Dummy2"),'BTLF',0.1)
                call RemoveSavedHandle(HH, id, Dummy2Hash)
                call Clear(id)
            endif
        endif       
    endfunction

    function GintokiT takes nothing returns nothing
        local integer id= (GetHandleId(GetExpiredTimer())) // INLINED!!
        local real dist= LoadFloat("dist")
        local real x1= GetUnitX(LoadUnitHandle(HH,MUIHandle(),CasterHash))
        local real y1= GetUnitY(LoadUnitHandle(HH,MUIHandle(),CasterHash))     
        local real x2= LoadFloat("xt")
        local real y2= LoadFloat("yt")
        local real sr= SquareRoot(( x2 - x1 ) * ( x2 - x1 ) + ( y2 - y1 ) * ( y2 - y1 ))
        local real ang= LoadFloat("ang")
        local real time= LoadFloat("Time")
        local real tick= LoadFloat("tick")
        local real dmg= 0.225*GetHeroAgi(LoadUnitHandle(HH,MUIHandle(),CasterHash),true)
        local real dmg2= 6*GetHeroAgi(LoadUnitHandle(HH,MUIHandle(),CasterHash),true)
        local integer i= 0
        call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), true)
        call UnitRemoveAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash),'A2VJ')
        if time == 0. then
            call SetUnitTimeScale(LoadUnitHandle(HH,MUIHandle(),CasterHash), 1)
            call SaveReal(HH, id, SH_ti, 1.)
            call SaveAgentHandle(HH, id, GroupHash, CreateGroup())
            call SaveAgentHandle(HH, id, SH_group1, CreateGroup())
            call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), true)
            call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), true)
            set GinTData=1
            set soundplay=SndN(4261) // Sound\Music\mp3Music\GintokiT.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        endif
        if time == 0.3 then
            call SetUnitAnimationByIndex(LoadUnitHandle(HH,MUIHandle(),CasterHash), 24)
        endif
        if time > 0.3 and time <= 2.31 then
            call SetUnitXY_1(LoadUnitHandle(HH,MUIHandle(),CasterHash) , x1 + 8 * Cos(ang) , y1 + 8 * Sin(ang) , false)
            if tick<0.05 then
                call SaveReal(HH, id, TickHash, tick + 0.01)
            else
                if time< 2.2 then
                    set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)),'e21F',x1-3*Cos(ang),y1-3*Sin(ang),ang*bj_RADTODEG)
                    call SetUnitAnimationByIndex(n, 24)
                    call SetUnitTimeScale(n,0)
                    call UnitApplyTimedLife(n,'BTLF',0.5)
                    call ShikiCloneEffect(n,2.5,0.75,0.85,150)
                    set soundplay=SndN(4263) // Sound\Music\mp3Music\GintokiT3.mp3
                    call StartSound(soundplay)
                    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                endif
                call SaveReal(HH, id, TickHash, 0)
                set EFF=AddSpecialEffect("AZ_PA_C.mdx", x1 + GetRandomReal(90,120) * Cos(ang), y1 + GetRandomReal(90,120) * Sin(ang))
                call SetSpecialEffectScale(EFF , GetRandomReal(1.7,2.5))
                call SetSpecialEffectTimeScale(EFF , 0.5)
                call SetSpecialEffectZ(EFF , GetRandomReal(60,160))
                call SetSpecialEffectOrientation(EFF , ang  * bj_RADTODEG+GetRandomReal(-80,80),GetRandomReal(-45,45),GetRandomReal(-45,45))
                call SetSpecialEffectVertexColour(EFF , 190 , 255 , 150 , 120)
                call DestroyEffect(EFF)
                call GroupEnumUnitsInRange(LoadGroup("group1"), x1 + 110 * Cos(ang), y1 + 110 * Sin(ang), 350, Base)
                loop
                set SysUnit=FirstOfGroup(LoadGroup("group1"))
                exitwhen SysUnit == null
                    if SysUnit!=LoadUnitHandle(HH,MUIHandle(),CasterHash) then
                        if Condition_Base(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)),SysUnit) then
                            if LoadBoolean(HH,GetHandleId(SysUnit),ANTITARGET_ABILITY)==false then        
                                if SR(GetUnitX(SysUnit),GetUnitY(SysUnit),x1+110*Cos(ang),y1+110*Sin(ang))<240 then
                                    call Push3(SysUnit,30,ang,45,"")
                                else
                                    call Push3(SysUnit,15,ang,25,"")
                                endif
                                call myCustomDamage(LoadUnitHandle(HH,MUIHandle(),CasterHash), SysUnit, dmg, false, false, null, null, null)
                                call SetControlToUnit(SysUnit,SysUnit,0.32,"heavystun")
                                call EffectToRandomBone("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",SysUnit)
                            else
                                call SaveUnitHandle(HH,GetHandleId(SysUnit),REVERSE_TARGET,LoadUnitHandle(HH,MUIHandle(),CasterHash))
                                call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
                                call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
                                call SetUnitTimeScale(LoadUnitHandle(HH,MUIHandle(),CasterHash), 1)
                                call GroupClear(LoadGroup("group"))
                                call DestroyGroup(LoadGroup("group"))
                                call RemoveSavedHandle(HH, id, GroupHash)
                                call GroupClear(LoadGroup("group1"))
                                call DestroyGroup(LoadGroup("group1"))
                                call RemoveSavedHandle(HH, id, SH_group1)
                                set GinTData=0
                                call Clear(id)
                            endif
                        endif
                    endif
                    call GroupRemoveUnit(LoadGroup("group1"), SysUnit)
                endloop
                call GroupClear(LoadGroup("group1"))
            endif
        endif
        if time==2.34 then
            call SetUnitAnimationByIndex(LoadUnitHandle(HH,MUIHandle(),CasterHash), 27)
            call GroupEnumUnitsInRange(LoadGroup("group1"), x1+ 110* Cos(ang), y1+ 110* Sin(ang), 550, Base)
            loop
                set SysUnit=FirstOfGroup(LoadGroup("group1"))
                exitwhen SysUnit == null
                    if SysUnit!=LoadUnitHandle(HH,MUIHandle(),CasterHash) then
                        if Condition_Base(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)),SysUnit) then
                            call PauseUnit(SysUnit,true)
                            call SaveBoolean(HH,GetHandleId(SysUnit),TARGET_ABILITY,true)
                            call GroupAddUnit(LoadGroup("group"), SysUnit)
                            call Push3(SysUnit,50,ang,150,"")
                        endif
                    endif
                    call GroupRemoveUnit(LoadGroup("group1"), SysUnit)
            endloop
            call GroupClear(LoadGroup("group1"))
            call Push5(LoadUnitHandle(HH,MUIHandle(),CasterHash),30,ang- ( 180 * bj_DEGTORAD ),450,"")
        endif
        if time==3 then
            call Push3(LoadUnitHandle(HH,MUIHandle(),CasterHash),150,ang,750,"")
            call SetUnitAnimationByIndex(LoadUnitHandle(HH,MUIHandle(),CasterHash), 25)
        endif
        if time==3.1 then
            set EFF=AddSpecialEffect("BY_Wood_GongChengSiPai_5.mdx", x1 - 400 * Cos(ang), y1 - 400 * Sin(ang))
            call SetSpecialEffectScale(EFF , 1)
            call SetSpecialEffectTimeScale(EFF , 0.8)
            call SetSpecialEffectFacing(EFF , ang  * bj_RADTODEG)
            call DestroyEffect(EFF)
        endif
        if time==3.2 then
            call SetUnitAnimationByIndex(LoadUnitHandle(HH,MUIHandle(),CasterHash), 26)
        endif
        if time==3.3 then
            set EFF=AddSpecialEffect("BY_Wood_GongChengSiPai_5.mdx", x1 - 400 * Cos(ang), y1 - 400 * Sin(ang))
            call SetSpecialEffectScale(EFF , 1)
            call SetSpecialEffectTimeScale(EFF , 0.8)
            call SetSpecialEffectFacing(EFF , ang  * bj_RADTODEG)
            call DestroyEffect(EFF)
            call SetUnitFacingInstant(LoadUnitHandle(HH,MUIHandle(),CasterHash) , ang)
        endif
        if time > 3 and time <3.5  then
            if tick<0.02 then
                call SaveReal(HH, id, TickHash, tick + 0.01)
            else
                set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)),'e21F',x1-3*Cos(ang),y1-3*Sin(ang),ang*bj_RADTODEG)
                call SetUnitAnimationByIndex(n, 25)
                call SetUnitTimeScale(n,0)
                call UnitApplyTimedLife(n,'BTLF',0.5)
                call ShikiCloneEffect(n,2.5,0.75,0.85,150)
                call SaveReal(HH, id, TickHash, 0)
            endif
        endif
        if time==3.5 then
            set soundplay=SndN(4265) // Sound\Music\mp3Music\GintokiT2.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            set EFF=AddSpecialEffect("AZ_PA_C.mdx", x1 + 100 * Cos(ang), y1 + 100 * Sin(ang))
            call SetSpecialEffectScale(EFF , 5)
            call SetSpecialEffectTimeScale(EFF , 0.3)
            call SetSpecialEffectFacing(EFF , ang  * bj_RADTODEG)
            call SetSpecialEffectZ(EFF , -25)
            call SetSpecialEffectVertexColour(EFF , 180 , 255 , 200 , 250)
            call DestroyEffect(EFF)
            set EFF = AddSpecialEffect("war3mapImported\\DustWave.mdx",x1, y1)
            call SetSpecialEffectFacing(EFF , GetRandomReal(0,359))
            call SetSpecialEffectTimeScale(EFF , 1.2)
            call SetSpecialEffectScale(EFF , 3.5)
            call DestroyEffect(EFF)
            set EFF = AddSpecialEffect("war3mapImported\\DustWave.mdx",x1, y1)
            call SetSpecialEffectFacing(EFF , GetRandomReal(0,359))
            call SetSpecialEffectTimeScale(EFF , 1.2)
            call SetSpecialEffectScale(EFF , 3.5)
            call DestroyEffect(EFF)
            set EFF = AddSpecialEffect("war3mapImported\\DustWave.mdx",x1, y1)
            call SetSpecialEffectFacing(EFF , GetRandomReal(0,359))
            call SetSpecialEffectTimeScale(EFF , 1.2)
            call SetSpecialEffectScale(EFF , 3.5)
            call DestroyEffect(EFF)
            set EFF = AddSpecialEffect("nitu.mdl",x1 + 500 * Cos(ang), y1 + 500 * Sin(ang))
            call SetSpecialEffectFacing(EFF , ang * bj_RADTODEG + 180)
            call SetSpecialEffectScale(EFF , 3)
            call DestroyEffect(EFF)
            call ShakeCamera(0.7,55)
            loop
            set SysUnit=FirstOfGroup(LoadGroup("group"))
            exitwhen SysUnit == null
                call PauseUnit(SysUnit,false)
                call SaveBoolean(HH,GetHandleId(SysUnit),TARGET_ABILITY,false)
                call GroupRemoveUnit(LoadGroup("group"), SysUnit)
            endloop
            call GroupEnumUnitsInRange(LoadGroup("group1"), x1+ 110* Cos(ang), y1+ 110* Sin(ang), 550, Base)
                loop
                set SysUnit=FirstOfGroup(LoadGroup("group1"))
                exitwhen SysUnit == null
                    if SysUnit!=LoadUnitHandle(HH,MUIHandle(),CasterHash) then
                        if Condition_Base(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)),SysUnit) then
                            call myCustomDamage(LoadUnitHandle(HH,MUIHandle(),CasterHash), SysUnit, dmg2, false, false, null, null, null)
                            call GroupAddUnit(LoadGroup("group1"), SysUnit)
                            call SetControlToUnit(SysUnit,SysUnit,2,"stun")
                            call Push3(SysUnit,50,ang,250,"")
                            call EffectToRandomBone("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",SysUnit)
                        endif
                    endif
                    call GroupRemoveUnit(LoadGroup("group1"), SysUnit)
                endloop
            call GroupClear(LoadGroup("group1"))
        endif
        call SaveReal(HH, id, TIME_HASH, time + 0.01)
        if time>3.84 then
            call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
            call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
            call SetUnitTimeScale(LoadUnitHandle(HH,MUIHandle(),CasterHash), 1)
            call GroupClear(LoadGroup("group"))
            call DestroyGroup(LoadGroup("group"))
            call RemoveSavedHandle(HH, id, GroupHash)
            call GroupClear(LoadGroup("group1"))
            call DestroyGroup(LoadGroup("group1"))
            call RemoveSavedHandle(HH, id, SH_group1)
            set GinTData=0
            call Clear(id)
        endif
    endfunction

    function GintokiCondition takes nothing returns nothing
        local integer hId= GetPlayerId(GetTriggerPlayer())
        local integer id
        local integer AID= GetSpellAbilityId()
        local real x= GetUnitX(GetTriggerUnit())
        local real y= GetUnitY(GetTriggerUnit())
        local real x1= GetSpellTargetX()
        local real y1= GetSpellTargetY()
        local real ang= Atan2(y1 - y, x1 - x)
        
        if AID == 'GIQ0' then
            set id=NewTimer(hId)
            call SaveAgentHandle(HH, id, CasterHash, GetTriggerUnit())
            call SaveReal(HH, id, SH_dist, 0.)
            call SaveReal(HH, id, SH_ang, ang)
            call SaveReal(HH, id, SH_x, x)
            call SaveReal(HH, id, SH_y, y)
            call SaveReal(HH, id, SH_xt, x1)
            call SaveReal(HH, id, SH_yt, y1)
            call SaveReal(HH, id, TIME_HASH, 0.)
            call SaveReal(HH, id, SH_time2, 0.)
            call SaveReal(HH, id, SH_time3, 0.)
            call TimerStart(LoadTimer(hId), .01, true, function GintokiQ)
        elseif AID == 'GIW0' then
            set id=NewTimer(hId)
            call SaveAgentHandle(HH, id, CasterHash, GetTriggerUnit())
            call SaveReal(HH, id, TIME_HASH, 0.)
            call TimerStart(LoadTimer(hId), .01, true, function GintokiW)
        elseif AID == 'GIE0' then
            set id=NewTimer(hId)
            set BikeData=id
            call SaveAgentHandle(HH, id, CasterHash, GetTriggerUnit())
            call SaveReal(HH, id, TickHash, 0.)
            call SaveReal(HH, id, TIME_HASH, 0.)
            call SaveTriggerHandle(HH,id,1,CreateTrigger())
            call TimerStart(LoadTimer(hId), .01, true, function GintokiE)
        elseif AID == 'GIE1' then
            set id=NewTimer(hId)
            set n=CreateUnit(GetTriggerPlayer(), 'e22K', x + 30 * Cos(ang), y + 30 * Sin(ang), ang * bj_RADTODEG)
            call SaveAgentHandle(HH, id, DummyHash, n)
            call SaveAgentHandle(HH, id, CasterHash, GetTriggerUnit())
            call SaveReal(HH, id, SH_ang, GetUnitFacing(GetTriggerUnit())*bj_DEGTORAD)
            call SaveReal(HH, id, SH_dist, 0.)
            call SaveReal(HH, id, TickHash, 0.)
            call SaveReal(HH, id, TIME_HASH, 0.)
            call TimerStart(LoadTimer(hId), .01, true, function GintokiE2)
        elseif AID == 'GIF0' then
            set id=NewTimer(hId)
            set n=CreateUnit(GetTriggerPlayer(), 'gT01', x, y, 0)
            call SaveAgentHandle(HH, id, Dummy1Hash, n)
            set n=CreateUnit(GetTriggerPlayer(), 'gT01', x, y, 0)
            call SaveAgentHandle(HH, id, Dummy2Hash, n)
            call SaveAgentHandle(HH, id, CasterHash, GetTriggerUnit())
            call SaveReal(HH, id, SH_ang, ang)
            call SaveReal(HH, id, SH_dist, 0.)
            call SaveReal(HH, id, TickHash, 0.)
            call SaveReal(HH, id, TIME_HASH, 0.)
            call TimerStart(LoadTimer(hId), .01, true, function GintokiF)
        elseif AID == 'GIT0' then
            set id=NewTimer(hId)
            call SaveAgentHandle(HH, id, CasterHash, GetTriggerUnit())
            call SaveReal(HH, id, SH_ang, ang)
            call SaveReal(HH, id, SH_xt, x1)
            call SaveReal(HH, id, SH_yt, y1)
            call SaveReal(HH, id, SH_dist, 0.)
            call SaveReal(HH, id, TickHash, 0.)
            call SaveReal(HH, id, SH_time3, 0.)
            call TimerStart(LoadTimer(hId), .01, true, function GintokiT)
        endif
    endfunction 

function CustomSpell takes nothing returns nothing
    call GetUnitEvent( CreateTrigger( ), EVENT_PLAYER_HERO_LEVEL,                 function Level_Event )
    call GetUnitEvent(CreateTrigger() , EVENT_PLAYER_UNIT_SPELL_EFFECT , function WendyCondition)
    call GetUnitEvent(CreateTrigger() , EVENT_PLAYER_UNIT_SPELL_EFFECT , function GintokiCondition)
        call GetUnitEvent(CreateTrigger(), EVENT_PLAYER_UNIT_SPELL_EFFECT, function SpellAct)
endfunction


function YoruichiDCast4 takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local unit caster = LoadUnitHandle(HH, id, 0)
    local real time = LoadReal(HH, GetHandleId(caster), 1125)
    local integer lvl = 0
    if GetHeroLevel(caster)>5 and GetHeroLevel(caster)<12 then
        set lvl=1
    endif
    if GetHeroLevel(caster)>=12 then
        set lvl=2
    endif
    if IsUnitAlive(caster) then
        call SaveReal(HH, GetHandleId(caster), 1125, time-0.1)
    else
        call SaveReal(HH, GetHandleId(caster), 1125, 0.2)
    endif
    if time<0 or GetUnitAbilityLevel(caster, 'YoD0')==0 or LoadInteger(HH, GetHandleId(caster), 1126)>lvl then
        call UnitRemoveAbility(caster, 'YoD1')
        call ShowAbility2('YoD0', true)
        if LoadInteger(HH, GetHandleId(caster), 1126)>lvl then
        call StartAbilityCooldown(GetUnitAbility(caster, 'YoD0'), 15)
        endif
        call SetAbilityIntegerLevelField(GetUnitAbility(caster,'YoD1'),ABILITY_ILF_MANA_COST,0,100)
        call SetAbilityIntegerLevelField(GetUnitAbility(caster,'YoD0'),ABILITY_ILF_MANA_COST,0,100)
        call DestroyEffect(LoadEffectHandle(HH, id, 3))
        call DestroyEffect(LoadEffectHandle(HH, id, 4))
        call RemoveSavedReal(HH, GetHandleId(caster), 1125)
        call RemoveSavedInteger(HH, GetHandleId(caster), 1126)
        call FlushChildHashtable(HH, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
endfunction

function YoruichiDCast3 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id = GetHandleId(t)
    local unit u=LoadUnitHandle(HH,id,0)
    local player p=GetOwningPlayer(u)
    local group g=LoadGroupHandle(HH,id,1)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=LoadReal(HH,id,2)
    local real y1=LoadReal(HH,id,3)
    local real time=LoadReal(HH,id,4)
    local real a
    call SaveReal(HH,id,4,time+0.03)
    loop
    set E2=FirstOfGroup(g)
    exitwhen Condition_Base(GetOwningPlayer(u),E2)
    if not(Condition_Base(GetOwningPlayer(u),E2)) then
        call GroupRemoveUnit(g,E2)
    endif
    endloop
    if E2!=null then
        set a=Atan2(GetUnitY(E2)-y,GetUnitX(E2)-x)
        if SR(x,y,GetUnitX(E2),GetUnitY(E2))>180 then
            call SetUnitXY_1(u,x+160*Cos(a),y+160*Sin(a),false) 
            call SetUnitFacing(u,a*bj_RADTODEG)
            call SetUnitInvulnerable(u,true)
            call PauseUnit(u,true)
            if time>0.2 then
            call SetUnitXY_1(u,GetUnitX(E2),GetUnitY(E2),false) 
            call SaveReal(HH,id,4,0)
            endif
        else
            if LoadBoolean(HH,GetHandleId(E2),ANTITARGET_ABILITY)==false then
                set n=CreateUnit(p,'e1GZ',x,y,a)
                call SetUnitModel(n,"Yoruichi.mdl")
                call SetUnitScale(n, 0.95, 0.95, 0.95)
                call ShikiCloneEffect(n,0.3,1.05,1.25,150)
                call SetUnitAnimationByIndex(n,GetRandomInt(2,4))
                call SetUnitVertexColor(n,255,255,255,125)
                call SetUnitTimeScale(n,5)
                call UnitApplyTimedLife(n,'BHwe',0.3)
                call myCustomDamage(u,E2, GetHeroAgi(u,true)*2, false, false, null, null, null)
                call SetControlToUnit(E2,E2,0.1,"stun")
                set EFF=AddSpecialEffect("HeroBladeMasterpf_E1.mdl", GetUnitX(E2),GetUnitY(E2))
                call SetSpecialEffectFacing(EFF , a  * bj_RADTODEG)
                call SetSpecialEffectScale(EFF , 1)
                call SetSpecialEffectZ(EFF , 2)
                call SetSpecialEffectTimeScale(EFF , 1.4)
                call DestroyEffect(EFF)
                call Push3(E2,50,a,100,"")
                call SaveReal(HH,id,4,0)
                call GroupRemoveUnit(g,E2)
            else
                call SaveBoolean(HH,GetHandleId(u),DASH_USER,false)
                call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,u)
                call SetUnitInvulnerable(u, false)
                call PauseUnit(u, false)
                call SetUnitVertexColor(u, 255, 255, 255, 255)
                call DestroyGroup(g)
                call FlushChildHashtable(HH, id)
                call DestroyTimer(t)
            endif    
        endif
    else
        call SetUnitVertexColor(u,255,255,255,255)
        call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x1,y1))
        call SetUnitXY_1(u,x1,y1,false) 
        call SetUnitInvulnerable(u,false)
        call PauseUnit(u,false)
        call IssueImmediateOrder(u,"stop")
        call DestroyGroup(g)
        call FlushChildHashtable(HH, id)
        call DestroyTimer(t)
    endif
    set p=null
    set g=null
    set u=null
    set t=null
endfunction

function YoruichiDCast2 takes unit u returns nothing
    local timer t = CreateTimer()
    local integer id = GetHandleId(t)
    local player p=GetOwningPlayer(u)
    local group g=CreateGroup()
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    call SaveUnitHandle(HH,id,0,u)
    call GroupEnumUnitsInRange(g,x,y,600,Base)
    call SetUnitVertexColor(u,40,40,40,40)
    call SaveGroupHandle(HH,id,1,g)
    call SaveReal(HH,id,2,x)
    call SaveReal(HH,id,3,y)
    call SaveReal(HH,id,4,0)
    call SetUnitInvulnerable(u,true)
    call PauseUnit(u,true)
    call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
    set n=CreateUnit(p,'e1GZ',x,y,GetRandomReal(0,359))
    call SetUnitModel(n,"war3mapImported\\WindCircleFaster.mdl")
    call SetUnitScale(n, 2, 2, 2)
    call UnitApplyTimedLife(n,'BHwe',3)
    if GetRandomInt(1,3)==1 then
        set soundplay=SndN(4267) // Sound\Music\mp3Music\YoruichiF.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    endif
    call TimerStart(t, 0.02, true, function YoruichiDCast3)
    set p=null
    set g=null
    set t=null
endfunction


function YoruichiDCast takes unit newCaster returns nothing
    local timer newTimer = CreateTimer()
    local integer id = GetHandleId(newTimer)
    call ShowAbility2('YoD0', false)
    call UnitAddAbility(newCaster, 'YoD1')
    call UnitMakeAbilityPermanent(newCaster, true, 'YoD1')
    call StartAbilityCooldown(GetUnitAbility(newCaster, 'YoD1'), 0.3)
    call SaveUnitHandle(HH, id, 0, newCaster)
    call SaveReal(HH, GetHandleId(newCaster), 1125, 15)
    call SaveInteger(HH, GetHandleId(newCaster), 1126, 1)
    call YoruichiDCast2(newCaster)
    set soundplay=SndN(4269) // Sound\Music\mp3Music\YoruichiShunpo.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call SetAbilityIntegerLevelField(GetUnitAbility(newCaster,'YoD1'),ABILITY_ILF_MANA_COST,0,115)
    call SetAbilityIntegerLevelField(GetUnitAbility(newCaster,'YoD0'),ABILITY_ILF_MANA_COST,0,115)
    call SaveEffectHandle(HH, id, 3, AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl", newCaster, "right foot"))
    call SaveEffectHandle(HH, id, 4, AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl", newCaster, "left foot"))
    call TimerStart(newTimer, 0.1, true, function YoruichiDCast4)
    set newTimer=null
endfunction

function YoruichiD_CalculateMana takes unit newCaster returns nothing
    local integer stack = LoadInteger(HH, GetHandleId(newCaster), 1126)
    local real manacost = 100
    local real waste = 100
    local integer i=0
    loop
    exitwhen i>=stack+1
        set waste = waste + 0.15*(waste)
        set i=i+1
    endloop
    call SaveInteger(HH, GetHandleId(newCaster), 1126, stack+1)
    call YoruichiDCast2(newCaster)

    call SetAbilityIntegerLevelField(GetUnitAbility(newCaster,'YoD1'),ABILITY_ILF_MANA_COST,0,R2I(waste))
    call SetAbilityIntegerLevelField(GetUnitAbility(newCaster,'YoD0'),ABILITY_ILF_MANA_COST,0,R2I(waste))
    set soundplay=SndN(4269) // Sound\Music\mp3Music\YoruichiShunpo.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endfunction


function YoruichiFCast2 takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local unit caster = LoadUnitHandle(HH, id, 0)
    local real time = LoadReal(HH, GetHandleId(caster), 1122)
    local integer lvl = 0
    if GetHeroLevel(caster)>5 and GetHeroLevel(caster)<12 then
        set lvl=1
    endif
    if GetHeroLevel(caster)>=12 then
        set lvl=2
    endif
    if IsUnitAlive(caster) then
    call SaveReal(HH, GetHandleId(caster), 1122, time-0.1)
    else
    call SaveReal(HH, GetHandleId(caster), 1122, 0.2)
    endif
    if time<0 or GetUnitAbilityLevel(caster, 'YoF0')==0 or LoadInteger(HH, GetHandleId(caster), 1123)>lvl then
        call UnitRemoveAbility(caster, 'YoF1')
        call ShowAbility2('YoF0', true)
        if LoadInteger(HH, GetHandleId(caster), 1123)>lvl then
        call StartAbilityCooldown(GetUnitAbility(caster, 'YoF0'), 15)
        endif
        call SetAbilityIntegerLevelField(GetUnitAbility(caster,'YoF1'),ABILITY_ILF_MANA_COST,0,80)
        call SetAbilityIntegerLevelField(GetUnitAbility(caster,'YoF0'),ABILITY_ILF_MANA_COST,0,80)
        call DestroyEffect(LoadEffectHandle(HH, id, 3))
        call DestroyEffect(LoadEffectHandle(HH, id, 4))
        call RemoveSavedReal(HH, GetHandleId(caster), 1122)
        call RemoveSavedInteger(HH, GetHandleId(caster), 1123)
        call FlushChildHashtable(HH, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
endfunction

function YoruichiFCast takes unit newCaster, real point_x, real point_y returns nothing
    local timer newTimer = CreateTimer()
    local real a=Atan2(point_y-GetUnitY(newCaster),point_x-GetUnitX(newCaster))
    local integer id = GetHandleId(newTimer)
    call ShowAbility2('YoF0', false)
    call UnitAddAbility(newCaster, 'YoF1')
    call UnitMakeAbilityPermanent(newCaster, true, 'YoF1')
    call StartAbilityCooldown(GetUnitAbility(newCaster, 'YoF1'), 0.3)
    call SaveUnitHandle(HH, id, 0, newCaster)
    call SaveReal(HH, GetHandleId(newCaster), 1122, 15)

    if SR(GetUnitX(newCaster),GetUnitY(newCaster),point_x,point_y)>600 then
        set point_x=GetUnitX(newCaster)+600*Cos(a)
        set point_y=GetUnitY(newCaster)+600*Sin(a)
    endif
    call SetAbilityIntegerLevelField(GetUnitAbility(newCaster,'YoF1'),ABILITY_ILF_MANA_COST,0,88)
    call SetAbilityIntegerLevelField(GetUnitAbility(newCaster,'YoF0'),ABILITY_ILF_MANA_COST,0,88)
    call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",GetUnitX(newCaster),GetUnitY(newCaster)))
    call SetUnitXY_1(newCaster,point_x,point_y,false)
    call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",point_x,point_y))
    call SaveInteger(HH, GetHandleId(newCaster), 1123, 1)

    set soundplay=SndN(4269) // Sound\Music\mp3Music\YoruichiShunpo.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call SaveEffectHandle(HH, id, 3, AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl", newCaster, "right foot"))
    call SaveEffectHandle(HH, id, 4, AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl", newCaster, "left foot"))
    call TimerStart(newTimer, 0.1, true, function YoruichiFCast2)
    set newTimer=null
endfunction

function YoruichiF_CalculateMana takes unit newCaster, real point_x, real point_y returns nothing
    local integer stack = LoadInteger(HH, GetHandleId(newCaster), 1123)
    local real manacost = 80
    local real waste = 80
    local real a=Atan2(point_y-GetUnitY(newCaster),point_x-GetUnitX(newCaster))
    local integer i=0
    loop
    exitwhen i>=stack+1
        set waste = waste + 0.10*(waste)
        set i=i+1
    endloop
    if SR(GetUnitX(newCaster),GetUnitY(newCaster),point_x,point_y)>500 then
        set point_x=GetUnitX(newCaster)+500*Cos(a)
        set point_y=GetUnitY(newCaster)+500*Sin(a)
    endif
    call SetAbilityIntegerLevelField(GetUnitAbility(newCaster,'YoF1'),ABILITY_ILF_MANA_COST,0,R2I(waste))
    call SetAbilityIntegerLevelField(GetUnitAbility(newCaster,'YoF0'),ABILITY_ILF_MANA_COST,0,R2I(waste))
    call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",GetUnitX(newCaster),GetUnitY(newCaster)))
    call SetUnitXY_1(newCaster,point_x,point_y,false)
    call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",point_x,point_y))
    call SaveInteger(HH, GetHandleId(newCaster), 1123, stack+1)
    set soundplay=SndN(4269) // Sound\Music\mp3Music\YoruichiShunpo.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endfunction

function YoruichiGCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(HH,id,0)
    local player p=GetOwningPlayer(u)
    local real time=LoadReal(HH,id,1)
    if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
        call SaveReal(HH,id,1,time-0.1)
    endif
    if time<0 or GetUnitAbilityLevel(u,'YoG1')==0 or udg_B==false or DU2==false then
        call UnitRemoveAbility(u,'YoG1')
        call SetHeroAgi(u,GetHeroAgi(u,false)-LoadInteger(HH,GetHandleId(u),SH_Shunko),false)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(HH,id)
    endif
    set t=null
    set u=null
    set p=null
endfunction

function YoruichiGCast takes unit u returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local integer i=GetHeroAgi(u,true)
    call SaveUnitHandle(HH,id,0,u)
    call SetHeroAgi(u,GetHeroAgi(u,false)+R2I(I2R(i)*0.2),false)
    call SaveInteger(HH,GetHandleId(u),SH_Shunko,R2I(I2R(i)*0.2))
    call UnitAddAbility(u,'YoG1')
    if GetRandomInt(0,1)==0 then
        set soundplay=SndN(4271) // Sound\Music\mp3Music\YoruichiG1.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    else
        set soundplay=SndN(4273) // Sound\Music\mp3Music\YoruichiG2.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    endif
    set EFF=AddSpecialEffect("by_wood_thundergodwrath_1_3_yellow.mdl",GetUnitX(u),GetUnitY(u))
    call SetSpecialEffectScale(EFF , 3)
    call SetSpecialEffectTimeScale(EFF , 0.7)
    call DestroyEffect(EFF)
    call SaveReal(HH,id,1,10)
    call TimerStart(t,0.1,true,function YoruichiGCast2)
    set t=null
endfunction

function YoruichiQCast3 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(HH,id,0)
    local unit c=LoadUnitHandle(HH,id,4)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real dmg=GetHeroAgi(u,true)*(1+GetUnitAbilityLevel(u,'YoQ0'))
    local real x1=GetUnitX(c)
    local real y1=GetUnitY(c)
    local real a=LoadReal(HH,id,3)
    local real time=LoadReal(HH,id,2)
    local player p=GetOwningPlayer(u)
    call SaveReal(HH,id,2,time+0.03)
    if LoadBoolean(HH,id,5)==true then
        if time==0.03 then
            set EFF=AddSpecialEffect("LightningExplodeBlackBall.mdx", x1, y1)
            call SetSpecialEffectFacing(EFF , a* bj_RADTODEG)
            call SetSpecialEffectZ(EFF , 40)
            call SetSpecialEffectScale(EFF , 1.3)
            call RemoveEffect(EFF,0.5,true,CreateTimer())
        endif
        if time<0.5 then
            call SetUnitXY_1(u,x+6*Cos(a),y+6*Sin(a), false)
            call SetUnitXY_1(c,x1+4*Cos(a),y1+4*Sin(a), false)
            call SetUnitInvulnerable(u,true)
            call PauseUnit(u,true)
            call SetUnitInvulnerable(c,true)
            call PauseUnit(c,true)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
        else
            set EFF=AddSpecialEffect("HitEnergy.mdx", x1, y1)
            call SetSpecialEffectFacing(EFF , a* bj_RADTODEG)
            //call SetSpecialEffectZ(EFF , 10)
            call SetSpecialEffectScale(EFF , 0.8)
            call RemoveEffect(EFF,0.5,false,CreateTimer())
            call SetUnitInvulnerable(u,false)
            call PauseUnit(u,false)
            call SetUnitInvulnerable(c,false)
            call PauseUnit(c,false)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
            call myCustomDamage(u,c,dmg+GetHeroAgi(u,true),false,false,null,null,null)
            call Push7(c,120,a,840,"NituHD.mdx")
            call SetUnitTimeScale(u,1)
            call SetControlToUnit(u,c,1, "stun")
            call PauseTimer(t)
            call SetUnitTimeScale(u,1)
            call DestroyTimer(t)
            call FlushChildHashtable(HH,id)
        endif
    else
        if time<0.5 then
            call SetUnitXY_1(c,x1+(50-time*80)*Cos(a),y1+(50-time*80)*Sin(a), false)
            if time==0.21 then
                call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
                call SetUnitXY_1(u,x1+260*Cos(a),y1+260*Sin(a),false)
                call SetUnitFacingInstant(u,a*bj_RADTODEG-180)
                call SetUnitFlyHeight(u,750,0)
                set EFF=AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x1+260*Cos(a),y1+260*Sin(a))
                call SetSpecialEffectZ(EFF , 750)
                call DestroyEffect(EFF)
                call SetUnitFlyHeight(u,0,3000)
                call SetUnitAnimationByIndex(u,20)
            endif
            call SetUnitInvulnerable(u,true)
            call PauseUnit(u,true)
            call SetUnitInvulnerable(c,true)
            call PauseUnit(c,true)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
        else
            call DestroyEffect(AddSpecialEffect("fuzzystomp.mdx",x,y))
            call SetUnitInvulnerable(u,false)
            call PauseUnit(u,false)
            call SetUnitInvulnerable(c,false)
            call PauseUnit(c,false)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
            call myCustomDamage(u,c,dmg,false,false,null,null,null)
            call PauseTimer(t)
            call SetUnitTimeScale(u,1)
            call DestroyTimer(t)
            call FlushChildHashtable(HH,id)
        endif
    endif
    set c=null
    set u=null
    set p=null
    set t=null
endfunction

function YoruichiQCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(HH,id,0)
    local real dmg=GetHeroAgi(u,true)*(2+GetUnitAbilityLevel(u,'YoQ0'))
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real a=LoadReal(HH,id,3)
    local real dist=LoadReal(HH,id,2)
    local integer i=0
    local boolean b=LoadBoolean(HH,id,1)
    local real sc
    local player p=GetOwningPlayer(u)
    if dist<1150 and b==false then
        set x=x+50*Cos(a)
        set y=y+50*Sin(a)
        call SetUnitXY_1(u,x,y, false)
        call SetUnitFacingInstant(u,a*bj_RADTODEG)
        call SaveReal(HH,id,2,dist+50)
        set n=CreateUnit(p,'e11T',x,y,a*bj_RADTODEG)
        call SetUnitVertexColor(n,255,255,255,75)
        call UnitApplyTimedLife(n,'BTLF',0.15)
        set n=CreateUnit(p,'e117',x,y,a*bj_RADTODEG)
        call SetUnitVertexColor(n,255,255,255,GetRandomInt(10,45))
        set sc=GetRandomReal(0.55,1.25)
        call SetUnitScale(n,sc,sc,sc)
        call UnitApplyTimedLife(n,'BTLF',0.4)
        call SetUnitTimeScale(n,3)
        call GroupEnumUnitsInRange(G,x,y,100,Base)
        loop
            set E=FirstOfGroup(G)
            exitwhen E==null
            if Condition_Base(p,E)and IsUnitInvulnerable(E)==false then
                if GetWidgetLife(E)>0 then
                    if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
                        call SaveUnitHandle(HH,id,4,E)
                        call SaveBoolean(HH,id,1,true)
                        call SaveReal(HH,id,2,0)
                        call SetUnitInvulnerable(u,true)
                        call PauseUnit(u,true)
                        call PauseTimer(t)
                        if GetUnitAbilityLevel(u,'YoG1')>0 then
                            call SaveBoolean(HH,id,5,true)
                            set soundplay=SndN(4275) // Sound\Music\mp3Music\YoruichiQG2.mp3
                            call StartSound(soundplay)
                            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                            call SetUnitAnimationByIndex(u,22)
                            call SetUnitXY_1(u,GetUnitX(E)-90*Cos(a),GetUnitY(E)-90*Sin(a), false)
                        else
                            call SaveBoolean(HH,id,5,false)
                            set soundplay=SndN(4278) // Sound\Music\mp3Music\YoruichiQ2.mp3
                            call StartSound(soundplay)
                            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                            call SetUnitAnimationByIndex(u,3)
                            set EFF=AddSpecialEffect("Minato-37.mdl",GetUnitX(E),GetUnitY(E))
                            call SetSpecialEffectScale(EFF , 1.7)
                            call SetSpecialEffectZ(EFF , 110)
                            call SetSpecialEffectTimeScale(EFF , 0.7)
                            call DestroyEffect(EFF)
                            set EFF=AddSpecialEffect("WindVectorPush.mdx",GetUnitX(E),GetUnitY(E))
                            call SetSpecialEffectFacing(EFF , a* bj_RADTODEG)
                            call SetSpecialEffectZ(EFF , 100)
                            call SetSpecialEffectScale(EFF , 0.6)
                            call SetSpecialEffectVertexColour(EFF,255,255,255,120)
                            call RemoveEffect(EFF,1,true,CreateTimer())
                        endif
                        call TimerStart(t,0.03,true,function YoruichiQCast3)
                    else
                        call SetUnitTimeScale(u,1)
                        call SaveBoolean(HH,GetHandleId(u),DASH_USER,false)
                        call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,u)
                        call SetUnitInvulnerable(u, false)
                        call PauseUnit(u, false)
                        call PauseTimer(t)
                        call DestroyTimer(t)
                        call FlushChildHashtable(HH,id)
                    endif
                endif
                call GroupClear(G)
            endif
            call GroupRemoveUnit(G,E)
        endloop
    else
        call SetUnitTimeScale(u,1)
        call PauseUnit(u,false)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(HH,id)
    endif
    set u=null
    set p=null
    set t=null
endfunction

function YoruichiQCast takes unit u, real x1, real y1 returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local player p=GetOwningPlayer(u)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real a=Atan2(y1-y,x1-x)
    local integer i=1
    call SaveUnitHandle(HH,id,0,u)
    call SaveReal(HH,id,2,0)
    call SaveReal(HH,id,3,a)
    call SaveBoolean(HH,id,1,false)
    call PauseUnit(u,true)
    call SetUnitTimeScale(u,1)
    set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+45)
    call SetUnitVertexColor(n,255,255,255,155)
    call UnitApplyTimedLife(n,'BTLF',0.4)
    call SetUnitTimeScale(n,3)
    set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG-45)
    call SetUnitVertexColor(n,255,255,255,155)
    call UnitApplyTimedLife(n,'BTLF',0.4)
    call SetUnitTimeScale(n,3)
    set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG)
    call SetUnitVertexColor(n,255,255,255,155)
    call UnitApplyTimedLife(n,'BTLF',0.4)
    call SetUnitTimeScale(n,3)
    if GetUnitAbilityLevel(u,'YoG1')>0 then
        set soundplay=SndN(4281) // Sound\Music\mp3Music\YoruichiQG1.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    else
        set soundplay=SndN(4283) // Sound\Music\mp3Music\YoruichiQ1.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    endif
    call TimerStart(t,0.01,true,function YoruichiQCast2)
    set p=null
    set t=null
endfunction

function YoruichiWCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(HH,id,0)
    local unit c=LoadUnitHandle(HH,id,1)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetUnitX(c)
    local real y1=GetUnitY(c)
    local real x2=LoadReal(HH,id,3)
    local real y2=LoadReal(HH,id,4)
    local integer i=LoadInteger(HH,id,2)
    local player p=GetOwningPlayer(u)
    local real a=LoadReal(HH,id,5)
    local real a2=LoadReal(HH,id,6)
    local real time=LoadReal(HH,id,7)
    local real dmg=(1+GetUnitAbilityLevel(u,'YoW0'))*GetHeroAgi(u,true)+100
    if i<3 and GetWidgetLife(c)>0 and GetWidgetLife(u)>0 and udg_B and DU2 then
        if SR(x1,y1,x2,y2)<120 or time>0.6 then
            if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
                call SaveInteger(HH,id,2,i+1)
                call SetUnitAnimationByIndex(u,12)
                call SaveReal(HH,id,3,x1+600*Cos(a-(2+i)*120*bj_DEGTORAD))
                call SaveReal(HH,id,4,y1+600*Sin(a-(2+i)*120*bj_DEGTORAD))
                call SaveReal(HH,id,6,Atan2(y1+600*Sin(a-(2+i)*120*bj_DEGTORAD)-y1,x1+600*Cos(a-(2+i)*120*bj_DEGTORAD)-x1))
                call SetUnitXY_1(c,x1+50*Cos(a2),y1+50*Sin(a2), false)
                call SaveReal(HH,id,7,0)
                set EFF=AddSpecialEffect("Minato-37.mdl",x1,y1)
                call SetSpecialEffectScale(EFF , 1.7)
                call SetSpecialEffectZ(EFF , 110)
                call SetSpecialEffectTimeScale(EFF , 0.7)
                call DestroyEffect(EFF)
                set EFF=AddSpecialEffect("WindVectorPush.mdx", x1, y1)
                if i==2 then
                    call SetSpecialEffectFacing(EFF , a2* bj_RADTODEG-180)
                else
                    call SetSpecialEffectFacing(EFF , a2* bj_RADTODEG-120)
                endif
                call SetSpecialEffectZ(EFF , 100)
                call SetSpecialEffectScale(EFF , 0.6)
                call SetSpecialEffectVertexColour(EFF,255,255,255,120)
                call RemoveEffect(EFF,1,true,CreateTimer())
                set EFF=AddSpecialEffect("FlashAura.mdl",x1,y1)
                if i==2 then
                    call SetSpecialEffectFacing(EFF , a2* bj_RADTODEG-180)
                else
                    call SetSpecialEffectFacing(EFF , a2* bj_RADTODEG-120)
                endif
                call SetSpecialEffectScale(EFF , 0.7)
                call SetSpecialEffectZ(EFF , 90)
                call SetSpecialEffectTimeScale(EFF , 0.7)
                call DestroyEffect(EFF)
            else
                call PauseUnit(u,false)
                call PauseUnit(c,false)
                call UnitSpeed(u,1)
                call UnitSpeed(c,1)
                call SetUnitPathing(u,true)
                call SetUnitPathing(c,true)
                call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
                call SetUnitInvulnerable(u,false)
                call SetUnitInvulnerable(c,false)
                call SetUnitVertexColor(u,255,255,255,255)
                call PauseTimer(t)
                call SetUnitFlyHeight(u,0,0)
                call DestroyTimer(t)
                call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
                call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
                call FlushChildHashtable(HH,id)
            endif
        else
            call SaveReal(HH,id,7,time+0.03)
            call PauseUnit(u,true)
            call PauseUnit(c,true)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
            if IsTerrainPathable(x2,y2,PATHING_TYPE_FLYABILITY)==true then
                call SaveReal(HH,id,3,x2-110*Cos(a2))
                call SaveReal(HH,id,4,y2-110*Sin(a2))
            endif
            if time==0.15 then
            call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
            call SetUnitXY_1(u,x2,y2, false)
            call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x2,y2))
            endif
            call SetUnitXY_1(c,x1+60*Cos(a2),y1+60*Sin(a2), false)
            //call UnitApplyTimedLife(CreateUnit(p,'e0B1',x1,y1,GetRandomReal(0,359)),'BTLF',0.4)
            //call UnitApplyTimedLife(CreateUnit(p,'e0B4',x1,y1,GetRandomReal(0,359)),'BTLF',0.4)
            //set n=CreateUnit(p,'e0B2',x1,y1,GetRandomReal(0,359))
            //call UnitApplyTimedLife(n,'BTLF',0.01)
            //call SetUnitVertexColor(n,255,220,40,50)
            call SetUnitFacingInstant(u,a2*bj_RADTODEG-120)
        endif
    else
        call SetUnitInvulnerable(u,false)
        call PauseUnit(u,false)
        call PauseUnit(c,false)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
        call myCustomDamage(u,c,dmg,false,false,null,null,null)
        call Push3(c,60,a-180*bj_DEGTORAD,600,"")
        call SetUnitTimeScale(u,1)
        call SetControlToUnit(u,c,1, "stun")
        call SetUnitVertexColor(u,255,255,255,255)
        call DestroyTimer(t)
        call FlushChildHashtable(HH,id)
    endif
    set p=null
    set u=null
    set c=null
    set t=null
endfunction

function YoruichiWCast takes unit u, unit c returns nothing
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetUnitX(c)
    local real y1=GetUnitY(c)
    local real a=Atan2(y1-y,x1-x)
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
        call SetUnitVertexColor(u,255,255,255,190)
        call SaveUnitHandle(HH,id,0,u)
        call SaveUnitHandle(HH,id,1,c)
        call SaveReal(HH,id,3,x1+500*Cos(a-120*bj_DEGTORAD))
        call SaveReal(HH,id,4,y1+500*Sin(a-120*bj_DEGTORAD))
        call SaveReal(HH,id,5,a)
        call SaveReal(HH,id,6,Atan2(LoadReal(HH,id,4)-y1,LoadReal(HH,id,3)-x1))
        call SaveReal(HH,id,7,0)
        call PauseUnit(u,true)
        call PauseUnit(c,true)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
        call SetUnitInvulnerable(u,true)
        call SetUnitTimeScale(u,3)
        call SetUnitAnimationByIndex(u,12)
        call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
        call SetUnitXY_1(u,x1,y1, false)
        call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x1,y1))
        set EFF=AddSpecialEffect("WindVectorPush.mdx", x1, y1)
        call SetSpecialEffectFacing(EFF , a* bj_RADTODEG-120)
        call SetSpecialEffectZ(EFF , 100)
        call SetSpecialEffectScale(EFF , 0.6)
        call SetSpecialEffectVertexColour(EFF,255,255,155,120)
        call RemoveEffect(EFF,1,true,CreateTimer())
        set EFF=AddSpecialEffect("Minato-37.mdl",x1,y1)
        call SetSpecialEffectScale(EFF , 1.7)
        call SetSpecialEffectZ(EFF , 110)
        call SetSpecialEffectTimeScale(EFF , 0.7)
        call DestroyEffect(EFF)
        set EFF=AddSpecialEffect("FlashAura.mdl",x1+20*Cos(a),y1+20*Sin(a))
        call SetSpecialEffectFacing(EFF , a* bj_RADTODEG-120)
        call SetSpecialEffectScale(EFF , 0.7)
        call SetSpecialEffectZ(EFF , 90)
        call SetSpecialEffectTimeScale(EFF , 0.7)
        call DestroyEffect(EFF)
        set soundplay=SndN(4285) // Sound\Music\mp3Music\YoruichiW.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        call TimerStart(t,0.03,true,function YoruichiWCast2)
    else
        call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
        call SetUnitXY_1(u,x1,y1, false)
        call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x1,y1))
        call PauseUnit(u,false)
        call PauseUnit(c,false)
        call UnitSpeed(u,1)
        call UnitSpeed(c,1)
        call SetUnitPathing(u,true)
        call SetUnitPathing(c,true)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
        call SetUnitInvulnerable(u,false)
        call SetUnitInvulnerable(c,false)
        call SetUnitVertexColor(u,255,255,255,255)
        call PauseTimer(t)
        call SetUnitFlyHeight(u,0,0)
        call DestroyTimer(t)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
        call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
        call FlushChildHashtable(HH,id)
    endif
    set u=null
    set t=null
    set c=null
endfunction

function YoruichiECast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(HH,id,0)
    local unit c=LoadUnitHandle(HH,id,1)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetUnitX(c)
    local real y1=GetUnitY(c)
    local real a=Atan2(y1-y,x1-x)
    local real time=LoadReal(HH,id,2)
    local real time2=LoadReal(HH,id,3)
    local real act=LoadInteger(HH,id,4)
    local player p=GetOwningPlayer(u)
    local real dmg=GetHeroAgi(u,true)*(3+GetUnitAbilityLevel(u,'YoE0'))
    if time==0 then
        call SetUnitFlyHeight(u,0,1000)
        call SetUnitAnimationByIndex(u,21)
    endif
    call SaveReal(HH,id,2,time+0.04)
    if udg_B and DU2 then
        if SquareRootUnit(u,c)>150+time*100 and act==0 then
            call SetUnitXY_1(u,x+(40+time*200)*Cos(a),y+(40+time*200)*Sin(a),false)
            call SetUnitFacingInstant(u,a*bj_RADTODEG)
            if time>2 then
                call SetUnitXY_1(u,x1,y1,false)
            endif
        else
            call SetUnitFlyHeight(u,0,0)
            if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
                call SetUnitXY_1(c,x+70*Cos(a),y+70*Sin(a),false)
                if act==0 then
                    call SaveInteger(HH,id,4,1)
                endif
                if time2==0 then
                    call UnitEnableAutoOrientation(c,false)
                    call SetUnitOrientation(c,GetUnitFacing(u),-90,0)
                    set EFF=AddSpecialEffect("chushou_by_wood_effect_earth_sandycrack_fag.mdl",x1,y1)
                    //call SetSpecialEffectScale(EFF , 1.)
                    call RemoveEffect(EFF,0.8,false,CreateTimer())
                endif
                if time2==0.8 then
                    call SetUnitAnimationByIndex(u,17)
                    set soundplay=SndN(4287) // Sound\Music\mp3Music\YoruichiE2.mp3
                    call StartSound(soundplay)
                    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                    set EFF=AddSpecialEffect("slamEarth.mdl",x1,y1)
                    call SetSpecialEffectScale(EFF , 0.4+(time2-0.8)*0.8)
                    call RemoveEffect(EFF,0.2,false,CreateTimer())
                    set EFF=AddSpecialEffect("chushou_by_wood_effect_earth_sandycrack_fag.mdl",x1,y1)
                    call SetSpecialEffectZ(EFF , -8)
                    call SetSpecialEffectScale(EFF , 1.2+(time2-0.8)*0.8)
                    call DestroyEffect(EFF)
                    call ShakeCamera(1.3,35)
                endif
                if time2==1 or time2==1.2 or time2==1.4 or time2==1.6 or time2==1.8 or time2==2 or time2==2.2 or time2==2.4 then
                    set EFF=AddSpecialEffect("slamEarth.mdl",x1,y1)
                    call SetSpecialEffectScale(EFF , 0.4+(time2-0.8)*0.8)
                    call RemoveEffect(EFF,0.2,false,CreateTimer())
                    set EFF=AddSpecialEffect("chushou_by_wood_effect_earth_sandycrack_fag.mdl",x1,y1)
                    call SetSpecialEffectZ(EFF , -8)
                    call SetSpecialEffectScale(EFF , 1.2+(time2-0.8)*0.8)
                    call DestroyEffect(EFF)
                endif
                call PauseUnit(c,true)
                call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
                call SetUnitInvulnerable(c,true)
                call SetUnitInvulnerable(u,true)
                call PauseUnit(u,true)
                call SaveReal(HH,id,3,time2+0.04)
                if time2>2.5 then
                    //call UnitRemoveAbility(u,'YoE1')
                    set EFF=AddSpecialEffect("chushou_by_wood_effect_earth_sandycrack_fag.mdl",x1,y1)
                    call SetSpecialEffectScale(EFF , 2.5)
                    call DestroyEffect(EFF)
                    set EFF=AddSpecialEffect("slamEarth.mdl",x1,y1)
                    call SetSpecialEffectScale(EFF , 1.8)
                    call RemoveEffect(EFF,2,false,CreateTimer())
                    call SetUnitInvulnerable(u,false)
                    call SetUnitInvulnerable(c,false)
                    call PauseUnit(u,false)
                    call PauseUnit(c,false)
                    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
                    call myCustomDamage(u,c, dmg, false, false, null, null, null)
                    call SetControlToUnit(u,c,2,"stun")
                    call UnitEnableAutoOrientation(c,true)
                    call SetUnitAnimationByIndex(u,18)
                    call Push5(u,60,a-180*bj_DEGTORAD,480,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
                    call PauseTimer(t)
                    call DestroyTimer(t)
                    call FlushChildHashtable(HH,id)
                endif
            else
                call UnitEnableAutoOrientation(c,true)
                call PauseUnit(u,false)
                call PauseUnit(c,false)
                call UnitSpeed(u,1)
                call UnitSpeed(c,1)
                call SetUnitPathing(u,true)
                call SetUnitPathing(c,true)
                call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
                call SetUnitInvulnerable(u,false)
                call SetUnitInvulnerable(c,false)
                call SetUnitVertexColor(u,255,255,255,255)
                call PauseTimer(t)
                call SetUnitFlyHeight(u,0,0)
                call DestroyTimer(t)
                call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
                call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
                call FlushChildHashtable(HH,id)
            endif
        endif
    else
        call SetUnitInvulnerable(u,false)
        call PauseUnit(u,false)
        call PauseUnit(c,false)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(HH,id)
    endif
    set t=null
    set u=null
    set c=null
    set p=null
endfunction

function YoruichiECast takes unit u returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local player p=GetOwningPlayer(u)
    local group g=CreateGroup()
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local unit c
    local real a
    call GroupEnumUnitsInRange(G,x,y,900,Base)
    loop
        set E=FirstOfGroup(G)
        exitwhen E==null
        if Condition_Base(p,E) and IsUnitInvulnerable(E)==false and IsUnitInvisible(E,p)==false then
            call GroupAddUnit(g,E)
        endif
        call GroupRemoveUnit(G,E)
    endloop
    set E=FirstOfGroup(g)
    if E==null then
        set soundplay=SndN(4290) // Sound\Music\mp3Music\YoruichiE0.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        call DestroyTimer(t)
    else
        set c=E
        loop
        set E=FirstOfGroup(g)
        exitwhen E==null
        if SquareRootUnit(u,E)<=SquareRootUnit(u,c) then
            set c=E
        endif
        call GroupRemoveUnit(g,E)
        endloop
        call DestroyGroup(g)
        call SaveUnitHandle(HH,id,0,u)
        call SaveUnitHandle(HH,id,1,c)
        call SaveReal(HH,id,2,0)
        call SaveReal(HH,id,3,0)
        call SaveInteger(HH,id,4,0)
        call SetUnitInvulnerable(u,true)
        call PauseUnit(u,true)
        set a=Atan2(GetUnitY(c)-y,GetUnitX(c)-x)
        call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
        call SetUnitXY_1(u,GetUnitX(c)-200*Cos(a),GetUnitY(c)-200*Sin(a),false)
        call SetUnitFlyHeight(u,430,0)
        set EFF=AddSpecialEffect("war3mapImported\\BlackBlink.mdx",GetUnitX(c)-200*Cos(a),GetUnitY(c)-200*Sin(a))
        call SetSpecialEffectZ(EFF , 430)
        call DestroyEffect(EFF)
        set soundplay=SndN(4292) // Sound\Music\mp3Music\YoruichiE1.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        //call UnitAddAbility(u,'YoE1')
        call TimerStart(t,0.04,true,function YoruichiECast2)
    endif
    set c=null
    set g=null
    set p=null
    set t=null
endfunction

function YoruichiRCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(HH,id,0)
    local real x1=LoadReal(HH,id,1)
    local real y1=LoadReal(HH,id,2)
    local player p=GetOwningPlayer(u)
    local real time=LoadReal(HH,id,3)
    local real dmg=GetHeroAgi(u,true)*(3+GetUnitAbilityLevel(u,'YoR0'))
    local real dmg2=GetHeroAgi(u,true)*(0.1+0.1*GetUnitAbilityLevel(u,'YoR0'))
    call SaveReal(HH,id,3,time+0.25)
    if udg_B==false or DU2==false then
        call PauseUnit(u,false)
        call SaveReal(HH,id,3,30)
    endif
    if time==1 then
        call ShakeCamera(1,25)
        set n=CreateUnit(p, 'dH57', x1, y1, GetRandomInt(0, 360))
        call SetUnitModel(n,"LightPillarYellow.mdx")
        call SetUnitScale(n, 2, 2, 2)
        call UnitApplyTimedLife(n,'BTLF',2)
        set n=CreateUnit(p, 'dH57', x1, y1, GetRandomInt(0, 360))
        call SetUnitModel(n,"YoruichiLight B.mdl")
        call SetUnitScale(n, 4, 4, 4)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(p, 'dH57', x1, y1, GetRandomInt(0, 360))
        call SetUnitModel(n,"Op (593).mdx")
        call SetUnitScale(n, 2.25, 2.25, 2.25)
        call MyRemoveUnit(n, 1.5)
        call GroupEnumUnitsInRange(G,x1,y1,550,Base)
        loop
            set E=FirstOfGroup(G)
            exitwhen E==null
            if Condition_Base(p,E) then
                call myCustomDamage(u,E,dmg,false,false,null,null,null)
            endif
            call GroupRemoveUnit(G,E)
        endloop
    endif
    if time==1.25 then
        call SetUnitInvulnerable(u,false)
        call PauseUnit(u,false)
        call SetUnitAnimationByIndex(u,0)
    endif
    if time>1 then
        set n=CreateUnit(p, 'dH57', x1, y1, GetRandomInt(0, 360))
        call SetUnitModel(n,"Arthur-21.mdl")
        call SetUnitScale(n, 2, 2, 2)
        call MyRemoveUnit(n, 1.5)
        call GroupEnumUnitsInRange(G,x1,y1,550,Base)
        loop
            set E=FirstOfGroup(G)
            exitwhen E==null
            if Condition_Base(p,E) then
                call myCustomDamage(u,E,dmg2,false,false,null,null,null)
            endif
            call GroupRemoveUnit(G,E)
        endloop
    endif
    if time>3 then
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(HH,id)
    endif
    set t=null
    set u=null
    set p=null
endfunction

function YoruichiRCast takes unit newCaster, real point_x, real point_y returns nothing
    local timer newTimer = CreateTimer()
    local integer id = GetHandleId(newTimer)
    local real x=GetUnitX(newCaster)
    local real y=GetUnitY(newCaster)
    local real a=Atan2(point_y-y,point_x-x)
    local real x1=x-35*Cos(a)
    local real y1=y-35*Sin(a)
    local real a1=Atan2(point_y-y1,point_x-x1)
    call SaveUnitHandle(HH, id, 0, newCaster)
    call SetUnitInvulnerable(newCaster,true)
    call PauseUnit(newCaster,true)
    call SetUnitAnimationByIndex(newCaster,19)
    set soundplay=SndN(4294) // Sound\Music\mp3Music\YoruichiR.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set EFF=AddSpecialEffect("[DoFT]az_xuanfeng1.mdx",x,y)
    call SetSpecialEffectScale(EFF , 0.5)
    call SetSpecialEffectTimeScale(EFF , 0.7)
    call DestroyEffect(EFF)
    set EFF=AddSpecialEffect("ShunkoRaijin.mdl",x1,y1)
    call SetSpecialEffectFacing(EFF , a* bj_RADTODEG)
    call SetSpecialEffectScale(EFF , 2.5)
    call SetSpecialEffectZ(EFF , 130)
    call SetSpecialEffectTimeScale(EFF , 0.7)
    call DestroyEffect(EFF)
    set EFF=AddSpecialEffect("YellowFarseerMissile.mdl",x1,y1)
    call SetSpecialEffectFacing(EFF , a* bj_RADTODEG)
    call SetSpecialEffectScale(EFF , 1)
    call SetSpecialEffectZ(EFF , 180)
    call SetSpecialEffectTimeScale(EFF , 0.9)
    call RemoveEffect(EFF,1.1,true,CreateTimer())
    set EFF=AddSpecialEffect("YellowFarseerMissile.mdl",x1+35*Cos(a1-90*bj_DEGTORAD),y1+35*Sin(a1-90*bj_DEGTORAD))
    call SetSpecialEffectFacing(EFF , a* bj_RADTODEG)
    call SetSpecialEffectScale(EFF , 0.5)
    call SetSpecialEffectZ(EFF , 240)
    call SetSpecialEffectTimeScale(EFF , 0.9)
    call RemoveEffect(EFF,1.1,true,CreateTimer())
    set EFF=AddSpecialEffect("YellowFarseerMissile.mdl",x1-35*Cos(a1-90*bj_DEGTORAD),y1-35*Sin(a1-90*bj_DEGTORAD))
    call SetSpecialEffectFacing(EFF , a* bj_RADTODEG)
    call SetSpecialEffectScale(EFF , 0.5)
    call SetSpecialEffectZ(EFF , 240)
    call SetSpecialEffectTimeScale(EFF , 0.9)
    call RemoveEffect(EFF,1.1,true,CreateTimer())
    set EFF=AddSpecialEffect("YellowFarseerMissile.mdl",x1+65*Cos(a1-90*bj_DEGTORAD),y1+65*Sin(a1-90*bj_DEGTORAD))
    call SetSpecialEffectFacing(EFF , a* bj_RADTODEG)
    call SetSpecialEffectScale(EFF , 0.5)
    call SetSpecialEffectZ(EFF , 210)
    call SetSpecialEffectTimeScale(EFF , 0.9)
    call RemoveEffect(EFF,1.1,true,CreateTimer())
    set EFF=AddSpecialEffect("YellowFarseerMissile.mdl",x1-65*Cos(a1-90*bj_DEGTORAD),y1-65*Sin(a1-90*bj_DEGTORAD))
    call SetSpecialEffectFacing(EFF , a* bj_RADTODEG)
    call SetSpecialEffectScale(EFF , 0.5)
    call SetSpecialEffectZ(EFF , 210)
    call SetSpecialEffectTimeScale(EFF , 0.9)
    call RemoveEffect(EFF,1.1,true,CreateTimer())
    set EFF=AddSpecialEffect("YellowFarseerMissile.mdl",x1+60*Cos(a1-90*bj_DEGTORAD),y1+60*Sin(a1-90*bj_DEGTORAD))
    call SetSpecialEffectFacing(EFF , a* bj_RADTODEG)
    call SetSpecialEffectScale(EFF , 0.5)
    call SetSpecialEffectZ(EFF , 140)
    call SetSpecialEffectTimeScale(EFF , 0.9)
    call RemoveEffect(EFF,1.1,true,CreateTimer())
    set EFF=AddSpecialEffect("YellowFarseerMissile.mdl",x1-60*Cos(a1-90*bj_DEGTORAD),y1-60*Sin(a1-90*bj_DEGTORAD))
    call SetSpecialEffectFacing(EFF , a* bj_RADTODEG)
    call SetSpecialEffectScale(EFF , 0.5)
    call SetSpecialEffectZ(EFF , 140)
    call SetSpecialEffectTimeScale(EFF , 0.9)
    call RemoveEffect(EFF,1.1,true,CreateTimer())
    call SaveReal(HH,id,3,0)
    call SaveReal(HH,id,1,point_x)
    call SaveReal(HH,id,2,point_y)
    call TimerStart(newTimer, 0.25, true, function YoruichiRCast2)
    set newTimer=null
endfunction

function YoruichiTCast3 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local real x1=LoadReal(h,id,1)
    local real y1=LoadReal(h,id,2)
    local real x2=LoadReal(h,id,3)
    local real y2=LoadReal(h,id,4)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real time=LoadReal(h,id,5)
    local real time2=LoadReal(h,id,6)
    local real jump=LoadReal(h,id,7)
    local group g=LoadGroupHandle(h,id,9)
    local group g2=null // группа не используется; раньше создавалась каждый тик и не удалялась (утечка)
    local real dmg=GetHeroAgi(u,true)*2.25
    local player p=GetOwningPlayer(u)
    local real a=Atan2(y2-y,x2-x)
    local real a2=Atan2(y2-y1,x2-x1)
    if time>0 and udg_B and DU2 then
        if SR(x,y,x2,y2)<300 or time2>0.3 then
            call SetUnitInvulnerable(u,true)
            call PauseUnit(u,true)
            if jump>3 then
                call SaveReal(h,id,7,0)
                call GroupEnumUnitsInRange(g,x1,y1,1800,Base)
                if NumberOfEnemiesInEachGroupHeroes(g,p)>0 then
                    set E=GroupGetUnitByIndex(g,GetRandomInt(0,GroupGetCount(g)-1))
                    call SaveReal(h,id,3,GetUnitX(E)+200*Cos(Atan2(GetUnitY(E)-y,GetUnitX(E)-x)))
                    call SaveReal(h,id,4,GetUnitY(E)+200*Sin(Atan2(GetUnitY(E)-y,GetUnitX(E)-x)))
                else
                    call SaveReal(h,id,3,x1+GetRandomReal(-1000,1000))
                    call SaveReal(h,id,4,y1+GetRandomReal(-1000,1000))
                endif
            else
                call SaveReal(h,id,3,x1+GetRandomReal(-1000,1000))
                call SaveReal(h,id,4,y1+GetRandomReal(-1000,1000))
                call SaveReal(h,id,7,jump+1)
            endif
            set x2=LoadReal(h,id,3)
            set y2=LoadReal(h,id,4)
            call SaveReal(h,id,6,0)
            call SetUnitAnimationByIndex(u,GetRandomInt(1,7))
            call SetUnitFacingInstant(u,a*bj_RADTODEG)
            set EFF=AddSpecialEffect("DashHD2.mdl",x,y)
            call SetSpecialEffectFacing(EFF , a* bj_RADTODEG)
            call SetSpecialEffectScale(EFF , 2)
            call SetSpecialEffectZ(EFF , 60)
            call SetSpecialEffectTimeScale(EFF , 0.9)
            call RemoveEffect(EFF,0.8,false,CreateTimer())
        else
            call SetUnitInvulnerable(u,true)
            call PauseUnit(u,true)
            call SaveReal(h,id,6,time2+0.02)
            call SetUnitXY_1(u,x+270*Cos(a),y+270*Sin(a), false)
            set EFF=AddSpecialEffect("YoruichiTBig.mdl",x,y)
            call SetSpecialEffectFacing(EFF , a* bj_RADTODEG)
            call SetSpecialEffectScale(EFF , 0.23)
            call SetSpecialEffectZ(EFF , 60)
            call SetSpecialEffectTimeScale(EFF , 1.2)
            call RemoveEffect(EFF,0.4,false,CreateTimer())
        endif
        call SaveReal(h,id,5,time-0.02)
        call GroupEnumUnitsInRange(G,x,y,300,Base)
        loop
            set E=FirstOfGroup(G)
            exitwhen E==null
            if Condition_Base(p,E) and GetUnitAbilityLevel(E,'YoT1')==0 then
                call myCustomDamage(u,E,dmg,false,false,null,null,null)
                call SetControlToUnit(u,E,0.1,"stun")
                call UnitAddAbility(E,'YoT1')
                call UnitRemoveAbilityTimed(E,'YoT1',0.4)
            endif
            call GroupRemoveUnit(G,E)
        endloop
    else
        call SetUnitTimeScale(u,1)
        call DestroyEffect(AddSpecialEffect("war3mapImported\\DivineRage.mdx",x,y))
        call DestroyEffect(AddSpecialEffect("war3mapImported\\Flash.mdx",x,y))
        call UnitRemoveAbility(u,'A0QH')
        call PauseUnit(u,false)
        call SetUnitInvulnerable(u,false)
        call GroupClear(g)
        call DestroyGroup(g)
        call MorphUnitToTypeId(u,'H35Z')
        call SetUnitMoveSpeed(u,GetUnitDefaultMoveSpeed(u))
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
    endif
    set p=null
    set u=null
    set t=null
    set g=null
    set g2=null
endfunction

function YoruichiTCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    if LoadReal(h,id,5)==0.6 then
        call SetUnitInvulnerable(u,false)
        call MorphUnitToTypeId(u,'H35X')
        call SetUnitInvulnerable(u,true)
        set EFF=AddSpecialEffect("Arthur-21.mdl",GetUnitX(u),GetUnitY(u))
        call SetSpecialEffectScale(EFF , 0.5)
        call SetSpecialEffectZ(EFF , 30)
        call SetSpecialEffectTimeScale(EFF , 0.7)
        call DestroyEffect(EFF)
    endif
    if LoadReal(h,id,5)>0 then
        call SetUnitInvulnerable(u,true)
        call PauseUnit(u,true)
        call SaveReal(h,id,5,LoadReal(h,id,5)-0.04)
    else
        set EFF=AddSpecialEffect("Laxus-14.mdl",GetUnitX(u),GetUnitY(u))
        call SetSpecialEffectScale(EFF , 0.5)
        call SetSpecialEffectZ(EFF , 30)
        call SetSpecialEffectTimeScale(EFF , 0.7)
        call DestroyEffect(EFF)
        call SetUnitTimeScale(u,2)
        call PauseTimer(t)
        call SaveReal(h,id,5,6)
        call SaveReal(h,id,6,0)
        call SaveGroupHandle(h,id,9,CreateGroup())
        call TimerStart(t,0.02,true,function YoruichiTCast3)
        call UnitAddAbility(u,'A0QH')
    endif
    set u=null
    set t=null
endfunction

function YoruichiTCast takes unit u returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local player p=GetOwningPlayer(u)
    local real x1=GetUnitX(u)
    local real y1=GetUnitY(u)
    local integer i=0
    local integer Rng
    call SaveUnitHandle(h,id,0,u)
    call SaveReal(h,id,1,x1)
    call SaveReal(h,id,2,y1)
    call SaveReal(h,id,3,x1+GetRandomReal(-800,800))
    call SaveReal(h,id,4,y1+GetRandomReal(-800,800))
    set EFF=AddSpecialEffect("Arthur-21.mdl",x1,y1)
    call SetSpecialEffectScale(EFF , 1.5)
    call SetSpecialEffectZ(EFF , 30)
    call SetSpecialEffectTimeScale(EFF , 0.7)
    call DestroyEffect(EFF)
    set EFF=AddSpecialEffect("BeamLight.mdl",x1,y1)
    call SetSpecialEffectScale(EFF , 1.5)
    call SetSpecialEffectZ(EFF , 30)
    call SetSpecialEffectTimeScale(EFF , 0.7)
    call DestroyEffect(EFF)
    call SaveReal(h,id,5,1)
    call SetUnitInvulnerable(u,true)
    call PauseUnit(u,true)
    set Rng=GetRandomInt(0,1)
    loop
    exitwhen i>=10
    if GetUnitTypeId(Hero[i])=='H01C' and IsUnitAlly(Hero[i],GetOwningPlayer(u)) and UnitIsAlive(Hero[i]) then
        set Rng=GetRandomInt(0,2)
    endif
    set i=i+1
    endloop
    if Rng==0 then
        set soundplay=SndN(4296) // Sound\Music\mp3Music\YoruichiT1.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    elseif Rng==1 then
        set soundplay=SndN(4298) // Sound\Music\mp3Music\YoruichiT2.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    else
        set soundplay=SndN(4300) // Sound\Music\mp3Music\YoruichiTUrahara.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    endif
    call TimerStart(t,0.04,true,function YoruichiTCast2)
    set p=null
    set t=null
endfunction

function Trig_YoruichiInt_Actions takes nothing returns nothing
    if GetSpellAbilityId()=='YoF0' then
        call YoruichiFCast(GetSpellAbilityUnit(),GetSpellTargetX(), GetSpellTargetY())
    endif
    if GetSpellAbilityId()=='YoF1' then
        call SaveReal(HH, GetHandleId(GetSpellAbilityUnit()), 1122, 15)
        call YoruichiF_CalculateMana(GetSpellAbilityUnit(),GetSpellTargetX(), GetSpellTargetY())
    endif
    if GetSpellAbilityId()=='YoD0' then
        call YoruichiDCast(GetSpellAbilityUnit())
    endif
    if GetSpellAbilityId()=='YoD1' then
        call SaveReal(HH, GetHandleId(GetSpellAbilityUnit()), 1125, 15)
        call YoruichiD_CalculateMana(GetSpellAbilityUnit())
    endif
    if GetSpellAbilityId()=='YoQ0' then
        call YoruichiQCast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    endif
    if GetSpellAbilityId()=='YoW0' then
        call YoruichiWCast(GetSpellAbilityUnit(), GetSpellTargetUnit())
    endif
    if GetSpellAbilityId()=='YoE0' then
        call YoruichiECast(GetSpellAbilityUnit())
    endif
    if GetSpellAbilityId()=='YoR0' then
        call YoruichiRCast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    endif
    if GetSpellAbilityId()=='YoT0' then
        call YoruichiTCast(GetSpellAbilityUnit())
    endif
    if GetSpellAbilityId()=='YoG0' then
        call YoruichiGCast(GetSpellAbilityUnit())
    endif
endfunction

function InitTrig_YoruichiInt takes nothing returns nothing
    local trigger trig  = CreateTrigger(  )
    local integer index = 0
    loop
        call TriggerRegisterPlayerUnitEvent(trig, Player(index), EVENT_PLAYER_UNIT_SPELL_EFFECT, null)
        set index = index + 1
        exitwhen index == bj_MAX_PLAYER_SLOTS
    endloop
    call TriggerAddAction( trig, function Trig_YoruichiInt_Actions )
    set trig=null
endfunction

function TobiramaSeal_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local integer id_target= GetHandleId(LoadUnitHandle(h, id, TargetHash))
    call SaveReal(h, id_target, SH_TobiramaSeal_Dur, LoadReal(h, id_target, SH_TobiramaSeal_Dur) - 0.1)
    if LoadReal(h, id_target, SH_TobiramaSeal_Dur) <= 0 or GetUnitAbilityLevel(LoadUnitHandle(h, id, TargetHash), 'TMF1') == 0 then
        if GetUnitAbilityLevel(LoadUnitHandle(h, id, TargetHash), 'TMF1') >= 1 then
            call UnitRemoveAbility(LoadUnitHandle(h, id, TargetHash), 'TMF1')
        endif
        call SaveReal(h, id_target, SH_TobiramaSeal_Dur, 0.0)
                call RemoveSavedReal(h, id_target, SH_TobiramaSeal_Dur)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
endfunction

function TobiramaAddHiraishinSeal takes unit newTarget,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local integer id_target= GetHandleId(newTarget)
    local real time= LoadReal(h, id_target, SH_TobiramaSeal_Dur)
    if time == 0.0 then
        call UnitAddAbility(newTarget, 'TMF1')
                call UnitMakeAbilityPermanent(newTarget, true, 'TMF1')
        call SaveReal(h, id_target, SH_TobiramaSeal_Dur, 15)
        call SaveUnitHandle(h, id, TargetHash, newTarget)
        call TimerStart(newTimer, 0.1, true, function TobiramaSeal_Periodic)
    else
        call SaveReal(h, id_target, SH_TobiramaSeal_Dur, 15)
        call DestroyTimer(newTimer)
    endif
endfunction

function TobiramaQMissles2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit l__d=LoadUnitHandle(HH,id,0)
    local unit u=LoadUnitHandle(HH,id,10)
    local real speed=LoadReal(HH,id,1)
    local real speed2=LoadReal(HH,id,12)
    local real f=LoadReal(HH,id,2)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real a=GetUnitFacing(u)*bj_DEGTORAD
    local real dist=LoadReal(HH,id,7)
    local real sc=LoadReal(HH,id,9)
    local real dmg=GetHeroInt(u,true)*(GetUnitAbilityLevel(u,'TMQ0')+1)
    local group g=LoadGroupHandle(HH,GetHandleId(u),c_GROUP4)
    if dist>speed2 and IsTerrainPathable(x+speed2*Cos(a),y+speed2*Sin(a),PATHING_TYPE_FLYABILITY)==false and l__d!=null then
        call SetUnitXY_1(l__d,x+speed2*Cos(a),y+speed2*Sin(a), false)
        call SetUnitFacing(l__d,a*bj_RADTODEG)
        call SaveReal(HH,id,12,speed2+speed)
        if LoadBoolean(HH,id,13)==true then
            call SetUnitFacingInstant(u,a*bj_RADTODEG-1.2)
        endif
        if sc<2.3 then
            call SaveReal(HH,id,9,sc+LoadReal(HH,id,8))
        endif
        call SetUnitScale(l__d,sc,sc,sc)
        call GroupEnumUnitsInRange(g,x+speed2*Cos(a),y+speed2*Sin(a),120,Base)
        set idg=GetHandleId(g)
        loop
            set E=FirstOfGroup(g)
            set ide=GetHandleId(E)
            exitwhen E==null
            if Condition_Base(GetOwningPlayer(u),E) and E!=LoadUnitHandle(HH,idg,ide)then
                call myCustomDamage(u,E,dmg,false,false,null,null,null)
                call SlowUnit(u,E,0.5,0,3,0,false)
                if LoadBoolean(HH,id,14)==true then
                call SetControlToUnit(E,E,1,"stun")
                endif
                call SaveUnitHandle(HH,idg,ide,E)
            endif
            call GroupRemoveUnit(g,E)
        endloop
    else
        if LoadBoolean(HH,id,13)==true then
            call PauseUnit(u,false)
            call SetUnitInvulnerable(u,false)
            call SetUnitFacingInstant(u,a*bj_RADTODEG+30)
            call FlushChildHashtable(HH,idg)
            call RemoveSavedHandle(HH, GetHandleId(u),c_GROUP4)
            call DestroyGroup(g)
        endif
        call KillUnit(l__d)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(HH,id)
    endif
    set u=null
    set l__d=null
    set t=null
    set g=null
endfunction

function TobiramaQMissles takes unit l__d,real speed,real a,real dist,real sct,real sidg, unit u, boolean endWater, boolean stunWater returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    call SaveUnitHandle(HH,id,0,l__d)
    call SaveReal(HH,id,1,speed)
    call SaveReal(HH,id,2,GetUnitFlyHeight(l__d))
    call SaveReal(HH,id,3,GetUnitX(l__d))
    call SaveReal(HH,id,4,GetUnitY(l__d))
    call SaveReal(HH,id,5,a)
    call SaveReal(HH,id,7,dist)
    call SaveReal(HH,id,8,sidg)
    call SaveReal(HH,id,9,sct)
    call SaveUnitHandle(HH,id,10,u)
    call SaveGroupHandle(HH,id,11,CreateGroup())
    call SaveReal(HH,id,12,0)
    call SaveBoolean(HH,id,13,endWater)
    call SaveBoolean(HH,id,14,stunWater)
    call SetUnitVertexColor(l__d,70,70,255,190)
    call TimerStart(t,0.015,true,function TobiramaQMissles2)
    set t=null
endfunction

function TobiramaQCast3 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(HH,id,0)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real dist=LoadReal(HH,id,1)
    local real a2=LoadReal(HH,id,3)
    local real a=LoadReal(HH,id,2)+a2
    local real time=LoadReal(HH,id,4)
    local player p=GetOwningPlayer(u)
    if dist>0 then
        call SaveReal(HH,id,4,time+0.025)
        call PauseUnit(u,true)
        call SetUnitInvulnerable(u,true)
        call SetUnitFacingInstant(u,a*bj_RADTODEG)
        call SaveReal(HH,id,3,a2-0.095)
        if time<=0.075 then
            call SaveReal(HH,id,1,dist+350)
            call TobiramaQMissles(CreateUnit(p,'e19C',x+35*Cos(a),y+35*Sin(a),a*bj_RADTODEG),75,a,dist,1.1,0.05,u,false,true)
        elseif time>0.075 and time<=0.225 then
            call SaveReal(HH,id,1,dist+70)
            call TobiramaQMissles(CreateUnit(p,'e19C',x+35*Cos(a),y+35*Sin(a),a*bj_RADTODEG),75,a,dist,1.1,0.05,u,false,false)
        elseif time>0.225 and time<0.45 and a2>-20*bj_DEGTORAD then
            call SaveReal(HH,id,1,dist-35)
            call TobiramaQMissles(CreateUnit(p,'e19C',x+35*Cos(a),y+35*Sin(a),a*bj_RADTODEG),75,a,dist,1.1,0.05,u,false,false)
        elseif time>0.45 or a2<-20*bj_DEGTORAD then
            set dist=dist-40
            call TobiramaQMissles(CreateUnit(p,'e19C',x+35*Cos(a),y+35*Sin(a),a*bj_RADTODEG),75,a,dist,1.1,0.05,u,true,false)
            set dist=-100
            call SaveReal(HH,id,1,-100)
        endif
    else
        call SetUnitTimeScale(u,1)
        call UnitRemoveAbility(u,'Ao4G')
        call FlushChildHashtable(HH,id)
        call DestroyTimer(t)
    endif
    set p=null
    set u=null
    set t=null
endfunction

function TobiramaQCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(HH,id,0)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real time=LoadReal(HH,id,1)-0.1
    local real a=LoadReal(HH,id,2)
    local player p=GetOwningPlayer(u)
    call SetUnitAnimationByIndex(u,9)
    call PauseTimer(t)
    call SaveGroupHandle(HH,GetHandleId(u),c_GROUP4,CreateGroup())
    call TimerStart(t,0.025,true,function TobiramaQCast3)
    set p=null
    set u=null
    set t=null
endfunction

function TobiramaQCast takes unit u, real x1, real y1 returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real a=Atan2(y1-y,x1-x)
    local player p=GetOwningPlayer(u)
    call SaveUnitHandle(HH,id,0,u)
    call SaveReal(HH,id,1,200)
    call SaveReal(HH,id,2,a)
    call SaveReal(HH,id,3,95*bj_DEGTORAD)
    call SaveReal(HH,id,4,0)
    call PauseUnit(u,true)
    call SetUnitInvulnerable(u,true)
    set soundplay=SndN(4302) // Sound\Music\mp3Music\TobiramaQ.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call SetUnitTimeScale(u,0.8)
    call UnitAddAbility(u,'Ao4G')
    call TimerStart(t,0.3,false,function TobiramaQCast2)
    set u=null
    set t=null
    set p=null
endfunction

function TobiramaW2Cast2 takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local unit u= LoadUnitHandle(HH, id, CasterHash)
    local real a= LoadReal(HH, id, AngleHash)
    local real x1=GetUnitX(u)
    local real y1=GetUnitY(u)
    local group g=LoadGroupHandle(HH, id, GroupHash)
    local integer l__idg=GetHandleId(g)
    local real dist= LoadReal(HH, id, SH_Distance)
    local real time= LoadReal(HH, id, TIME_HASH)
    local player p=GetOwningPlayer(u)
    if dist>0 then
        call SaveReal(HH,id,SH_Distance,dist-30)
        if IsTerrainPathable(x1,y1,PATHING_TYPE_FLYABILITY)==false then
        set x1=x1+40*Cos(a)
        set y1=y1+40*Sin(a)
        else
        set x1=x1-15*Cos(a)
        set y1=y1-15*Sin(a)
        endif
        call SetUnitXY_1(u,x1,y1, false)
        if ModuloReal(dist,90)==10 then
        set n=CreateUnit(GetOwningPlayer(u),'e1GZ',x1,y1,a*bj_RADTODEG)
        call SetUnitModel(n,"Tobirama4.mdl")
        call SetUnitScale(n, 1.05, 1.05, 1.05)
        call SetUnitAnimationByIndex(n,10)
        call SetUnitVertexColor(n,255,255,255,75)
        call ShikiCloneEffect(n,0.4,1.05,1.25,150)
        endif
        call GroupEnumUnitsInRange(g,x1,y1,180,Base)
        loop
            set E=FirstOfGroup(g)
            set ide=GetHandleId(E)
            exitwhen E==null
            if Condition_Base(p,E)and LoadUnitHandle(HH,l__idg,ide)!=E then
                if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
                    call myCustomDamage(u,E,LoadReal(HH, id, SH_Damage),false,false,null,null,null)
                    call SetControlToUnit(u , E , 1 , "stun")
                    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",E,"chest"))
                    call SaveUnitHandle(HH,l__idg,ide,E)
                else
                    call SetUnitTimeScale(u,1)
                    call SaveBoolean(HH,GetHandleId(u),DASH_USER,false)
                    call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,u)
                    call SetUnitVertexColor(u,255,255,255,255)
                    call PauseUnit(u, false)
                    call SetUnitInvulnerable(u, false)
                    call DestroyGroup(LoadGroupHandle(HH, id, GroupHash))
                    call FlushChildHashtable(HH,l__idg)
                    call FlushChildHashtable(HH, id)
                    call DestroyTimer(GetExpiredTimer())
                endif
            endif
            call GroupRemoveUnit(g,E)
        endloop
    else
        if time==0 then
            call SetUnitVertexColor(u,255,255,255,255)
        endif
        if time<0.3 then
            call SaveReal(HH, id, TIME_HASH, time + 0.01)
        else
            call PauseUnit(u, false)
            call SetUnitInvulnerable(u, false)
            call DestroyGroup(LoadGroupHandle(HH, id, GroupHash))
            call FlushChildHashtable(HH,l__idg)
            call FlushChildHashtable(HH, id)
            call DestroyTimer(GetExpiredTimer())
        endif
    endif
    set p=null
    set u=null
    set g=null
endfunction

function TobiramaW2Cast takes unit u,real a,real dist,timer t returns nothing
    local integer id= GetHandleId(t)
    local integer id_caster= GetHandleId(u)
    local real damage= GetHeroInt(u, true) * ( 2.5 + 0.5*GetUnitAbilityLevel(u, 'TMW0') )
    
    set soundplay=SndN(4304) // Sound\Music\mp3Music\TobiramaW2.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call SetUnitFacingInstant(u, a * bj_RADTODEG)
    call PauseUnit(u, true)
    call SetUnitInvulnerable(u, true)
    call SetUnitAnimationByIndex(u,10)
    call UnitAddAbility(u,'TMW2')
    call UnitRemoveAbilityTimed(u,'TMW2',2)
    call CreateModeIndicatorForm(u, "ReplaceableTextures\\CommandButtons\\BTNTobiramaW2.blp", 20)
    call SaveUnitHandle(HH, id, CasterHash, u)
    call SaveReal(HH, id, AngleHash, a)
    call SaveReal(HH, id, SH_Distance, dist)
    call SaveReal(HH, id, SH_Damage, damage)
    call SaveGroupHandle(HH, id, GroupHash, CreateGroup())
    call SetUnitVertexColor(u,255,255,255,125)
    set n=CreateUnit(GetOwningPlayer(u),'e0ZH',GetUnitX(u),GetUnitY(u),a*bj_RADTODEG+45)
    call SetUnitVertexColor(n,255,255,255,155)
    call UnitApplyTimedLife(n,'BTLF',0.4)
    call SetUnitTimeScale(n,3)
    set n=CreateUnit(GetOwningPlayer(u),'e0ZH',GetUnitX(u),GetUnitY(u),a*bj_RADTODEG-45)
    call SetUnitVertexColor(n,255,255,255,155)
    call UnitApplyTimedLife(n,'BTLF',0.4)
    call SetUnitTimeScale(n,3)
    set n=CreateUnit(GetOwningPlayer(u),'e0ZH',GetUnitX(u),GetUnitY(u),a*bj_RADTODEG)
    call SetUnitVertexColor(n,255,255,255,155)
    call UnitApplyTimedLife(n,'BTLF',0.4)
    call SetUnitTimeScale(n,3)
    call TimerStart(t, 0.01, true, function TobiramaW2Cast2)
endfunction

function TobiramaWCast2 takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local unit u=LoadUnitHandle(HH, id, CasterHash)
    local unit l__d=LoadUnitHandle(HH, id, DummyHash)
    local integer idu= GetHandleId(u)
    local real a= LoadReal(HH, id, AngleHash)
    local real dist= LoadReal(HH, id, SH_Distance)
    if dist < 2000 and UnitIsAlive(l__d) and LoadBoolean(HH, idu, SH_TobiramaW_Blink) == false and LoadBoolean(HH, idu, SH_TobiramaW_Blink3)==false then
        call SetUnitX(l__d, GetUnitX(l__d) + 20 * Cos(a))
        call SetUnitY(l__d, GetUnitY(l__d) + 20 * Sin(a))
        call SaveReal(HH, id, SH_Distance, dist + 20)
        if LoadInteger(HH, id, EffectPeriodHash) == 0 then
            set n=CreateUnit(GetOwningPlayer(u), 'dM11', GetUnitX(l__d), GetUnitY(l__d), a * bj_RADTODEG)
            call SetUnitScale(n, 0.4, 0.4, 0.4)
            call SetUnitVertexColor(n, 255, 255, 255, 150)
            call SetUnitTimeScale(E, 0.5)
            call MyRemoveUnit(n , 1.5)
            call SaveInteger(HH, id, EffectPeriodHash, 5)
        else
            call SaveInteger(HH, id, EffectPeriodHash, LoadInteger(HH, id, EffectPeriodHash) - 1)
        endif
        set bjLCG=LoadGroupHandle(HH, id, GroupHash)
        call GroupEnumUnitsInRange(bjLCG, GetUnitX(l__d), GetUnitY(l__d), 100, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E == null
            if Condition_Base(GetOwningPlayer(u) , E) then
                call SetUnitX(l__d, GetUnitX(l__d) + 120 * Cos(a))
                call SetUnitY(l__d, GetUnitY(l__d) + 120 * Sin(a))
                call Push3(l__d , 75 , a , 50 , "")
                call KillUnit(l__d)
                call DestroyEffect(AddSpecialEffectTarget("TobiramaKunaiHit.mdl", E, "origin"))
                call myCustomDamage(u , E , 50+GetHeroInt(u, true) * ( 0.5 + 0.5 * GetUnitAbilityLevel(u, 'TMW0') ) , false , false , null , null , null)
                call SetControlToUnit(u , E , 0.5 , "stun")
                call Push(E , 75 , a , 50)
                call TobiramaAddHiraishinSeal(E , CreateTimer())
                call SaveUnitHandle(HH, idu, SH_TobiramaW1_Target, E)
                
                set n=CreateUnit(GetOwningPlayer(u), 'eTm8', GetUnitX(E), GetUnitY(E), a * bj_RADTODEG)
                call SetUnitTimeScale(n, 0.4)
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call SetUnitFlyHeight(n, 30, 0)
                call Push3(n , 75 , a , 50 , "")
                call MyRemoveUnit(n , 1.5)
                call GroupClear(bjLCG)
                set soundplay=SndN(3397) // Sound\war3mapImported\MinatoQ_Hit.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            endif
        call GroupRemoveUnit(bjLCG, E)
        endloop
    else
        if LoadBoolean(HH, idu, SH_TobiramaW_Blink) then
            set soundplay=SndN(4306) // Sound\Music\mp3Music\TobiramaF.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            set n=CreateUnit(GetOwningPlayer(u), 'eTm6', GetUnitX(u), GetUnitY(u), GetRandomInt(0, 360))
            call MyRemoveUnit(n , 1.5)
            set n=CreateUnit(GetOwningPlayer(u), 'eTm7', GetUnitX(u), GetUnitY(u), GetRandomInt(0, 360))
            call MyRemoveUnit(n , 1.5)
            call GroupClear(bjLCG)
            call SetUnitX(u, GetUnitX(l__d))
            call SetUnitY(u, GetUnitY(l__d))
            call GroupClear(bjLCG)
            set n=CreateUnit(GetOwningPlayer(u), 'eTm6', GetUnitX(u), GetUnitY(u), GetRandomInt(0, 360))
            call MyRemoveUnit(n , 1.5)
            set n=CreateUnit(GetOwningPlayer(u), 'eTm7', GetUnitX(u), GetUnitY(u), GetRandomInt(0, 360))
            call MyRemoveUnit(n , 1.5)
            call TobiramaW2Cast(u , a , 700 , CreateTimer())
        endif
        if UnitIsAlive(l__d) then
            call KillUnit(l__d)
        endif
        call RemoveSavedHandle(HH, idu, SH_TobiramaW_Kunai)
        call MyRemoveUnit(l__d , 0.5)
        if LoadBoolean(HH, idu, SH_TobiramaW_Blink2)==true then
            if dist==2000 then
                call UnitRemoveAbility(u, 'TMW1')
                call ShowAbility2Timed('TMW0', true,.05)
            else
                call UnitRemoveAbilityTimed(u, 'TMW1',1)
                call ShowAbility2Timed('TMW0', true,1.05)
            endif
        endif
        call SaveBoolean(HH, idu, SH_TobiramaW_Blink, false)
        call SaveBoolean(HH, idu, SH_TobiramaW_Blink2, false)
        call SaveBoolean(HH, idu, SH_TobiramaW_Blink3, false)
        call DestroyGroup(LoadGroupHandle(HH, id, GroupHash))
        call FlushChildHashtable(HH, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set u=null
    set l__d=null
endfunction

function TobiramaWCast takes unit u,real x1,real y1,timer t returns nothing
    local integer id= GetHandleId(t)
    local integer idu= GetHandleId(u)
    local real x= GetUnitX(u)
    local real y= GetUnitY(u)
    local real a= AtanPoint(x , y , x1 , y1)
    call RemoveSavedHandle(HH, idu, SH_TobiramaW1_Target)
    set soundplay=SndN(4309) // Sound\Music\mp3Music\TobiramaW1.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    //if GetRandomInt(0, 1) == 0 then
    //    set soundplay=CreateSound("Sound\\war3mapImported\\MinatoQ_Voice" + I2S(GetRandomInt(1, 2)) + ".mp3", false, false, true, 12700, 12700, "")
    //    call StartSound(soundplay)
    //    call KillSoundWhenDone(soundplay)
    //endif
    set n=CreateUnit(GetOwningPlayer(u), 'dM04', x + 50 * Cos(a), y + 50 * Sin(a), a * bj_RADTODEG)
    call SetUnitTimeScale(n, 0.6)
    call SetUnitVertexColor(n, 255, 255, 255, 180)
    call MyRemoveUnit(n , 1.5)
    set n=CreateUnit(GetOwningPlayer(u), 'dM11', x + 50 * Cos(a), y + 50 * Sin(a), a * bj_RADTODEG)
    call SetUnitFlyHeight(n, 150, 0)
    call MyRemoveUnit(n , 1.5)
    set n=CreateUnit(GetOwningPlayer(u), 'dM12', x + 50 * Cos(a), y + 50 * Sin(a), a * bj_RADTODEG)
    call MyRemoveUnit(n , 1.5)
    //set n=CreateUnit(GetOwningPlayer(u), 'dM08', x+50*Cos(a), y+50*Sin(a), a*bj_RADTODEG)
    //call MyRemoveUnit(n, 1.5)
    set n=CreateUnit(GetOwningPlayer(u), 'eTm5', x, y, a * bj_RADTODEG)
    call SetUnitAnimationByIndex(n,2)
    call SaveUnitHandle(HH, id, DummyHash, n)
    call SaveUnitHandle(HH, idu, SH_TobiramaW_Kunai, n)
    if LoadReal(HH, GetHandleId(LoadFrameHandle(HH, GetHandleId(GetOwningPlayer(u)),SH_ReplaceableTextures_CommandButtons_BTNTobiramaW2_blp)), c_DURATION)==0 then
        call ShowAbility2( 'TMW0' , false)
        call UnitAddAbility(u, 'TMW1')
        call SetUnitAbilityLevel(u, 'TMW1', GetUnitAbilityLevel(u , 'TMW0'))
        call SaveBoolean(HH, idu, SH_TobiramaW_Blink2, true)
    else
        call SaveBoolean(HH, idu, SH_TobiramaW_Blink2, false)
    endif
    call SaveBoolean(HH, idu, SH_TobiramaW_Blink, false)
    call SaveBoolean(HH, idu, SH_TobiramaW_Blink3, false)
    call SetUnitAnimationByIndex(u,5)
    call SaveUnitHandle(HH, id, CasterHash, u)
    call SaveGroupHandle(HH, id, GroupHash, CreateGroup())
    call SaveReal(HH, id, AngleHash, a)
    call TimerStart(t, 0.01, true, function TobiramaWCast2)
endfunction

function TobiramaECast3 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(HH,id,0)
    local unit c=LoadUnitHandle(HH,id,1)
    local unit l__d=LoadUnitHandle(HH,id,12)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetUnitX(c)
    local real y1=GetUnitY(c)
    local real x2=GetUnitX(l__d)
    local real y2=GetUnitY(l__d)
    local real a=LoadReal(HH,id,4)
    local real he=LoadReal(HH,id,3)
    local real time=LoadReal(HH,id,2)+0.03
    local real f=GetUnitFacing(u)
    local real dmg=GetHeroInt(u,true)*(3+GetUnitAbilityLevel(u,'TME0'))
    local player p=GetOwningPlayer(u)
    local real HeadPitch=LoadReal(HH,id,13)
    local effect effh=LoadEffectHandle(HH,id,14)
    if time<0.36 and UnitIsAlive(u)==true and UnitIsAlive(c)==true then
        set x1=x1+(75-time*165)*Cos(a)
        set y1=y1+(75-time*165)*Sin(a)
        call SetUnitFlyHeight(c,ParabolaZ2(130,540,250,LoadReal(HH,id,5),time*750),0)
        call SetUnitXY_1(c,x1,y1, false)
        call SaveReal(HH,id,2,time)
        call SaveReal(HH,id,13,HeadPitch+7.2)
    elseif SR(x,y,x1,y1)>((time-0.2)*100) and time>=0.36 and time<1.2 and UnitIsAlive(u)==true and UnitIsAlive(c)==true then
        if time==0.36 then
            call SaveReal(HH,id,5,400)
        endif
        set x1=x1+((time-0.35)*40)*Cos(a-180*bj_DEGTORAD)
        set y1=y1+((time-0.35)*40)*Sin(a-180*bj_DEGTORAD)
        call SetUnitFlyHeight(c,ParabolaZ2(540,1150,950,LoadReal(HH,id,5),(time-0.36)*1400),0)
        call SaveReal(HH,id,2,time)
        call SetUnitXY_1(c,x1,y1, false)
        if time==0.42 then
            set soundplay=SndN(4311) // Sound\Music\mp3Music\TobiramaE2.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        endif
        if time<0.75 then
            call SaveReal(HH,id,13,HeadPitch+12.2)
        endif
    else
        set soundplay=SndN(4314) // Sound\Music\mp3Music\TobiramaE3.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        call SetUnitFlyHeight(c,0,0)
        call PauseUnit(c,false)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
        call SetUnitInvulnerable(c,false)
        call myCustomDamage(u,c,dmg,false,false,null,null,null)
        set EFF=AddSpecialEffect("WaterEffect1.mdx",x1,y1)
        call SetSpecialEffectScale(EFF , 1.75)
        call RemoveEffect(EFF,2,true,CreateTimer())
        set EFF=AddSpecialEffect("war3mapImported\\az2_az_xiaonajia01_d2.mdl",x1,y1)
        call SetSpecialEffectScale(EFF , 1.75)
        call RemoveEffect(EFF,2,true,CreateTimer())
        set EFF=AddSpecialEffect("war3mapImported\\blue-guagnzhu-special.mdl", x1, y1)
        call SetSpecialEffectScale(EFF , 1.8)
        call DestroyEffect(EFF)
        call RemoveEffect(effh,0.03,false,CreateTimer())
        call SetControlToUnit(u,c,1.5,"stun")
        call SetUnitTimeScale(u,1)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(HH,id)
    endif
    call SetSpecialEffectOrientation(effh , a* bj_RADTODEG,HeadPitch,0)
    call SetSpecialEffectZ(effh,GetUnitFlyHeight(c))
    call SetSpecialEffectX(effh, GetUnitX(c))
    call SetSpecialEffectY(effh, GetUnitY(c))
    set EFF=AddSpecialEffect("TobiramaWater.mdl",GetUnitX(c),GetUnitY(c)) 
    call SetSpecialEffectZ(EFF,GetUnitFlyHeight(c))
    call SetSpecialEffectOrientation(EFF , a* bj_RADTODEG,HeadPitch,0)
    call SetSpecialEffectScale(EFF , 2)
    call RemoveEffect(EFF,0.12,true,CreateTimer())
    set effh=null
    set l__d=null
    set p=null
    set u=null
    set c=null
    set t=null
endfunction

function TobiramaECast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(HH,id,0)
    local unit c=LoadUnitHandle(HH,id,1)
    local unit l__d=LoadUnitHandle(HH,id,12)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetUnitX(c)
    local real y1=GetUnitY(c)
    local real x2=GetUnitX(l__d)
    local real y2=GetUnitY(l__d)
    local real a=Atan2(y1-y2,x1-x2)
    local real time=LoadReal(HH,id,2)+0.03
    local real f=GetUnitFacing(u)
    local player p=GetOwningPlayer(u)
    if IsTerrainPathable(x2,y2,PATHING_TYPE_FLYABILITY)==false and SR(x2,y2,x1,y1)>150 and UnitIsAlive(u)==true and UnitIsAlive(c)==true and time<3 then
        set x2=x2+90*Cos(a)
        set y2=y2+90*Sin(a)
        call SetUnitFacingInstant(u,a*bj_RADTODEG)
        call SetUnitFlyHeight(l__d,ParabolaZ2(0,80,250,LoadReal(HH,id,5),SR(x2,y2,x1,y1)),0)
        call SetUnitXY_1(l__d,x2,y2, false)
        //call SetUnitX(l__d,x)
        //call SetUnitY(l__d,y)
        call SaveReal(HH,id,2,time)
        call SetUnitFacingInstant(l__d,a*bj_RADTODEG)
        set EFF=AddSpecialEffect("TobiramaWater.mdl",GetUnitX(l__d),GetUnitY(l__d)) 
        call SetSpecialEffectZ(EFF,GetUnitFlyHeight(l__d))
        call SetSpecialEffectOrientation(EFF , a* bj_RADTODEG,0,0)
        call SetSpecialEffectScale(EFF , 2)
        call RemoveEffect(EFF,0.12,true,CreateTimer())
    else
        if time>=3 then
            set x2=x1-90*Cos(a)
            set y2=y1-90*Sin(a)
            call SetUnitXY_1(l__d,x2,y2, false)
        endif
        if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
            call PauseUnit(c,true)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
            call SetUnitInvulnerable(c,true)
            call PauseUnit(u,false)
            call SaveReal(HH,id,2,0)
            call SaveReal(HH,id,3,GetUnitFlyHeight(l__d))
            call SaveReal(HH,id,4,a)
            call SaveReal(HH,id,5,360)
            set EFF=AddSpecialEffect("TobiramaWater.mdl",GetUnitX(l__d),GetUnitY(l__d)) 
            call SetSpecialEffectZ(EFF,GetUnitFlyHeight(l__d))
            call SetSpecialEffectOrientation(EFF , a* bj_RADTODEG,0,0)
            call SetSpecialEffectScale(EFF , 2)
            call RemoveEffect(EFF,0.1,true,CreateTimer())
            call UnitApplyTimedLife(l__d,'BTLF',2)
            call SetUnitModel(l__d,"war3mapImported\\dummy.mdl")
            set EFF=AddSpecialEffect("war3mapImported\\DragonTobirama.mdl",x1,y1)
            call SetSpecialEffectScale(EFF , 0.65)
            call SetSpecialEffectZ(EFF,0)
            call SetSpecialEffectOrientation(EFF , a* bj_RADTODEG,0,0)
            call SaveEffectHandle(HH,id,14,EFF)
            //call UnitRemoveAbility(l__d,'ore2')
            //call SetUnitTimeScale(l__d,1)
            //call SetUnitAnimationByIndex(l__d,25)
            call PauseTimer(t)
            call TimerStart(t,0.03,true,function TobiramaECast3)
        else
            call UnitApplyTimedLife(l__d,'BTLF',0.05)
            call PauseUnit(u,false)
            call PauseUnit(c,false)
            call SetUnitTimeScale(u,1)
            call SetUnitTimeScale(c,1)
            call SetUnitPathing(u,true)
            call SetUnitPathing(c,true)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
            call SetUnitInvulnerable(u,false)
            call SetUnitInvulnerable(c,false)
            call SetUnitVertexColor(u,255,255,255,255)
            call PauseTimer(t)
            call SetUnitFlyHeight(u,0,0)
            call DestroyTimer(t)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
            call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
            call FlushChildHashtable(HH,id)
        endif
    endif
    set l__d=null
    set p=null
    set u=null
    set c=null
    set t=null
endfunction

function TobiramaECast takes unit u, unit c returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetUnitX(c)
    local real y1=GetUnitY(c)
    local real f=GetUnitFacing(u)
    local player p=GetOwningPlayer(u)
    set soundplay=SndN(4317) // Sound\Music\mp3Music\TobiramaE.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call SaveUnitHandle(HH,id,0,u)
    call SaveUnitHandle(HH,id,1,c)
    call SaveReal(HH,id,2,0)
    call SaveReal(HH,id,5,SR(x,y,x1,y1))
    call SetUnitAnimationByIndex(u,3)
    set n=CreateUnit(p,'eTm4',x,y,f)
    //call SetUnitAnimationByIndex(n,12)
    call SetUnitVertexColor(n,255,255,255,255)
    call SaveUnitHandle(HH,id,12,n)
    call PauseUnit(u,true)
    call TimerStart(t,0.03,true,function TobiramaECast2)
    set u=null
    set p=null
    set t=null
    set c=null
endfunction

function TobiramaRCast3 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit l__d
    local real dmg=GetHeroInt(u,true)*(4+GetUnitAbilityLevel(u,'TMR0'))
    local real x
    local real y
    local real a=LoadReal(h,id,3)
    local real f
    local real rd=LoadReal(h,id,4)
    local player p=GetOwningPlayer(u)
    local real time=LoadReal(h,id,7)
    local real dist
    local integer l__ide
    local group g=LoadGroupHandle(h,id,6)
    local group g2=LoadGroupHandle(h,id,10)
    local group g3
    local integer l__idg=GetHandleId(g2)
    if FirstOfGroup(g)!=null then
        set g3=CopyGroup(g)
        loop
            set l__d=FirstOfGroup(g3)
            exitwhen l__d==null
            set l__ide=GetHandleId(l__d)
            set dist=LoadReal(h,l__ide,0)
            if dist>0 and IsTerrainPathable(GetUnitX(l__d),GetUnitY(l__d),PATHING_TYPE_FLYABILITY)==false then
                set f=GetUnitFacing(l__d)*bj_DEGTORAD
                set x=GetUnitX(l__d)+55*Cos(f)
                set y=GetUnitY(l__d)+55*Sin(f)
                call SetUnitXY_1(l__d,x,y, false)
                call SaveReal(h,l__ide,0,dist-55)
                if ModuloReal(dist,165)==25 and dist<2100 then
                    set EFF=AddSpecialEffect("WaterFag.mdx",x-55*Cos(f),y-55*Sin(f))
                    call SetSpecialEffectScale(EFF , 0.95)
                    call SetSpecialEffectTimeScale(EFF , 1.2)
                    call SetSpecialEffectAlpha(EFF,125)
                    call SetSpecialEffectFacing(EFF , f* bj_RADTODEG)
                    call RemoveEffect(EFF,dist/2000,true,CreateTimer())
                endif
                call GroupEnumUnitsInRange(GJ,x,y,350,Base)
                call GroupAddGroup(GJ,g2)
            else
                call GroupRemoveUnit(g,l__d)
                call RemoveUnit(l__d)
            endif
            call GroupRemoveUnit(g3,l__d)
        endloop
        call DestroyGroupTimed(g3,3)
        loop
            set E=FirstOfGroup(g2)
            set l__ide=GetHandleId(E)
            exitwhen E==null
            if Condition_Base(p,E)then
                call SetUnitX(E,GetUnitX(E)+65*Cos(a))
                call SetUnitY(E,GetUnitY(E)+65*Sin(a))
                if E!=LoadUnitHandle(h,l__idg,l__ide)then
                    call myCustomDamage(u,E,dmg,false,false,null,null,null)
                    call SaveUnitHandle(h,l__idg,l__ide,E)
                endif
            endif
            call GroupRemoveUnit(g2,E)
        endloop
        call DestroyGroup(GN)
    else
        call SetSpecialEffectTimeScale(LoadEffectHandle(h,id,11),1.2)
        call SetSpecialEffectTimeScale(LoadEffectHandle(h,id,12),1.2)
        call PauseUnit(u,false)
        call SetUnitInvulnerable(u,false)
        call SetUnitTimeScale(u,1)
        call PauseTimer(t)
        call DestroyTimer(t)
        call DestroyGroup(g)
        call DestroyGroup(g2)
        call FlushChildHashtable(h,id)
        call FlushChildHashtable(h,l__idg)
    endif
    set g=null
    set l__d=null
    set g2=null
    set g3=null
    set u=null
    set p=null
    set t=null
endfunction

function TobiramaRCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit l__d
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1
    local real y1
    local player p=GetOwningPlayer(u)
    local real a=LoadReal(h,id,3)
    local integer an=-2
    local group g=LoadGroupHandle(h,id,6)
    loop
        exitwhen an==3
        set n=CreateUnit(p,'e143',x+130*Cos(a+65*an*bj_DEGTORAD),y+130*Sin(a+65*an*bj_DEGTORAD),a*bj_RADTODEG+8*an)
        call GroupAddUnit(g,n)
        call SaveReal(h,GetHandleId(n),0,2500)
        set an=an+1
    endloop
    set EFF=AddSpecialEffect("WaterFag2.mdx",x+220*Cos(a+125*bj_DEGTORAD),y+220*Sin(a+125*bj_DEGTORAD))
    call SetSpecialEffectAnimation(EFF,"birth")
    call SetSpecialEffectScale(EFF , 0.75)
    call SetSpecialEffectTimeScale(EFF , 4)
    call SetSpecialEffectZ(EFF , 25)
    call SetSpecialEffectFacing(EFF , a* bj_RADTODEG+20)
    call SetSpecialEffectAlpha(EFF,125)
    call RemoveEffect(EFF,1.3,true,CreateTimer())
    call SaveEffectHandle(h,id,11,EFF)
    set EFF=AddSpecialEffect("WaterFag3.mdx",x+220*Cos(a-125*bj_DEGTORAD),y+220*Sin(a-125*bj_DEGTORAD))
    call SetSpecialEffectAnimation(EFF,"birth")
    call SetSpecialEffectScale(EFF , 0.75)
    call SetSpecialEffectTimeScale(EFF , 4)
    call SetSpecialEffectZ(EFF , 25)
    call SetSpecialEffectFacing(EFF , a* bj_RADTODEG-20)
    call SetSpecialEffectAlpha(EFF,125)
    call RemoveEffect(EFF,1.3,true,CreateTimer())
    call SaveEffectHandle(h,id,12,EFF)
    call PauseTimer(t)
    set soundplay=SndN(4319) // Sound\Music\mp3Music\TobiramaR2.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call TimerStart(t,0.03,true,function TobiramaRCast3)
    set u=null
    set p=null
    set l__d=null
    set g=null
    set t=null
endfunction

function TobiramaRCastP2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local player p=GetOwningPlayer(u)
    local real a=LoadReal(h,id,3)
    local real time=LoadReal(h,id,11)
    call SaveReal(h,id,11,time+0.1)
    if time==0.1 then
        set EFF=AddSpecialEffect("WaterWave3.mdx",x,y)
        call SetSpecialEffectScale(EFF , 5.05)
        call SetSpecialEffectZ(EFF , 15)
        call SetSpecialEffectVertexColour(EFF,200,200,200,95)
        call SetSpecialEffectTimeScale(EFF , 2)
        call RemoveEffect(EFF,1.8,true,CreateTimer())
    endif
    if time==0.2 then
        set EFF=AddSpecialEffect("WaterWave3.mdx",x,y)
        call SetSpecialEffectScale(EFF , 4)
        call SetSpecialEffectZ(EFF , 90)
        call SetSpecialEffectVertexColour(EFF,200,200,200,95)
        call SetSpecialEffectTimeScale(EFF , 2)
        call RemoveEffect(EFF,1.65,true,CreateTimer())
    endif
    if time==0.3 then
        set EFF=AddSpecialEffect("WaterWave3.mdx",x,y)
        call SetSpecialEffectScale(EFF , 4)
        call SetSpecialEffectZ(EFF , 165)
        call SetSpecialEffectVertexColour(EFF,200,200,200,95)
        call SetSpecialEffectTimeScale(EFF , 2)
        call RemoveEffect(EFF,1.5,true,CreateTimer())
    endif
    if time==0.4 then
        set EFF=AddSpecialEffect("WaterWave3.mdx",x,y)
        call SetSpecialEffectScale(EFF , 4)
        call SetSpecialEffectZ(EFF , 240)
        call SetSpecialEffectVertexColour(EFF,200,200,200,95)
        call SetSpecialEffectTimeScale(EFF , 2)
        call RemoveEffect(EFF,1.35,true,CreateTimer())
    endif
    if time==0.5 then
        set EFF=AddSpecialEffect("WaterWave3.mdx",x,y)
        call SetSpecialEffectScale(EFF , 4)
        call SetSpecialEffectZ(EFF , 310)
        call SetSpecialEffectVertexColour(EFF,200,200,200,95)
        call SetSpecialEffectTimeScale(EFF , 2)
        call RemoveEffect(EFF,1.2,true,CreateTimer())
    endif
    if time==0.6 then
        call PauseTimer(t)
        call TimerStart(t,0.2,false,function TobiramaRCast2)
    endif
    set u=null
    set t=null
    set p=null
endfunction

function TobiramaRCast takes unit u, real x1, real y1 returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local player p=GetOwningPlayer(u)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real a=Atan2(y1-y,x1-x)
    call SaveUnitHandle(h,id,0,u)
    call SaveReal(h,id,2,0)
    call SaveReal(h,id,3,a)
    call SaveReal(h,id,4,1500)
    call SaveReal(h,id,7,0.1)
    call SaveReal(h,id,8,1.2)
    call SaveInteger(h,id,5,-3)
    call SaveGroupHandle(h,id,6,CreateGroup())
    call SaveGroupHandle(h,id,10,CreateGroup())
    call SaveReal(h,id,11,0)
    call SetUnitTimeScale(u,2)
    call SetUnitAnimationByIndex(u,3)
    call PauseUnit(u,true)
    call SetUnitInvulnerable(u,true)
    set soundplay=SndN(4321) // Sound\Music\mp3Music\TobiramaR1.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set EFF=AddSpecialEffect("whirlpool.mdx",x,y)
    call SetSpecialEffectScale(EFF , 0.75)
    call SetSpecialEffectTimeScale(EFF , 2.5)
    call SetSpecialEffectFacing(EFF , a* bj_RADTODEG)
    call RemoveEffect(EFF,1.5,true,CreateTimer())
    call TimerStart(t,0.1,true,function TobiramaRCastP2)
    set u=null
    set p=null
    set t=null
endfunction

function TobiramaTCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(HH,id,0)
    local unit l__d=LoadUnitHandle(HH,id,7)
    local real x=GetUnitX(l__d)
    local real y=GetUnitY(l__d)
    local real x1=LoadReal(HH,id,2)
    local real y1=LoadReal(HH,id,3)
    local real f=GetUnitFacing(u)
    local player p=GetOwningPlayer(u)
    local real dmg=GetHeroInt(u,true)*15
    local real dist=SR(x,y,x1,y1)
    local real a=Atan2(y1-y,x1-x)
    local real he=0
    local effect ef = null
    local real dist2=LoadReal(HH,id,100)
    local real AoE=LoadReal(HH,id,4)
    local real time=LoadReal(HH,id,8)
    if dist>50.00 and IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false and udg_B==true and DU2==true then
        set x=x+40*Cos(a)
        set y=y+40*Sin(a)
        call SetUnitFacing(u,a*bj_RADTODEG)
        call SetUnitXY_1(l__d,x,y, false)
    else
        if time==0 then
            set soundplay=SndN(4323) // Sound\Music\mp3Music\TobiramaT2.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        endif
        call SaveReal(HH,id,8,time+0.03)
        if time==1.5 then
            set ef=AddSpecialEffect("war3mapImported\\[DoFT]Natsu_Fire_Ball_n.mdl",x1,y1)
            call SetSpecialEffectScale(ef , 1.6)
            call SetSpecialEffectTimeScale(ef , 0.7)
            call SetSpecialEffectVertexColour(ef,255,255,255,65)
            call DestroyEffect(ef)
            set ef=AddSpecialEffect("Moon_texiao_kali_tantiaozhadan_01_Boom-2.mdl",x1,y1)
            call SetSpecialEffectScale(ef , 1.8)
            call SetSpecialEffectTimeScale(ef , 0.7)
            call DestroyEffect(ef)
        endif
        if time<3.15 then
            if ModuloReal(time,0.12)==0.03 then
                set ef=AddSpecialEffect("TobiramaSealsKibakufuda.mdx",x1+GetRandomReal(-AoE*0.8,AoE*0.8)*Cos(GetRandomReal(0,359)*bj_DEGTORAD),y1+GetRandomReal(-AoE*0.8,AoE*0.8)*Sin(GetRandomReal(0,359)*bj_DEGTORAD))
                call SetSpecialEffectScale(ef , 1.3)
                call SetSpecialEffectZ(ef , ParabolaZ(200*time,2*AoE,AoE-SR(x1,y1,GetSpecialEffectX(ef),GetSpecialEffectY(ef))))
                call SetSpecialEffectTimeScale(ef , 1.2)
                call SetSpecialEffectPitch(ef , Atan2(y1-GetSpecialEffectY(ef),x1-GetSpecialEffectX(ef)) * bj_RADTODEG+45)
                call RemoveEffect(ef,0.7,true,CreateTimer())
            endif
            if time>0.15 then
                if AoE>=1000 then
                    call GroupEnumUnitsInRange(G,x1,y1,1000,Base)
                else
                    call GroupEnumUnitsInRange(G,x1,y1,AoE,Base)
                    call SaveReal(HH,id,4,AoE+24.2)
                endif
                if ModuloReal(time,0.21)==0.03 then
                    set n=CreateUnit(p,'eTm1',x1+GetRandomReal(-AoE*0.75,AoE*0.75)*Cos(GetRandomReal(0,359)*bj_DEGTORAD),y1+GetRandomReal(-AoE*0.75,AoE*0.75)*Sin(GetRandomReal(0,359)*bj_DEGTORAD),GetRandomReal(0,359))
                    call SetUnitFlyHeight(n,GetRandomReal(0,ParabolaZ(200*time,2*AoE,AoE-SR(GetUnitX(n),GetUnitY(n),x1,y1))),0)
                    call UnitApplyTimedLife(n,'BHwe',0.7)
                endif
                if time>1.2 and ModuloReal(time,0.15)==0.03 then
                    set n=CreateUnit(p,'eTm3',x1+GetRandomReal(-AoE*0.75,AoE*0.75)*Cos(GetRandomReal(0,359)*bj_DEGTORAD),y1+GetRandomReal(-AoE*0.75,AoE*0.75)*Sin(GetRandomReal(0,359)*bj_DEGTORAD),GetRandomReal(0,359))
                    call SetUnitFlyHeight(n,GetRandomReal(0,ParabolaZ(200*time,2*AoE,AoE-SR(GetUnitX(n),GetUnitY(n),x1,y1))),0)
                    call UnitApplyTimedLife(n,'BHwe',0.7)
                endif
                loop
                    set E=FirstOfGroup(G)
                    exitwhen E==null
                    if Condition_Base(p,E)then
                        call myCustomDamage(u,E,dmg/100,false,false,null,null,null)
                        if ModuloReal(time,0.25)<0.01 then
                            call SetControlToUnit(E,E, 0.1, "stun")
                        endif
                    endif
                    call GroupRemoveUnit(G,E)
                endloop
            endif
        else
            call KillUnit(l__d)
            call FlushChildHashtable(HH,id)
            call PauseTimer(t)
            call DestroyTimer(t)
        endif
    endif
    set u=null
    set t=null
    set ef=null
    set l__d=null
    set p=null
endfunction

function TobiramaTCast takes unit u, real x1, real y1 returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local real f=GetUnitFacing(u)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real a=Atan2(y1-y,x1-x)
    local player p=GetOwningPlayer(u)
    if SR(x,y,x1,y1)<101 then
        call SaveReal(HH,id,100,600)
    else
        call SaveReal(HH,id,100,SR(x,y,x1,y1))
    endif
    call SaveUnitHandle(HH,id,0,u)
    call SaveReal(HH,id,2,x1)
    call SaveReal(HH,id,3,y1)
    call SaveReal(HH,id,4,200)
    call SaveReal(HH,id,8,0)
    set n=CreateUnit(p,'eTm2',x,y,a*bj_RADTODEG)
    call SaveUnitHandle(HH,id,7,n)
    set soundplay=SndN(4326) // Sound\Music\mp3Music\TobiramaT1.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call TimerStart(t,0.03,true,function TobiramaTCast2)
    set u=null
    set p=null
    set t=null
endfunction

function TobiramaDCast takes unit u returns nothing
    local timer t = CreateTimer()
    local unit c
    local integer i=0
    local integer id = GetHandleId(t)
    local integer idu = GetHandleId(u)
    local effect ef = null
    local group g=CreateGroup()
    set soundplay=SndN(4328) // Sound\Music\mp3Music\TobiramaFSelf.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set n=CreateUnit(GetOwningPlayer(u),'H34X',GetUnitX(u)+125*Cos(GetRandomReal(0,359)*bj_DEGTORAD),GetUnitY(u)+125*Sin(GetRandomReal(0,359)*bj_DEGTORAD),GetRandomReal(0,359))
    if IsUnitAlly(n,GetLocalPlayer()) then
        call SetUnitVertexColor(n,155,155,255,255)
    endif
    set ef=AddSpecialEffect("war3mapImported\\Poff.mdx",GetUnitX(n),GetUnitY(n))
    call SetSpecialEffectScale(ef,0.2)
    call SetSpecialEffectZ(ef,55)
    call DestroyEffect(ef)
    call SetHeroLevel(n,GetHeroLevel(u),false)
    call SetHeroAgi(n,GetHeroAgi(u,false),true)
    call SetHeroStr(n,GetHeroStr(u,false),true)
    call SetHeroInt(n,GetHeroInt(u,false),true)
    call SetUnitCurrentSight(n,600)
    call SetUnitUseFood(n,true)
    call UnitInventorySetSize(n,10)
    loop
    exitwhen i>=10
    if GetItemTypeId(UnitItemInSlot(u,i))!='Io39' then
        set bj_lastCreatedItem=UnitAddItemById(n,GetItemTypeId(UnitItemInSlot(u,i)))
        call SetItemDroppable(bj_lastCreatedItem,false)
        //call StartItemCooldown(bj_lastCreatedItem,9999)
    endif
    set i=i+1
    endloop
    call UnitEnableInventoryCustom(n,false,false)
    call SetUnitState(n,UNIT_STATE_LIFE,GetWidgetLife(u))
    call SetUnitState(n,UNIT_STATE_MANA,GetWidgetMana(u))
    call UnitApplyTimedLife(n,'BTLF',30)
    set c=null
    set g=null
    set t=null
    set ef=null
endfunction


function TobiramaF2Cast takes unit u, real x1, real y1 returns nothing
    local timer t = CreateTimer()
    local unit c
    local integer id = GetHandleId(t)
    local player p=GetOwningPlayer(u)
    local integer idp = GetPlayerId(p)
    local effect ef = null
    local group g=CreateGroup()
    if GetWidgetMana(Hero[idp])>=200 then
        call SetWidgetMana(Hero[idp],GetWidgetMana(Hero[idp])-200)
        call GroupEnumUnitsInRange(G,x1,y1,1000,Base)
        loop
            set E=FirstOfGroup(G)
            exitwhen E==null
            if (GetUnitAbilityLevel(E,'TMF1')>0 or GetUnitTypeId(E)=='H34X' or GetUnitTypeId(E)=='H34Z') and u!=E and SR(GetUnitX(u),GetUnitY(u),GetUnitX(E),GetUnitY(E))<3000 then
                call GroupAddUnit(g,E)
            endif
            call GroupRemoveUnit(G,E)
        endloop
        if LoadUnitHandle(HH,GetHandleId(Hero[idp]),SH_TobiramaW_Kunai)!=null then
            if SR(x1,y1,GetUnitX(LoadUnitHandle(HH,GetHandleId(Hero[idp]),SH_TobiramaW_Kunai)),GetUnitY(LoadUnitHandle(HH,GetHandleId(Hero[idp]),SH_TobiramaW_Kunai)))<1000 then
                call GroupAddUnit(g,LoadUnitHandle(HH,GetHandleId(Hero[idp]),SH_TobiramaW_Kunai))
            endif
        endif
        set E=FirstOfGroup(g)
        if E==null then
            call DisplayTimedWarningMessage(GetOwningPlayer(u),10,Lng("Нет подходящей цели для Hiraishin no Jutsu.","There is no suitable target for Hiraishin no Jutsu."))
        else
            set c=E
            loop
            set E=FirstOfGroup(g)
            exitwhen E==null
            if SR(x1,y1,GetUnitX(E),GetUnitY(E))<=SR(x1,y1,GetUnitX(c),GetUnitY(c)) then
                set c=E
            endif
            call GroupRemoveUnit(g,E)
            endloop
            call DestroyGroup(g)
            set ef=AddSpecialEffect("TobiramaHiraishin.mdl",GetUnitX(u),GetUnitY(u))
            call SetSpecialEffectScale(ef,0.57)
            call SetSpecialEffectZ(ef,115)
            call DestroyEffect(ef)
            set ef=AddSpecialEffect("TobiramaHiraishin2.mdl",GetUnitX(u),GetUnitY(u))
            call SetSpecialEffectScale(ef,1.5)
            call SetSpecialEffectZ(ef,115)
            call DestroyEffect(ef)
            call SetUnitXY_1(u,GetUnitX(c)+65*Cos(GetRandomReal(0,359)*bj_DEGTORAD),GetUnitY(c)+65*Sin(GetRandomReal(0,359)*bj_DEGTORAD),false)
            set ef=AddSpecialEffect("TobiramaHiraishin.mdl",GetUnitX(u),GetUnitY(u))
            call SetSpecialEffectScale(ef,0.57)
            call SetSpecialEffectZ(ef,115)
            call DestroyEffect(ef)
            set ef=AddSpecialEffect("TobiramaHiraishin2.mdl",GetUnitX(u),GetUnitY(u))
            call SetSpecialEffectScale(ef,1.5)
            call SetSpecialEffectZ(ef,115)
            call DestroyEffect(ef)
            if c==LoadUnitHandle(HH,GetHandleId(Hero[idp]),SH_TobiramaW_Kunai) then
                call SaveBoolean(HH, GetHandleId(Hero[idp]), SH_TobiramaW_Blink3, true)
            endif
            set soundplay=SndN(4306) // Sound\Music\mp3Music\TobiramaF.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        endif
    else
        call DisplayTimedWarningMessage(GetOwningPlayer(u),10,Lng("Недостаточно маны у оригинала.","The original doesn't have enough mana."))
    endif
    set c=null
    set p=null
    set g=null
    set t=null
    set ef=null
endfunction

function TobiramaFCast takes unit u, real x1, real y1 returns nothing
    local timer t = CreateTimer()
    local unit c
    local integer i=0
    local integer id = GetHandleId(t)
    local integer idu = GetHandleId(u)
    local effect ef = null
    local group g=CreateGroup()
    call GroupEnumUnitsInRange(G,x1,y1,1000,Base)
    loop
        set E=FirstOfGroup(G)
        exitwhen E==null
        if (GetUnitAbilityLevel(E,'TMF1')>0 or GetUnitTypeId(E)=='H34X' or GetUnitTypeId(E)=='H34Z') and u!=E and SR(GetUnitX(u),GetUnitY(u),GetUnitX(E),GetUnitY(E))<3000 then
            call GroupAddUnit(g,E)
        endif
        call GroupRemoveUnit(G,E)
    endloop
    if LoadUnitHandle(HH,idu,SH_TobiramaW_Kunai)!=null then
        if SR(x1,y1,GetUnitX(LoadUnitHandle(HH,idu,SH_TobiramaW_Kunai)),GetUnitY(LoadUnitHandle(HH,idu,SH_TobiramaW_Kunai)))<1000 then
            call GroupAddUnit(g,LoadUnitHandle(HH,idu,SH_TobiramaW_Kunai))
        endif
    endif
    set E=FirstOfGroup(g)
    if E==null then
        call DisplayTimedWarningMessage(GetOwningPlayer(u),10,Lng("Нет подходящей цели для Hiraishin no Jutsu.","There is no suitable target for Hiraishin no Jutsu."))
    else
        set c=E
        loop
        set E=FirstOfGroup(g)
        exitwhen E==null
        if SR(x1,y1,GetUnitX(E),GetUnitY(E))<=SR(x1,y1,GetUnitX(c),GetUnitY(c)) then
            set c=E
        endif
        call GroupRemoveUnit(g,E)
        endloop
        call DestroyGroup(g)
        set ef=AddSpecialEffect("TobiramaHiraishin.mdl",GetUnitX(u),GetUnitY(u))
        call SetSpecialEffectScale(ef,0.57)
        call SetSpecialEffectZ(ef,115)
        call DestroyEffect(ef)
        set ef=AddSpecialEffect("TobiramaHiraishin2.mdl",GetUnitX(u),GetUnitY(u))
        call SetSpecialEffectScale(ef,1.5)
        call SetSpecialEffectZ(ef,115)
        call DestroyEffect(ef)
        call SetUnitXY_1(u,GetUnitX(c)+65*Cos(GetRandomReal(0,359)*bj_DEGTORAD),GetUnitY(c)+65*Sin(GetRandomReal(0,359)*bj_DEGTORAD),false)
        set ef=AddSpecialEffect("TobiramaHiraishin.mdl",GetUnitX(u),GetUnitY(u))
        call SetSpecialEffectScale(ef,0.57)
        call SetSpecialEffectZ(ef,115)
        call DestroyEffect(ef)
        set ef=AddSpecialEffect("TobiramaHiraishin2.mdl",GetUnitX(u),GetUnitY(u))
        call SetSpecialEffectScale(ef,1.5)
        call SetSpecialEffectZ(ef,115)
        call DestroyEffect(ef)
        if c==LoadUnitHandle(HH,idu,SH_TobiramaW_Kunai) then
            call SaveBoolean(HH, idu, SH_TobiramaW_Blink3, true)
        endif
        call UnitRemoveAbility(c,'TMF1')
        set soundplay=SndN(4306) // Sound\Music\mp3Music\TobiramaF.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    endif
    set c=null
    set g=null
    set t=null
    set ef=null
endfunction

function TobiramaGCast takes unit u returns nothing
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local player p=GetOwningPlayer(u)
    local group g=CreateGroup()
    set soundplay=SndN(4330) // Sound\Music\mp3Music\TobiramaG.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call SetUnitAnimationByIndex(u,3)
    call GroupEnumUnitsInRange(g,x,y,1200,Base)
    loop
    set E=FirstOfGroup(g)
    exitwhen E==null
    if Condition_Base(p,E)then
    call SetControlToUnit(E,E,6,"blind")
    endif
    call GroupRemoveUnit(g,E)
    endloop
    set n=CreateUnit(p,'e0MN',x,y,0)
    call SetUnitScale(n,2,2,2)
    call UnitApplyTimedLife(n,'BTLF',5)
    call DestroyGroup(g)
    set g=null
    set p=null
    set u=null
endfunction

function Trig_TobiramaInt_Actions takes nothing returns nothing
    local unit u=GetSpellAbilityUnit()
    local integer idu=GetHandleId(u)
    local real a=0
    if GetSpellAbilityId()=='TMD0' then
        call TobiramaDCast(u)
    endif
    if GetSpellAbilityId()=='TMF0' then
        call TobiramaFCast(u,GetSpellTargetX(), GetSpellTargetY())
    endif
    if GetSpellAbilityId()=='TMF2' then
        call TobiramaF2Cast(u,GetSpellTargetX(), GetSpellTargetY())
    endif
    if GetSpellAbilityId()=='TMQ0' then
        call TobiramaQCast(u, GetSpellTargetX(), GetSpellTargetY())
    endif
    if GetSpellAbilityId() == 'TMW0' then
        call TobiramaWCast(u , GetSpellTargetX() , GetSpellTargetY() , CreateTimer())
    endif
    if GetSpellAbilityId() == 'TMW1' then
        
        if LoadUnitHandle(HH, idu, SH_TobiramaW1_Target)!=null then
            set n=CreateUnit(GetOwningPlayer(u), 'eTm6', GetUnitX(u), GetUnitY(u), GetRandomInt(0, 360))
            call MyRemoveUnit(n , 1.5)
            set n=CreateUnit(GetOwningPlayer(u), 'eTm7', GetUnitX(u), GetUnitY(u), GetRandomInt(0, 360))
            call MyRemoveUnit(n , 1.5)
            set a=AtanPoint(GetUnitX(u) , GetUnitY(u) , GetUnitX(LoadUnitHandle(HH, idu, SH_TobiramaW1_Target)) , GetUnitY(LoadUnitHandle(HH, idu, SH_TobiramaW1_Target)))
            call SetUnitFacingInstant(u, a * bj_RADTODEG)
            call SetUnitX(u, GetUnitX(LoadUnitHandle(HH, idu, SH_TobiramaW1_Target))-200*Cos(a))
            call SetUnitY(u, GetUnitY(LoadUnitHandle(HH, idu, SH_TobiramaW1_Target))-200*Sin(a))
            set n=CreateUnit(GetOwningPlayer(u), 'eTm6', GetUnitX(u), GetUnitY(u), GetRandomInt(0, 360))
            call MyRemoveUnit(n , 1.5)
            set n=CreateUnit(GetOwningPlayer(u), 'eTm7', GetUnitX(u), GetUnitY(u), GetRandomInt(0, 360))
            call MyRemoveUnit(n , 1.5)
            call TobiramaW2Cast(u , a , 700 , CreateTimer())
            set soundplay=SndN(4306) // Sound\Music\mp3Music\TobiramaF.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        else
            call SaveBoolean(HH, idu, SH_TobiramaW_Blink, true)
        endif
    endif
    if GetSpellAbilityId()=='TME0' then
        call TobiramaECast(u, GetSpellTargetUnit())
    endif
    if GetSpellAbilityId()=='TMR0' then
        call TobiramaRCast(u, GetSpellTargetX(), GetSpellTargetY())
    endif
    if GetSpellAbilityId()=='TMT0' then
        call TobiramaTCast(u, GetSpellTargetX(), GetSpellTargetY())
    endif
    if GetSpellAbilityId()=='TMG0' then
        call TobiramaGCast(u)
    endif
    set u=null
endfunction

function InitTrig_TobiramaInt takes nothing returns nothing
    local trigger trig  = CreateTrigger(  )
    local integer index = 0
    loop
        call TriggerRegisterPlayerUnitEvent(trig, Player(index), EVENT_PLAYER_UNIT_SPELL_EFFECT, null)
        set index = index + 1
        exitwhen index == bj_MAX_PLAYER_SLOTS
    endloop
    call TriggerAddAction( trig, function Trig_TobiramaInt_Actions )
    set trig=null
endfunction

//Gojo5Start
function AbilityCD takes unit u,integer abili_id,real time0 returns nothing

call StartAbilityCooldown(GetUnitAbility(u, abili_id), time0)

endfunction

function GetUnitAbilityCD takes unit u,integer name_abil returns boolean
if GetAbilityRemainingCooldown(GetUnitAbility(u, name_abil))>0 then
return true
else
return false
endif
endfunction



function UnitPathingTimed_Act takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,1)
local real time=LoadReal(HH,id,5)
local real maxtime=LoadReal(HH,id,6)
set time=time+0.1
call SaveReal(HH,id,5,time)
call SetUnitPathing(u,false)
if time>=maxtime then
call UnitRemoveAbility(u,'AUP0')
call SetUnitPathing(u,true)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set u=null
set t=null
endfunction
function UnitPathingTimed takes unit u,real time returns nothing
local timer t=null
local integer id=0
if GetUnitAbilityLevel(u,'AUP0')==0 then
call UnitAddAbility(u,'AUP0')
set t=CreateTimer()
set id=GetHandleId(t)
call SaveUnitHandle(HH,id,1,u)
call SaveReal(HH,id,6,time)
call SetUnitPathing(u,false)
call TimerStart(t,0.1,true,function UnitPathingTimed_Act)
endif
set t=null
endfunction
function AbilAdd2Paused takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local integer abil=LoadInteger(HH,id,1)
local real time=LoadReal(HH,id,5)
local real maxtime=LoadReal(HH,id,6)
if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Avul')==0 then
set time=time+0.1
call SaveReal(HH,id,5,time)
endif
if time>=maxtime then
call UnitRemoveAbility(u,abil)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set u=null
set t=null
endfunction
function UnitAddAbilityTimedPaused takes unit u,real time,integer abil returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(HH,id,0,u)
call SaveInteger(HH,id,1,abil)
call UnitAddAbility(u,abil)
call SaveReal(HH,id,6,time)
call TimerStart(t,0.1,true,function AbilAdd2Paused)
set t=null
endfunction

//UraharaDStart вЂ” РїРµСЂРµРЅРµСЃРµРЅРѕ РёР· Choice Random 4.5
function sound_play takes string sound_name,integer sound_volume returns nothing
set soundplay=SndByPath(sound_name) // звук из массива soundStr
call StartSound(soundplay)
call SetSoundVolume(soundplay,sound_volume)
endfunction
function IsUnitTrueHero takes unit caster0 returns boolean

if GetUnitTypeId(caster0)=='H007'  or GetUnitTypeId(caster0)=='H03Y'  or GetUnitTypeId(caster0)=='Ho13'  or GetUnitTypeId(caster0)=='H34X'  or GetUnitTypeId(caster0)=='HASC' or GetUnitTypeId(caster0)=='HSaC'  then

return false

else

return true

endif


endfunction

function Urahara_D_Act2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local unit Dummy=LoadUnitHandle(HH,id,20)
local group gr=LoadGroupHandle(HH,id,4)
local real time=LoadReal(HH,id,5)
local real time1=LoadReal(HH,id,6)
local real time2=LoadReal(HH,id,8)
local real x0=GetUnitX(Dummy)
local real y0=GetUnitY(Dummy)
//local player player_ID=GetOwningPlayer(caster) лучше не использовать переменные типа player лучше через id 
local real heal=I2R(GetHeroInt(caster,true))



if time1<=0 then// ФАЗА 0 — высвобождение (реальное время, звук идёт); лечение УЖЕ работает
call SaveReal(HH,id,5,time+0.02)
if UnitIsAlive(caster)==false  or  udg_B==false then
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
call DestroyEffect(LoadEffectHandle(HH,id,10))     // снять ауру каста
//call UkBkEnd(caster,e,gr,t,id)



call SetUnitAbilityLevel(caster,'UKD2',1)

//call UnitRemoveAbility(caster,'UkBs')                  // снять +30 статов
call UnitRemoveAbility(caster,'UKD3')                  // снять макс. скорость

call SetAbilityCooldown(GetUnitAbility(caster,'A07P'),10.0)          // вернуть Sonido КД
call SetAbilityRemainingCooldown(GetUnitAbility(caster,'UKD1'),40.0) // КД нормализуется до 40 c ПОСЛЕ формы (базовый Cool=65 держал скилл в откате всю форму)
//call MyRemoveUnit(Dummy,0)   //незачем использовать тут таймер можно просто удалить                         // убрать фигуру

call RemoveUnit(Dummy)

call DestroyGroup(gr)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)

else

//call SetWidgetLife(caster, GetWidgetLife(caster)+0.25*heal)     // хил 0.5*INT/сек уже в высвобождении (пауза не мешает SetUnitState)


if time>=4 then                                     // 7.5 c -> каст окончен, ВКЛЮЧАЕМ бафф
call DestroyEffect(LoadEffectHandle(HH,id,10))     // снять ауру каста
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)

call SetUnitAbilityLevel(caster,'UKD2',3)
//call UnitAddAbility(caster,'UkBs')                      // +30 все статы (item-abil, не сеттер!)
//call UnitAddAbility(caster,'UKD3')                      // макс. скорость (900)


call UnitAddAbilityTimedPaused(caster,15,'UKD3')



call CreateModeIndicatorWithPauseForm(caster,"ReplaceableTextures\\CommandButtons\\BTNUraharaD.blp",15)  // индикатор формы в UjAPI-панели
call SetAbilityRemainingCooldown(GetUnitAbility(caster,'A07P'),0.01) // сбросить Sonido
call SetAbilityCooldown(GetUnitAbility(caster,'A07P'),6.0)           // и на время формы = 2 c
call SaveReal(HH,id,6,1)

call SaveReal(HH,id,5,0)                         // сброс счётчика на фазу баффа
endif

endif

else
// ФАЗА 1 — бафф активен 25 c; ЗАМИРАЕТ на паузе/скрытии
if UnitIsAlive(caster)==false or GetUnitAbilityLevel(caster,'UKD3')==0 or  udg_B==false then
//call UkBkEnd(caster,e,gr,t,id) незачем так завершать скил

//call UnitRemoveAbility(caster,'UKD2')                  // снять +30 статов
call UnitRemoveAbility(caster,'UKD3')                  // снять макс. скорость
call SetUnitAbilityLevel(caster,'UKD2',1)
call SetAbilityCooldown(GetUnitAbility(caster,'A07P'),10.0)          // вернуть Sonido КД
call SetAbilityRemainingCooldown(GetUnitAbility(caster,'UKD1'),40.0) // КД нормализуется до 40 c ПОСЛЕ формы (базовый Cool=65 держал скилл в откате всю форму)

//call MyRemoveUnit(Dummy,0)   незачем использовать тут таймер можно просто удалить                         // убрать фигуру

call RemoveUnit(Dummy)                        


call DestroyGroup(gr)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)






else

if IsUnitPaused(caster)==false and IsUnitHidden(caster)==false then
call SaveReal(HH,id,5,time+0.02)

set time2=time2+0.02

if time2>=0 then

set time2=-1

// хил 0.25*INT/тик = 0.5*INT/сек
call HealTextTag(caster,caster,0.3*heal*myCustomHeal2(caster,1),"HealthRes")
call SetUnitState(caster,UNIT_STATE_LIFE, GetUnitState(caster,UNIT_STATE_LIFE)+0.3*heal)

endif

call SaveReal(HH,id,8,time2)

call GroupEnumUnitsInRange(G,x0,y0,2000,Base)       // урон ПО ВХОДУ в зону, 1 раз на цель

loop
set n0=FirstOfGroup(G) //лучше вместо E использовать n0 для изменения в случае чего
exitwhen n0==null
if Condition_Base( GetOwningPlayer(caster) ,n0)and IsUnitInGroup(n0,gr)==false then
call myCustomDamage(caster,n0,3*heal,false,false,null,null,null)          // 3*INT

set EFF=AddSpecialEffectTarget("Others\\blood pack (12).mdx",n0,"origin")  // эффект попадания
call SetSpecialEffectTimeScale(EFF,4.0)          // 4x скорость: Death-анимация 1.1c -> ~0.27c ("попал и сразу пропал")
call DestroyEffect(EFF)

call GroupAddUnit(gr,n0)
endif
call GroupRemoveUnit(G,n0)


endloop
endif

endif
endif



set caster=null
set Dummy=null
set gr=null
//set p=null
set t=null

endfunction
function Urahara_D_Act takes unit caster returns nothing
//вместо u лучше использовать caster для удобной замены
local real facing=GetUnitFacing(caster)//вместо f лучше полное слово facing ( так как проще заменять в случае чего)
local real ang=facing+180.0
local real x0=PolX(GetUnitX(caster),120.0,ang) //bx by лучше просто x0 y0 (используется в большинстве скилов)
local real y0=PolY(GetUnitY(caster),120.0,ang)
local timer t=CreateTimer()
local integer id=GetHandleId(t)

set n0=CreateUnit(GetOwningPlayer(caster),'e200',x0,y0,facing)
//вместо юнита e лучше использовать глобального n0
call SetUnitModel(n0,"Others\\Kannonbiraki Benihime Aratame.mdx")
//call UnitAddAbility(n0,'Amrf')                     // не нужно т.к. есть у дамика
//call UnitRemoveAbility(n0,'Amrf')
call SetUnitFlyHeight(n0,-620.0,0)                 // спрятать под землю...
call SetUnitFlyHeight(n0,0.0,320.0)                // ...и поднять = вылезает
call UnitScale(n0,0.5,4.2,2.2)                     // масштаб 4.2, растёт из 0.5
call SaveUnitHandle(HH,id,20,n0)

call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call SaveUnitHandle(HH,id,1,caster)

//call SaveInteger(HH,id,2,0) //незачем сохранять 0 ибо изначально всегда 0
//call SaveInteger(HH,id,4,0)                        // фаза 0 
call SaveGroupHandle(HH,id,4,CreateGroup())//группы лучше сохранять под айди 4 а не 3 т.к. я всегда использую 4 и 41 для групп
call SaveEffectHandle(HH,id,10,AddSpecialEffectTarget("Others\\ars2 (1172).mdl",caster,"origin"))  // лучше использовать 10 для єффектов на героях тоже использую 10 15 25-30           пафосная аура на время каста (снимается в конце фазы 0)
call TimerStart(t,0.02,true,function Urahara_D_Act2)//лучше использовать меньше таймеры для удобных периодиков с эффектами

call sound_play("Sound\\Others\\Urahara_D.mp3",127)

//call KillSoundWhenDone(soundplay) нет смысла использовать т.к. ибо первый раз не будет звука
set caster=null
set n0=null 
set t=null
endfunction
//UraharaDEnd


function Gojo_Q2_Self_Act2 takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit Dummy=LoadUnitHandle(HH,id,20)
local real time=LoadReal(HH,id,5)
local real time1=LoadReal(HH,id,6)
local real x0=GetUnitX(Dummy)
local real y0=GetUnitY(Dummy)
local real x1=LoadReal(HH,id,11)
local real y1=LoadReal(HH,id,12)
local real damage=LoadReal(HH,id,15)
local real facing=LoadReal(HH,id,3)
set time=time+0.02
call SaveReal(HH,id,5,time)
if time>2.5+GetUnitAbilityLevel(caster,'GSQ1')*0.5 then
call UnitSpeed(LoadUnitHandle(HH,id,21),0.5)
call SetUnitAnimationByIndex(LoadUnitHandle(HH,id,20),1)
call SetUnitAnimationByIndex(LoadUnitHandle(HH,id,21),2)
call MyRemoveUnit(LoadUnitHandle(HH,id,20),1)
call MyRemoveUnit(LoadUnitHandle(HH,id,21),1)
call MyRemoveUnit(LoadUnitHandle(HH,id,22),1)
call MyRemoveUnit(LoadUnitHandle(HH,id,23),1)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else
if time==0.02 or time==0.4 or time==0.8 or time==1.2 or time==1.6 then
call EffectCreateAndMove(true,EffectID[23],GetRandomReal(0,360),1.25,1.25,0.5,60,60,100,60,0,caster,0,facing)
call EffectCreateAndMove(true,EffectID[48],GetRandomReal(0,360),1.25,1.5,0.4,100,100,100,30,0,caster,0,facing)
endif
if time==0.02 then
call UnitSpeed(caster,1)
call SetUnitAnimationByIndex(caster,54)
set soundplay=SndN(4332) // Sound\Gojo\Ao_Self_Charge.mp3
call SetSoundVolume(soundplay,150)
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
if time==0.3 then
call UnitSpeed(LoadUnitHandle(HH,id,22),0)
call UnitSpeed(Dummy,1)
call UnitSpeed(caster,1.25)
call SetUnitAnimationByIndex(caster,56)
endif
if time==1.5 then
set soundplay=SndN(4335) // Sound\Gojo\Ao_Self_Charge1.mp3
call SetSoundVolume(soundplay,150)
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
if time<2 then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
endif
if time==2 then
call AbilityCD(caster,'GSQ2',20)
call CreateModeIndicatorForm(caster, "ReplaceableTextures\\CommandButtons\\BTNGojoQ2.blp", 20)
call UnitSpeed(caster,1)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
endif
if time==3 then
set soundplay=SndN(4338) // Sound\Gojo\Ao_Self_Ao.mp3
call SetSoundVolume(soundplay,150)
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
if time<0.2 then
call MoveUnit(Dummy,Dummy,15,facing-90)
call SaveReal(HH,id,11,GetUnitX(Dummy))
call SaveReal(HH,id,12,GetUnitY(Dummy))
endif
if time>0.2 and time<10 then
set facing=facing-4
if time>2 then
call MoveAoe1(x1,y1,Dummy,500,facing)
else
call MoveAoe1(x1,y1,Dummy,(time-0.2)*277,facing)
endif
call SaveReal(HH,id,3,facing)
call GroupClear(G)
call GroupEnumUnitsInRange(G,x0,y0,500,null)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if IsUnitEnemy(n0,GetOwningPlayer(caster))==true and n0!=caster and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(n0,'Avul')==0 then
call UnitPathingTimed(n0,1)
call MoveUnit(n0,n0,40,facing)
if SR(GetUnitX(n0),GetUnitY(n0),GetUnitX(Dummy),GetUnitY(Dummy))>100 then
set facing=Angle2(GetUnitX(n0),GetUnitY(n0),GetUnitX(Dummy),GetUnitY(Dummy))
call MoveUnit(n0,n0,50,facing)
endif
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
endif
call MoveUnit(Dummy,LoadUnitHandle(HH,id,21),0,facing)
call MoveUnit(Dummy,LoadUnitHandle(HH,id,22),0,facing)
call MoveUnit(Dummy,LoadUnitHandle(HH,id,23),0,facing)
set time1=time1+0.02
if time1>=0.22 then
set time1=0
call SetUnitAnimationByIndex(LoadUnitHandle(HH,id,23),0)
call DamageAoeOneTime0(caster,x0,y0,500,damage*0.05)
endif
call SaveReal(HH,id,6,time1)
endif
set caster=null
set Dummy=null
endfunction
function Gojo_Q2_Self_Act takes unit caster returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x0=0
local real y0=0
local real facing=0
local real dist
local real damage=8*GetHeroAgi(caster,true)
local real MaxDist=2000+GetHeroInt(caster,true)*5
call SaveUnitHandle(HH,id,1,caster)
call SaveReal(HH,id,15,damage)
call UnitAddAbilityTimedPaused(caster,4,'GSQ0')
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
set n0=LoadUnitHandle(HH,GetHandleId(caster),SH_GojoQU)
call RemoveSavedHandle(HH,GetHandleId(caster),SH_GojoQU)
call SetUnitModel(n0,EffectID[1317])
set x0=GetUnitX(n0)
set y0=GetUnitY(n0)
set facing=GetUnitFacing(caster)
call UnitSpeed(n0,3)
call SaveReal(HH,id,11,GetUnitX(n0))
call SaveReal(HH,id,12,GetUnitY(n0))
call SaveReal(HH,id,3,facing)
call SaveUnitHandle(HH,id,20,n0)
call SaveBoolean(HH,GetHandleId(caster),SH_GojoQ2act,true)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),GetUnitFacing(caster))
call SetUnitModel(n0,EffectID[1332])
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call UnitSize(n0,3,1,1)
call UnitSpeed(n0,1)
call UnitColor(n0,100,100,100,60)
call SetUnitFlyHeight(n0,150,0)
call SaveUnitHandle(HH,id,21,n0)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),GetUnitFacing(caster))
call SetUnitModel(n0,EffectID[768])
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call UnitSize(n0,1,1,1)
call UnitSpeed(n0,1.5)
call UnitColor(n0,100,100,100,60)
call SetUnitFlyHeight(n0,0,0)
call SaveUnitHandle(HH,id,22,n0)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),GetUnitFacing(caster))
call SetUnitModel(n0,EffectID[44])
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call UnitSize(n0,1.1,1,1)
call UnitSpeed(n0,1.1)
call UnitColor(n0,80,80,100,40)
call SetUnitFlyHeight(n0,150,0)
call SaveUnitHandle(HH,id,23,n0)
call TimerStart(t,0.02,true,function Gojo_Q2_Self_Act2)
set n0=null
set t=null
endfunction
function Gojo_Q2_Act2 takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit Dummy=LoadUnitHandle(HH,id,20)
local real time=LoadReal(HH,id,5)
local real time1=LoadReal(HH,id,6)
local real x0=GetUnitX(Dummy)
local real y0=GetUnitY(Dummy)
local real x1=LoadReal(HH,id,11)
local real y1=LoadReal(HH,id,12)
local real dist=SR(x0,y0,x1,y1)
local real damage=LoadReal(HH,id,15)
local real facing=LoadReal(HH,id,3)
set time=time+0.02
call SaveReal(HH,id,5,time)
if time>12 then
call RemoveUnit(LoadUnitHandle(HH,id,20))
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else
if time==0.02 then
call UnitSpeed(caster,1)
call SetUnitAnimationByIndex(caster,25)
set soundplay=SndN(4338) // Sound\Gojo\Ao_Self_Ao.mp3
call SetSoundVolume(soundplay,200)
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call EffectCreateAndMove(true,EffectID[768],facing,1.5,0.75,1.5,100,100,100,80,0,caster,0,facing)
call EffectCreateAndMove(true,EffectID[23],facing,1.5,1,0.5,60,60,100,0,0,caster,0,facing)
endif
if time==0.2 then
call EffectCreateAndMove(true,EffectID[0],facing+180,1,1,0.75,60,60,100,0,100,Dummy,0,facing)
call EffectCreateAndMove(true,EffectID[6],facing,1,0.4,0.4,60,60,100,0,100,Dummy,0,facing)
call EffectCreateAndMove90(true,EffectID[49],facing,1.5,1.75,0.5,100,100,100,0,100,Dummy,50,facing)
endif
if time>0.2 and time<10 then
call MoveUnit(Dummy,Dummy,50,facing)
call GroupClear(G)
call GroupEnumUnitsInRange(G,x0,y0,300,null)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if IsUnitEnemy(n0,GetOwningPlayer(caster))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(n0,'Avul')==0 then
call SetUnitPathing(n0,false)
if SR(GetUnitX(n0),GetUnitY(n0),GetUnitX(Dummy),GetUnitY(Dummy))<200 then
call MoveUnit(n0,n0,40,LoadReal(HH,id,3))
endif
if SR(GetUnitX(n0),GetUnitY(n0),GetUnitX(Dummy),GetUnitY(Dummy))>70 then
set facing=Angle2(GetUnitX(n0),GetUnitY(n0),GetUnitX(Dummy),GetUnitY(Dummy))
call MoveUnit(n0,n0,25,facing)
endif
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
if dist<=55 or IsTerrainPathable(PolX(x0,50,facing),PolY(y0,50,facing),PATHING_TYPE_FLYABILITY)==true then
call EffectCreateAndMove(true,EffectID[1317],GetRandomReal(0,360),2,1,1,100,100,100,0,0,Dummy,0,facing)
call EffectCreateAndMove(true,EffectID[523],GetRandomReal(0,360),2,1.5,0.5,100,100,100,60,0,Dummy,0,facing)
set soundplay=SndN(4341) // Sound\Gojo\Ao_Self_Ao_Hit.mp3
call SetSoundVolume(soundplay,127)
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call EffectCreateAndMove(true,EffectID[768],facing,2,1.25,0.5,100,100,100,80,-200,Dummy,0,facing)
set time=10
call SaveReal(HH,id,5,10)
call UnitSize(Dummy,2,1,1)
endif
endif
if time==10.3 then
call SetUnitModel(Dummy,"war3mapimported\\Dummy.mdl")
endif
if time>10 then
if time==10.02 or time==10.4 or time==10.8 or time==11.2 or time==11.6 then
call EffectCreateAndMoveAn(true,EffectID[1318],GetRandomReal(0,360),2,2,1,100,100,100,0,0,Dummy,0,facing,1)
call EffectCreateAndMove(true,EffectID[23],GetRandomReal(0,360),1,1.5,0.3,60,60,100,60,-200,Dummy,0,facing)
endif
set time1=time1-0.02
if time1<0 then
set time1=0.2
call DamageAoeOneTime0(caster,x0,y0,400,damage*0.1)
endif
call SaveReal(HH,id,6,time1)
call GroupClear(G)
call GroupEnumUnitsInRange(G,x0,y0,400,null)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if IsUnitEnemy(n0,GetOwningPlayer(caster))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(n0,'Avul')==0 then
if SR(GetUnitX(Dummy),GetUnitY(Dummy),GetUnitX(n0),GetUnitY(n0))>150 then
set facing=Angle2(GetUnitX(Dummy),GetUnitY(Dummy),GetUnitX(n0),GetUnitY(n0))
call MoveUnit(n0,n0,-20,facing)
call UnitPathingTimed(n0,2)
endif
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
endif
endif
set caster=null
set Dummy=null
endfunction
function Gojo_Q2_Act takes unit caster,real x1,real y1 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x0=0
local real y0=0
local real facing=0
local real dist
local real damage=(GetUnitAbilityLevel(caster,'GSQ1')+1)*GetHeroAgi(caster,true)
local real MaxDist=1000+GetHeroInt(caster,true)*3
call SaveUnitHandle(HH,id,1,caster)
call SaveReal(HH,id,15,damage)
call UnitAddAbilityTimedPaused(caster,3,'GSQ0')
set n0=LoadUnitHandle(HH,GetHandleId(caster),SH_GojoQU)
call RemoveSavedHandle(HH,GetHandleId(caster),SH_GojoQU)
set x0=GetUnitX(n0)
set y0=GetUnitY(n0)
set facing=Angle2(x0,y0,x1,y1)
set dist=SR(x0,y0,x1,y1)
if dist>MaxDist then
set x1=PolX(x0,MaxDist,facing)
set y1=PolY(y0,MaxDist,facing)
endif
set dist=SR(x0,y0,x1,y1)
call SaveReal(HH,id,8,dist)
call SaveReal(HH,id,11,x1)
call SaveReal(HH,id,12,y1)
call SaveReal(HH,id,3,facing)
call SaveUnitHandle(HH,id,20,n0)
call SaveBoolean(HH,GetHandleId(caster),SH_GojoQ2act,true)


call CreateModeIndicatorForm(caster, "ReplaceableTextures\\CommandButtons\\BTNGojoQ2.blp", 15)

call TimerStart(t,0.02,true,function Gojo_Q2_Act2)
set t=null
endfunction
function Gojo_Q1_Act2 takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local real time=LoadReal(HH,id,5)
local real damage=LoadReal(HH,id,15)
local real x0=GetUnitX(caster)
local real y0=GetUnitY(caster)
local real facing=GetUnitFacing(caster)

if time<0.02 or IsUnitPaused(caster)==false then
set time=time+0.02
call SaveReal(HH,id,5,time)
endif

if time>0.02 and LoadBoolean(HH,GetHandleId(caster),SH_GojoQ2act)==true then
call UnitRemoveAbility(caster,'GSQ6')
if LoadBoolean(HH,id,19)==true then
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'GSF2',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'GSF1',true)
endif
call SaveBoolean(HH,GetHandleId(caster),SH_GojoQ2act,false)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'GSQ2',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'GSQ1',true)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
if time>=GetUnitAbilityLevel(caster,'GSQ1')then
call UnitRemoveAbility(caster,'GSQ6')
if LoadBoolean(HH,id,19)==true then
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'GSF2',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'GSF1',true)
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'GSQ2',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'GSQ1',true)
call RemoveUnit(LoadUnitHandle(HH,id,20))
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else
if LoadBoolean(HH,id,19)==true then
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'GSF1',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'GSF2',true)
endif
if time==0.02 then



call UnitAddAbility(caster,'GSQ6')
//call CreateModeIndicatorWithPauseFormAbility(caster, "ReplaceableTextures\\CommandButtons\\BTNGojoQ2.blp",GetUnitAbilityLevel(caster,'GSQ1'),'GSQ6')




call SaveBoolean(HH,GetHandleId(caster),SH_GojoQ2act,false)
call UnitSpeed(caster,1)
call SetUnitAnimationByIndex(caster,23)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'GSQ1',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'GSQ2',true)
set soundplay=SndN(4344) // Sound\Gojo\Ao_Q1.mp3
call SetSoundVolume(soundplay,175)
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
