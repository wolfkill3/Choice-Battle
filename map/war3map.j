function DeathBeamCond takes nothing returns boolean
return GetSpellAbilityId()=='A0SP' and udg_B==true
endfunction
function DeathBeamCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real a=LoadReal(h,id,11)
local real dist=LoadReal(h,id,2)
local real x=GetUnitX(l__d)+40*Cos(a)
local real y=GetUnitY(l__d)+40*Sin(a)
local real dmg=LoadReal(h,id,4)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,12)
if GetUnitState(u,UNIT_STATE_LIFE)<=GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.2 then
set dmg=dmg+dmg*.2
endif
if dist>0 and RectContainsUnit(GetWorldBounds(),l__d)and UnitIsAlive(l__d)then
call SetUnitXY_1(l__d,x,y, false)
set n=CreateUnit(p,0x65305152,x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,1)
call SetUnitScale(n,1,1,1)
call SetUnitTimeScale(n,60)
call GroupEnumUnitsInRange(g,x,y,150,Base)
set idg=GetHandleId(g)
call SaveReal(h,id,2,dist-45)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
call KillUnit(l__d)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
else
call GroupEnumUnitsInRange(g,x,y,450,Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
call UnitApplyTimedLife(CreateUnit(p,'e0DC',x,y,(a*bj_RADTODEG)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0DE',x,y,(a*bj_RADTODEG)),1,3)
call UnitApplyTimedLife(CreateUnit(p,0x65305155,x,y,(a*bj_RADTODEG)),1,3)
call UnitApplyTimedLife(CreateUnit(p,0x65305153,x,y,(a*bj_RADTODEG)),1,3)
call UnitApplyTimedLife(CreateUnit(p,0x65305154,x,y,(a*bj_RADTODEG)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0C7',x,y,(a*bj_RADTODEG)),1,6)
call ShakeCamera(0.5,20)
call StartSound(soundStr[47])
call RemoveUnit(l__d)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call FlushChildHashtable(h,GetHandleId(g))
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
function DeathBeamCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,5)
local real y1=LoadReal(h,id,6)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real dmg=LoadReal(h,id,4)
local real dist=LoadReal(h,id,2)
local real scale=LoadReal(h,id,10)
local real tm=GetWidgetMana(u)
local real mana=GetUnitState(u,UNIT_STATE_MAX_MANA)*0.01
if GetUnitCurrentOrder(u)==OrderId("hex")and tm>GetUnitState(u,UNIT_STATE_MAX_MANA)*0.04 then
set n=CreateUnit(p,'e0B2',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitVertexColor(n,200,40,255,50)
call SaveReal(h,id,4,dmg+mana*2)
call SetUnitState(u,UNIT_STATE_MANA,tm-mana)
call SetUnitX(l__d,x+25*Cos(a-deg90))
call SetUnitY(l__d,y+25*Sin(a-deg90))
call SaveReal(h,id,10,scale+0.015)
call SetUnitScale(l__d,scale,scale,scale)
else
call PauseUnit(u,true)
call StopSound(LoadSoundHandle(h,id,16),true,true)
call SetUnitInvulnerable(u,true)
call SetUnitTimeScale(u,1)
call SetUnitX(l__d,x+100*Cos(a))
call SetUnitY(l__d,y+100*Sin(a))
call UnitAddAbility(l__d,'A0SR')
call SetUnitAnimation(u,"Spell Throw")
call SetUnitScale(l__d,0.8,0.8,0.8)
call PauseTimer(t)
call TimerStart(t,0.02,true,function DeathBeamCast3)
endif
set l__d=null
set p=null
set u=null
set t=null
endfunction
