function QLiAttack2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local player p=GetOwningPlayer(u)
call UnitRemoveAbility(c,'A1CO')
call UnitRemoveAbility(u,'A1CN')
call UnitRemoveAbility(u,'A1CP')
call IssueImmediateOrder(u,"stop")
call UnitRemoveAbility(u,'Basl')
call UnitRemoveAbility(c,'Basl')
call SetUnitTurnSpeed(c,LoadReal(h,id,2))
call SetUnitTimeScale(u,1)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set t=null
set c=null
set p=null
set u=null
endfunction
function QLiAttack takes nothing returns nothing
local unit u=GetAttacker()
local unit c=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real x2=0
local real y2=0
local real a=Atan2(y1-y,x1-x)*bj_RADTODEG
local real a2=0
local integer lvl=0
local real f=GetUnitFacing(c)*bj_DEGTORAD
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real sc
set x2=x1+5*Cos(f)
set y2=y1+5*Sin(f)
set a2=Atan2(y2-y1,x2-x1)*bj_RADTODEG
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveReal(HH,GetHandleId(u),SH_NoSecond,5)
call IssueImmediateOrder(u,"stop")
call IssueImmediateOrder(c,"stop")
call SaveReal(h,id,2,GetUnitTurnSpeed(c))
call SetUnitTurnSpeed(c,0)
call IssueTargetOrder(u,"attack",c)
call SetUnitTimeScale(u,5)
call SetUnitAnimation(u,"Spell Slam Two")
call UnitRemoveAbility(u,'B06M')
call UnitAddAbility(u,'A1CP')
call UnitAddAbility(c,'A1CO')
call UnitAddAbility(u,'A1CN')
set lvl=R2I(SquareRoot((a2-a)*(a2-a))/2)
if lvl>24 then
set lvl=24
endif
set n=CreateUnit(p,'e116',x1,y1,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,GetRandomInt(50,255))
set sc=GetRandomReal(0.5,3)
call SetUnitScale(n,sc,sc,sc)
call UnitApplyTimedLife(n,'BTLF',0.7)
call SetUnitTimeScale(n,2.5)
set n=CreateUnit(p,'e116',x1,y1,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,GetRandomInt(50,255))
set sc=GetRandomReal(0.5,3)
call SetUnitScale(n,sc,sc,sc)
call UnitApplyTimedLife(n,'BTLF',0.7)
call SetUnitTimeScale(n,2.5)
set n=CreateUnit(p,'e116',x1,y1,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,GetRandomInt(50,255))
set sc=GetRandomReal(0.5,3)
call SetUnitScale(n,sc,sc,sc)
call UnitApplyTimedLife(n,'BTLF',0.7)
call SetUnitTimeScale(n,2.5)
set n=CreateUnit(p,'e116',x1,y1,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,GetRandomInt(50,255))
set sc=GetRandomReal(0.5,3)
call SetUnitScale(n,sc,sc,sc)
call UnitApplyTimedLife(n,'BTLF',0.7)
call SetUnitTimeScale(n,2.5)
set n=CreateUnit(p,'e117',x1,y1,a)
call SetUnitVertexColor(n,255,255,255,255)
call UnitApplyTimedLife(n,'BTLF',0.7)
call SetUnitTimeScale(n,1.5)
set n=CreateUnit(p,'e118',x1,y1,a)
call SetUnitVertexColor(n,255,255,255,255)
call UnitApplyTimedLife(n,'BTLF',0.7)
call SetUnitTimeScale(n,2.5)
if(Asin((a2-a)*bj_RADTODEG)<bj_PI/3 and Asin((a2-a)*bj_RADTODEG)>-bj_PI/3)then
if lvl==0 and GetUnitTypeId(c)!='H075' and GetHeroLevel(u)>5 then
call myCustomDamage(u,c,GetHeroAgi(u,true)*(GetUnitAbilityLevel(u,'A1CT')+2.17-0.09*lvl),false,false,null,null,null)
call myCustomDamage(u,c,0.2*GetWidgetMaxLife(c),false,false,null,DAMAGE_TYPE_UNIVERSAL,null)
call SetControlToUnit(u,c,0.5, "stun")
call SetControlToUnit(u,c,2, "silenceTE")
set ShuwenKill=ShuwenKill+1
if ShuwenKill>=5 then
set soundplay=SndN(2679) // Sound\Music\mp3Music\ShuwenShot.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
else
call myCustomDamage(u,c,GetHeroAgi(u,true)*(GetUnitAbilityLevel(u,'A1CT')+2.17-0.09*lvl),false,false,null,null,null)
call SetControlToUnit(u,c,0.5, "stun")
call SetControlToUnit(u,c,2, "silenceTE")
endif
if lvl<5 then
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Tidal.mdx",c,"head"))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX-Special.mdx",c,"head"))
endif
endif
set soundplay=SndN(2681) // Sound\Music\mp3Music\ShuwenAttack6.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.4,false,function QLiAttack2)
set t=null
set c=null
set p=null
set u=null
endfunction
