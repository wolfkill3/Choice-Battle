function LucciTPush1 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(GetExpiredTimer())
local real time=LoadReal(HH,id,5)
local unit c=LoadUnitHandle(HH,id,2)
set time=time+0.02
call SaveReal(HH,id,5,time)
call UnitStop(c)
if time<2.1 then
        call MoveUnit(c,c,60,LoadReal(HH,id,3))
endif
if time>2.1 and time<=3.6 then
        if SR(GetUnitX(c),GetUnitY(c),GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)))<=150 then
                call MoveUnit(c,c,60,Angle2(GetUnitX(c),GetUnitY(c),GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20))))
        else
                call MoveUnit(c,c,-60,Angle2(GetUnitX(c),GetUnitY(c),GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20))))
        endif
endif
if time>=3.6 or SR(GetUnitX(c),GetUnitY(c),GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)))>150 then
        call FlushChildHashtable(HH,id)
        call PauseTimer(t)
        call DestroyTimer(t)
endif
set t=null
set c=null
endfunction
function LucciTPush takes unit targetLucci,unit missileLucci,real timeLucci,real degressLucci returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(HH,id,2,targetLucci)
call SaveReal(HH,id,3,degressLucci)
call SaveUnitHandle(HH,id,20,missileLucci)
call SaveReal(HH,id,5,timeLucci)
call TimerStart(t,0.02,true,function LucciTPush1)
set t=null
endfunction

function RobLucciQ1Move takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(HH,id,1)
        local unit c=LoadUnitHandle(HH,id,2)
        local real time=LoadReal(HH,id,5)
        local player p=GetOwningPlayer(u)
        local real dmg=GetHeroAgi(u,true)*(GetUnitAbilityLevel(u,'LCQ1'))+100
        local integer cjlocgn_00000000
        local group cjlocgn_00000001
        set time=time+0.02
        call SaveReal(HH,id,5,time)
        if LoadBoolean(HH,id,11)==true then
                if time==0.02 then
                        call EffectCreateAndMove1(false,"war3mapImported\\[A]az_axe_ef1.mdl",GetRandomReal(0,360),1,0.7,0.5,40,60,100,40,50,0,u,0,LoadReal(HH,id,3))
                        call EffectCreateAndMove1(false,"war3mapImported\\wind4.mdl",LoadReal(HH,id,3),1,1,0.5,40,60,100,0,0,0,u,0,LoadReal(HH,id,3))
                        call SetUnitFacing(u,LoadReal(HH,id,3))
                        set soundplay=SndN(3481) // Sound\Music\mp3Music\RankyakuGaichou.mp3
                        call StartSound(soundplay)
                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                        call SetUnitAnimationByIndex(u,4)
                        call UnitSpeed(u,1)
                endif
                if time==0.02 then
                        call EffectCreateAndMove1(false,"war3mapImported\\File00000827.mdl",LoadReal(HH,id,3)+180,1,1.5,0.5,100,100,100,0,50,0,u,0,LoadReal(HH,id,3))
                endif
                if time<0.4 then
                        call PauseUnit(u,true)
                        call SetUnitPathing(u,false)
                endif
                if time==0.4 then
                        call SaveUnitHandle(HH,id,2,CreateUnit(GetOwningPlayer(u),'e200',GetUnitX(u),GetUnitY(u),LoadReal(HH,id,3)))
                        set EFF=AddSpecialEffectTarget("war3mapImported\\File00000820.mdl",LoadUnitHandle(HH,id,2),"origin")
                        call SaveEffectHandle(HH,id,21,EFF)
                        call UnitColor(LoadUnitHandle(HH,id,2),40,60,100,40)
                        call UnitSize(LoadUnitHandle(HH,id,2),2.5,2.5,2.5)
                        call UnitAddAbility(LoadUnitHandle(HH,id,2),'Amrf')
                        call UnitRemoveAbility(LoadUnitHandle(HH,id,2),'Amrf')
                        call SetUnitFlyHeight(LoadUnitHandle(HH,id,2),200,0)
                        call SaveUnitHandle(HH,id,24,CreateUnit(GetOwningPlayer(u),'e200',GetUnitX(u),GetUnitY(u),LoadReal(HH,id,3)))
                        set EFF=AddSpecialEffectTarget("war3mapImported\\[A]BladeBeamFinalLarger.mdl",LoadUnitHandle(HH,id,24),"origin")
                        call SaveEffectHandle(HH,id,22,EFF)
                        call UnitColor(LoadUnitHandle(HH,id,24),20,40,100,0)
                        call UnitSize(LoadUnitHandle(HH,id,24),2.5,2.5,2.5)
                        call UnitAddAbility(LoadUnitHandle(HH,id,24),'Amrf')
                        call UnitRemoveAbility(LoadUnitHandle(HH,id,24),'Amrf')
                        call SetUnitFlyHeight(LoadUnitHandle(HH,id,24),200,0)
                        call SaveUnitHandle(HH,id,25,CreateUnit(GetOwningPlayer(u),'e200',GetUnitX(u),GetUnitY(u),LoadReal(HH,id,3)))
                        set EFF=AddSpecialEffectTarget("war3mapImported\\[A]BladeBeamFinalLarger-90.mdl",LoadUnitHandle(HH,id,25),"origin")
                        call SaveEffectHandle(HH,id,23,EFF)
                        call UnitColor(LoadUnitHandle(HH,id,25),20,40,100,0)
                        call UnitSize(LoadUnitHandle(HH,id,25),2.5,2.5,2.5)
                        call UnitAddAbility(LoadUnitHandle(HH,id,25),'Amrf')
                        call UnitRemoveAbility(LoadUnitHandle(HH,id,25),'Amrf')
                        call SetUnitFlyHeight(LoadUnitHandle(HH,id,25),200,0)
                        call UnitSpeed(u,1)
                        call PauseUnit(u,false)
                        call SetUnitPathing(u,true)
                endif
                if time>0.4 and time<=1.3 then
                        call MoveUnit(c,c,70,LoadReal(HH,id,3))
                        call MoveUnit(c,LoadUnitHandle(HH,id,24),-50,LoadReal(HH,id,3))
                        call MoveUnit(c,LoadUnitHandle(HH,id,25),-40,LoadReal(HH,id,3))
                        set cjlocgn_00000000=LoadInteger(HH,id,6)
                        set cjlocgn_00000000=cjlocgn_00000000+1
                        if time==0.42 or cjlocgn_00000000==5 then
                                call EffectCreateAndMove1(false,"war3mapImported\\CF2.mdl",LoadReal(HH,id,3)+180,1-(time-0.4)*0.015,GetRandomReal(0.4,0.6),GetRandomReal(0.5,0.75),40,60,100,GetRandomInt(20,40),150,0,c,-100,LoadReal(HH,id,3))
                                // set n=CreateUnit(GetOwningPlayer(u), 'dM04', GetUnitX(c),GetUnitY(c), LoadReal(HH,id,3)*bj_RADTODEG)
                                // call SetUnitFlyHeight(n, 50, 0)
                                // call MyRemoveUnit(n, 1.5)
                                set cjlocgn_00000000=0
                        endif
                        call SaveInteger(HH,id,6,cjlocgn_00000000)
                        set cjlocgn_00000001=LoadGroupHandle(HH,id,4)
                        call GroupEnumUnitsInRange(cjlocgn_00000001,GetUnitX(c),GetUnitY(c),300,Base)
                        set idg=GetHandleId(cjlocgn_00000001)
                        loop
                                set E=FirstOfGroup(cjlocgn_00000001)
                                set ide=GetHandleId(E)
                                if Condition_Base(p,E)and E!=LoadUnitHandle(HH,idg,ide)then
                                        call myCustomDamage(u,E,dmg*1.35,false,false,null,null,null)
                                        call SaveUnitHandle(HH,idg,ide,E)
                                endif
                                call GroupRemoveUnit(cjlocgn_00000001,E)
                        exitwhen E==null
                        endloop
                        set cjlocgn_00000001=null
                endif
                if time==1.3 then
                        if LoadEffectHandle(HH,id,21)!=null then
                        call DestroyEffect(LoadEffectHandle(HH,id,21))
                        call SaveEffectHandle(HH,id,21,null)
                        endif
                        if LoadEffectHandle(HH,id,22)!=null then
                        call DestroyEffect(LoadEffectHandle(HH,id,22))
                        call SaveEffectHandle(HH,id,22,null)
                        endif
                        if LoadEffectHandle(HH,id,23)!=null then
                        call DestroyEffect(LoadEffectHandle(HH,id,23))
                        call SaveEffectHandle(HH,id,23,null)
                        endif
                        call RemoveUnit(LoadUnitHandle(HH,id,24))
                        call RemoveUnit(LoadUnitHandle(HH,id,25))
                endif
                if time==1.6 then
                        set cjlocgn_00000001=LoadGroupHandle(HH,id,4)
                        call RemoveUnit(c)
                        call FlushChildHashtable(HH,id)
                        call FlushChildHashtable(HH,GetHandleId(cjlocgn_00000001))
                        call PauseTimer(t)
                        call DestroyTimer(t)
                        call DestroyGroup(cjlocgn_00000001)
                        set cjlocgn_00000001=null
                endif
        else
                if time==0.02 then
                        call EffectCreateAndMove1(false,"war3mapImported\\wind4.mdl",LoadReal(HH,id,3),1,1,0.5,40,60,100,0,0,0,u,0,LoadReal(HH,id,3))
                        call SetUnitFacing(u,LoadReal(HH,id,3))
                        set soundplay=SndN(977) // Sound\Music\mp3Music\Rankyaku.mp3
                        call StartSound(soundplay)
                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                        call SetUnitAnimationByIndex(u,3)
                        call UnitSpeed(u,1)
                endif
                if time<0.4 then
                        call PauseUnit(u,true)
                        call SetUnitPathing(u,false)
                endif
                if time==0.2 then
                        call EffectCreateAndMove1(false,"war3mapImported\\File00000827.mdl",LoadReal(HH,id,3)+180,1,1.5,0.5,100,100,100,0,50,0,u,0,LoadReal(HH,id,3))
                endif
                if time==0.4 then
                        call SaveGroupHandle(HH,id,4,CreateGroup())
                        call SaveUnitHandle(HH,id,2,CreateUnit(GetOwningPlayer(u),'e200',GetUnitX(u),GetUnitY(u),LoadReal(HH,id,3)))
                        call MoveUnit(c,c,100,LoadReal(HH,id,3))
                        set EFF=AddSpecialEffectTarget("war3mapImported\\[A]BladeBeamFinalLarger.mdl",c,"origin")
                        call SaveEffectHandle(HH,id,21,EFF)
                        call UnitColor(c,20,40,100,0)
                        call UnitSize(c,2,2,2)
                        call UnitAddAbility(c,'Amrf')
                        call UnitRemoveAbility(c,'Amrf')
                        call SetUnitFlyHeight(c,200,0)
                        call SaveUnitHandle(HH,id,24,CreateUnit(GetOwningPlayer(u),'e200',GetUnitX(u),GetUnitY(u),LoadReal(HH,id,3)))
                        set EFF=AddSpecialEffectTarget("war3mapImported\\[A]BladeBeamFinalLarger.mdl",LoadUnitHandle(HH,id,24),"origin")
                        call SaveEffectHandle(HH,id,22,EFF)
                        call UnitColor(LoadUnitHandle(HH,id,24),20,40,100,0)
                        call UnitSize(LoadUnitHandle(HH,id,24),2,2,2)
                        call UnitAddAbility(LoadUnitHandle(HH,id,24),'Amrf')
                        call UnitRemoveAbility(LoadUnitHandle(HH,id,24),'Amrf')
                        call SetUnitFlyHeight(LoadUnitHandle(HH,id,24),200,0)
                        call SaveUnitHandle(HH,id,25,CreateUnit(GetOwningPlayer(u),'e200',GetUnitX(u),GetUnitY(u),LoadReal(HH,id,3)))
                        set EFF=AddSpecialEffectTarget("war3mapImported\\[A]BladeBeamFinalLarger.mdl",LoadUnitHandle(HH,id,25),"origin")
                        call SaveEffectHandle(HH,id,23,EFF)
                        call UnitColor(LoadUnitHandle(HH,id,25),20,40,100,0)
                        call UnitSize(LoadUnitHandle(HH,id,25),2,2,2)
                        call UnitAddAbility(LoadUnitHandle(HH,id,25),'Amrf')
                        call UnitRemoveAbility(LoadUnitHandle(HH,id,25),'Amrf')
                        call SetUnitFlyHeight(LoadUnitHandle(HH,id,25),200,0)
                        call UnitSpeed(u,1)
                        call PauseUnit(u,false)
                        call SetUnitPathing(u,true)
                endif
                if time>0.4 and time<=1.2 then
                        call MoveUnit(c,c,60,LoadReal(HH,id,3))
                        call MoveUnit(c,LoadUnitHandle(HH,id,24),-50,LoadReal(HH,id,3))
                        call MoveUnit(c,LoadUnitHandle(HH,id,25),-100,LoadReal(HH,id,3))
                        set cjlocgn_00000000=LoadInteger(HH,id,6)
                        set cjlocgn_00000000=cjlocgn_00000000+1
                        if time==0.42 or cjlocgn_00000000==5 then
                                call EffectCreateAndMove21(false,"war3mapImported\\wind3.mdl",LoadReal(HH,id,3),1-(time-0.4)*0.015,GetRandomReal(1,1.5),GetRandomReal(1,1.5),40,60,100,GetRandomInt(30,50),150,c,-100,LoadReal(HH,id,3))
                                // set n=CreateUnit(GetOwningPlayer(u), 'e202', GetUnitX(c),GetUnitY(c), LoadReal(HH,id,3)*bj_RADTODEG)
                                // call MyRemoveUnit(n, 1.5)
                                set cjlocgn_00000000=0
                        endif
                        call SaveInteger(HH,id,6,cjlocgn_00000000)
                        set cjlocgn_00000001=LoadGroupHandle(HH,id,4)
                        call GroupEnumUnitsInRange(cjlocgn_00000001,GetUnitX(c),GetUnitY(c),200,Base)
                        set idg=GetHandleId(cjlocgn_00000001)
                        loop
                                set E=FirstOfGroup(cjlocgn_00000001)
                                set ide=GetHandleId(E)
                                if Condition_Base(p,E)and E!=LoadUnitHandle(HH,idg,ide)then
                                        call myCustomDamage(u,E,dmg,false,false,null,null,null)
                                        call SaveUnitHandle(HH,idg,ide,E)
                                endif
                                call GroupRemoveUnit(cjlocgn_00000001,E)
                        exitwhen E==null
                        endloop
                        set cjlocgn_00000001=null
                endif
                if time==1.2 then
                        if LoadEffectHandle(HH,id,21)!=null then
                        call DestroyEffect(LoadEffectHandle(HH,id,21))
                        call SaveEffectHandle(HH,id,21,null)
                        endif
                        if LoadEffectHandle(HH,id,22)!=null then
                        call DestroyEffect(LoadEffectHandle(HH,id,22))
                        call SaveEffectHandle(HH,id,22,null)
                        endif
                        if LoadEffectHandle(HH,id,23)!=null then
                        call DestroyEffect(LoadEffectHandle(HH,id,23))
                        call SaveEffectHandle(HH,id,23,null)
                        endif
                        call RemoveUnit(LoadUnitHandle(HH,id,24))
                        call RemoveUnit(LoadUnitHandle(HH,id,25))
                endif
                if time==1.7 then
                        call RemoveUnit(c)
                        set cjlocgn_00000001=LoadGroupHandle(HH,id,4)
                        call FlushChildHashtable(HH,id)
                        call FlushChildHashtable(HH,GetHandleId(cjlocgn_00000001))
                        call PauseTimer(t)
                        call DestroyTimer(t)
                        call DestroyGroup(cjlocgn_00000001)
                        set cjlocgn_00000001=null
                endif
        endif
        set t=null
        set u=null
        set c=null
endfunction


function RobLucciW1Move takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(HH,id,1)
        local real time=LoadReal(HH,id,5)
        if LoadBoolean(HH,GetHandleId(u),TARGET_ABILITY)==false then
        set time=time+0.02
        call SaveReal(HH,id,5,time)
        call PauseUnit(u,true)
        endif
        if LoadBoolean(HH,id,11)==true then
                if time==0.02 then
                        call SetUnitAnimationByIndex(u,5)
