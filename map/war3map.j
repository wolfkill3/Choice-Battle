call TriggerRegisterAnyUnitEventBJ(gg_trg_W2Deidara,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_W2Deidara,Condition(function W2DeidaraCond))
call TriggerAddAction(gg_trg_W2Deidara,function W2DeidaraCast)
