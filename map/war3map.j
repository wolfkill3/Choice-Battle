local real time=LoadReal(h,id,5)-0.03
call SaveReal(h,id,3,dist-speed)
call SaveReal(h,id,5,time)
if time>0 and dist>0 and LoadUnitHandle(h,id,0)!=null and GetUnitAbilityLevel(LoadUnitHandle(h,id,0),'A1BL')==0 and udg_B then
        call SetUnitXY_1(LoadUnitHandle(h,id,0),GetUnitX(LoadUnitHandle(h,id,0))+speed*Cos(a),GetUnitY(LoadUnitHandle(h,id,0))+speed*Sin(a), true)
        call SetUnitFacing(LoadUnitHandle(h,id,0),a*bj_RADTODEG)
        if (speed-speed*0.03)>0 then
                call SaveReal(h,id,1,speed-speed*0.03)
        endif
        if LoadStr(h,id,4)!="" or LoadStr(h,id,4)!="null" then
                call DestroyEffect(AddSpecialEffect(LoadStr(h,id,4),GetUnitX(LoadUnitHandle(h,id,0)),GetUnitY(LoadUnitHandle(h,id,0))))
        endif
else
        call FlushChildHashtable(h,id)
        call PauseTimer(GetExpiredTimer())
        call DestroyTimer(GetExpiredTimer())
endif
endfunction
