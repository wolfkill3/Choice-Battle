function ShinsoCond takes nothing returns boolean
return GetSpellAbilityId()=='A0IZ' and udg_B==true
endfunction
function ShinsoCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=LoadReal(h,id,1)
local real y=LoadReal(h,id,2)
local real a=Atan2(LoadReal(h,id,4)-y,LoadReal(h,id,3)-x)
local real l__d=LoadReal(h,id,5)
local group g=LoadGroupHandle(h,id,6)
local player p=GetOwningPlayer(u)
local integer l__s=StringHash("chain")
local integer ss=StringHash("chain2")
local integer numb=LoadInteger(h,id,10)
local real dmg=(2+GetUnitAbilityLevel(u,'A0IZ'))*GetHeroAgi(u,true)+100
local integer l__idg=GetHandleId(g)
local integer lvl=GetUnitAbilityLevel(u,'A0J3')
if l__d<GetHeroAgi(u,true)*5.0+2000 then
set x=x+l__d*Cos(a)
set y=y+l__d*Sin(a)
set n=CreateUnit(p,'e0DR',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,30)
call SaveReal(h,id,5,l__d+30+0.25*GetHeroLevel(u))
call SaveUnitHandle(h,id,ss+numb,n)
call SaveInteger(h,id,10,numb+1)
call SaveDestructableHandle(h,id,l__s+numb,CreateDestructable('B003',x,y,a*bj_RADTODEG,1,1))
call GroupEnumUnitsInRange(g,x,y,85,Base)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set ide=GetHandleId(E)
if Condition_Base(p,E)then
if E!=LoadUnitHandle(h,l__idg,ide)then
call GinT_AddStack(u, E)
call UnitAddAbility(E,'A15G')
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call UnitRemoveAbility(E,'A15G')
call SaveUnitHandle(h,l__idg,ide,E)
call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",GetUnitX(E),GetUnitY(E)))
if lvl>0 then
endif
endif
call Push3(E,30+0.5*GetHeroLevel(u),a,100+GetHeroLevel(u),"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
endif
call GroupRemoveUnit(g,E)
endloop
else
if numb>=0 then
call RemoveUnit(LoadUnitHandle(h,id,ss+numb))
call RemoveDestructable(LoadDestructableHandle(h,id,l__s+numb))
call SaveInteger(h,id,10,numb-1)
else
set l__idg=GetHandleId(g)
call PauseUnit(u,false)
call SetUnitTimeScale(u,1)
call UnitRemoveAbility(u,'A15G')
call SetUnitInvulnerable(u,false)
if IsAbilityOnCooldown(GetUnitAbility(u,'A0IZ'))==false then
call IssueImmediateOrder(u,"stop")
endif
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
endif
set p=null
set u=null
set g=null
set t=null
endfunction
function ShinsoCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)+90*bj_DEGTORAD
local player p=GetOwningPlayer(u)
local boolean bGinBankai = LoadBoolean(h, GetHandleId(u), StringHash("GinBankai"))
call SaveGroupHandle(h,id,6,CreateGroup())
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,x-25*Cos(a))
call SaveReal(h,id,8,2)
call SaveReal(h,id,2,y-25*Sin(a))
call SaveReal(h,id,3,GetSpellTargetX())
call SaveReal(h,id,4,GetSpellTargetY())
call SaveInteger(h,id,10,0)
call PauseUnit(u,true)
call SetUnitTimeScale(u,0)
call SetUnitInvulnerable(u,true)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\GinIchimaruShinso.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call UnitAddAbility(u,'A15G')
if bGinBankai then
        call TimerStart(t,0.001,true,function ShinsoCast2)
else
        call TimerStart(t,0.007-0.00005*GetHeroLevel(u),true,function ShinsoCast2)
endif
set p=null
set u=null
set t=null
endfunction
