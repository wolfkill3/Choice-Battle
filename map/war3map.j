function KunaiCond takes nothing returns boolean
return GetSpellAbilityId()=='A020' and udg_B==true
endfunction
function KunaiCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local group g=LoadGroupHandle(h,id,4)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,5)
local integer l__idg=GetHandleId(g)
local integer l__ide
local player p=GetOwningPlayer(u)
local real dmg=GetHeroAgi(u,true)*(2+GetUnitAbilityLevel(u,'A020'))
if SR(x,y,x1,y1)<=1800 and IsTerrainPathable(GetUnitX(l__d),GetUnitY(l__d),PATHING_TYPE_FLYABILITY)==false then
call SetUnitX(l__d,x1+50*Cos(a))
call SetUnitY(l__d,y1+50*Sin(a))
call GroupEnumUnitsInRange(g,x1,y1,160,Base)
loop
set E=FirstOfGroup(g)
set l__ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,l__ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,l__idg,l__ide,E)
if udg_B==true then
call GroupAddUnit(udg_KG[GetPlayerId(p)],E)
endif
endif
call GroupRemoveUnit(g,E)
endloop
set n=CreateUnit(p,0x65303144,x1,y1,f)
call UnitApplyTimedLife(n,1,.5)
call UnitAddAbility(n,'Arav')
call SetUnitTimeScale(n,3)
else
call UnitApplyTimedLife(l__d,1,6)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function KunaiCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
set n=CreateUnit(p,0x65303143,x+80*Cos(a),y+80*Sin(a),a*bj_RADTODEG)
call UnitAddAbility(n,'Arav')
set udg_Kunai[GetPlayerId(p)]=n
set udg_KG[GetPlayerId(p)]=CreateGroup()
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,n)
call SaveGroupHandle(h,id,4,CreateGroup())
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveReal(h,id,5,a)
call SetUnitFacing(n,a*bj_RADTODEG)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\MinatoW.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.015,true,function KunaiCast2)
set u=null
set p=null
set t=null
endfunction
function KunaiInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function KunaiCast)
call TriggerAddCondition(t,Condition(function KunaiCond))
set t=null
endfunction
