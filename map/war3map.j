function JukaiKotanCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local group g=LoadGroupHandle(h,id,4)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,5)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroInt(u,true)*(2+GetUnitAbilityLevel(u,'A0MV'))
local real sc=0
local real dist
if SR(x,y,x1,y1)<=1200 and IsTerrainPathable(GetUnitX(l__d),GetUnitY(l__d),PATHING_TYPE_FLYABILITY)==false then
set x1=x1+150*Cos(a)
set y1=y1+150*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
call GroupEnumUnitsInRange(g,x1,y1,350,Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
call CC_UnitEx( E, E, 0., 4, "root", false, "Abilities\\Spells\\NightElf\\EntanglingRoots\\EntanglingRootsTarget.mdl", "chest", 0,0 )
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
set dist=GetRandomReal(-400,400)
set n=CreateUnit(p,'e0KB',x1+dist*Cos(a+deg90),y1+dist*Sin(a+deg90),a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',4)
set sc=GetRandomReal(0.8,1.2)
call SetUnitAnimation(n,"Birth")
call SetUnitScale(n,sc,sc,sc)
set dist=GetRandomReal(-400,400)
set n=CreateUnit(p,'e0KB',x1+dist*Cos(a+deg90),y1+dist*Sin(a+deg90),a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',4)
set sc=GetRandomReal(0.8,1.2)
call SetUnitAnimation(n,"Birth")
call SetUnitScale(n,sc,sc,sc)
set dist=GetRandomReal(-400,400)
set n=CreateUnit(p,'e0KA',x1+dist*Cos(a+deg90),y1+dist*Sin(a+deg90),a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',4)
set sc=GetRandomReal(0.4,0.6)
call SetUnitTimeScale(n,0)
call SetUnitScale(n,sc,sc,sc)
set dist=GetRandomReal(-400,400)
set n=CreateUnit(p,'e0KA',x1+dist*Cos(a+deg90),y1+dist*Sin(a+deg90),a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',4)
set sc=GetRandomReal(0.4,0.6)
call SetUnitTimeScale(n,0)
call SetUnitScale(n,sc,sc,sc)
set dist=GetRandomReal(-400,400)
set n=CreateUnit(p,'e0KA',x1+dist*Cos(a+deg90),y1+dist*Sin(a+deg90),a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',4)
set sc=GetRandomReal(0.4,0.6)
call SetUnitTimeScale(n,0)
call SetUnitScale(n,sc,sc,sc)
else
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,GetHandleId(g))
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
call RemoveUnit(l__d)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function JukaiKotanCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,CreateUnit(GetOwningPlayer(u),0x65304B43,x+80*Cos(a*bj_RADTODEG),y+80*Sin(a*bj_RADTODEG),a*bj_RADTODEG))
call SaveGroupHandle(h,id,4,CreateGroup())
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveReal(h,id,5,a)
call TimerStart(t,0.1,true,function JukaiKotanCast2)
set soundplay=SndN(1620) // Sound\Music\mp3Music\MukutonMadara.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set u=null
set t=null
endfunction
