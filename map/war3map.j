call EffectCreateAndMove(true,"Aizen\\red-blood-ball.mdl",facing,0.75,2.5,2.5,100,100,100,0,50,target,0,facing)
call EffectCreateAndMove(true,"Sabrac\\bloodex1.mdl",facing,1,3,1,100,100,100,0,100,target,0,facing)
call UnitSpeed(caster,1)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'ASQ1',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'ASW1',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'ASE1',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'ASR1',true)
call PauseUnit(target,false)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
call SetUnitInvulnerable(target,false)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)


call myCustomDamage(caster,target,damage,false,false,null,null,null)
call StartAbilityCooldown(GetUnitAbility(caster, 'AST1'), 40)

set soundplay=CreateSound("Sound\\Music\\mp3Music\\AizenT2Slash.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
set caster=null
set target=null
set Clone=null
endfunction



function AizenT2AoeAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit target=LoadUnitHandle(HH,GetHandleId(caster),StringHash("AizenTU"))
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real x1=GetUnitX(target)
local real y1=GetUnitY(target)
local real damage=LoadReal(HH,id,15)
set time=time+0.02
call SaveReal(HH,id,5,time)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call PauseUnit(target,true)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
call SetUnitInvulnerable(target,true)
if time==0.02 or time==0.5 or time==1 or time==2 then
call EffectCreateAndMove(true,"Madara\\ShockWaveBlack.mdl",GetRandomReal(0,360),1.5,GetRandomReal(0.8,1.2),GetRandomReal(0.6,0.8),100,100,100,GetRandomReal(40,60),0,caster,0,facing)
endif
if time==0.02 or time==0.3 or time==0.6 or time==0.9 or time==1.2 or time==1.5 or time==1.8 then
call EffectCreateAndMove(true,"BlackGoku\\[A]az_axe_ef1.mdl",GetRandomReal(0,360),1.5,GetRandomReal(0.8,1.2),GetRandomReal(0.4,0.8),100,100,100,GetRandomReal(40,60),0,caster,0,facing)
endif
if time==0.02 then
call EffectCreateAndMove(true,"Aizen\\flowerMoonEff (49).mdl",GetRandomReal(0,360),1.5,0.3,0.5,100,100,100,80,150,caster,-100,facing)
endif
if time==1 then
call EffectCreateAndMove(true,"Aizen\\[A]hit-white-guangxiao.mdl",GetRandomReal(0,360),1.5,2.5,0.5,100,100,100,60,0,caster,0,facing)
endif
if time==0.02 then
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
call SetUnitModel(n0,"Others\\HakkeStart2.mdl")
call UnitSize(n0,1.5,1,1)
call UnitSpeed(n0,1)
call UnitColor(n0,100,100,100,60)
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call SetUnitFlyHeight(n0,0,0)
call SaveUnitHandle(HH,id,25,n0)
set n0=null
set soundplay=CreateSound("Sound\\Music\\mp3Music\\AizenTSelf1.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call ShowUnit(caster,true)
if GetLocalPlayer()==GetOwningPlayer(caster)then
call ClearSelection()
call SelectUnit(caster,true)
endif
set facing=GetUnitFacing(target)
call SaveReal(HH,id,3,facing)
call UnitSpeed(caster,1)
call SetUnitFacing(caster,facing)
endif
if time==0.5 then
call UnitSpeed(LoadUnitHandle(HH,id,25),0)
endif
if time==2.2 then
call EffectCreateAndMove(true,"Aizen\\HitToumaAFB.mdl",facing,1.5,2.5,0.3,100,100,100,60,150,caster,0,facing)
call MyRemoveUnit(LoadUnitHandle(HH,id,25),2)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
call UnitSpeed(caster,1)
call SetUnitAnimationByIndex(caster,14)
call GroupClear(G)
call GroupEnumUnitsInRange(G,x1,y1,600,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if GetUnitAbilityLevel(n0,'Avul')==0 and IsUnitEnemy(n0,GetOwningPlayer(caster))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false then
call EffectCreateAndMove(true,"Aizen\\bloodP1.mdl",facing,1.5,1,1,100,100,100,0,50,n0,0,facing)
call EffectCreateAndMove(true,"Aizen\\red-blood-ball.mdl",facing,1.5,2.5,0.6,100,100,100,0,50,n0,0,facing)


call myCustomDamage(caster,n0,damage,false,false,null,null,null)


call UnitStop(n0)
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
call EffectCreateAndMoveAn(true,"Aizen\\[A]GrassPisses.mdl",facing+90,2,4.5,2,100,100,100,0,50,target,0,facing,1)
call EffectCreateAndMoveAn(true,"Aizen\\[A]GrassPisses.mdl",facing,2,4.5,2,100,100,100,0,50,target,0,facing,1)
call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",facing,2,2,0.8,100,100,100,0,50,caster,0,facing)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\AizenTself2.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call SetUnitState(caster,UNIT_STATE_MANA,GetUnitState(target,UNIT_STATE_MANA)*0.5)
call RemoveUnit(target)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'ASQ1',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'ASW1',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'ASE1',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'ASR1',true)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
set caster=null
set target=null
endfunction
