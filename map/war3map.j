endfunction
function BlackStarLeafComboShurikenCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local player p=GetOwningPlayer(u)
local integer idu=GetPlayerId(p)
local real x=LoadReal(h,id,3)
local real y=LoadReal(h,id,4)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real x2=GetUnitX(u)
local real y2=GetUnitY(u)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,8)
local real dmg=GetHeroStr(u,true)*(GetUnitAbilityLevel(u,'A0C1')+3)
local real Range=LoadReal(h,id,9)
if Range<2000 and UnitIsAlive(l__d)then
set x1=x1+40*Cos(a)
set y1=y1+40*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
call SaveReal(h,id,3,x1)
call SaveReal(h,id,4,y1)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SaveReal(h,id,9,Range+40)
call GroupEnumUnitsInRange(G,x1,y1,100,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\GreenSlam.mdl",E,"chest"))
call UnitApplyTimedLife(CreateUnit(p,'e06C',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e06D',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e06B',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e06J',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e06I',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e067',x,y,a*bj_RADTODEG),'BTLF',0.5)
call UnitApplyTimedLife(CreateUnit(p,'e06H',x2,y2,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e06I',x2,y2,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e06H',x1,y1,a*bj_RADTODEG),'BTLF',1)
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x2,y2))
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x1,y1))
call SetUnitXY_1(u,x1,y1, false)
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 2, "stun")
call Push(E,50,a,800)
call RemoveUnit(l__d)
endif
call GroupRemoveUnit(G,E)
endloop
else
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
endif
set u=null
set p=null
set t=null
set l__d=null
endfunction
function BlackStarLeafComboShurikenCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,8,a)
set n=CreateUnit(GetOwningPlayer(u),0x65303641,x,y,a*bj_RADTODEG)
call SaveUnitHandle(h,id,1,n)
call TimerStart(t,0.03,true,function BlackStarLeafComboShurikenCast2)
set u=null
set t=null
endfunction
