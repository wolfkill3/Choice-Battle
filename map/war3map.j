call SetUnitAnimationByIndex(caster,2)
else
call SetUnitAnimationByIndex(caster,7)
endif
endif
if time==0.02 or time==0.4 or time==0.8 then
call EffectCreateAndMove(true,"Madara\\[A]az_axe_ef1.mdl",facing,1,1,0.5,100,100,100,30,0,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\WindNewFaw4.mdl",facing,1,1,0.5,100,100,100,30,0,caster,0,facing)
endif
if time==1 then
call EffectCreateAndMove(true,"Madara\\BY_Wood_GongChengSiPai_6.mdl",facing,1,1.5,1,100,100,100,30,0,caster,0,facing)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
