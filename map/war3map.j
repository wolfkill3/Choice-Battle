function MCFCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real time=LoadReal(h,id,2)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,5)
local real y1=LoadReal(h,id,6)
local real dmg=0.075*GetUnitAbilityLevel(u,'A0B9')
local group g=LoadGroupHandle(h,id,4)
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(p)
if time<20+10*GetUnitAbilityLevel(u,'A0B9')then
//copy this
set bj_lastCreatedGroup = CreateGroup() //mukuro
call GroupEnumUnitsInRange(bj_lastCreatedGroup,x1,y1,650,Base)
loop
    set SysUnit = FirstOfGroup( bj_lastCreatedGroup )
    exitwhen SysUnit == null
    if Condition_Base(p,SysUnit)then
        call SetControlToUnit(SysUnit,SysUnit, 0.45, "silenceTE")
        call SlowUnit(u,SysUnit,0.8,0.8,0.15,2,false)
    endif
    call GroupRemoveUnit( bj_lastCreatedGroup, SysUnit )
endloop
call GroupClear(bj_lastCreatedGroup)
call DestroyGroup(bj_lastCreatedGroup)
//end
call GroupEnumUnitsInRange(G,x1,y1,650,Base)
loop
set E=FirstOfGroup(G)
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(G,E)
exitwhen E==null
endloop
call SaveReal(h,id,2,time+1)
else
loop
set E=FirstOfGroup(g)
call RemoveUnit(E)
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
call RemoveSavedReal(h,GetHandleId(Hero[ip]),StringHash("IMR"))
call RemoveSavedReal(h,GetHandleId(Hero[ip]),StringHash("IMR")+1)
call SetTerrainFogExBJ(0,6000.00,10000,0,1,1,1)
call PauseTimer(t)
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,GetHandleId(Hero[ip]))
endif
set p=null
set t=null
set u=null
set g=null
endfunction
function MCFCast takes nothing returns nothing
local timer t=CreateTimer()
local unit u=GetTriggerUnit()
local integer id=GetHandleId(t)
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local group g=CreateGroup()
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(p)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,0)
call SetTerrainFogEx(0,0,6000,0,0,0,0.5)
set n=CreateUnit(p,0x65303543,x,y,0)
call SetUnitAnimation(n,"stand")
call SetUnitTimeScale(n,0)
call SetUnitVertexColor(n,25,25,255,140)
call GroupAddUnit(g,n)
set n=CreateUnit(p,0x65303544,x,y,0)
call GroupAddUnit(g,n)
set n=CreateUnit(p,0x65303545,x+650*Cos(76*2*bj_DEGTORAD),y+650*Sin(76*2*bj_DEGTORAD),0)
call GroupAddUnit(g,n)
call SetUnitFacing(n,Atan2(y-GetUnitY(n),x-GetUnitX(n))*bj_RADTODEG)
set n=CreateUnit(p,0x65303546,x+650*Cos(76*3*bj_DEGTORAD),y+650*Sin(76*3*bj_DEGTORAD),0)
call GroupAddUnit(g,n)
call SetUnitFacing(n,Atan2(y-GetUnitY(n),x-GetUnitX(n))*bj_RADTODEG)
set n=CreateUnit(p,0x65303547,x+650*Cos(76*4*bj_DEGTORAD),y+650*Sin(76*4*bj_DEGTORAD),0)
call GroupAddUnit(g,n)
call SetUnitFacing(n,Atan2(y-GetUnitY(n),x-GetUnitX(n))*bj_RADTODEG)
set n=CreateUnit(p,0x6530354A,x+650*Cos(76*5*bj_DEGTORAD),y+650*Sin(76*5*bj_DEGTORAD),0)
call GroupAddUnit(g,n)
call SetUnitFacing(n,Atan2(y-GetUnitY(n),x-GetUnitX(n))*bj_RADTODEG)
set n=CreateUnit(p,0x65303549,x+650*Cos(76*bj_DEGTORAD),y+650*Sin(76*bj_DEGTORAD),0)
call SetUnitFacing(n,Atan2(y-GetUnitY(n),x-GetUnitX(n))*bj_RADTODEG)
call GroupAddUnit(g,n)
call SaveReal(h,GetHandleId(Hero[ip]),StringHash("MCF"),x)
call SaveReal(h,GetHandleId(Hero[ip]),StringHash("MCF")+1,y)
call SaveReal(h,id,5,x)
call SaveReal(h,id,6,y)
call SaveGroupHandle(h,id,4,g)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\MukuroKambioForma.wav",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.15,true,function MCFCast2)
set t=null
set p=null
set u=null
endfunction
