call KillSoundWhenDone(soundplay)
call myCustomDamage(u,c,(2+GetUnitAbilityLevel(u,0x41303155))*GetHeroInt(u,true),false,false,null,null,null)
call SetControlToUnit(u,c,2, "stun")
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
endif
set p=null
set u=null
set l__d=null
set t=null
set c=null
