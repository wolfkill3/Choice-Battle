call UnitRemoveAbility(u,'Amrf')
call SaveEffectHandle(HH,id,10,AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl",u,"origin"))
//war3mapImported\[A]az_axe_ef1.mdl
call UnitCreateAndMove(u,'e1WB',u,GetRandomReal(0,360),0.4,0.8,0.4,100,100,100,0,0,u,0,GetRandomReal(0,360))
//war3mapImported\BY_Wood_GongChengSiPai_6.mdl
call UnitCreateAndMove(u,'e2WN',u,GetRandomReal(0,360),1,0.35,1,100,100,100,0,0,u,0,GetRandomReal(0,360))
endif
if i==15 then
call UnitSpeed(u,0)
endif
if(i<30)then
call SetUnitFlyHeight(u,GetUnitFlyHeight(u)+30,0)
endif
if i>=30 and i<40 or i>=140 and i<=160 then
call SetUnitFlyHeight(u,GetUnitFlyHeight(u)-30,0)
endif
if i>1 and i<41 then
if SR(GetUnitX(u),GetUnitY(u),GetLocationX(LoadLocationHandle(HH,id,7)),GetLocationY(LoadLocationHandle(HH,id,7)))>50 then
set d2=Angle2(GetUnitX(u),GetUnitY(u),GetLocationX(LoadLocationHandle(HH,id,7)),GetLocationY(LoadLocationHandle(HH,id,7)))
call MoveUnit(u,u,10+SR(GetUnitX(u),GetUnitY(u),GetLocationX(LoadLocationHandle(HH,id,7)),GetLocationY(LoadLocationHandle(HH,id,7)))/35,d2)
endif
endif
if(i==40)then
call DestroyEffect(LoadEffectHandle(HH,id,10))
set soundplay=CreateSound("Sound\\Music\\mp3Music\\GajeelT1.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\GajeelTCircle.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
//war3mapImported\1028.mdl
call UnitCreateAndMove(u,'e2WO',u,d2,2,2,0.5,100,100,100,0,-50,u,0,d2)
call UnitCreateAndMove(u,'e2WO',u,d2,2,1,0.8,100,100,100,0,-300,u,0,d2)
call UnitCreateAndMove(u,'e2WO',u,d2,2,1,1.1,100,100,100,0,-500,u,0,d2)
endif
if i>=40 and i<=140 then
set i2=LoadInteger(HH,id,6)
set i2=i2+1
if i2==2 or i2==4 or i2==6 or i2==8 or i2==10 or i==40 then
call GroupClear(G)
call GroupEnumUnitsInRange(G,GetUnitX(u),GetUnitY(u),350,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(GetOwningPlayer(u),E) then
call UnitStop(E)
endif
call GroupRemoveUnit(G,E)
endloop
call GroupClear(G)
endif
if i2==10 or i==40 then

call GroupClear(G)
call GroupEnumUnitsInRange(G,GetUnitX(u),GetUnitY(u),350,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(GetOwningPlayer(u),E) and GetUnitAbilityLevel(E,'Avul')==0 then
call myCustomDamage(u,E,GetHeroStr(u,true),false,false,null,null,null)
call SlowUnit(u,E,0.6,0,4,0,false)
endif
call GroupRemoveUnit(G,E)
endloop
call GroupClear(G)
set i2=0
endif
call SaveInteger(HH,id,6,i2)
endif
if i==40 or i==60 or i==80 or i==100 or i==120 then
//war3mapImported\WindCirclefaster.mdl
call UnitCreateAndMove(u,'e2WI',u,GetRandomReal(0,360),1,GetRandomReal(1,1.5),GetRandomReal(0.6,0.8),100,100,100,GetRandomReal(40,50),-500,u,0,d2)
endif
if i<140 then
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SetUnitPathing(u,false)
call SetUnitFacingInstant(u,d2)
endif
if i==140 then
call UnitSpeed(u,1)
call SetUnitAnimationByIndex(u,0)
call SetUnitPathing(u,true)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
endif
if i==160 then
call FlushChildHashtable(HH,id)
call PauseTimer(GetExpiredTimer())
call DestroyTimer(GetExpiredTimer())
endif
set u=null
endfunction
