call SetUnitFacingInstant(c,Atan2(GetUnitY(u)-GetUnitY(c),GetUnitX(u)-GetUnitX(c))*bj_RADTODEG)
call SetUnitAnimation(u,"attack")
call SetUnitAnimation(c,"attack")
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call PauseUnit(u,true)
call SetUnitInvulnerable(c,true)
call SetUnitInvulnerable(u,true)
call SetUnitTimeScale(u,3)
call SetUnitTimeScale(c,2)
set soundplay=SndN(930) // Sound\Music\mp3Music\HibaryNeedleSphree.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
if p==GetLocalPlayer()or GetOwningPlayer(c)==GetLocalPlayer()then
call SetCameraPosition(GetRectCenterX(gg_rct_HibariFight),GetRectCenterY(gg_rct_HibariFight))
endif
call TimerStart(t,0.1,true,function WhiteSphereCast2)
endif
set u=null
set p=null
set c=null
set t=null
endfunction
