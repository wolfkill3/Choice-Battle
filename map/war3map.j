function Trig_Tempa_Josai_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)

if GetSpellAbilityId()=='A08V' then//full tenpa


call ChangeAbilityTime01( u ,3.3,'A08V','ASST')

