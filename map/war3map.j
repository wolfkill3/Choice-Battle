function VStrikeCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local real dmg=LoadReal(h,id,6)+(0.60+0.15*GetUnitAbilityLevel(u,'A0H4'))*GetHeroStr(u,true)*0.05
local real l__s=LoadReal(h,id,7)+0.05
local real l__v=LoadReal(h,id,8)+0.04
local player p=GetOwningPlayer(u)
if GetUnitCurrentOrder(u)==OrderId("drain")then
call SaveReal(h,id,6,dmg)
call SaveReal(h,id,7,l__s)
call SaveReal(h,id,8,l__v)
call SetUnitTimeScale(u,l__v)
call SetUnitFacing(u,a*bj_RADTODEG)
set n=CreateUnit(p,0x65304146,x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitVertexColor(n,190,255,255,100)
call UnitApplyTimedLife(CreateUnit(p,0x6530414C,x,y,GetRandomReal(0,359)),1,0.5)
if l__s>1 and l__s<2 and GetUnitAbilityLevel(u,'A0GN')==0 then
call UnitAddAbility(u,0x41305957)
elseif l__s>2 and l__s<4 and GetUnitAbilityLevel(u,0x41304835)==0 then
call UnitAddAbility(u,0x41304835)
elseif l__s>4 and l__s<6 and GetUnitAbilityLevel(u,0x41304836)==0 then
call UnitAddAbility(u,0x41304836)
endif
else
call MissleMoveVStrike(u,c,u,60,0,dmg+100)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set c=null
set u=null
set t=null
endfunction
