function MadnessTranformationCond takes nothing returns boolean
local integer id=GetSpellAbilityId()
return id=='A0BT' or id=='A03N' or id=='A0BZ' or id=='A0KP' or id=='A0C8' or id=='A07U' or id=='A0UN' or id=='A0PD' or id=='A0LY' or id=='A09J' or id=='A0PR' or id=='A0CI' or id=='A0OX'
endfunction
function MadnessTranformationCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set u=null
set t=null
endfunction
function MadnessTranformationCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real time=LoadReal(h,id,1)
local real time2=LoadReal(h,id,2)
if time2<time then
if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
call SaveReal(h,id,1,time2+0.01)
endif
else
call UnitRemoveBuffsEx(u,false,true,true,true,true,true,true)
call UnitAddItemById(u,'I03T')
call UnitAddItemById(u,'I03U')
call PauseTimer(t)
call TimerStart(t,0.02,false,function MadnessTranformationCast3)
endif
set u=null
set t=null
endfunction
function MadnessTranformationCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local integer sa=GetSpellAbilityId()
local integer lvl=GetUnitAbilityLevel(u,sa)
call SaveReal(h,id,2,0)
if sa=='A0BT' or sa=='A0BZ' or sa=='A0C8' or sa=='A0PR' then
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,2+lvl-0.01)
endif
if sa=='A09J' or sa=='A03N' or sa=='A0PD' or sa=='A0CI' then
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,10*lvl-0.01)
endif
if sa=='A0KP' then
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,3+2*lvl-0.01)
endif
if sa=='A0OX' or sa=='A07U' or sa=='A0LY' then
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,25-0.01)
endif
if sa=='A0UN' then
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,15-0.01)
endif
call TimerStart(t,0.01,true,function MadnessTranformationCast2)
set u=null
set t=null
endfunction
