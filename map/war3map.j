function KienzanCond takes nothing returns boolean
return GetSpellAbilityId()==0x41305358 and udg_B==true
endfunction
function KienzanCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit d1=LoadUnitHandle(h,id,3)
local unit d2=LoadUnitHandle(h,id,4)
local real r=LoadReal(h,id,2)
local group g=LoadGroupHandle(h,id,1)
local integer l__idg=GetHandleId(g)
local player p=GetOwningPlayer(u)
local real x2=GetUnitX(u)
local real y2=GetUnitY(u)
local real x=GetUnitX(d1)
local real y=GetUnitY(d1)
local real x1=GetUnitX(d2)
local real y1=GetUnitY(d2)
local real f1=GetUnitFacing(d1)
local real f2=GetUnitFacing(d2)
local real dmg=GetUnitAbilityLevel(u,0x41305358)*GetHeroInt(u,true)*0.5+50*GetUnitAbilityLevel(u,0x41305358)
if GetWidgetLife(d1)>0 and udg_B==true and DU2==true then
if r<0.25 then
set f1=f1*bj_DEGTORAD
set f2=f2*bj_DEGTORAD
set x=x+45*Cos(f1)
set y=y+45*Sin(f1)
set x1=x1+45*Cos(f2)
set y1=y1+45*Sin(f2)
call SetUnitX(d1,x)
call SetUnitX(d2,x1)
call SetUnitY(d2,y1)
call SetUnitY(d1,y)
call SaveReal(h,id,2,r+0.025)
set n=CreateUnit(p,'e0B2',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitVertexColor(n,200,40,255,30)
set n=CreateUnit(p,'e0B2',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitVertexColor(n,200,40,255,30)
call GroupEnumUnitsInRange(g,x,y,130,Base)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 1, "stun")
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",E,"chest"))
call SaveUnitHandle(h,l__idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
call GroupEnumUnitsInRange(g,x1,y1,130,Base)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 1, "stun")
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",E,"chest"))
call SaveUnitHandle(h,l__idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
else
call SaveReal(h,id,2,0)
if SR(x,y,x2,y2)<1000 then
call SetUnitFacing(d1,f1+GetRandomReal(-90,90))
else
call SetUnitFacing(d1,Atan2(y2-y,x2-x)*bj_RADTODEG)
endif
if SR(x1,y1,x2,y2)<1000 then
call SetUnitFacing(d2,f2-GetRandomReal(-90,90))
else
call SetUnitFacing(d2,Atan2(y2-y1,x2-x1)*bj_RADTODEG)
endif
call FlushChildHashtable(h,l__idg)
endif
else
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
call DestroyTimer(t)
call DestroyGroup(g)
endif
set u=null
set d1=null
set d2=null
set t=null
set g=null
set p=null
endfunction
function KienzanCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real f=GetUnitFacing(u)
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,1,CreateGroup())
call SaveUnitHandle(h,id,3,CreateUnit(p,0x65305157,x+100*Cos((a+deg90)),y+100*Sin((a+deg90)),a*bj_RADTODEG))
call SaveUnitHandle(h,id,4,CreateUnit(p,0x65305157,x+100*Cos((a-deg90)),y+100*Sin((a-deg90)),a*bj_RADTODEG))
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\FriezaDeathSaucer.mp3",false,false,true,12700,12700,"")
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Frieza\\FriezaDeathSaucer-jap.mp3",false,false,true,12700,12700,"")
endif
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.025,true,function KienzanCast2)
set t=null
set u=null
set p=null
endfunction
function InitTrig_Kienzan takes nothing returns nothing
set gg_trg_Kienzan=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Kienzan,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_Kienzan,Condition(function KienzanCond))
call TriggerAddAction(gg_trg_Kienzan,function KienzanCast)
endfunction
function TelekinezCond takes nothing returns boolean
return GetSpellAbilityId()==0x41305357
endfunction
function TelekinezCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
