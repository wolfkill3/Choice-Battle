return GetSpellAbilityId()=='A0OJ' and GetUnitTypeId(GetTriggerUnit())!='H007'  and GetUnitAbilityLevel(GetTriggerUnit(),'GIE1')==0
endfunction
function BashosenCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local real x=LoadReal(HH,id,1)
local real y=LoadReal(HH,id,2)
local real a=Atan2(LoadReal(HH,id,4)-y,LoadReal(HH,id,3)-x)
local real l__d=LoadReal(HH,id,5)
local group g=LoadGroupHandle(HH,id,6)
local player p=GetOwningPlayer(u)
local real dmg=6*GetHeroInt(u,true)
local real l__s=LoadReal(HH,id,8)
if l__d<2000 then
set x=x+l__d*Cos(a)
set y=y+l__d*Sin(a)
set n=CreateUnit(p,'e0MZ',x,y,(a*bj_RADTODEG))
call SetUnitScale(n,l__s,l__s,l__s)
call SaveReal(HH,id,8,l__s+0.08)
call UnitApplyTimedLife(n,'BTLF',0.01)
call SaveReal(HH,id,5,l__d+40)
call GroupEnumUnitsInRange(g,x,y,200*l__s,Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set ide=GetHandleId(E)
if Condition_Base(p,E) and E!=LoadUnitHandle(HH,idg,ide)then
call SaveUnitHandle(HH,idg,ide,E)
call Push3(E,60,a,1000,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call WeakenUnit(u,E,4,0.5, false )
endif
call GroupRemoveUnit(g,E)
endloop
else
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
call FlushChildHashtable(HH,idg)
call FlushChildHashtable(HH,id)
endif
set p=null
set u=null
set g=null
set t=null
endfunction
