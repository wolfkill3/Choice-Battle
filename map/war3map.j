call UnitApplyTimedLife(n,1,3)
set n=CreateUnit(p,'e0QC',x,y,0)
call UnitApplyTimedLife(n,1,3)
set n=CreateUnit(p,'e0QA',x,y,0)
call SetUnitTimeScale(n,0.4)
call UnitApplyTimedLife(n,1,3)
set n=CreateUnit(p,'e0TK',x,y,0)
call UnitApplyTimedLife(n,1,3)
set n=CreateUnit(p,'e0TO',x,y,0)
call UnitApplyTimedLife(n,1,3)
call SaveUnitHandle(h,id,0,u)
call SetUnitInvulnerable(u,true)
call SetUnitAnimation(u,"stand")
set soundplay=CreateSound("Sound\\Music\\mp3Music\\UlquiorraW.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,1,false,function ReiatsuSlamCast2)
set u=null
set t=null
set p=null
endfunction
