endfunction
function HellSpiritCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=LoadReal(h,id,15)
local player p=GetOwningPlayer(u)
local real fh=GetUnitFlyHeight(c)+40
local real sc=GetRandomReal(1,4)
local real time=LoadReal(h,id,5)
call SaveReal(h,id,5,time+0.15)
if fh<700 and UnitIsAlive(c) and time<3 then
call SetUnitXY_1(c,x+75*Cos(a),y+75*Sin(a), false)
call SetUnitFlyHeight(c,fh,0)
call SetUnitFlyHeight(u,fh,0)
set n=CreateUnit(p,'e0YK',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,125)
call UnitApplyTimedLife(n,'B000',0.01)
call SetUnitFlyHeight(n,fh,0)
set n=CreateUnit(p,'e0YK',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,125)
call SetUnitScale(n,sc,sc,sc)
call UnitApplyTimedLife(n,'B000',0.01)
call SetUnitAnimation(u,"attack")
else
call UnitRemoveAbility(u,'A0O1')
call UnitMakeAbilityPermanent(u,false,'A0O1')
set n=CreateUnit(p,'e0MY',x,y,GetRandomReal(0,359))
call HellSpiritMissleFly(c,n,25,a,x1+1000*Cos(a),y1+1000*Sin(a),700,0)
set n=CreateUnit(p,'e0ME',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,1)
call SetUnitFlyHeight(n,GetUnitFlyHeight(c),0)
call SetUnitAnimation(u,"spell slam")
call SetUnitFlyHeight(u,0,700)
call SetUnitInvulnerable(u,false)
call SetUnitInvulnerable(c,false)
call UnitRemoveAbility(c,'A0QL')
call PauseUnit(u,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function HellSpiritCast takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
