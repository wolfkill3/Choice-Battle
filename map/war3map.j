    local trigger toggleEmote = null
    local trigger toggleStats = null
    local trigger AbilityModeHotkey = null
    local integer x=0
    local integer i
    local integer j
    set i=0
    loop
    exitwhen(i>12)
    set j=0
    loop
    exitwhen(j>12)
    call SaveInteger(HPlayer,i,j,0)
    call SaveInteger(HPlayer,i+20,j+20,0)
    set j=j+1
    endloop
    set i=i+1
    endloop
    //call ClearFrameAllPoints( GetOriginFrame(ORIGIN_FRAME_TIME_OF_DAY_INDICATOR,0))
    //call ShowFrame( GetOriginFrame(ORIGIN_FRAME_TIME_OF_DAY_INDICATOR,0), false )
    //call ClearFrameAllPoints( GetFrameByName("SimpleClassValue",0))
    //call ClearFrameAllPoints( GetFrameByName("SimpleNameValue",0))
    //call SetFrameRelativePoint( GetFrameByName("SimpleHeroLevelBar",0), FRAMEPOINT_CENTER, consoleUI, FRAMEPOINT_BOTTOM,  -.0013, -.1  )
