function MusicONCast takes nothing returns nothing
    local integer i=GetRandomInt(1,110)
    loop
    exitwhen i != currentsong
    set i = GetRandomInt(1,110)
    endloop
    set currentsong = i
    if songbool==false then
                set song=i
                set songcounter=songcounter-1
                call ClearMapMusic()
                call StopMusic(false)
                call ExecuteFunc("MusicONInit")
                call PlayMusic(music[song])
                elseif songcounter==1 then
                set songbool=false
                set song=i
                call ClearMapMusic()
                call StopMusic(false)
                call ExecuteFunc("MusicONInit")
                call PlayMusic(music[song])
                set songcounter=songcounter-1
    elseif songcounter>1 then
                set songcounter=songcounter-1
    endif
endfunction
function MusicONInit takes nothing returns nothing
    local trigger t=CreateTrigger()
    local integer sd=480
    set songcounter=songcounter+1
    if sd==0 or sd==null then
                call ClearMapMusic()
                call StopMusic(false)
    else
                call TriggerRegisterTimerEvent(t,sd,false)
                call TriggerAddAction(t,function MusicONCast)
    endif
    set t=null
endfunction

function expMusicPlayer_Switcher takes nothing returns nothing
        local integer i=GetRandomInt(1,110)
        call ClearMapMusic()
        call StopMusic(false)
        call PlayMusic(music[i])
        if expMTimer!=null then
                call PauseTimer(expMTimer)
                call DestroyTimer(expMTimer)
        endif
        set expMTimer=CreateTimer()
        call UpdateMultiboard()
        call TimerStart(expMTimer, 360, false, function expMusicPlayer_Switcher)
endfunction

function expMusicPlayer takes nothing returns nothing
        local integer i=GetRandomInt(1,110)
        call ClearMapMusic()
        call StopMusic(false)
        call PlayMusic(music[i])
        if expMTimer!=null then
                call PauseTimer(expMTimer)
                call DestroyTimer(expMTimer)
        endif
        set expMTimer=CreateTimer()
        call TimerStart(expMTimer, 360, false, function expMusicPlayer)
endfunction

