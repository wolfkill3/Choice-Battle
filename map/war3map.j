endfunction
function GigaShinra2Cast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local group g=LoadGroupHandle(h,id,1)
local group g2
local integer idu=GetHandleId(u)
local group gn=LoadGroupHandle(h,idu,GroupHash)
local integer i=1
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local real dist
local real dmg=LoadReal(h,id,13)
local integer l__idg=GetHandleId(g)
local real f
local player p=GetOwningPlayer(u)
local integer l__ide
local real time=LoadReal(h,id,4)
if time<2 then
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SaveReal(h,id,4,time+0.15)
if time==1.95 then
set n=CreateUnit(p,'e0ON',x,y,0)
call SetUnitFlyHeight(n,500,0)
call UnitApplyTimedLife(n,'BTLF',1)
call UnitScale(n,0.01,3.1,1)
set n=CreateUnit(p,'e0ON',x,y,0)
call SetUnitFlyHeight(n,500,0)
call UnitApplyTimedLife(n,'BTLF',1)
call UnitScale(n,0.01,3.1,1)
set n=CreateUnit(p,'e0ON',x,y,0)
call SetUnitFlyHeight(n,500,0)
call UnitApplyTimedLife(n,'BTLF',1)
call UnitScale(n,0.01,3.1,1)
call SetUnitAnimation(u,"Spell Defend")
set n=CreateUnit(p,'e0FM',x,y,GetRandomReal(0,359))
call SetUnitTimeScale(n,GetRandomReal(0.10,0.8))
call UnitApplyTimedLife(n,'BTLF',0.01)
set n=CreateUnit(p,'e0FM',x,y,GetRandomReal(0,359))
call SetUnitTimeScale(n,GetRandomReal(0.10,0.8))
call UnitApplyTimedLife(n,'BTLF',0.01)
set n=CreateUnit(p,'e0FM',x,y,GetRandomReal(0,359))
call SetUnitTimeScale(n,GetRandomReal(0.10,0.8))
call UnitApplyTimedLife(n,'BTLF',0.01)
set soundplay=SndN(1830) // Sound\Music\mp3Music\PeinShinraGigaTensei.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
else
call SetUnitXY_1(u,x,y, false)
loop
exitwhen i>15
set dist=LoadReal(h,id,StringHash("dist"+I2S(i)))+200
call SaveReal(h,id,StringHash("dist"+I2S(i)),dist)
set f=(24*i)*bj_DEGTORAD
call DestroyEffect(AddSpecialEffect("war3mapImported\\s_Shockwave.mdx",x+dist*Cos(f),y+dist*Sin(f)))
call DestroyEffect(AddSpecialEffect("war3mapImported\\Rasengan4.mdx",x+dist*Cos(f),y+dist*Sin(f)))
set i=i+1
endloop
call GroupEnumUnitsInRange(g,x,y,dist,Base)
set n=CreateUnit(p,'e0P9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',1)
call UnitScale(n,0.01,7.0,0.75)
loop
set E=FirstOfGroup(g)
set l__ide=GetHandleId(E)
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,l__ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,l__idg,l__ide,E)
call Push3(E,50,Atan2(GetUnitY(E)-y,GetUnitX(E)-x),1500,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
call PauseUnit(u,true)
if dist>=1500 then
call SetUnitFlyHeight(u,0,500)
call SetUnitTimeScale(u,1)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
set g2=CopyGroup(gn)
loop
set E=FirstOfGroup(g2)
exitwhen E==null
if GetUnitAbilityLevel(GetTriggerUnit(),'A0IH')==0 then
call SetUnitAnimation(E,"Stand")
call PauseUnit(E,false)
call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,false)
endif
call GroupRemoveUnit(g2,E)
endloop
call DestroyGroupTimed(g2,3)
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
endif
set u=null
set g=null
set g2=null
set t=null
set gn=null
set p=null
endfunction
