else
set shikihe=he
call SaveReal(HH,idu,SH_DIQ,350)
call SetUnitAnimation(u,"Spell throw three")
call SetUnitTimeScale(u,2)
call SetUnitFlyHeight(u,GetUnitFlyHeight(u)-100,0)
if GetUnitAbilityLevel(u,'A2BM')==0 then
call SetUnitX(u,x+90*Cos(a))
