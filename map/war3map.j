local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real fl=LoadReal(h,id,1)
local real a=LoadReal(h,id,2)
if fl<600 then
call SetUnitTimeScale(u,-3)
set x=x+25*Cos(a)
set y=y+25*Sin(a)
call SaveReal(h,id,1,fl+25)
call SetUnitXY_1(u,x,y, false)
call SetUnitFlyHeight(u,ParabolaZ(350,600,600-fl),0)
call SetUnitTurnSpeed(u,0.10)
else
call WDeidara2Push(u,25,a,350)
call SetUnitFlyHeight(u,0,0)
call SetUnitTurnSpeed(u,3)
call SetUnitTimeScale(u,1)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set t=null
endfunction
