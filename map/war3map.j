function QRulerCond takes nothing returns boolean
return GetLearnedSkill()=='A1HM'
endfunction
function QRulerCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local player p
local real x
local real y
if UnitIsAlive(u)then
set x=GetUnitX(u)
set y=GetUnitY(u)
set p=GetOwningPlayer(u)
call HealTextTag(u,u,(GetUnitState(u,UNIT_STATE_MAX_LIFE)-GetUnitState(u,UNIT_STATE_LIFE))*.05*myCustomHeal2(u,1),"HealthRes")
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+(GetUnitState(u,UNIT_STATE_MAX_LIFE)-GetUnitState(u,UNIT_STATE_LIFE))*.05)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\HolyAwakening.mdx",u,"origin"))
call GroupEnumUnitsInRange(G,x,y,500,Base)
call GroupRemoveUnit(G,u)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if IsUnitAlly(E,p)then
call HealTextTag(u,E,(GetUnitState(E,UNIT_STATE_MAX_LIFE)-GetUnitState(E,UNIT_STATE_LIFE))*.05*myCustomHeal2(E,1),"HealthRes")
call SetUnitState(E,UNIT_STATE_LIFE,GetUnitState(E,UNIT_STATE_LIFE)+(GetUnitState(E,UNIT_STATE_MAX_LIFE)-GetUnitState(E,UNIT_STATE_LIFE))*.05)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Transmute\\GoldBottleMissile.mdl",E,"chest"))
endif
call GroupRemoveUnit(G,E)
endloop
elseif u==null then
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set p=null
set u=null
set t=null
endfunction
function QRulerCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t
local integer id=0
local player p=GetOwningPlayer(u)
local integer lvl=GetUnitAbilityLevel(u,'A1HM')
if lvl==1 then
call UnitMakeAbilityPermanent(u,true,'A1HQ')
call UnitMakeAbilityPermanent(u,true,'A1HS')
call UnitMakeAbilityPermanent(u,true,'A1HR')
call UnitMakeAbilityPermanent(u,true,'A1HT')
set t=CreateTimer()
set id=GetHandleId(t)
call SaveUnitHandle(HH,id,0,u)
call TimerStart(t,5,true,function QRulerCast2)
endif
set t=null
set p=null
set u=null
endfunction
