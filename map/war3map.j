function DanceMCond takes nothing returns boolean
return GetSpellAbilityId()==0x4130444B
endfunction
function DanceMCast2 takes nothing returns nothing //dante R
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(h,id,0)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        local player p=GetOwningPlayer(u)
        local group g=LoadGroupHandle(h,id,4)
        local group g2=LoadGroupHandle(h,id,10)
        local real dmg=(4+GetUnitAbilityLevel(u,0x4130444B))*GetHeroStr(u,true)
        // if GetUnitAbilityLevel(u,'A28U')>0 and GetUnitState(u,UNIT_STATE_LIFE)<=GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.25 then
                // set dmg=dmg+dmg*.2
        // else
        if GetUnitAbilityLevel(u,'A28U')>0 then
                set dmg=dmg+dmg*.1
        endif
        if GetUnitCurrentOrder(u)==OrderId("root") or GetUnitCurrentOrder(u)==OrderId("acolyteharvest") then
            set n=CreateUnit(p,'e0GJ',x,y,0)
            call UnitApplyTimedLife(n,1,0.2)
            call SetUnitTimeScale(n,0)
            call UnitScale(n,1,8,0.35)
            call SetUnitVertexColor(n,255,255,255,60)
            call SetUnitInvulnerable(u,true)
            call UnitApplyTimedLife(CreateUnit(p,'h021',x,y,GetRandomReal(0,359)),1,0.1)
            call UnitApplyTimedLife(CreateUnit(p,'h121',x,y,GetRandomReal(0,359)),1,0.2)
            set n=CreateUnit(p,'h022',x,y,GetRandomReal(0,359))
            call UnitApplyTimedLife(n,1,0.8)
            call SetUnitVertexColor(n,200,200,200,140)
            call GroupEnumUnitsInRange(g,x,y,350,Base)
            loop
            set E=FirstOfGroup(g)
            exitwhen E==null
            if Condition_Base(p,E) then
                if IsUnitInGroup(E, g2)==false then
                    call myCustomDamage(u,E,dmg,false,false,null,null,null)
                    call SetControlToUnit(E,E,1,"stun")
                    call GroupAddUnit(g2, E)
                else
                    call Push(E,50,Atan2(GetUnitY(E)-y,GetUnitX(E)-x),300)
                endif
            endif
            call GroupRemoveUnit(g,E)
            endloop
        else
            call DestroyGroup(g)
            call DestroyGroup(g2)
            call SetUnitInvulnerable(u,false)
            call PauseTimer(t)
            call DestroyTimer(t)
            call FlushChildHashtable(h,id)
        endif
        set p=null
        set u=null
        set g=null
        set g2=null
        set t=null
endfunction
