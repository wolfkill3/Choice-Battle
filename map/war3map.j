function MissleMoveTransmission2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local unit u=LoadUnitHandle(h,id,7)
local real time=LoadReal(h,id,9)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
local real dist=LoadReal(h,id,6)
local real mh=LoadReal(h,id,5)
local real rd=SR(x,y,x1,y1)
local player p=GetOwningPlayer(u)
local integer idu=GetPlayerId(p)
local real fl
if rd>speed+30 and udg_B==true and time<3 and UnitIsAlive(l__d)and GetUnitAbilityLevel(l__d,'A1BL')==0 then
call SaveReal(h,id,9,time+0.02)
call SetUnitPosition(l__d,x1,y1)
call SetUnitPosition(l__d,x+speed*Cos(a),y+speed*Sin(a))
call SetUnitFacing(l__d,a*bj_RADTODEG)
set fl=ParabolaZ(mh,dist,rd)
call SetUnitFlyHeight(l__d,fl,0)
call SetUnitPathing(l__d,false)
set n=CreateUnit(p,0x65305047,x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'B000',1)
call SetUnitFlyHeight(n,fl,0)
call SetUnitTimeScale(n,3)
else
call UnitApplyTimedLife(CreateUnit(p,'e03X',x1,y1,a*bj_RADTODEG),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e03W',x1,y1,a*bj_RADTODEG),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e08R',x1,y1,a*bj_RADTODEG),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e03Y',x1,y1,a*bj_RADTODEG),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e08N',x1,y1,a*bj_RADTODEG),1,1)
if GetUnitAbilityLevel(l__d,'A1BL')==0 then
call Push(l__d,25,LoadReal(h,id,8),400)
call SetUnitFlyHeight(l__d,0,0)
endif
call SetUnitPathing(l__d,true)
call PauseUnit(l__d,false)
call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,false)
call myCustomDamage(u,l__d,(3+GetUnitAbilityLevel(u,0x41305155))*GetHeroAgi(u,true)+LoadReal(h, id, 99),false,false,null,null,null)
call SetControlToUnit(u,l__d,2,"stun")
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set p=null
set l__d=null
set t=null
endfunction
function MissleMoveTransmission takes unit l__d,real speed,real angle,real x,real y,real mh,unit u returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SetUnitPathing(l__d,false)
call PauseUnit(l__d,true)
call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,true)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,mh)
call SaveReal(h,id,6,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,99,SR(x,y,GetUnitX(l__d),GetUnitY(l__d))*(0.06*GetUnitAbilityLevel(u, 0x41305155)))
call SaveUnitHandle(h,id,7,u)
call SaveReal(h,id,8,Atan2(y-GetUnitY(l__d),x-GetUnitX(l__d)))
call TimerStart(t,0.02,true,function MissleMoveTransmission2)
set t=null
endfunction
