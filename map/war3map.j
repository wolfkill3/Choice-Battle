local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local group g=LoadGroupHandle(h,id,4)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,5)
local integer l__idg=GetHandleId(g)
local integer l__ide
local player p=GetOwningPlayer(u)
local real dmg=GetHeroStr(u,true)*GetUnitAbilityLevel(u,'A06V')+100*GetUnitAbilityLevel(u,'A06V')
if SR(x,y,x1,y1)<=2000 then
call SetUnitX(l__d,x1+60*Cos(a))
call SetUnitY(l__d,y1+60*Sin(a))
call GroupEnumUnitsInRange(g,x1,y1,200,Base)
loop
set E=FirstOfGroup(g)
set l__ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,l__ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,l__idg,l__ide,E)
call SetControlToUnit(E,E, 2, "stun")
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Flameshock.mdx",E,"chest"))
endif
call GroupRemoveUnit(g,E)
endloop
call UnitApplyTimedLife(CreateUnit(p,'e02F',x1,y1,a*bj_RADTODEG),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e02G',x1,y1,a*bj_RADTODEG),1,2)
else
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
call DestroyTimer(t)
call DestroyGroup(g)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function Trig_Dai_Funka_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,CreateUnit(GetOwningPlayer(u),'e044',x+80*Cos(a),y+80*Sin(a),f))
call SaveGroupHandle(h,id,4,CreateGroup())
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveReal(h,id,5,a)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\InugamiGuren.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
if GetUnitAbilityLevel(u,'A155')==0 and GetHeroLevel(u)>5 then
call UnitAddAbility(u,'A155')
call UnitMakeAbilityPermanent(u,true,'A155')
else
call SetUnitAbilityLevel(u,'A155',GetUnitAbilityLevel(u,'A155')+1)
endif
call SetUnitFacing(LoadUnitHandle(h,id,1),a*bj_RADTODEG)
call TimerStart(t,0.03,true,function Trig_Dai_Funka_Actions2)
set u=null
set t=null
endfunction
