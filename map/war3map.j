function QKingHassanLearnCast takes nothing returns nothing
    local unit u=GetTriggerUnit()
    local integer lvl=GetUnitAbilityLevel(u,'A1GM')
    local integer id=GetPlayerId(GetOwningPlayer(u))
    call UnitMakeAbilityPermanent(u,true,'A1GM')
    if lvl==1 then
    call UnitAddAbility(u,'A1GN')
    call UnitMakeAbilityPermanent(u,true,'A1GN')
    call UnitAddAbility(u,'A1GO')
