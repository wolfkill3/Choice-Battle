endfunction

function IchigoBankaiW_Periodic takes nothing returns nothing
    local integer id  = GetHandleId(GetExpiredTimer())
    local unit caster = LoadUnitHandle(h, id, 0)
    local real caster_x = GetUnitX(caster)
    local real caster_y = GetUnitY(caster)
    local real time     = LoadReal(h, id, 1)
    if time>0 and UnitIsAlive(caster) and GetUnitAbilityLevel(caster, 'IcB1')>0 then
        call PauseUnit(caster, true)
        if LoadBoolean(HH,GetHandleId(caster),TARGET_ABILITY)==false then
            call SaveReal(h, id, 1, time-0.05)
        endif
        if ModuloReal(time,0.2)<0.05 then
            set n=CreateUnit(GetOwningPlayer(caster), 'dM05', caster_x, caster_y, GetRandomInt(0, 360))
            call SetUnitScale(n, 0.5, 0.5, 0.5)
            call SetUnitVertexColor(n, 255, 255, 255, 140)
            call MyRemoveUnit(n, 1.5)
        endif
        if LoadUnitHandle(HH,GetHandleId(caster),REVERSE_TARGET)!=null then
            call IchigoBankaiW_Counter(caster, LoadUnitHandle(HH,GetHandleId(caster),REVERSE_TARGET))
            call RemoveSavedHandle(HH,GetHandleId(caster),REVERSE_TARGET)
        endif
    else
        call DestroyEffect(LoadEffectHandle(h, id, 3))
        call DestroyEffect(LoadEffectHandle(h, id, 4))
        call SaveBoolean(HH,GetHandleId(caster),ANTITARGET_ABILITY,false)
        call PauseUnit(caster, false)
        call UnitRemoveAbility(caster, 'IcB1')
        call FlushChildHashtable(h, id)
        call PauseTimer(GetExpiredTimer())
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
endfunction

function IchigoBankaiW_Cast takes unit newCaster returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local real caster_x  = GetUnitX(newCaster)
    local real caster_y  = GetUnitY(newCaster)
    set soundplay=CreateSound("Sound\\war3mapImported\\IchigoTW1.mp3", false, false, true, 12700, 12700, "")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd001', caster_x, caster_y, GetRandomInt(0, 360))
    call SetUnitScale(n, 1.2, 1.2, 1.2)
    call MyRemoveUnit(n, 1.5)
    set bjLCE=AddSpecialEffectTarget("az_airfloww111.mdl", newCaster, "origin")
    call SaveEffectHandle(h, id, 3, bjLCE)
    set bjLCE=AddSpecialEffectTarget("az_airfloww111.mdl", newCaster, "origin")
    call SaveEffectHandle(h, id, 4, bjLCE)
    call UnitAddAbility(newCaster, 'IcB1')
    call UnitMakeAbilityPermanent(newCaster, true, 'IcB1')
    call PauseUnit(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, 4)
    call SaveBoolean(HH,GetHandleId(newCaster),ANTITARGET_ABILITY,true)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(h, id, 1, 2.0)
    call TimerStart(newTimer, 0.05, true, function IchigoBankaiW_Periodic)
    set newTimer=null
endfunction

function IchigoBankaiW_Target takes unit newCaster, unit newTarget returns nothing
        local timer newTimer = CreateTimer()
        local integer id     = GetHandleId(newTimer)
        local real caster_x  = GetUnitX(newCaster)
        local real caster_y  = GetUnitY(newCaster)
        local real angle     =  AU(newCaster, newTarget)
        local real damage    = GetHeroStr(newCaster, true)*8
                        
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd001', caster_x, caster_y, GetRandomInt(0, 360))
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd074', caster_x+200*Cos(angle), caster_y+200*Sin(angle), angle*bj_RADTODEG)
        call SetUnitScale(n, 2, 2, 2)
        call SetUnitFlyHeight(n, 75, 0)
        call UnitApplyTimedLife(n, 1, 0.2)
        call MyRemoveUnit(n, 1.5)
        call UnitRemoveAbility(newCaster, 'IcB1')
        call PauseUnit(newCaster, true)
        call SetUnitInvulnerable(newCaster, true)
        call SetUnitAnimationByIndex(newCaster, 3)
        call SaveUnitHandle(h, id, 0, newCaster)
        call SaveUnitHandle(h, id, 1, newTarget)
        call SaveReal      (h, id, 2, 0.8)
        call SaveReal      (h, id, 3, angle)
        call SaveReal      (h, id, 9, damage)
        call TimerStart(newTimer, 0.02, true, function IchigoBankaiW_CounterPeriodic)
        set newTimer=null
endfunction

function IchigoBankaiE_SIPeriodic takes nothing returns nothing
        local integer id = GetHandleId(GetExpiredTimer())
        local unit dummy = LoadUnitHandle(h, id, 1)
        local real time  = LoadReal(h, id, 2)+0.02
        local real angle = GetUnitFacing(dummy)*bj_DEGTORAD
        call SaveReal(h, id, 2, time)
        if time<0.3 then
                call SetUnitX(dummy, GetUnitX(dummy)+25*Cos(angle))
                call SetUnitY(dummy, GetUnitY(dummy)+25*Sin(angle))
        else
                set n=CreateUnit(GetOwningPlayer(dummy), 'd042', GetUnitX(dummy), GetUnitY(dummy), GetRandomInt(0, 360))
                call SetUnitScale(n, 1, 1, 1)
                call MyRemoveUnit(n, 1.0)
                call RemoveUnit(dummy)
                call FlushChildHashtable(h, id)
                call PauseTimer(GetExpiredTimer())
                call DestroyTimer(GetExpiredTimer())
        endif
        set dummy=null
endfunction

function IchigoBankaiE_SingleImage takes unit newCaster, unit newTarget, real angle returns nothing
        local timer newTimer = CreateTimer()
        local integer id     = GetHandleId(newTimer)
        local real random_real = GetRandomReal(50, 400)
        local real point_x = GetUnitX(newTarget) + random_real*Cos(angle)
        local real point_y = GetUnitY(newTarget) + random_real*Sin(angle)
        local real i       = 1
        if GetRandomInt(0, 1)==0 then
                set i=-1
        endif
        set angle = angle + GetRandomInt(35, 140)*i * bj_DEGTORAD
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd044', point_x, point_y, angle*bj_RADTODEG)
        call SetUnitVertexColor(n, 255, 255, 255, 165)
        call SetUnitAnimationByIndex(n, 2)
        call SetUnitScale(n, 1.1, 1.1, 1.1)
        call SetUnitFlyHeight(n, 5, 0)
        call SaveUnitHandle     (h, id, 1, n)
        call SaveReal           (h, id, 2, 0.0)
        call TimerStart(newTimer, 0.02, true, function IchigoBankaiE_SIPeriodic)
        set newTimer=null
endfunction


function IchigoBankaiE_Periodic2 takes nothing returns nothing
	local integer id = GetHandleId(GetExpiredTimer())
	local unit caster = LoadUnitHandle(h, id, 0)
	local unit target = LoadUnitHandle(h, id, 1)
	local boolean b_act = LoadBoolean(h, id, 11)
	local real time     = LoadReal(h, id, 3)+0.02
	local real damage   = GetHeroStr(caster, true)*7.5
	call SaveReal(h, id, 3, time)
	
	if time<1.0 then
		call IssueImmediateOrder(target, "stop")
        call SetControlToUnit(target, target, 0.2, "silence")
		if time==0.7 then
			call SetUnitAnimationByIndex(caster, GetRandomInt(7, 8))
		endif
	else
		if b_act then
			set damage=damage*1.35
			set n=CreateUnit(GetOwningPlayer(caster), 'd037', GetUnitX(target), GetUnitY(target), AU(caster, target)*bj_RADTODEG)
			call SetUnitFlyHeight(n, 50, 0)
			call SetUnitScale(n, 1.5, 1.5, 1.5)
			call MyRemoveUnit(n, 1.5)
			set n=CreateUnit(GetOwningPlayer(caster), 'd021', GetUnitX(target), GetUnitY(target), AU(caster, target)*bj_RADTODEG)
			call SetUnitFlyHeight(n, 50, 0)
			call SetUnitScale(n, 1.5, 1.5, 1.5)
			call MyRemoveUnit(n, 1.5)
			set n=CreateUnit(GetOwningPlayer(caster), 'd040', GetUnitX(target), GetUnitY(target), AU(caster, target)*bj_RADTODEG)
			call SetUnitFlyHeight(n, 5, 0)
			//call SetUnitScale(n, 1.5, 1.5, 1.5)
			call UnitApplyTimedLife(n, 1, 1.0)
			call MyRemoveUnit(n, 2)
			call ShakeCamera(0.5, 15)
			call Push3(target , 30 , AU(caster, target) , 200 , "")
		else
			call Push3(target , 30 , AU(caster, target) , 100 , "")
			call ShakeCamera(0.5, 10)
		endif
		set soundplay=CreateSound("Sound\\war3mapImported\\IchigoTE2.mp3", false, false, true, 12700, 12700, "")
		call StartSound(soundplay)
		call KillSoundWhenDone(soundplay)
		set n=CreateUnit(GetOwningPlayer(caster), 'd036', GetUnitX(target), GetUnitY(target), AU(caster, target)*bj_RADTODEG+55)
		call SetUnitFlyHeight(n, 150, 0)
		call SetUnitScale(n, 2, 2, 2)
		call MyRemoveUnit(n, 1.5)
		set n=CreateUnit(GetOwningPlayer(caster), 'd038', GetUnitX(caster), GetUnitY(caster), AU(caster, target)*bj_RADTODEG)
		call SetUnitFlyHeight(n, 50, 0)
		call MyRemoveUnit(n, 1.5)
		set n=CreateUnit(GetOwningPlayer(caster), 'd018', GetUnitX(caster), GetUnitY(caster), AU(caster, target)*bj_RADTODEG)
		call SetUnitFlyHeight(n, 50, 0)
		call SetUnitScale(n, 2, 2, 2)
		call MyRemoveUnit(n, 1.5)
		set n=CreateUnit(GetOwningPlayer(caster), 'd010', GetUnitX(target), GetUnitY(target), AU(caster, target)*bj_RADTODEG)
		call SetUnitFlyHeight(n, 5, 0)
		call SetUnitScale(n, 2, 2, 2)
		call MyRemoveUnit(n, 1.5)
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call myCustomDamage(caster, target, damage, false,false,null,null,null)
        call SetControlToUnit(target, target, 1.0, "stun")
        call FlushChildHashtable(h, id)
        call PauseTimer(GetExpiredTimer())
        call DestroyTimer(GetExpiredTimer())
        endif
        set caster=null
        set target=null
endfunction

function IchigoBankaiE_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local unit caster = LoadUnitHandle(h, id, 0) 
    local unit target = LoadUnitHandle(h, id, 1)
    local real target_x= GetUnitX(target)
    local real target_y= GetUnitY(target)
    local real angle= AP(target_x, target_y, LoadReal(h, id, 7), LoadReal(h, id, 8))
    local real time= LoadReal(h, id, 3)+0.02
    local integer eff_period= LoadInteger(h, id, 5)
    local integer eff_period2= LoadInteger(h, id, 6)
    
    call SaveReal(h, id, 3, time)
    
    if time<2.5 and UnitIsAlive(target) and SquareRootPoint(target_x, target_y, LoadReal(h, id, 7), LoadReal(h, id, 8))<500 then
        call IchigoBankaiE_SingleImage(caster, target, angle+GetRandomInt(0, 360)*bj_DEGTORAD)
    else
        call KillUnit(LoadUnitHandle(h, id, 9))
        call KillUnit(LoadUnitHandle(h, id, 10))
        call MyRemoveUnit(LoadUnitHandle(h, id, 9), 1.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, 10), 1.5)
        call ShowUnit(caster, true)
        if GetLocalPlayer()==GetOwningPlayer(caster) then
            call ClearSelection()
            call SelectUnit(caster, true)
        endif
        call SaveReal(h, id, 3, 0.0)
        if UnitIsAlive(target) then
            call SetUnitX(caster, target_x+150*Cos(angle))
            call SetUnitY(caster, target_y+150*Sin(angle))
            if LoadBoolean(HH,GetHandleId(target),ANTITARGET_ABILITY)==false then
                call PauseUnit(caster, true)
                call SetUnitInvulnerable(caster, true)
                call SetUnitFacing(caster, angle*bj_RADTODEG-180)
                if SquareRootPoint(target_x, target_y, LoadReal(h, id, 7), LoadReal(h, id, 8))<500 then
                    call SaveBoolean(h, id, 11, false)
                else
                    set n=CreateUnit(GetOwningPlayer(caster), 'd020', GetUnitX(caster), GetUnitY(caster), AU(caster, target)*bj_RADTODEG)
                    call SetUnitFlyHeight(n, 5, 0)
                    //call SetUnitScale(n, 1.5, 1.5, 1.5)
                    call MyRemoveUnit(n, 1.5)
                    call SaveBoolean(h, id, 11, true)
                endif
                set n=CreateUnit(GetOwningPlayer(caster), 'd011', GetUnitX(caster), GetUnitY(caster), 0)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'dM30', GetUnitX(caster), GetUnitY(caster), 0)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'd009', GetUnitX(caster), GetUnitY(caster), 0)
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call MyRemoveUnit(n, 1.5)
                call PauseTimer(GetExpiredTimer())
                call TimerStart(GetExpiredTimer(), 0.02, true, function IchigoBankaiE_Periodic2)
            else
                set n=CreateUnit(GetOwningPlayer(caster), 'd011', GetUnitX(caster), GetUnitY(caster), 0)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'dM30', GetUnitX(caster), GetUnitY(caster), 0)
                call MyRemoveUnit(n, 1.5)
                call SetUnitVertexColor(caster, 255, 255, 255, 255)
                call SetUnitFlyHeight(caster, 0, 0)
		        call SetUnitFlyHeight(target, 0, 0)
                call PauseUnit(caster,false)
                call SaveUnitHandle(HH,GetHandleId(target),REVERSE_TARGET,caster)
                call SetUnitInvulnerable(caster,false)
                call FlushChildHashtable(h,id)
                call DestroyTimer(GetExpiredTimer())
            endif    
        else
            set n=CreateUnit(GetOwningPlayer(caster), 'd011', LoadReal(h, id, 7), LoadReal(h, id, 8), 0)
            call MyRemoveUnit(n, 1.5)
            set n=CreateUnit(GetOwningPlayer(caster), 'dM30', LoadReal(h, id, 7), LoadReal(h, id, 8), 0)
            call MyRemoveUnit(n, 1.5)
            call PauseUnit(caster, false)
            call SetUnitInvulnerable(caster, false)
            call SetUnitX(caster, LoadReal(h, id, 7))
            call SetUnitY(caster, LoadReal(h, id, 8))
            call FlushChildHashtable(h, id)
            call PauseTimer(GetExpiredTimer())
            call DestroyTimer(GetExpiredTimer())
        endif
    endif
    set caster=null
    set target=null
endfunction

function IchigoBankaiE_Cast takes unit newCaster, unit newTarget returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local real caster_x  = GetUnitX(newCaster)
    local real caster_y  = GetUnitY(newCaster)
    local real damage    = GetHeroStr(newCaster, true)*6
    set soundplay=CreateSound("Sound\\war3mapImported\\IchigoTE1.mp3", false, false, true, 12700, 12700, "")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd011', caster_x, caster_y, 0)
    //call SetUnitScale(n, 1.5, 1.5, 1.5)
    call MyRemoveUnit(n, 1.5)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM30', caster_x, caster_y, 0)
    //call SetUnitScale(n, 1.5, 1.5, 1.5)
    call MyRemoveUnit(n, 1.5)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd043', GetUnitX(newTarget), GetUnitY(newTarget), 0)
    call SetUnitScale(n, 5.5, 5.5, 5.5)
    call SetUnitVertexColor(n, 255, 255, 255, 150)
    call SetUnitFlyHeight(n, 50, 0)
    call SaveUnitHandle(h, id, 9, n)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd043', GetUnitX(newTarget), GetUnitY(newTarget), 0)
    call SetUnitScale(n, 5.5, 5.5, 5.5)
    call SetUnitFlyHeight(n, 50, 0)
    call SaveUnitHandle(h, id, 10, n)
    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
    call ShowUnit(newCaster, false)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveUnitHandle(h, id, 1, newTarget)
    call SaveReal      (h, id, 2, damage)
    call SaveReal      (h, id, 3, 0.0)
    call SaveReal      (h, id, 7, GetUnitX(newTarget))
    call SaveReal      (h, id, 8, GetUnitY(newTarget))
    call TimerStart(newTimer, 0.02, true, function IchigoBankaiE_Periodic)
    set newTimer=null
endfunction

function IchigoBankaiR_Periodic2 takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local unit caster = LoadUnitHandle(h, id, 0) 
    local unit target = LoadUnitHandle(h, id, 1)
    local real caster_x= GetUnitX(caster)
    local real caster_y= GetUnitY(caster)
    local real target_x= GetUnitX(target)
    local real target_y= GetUnitY(target)
    local real angle= LoadReal(h, id, 4)
    local real time= LoadReal(h, id, 3)
    local integer eff_period= LoadInteger(h, id, 5)
    local integer eff_period2= LoadInteger(h, id, 6)
    local real bonus_damage = LoadReal(h, id, 2)*(1-GetWidgetLife(target)/GetWidgetMaxLife(target))
    if time < 2.75 and IsUnitAlive(caster)==true and IsUnitAlive(target)==true  then
        call SaveReal(h, id, 3, time + 0.02)
        call PauseUnit(caster, true)
        call PauseUnit(target,true)
        call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
        call SetUnitInvulnerable(caster, true)
        call SetUnitInvulnerable(target, true)
        call SetUnitX(LoadUnitHandle(h, id, 5), caster_x)
        call SetUnitY(LoadUnitHandle(h, id, 5), caster_y)
                        
        if time == 0.1 then
                        // set n=CreateUnit(GetOwningPlayer(caster), 'd014', target_x, target_y, angle*bj_DEGTORAD)
                        // call SetUnitScale(n, 1.5, 1.5, 1.5)
                        // call SetUnitFlyHeight(n, 10, 0)
                        // call MyRemoveUnit(n, 1.5)
        endif
        if time == 0.8 then
            call ShakeCamera(0.3 , 10)
            call RengokuE_Shifting(caster , target , angle , 300 , CreateTimer())
            // call SetUnitX(caster, target_x - 100 * Cos(angle))
            // call SetUnitY(caster, target_y - 100 * Sin(angle))
            set caster_x=GetUnitX(caster)
            set caster_y=GetUnitY(caster)
        endif
        if time > 0.0 then
            set angle = LoadReal(h, id, 4)
            if LoadInteger(h, id, 34)==0 then
                    set angle = GetRandomInt(0, 360)*bj_DEGTORAD
                    call SaveReal(h, id, 4, angle)
                    call SaveInteger(h, id, 34, 30)
            else
                    call SaveInteger(h, id, 34, LoadInteger(h, id, 34)-1)
            endif
                        //call RengokuE_Shifting(caster , target , angle , 100 , CreateTimer())
            call SetUnitX(target, target_x + 25 * Cos(angle))
            call SetUnitY(target, target_y + 25 * Sin(angle))
            call SetUnitX(caster, target_x - 100 * Cos(angle))
            call SetUnitY(caster, target_y - 100 * Sin(angle))
            call SetUnitFacing(caster, AU(caster, target)*bj_RADTODEG)
            
            if eff_period2 == 0 then
                set n=CreateUnit(GetOwningPlayer(caster), 'd036', target_x, target_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call SetUnitFlyHeight(n, 200, 0)
                call MyRemoveUnit(n, 1.5)
                                set n=CreateUnit(GetOwningPlayer(caster), 'dM20', target_x, target_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call SetUnitFlyHeight(n, 5, 0)
                call MyRemoveUnit(n, 1.5)
                                
                call SaveInteger(h, id, 6, 3)
            else
                call SaveInteger(h, id, 6, eff_period2 - 1)
            endif
                        
            if eff_period == 0 then
                set n=CreateUnit(GetOwningPlayer(caster), 'd035', target_x, target_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 0.55, 0.55, 0.55)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'd010', target_x, target_y, angle*bj_DEGTORAD)
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call SetUnitFlyHeight(n, 20, 0)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'd018', target_x, target_y, angle*bj_DEGTORAD)
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call SetUnitFlyHeight(n, 75, 0)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'd048', target_x, target_y, angle*bj_DEGTORAD)
                call SetUnitScale(n, 1.0, 1.0, 1.0)
                call SetUnitTimeScale(n, 1.25)
                call SetUnitFlyHeight(n, 25, 0)
                call UnitApplyTimedLife(n, 1, 1.0)
                call MyRemoveUnit(n, 1.5)
                                
                call SaveInteger(h, id, 5, 7)
                if GetRandomInt(0, 3) == 0 then
                    call SetUnitAnimation(caster, "attack")
                endif
            else
                call SaveInteger(h, id, 5, eff_period - 1)
            endif
        endif
    else
        call ShowUnit(caster, true)
        if GetLocalPlayer()==GetOwningPlayer(caster) then
            call ClearSelection()
            call SelectUnit(caster, true)
        endif
        call ShakeCamera(0.3 , 15)
        call RengokuE_Shifting(caster , target , angle , 300 , CreateTimer())
        set n=CreateUnit(GetOwningPlayer(caster), 'd037', target_x, target_y, GetRandomInt(0, 360))
        //call SetUnitScale(n, 2.5, 2.5, 2.5)
        call SetUnitFlyHeight(n, 50, 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'd037', target_x, target_y, GetRandomInt(0, 360))
        //call SetUnitScale(n, 2.5, 2.5, 2.5)
        call SetUnitFlyHeight(n, 50, 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'd037', target_x, target_y, GetRandomInt(0, 360))
        //call SetUnitScale(n, 2.5, 2.5, 2.5)
        call SetUnitFlyHeight(n, 50, 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'd032', target_x, target_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 2.5, 2.5, 2.5)
        call SetUnitFlyHeight(n, 150, 0)
        call MyRemoveUnit(n, 1.5)

        set n=CreateUnit(GetOwningPlayer(caster), 'd021', target_x, target_y, GetRandomInt(0, 360)) 
        call SetUnitScale(n, 1.8, 1.8, 1.8)
        call SetUnitFlyHeight(n, 10, 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'd009', target_x, target_y, GetRandomInt(0, 360)) 
        call SetUnitScale(n, 1.8, 1.8, 1.8)
        call SetUnitFlyHeight(n, 10, 0)
        call MyRemoveUnit(n, 1.5)

        set n=CreateUnit(GetOwningPlayer(caster), 'dM11', caster_x, caster_y,  AU(caster, target)*bj_RADTODEG)
        call SetUnitFlyHeight(n, 75, 0)
        call SetUnitScale(n, 1.0, 1.0, 1.0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'd020', caster_x, caster_y,  AU(caster, target)*bj_RADTODEG)
        call SetUnitFlyHeight(n, 75, 0)
        call SetUnitAnimationByIndex(n, 1)
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call MyRemoveUnit(n, 1.5)

        set n=CreateUnit(GetOwningPlayer(caster), 'd066', target_x, target_y,  AU(caster, target)*bj_RADTODEG)
        call SetUnitFlyHeight(n, 100, 0)
        call SetUnitTimeScale(n, 0.75)
        call SetUnitScale(n, 2, 2, 2)
        call MyRemoveUnit(n, 1.5)



        call RemoveUnit(LoadUnitHandle(h, id, 5))
        call PauseUnit(caster, false)
        call PauseUnit(target,false)
        call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
        call SetUnitInvulnerable(caster, false)
        call SetUnitInvulnerable(target, false)
        call myCustomDamage(caster, target, LoadReal(h, id, 2)+bonus_damage, false,false,null,null,null)
        call FlushChildHashtable(h, id)
        call PauseTimer(GetExpiredTimer())
        call DestroyTimer(GetExpiredTimer())
    endif
    set target=null
    set caster=null
endfunction

function IchigoBankaiR_Periodic1 takes nothing returns nothing
        local integer id = GetHandleId(GetExpiredTimer())
        local unit caster = LoadUnitHandle(h, id, 0)
        local real caster_x = GetUnitX(caster)
        local real caster_y = GetUnitY(caster)
        local real time = LoadReal(h, id, 3)+0.02
        local integer eff_period= LoadInteger(h, id, 5)
        local real angle   = AU(caster, LoadUnitHandle(h, id, 1))
        call SaveReal(h, id, 3, time)
        if time<2 and IsUnitAlive(caster)==true and IsUnitAlive(LoadUnitHandle(h, id, 1))==true then
            call PauseUnit(caster, true)
            call SetUnitInvulnerable(caster, true)
            if time<1.3 then
                call SetUnitFacing(caster, AU(caster, LoadUnitHandle(h, id, 1))*bj_RADTODEG)
                call SetUnitX(LoadUnitHandle(h, id, 5), caster_x)
                call SetUnitY(LoadUnitHandle(h, id, 5), caster_y)
        
                if eff_period == 0 then
                    set n=CreateUnit(GetOwningPlayer(caster), 'dM42', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360)) 
                    call SetUnitScale(n, 1+time*0.8, 1+time*0.8, 1+time*0.8)
                    call SetUnitVertexColor(n, 255, 150, 150, 75)
                    call SetUnitFlyHeight(n, 10, 0)
                    call MyRemoveUnit(n, 1.5)
                    set n=CreateUnit(GetOwningPlayer(caster), 'd009', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360)) 
                    call SetUnitScale(n, 1+time*0.8, 1+time*0.8, 1+time*0.8)
                    call SetUnitFlyHeight(n, 10, 0)
                    call MyRemoveUnit(n, 1.5)
                    set n=CreateUnit(GetOwningPlayer(caster), 'd020', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360)) 
                    //call SetUnitScale(n, 1.5, 1.5, 1.5)
                    call SetUnitFlyHeight(n, 10, 0)
                    call MyRemoveUnit(n, 1.5)
                            
                    call SaveInteger(h, id, 5, 7)
                else
                    call SaveInteger(h, id, 5, eff_period - 1)
                endif
            endif
                
            if time==1.5 then
                if LoadBoolean(HH,GetHandleId(LoadUnitHandle(h, id, 1)),ANTITARGET_ABILITY)==false then
                    call ShowUnit(caster, false)
                    set n=CreateUnit(GetOwningPlayer(caster), 'd020', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360)) 
                    call SetUnitScale(n, 1.5, 1.5, 1.5)
                    call SetUnitFlyHeight(n, 10, 0)
                    call MyRemoveUnit(n, 1.5)
                    set n=CreateUnit(GetOwningPlayer(caster), 'd021', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360)) 
                    call SetUnitScale(n, 1.8, 1.8, 1.8)
                    call SetUnitFlyHeight(n, 10, 0)
                    call MyRemoveUnit(n, 1.5)
                    set n=CreateUnit(GetOwningPlayer(caster), 'd009', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360)) 
                    call SetUnitScale(n, 1.8, 1.8, 1.8)
                    call SetUnitFlyHeight(n, 10, 0)
                    call MyRemoveUnit(n, 1.5)
                            
                    set n=CreateUnit(GetOwningPlayer(caster), 'dM30', GetUnitX(caster), GetUnitY(caster),  AU(caster, LoadUnitHandle(h, id, 1))*bj_RADTODEG)
                    call SetUnitFlyHeight(n, 30, 0)
                    call SetUnitScale(n, 1.5, 1.5, 1.5)
                    call MyRemoveUnit(n, 1.5)
                    set n=CreateUnit(GetOwningPlayer(caster), 'dM30', GetUnitX(caster), GetUnitY(caster),  AU(caster, LoadUnitHandle(h, id, 1))*bj_RADTODEG)
                    call SetUnitFlyHeight(n, 30, 0)
                    call SetUnitScale(n, 1.5, 1.5, 1.5)
                    call MyRemoveUnit(n, 1.5)
                    set n=CreateUnit(GetOwningPlayer(caster), 'dM38', GetUnitX(caster), GetUnitY(caster),  AU(caster, LoadUnitHandle(h, id, 1))*bj_RADTODEG)
                    call SetUnitFlyHeight(n, 30, 0)
                    call SetUnitScale(n, 1.5, 1.5, 1.5)
                    call MyRemoveUnit(n, 1.5)
                    
                    set n=CreateUnit(GetOwningPlayer(caster), 'd011', GetUnitX(caster), GetUnitY(caster),  AU(caster, LoadUnitHandle(h, id, 1))*bj_RADTODEG)
                    call SetUnitFlyHeight(n, 20, 0)
                    call SetUnitScale(n, 1.5, 1.5, 1.5)
                    call MyRemoveUnit(n, 1.5)
                else
                    call StopSound(LoadSoundHandle(h, id, 102), true, true)
                    set angle = AU(caster, LoadUnitHandle(h, id, 1))
                    call SetUnitX(caster, GetUnitX(LoadUnitHandle(h, id, 1))-150*Cos(angle))
                    call SetUnitY(caster, GetUnitY(LoadUnitHandle(h, id, 1))-150*Sin(angle))
                    call RemoveUnit(LoadUnitHandle(h, id, 5))
                    call PauseUnit(caster, false)
                    call PauseUnit(LoadUnitHandle(h, id, 1),false)
                    call SaveUnitHandle(HH,GetHandleId(LoadUnitHandle(h, id, 1)),REVERSE_TARGET,caster)
                    call SaveBoolean(HH,GetHandleId(LoadUnitHandle(h, id, 1)),TARGET_ABILITY,false)
                    call SetUnitInvulnerable(caster, false)
                    call SetUnitInvulnerable(LoadUnitHandle(h, id, 1), false)
                    call FlushChildHashtable(h, id)
                    call PauseTimer(GetExpiredTimer())
                    call DestroyTimer(GetExpiredTimer())
                endif
            endif
                
        elseif IsUnitAlive(caster)==true and IsUnitAlive(LoadUnitHandle(h, id, 1))==true then
            call ShakeCamera(0.3 , 15)
            set n=CreateUnit(GetOwningPlayer(caster), 'd036', GetUnitX(LoadUnitHandle(h, id, 1)), GetUnitY(LoadUnitHandle(h, id, 1)),  GetRandomInt(0, 360))
            call SetUnitScale(n, 2.5, 2.5, 2.5)
            call SetUnitFlyHeight(n, 200, 0)
            call MyRemoveUnit(n, 2.5)
            set n=CreateUnit(GetOwningPlayer(caster), 'd037', GetUnitX(LoadUnitHandle(h, id, 1)), GetUnitY(LoadUnitHandle(h, id, 1)),  GetRandomInt(0, 360))
            call SetUnitScale(n, 1.5, 1.5, 1.5)
            call SetUnitFlyHeight(n, 5, 0)
            call MyRemoveUnit(n, 2.5)
            set n=CreateUnit(GetOwningPlayer(caster), 'd037', GetUnitX(LoadUnitHandle(h, id, 1)), GetUnitY(LoadUnitHandle(h, id, 1)),   GetRandomInt(0, 360))
            call SetUnitScale(n, 1.5, 1.5, 1.5)
            call SetUnitFlyHeight(n, 5, 0)
            call MyRemoveUnit(n, 2.5)
            set n=CreateUnit(GetOwningPlayer(caster), 'd037', GetUnitX(LoadUnitHandle(h, id, 1)), GetUnitY(LoadUnitHandle(h, id, 1)),  GetRandomInt(0, 360))
            call SetUnitScale(n, 1.5, 1.5, 1.5)
            call SetUnitFlyHeight(n, 5, 0)
            call MyRemoveUnit(n, 2.5)
                    
            set n=CreateUnit(GetOwningPlayer(caster), 'd032', GetUnitX(LoadUnitHandle(h, id, 1)), GetUnitY(LoadUnitHandle(h, id, 1)),  GetRandomInt(0, 360))
            call SetUnitScale(n, 2.5, 2.5, 2.5)
            call SetUnitFlyHeight(n, 150, 0)
            call MyRemoveUnit(n, 2.5)
                    
            set n=CreateUnit(GetOwningPlayer(caster), 'd010', GetUnitX(caster), GetUnitY(caster),  AU(caster, LoadUnitHandle(h, id, 1))*bj_RADTODEG)
            call SetUnitFlyHeight(n, 20, 0)
            call SetUnitScale(n, 1.8, 1.8, 1.8)
            call MyRemoveUnit(n, 2.5)
                    
            set n=CreateUnit(GetOwningPlayer(caster), 'd014', GetUnitX(caster), GetUnitY(caster),  AU(caster, LoadUnitHandle(h, id, 1))*bj_RADTODEG)
            call SetUnitFlyHeight(n, 50, 0)
            call MyRemoveUnit(n, 2.5)
                    
                    
            set angle = AU(caster, LoadUnitHandle(h, id, 1))
            call SetUnitX(caster, GetUnitX(LoadUnitHandle(h, id, 1))-150*Cos(angle))
            call SetUnitY(caster, GetUnitY(LoadUnitHandle(h, id, 1))-150*Sin(angle))
            call PauseUnit(LoadUnitHandle(h, id, 1), true)
            call SaveBoolean(HH,GetHandleId(LoadUnitHandle(h, id, 1)),TARGET_ABILITY,true)
            call SetUnitInvulnerable(LoadUnitHandle(h, id, 1), true)
            call SaveReal(h, id, 3, 0.0)
            call SaveReal(h, id, 4, angle)
            call SaveInteger(h, id, 34, 30)
            call PauseTimer(GetExpiredTimer())
            call TimerStart(GetExpiredTimer(), 0.02, true, function IchigoBankaiR_Periodic2)
        else
            call StopSound(LoadSoundHandle(h, id, 102), true, true)
            call RemoveUnit(LoadUnitHandle(h, id, 5))
            call ShowUnit(caster, true)
            if GetLocalPlayer()==GetOwningPlayer(caster) then
                call ClearSelection()
                call SelectUnit(caster, true)
            endif
            call PauseUnit(caster, false)
            call PauseUnit(LoadUnitHandle(h, id, 1),false)
            call SaveBoolean(HH,GetHandleId(LoadUnitHandle(h, id, 1)),TARGET_ABILITY,false)
            call SetUnitInvulnerable(caster, false)
            call SetUnitInvulnerable(LoadUnitHandle(h, id, 1), false)
            call FlushChildHashtable(h, id)
            call PauseTimer(GetExpiredTimer())
            call DestroyTimer(GetExpiredTimer())
        endif
        set caster=null
endfunction

function IchigoBankaiR_Cast takes unit newCaster, unit newTarget returns nothing
        local timer newTimer = CreateTimer()
        local integer id     = GetHandleId(newTimer)
        local real caster_x  = GetUnitX(newCaster)
        local real caster_y  = GetUnitY(newCaster)
        local real damage    = GetHeroStr(newCaster, true)*9
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dM32', caster_x, caster_y,  0)
        call SetUnitFlyHeight(n, 10, 0)
        call SetUnitVertexColor(n, 255, 255, 255, 100)
        call SetUnitScale(n, 2, 2, 2)
        call UnitApplyTimedLife(n, 1, 2)
        call MyRemoveUnit(n, 2.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd041', caster_x, caster_y,  0)
        call SetUnitFlyHeight(n, 10, 0)
        call SetUnitVertexColor(n, 255, 255, 255, 100)
        call SaveUnitHandle(h, id, 5, n)
                
        call PauseUnit(newCaster, true)
        call SetUnitInvulnerable(newCaster, true)
        call DestroyEffect(AddSpecialEffectTarget("supershinythingyhg2.mdl", newCaster, "chest"))
        call DestroyEffect(AddSpecialEffectTarget("AZ_Alleria_R3.mdl", newCaster, "hand"))
        call SaveUnitHandle(h, id, 0, newCaster)
        call SaveUnitHandle(h, id, 1, newTarget)
        call SaveReal      (h, id, 2, damage)
        call SaveReal      (h, id, 3, 0.0)
        if GetUnitTypeId(newCaster)=='HIc3' then
            call SaveReal  (h, id, 3, 1.1)
            call RemoveEffect(AddSpecialEffectTarget("BDEF (152).mdl", newCaster, "origin"), 4, true, CreateTimer())
            set soundplay=CreateSound("Sound\\war3mapImported\\VastoT.mp3", false, false, true, 12700, 12700, "")
            call StartSound(soundplay)
            call KillSoundWhenDone(soundplay)
        else
            if GetRandomInt(0, 1)==0 then
                set soundplay=CreateSound("Sound\\war3mapImported\\IchigoTR.mp3", false, false, true, 12700, 12700, "")
            else
                set soundplay=CreateSound("Sound\\war3mapImported\\IchigoTR2.mp3", false, false, true, 12700, 12700, "")
            endif
            call StartSound(soundplay)
            call KillSoundWhenDone(soundplay)
        endif
        call SaveSoundHandle(h, id, 102, soundplay)
        call TimerStart(newTimer, 0.02, true, function IchigoBankaiR_Periodic1)
        set newTimer=null
endfunction


function IchigoBankaiD_Indicator takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local unit newCaster=LoadUnitHandle(h, id, 0)
    local real waste=LoadReal(h, id, 1)
    call TextTagFull3("-" + I2S(R2I(waste)) , newCaster , 0 , 170 , 255 , 255 , GetOwningPlayer(newCaster) , 0.03)
    call FlushChildHashtable(h, id)
    call DestroyTimer(GetExpiredTimer())
    set newCaster=null
endfunction

function IchigoBankaiD_CalculateMana takes unit newCaster returns nothing
    local integer stack = LoadInteger(HH, GetHandleId(newCaster), 1123)
    local real manacost = 100
    local real waste = 100
    local integer i=0
    loop
    exitwhen i>=stack
        set waste = waste + 0.10*waste
        set i=i+1
    endloop
    call SetWidgetMana(newCaster, GetWidgetMana(newCaster)-(waste-100))
    call SaveInteger(HH, GetHandleId(newCaster), 1123, stack+1)
    set bjLCT=CreateTimer()
    call SaveUnitHandle(h, GetHandleId(bjLCT), 0, newCaster)
    call SaveReal(h, GetHandleId(bjLCT), 1, waste)
    call TimerStart(bjLCT, 0.02, false, function IchigoBankaiD_Indicator)
endfunction

function IchigoVasterW_Cast takes unit newCaster, unit newTarget returns nothing
    local real caster_x = GetUnitX(newCaster)
    local real caster_y = GetUnitY(newCaster)
    local real target_x = GetUnitX(newTarget)
    local real target_y = GetUnitY(newTarget)
    local real angle    = AU(newCaster, newTarget)
    local real damage   = GetHeroStr(newCaster, true)*2 + GetUnitTotalDamage(newCaster)*3
    set soundplay=CreateSound("Sound\\war3mapImported\\Sonido.mp3", false, false, true, 12700, 12700, "")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    set soundplay=CreateSound("Sound\\war3mapImported\\VastoW.mp3",false,false,true,12700,12700,"")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    call SetUnitXY(newCaster, target_x-150*Cos(angle), target_y-150*Sin(angle))
    
    if LoadBoolean(HH,GetHandleId(newTarget),ANTITARGET_ABILITY)==false then
        call myCustomDamage(newCaster, newTarget, damage, false,false,null,null,null)
        call SetControlToUnit(newTarget, newTarget, 2.0, "silenceTE")
        call SlowUnit(newCaster,newTarget,0.9,0,2,2,false)
        call UnitAddAbility(newTarget,'Ao53')
        call UnitRemoveAbilityTimedPause(newTarget,'Ao53',2)
        call UnitAddAbility(newTarget,'Ao3Z')
        call UnitRemoveAbilityTimedPause(newTarget,'Ao3Z',2)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd042', caster_x, caster_y, 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd042', GetUnitX(newCaster), GetUnitY(newCaster), 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd068', target_x, target_y, 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd070', target_x, target_y, 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd021', target_x, target_y, 0)
        call SetUnitScale(n, 2, 2, 2)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd010', target_x, target_y, 0)
        call SetUnitScale(n, 2, 2, 2)
        call MyRemoveUnit(n, 1.5)
        
        call RemoveEffect(AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl", newCaster, "rallypoint"), 2, true, CreateTimer())
        call RemoveEffect(AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl", newCaster, "first sprite"), 2, true, CreateTimer())
        call RemoveEffect(AddSpecialEffectTarget("BDEF_102_Attach.mdl", newCaster, "hand right"), 2, true, CreateTimer())
    else
        call SaveUnitHandle(HH,GetHandleId(newTarget),REVERSE_TARGET,newCaster)
    endif
endfunction

function IchigoVasterE_Periodic takes nothing returns nothing
	local timer t=GetExpiredTimer()
	local integer id=GetHandleId(t)
	local unit u=LoadUnitHandle(h,id,0)
	local real x=GetUnitX(u)
	local real y=GetUnitY(u)
	local player p=GetOwningPlayer(u)
	local real dmg=(1.3+.2*5)*(GetHeroStr(u,true))*0.2
	if GetUnitCurrentOrder(u)==OrderId("curse")then
		call GroupEnumUnitsInRange(G,x,y,800,Base)
		call SetUnitInvulnerable(u,true)
		call SetUnitAnimation(u,"stand")
		call UnitApplyTimedLife(CreateUnit(p,0x65304A39,x,y,GetRandomReal(0,359)),1,1)
		call UnitApplyTimedLife(CreateUnit(p,0x65304A44,x,y,GetRandomReal(0,359)),1,1)
		call UnitApplyTimedLife(CreateUnit(p,0x65304A42,x,y,GetRandomReal(0,359)),1,1)
		loop
		set E=FirstOfGroup(G)
		exitwhen E==null
		if Condition_Base(p,E)then
			call myCustomDamage(u,E,dmg,false,false,null,null,null)
            call SlowUnit(u,E,0.5,0,5,0,false)
		endif
		call GroupRemoveUnit(G,E)
		endloop
		
		call SetUnitInvulnerable(u,true)
		if LoadInteger(h, id, 1)>=3 then
            call HealTextTag(u,u,GetWidgetMaxLife(u)*0.01*0.68*myCustomHeal2(u,1),"HealthRes")
			call SetWidgetLife(u, GetWidgetLife(u)+GetWidgetMaxLife(u)*0.01*0.68)
			call SaveInteger(h, id, 1, 0)
		else
			call SaveInteger(h, id, 1, LoadInteger(h, id, 1)+1)
		endif
	else
		call DestroyEffect(LoadEffectHandle(h, id, 2))
		call SetUnitInvulnerable(u,false)
		call PauseTimer(t)
		call DestroyTimer(t)
		call FlushChildHashtable(h,id)
	endif
	set p=null
	set u=null
	set t=null
endfunction
function IchigoVasterE_Cast takes unit u returns nothing
        local timer t=CreateTimer()
        local integer id=GetHandleId(t)
        call SaveUnitHandle(h,id,0,u)
        call SaveInteger(h, id, 1, 0) 
        call SaveEffectHandle(h, id, 2, AddSpecialEffectTarget("chushou_by_wood_effect_huozhu_black.mdl", u, "origin"))
        call ShakeCamera(0.2, 10)
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\HollowRoar.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        set n=CreateUnit(GetOwningPlayer(u), 'd061', GetUnitX(u), GetUnitY(u), GetRandomInt(0, 360))
        call UnitScale(n, 0.5, 2, 0.5)
        call UnitApplyTimedLife(n, 1, 1.7)
        call MyRemoveUnit(n, 2.5)
        call SetUnitInvulnerable(u,true)
        call TimerStart(t,0.17,true,function IchigoVasterE_Periodic)
        set u=null
        set t=null
endfunction

function IchigoVasterR_Periodic takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(h,id,0)
        local unit l__d=LoadUnitHandle(h,id,1)
        local real a=LoadReal(h,id,4)
        local real dist=LoadReal(h,id,10)
        local real x=GetUnitX(l__d)+65*Cos(a)
        local real y=GetUnitY(l__d)+65*Sin(a)
        local real dmg=10*GetHeroStr(u,true)
        local player p=GetOwningPlayer(u)
        local group g=LoadGroupHandle(h,id,3)
        local integer eff_period = LoadInteger(h, id, 12)
        if dist>0 and IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
                call SetUnitXY_1(l__d,x,y, false)
                //call UnitApplyTimedLife(CreateUnit(p,0x65304A32,x,y,GetRandomReal(0,359)),1,3)
                //call UnitApplyTimedLife(CreateUnit(p,0x65304A35,x,y,GetRandomReal(0,359)),1,4)

		set soundplay=CreateSound("Sound\\Music\\mp3Music\\Hit.wav",false,false,true,12700,12700,"")
		call StartSound(soundplay)
		call KillSoundWhenDone(soundplay)
		//call UnitApplyTimedLife(CreateUnit(p,0x65304A34,x,y,GetRandomReal(0,359)),1,4)
		//call UnitApplyTimedLife(CreateUnit(p,0x65304A33,x,y,GetRandomReal(0,359)),1,4)
		if dist<2700 then
			set n=CreateUnit(p, 'd062', x, y, 0)
			call SetUnitScale(n, 2, 2, 2)
			call SetUnitFlyHeight(n, 50, 0)
			call UnitApplyTimedLife(n, 1, 1.3)
			call MyRemoveUnit(n, 1.7)
		endif
		
		if eff_period == 0 then
			set n=CreateUnit(GetOwningPlayer(u), 'dR99', x+50*Cos(a+45*bj_DEGTORAD), y+50*Sin(a+45*bj_DEGTORAD), a*bj_RADTODEG-120)
			call SetUnitScale(n, 2, 2, 2)
			call UnitApplyTimedLife(n, 1, 1.5)
			set n=CreateUnit(GetOwningPlayer(u), 'dR99', x+50*Cos(a-45*bj_DEGTORAD), y+50*Sin(a-45*bj_DEGTORAD), a*bj_RADTODEG+120)
			call SetUnitScale(n, 2, 2, 2)
			call UnitApplyTimedLife(n, 1, 1.5)
			call SaveInteger(h, id, 12, 2)
		else
			call SaveInteger(h, id, 12, eff_period-1)
		endif
		
		call GroupEnumUnitsInRange(g,x,y,350,Base)
		set idg=GetHandleId(g)
		call SaveReal(h,id,10,dist-65)
		loop
			set E=FirstOfGroup(g)
			set ide=GetHandleId(E)
			if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
				call myCustomDamage(u,E,dmg,false,false,null,null,null)
				call SaveUnitHandle(h,idg,ide,E)
				call SetControlToUnit(E,E, 3, "stun")
			endif
			call GroupRemoveUnit(g,E)
		exitwhen E==null
		endloop
	else
		call SetTerrainFogExBJ(0,6000.00,10000,0,1,1,1)
		call SetUnitInvulnerable(u,false)
		call RemoveUnit(l__d)
		call FlushChildHashtable(h,GetHandleId(g))
		call DestroyGroup(g)
		call PauseTimer(t)
		call DestroyTimer(t)
		call FlushChildHashtable(h,id)
	endif
	set g=null
	set u=null
	set t=null
	set l__d=null
	set p=null
endfunction

function IchigoVasterR_WaitTime takes nothing returns nothing
    local integer id = GetHandleId(GetExpiredTimer())
    local unit caster   = LoadUnitHandle(h, id, 0)
    local unit dummy    = LoadUnitHandle(h, id, 12)
    local real caster_x = GetUnitX(caster)
    local real caster_y = GetUnitY(caster)
    local real angle = GetUnitFacing(caster)*bj_DEGTORAD
    local real time  = LoadReal(h, id, 11)+0.05
    local trigger tt = LoadTriggerHandle(h, id, 10)
    local integer eff_period = LoadInteger(h, id, 12)
    
    call SaveReal(h, id, 11, time)
    
    if time<1.25 then
        call SetControlToUnit(caster, caster, 0.25, "doom")
        call SetUnitX(dummy, caster_x+150*Cos(angle))
        call SetUnitY(dummy, caster_y+150*Sin(angle))
        if eff_period<=0 then
            call SetUnitAnimationByIndex(caster, 14)
            set n=CreateUnit(GetOwningPlayer(caster), 'd060', GetUnitX(dummy), GetUnitY(dummy), angle*bj_RADTODEG)
            call SetUnitScale(n, 4.5, 4.5, 4.5)
            call SetUnitTimeScale(n, 0.6)
            call SetUnitFlyHeight(n, 250, 0)
            call SetUnitAnimationByIndex(n, GetRandomInt(0, 16))
            call MyRemoveUnit(n, 2)
            call SaveInteger(h, id, 12, 1)
        else
            call SaveInteger(h, id, 12, eff_period-1)
        endif
    else
        set n=CreateUnit(GetOwningPlayer(caster), 'd059', GetUnitX(dummy), GetUnitY(dummy), angle*bj_RADTODEG)
        call SetUnitTimeScale(n, 0.6)
        call SetUnitScale(n, 1.6, 1.6, 1.6)
        call MyRemoveUnit(n, 2)
        set n=CreateUnit(GetOwningPlayer(caster), 'dR42', GetUnitX(dummy), GetUnitY(dummy), angle*bj_RADTODEG)
        call SetUnitTimeScale(n, 0.6)
        call SetUnitScale(n, 1.6, 1.6, 1.6)
        call MyRemoveUnit(n, 2)
        call KillUnit(dummy)
        call MyRemoveUnit(dummy, 1.2)
        
        call SetUnitTimeScale(caster,1) 
        call SaveReal(h,id,4,angle)
        call SetUnitAcquireRange(caster,600)
        call UnitRemoveAbility(caster,'A1FU')
        call UnitRemoveAbility(caster,'Pet1')
        call UnitRemoveAbility(caster,'B00A')
        
        call ShakeCamera(0.5,20)
        call SaveUnitHandle(h,id,1,CreateUnit(GetOwningPlayer(caster),0x65304A36,caster_x,caster_y,angle*bj_RADTODEG))
        call TriggerClearActions(tt)
        call DestroyTrigger(tt)
        
        call PauseTimer(GetExpiredTimer())
        call TimerStart(GetExpiredTimer(), 0.01, true, function IchigoVasterR_Periodic)
    endif
    set caster=null
    set dummy=null
    set tt=null
endfunction

function IchigoVasterR_Cast takes unit u, real x1, real y1  returns nothing
        local timer t=CreateTimer()
        local integer id=GetHandleId(t)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        local real a=Atan2(y1-y,x1-x)
        local player p=GetOwningPlayer(u)
        local trigger tt=CreateTrigger()
        call SaveUnitHandle(h,id,0,u)
        call SaveGroupHandle(h,id,3,CreateGroup())
        call SaveReal(h,id,10,3000)
        call SetUnitInvulnerable(u,true)
        
        set n=CreateUnit(p,'dM32',x,y,GetRandomReal(0,359))
        call SetUnitVertexColor(n, 255, 255, 255, 210)
        call SetUnitScale(n, 3, 3, 3)
        call UnitApplyTimedLife(n, 1, 1.8)
        call MyRemoveUnit(n, 3)
        set n=CreateUnit(p,'d058',x+150*Cos(a),y+150*Sin(a),GetRandomReal(0,359))
        call UnitScale(n, 0.1, 1.3, 1.1)
        call SetUnitFlyHeight(n, 60, 2000)
        call SaveUnitHandle(h, id, 12, n)
        
        //call PauseUnit(u,true)
        call SetUnitAnimationByIndex(u, 14)
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\IchigoR.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)

        call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_TARGET_ORDER)
        call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_POINT_ORDER)
        call TriggerAddAction(tt,function HichigoRStopOrders)
        call SaveTriggerHandle(h, id, 10, tt)
        
        call SetUnitAcquireRange(u,51)
        call UnitAddAbility(u,'A1FU') //Slow
        call UnitAddAbility(u,'Pet1')
        call SetUnitTimeScale(u,3)

        call RemoveEffect(AddSpecialEffectTarget("buff-txblack.mdl", u, "origin"), 1.5, true, CreateTimer())
        call TimerStart(t, 0.05, true, function IchigoVasterR_WaitTime)
        
        set u=null
        set p=null
        set t=null
        set tt=null
endfunction

function Trig_IchigoInt_Actions takes nothing returns nothing
    if GetSpellAbilityId()=='IcF1' then
        call IchigoShikaiF_Cast(GetSpellAbilityUnit())
    endif
    if GetSpellAbilityId()=='IcD2' then
        call IchigoBankaiD1_Cast(GetSpellAbilityUnit())
    endif
    if GetSpellAbilityId()=='IcQ1' then
        call IchigoShikaiQ_Cast(GetSpellAbilityUnit())
    endif
    if GetSpellAbilityId()=='IcQ2' then
        call IchigoShikaiQ1_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    endif
    if GetSpellAbilityId()=='IcW1' then
        call IchigoShikaiW_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    endif
    if GetSpellAbilityId()=='IcE1' then
        call IchigoShikaiE_Cast(GetSpellAbilityUnit(), GetSpellTargetUnit())
    endif
    if GetSpellAbilityId()=='IcR1' then
        call IchigoShikaiR_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    endif
    if GetSpellAbilityId()=='IcT2' then
        call SaveBoolean(HH, GetHandleId(GetSpellAbilityUnit()), 9595, true)
    endif
    
    if GetSpellAbilityId()=='IcD3' then
        call SaveReal(HH, GetHandleId(GetSpellAbilityUnit()), 1122, 15)
        call IchigoBankaiD_CalculateMana(GetSpellAbilityUnit())
    endif
    if GetSpellAbilityId()=='IcF2' then
        call IchigoBankaiF_Cast(GetSpellAbilityUnit())
    endif
    if GetSpellAbilityId()=='IcF6' then
        call UnitRemoveAbility(GetSpellAbilityUnit(), 'IcF4')
        call UnitAddAbility(GetSpellAbilityUnit(), 'IcF3')
        call UnitMakeAbilityPermanent(GetSpellAbilityUnit(), true, 'IcF3')
        call UnitRemoveAbilityTimed_ExD(GetSpellAbilityUnit(), 'IcF3', 10)
        call IssueImmediateOrder(GetSpellAbilityUnit(), "stop")
        call StartAbilityCooldown(GetUnitAbility(GetSpellAbilityUnit(), 'IcF6'), 30)
        call SetWidgetMana(GetSpellAbilityUnit(), GetWidgetMana(GetSpellAbilityUnit())-300)
    endif
    if GetSpellAbilityId()=='IcF7' then
        call UnitRemoveAbility(GetSpellAbilityUnit(), 'IcF3')
        call UnitAddAbility(GetSpellAbilityUnit(), 'IcF4')
        call UnitMakeAbilityPermanent(GetSpellAbilityUnit(), true, 'IcF4')
        call UnitRemoveAbilityTimed_ExD(GetSpellAbilityUnit(), 'IcF4', 10)
        call IssueImmediateOrder(GetSpellAbilityUnit(), "stop")
        call StartAbilityCooldown(GetUnitAbility(GetSpellAbilityUnit(), 'IcF7'), 30)
        call SetWidgetMana(GetSpellAbilityUnit(), GetWidgetMana(GetSpellAbilityUnit())-300)
    endif
    if GetSpellAbilityId()=='IcQ3' then
        call IchigoBankaiQ1_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    endif
    if GetSpellAbilityId()=='IcQ4' then
        call IchigoBankaiQ2_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    endif
    if GetSpellAbilityId()=='IcQ5' then
        call IchigoBankaiQ3_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    endif
    if GetSpellAbilityId()=='IcW2' and GetSpellAbilityUnit()!=GetSpellTargetUnit() then
        call IchigoBankaiW_Target(GetSpellAbilityUnit(), GetSpellTargetUnit())
    elseif GetSpellAbilityId()=='IcW2' then
        call IchigoBankaiW_Cast(GetSpellAbilityUnit())
    endif
    if GetSpellAbilityId()=='IcE2' then
        call IchigoBankaiE_Cast(GetSpellAbilityUnit(), GetSpellTargetUnit())
    endif
    if GetSpellAbilityId()=='IcR2' or GetSpellAbilityId()=='IcT5' then
        call IchigoBankaiR_Cast(GetSpellAbilityUnit(), GetSpellTargetUnit())
    endif
    if GetSpellAbilityId()=='IcT1' then
        call IchigoShikaiT_Cast(GetSpellAbilityUnit())
    endif
    if GetSpellAbilityId()=='IcW3' then
        call IchigoVasterW_Cast(GetSpellAbilityUnit(), GetSpellTargetUnit())
    endif
    if GetSpellAbilityId()=='IcE3' then
        call IchigoVasterE_Cast(GetSpellAbilityUnit())
    endif
    if GetSpellAbilityId()=='IcR3' then
        call IchigoVasterR_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    endif
        
    if GetSpellAbilityId()=='IcD4' then
        set soundplay=CreateSound("Sound\\war3mapImported\\Sonido.mp3", false, false, true, 12700, 12700, "")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
    endif
        
    if GetSpellAbilityId()=='IcD3'  or GetSpellAbilityId()=='IcD2' then
        set soundplay=CreateSound("Sound\\war3mapImported\\Shunpo.mp3", false, false, true, 12700, 12700, "")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
    endif
endfunction

//===========================================================================
function InitTrig_IchigoInt takes nothing returns nothing
    local trigger trig  = CreateTrigger(  )
    local integer index = 0
    loop
        call TriggerRegisterPlayerUnitEvent(trig, Player(index), EVENT_PLAYER_UNIT_SPELL_EFFECT, null)
        set index = index + 1
        exitwhen index == bj_MAX_PLAYER_SLOTS
    endloop
    call TriggerAddAction( trig, function Trig_IchigoInt_Actions )
    set trig=null
endfunction

//===========================================================================
//=========== Karna Int ЧАС ПРОЕБАЛИ НА ЭТУ ХУЕТУ БЛЯТЬ
//===========================================================================

function KarnaD_Periodic takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit caster    = LoadUnitHandle(h, id, 0)
    local integer c_id   = GetHandleId(caster)
    local real duration  = LoadReal(h, c_id, Shield_KarnaD)-0.1
    if duration>0 then
        if IsUnitPaused(caster)==false then
            call SaveReal(h, c_id, Shield_KarnaD, duration)
        endif
    else
        call DestroyEffect(LoadEffectHandle(h, id, 1))
        call UnitRemoveAbility(caster, 'ReFm')
        call UnitRemoveAbility(caster, 'KaA0')
        call SaveReal(h, c_id, Shield_KarnaD, 0.0)
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set caster = null
    set newTimer = null
endfunction

function KarnaD_Active takes unit newCaster returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id   = GetHandleId(newCaster)
    local real duration  = LoadReal(h, c_id, Shield_KarnaD)
    if LoadInteger(HH, c_id, Stack_KarnaD)==0 then
        call DestroyTimer(newTimer)
        call DisplayTimedTextToPlayer(GetOwningPlayer(newCaster), 0, 0, 3, "|c00FF80C0Нет вспышек праны!|r")
        call StartAbilityCooldown(GetUnitAbility(newCaster , 'KaA2' ), 0.5)
    else
        call SaveInteger(HH, c_id, Stack_KarnaD, LoadInteger(HH, c_id, Stack_KarnaD)-1)

        set soundplay=CreateSound("Sound\\Music\\mp3Music\\KarnaD"+I2S(GetRandomInt(1, 2))+".mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)

        if duration==0.0 then
            call UnitAddAbility(newCaster, 'ReFm')
            call UnitAddAbility(newCaster, 'KaA0')
            call SaveUnitHandle(h, id, 0, newCaster)
            call SaveEffectHandle(h, id, 1, AddSpecialEffectTarget("Soundwaveshield.mdl", newCaster, "origin"))
            call TimerStart(newTimer, 0.1, true, function KarnaD_Periodic)
        else
            call DestroyTimer(newTimer)
        endif
        set bjLCG = CreateGroup()
        call GroupEnumUnitsInRange(bjLCG, GetUnitX(newCaster), GetUnitY(newCaster), 350, Base)
        loop
        set E = FirstOfGroup(bjLCG)
        exitwhen E == null
            if Condition_Base(GetOwningPlayer(newCaster) , E) then
                call myCustomDamage(newCaster, E, GetHeroAgi(newCaster, true)*2 , false , false , null , null , null)
            endif
        call GroupRemoveUnit(bjLCG, E)
        endloop
        call DestroyGroup(bjLCG)
        call SaveReal(h, c_id, Shield_KarnaD, 1.0)

        if LoadBoolean(h, GetHandleId(newCaster), KarnaF_Reload) then
            call RemoveEffect(AddSpecialEffectTarget("AZ_LCguanyu_T1.mdl", newCaster, "chest"), 1, true, CreateTimer())
        endif
        set n = CreateUnit(GetOwningPlayer(newCaster), 'dR36', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
        call SetUnitScale(n, 2, 2, 2)
        call MyRemoveUnit(n, 3.5)
        set n = CreateUnit(GetOwningPlayer(newCaster), 'dR36', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
        call SetUnitScale(n, 4, 4, 4)
        call MyRemoveUnit(n, 3.5)
        set n = CreateUnit(GetOwningPlayer(newCaster), 'dR13', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
        call SetUnitScale(n, 1.7, 1.7, 1.7)
        call MyRemoveUnit(n, 3.5)
        set n = CreateUnit(GetOwningPlayer(newCaster), 'dRe9', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call UnitApplyTimedLife(n, 1, 1.0)
        call MyRemoveUnit(n, 3.5)
        set n = CreateUnit(GetOwningPlayer(newCaster), 'dRe9', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
        call UnitScale(n, 1, 4, 0.5)
        call UnitApplyTimedLife(n, 1, 1.0)
        call MyRemoveUnit(n, 3.5)
        set n = CreateUnit(GetOwningPlayer(newCaster), 'd102', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
        call SetUnitScale(n, 1.8, 1.8, 1.8)
        call UnitApplyTimedLife(n, 1, 0.5)
        call MyRemoveUnit(n, 1.0)
        set n = CreateUnit(GetOwningPlayer(newCaster), 'd103', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call SetUnitFlyHeight(n, 150, 0)
        call MyRemoveUnit(n, 3.5)
        set n = CreateUnit(GetOwningPlayer(newCaster), 'd104', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
        call SetUnitScale(n, 1.0, 1.0, 1.0)
        call SetUnitFlyHeight(n, 150, 0)
        call MyRemoveUnit(n, 3.5)
        set n = CreateUnit(GetOwningPlayer(newCaster), 'dH62', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
        call SetUnitScale(n, 1.0, 1.0, 1.0)
        call SetUnitFlyHeight(n, 0, 0)
        call MyRemoveUnit(n, 3.5)
        set n = CreateUnit(GetOwningPlayer(newCaster), 'dH62', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
        call SetUnitScale(n, 2.0, 2.0, 2.0)
        call SetUnitFlyHeight(n, 0, 0)
        call MyRemoveUnit(n, 3.5)
    endif
    set newTimer = null
endfunction


function KarnaDStack_Periodic takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    caster = LoadUnitHandle(HH, id, 0)
    local integer c_id   = GetHandleId(caster)
    local integer stack  = LoadInteger(HH, id, 1)
    local real    duration = LoadReal(HH, id, 2)+0.1
    if stack>0 then
        call SaveReal(HH, id, 2, duration)
        if stack!=LoadInteger(HH, c_id, Stack_KarnaD) then
            //call SaveReal(h, id, 2, 0)
            call SaveInteger(HH, id, 1, LoadInteger(HH, c_id, Stack_KarnaD))
            set duration = 0
        endif
        if duration>=5.0 then
            call SaveInteger(HH, c_id, Stack_KarnaD, stack-1)
            call SaveInteger(HH, id, 1, LoadInteger(HH, c_id, Stack_KarnaD))
            call SaveReal(HH, id, 2, 0)
        endif
    else
        call SaveInteger(HH, c_id, Stack_KarnaD, 0)
        call FlushChildHashtable(HH, id)
        call DestroyTimer(newTimer)
    endif
    set newTimer = null
    set caster   = null
endfunction


function KarnaD_AddStack takes unit newCaster returns nothing
    local timer newTimer = null
    local integer c_id   = GetHandleId(newCaster)
    local integer stack  = LoadInteger(HH, c_id, Stack_KarnaD)
    if GetHeroLevel(newCaster)>=12 then // Карна F пассивка на автухи
        if GetUnitAbilityLevel(newCaster, 'KaAC')==0 then
            call UnitAddAbility(newCaster, 'KaAC')
        endif
    endif
    // Добавить таймер сброса стаков
    if stack==0 then
        set newTimer = CreateTimer()
        call SaveUnitHandle(HH, GetHandleId(newTimer), 0, newCaster)
        call SaveInteger(HH, GetHandleId(newTimer), 1, 1)
        call TimerStart(newTimer, 0.1, true, function KarnaDStack_Periodic)
    endif
    call SaveInteger(HH, c_id, Stack_KarnaD, stack+1)
    set newTimer = null
endfunction


function Soul_Eater_Effect takes unit newCaster, unit newTarget returns nothing
    local real caster_x = GetUnitX(newCaster)
    local real caster_y = GetUnitY(newCaster)
    local real target_x = GetUnitX(newTarget)
    local real target_y = GetUnitY(newTarget)
    local real angle    = (GetUnitFacing(newCaster)+180)*bj_DEGTORAD
    set n=CreateUnit(Player(14), GetUnitTypeId(newTarget), caster_x, caster_y, GetUnitFacing(newTarget))
    call UnitAddAbility(n,'Aloc')
    call UnitApplyTimedLife(n,0,0.4)
    call SetUnitVertexColor(n,255,255,255,140)
    call IssueTargetOrder(n,"attack",newCaster)
    call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(newTarget), 'e085', caster_x, caster_y, 0), 1, 1)
    call SetUnitX(newTarget, caster_x+100*Cos(angle))
    call SetUnitY(newTarget, caster_y+100*Sin(angle))
    call SetUnitFacing(newTarget,Atan2(target_y-caster_y, target_x-caster_x)*bj_RADTODEG)
    call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(newTarget), 'e085', caster_x, caster_y, 0), 1, 1)
endfunction

function GenkshiPassiveX2 takes unit newCaster, unit newTarget returns nothing
    local real caster_x = GetUnitX(newCaster)
    local real caster_y = GetUnitY(newCaster)
    local real target_x = GetUnitX(newTarget)
    local real target_y = GetUnitY(newTarget)
    local real angle    = 0.0
    local integer caster_id = GetPlayerId(GetOwningPlayer(newCaster))
    local integer target_id = GetPlayerId(GetOwningPlayer(newTarget))
    set n=CreateUnit(GetOwningPlayer(newTarget),'h019',caster_x,caster_y,0)
    call UnitApplyTimedLife(n,0,1)
    call UnitAddAbility(n,'A0M0')
    call RemoveSavedReal(h,GetHandleId(Hero[target_id]),StringHash("FM1"))
    call RemoveSavedReal(h,GetHandleId(Hero[target_id]),StringHash("FM2"))
    call RemoveSavedHandle(h,GetHandleId(Hero[target_id]),StringHash("FMc"))
    call SaveReal(h,GetHandleId(Hero[target_id]),StringHash("FMx"),caster_x)
    call SaveReal(h,GetHandleId(Hero[target_id]),StringHash("FMy"),caster_y)
    call SaveUnitHandle(h,GetHandleId(Hero[target_id]),StringHash("FMc"),newCaster)
    call IssueTargetOrderById(n,852274,newTarget)
    call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(newTarget),'e085',caster_x,caster_y,0),1,1)
    call myCustomDamage(Hero[target_id],newCaster,GetHeroInt(Hero[target_id],true),false,false,null,null,null)
    set angle=(GetUnitFacing(Hero[caster_id])+180)*bj_DEGTORAD

    call SetUnitX(newTarget, caster_x+100*Cos(angle))
    call SetUnitY(newTarget, caster_y+100*Sin(angle))
    call SetUnitFacing(newTarget,Atan2(GetUnitY(Hero[caster_id])-caster_y,GetUnitX(Hero[caster_id])-caster_x)*bj_RADTODEG)
    call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(newTarget),'e085',caster_x,caster_y,0),1,1)
endfunction

function Karna_ModifAttack takes unit newCaster, unit newTarget, real attack_factor, real newDamage, real par_modif_factor, boolean canMiss returns boolean
	local real damage          = GetUnitTotalDamage(newCaster) * attack_factor
	local real bonus_damage    = 0.0
	local real currect_damage  = damage
	local real current_damage  = GetUnitTotalDamage(newCaster)
	local boolean fatal_damage = false
	local boolean miss         = false
    local boolean first_crit   = false
    local boolean soul_eater_miss = false
    local boolean yamato       = false
	local real critchance_dmg  = 0.0
	local real crit_damage     = 0.0     // крит урон, база 0.0
    local real crit_factor     = 0.3     // модификаторы крита, процент
    local real heal_factor     = 0.6     // модификаторы хилла, процент
	local real heal            = 0.0
    local real modif_factor    = par_modif_factor
    local real max_crit_count  = 90
	local integer crit_count   = 0 
    local string text_damage   = ""

    if IsUnitInvulnerable(newTarget) then
        set damage=0
        set miss=true
    endif
    if attack_factor>1.0 then
        set damage = GetUnitTotalDamage(newCaster)
    endif
	if canMiss then	// Миссы в целом
	
        if GetUnitAbilityLevel(newCaster, 'A3IG')==0 then // Патриот анти-миссы 
            if (UnitHasItemOfTypeBJ(newTarget, 'I03E') or UnitHasItemOfTypeBJ(newTarget, 'I03F') or GetUnitAbilityLevel(newTarget, 'KIJ2')>0 or GetUnitAbilityLevel(newTarget, 'KIJ4')>0) and GetRandomInt(0, 99)<35 then	// Туфли или Комплект Анбу - уклонение
                set damage=0
                set miss=true
            endif
            
            if GetUnitAbilityLevel(newTarget, 'A14R')>0 or GetUnitAbilityLevel(newCaster, 'B037')>0 or GetUnitAbilityLevel(newCaster, 'cb10')>0 then	// Демон Глаз активка или слепота
                set damage=0
                set miss=true
            endif
            
            if GetUnitAbilityLevel(newCaster, 'cb12')>0 then 		// Промахи все
                call SaveReal(HH,GetHandleId(bufh),0,1)
                call HandleListEnumUnitBuffs(bufh,newCaster,Condition(function MissBool))
                call HandleListForEach(bufh,function MissBuff)
                if LoadReal(HH,GetHandleId(bufh),0)==0 then
                    set damage=0
                    set miss=true
                endif
                call FlushChildHashtable(HH,GetHandleId(bufh))
                call HandleListClear(bufh)	
            endif
        endif

        if GetUnitAbilityLevel(newCaster,'Bwul')==0 and GetUnitAbilityLevel(newCaster,'A1WT')==0 then

            if miss==false and(UnitHasItemOfTypeBJ(newTarget,'I02E')or GetUnitAbilityLevel(newTarget,'KID4')>0)and GetRandomIntMem(0,100)<10 then // Пожиратель Душ, D ранг
                set miss = true
                set soul_eater_miss = true
            endif
            if miss==false and(UnitHasItemOfTypeBJ(newTarget,'I02F')or GetUnitAbilityLevel(newTarget,'KID6')>0)and GetRandomIntMem(0,100)<15 then // Пожиратель Душ, C ранг
                set miss = true
                set soul_eater_miss = true
            endif
            if miss==false and(UnitHasItemOfTypeBJ(newTarget,'I02G')or GetUnitAbilityLevel(newTarget,'KID8')>0)and GetRandomIntMem(0,100)<20 then // Пожиратель Душ, B ранг
                set miss = true
                set soul_eater_miss = true
            endif
            if miss==false and(UnitHasItemOfTypeBJ(newTarget,'I02H')or GetUnitAbilityLevel(newTarget,'KIE0')>0)and GetRandomIntMem(0,100)<25 then // Пожиратель Душ, A ранг
                set miss = true
                set soul_eater_miss = true
            endif
            if miss==false and(UnitHasItemOfTypeBJ(newTarget,'I02I')or GetUnitAbilityLevel(newTarget,'KIE2')>0)and GetRandomIntMem(0,100)<25 then // Пожиратель Душ, Запечатанный
                set miss = true
                set soul_eater_miss = true
            endif
            if miss==false and(UnitHasItemOfTypeBJ(newTarget,'I02J')or GetUnitAbilityLevel(newTarget,'KIE4')>0)and GetRandomIntMem(0,100)<35 then // Пожиратель Душ, True
                set miss = true
                set soul_eater_miss = true
            endif
            if miss==false and(UnitHasItemOfTypeBJ(newTarget,'I02K')or GetUnitAbilityLevel(newTarget,'KIE4')>0)and GetRandomIntMem(0,100)<35 then // Пожиратель Душ, True Активный
                set miss = true
                set soul_eater_miss = true
            endif
            
            if soul_eater_miss then
                call Soul_Eater_Effect(newCaster, newTarget)
            endif
            
            // GenkshiPassive
            if miss==false and (GetUnitAbilityLevel(newTarget,'A0LZ')>0 and GetRandomIntMem(0,100)<10+R2I(GetHeroLevel(newTarget)*0.6)) then
                set miss = true
                call GenkshiPassiveX2(newCaster, newTarget)
            endif
        endif
	endif
    
	if IsUnitType(newCaster,UNIT_TYPE_HERO) and IsUnitIllusion(newCaster)==false and miss==false then
	
        if UnitHasItemOfTypeBJ(newCaster, 'I01J') and GetRandomIntMem(0,100)<15 then	// Меч C ранга
            set crit_damage=crit_damage+(0.5*crit_factor)
            set crit_count = crit_count + 1
        endif
        if UnitHasItemOfTypeBJ(newCaster, 'I01I') and GetRandomIntMem(0,100)<15 then	// Меч B ранга
            set crit_damage=crit_damage+(0.75*crit_factor)
            set crit_count = crit_count + 1
        endif
        if UnitHasItemOfTypeBJ(newCaster, 'I01K') and GetRandomIntMem(0,100)<15 then	// Меч A ранга
            set crit_damage=crit_damage+(1.0*crit_factor)
            set crit_count = crit_count + 1
        endif
        if UnitHasItemOfTypeBJ(newCaster, 'I01L') and GetRandomIntMem(0,100)<15 then	// Закаленный меч
            set crit_damage=crit_damage+(1.0*crit_factor)
            set crit_count = crit_count + 1
        endif
        if UnitHasItemOfTypeBJ(newCaster, 'I01O') and GetRandomIntMem(0,100)<20 then	// Сандай Китецу
            set crit_damage=crit_damage+(1.5*crit_factor)
            set crit_count = crit_count + 1
        endif
        if UnitHasItemOfTypeBJ(newCaster, 'I01Q') and GetRandomIntMem(0,100)<20 then	// Сюсуй
            set crit_damage=crit_damage+(1.5*crit_factor)
            set crit_count = crit_count + 1
        endif
        if UnitHasItemOfTypeBJ(newCaster, 'I01U') and GetRandomIntMem(0,100)<20 then	// Фэнг
            set crit_damage=crit_damage+(1.5*crit_factor)
            set crit_count = crit_count + 1
        endif
        if UnitHasItemOfTypeBJ(newCaster, 'I01S') and GetRandomIntMem(0,100)<30 then	// Темный Экскалибур
            set crit_damage=crit_damage+(1.5*crit_factor)
            set crit_count = crit_count + 1
        endif
    	if GetUnitAbilityLevel(newCaster,'WAE1')>0 and GetRandomIntMem(0,100)<30*(1+B2R_ExD(first_crit)) and max_crit_count>crit_count then	// Waver F
            set crit_damage=crit_damage+(0.5*crit_factor)
            set crit_count = crit_count + 1
        endif
        if UnitHasItemOfTypeBJ(newCaster, 'I02V') then	// Ямато
            call Essence(newCaster,newTarget,1)
            if (LoadReal(HH,GetHandleId(newCaster),StringHash("yamato"))==1 or GetRandomIntMem(0,100)<15) then
                set crit_damage=crit_damage+(2.0*crit_factor)
                call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",newTarget,"chest"))
                call SaveReal(HH,GetHandleId(newCaster),StringHash("yamato"),0)
                //call AllTextTag("|c000080FFYAMATO!|r" , newTarget)
                set yamato = true
            endif
        endif
    
        // критический урон
        if attack_factor<1.0 then
            set damage = damage*attack_factor
            set damage = damage + (damage * crit_damage)
        else
            set damage = damage + (current_damage * crit_damage)
        endif
        //
	
	if UnitHasItemOfTypeBJ(newCaster, 'I031') and IsUnitType(newTarget,UNIT_TYPE_HERO) and IsUnitIllusion(newTarget)==false then 	// Патриот
		set bjLCT=CreateTimer()
			call SetHeroAgi(newCaster,GetHeroAgi(newCaster,false)+3,true)
			call SetHeroStr(newCaster,GetHeroStr(newCaster,false)+3,true)
			call SetHeroInt(newCaster,GetHeroInt(newCaster,false)+3,true)
			call SetHeroAgi(newTarget,GetHeroAgi(newTarget,false)-3,true)
			call SetHeroStr(newTarget,GetHeroStr(newTarget,false)-3,true)
			call SetHeroInt(newTarget,GetHeroInt(newTarget,false)-3,true)
			call SaveUnitHandle(h,GetHandleId(bjLCT), 0, newTarget)
			call SaveUnitHandle(h,GetHandleId(bjLCT), 1, newCaster)
			call TimerStart(bjLCT, 5, false, function VergilPatriot_ModifEnd)
		set bjLCT=null
		//set damage=damage-damage*0.3
	endif
	
	if UnitHasItemOfTypeBJ(newCaster, 'I04F') then 				// Экскалибур
        call HealTextTag(newCaster,newCaster,damage*0.2*heal_factor*myCustomHeal2(newCaster,1),"HealthRes")
		call SetWidgetLife(newCaster, GetWidgetLife(newCaster)+myCustomDamage2(newTarget, damage*0.2))
		set bjLCT=CreateTimer()
			call SetUnitArmour(newTarget, GetUnitArmour(newTarget)-4)
			call SaveUnitHandle(h,GetHandleId(bjLCT), 0, newTarget)
			call SaveUnitHandle(h,GetHandleId(bjLCT), 1, newCaster)
			call TimerStart(bjLCT, 10, false, function VergilExcalibur_ModifEnd)
		set bjLCT=null
	endif
	
	if UnitHasItemOfTypeBJ(newCaster, 'I01S') and GetRandomInt(0, 9)<=3 then 				// Темный Экскалибур
		if LoadBoolean(h, GetHandleId(newCaster), StringHash("ItemDarkExc_CD"))==false then
			set bjLCT=CreateTimer()
			call SaveBoolean(h, GetHandleId(newCaster), StringHash("ItemDarkExc_CD"), true)
			call UnitRemoveAbility(newCaster, 'A26R')
			call UnitAddAbility(newCaster,'A26R')
			call SaveUnitHandle(h,GetHandleId(bjLCT),0,newCaster)
			call TimerStart(bjLCT,3,false,function VergilDarkExcalibur_ModifEnd)
			set bjLCT=null
		endif
	endif
	
	if GetUnitAbilityLevel(newCaster, 'A26R')>0 then										// Темный Экскалибур Хилл
        call HealTextTag(newCaster,newCaster,damage*0.5*heal_factor*myCustomHeal2(newCaster,1),"HealthRes")
		call SetWidgetLife(newCaster, GetWidgetLife(newCaster)+myCustomDamage2(newTarget, damage*0.5*heal_factor))
	endif
	
	if GetUnitAbilityLevel(newCaster, 'B06N')>0 then										// Жанна Альтер Хилл
        call HealTextTag(newCaster,newCaster,damage*0.3*heal_factor*myCustomHeal2(newCaster,1),"HealthRes")
		call SetWidgetLife(newCaster, GetWidgetLife(newCaster)+myCustomDamage2(newTarget, damage*0.3*heal_factor))
	endif
	
	if UnitHasItemOfTypeBJ(newCaster, 'I03O') then 				// Самехада: Чистый Урон
		set bonus_damage=(150+GetUnitTotalDamage(newCaster)*0.4)*modif_factor
		if GetWidgetLife(newTarget)>bonus_damage then
			//call SetWidgetLife(newTarget, GetWidgetLife(newTarget)-bonus_damage)
			call CustomTrueDamage(newCaster, newTarget, bonus_damage)
		else
			set fatal_damage=true
		endif
	endif
	
	if UnitHasItemOfTypeBJ(newCaster, 'I03B') then				// Меч Анбу
		set bonus_damage=55*modif_factor
		if GetWidgetLife(newTarget)>bonus_damage then
			//call SetWidgetLife(newTarget, GetWidgetLife(newTarget)-bonus_damage)
			call CustomTrueDamage(newCaster, newTarget, bonus_damage)
		else
			set fatal_damage=true
		endif
	endif
	
	if UnitHasItemOfTypeBJ(newCaster, 'I050') then				// Гегецебури
		set bonus_damage=100*modif_factor
		if GetWidgetLife(newTarget)>bonus_damage then
			//call SetWidgetLife(newTarget, GetWidgetLife(newTarget)-bonus_damage)
			call CustomTrueDamage(newCaster, newTarget, bonus_damage)
		else
			set fatal_damage=true
		endif
		call DestroyEffect(AddSpecialEffect("war3mapImported\\Cleave.mdx",GetUnitX(newTarget),GetUnitY(newTarget)))
		if GetRandomIntMem(0,100)<20 then
            call SetControlToUnit(newTarget, newTarget, 1.0, "stun")
            call SetControlToUnit(newTarget, newTarget, 0.2,"stunbkb")
        endif
	endif
	
	if GetUnitAbilityLevel(newCaster,'WAE4')==0 and GetUnitAbilityLevel(newCaster,'WAE1')>0 then
        call SetControlToUnit(newTarget,newTarget, 0.3, "stun")
        call UnitAddAbility(newCaster,'WAE4')
        call UnitRemoveAbilityTimed(newCaster,'WAE4',0.7)
        call myCustomDamage(newCaster,newTarget,GetHeroInt(newCaster,true)*modif_factor,false,false,null,null,null)
		set damage = damage * 1.5 * modif_factor
    endif
	
	if UnitHasItemOfTypeBJ(newCaster, 'I03N') then 				// Самехада: Манажор
		call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Feedback\\ArcaneTowerAttack.mdl", newTarget,"origin"))
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl", newTarget,"chest"))
		if GetWidgetMana(newTarget)>0 then
            call HealTextTag(newCaster,newCaster,GetWidgetMana(newTarget)*0.16*heal_factor*myCustomHeal2(newCaster,1),"HealthRes")
			call SetWidgetLife(newCaster, GetWidgetLife(newCaster)+GetWidgetMana(newTarget)*0.16*heal_factor)
        endif
		call SetWidgetMana(newTarget, GetWidgetMana(newTarget)-GetWidgetMana(newTarget)*0.08*modif_factor)
	endif
	
	if UnitHasItemOfTypeBJ(newCaster, 'I01U') and GetRandomInt(1, 100)<=45 then 		// Feng
		call PoisonDamage5(newCaster,newTarget, 2.5*GetHeroInt(newCaster,true)*modif_factor, 6, "Abilities\\Weapons\\PoisonSting\\PoisonStingTarget.mdl", "chest")
        set n=CreateUnit(GetOwningPlayer(newCaster),'h019',GetUnitX(newTarget),GetUnitY(newTarget),0)
        call UnitAddAbility(n,'A2CW')
        call SetUnitAbilityLevel(n,'A2CW',1)
        call UnitApplyTimedLife(n,'BHwe',1)
        call IssueTargetOrder(n,"cripple",newTarget)
    endif
	if UnitHasItemOfTypeBJ(newCaster, 'I01Q') and (GetRandomInt(1, 100)<=20 or GetUnitAbilityLevel(newCaster,'A06K')>0) then 		// Сюсуй
		call Shusui_Cast(newCaster, 1.0)
	endif
    if UnitHasItemOfTypeBJ(newTarget,'I05O')or UnitHasItemOfTypeBJ(newTarget,'I05P')or UnitHasItemOfTypeBJ(newTarget,'I05Q')or UnitHasItemOfTypeBJ(newTarget,'I05R')or UnitHasItemOfTypeBJ(newTarget,'I05S')or UnitHasItemOfTypeBJ(newTarget,'I05T') or GetUnitAbilityLevel(newTarget, 'KIT8')>0 or GetUnitAbilityLevel(newTarget, 'KIU0')>0 or GetUnitAbilityLevel(newTarget, 'KIU2')>0 or GetUnitAbilityLevel(newTarget, 'KIU4')>0 or GetUnitAbilityLevel(newTarget, 'KIU6')>0 or GetUnitAbilityLevel(newTarget, 'KIU8')>0 then
        call RainMare_Actions(newCaster,newTarget)
    endif
	if UnitHasItemOfTypeBJ(newTarget, 'I03C') and UnitHasItemOfTypeBJ(newTarget, 'I03F')==false then	// Жилет Анбу у таргета
		call HealTextTag(newTarget,newTarget,35*myCustomHeal2(newTarget,1),"HealthRes")
        call SetWidgetLife(newTarget, GetWidgetLife(newTarget)+35)
		call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Heal\\HealTarget.mdl", newTarget,"origin"))
	endif
	
	if UnitHasItemOfTypeBJ(newTarget, 'I03F') then														// Комплект Анбу у таргета
		call HealTextTag(newTarget,newTarget,50*myCustomHeal2(newTarget,1),"HealthRes")
        call SetWidgetLife(newTarget, GetWidgetLife(newTarget)+50)
		call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Heal\\HealTarget.mdl", newTarget,"origin"))
	endif
	
	if UnitHasItemOfTypeBJ(newTarget, 'I060') then														// Облако Маре D ранг
		set damage=damage-30
	endif
	
	if UnitHasItemOfTypeBJ(newTarget, 'I061') then														// Облако Маре C ранг
		set damage=damage-50
	endif
	
	if UnitHasItemOfTypeBJ(newTarget, 'I062') then														// Облако Маре B ранг
		set damage=damage-70
	endif
	
	if UnitHasItemOfTypeBJ(newTarget, 'I063') then														// Облако Маре A ранг
		set damage=damage-90
	endif
		
	if UnitHasItemOfTypeBJ(newTarget, 'I064') then														// Облако Маре Фальшивое
		set damage=damage-110
	endif
	
	if UnitHasItemOfTypeBJ(newTarget, 'I065') then														// Облако Маре Истинное
		set damage=damage-130
	endif
	
	endif
	
    if attack_factor<=1.0 then
        set damage = damage + newDamage
    else
        set damage = damage + newDamage + current_damage*(attack_factor-1)
    endif

	if miss then
		call AllTextTag("|c00C0C0C0Miss!|r" , newTarget)
        set damage = 0
    else
        // Текст над головой
        if crit_count>0 then
            if crit_count>1 then
                set text_damage = "|c00880a0aCRIT!x"+I2S(crit_count)+"|r"
            else
                set text_damage = "|c00880a0aCRIT!|r"
            endif
        endif
        if yamato and (crit_count>1) then
            set text_damage = text_damage + " + |c000080FFYAMATO!|r"
         elseif yamato then
            set text_damage = "|c000080FFYAMATO!|r"
        endif
        call AllTextTag(text_damage , newTarget)
	endif
	
	if fatal_damage==false then
		if damage>0 then
			call myCustomDamage(newCaster,newTarget,damage,false,false,null,null,null)
		endif
	else
		call UnitRemoveBuffs(newTarget,true,true)
		call UnitAddAbility(newTarget,'A0WR')
        call DamageIndicatorFunction(newCaster,newTarget,damage)
		call myCustomDamage(newCaster, newTarget, GetWidgetMaxLife(newTarget),false,false,null,null,null)
		call UnitRemoveAbility(newTarget,'A0WR')
		//call AllTextTag("|c000080FFSCUM!|r" , newTarget)
	endif	
	return miss
endfunction

function Sinon_ModifAttack takes unit newCaster, unit newTarget, real attack_factor, real newDamage, real modif_factor, boolean overcharge returns boolean
	local real damage          = GetUnitTotalDamage(newCaster) * attack_factor
	local real bonus_damage    = 0.0
	local real current_damage  = GetUnitTotalDamage(newCaster)
	local boolean fatal_damage = false
	local boolean miss         = false
    local boolean first_crit   = true
    local boolean backstab     = false
	local real heal            = 0.0
	local real critchance_dmg  = 0.0
    local real crit_damage     = 0.0     // крит урон, база 0.0
    local real crit_factor     = 1.0     // модификаторы крита, процент
    local real max_crit_count  = 2
    local real heal_factor     = 0.6     // модификаторы хилла, процент
    local string text_damage   = ""
    local boolean yamato       = false
    local boolean fragility    = false
	local integer crit_count   = 0 
    
    if IsUnitInvulnerable(newTarget) then
        set damage=0
        set miss=true
    endif

	// if GetUnitAbilityLevel(newCaster, 'A3IG')==0 then	// Патриот анти-миссы и миссы в целом
	
		// if (UnitHasItemOfTypeBJ(newTarget, 'I03E') or UnitHasItemOfTypeBJ(newTarget, 'I03F') or GetUnitAbilityLevel(newTarget, 'KIJ2')>0 or GetUnitAbilityLevel(newTarget, 'KIJ4')>0) and GetRandomInt(0, 99)<=49 then	// Туфли или Комплект Анбу - уклонение
			// set damage=0
			// set miss=true
		// endif
		
		// if GetUnitAbilityLevel(newTarget, 'A14R')>0 then									// Демон Глаз активка
			// set damage=0
			// set miss=true
		// endif
		
		// if GetUnitAbilityLevel(newCaster, 'B063')>0 and GetRandomInt(0, 99)<=49  then 		// Синон промах 50%	
			// set damage=0
			// set miss=true
		// endif
		
		// if GetUnitAbilityLevel(newCaster, 'MaEb')>0 then 									// Мадока 100% промах
			// set damage=0
			// set miss=true
		// endif
		
	// endif
    
    // Усиление урона от автоатаки крит шансом
    set critchance_dmg = damage*CalculateCritChance(newCaster)
    set damage = damage //+ critchance_dmg
    //

	if IsUnitType(newCaster,UNIT_TYPE_HERO) and IsUnitIllusion(newCaster)==false and miss==false then
	
    if UnitHasItemOfTypeBJ(newCaster, 'I02V') then	// Ямато
        call Essence(newCaster,newTarget,1)
        if (LoadReal(HH,GetHandleId(newCaster),StringHash("yamato"))==1 or GetRandomIntMem(0,100)<15*(1+B2R_ExD(first_crit))) and max_crit_count>crit_count then
            set crit_damage=crit_damage+(2.0*crit_factor)
            set first_crit = false
            call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",newTarget,"chest"))
            call SaveReal(HH,GetHandleId(newCaster),StringHash("yamato"),0)
            set yamato = true
            set crit_count = crit_count + 1
        endif
    endif
	if UnitHasItemOfTypeBJ(newCaster, 'IBSI') and GetRandomIntMem(0,100)<15*(1+B2R_ExD(first_crit)) and max_crit_count>crit_count then	// Бастер Меч
		set crit_damage=crit_damage+(1*crit_factor)
        set first_crit = false
		set crit_count = crit_count + 1
	endif
    if UnitHasItemOfTypeBJ(newCaster, 'I01U') and GetRandomIntMem(0,100)<20*(1+B2R_ExD(first_crit)) and max_crit_count>crit_count then	// Фэнг
		set crit_damage=crit_damage+(1*crit_factor)
        set first_crit = false
		set crit_count = crit_count + 1
	endif
    if UnitHasItemOfTypeBJ(newCaster, 'I01Q') and GetRandomIntMem(0,100)<20*(1+B2R_ExD(first_crit)) and max_crit_count>crit_count then	// Сюсуй
		set crit_damage=crit_damage+(1*crit_factor)
        set first_crit = false
		set crit_count = crit_count + 1
	endif
	if UnitHasItemOfTypeBJ(newCaster, 'I01S') and GetRandomIntMem(0,100)<30*(1+B2R_ExD(first_crit)) and max_crit_count>crit_count then	// Темный Экскалибур
		set crit_damage=crit_damage+(1*crit_factor)
        set first_crit = false
		set crit_count = crit_count + 1
	endif
	if UnitHasItemOfTypeBJ(newCaster, 'I01O') and GetRandomIntMem(0,100)<20*(1+B2R_ExD(first_crit)) and max_crit_count>crit_count then	// Сандай Китецу
		set crit_damage=crit_damage+(1*crit_factor)
        set first_crit = false
		set crit_count = crit_count + 1
	endif
	if UnitHasItemOfTypeBJ(newCaster, 'I01L') and GetRandomIntMem(0,100)<15*(1+B2R_ExD(first_crit)) and max_crit_count>crit_count then	// Закаленный меч
		set crit_damage=crit_damage+(1*crit_factor)
        set first_crit = false
		set crit_count = crit_count + 1
	endif
	if UnitHasItemOfTypeBJ(newCaster, 'I01K') and GetRandomIntMem(0,100)<15*(1+B2R_ExD(first_crit)) and max_crit_count>crit_count then	// Меч A ранга
		set crit_damage=crit_damage+(1.0*crit_factor)
        set first_crit = false
		set crit_count = crit_count + 1
	endif
	if UnitHasItemOfTypeBJ(newCaster, 'I01I') and GetRandomIntMem(0,100)<15*(1+B2R_ExD(first_crit)) and max_crit_count>crit_count then	// Меч B ранга
		set crit_damage=crit_damage+(0.75*crit_factor)
        set first_crit = false
		set crit_count = crit_count + 1
	endif
	if UnitHasItemOfTypeBJ(newCaster, 'I01J') and GetRandomIntMem(0,100)<15*(1+B2R_ExD(first_crit)) and max_crit_count>crit_count then	// Меч C ранга
		set crit_damage=crit_damage+(0.5*crit_factor)
        set first_crit = false
		set crit_count = crit_count + 1
	endif
	if GetUnitAbilityLevel(newCaster,'WAE1')>0 and GetRandomIntMem(0,100)<30*(1+B2R_ExD(first_crit)) and max_crit_count>crit_count then	// Waver F
		set crit_damage=crit_damage+(0.5*crit_factor)
        set first_crit = false
		set crit_count = crit_count + 1
	endif
	//call BJDebugMsg(R2S(crit_damage))
    // критический урон
    if attack_factor<1.0 then
        set current_damage = current_damage*attack_factor
    endif
    set damage = damage + (current_damage * crit_damage)
    //
	
	if modif_factor>0.0 then
	
		if UnitHasItemOfTypeBJ(newCaster, 'I031') and IsUnitType(newTarget,UNIT_TYPE_HERO) and IsUnitIllusion(newTarget)==false then 	// Патриот
			set bjLCT=CreateTimer()
				call SetHeroAgi(newCaster,GetHeroAgi(newCaster,false)+3,true)
				call SetHeroStr(newCaster,GetHeroStr(newCaster,false)+3,true)
				call SetHeroInt(newCaster,GetHeroInt(newCaster,false)+3,true)
				call SetHeroAgi(newTarget,GetHeroAgi(newTarget,false)-3,true)
				call SetHeroStr(newTarget,GetHeroStr(newTarget,false)-3,true)
				call SetHeroInt(newTarget,GetHeroInt(newTarget,false)-3,true)
				call SaveUnitHandle(h,GetHandleId(bjLCT), 0, newTarget)
				call SaveUnitHandle(h,GetHandleId(bjLCT), 1, newCaster)
				call TimerStart(bjLCT, 5*modif_factor, false, function VergilPatriot_ModifEnd)
			set bjLCT=null
			//set damage=damage-damage*0.3
		endif
		
		if UnitHasItemOfTypeBJ(newCaster, 'I04F') then 				// Экскалибур
            call HealTextTag(newCaster,newCaster,damage*0.2*heal_factor*myCustomHeal2(newCaster,1),"HealthRes")
			call SetWidgetLife(newCaster, GetWidgetLife(newCaster)+myCustomDamage2(newTarget, damage*0.2))
			set bjLCT=CreateTimer()
				call SetUnitArmour(newTarget, GetUnitArmour(newTarget)-4)
				call SaveUnitHandle(h,GetHandleId(bjLCT), 0, newTarget)
				call SaveUnitHandle(h,GetHandleId(bjLCT), 1, newCaster)
				call TimerStart(bjLCT, 10*modif_factor, true, function SinonExcalibur_ModifEnd)
			set bjLCT=null
		endif
		
		if UnitHasItemOfTypeBJ(newCaster, 'I01S') and GetRandomInt(0, 9)<=3 then 				// Темный Экскалибур
			if LoadBoolean(h, GetHandleId(newCaster), StringHash("ItemDarkExc_CD"))==false then
				set bjLCT=CreateTimer()
				call SaveBoolean(h, GetHandleId(newCaster), StringHash("ItemDarkExc_CD"), true)
				call UnitRemoveAbility(newCaster, 'A26R')
				call UnitAddAbility(newCaster,'A26R')
				call SaveUnitHandle(h,GetHandleId(bjLCT),0,newCaster)
				call TimerStart(bjLCT,3,false,function VergilDarkExcalibur_ModifEnd)
				set bjLCT=null
			endif
		endif
		
		if GetUnitAbilityLevel(newCaster, 'A26R')>0 then										// Темный Экскалибур Хилл
            call HealTextTag(newCaster,newCaster,damage*0.5*heal_factor*myCustomHeal2(newCaster,1),"HealthRes")
			call SetWidgetLife(newCaster, GetWidgetLife(newCaster)+myCustomDamage2(newTarget, damage*0.5*heal_factor))
		endif
		
		if GetUnitAbilityLevel(newCaster, 'B06N')>0 then										// Жанна Альтер Хилл
            call HealTextTag(newCaster,newCaster,damage*0.3*heal_factor*myCustomHeal2(newCaster,1),"HealthRes")
			call SetWidgetLife(newCaster, GetWidgetLife(newCaster)+myCustomDamage2(newTarget, damage*0.3*heal_factor))
		endif
		
		if UnitHasItemOfTypeBJ(newCaster, 'I03O') then 				// Самехада: Чистый Урон
			set bonus_damage=(150+GetUnitTotalDamage(newCaster)*0.4)*modif_factor
			if GetWidgetLife(newTarget)>bonus_damage then
				//call SetWidgetLife(newTarget, GetWidgetLife(newTarget)-bonus_damage)
				call CustomTrueDamage(newCaster, newTarget, bonus_damage)
			else
				set fatal_damage=true
			endif
		endif
		
		if UnitHasItemOfTypeBJ(newCaster, 'I03B') then				// Меч Анбу
			set bonus_damage=55*modif_factor
			if GetWidgetLife(newTarget)>bonus_damage then
				//call SetWidgetLife(newTarget, GetWidgetLife(newTarget)-bonus_damage)
				call CustomTrueDamage(newCaster, newTarget, bonus_damage)
			else
				set fatal_damage=true
			endif
		endif
		
		if UnitHasItemOfTypeBJ(newCaster, 'I050') then				// Гегецебури
			set bonus_damage=100*modif_factor
			if GetWidgetLife(newTarget)>bonus_damage then
				//call SetWidgetLife(newTarget, GetWidgetLife(newTarget)-bonus_damage)
				call CustomTrueDamage(newCaster, newTarget, bonus_damage)
			else
				set fatal_damage=true
			endif
			call DestroyEffect(AddSpecialEffect("war3mapImported\\Cleave.mdx",GetUnitX(newTarget),GetUnitY(newTarget)))
            if GetRandomIntMem(0,100)<20 then
                call SetControlToUnit(newTarget, newTarget, 1.0, "stun")
                call SetControlToUnit(newTarget, newTarget, 0.2, "stunbkb")
            endif
		endif
		
		if GetUnitAbilityLevel(newCaster,'WAE4')==0 and GetUnitAbilityLevel(newCaster,'WAE1')>0 then
			call SetControlToUnit(newTarget,newTarget, 0.3, "stun")
			call UnitAddAbility(newCaster,'WAE4')
			call UnitRemoveAbilityTimed(newCaster,'WAE4',0.7)
			set damage = damage + GetHeroInt(newCaster,true) * modif_factor
		endif
		
		if UnitHasItemOfTypeBJ(newCaster, 'I03N') then 				// Самехада: Манажор
			call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Feedback\\ArcaneTowerAttack.mdl", newTarget,"origin"))
			call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl", newTarget,"chest"))
			if GetWidgetMana(newTarget)>0 then
                call HealTextTag(newCaster,newCaster,(GetWidgetMana(newTarget)*0.16*modif_factor)*heal_factor*myCustomHeal2(newCaster,1),"HealthRes")
				call SetWidgetLife(newCaster, GetWidgetLife(newCaster)+(GetWidgetMana(newTarget)*0.16*modif_factor)*heal_factor)
			endif
			call SetWidgetMana(newTarget, GetWidgetMana(newTarget)-GetWidgetMana(newTarget)*0.08*modif_factor)
		endif
		
		if UnitHasItemOfTypeBJ(newCaster, 'I01U') and GetRandomInt(1, 100)<=45 then 		// Feng
			call PoisonDamage5(newCaster,newTarget, 2.5*GetHeroInt(newCaster,true)*modif_factor, 3, "Abilities\\Weapons\\PoisonSting\\PoisonStingTarget.mdl", "chest")
			set n=CreateUnit(GetOwningPlayer(newCaster),'h019',GetUnitX(newTarget),GetUnitY(newTarget),0)
			call UnitAddAbility(n,'A2CW')
			call SetUnitAbilityLevel(n,'A2CW',1)
			call UnitApplyTimedLife(n,'BHwe',1)
			call IssueTargetOrder(n,"cripple",newTarget)
		endif
		if UnitHasItemOfTypeBJ(newCaster, 'I01Q') and (GetRandomInt(1, 100)<=20 or GetUnitAbilityLevel(newCaster,'A06K')>0) then 		// Сюсуй
			call Shusui_Cast(newCaster, modif_factor)
		endif
        if UnitHasItemOfTypeBJ(newTarget,'I05O')or UnitHasItemOfTypeBJ(newTarget,'I05P')or UnitHasItemOfTypeBJ(newTarget,'I05Q')or UnitHasItemOfTypeBJ(newTarget,'I05R')or UnitHasItemOfTypeBJ(newTarget,'I05S')or UnitHasItemOfTypeBJ(newTarget,'I05T') or GetUnitAbilityLevel(newTarget, 'KIT8')>0 or GetUnitAbilityLevel(newTarget, 'KIU0')>0 or GetUnitAbilityLevel(newTarget, 'KIU2')>0 or GetUnitAbilityLevel(newTarget, 'KIU4')>0 or GetUnitAbilityLevel(newTarget, 'KIU6')>0 or GetUnitAbilityLevel(newTarget, 'KIU8')>0 then
            call RainMare_Actions(newCaster,newTarget)
        endif
		// if UnitHasItemOfTypeBJ(newTarget, 'I03C') and UnitHasItemOfTypeBJ(newTarget, 'I03F')==false then	// Жилет Анбу у таргета
			// call SetWidgetLife(newTarget, GetWidgetLife(newTarget)+35)
			// call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Heal\\HealTarget.mdl", newTarget,"origin"))
		// endif
		
		// if UnitHasItemOfTypeBJ(newTarget, 'I03F') then														// Комплект Анбу у таргета
			// call SetWidgetLife(newTarget, GetWidgetLife(newTarget)+50)
			// call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Heal\\HealTarget.mdl", newTarget,"origin"))
		// endif
		
		// if UnitHasItemOfTypeBJ(newTarget, 'I060') then														// Облако Маре D ранг
			// set damage=damage-30
		// endif
		
		// if UnitHasItemOfTypeBJ(newTarget, 'I061') then														// Облако Маре C ранг
			// set damage=damage-50
		// endif
		
		// if UnitHasItemOfTypeBJ(newTarget, 'I062') then														// Облако Маре B ранг
			// set damage=damage-70
		// endif
		
		// if UnitHasItemOfTypeBJ(newTarget, 'I063') then														// Облако Маре A ранг
			// set damage=damage-90
		// endif
			
		// if UnitHasItemOfTypeBJ(newTarget, 'I064') then														// Облако Маре Фальшивое
			// set damage=damage-110
		// endif
		
		// if UnitHasItemOfTypeBJ(newTarget, 'I065') then														// Облако Маре Истинное
			// set damage=damage-130
		// endif
		
		endif
	endif
	
    set damage = damage + newDamage

    if damage>0 then                
        if overcharge then                  // Сверхзаряд Синон
            set damage = damage + (GetWidgetMaxLife(newTarget)-GetWidgetLife(newTarget))*0.2
        endif

        // Попадение в спину
        if (GetUnitFacing(newTarget)-GetUnitFacing(newCaster))<=75 and(GetUnitFacing(newTarget)-GetUnitFacing(newCaster))>=-75 then
            set damage = damage*1.15
            set backstab = true
        endif

        // Хрупкость -15% маг реза
        if GetUnitAbilityLevel(newTarget, 'SNT1')>0 then
            set fragility = true
            call UnitAddAbility(newTarget, 'SNT2')
			set soundplay=CreateSound("Sound\\Music\\mp3Music\\SinonThit.mp3",false,false,true,12700,12700,"")
			call StartSound(soundplay)
			call KillSoundWhenDone(soundplay)
        endif
    endif


	if miss then
		call AllTextTag("|c00C0C0C0Miss!|r" , newTarget)
        set damage = 0
    else
        if attack_factor>0.5 then
            // Текст над головой
            if first_crit==false then
				if crit_count>1 then
					set text_damage = "|c00880a0aCRIT!x"+I2S(crit_count)+"|r"
				else
					set text_damage = "|c00880a0aCRIT!|r"
				endif
            endif
            if backstab and first_crit==false then
                set text_damage = text_damage + " + |c007a02dbBACKSTAB!|r"
            elseif backstab then
                set text_damage = "|c007a02dbBACKSTAB!|r"
            endif
            // if yamato and (first_crit==false or backstab) then
            //     set text_damage = text_damage + " + |c000080FFYAMATO!|r"
            // elseif yamato then
            //     set text_damage = "|c000080FFYAMATO!|r"
            // endif
            if fragility and (first_crit==false or backstab) then
                set text_damage = text_damage + " + |c00009eceFRAGILITY!|r"
            elseif fragility then
                set text_damage = "|c00009eceFRAGILITY!|r"
            endif
            if overcharge and (fragility or first_crit==false or backstab) then
                set text_damage = text_damage + " + |c00007cceOVERCHARGE!|r"
            elseif overcharge then
                set text_damage = "|c00007cceOVERCHARGE!|r"
            endif
            call AllTextTag(text_damage , newTarget)
        endif
	endif
	
	
	if fatal_damage==false then
		if damage>0 then
			call myCustomDamage(newCaster,newTarget,damage,false,false,null,null,null)
		endif
	else
		call UnitRemoveBuffs(newTarget,true,true)
		call UnitAddAbility(newTarget,'A0WR')
        call DamageIndicatorFunction(newCaster,newTarget,damage)
		call myCustomDamage(newCaster, newTarget, GetWidgetMaxLife(newTarget),false,false,null,null,null)
		call UnitRemoveAbility(newTarget,'A0WR')
		//call AllTextTag("|c000080FFSCUM!|r" , newTarget)
	endif	
    if fragility then
        call UnitRemoveAbility(newTarget, 'SNT2')
        call UnitRemoveAbility(newTarget, 'SNT1')
        call UnitRemoveAbility(newTarget, 'B16W')
    endif
	return miss
endfunction

function KarnaQ_Periodic takes nothing returns nothing 
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    caster = LoadUnitHandle(h, id, 0)
    local integer c_id   = GetHandleId(caster)
    local real    duration = LoadReal(h, id, 1)+0.02
    local real    angle    = 0.0
    local real    damage   = LoadReal(HH, c_id, KarnaQ_Damage)
	local real    damage_force = GetUnitAbilityLevel(caster, 'KaA3')*0.5
    local integer index    = 0
    local integer eff_period = LoadInteger(h, id, 12)
    if duration<8.0 and damage>0 then
        call SaveReal(h, id, 1, duration)
        if duration==2.0 then
            call RemoveEffect(AddSpecialEffectTarget("supershinythingyhg2.mdl", caster, "weapon"), 0.8, true, CreateTimer())
            call UnitAddAbility(caster, 'KaA5')
            call SetUnitAbilityLevel(caster, 'KaA5', GetUnitAbilityLevel(caster,'KaA4'))
            call UnitRemoveAbility(caster, 'KaA4')
        endif
        if duration<2.0 then
            //call SaveReal(HH, c_id, KarnaQ_Damage, damage+2.5*0.02/2)
            call SaveReal(HH, c_id, KarnaQ_Damage, 1.0+duration/2*damage_force)
            if eff_period<=0 then
                set n=CreateUnit(GetOwningPlayer(caster), 'd060', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG)
                call SetUnitScale(n, 2.5, 2.5, 2.5)
                call SetUnitTimeScale(n, 0.6)
                call SetUnitFlyHeight(n, 250, 0)
                call SetUnitAnimationByIndex(n, GetRandomInt(0, 16))
                call MyRemoveUnit(n, 2)
                call SaveInteger(h, id, 12, 1)
            else
                call SaveInteger(h, id, 12, eff_period-1)
            endif
        else
            call DestroyEffect(AddSpecialEffectTarget("krk (1965).mdl", caster, "weapon"))
        endif
		
		call SetUnitXY(LoadUnitHandle(h, id, 20), GetUnitX(caster), GetUnitY(caster))
    else
		call RemoveUnit(LoadUnitHandle(h, id, 20))
        call UnitRemoveAbility(caster, 'KaA4')
        call UnitRemoveAbility(caster, 'KaA5')
        call ShowAbility2('KaA3', true)
        if damage<=0 then
            call StartAbilityCooldown(GetUnitAbility(caster, 'KaA3'), GetAbilityCooldown(GetUnitAbility(caster, 'KaA3')))
        endif
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set newTimer = null
    set caster   = null
endfunction

function KarnaQ_Cast takes unit newCaster returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id   = GetHandleId(newCaster)
    local real caster_x  = GetUnitX(newCaster)
    local real caster_y  = GetUnitY(newCaster)
    local real angle     = GetUnitFacing(newCaster)*bj_DEGTORAD
    local integer index  = 0
    call CreateModeIndicatorKarnaQ(newCaster, "ReplaceableTextures\\CommandButtons\\BTNKarnaQ_Cast.blp", 8.0)
    set soundplay=CreateSound("Sound\\Music\\mp3Music\\KarnaQ0.mp3", false, false, true, 12700, 12700, "")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
	set n = CreateUnit(GetOwningPlayer(newCaster), 'd130', caster_x, caster_y, 0)
	call UnitScale(n, 0.1, 10.0, 0.15)
	call UnitAddAbility(n, 'A0A1')
	call SaveUnitHandle(h, id, 20, n)
    call UnitAddAbility(newCaster, 'KaA4')
    call SetUnitAbilityLevel(newCaster, 'KaA4', GetUnitAbilityLevel(newCaster,'KaA3'))
    call ShowAbility2('KaA3', false)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(HH, c_id, KarnaQ_Damage, 1.0)
    call TimerStart(newTimer, 0.02, true, function KarnaQ_Periodic)
    set newTimer = null
endfunction


function KarnaQ_LaserBlastAct takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    caster = LoadUnitHandle(h, id, 0)
    local real    point_x = LoadReal(h, id, 1)
    local real    point_y = LoadReal(h, id, 2)
    local boolean second_anim   = LoadBoolean(h, id, 4)
    local real    damage_factor = LoadReal(h, id, 3)
    local real    damage        = GetHeroAgi(caster, true)*GetUnitAbilityLevel(caster, 'KaA3')
    //set damage = damage + damage*0.3*(damage_factor-1.0)/8.3

    set n = CreateUnit(GetOwningPlayer(caster), 'dR36', point_x, point_y, GetRandomInt(0, 360))
    call SetUnitScale(n, 2, 2, 2)
    call MyRemoveUnit(n, 3.5)
    set n = CreateUnit(GetOwningPlayer(caster), 'd107', point_x, point_y, GetRandomInt(0, 360))
    call SetUnitScale(n, 0.35, 0.35, 0.35)
    call UnitApplyTimedLife(n, 1, 0.5)
    call MyRemoveUnit(n, 1.0)
    set n = CreateUnit(GetOwningPlayer(caster), 'd108', point_x, point_y, GetRandomInt(0, 360))
    call SetUnitScale(n, 0.5, 0.5, 0.5)
    call MyRemoveUnit(n, 3.5)
    //set n = CreateUnit(GetOwningPlayer(caster), 'd109', point_x, point_y, GetRandomInt(0, 360))
    //call SetUnitScale(n, 1.0, 1.0, 1.0)
    //call SetUnitVertexColor(n, 255, 0, 0, 255)
    //call MyRemoveUnit(n, 3.5)
    // set n = CreateUnit(GetOwningPlayer(caster), 'dR36', point_x, point_y, GetRandomInt(0, 360))
    // call SetUnitScale(n, 2, 2, 2)
    // call MyRemoveUnit(n, 3.5)
    // set n = CreateUnit(GetOwningPlayer(caster), 'd021', point_x, point_y, GetRandomInt(0, 360))
    // call SetUnitScale(n, 1, 1, 1)
    // call MyRemoveUnit(n, 3.5)
    // set n = CreateUnit(GetOwningPlayer(caster), 'dM28', point_x, point_y, GetRandomInt(0, 360))
    // call SetUnitScale(n, 1, 1, 1)
    // call SetUnitVertexColor(n, 255, 255, 255, 170)
    // call MyRemoveUnit(n, 3.5)
    // set n = CreateUnit(GetOwningPlayer(caster), 'dRe9', point_x, point_y, GetRandomInt(0, 360))
    // call SetUnitScale(n, 2, 2, 2)
    // call UnitApplyTimedLife(n, 1, 2.0)
    // call MyRemoveUnit(n, 3.5)

    call GroupEnumUnitsInRange(G, point_x, point_y, 200, Base)
    loop
    set E=FirstOfGroup(G)
    exitwhen E==null
        if Condition_Base(GetOwningPlayer(caster), E) and GetUnitAbilityLevel(E, 'KaAW')==0 then
            // if GetUnitAbilityLevel(caster, 'KaAC')>0 then
            //     call UnitRemoveAbility(caster,'KaAC')
            //     call UnitRemoveAbility(caster,'kaA1')
            //     set damage = damage + GetHeroAgi(caster, true)*2
            //     set n=CreateUnit(GetOwningPlayer(caster), 'd032', GetUnitX(E), GetUnitY(E), GetRandomInt(0, 360))
            //     call SetUnitScale(n, 4, 4, 4)
            //     call SetUnitVertexColor(n, 255, 150, 100, 255)
            //     call SetUnitFlyHeight(n, 100, 0)
            //     call MyRemoveUnit(n, 2.5)
            // endif
            if Karna_ModifAttack(caster, E, damage_factor*0.6, damage*0.6, 0.6, false) then
            endif
            call SetControlToUnit(E, E, 1.0, "stun")
            call UnitAddAbility(E, 'KaAW')
            call UnitMakeAbilityPermanent(E, true, 'KaAW')
            call UnitRemoveAbilityTimed(E, 'KaAW', 0.2)
        endif
    call GroupRemoveUnit(G, E)
    endloop

    call FlushChildHashtable(h, id)
    call DestroyTimer(newTimer)
    set newTimer = null
    set caster   = null
endfunction

function KarnaQ_LaserBlast takes unit newCaster, real point_x, real point_y, real damage_factor, boolean second_anim returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)

    set n = CreateUnit(GetOwningPlayer(newCaster), 'd105', point_x, point_y, GetRandomInt(0, 360))
    call SetUnitScale(n, 1.0, 1.0, 1.0)
    call UnitApplyTimedLife(n, 1, 0.5)
    call MyRemoveUnit(n, 1.0)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(h, id, 1, point_x)
    call SaveReal(h, id, 2, point_y)
    call SaveReal(h, id, 3, damage_factor)
    call SaveBoolean(h, id, 4, second_anim)
    call TimerStart(newTimer, 1.0, false, function KarnaQ_LaserBlastAct)
    set newTimer = null
endfunction

function KarnaQ1_Periodic2 takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    caster = LoadUnitHandle(h, id, 0)
    local unit    dummy  = LoadUnitHandle(h, id, 5)
    local real    distance = LoadReal(h, id, 4)
    local real    angle    = LoadReal(h, id, 2)
    local real    damage_factor = LoadReal(h, id, 1)
    local real    damage        = GetHeroAgi(caster, true)*GetUnitAbilityLevel(caster, 'KaA3')
    local integer eff_period    = LoadInteger(h, id, 6)
    //set damage = damage + damage*0.3*(damage_factor-1.0)/8.3
    if distance>0 and LoadBoolean(HH,GetHandleId(caster),DASH_USER)==true then
        call SetUnitX(dummy, GetUnitX(dummy)+40*Cos(angle))
        call SetUnitY(dummy, GetUnitY(dummy)+40*Sin(angle))
        call SaveReal(h, id, 4, distance-40)
        call GroupEnumUnitsInRange(G, GetUnitX(dummy), GetUnitY(dummy), (100+distance*0.3), Base)
        loop
            set E=FirstOfGroup(G)
            exitwhen E==null
            if Condition_Base(GetOwningPlayer(caster), E) and GetUnitAbilityLevel(E, 'KaAW')==0 then
                if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
                    // if GetUnitAbilityLevel(caster, 'KaAC')>0 then
                    //     call UnitRemoveAbility(caster,'KaAC')
                    //     call UnitRemoveAbility(caster,'kaA1')
                    //     set damage = damage + GetHeroAgi(caster, true)*2
                    //     set n=CreateUnit(GetOwningPlayer(caster), 'd032', GetUnitX(E), GetUnitY(E), GetRandomInt(0, 360))
                    //     call SetUnitScale(n, 4, 4, 4)
                    //     call SetUnitVertexColor(n, 255, 150, 100, 255)
                    //     call SetUnitFlyHeight(n, 100, 0)
                    //     call MyRemoveUnit(n, 2.5)
                    // endif
                    if Karna_ModifAttack(caster, E, damage_factor, damage, 0.6, false) then
                    endif
                    call SetControlToUnit(E, E, 2, "stun")
                    call UnitAddAbility(E, 'KaAW')
                    call UnitMakeAbilityPermanent(E, true, 'KaAW')
                    call UnitRemoveAbilityTimed(E, 'KaAW', 0.2)
                    call AGilPush(E,20,angle,200)
                else
                    call SaveBoolean(HH,GetHandleId(caster),DASH_USER,false)
                    call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,caster)
                endif
            endif
            call GroupRemoveUnit(G, E)
        endloop
			// set n=CreateUnit(GetOwningPlayer(caster), 'd062', GetUnitX(dummy), GetUnitY(dummy), 0)
			// call SetUnitScale(n, 0.5, 0.5, 0.5)
			// call SetUnitFlyHeight(n, 50, 0)
			// call UnitApplyTimedLife(n, 1, 1.3)
			// call MyRemoveUnit(n, 1.7)
            // set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH05', GetUnitX(dummy), GetUnitY(dummy), angle*bj_RADTODEG)
            // call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
            // call MyRemoveUnit(bjLCU, 1.5)
            // set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH06', GetUnitX(dummy), GetUnitY(dummy), angle*bj_RADTODEG)
            // call SetUnitScale(bjLCU, 1.2, 1.2, 1.2)
            // call SetUnitTimeScale(bjLCU, 0.6)
            // call SetUnitFlyHeight(bjLCU, 50, 0)
            // call MyRemoveUnit(bjLCU, 1.5)
            // set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dRe9', GetUnitX(dummy), GetUnitY(dummy), angle*bj_RADTODEG)
            // call SetUnitScale(bjLCU, 3.25, 3.25, 3.25)
            // call UnitApplyTimedLife(bjLCU, 1, 1.0)
            // call MyRemoveUnit(bjLCU, 3.0)
            // if eff_period<=0 then
            //     call KarnaQ_LaserBlast(caster, GetUnitX(dummy), GetUnitY(dummy), damage_factor, false)
            //     call SaveInteger(h, id, 6, 4)
            // else
            //     call SaveInteger(h, id, 6, eff_period - 1)
            // endif
    else
        call SaveBoolean(HH,GetHandleId(caster),DASH_USER,false)
        call MyRemoveUnit(dummy, 1.0)
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set newTimer = null
    set caster   = null
endfunction

function KarnaQ1_Periodic1 takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    caster = LoadUnitHandle(h, id, 0)
    local real    angle  = LoadReal(h, id, 2)
    local real    duration = LoadReal(h, id, 3)-0.1
    if duration>0 then
        call SaveReal(h, id, 3, duration)
    else
        call ShakeCamera(0.3, 10)
        set n=CreateUnit(GetOwningPlayer(caster), 'd131', GetUnitX(caster)+400*Cos(angle), GetUnitY(caster)+400*Sin(angle), angle*bj_RADTODEG)
        call SetUnitFlyHeight(n, 100, 0)
        call UnitScale(n, 0.1, 4.0, 0.2)
        call UnitApplyTimedLife(n, 1, 0.4)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'd131', GetUnitX(caster)+400*Cos(angle), GetUnitY(caster)+400*Sin(angle), angle*bj_RADTODEG)
        call SetUnitFlyHeight(n, 100, 0)
        call SetUnitScale(n, 4.0, 4.0, 4.0)
        call KillUnit(n)
        call MyRemoveUnit(n, 1.5)

        set n=CreateUnit(GetOwningPlayer(caster), 'dR39', GetUnitX(caster)+250*Cos(angle), GetUnitY(caster)+250*Sin(angle), angle*bj_RADTODEG+90)
        call SetUnitFlyHeight(n, 50, 0)
        call UnitScale(n, 0.1, 1.5, 0.2)
        call MyRemoveUnit(n, 1.4)
        set n=CreateUnit(GetOwningPlayer(caster), 'dR39', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG+90)
        call SetUnitFlyHeight(n, 50, 0)
        call UnitScale(n, 0.1, 1.5, 0.2)
        call MyRemoveUnit(n, 1.4)

        set n=CreateUnit(GetOwningPlayer(caster), 'dR39', GetUnitX(caster)+250*Cos(angle), GetUnitY(caster)+250*Sin(angle), angle*bj_RADTODEG+90)
        call SetUnitFlyHeight(n, 50, 0)
        call UnitScale(n, 0.1, 2.2, 0.2)
        call MyRemoveUnit(n, 1.4)
        
        set n=CreateUnit(GetOwningPlayer(caster), 'dAlb', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG)
        call SetUnitFlyHeight(n, 0, 0)
        call SaveUnitHandle(h, id, 5, n)
        call SetUnitFacing(caster, LoadReal(h, id, 2)*bj_RADTODEG)
        call SetUnitTimeScale(caster, 1.0)
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call SaveBoolean(HH,GetHandleId(caster),DASH_USER,true)
        call PauseTimer(newTimer)
        call TimerStart(newTimer, 0.005, true, function KarnaQ1_Periodic2)
    endif
    set newTimer = null
    set caster   = null
endfunction

function KarnaQ1_Cast takes unit newCaster, real point_x, real point_y returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local real caster_x  = GetUnitX(newCaster)
    local real caster_y  = GetUnitY(newCaster)
    local real angle     = AP(caster_x, caster_y, point_x, point_y)
    local integer index  = 0

    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, 13)
	
	call RengokuE_Shifting(newCaster, newCaster, angle, SquareRootPoint(caster_x, caster_y, point_x, point_y), CreateTimer())
	set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dH05', caster_x, caster_y, angle*bj_RADTODEG)
	call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
	call MyRemoveUnit(bjLCU, 1.5)
	set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dH06', caster_x, caster_y, angle*bj_RADTODEG)
	call SetUnitScale(bjLCU, 1.2, 1.2, 1.2)
	call SetUnitTimeScale(bjLCU, 0.6)
	call SetUnitFlyHeight(bjLCU, 50, 0)
	call MyRemoveUnit(bjLCU, 1.5)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dRe9', caster_x, caster_y, angle*bj_RADTODEG)
	call SetUnitScale(bjLCU, 3.25, 3.25, 3.25)
    call UnitApplyTimedLife(bjLCU, 1, 1.0)
	call MyRemoveUnit(bjLCU, 3.0)

    set soundplay=CreateSound("Sound\\Music\\mp3Music\\KarnaQ1.mp3", false, false, true, 12700, 12700, "")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)

    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(h, id, 1, LoadReal(HH, GetHandleId(newCaster), KarnaQ_Damage)) // фулл урон спелла
    call SaveReal(h, id, 2, angle)
    call SaveReal(h, id, 3, 0.5)  // время ожидания первого акта
    call SaveReal(h, id, 4, 900) // дальность спелла
    call SaveReal(HH, GetHandleId(newCaster), KarnaQ_Damage, 0.0)
    call TimerStart(newTimer, 0.1, true, function KarnaQ1_Periodic1)
    set newTimer = null
endfunction



function KarnaQ2_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
	local unit caster=LoadUnitHandle(h, id, c_CASTER)
    local real caster_x= GetUnitX(caster)
    local real caster_y= GetUnitY(caster)
    local real angle= LoadReal(h, id, c_ANGLE)
    local real time= LoadReal(h, id, c_TIME)
    local string combination= LoadStr(h, id, 16)
    local integer eff_period= LoadInteger(h, id, c_EFFPERIOD)
    local real    damage_factor = LoadReal(h, id, c_DAMAGE)
    local real    damage        = GetHeroAgi(caster, true)*GetUnitAbilityLevel(caster, 'KaA3')
    //set damage = damage + damage*0.3*(damage_factor-1.0)/8.3
    if time < 20 then
        call SaveReal(h, id, c_TIME, time + 1)
        // if time == 1 then
        //     call SetUnitAnimationByIndex(LoadUnitHandle(h, id, c_CASTER), 9)
        // endif
        if time < 18 then
            set bjLCU=LoadUnitHandle(h, id, 16)
            call SetUnitX(bjLCU , caster_x + 200 * Cos(angle - ( 90 - time * 11 ) * bj_DEGTORAD))
            call SetUnitY(bjLCU , caster_y + 200 * Sin(angle - ( 90 - time * 11 ) * bj_DEGTORAD))
            set bjLCU=LoadUnitHandle(h, id, 17)
            call SetUnitX(bjLCU , caster_x + 325 * Cos(angle - ( 90 - time * 11 ) * bj_DEGTORAD))
            call SetUnitY(bjLCU , caster_y + 325 * Sin(angle - ( 90 - time * 11 ) * bj_DEGTORAD))
            set bjLCU=LoadUnitHandle(h, id, 18)
            call SetUnitX(bjLCU , caster_x + 450 * Cos(angle - ( 90 - time * 11 ) * bj_DEGTORAD))
            call SetUnitY(bjLCU , caster_y + 450 * Sin(angle - ( 90 - time * 11 ) * bj_DEGTORAD))
            call SetUnitFacing(LoadUnitHandle(h, id, c_DUMMY1), angle * bj_RADTODEG - 95 + time * 4)
            call SetUnitFacing(LoadUnitHandle(h, id, c_DUMMY2), angle * bj_RADTODEG - 95 + time * 4)
            call SetUnitFacing(LoadUnitHandle(h, id, c_DUMMY3), angle * bj_RADTODEG - 95 + time * 4)
            call SetUnitFacing(LoadUnitHandle(h, id, c_DUMMY4), angle * bj_RADTODEG - 95 + time * 4)
            if combination == "E" then
                if eff_period == 0 then
					set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR99', caster_x+150*Cos(angle-(90-time*11)*bj_DEGTORAD), caster_y+150*Sin(angle-(90-time*11)*bj_DEGTORAD), 140 + angle * bj_RADTODEG + 33 + time * 4)
					call SetUnitScale(bjLCU, 0.8, 0.8, 0.8)
					call SetUnitVertexColor(bjLCU, 255, 255, 255, 100)
					call MyRemoveUnit(bjLCU, 1.5)
					set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR99', caster_x + 300 * Cos(angle - ( 90 - time * 11 ) * bj_DEGTORAD), caster_y + 300 * Sin(angle - ( 90 - time * 11 ) * bj_DEGTORAD), 140 + angle * bj_RADTODEG + 33 + time * 4)
					call SetUnitVertexColor(bjLCU, 255, 255, 255, 100)
					call MyRemoveUnit(bjLCU, 1.5)
					set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR99', caster_x + 450 * Cos(angle - ( 90 - time * 11 ) * bj_DEGTORAD), caster_y + 450 * Sin(angle - ( 90 - time * 11 ) * bj_DEGTORAD), 140 + angle * bj_RADTODEG + 33 + time * 4)
					call SetUnitScale(bjLCU, 1.3, 1.3, 1.3)
					call SetUnitVertexColor(bjLCU, 255, 255, 255, 100)
					call MyRemoveUnit(bjLCU, 1.5)
			
                    call SaveInteger(h, id, c_EFFPERIOD, 3)
                else
                    call SaveInteger(h, id, c_EFFPERIOD, eff_period - 1)
                endif
            endif
            set bjLCG=LoadGroupHandle(h, id, c_GROUP1)
            call GroupEnumUnitsInRange(bjLCG, caster_x + 350 * Cos(angle - ( 49 - time * 5 ) * bj_DEGTORAD), caster_y + 350 * Sin(angle - ( 49 - time * 5 ) * bj_DEGTORAD), 400, Base)
            loop
            set bjLCU=FirstOfGroup(bjLCG)
            exitwhen bjLCU == null
                if Condition_Base(GetOwningPlayer(caster) , bjLCU) and IsUnitInGroup(bjLCU, LoadGroupHandle(h, id, c_GROUP2)) == false then
                    if Karna_ModifAttack(caster, bjLCU, damage_factor, damage, 0.6, false) then
                    endif
                    call RengokuW_EW_Act(caster, bjLCU , LoadReal(h, id, 19) , null, 800)
                    call SetControlToUnit(bjLCU, bjLCU, 2.0, "stun")
                    //call RengokuE_Shifting(caster , bjLCU , LoadReal(h, id, 19) , 150 , CreateTimer())
                    //call SlowUnit(caster,bjLCU,0.5,0.5,3,0,false)
					set n=CreateUnit(GetOwningPlayer(caster), 'dAlb', GetUnitX(bjLCU), GetUnitY(bjLCU), 0)
                    call UnitAddAbility(n, 'RenS')
                    call IssueTargetOrder(n, "slow", bjLCU)
                    call MyRemoveUnit(n , 1.25)
					set n=CreateUnit(GetOwningPlayer(caster), 'dR36', GetUnitX(bjLCU), GetUnitY(bjLCU), GetRandomInt(0, 360))
					call SetUnitScale(n, 2, 2, 2)
					call MyRemoveUnit(n, 1.5)
                    set n=CreateUnit(GetOwningPlayer(caster), 'dH04', GetUnitX(bjLCU), GetUnitY(bjLCU), 0)
                    call SetUnitScale(n, 2, 2, 2)
                    call MyRemoveUnit(n, 1.5)
                    call GroupAddUnit(LoadGroupHandle(h, id, c_GROUP2), bjLCU)
                endif
                call GroupRemoveUnit(bjLCG, bjLCU)
            endloop
        endif
    else
        call KillUnit(LoadUnitHandle(h, id, 16))
        call KillUnit(LoadUnitHandle(h, id, 17))
        call KillUnit(LoadUnitHandle(h, id, 18))
		call MyRemoveUnit(LoadUnitHandle(h, id, 16), 1.5)
		call MyRemoveUnit(LoadUnitHandle(h, id, 17), 1.5)
		call MyRemoveUnit(LoadUnitHandle(h, id, 18), 1.5)
        call DestroyGroup(LoadGroupHandle(h, id, c_GROUP1))
        call DestroyGroup(LoadGroupHandle(h, id, c_GROUP2))
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        //call SetUnitTimeScale(LoadUnitHandle(h, id, CasterHash), 1.0)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
	set caster=null
endfunction


function KarnaQ2_WaitTime takes nothing returns nothing 
    local timer   newTimer = GetExpiredTimer()
    local integer id= GetHandleId(newTimer)
	local unit caster=LoadUnitHandle(h, id, c_CASTER)
    local real caster_x= GetUnitX(caster)
    local real caster_y= GetUnitY(caster)
    local real angle= LoadReal(h, id, c_ANGLE)

    call ShakeCamera(0.3 , 10)
    call SetUnitTimeScale(caster, 1.0)

    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR42', caster_x, caster_y, angle*bj_RADTODEG)
	call SetUnitVertexColor(bjLCU, 255, 255, 255, 100)
	call SetUnitFlyHeight(bjLCU, 100, 0)
	call MyRemoveUnit(bjLCU, 1.5)

    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'd119', caster_x - 50 * Cos(angle), caster_y - 50 * Sin(angle), angle * bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 200, 0)
    call SetUnitScale(bjLCU, 3.5, 3.5, 3.5)
    call SetUnitTimeScale(bjLCU, 0.65)
    call SaveUnitHandle(h, id, c_DUMMY1, bjLCU)
    call MyRemoveUnit(bjLCU , 3)
    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'd119', caster_x - 80 * Cos(angle), caster_y - 80 * Sin(angle), angle * bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 200, 0)
    call SetUnitScale(bjLCU, 3.2, 3.2, 3.2)
    call SetUnitTimeScale(bjLCU, 0.65)
    call SaveUnitHandle(h, id, c_DUMMY2, bjLCU)
    call MyRemoveUnit(bjLCU , 3)
    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'd119', caster_x - 130 * Cos(angle), caster_y - 130 * Sin(angle), angle * bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 200, 0)
    call SetUnitScale(bjLCU, 2.8, 2.8, 2.8)
    call SetUnitTimeScale(bjLCU, 0.65)
    call SaveUnitHandle(h, id, c_DUMMY3, bjLCU)
    call MyRemoveUnit(bjLCU , 3)
    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'd119', caster_x - 130 * Cos(angle), caster_y - 130 * Sin(angle), angle * bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 200, 0)
    call SetUnitScale(bjLCU, 2.2, 2.2, 2.2)
    call SetUnitTimeScale(bjLCU, 0.65)
    call SaveUnitHandle(h, id, c_DUMMY4, bjLCU)
    call MyRemoveUnit(bjLCU , 3)
    
	set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dRe9', caster_x+150*Cos(angle), caster_y+150*Sin(angle), angle*bj_RADTODEG)
	call SetUnitScale(bjLCU, 3.25, 3.25, 3.25)
	call SaveUnitHandle(h, id, 16, bjLCU)

	set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dRe9', caster_x+150*Cos(angle), caster_y+150*Sin(angle), angle*bj_RADTODEG)
	call SetUnitScale(bjLCU, 3.75, 3.75, 3.75)
	call SaveUnitHandle(h, id, 17, bjLCU)

	set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dRe9', caster_x+150*Cos(angle), caster_y+150*Sin(angle), angle*bj_RADTODEG)
	call SetUnitScale(bjLCU, 4, 4, 4)
	call SaveUnitHandle(h, id, 18, bjLCU)

    call TimerStart(newTimer, 0.02, true, function KarnaQ2_Periodic)
    set newTimer = null
    set caster   = null
endfunction

function KarnaQ2_Cast takes unit newCaster,real point_x,real point_y returns nothing
    local timer  newTimer = CreateTimer()
    local integer id= GetHandleId(newTimer)
    local integer id_caster= GetHandleId(newCaster)
    local real caster_x= GetUnitX(newCaster)
    local real caster_y= GetUnitY(newCaster)
    local real angle= AP(caster_x , caster_y , point_x , point_y)
    local string RengokuQWE_Comb= "E"
    local real full_damage= GetUnitAbilityLevel(newCaster, 'RenW') * GetHeroAgi(newCaster, true) + 60 * GetUnitAbilityLevel(newCaster, 'RenW') 


    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, 8)
    call SetUnitTimeScale(newCaster, 1.5)
	call RengokuE_Shifting(newCaster, newCaster, angle, SquareRootPoint(caster_x, caster_y, point_x, point_y), CreateTimer())
	
	set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dH05', caster_x, caster_y, angle*bj_RADTODEG)
	call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
	call MyRemoveUnit(bjLCU, 1.5)
	set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dH06', caster_x, caster_y, angle*bj_RADTODEG)
	call SetUnitScale(bjLCU, 1.2, 1.2, 1.2)
	call SetUnitTimeScale(bjLCU, 0.6)
	call SetUnitFlyHeight(bjLCU, 50, 0)
	call MyRemoveUnit(bjLCU, 1.5)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dRe9', caster_x, caster_y, angle*bj_RADTODEG)
	call SetUnitScale(bjLCU, 3.25, 3.25, 3.25)
    call UnitApplyTimedLife(bjLCU, 1, 1.0)
	call MyRemoveUnit(bjLCU, 3.0)

    set soundplay=CreateSound("Sound\\Music\\mp3Music\\KarnaQ2.mp3", false, false, true, 12700, 12700, "")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    

    call SaveUnitHandle(h, id, c_CASTER, newCaster)
    call SaveReal(h, id, c_ANGLE, angle)
    call SaveReal(h, id, 19, angle)
    call SaveReal(h, id, c_DAMAGE, LoadReal(HH, GetHandleId(newCaster), KarnaQ_Damage)) // фулл урон спелла
    call SaveReal(HH, GetHandleId(newCaster), KarnaQ_Damage, 0.0)
    call SaveStr(h, id, 16, RengokuQWE_Comb)
    call SaveGroupHandle(h, id, c_GROUP1, CreateGroup())
    call SaveGroupHandle(h, id, c_GROUP2, CreateGroup())
    call TimerStart(newTimer, 0.45, false, function KarnaQ2_WaitTime)
    set newTimer = null
endfunction

function KarnaQ1_LPeriodic2 takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    caster = LoadUnitHandle(h, id, 0)
    local unit    dummy  = LoadUnitHandle(h, id, 5)
    local real    distance = LoadReal(h, id, 4)
    local real    angle    = LoadReal(h, id, 2)
    local real    damage_factor = LoadReal(h, id, 1) * 0.6
    local real    damage        = GetHeroAgi(caster, true)*GetUnitAbilityLevel(caster, 'KaA3')
    local integer eff_period    = LoadInteger(h, id, 6)
    //set damage = damage + damage*0.3*(damage_factor-1.0)/8.3
    if distance>0 then
		call SetUnitOrientation(LoadUnitHandle(h, id, 105), angle * bj_RADTODEG, -0.0325*distance, 0)
        call SetUnitX(dummy, GetUnitX(dummy)+40*Cos(angle))
        call SetUnitY(dummy, GetUnitY(dummy)+40*Sin(angle))
        call SaveReal(h, id, 4, distance-40)
        call GroupEnumUnitsInRange(G, GetUnitX(dummy), GetUnitY(dummy), 125, Base)
        loop
        set E=FirstOfGroup(G)
        exitwhen E==null
            if Condition_Base(GetOwningPlayer(caster), E) and GetUnitAbilityLevel(E, 'KaAW')==0 then
                // if GetUnitAbilityLevel(caster, 'KaAC')>0 then
                //     call UnitRemoveAbility(caster,'KaAC')
                //     call UnitRemoveAbility(caster,'kaA1')
                //     set damage = damage + GetHeroAgi(caster, true)*2
                //     set n=CreateUnit(GetOwningPlayer(caster), 'd032', GetUnitX(E), GetUnitY(E), GetRandomInt(0, 360))
                //     call SetUnitScale(n, 4, 4, 4)
                //     call SetUnitVertexColor(n, 255, 150, 100, 255)
                //     call SetUnitFlyHeight(n, 100, 0)
                //     call MyRemoveUnit(n, 2.5)
                // endif
                if Karna_ModifAttack(caster, E, damage_factor*0.4, damage*0.4, 0.6, false) then
                    call SetControlToUnit(E, E, 1.0, "stun")
                endif
                call UnitAddAbility(E, 'KaAW')
                call UnitMakeAbilityPermanent(E, true, 'KaAW')
                call UnitRemoveAbilityTimed(E, 'KaAW', 0.2)
                call AGilPush(E,10,angle,50)
                set n=CreateUnit(GetOwningPlayer(caster), 'dAlb', GetUnitX(E), GetUnitY(E), 0)
				call UnitAddAbility(n, 'RenS')
				call IssueTargetOrder(n, "slow", E)
				call MyRemoveUnit(n , 1.25)
            endif
        call GroupRemoveUnit(G, E)
        endloop
			// set n=CreateUnit(GetOwningPlayer(caster), 'd062', GetUnitX(dummy), GetUnitY(dummy), 0)
			// call SetUnitScale(n, 0.2, 0.2, 0.2)
			// call SetUnitFlyHeight(n, 140, 0)
			// call UnitApplyTimedLife(n, 1, 0.3)
			// call MyRemoveUnit(n, 1.7)
			// set n=CreateUnit(GetOwningPlayer(caster), 'd062', GetUnitX(dummy)+20*Cos(angle), GetUnitY(dummy)+20*Sin(angle), 0)
			// call SetUnitScale(n, 0.2, 0.2, 0.2)
			// call SetUnitFlyHeight(n, 140, 0)
			// call UnitApplyTimedLife(n, 1, 0.3)
			// call MyRemoveUnit(n, 1.7)
			// set n=CreateUnit(GetOwningPlayer(caster), 'd062', GetUnitX(dummy)-20*Cos(angle), GetUnitY(dummy)-20*Sin(angle), 0)
			// call SetUnitScale(n, 0.2, 0.2, 0.2)
			// call SetUnitFlyHeight(n, 140, 0)
			// call UnitApplyTimedLife(n, 1, 0.3)
			// call MyRemoveUnit(n, 1.7)

            if eff_period<=0 then
                call KarnaQ_LaserBlast(caster, GetUnitX(dummy), GetUnitY(dummy), damage_factor, false)
                call SaveInteger(h, id, 6, 4)
            else
                call SaveInteger(h, id, 6, eff_period - 1)
            endif
    else
		call SetUnitTimeScale(n, 0.4)
		call KillUnit(LoadUnitHandle(h, id, 105))
        call RemoveUnit(dummy)
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set newTimer = null
    set caster   = null
endfunction

function KarnaQ1_LPeriodic1 takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    caster = LoadUnitHandle(h, id, 0)
    local real    duration = LoadReal(h, id, 3)-0.1
    local real    angle    = LoadReal(h, id, 2)

    if duration>0 then
        call SaveReal(h, id, 3, duration)
    else
        set n=CreateUnit(GetOwningPlayer(caster), 'dM04', GetUnitX(caster)+50*Cos(angle), GetUnitY(caster)+50*Sin(angle), angle * bj_RADTODEG)
        call SetUnitFlyHeight(n, 150, 0)
        call SetUnitScale(n, 0.6, 0.6, 0.6)
        call SetUnitTimeScale(n, 0.7)
        call SetUnitVertexColor(n, 255, 255, 255, 170)
        call MyRemoveUnit(n , 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'd106', GetUnitX(caster)+50*Cos(angle), GetUnitY(caster)+50*Sin(angle), angle * bj_RADTODEG)
        call SetUnitFlyHeight(n, 150, 0)
        call SetUnitScale(n, 0.5, 0.5, 0.5)
		call UnitEnableAutoOrientation(n, false)
		call SaveUnitHandle(h, id, 105, n)
        call MyRemoveUnit(n , 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'dH38', GetUnitX(caster)+50*Cos(angle), GetUnitY(caster)+50*Sin(angle), angle * bj_RADTODEG)
        call SetUnitFlyHeight(n, 150, 0)
        call SetUnitVertexColor(n, 255, 255, 255, 170)
        call MyRemoveUnit(n , 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'dAlb', GetUnitX(caster)+50*Cos(angle), GetUnitY(caster)+50*Sin(angle), 0)
        call SetUnitScale(n, 0.2, 0.2, 0.2)
        call SetUnitFlyHeight(n, 50, 0)
        call SaveUnitHandle(h, id, 5, n)
        call SetUnitFacing(caster, LoadReal(h, id, 2)*bj_RADTODEG)
        call SetUnitTimeScale(caster, 1.0)
        call PauseUnit(caster, false)
        call PauseTimer(newTimer)
        call TimerStart(newTimer, 0.005, true, function KarnaQ1_LPeriodic2)
    endif
    set newTimer = null
    set caster   = null
endfunction

function KarnaQ1_Laser takes unit newCaster, real point_x, real point_y returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local real caster_x  = GetUnitX(newCaster)
    local real caster_y  = GetUnitY(newCaster)
    local real angle     = AP(caster_x, caster_y, point_x, point_y)
    local integer index  = 0
    set soundplay=CreateSound("Sound\\Music\\mp3Music\\KarnaQ_Laser.mp3",false,false,true,12700,12700,"")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)

    call PauseUnit(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, 14)
    call SetUnitTimeScale(newCaster, 3.2)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(h, id, 1, LoadReal(HH, GetHandleId(newCaster), KarnaQ_Damage)) // фулл урон спелла
    call SaveReal(h, id, 2, angle)
    call SaveReal(h, id, 3, 0.5)  // время ожидания первого акта
    call SaveReal(h, id, 4, 2000) // дальность спелла
    call SaveReal(HH, GetHandleId(newCaster), KarnaQ_Damage, 0.0)
    call TimerStart(newTimer, 0.1, true, function KarnaQ1_LPeriodic1)
    set newTimer = null
endfunction
function KarnaW1_Periodic takes nothing returns nothing 
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    caster = LoadUnitHandle(h, id, 0)
    local integer c_id   = GetHandleId(caster)
    local real    duration = LoadReal(h, id, 1)+0.02
    local real    angle    = 0.0
    local group   g_swords = LoadGroupHandle(HH, c_id, KarnaW_Swords)
    local integer index    = 0
    if duration<10.0 and FirstOfGroup(g_swords)!=null then
        if IsUnitPaused(caster)==false then
            call SaveReal(h, id, 1, duration)
        endif
        set bjLCG = CopyGroup(g_swords)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            set angle = LoadReal(HH, GetHandleId(E), 0)
            call SetUnitX(E, GetUnitX(caster)+200*Cos(angle+Deg2Rad(2)))
            call SetUnitY(E, GetUnitY(caster)+200*Sin(angle+Deg2Rad(2)))
            call SetUnitFacing(E, AU(caster, E)*bj_RADTODEG)
            call SaveReal(HH, GetHandleId(E), 0, AU(caster, E))
            call GroupRemoveUnit(bjLCG, E)
        endloop
        call DestroyGroup(bjLCG)
    else
        loop
        set E=FirstOfGroup(g_swords)
        exitwhen E==null
            call RemoveSavedReal(HH, GetHandleId(E), 0)
            call RemoveUnit(E)
            call GroupRemoveUnit(g_swords, E)
        endloop
        call UnitRemoveAbility(caster, 'A0QW')
        call UnitRemoveAbility(caster, 'KaA7')
        call ShowAbility2('KaA6', true)
        if duration>0 then
            call StartAbilityCooldown(GetUnitAbility(caster, 'KaA6'), GetAbilityCooldown(GetUnitAbility(caster, 'KaA6')))
        endif
        call SetUnitAcquireRange(caster, 600)
        call SetUnitAttackRangeByIndex(caster, 0, 200)
        call SetUnitWeaponTypeByIndex(caster, 0, ConvertWeaponType(1))
        call TriggerClearActions(LoadTriggerHandle(h, id, 9))
        call TriggerClearActions(LoadTriggerHandle(h, id, 10))
        call DestroyTrigger(LoadTriggerHandle(h, id, 9))
        //call DestroyTrigger(LoadTriggerHandle(h, id, 10))
        call DestroyGroup(g_swords)
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set newTimer = null
    set caster   = null
    set g_swords = null
endfunction

function KarnaWProjectileCond takes nothing returns boolean
return GetUnitTypeId(GetTriggerProjectileSource())=='HKar' and GetUnitAbilityLevel((GetTriggerProjectileSource()),'A0QW')>0
endfunction
function KarnaWProjectileAct takes nothing returns nothing
call KillProjectile(GetTriggerProjectile())
endfunction

function KarnaWAttackActCond takes nothing returns boolean
return GetUnitTypeId(GetAttacker())=='HKar'
endfunction


function KarnaWAttack_Periodic takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    d_sword  = LoadUnitHandle(h, id, 3)
    local real    angle    = AU(d_sword, LoadUnitHandle(h, id, 2)) //LoadReal(h, id, 6)
    local real    distance = LoadReal(h, id, 5)
    local real    dummy_x  = GetUnitX(d_sword)
    local real    dummy_y  = GetUnitY(d_sword)
    if distance>0 and LoadUnitHandle(h, id, 2)!=null and GetWidgetLife(LoadUnitHandle(h, id, 2))>=1 then
        call SetUnitX(d_sword, dummy_x+60*Cos(angle))
        call SetUnitY(d_sword, dummy_y+60*Sin(angle))
        call SetUnitFacing(d_sword, angle*bj_RADTODEG)
        // call SetUnitX(LoadUnitHandle(h, id, 7), dummy_x+80*Cos(angle))
        // call SetUnitY(LoadUnitHandle(h, id, 7), dummy_y+80*Sin(angle))

        call SaveReal(h, id, 5, distance-60)
        set bjLCG = CreateGroup()
        call GroupEnumUnitsInRange(bjLCG, dummy_x, dummy_y, 100, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            if Condition_Base(GetOwningPlayer(d_sword), E) then
                call SaveReal(h, id, 5, 0)
                call SaveReal(h, id, 6, angle)
                call GroupClear(bjLCG)
                call SetUnitX(d_sword, dummy_x+40*Cos(angle))
                call SetUnitY(d_sword, dummy_y+40*Sin(angle))
            endif
            call GroupRemoveUnit(bjLCG, E)
        endloop
        call DestroyGroup(bjLCG)
    else
        set angle = LoadReal(h, id, 6)
        set n=CreateUnit(GetOwningPlayer(d_sword), 'd052', dummy_x, dummy_y, angle*bj_RADTODEG+120)
        call SetUnitScale(n, 5, 5, 5)
        call SetUnitFlyHeight(n, 150, 0)
        call MyRemoveUnit(n, 2.5)
        set n=CreateUnit(GetOwningPlayer(d_sword), 'dR13', dummy_x, dummy_y, angle*bj_RADTODEG+120)
        call SetUnitScale(n, 0.5, 0.5, 0.5)
        call SetUnitFlyHeight(n, 0, 0)
        call MyRemoveUnit(n, 3.5)
        set n = CreateUnit(GetOwningPlayer(d_sword), 'd111', dummy_x, dummy_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 0.8, 0.8, 0.8)
        call SetUnitTimeScale(n, 0.8)
        call SetUnitFlyHeight(n, 0, 0)
        call SetUnitVertexColor(n, 255, 0, 0, 255)
        call MyRemoveUnit(n, 1.5)
        if LoadBoolean(h, id, 0)==true then //== Эффекты при активной F
            set n=CreateUnit(GetOwningPlayer(d_sword), 'd032', dummy_x, dummy_y, angle*bj_RADTODEG+120)
            call SetUnitScale(n, 2, 2, 2)
            call SetUnitVertexColor(n, 255, 150, 100, 255)
            call SetUnitFlyHeight(n, 100, 0)
            call MyRemoveUnit(n, 2.5)
        endif
        call GroupEnumUnitsInRange(G, dummy_x, dummy_y, 150, Base)
        loop
        set E=FirstOfGroup(G)
        exitwhen E==null
        if Condition_Base(GetOwningPlayer(d_sword), E) then
            if Karna_ModifAttack(LoadUnitHandle(h, id, 1), E, 0.25+GetUnitAbilityLevel(LoadUnitHandle(h, id, 1), 'KaA6')*0.05, LoadReal(h, id, 4), 0.6, true) then
            endif
            call AGilPush(E,10,angle,40)
		elseif IsUnitAlly(E, GetOwningPlayer(LoadUnitHandle(h, id, 1)))==true and GetWidgetLife(E)<=GetWidgetMaxLife(E)*0.1 then
			if Karna_ModifAttack(LoadUnitHandle(h, id, 1), E, 0.25+GetUnitAbilityLevel(LoadUnitHandle(h, id, 1), 'KaA6')*0.05, LoadReal(h, id, 4), 0.6, false) then
            endif
        endif
        call GroupRemoveUnit(G, E)
        endloop
        //call RemoveUnit(LoadUnitHandle(h, id, 7))
        call RemoveUnit(d_sword)
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set newTimer = null
    set d_sword  = null
endfunction

function KarnaWAttack_WaitTime takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    d_sword = LoadUnitHandle(h, id, 3)
    local real    angle   = AU(d_sword, LoadUnitHandle(h, id, 2))
    set n = CreateUnit(GetOwningPlayer(d_sword), 'dR42', GetUnitX(d_sword), GetUnitY(d_sword), angle*bj_RADTODEG)
    call SetUnitScale(n, 0.75, 0.75, 0.75)
	call SetUnitTimeScale(n, 0.75)
	call MyRemoveUnit(n , 1.5)
    // set n = CreateUnit(GetOwningPlayer(d_sword), 'd099', GetUnitX(d_sword), GetUnitY(d_sword), angle*bj_RADTODEG+180)
    // call SetUnitScale(n, 1.5, 1.5, 1.5)
	// call SetUnitFlyHeight(n, GetUnitFlyHeight(d_sword), 0)
    // call SetUnitTimeScale(n, 2.0)
	// call SaveUnitHandle(h, id, 7, n)
    call SetUnitFacingInstant(d_sword, angle*bj_RADTODEG)
    call SaveReal(h, id, 6, angle)
    call TimerStart(newTimer, 0.01, true, function KarnaWAttack_Periodic)
    set newTimer = null
    set d_sword  = null
endfunction

function KarnaWAttackAct takes nothing returns nothing
    local unit source = GetAttacker()
    local unit target = GetTriggerUnit()
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id   = GetHandleId(source)
    local group   g_swords = LoadGroupHandle(HH, c_id, KarnaW_Swords)
    local unit    d_sword  = FirstOfGroup(g_swords)
    local real    damage   = GetHeroAgi(source, true) * (GetUnitAbilityLevel(source, 'KaA6')*0.2)
    if d_sword!=null then
        call GroupRemoveUnit(g_swords, d_sword)
        set n = CreateUnit(GetOwningPlayer(source), 'd110', GetUnitX(d_sword), GetUnitY(d_sword), AU(d_sword, target)*bj_RADTODEG)
        call SetUnitScale(n, 1.0, 1.0, 1.0)
        call SetUnitFlyHeight(n, GetUnitFlyHeight(d_sword), 0)
        call RemoveUnit(d_sword)
        set d_sword = n
        if GetUnitAbilityLevel(source, 'KaAC')>0 then
            call UnitRemoveAbility(source,'KaAC')
            call UnitRemoveAbility(source,'kaA1')
            set damage = damage + GetHeroAgi(source, true)*2
            call SaveBoolean(h, id, 0, true)
        endif
        call SaveUnitHandle(h, id, 1, source)
        call SaveUnitHandle(h, id, 2, target)
        call SaveUnitHandle(h, id, 3, d_sword)
        call SaveReal(h, id, 4, damage)
        call SaveReal(h, id, 5, 10000)
        call TimerStart(newTimer, 0.0, false, function KarnaWAttack_WaitTime)
    else
        call DestroyTimer(newTimer)
    endif
    set source = null
    set target = null
    set g_swords = null
endfunction

function KarnaW1_Cast takes unit newCaster returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id   = GetHandleId(newCaster)
    local real caster_x  = GetUnitX(newCaster)
    local real caster_y  = GetUnitY(newCaster)
    local real angle     = GetUnitFacing(newCaster)*bj_DEGTORAD
    local group g_swords = CreateGroup()
    local integer index  = 1
    local trigger trigger1 = CreateTrigger()
    local trigger trigger2 = CreateTrigger()

    call CreateModeIndicatorKarnaW(newCaster, "ReplaceableTextures\\CommandButtons\\BTNKarnaW1.blp", 10.0)
    set soundplay=CreateSound("Sound\\Music\\mp3Music\\KarnaW1.mp3",false,false,true,12700,12700,"")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)

    loop
	exitwhen index==7
        set n = CreateUnit(GetOwningPlayer(newCaster), 'd114', caster_x+200*Cos(angle+Deg2Rad(index*60)), caster_y+200*Sin(angle+Deg2Rad(index*60)), angle+index*60)
        call SetUnitScale(n, 1.0, 1.0, 1.0)
        //call SetUnitVertexColor(n, 255, 255, 150, 255)
        call SetUnitFacing(n, GetUnitFacing(n)+360)
        call SetUnitFlyHeight(n, 250, 0)
        call GroupAddUnit(g_swords, n)
        call SaveReal(HH, GetHandleId(n), 0, AU(newCaster, n))
        set n = CreateUnit(GetOwningPlayer(newCaster), 'd111', caster_x+200*Cos(angle+Deg2Rad(index*60)), caster_y+200*Sin(angle+Deg2Rad(index*60)), angle+index*60)
        call SetUnitScale(n, 0.8, 0.8, 0.8)
        call SetUnitTimeScale(n, 0.8)
        call SetUnitFlyHeight(n, 0, 0)
        call SetUnitVertexColor(n, 255, 0, 0, 255)
        call MyRemoveUnit(n, 1.5)
    set index = index + 1
	endloop
    
    call UnitAddAbility(newCaster, 'A0QW')
	call UnitMakeAbilityPermanent(newCaster, true, 'A0QW')
    call UnitAddAbility(newCaster, 'KaA7')
	call UnitMakeAbilityPermanent(newCaster, true, 'KaA7')
    call SetUnitAbilityLevel(newCaster, 'KaA7', GetUnitAbilityLevel(newCaster,'KaA6'))
    call ShowAbility2( 'KaA6', false)
    call SaveGroupHandle(HH, c_id, KarnaW_Swords, g_swords)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveTriggerHandle(h, id, 9, trigger1)
    call SaveTriggerHandle(h, id, 10, trigger2)

    //== Триггеры на автоатаку
    call SetUnitAcquireRange(newCaster, 1500)
    call SetUnitAttackRangeByIndex(newCaster, 0, 1500)
    call SetUnitWeaponTypeByIndex(newCaster, 0, ConvertWeaponType(5))

    call TriggerAddAction(trigger1,function KarnaWAttackAct)
    call TriggerAddCondition(trigger1,Condition(function KarnaWAttackActCond))
    call TriggerRegisterAnyUnitEventBJ(trigger1, EVENT_PLAYER_UNIT_ATTACKED)
    if KarnaW1==false then
    call TriggerAddAction(trigger2,function KarnaWProjectileAct)
    call TriggerAddCondition(trigger2,Condition(function KarnaWProjectileCond))
    call TriggerRegisterAnyUnitEventBJ(trigger2, EVENT_PLAYER_UNIT_PROJECTILE_LAUNCH)
    set KarnaW1=true
    else
    call DestroyTrigger(trigger2)
    endif
    call TimerStart(newTimer, 0.02, true, function KarnaW1_Periodic)

    set newTimer = null
    set g_swords = null
    set trigger1 = null
    set trigger2 = null
endfunction


function KarnaW2_Periodic takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    caster = LoadUnitHandle(h, id, -1)
    local integer c_id   = GetHandleId(caster)
    local real    duration = LoadReal(h, id, 10)+0.02
    local real    periodic = LoadReal(h, id, 11)+0.02
    local real    point_x  = LoadReal(h, id, 8)
    local real    point_y  = LoadReal(h, id, 9)
    local real    angle    = 0.0
    local integer index    = LoadInteger(h, id, 7)
    local real    damage   = GetHeroAgi(caster, true) * (0.05+0.15*GetUnitAbilityLevel(caster, 'KaA6'))
    local integer i        = 0

    call SaveReal(h, id, 10, duration)
    if index>=0 then
        loop
        set E=LoadUnitHandle(h, id, i)
        exitwhen i>index
            set angle = LoadReal(HH, GetHandleId(E), 0)
            call SetUnitX(E, point_x+LoadReal(h, id, 12)*Cos(angle+Deg2Rad(3)))
            call SetUnitY(E, point_y+LoadReal(h, id, 12)*Sin(angle+Deg2Rad(3)))
            call SetUnitFacing(E, AP(GetUnitX(E), GetUnitY(E), point_x, point_y)*bj_RADTODEG)
            call SaveReal(HH, GetHandleId(E), 0, AP(point_x, point_y, GetUnitX(E), GetUnitY(E)))
            set i = i + 1
        endloop
    endif

    if duration>=0.5 then
        call SaveReal(h, id, 11, periodic)
        if index>=0 then
            if periodic>0.15 then
                call SaveReal(h, id, 11, 0)
                set E = LoadUnitHandle(h, id, index)
                call SetUnitFlyHeight(E, 0, 3000)
                set angle = LoadReal(HH, GetHandleId(E), 0)
                call RemoveSavedReal(HH, GetHandleId(E), 0)
                call MyRemoveUnit(E, 0.5)
                // call SetUnitX(E, point_x)
                // call SetUnitY(E, point_y)
                set n=CreateUnit(GetOwningPlayer(caster), 'd113', point_x, point_y, angle*bj_RADTODEG)
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call SetUnitFlyHeight(n, 0, 0)
                call MyRemoveUnit(n, 2.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'd115', point_x, point_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 2.5, 2.5, 2.5)
                call SetUnitVertexColor(n, 255, 0, 0, 255)
                call SetUnitFlyHeight(n, 0, 0)
                call MyRemoveUnit(n, 2.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'd111', point_x, point_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call SetUnitVertexColor(n, 255, 0, 0, 255)
                call SetUnitFlyHeight(n, 0, 0)
                call MyRemoveUnit(n, 2.5)
                // set n=CreateUnit(GetOwningPlayer(caster), 'd052', point_x, point_y, GetRandomInt(0, 360))
                // call SetUnitScale(n, 8, 8, 8)
                // call SetUnitFlyHeight(n, 150, 0)
                // call MyRemoveUnit(n, 2.5)
                // set n=CreateUnit(GetOwningPlayer(caster), 'dR13', point_x, point_y, GetRandomInt(0, 360))
                // call SetUnitScale(n, 3.5, 3.5, 3.5)
                // call SetUnitFlyHeight(n, 0, 0)
                // call MyRemoveUnit(n, 3.5)
                 if index==0 then
                    call ShakeCamera(0.1, 15)
                    set n=CreateUnit(GetOwningPlayer(caster), 'dH21', point_x, point_y, GetRandomInt(0, 360))
                    call SetUnitScale(n, 1.5, 1.5, 1.5)
                    call KillUnit(n)
                    call MyRemoveUnit(n, 3.5)
                    set n=CreateUnit(GetOwningPlayer(caster), 'dR41', point_x, point_y, GetRandomInt(0, 360))
                    call SetUnitScale(n, 0.8, 0.8, 0.8)
                    call SetUnitFlyHeight(n, 0, 0)
                    call MyRemoveUnit(n, 3.5)
                else
                    call ShakeCamera(0.1, 10)
                endif
                set bjLCG = CreateGroup()
                call GroupEnumUnitsInRange(bjLCG, point_x, point_y, 400, Base)
                loop
                set E=FirstOfGroup(bjLCG)
                exitwhen E==null
                    if Condition_Base(GetOwningPlayer(caster) , E) then
                        if GetUnitAbilityLevel(caster, 'KaAC')>0 then
                            call UnitRemoveAbility(caster,'KaAC')
                            call UnitRemoveAbility(caster,'kaB1')
                            set damage = damage + GetHeroAgi(caster, true)*2
                            set n=CreateUnit(GetOwningPlayer(caster), 'd032', point_x, point_y, GetRandomInt(0, 360))
                            call SetUnitScale(n, 4, 4, 4)
                            call SetUnitVertexColor(n, 255, 150, 100, 255)
                            call SetUnitFlyHeight(n, 100, 0)
                            call MyRemoveUnit(n, 2.5)
                        endif
                        if Karna_ModifAttack(caster, E, 0.5, damage, 0.3, false) then
                        endif
                        if index==0 then
                            call SetControlToUnit(E, E, 0.5, "stun")
                        else
                            call SetControlToUnit(E, E, 0.1, "stun")
                        endif
                    endif
                call GroupRemoveUnit(bjLCG, E)
                endloop
                call DestroyGroup(bjLCG)
                call SaveInteger(h, id, 7, index-1)
            endif
        else
            call FlushChildHashtable(h, id)
            call DestroyTimer(newTimer)
        endif
    endif

    set newTimer = null
    set caster   = null
endfunction

function KarnaW2_Cast takes unit newCaster, real point_x, real point_y returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id   = GetHandleId(newCaster)
    local real angle     = GetUnitFacing(newCaster)*bj_DEGTORAD
    local group g_swords = LoadGroupHandle(HH, c_id, KarnaW_Swords)
    local integer index  = 0
    local integer i      = 0
    local real    newA   = 0

    set soundplay=CreateSound("Sound\\Music\\mp3Music\\KarnaW2.mp3",false,false,true,12700,12700,"")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)

    loop
    set E=FirstOfGroup(g_swords)
    exitwhen E==null
        call RemoveSavedReal(HH, GetHandleId(E), 0)
        call GroupRemoveUnit(g_swords, E)
        call RemoveUnit(E)
        set index = index + 1
    endloop

    set newA  = 360/index
    loop
    exitwhen i>=index
        set E=CreateUnit(GetOwningPlayer(newCaster), 'd112', point_x+(80+(index*20))*Cos(Deg2Rad(i*newA)), point_y+(80+(index*20))*Sin(Deg2Rad(i*newA)), 0)
        call SetUnitFacingInstant(E, AP(GetUnitX(E), GetUnitY(E), point_x, point_y)*bj_RADTODEG)
        call SetUnitFlyHeight(E, 350, 0)
        call SaveUnitHandle(h, id, i, E)
        call SaveReal(HH, GetHandleId(E), 0, AP(point_x, point_y, GetUnitX(E), GetUnitY(E)))
    set i=i+1
    endloop
    // call BJDebugMsg("count spear1: "+I2S(i))
    // call BJDebugMsg("count spear2: "+I2S(index))
    call SaveUnitHandle(h, id, -1, newCaster)
    call SaveInteger(h, id, 7, index-1)
    call SaveReal(h, id, 8, point_x)
    call SaveReal(h, id, 9, point_y)
    call SaveReal(h, id, 10, 0.0)
    call SaveReal(h, id, 12, 80+(index*20))
    call TimerStart(newTimer, 0.02, true, function KarnaW2_Periodic)
    set newTimer = null
    set g_swords = null
endfunction


function CalculateAngleTriangle takes real height, real length returns real
    // local real angle_y  = Deg2Rad(90.0)                                                             // Угол основной стороны, у нас он всегда 90 градусов
    // local real distance = SquareRoot(Pow(height,2) + Pow(length,2) - 2*height*length*Cos(angle_y))  // Длина отрезка от юнита до точки
    // local real angle_b  = (Pow(distance,2)+Pow(height, 2)-Pow(length,2))/(2*height*distance)
    // call BJDebugMsg(R2S(height))
    // call BJDebugMsg(R2S(length))
    // call BJDebugMsg(R2S(distance))
    // call BJDebugMsg(R2S(MathDistanceBetweenPoints(0, height, length, 0)))
    // call BJDebugMsg(R2S(MathAngleBetweenPoints(0, height, length, 0)))
    // call BJDebugMsg(R2S(angle_b))
    // // call BJDebugMsg(R2S(Cos(angle_b)))
    // call BJDebugMsg(R2S(Rad2Deg(angle_b)))
    return MathAngleBetweenPoints(0, height, length, 0)
    //return (-90+Rad2Deg(angle_b))
endfunction


function KarnaE_Periodic2 takes nothing returns nothing
    local timer   newTimer = GetExpiredTimer()
    local integer id       = GetHandleId(newTimer)
    local unit    caster   = LoadUnitHandle(h, id, CasterHash)
    local integer c_id     = GetHandleId(caster)
    local real    distance = LoadReal(h, id, StringHash("Distance"))
    local real    angle    = LoadReal(h, id,  AngleHash )
    local real    time     = LoadReal(h, id, StringHash("Time"))
    local real    damage   = GetHeroAgi(caster, true)*(2+GetUnitAbilityLevel(caster, 'KaA8'))
    local trigger newTrigger = null
    if time<=2.0 then
        call SetControlToUnit(caster, caster, 0.11, "doom")
        call SaveReal(h, id, StringHash("Time"), time+0.05)


        if time<1.0 then 
            call SetUnitFlyHeight(caster, GetUnitFlyHeight(caster)+90*time, 0)
            call SetUnitX(caster, GetUnitX(caster)+10*Cos(angle))
            call SetUnitY(caster, GetUnitY(caster)+10*Sin(angle))
        endif

        if time==1.5 then
            call ShakeCamera(0.1, 15)
            call SaveReal(h, id, StringHash("Fly"), GetUnitFlyHeight(caster)/(0.5/0.05))
            call SaveReal(h, id, StringHash("Speed"), SquareRootUnit(caster, LoadUnitHandle(HH, c_id, KarnaT_Circle))/(0.5/0.05))
            call SaveReal(h, id,  AngleHash , AU(caster, LoadUnitHandle(HH, c_id, KarnaT_Circle)))
            set angle = AU(caster, LoadUnitHandle(HH, c_id, KarnaT_Circle))
            call SetUnitFacing(caster, angle*bj_RADTODEG)
            set n = CreateUnit(GetOwningPlayer(caster), 'dR26', GetUnitX(caster)+150*Cos(angle), GetUnitY(caster)+150*Sin(angle), angle * bj_RADTODEG)
            call SetUnitFlyHeight(n, GetUnitFlyHeight(caster), 0)
            call UnitScale(n, 0.1, 0.6, 0.5)
            call UnitEnableAutoOrientation(n, false)
            call SetUnitOrientation(n, angle * bj_RADTODEG, CalculateAngleTriangle(GetUnitFlyHeight(caster), SquareRootUnit(caster, LoadUnitHandle(HH, c_id, KarnaT_Circle))), 0)
            call MyRemoveUnit(n, 1.5)

            set n = CreateUnit(GetOwningPlayer(caster), 'dR95', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
            call SetUnitFlyHeight(n, GetUnitFlyHeight(caster), 0)
            call SetUnitScale(n, 0.8, 0.8, 0.8)
            call UnitEnableAutoOrientation(n, false)
            call SetUnitOrientation(n, angle * bj_RADTODEG, CalculateAngleTriangle(GetUnitFlyHeight(caster), SquareRootUnit(caster, LoadUnitHandle(HH, c_id, KarnaT_Circle))), 0)
            call MyRemoveUnit(n, 1.5)
            set n = CreateUnit(GetOwningPlayer(caster), 'd125', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
            call SetUnitFlyHeight(n, GetUnitFlyHeight(caster), 0)
            call SetUnitScale(n, 2, 2, 2)
            call UnitEnableAutoOrientation(n, false)
            call SetUnitOrientation(n, angle * bj_RADTODEG, CalculateAngleTriangle(GetUnitFlyHeight(caster), SquareRootUnit(caster, LoadUnitHandle(HH, c_id, KarnaT_Circle)))-90, 0)
            call MyRemoveUnit(n, 1.5)
            set n = CreateUnit(GetOwningPlayer(caster), 'dM04', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
            call SetUnitFlyHeight(n, GetUnitFlyHeight(caster), 0)
            call SetUnitScale(n, 2, 2, 2)
            call UnitEnableAutoOrientation(n, false)
            call SetUnitOrientation(n, angle * bj_RADTODEG, CalculateAngleTriangle(GetUnitFlyHeight(caster), SquareRootUnit(caster, LoadUnitHandle(HH, c_id, KarnaT_Circle)))-90, 0)
            call MyRemoveUnit(n, 1.5)
        endif

        if time>1.5 then
            call SetUnitX(caster, GetUnitX(caster)+LoadReal(h, id, StringHash("Speed"))*Cos(angle))
            call SetUnitY(caster, GetUnitY(caster)+LoadReal(h, id, StringHash("Speed"))*Sin(angle))
            call SetUnitFlyHeight(caster, GetUnitFlyHeight(caster)-LoadReal(h, id, StringHash("Fly")), 0)
            // set n = LoadUnitHandle(h, id, StringHash("EffectUnit"))
            // call SetUnitX(n, GetUnitX(caster))
            // call SetUnitY(n, GetUnitY(caster))
            // call SetUnitFlyHeight(n, GetUnitFlyHeight(caster), 0)

            call RemoveUnit(LoadUnitHandle(HH, c_id, KarnaT_Circle))
            call RemoveSavedHandle(HH, c_id, KarnaT_Circle)
            set newTrigger = LoadTriggerHandle(h, id, 99)
            call TriggerClearActions(newTrigger)
            call DestroyTrigger(newTrigger)
        endif

        set bjLCG = CopyGroup(LoadGroupHandle(h, id,  GroupHash ))
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            call SetUnitFlyHeight(E, GetUnitFlyHeight(caster), 0)
            call SetUnitX(E, GetUnitX(caster)+70*Cos(LoadReal(HH, GetHandleId(E), KarnaE_Index)))
            call SetUnitY(E, GetUnitY(caster)+70*Sin(LoadReal(HH, GetHandleId(E), KarnaE_Index)))
            call PauseUnit(E, true)
            call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,true)
            // call SetControlToUnit(E, E, 0.11, "doom")
            // call SetControlToUnit(E, E, 0.11, "stun")
        call GroupRemoveUnit(bjLCG, E)
        endloop
        call DestroyGroup(bjLCG)

    else
        set n=CreateUnit(GetOwningPlayer(caster), 'dH21', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call KillUnit(n)
        call MyRemoveUnit(n, 3.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'dR41', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
        call SetUnitScale(n, 1.0, 1.0, 1.0)
        call SetUnitFlyHeight(n, 5, 0)
        call MyRemoveUnit(n, 3.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'dR41', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
        call SetUnitScale(n, 1.2, 1.2, 1.2)
        call SetUnitFlyHeight(n, 0, 0)
        call MyRemoveUnit(n, 3.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'd125', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
        call SetUnitScale(n, 3, 3, 3)
        call SetUnitFlyHeight(n, 0, 0)
        call MyRemoveUnit(n, 3.5)

        call ShakeCamera(0.1, 15)
        call SetUnitFlyHeight(caster, 0, 0)
        set bjLCG = CopyGroup(LoadGroupHandle(h, id,  GroupHash ))
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            call SetUnitFlyHeight(E, 0, 0)
            call PauseUnit(E, false)
            call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,false)
            call RemoveSavedReal(HH, GetHandleId(E), KarnaE_Index)
        call GroupRemoveUnit(bjLCG, E)
        endloop
        call DestroyGroup(bjLCG)

        set bjLCG = CreateGroup()
        call GroupEnumUnitsInRange(bjLCG, GetUnitX(caster), GetUnitY(caster), 500, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            if Condition_Base(GetOwningPlayer(caster), E) then
                
                call myCustomDamage(caster, E, damage, false,false,null,null,null)
                call SetControlToUnit(E, E, 2.0, "stun")
            endif
        call GroupRemoveUnit(bjLCG, E)
        endloop
        call DestroyGroup(bjLCG)

        call DestroyEffect(LoadEffectHandle(h, id, StringHash("Effect0")))
        call UnitRemoveAbility(caster, 'A1FU') //Slow
        call UnitRemoveAbility(caster, 'Pet1')
        call SetUnitAcquireRange(caster, 600)
        call UnitRemoveAbility(caster, 'B00A')
        call DestroyGroup(LoadGroupHandle(h, id,  GroupHash ))
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call SetUnitVertexColor(caster, 255, 255, 255, 255)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
    set newTimer=null
    set newTrigger=null
endfunction

function KarnaE_StopOrders2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    call IssueImmediateOrder(u,"stop")
    call SetUnitFacing(u,Atan2(LoadReal(h,id,1)-GetUnitY(u),LoadReal(h,id,2)-GetUnitX(u))*bj_RADTODEG)
    //call SetUnitAnimationByIndex(u, 17)
    call FlushChildHashtable(h,id)
    call DestroyTimer(t)
    set t=null
    set u=null
endfunction

function KarnaE_StopOrders takes nothing returns nothing
    local unit u=GetOrderedUnit()
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    call SaveUnitHandle(h,id,0,u)
    if GetOrderTargetUnit()==null then
        call SaveReal(h,id,2,GetOrderPointX())
        call SaveReal(h,id,1,GetOrderPointY())
    else
        call SaveReal(h,id,2,GetUnitX(GetOrderTargetUnit()))
        call SaveReal(h,id,1,GetUnitY(GetOrderTargetUnit()))
    endif
    if SquareRootPoint(GetUnitX(u), GetUnitY(u), LoadReal(h,id,2), LoadReal(h,id,1))>1200 then
        call SaveReal(h,id,2,GetUnitX(u)+1200*Cos(AP(GetUnitX(u), GetUnitY(u), LoadReal(h,id,2), LoadReal(h,id,1))))
        call SaveReal(h,id,1,GetUnitY(u)+1200*Sin(AP(GetUnitX(u), GetUnitY(u), LoadReal(h,id,2), LoadReal(h,id,1))))
    endif
    call SetUnitX(LoadUnitHandle(HH, GetHandleId(u), KarnaT_Circle), LoadReal(h, id, 2))
    call SetUnitY(LoadUnitHandle(HH, GetHandleId(u), KarnaT_Circle), LoadReal(h, id, 1))
    call TimerStart(t,0.001,false,function KarnaE_StopOrders2)
    set u=null
    set t=null
endfunction

function KarnaE_Periodic1 takes nothing returns nothing
    local timer   newTimer = GetExpiredTimer()
    local integer id       = GetHandleId(newTimer)
    local real    distance = LoadReal(h, id, StringHash("Distance"))
    local real    angle    = LoadReal(h, id,  AngleHash )
    local unit    caster   = LoadUnitHandle(h, id, CasterHash)
    local trigger newTrigger = null

    if distance < 1200 and LoadBoolean(HH,GetHandleId(caster),DASH_USER)==true then
        call SetUnitX(caster, GetUnitX(caster) + 45 * Cos(angle))
        call SetUnitY(caster, GetUnitY(caster) + 45 * Sin(angle))
        call SetUnitX(LoadUnitHandle(h, id, StringHash("EffectUnit")), GetUnitX(caster)-100*Cos(angle))
        call SetUnitY(LoadUnitHandle(h, id, StringHash("EffectUnit")), GetUnitY(caster)-100*Sin(angle))
        call SaveReal(h, id, StringHash("Distance"), distance + 45)
        if LoadInteger(h, id,  EffectPeriodHash ) == 0 then
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dM11', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
            call SetUnitFlyHeight(bjLCU, 150, 0)
            call SetUnitVertexColor(bjLCU, 255, 255, 255, 140)
            call SetUnitScale(bjLCU, 0.6, 0.6, 0.6)
            call MyRemoveUnit(bjLCU , 1.5)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dM29', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
            call SetUnitVertexColor(bjLCU, 255, 255, 255, 180)
            call MyRemoveUnit(bjLCU , 1.5)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'd117', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG - 180)
            call SetUnitVertexColor(bjLCU, 255, 255, 255, 180)
            call SetUnitScale(bjLCU, 0.7, 0.7, 0.7)
            call SetUnitFlyHeight(bjLCU, 25, 0)
            call MyRemoveUnit(bjLCU , 1.5)
            call SaveInteger(h, id,  EffectPeriodHash , 2)
        else
            call SaveInteger(h, id,  EffectPeriodHash , LoadInteger(h, id,  EffectPeriodHash ) - 1)
        endif
        set bjLCG = CreateGroup() //LoadGroupHandle(h, id,  GroupHash )
        call GroupEnumUnitsInRange(bjLCG, GetUnitX(caster)+100*Cos(angle), GetUnitY(caster)+100*Sin(angle), 150, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            if Condition_Base(GetOwningPlayer(caster), E) and IsUnitInGroup(E, LoadGroupHandle(h, id,  GroupHash ))==false then
                if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
                    if IsUnitInvulnerable(E)==false then
                        call GroupAddUnit(LoadGroupHandle(h, id,  GroupHash ), E)
                        call SaveReal(HH, GetHandleId(E), KarnaE_Index, AU(caster, E))
                    endif
                else
                    call SaveBoolean(HH,GetHandleId(caster),DASH_USER,false)
                    call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,caster)
                    call MyRemoveUnit(LoadUnitHandle(h, id, StringHash("EffectUnit")), 1.5)
                    call DestroyEffect(LoadEffectHandle(h, id, StringHash("Effect0")))
                    call DestroyGroup(LoadGroupHandle(h, id,  GroupHash ))
                    call PauseUnit(caster, false)
                    call SetUnitInvulnerable(caster, false)
                    call SetUnitVertexColor(caster, 255, 255, 255, 255)
                    call FlushChildHashtable(h, id)
                    call DestroyTimer(GetExpiredTimer())
                endif
            endif
        call GroupRemoveUnit(bjLCG, E)
        endloop
        call DestroyGroup(bjLCG)
        set bjLCG = CopyGroup(LoadGroupHandle(h, id,  GroupHash ))
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            call SetUnitX(E, GetUnitX(caster)+70*Cos(LoadReal(HH, GetHandleId(E), KarnaE_Index)))
            call SetUnitY(E, GetUnitY(caster)+70*Sin(LoadReal(HH, GetHandleId(E), KarnaE_Index)))
        call GroupRemoveUnit(bjLCG, E)
        endloop
        call DestroyGroup(bjLCG)
        //KarnaE_Index
    else
        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dM30', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
        call SetUnitScale(bjLCU, 0.85, 0.85, 0.85)
        call SetUnitVertexColor(bjLCU, 255, 255, 255, 200)
        call MyRemoveUnit(bjLCU , 1.5)
        if FirstOfGroup(LoadGroupHandle(h, id,  GroupHash ))==null then
            if LoadBoolean(h, GetHandleId(caster), KarnaF_Reload) then
                call StartAbilityCooldown(GetUnitAbility(caster, 'KaA8'), GetAbilityRemainingCooldown(GetUnitAbility(caster, 'KaA8'))*0.5)
            endif
            call MyRemoveUnit(LoadUnitHandle(h, id, StringHash("EffectUnit")), 1.5)
            call DestroyEffect(LoadEffectHandle(h, id, StringHash("Effect0")))
            call DestroyGroup(LoadGroupHandle(h, id,  GroupHash ))
            call SaveBoolean(HH,GetHandleId(caster),DASH_USER,false)
            call PauseUnit(caster, false)
            call SetUnitInvulnerable(caster, false)
            call SetUnitVertexColor(caster, 255, 255, 255, 255)
            call FlushChildHashtable(h, id)
            call DestroyTimer(GetExpiredTimer())
        else
            call SaveBoolean(HH,GetHandleId(caster),DASH_USER,false)
            call RemoveUnit(LoadUnitHandle(h, id, StringHash("EffectUnit")))
            set n = CreateUnit(GetOwningPlayer(caster), 'dR26', GetUnitX(caster)+150*Cos(angle), GetUnitY(caster)+150*Sin(angle), angle * bj_RADTODEG)
            call SetUnitFlyHeight(n, 75, 0)
            call UnitScale(n, 0.1, 0.6, 0.5)
            call UnitEnableAutoOrientation(n, false)
            call SetUnitOrientation(n, angle * bj_RADTODEG, -280, 0)
            call MyRemoveUnit(n, 1.5)
            set n = CreateUnit(GetOwningPlayer(caster), 'dR95', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
            call SetUnitFlyHeight(n, 0, 0)
            call SetUnitScale(n, 0.7, 0.7, 0.7)
            call UnitEnableAutoOrientation(n, false)
            call SetUnitOrientation(n, angle * bj_RADTODEG, -280, 0)
            call MyRemoveUnit(n, 1.5)

            set n = CreateUnit(GetOwningPlayer(caster), 'd130', GetUnitX(caster)+800*Cos(angle), GetUnitY(caster)+800*Sin(angle), 0)
            call UnitScale(n, 1.0, 3.0, 0.5)
            call SaveUnitHandle(HH, GetHandleId(caster), KarnaT_Circle, n)
            call PauseUnit(caster, false)
            set bjLCG = CopyGroup(LoadGroupHandle(h, id,  GroupHash ))
            loop
            set E=FirstOfGroup(bjLCG)
            exitwhen E==null
                call UnitAddAbility(E, 'Arav')
                call UnitRemoveAbility(E, 'Arav')
            call GroupRemoveUnit(bjLCG, E)
            endloop
            call DestroyGroup(bjLCG)
            call SaveReal(h, id, StringHash("Time"), 0.0)
            call SaveReal(h, id, StringHash("Fly"),  0.0)
            call PauseTimer(GetExpiredTimer())
            call TimerStart(GetExpiredTimer(), 0.02, true, function KarnaE_Periodic2)
            set newTrigger = CreateTrigger()
            call SetUnitAcquireRange(caster, 51)
            call UnitAddAbility(caster, 'A1FU') //Slow
            call UnitAddAbility(caster, 'Pet1')
            call TriggerRegisterUnitEvent(newTrigger, caster, EVENT_UNIT_ISSUED_TARGET_ORDER)
            call TriggerRegisterUnitEvent(newTrigger, caster, EVENT_UNIT_ISSUED_POINT_ORDER)
            call TriggerAddAction(newTrigger,function KarnaE_StopOrders)
            call SaveTriggerHandle(h, id, 99, newTrigger)
        endif
    endif
    set caster=null
    set newTimer=null
    set newTrigger=null
endfunction

function KarnaE_WaitTime takes nothing returns nothing
    local timer   newTimer = GetExpiredTimer()
    local integer id       = GetHandleId(newTimer)
    local real    distance = LoadReal(h, id, StringHash("Distance"))
    local real    angle    = LoadReal(h, id,  AngleHash )
    local unit    caster   = LoadUnitHandle(h, id, CasterHash)
    local real    caster_x = GetUnitX(caster)
    local real    caster_y = GetUnitY(caster)
    local real    waittime = LoadReal(h, id, StringHash("Wait"))-0.05
    if waittime>0.0 then
        call SaveReal(h, id, StringHash("Wait"), waittime)
        if LoadInteger(h, id,  EffectPeriodHash ) == 0 then
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'd118', caster_x, caster_y, GetRandomInt(0, 360))
            call SetUnitVertexColor(bjLCU, 255, 255, 255, 180)
            call SetUnitScale(bjLCU, 0.5, 0.5, 0.5)
            call SetUnitTimeScale(bjLCU, 1.5)
            call SetUnitFlyHeight(bjLCU, 10, 0)
            call MyRemoveUnit(bjLCU , 1.5)
            call SaveInteger(h, id,  EffectPeriodHash , 3)
        else
            call SaveInteger(h, id,  EffectPeriodHash , LoadInteger(h, id,  EffectPeriodHash ) - 1)
        endif
    else
        call ShakeCamera(0.1, 10)
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\KarnaE2.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)

        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dM04', caster_x, caster_y, angle * bj_RADTODEG)
        call SetUnitFlyHeight(bjLCU, 150, 0)
        call SetUnitScale(bjLCU, 0.8, 0.8, 0.8)
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dM11', caster_x, caster_y, angle * bj_RADTODEG)
        call SetUnitFlyHeight(bjLCU, 150, 0)
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR95', caster_x, caster_y, angle * bj_RADTODEG)
        call SetUnitFlyHeight(bjLCU, 0, 0)
        call SetUnitScale(bjLCU, 0.8, 0.8, 0.8)
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR26', caster_x, caster_y, angle * bj_RADTODEG)
        call SetUnitFlyHeight(bjLCU, 0, 0)
        call SetUnitScale(bjLCU, 0.6, 0.6, 0.6)
        call SaveUnitHandle(h, id, StringHash("EffectUnit"), bjLCU)
        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dM30', caster_x, caster_y, angle * bj_RADTODEG)
        call SetUnitScale(bjLCU, 0.85, 0.85, 0.85)
        call SetUnitVertexColor(bjLCU, 255, 255, 255, 200)
        call MyRemoveUnit(bjLCU , 1.5)
        call SetUnitVertexColor(caster, 255, 255, 255, 110)
        call SaveBoolean(HH,GetHandleId(caster),DASH_USER,true)
        call PauseTimer(newTimer)
        call TimerStart(newTimer, 0.01, true, function KarnaE_Periodic1)
    endif
    set newTimer = null
    set caster   = null
endfunction

function KarnaE_Cast takes unit newCaster, real point_x, real point_y returns nothing
    local timer   newTimer = CreateTimer()
    local integer id    = GetHandleId(newTimer)
    local real caster_x = GetUnitX(newCaster)
    local real caster_y = GetUnitY(newCaster)
    local real angle    = AtanPoint(caster_x , caster_y , point_x , point_y)
	local real distance = 0
    set soundplay=CreateSound("Sound\\Music\\mp3Music\\KarnaE1.mp3",false,false,true,12700,12700,"")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)

    set bjLCE = AddSpecialEffectTarget("Karna_Wings.mdl", newCaster, "chest")
    call SaveEffectHandle(h, id, StringHash("Effect0"), bjLCE)
    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, 6)
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call SaveReal(h, id,  AngleHash , angle)
	call SaveReal(h, id, StringHash("Distance"), distance)
    if LoadBoolean(h, GetHandleId(newCaster), KarnaF_Reload)==false then
        call SaveReal(h, id, StringHash("Wait"), 0.8)
    else
        call SaveReal(h, id, StringHash("Wait"), 0.0)
    endif
    call SaveGroupHandle(h, id,  GroupHash , CreateGroup())
    call TimerStart(newTimer, 0.05, true, function KarnaE_WaitTime)
    set newTimer = null
endfunction
function KarnaR_Periodic takes nothing returns nothing
	local timer t=GetExpiredTimer()
	local integer id=GetHandleId(t)
	local unit u=LoadUnitHandle(h,id,0)
	local unit l__d=LoadUnitHandle(h,id,1)
	local player p=GetOwningPlayer(u)
	local integer idu=GetPlayerId(p)
	local real x=LoadReal(h,id,3)
	local real y=LoadReal(h,id,4)
	local real x1=GetUnitX(l__d)
	local real y1=GetUnitY(l__d)
	local real f=GetUnitFacing(l__d)
	local real a=LoadReal(h,id,8)
	local real dmg=GetHeroAgi(u,true)*12
	local real Range=LoadReal(h,id,9)
	local real speed=LoadReal(h,id,11)
	local integer i=0
	if Range<4000 and UnitIsAlive(l__d)then
		set x1=x1+speed*Cos(a)
		set y1=y1+speed*Sin(a)
		// if Range>1000 then
			// set a=a*GetRandomReal(0.95, 1.05)
			// call SaveReal(h, id, 8, a)
		// endif
		call SetUnitXY_1(l__d,x1,y1, false)
		call SetUnitXY_1(LoadUnitHandle(h, id, 20),x1,y1, false)
		call SaveReal(h,id,3,x1)
		call SaveReal(h,id,4,y1)
		call SetUnitFacing(l__d,a*bj_RADTODEG)
		call SaveReal(h,id,9,Range+speed)
		call SaveReal(h,id,11,speed+2)
		call GroupEnumUnitsInRange(DG,x1,y1,150,Base)
		loop
		set E=FirstOfGroup(DG)
		exitwhen E==null
			if Condition_Base(p,E)then
				call RemoveUnit(l__d)
			endif
		call GroupRemoveUnit(DG,E)
		endloop
	else
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\KarnaR_Blast.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
		call ShakeCamera(0.2, 15)
		call GroupEnumUnitsInRange(DG,x,y,800,Base)
		loop
		set E=FirstOfGroup(DG)
		exitwhen E==null
			if Condition_Base(p,E)then
                if GetWidgetLife(E)/GetWidgetMaxLife(E) < GetWidgetLife(u)/GetWidgetMaxLife(u) then
                    set dmg = GetWidgetMaxLife(E) * (GetWidgetLife(u)/GetWidgetMaxLife(u) - GetWidgetLife(E)/GetWidgetMaxLife(E))
                    set dmg = dmg * (0.10*GetUnitAbilityLevel(u, 'KaAA'))
                    //call UnitAddAbility(E,'A0WR')
                    //call DamageIndicatorFunction(u, E, dmg)
                    call myCustomDamage(u,E, GetHeroAgi(u, true)*5+dmg, false,false,null,null,null)
                    //call UnitRemoveAbility(E,'A0WR')
                else
                    call myCustomDamage(u,E, GetHeroAgi(u, true)*5, false,false,null,null,null)
                endif
			endif
		call GroupRemoveUnit(DG,E)
		endloop
        set n=CreateUnit(p,'kaTB',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,1,3.5)
        set n=CreateUnit(p,'kaTD',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,1,3.5)
        set n=CreateUnit(p,'kaTC',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,1,3.5)
        set n=CreateUnit(p,'kaTG',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,1,3.5)
        call SetUnitTimeScale(n,1)
		// set n = CreateUnit(GetOwningPlayer(u), 'dR28', x,y, GetRandomInt(0, 360))
        // call SetUnitScale(n, 1.5, 1.5, 1.5)
        // call MyRemoveUnit(n, 3.5)
		// set n = CreateUnit(GetOwningPlayer(u), 'dRe9', x,y, GetRandomInt(0, 360))
        // call SetUnitScale(n, 5, 5, 5)
        // call UnitApplyTimedLife(n, 1, 2.0)
        // call MyRemoveUnit(n, 3.5)
		// set n = CreateUnit(GetOwningPlayer(u), 'dRe9', x,y, GetRandomInt(0, 360))
        // call SetUnitScale(n, 10, 10, 10)
        // call UnitApplyTimedLife(n, 1, 2.0)
        // call MyRemoveUnit(n, 3.5)
		// set n = CreateUnit(GetOwningPlayer(u), 'dR12', x,y, GetRandomInt(0, 360))
        // call SetUnitScale(n, 3, 3, 3)
        // call UnitApplyTimedLife(n, 1, 2.0)
        // call MyRemoveUnit(n, 3.5)
		call KillUnit(l__d)
        call MyRemoveUnit(l__d, 1.5)
		call RemoveUnit(LoadUnitHandle(h, id, 20))
		call FlushChildHashtable(h,id)
		call PauseTimer(t)
		call DestroyTimer(t)
	endif
	set u=null
	set p=null
	set t=null
	set l__d=null
endfunction

function KarnaR_WaitTimer takes nothing returns nothing
	local timer t=GetExpiredTimer()
	local integer id=GetHandleId(t)
	local unit u=LoadUnitHandle(h,id,0)
	local player p=GetOwningPlayer(u)
	local real x=GetUnitX(u)
	local real y=GetUnitY(u)
	local real a=LoadReal(h,id,8)
	local integer time=LoadInteger(h, id, 20)
	call SaveInteger(h, id, 20, time+1)
	if time==1 then
		call ShakeCamera(0.1, 5)
		call SaveReal(h, id, 8, a)
		call SetUnitFacing(u, a*bj_RADTODEG)
		//call SetUnitAnimationByIndex(u, 16)
		// set soundplay=CreateSound("Sound\\Music\\mp3Music\\LanzaDelRelampagoThrow.mp3",false,false,true,12700,12700,"")
		// call StartSound(soundplay)
		// call KillSoundWhenDone(soundplay)
	elseif time==2 then
		call ShakeCamera(0.1, 10)
		call SetUnitTimeScale(u, 1.0)
		set n=CreateUnit(GetOwningPlayer(u),'dM04',x,y,a*bj_RADTODEG)
		call MyRemoveUnit(n, 1.5)
		set n=CreateUnit(GetOwningPlayer(u),'dM11',x,y,a*bj_RADTODEG)
		call SetUnitVertexColor(n, 255, 255, 255, 200)
		call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(u),'d116', x+50*Cos(a), y+50*Sin(a), a*bj_RADTODEG)
        call SetUnitFlyHeight(n, 150, 0)
        call UnitApplyTimedLife(n, 1, 0.2)
        call SetUnitTimeScale(n, 1.4)
        call MyRemoveUnit(n, 1.5)
		set n=CreateUnit(GetOwningPlayer(u),'d116',x,y,a*bj_RADTODEG)
        //call SetUnitScale(n, 1.5, 1.5, 1.5)
        call SetUnitFlyHeight(n, 150, 0)
        call SetUnitAnimation(n, "Spell One")
		call SaveUnitHandle(h,id,1,n)
		set n=CreateUnit(GetOwningPlayer(u),'d110',x,y,a*bj_RADTODEG)
        call SetUnitScale(n, 1.2, 1.2, 1.2)
        call SetUnitFlyHeight(n, 150, 0)
        //call SetUnitVertexColor(n, 255, 255, 150, 255)
		call SaveUnitHandle(h,id,20,n)
		call PauseUnit(u, false)
		call SetUnitInvulnerable(u, false)
		call PauseTimer(t)
		call TimerStart(t,0.02,true,function KarnaR_Periodic)
	endif
	set t=null
	set u=null
	set p=null
endfunction

function KarnaR_Cast takes unit u, real x1, real y1 returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real a=Atan2(y1-y,x1-x)
    local player p=GetOwningPlayer(u)
    set soundplay=CreateSound("Sound\\Music\\mp3Music\\KarnaR_Start.mp3",false,false,true,12700,12700,"")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    set n=CreateUnit(p, 'dM30', x, y, GetRandomInt(0, 360))
    //call SetUnitVertexColor(n, 255, 255, 10, 255)
    call MyRemoveUnit(n, 1.5)
    set n=CreateUnit(p, 'dM30', x, y, GetRandomInt(0, 360))
    //call SetUnitVertexColor(n, 255, 255, 10, 255)
    call SetUnitScale(n, 1.5, 1.5, 1.5)
    call MyRemoveUnit(n, 1.5)
    set n=CreateUnit(p, 'dM32', x, y, GetRandomInt(0, 360))
    call SetUnitVertexColor(n, 255, 255, 255, 100)
    call UnitScale(n, 0.5, 1.7, 0.5)
    call UnitApplyTimedLife(n, 1, 1.0)
    call MyRemoveUnit(n, 1.5)
    call PauseUnit(u, true)
    call SetUnitInvulnerable(u, true)
    call SetUnitAnimationByIndex(u, 15)
    //call SetUnitTimeScale(u, 4.0)
    call SaveUnitHandle(h,id,0,u)
    call SaveReal(h,id,3,x)
    call SaveReal(h,id,4,y)
    call SaveReal(h,id,8,a)
    call SaveReal(h,id,11,50)
    call RemoveEffect(AddSpecialEffectTarget("KarnaWeaponW2.mdl", u, "right hand"), 0.8, true, CreateTimer())
    call TimerStart(t,0.2,true,function KarnaR_WaitTimer)
    set u=null
    set p=null
    set t=null
endfunction

function KarnaT_FReloadEnd takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    caster = LoadUnitHandle(h, id, 0)
    call SaveBoolean(h, GetHandleId(caster), KarnaF_Reload, false)
    call FlushChildHashtable(h, id)
    call DestroyTimer(newTimer)
    set newTimer = null
endfunction

function KarnaT_StartFReload takes unit newCaster, real duration returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id   = GetHandleId(newCaster)
    call CreateModeIndicatorForm(newCaster, "ReplaceableTextures\\CommandButtons\\BTNKarnaT.blp", duration)
    call SaveBoolean(h, c_id, KarnaF_Reload, true)
    call SaveUnitHandle(h, id, 0, newCaster)
    call TimerStart(newTimer, duration, false, function KarnaT_FReloadEnd)
    set newTimer = null
endfunction

function KarnaT_Periodic2 takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id   = GetHandleId(LoadUnitHandle(h, id, 0))
    local unit    caster = LoadUnitHandle(h, id, 0)
    local real    point_x = LoadReal(h, id, 6)
    local real    point_y = LoadReal(h, id, 7)
    local real    angle    = GetUnitFacing(caster)*bj_DEGTORAD
    local real    duration = LoadReal(h, id, 1)-0.5
    local real    damage   = GetHeroAgi(caster, true)*8 / 4

    if duration>=0 then
        call SaveReal(h, id, 1, duration)
        call SetUnitInvulnerable(caster, true)

        // set n = CreateUnit(GetOwningPlayer(caster), 'dR12', point_x, point_y, angle*bj_RADTODEG)
        // call SetUnitScale(n, 5, 5, 5)
        // call UnitApplyTimedLife(n, 1, 5.0)
        // call MyRemoveUnit(n, 9.0)
        // set n = CreateUnit(GetOwningPlayer(caster), 'd105', point_x, point_y, 45)
        // call SetUnitScale(n, 10, 10, 10)
        // call UnitApplyTimedLife(n, 1, 5.0)
        // call MyRemoveUnit(n, 9.0)
        // set n = CreateUnit(GetOwningPlayer(caster), 'd105', point_x, point_y, 90)
        // call SetUnitScale(n, 10, 10, 10)
        // call UnitApplyTimedLife(n, 1, 5.0)
        // call MyRemoveUnit(n, 9.0)

        set n = CreateUnit(GetOwningPlayer(caster), 'd125', point_x, point_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 5, 5, 5)
        call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd125', point_x, point_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 5, 5, 5)
        call SetUnitFlyHeight(n, 500, 0)
        call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd125', point_x, point_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 5, 5, 5)
        call SetUnitFlyHeight(n, 800, 0)
        call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'dR13', point_x, point_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 8, 8, 8)
        call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'dR13', point_x, point_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 8, 8, 8)
        call SetUnitFlyHeight(n, 500, 0)
        call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'dR13', point_x, point_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 8, 8, 8)
        call SetUnitFlyHeight(n, 800, 0)
        call MyRemoveUnit(n, 5.0)

        set bjLCG = CreateGroup()
        call GroupEnumUnitsInRange(bjLCG, point_x, point_y, 800, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            if Condition_Base(GetOwningPlayer(caster), E) then
                call IssueImmediateOrder(E,"stop")
                call myCustomDamage(caster, E, damage, false, false, null, null, null)
                call SetControlToUnit(E,E,0.1,"stun")
                if GetUnitAbilityLevel(E, 'KaAD')==0 then
                    //call Essence(caster, E, 10)
                    call ReduceHeal(caster, E, 0.5, 30)
                    call UnitAddAbility(E, 'KaAD')
                    call UnitMakeAbilityPermanent(E, true, 'KaAD')
                    call UnitRemoveAbilityTimed(E, 'KaAD', 2.5)
                endif
            endif
        call GroupRemoveUnit(bjLCG, E)
        endloop
        call DestroyGroup(bjLCG)
    else
        call KarnaT_StartFReload(caster, 20.0)
        call KarnaD_AddStack(caster)
        call SetUnitOrientation(caster, angle * bj_RADTODEG, 0, 0)
        call UnitEnableAutoOrientation(caster, true)
        

        set n = CreateUnit(GetOwningPlayer(caster), 'dR41', point_x, point_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call SetUnitTimeScale(n, 0.7)
        call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'dM32', point_x, point_y, angle*bj_RADTODEG)
        call UnitScale(n, 10.0, 0.0, 2.5)
        call SetUnitVertexColor(n, 255, 255, 255, 200)
        call UnitApplyTimedLife(n, 1, 2.5)
        call MyRemoveUnit(n, 5.0)

        call SetUnitFlyHeight(caster, 0, 3000)
        call KillUnit(LoadUnitHandle(h, id, 3))
        call MyRemoveUnit(LoadUnitHandle(h, id, 3), 1.5)
        call RemoveUnit(LoadUnitHandle(h, id, 4))
        call KillUnit(LoadUnitHandle(h, id, 5))
        call MyRemoveUnit(LoadUnitHandle(h, id, 5), 1.5)
        call KillUnit(LoadUnitHandle(h, id, 8))
        call MyRemoveUnit(LoadUnitHandle(h, id, 8), 1.5)
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set caster = null
    set newTimer = null
endfunction

function KarnaT_Periodic1 takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id   = GetHandleId(LoadUnitHandle(h, id, 0))
    local unit    caster = LoadUnitHandle(h, id, 0)
    local real    caster_x = GetUnitX(caster)
    local real    caster_y = GetUnitY(caster)
    local real    angle    = GetUnitFacing(caster)*bj_DEGTORAD
    local real    duration = LoadReal(h, id, 1)-0.1
    local trigger newTrigger = LoadTriggerHandle(h, id, 99)
    local real    damage     = GetHeroAgi(caster, true)*2 *0.1

    if duration>=0 then
        call SetUnitInvulnerable(caster, true)
        call PauseUnit(caster, true)
        if GetOwningPlayer(caster)==GetLocalPlayer()then
            call ClearSelection()
            call SetUnitVertexColor(LoadUnitHandle(HH, c_id, KarnaT_Circle),255,255,255,255)
            call SelectUnit(LoadUnitHandle(HH, c_id, KarnaT_Circle),true)
        endif
        call SetUnitBonusMoveSpeedPercent(LoadUnitHandle(HH, c_id, KarnaT_Circle),500)
        if duration==2.0 then
            set n = CreateUnit(GetOwningPlayer(caster), 'd126', caster_x-100*Cos(angle), caster_y-100*Sin(angle), angle*bj_RADTODEG)
            call SetUnitScale(n, 5, 5, 5)
            call SetUnitFlyHeight(n, GetUnitFlyHeight(caster), 0)
            call MyRemoveUnit(n, 5.0)
            set n = CreateUnit(GetOwningPlayer(caster), 'd125', caster_x, caster_y, angle*bj_RADTODEG)
            call SetUnitScale(n, 5, 5, 5)
            call MyRemoveUnit(n, 5.0)
            set n = CreateUnit(GetOwningPlayer(caster), 'dR12', caster_x, caster_y, angle*bj_RADTODEG)
            call SetUnitScale(n, 5, 5, 5)
            call UnitApplyTimedLife(n, 1, 5.0)
            call MyRemoveUnit(n, 9.0)
            set n = CreateUnit(GetOwningPlayer(caster), 'dR13', caster_x, caster_y, angle*bj_RADTODEG)
            call SetUnitScale(n, 8, 8, 8)
            call MyRemoveUnit(n, 5.0)
            set n = CreateUnit(GetOwningPlayer(caster), 'd105', caster_x, caster_y, 45)
            call SetUnitScale(n, 10, 10, 10)
            call UnitApplyTimedLife(n, 1, 5.0)
            call MyRemoveUnit(n, 9.0)
            // set n = CreateUnit(GetOwningPlayer(caster), 'd105', caster_x, caster_y, 90)
            // call SetUnitScale(n, 10, 10, 10)
            // call UnitApplyTimedLife(n, 1, 5.0)
            // call MyRemoveUnit(n, 9.0)
            set n = LoadUnitHandle(HH, c_id, KarnaT_Circle)
            call SetUnitFacing(caster, AU(caster, n)*bj_RADTODEG)
            call SetUnitAnimationByIndex(caster, 31)

        endif   

            set n = LoadUnitHandle(HH, c_id, KarnaT_Circle)
            call SetUnitFacing(caster, AU(caster, n)*bj_RADTODEG)
            set n = LoadUnitHandle(h, id, 8)
            call SetUnitVertexColor(n, 255, 255, 255, 255-R2I(duration*24))

        set n = LoadUnitHandle(h, id, 3)
        call SetUnitX(n, caster_x - 100*Cos(angle))
        call SetUnitY(n, caster_y - 100*Sin(angle))
        call SetUnitFacing(n, angle*bj_RADTODEG)
        //call SetUnitFlyHeight(n, GetUnitFlyHeight(caster)+100, 0)
        set n = LoadUnitHandle(h, id, 4)
        call SetUnitX(n, caster_x - 100*Cos(angle))
        call SetUnitY(n, caster_y - 100*Sin(angle))
        call SetUnitFacing(n, angle*bj_RADTODEG)
        //call SetUnitFlyHeight(n, GetUnitFlyHeight(caster)+100, 0)
        set n = LoadUnitHandle(h, id, 5)
        call SetUnitX(n, caster_x)
        call SetUnitY(n, caster_y)
        call SaveReal(h, id, 1, duration)

        call GroupEnumUnitsInRange(G, caster_x, caster_y, 1000, Base)
        loop
        set E=FirstOfGroup(G)
        exitwhen E==null
            if Condition_Base(GetOwningPlayer(caster), E) then
                call myCustomDamage(caster, E, damage, false, false, null, null, null)
            endif
            call GroupRemoveUnit(G, E)
        endloop
        call SetControlToUnit(caster, caster, 0.11,"doom")
    else
        if GetOwningPlayer(caster)==GetLocalPlayer()then
            call ClearSelection()
            call SelectUnit(caster, true)
        endif
        call ShakeCamera(2.0, 15)
        call IssueImmediateOrder(caster, "stop")
        call PauseUnit(caster, true)
        call SetUnitInvulnerable(caster, true)
        call SetUnitAnimationByIndex(caster, 32)
        call UnitEnableAutoOrientation(caster, false)
        call SetUnitOrientation(caster, angle * bj_RADTODEG, CalculateAngleTriangle(GetUnitFlyHeight(caster), SquareRootUnit(caster, LoadUnitHandle(HH, c_id, KarnaT_Circle))), 0)
      

        set n = CreateUnit(GetOwningPlayer(caster), 'd132', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG)
        call SetUnitVertexColor(n, 255, 100, 0, 255)
        call SetUnitFlyHeight(n, GetUnitFlyHeight(caster)-250, 0)
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call UnitEnableAutoOrientation(n, false)
        call UnitApplyTimedLife(n, 1, 2.0)
        call SetUnitOrientation(n, angle * bj_RADTODEG, CalculateAngleTriangle(GetUnitFlyHeight(caster), SquareRootUnit(caster, LoadUnitHandle(HH, c_id, KarnaT_Circle))), 0)
        call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd132', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG)
        call SetUnitVertexColor(n, 255, 100, 0, 255)
        call SetUnitFlyHeight(n, GetUnitFlyHeight(caster)-250, 0)
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call UnitEnableAutoOrientation(n, false)
        call UnitApplyTimedLife(n, 1, 2.0)
        call SetUnitOrientation(n, angle * bj_RADTODEG, CalculateAngleTriangle(GetUnitFlyHeight(caster), SquareRootUnit(caster, LoadUnitHandle(HH, c_id, KarnaT_Circle))), 0)
        call MyRemoveUnit(n, 5.0)

        set caster_x = GetUnitX(LoadUnitHandle(HH, c_id, KarnaT_Circle))
        set caster_y = GetUnitY(LoadUnitHandle(HH, c_id, KarnaT_Circle))
    
        set bjLCG = CreateGroup()
        call GroupEnumUnitsInRange(bjLCG, caster_x, caster_y, 800, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            if Condition_Base(GetOwningPlayer(caster), E) then
                call IssueImmediateOrder(E,"stop")
                call SetControlToUnit(E,E,1.0,"stun")
                call myCustomDamage(caster, E, GetHeroAgi(caster, true)*6, false, false, null, null, null)
            endif
        call GroupRemoveUnit(bjLCG, E)
        endloop
        call DestroyGroup(bjLCG)


        set n = CreateUnit(GetOwningPlayer(caster), 'dM32', caster_x, caster_y, angle*bj_RADTODEG)
        call UnitScale(n, 0.5, 10.0, 0.5)
        call UnitApplyTimedLife(n, 1, 2.5)
        //call SetUnitVertexColor(n, 255, 255, 255, 200)
        call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'dR41', caster_x, caster_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call SetUnitTimeScale(n, 0.7)
        call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd108', caster_x, caster_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 2, 2, 2)
        call MyRemoveUnit(n, 2.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd128', caster_x, caster_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 2.2, 2.2, 2.2)
        call UnitApplyTimedLife(n, 1, 2.5)
        call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd129', caster_x, caster_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 2, 2, 2)
        call MyRemoveUnit(n, 3.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd127', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 2, 2, 2)
        call SetUnitVertexColor(n, 255, 150, 0, 255)
        call UnitApplyTimedLife(n, 1, 2.5)
        call MyRemoveUnit(n, 4.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd127', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 3.5, 3.5, 3.5)
        call SetUnitVertexColor(n, 255, 150, 0, 255)
        call UnitApplyTimedLife(n, 1, 2.5)
        call MyRemoveUnit(n, 4.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd127', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 5, 5, 5)
        call SetUnitVertexColor(n, 255, 150, 0, 255)
        call UnitApplyTimedLife(n, 1, 2.5)
        call MyRemoveUnit(n, 4.0)

        call SaveReal(h, id, 1, 2.0)
        call SaveReal(h, id, 6, GetUnitX(LoadUnitHandle(HH, c_id, KarnaT_Circle)))
        call SaveReal(h, id, 7, GetUnitY(LoadUnitHandle(HH, c_id, KarnaT_Circle)))

        call RemoveUnit(LoadUnitHandle(HH, c_id, KarnaT_Circle))
        call RemoveSavedHandle(HH, c_id, KarnaT_Circle)
        call TriggerClearActions(newTrigger)
        call DestroyTrigger(newTrigger)
        call UnitRemoveAbility(caster, 'A1FU') //Slow
        call UnitRemoveAbility(caster, 'Pet1')
        call SetUnitAcquireRange(caster, 600)
        call UnitRemoveAbility(caster, 'B00A')

        call PauseTimer(newTimer)
        call TimerStart(newTimer, 0.5, true, function KarnaT_Periodic2)
    endif
    set caster = null
    set newTimer = null
    set newTrigger = null
endfunction

function KarnaT_StopOrders2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    call IssueImmediateOrder(u,"stop")
    //call SetUnitFacing(u,Atan2(LoadReal(h,id,1)-GetUnitY(u),LoadReal(h,id,2)-GetUnitX(u))*bj_RADTODEG)
    call SetUnitAnimationByIndex(u, 17)
    call FlushChildHashtable(h,id)
    call DestroyTimer(t)
    set t=null
    set u=null
endfunction

function KarnaT_StopOrders takes nothing returns nothing
    local unit u=GetOrderedUnit()
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    call SaveUnitHandle(h,id,0,u)
    if GetOrderTargetUnit()==null then
        call SaveReal(h,id,2,GetOrderPointX())
        call SaveReal(h,id,1,GetOrderPointY())
    else
        call SaveReal(h,id,2,GetUnitX(GetOrderTargetUnit()))
        call SaveReal(h,id,1,GetUnitY(GetOrderTargetUnit()))
    endif
    call TimerStart(t,0.001,false,function KarnaT_StopOrders2)
    set u=null
    set t=null
endfunction

function KarnaT_Cast takes unit newCaster, real point_x, real point_y returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id     = GetHandleId(newCaster)
    local real    caster_x = GetUnitX(newCaster)
    local real    caster_y = GetUnitY(newCaster)
    local real    angle    = AP(caster_x, caster_y, point_x, point_y)
    local trigger newTrigger = CreateTrigger()

    set soundplay=CreateSound("Sound\\Music\\mp3Music\\KarnaT.mp3",false,false,true,12700,12700,"")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)

    call SetUnitFlyHeight(newCaster, 1000, 800)
    
    call PauseUnit(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, 34)
    set n = CreateUnit(GetOwningPlayer(newCaster), 'dR12', caster_x, caster_y, angle*bj_RADTODEG)
    call SetUnitScale(n, 5, 5, 5)
    call UnitApplyTimedLife(n, 1, 10.0)
    call MyRemoveUnit(n, 13.0)
    set n = CreateUnit(GetOwningPlayer(newCaster), 'd105', caster_x, caster_y, angle*bj_RADTODEG)
    call UnitScale(n, 0.1, 2.0, 6.0)
    call UnitApplyTimedLife(n, 1, 10.0)
    call MyRemoveUnit(n, 13.0)

    set n = CreateUnit(GetOwningPlayer(newCaster), 'd123', caster_x-100*Cos(angle), caster_y-100*Sin(angle), angle*bj_RADTODEG)
    call UnitScale(n, 0.1, 2.0, 6.0)
    call SetUnitFlyHeight(n, 1000, 900)
    call SaveUnitHandle(h, id, 3, n)
    set n = CreateUnit(GetOwningPlayer(newCaster), 'd124', caster_x-100*Cos(angle), caster_y-100*Sin(angle), angle*bj_RADTODEG)
    call UnitScale(n, 0.1, 3.0, 6.0)
    call SetUnitFlyHeight(n, 1000, 900)
    call SaveUnitHandle(h, id, 4, n)
    set n = CreateUnit(GetOwningPlayer(newCaster), 'dR14', caster_x, caster_y, angle*bj_RADTODEG)
    call UnitScale(n, 0.1, 2.0, 6.0)
    call SaveUnitHandle(h, id, 5, n)
    set n = CreateUnit(GetOwningPlayer(newCaster), 'dM32', caster_x, caster_y, angle*bj_RADTODEG)
    call UnitScale(n, 0.1, 10.0, 6.0)
    call SetUnitVertexColor(n, 255, 255, 255, 0)
    call SaveUnitHandle(h, id, 8, n)
    set n = CreateUnit(GetOwningPlayer(newCaster), 'd122', point_x, point_y, 0)
    call SetUnitScale(n, 1.0, 7.1, 2.0)
    call SetUnitMoveSpeed(n, 522)
    call SetUnitPathing(n, false)
    call SetUnitVertexColor(n,255,255,255,0)
    call SetUnitScale(n, 7.1, 7.1, 7.1)
    //call SetUnitVertexColor(n,255,255,255,0)
    call SaveUnitHandle(HH, c_id, KarnaT_Circle, n)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(h, id, 1, 10.0)
    call SaveTriggerHandle(h, id, 99, newTrigger)
    call TimerStart(newTimer, 0.1, true, function KarnaT_Periodic1)

    //call TriggerRegisterPlayerKeyEvent( newTrigger, GetOwningPlayer(newCaster), OSKEY_T, 0 ,true )
    call SetUnitAcquireRange(newCaster, 51)
    call UnitAddAbility(newCaster, 'A1FU') //Slow
    call UnitAddAbility(newCaster, 'Pet1')
    call TriggerRegisterUnitEvent(newTrigger, newCaster, EVENT_UNIT_ISSUED_TARGET_ORDER)
    call TriggerRegisterUnitEvent(newTrigger, newCaster, EVENT_UNIT_ISSUED_POINT_ORDER)
    call TriggerAddAction(newTrigger,function KarnaT_StopOrders)
    
    set newTimer   = null
    set newTrigger = null
endfunction



function KarnaT2_Pillar_Periodic takes nothing returns nothing
	local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id   = GetHandleId(LoadUnitHandle(h, id, 0))
    local unit    caster = LoadUnitHandle(h, id, 0)
    local real    point_x = GetUnitX(caster)
    local real    point_y = GetUnitY(caster)
    local real    angle    = GetUnitFacing(caster)*bj_DEGTORAD
    local real    duration = LoadReal(h, id, 1)-0.5
    local real    damage   = GetHeroAgi(caster, true)*6 / 4

    if duration>=0 then
        call SaveReal(h, id, 1, duration)
        call SetUnitInvulnerable(caster, true)

		call SetUnitXY(LoadUnitHandle(h, id, 4), point_x, point_y)
		call SetUnitFlyHeight(LoadUnitHandle(h, id, 4), GetUnitFlyHeight(caster)+500, 0)
		call SetUnitXY(LoadUnitHandle(h, id, 5), point_x, point_y)
		call SetUnitFlyHeight(LoadUnitHandle(h, id, 5), GetUnitFlyHeight(caster)+500, 0)
        // set n = CreateUnit(GetOwningPlayer(caster), 'dR12', point_x, point_y, angle*bj_RADTODEG)
        // call SetUnitScale(n, 5, 5, 5)
        // call UnitApplyTimedLife(n, 1, 5.0)
        // call MyRemoveUnit(n, 9.0)
        // set n = CreateUnit(GetOwningPlayer(caster), 'd105', point_x, point_y, 45)
        // call SetUnitScale(n, 10, 10, 10)
        // call UnitApplyTimedLife(n, 1, 5.0)
        // call MyRemoveUnit(n, 9.0)
        // set n = CreateUnit(GetOwningPlayer(caster), 'd105', point_x, point_y, 90)
        // call SetUnitScale(n, 10, 10, 10)
        // call UnitApplyTimedLife(n, 1, 5.0)
        // call MyRemoveUnit(n, 9.0)

        set n = CreateUnit(GetOwningPlayer(caster), 'd125', point_x, point_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 5, 5, 5)
        call MyRemoveUnit(n, 5.0)
        // set n = CreateUnit(GetOwningPlayer(caster), 'd125', point_x, point_y, angle*bj_RADTODEG)
        // call SetUnitScale(n, 5, 5, 5)
        // call SetUnitFlyHeight(n, 500, 0)
        // call MyRemoveUnit(n, 5.0)
        // set n = CreateUnit(GetOwningPlayer(caster), 'd125', point_x, point_y, angle*bj_RADTODEG)
        // call SetUnitScale(n, 5, 5, 5)
        // call SetUnitFlyHeight(n, 800, 0)
        // call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'dR13', point_x, point_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 8, 8, 8)
        call MyRemoveUnit(n, 5.0)
        // set n = CreateUnit(GetOwningPlayer(caster), 'dR13', point_x, point_y, angle*bj_RADTODEG)
        // call SetUnitScale(n, 8, 8, 8)
        // call SetUnitFlyHeight(n, 500, 0)
        // call MyRemoveUnit(n, 5.0)
        // set n = CreateUnit(GetOwningPlayer(caster), 'dR13', point_x, point_y, angle*bj_RADTODEG)
        // call SetUnitScale(n, 8, 8, 8)
        // call SetUnitFlyHeight(n, 800, 0)
        // call MyRemoveUnit(n, 5.0)


        set bjLCG = CreateGroup()
        call GroupEnumUnitsInRange(bjLCG, point_x, point_y, 1000, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            if Condition_Base(GetOwningPlayer(caster), E) then
                call IssueImmediateOrder(E,"stop")
                call SetControlToUnit(E,E,0.5,"stun")
                call myCustomDamage(caster, E, damage, false, false, null, null, null)
                if GetUnitAbilityLevel(E, 'KaAD')==0 then
                    //call Essence(caster, E, 10)
                    call ReduceHeal(caster, E, 0.5, 30)
                    call UnitAddAbility(E, 'KaAD')
                    call UnitMakeAbilityPermanent(E, true, 'KaAD')
                    call UnitRemoveAbilityTimed(E, 'KaAD', 2.5)
                endif
            endif
        call GroupRemoveUnit(bjLCG, E)
        endloop
        call DestroyGroup(bjLCG)
    else
		call KillUnit(LoadUnitHandle(h, id, 4))
		call MyRemoveUnit(LoadUnitHandle(h, id, 4), 1.5)
		call RemoveUnit(LoadUnitHandle(h, id, 5))
		
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call KarnaT_StartFReload(caster, 20.0)
        call SetUnitAnimationByIndex(caster, 23)
		
        set n = CreateUnit(GetOwningPlayer(caster), 'dR41', point_x, point_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call SetUnitTimeScale(n, 0.7)
        call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'dM32', point_x, point_y, angle*bj_RADTODEG)
        call UnitScale(n, 10.0, 0.0, 2.5)
        call SetUnitVertexColor(n, 255, 255, 255, 200)
        call UnitApplyTimedLife(n, 1, 2.5)
        call MyRemoveUnit(n, 5.0)

        call SetUnitFlyHeight(caster, 0, 3000)
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set caster = null
    set newTimer = null
endfunction

function KarnaT2_Pillar_WaitTime takes nothing returns nothing
    local timer newTimer   = GetExpiredTimer()
    local integer id       = GetHandleId(newTimer)
    local unit    caster   = LoadUnitHandle(h, id, 0)
	local real    caster_x = GetUnitX(caster)
	local real    caster_y = GetUnitY(caster)
    local real    angle    = GetUnitFacing(caster)*bj_DEGTORAD
    local real    duration = LoadReal(h, id, 1)-0.1
	
	call SetUnitXY(LoadUnitHandle(h, id, 4), caster_x, caster_y)
	call SetUnitFlyHeight(LoadUnitHandle(h, id, 4), GetUnitFlyHeight(caster)+500, 0)
	call SetUnitXY(LoadUnitHandle(h, id, 5), caster_x, caster_y)
	call SetUnitFlyHeight(LoadUnitHandle(h, id, 5), GetUnitFlyHeight(caster)+500, 0)
	
    if duration>0 then
        call SaveReal(h, id, 1, duration)
    else
		set soundplay=CreateSound("Sound\\Music\\mp3Music\\KarnaT2_Sound.mp3", false, false, true, 12700, 12700, "")
		call StartSound(soundplay)
		
		set n = CreateUnit(GetOwningPlayer(caster), 'dM32', caster_x, caster_y, angle*bj_RADTODEG)
        call UnitScale(n, 0.5, 10.0, 0.5)
        call UnitApplyTimedLife(n, 1, 2.5)
        //call SetUnitVertexColor(n, 255, 255, 255, 200)
        call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'dR41', caster_x, caster_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 1.8, 1.8, 1.8)
        call SetUnitTimeScale(n, 0.7)
        call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd108', caster_x, caster_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 2.2, 2.2, 2.2)
        call MyRemoveUnit(n, 2.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd128', caster_x, caster_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 2.5, 2.5, 2.5)
        call UnitApplyTimedLife(n, 1, 2.5)
        call MyRemoveUnit(n, 5.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd129', caster_x, caster_y, angle*bj_RADTODEG)
        call SetUnitScale(n, 2.2, 2.2, 2.2)
        call MyRemoveUnit(n, 3.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd127', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 2.2, 2.2, 2.2)
        call SetUnitVertexColor(n, 255, 150, 0, 255)
        call UnitApplyTimedLife(n, 1, 2.5)
        call MyRemoveUnit(n, 4.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd127', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 3.7, 3.7, 3.7)
        call SetUnitVertexColor(n, 255, 150, 0, 255)
        call UnitApplyTimedLife(n, 1, 2.5)
        call MyRemoveUnit(n, 4.0)
        set n = CreateUnit(GetOwningPlayer(caster), 'd127', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 5.2, 5.2, 5.2)
        call SetUnitVertexColor(n, 255, 150, 0, 255)
        call UnitApplyTimedLife(n, 1, 2.5)
        call MyRemoveUnit(n, 4.0)
		call SaveReal(h, id, 1, 2.0)
        call ShakeCamera(2.0, 15)
        call PauseTimer(newTimer)
        call TimerStart(newTimer, 0.5, true, function KarnaT2_Pillar_Periodic)
		
		set bjLCG = CreateGroup()
        call GroupEnumUnitsInRange(bjLCG, caster_x, caster_y, 800, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            if Condition_Base(GetOwningPlayer(caster), E) then
                call IssueImmediateOrder(E,"stop")
                call SetControlToUnit(E,E,1.0,"stun")
                call myCustomDamage(caster, E, GetHeroAgi(caster, true)*6, false, false, null, null, null)
            endif
        call GroupRemoveUnit(bjLCG, E)
        endloop
        call DestroyGroup(bjLCG)
    endif
    set newTimer = null
    set caster   = null
endfunction



function KarnaT2_Pillar takes unit newCaster returns nothing
	local timer newTimer = CreateTimer()
	local integer id = GetHandleId(newTimer)
	local real caster_x = GetUnitX(newCaster)
	local real caster_y = GetUnitY(newCaster)
	
	call UnitRemoveAbility(newCaster, 'KaAG')
	set n = CreateUnit(GetOwningPlayer(newCaster), 'd123', caster_x, caster_y, 0)
	call UnitScale(n, 0.1, 3.5, 1.0)
	call SetUnitFlyHeight(n, 500, 0)
	call SaveUnitHandle(h, id, 4, n)
	call UnitEnableAutoOrientation(n, false)
	call SetUnitOrientation(n, GetUnitFacing(newCaster), -90, 0)
	set n = CreateUnit(GetOwningPlayer(newCaster), 'd124', caster_x, caster_y, 0)
	call UnitScale(n, 0.1, 4.5, 1.0)
	call SetUnitFlyHeight(n, 500, 0)
	call SaveUnitHandle(h, id, 5, n)
	call UnitEnableAutoOrientation(n, false)
	call SetUnitOrientation(n, GetUnitFacing(newCaster), -90, 0)
	
	call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
	
	set soundplay=CreateSound("Sound\\Music\\mp3Music\\KarnaT2_Voice.mp3", false, false, true, 12700, 12700, "")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
	call SetUnitAnimationByIndex(newCaster, 21)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(h, id, 1, 1.2)  // время ожидания первого акта
    call TimerStart(newTimer, 0.1, true, function KarnaT2_Pillar_WaitTime)
endfunction


function KarnaT2_Laser_Periodic takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit d1=LoadUnitHandle(h,id,1)
    local unit d2=LoadUnitHandle(h,id,11)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=LoadReal(h,id,5)
    local real y1=LoadReal(h,id,6)
    local real x3=GetUnitX(LoadUnitHandle(HH, GetHandleId(u), TsunaR_Circle))
    local real y3=GetUnitY(LoadUnitHandle(HH, GetHandleId(u), TsunaR_Circle))
    local real x2=0
    local real y2=0
    local real i=LoadReal(h,id,7)
    local real f=GetUnitFacing(u)*bj_DEGTORAD //Atan2(y3-y,x3-x)
    local boolean b=LoadBoolean(h,id,10)
    local real r=0
    local group g=LoadGroupHandle(h,id,7)
    local integer l__idg=GetHandleId(g)
    local player p=GetOwningPlayer(u)
    local real dmg=GetHeroAgi(u,true)*6 *0.075
    local trigger newTrigger=LoadTriggerHandle(h, id, 100)
    local unit dummy = LoadUnitHandle(HH, GetHandleId(u), TsunaR_Circle)
    local boolean visual_fix = LoadBoolean(h, id, 102)
    local real angle = AU(u, dummy)
    local real caster_facing = GetUnitFacing(u)*bj_DEGTORAD
    local real turn_speed = (36 / 13.3) // первое значение - градусы в секунду 
	local real duration = LoadReal(h, id, 200)
	
    if duration<2.0 and GetWidgetLife(LoadUnitHandle(HH, GetHandleId(u), TsunaR_Circle))>1.0 then
		
        call SetUnitInvulnerable(u, true)
        call PauseUnit(u, true)
        if GetOwningPlayer(u)==GetLocalPlayer()then
            call ClearSelection()
            call SelectUnit(dummy,true)
        endif
        call SetUnitBonusMoveSpeedPercent(dummy,500)
        call SetUnitMaxMana(dummy, GetWidgetMaxMana(u))
        call SetWidgetMana(dummy, GetWidgetMana(u))

		set n = LoadUnitHandle(h, id, 30)
        call SetUnitX(n, x - 100*Cos(caster_facing))
        call SetUnitY(n, y - 100*Sin(caster_facing))
        call SetUnitFacing(n, caster_facing*bj_RADTODEG)
        call SetUnitFlyHeight(n, GetUnitFlyHeight(u)+100, 0)
		call DummyAutoInvisible(n, u)
		
        set n = LoadUnitHandle(h, id, 40)
        call SetUnitX(n, x - 100*Cos(caster_facing))
        call SetUnitY(n, y - 100*Sin(caster_facing))
        call SetUnitFacing(n, caster_facing*bj_RADTODEG)
        call SetUnitFlyHeight(n, GetUnitFlyHeight(u)+100, 0)
		call DummyAutoInvisible(n, u)
		
        if Rad2Deg(angle)<0 then
            set angle = Deg2Rad(Rad2Deg(angle)+360)
        endif

        if (Rad2Deg(angle)-GetUnitFacing(u))>180 then
            if GetUnitFacing(u)<180 then
                set angle = Deg2Rad(Rad2Deg(angle)-360)
            endif
        elseif (GetUnitFacing(u)-Rad2Deg(angle))>180 then
            set angle = Deg2Rad(Rad2Deg(angle)+360)
        endif
        
        if GetUnitFacing(u)<Rad2Deg(angle) then
            if GetUnitFacing(u)+turn_speed>=Rad2Deg(angle) then
                call SetUnitFacing(u, Rad2Deg(angle))
            else
                call SetUnitFacing(u, GetUnitFacing(u)+turn_speed)
            endif
        elseif GetUnitFacing(u)>Rad2Deg(angle) then
            if GetUnitFacing(u)-turn_speed<=Rad2Deg(angle) then
                call SetUnitFacing(u, Rad2Deg(angle))
            else
                call SetUnitFacing(u, GetUnitFacing(u)-turn_speed)
            endif
        endif
        set angle = Deg2Rad(GetUnitFacing(u))
        set f = Deg2Rad(GetUnitFacing(u))
		
        call SetUnitXY_1(u,x1,y1, false)
        if visual_fix==false then
            call SaveBoolean(h, id, 102, true)
        else
            call SaveBoolean(h, id, 102, false)
            if i<7 then
                call SaveReal(h,id,7,i+1)
            else
                if b==false then
					call SetUnitAnimationByIndex(u, 32)
                    set soundplay=CreateSound("Sound\\Music\\mp3Music\\KarnaT2_Sound.mp3",false,false,true,12700,12700,"")
                    call StartSound(soundplay)
                    call KillSoundWhenDone(soundplay)
                    //set d2=CreateUnit(p,'e90K',x+25*Cos(f),y+25*Sin(f),f*bj_RADTODEG)
                    set d1=CreateUnit(p,'d132',x+100*Cos(caster_facing),y+100*Sin(caster_facing),caster_facing*bj_RADTODEG)
                    call SetUnitFlyHeight(d1, 0, 0)
					call SetUnitVertexColor(d1, 255, 100, 0, 255)
                    call UnitScale(d1, 0.1, 1.3, 0.1)
                    call SaveUnitHandle(h,id,1,d1)
                    call UnitAddAbility(d1,'Arav')
                    set d2=CreateUnit(p,'d132',x+100*Cos(caster_facing),y+100*Sin(caster_facing),caster_facing*bj_RADTODEG)
                    call SetUnitFlyHeight(d2, 0, 0)
                    call UnitScale(d2, 0.1, 1.3, 0.15)
                    call SaveUnitHandle(h,id,11,d2)
                    call UnitAddAbility(d2,'Arav')
					call SetUnitVertexColor(d1, 255, 100, 0, 255)
                    //call SetUnitVertexColor(d2,255,50,50,255)
                    call SaveBoolean(h,id,10,true)
					set n = CreateUnit(GetOwningPlayer(u), 'd126', x-100*Cos(caster_facing), y-100*Sin(caster_facing), caster_facing*bj_RADTODEG)
					call SetUnitScale(n, 5, 5, 5)
					call SetUnitFlyHeight(n, GetUnitFlyHeight(u), 0)
					call MyRemoveUnit(n, 5.0)
					set n = CreateUnit(GetOwningPlayer(u), 'd125', x, y, y*bj_RADTODEG)
					call SetUnitScale(n, 5, 5, 5)
					call MyRemoveUnit(n, 5.0)
                endif
            endif
            if b==true then
				call SaveReal(h, id, 200, duration+0.075)
				call SetUnitXY_1(d1,x+100*Cos(caster_facing),y+100*Sin(caster_facing), false)
				call SetUnitFacingInstant(d1,caster_facing*bj_RADTODEG)
                call SetUnitXY_1(d2,x+100*Cos(caster_facing),y+100*Sin(caster_facing), false)
                call SetUnitFacingInstant(d2,caster_facing*bj_RADTODEG)
                loop
                exitwhen r==12
                    set x2=80*Cos(f)+x+r*245*Cos(f)
                    set y2=80*Sin(f)+y+r*245*Sin(f)
                    if r>2 then
                        set n=CreateUnit(p,'e00L',x2,y2,f*bj_RADTODEG)
                        call UnitApplyTimedLife(n,'BHwe',0.25)
                        call SetUnitTimeScale(n,2)
                    endif
                    call SaveReal(h,id,7,i+1)
                    call GroupEnumUnitsInRange(g,x2,y2,325,Base)
                    set r=r+1
                    loop
                        set E=FirstOfGroup(g)
                        set ide=GetHandleId(E)
                        if Condition_Base(p,E) and E!=LoadUnitHandle(h,l__idg,ide)then
                            call SaveUnitHandle(h,l__idg,ide,E)
                            call myCustomDamage(u,E,dmg,false,false,null,null,null)
                            call SetControlToUnit(u,E,0.55,"stun")
							if GetUnitAbilityLevel(E, 'KaAD')==0 then
								//call Essence(caster, E, 10)
								call ReduceHeal(u, E, 0.5, 30)
								call UnitAddAbility(E, 'KaAD')
								call UnitMakeAbilityPermanent(E, true, 'KaAD')
								call UnitRemoveAbilityTimed(E, 'KaAD', 2.5)
							endif
                        endif
                        call GroupRemoveUnit(g,E)
                    exitwhen E==null
                    endloop
                endloop
                call FlushChildHashtable(h,l__idg)
            endif
        endif
    else
		call KarnaT_StartFReload(u, 20.0)
        call SetUnitInvulnerable(u, false)
        call PauseUnit(u, false)
        call IssueImmediateOrder(u, "stop")
        if GetOwningPlayer(u)==GetLocalPlayer()then
            call ClearSelection()
            call SelectUnit(u,true)
        endif
        call RemoveUnit(LoadUnitHandle(HH, GetHandleId(u), TsunaR_Circle))
        call RemoveSavedHandle(HH, GetHandleId(u), TsunaR_Circle)
        call TriggerClearActions(newTrigger)
        call DestroyTrigger(newTrigger)
        call GroupClear(g)
        call DestroyGroup(g)
        //call UnitRemoveAbility(u,'A0GZ')
        call DestroyTimer(t)
        call RemoveUnit(d1)
        call KillUnit(d2)
        call MyRemoveUnit(d2, 1.5)
		call KillUnit(LoadUnitHandle(h, id, 30))
		call MyRemoveUnit(LoadUnitHandle(h, id, 30), 1.5)
		call RemoveUnit(LoadUnitHandle(h, id, 40))
        call FlushChildHashtable(h,id)
    endif
    set d1=null
    set d2=null
    set g=null
    set p=null
    set u=null
    set t=null
    set newTrigger=null
    set dummy=null
endfunction


function KarnaT2_Laser takes unit newCaster, real x1, real y1 returns nothing
    local unit newCaster=GetTriggerUnit()
    local real x=GetUnitX(newCaster)
    local real y=GetUnitY(newCaster)
    local real f=Atan2(y1-y,x1-x)
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local trigger newTrigger=CreateTrigger()
    local real angle = 0
    //call UnitAddAbility(newCaster,'A0GZ')
	call UnitRemoveAbility(newCaster, 'KaAG')
	call SaveBoolean(h, GetHandleId(newCaster), KarnaF_Reload, false)
	
    call SetUnitFacingInstant(newCaster, f*bj_RADTODEG)
    call SaveUnitHandle(h,id,0,newCaster)

    call SaveReal(h,id,2,x1)
    call SaveReal(h,id,3,y1)
    call SaveReal(h,id,5,x)
    call SaveReal(h,id,6,y)
    call SaveGroupHandle(h,id,7,CreateGroup())
    call SaveBoolean(h,id,4,true)
    call SetUnitAnimationByIndex(newCaster, 31)
    set soundplay=CreateSound("Sound\\Music\\mp3Music\\KarnaT2_Voice.mp3",false,false,true,12700,12700,"")
    call StartSound(soundplay)

    call TimerStart(t,0.075,true,function KarnaT2_Laser_Periodic)
        set n = CreateUnit(GetOwningPlayer(newCaster), 'd122', x1, y1, 0)
        call SetUnitMoveSpeed(n, 522)
        call SetUnitPathing(n, false)
        call UnitScale(n, 1.0, 3.0, 0.5)
        call SetUnitMaxMana(n, GetWidgetMaxMana(newCaster))
        call SetWidgetMana(n, GetWidgetMana(newCaster))
        call SaveUnitHandle(HH, GetHandleId(newCaster), TsunaR_Circle, n)

        call SaveTriggerHandle(h, id, 100, newTrigger)
        call TriggerRegisterUnitEvent(newTrigger, n, EVENT_UNIT_ISSUED_TARGET_ORDER)
        call TriggerRegisterUnitEvent(newTrigger, n, EVENT_UNIT_ISSUED_POINT_ORDER)
        call TriggerAddAction(newTrigger,function TsunaR_Order)
		
	set n = CreateUnit(GetOwningPlayer(newCaster), 'dR12', x, y, angle*bj_RADTODEG)
    call SetUnitScale(n, 5, 5, 5)
    call UnitApplyTimedLife(n, 1, 4.0)
    call MyRemoveUnit(n, 13.0)
    set n = CreateUnit(GetOwningPlayer(newCaster), 'd105', x, y, angle*bj_RADTODEG)
    call UnitScale(n, 0.1, 2.0, 2.0)
    call UnitApplyTimedLife(n, 1, 4.0)
    call MyRemoveUnit(n, 13.0)
	
	set n = CreateUnit(GetOwningPlayer(newCaster), 'd123', x-100*Cos(angle), y-100*Sin(angle), angle*bj_RADTODEG)
    call UnitScale(n, 0.1, 2.0, 1.0)
    call SaveUnitHandle(h, id, 30, n)
    set n = CreateUnit(GetOwningPlayer(newCaster), 'd124', x-100*Cos(angle), y-100*Sin(angle), angle*bj_RADTODEG)
    call UnitScale(n, 0.1, 3.0, 1.0)
    call SaveUnitHandle(h, id, 40, n)
	
    set newCaster=null
    set t=null
    set newTrigger=null
endfunction


function KarnaT1_Periodic2 takes nothing returns nothing
	local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id   = GetHandleId(LoadUnitHandle(h, id, 0))
    local unit    caster = LoadUnitHandle(h, id, 0)
    local real    caster_x = GetUnitX(caster)
    local real    caster_y = GetUnitY(caster)
    local real    angle    = GetUnitFacing(caster)*bj_DEGTORAD
    local real    duration = LoadReal(h, id, 1)+0.02
    local real    damage     = GetHeroAgi(caster, true)*2 *0.02

    if duration<=10 and GetWidgetLife(caster)>=1 and GetUnitAbilityLevel(caster, 'KaAG')>0 then
		
        set n = LoadUnitHandle(h, id, 3)
        call SetUnitX(n, caster_x - 100*Cos(angle))
        call SetUnitY(n, caster_y - 100*Sin(angle))
        call SetUnitFacing(n, angle*bj_RADTODEG)
        call SetUnitFlyHeight(n, GetUnitFlyHeight(caster)+100, 0)
		call DummyAutoInvisible(n, caster)
		
        set n = LoadUnitHandle(h, id, 4)
        call SetUnitX(n, caster_x - 100*Cos(angle))
        call SetUnitY(n, caster_y - 100*Sin(angle))
        call SetUnitFacing(n, angle*bj_RADTODEG)
        call SetUnitFlyHeight(n, GetUnitFlyHeight(caster)+100, 0)
		call DummyAutoInvisible(n, caster)

        call SaveReal(h, id, 1, duration)
	elseif GetUnitAbilityLevel(caster, 'KaAG')>0 then
		call KarnaT_StartFReload(caster, 20.0)
		call UnitRemoveAbility(caster, 'KaAG')
		call ShowAbility2('KaAF', true)
		call KillUnit(LoadUnitHandle(h, id, 3))
        call MyRemoveUnit(LoadUnitHandle(h, id, 3), 1.5)
        call RemoveUnit(LoadUnitHandle(h, id, 4))
		call FlushChildHashtable(h, id)
		call DestroyTimer(newTimer)
	else
		call ShowAbility2('KaAF', true)
		call KillUnit(LoadUnitHandle(h, id, 3))
        call MyRemoveUnit(LoadUnitHandle(h, id, 3), 1.5)
        call RemoveUnit(LoadUnitHandle(h, id, 4))
		call FlushChildHashtable(h, id)
		call DestroyTimer(newTimer)
	endif
endfunction

function KarnaT1_Periodic takes nothing returns nothing
	local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id   = GetHandleId(LoadUnitHandle(h, id, 0))
    local unit    caster = LoadUnitHandle(h, id, 0)
    local real    caster_x = GetUnitX(caster)
    local real    caster_y = GetUnitY(caster)
    local real    angle    = GetUnitFacing(caster)*bj_DEGTORAD
    local real    duration = LoadReal(h, id, 1)-0.02
    local real    damage     = GetHeroAgi(caster, true)*2 *0.2

    if duration>=0 and GetWidgetLife(caster)>=1 then
        call SaveBoolean(h, GetHandleId(caster), KarnaF_Reload, true)
        // if duration==2.0 then
            // set n = CreateUnit(GetOwningPlayer(caster), 'd126', caster_x-100*Cos(angle), caster_y-100*Sin(angle), angle*bj_RADTODEG)
            // call SetUnitScale(n, 5, 5, 5)
            // call SetUnitFlyHeight(n, GetUnitFlyHeight(caster), 0)
            // call MyRemoveUnit(n, 5.0)
            // set n = CreateUnit(GetOwningPlayer(caster), 'd125', caster_x, caster_y, angle*bj_RADTODEG)
            // call SetUnitScale(n, 5, 5, 5)
            // call MyRemoveUnit(n, 5.0)
            // set n = CreateUnit(GetOwningPlayer(caster), 'dR12', caster_x, caster_y, angle*bj_RADTODEG)
            // call SetUnitScale(n, 5, 5, 5)
            // call UnitApplyTimedLife(n, 1, 5.0)
            // call MyRemoveUnit(n, 9.0)
            // set n = CreateUnit(GetOwningPlayer(caster), 'dR13', caster_x, caster_y, angle*bj_RADTODEG)
            // call SetUnitScale(n, 8, 8, 8)
            // call MyRemoveUnit(n, 5.0)
            // set n = CreateUnit(GetOwningPlayer(caster), 'd105', caster_x, caster_y, 45)
            // call SetUnitScale(n, 10, 10, 10)
            // call UnitApplyTimedLife(n, 1, 5.0)
            // call MyRemoveUnit(n, 9.0)
        // endif   

		set n = LoadUnitHandle(h, id, 8)
		call SetUnitVertexColor(n, 255, 255, 255, 255-R2I(duration*48))
		call DummyAutoInvisible(n, caster)
		
        set n = LoadUnitHandle(h, id, 3)
        call SetUnitX(n, caster_x - 100*Cos(angle))
        call SetUnitY(n, caster_y - 100*Sin(angle))
        call SetUnitFacing(n, angle*bj_RADTODEG)
        call SetUnitFlyHeight(n, GetUnitFlyHeight(caster)+100, 0)
		call DummyAutoInvisible(n, caster)
		
        set n = LoadUnitHandle(h, id, 4)
        call SetUnitX(n, caster_x - 100*Cos(angle))
        call SetUnitY(n, caster_y - 100*Sin(angle))
        call SetUnitFacing(n, angle*bj_RADTODEG)
        call SetUnitFlyHeight(n, GetUnitFlyHeight(caster)+100, 0)
		call DummyAutoInvisible(n, caster)
		
        set n = LoadUnitHandle(h, id, 5)
        call SetUnitX(n, caster_x)
        call SetUnitY(n, caster_y)
		call DummyAutoInvisible(n, caster)
        call SaveReal(h, id, 1, duration)

		if LoadInteger(h, id, 100)<=0 then
			call GroupEnumUnitsInRange(G, caster_x, caster_y, 1000, Base)
			loop
			set E=FirstOfGroup(G)
			exitwhen E==null
				if Condition_Base(GetOwningPlayer(caster), E) then
					call myCustomDamage(caster, E, damage, false, false, null, null, null)
				endif
				call GroupRemoveUnit(G, E)
			endloop
			call SaveInteger(h, id, 100, 10)
		else
			call SaveInteger(h, id, 100, LoadInteger(h, id, 100)-1)
		endif
    elseif GetWidgetLife(caster)>=1 then
		set n = CreateUnit(GetOwningPlayer(caster), 'd126', caster_x-100*Cos(angle), caster_y-100*Sin(angle), angle*bj_RADTODEG)
		call SetUnitScale(n, 5, 5, 5)
		call SetUnitFlyHeight(n, GetUnitFlyHeight(caster), 0)
		call MyRemoveUnit(n, 5.0)
		set n = CreateUnit(GetOwningPlayer(caster), 'd125', caster_x, caster_y, angle*bj_RADTODEG)
		call SetUnitScale(n, 5, 5, 5)
		call MyRemoveUnit(n, 5.0)
		set n = CreateUnit(GetOwningPlayer(caster), 'dR12', caster_x, caster_y, angle*bj_RADTODEG)
		call SetUnitScale(n, 5, 5, 5)
		call UnitApplyTimedLife(n, 1, 5.0)
		call MyRemoveUnit(n, 9.0)
		set n = CreateUnit(GetOwningPlayer(caster), 'dR13', caster_x, caster_y, angle*bj_RADTODEG)
		call SetUnitScale(n, 8, 8, 8)
		call MyRemoveUnit(n, 5.0)
		set n = CreateUnit(GetOwningPlayer(caster), 'd105', caster_x, caster_y, 45)
		call SetUnitScale(n, 10, 10, 10)
		call UnitApplyTimedLife(n, 1, 5.0)
		call MyRemoveUnit(n, 9.0)
        call KillUnit(LoadUnitHandle(h, id, 5))
        call MyRemoveUnit(LoadUnitHandle(h, id, 5), 1.5)
        call KillUnit(LoadUnitHandle(h, id, 8))
        call MyRemoveUnit(LoadUnitHandle(h, id, 8), 1.5)
		call PauseTimer(newTimer)
		call TimerStart(newTimer, 0.02, true, function KarnaT1_Periodic2)
		call UnitAddAbility(caster, 'KaAG')
		call SetUnitAbilityLevel(caster, 'KaAG', GetUnitAbilityLevel(caster,'KaAF'))
		call ShowAbility2('KaAF', false)
		call CreateModeIndicatorForm(caster, "ReplaceableTextures\\CommandButtons\\BTNKarnaT2.blp", 10.0)
	else
		call SaveBoolean(h, GetHandleId(caster), KarnaF_Reload, false)
		call KillUnit(LoadUnitHandle(h, id, 5))
        call MyRemoveUnit(LoadUnitHandle(h, id, 5), 1.5)
        call KillUnit(LoadUnitHandle(h, id, 8))
        call MyRemoveUnit(LoadUnitHandle(h, id, 8), 1.5)
		call KillUnit(LoadUnitHandle(h, id, 3))
        call MyRemoveUnit(LoadUnitHandle(h, id, 3), 1.5)
        call RemoveUnit(LoadUnitHandle(h, id, 4))
		call FlushChildHashtable(h, id)
		call DestroyTimer(newTimer)
    endif
    set caster = null
    set newTimer = null
endfunction

function KarnaT1_Cast takes unit newCaster returns nothing
	local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id     = GetHandleId(newCaster)
    local real    caster_x = GetUnitX(newCaster)
    local real    caster_y = GetUnitY(newCaster)
	local real    angle    = GetUnitFacing(newCaster)*bj_DEGTORAD
	
	call KarnaD_AddStack(newCaster)
	call SaveBoolean(h, GetHandleId(newCaster), KarnaF_Reload, true)
	
    set soundplay=CreateSound("Sound\\Music\\mp3Music\\KarnaT1.mp3",false,false,true,12700,12700,"")
    call StartSound(soundplay)
	
	call SetUnitAnimationByIndex(newCaster, 34)
    set n = CreateUnit(GetOwningPlayer(newCaster), 'dR12', caster_x, caster_y, angle*bj_RADTODEG)
    call SetUnitScale(n, 5, 5, 5)
    call UnitApplyTimedLife(n, 1, 4.0)
    call MyRemoveUnit(n, 13.0)
    set n = CreateUnit(GetOwningPlayer(newCaster), 'd105', caster_x, caster_y, angle*bj_RADTODEG)
    call UnitScale(n, 0.1, 2.0, 2.0)
    call UnitApplyTimedLife(n, 1, 4.0)
    call MyRemoveUnit(n, 13.0)
	
	set n = CreateUnit(GetOwningPlayer(newCaster), 'd123', caster_x-100*Cos(angle), caster_y-100*Sin(angle), angle*bj_RADTODEG)
    call UnitScale(n, 0.1, 1.0, 6.0)
    call SaveUnitHandle(h, id, 3, n)
    set n = CreateUnit(GetOwningPlayer(newCaster), 'd124', caster_x-100*Cos(angle), caster_y-100*Sin(angle), angle*bj_RADTODEG)
    call UnitScale(n, 0.1, 1.5, 6.0)
    call SaveUnitHandle(h, id, 4, n)
    set n = CreateUnit(GetOwningPlayer(newCaster), 'dR14', caster_x, caster_y, angle*bj_RADTODEG)
    call UnitScale(n, 0.1, 2.0, 6.0)
	call SetUnitVertexColor(n, 255, 255, 255, 150)
    call SaveUnitHandle(h, id, 5, n)
    set n = CreateUnit(GetOwningPlayer(newCaster), 'dM32', caster_x, caster_y, angle*bj_RADTODEG)
    call UnitScale(n, 0.1, 2.0, 6.0)
    call SetUnitVertexColor(n, 255, 255, 255, 0)
    call SaveUnitHandle(h, id, 8, n)
	
	call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(h, id, 1, 7.0)
    call TimerStart(newTimer, 0.02, true, function KarnaT1_Periodic)
endfunction


function Trig_KarnaInt_Actions takes nothing returns nothing
    // 'KaA2' - D Карны, 'KaA3' - Q Каст Карны, 'KaA4' - Q1, 'KaA5' - Q2, 'KaA6' - W1, 'KaA7' - W2, 'KaA8' - E1, 'KaA9' - E2, 'KaAA' - R,  'KaAB' - T 

    if GetSpellAbilityId()=='KaA2' then
        call KarnaD_Active(GetSpellAbilityUnit())
    endif

    if GetSpellAbilityId()=='KaA3' or GetSpellAbilityId()=='KaA3' or GetSpellAbilityId()=='KaA6' or GetSpellAbilityId()=='KaA8' or GetSpellAbilityId()=='KaAA' then
        call KarnaD_AddStack(GetSpellAbilityUnit())
    endif

    if GetSpellAbilityId()=='KaA3' then
        call KarnaQ_Cast(GetSpellAbilityUnit())
    endif
    
    if GetSpellAbilityId()=='KaA4' and SquareRootPoint(GetUnitX(GetSpellAbilityUnit()), GetUnitY(GetSpellAbilityUnit()),GetSpellTargetX(), GetSpellTargetY())>=1000 then
        call KarnaQ1_Laser(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    elseif GetSpellAbilityId()=='KaA4' then
        call KarnaQ1_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    endif

    if GetSpellAbilityId()=='KaA5' and SquareRootPoint(GetUnitX(GetSpellAbilityUnit()), GetUnitY(GetSpellAbilityUnit()),GetSpellTargetX(), GetSpellTargetY())>=1000 then
        call KarnaQ1_Laser(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    elseif GetSpellAbilityId()=='KaA5' then
        call KarnaQ2_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    endif

    if GetSpellAbilityId()=='KaA6' then
        call KarnaW1_Cast(GetSpellAbilityUnit())
    endif

    if GetSpellAbilityId()=='KaA7' then
        call KarnaW2_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    endif
    
    if GetSpellAbilityId()=='KaA8' then
        call KarnaE_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    endif

    if GetSpellAbilityId()=='KaAA' then
        call KarnaR_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    endif

    if GetSpellAbilityId()=='KaAB' then
        call KarnaT_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
    endif
	
    if GetSpellAbilityId()=='KaAF' then
        call KarnaT1_Cast(GetSpellAbilityUnit())
    endif
	
    if GetSpellAbilityId()=='KaAG' then
		if GetSpellTargetUnit()==null then
			call KarnaT2_Laser(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
		elseif GetSpellTargetUnit()==GetSpellAbilityUnit() then
			call KarnaT2_Pillar(GetSpellAbilityUnit())
		else
			call KarnaT2_Laser(GetSpellAbilityUnit(), GetUnitX(GetSpellTargetUnit()), GetUnitY(GetSpellTargetUnit()))
		endif
    endif
endfunction

//===========================================================================
function InitTrig_KarnaInt takes nothing returns nothing
    local trigger trig  = CreateTrigger(  )
    local integer index = 0
    loop
        call TriggerRegisterPlayerUnitEvent(trig, Player(index), EVENT_PLAYER_UNIT_SPELL_EFFECT, null)
        set index = index + 1
        exitwhen index == bj_MAX_PLAYER_SLOTS
    endloop
    call TriggerAddAction( trig, function Trig_KarnaInt_Actions )
    set trig=null
endfunction
//===========================================================================
//===========
function ShiendoCond takes nothing returns boolean
return GetSpellAbilityId()=='A17M' and udg_B
endfunction
function ShiendoCast2 takes nothing returns nothing // SinonE
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=LoadReal(h,id,2)
    local real y1=LoadReal(h,id,3)
    local real x2=LoadReal(h,id,12)
    local real y2=LoadReal(h,id,13)
    local real x3=0
    local real y3=0
    local real sr2=SR1(x2,y2,x,y)
    local real a2=Atan2(y2-y,x2-x)
    local integer l__s=LoadInteger(h,id,7)
    local real f=GetUnitFacing(u)
    local player p=GetOwningPlayer(u)
    local real dmg = GetHeroAgi(u,true)*GetUnitAbilityLevel(u,'A17M')
    local real dist=SR1(x,y,x1,y1)
    local real dist4=SR1(x,y,x2,y2)
    local real dist3=SR1(x,y,x2,y2)
    local real a=Atan2(y1-y,x1-x)
    local real he=0
    local real se=0
    local integer is=R2I(sr2/20)
    local integer is2=R2I(sr2/20)+1
    local real he2=GetUnitFlyHeight(u)
    local real dist2=LoadReal(h,id,100)
    if dist2>50.00 and udg_B==true and DU2==true then
        if l__s==0 then
            call SaveReal(h,id,100,dist2-(40-he2/19))
            call SetUnitX(u,x+(40-he2/19)*Cos(a))
            call SetUnitY(u,y+(40-he2/19)*Sin(a))
            set he=ParabolaZ(650,LoadReal(h,id,4),dist)
        else
            call SaveReal(h,id,100,dist2-40)
            call SetUnitXY_1(u,x+40*Cos(a),y+40*Sin(a), true)
            set he=ParabolaZ(650,LoadReal(h,id,4),dist)
        endif
        call SetUnitFlyHeight(u,he,0)
        if he>550 and l__s==0 then
            call SaveInteger(h,id,7,1)
            call SetUnitTimeScale(u,1.45)
            loop
            exitwhen is<0
                set x3=x+(sr2/20)*is*Cos(a2)
                set y3=y+(sr2/20)*is*Sin(a2)
                set n=CreateUnit(p,'e06L',x3,y3,a2*bj_RADTODEG)
                set dist3=SR1(x3,y3,x2,y2)
                call UnitApplyTimedLife(n,1,1)
                call SetUnitScale(n,0.3,0.3,0.3)
                call SetUnitTimeScale(n,1)
                call SetUnitFlyHeight(n,he*dist3/dist4,0)
                set is=is-1
            endloop
            call GroupEnumUnitsInRange(DG,x2,y2,400,Base)
            loop
                set E=FirstOfGroup(DG)
                exitwhen E==null
                if Condition_Base(p,E)then
                    if Sinon_ModifAttack(u, E, 1.0, dmg, 1.0, false) then
                    endif
                    call SetControlToUnit(E, E, 2, "stun")
                endif
                call GroupRemoveUnit(DG,E)
            endloop
            call UnitApplyTimedLife(CreateUnit(p,'e0NJ',x2,y2,GetRandomReal(0,359)),1,3)
            call UnitApplyTimedLife(CreateUnit(p,'e0NK',x2,y2,GetRandomReal(0,359)),1,6)
            call UnitApplyTimedLife(CreateUnit(p,'e0NI',x2,y2,GetRandomReal(0,359)),1,3)
            call UnitApplyTimedLife(CreateUnit(p,'e0NL',x2,y2,GetRandomReal(0,359)),1,3)
            call UnitApplyTimedLife(CreateUnit(p,'e0NM',x2,y2,GetRandomReal(0,359)),1,3)
            call UnitApplyTimedLife(CreateUnit(p,'e0MI',x2,y2,GetRandomReal(0,359)),1,1)
        endif
    else
        call PauseUnit(u,false)
        call SetUnitInvulnerable(u,false)
        call SetUnitFlyHeight(u,0,0)
        call SetUnitTimeScale(u,1)
        call FlushChildHashtable(h,id)
        call PauseTimer(t)
        call DestroyTimer(t)
    endif
    set u=null
    set t=null
    set p=null
endfunction
function ShiendoCast takes nothing returns nothing
    local unit u=GetSpellAbilityUnit()
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local real f=GetUnitFacing(u)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=x+1500*Cos((f+180)*bj_DEGTORAD)
    local real y1=y+1500*Sin((f+180)*bj_DEGTORAD)
    call DestroyEffect(AddSpecialEffect("war3mapImported\\TealSlam.mdl",x,y))
    call PauseUnit(u,true)
    call UnitAddAbility(u,'Arav')
    call UnitRemoveAbility(u,'Arav')
    call SaveUnitHandle(h,id,0,u)
    call SetUnitInvulnerable(u,true)
    call SaveReal(h,id,2,x1)
    call SaveReal(h,id,3,y1)
    call SaveReal(h,id,12,x)
    call SaveReal(h,id,13,y)
    call SaveInteger(h,id,7,0)
    call SetUnitTimeScale(u,2.4)
    call SaveReal(h,id,4,SR(x,y,x1,y1))
    call SaveReal(h,id,100,SR(x,y,x1,y1))
    call SetUnitAnimation(u,"Spell slam")
    call TimerStart(t,0.025,true,function ShiendoCast2)
    set soundplay=CreateSound("Sound\\Music\\mp3Music\\SinonUlt.mp3",false,false,true,12700,12700,"")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    set u=null
    set t=null
endfunction
function SinonW_SSPeriodic takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    bullet = LoadUnitHandle(h, id, 2)
    local real    angle  = LoadReal(h, id, 1)
    local real    distance = LoadReal(h, id, 3)
    local real    damage   = GetUnitAbilityLevel(LoadUnitHandle(h, id, 0), 'SNW1')*2 + 3
    call SaveReal(h, id, 3, distance+55)

    if distance<1500 then
        call SetUnitXY(bullet, GetUnitX(bullet)+55*Cos(angle), GetUnitY(bullet)+55*Sin(angle))

        set bjLCG = LoadGroupHandle(h, id, 4)
        call GroupEnumUnitsInRange(bjLCG, GetUnitX(bullet), GetUnitY(bullet), 115, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            if Condition_Base(GetOwningPlayer(bullet), E) and IsUnitInvulnerable(E)==false  then
                
                if Sinon_ModifAttack(LoadUnitHandle(h, id, 0), E, 0.06, damage, 0.00, false) then
                endif
                call SetControlToUnit(E, E, 0.06, "stun")
                call Push3(E, 20, angle, 20, "null")
                call GroupClear(bjLCG)
                call SaveReal(h, id, 3, 5050)
                set n = CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, 0)), 'd237', GetUnitX(E), GetUnitY(E), Rad2Deg(angle))
                call SetUnitFlyHeight(n, 85, 0)
                call MyRemoveUnit(n, 1.5)
                call SaveBoolean(h, id, 10, true)
            endif
        call GroupRemoveUnit(bjLCG, E)
        endloop
    else
        if LoadBoolean(h, id, 10)==false then
            set n = CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, 0)), 'd237', GetUnitX(bullet), GetUnitY(bullet), Rad2Deg(angle))
            call SetUnitFlyHeight(n, 85, 0)
            call SetUnitScale(n, 0.75, 0.75, 0.75)
            call MyRemoveUnit(n, 1.5)
        endif
        call KillUnit(bullet)
        call MyRemoveUnit(bullet, 0.5)
        call DestroyGroup(LoadGroupHandle(h, id, 4))
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set newTimer = null
    set bullet = null
endfunction

function SinonW_SingleShot takes unit newCaster, real angle returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local real    caster_x = GetUnitX(newCaster)
    local real    caster_y = GetUnitY(newCaster)
    set angle = angle + Deg2Rad(GetRandomReal(-5, 5))

    set n = CreateUnit(GetOwningPlayer(newCaster), 'd237', caster_x+60*Cos(angle), caster_y+60*Sin(angle), Rad2Deg(angle))
    call SetUnitFlyHeight(n, 85, 0)
    call MyRemoveUnit(n, 1.5)

    set n = CreateUnit(GetOwningPlayer(newCaster), 'd236', caster_x, caster_y, Rad2Deg(angle))
    call SetUnitFlyHeight(n, 85, 0)
    call SetUnitScale(n, 0.75, 0.75, 0.75)
    call SaveUnitHandle(h, id, 2, n)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(h, id, 1, angle)
    call SaveGroupHandle(h, id, 4, CreateGroup())
    call TimerStart(newTimer, 0.02, true, function SinonW_SSPeriodic)
    set newTimer = null
endfunction

function SinonW_Periodic takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    caster = LoadUnitHandle(h, id, 0)
    local unit    dummy  = LoadUnitHandle(HH, GetHandleId(caster), TsunaR_Circle)
    local real    angle  = AU(caster, dummy)
    local real    duration = LoadReal(h, id, 2) - 0.01
    local real    periodic = LoadReal(h, id, 3)
    local real    time     = LoadReal(h, id, 5) - 0.01
    local real    caster_facing = GetUnitFacing(caster)*bj_DEGTORAD
    local real    turn_speed = (180 / 50) // первое значение - градусы в секунду 
    local trigger newTrigger = LoadTriggerHandle(h, id, 100)

    if duration>=0 and GetUnitCurrentOrder(caster)==OrderId("channel") then

        if GetOwningPlayer(caster)==GetLocalPlayer() and ModuloReal(duration,0.07)<0.02 then
            call ClearSelection()
            call SelectUnit(dummy,true)
        endif
        call SetUnitBonusMoveSpeedPercent(dummy,500)
        call SetUnitMaxMana(dummy, GetWidgetMaxMana(caster))
        call SetWidgetMana(dummy, GetWidgetMana(caster))

        if Rad2Deg(angle)<0 then
            set angle = Deg2Rad(Rad2Deg(angle)+360)
        endif

        if (Rad2Deg(angle)-GetUnitFacing(caster))>180 then
            if GetUnitFacing(caster)<180 then
                set angle = Deg2Rad(Rad2Deg(angle)-360)
            endif
        elseif (GetUnitFacing(caster)-Rad2Deg(angle))>180 then
            set angle = Deg2Rad(Rad2Deg(angle)+360)
        endif

        if GetUnitFacing(caster)<Rad2Deg(angle) then
            if GetUnitFacing(caster)+turn_speed>=Rad2Deg(angle) then
                call SetUnitFacingInstant(caster, Rad2Deg(angle))
            else
                call SetUnitFacingInstant(caster, GetUnitFacing(caster)+turn_speed)
            endif
        elseif GetUnitFacing(caster)>Rad2Deg(angle) then
            if GetUnitFacing(caster)-turn_speed<=Rad2Deg(angle) then
                call SetUnitFacingInstant(caster, Rad2Deg(angle))
            else
                call SetUnitFacingInstant(caster, GetUnitFacing(caster)-turn_speed)
            endif
        endif

        set angle = Deg2Rad(GetUnitFacing(caster))

        call SaveReal(h, id, 2, duration)
        if time<=0 then
            call SinonW_SingleShot(caster, angle)
            call SaveReal(h, id, 5, periodic)
            call SaveInteger(h, id, 200, LoadInteger(h, id, 200)+1)
        else
            call SaveReal(h, id, 5, time)
        endif
    else
        // call BJDebugMsg("Overall shots: "+I2S(LoadInteger(h, id, 200)))
        call IssueImmediateOrder(caster, "stop")
        call StopSound(LoadSoundHandle(h, id, 102), true, true)
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\SinonWend.mp3", false, false, true, 12700, 12700, "")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        if GetOwningPlayer(caster)==GetLocalPlayer()then
            call ClearSelection()
            call SelectUnit(caster, true)
        endif
        call RemoveUnit(LoadUnitHandle(HH, GetHandleId(caster), TsunaR_Circle))
        call RemoveSavedHandle(HH, GetHandleId(caster), TsunaR_Circle)
        call TriggerClearActions(newTrigger)
        call DestroyTrigger(newTrigger)
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set newTimer = null
    set newTrigger = null
    set caster = null
endfunction

function SinonW_Order takes nothing returns nothing
    local unit u=GetOrderedUnit()
    local unit caster=Hero[GetPlayerId(GetOwningPlayer(u))]
    local real point_x = 0.0
    local real point_y = 0.0
    local real angle   = 0
    if GetOrderTargetUnit()==null then
        set point_x = GetOrderPointX()
        set point_y = GetOrderPointY()
    else
        set point_x = GetUnitX(GetOrderTargetUnit())
        set point_y = GetUnitY(GetOrderTargetUnit())
    endif
	if u!=null then
		call SetUnitX(u, point_x)
		call SetUnitY(u, point_y)
		call IssueImmediateOrder(u, "stop")
	endif
    set u=null
    set caster=null
endfunction

function SinonW_Cast takes unit newCaster, real point_x, real point_y returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local real caster_x  = GetUnitX(newCaster)
    local real caster_y  = GetUnitY(newCaster)
    local real angle     = AtanPoint(caster_x, caster_y, point_x, point_y)
    local real duration  = 0.5 + GetUnitAbilityLevel(newCaster, 'SNW1')*0.5 // AbilityId W Sinon
    local real caster_as = GetUnitAttackSpeed(newCaster)
    local real shot_reload = 0.1
    local trigger newTrigger = CreateTrigger()
    if caster_as>5.0 then
        set caster_as = 5.0
    endif
    set caster_as = (caster_as-1.0)
    set shot_reload = 0.1 - caster_as/80
    // call BJDebugMsg("Current Attack Speed: "+R2S(GetUnitAttackSpeed(newCaster)))
    // call BJDebugMsg("Caster AS: "+R2S(caster_as))
    // call BJDebugMsg("Shot reload BASE: "+R2S(0.1))
    // call BJDebugMsg("Shot reload Current: "+R2S(shot_reload))

    call SetUnitAnimationByIndex(newCaster, 13)
    call SetUnitFacingInstant(newCaster, angle*bj_RADTODEG)
    set soundplay=CreateSound("Sound\\Music\\mp3Music\\SinonW.mp3", false, false, true, 12700, 12700, "")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    call SaveSoundHandle(h, id, 102, soundplay)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(h, id, 1, angle)
    call SaveReal(h, id, 2, duration)
    call SaveReal(h, id, 3, shot_reload)
    call TimerStart(newTimer, 0.01, true, function SinonW_Periodic)

    set n = CreateUnit(GetOwningPlayer(newCaster), 'd141', point_x, point_y, 0)
    call SetUnitMoveSpeed(n, 522)
    call SetUnitPathing(n, false)
    call UnitScale(n, 1.0, 3.0, 0.5)
    call SetUnitMaxMana(n, GetWidgetMaxMana(newCaster))
    call SetWidgetMana(n, GetWidgetMana(newCaster))
    call SaveUnitHandle(HH, GetHandleId(newCaster), TsunaR_Circle, n)
    call SaveTriggerHandle(h, id, 100, newTrigger)
    if GetOwningPlayer(newCaster)==GetLocalPlayer() then
        call ClearSelection()
        call SelectUnit(n,true)
    endif
    call TriggerRegisterUnitEvent(newTrigger, n, EVENT_UNIT_ISSUED_TARGET_ORDER)
    call TriggerRegisterUnitEvent(newTrigger, n, EVENT_UNIT_ISSUED_POINT_ORDER)
    call TriggerAddAction(newTrigger,function SinonW_Order)

    set newTimer = null
    set newTrigger = null
endfunction

function SinonPrefire_Periodic takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit caster    = LoadUnitHandle(h, id, 0)
    local real distance  = LoadReal(h, id, 1)
    local real angle     = LoadReal(h, id, 2)
    local unit dummy     = LoadUnitHandle(h, id, 3)
    local integer color  = LoadInteger(h, id, 4)
    local real point_x   = GetUnitX(dummy) 
    local real point_y   = GetUnitY(dummy)
    if distance>0 then
        set n = CreateUnit(GetOwningPlayer(caster), 'd143', point_x, point_y, Rad2Deg(angle))
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call SetUnitFlyHeight(n, 50, 0)
        call MyRemoveUnit(n, 0.35)
        if color==0 then
            call SetUnitVertexColor(n, 235, 25, 25, 200)
        elseif color==1 then
            call SetUnitVertexColor(n, 128, 0, 255, 200)
        elseif color==2 then
            call SetUnitVertexColor(n, 20, 100, 255, 200)
        endif
        call SaveReal(h, id, 1, distance-130)
        if IsTerrainPathable(point_x, point_y, PATHING_TYPE_FLYABILITY) then
            call SaveReal(h, id, 1, 0)
        endif
        call SetUnitXY(dummy, point_x+130*Cos(angle), point_y+130*Sin(angle))
    else
        call RemoveUnit(dummy)
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif

    set caster = null
    set dummy  = null
endfunction

function Sinon_Prefire takes unit newCaster, real newDistance, real newAngle, integer color returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)

    set n = CreateUnit(GetOwningPlayer(newCaster), 'd143', GetUnitX(newCaster)+100*Cos(newAngle), GetUnitY(newCaster)+100*Sin(newAngle), newAngle*bj_RADTODEG)
    if color==0 then
        call SetUnitVertexColor(n, 235, 25, 25, 200)
    elseif color==1 then
        call SetUnitVertexColor(n, 128, 0, 255, 200)
    elseif color==2 then
        call SetUnitVertexColor(n, 20, 100, 255, 200)
    endif
    call SaveUnitHandle(h, id, 3, n)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(h, id, 1, newDistance-100)
    call SaveReal(h, id, 2, newAngle)
    call SaveInteger(h, id, 4, color)
    call TimerStart(newTimer, 0.001, true, function SinonPrefire_Periodic)
    set newTimer = null
endfunction

function SinonR_Periodic takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    caster = LoadUnitHandle(h, id, 0)
    local unit    bullet = LoadUnitHandle(h, id, 4)
    local boolean last_crit = LoadBoolean(h, id, 3)
    local boolean q_buff    = LoadBoolean(h, id, 1)
    local real    distance  = LoadReal(h, id, 6)
    local real    angle     = LoadReal(h, id, 2)
	local integer effect_period = LoadInteger(h, id,  EffectHash )
	
    if distance<5000 then
        call SaveReal(h, id, 6, distance+50)
        call SetUnitXY(bullet, GetUnitX(bullet)+50*Cos(angle), GetUnitY(bullet)+50*Sin(angle))
		
		call SaveInteger(h, id,  EffectHash , effect_period - 1)
		if effect_period == 0 then
			set n=CreateUnit(GetOwningPlayer(caster), 'dBel', GetUnitX(bullet), GetUnitY(bullet), angle*bj_RADTODEG-120)
			call UnitApplyTimedLife(n, 1, 1.5)
			
			call SaveInteger(h, id,  EffectHash , 1)
		endif
		
        set bjLCG = LoadGroupHandle(h, id, 5)
        call GroupEnumUnitsInRange(bjLCG, GetUnitX(bullet), GetUnitY(bullet), 115, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            if Condition_Base(GetOwningPlayer(caster), E) and IsUnitInvulnerable(E)==false then
                //call SetControlToUnit(E, E, 0.5+B2I_ExD(q_buff), "stun")
                if q_buff then
                    call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\jiejinmao.mdx",caster,"Right Hand"))
                    call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx", E, "origin"))
                endif
                set soundplay=CreateSound("Sound\\Music\\mp3Music\\SinonHit.mp3", false, false, true, 12700, 12700, "")
                call StartSound(soundplay)
                call KillSoundWhenDone(soundplay)
                set n = CreateUnit(GetOwningPlayer(caster), 'd238', GetUnitX(E), GetUnitY(E), Rad2Deg(angle))
                call SetUnitFlyHeight(n, 85, 0)
                call SetUnitScale(n, 1.1+B2R_ExD(last_crit)*0.5, 1.1+B2R_ExD(last_crit)*0.5, 1.1+B2R_ExD(last_crit)*0.5)
                call MyRemoveUnit(n, 1.5)
                if last_crit then
                    set n = CreateUnit(GetOwningPlayer(caster), 'd140', GetUnitX(E), GetUnitY(E), Rad2Deg(angle))
                    call SetUnitFlyHeight(n, 85, 0)
                    call SetUnitScale(n, 1.1, 1.1, 1.1)
                    call MyRemoveUnit(n, 1.5)
                endif
                if Sinon_ModifAttack(caster, E, 1.0, GetHeroAgi(caster, true)*2, 1.0, last_crit) then
                endif
                call Push3(E, 20, angle, 150, "null")
                call GroupClear(bjLCG)
                call SaveReal(h, id, 6, 5050)
            endif
        call GroupRemoveUnit(bjLCG, E)
        endloop
    else
        // set soundplay=CreateSound("Sound\\Music\\mp3Music\\SinonAmmo.mp3", false, false, true, 12700, 12700, "")
        // call StartSound(soundplay)
        // call KillSoundWhenDone(soundplay)
        call KillUnit(bullet)
        call MyRemoveUnit(bullet, 0.1)
        call DestroyGroup(LoadGroupHandle(h, id, 5))
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set newTimer = null
    set bullet   = null
    set caster   = null
endfunction

function SinonR_WaitTime takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local integer ammo   = LoadInteger(HH, GetHandleId(LoadUnitHandle(h, id, 0)), Sinon_Ammo)-1
    local unit    caster = LoadUnitHandle(h, id, 0)
    local real    angle  = LoadReal(h, id, 2)
    local real   caster_x = GetUnitX(caster)
    local real   caster_y = GetUnitY(caster)
    local boolean last_crit = false
    if ammo==0 then
        set last_crit = true
    endif
    call PauseUnit(caster, false)
    //call SetUnitInvulnerable(caster, false)
	call ShakeCamera(0.2, 10)
    set soundplay=CreateSound("Sound\\Music\\mp3Music\\SinonR.mp3", false, false, true, 12700, 12700, "")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    
    set n = CreateUnit(GetOwningPlayer(caster), 'd237', caster_x+50*Cos(angle), caster_y+50*Sin(angle), Rad2Deg(angle))
    call SetUnitFlyHeight(n, 85, 0)
    call SetUnitScale(n, 1.5, 1.5, 1.5)
    call MyRemoveUnit(n, 1.5)
    
    set n = CreateUnit(GetOwningPlayer(caster), 'd142', caster_x+80*Cos(angle), caster_y+80*Sin(angle), Rad2Deg(angle))
    call SetUnitFlyHeight(n, 65, 0)
	call SetUnitTimeScale(n, 1.2)
    //call SetUnitScale(n, 1.5, 1.5, 1.5)
    call MyRemoveUnit(n, 1.5)

    set n = CreateUnit(GetOwningPlayer(caster), 'd236', caster_x, caster_y, Rad2Deg(angle))
    call SetUnitFlyHeight(n, 75, 0)
    call SaveUnitHandle(h, id, 4, n)
    call SaveInteger(HH, GetHandleId(caster), Sinon_Ammo, ammo)
    call SaveBoolean(h, id, 3, last_crit)
    call SaveGroupHandle(h, id, 5, CreateGroup())

    call PauseTimer(newTimer)
    call TimerStart(newTimer, 0.005, true, function SinonR_Periodic)
    set newTimer = null
    set caster = null
endfunction

function SinonR_Cast takes unit newCaster, real point_x, real point_y returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local real caster_x  = GetUnitX(newCaster)
    local real caster_y  = GetUnitY(newCaster)
    local real angle     = AtanPoint(caster_x, caster_y, point_x, point_y)
    local integer ammo   = LoadInteger(HH, GetHandleId(newCaster), Sinon_Ammo)-1
    local boolean q_buff = false
    call PauseUnit(newCaster, true)
    //call SetUnitInvulnerable(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, 9)
    
    if GetUnitAbilityLevel(newCaster, 'A17K')>0 then
        set q_buff = true
    endif
    if ammo==0 then
        call Sinon_Prefire(newCaster, 5000, angle, 1)
    else
        call Sinon_Prefire(newCaster, 5000, angle, 0)
    endif
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveBoolean(h, id, 1, q_buff)
    call SaveReal(h, id, 2, angle)
    call TimerStart(newTimer, 0.25, false, function SinonR_WaitTime)
    set newTimer = null
endfunction

function SinonT_Periodic takes nothing returns nothing
	local integer id   = GetHandleId(GetExpiredTimer())
    local unit caster  = LoadUnitHandle(h, id, CasterHash)
	local real point_x = GetUnitX(caster)
	local real point_y = GetUnitY(caster)
	local real angle   = LoadReal(h, id,  AngleHash )
	local real time    = LoadReal(h, id, TIME_HASH)
    local integer ammo         = LoadInteger(HH, GetHandleId(caster), Sinon_Ammo)-2
	local integer EffectPeriod = LoadInteger(h, id, StringHash("EffectButo"))
	local boolean second_act   = LoadBoolean(h, id, StringHash("SecondAct"))
    local boolean last_crit    = LoadBoolean(h, id, 102)
    local boolean q_buff       = LoadBoolean(h, id, 101)

	if time<=1.1 then
		call SaveReal(h, id, TIME_HASH, time+0.005)
		if time<=0.25 then
			call SaveInteger(h, id,  EffectPeriodHash , LoadInteger(h, id,  EffectPeriodHash )-1)
			if LoadInteger(h, id,  EffectPeriodHash )<=0 then
				set n=CreateUnit(GetOwningPlayer(caster), 'dR52', point_x, point_y, GetRandomInt(0,360))
				call SetUnitScale(n, 1.25, 1.25, 1.25)
				call SetUnitVertexColor(n, 255, 255, 255, 150)
				call MyRemoveUnit(n, 1.5)
				call SaveInteger(h, id,  EffectPeriodHash , 32)
			endif
		else
			set soundplay=CreateSound("Sound\\Music\\mp3Music\\SinonT.mp3", false, false, true, 12700, 12700, "")
            call StartSound(soundplay)
            call KillSoundWhenDone(soundplay)
			call ShakeCamera(0.2, 20)
			
			//call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(caster),'e0DX', point_x, point_y,GetRandomReal(0,359)),1,1.5)
			
			set n=CreateUnit(GetOwningPlayer(caster), 'dR42', point_x, point_y, angle*bj_RADTODEG)
			call SetUnitScale(n, 1.25, 1.25, 1.25)
			call SetUnitTimeScale(n, 0.55)
			call MyRemoveUnit(n, 1.5)
			
			set n = CreateUnit(GetOwningPlayer(caster), 'd142', point_x+80*Cos(angle), point_y+80*Sin(angle), Rad2Deg(angle))
			call SetUnitFlyHeight(n, 65, 0)
			call SetUnitTimeScale(n, 1.2)
			call MyRemoveUnit(n, 1.5)
			set n = CreateUnit(GetOwningPlayer(caster), 'd142', point_x+80*Cos(angle), point_y+80*Sin(angle), Rad2Deg(angle))
			call SetUnitFlyHeight(n, 65, 0)
			call SetUnitTimeScale(n, 1.0)
			call SetUnitScale(n, 1.2, 1.2, 1.2)
			call MyRemoveUnit(n, 1.5)
	
			call SaveReal(h, id, TIME_HASH, 12)
			call SaveBoolean(h, id, StringHash("SecondAct"), true)
			set bjLCU = CreateUnit(GetOwningPlayer(caster), 'd236', point_x, point_y, angle*bj_RADTODEG)
			call SetUnitFlyHeight(n, 75, 0)
			call SaveUnitHandle(h, id,  DummyHash , bjLCU)
			call PauseUnit(caster, false)
			//call SetUnitInvulnerable(caster, false)
			call IssueImmediateOrder(caster, "stop")
            call SetUnitAnimationByIndex(caster, 9)
            call SetUnitTimeScale(caster, 1.0)

            call SaveInteger(HH, GetHandleId(caster), Sinon_Ammo, ammo)
            if ammo<=0 then
                call SaveBoolean(h, id, 102, true)
                if ammo<0 then
                    call SaveInteger(HH, GetHandleId(caster), Sinon_Ammo, 0)
                endif
            endif
		endif
	else
		if second_act then
			set bjLCU = LoadUnitHandle(h, id,  DummyHash )
			set point_x = GetUnitX(bjLCU)+65*Cos(angle)
			set point_y = GetUnitY(bjLCU)+65*Sin(angle)
			if IsTerrainPathable(point_x, point_y, PATHING_TYPE_FLYABILITY)==false then
				call SetUnitX(bjLCU, point_x)
				call SetUnitY(bjLCU, point_y)
				call SaveInteger(h, id, StringHash("EffectButo"), EffectPeriod - 1)
				if EffectPeriod == 0 then
					// set n=CreateUnit(GetOwningPlayer(caster), 'dR99', point_x+50*Cos(angle+90*bj_DEGTORAD), point_y+50*Sin(angle+90*bj_DEGTORAD), angle*bj_RADTODEG-120)
					// call UnitApplyTimedLife(n, 1, 1.5)
					// set n=CreateUnit(GetOwningPlayer(caster), 'dR99', point_x+50*Cos(angle-90*bj_DEGTORAD), point_y+50*Sin(angle-90*bj_DEGTORAD), angle*bj_RADTODEG+120)
					// call UnitApplyTimedLife(n, 1, 1.5)
					
					set n=CreateUnit(GetOwningPlayer(caster), 'dBel', point_x, point_y, angle*bj_RADTODEG-120)
					call UnitApplyTimedLife(n, 1, 1.5)
					set n=CreateUnit(GetOwningPlayer(caster), 'd142', point_x, point_y, angle*bj_RADTODEG)
					call SetUnitTimeScale(n, 1.3)
					call SetUnitScale(n, 0.7, 0.7, 0.7)
					call UnitApplyTimedLife(n, 1, 1.5)
					
					set n=CreateUnit(GetOwningPlayer(caster), 'dR42', point_x, point_y, angle*bj_RADTODEG)
					call SetUnitScale(n, 0.25, 0.25, 0.25)
					call SetUnitTimeScale(n, 0.6)
					call UnitApplyTimedLife(n, 1, 1.5)
					call SaveInteger(h, id, StringHash("EffectButo"), 2)
				endif
				// set n=CreateUnit(GetOwningPlayer(bjLCU),'e0DY', point_x, point_y,(angle*bj_RADTODEG))
				// call SetUnitScale(n,3.75,3.6,75.75)
				// call UnitApplyTimedLife(n,1,1)
				// call MyRemoveUnit(n, 1.5)

				set bjLCG=LoadGroupHandle(h, id,  GroupHash )
				call GroupEnumUnitsInRange(bjLCG, point_x, point_y, 175, Base)
				loop
				set E=FirstOfGroup(bjLCG)
				exitwhen E==null
				set ide=GetHandleId(E)
				if Condition_Base(GetOwningPlayer(bjLCU),E)and E!=LoadUnitHandle(h, GetHandleId(bjLCG),ide) and IsUnitInvulnerable(E)==false then
					call SetControlToUnit(E, E, 1.0, "stun")
                    if q_buff then
                        call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\jiejinmao.mdx",caster,"Right Hand"))
                        call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx", E, "origin"))
                    endif
                    set soundplay=CreateSound("Sound\\Music\\mp3Music\\SinonHit.mp3", false, false, true, 12700, 12700, "")
                    call StartSound(soundplay)
                    call KillSoundWhenDone(soundplay)
                    if Sinon_ModifAttack(caster, E, 1.25, GetHeroAgi(caster, true)*3, 1.0, last_crit) then
                    endif
                    call UnitAddAbility(E, 'SNT1')
                    call UnitMakeAbilityPermanent(E, true, 'SNT1')
                    call UnitRemoveAbilityTimed_ExD(E, 'SNT1', 5.0)
                    call UnitRemoveAbilityTimed_ExD(E, 'B16W', 5.0)
                    call Push3(E, 40, angle, 200, "null")
					call SaveUnitHandle(h,GetHandleId(bjLCG),ide,E)
                    set n = CreateUnit(GetOwningPlayer(caster), 'd238', GetUnitX(E), GetUnitY(E), Rad2Deg(angle))
                    call SetUnitFlyHeight(n, 85, 0)
                    call SetUnitScale(n, 1.1+B2R_ExD(last_crit)*0.5, 1.1+B2R_ExD(last_crit)*0.5, 1.1+B2R_ExD(last_crit)*0.5)
                    call MyRemoveUnit(n, 1.5)
                    if last_crit then
                        set n = CreateUnit(GetOwningPlayer(caster), 'd140', GetUnitX(E), GetUnitY(E), Rad2Deg(angle))
                        call SetUnitFlyHeight(n, 85, 0)
                        call SetUnitScale(n, 1.1, 1.1, 1.1)
                        call MyRemoveUnit(n, 1.5)
                    endif
				endif
				call GroupRemoveUnit(bjLCG,E)
				endloop
			else
				call KillUnit(bjLCU)
				call MyRemoveUnit(bjLCU, 1)
				call SaveBoolean(h, id, StringHash("SecondAct"), false)
			endif
		else
			call KillUnit(LoadUnitHandle(h, id, StringHash("Effect0")))
			call MyRemoveUnit(LoadUnitHandle(h, id, StringHash("Effect0")), 1.5)
			call FlushChildHashtable(h, GetHandleId(LoadGroupHandle(h, id,  GroupHash )))
			call DestroyGroup(LoadGroupHandle(h, id,  GroupHash ))
			call FlushChildHashtable(h, id)
			call DestroyTimer(GetExpiredTimer())
		endif
	endif
    set caster = null
endfunction


function SinonT_Cast takes unit newCaster, real point_x, real point_y returns nothing
    local timer newTimer = CreateTimer()
	local integer id = GetHandleId(newTimer)
	local integer id_caster = GetHandleId(newCaster)
    local integer ammo   = LoadInteger(HH, GetHandleId(newCaster), Sinon_Ammo)-2
	local real angle = AtanPoint(GetUnitX(newCaster), GetUnitY(newCaster), point_x, point_y)

	set n=CreateUnit(GetOwningPlayer(newCaster), 'dR20', GetUnitX(newCaster), GetUnitY(newCaster), 0)
	call SetUnitVertexColor(n, 255, 255, 255, 150)
	call SetUnitScale(n, 2, 2, 2)
	call SaveUnitHandle(h, id, StringHash("Effect0"), n)

	if GetUnitAbilityLevel(newCaster, 'A17K')>0 then
        call SaveBoolean(h, id, 101, true)
    endif
    if ammo==0 then
        call Sinon_Prefire(newCaster, 99999, angle, 1)
    else
        call Sinon_Prefire(newCaster, 99999, angle, 0)
    endif
	call PauseUnit(newCaster, true)
	//call SetUnitInvulnerable(newCaster, true)
	call SetUnitAnimationByIndex(newCaster, 5)
    call SetUnitTimeScale(newCaster, 1.5)
	call SaveUnitHandle(h, id, CasterHash, newCaster)
	call SaveReal(h, id,  AngleHash , angle)
	call SaveGroupHandle(h, id,  GroupHash , CreateGroup())
	call TimerStart(newTimer, 0.005, true, function SinonT_Periodic)
    set newTimer = null
endfunction

function Sinon_ARPeriodic takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    caster = LoadUnitHandle(h, id, 0)
    local real    time   = LoadReal(h, id, 1)+0.1
    call SaveReal(h, id, 1, time)
    if GetUnitCurrentOrder(caster)==OrderId("chainlightning")then
        if time>=1.0 then
            call IssueImmediateOrder(caster, "stop")
            call SaveInteger(HH, GetHandleId(caster), Sinon_Ammo, LoadInteger(HH, GetHandleId(caster), Sinon_Ammo)+3)
            if LoadInteger(HH, GetHandleId(caster), Sinon_Ammo)>7 then
                call SaveInteger(HH, GetHandleId(caster), Sinon_Ammo, 7)
            endif
            call UnitAddAbility(caster, 'A222')
            call UnitMakeAbilityPermanent(caster, true, 'A222')
            call UnitRemoveAbilityTimed_ExD(caster, 'A222', 5.0)
            call StartAbilityCooldown(GetUnitAbility(caster, 'A2DC'), 25.0)
			set n = CreateUnit(GetOwningPlayer(caster), 'dM30', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
			call MyRemoveUnit(n, 1.5)
        endif
    else
        if time<1.0 then
            call StopSound(LoadSoundHandle(h, id, 2), true, true)
        endif
        call SetUnitTimeScale(caster, 1.0)
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set newTimer=null
    set caster=null
endfunction

function Sinon_AmmoReload takes unit newCaster returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    call SetUnitAnimationByIndex(newCaster, 11)
    call SetUnitTimeScale(newCaster, 0.5)
    set soundplay=CreateSound("Sound\\Music\\mp3Music\\SinonF.mp3", false, false, true, 12700, 12700, "")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    call SaveSoundHandle(h, id, 2, soundplay)
    call SaveUnitHandle(h, id, 0, newCaster)
    call TimerStart(newTimer, 0.1, true, function Sinon_ARPeriodic)
    set newTimer = null
endfunction

function Sinon_Cast takes nothing returns nothing
	if GetSpellAbilityId() == 'A2DC' then
        call Sinon_AmmoReload(GetSpellAbilityUnit())
    endif
	if GetSpellAbilityId() == 'SNW1' then
        call SinonW_Cast(GetSpellAbilityUnit() , GetSpellTargetX() , GetSpellTargetY())
    endif
	if GetSpellAbilityId() == 'SNW2' then    // Отмена W Sinon
		call KillUnit(GetSpellAbilityUnit())
        call IssueImmediateOrder(Hero[GetPlayerId(GetOwningPlayer(GetSpellAbilityUnit()))], "stop")
	endif
	if GetSpellAbilityId() == 'A270' then
        if LoadInteger(HH, GetHandleId(GetSpellAbilityUnit()), Sinon_Ammo)>0 then
            call SinonR_Cast(GetSpellAbilityUnit() , GetSpellTargetX() , GetSpellTargetY())
        else
            call SetWidgetMana(GetSpellAbilityUnit(), GetWidgetMana(GetSpellAbilityUnit())+BlzGetUnitAbilityManaCost(GetSpellAbilityUnit(), 'A270', GetUnitAbilityLevel(GetSpellAbilityUnit(), 'A270')))
            call DisplayTimedWarningMessage(GetOwningPlayer(GetSpellAbilityUnit()),3,"|c003f4c77Магазин пуст!|r")
            set soundplay=CreateSound("Sound\\Music\\mp3Music\\SinonEmpty.mp3", false, false, true, 12700, 12700, "")
            call StartSound(soundplay)
            call KillSoundWhenDone(soundplay)
        endif
    endif
	if GetSpellAbilityId() == 'A2ZD' then
        if LoadInteger(HH, GetHandleId(GetSpellAbilityUnit()), Sinon_Ammo)>=2 then
            call SinonT_Cast(GetSpellAbilityUnit() , GetSpellTargetX() , GetSpellTargetY())
        elseif LoadInteger(HH, GetHandleId(GetSpellAbilityUnit()), Sinon_Ammo)==1 then
            call SetWidgetMana(GetSpellAbilityUnit(), GetWidgetMana(GetSpellAbilityUnit())+BlzGetUnitAbilityManaCost(GetSpellAbilityUnit(), 'A2ZD', GetUnitAbilityLevel(GetSpellAbilityUnit(), 'A2ZD')))
            call DisplayTimedWarningMessage(GetOwningPlayer(GetSpellAbilityUnit()),3,"|c003f4c77Недостаточно патронов!|r")
            set soundplay=CreateSound("Sound\\Music\\mp3Music\\SinonEmpty.mp3", false, false, true, 12700, 12700, "")
            call StartSound(soundplay)
            call KillSoundWhenDone(soundplay)
        else
            call SetWidgetMana(GetSpellAbilityUnit(), GetWidgetMana(GetSpellAbilityUnit())+BlzGetUnitAbilityManaCost(GetSpellAbilityUnit(), 'A2ZD', GetUnitAbilityLevel(GetSpellAbilityUnit(), 'A2ZD')))
            call DisplayTimedWarningMessage(GetOwningPlayer(GetSpellAbilityUnit()),3,"|c003f4c77Магазин пуст!|r")
            set soundplay=CreateSound("Sound\\Music\\mp3Music\\SinonEmpty.mp3", false, false, true, 12700, 12700, "")
            call StartSound(soundplay)
            call KillSoundWhenDone(soundplay)
        endif
    endif
endfunction

function InitTrig_SinonInt takes nothing returns nothing
    local trigger trig= CreateTrigger()
    local integer index= 0
    loop
        call TriggerRegisterPlayerUnitEvent(trig, Player(index), EVENT_PLAYER_UNIT_SPELL_EFFECT, null)
        set index=index + 1
        exitwhen index == bj_MAX_PLAYER_SLOTS
    endloop
    call TriggerAddAction(trig, function Sinon_Cast)
	set trig=null
endfunction

//===========================================================================
//===========
//===========================================================================
//function InitTrig_BelfegorShield takes nothing returns nothing
//local trigger trig=CreateTrigger()
//call AnyUnitDamagedEvent(trig)
//call TriggerAddAction(trig,function Trig_BelfegorShield_Actions)
//endfunction

    function WendyE2 takes nothing returns nothing
        local integer id= (GetHandleId(GetExpiredTimer())) // INLINED!!
        local real time= LoadFloat("Time")
        local real x= LoadFloat("x")
        local real y= LoadFloat("y")
        local real x1= GetUnitX(LoadUnitHandle(HH,MUIHandle(),CasterHash))
        local real y1= GetUnitY(LoadUnitHandle(HH,MUIHandle(),CasterHash))
        local real dmg= ((3+GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash),'WE08'))*GetHeroInt(LoadUnitHandle(HH,MUIHandle(),CasterHash),true))
        local real ang= LoadFloat("ang")
        local real dist= SR(x1 , y1 , x , y)
        local real tick= LoadFloat("tick")
        local real tick2= LoadFloat("tick2")
        local real ang2= Atan2(y - y1, x - x1)
        
        if time == 0. then
            call SaveReal(HH, id, TickHash, 0.)
            call SaveReal(HH, id, StringHash("tick2"), 0.)
            call SaveReal(HH, id, StringHash("interval"), 0.1)
            call SaveBoolean(HH, id, StringHash("checker"), false)
            call SaveBoolean(HH, id, StringHash("checker2"), false)
            call SetUnitAnimationByIndex(LoadUnitHandle(HH,MUIHandle(),CasterHash), 14)
            call SetUnitTimeScale(LoadUnitHandle(HH,MUIHandle(),CasterHash), 2)
        endif
        if time>4 and LoadUnit("Target") == null then
            call SaveBoolean(HH, id, StringHash("checker2"), true) 
        endif
        if dist > 300 and LoadBoolean(HH, id, StringHash("checker")) == false then
            if tick >= 0.3 then
                call SaveReal(HH, id, StringHash("interval"), 0.15)
            endif
            
                    if tick2 < 0.05 then
                        call SaveReal(HH, id, StringHash("tick2"), tick2 + 0.01)
                    else
                        call SaveReal(HH, id, StringHash("tick2"), 0.)
                        set EFF=AddSpecialEffect("war3mapImported\\Hashirama_MADARAa (73)2.mdx", x1, y1)
                        call SetSpecialEffectScale(EFF , 1)
                        call SetSpecialEffectTimeScale(EFF , 1)
                        call SetSpecialEffectFacing(EFF , GetUnitFacing(LoadUnitHandle(HH,MUIHandle(),CasterHash)))
                        call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 150 , 5)
                    endif
            
            if tick < LoadFloat("interval") then
                if tick == 0 then
                    if dist > 425 then
                        set EFF=AddSpecialEffect("war3mapImported\\BY_Wood_Eff_Ord_DanGe_Wid_ChongFengQiLiu.mdl", x1, y1)
                        call SetSpecialEffectScale(EFF , 1)
                        call SetSpecialEffectTimeScale(EFF , 2)
                        call SetSpecialEffectFacing(EFF , ( ang + 1 ) * bj_RADTODEG)
                        call SetSpecialEffectZ(EFF , 50)
                        call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 200 , 5)
                        set EFF=AddSpecialEffect("war3mapImported\\BY_Wood_Eff_Ord_DanGe_Dus_Kuosan_1_2_1.mdl", x1, y1)
                        call SetSpecialEffectScale(EFF , 1)
                        call SetSpecialEffectTimeScale(EFF , 2)
                        call SetSpecialEffectFacing(EFF , ( ang + 1 ) * bj_RADTODEG)
                        call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 150 , 5)
                        
                    endif
                endif
                call SetUnitXY_1(LoadUnitHandle(HH,MUIHandle(),CasterHash) , x1 + 25 * Cos(ang + 1) , y1 + 25 * Sin(ang + 1) , true)
                call SetUnitFacingInstant(LoadUnitHandle(HH,MUIHandle(),CasterHash) , bj_RADTODEG * ( ang + 1 ))
                call SaveReal(HH, id, TickHash, tick + 0.01)
            elseif tick > LoadFloat("interval") and tick <= 0.3 then
                if tick == LoadFloat("interval") + 0.01 then
                    if dist > 425 then
                        set EFF=AddSpecialEffect("war3mapImported\\BY_Wood_Eff_Ord_DanGe_Wid_ChongFengQiLiu.mdl", x1, y1)
                        call SetSpecialEffectScale(EFF , 1)
                        call SetSpecialEffectTimeScale(EFF , 2)
                        call SetSpecialEffectFacing(EFF , ( ang - 1 ) * bj_RADTODEG)
                        call SetSpecialEffectZ(EFF , 50)
                        call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 200 , 5)
                        set EFF=AddSpecialEffect("war3mapImported\\BY_Wood_Eff_Ord_DanGe_Dus_Kuosan_1_2_1.mdl", x1, y1)
                        call SetSpecialEffectScale(EFF , 1)
                        call SetSpecialEffectTimeScale(EFF , 2)
                        call SetSpecialEffectFacing(EFF , ( ang - 1 ) * bj_RADTODEG)
                        call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 150 , 5)
                    endif
                endif
                call SetUnitXY_1(LoadUnitHandle(HH,MUIHandle(),CasterHash) , x1 + 25 * Cos(ang - 1) , y1 + 25 * Sin(ang - 1) , true)
                call SetUnitFacingInstant(LoadUnitHandle(HH,MUIHandle(),CasterHash) , bj_RADTODEG * ( ang - 1 ))
                call SaveReal(HH, id, TickHash, tick + 0.01)
            elseif tick >= 0.3 then
                call SaveReal(HH, id, TickHash, 0.)
            endif
            
            if tick == 0. then
                set soundplay=CreateSound("Sound\\Music\\mp3Music\\WendyE1.mp3", false, false, true, 12700, 12700, "")
                call StartSound(soundplay)
                call KillSoundWhenDone(soundplay)
            elseif tick == 0.15 then
                set soundplay=CreateSound("Sound\\Music\\mp3Music\\WendyE2.mp3", false, false, true, 12700, 12700, "")
                call StartSound(soundplay)
                call KillSoundWhenDone(soundplay)
            endif
        else
            if LoadBoolean(HH, id, StringHash("checker")) == false then
                set soundplay=CreateSound("Sound\\Music\\mp3Music\\WendyE1.mp3", false, false, true, 12700, 12700, "")
                call StartSound(soundplay)
                call KillSoundWhenDone(soundplay)
                set EFF=AddSpecialEffect("war3mapImported\\BY_Wood_Eff_Ord_DanGe_Wid_ChongFengQiLiu.mdl", x1, y1)
                call SetSpecialEffectScale(EFF , 1)
                call SetSpecialEffectTimeScale(EFF , 2)
                call SetSpecialEffectFacing(EFF , ( ang2 ) * bj_RADTODEG)
                call SetSpecialEffectZ(EFF , 50)
                call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 200 , 5)
                set EFF=AddSpecialEffect("war3mapImported\\BY_Wood_Eff_Ord_DanGe_Dus_Kuosan_1_2_1.mdl", x1, y1)
                call SetSpecialEffectScale(EFF , 1)
                call SetSpecialEffectTimeScale(EFF , 2)
                call SetSpecialEffectFacing(EFF , ( ang2 ) * bj_RADTODEG)
                call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 150 , 5)
                set EFF=AddSpecialEffect("war3mapImported\\Hashirama_MADARAa (73)2.mdx", x1 + 150 * Cos(ang2), y1 + 150 * Sin(ang2))
                call SetSpecialEffectScale(EFF , 1)
                call SetSpecialEffectTimeScale(EFF , 1)
                call SetSpecialEffectFacing(EFF , ( ang2 ) * bj_RADTODEG)
                call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 150 , 5)
                set EFF=AddSpecialEffect("war3mapImported\\Hashirama_MADARAa (73)2.mdx", x1 + 350 * Cos(ang2), y1 + 350 * Sin(ang2))
                call SetSpecialEffectScale(EFF , 2)
                call SetSpecialEffectTimeScale(EFF , 1)
                call SetSpecialEffectFacing(EFF , ( ang2 ) * bj_RADTODEG)
                call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 150 , 5)
            endif
            call SaveBoolean(HH, id, StringHash("checker"), true)
            if LoadBoolean(HH, id, StringHash("checker2")) == false then
                call SetUnitXY_1(LoadUnitHandle(HH,MUIHandle(),CasterHash) , x1 + 25 * Cos(ang2) , y1 + 25 * Sin(ang2) , true)
                call SetUnitFacingInstant(LoadUnitHandle(HH,MUIHandle(),CasterHash) , bj_RADTODEG * ang2)
                if dist <= 50 then
                    call SaveBoolean(HH, id, StringHash("checker2"), true)
                    call SaveReal(HH, id, TickHash, 0.)
                    call SetUnitAnimationByIndex(LoadUnitHandle(HH,MUIHandle(),CasterHash), 16)
                    call SetUnitTimeScale(LoadUnitHandle(HH,MUIHandle(),CasterHash), 1)
                endif
            endif
        endif
        
        if LoadUnit("Target") == null then
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, x1, y1, 250, Base)
            loop
                set SysUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen SysUnit == null
                if GetWidgetLife(SysUnit) > 0.405 and SysUnit!= LoadUnitHandle(HH,MUIHandle(),CasterHash) then
                    if Condition_Base(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)),SysUnit) and LoadUnit("Target") == null and IsUnitInvulnerable(SysUnit) == false then
                        if LoadBoolean(HH,GetHandleId(SysUnit),ANTITARGET_ABILITY)==false then
                            call SaveAgentHandle(HH, id, TargetHash, SysUnit)
                            set soundplay=CreateSound("Sound\\Music\\mp3Music\\WendyE3.mp3", false, false, true, 12700, 12700, "")
                            call StartSound(soundplay)
                            call KillSoundWhenDone(soundplay)
                            call SaveBoolean(HH, id, StringHash("checker"), true)
                            call SaveBoolean(HH, id, StringHash("checker2"), true)
                            call SetUnitTimeScale(LoadUnitHandle(HH,MUIHandle(),CasterHash), 0.5)
                        else
                            call SaveUnitHandle(HH,GetHandleId(SysUnit),REVERSE_TARGET,LoadUnitHandle(HH,MUIHandle(),CasterHash))
                            call SetUnitTimeScale(LoadUnitHandle(HH,MUIHandle(),CasterHash), 1)
                            call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
                            call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
                            call Clear(id)
                        endif
                    endif
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, SysUnit)
            endloop
            call GroupClear(bj_lastCreatedGroup)
            call DestroyGroup(bj_lastCreatedGroup)
        endif
        
        call SaveReal(HH, id, TIME_HASH, time + 0.01)
        call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), true)
        call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), true)
        
        if LoadUnit("Target") != null then
            if tick < 1.1 then
                call SaveReal(HH, id, TickHash, tick + 0.01)
                call PauseUnit(LoadUnit("Target"), true)
                call SaveBoolean(HH,GetHandleId(LoadUnit("Target")),TARGET_ABILITY,true)
                call SetUnitInvulnerable(LoadUnit("Target"), true)
                if SR(x1 , y1 , GetUnitX(LoadUnit("Target")) , GetUnitY(LoadUnit("Target"))) > 70 then
                    call SetUnitXY_1(LoadUnitHandle(HH,MUIHandle(),CasterHash) , x1 + 2 * Cos(Atan2(GetUnitY(LoadUnit("Target")) - y1, GetUnitX(LoadUnit("Target")) - x1)) , y1 + 2 * Sin(Atan2(GetUnitY(LoadUnit("Target")) - y1, GetUnitX(LoadUnit("Target")) - x1)) , true)
                    call SetUnitFacingInstant(LoadUnitHandle(HH,MUIHandle(),CasterHash) , bj_RADTODEG * Atan2(GetUnitY(LoadUnit("Target")) - y1, GetUnitX(LoadUnit("Target")) - x1))
                else
                    call SaveReal(HH, id, TickHash, 1.11)
                endif
            else
            
                if tick == 1.11 then
                    call SetUnitAnimationByIndex(LoadUnitHandle(HH,MUIHandle(),CasterHash), 15)
                    call SaveReal(HH, id, TickHash, 1.12)
                    set EFF=AddSpecialEffect("chongfeng2.mdl", x1, y1)
                    call SetSpecialEffectScale(EFF , 1)
                    call SetSpecialEffectTimeScale(EFF , 1)
                    call SetSpecialEffectFacing(EFF , ( ( Atan2(GetUnitY(LoadUnit("Target")) - y1, GetUnitX(LoadUnit("Target")) - x1) ) * bj_RADTODEG ))
                    call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 150 , 5)
                    set EFF=AddSpecialEffect("cf2.mdx", GetUnitX(LoadUnit("Target")), GetUnitY(LoadUnit("Target")))
                    call SetSpecialEffectScale(EFF , 1)
                    call SetSpecialEffectTimeScale(EFF , 1)
                    call SetSpecialEffectFacing(EFF , ( ( Atan2(GetUnitY(LoadUnit("Target")) - y1, GetUnitX(LoadUnit("Target")) - x1) ) * bj_RADTODEG ))
                    call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 150 , 5)
                    set EFF=AddSpecialEffect("war3mapImported\\by_wood_gongchengsipai_5.mdl", GetUnitX(LoadUnit("Target")), GetUnitY(LoadUnit("Target")))
                    call SetSpecialEffectScale(EFF , 1)
                    call SetSpecialEffectTimeScale(EFF , 0.8)
                    call SetSpecialEffectFacing(EFF , ( ( Atan2(GetUnitY(LoadUnit("Target")) - y1, GetUnitX(LoadUnit("Target")) - x1) ) * bj_RADTODEG ))
                    call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 150 , 5)
                    call PauseUnit(LoadUnit("Target"), false)
                    call SaveBoolean(HH,GetHandleId(LoadUnit("Target")),TARGET_ABILITY,false)
                    call SetUnitInvulnerable(LoadUnit("Target"), false)
                    call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
                    call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
                    call myCustomDamage(LoadUnitHandle(HH,MUIHandle(),CasterHash), LoadUnit("Target"), dmg, false, false, null, null, null)
                    call SetControlToUnit(LoadUnit("Target"),LoadUnit("Target"), 2, "stun")
                    call SetUnitTimeScale(LoadUnitHandle(HH,MUIHandle(),CasterHash), 2)
                   
                endif
                if tick < 1.4 then
                    call SaveReal(HH, id, TickHash, tick + 0.01)
                    call SetUnitXY_1(LoadUnit("Target") , GetUnitX(LoadUnit("Target")) + 15 * Cos(Atan2(GetUnitY(LoadUnit("Target")) - y1, GetUnitX(LoadUnit("Target")) - x1)) , GetUnitY(LoadUnit("Target")) + 15 * Sin(Atan2(GetUnitY(LoadUnit("Target")) - y1, GetUnitX(LoadUnit("Target")) - x1)) , true)
                else
                    set EFF=AddSpecialEffect("az_slb.mdl", GetUnitX(LoadUnit("Target")), GetUnitY(LoadUnit("Target")))
                    call SetSpecialEffectScale(EFF , 1)
                    call SetSpecialEffectTimeScale(EFF , 1)
                    call SetSpecialEffectFacing(EFF , ( ( Atan2(GetUnitY(LoadUnit("Target")) - y1, GetUnitX(LoadUnit("Target")) - x1) ) * bj_RADTODEG ))
                    call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 150 , 5)
                    call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
                    call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
                    call PauseUnit(LoadUnit("Target"), false)
                    call SaveBoolean(HH,GetHandleId(LoadUnit("Target")),TARGET_ABILITY,false)
                    call SetUnitInvulnerable(LoadUnit("Target"), false)
                    call Clear(id)
                endif
            endif
        endif
        
        if ( LoadBoolean(HH, id, StringHash("checker2")) == true and LoadUnit("Target") == null ) then
            call SetUnitTimeScale(LoadUnitHandle(HH,MUIHandle(),CasterHash), 1)
            call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
            call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash), false)
            call Clear(id)
        endif
    endfunction
    
    function WendyT2 takes nothing returns nothing
        local integer id= (GetHandleId(GetExpiredTimer())) // INLINED!!
        local real time= LoadFloat("Time")
        local real x= LoadFloat("x")
        local real y= LoadFloat("y")
        local real x1= GetUnitX(LoadUnitHandle(HH,MUIHandle(),CasterHash))
        local real y1= GetUnitY(LoadUnitHandle(HH,MUIHandle(),CasterHash))
        local integer tick= LoadInt("tick")
        local real dmg= 4*GetHeroInt(LoadUnitHandle(HH,MUIHandle(),CasterHash),true)
        local real ang= LoadFloat("ang")
        local real ang2= LoadFloat("ang2")
        local group g2=CreateGroup()
        local real ang3= 0
        
        if time == 0. then
            set soundplay=CreateSound("Sound\\Music\\mp3Music\\WendyT2.mp3", false, false, true, 12700, 12700, "")
            call StartSound(soundplay)
            call KillSoundWhenDone(soundplay)
            set EFF=AddSpecialEffect("war3mapImported\\aya-wind2.mdl", x, y)
            call SetSpecialEffectScale(EFF , 3.3)
            call SetSpecialEffectTimeScale(EFF , 1.)
            call SetSpecialEffectZ(EFF , - 50)
            call SetSpecialEffectVertexColour(EFF , 255 , 255 , 255 , 150)
            call SaveAgentHandle(HH, id, StringHash("eff"), EFF)
            call SaveReal(HH, id, StringHash("ang2"), ang)
        endif
        
        call SaveReal(HH, id, TIME_HASH, time + 0.04)
        
        if time == 3. then
            call SetSpecialEffectAlphaTimed(LoadEffect("eff") , 255 , 255 , 255 , 150 , 1)
        endif
        
        if time < 4. then
            if tick < 2 then
                call SaveInteger(HH, id, TickHash, tick + 1)
            else
                call SaveInteger(HH, id, TickHash, 0)
                set EFF=AddSpecialEffect("white-qiquan-new.mdl", x, y)
                call SetSpecialEffectScale(EFF , GetRandomReal(3, 5))
                call SetSpecialEffectTimeScale(EFF , GetRandomReal(0.5, 2))
                call SetSpecialEffectZ(EFF , GetRandomReal(0.5, 400))
                call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 150 , 4)
                set EFF=AddSpecialEffect("war3mapImported\\fuzzystomp4.mdx", x, y)
                call SetSpecialEffectScale(EFF , GetRandomReal(1, 3))
                call SetSpecialEffectTimeScale(EFF , GetRandomReal(0.5, 2))
                call SetSpecialEffectZ(EFF , GetRandomReal(0.5, 400))
                call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 150 , 4)
                call GroupEnumUnitsInRange(g2, x, y, 750, Base)
                loop
                    set SysUnit=FirstOfGroup(g2)
                    exitwhen SysUnit == null
                    if GetWidgetLife(SysUnit) > 0.405 and SysUnit != LoadUnitHandle(HH,MUIHandle(),CasterHash) and Condition_Base(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)),SysUnit)  then
                        call SaveReal(HH, id, StringHash("ang"), ang - 0.14)
                        if LoadFloat("fh") < 500 then
                            call SaveReal(HH, id, StringHash("fh"), LoadFloat("fh") + 4)
                        endif
                        if LoadBoolean(HH,GetHandleId(SysUnit),DoflaTHash)==false then
                            call SetUnitXY_1(SysUnit , GetUnitX(SysUnit) - 25 * Cos(Atan2(GetUnitY(SysUnit) - ( y - 250 * Sin(ang) ), GetUnitX(SysUnit) - ( x - 250 * Cos(ang) ))) , GetUnitY(SysUnit) - 25 * Sin(Atan2(GetUnitY(SysUnit) - ( y - 250 * Sin(ang) ), GetUnitX(SysUnit) - ( x - 250 * Cos(ang) ))) , false)
                        endif
                        call myCustomDamage(LoadUnitHandle(HH,MUIHandle(),CasterHash), SysUnit, dmg * 0.092, false, false, null, null, null)
                        if IsUnitInvulnerable(SysUnit)==false then
                            call IssueImmediateOrder(SysUnit,"stop")
                            call SetControlToUnit(SysUnit,SysUnit,0.06,"stunbkb")
                        endif
                        if time < 3.5 then
                            call UnitAddAbility(SysUnit, 'Arav')
                            if GetUnitFlyHeight(SysUnit)<500 then
                            call SetUnitFlyHeight(SysUnit, GetUnitFlyHeight(SysUnit) + LoadFloat("fh"), 0)
                            endif
                            call UnitRemoveAbility(SysUnit, 'Arav')
                        else
                            call UnitAddAbility(SysUnit, 'Arav')
                            call SetUnitFlyHeight(SysUnit, 0, 1100)
                            call UnitRemoveAbility(SysUnit, 'Arav')
                        endif
                    endif
                    call GroupRemoveUnit(g2, SysUnit)
                endloop
                call DestroyGroup(g2)
            endif
        endif
        
        if time > 6. then
            call DestroyGroup(g2)
            call Clear(id)
        endif
        set g2=null
    endfunction
    
   function WendyT takes nothing returns nothing
        local integer id= (GetHandleId(GetExpiredTimer())) // INLINED!!
        local real time= LoadFloat("Time")
        local real x= GetUnitX(LoadUnitHandle(HH,MUIHandle(),CasterHash))
        local real y= GetUnitY(LoadUnitHandle(HH,MUIHandle(),CasterHash))
        
        if time == 0. then
            call SetUnitAnimationByIndex(LoadUnitHandle(HH,MUIHandle(),CasterHash), 10)
            set soundplay=CreateSound("Sound\\Music\\mp3Music\\WendyT.mp3", false, false, true, 12700, 12700, "")
            call StartSound(soundplay)
            call KillSoundWhenDone(soundplay)
            call SaveReal(HH, id, TickHash, 0.)
        endif
        
        if time < 2 then
            call SaveReal(HH, id, TIME_HASH, time + 0.01)
        endif
        
        if IsUnitPaused(LoadUnitHandle(HH,MUIHandle(),CasterHash)) == false and IsUnitHidden(LoadUnitHandle(HH,MUIHandle(),CasterHash))==false and time >= 2 then
            call SaveReal(HH, id, TIME_HASH, time + 0.01)
            if udg_B==false then
                call SaveReal(HH, id, TIME_HASH, time + 27)
            endif
        endif
        
