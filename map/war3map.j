local real y=LoadReal(h,id,3)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real dist=LoadReal(h,id,15)
local real a=LoadReal(h,id,4)
if dist<1300 and UnitIsAlive(c)and UnitIsAlive(u)and GetUnitAbilityLevel(u,'A3IH')==0 and GetUnitAbilityLevel(c,'A3IH')==0 and ((GetUnitAbilityLevel(u,'A0IH')==0 and GetUnitAbilityLevel(c,'A0IH')==0) or (GetUnitAbilityLevel(u,'A0IH')>0 and GetUnitAbilityLevel(c,'A0IH')>0))then
call SetUnitXY_1(c,x1+25*Cos(a),y1+25*Sin(a), false)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",x1,y1))
call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",x1,y1))
call SetUnitXY_1(u,x1,y1, false)
