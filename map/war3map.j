endif





call SetTextTagVelocity(LoadTextTagHandle(HH,GetHandleId(Dummy),TextTagTargetHash),0.2*Cos(1.571),0.2*Sin(1.571))
call SetTextTagFadepoint(LoadTextTagHandle(HH,GetHandleId(Dummy),TextTagTargetHash),0.5)
