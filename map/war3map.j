call UnitApplyTimedLife(CreateUnit(p,'e0DF',x,y,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0DE',x,y,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0DD',x,y,GetRandomReal(0,359)),'BTLF',2)
