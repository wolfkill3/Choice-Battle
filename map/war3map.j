call UnitApplyTimedLife(CreateUnit(p,'e0DL',x1,y1,GetRandomReal(0,359)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0DK',x1,y1,GetRandomReal(0,359)),1,3)
