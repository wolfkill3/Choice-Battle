call UnitApplyTimedLife(CreateUnit(p,'e0AZ',x,y,GetRandomReal(0,359)),'BTLF',0.4)
call UnitApplyTimedLife(CreateUnit(p,'e0B3',x,y,GetRandomReal(0,359)),'BTLF',0.4)
