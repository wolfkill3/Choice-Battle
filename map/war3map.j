function Sema3Cast5 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real dmg=(4+GetUnitAbilityLevel(u,0x41304F37))*GetHeroInt(u,true)+200
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,4)
local real y1=LoadReal(h,id,5)
local real a=LoadReal(h,id,3)
local real dist=LoadReal(h,id,2)
local real dist2=LoadReal(h,id,6)
local real time=LoadReal(h,id,7)
local player p=GetOwningPlayer(u)
local real he=GetUnitFlyHeight(l__d)-30
local real sr=SR(x,y,x1,y1)
if he>0 and GetWidgetLife(l__d)>0 then
call SetUnitFlyHeight(l__d,he,0)
else
call UnitApplyTimedLife(CreateUnit(p,'e0S4',x,y,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e0S3',x,y,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e0S2',x,y,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e0S6',x,y,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e0S7',x,y,GetRandomReal(0,359)),'BTLF',3)
call GroupEnumUnitsInRange(G,x1,y1,650,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 4, "stun")
endif
call GroupRemoveUnit(G,E)
endloop
call SetTerrainFogExBJ(0,6000.00,10000,0,1,1,1)
call RemoveUnit(l__d)
call RemoveUnit(LoadUnitHandle(h,id,1))
call RemoveUnit(LoadUnitHandle(h,id,2))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set u=null
set p=null
set t=null
endfunction
