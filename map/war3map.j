function OrochimaruECast4 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit c=LoadUnitHandle(h,id,1)
    local real time=LoadReal(h,id,3)
    local real sm=LoadReal(h,id,12)
    local real m=GetUnitState(c,UNIT_STATE_MANA)
    call SaveReal(h,id,3,time+0.05)
    if time<4+GetUnitAbilityLevel(u,'ore9') and m>=1 then
    call myCustomDamage(u,c,SquareRoot((sm-m)*(sm-m)),false,false,null,DAMAGE_TYPE_UNIVERSAL,null)
    call SaveReal(h,id,12,GetUnitState(c,UNIT_STATE_MANA))
    else
    call UnitRemoveAbility(c,0x6f726531)
    call DestroyTimer(t)
    call FlushChildHashtable(h,id)
    endif
    set t=null
    set u=null
    set c=null
endfunction
