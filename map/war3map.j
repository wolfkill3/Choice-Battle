function QAtalanta2Cast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real dmg=LoadReal(h,id,6)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real a=LoadReal(h,id,3)
local real dist=LoadReal(h,id,2)
local real rd=LoadReal(h,id,4)
local player p=GetOwningPlayer(u)
if dist<2500+rd*2 and GetWidgetLife(l__d)>0 then
set x=x+75*Cos(a)
set y=y+75*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SaveReal(h,id,2,dist+75)
set n=CreateUnit(p,'e134',x,y,a*bj_RADTODEG)
call SetUnitTimeScale(n,2)
call UnitApplyTimedLife(n,'BTLF',0.3)
call GroupEnumUnitsInRange(G,x,y,100,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",E,"chest"))
call myCustomDamage(u,E,dmg,false,false,null,null,null)
set n=CreateUnit(p,'e131',GetUnitX(E),GetUnitY(E),a*bj_RADTODEG)
call SetUnitTimeScale(n,2)
call UnitApplyTimedLife(n,'BTLF',3)
call SetControlToUnit(E,E, 2, "stun")
call AtalantaPush(E,50,a,350+rd)
call KillUnit(l__d)
endif
call GroupRemoveUnit(G,E)
endloop
else
call RemoveSavedHandle(h,GetHandleId(u),SH_arrow)
call SetUnitTimeScale(u,1)
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set u=null
set p=null
set t=null
endfunction
function QAtalanta2Cast2 takes nothing returns nothing
