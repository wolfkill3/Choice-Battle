function BlackGokuZamasuRAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit Dummy=LoadUnitHandle(HH,GetHandleId(caster),SH_Zamasu)
local unit target=LoadUnitHandle(HH,id,2)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real x0=GetUnitX(Dummy)
local real y0=GetUnitY(Dummy)
local real x1=GetUnitX(target)
local real y1=GetUnitY(target)
local boolean targinv=false
local boolean targpaus=false
set time=time+0.02
call SaveReal(HH,id,5,time)
if time>=3 or GetUnitAbilityLevel(target,'B05G')>0 then
call SaveBoolean(HH,GetHandleId(caster),SH_ZamasuSpell,false)
call SetUnitAnimationByIndex(Dummy,0)
call UnitSpeed(Dummy,1)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else
if time<2 then
call MoveAoe1(LoadReal(HH,id,11),LoadReal(HH,id,12),target,0,facing)
endif
if time==0.02 then
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(3656) // Sound\Music\mp3Music\SoundEng\BlackGokuRFeng.mp3
call StartSound(soundplay)
// call KillSoundWhenDone(soundplay)

else
set soundplay=SndN(3659) // Sound\Music\mp3Music\SoundJap\BlackGokuRF.mp3
call StartSound(soundplay)
// call KillSoundWhenDone(soundplay)

endif
set facing=Angle2(x0,y0,x1,y1)
call SetUnitFacing(Dummy,facing-180)
call SaveReal(HH,id,3,facing)
call IssueImmediateOrder(Dummy,"stop")
call SaveBoolean(HH,GetHandleId(caster),SH_ZamasuSpell,true)
if GetRandomInt(1,2)==1 then
call SetUnitAnimationByIndex(Dummy,7)
else
call SetUnitAnimationByIndex(Dummy,8)
endif
call SaveReal(HH,id,11,GetUnitX(target))
call SaveReal(HH,id,12,GetUnitY(target))
call EffectCreateAndMove(true,"BlackGoku\\BlackBlink1.mdl",facing,1,1,1,100,100,100,0,0,Dummy,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",facing,1,1,1,100,100,100,40,0,Dummy,0,facing)
call MoveUnit(target,Dummy,150,facing)
call EffectCreateAndMove(true,"BlackGoku\\HakenSaber2.mdl",facing,1,0.5,0.5,100,100,100,0,0,Dummy,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\[A]az_axe_ef1.mdl",facing,1,0.5,0.5,100,100,100,40,0,Dummy,0,facing)
endif
if time==0.5 then
call UnitSpeed(Dummy,0)
endif
if time>0.02 and time<2 then
call SetUnitFacing(Dummy,facing-180)
call MoveUnit(target,Dummy,150,facing)
endif
if time==0.1 then
call EffectCreateAndMove(true,"BlackGoku\\qqqqqr.mdl",facing,1,1.5,0.7,100,100,100,0,50,target,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\Kamijo-2.mdl",facing,1,1,1,100,100,100,0,50,target,0,facing)
call EffectCreateAndMove90(true,"BlackGoku\\Kamijo-2.mdl",facing,1,1,1,100,100,100,0,50,target,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\dustwaveanimate2.mdl",facing,1,1,1,100,100,100,30,0,target,0,facing)
call EffectCreateAndMove45(true,"BlackGoku\\[a]wavejojo.mdl",facing,1,1,0.5,100,100,100,0,100,target,0,facing)
call EffectCreateAndMove45(true,"BlackGoku\\[a]wavejojo.mdl",facing+180,1,1,0.5,100,100,100,0,100,target,0,facing)
if GetUnitAbilityLevel(target,'Avul')>0 then
set targinv=true
call SetUnitInvulnerable(target,false)
endif
if IsUnitPaused(target)==true then
set targpaus=true
call SetUnitInvulnerable(target,false)
endif

if targinv==true then
call SetUnitInvulnerable(target,true)
endif
if targpaus==true then
call PauseUnit(target,true)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
endif
endif
if time==0.1 or time==0.4 or time==0.8 or time==1.2 or time==1.6 then
call EffectCreateAndMove(true,"BlackGoku\\[A]az_axe_ef1.mdl",facing,1,0.8,1,100,100,100,30,0,target,0,facing)
endif
if time==2 then
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(3662) // Sound\Music\mp3Music\SoundEng\BlackGokuRF2eng.mp3
call StartSound(soundplay)
// call KillSoundWhenDone(soundplay)

else
set soundplay=SndN(3665) // Sound\Music\mp3Music\SoundJap\BlackGokuRF2.mp3
call StartSound(soundplay)
// call KillSoundWhenDone(soundplay)

endif
call SetUnitAnimationByIndex(Dummy,0)
endif
endif
set target=null
set Dummy=null
set caster=null
endfunction


