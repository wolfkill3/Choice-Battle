function ShockingBallCond takes nothing returns boolean
return GetSpellAbilityId()=='A0K2' and udg_B==true
endfunction
function ShockingBallCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,3)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,8)
local real y1=LoadReal(h,id,9)
local real time=LoadReal(h,id,10)+0.05
local real a=Atan2(y1-y,x1-x)
local real dmg=(2+GetUnitAbilityLevel(u,'A0K2'))*GetHeroStr(u,true)+125
local real l__s=LoadReal(h,id,7)+0.35
call SaveReal(h,id,10,time)
if time==0.05 then
call SetUnitInvulnerable(u,true)
call PauseUnit(u,true)
call SetUnitAnimation(u,"Spell Channel Two")
set n=CreateUnit(GetOwningPlayer(u),'e0F0',x,y,a*bj_RADTODEG)
call SetUnitScale(n,0.1,0.1,0.1)
call SaveUnitHandle(h,id,3,n)
endif
if time<1 then
call SetUnitInvulnerable(u,true)
call PauseUnit(u,true)
endif
if time>0 and time<=1 then
call SetUnitScale(l__d,l__s,l__s,l__s)
call SaveReal(h,id,7,l__s)
elseif time>1 then
call MissleMoveShockingBall(u,x1,y1,l__d,80,0,dmg)
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set u=null
set t=null
endfunction
