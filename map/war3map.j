        set soundplay=SndN(1747) // Sound\war3mapImported\VergilE2.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call UpperSlashMissleFly(u,60,0,x,y,400,0)
