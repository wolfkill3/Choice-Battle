local real dist=LoadReal(h,id,7)
local player p=GetOwningPlayer(u)
if dist>speed and UnitIsAlive(l__d)then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
if sm>speed then
call SaveReal(h,id,1,speed+speed*0.04)
endif
call GroupEnumUnitsInRange(G,x,y,95,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call EffectToRandomBone("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",E)
if GetUnitAbilityLevel(E,0x416F3634)==0 and LoadBoolean(h,id,13)==false then
call KireiQPush(E,40,a,200)
call UnitAddAbility(E,0x416F3634)
call UnitRemoveAbilityTimed(E,0x416F3634,1)
elseif GetUnitAbilityLevel(E,0x416F3634)!=0 and LoadBoolean(h,id,13)==true then
call SetControlToUnit(E,E, 2, "stun")
endif
call KillUnit(l__d)
endif
call GroupRemoveUnit(G,E)
endloop
call SaveReal(h,id,7,dist-speed)
else
call UnitApplyTimedLife(l__d,'BTLF',LoadReal(h,id,8))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set p=null
set l__d=null
set t=null
endfunction
