function DanzoRAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local unit Dummy=LoadUnitHandle(HH,id,20)
local real x0=LoadReal(HH,id,11)
local real y0=LoadReal(HH,id,12)
local real x1=GetUnitX(Dummy)
local real y1=GetUnitY(Dummy)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real damage=LoadReal(HH,id,15)
local real distance
set time=time+0.02
set distance=LoadReal(HH,id,8)
call SaveReal(HH,id,5,time)
if distance==500 then
call UnitCreateAndMove(caster,0x64733337,caster,facing,1,4,0.6,100,100,100,60,200,Dummy,0,facing)
call UnitCreateAndMove(caster,0x64733335,caster,facing,1,8,0.6,100,100,100,30,200,Dummy,0,facing)
call UnitCreateAndMove(caster,'ds26',caster,facing,1,2,0.9,100,100,100,30,50,Dummy,0,facing)
call UnitCreateAndMove(caster,0x64733338,caster,facing,1,2,0.4,100,100,100,0,200,Dummy,0,facing)
call GroupClear(G)
call GroupEnumUnitsInRange(G,x1,y1,500,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if Condition_Base(GetOwningPlayer(caster),n0) then
if GetUnitAbilityLevel(n0,'DST2')>0 then
set damage=damage*1.3
endif


call myCustomDamage(caster,n0,damage,false,false,null,null,null)


set facing=facing+0.2*Angle2(x1,y1,GetUnitX(n0),GetUnitY(n0))
call PushTimed(n0,facing,50,10)
call SetControlToUnit(caster,n0, 2, "stun")
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
call SetUnitAnimationByIndex(Dummy,1)
call MyRemoveUnit(Dummy,3)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
else
if time==0.02 or time==0.4 or time==0.8 then
call UnitCreateAndMove(caster,'ds30',caster,GetRandomReal(0,360),1,1,0.75,100,100,100,40,0,caster,0,facing)
call UnitCreateAndMove(caster,'ds24',caster,GetRandomReal(0,360),1,0.5,0.75,100,100,100,10,0,caster,0,facing)
endif
if time==0.02 then
call UnitCreateAndMove(caster,'ds36',caster,facing,0.65,0.75,1.5,100,100,100,0,100,caster,100,facing)
if GetRandomInt(1,2)==1 and GetHeroLevel(caster)>12 then
call DanzoGPassive(caster,facing,GetHeroInt(caster,true)*2)
endif
call UnitSpeed(caster,0.5)
if LoadBoolean(HH,GetHandleId(caster),StringHash("DanzoFBool"))==true then
call SetUnitAnimationByIndex(caster,13)
else
call SetUnitAnimationByIndex(caster,24)
endif
endif
if time<1 then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
endif
if time==1 then
call UnitSpeed(caster,1)
call UnitCreateAndMove(caster,'ds22',caster,facing,1,0.35,0.5,100,100,100,0,100,caster,100,facing)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\DanzoRHit.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
endif
if time==0.5 then
set n0=CreateUnit(GetOwningPlayer(caster),0x64733036,GetUnitX(caster),GetUnitY(caster),facing)
call UnitSize(n0,0.2,1,1)
call MoveUnit(n0,n0,200,facing)
call SetUnitFlyHeight(n0,200,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=null
endif
if time>0.5 and time<1 then
call UnitSize(Dummy,0.2+(time-0.5)*1.5,1,1)
call GroupClear(G)
call GroupEnumUnitsInRange(G,x1,y1,200+(time-0.5)*300,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if SR(GetUnitX(n0),GetUnitY(n0),x1,y1)>50 and Condition_Base(GetOwningPlayer(caster),n0) then
call MoveUnit(n0,n0,10,Angle2(GetUnitX(n0),GetUnitY(n0),x1,y1))
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
endif
if time>1 then
call UnitSize(Dummy,0.2+(time-0.5)*1.5,1,1)
call MoveUnit(Dummy,Dummy,20,facing)
call SaveReal(HH,id,8,distance+20)
call GroupClear(G)
call GroupEnumUnitsInRange(G,x1,y1,350,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if SR(GetUnitX(n0),GetUnitY(n0),x1,y1)>50 and Condition_Base(GetOwningPlayer(caster),n0) then
call MoveUnit(n0,n0,20,Angle2(GetUnitX(n0),GetUnitY(n0),x1,y1))
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
endif
endif
set t=null
set Dummy=null
set caster=null
endfunction

function DanzoTClearDebuff takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local real x0=LoadReal(HH,id,11)
local real y0=LoadReal(HH,id,12)
local real time=LoadReal(HH,id,5)
if time<7.05 then

call SlowUnit(GetEnumUnit(),GetEnumUnit(),0.5,0.5,0.055,2,false)

if SR(GetUnitX( GetEnumUnit() ),GetUnitY( GetEnumUnit() ),x0,y0)>150 then
call MoveUnit( GetEnumUnit() , GetEnumUnit() ,30+2000/SR(GetUnitX( GetEnumUnit() ),GetUnitY( GetEnumUnit() ),x0,y0),Angle2(GetUnitX( GetEnumUnit() ),GetUnitY( GetEnumUnit() ),x0,y0))
endif

endif

if time==7.05 or SR(GetUnitX(GetEnumUnit()),GetUnitY(GetEnumUnit()),x0,y0)>800 then
call GroupRemoveUnit(LoadGroupHandle(HH,id,4), GetEnumUnit() )
endif

set t=null
endfunction

