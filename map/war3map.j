function Trig_CAI_Armor_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local unit d1=LoadUnitHandle(h,id,2)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
if GetUnitAbilityLevel(u,'B01G')>0 then
call SetUnitX(l__d,x+100*Cos((f+45)*bj_DEGTORAD))
call SetUnitY(l__d,y+100*Sin((f+45)*bj_DEGTORAD))
call SetUnitX(d1,x+100*Cos((f-45)*bj_DEGTORAD))
call SetUnitY(d1,y+100*Sin((f-45)*bj_DEGTORAD))
call SetUnitFacing(l__d,f+45)
call SetUnitFacing(d1,f-45)
else
call RemoveUnit(l__d)
call RemoveUnit(d1)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set d1=null
set u=null
set l__d=null
set t=null
endfunction
