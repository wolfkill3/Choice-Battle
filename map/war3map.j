function XanxusEAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster
local unit target
local real facing
local real time
local real x1
local real y1
local unit Dummy
local real damage
local real cof
set caster=LoadUnitHandle(HH,id,1)
set target=LoadUnitHandle(HH,id,2)
set facing=LoadReal(HH,id,3)
set time=LoadReal(HH,id,5)
set x1=LoadReal(HH,id,11)
set y1=LoadReal(HH,id,12)
set Dummy=null
set damage=LoadReal(HH,id,15)
set time=time+0.02
call SaveReal(HH,id,5,time)
if time==20.02 then

call SetUnitFlyHeight(LoadUnitHandle(HH,id,21),0,0)
call SetUnitFlyHeight(LoadUnitHandle(HH,id,22),0,0)

call UnitCreateAndMove(caster,0x78613032,caster,GetRandomReal(0,360),1.5,1.8,0.5,100,100,100,0,-100,LoadUnitHandle(HH,id,21),0,facing)
call UnitCreateAndMove(caster,0x78613032,caster,GetRandomReal(0,360),1.5,1.8,0.5,100,100,100,0,-100,LoadUnitHandle(HH,id,22),0,facing)
set soundplay=SndN(4055) // Sound\Music\mp3Music\XanxusG.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call GroupClear(G)
call GroupEnumUnitsInRange(G,x1,y1,500,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if Condition_Base(GetOwningPlayer(caster),n0) then
call myCustomDamage(caster,n0,damage,false,false,null,null,null)
call SetControlToUnit(caster,n0, 2, "stun")
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
call MyRemoveUnit(LoadUnitHandle(HH,id,20),2)
call RemoveUnit(LoadUnitHandle(HH,id,21))
call RemoveUnit(LoadUnitHandle(HH,id,22))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
else
if time<0.76 then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
endif
if time==0.02 then
call SetUnitAnimationByIndex(caster,5)
//call SetUnitAnimationByIndex(caster,1)
call UnitSpeed(caster,0.4)
endif
//if time==0.3 then
//call UnitSpeed(caster,0.5)
//call SetUnitAnimationByIndex(caster,5)
//endif
if time==0.76 then
call UnitSpeed(caster,1)
if LoadEffectHandle(HH,id,23)!=null then
call DestroyEffect(LoadEffectHandle(HH,id,23))
call SaveEffectHandle(HH,id,23,null)
endif
if LoadEffectHandle(HH,id,24)!=null then
call DestroyEffect(LoadEffectHandle(HH,id,24))
call SaveEffectHandle(HH,id,24,null)
endif
call SetUnitFlyHeight(caster,0,600)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
call UnitSpeed(caster,1)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call UnitSize(n0,1,1,1)
call MoveUnit(n0,n0,50,facing)
call SaveReal(HH,id,8,SR(GetUnitX(n0),GetUnitY(n0),LoadReal(HH,id,11),LoadReal(HH,id,12)))
call SetUnitFlyHeight(n0,600,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=CreateUnit(GetOwningPlayer(caster),0x78613031,GetUnitX(caster),GetUnitY(caster),facing)
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call UnitSize(n0,1,1,1)
call MoveUnit(LoadUnitHandle(HH,id,20),n0,75,facing+90)
call SetUnitFlyHeight(n0,600,0)
call SaveUnitHandle(HH,id,21,n0)
set n0=CreateUnit(GetOwningPlayer(caster),0x78613031,GetUnitX(caster),GetUnitY(caster),facing)
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call UnitSize(n0,1,1,1)
call MoveUnit(LoadUnitHandle(HH,id,20),n0,75,facing-90)
call SetUnitFlyHeight(n0,600,0)
call SaveUnitHandle(HH,id,22,n0)
set n0=null
endif
if time>0.76 then
set Dummy=LoadUnitHandle(HH,id,20)
set cof=SR(GetUnitX(Dummy),GetUnitY(Dummy),LoadReal(HH,id,11),LoadReal(HH,id,12))/LoadReal(HH,id,8)
if SR(GetUnitX(Dummy),GetUnitY(Dummy),LoadReal(HH,id,11),LoadReal(HH,id,12))>50 then
set facing=Angle2(GetUnitX(Dummy),GetUnitY(Dummy),LoadReal(HH,id,11),LoadReal(HH,id,12))
call MoveUnit(Dummy,Dummy,30,facing)
call MoveUnit(Dummy,LoadUnitHandle(HH,id,21),75,facing+90)
call MoveUnit(Dummy,LoadUnitHandle(HH,id,22),75,facing-90)
//call SetUnitFlyHeight(Dummy,GetUnitFlyHeight(Dummy)-LoadReal(HH,id,8),0)
call SetUnitFlyHeight(Dummy,600*cof,0)
//call SetUnitFlyHeight(Dummy,GetUnitFlyHeight(Dummy)-LoadReal(HH,id,8),0)
call SetUnitFlyHeight(LoadUnitHandle(HH,id,21),GetUnitFlyHeight(Dummy),0)
call SetUnitFlyHeight(LoadUnitHandle(HH,id,22),GetUnitFlyHeight(Dummy),0)
else
set time=20
call SaveReal(HH,id,5,time)
endif
endif
endif
set Dummy=null
set target=null
set caster=null
set t=null
endfunction
function XanxusChoice_Act takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x0
local real y0
local real x1
local real y1
local real facing
local unit caster
set caster=GetTriggerUnit()
set x0=GetUnitX(caster)
set y0=GetUnitY(caster)
set x1=GetSpellTargetX()
set y1=GetSpellTargetY()
set facing=Angle2(x0,y0,x1,y1)
call SaveUnitHandle(HH,id,1,caster)
call SaveReal(HH,id,11,x1)
call SaveReal(HH,id,12,y1)
call SaveReal(HH,id,3,facing)
if GetSpellAbilityId()=='XanE' then
call UnitCreateAndMove(caster,0x78613033,caster,GetRandomReal(0,360),1.5,1.25,1,100,100,100,60,0,caster,0,facing)
call UnitAddAbility(caster,'Amrf')
call UnitRemoveAbility(caster,'Amrf')
if SR(x0,y0,x1,y1)>600 then
call SaveReal(HH,id,8,0.2*SR(x0,y0,x1,y1)/30)
else
call SaveReal(HH,id,8,SR(x0,y0,x1,y1)/30)
call MoveAoe1(x1,y1,caster,-600,facing)
endif
call SetUnitFlyHeight(caster,600,0)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
set soundplay=SndN(4058) // Sound\Music\mp3Music\XanxusGExp.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять




if LoadBoolean(HH,GetHandleId(caster),SH_XanFBuff)==true then
call SaveBoolean(HH,GetHandleId(caster),SH_XanFBuff,false)
call SaveReal(HH,id,15,(4+GetUnitAbilityLevel(caster,'XanE'))*GetHeroAgi(caster,true)+GetHeroAgi(caster,true)*(4+GetUnitAbilityLevel(caster,'XanE'))*GetUnitAbilityLevel(caster,'B05E')*0.3)
else
call SaveReal(HH,id,15,(3+GetUnitAbilityLevel(caster,'XanE'))*GetHeroAgi(caster,true)+GetHeroAgi(caster,true)*(3+GetUnitAbilityLevel(caster,'XanE'))*GetUnitAbilityLevel(caster,'B05E')*0.3)
endif
call SaveEffectHandle(HH,id,23,AddSpecialEffectTarget("Other\\MeteorGlow.mdl",caster,"hand left"))
call SaveEffectHandle(HH,id,24,AddSpecialEffectTarget("Other\\MeteorGlow.mdl",caster,"hand right"))
call TimerStart(t,0.02,true,function XanxusEAct)
endif
if GetSpellAbilityId()=='XanF' then
call SetUnitAnimationByIndex(caster,1)
set soundplay=SndN(4060) // Sound\Music\mp3Music\XanxusF.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SaveBoolean(HH,GetHandleId(caster),SH_XanFBuff,true)
call SaveEffectHandle(HH,id,23,AddSpecialEffectTarget("other\\[A]supershinythingyGon.mdl",caster,"hand left"))
call SaveEffectHandle(HH,id,24,AddSpecialEffectTarget("other\\[A]supershinythingyGon.mdl",caster,"hand right"))
call TimerStart(t,0.02,true,function XanxusFAct)
endif
set t=null
set caster=null
endfunction
function XanxusChoice_Cond takes nothing returns boolean
if GetSpellAbilityId()=='XanE' or GetSpellAbilityId()=='XanF' then
return true
else
return false
endif
endfunction
