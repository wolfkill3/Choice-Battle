function Slash_Death2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local player p=GetOwningPlayer(l__d)
local real speed=LoadReal(h,id,1)
local real x=LoadReal(h,id,3)
local real y=LoadReal(h,id,4)
local group g=LoadGroupHandle(h,id,5)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,2)
local real dmg=LoadReal(h,id,6)
local real Range=LoadReal(h,id,9)
if SR(x,y,x1,y1)<=Range then
set x1=x1+speed*Cos(a)
set y1=y1+speed*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call GroupEnumUnitsInRange(g,x1,y1,LoadReal(h,id,10),Base)
call UnitApplyTimedLife(CreateUnit(p,'e08C',x1,y1,GetUnitFacing(l__d)),'BTLF',0.7)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
call myCustomDamage(ks,E,dmg,false,false,null,null,null)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",E,"chest"))
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
else
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,GetHandleId(g))
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
endif
set p=null
set t=null
set g=null
set l__d=null
endfunction
function Slash_Death takes unit l__d,real speed,real dmg,real angle,real range,real mas,real x,real y returns nothing
