call DestroyEffect(EFF)
set EFF=AddSpecialEffect("AuraExplOrange.mdl", x, y)
call SetSpecialEffectScale(EFF , 2)
call DestroyEffect(EFF)
elseif GetUnitAbilityLevel(u,'A171')>0 then
set EFF=AddSpecialEffect("blue--zhendi.mdl", x, y)
call SetSpecialEffectScale(EFF , 1.5)
call DestroyEffect(EFF)
set EFF=AddSpecialEffect("AuraExplBlue.mdl", x, y)
call SetSpecialEffectScale(EFF , 2)
call DestroyEffect(EFF)
endif
endif
else
call SetUnitTimeScale(u,0.4)
call SaveReal(h,id,2,0)
call PauseTimer(t)
if GetUnitAbilityLevel(u,'A170')>0 then
    call SetUnitAnimationByIndex(u,65)
else
    call SetUnitAnimationByIndex(u,21)
endif
if GetUnitAbilityLevel(u,'A16X')>0 then
call UnitAddAbility(u,'A26X')
elseif GetUnitAbilityLevel(u,'A16Y')>0 then
call UnitAddAbility(u,'A27X')
elseif GetUnitAbilityLevel(u,'A170')>0 then
call UnitAddAbility(u,'A28X')
elseif GetUnitAbilityLevel(u,'A171')>0 then
call UnitAddAbility(u,'A29X')
endif
call TimerStart(t,0.02,true,function GogetaTCast3)
endif
set t=null
set p=null
set u=null
endfunction
function GogetaTCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local player p=GetOwningPlayer(u)
local real a=Atan2(y1-y,x1-x)
local real sc=0
local real is=0
local real ig=30*bj_DEGTORAD
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,4,c)
call SaveReal(h,id,1,a)
call SaveReal(h,id,2,0)
call SaveReal(h,id,3,1)
call SaveReal(h,id,4,0)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call UnitRemoveAbility(u,'A2VJ')
call UnitRemoveAbility(c,'A2VJ')
if GetUnitAbilityLevel(u,'A170')>0 then
    call SetUnitAnimationByIndex(u,66)
else
    call SetUnitAnimationByIndex(u,22)
endif
call SetUnitTimeScale(u,0.7)
loop
exitwhen is>=13
set n=CreateUnit(p,'e0ZH',x+350*Cos(ig*is),y+350*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,255,255,255,55)
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.5)
set is=is+1
endloop
set EFF = AddSpecialEffect("Hashirama\\SmokeFuzzy.mdl",x, y)
call SetSpecialEffectScale(EFF, 3.3)
call SetSpecialEffectTimeScale(EFF , 1.6)
call DestroyEffect(EFF)
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(2884) // Sound\Music\mp3Music\GogetaT1.mp3
else
set soundplay=SndN(2886) // Sound\Music\mp3Music\Gogeta\GogetaT1-jap.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.05,true,function GogetaTCast2)
set t=null
set u=null
set p=null
set c=null
endfunction
