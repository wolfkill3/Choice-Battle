function EOrihimeCast4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit d1=LoadUnitHandle(h,id,3)
local unit d2=LoadUnitHandle(h,id,4)
local unit d3=LoadUnitHandle(h,id,2)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(d1)
local real y1=GetUnitY(d1)
local integer idd=GetHandleId(c)
local real a=0
local player p=GetOwningPlayer(u)
if UnitIsAlive(d1)or UnitIsAlive(d2)or UnitIsAlive(d3)then
if SR(x,y,x1,y1)>90 and UnitIsAlive(d1)and UnitIsAlive(u)then
set a=Atan2(y-y1,x-x1)-0.25
set x1=x1+70*Cos(a)
set y1=y1+70*Sin(a)
call SetUnitX(d1,x1)
call SetUnitY(d1,y1)
elseif UnitIsAlive(d1)then
call KillUnit(d1)
endif
set x1=GetUnitX(d2)
set y1=GetUnitY(d2)
if SR(x,y,x1,y1)>90 and UnitIsAlive(d2)and UnitIsAlive(u)then
set a=Atan2(y-y1,x-x1)+0.25
set x1=x1+70*Cos(a)
set y1=y1+70*Sin(a)
call SetUnitX(d2,x1)
call SetUnitY(d2,y1)
elseif UnitIsAlive(d2)then
call KillUnit(d2)
endif
set x1=GetUnitX(d3)
set y1=GetUnitY(d3)
if SR(x,y,x1,y1)>90 and UnitIsAlive(d3)and UnitIsAlive(u)then
set a=Atan2(y-y1,x-x1)
set x1=x1+65*Cos(a)
set y1=y1+65*Sin(a)
call SetUnitX(d3,x1)
call SetUnitY(d3,y1)
elseif UnitIsAlive(d3)then
call KillUnit(d3)
endif
else
call RemoveSavedHandle(h,GetHandleId(u),'A1HB')
call RemoveSavedHandle(h,GetHandleId(u),'A1HB'+1)
call UnitRemoveAbility(c,'A1HG')
call RemoveSavedHandle(h,idd,SH_ore2)
call RemoveSavedReal(h,idd,SH_ore1)
call RemoveSavedReal(h,idd,SH_ore3)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set c=null
set d2=null
set d3=null
set d1=null
set t=null
set u=null
endfunction
function EOrihimeCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit d1=LoadUnitHandle(h,id,13)
local real time=LoadReal(h,id,10)
local real x=GetUnitX(c)
local real y=GetUnitY(c)
local real x1=0
local real y1=0
local real a=GetUnitFacing(c)*bj_DEGTORAD
local player p=GetOwningPlayer(u)
local integer i=0
if time>0 and GetUnitAbilityLevel(c,'A1HG')>0 then
if GetUnitAbilityLevel(d1,'A1HF')==0 then
set x=x+75*Cos(a)
set y=y+75*Sin(a)
call SetUnitX(d1,x)
call SetUnitY(d1,y)
call SetUnitFacing(d1,a*bj_RADTODEG)
else
set a=GetUnitFacing(d1)*bj_DEGTORAD
set x=x+75*Cos(a)
set y=y+75*Sin(a)
call SetUnitX(d1,x)
call SetUnitY(d1,y)
endif
if IsUnitPaused(c)==false and GetUnitAbilityLevel(c,'Pet1')==0 then
call SaveReal(h,id,10,time-0.02)
endif
else
set n=CreateUnit(p,'e16G',x,y,0)
call UnitApplyTimedLife(n,'BTLF',1)
call RemoveUnit(d1)
set n=LoadUnitHandle(h,id,2)
call SetUnitFlyHeight(n,125,0)
call SetUnitX(n,x)
call SetUnitY(n,y)
set n=LoadUnitHandle(h,id,3)
call SetUnitFlyHeight(n,125,0)
call SetUnitX(n,x)
call SetUnitY(n,y)
set n=LoadUnitHandle(h,id,4)
call SetUnitFlyHeight(n,125,0)
call SetUnitX(n,x)
call SetUnitY(n,y)
call PauseTimer(t)
call TimerStart(t,0.03,true,function EOrihimeCast4)
endif
set d1=null
set p=null
set t=null
set u=null
set c=null
