function InitTrig_SabracChoice takes nothing returns nothing
local trigger SabracChoice=CreateTrigger()
local integer index
set index=0
loop
call TriggerRegisterPlayerUnitEvent(SabracChoice,Player(index),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
