function Trig_Tornado_Tempo_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local real l__d=LoadReal(h,id,8)
local player p=GetOwningPlayer(u)
local unit l__dm
local unit l__n
local real f
if SR(x,y,x1,y1)>32 and LoadBoolean(h,id,7)==false then
set l__n=CreateUnit(p,0x6530324D,x+40*Cos(a),y+40*Sin(a),a*bj_RADTODEG)
call DestroyEffect(AddSpecialEffect("war3mapImported\\AirEssence.mdx",GetUnitX(l__n),GetUnitY(l__n)))
call UnitApplyTimedLife(l__n,'BTLF',0.75)
call UnitAddAbility(l__n,'Arav')
call SaveReal(h,id,2,GetUnitX(l__n))
call SaveReal(h,id,3,GetUnitY(l__n))
else
call SaveBoolean(h,id,7,true)
endif
if l__d<700 and LoadBoolean(h,id,7)==true then
set l__n=CreateUnit(p,0x6530324D,x+40*Cos(a),y+40*Sin(a),a*bj_RADTODEG)
call DestroyEffect(AddSpecialEffect("war3mapImported\\AirEssence.mdx",GetUnitX(l__n),GetUnitY(l__n)))
call UnitApplyTimedLife(l__n,'BTLF',0.75)
call UnitAddAbility(l__n,'Arav')
set f=GetUnitFacing(l__n)*bj_DEGTORAD
call SaveReal(h,id,2,GetUnitX(l__n))
call SaveReal(h,id,3,GetUnitY(l__n))
call SetUnitX(c,x+55*Cos(f))
call SetUnitY(c,y+55*Sin(f))
call SaveReal(h,id,8,l__d+55)
