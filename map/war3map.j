local unit u=LoadUnitHandle(HH,id,4)
local real per=LoadReal(HH,id,3)
local real dmg=LoadReal(HH,id,2)/per*0.25
local real i=LoadReal(HH,id,4)
if i<per then
call myCustomDamage(u,c,dmg,false,false,null,null,null)
call SaveReal(HH,id,4,i+0.25)
else
call PauseTimer(t)
