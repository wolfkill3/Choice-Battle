function UpperSlashCast takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real f=GetUnitFacing(u)
local player p=GetOwningPlayer(u)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,GetSpellTargetX())
call SaveReal(h,id,3,GetSpellTargetY())
call UnitAddAbility(u,'Arav')
call UnitRemoveAbility(u,'Arav')
call SetUnitFlyHeight(u,400,0)
call UnitAddAbility(u,'A0GN')
call UnitAddAbility(u,'A0IX')
set n=LoadUnitHandle(h,GetHandleId(u),SH_clone)
if n!=null then
call SetUnitX(n,GetUnitX(u)+55*Cos(Atan2(GetSpellTargetY()-GetUnitY(u),GetSpellTargetX()-GetUnitX(u))+deg90))
call SetUnitY(n,GetUnitY(u)+55*Sin(Atan2(GetSpellTargetY()-GetUnitY(u),GetSpellTargetX()-GetUnitX(u))+deg90))
call UnitResetCooldown(n)
call SetUnitState(n,UNIT_STATE_MANA,GetUnitState(n,UNIT_STATE_MAX_MANA))
call IssuePointOrder(n,"avatar",GetSpellTargetX(),GetSpellTargetY())
endif
if GetUnitTypeId(GetTriggerUnit())=='H03N' then
call SetControlToUnit(u,u, 0.05, "stun")
endif
if GetUnitTypeId(GetTriggerUnit())=='H03O' then
call PauseUnit(u,true)
endif
call SetUnitInvulnerable(u,true)
	if GetUnitTypeId(u)!='H03O' then
		if GetRandomInt(0, 1)==1 then
			set soundplay=SndN(1749) // Sound\Music\mp3Music\VergilE.mp3
		else
			set soundplay=SndN(1751) // Sound\war3mapImported\VergilE1.mp3
		endif
		call StartSound(soundplay)
		//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
		set n=LoadUnitHandle(HH, GetHandleId(u), SH_VergilD)
		call RemoveUnit(n)
		set n=CreateUnit(p, 'd081', 0.0, 0.0, 0.0)
		call SaveUnitHandle(HH, GetHandleId(u), SH_VergilD, n)
		call MyRemoveUnit(n, 3)
    endif
call TimerStart(t,0.35,false,function UpperSlashCast4)
set u=null
set t=null
set p=null
endfunction
function UpperSlashInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function UpperSlashCast)
call TriggerAddCondition(t,Condition(function UpperSlashCond))
set t=null
endfunction
