function AizenW2Act takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit Dummy=LoadUnitHandle(HH,id,20)
local unit casterOriginal=LoadUnitHandle(HH,id,30)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real distance=LoadReal(HH,id,8)
local real x1=GetUnitX(Dummy)
local real y1=GetUnitY(Dummy)
local real damage=LoadReal(HH,id,15)
local boolean Hado31=LoadBoolean(HH,id,16)
set time=time+0.02
call SaveReal(HH,id,5,time)
if distance>=2000 then
set soundplay=SndN(3930) // Sound\Music\mp3Music\AizenW2hit.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call UnitSpeed(caster,1)
call EffectCreateAndMove(true,"Others\\HakkeStart2.mdl",facing,1.5,1.5,1.5,100,100,100,40,0,Dummy,0,facing)
if Hado31 then
call EffectCreateAndMove90(true,"Aizen\\fire-boom-new-red.mdl",facing,1.5,1.75,1,100,100,100,0,0,Dummy,0,facing)
call EffectCreateAndMove(true,"Aizen\\explosion23.mdl",facing,1.5,2,0.6,100,100,100,0,0,Dummy,0,facing)
else
call EffectCreateAndMove90(true,"Aizen\\[A]ExplodeorangeBlue.mdl",facing,1.5,1.75,1.5,100,100,100,0,0,Dummy,0,facing)
call EffectCreateAndMove(true,"Aizen\\explosion22.mdl",facing,1.5,2,0.6,100,100,100,0,0,Dummy,0,facing)
endif
call GroupClear(G)
call GroupEnumUnitsInRange(G,x1,y1,400,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if GetUnitAbilityLevel(n0,'Avul')==0 and IsUnitEnemy(n0,GetOwningPlayer(caster))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false then
if Hado31==true then


call myCustomDamage(casterOriginal,n0,damage+GetUnitState(n0,UNIT_STATE_MAX_LIFE)*0.1,false,false,null,null,null)



else


call myCustomDamage(casterOriginal,n0,damage+GetUnitState(n0,UNIT_STATE_MAX_MANA)*0.15,false,false,null,null,null)

endif
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
call RemoveUnit(Dummy)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else
if time==0.02 then
if Hado31 then
call UnitRemoveAbility(caster,'ASW2')
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'ASW1',true)
call DestroyEffect(AddSpecialEffectTarget("Aizen\\[GokuLight(Red).mdl",caster,"hand left"))
call EffectCreateAndMove(true,"Others\\wind4.mdl",facing,1,1,0.75,100,60,60,0,0,caster,0,facing)
else
call UnitRemoveAbility(caster,'ASW3')
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'ASW1',true)
call DestroyEffect(AddSpecialEffectTarget("Aizen\\[A]SuperShinyThingyBlue.mdl",caster,"hand left"))
call EffectCreateAndMove(true,"Others\\wind4.mdl",facing,1,1,0.75,60,60,100,0,0,caster,0,facing)
endif
call EffectCreateAndMove(true,"BlackGoku\\CF2.mdl",facing,1,0.4,0.5,100,100,100,0,50,caster,100,facing)
call EffectCreateAndMove(true,"Others\\HakkeStart2.mdl",facing,1.5,1,0.5,100,100,100,60,0,caster,0,facing)
call UnitSpeed(caster,2)
if GetUnitTypeId(caster)=='H12M' then
call SetUnitAnimationByIndex(caster,17)
else
call SetUnitAnimationByIndex(caster,9)
endif
endif
if time==0.1 then
call UnitSpeed(caster,1)
endif
if time>0.02 and distance<2000 then
call MoveUnit(Dummy,Dummy,40,facing)
call GroupClear(G)
call GroupEnumUnitsInRange(G,x1,y1,200,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if GetUnitAbilityLevel(n0,'Avul')==0 and IsUnitEnemy(n0,GetOwningPlayer(caster))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false then
set distance=2000
call GroupClear(G)
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
call SaveReal(HH,id,8,distance+40)
endif
endif
set caster=null
set Dummy=null
set casterOriginal=null
endfunction
function AizenWAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit target=LoadUnitHandle(HH,id,2)
local unit Dummy=LoadUnitHandle(HH,id,20)
local unit casterOriginal=LoadUnitHandle(HH,id,30)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real x1=LoadReal(HH,id,11)
local real y1=LoadReal(HH,id,12)
local real damage=LoadReal(HH,id,15)
local boolean HogiokuQuest=LoadBoolean(HH,id,19)
set time=time+0.02
call SaveReal(HH,id,5,time)
if (time==2.3 and HogiokuQuest==false ) or (time==4.3 and HogiokuQuest==true) or GetUnitAbilityLevel(target,'B05G')>0 then
if LoadEffectHandle(HH,id,24)!=null then
call DestroyEffect(LoadEffectHandle(HH,id,24))
call SaveEffectHandle(HH,id,24,null)
endif
call RemoveUnit(Dummy)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else
if time==0.02 then
call SaveEffectHandle(HH,id,24,AddSpecialEffectTarget("Aizen\\NatsuLightning.mdl",caster,"hand left"))
call EffectCreateAndMove(true,"BlackGoku\\[A]az_axe_ef1.mdl",facing,1.5,1,0.75,100,100,60,0,0,caster,0,facing)
call EffectCreateAndMove(true,"Others\\HakkeStart2.mdl",facing,1.5,1,0.5,100,100,100,60,0,caster,0,facing)
call UnitSpeed(caster,1.75)
if GetUnitTypeId(caster)=='H12M' then
call SetUnitAnimationByIndex(caster,17)
else
call SetUnitAnimationByIndex(caster,9)
endif
call GroupClear(G)
call GroupEnumUnitsInRange(G,x1,y1,200,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if GetUnitAbilityLevel(n0,'Avul')==0 and IsUnitEnemy(n0,GetOwningPlayer(caster))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false then
call MoveUnit(n0,Dummy,0,facing)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(Dummy),GetUnitY(Dummy),facing)
call SetUnitModel(n0,"Others\\HakkeStart2.mdl")
call UnitSize(n0,1,1,1)
call UnitSpeed(n0,1.75)
if HogiokuQuest then
call MyRemoveUnit(n0,4.3)
else
call MyRemoveUnit(n0,2.3)
endif
call UnitColor(n0,100,100,100,60)
call SetUnitFlyHeight(n0,0,0)
call SaveUnitHandle(HH,id,21,n0)
set n0=null
call GroupClear(G)
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
endif
if time==0.3 then
call UnitSpeed(caster,1)
call UnitSpeed(Dummy,3)
if LoadUnitHandle(HH,id,21)!=null then
call UnitSpeed(LoadUnitHandle(HH,id,21),0)
endif
call GroupClear(G)
call GroupEnumUnitsInRange(G,x1,y1,200,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if GetUnitAbilityLevel(n0,'Avul')==0 and IsUnitEnemy(n0,GetOwningPlayer(caster))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false then
set target=n0



call myCustomDamage(caster,target,damage,false,false,null,null,null)

call SaveReal(HH,id,11,GetUnitX(target))
call SaveReal(HH,id,12,GetUnitY(target))



if GetHeroLevel(caster)>=12 then

if GetRandomInt(1,2)==1 then
call ChangeAbilityTime(caster,10,'ASW1','ASW2')
else
call ChangeAbilityTime(caster,10,'ASW1','ASW3')
endif

endif

call EffectCreateAndMove(true,"Aizen\\QQQQQyellow.mdl",facing,1.5,2,0.5,100,100,100,0,50,target,0,facing)
call EffectCreateAndMove(true,"Aizen\\File00001721.mdl",facing,1.5,1.5,0.55,100,100,100,0,50,target,0,facing)

call SetControlToUnit(target,target, 2, "stun")

call GroupClear(G)
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
call SaveUnitHandle(HH,id,2,target)

if target==null then
if LoadEffectHandle(HH,id,24)!=null then
call DestroyEffect(LoadEffectHandle(HH,id,24))
call SaveEffectHandle(HH,id,24,null)
endif
call RemoveUnit(Dummy)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif

endif
if time>0.3 and time<4.3 then

if HogiokuQuest==true then
call MoveAoe1(x1,y1,target,0,facing)
endif

call MoveUnit(target,Dummy,0,facing)
endif
endif
set caster=null
set target=null
set Dummy=null
set casterOriginal=null
endfunction
