function ForcedHeroConditions takes nothing returns boolean
return GetPlayerName(GetTriggerPlayer())==AdminNickname or GetPlayerName(GetTriggerPlayer())=="WorldEdit"
endfunction
function ForcedHeroAction takes nothing returns nothing
        local integer LvlS=GetPlayerId(GetTriggerPlayer())
        local integer LvlS2=S2I(SubString(GetEventPlayerChatString(),6,12))
        call RemoveUnit(Hero[LvlS])
        set Hero[LvlS]=CreateUnit(Player(LvlS),RH_Force[LvlS2],GetRectCenterX(gg_rct_Rect1),GetRectCenterY(gg_rct_Rect1),0)
        set udg_Hero[LvlS+1]=Hero[LvlS]
endfunction
