function BelfegorRPassive takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local real dur=0.5+I2R(GetUnitAbilityLevel(LoadUnitHandle(h,id,SH_Belfegor),'BelR'))*0.5
local integer cd=65-GetUnitAbilityLevel(LoadUnitHandle(h,id,SH_Belfegor),'BelR')*5
local real tik=LoadReal(h,id,SH_Tik)
call SaveReal(h,id,SH_Tik,tik+0.1)
if tik<dur then
call UnitRemoveAbility(LoadUnitHandle(h,id,SH_Belfegor),'A0J4')
call UnitRemoveAbility(LoadUnitHandle(h,id,SH_Belfegor),'A128')
call UnitRemoveAbility(LoadUnitHandle(h,id,SH_Belfegor),'A15F')
call UnitRemoveBuffs(LoadUnitHandle(h,id,SH_Belfegor),false,true)
endif
if tik>=cd then
call SaveBoolean(h,GetHandleId(LoadUnitHandle(h,id,SH_Belfegor)),SH_BelfegorRPassiveCD,false)
call FlushChildHashtable(h,id)
call DestroyTimer(GetExpiredTimer())
endif
if tik==dur then
call SaveBoolean(h,GetHandleId(LoadUnitHandle(h,id,SH_Belfegor)),SH_BelfegorRPassive,false)
call RemoveSavedBoolean(h,GetHandleId(LoadUnitHandle(h,id,SH_Belfegor)),SH_BelfegorRPassive)
set bjLCE=LoadEffectHandle(h,id,SH_EffectAura)
call RemoveEffect(bjLCE,0.1,false,CreateTimer())
endif
endfunction
function Lampo_Damage_Actions takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real r=LoadReal(h,id,3)
local lightning l=LoadLightningHandle(h,id,2)
local real x=GetUnitX(c)
local real y=GetUnitY(c)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local unit d1=LoadUnitHandle(h,id,4)
local unit d2=LoadUnitHandle(h,id,5)
if r>0 then
    call MoveLightningEx(l,false,x1,y1,GetUnitZCustom(u)+75,x,y,GetUnitZCustom(c)+75)
    call SaveReal(h,id,3,r-6)
    call SetLightningColor(l,0,100,0,r)
    call SetUnitX(d1,x)
    call SetUnitY(d1,y)
    call SetUnitX(d2,x1)
    call SetUnitY(d2,y1)
else
    call RemoveUnit(d1)
    call RemoveUnit(d2)
    call DestroyTimer(t)
    call DestroyLightning(l)
    call FlushChildHashtable(h,id)
endif
set t=null
set u=null
set l=null
set c=null
set d1=null
set d2=null
endfunction

function AlbedoEPass_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local unit target= LoadUnitHandle(HH, id, c_TARGET)
    local real time= LoadReal(HH, id, c_TIME)
    if IsUnitHidden(target)==false and GetUnitAbilityLevel(target,'cbc9')==0 then
        call SaveReal(HH, id, c_TIME, time + 0.05)
    endif
    if time > 3 or udg_B==false then
        if UnitIsAlive(target) then
            //call BJDebugMsg("Item returned: " + I2S(LoadInteger(HH, id, StringHash("BrokenItemId"))) + ", slot: " + I2S(LoadInteger(h, id, StringHash("BrokenItemSlot"))))
            call RemoveItem(UnitItemInSlot(target, LoadInteger(HH, id, SH_BrokenItemSlot)))
            if GetUnitAbilityLevel(target,'cbc5')>0 then
                call EnableUnitAbility2(target,'AInv',false,true)
            endif
            if IsUnitPaused(target)==false then
				call UnitAddItemToSlotById(target, LoadInteger(HH, id, SH_BrokenItemId), LoadInteger(HH, id, SH_BrokenItemSlot))
			else
				call PauseUnit(target,false)
				call UnitAddItemToSlotById(target, LoadInteger(HH, id, SH_BrokenItemId), LoadInteger(HH, id, SH_BrokenItemSlot))
				call PauseUnit(target,true)
			endif
            if GetUnitAbilityLevel(target,'cbc5')>0 then
                call EnableUnitAbility2(target,'AInv',false,true)
            endif
            call FlushChildHashtable(HH, id)
            call DestroyTimer(GetExpiredTimer())
        endif
    endif
        set target=null
endfunction

function AlbedoBreakCond takes unit u,integer i returns boolean
    if GetItemTypeId(UnitItemInSlot(u,i)) != 'Ibrk' and GetItemTypeId(UnitItemInSlot(u,i)) != 'Ibrk' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I13R' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I02Q' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I13V' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I04V' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I03R' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I03S' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I02K'and GetItemTypeId(UnitItemInSlot(u,i)) != 'I13S' and GetItemTypeId(UnitItemInSlot(u,i)) != 'IMDi' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I01R' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I01T' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I02Z' and GetItemTypeId(UnitItemInSlot(u,i)) != 'IPar' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I03M' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I045' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I047' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I04U' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I055' and GetItemTypeId(UnitItemInSlot(u,i)) != 'ISHs' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I02W' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I046' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I054' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I01F' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I039' then
        return true
    else
        return false
    endif
endfunction

function AlbedoEPassive takes unit newSource, unit newTarget, timer newTimer returns nothing
    //local real new_dmg= GetUnitTotalDamage(newSource)
    local integer AlbedoEPassiveCounter= LoadInteger(HH, GetHandleId(newSource), SH_AlbedoEPassive)
    local integer id= GetHandleId(newTimer)
    local integer item_id= 0
    local integer max_iteration= 30
    local integer random_slot= 0
local unit dn=null // свой временный юнит вместо общего n (функция вызывается из обработчика урона)
    if AlbedoEPassiveCounter >=4 and UnitIsAlive(newTarget) then
        if IsUnitType(newTarget, UNIT_TYPE_HERO) and IsUnitIllusion(newTarget)==false and GetUnitAbilityLevel(newSource, 'AlEp')>0 and GetUnitTypeId(newTarget)!='H007' and GetUnitTypeId(newTarget)!='Ho13' and GetUnitTypeId(newTarget)!='H34X' and GetUnitTypeId(newTarget)!='H14F' then
            if GetUnitTypeId(newTarget)=='H00Q' then
                loop
                exitwhen max_iteration <= 0
                    set max_iteration=max_iteration - 1
                    set random_slot=GetRandomInt(0, 5)
                    if GetItemTypeId(UnitItemInSlot(Hero[GetPlayerId(GetOwningPlayer(newTarget))], random_slot)) != 0 and AlbedoBreakCond(Hero[GetPlayerId(GetOwningPlayer(newTarget))] , random_slot) then
                        set item_id=GetItemTypeId(UnitItemInSlot(Hero[GetPlayerId(GetOwningPlayer(newTarget))], random_slot))
                        call RemoveItem(UnitItemInSlot(Hero[GetPlayerId(GetOwningPlayer(newTarget))], random_slot))
                        set max_iteration=0
                    endif
                endloop
                if item_id != 0 then
                    if GetUnitAbilityLevel(Hero[GetPlayerId(GetOwningPlayer(newTarget))],'cbc5')>0 then
                        call EnableUnitAbility2(Hero[GetPlayerId(GetOwningPlayer(newTarget))],'AInv',false,true)
                    endif
                    if IsUnitPaused(Hero[GetPlayerId(GetOwningPlayer(newTarget))])==false then
                        call UnitAddItemToSlotById(Hero[GetPlayerId(GetOwningPlayer(newTarget))], 'Ibrk', random_slot)
                    else
                        call PauseUnit(Hero[GetPlayerId(GetOwningPlayer(newTarget))], false)
                        call UnitAddItemToSlotById(Hero[GetPlayerId(GetOwningPlayer(newTarget))], 'Ibrk', random_slot)
                        call PauseUnit(Hero[GetPlayerId(GetOwningPlayer(newTarget))],true)
                    endif
                    if GetUnitAbilityLevel(Hero[GetPlayerId(GetOwningPlayer(newTarget))],'cbc5')>0 then
                        call EnableUnitAbility2(Hero[GetPlayerId(GetOwningPlayer(newTarget))],'AInv',false,true)
                    endif
                    set bj_lastCreatedItem = UnitItemInSlot(Hero[GetPlayerId(GetOwningPlayer(newTarget))], random_slot)
                    call SetItemDroppable(bj_lastCreatedItem,false)
                    call SaveItemHandle(HH, id, SH_BrokenItem, bj_lastCreatedItem)
                    call SaveUnitHandle(HH, id, c_TARGET, Hero[GetPlayerId(GetOwningPlayer(newTarget))])
                endif
            else
                loop
                exitwhen max_iteration <= 0
                    set max_iteration=max_iteration - 1
                    set random_slot=GetRandomInt(0, 5)
                    if GetItemTypeId(UnitItemInSlot(newTarget, random_slot)) != 0 and AlbedoBreakCond(newTarget , random_slot) then
                        set item_id=GetItemTypeId(UnitItemInSlot(newTarget, random_slot))
                        call RemoveItem(UnitItemInSlot(newTarget, random_slot))
                        set max_iteration=0
                    endif
                endloop
                if item_id != 0 then
                    if GetUnitAbilityLevel(newTarget,'cbc5')>0 then
                        call EnableUnitAbility2(newTarget,'AInv',false,true)
                    endif
                    if IsUnitPaused(newTarget)==false then
                        call UnitAddItemToSlotById(newTarget, 'Ibrk', random_slot)
                    else
                        call PauseUnit(newTarget, false)
                        call UnitAddItemToSlotById(newTarget, 'Ibrk', random_slot)
                        call PauseUnit(newTarget,true)
                    endif
                    if GetUnitAbilityLevel(newTarget,'cbc5')>0 then
                        call EnableUnitAbility2(newTarget,'AInv',false,true)
                    endif
                    set bj_lastCreatedItem = UnitItemInSlot(newTarget, random_slot)
                    call SetItemDroppable(bj_lastCreatedItem,false)
                    call SaveItemHandle(HH, id, SH_BrokenItem, bj_lastCreatedItem)
                    call SaveUnitHandle(HH, id, c_TARGET, newTarget)
                endif
            endif
            call SaveReal(HH, id, c_TIME, 0)
            call SaveInteger(HH, id, SH_BrokenItemSlot, random_slot)
            call SaveInteger(HH, id, SH_BrokenItemId, item_id)
            call TimerStart(newTimer, 0.05, true, function AlbedoEPass_Periodic)
		endif
		// if GetUnitTypeId(newTarget)=='H04A' and GetUnitTypeId(newTarget)=='H04B' then
			// set new_dmg = new_dmg + GetWidgetMaxLife(newTarget)*0.065
		// endif
		//call myCustomDamage(UltimateDamage, newTarget , new_dmg , false , false , null , null , null)
		call SaveInteger(HH, GetHandleId(newSource), SH_AlbedoEPassive, 0)
        call SaveInteger(HH, GetHandleId(newSource), BlockPenetrate, 0)
		set dn=CreateUnit(GetOwningPlayer(newSource), 'dH61', GetUnitX(newTarget), GetUnitY(newTarget), GetRandomInt(0, 360))
		call SetUnitFlyHeight(dn, 1, 0)
		call MyRemoveUnit(dn, 1.5)
	else
		call SaveInteger(HH, GetHandleId(newSource), SH_AlbedoEPassive, AlbedoEPassiveCounter + 1)
	endif
set dn=null
endfunction

function RengokuF_Pass_Cooldown takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local integer id_caster= GetHandleId(LoadUnitHandle(h, id, c_CASTER))
    local real time= LoadReal(HH, id_caster, RengokuF_CD)
    if time > 0 and udg_B and UnitIsAlive(LoadUnitHandle(h, id, c_CASTER)) then
        call SaveReal(HH, id_caster, RengokuF_CD, time - 0.5)
    else
        call SaveReal(HH, id_caster, RengokuF_CD, 0.0)
                call RemoveSavedReal(HH, id_caster, RengokuF_CD)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
endfunction


function RengokuF_Pass_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local integer id_caster= GetHandleId(LoadUnitHandle(h, id, c_CASTER))
    local real time= LoadReal(h, id, c_TIME)
        local unit caster=LoadUnitHandle(h, id, c_CASTER)
    local real caster_hp= GetWidgetLife(caster)
    if caster_hp>0.1 and time<=18 then
        if time < 1 then
                        call SetUnitInvulnerable(caster, true)
                        call PauseUnit(caster, true)
            //call SetUnitState(caster, UNIT_STATE_LIFE, GetWidgetMaxLife(caster) * 0.35)
            set bjLCU=LoadUnitHandle(h, id, c_DUMMY1)
            call SetUnitScale(bjLCU , 1 + time / 2, 1 + time / 2, 1 + time / 2)
            call SetUnitTimeScale(bjLCU , 1 + time / 2)
            call SetUnitX(bjLCU, GetUnitX(caster))
            call SetUnitY(bjLCU, GetUnitY(caster))
            set bjLCU=LoadUnitHandle(h, id, c_DUMMY2)
            call SetUnitScale(bjLCU , 2.5 + time / 2, 2.5 + time / 2, 2.5 + time / 2)
            call SetUnitTimeScale(bjLCU , 1 + time / 2)
            call SetUnitX(bjLCU, GetUnitX(caster))
            call SetUnitY(bjLCU, GetUnitY(caster))
            set bjLCU=LoadUnitHandle(h, id, c_DUMMY3)
            call SetUnitScale(bjLCU , 1.5 + time / 3, 1.5 + time / 3, 1.5 + time / 3)
            call SetUnitTimeScale(bjLCU , 1 + time / 3)
            call SetUnitX(bjLCU, GetUnitX(caster))
            call SetUnitY(bjLCU, GetUnitY(caster))
        endif
        if time == 1 then
            call KillUnit(LoadUnitHandle(h, id, c_DUMMY1))
            call KillUnit(LoadUnitHandle(h, id, c_DUMMY2))
            call KillUnit(LoadUnitHandle(h, id, c_DUMMY3))
                        call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY1), 1.5)
                        call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY2), 1.5)
                        call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY3), 1.5)
            call SetUnitInvulnerable(caster, false)
            call PauseUnit(caster, false)
                        call IssueImmediateOrder(caster, "stop")
                        call UnitRemoveBuffs(caster, false, true)
                        set n=CreateUnit(GetOwningPlayer(caster), 'dR11', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
                        call SetUnitScale(n, 1.85, 1.85, 1.85)
                        call MyRemoveUnit(n, 1.5)
        endif
        set bjLCU=LoadUnitHandle(h, id, c_DUMMY4)
        call SetUnitX(bjLCU, GetUnitX(caster))
                call SetUnitY(bjLCU, GetUnitY(caster))
        call SetUnitFlyHeight(bjLCU, GetUnitFlyHeight(caster) + 10, 0)
        set bjLCU=LoadUnitHandle(h, id, c_DUMMY5)
        call SetUnitX(bjLCU, GetUnitX(caster))
                call SetUnitY(bjLCU, GetUnitY(caster))
        call SetUnitFlyHeight(bjLCU, GetUnitFlyHeight(caster) + 10, 0)
         if GetUnitAbilityLevel(caster, 'B00V') != 0 then //проверки для инвиза (туман)
            if GetUnitAbilityLevel(LoadUnitHandle(h, id, c_DUMMY4), 'A0A1') == 0 then
                call UnitAddAbility(LoadUnitHandle(h, id, c_DUMMY4), 'A0A1')
                call UnitAddAbility(LoadUnitHandle(h, id, c_DUMMY5), 'A0A1')
            endif
        else
            if GetUnitAbilityLevel(LoadUnitHandle(h, id, c_DUMMY4), 'A0A1') == 1 then
                call UnitRemoveAbility(LoadUnitHandle(h, id, c_DUMMY4), 'A0A1')
                call UnitRemoveAbility(LoadUnitHandle(h, id, c_DUMMY5), 'A0A1')
            endif
        endif
        if time < 1.1 then
            call SaveReal(h, id, c_TIME, time + 0.02)
        else
            if IsUnitPaused(caster) == false then
                call SaveReal(h, id, c_TIME, time + 0.02)
            endif
        endif
    else
        call SetHeroStr(caster, GetHeroStr(caster, false) - 20, false)
        call SetHeroAgi(caster, GetHeroAgi(caster, false) - 20, false)
        call SetHeroInt(caster, GetHeroInt(caster, false) - 20, false)
        call UnitRemoveAbility(caster, 'ReFa')
        call UnitRemoveAbility(caster, 'ReFm')
                if caster_hp>GetWidgetMaxLife(caster) then
                        call SetWidgetLife(caster, GetWidgetMaxLife(caster))
                else
                        call SetWidgetLife(caster, caster_hp)
                endif
        call KillUnit(LoadUnitHandle(h, id, c_DUMMY4))
        call KillUnit(LoadUnitHandle(h, id, c_DUMMY5))
        call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY4) , 1.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY5) , 1.5)
        call SaveBoolean(HH, id_caster, RengokuF_Pass, false)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
        set caster=null
endfunction

function RengokuF_Pass_Act takes unit newCaster,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local integer id_caster= GetHandleId(newCaster)
    local real caster_x= GetUnitX(newCaster)
    local real caster_y= GetUnitY(newCaster)
        set soundplay=SndN(750) // Sound\war3mapImported\RengokuF1.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        set soundplay=SndN(752) // Sound\war3mapImported\RengokuF2.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR15', caster_x, caster_y, GetRandomInt(0, 360))
    call SaveUnitHandle(h, id, c_DUMMY1, bjLCU)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dRe9', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(bjLCU, 2.5, 2.5, 2.5)
    call SaveUnitHandle(h, id, c_DUMMY2, bjLCU)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dRe9', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
    call SaveUnitHandle(h, id, c_DUMMY3, bjLCU)
    
        // set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR96', caster_x, caster_y, GetRandomInt(0, 360))
        // call SetUnitScale(bjLCU, 1.25, 1.25, 1.25) 
        // call SetUnitTimeScale(bjLCU, 0.65)
        // call SetUnitFlyHeight(bjLCU, 120, 0)
        // call MyRemoveUnit(bjLCU, 1.5)
        // set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR34', caster_x, caster_y, GetRandomInt(0, 360))
        // call MyRemoveUnit(bjLCU, 1.5)
        // set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dH62', caster_x, caster_y, GetRandomInt(0, 360))
        // call SetUnitScale(bjLCU, 2, 2, 2) 
        // call SetUnitFlyHeight(bjLCU, 25, 0)
        // call MyRemoveUnit(bjLCU, 1.5)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dRe9', caster_x, caster_y, GetRandomInt(0, 360))
    call SetUnitScale(bjLCU, 2.35, 2.35, 2.35)
        call SetUnitAnimationByIndex(bjLCU, 0)
    call SaveUnitHandle(h, id, c_DUMMY4, bjLCU)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dRe9', caster_x, caster_y, GetRandomInt(0, 360))
    call SetUnitScale(bjLCU, 1.35, 1.35, 1.35)
        call SetUnitAnimationByIndex(bjLCU, 0)
    call SaveUnitHandle(h, id, c_DUMMY5, bjLCU)
    
    call ShakeCamera(0.3 , 30)
    call SetHeroStr(newCaster, GetHeroStr(newCaster, false) + 20, false)
    call SetHeroAgi(newCaster, GetHeroAgi(newCaster, false) + 20, false)
    call SetHeroInt(newCaster, GetHeroInt(newCaster, false) + 20, false)
    call UnitAddAbility(newCaster, 'ReFa')
    call UnitAddAbility(newCaster, 'ReFm')
    call SetUnitAnimationByIndex(newCaster, 10)
    call UnitRemoveBuffs(newCaster, false, true)
    call SetUnitInvulnerable(newCaster, true)
    call PauseUnit(newCaster, true)
    call HealTextTag(newCaster,newCaster,((GetWidgetMaxLife(newCaster) * 0.20)-GetWidgetLife(newCaster))*myCustomHeal2(newCaster,1),"HealthRes")
    call SetWidgetLife(newCaster, GetWidgetMaxLife(newCaster)*0.20)
    call SaveUnitHandle(h, id, c_CASTER, newCaster)
    call SaveBoolean(HH, id_caster, RengokuF_Pass, true)
    call SaveReal(HH, id_caster, RengokuF_CD, 200) //CD
    call CreateModeIndicatorForm(newCaster, "ReplaceableTextures\\CommandButtons\\BTNRengokuF.blp", 200)
    call TimerStart(newTimer, 0.02, true, function RengokuF_Pass_Periodic)
    set newTimer=null
    set newTimer=CreateTimer()
    set id=GetHandleId(newTimer)
    call SaveUnitHandle(h, id, c_CASTER, newCaster)
    call TimerStart(newTimer, 0.5, true, function RengokuF_Pass_Cooldown)
        set newTimer=null
endfunction


//===========================================================================
// Trigger: MadokaDamage
//===========================================================================

function MadokaF1_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local unit caster=LoadUnitHandle(h, id, CasterHash)
    local real time=LoadReal(h, id, TIME_HASH)
    if time < 8.0 then
        call SaveReal(h, id, TIME_HASH, time + 0.1)
        call PauseUnit(caster, true)
        call SetUnitInvulnerable(caster, true)
                call SetWidgetLife(caster, GetWidgetMaxLife(caster)*0.5)
        call SetUnitX(LoadUnitHandle(h, id, Dummy2Hash), GetUnitX(caster))
        call SetUnitY(LoadUnitHandle(h, id, Dummy2Hash), GetUnitY(caster))
        if time < 3.0 then
            set n=CreateUnit(GetOwningPlayer(caster), 'dM42', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
            call SetUnitScale(n, 1.0 + time * 0.8, 1.0 + time * 0.8, 1.0 + time * 0.8)
            call SetUnitVertexColor(n, 255, 255, 255, 100)
            call SetUnitFlyHeight(n, 10, 0)
            call MyRemoveUnit(n , 1.5)
        endif
        if time == 3.0 then
            call SetTerrainFogExBJ(0, 0.00, 9000, 0, 0.1, 0.1, 0.7)
            call ShakeCamera(0.2 , 5)
            set n=CreateUnit(GetOwningPlayer(caster), 'dM54', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
            call SetUnitScale(n, 1.8, 1.8, 1.8)
            call SetUnitFlyHeight(n, 150, 0)
            call SetUnitTimeScale(n, 0.6)
            call MyRemoveUnit(n , 2.5)
            set n=CreateUnit(GetOwningPlayer(caster), 'dM55', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
            call SetUnitScale(n, 1.8, 1.8, 1.8)
            call MyRemoveUnit(n , 2.5)
        endif
        if time == 4.0 then
            call ShakeCamera(4 , 10)
            set soundplay=SndN(294) // Sound\war3mapImported\MadokaF1_Sound1.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            call KillUnit(LoadUnitHandle(h, id, Dummy2Hash))
            call MyRemoveUnit(LoadUnitHandle(h, id, Dummy2Hash) , 1.5)
            set n=CreateUnit(GetOwningPlayer(caster), 'dM56', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
            call SetUnitScale(n, 3.2, 3.2, 3.2)
            call SaveUnitHandle(h, id, Dummy2Hash, n)
        endif
        if time > 4.0 then
            set bjLCG=LoadGroupHandle(h, id, GroupHash)
            call GroupEnumUnitsInRange(bjLCG, GetUnitX(caster), GetUnitY(caster), 1300, Base)
            loop
            set E=FirstOfGroup(bjLCG)
            exitwhen E == null
                if E!=caster then
                    call myCustomDamage(caster , E , GetWidgetMaxLife(caster) * 0.03125 , false , false , null , null , null)
                    if SquareRootUnit(E,caster)>150 then
                        call Push3(E,30,AU(E,caster),50,"")
                    endif
                endif
                call GroupRemoveUnit(bjLCG, E)
            endloop
        endif
    else
        call SetTerrainFogExBJ(0,6000.00,10000,0,1,1,1)
        call SetUnitTimeScale(LoadUnitHandle(h, id, Dummy2Hash), 0.5)
        call KillUnit(LoadUnitHandle(h, id, Dummy1Hash))
        call KillUnit(LoadUnitHandle(h, id, Dummy2Hash))
        call MyRemoveUnit(LoadUnitHandle(h, id, Dummy1Hash) , 1.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, Dummy2Hash) , 1.5)
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call SetUnitTargetable(caster, true)
        call UnitRemoveAbility(caster,'A0QL')
        call UnitRemoveBuffs(caster, false, true)
        call UnitRemoveAbility(caster, 'MaF5')
        if udg_B then
            call UnitAddAbility(caster, 'MaF2')
            call UnitAddAbility(caster, 'A0WR')
            call myCustomDamage(LoadUnitHandle(h, id, SH_Source) , caster , 999999 , false , false , null , DAMAGE_TYPE_UNKNOWN , null)
            call UnitRemoveAbility(caster, 'MaF2')
            call UnitRemoveAbility(caster, 'A0WR')
        endif
        call SaveBoolean(HH,GetHandleId(caster),'mdf+',false)
        call DestroyGroup(LoadGroupHandle(h, id, GroupHash))
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
endfunction

function MadokaF1_Cast takes unit newCaster,unit newSource,timer newTimer returns nothing
    local integer id=GetHandleId(newTimer)
    set soundplay=SndN(299) // Sound\war3mapImported\MadokaF1_Voice1.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set soundplay=SndN(297) // Sound\war3mapImported\MadokaF1_Sound2.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM32', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    call SetUnitScale(n, 1.9, 1.9, 1.9)
    call SetUnitVertexColor(n, 255, 255, 255, 150)
    call SaveUnitHandle(h, id, Dummy1Hash, n)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM53', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    call UnitScale(n , 0.5 , 1.5 , 4)
    call SetUnitFlyHeight(n, 50, 0)
        call UnitAddAbility(newCaster, 'MaF5')
    call SaveUnitHandle(h, id, Dummy2Hash, n)
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call SaveUnitHandle(h, id, SH_Source, newSource)
    call SaveGroupHandle(h, id, GroupHash, CreateGroup())
    call TimerStart(newTimer, 0.1, true, function MadokaF1_Periodic)
endfunction

function MadokaF2_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local unit caster=LoadUnitHandle(h, id, CasterHash)
    local real time=LoadReal(h, id, TIME_HASH)
    if udg_B then
        if time<0.5 then
            call PauseUnit(caster, true)
            call SetUnitInvulnerable(caster, true)
        endif
        call SaveReal(h, id, TIME_HASH, time + 0.1)
        set bjLCG=LoadGroupHandle(h, id, GroupHash)
        call GroupEnumUnitsInRect(bjLCG, bj_mapInitialPlayableArea, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E == null
            if IsUnitAlly(E, GetOwningPlayer(caster)) and UnitIsAlive(E) then
                call HealTextTag(E,E,GetWidgetMaxLife(caster) * 0.001*myCustomHeal2(E,1),"HealthRes")
                call SetWidgetLife(E, GetWidgetLife(E) + GetWidgetMaxLife(caster) * 0.001)
            endif
            call GroupRemoveUnit(bjLCG, E)
        endloop
                if time==0.5 then
                        call PauseUnit(caster, false)
                        call SetUnitInvulnerable(caster, false)
                        call UnitRemoveBuffs(caster, false, true)
                        call SetUnitTargetable(caster, true)
                        call UnitRemoveAbility(caster,'A0QL')
                        call UnitAddAbility(caster, 'MaF2')
                        call UnitAddAbility(caster, 'A0WR')
                        call myCustomDamage(LoadUnitHandle(h, id, SH_Source) , caster , 999999 , false , false , null , DAMAGE_TYPE_UNKNOWN , null)
                        call UnitRemoveAbility(caster, 'MaF2')
                        call UnitRemoveAbility(caster, 'A0WR')
                        call SaveBoolean(HH,GetHandleId(caster),'mdf+',false)
                endif
        if time == 4.0 then
            set soundplay=SndN(754) // Sound\war3mapImported\MadokaF2_Sound.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        endif
    else
        call SaveBoolean(HH,GetHandleId(caster),'mdf+',false)
        call DestroyGroup(LoadGroupHandle(h, id, GroupHash))
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
endfunction

function MadokaF2_Cast takes unit newCaster,unit newSource,timer newTimer returns nothing
    local integer id=GetHandleId(newTimer)
    set soundplay=SndN(757) // Sound\war3mapImported\MadokaF2_Voice.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call SetTerrainFogExBJ(0,6000.00,10000,0,1,1,1)

    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM66', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    call UnitScale(n , 0.5 , 3 , 1)
    call UnitApplyTimedLife(n,'BTLF', 4)
    call MyRemoveUnit(n , 6)
    call RemoveEffect(AddSpecialEffectTarget("az_20200523153.mdl", newCaster, "origin") , 1 , true , CreateTimer())
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call SaveUnitHandle(h, id, SH_Source, newSource)
    call SaveGroupHandle(h, id, GroupHash, CreateGroup())
    call TimerStart(newTimer, 0.1, true, function MadokaF2_Periodic)
endfunction

function MadokaF3_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local unit caster=LoadUnitHandle(h, id, CasterHash)
    local unit dummy0=LoadUnitHandle(h, id, SH_Dummy0)
    local real time=LoadReal(h, id, TIME_HASH)
    if time < 10.0 then
        call SaveReal(h, id, TIME_HASH, time + 0.1)
        call SetWidgetLife(caster, GetWidgetMaxLife(caster))
        call SetWidgetMana(caster, GetWidgetMaxMana(caster))
        call PauseUnit(caster, true)
        call SetUnitInvulnerable(caster, true)
        call SetUnitX(dummy0, GetUnitX(caster) + 300 * Cos(LoadReal(h, id, AngleHash)))
        call SetUnitY(dummy0, GetUnitY(caster) + 300 * Sin(LoadReal(h, id, AngleHash)))
                call SetUnitX(LoadUnitHandle(h, id, Dummy1Hash), GetUnitX(caster))
        call SetUnitY(LoadUnitHandle(h, id, Dummy1Hash), GetUnitY(caster))
                call SetUnitX(LoadUnitHandle(h, id, Dummy2Hash), GetUnitX(caster))
        call SetUnitY(LoadUnitHandle(h, id, Dummy2Hash), GetUnitY(caster))
                call SetUnitX(LoadUnitHandle(h, id, SH_Dummy4), GetUnitX(caster))
        call SetUnitY(LoadUnitHandle(h, id, SH_Dummy4), GetUnitY(caster))
        call SetUnitFacing(dummy0, AU(dummy0 , caster) * bj_RADTODEG)
        if time < 3.5 then
            set n=CreateUnit(GetOwningPlayer(caster), 'dM42', GetUnitX(dummy0), GetUnitY(dummy0), GetRandomInt(0, 360))
            call SetUnitScale(n, 0.5 + time * 0.8, 0.5 + time * 0.8, 0.5 + time * 0.8)
            call SetUnitVertexColor(n, 255, 255, 255, 50)
            call SetUnitFlyHeight(n, 10, 0)
            call MyRemoveUnit(n , 1.5)
        endif
        if time == 4.0 then
            call ShakeCamera(0.2 , 5)
            set n=CreateUnit(GetOwningPlayer(caster), 'dM60', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
            call UnitScale(n , 2 , 8 , 4)
            call SetUnitFlyHeight(n, 0, 0)
            call SetUnitTimeScale(n, 0.6)
            call UnitApplyTimedLife(n,'BTLF', 4.0)
            call MyRemoveUnit(n , 6.0)
            set n=CreateUnit(GetOwningPlayer(caster), 'dM55', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
            call SetUnitScale(n, 1.8, 1.8, 1.8)
            call MyRemoveUnit(n , 2.5)
        endif
        if time == 4.0 then
            call ShakeCamera(3.5 , 10)
            set n=CreateUnit(GetOwningPlayer(caster), 'dM65', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
            call UnitScale(n , 1 , 3.8 , 3)
            call SaveUnitHandle(h, id, SH_Dummy3, n)
        endif
        if time == 5.0 then
                        set soundplay=SndByPath("Sound\\war3mapImported\\MadokaF3_Sound"+I2S(GetRandomInt(0,1))+".mp3")
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            call UnitScale(LoadUnitHandle(h, id, SH_Dummy4) , 0.7 , 2.1 , 2.2)
        endif
    else
        call CinematicFadeBJCustom(bj_CINEFADETYPE_FADEIN, 0.5, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 125, 185, 255, 0)
        set n=CreateUnit(GetOwningPlayer(caster), 'dM62', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
        call UnitScale(n , 3 , 6 , 1)
        call SetUnitTimeScale(n, 0.7)
        call MyRemoveUnit(n , 2.7)
        set n=CreateUnit(GetOwningPlayer(caster), 'dM71', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
        call SetUnitScale(n, 0.7, 0.7, 0.7)
        call SetUnitTimeScale(n, 0.7)
        call MyRemoveUnit(n , 3.5)
        call ShakeCamera(0.2 , 25)
        call SetTerrainFogExBJ(0,6000.00,10000,0,1,1,1)
        call SetUnitTimeScale(LoadUnitHandle(h, id, Dummy2Hash), 0.5)
        call KillUnit(LoadUnitHandle(h, id, Dummy1Hash))
        call KillUnit(LoadUnitHandle(h, id, Dummy2Hash))
        call KillUnit(LoadUnitHandle(h, id, SH_Dummy3))
        call KillUnit(LoadUnitHandle(h, id, SH_Dummy4))
                call UnitRemoveAbility(dummy0, 'A16C')
        call MyRemoveUnit(LoadUnitHandle(h, id, Dummy1Hash) , 1.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, Dummy2Hash) , 1.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, SH_Dummy3) , 1.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, SH_Dummy4) , 1.5)
                if UnitIsAlive(caster)==false then
                        call ReviveHero(caster, GetUnitX(caster),GetUnitY(caster), false)
                        call SetUnitControlCount(caster, 11,0)
                endif
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call SetUnitState(caster,UNIT_STATE_LIFE,1)
        call SetUnitState(caster,UNIT_STATE_MANA,1)
        call HealTextTag(caster,caster,GetWidgetMaxLife(caster) * 0.65*myCustomHeal2(caster,1),"HealthRes")
        call HealTextTag(caster,caster,GetWidgetMaxLife(caster) * 0.65*myCustomMana2(caster,1),"ManaRes")
		call SetWidgetLife(caster, GetWidgetMaxLife(caster)*0.65)
		call SetWidgetMana(caster, GetWidgetMaxMana(caster)*0.65)
		call UnitRemoveBuffs(caster, false, true)
		if udg_B then
			call UnitAddAbility(caster, 'MaF3')
			call IssueImmediateOrder(caster, "bearform")
			call UnitRemoveAbility(caster, 'MaF3')
			if GetHeroLevel(caster) >= 25 then
				call ShowAbility2( 'MaT1' , false)
				call UnitAddAbility(caster, 'MaT2')
			endif
            call CheckUnitBonusRange(caster)
			call UnitAddAbility(caster, 'MaE2')
			call UnitAddAbility(caster, 'MaR2')
			call ShowAbility2( 'MaE1' , false)
			call ShowAbility2( 'MadR' , false)
		endif
        call SetUnitTargetable(caster, true)
        call UnitRemoveAbility(caster,'A0QL')
        call SaveBoolean(HH,GetHandleId(caster),'mdf+',false)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set dummy0=null
    set caster=null
endfunction

function MadokaF3_Cast takes unit newCaster,unit newSource,timer newTimer returns nothing
    local integer id=GetHandleId(newTimer)
    local real angle=GetUnitFacing(newCaster) * bj_DEGTORAD
        if GetRandomInt(0,1)==0 or GetPlayerName(GetOwningPlayer(newCaster))=="Uriska" then
                set soundplay=SndN(303) // Sound\war3mapImported\MadokaF3_Voice2.mp3
        else
                set soundplay=SndN(301) // Sound\war3mapImported\MadokaF3_Voice1.mp3
        endif
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        
        call UnitAddAbility(LoadUnitHandle(HH,GetPlayerId(GetOwningPlayer(newCaster)),SH_kyubei), 'A16C')
    call SaveUnitHandle(h, id, SH_Dummy0, LoadUnitHandle(HH,GetPlayerId(GetOwningPlayer(newCaster)),SH_kyubei))
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM32', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    call SetUnitScale(n, 1.9, 1.9, 1.9)
    call SetUnitVertexColor(n, 255, 255, 255, 150)
    call SaveUnitHandle(h, id, Dummy1Hash, n)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM58', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    call UnitScale(n , 0.5 , 3.0 , 4)
    call SetUnitFlyHeight(n, 50, 0)
    call SaveUnitHandle(h, id, Dummy2Hash, n)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM61', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    //call UnitScale(n, 0.5, 3.0, 4)
    call SetUnitScale(n, 0.7, 0.7, 0.7)
    call SetUnitFlyHeight(n, 50, 0)
    call SaveUnitHandle(h, id, SH_Dummy4, n)
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call SaveUnitHandle(h, id, SH_Source, newSource)
    call SaveReal(h, id, AngleHash, angle)
    call TimerStart(newTimer, 0.1, true, function MadokaF3_Periodic)
endfunction


