endfunction
function TekkaiCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real time=LoadReal(h,id,4)
if time==0.05 then
if GetUnitTypeId(u)=='H00L' then
call SetUnitAnimationByIndex(u,12)
else
call SetUnitAnimationByIndex(u,12)
endif
endif
if time<=2.1 then
call PauseUnit(u,true)
call SaveReal(h,id,4,time+0.05)
else
call UnitMakeAbilityPermanent(u,false,'A09I')
call UnitRemoveAbility(u,'A09I')
call UnitRemoveBuffs(u,false,true)
call PauseUnit(u,false)
call SetUnitVertexColor(u,255,255,255,255)
call SetUnitTimeScale(u,1)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set t=null
endfunction
