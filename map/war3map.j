function CondKamehameha3 takes nothing returns boolean
return GetSpellAbilityId()=='A0N5' and udg_B==true
endfunction
function CastKamehameha32 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real a=LoadReal(h,id,4)
local real dist=LoadReal(h,id,10)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real x=GetUnitX(l__d)+35*Cos(a)
local real y=GetUnitY(l__d)+35*Sin(a)
local real dmg=(2+GetUnitAbilityLevel(u,'A0N5'))*GetHeroAgi(u,true)+75
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,3)
local real time=LoadReal(h,id,5)
if time<1.013 then
call SaveReal(h,id,5,time+0.013)
if time>=0.38 and time<0.39 then
    call UnitApplyTimedLife(CreateUnit(p,'e0LB',x1+85*Cos(a),y1+85*Sin(a),GetRandomReal(0,359)),'BTLF',1)
endif
if time==1.001 then
call SetUnitTimeScale(u,1)
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(1658) // Sound\Music\mp3Music\SuperAttackWave.mp3
else
set soundplay=SndN(1661) // Sound\Music\mp3Music\Gotenks\SuperAttackWave-jap.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call UnitApplyTimedLife(CreateUnit(p,'e0LA',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0L5',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0L6',x1+85*Cos(a),y1+85*Sin(a),a*bj_RADTODEG),'BTLF',1)
set n=CreateUnit(p,'e0L7',x1+75*Cos(a),y1+75*Sin(a),a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitTimeScale(n,2)
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
call SaveUnitHandle(h,id,1,CreateUnit(GetOwningPlayer(u),'e0LC',x1+55*Cos(a),y1+55*Sin(a),a*bj_RADTODEG))
endif
else
if dist>0 and IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
call SetUnitXY_1(l__d,x,y, false)
set n=CreateUnit(p,'e0L5',x,y,a*bj_RADTODEG)
call SetUnitTimeScale(n,0)
call UnitApplyTimedLife(n,'BTLF',1)
call GroupEnumUnitsInRange(g,x,y,150,Base)
set idg=GetHandleId(g)
call SaveReal(h,id,10,dist-30)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
else
call GroupEnumUnitsInRange(g,x,y,400,Base)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
call ShakeCamera(0.5,20)
call UnitApplyTimedLife(CreateUnit(p,'e0LA',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0L8',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0L9',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0C7',x,y,(a*bj_RADTODEG)),'BTLF',6)
call StartSound(soundStr[47])
call RemoveUnit(l__d)
call FlushChildHashtable(h,GetHandleId(g))
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
endif
set g=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
function CastKamehameha3 takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,3,CreateGroup())
call SaveReal(h,id,4,a)
call SaveReal(h,id,10,4000)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SetUnitAnimationByIndex(u,37)
call SetUnitTimeScale(u,0.66)
call TimerStart(t,0.013,true,function CastKamehameha32)
set u=null
set p=null
set t=null
endfunction
function Kamehameha3Init takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function CastKamehameha3)
call TriggerAddCondition(t,Condition(function CondKamehameha3))
set t=null
endfunction
