    return GetSpellAbilityId()=='A23W'
endfunction
function EShikiNewTwoCast5 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(HH,id,0)
    local unit c=LoadUnitHandle(HH,id,1)
    local integer idu=GetHandleId(u)
    local real x=GetUnitX(c)
    local real y=GetUnitY(c)
    local real x1=GetUnitX(u)
    local real y1=GetUnitY(u)
    local real a=LoadReal(HH,idu,SH_ANQ)
    local real dist=LoadReal(HH,id,2)
    local integer fe=LoadInteger(HH,id,4)
    local real he=LoadReal(HH,id,7)*((750-dist)/750)
    local real sc=0
    local player p=GetOwningPlayer(u)
    local group g=LoadGroupHandle(HH,id,11)
    call TextTagFull2(I2S(LoadInteger(HH,idu,ComboCounterHash))+" x COMBO!",x,y,175,75,255,255,p,0.023+0.001*LoadInteger(HH,idu,ComboCounterHash))
    if IsUnitInGroup(c,g)==false then
        call UnitRemoveAbility(c,'A1BJ')
    endif
    loop
    set E=FirstOfGroup(g)
    exitwhen E==null
    call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Tidal.mdx",E,"head"))
    call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX-Special.mdx",E,"head"))
    call SetControlToUnit(E,E, 0.3, "stun")
    set n=CreateUnit(p,'e11O',GetUnitX(E),GetUnitY(E),GetRandomReal(0,359))
    call UnitApplyTimedLife(n,'BTLF',1)
    call SetUnitTimeScale(n,2)
    set n=CreateUnit(p,'e03V',GetUnitX(E),GetUnitY(E),GetRandomReal(0,359))
    call UnitApplyTimedLife(n,'BTLF',1)
    call SetUnitScale(n,2,2,2)
    call SetUnitTimeScale(n,2)
    call myCustomDamage(u,E,GetHeroAgi(u,true)*(3.25+GetUnitAbilityLevel(u,'A23W')*.75),false,false,null,null,null)
    //if GetHeroAgi(u,true)*(3.25+GetUnitAbilityLevel(u,'A23W')*.75)*(1-LoadInteger(HH,idu,ComboCounterHash)*0.045)>GetHeroAgi(u,true)*(3.25+GetUnitAbilityLevel(u,'A23W')*.75)*0.1 then
    //call myCustomDamage(u,E,GetHeroAgi(u,true)*(3.25+GetUnitAbilityLevel(u,'A23W')*.75)*(1-LoadInteger(HH,idu,ComboCounterHash)*0.045),false,false,null,null,null)
    //else
    //call myCustomDamage(u,E,GetHeroAgi(u,true)*(3.25+GetUnitAbilityLevel(u,'A23W')*.75)*0.1,false,false,null,null,null)
    //endif
    call UnitRemoveAbility(E,'A1BJ')
    call GroupRemoveUnit(g,E)
    endloop
    call UnitRemoveAbility(u,'A1BK')
    if GetUnitAbilityLevel(u,'A1BM')==0 then
    call UnitRemoveAbility(u,'A1BI')
    endif
    call RemoveSaveHashTimedShiki(0.5,idu,SH_SKQ,u)
    call SetUnitFlyHeight(u,0,0)
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(HH,id)
    set c=null
    set u=null
    set p=null
    set t=null
endfunction
function EShikiNewTwoCast4 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(HH,id,0)
    local unit c=LoadUnitHandle(HH,id,1)
    local integer idu=GetHandleId(u)
    local real x=GetUnitX(c)
    local real y=GetUnitY(c)
    local real x1=0
    local real y1=0
    local real a=LoadReal(HH,idu,SH_ANQ)
    local real dist=LoadReal(HH,id,2)
    local integer fe=LoadInteger(HH,id,4)
    local real he=LoadReal(HH,id,7)
    local real sc=0
    local player p=GetOwningPlayer(u)
