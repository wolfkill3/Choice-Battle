set n0=CreateUnit(GetOwningPlayer(caster),'hs30',LoadReal(HH,id,11),LoadReal(HH,id,12),facing)
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
