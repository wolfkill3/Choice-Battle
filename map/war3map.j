function AokijiEAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster
local unit target
local real facing
local real time
local real time1
local unit Dummy
set caster=LoadUnitHandle(HH,id,1)
set target=LoadUnitHandle(HH,id,2)
set facing=LoadReal(HH,id,3)
set time=LoadReal(HH,id,5)
set time1=LoadReal(HH,id,6)
set Dummy=null
set time=time+0.02
call SaveReal(HH,id,5,time)
if time==20.02 then
call UnitCreateAndMove(caster,0x616F3032,caster,GetRandomReal(0,360),1.5,1.5,0.5,100,100,100,60,0,target,0,facing)
call UnitCreateAndMove(caster,0x616F3033,caster,GetRandomReal(0,360),1.5,1.25,0.5,100,100,100,30,50,target,0,facing)
call myCustomDamage(caster,target,LoadReal(HH,id,15),false,false,null,null,null)
call SetControlToUnit(caster,target, 1.5, "stun")
call MyRemoveUnit(LoadUnitHandle(HH,id,20),2)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
else
set Dummy=LoadUnitHandle(HH,id,20)
if time==0.02 then
call UnitSpeed(caster,1)
call SetUnitAnimationByIndex(caster,7)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
call UnitSize(n0,1,1,1)
call MoveUnit(n0,n0,50,facing)
call SetUnitFlyHeight(n0,50,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=null
endif
set time1=time1+0.02
if time1==0.1 then
call UnitCreateAndMove(caster,0x616F3031,caster,GetRandomReal(0,360),1,0.75,3,100,100,100,0,0,Dummy,30,facing)
set time1=0
endif
call SaveReal(HH,id,6,time1)
set facing=Angle2(GetUnitX(Dummy),GetUnitY(Dummy),GetUnitX(target),GetUnitY(target))
call SaveReal(HH,id,3,facing)
if SR(GetUnitX(Dummy),GetUnitY(Dummy),GetUnitX(target),GetUnitY(target))>30 then
call MoveUnit(Dummy,Dummy,25,facing)
else
set time=20
call SaveReal(HH,id,5,time)
endif
endif
set Dummy=null
set target=null
set caster=null
set t=null
endfunction
