function SakuraSlashCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local integer idu=GetHandleId(u)
local unit c=LoadUnitHandle(HH,idu,REVERSE_TARGET)
local real time=LoadReal(h,id,1)
if GetUnitAbilityLevel(u,'A19B')>0 and time<4 then
if LoadBoolean(HH,GetHandleId(u),TARGET_ABILITY)==false then
call SaveReal(h,id,1,time+0.1)
endif
if c!=null then
    call SetUnitInvulnerable(u,true)
    call SakuraSlashDamage(u,c)
endif
call PauseUnit(u,true)
set n=CreateUnit(p,'e0ZO',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,125,255,120)
call SetUnitScale(n,1,1,1)
call SetUnitTimeScale(n,0.6)
call UnitApplyTimedLife(n,1,0.4)
set n=CreateUnit(p,'e0ZO',x,y,GetRandomReal(0,359))
call SetUnitScale(n,1.25,1.25,1.25)
call SetUnitVertexColor(n,255,125,255,100)
call SetUnitTimeScale(n,0.6)
call UnitApplyTimedLife(n,1,0.4)
set n=CreateUnit(p,'e0ZO',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,125,255,80)
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitTimeScale(n,0.6)
call UnitApplyTimedLife(n,1,1.1)
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,170,200,120)
call SetUnitScale(n,1,1,1)
call SetUnitTimeScale(n,0.9)
call UnitApplyTimedLife(n,1,1.1)
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitScale(n,2,2,2)
call SetUnitVertexColor(n,255,170,200,100)
call SetUnitTimeScale(n,0.9)
call UnitApplyTimedLife(n,1,1.6)
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,170,200,80)
call SetUnitScale(n,3,3,3)
call SetUnitTimeScale(n,0.9)
call UnitApplyTimedLife(n,1,1.1)
else
call SaveBoolean(HH,idu,ANTITARGET_ABILITY,false)
call PauseUnit(u,false)
call UnitRemoveAbility(u,'A19B')
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set c=null
set t=null
endfunction
