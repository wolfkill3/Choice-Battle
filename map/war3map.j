function CondWS takes nothing returns boolean
return GetSpellAbilityId()=='A0AZ' and udg_B
endfunction
function CastWS2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real x2=LoadReal(h,id,4)
local real y2=LoadReal(h,id,5)
local real time=LoadReal(h,id,6)
local real a=LoadReal(h,id,1)
//local group g=LoadGroupHandle(h,id,3)
//local integer l__idg=GetHandleId(g)
local real dmg=(GetHeroInt(u,true)*(1+GetUnitAbilityLevel(u,'A0AZ')))+150
local player p=GetOwningPlayer(u)
//local integer l__ide
if SR(x2,y2,x1,y1)<1200 and time<1 then
call SaveReal(h,id,6,time+0.03)
call SetUnitXY_1(u,x1+45*Cos(a),y1+45*Sin(a), false)
call SetUnitFacing(u,a*bj_RADTODEG)
//call GroupEnumUnitsInRange(g,x1,y1,200,Base)
// копия Мукуро (12 тыс. треугольников) в шлейф — на каждом 3-м шаге
if ModuloInteger(R2I(time/0.03+0.5),3)==0 then
set n=CreateUnit(p,'e05A',x1,y1,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.25)
call SetUnitTimeScale(n,2)
call SetUnitAnimation(n,"attack")
endif
call SetUnitAnimation(u,"attack")
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl",x1,y1))
else
call GroupEnumUnitsInRange(G,x1,y1,350,Base)
loop
set E=FirstOfGroup(G)
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg*CambioXDmg(u),false,false,null,null,null)
call SetControlToUnit(E,E, 3, "stun")
endif
call GroupRemoveUnit(G,E)
exitwhen E==null
endloop
call UnitApplyTimedLife(CreateUnit(p,'e03X',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03W',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e05B',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03Y',x1,y1,a*bj_RADTODEG),'BTLF',1)
call FlushChildHashtable(h,id)
//call FlushChildHashtable(h,l__idg)
call DestroyTimer(t)
//call DestroyGroup(g)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call SetUnitTimeScale(u,1)
endif
set u=null
set p=null
set t=null
//set g=null
endfunction
function CastWS takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,4,GetUnitX(u))
call SaveReal(h,id,5,GetUnitY(u))
call SaveReal(h,id,1,Atan2(GetSpellTargetY()-GetUnitY(u),GetSpellTargetX()-GetUnitX(u)))
//call SaveGroupHandle(h,id,3,CreateGroup())
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SetUnitTimeScale(u,3)
call SaveReal(h,id,6,0)
call SetUnitAnimation(u,"attack")
set soundplay=SndN(1037) // Sound\Music\mp3Music\Mukuro4Form2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.03,true,function CastWS2)
set u=null
set t=null
endfunction
