function NinpoKirigakureNoJutsuCond takes nothing returns boolean
return GetSpellAbilityId()=='A0ML'
endfunction
function NinpoKirigakureNoJutsuCast2 takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(h,id,0)
        local integer i=0
        local real x=LoadReal(h,id,2)
        local real y=LoadReal(h,id,3)
        local real x1=0
        local real y1=0
        local real dmg=GetHeroAgi(u,true)*0.05
        local player p=GetOwningPlayer(u)
        local real dist=LoadReal(h,id,100)
        local real distan=1000
        if dist<7+GetUnitAbilityLevel(u,'A0ML')then
                call SaveReal(h,id,100,dist+0.1)
                // облако раз в 0.2 c (было каждые 0.1), живёт 5 c вместо 4 — туман той же плотности, юнитов вдвое меньше
                if ModuloInteger(R2I(dist*10.+0.5),2)==0 then
                        call UnitApplyTimedLife(CreateUnit(p,0x65304A54,x+GetRandomReal(-1*distan,distan),y+GetRandomReal(-1*distan,distan),0),'BTLF',5)
                endif
        else
                call DestroyTimer(t)
                call FlushChildHashtable(h,id)
        endif
        set u=null
        set t=null
        set p=null
endfunction

function MeiF_Periodic takes nothing returns nothing
        local timer newTimer = GetExpiredTimer()
        local integer id = GetHandleId(newTimer)
        local unit caster  = LoadUnitHandle(h, id, 0)
        local real point_x = LoadReal(h, id, 1)
        local real point_y = LoadReal(h, id, 2)
        local real duration = LoadReal(h, id, 3)-0.05
        call SaveReal(h, id, 3, duration)
        
        if duration > 0 then
                if SquareRootPoint(GetUnitX(caster), GetUnitY(caster), point_x, point_y)>1000 then
                        call UnitRemoveAbility(caster, 'A0MM')
                endif
                if GetUnitAbilityLevel(caster, 'A0MM')==0 then
                        if SquareRootPoint(GetUnitX(caster), GetUnitY(caster), point_x, point_y)<=1000 then
                                call UnitAddAbility(caster, 'A0MM')
                        endif
                endif
        else
                call UnitRemoveAbility(caster, 'A0MM')
                call FlushChildHashtable(h, id)
                call DestroyTimer(newTimer)
        endif
        set newTimer = null
        set caster = null
endfunction

function MeiF_AllyCast takes unit newCaster, real point_x, real point_y, real duration returns nothing
        local timer newTimer = CreateTimer()
        local integer id = GetHandleId(newTimer)
        
        call SaveUnitHandle(h, id, 0, newCaster)
        call SaveReal(h, id, 1, point_x)
        call SaveReal(h, id, 2, point_y)
        call SaveReal(h, id, 3, duration)
        call TimerStart(newTimer, 0.05, true, function MeiF_Periodic)
        set newTimer = null
endfunction

function NinpoKirigakureNoJutsuCast takes nothing returns nothing
        local unit u=GetSpellAbilityUnit()
        local timer t=CreateTimer()
        local integer id=GetHandleId(t)
        local real x=GetSpellTargetX()
        local real y=GetSpellTargetY()
        local player p=GetOwningPlayer(u)
        local integer i=0
        local integer ip=GetPlayerId(p)
        local real duration = 10.0
        call SaveReal(h,id,2,x)
        call SaveReal(h,id,3,y)
        call SaveReal(h,id,100,0)
        call SaveUnitHandle(h,id,0,u)
        set soundplay=SndN(1605) // Sound\Music\mp3Music\KirigakureNoJutsu.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                loop
                exitwhen i>=10
                if(IsUnitAlly(Hero[i],p)or u==Hero[i])and Hero[i]!=null then
                        call MeiF_AllyCast(Hero[i], x, y, duration)
                endif
                set i=i+1
                endloop
        call TimerStart(t,.1,true,function NinpoKirigakureNoJutsuCast2)
        set p=null
        set u=null
        set t=null
endfunction
function NinpoKirigakureNoJutsuInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function NinpoKirigakureNoJutsuCast)
call TriggerAddCondition(t,Condition(function NinpoKirigakureNoJutsuCond))
set t=null
endfunction
function MissleMoveMagmaBurst2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local unit u=LoadUnitHandle(h,id,7)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
local real dist=LoadReal(h,id,6)
local real time=LoadReal(h,id,8)
local real mh=LoadReal(h,id,5)
local real rd=SR(x,y,x1,y1)
local player p=GetOwningPlayer(u)
local integer idu=GetPlayerId(p)
if rd>30+speed and udg_B==true and rd<601 and GetUnitAbilityLevel(l__d,'A1BL')==0 and time<2 then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,ParabolaZ(mh,dist,rd),0)
call SaveReal(h,id,8,time+0.03)
call PauseUnit(l__d,true)
call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,true)
else
if GetUnitAbilityLevel(l__d,'A1BL')==0 then
call SetUnitFlyHeight(l__d,0,0)
endif
call SetUnitPathing(l__d,true)
call PauseUnit(l__d,false)
call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set p=null
set l__d=null
set t=null
endfunction
