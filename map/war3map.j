function TentacleCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real dmg=GetHeroInt(u,true)*(3+GetUnitAbilityLevel(u,'A1AO'))
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local player p=GetOwningPlayer(u)
call GroupEnumUnitsInRange(G,x1,y1,400,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",E,"chest"))
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 2, "stun")
endif
call GroupRemoveUnit(G,E)
endloop
call UnitApplyTimedLife(CreateUnit(p,'e03X',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03W',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e08R',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03Y',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e08N',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call SetUnitTimeScale(u,1)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set u=null
set p=null
set t=null
endfunction
function TentacleCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real x=0
local real y=0
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=bj_PI/3
local integer i=0
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,x1)
call SaveReal(h,id,3,y1)
loop
exitwhen i>=6
set x=x1+300*Cos(a*i)
set y=y1+300*Sin(a*i)
set n=CreateUnit(p,'e10H',x,y,Atan2(y1-y,x1-x)*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1)
set x=x1+450*Cos(a*i)
set y=y1+450*Sin(a*i)
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,120)
call SetUnitScale(n,1,1,1)
call SetUnitTimeScale(n,0.6)
call UnitApplyTimedLife(n,'BTLF',2)
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,120)
call SetUnitScale(n,1.25,1.25,1.25)
call SetUnitTimeScale(n,0.7)
call UnitApplyTimedLife(n,'BTLF',2)
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,120)
call SetUnitScale(n,0.75,0.75,0.75)
call SetUnitTimeScale(n,0.5)
call UnitApplyTimedLife(n,'BTLF',2)
set n=CreateUnit(p,'e10M',x,y,a)
call UnitApplyTimedLife(n,'BTLF',2)
set i=i+1
endloop
set soundplay=SndN(2564) // Sound\Music\mp3Music\Doflamingo4.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.9,false,function TentacleCast2)
set u=null
set p=null
set t=null
endfunction
