call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",u,"chest"))
call SaveUnitHandle(h,l__idg,idu,u)
endif
call GroupRemoveUnit(g,u)
exitwhen u==null
endloop
if dist>=1000 then
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
set c=null
set g=null
set u=null
set t=null
set p=null
endfunction
