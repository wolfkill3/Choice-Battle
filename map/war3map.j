function NarutoFCast takes nothing returns nothing
    local unit u=GetTriggerUnit()
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local integer i=0
    local integer j=0
    local integer idu = GetHandleId(u)
    set soundplay=SndN(2103) // Sound\Music\mp3Music\NarutoF.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    loop
    exitwhen j>=3
        set n=CreateUnit(GetOwningPlayer(u),'H14F',GetUnitX(u)+125*Cos(GetRandomReal(0,359)*bj_DEGTORAD),GetUnitY(u)+125*Sin(GetRandomReal(0,359)*bj_DEGTORAD),GetRandomReal(0,359))
        if IsUnitAlly(n,GetLocalPlayer()) then
            call SetUnitVertexColor(n,155,155,255,255)
        endif
        set EFF=AddSpecialEffect("war3mapImported\\Poff.mdx",GetUnitX(n),GetUnitY(n))
        call SetSpecialEffectScale(EFF,0.2)
        call SetSpecialEffectZ(EFF,55)
        call DestroyEffect(EFF)
        call SetHeroLevel(n,GetHeroLevel(u),false)
        call SetHeroAgi(n,GetHeroAgi(u,false),true)
        call SetHeroStr(n,GetHeroStr(u,false),true)
        call SetHeroInt(n,GetHeroInt(u,false),true)
        call SetUnitCurrentSight(n,600)
        call SetUnitUseFood(n,true)
        if GetUnitAbilityLevel(u,'A0V8')>0 then
            call UnitAddAbility(n,'A0V8')
            call SetUnitAbilityLevel(n,'A0V8',GetUnitAbilityLevel(u,'A0V8'))
            call SetAbilityIntegerLevelField(GetUnitAbility(n,'A0V8'),ABILITY_ILF_MANA_COST,GetUnitAbilityLevel(n,'A0V8')-1,R2I(GetAbilityIntegerLevelField(GetUnitAbility(u,'A0V8'),ABILITY_ILF_MANA_COST,GetUnitAbilityLevel(u,'A0V8')-1)*1.50))
            if GetAbilityRemainingCooldown(GetUnitAbility(u,'A0V8'))>0.1 then
                call StartAbilityCooldown(GetUnitAbility(n, 'A0V8'), GetAbilityRemainingCooldown(GetUnitAbility(u,'A0V8')))
            endif
        endif
        if GetUnitAbilityLevel(u,'A0V9')>0 then
            call UnitAddAbility(n,'A0V9')
            call SetUnitAbilityLevel(n,'A0V9',GetUnitAbilityLevel(u,'A0V9'))
            call SetAbilityIntegerLevelField(GetUnitAbility(n,'A0V9'),ABILITY_ILF_MANA_COST,GetUnitAbilityLevel(n,'A0V9')-1,R2I(GetAbilityIntegerLevelField(GetUnitAbility(u,'A0V9'),ABILITY_ILF_MANA_COST,GetUnitAbilityLevel(u,'A0V9')-1)*1.50))
            if GetAbilityRemainingCooldown(GetUnitAbility(u,'A0V9'))>0.1 then
                call StartAbilityCooldown(GetUnitAbility(n, 'A0V9'), GetAbilityRemainingCooldown(GetUnitAbility(u,'A0V9')))
            endif
        endif
        if GetUnitAbilityLevel(u,'A0VB')>0 then
            call UnitAddAbility(n,'A0VB')
            call SetUnitAbilityLevel(n,'A0VB',GetUnitAbilityLevel(u,'A0VB'))
        endif
        call UnitInventorySetSize(n,10)
        set i=0
        loop
        exitwhen i>=10
        if GetItemTypeId(UnitItemInSlot(u,i))!='Io39' then
            set bj_lastCreatedItem=UnitAddItemById(n,GetItemTypeId(UnitItemInSlot(u,i)))
            call SetItemDroppable(bj_lastCreatedItem,false)
            //call StartItemCooldown(bj_lastCreatedItem,9999)
        endif
        set i=i+1
        endloop
        call UnitEnableInventoryCustom(n,false,false)
        call SetUnitState(n,UNIT_STATE_LIFE,GetWidgetLife(u))
        call SetUnitState(n,UNIT_STATE_MANA,GetWidgetMana(u))
        call UnitApplyTimedLife(n,'BTLF',25)
        call SetUnitIntegerField(n,UNIT_IF_PROPER_NAME_GENERATION,0)
        set j=j+1
    endloop
    set u=null
endfunction
function InitTrig_NarutoF takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function NarutoFCond))
call TriggerAddAction(t,function NarutoFCast)
set t=null
endfunction
function RasenShurikenCond takes nothing returns boolean
return GetSpellAbilityId()=='A0VE' and udg_B==true
endfunction
function RasenShurikenCast4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real x1=LoadReal(h,id,5)
local real y1=LoadReal(h,id,6)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local player p=GetOwningPlayer(u)
local real dmg=(0.5*GetUnitAbilityLevel(u,'A0VE')+4.5)*GetHeroStr(u,true)
local group g=LoadGroupHandle(h,id,7)
local real time=LoadReal(h,id,8)
local integer l__idg=GetHandleId(g)
// урон по площади и вспышки — через тик (0.18 с), урон x2: тот же урон в секунду, обработчик урона вдвое реже
local boolean hit=ModuloInteger(R2I(time/0.09+0.5),2)==0
if time<2 then
call SaveReal(h,id,8,time+0.09)
call GroupEnumUnitsInRange(G,x,y,600,Base)
loop
set E=FirstOfGroup(G)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and LoadUnitHandle(h,l__idg,ide)!=E then
call myCustomDamage(u,E,dmg*1,false,false,null,null,null)
call SaveUnitHandle(h,l__idg,ide,E)
endif
if hit and Condition_Base(p,E)then
call myCustomDamage(u,E,dmg*0.09,false,false,null,null,null)
endif
call GroupRemoveUnit(G,E)
endloop
call UnitApplyTimedLife(CreateUnit(p,'e0SJ',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0SI',x,y,GetRandomReal(0,359)),'BTLF',1)
set n=CreateUnit(p,'e0SO',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitTimeScale(n,3)
if hit then
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,2.2,2.2,2.2)
call SetUnitVertexColor(n,150,200,255,40)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,3.2,3.2,3.2)
call SetUnitVertexColor(n,150,200,255,30)
endif
else
call KillUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitTimeScale(u,1)
call DestroyGroup(g)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
set g=null
set l__d=null
set p=null
set u=null
set t=null
endfunction
function RasenShurikenCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real a=LoadReal(h,id,11)
local real dist=LoadReal(h,id,2)
local real x=GetUnitX(l__d)+80*Cos(a)
local real y=GetUnitY(l__d)+80*Sin(a)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,12)
if dist>0 and RectContainsUnit(WorldBoundsR(),l__d)and UnitIsAlive(l__d)then
call SetUnitXY_1(l__d,x,y, false)
set n=CreateUnit(p,'e0SN',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitVertexColor(n,150,255,255,50)
set n=CreateUnit(p,'e0RR',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitVertexColor(n,255,255,255,50)
call GroupEnumUnitsInRange(g,x,y,210,Base)
set idg=GetHandleId(g)
call SaveReal(h,id,2,dist-80)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call SaveReal(h,id,2,dist-4000)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
else
call SetUnitInvulnerable(u,false)
call PauseTimer(t)
call SetUnitScale(l__d,2.5,2.5,2.5)
call SetUnitXY_1(l__d,x,y, false)
call TimerStart(t,0.09,true,function RasenShurikenCast4)
endif
set g=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
function RasenShurikenCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,5)
local real y1=LoadReal(h,id,6)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real dist=LoadReal(h,id,2)
local real scale=LoadReal(h,id,10)
local real tm=GetWidgetMana(u)
local real time=LoadReal(h,id,17)
if time>0 then
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,0.65,0.65,0.65)
call SetUnitVertexColor(n,150,200,255,50)
set n=CreateUnit(p,'e0RR',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitVertexColor(n,255,255,255,50)
call SaveReal(h,id,17,time-0.1)
else
set soundplay=SndN(2105) // Sound\Music\mp3Music\RasenShurikenThrow.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call SetUnitTimeScale(u,1)
set n=CreateUnit(p,'e0SM',x+100*Cos(a),y+100*Sin(a),a*bj_RADTODEG)
call UnitAddAbility(n,0x41305644)
call UnitRemoveAbility(u,0x41305643)
call SaveUnitHandle(h,id,7,n)
call PauseTimer(t)
call TimerStart(t,0.04,true,function RasenShurikenCast3)
endif
set p=null
set u=null
set t=null
endfunction
function RasenShurikenCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real x2=0
local real y2=0
local real a=Atan2(y1-y,x1-x)
local real ang=90*bj_DEGTORAD
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,5,x1)
call SaveReal(h,id,6,y1)
call SaveReal(h,id,2,3200)
call SaveReal(h,id,10,1.35)
call SaveReal(h,id,11,a)
call SaveReal(h,id,17,1.5)
call SetUnitTimeScale(u,0)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SaveGroupHandle(h,id,12,CreateGroup())
call SetUnitAnimation(u,"spell slam")
call SetUnitTimeScale(u,0.6)
set x2=x+65*Cos(a-ang)
set y2=y+65*Sin(a-ang)
set n=CreateUnit(p,'e0S9',x2,y2,(a+ang)*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1.6)
call SetUnitTimeScale(n,0.5)
call SetUnitAnimation(n,"spell one")
call DestroyEffect(AddSpecialEffect("war3mapImported\\shadowclone.mdl",x2,y2))
set x2=x+65*Cos(a+ang)
set y2=y+65*Sin(a+ang)
set n=CreateUnit(p,'e0S9',x2,y2,(a-ang)*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1.6)
call SetUnitTimeScale(n,0.5)
call SetUnitAnimation(n,"spell one")
call UnitAddAbility(u,0x41305643)
call DestroyEffect(AddSpecialEffect("war3mapImported\\shadowclone.mdl",x2,y2))
set soundplay=SndN(2108) // Sound\Music\mp3Music\FuutonRasenSuriken.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.1,true,function RasenShurikenCast2)
set u=null
set p=null
set t=null
endfunction
function InitTrig_RasenShuriken takes nothing returns nothing
set gg_trg_RasenShuriken=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_RasenShuriken,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_RasenShuriken,Condition(function RasenShurikenCond))
call TriggerAddAction(gg_trg_RasenShuriken,function RasenShurikenCast)
endfunction
function CrashAttackCond takes nothing returns boolean
return GetSpellAbilityId()=='A0WH'
endfunction
function CrashAttackCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local group g=LoadGroupHandle(h,id,60)
local group gn=LoadGroupHandle(h,id,61)
local integer i=0
local real x=LoadReal(h,id,50)
local real y=LoadReal(h,id,51)
local real x1=0
local real y1=0
local real dist
local real f=0
local real dmg=(GetUnitAbilityLevel(u,'A0WH')+3)*GetHeroStr(u,true)
local integer l__idg=GetHandleId(g)
local player p=GetOwningPlayer(u)
if GetUnitTypeId(u)=='H14H' then
set dist=LoadReal(h,id,SH_dist)+50
call SaveReal(h,id,SH_Dist,dist)
if dist<=50 then
set n=CreateUnit(p,'or16',x,y,0)
call SetUnitTimeScale(n,1)
call UnitApplyTimedLife(n,'BTLF',0.01)
set n=CreateUnit(p,'or17',x,y,0)
call SetUnitTimeScale(n,1)
call UnitApplyTimedLife(n,'BTLF',0.01)
set n=CreateUnit(p,'or18',x,y,0)
call SetUnitTimeScale(n,1)
call UnitApplyTimedLife(n,'BTLF',0.01)
endif
loop
exitwhen i>=9
if dist>650 and dist<=700 then
set x1=x+GetRandomReal(600,700)*Cos(45*i*bj_DEGTORAD-22*bj_DEGTORAD)
set y1=y+GetRandomReal(600,700)*Sin(45*i*bj_DEGTORAD-22*bj_DEGTORAD)
set n=CreateUnit(p,'or19',x1,y1,GetRandomReal(0,359))
call SetUnitScale(n,1,1,1)
call UnitApplyTimedLife(n,'BTLF',0.35)
call SetUnitTimeScale(n,1.5)
endif
if dist>450 and dist<=500 then
set x1=x+GetRandomReal(400,500)*Cos(45*i*bj_DEGTORAD-45*bj_DEGTORAD)
set y1=y+GetRandomReal(400,500)*Sin(45*i*bj_DEGTORAD-45*bj_DEGTORAD)
set n=CreateUnit(p,'or19',x1,y1,GetRandomReal(0,359))
call SetUnitScale(n,0.8,0.8,0.8)
call UnitApplyTimedLife(n,'BTLF',0.35)
call SetUnitTimeScale(n,1.5)
endif
if dist>150 and dist<=200 then
set x1=x+GetRandomReal(200,300)*Cos(45*i*bj_DEGTORAD)
set y1=y+GetRandomReal(200,300)*Sin(45*i*bj_DEGTORAD)
set n=CreateUnit(p,'or19',x1,y1,GetRandomReal(0,359))
call SetUnitScale(n,0.6,0.6,0.6)
call UnitApplyTimedLife(n,'BTLF',0.35)
call SetUnitTimeScale(n,1.5)
endif
set i=i+1
endloop
else
loop
set i=i+1
exitwhen i>24
set n=LoadUnitHandle(h,id,1+i)
set f=GetUnitFacing(n)*bj_DEGTORAD
set dist=LoadReal(h,id,StringHash("dist"+I2S(i)))+50
call SaveReal(h,id,StringHash("Dist"+I2S(i)),dist)
set x1=x+dist*Cos(f)
set y1=y+dist*Sin(f)
call SetUnitFacing(n,f*bj_RADTODEG)
call SetUnitX(n,x1)
call SetUnitY(n,y1)
call DestroyEffect(AddSpecialEffect("war3mapImported\\TealSlam.mdx",x1,y1))
endloop
endif
call GroupEnumUnitsInRange(g,x,y,dist,Base)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set ide=GetHandleId(E)
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E,4-dist*0.0021, "stun")
call SaveUnitHandle(h,l__idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
if dist>=450 and dist<500 then
call PauseUnit(u,false)
endif
if dist>=950 then
call SetUnitInvulnerable(u,false)
if GetUnitTypeId(u)!='H14H' then
set i=0
loop
exitwhen i>24
set n=LoadUnitHandle(h,id,1+i)
call UnitApplyTimedLife(n,'BTLF',0.1)
set i=i+1
endloop
endif
call DestroyGroup(g)
call DestroyGroup(gn)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
set gn=null
set u=null
set g=null
set t=null
set p=null
endfunction
function CrashAttackCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local integer i=0
    local real x=LoadReal(h,id,50)
    local real y=LoadReal(h,id,51)
    local real r=0.
    local real x1=0
    local real y1=0
    local real x2
    local real y2
    local real dist
    local real f=0
    local real dmg=(GetUnitAbilityLevel(u,'A0WH')+3)*GetHeroStr(u,true)
    local group g=CreateGroup()
    local integer l__idg=GetHandleId(g)
    local player p=GetOwningPlayer(u)
    call SetUnitTimeScale(u,1)
    call PauseTimer(t)
    if GetUnitTypeId(u)=='H14H' then
    call SaveGroupHandle(h,id,60,CreateGroup())
    call SaveGroupHandle(h,id,61,g)
    call UnitRemoveAbility(u,'A202')
    call TimerStart(t,.02,true,function CrashAttackCast3)
    else
    loop
    exitwhen i>24
    set r=i*15.
    set n=CreateUnit(p,'e0TF',x,y,r)
    call GroupAddUnit(g,n)
    call SaveUnitHandle(h,id,1+i,n)
    set i=i+1
    endloop
    call SaveGroupHandle(h,id,60,CreateGroup())
    call SaveGroupHandle(h,id,61,g)
    call UnitRemoveAbility(u,'A202')
    call TimerStart(t,.02,true,function CrashAttackCast3)
    endif
    set u=null
    set p=null
endfunction
