            call SetFrameColourEx( TavernHeroPick,1, 0xFF404040 )
            call SetFrameColourEx( TavernHeroPick,2, 0xFF404040 )
            endif
            call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,Lng("Очередь выбирать для ","Its turn to pick for ")+Color[9]+GetPlayerName(Player(9))+"\r")
            set pickon[9]=true
            set pick1=9

        elseif GetPlayerSlotState(Player(5))==PLAYER_SLOT_STATE_PLAYING and pickon[5]!=true then
            set TavernPlayerPickAllow[0]=false
            set TavernPlayerPickAllow[5]=true
            if GetLocalPlayer()==Player(5) then
            call SetFrameColourEx( TavernHeroPick,0, 0xFFFFFFFF )
            call SetFrameColourEx( TavernHeroPick,1, 0xFFFFFFFF )
            call SetFrameColourEx( TavernHeroPick,2, 0xFFFFFFFF )
            endif
            if GetLocalPlayer()==Player(0) then
            call SetFrameColourEx( TavernHeroPick,0, 0xFF404040 )
            call SetFrameColourEx( TavernHeroPick,1, 0xFF404040 )
            call SetFrameColourEx( TavernHeroPick,2, 0xFF404040 )
            endif

            call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,Lng("Очередь выбирать для ","Its turn to pick for ")+Color[5]+GetPlayerName(Player(5))+"\r")

            set pickon[5]=true
            set pick1=5
        endif
    elseif pick==2 then
        call DisplayTopMessage(GetLocalPlayer(),Lng("Очередь второй команды.","Second team's turn."))
        if GetPlayerSlotState(Player(1))==PLAYER_SLOT_STATE_PLAYING and pickon[1]!=true then
            set TavernPlayerPickAllow[0]=true
            set TavernPlayerPickAllow[5]=false
