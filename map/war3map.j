function HeroineChoice_Act takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit caster=GetTriggerUnit()
local unit target=GetSpellTargetUnit()
local real x0=GetUnitX(caster)
local real y0=GetUnitY(caster)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real facing=Angle2(x0,y0,x1,y1)
local integer HeroineCountKills=LoadInteger(HH,GetHandleId(  GetOwningPlayer( caster ) ) ,SH_HerKill)
//call SaveInteger(HH,GetHandleId(caster),StringHash("HerKill"),16)
call SaveUnitHandle(HH,id,1,caster)
call SaveReal(HH,id,11,x1)
call SaveReal(HH,id,12,y1)
call SaveReal(HH,id,3,facing)
if GetSpellAbilityId()=='HerT' then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
if HeroineCountKills>=12 then
call SaveBoolean(HH,id,16,true)
else
call SaveBoolean(HH,id,16,false)
endif
call SaveReal(HH,id,15,10*GetHeroAgi(caster,true))
call SaveUnitHandle(HH,id,2,target)
call TimerStart(t,0.02,true,function HeroineTAct)
endif
if GetSpellAbilityId()=='HerF' then
set target=LoadUnitHandle(HH,GetHandleId(caster),SH_HerFU)


set x1=GetUnitX( target )
set y1=GetUnitY( target )
if SR(x0,y0,x1,y1)>1500 then
set target=caster
call SaveUnitHandle(HH,GetHandleId(caster),SH_HerFU,caster)
endif


if target!=caster and target!=null and UnitIsAlive(target)==true then
if HeroineCountKills>=8 then
call SaveBoolean(HH,id,17,true)
else
call SaveBoolean(HH,id,17,false)
endif
call SaveReal(HH,id,15,3*GetHeroAgi(caster,true))
call SaveReal(HH,id,3,Angle2(x0,y0,GetUnitX(target),GetUnitY(target)))
call SaveUnitHandle(HH,id,2,target)
call SaveUnitHandle(HH,GetHandleId(caster),SH_HerFU,caster)
call TimerStart(t,0.02,true,function HeroineFAct)
else
call TimerStart(t,0.02,true,function SabracGnull)
endif
endif
if GetSpellAbilityId()=='HerG' then
call SaveReal(HH,id,15,5*GetHeroAgi(caster,true))
if HeroineCountKills>=9 then
call SaveReal(HH,id,17,1000)
call SaveReal(HH,id,15,6*GetHeroAgi(caster,true))
endif
set soundplay=SndN(2797) // Sound\Music\mp3Music\HeroineXG.mp3
call StartSound(soundplay)
////call KillSoundWhenDone(soundplay)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call UnitSpeed(caster,1.5)
call SetUnitAnimationByIndex(caster,9)
call TimerStart(t,0.02,true,function HeroineGAct)
endif
set t=null
set caster=null
set target=null
endfunction
function HeroineChoice_Cond takes nothing returns boolean
if GetSpellAbilityId()=='HerF' or GetSpellAbilityId()=='HerG' or GetSpellAbilityId()=='HerT' then
return true
else
return false
endif
endfunction
function InitTrig_HeroineXChoice takes nothing returns nothing
local trigger t=CreateTrigger()
local integer index
set index=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(index),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set index=index+1
exitwhen index==bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddCondition(t,Condition(function HeroineChoice_Cond))
call TriggerAddAction(t,function HeroineChoice_Act)
set t=null
set index=0
endfunction

//heroinex2end
function UranoMetriaCond takes nothing returns boolean
return GetSpellAbilityId()=='A1EX'
endfunction
function UranoMetriaPush2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real a=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real sc=0
local real y=GetUnitY(l__d)
local real dist=LoadReal(h,id,3)
if dist>0 and l__d!=null then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SaveReal(h,id,3,dist-speed)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set t=null
endfunction
function UranoMetriaPush takes unit l__d,real speed,real angle,real dist returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle)
call SaveReal(h,id,3,dist)
call TimerStart(t,0.03,true,function UranoMetriaPush2)
set t=null
endfunction
function MissleMoveUranoMetria2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit l__d=LoadUnitHandle(h,id,2)
local real speed=LoadReal(h,id,4)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)+LoadReal(h,id,3)
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(p)
if SR(x,y,x1,y1)>70 then
set x=x+speed*Cos(a)
set y=y+speed*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
else

call myCustomDamage(LUcy[ip],c,LoadReal(h,id,5),false,false,null,null,null)
call UranoMetriaPush(c,20,a,40)
call UnitApplyTimedLife(CreateUnit(p,'e0G1',x1,y1,GetRandomReal(0,359)),'BHwe',1)
call UnitApplyTimedLife(CreateUnit(p,'e0G2',x1,y1,GetRandomReal(0,359)),'BHwe',1)
call UnitApplyTimedLife(CreateUnit(p,'e0G3',x1,y1,GetRandomReal(0,359)),'BHwe',1)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
call UnitApplyTimedLife(l__d,'BTLF',0.01)
endif
set p=null
set l__d=null
set c=null
set t=null
set u=null
endfunction
function MissleMoveUranoMetria takes unit u,unit c,unit l__d,real speed,real angle,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveUnitHandle(h,id,2,l__d)
call SaveReal(h,id,3,angle)
call SaveReal(h,id,4,speed)
call SaveReal(h,id,5,dmg)
call TimerStart(t,0.02,true,function MissleMoveUranoMetria2)
set t=null
endfunction
function UranoMetriaCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local group g=LoadGroupHandle(h,id,3)
local player p=GetOwningPlayer(u)
local real sc=0
local integer ip=GetPlayerId(p)
local integer ur=LoadInteger(h,id,4)
if ur>0 then
call SaveInteger(h,id,4,ur-1)
set n=CreateUnit(p,'e14D',x+GetRandomReal(-300,300),y+GetRandomReal(-300,300),GetRandomReal(0,359))
call GroupAddUnit(g,n)
call SetUnitVertexColor(n,GetRandomInt(50,255),GetRandomInt(50,255),GetRandomInt(50,255),GetRandomInt(150,255))
set sc=GetRandomReal(0.3,0.9)
call SetUnitScale(n,sc,sc,sc)
call SetUnitFlyHeight(n,GetRandomReal(25,125),0)
else
loop
set E=FirstOfGroup(g)
exitwhen E==null
call MissleMoveUranoMetria(u,c,E,GetRandomReal(25,45),GetRandomReal(-0.25,0.25),GetHeroInt(LUcy[ip],true))
call GroupRemoveUnit(g,E)
endloop
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
if LoadInteger(h,id,2)==1 then




if u==Lucy[ip] then
call PauseUnit(LUcy[ip],false)
call SetUnitInvulnerable(LUcy[ip],false)
else
call PauseUnit(Lucy[ip],false)
call SetUnitInvulnerable(Lucy[ip],false)
endif

endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set p=null
set t=null
set u=null
set c=null
endfunction
function UranoMetriaCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(p)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x2=GetUnitX(c)
local real y2=GetUnitY(c)
local real x1=GetUnitX(Lucy[ip])
local real y1=GetUnitY(Lucy[ip])
local real x3=0
local real y3=0
local real a=Atan2(y2-y,x2-x)
local real sc=0
local real is=0
local real ig=30*bj_DEGTORAD




set n=CreateUnit(p,'e0RV',x,y,0)
call SetUnitTimeScale(n,0.5)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitScale(n,0.65,0.65,0.65)
call SetUnitVertexColor(n,255,255,255,100)
set n=CreateUnit(p,'e0EX',x,y,0)
call SetUnitTimeScale(n,0.75)
call SetUnitScale(n,2.75,2.75,2.75)
call UnitApplyTimedLife(n,'BTLF',2)
loop
exitwhen is==13
set n=CreateUnit(p,'e0ZH',x+350*Cos(ig*is),y+350*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,255,255,255,55)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,0.5)
set is=is+1
endloop
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveGroupHandle(h,id,3,CreateGroup())
call PauseUnit(u,true)
call SetUnitAnimation(u,"spell channel")
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitInvulnerable(u,true)


//call UnitRemoveAbility(LUcy[ip],'LUQ1')
if u==Lucy[ip] then// если кастер клон

set x1=GetUnitX(LUcy[ip])
set y1=GetUnitY(LUcy[ip])
if UnitIsAlive(LUcy[ip]) then
call StartAbilityCooldown(GetUnitAbility(LUcy[ip], 'A1EX'), 35)
endif
if SR(x,y,x1,y1)<1000 and UnitIsAlive(LUcy[ip])  then

call SaveInteger(h,id,2,1)
call PauseUnit(LUcy[ip],true)
call SaveInteger(h,id,4,12)
call SetUnitX(LUcy[ip],x)
call SetUnitY(LUcy[ip],y)
call SetUnitInvulnerable(LUcy[ip],true)
call SetUnitAnimation(Lucy[ip],"spell channel")
call SetUnitFacing(LUcy[ip],a*bj_RADTODEG)



call TimerStart(t,0.1,true,function UranoMetriaCast2)




else
call SaveInteger(h,id,2,0)
call SaveInteger(h,id,4,12)
call TimerStart(t,0.2,true,function UranoMetriaCast2)
endif



else



if UnitIsAlive(Lucy[ip]) then
call StartAbilityCooldown(GetUnitAbility(Lucy[ip], 'A1EX'), 35)
endif





if SR(x,y,x1,y1)<1000 and UnitIsAlive(Lucy[ip])  then
call SaveInteger(h,id,2,1)
call PauseUnit(Lucy[ip],true)
call SaveInteger(h,id,4,12)
call SetUnitX(Lucy[ip],x)
call SetUnitY(Lucy[ip],y)
call SetUnitInvulnerable(Lucy[ip],true)
call SetUnitAnimation(Lucy[ip],"spell channel")
call SetUnitFacing(Lucy[ip],a*bj_RADTODEG)





call TimerStart(t,0.1,true,function UranoMetriaCast2)
else
call SaveInteger(h,id,2,0)
call SaveInteger(h,id,4,12)
call TimerStart(t,0.2,true,function UranoMetriaCast2)
endif

endif


set soundplay=SndN(2799) // Sound\Music\mp3Music\URANOMETORIA.mp3
call StartSound(soundplay)
////call KillSoundWhenDone(soundplay)
set p=null
set c=null
set u=null
set t=null
endfunction
function InitTrig_UranoMetria takes nothing returns nothing
set gg_trg_UranoMetria=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_UranoMetria,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_UranoMetria,Condition(function UranoMetriaCond))
call TriggerAddAction(gg_trg_UranoMetria,function UranoMetriaCast)
endfunction
function LucyKozelCond takes nothing returns boolean
