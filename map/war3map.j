if IsUnitType(u,UNIT_TYPE_HERO) and CPTModeON and cmb==true then
    if IsUnitType(u,UNIT_TYPE_HERO)then
        call RemoveUnitFromAllStock(GetUnitTypeId(u))
        call RemoveUnit(u)
        set i=0
        loop
        exitwhen i>=145 //139
            if GetUnitTypeId(u)==udg_RH[i] then
                set udg_RH[i]=0
            endif
            set i=i+1
        endloop
        if (Globalpick>=0 and Globalpick<=6) or (Globalpick>=10 and Globalpick<=16) or (Globalpick>=20 and Globalpick<=24) then
            if Globalteam==5 then
                if cmp==1 then
                    if cmi==8 or cmi==6 or cmi==4 or cmi==3 or cmi==1 then
                        set cmp=2
                    endif
                    set cmi=cmi-1
                    call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,Lng("Первая команда заблокировала ","The first team have blocked ")+GetUnitName(u)+Lng(" осталось еще ",". There is still ")+I2S(cmi)+Lng(" бана(ов)!"," bans left!"))
                elseif cmp==2 then
                    if cmi2==8 or cmi2==7 or cmi2==5 or cmi2==3 or cmi2==2 or cmi2==1 then
                        set cmp=1
                    endif
                    set cmi2=cmi2-1
                    call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,Lng("Вторая команда заблокировала ","The second team have blocked ")+GetUnitName(u)+Lng(" осталось еще ",". There is still ")+I2S(cmi2)+Lng(" бана(ов)!"," bans left!"))
                endif
                if cmi<=0 then
                    set cmp=2
                endif
                if cmi2<=0 then
                    set cmp=1
                endif
            elseif Globalteam==0 then
                if cmp==1 then
                    if cmi==8 or cmi==7 or cmi==5 or cmi==3 or cmi==2 or cmi==1 then
                        set cmp=2
                    endif
                    set cmi=cmi-1
                    call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,Lng("Первая команда заблокировала ","The first team have blocked ")+GetUnitName(u)+Lng(" осталось еще ",". There is still ")+I2S(cmi)+Lng(" бана(ов)!"," bans left!"))
                elseif cmp==2 then
                    if cmi2==8 or cmi2==6 or cmi2==4 or cmi2==3 or cmi2==1 then
                        set cmp=1
                    endif
                    set cmi2=cmi2-1
                    call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,Lng("Вторая команда заблокировала "+GetUnitName(u)+" осталось еще "+I2S(cmi2)+" бана(ов)!","The second team have blocked "+GetUnitName(u)+". There is still "+I2S(cmi2)+" bans left!"))
                endif
                if cmi<=0 then
                    set cmp=2
                endif
                if cmi2<=0 then
                    set cmp=1
                endif
            endif
        endif
    endif
endif
if CPTModeON==true and nowpick2<playedplayers then
    set Globalpick=Globalpick+1
    call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,"\n")
    set l__s=0
    set randcond=false
    if Globalteam==0 then
        if Globalpick==6 or Globalpick==9 or Globalpick==17 or Globalpick==18 or Globalpick==24 then
            set pick=2
            set cmb=false
        elseif Globalpick==7 or Globalpick==8 or Globalpick==16 or Globalpick==19 or Globalpick==25 then
            set pick=1
            set cmb=false
        else
            set pick=0
            set cmb=true
            set udg_RM=false
        endif
    else
        if Globalpick==6 or Globalpick==9 or Globalpick==17 or Globalpick==18 or Globalpick==24 then
            set pick=1
            set cmb=false
        elseif Globalpick==7 or Globalpick==8 or Globalpick==16 or Globalpick==19 or Globalpick==25 then
            set pick=2
            set cmb=false
        else
            set pick=0
            set cmb=true
            set udg_RM=false
        endif
    endif
    call DestroyTimerDialog(udg_Captain)
    call DestroyTimerDialog(udg_Ban1)
    call TimerStart(udg_Timer3,  30,false,null) //Start
    set udg_Ban1=CreateTimerDialog(udg_Timer3)
    call LANG_TdTitle(udg_Ban1,"Осталось времени:","Time Left:")
    call TimerDialogDisplay(udg_Ban1,true)
    call ShowFrame( GetOriginFrame( ORIGIN_FRAME_MULTIBOARD, 0 ), false ) 
endif
if IsUnitType(u,UNIT_TYPE_HERO) and CPTModeON and cmb==true then
    if (cmp==2 and cmi2>0) and ((Globalpick>=0 and Globalpick<=6) or (Globalpick>=10 and Globalpick<=16) or (Globalpick>=20 and Globalpick<=24)) then
        call DisplayTopMessage(GetLocalPlayer(),Lng("Очередь второй команды.","Second team's turn."))
        set soundplay=SndN(693) // Sound\war3mapImported\Kirei E(OtkatQ).mp3
        if GetLocalPlayer()==Player(5) then
        call StartSound(soundplay)
        endif
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        set TavernPlayerPickAllow[0]=false
        set TavernPlayerPickAllow[5]=true
        call SetFrameText( TavernHeroPickText, "Ban")
        if GetLocalPlayer()==Player(5) then
        call SetFrameColourEx( TavernHeroPick,0, 0xFFFF2020 )
        call SetFrameColourEx( TavernHeroPick,1, 0xFFFF2020 )
        call SetFrameColourEx( TavernHeroPick,2, 0xFFFF2020 )
        endif
        if GetLocalPlayer()==Player(0) then
        call SetFrameColourEx( TavernHeroPick,0, 0xFF902020 )
        call SetFrameColourEx( TavernHeroPick,1, 0xFF902020 )
        call SetFrameColourEx( TavernHeroPick,2, 0xFF902020 )
        endif
    endif
    if (cmp==1 and cmi>0) and ((Globalpick>=0 and Globalpick<=6) or (Globalpick>=10 and Globalpick<=16) or (Globalpick>=20 and Globalpick<=24)) then
        call DisplayTopMessage(GetLocalPlayer(),Lng("Очередь первой команды.","The first team's turn."))
        set soundplay=SndN(693) // Sound\war3mapImported\Kirei E(OtkatQ).mp3
        if GetLocalPlayer()==Player(0) then
        call StartSound(soundplay)
        endif
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        set TavernPlayerPickAllow[5]=false
        set TavernPlayerPickAllow[0]=true
        call SetFrameText( TavernHeroPickText, "Ban")
        if GetLocalPlayer()==Player(0) then
        call SetFrameColourEx( TavernHeroPick,0, 0xFFFF2020 )
        call SetFrameColourEx( TavernHeroPick,1, 0xFFFF2020 )
        call SetFrameColourEx( TavernHeroPick,2, 0xFFFF2020 )
        endif
        if GetLocalPlayer()==Player(5) then
        call SetFrameColourEx( TavernHeroPick,0, 0xFF902020 )
        call SetFrameColourEx( TavernHeroPick,1, 0xFF902020 )
        call SetFrameColourEx( TavernHeroPick,2, 0xFF902020 )
        endif
    endif
endif
if cmb!=true and CPTModeON and pick!=0 and pick!=3 and ((Globalpick>=6 and Globalpick<10) or (Globalpick>=16 and Globalpick<20) or (Globalpick>=24 and Globalpick<26)) then
    set l__s=0
    call SetFrameText( TavernHeroPickText, "Select")
    if pick==1 then
        call DisplayTopMessage(GetLocalPlayer(),Lng("Очередь первой команды.","The first team's turn."))
        if GetPlayerSlotState(Player(6))==PLAYER_SLOT_STATE_PLAYING and pickon[6]!=true then
            set TavernPlayerPickAllow[0]=false
            set TavernPlayerPickAllow[5]=true
            if GetLocalPlayer()==Player(5) then
            call SetFrameColourEx( TavernHeroPick,0, 0xFFFFFFFF )
            call SetFrameColourEx( TavernHeroPick,1, 0xFFFFFFFF )
            call SetFrameColourEx( TavernHeroPick,2, 0xFFFFFFFF )
            endif
            if GetLocalPlayer()==Player(0) then
            call SetFrameColourEx( TavernHeroPick,0, 0xFF404040 )
            call SetFrameColourEx( TavernHeroPick,1, 0xFF404040 )
            call SetFrameColourEx( TavernHeroPick,2, 0xFF404040 )
            endif
            call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,Lng("Очередь выбирать для ","Its turn to pick for ")+Color[6]+GetPlayerName(Player(6))+"\r")
            set pickon[6]=true
            set pick1=6

        elseif GetPlayerSlotState(Player(7))==PLAYER_SLOT_STATE_PLAYING and pickon[7]!=true then
            set TavernPlayerPickAllow[0]=false
            set TavernPlayerPickAllow[5]=true
            if GetLocalPlayer()==Player(5) then
            call SetFrameColourEx( TavernHeroPick,0, 0xFFFFFFFF )
            call SetFrameColourEx( TavernHeroPick,1, 0xFFFFFFFF )
            call SetFrameColourEx( TavernHeroPick,2, 0xFFFFFFFF )
            endif
            if GetLocalPlayer()==Player(0) then
            call SetFrameColourEx( TavernHeroPick,0, 0xFF404040 )
            call SetFrameColourEx( TavernHeroPick,1, 0xFF404040 )
            call SetFrameColourEx( TavernHeroPick,2, 0xFF404040 )
            endif
            call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,Lng("Очередь выбирать для ","Its turn to pick for ")+Color[7]+GetPlayerName(Player(7))+"\r")
            set pickon[7]=true
            set pick1=7

        elseif GetPlayerSlotState(Player(8))==PLAYER_SLOT_STATE_PLAYING and pickon[8]!=true then
            set TavernPlayerPickAllow[0]=false
            set TavernPlayerPickAllow[5]=true
            if GetLocalPlayer()==Player(5) then
            call SetFrameColourEx( TavernHeroPick,0, 0xFFFFFFFF )
            call SetFrameColourEx( TavernHeroPick,1, 0xFFFFFFFF )
            call SetFrameColourEx( TavernHeroPick,2, 0xFFFFFFFF )
            endif
            if GetLocalPlayer()==Player(0) then
            call SetFrameColourEx( TavernHeroPick,0, 0xFF404040 )
            call SetFrameColourEx( TavernHeroPick,1, 0xFF404040 )
            call SetFrameColourEx( TavernHeroPick,2, 0xFF404040 )
            endif
            call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,Lng("Очередь выбирать для ","Its turn to pick for ")+Color[8]+GetPlayerName(Player(8))+"\r")
            set pickon[8]=true
            set pick1=8

        elseif GetPlayerSlotState(Player(9))==PLAYER_SLOT_STATE_PLAYING and pickon[9]!=true then
            set TavernPlayerPickAllow[0]=false
            set TavernPlayerPickAllow[5]=true
            if GetLocalPlayer()==Player(5) then
            call SetFrameColourEx( TavernHeroPick,0, 0xFFFFFFFF )
            call SetFrameColourEx( TavernHeroPick,1, 0xFFFFFFFF )
            call SetFrameColourEx( TavernHeroPick,2, 0xFFFFFFFF )
