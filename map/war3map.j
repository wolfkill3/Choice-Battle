set y1=GetUnitY(n)
call ChariotMissleFly(n,25,0,x1+(sr+300)*Cos(a),y1+(sr+300)*Sin(a),1880,dmg)
set n=CreateUnit(p,0x65304251,x+330*Cos(a3),y+330*Sin(a3),a2)
call UnitApplyTimedLife(n,1,2)
