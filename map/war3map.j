endfunction
function FDeidaraCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=LoadReal(h,id,3)
local real y=LoadReal(h,id,4)
local real dmg=GetHeroInt(u,true)*10
local group g=LoadGroupHandle(h,id,1)
local real rd=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
local integer time = LoadInteger(h,id,5)
local integer alpha = LoadInteger(h,id,6)
if time == 5 then
        set EFF = AddSpecialEffect("war3mapImported\\Thunder Nebula.mdl",x,y)
        call SetSpecialEffectScale(EFF, 0.2)
        call SetSpecialEffectVertexColour(EFF, 0,0,0,150)
        call SetSpecialEffectZ(EFF, 100)
        call SaveAgentHandle(h,id,7,EFF)
    set soundplay=CreateSound("Sound\\war3mapImported\\DeidaraF1.mp3",false,false,false,1,3,null)
        call StartSound(soundplay)
        call SetSoundVolume(soundplay,230)
        call KillSoundWhenDone(soundplay)
endif

if time <= 40 then
        set EFF = AddSpecialEffect("war3mapImported\\DustWaveFx.mdl",x,y)
        call SetSpecialEffectFacing(EFF , GetRandomReal(0,359))
        call SetSpecialEffectScale(EFF, GetRandomReal(0.1,1))
        call SetSpecialEffectVertexColour(EFF, 0,0,0,50)
        call SetSpecialEffectZ(EFF, GetRandomReal(0,150))
        call SetSpecialEffectRoll(EFF,GetRandomReal(-359,359))
        call DestroyEffect(EFF)
endif

if time <= 47 then
        call SaveInteger(h,id,5, time + 1)
        call SaveInteger(h,id,6, alpha - 5)
        call SetUnitVertexColor(u,255,255,255, alpha)
endif


if UnitIsAlive(u)==true and udg_B==true and DU2==true then
    if time == 42 then
        call DestroyEffect(LoadEffectHandle(h,id,7))
        set n=CreateUnit(p,'eo9S',x,y,90)
        call UnitApplyTimedLife(n,1,3)
        set soundplay=CreateSound("Sound\\war3mapImported\\DeidaraF.mp3",false,false,false,1,3,null)
        call StartSound(soundplay)
        call SetSoundVolume(soundplay,250)
        call KillSoundWhenDone(soundplay)
        call PauseUnit(u,true)
        call SetUnitInvulnerable(u,true)
    endif
    if rd<1500 and time >= 42 then
            call SaveReal(h,id,2,rd+30)
            call GroupEnumUnitsInRange(G,x,y,rd,Base)
            loop
            set E=FirstOfGroup(G)
            exitwhen E==null
            if Condition_Base(p,E)and IsUnitInGroup(E,g)==false then
            if IsUnitInvulnerable(E)==true then
            call SetUnitInvulnerable(E,false)
            call UnitRemoveBuffs(E,true,true)
            call UnitAddAbility(E,'A0WR')
            call myCustomDamage(u,E,dmg,false,false,null,DAMAGE_TYPE_UNIVERSAL,null)
            call DamageIndicatorFunction(u, E, dmg)
            call DamageTextTag(u, E, dmg)
            call UnitRemoveAbility(E,'A0WR')
            call SetControlToUnit(E,E, 0.5, "stun")
            call SetUnitInvulnerable(E,true)
        else
            call UnitRemoveBuffs(E,true,true)
            call UnitAddAbility(E,'A0WR')
            call myCustomDamage(u,E,dmg,false,false,null,DAMAGE_TYPE_UNIVERSAL,null)
            call DamageIndicatorFunction(u, E, dmg)
            call DamageTextTag(u, E, dmg)
            call UnitRemoveAbility(E,'A0WR')
            call SetControlToUnit(E,E, 0.5, "stun")
        endif
            call GroupAddUnit(g,E)
            endif
            call GroupRemoveUnit(G,E)
            endloop
    else
            if rd >= 1500 and time >= 42 then
            call SetUnitVertexColor(u, 255,255,255,255)
            call PauseUnit(u,false)
            call SetUnitInvulnerable(u,false)
            call SetUnitTargetable(u,false)
            if udg_B==true then
                call KillUnit(u)
            endif
            call GroupClear(g)
            call DestroyGroup(g)
            call FlushChildHashtable(h,id)
            call DestroyTimer(t)
            set p=null
            set g=null
            set u=null
            set t=null
        endif
    endif
else
    call DestroyEffect(LoadEffectHandle(h,id,7))
    call SetUnitVertexColor(u, 255,255,255,255)
    call PauseUnit(u,false)
    call SetUnitInvulnerable(u,false)
    call SetUnitTargetable(u,false)
    call GroupClear(g)
    call DestroyGroup(g)
    call FlushChildHashtable(h,id)
    call DestroyTimer(t)
    set p=null
    set g=null
    set u=null
    set t=null
endif
endfunction
