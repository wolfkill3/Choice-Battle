function ParabolaZ2 takes real y0,real y1,real l__h,real l__d,real x returns real
return(2*(y0+y1-2*l__h)*(x/l__d-1)+(y1-y0))*(x/l__d)+y0
endfunction
function AU takes unit a, unit b returns real
    return Atan2(GetUnitY(b)-GetUnitY(a),GetUnitX(b)-GetUnitX(a))
endfunction
function AddWidgetLife takes unit newUnit,real bonus returns nothing
call SetWidgetLife(newUnit,GetWidgetLife(newUnit)+bonus)
endfunction
function MyRemoveUnitAct takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit localRemoveUnit=LoadUnitHandle(h,id,0)
    if localRemoveUnit!=null then
        call RemoveUnit(localRemoveUnit)
    endif
    call FlushChildHashtable(h,id)
    call DestroyTimer(GetExpiredTimer())
    set t=null
    set localRemoveUnit=null
endfunction

function MyRemoveUnit takes unit newRemoveUnit,real newDur returns nothing
    local integer id
    set RemoveUnitTimer=CreateTimer()
    set id=GetHandleId(RemoveUnitTimer)
    call SaveUnitHandle(h,id,0,newRemoveUnit)
    call TimerStart(RemoveUnitTimer, newDur, false, function MyRemoveUnitAct)
    set RemoveUnitTimer=null
endfunction

function GetWidgetMaxLife takes unit newUnit returns real
        return GetUnitState(newUnit,UNIT_STATE_MAX_LIFE)
endfunction
function AtanPoint takes real x,real y,real x2,real y2 returns real
        return Atan2(y2-y,x2-x)
endfunction

function AP takes real x,real y,real x2,real y2 returns real
    return Atan2(y2 - y, x2 - x)
endfunction

function SquareRootPoint takes real x,real y,real x2,real y2 returns real
    return SquareRoot(( x - x2 ) * ( x - x2 ) + ( y - y2 ) * ( y - y2 ))
endfunction

function FilterA takes unit b,unit a returns boolean
    return IsUnitAlly(b, GetOwningPlayer(a)) and GetWidgetLife(b) > .405
endfunction

function B2S_EXD takes boolean booli returns string
if booli==true then
    return "true"
else
    return "false"
endif
endfunction
function MUIHandle takes nothing returns integer
                return GetHandleId( GetExpiredTimer( ) )
        endfunction
    
    function LoadUnit takes string s returns unit
                return LoadUnitHandle(HH,MUIHandle(),StringHash(s))
        endfunction
    
    function LoadEffect takes string s returns effect
                return LoadEffectHandle(HH,MUIHandle(),StringHash(s))
        endfunction
    
    function LoadInt takes string s returns integer
                return LoadInteger(HH,MUIHandle(),StringHash(s))
        endfunction
    
    function LoadFloat takes string s returns real
                return LoadReal(HH,MUIHandle(),StringHash(s))
        endfunction
    
    function LoadPlayer takes string s returns player
                return LoadPlayerHandle(HH,MUIHandle(),StringHash(s))
        endfunction
    
    function LoadGroup takes string s returns group
                return LoadGroupHandle(HH,MUIHandle(),StringHash(s))
        endfunction
    
    function LoadImage takes string s returns image
                return LoadImageHandle(HH,MUIHandle(),StringHash(s))
        endfunction

    function GetHandleID takes nothing returns integer
                return GetHandleId( GetExpiredTimer( ) )
        endfunction
    
    function GetUnitEvent takes trigger LocTrig, playerunitevent whichEvent, code Act returns trigger
                local integer index = 0
                loop
                        exitwhen index == 11
                        call TriggerRegisterPlayerUnitEvent( LocTrig, Player( index ), whichEvent, null )
                        set index = index + 1
                endloop
        if Act!=null then
            call TriggerAddAction(LocTrig, Act)
        endif
        return LocTrig
        endfunction
        
        function TimerPause takes timer LocTimer returns nothing
                if LoadBoolean( HH, GetHandleId( LocTimer ), TIMER_STARTED_HASH ) == true then
                        call PauseTimer( LocTimer )
                        call SaveBoolean( HH, GetHandleId( LocTimer ), TIMER_STARTED_HASH, false )
                endif
        endfunction     

        function TimerResume takes timer LocTimer returns nothing
                if LoadBoolean( HH, GetHandleId( LocTimer ), TIMER_STARTED_HASH ) == false then
                        call ResumeTimer( LocTimer )
                        call SaveBoolean( HH, GetHandleId( LocTimer ), TIMER_STARTED_HASH, true )
                endif
        endfunction     
  
        function Clear takes integer HandleID returns nothing
        if LoadGroup("Group") != null then
            call GroupClear(LoadGroup("Group"))
            call DestroyGroup(LoadGroup("Group"))
            call RemoveSavedHandle(HH,HandleID, GroupHash)
        endif
        if LoadUnitHandle(HH,MUIHandle(),CasterHash) != null then
            call RemoveSavedHandle(HH,HandleID,CasterHash)
        endif
        if LoadUnit("Target") != null then
            call RemoveSavedHandle(HH,HandleID,TargetHash)
        endif
        if LoadUnit("Dummy") != null then
            call RemoveUnit(LoadUnit("Dummy"))
            call RemoveSavedHandle(HH,HandleID,DummyHash)
        endif
                //call PauseTimer( GetExpiredTimer( ) )
        call RemoveSavedHandle(HH,HandleID ,SH_TI)
        call TimerPause(GetExpiredTimer( ))
        call FlushChildHashtable( HH, HandleID )
                //call DestroyTimer( GetExpiredTimer( ) )
        endfunction     
    
        function LoadTimer takes integer PID returns timer
                return LoadTimerHandle(HH,GetHandleId(Player(PID)),LoadInteger(HH,GetHandleId(Player(PID)),TIMER_ITERATOR_HASH))
        endfunction
    
    function SetUnitDatas takes unit a, integer id, integer Amount returns nothing
                call SaveInteger( HH, GetHandleId(a), id, Amount )
        endfunction 

        function GetUnitDatas takes unit a, integer id returns integer
                return LoadInteger(HH, GetHandleId(a), id)
        endfunction
    
        function ExtraTime takes nothing returns nothing
                call SaveInteger( HH, MUIHandle( ), TIME_HASH, LoadInt( "Time" ) + 1 )
        endfunction
    
        function NewTimer takes integer PID returns integer
        local integer idp=GetHandleId(Player( PID ))
                local integer GetIterator = LoadInteger( HH, idp, TIMER_ITERATOR_HASH )
        local integer idcs = GetHandleId( CS )
                if GetIterator > LoadInteger( HH, idcs, TIMER_MAX_COUNT_HASH ) then
                        set GetIterator = 0
                endif

                loop
                        exitwhen LoadBoolean( HH, GetHandleId( LoadTimerHandle( HH, idp, GetIterator ) ), TIMER_STARTED_HASH ) == false
                        set GetIterator = GetIterator + 1
                        if GetIterator > LoadInteger( HH, idcs, TIMER_MAX_COUNT_HASH ) then
                                set GetIterator = 0
                        endif
                endloop

                call SaveInteger( HH, idp, TIMER_ITERATOR_HASH, GetIterator )
                set GetIterator = LoadInteger( HH, idp, TIMER_ITERATOR_HASH )
                if LoadTimerHandle( HH, idp, GetIterator ) == null then
                        call SaveTimerHandle( HH, idp, GetIterator, CreateTimer( ) )
                endif

                call SaveBoolean( HH, GetHandleId( LoadTimerHandle( HH, idp, GetIterator ) ), TIMER_STARTED_HASH, true )
                return GetHandleId( LoadTimerHandle( HH, idp, GetIterator ) )
    endfunction


    function SetUnitXY takes unit Target,real ToX,real ToY returns nothing
                //if GetUnitMoveSpeed(Target) > 0 then
                        call SetUnitX(Target, ToX)
                        call SetUnitY(Target, ToY)
                //else
                //      call SetUnitPosition(Target, ToX, ToY)
                //endif
        endfunction
    function SetUnitXY_1 takes unit Target,real ToX,real ToY,boolean Pathing returns nothing
                if Pathing and IsTerrainPathable(ToX, ToY, PATHING_TYPE_FLYABILITY) then
            call SetUnitXY(Target , GetUnitX(Target) , GetUnitY(Target))
                        return
                endif
                call SetUnitXY(Target , ToX , ToY)
        endfunction
    
    //#ExportTo Scripts\API\MUI.j
    function SetMUITimerEx takes hashtable table, integer pid returns integer
        local integer MaxTimer = 1000
        local integer idp=GetHandleId(Player( pid ))
        local integer Iterator = LoadInteger( table, idp, TIMER_ITERATOR_HASH )
    
        if pid >= 12 and pid <= 15 then
            set MaxTimer = 4000
        endif
    
        loop
            exitwhen not LoadBoolean( table, GetHandleId( LoadTimerHandle( table, idp, StringHash( "Timer_Num_" + I2S( Iterator ) ) ) ), TIMER_STARTED_HASH ) and Iterator <= MaxTimer
            if Iterator > MaxTimer then
                set Iterator = 0
            else
                set Iterator = Iterator + 1
            endif
        endloop
    
        call SaveInteger( table, idp, TIMER_ITERATOR_HASH, Iterator )
    
        if LoadTimerHandle( table, idp, StringHash( "Timer_Num_" + I2S( Iterator ) ) ) == null then
            call SaveTimerHandle( table, idp, StringHash( "Timer_Num_" + I2S( Iterator ) ), CreateTimer( ) )
        endif
    
        return GetHandleId( LoadTimerHandle( table, idp, StringHash( "Timer_Num_" + I2S( Iterator ) ) ) )
    endfunction
    
    function LoadMUITimerEx takes hashtable table, integer pid returns timer
        local integer Iterator = LoadInteger( table, GetHandleId( Player( pid ) ), TIMER_ITERATOR_HASH )
        call SaveBoolean( table, GetHandleId( LoadTimerHandle( table, GetHandleId( Player( pid ) ), StringHash( "Timer_Num_" + I2S( Iterator ) ) ) ), TIMER_STARTED_HASH, true )
        return LoadTimerHandle( table, GetHandleId( Player( pid ) ), StringHash( "Timer_Num_" + I2S( Iterator ) ) )
    endfunction
    
    function SetMUITimer takes integer pid returns integer
        return SetMUITimerEx( htMain, pid )
    endfunction
    
    function LoadMUITimer takes integer pid returns timer
        return LoadMUITimerEx( htMain, pid )
    endfunction
    
    function TimerPause1 takes timer LocTimer returns nothing
        if LoadBoolean( htMain, GetHandleId( LocTimer ), TIMER_STARTED_HASH ) then
            call PauseTimer( LocTimer )
            //call DestroyTimer(LocTimer)
            call SaveBoolean( htMain, GetHandleId( LocTimer ), TIMER_STARTED_HASH, false )
        endif
    endfunction 
    
    function TimerResume1 takes timer LocTimer returns nothing
        if not LoadBoolean( htMain, GetHandleId( LocTimer ), TIMER_STARTED_HASH ) then
            call ResumeTimer( LocTimer )
            call SaveBoolean( htMain, GetHandleId( LocTimer ), TIMER_STARTED_HASH, true )
        endif
    endfunction
    
    function PTimer takes handle target, string hashname returns integer
        if LoadTimerHandle( htMain, GetHandleId( target ), StringHash( hashname ) ) == null then
            call SaveTimerHandle( htMain, GetHandleId( target ), StringHash( hashname ), CreateTimer( ) )
        endif
    
        return GetHandleId( LoadTimerHandle( htMain, GetHandleId( target ), StringHash( hashname ) ) )
    endfunction
    
    function CleanMUI takes timer Timer returns nothing
        call TimerPause1( Timer )
        call FlushChildHashtable( htMain, GetHandleId( Timer ) )
    endfunction
    
    function GetItem takes string hashname returns item
        return LoadItemHandle( htMain, MUIHandle( ), StringHash( hashname ) )
    endfunction 
    
    function GetPlayer takes string hashname returns player
        return LoadPlayerHandle( htMain, MUIHandle( ), StringHash( hashname ) )
    endfunction 
    
    function GetUnit takes string hashname returns unit
        return LoadUnitHandle( htMain, MUIHandle( ), StringHash( hashname ) )
    endfunction 
    
    function GetGroup takes string hashname returns group
        return LoadGroupHandle( htMain, MUIHandle( ), StringHash( hashname ) )
    endfunction 
    
    function GetStr takes string hashname returns string
        return LoadStr( htMain, MUIHandle( ), StringHash( hashname ) )
    endfunction
    
    function GetInt takes string hashname returns integer
        return LoadInteger( htMain, MUIHandle( ), StringHash( hashname ) )
    endfunction 
    
    function GetReal takes string hashname returns real
        return LoadReal( htMain, MUIHandle( ), StringHash( hashname ) )
    endfunction
    
    function GetBool takes string hashname returns boolean 
        return LoadBoolean( htMain, MUIHandle( ), StringHash( hashname ) )
    endfunction 
    
    function GetEffect takes string hashname returns effect 
        return LoadEffectHandle( htMain, MUIHandle( ), StringHash( hashname ) )
    endfunction
    
    function GetLightning takes string hashname returns lightning 
        return LoadLightningHandle( htMain, MUIHandle( ), StringHash( hashname ) )
    endfunction 
    
    function GetTextTag takes string hashname returns texttag 
        return LoadTextTagHandle( htMain, MUIHandle( ), StringHash( hashname ) )
    endfunction
    
    function Stop_Spells takes nothing returns boolean
        return LoadBoolean( htMain, GetHandleId( htMain ), SH_Event_Stop_Spells )
    endfunction

    
    function Counter takes integer Num, integer Limit returns boolean
        if not GetBool( "FirstCounted" + I2S( Num ) ) then
            call SaveBoolean( htMain, MUIHandle( ), StringHash( "FirstCounted" + I2S( Num ) ), true )
            return true
        endif
    
        call SaveInteger( htMain, MUIHandle( ), StringHash( "Counter" + I2S( Num ) ), GetInt( "Counter" + I2S( Num ) ) + 1 )
        if GetInt( "Counter" + I2S( Num ) ) == Limit then
            call SaveInteger( htMain, MUIHandle( ), StringHash( "Counter" + I2S( Num ) ), 0 )
            return true
        endif
    
        return false
    endfunction
    
    function StoreTime takes string whattype, integer time returns nothing
        call SaveInteger( htMain, MUIHandle( ), StringHash( whattype ), time )
    endfunction
    
    function SpellTime takes nothing returns integer
        call SaveInteger( htMain, MUIHandle( ), SH_SpellTime, GetInt( "SpellTime" ) + 1 )
        return GetInt( "SpellTime" )
    endfunction
    
    function SetUnitData takes unit target, string hashname, integer value returns nothing
        call SaveInteger( htMain, GetHandleId( target ), StringHash( hashname ), value )
    endfunction 
    
    function GetUnitData takes unit target, string hashname returns integer
        return LoadInteger( htMain, GetHandleId( target ), StringHash( hashname ) )
    endfunction
    
    function SetUnitReal takes unit target, string hashname, real value returns nothing
        call SaveReal( htMain, GetHandleId( target ), StringHash( hashname ), value )
    endfunction 
    
    function GetUnitReal takes unit target, string hashname returns real
        return LoadReal( htMain, GetHandleId( target ), StringHash( hashname ) )
    endfunction

    function UnitLife2 takes unit u,integer i,real duration returns nothing
    call UnitApplyTimedLife(u,i,duration)
    set u=null
    set i=0
    set duration=0.0
    endfunction

    function UnitLife takes unit target returns real
        return GetUnitState( target, UNIT_STATE_LIFE )
    endfunction

    function UnitMaxLife takes unit target returns real
        return GetUnitState( target, UNIT_STATE_MAX_LIFE )
    endfunction
    
    function UnitMissingLife takes unit target returns real
        return UnitMaxLife( target ) - UnitLife( target )
    endfunction

    function CC_Cast takes unit user, unit target, string order, string t_type returns nothing
        local integer pid = GetPlayerId(GetOwningPlayer(user))
        //call UnitShareVision(  target, Player( pid ), true )
        set n = CreateUnit(Player(pid), 'dumm', GetUnitX(target),GetUnitY(target),GetUnitFacing(user))
        call SetUnitFacingInstant(n,Atan2(GetUnitY(target)-GetUnitY(n),GetUnitX(target)-GetUnitX(n))*bj_RADTODEG)
        call UnitApplyTimedLife(n,'BTLF',0.08)
        //call SetUnitOwner( caster, Player( pid ), false )
        //call SetUnitX(  caster, GetUnitX( target ) )
        //call SetUnitY(  caster, GetUnitY( target ) )
        if t_type == "Target" then
            call IssueTargetOrder( n, order, target )
    elseif t_type == "AoE" then
            call IssuePointOrder( n, order, GetUnitX( target ), GetUnitY( target ) )
        endif
        //call UnitShareVision( target, Player( pid ), false )
        set n = null
        //call SetUnitOwner( n, Player( 13 ), false )
    endfunction
    
    function CC_Checker takes nothing returns nothing
        local integer Data = GetUnitData( GetUnit( "Target" ), GetStr( "Type" ) )
        local integer hid = GetHandleID()
        local integer tick = GetInt("tick2")
        if Data > 0 and udg_B and DU2 then
            if (IsUnitPaused(GetUnit( "Target" )) == false and GetUnitAbilityLevel(GetUnit( "Target" ),GetInt( "Buff" ))>0) or ((GetStr( "Type" ) == "combo4" or GetStr( "Type" ) == "combo2" )and GetUnitAbilityLevel(GetUnit( "Target" ),GetInt( "Buff" ))>0) then
                call SetUnitData( GetUnit( "Target" ), GetStr( "Type" ), Data - 1 )
            endif

            if tick < 50 then
                call SaveInteger(htMain, hid, SH_tick2, tick + 1)
            endif
            if tick >= 50 and GetUnitAbilityLevel(GetUnit( "Target" ),GetInt( "Buff" )) <=0 and GetStr( "Type" ) != "combo4" and GetStr( "Type" ) != "combo2" then
                call SetUnitData( GetUnit( "Target" ), GetStr( "Type" ), 0 )
            endif
        else
            call SetUnitData( GetUnit( "Target" ), GetStr( "Type" ), 0 )
            call DestroyEffect( GetEffect( "Effect" ) )
            if GetUnitAbilityLevel(GetUnit( "Target" ),GetInt( "Buff" )) > 0 then
                call UnitRemoveAbility( GetUnit( "Target" ), GetInt( "Buff" ) )
            endif
            if GetStr( "Type" ) == "combo1" then
                call UnitRemoveAbility(GetUnit( "Target" ), 'Ao56')
                call UnitRemoveAbility(GetUnit( "Target" ), 'Bco1')
            endif
            if GetStr( "Type" ) == "combo2" then
                call UnitRemoveAbility(GetUnit( "Target" ), 'A3IG')
                call UnitRemoveAbility(GetUnit( "Target" ), 'Bco2')
            endif
            if GetStr( "Type" ) == "combo3" then
                call UnitRemoveAbility(GetUnit( "Target" ), 'A1VJ')
                call UnitRemoveAbility(GetUnit( "Target" ), 'Bwul')
            endif
            if GetStr( "Type" ) == "combo4" then
                call UnitRemoveAbility(GetUnit( "Target" ), 'A2VJ')
                call UnitRemoveAbility(GetUnit( "Target" ), 'B01L')
            endif
            if GetStr( "Type" ) == "combo5" then
                call UnitRemoveAbility(GetUnit( "Target" ), 'AoSV')
                call UnitRemoveAbility(GetUnit( "Target" ), 'RiSV')
            endif
            if GetStr( "Type" ) == "combo6" then
                call UnitRemoveAbility(GetUnit( "Target" ), 'A1SV')
                call UnitRemoveAbility(GetUnit( "Target" ), 'GDSV')
            endif
            if GetUnitAbilityLevel(GetUnit( "Target" ), GetInt( "Buff" )) == 0 then
                call RemoveSavedHandle(htMain, hid, TargetHash)
                call RemoveSavedHandle(htMain, hid, EffectHash)
                call CleanMUI( GetExpiredTimer( ) )
            endif
        endif
    endfunction
    
    function CalculateControlResist takes unit target, real newTime returns real
        local real time=newTime 
        if GetUnitAbilityLevel(target,'A1GA')>0 then //Quincy set
            set time=time*1.5
        endif
        if GetUnitAbilityLevel(target,'IOb5')>0 then //sode/hakka
            set time=time*1.25
        endif
        if GetUnitAbilityLevel(target,'A2b5')>0 then //Gajeel
            set time=time*1.15
        endif   
        if GetUnitAbilityLevel(target,'A2b6')>0 then //Gajeel
            set time=time*1.20
        endif            
        if UnitHasItemOfTypeBJCustom(target,'I13S') or UnitHasItemOfTypeBJCustom(target,'I13R') then //boros
            if GetUnitAbilityLevel(target,'A0VV')>0 then
                set time=time*0.25
            else
                set time=time*0.75
            endif
        endif
        
        if GetUnitAbilityLevel(target, 'A162')>0 then                           // Hibari W 
            set time=time-time*(0.1+0.01*udg_kill[GetPlayerId(GetOwningPlayer(target))])
        endif
        
        if GetUnitTypeId(target)=='HMaG' then   // Madoka Goddess
            set time=time*0.2
        endif
        
        if GetUnitAbilityLevel(target,'A1C4')>0 then    // Nanaya F
            set time=time*0.5
        endif

        if GetUnitAbilityLevel(target,'A26T')>0 then	// Trunks SSR
			set time=time*0.8
		endif
		if GetUnitAbilityLevel(target,'A0U8')>1 then	// Gon R
			set time=time*0.6
		endif
		if GetUnitAbilityLevel(target,'JNF2')>0 then	// Jiren F
			set time=time*0.7
		endif
		if GetUnitAbilityLevel(target,'A5WT')>0 then	// Kurapika W INT
			set time=time*0.75
		endif
        if GetUnitAbilityLevel(target,'AtE1')>0 then	// Atalanta E
			set time=time*(0.95-0.05*GetUnitAbilityLevel(target,'AtE1'))
		endif
        if GetUnitAbilityLevel(target,'InE1')>0 then	// Inori E
			set time=time*0.65
		endif
		if UnitHasItemOfTypeBJ(target,'I036') or GetUnitAbilityLevel(target,'KIH8')>0 then //madao set
			set time=time*0.9
		endif
		
		if UnitHasItemOfTypeBJ(target,'I12R') or GetUnitAbilityLevel(target,'KIK4')>0 then //ribbon
			set time=time*0.8
		endif

		if UnitHasItemOfTypeBJ(target,'IBSI') or GetUnitAbilityLevel(target,'KI0Y')>0 then //Buster Sword
			set time=time*0.8
		endif

		if time<0.015 then
			set time=0.015
		endif
		
		return time
	endfunction

    function CalculateCritChange takes unit newCaster returns real
        local real critchange_dmg = 0.0
        // Усиление урона от автоатаки крит шансом
        if UnitHasItemOfTypeBJ(newCaster, 'I01J') then      // Меч C ранга
            set critchange_dmg = critchange_dmg + 0.15
        endif
        if UnitHasItemOfTypeBJ(newCaster, 'I01I') then      // Меч B ранга
            set critchange_dmg = critchange_dmg + 0.15
        endif
        if UnitHasItemOfTypeBJ(newCaster, 'I01K') then      // Меч A ранга
            set critchange_dmg = critchange_dmg + 0.15
        endif
        if UnitHasItemOfTypeBJ(newCaster, 'I01L') then      // Закаленный меч
            set critchange_dmg = critchange_dmg + 0.15
        endif
        if UnitHasItemOfTypeBJ(newCaster, 'I01O') then	    // Сандай Китецу
            set critchange_dmg = critchange_dmg + 0.20
        endif
        if UnitHasItemOfTypeBJ(newCaster, 'I01Q') then	    // Сюсуй
            set critchange_dmg = critchange_dmg + 0.20
        endif
        if UnitHasItemOfTypeBJ(newCaster, 'I01U') then	    // Фэнг
            set critchange_dmg = critchange_dmg + 0.20
        endif
        if UnitHasItemOfTypeBJ(newCaster, 'I01S') then	    // Темный Экскалибур
            set critchange_dmg = critchange_dmg + 0.30
        endif
        if UnitHasItemOfTypeBJ(newCaster, 'I02V') then      // Ямато
            set critchange_dmg = critchange_dmg + 0.15
        endif
        if UnitHasItemOfTypeBJ(newCaster, 'IBSI') then      // Бастер
            set critchange_dmg = critchange_dmg + 0.15
        endif
        if GetUnitAbilityLevel(newCaster,'WAE1')>0 then      // Waver F
            set critchange_dmg = critchange_dmg + 0.3
        endif
        return critchange_dmg
    endfunction

    function CC_UnitEx takes unit user, unit target, real percent, real time, string c_type, boolean flag, string vfx, string bone, real slowMS, real slowAS returns nothing
        local integer BuffId  = 0
        local integer pid   = GetPlayerId( GetOwningPlayer( target ) )
        local integer hid   = 0
        local integer data  = 0
        local integer value = 0
        local real speed        = 0.
        local string order
        local string baseModel = ""
        //local string c_type = type
        local real remainTime = .0
        local string t_type = "Target"
        local boolean checker = false
        local boolean checker2 = false
        local boolean hasBuff = false
        local buff buf = null
        
        if StringCase( c_type, false ) == "silencete" then
            set checker = true
            set c_type = "silence"
        elseif StringCase( c_type, false ) == "stunbkb" then
            set checker = true
            set c_type = "stun"
        elseif StringCase( c_type, false ) == "stundebug" then
            set checker = true
            set checker2 = true
            set c_type = "stun"
        elseif StringCase( c_type, false ) == "doomdebug" then
            set checker = true
            set checker2 = true
            set c_type = "doom"
        elseif StringCase( c_type, false ) == "silencedebug" then
            set checker = true
            set checker2 = true
            set c_type = "silence"
        elseif StringCase( c_type, false ) == "rootbkb" then
            set checker = true
            set c_type = "root"
        elseif StringCase( c_type, false ) == "ensnare" then
            set checker = true
            set c_type = "ensnare"
        endif
        set c_type = StringCase( c_type, false )
        if flag then // set time = time / CCMitigation | IsRecuded
        endif
    
        if c_type == "heavystun" then
            set order = "thunderbolt"
            set checker = true
            set checker2 = true
            set BuffId = 'cbc8'
        endif

        if c_type == "cyclone" then
            set checker = true
            set order = "cyclone"
            set BuffId = 'cbc9'
        endif
        if c_type == "blind" then
            set checker = true
            set order = "blind"
            set BuffId = 'cb10'
        endif
        if c_type == "shortsight" then
            set checker = true
            set order = "shortsight"
            set BuffId = 'cb11'
        endif
        if c_type == "miss" then
            set checker = true
            set order = "miss"
            set BuffId = 'cb12'
        endif
        if c_type == "stun" then
            set order = "thunderbolt"
            set BuffId = 'CBC2'
        endif

        if c_type == "root" then
            set order = "entanglingroots"
            set BuffId  = 'CBC1'
        endif
    
        if c_type == "ensnare" then
            set order = "ensnare"
            set BuffId  = 'cbc6'
        endif

        if c_type == "silence" then
            set order = "soulburn"
            set BuffId = 'cbc3'
        endif

        //if c_type == "stunbkb" then
        //    set order = "thunderbolt"
        //    set BuffId = 'CBC2'
        //endif

        if c_type == "doom" then
            set order = "doom"
            set checker = true
            set BuffId = 'cbc5'
        endif
        if c_type == "sleep" then
            set order = "sleep"
            set BuffId = 'cbc7'
        endif
        if c_type == "slow" then
            set order = "slow"
            if percent==0 then
                set BuffId = 'Bsl1'
            endif
            if percent==1 then
                set BuffId = 'Bsl2'
            endif
            if percent==2 then
                set BuffId = 'Bsl3'
            endif
            if percent==3 then
                set BuffId = 'Bsl4'
            endif
            if percent==4 then
                set BuffId = 'Bsl5'
            endif
        endif
        if c_type == "weakness" then
            set order = "weakness"
            set BuffId = 'Bwk1'
        endif
        if c_type == "necrosis" then
            set order = "necrosis"
            set BuffId = 'BNC1'
        endif
        if c_type == "frostbite" then
            set order = "frostbite"
            set BuffId = 'BNC2'
        endif
        if c_type == "disarm" then
            set order = "disarm"
            set BuffId = 'BNC3'
        endif

        if c_type == "combo" then
            set checker = true
            if percent==1 then //waver r
            set BuffId = 'Bco1'
            set c_type="combo1"
            set order = "combo"
            call UnitAddAbility(target, 'Ao56')
            call UnitMakeAbilityPermanent(target,true ,'Ao56')
            endif
            if percent==2 then
            set BuffId = 'Bco2'
            set c_type="combo2"
            set order = "combo"
            call UnitAddAbility(target, 'A3IG')
            call UnitMakeAbilityPermanent(target,true ,'A3IG')
            endif
            if percent==3 then
            set BuffId = 'Bwul'
            set c_type="combo3"
            set order = "combo"
            call UnitAddAbility(target, 'A1VJ')
            call UnitMakeAbilityPermanent(target,true ,'A1VJ')
            endif
            if percent==4 then
            set BuffId = 'B01L'
            set c_type="combo4"
            set order = "combo"
            call UnitAddAbility(target, 'A2VJ')
            call UnitMakeAbilityPermanent(target,true ,'A2VJ')
            endif
            if percent==5 then
            set BuffId = 'RiSV'
            set c_type="combo5"
            set order = "combo"
            call UnitAddAbility(target, 'AoSV')
            call UnitMakeAbilityPermanent(target,true ,'AoSV')
            endif
            if percent==6 then
            set BuffId = 'GDSV'
            set c_type="combo6"
            set order = "combo"
            call UnitAddAbility(target, 'A1SV')
            call UnitMakeAbilityPermanent(target,true ,'A1SV')
            endif
        endif
        set data = GetUnitData( target, c_type )
        if (c_type=="stun" or c_type == "silence" or c_type == "doom" or c_type == "root" or c_type == "ensnare" or c_type == "slow" or c_type == "sleep" or c_type == "blind" or c_type == "shortsight" or c_type == "weakness" or c_type == "miss" or c_type == "disarm" or ( c_type == "combo4" and percent==4)) and checker2==false then
            
            set time=CalculateControlResist(target, time)
            if checker==true and (c_type == "silence" or c_type == "doom") and time<0.25 then
                set time=0.25
            endif
            if (UnitHasItemOfTypeBJCustom(target,'I13S') or UnitHasItemOfTypeBJCustom(target,'I13R')) and (c_type == "weakness" or c_type == "miss") then //boros
                set percent=percent*0.65
            endif
            if GetUnitAbilityLevel(target,'A13I')>0 and (c_type == "weakness" or c_type == "miss") then //boros
                set percent=percent*0.5
            endif
            if (UnitHasItemOfTypeBJCustom(target,'I13S') or UnitHasItemOfTypeBJCustom(target,'I13R')) and c_type == "slow" then //boros
                set slowMS=slowMS*0.65
                set slowAS=slowAS*0.65
            endif
            if GetUnitAbilityLevel(target,'A13I')>0 and c_type == "slow" then //boros
                set slowMS=slowMS*0.5
                set slowAS=slowAS*0.5
            endif
            if ((c_type=="shortsight" or c_type=="blind") and GetUnitAbilityLevel(target,'Blnd')>0) or (c_type=="shortsight" and GetUnitTypeId(target)=='H116') then
                set time=0
            endif
        endif
        if order!="combo" then
            // frostbite (Эссенция льда) накладывается и на неуязвимых; защита A151 и блок dmb+ по-прежнему действуют
            if time>0 and ((order != ""  and (IsUnitInvulnerable(target) == false or c_type == "frostbite") and LoadBoolean(HH,GetHandleId(target),'dmb+')==false  and GetUnitAbilityLevel(target,'A151') != 1) or (order != "" and checker == true and c_type != "silence") or (order != "" and checker == true and c_type == "silence" and GetUnitAbilityLevel(target,'A151') != 1)) then
                if BuffId=='Bsl3' then
                    set buf = CreateBuff( BuffId )
                    set baseModel = GetBuffBaseStringFieldById( BuffId, ABILITY_SLF_TARGET )
                    if vfx!="" then
                        call SetBuffBaseStringFieldById(BuffId,ABILITY_SLF_TARGET,vfx)
                    endif
                    call SetBuffRealField(buf,ABILITY_RLF_MOVEMENT_SPEED_FACTOR_SLO1,slowMS)
                    call SetBuffRealField(buf,ABILITY_RLF_ATTACK_SPEED_FACTOR_SLO2,slowAS)
                    call SetBuffOwner( buf, target )
                    call SetBuffBaseStringFieldById( BuffId, ABILITY_SLF_TARGET, baseModel )
                    call SetBuffRemainingDuration( buf, time )
                elseif BuffId=='Bwk1' then
                    set buf = CreateBuff( BuffId )
                    set baseModel = GetBuffBaseStringFieldById( BuffId, ABILITY_SLF_TARGET )
                    if vfx!="" then
                        call SetBuffBaseStringFieldById(BuffId,ABILITY_SLF_TARGET,vfx)
                    endif
                    call SetBuffRealField(buf,ABILITY_RLF_MOVEMENT_SPEED_FACTOR_SLO1,0)
                    call SetBuffRealField(buf,ABILITY_RLF_ATTACK_SPEED_FACTOR_SLO2,0)
                    call SetBuffOwner( buf, target )
                    call SetBuffBaseStringFieldById( BuffId, ABILITY_SLF_TARGET, baseModel )
                    call SetBuffRemainingDuration( buf, time )
                    call SaveReal(HH,GetHandleId(buf),MinusDmgHash,percent)
                elseif BuffId=='cb12' then
                    set buf = CreateBuff( BuffId )
                    set baseModel = GetBuffBaseStringFieldById( BuffId, ABILITY_SLF_TARGET )
                    if vfx!="" then
                        call SetBuffBaseStringFieldById(BuffId,ABILITY_SLF_TARGET,vfx)
                    endif
                    call SetBuffIntegerField(buf,ABILITY_ILF_ATTACKS_PREVENTED,0)
                    call SetBuffRealField(buf,ABILITY_RLF_CHANCE_TO_MISS_PERCENT,percent)
                    call SetBuffOwner( buf, target )
                    call SetBuffBaseStringFieldById( BuffId, ABILITY_SLF_TARGET, baseModel )
                    call SetBuffRemainingDuration( buf, time )
                    call SaveReal(HH,GetHandleId(buf),MissBuffHash,percent)
                else
                    set hasBuff = GetUnitAbilityLevel( target, BuffId ) > 0
                    if not hasBuff then
                        set buf = CreateBuff( BuffId )
                        set baseModel = GetBuffBaseStringFieldById( BuffId, ABILITY_SLF_TARGET )
                        if vfx!="" then
                            call SetBuffBaseStringFieldById(BuffId,ABILITY_SLF_TARGET,vfx)
                        endif
        
                        //call BJDebugMsg(Id2String(BuffId))
                        //call BJDebugMsg(Id2String(BuffId))
                        if BuffId=='cbc3' then
                            call SetBuffRealField(buf,ABILITY_RLF_MOVEMENT_SPEED_REDUCTION_PERCENT_NSO4,0)
                            call SetBuffRealField(buf,ABILITY_RLF_ATTACK_SPEED_REDUCTION_PERCENT_NSO5,0)
                            call SetBuffRealField(buf,ABILITY_RLF_DAMAGE_AMOUNT_NSO1,0)
                            call SetBuffRealField(buf,ABILITY_RLF_DAMAGE_PENALTY,0)
                        endif
                        if BuffId=='BNC1' then
                            call SetBuffRealField(buf,ABILITY_RLF_MOVEMENT_SPEED_FACTOR_SLO1,0)
                            call SetBuffRealField(buf,ABILITY_RLF_ATTACK_SPEED_FACTOR_SLO2,0)
                            call SetBuffDispellable(buf,false)
                        endif
                        if BuffId=='BNC2' then
                            call SetBuffRealField(buf,ABILITY_RLF_MOVEMENT_SPEED_FACTOR_SLO1,0)
                            call SetBuffRealField(buf,ABILITY_RLF_ATTACK_SPEED_FACTOR_SLO2,0)
                            call SetBuffDispellable(buf,false)
                        endif
                        if BuffId=='cbc5' then
                            call SetBuffRealField(buf,ABILITY_RLF_DAMAGE_PER_SECOND_NDO1,0)
                            call SetBuffIntegerField(buf,ABILITY_ILF_NUMBER_OF_SUMMONED_UNITS_NDO2,0)
                            call SetBuffIntegerField(buf,ABILITY_ILF_SUMMONED_UNIT_TYPE_NDOU,0)
                        endif
                        if BuffId=='cbc6' then
                            call SetBuffRealField(buf,ABILITY_RLF_AIR_UNIT_HEIGHT,0)
                            call SetBuffRealField(buf,ABILITY_RLF_AIR_UNIT_LOWER_DURATION,0)
                        endif
                        if BuffId=='cb10' then
                            call SetBuffIntegerField(buf,ABILITY_ILF_ATTACKS_PREVENTED,0)
                            call SetBuffRealField(buf,ABILITY_RLF_CHANCE_TO_MISS_PERCENT,0.999)
                        endif
                        if BuffId=='cb11' then
                            call SetBuffIntegerField(buf,ABILITY_ILF_ATTACKS_PREVENTED,0)
                            call SetBuffRealField(buf,ABILITY_RLF_CHANCE_TO_MISS_PERCENT,0.0)
                        endif
                        if BuffId=='CBC1' then
                            call SetBuffRealField(buf,ABILITY_RLF_DAMAGE_PER_SECOND_EER1,0)
                        endif
                        if BuffId=='BNC3' then
                            call SetBuffRealField(buf,ABILITY_RLF_AREA_OF_EFFECT,0)
                            call SetBuffIntegerField(buf,ABILITY_ILF_ATTACKS_PREVENTED,3)
                            call SetBuffRealField(buf,ABILITY_RLF_CHANCE_TO_MISS_PERCENT,0)
                        endif
                        if c_type == "slow" then
                            call SetBuffRealField(buf,ABILITY_RLF_MOVEMENT_SPEED_FACTOR_SLO1,slowMS)
                            call SetBuffRealField(buf,ABILITY_RLF_ATTACK_SPEED_FACTOR_SLO2,slowAS)
                        endif
                        call SetBuffOwner( buf, target )
                        call SetBuffBaseStringFieldById( BuffId, ABILITY_SLF_TARGET, baseModel )
                        if BuffId=='cbc8' then
                            call SetBuffDispellable(buf, false)
                        endif
                    endif
                    set buf = GetUnitBuff( target, BuffId )
                    set remainTime = GetBuffRemainingDuration( buf )
                    if not hasBuff then
                        call SetBuffRemainingDuration( buf, time )
                    else
                        if c_type == "slow" then
                            if GetBuffRealField(buf,ABILITY_RLF_MOVEMENT_SPEED_FACTOR_SLO1)<slowMS then
                                call SetBuffRealField(buf,ABILITY_RLF_MOVEMENT_SPEED_FACTOR_SLO1,slowMS)
                            endif
                            if GetBuffRealField(buf,ABILITY_RLF_ATTACK_SPEED_FACTOR_SLO2)<slowAS then
                                call SetBuffRealField(buf,ABILITY_RLF_ATTACK_SPEED_FACTOR_SLO2,slowAS)
                            endif
                        endif
                        if remainTime >= time and remainTime<100 then
                            set time = remainTime
                        endif
                        call SetBuffRemainingDuration( buf, time )
                    endif
                endif
            endif
        else
            if (order != ""  and IsUnitInvulnerable(target) == false and GetUnitAbilityLevel(target,'B05G') != 1) or (order != "" and checker == true) or c_type=="combo4" then//and IsUnitInvulnerable(target) == false and order != "")  or (checker == true and IsUnitInvulnerable(target) == false and order != "") then

                set value = R2I( time * 100 )
                if data == 0 then
                    set hid = SetMUITimerEx( htMain, pid ) //htCC
                    if (order != "slow" and order != "combo") or checker2==true then
                        call CC_Cast( user, target, order, t_type )
                    endif
                    call SaveStr( htMain, hid, SH_Type, c_type )
                    call SaveInteger( htMain, hid, SH_Buff, BuffId )
                    call SaveInteger( htMain, hid, SH_tick2, 0 )
                    call SaveReal(htMain, hid,SH_percent,percent)
                    call SaveUnitHandle( htMain, hid, TargetHash, target )
                    call SetUnitData( target, c_type, value )
                    call SaveEffectHandle( htMain, hid, EffectHash, AddSpecialEffectTarget( vfx, target, bone ) )
                    call TimerStart( LoadMUITimerEx( htMain, pid ), .01, true, function CC_Checker )
                endif
                if value >= GetUnitData( target, c_type ) then
                    call SetUnitData( target, c_type, value )
                endif
            endif
        endif
        set buf=null
    endfunction
    
