call UnitApplyTimedLife(CreateUnit(p,'e0AG',x1,y1,0),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0AH',x1,y1,GetRandomReal(0,359)),1,1)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
endif
set u=null
set t=null
set p=null
