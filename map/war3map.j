function PowerDownTrunks takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
    if GetUnitAbilityLevel(u,'A16S')>0 then
        call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.0003)
    endif
    if GetUnitAbilityLevel(u,'A16T')>0 then
        call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.0006)
    endif
    if GetUnitAbilityLevel(u,'A26T')>0 then
        call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.0009)
    endif
else
    if GetUnitState(u,UNIT_STATE_MAX_MANA)*0.05>GetUnitState(u,UNIT_STATE_MANA) then
        if GetUnitAbilityLevel(u,'A16S')>0 then
            call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.00015)
        endif
        if GetUnitAbilityLevel(u,'A16T')>0 then
            call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.0003)
        endif
        if GetUnitAbilityLevel(u,'A26T')>0 then
            call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.00045)
        endif
    endif
endif
if GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.1>GetUnitState(u,UNIT_STATE_LIFE) or GetUnitState(u,UNIT_STATE_MAX_MANA)*0.04>GetUnitState(u,UNIT_STATE_MANA) or LoadBoolean(HH,GetHandleId(u),SST)==true then
if GetUnitAbilityLevel(u,'A26T')>0 then
call ShowAbility2Timed('TRBB',false,4.95)
call ShowAbility2Timed('A16U',true,4.97)
endif
call SaveBoolean(HH,GetHandleId(u),SS,false)
call SaveBoolean(HH,GetHandleId(u),SST,false)
call UnitRemoveAbility(u,'A16S')
call UnitRemoveAbility(u,'A16T')
call UnitRemoveAbility(u,'A26T')
call UnitAddAbility(u,'A16R')
call SetUnitAbilityLevel(u,'A16V',1)
call UnitMakeAbilityPermanent(u,true,'A16R')
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set t=null
set u=null
endfunction
function PowerUpTrunksCond takes nothing returns boolean
return (GetSpellAbilityId()=='TRBS' or GetSpellAbilityId()=='TRSS' or GetSpellAbilityId()=='TRSR' or GetSpellAbilityId()=='TRBB' or GetSpellAbilityId()=='TRS2') and udg_B==true
endfunction
function PowerUpTrunksCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local timer tt=CreateTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local player p=GetOwningPlayer(u)
    local real time=LoadReal(h,id,1)
    if time<0.1 then
        call PauseUnit(u,true)
        call SaveReal(h,id,1,time+0.025)
    else
        call PauseUnit(u,false)
        call SetUnitTimeScale(u,1)
        call SetUnitAbilityLevel(u,'A16V',LoadInteger(h,id,3)+1)
        if LoadInteger(h,id,3)==1 and GetUnitAbilityLevel(u,'A16S')==0 then //ss
            set EFF=AddSpecialEffect("Yellow--zhendi.mdl", x, y)
            call DestroyEffect(EFF)
            call UnitRemoveAbility(u,'A16R')
            call UnitRemoveAbility(u,'A16S')
            call UnitRemoveAbility(u,'A16T')
            call UnitRemoveAbility(u,'A26T')
            call UnitAddAbility(u,'A16S')
            call UnitMakeAbilityPermanent(u,true,'A16S')
            call StartSound(soundStr[90])
        elseif LoadInteger(h,id,3)==2 and GetUnitAbilityLevel(u,'A16T')==0 then //ss2
            call UnitRemoveAbility(u,'A16R')
            call UnitRemoveAbility(u,'A16S')
            call UnitRemoveAbility(u,'A16T')
            call UnitRemoveAbility(u,'A26T')
            call UnitAddAbility(u,'A16T')
            set EFF=AddSpecialEffect("Yellow--zhendi.mdl", x, y)
            call DestroyEffect(EFF)
            call UnitMakeAbilityPermanent(u,true,'A16T')
            call StartSound(soundStr[90])
        elseif LoadInteger(h,id,3)==3 then //ss2R
            call UnitRemoveAbility(u,'A16R')
            call UnitRemoveAbility(u,'A16S')
            call UnitRemoveAbility(u,'A16T')
            call UnitRemoveAbility(u,'A26T')
            call UnitAddAbility(u,'A26T')
            call ShowAbility2('A16U',false)
            call ShowAbility2('TRBB',true)
            set EFF=AddSpecialEffect("Yellow--zhendi.mdl", x, y)
            call DestroyEffect(EFF)
            call UnitMakeAbilityPermanent(u,true,'A26T')
            call StartSound(soundStr[90])
        endif
        if LoadInteger(h,id,3)==0 and GetUnitAbilityLevel(u,'A16R')==0 then
            call StartSound(soundStr[89])
        endif
        if LoadBoolean(HH,GetHandleId(u),SS)==false then
            call SaveUnitHandle(h,GetHandleId(tt),0,u)
            call SaveBoolean(HH,GetHandleId(u),SS,true)
            call TimerStart(tt,0.1,true,function PowerDownTrunks)
        endif
        if LoadInteger(h,id,3)==0 then
            call SaveBoolean(HH,GetHandleId(u),SST,true)
        endif
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
    endif
    set p=null
    set tt=null
    set u=null
    set t=null
endfunction
function PowerUpTrunksCast takes nothing returns nothing
    local unit u=GetTriggerUnit()
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local player p=GetOwningPlayer(u)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    call SaveUnitHandle(h,id,0,u)
    if (GetSpellAbilityId()=='TRSS' and GetUnitAbilityLevel(u,'A16S')==0) or (GetSpellAbilityId()=='TRS2' and GetUnitAbilityLevel(u,'A16T')==0) or GetSpellAbilityId()=='TRSR' then
        call SaveReal(h,id,1,0.075)
        call ShowAbility2('A16U',false)
        call ShowAbility2Timed('A16U',true,0.025)
        //call UnitApplyTimedLife(CreateUnit(p,'e0LK',x,y,0),'BTLF',0.3)
        call UnitApplyTimedLife(CreateUnit(p,'e0LM',x,y,0),'BTLF',0.35)
    elseif GetSpellAbilityId()=='TRBS' or GetSpellAbilityId()=='TRBB' then
        call SaveReal(h,id,1,0.075)
        call SaveInteger(h,id,3,0)
    else
        call ShowAbility2('A16U',false)
        call ShowAbility2Timed('A16U',true,0.02)
        call SaveReal(h,id,1,0.1)
    endif
    if GetSpellAbilityId()=='TRSS' then
            // set soundplay=CreateSound("Sound\\Music\\mp3Music\\trunks ss1.mp3",false,false,true,12700,12700,"")
        call SaveInteger(h,id,3,1)
    elseif GetSpellAbilityId()=='TRS2' then
            // set soundplay=CreateSound("Sound\\Music\\mp3Music\\trunks ss2.mp3",false,false,true,12700,12700,"")
        call SaveInteger(h,id,3,2)
    elseif GetSpellAbilityId()=='TRSR' then
            // set soundplay=CreateSound("Sound\\Music\\mp3Music\\trunks ss2.mp3",false,false,true,12700,12700,"")
        call SaveInteger(h,id,3,3)
    endif
    call SetUnitTimeScale(u,0.5)
    call TimerStart(t,0.025,true,function PowerUpTrunksCast2)
    set u=null
    set p=null
    set t=null
endfunction
function HeatDomeAttackCond takes nothing returns boolean
return GetSpellAbilityId()==0x41305243
endfunction
function HeatDomeAttackCast4 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit c=LoadUnitHandle(h,id,1)
    local unit l__d=LoadUnitHandle(h,id,7)
    local real a=LoadReal(h,id,11)
    local real dist=LoadReal(h,id,2)
    local real x=GetUnitX(l__d)
    local real y=GetUnitY(l__d)
    local real x1=GetUnitX(u)
    local real y1=GetUnitY(u)
    local real dmg=LoadReal(h,id,4)
    local player p=GetOwningPlayer(u)
    local real s1=LoadReal(h,id,10)
    local real fl=LoadReal(h,id,20)
    local real time=LoadReal(h,id,15)
    if fl<2000 and UnitIsAlive(l__d)then
    call PauseUnit(c,true)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
    call CameraSetTargetNoiseEx(3*4.,3*Pow(10,2),true)
    call CameraSetSourceNoiseEx(3*4.,3*Pow(10,2),true)
    call UnitApplyTimedLife(CreateUnit(p,'e0QI',x,y,GetRandomReal(0,359)),'BTLF',0.01)
    call UnitApplyTimedLife(CreateUnit(p,'e0QG',x,y,GetRandomReal(0,359)),'BTLF',0.01)
    call UnitApplyTimedLife(CreateUnit(p,'e0QK',x,y,GetRandomReal(0,359)),'BTLF',0.5)
    set n=CreateUnit(p, 'd054', x+GetRandomReal(-200, 200), y+GetRandomReal(-200, 200), GetRandomInt(0, 360))
    call SetUnitScale(n, 0.7, 0.7, 0.7)
    call SetUnitFlyHeight(n, 5, 0)
    call MyRemoveUnit(n, 0.4)
    call SetUnitX(l__d,x)
    call SetUnitY(l__d,y)
    set n=CreateUnit(p,0x65305942,x,y,a*bj_RADTODEG)
    call UnitApplyTimedLife(n,'BTLF',0.5-fl*0.0002)
    call SetUnitTimeScale(n,2)
    call SetUnitScale(n,1.5+s1,1.5+s1,1.5+s1)
    call SetUnitFlyHeight(n,fl,0)
    set n=CreateUnit(p,'e3PT',x,y,a*bj_RADTODEG)
    call UnitApplyTimedLife(n,'BTLF',0.5-fl*0.00025)
    call SetUnitTimeScale(n,1)
    call SetUnitScale(n,4.5+s1,4.5+s1,4.5+s1)
    call SetUnitFlyHeight(n,fl,0)
    call SetUnitFlyHeight(c,fl*0.8,0)
    call SetUnitXY_1(c,x,y, false)
    call SaveReal(h,id,2,dist-10)
    call SaveReal(h,id,20,fl+100)
    call SaveReal(h,id,10,s1+0.1)
    else
    call SetUnitInvulnerable(c,false)
    call PauseUnit(c,false)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
    call PauseUnit(u,false)
    call SetUnitInvulnerable(u,false)
    call myCustomDamage(u,c,dmg,false,false,null,null,null)
    call CameraSetTargetNoiseEx(0,0,true)
    call CameraSetSourceNoiseEx(0,0,true)
    call SetControlToUnit(u,c,1,"stun")
    call SetUnitFlyHeight(c,0,2400)
    call Push(c,50,a,600)
    call SetUnitTimeScale(u,1)
    call UnitApplyTimedLife(l__d,'BTLF',0.01)
    call RemoveUnit(l__d)
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(h,id)
    endif
    set u=null
    set t=null
    set l__d=null
    set p=null
    set c=null
endfunction
function HeatDomeAttackCast3 takes nothing returns nothing
    local timer t=GetExpiredTimer()
