call GogetaRMissles(n,GetRandomReal(12,16)+sr2*0.017,a,x2,y2,u,1)
set x2=x1+GetRandomReal(-100,100)*Cos(GetRandomReal(0,6.28))
set y2=y1+GetRandomReal(-100,100)*Sin(GetRandomReal(0,6.28))
set sr2=SR(x2,y2,x,y)
