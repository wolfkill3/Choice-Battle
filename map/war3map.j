call MoveUnit(caster,Heart3,100,0)
if IsUnitHidden(caster)==false then
call SetUnitFlyHeight(Heart1,GetUnitFlyHeight(caster)+400,0)
call SetUnitFlyHeight(Heart2,GetUnitFlyHeight(caster)+400,0)
