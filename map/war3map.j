function Trig_Yarazu_no_Ame_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local unit c=LoadUnitHandle(h,id,2)
local group g=LoadGroupHandle(h,id,3)
local real a
local unit l__dm
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real f=GetUnitFacing(u)
local player p=GetOwningPlayer(u)
local integer l__ide
local integer l__idg=GetHandleId(g)
local real dmg=LoadReal(h,id,13)
if SR(x,y,x1,y1)>46.00 then
set a=Atan2(y1-y,x1-x)
call SetUnitX(l__d,x+37*Cos(a))
call SetUnitY(l__d,y+37*Sin(a))
call SetUnitFacing(l__d,a*bj_RADTODEG)
call UnitApplyTimedLife(CreateUnit(p,'e038',x,y,a*bj_RADTODEG),'BTLF',1)
call GroupEnumUnitsInRange(g,x,y,200,Base)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set l__ide=GetHandleId(E)
if Condition_Base(p,E) and E!=LoadUnitHandle(h,l__idg,l__ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,l__idg,l__ide,E)
call SetControlToUnit(E,E, 2, "stun")
endif
call GroupRemoveUnit(g,E)
endloop
else
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
call DestroyGroup(g)
endif
set g=null
set p=null
set l__dm=null
set u=null
set l__d=null
set t=null
set c=null
endfunction
