call UnitApplyTimedLife(CreateUnit(p,'e0CS',x1+GetRandomReal(-300,300),y1+GetRandomReal(-300,300),GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0CS',x1+GetRandomReal(-300,300),y1+GetRandomReal(-300,300),GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0CS',x1+GetRandomReal(-300,300),y1+GetRandomReal(-300,300),GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0CS',x1+GetRandomReal(-300,300),y1+GetRandomReal(-300,300),GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0CS',x1+GetRandomReal(-300,300),y1+GetRandomReal(-300,300),GetRandomReal(0,359)),'BTLF',3)
