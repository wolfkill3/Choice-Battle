function SabracChoice_Act takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit caster=GetTriggerUnit()
local unit target=GetSpellTargetUnit()
local real x0=GetUnitX(caster)
local real y0=GetUnitY(caster)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local unit casterOriginal=sabrac
local real facing=Angle2(x0,y0,x1,y1)
call SaveUnitHandle(HH,id,1,caster)
call SaveReal(HH,id,11,x1)
call SaveReal(HH,id,12,y1)
call SaveReal(HH,id,3,facing)
call SaveUnitHandle(HH,id,30,casterOriginal)


if GetUnitTypeId(GetTriggerUnit())=='HSab' then

set sabrac=Hero[GetPlayerId(GetOwningPlayer(caster))]
set casterOriginal=sabrac
endif

//Q
if GetSpellAbilityId()=='SaQ1' then

if caster==casterOriginal then
call SaveBoolean(HH,GetHandleId(caster),StringHash("SabracTBool"),false)
else


call StartAbilityCooldown(GetUnitAbility(casterOriginal,'SaQ1'), 10)


endif

call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)-0.1*GetUnitState(caster,UNIT_STATE_LIFE))
//call HealText(0.1*GetUnitState(caster,UNIT_STATE_LIFE),caster)
if GetUnitLevel(caster)>=35 then
call UnitRemoveBuffs(caster,false,true)
endif
set target=LoadUnitHandle(HH,GetHandleId(casterOriginal),StringHash("SabracZoneU"))
if target!=null and SR(x0,y0,GetUnitX(target),GetUnitY(target))<1500 then
call SaveBoolean(HH,id,31,true)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\SabracQF.mp3",false,false,true,12700,12700,"")
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\SabracQ.mp3",false,false,true,12700,12700,"")
endif
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call SetUnitAnimationByIndex(caster,5)
call SaveReal(HH,id,15,(2.5+0.5*GetUnitAbilityLevel(casterOriginal,'SaQ1'))*GetHeroStr(casterOriginal,true))


call EffectCreateAndMove(true,"Sabrac\\HakkeStart2.mdl",facing,1,0.5,1,100,100,100,60,0,caster,0,facing)


call TimerStart(t,0.02,true,function SabracQAct)
endif

//W
if GetSpellAbilityId()=='SaW1' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\SabracW.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.02,false,function SabracGnull)
if caster!=casterOriginal then
call SabracWActForClone(casterOriginal,caster)
call SabracWActForClone(casterOriginal,casterOriginal)

//if(GetLocalPlayer()==GetOwningPlayer(casterOriginal))then
//call DisplayTextToPlayer(GetLocalPlayer(),0,0,"Clone")
//endif

endif

if caster==casterOriginal then
//if(GetLocalPlayer()==GetOwningPlayer(casterOriginal))then
//call DisplayTextToPlayer(GetLocalPlayer(),0,0,"Original")
//endif
call SaveBoolean(HH,GetHandleId(caster),StringHash("SabracTBool"),false)
call SabracWActForClone(casterOriginal,casterOriginal)
endif

endif

if GetSpellAbilityId()=='SaW2' then
call EffectCreateAndMove(true,"Sabrac\\DustWindFaster3.mdl",facing,1,0.75,1,100,100,100,0,50,caster,0,facing)
call EffectCreateAndMove90(true,"Sabrac\\wind4.mdl",facing+180,1,0.5,1,100,100,100,0,100,caster,0,facing)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',x0,x0,facing)
call SetUnitModel(n0,"Sabrac\\Black-Red-dash.mdl")
call UnitSize(n0,1.5,1,1)
call UnitSpeed(n0,1)
call UnitColor(n0,100,100,100,0)
call SetUnitFlyHeight(n0,0,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=null
