function ELiCast5 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real dmg=GetHeroAgi(u,true)*(3+GetUnitAbilityLevel(u,'A1CV'))
local real x=LoadReal(h,id,6)
local real y=LoadReal(h,id,7)
local real a=LoadReal(h,id,3)
local real sc=0
local group g=LoadGroupHandle(h,id,5)
local player p=GetOwningPlayer(u)
call PauseTimer(t)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call ShakeCamera(0.25,15)
loop
set E=FirstOfGroup(g)
exitwhen E==null
if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Tidal.mdx",E,"head"))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",E,"head"))
call SetUnitAnimation(E,"death")
endif
call PauseUnit(E,false)
call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,false)
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call GroupRemoveUnit(g,E)
endloop
set x=x+800*Cos(a)
set y=y+800*Sin(a)
set n=CreateUnit(p,'e122',x,y,0)
call SetUnitScale(n,5.5,5.5,5.5)
call SetUnitVertexColor(n,255,25,25,255)
call SetUnitFlyHeight(n,75,0)
call UnitApplyTimedLife(n,'BTLF',0.7)
call SetUnitTimeScale(n,2.5)
call SetUnitTimeScale(u,1)
call DestroyGroup(g)
call DestroyTimer(t)
call PauseUnit(u,false)
call FlushChildHashtable(h,id)
set u=null
set g=null
set p=null
set t=null
endfunction
function ELiCast4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local integer idu=GetHandleId(u)
local real dmg=GetHeroAgi(u,true)*10
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=0
local real y1=0
local real a=LoadReal(h,id,3)+65*bj_DEGTORAD+bj_PI
local real dist=LoadReal(h,id,2)
local real fe=LoadReal(h,id,4)
local group g=LoadGroupHandle(h,id,5)
local real sc=0
local player p=GetOwningPlayer(u)
if dist<1000 then
set x=x+100*Cos(a)
set y=y+100*Sin(a)
call SetUnitXY_1(u,x,y, false)
call SaveReal(h,id,2,dist+100)
call SaveReal(h,id,4,fe+0.2)
call SetUnitFacing(u,a*bj_RADTODEG)
set n=CreateUnit(p,'e125',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,105)
call SetUnitFacing(n,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.15)
call GroupEnumUnitsInRange(G,x,y,350,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)and IsUnitInGroup(E,g)==false and IsUnitPaused(E)==false then
set x1=GetUnitX(E)
set y1=GetUnitY(E)
set sc=GetUnitFacing(E)*bj_DEGTORAD
set n=CreateUnit(p,'e125',x1-100*Cos(sc),y1-100*Sin(sc),sc*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,105)
call UnitApplyTimedLife(n,'BTLF',0.5)
call SetUnitTimeScale(n,1.8)
call SetUnitAnimation(n,"Attack")
call GroupAddUnit(g,E)
call PauseUnit(E,true)
call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,true)
endif
call GroupRemoveUnit(G,E)
endloop
else
call UnitRemoveAbility(u,'A1CR')
call SetUnitFacing(u,LoadReal(h,id,3)*bj_RADTODEG+180)
call ShowUnit(u,false)
call SetUnitXY_1(u,LoadReal(h,id,6),LoadReal(h,id,7), false)
call ShowUnit(u,true)
if GetLocalPlayer()==p then
call ClearSelection()
call SelectUnit(u,true)
endif
call SaveReal(h,id,2,0)
call PauseTimer(t)
call TimerStart(t,0.75,false,function ELiCast5)
endif
set g=null
set u=null
set p=null
set t=null
endfunction
