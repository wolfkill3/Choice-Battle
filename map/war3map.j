return GetSpellAbilityId()=='A2FF'
endfunction
function GogetaRMissles2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real f=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,5)
local real y1=LoadReal(h,id,6)
local real a=Atan2(y1-y,x1-x)
local real sr=SR(x,y,x1,y1)
local real fl=sr/LoadReal(h,id,7)
if SR(x,y,x1,y1)>50 and l__d!=null and GetUnitFlyHeight(l__d)>10 then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
if IsTerrainPathable(GetUnitX(l__d),GetUnitY(l__d),PATHING_TYPE_FLYABILITY)==false then
call UnitApplyTimedLife(l__d,'BTLF',0.05)
endif
call SetUnitFacing(l__d,a*bj_RADTODEG)
if LoadInteger(h,id,9)==0 then
call SetUnitFlyHeight(l__d,ParabolaZ2(0,850,650,LoadReal(h,id,8),sr),0)
elseif LoadInteger(h,id,9)==1 then
call SetUnitFlyHeight(l__d,ParabolaZ2(10,850,90,LoadReal(h,id,8),sr),0)
elseif LoadInteger(h,id,9)==2 then
call SetUnitFlyHeight(l__d,ParabolaZ2(0,850,510,LoadReal(h,id,8),sr),0)
endif
call SaveReal(h,id,1,speed*0.984)
else
if l__d!=null then
call SetUnitFlyHeight(l__d,5,0)
call UnitRemoveAbility(l__d,'A1DB')
call UnitApplyTimedLife(l__d,'BTLF',0.03)
endif
if GetRandomInt(0,2)==1 then
set EFF=AddSpecialEffect("war3mapImported\\BlueBoom.mdx",GetUnitX(l__d),GetUnitY(l__d))
call SetSpecialEffectScale(EFF,0.65)
call SetSpecialEffectTimeScale(EFF , 3)
call DestroyEffect(EFF)
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set t=null
endfunction
function GogetaRMissles takes unit l__d,real speed,real a,real x,real y,unit u,integer mode returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,GetUnitFlyHeight(l__d))
call SaveReal(h,id,5,x)
call SaveReal(h,id,6,y)
call SaveReal(h,id,7,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,8,SR(x,y,GetUnitX(u),GetUnitY(u)))
call SaveInteger(h,id,9,mode)
call TimerStart(t,0.015,true,function GogetaRMissles2)
set t=null
endfunction
function GogetaRCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real dmg=GetHeroStr(u,true)*(4+GetUnitAbilityLevel(u,'A2FF'))*0.1
local unit l__d=LoadUnitHandle(h,id,9)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,4)
local real y1=LoadReal(h,id,5)
local real x2=0
local real y2=0
local real sr2=0
local real a=LoadReal(h,id,3)
local real dist=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
local integer i=0
if dist<2.3 then
call SaveReal(h,id,2,dist+0.1)
call PauseUnit(u,true)
if dist<2 then
if dist==0.0 or dist==0.6 or dist==1.2 or dist==1.8 then
set EFF=AddSpecialEffect("war3mapImported\\ChoOdamaRasengan1.mdx",GetUnitX(l__d)+155*Cos(a),GetUnitY(l__d)+155*Sin(a))
call SetSpecialEffectZ(EFF , 840)
call SetSpecialEffectScale(EFF,0.5)
call DestroyEffect(EFF)
endif
set x2=x1+GetRandomReal(-590,-200)*Cos(GetRandomReal(0,6.28))
set y2=y1+GetRandomReal(-590,-200)*Sin(GetRandomReal(0,6.28))
set sr2=SR(x2,y2,x,y)
set n=CreateUnit(p,'e255',x+105*Cos(a),y+105*Sin(a),a*bj_RADTODEG)
call SetUnitFlyHeight(n,850,0)
call SetUnitTimeScale(n,2)
call GogetaRMissles(n,GetRandomReal(12,16)+sr2*0.017,a,x2,y2,u,1)
set x2=x1+GetRandomReal(-200,200)*Cos(GetRandomReal(0,6.28))
set y2=y1+GetRandomReal(-200,200)*Sin(GetRandomReal(0,6.28))
set sr2=SR(x2,y2,x,y)
set n=CreateUnit(p,'e255',x+105*Cos(a),y+105*Sin(a),a*bj_RADTODEG)
call SetUnitFlyHeight(n,850,0)
call SetUnitTimeScale(n,2)
call GogetaRMissles(n,GetRandomReal(12,16)+sr2*0.017,a,x2,y2,u,2)
set x2=x1+GetRandomReal(200,590)*Cos(GetRandomReal(0,6.28))
set y2=y1+GetRandomReal(200,590)*Sin(GetRandomReal(0,6.28))
set sr2=SR(x2,y2,x,y)
set n=CreateUnit(p,'e255',x+105*Cos(a),y+105*Sin(a),a*bj_RADTODEG)
call SetUnitFlyHeight(n,850,0)
call SetUnitTimeScale(n,2)
call GogetaRMissles(n,GetRandomReal(12,16)+sr2*0.017,a,x2,y2,u,0)
set x2=x1+GetRandomReal(-200,200)*Cos(GetRandomReal(0,6.28))
set y2=y1+GetRandomReal(-200,200)*Sin(GetRandomReal(0,6.28))
set sr2=SR(x2,y2,x,y)
set n=CreateUnit(p,'e255',x+105*Cos(a),y+105*Sin(a),a*bj_RADTODEG)
call SetUnitFlyHeight(n,850,0)
call SetUnitTimeScale(n,2)
call GogetaRMissles(n,GetRandomReal(12,16)+sr2*0.017,a,x2,y2,u,2)
set x2=x1+GetRandomReal(200,590)*Cos(GetRandomReal(0,6.28))
set y2=y1+GetRandomReal(200,590)*Sin(GetRandomReal(0,6.28))
set sr2=SR(x2,y2,x,y)
set n=CreateUnit(p,'e255',x+105*Cos(a),y+105*Sin(a),a*bj_RADTODEG)
call SetUnitFlyHeight(n,850,0)
call SetUnitTimeScale(n,2)
call GogetaRMissles(n,GetRandomReal(12,16)+sr2*0.017,a,x2,y2,u,0)
set x2=x1+GetRandomReal(-590,-200)*Cos(GetRandomReal(0,6.28))
set y2=y1+GetRandomReal(-590,-200)*Sin(GetRandomReal(0,6.28))
set sr2=SR(x2,y2,x,y)
set n=CreateUnit(p,'e255',x+105*Cos(a),y+105*Sin(a),a*bj_RADTODEG)
call SetUnitFlyHeight(n,850,0)
call SetUnitTimeScale(n,2)
call GogetaRMissles(n,GetRandomReal(12,16)+sr2*0.017,a,x2,y2,u,1)
set x2=x1+GetRandomReal(-200,200)*Cos(GetRandomReal(0,6.28))
set y2=y1+GetRandomReal(-200,200)*Sin(GetRandomReal(0,6.28))
set sr2=SR(x2,y2,x,y)
set n=CreateUnit(p,'e255',x+105*Cos(a),y+105*Sin(a),a*bj_RADTODEG)
call SetUnitFlyHeight(n,850,0)
call SetUnitTimeScale(n,2)
call GogetaRMissles(n,GetRandomReal(12,16)+sr2*0.017,a,x2,y2,u,2)
endif
if dist>0.3 then
call GroupEnumUnitsInRange(G,x1,y1,650,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call SetUnitAnimation(E,"death")
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SlowUnit(u,E,0.5,0,3,0,false)
endif
call GroupRemoveUnit(G,E)
endloop
endif
if dist==2 then
    if GetUnitAbilityLevel(u,'A170')>0 then
        call SetUnitAnimation(n,"Stand Alternate")
    else
        call SetUnitAnimation(n,"Stand")
    endif
endif
else
call UnitRemoveAbility(u,'A1F8')
call SetUnitFlyHeight(u,0,0)
call ShowUnit(u,true)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
call SetUnitTimeScale(l__d,1)
call RemoveUnit(l__d)
if GetLocalPlayer()==p then
call ClearSelection()
call SelectUnit(u,true)
endif
call SetUnitTimeScale(u,1)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set u=null
set p=null
set t=null
endfunction
function GogetaRCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,9)
local real dist=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
local real a=LoadReal(h,id,3)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,4)
local real y1=LoadReal(h,id,5)
local real sr=LoadReal(h,id,10)
if dist<1.2 then
call PauseUnit(u,true)
call SaveReal(h,id,2,dist+0.02)
if dist<1.0 then
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Rasengan37.mdx",l__d,"weapon"))
if SR(x1,y1,GetUnitX(l__d),GetUnitY(l__d))<700 then
call SetUnitXY_1(l__d,GetUnitX(l__d)-8*Cos(a),GetUnitY(l__d)-8*Sin(a), false)
call SetUnitFlyHeight(l__d,ParabolaZ2(0,5,800,160,dist*80),0)
endif
if SR(x1,y1,GetUnitX(l__d),GetUnitY(l__d))>=700 and SR(x1,y1,GetUnitX(l__d),GetUnitY(l__d))<720 then
call SetUnitFlyHeight(l__d,200+dist*600,0)
endif
if SR(x1,y1,GetUnitX(l__d),GetUnitY(l__d))>=720 then
call SetUnitXY_1(l__d,GetUnitX(l__d)+7*Cos(a),GetUnitY(l__d)+7*Sin(a), false)
call SetUnitFlyHeight(l__d,ParabolaZ2(0,5,800,sr,SR(x1,y1,GetUnitX(l__d),GetUnitY(l__d))),0)
endif
endif
else
call PauseTimer(t)
call SaveReal(h,id,2,0)
call SetUnitTimeScale(l__d,0.1)
call SetUnitFlyHeight(l__d,800,0)
call SetUnitXY_1(u,GetUnitX(l__d),GetUnitY(l__d), false)
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(1694) // Sound\Music\mp3Music\GogetaR2.mp3
else
set soundplay=SndN(1697) // Sound\Music\mp3Music\Gogeta\GogetaR2-jap.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call ShakeCamera(1.5,15)
call TimerStart(t,0.10,true,function GogetaRCast3)
endif
set u=null
set p=null
set t=null
set l__d=null
endfunction
function GogetaRCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local real sc=0
local real is=0
local real ig=30*bj_DEGTORAD
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,0)
call SaveReal(h,id,3,a)
call SaveReal(h,id,4,x1)
call SaveReal(h,id,5,y1)
call SaveReal(h,id,10,SR(x1,y1,x,y))
call PauseUnit(u,true)
call ShowUnit(u,false)
call SetUnitFlyHeight(u,300,0)
call SetUnitInvulnerable(u,true)
set n=CreateUnit(p,'e32F',x,y,a*bj_RADTODEG)
if GetUnitAbilityLevel(u,'A16X')>0 then
call UnitAddAbility(n,'A16X')
elseif GetUnitAbilityLevel(u,'A16Y')>0 then
call UnitAddAbility(n,'A16Y')
elseif GetUnitAbilityLevel(u,'A170')>0 then
call UnitAddAbility(n,'A170')
call AddUnitAnimationProperties(n,"alternate",true)
elseif GetUnitAbilityLevel(u,'A171')>0 then
call UnitAddAbility(n,'A171')
endif
if GetUnitAbilityLevel(u,'A170')>0 then
call SetUnitAnimationByIndex(n,50)
else
call SetUnitAnimationByIndex(n,5)
endif
call SetUnitTimeScale(n,0.95)
call SaveUnitHandle(h,id,9,n)
loop
exitwhen is>=13
set n=CreateUnit(p,'e0ZH',x+150*Cos(ig*is),y+150*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,255,255,255,45)
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.6)
set is=is+1
endloop
set n=CreateUnit(p,'e0RV',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,0.7)
call SetUnitVertexColor(n,255,255,255,125)
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(1700) // Sound\Music\mp3Music\GogetaR1.mp3
else
set soundplay=SndN(1702) // Sound\Music\mp3Music\Gogeta\GogetaR1-jap.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.02,true,function GogetaRCast2)
set u=null
set p=null
set t=null
endfunction
function InitTrig_GogetaR takes nothing returns nothing
    set gg_trg_GogetaR=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_GogetaR,EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_GogetaR,Condition(function GogetaRCond))
    call TriggerAddAction(gg_trg_GogetaR,function GogetaRCast)
endfunction
function StardustBreakerAct2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit l__d=LoadUnitHandle(h,id,3)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local integer idu=GetHandleId(u)
local real x2=GetUnitX(l__d)
local real y2=GetUnitY(l__d)
local integer i=LoadInteger(h,id,2)
local real time=LoadReal(h,id,7)
local player p=GetOwningPlayer(u)
local real a2=Atan2(y1-GetUnitY(u),x1-GetUnitX(u))
local real a=Atan2(y1-y2,x1-x2)
local real dmg=(1+GetUnitAbilityLevel(u,'A1P6'))*GetHeroStr(u,true)
if GetWidgetLife(c)>0 and GetWidgetLife(u)>0 and udg_B==true and i<2 then
if time==0 and i==0 then
set EFF=AddSpecialEffect("supershinythingyR.mdl", x,y)
call SaveEffectHandle(h,id,Effect1Hash,EFF)
call SetSpecialEffectScale(LoadEffectHandle(h,id,Effect1Hash) , 1.2)
call SetSpecialEffectZ(LoadEffectHandle(h,id,Effect1Hash) , 250)
call SetUnitFacing(u,a2*bj_RADTODEG)
if GetUnitAbilityLevel(u,'A170')>0 then
    call SetUnitAnimationByIndex(u,48)
else
    call SetUnitAnimationByIndex(u,3)
endif
endif
if time<1 and i==0 then
call PauseUnit(u,true)
if time==0.4 then
call DestroyEffect(LoadEffectHandle(h,id,Effect1Hash))
endif
call SaveReal(h,id,7,time+0.05)
elseif i==0 then
call SaveInteger(h,id,2,1)
call SaveReal(h,id,7,0)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
set l__d=CreateUnit(p,'e193',x+10*Cos(a2),y+10*Sin(a2),a2*bj_RADTODEG)
call SaveUnitHandle(h,id,3,l__d)
endif
if SR(x2,y2,x1,y1)>=80 and i==1 then
set x2=x2+(40+6*time)*Cos(a)
set y2=y2+(40+6*time)*Sin(a)
call SetUnitXY_1(l__d,x2,y2, false)
call SaveReal(h,id,7,time+0.05)
if time==0.2 then
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call SetUnitTimeScale(u,1)
endif
if time==3 then
call SaveInteger(h,id,2,3)
call UnitApplyTimedLife(l__d,'BTLF',0.1)
endif
elseif i==1 then
call SaveInteger(h,id,2,2)
if time<=0.2 then
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call SetUnitTimeScale(u,1)
endif
call UnitApplyTimedLife(l__d,'BTLF',0.3)
call Essence(u,c,2)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call myCustomDamage(u,c,dmg,false,false,null,null,null)
set soundplay=SndN(1704) // Sound\Music\mp3Music\GogetaW3.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set EFF=AddSpecialEffect("AZ_DD021.mdx", x1,y1)
call SetSpecialEffectScale(EFF , 1.3)
call SetSpecialEffectFacing(EFF , a2  * bj_RADTODEG-180)
call SetSpecialEffectZ(EFF , GetRandomReal(30,90))
call DestroyEffect(EFF)
set EFF=AddSpecialEffect("war3mapImported\\dash sfx.mdl", x1,y1)
call SetSpecialEffectScale(EFF , 0.8)
call SetSpecialEffectFacing(EFF , a2  * bj_RADTODEG-180)
call SetSpecialEffectZ(EFF , GetRandomReal(30,90))
call DestroyEffect(EFF)
endif
else
call DestroyTimer(t)
if i!=2 then
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call SetUnitTimeScale(u,1)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
endif
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set l__d=null
set c=null
set t=null
endfunction
function StardustBreakerAct takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=LoadUnitHandle(h,GetHandleId(u),SH_GGQ)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
//call UnitAddAbility(u,'A0MG')
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SetUnitTimeScale(u,1.3)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call SaveReal(h,id,7,0)
call SaveReal(h,id,2,0)
call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.20)
call TimerStart(t,0.05,true,function StardustBreakerAct2)
set soundplay=SndN(1707) // Sound\Music\mp3Music\GogetaW2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set u=null
set p=null
set t=null
set c=null
endfunction
function StardustBreakerInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function StardustBreakerAct)
call TriggerAddCondition(t,Condition(function CondStardustBreaker))
set t=null
endfunction
function CondUltimateImpact takes nothing returns boolean
return GetSpellAbilityId()=='A0P6' and udg_B==true
endfunction
function UltimateImpactAct2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local integer idu=GetHandleId(u)
local real x2=0
local real y2=0
local integer i=LoadInteger(h,id,2)
local real accel=LoadReal(h,id,7)
local player p=GetOwningPlayer(u)
local real a=Atan2(y1-GetUnitY(u),x1-GetUnitX(u))
local real dmg=(1+GetUnitAbilityLevel(u,'A0P6'))*GetHeroStr(u,true)
if GetWidgetLife(c)>0 and GetWidgetLife(u)>0 and udg_B==true and i!=6 then
call UnitRemoveAbility(u,'A2VJ')
if accel==5 and i==0 then
if GetUnitAbilityLevel(u,'A170')>0 then
call SetUnitAnimationByIndex(u,81)
else
call SetUnitAnimationByIndex(u,37)
endif
endif
if SR(x,y,x1,y1)>=110 and i==0 then
call SetUnitTimeScale(u,140/SR(x,y,x1,y1))
set x2=x+(60+accel)*Cos(a)
set y2=y+(60+accel)*Sin(a)
call PauseUnit(u,true)
call SetUnitXY_1(u,x2,y2, false)
if accel<35 then
call SaveReal(h,id,7,accel*1.3)
else
call SaveReal(h,id,7,35)
endif
elseif i==0 then
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
call SetUnitTimeScale(u,0.35)
call SaveReal(h,id,7,-25)
call SaveInteger(h,id,2,1)
set EFF=AddSpecialEffect("war3mapImported\\dash sfx.mdl", x1,y1)
call SetSpecialEffectFacing(EFF , a  * bj_RADTODEG)
call SetSpecialEffectScale(EFF , 0.3)
call SetSpecialEffectZ(EFF , 20)
call SetSpecialEffectTimeScale(EFF , 1.4)
call DestroyEffect(EFF)
set soundplay=SndN(1709) // Sound\Music\mp3Music\GogetaW13.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call ShakeCamera(0.1,15)
call Push3(c,100,Atan2(y1-y,x1-x),200,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
else
call SaveInteger(h,id,2,6)
endif
endif
if accel<=0 and i==1 then
set x2=x+(10+accel)*Cos(a)
set y2=y+(10+accel)*Sin(a)
call SetUnitTimeScale(u,0.3)
call SetUnitXY_1(u,x2,y2, false)
call SaveReal(h,id,7,accel+8)
elseif i==1 then
call SaveInteger(h,id,2,2)
endif
if SR(x,y,x1,y1)>=110 and i==2 then
call SetUnitTimeScale(u,140/SR(x,y,x1,y1))
set x2=x+(50+accel)*Cos(a)
set y2=y+(50+accel)*Sin(a)
call SetUnitXY_1(u,x2,y2, false)
call PauseUnit(u,true)
if accel<35 then
call SaveReal(h,id,7,accel*1.3)
else
call SaveReal(h,id,7,35)
endif
elseif i==2 then
call SaveReal(h,id,7,-25)
call SaveInteger(h,id,2,3)
set EFF=AddSpecialEffect("war3mapImported\\dash sfx.mdl", x1,y1)
call SetSpecialEffectFacing(EFF , a  * bj_RADTODEG)
call SetSpecialEffectScale(EFF , 0.3)
call SetSpecialEffectZ(EFF , 2)
call SetSpecialEffectTimeScale(EFF , 1.4)
call DestroyEffect(EFF)
set soundplay=SndN(1709) // Sound\Music\mp3Music\GogetaW13.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call ShakeCamera(0.1,25)
call Push3(c,70,Atan2(y1-y,x1-x),280,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
endif
if accel<=0 and i==3 then
call SetUnitTimeScale(u,0.3)
set x2=x+(4+accel)*Cos(a)
set y2=y+(4+accel)*Sin(a)
call SetUnitXY_1(u,x2,y2, false)
call PauseUnit(u,true)
call SaveReal(h,id,7,accel+6)
elseif i==3 then
call SaveInteger(h,id,2,4)
call SetUnitTimeScale(u,0.4)
call SetUnitFlyHeight(u,350,250)
endif
if SR(x,y,x1,y1)>=110 and i==4 then
call SetUnitTimeScale(u,140/SR(x,y,x1,y1))
set x2=x+(54+accel)*Cos(a)
set y2=y+(54+accel)*Sin(a)
call SetUnitXY_1(u,x2,y2, false)
if accel<35 then
call SaveReal(h,id,7,accel*1.15)
else
call SaveReal(h,id,7,35)
endif
elseif i==4 then
call SaveReal(h,id,7,20)
call SaveInteger(h,id,2,5)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call SetUnitInvulnerable(c,true)
call ShakeCamera(0.3,25)
call Push3(c,100,Atan2(y1-y,x1-x),400,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
set EFF=AddSpecialEffect("BrolyKickSlash.mdx", x1,y1)
call SetSpecialEffectOrientation(EFF , a* bj_RADTODEG+180,0,90)
call SetSpecialEffectScale(EFF , 1.7)
call SetSpecialEffectTimeScale(EFF , 0.6)
call SetSpecialEffectZ(EFF , 70)
call DestroyEffect(EFF)
set EFF=AddSpecialEffect("Minato-37.mdx", x1,y1)
call SetSpecialEffectScale(EFF , 1.8)
call SetSpecialEffectOrientation(EFF , a  * bj_RADTODEG+GetRandomReal(-80,80),GetRandomReal(-15,15),0)
call SetSpecialEffectZ(EFF , 50)
call DestroyEffect(EFF)
set soundplay=SndN(1712) // Sound\Music\mp3Music\GogetaW14.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
if accel>=0 and i==5 then
set x2=x+accel*Cos(a)
set y2=y+accel*Sin(a)
call SetUnitXY_1(u,x2,y2, false)
call SaveReal(h,id,7,accel-5)
elseif i==5 then
call SetUnitTimeScale(u,1)
call SaveInteger(h,id,2,6)
endif
else
call PauseUnit(u,false)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call SetUnitInvulnerable(u,false)
call SetUnitInvulnerable(c,false)
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
call myCustomDamage(u,c,dmg,false,false,null,null,null)
call SetControlToUnit(u,c, 2, "stun")
if GetUnitAbilityLevel(u,'A16X')==0 and UnitIsAlive(c)==true then
call SaveUnitHandle(h,idu,SH_GGQ,c)
call ShowAbility2('A0P6',false)
call ShowAbility2('A1P6',true)
call SetUnitAbilityLevel(u,'A1P6',GetUnitAbilityLevel(u,'A0P6'))
call RemoveSaveHashTimedGogeta(1,idu,SH_GGQ,u)
endif
call SetUnitFlyHeight(u,0,400)
else
call SetUnitFlyHeight(u,0,800)
call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
endif
call SetUnitTurnSpeed(u,1.00)
call SetUnitTimeScale(u,1)
//call Push_UltimateImpact(c,40,a,600,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",u)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function UltimateImpactAct takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
local player p=GetOwningPlayer(u)
//call UnitAddAbility(u,'A0MG')
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SetUnitInvulnerable(c,true)
call UnitAddAbility(u,'Arav')
call UnitRemoveAbility(u,'Arav')
call SetUnitFlyHeight(u,110,55)
call SetUnitTimeScale(u,1)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call SaveReal(h,id,7,5)
call TimerStart(t,0.035,true,function UltimateImpactAct2)
set soundplay=SndN(1715) // Sound\Music\mp3Music\GogetaW11.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SetUnitTurnSpeed(u,3.00)
set u=null
set p=null
set t=null
set c=null
endfunction
function UltimateImpactInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function UltimateImpactAct)
call TriggerAddCondition(t,Condition(function CondUltimateImpact))
set t=null
endfunction
function BigBangGogetaCond takes nothing returns boolean
return GetSpellAbilityId()=='A0P5'
endfunction
function BigBangGogetaCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local group g=LoadGroupHandle(h,id,4)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,5)
local integer l__idg=GetHandleId(g)
local player p=GetOwningPlayer(u)
local real dmg=LoadReal(h,id,10)
if SR(x,y,x1,y1)<=1450 and IsTerrainPathable(GetUnitX(l__d),GetUnitY(l__d),PATHING_TYPE_FLYABILITY)==false then
call SetUnitX(l__d,x1+38*Cos(a))
call SetUnitY(l__d,y1+38*Sin(a))
call GroupEnumUnitsInRange(g,x1,y1,150,Base)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call DestroyEffect(AddSpecialEffect("war3mapImported\\TealSlam.mdx",GetUnitX(E),GetUnitY(E)))
call SaveUnitHandle(h,l__idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
else
call GroupEnumUnitsInRange(g,x1,y1,400,Base)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call DestroyEffect(AddSpecialEffect("war3mapImported\\TealSlam.mdx",GetUnitX(E),GetUnitY(E)))
call SaveUnitHandle(h,l__idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
call StartSound(soundStr[47])
call UnitApplyTimedLife(CreateUnit(p,'e0C4',x1,y1,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0C6',x1,y1,(a*bj_RADTODEG)),'BTLF',3)
set n=CreateUnit(p,'e0NB',x1,y1,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.7)
call SetUnitTimeScale(n,0.7)
set n=CreateUnit(p,'e0NC',x1,y1,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.7)
set n=CreateUnit(p,'e0NE',x1,y1,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.7)
call SetUnitTimeScale(n,0.8)
call UnitApplyTimedLife(l__d,'BTLF',0.2)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
call DestroyTimer(t)
call DestroyGroup(g)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function BigBangGogetaCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
local real dmg=GetHeroAgi(u,true)*(GetUnitAbilityLevel(u,'A0P5')+3)
call SaveUnitHandle(h,id,0,u)
call UnitApplyTimedLife(CreateUnit(p,'e0DH',x+25*Cos(a),y+25*Sin(a),a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0DI',x+25*Cos(a),y+25*Sin(a),a*bj_RADTODEG),'BTLF',1)
call SaveUnitHandle(h,id,1,CreateUnit(p,'e0DG',x+80*Cos(a),y+80*Sin(a),f))
call SaveGroupHandle(h,id,4,CreateGroup())
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveReal(h,id,5,a)
if GetUnitAbilityLevel(u,'B044')>0 then
set dmg=dmg+(1.75+GetUnitAbilityLevel(u,'A0P8')*0.50)*GetHeroAgi(u,true)+(1.75+GetUnitAbilityLevel(u,'A0P8')*0.50)*GetHeroStr(u,true)
endif
set soundplay=SndN(1717) // Sound\Music\mp3Music\ThrowBlast.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call UnitRemoveAbility(u,'B044')
call SaveReal(h,id,10,dmg)
call SetUnitFacing(LoadUnitHandle(h,id,1),a*bj_RADTODEG)
call TimerStart(t,0.03,true,function BigBangGogetaCast2)
set u=null
set p=null
set t=null
endfunction
