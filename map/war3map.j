function NejiQCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local unit d1=LoadUnitHandle(h,id,6)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local group g=LoadGroupHandle(h,id,4)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,5)
local player p=GetOwningPlayer(u)
local real l__s=GetRandomReal(1.1,2.1)
local real dmg=GetHeroAgi(u,true)*(2+GetUnitAbilityLevel(u,'A24E'))
local unit nje=null // свои вместо общих E / ide / idg: урон внутри перебора
local integer njide=0
local integer njidg=0
if SR(x,y,x1,y1)<=1400 then
set x1=x1+63*Cos(a)
set y1=y1+63*Sin(a)
set n=CreateUnit(p,'e0XY',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,l__s,l__s,l__s)
call SetUnitVertexColor(n,255,255,255,40)
set n=CreateUnit(p,'e0XX',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitScale(n,l__s,l__s,l__s)
call SetUnitVertexColor(n,255,255,255,60)
set n=CreateUnit(p,'e0XW',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitScale(n,l__s,l__s,l__s)
if IsTerrainPathable(x1,y1,PATHING_TYPE_FLYABILITY)==false then
set EFF=AddSpecialEffect("war3mapImported\\dash sfx.mdl", x1, y1)
call SetSpecialEffectOrientation(EFF , a* bj_RADTODEG,-90,0)
call SetSpecialEffectZ(EFF , 100)
call SetSpecialEffectScale(EFF , l__s-0.7)
call SetSpecialEffectVertexColour(EFF,255,255,255,120)
call RemoveEffect(EFF,1,true,CreateTimer())
endif
set n=CreateUnit(p,'e1MZ',x1,y1,(a*bj_RADTODEG))
call SetUnitScale(n,l__s-0.3,l__s-0.3,l__s-0.3)
call SetUnitVertexColor(n,255,255,255,120)
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitXY_1(l__d,x1,y1, false)
call SetUnitX(d1,x1)
call SetUnitY(d1,y1)
call GroupEnumUnitsInRange(g,x1,y1,400,Base)
set njidg=GetHandleId(g)
loop
set nje=FirstOfGroup(g)
set njide=GetHandleId(nje)
if Condition_Base(p,nje)and nje!=LoadUnitHandle(h,njidg,njide)then
call myCustomDamage(u,nje,dmg,false,false,null,null,null)
call Push(nje,30,a,400)
call SaveUnitHandle(h,njidg,njide,nje)
endif
call GroupRemoveUnit(g,nje)
exitwhen nje==null
endloop
else
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,GetHandleId(g))
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
call RemoveUnit(l__d)
call RemoveUnit(d1)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
set d1=null
set nje=null
endfunction
