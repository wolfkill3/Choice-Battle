function Trig_Fire_Shield_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A015' or GetSpellAbilityId()=='A315'
endfunction
function Trig_Fire_Shield_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real m=GetUnitState(u,UNIT_STATE_MANA)
local real mx=GetUnitState(u,UNIT_STATE_MAX_MANA)
local player p=GetOwningPlayer(u)
local real dmg=.04*GetHeroStr(u,true)
local group g=CreateGroup()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
if m>mx*.02 and GetUnitAbilityLevel(u,'AcF1')>0 and GetWidgetLife(u)>0.5 and LoadBoolean(HH,GetHandleId(u),SST)==true then
if IsUnitPaused(u)==false and IsUnitHidden(u)==false then
call SetUnitState(u,UNIT_STATE_MANA,m-mx*0.015*.02)
call SetUnitXY_1(l__d,x,y, false)
call SetUnitFacing(l__d,GetUnitFacing(u))
call GroupEnumUnitsInRange(g,x,y,400,Base)
loop
set E=FirstOfGroup(g)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(g,E)
endloop
endif
else
call SaveBoolean(HH,GetHandleId(u),SS,false)
call SaveBoolean(HH,GetHandleId(u),SST,false)
call RemoveUnit(l__d)
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call ShowAbility2('A315',false)
call ShowAbility2('A015',true)
call UnitRemoveAbility(u,'AcF1')
call FlushChildHashtable(h,id)
endif
set g=null
set p=null
set u=null
set t=null
set l__d=null
endfunction
function Trig_Fire_Shield_Actions takes nothing returns nothing // ace f
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
if GetSpellAbilityId()=='A015' then
call SaveUnitHandle(h,id,0,u)
call ShowAbility2Timed('A015',false,0.3)
call ShowAbility2Timed('A315',true,0.32)
call UnitAddAbility(u,'AcF1')
call SaveBoolean(HH,GetHandleId(u),SST,true)
set soundplay=SndN(1561) // Sound\Music\mp3Music\AceF.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
call SaveBoolean(HH,GetHandleId(u),SST,false)
call ShowAbility2('A315',false)
call ShowAbility2('A015',true)
call UnitRemoveAbility(u,'AcF1')
endif
if LoadBoolean(HH,GetHandleId(u),SS)==false then
    call SaveBoolean(HH,GetHandleId(u),SS,true)
    call SaveUnitHandle(h,id,1,CreateUnit(GetOwningPlayer(u),0x65303051,GetUnitX(u),GetUnitY(u),GetUnitFacing(u)))
    call TimerStart(t,.02,true,function Trig_Fire_Shield_Actions2)
endif
set u=null
set t=null
endfunction
