call EffectCreateAndMove(true,EffectID[1038],GetRandomReal(0,360),1.25,GetRandomReal(1,1.5),GetRandomReal(0.75,1.25),100,100,100,GetRandomReal(20,40),0,caster,GetRandomInt(350,550),GetRandomReal(0,360))
endif
