function Trig_Araudi_no_Tejoo_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A06D'
endfunction
function Trig_Araudi_no_Tejoo_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,2)
local group g=LoadGroupHandle(h,id,3)
local group g2
local real x=GetUnitX(c)
local real y=GetUnitY(c)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real a=Atan2(y1-y,x1-x)
local integer i=0

local real x0
local real y0
local real time=LoadReal(h,id,5)
local integer HibG=LoadInteger(h,id,21)

set time=time+0.1
call SaveReal(h,id,5,time)
if  HibG==3 and time==0.1 then 
//call UnitStop(u)
call SetUnitAnimationByIndex(u,6)
endif


if HibG==2 and (time==0.7 or time == 1.7 or time==2.7 or time== 3.7) then
call DestroyEffect(AddSpecialEffect("Others\\BlackBlink1.mdl",GetUnitX(u),GetUnitY(u)))
call MoveUnit( c , u ,-120,Angle2(GetUnitX( u ),GetUnitY( u ),GetUnitX( c ),GetUnitY( c )))
call SetUnitFacingInstant( u ,Angle2(GetUnitX( u ),GetUnitY( u ),GetUnitX( c ),GetUnitY( c )))
call SetUnitAnimation(u,"Attack")
endif
if HibG==2 and (time==1 or time == 2 or time==3 or time== 4) then
//call DestroyEffect(AddSpecialEffectTarget("Others\\[doft]purpleaz-hit.mdl",c,"chest"))
set n0=CreateUnit(GetOwningPlayer(c),'e200',GetUnitX(c),GetUnitY(c),GetUnitFacing(u))
call SetUnitModel(n0,"Others\\[doft]purpleaz-hit.mdl")
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call SetUnitFlyHeight(n0,GetUnitFlyHeight(c)+100,0)
//call MoveUnit(a201,n,distance01,d201)
call UnitSize(n0,1.75,1,1)
call UnitSpeed(n0,0.75)
call MyRemoveUnit(n0,1)
set n0=null
call myCustomDamage(u,c,LoadReal(h,id,15),false,false,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,null)
endif

if HibG==2 and (time==1.3 or time == 2.3 or time==3.3) then
set x0=PolX(LoadReal(h,id,11),0,Angle2(GetUnitX( u ),GetUnitY( u ),GetUnitX( c ),GetUnitY( c )))
set y0=PolY(LoadReal(h,id,12),0,Angle2(GetUnitX( u ),GetUnitY( u ),GetUnitX( c ),GetUnitY( c )))
if IsTerrainPathable(x0,y0,PATHING_TYPE_FLYABILITY)==false then
call SetUnitX(u,x0)
call SetUnitY(u,y0)
endif
//call MoveAoe1(LoadReal(h,id,11),LoadReal(h,id,12), u ,0,Angle2(GetUnitX( u ),GetUnitY( u ),GetUnitX( c ),GetUnitY( c )))
endif


if HibG==3 then
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call MoveLightningEx(LoadLightningHandle(h,id,16),true,GetUnitX( u ),GetUnitY( u ),GetUnitFlyHeight( u )+75,GetUnitX( c ),GetUnitY( c ),GetUnitFlyHeight( c )+75)
endif

if GetUnitAbilityLevel(c,'B012')>0 or  (time<4 and HibG==3)  then

if SR(x,y,x1,y1)>120.00 then
set x=x+20*Cos(a)
set y=y+20*Sin(a)
call SetUnitXY_1(c,x,y, false)
endif

call myCustomDamage(u,c,GetUnitAbilityLevel(u,'A06D')*GetHeroAgi(u,true)*0.025+GetHeroAgi(u,true)*0.075,false,false,null,null,null)
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",c,"chest"))
call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",x,y))

set g2=CopyGroup(g)
loop
set E=FirstOfGroup(g2)
exitwhen E==null
call SetUnitX(E,x)
call SetUnitY(E,y)
call GroupRemoveUnit(g2,E)
endloop

call DestroyGroupTimed(g2,3)

else

call ForGroup(g,function KillGroup)
call DestroyEffect(LoadEffectHandle(h,id,1))
set n=CreateUnit(GetOwningPlayer(u),'e1V0',RX,RY,0)
call UnitApplyTimedLife(n,'BTLF',5)


if HibG==1 then
call SetControlToUnit(u,c,1,"stun")
endif

if HibG==3 then
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call DestroyLightning(LoadLightningHandle(h,id,16))
endif



call PauseTimer(t)
call GroupClear(g)
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set c=null
set u=null
set g=null
set g2=null
set t=null
endfunction
function Trig_Araudi_no_Tejoo_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local real x=GetUnitX(c)
local real y=GetUnitY(c)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local group g=CreateGroup()
local player p=GetOwningPlayer(u)
local integer i=0
local integer HibG=0
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,2,c)
call SaveEffectHandle(h,id,1,AddSpecialEffectTarget("war3mapImported\\PurpleChakra.mdx",u,"origin"))

loop
exitwhen i>=7
set n=CreateUnit(p,'e0D2',x,y,0)
call GroupAddUnit(g,n)
call SetUnitFlyHeight(n,20*i,0)
set i=i+1
endloop
call SaveGroupHandle(h,id,3,g)
set soundplay=SndN(924) // Sound\Music\mp3Music\HibariKambioForm.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set n=CreateUnit(GetOwningPlayer(u),'e1V0',RX,RY,0)
call UnitApplyTimedLife(n,'BTLF',5)


if GetUnitAbilityLevel(u,'KHG1')>0 then
set HibG=1

endif

if GetUnitAbilityLevel(u,'KHG2')>0 then
set HibG=2

call SaveReal(h,id,11,GetUnitX(u) )
call SaveReal(h,id,12,GetUnitY(u) )
call SaveReal(h,id,15,(GetUnitAbilityLevel(u,'A06D')*0.25 )*GetUnitTotalDamage(u) )
endif

if GetUnitAbilityLevel(u,'KHG3')>0 then
set HibG=3
call SetControlToUnit(u,c,4,"stun")
call SaveLightningHandle(h,id,16,AddLightningEx("DRAL",true,GetUnitX( u ),GetUnitY( u),GetUnitFlyHeight( u )+75,GetUnitX( c ),GetUnitY( c ),GetUnitFlyHeight( c )+75))
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SetUnitAnimationByIndex(u,6)
endif

call SaveInteger(h,id,21,HibG)
call TimerStart(t,0.1,true,function Trig_Araudi_no_Tejoo_Actions2)
else
call IssueImmediateOrder(u,"stop")
call SetUnitPathing(u,true)
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitVertexColor(u,255,255,255,255)
call FlushChildHashtable(h,id)
call SetUnitTimeScale(u,1)
endif
set u=null
set g=null
set c=null
set t=null
endfunction
function InitTrig_Araudi_no_Tejoo takes nothing returns nothing
set gg_trg_Araudi_no_Tejoo=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Araudi_no_Tejoo,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_Araudi_no_Tejoo,Condition(function Trig_Araudi_no_Tejoo_Conditions))
call TriggerAddAction(gg_trg_Araudi_no_Tejoo,function Trig_Araudi_no_Tejoo_Actions)
endfunction

function HibariW_NewPeriodic takes nothing returns nothing
        local timer newTimer = GetExpiredTimer()
        local integer id         = GetHandleId(newTimer)
        local unit caster        = LoadUnitHandle(h, id, 0)
        local real caster_x  = GetUnitX(caster)
        local real caster_y  = GetUnitY(caster)
        local real angle     = LoadReal(h, id, 1)
        local real distance  = LoadReal(h, id, 2)
        
        if distance>0 and UnitIsAlive(caster) then
                call SaveReal(h, id, 2, distance-50)
                call SetUnitX(caster, caster_x+50*Cos(angle))
                call SetUnitY(caster, caster_y+50*Sin(angle))
                if LoadInteger(h, id, 3)<=0 then
                        set n = CreateUnit(GetOwningPlayer(caster), 'dH72', caster_x, caster_y, angle*bj_RADTODEG)
                        call SetUnitVertexColor(n, 255, 255, 255, 85)
                        call SetUnitAnimationByIndex(n, 5)
                        call SetUnitTimeScale(n, 2)
                        call MyRemoveUnit(n, 0.13)
                        set n = CreateUnit(GetOwningPlayer(caster), 'dR45', caster_x, caster_y, angle*bj_RADTODEG)
                        call SetUnitScale(n, 0.7, 0.7, 0.7)
                        call MyRemoveUnit(n, 1.5)
                        call SaveInteger(h, id, 3, 1)
                else
                        call SaveInteger(h, id, 3, LoadInteger(h, id, 3)-1)
                endif
        else
                set n=CreateUnit(GetOwningPlayer(caster), 'dH18', caster_x, caster_y, angle * bj_RADTODEG)
                call SetUnitScale(n, 0.85, 0.85, 0.85)
                call SetUnitVertexColor(n, 255, 255, 255, 200)
                call MyRemoveUnit(n , 1.5)
                call PauseUnit(caster, false)
                call SetUnitInvulnerable(caster, false)
                call FlushChildHashtable(h, id)
                call PauseTimer(newTimer)
                call DestroyTimer(newTimer)
        endif
        
        set newTimer=null
        set caster=null
endfunction

function HibariW_CloudInfluence takes unit newCaster, real point_x, real point_y returns nothing
        local timer newTimer = CreateTimer()
        local integer id         = GetHandleId(newTimer)
        local real caster_x      = GetUnitX(newCaster)
        local real caster_y  = GetUnitY(newCaster)
        local real angle         = AtanPoint(caster_x, caster_y, point_x, point_y)
        local real distance  = SquareRootPoint(caster_x, caster_y, point_x, point_y)
        
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dR64', caster_x + 50 * Cos(angle), caster_y + 50 * Sin(angle), angle * bj_RADTODEG)
        call SetUnitFlyHeight(n, 160, 0)
        call MyRemoveUnit(n , 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH19', caster_x + 50 * Cos(angle), caster_y + 50 * Sin(angle), angle * bj_RADTODEG)
        call SetUnitFlyHeight(n, 160, 0)
        call SetUnitScale(n, 0.75, 0.75, 0.75)
        call SetUnitVertexColor(n, 255, 255, 255, 140)
        call MyRemoveUnit(n , 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH18', caster_x, caster_y, angle * bj_RADTODEG)
        call SetUnitScale(n, 0.85, 0.85, 0.85)
        call SetUnitVertexColor(n, 255, 255, 255, 200)
        call MyRemoveUnit(n , 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dR88', caster_x, caster_y, angle * bj_RADTODEG)
        call MyRemoveUnit(n , 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dR42', caster_x, caster_y, angle * bj_RADTODEG)
        call SetUnitScale(n, 0.75, 0.75, 0.75)
        call SetUnitFlyHeight(n, 0.75, 0)
        call MyRemoveUnit(n , 1.5)
        
        set soundplay=SndN(926) // Sound\war3mapImported\HibariW_Sound.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        if GetRandomInt(0, 1)==0 then
                set soundplay=SndN(928) // Sound\war3mapImported\HibariW_Voice.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        endif
        if distance>800 then
                set distance=800
        endif
        call UnitAddAbility(newCaster, 'HiW2')
        call UnitMakeAbilityPermanent(newCaster, true, 'HiW2')
        call UnitRemoveAbilityTimed_ExD(newCaster, 'HiW2', 10.0)
        call UnitAddAbility(newCaster, 'ReFa')
        call UnitMakeAbilityPermanent(newCaster, true, 'ReFa')
        call UnitRemoveAbilityTimed_ExD(newCaster, 'ReFa', 10.0)
        call UnitAddAbility(newCaster, 'ReFm')
        call UnitMakeAbilityPermanent(newCaster, true, 'ReFm')
        call UnitRemoveAbilityTimed_ExD(newCaster, 'ReFm', 5.0)
        call PauseUnit(newCaster, true)
        call SetUnitInvulnerable(newCaster, true)
        call SetUnitAnimationByIndex(newCaster, 5)
        call SaveUnitHandle     (h, id, 0, newCaster)
        call SaveReal           (h, id, 1, angle)
        call SaveReal           (h, id, 2, distance)
        call TimerStart(newTimer, 0.0125, true, function HibariW_NewPeriodic)
        set newTimer = null
endfunction

function HibariNewSpellsCast takes nothing returns nothing
        if GetSpellAbilityId()=='HiW1' then
                call HibariW_CloudInfluence(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
        endif
endfunction

function HibariSpellsInit takes nothing returns nothing
        local trigger t=CreateTrigger()
        local integer i=0
        loop
                call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
                set i=i+1
                exitwhen i>=bj_MAX_PLAYER_SLOTS
        endloop
        call TriggerAddAction(t,function HibariNewSpellsCast)
        set t=null
endfunction

function WhiteSphereCond takes nothing returns boolean
return GetSpellAbilityId()=='A0II' and udg_B==true and GetSpellTargetUnit()==Hero[GetPlayerId(GetOwningPlayer(GetSpellTargetUnit()))]
endfunction
function WhiteSpherePick takes nothing returns nothing
if(GetLocalPlayer()==GetTriggerPlayer())then
//call ClearSelection()
endif
endfunction
function WhiteSphereCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,2)
local real cml=GetUnitState(c,UNIT_STATE_MAX_LIFE)
local real uml=GetUnitState(u,UNIT_STATE_MAX_LIFE)
local player p=GetOwningPlayer(u)
local integer ipu=GetPlayerId(p)
local real a=Atan2(LoadReal(h,id,7)-LoadReal(h,id,5),LoadReal(h,id,6)-LoadReal(h,id,4))
local real dmg=(2.5+GetUnitAbilityLevel(u,'A0II')*0.5 )*GetUnitTotalDamage(u)
local real dmg2=4*GetUnitTotalDamage(c)
local real dmg3= (2.5+GetUnitAbilityLevel(u,'A0II')*0.5 )*GetHeroAgi(u,true)
local integer ipc=GetPlayerId(GetOwningPlayer(c))
local real time=LoadReal(h, id, TIME_HASH)+0.1
call SaveReal(h, id, TIME_HASH, time)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call PauseUnit(u,true)
call SetUnitFacingInstant(u,Atan2(GetUnitY(c)-GetUnitY(u),GetUnitX(c)-GetUnitX(u))*bj_RADTODEG)
call SetUnitFacingInstant(c,Atan2(GetUnitY(u)-GetUnitY(c),GetUnitX(u)-GetUnitX(c))*bj_RADTODEG)
if ModuloReal(time,0.4)<0.11 then
    call SetUnitAnimation(u,"attack")
    if GetRandomInt(1,2)==1 then
        set n=CreateUnit(GetOwningPlayer(u), 'e0ZG', GetUnitX(u), GetUnitY(u), GetUnitFacing(u)+GetRandomInt(-55,55))
        call UnitScale(n, GetRandomReal(0.4,0.8),  GetRandomReal(0.4,0.8), 0.1)
        call SetUnitTimeScale(n,1.5)
        call MyRemoveUnit(n, 0.4)
    else
        set n=CreateUnit(GetOwningPlayer(u), 'e0ZF', GetUnitX(u), GetUnitY(u), GetUnitFacing(u)+GetRandomInt(-55,55))
        call UnitScale(n,  GetRandomReal(0.4,0.8),  GetRandomReal(0.4,0.8), 0.1)
        call SetUnitTimeScale(n,1.5)
        call MyRemoveUnit(n, 0.4)
    endif
endif
if ModuloReal(time,0.6)<0.11 then
    call SetUnitAnimation(c,"attack")
    if GetRandomInt(1,2)==1 then
        set n=CreateUnit(GetOwningPlayer(c), 'e0ZG', GetUnitX(c), GetUnitY(c), GetUnitFacing(c)+GetRandomInt(-55,55))
        call UnitScale(n,  GetRandomReal(0.4,0.8),  GetRandomReal(0.4,0.8), 0.1)
        call SetUnitTimeScale(n,1.5)
        call MyRemoveUnit(n, 0.4)
    else
        set n=CreateUnit(GetOwningPlayer(c), 'e0ZF', GetUnitX(c), GetUnitY(c), GetUnitFacing(c)+GetRandomInt(-55,55))
        call UnitScale(n,  GetRandomReal(0.4,0.8),  GetRandomReal(0.4,0.8), 0.1)
        call SetUnitTimeScale(n,1.5)
        call MyRemoveUnit(n, 0.4)
    endif
endif
// call SelectUnit(u,false)
// call SelectUnit(c,false)
if RectContainsUnit(gg_rct_HibariFight,u)==false or RectContainsUnit(gg_rct_HibariFight,c)==false or UnitIsAlive(u)==false or UnitIsAlive(c)==false or time>=4.0 then
    if RectContainsUnit(gg_rct_HibariFight,u)==false or UnitIsAlive(u)==false then
        call SetUnitX(c,LoadReal(h,id,6)+50*Cos(a))
        call SetUnitY(c,LoadReal(h,id,7)+50*Sin(a))
        if GetOwningPlayer(c)==GetLocalPlayer()then
            call SetCameraPosition(GetUnitX(c),GetUnitY(c))
        endif
    elseif RectContainsUnit(gg_rct_HibariFight,c)==false or UnitIsAlive(c)==false then
        call SetUnitX(u,LoadReal(h,id,4)-50*Cos(a))
        call SetUnitY(u,LoadReal(h,id,5)-50*Sin(a))
        if p==GetLocalPlayer()then
            call SetCameraPosition(GetUnitX(u),GetUnitY(u))
        endif
        elseif time>=3 then
                call SetUnitX(c,LoadReal(h,id,6)+50*Cos(a))
        call SetUnitY(c,LoadReal(h,id,7)+50*Sin(a))
        if GetOwningPlayer(c)==GetLocalPlayer()then
            call SetCameraPosition(GetUnitX(c),GetUnitY(c))
        endif
                call SetUnitX(u,LoadReal(h,id,4)-50*Cos(a))
        call SetUnitY(u,LoadReal(h,id,5)-50*Sin(a))
        if p==GetLocalPlayer()then
            call SetCameraPosition(GetUnitX(u),GetUnitY(u))
        endif
    endif
    // if(IsPlayerInForce(GetLocalPlayer(),f))then
        // call EnableUserControl(true)
    // endif
    call SetUnitInvulnerable(c,false)
    call SetUnitInvulnerable(u,false)
    call PauseUnit(c,false)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
    call PauseUnit(u,false)
    call UnitRemoveAbility(u,'A3IH')
    call UnitRemoveAbility(c,'A3IH')


    call myCustomDamage(u,c,dmg3,false,false,null,null,null)
    call myCustomDamage(u,c,dmg,false,false,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,null)
    call myCustomDamage(c,u,dmg2,false,false,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,null)
    call UnitRemoveAbility(u,'A165')
    call UnitRemoveAbility(c,'A165')
    call SetUnitTimeScale(u,1)
    call SetUnitTimeScale(c,1)
    call RemoveSavedHandle(h,id,0)
    call RemoveSavedHandle(h,id,2)
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(h,id)
endif
set c=null
set p=null
set u=null
set t=null
endfunction
function WhiteSphereCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local real x=GetUnitX(c)
local real y=GetUnitY(c)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local player p2=GetOwningPlayer(c)
local integer ipu=GetPlayerId(p)
local integer ipc=GetPlayerId(GetOwningPlayer(c))
local integer i=0
if IsUnitIllusion(c)==false then
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,2,c)
set n=CreateUnit(p,'e1D3',x,y,0)
call UnitApplyTimedLife(n,'BTLF',2)
call UnitScale(n,1,20,0.5)
call SaveReal(h,id,4,GetUnitX(u))
call SaveReal(h,id,5,GetUnitY(u))
call SaveReal(h,id,6,x)
call SaveReal(h,id,7,y)
call UnitAddAbility(u,'A3IH')
call UnitAddAbility(c,'A3IH')
call UnitAddAbility(u,'A165')
call UnitAddAbility(c,'A165')
call UnitMakeAbilityPermanent(c,true,'A3IH')
call UnitMakeAbilityPermanent(u,true,'A3IH')
call UnitMakeAbilityPermanent(c,true,'A165')
call UnitMakeAbilityPermanent(u,true,'A165')
call UnitRemoveAbility(u,'B011')
call UnitRemoveAbility(u,'A2VJ')
call UnitRemoveAbility(c,'A2VJ')
call SetUnitX(u,GetRectCenterX(gg_rct_HibariFirst))
