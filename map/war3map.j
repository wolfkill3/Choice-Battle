endif
set n=CreateUnit(p,'e0HH',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.20)
set n=CreateUnit(p,'e0HH',x1,y1,GetRandomReal(0,359))
call SetUnitScale(n,0.75,0.75,0.75)
call SetUnitFlyHeight(n,155,0)
call UnitApplyTimedLife(n,'BTLF',0.20)
set n=CreateUnit(p,'e0HH',x1,y1,GetRandomReal(0,359))
