call SaveGroupHandle(h,id,10,CreateGroup())
call SetUnitAnimationByIndex(u,3)
call TimerStart(t,0.1,true,function DanceMCast2)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\EffectR.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
if GetUnitTypeId(u)=='H01M' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\DanteR-0"+I2S(GetRandomInt(1,3))+".mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
elseif GetUnitTypeId(u)=='H21M' then
