function TamaCircleCond takes nothing returns boolean
return GetLearnedSkill()=='A1B0'
endfunction
function TamaCircleCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit l__d=LoadUnitHandle(HH,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=LoadReal(HH,id,2)
local real ti=LoadReal(HH,id,3)
local real dist=LoadReal(HH,id,4)
local integer ifd=LoadInteger(HH,id,5)
local player p=GetOwningPlayer(u)
if u==Hero[GetPlayerId(p)] then
if UnitIsAlive(u)then
if GetUnitAbilityLevel(l__d,'A1AV')==0 then
call ShowUnit(l__d,true)
if ifd==0 then
if dist<350 then
call SaveReal(HH,id,4,dist+2)
else
call SaveInteger(HH,id,5,1)
endif
else
if dist>0 then
call SaveReal(HH,id,4,dist-2)
else
call SaveInteger(HH,id,5,0)
endif
endif
call SetUnitX(l__d,x+(140+dist)*Cos(a))
call SetUnitY(l__d,y+(140+dist)*Sin(a))
call SetUnitFlyHeight(l__d,25+GetUnitFlyHeight(u),0)
if GetUnitAbilityLevel(l__d,'A1AW')==0 and GetUnitAbilityLevel(u,'A1AZ')==0 then
call SaveReal(HH,id,2,a+0.04)
elseif GetUnitAbilityLevel(l__d,'A1AW')!=0 then
call SaveReal(HH,id,2,a+0.20)
elseif GetUnitAbilityLevel(u,'A1AZ')!=0 then
call SaveReal(HH,id,2,a+0.12)
endif
call SaveReal(HH,id,3,ti+0.02)
if ti>12 then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DevourMagic\\DevourMagicBirthMissile.mdl",l__d,"origin"))
call SaveReal(HH,id,3,0)
call SetUnitAnimation(l__d,"stand")
endif
call SetUnitFacing(l__d,GetUnitFacing(u))
endif
else
call SetUnitFlyHeight(l__d,10000,0)
endif
else
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set u=null
set l__d=null
set p=null
set t=null
endfunction
