function CreateModeIndicatorWithPauseAizen_Periodic takes nothing returns nothing
    local timer t               =GetExpiredTimer()
    local integer id            =GetHandleId(t)
    local unit caster           =LoadUnitHandle(HH, id, c_CASTER)
    local player p              =GetOwningPlayer(caster)
    local integer idp           =GetHandleId(p)
    local string mode_name      =LoadStr(HH, id, c_NAME)
    local framehandle NewFrame  =LoadFrameHandle(HH, idp,StringHash(mode_name))
    local real duration         =LoadReal(HH, GetHandleId(NewFrame), c_DURATION)-0.05
    local integer position         =LoadInteger(HH, id, c_POSITION)
    local boolean SabracTOn=LoadBoolean(HH,GetHandleId( caster ),SH_AizenTAct)
    //    local boolean SabracTOn2=LoadReal(HH,GetHandleId( LoadUnitHandle(HH,id,30) ),StringHash( "AizenTR" ) )
    if position>0 then
        if LoadBoolean(HH,idp,position-1)==false then
        call SaveBoolean(HH,idp,position-1,true)
        call SaveBoolean(HH,idp,position,false)
        call SaveInteger(HH, id, c_POSITION,position-1)
        set position=position-1
        endif
    endif

    if IsUnitPaused( LoadUnitHandle(HH, id,30) )==false and IsUnitHidden( LoadUnitHandle(HH, id,30))==false and GetUnitAbilityLevel(caster,'Pet1')==0 then
        call SaveReal           (HH, GetHandleId(NewFrame), c_DURATION, duration)
        call StatusIndicatorText(NewFrame, idp, mode_name, duration)
    endif

    call StatusIndicatorPlace(NewFrame, position)
    
    if duration<=0 or udg_B==false or DU2==false or UnitIsAlive(caster)==false  or SabracTOn==false then
        call ShowFrame( NewFrame, false )
        call SaveReal(HH, GetHandleId(NewFrame), c_DURATION, 0)
        call SaveReal(HH, GetHandleId(LoadFrameHandle(HH, idp,StringHash(mode_name+"2"))), c_DURATION, 0)
        call SaveBoolean(HH,idp,position,false)
        call FlushChildHashtable(HH, id)
        call DestroyTimer(t)
    endif

    set t=null
    set caster=null
    set NewFrame=null
    set p=null
endfunction


function CreateModeIndicatorWithPauseAizen takes unit newCasterOwner,unit newCaster, string newString, real newDur returns nothing
        local timer newTimer        = CreateTimer()
        local integer id            = GetHandleId(newTimer)
    local framehandle NewFrame  = null
    local framehandle NewFrameText  = null
    local player p              =GetOwningPlayer(newCaster)
    local integer idp           =GetHandleId(p)
    local integer i=23
    local integer j=0
    if LoadFrameHandle(HH, idp,StringHash(newString))==null then    
        set NewFrame = CreateFrameByType( "SIMPLEBUTTON", newString, StatusBarFrame, "", 0 )
        call ClearFrameAllPoints( NewFrame )
        call SetFrameTexture( NewFrame, newString, 0, true )
        call SetFrameTexture( NewFrame, newString, 1, true )
        call SetFrameTexture( NewFrame, newString, 2, true )
        call SetFrameSize( NewFrame, .019, .019 )
        call SetFramePriority( NewFrame, 7 )
        call HandleListAddHandle(StatusBarFrameList[GetPlayerId(p)],NewFrame)
        call SetFrameParent(NewFrame,StatusBarFrame)
        call ShowFrame( NewFrame, GetOwningPlayer(GetUnitSelected(GetLocalPlayer()))==GetOwningPlayer(newCaster) and (IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(newCaster)) or GetPlayerId(GetLocalPlayer())==10 or GetPlayerId(GetLocalPlayer())==11))
        call ShowFrame( NewFrameText, GetOwningPlayer(GetUnitSelected(GetLocalPlayer()))==GetOwningPlayer(newCaster) and (IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(newCaster)) or GetPlayerId(GetLocalPlayer())==10 or GetPlayerId(GetLocalPlayer())==11))
        call SaveFrameHandle(HH,idp,StringHash(newString),NewFrame)
        call StatusIndicatorTooltip(NewFrame, newString)
        //call SaveReal               (HH, GetHandleId(NewFrame), c_DURATION, 2)
        
        set NewFrameText=CreateFrameByType( "SIMPLETEXT", newString+"1", NewFrame, "", 0 )
        call ClearFrameAllPoints( NewFrameText )
        call SetFrameBlendMode( NewFrameText, 0, BLEND_MODE_BLEND )
        call SetFrameFont( NewFrameText, "Fonts\\FRIZQT__.TTF", .008, 0 )
        call SetFrameTextAlignment( NewFrameText, TEXT_JUSTIFY_CENTER, TEXT_JUSTIFY_LEFT )
        call SetFrameText( NewFrameText, R2SW(newDur,2, 1) )
        call SetFrameTextColour( NewFrameText, 0xFFFFA500 )
        call HandleListAddHandle(StatusBarFrameList[GetPlayerId(p)],NewFrameText)
        call ShowFrame( NewFrameText, GetOwningPlayer(GetUnitSelected(GetLocalPlayer()))==GetOwningPlayer(newCaster) and (IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(newCaster)) or GetPlayerId(GetLocalPlayer())==10 or GetPlayerId(GetLocalPlayer())==11))
        call SaveFrameHandle(HH,idp,StringHash(newString+"2"),NewFrameText)
    else
        if LoadReal(HH, GetHandleId(NewFrame), c_DURATION)<=0 then
            set NewFrame=LoadFrameHandle(HH, idp,StringHash(newString))
            set NewFrameText=LoadFrameHandle(HH, idp,StringHash(newString+"2"))
            call SetFrameText( NewFrameText, R2SW(newDur,2, 1) )
            call ShowFrame( NewFrame, GetOwningPlayer(GetUnitSelected(GetLocalPlayer()))==GetOwningPlayer(newCaster) and (IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(newCaster)) or GetPlayerId(GetLocalPlayer())==10 or GetPlayerId(GetLocalPlayer())==11))
            call ShowFrame( NewFrameText, GetOwningPlayer(GetUnitSelected(GetLocalPlayer()))==GetOwningPlayer(newCaster) and (IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(newCaster)) or GetPlayerId(GetLocalPlayer())==10 or GetPlayerId(GetLocalPlayer())==11))
        endif
    endif
    if LoadReal(HH, GetHandleId(NewFrame), c_DURATION)<=0 then
        loop
            exitwhen i==0
            if LoadBoolean(HH,idp,i)==false then
            call SaveBoolean(HH,idp,i,true)
            call SaveBoolean(HH,idp,i+1,false)
            set j=i
            endif
            set i=i-1
        endloop
        call SetFrameRelativePoint( NewFrame, FRAMEPOINT_CENTER, StatusBarFrame, FRAMEPOINT_LEFT, 0.017+j*0.025, 0.005 )
        call SetFrameRelativePoint( NewFrameText, FRAMEPOINT_BOTTOM, NewFrame, FRAMEPOINT_BOTTOM, .0, -.01 )
        call SaveUnitHandle         (HH, id, c_CASTER, newCaster)
        call SaveUnitHandle         (HH, id, 30, newCasterOwner)
        call SaveReal               (HH, GetHandleId(NewFrame), c_DURATION, newDur)
        call SaveReal               (HH, GetHandleId(NewFrameText), c_DURATION, newDur)
        call SaveInteger            (HH, id, c_POSITION, j)
        call SaveInteger(HH,GetHandleId(NewFrame),SB_POS,0)
        call RemoveSavedString(HH,GetHandleId(NewFrame),SB_TXT)
        call SaveStr                (HH, id, c_NAME, newString)
        call TimerStart             (newTimer, 0.05, true, function CreateModeIndicatorWithPauseAizen_Periodic)
    else
        call SaveReal           (HH, GetHandleId(NewFrame), c_DURATION, newDur)
        call SaveReal           (HH, GetHandleId(NewFrameText), c_DURATION, newDur)
    endif
    set newTimer=null
    set p=null
    set NewFrame=null
    set NewFrameText=null
endfunction




///////////////////aizenUjapiend


















function AizenChoice_Act takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit caster=GetTriggerUnit()
local unit target=GetSpellTargetUnit()
local real x0=GetUnitX(caster)
local real y0=GetUnitY(caster)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local unit casterOriginal=Hero[GetPlayerId(GetOwningPlayer(caster))]//aizen

local real damage=0
local real facing=Angle2(x0,y0,x1,y1)
call SaveUnitHandle(HH,id,1,caster)
call SaveReal(HH,id,11,x1)
call SaveReal(HH,id,12,y1)
call SaveReal(HH,id,3,facing)
call SaveUnitHandle(HH,id,30,casterOriginal)





set aizen=casterOriginal
//AizenFstart
if GetSpellAbilityId()=='ASF1' then

if target==caster then
call UnitAddAbility(caster,'ASF2')
call UnitRemoveAbilityTimed(caster,'ASF2',1)
call SaveBoolean(HH,GetHandleId(caster),ANTITARGET_ABILITY,true)
call TimerStart(t,0.02,true,function AizenFBlockAct)
else

set target=null

//HogiokuQuestF1
if GetHeroAgi(casterOriginal,true)>=200 then

    if SR(x0,y0,x1,y1)>100 then
        call GroupClear(G)
        call GroupEnumUnitsInRange(G,x0,y0,150,Base)
        loop
            set n0=FirstOfGroup(G)
            exitwhen n0==null
            if GetUnitAbilityLevel(n0,'Avul')==0 and IsUnitEnemy(n0,GetOwningPlayer(caster))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false then
                set target=n0
                call UnitStop(n0)
                call GroupClear(G)
            endif
            call GroupRemoveUnit(G,n0)
        endloop
        call GroupClear(G)

        if SR(x0,y0,x1,y1)>200 and target==null then
            call GroupClear(G)
            call GroupEnumUnitsInRange(G,PolX(x0,150,facing),PolY(y0,150,facing),150,Base)
            loop
                set n0=FirstOfGroup(G)
                exitwhen n0==null
                if GetUnitAbilityLevel(n0,'Avul')==0 and IsUnitEnemy(n0,GetOwningPlayer(caster))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false then
                    set target=n0
                    call UnitStop(n0)
                    call GroupClear(G)
                endif
                call GroupRemoveUnit(G,n0)
            endloop
            call GroupClear(G)
        endif

        if SR(x0,y0,x1,y1)>300 and target==null then
            call GroupClear(G)
            call GroupEnumUnitsInRange(G,PolX(x0,300,facing),PolY(y0,300,facing),150,Base)
            loop
                set n0=FirstOfGroup(G)
                exitwhen n0==null
                if GetUnitAbilityLevel(n0,'Avul')==0 and IsUnitEnemy(n0,GetOwningPlayer(caster))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false then
                    set target=n0
                    call UnitStop(n0)
                    call GroupClear(G)
                endif
                call GroupRemoveUnit(G,n0)
            endloop
            call GroupClear(G)
        endif

        if SR(x0,y0,x1,y1)>450 and target==null then
            call GroupClear(G)
            call GroupEnumUnitsInRange(G,PolX(x0,450,facing),PolY(y0,450,facing),150,Base)
            loop
                set n0=FirstOfGroup(G)
                exitwhen n0==null
                if GetUnitAbilityLevel(n0,'Avul')==0 and IsUnitEnemy(n0,GetOwningPlayer(caster))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false then
                set target=n0
                call UnitStop(n0)
                call GroupClear(G)
                endif
                call GroupRemoveUnit(G,n0)
            endloop
            call GroupClear(G)
        endif

        if SR(x0,y0,x1,y1)>600 and target==null then
            call GroupClear(G)
            call GroupEnumUnitsInRange(G,PolX(x0,600,facing),PolY(y0,600,facing),150,Base)
            loop
                set n0=FirstOfGroup(G)
                exitwhen n0==null
                if GetUnitAbilityLevel(n0,'Avul')==0 and IsUnitEnemy(n0,GetOwningPlayer(caster))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false then
                set target=n0
                call UnitStop(n0)
                call GroupClear(G)
                endif
                call GroupRemoveUnit(G,n0)
            endloop
            call GroupClear(G)
        endif
        call SaveUnitHandle(HH,id,2,target)
    endif

    set damage=3*(20+GetHeroAgi(caster,true))

    if caster!=casterOriginal then
        set damage=damage*0.8
    endif

    call SaveReal(HH,id,15,damage)
endif
//HogiokuQuestF1End





//AizenFPoint
if target==null then

if SR(x0,y0,x1,y1)>800 then
call SaveReal(HH,id,11,PolX(GetUnitX(caster),800,facing))
call SaveReal(HH,id,12,PolY(GetUnitY(caster),800,facing))
endif

set soundplay=SndN(3921) // Sound\Music\mp3Music\AizenF.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set n0=CreateUnit(GetOwningPlayer(caster),'e200',x0,y0,facing)
call SetUnitModel(n0,"Aizen\\AZ_LCDark_W2_buff.mdl")
call UnitSize(n0,1.5,1,1)
call UnitSpeed(n0,1.5)
call UnitColor(n0,100,100,100,0)
call SetUnitFlyHeight(n0,100,0)
call MyRemoveUnit(n0,2)
call SaveUnitHandle(HH,id,20,n0)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',x0,y0,facing+90)
call SetUnitModel(n0,"Aizen\\AZ_LCDark_W2_buff.mdl")
call UnitSize(n0,1.5,1,1)
call UnitSpeed(n0,1.5)
call UnitColor(n0,100,100,100,0)
call SetUnitFlyHeight(n0,100,0)
call MyRemoveUnit(n0,2)
call SaveUnitHandle(HH,id,21,n0)
set n0=null
set n0=CreateUnit(GetOwningPlayer(caster),'e200',x0,y0,facing+180)
call SetUnitModel(n0,"Aizen\\AZ_LCDark_W2_buff.mdl")
call UnitSize(n0,1.5,1,1)
call UnitSpeed(n0,1.5)
call UnitColor(n0,100,100,100,0)
call SetUnitFlyHeight(n0,100,0)
call MyRemoveUnit(n0,2)
call SaveUnitHandle(HH,id,22,n0)
set n0=null
call TimerStart(t,0.02,true,function AizenFAct)
else
set soundplay=SndN(3921) // Sound\Music\mp3Music\AizenF.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set soundplay=SndN(3975) // Sound\Music\mp3Music\AizenFself1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.02,true,function AizenFTargetAct)
endif

//AizenFPoint











endif

endif

//AizenFend

//AizenGstart
if GetSpellAbilityId()=='ASG1' then
if caster!=casterOriginal then

//call StartAbilityCooldown(GetUnitAbility(casterOriginal, 'ASG1'), 30 )




endif
call SaveInteger(HH,GetHandleId(aizen),SH_AizenGI,3)

if GetUnitState(caster,UNIT_STATE_LIFE)>5000 then
call SaveInteger(HH,GetHandleId(aizen),SH_AizenGI,5)
call SaveReal(HH,id,14,3)
endif

set soundplay=SndN(3977) // Sound\Music\mp3Music\AizenG.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.02,true,function AizenGAct)
endif
//AizenGend


//AizenQstart

if GetSpellAbilityId()=='ASQ1' then

if FFAMode==false then
    if IsUnitAlly(casterOriginal,Player(0)) then
        if win[2]>4 then 
            call ChangeAbilityTime(caster,10,'ASQ1','ASQ2')
        endif
    else
        if win[1]>4 then 
            call ChangeAbilityTime(caster,10,'ASQ1','ASQ2')
        endif
    endif
else
    if win[GetPlayerId(GetOwningPlayer(caster))]<4+round then 
        call ChangeAbilityTime(caster,10,'ASQ1','ASQ2')
    endif
endif





if SR(x0,y0,x1,y1)<600 then
call EffectCreateAndMove(true,"Others\\BlackBlink1.mdl",facing,1,1,1,100,100,100,0,0,caster,0,facing)
call MoveAoe1(x1,y1,caster,-600,facing)
endif
set soundplay=SndN(3979) // Sound\Music\mp3Music\AizenQ1-1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set damage=50*GetUnitAbilityLevel(casterOriginal,'ASQ1')+(GetUnitAbilityLevel(casterOriginal,'ASQ1')+1)*GetHeroInt(caster,true)
if caster!=casterOriginal then
set damage=damage*0.8

  //call StartAbilityCooldown(GetUnitAbility(casterOriginal, 'ASQ1'), 23-GetUnitAbilityLevel(casterOriginal,'ASQ1') )




endif
call SaveReal(HH,id,15,damage)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',x0,y0,facing)
call SetUnitModel(n0,"Aizen\\LaxusRoar(afb).mdl")
call MoveUnit(caster,n0,100,facing)
call SetUnitAnimationByIndex(n0,1)
call UnitSize(n0,0.4,1,1)
call UnitSpeed(n0,0.85)
call UnitColor(n0,100,100,100,0)
call SetUnitFlyHeight(n0,100,0)
call MyRemoveUnit(n0,2)
set n0=null
set n0=CreateUnit(GetOwningPlayer(caster),'e200',x0,y0,facing)
call SetUnitAnimationByIndex(n0,1)
call UnitSize(n0,0.5,1,1)
call UnitSpeed(n0,1.75)
call UnitColor(n0,100,100,100,0)
call SetUnitFlyHeight(n0,100,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=null
call TimerStart(t,0.02,true,function AizenQAct)
endif

if GetSpellAbilityId()=='ASQ2' then
set soundplay=SndN(3981) // Sound\Music\mp3Music\AizenW2-2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set damage=3*(50+GetHeroInt(caster,true))
if caster!=casterOriginal then
set damage=damage*0.8
endif
call SaveReal(HH,id,15,damage)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',x0,y0,facing)
call SetUnitModel(n0,"Aizen\\File00001446.mdl")
call MoveUnit(caster,n0,100,facing)
call SetUnitAnimationByIndex(n0,1)
call UnitSize(n0,0.5,1,1)
call UnitSpeed(n0,0.75)
call UnitColor(n0,100,100,100,0)
call SetUnitFlyHeight(n0,100,0)
call MyRemoveUnit(n0,2)
set n0=null
set n0=CreateUnit(GetOwningPlayer(caster),'e200',x0,y0,facing)
call SetUnitAnimationByIndex(n0,1)
call UnitSize(n0,0.5,1,1)
call UnitSpeed(n0,1.75)
call UnitColor(n0,100,100,100,0)
call SetUnitFlyHeight(n0,100,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=null
call TimerStart(t,0.02,true,function AizenQ2Act)
endif
//AizenQend


//AizenWstart
if GetSpellAbilityId()=='ASW1' then

call SaveBoolean(HH,id,19,false)

if GetHeroLevel(casterOriginal)>=35 then
call SaveBoolean(HH,id,19,true)
endif

set soundplay=SndN(3983) // Sound\Music\mp3Music\AizenW1.mp3
