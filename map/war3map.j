    call SetFrameTextAlignment( OpenIdButtonText, TEXT_JUSTIFY_CENTER, TEXT_JUSTIFY_MIDDLE )
    call SetFrameTextColour( OpenIdButtonText, 0xFFFFA500 )
    call SetFrameParent( OpenIdButtonText, OpenIdButton )
