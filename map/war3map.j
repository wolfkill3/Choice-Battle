    call SetUnitFlyHeight(n,he+75,0)
    call UnitApplyTimedLife(n,'BTLF',0.7)
    call SetUnitTimeScale(n,1.5)
    call TimerStart(t,0.02,false,function EShikiNewTwoCast5)
