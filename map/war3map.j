endfunction
function Godspeed2Cast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local integer idu=GetHandleId(GetOwningPlayer(u))
local integer str=StringHash("lightwalk")
local integer str2=StringHash("distlightwalk")
local integer str3=StringHash("lightwalkcond")
local integer str4=StringHash("st")
local integer str5=StringHash("lightwalkcondgroup")
local integer str6=StringHash("lightdist")
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(HH,idu,str)
local real y1=LoadReal(HH,idu,str+1)
local real a=Atan2(y1-y,x1-x)
local real dist=LoadReal(HH,idu,str2)
local real dist2=LoadReal(HH,id,9)
local real speed=LoadReal(HH,idu,str4)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(HH,idu,str5)
local integer l__ide
local integer l__idg
local real dmg=GetHeroAgi(u,true)*2
local real dist10=0
if(OrderId2String(GetUnitCurrentOrder(u))=="move" or OrderId2String(GetUnitCurrentOrder(u))=="smart" or OrderId2String(GetUnitCurrentOrder(u))=="attack")and SR(x,y,x1,y1)>50+speed*0.001 and speed>30 and GetUnitAbilityLevel(u, 'CBC2')==0 and GetUnitAbilityLevel(u, 'CBC1')==0 and GetUnitAbilityLevel(u, 'cbc4')==0 and GetUnitAbilityLevel(u, 'cbc6')==0 and GetUnitAbilityLevel(u, 'cbc5')==0  and GetUnitAbilityLevel(u, 'cbc7')==0 and GetUnitAbilityLevel(u, 'cbc8')==0 and GetUnitAbilityLevel(u, 'cbc9')==0 and IsUnitPaused(u)==false then
set dist10=speed*0.034
if dist10<46 then
set x=x+dist10*(1+SpeedRes*0.01)*Cos(a)
set y=y+dist10*(1+SpeedRes*0.01)*Sin(a)
call SaveReal(HH,idu,str6,dist2+speed*0.0044)
else
set dist10=46
set x=x+dist10*(1+SpeedRes*0.01)*Cos(a)
set y=y+dist10*(1+SpeedRes*0.01)*Sin(a)
call SaveReal(HH,idu,str6,dist2+speed*0.0044)
endif
call SetUnitXY_1(u,x,y, false)
set n=CreateUnit(p,0x65305258,x,y,GetRandomReal(0,359))
call SetUnitTimeScale(n,3)
call UnitApplyTimedLife(n,1,0.13)
set n=CreateUnit(p,0x65305255,x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,0.13)
call SetUnitTimeScale(n,2)
call SetUnitVertexColor(n,255,255,255,50)
call SetUnitAnimation(n,"walk")
call SetUnitFacing(u,a*bj_RADTODEG)
call SaveReal(HH,idu,str2,dist+speed)
call SaveReal(HH,idu,str4,(speed-dist10*0.26)*0.9988)
if dist>speed*0.1 then
call SaveReal(HH,idu,str2,0)
endif
call GroupEnumUnitsInRange(g,x,y,100,Base)
set l__idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set l__ide=GetHandleId(E)
if Condition_Base(p,E)and E!=LoadUnitHandle(HH,l__idg,l__ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(HH,l__idg,l__ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
if IsTerrainPathable(GetUnitX(u),GetUnitY(u),PATHING_TYPE_FLYABILITY) then
call IssueImmediateOrder(u,"stop")
endif
else
call UnitRemoveAbility(u,0x41305556)
call UnitRemoveAbility(u,0x41305557)
call SaveBoolean(HH,idu,str3,false)
call PauseTimer(t)
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set g=null
set p=null
set u=null
set t=null
endfunction
function Godspeed2Cast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local real x=GetOrderPointX()
local real y=GetOrderPointY()
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local integer idu=GetHandleId(GetOwningPlayer(u))
local integer str=StringHash("lightwalk")
local integer str3=StringHash("lightwalkcond")
