call EffectCreateAndMove(true,EffectID[287],facing,1.5,1.5,1,100,100,100,50,0,Dummy,0,facing)
set time=10
call SaveReal(HH,id,5,10)
call UnitSize(Dummy,2,1,1)
endif
endif
if time>10 then
