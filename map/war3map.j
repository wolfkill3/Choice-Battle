function PickPreloadSystem takes unit u returns nothing
local trigger t
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(p)
local integer i=0
local integer id=0
local integer ty=GetUnitTypeId(u)
local boolean b=true
local boolean fe=true
loop
set id=LoadInteger(h2,ip,i)
exitwhen i>=100
if id==ty then
set b=false
endif
if(id==null or id==0)and fe then
call SaveInteger(h2,ip,i,ty)
set fe=false
endif
set i=i+1
endloop
if b and LoadInteger(h,ip,ty)!=1 then
call SaveInteger(h,ip,ty,1)
call PL_Hero(ty)
if ty=='H00I' then
set t=CreateTrigger()
call TriggerRegisterPlayerUnitEvent(t,p,EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
call TriggerAddCondition(t,Condition(function TransparentGiantHandCond))
call TriggerAddAction(t,function TransparentGiantHandCast)
