//===========================================================================
//========== Ichigo INT
//===========================================================================

//====== SHIKAI ICHIGO 

function IchigoCalculateBonusF takes unit newCaster, real newDamage returns real
        local real damage   = 1.0 + LoadReal(h, GetHandleId(newCaster), 1155)
        set damage = newDamage * damage
        call UnitRemoveAbility(newCaster, 'IchF')
        return damage
endfunction

function IchigoShikaiF_Duration takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id    = GetHandleId(newTimer)
    local unit caster   = LoadUnitHandle(h, id, 0)
    local real damage   = LoadReal(h, GetHandleId(caster), 1155)
    local real time     = LoadReal(h, id, 1)+0.05
        call SaveReal(h, id, 1, time)
    if time<=10 and UnitIsAlive(caster) and GetUnitAbilityLevel(caster, 'IchF')>0 and GetUnitTypeId(caster)=='HIc1' then
        //call SaveReal(h, GetHandleId(caster), 1155, damage-damage*0.1*0.05)
    else
        call RemoveEffect(LoadEffectHandle(h, id, 6), 1.0, true, CreateTimer())
        call UnitRemoveAbility(caster, 'IchF')
        call SaveReal(h, GetHandleId(caster), 1155, 0)
        call RemoveSavedReal(h, GetHandleId(caster), 1155)
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set newTimer=null
    set caster=null
endfunction

function IchigoShikaiF_Periodic takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id    = GetHandleId(newTimer)
    local unit caster   = LoadUnitHandle(h, id, 0)
    local real caster_x = GetUnitX(caster)
    local real caster_y = GetUnitY(caster)
    local real time     = LoadReal(h, id, 1)+0.05
        call SaveReal(h, id, 1, time)
    if time<10 and GetUnitCurrentOrder(caster) == OrderId("channel") then
                if GetWidgetMana(caster)<50 then
                        call IssueImmediateOrder(caster, "stop")
                else
                        call SetWidgetMana(caster, GetWidgetMana(caster)-GetWidgetMaxMana(caster)*0.02 *0.05)
                endif
        if time>1 then
            call HealTextTag(caster,caster,(GetWidgetMaxLife(caster)*0.020)*0.05*myCustomHeal2(caster,1),"HealthRes")
            call SetWidgetLife(caster, GetWidgetLife(caster)+(GetWidgetMaxLife(caster)*0.020)*0.05)
            call SetUnitScale(LoadUnitHandle(h, id, 7), 1.4+time/10, 1.4+time/10, 1.4+time/10)
        endif
                if time==5.0 then
            call RemoveUnit(LoadUnitHandle(h, id, 3))
                        set n=CreateUnit(GetOwningPlayer(caster), 'd063', caster_x, caster_y, GetRandomInt(0, 360))
                        call SetUnitFlyHeight(n, 5, 0)
                        call UnitScale(n, 0.5, 1.5, 3)
                        call SaveUnitHandle(h, id, 3, n)
        endif
                        
                if time>1 then
                        if LoadInteger(h, id, 5)<=0 then
                                set n=CreateUnit(GetOwningPlayer(caster), 'dM42', caster_x, caster_y, GetRandomInt(0, 360))
                                call SetUnitVertexColor(n, 255, 255, 255, 150)
                                call SetUnitFlyHeight(n, 5, 0)
                                call SetUnitScale(n, 1.5+time/20, 1.5+time/20, 1.5+time/20)
                                call MyRemoveUnit(n, 1.5)
                                if time>3 then
                                        set n=CreateUnit(GetOwningPlayer(caster), 'd003', caster_x, caster_y, GetRandomInt(0, 360))
                                        call SetUnitFlyHeight(n, 5, 0)
                                        call SetUnitScale(n, 1.5, 1.5, 1.5)
                                        call MyRemoveUnit(n, 1.5)
                                endif
                                if time>6 then
                                        set n=CreateUnit(GetOwningPlayer(caster), 'd003', caster_x, caster_y, GetRandomInt(0, 360))
                                        call SetUnitFlyHeight(n, 5, 0)
                                        call SetUnitScale(n, 2.5, 2.5, 2.5)
                                        call MyRemoveUnit(n, 1.5)
                                endif
                                call SaveInteger(h, id, 5, 3)
                        else
                                call SaveInteger(h, id, 5, LoadInteger(h, id, 5)-1)
                        endif
                endif
        call SetUnitX(LoadUnitHandle(h, id, 3), caster_x)
        call SetUnitY(LoadUnitHandle(h, id, 3), caster_y)
        call SetUnitX(LoadUnitHandle(h, id, 7), caster_x)
        call SetUnitY(LoadUnitHandle(h, id, 7), caster_y)
        call SaveReal(h, id, 2, LoadReal(h, id, 2)+0.025*0.05)
    else
        call KillUnit(LoadUnitHandle(h, id, 7))
        call MyRemoveUnit(LoadUnitHandle(h, id, 7), 1.5)
        call KillUnit(LoadUnitHandle(h, id, 3))
        call MyRemoveUnit(LoadUnitHandle(h, id, 3), 2)
        call UnitAddAbility(caster, 'IchF')
        call UnitMakeAbilityPermanent(caster, true, 'IchF')
        call SaveReal(h, GetHandleId(caster), 1155, LoadReal(h, id, 2))
        call SaveReal(h, id, 1, 0.0)
        call PauseTimer(newTimer)
        call TimerStart(newTimer, 0.05, true, function IchigoShikaiF_Duration)
    endif
    set caster=null
    set newTimer=null
endfunction

function IchigoShikaiF_Cast takes unit newCaster returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local real caster_x  = GetUnitX(newCaster)
    local real caster_y  = GetUnitY(newCaster)
    call SaveEffectHandle(h, id, 6, AddSpecialEffectTarget("kenpachiaura.mdl", newCaster, "origin"))
    set soundplay=SndN(4106) // Sound\war3mapImported\IchigoF.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd002', caster_x, caster_y, GetRandomInt(0, 360))
    call SetUnitFlyHeight(n, 50, 0)
    call SetUnitScale(n, 2, 2, 2)
    call SaveUnitHandle(h, id, 3, n)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd050', caster_x, caster_y, 0)
    call SetUnitFlyHeight(n, 5, 0)
    call SetUnitScale(n, 1.4, 1.4, 1.4)
    call SaveUnitHandle(h, id, 7, n)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(h, id, 1, 0)
    call SaveReal(h, id, 2, 0)
    call TimerStart(newTimer, 0.05, true, function IchigoShikaiF_Periodic)
    set newTimer=null
endfunction

function IchigoShikaiQ_Periodic takes nothing returns nothing
	local integer id = GetHandleId(GetExpiredTimer())
	local unit caster = LoadUnitHandle(h, id, 0)
	local real time   = LoadReal(h, id, 1)+0.1
	call SaveReal(h, id, 1, time)
	
	if time>5 or GetUnitAbilityLevel(caster, 'IcQ2')==0 then
		call ShowAbility2('IcQ1', true)
		call StartAbilityCooldown(GetUnitAbility(caster, 'IcQ1'), 16.0-GetUnitAbilityLevel(caster, 'IcQ2'))
		call UnitRemoveAbility(caster, 'IcQ2')
		call DestroyEffect(LoadEffectHandle(h, id, 3))
		call DestroyEffect(LoadEffectHandle(h, id, 4))
		call FlushChildHashtable(h, id)
		call PauseTimer(GetExpiredTimer())
		call DestroyTimer(GetExpiredTimer())
	endif
	
	set caster=null
endfunction

function IchigoShikaiQ_Cast takes unit newCaster returns nothing
	local timer newTimer = CreateTimer()
	local integer id = GetHandleId(newTimer)
	local real caster_x = GetUnitX(newCaster)
	local real caster_y = GetUnitY(newCaster)
		set soundplay=SndN(4108) // Sound\war3mapImported\IchigoQCounter.mp3
		call StartSound(soundplay)
		//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
	set n=CreateUnit(GetOwningPlayer(newCaster), 'd003', caster_x, caster_y, GetRandomInt(0, 360))
	call SetUnitScale(n, 2, 2, 2)
	call MyRemoveUnit(n, 1.5)
	set n=CreateUnit(GetOwningPlayer(newCaster), 'd001', caster_x, caster_y, GetRandomInt(0, 360))
	call MyRemoveUnit(n, 1.5)
	set n=CreateUnit(GetOwningPlayer(newCaster), 'd026', caster_x, caster_y, GetRandomInt(0, 360))
	call MyRemoveUnit(n, 0.5)
	call DestroyEffect(AddSpecialEffectTarget("AFB (1889).mdl", newCaster, "origin"))
	call ShowAbility2('IcQ1', false)
	call UnitAddAbility(newCaster, 'IcQ2')
	call SetUnitAbilityLevel(newCaster, 'IcQ2', GetUnitAbilityLevel(newCaster, 'IcQ1'))
	call UnitMakeAbilityPermanent(newCaster, true, 'IcQ2')
	
	call SaveUnitHandle(h, id, 0, newCaster)
	call SaveReal	   (h, id, 1, 0.0)
	call SaveEffectHandle(h, id, 3, AddSpecialEffectTarget("Abilities\\Weapons\\DragonHawkMissile\\DragonHawkMissile.mdl", newCaster, "hand right"))
	call SaveEffectHandle(h, id, 4, AddSpecialEffectTarget("Abilities\\Weapons\\DragonHawkMissile\\DragonHawkMissile.mdl", newCaster, "hand left"))
	call TimerStart(newTimer, 0.1, true, function IchigoShikaiQ_Periodic)
	
	set newTimer=null
endfunction

function IchigoShikaiQ1_Periodic takes nothing returns nothing
    local integer id = GetHandleId(GetExpiredTimer())
    local unit dummy = LoadUnitHandle(h, id, 3)
    local real dummy_x  = GetUnitX(dummy)
    local real dummy_y  = GetUnitY(dummy)
    local real angle    = LoadReal(h, id, 1)
    local real distance = LoadReal(h, id, 2)
    local real effect_period = LoadReal(h, id, 7)
    if distance<1750 then
        call SaveReal(h, id, 2, distance+50)
        call SetUnitX(dummy, dummy_x+50*Cos(angle))
        call SetUnitY(dummy, dummy_y+50*Sin(angle))
        call SetUnitX(LoadUnitHandle(h, id, 6), dummy_x+200*Cos(angle))
        call SetUnitY(LoadUnitHandle(h, id, 6), dummy_y+200*Sin(angle))
        call SetUnitX(LoadUnitHandle(h, id, 8), dummy_x+50*Cos(angle))
        call SetUnitY(LoadUnitHandle(h, id, 8), dummy_y+50*Sin(angle))
        set bjLCU=null
        set bjLCG=LoadGroupHandle(h, id, 4)
        call GroupEnumUnitsInRange(bjLCG, dummy_x, dummy_y, 175, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            if Condition_Base(GetOwningPlayer(dummy),E) then
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\Purge\\PurgeBuffTarget.mdl",E,"chest"))
                set n=CreateUnit(GetOwningPlayer(dummy), 'd018', GetUnitX(E), GetUnitY(E), angle*bj_RADTODEG)
                call MyRemoveUnit(n, 1.5)
                if bjLCU==null then
                    call ShakeCamera(0.1, 5)
                    call SaveReal(h, id, 2, 9999)
                    set bjLCU=E
                    call myCustomDamage(LoadUnitHandle(h, id, 0), E, LoadReal(h, id, 5)*1.25, false,false,null,null,null)
                    call Push3(E , 30 , angle , 125 , "")
                    call GroupClear(bjLCG)
                    call GroupEnumUnitsInRange(bjLCG, dummy_x+200*Cos(angle), dummy_y+200*Sin(angle), 300, Base)
                    set n=CreateUnit(GetOwningPlayer(dummy), 'd030', dummy_x+100*Cos(angle), dummy_y+100*Sin(angle), angle*bj_RADTODEG)
                    call UnitScale(n, 1.0, 1.5, 0.2)
                    call SetUnitFlyHeight(n, 170, 0)
                    call MyRemoveUnit(n, 1.5)
                    set n=CreateUnit(GetOwningPlayer(dummy), 'd030', dummy_x+100*Cos(angle), dummy_y+100*Sin(angle), angle*bj_RADTODEG+45)
                    call UnitScale(n, 1.0, 1.5, 0.2)
                    call SetUnitFlyHeight(n, 170, 0)
                    call MyRemoveUnit(n, 1.5)
                    set n=CreateUnit(GetOwningPlayer(dummy), 'd030', dummy_x+100*Cos(angle), dummy_y+100*Sin(angle), angle*bj_RADTODEG-45)
                    call UnitScale(n, 1.0, 1.5, 0.2)
                    call SetUnitFlyHeight(n, 170, 0)
                    call MyRemoveUnit(n, 1.5)
                    set n=CreateUnit(GetOwningPlayer(dummy), 'd030', dummy_x+150*Cos(angle), dummy_y+150*Sin(angle), angle*bj_RADTODEG)
                    call UnitScale(n, 1.0, 2.0, 0.2)
                    call SetUnitFlyHeight(n, 170, 0)
                    call MyRemoveUnit(n, 1.5)
                    set n=CreateUnit(GetOwningPlayer(dummy), 'd031', dummy_x+150*Cos(angle), dummy_y+150*Sin(angle), angle*bj_RADTODEG)
                    call UnitScale(n, 0.8, 1.3, 0.35)
                    call SetUnitFlyHeight(n, 170, 0)
                    call MyRemoveUnit(n, 1.5)
                else
                    call myCustomDamage(LoadUnitHandle(h, id, 0), E, LoadReal(h, id, 5)*0.75, false,false,null,null,null)
                endif
            endif
            call GroupRemoveUnit(bjLCG, E)
        endloop
        if effect_period<=0 then
            set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, 0)), 'd025', dummy_x+200*Cos(angle), dummy_y+200*Sin(angle), angle*bj_RADTODEG)
            call SetUnitScale(n, 1.5, 1.5, 1.5)
            call MyRemoveUnit(n, 1.5)
            call SaveReal(h, id, 7, 6)
        else
            call SaveReal(h, id, 7, effect_period-1)
        endif
    else
        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, 0)), 'd003', dummy_x+200*Cos(angle), dummy_y+200*Sin(angle), angle*bj_RADTODEG)
        call SetUnitTimeScale(n, 0.7)
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call MyRemoveUnit(n, 1.0)
        call KillUnit(dummy)
        call KillUnit(LoadUnitHandle(h, id, 6))
        call KillUnit(LoadUnitHandle(h, id, 8))
        call MyRemoveUnit(dummy, 0.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, 6), 0.1)
        call MyRemoveUnit(LoadUnitHandle(h, id, 8), 1.5)
        call DestroyGroup(LoadGroupHandle(h, id, 4))
        call FlushChildHashtable(h, id)
        call PauseTimer(GetExpiredTimer())
        call DestroyTimer(GetExpiredTimer())
    endif
    set dummy=null
endfunction

function IchigoShikaiQ1_WaitTime takes nothing returns nothing
    local integer id = GetHandleId(GetExpiredTimer())
    local unit caster = LoadUnitHandle(h, id, 0)
    local real caster_x = GetUnitX(caster)
    local real caster_y = GetUnitY(caster)
    local real angle    = LoadReal(h, id, 1)
    call PauseUnit(caster, false)
    set n=CreateUnit(GetOwningPlayer(caster), 'dM04', caster_x, caster_y, angle*bj_RADTODEG)
    call SetUnitTimeScale(n, 0.7)
    //call SetUnitScale(n, 1.2, 1.2, 1.2)
    call SetUnitFlyHeight(n, 150, 0)
    call MyRemoveUnit(n, 1.5)
    call PauseTimer(GetExpiredTimer())
    call TimerStart(GetExpiredTimer(), 0.02, true, function IchigoShikaiQ1_Periodic)
    set caster=null
endfunction

function IchigoShikaiQ1_Cast takes unit newCaster, real point_x, real point_y returns nothing
    local timer newTimer = CreateTimer()
    local integer id = GetHandleId(newTimer)
    local real caster_x = GetUnitX(newCaster)
    local real caster_y = GetUnitY(newCaster)
    local real angle    = AP(caster_x, caster_y, point_x, point_y)
    local real damage   = 150+GetHeroStr(newCaster, true)*(GetUnitAbilityLevel(newCaster, 'IcQ2')+1)
    set soundplay=SndN(4110) // Sound\war3mapImported\IchigoQ.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call PauseUnit(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, 1)
        call UnitRemoveAbility(newCaster, 'IcQ2')
   // call RemoveEffect(AddSpecialEffectTarget("bibangblue.mdl", newCaster, "hand left"), 1.5, false, CreateTimer())
    //set n=CreateUnit(GetOwningPlayer(newCaster), 'd030', caster_x, caster_y, angle*bj_RADTODEG)
    //call SetUnitScale(n, 2, 2, 2)
    //call SetUnitFlyHeight(n, 170, 0)
    //call MyRemoveUnit(n, 1.6)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd029', caster_x, caster_y, angle*bj_RADTODEG)
    call UnitScale(n, 0.1, 1.0, 0.5)
    call SaveUnitHandle(h, id, 8, n)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd003', caster_x, caster_y, angle*bj_RADTODEG)
    call SetUnitTimeScale(n, 0.7)
    call SetUnitScale(n, 1.2, 1.2, 1.2)
    call MyRemoveUnit(n, 1.5)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd029', caster_x, caster_y, angle*bj_RADTODEG)
    call UnitScale(n, 0.2, 2.0, 0.5)
    call SaveUnitHandle(h, id, 3, n)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd026', caster_x, caster_y, angle*bj_RADTODEG)
    call UnitScale(n, 0.5, 1.5, 0.5)
    //call SetUnitFlyHeight(n, 150, 0)
    call SaveUnitHandle(h, id, 6, n)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(h, id, 1, angle)
    call SaveReal(h, id, 2, 0)
    call SaveReal(h, id, 5, IchigoCalculateBonusF(newCaster, damage))
    call SaveGroupHandle(h, id, 4, CreateGroup())
    call SaveReal(h, id, 7, 0)
    call TimerStart(newTimer, 0.2, false, function IchigoShikaiQ1_WaitTime)
    set newTimer=null
endfunction

function IchigoShikaiW_Periodic takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=LoadReal(h,id,2)
    local real y1=LoadReal(h,id,3)
    local real f=GetUnitFacing(u)
    local player p=GetOwningPlayer(u)
    local real dmg=LoadReal(h, id, 5)
    local real dist=SquareRootPoint(x,y,x1,y1)
    local real a=Atan2(y1-y,x1-x)
    local real he=0
    local real dist2=LoadReal(h,id,100)
    if dist2>50.00 and udg_B==true and GetUnitAbilityLevel(u,'A1BL')==0 then
        call SaveReal(h,id,100,dist2-43)
        call SetUnitXY_1(u,x+43*Cos(a),y+43*Sin(a), true)
        call SetUnitFacing(u,a*bj_RADTODEG)
        set he=ParabolaZ(400,LoadReal(h,id,4),dist)
        call SetUnitFlyHeight(u,he,0)
        call SetUnitAnimation(u,"attack")
    else
        call ShakeCamera(0.1, 10)
        set bjLCG=LoadGroupHandle(h, id, 99)
        call GroupEnumUnitsInRange(bjLCG,x1,y1,300,Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
        if Condition_Base(p,E)then
            call UnitAddAbility(E, 'Arav')
            call UnitRemoveAbility(E, 'Arav')
            //call Push(E,30,Atan2(GetUnitY(E)-y1,GetUnitX(E)-x1),300)
            call myCustomDamage(u,E,dmg,false,false,null,null,null)
            call SetControlToUnit(u,E, 1.5, "stun")
            call MissleMoveParabola(E,12,0,GetUnitX(E)+500*Cos(Atan2(GetUnitY(E)-y,GetUnitX(E)-x)),GetUnitY(E)+500*Sin(Atan2(GetUnitY(E)-y,GetUnitX(E)-x)),400,u)
        endif
        call GroupRemoveUnit(bjLCG,E)
        endloop
        call DestroyGroup(LoadGroupHandle(h, id, 99))
        call PauseUnit(u,false)
        call SetUnitInvulnerable(u,false)
        call SetUnitFlyHeight(u,0,0)
        call SetUnitTimeScale(u,1)
        set n=CreateUnit(GetOwningPlayer(u), 'd001', x1,y1, GetRandomInt(0, 360))
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call SetUnitFlyHeight(n, 20, 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(u), 'd003', x1,y1, GetRandomInt(0, 360))
        call SetUnitScale(n, 2, 2, 2)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(u), 'd003', x1,y1, GetRandomInt(0, 360))
        call SetUnitScale(n, 2, 2, 2)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(u), 'd032', x1,y1, GetRandomInt(0, 360))
        call SetUnitScale(n, 2.5, 2.5, 2.5)
        call SetUnitFlyHeight(n, 200, 0)
        call MyRemoveUnit(n, 1.5)
        
        set n=CreateUnit(GetOwningPlayer(u), 'd033', x1,y1, GetRandomInt(0, 360))
        call UnitScale(n, 0.5, 1.0, 0.2)
        call SetUnitFlyHeight(n, 5, 0)
        call UnitApplyTimedLife(n,'BTLF', 1.5)
        call MyRemoveUnit(n, 2.5)
        call SetUnitVertexColor(u, 255, 255, 255, 255)
        call DestroyEffect(LoadEffectHandle(h, id, 97))
        call DestroyEffect(LoadEffectHandle(h, id, 98))
        call FlushChildHashtable(h,id)
        call PauseTimer(t)
        call DestroyTimer(t)
    endif
    set u=null
    set t=null
    set p=null
endfunction

function IchigoShikaiW_Cast takes unit newCaster, real point_x, real point_y returns nothing
    local timer newTimer=CreateTimer()
    local integer id=GetHandleId(newTimer)
    local real f=GetUnitFacing(newCaster)
    local real x=GetUnitX(newCaster)
    local real y=GetUnitY(newCaster)
    local real x1=point_x
    local real y1=point_y
        local real damage=GetHeroStr(newCaster,true)*(GetUnitAbilityLevel(newCaster,'IcW1')+2)
                set soundplay=SndN(4112) // Sound\war3mapImported\IchigoW.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                
    call DestroyEffect(AddSpecialEffect("war3mapImported\\TealSlam.mdl",x,y))
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM30', x, y, GetRandomInt(0, 360))
    call SetUnitScale(n, 1.2, 1.2, 1.2)
    call MyRemoveUnit(n, 1.5)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM29', x, y, GetRandomInt(0, 360))
    call SetUnitScale(n, 2, 2, 2)
    call MyRemoveUnit(n, 1.5)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM29', x, y, GetRandomInt(0, 360))
    call MyRemoveUnit(n, 1.5)
    
    call SetUnitTimeScale(newCaster,4)
    call PauseUnit(newCaster,true)
    call UnitAddAbility(newCaster,'Arav')
    call UnitRemoveAbility(newCaster,'Arav')
    call SetUnitVertexColor(newCaster, 255, 255, 255, 150)
    call SaveUnitHandle(h,id,0,newCaster)
    call SetUnitInvulnerable(newCaster,true)
    call SaveReal(h,id,2,point_x)
    call SaveReal(h,id,3,point_y)
    call SaveReal(h,id,4,SquareRootPoint(x,y,point_x,point_y))
    call SaveReal(h,id,5,IchigoCalculateBonusF(newCaster, damage))
    call SaveEffectHandle(h, id, 97, AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl", newCaster, "hand right"))
    call SaveEffectHandle(h, id, 98, AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl", newCaster, "hand left"))
    call SaveGroupHandle(h, id, 99, CreateGroup())
    call SaveReal(h,id,100,SquareRootPoint(x,y,point_x,point_y))
    call TimerStart(newTimer,0.02,true,function IchigoShikaiW_Periodic)
    set newCaster=null
    set newTimer=null
endfunction



function IchigoShikaiE_Periodic2 takes nothing returns nothing
    local timer newTimer=GetExpiredTimer()
    local integer id = GetHandleId(newTimer)
    local unit caster = LoadUnitHandle(h, id, 0)
    local unit target = LoadUnitHandle(h, id, 1)
    local real angle  = LoadReal(h, id, 4)
    local real time   = LoadReal(h, id, 5)
    call SaveReal(h, id, 5, time+0.02)
	if time<1.7 then
		if time<1.0 then
			call SetUnitX(target, GetUnitX(target)+20*Cos(angle))
			call SetUnitY(target, GetUnitY(target)+20*Sin(angle))
			call SetUnitFlyHeight(target, GetUnitFlyHeight(target)+15, 0)
			call PauseUnit(target,true)
            call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
			call SetUnitInvulnerable(target, true)
		endif
		
		if time==1.0 then
			set n=CreateUnit(GetOwningPlayer(caster), 'd042', GetUnitX(caster), GetUnitY(caster), 0)
			call SetUnitFlyHeight(n, GetUnitFlyHeight(caster), 0)
			call MyRemoveUnit(n, 1.5)
			call SetUnitX(caster, GetUnitX(target)+150*Cos(angle))
			call SetUnitY(caster, GetUnitY(target)+150*Sin(angle))
			call SetUnitFlyHeight(caster, GetUnitFlyHeight(target), 0)
			call SetUnitAnimationByIndex(caster, 1)
			set n=CreateUnit(GetOwningPlayer(caster), 'd042', GetUnitX(caster), GetUnitY(caster), 0)
			call SetUnitFlyHeight(n, GetUnitFlyHeight(caster), 0)
			call MyRemoveUnit(n, 1.5)
		endif
		
		if time==1.5 then
			set n=CreateUnit(GetOwningPlayer(caster), 'd052', GetUnitX(target), GetUnitY(target), 0)
			call SetUnitFlyHeight(n, GetUnitFlyHeight(target), 0)
			call SetUnitScale(n, 3, 3, 3)
			call MyRemoveUnit(n, 1.5)
			set n=CreateUnit(GetOwningPlayer(caster), 'd032', GetUnitX(target), GetUnitY(target), 0)
			call SetUnitFlyHeight(n, GetUnitFlyHeight(target), 0)
			call SetUnitScale(n, 3, 3, 3)
			call MyRemoveUnit(n, 1.5)
			call SetUnitFlyHeight(target, 0, 3000)
		endif
	else
		call SetUnitFlyHeight(caster, 0, 0)
		call SetUnitFlyHeight(target, 0, 0)
		call PauseUnit(caster, false)
		call SetUnitInvulnerable(caster, false)
		call PauseUnit(target,false)
        call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
		call SetUnitInvulnerable(target, false)
        call UnitRemoveAbility(target, 'A1BL')
		call myCustomDamage(caster,target,LoadReal(h, id, 2),false,false,null,null,null)
		call SetControlToUnit(caster,target, 1, "stun")
		
		set n=CreateUnit(GetOwningPlayer(caster), 'd001', GetUnitX(target),GetUnitY(target), GetRandomInt(0, 360))
		call SetUnitScale(n, 1.5, 1.5, 1.5)
		call SetUnitFlyHeight(n, 20, 0)
		call MyRemoveUnit(n, 1.5)
		set n=CreateUnit(GetOwningPlayer(caster), 'd003', GetUnitX(target),GetUnitY(target), GetRandomInt(0, 360))
		call SetUnitScale(n, 2, 2, 2)
		call MyRemoveUnit(n, 1.5)
		set n=CreateUnit(GetOwningPlayer(caster), 'd003', GetUnitX(target),GetUnitY(target), GetRandomInt(0, 360))
		call SetUnitScale(n, 2, 2, 2)
		call MyRemoveUnit(n, 1.5)
		set n=CreateUnit(GetOwningPlayer(caster), 'd032', GetUnitX(target),GetUnitY(target), GetRandomInt(0, 360))
		call SetUnitScale(n, 2.5, 2.5, 2.5)
		call SetUnitFlyHeight(n, 200, 0)
		call MyRemoveUnit(n, 1.5)
		set n=CreateUnit(GetOwningPlayer(caster), 'd069', GetUnitX(target),GetUnitY(target), GetRandomInt(0, 360))
		call SetUnitScale(n, 1.5, 1.5, 1.5)
		call SetUnitFlyHeight(n, 5, 0)
		call MyRemoveUnit(n, 1.5)
		
		set n=CreateUnit(GetOwningPlayer(caster), 'd033', GetUnitX(target),GetUnitY(target), GetRandomInt(0, 360))
		call UnitScale(n, 0.5, 1.0, 0.2)
		call SetUnitFlyHeight(n, 5, 0)
		call UnitApplyTimedLife(n,'BTLF', 1.5)
		call MyRemoveUnit(n, 2.5)
		call FlushChildHashtable(h, id)
        call PauseTimer(newTimer)
        call DestroyTimer(newTimer)
        endif
    set newTimer=null
    set caster=null
    set target=null
endfunction

function IchigoShikaiE_Periodic1 takes nothing returns nothing
    local timer newTimer=GetExpiredTimer()
    local integer id = GetHandleId(newTimer)
    local unit caster = LoadUnitHandle(h, id, 0)
    local unit target = LoadUnitHandle(h, id, 1)
    local real angle  = AU(caster, target)
    local integer eff_period = LoadInteger(h, id, 3)
    if UnitIsAlive(target)==false then
        call SetUnitVertexColor(caster, 255, 255, 255, 255)
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    else
        if SquareRootUnit(caster, target)>105 then
            call SetUnitX(caster, GetUnitX(caster)+55*Cos(angle))
            call SetUnitY(caster, GetUnitY(caster)+55*Sin(angle))
            if eff_period<=0 then
                set n=CreateUnit(GetOwningPlayer(caster), 'dR45', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
                call MyRemoveUnit(n, 1.5)
                call SaveInteger(h, id, 3, 1)
            else
                call SaveInteger(h, id, 3, eff_period-1)
            endif
        else
            if LoadBoolean(HH,GetHandleId(target),ANTITARGET_ABILITY)==false then
                set n=CreateUnit(GetOwningPlayer(caster), 'dH18', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
                call MyRemoveUnit(n, 1.5)
                call SetUnitVertexColor(caster, 255, 255, 255, 255)
                call SetUnitX(caster, GetUnitX(target)-150*Cos(angle))
                call SetUnitY(caster, GetUnitY(target)-150*Sin(angle))
                call SetUnitAnimationByIndex(caster, 13)
                call PauseUnit(target,true)
                call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
                call SetUnitInvulnerable(target, true)
                call UnitAddAbility(target, 'A1BL')
                call UnitAddAbility(target, 'Arav')
                call UnitRemoveAbility(target, 'Arav')
                call UnitAddAbility(caster, 'Arav')
                call UnitRemoveAbility(caster, 'Arav')
                call SaveReal(h, id, 4, angle-180*bj_DEGTORAD)
                set soundplay=SndN(4114) // Sound\war3mapImported\IchigoE2.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                call PauseTimer(newTimer)
                call TimerStart(newTimer, 0.02, true, function IchigoShikaiE_Periodic2)
            else
                call SetUnitVertexColor(caster, 255, 255, 255, 255)
                call SetUnitFlyHeight(caster, 0, 0)
		        call SetUnitFlyHeight(target, 0, 0)
                call PauseUnit(caster,false)
                call SaveUnitHandle(HH,GetHandleId(target),REVERSE_TARGET,caster)
                call SetUnitInvulnerable(caster,false)
                call FlushChildHashtable(h,id)
                call DestroyTimer(newTimer)
            endif
        endif
    endif
    set newTimer=null
    set caster=null
    set target=null
endfunction

function IchigoShikaiE_Cast takes unit newCaster, unit newTarget returns nothing
    local timer newTimer = CreateTimer()
    local integer id = GetHandleId(newTimer)
    local real caster_x = GetUnitX(newCaster)
    local real caster_y = GetUnitY(newCaster)
    local real angle    = AU(newCaster, newTarget)
    local real damage   = GetHeroStr(newCaster, true)*GetUnitAbilityLevel(newCaster, 'IcE1') + (GetWidgetMaxLife(newTarget)-GetWidgetLife(newTarget))*0.2
    set soundplay=SndN(4117) // Sound\war3mapImported\IchigoE1.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dR42', caster_x, caster_y, angle*bj_RADTODEG)
    call SetUnitTimeScale(n, 0.7)
    call MyRemoveUnit(n, 1.5)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd014', caster_x, caster_y, angle*bj_RADTODEG)
    call MyRemoveUnit(n, 1.5)
    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
    call SetUnitVertexColor(newCaster, 255, 255, 255, 150)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveUnitHandle(h, id, 1, newTarget)
    call SaveReal(h, id, 2, IchigoCalculateBonusF(newCaster, damage))
    call SaveInteger(h, id, 3, 10)
    call TimerStart(newTimer, 0.02, true, function IchigoShikaiE_Periodic1)
    set newTimer=null
endfunction

function IchigoShikaiR_Periodic2 takes nothing returns nothing
    local integer id     = GetHandleId(GetExpiredTimer())
    local unit skillshot = LoadUnitHandle(h, id, 3)
    local real angle     = LoadReal(h, id, 7)
    local real point_x   = GetUnitX(skillshot)+50*Cos(angle)
    local real point_y   = GetUnitY(skillshot)+50*Sin(angle)
    local real distance  = LoadReal(h, id, 5)
    local integer effect_period=LoadInteger(h, id, 15)
    if distance>0 then
        call SetUnitX(skillshot, point_x)
        call SetUnitY(skillshot, point_y)
        call SetUnitX(LoadUnitHandle(h, id, 11), point_x)
        call SetUnitY(LoadUnitHandle(h, id, 11), point_y)
        call SetUnitX(LoadUnitHandle(h, id, 12), point_x)
        call SetUnitY(LoadUnitHandle(h, id, 12), point_y)
        call SetUnitX(LoadUnitHandle(h, id, 13), point_x+550*Cos(angle))
        call SetUnitY(LoadUnitHandle(h, id, 13), point_y+550*Sin(angle))
        call SaveReal(h, id, 5, distance-50)
        set bjLCG = LoadGroupHandle(h, id, 4)
        call GroupEnumUnitsInRange(bjLCG, point_x, point_y, 300, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            if Condition_Base(GetOwningPlayer(skillshot), E) and IsUnitInGroup(E, LoadGroupHandle(h, id, 6))==false then
                call GroupAddUnit(LoadGroupHandle(h, id, 6), E)
                call myCustomDamage(LoadUnitHandle(h, id, 0), E, LoadReal(h, id, 1), false,false,null,null,null)
                call Push3(E , 10+LoadReal(h, id, 1)*0.025 , angle , LoadReal(h, id, 1)*0.8, "")
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\Purge\\PurgeBuffTarget.mdl",E,"chest"))
                call SlowUnit(E,E,0.9,0,5,2,false)
            endif
            call GroupRemoveUnit(bjLCG, E)
        endloop
        if effect_period<=0 then
            set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, 0)), 'd025', point_x+250*Cos(angle), point_y+250*Sin(angle), angle*bj_RADTODEG)
            call SetUnitScale(n, 1.8, 1.8, 1.8)
            call MyRemoveUnit(n, 1.5)
            set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, 0)), 'd029', point_x+250*Cos(angle), point_y+250*Sin(angle), angle*bj_RADTODEG)
            call UnitScale(n, 0.5, 1.0+(4000-distance)/1250, 0.2)
            call SetUnitVertexColor(n, 255, 255, 255, 185)
            call UnitApplyTimedLife(n,'BTLF', 1.0)
            call MyRemoveUnit(n, 1.5)
            call SaveInteger(h, id, 15, 3)
        else
            call SaveInteger(h, id, 15, effect_period-1)
        endif
    else
        call KillUnit(LoadUnitHandle(h, id, 12))
        call KillUnit(LoadUnitHandle(h, id, 13))
        call RemoveUnit(skillshot)
        call RemoveUnit(LoadUnitHandle(h, id, 11))
        call MyRemoveUnit(LoadUnitHandle(h, id, 12), 0.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, 13), 1.5)
        call DestroyGroup(LoadGroupHandle(h, id, 4))
        call DestroyGroup(LoadGroupHandle(h, id, 6))
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set skillshot = null
endfunction

function IchigoShikaiR_StopOrders2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    call IssueImmediateOrder(u,"stop")
    call SetUnitFacing(u,Atan2(LoadReal(h,id,1)-GetUnitY(u),LoadReal(h,id,2)-GetUnitX(u))*bj_RADTODEG)
    call FlushChildHashtable(h,id)
    call DestroyTimer(t)
    set t=null
    set u=null
endfunction

function IchigoShikaiR_StopOrders takes nothing returns nothing
    local unit u=GetOrderedUnit()
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    call SaveUnitHandle(h,id,0,u)
    if GetOrderTargetUnit()==null then
    call SaveReal(h,id,2,GetOrderPointX())
    call SaveReal(h,id,1,GetOrderPointY())
    else
    call SaveReal(h,id,2,GetUnitX(GetOrderTargetUnit()))
    call SaveReal(h,id,1,GetUnitY(GetOrderTargetUnit()))
    endif
    //call SetUnitAnimation(u,"Spell Channel One")
    call TimerStart(t,0.001,false,function IchigoShikaiR_StopOrders2)
    set u=null
    set t=null
endfunction

function IchigoShikaiR_WaitTime takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id = GetHandleId(newTimer)
    local unit caster = LoadUnitHandle(h, id, 0)
    local real angle  = LoadReal(h, id, 7)
        call ShakeCamera(0.1, 10)
        set n=CreateUnit(GetOwningPlayer(caster), 'd027', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG)
        call SetUnitVertexColor(n, 255, 255, 255, 150)
        call UnitScale(n, 0.01, 2.5, 1.5)
        call SaveUnitHandle (h, id, 13, n)
        set n=CreateUnit(GetOwningPlayer(caster), 'd003', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG)
        call SetUnitTimeScale(n, 0.7)
        call SetUnitScale(n, 2.6, 2.6, 2.6)
        call MyRemoveUnit(n, 1.5)
    call SetUnitInvulnerable(caster, false)
    call PauseUnit(caster, false)
    call PauseTimer(newTimer)
    call TimerStart(newTimer, 0.02, true, function IchigoShikaiR_Periodic2)
    set newTimer=null
    set caster=null
endfunction

function IchigoShikaiR_Periodic1 takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id  = GetHandleId(newTimer)
    local unit caster = LoadUnitHandle(h, id, 0)
    local real time   = LoadReal(h, id, 2)+0.05
    local real angle  = GetUnitFacing(caster)*bj_DEGTORAD
    local integer eff_period = LoadInteger(h, id, 15)
    local trigger tt=LoadTriggerHandle(h,id,10)
    if time<1.7 and UnitIsAlive(caster) then
        call SaveReal(h, id, 2, time)
        call SetUnitInvulnerable(caster,true)
        call SetControlToUnit(caster,caster,0.11,"doomdebug")
        if eff_period<=0 then
            call SetUnitX(LoadUnitHandle(h, id, 12), GetUnitX(caster))
            call SetUnitY(LoadUnitHandle(h, id, 12), GetUnitY(caster))
            set n=CreateUnit(GetOwningPlayer(caster), 'dM42', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
            call SetUnitScale(n, 1.0+time*0.4, 1.0+time*0.4, 1.0+time*0.4)
            call SetUnitVertexColor(n, 0, 155, 255, 150)
            call SetUnitTimeScale(n, 0.8)
            call SetUnitFlyHeight(n, 25, 0)
            call MyRemoveUnit(n, 1.5)
            set n=CreateUnit(GetOwningPlayer(caster), 'dM30', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
            call SetUnitScale(n, 0.8+time*0.4, 0.8+time*0.4, 0.8+time*0.4)
            call SetUnitVertexColor(n, 255, 255, 255, 150)
            call SetUnitFlyHeight(n, 40, 0)
            call MyRemoveUnit(n, 1.5)
            call SaveInteger(h, id, 15, 2)
        else
            call SaveInteger(h, id, 15, eff_period-1)
        endif
        if time==0.5 or time==1.0 then
            call RemoveEffect(AddSpecialEffectTarget("supershinythingyhg23.mdl", caster, "weapon"), 1.0, true, CreateTimer())
        endif
    elseif UnitIsAlive(caster) then
        call UnitRemoveAbility(caster,'A1FU')
        call UnitRemoveAbility(caster,'Pet1')
        call UnitRemoveAbility(caster,'B00A')
        call SetUnitAcquireRange(caster,600)
        call TriggerClearActions(tt)
        call DestroyTrigger(tt)
        call SaveInteger(h, id, 15, 0)
        call PauseTimer(newTimer)
        call SetUnitInvulnerable(caster, true)
        call PauseUnit(caster, true)
        call SetUnitAnimationByIndex(caster, 1)
        set n=CreateUnit(GetOwningPlayer(caster), 'd024', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG)
        call SetUnitFlyHeight(n, 150, 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'd024', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG)
        call SetUnitFlyHeight(n, 140, 0)
        call SetUnitTimeScale(n, 0.8)
        call UnitScale(n, 1, 4.5, 0.5)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'd064', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG)
        call SetUnitVertexColor(n, 255, 255, 255, 255)
        call UnitScale(n, 0.5, 3.5, 1.5)
        call SaveUnitHandle (h, id, 3, n)
        set n=CreateUnit(GetOwningPlayer(caster), 'd064', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG) 
        call SetUnitVertexColor(n, 255, 255, 255, 255)
        call UnitScale(n, 0.5, 3.5, 1.5)
        call SaveUnitHandle (h, id, 11, n)
        call SetUnitFlyHeight(LoadUnitHandle(h, id, 12), 25, 0)
        call SaveGroupHandle(h, id, 4, CreateGroup())
        call SaveReal       (h, id, 5, 4000)
        call SaveGroupHandle(h, id, 6, CreateGroup())
        call SaveReal       (h, id, 7, angle)
        call TimerStart(newTimer, 0.3, false, function IchigoShikaiR_WaitTime)
    else        // Ичиго помер
        call UnitRemoveAbility(caster,'A1FU')
        call UnitRemoveAbility(caster,'Pet1')
        call UnitRemoveAbility(caster,'B00A')
        call SetUnitAcquireRange(caster,600)
        call TriggerClearActions(tt)
        call DestroyTrigger(tt)
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set caster=null
    set newTimer=null
    set tt=null
endfunction

function IchigoShikaiR_Cast takes unit newCaster, real point_x, real point_y returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local real caster_x  = GetUnitX(newCaster)
    local real caster_y  = GetUnitY(newCaster)
    local real angle     = AP(caster_x, caster_y, point_x, point_y)
    local real damage    = (4+GetUnitAbilityLevel(newCaster, 'IcR1'))*GetHeroStr(newCaster, true)
    local trigger tt=CreateTrigger()
                set soundplay=SndN(4119) // Sound\war3mapImported\IchigoR.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set n=CreateUnit(GetOwningPlayer(newCaster), 'd003', caster_x, caster_y, angle*bj_RADTODEG)
    call SetUnitTimeScale(n, 0.7)
    call SetUnitScale(n, 1.6, 1.6, 1.6)
    call MyRemoveUnit(n, 1.5)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM32', caster_x, caster_y, angle*bj_RADTODEG)
    call SetUnitScale(n, 2, 2, 2)
    call SetUnitVertexColor(n, 255, 255, 255, 80)
    call UnitApplyTimedLife(n,'BTLF', 3)
    call MyRemoveUnit(n, 4)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd026', GetUnitX(newCaster), GetUnitY(newCaster), angle*bj_RADTODEG)
        call UnitScale(n, 0.1, 3, 2.5)
        call SetUnitFlyHeight(n, 200, 0)
        call SaveUnitHandle (h, id, 12, n)
    call RemoveEffect(AddSpecialEffectTarget("supershinythingyhg23.mdl", newCaster, "weapon"), 1.0, true, CreateTimer())
    call UnitAddAbility(newCaster,'A1FU')
    call UnitAddAbility(newCaster,'Pet1')
    call SetUnitAcquireRange(newCaster,51)
    call SaveTriggerHandle(h,id,10,tt)
    call TriggerRegisterUnitEvent(tt,newCaster,EVENT_UNIT_ISSUED_TARGET_ORDER)
    call TriggerRegisterUnitEvent(tt,newCaster,EVENT_UNIT_ISSUED_POINT_ORDER)
    call TriggerAddAction(tt,function IchigoShikaiR_StopOrders)
    call SetUnitInvulnerable(newCaster, true)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(h, id, 1, IchigoCalculateBonusF(newCaster, damage))
    call SaveReal(h, id, 2, 0)
    call TimerStart(newTimer, 0.05, true, function IchigoShikaiR_Periodic1)
    set newTimer=null
    set tt=null
endfunction

