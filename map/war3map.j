endif

if GetSpellAbilityId()=='DSE1' then
call SaveReal(HH,id,15,20*GetUnitAbilityLevel(caster,'DSE1')+(3+GetUnitAbilityLevel(caster,'DSE1'))*GetHeroInt(caster,true))
