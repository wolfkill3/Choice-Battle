function ShadoJumpCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local real f=GetUnitFacing(u)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroAgi(u,true)*8
local real dist=SR(x,y,x1,y1)
local real a=Atan2(y1-y,x1-x)
local real he=0
if dist>26.00 and udg_B==true and DU2==true then
call SetUnitXY_1(u,x+35*Cos(a),y+35*Sin(a), false)
call SetUnitFacing(u,a*bj_RADTODEG)
set he=ParabolaZ(350,LoadReal(h,id,4),dist)
call SetUnitFlyHeight(u,he,0)
call SetUnitAnimation(u,"spell two")
set n=CreateUnit(p,'e08L',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.10)
call SetUnitVertexColor(n,170,170,170,70)
call UnitAddAbility(n,'A0FQ')
call SetUnitFlyHeight(n,he,0)
call SetUnitTimeScale(n,2)
call SetUnitAnimation(n,"spell two")
else
call GroupEnumUnitsInRange(G,x1,y1,500,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call Push(E,30,Atan2(GetUnitY(E)-y1,GetUnitX(E)-x1),300)
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 2, "stun")
endif
call GroupRemoveUnit(G,E)
endloop
call SetUnitInvulnerable(u,false)
call SetUnitFlyHeight(u,0,0)
call UnitApplyTimedLife(CreateUnit(p,'e08O',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e08U',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e08T',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e08R',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e08S',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e09G',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
endif
set u=null
set t=null
set p=null
endfunction
