    exitwhen i>9
    endloop
    call GroupEnumUnitsInRect(G, gg_rct_TowerRect, Base)
    loop
        set E=FirstOfGroup(G)
        exitwhen E==null
        if E==Hero[GetPlayerId(GetOwningPlayer(E))] and IsUnitType(E,UNIT_TYPE_HERO) then
            set TeamCountTower[GetPlayerId(GetOwningPlayer(E))]=TeamCountTower[GetPlayerId(GetOwningPlayer(E))]+1
            set TotalPlayerCount=TotalPlayerCount+1
        endif
        call GroupRemoveUnit(G,E)
    endloop
    
    if TotalPlayerCount==1 then
