        call HandleListAddHandle(IdHeroFrameList[y],SelectTavernHeroCheck)    
        set y=y+1
        endloop 
    endif

    set CloseIdButton=CreateFrameByType( "SIMPLEBUTTON", "TestBarClose", IdHeroFrame, "", 0 )
