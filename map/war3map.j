function SusanoCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real l=GetWidgetLife(u)
local real m=GetWidgetMana(u)
local real lm=GetUnitState(u,UNIT_STATE_MAX_LIFE)
local real mm=GetUnitState(u,UNIT_STATE_MAX_MANA)
if IsUnitHidden(u)==false then
if GetUnitAbilityLevel(u,'ItV1')>0 and l>=lm*0.025 and m>=mm*0.025 and LoadBoolean(HH,GetHandleId(u),SST)==true then
call SetUnitX(l__d,GetUnitX(u))
call SetUnitY(l__d,GetUnitY(u))
if CheckUnitInvisible(u) then
    call UnitAddAbility(l__d,'Ao7S')
else
    call UnitRemoveAbility(l__d,'Ao7S')
endif
call SetUnitFacing(l__d,GetUnitFacing(u))
call SetUnitFlyHeight(l__d,GetUnitFlyHeight(u),0)
if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
call SetUnitState(u,UNIT_STATE_LIFE,l-lm*0.04*0.03)
call SetUnitState(u,UNIT_STATE_MANA,m-mm*0.04*0.03)
endif
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\SharinganEnd.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call SaveBoolean(HH,GetHandleId(u),SS,false)
call SaveBoolean(HH,GetHandleId(u),SST,false)
call ShowAbility2('A30C',false)
call ShowAbility2('A00C',true)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call RemoveUnit(l__d)
call UnitRemoveAbility(u,'ItV1')
endif
endif
set u=null
set l__d=null
set t=null
endfunction
function SusanoCast takes nothing returns nothing //susanoo itachi
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
if GetSpellAbilityId()=='A00C' then
call SaveUnitHandle(h,id,0,u)
call ShowAbility2Timed('A00C',false,0.3)
call ShowAbility2Timed('A30C',true,0.32)
call UnitAddAbility(u,'ItV1')
call SaveBoolean(HH,GetHandleId(u),SST,true)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Susano.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
else
call SaveBoolean(HH,GetHandleId(u),SST,false)
call ShowAbility2('A30C',false)
call ShowAbility2('A00C',true)
call UnitRemoveAbility(u,'ItV1')
endif
if LoadBoolean(HH,GetHandleId(u),SS)==false then
    call SaveBoolean(HH,GetHandleId(u),SS,true)
    set n=CreateUnit(GetOwningPlayer(u),0x65303035,GetUnitX(u),GetUnitY(u),GetUnitFacing(u))
    call SetUnitTimeScale(n,2)
    call SetUnitVertexColor(n,255,255,255,150)
    call SetUnitAnimation(n,"Birth")
    call UnitAddAbility(n,'A0G6')
    call SaveUnitHandle(h,id,1,n)
    call SaveUnitHandle(h,GetHandleId(u),StringHash("immolation"),n)
    call TimerStart(t,0.03,true,function SusanoCast2)
endif
set u=null
set t=null
endfunction
function SusanoInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function SusanoCast)
call TriggerAddCondition(t,Condition(function SusanoCond))
set t=null
endfunction
