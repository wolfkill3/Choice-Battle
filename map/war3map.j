call KillSoundWhenDone(soundplay)
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\UBW Chant 4.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
elseif GetUnitAbilityLevel(u,'A13D')==4 then
call TextTagFull("Withstood pain to create weapons, waiting for one’s arrival...",u,255,155,55,1,GetOwningPlayer(u),0.028)
call SetUnitAbilityLevel(u,'A13D',5)
if GetUnitTypeId(u)=='H05A' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\UBW5.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\UBW Chant 5.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
elseif GetUnitAbilityLevel(u,'A13D')==5 then
call TextTagFull("I have no regrets. This is the only path...",u,255,155,55,1,GetOwningPlayer(u),0.028)
call SetUnitAbilityLevel(u,'A13D',6)
call UnitRemoveAbility(u,'A13C')
call SetPlayerAbilityAvailable(p,'A13B',true)
call UnitMakeAbilityPermanent(u,true,'A13B')
if GetUnitTypeId(u)=='H05A' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\UBW6.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\UBW Chant 6.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
endif
endif
call SetUnitTimeScale(u,1)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set p=null
set tt=null
set u=null
set t=null
endfunction
function UBWSystemCastCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
call SaveUnitHandle(HH,id,0,u)
call SaveReal(HH,id,1,0)
call SaveReal(HH,id,2,1)
call SetUnitTimeScale(u,1.0)
call SetUnitAnimation(u,"Spell Three")
call UnitMakeAbilityPermanent(u,true,'A13B')
call UnitMakeAbilityPermanent(u,true,'A237')
call TimerStart(t,0.1,true,function UBWSystemCastCast2)
set u=null
set p=null
set t=null
endfunction
function SystemUBWCond takes nothing returns boolean
return GetLearnedSkill()=='A137'
endfunction
function SystemUBWCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local integer id=GetPlayerId(GetOwningPlayer(u))
call UnitAddAbility(u,'A13C')
call UnitAddAbility(u,'A13B')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A13B',false)
call UnitAddAbility(u,'A237')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A237',false)
set u=null
endfunction
function InitTrig_SystemUBW takes nothing returns nothing
set gg_trg_SystemUBW=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_SystemUBW,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(gg_trg_SystemUBW,Condition(function SystemUBWCond))
call TriggerAddAction(gg_trg_SystemUBW,function SystemUBWCast)
endfunction
function UBWSwordCond takes nothing returns boolean
return RectContainsUnit(gg_rct_UBW2,GetTriggerUnit())==true and IsUnitAlly(GetTriggerUnit(),GetOwningPlayer(Shiro))==false and GetUnitAbilityLevel(GetTriggerUnit(),'Aloc')==0 and GetUnitAbilityLevel(Shiro,'A4IH')==0 and IsUnitType(GetTriggerUnit(),UNIT_TYPE_DEAD)==false and IsUnitType(GetTriggerUnit(),UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(GetTriggerUnit(),'A0QL')==0 and 'dumm'!=GetUnitTypeId(GetTriggerUnit()) and GetIssuedOrderId()!=OrderId("attack") and GetIssuedOrderId()!=OrderId("move") and GetIssuedOrderId()!=OrderId("stop") and GetIssuedOrderId()!=OrderId("patrol") and GetIssuedOrderId()!=OrderId("holdposition") and GetIssuedOrderId()!=OrderId("smart") and GetIssuedOrderId()!=851973 and GetIssuedOrderId()!=851974 and GetIssuedOrderId()!=OrderId("death") and GetIssuedOrderId()!=OrderId("decay") 
endfunction
function Slash_UBWSword2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local player p=GetOwningPlayer(l__d)
local unit u=Hero[GetPlayerId(p)]
local real speed=LoadReal(h,id,1)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,2)
local real Range=LoadReal(h,id,9)
if Range>0 then
call SaveReal(h,id,9,Range-speed)
call SetUnitXY_1(l__d,x1+speed*Cos(a),y1+speed*Sin(a), false)
call SetUnitFlyHeight(l__d,GetUnitFlyHeight(l__d)+95,0)
else
call UnitEnableAutoOrientation(l__d,true)
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
endif
set u=null
set p=null
set t=null
set l__d=null
endfunction
function Slash_UBWSword takes unit l__d,real speed,real angle,real range,real mas returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle)
call SaveReal(h,id,9,range)
call SaveReal(h,id,10,mas)
call TimerStart(t,0.03,true,function Slash_UBWSword2)
set t=null
endfunction
function UBWSwordCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(Shiro)
local real x=GetUnitX(u)+75*Cos(GetRandomReal(0,359)*bj_DEGTORAD)
local real y=GetUnitY(u)+75*Sin(GetRandomReal(0,359)*bj_DEGTORAD)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real a=Atan2(y1-y,x1-x)
call IssueImmediateOrder(u,"stop")
call SetControlToUnit(u,u, 1, "stun")  
call SetControlToUnit(u,u, 0.1, "stunbkb") 
set n=CreateUnit(p,'e0WM',x,y,a*bj_RADTODEG)
call UnitEnableAutoOrientation(n,false)
call SetUnitOrientation(n,a*bj_RADTODEG,70,0)
call SetUnitFlyHeight(n,0,0)
call Slash_UBWSword(n,50,a,300,150)
call DestroyEffect(AddSpecialEffect("war3mapImported\\SandPoff.mdx",x,y))
call myCustomDamage(Shiro,u,GetHeroAgi(Shiro,true)*3,false,false,null,null,null)
call UnitAddAbility(Shiro,'A4IH')
call UnitRemoveAbilityTimed(Shiro,'A4IH',7)
call CreateModeIndicatorForm(Shiro, "war3mapImported\\BTNShiro5.blp", 7)
set u=null
set p=null
endfunction
function InitTrig_UBWSword takes nothing returns nothing
    local trigger t=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_ISSUED_ORDER)
    call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
    call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
    call TriggerAddCondition(t,Condition(function UBWSwordCond))
    call TriggerAddAction(t,function UBWSwordCast)
    set t=null
endfunction
function CancelOrderCond takes nothing returns boolean
return GetIssuedOrderId()==851975 or GetIssuedOrderId()==851979 or GetIssuedOrderId()==852000 or GetIssuedOrderId()==851976 or GetIssuedOrderId()==851977 or GetIssuedOrderId()==851978
endfunction
function CancelOrderCast takes nothing returns nothing
call BJDebugMsg(I2S(GetIssuedOrderId()))
endfunction
function InitTrig_CancelOrder takes nothing returns nothing
    local trigger t=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_ISSUED_ORDER)
    call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
    call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
    //call TriggerAddCondition(t,Condition(function CancelOrderCond))
    call TriggerAddAction(t,function CancelOrderCast)
    set t=null
endfunction
function UBWCond takes nothing returns boolean
return GetSpellAbilityId()=='A13B' or GetSpellAbilityId()=='A237'
endfunction
function UBWCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local real time=LoadReal(HH,id,2)
local real x=LoadReal(HH,id,5)
local real y=LoadReal(HH,id,6)
local real x1=GetRectCenterX(gg_rct_UBW2)
local real y1=GetRectCenterY(gg_rct_UBW2)
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(p)
local group g=LoadGroupHandle(HH,id,8)
local group g2=LoadGroupHandle(HH,id,21)
local group g3=CreateGroup()
local group g4
local real mana=GetWidgetMana(u)
local real mm=GetUnitState(u,UNIT_STATE_MAX_MANA)
//local real max_time=LoadReal(HH, id, TIME_HASH)
call GroupEnumUnitsInRect(g,gg_rct_UBW2,BaseUBW2)
call GroupRemoveUnit(g,u)
loop
    set E=FirstOfGroup(g)
    exitwhen E==null
    if Condition_BaseUBW(p,E) then
        call GroupAddUnit(g3,E)
    if IsUnitInGroup(E,g2)==false then
        call UnitAddAbility(E,'A0IH')
        call GroupAddUnit(g2,E)
    endif
    call UnitMakeAbilityPermanent(E,true,'A0IH')
    endif
    call GroupRemoveUnit(g,E)
endloop
set g4=CopyGroup(g2)
loop
    set E=FirstOfGroup(g4)
    exitwhen E==null 
    if (RectContainsUnit(gg_rct_UBW2,E)==false and Condition_BaseUBW(p,E) and GetUnitAbilityLevel(E,'A3IH')>0 and GetUnitAbilityLevel(E,'A0IH')>0) or (RectContainsUnit(gg_rct_UBW2,E)==true and IsUnitHidden(E)==true and Condition_BaseUBW(p,E)) then
        call GroupAddUnit(g3,E)
    endif
    if RectContainsUnit(gg_rct_UBW2,E)==false and GetUnitAbilityLevel(E,'A3IH')==0 then
        call UnitMakeAbilityPermanent(E,false,'A0IH')
        call UnitRemoveAbility(E,'A0IH')
    endif
    call GroupRemoveUnit(g4,E)  
endloop
call DestroyGroup(g4)
//call SaveReal(HH, id, TIME_HASH, max_time+0.2)
if mana>mm*0.03 and FirstOfGroup(g3)!=null and UnitIsAlive(u) and GetUnitAbilityLevel(u,'A0IH')>0 and (RectContainsUnit(gg_rct_UBW2,u)==true or (RectContainsUnit(gg_rct_UBW2,u)==false and GetUnitAbilityLevel(u,'A3IH')>0)) then //and max_time<20 then
    if IsUnitPaused(u)==false and IsUnitHidden(u)==false then
        call SetUnitState(u,UNIT_STATE_MANA,mana-mm*0.0007)
    else
        call SetUnitState(u,UNIT_STATE_MANA,mana-mm*0.000125)
    endif
    call GroupEnumUnitsInRange(g,GetRectCenterX(gg_rct_UBW1),GetRectCenterY(gg_rct_UBW1),4000,BaseUBW2)
    loop
        set E=FirstOfGroup(g)
        exitwhen E==null
        if (SR(GetUnitX(E),GetUnitY(E),GetRectCenterX(gg_rct_UBW1),GetRectCenterY(gg_rct_UBW1))>1820 or IsTerrainPathable(GetUnitX(E),GetUnitY(E),PATHING_TYPE_FLYABILITY)==true) and GetUnitAbilityLevel(E,'A3IH')==0 then
            call SetUnitXY_1(E,GetUnitX(E)+150*Cos(Angle2(GetUnitX(E),GetUnitY(E),GetRectCenterX(gg_rct_UBW1),GetRectCenterY(gg_rct_UBW1))*bj_DEGTORAD),GetUnitY(E)+150*Sin(Angle2(GetUnitX(E),GetUnitY(E),GetRectCenterX(gg_rct_UBW1),GetRectCenterY(gg_rct_UBW1))*bj_DEGTORAD),false)
        endif
        call GroupRemoveUnit(g,E)
    endloop
else
    loop
        set E=FirstOfGroup(g2)
        set ide=GetHandleId(E)
        exitwhen E==null
        call SetUnitX(E,LoadReal(HH,GetHandleId(u),StringHash("ubwX"))+GetRandomReal(-500,500))
        call SetUnitY(E,LoadReal(HH,GetHandleId(u),StringHash("ubwY"))+GetRandomReal(-500,500))
        if GetOwningPlayer(E)==GetLocalPlayer()then
            call SetCameraPosition(GetUnitX(E),GetUnitY(E))
        endif
        call UnitMakeAbilityPermanent(E,false,'A0IH')
        call UnitRemoveAbility(E,'A0IH')
        call GroupRemoveUnit(g2,E)
    endloop
    call UnitRemoveAbility(u,'A2VJ')
    call SetUnitX(u,LoadReal(HH,GetHandleId(u),StringHash("ubwX")))
    call SetUnitY(u,LoadReal(HH,GetHandleId(u),StringHash("ubwY")))
    call UnitRemoveAbility(u,'A13D')
    call UnitRemoveAbility(u,'A0IH')
    //call UnitRemoveAbility(u,'A13K')
    call UnitAddAbility(u,'A13C')
    if GetOwningPlayer(u)==GetLocalPlayer()then
        call SetCameraPosition(GetUnitX(u),GetUnitY(u))
    endif
    set g4=CreateGroup()
    call GroupEnumUnitsInRect(g4,gg_rct_UBW2,BaseUBW2)
    call GroupRemoveUnit(g4,u)
    loop
        set E=FirstOfGroup(g4)
        set ide=GetHandleId(E)
        exitwhen E==null
        call SetUnitX(E,LoadReal(HH,GetHandleId(u),StringHash("ubwX"))+GetRandomReal(-500,500))
        call SetUnitY(E,LoadReal(HH,GetHandleId(u),StringHash("ubwY"))+GetRandomReal(-500,500))
        if GetOwningPlayer(E)==GetLocalPlayer()then
            call SetCameraPosition(GetUnitX(E),GetUnitY(E))
        endif
        call UnitMakeAbilityPermanent(E,false,'A0IH')
        call UnitRemoveAbility(E,'A0IH')
        call UnitRemoveAbility(E,'A2VJ')
        call GroupRemoveUnit(g4,E)
    endloop
    //call SaveReal(HH, GetHandleId(LoadFrameHandle(HH, GetHandleId(u),StringHash("war3mapImported\\BTNShiro5.blp"))), c_DURATION, 0)
    call SetPlayerAbilityAvailable(p,'A237',false)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13E'),ABILITY_RLF_DURATION_HERO,0,2)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13E'),ABILITY_RLF_DURATION_NORMAL,0,2)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13E'),ABILITY_RLF_DURATION_HERO,1,2)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13E'),ABILITY_RLF_DURATION_NORMAL,1,2)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13E'),ABILITY_RLF_DURATION_HERO,2,2)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13E'),ABILITY_RLF_DURATION_NORMAL,2,2)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13E'),ABILITY_RLF_DURATION_HERO,3,2)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13E'),ABILITY_RLF_DURATION_NORMAL,3,2)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13E'),ABILITY_RLF_DURATION_HERO,4,2)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13E'),ABILITY_RLF_DURATION_NORMAL,4,2)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13F'),ABILITY_RLF_COOLDOWN,0,25)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13F'),ABILITY_RLF_COOLDOWN,1,25)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13F'),ABILITY_RLF_COOLDOWN,2,25)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13F'),ABILITY_RLF_COOLDOWN,3,25)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13F'),ABILITY_RLF_COOLDOWN,4,25)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A135'),ABILITY_RLF_COOLDOWN,0,20)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A135'),ABILITY_RLF_COOLDOWN,1,20)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A135'),ABILITY_RLF_COOLDOWN,2,20)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A135'),ABILITY_RLF_COOLDOWN,3,20)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A135'),ABILITY_RLF_COOLDOWN,4,20)
    call StartAbilityCooldown(GetUnitAbility(u, 'A13C'), 45)
    call PauseTimer(t)
    call DestroyGroup(g)
    call DestroyGroup(g2)
    call DestroyGroup(g3)
    call DestroyGroup(g4)
    call DestroyTimer(t)
    call FlushChildHashtable(HH,id)
endif
set p=null
set t=null
set u=null
set g=null
set g2=null
set g3=null
set g4=null
endfunction
function UBWCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local real time=LoadReal(HH,id,2)
local real x=LoadReal(HH,id,5)
local real y=LoadReal(HH,id,6)
local real x1=0
local real y1=0
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(p)
local group g=LoadGroupHandle(HH,id,8)
local group g2=LoadGroupHandle(HH,id,21)
local real fire=LoadReal(HH,id,20)
local real fire2=LoadReal(HH,id,22)
local real f=(30)*bj_DEGTORAD
local integer i=0
if fire<1350 then
    if fire==0 then
        set EFF=AddSpecialEffect("war3mapImported\\BY_Wood_Eff_Ord_DanGe_Wav_Kuosan_1_3_0.5s.mdl", x, y)
        call SetSpecialEffectScale(EFF , 2)
        call SetSpecialEffectTimeScale(EFF , 0.25)
        call SetSpecialEffectAlphaTimed(EFF , 70 , 230 , 255 , 255 , 3)
        set EFF=AddSpecialEffect("war3mapImported\\3shadowassault(lightzi)waveblue.mdl", x, y)
        call SetSpecialEffectScale(EFF , 3)
        call SetSpecialEffectTimeScale(EFF , 0.25)
        call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 4)
        set EFF=AddSpecialEffect("war3mapImported\\by_wood_effect_yuanbanlin_sand2.mdx", x, y)
        call SetSpecialEffectScale(EFF , 1.2)
        call SetSpecialEffectTimeScale(EFF , 0.27)
        call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 4)
    endif
    if fire==675 then
        set EFF=AddSpecialEffect("war3mapImported\\by_wood_effect_yuanbanlin_sand2.mdx", x, y)
        call SetSpecialEffectScale(EFF , 1.2)
        call SetSpecialEffectTimeScale(EFF , 0.27)
        call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 4)
        set EFF=AddSpecialEffect("war3mapImported\\Rasengan1.mdl", x, y)
        call SetSpecialEffectZ(EFF , -130)
        call SetSpecialEffectScale(EFF , 1.7)
        call SetSpecialEffectTimeScale(EFF , 1)
        call RemoveEffect(EFF,0.3,true,CreateTimer()) 
    endif
    if fire==945 then
        set n=CreateUnit(p,'e06G',x,y,0)
        call UnitApplyTimedLife(n,1,2)
        call SetUnitTimeScale(n,0.1)
        set EFF=AddSpecialEffect("cleave2.mdx",x,y)
        call SetSpecialEffectVertexColour(EFF,255,100,100,255)
        call SetSpecialEffectTimeScale(EFF,2)
        call SetSpecialEffectScale(EFF,5)
        call RemoveEffect(EFF,0.8,true,CreateTimer())
        call CinematicFadeBJCustom(bj_CINEFADETYPE_FADEOUTIN,1,"ReplaceableTextures\\CameraMasks\\White_mask.blp",255,255,255,0)
    endif
    if fire>=1080 then
        loop
        exitwhen i>=7
            set x1=x+GetRandomReal(-1*fire,fire)*Cos(GetRandomReal(0,359)*bj_DEGTORAD)
            set y1=y+GetRandomReal(-1*fire,fire)*Sin(GetRandomReal(0,359)*bj_DEGTORAD)
            call DestroyEffect(AddSpecialEffect("by_wood_effect_yuzhiboyou_fire_babangouyu_2_di_.mdx",x1,y1))
            set i=i+1
        endloop
    endif
    call SaveReal(HH,id,20,fire+135)
    call SaveReal(HH,id,22,fire2+0.15)
else
    call UnitApplyTimedLife(CreateUnit(p,'e0X2',x,y,0),1,1)
    call SaveReal(HH,GetHandleId(u),StringHash("ubwX"),GetUnitX(u))
    call SaveReal(HH,GetHandleId(u),StringHash("ubwY"),GetUnitY(u))
    call SetUnitX(u,GetRectCenterX(gg_rct_UBW1))
    call SetUnitY(u,GetRectCenterY(gg_rct_UBW1))
    if GetOwningPlayer(u)==GetLocalPlayer()then
        call SetCameraPosition(GetUnitX(u),GetUnitY(u))
    endif
    call GroupEnumUnitsInRange(G,x,y,1400,BaseUBW)
    loop
        set E=FirstOfGroup(G)
        exitwhen E==null
        set ide=GetHandleId(E)
        if IsUnitType(E,UNIT_TYPE_HERO)and E!=u and GetUnitAbilityLevel(E,'cbc9')==0 and GetUnitAbilityLevel(E,'IMDc')==0 and IsUnitHidden(E)==false then //and E==Hero[GetPlayerId(GetOwningPlayer(E))] then
            call GroupAddUnit(g2,E)
            call UnitAddAbility(E,'A0IH')
            call UnitMakeAbilityPermanent(E,true,'A0IH')
            call SetUnitX(E,GetRandomReal(GetRectMinX(gg_rct_UBW2)+1950,GetRectMaxX(gg_rct_UBW2)-1950))
            call SetUnitY(E,GetRandomReal(GetRectMinY(gg_rct_UBW2)+1950,GetRectMaxY(gg_rct_UBW2)-1950))
            if GetOwningPlayer(E)==GetLocalPlayer()then
                call SetCameraPosition(GetUnitX(E),GetUnitY(E))
            endif
        endif
        call GroupRemoveUnit(G,E)
    endloop
    //call CreateModeIndicatorForm(u, "war3mapImported\\BTNShiro5.blp", 20)
    call PauseUnit(u,false)
    call SetUnitInvulnerable(u,false)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13E'),ABILITY_RLF_DURATION_HERO,0,5)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13E'),ABILITY_RLF_DURATION_NORMAL,0,5)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13E'),ABILITY_RLF_DURATION_HERO,1,5)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13E'),ABILITY_RLF_DURATION_NORMAL,1,5)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13E'),ABILITY_RLF_DURATION_HERO,2,5)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13E'),ABILITY_RLF_DURATION_NORMAL,2,5)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13E'),ABILITY_RLF_DURATION_HERO,3,5)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13E'),ABILITY_RLF_DURATION_NORMAL,3,5)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13E'),ABILITY_RLF_DURATION_HERO,4,5)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13E'),ABILITY_RLF_DURATION_NORMAL,4,5)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13F'),ABILITY_RLF_COOLDOWN,0,20)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13F'),ABILITY_RLF_COOLDOWN,1,20)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13F'),ABILITY_RLF_COOLDOWN,2,20)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13F'),ABILITY_RLF_COOLDOWN,3,20)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A13F'),ABILITY_RLF_COOLDOWN,4,20)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A135'),ABILITY_RLF_COOLDOWN,0,15)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A135'),ABILITY_RLF_COOLDOWN,1,15)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A135'),ABILITY_RLF_COOLDOWN,2,15)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A135'),ABILITY_RLF_COOLDOWN,3,15)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A135'),ABILITY_RLF_COOLDOWN,4,15)
    call PauseTimer(t)
    call SetPlayerAbilityAvailable(p,'A13B',false)
    call SetPlayerAbilityAvailable(p,'A237',true)
    call TimerStart(t,0.02,true,function UBWCast3)
endif
set p=null
set t=null
set u=null
set g=null
set g2=null
endfunction
function UBWCast takes nothing returns nothing
local timer t=CreateTimer()
local unit u=GetTriggerUnit()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(p)
local real a=0
local integer i=0
local real x1
local real y1
if GetSpellAbilityId()=='A237' then
call UnitRemoveAbility(u,'A0IH')
else
call SaveGroupHandle(HH,id,8,CreateGroup())
call SaveGroupHandle(HH,id,21,CreateGroup())
call SaveUnitHandle(HH,id,0,u)
call SaveReal(HH,id,20,0)
call SaveReal(HH,id,22,0)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call UnitAddAbility(u,'A0IH')
set Shiro=u
//call UnitAddAbility(u,'A13K')
//set n=CreateUnit(p,0x65305A32,x,y,0)
//call UnitApplyTimedLife(n,1,2.4)
//call UnitScale(n,0.1,5.35,1.8)
call TextTagFull("UNLIMITED BLADE WORKS",u,255,155,55,1,GetOwningPlayer(u),0.029)
if GetUnitTypeId(u)=='H05A' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\UBW7.mp3",false,false,true,12700,12700,"")
call SetSoundVolumeBJ(soundplay,150)
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call SetUnitAnimation(u,"Spell Channel Two")
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\UBW Chant 7.mp3",false,false,true,12700,12700,"")
call SetSoundVolumeBJ(soundplay,150)
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call SetUnitAnimation(u,"Spell Four")
endif
call SaveReal(HH,id,5,x)
call SaveReal(HH,id,6,y)
call TimerStart(t,0.15,true,function UBWCast2)
endif
set t=null
set p=null
set u=null
endfunction
function KanshoAndBakuyaCond takes nothing returns boolean
return GetSpellAbilityId()=='A135' and udg_B==true
endfunction
function KanshoAndBakuyaCast4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=LoadReal(h,id,25)
local player p=GetOwningPlayer(u)
local integer i=0
call SetUnitPathing(u,true)
call PauseUnit(u,false)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call SetUnitInvulnerable(u,false)
if GetUnitAbilityLevel(u,'A0IH')==0 then
call SetUnitX(u,x1+200*Cos(a))
call SetUnitY(u,y1+200*Sin(a))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",c,"chest"))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\s_ShadowEruption_Rain.mdx",c,"chest"))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\MajinHuntSlash.mdx",c,"chest"))
call myCustomDamage(u,c,((2+GetUnitAbilityLevel(u,'A135'))*GetHeroAgi(u,true))+85,false,false,null,null,null)
endif
if GetUnitAbilityLevel(u,'A0IH')>0 then
call Push(c,30,LoadReal(h,id,25),300)
call myCustomDamage(u,c,((5+GetUnitAbilityLevel(u,'A135'))*GetHeroAgi(u,true))+85,false,false,null,null,null)
loop
exitwhen i>=12
set n=CreateUnit(p,'e0Y4',x+120*i*Cos(a),y+120*i*Sin(a),a*bj_RADTODEG)
call UnitApplyTimedLife(n,'B000',2)
call SetUnitScale(n,1.7+0.3*i,1.7+0.3*i,1.7+0.3*i)
call SetUnitFlyHeight(n,75+30*i,0)
call SetUnitTimeScale(n,4)
call SetUnitVertexColor(n,255,255,255,255)
set i=i+1
endloop
endif
call SetControlToUnit(u,c,2, "stun")
call SetUnitAnimation(u,"attack")
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitTimeScale(u,1)
call UnitRemoveAbility(u,'A136')
call FlushChildHashtable(h,id)
set u=null
set c=null
set p=null
set t=null
endfunction
function KanshoAndBakuyaCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local real dist=LoadReal(h,id,8)
local player p=GetOwningPlayer(u)
if dist<900 and UnitIsAlive(c)and UnitIsAlive(u)then
if GetUnitAbilityLevel(u,'A0IH')==0 then
call SetUnitX(c,x1+12*Cos(a))
call SetUnitY(c,y1+12*Sin(a))
endif
call SaveReal(h,id,8,dist+15)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",x1,y1))
call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",x1,y1))
call SetUnitXY_1(u,x1,y1, false)
// if GetUnitCurrentOrder(u)!=851983 then
        // call IssueTargetOrder(u, "attack", c)
// endif
if GetUnitTypeId(u)=='H05A' then
set n=CreateUnit(p,'e0WW',x1,y1,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'B000',0.25)
call SetUnitVertexColor(n,255,255,255,100)
call SetUnitTimeScale(n,2)
call SetUnitAnimation(n,"attack")
else
set n=CreateUnit(p,'e0WV',x1,y1,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'B000',0.25)
call SetUnitVertexColor(n,255,255,255,100)
call SetUnitTimeScale(n,2)
call SetUnitAnimation(n,"attack")
endif
else
call Push(c,30,a,300)
call PauseTimer(t)
call SetUnitAnimation(u,"attack")
call SetUnitTimeScale(u,0.5)
call TimerStart(t,0.5,false,function KanshoAndBakuyaCast4)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function KanshoAndBakuyaCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>60 and GetWidgetLife(c)>0 then
set x=x+40*Cos(a)
set y=y+40*Sin(a)
call SetUnitXY_1(u,x,y,false)
call SetUnitFacing(u,a*bj_RADTODEG)
if GetUnitTypeId(u)=='H05A' then
set n=CreateUnit(p,'e0WW',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'B000',0.25)
call SetUnitVertexColor(n,255,255,255,100)
call SetUnitTimeScale(n,2)
if GetUnitAbilityLevel(u,'A0IH')==0 then
call SetUnitAnimation(n,"attack")
else
call SetUnitAnimation(n,"Spell Two")
endif
else
call SetUnitAnimation(u,"attack")
set n=CreateUnit(p,'e0WV',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'B000',0.25)
call SetUnitVertexColor(n,255,255,255,100)
call SetUnitTimeScale(n,2)
call SetUnitAnimation(n,"attack")
endif
else
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
    call PauseTimer(t)
    call PauseUnit(u,true)
    call PauseUnit(c,true)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
    //call IssueTargetOrder(u, "attack", c)
    if GetUnitAbilityLevel(u,'A0IH')==0 then
    call Push(c,30,LoadReal(h,id,25),300)
    //call SetControlToUnit(u, u, 1.5, "silenceTE")
    //call SetControlToUnit(c, c, 1.5, "stun")
    call TimerStart(t,0.025,true,function KanshoAndBakuyaCast3)
    else
    call TimerStart(t,0.7,false,function KanshoAndBakuyaCast4)
    endif
else
    call PauseUnit(u,false)
    call SetUnitInvulnerable(u,false)
    call SetUnitAnimation(u,"attack")
    call PauseUnit(c,false)
    call UnitRemoveAbility(u,'A136')
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
    call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
    call SetUnitXY_1(u,x1,y1, false)
    call PauseTimer(t)
    call DestroyTimer(t)
    call SetUnitVertexColor(u,255,255,255,255)
    call FlushChildHashtable(h,id)
endif
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function KanshoAndBakuyaCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
call SaveUnitHandle(h,id,0,u)
call SetUnitPathing(u,false)
call UnitAddAbility(u,'A136')
call PauseUnit(u,true)
call SetUnitTimeScale(u,5)
call SetUnitInvulnerable(u,true)
call SaveReal(h,id,8,0)
call SaveReal(h,id,11,x)
call SaveReal(h,id,12,y)
call SaveReal(h,id,25,Atan2(GetUnitY(c)-y,GetUnitX(c)-x))
call SaveUnitHandle(h,id,1,c)
if GetUnitAbilityLevel(u,'A0IH')==0 then
if GetUnitTypeId(u)=='H05A' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\KanshoAndBakuya.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Archer KanshoAndBakuya.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
else
call SetUnitAnimation(u,"spell two")
if GetUnitTypeId(u)=='H05A' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\ShirouUsedCaliburn.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\ArcherW2.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
endif
call TimerStart(t,0.025,true,function KanshoAndBakuyaCast2)
set c=null
set u=null
set t=null
endfunction
function ArchersBowCond takes nothing returns boolean
return GetSpellAbilityId()=='A132' and udg_B==true and GetUnitAbilityLevel(GetTriggerUnit(),'A0IH')==0
endfunction
function ArchersBowCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real a=LoadReal(h,id,11)
local real dist=LoadReal(h,id,2)
local real x=GetUnitX(l__d)+60*Cos(a)
local real y=GetUnitY(l__d)+60*Sin(a)
local real dmg=LoadReal(h,id,4)+dist*(0.07*GetUnitAbilityLevel(u,'A132'))
local group g=LoadGroupHandle(h,id,12)
local integer idg2=GetHandleId(g)
local player p=GetOwningPlayer(u)
if dist<3700 and RectContainsUnit(GetWorldBounds(),l__d)and UnitIsAlive(l__d)then
        call SetUnitXY_1(l__d,x,y, false)
        set n=CreateUnit(p,0x65305830,x,y,a*bj_RADTODEG)
        call UnitApplyTimedLife(n,1,1)
        set n=CreateUnit(p,0x6530575A,x,y,a*bj_RADTODEG)
        call UnitApplyTimedLife(n,1,1)
        call GroupEnumUnitsInRange(g,x,y,150,Base)
        call SaveReal(h,id,2,dist+60)
        loop
        set E=FirstOfGroup(g)
        set ide=GetHandleId(E)
        if Condition_Base(p,E)and LoadUnitHandle(h,idg2,ide)!=E then
                call KillUnit(l__d)
                call GroupClear(g)
        endif
        call GroupRemoveUnit(g,E)
        exitwhen E==null
        endloop
else
        call GroupEnumUnitsInRange(g,x,y,450,Base)
        loop
        set E=FirstOfGroup(g)
        set ide=GetHandleId(E)
                if Condition_Base(p,E)and LoadUnitHandle(h,idg2,ide)!=E then
                        call myCustomDamage(u,E,dmg,false,false,null,null,null)
                endif
                call GroupRemoveUnit(g,E)
        exitwhen E==null
        endloop
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\ArchersBowExpl.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call SetSoundVolumeBJ(soundplay,60)
        call KillSoundWhenDone(soundplay)
        call UnitApplyTimedLife(CreateUnit(p,'e0DC',x,y,(a*bj_RADTODEG)),1,3)
        call UnitApplyTimedLife(CreateUnit(p,'e0DE',x,y,(a*bj_RADTODEG)),1,3)
        call UnitApplyTimedLife(CreateUnit(p,0x65305155,x,y,(a*bj_RADTODEG)),1,3)
        call UnitApplyTimedLife(CreateUnit(p,0x65305153,x,y,(a*bj_RADTODEG)),1,3)
        call UnitApplyTimedLife(CreateUnit(p,0x65305154,x,y,(a*bj_RADTODEG)),1,3)
        call UnitApplyTimedLife(CreateUnit(p,0x65305759,x,y,(a*bj_RADTODEG)),1,3)
        call UnitApplyTimedLife(CreateUnit(p,'e0C7',x,y,(a*bj_RADTODEG)),1,6)
        set n=CreateUnit(p,'e0WR',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,1,0.01)
        call SetUnitScale(n,0.65,0.65,0.65)
        call SetUnitVertexColor(n,255,255,255,150)
        set n=CreateUnit(p,'e0WR',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,1,0.01)
        call SetUnitScale(n,1,1,1)
        call SetUnitVertexColor(n,255,255,255,125)
        set n=CreateUnit(p,'e0WR',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,1,0.01)
        call SetUnitScale(n,1.4,1.4,1.4)
        call SetUnitVertexColor(n,255,255,255,100)
        set n=CreateUnit(p,'e0WR',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,1,0.01)
        call SetUnitScale(n,1.65,0.65,0.65)
        call SetUnitVertexColor(n,255,255,255,75)
        set n=CreateUnit(p,'e0WR',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,1,0.01)
        call SetUnitScale(n,2,2,2)
        call SetUnitVertexColor(n,255,255,255,50)
        set n=CreateUnit(p,'e0WR',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,1,0.01)
        call SetUnitScale(n,2.4,2.4,2.4)
        call SetUnitVertexColor(n,255,255,255,25)
        call RemoveUnit(l__d)
        call FlushChildHashtable(h,idg2)
        call DestroyGroup(g)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
endif
set g=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
function ArchersBowCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,5)
local real y1=LoadReal(h,id,6)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real dmg=LoadReal(h,id,4)
local real dist=LoadReal(h,id,2)
local real time=LoadReal(h,id,12)
local real scale=LoadReal(h,id,10)
local real tm=GetWidgetMana(u)
if time<0.75 then
call PauseUnit(u,true)
call SaveReal(h,id,12,time+0.1)
set n=CreateUnit(p,'e0WR',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,0.65,0.65,0.65)
call SetUnitVertexColor(n,255,255,255,100)
set n=CreateUnit(p,'e0WR',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,255,255,255,50)
set n=CreateUnit(p,'e0WR',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,1.4,1.4,1.4)
call SetUnitVertexColor(n,255,255,255,100)
call SaveReal(h,id,10,scale+0.015)
else
set n=CreateUnit(p,0x65305758,x,y,a*bj_RADTODEG)
call SaveUnitHandle(h,id,7,n)
call StopSound(LoadSoundHandle(h,id,16),true,true)
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
call SetUnitTimeScale(u,1)
call SetUnitX(n,x+100*Cos(a))
call SetUnitY(n,y+100*Sin(a))
call SetUnitAnimation(u,"Spell Throw One")
call PauseTimer(t)
call UnitRemoveAbility(u,'A133')
call TimerStart(t,0.02,true,function ArchersBowCast3)
endif
set p=null
set u=null
set t=null
endfunction
function ArchersBowCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
