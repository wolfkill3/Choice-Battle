    //call SaveUnitHandle(h,id,12,n)
    //call UnitAddAbility(n,'ore2')
    //call UnitApplyTimedLife(n,1,35)
    call PauseUnit(u,true)
    call SetUnitInvulnerable(u,true)
    call PauseUnit(c,true)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
    call SetUnitInvulnerable(c,true)
    call TimerStart(t,0.03,true,function EKiyoCast2)
    set u=null
    set p=null
    set t=null
    set c=null
endfunction
