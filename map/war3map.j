    call ShowFrame( CloseIdButtonText, true )
    call SetFrameRelativePoint( CloseIdButtonText, FRAMEPOINT_CENTER, CloseIdButton, FRAMEPOINT_CENTER, .00011, .0 )
    
    set SelectTestPlayerCheck = CreateFrameByType( "SPRITE", "PlayerPickSelector", IdHeroFrame, "", 0 )
