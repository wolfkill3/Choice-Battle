function SabracChoice_Act takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit caster=GetTriggerUnit()
local unit target=GetSpellTargetUnit()
local real x0=GetUnitX(caster)
local real y0=GetUnitY(caster)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local unit casterOriginal=sabrac
local real facing=Angle2(x0,y0,x1,y1)
call SaveUnitHandle(HH,id,1,caster)
call SaveReal(HH,id,11,x1)
call SaveReal(HH,id,12,y1)
call SaveReal(HH,id,3,facing)
call SaveUnitHandle(HH,id,30,casterOriginal)


if GetUnitTypeId(GetTriggerUnit())=='HSab' then

set sabrac=Hero[GetPlayerId(GetOwningPlayer(caster))]
set casterOriginal=sabrac
endif

//Q
if GetSpellAbilityId()=='SaQ1' then

if caster==casterOriginal then
call SaveBoolean(HH,GetHandleId(caster),SH_SabracTBool,false)
else


call StartAbilityCooldown(GetUnitAbility(casterOriginal,'SaQ1'), 10)


endif

call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)-0.1*GetUnitState(caster,UNIT_STATE_LIFE))
//call HealText(0.1*GetUnitState(caster,UNIT_STATE_LIFE),caster)
if GetUnitLevel(caster)>=35 then
call UnitRemoveBuffs(caster,false,true)
endif
set target=LoadUnitHandle(HH,GetHandleId(casterOriginal),SH_SabracZoneU)
if target!=null and SR(x0,y0,GetUnitX(target),GetUnitY(target))<1500 then
call SaveBoolean(HH,id,31,true)
set soundplay=SndN(3892) // Sound\Music\mp3Music\SabracQF.mp3
else
set soundplay=SndN(3894) // Sound\Music\mp3Music\SabracQ.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call SetUnitAnimationByIndex(caster,5)
call SaveReal(HH,id,15,(2.5+0.5*GetUnitAbilityLevel(casterOriginal,'SaQ1'))*GetHeroStr(casterOriginal,true))


call EffectCreateAndMove(true,"Sabrac\\HakkeStart2.mdl",facing,1,0.5,1,100,100,100,60,0,caster,0,facing)


call TimerStart(t,0.02,true,function SabracQAct)
endif

//W
if GetSpellAbilityId()=='SaW1' then
set soundplay=SndN(3896) // Sound\Music\mp3Music\SabracW.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.02,false,function SabracGnull)
if caster!=casterOriginal then
call SabracWActForClone(casterOriginal,caster)
call SabracWActForClone(casterOriginal,casterOriginal)

//if(GetLocalPlayer()==GetOwningPlayer(casterOriginal))then
//call DisplayTextToPlayer(GetLocalPlayer(),0,0,"Clone")
//endif

endif

if caster==casterOriginal then
//if(GetLocalPlayer()==GetOwningPlayer(casterOriginal))then
//call DisplayTextToPlayer(GetLocalPlayer(),0,0,"Original")
//endif
call SaveBoolean(HH,GetHandleId(caster),SH_SabracTBool,false)
call SabracWActForClone(casterOriginal,casterOriginal)
endif

endif

if GetSpellAbilityId()=='SaW2' then
call EffectCreateAndMove(true,"Sabrac\\DustWindFaster3.mdl",facing,1,0.75,1,100,100,100,0,50,caster,0,facing)
call EffectCreateAndMove90(true,"Sabrac\\wind4.mdl",facing+180,1,0.5,1,100,100,100,0,100,caster,0,facing)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',x0,x0,facing)
call SetUnitModel(n0,"Sabrac\\Black-Red-dash.mdl")
call UnitSize(n0,1.5,1,1)
call UnitSpeed(n0,1)
call UnitColor(n0,100,100,100,0)
call SetUnitFlyHeight(n0,0,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=null
set n0=CreateUnit(GetOwningPlayer(caster),'e200',x0,y0,facing+180)
call SetUnitModel(n0,"Sabrac\\fire6.mdl")
call UnitSize(n0,1,1,1)
call UnitSpeed(n0,2)
call UnitColor(n0,100,0,0,0)
call SetUnitFlyHeight(n0,100,0)
call SaveUnitHandle(HH,id,22,n0)
set n0=null
if caster==casterOriginal then
call SaveBoolean(HH,GetHandleId(caster),SH_SabracTBool,false)
endif
if caster!=casterOriginal then
call SaveBoolean(HH,GetHandleId(caster),SH_SabracW,true)
call StartAbilityCooldown(GetUnitAbility(casterOriginal,'SaW1'), 10)
endif
call SaveBoolean(HH,GetHandleId(casterOriginal),SH_SabracW,true)
set soundplay=SndN(3898) // Sound\Music\mp3Music\SabracW2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay)
call SaveSoundHandle(HH,id,24,soundplay)
call PauseUnit(caster,true)
//call SetUnitInvulnerable(caster,true)
call SaveBoolean(HH,GetHandleId(caster),DASH_USER,true)
call SaveReal(HH,id,15,GetHeroStr(casterOriginal,true)*2+3*(  GetUnitBaseDamageByIndex( casterOriginal ,0)+GetUnitBonusDamageByIndex( casterOriginal ,0)   )   )
call SetUnitAnimationByIndex(caster,1)
call TimerStart(t,0.02,true,function SabracW2Act)

endif

//T
if GetSpellAbilityId()=='SaT1' then
call SaveBoolean(HH,GetHandleId(caster),SH_SabracTBool,true)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'SaT1',false)
call UnitAddAbility(caster,'SaT2')
set soundplay=SndN(3900) // Sound\Music\mp3Music\SabracT.mp3
if(GetLocalPlayer()==GetOwningPlayer(caster))then
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SetUnitAnimationByIndex(caster,5)
call UnitAddAbility(caster,'SaTI')
call UnitSpeed(caster,1)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
set n0=CreateUnit(GetOwningPlayer(caster),'HSaC',GetUnitX(caster),GetUnitY(caster),facing)
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call SaveUnitHandle(HH,id,20,n0)
call SaveUnitHandle(HH,GetHandleId(caster),SH_SabracTU,n0)
call UnitInventorySetSize(n0,10)


call SaveUnitHandle(HH,id,21,CreateUnit(GetOwningPlayer(caster),'e203',GetUnitX(caster),GetUnitY(caster),facing))


//call CreateModeIndicatorWithPauseForm(n0, "ReplaceableTextures\\CommandButtons\\BTNSabracT.blp", 15)
//call CreateModeIndicatorWithPauseSabrac( n0, "ReplaceableTextures\\CommandButtons\\BTNSabracT.blp", 15)


call CreateModeIndicatorWithPauseSabrac(caster ,n0, "ReplaceableTextures\\CommandButtons\\BTNSabracT.blp", 15)


call TimerStart(t,0.02,true,function SabracTAct)
call CloneAddCD(caster,n0)


set n0=null
endif

if GetSpellAbilityId()=='SaT2' then
set soundplay=SndN(3902) // Sound\Music\mp3Music\SabracT2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
set facing=GetUnitFacing(target)
call SaveReal(HH,id,3,facing)
call SetUnitFacing(caster,facing)
call PauseUnit(target,true)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
call SetUnitInvulnerable(target,true)
call SaveUnitHandle(HH,id,2,target)
call SaveBoolean(HH,GetHandleId(casterOriginal),SH_SabracTBool,false)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',x0,y0,facing)
call SetUnitModel(n0,"Sabrac\\buffeffectRed.mdl")
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call SaveUnitHandle(HH,id,20,n0)
set n0=null
call SaveReal(HH,id,15,5*GetHeroStr(caster,true))
call TimerStart(t,0.02,true,function SabracT2Act)
endif
//E
if GetSpellAbilityId()=='SaE1' then
call SetUnitState(caster,UNIT_STATE_MANA,GetUnitState(caster,UNIT_STATE_MANA)-0.1*GetUnitState(caster,UNIT_STATE_MANA))
//call HealTextMana(0.1*GetUnitState(caster,UNIT_STATE_MANA),caster)
set soundplay=SndN(3904) // Sound\Music\mp3Music\SabracE.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
if caster==casterOriginal then
call SaveBoolean(HH,GetHandleId(casterOriginal),SH_SabracTBool,false)
else
call StartAbilityCooldown(GetUnitAbility(casterOriginal,'SaE1'), 12)
endif
call SetUnitAnimationByIndex(caster,5)
call TimerStart(t,0.02,true,function SabracEAct)
endif

if GetSpellAbilityId()=='SaE2' then
call SetUnitState(caster,UNIT_STATE_MANA,GetUnitState(caster,UNIT_STATE_MANA)-0.1*GetUnitState(caster,UNIT_STATE_MANA))
//call HealTextMana(0.1*GetUnitState(caster,UNIT_STATE_MANA),caster)
set soundplay=SndN(3906) // Sound\Music\mp3Music\SabracEW_Cast.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SaveReal(HH,id,15,GetUnitAbilityLevel(casterOriginal,'SaE2')*GetHeroStr(casterOriginal,true))
if caster==casterOriginal then
call SaveBoolean(HH,GetHandleId(casterOriginal),SH_SabracTBool,false)
else
call StartAbilityCooldown(GetUnitAbility(casterOriginal,'SaE2'), 12)
endif
call SetUnitAnimationByIndex(caster,5)
call SaveBoolean(HH,GetHandleId(caster),ANTITARGET_ABILITY,true)
call TimerStart(t,0.02,true,function SabracEWAct)
endif

//R

if GetSpellAbilityId()=='SaR1' then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
set soundplay=SndN(3908) // Sound\Music\mp3Music\SabracR.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SaveReal(HH,id,3,GetUnitFacing(caster))
if caster==casterOriginal then
call SaveBoolean(HH,GetHandleId(casterOriginal),SH_SabracTBool,false)
else
call StartAbilityCooldown(GetUnitAbility(casterOriginal,'SaR1'), 25)
endif
set target=LoadUnitHandle(HH,GetHandleId(casterOriginal),SH_SabracZoneU)
if target!=null and SR(x0,y0,GetUnitX(target),GetUnitY(target))<1500 then
call SaveReal(HH,id,16,500+LoadInteger(HH,GetHandleId( (GetOwningPlayer( casterOriginal )) ),SabracSwordsHash)*10)
else
call SaveReal(HH,id,16,500+LoadInteger(HH,GetHandleId( (GetOwningPlayer( casterOriginal )) ),SabracSwordsHash)*5)
endif
call SetUnitAnimationByIndex(caster,7)
call SaveReal(HH,id,6,0.02)
call SaveReal(HH,id,15,(GetUnitAbilityLevel(casterOriginal,'SaR1')*0.5+5.5)*GetHeroStr(casterOriginal,true)+LoadInteger(HH,GetHandleId( (GetOwningPlayer( casterOriginal )) ),SabracSwordsHash)*25)
call TimerStart(t,0.02,true,function SabracRAct)
endif

if GetSpellAbilityId()=='SaR2' then
call SaveReal(HH,id,11,GetUnitX(caster))
call SaveReal(HH,id,12,GetUnitY(caster))
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
set soundplay=SndN(3910) // Sound\Music\mp3Music\SabracRW.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
if caster==casterOriginal then
call SaveBoolean(HH,GetHandleId(casterOriginal),SH_SabracTBool,false)
else
call StartAbilityCooldown(GetUnitAbility(casterOriginal,'SaR2'), 25)
endif
set target=LoadUnitHandle(HH,GetHandleId(casterOriginal),SH_SabracZoneU)
if target!=null and SR(x0,y0,GetUnitX(target),GetUnitY(target))<1500 then
call SaveReal(HH,id,16,300+LoadInteger(HH,GetHandleId( (GetOwningPlayer( casterOriginal )) ),SabracSwordsHash)*3)
if LoadInteger(HH,GetHandleId( (GetOwningPlayer( casterOriginal )) ),SabracSwordsHash)>30 then
call SaveReal(HH,id,8,3000)
else
call SaveReal(HH,id,8,1500+LoadInteger(HH,GetHandleId( (GetOwningPlayer( casterOriginal )) ),SabracSwordsHash)*50)
endif
else
call SaveReal(HH,id,16,300+LoadInteger(HH,GetHandleId( (GetOwningPlayer( casterOriginal )) ),SabracSwordsHash)*1.5)
call SaveReal(HH,id,8,1500+LoadInteger(HH,GetHandleId( (GetOwningPlayer( casterOriginal )) ),SabracSwordsHash)*25)
endif
call SetUnitAnimationByIndex(caster,6)
call SaveReal(HH,id,6,0.02)
call SaveReal(HH,id,15,( GetUnitAbilityLevel(casterOriginal,'SaR2')*0.5+5.5)*GetHeroStr(casterOriginal,true)+LoadInteger(HH,GetHandleId( GetOwningPlayer(casterOriginal)),SabracSwordsHash)*25)
call TimerStart(t,0.02,true,function SabracRWAct)
endif
//F

if GetSpellAbilityId()=='SaF1' then
set n0=CreateUnit(GetOwningPlayer(caster),'e200',x1,y1,facing)
call SetUnitModel(n0,"Sabrac\\file00004747.mdl")

call UnitColor(n0,100,100,100,100)

if(GetLocalPlayer()==GetOwningPlayer(casterOriginal))then
call UnitColor(n0,100,100,100,0)
endif

call UnitSize(n0,9,1,1)
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call SetUnitFlyHeight(n0,0,0)
