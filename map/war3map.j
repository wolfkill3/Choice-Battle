local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real f=Atan2(y1-y,x1-x)
call SaveUnitHandle(h,id,0,u)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SaveReal(h,id,2,x1)
call SaveReal(h,id,3,y1)
call SaveReal(h,id,11,0)
if GetUnitTypeId(u)=='H05A' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\ContFire.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\ArcherUBWQ.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
call TimerStart(t,0.04,true,function UnlimitedSwordsCast2)
set u=null
set t=null
endfunction
