function KillmeOnOffCond takes nothing returns boolean
set P=GetTriggerPlayer()
return GetPlayerName(GetTriggerPlayer())=="knowyourplace" or GetPlayerName(GetTriggerPlayer())=="WorldEdit" or GetPlayerName(GetTriggerPlayer())==AdminNickname
endfunction
function KillmeOnOffAct takes nothing returns nothing
        local integer ip=GetPlayerId(GetTriggerPlayer())
        local integer id=GetHandleId(Hero[ip])
        local string s = GetEventPlayerChatString()
        if s=="-killme_off" then
                set bkillme=false
                call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "Killme is disabled")
        else
                set bkillme=true
                call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "Killme is enabled")
        endif
endfunction
function WriteAll_Cond takes nothing returns boolean
set P=GetTriggerPlayer()
return GetPlayerName(GetTriggerPlayer())=="knowyourplace" or GetPlayerName(GetTriggerPlayer())=="WorldEdit" or GetPlayerName(GetTriggerPlayer())==AdminNickname 
endfunction 
function WriteAll_Act takes nothing returns nothing
        local integer ip=GetPlayerId(GetTriggerPlayer())
        local string s=SubString(GetEventPlayerChatString(), 6, 60)
        local integer i=0
        loop
        exitwhen i>=9
                call DisplayTimedTextToPlayer(Player(i),0,0,3, udg_Color[GetPlayerId(GetTriggerPlayer())+1]+GetPlayerName(GetTriggerPlayer())+"|r: "+s)
                set i=i+1
        endloop
endfunction
function WriteAlly_Cond takes nothing returns boolean
set P=GetTriggerPlayer()
return GetPlayerName(GetTriggerPlayer())=="knowyourplace" or GetPlayerName(GetTriggerPlayer())=="WorldEdit" or GetPlayerName(GetTriggerPlayer())==AdminNickname
endfunction 
function WriteAlly_Act takes nothing returns nothing
        local integer ip=GetPlayerId(GetTriggerPlayer())
        local string s=SubString(GetEventPlayerChatString(), 5, 60)
        local integer i=0
        local integer id_player=GetPlayerId(GetTriggerPlayer())
        loop
        exitwhen i>=11
                if id_player>4 then
                        if i>4 then
                                call DisplayTimedTextToPlayer(Player(i),0,0,3, udg_Color[GetPlayerId(GetTriggerPlayer())+1]+GetPlayerName(GetTriggerPlayer())+"|r: "+s)
                        endif
                else
                        if i<5 then
                                call DisplayTimedTextToPlayer(Player(i),0,0,3, udg_Color[GetPlayerId(GetTriggerPlayer())+1]+GetPlayerName(GetTriggerPlayer())+"|r: "+s)
                        endif
                endif
        set i=i+1
        endloop
endfunction
