//export code
function GetDialog takes nothing returns dialog
    return LoadDialogHandle( GameHashTable, GetHandleId( GameHashTable ), SH_ModeDialog )
endfunction     

function DialogShow takes dialog DialogName, boolean Show returns nothing
    local integer i = 0

    loop
        exitwhen i > 11
        call DialogDisplay( Player( i ), DialogName, Show )
        set i = i + 1
    endloop
endfunction

//#ExportEnd
//#ExportTo Scripts\W3MMD\Functions.j
function GetMMDInt takes string HashName returns integer
    return LoadInteger( W3MMDTable, GetHandleId( W3MMDTable ), StringHash( HashName ) )
endfunction

function SetMMDInt takes string HashName, integer LocInt returns nothing
    call SaveInteger( W3MMDTable, GetHandleId( W3MMDTable ), StringHash( HashName ), LocInt )
endfunction

function GetMMDStr takes string HashName returns string
    return LoadStr( W3MMDTable, GetHandleId( W3MMDTable ), StringHash( HashName ) )
endfunction

function SetMMDStr takes string HashName, string LocStr returns nothing
    call SaveStr( W3MMDTable, GetHandleId( W3MMDTable ), StringHash( HashName ), LocStr )
endfunction
//#ExportEnd
//#ExportTo Scripts\W3MMD\System.j
function W3MMD_Lite_Is_Player_In_Game takes player MMD_Player returns boolean
    return GetPlayerController( MMD_Player ) == MAP_CONTROL_USER and GetPlayerSlotState( MMD_Player ) == PLAYER_SLOT_STATE_PLAYING
endfunction

function W3MMD_Lite_Player takes nothing returns integer
    local integer PID = 0

    loop
        exitwhen W3MMD_Lite_Is_Player_In_Game( Player( PID ) ) or PID >= bj_MAX_PLAYERS
        set PID = PID + 1
    endloop

    return PID
endfunction

function W3MMD_Lite_Send takes string message returns nothing // KEY = "val:0" | CHECKSUM = 0
    local integer PID = W3MMD_Lite_Player( )
    call StoreInteger( W3MMD_Lite_Cache, "val:0", message, 0 )
    if GetLocalPlayer( ) == Player( PID ) then
        call SyncStoredInteger( W3MMD_Lite_Cache, "val:0", message )
    endif
    //call FlushStoredInteger( W3MMD_Lite_Cache, "val:0", message )
endfunction

function W3MMD_Lite_Send_Player takes player MMD_Player, string message returns nothing
    if W3MMD_Lite_Is_Player_Initialized[ GetPlayerId( MMD_Player ) ] then
        call W3MMD_Lite_Send( message )
    endif
endfunction

function W3MMD_Lite_Flag takes player MMD_Player, string flag returns nothing
    if GetPlayerController( MMD_Player ) == MAP_CONTROL_USER then
        if GetPlayerSlotState( MMD_Player ) != PLAYER_SLOT_STATE_LEFT then
            call W3MMD_Lite_Send_Player( MMD_Player, "FlagP " + I2S( GetPlayerId( MMD_Player ) ) + " " + flag )
        else
            call W3MMD_Lite_Send_Player( MMD_Player, "FlagP " + I2S( GetPlayerId( MMD_Player ) ) + " " + "leaver" )
        endif
    endif
endfunction

function W3MMD_Lite_Flag_Winner takes player MMD_Player returns nothing
    call W3MMD_Lite_Flag( MMD_Player, "winner" )
endfunction

function W3MMD_Lite_Flag_Loser takes player MMD_Player returns nothing
    call W3MMD_Lite_Flag( MMD_Player, "loser" )
endfunction

function W3MMD_Lite_Flag_Drawer takes player MMD_Player returns nothing
    call W3MMD_Lite_Flag( MMD_Player, "drawer" )
endfunction

function W3MMD_Lite_Flag_Practicing takes player MMD_Player returns nothing
    call W3MMD_Lite_Flag( MMD_Player, "practicing" )
endfunction

function W3MMD_Lite_Flag_Leaver takes player MMD_Player returns nothing
    call W3MMD_Lite_Flag( MMD_Player, "leaver" )
endfunction

function W3MMD_Lite_Register takes string name, string the_type returns nothing
    if name != null and name != "" and StringLength( name ) <= 32 and not HaveStoredString( W3MMD_Lite_Cache, "variables", name ) then
        call StoreString( W3MMD_Lite_Cache, "variables", name, the_type )
        call W3MMD_Lite_Send( "DefVarP " + name + " " + the_type + " none none" )
    endif
endfunction

function W3MMD_Lite_Register_Integer takes string name returns nothing
    call W3MMD_Lite_Register( name, "int" )
endfunction

function W3MMD_Lite_Register_Real takes string name returns nothing
    call W3MMD_Lite_Register( name, "real" )
endfunction

function W3MMD_Lite_Register_String takes string name returns nothing
    call W3MMD_Lite_Register( name, "string" )
endfunction

function W3MMD_Lite_Update takes player MMD_Player, string name, string operator, string value returns nothing
    if HaveStoredString( W3MMD_Lite_Cache, "variables", name ) then
        call W3MMD_Lite_Send_Player( MMD_Player, "VarP " + I2S( GetPlayerId( MMD_Player ) ) + " " + name + " " + operator + " " + value )
    endif
endfunction

function W3MMD_Lite_Set_Integer takes player MMD_Player, string name, integer value returns nothing
    call W3MMD_Lite_Update( MMD_Player, name, "=", I2S( value ) )
endfunction

function W3MMD_Lite_Add_Integer takes player MMD_Player, string name, integer value returns nothing
    call W3MMD_Lite_Update( MMD_Player, name, "+=", I2S( value ) )
endfunction

function W3MMD_Lite_Subtract_Integer takes player MMD_Player, string name, integer value returns nothing
    call W3MMD_Lite_Update( MMD_Player, name, "-=", I2S( value ) )
endfunction

function W3MMD_Lite_Set_Real takes player MMD_Player, string name, real value returns nothing
    call W3MMD_Lite_Update( MMD_Player, name, "=", R2S( value ) )
endfunction

function W3MMD_Lite_Add_Real takes player MMD_Player, string name, real value returns nothing
    call W3MMD_Lite_Update( MMD_Player, name, "+=", R2S( value ) )
endfunction

function W3MMD_Lite_Subtract_Real takes player MMD_Player, string name, real value returns nothing
    call W3MMD_Lite_Update( MMD_Player, name, "-=", R2S( value ) )
endfunction

function W3MMD_Lite_Set_String takes player MMD_Player, string name, string value returns nothing
    call W3MMD_Lite_Update( MMD_Player, name, "=", value )
endfunction

function W3MMDInit takes nothing returns nothing
    local integer MMD_Player_index = 0

    call FlushGameCache( InitGameCache( "MMD.Dat" ) )
    set W3MMD_Lite_Cache = InitGameCache( "MMD.Dat" )
    call W3MMD_Lite_Send( "init version " + I2S( 1 ) + " " + I2S( 1 ) ) // VERSION_MINIMUM and VERSION_CURRENT = 1

    loop
        if W3MMD_Lite_Is_Player_In_Game( Player( MMD_Player_index ) ) then
            set W3MMD_Lite_Is_Player_Initialized[ MMD_Player_index ] = true
            call W3MMD_Lite_Send( "init pid " + I2S( MMD_Player_index ) + " " + GetPlayerName( Player( MMD_Player_index ) ) )
        endif

        set MMD_Player_index = MMD_Player_index + 1
        exitwhen MMD_Player_index >= bj_MAX_PLAYERS
    endloop
endfunction

function CustomDefeatRW takes player whichPlayer, string message returns nothing
    call W3MMD_Lite_Flag_Loser( whichPlayer )
    //call CustomDefeatBJ( whichPlayer, message )
endfunction

function CustomVictoryRW takes player whichPlayer, boolean showDialog, boolean showScores returns nothing
    call W3MMD_Lite_Flag_Winner( whichPlayer )
    //call CustomVictoryBJ( whichPlayer, true, true )
endfunction     
//#ExportEnd
//#ExportTo Scripts\W3MMD\Forfeit.j
function ForfeitGame takes nothing returns nothing
    local integer index = 0

    if GetMMDStr( "Flag" ) != "" then
        loop
            exitwhen index > 9

            if GetPlayerSlotState( Player( index ) ) == PLAYER_SLOT_STATE_PLAYING then
                if GetPlayerTeam( Player( index ) ) != GetMMDInt( "LostTeam" ) then
                    if FFAMode==false then
                        call CustomVictoryRW( Player( index ), true, true )
                    endif
                else
                    call CustomDefeatRW( Player( index ), "Your team has forfeited!" )
                endif
            endif

            set index = index + 1
        endloop 
    endif
endfunction

function TeamMessage takes player LocPlayer, real LocDur, string LocText returns nothing
    if GetPlayerTeam( GetLocalPlayer( ) ) == GetPlayerTeam( LocPlayer ) then
        call DisplayTimedTextToPlayer( GetLocalPlayer( ), 0, 0, LocDur, LocText )
    endif
endfunction     

function ResetForfeitVotes takes nothing returns nothing
    local integer i = 0

    loop
        exitwhen i > 9
        if GetPlayerTeam( Player( i ) ) == LoadInteger( W3MMDTable, GetHandleId( GetExpiredTimer( ) ), SH_VotedTeam ) - 1 then
            call SaveBoolean( W3MMDTable, GetHandleId( Player( i ) ), SH_Voted, false )
        endif
        set i = i + 1
    endloop
    
    if LoadInteger( W3MMDTable, GetHandleId( GetExpiredTimer( ) ), SH_VotedTeam ) - 1 == 0 then
        set i = 0
    else
        set i = 6
    endif

    call TeamMessage( Player( i ), 10, "Votes to end the game have been reset." )
    call SetMMDInt( "VotesTeam" + I2S( LoadInteger( W3MMDTable, GetHandleId( GetExpiredTimer( ) ), SH_VotedTeam ) ), 0 )
    call DestroyTimer( GetExpiredTimer( ) )
endfunction

function VoteTimer takes string LocTeam returns integer
    call SaveTimerHandle( W3MMDTable, GetHandleId( W3MMDTable ), StringHash( LocTeam ), CreateTimer( ) )
    return GetHandleId( LoadTimerHandle( W3MMDTable, GetHandleId( W3MMDTable ), StringHash( LocTeam ) ) )
endfunction

function ForfeitAction takes nothing returns nothing
    local integer HandleID
    local integer PlayerID = GetPlayerId( GetTriggerPlayer( ) )
    local integer PlayerTeam = GetPlayerTeam( GetTriggerPlayer( ) ) + 1
    local boolean HasVoted = LoadBoolean( W3MMDTable, GetHandleId( Player( PlayerID ) ), SH_Voted )
    if HasVoted == false then
        if GetMMDInt( "W3MMDTime" ) >= 10 then
            call SetMMDInt( "VotesTeam" + I2S( PlayerTeam ), GetMMDInt( "VotesTeam" + I2S( PlayerTeam ) ) + 1 )
            call SaveBoolean( W3MMDTable, GetHandleId( Player( PlayerID ) ), SH_Voted, true )
            if GetMMDInt( "VotesTeam" + I2S( PlayerTeam ) ) == 1 then
                call TeamMessage( GetTriggerPlayer( ), 10, "Your Team has decided to forfeit, you have 20 seconds to vote!" )
                set HandleID = VoteTimer( "Team" + I2S( PlayerTeam - 1 ) )
                call SaveInteger( W3MMDTable, HandleID, SH_VotedTeam, PlayerTeam )
                call TimerStart( LoadTimerHandle( W3MMDTable, GetHandleId( W3MMDTable ), StringHash( "Team" + I2S( PlayerTeam - 1 ) ) ), 20, false, function ResetForfeitVotes )
            endif

            if GetMMDInt( "VotesTeam" + I2S( PlayerTeam ) ) >= GetMMDInt( "TotalTeam" + I2S( PlayerTeam ) ) - 1 then
                call TeamMessage( GetTriggerPlayer( ), 10, "Vote to end the game has been successful!" )
                call SetMMDInt( "LostTeam", PlayerTeam - 1 )
                call ForfeitGame( )
            else
                call TeamMessage( GetTriggerPlayer( ), 10, "Votes needed to forfeit: " + I2S( ( GetMMDInt( "TotalTeam" + I2S( PlayerTeam ) ) - 1 ) - GetMMDInt( "VotesTeam" + I2S( PlayerTeam ) ) ) )
            endif
        else
            call DisplayTimedTextToPlayer( GetTriggerPlayer( ), 0, 0, 10, "You can't vote before 10 minites has passed!" )
            call DisplayTimedTextToPlayer( GetTriggerPlayer( ), 0, 0, 10, "-ff will be available in: " + I2S( 10 - GetMMDInt( "W3MMDTime" ) ) + " minutes!" )
        endif
    endif
endfunction

function ForfeitActionFFA takes nothing returns nothing
    local integer HandleID
    local integer PlayerID = GetPlayerId( GetTriggerPlayer( ) )
    local boolean HasVoted = LoadBoolean( W3MMDTable, GetHandleId( Player( PlayerID ) ), SH_Voted )
    if HasVoted == false then
        if GetMMDInt( "W3MMDTime" ) >= 10 then
            call SaveBoolean( W3MMDTable, GetHandleId( Player( PlayerID ) ), SH_Voted, true )
            //call TeamMessage( GetTriggerPlayer( ), 10, "Vote to end the game has been successful!" )
            call ForfeitGame( )
        else
            call DisplayTimedTextToPlayer( GetTriggerPlayer( ), 0, 0, 10, "You can't vote before 10 minites has passed!" )
            call DisplayTimedTextToPlayer( GetTriggerPlayer( ), 0, 0, 10, "-ff will be available in: " + I2S( 10 - GetMMDInt( "W3MMDTime" ) ) + " minutes!" )
        endif
    endif
endfunction

function SetTotalPlayersFFA takes nothing returns nothing
    call SetMMDInt( "TotalPlayers", GetMMDInt( "TotalPlayers" ) - 1 )
    call W3MMD_Lite_Flag_Leaver( GetTriggerPlayer( ) )
endfunction

function SetTotalPlayers takes nothing returns nothing
    if IsPlayerAlly( Player( 0 ), GetTriggerPlayer( ) ) then
        call SetMMDInt( "TotalTeam1", GetMMDInt( "TotalTeam1" ) - 1 )
    else
        call SetMMDInt( "TotalTeam2", GetMMDInt( "TotalTeam2" ) - 1 )
    endif
    call SetMMDInt( "TotalPlayers", GetMMDInt( "TotalPlayers" ) - 1 )
    call W3MMD_Lite_Flag_Leaver( GetTriggerPlayer( ) )
endfunction

function W3MMDTimer takes nothing returns nothing
    if GetMMDInt( "TimeSeconds" ) == 59 then
        call SetMMDInt( "TimeSeconds", 0 )
        call SetMMDInt( "TimeMinutes", GetMMDInt( "TimeMinutes" ) + 1 )
        call SetMMDInt( "W3MMDTime", GetMMDInt( "W3MMDTime" ) + 1 )
    else
        call SetMMDInt( "TimeSeconds", GetMMDInt( "TimeSeconds" ) + 1 )
    endif               

    if GetMMDInt( "TimeMinutes" ) == 59 then
        call SetMMDInt( "TimeMinutes", 0 )
        call SetMMDInt( "TimeHours", GetMMDInt( "TimeHours" ) + 1 )
    endif
endfunction    

function ActivateForfeit2 takes nothing returns nothing
    local integer i = 0
    call W3MMD_Lite_Flag_Practicing(Player(10))
    call W3MMD_Lite_Flag_Practicing(Player(11))
    if FFAMode==false then
        call DisplayTimedTextToPlayer( GetLocalPlayer( ), 0, 0, 5, Lng("|c0000FF00-ff включён!|r","|c0000FF00-ff turned on!|r") )
        call SaveTriggerHandle( W3MMDTable, GetHandleId( W3MMDTable ), SH_GetVotesTrig, CreateTrigger( ) )
        call SaveTriggerHandle( W3MMDTable, GetHandleId( W3MMDTable ), SH_GetLeaveTrig, CreateTrigger( ) )
        call SetMMDInt( "VotesTeam1", 0 )
        call SetMMDInt( "VotesTeam2", 0 )
        
        loop
            exitwhen i > 9
            call TriggerRegisterPlayerEvent( LoadTriggerHandle( W3MMDTable, GetHandleId( W3MMDTable ), SH_GetLeaveTrig ), Player(i), EVENT_PLAYER_LEAVE)
            call TriggerRegisterPlayerChatEvent( LoadTriggerHandle( W3MMDTable, GetHandleId( W3MMDTable ), SH_GetVotesTrig ), Player(i), "-ff", true)
            
            if GetPlayerSlotState( Player( i ) ) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController( Player( i ) ) == MAP_CONTROL_USER then
                if IsPlayerAlly( Player( 0 ), Player( i ) ) then
                    call SetMMDInt( "TotalTeam1", GetMMDInt( "TotalTeam1" ) + 1 )
                else
                    call SetMMDInt( "TotalTeam2", GetMMDInt( "TotalTeam2" ) + 1 )
                endif

                call SetMMDInt( "TotalPlayers", GetMMDInt( "TotalPlayers" ) + 1 )
            endif
            
            set i = i + 1
        endloop
        call TriggerAddAction( LoadTriggerHandle( W3MMDTable, GetHandleId( W3MMDTable ), SH_GetLeaveTrig ), function SetTotalPlayers)
        call TriggerAddAction( LoadTriggerHandle( W3MMDTable, GetHandleId( W3MMDTable ), SH_GetVotesTrig ), function ForfeitAction)
        call TimerStart( CreateTimer( ), 1, true, function W3MMDTimer )
    else
        call DisplayTimedTextToPlayer( GetLocalPlayer( ), 0, 0, 5, Lng("|c0000FF00-ff включён!|r","|c0000FF00-ff turned on!|r") )
        call SaveTriggerHandle( W3MMDTable, GetHandleId( W3MMDTable ), SH_GetVotesTrig, CreateTrigger( ) )
        call SaveTriggerHandle( W3MMDTable, GetHandleId( W3MMDTable ), SH_GetLeaveTrig, CreateTrigger( ) )
        
        loop
            exitwhen i > 9
            call TriggerRegisterPlayerEvent( LoadTriggerHandle( W3MMDTable, GetHandleId( W3MMDTable ), SH_GetLeaveTrig ), Player(i), EVENT_PLAYER_LEAVE)
            call TriggerRegisterPlayerChatEvent( LoadTriggerHandle( W3MMDTable, GetHandleId( W3MMDTable ), SH_GetVotesTrig ), Player(i), "-ff", true)
            
            if GetPlayerSlotState( Player( i ) ) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController( Player( i ) ) == MAP_CONTROL_USER then

                call SetMMDInt( "TotalPlayers", GetMMDInt( "TotalPlayers" ) + 1 )
            endif
            
            set i = i + 1
        endloop
        call TriggerAddAction( LoadTriggerHandle( W3MMDTable, GetHandleId( W3MMDTable ), SH_GetLeaveTrig ), function SetTotalPlayersFFA)
        call TriggerAddAction( LoadTriggerHandle( W3MMDTable, GetHandleId( W3MMDTable ), SH_GetVotesTrig ), function ForfeitActionFFA)
        call TimerStart( CreateTimer( ), 1, true, function W3MMDTimer )
    endif
endfunction

function ActivateForfeit takes nothing returns nothing
    local integer i = 0
    
    call DialogShow( GetDialog( ), false )
    call DialogClear( GetDialog( ) )
    call TimerDialogDisplay( LoadTimerDialogHandle( GameHashTable, GetHandleId( GameHashTable ), SH_TimerDialog1 ), false )
    call W3MMD_Lite_Flag_Practicing(Player(10))
    call W3MMD_Lite_Flag_Practicing(Player(11))
    if LoadInteger( GameHashTable, GetHandleId( GameHashTable ), SH_ButtonID10 ) > LoadInteger( GameHashTable, GetHandleId( GameHashTable ), SH_ButtonID11 ) then
        if FFAMode==false then
            call DisplayTimedTextToPlayer( GetLocalPlayer( ), 0, 0, 5, Lng("|c0000FF00-ff включён!|r","|c0000FF00-ff turned on!|r") )
            call SaveTriggerHandle( W3MMDTable, GetHandleId( W3MMDTable ), SH_GetVotesTrig, CreateTrigger( ) )
            call SaveTriggerHandle( W3MMDTable, GetHandleId( W3MMDTable ), SH_GetLeaveTrig, CreateTrigger( ) )
            call SetMMDInt( "VotesTeam1", 0 )
            call SetMMDInt( "VotesTeam2", 0 )
            
            loop
                exitwhen i > 9
                call TriggerRegisterPlayerEvent( LoadTriggerHandle( W3MMDTable, GetHandleId( W3MMDTable ), SH_GetLeaveTrig ), Player(i), EVENT_PLAYER_LEAVE)
                call TriggerRegisterPlayerChatEvent( LoadTriggerHandle( W3MMDTable, GetHandleId( W3MMDTable ), SH_GetVotesTrig ), Player(i), "-ff", true)
                
                if GetPlayerSlotState( Player( i ) ) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController( Player( i ) ) == MAP_CONTROL_USER then
                    if IsPlayerAlly( Player( 0 ), Player( i ) ) then
                        call SetMMDInt( "TotalTeam1", GetMMDInt( "TotalTeam1" ) + 1 )
                    else
                        call SetMMDInt( "TotalTeam2", GetMMDInt( "TotalTeam2" ) + 1 )
                    endif

                    call SetMMDInt( "TotalPlayers", GetMMDInt( "TotalPlayers" ) + 1 )
                endif
                
                set i = i + 1
            endloop
            call TriggerAddAction( LoadTriggerHandle( W3MMDTable, GetHandleId( W3MMDTable ), SH_GetLeaveTrig ), function SetTotalPlayers)
            call TriggerAddAction( LoadTriggerHandle( W3MMDTable, GetHandleId( W3MMDTable ), SH_GetVotesTrig ), function ForfeitAction)
            call TimerStart( CreateTimer( ), 1, true, function W3MMDTimer )
        else
            call DisplayTimedTextToPlayer( GetLocalPlayer( ), 0, 0, 5, Lng("|c0000FF00-ff включён!|r","|c0000FF00-ff turned on!|r") )
            call SaveTriggerHandle( W3MMDTable, GetHandleId( W3MMDTable ), SH_GetVotesTrig, CreateTrigger( ) )
            call SaveTriggerHandle( W3MMDTable, GetHandleId( W3MMDTable ), SH_GetLeaveTrig, CreateTrigger( ) )
            
            loop
                exitwhen i > 9
                call TriggerRegisterPlayerEvent( LoadTriggerHandle( W3MMDTable, GetHandleId( W3MMDTable ), SH_GetLeaveTrig ), Player(i), EVENT_PLAYER_LEAVE)
                call TriggerRegisterPlayerChatEvent( LoadTriggerHandle( W3MMDTable, GetHandleId( W3MMDTable ), SH_GetVotesTrig ), Player(i), "-ff", true)
                
                if GetPlayerSlotState( Player( i ) ) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController( Player( i ) ) == MAP_CONTROL_USER then

                    call SetMMDInt( "TotalPlayers", GetMMDInt( "TotalPlayers" ) + 1 )
                endif
                
                set i = i + 1
            endloop
            call TriggerAddAction( LoadTriggerHandle( W3MMDTable, GetHandleId( W3MMDTable ), SH_GetLeaveTrig ), function SetTotalPlayersFFA)
            call TriggerAddAction( LoadTriggerHandle( W3MMDTable, GetHandleId( W3MMDTable ), SH_GetVotesTrig ), function ForfeitActionFFA)
            call TimerStart( CreateTimer( ), 1, true, function W3MMDTimer )
        endif
    else
        call DisplayTimedTextToPlayer( GetLocalPlayer( ), 0, 0, 5, Lng("|c00ff0000-ff выключен!|r","|c00ff0000-ff turned off!|r") )
    endif
endfunction

function ModeSelectionFunction2 takes nothing returns nothing
    if GetClickedButton( ) == LoadButtonHandle( GameHashTable, GetHandleId( GameHashTable ), SH_Button10 ) then
        call SaveInteger( GameHashTable, GetHandleId( GameHashTable ), SH_ButtonID10, LoadInteger( GameHashTable, GetHandleId( GameHashTable ), SH_ButtonID10 ) + 1 )
    endif

    if GetClickedButton( ) == LoadButtonHandle( GameHashTable, GetHandleId( GameHashTable ), SH_Button11 ) then
        call SaveInteger( GameHashTable, GetHandleId( GameHashTable ), SH_ButtonID11, LoadInteger( GameHashTable, GetHandleId( GameHashTable ), SH_ButtonID11 ) + 1 )
    endif
endfunction	

function StartVoting takes nothing returns nothing
if ValidHLC() then
    call TimerStart( LoadTimerHandle( GameHashTable, GetHandleId( GameHashTable ), SH_Timer0 ), 60, false, function ActivateForfeit2 )	
else
    call DisplayTimedTextToPlayer( GetLocalPlayer( ), 0, 0, 5, Lng("Идёт выбор на включение/отключение команды -ff","There is a choice to enable/disable the command -ff") )
    call SaveTimerDialogHandle( GameHashTable, GetHandleId( GameHashTable ), SH_TimerDialog1, CreateTimerDialog( LoadTimerHandle( GameHashTable, GetHandleId( GameHashTable ), SH_Timer0 ) ) )
    call LANG_TdTitle(LoadTimerDialogHandle( GameHashTable, GetHandleId( GameHashTable ), SH_TimerDialog1 ),"|c00ffff00Время голосования!","|c00ffff00Vote Time!")
    call TimerDialogDisplay( LoadTimerDialogHandle( GameHashTable, GetHandleId( GameHashTable ), SH_TimerDialog1 ), true )
    call DialogSetMessage( GetDialog( ), Lng("Включить -ff?","turn on -ff?") )
    call SaveButtonHandle( GameHashTable, GetHandleId( GameHashTable ), SH_Button10, DialogAddButton( GetDialog( ), Lng("Да","Yes"), 0 ) )
    call SaveButtonHandle( GameHashTable, GetHandleId( GameHashTable ), SH_Button11, DialogAddButton( GetDialog( ), Lng("Нет","No"), 0 ) )
    call DialogShow( GetDialog( ), true )
    call TimerStart( LoadTimerHandle( GameHashTable, GetHandleId( GameHashTable ), SH_Timer0 ), 5, false, function ActivateForfeit )	
endif
endfunction

function InitForfeit takes nothing returns nothing
    local trigger LocTrigger = CreateTrigger( )
    call SaveDialogHandle( GameHashTable, GetHandleId( GameHashTable ), SH_ModeDialog, DialogCreate( ) )
    call TriggerRegisterDialogEvent( LocTrigger, GetDialog( ) )
    call TriggerAddAction( LocTrigger, function ModeSelectionFunction2 )
    call SaveTimerHandle( GameHashTable, GetHandleId( GameHashTable), SH_Timer0, CreateTimer( ) )
    call TimerStart( LoadTimerHandle( GameHashTable, GetHandleId( GameHashTable ), SH_Timer0 ), 4, false, function StartVoting ) // было 1 с: +3 с на загрузку данных
    set LocTrigger = null
endfunction

function PlayerOn takes integer i returns boolean
        return GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING
endfunction

function LastDamageIndicator takes nothing returns nothing
	local integer i = 0
	local integer id = 0
	local real total_damage   = 0.0
    local real tanked_damage  = 0.0
	local real hero_damage 	  = 0.0
	local real general_resist = 0.0
	local real shield 		  = 0.0
    local real HealSelf    = 0.0
    local real HealAlly    = 0.0
    local real MPSelf               = 0.0
    local real MPAlly               = 0.0
	local string s 			  = ""
    call SetFrameFont( GetOriginFrame( ORIGIN_FRAME_UNIT_MSG, 0 ), "Fonts\\FRIZQT__.TTF", .011, 0 )
	loop
	exitwhen i>=10
		set id = GetHandleId(Player(i))
		set total_damage   = LoadReal(HH, id, TD_INDICATOR)
        set tanked_damage  = LoadReal(HH, id, TTD_INDICATOR)
		set hero_damage    = LoadReal(HH, id, HD_INDICATOR)
		set general_resist = LoadReal(HH, id, GR_INDICATOR)
		set shield 		   = LoadReal(HH, id, TS_INDICATOR)
        set HealSelf    = LoadReal(HH, id, TSH_INDICATOR)
        set HealAlly    = LoadReal(HH, id, TAH_INDICATOR)
        set MPSelf      = LoadReal(HH, id, TSM_INDICATOR)
        set MPAlly      = LoadReal(HH, id, TAM_INDICATOR)
		set s = GetPlayerName(Player(i)) + "                                                  "
		set s = SubString(s, 0, 25)
		call DisplayTimedTextToAllPlayers(100, udg_Color[i+1]+s+"["+I2S(i)+"] ["+GetUnitName(Hero[i])+"]: |r"+" |c00FFFF00Damage Dealt: |r"+I2S(R2I(total_damage))+", |c00FFA042Damage Taken: |r"+I2S(R2I(tanked_damage))+",  |c000080C0General Resist: |r"+I2S(R2I(general_resist))+"\n|c008080FFShield: |r"+I2S(R2I(shield))+", |c0000FF40Self Heal: |r"+I2S(R2I(HealSelf))+",  |c00B7FB84Ally Heal: |r"+I2S(R2I(HealAlly))+",  |c000080FFSelf MP: |r"+I2S(R2I(MPSelf))+",  |c0016D9E9Ally MP: |r"+I2S(R2I(MPAlly))+"")
    set i=i+1
	endloop
endfunction

function W3mmdPlayercheck takes unit u returns nothing
    local integer i = GetPlayerId(GetOwningPlayer(u))
    local player p=GetOwningPlayer(u)
    local integer id = GetHandleId(p)
    local real total_damage   = LoadReal(HH, id, TD_INDICATOR)
    local real tanked_damage  = LoadReal(HH, id, TTD_INDICATOR)
    local real hero_damage    = LoadReal(HH, id, HD_INDICATOR)
    local real general_resist = LoadReal(HH, id, GR_INDICATOR)
    local real shield 		   = LoadReal(HH, id, TS_INDICATOR)
    local real HealSelf    = LoadReal(HH, id, TSH_INDICATOR)
    local real HealAlly    = LoadReal(HH, id, TAH_INDICATOR)
    local real MPSelf      = LoadReal(HH, id, TSM_INDICATOR)
    local real MPAlly      = LoadReal(HH, id, TAM_INDICATOR)



    call W3MMD_Lite_Set_Integer(p,"Kill",udg_kill[ i ] )
    call W3MMD_Lite_Set_Integer(p,"Death",udg_death[ i ] )
    call W3MMD_Lite_Set_Integer(p,"Assist",udg_assist[ i ] )

    call W3MMD_Lite_Set_Integer(p,"Damage",R2I(total_damage) )
    call W3MMD_Lite_Set_Integer(p,"Tanked",R2I(tanked_damage))
    call W3MMD_Lite_Set_Integer(p,"Resist",R2I(general_resist))
    call W3MMD_Lite_Set_Integer(p,"Shield",R2I(shield))
    call W3MMD_Lite_Set_Integer(p,"HealSelf",R2I(HealSelf))
    call W3MMD_Lite_Set_Integer(p,"HealAlly",R2I(HealAlly))
    call W3MMD_Lite_Set_Integer(p,"MPSelf",R2I(MPSelf))
    call W3MMD_Lite_Set_Integer(p,"MPAlly",R2I(MPAlly))



    call W3MMD_Lite_Set_Integer(p,"Slot1", GetItemTypeId(UnitItemInSlot(udg_Hero[i+1],0) ))
    call W3MMD_Lite_Set_Integer(p,"Slot2", GetItemTypeId(UnitItemInSlot(udg_Hero[i+1],1) ))
    call W3MMD_Lite_Set_Integer(p,"Slot3", GetItemTypeId(UnitItemInSlot(udg_Hero[i+1],2) ))
    call W3MMD_Lite_Set_Integer(p,"Slot4", GetItemTypeId(UnitItemInSlot(udg_Hero[i+1],3) ))
    call W3MMD_Lite_Set_Integer(p,"Slot5", GetItemTypeId(UnitItemInSlot(udg_Hero[i+1],4) ))
    call W3MMD_Lite_Set_Integer(p,"Slot6", GetItemTypeId(UnitItemInSlot(udg_Hero[i+1],5) ))
    call W3MMD_Lite_Set_Integer(p,"Slot7", GetItemTypeId(UnitItemInSlot(udg_Hero[i+1],6) ))
    call W3MMD_Lite_Set_Integer(p,"Slot8", GetItemTypeId(UnitItemInSlot(udg_Hero[i+1],7) ))
    call W3MMD_Lite_Set_Integer(p,"Slot9", GetItemTypeId(UnitItemInSlot(udg_Hero[i+1],8) ))
    call W3MMD_Lite_Set_Integer(p,"Slot10", GetItemTypeId(UnitItemInSlot(udg_Hero[i+1],9) ))

    set p=null
endfunction

function DamageIndicatorForAll_Cond takes nothing returns boolean
        return true
endfunction

function DamageIndicatorForAll takes nothing returns nothing
        local player newPlayer = GetTriggerPlayer()
        local integer i = 0
        local integer id = 0
        local real total_damage   = 0.0
        local real tanked_damage  = 0.0
        local real hero_damage    = 0.0
        local real general_resist = 0.0
        local real shield               = 0.0
        local string s                    = ""
        loop
        exitwhen i>=10
                set id = GetHandleId(Player(i))
                set total_damage   = LoadReal(HH, id, TD_INDICATOR)
                set tanked_damage  = LoadReal(HH, id, TTD_INDICATOR)
                set hero_damage    = LoadReal(HH, id, HD_INDICATOR)
                set general_resist = LoadReal(HH, id, GR_INDICATOR)
                set shield                 = LoadReal(HH, id, TS_INDICATOR)
                set s = GetPlayerName(Player(i)) + "                          "
                set s = SubString(s, 0, 25)
                call DisplayTimedTextToPlayer(newPlayer, 0, 0, 15, udg_Color[i+1]+s+"["+I2S(i)+"] ["+GetUnitName(Hero[i])+"]: |r"+" |c00FFFF00Damage Dealt: |r"+I2S(R2I(total_damage))+", |c00FFA042Damage Taken: |r"+I2S(R2I(tanked_damage))+",  |c000080C0General Resist: |r"+I2S(R2I(general_resist))+",  |c008080FFShield: |r"+I2S(R2I(shield))+"")
        set i=i+1
        endloop
        set newPlayer=null
endfunction

function HealIndicatorForAll takes nothing returns nothing
        local player newPlayer = GetTriggerPlayer()
        local integer i = 0
        local integer id = 0
        local real HealSelf    = 0.0
        local real HealAlly    = 0.0
        local real MPSelf               = 0.0
        local real MPAlly               = 0.0
        local string s                    = ""
        // if udg_B or DU==false then
            loop
            exitwhen i>=10
                    set id = GetHandleId(Player(i))
                    set HealSelf    = LoadReal(HH, id, TSH_INDICATOR)
                    set HealAlly    = LoadReal(HH, id, TAH_INDICATOR)
                    set MPSelf      = LoadReal(HH, id, TSM_INDICATOR)
                    set MPAlly      = LoadReal(HH, id, TAM_INDICATOR)
                    set s = GetPlayerName(Player(i)) + "                          "
                    set s = SubString(s, 0, 25)
                    call DisplayTimedTextToPlayer(newPlayer, 0, 0, 15, udg_Color[i+1]+s+"["+I2S(i)+"] ["+GetUnitName(Hero[i])+"]: |r"+" |c0000FF40Self Heal: |r"+I2S(R2I(HealSelf))+",  |c00B7FB84Ally Heal: |r"+I2S(R2I(HealAlly))+",  |c000080FFSelf MP: |r"+I2S(R2I(MPSelf))+",  |c0016D9E9Ally MP: |r"+I2S(R2I(MPAlly))+"")
            set i=i+1
            endloop
        // else
        //     call DisplayTimedTextToPlayer(newPlayer, 0, 0, 15, "Команда доступна только в конце раунда.")
        // endif
        set newPlayer=null
endfunction

function DamageIndicatorForPlayer takes player newPlayer returns nothing
        local integer id = GetHandleId(newPlayer)
        local real total_damage   = LoadReal(HH, id, TD_INDICATOR)
        local real hero_damage    = LoadReal(HH, id, HD_INDICATOR)
        local real general_resist = LoadReal(HH, id, GR_INDICATOR)
        local real shield                 = LoadReal(HH, id, TS_INDICATOR)
        local string s = GetPlayerName(newPlayer) + "                          "
        set s=SubString(s, 0, 20)
        call DisplayTimedTextToPlayer(newPlayer, 0, 0, 5, udg_Color[GetPlayerId(newPlayer)+1]+s+" ["+I2S(GetPlayerId(newPlayer))+"]: |r"+"  |c00FFFF00Damage Dealt: |r"+I2S(R2I(total_damage))+",  |c000080C0General Resist: |r" +I2S(R2I(general_resist))+",  |c008080FFShield|r: |r" +I2S(R2I(shield))+"")
endfunction

function DamageIndicatorFunction takes unit source, unit target, real damage returns nothing
        local integer id        = GetHandleId(GetOwningPlayer(source))
        local integer id1        = GetHandleId(GetOwningPlayer(target))
        local real total_damage = LoadReal(HH, id, TD_INDICATOR)
        local real tanked_damage = LoadReal(HH, id1, TTD_INDICATOR)
        local real hero_damage = LoadReal(HH, id, HD_INDICATOR)
        if IsUnitType(target, UNIT_TYPE_HERO) then
                call SaveReal(HH, id, HD_INDICATOR, hero_damage+damage)
        endif
        call SaveReal(HH, id, TD_INDICATOR, total_damage+damage)
        call SaveReal(HH, id1, TTD_INDICATOR, tanked_damage+damage)
endfunction

function ResistIndicatorFunction takes unit source, unit target, real damage returns nothing
        local integer id          = GetHandleId(GetOwningPlayer(target))
        local real general_resist = LoadReal(HH, id, GR_INDICATOR)
        call SaveReal(HH, id, GR_INDICATOR, general_resist+damage)
endfunction

function ShieldIndicatorFunction takes unit source, unit target, real damage returns nothing
        local integer id          = GetHandleId(GetOwningPlayer(target))
        local real shield                 = LoadReal(HH, id, TS_INDICATOR)
        call SaveReal(HH, id, TS_INDICATOR, shield+damage)
endfunction

function CustomTrueDamage takes unit source, unit target, real damage returns nothing
    if GetWidgetLife(target)>damage then
        call SetWidgetLife(target, GetWidgetLife(target)-damage)
    else
        call SetUnitInvulnerable(target, false)
        call UnitAddAbility(target, 'A0WR')
	    call myCustomDamage(source, target, damage*1.1, false, false, null, DAMAGE_TYPE_UNIVERSAL, null)
	    call UnitRemoveAbility(target, 'A0WR')
    endif
    call DamageIndicatorFunction(source, target, damage) 
    call DamageTextTag(source, target, damage)
endfunction

// конец функций
//=================
function AbilIdFilter takes integer id returns boolean
    return id != 'A12B' and id != 'A10Q' and id != 'A15A' and id != 'A15E' and id != 'A187' and id != 'A048' and id != 'A049' and id != 'A0WT' and id != 'A04Y' and id != 'A05C' and id != 'A0WU' and id != 'CS05' and id != 'A06J' and id != 'A0VQ' and id != 'A09A' and id != 'A0EH' and id != 'A0YJ' and id != 'A127' and id != 'A1GE' and id != 'A1GK' and id != 'A1I3' and id != 'A19Z' and id != 'A0YZ' and id != 'A1G9' and id != 'A1GB' and id != 'A18G' and id != 'A18K' and id != 'A04H' 
endfunction
function AbilIdFilter2 takes integer id returns boolean
    return id != 'A0HL' and id != 'A0X0' and id != 'A0HO' and id != 'A0HR' and id != 'A0YI' and id != 'A0NF' and id != 'A0OB' and id != 'A0OF' and id != 'A0OJ' and id != 'A0OM' and id != 'A0X2' and id != 'A0TQ' and id != 'A0TZ' and id != 'A0VS' and id != 'A0VT' and id != 'A0HJ' and id != 'A0WL' and id != 'A0WN' and id != 'A0WP' and id != 'A0XX' and id != 'A14T' and id != 'A0WJ' and id != 'A118' and id != 'A10Q' and id != 'A15E' and id != 'A187' and id != 'A189' and id != 'A18F' 
endfunction
function Net takes nothing returns boolean
return GetOwningPlayer(GetFilterUnit())==Player(PLAYER_NEUTRAL_AGGRESSIVE)
endfunction
function KillGroup takes nothing returns nothing
call RemoveUnit(GetEnumUnit())
endfunction
function KillGroup3 takes nothing returns nothing
call UnitApplyTimedLife(GetEnumUnit(),'BTLF',0.1)
endfunction
function ShakeCamera2 takes nothing returns nothing
call CameraSetSourceNoise(0,0)
call CameraSetTargetNoise(0,0)
call PauseTimer(GetExpiredTimer())
call DestroyTimer(GetExpiredTimer())
endfunction
function ShakeCamera takes real dur,real potency returns nothing
set sysTimer=CreateTimer()
call CameraSetTargetNoiseEx(2*potency,2*Pow(10,potency),true)
call CameraSetSourceNoiseEx(2*potency,2*Pow(10,potency),true)
call TimerStart(sysTimer,dur,false,function ShakeCamera2)
set sysTimer=null
endfunction
function TextTagFull takes string l__s,unit u,integer r,integer g,integer b,integer l__v,player p,real size returns nothing
set sysTextTag=CreateTextTag()
call SetTextTagText(sysTextTag,l__s,size)
call SetTextTagVisibility(sysTextTag,false)
if GetLocalPlayer()==p then
call SetTextTagVisibility(sysTextTag,true)
endif
call SetTextTagPosUnit(sysTextTag,u,20)
call SetTextTagColor(sysTextTag,r,g,b,l__v)
call SetTextTagVelocity(sysTextTag,0.05*Cos(1.571),0.05*Sin(1.571))
call SetTextTagFadepoint(sysTextTag,.75)
call SetTextTagLifespan(sysTextTag,3)
call SetTextTagPermanent(sysTextTag,false)
set sysTextTag=null
endfunction
function TextTagVoil takes string l__s,unit u,integer r,integer g,integer b,integer l__v,player p,real voil returns nothing
set sysTextTag=CreateTextTag()
call SetTextTagText(sysTextTag,l__s,voil)
call SetTextTagVisibility(sysTextTag,false)
if GetLocalPlayer()==p then
call SetTextTagVisibility(sysTextTag,true)
endif
call SetTextTagPosUnit(sysTextTag,u,20)
call SetTextTagColor(sysTextTag,r,g,b,l__v)
call SetTextTagVelocity(sysTextTag,0.05*Cos(1.571),0.05*Sin(1.571))
call SetTextTagFadepoint(sysTextTag,.75)
call SetTextTagLifespan(sysTextTag,3)
call SetTextTagPermanent(sysTextTag,false)
set sysTextTag=null
endfunction
function CopyGroup takes group g returns group
set bj_groupAddGroupDest=CreateGroup()
call ForGroup(g,function GroupAddGroupEnum)
return bj_groupAddGroupDest
endfunction
function Condition_RecipeString takes integer id returns boolean
return id=='I00E' or id=='I01P' or id=='I01R' or id=='I01T' or id=='I01V' or id=='I02U' or id=='I02X' or id=='I02Z' or id=='I045' or id=='I047' or id=='I04Y' or id=='I04U' or id=='I04X' or id=='I04Z' or id=='I051' or id=='I14R' or id=='IGDr' or id=='IPar' or id=='IHYr' or id=='ISTr' or id=='IBSR' or id=='I052' or id=='I053' or id=='I055' or id=='I06P' or id=='I06S' or id=='I06T' or id=='IPRR' or id=='IPlR' or id=='IBS1' or id=='IYM0' or id=='IGn0' or id=='IBN0' or id=='IGP0' or id=='IVS0' or id=='ISS0' or id=='ITS0'
endfunction
function Condition_AbilityString3 takes integer id returns boolean
return id=='OM13' or id=='A17D' or id=='A177' or id=='A172' or id=='A16U' or id=='A0TN'  or id=='MrF1' or id=='MrT1' or id=='MrG2' or id=='RsT1' or id=='RsF1' or id=='SiF1' or id=='SiF2' or id=='SiE1' or id=='SiE2' or id=='BbT1' or id=='FlW1' or id=='FlG1' or id=='RmQ1' or id=='SuE1' or id=='SuF1' or id=='SuD1'
endfunction
function Condition_AbilityString2 takes integer id returns boolean
return id=='A0YX' or id=='A0Z0' or id=='KkR1' or id=='KkR2' or id=='BRRS' or id=='BRSS' or id=='IcF2' or id=='IcF5' or id=='GKF1' or id=='VGF1' or id=='GKG1' or id=='GKBS' or id=='GKSS' or id=='GKS2' or id=='GKS3' or id=='GKS4' or id=='GKSR' or id=='GKSB' or id=='GKUI' or id=='GKMI' or id=='GKQ1' or id=='GKW1' or id=='GKE1' or id=='GKT1' or id=='JNF1' or id=='JNF4' or id=='GSQ1' or id=='GSQ2' or id=='GSE1' or id=='GSE2' or id=='GST1' or id=='GST3' or id=='GSF1' or id=='GSF2' or id=='GSF2'
endfunction
function Condition_AbilityString takes integer id returns boolean
return Condition_AbilityString2(id) or Condition_AbilityString3(id) or id=='SaW1' or id=='SaE1' or id=='SaR1' or id=='SaT1' or id=='TMW0' or id=='A0P6' or id=='A1D7' or id=='HSW1' or id=='HST1' or id=='KHG1' or id=='A2DJ' or id=='IcQ1' or id=='IcT1' or id=='MadF' or id=='A0N1' or id=='A2CZ' or id=='A0CZ' or id=='DSW1' or id=='Ad02' or id=='BGW1' or id=='KaA6' or id=='KaAF' or id=='BGG1' or id=='ASQ1' or id=='ASW1' or id=='ASE1' or id=='AST1' or id=='A1BO' or id=='A1BT' or id=='A1BW' or id=='A085' or id=='A08J' or id=='MiQ1' or id=='MiE1' or id=='MiR1' or id=='A0FN' or id=='WE03' or id=='WE06' or id=='A1AJ' or id=='A1ER' or id=='A0QK' or id=='A1HO' or id=='AlFS'
endfunction
function Condition_Base takes player p,unit e returns boolean
return IsUnitEnemy(e,p) and IsUnitType(e,UNIT_TYPE_STRUCTURE)==false and 'dumm'!=GetUnitTypeId(e) and 'cdm1'!=GetUnitTypeId(e) and 'e16T'!=GetUnitTypeId(e) and UltimateDamage!=e and GetUnitAbilityLevel(e, 'IMDc')==0 and GetUnitTypeId(e)!='dM02'
endfunction
//BofLibStart
// ===== Библиотека героев из bof (китайская карта 1.27/YDWE) — общая для всех перенесённых =====
// Нативы japi/DzAPI, которых в UjAPI нет под этими именами, и замены систем bof,
// которые проще переписать, чем тащить (таймерная очередь эффектов, бонусы через 70 абилок).
// Углы — в градусах, как у japi.
function Bof_EXSetEffectZ takes effect e,real z returns nothing
call SetSpecialEffectZ(e,z)
endfunction
function Bof_EXSetEffectSize takes effect e,real sc returns nothing
call SetSpecialEffectScale(e,sc)
endfunction
function Bof_EXSetEffectSpeed takes effect e,real sc returns nothing
call SetSpecialEffectTimeScale(e,sc)
endfunction
// EXEffectMatRotate* у japi поворачивает матрицу эффекта ОТНОСИТЕЛЬНО текущей —
// поэтому прибавляем к текущему углу, а не ставим его
function Bof_EXEffectMatRotateZ takes effect e,real a returns nothing
call SetSpecialEffectYaw(e,GetSpecialEffectYaw(e)+a)
endfunction
function Bof_EXEffectMatRotateY takes effect e,real a returns nothing
call SetSpecialEffectPitch(e,GetSpecialEffectPitch(e)+a)
endfunction
function Bof_EXEffectMatRotateX takes effect e,real a returns nothing
call SetSpecialEffectRoll(e,GetSpecialEffectRoll(e)+a)
endfunction
// EXSetAbilityState(способность, тип, значение) у japi: тип 1 — оставшийся кулдаун
function Bof_EXSetAbilityState takes ability a,integer kind,real cdVal returns boolean
if a==null then
return false
endif
if kind==1 then
call SetAbilityRemainingCooldown(a,cdVal)
return true
endif
return false
endfunction
// z5(юнит, способность) у bof сбрасывает кулдаун, снимая и выдавая способность заново. Для
// изучаемой кнопки героя 3.2 так нельзя (собьётся изученный уровень) — сбрасываем кулдаун напрямую
function Bof_ResetCd takes unit u,integer id returns nothing
if GetUnitAbilityLevel(u,id)>0 then
call SetAbilityRemainingCooldown(GetUnitAbility(u,id),0.)
endif
endfunction
// EXSetUnitMoveType(юнит, тип) у japi: 1 — «никакой», юнит проходит сквозь всё
function Bof_EXSetUnitMoveType takes unit u,integer kind returns nothing
call SetUnitPathing(u,kind!=1)
endfunction
// Po у bof — группа всех выбранных героев; у нас герои лежат в Hero[] по номеру игрока
function Bof_HeroGroup takes nothing returns group
local integer i=0
call GroupClear(bof_Heroes)
loop
exitwhen i>11
if Hero[i]!=null then
call GroupAddUnit(bof_Heroes,Hero[i])
endif
set i=i+1
endloop
return bof_Heroes
endfunction
// zO(время, юнит) у bof — убрать юнит через время (их очередь, как zU для эффектов)
function Bof_zO_Act takes nothing returns nothing
local timer t=GetExpiredTimer()
call RemoveUnit(LoadUnitHandle(bof_HT,GetHandleId(t),0))
call FlushChildHashtable(bof_HT,GetHandleId(t))
call DestroyTimer(t)
set t=null
endfunction
function Bof_zO takes real time,unit u returns nothing
local timer t
if u==null then
return
endif
set t=CreateTimer()
call SaveUnitHandle(bof_HT,GetHandleId(t),0,u)
call TimerStart(t,RMaxBJ(time,0.),false,function Bof_zO_Act)
set t=null
endfunction
// Вторая стадия кнопки (как Q→Q2 у Ремилии, W→Laevatein у Фландре): первая прячется для игрока,
// на её место выдаётся вторая; через dur или после каста второй (Bof_SwapBack) — первая обратно
function Bof_SwapBack takes unit u,integer ab1,integer ab2 returns nothing
call UnitRemoveAbility(u,ab2)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),ab1,true)
endfunction
function Bof_SwapStage_End takes nothing returns nothing
local timer swT=GetExpiredTimer()
call Bof_SwapBack(LoadUnitHandle(bof_HT,GetHandleId(swT),0),LoadInteger(bof_HT,GetHandleId(swT),1),LoadInteger(bof_HT,GetHandleId(swT),2))
call FlushChildHashtable(bof_HT,GetHandleId(swT))
call DestroyTimer(swT)
set swT=null
endfunction
function Bof_SwapStage takes unit u,integer ab1,integer ab2,real dur returns nothing
local timer swT=CreateTimer()
call UnitAddAbility(u,ab2)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),ab1,false)
call SaveUnitHandle(bof_HT,GetHandleId(swT),0,u)
call SaveInteger(bof_HT,GetHandleId(swT),1,ab1)
call SaveInteger(bof_HT,GetHandleId(swT),2,ab2)
call TimerStart(swT,dur,false,function Bof_SwapStage_End)
set swT=null
endfunction
// Система bof «надпись над юнитом» (триггер bF: юнит и текст в хранилище триггера) — название умения
// всплывает над героем, цвет случайный, как у bof
// Система bof «лечение» (триггер ZM): у нас — со срезами лечения карты (myCustomHeal2) и учётом
// в статистике (HealTextTag), как лечат герои 3.2
function Bof_Heal takes unit src,unit tgt,real amt returns nothing
local real bhA
if tgt==null or amt<=0. then
return
endif
set bhA=amt*myCustomHeal2(tgt,1)
call HealTextTag(src,tgt,bhA,"HealthRes")
call SetUnitState(tgt,UNIT_STATE_LIFE,GetWidgetLife(tgt)+bhA)
endfunction
function Bof_DzSetUnitModel takes unit u,string m returns nothing
call SetUnitModel(u,m)
endfunction
// zU(время, эффект) у bof — удалить эффект через время (их очередь таймеров).
// Нулевое время тоже через таймер: в оригинале эффект гаснет на следующем тике,
// после того как функция успела его повернуть и отмасштабировать.
function Bof_zU_Act takes nothing returns nothing
local timer t=GetExpiredTimer()
call DestroyEffect(LoadEffectHandle(bof_HT,GetHandleId(t),0))
call FlushChildHashtable(bof_HT,GetHandleId(t))
call DestroyTimer(t)
set t=null
endfunction
function Bof_zU takes real time,effect e returns nothing
local timer t
if e==null then
return
endif
set t=CreateTimer()
call SaveEffectHandle(bof_HT,GetHandleId(t),0,e)
if time<0 then
set time=0
endif
call TimerStart(t,time,false,function Bof_zU_Act)
set t=null
endfunction
// Эффект bof «создать и сразу погасить» (zU(0,…)) виден только своей анимацией смерти — у их
// моделей это 2–7 c, частицы живут ещё дольше, и ускорение (TimeScale) этого не лечит.
// Bof_EffCut: сразу играем смерть, а через dur прячем и удаляем — на экране ровно dur секунд.
// Bof_EffHide — убрать с экрана сразу и удалить: прячем, гасим прозрачность и сжимаем (чтобы
// не осталось частиц), только потом DestroyEffect.
function Bof_EffHide takes effect e returns nothing
call SetSpecialEffectVisible(e,false)
call SetSpecialEffectAlpha(e,0)
call SetSpecialEffectScale(e,.01)
call DestroyEffect(e)
endfunction
function Bof_EffCut_Act takes nothing returns nothing
local timer t=GetExpiredTimer()
local effect e=LoadEffectHandle(bof_HT,GetHandleId(t),0)
call Bof_EffHide(e)
call FlushChildHashtable(bof_HT,GetHandleId(t))
call DestroyTimer(t)
set t=null
set e=null
endfunction
function Bof_EffCut takes effect e,real dur returns nothing
local timer t
if e==null then
return
endif
call SetSpecialEffectAnimation(e,"death")
set t=CreateTimer()
call SaveEffectHandle(bof_HT,GetHandleId(t),0,e)
call TimerStart(t,dur,false,function Bof_EffCut_Act)
set t=null
endfunction
// Эффекты, которые надо убрать разом в нужный момент (шлейф прыжка — в момент удара): копим под
// ключом (хэндл таймера умения) и гасим все сразу Bof_EffDrop. Каждый удаляется ровно один раз.
function Bof_EffKeep takes integer key,effect e returns nothing
local integer bofN=LoadInteger(bof_HT,key,-1)+1
if e==null then
return
endif
call SetSpecialEffectAnimation(e,"death")
call SaveEffectHandle(bof_HT,key,-1-bofN,e)
call SaveInteger(bof_HT,key,-1,bofN)
endfunction
function Bof_EffDrop takes integer key returns nothing
local integer bofN=LoadInteger(bof_HT,key,-1)
loop
exitwhen bofN<=0
call Bof_EffHide(LoadEffectHandle(bof_HT,key,-1-bofN))
call RemoveSavedHandle(bof_HT,key,-1-bofN)
set bofN=bofN-1
endloop
call RemoveSavedInteger(bof_HT,key,-1)
endfunction
// xa(юнит, тип, режим, значение) у bof — бонус характеристики. Тип: 0 жизнь, 1 мана,
// 2 броня, 3 урон атаки, 4 ИНТ, 5 ЛОВ, 6 СИЛА. Режим: 0 прибавить, 1 отнять, 2 установить.
// Текущий бонус помним в bof_HT под ключом юнита, применяем разницу.
function Bof_xa takes unit u,integer kind,integer mode,integer val returns nothing
local integer id=GetHandleId(u)
local integer cur=LoadInteger(bof_HT,id,SH_bofBonus+kind)
local integer dv
if mode==0 then
set dv=val
elseif mode==1 then
set dv=0-val
else
set dv=val-cur
endif
call SaveInteger(bof_HT,id,SH_bofBonus+kind,cur+dv)
if dv==0 then
return
endif
if kind==0 then
call SetUnitMaxLife(u,GetUnitMaxLife(u)+dv)
if dv>0 then
call SetWidgetLife(u,GetWidgetLife(u)+dv)
endif
elseif kind==1 then
call SetUnitMaxMana(u,GetUnitMaxMana(u)+dv)
if dv>0 then
call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)+dv)
endif
elseif kind==2 then
call BlzSetUnitArmor(u,BlzGetUnitArmor(u)+dv)
elseif kind==3 then
call SetUnitBonusDamageByIndex(u,0,GetUnitBonusDamageByIndex(u,0)+dv)
elseif kind==4 then
call SetHeroInt(u,GetHeroInt(u,false)+dv,true)
elseif kind==5 then
call SetHeroAgi(u,GetHeroAgi(u,false)+dv,true)
elseif kind==6 then
call SetHeroStr(u,GetHeroStr(u,false)+dv,true)
endif
endfunction
// Реверс (стойки Гарпа G, UI Гоку, Royal Guard, Avalon, E Курапики и др.): цель в стойке
// (ANTITARGET_ABILITY) умение не бьёт и не держит — ей отдаём себя (REVERSE_TARGET), стойка сама
// контратакует. Неуязвимость каста снимаем, иначе ответный удар не пройдёт (как у Баррагана).
// Источник не герой (дамми, клон) — отдаём героя его игрока, как обработчик урона 3.2.
function Bof_Rev takes unit src,unit tgt returns boolean
local unit rvS=src
if tgt==null or src==null or not LoadBoolean(HH,GetHandleId(tgt),ANTITARGET_ABILITY) then
set rvS=null
return false
endif
if not IsUnitType(rvS,UNIT_TYPE_HERO) and Hero[GetPlayerId(GetOwningPlayer(rvS))]!=null then
set rvS=Hero[GetPlayerId(GetOwningPlayer(rvS))]
endif
call SaveUnitHandle(HH,GetHandleId(tgt),REVERSE_TARGET,rvS)
call SetUnitInvulnerable(rvS,false)
call SaveBoolean(HH,GetHandleId(rvS),SH_bofRevd,true)
set rvS=null
return true
endfunction
// Умение, которое держит кастера (пауза/неуязвимость), на каждом тике проверяет: был реверс — умение
// кончается, кастер отпущен (как у героев Чейза), и стойка бьёт его. Флаг гасится при старте умения.
function Bof_RevEnd takes unit c returns boolean
if not LoadBoolean(HH,GetHandleId(c),SH_bofRevd) then
return false
endif
call SaveBoolean(HH,GetHandleId(c),SH_bofRevd,false)
call PauseUnit(c,false)
call SetUnitInvulnerable(c,false)
call SetUnitTimeScale(c,1.)
call SetUnitPathing(c,true)
return true
endfunction
// Стан/контроль и замедление bof-героев: по цели в стойке не проходят (реверс)
function Bof_Ctrl takes unit src,unit tgt,real dur,string kind returns nothing
if not Bof_Rev(src,tgt) then
call SetControlToUnit(src,tgt,dur,kind)
endif
endfunction
function Bof_Slow takes unit src,unit tgt,real ms,real as,real dur,real vari,boolean flag returns nothing
if not Bof_Rev(src,tgt) then
call SlowUnit(src,tgt,ms,as,dur,vari,flag)
endif
endfunction
// Урон bof (UnitDamageTarget/UnitDamageTargetBJ) — через общий урон карты; цель в стойке — реверс
function Bof_Dmg takes unit src,unit tgt,real amt returns nothing
if src!=null and tgt!=null and amt>0 and not Bof_Rev(src,tgt) then
call myCustomDamage(src,tgt,amt,false,false,null,null,null)
endif
endfunction
// Урон по цели, которую умение само держит в паузе: обработчик урона 3.2 режет урон по юниту
// в паузе вдвое, если у источника нет GST4 или A1WR. Здесь не выдаём GST4 (это аура;
// выдача/снятие ауры 20 раз в секунду — главный подозреваемый в фатале на R Эсканора 27 сен),
// а удваиваем урон ровно в том случае, когда обработчик его режет. Для редкого урона
// можно и по-разрабовски: UnitAddAbility(caster,'GST4') — урон — UnitRemoveAbility.
function Bof_DmgFull takes unit src,unit tgt,real amt returns nothing
if IsUnitPaused(tgt) and PauseRes and GetUnitAbilityLevel(src,'GST4')==0 and GetUnitAbilityLevel(src,'A1WR')==0 then
set amt=amt*2.
endif
call Bof_Dmg(src,tgt,amt)
endfunction
// Обзор там, где скил bof рисует эффект. У bof на поле нет тумана войны, у нас эффект в тумане
// не виден — скил «улетает в пустоту». Владельцу кастера открываем точку на 1.5 c, но не чаще
// чем раз на 250 единиц пути (последняя точка — под ключом кастера), чтобы не плодить хэндлы.
function Bof_AddEffV_End takes nothing returns nothing
local timer tm=GetExpiredTimer()
call DestroyFogModifier(LoadFogModifierHandle(bof_HT,GetHandleId(tm),0))
call FlushChildHashtable(bof_HT,GetHandleId(tm))
call DestroyTimer(tm)
set tm=null
endfunction
function Bof_AddEffV takes unit caster,string path,real x,real y returns effect
local integer cid
local real vx
local real vy
local fogmodifier fm
local timer tm
if caster!=null then
set cid=GetHandleId(caster)
set vx=x-LoadReal(bof_HT,cid,SH_bofVisX)
set vy=y-LoadReal(bof_HT,cid,SH_bofVisY)
if vx*vx+vy*vy>62500. or not LoadBoolean(bof_HT,cid,SH_bofVis) then
call SaveBoolean(bof_HT,cid,SH_bofVis,true)
call SaveReal(bof_HT,cid,SH_bofVisX,x)
call SaveReal(bof_HT,cid,SH_bofVisY,y)
set fm=CreateFogModifierRadius(GetOwningPlayer(caster),FOG_OF_WAR_VISIBLE,x,y,400.,true,false)
call FogModifierStart(fm)
set tm=CreateTimer()
call SaveFogModifierHandle(bof_HT,GetHandleId(tm),0,fm)
call TimerStart(tm,1.5,false,function Bof_AddEffV_End)
set fm=null
set tm=null
endif
endif
return AddSpecialEffect(path,x,y)
endfunction
function Bof_InZone takes rect r,real x,real y,real m returns boolean
return x>=GetRectMinX(r)-m and x<=GetRectMaxX(r)+m and y>=GetRectMinY(r)-m and y<=GetRectMaxY(r)+m
endfunction
// зона боя точки: главная арена, бой Хибари, UBW, театр, дуэльная арена; чуть за краем (до 1000) — та же зона
// (перо родилось сбоку от героя у стены), дальше — вся карта
function Bof_Zone takes real x,real y returns rect
local real m=0.
loop
if Bof_InZone(gg_rct_GameZone,x,y,m) then
return gg_rct_GameZone
elseif Bof_InZone(gg_rct_HibariFight,x,y,m) then
return gg_rct_HibariFight
elseif Bof_InZone(gg_rct_UBW2,x,y,m) then
return gg_rct_UBW2
elseif Bof_InZone(gg_rct_OblTeatr,x,y,m) then
return gg_rct_OblTeatr
elseif Bof_InZone(gg_rct_Arena,x,y,m) then
return gg_rct_Arena
endif
exitwhen m>0.
set m=1000.
endloop
return bj_mapInitialPlayableArea
endfunction
function Bof_X takes rect r,real x returns real
return RMinBJ(RMaxBJ(x,GetRectMinX(r)+64.),GetRectMaxX(r)-64.)
endfunction
function Bof_Y takes rect r,real y returns real
return RMinBJ(RMaxBJ(y,GetRectMinY(r)+64.),GetRectMaxY(r)-64.)
endfunction
// переставить юнита без проверки проходимости, но не из его зоны боя (перья, драконы, рывки сквозь декор;
// владелец 4 окт: «драконы и перья не должны улетать за карту»)
function Bof_Put takes unit u,real x,real y returns nothing
local rect r=Bof_Zone(GetUnitX(u),GetUnitY(u))
call SetUnitX(u,Bof_X(r,x))
call SetUnitY(u,Bof_Y(r,y))
set r=null
endfunction
// после рывка сквозь декор герой не должен остаться внутри лавки/дерева: ближайшая проходимая точка до 320
function Bof_Unstick takes unit u returns nothing
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real r=32.
local real a
local rect bz=Bof_Zone(x,y)
if not IsTerrainPathable(x,y,PATHING_TYPE_WALKABILITY) then
set bz=null
return
endif
loop
exitwhen r>320.
set a=0.
loop
exitwhen a>=360.
if not IsTerrainPathable(Bof_X(bz,x+r*CosBJ(a)),Bof_Y(bz,y+r*SinBJ(a)),PATHING_TYPE_WALKABILITY) then
call Bof_Put(u,x+r*CosBJ(a),y+r*SinBJ(a))
set bz=null
return
endif
set a=a+45.
endloop
set r=r+32.
endloop
set bz=null
endfunction
// Система bof «толчок/скольжение» (триггер eb с параметрами в глобалах eZ/ea/Rk/Rl): юнит едет
// под углом (градусы) на дистанцию за время, шаг раз в 0.02 c. Сквозь декор, как у остальных героев
// (SetUnitXY_1; раньше шаг в непроходимое пропускался — копья, клоны и толчки упирались в декорации),
// героя в конце ставим на ближайшее проходимое место.
function Bof_Slide_Tick takes nothing returns nothing
local timer slT=GetExpiredTimer()
local integer slId=GetHandleId(slT)
local unit slU=LoadUnitHandle(bof_HT,slId,0)
local real slLeft=LoadReal(bof_HT,slId,3)-.02
if slLeft<=.001 or slU==null or GetUnitTypeId(slU)==0 then
if slU!=null and GetUnitTypeId(slU)!=0 and IsUnitType(slU,UNIT_TYPE_HERO) then
call Bof_Unstick(slU)
endif
call FlushChildHashtable(bof_HT,slId)
call DestroyTimer(slT)
else
call SaveReal(bof_HT,slId,3,slLeft)
call SetUnitXY_1(slU,GetUnitX(slU)+CosBJ(LoadReal(bof_HT,slId,1))*LoadReal(bof_HT,slId,2),GetUnitY(slU)+SinBJ(LoadReal(bof_HT,slId,1))*LoadReal(bof_HT,slId,2),true)
endif
set slT=null
set slU=null
endfunction
function Bof_Slide takes unit u,real ang,real dist,real time returns nothing
local timer slT
if u==null or time<=0. then
return
endif
set slT=CreateTimer()
call SaveUnitHandle(bof_HT,GetHandleId(slT),0,u)
call SaveReal(bof_HT,GetHandleId(slT),1,ang)
call SaveReal(bof_HT,GetHandleId(slT),2,dist/(time/.02))
call SaveReal(bof_HT,GetHandleId(slT),3,time)
call TimerStart(slT,.02,true,function Bof_Slide_Tick)
set slT=null
endfunction
function Bof_GlideAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local integer left=LoadInteger(HH,id,3)-1
if left<0 or GetUnitTypeId(u)==0 then
if left<0 and IsUnitType(u,UNIT_TYPE_HERO) then
call Bof_Unstick(u)
endif
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
else
call SaveInteger(HH,id,3,left)
call Bof_Put(u,GetUnitX(u)+CosBJ(LoadReal(HH,id,1))*LoadReal(HH,id,2),GetUnitY(u)+SinBJ(LoadReal(HH,id,1))*LoadReal(HH,id,2))
endif
set t=null
set u=null
endfunction
// толчок на dist за time c (как Bof_Slide, но сквозь декор); героя в конце ставит на проходимое место
function Bof_Glide takes unit u,real ang,real dist,real time returns nothing
local timer t=CreateTimer()
local integer cnt=IMaxBJ(R2I(time/.02+.5),1)
call SaveUnitHandle(HH,GetHandleId(t),0,u)
call SaveReal(HH,GetHandleId(t),1,ang)
call SaveReal(HH,GetHandleId(t),2,dist/I2R(cnt))
call SaveInteger(HH,GetHandleId(t),3,cnt)
call TimerStart(t,.02,true,function Bof_GlideAct)
set t=null
endfunction
// ===== конец библиотеки bof =====
//BofLibEnd
//Remilia1start
// ===== Ремилия Скарлет (Touhou, перенос из bof) — переписано в стиле Чейза =====
// Данные умения — в HH под хэндлом таймера (маленькие ключи), состояние героя — в HH под хэндлом
// героя (константы SH_Rem...). Время — целыми тиками таймера (n): тики те же, что у bof.
// Общие вещи bof (эффект с обзором Bof_AddEffV, удаление эффекта Bof_zU, толчок Bof_Slide, урон/
// стан/замедление с реверсом Bof_Dmg/Bof_Ctrl/Bof_Slow, бонус здоровья Bof_xa) — из библиотеки bof.
// интеллект для урона кнопки D: 0.2*ИНТ за касание цепи (x3 в вызове); 29 сен, было 0.105;
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Rem_Int_D takes unit u,boolean b returns integer
return R2I(I2R(GetHeroInt(u,b))*(0.2/3.)*1000.+0.5)
endfunction
// интеллект для урона кнопки E: 1.2..2*ИНТ за удар (x25 в вызове); 29 сен, было 0.55..0.95;
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Rem_Int_E takes unit u,boolean b returns integer
return R2I(I2R(GetHeroInt(u,b))*(0.04+0.008*I2R(GetUnitAbilityLevel(u,'RmE1')))*1000.+0.5)
endfunction
// интеллект для урона кнопки G: урон bof x (0.02);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Rem_Int_G takes unit u,boolean b returns integer
return R2I(I2R(GetHeroInt(u,b))*(0.02)*1000.+0.5)
endfunction
// интеллект для урона кнопки Q: 0.5..1*ИНТ за цепь (x20 в вызове, цепей 4), с Q2 — стандарт 4..6 (4 окт; 29 сен было 1.2..2);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Rem_Int_Q takes unit u,boolean b returns integer
return R2I(I2R(GetHeroInt(u,b))*((3.+I2R(GetUnitAbilityLevel(u,'RmQ1')))/160.)*1000.+0.5)
endfunction
// интеллект для урона кнопки Q2: 2*ИНТ (x80 в вызове); 4 окт, было 5;
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Rem_Int_Q2 takes unit u,boolean b returns integer
return R2I(I2R(GetHeroInt(u,b))*(0.025)*1000.+0.5)
endfunction
// интеллект для урона кнопки R: нажатие x24 = 0.4..0.8*ИНТ (нажатий 5), копьё x120 = 2..4*ИНТ — стандарт 4..8 (4 окт);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Rem_Int_R takes unit u,boolean b returns integer
return R2I(I2R(GetHeroInt(u,b))*((3.+I2R(GetUnitAbilityLevel(u,'RmR1')))/240.)*1000.+0.5)
endfunction
// интеллект для урона кнопки W: 0.5..1.4*ИНТ за удар (x25 в вызове, ударов 5) — стандарт 2.5..7 (4 окт);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Rem_Int_W takes unit u,boolean b returns integer
return R2I(I2R(GetHeroInt(u,b))*(0.011+0.009*I2R(GetUnitAbilityLevel(u,'RmW1')))*1000.+0.5)
endfunction
// интеллект для урона кнопки atk: урон bof x (0.0095), бафф 28 сен (было 0.0075);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Rem_Int_atk takes unit u,boolean b returns integer
return R2I(I2R(GetHeroInt(u,b))*(0.0095)*1000.+0.5)
endfunction
// ----- общие мелочи Ремилии -----
// Звук умения (громкость 0–127)
function Rem_Sound takes string path,integer vol returns nothing
local sound str=CreateSound(path,false,false,false,10,10,"Default")
call SetSoundVolume(str,vol)
call StartSound(str)
call KillSoundWhenDone(str)
set str=null
endfunction
// Эффект bof в точке: с обзором для владельца (Bof_AddEffV), высота z (z<0 — не менять), поворот
// yaw в градусах, размер sc, удаление через life (0 — на следующем тике, как zU(0) у bof).
// Созданный эффект — в bj_lastCreatedEffect (для наклона/скорости после вызова).
function Rem_Fx takes unit c,string path,real x,real y,real z,real yaw,real sc,real life returns nothing
set bj_lastCreatedEffect=Bof_AddEffV(c,path,x,y)
if z>=0. then
call SetSpecialEffectZ(bj_lastCreatedEffect,z)
endif
if yaw!=0. then
call SetSpecialEffectYaw(bj_lastCreatedEffect,yaw)
endif
if sc!=1. then
call SetSpecialEffectScale(bj_lastCreatedEffect,sc)
endif
call Bof_zU(life,bj_lastCreatedEffect)
endfunction
// Надпись над Ремилией (название стадии R): случайный цвет, всплывает и гаснет за 1 c
function Rem_Text takes unit u,string str returns nothing
local texttag tt=CreateTextTagUnitBJ(str,u,0.,20.,GetRandomPercentageBJ(),GetRandomPercentageBJ(),GetRandomPercentageBJ(),50.)
call SetTextTagVelocityBJ(tt,100.,90.)
call SetTextTagPermanent(tt,false)
call SetTextTagLifespan(tt,1.)
call SetTextTagFadepoint(tt,1.)
set tt=null
endfunction
// Снять тряску экрана игрока через dur
function Rem_NoiseOffAct takes nothing returns nothing
local timer t=GetExpiredTimer()
call CameraClearNoiseForPlayer(LoadPlayerHandle(HH,GetHandleId(t),0))
call FlushChildHashtable(HH,GetHandleId(t))
call DestroyTimer(t)
set t=null
endfunction
function Rem_Noise takes player p,real mag,real dur returns nothing
local timer t=CreateTimer()
call CameraSetEQNoiseForPlayer(p,mag)
call SavePlayerHandle(HH,GetHandleId(t),0,p)
call TimerStart(t,dur,false,function Rem_NoiseOffAct)
set t=null
endfunction
// Проявление дамми (цепи D, круг D): прозрачность 0→255, шаг step раз в 0.01 c
function Rem_FadeInAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local integer a=LoadInteger(HH,id,1)+LoadInteger(HH,id,2)
if a<=255 then
call SetUnitVertexColor(u,255,255,255,a)
call SaveInteger(HH,id,1,a)
else
call SetUnitVertexColor(u,255,255,255,255)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set u=null
endfunction
function Rem_FadeIn takes unit u,integer step returns nothing
local timer t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,u)
call SaveInteger(HH,GetHandleId(t),1,0)
call SaveInteger(HH,GetHandleId(t),2,step)
call TimerStart(t,.01,true,function Rem_FadeInAct)
set t=null
endfunction
// Тень Ремилии (дамми uB19) на месте каста T и Heart Break: прозрачность 150, гаснет по 5 раз в 0.02 c
function Rem_ShadowAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local integer a=LoadInteger(HH,id,1)
if a<=0 then
call RemoveUnit(u)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
else
set a=a-5
call SaveInteger(HH,id,1,a)
call SetUnitVertexColor(u,255,255,255,a)
endif
set t=null
set u=null
endfunction
function Rem_Shadow takes unit c,real x,real y returns nothing
local timer t=CreateTimer()
local unit u=CreateUnit(GetOwningPlayer(c),'uB19',x,y,0.)
call SetUnitBlendTime(u,0.)
call SetUnitVertexColor(u,255,255,255,150)
call SetUnitAnimationByIndex(u,6)
call SaveUnitHandle(HH,GetHandleId(t),0,u)
call SaveInteger(HH,GetHandleId(t),1,150)
call TimerStart(t,.02,true,function Rem_ShadowAct)
set t=null
set u=null
endfunction
// Случайная точка вокруг центра в радиусе r (кольца как у bof: 30% дальнее, 30% среднее, 40% ближнее).
// Направления для x и y берутся разные — так было у bof, рисунок брызг тот же.
function Rem_RandFx takes unit c,real cx,real cy,real r,integer vol returns nothing
local real dmy
local real x
local real y
if GetRandomInt(1,10)>7 then
set dmy=GetRandomReal(r/1.5,r)
elseif GetRandomInt(1,10)>4 then
set dmy=GetRandomReal(r/2.5,r/1.5)
else
set dmy=GetRandomReal(0.,r/2.5)
endif
set x=cx+dmy*CosBJ(GetRandomDirectionDeg())
set y=cy+dmy*SinBJ(GetRandomDirectionDeg())
if GetRandomInt(1,2)==1 then
call Rem_Fx(c,"bof\\Scarlet-53.mdx",x,y,25.,0.,1.25,0.)
else
call Rem_Fx(c,"bof\\Scarlet-47.mdx",x,y,25.,0.,1.25,0.)
endif
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-T-YX9.mp3",vol)
endfunction
// Удар серии (E и T): 4 чередующихся взмаха с эффектами у Ремилии; hit — номер удара с 1
function Rem_Swing takes unit c,real ang,integer hit returns nothing
local integer k=ModuloInteger(hit-1,4)
local real x=GetUnitX(c)
local real y=GetUnitY(c)
local real z=GetUnitFlyHeight(c)+150.
if k==0 or k==2 then
call SetUnitAnimationByIndex(c,3)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-T-YX3.wav",100)
call Rem_Fx(c,"bof\\Scarlet-44.mdx",x,y,z,ang+180.,1.,0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,180.)
elseif k==1 then
call SetUnitAnimationByIndex(c,4)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-T-YX4.wav",100)
call Rem_Fx(c,"bof\\Scarlet-44.mdx",x,y,z,ang,1.,0.)
else
call SetUnitAnimationByIndex(c,18)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-T-YX5.wav",100)
call Rem_Fx(c,"bof\\Scarlet-44.mdx",x,y,z,ang+180.,1.75,0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,160.)
call Rem_Fx(c,"bof\\Scarlet-72.mdx",x,y,z,ang,2.5,0.)
endif
endfunction
// Вампиризм (пассивка): 7% урона (10% с T) — лечение. Перелив лечения во время боя копится во
// временный запас (SH_RemTmpLife) и поднимает максимум: база + прибавка от убийств T (SH_RemKillLife)
// + запас. Запас не больше 25% обычного максимума (владелец 28 сен). 15 c без урона — запас утекает.
function Rem_VampHeal takes unit u,real amt returns nothing
local integer uid=GetHandleId(u)
local real a=amt*myCustomHeal2(u,1)
local real miss=GetUnitState(u,UNIT_STATE_MAX_LIFE)-GetWidgetLife(u)
local integer cap
if a<=0. then
return
endif
call HealTextTag(u,u,a,"HealthRes")
call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+a)
if a>miss and LoadBoolean(HH,uid,SH_RemFight) and not LoadBoolean(HH,uid,SH_RemLeak) then
set cap=R2I((GetUnitState(u,UNIT_STATE_MAX_LIFE)-I2R(LoadInteger(bof_HT,uid,SH_bofBonus)))*.25)
call SaveInteger(HH,uid,SH_RemTmpLife,IMinBJ(cap,LoadInteger(HH,uid,SH_RemTmpLife)+R2I(a-miss)))
call Bof_xa(u,0,2,LoadInteger(HH,uid,SH_RemKillLife)+LoadInteger(HH,uid,SH_RemTmpLife))
endif
endfunction
// Утечка запаса: amount раз в 0.05 c, пока запас больше amount (не дольше 600 c)
function Rem_LeakAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local integer uid=GetHandleId(u)
local integer amount=LoadInteger(HH,id,1)
local real time=LoadReal(HH,id,2)+.05
call SaveReal(HH,id,2,time)
if time<=600. and LoadInteger(HH,uid,SH_RemTmpLife)>amount then
call SaveInteger(HH,uid,SH_RemTmpLife,LoadInteger(HH,uid,SH_RemTmpLife)-amount)
call Bof_xa(u,0,2,LoadInteger(HH,uid,SH_RemKillLife)+LoadInteger(HH,uid,SH_RemTmpLife))
else
call SaveBoolean(HH,uid,SH_RemLeak,false)
call SaveInteger(HH,uid,SH_RemTmpLife,0)
call Bof_xa(u,0,2,LoadInteger(HH,uid,SH_RemKillLife))
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set u=null
endfunction
// Бой: 15 c без нанесённого урона (SH_RemFightTime сбрасывает Rem_Damage_Act) — запас начинает утекать
function Rem_FightAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local integer uid=GetHandleId(u)
local timer t2
call SaveReal(HH,uid,SH_RemFightTime,LoadReal(HH,uid,SH_RemFightTime)+.05)
if LoadReal(HH,uid,SH_RemFightTime)>=15. or not LoadBoolean(HH,uid,SH_RemFight) then
call SaveBoolean(HH,uid,SH_RemFight,false)
call SaveBoolean(HH,uid,SH_RemLeak,true)
set t2=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t2),0,u)
call SaveInteger(HH,GetHandleId(t2),1,R2I(GetUnitState(u,UNIT_STATE_MAX_LIFE)*.0031)+1)
call TimerStart(t2,.05,true,function Rem_LeakAct)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set t2=null
set u=null
endfunction
// Любой урон Ремилии по врагу (из обработчика урона): вампиризм и отсчёт боя
function Rem_Damage_Act takes unit c,real dmg returns nothing
local integer cid=GetHandleId(c)
local timer t
if dmg>=5000000. then
return
endif
// нерф 3.7.9: вампиризм 7% (10% с T), было 10% (15%)
if GetUnitAbilityLevel(c,'RmT1')>0 then
call Rem_VampHeal(c,dmg*.1)
else
call Rem_VampHeal(c,dmg*.07)
endif
if not LoadBoolean(HH,cid,SH_RemLeak) then
if not LoadBoolean(HH,cid,SH_RemFight) then
call SaveBoolean(HH,cid,SH_RemFight,true)
call SaveReal(HH,cid,SH_RemFightTime,0.)
set t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,c)
call TimerStart(t,.05,true,function Rem_FightAct)
else
call SaveReal(HH,cid,SH_RemFightTime,0.)
endif
endif
set t=null
endfunction
// Атака Ремилии (пассивка T «Тысячелетний вампир»): доп. урон, взмах и отброс цели на 10 тиков
function Rem_KnockAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local integer tk=LoadInteger(HH,id,1)+1
local real ang=LoadReal(HH,id,2)
local real speed=20.-1.5*I2R(tk)
call SaveInteger(HH,id,1,tk)
if tk<=10 then
call SetUnitXY_1(u,GetUnitX(u)+speed*CosBJ(ang),GetUnitY(u)+speed*SinBJ(ang), true)
else
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set u=null
endfunction
function Rem_Attack_Act takes unit c,unit u returns nothing
local real ang=Atan2BJ(GetUnitY(c)-GetUnitY(u),GetUnitX(c)-GetUnitX(u))+180.
local real z=GetUnitFlyHeight(c)+150.
local real x1=GetUnitX(c)+150.*CosBJ(ang)
local real y1=GetUnitY(c)+150.*SinBJ(ang)
local timer t
call Bof_Dmg(c,u,(I2R(Rem_Int_atk(c,true))*20.)*0.001)
call Rem_Fx(c,"bof\\Scarlet-44.mdx",GetUnitX(u),GetUnitY(u),z,ang+180.,1.,0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,180.)
call Rem_Fx(c,"bof\\Scarlet-72.mdx",GetUnitX(u),GetUnitY(u),z,ang+180.,1.,0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,180.)
call Rem_Fx(c,"bof\\Scarlet-67.mdx",x1,y1,150.,GetRandomDirectionDeg(),2.,0.)
call Rem_Fx(c,"bof\\Scarlet-67.mdx",x1,y1,150.,GetRandomDirectionDeg(),2.,0.)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-T-YX3.wav",100)
if not IsUnitPaused(u) then
set t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,u)
call SaveReal(HH,GetHandleId(t),2,ang)
call TimerStart(t,.01,true,function Rem_KnockAct)
endif
set t=null
endfunction
// F «Scarlet Netherworld» (владелец 28 сен): в кровавом озере другие кнопки недоступны, выйти
// можно только повторным F (RmF2). b=true — прячем кнопки на время F, false — возвращаем.
// Q возвращаем, только если сейчас не висит вторая кнопка Q2 (её вернёт Rem_Q2Back по таймеру).
function Rem_FLock takes unit u,boolean b returns nothing
local player p=GetOwningPlayer(u)
call SetPlayerAbilityAvailable(p,'RmQ2',not b)
call SetPlayerAbilityAvailable(p,'RmW1',not b)
call SetPlayerAbilityAvailable(p,'RmE1',not b)
call SetPlayerAbilityAvailable(p,'RmR1',not b)
call SetPlayerAbilityAvailable(p,'RmT1',not b)
call SetPlayerAbilityAvailable(p,'RmD1',not b)
call SetPlayerAbilityAvailable(p,'RmG1',not b)
if b or GetUnitAbilityLevel(u,'RmQ2')==0 then
call SetPlayerAbilityAvailable(p,'RmQ1',not b)
endif
set p=null
endfunction
// ----- Q «Scarlet Shoot» -----
// Снаряд Q: летит к точке с разгоном (до 100 за тик), ~0.2 c; на месте — взрыв 350: урон и стан
function Rem_Q_Shot takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,0)
local unit dmy=LoadUnitHandle(HH,id,1)
local real tx=LoadReal(HH,id,2)
local real ty=LoadReal(HH,id,3)
local real ang=LoadReal(HH,id,4)
local real dir=LoadReal(HH,id,5)
local real speed=LoadReal(HH,id,6)
local real dist=LoadReal(HH,id,7)
local integer tk=LoadInteger(HH,id,8)+1
local real x=GetUnitX(dmy)
local real y=GetUnitY(dmy)
local group g
local unit e
call SaveInteger(HH,id,8,tk)
if speed<=100. then
set speed=speed+5.
call SaveReal(HH,id,6,speed)
endif
if I2R(tk)*.01<=GetRandomReal(.2,.22) and UnitIsAlive(dmy) and dist>speed then
call SetUnitFlyHeight(dmy,GetUnitFlyHeight(dmy)-30.,1000000000.)
set dir=dir+GetRandomReal(-3.,3.)
call SaveReal(HH,id,5,dir)
call SetUnitFacing(dmy,dir)
call SaveReal(HH,id,7,SRS(x,y,tx,ty))
call SetUnitXY_1(dmy,x+speed*CosBJ(dir),y+speed*SinBJ(dir), false)
call SaveReal(HH,id,9,x+speed*CosBJ(dir))
call SaveReal(HH,id,10,y+speed*SinBJ(dir))
else
set x=LoadReal(HH,id,9)
set y=LoadReal(HH,id,10)
call Rem_Fx(caster,"bof\\Scarlet-54.mdx",x,y,50.,ang,1.5,0.)
call Rem_Fx(caster,"bof\\Scarlet-27.mdx",x,y,50.,ang,1.5,0.)
call Rem_Fx(caster,"bof\\Scarlet-37.mdx",x,y,50.,ang,1.5,0.)
call Rem_Fx(caster,"bof\\Scarlet-75.mdx",x,y,50.,ang,1.,0.)
set g=CreateGroup()
call GroupEnumUnitsInRange(g,x,y,350.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(caster),e) and GetUnitAbilityLevel(e,'Avul')==0 then
call Bof_Dmg(caster,e,(I2R(Rem_Int_Q(caster,true))*20.)*0.001)
call Bof_Ctrl(caster,e,1.,"stun")
endif
endloop
call DestroyGroup(g)
call RemoveUnit(dmy)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set caster=null
set dmy=null
set g=null
set e=null
endfunction
// Q2 через 8 c: вторая кнопка пропадает, Q возвращается (если Ремилия не в F — тогда вернёт Rem_FLock)
function Rem_Q2Back takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit caster=LoadUnitHandle(HH,GetHandleId(t),0)
call UnitRemoveAbility(caster,'RmQ2')
if not LoadBoolean(HH,GetHandleId(caster),SH_RemFOn) then
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'RmQ1',true)
endif
call RemoveSavedHandle(HH,GetHandleId(caster),SH_RemQ2Point)
call FlushChildHashtable(HH,GetHandleId(t))
call DestroyTimer(t)
set t=null
set caster=null
endfunction
// Q, тик 0.02 c: отскок назад на 600 за 0.6 c, с 0.62 c — пятится и выпускает 4 снаряда, в 1.02 c — конец
function Rem_Q_Act2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,0)
local real tx=LoadReal(HH,id,1)
local real ty=LoadReal(HH,id,2)
local real ang=LoadReal(HH,id,3)
local integer tk=LoadInteger(HH,id,4)+1
local integer k
local real speed
local real decel
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local unit dmy
local timer t2
call SaveInteger(HH,id,4,tk)
// реверс (цель в стойке развернула умение): как у героев Чейза — умение кончается, кастер отпущен
if Bof_RevEnd(caster) then
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
set t=null
set caster=null
return
endif
call SetUnitInvulnerable(caster,true)
call PauseUnit(caster,true)
if tk==1 then
call Bof_Slide(caster,ang+180.,600.,.6)
endif
if tk==31 then
call Rem_Noise(GetOwningPlayer(caster),35.,.4)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-Q-YX1.mp3",100)
call Rem_Fx(caster,"bof\\Tsubaki-37.mdx",x,y,GetUnitFlyHeight(caster)+100.,ang,5.,0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,90.)
call Rem_Fx(caster,"bof\\Saber-17.mdx",x,y,GetUnitFlyHeight(caster)+50.,ang,1.5,0.)
endif
if tk>=32 and tk<=50 then
set k=LoadInteger(HH,id,5)+1
call SaveInteger(HH,id,5,k)
if k==1 or ModuloInteger(k-1,5)==0 then
set dmy=CreateUnit(GetOwningPlayer(caster),'eBLP',x,y,ang)
call Bof_DzSetUnitModel(dmy,"bof\\Scarlet-11.mdx")
call UnitApplyTimedLife(dmy,'BHwe',5.)
call SetUnitFlyHeight(dmy,GetUnitFlyHeight(caster)+100.,1000000000.)
set t2=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t2),0,caster)
call SaveUnitHandle(HH,GetHandleId(t2),1,dmy)
call SaveReal(HH,GetHandleId(t2),2,tx)
call SaveReal(HH,GetHandleId(t2),3,ty)
call SaveReal(HH,GetHandleId(t2),4,ang)
call SaveReal(HH,GetHandleId(t2),5,ang)
call SaveReal(HH,GetHandleId(t2),6,40.)
call SaveReal(HH,GetHandleId(t2),7,SRS(x,y,tx,ty))
call SaveReal(HH,GetHandleId(t2),9,x)
call SaveReal(HH,GetHandleId(t2),10,y)
call TimerStart(t2,.02,true,function Rem_Q_Shot)
endif
set speed=LoadReal(HH,id,6)
set decel=LoadReal(HH,id,7)
set speed=speed-decel
set decel=decel-.1
call SaveReal(HH,id,6,speed)
call SaveReal(HH,id,7,decel)
call Bof_Put(caster,x+CosBJ(ang+180.)*speed,y+SinBJ(ang+180.)*speed)
endif
if tk==51 then
call SetUnitInvulnerable(caster,false)
call PauseUnit(caster,false)
call SetUnitTimeScale(caster,1.)
// после отскока сквозь декор — на ближайшее проходимое место
call Bof_Unstick(caster)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set t2=null
set caster=null
set dmy=null
endfunction
function Rem_Q_Anim takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit caster=LoadUnitHandle(HH,GetHandleId(t),0)
call SetUnitTimeScale(caster,1.)
call SetUnitAnimationByIndex(caster,20)
call FlushChildHashtable(HH,GetHandleId(t))
call DestroyTimer(t)
set t=null
set caster=null
endfunction
function Rem_Q_Act takes unit caster,real tx,real ty returns nothing
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real ang=Atan2BJ(ty-y,tx-x)
local unit dmy
local timer t
call SaveBoolean(HH,GetHandleId(caster),SH_bofRevd,false)
call Rem_Fx(caster,"bof\\Scarlet-4.mdx",x,y,GetUnitFlyHeight(caster),ang,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-8.mdx",x,y,GetUnitFlyHeight(caster),ang,1.,0.)
set t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call TimerStart(t,.01,false,function Rem_Q_Anim)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-Q-YY1.mp3",100)
// метка в точке Q: к ней переносит Q2
set dmy=CreateUnit(GetOwningPlayer(caster),'eBLP',tx,ty,ang)
call Bof_DzSetUnitModel(dmy,"bof\\Scarlet-6.mdx")
call SetUnitScale(dmy,1.5,1.5,1.5)
call UnitApplyTimedLife(dmy,'BHwe',8.2)
call SaveUnitHandle(HH,GetHandleId(caster),SH_RemQ2Point,dmy)
call UnitAddAbility(caster,'RmQ2')
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'RmQ1',false)
set t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call TimerStart(t,8.,false,function Rem_Q2Back)
call SetUnitInvulnerable(caster,true)
call PauseUnit(caster,true)
set t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call SaveReal(HH,GetHandleId(t),1,tx)
call SaveReal(HH,GetHandleId(t),2,ty)
call SaveReal(HH,GetHandleId(t),3,ang)
call SaveReal(HH,GetHandleId(t),6,80.)
call SaveReal(HH,GetHandleId(t),7,5.)
call TimerStart(t,.02,true,function Rem_Q_Act2)
set dmy=null
set t=null
endfunction
// ----- Q2 «Bad Lady Scramble»: перенос к метке Q, удар 350 -----
function Rem_Q2_Act takes unit caster returns nothing
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local unit dmy=LoadUnitHandle(HH,GetHandleId(caster),SH_RemQ2Point)
local real tx=x
local real ty=y
local real z=GetUnitFlyHeight(caster)
local group g
local unit e
// метка Q пропала (умерла по таймеру) — Q2 бьёт на месте, а не переносит в центр карты
if dmy!=null and GetUnitTypeId(dmy)!=0 then
set tx=GetUnitX(dmy)
set ty=GetUnitY(dmy)
endif
call Rem_Fx(caster,"bof\\Scarlet-22.mdx",x,y,z,0.,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-36.MDX",x,y,z,0.,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-69.mdx",x,y,z,0.,1.,0.)
// метка могла стоять в декоре — после переноса на проходимое место
call Bof_Put(caster,tx,ty)
call Bof_Unstick(caster)
set tx=GetUnitX(caster)
set ty=GetUnitY(caster)
call Rem_Fx(caster,"bof\\Scarlet-69.mdx",tx,ty,z,0.,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-4.mdx",tx,ty,z,0.,1.,0.)
set g=CreateGroup()
call GroupEnumUnitsInRange(g,tx,ty,350.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(caster),e) and GetUnitAbilityLevel(e,'Avul')==0 then
call Bof_Dmg(caster,e,(I2R(Rem_Int_Q2(caster,true))*80.)*0.001)
call Bof_Ctrl(caster,e,1.5,"stun")
endif
endloop
call DestroyGroup(g)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-Q2-YY1.mp3",120)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-G-YX1.mp3",100)
call UnitRemoveAbility(caster,'RmQ2')
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'RmQ1',true)
set dmy=null
set g=null
set e=null
endfunction
// ----- W «Young Demon Lord»: рывок в точку (до 1000), 4 удара 300 со станом и финальный удар -----
function Rem_W_Hit takes unit caster,real x,real y,boolean first returns nothing
local group g=CreateGroup()
local unit e
call GroupEnumUnitsInRange(g,x,y,300.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(caster),e) and GetUnitAbilityLevel(e,'Avul')==0 then
call Bof_Dmg(caster,e,(I2R(Rem_Int_W(caster,true))*25.)*0.001)
if first then
call Rem_Fx(caster,"bof\\Scarlet-26.mdx",GetUnitX(e),GetUnitY(e),GetUnitFlyHeight(e)+150.,0.,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-52.mdx",GetUnitX(e),GetUnitY(e),GetUnitFlyHeight(e)+150.,0.,1.,0.)
call Bof_Ctrl(caster,e,1.,"stun")
endif
endif
endloop
call DestroyGroup(g)
set g=null
set e=null
endfunction
function Rem_W_Act2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,0)
local real tx=LoadReal(HH,id,1)
local real ty=LoadReal(HH,id,2)
local real ang=LoadReal(HH,id,3)
local integer tk=LoadInteger(HH,id,4)+1
local integer k
call SaveInteger(HH,id,4,tk)
// реверс (цель в стойке развернула умение): как у героев Чейза — умение кончается, кастер отпущен
if Bof_RevEnd(caster) then
call CameraClearNoiseForPlayer(GetOwningPlayer(caster))
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
set t=null
set caster=null
return
endif
call SetUnitInvulnerable(caster,true)
call PauseUnit(caster,true)
if tk==13 then
call CameraSetEQNoiseForPlayer(GetOwningPlayer(caster),35.)
call SetUnitTimeScale(caster,1.)
call SetUnitAnimationByIndex(caster,19)
call SetUnitXY_1(caster,tx,ty, true)
call Rem_Fx(caster,"bof\\Scarlet-10.mdx",tx,ty,25.,ang,1.5,0.)
call Rem_Fx(caster,"bof\\Scarlet-47.mdx",tx,ty,25.,ang,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-4.mdx",tx,ty,25.,ang,1.5,0.)
call Rem_Fx(caster,"bof\\Scarlet-14.mdx",tx,ty,25.,ang,1.5,.75)
call Rem_Fx(caster,"bof\\Madara-huitu-22.mdx",tx,ty,25.,ang,6.,0.)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-T-YX7.mp3",110)
endif
if tk>=14 and tk<=49 then
set k=LoadInteger(HH,id,5)+1
call SaveInteger(HH,id,5,k)
if ModuloInteger(k,8)==0 then
call Rem_Fx(caster,"bof\\Scarlet-47.mdx",tx,ty,25.,ang,1.,0.)
call Rem_W_Hit(caster,tx,ty,true)
endif
endif
if tk==50 then
call Rem_W_Hit(caster,tx,ty,false)
call CameraClearNoiseForPlayer(GetOwningPlayer(caster))
call SetUnitInvulnerable(caster,false)
call PauseUnit(caster,false)
call Bof_Unstick(caster)
call SetUnitTimeScale(caster,1.)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set caster=null
endfunction
function Rem_W_Act takes unit caster,real tx,real ty returns nothing
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real ang=Atan2BJ(ty-y,tx-x)
local real dist=RMinBJ(SRS(x,y,tx,ty),1000.)
local timer t=CreateTimer()
call SaveBoolean(HH,GetHandleId(caster),SH_bofRevd,false)
call Rem_Fx(caster,"bof\\Scarlet-8.mdx",x,y,-1.,0.,1.,0.)
call Rem_Fx(caster,"bof\\Tsubaki-33.mdx",x,y,-1.,0.,1.,0.)
call Rem_Fx(caster,"bof\\Madara-huitu-22.mdx",x,y,25.,ang,4.,0.)
call SetUnitInvulnerable(caster,true)
call PauseUnit(caster,true)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-W-YY1.mp3",100)
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call SaveReal(HH,GetHandleId(t),1,x+CosBJ(ang)*dist)
call SaveReal(HH,GetHandleId(t),2,y+SinBJ(ang)*dist)
call SaveReal(HH,GetHandleId(t),3,ang)
call TimerStart(t,.02,true,function Rem_W_Act2)
set t=null
endfunction
// ----- E «Dracula Cradle»: рывок 0.42 c, толкает врагов в 220; 4 удара 300 со станом -----
function Rem_E_Act2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,0)
local real ang=LoadReal(HH,id,1)
local integer tk=LoadInteger(HH,id,2)+1
local real speed=LoadReal(HH,id,3)-LoadReal(HH,id,4)
local real decel=LoadReal(HH,id,4)-.12
local integer hit
local real x
local real y
local group g
local unit e
call SaveInteger(HH,id,2,tk)
// реверс (цель в стойке развернула умение): как у героев Чейза — умение кончается, кастер отпущен
if Bof_RevEnd(caster) then
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
set t=null
set caster=null
return
endif
call SaveReal(HH,id,3,speed)
call SaveReal(HH,id,4,decel)
call SetUnitInvulnerable(caster,true)
call PauseUnit(caster,true)
if tk<=21 then
call Bof_Put(caster,GetUnitX(caster)+CosBJ(ang)*speed,GetUnitY(caster)+SinBJ(ang)*speed)
set g=CreateGroup()
call GroupEnumUnitsInRange(g,GetUnitX(caster),GetUnitY(caster),220.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(caster),e) and GetUnitAbilityLevel(e,'Avul')==0 then
call SetUnitXY_1(e,GetUnitX(e)+speed*CosBJ(ang),GetUnitY(e)+speed*SinBJ(ang), true)
endif
endloop
call DestroyGroup(g)
endif
if tk==21 or tk==36 or tk==51 or tk==66 then
set hit=LoadInteger(HH,id,5)+1
call SaveInteger(HH,id,5,hit)
call Rem_Swing(caster,ang,hit)
call Rem_Noise(GetOwningPlayer(caster),30.,.29)
set x=GetUnitX(caster)+150.*CosBJ(ang)
set y=GetUnitY(caster)+150.*SinBJ(ang)
call Rem_Fx(caster,"bof\\Scarlet-67.mdx",x,y,150.,GetRandomDirectionDeg(),2.,0.)
call Rem_Fx(caster,"bof\\Scarlet-67.mdx",x,y,150.,GetRandomDirectionDeg(),2.,0.)
set g=CreateGroup()
call GroupEnumUnitsInRange(g,GetUnitX(caster),GetUnitY(caster),300.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(caster),e) and GetUnitAbilityLevel(e,'Avul')==0 then
call Rem_Fx(caster,"bof\\Scarlet-26.mdx",GetUnitX(e),GetUnitY(e),GetUnitFlyHeight(e)+150.,0.,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-52.mdx",GetUnitX(e),GetUnitY(e),GetUnitFlyHeight(e)+150.,0.,1.,0.)
call Bof_Dmg(caster,e,(I2R(Rem_Int_E(caster,true))*25.)*0.001)
call Bof_Ctrl(caster,e,1.,"stun")
endif
endloop
call DestroyGroup(g)
endif
if tk==91 then
call SetUnitInvulnerable(caster,false)
call PauseUnit(caster,false)
call SetUnitTimeScale(caster,1.)
call Bof_Unstick(caster)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set caster=null
set g=null
set e=null
endfunction
function Rem_E_Anim takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit caster=LoadUnitHandle(HH,GetHandleId(t),0)
call SetUnitTimeScale(caster,1.5)
call SetUnitAnimationByIndex(caster,7)
call FlushChildHashtable(HH,GetHandleId(t))
call DestroyTimer(t)
set t=null
set caster=null
endfunction
function Rem_E_Act takes unit caster,real tx,real ty returns nothing
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real ang=Atan2BJ(ty-y,tx-x)
local real z=GetUnitFlyHeight(caster)
local timer t
call SaveBoolean(HH,GetHandleId(caster),SH_bofRevd,false)
call Rem_Fx(caster,"bof\\Scarlet-4.mdx",x,y,z+150.,ang,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-74.mdx",x,y,z+150.,ang,1.,0.)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-T-YX2.wav",120)
call Bof_zU(.5,AddSpecialEffectTarget("bof\\Scarlet-9.mdx",caster,"chest"))
call Rem_Fx(caster,"bof\\Saber-15.mdx",x,y,125.,ang,1.,0.)
call Rem_Fx(caster,"bof\\Saber-17.mdx",x,y,z+50.,ang,1.5,0.)
call Rem_Fx(caster,"bof\\Minato-25.mdx",x,y,z+50.,ang,1.,0.)
call Rem_Fx(caster,"bof\\chongfeng2.mdx",x,y,z+50.,ang,1.,0.)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-E-YY1.mp3",100)
call SetUnitInvulnerable(caster,true)
call PauseUnit(caster,true)
set t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call TimerStart(t,.01,false,function Rem_E_Anim)
set t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call SaveReal(HH,GetHandleId(t),1,ang)
call SaveReal(HH,GetHandleId(t),3,100.)
call SaveReal(HH,GetHandleId(t),4,6.)
call TimerStart(t,.02,true,function Rem_E_Act2)
set t=null
endfunction
// ----- R «Spear the Gungnir»: пять нажатий, копьё в ближайшего вражеского героя -----
// Копьё летит в ближайшего вражеского героя в 3000, если героев нет — в ближайшего врага.
// Никого нет — нажатие не тратится (стадия остаётся 4).
function Rem_SpearReady takes unit u returns boolean
local group g=CreateGroup()
local unit e
local unit best=null
local real dmy
local real bestD=3001.
local boolean isHero=false
call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),3000.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
// неуязвимого героя тоже можно (половина урона копья проходит сквозь неуязвимость); неуязвимых дамми и сундуки — нет
if Condition_Base(GetOwningPlayer(u),e) and UnitIsAlive(e) and GetUnitAbilityLevel(e,'Aloc')==0 and (GetUnitAbilityLevel(e,'Avul')==0 or IsUnitType(e,UNIT_TYPE_HERO)) then
set dmy=SRS(GetUnitX(u),GetUnitY(u),GetUnitX(e),GetUnitY(e))
if (IsUnitType(e,UNIT_TYPE_HERO) and not isHero) or (IsUnitType(e,UNIT_TYPE_HERO)==isHero and dmy<bestD) then
set best=e
set bestD=dmy
set isHero=IsUnitType(e,UNIT_TYPE_HERO)
endif
endif
endloop
call DestroyGroup(g)
set g=null
set e=null
if best==null then
call SaveInteger(HH,GetHandleId(u),SH_RemSpearStage,4)
call DisplayTextToPlayer(GetOwningPlayer(u),0,0,Lng("Spear the Gungnir: рядом нет врага для копья","Spear the Gungnir: no enemy nearby for the spear"))
return false
endif
call SaveUnitHandle(HH,GetHandleId(u),SH_RemSpear,best)
set best=null
return true
endfunction
// Отсчёт R: 5 c без нажатия — стадия сбрасывается, R уходит на 40 c (после броска — тоже через 5 c)
function Rem_R_Idle takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit caster=LoadUnitHandle(HH,GetHandleId(t),0)
local integer cid=GetHandleId(caster)
call SaveReal(HH,cid,SH_RemSpearIdle,LoadReal(HH,cid,SH_RemSpearIdle)+.05)
if LoadReal(HH,cid,SH_RemSpearIdle)>=5. or not LoadBoolean(HH,cid,SH_RemSpearOn) then
call SaveBoolean(HH,cid,SH_RemSpearOn,false)
call SaveInteger(HH,cid,SH_RemSpearStage,0)
if not LoadBoolean(HH,cid,SH_RemSpearDone) then
call DisplayTextToPlayer(GetOwningPlayer(caster),0,0,Lng("Spear the Gungnir прервано!","Spear the Gungnir interrupted!"))
endif
if GetUnitAbilityLevel(caster,'RmR1')>0 then
call SetAbilityRemainingCooldown(GetUnitAbility(caster,'RmR1'),30.)
endif
call FlushChildHashtable(HH,GetHandleId(t))
call DestroyTimer(t)
endif
set t=null
set caster=null
endfunction
// R: цель, пронзённая копьём, поднимается в воздух и висит до конца способности (1.2 c), затем опускается
function Rem_R_LiftEnd takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit u=LoadUnitHandle(HH,GetHandleId(t),0)
if u!=null then
call SetUnitFlyHeight(u,GetUnitDefaultFlyHeight(u),1800.)
endif
call FlushChildHashtable(HH,GetHandleId(t))
call DestroyTimer(t)
set t=null
set u=null
endfunction
function Rem_R_Lift takes unit caster,unit target returns nothing
local timer t
if IsUnitType(target,UNIT_TYPE_STRUCTURE) or UnitIsAlive(target)==false then
return
endif
if GetUnitAbilityLevel(target,'Amrf')==0 then
call UnitAddAbility(target,'Amrf')
call UnitRemoveAbility(target,'Amrf')
endif
call SetUnitFlyHeight(target,450.,1800.)
call SetControlToUnit(caster,target,1.2,"stun")
set t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,target)
call TimerStart(t,1.2,false,function Rem_R_LiftEnd)
set t=null
endfunction
// Полёт копья, тик 0.03 c: до 4 c (133 тика) или пока не долетит (100); попало ближе 200 — урон
// R x240 + 15% максимума Ремилии (цель с Avul — половина, сквозь неуязвимость)
function Rem_R_Spear takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,0)
local unit target=LoadUnitHandle(HH,id,1)
local unit dmy=LoadUnitHandle(HH,id,2)
local integer tk=LoadInteger(HH,id,3)+1
local real x=GetUnitX(dmy)
local real y=GetUnitY(dmy)
local real tx=GetUnitX(target)
local real ty=GetUnitY(target)
local real ang=Atan2BJ(ty-y,tx-x)
local real dist=SRS(x,y,tx,ty)
local real dmg
local unit m
call SaveInteger(HH,id,3,tk)
call SetUnitFacing(dmy,ang)
if GetUnitTypeId(target)==0 or not UnitIsAlive(target) then
// цель умерла или пропала — копьё гаснет на месте
set dist=99999.
set tk=999
endif
if I2R(tk)*.01<=1.33 and dist>100. and UnitIsAlive(dmy) then
set x=x+100.*CosBJ(ang)
set y=y+100.*SinBJ(ang)
// SetUnitXY_1 без проверки: SetUnitPosition учитывал проходимость — копьё упиралось в декорации
call SetUnitXY_1(dmy,x,y, false)
if ModuloInteger(tk,2)==0 then
call Rem_Fx(caster,"bof\\Scarlet-55.mdx",x,y,150.,ang,1.,1.)
endif
if ModuloInteger(tk,4)==0 then
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-R-YX1.mp3",100)
call Rem_Fx(caster,"bof\\Scarlet-47.mdx",x+240.*CosBJ(ang+90.),y+240.*SinBJ(ang+90.),-1.,ang,1.,0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,30.)
call Rem_Fx(caster,"bof\\Scarlet-47.mdx",x+240.*CosBJ(ang-90.),y+240.*SinBJ(ang-90.),-1.,ang,1.,0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,30.)
endif
else
call CameraClearNoiseForPlayer(GetOwningPlayer(caster))
call SetUnitAnimation(dmy,"Death")
call Bof_zO(.2,dmy)
if dist<200. then
set m=CreateUnit(GetOwningPlayer(caster),'eBMC',tx,ty,ang)
call SetUnitScale(m,5.,1.,1)
call SetUnitFlyHeight(m,GetUnitFlyHeight(caster)+100.,0.)
call Bof_zU(0.,AddSpecialEffectTarget("bof\\Tsubaki-51.mdx",m,"origin"))
call SetUnitVertexColor(m,255,0,0,255)
call UnitApplyTimedLife(m,'BHwe',.01)
call Rem_Fx(caster,"bof\\Scarlet-4.mdx",tx,ty,25.,0.,1.5,0.)
call Rem_Fx(caster,"bof\\Scarlet-29.mdx",tx,ty,25.,0.,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-14.mdx",tx,ty,25.,0.,1.5,1.)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-R-YX2.mp3",100)
set dmg=I2R(Rem_Int_R(caster,true))*120.*0.001+GetUnitState(caster,UNIT_STATE_MAX_LIFE)*.15
if GetUnitAbilityLevel(target,'Avul')==0 then
call Bof_Dmg(caster,target,dmg)
else
call SetUnitInvulnerable(target,false)
call Bof_Dmg(caster,target,dmg*.5)
call SetUnitInvulnerable(target,true)
endif
call Rem_Noise(GetOwningPlayer(caster),80.,.8)
call Rem_R_Lift(caster,target)
endif
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set caster=null
set target=null
set dmy=null
set m=null
endfunction
// Бросок: Ремилия зависает 0.46 c, в 0.36 c копьё вылетает
function Rem_R_Act2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,0)
local unit target=LoadUnitHandle(HH,id,1)
local real ang=LoadReal(HH,id,2)
local integer tk=LoadInteger(HH,id,3)+1
local real x
local real y
local unit dmy
local timer t2
call SaveInteger(HH,id,3,tk)
// реверс (цель в стойке развернула умение): умение кончается, героиня отпущена
if Bof_RevEnd(caster) then
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
set t=null
set caster=null
set target=null
return
endif
call SetUnitInvulnerable(caster,true)
call PauseUnit(caster,true)
if tk==18 then
set x=GetUnitX(caster)+50.*CosBJ(ang)
set y=GetUnitY(caster)+50.*SinBJ(ang)
call CameraSetEQNoiseForPlayer(GetOwningPlayer(caster),50.)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-R-YX3.mp3",100)
set dmy=CreateUnit(GetOwningPlayer(caster),'eBLP',x,y,ang)
call UnitApplyTimedLife(dmy,'BHwe',5.1)
call SetUnitFlyHeight(dmy,150.,1000000000.)
call Bof_DzSetUnitModel(dmy,"bof\\Scarlet-16.mdx")
set t2=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t2),0,caster)
call SaveUnitHandle(HH,GetHandleId(t2),1,target)
call SaveUnitHandle(HH,GetHandleId(t2),2,dmy)
call TimerStart(t2,.03,true,function Rem_R_Spear)
endif
if tk==23 then
call SetUnitInvulnerable(caster,false)
call PauseUnit(caster,false)
// у bof проходимость после броска не возвращалась — Ремилия навсегда ходила сквозь юнитов
call SetUnitPathing(caster,true)
call SetUnitTimeScale(caster,1.)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set t2=null
set caster=null
set target=null
set dmy=null
endfunction
function Rem_R_Anim takes nothing returns nothing
local timer t=GetExpiredTimer()
call SetUnitAnimationByIndex(LoadUnitHandle(HH,GetHandleId(t),0),3)
call FlushChildHashtable(HH,GetHandleId(t))
call DestroyTimer(t)
set t=null
endfunction
function Rem_R_Act takes unit caster returns nothing
local integer cid=GetHandleId(caster)
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real z=GetUnitFlyHeight(caster)
local integer stage=LoadInteger(HH,cid,SH_RemSpearStage)+1
local unit target
local group g
local unit e
local timer t
call SaveInteger(HH,cid,SH_RemSpearStage,stage)
// каждое нажатие: удар 800 с замедлением
set g=CreateGroup()
call GroupEnumUnitsInRange(g,x,y,800.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(caster),e) and GetUnitAbilityLevel(e,'Avul')==0 then
call Bof_Dmg(caster,e,(I2R(Rem_Int_R(caster,true))*24.)*0.001)
call Bof_Slow(caster,e,0.5,0,2,2,false)
endif
endloop
call DestroyGroup(g)
call SaveReal(HH,cid,SH_RemSpearIdle,0.)
call Rem_Fx(caster,"bof\\Scarlet-29.mdx",x,y,z,0.,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-14.mdx",x,y,20.,0.,1.,1.)
call Rem_Fx(caster,"bof\\Scarlet-21.mdx",x,y,z,0.,2.,0.)
call Rem_Fx(caster,"bof\\Scarlet-65.mdx",x,y,z,0.,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-4.mdx",x,y,z,0.,1.,0.)
if stage==1 then
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-R-YY1.mp3",100)
call SaveBoolean(HH,cid,SH_RemSpearDone,false)
call Rem_Text(caster,Lng("Высекаю знак благодати","I carve the sign of grace"))
if not LoadBoolean(HH,cid,SH_RemSpearOn) then
call SaveBoolean(HH,cid,SH_RemSpearOn,true)
call SaveReal(HH,cid,SH_RemSpearIdle,0.)
set t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call TimerStart(t,.05,true,function Rem_R_Idle)
endif
elseif stage==2 then
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-R-YY2.mp3",100)
call Rem_Text(caster,Lng("Судьбой правит «колеблющееся»","Fate is ruled by the wavering"))
elseif stage==3 then
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-R-YY3.mp3",100)
call Rem_Text(caster,Lng("Я — из рода истинных вампиров","I am of the line of true vampires"))
elseif stage==4 then
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-R-YY4.mp3",100)
call Rem_Text(caster,Lng("Пронжу тебя","I will pierce you"))
elseif stage==5 and Rem_SpearReady(caster) then
set target=LoadUnitHandle(HH,cid,SH_RemSpear)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-R-YY5.mp3",100)
call Rem_Text(caster,"Spear the Gungnir")
call SaveInteger(HH,cid,SH_RemSpearStage,0)
call SaveBoolean(HH,cid,SH_RemSpearDone,true)
// полное прочтение — R сразу уходит на перезарядку 30 c (раньше — только через 5 c ожидания)
call SaveBoolean(HH,cid,SH_RemSpearOn,false)
call SetAbilityRemainingCooldown(GetUnitAbility(caster,'RmR1'),30.)
set t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call TimerStart(t,.01,false,function Rem_R_Anim)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call SetUnitPathing(caster,false)
set t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call SaveUnitHandle(HH,GetHandleId(t),1,target)
call SaveReal(HH,GetHandleId(t),2,Atan2BJ(GetUnitY(target)-y,GetUnitX(target)-x))
call TimerStart(t,.02,true,function Rem_R_Act2)
endif
set target=null
set g=null
set e=null
set t=null
endfunction
// ----- D «Vampire Illusion»: 40 цепей за 2 c, каждая бьёт всех в 150 и оглушает -----
function Rem_D_Chain takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,0)
local unit dmy=LoadUnitHandle(HH,id,1)
local real ang=LoadReal(HH,id,2)
local integer tk=LoadInteger(HH,id,3)+1
local real speed=LoadReal(HH,id,4)
local real x
local real y
local group g
local unit e
call SaveInteger(HH,id,3,tk)
if speed<=100. then
set speed=speed+5.
call SaveReal(HH,id,4,speed)
endif
if tk<=12 and UnitIsAlive(dmy) then
set x=GetUnitX(dmy)+speed*CosBJ(ang)
set y=GetUnitY(dmy)+speed*SinBJ(ang)
call SetUnitXY_1(dmy,x,y, false)
set g=CreateGroup()
call GroupEnumUnitsInRange(g,x,y,150.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if GetUnitAbilityLevel(e,'Avul')==0 and UnitIsAlive(e) and Condition_Base(GetOwningPlayer(caster),e) then
if dmy!=null then
call RemoveUnit(dmy)
set dmy=null
endif
call Bof_Dmg(caster,e,(I2R(Rem_Int_D(caster,true))*3.)*0.001)
call DestroyEffect(AddSpecialEffectTarget("bof\\Scarlet-52.mdx",e,"chest"))
call Bof_Ctrl(caster,e,.5,"stun")
endif
endloop
call DestroyGroup(g)
if dmy==null then
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
else
call SetUnitAnimation(dmy,"Death")
call Bof_zO(.4,dmy)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set caster=null
set dmy=null
set g=null
set e=null
endfunction
function Rem_D_Act2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,0)
local real px=LoadReal(HH,id,1)
local real py=LoadReal(HH,id,2)
local real ang=LoadReal(HH,id,3)
local integer tk=LoadInteger(HH,id,4)+1
local real r
local unit dmy
local timer t2
call SaveInteger(HH,id,4,tk)
// реверс (цепь попала по стойке): D кончается, Ремилия отпущена (Bof_RevEnd снимает паузу и неуязвимость)
if Bof_RevEnd(caster) then
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
set t=null
set caster=null
return
endif
if ModuloInteger(tk,10)==3 then
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-D-YX2.mp3",100)
endif
if tk<=40 then
set r=GetRandomReal(-250.,250.)
set dmy=CreateUnit(GetOwningPlayer(caster),'eBLP',px+r*CosBJ(ang+90.),py+GetRandomReal(-250.,250.)*SinBJ(ang+90.),ang)
call SetUnitScale(dmy,.5,.5,.5)
call Bof_DzSetUnitModel(dmy,"bof\\Scarlet-16.mdx")
call UnitApplyTimedLife(dmy,'BHwe',2.)
call SetUnitVertexColor(dmy,255,255,255,0)
call SetUnitFlyHeight(dmy,GetRandomReal(0,300.),1000000000.)
call Rem_FadeIn(dmy,5)
set t2=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t2),0,caster)
call SaveUnitHandle(HH,GetHandleId(t2),1,dmy)
call SaveReal(HH,GetHandleId(t2),2,ang)
call SaveReal(HH,GetHandleId(t2),4,40.)
call TimerStart(t2,.02,true,function Rem_D_Chain)
else
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set t2=null
set caster=null
set dmy=null
endfunction
function Rem_D_Act takes unit caster,real tx,real ty returns nothing
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real ang=Atan2BJ(ty-y,tx-x)
local real px=x+150.*CosBJ(ang)
local real py=y+150.*SinBJ(ang)
local unit dmy=CreateUnit(GetOwningPlayer(caster),'eBLU',px,py,ang)
local timer t=CreateTimer()
call SetUnitScale(dmy,2.5,2.5,2.5)
call SetUnitFlyHeight(dmy,GetUnitFlyHeight(caster)+275.,0.)
call SetUnitVertexColor(dmy,255,255,255,255)
// у Scarlet-76 нет анимации смерти: умерший по таймеру дамми оставался лежать на земле (владелец 4 окт) —
// убираем его RemoveUnit через 3 c
call Bof_zO(3.,dmy)
call Bof_DzSetUnitModel(dmy,"bof\\Scarlet-76.mdx")
call Rem_FadeIn(dmy,3)
// красного круга bof (Scarlet-10) в точке каста нет: он лежал на земле после D (владелец 3 окт: «убери»)
call Rem_Fx(caster,"bof\\Scarlet-4.mdx",x,y,25.,ang,1.,0.)
// пока летят цепи (2 c), Ремилия стоит в паузе и неуязвима (владелец 3 окт)
call SaveBoolean(HH,GetHandleId(caster),SH_bofRevd,false)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-D-YY1.mp3",100)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-D-YX1.mp3",100)
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call SaveReal(HH,GetHandleId(t),1,px)
call SaveReal(HH,GetHandleId(t),2,py)
call SaveReal(HH,GetHandleId(t),3,ang)
call TimerStart(t,.05,true,function Rem_D_Act2)
set dmy=null
set t=null
endfunction
// ----- F «Scarlet Netherworld»: до 4 c неуязвима, теряет 2% максимума в секунду; выход — RmF2 -----
function Rem_F_Act2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,0)
local unit pool=LoadUnitHandle(HH,id,1)
local integer tk=LoadInteger(HH,id,2)+1
local boolean over=tk>80
call SaveInteger(HH,id,2,tk)
if not over then
call SetUnitXY_1(pool,GetUnitX(caster),GetUnitY(caster), false)
call SetUnitInvulnerable(caster,true)
if tk==1 or ModuloInteger(tk-1,8)==0 then
call Rem_Fx(caster,"bof\\Scarlet-4.mdx",GetUnitX(caster),GetUnitY(caster),25.,GetUnitFacing(caster),1.,0.)
endif
if GetWidgetLife(caster)>GetUnitState(caster,UNIT_STATE_MAX_LIFE)*.093 and LoadBoolean(HH,GetHandleId(caster),SH_RemFOn) then
call SetWidgetLife(caster,GetWidgetLife(caster)-GetUnitState(caster,UNIT_STATE_MAX_LIFE)*.001)
else
set over=true
endif
endif
if over then
call SaveBoolean(HH,GetHandleId(caster),SH_RemFOn,false)
call UnitRemoveAbility(caster,'RmF2')
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'RmF1',true)
call Rem_FLock(caster,false)
call SetUnitInvulnerable(caster,false)
// озеро уходит вместе с концом F (у bof лежало до 12 c)
call KillUnit(pool)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set caster=null
set pool=null
endfunction
function Rem_F_Act takes unit caster returns nothing
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local unit pool=CreateUnit(GetOwningPlayer(caster),'eBLP',x,y,0.)
local timer t=CreateTimer()
call Bof_DzSetUnitModel(pool,"bof\\Scarlet-14.mdx")
call UnitApplyTimedLife(pool,'BHwe',12.)
call Rem_Fx(caster,"bof\\Scarlet-8.mdx",x,y,GetUnitFlyHeight(caster)+20.,0.,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-73.mdx",x,y,GetUnitFlyHeight(caster)+20.,0.,3.,0.)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-F-YY1.mp3",100)
call SaveBoolean(HH,GetHandleId(caster),SH_RemFOn,true)
call UnitAddAbility(caster,'RmF2')
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'RmF1',false)
call Rem_FLock(caster,true)
call SetUnitInvulnerable(caster,true)
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call SaveUnitHandle(HH,GetHandleId(t),1,pool)
call TimerStart(t,.05,true,function Rem_F_Act2)
set pool=null
set t=null
endfunction
// RmF2 — выйти из F раньше: таймер F закончит на следующем тике
function Rem_F2_Act takes unit caster returns nothing
call SaveBoolean(HH,GetHandleId(caster),SH_RemFOn,false)
endfunction
// ----- Heart Break (конец T): рывок за спину цели, отнимает 20% её максимума, лечит на столько же -----
function Rem_T_Kill takes unit caster,unit target returns nothing
// убила финальным уроном T — навсегда +4% максимума цели (не больше 30000) к своему максимуму
local integer cid=GetHandleId(caster)
local integer bonus=IMinBJ(R2I(GetUnitState(target,UNIT_STATE_MAX_LIFE)*.04),30000)
if not IsUnitType(target,UNIT_TYPE_HERO) or IsUnitIllusion(target) then
return
endif
call SaveInteger(HH,cid,SH_RemKillLife,LoadInteger(HH,cid,SH_RemKillLife)+bonus)
call Bof_xa(caster,0,2,LoadInteger(HH,cid,SH_RemKillLife)+LoadInteger(HH,cid,SH_RemTmpLife))
endfunction
// цель T помечена (кто её держит) на T 8.72 c + Heart Break 0.8 c + запас 1.5 c: умрёт за это время — от чего
// угодно — Ремилии +4% (Rem_OnKill из Trig_Killer_Actions, в момент смерти, до возрождения в конце раунда)
function Rem_TUnmark takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit e=LoadUnitHandle(HH,GetHandleId(t),1)
if e!=null and LoadUnitHandle(HH,GetHandleId(e),SH_RemTBy)==LoadUnitHandle(HH,GetHandleId(t),0) then
call RemoveSavedHandle(HH,GetHandleId(e),SH_RemTBy)
endif
call FlushChildHashtable(HH,GetHandleId(t))
call DestroyTimer(t)
set t=null
set e=null
endfunction
function Rem_TMark takes unit caster,unit target returns nothing
local timer t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(target),SH_RemTBy,caster)
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call SaveUnitHandle(HH,GetHandleId(t),1,target)
call TimerStart(t,11.,false,function Rem_TUnmark)
set t=null
endfunction
function Rem_OnKill takes unit u returns nothing
local unit c=LoadUnitHandle(HH,GetHandleId(u),SH_RemTBy)
if c!=null then
call RemoveSavedHandle(HH,GetHandleId(u),SH_RemTBy)
call Rem_T_Kill(c,u)
endif
set c=null
endfunction
function Rem_HeartBreak_Act2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,0)
local unit target=LoadUnitHandle(HH,id,1)
local integer tk=LoadInteger(HH,id,2)+1
local real ang
local real x
local real y
local real tx
local real ty
local real dmg
call SaveInteger(HH,id,2,tk)
// реверс (цель в стойке развернула умение): как у героев Чейза — умение кончается, кастер отпущен
if Bof_RevEnd(caster) then
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
set t=null
set caster=null
set target=null
return
endif
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
if tk==1 then
call SetUnitTimeScale(caster,1.)
call SetUnitAnimationByIndex(caster,18)
endif
if tk==10 then
set tx=GetUnitX(target)
set ty=GetUnitY(target)
set ang=Atan2BJ(ty-GetUnitY(caster),tx-GetUnitX(caster))
call SetUnitXY_1(caster,tx+200.*CosBJ(ang),ty+200.*SinBJ(ang), true)
set x=GetUnitX(caster)
set y=GetUnitY(caster)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-T-YX5.wav",100)
call Rem_Fx(caster,"bof\\Scarlet-44.mdx",x,y,GetUnitFlyHeight(caster)+150.,ang+180.,2.,0.)
call SetSpecialEffectRoll(bj_lastCreatedEffect,45.)
call Rem_Fx(caster,"bof\\Scarlet-72.mdx",x,y,GetUnitFlyHeight(caster)+150.,ang+180.,2.5,0.)
call Rem_Fx(caster,"bof\\Scarlet-61.mdx",tx,ty,GetUnitFlyHeight(target)+20.,ang,4.,0.)
call Rem_Fx(caster,"bof\\Scarlet-36.MDX",tx,ty,GetUnitFlyHeight(target)+20.,ang,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-43.mdx",tx,ty,GetUnitFlyHeight(target)+150.,ang,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-52.mdx",tx,ty,GetUnitFlyHeight(target)+150.,ang,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-3.mdx",tx,ty,GetUnitFlyHeight(target)+150.,GetRandomDirectionDeg(),8.,0.)
call Rem_Fx(caster,"bof\\Scarlet-3.mdx",tx,ty,GetUnitFlyHeight(target)+150.,GetRandomDirectionDeg(),8.,0.)
call Rem_Noise(GetOwningPlayer(caster),60.,.6)
// цель в стойке-реверсе: ни урона, ни лечения, ни стана (Bof_Rev отдаёт ей Ремилию)
if not Bof_Rev(caster,target) then
set dmg=GetUnitState(target,UNIT_STATE_MAX_LIFE)*.2
call Bof_Dmg(caster,target,dmg)
call Bof_Heal(caster,caster,dmg)
call Bof_Ctrl(caster,target,1.5,"stun")
endif
endif
if tk==40 then
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
call Bof_Unstick(caster)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set caster=null
set target=null
endfunction
function Rem_HeartBreak takes unit caster,unit target returns nothing
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real ang=Atan2BJ(GetUnitY(target)-y,GetUnitX(target)-x)
local timer t
call SaveBoolean(HH,GetHandleId(caster),SH_bofRevd,false)
if caster==null or target==null or not UnitIsAlive(target) or not UnitIsAlive(caster) then
return
endif
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-ZS1-YY1.mp3",120)
call Rem_Shadow(caster,x,y)
call Rem_Fx(caster,"bof\\Scarlet-8.mdx",x,y,-1.,0.,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-4.mdx",x,y,-1.,0.,1.,0.)
call Rem_Fx(caster,"bof\\Tsubaki-33.mdx",x,y,-1.,0.,1.,0.)
call Rem_Fx(caster,"bof\\Madara-huitu-22.mdx",x,y,25.,0.,4.,0.)
call SetUnitFacing(caster,Atan2BJ(y-GetUnitY(target),x-GetUnitX(target)))
call Rem_Fx(caster,"bof\\Scarlet-4.mdx",x,y,GetUnitFlyHeight(caster),ang,1.,0.)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
set t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call SaveUnitHandle(HH,GetHandleId(t),1,target)
call TimerStart(t,.02,true,function Rem_HeartBreak_Act2)
set t=null
endfunction
// ----- T «Red the Nightless Castle»: 8.7 c держит цель, серия, вихрь; в конце урон и Heart Break -----
function Rem_T_Act2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,0)
local unit target=LoadUnitHandle(HH,id,1)
local real ang=LoadReal(HH,id,2)
local integer tk=LoadInteger(HH,id,3)+1
local integer k
local integer i
local real tx=GetUnitX(target)
local real ty=GetUnitY(target)
local real tz=GetUnitFlyHeight(target)
local real dmg
local player p=GetOwningPlayer(caster)
local player tp=GetOwningPlayer(target)
call SaveInteger(HH,id,3,tk)
// реверс (цель в стойке развернула умение): умение кончается, героиня отпущена
if Bof_RevEnd(caster) then
call Bof_Unstick(caster)
call PauseUnit(target,false)
call SetUnitInvulnerable(target,false)
call RemoveSavedHandle(HH,GetHandleId(target),SH_RemTBy)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
call CameraClearNoiseForPlayer(p)
call CameraClearNoiseForPlayer(tp)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
set t=null
set caster=null
set target=null
set p=null
set tp=null
return
endif
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call PauseUnit(target,true)
call SetUnitInvulnerable(target,true)
if tk==155 then
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-T-YY2.mp3",100)
endif
if tk==350 then
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-T-YY3.mp3",115)
endif
if tk==1 then
call SetUnitFacing(caster,Atan2BJ(ty-GetUnitY(caster),tx-GetUnitX(caster)))
call SetUnitFacing(target,Atan2BJ(GetUnitY(caster)-ty,GetUnitX(caster)-tx))
call SetUnitTimeScale(caster,1.)
call SetUnitAnimationByIndex(caster,6)
call Rem_Fx(caster,"bof\\Scarlet-74.mdx",GetUnitX(caster),GetUnitY(caster),GetUnitFlyHeight(caster)+150.,ang,1.,0.)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-T-YX2.wav",120)
call Rem_Noise(p,35.,.4)
call Rem_Noise(tp,35.,.4)
endif
// серия: 4 удара (1.0, 1.6, 2.2, 2.8 c), каждый толкает обоих на 60
if tk==50 or tk==80 or tk==110 or tk==140 then
set k=LoadInteger(HH,id,4)+1
call SaveInteger(HH,id,4,k)
call Rem_Swing(caster,ang,k)
call Rem_Noise(p,35.,.29)
call Rem_Noise(tp,35.,.29)
call Bof_Slide(caster,ang,60.,.3)
call Rem_Fx(caster,"bof\\Scarlet-3.mdx",tx,ty,tz+150.,GetRandomDirectionDeg(),3.,0.)
call Rem_Fx(caster,"bof\\Tsubaki-41.mdx",tx,ty,tz+150.,GetRandomDirectionDeg(),2.,0.)
call Rem_Fx(caster,"bof\\Scarlet-52.mdx",tx,ty,tz+150.,GetRandomDirectionDeg(),1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-26.mdx",tx,ty,tz+150.,GetRandomDirectionDeg(),1.,0.)
call Rem_Fx(caster,"bof\\hongping.mdx",tx,ty,tz+20.,0.,1.,0.)
call SetSpecialEffectTimeScale(bj_lastCreatedEffect,.5)
call Bof_Slide(target,ang,60.,.3)
endif
if tk==156 then
call Rem_Fx(caster,"bof\\Scarlet-29.mdx",GetUnitX(caster),GetUnitY(caster),GetUnitFlyHeight(caster),ang,1.,0.)
call Bof_zU(.8,AddSpecialEffectTarget("bof\\Scarlet-9.mdx",caster,"chest"))
call DestroyEffect(AddSpecialEffectTarget("bof\\Scarlet-34.mdx",caster,"chest"))
call SetUnitAnimationByIndex(caster,22)
call Bof_Slide(caster,ang,400.,1.)
call Bof_Slide(target,ang,400.,1.)
endif
if tk>=157 and tk<=205 then
set k=LoadInteger(HH,id,5)+1
call SaveInteger(HH,id,5,k)
if k==1 or ModuloInteger(k-1,4)==0 then
call Rem_Fx(caster,"bof\\Scarlet-5.mdx",tx,ty,tz+150.,0.,1.,0.)
endif
endif
if tk==206 then
call CameraSetEQNoiseForPlayer(p,25.)
call CameraSetEQNoiseForPlayer(tp,25.)
call SaveInteger(HH,id,5,0)
call SetUnitTimeScale(caster,.25)
call Rem_Fx(caster,"bof\\Scarlet-57.MDX",tx,ty,tz+150.,0.,1.5,2.)
call Rem_Fx(caster,"bof\\Scarlet-21.mdx",tx,ty,450.,ang,3.,0.)
call Rem_Fx(caster,"bof\\Scarlet-70.mdx",tx,ty,25.,0.,2.5,5.)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-T-YX10.mp3",100)
endif
if tk>=207 and tk<=255 then
set k=LoadInteger(HH,id,5)+1
call SaveInteger(HH,id,5,k)
if k==1 or ModuloInteger(k-1,4)==0 then
call Rem_Fx(caster,"bof\\Scarlet-15.MDX",tx,ty,tz+150.,0.,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-54.mdx",tx,ty,tz+150.,0.,1.,0.)
endif
if k==1 or ModuloInteger(k-1,8)==0 then
call Rem_RandFx(caster,GetUnitX(caster),GetUnitY(caster),800.,120)
endif
endif
if tk==256 then
call SaveInteger(HH,id,5,0)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-T-YX8.mp3",100)
endif
if tk>=257 and tk<=305 then
set k=LoadInteger(HH,id,5)+1
call SaveInteger(HH,id,5,k)
if k==1 or ModuloInteger(k-1,8)==0 then
set i=1
loop
exitwhen i>5
call Rem_Fx(caster,"bof\\Scarlet-58.mdx",tx+CosBJ(I2R(i)*72.)*150.,ty+SinBJ(I2R(i)*72.)*150.,tz+100.,I2R(i)*72.+180.,1.,0.)
set i=i+1
endloop
call Rem_RandFx(caster,GetUnitX(caster),GetUnitY(caster),800.,120)
endif
endif
if tk==306 then
call SaveInteger(HH,id,5,0)
call Rem_Fx(caster,"bof\\Scarlet-62.mdx",tx,ty,tz+150.,0.,1.,3.)
call Rem_Fx(caster,"bof\\Scarlet-57.MDX",tx,ty,tz+150.,0.,3.,3.)
call Rem_Fx(caster,"bof\\Scarlet-5.mdx",tx,ty,25.,0.,15.,0.)
endif
if tk==310 then
call CameraClearNoiseForPlayer(p)
call CameraClearNoiseForPlayer(tp)
call CameraSetEQNoiseForPlayer(p,80.)
call CameraSetEQNoiseForPlayer(tp,80.)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-T-YX6.mp3",110)
call Rem_Fx(caster,"bof\\hongping.mdx",tx,ty,25.,0.,2.,0.)
call SetSpecialEffectTimeScale(bj_lastCreatedEffect,.1)
endif
if tk==361 then
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-T-YX7.mp3",110)
endif
if tk>=307 and tk<=360 then
set k=LoadInteger(HH,id,5)+1
call SaveInteger(HH,id,5,k)
if k==1 or ModuloInteger(k-1,4)==0 then
call Rem_Fx(caster,"bof\\Scarlet-47.mdx",tx,ty,25.,0.,1.5,0.)
endif
if k==1 or ModuloInteger(k-1,12)==0 then
call Rem_Fx(caster,"bof\\Scarlet-5.mdx",tx,ty,25.,0.,15.,0.)
call Rem_Fx(caster,"bof\\Scarlet-5.mdx",GetUnitX(caster),GetUnitY(caster),25.,0.,8.,0.)
endif
endif
if tk==380 then
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
call PauseUnit(target,false)
call SetUnitInvulnerable(target,false)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
call SetUnitTimeScale(caster,1.)
call CameraClearNoiseForPlayer(p)
call CameraClearNoiseForPlayer(tp)
// урон: 30% разницы здоровья обоих + 6*ИНТ
set dmg=RAbsBJ(GetWidgetLife(caster)-GetWidgetLife(target))*.3+I2R(GetHeroInt(caster,true))*300.*0.02
if UnitIsAlive(target) then
call Bof_Dmg(caster,target,dmg)
endif
call Rem_HeartBreak(caster,target)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set caster=null
set target=null
set p=null
set tp=null
endfunction
function Rem_T_Act takes unit caster,unit target returns nothing
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real ang
local real bx
local real by
local timer t
// цель в стойке-реверсе: захват не начинается, цели отдаём Ремилию (Bof_Rev), стойка контратакует
if Bof_Rev(caster,target) then
return
endif
call Rem_TMark(caster,target)
call Rem_Fx(caster,"bof\\Scarlet-29.mdx",x,y,GetUnitFlyHeight(caster),0.,1.,0.)
call Rem_Shadow(caster,x,y)
call Rem_Fx(caster,"bof\\Saber-28.mdx",x,y,25.,0.,4.,3.)
call SetSpecialEffectTimeScale(bj_lastCreatedEffect,.25)
call Rem_Fx(caster,"bof\\Scarlet-14.mdx",x,y,20.,0.,1.,3.)
set ang=Atan2BJ(GetUnitY(target)-y,GetUnitX(target)-x)
// Ремилия встаёт в 150 перед целью (со стороны, где стояла)
set bx=GetUnitX(target)+150.*CosBJ(Atan2BJ(y-GetUnitY(target),x-GetUnitX(target)))
set by=GetUnitY(target)+150.*SinBJ(Atan2BJ(y-GetUnitY(target),x-GetUnitX(target)))
call SetUnitXY_1(caster,bx,by, true)
call Rem_Fx(caster,"bof\\Scarlet-21.mdx",bx,by,GetUnitFlyHeight(caster),ang,2.,0.)
call Rem_Fx(caster,"bof\\Scarlet-65.mdx",bx,by,GetUnitFlyHeight(caster),ang,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-4.mdx",bx,by,GetUnitFlyHeight(caster),ang,1.,0.)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call PauseUnit(target,true)
call SetUnitInvulnerable(target,true) // цель неуязвима на время T (никто не перебивает)
// цель держат: её стойки и каналы (Спирит Бомб и т.п.) ждут, как при захватах 3.2
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-T-YX1.mp3",100)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-T-YY1.mp3",100)
set t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call SaveUnitHandle(HH,GetHandleId(t),1,target)
call SaveReal(HH,GetHandleId(t),2,ang)
call TimerStart(t,.013,true,function Rem_T_Act2) // T быстрее (было .02), конец на 380-м тике вместо 436 — ~5 c вместо ~8.7
set t=null
endfunction
// ----- G «Scarlet Destiny»: 10 c круг 1200 — жжёт 1% маны раз в 0.2 c, без маны (<20%) — урон -----
function Rem_G_Sound2 takes nothing returns nothing
local timer t=GetExpiredTimer()
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-G-YY3.mp3",120)
call DestroyTimer(t)
set t=null
endfunction
function Rem_G_Sound1 takes nothing returns nothing
local timer t=GetExpiredTimer()
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-G-YY2.mp3",100)
call TimerStart(t,4.1,false,function Rem_G_Sound2)
set t=null
endfunction
function Rem_G_Act2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,0)
local unit ring=LoadUnitHandle(HH,id,1)
local unit wave=LoadUnitHandle(HH,id,2)
local integer tk=LoadInteger(HH,id,3)+1
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real burn
local group g
local unit e
call SaveInteger(HH,id,3,tk)
// смерть Ремилии или конец раунда — G кончается (раньше жгла ману и била до 10 c)
if tk<=200 and (not UnitIsAlive(caster) or udg_B==false) then
call RemoveUnit(ring)
call RemoveUnit(wave)
set tk=201
endif
if tk<=200 then
call SetUnitXY_1(ring,x,y, false)
call SetUnitXY_1(wave,x,y, false)
if tk==1 or ModuloInteger(tk-1,8)==0 then
call Rem_Fx(caster,"bof\\Scarlet-4.mdx",x,y,25.,GetUnitFacing(caster),1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-29.mdx",x,y,GetUnitFlyHeight(caster),GetUnitFacing(caster),1.,0.)
endif
if tk==1 or ModuloInteger(tk-1,4)==0 then
set g=CreateGroup()
call GroupEnumUnitsInRange(g,x,y,1200.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
// цель в стойке-реверсе: маны не жжём, Bof_Rev отдаёт ей Ремилию
if Condition_Base(GetOwningPlayer(caster),e) and not Bof_Rev(caster,e) then
set burn=GetUnitState(e,UNIT_STATE_MAX_MANA)*.01
call SetUnitManaBJ(e,GetUnitState(e,UNIT_STATE_MANA)-burn)
if GetUnitState(e,UNIT_STATE_MANA)<GetUnitState(e,UNIT_STATE_MAX_MANA)*.2 then
call Bof_Dmg(caster,e,(I2R(Rem_Int_G(caster,true))*6.)*0.001)
endif
endif
endloop
call DestroyGroup(g)
call Rem_RandFx(caster,x,y,1200.,90)
endif
else
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set caster=null
set ring=null
set wave=null
set g=null
set e=null
endfunction
function Rem_G_Act takes unit caster returns nothing
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local unit ring=CreateUnit(GetOwningPlayer(caster),'eBLP',x,y,0.)
local unit wave=CreateUnit(GetOwningPlayer(caster),'eBLP',x,y,0.)
local timer t
call Rem_Fx(caster,"bof\\Scarlet-57.MDX",x,y,150.,0.,1.5,2.)
call Rem_Fx(caster,"bof\\Scarlet-21.mdx",x,y,25.,0.,3.,0.)
call Rem_Fx(caster,"bof\\Scarlet-29.mdx",x,y,GetUnitFlyHeight(caster),0.,1.,0.)
call Bof_DzSetUnitModel(ring,"bof\\Scarlet-70.mdx")
call SetUnitScale(ring,3.,3.,3.)
call UnitApplyTimedLife(ring,'BHwe',10.)
call Bof_DzSetUnitModel(wave,"bof\\Scarlet-5.mdx")
call SetUnitScale(wave,10.,10.,10.)
call UnitApplyTimedLife(wave,'BHwe',3.)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-G-YY1.mp3",100)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-G-YX1.mp3",100)
call TimerStart(CreateTimer(),3.1,false,function Rem_G_Sound1)
set t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call SaveUnitHandle(HH,GetHandleId(t),1,ring)
call SaveUnitHandle(HH,GetHandleId(t),2,wave)
call TimerStart(t,.05,true,function Rem_G_Act2)
set ring=null
set wave=null
set t=null
endfunction
//Remilia1end
//Flandre1start
// ===== Фландре Скарлет (Touhou, перенос из bof) — переписано в стиле Чейза =====
// Данные умения — в HH под хэндлом таймера (маленькие ключи), состояние героя — в HH под хэндлом
// героя (константы SH_Fla...). Время — целыми тиками таймера (n): тики те же, что у bof.
// Звук/эффекты/надпись/тряска — общие с Ремилией (Rem_Sound, Rem_Fx, Rem_Text, Rem_Noise), урон/стан/
// замедление с реверсом — из библиотеки bof (Bof_Dmg, Bof_Ctrl, Bof_Slow).
// интеллект для урона кнопки D: x (0.0375), x160 = 6 (нерф 3.7.9; 4 окт было 0.05625 = 9);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Fla_Int_D takes unit u,boolean b returns integer
return R2I(I2R(GetHeroInt(u,b))*(0.0375)*1000.+0.5)
endfunction
// интеллект для урона кнопки E: x (3 + уровень)/120, x30 = 1..2 за удар, ударов 4 — стандарт карты 4..8 (4 окт);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Fla_Int_E takes unit u,boolean b returns integer
return R2I(I2R(GetHeroInt(u,b))*((3.+I2R(GetUnitAbilityLevel(u,'FlE1')))/120.)*1000.+0.5)
endfunction
// интеллект для урона кнопки F: урон bof x (0.0175), бафф 28 сен x1.25 (было 0.014);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Fla_Int_F takes unit u,boolean b returns integer
return R2I(I2R(GetHeroInt(u,b))*(0.0175)*1000.+0.5)
endfunction
// интеллект для урона кнопки G: x (0.02), x20 = 0.4 за луч, лучей 16 (4 окт; было 0.05 — 16*ИНТ за G);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Fla_Int_G takes unit u,boolean b returns integer
return R2I(I2R(GetHeroInt(u,b))*(0.02)*1000.+0.5)
endfunction
// интеллект для урона кнопки G2: x (0.025), x100 = 2.5 за удар, ударов 2 (4 окт);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Fla_Int_G2 takes unit u,boolean b returns integer
return R2I(I2R(GetHeroInt(u,b))*(0.025)*1000.+0.5)
endfunction
// интеллект для урона кнопки Q: урон bof x (0.0225 + 0.005 x уровень), бафф 28 сен x1.25 (было 0.018 + 0.004 x уровень);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Fla_Int_Q takes unit u,boolean b returns integer
return R2I(I2R(GetHeroInt(u,b))*(0.0225+0.005*I2R(GetUnitAbilityLevel(u,'FlQ1')))*1000.+0.5)
endfunction
// интеллект для урона кнопки R: x (3 + уровень)/480, x80 = 0.67..1.33 за удар (3 нажатия + 3 копья) — стандарт 4..8 (4 окт);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Fla_Int_R takes unit u,boolean b returns integer
return R2I(I2R(GetHeroInt(u,b))*((3.+I2R(GetUnitAbilityLevel(u,'FlR1')))/480.)*1000.+0.5)
endfunction
// интеллект для урона кнопки W: x (5 + 3 x уровень)/960, x120 = 1..2.5 за удар, ударов 2 (+W2) — стандарт (4 окт);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Fla_Int_W takes unit u,boolean b returns integer
return R2I(I2R(GetHeroInt(u,b))*((5.+3.*I2R(GetUnitAbilityLevel(u,'FlW1')))/960.)*1000.+0.5)
endfunction
// интеллект для урона кнопки W2: x (0.0125), x80 = 1 за удар веера (4 окт);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Fla_Int_W2 takes unit u,boolean b returns integer
return R2I(I2R(GetHeroInt(u,b))*(0.0125)*1000.+0.5)
endfunction
// интеллект для урона кнопки atk: урон bof x (0.0095), бафф 28 сен (было 0.0075);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Fla_Int_atk takes unit u,boolean b returns integer
return R2I(I2R(GetHeroInt(u,b))*(0.0095)*1000.+0.5)
endfunction
// интеллект для урона кнопки ord_atk: урон bof x (0.0225), бафф 28 сен x1.25 (было 0.018);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Fla_Int_ord_atk takes unit u,boolean b returns integer
return R2I(I2R(GetHeroInt(u,b))*(0.0225)*1000.+0.5)
endfunction
// интеллект для урона кнопки ord_smart: урон bof x (0.0225), бафф 28 сен x1.25 (было 0.018);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Fla_Int_ord_smart takes unit u,boolean b returns integer
return R2I(I2R(GetHeroInt(u,b))*(0.0225)*1000.+0.5)
endfunction
// ----- общие мелочи Фландре (звук, эффекты, надпись, тряска — общие с Ремилией: Rem_Sound, Rem_Fx,
// Rem_Text, Rem_Noise) -----
// Анимация героя/клона через 0.01 c после каста (как у bof): номер анимации и скорость (ts<0 — не менять)
function Fla_AnimAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
if LoadReal(HH,id,2)>=0. then
call SetUnitTimeScale(u,LoadReal(HH,id,2))
endif
call SetUnitAnimationByIndex(u,LoadInteger(HH,id,1))
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
set t=null
set u=null
endfunction
function Fla_Anim takes unit u,integer idx,real ts returns nothing
local timer t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,u)
call SaveInteger(HH,GetHandleId(t),1,idx)
call SaveReal(HH,GetHandleId(t),2,ts)
call TimerStart(t,.01,false,function Fla_AnimAct)
set t=null
endfunction
// Приказ атаки клонам (A + клик): по врагу игроки кликают юнитом (приказ по цели) — тогда точка =
// где стоит цель
function Fla_OrderX takes nothing returns real
if GetOrderTargetUnit()!=null then
return GetUnitX(GetOrderTargetUnit())
endif
return GetOrderPointX()
endfunction
function Fla_OrderY takes nothing returns real
if GetOrderTargetUnit()!=null then
return GetUnitY(GetOrderTargetUnit())
endif
return GetOrderPointY()
endfunction
// Клоны Фландре — 8 ячеек в HH под героем (SH_FlaClones+k, k 0..7). Живой клон в ячейке k — иначе null
// (умершие и удалённые клоны пропускаем; группы с удалёнными юнитами не держим)
function Fla_CloneAt takes unit u,integer k returns unit
set bj_ghoul[0]=LoadUnitHandle(HH,GetHandleId(u),SH_FlaClones+k)
if bj_ghoul[0]!=null and (GetUnitTypeId(bj_ghoul[0])==0 or IsUnitType(bj_ghoul[0],UNIT_TYPE_DEAD)) then
set bj_ghoul[0]=null
endif
return bj_ghoul[0]
endfunction
// Память положений для D («часы, отсчитывающие прошлое»): один таймер на карту раз в 0.1 c, у каждого
// героя кольцо на 60 записей в HH (SH_FlaPastX/SH_FlaPastY + номер записи); номер текущей записи —
// в HH под ключом SH_FlaPast. Самая старая запись — где герой стоял 6 c назад.
function Fla_PastTick takes nothing returns nothing
local integer cur=ModuloInteger(LoadInteger(HH,SH_FlaPast,0)+1,60)
local integer i=0
local integer id
local integer k
call SaveInteger(HH,SH_FlaPast,0,cur)
loop
exitwhen i>11
if Hero[i]!=null then
set id=GetHandleId(Hero[i])
if not LoadBoolean(HH,id,SH_FlaPastOn) then
// новый герой: всё кольцо — текущее место
call SaveBoolean(HH,id,SH_FlaPastOn,true)
set k=0
loop
exitwhen k>59
call SaveReal(HH,id,SH_FlaPastX+k,GetUnitX(Hero[i]))
call SaveReal(HH,id,SH_FlaPastY+k,GetUnitY(Hero[i]))
set k=k+1
endloop
endif
call SaveReal(HH,id,SH_FlaPastX+cur,GetUnitX(Hero[i]))
call SaveReal(HH,id,SH_FlaPastY+cur,GetUnitY(Hero[i]))
endif
set i=i+1
endloop
endfunction
// Состояние Фландре (один раз на героя, при первом приказе или касте): группа клонов, приказ атаки
// клонов готов, 3 заряда клонов; часы для D
function Fla_State takes unit u returns nothing
local integer id=GetHandleId(u)
if LoadBoolean(HH,id,SH_FlaState) then
return
endif
call SaveBoolean(HH,id,SH_FlaState,true)
call SaveBoolean(HH,id,SH_FlaAtkReady,true)
call SaveInteger(HH,id,SH_FlaCharges,3)
if not LoadBoolean(HH,SH_FlaPast,1) then
call SaveBoolean(HH,SH_FlaPast,1,true)
call TimerStart(CreateTimer(),.1,true,function Fla_PastTick)
endif
endfunction
// Пассив атаки (Фландре и клоны): урон от ИНТ Фландре x20, эффекты
function Fla_Attack_Act takes unit c,unit u returns nothing
local unit fla=c
local real x=GetUnitX(c)
local real y=GetUnitY(c)
if GetUnitTypeId(c)!='HFla' then
set fla=LoadUnitHandle(HH,GetHandleId(c),SH_FlaOwner)
endif
if fla!=null then
call Bof_Dmg(fla,u,(I2R(Fla_Int_atk(fla,true))*20.)*0.001)
endif
call Rem_Fx(c,"bof\\Scarlet-82.mdx",x,y,300.,Atan2BJ(y-GetUnitY(u),x-GetUnitX(u)),2.,0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,180.)
call SetSpecialEffectTimeScale(bj_lastCreatedEffect,.5)
call DestroyEffect(AddSpecialEffectTarget("bof\\huoyanHit.mdx",u,"chest"))
call Rem_Sound("bof\\NL-PINGA-YX.mp3",90)
if GetUnitTypeId(c)=='HFla' then
call DestroyEffect(AddSpecialEffectTarget("bof\\huoyandimianxuanran3.mdx",u,"chest"))
endif
set fla=null
endfunction
// Замок F: пока идёт F, остальные кнопки недоступны. b=true — прячем, false — возвращаем. Первые стадии
// W/G возвращаем, только если сейчас не висит вторая (её вернёт Bof_SwapStage_End по таймеру).
function Fla_FLock takes unit u,boolean b returns nothing
local player p=GetOwningPlayer(u)
call SetPlayerAbilityAvailable(p,'FlQ1',not b)
call SetPlayerAbilityAvailable(p,'FlE1',not b)
call SetPlayerAbilityAvailable(p,'FlR1',not b)
call SetPlayerAbilityAvailable(p,'FlT1',not b)
call SetPlayerAbilityAvailable(p,'FlD1',not b)
call SetPlayerAbilityAvailable(p,'FlW2',not b)
call SetPlayerAbilityAvailable(p,'FlG2',not b)
if b or GetUnitAbilityLevel(u,'FlW2')==0 then
call SetPlayerAbilityAvailable(p,'FlW1',not b)
endif
if b or GetUnitAbilityLevel(u,'FlG2')==0 then
call SetPlayerAbilityAvailable(p,'FlG1',not b)
endif
set p=null
endfunction
// ----- Q: 5 копий вокруг цели (450), через 0.5 c летят в неё; цель не ушла дальше 250 — урон Q x120 и
// стан 1.5 c. Фландре в паузе 0.3 c -----
function Fla_Q_Act2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,0)
local unit target=LoadUnitHandle(HH,id,1)
local real tx=LoadReal(HH,id,2)
local real ty=LoadReal(HH,id,3)
local integer tk=LoadInteger(HH,id,4)+1
local integer i
local real x
local real y
local unit dmy
call SaveInteger(HH,id,4,tk)
// реверс (цель в стойке развернула умение): как у героев Чейза — умение кончается, кастер отпущен
if Bof_RevEnd(caster) then
set i=1
loop
exitwhen i>5
call RemoveUnit(LoadUnitHandle(HH,id,9+i))
set i=i+1
endloop
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
set t=null
set caster=null
set target=null
return
endif
if tk<=15 then
call SetUnitInvulnerable(caster,true)
call PauseUnit(caster,true)
endif
if tk==1 then
set i=1
loop
exitwhen i>5
set x=GetUnitX(target)+CosBJ(I2R(i)*72.)*450.
set y=GetUnitY(target)+SinBJ(I2R(i)*72.)*450.
call Rem_Fx(caster,"bof\\Scarlet-54.mdx",x,y,50.,0.,1.5,0.)
call Rem_Fx(caster,"bof\\Scarlet-27.mdx",x,y,50.,0.,1.5,0.)
call Rem_Fx(caster,"bof\\Scarlet-37.mdx",x,y,50.,0.,1.5,0.)
call Rem_Fx(caster,"bof\\Scarlet-75.mdx",x,y,50.,0.,1.,0.)
set dmy=CreateUnit(GetOwningPlayer(caster),'eBLP',x,y,0.)
call SetUnitModel(dmy,"bof\\Scarlet-11.mdx")
call UnitApplyTimedLife(dmy,'BHwe',3.)
call SaveUnitHandle(HH,id,9+i,dmy)
set i=i+1
endloop
endif
if tk==15 then
call SetUnitInvulnerable(caster,false)
call PauseUnit(caster,false)
call SetUnitTimeScale(caster,1.)
endif
if tk==25 then
set i=1
loop
exitwhen i>5
set dmy=LoadUnitHandle(HH,id,9+i)
call Bof_Slide(dmy,Atan2BJ(GetUnitY(target)-GetUnitY(dmy),GetUnitX(target)-GetUnitX(dmy)),900.,.6)
set i=i+1
endloop
endif
if tk==40 then
if SRS(GetUnitX(target),GetUnitY(target),tx,ty)<250. then
call Bof_Dmg(caster,target,(I2R(Fla_Int_Q(caster,true))*120.)*0.001)
call Bof_Ctrl(caster,target,1.5,"stun")
endif
call Rem_Fx(caster,"bof\\Scarlet-85.mdx",tx,ty,50.,0.,2.25,.75)
call Rem_Fx(caster,"bof\\Tsubaki-33.mdx",tx,ty,50.,0.,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-69.mdx",tx,ty,50.,0.,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-10.mdx",tx,ty,GetUnitFlyHeight(caster),0.,1.5,0.)
call Rem_Noise(GetOwningPlayer(caster),50.,.5)
call Rem_Noise(GetOwningPlayer(target),50.,.5)
call Rem_Sound("bof\\war3mapImported\\Flandre Scarlet-Q-YX1.mp3",100)
endif
if tk==55 then
set i=1
loop
exitwhen i>5
set dmy=LoadUnitHandle(HH,id,9+i)
call Rem_Fx(null,"bof\\Scarlet-51.mdx",GetUnitX(dmy),GetUnitY(dmy),25.,0.,1.,0.)
call RemoveUnit(dmy)
set i=i+1
endloop
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set caster=null
set target=null
set dmy=null
endfunction
function Fla_Q_Act takes unit caster,unit target returns nothing
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real z=GetUnitFlyHeight(caster)
local timer t=CreateTimer()
call SaveBoolean(HH,GetHandleId(caster),SH_bofRevd,false)
call Bof_Slow(caster,target,0.5,0,2,2,false)
call Rem_Fx(caster,"bof\\Scarlet-4.mdx",x,y,z,0.,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-8.mdx",x,y,z,0.,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-10.mdx",x,y,z,0.,1.,0.)
call Fla_Anim(caster,9,1.)
call Rem_Sound("bof\\war3mapImported\\Flandre Scarlet-Q-YY1.mp3",100)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-G-YX1.mp3",100)
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call SaveUnitHandle(HH,GetHandleId(t),1,target)
call SaveReal(HH,GetHandleId(t),2,GetUnitX(target))
call SaveReal(HH,GetHandleId(t),3,GetUnitY(target))
call TimerStart(t,.02,true,function Fla_Q_Act2)
set t=null
endfunction
// ----- W: копьё летит за целью (до 1.5 c); попало ближе 200 — урон W x120, потом «рассвет» 3 c
// следует за целью и в конце — стан 1.5 c и ещё урон W x120. Вторая стадия — W2 (Laevatein) на 8 c -----
// Взрыв на цели: эффекты, звук, урон W x120
function Fla_W_Blast takes unit caster,unit target returns nothing
local real x=GetUnitX(target)
local real y=GetUnitY(target)
call Rem_Fx(caster,"bof\\Scarlet-47.mdx",x,y,25.,0.,2.5,0.)
call Rem_Fx(caster,"bof\\Scarlet-29.mdx",x,y,25.,0.,1.,0.)
call Rem_Fx(caster,"bof\\Madara-huitu-17.mdx",x,y,25.,0.,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-40.mdx",x,y,25.,0.,1.5,0.)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-R-YX2.mp3",100)
call Bof_Dmg(caster,target,(I2R(Fla_Int_W(caster,true))*120.)*0.001)
endfunction
// «Рассвет» (dawn_3 → dawn_2 → dawn_1) держится на цели 100 тиков по 0.03 c
function Fla_W_Dawn takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,0)
local unit target=LoadUnitHandle(HH,id,1)
local unit dmy=LoadUnitHandle(HH,id,2)
local integer tk=LoadInteger(HH,id,4)+1
call SaveInteger(HH,id,4,tk)
if tk<=100 then
if tk==33 or tk==66 then
set dmy=CreateUnit(GetOwningPlayer(caster),'eBLP',GetUnitX(target),GetUnitY(target),LoadReal(HH,id,3))
if tk==33 then
call SetUnitModel(dmy,"bof\\dawn_2.mdx")
else
call SetUnitModel(dmy,"bof\\dawn_1.mdx")
endif
call SetUnitScale(dmy,3.,3.,3.)
call UnitApplyTimedLife(dmy,'BHwe',1.)
call SetUnitAnimationByIndex(dmy,2)
call SaveUnitHandle(HH,id,2,dmy)
endif
call SetUnitXY_1(dmy,GetUnitX(target),GetUnitY(target), false)
else
call Bof_Ctrl(caster,target,1.5,"stun")
call Fla_W_Blast(caster,target)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set caster=null
set target=null
set dmy=null
endfunction
// Полёт копья, тик 0.03 c: до 50 тиков, пока не ближе 100 к цели
function Fla_W_Spear takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,0)
local unit target=LoadUnitHandle(HH,id,1)
local unit dmy=LoadUnitHandle(HH,id,2)
local integer tk=LoadInteger(HH,id,3)+1
local real x=GetUnitX(dmy)
local real y=GetUnitY(dmy)
local real ang=Atan2BJ(GetUnitY(target)-y,GetUnitX(target)-x)
local real dist=SRS(x,y,GetUnitX(target),GetUnitY(target))
local timer t2
call SaveInteger(HH,id,3,tk)
call SetUnitFacingTimed(dmy,ang,0)
if tk<=50 and dist>100. and IsUnitAliveBJ(dmy) then
set x=x+100.*CosBJ(ang)
set y=y+100.*SinBJ(ang)
call SetUnitXY_1(dmy,x,y, false)
if ModuloInteger(tk,4)==0 then
call Rem_Fx(caster,"bof\\Scarlet-69.mdx",x,y,150.,ang,.75,0.)
call Rem_Fx(caster,"bof\\Scarlet-84.mdx",x,y,150.,ang,1.,0.)
endif
else
call CameraClearNoiseForPlayer(GetOwningPlayer(caster))
call SetUnitAnimation(dmy,"Death")
call Bof_zO(.2,dmy)
if dist<200. then
call Fla_W_Blast(caster,target)
call Rem_Noise(GetOwningPlayer(caster),80.,.8)
set dmy=CreateUnit(GetOwningPlayer(caster),'eBLP',GetUnitX(target),GetUnitY(target),ang)
call SetUnitModel(dmy,"bof\\dawn_3.mdx")
call SetUnitScale(dmy,3.,3.,3.)
call UnitApplyTimedLife(dmy,'BHwe',1.)
call SetUnitAnimationByIndex(dmy,2)
set t2=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t2),0,caster)
call SaveUnitHandle(HH,GetHandleId(t2),1,target)
call SaveUnitHandle(HH,GetHandleId(t2),2,dmy)
call SaveReal(HH,GetHandleId(t2),3,ang)
call TimerStart(t2,.03,true,function Fla_W_Dawn)
endif
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set t2=null
set caster=null
set target=null
set dmy=null
endfunction
// Замах: Фландре в паузе 0.46 c, на 0.36 c — бросок копья
function Fla_W_Act2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,0)
local real ang=LoadReal(HH,id,2)
local integer tk=LoadInteger(HH,id,3)+1
local real x
local real y
local unit dmy
local timer t2
call SaveInteger(HH,id,3,tk)
// реверс (цель в стойке развернула умение): как у героев Чейза — умение кончается, кастер отпущен
if Bof_RevEnd(caster) then
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
set t=null
set caster=null
return
endif
call SetUnitInvulnerable(caster,true)
call PauseUnit(caster,true)
if tk==18 then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
call Rem_Fx(caster,"bof\\Tsubaki-33.mdx",x,y,250.,ang,1.,0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,90.)
call CameraSetEQNoiseForPlayer(GetOwningPlayer(caster),50.)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-R-YX3.mp3",100)
set dmy=CreateUnit(GetOwningPlayer(caster),'eBLP',x+50.*CosBJ(ang),y+50.*SinBJ(ang),ang)
call UnitApplyTimedLife(dmy,'BHwe',5.1)
call SetUnitScale(dmy,1.5,1.,1.)
call SetUnitFlyHeight(dmy,150.,1000000000.)
call SetUnitModel(dmy,"bof\\Scarlet-71.mdx")
set t2=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t2),0,caster)
call SaveUnitHandle(HH,GetHandleId(t2),1,LoadUnitHandle(HH,id,1))
call SaveUnitHandle(HH,GetHandleId(t2),2,dmy)
call TimerStart(t2,.03,true,function Fla_W_Spear)
endif
if tk==23 then
call SetUnitInvulnerable(caster,false)
call PauseUnit(caster,false)
call SetUnitTimeScale(caster,1.)
call SetUnitPathing(caster,true)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set t2=null
set caster=null
set dmy=null
endfunction
function Fla_W_Act takes unit caster,unit target returns nothing
local timer t=CreateTimer()
call SaveBoolean(HH,GetHandleId(caster),SH_bofRevd,false)
call Bof_SwapStage(caster,'FlW1','FlW2',8.)
call Rem_Sound("bof\\war3mapImported\\Flandre Scarlet-W-YY1.mp3",100)
call Rem_Fx(caster,"bof\\Scarlet-21.mdx",GetUnitX(caster),GetUnitY(caster),GetUnitFlyHeight(caster),0.,2.,0.)
call Fla_Anim(caster,10,-1.)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call SetUnitPathing(caster,false)
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call SaveUnitHandle(HH,GetHandleId(t),1,target)
call SaveReal(HH,GetHandleId(t),2,Atan2BJ(GetUnitY(target)-GetUnitY(caster),GetUnitX(target)-GetUnitX(caster)))
call TimerStart(t,.02,true,function Fla_W_Act2)
set t=null
endfunction
// ----- W2 Laevatein: 1 c замах, затем 6 ударов веером на 600 (радиус 350): урон W2 x80, стан 1.5 c -----
function Fla_W2_Act2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,0)
local real ang=LoadReal(HH,id,1)
local integer tk=LoadInteger(HH,id,2)+1
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real a
local real px
local real py
local integer i
local group g
local unit e
call SaveInteger(HH,id,2,tk)
// реверс (цель в стойке развернула умение): умение кончается, героиня отпущена
if Bof_RevEnd(caster) then
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
set t=null
set caster=null
return
endif
call SetUnitInvulnerable(caster,true)
call PauseUnit(caster,true)
if tk<=50 then
call CameraSetEQNoiseForPlayer(GetOwningPlayer(caster),25.)
if ModuloInteger(tk,10)==0 then
call Rem_Fx(caster,"bof\\Madara-huitu-22.mdx",x,y,25.,ang,8.,0.)
endif
if ModuloInteger(tk,20)==0 then
set px=x+CosBJ(GetRandomDirectionDeg())*GetRandomReal(-1000.,1000.)
set py=y+SinBJ(GetRandomDirectionDeg())*GetRandomReal(-1000.,1000.)
call Rem_Fx(caster,"bof\\Scarlet-77.mdx",px,py,25.,ang,1.,0.)
endif
endif
if tk==50 then
call Rem_Sound("bof\\war3mapImported\\Madara-huitu-TR-YX2.mp3",90)
call Rem_Sound("bof\\NL-Q-YX.mp3",110)
call Rem_Fx(caster,"bof\\Scarlet-82.mdx",x,y,600.,ang+180.,4.,0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,180.)
call SetSpecialEffectTimeScale(bj_lastCreatedEffect,.5)
call Rem_Fx(caster,"bof\\Scarlet-82.mdx",x,y,900.,ang+180.,6.,0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,180.)
call SetSpecialEffectTimeScale(bj_lastCreatedEffect,.5)
call Rem_Fx(caster,"bof\\Scarlet-82.mdx",x,y,1200.,ang+180.,8.,0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,180.)
call SetSpecialEffectTimeScale(bj_lastCreatedEffect,.5)
call SetUnitTimeScale(caster,1.)
call CameraClearNoiseForPlayer(GetOwningPlayer(caster))
call Rem_Noise(GetOwningPlayer(caster),80.,1.)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
set i=1
loop
exitwhen i>6
set a=ang+90.-30.*I2R(i)
set px=x+CosBJ(a)*600.
set py=y+SinBJ(a)*600.
call Rem_Fx(caster,"bof\\Scarlet-81.mdx",px,py,GetUnitFlyHeight(caster)+25.,a+180.,1.5,0.)
call Rem_Fx(caster,"bof\\Minato-31.mdx",px,py,25.,ang,4.,0.)
set g=CreateGroup()
call GroupEnumUnitsInRange(g,px,py,350.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(caster),e) and GetUnitAbilityLevel(e,'Avul')==0 then
call Bof_Dmg(caster,e,(I2R(Fla_Int_W2(caster,true))*80.)*0.001)
call Bof_Ctrl(caster,e,1.5,"stun")
endif
endloop
call DestroyGroup(g)
set i=i+1
endloop
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set caster=null
set g=null
set e=null
endfunction
function Fla_W2_Act takes unit caster,real tx,real ty returns nothing
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real ang=Atan2BJ(ty-y,tx-x)
local timer t=CreateTimer()
call Rem_Fx(caster,"bof\\Tsubaki-33.mdx",x,y,20.,ang,1.25,0.)
call Fla_Anim(caster,8,.25)
call Rem_Sound("bof\\war3mapImported\\Flandre Scarlet-ZS1-YY1.mp3",100)
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call SaveReal(HH,GetHandleId(t),1,ang)
call TimerStart(t,.02,true,function Fla_W2_Act2)
call Bof_SwapBack(caster,'FlW1','FlW2')
set t=null
endfunction
// ----- E: удар в точку (до 1000): 4 волны по 300 — урон E x30, стан 1 c. Фландре в паузе 1 c -----
function Fla_E_Act2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,0)
local real tx=LoadReal(HH,id,1)
local real ty=LoadReal(HH,id,2)
local real ang=LoadReal(HH,id,3)
local integer tk=LoadInteger(HH,id,4)+1
local integer k
local group g
local unit e
call SaveInteger(HH,id,4,tk)
// реверс (цель в стойке развернула умение): как у героев Чейза — умение кончается, кастер отпущен
if Bof_RevEnd(caster) then
call CameraClearNoiseForPlayer(GetOwningPlayer(caster))
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
set t=null
set caster=null
return
endif
call SetUnitInvulnerable(caster,true)
call PauseUnit(caster,true)
if tk==1 then
call SetUnitTimeScale(caster,1.)
call SetUnitAnimationByIndex(caster,3)
endif
if tk==13 then
call CameraSetEQNoiseForPlayer(GetOwningPlayer(caster),35.)
call Rem_Fx(caster,"bof\\Scarlet-10.mdx",tx,ty,25.,ang,1.5,0.)
call Rem_Fx(caster,"bof\\Scarlet-47.mdx",tx,ty,25.,ang,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-4.mdx",tx,ty,25.,ang,1.5,0.)
call Rem_Fx(caster,"bof\\Scarlet-93.mdx",tx,ty,25.,ang,1.5,0.)
call Rem_Fx(caster,"bof\\Scarlet-14.mdx",tx,ty,25.,ang,1.5,.75)
call Rem_Fx(caster,"bof\\Madara-huitu-22.mdx",tx,ty,25.,ang,6.,0.)
call Rem_Sound("bof\\war3mapImported\\Flandre Scarlet-E-YX1.mp3",110)
call Rem_Fx(caster,"bof\\Scarlet-92.mdx",tx,ty,25.,ang,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-95.mdx",tx,ty,25.,ang,2.,0.)
endif
if tk>=14 and tk<=50 then
set k=LoadInteger(HH,id,5)+1
call SaveInteger(HH,id,5,k)
if ModuloInteger(k,8)==0 then
set g=CreateGroup()
call GroupEnumUnitsInRange(g,tx,ty,300.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(caster),e) and GetUnitAbilityLevel(e,'Avul')==0 then
call Rem_Fx(caster,"bof\\Scarlet-26.mdx",GetUnitX(e),GetUnitY(e),GetUnitFlyHeight(e)+150.,0.,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-52.mdx",GetUnitX(e),GetUnitY(e),GetUnitFlyHeight(e)+150.,0.,1.,0.)
call Bof_Dmg(caster,e,(I2R(Fla_Int_E(caster,true))*30.)*0.001)
call Bof_Ctrl(caster,e,1.,"stun")
endif
endloop
call DestroyGroup(g)
endif
endif
if tk==50 then
call CameraClearNoiseForPlayer(GetOwningPlayer(caster))
call SetUnitInvulnerable(caster,false)
call PauseUnit(caster,false)
call SetUnitTimeScale(caster,1.)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set caster=null
set g=null
set e=null
endfunction
function Fla_E_Act takes unit caster,real tx,real ty returns nothing
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real ang=Atan2BJ(ty-y,tx-x)
local real dist=RMinBJ(SRS(x,y,tx,ty),1000.)
local timer t=CreateTimer()
call SaveBoolean(HH,GetHandleId(caster),SH_bofRevd,false)
call Rem_Fx(caster,"bof\\Scarlet-8.mdx",x,y,-1.,0.,1.,0.)
call Rem_Fx(caster,"bof\\Tsubaki-33.mdx",x,y,25.,0.,1.,0.)
call Rem_Fx(caster,"bof\\Madara-huitu-22.mdx",x,y,25.,ang,4.,0.)
call SetUnitInvulnerable(caster,true)
call PauseUnit(caster,true)
if GetRandomInt(1,2)==1 then
call Rem_Sound("bof\\war3mapImported\\Flandre Scarlet-E-YY1.mp3",100)
else
call Rem_Sound("bof\\war3mapImported\\Flandre Scarlet-E-YY2.mp3",100)
endif
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call SaveReal(HH,GetHandleId(t),1,x+CosBJ(ang)*dist)
call SaveReal(HH,GetHandleId(t),2,y+SinBJ(ang)*dist)
call SaveReal(HH,GetHandleId(t),3,ang)
call TimerStart(t,.02,true,function Fla_E_Act2)
set t=null
endfunction
// ----- R «Kagome, Kagome»: три нажатия, каждое — урон R x80 и замедление в 800. На третьем у каждого
// врага в 1600 по 3 копья (за 1000 от Фландре, за спиной врага), летят в него залпами: урон R x80
// в 450 и стан 1.5 c. Через 6 c после последнего нажатия — кулдаун 40 c -----
function Fla_R_Idle takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit caster=LoadUnitHandle(HH,GetHandleId(t),0)
local integer cid=GetHandleId(caster)
call SaveReal(HH,cid,SH_FlaRTime,LoadReal(HH,cid,SH_FlaRTime)+.05)
if LoadReal(HH,cid,SH_FlaRTime)>=6. or not LoadBoolean(HH,cid,SH_FlaROn) then
call SaveBoolean(HH,cid,SH_FlaROn,false)
call SaveInteger(HH,cid,SH_FlaRStage,0)
if not LoadBoolean(HH,cid,SH_FlaRDone) then
call DisplayTextToPlayer(GetOwningPlayer(caster),0,0,Lng("Песня Kagome, Kagome прервана!","The song Kagome, Kagome was interrupted!"))
endif
if GetUnitAbilityLevel(caster,'FlR1')>0 then
call SetAbilityRemainingCooldown(GetUnitAbility(caster,'FlR1'),30.)
endif
call FlushChildHashtable(HH,GetHandleId(t))
call DestroyTimer(t)
endif
set t=null
set caster=null
endfunction
// Полёт копья в своего врага, тик 0.02 c: разгон 40→105, виляет ±3°; взрыв в 450, когда долетело до врага
function Fla_R_Spear takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,0)
local unit dmy=LoadUnitHandle(HH,id,1)
local real speed=LoadReal(HH,id,2)
local real ang=LoadReal(HH,id,3)
local real yaw=LoadReal(HH,id,5)
local unit tg=LoadUnitHandle(HH,id,6)
local boolean hit=false
local integer tk=LoadInteger(HH,id,4)+1
local real x=GetUnitX(dmy)
local real y=GetUnitY(dmy)
local group g
local unit e
call SaveInteger(HH,id,4,tk)
if speed<=100. then
set speed=speed+5.
call SaveReal(HH,id,2,speed)
endif
// копьё летит к своему врагу и взрывается, долетев до него (раньше — по таймеру 12–15 тиков, могло пролететь мимо);
// враг умер или пропал — прежнее поведение. Предел — 60 тиков (1.2 c)
if tg!=null and GetUnitTypeId(tg)!=0 and UnitIsAlive(tg) then
set ang=Atan2BJ(GetUnitY(tg)-y,GetUnitX(tg)-x)
if SRS(x,y,GetUnitX(tg),GetUnitY(tg))<=speed then
set hit=true
set x=GetUnitX(tg)
set y=GetUnitY(tg)
call SetUnitXY_1(dmy,x,y, false)
endif
else
set tg=null
endif
if not hit and tk<=60 and (tg!=null or tk<=12 or I2R(tk)*.01<=GetRandomReal(.12,.15)) and IsUnitAliveBJ(dmy) then
set ang=ang+GetRandomReal(-3.,3.)
call SaveReal(HH,id,3,ang)
call SetUnitFacingTimed(dmy,ang,0)
call SetUnitXY_1(dmy,x+speed*CosBJ(ang),y+speed*SinBJ(ang), false)
else
call Rem_Sound("bof\\war3mapImported\\Flandre Scarlet-Q-YX1.mp3",100)
call SetUnitAnimation(dmy,"Death")
call UnitApplyTimedLife(dmy,'BHwe',.4)
call Rem_Fx(caster,"bof\\Scarlet-85.mdx",x,y,50.,yaw,2.25,.75)
call Rem_Fx(caster,"bof\\Tsubaki-33.mdx",x,y,50.,yaw,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-69.mdx",x,y,50.,yaw,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-10.mdx",x,y,GetUnitFlyHeight(caster),yaw,1.5,0.)
set g=CreateGroup()
call GroupEnumUnitsInRange(g,x,y,450.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(caster),e) and GetUnitAbilityLevel(e,'Avul')==0 then
call Bof_Dmg(caster,e,(I2R(Fla_Int_R(caster,true))*80.)*0.001)
call Bof_Ctrl(caster,e,1.5,"stun")
endif
endloop
call DestroyGroup(g)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set caster=null
set dmy=null
set tg=null
set g=null
set e=null
endfunction
// Залпы копий: тики 48, 54, 60 (0.96–1.2 c) — каждому врагу по случайному копью из его трёх.
// Данные: 1 — число врагов, 3 — поворот взрывов, враг i — под 10+2i, его группа копий — под 11+2i
function Fla_R_Act2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,0)
local integer cnt=LoadInteger(HH,id,1)
local integer tk=LoadInteger(HH,id,2)+1
local integer i=0
local unit e
local unit dmy
local group g
local timer t2
call SaveInteger(HH,id,2,tk)
if tk==48 or tk==54 or tk==60 then
loop
exitwhen i>=cnt
set e=LoadUnitHandle(HH,id,10+2*i)
set g=LoadGroupHandle(HH,id,11+2*i)
set dmy=GroupPickRandomUnit(g)
if dmy!=null then
call GroupRemoveUnit(g,dmy)
set t2=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t2),0,caster)
call SaveUnitHandle(HH,GetHandleId(t2),1,dmy)
call SaveReal(HH,GetHandleId(t2),2,40.)
call SaveReal(HH,GetHandleId(t2),3,Atan2BJ(GetUnitY(e)-GetUnitY(dmy),GetUnitX(e)-GetUnitX(dmy)))
call SaveReal(HH,GetHandleId(t2),5,LoadReal(HH,id,3))
call SaveUnitHandle(HH,GetHandleId(t2),6,e)
call TimerStart(t2,.02,true,function Fla_R_Spear)
endif
set i=i+1
endloop
endif
if tk==61 then
loop
exitwhen i>=cnt
call DestroyGroup(LoadGroupHandle(HH,id,11+2*i))
set i=i+1
endloop
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set t2=null
set caster=null
set e=null
set dmy=null
set g=null
endfunction
function Fla_R_Act takes unit caster returns nothing
local integer cid=GetHandleId(caster)
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real z=GetUnitFlyHeight(caster)
local integer stage=LoadInteger(HH,cid,SH_FlaRStage)+1
local integer cnt=0
local integer str
local real ea=0.
local real px
local real py
local group g
local group sg
local unit e
local unit dmy
local timer t
call SaveInteger(HH,cid,SH_FlaRStage,stage)
// каждое нажатие: удар 800 с замедлением
set g=CreateGroup()
call GroupEnumUnitsInRange(g,x,y,800.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(caster),e) and GetUnitAbilityLevel(e,'Avul')==0 then
call Bof_Dmg(caster,e,(I2R(Fla_Int_R(caster,true))*80.)*0.001)
call Bof_Slow(caster,e,0.5,0,2,2,false)
endif
endloop
call DestroyGroup(g)
call SaveReal(HH,cid,SH_FlaRTime,0.)
call Rem_Fx(caster,"bof\\Scarlet-29.mdx",x,y,z,0.,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-14.mdx",x,y,20.,0.,1.,1.)
call Rem_Fx(caster,"bof\\Scarlet-21.mdx",x,y,z,0.,2.,0.)
call Rem_Fx(caster,"bof\\Scarlet-65.mdx",x,y,z,0.,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-4.mdx",x,y,z,0.,1.,0.)
if stage==1 then
call Rem_Sound("bof\\war3mapImported\\Flandre Scarlet-R-YY1.mp3",100)
call Rem_Text(caster,"Kagome, Kagome")
call SaveBoolean(HH,cid,SH_FlaRDone,false)
if not LoadBoolean(HH,cid,SH_FlaROn) then
call SaveBoolean(HH,cid,SH_FlaROn,true)
set t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call TimerStart(t,.05,true,function Fla_R_Idle)
endif
elseif stage==2 then
call Rem_Sound("bof\\war3mapImported\\Flandre Scarlet-R-YY2.mp3",100)
call Rem_Text(caster,Lng("Кто стоит за твоей тенью?","Who stands behind your shadow?"))
else
call Rem_Sound("bof\\war3mapImported\\Flandre Scarlet-R-YY3.mp3",100)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-G-YX1.mp3",100)
call Rem_Text(caster,"Kagome, Kagome")
call SaveInteger(HH,cid,SH_FlaRStage,0)
call SaveBoolean(HH,cid,SH_FlaRDone,true)
// полное прочтение — R сразу уходит на перезарядку 30 c (раньше — только через 6 c ожидания)
call SaveBoolean(HH,cid,SH_FlaROn,false)
call SetAbilityRemainingCooldown(GetUnitAbility(caster,'FlR1'),30.)
set t=CreateTimer()
set g=CreateGroup()
call GroupEnumUnitsInRange(g,x,y,1600.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
// клетка — только живым уязвимым врагам: иначе копья летели в неуязвимые сундуки в зоне ожидания
// и в тела мёртвых героев, даже когда врагов рядом нет (владелец 4 окт)
if Condition_Base(GetOwningPlayer(caster),e) and GetUnitAbilityLevel(e,'Avul')==0 and UnitIsAlive(e) then
set ea=GetUnitFacing(e)+180.
set sg=CreateGroup()
set str=1
loop
exitwhen str>3
set px=x+CosBJ(ea-60.+30.*I2R(str))*1000.
set py=y+SinBJ(ea-60.+30.*I2R(str))*1000.
call Rem_Fx(null,"bof\\Scarlet-54.mdx",px,py,50.,ea,1.5,0.)
call Rem_Fx(null,"bof\\Scarlet-27.mdx",px,py,50.,ea,1.5,0.)
call Rem_Fx(null,"bof\\Scarlet-37.mdx",px,py,50.,ea,1.5,0.)
call Rem_Fx(null,"bof\\Scarlet-75.mdx",px,py,50.,ea,1.,0.)
set dmy=CreateUnit(GetOwningPlayer(caster),'eBLP',px,py,ea)
call SetUnitModel(dmy,"bof\\Scarlet-11.mdx")
call UnitApplyTimedLife(dmy,'BHwe',2.)
call GroupAddUnit(sg,dmy)
set str=str+1
endloop
call SaveUnitHandle(HH,GetHandleId(t),10+2*cnt,e)
call SaveGroupHandle(HH,GetHandleId(t),11+2*cnt,sg)
set cnt=cnt+1
endif
endloop
call DestroyGroup(g)
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call SaveInteger(HH,GetHandleId(t),1,cnt)
// поворот взрывов копий — как у bof: взгляд последнего врага
call SaveReal(HH,GetHandleId(t),3,ea+180.)
call TimerStart(t,.02,true,function Fla_R_Act2)
endif
set g=null
set sg=null
set e=null
set dmy=null
set t=null
endfunction
// ----- T «Four of a Kind»: клон в точке (12 c), стоит заряд; зарядов до 3, +1 раз в 20 c -----
function Fla_T_Recharge takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit caster=LoadUnitHandle(HH,GetHandleId(t),0)
local integer cid=GetHandleId(caster)
if caster==null or GetUnitTypeId(caster)==0 then
call FlushChildHashtable(HH,GetHandleId(t))
call DestroyTimer(t)
elseif LoadInteger(HH,cid,SH_FlaCharges)<3 then
call SaveInteger(HH,cid,SH_FlaCharges,LoadInteger(HH,cid,SH_FlaCharges)+1)
endif
set t=null
set caster=null
endfunction
function Fla_T_Act takes unit caster,real tx,real ty returns nothing
local integer cid=GetHandleId(caster)
local real ang=Atan2BJ(ty-GetUnitY(caster),tx-GetUnitX(caster))
local unit cl
local integer k=0
local timer t
call Fla_State(caster)
if LoadInteger(HH,cid,SH_FlaCharges)<=0 then
return
endif
// свободная ячейка клона (живых клонов не больше 3 — 3 заряда, +1 раз в 20 c, клон живёт 12 c)
loop
exitwhen k>=7 or Fla_CloneAt(caster,k)==null
set k=k+1
endloop
call SaveInteger(HH,cid,SH_FlaCharges,LoadInteger(HH,cid,SH_FlaCharges)-1)
set cl=CreateUnit(GetOwningPlayer(caster),'hB1W',tx,ty,ang)
// своих статов у клона нет — урон с руки 50% интеллекта Фландре (владелец 4 окт: «без статов ничего не наносят»)
call SetUnitBaseDamageByIndex(cl,0,R2I(I2R(GetHeroInt(caster,true))*.5))
call SaveBoolean(HH,GetHandleId(cl),SH_FlaDash,true)
call SaveUnitHandle(HH,GetHandleId(cl),SH_FlaOwner,caster)
call SetUnitXY_1(cl,tx,ty, true)
call UnitApplyTimedLife(cl,'BHwe',12.)
call SetUnitPathing(cl,false)
call SaveUnitHandle(HH,cid,SH_FlaClones+k,cl)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-G-YX1.mp3",100)
call Rem_Fx(caster,"bof\\Scarlet-69.mdx",tx,ty,150.,ang,.75,0.)
call Rem_Fx(caster,"bof\\Scarlet-84.mdx",tx,ty,150.,ang,1.,0.)
if not LoadBoolean(HH,cid,SH_FlaRecharge) then
call SaveBoolean(HH,cid,SH_FlaRecharge,true)
set t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call TimerStart(t,20.,true,function Fla_T_Recharge)
endif
set cl=null
set t=null
endfunction
// ----- D «часы»: Фландре бросает циферблат (до 0.8 c) в точку; там 5 c круг 600 раз в 0.1 c: каждого
// один раз возвращает туда, где он стоял 6 c назад (только герои — у остальных записи нет, их не
// двигаем). Союзников лечит на D x160, врагам урон D x160 (цель в стойке — реверс, её не двигаем) -----
// Возврат юнита на 6 c назад, эффекты до и после
function Fla_D_Back takes unit caster,unit e returns nothing
local integer id=GetHandleId(e)
local integer k=ModuloInteger(LoadInteger(HH,SH_FlaPast,0)+1,60)
call Rem_Fx(caster,"bof\\Kurumi-1.mdx",GetUnitX(e),GetUnitY(e),25.,0.,1.,0.)
// 6 c назад герой мог быть на базе, в таверне или на другой арене — туда не возвращаем
if LoadBoolean(HH,id,SH_FlaPastOn) and Bof_Zone(LoadReal(HH,id,SH_FlaPastX+k),LoadReal(HH,id,SH_FlaPastY+k))==Bof_Zone(GetUnitX(e),GetUnitY(e)) then
call SetUnitXY_1(e,LoadReal(HH,id,SH_FlaPastX+k),LoadReal(HH,id,SH_FlaPastY+k), true)
endif
call Rem_Fx(caster,"bof\\Kurumi-1.mdx",GetUnitX(e),GetUnitY(e),25.,0.,1.,0.)
endfunction
function Fla_D_Clock takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,0)
local real tx=LoadReal(HH,id,1)
local real ty=LoadReal(HH,id,2)
local group done=LoadGroupHandle(HH,id,3)
local integer tk=LoadInteger(HH,id,4)+1
local group g
local unit e
call SaveInteger(HH,id,4,tk)
if tk<=50 then
set g=CreateGroup()
call GroupEnumUnitsInRange(g,tx,ty,600.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if GetUnitAbilityLevel(e,'Avul')==0 and not IsUnitInGroup(e,done) then
if IsUnitAlly(e,GetOwningPlayer(caster)) then
call GroupAddUnit(done,e)
call Bof_Heal(caster,e,(I2R(Fla_Int_D(caster,true))*160.)*0.001)
call Fla_D_Back(caster,e)
elseif Condition_Base(GetOwningPlayer(caster),e) then
call GroupAddUnit(done,e)
if not Bof_Rev(caster,e) then
call Fla_D_Back(caster,e)
call Bof_Dmg(caster,e,(I2R(Fla_Int_D(caster,true))*160.)*0.001)
endif
endif
endif
endloop
call DestroyGroup(g)
else
call DestroyGroup(done)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set caster=null
set done=null
set g=null
set e=null
endfunction
// Полёт циферблата, тик 0.02 c: 40 шагов по 40; долетел (ближе 100) или 0.8 c — круг в точке каста
function Fla_D_Fly takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,0)
local unit dmy=LoadUnitHandle(HH,id,1)
local real tx=LoadReal(HH,id,2)
local real ty=LoadReal(HH,id,3)
local real ang=LoadReal(HH,id,4)
local integer tk=LoadInteger(HH,id,5)+1
local timer t2
call SaveInteger(HH,id,5,tk)
if ModuloInteger(tk,6)==0 then
call Rem_Fx(caster,"bof\\Tsubaki-37.mdx",GetUnitX(dmy),GetUnitY(dmy),-1.,ang,4.,0.)
endif
if tk<=40 then
call SetUnitXY_1(dmy,GetUnitX(dmy)+40.*CosBJ(ang),GetUnitY(dmy)+40.*SinBJ(ang), false)
endif
if tk>=40 or SRS(GetUnitX(dmy),GetUnitY(dmy),tx,ty)<=100. then
call Rem_Fx(caster,"bof\\Scarlet-88.mdx",tx,ty,-1.,ang,2.5,5.)
call KillUnit(dmy)
call Rem_Sound("bof\\war3mapImported\\Flandre Scarlet-D-YX1.mp3",125)
set t2=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t2),0,caster)
call SaveReal(HH,GetHandleId(t2),1,tx)
call SaveReal(HH,GetHandleId(t2),2,ty)
call SaveGroupHandle(HH,GetHandleId(t2),3,CreateGroup())
call TimerStart(t2,.1,true,function Fla_D_Clock)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set t2=null
set caster=null
set dmy=null
endfunction
// Замах: пауза 0.26 c, на 0.22 c — бросок
function Fla_D_Act2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,0)
local real ang=LoadReal(HH,id,3)
local integer tk=LoadInteger(HH,id,4)+1
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local unit dmy
local timer t2
call SaveInteger(HH,id,4,tk)
// реверс (цель в стойке развернула умение): умение кончается, героиня отпущена
if Bof_RevEnd(caster) then
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
set t=null
set caster=null
return
endif
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
if tk==11 then
call Rem_Noise(GetOwningPlayer(caster),40.,.14)
call Rem_Fx(caster,"bof\\Saber-17.mdx",x-100.*CosBJ(ang),y-100.*SinBJ(ang),-1.,ang,1.,0.)
call Rem_Fx(caster,"bof\\Ryougi Shiki-19.mdx",x-100.*CosBJ(ang),y-100.*SinBJ(ang),-1.,ang,2.,0.)
set dmy=CreateUnit(GetOwningPlayer(caster),'eBLP',x+70.*CosBJ(ang),y+70.*SinBJ(ang),ang)
call SetUnitModel(dmy,"bof\\Scarlet-89.mdx")
call SetUnitScale(dmy,1.5,1.,1.)
call SetUnitFlyHeight(dmy,GetUnitFlyHeight(caster)+80.,0.)
call UnitApplyTimedLife(dmy,'BHwe',1.)
set t2=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t2),0,caster)
call SaveUnitHandle(HH,GetHandleId(t2),1,dmy)
call SaveReal(HH,GetHandleId(t2),2,LoadReal(HH,id,1))
call SaveReal(HH,GetHandleId(t2),3,LoadReal(HH,id,2))
call SaveReal(HH,GetHandleId(t2),4,ang)
call TimerStart(t2,.02,true,function Fla_D_Fly)
endif
if tk==13 then
call Rem_Fx(caster,"bof\\Tsubaki-33.mdx",x,y,250.,ang,1.,0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,90.)
call SetUnitTimeScale(caster,1.)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set t2=null
set caster=null
set dmy=null
endfunction
function Fla_D_Act takes unit caster,real tx,real ty returns nothing
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real ang=Atan2BJ(ty-y,tx-x)
local timer t=CreateTimer()
call SetUnitFacing(caster,ang)
call Rem_Fx(caster,"bof\\Ryougi Shiki-18.mdx",x,y,-1.,ang,1.,0.)
call SetUnitTimeScale(caster,1.)
call Fla_Anim(caster,3,-1.)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call Rem_Sound("bof\\war3mapImported\\Flandre Scarlet-D-YY1.mp3",100)
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call SaveReal(HH,GetHandleId(t),1,tx)
call SaveReal(HH,GetHandleId(t),2,ty)
call SaveReal(HH,GetHandleId(t),3,ang)
call TimerStart(t,.02,true,function Fla_D_Act2)
set t=null
endfunction
// ----- F «And Then Will There Be None?»: 6 c Фландре неуязвима и ходит сама, каждые 0.3 c урон F x20
// всем в 250; остальные кнопки закрыты. В конце — взрыв 600: урон F x100, стан 1 c -----
function Fla_F_End takes unit caster returns nothing
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local group g=CreateGroup()
local unit e
call Rem_Fx(caster,"bof\\Scarlet-47.mdx",x,y,25.,0.,2.5,0.)
call Rem_Fx(caster,"bof\\Scarlet-29.mdx",x,y,25.,0.,1.,0.)
call Rem_Fx(caster,"bof\\Madara-huitu-17.mdx",x,y,25.,0.,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-40.mdx",x,y,25.,0.,1.5,0.)
call Rem_Sound("bof\\war3mapImported\\Flandre Scarlet-F-YY2.mp3",100)
call Rem_Sound("bof\\war3mapImported\\Flandre Scarlet-F-YX1.mp3",145)
call Rem_Noise(GetOwningPlayer(caster),50.,.5)
call GroupEnumUnitsInRange(g,x,y,600.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(caster),e) and GetUnitAbilityLevel(e,'Avul')==0 then
call myCustomDamage(caster,e,(I2R(Fla_Int_F(caster,true))*100.)*0.001,false,false,null,null,null)
call SetControlToUnit(caster,e,1.,"stun")
endif
endloop
call DestroyGroup(g)
set g=null
set e=null
endfunction
function Fla_F_Act2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,0)
local integer tk=LoadInteger(HH,id,1)+1
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real z=GetUnitFlyHeight(caster)
local group g
local unit e
call SaveInteger(HH,id,1,tk)
// F — кольцо вокруг себя: реверсу не подвергается, как кольца и взрывы у героев разраба (Гарп E/T);
// урон и стан — напрямую, мимо Bof_Rev, F реверсом не обрывается (владелец 4 окт)
// нерф 3.7.9: F 4 c (200 тиков), было 6 c
if tk<=200 and IsUnitAliveBJ(caster) then
// неуязвимость F — каждым тиком: её снимают рывок к клону и чужие эффекты (тестер 29 сен)
call SetUnitInvulnerable(caster,true)
if ModuloInteger(tk-1,15)==0 then
call Fla_FLock(caster,true)
call Rem_Fx(caster,"bof\\Scarlet-4.mdx",x,y,z,0.,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-84.mdx",x,y,z,0.,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-69.mdx",x,y,z,0.,1.,0.)
set g=CreateGroup()
call GroupEnumUnitsInRange(g,x,y,250.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(caster),e) and GetUnitAbilityLevel(e,'Avul')==0 then
call myCustomDamage(caster,e,(I2R(Fla_Int_F(caster,true))*20.)*0.001,false,false,null,null,null)
endif
endloop
call DestroyGroup(g)
endif
else
if IsUnitAliveBJ(caster) then
call Fla_F_End(caster)
endif
call SaveBoolean(HH,GetHandleId(caster),SH_FlaFOn,false)
call Fla_FLock(caster,false)
call SetUnitInvulnerable(caster,false)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set caster=null
set g=null
set e=null
endfunction
function Fla_F_Act takes unit caster returns nothing
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real z=GetUnitFlyHeight(caster)
local unit dmy
local timer t=CreateTimer()
call SaveBoolean(HH,GetHandleId(caster),SH_bofRevd,false)
call SaveBoolean(HH,GetHandleId(caster),SH_FlaFOn,true)
call SetUnitInvulnerable(caster,true)
call Fla_FLock(caster,true)
// круг и столб на месте каста (6 c)
call Rem_Fx(caster,"bof\\Scarlet-83.mdx",x,y,25.,0.,1.5,4.)
set dmy=CreateUnit(GetOwningPlayer(caster),'eBMC',x,y,270.)
call SetUnitModel(dmy,"bof\\Scarlet-78.mdx")
call SetUnitScale(dmy,6.,1.,1.)
call SetUnitFlyHeight(dmy,25.,0.)
call Bof_zO(4.,dmy)
call Rem_Fx(caster,"bof\\Scarlet-29.mdx",x,y,z,0.,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-14.mdx",x,y,20.,0.,1.,1.)
call Rem_Fx(caster,"bof\\Scarlet-21.mdx",x,y,z,0.,2.,0.)
call Rem_Fx(caster,"bof\\Scarlet-65.mdx",x,y,z,0.,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-4.mdx",x,y,z,0.,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-69.mdx",x,y,z,0.,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-84.mdx",x,y,z,0.,1.,0.)
call Rem_Sound("bof\\war3mapImported\\Flandre Scarlet-F-YY1.mp3",110)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-G-YX1.mp3",100)
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call TimerStart(t,.02,true,function Fla_F_Act2)
set dmy=null
set t=null
endfunction
// ----- G: 2.2 c в паузе, с 0.66 c луч вперёд (1400, ширина 260) каждые 5 тиков: урон G x20, стан
// 0.2 c. Вторая стадия — G2 на 8 c -----
// Удар луча от Фландре по направлению ang
function Fla_G_Beam takes unit caster,real ang returns nothing
local real bx=GetUnitX(caster)+80.*CosBJ(ang)
local real by=GetUnitY(caster)+80.*SinBJ(ang)
local group g=CreateGroup()
local unit e
call GroupEnumUnitsInRange(g,bx+1400.*CosBJ(ang),by+1400.*SinBJ(ang),1600.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(caster),e) and GetUnitAbilityLevel(e,'Avul')==0 and RAbsBJ((GetUnitX(e)-bx)*SinBJ(ang)-(GetUnitY(e)-by)*CosBJ(ang))<=260. then
call Bof_Dmg(caster,e,(I2R(Fla_Int_G(caster,true))*20.)*0.001)
call Bof_Ctrl(caster,e,.2,"stun")
endif
endloop
call DestroyGroup(g)
set g=null
set e=null
endfunction
// Тик 0.02 c; k — счётчик эффектов bof, на 1 c (тик 50) он обнуляется
function Fla_G_Act2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,0)
local real ang=LoadReal(HH,id,1)
local integer tk=LoadInteger(HH,id,2)+1
local integer k=LoadInteger(HH,id,3)+1
local unit dmy=LoadUnitHandle(HH,id,4)
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
call SaveInteger(HH,id,2,tk)
// реверс (цель в стойке развернула умение): как у героев Чейза — умение кончается, кастер отпущен
if Bof_RevEnd(caster) then
if dmy!=null then
call SetUnitAnimationByIndex(dmy,2)
call Bof_zO(.48,dmy)
endif
call CameraClearNoiseForPlayer(GetOwningPlayer(caster))
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
set t=null
set caster=null
set dmy=null
return
endif
call SetUnitInvulnerable(caster,true)
call PauseUnit(caster,true)
if ModuloInteger(k,10)==0 then
call Rem_Fx(caster,"bof\\Madara-huitu-22.mdx",x,y,25.,ang,15.,0.)
endif
if ModuloInteger(k,30)==0 then
call Rem_Fx(caster,"bof\\Minato-41.mdx",x,y,25.,ang,1.5,0.)
endif
if tk==25 then
set dmy=CreateUnit(GetOwningPlayer(caster),'eBLP',x+300.*CosBJ(ang),y+300.*SinBJ(ang),ang)
call SetUnitModel(dmy,"bof\\Scarlet-90.mdx")
call UnitApplyTimedLife(dmy,'BHwe',3.)
call SetUnitFlyHeight(dmy,0.,1000000000.)
call SetUnitAnimation(dmy,"Birth")
call SaveUnitHandle(HH,id,4,dmy)
call CameraSetEQNoiseForPlayer(GetOwningPlayer(caster),40.)
call Rem_Sound("bof\\war3mapImported\\Flandre Scarlet-G-YX2.mp3",200)
endif
if tk==50 then
// у bof точка эффекта к этому тику уже перезаписана местом Фландре (эффекты раз в 10 тиков)
call Rem_Fx(caster,"bof\\Saber-14.mdx",x,y,150.,0.,2.,0.)
call SetUnitAnimationByIndex(dmy,1)
set k=0
endif
call SaveInteger(HH,id,3,k)
if tk>=34 and tk<=110 then
if k==1 or ModuloInteger(k-1,12)==0 then
call Rem_Fx(caster,"bof\\Tsubaki-33.mdx",x,y,250.,ang,1.,0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,90.)
call Rem_Fx(caster,"bof\\Minato-31.mdx",x+150.*CosBJ(ang),y+150.*SinBJ(ang),250.,ang,6.,0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,90.)
endif
if ModuloInteger(k,5)==0 then
call Fla_G_Beam(caster,ang)
endif
endif
if tk==110 then
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
call SetUnitPathing(caster,true)
call SetUnitTimeScale(caster,1.)
call SetUnitAnimationByIndex(dmy,2)
call Bof_zO(.48,dmy)
call CameraClearNoiseForPlayer(GetOwningPlayer(caster))
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set caster=null
set dmy=null
endfunction
function Fla_G_Act takes unit caster,real tx,real ty returns nothing
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real ang=Atan2BJ(ty-y,tx-x)
local timer t=CreateTimer()
call SaveBoolean(HH,GetHandleId(caster),SH_bofRevd,false)
call Bof_SwapStage(caster,'FlG1','FlG2',8.)
call Rem_Fx(caster,"bof\\Saber-28.mdx",x,y,25.,0.,1.,3.)
call SetUnitFacingTimed(caster,ang,0)
call SetUnitTimeScale(caster,1.)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call SetUnitPathing(caster,false)
call Rem_Sound("bof\\war3mapImported\\Flandre Scarlet-G-YY1.mp3",110)
call Rem_Sound("bof\\war3mapImported\\Flandre Scarlet-G-YX1.mp3",105)
call Fla_Anim(caster,3,1.)
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call SaveReal(HH,GetHandleId(t),1,ang)
call TimerStart(t,.02,true,function Fla_G_Act2)
set t=null
endfunction
// ----- G2: удар по цели (до 1600): на 0.58 c и 0.9 c — урон G2 x120 и стан 1.5 c. Пауза 1 c -----
function Fla_G2_Act2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,0)
local unit target=LoadUnitHandle(HH,id,1)
local real px=LoadReal(HH,id,2)
local real py=LoadReal(HH,id,3)
local real ang=LoadReal(HH,id,4)
local integer tk=LoadInteger(HH,id,5)+1
local integer k
call SaveInteger(HH,id,5,tk)
// реверс (цель в стойке развернула умение): как у героев Чейза — умение кончается, кастер отпущен
if Bof_RevEnd(caster) then
call CameraClearNoiseForPlayer(GetOwningPlayer(caster))
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
set t=null
set caster=null
set target=null
return
endif
if tk<=40 then
call SetUnitInvulnerable(caster,true)
call PauseUnit(caster,true)
endif
if tk==1 then
call SetUnitTimeScale(caster,1.)
call SetUnitAnimationByIndex(caster,3)
endif
if tk==13 then
call CameraSetEQNoiseForPlayer(GetOwningPlayer(caster),35.)
call Rem_Fx(caster,"bof\\Scarlet-36.MDX",px,py,25.,ang,1.5,0.)
call Rem_Fx(caster,"bof\\Scarlet-48.mdx",px,py,25.,ang,1.5,2.)
call Rem_Fx(caster,"bof\\Madara-huitu-22.mdx",px,py,25.,ang,15.,0.)
call Rem_Fx(caster,"bof\\Scarlet-93.mdx",px,py,25.,ang,2.,0.)
call Rem_Fx(caster,"bof\\Scarlet-94.mdx",px,py,25.,ang,2.,0.)
endif
if tk>=14 and tk<=50 then
set k=LoadInteger(HH,id,6)+1
call SaveInteger(HH,id,6,k)
if ModuloInteger(k,16)==0 then
call Rem_Fx(caster,"bof\\Madara-huitu-22.mdx",px,py,25.,ang,15.,0.)
call Rem_Fx(caster,"bof\\Scarlet-40.mdx",px,py,25.,ang,3.,0.)
call Rem_Fx(caster,"bof\\Scarlet-54.mdx",GetUnitX(target),GetUnitY(target),150.,0.,1.,0.)
call Rem_Fx(caster,"bof\\Scarlet-52.mdx",GetUnitX(target),GetUnitY(target),150.,0.,1.,0.)
call Bof_Dmg(caster,target,(I2R(Fla_Int_G2(caster,true))*100.)*0.001)
call Bof_Ctrl(caster,target,1.5,"stun")
endif
endif
if tk==50 then
call CameraClearNoiseForPlayer(GetOwningPlayer(caster))
call SetUnitInvulnerable(caster,false)
call PauseUnit(caster,false)
call SetUnitTimeScale(caster,1.)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set caster=null
set target=null
endfunction
function Fla_G2_Act takes unit caster,unit target returns nothing
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real ang=Atan2BJ(GetUnitY(target)-y,GetUnitX(target)-x)
local real dist=RMinBJ(SRS(x,y,GetUnitX(target),GetUnitY(target)),1600.)
local timer t=CreateTimer()
call SaveBoolean(HH,GetHandleId(caster),SH_bofRevd,false)
call Rem_Fx(caster,"bof\\Scarlet-8.mdx",x,y,-1.,0.,1.,0.)
call Rem_Fx(caster,"bof\\Tsubaki-33.mdx",x,y,-1.,0.,1.,0.)
call Rem_Fx(caster,"bof\\Madara-huitu-22.mdx",x,y,25.,ang,4.,0.)
call SetUnitInvulnerable(caster,true)
call PauseUnit(caster,true)
call Rem_Sound("bof\\war3mapImported\\Flandre Scarlet-ZS2-YY1.mp3",100)
call Rem_Sound("bof\\war3mapImported\\Flandre Scarlet-ZS2-YX1.mp3",110)
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call SaveUnitHandle(HH,GetHandleId(t),1,target)
call SaveReal(HH,GetHandleId(t),2,x+CosBJ(ang)*dist)
call SaveReal(HH,GetHandleId(t),3,y+SinBJ(ang)*dist)
call SaveReal(HH,GetHandleId(t),4,ang)
call TimerStart(t,.02,true,function Fla_G2_Act2)
call Bof_SwapBack(caster,'FlG1','FlG2')
set t=null
endfunction
// ----- Рывок к клону (правый клик по земле у клона, 200–1600 от Фландре): каждый клон — один раз.
// Летит сквозь декор (Bof_Put), в конце — на ближайшее проходимое место (тестер 4 окт: застревала) -----
// Летит по 40 до 1 c, каждые 8 тиков урон ord_smart x20 в 320 -----
function Fla_Smart_Act2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,0)
local unit cl=LoadUnitHandle(HH,id,1)
local integer tk=LoadInteger(HH,id,2)+1
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real ang=Atan2BJ(GetUnitY(cl)-y,GetUnitX(cl)-x)
local group g
local unit e
call SaveInteger(HH,id,2,tk)
// реверс (цель в стойке развернула умение): как у героев Чейза — умение кончается, кастер отпущен
if Bof_RevEnd(caster) then
call Bof_Unstick(caster)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
set t=null
set caster=null
set cl=null
return
endif
call SetUnitInvulnerable(caster,true)
if tk<=50 and SRS(x,y,GetUnitX(cl),GetUnitY(cl))>80. then
set x=x+40.*CosBJ(ang)
set y=y+40.*SinBJ(ang)
call Bof_Put(caster,x,y)
if ModuloInteger(tk,8)==0 then
set x=GetUnitX(caster)
set y=GetUnitY(caster)
call Rem_Fx(caster,"bof\\Scarlet-69.mdx",x,y,150.,ang,.75,0.)
call Rem_Fx(caster,"bof\\Scarlet-84.mdx",x,y,150.,ang,1.,0.)
set g=CreateGroup()
call GroupEnumUnitsInRange(g,x,y,320.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(caster),e) and GetUnitAbilityLevel(e,'Avul')==0 then
call Bof_Dmg(caster,e,(I2R(Fla_Int_ord_smart(caster,true))*20.)*0.001)
endif
endloop
call DestroyGroup(g)
endif
else
call Bof_Unstick(caster)
if not LoadBoolean(HH,GetHandleId(caster),SH_FlaFOn) then
call SetUnitInvulnerable(caster,false)
endif
call SetUnitTimeScale(caster,1.)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set caster=null
set cl=null
set g=null
set e=null
endfunction
function Fla_OrderSmart takes unit caster,real tx,real ty returns nothing
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real dist=SRS(x,y,tx,ty)
local integer i=0
local integer cnt=0
local unit cl
local unit chosen=null
local real ang
local real z=GetUnitFlyHeight(caster)
local timer t
// клоны у точки клика (300), каждый — один раз; из них случайный (как GroupPickRandomUnit у bof)
loop
exitwhen i>7
set cl=Fla_CloneAt(caster,i)
if cl!=null and IsUnitInRangeXY(cl,tx,ty,300.) and LoadBoolean(HH,GetHandleId(cl),SH_FlaDash) then
call SaveBoolean(HH,GetHandleId(cl),SH_FlaDash,false)
set cnt=cnt+1
if GetRandomInt(1,cnt)==1 then
set chosen=cl
endif
endif
set i=i+1
endloop
set cl=chosen
if cl!=null and dist<1600. and dist>200. then
set ang=Atan2BJ(GetUnitY(cl)-y,GetUnitX(cl)-x)
call SaveBoolean(HH,GetHandleId(caster),SH_bofRevd,false)
call SetUnitInvulnerable(caster,true)
call Rem_Fx(caster,"bof\\Saber-15.mdx",x,y,125.,ang,1.,0.)
call Rem_Fx(caster,"bof\\Saber-17.mdx",x,y,z+50.,ang,1.5,0.)
call Rem_Fx(caster,"bof\\Minato-25.mdx",x,y,z+50.,ang,1.,0.)
call Rem_Fx(caster,"bof\\chongfeng2.mdx",x,y,z+50.,ang,1.,0.)
set t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call SaveUnitHandle(HH,GetHandleId(t),1,cl)
call TimerStart(t,.02,true,function Fla_Smart_Act2)
endif
set cl=null
set chosen=null
set t=null
endfunction
// ----- Приказ атаки клонам (A + клик, раз в 30 c): каждый клон бросается на 1600 за 0.8 c, по пути
// каждый тик урон ord_atk x5 (от ИНТ Фландре) в 280 и стан 1 c -----
function Fla_AtkReadyAct takes nothing returns nothing
local timer t=GetExpiredTimer()
call SaveBoolean(HH,GetHandleId(LoadUnitHandle(HH,GetHandleId(t),0)),SH_FlaAtkReady,true)
call FlushChildHashtable(HH,GetHandleId(t))
call DestroyTimer(t)
set t=null
endfunction
// Рывок клона, тик 0.02 c. Точка урона (3, 4) — как у bof: старт, потом место клона на тиках эффектов
function Fla_Rush_Act2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit cl=LoadUnitHandle(HH,id,0)
local unit fla=LoadUnitHandle(HH,GetHandleId(cl),SH_FlaOwner)
local real ang=LoadReal(HH,id,1)
local integer tk=LoadInteger(HH,id,2)+1
local real x=LoadReal(HH,id,3)
local real y=LoadReal(HH,id,4)
local real z=GetUnitFlyHeight(cl)
local integer k
local unit dmy
local group g
local unit e
call SaveInteger(HH,id,2,tk)
call PauseUnit(cl,true)
call SetUnitInvulnerable(cl,true)
if tk==18 then
call Rem_Sound("bof\\war3mapImported\\Flandre Scarlet-pingA-YX1.mp3",110)
call Rem_Fx(cl,"bof\\Saber-15.mdx",x,y,125.,ang,1.,0.)
call Rem_Fx(cl,"bof\\Saber-17.mdx",x,y,z+50.,ang,1.5,0.)
call Rem_Fx(cl,"bof\\Minato-25.mdx",x,y,z+50.,ang,1.,0.)
call Rem_Fx(cl,"bof\\chongfeng2.mdx",x,y,z+50.,ang,1.,0.)
call SetUnitTimeScale(cl,1.)
set dmy=CreateUnit(GetOwningPlayer(cl),'eBLP',GetUnitX(cl),GetUnitY(cl),ang)
call UnitApplyTimedLife(dmy,'BHwe',.8)
call SetUnitScale(dmy,1.5,1.,1.)
call SetUnitFlyHeight(dmy,150.,1000000000.)
call SetUnitModel(dmy,"bof\\Scarlet-96.mdx")
call Bof_Slide(cl,ang,1600.,.8)
call Bof_Slide(dmy,ang,1600.,.8)
endif
if tk>=19 and tk<=48 then
set k=LoadInteger(HH,id,5)+1
call SaveInteger(HH,id,5,k)
if ModuloInteger(k,12)==0 then
set x=GetUnitX(cl)
set y=GetUnitY(cl)
call Rem_Fx(cl,"bof\\Tsubaki-37.mdx",x,y,25.,0.,6.,0.)
endif
if ModuloInteger(k,8)==0 then
set x=GetUnitX(cl)
set y=GetUnitY(cl)
call Rem_Fx(cl,"bof\\Scarlet-59.mdx",x,y,z+150.,GetRandomDirectionDeg(),GetRandomReal(1.5,2.),0.)
call Rem_Fx(cl,"bof\\Scarlet-68.mdx",x,y,z+150.,GetRandomDirectionDeg(),.5,0.)
call Rem_Fx(cl,"bof\\Tsubaki-25.mdx",x,y,z+150.,0.,GetRandomReal(2.,4.),0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,GetRandomDirectionDeg())
call Rem_Fx(cl,"bof\\Tsubaki-26.mdx",x,y,z+150.,0.,GetRandomReal(2.,4.),0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,GetRandomDirectionDeg())
endif
call SaveReal(HH,id,3,x)
call SaveReal(HH,id,4,y)
set g=CreateGroup()
call GroupEnumUnitsInRange(g,x,y,280.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(cl),e) and GetUnitAbilityLevel(e,'Avul')==0 then
if fla!=null then
call Bof_Dmg(fla,e,(I2R(Fla_Int_ord_atk(fla,true))*5.)*0.001)
endif
call Bof_Ctrl(cl,e,1.,"stun")
endif
endloop
call DestroyGroup(g)
endif
if tk==48 then
call PauseUnit(cl,false)
call SetUnitInvulnerable(cl,false)
call SetUnitTimeScale(cl,1.)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set cl=null
set fla=null
set dmy=null
set g=null
set e=null
endfunction
function Fla_OrderAttack takes unit caster,real tx,real ty returns nothing
local integer i=0
local unit cl
local real x
local real y
local real ang
local timer t
// нет живых клонов — приказ не тратится (как у bof: условие «группа клонов не пуста»)
loop
exitwhen i>7 or Fla_CloneAt(caster,i)!=null
set i=i+1
endloop
if i>7 then
return
endif
set t=CreateTimer()
call SaveBoolean(HH,GetHandleId(caster),SH_FlaAtkReady,false)
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call TimerStart(t,30.,false,function Fla_AtkReadyAct)
call Rem_Sound("bof\\war3mapImported\\Flandre Scarlet-pingAJN-YY1.mp3",100)
set i=0
loop
exitwhen i>7
set cl=Fla_CloneAt(caster,i)
if cl!=null then
set x=GetUnitX(cl)
set y=GetUnitY(cl)
set ang=Atan2BJ(ty-y,tx-x)
call SetUnitFacing(cl,ang)
call PauseUnit(cl,true)
call SetUnitInvulnerable(cl,true)
call Rem_Fx(null,"bof\\Tsubaki-33.mdx",x,y,25.,0.,1.,0.)
call SetUnitTimeScale(cl,.65)
call Fla_Anim(cl,10,-1.)
set t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,cl)
call SaveReal(HH,GetHandleId(t),1,ang)
call SaveReal(HH,GetHandleId(t),3,x)
call SaveReal(HH,GetHandleId(t),4,y)
call TimerStart(t,.02,true,function Fla_Rush_Act2)
endif
set i=i+1
endloop
set cl=null
set t=null
endfunction
// Приказы Фландре — один триггер на карту (Fla_OrdersInit из main): атака-приказ — клоны бросаются
// к цели; правый клик по земле у клона — рывок к нему
function Fla_Orders_Cond takes nothing returns boolean
return GetUnitTypeId(GetTriggerUnit())=='HFla'
endfunction
function Fla_Orders takes nothing returns nothing
local unit u=GetTriggerUnit()
call Fla_State(u)
if GetIssuedOrderId()==851983 and LoadBoolean(HH,GetHandleId(u),SH_FlaAtkReady) then
call Fla_OrderAttack(u,Fla_OrderX(),Fla_OrderY())
elseif GetTriggerEventId()==EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER and IsUnitType(u,UNIT_TYPE_HERO) and GetIssuedOrderId()==String2OrderIdBJ("smart") then
call Fla_OrderSmart(u,GetOrderPointX(),GetOrderPointY())
endif
set u=null
endfunction
function Fla_OrdersInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER,null)
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddCondition(t,Condition(function Fla_Orders_Cond))
call TriggerAddAction(t,function Fla_Orders)
set t=null
endfunction
//Flandre1end
//Suigintou1start
// ловкость для урона кнопки D2: урон bof x (0.02);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Sui_Agi_D2 takes unit u,boolean b returns integer
return R2I(I2R(GetHeroAgi(u,b))*(0.02)*1000.+0.5)
endfunction
// ловкость для урона кнопки E2: урон bof x (0.03);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Sui_Agi_E2 takes unit u,boolean b returns integer
return R2I(I2R(GetHeroAgi(u,b))*(0.03)*1000.+0.5)
endfunction
// ловкость для урона кнопки E: x (0.015 + 0.005 x уровень), перо x50 — три пера 3..6 (стандарт карты);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Sui_Agi_Ei takes unit u,boolean b returns integer
return R2I(I2R(GetHeroAgi(u,b))*(0.015+0.005*I2R(GetUnitAbilityLevel(u,'SuE1')))*1000.+0.5)
endfunction
// ловкость для урона кнопки F: урон bof x (0.015);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Sui_Agi_F takes unit u,boolean b returns integer
return R2I(I2R(GetHeroAgi(u,b))*(0.015)*1000.+0.5)
endfunction
// ловкость для урона кнопки F2: урон bof x (0.01);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Sui_Agi_F2 takes unit u,boolean b returns integer
return R2I(I2R(GetHeroAgi(u,b))*(0.01)*1000.+0.5)
endfunction
// ловкость для урона кнопки G: x (0.02), цепь x40, перо x20, без среза паузы — ~11 по цели в центре;
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Sui_Agi_G takes unit u,boolean b returns integer
return R2I(I2R(GetHeroAgi(u,b))*(0.02)*1000.+0.5)
endfunction
// ловкость для урона кнопки Q: x (0.005 + 0.005 x уровень), удары 50+50+100 — серия 2..6 (стандарт карты, 4 окт);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Sui_Agi_Qi takes unit u,boolean b returns integer
return R2I(I2R(GetHeroAgi(u,b))*(0.005+0.005*I2R(GetUnitAbilityLevel(u,'SuQ1')))*1000.+0.5)
endfunction
// ловкость для урона кнопки R: x (0.02 + 0.005 x уровень), большой дракон x200 = 5..9, из пера x50 (стандарт карты);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Sui_Agi_R takes unit u,boolean b returns integer
return R2I(I2R(GetHeroAgi(u,b))*(0.02+0.005*I2R(GetUnitAbilityLevel(u,'SuR1')))*1000.+0.5)
endfunction
// ловкость для урона кнопки T: x (0.08), перо x25 = 2 (стандарт карты);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Sui_Agi_T takes unit u,boolean b returns integer
return R2I(I2R(GetHeroAgi(u,b))*(0.08)*1000.+0.5)
endfunction
// ловкость для урона кнопки W: x (0.012 + 0.004 x уровень), перо x6 — ~32 пера по цели 3..6 (стандарт карты);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Sui_Agi_Wi takes unit u,boolean b returns integer
return R2I(I2R(GetHeroAgi(u,b))*(0.012+0.004*I2R(GetUnitAbilityLevel(u,'SuW1')))*1000.+0.5)
endfunction
// ловкость для урона кнопки atk: урон bof x (0.0075);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Sui_Agi_atk takes unit u,boolean b returns integer
return R2I(I2R(GetHeroAgi(u,b))*(0.0075)*1000.+0.5)
endfunction
// ===== Суйгинто (Rozen Maiden): переписана в стиле Чейза 3 окт — HH вместо хэштейблов bof, свой таймер
// на каст, целые тики (0.02 c), параметры из диспетчера, реверс (стойка обрывает умение и отпускает
// героиню). Исполнители bof (триггеры o8/pB/pD/bT) стали функциями Sui_Q_Do/W_Do/E_Do: зеркало D повторяет
// удар, вызывая их со своей копией героини. Перья, драконы и цепи двигаются без проходимости — в декоре не
// застревают (владелец 3 окт), край карты держит Bof_Put. Урон — от героини, даже если бьёт копия.
function Sui_GhostAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local integer a=LoadInteger(HH,id,1)-LoadInteger(HH,id,2)
if a<=0 then
call RemoveUnit(u)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
else
call SaveInteger(HH,id,1,a)
call SetUnitVertexColor(u,255,255,255,a)
endif
set t=null
set u=null
endfunction
// копия героини (uB1B), прозрачность 150, тает на step каждые 0.02 c; anim<0 — без анимации
function Sui_Ghost takes unit c,real x,real y,real ang,integer anim,integer step returns unit
local timer t=CreateTimer()
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(c),'uB1B',x,y,ang)
call SetUnitBlendTime(bj_lastCreatedUnit,0.)
call SetUnitVertexColor(bj_lastCreatedUnit,255,255,255,150)
if anim>=0 then
call SetUnitAnimationByIndex(bj_lastCreatedUnit,anim)
endif
call SaveUnitHandle(HH,GetHandleId(t),0,bj_lastCreatedUnit)
call SaveInteger(HH,GetHandleId(t),1,150)
call SaveInteger(HH,GetHandleId(t),2,step)
call TimerStart(t,.02,true,function Sui_GhostAct)
set t=null
return bj_lastCreatedUnit
endfunction
function Sui_AnimAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
call SetUnitTimeScale(u,LoadReal(HH,id,1))
call SetUnitAnimationByIndex(u,LoadInteger(HH,id,2))
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
set t=null
set u=null
endfunction
// анимация героини через 0.01 c (сразу после каста игра ставит свою)
function Sui_Anim takes unit u,real sc,integer idx returns nothing
local timer t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,u)
call SaveReal(HH,GetHandleId(t),1,sc)
call SaveInteger(HH,GetHandleId(t),2,idx)
call TimerStart(t,.01,false,function Sui_AnimAct)
set t=null
endfunction
// вспышка клинка: дамми-держатель (анимация его модели задаёт наклон) и, если есть, эффект на origin
function Sui_Slash takes unit c,integer typ,real x,real y,real ang,real sc,integer anim,real z,string fx returns nothing
local unit u=CreateUnit(GetOwningPlayer(c),typ,x,y,ang)
call SetUnitScale(u,sc,1.,1.)
call SetUnitAnimationByIndex(u,anim)
call SetUnitFlyHeight(u,z,0.)
if fx!="" then
call DestroyEffect(AddSpecialEffectTarget(fx,u,"origin"))
endif
call UnitApplyTimedLife(u,'BHwe',.01)
set u=null
endfunction
// перо: дамми с моделью пера, живёт life c
function Sui_Feather takes unit c,real x,real y,real ang,real z,real sc,real life returns unit
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(c),'eBLP',x,y,ang)
call SetUnitPathing(bj_lastCreatedUnit,false)
call Bof_DzSetUnitModel(bj_lastCreatedUnit,"bof\\Mercury Lamp-29.mdx")
if sc!=1. then
call SetUnitScale(bj_lastCreatedUnit,sc,1.,1.)
endif
call UnitApplyTimedLife(bj_lastCreatedUnit,'BHwe',life)
call SetUnitFlyHeight(bj_lastCreatedUnit,z,1000000000.)
return bj_lastCreatedUnit
endfunction
// ----- перья на земле (E, F): список в HH у героини; R превращает их в драконов, T зовёт к себе -----
function Sui_FAdd takes unit hr,unit f returns nothing
local integer id=GetHandleId(hr)
local integer k=LoadInteger(HH,id,SH_SuiFCnt)
call SaveUnitHandle(HH,id,SH_SuiF+k,f)
call SaveInteger(HH,id,SH_SuiFCnt,k+1)
endfunction
// живые перья — в начало списка, истёкшие и убранные выкинуть; вернуть число живых
function Sui_FClean takes unit hr returns integer
local integer id=GetHandleId(hr)
local integer cnt=LoadInteger(HH,id,SH_SuiFCnt)
local integer i=0
local integer k=0
local unit f
loop
exitwhen i>=cnt
set f=LoadUnitHandle(HH,id,SH_SuiF+i)
if GetUnitTypeId(f)!=0 and GetWidgetLife(f)>.405 then
call SaveUnitHandle(HH,id,SH_SuiF+k,f)
set k=k+1
endif
set i=i+1
endloop
set i=k
loop
exitwhen i>=cnt
call RemoveSavedHandle(HH,id,SH_SuiF+i)
set i=i+1
endloop
call SaveInteger(HH,id,SH_SuiFCnt,k)
set f=null
return k
endfunction
// зеркало D, если оно ещё стоит
function Sui_Mirror takes unit hr returns unit
set bj_lastCreatedUnit=LoadUnitHandle(HH,GetHandleId(hr),SH_SuiMirror)
if bj_lastCreatedUnit!=null and (GetUnitTypeId(bj_lastCreatedUnit)==0 or GetWidgetLife(bj_lastCreatedUnit)<=.405) then
call RemoveSavedHandle(HH,GetHandleId(hr),SH_SuiMirror)
set bj_lastCreatedUnit=null
endif
return bj_lastCreatedUnit
endfunction
// ----- Q «Mercury Sword»: рывок вперёд, враги рядом тащатся с ней; три удара (40, 40, 60), стан 2 c -----
function Sui_Q_Strike takes unit src,unit hr,real r,real k returns nothing
local group g=CreateGroup()
local unit e
call GroupEnumUnitsInRange(g,GetUnitX(src),GetUnitY(src),r,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(src),e) and GetUnitAbilityLevel(e,'Avul')==0 then
call Bof_Dmg(hr,e,I2R(Sui_Agi_Qi(hr,true))*k*.001)
call Rem_Fx(hr,"bof\\Scarlet-51.mdx",GetUnitX(e),GetUnitY(e),GetUnitFlyHeight(e)+150.,0.,1.,0.)
call Bof_Ctrl(hr,e,2.,"stun")
endif
endloop
call DestroyGroup(g)
set g=null
set e=null
endfunction
function Sui_Q_Tick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit src=LoadUnitHandle(HH,id,0)
local unit hr=LoadUnitHandle(HH,id,1)
local real ang=LoadReal(HH,id,2)
local integer tk=LoadInteger(HH,id,3)+1
local real x=GetUnitX(src)
local real y=GetUnitY(src)
local real z=GetUnitFlyHeight(src)
local real a2
local integer k
local group g
local unit e
call SaveInteger(HH,id,3,tk)
// реверс (цель в стойке развернула умение): умение кончается, героиня отпущена
if src==hr and Bof_RevEnd(src) then
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
set t=null
set src=null
set hr=null
return
endif
call SetUnitInvulnerable(src,true)
call PauseUnit(src,true)
if tk==1 then
call Bof_Glide(src,ang,400.,.4)
endif
if tk<=48 then
set g=CreateGroup()
call GroupEnumUnitsInRange(g,x,y,220.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(src),e) and GetUnitAbilityLevel(e,'Avul')==0 and not Bof_Rev(hr,e) then
call SetUnitPosition(e,GetUnitX(e)+20.*CosBJ(ang),GetUnitY(e)+20.*SinBJ(ang))
endif
endloop
call DestroyGroup(g)
endif
if tk==16 or tk==31 then
call Rem_Noise(GetOwningPlayer(src),30.,.29)
call SetUnitTimeScale(src,1.)
if tk==16 then
call SetUnitAnimationByIndex(src,6)
call Rem_Sound("bof\\war3mapImported\\Mercury Lamp-Q-YX1.mp3",100)
call Sui_Slash(src,'eBMC',x,y,ang,4.,17,z+100.,"")
else
call SetUnitAnimationByIndex(src,7)
call Rem_Sound("bof\\war3mapImported\\Mercury Lamp-Q-YX2.mp3",100)
call Sui_Slash(src,'eBME',x,y,ang,4.,124,z+100.,"")
endif
call Rem_Fx(hr,"bof\\Saber-17.mdx",x,y,z+50.,ang,1.5,0.)
call Rem_Fx(hr,"bof\\Tsubaki-37.mdx",x,y,z+50.,ang,4.,0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,90.)
call Bof_Glide(src,ang,400.,.4)
call Sui_Q_Strike(src,hr,300.,50.)
endif
if tk==46 then
call Rem_Noise(GetOwningPlayer(src),50.,.5)
call Rem_Sound("bof\\war3mapImported\\Mercury Lamp-Q-YX3.mp3",100)
call Sui_Slash(src,'eBMD',x,y,ang,6.5,9,z+100.,"")
set a2=ang+45.
set k=1
loop
exitwhen k>5
set a2=a2-15.
call Rem_Fx(hr,"bof\\Tsubaki-32.mdx",x,y,z+25.,a2+180.,2.,0.)
set k=k+1
endloop
call Sui_Q_Strike(src,hr,450.,100.)
endif
if tk>=56 then
call SetUnitInvulnerable(src,false)
call PauseUnit(src,false)
call SetUnitTimeScale(src,1.)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set src=null
set hr=null
set g=null
set e=null
endfunction
// удар Q: src — героиня или её копия в зеркале, урон и станы — от героини hr
function Sui_Q_Do takes unit src,unit hr,real ang returns nothing
local real x=GetUnitX(src)
local real y=GetUnitY(src)
local real z=GetUnitFlyHeight(src)
local timer t=CreateTimer()
call Bof_zU(1.,AddSpecialEffectTarget("bof\\Mercury Lamp-25.mdx",src,"chest"))
call Rem_Fx(hr,"bof\\Saber-15.mdx",x,y,125.,ang,1.,0.)
call Rem_Fx(hr,"bof\\Saber-17.mdx",x,y,z+50.,ang,1.5,0.)
call Rem_Fx(hr,"bof\\Tsubaki-37.mdx",x,y,z+50.,ang,4.,0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,90.)
call Sui_Anim(src,.75,5)
call SaveUnitHandle(HH,GetHandleId(t),0,src)
call SaveUnitHandle(HH,GetHandleId(t),1,hr)
call SaveReal(HH,GetHandleId(t),2,ang)
call TimerStart(t,.02,true,function Sui_Q_Tick)
set t=null
endfunction
function Sui_Q_Act takes unit caster,real tx,real ty returns nothing
local unit m=Sui_Mirror(caster)
call SaveBoolean(HH,GetHandleId(caster),SH_bofRevd,false)
if GetRandomInt(1,2)==1 then
call Rem_Sound("bof\\war3mapImported\\Mercury Lamp-Q-YY1.mp3",100)
else
call Rem_Sound("bof\\war3mapImported\\Mercury Lamp-Q-YY2.mp3",100)
endif
call Sui_Q_Do(caster,caster,Atan2BJ(ty-GetUnitY(caster),tx-GetUnitX(caster)))
// зеркало D повторяет удар: полупрозрачная копия в зеркале, лицом туда, куда смотрит зеркало
if m!=null then
call Sui_Q_Do(Sui_Ghost(caster,GetUnitX(m),GetUnitY(m),GetUnitFacing(m),-1,1),caster,GetUnitFacing(m))
endif
set m=null
endfunction
// ----- W «Black Feather Volley»: 2 c из-за крыльев вылетают перья и летят вперёд, каждое бьёт раз (6) -----
function Sui_W_Fly takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit src=LoadUnitHandle(HH,id,0)
local unit hr=LoadUnitHandle(HH,id,1)
local unit f=LoadUnitHandle(HH,id,2)
local real ang=LoadReal(HH,id,3)
local integer tk=LoadInteger(HH,id,4)+1
local real sp=LoadReal(HH,id,5)
local real x
local real y
local group g
local unit e
call SaveInteger(HH,id,4,tk)
if sp<=100. then
set sp=sp+5.
call SaveReal(HH,id,5,sp)
endif
if tk<=22 and GetWidgetLife(f)>.405 then
set x=GetUnitX(f)+sp*CosBJ(ang)
set y=GetUnitY(f)+sp*SinBJ(ang)
call Bof_Put(f,x,y)
set g=CreateGroup()
call GroupEnumUnitsInRange(g,GetUnitX(f),GetUnitY(f),200.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(src),e) and GetUnitAbilityLevel(e,'Avul')==0 and not LoadBoolean(HH,id,GetHandleId(e)) then
call SaveBoolean(HH,id,GetHandleId(e),true)
call Bof_Dmg(hr,e,I2R(Sui_Agi_Wi(hr,true))*6.*.001)
endif
endloop
call DestroyGroup(g)
else
call Rem_Fx(hr,"bof\\Mercury Lamp-26.mdx",GetUnitX(f),GetUnitY(f),GetUnitFlyHeight(src)+50.,ang,1.5,0.)
call SetUnitAnimation(f,"Death")
call UnitApplyTimedLife(f,'BHwe',.4)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set src=null
set hr=null
set f=null
set g=null
set e=null
endfunction
function Sui_W_Tick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit src=LoadUnitHandle(HH,id,0)
local unit hr=LoadUnitHandle(HH,id,1)
local integer tk=LoadInteger(HH,id,2)+1
local real ang=GetUnitFacing(src)
local unit f
local timer t2
call SaveInteger(HH,id,2,tk)
if ModuloInteger(tk,10)==3 then
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-D-YX2.mp3",100)
endif
if ModuloInteger(tk,15)==0 then
call DestroyEffect(AddSpecialEffectTarget("bof\\Mercury Lamp-2.mdx",src,"chest"))
endif
if tk<=40 then
set f=Sui_Feather(hr,GetUnitX(src)+GetRandomReal(-250.,250.)*CosBJ(ang+90.),GetUnitY(src)+GetRandomReal(-250.,250.)*SinBJ(ang+90.),ang,GetRandomReal(0.,300.),1.,2.)
call SetUnitVertexColor(f,255,255,255,0)
call Rem_FadeIn(f,5)
set t2=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t2),0,src)
call SaveUnitHandle(HH,GetHandleId(t2),1,hr)
call SaveUnitHandle(HH,GetHandleId(t2),2,f)
call SaveReal(HH,GetHandleId(t2),3,ang)
call SaveReal(HH,GetHandleId(t2),5,40.)
call TimerStart(t2,.02,true,function Sui_W_Fly)
else
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set t2=null
set src=null
set hr=null
set f=null
endfunction
function Sui_W_Do takes unit src,unit hr,real ang returns nothing
local real x=GetUnitX(src)
local real y=GetUnitY(src)
local real z=GetUnitFlyHeight(src)
local timer t=CreateTimer()
call DestroyEffect(AddSpecialEffectTarget("bof\\Mercury Lamp-2.mdx",src,"chest"))
call Rem_Fx(hr,"bof\\Mercury Lamp-23.mdx",x,y,z+50.,ang,1.,0.)
call Rem_Fx(hr,"bof\\Mercury Lamp-22.mdx",x,y,z+50.,ang,1.,0.)
call Rem_Fx(hr,"bof\\Mercury Lamp-27.mdx",x,y,z+50.,ang,1.,0.)
call SaveUnitHandle(HH,GetHandleId(t),0,src)
call SaveUnitHandle(HH,GetHandleId(t),1,hr)
call TimerStart(t,.05,true,function Sui_W_Tick)
set t=null
endfunction
function Sui_W_Act takes unit caster,real tx,real ty returns nothing
local unit m=Sui_Mirror(caster)
call SaveBoolean(HH,GetHandleId(caster),SH_bofRevd,false)
if GetRandomInt(1,2)==1 then
call Rem_Sound("bof\\war3mapImported\\Mercury Lamp-W-YY1.mp3",100)
else
call Rem_Sound("bof\\war3mapImported\\Mercury Lamp-W-YY2.mp3",100)
endif
call Sui_W_Do(caster,caster,Atan2BJ(ty-GetUnitY(caster),tx-GetUnitX(caster)))
// зеркало повторяет залп само (у bof — без копии): перья летят туда, куда оно смотрит
if m!=null then
call Sui_W_Do(m,caster,GetUnitFacing(m))
endif
set m=null
endfunction
// ----- E «Feather Scatter»: отскок, 3 пера веером (50, без стана), потом лежат 12 c; E -> E2 на 8 c -----
function Sui_E_Fly takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit src=LoadUnitHandle(HH,id,0)
local unit hr=LoadUnitHandle(HH,id,1)
local unit f=LoadUnitHandle(HH,id,2)
local real ang=LoadReal(HH,id,3)
local real fa=LoadReal(HH,id,6)
local integer tk=LoadInteger(HH,id,4)+1
local real sp=LoadReal(HH,id,5)
local real x
local real y
local group g
local unit e
call SaveInteger(HH,id,4,tk)
if sp<=100. then
set sp=sp+5.
call SaveReal(HH,id,5,sp)
endif
if tk<=22 and GetWidgetLife(f)>.405 then
call SetUnitFlyHeight(f,GetUnitFlyHeight(f)-25.,1000000000.)
call SetUnitFacingTimed(f,fa,0)
set x=GetUnitX(f)+sp*CosBJ(fa)
set y=GetUnitY(f)+sp*SinBJ(fa)
call Bof_Put(f,x,y)
set g=CreateGroup()
call GroupEnumUnitsInRange(g,GetUnitX(f),GetUnitY(f),260.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(src),e) and GetUnitAbilityLevel(e,'Avul')==0 and not LoadBoolean(HH,id,GetHandleId(e)) then
call SaveBoolean(HH,id,GetHandleId(e),true)
call Bof_Dmg(hr,e,I2R(Sui_Agi_Ei(hr,true))*50.*.001)
call DestroyEffect(AddSpecialEffectTarget("bof\\hero_skeletonking_n2s_e_sta1r.mdx",e,"chest"))
call Rem_Fx(hr,"bof\\Minato-3.mdx",GetUnitX(e),GetUnitY(e),150.,ang,1.,0.)
call Rem_Sound("bof\\war3mapImported\\Minato-Q-YX2.mp3",110)
if GetWidgetLife(e)>.405 then
call SetUnitAnimation(e,"stand hit")
endif
endif
endloop
call DestroyGroup(g)
else
call Rem_Fx(hr,"bof\\Mercury Lamp-26.mdx",GetUnitX(f),GetUnitY(f),50.,ang,1.5,0.)
call Rem_Fx(hr,"bof\\Mercury Lamp-23.mdx",GetUnitX(f),GetUnitY(f),50.,ang,1.5,0.)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set src=null
set hr=null
set f=null
set g=null
set e=null
endfunction
function Sui_E_Tick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit src=LoadUnitHandle(HH,id,0)
local unit hr=LoadUnitHandle(HH,id,1)
local real ang=LoadReal(HH,id,2)
local integer tk=LoadInteger(HH,id,3)+1
local real x=GetUnitX(src)
local real y=GetUnitY(src)
local real z=GetUnitFlyHeight(src)
local real fa
local integer k
local unit f
local timer t2
call SaveInteger(HH,id,3,tk)
if src==hr and Bof_RevEnd(src) then
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
set t=null
set src=null
set hr=null
return
endif
call SetUnitInvulnerable(src,true)
call PauseUnit(src,true)
if tk==1 then
call Bof_Glide(src,ang+180.,600.,.6)
endif
if ModuloInteger(tk-1,20)==0 then
call DestroyEffect(AddSpecialEffectTarget("bof\\Mercury Lamp-2.mdx",src,"chest"))
endif
if tk==31 then
call Rem_Noise(GetOwningPlayer(src),35.,.4)
call Rem_Fx(hr,"bof\\Tsubaki-37.mdx",x,y,z+100.,ang,5.,0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,90.)
call Rem_Fx(hr,"bof\\Saber-17.mdx",x,y,z+50.,ang,1.5,0.)
endif
if tk==40 then
call Rem_Sound("bof\\war3mapImported\\Mercury Lamp-ZS1JN-YX1.mp3",100)
set fa=ang-30.
set k=1
loop
exitwhen k>3
set fa=fa+15.
set f=Sui_Feather(hr,x,y,fa,z+100.,1.,12.)
call Sui_FAdd(hr,f)
if k==2 then
call Rem_Fx(hr,"bof\\Tsubaki-37.mdx",x,y,GetUnitFlyHeight(f)+50.,fa,4.,0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,90.)
call Rem_Fx(hr,"bof\\Minato-31.mdx",x,y,GetUnitFlyHeight(f)+50.,fa,3.,0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,90.)
endif
set t2=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t2),0,src)
call SaveUnitHandle(HH,GetHandleId(t2),1,hr)
call SaveUnitHandle(HH,GetHandleId(t2),2,f)
call SaveReal(HH,GetHandleId(t2),3,ang)
call SaveReal(HH,GetHandleId(t2),5,40.)
call SaveReal(HH,GetHandleId(t2),6,fa)
call TimerStart(t2,.02,true,function Sui_E_Fly)
set k=k+1
endloop
call Bof_Glide(src,ang+180.,400.,.4)
endif
if tk>=51 then
call SetUnitInvulnerable(src,false)
call PauseUnit(src,false)
call SetUnitTimeScale(src,1.)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set t2=null
set src=null
set hr=null
set f=null
endfunction
function Sui_E_Do takes unit src,unit hr,real ang returns nothing
local real x=GetUnitX(src)
local real y=GetUnitY(src)
local real z=GetUnitFlyHeight(src)
local timer t=CreateTimer()
call DestroyEffect(AddSpecialEffectTarget("bof\\Mercury Lamp-2.mdx",src,"chest"))
call Rem_Fx(hr,"bof\\Mercury Lamp-23.mdx",x,y,z+50.,ang,1.,0.)
call Rem_Fx(hr,"bof\\Mercury Lamp-22.mdx",x,y,z+50.,ang,1.,0.)
call Rem_Fx(hr,"bof\\Mercury Lamp-27.mdx",x,y,z+50.,ang,1.,0.)
call Sui_Anim(src,.5,2)
call SaveUnitHandle(HH,GetHandleId(t),0,src)
call SaveUnitHandle(HH,GetHandleId(t),1,hr)
call SaveReal(HH,GetHandleId(t),2,ang)
call TimerStart(t,.02,true,function Sui_E_Tick)
set t=null
endfunction
function Sui_E_Act takes unit caster,real tx,real ty returns nothing
local unit m=Sui_Mirror(caster)
call Bof_SwapStage(caster,'SuE1','SuE2',8.)
call SaveBoolean(HH,GetHandleId(caster),SH_bofRevd,false)
if GetRandomInt(1,2)==1 then
call Rem_Sound("bof\\war3mapImported\\Mercury Lamp-F-YY1.mp3",100)
else
call Rem_Sound("bof\\war3mapImported\\Mercury Lamp-F-YY2.mp3",100)
endif
call Sui_E_Do(caster,caster,Atan2BJ(ty-GetUnitY(caster),tx-GetUnitX(caster)))
if m!=null then
call Sui_E_Do(Sui_Ghost(caster,GetUnitX(m),GetUnitY(m),GetUnitFacing(m),-1,1),caster,GetUnitFacing(m))
endif
set m=null
endfunction
// ----- рывок с остаточными образами (E2 и D2): каждые 4 тика вспышки клинков и образ сбоку -----
function Sui_DashFx takes unit hr,integer k,real ang returns nothing
local real side
local real x
local real y
local real z=GetUnitFlyHeight(hr)
if ModuloInteger(k,2)==0 then
set side=ang+90.
else
set side=ang-90.
endif
set x=GetUnitX(hr)+150.*CosBJ(side)
set y=GetUnitY(hr)+150.*SinBJ(side)
if ModuloInteger(k,2)==0 then
call Sui_Slash(hr,'eBMC',x,y,ang+45.,GetRandomReal(2.,2.5),R2I(GetRandomReal(0.,180.)*.69),z+50.,"bof\\Mercury Lamp-14.mdx")
call Sui_Slash(hr,'eBMC',x,y,ang-45.,GetRandomReal(2.,2.5),R2I(GetRandomReal(0.,180.)*.69),z+50.,"bof\\Mercury Lamp-16.mdx")
else
call Sui_Slash(hr,'eBMC',x,y,ang-45.,GetRandomReal(2.,2.5),R2I(GetRandomReal(0.,180.)*.69),z+50.,"bof\\Mercury Lamp-13.mdx")
call Sui_Slash(hr,'eBMC',x,y,ang+45.,GetRandomReal(2.,2.5),R2I(GetRandomReal(0.,180.)*.69),z+50.,"bof\\Mercury Lamp-15.mdx")
endif
call Rem_Fx(hr,"bof\\Mercury Lamp-18.mdx",x,y,z+50.,0.,1.5,0.)
call Sui_Ghost(hr,x,y,ang,1,5)
call Rem_Fx(hr,"bof\\Mercury Lamp-20.mdx",x,y,z+50.,ang,1.5,0.)
endfunction
// ----- E2 «Floating Plume»: рывок на 1200 за 0.6 c, каждого раз (60), стан 1.2 c -----
function Sui_E2_Tick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit hr=LoadUnitHandle(HH,id,0)
local real ang=LoadReal(HH,id,1)
local integer tk=LoadInteger(HH,id,2)+1
local real x
local real y
local real z
local group g
local unit e
call SaveInteger(HH,id,2,tk)
if Bof_RevEnd(hr) then
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
set t=null
set hr=null
return
endif
call SetUnitInvulnerable(hr,true)
call PauseUnit(hr,true)
if tk==1 then
call SetUnitAnimationByIndex(hr,1)
call Rem_Noise(GetOwningPlayer(hr),60.,.6)
call Bof_Glide(hr,ang,1200.,.6)
endif
if ModuloInteger(tk,4)==0 then
call SaveInteger(HH,id,3,LoadInteger(HH,id,3)+1)
call Sui_DashFx(hr,LoadInteger(HH,id,3),ang)
endif
set g=CreateGroup()
call GroupEnumUnitsInRange(g,GetUnitX(hr),GetUnitY(hr),300.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(hr),e) and GetUnitAbilityLevel(e,'Avul')==0 and not LoadBoolean(HH,id,GetHandleId(e)) then
call SaveBoolean(HH,id,GetHandleId(e),true)
call Bof_Dmg(hr,e,I2R(Sui_Agi_E2(hr,true))*60.*.001)
call Bof_Ctrl(hr,e,1.2,"stun")
call Rem_Fx(hr,"bof\\Minato-3.mdx",GetUnitX(e),GetUnitY(e),150.,ang,1.,0.)
endif
endloop
call DestroyGroup(g)
if tk>=31 then
set x=GetUnitX(hr)
set y=GetUnitY(hr)
set z=GetUnitFlyHeight(hr)
call SetUnitInvulnerable(hr,false)
call PauseUnit(hr,false)
call Rem_Fx(hr,"bof\\Mercury Lamp-23.mdx",x,y,z+50.,ang,1.,0.)
call Rem_Fx(hr,"bof\\Mercury Lamp-33.mdx",x,y,z+50.,ang,2.,0.)
call Rem_Fx(hr,"bof\\Minato-26.mdx",x,y,z+50.,ang,2.,0.)
call SetUnitTimeScale(hr,1.)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set hr=null
set g=null
set e=null
endfunction
function Sui_E2_Act takes unit caster,real tx,real ty returns nothing
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real z=GetUnitFlyHeight(caster)
local real ang=Atan2BJ(ty-y,tx-x)
local timer t=CreateTimer()
call SaveBoolean(HH,GetHandleId(caster),SH_bofRevd,false)
call Rem_Fx(caster,"bof\\Mercury Lamp-20.mdx",x,y,z+50.,ang,1.5,0.)
call Bof_zU(1.,AddSpecialEffectTarget("bof\\Mercury Lamp-25.mdx",caster,"chest"))
call Rem_Fx(caster,"bof\\Saber-15.mdx",x,y,125.,ang,1.,0.)
call Rem_Fx(caster,"bof\\Saber-17.mdx",x,y,z+50.,ang,1.5,0.)
call Rem_Fx(caster,"bof\\Tsubaki-37.mdx",x,y,z+50.,ang,4.,0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,90.)
call Sui_Ghost(caster,x,y,ang,1,5)
call Rem_Sound("bof\\war3mapImported\\Mercury Lamp-ZS1JN-YX1.mp3",100)
call Rem_Sound("bof\\war3mapImported\\Mercury Lamp-ZS1JN-YY1.mp3",100)
call DestroyEffect(AddSpecialEffectTarget("bof\\Mercury Lamp-2.mdx",caster,"chest"))
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call SaveReal(HH,GetHandleId(t),1,ang)
call TimerStart(t,.02,true,function Sui_E2_Tick)
call Bof_SwapBack(caster,'SuE1','SuE2')
set t=null
endfunction
// ----- D «Mirror of N»: зеркало в точке на 12 c (повторяет Q/W/E, поворот — приказ атаки); через
// 0.5 c D сменяется на D2 -----
function Sui_D_Glow takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local integer tk=LoadInteger(HH,id,3)+1
call SaveInteger(HH,id,3,tk)
if tk<=5 then
set bj_lastCreatedEffect=AddSpecialEffect("bof\\Scarlet-33.mdx",LoadReal(HH,id,0),LoadReal(HH,id,1))
call SetSpecialEffectZ(bj_lastCreatedEffect,LoadReal(HH,id,2))
call SetSpecialEffectScale(bj_lastCreatedEffect,3.)
call DestroyEffect(bj_lastCreatedEffect)
else
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
endfunction
// пять вспышек сияния зеркала над точкой (раз в 0.35 c)
function Sui_Glow takes real x,real y,real z returns nothing
local timer t=CreateTimer()
call SaveReal(HH,GetHandleId(t),0,x)
call SaveReal(HH,GetHandleId(t),1,y)
call SaveReal(HH,GetHandleId(t),2,z)
call TimerStart(t,.35,true,function Sui_D_Glow)
set t=null
endfunction
function Sui_D_Swap takes nothing returns nothing
local timer t=GetExpiredTimer()
call UnitAddAbility(LoadUnitHandle(HH,GetHandleId(t),0),'SuD2')
call FlushChildHashtable(HH,GetHandleId(t))
call DestroyTimer(t)
set t=null
endfunction
function Sui_D_End takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit hr=LoadUnitHandle(HH,GetHandleId(t),0)
call UnitRemoveAbility(hr,'SuD2')
call SetPlayerAbilityAvailable(GetOwningPlayer(hr),'SuD1',true)
call RemoveSavedHandle(HH,GetHandleId(hr),SH_SuiMirror)
call FlushChildHashtable(HH,GetHandleId(t))
call DestroyTimer(t)
set t=null
set hr=null
endfunction
function Sui_D_Act takes unit caster,real tx,real ty returns nothing
local real ang=Atan2BJ(ty-GetUnitY(caster),tx-GetUnitX(caster))
local unit m=CreateUnit(GetOwningPlayer(caster),'hB1Z',tx,ty,ang)
local timer t
call SetUnitScale(m,2.,1.,1.)
call UnitApplyTimedLife(m,'BHwe',12.)
call Bof_EXSetUnitMoveType(m,1)
call SetUnitInvulnerable(m,true)
call SaveUnitHandle(HH,GetHandleId(caster),SH_SuiMirror,m)
call Rem_Sound("bof\\war3mapImported\\Mercury Lamp-G-YX2.mp3",100)
call Rem_Fx(caster,"bof\\Mercury Lamp-38.mdx",tx,ty,25.,0.,3.,0.)
call Rem_Fx(caster,"bof\\Mercury Lamp-37.mdx",tx,ty,800.,0.,2.,3.)
call Rem_Fx(caster,"bof\\Mercury Lamp-32.mdx",tx,ty,800.,ang,4.,0.)
call Rem_Fx(caster,"bof\\Saber-28.mdx",tx,ty,25.,0.,.75,1.5)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'SuD1',false)
set t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call TimerStart(t,.5,false,function Sui_D_Swap)
set t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call TimerStart(t,12.,false,function Sui_D_End)
call Sui_Glow(tx,ty,800.)
set m=null
set t=null
endfunction
// ----- D2 «Mirror Shift»: героиня выходит из зеркала и режет туда, куда оно смотрит: рывок на 1200 за
// 0.4 c (каждого раз, 60, стан 1 c), в конце удар по области 500 (80, стан 3 c) -----
function Sui_D2_Tick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit hr=LoadUnitHandle(HH,id,0)
local real ang=LoadReal(HH,id,1)
local integer tk=LoadInteger(HH,id,2)+1
local real x
local real y
local real z
local real a2
local integer k
local group g
local unit e
call SaveInteger(HH,id,2,tk)
if Bof_RevEnd(hr) then
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
set t=null
set hr=null
return
endif
call SetUnitInvulnerable(hr,true)
call PauseUnit(hr,true)
if tk==1 then
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(hr),'eBLP',GetUnitX(hr),GetUnitY(hr),ang)
call Bof_DzSetUnitModel(bj_lastCreatedUnit,"bof\\Mercury Lamp-35.mdx")
call SetUnitScale(bj_lastCreatedUnit,2.,1.,1.)
call SetUnitFlyHeight(bj_lastCreatedUnit,GetUnitFlyHeight(hr),0.)
call UnitApplyTimedLife(bj_lastCreatedUnit,'BHwe',5.)
call Rem_Fx(hr,"bof\\Mercury Lamp-39.mdx",LoadReal(HH,id,3),LoadReal(HH,id,4),150.,0.,1.5,0.)
call SetUnitPosition(hr,LoadReal(HH,id,3),LoadReal(HH,id,4))
call SetUnitFacing(hr,ang)
set x=GetUnitX(hr)
set y=GetUnitY(hr)
set z=GetUnitFlyHeight(hr)
call Rem_Fx(hr,"bof\\Saber-15.mdx",x,y,250.,ang,1.,0.)
call Rem_Fx(hr,"bof\\Saber-17.mdx",x,y,z+250.,ang,1.5,0.)
call Rem_Fx(hr,"bof\\Tsubaki-37.mdx",x,y,z+200.,ang,4.,0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,90.)
call SetUnitTimeScale(hr,.75)
call SetUnitAnimationByIndex(hr,7)
call Bof_Glide(hr,ang,1200.,.4)
endif
if tk<=20 then
if ModuloInteger(tk,4)==0 then
call SaveInteger(HH,id,5,LoadInteger(HH,id,5)+1)
call Sui_DashFx(hr,LoadInteger(HH,id,5),ang)
endif
set g=CreateGroup()
call GroupEnumUnitsInRange(g,GetUnitX(hr),GetUnitY(hr),300.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(hr),e) and GetUnitAbilityLevel(e,'Avul')==0 and not LoadBoolean(HH,id,GetHandleId(e)) then
call SaveBoolean(HH,id,GetHandleId(e),true)
call Bof_Dmg(hr,e,I2R(Sui_Agi_D2(hr,true))*60.*.001)
call Bof_Ctrl(hr,e,1.,"stun")
endif
endloop
call DestroyGroup(g)
endif
if tk>=20 then
set x=GetUnitX(hr)
set y=GetUnitY(hr)
set z=GetUnitFlyHeight(hr)
call SetUnitInvulnerable(hr,false)
call PauseUnit(hr,false)
call Sui_Slash(hr,'eBMD',x,y,ang,6.5,9,z+100.,"bof\\Mercury Lamp-28.mdx")
set a2=ang+45.
set k=1
loop
exitwhen k>5
set a2=a2-15.
call Rem_Fx(hr,"bof\\Tsubaki-32.mdx",x,y,z+25.,a2+180.,2.,0.)
set k=k+1
endloop
call SetUnitTimeScale(hr,1.)
call Rem_Noise(GetOwningPlayer(hr),50.,.5)
set g=CreateGroup()
call GroupEnumUnitsInRange(g,x,y,500.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(hr),e) and GetUnitAbilityLevel(e,'Avul')==0 then
call Bof_Dmg(hr,e,I2R(Sui_Agi_D2(hr,true))*80.*.001)
call Bof_Ctrl(hr,e,3.,"stun")
endif
endloop
call DestroyGroup(g)
call Rem_Sound("bof\\war3mapImported\\Kirito-D-YX1.mp3",100)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set hr=null
set g=null
set e=null
endfunction
function Sui_D2_Act takes unit caster returns nothing
local unit m=Sui_Mirror(caster)
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real ang
local timer t
if m==null then
return
endif
set ang=GetUnitFacing(m)
call SaveBoolean(HH,GetHandleId(caster),SH_bofRevd,false)
call SetUnitAnimationByIndex(Sui_Ghost(caster,x,y,ang,1,2),12)
call Rem_Fx(caster,"bof\\Mercury Lamp-39.mdx",x,y,150.,0.,1.5,0.)
call Rem_Fx(caster,"bof\\Mercury Lamp-38.mdx",x,y,25.,0.,3.,0.)
call Rem_Fx(caster,"bof\\Mercury Lamp-37.mdx",x,y,600.,0.,3.,0.)
call Rem_Fx(caster,"bof\\Mercury Lamp-32.mdx",x,y,600.,ang,4.,0.)
call Rem_Fx(caster,"bof\\Saber-28.mdx",x,y,25.,0.,.75,1.5)
call Rem_Sound("bof\\war3mapImported\\Mercury Lamp-ZS1JN-YX1.mp3",100)
if GetRandomInt(1,2)==1 then
call Rem_Sound("bof\\war3mapImported\\Mercury Lamp-D2-YY1.mp3",100)
else
call Rem_Sound("bof\\war3mapImported\\Mercury Lamp-D2-YY2.mp3",100)
endif
call Sui_Glow(x,y,600.)
set t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call SaveReal(HH,GetHandleId(t),1,ang)
call SaveReal(HH,GetHandleId(t),3,GetUnitX(m))
call SaveReal(HH,GetHandleId(t),4,GetUnitY(m))
call TimerStart(t,.02,true,function Sui_D2_Tick)
set m=null
set t=null
endfunction
// ----- F «Black Feathers»: два пера по бокам линии на цель, через 0.8 c бросаются вперёд на 1600 под углом
// ±30° (каждого раз, 100, стан 3 c), потом лежат на земле; F -> F2 на 8 c -----
function Sui_F_Tick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit hr=LoadUnitHandle(HH,id,0)
local unit f=LoadUnitHandle(HH,id,1)
local real ang=LoadReal(HH,id,2)
local real fa=LoadReal(HH,id,3)
local integer tk=LoadInteger(HH,id,4)+1
local real x=GetUnitX(f)
local real y=GetUnitY(f)
local real z=GetUnitFlyHeight(f)
local integer k
local group g
local unit e
call SaveInteger(HH,id,4,tk)
if tk==40 then
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-Q-YX1.mp3",100)
call Rem_Noise(GetOwningPlayer(hr),35.,.4)
call Rem_Fx(hr,"bof\\Tsubaki-37.mdx",x,y,z+50.,fa,4.,0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,90.)
call Rem_Fx(hr,"bof\\Minato-31.mdx",x,y,z+50.,fa,3.,0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,90.)
call Rem_Fx(hr,"bof\\Saber-17.mdx",x,y,z+50.,fa,1.5,0.)
call Bof_Glide(f,fa,1600.,.6)
endif
if tk>40 and tk<70 then
set k=LoadInteger(HH,id,6)+1
call SaveInteger(HH,id,6,k)
if k==1 or ModuloInteger(k,12)==0 then
call Rem_Fx(hr,"bof\\Minato-23.mdx",x,y,20.,fa,1.,0.)
endif
set g=CreateGroup()
call GroupEnumUnitsInRange(g,x,y,280.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(hr),e) and GetUnitAbilityLevel(e,'Avul')==0 and not LoadBoolean(HH,id,GetHandleId(e)) then
call SaveBoolean(HH,id,GetHandleId(e),true)
call Bof_Dmg(hr,e,I2R(Sui_Agi_F(hr,true))*100.*.001)
call Bof_Ctrl(hr,e,3.,"stun")
call DestroyEffect(AddSpecialEffectTarget("bof\\hero_skeletonking_n2s_e_sta1r.mdx",e,"chest"))
call Rem_Fx(hr,"bof\\Minato-3.mdx",GetUnitX(e),GetUnitY(e),150.,ang,1.,0.)
call Rem_Sound("bof\\war3mapImported\\Minato-Q-YX2.mp3",110)
if GetWidgetLife(e)>.405 then
call SetUnitAnimation(e,"stand hit")
endif
endif
endloop
call DestroyGroup(g)
endif
if tk==50 and LoadInteger(HH,id,5)==1 then
call Rem_Fx(hr,"bof\\Mercury Lamp-23.mdx",x,y,20.,fa,1.5,0.)
endif
if tk>=70 then
call Sui_FAdd(hr,f)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set hr=null
set f=null
set g=null
set e=null
endfunction
function Sui_F_Act takes unit caster,real tx,real ty returns nothing
local real ang=Atan2BJ(ty-GetUnitY(caster),tx-GetUnitX(caster))
local real bx=GetUnitX(caster)+250.*CosBJ(ang)
local real by=GetUnitY(caster)+250.*SinBJ(ang)
local real side
local real fa
local real x
local real y
local integer k=1
local unit f
local timer t
call Bof_SwapStage(caster,'SuF1','SuF2',8.)
if GetRandomInt(1,2)==1 then
call Rem_Sound("bof\\war3mapImported\\Mercury Lamp-E-YY1.mp3",100)
else
call Rem_Sound("bof\\war3mapImported\\Mercury Lamp-E-YY2.mp3",100)
endif
loop
exitwhen k>2
if k==1 then
set side=ang+90.
set fa=ang-30.
else
set side=ang-90.
set fa=ang+30.
endif
set x=Bof_X(Bof_Zone(bx,by),bx+400.*CosBJ(side))
set y=Bof_Y(Bof_Zone(bx,by),by+400.*SinBJ(side))
set f=Sui_Feather(caster,x,y,fa,150.,1.5,12.)
call SetUnitVertexColor(f,255,255,255,0)
call Rem_FadeIn(f,5)
call Rem_Fx(caster,"bof\\Mercury Lamp-23.mdx",x,y,GetUnitFlyHeight(caster)+50.,0.,1.,0.)
call Bof_Glide(f,fa,200.,.8)
set t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call SaveUnitHandle(HH,GetHandleId(t),1,f)
call SaveReal(HH,GetHandleId(t),2,ang)
call SaveReal(HH,GetHandleId(t),3,fa)
call SaveInteger(HH,GetHandleId(t),5,k)
call TimerStart(t,.02,true,function Sui_F_Tick)
set k=k+1
endloop
set f=null
set t=null
endfunction
// ----- F2 «N-Field»: поле в точке на 2 c — каждые 0.2 c по области 600 урон (20) и стан 0.3 c -----
function Sui_F2_Fade takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit u=LoadUnitHandle(HH,GetHandleId(t),0)
call SetUnitVertexColor(u,255,255,255,255)
call SetUnitAnimation(u,"Death")
call FlushChildHashtable(HH,GetHandleId(t))
call DestroyTimer(t)
set t=null
set u=null
endfunction
function Sui_F2_Ring takes unit hr,real x,real y returns nothing
local integer k=1
local real a2
loop
exitwhen k>5
set a2=72.*I2R(k)
call Rem_Fx(hr,"bof\\Mercury Lamp-24.mdx",x+600.*CosBJ(a2),y+600.*SinBJ(a2),200.,a2,1.,0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,90.)
set k=k+1
endloop
endfunction
function Sui_F2_Tick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit hr=LoadUnitHandle(HH,id,0)
local real x=LoadReal(HH,id,1)
local real y=LoadReal(HH,id,2)
local integer tk=LoadInteger(HH,id,3)+1
local group g
local unit e
call SaveInteger(HH,id,3,tk)
if tk<=10 then
call Rem_Fx(hr,"bof\\Mercury Lamp-32.mdx",x,y,925.,0.,6.,0.)
call Sui_F2_Ring(hr,x,y)
set g=CreateGroup()
call GroupEnumUnitsInRange(g,x,y,600.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(hr),e) and GetUnitAbilityLevel(e,'Avul')==0 then
call Bof_Dmg(hr,e,I2R(Sui_Agi_F2(hr,true))*20.*.001)
call Bof_Ctrl(hr,e,.3,"stun")
endif
endloop
call DestroyGroup(g)
else
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set hr=null
set g=null
set e=null
endfunction
function Sui_F2_Act takes unit caster,real tx,real ty returns nothing
local real ang=Atan2BJ(ty-GetUnitY(caster),tx-GetUnitX(caster))
local unit u=CreateUnit(GetOwningPlayer(caster),'eBLP',tx,ty,ang)
local timer t
local integer k=1
local real a2
call Rem_Fx(caster,"bof\\Mercury Lamp-39.mdx",tx,ty,400.,ang,4.,2.)
call Rem_Fx(caster,"bof\\Mercury Lamp-37.mdx",tx,ty,800.,0.,3.,2.)
call Bof_DzSetUnitModel(u,"bof\\Mercury Lamp-35.mdx")
call SetUnitScale(u,6.,1.,1.)
call SetUnitFlyHeight(u,25.,0.)
call SetUnitVertexColor(u,255,255,255,178)
call UnitApplyTimedLife(u,'BHwe',3.)
set t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,u)
call TimerStart(t,2.,false,function Sui_F2_Fade)
loop
exitwhen k>5
set a2=72.*I2R(k)
call Rem_Fx(caster,"bof\\Mercury Lamp-39.mdx",tx+600.*CosBJ(a2),ty+600.*SinBJ(a2),400.,0.,2.,2.)
set k=k+1
endloop
call Sui_F2_Ring(caster,tx,ty)
call Rem_Sound("bof\\war3mapImported\\Mercury Lamp-ZS2-YX1.mp3",100)
if GetRandomInt(1,2)==1 then
call Rem_Sound("bof\\war3mapImported\\Mercury Lamp-ZS2JN-YY1.mp3",100)
else
call Rem_Sound("bof\\war3mapImported\\Mercury Lamp-ZS2JN-YY2.mp3",100)
endif
call Rem_Noise(GetOwningPlayer(caster),30.,2.)
set t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call SaveReal(HH,GetHandleId(t),1,tx)
call SaveReal(HH,GetHandleId(t),2,ty)
call TimerStart(t,.2,true,function Sui_F2_Tick)
call Bof_SwapBack(caster,'SuF1','SuF2')
set u=null
set t=null
endfunction
// ----- R «Black Feather Dragon»: перья в области 450 у точки становятся драконами — каждый сам находит
// ближайшего вражеского героя (не дальше 3000 от Суйгинто), летит по спирали, бьёт (50) и оглушает на 3 c
// (КД 25 всегда — стандарт карты, 4 окт); перьев нет — один большой дракон вперёд, взрыв по области 600 (200, стан 3 c) -----
function Sui_R_Boom takes unit hr,real x,real y,real ang returns nothing
call Rem_Fx(hr,"bof\\Madara-huitu-13.mdx",x,y,25.,0.,1.,0.)
call Rem_Fx(hr,"bof\\Mercury Lamp-24.mdx",x,y,GetUnitFlyHeight(hr)+50.,ang,2.5,0.)
call Rem_Sound("bof\\war3mapImported\\RemiliaScarlet-R-YX2.mp3",100)
call Rem_Noise(GetOwningPlayer(hr),80.,.8)
endfunction
function Sui_R_Trail takes unit hr,unit dg,real ang returns nothing
call Rem_Fx(hr,"bof\\Escanor-4.mdx",GetUnitX(dg),GetUnitY(dg),GetUnitFlyHeight(dg)+150.,ang,1.5,0.)
call Rem_Fx(hr,"bof\\Mercury Lamp-40.mdx",GetUnitX(dg),GetUnitY(dg),GetUnitFlyHeight(dg)+250.,ang,1.5,0.)
endfunction
// цель дракона: ближайший к перу вражеский герой в 3000, а если героев нет — ближайший любой враг в 3000
// (владелец 3 окт: «при нажатии на перья ничего не происходит» — героя рядом не было, дракон пропадал)
function Sui_R_Target takes unit hr,real x,real y returns unit
local group g=CreateGroup()
local unit e
local unit best=null
local real bd=999999.
local boolean bh=false
local real dd
call GroupEnumUnitsInRange(g,x,y,3000.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(hr),e) and GetUnitAbilityLevel(e,'Avul')==0 and GetWidgetLife(e)>.405 then
set dd=SRS(x,y,GetUnitX(e),GetUnitY(e))
if (IsUnitType(e,UNIT_TYPE_HERO) and not bh) or (IsUnitType(e,UNIT_TYPE_HERO)==bh and dd<bd) then
set best=e
set bd=dd
set bh=IsUnitType(e,UNIT_TYPE_HERO)
endif
endif
endloop
call DestroyGroup(g)
set g=null
set e=null
set bj_lastCreatedUnit=best
set best=null
return bj_lastCreatedUnit
endfunction
function Sui_R_Dragon takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit hr=LoadUnitHandle(HH,id,0)
local unit dg=LoadUnitHandle(HH,id,1)
local unit e=LoadUnitHandle(HH,id,2)
local integer tk=LoadInteger(HH,id,3)+1
local real off=LoadReal(HH,id,4)
local real dd=999999.
local real a2
call SaveInteger(HH,id,3,tk)
if e!=null then
set dd=SRS(GetUnitX(dg),GetUnitY(dg),GetUnitX(e),GetUnitY(e))
endif
if off<0. then
set off=RMinBJ(off+3.,0.)
call SaveReal(HH,id,4,off)
endif
if (e==null or GetWidgetLife(e)<=.405) and ModuloInteger(tk,10)==0 then
set e=Sui_R_Target(hr,GetUnitX(dg),GetUnitY(dg))
if e!=null and SRS(GetUnitX(dg),GetUnitY(dg),GetUnitX(e),GetUnitY(e))<=600. then
call SaveUnitHandle(HH,id,2,e)
set dd=SRS(GetUnitX(dg),GetUnitY(dg),GetUnitX(e),GetUnitY(e))
else
set e=null
endif
endif
if e==null and tk<=166 and GetUnitTypeId(dg)!=0 then
call Bof_Put(dg,GetUnitX(dg)+50.*CosBJ(GetUnitFacing(dg)),GetUnitY(dg)+50.*SinBJ(GetUnitFacing(dg)))
if ModuloInteger(tk,6)==0 then
call Sui_R_Trail(hr,dg,GetUnitFacing(dg))
endif
elseif e!=null and tk<=166 and dd>=100. and GetWidgetLife(e)>.405 and GetUnitTypeId(dg)!=0 then
set a2=Atan2BJ(GetUnitY(e)-GetUnitY(dg),GetUnitX(e)-GetUnitX(dg))+off
call SetUnitFacingTimed(dg,a2,0)
call Bof_Put(dg,GetUnitX(dg)+50.*CosBJ(a2),GetUnitY(dg)+50.*SinBJ(a2))
if ModuloInteger(tk,6)==0 then
call Sui_R_Trail(hr,dg,a2)
endif
else
if e!=null and GetUnitTypeId(dg)!=0 and dd<=120. and GetWidgetLife(e)>.405 then
call Sui_R_Boom(hr,GetUnitX(e),GetUnitY(e),GetUnitFacing(dg))
call Bof_Dmg(hr,e,I2R(Sui_Agi_R(hr,true))*50.*.001)
call Bof_Ctrl(hr,e,3.,"stun")
endif
call RemoveUnit(dg)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set hr=null
set dg=null
set e=null
endfunction
function Sui_R_Big takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit hr=LoadUnitHandle(HH,id,0)
local unit dg=LoadUnitHandle(HH,id,1)
local real ang=LoadReal(HH,id,2)
local integer tk=LoadInteger(HH,id,3)+1
local boolean hit=false
local real x
local real y
local group g
local unit e
call SaveInteger(HH,id,3,tk)
if tk<=100 then
call SetUnitFacingTimed(dg,ang,0)
call Bof_Put(dg,GetUnitX(dg)+50.*CosBJ(ang),GetUnitY(dg)+50.*SinBJ(ang))
if ModuloInteger(tk,6)==0 then
call Sui_R_Trail(hr,dg,ang)
endif
set g=CreateGroup()
call GroupEnumUnitsInRange(g,GetUnitX(dg),GetUnitY(dg),250.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(hr),e) and GetUnitAbilityLevel(e,'Avul')==0 then
set hit=true
endif
endloop
call DestroyGroup(g)
else
set hit=true
endif
if hit then
set x=GetUnitX(dg)
set y=GetUnitY(dg)
call Sui_R_Boom(hr,x,y,ang)
set g=CreateGroup()
call GroupEnumUnitsInRange(g,x,y,600.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(hr),e) and GetUnitAbilityLevel(e,'Avul')==0 then
call Bof_Dmg(hr,e,I2R(Sui_Agi_R(hr,true))*200.*.001)
call Bof_Ctrl(hr,e,3.,"stun")
endif
endloop
call DestroyGroup(g)
call RemoveUnit(dg)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set hr=null
set dg=null
set g=null
set e=null
endfunction
function Sui_R_Act takes unit caster,real tx,real ty returns nothing
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real z=GetUnitFlyHeight(caster)
local real ang=Atan2BJ(ty-y,tx-x)
local integer cnt=Sui_FClean(caster)
local integer i=0
local integer k
local integer used=0
local unit f
local unit dg
local unit e
local real fx
local real fy
local real fa
local real a2
local timer t
if GetRandomInt(1,2)==1 then
call Rem_Sound("bof\\war3mapImported\\Mercury Lamp-R-YY1.mp3",100)
else
call Rem_Sound("bof\\war3mapImported\\Mercury Lamp-R-YY2.mp3",100)
endif
call Rem_Sound("bof\\war3mapImported\\Aizen-G-YX1.mp3",100)
loop
exitwhen i>=cnt
set f=LoadUnitHandle(HH,GetHandleId(caster),SH_SuiF+i)
if SRS(GetUnitX(f),GetUnitY(f),tx,ty)<=450. then
set used=used+1
set fx=GetUnitX(f)
set fy=GetUnitY(f)
set fa=GetUnitFacing(f)
call Rem_Fx(caster,"bof\\Mercury Lamp-39.mdx",fx,fy,400.,ang,2.,2.)
call Rem_Fx(caster,"bof\\Mercury Lamp-27.mdx",fx,fy,400.,ang,2.,0.)
set a2=fa+45.
set k=1
loop
exitwhen k>5
set a2=a2-15.
call Rem_Fx(caster,"bof\\Tsubaki-32.mdx",fx,fy,z+25.,a2,2.,0.)
set k=k+1
endloop
call RemoveUnit(f)
set dg=CreateUnit(GetOwningPlayer(caster),'eBLP',fx,fy,fa)
call SetUnitPathing(dg,false)
call Bof_DzSetUnitModel(dg,"bof\\Mercury Lamp-6.mdx")
call SetUnitScale(dg,1.5,1.,1.)
call UnitApplyTimedLife(dg,'BHwe',5.)
call Rem_Fx(caster,"bof\\Mercury Lamp-22.mdx",fx,fy,z+50.,fa,1.,0.)
call Rem_Fx(caster,"bof\\Mercury Lamp-27.mdx",fx,fy,z+50.,fa,1.,0.)
set e=Sui_R_Target(caster,fx,fy)
set t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call SaveUnitHandle(HH,GetHandleId(t),1,dg)
call SaveUnitHandle(HH,GetHandleId(t),2,e)
call SaveReal(HH,GetHandleId(t),4,-90.)
call TimerStart(t,.03,true,function Sui_R_Dragon)
endif
set i=i+1
endloop
call Sui_FClean(caster)
if used>0 then
call Rem_Fx(caster,"bof\\Mercury Lamp-23.mdx",x,y,z+50.,ang,1.,0.)
call Rem_Fx(caster,"bof\\Mercury Lamp-22.mdx",x,y,z+50.,ang,1.,0.)
call Rem_Fx(caster,"bof\\Mercury Lamp-27.mdx",x,y,z+50.,ang,1.,0.)
else
set dg=CreateUnit(GetOwningPlayer(caster),'eBLP',x,y,ang)
call SetUnitPathing(dg,false)
call Bof_DzSetUnitModel(dg,"bof\\Mercury Lamp-6.mdx")
call SetUnitScale(dg,1.5,1.,1.)
call UnitApplyTimedLife(dg,'BHwe',5.)
call Rem_Fx(caster,"bof\\Mercury Lamp-22.mdx",x,y,z+50.,ang,1.,0.)
call Rem_Fx(caster,"bof\\Mercury Lamp-27.mdx",x,y,z+50.,ang,1.,0.)
set t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call SaveUnitHandle(HH,GetHandleId(t),1,dg)
call SaveReal(HH,GetHandleId(t),2,ang)
call TimerStart(t,.03,true,function Sui_R_Big)
endif
set f=null
set dg=null
set e=null
set t=null
endfunction
// ----- T «Feather Recall»: все перья летят к Суйгинто (каждого раз, 25, стан 2 c); долетевшее перо даёт
// щит 6% максимума здоровья на 12 c — пока в нём есть запас, удар гасится целиком -----
function Sui_ShieldAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit hr=LoadUnitHandle(HH,GetHandleId(t),0)
local integer id=GetHandleId(hr)
local real el=LoadReal(HH,id,SH_SuiShieldT)+.03
call SaveReal(HH,id,SH_SuiShieldT,el)
if GetWidgetLife(hr)<1. or el>=LoadReal(HH,id,SH_SuiShieldDur) or LoadReal(HH,id,SH_SuiShield)<=0. then
call SaveReal(HH,id,SH_SuiShield,0.)
call SaveReal(HH,id,SH_SuiShieldT,0.)
call SaveReal(HH,id,SH_SuiShieldDur,0.)
call SaveBoolean(HH,id,SH_SuiShieldRun,false)
call FlushChildHashtable(HH,GetHandleId(t))
call DestroyTimer(t)
endif
set t=null
set hr=null
endfunction
function Sui_ShieldAdd takes unit hr returns nothing
local integer id=GetHandleId(hr)
local timer t
call SaveReal(HH,id,SH_SuiShield,LoadReal(HH,id,SH_SuiShield)+GetUnitState(hr,UNIT_STATE_MAX_LIFE)*.06)
call SaveReal(HH,id,SH_SuiShieldT,0.)
call SaveReal(HH,id,SH_SuiShieldDur,12.)
if not LoadBoolean(HH,id,SH_SuiShieldRun) then
call SaveBoolean(HH,id,SH_SuiShieldRun,true)
set t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,hr)
call TimerStart(t,.03,true,function Sui_ShieldAct)
endif
set t=null
endfunction
// крючок урона 3.2: пока в щите есть запас, удар гасится целиком (запас уменьшается на удар)
function Sui_ShieldTake takes unit u,unit src,real dmg returns boolean
local real sh=LoadReal(HH,GetHandleId(u),SH_SuiShield)
if sh<=0. then
return false
endif
call SaveReal(HH,GetHandleId(u),SH_SuiShield,RMaxBJ(sh-dmg,0.))
call ShieldIndicatorFunction(src,u,RMinBJ(dmg,sh))
return true
endfunction
function Sui_T_Fly takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit hr=LoadUnitHandle(HH,id,0)
local unit f=LoadUnitHandle(HH,id,1)
local integer tk=LoadInteger(HH,id,2)+1
local real dd=SRS(GetUnitX(hr),GetUnitY(hr),GetUnitX(f),GetUnitY(f))
local real a2=Atan2BJ(GetUnitY(f)-GetUnitY(hr),GetUnitX(f)-GetUnitX(hr))+180.
local real x
local real y
local group g
local unit e
call SaveInteger(HH,id,2,tk)
if tk<=166 and dd>=100. and GetUnitTypeId(f)!=0 then
set x=GetUnitX(f)+80.*CosBJ(a2)
set y=GetUnitY(f)+80.*SinBJ(a2)
call SetUnitFacingTimed(f,a2,0)
call Bof_Put(f,x,y)
if ModuloInteger(tk,10)==0 then
call Rem_Fx(hr,"bof\\Minato-23.mdx",x,y,GetUnitFlyHeight(hr)+50.,a2,1.,0.)
endif
set g=CreateGroup()
call GroupEnumUnitsInRange(g,GetUnitX(f),GetUnitY(f),280.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(hr),e) and GetUnitAbilityLevel(e,'Avul')==0 and not LoadBoolean(HH,id,GetHandleId(e)) then
call SaveBoolean(HH,id,GetHandleId(e),true)
call Bof_Dmg(hr,e,I2R(Sui_Agi_T(hr,true))*25.*.001)
call Bof_Ctrl(hr,e,2.,"stun")
call DestroyEffect(AddSpecialEffectTarget("bof\\hero_skeletonking_n2s_e_sta1r.mdx",e,"chest"))
call Rem_Fx(hr,"bof\\Minato-3.mdx",GetUnitX(e),GetUnitY(e),150.,a2,1.,0.)
call Rem_Sound("bof\\war3mapImported\\Minato-Q-YX2.mp3",110)
if GetWidgetLife(e)>.405 then
call SetUnitAnimation(e,"stand hit")
endif
endif
endloop
call DestroyGroup(g)
else
if GetUnitTypeId(f)!=0 and GetWidgetLife(f)>.405 then
if dd<=120. then
call Rem_Fx(hr,"bof\\Mercury Lamp-22.mdx",GetUnitX(hr),GetUnitY(hr),GetUnitFlyHeight(hr)+50.,a2,1.,0.)
endif
call Sui_ShieldAdd(hr)
endif
call KillUnit(f)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set hr=null
set f=null
set g=null
set e=null
endfunction
function Sui_T_Act takes unit caster returns nothing
local integer cnt=Sui_FClean(caster)
local integer i=0
local unit f
local real x
local real y
local real a2
local timer t
if cnt==0 then
return
endif
call Rem_Sound("bof\\war3mapImported\\Mercury Lamp-ZS1JN-YX1.mp3",100)
call Rem_Sound("bof\\war3mapImported\\Mercury Lamp-T-YY1.mp3",100)
loop
exitwhen i>=cnt
set f=LoadUnitHandle(HH,GetHandleId(caster),SH_SuiF+i)
set x=GetUnitX(f)
set y=GetUnitY(f)
set a2=Atan2BJ(y-GetUnitY(caster),x-GetUnitX(caster))+180.
call Rem_Fx(caster,"bof\\Mercury Lamp-23.mdx",x,y,GetUnitFlyHeight(caster)+50.,a2,1.,0.)
call Rem_Fx(caster,"bof\\Tsubaki-37.mdx",x,y,GetUnitFlyHeight(f)+50.,a2,4.,0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,90.)
call Rem_Fx(caster,"bof\\Minato-31.mdx",x,y,GetUnitFlyHeight(f)+50.,a2,3.,0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,90.)
call SetUnitFacing(f,a2)
set t=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call SaveUnitHandle(HH,GetHandleId(t),1,f)
call TimerStart(t,.02,true,function Sui_T_Fly)
set i=i+1
endloop
// перья ушли к героине — список пуст (долетевшие гибнут в Sui_T_Fly)
call SaveInteger(HH,GetHandleId(caster),SH_SuiFCnt,0)
set f=null
set t=null
endfunction
// ----- G «Final Wings»: 3.8 c в воздухе, неуязвима; с 1 c — крылья, с 1.2 c — раз в 0.6 c цепь (по области
// 350 урон 20, стан 1.2 c, и 4 c сковывает всех в 350 у точки G) и ливень перьев раз в 0.04 c (по 220 урон 10) -----
function Sui_G_LightOff takes nothing returns nothing
local timer t=GetExpiredTimer()
call DestroyLightning(LoadLightningHandle(HH,GetHandleId(t),0))
call FlushChildHashtable(HH,GetHandleId(t))
call DestroyTimer(t)
set t=null
endfunction
function Sui_G_Unfreeze takes nothing returns nothing
call PauseUnit(GetEnumUnit(),false)
call SetUnitTimeScale(GetEnumUnit(),1.)
call SetUnitPathing(GetEnumUnit(),true)
endfunction
function Sui_G_Freeze takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit hr=LoadUnitHandle(HH,id,0)
local group fr=LoadGroupHandle(HH,id,1)
local integer tk=LoadInteger(HH,id,4)+1
local group g
local unit e
call SaveInteger(HH,id,4,tk)
if tk<=80 then
set g=CreateGroup()
call GroupEnumUnitsInRange(g,LoadReal(HH,id,2),LoadReal(HH,id,3),350.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(hr),e) and GetUnitAbilityLevel(e,'Avul')==0 and not Bof_Rev(hr,e) then
call GroupAddUnit(fr,e)
call SetUnitTimeScale(e,0.)
call PauseUnit(e,true)
call SetUnitPathing(e,false)
endif
endloop
call DestroyGroup(g)
else
call ForGroup(fr,function Sui_G_Unfreeze)
call DestroyGroup(fr)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set hr=null
set fr=null
set g=null
set e=null
endfunction
function Sui_G_Chain takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit hr=LoadUnitHandle(HH,id,0)
local unit dg=LoadUnitHandle(HH,id,1)
local real ang=LoadReal(HH,id,2)
local integer tk=LoadInteger(HH,id,3)+1
local real zz=LoadReal(HH,id,4)-LoadReal(HH,id,5)
local real x
local real y
local group g
local unit e
local timer t2
call SaveInteger(HH,id,3,tk)
if tk<=20 then
call SaveReal(HH,id,4,zz)
call SetUnitFlyHeight(dg,zz,1000000000.)
call MoveLightningEx(LoadLightningHandle(HH,id,6),false,LoadReal(HH,id,7),LoadReal(HH,id,8),LoadReal(HH,id,9),GetUnitX(dg),GetUnitY(dg),zz)
else
set x=GetUnitX(dg)
set y=GetUnitY(dg)
call SetUnitFlyHeight(dg,0.,1000000000.)
set t2=CreateTimer()
call SaveLightningHandle(HH,GetHandleId(t2),0,LoadLightningHandle(HH,id,6))
call TimerStart(t2,4.,false,function Sui_G_LightOff)
call Rem_Fx(hr,"bof\\Madara-huitu-19.mdx",x,y,25.,ang,2.5,0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,30.)
call Rem_Fx(hr,"bof\\Madara-huitu-23.mdx",x,y,25.,0.,1.,0.)
call Rem_Fx(hr,"bof\\shanshan-1.mdx",x,y,0.,GetRandomDirectionDeg(),.5,4.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,90.)
set g=CreateGroup()
call GroupEnumUnitsInRange(g,x,y,350.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(hr),e) and GetUnitAbilityLevel(e,'Avul')==0 then
call Bof_DmgFull(hr,e,I2R(Sui_Agi_G(hr,true))*40.*.001)
call Bof_Ctrl(hr,e,1.2,"stun")
endif
endloop
call DestroyGroup(g)
set t2=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(t2),0,hr)
call SaveGroupHandle(HH,GetHandleId(t2),1,CreateGroup())
call SaveReal(HH,GetHandleId(t2),2,LoadReal(HH,id,10))
call SaveReal(HH,GetHandleId(t2),3,LoadReal(HH,id,11))
call TimerStart(t2,.05,true,function Sui_G_Freeze)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set t2=null
set hr=null
set dg=null
set g=null
set e=null
endfunction
function Sui_G_Rain takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit hr=LoadUnitHandle(HH,id,0)
local unit dg=LoadUnitHandle(HH,id,1)
local real ang=LoadReal(HH,id,2)
local integer tk=LoadInteger(HH,id,3)+1
local real zz=LoadReal(HH,id,4)-LoadReal(HH,id,5)
local real x
local real y
local group g
local unit e
call SaveInteger(HH,id,3,tk)
if tk<=20 then
call SaveReal(HH,id,4,zz)
call SetUnitFlyHeight(dg,zz,1000000000.)
else
set x=GetUnitX(dg)
set y=GetUnitY(dg)
set g=CreateGroup()
call GroupEnumUnitsInRange(g,x,y,220.,null)
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
if Condition_Base(GetOwningPlayer(hr),e) and GetUnitAbilityLevel(e,'Avul')==0 then
call Bof_DmgFull(hr,e,I2R(Sui_Agi_G(hr,true))*20.*.001)
endif
endloop
call DestroyGroup(g)
call Rem_Fx(hr,"bof\\Mercury Lamp-26.mdx",x,y,100.,ang,1.5,0.)
call RemoveUnit(dg)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set hr=null
set dg=null
set g=null
set e=null
endfunction
// перо (цепь или ливень) за спиной Суйгинто: летит к точке G на расстояние до неё + до 600, снижаясь
function Sui_G_Drop takes integer id,unit hr,boolean chain returns nothing
local real ang=LoadReal(HH,id,1)
local real x=GetUnitX(hr)+200.*CosBJ(ang+180.)+GetRandomReal(-400.,400.)*CosBJ(ang+90.)
local real y=GetUnitY(hr)+200.*SinBJ(ang+180.)+GetRandomReal(-400.,400.)*SinBJ(ang+90.)
local real zz=GetUnitFlyHeight(hr)+GetRandomReal(-200.,600.)
local unit dg
local unit an
local timer t=CreateTimer()
set x=Bof_X(Bof_Zone(GetUnitX(hr),GetUnitY(hr)),x)
set y=Bof_Y(Bof_Zone(GetUnitX(hr),GetUnitY(hr)),y)
set dg=CreateUnit(GetOwningPlayer(hr),'eBLT',x,y,ang)
call SetUnitPathing(dg,false)
call SetUnitScale(dg,1.5,1.,1.)
call SetUnitAnimationByIndex(dg,20)
call SetUnitFlyHeight(dg,zz,0.)
call SaveUnitHandle(HH,GetHandleId(t),0,hr)
call SaveUnitHandle(HH,GetHandleId(t),1,dg)
call SaveReal(HH,GetHandleId(t),2,ang)
call SaveReal(HH,GetHandleId(t),4,zz)
call SaveReal(HH,GetHandleId(t),5,zz/20.)
if chain then
call Rem_Fx(hr,"bof\\Tsubaki-33.mdx",x,y,zz,ang,1.,0.)
call SetSpecialEffectPitch(bj_lastCreatedEffect,90.)
call UnitApplyTimedLife(dg,'BHwe',5.)
set an=CreateUnit(GetOwningPlayer(hr),'eBLT',x,y,ang)
call SetUnitScale(an,1.5,1.,1.)
call SetUnitFlyHeight(an,zz,0.)
call UnitApplyTimedLife(an,'BHwe',5.)
set bj_lastCreatedLightning=AddLightningEx("ZRLI",false,x,y,zz,x,y,zz)
call SetLightningColor(bj_lastCreatedLightning,1.,1.,1.,1.)
call SaveLightningHandle(HH,GetHandleId(t),6,bj_lastCreatedLightning)
call SaveReal(HH,GetHandleId(t),7,x)
call SaveReal(HH,GetHandleId(t),8,y)
call SaveReal(HH,GetHandleId(t),9,zz)
call SaveReal(HH,GetHandleId(t),10,LoadReal(HH,id,3))
call SaveReal(HH,GetHandleId(t),11,LoadReal(HH,id,4))
call TimerStart(t,.02,true,function Sui_G_Chain)
else
call Bof_DzSetUnitModel(dg,"bof\\Mercury Lamp-29.mdx")
call UnitApplyTimedLife(dg,'BHwe',2.)
call TimerStart(t,.02,true,function Sui_G_Rain)
endif
call Bof_Glide(dg,ang,LoadReal(HH,id,2)+GetRandomReal(0.,600.),.4)
set dg=null
set an=null
set t=null
endfunction
function Sui_G_Tick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit hr=LoadUnitHandle(HH,id,0)
local real ang=LoadReal(HH,id,1)
local integer tk=LoadInteger(HH,id,5)+1
local real x
local real y
local real z=GetUnitFlyHeight(hr)
local unit w
call SaveInteger(HH,id,5,tk)
if Bof_RevEnd(hr) then
call SetUnitAnimation(LoadUnitHandle(HH,id,6),"Death")
call SetUnitAnimation(LoadUnitHandle(HH,id,7),"Death")
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
set t=null
set hr=null
return
endif
call SetUnitInvulnerable(hr,true)
call PauseUnit(hr,true)
if tk>1 and tk<190 and ModuloInteger(tk-1,15)==0 then
call DestroyEffect(AddSpecialEffectTarget("bof\\Mercury Lamp-2.mdx",hr,"chest"))
endif
if tk==50 then
call Rem_Sound("bof\\war3mapImported\\Mercury Lamp-G-YX1.mp3",100)
set x=GetUnitX(hr)+200.*CosBJ(ang+180.)
set y=GetUnitY(hr)+200.*SinBJ(ang+180.)
set w=CreateUnit(GetOwningPlayer(hr),'eBLU',x,y,ang)
call Bof_DzSetUnitModel(w,"bof\\Mercury Lamp-35.mdx")
call SetUnitScale(w,4.,1.,1.)
call SetUnitFlyHeight(w,z+150.,0.)
call UnitApplyTimedLife(w,'BHwe',5.)
call SaveUnitHandle(HH,id,6,w)
set w=CreateUnit(GetOwningPlayer(hr),'eBLU',x,y,ang+180.)
call Bof_DzSetUnitModel(w,"bof\\Mercury Lamp-35.mdx")
call SetUnitScale(w,4.,1.,1.)
call SetUnitFlyHeight(w,z+150.,0.)
call UnitApplyTimedLife(w,'BHwe',5.)
call SaveUnitHandle(HH,id,7,w)
endif
if tk==60 then
call Rem_Noise(GetOwningPlayer(hr),40.,2.9)
endif
if tk>=60 and tk<190 then
if ModuloInteger(tk-60,30)==0 then
call Sui_G_Drop(id,hr,true)
endif
if ModuloInteger(tk-60,2)==0 then
call Sui_G_Drop(id,hr,false)
endif
endif
if tk>=190 then
call SetUnitInvulnerable(hr,false)
call PauseUnit(hr,false)
call SetUnitAnimation(LoadUnitHandle(HH,id,6),"Death")
call SetUnitAnimation(LoadUnitHandle(HH,id,7),"Death")
call SetUnitTimeScale(hr,1.)
call SetUnitAnimationByIndex(hr,4)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
set hr=null
set w=null
endfunction
function Sui_G_Act takes unit caster,real tx,real ty returns nothing
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real z=GetUnitFlyHeight(caster)
local real ang=Atan2BJ(ty-y,tx-x)
local timer t=CreateTimer()
call SaveBoolean(HH,GetHandleId(caster),SH_bofRevd,false)
call Sui_Anim(caster,.5,4)
call Rem_Fx(caster,"bof\\Saber-28.mdx",x,y,25.,0.,2.5,3.8)
call Rem_Fx(caster,"bof\\Mercury Lamp-23.mdx",x,y,z+50.,ang,1.,0.)
call Rem_Fx(caster,"bof\\Mercury Lamp-22.mdx",x,y,z+50.,ang,1.,0.)
call Rem_Fx(caster,"bof\\Mercury Lamp-27.mdx",x,y,z+50.,ang,1.,0.)
call Rem_Fx(caster,"bof\\Minato-31.mdx",x,y,z+50.,ang,6.,0.)
call Rem_Sound("bof\\war3mapImported\\Mercury Lamp-G-YX2.mp3",100)
call Rem_Noise(GetOwningPlayer(caster),50.,.5)
if GetRandomInt(1,2)==1 then
call Rem_Sound("bof\\war3mapImported\\Mercury Lamp-G-YY1.mp3",100)
else
call Rem_Sound("bof\\war3mapImported\\Mercury Lamp-G-YY2.mp3",100)
endif
call SaveUnitHandle(HH,GetHandleId(t),0,caster)
call SaveReal(HH,GetHandleId(t),1,ang)
call SaveReal(HH,GetHandleId(t),2,SRS(x,y,tx,ty))
call SaveReal(HH,GetHandleId(t),3,tx)
call SaveReal(HH,GetHandleId(t),4,ty)
call TimerStart(t,.02,true,function Sui_G_Tick)
set t=null
endfunction
// ----- атака: дополнительно 0.15*ЛОВ (20) и вспышка -----
function Sui_Attack_Act takes unit c,unit u returns nothing
local real ang=Atan2BJ(GetUnitY(u)-GetUnitY(c),GetUnitX(u)-GetUnitX(c))
call Bof_Dmg(c,u,I2R(Sui_Agi_atk(c,true))*20.*.001)
call Rem_Fx(c,"bof\\Mercury Lamp-28.mdx",GetUnitX(c),GetUnitY(c),150.,ang+180.,3.5,0.)
call DestroyEffect(AddSpecialEffectTarget("bof\\hero_skeletonking_n2s_e_sta1r.mdx",u,"chest"))
call Rem_Fx(c,"bof\\Minato-3.mdx",GetUnitX(u),GetUnitY(u),150.,ang+180.,1.,0.)
call Rem_Sound("bof\\war3mapImported\\Kirito-D-YX1.mp3",100)
endfunction
// ----- поворот зеркала: приказ атаки в точку (A + клик) поворачивает зеркало туда -----
function Sui_MirrorOrder_Cond takes nothing returns boolean
return GetIssuedOrderIdBJ()==851983 and GetUnitTypeId(GetTriggerUnit())=='HSui' and Sui_Mirror(GetTriggerUnit())!=null
endfunction
function Sui_MirrorOrder takes nothing returns nothing
local unit m=Sui_Mirror(GetTriggerUnit())
call SetUnitFacingTimed(m,Atan2BJ(GetOrderPointY()-GetUnitY(m),GetOrderPointX()-GetUnitX(m)),0)
set m=null
endfunction
// один триггер приказов на карту (из main)
function Sui_Init takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddCondition(t,Condition(function Sui_MirrorOrder_Cond))
call TriggerAddAction(t,function Sui_MirrorOrder)
set t=null
endfunction
//Suigintou1end
//Escanor1start
// сила для урона кнопки D: урон bof x (0.033);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Esc_Str_D takes unit u,boolean b returns integer
return R2I(I2R(GetHeroStr(u,b))*(0.033)*1000.+0.5)
endfunction
// сила для урона кнопки E: урон bof x (0.015 + 0.005 x уровень);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Esc_Str_E takes unit u,boolean b returns integer
return R2I(I2R(GetHeroStr(u,b))*(0.015+0.005*I2R(GetUnitAbilityLevel(u,'EsE1')))*1000.+0.5)
endfunction
// сила для урона кнопки F: урон bof x (0.03);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Esc_Str_F takes unit u,boolean b returns integer
return R2I(I2R(GetHeroStr(u,b))*(0.03)*1000.+0.5)
endfunction
// сила для урона кнопки G: урон bof x (0.025);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Esc_Str_G takes unit u,boolean b returns integer
return R2I(I2R(GetHeroStr(u,b))*(0.025)*1000.+0.5)
endfunction
// сила для урона кнопки Q: урон bof x (0.01875 + 0.00625 x уровень);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Esc_Str_Q takes unit u,boolean b returns integer
return R2I(I2R(GetHeroStr(u,b))*(0.01875+0.00625*I2R(GetUnitAbilityLevel(u,'EsQ1')))*1000.+0.5)
endfunction
// сила для урона кнопки W: урон bof x (0.015 + 0.005 x уровень);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Esc_Str_W takes unit u,boolean b returns integer
return R2I(I2R(GetHeroStr(u,b))*(0.015+0.005*I2R(GetUnitAbilityLevel(u,'EsW1')))*1000.+0.5)
endfunction
// сила для урона кнопки atk: урон bof x (0.0125);
// x1000, чтобы не терять дробь в целом (в Bof_Dmg урон делится обратно на 1000)
function Esc_Str_atk takes unit u,boolean b returns integer
return R2I(I2R(GetHeroStr(u,b))*(0.0125)*1000.+0.5)
endfunction
// ===== Эсканор: своё вместо общего кода bof (до функций героя) =====
// Сила солнца. bof ставил СИЛУ = 511 + бонус (511 — их базовая сила героя), у нас это
// сломало бы рост силы по уровням. Бонус считаем долей от нашей базовой силы: в полдень
// у bof +500 к 511, то есть почти вдвое, — у нас так же (множитель 1.0 ниже).
function Esc_SunStr takes unit u,real x returns nothing
local integer cur=LoadInteger(bof_HT,GetHandleId(u),SH_bofBonus+6)
local integer base=GetHeroStr(u,false)-cur
call Bof_xa(u,6,2,R2I(I2R(base)*x/511.*1.0))
endfunction
// Свои часы Эсканора. В 3.2 время суток заморожено на полдне, поэтому у героя свой цикл:
// сутки за 240 сек (0.01 часа на тик солнца 0.1 сек). Время карты не трогаем.
// Всё, что у bof читало GetTimeOfDay() и ставило SetTimeOfDay(), идёт через эти функции.
function Esc_Time takes unit u returns real
return LoadReal(bof_HT,GetHandleId(u),SH_EscClock)
endfunction
function Esc_SetClock takes unit u,real hour,boolean freeze returns nothing
call SaveReal(bof_HT,GetHandleId(u),SH_EscClock,hour)
call SaveBoolean(bof_HT,GetHandleId(u),SH_EscClockFrozen,freeze)
endfunction
// Окошко со временем — лидерборд, как у Буу (Кушу) и Кимимару: только текст, видит только владелец.
// Днём золотое, ночью голубое. Хранится на игроке, а не на юните: при перевыборе героя юнит
// пропадает, и окно убирает тик солнца (Esc_BoardKill).
function Esc_PanelInit takes unit u returns nothing
local player escP=GetOwningPlayer(u)
if LoadLeaderboardHandle(bof_HT,GetHandleId(escP),SH_EscBoard)==null then
call SaveLeaderboardHandle(bof_HT,GetHandleId(escP),SH_EscBoard,CreateLeaderboardBJ(bj_FORCE_PLAYER[GetPlayerId(escP)],"Время: 6:00"))
endif
set escP=null
endfunction
function Esc_BoardKill takes player p returns nothing
local leaderboard escBd=LoadLeaderboardHandle(bof_HT,GetHandleId(p),SH_EscBoard)
if escBd!=null then
call LeaderboardDisplay(escBd,false)
call DestroyLeaderboard(escBd)
call RemoveSavedHandle(bof_HT,GetHandleId(p),SH_EscBoard)
endif
set escBd=null
endfunction
function Esc_PanelUpdate takes unit u,real hour returns nothing
local leaderboard escBd=LoadLeaderboardHandle(bof_HT,GetHandleId(GetOwningPlayer(u)),SH_EscBoard)
local integer escHH=R2I(hour)
local integer escMM=R2I((hour-I2R(escHH))*60.)
local string escTxt
if escBd==null then
return
endif
if hour>=6. and hour<18. then
set escTxt=Lng("|cffffcc00Время: ","|cffffcc00Time: ")
else
set escTxt=Lng("|cff78aaffВремя: ","|cff78aaffTime: ")
endif
set escTxt=escTxt+I2S(escHH)+":"
if escMM<10 then
set escTxt=escTxt+"0"
endif
call LeaderboardSetLabel(escBd,escTxt+I2S(escMM)+"|r")
set escBd=null
endfunction
// Бафф долями от наших статов: СИЛА +strK от базовой (без бонусов bof), здоровье +hpK от максимума.
// Числа bof (+600 СИЛЫ, +200000 здоровья) в их масштабе — база 511 СИЛЫ, ~352 тыс. здоровья;
// у нас сырыми это было +600% силы. Сколько дали — помним под ключом и снимаем ровно столько же.
function Esc_BuffOn takes unit u,string key,real strK,real hpK returns nothing
local integer escId=GetHandleId(u)
local integer escS=R2I(I2R(GetHeroStr(u,false)-LoadInteger(bof_HT,escId,SH_bofBonus+6))*strK)
local integer escH=R2I((GetUnitState(u,UNIT_STATE_MAX_LIFE)-I2R(LoadInteger(bof_HT,escId,SH_bofBonus)))*hpK)
call SaveInteger(bof_HT,escId,StringHash(key+"S"),escS)
call SaveInteger(bof_HT,escId,StringHash(key+"H"),escH)
call Bof_xa(u,6,0,escS)
call Bof_xa(u,0,0,escH)
endfunction
function Esc_BuffOff takes unit u,string key returns nothing
local integer escId=GetHandleId(u)
call Bof_xa(u,6,1,LoadInteger(bof_HT,escId,StringHash(key+"S")))
call Bof_xa(u,0,1,LoadInteger(bof_HT,escId,StringHash(key+"H")))
call SaveInteger(bof_HT,escId,StringHash(key+"S"),0)
call SaveInteger(bof_HT,escId,StringHash(key+"H"),0)
endfunction
// The One (решения владельца 27 сен): состояние на 15 c — бафф как у Sunshine до нерфа (+117% силы,
// +57% здоровья), каждые 0.25 c урон всем врагам рядом, жизнь догорает к концу, в конце — смерть.
// У bof этого не было — только текст подсказки; их взрывы по округе (Bof_CXb, ~5 c) остались как были.
// Солнце на время состояния замирает (флаг bof $DF127C78, как у Sunshine), иначе тик солнца
// каждые 0.1 c ставит бонус СИЛЫ заново и стирает бафф.
function Esc_TheOneTick takes nothing returns nothing
local timer escTm=GetExpiredTimer()
local integer escId=GetHandleId(escTm)
local unit escU=LoadUnitHandle(bof_HT,escId,0)
local integer escLeft=LoadInteger(bof_HT,escId,1)
local group escG
local unit escE
local real escLife
if escLeft<=0 or not IsUnitAliveBJ(escU) then
call Esc_BuffOff(escU,"EscOne")
if LoadBoolean(bof_HT,escId,2) then
call SaveBoolean(bof_M9,GetHandleId(escU),$DF127C78,false)
endif
// конец — смерть, как самоподрыв Дейдары (FDeidaraCast2): только во время раунда
if escLeft<=0 and IsUnitAliveBJ(escU) and udg_B then
call KillUnit(escU)
endif
call FlushChildHashtable(bof_HT,escId)
call DestroyTimer(escTm)
set escTm=null
set escU=null
return
endif
set escG=CreateGroup()
call GroupEnumUnitsInRange(escG,GetUnitX(escU),GetUnitY(escU),600.,null)
loop
set escE=FirstOfGroup(escG)
exitwhen escE==null
call GroupRemoveUnit(escG,escE)
if Condition_Base(GetOwningPlayer(escU),escE) and GetUnitAbilityLevel(escE,'Avul')==0 then
call Bof_Dmg(escU,escE,I2R(Esc_Str_G(escU,true))*6.*0.001)
endif
endloop
call DestroyGroup(escG)
// жизнь догорает ровно к концу: остаток делим на оставшиеся тики
set escLife=GetUnitState(escU,UNIT_STATE_LIFE)-GetUnitState(escU,UNIT_STATE_LIFE)/I2R(escLeft)
if escLife<1. then
set escLife=1.
endif
call SetUnitState(escU,UNIT_STATE_LIFE,escLife)
call SaveInteger(bof_HT,escId,1,escLeft-1)
set escTm=null
set escU=null
set escG=null
set escE=null
endfunction
function Esc_TheOneStart takes unit u returns nothing
local timer escTm=CreateTimer()
call SaveUnitHandle(bof_HT,GetHandleId(escTm),0,u)
call SaveInteger(bof_HT,GetHandleId(escTm),1,60)
// солнце замораживаем, только если его ещё не заморозил Sunshine — тогда и размораживаем сами
if not LoadBoolean(bof_M9,GetHandleId(u),$DF127C78) then
call SaveBoolean(bof_M9,GetHandleId(u),$DF127C78,true)
call SaveBoolean(bof_HT,GetHandleId(escTm),2,true)
endif
call Esc_BuffOn(u,"EscOne",600./511.,200000./352200.)
call TimerStart(escTm,.25,true,function Esc_TheOneTick)
set escTm=null
endfunction
// Sunshine (D) на 20 c: +80% силы и +40% здоровья (владелец 27 сен: сначала +117%/+57% как у bof —
// «уменьши ещё немного»; эти +117%/+57% теперь у The One).
function Esc_SunshineOn takes unit u returns nothing
call Esc_BuffOn(u,"EscSun",.8,.4)
endfunction
function Esc_SunshineOff takes unit u returns nothing
call Esc_BuffOff(u,"EscSun")
endfunction
// подсказка владельцу в ключевые часы — иначе не понять, когда жать G и T
function Esc_ClockTick takes unit u returns nothing
local integer clkId=GetHandleId(u)
local real clkOld=LoadReal(bof_HT,clkId,SH_EscClock)
local real clkNew=clkOld+0.01
if LoadBoolean(bof_HT,clkId,SH_EscClockFrozen) then
call Esc_PanelUpdate(u,clkOld)
return
endif
if clkNew>=24. then
set clkNew=clkNew-24.
endif
call SaveReal(bof_HT,clkId,SH_EscClock,clkNew)
call Esc_PanelUpdate(u,clkNew)
endfunction
function Bof_xk takes real Wr,location Ws,boolexpr Wt returns group
local group Ui=CreateGroup()
call GroupEnumUnitsInRangeOfLoc(Ui,Ws,Wr,Wt)
call DestroyBoolExpr(Wt)
set bof_Wu=Ui
set Ui=null
return bof_Wu
endfunction
function Bof_xw takes unit Uk,location U4,real U5 returns nothing
local location U6=GetUnitLoc(Uk)
call SetUnitFacingTimed(Uk,AngleBetweenPoints(U6,U4),U5)
call RemoveLocation(U6)
set U6=null
endfunction
function Bof_x5 takes unit Uk,integer Ul returns boolean
local integer O7=0
if Ul!=0 then
loop
if GetItemTypeId(UnitItemInSlot(Uk,O7))==Ul then
return true
endif
set O7=O7+1
exitwhen O7>=bj_MAX_INVENTORY
endloop
endif
return false
endfunction
function Bof_yt takes unit Uk,unit U4,real U5 returns nothing
local location U6=GetUnitLoc(U4)
call Bof_xw(Uk,U6,U5)
call RemoveLocation(U6)
set U6=null
endfunction
function Bof_z5 takes unit M2,integer UB returns nothing
local integer Wv=GetUnitAbilityLevel(M2,UB)
if Wv<=0 then
return
endif
call UnitRemoveAbility(M2,UB)
call UnitAddAbility(M2,UB)
call SetUnitAbilityLevel(M2,UB,Wv)
endfunction
function Bof_z6 takes nothing returns nothing
local integer VG=GetHandleId(GetExpiredTimer())
local unit M2=LoadUnitHandle(bof_I,VG,1)
local integer VF=GetHandleId(M2)
local real VH=LoadReal(bof_I,VF,-1)
local real VI=LoadReal(bof_I,VG,2)
local real VJ=LoadReal(bof_I,VG,3)
local real Up=LoadReal(bof_I,VG,4)
local real Uq=LoadReal(bof_I,VG,5)
local real OV=LoadReal(bof_I,VG,6)
local real VK=LoadReal(bof_I,VG,7)
local real VL=LoadReal(bof_I,VG,8)
local real VM=LoadReal(bof_I,VG,9)
local real VN=LoadReal(bof_I,VG,10)
local real VO=LoadReal(bof_I,VG,11)
local real VQ
local real VR
local real UI
local real VS
local real VP=GetUnitMoveSpeed(M2)
set OV=OV+.01
set VK=VK+.01
if VK>=VL then
set VK=0
set VM=VI
set VN=VJ
set VI=Up
set VJ=Uq
set Up=GetUnitX(M2)
set Uq=GetUnitY(M2)
set UI=SquareRoot(Pow(VI-Up,2)+Pow(VJ-Uq,2))
set VQ=Atan2(Uq-VJ,Up-VI)
set VR=Deg2Rad(GetUnitFacing(M2))
if Cos(VQ-VR)<.9 and UI>VP*.8*VL then
set VO=VO+1*VL
endif
if VO<=0 or VH<VP then
set VO=0
if UI<=550*VL and UI>VP*.8*VL then
set VS=VH*VL-UI
set Up=Up+VS*Cos(VQ)
set Uq=Uq+VS*Sin(VQ)
if RectContainsCoords(bj_mapInitialPlayableArea,Up,Uq) then
call SetUnitX(M2,Up)
call SetUnitY(M2,Uq)
endif
endif
else
set VO=VO-VL
endif
endif
call SaveUnitHandle(bof_I,VG,1,M2)
call SaveReal(bof_I,VG,2,VI)
call SaveReal(bof_I,VG,3,VJ)
call SaveReal(bof_I,VG,4,Up)
call SaveReal(bof_I,VG,5,Uq)
call SaveReal(bof_I,VG,6,OV)
call SaveReal(bof_I,VG,7,VK)
call SaveReal(bof_I,VG,8,VL)
call SaveReal(bof_I,VG,9,GetUnitX(M2))
call SaveReal(bof_I,VG,10,GetUnitY(M2))
call SaveReal(bof_I,VG,11,VO)
set M2=null
endfunction
