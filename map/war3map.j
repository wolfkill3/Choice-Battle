set cjlocgn_00000006=PolY(LoadReal(HH,id,12),cjlocgn_00000003,cjlocgn_00000004)
set cjlocgn_00000001=CreateUnit(GetOwningPlayer(caster),'hs26',cjlocgn_00000005,cjlocgn_00000006,GetRandomReal(0,360))
