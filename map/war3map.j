call UnitApplyTimedLife(CreateUnit(p,0x65304A51,x1,y1,GetRandomReal(0,359)),1,2)
call UnitApplyTimedLife(CreateUnit(p,0x65304A4E,x1,y1,GetRandomReal(0,359)),1,2)
call UnitApplyTimedLife(CreateUnit(p,0x65304A4D,x1,y1,GetRandomReal(0,359)),1,2)
call GroupEnumUnitsInRange(G,x1,y1,400,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SlowUnit(u,E,0.5,0,5,0,false)
endif
call GroupRemoveUnit(G,E)
endloop
