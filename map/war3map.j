call myCustomDamage(u,E,dmg,false,false,null,null,null)
else
call myCustomDamage(u,E,dmg*1.2,false,false,null,null,null)
endif
call SetControlToUnit(E,E, 2, "stun")
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
call UnitApplyTimedLife(CreateUnit(p,'e0GR',x1,y1,a*bj_RADTODEG),1,0.3)
call UnitApplyTimedLife(CreateUnit(p,'e0GS',x1,y1,a*bj_RADTODEG),1,0.3)
call UnitApplyTimedLife(CreateUnit(p,'e0GQ',x1,y1,a*bj_RADTODEG),1,0.5)
else
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,GetHandleId(g))
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
call RemoveUnit(l__d)
call RemoveUnit(d1)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
set d1=null
endfunction
