            set nb=nb-b*newdmg
        endif
        if GetUnitAbilityLevel(u,'A0UT')>0 and nb>0 then
            if GetUnitState(u,UNIT_STATE_LIFE)>nb then
            call SaveReal(HH,idu,StringHash("st"),LoadReal(HH,idu,StringHash("st"))+nb*0.25)
