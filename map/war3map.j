call PauseTimer(t)
call SaveReal(h,id,5,GetUnitFlyHeight(l__d))
call SaveReal(h,id,6,SR(GetUnitX(l__d),GetUnitY(l__d),LoadReal(h,id,1),LoadReal(h,id,2)))
