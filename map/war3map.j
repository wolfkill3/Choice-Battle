call SaveReal(h,id,3,x+GetRandomReal(-300,300))
call SaveReal(h,id,4,y+GetRandomReal(-300,300))
call SaveReal(h,id,5,mh)
call SaveReal(h,id,6,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,7,r)
call SaveReal(h,id,8,dmg)
call TimerStart(t,0.02,true,function SanzuReverShootFly2)
