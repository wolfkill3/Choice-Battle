call DestroyEffect(AddSpecialEffect("iceao.mdx",x1,y1))
call myCustomDamage(u,c,LoadReal(h,id,5),false,false,null,null,null)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
call KillUnit(l__d)
endif
set p=null
set l__d=null
set c=null
set t=null
set u=null
