function SuperExplosionWaveCond takes nothing returns boolean
return GetSpellAbilityId()=='A0P7'
endfunction
function SuperExplosionWaveCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local integer i=1
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real dmg=(4+GetUnitAbilityLevel(u,'A0P7'))*GetHeroAgi(u,true)
if GetUnitAbilityLevel(u,'B044')>0 then
set dmg=dmg+(1.75+GetUnitAbilityLevel(u,'A0P8')*0.50)*GetHeroAgi(u,true)+(1.75+GetUnitAbilityLevel(u,'A0P8')*0.50)*GetHeroStr(u,true)
endif
set soundplay=SndN(1692) // Sound\Music\mp3Music\SuperExploWave.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call UnitApplyTimedLife(CreateUnit(p,'e0S4',x,y,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e0S5',x,y,GetRandomReal(0,359)),'BTLF',6)
call UnitApplyTimedLife(CreateUnit(p,'e0S3',x,y,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e0S2',x,y,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e0S6',x,y,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e0S7',x,y,GetRandomReal(0,359)),'BTLF',3)
call GroupEnumUnitsInRange(G,x,y,850,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call Push(E,30,Atan2(GetUnitY(E)-y,GetUnitX(E)-x),700)
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(G,E)
endloop
call UnitRemoveAbility(u,'B044')
call SetUnitTimeScale(u,1)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set u=null
set p=null
set t=null
endfunction
