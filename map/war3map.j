local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,5)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroInt(u,true)*GetUnitAbilityLevel(u,'A1D0')+75*GetUnitAbilityLevel(u,'A1D0')
local real dmg2=(0.5+0.5*GetUnitAbilityLevel(u,'A1D0'))*GetHeroInt(u,true)
if SR(x,y,x1,y1)<=2250 then
