set soundplay=SndN(3916) // Sound\Music\mp3Music\SabracG_Sword6.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call UnitColor(LoadUnitHandle(HH,GetHandleId(casterOriginal),SH_SabracZoneU),100,100,100,100)

if caster==casterOriginal then
