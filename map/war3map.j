function BenizakuraSlashCond takes nothing returns boolean
return GetSpellAbilityId()=='A0PU'
endfunction
function BenizakuraSlashCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local group g=LoadGroupHandle(h,id,4)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,5)
local integer l__idg=GetHandleId(g)
local player p=GetOwningPlayer(u)
local real ml=0
local real dmg=(GetHeroAgi(u,true)+75)*GetUnitAbilityLevel(u,'A0PU')
if SR(x,y,x1,y1)<=2250 then
call SetUnitX(l__d,x1+50*Cos(a))
call SetUnitY(l__d,y1+50*Sin(a))
call UnitApplyTimedLife(CreateUnit(p,0x65304F42,x1,y1,a*bj_RADTODEG),1,0.12)
call GroupEnumUnitsInRange(g,x1,y1,200,Base)
loop
set E=FirstOfGroup(g)
set ml=GetUnitState(E,UNIT_STATE_MAX_LIFE)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)then
if E!=LoadUnitHandle(h,l__idg,ide)then
if GetUnitAbilityLevel(E,'A13O')==3 then
call myCustomDamage(u,E,dmg+ml*(0.03+0.001*GetHeroLevel(u)),false,false,null,null,null)
call UnitRemoveAbility(E,'A13O')
call UnitRemoveAbility(E,'A13U')
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",E,"chest"))
elseif GetUnitAbilityLevel(E,'A13O')<3 then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
if UnitIsAlive(E) then
if GetUnitAbilityLevel(E,'A13O')==0 then
call UnitAddAbility(E,'A13O')
call UnitMakeAbilityPermanent(E,true,'A13O')
call UnitAddAbility(E,'A13S')
call UnitMakeAbilityPermanent(E,true,'A13S')
elseif GetUnitAbilityLevel(E,'A13O')<3 then
if GetUnitAbilityLevel(E,'A13O')==1 then
call UnitRemoveAbility(E,'A13S')
call UnitAddAbility(E,'A13T')
call UnitMakeAbilityPermanent(E,true,'A13T')
elseif GetUnitAbilityLevel(E,'A13O')==2 then
call UnitRemoveAbility(E,'A13T')
call UnitAddAbility(E,'A13U')
call UnitMakeAbilityPermanent(E,true,'A13U')
endif
call SetUnitAbilityLevel(E,'A13O',GetUnitAbilityLevel(E,'A13O')+1)
endif
endif
endif
call SaveUnitHandle(h,l__idg,ide,E)
endif
call Push(E,30,Atan2(GetUnitY(E)-y1,GetUnitX(E)-x1),150)
endif
call GroupRemoveUnit(g,E)
endloop
else
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
call DestroyTimer(t)
call DestroyGroup(g)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function BenizakuraSlashCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,CreateUnit(GetOwningPlayer(u),0x65304F41,x+80*Cos(a),y+80*Sin(a),f))
call SaveGroupHandle(h,id,4,CreateGroup())
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveReal(h,id,5,a)
call SetUnitFacing(LoadUnitHandle(h,id,1),a*bj_RADTODEG)
if GetUnitTypeId(u)!='H03R' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\SaberSakura1.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\YomuQ.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
call TimerStart(t,0.03,true,function BenizakuraSlashCast2)
set u=null
set t=null
endfunction
function BenizakuraSlashInit takes nothing returns nothing
