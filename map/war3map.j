function InitVoice2 takes integer id,integer id2 returns string
local string l__s="sdf.mp3"
if((id=='H02M' or id=='H12M') and id2=='H02J') or ((id2=='H02M' or id2=='H12M') and id=='H02J')then
set l__s="AizenGin.mp3"
elseif(id=='HIc1' and (id2=='H02M' or id2=='H12M')) or (id2=='HIc1' and (id=='H02M' or id=='H12M'))then
set l__s="AizenIchigo.mp3"
elseif(id=='H01L' and id2=='H018') or (id2=='H01L' and id=='H018')then
set l__s="IchidaMayri.mp3"
elseif(id=='HIc1' and id2=='H045') or (id2=='HIc1' and id=='H045')then
set l__s="IchigoUlqa.mp3"
elseif(id=='HIc1' and id2=='H03L') or (id2=='HIc1' and id=='H03L')then
set l__s="IchigoNell.mp3"
elseif(id=='HIc1' and id2=='H018') or (id2=='HIc1' and id=='H018')then
set l__s="IshidaIchigo.mp3"
elseif(id=='HYuj' and id2=='H017') or (id2=='HYuj' and id=='H017')then //old 0x48303439
set l__s="YujiAndShana.mp3"
elseif(id=='H00I' and id2==0x48303047) or (id2=='H00I' and id==0x48303047)then
set l__s="ByakuranMukuro.mp3"
elseif(id=='H00I' and id2=='H00C') or (id2=='H00I' and id=='H00C')then
set l__s="ByakuranTsuna.mp3"
elseif(id=='H059' and id2=='H05C') or (id2=='H059' and id=='H05C')then
set l__s="GilvsSaber.mp3"
elseif(id=='H059' and id2=='H05A') or (id2=='H059' and id=='H05A')then
set l__s="ShirouGilgameshUBW.mp3"
elseif(id=='H06M' and (id2=='H06B' or id2=='H16B' or id2=='H26B')) or (id2=='H06M' and (id=='H06B' or id=='H16B' or id=='H26B'))then
set l__s="Heroine_X_myroom_Nero.mp3"
endif
return l__s
endfunction
function SetSpecialEffectAlphaTimedLoop takes nothing returns nothing
    local integer id= (GetHandleId(GetExpiredTimer())) // INLINED!!
    local integer alpha= LoadInt("alpha")
    local integer value= LoadInt("value")
    
    if alpha > 0 then
    call SaveInteger(HH, id, StringHash("alpha"), alpha - value)
    call SetSpecialEffectVertexColour(LoadEffect("effect") , LoadInt("r") , LoadInt("g") , LoadInt("b") , alpha)
    else
    call SetSpecialEffectVertexColour(LoadEffect("effect") , LoadInt("r") , LoadInt("g") , LoadInt("b") , 0)
    call DestroyEffect(LoadEffect("effect"))
    call RemoveSavedHandle(HH, id, EffectHash)
    call Clear(id)
    endif
endfunction
    
function SetSpecialEffectAlphaTimed takes effect eff1,integer r,integer g,integer b,integer alpha,integer value returns nothing
    local integer hId= GetPlayerId(GetTriggerPlayer())
    local integer id= NewTimer(hId)
    call SaveAgentHandle(HH, id, EffectHash, eff1)
    call SaveInteger(HH, id, StringHash("alpha"), alpha)
    call SaveInteger(HH, id, StringHash("value"), value)
    call SaveInteger(HH, id, StringHash("r"), r)
    call SaveInteger(HH, id, StringHash("g"), g)
    call SaveInteger(HH, id, StringHash("b"), b)
    call SetSpecialEffectVertexColour(LoadEffect("effect") , r , g , b , alpha)
    call TimerStart(LoadTimer(hId), .01, true, function SetSpecialEffectAlphaTimedLoop)
endfunction
function UBWDood takes nothing returns nothing
call SetDoodadZ(GetEnumDoodad(),1)
endfunction
