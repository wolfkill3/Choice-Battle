function QGilCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local integer idu=GetHandleId(u)
local integer str=SH_gil1
local integer st=LoadInteger(HH,idu,str)
if st+3<=(8+R2I(GetHeroLevel(u)/5))*2 then
call SaveInteger(HH,idu,str,st+3)
else
call SaveInteger(HH,idu,str,(8+R2I(GetHeroLevel(u)/5))*2)
endif
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,0)
call SaveReal(h,id,3,a)
call SaveReal(h,id,4,x)
call SaveReal(h,id,5,y)
call SaveGroupHandle(h,id,12,CreateGroup())
call SaveInteger(h,id,8,0)
call SaveReal(h,id,7,0.25)
call SetUnitTimeScale(u,1)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG-45)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+45)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
if GetUnitTypeId(u)=='H059' or GetUnitTypeId(u)=='H070' then
set soundplay=SndN(2837) // Sound\Music\mp3Music\GilgameshQ.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
set soundplay=SndN(2839) // Sound\Music\mp3Music\FemGilSkillQ.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call TimerStart(t,0.05,true,function QGilCast2)
set u=null
set p=null
set t=null
endfunction
function InitTrig_QGil takes nothing returns nothing
set gg_trg_QGil=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_QGil,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_QGil,Condition(function QGilCond))
call TriggerAddAction(gg_trg_QGil,function QGilCast)
endfunction
function TGilCond takes nothing returns boolean
return GetSpellAbilityId()=='A12X'
endfunction
function GilTStopOrders2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
call IssueImmediateOrder(u,"stop")
call SetUnitFacing(u,Atan2(LoadReal(h,id,1)-GetUnitY(u),LoadReal(h,id,2)-GetUnitX(u))*bj_RADTODEG)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
set t=null
set u=null
endfunction
function GilTStopOrders takes nothing returns nothing
local unit u=GetOrderedUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
if GetOrderTargetUnit()==null then
call SaveReal(h,id,2,GetOrderPointX())
call SaveReal(h,id,1,GetOrderPointY())
else
call SaveReal(h,id,2,GetUnitX(GetOrderTargetUnit()))
call SaveReal(h,id,1,GetUnitY(GetOrderTargetUnit()))
endif
//call SetUnitAnimation(u,"Spell Channel One")
call TimerStart(t,0.001,false,function GilTStopOrders2)
set u=null
set t=null
endfunction
function TGilCast6 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x2=0
local real y2=0
local real x1=LoadReal(h,id,1)
local real y1=LoadReal(h,id,2)
local real time=LoadReal(h,id,3)
local real te=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)
local real a2=GetUnitFacing(u)*bj_DEGTORAD
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,6)
local real dmg=GetHeroInt(u,true)*0.24
local real sc=0
local real he=GetUnitFlyHeight(u)
local integer idu=GetHandleId(u)
local integer str=SH_gil1
local integer st=LoadInteger(HH,idu,str)
if time>0 then
call SaveReal(h,id,3,time-0.03)
call SaveReal(h,id,4,te+0.03)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
if te>0.18 then
set x2=x+5*Cos(a2-deg90)
set y2=y+5*Sin(a2-deg90)
set x2=x2+15*Cos(a2)
set y2=y2+15*Sin(a2)
set n=CreateUnit(p,'e14N',x2,y2,a2*bj_RADTODEG)
call SetUnitSpriteFlag(n,SPRITE_FLAG_IGNORE_FOG,true)
call SetUnitTimeScale(n,1.5)
call SetUnitVertexColor(n,255,255,255,255)
call SetUnitFlyHeight(n,he-5,0)
call UnitApplyTimedLife(n,'BTLF',0.5)
call SaveReal(h,id,4,0)
endif
call GroupEnumUnitsInRange(G,x+225*Cos(a2),y+225*Sin(a2),450,Base)
call GroupAddGroup(G,g)
call GroupEnumUnitsInRange(G,x+450*Cos(a2),y+450*Sin(a2),475,Base)
call GroupAddGroup(G,g)
call GroupEnumUnitsInRange(G,x+675*Cos(a2),y+675*Sin(a2),500,Base)
call GroupAddGroup(G,g)
call GroupEnumUnitsInRange(G,x+900*Cos(a2),y+900*Sin(a2),525,Base)
call GroupAddGroup(G,g)
call GroupEnumUnitsInRange(G,x+1125*Cos(a2),y+1125*Sin(a2),550,Base)
call GroupAddGroup(G,g)
call GroupEnumUnitsInRange(G,x+1350*Cos(a2),y+1350*Sin(a2),575,Base)
call GroupAddGroup(G,g)
call GroupEnumUnitsInRange(G,x+1575*Cos(a2),y+1575*Sin(a2),600,Base)
call GroupAddGroup(G,g)
call GroupEnumUnitsInRange(G,x+1800*Cos(a2),y+1800*Sin(a2),625,Base)
call GroupAddGroup(G,g)
call GroupEnumUnitsInRange(G,x+2025*Cos(a2),y+2025*Sin(a2),650,Base)
call GroupAddGroup(G,g)
call GroupEnumUnitsInRange(G,x+2250*Cos(a2),y+2250*Sin(a2),675,Base)
call GroupAddGroup(G,g)
call GroupEnumUnitsInRange(G,x+2475*Cos(a2),y+2475*Sin(a2),700,Base)
call GroupAddGroup(G,g)
call GroupEnumUnitsInRange(G,x+2700*Cos(a2),y+2700*Sin(a2),725,Base)
call GroupAddGroup(G,g)
loop
set E=FirstOfGroup(g)
exitwhen E==null
if Condition_Base(p,E)then
call IssueImmediateOrder(E,"stop")
call SetUnitAnimation(E,"death")
if IsUnitInvulnerable(E)==false then
call DamageTextTag(u,E,dmg)
endif
call UnitAddAbility(E,'A0WR')
call DamageIndicatorFunction(u, E, dmg)
call myCustomDamage(u,E,dmg,false,false,null,DAMAGE_TYPE_UNIVERSAL,null)
call UnitRemoveAbility(E,'A0WR')
endif
call GroupRemoveUnit(g,E)
endloop
else
if st+10<=(8+R2I(GetHeroLevel(u)/5))*2 then
call SaveInteger(HH,idu,str,st+10)
else
call SaveInteger(HH,idu,str,(8+R2I(GetHeroLevel(u)/5))*2)
endif
call DestroyTimer(t)
call DestroyGroup(g)
call FlushChildHashtable(h,id)
call SetUnitTimeScale(u,1)
call SetUnitFlyHeight(u,0,750)
call PauseUnit(u,false)
call SetUnitAnimation(u,"Stand")
call SetUnitInvulnerable(u,false)
endif
set g=null
set t=null
set u=null
set p=null
endfunction
