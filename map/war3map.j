//Zamasu GW
function BlackGokuZamasuWGAct1 takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit Dummy=null
local unit target=LoadUnitHandle(HH,id,2)
local unit caster1=LoadUnitHandle(HH,GetHandleId(caster),SH_Zamasu)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real damage=LoadReal(HH,id,15)
local real distance
local boolean targinv=false
local boolean targpaus=false
set time=time+0.02
set distance=LoadReal(HH,id,8)
call SaveReal(HH,id,5,time)
if time>2.3 and SR(GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),GetUnitX(target),GetUnitY(target))<50 or time==10 then
call EffectCreateAndMove(true,"BlackGoku\\A_hit-nl-star_Zi1.mdl",facing,1,1.25,0.75,100,100,100,0,100,LoadUnitHandle(HH,id,20),0,facing)
call EffectCreateAndMove(true,"BlackGoku\\az_siwen21.mdl",facing,1,1.25,0.75,100,100,100,30,100,LoadUnitHandle(HH,id,20),0,facing)
call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",facing,1,1.25,0.75,100,100,100,40,0,LoadUnitHandle(HH,id,20),0,facing)
if GetUnitAbilityLevel(target,'Avul')>0 then
set targinv=true
call SetUnitInvulnerable(target,false)
endif
if IsUnitPaused(target)==true then
set targpaus=true
call PauseUnit(target,false)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
endif
call DamageAoeOneTime0(caster,GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),400,LoadReal(HH,id,15))
if targinv==true then
call SetUnitInvulnerable(target,true)
endif
if targpaus==true then
call PauseUnit(target,true)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
endif
call SetUnitAnimationByIndex(caster1,0)
call UnitSpeed(caster1,1)
call SaveBoolean(HH,GetHandleId(caster),SH_ZamasuSpell,false)
call UnitColor(LoadUnitHandle(HH,id,20),100,100,100,100)
call RemoveUnit(LoadUnitHandle(HH,id,20))
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else
if time==0.02 or time==0.4 or time==0.8 or time==1.2 or time==1.6 or time==2 then
call EffectCreateAndMove(true,"BlackGoku\\[A]az_axe_ef12.mdl",facing,1,1,0.5,100,100,100,30,0,caster1,0,facing)
endif
if time==0.02 then
call IssueImmediateOrder(caster1,"stop")
call SaveBoolean(HH,GetHandleId(caster),SH_ZamasuSpell,true)
call SaveReal(HH,id,3,facing)
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(3644) // Sound\Music\mp3Music\SoundEng\BlackGokuWGFeng.mp3
call StartSound(soundplay)
// call KillSoundWhenDone(soundplay)

else
set soundplay=SndN(3647) // Sound\Music\mp3Music\SoundJap\BlackGokuWGF.mp3
call StartSound(soundplay)
// call KillSoundWhenDone(soundplay)

endif
call SetUnitAnimationByIndex(caster1,3)
call SetUnitAnimationByIndex(caster1,17)
call UnitSpeed(caster1,1)
set facing=Angle2(GetUnitX(caster1),GetUnitY(caster1),GetUnitX(target),GetUnitY(target))
call SetUnitFacing(caster1,facing)
endif
if time==0.5 then
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster1),GetUnitY(caster1),facing)
call SetUnitModel(n0,"BlackGoku\\NanohaCharge1.mdl")
call UnitSize(n0,0.5,1,1)
call MoveUnit(n0,n0,100,facing)
call SetUnitFlyHeight(n0,150,0)
call SaveUnitHandle(HH,id,20,n0)
call SetUnitAnimationByIndex(caster1,18)
endif
if time<2.3 then
call UnitSize(Dummy,0.5+time*2,1,1)
set facing=Angle2(GetUnitX(caster1),GetUnitY(caster1),GetUnitX(target),GetUnitY(target))
if time>0.5 then
call MoveUnit(caster1,LoadUnitHandle(HH,id,20),100,facing)
endif
call SetUnitFacing(caster1,facing)
endif
if time==2.3 then
call EffectCreateAndMove(true,"BlackGoku\\CF22.mdl",facing,1,0.4,0.6,100,100,100,30,100,caster1,100,facing)
call EffectCreateAndMove90(true,"BlackGoku\\rasengan_eff4.mdl",facing+180,1,0.5,0.75,100,100,100,30,100,caster1,100,facing)
endif
if time>2.3 then
set Dummy=LoadUnitHandle(HH,id,20)
set facing=Angle2(GetUnitX(Dummy),GetUnitY(Dummy),GetUnitX(target),GetUnitY(target))
call MoveUnit(Dummy,Dummy,40,facing)
endif
endif
set Dummy=null
set caster=null
set caster1=null
set target=null
endfunction
function BlackGokuZamasuWGAct takes unit caster0,unit target0,real damage0 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(HH,id,1,caster0)
call SaveUnitHandle(HH,id,2,target0)
call SaveReal(HH,id,15,damage0)
call TimerStart(t,0.02,true,function BlackGokuZamasuWGAct1)
call SaveBoolean(HH,GetHandleId(caster0),SH_BGF,false)
set t=null
set caster0=null
set target0=null
endfunction
//Zamasu GW end
//Zamasu GE
function BlackGokZamasuuGEBalls1 takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit target=LoadUnitHandle(HH,id,2)
local real facing=LoadReal(HH,id,3)
local real distance=SR(GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),GetUnitX(target),GetUnitY(target))
local real time=LoadReal(HH,id,5)
local boolean targinv=false
local boolean targpaus=false
set time=time+0.02
call SaveReal(HH,id,5,time)
if distance<60 or time==5 then
call EffectCreateAndMove(true,"BlackGoku\\aZ_siwenBlackGoku.mdl",facing,1.5,1,1,100,100,100,0,50,target,0,facing)
if GetUnitAbilityLevel(target,'Avul')>0 then
set targinv=true
call SetUnitInvulnerable(target,false)
endif
if IsUnitPaused(target)==true then
set targpaus=true
call PauseUnit(target,false)
endif
call DamageAoeOneTime0(caster,GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),200,LoadReal(HH,id,15))
if targinv==true then
call SetUnitInvulnerable(target,true)
endif
if targpaus==true then
call PauseUnit(target,true)
endif
call RemoveUnit(LoadUnitHandle(HH,id,20))
call RemoveUnit(LoadUnitHandle(HH,id,21))
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else
set facing=Angle2(GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),GetUnitX(target),GetUnitY(target))
call MoveUnit(LoadUnitHandle(HH,id,20),LoadUnitHandle(HH,id,20),LoadReal(HH,id,9),facing)
call MoveUnit(LoadUnitHandle(HH,id,20),LoadUnitHandle(HH,id,21),0,facing)
call SaveReal(HH,id,8,distance-LoadReal(HH,id,9))
endif
set caster=null
set target=null
endfunction
function BlackGokZamasuuGEBalls takes unit bgoku0,unit zamasu0,unit target1,real damage0,real facing0 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real randomspeed=GetRandomReal(35,45)
call SaveUnitHandle(HH,id,1,bgoku0)
call SaveUnitHandle(HH,id,21,zamasu0)
call SaveUnitHandle(HH,id,2,target1)
call SaveReal(HH,id,15,damage0)
set n0=CreateUnit(GetOwningPlayer(bgoku0),'e200',GetUnitX(zamasu0),GetUnitY(zamasu0),facing0)
call SetUnitModel(n0,"BlackGoku\\[AB]BladeBeamFinalLarger.mdl")
call SetUnitAnimationByIndex(n0,1)
call UnitSize(n0,1.75,1,1)
call UnitColor(n0,100,100,100,20)
call SetUnitFlyHeight(n0,GetUnitFlyHeight(zamasu0)+100,0)
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call MoveUnit(n0,n0,GetRandomInt(50,100),facing0)
if GetRandomInt(1,2)==1 then
call MoveUnit(n0,n0,GetRandomInt(0,75),facing0+90)
else
call MoveUnit(n0,n0,GetRandomInt(0,75),facing0-90)
endif
call UnitSpeed(n0,1)
call SaveReal(HH,id,9,randomspeed)
call SetUnitAnimationByIndex(n0,2)
call SaveUnitHandle(HH,id,20,n0)
set n0=CreateUnit(GetOwningPlayer(bgoku0),'e200',GetUnitX(LoadUnitHandle(HH,id,21)),GetUnitY(LoadUnitHandle(HH,id,21)),facing0)
call SetUnitModel(n0,"BlackGoku\\[AB]newSolarBall.mdl")
call UnitColor(n0,100,100,100,20)
call UnitSize(n0,0.5,1,1)
call SetUnitFlyHeight(n0,GetUnitFlyHeight(zamasu0)+100,0)
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call UnitSpeed(n0,1)
call SaveUnitHandle(HH,id,21,n0)
set n0=null
call TimerStart(t,0.02,true,function BlackGokZamasuuGEBalls1)
set zamasu0=null
set bgoku0=null
set target1=null
set t=null
endfunction
function BlackGokuZamasuGEAct1 takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit target=LoadUnitHandle(HH,id,2)
local unit caster1=LoadUnitHandle(HH,GetHandleId(caster),SH_Zamasu)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real time1=LoadReal(HH,id,6)
local real damage=LoadReal(HH,id,15)
set time=time+0.02
call SaveReal(HH,id,5,time)
if time==3.5 then
call UnitSpeed(caster1,1)
call SetUnitAnimationByIndex(caster1,0)
call SaveBoolean(HH,GetHandleId(caster),SH_ZamasuSpell,false)
call SetUnitAnimationByIndex(caster1,0)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else
if time==0.02 then
call IssueImmediateOrder(caster1,"stop")
call SaveBoolean(HH,GetHandleId(caster),SH_ZamasuSpell,true)
set facing=Angle2(GetUnitX(caster1),GetUnitY(caster1),GetUnitX(target),GetUnitY(target))
call SetUnitFacing(caster1,facing)
call SaveReal(HH,id,3,facing)
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then


set soundplay=SndN(3650) // Sound\Music\mp3Music\SoundEng\BlackGokuEGFeng.mp3
call StartSound(soundplay)
// call KillSoundWhenDone(soundplay)

else


set soundplay=SndN(3653) // Sound\Music\mp3Music\SoundJap\BlackGokuEGF.mp3
call StartSound(soundplay)
// call KillSoundWhenDone(soundplay)


endif
endif
if time>0.02 and time<2.5 then
if time==0.02 or time==0.6 or time==1 or time==1.4 or time==1.8 or time==2.2 then
call SetUnitAnimationByIndex(caster1,17)
call UnitSpeed(caster1,1.5)
endif
if time==0.1 or time==0.7 or time==1.1 or time==1.5 or time==1.9 or time==2.3 then
call EffectCreateAndMove(true,"BlackGoku\\BlackBlink1.mdl",facing,1,1,1,100,100,100,0,0,caster1,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",facing,1,1,1,100,100,100,40,0,caster1,0,facing)
call MoveUnit(target,caster1,-1200,GetRandomReal(0,360))
call EffectCreateAndMove(true,"BlackGoku\\HakenSaber2.mdl",facing,1,0.5,0.5,100,100,100,0,0,caster1,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\[A]az_axe_ef1.mdl",facing,1,0.5,0.5,100,100,100,40,0,caster1,0,facing)
endif
set facing=Angle2(GetUnitX(caster1),GetUnitY(caster1),GetUnitX(target),GetUnitY(target))
call SetUnitFacing(caster1,facing)
set time1=time1+0.02
if time1==0.4 then
call BlackGokZamasuuGEBalls(caster,caster1,target,LoadReal(HH,id,15),facing)
set time1=0
endif
call SaveReal(HH,id,6,time1)
endif
endif
set caster=null
set caster1=null
set target=null
endfunction

function BlackGokuZamasuGEAct takes unit caster0,unit target0,real damage0 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(HH,id,1,caster0)
call SaveUnitHandle(HH,id,2,target0)
call SaveReal(HH,id,15,damage0)
call TimerStart(t,0.02,true,function BlackGokuZamasuGEAct1)
call SaveBoolean(HH,GetHandleId(caster0),SH_BGF,false)
set t=null
set caster0=null
set target0=null
endfunction




