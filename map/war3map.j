    endif
    call SetControlToUnit(u,l__d,0.6, "stun")
    call SetControlToUnit(u,l__d,1.5, "silenceTE")
    call TextTagFull2(I2S(LoadInteger(HH,idu,ComboCounterHash))+" x COMBO!",x,y,175,75,255,255,p,0.023+0.001*LoadInteger(HH,idu,ComboCounterHash))
    call SaveInteger(HH,idu,ComboTimerHash,0)
    call DestroyTimer(t)
    call FlushChildHashtable(HH,id)
    endif
    set l__d=null
    set u=null
    set p=null
    set t=null
endfunction
