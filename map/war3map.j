call TriggerRegisterAnyUnitEventBJ(gg_trg_PassiveKazuma,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(gg_trg_PassiveKazuma,Condition(function PassiveKazumaCond))
call TriggerAddAction(gg_trg_PassiveKazuma,function PassiveKazumaCast)
