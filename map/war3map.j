function GunhaTStopOrders2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
call IssueImmediateOrder(u,"stop")
call SetUnitFacing(u,Atan2(LoadReal(h,id,1)-GetUnitY(u),LoadReal(h,id,2)-GetUnitX(u))*bj_RADTODEG)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
set t=null
set u=null
endfunction
function GunhaTStopOrders takes nothing returns nothing
local unit u=GetOrderedUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
if GetOrderTargetUnit()==null then
call SaveReal(h,id,2,GetOrderPointX())
call SaveReal(h,id,1,GetOrderPointY())
else
call SaveReal(h,id,2,GetUnitX(GetOrderTargetUnit()))
call SaveReal(h,id,1,GetUnitY(GetOrderTargetUnit()))
endif
//call SetUnitAnimation(u,"Spell Channel One")
call TimerStart(t,0.001,false,function GunhaTStopOrders2)
set u=null
set t=null
endfunction
function CastPressureCreation2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real a=LoadReal(h,id,4)
local real speed=LoadReal(h,id,5)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real x=GetUnitX(l__d)+36*Cos(a)
local real y=GetUnitY(l__d)+36*Sin(a)
local real x2
local real y2
local real l__s=LoadReal(h,id,6)
local real s2=LoadReal(h,id,8)
local real he=LoadReal(h,id,9)
local real rad=LoadReal(h,id,7)
local real dist=LoadReal(h,id,10)
local real dmg=GetHeroStr(u,true)*11
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,3)
local real time=LoadReal(h,id,11)
local trigger tt=LoadTriggerHandle(h, id, StringHash("OrderTrigger"))
if time<2.25 then
call SaveReal(h,id,11,time+0.05)
if time<2 then
call SetControlToUnit(u, u, 0.1, "doom")
endif
if time==2 then
call SaveReal(h,id,4,GetUnitFacing(u)*bj_DEGTORAD)
call TriggerClearActions(tt)
call DestroyTrigger(tt)
call SetUnitAcquireRange(u, 600)
call UnitRemoveAbility(u, 'A1FU')
call UnitRemoveAbility(u,'Pet1')
call UnitRemoveAbility(u,'B00A')
call UnitRemoveAbility(u,'B02Z')
call PauseUnit(u,true)
call SetUnitTimeScale(u,1)
endif
if time==2.2 then
set x2=x1+70*Cos(a)
set y2=y1+70*Sin(a)
set n=CreateUnit(p,'e0TH',x2,y2,a*bj_RADTODEG)
call SetUnitVertexColor(n,225,GetRandomInt(113, 255),GetRandomInt(10, 255),255)
call SetUnitTimeScale(n,.1)
call SaveUnitHandle(h,id,1,n)
call UnitApplyTimedLife(CreateUnit(p,'e03X',x2,y2,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e03W',x2,y2,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e08R',x2,y2,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e03Y',x2,y2,GetRandomReal(0,359)),1,1)
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\GunhaT2.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call UnitRemoveAbility(u,'A0JI')
endif
else
set idg=GetHandleId(g)
if speed>0 and IsTerrainPathable(GetUnitX(l__d),GetUnitY(l__d),PATHING_TYPE_FLYABILITY)==false and udg_B and DU2 then
call SetUnitXY_1(l__d,x,y, false)
call SetUnitScale(l__d,1.5*l__s,1.5*l__s,1.5*l__s)
call SaveReal(h,id,6,l__s*1.0115)
call SaveReal(h,id,7,rad*1.013)
call SaveReal(h,id,8,s2*1.0115)
call SaveReal(h,id,9,he*1.002)
call SetUnitFlyHeight(l__d,0,0)
set n=CreateUnit(p,'e0TH',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,1)
if GetUnitTypeId(u)=='H14H' then
call SetUnitVertexColor(n,255,GetRandomInt(73, 123),GetRandomInt(73, 123),255)
else
call SetUnitVertexColor(n,225,GetRandomInt(113, 255),GetRandomInt(10, 255),255)
endif
call SetUnitScale(n,1.5*l__s,1.5*l__s,1.5*l__s)
call SetUnitTimeScale(n,1)
set n=CreateUnit(p,'e0TI',x,y,a*bj_RADTODEG)
if GetUnitTypeId(u)=='H14H' then
call SetUnitVertexColor(n,255,GetRandomInt(73, 123),GetRandomInt(73, 123),255)
else
call SetUnitVertexColor(n,225,GetRandomInt(113, 255),GetRandomInt(10, 255),255)
endif
call UnitApplyTimedLife(n,1,1)
call SetUnitFlyHeight(n,he*0.5,0)
call SetUnitScale(n,1.5*s2,1.5*s2,1.5*s2)
call SetUnitTimeScale(n,1)
if dist>=3 then
call GroupEnumUnitsInRange(g,x,y,50+rad,Base)
call SaveReal(h,id,10,0)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set ide=GetHandleId(E)
if Condition_Base(p,E) and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
elseif Condition_Base(p,E) and E==LoadUnitHandle(h,idg,ide) then
call myCustomDamage(u,E,0.04*dmg,false,false,null,null,null)
endif
if Condition_Base(p,E) then
call Push3(E,speed+6,a,180,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
endif
call GroupRemoveUnit(g,E)
endloop
else
call SaveReal(h,id,10,dist+1)
endif
call SaveReal(h,id,5,LoadReal(h,id,5)-.2)
else
call CameraSetSourceNoise(0,0)
call CameraSetTargetNoise(0,0)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,idg)
call RemoveUnit(l__d)
call DestroyGroup(g)
endif
endif
set g=null
set u=null
set t=null
set l__d=null
set p=null
set tt=null
endfunction
function CastPressureCreation takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local player p=GetOwningPlayer(u) 
local trigger tt=CreateTrigger()
call StartAbilityCooldown(GetUnitAbility(u,'A0WI'),GetAbilityRemainingCooldown(GetUnitAbility(u,'A0WI')))
call UnitAddAbility(u,'A0JI')
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,3,CreateGroup())
call SaveReal(h,id,5,30)
call SaveReal(h,id,7,170)
call SaveReal(h,id,6,6)
call SaveReal(h,id,8,.7)
call SaveReal(h,id,9,140)
call SetUnitTimeScale(u,0.08)
call SetUnitInvulnerable(u,true)
if GetUnitTypeId(u)=='H14H' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\MidoriyaT.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call SetUnitAnimation(u,"spell two slam")
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\GunhaT1.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call SetUnitAnimation(u,"attack")
endif
call TimerStart(t,0.05,true,function CastPressureCreation2)
call SaveTriggerHandle(h, id, StringHash("OrderTrigger"), tt)
call UnitAddAbility(u,'A1FU') //Slow
call UnitAddAbility(u,'Pet1')
call SetUnitAcquireRange(u,51)
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerAddAction(tt,function GunhaTStopOrders)
set u=null
set p=null
set t=null
set tt=null
endfunction
