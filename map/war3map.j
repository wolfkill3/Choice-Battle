call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call TimerStart(t,0.25,true,function MACCast2)
call SetUnitTurnSpeed(u,3.00)
set soundplay=SndN(1009) // Sound\Music\mp3Music\Mukuro5Form2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set u=null
set c=null
set t=null
endfunction
