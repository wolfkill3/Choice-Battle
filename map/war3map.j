function SaberNeroTCond takes nothing returns boolean
return GetSpellAbilityId()=='A1CG' and IsUnitIllusion(GetSpellTargetUnit())==false and Hero[GetPlayerId(GetOwningPlayer(GetSpellTargetUnit()))]==GetSpellTargetUnit()
endfunction
function SaberNeroTCast10 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local force f=LoadForceHandle(h,id,2)
local player p=GetOwningPlayer(u)
local player pc=GetOwningPlayer(c)
set Cambug=true
set Theaternero=false
if(IsPlayerInForce(GetLocalPlayer(),f))then
call EnableUserControl(true)
endif
if GetLocalPlayer()==p then
call ResetToGameCamera(0)
call PanCameraToTimed(GetUnitX(u),GetUnitY(u),0)
endif
if GetLocalPlayer()==pc then
call ResetToGameCamera(0)
call PanCameraToTimed(GetUnitX(c),GetUnitY(c),0)
endif
call Trig_ArenaCamera1_Actions()
call CambugTimed(0.5)
call ForceClear(f)
call DestroyForce(f)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set u=null
set c=null
set p=null
set pc=null
set f=null
set t=null
endfunction
function SaberNeroTCast91 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real dmg=12*GetHeroAgi(u,true)
local player p=GetOwningPlayer(u)
local player pc=GetOwningPlayer(c)
local real time=LoadReal(h,id,24)
if IsUnitPaused(c)==false or IsUnitAliveBJ(c)==false then
call SaveReal(h,id,24,time+0.1)
call SetUnitInvulnerable(u,false)
call SetUnitInvulnerable(c,false)
call UnitRemoveAbility(u,'A0QL')
call UnitRemoveAbility(c,'A0QL')
if time>0.2 then
call PauseUnit(u,false)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call SetUnitX(u,LoadReal(h,id,3))
call SetUnitY(u,LoadReal(h,id,4))
call SetUnitX(c,LoadReal(h,id,5))
call SetUnitY(c,LoadReal(h,id,6))
call SetUnitTargetable(u, true)
call SetUnitTargetable(c, true)
call SetUnitTimeScale(u,1)
call SetUnitTimeScale(c,1)
call SetUnitFlyHeight(u,0,0)
call SetUnitAnimation(u,"stand")
call SetUnitAnimation(c,"stand")
call UnitRemoveAbility(u,'A3IH')
call UnitRemoveAbility(c,'A3IH')
call IssueImmediateOrder(u,"stop")
if GetLocalPlayer()==p then
call PanCameraToTimed(GetUnitX(u),GetUnitY(u),0)
endif
if GetLocalPlayer()==pc then
call PanCameraToTimed(GetUnitX(c),GetUnitY(c),0)
endif
call TimerStart(LoadTimerHandle(h,id,23),0.1,false,function SaberNeroTCast10)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
endif
set u=null
set c=null
set p=null
set pc=null
set t=null
endfunction
function SaberNeroTCast9 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real dmg=12*GetHeroAgi(u,true)
local player p=GetOwningPlayer(u)
local player pc=GetOwningPlayer(c)
call PauseUnit(u,false)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call SetUnitX(u,LoadReal(h,id,3))
call SetUnitY(u,LoadReal(h,id,4))
call SetUnitX(c,LoadReal(h,id,5))
call SetUnitY(c,LoadReal(h,id,6))
call SetUnitInvulnerable(u,false)
call SetUnitInvulnerable(c,false)
call SetUnitTargetable(u, true)
call SetUnitTargetable(c, true)
call SetUnitTimeScale(u,1)
call SetUnitTimeScale(c,1)
call SetUnitFlyHeight(u,0,0)
call SetUnitAnimation(u,"stand")
call SetUnitAnimation(c,"stand")
call UnitRemoveAbility(u,'A3IH')
call UnitRemoveAbility(c,'A3IH')
call UnitRemoveAbility(u,'A0QL')
call UnitRemoveAbility(c,'A0QL')
call IssueImmediateOrder(u,"stop")
if GetUnitAbilityLevel(u,'B06L')!=0 or GetUnitAbilityLevel(u,'B16L')!=0 then
set dmg=dmg*1.35
endif
if GetLocalPlayer()==p then
call PanCameraToTimed(GetUnitX(u),GetUnitY(u),0)
endif
if GetLocalPlayer()==pc then
call PanCameraToTimed(GetUnitX(c),GetUnitY(c),0)
endif
call SetUnitState(c,UNIT_STATE_LIFE,LoadReal(h,id,22))
call SetUnitState(c,UNIT_STATE_MANA,LoadReal(h,id,25))
call myCustomDamage(u,c,dmg,false,false,null,null,null)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set u=null
set c=null
set p=null
set pc=null
set t=null
endfunction
