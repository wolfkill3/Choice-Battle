set gg_trg_QScatach=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_QScatach,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_QScatach,Condition(function QScatachCond))
call TriggerAddAction(gg_trg_QScatach,function QScatachCast)
