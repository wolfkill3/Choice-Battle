function CastYahiroVoid takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real l=GetWidgetLife(c)
local real lm=GetUnitState(c,UNIT_STATE_MAX_LIFE)
local real damage=(2+GetUnitAbilityLevel(u,'A0FR'))*GetHeroAgi(u,true)
if (lm*0.2>l or lm*0.15>l-damage*myCustomDamage2(c,1)) and GetUnitTypeId(c)!='H075' then
call SetUnitInvulnerable(c,false)
call UnitRemoveBuffs(c,true,true)
call UnitAddAbility(c,'A0WR')
call SetWidgetLife(c,5)
call DamageIndicatorFunction(u,c,damage)
call myCustomDamage(u,c,damage,false,false,null,null,null)
call UnitRemoveAbility(c,'A0WR')
else
call myCustomDamage(u,c,damage,false,false,null,null,null)
endif
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e09E',x1,y1,GetRandomReal(0,359)),'BHwe',2)
call UnitApplyTimedLife(CreateUnit(p,'e08P',x,y,GetRandomReal(0,359)),1,1)
set c=null
set u=null
endfunction
