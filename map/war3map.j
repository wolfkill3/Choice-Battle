function TScatachCond takes nothing returns boolean
return GetSpellAbilityId()=='A1FG'
endfunction
function TScatachCast6 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit l__d=LoadUnitHandle(h,id,6)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=LoadReal(h,id,3)
local real dist=LoadReal(h,id,4)
local real fl=GetUnitFlyHeight(c)
local real fl2=GetUnitFlyHeight(l__d)
local real dmg=14*GetHeroAgi(u,true)
if dist<900 then
call PauseUnit(c,true)
set x=x+40*Cos(a)
set y=y+40*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SaveReal(h,id,4,dist+40)
call SetUnitXY_1(c,x,y, false)
call SetUnitFlyHeight(c,fl+15,0)
call SetUnitFlyHeight(l__d,fl2+15,0)
set n=CreateUnit(p,'e14Z',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,25)
call SetUnitTimeScale(n,1)
call SetUnitFlyHeight(n,fl2,0)
call UnitApplyTimedLife(n,'BTLF',0.15)
set n=CreateUnit(p,'e150',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.15)
call SetUnitTimeScale(n,3)
call SetUnitFlyHeight(n,fl2,0)
set n=CreateUnit(p,'e151',x,y,GetRandomReal(0,359))
call KillUnit(n)
call SetUnitTimeScale(n,3)
call SetUnitFlyHeight(n,fl2,0)
call SetUnitFacing(l__d,a*bj_RADTODEG)
else
call UnitRemoveAbility(u,'A1F8')
call RemoveUnit(l__d)
call PauseTimer(t)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call SetUnitTimeScale(c,1)
call myCustomDamage(u,c,dmg,false,false,null,null,null)
call SetControlToUnit(u,c,2, "stun")
call SetUnitFlyHeight(c,0,fl/2)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
endif
set l__d=null
set c=null
set p=null
set u=null
set t=null
endfunction
function TScatachCast5 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit l__d=LoadUnitHandle(h,id,6)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local real fl=GetUnitFlyHeight(l__d)
local real fl2=GetUnitFlyHeight(c)
if SR(x,y,x1,y1)>75 then
call PauseUnit(c,true)
set x=x+70*Cos(a)
set y=y+70*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
set x1=x1+30*Cos(a)
set y1=y1+30*Sin(a)
call SetUnitXY_1(c,x1,y1, false)
call SetUnitFlyHeight(c,fl2+10,0)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,fl+50/3,0)
set n=CreateUnit(p,'e14Z',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,25)
call SetUnitTimeScale(n,1)
call SetUnitFlyHeight(n,fl,0)
call UnitApplyTimedLife(n,'BTLF',0.15)
set n=CreateUnit(p,'e150',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.15)
call SetUnitTimeScale(n,3)
call SetUnitFlyHeight(n,fl,0)
call UnitApplyTimedLife(n,'BTLF',0.15)
else
call RemoveUnit(LoadUnitHandle(h,id,2))
call ShowUnit(u,true)
call PauseUnit(u,false)
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitInvulnerable(u,false)
if GetLocalPlayer()==p then
call ClearSelection()
call SelectUnit(u,true)
endif
call PauseTimer(t)
call TimerStart(t,0.02,true,function TScatachCast6)
endif
set l__d=null
set c=null
set p=null
set u=null
set t=null
endfunction
