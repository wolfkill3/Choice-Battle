local player p=GetOwningPlayer(u)
set n=CreateUnit(p,'e01N',GetUnitX(u),GetUnitY(u),0)
call UnitApplyTimedLife(n,'BTLF',7+GetHeroLevel(u)/2)
call PauseUnit(n,true)
call SetUnitFlyHeight(n,0,1000)
call RemoveSavedHandle(HH,GetHandleId(u),SH_kangaruu)
call SaveUnitHandle(HH,GetHandleId(u),SH_kangaruu,n)
call UnitApplyTimedLife(CreateUnit(p,'e01O',GetUnitX(u),GetUnitY(u),0),'BTLF',1.1)
call SaveUnitHandle(HH,id,0,u)
call SaveUnitHandle(HH,id,1,n)
set soundplay=SndN(1266) // Sound\Music\mp3Music\RyoheiGaryuy.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,1,false,function KangaruuCast2)
set u=null
set t=null
set p=null
endfunction
