local real y=GetUnitY(u)
local real x1
local real y1
local real a
local real lvl=GetUnitAbilityLevel(u,'A0LW')+2
local player p=GetOwningPlayer(u)
local group g=CreateGroup()
local integer i=1
local integer l__s=SH_block
local real f=(360/30)*bj_DEGTORAD
local integer ip=GetPlayerId(p)
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
set n=CreateUnit(p,'e0HQ',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',lvl+0.5)
call SetUnitScale(n,2.5,2.5,2.5)
set n=CreateUnit(p,'e0HP',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',lvl+0.5)
call SetUnitScale(n,3,3,3)
set n=CreateUnit(p,'e0HO',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',lvl+0.5)
call SetUnitScale(n,3,3,3)
set n=CreateUnit(p,'e0HR',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',lvl+0.5)
call SetUnitScale(n,3,3,3)
call RemoveSavedReal(h,GetHandleId(Hero[ip]),SH_MF1)
call RemoveSavedReal(h,GetHandleId(Hero[ip]),SH_MF2)
call SaveReal(h,GetHandleId(Hero[ip]),SH_MF1,x)
call SaveReal(h,GetHandleId(Hero[ip]),SH_MF2,y)
loop
exitwhen i>=31
set x1=x+400*Cos(i*f)
set y1=y+400*Sin(i*f)
set a=Atan2(y-y1,x-x1)+GetRandomReal(-.1,.1)
set n=CreateUnit(p,'e0I1',x1,y1,a*bj_RADTODEG)
call GroupAddUnit(g,n)
call SetUnitAnimation(n,"Birth")
call SaveDestructableHandle(h,id,l__s+i,CreateDestructable('B003',x1,y1,a*bj_DEGTORAD,1,1))
set i=i+1
endloop
call UnitAddAbility(u,'A0A1')
call SetUnitTimeScale(u,4)
call SetUnitInvulnerable(u,true)
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,1,g)
set soundplay=SndN(1541) // Sound\Music\mp3Music\IllusionForest.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,.3,true,function MistForestCast2)
set p=null
set g=null
set u=null
set t=null
endfunction
