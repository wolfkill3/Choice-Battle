function ByakuranGhost1 takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit u = LoadUnitHandle(h,id,1)
local unit n = LoadUnitHandle(h,id,20)
local unit c = LoadUnitHandle(h,id,2)
local integer i=LoadInteger(h,id,5)
local group g=LoadGroupHandle(h,id,23)
set i=i+1
if i==25 then
if GetUnitState(c,UNIT_STATE_MANA)<GetUnitState(c,UNIT_STATE_MAX_MANA)*0.25+GetUnitState(c,UNIT_STATE_MAX_MANA)*0.05*GetUnitAbilityLevel(u,'BGaR') then
call myCustomDamage(u,c,GetUnitState(c,UNIT_STATE_MAX_LIFE)*0.0125,false,false,null,DAMAGE_TYPE_UNIVERSAL,null)
call SaveReal(h,GetHandleId(u),SH_ByakuranGhost2,LoadReal(h,GetHandleId(u),SH_ByakuranGhost2)+GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.0125)
endif
call SetUnitState(c,UNIT_STATE_MANA,GetUnitState(c,UNIT_STATE_MANA)-GetUnitState(c,UNIT_STATE_MAX_MANA)*0.0125)
call SaveReal(h,GetHandleId(u),SH_ByakuranGhost,LoadReal(h,GetHandleId(u),SH_ByakuranGhost)+GetUnitState(u,UNIT_STATE_MAX_MANA)*0.0125)
set i=0
endif
call SaveInteger(h,id,5,i)
if n==null or SR(GetUnitX(n),GetUnitY(n),GetUnitX(c),GetUnitY(c))>800 or udg_B==false or DU2==false then
    call DestroyLightning(LoadLightningHandle(h,id,4))
    call GroupRemoveUnit(g,c)
    call PauseTimer(GetExpiredTimer())
    call FlushChildHashtable(h,id)
    call DestroyTimer(GetExpiredTimer())
    set u=null
    set n=null
    set c=null
endif
if SR(GetUnitX(n),GetUnitY(n),GetUnitX(c),GetUnitY(c))<780 and IsUnitInvulnerable(c)==false then
call MoveUnit(c,c,-2.5,Atan2(GetUnitY(c)-GetUnitY(n),GetUnitX(c)-GetUnitX(n))*bj_RADTODEG)
endif
call MoveLightningEx(LoadLightningHandle(h,id,4),true, GetUnitX(c), GetUnitY(c),GetUnitFlyHeight(c)+150,GetUnitX(n),GetUnitY(n),GetUnitFlyHeight(n)+150)
set u=null
set n=null
set c=null
    set g=null
endfunction
function ByakuranGhost takes unit u,unit n,unit c, group g returns nothing
local timer t = CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,1,u)
call SaveUnitHandle(h,id,2,c)
call SaveUnitHandle(h,id,20,n)
call SaveGroupHandle(h,id,23,g)
call SaveInteger(h,id,5,0)
call SaveLightningHandle(h,id,4,AddLightningEx("MFPB",true,GetUnitX(c), GetUnitY(c), GetTerrainZ(GetUnitX(c),GetUnitY(c)), GetUnitX(n), GetUnitY(n), GetTerrainZ(GetUnitX(n),GetUnitY(n))))
call TimerStart(t,0.02,true,function ByakuranGhost1)
set u=null
set n=null
set c=null
set t=null
endfunction
function ByakuranFMove takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit u=LoadUnitHandle(h,id,1)
local real a=LoadReal(h,id,3)
local integer i=LoadInteger(h,id,5)
local integer i1=LoadInteger(h,id,6)
local unit c=LoadUnitHandle(h,id,2)
local group gr=LoadGroupHandle(h,id,4)
local player p=GetOwningPlayer(u)
call SaveInteger(h,id,5,i+1)
if udg_B==false or DU2==false then
call SaveInteger(h,id,5,99999)
endif
if i==1 then
    set n=CreateUnit(GetOwningPlayer(u),'11GH',LoadReal(h, id, SH_PointX),LoadReal(h, id, SH_PointY),a*bj_RADTODEG)
    call UnitSize(n,1.5,1,1)
    // call MoveUnit(u,n,100,a*bj_RADTODEG)   
        call UnitAddAbility(n, 'Amrf')
        call UnitRemoveAbility(n, 'Amrf')
        call SetUnitInvulnerable(n, true)
    call SaveUnitHandle(h,id,2,n) 
    call SetUnitAnimationByIndex(n,1)
    call SaveGroupHandle(h,id,4,CreateGroup())
    call SaveEffectHandle(h,id,21,AddSpecialEffectTarget("GhostLighthin3.mdl",n,"chest"))
    call SaveEffectHandle(h,id,22,AddSpecialEffectTarget("GhostLighthin.mdl",n,"head"))
    set n=CreateUnit(GetOwningPlayer(u),'12GH',GetUnitX(u),GetUnitY(u),a)
    call UnitSize(n,2,1,1)
    call SaveUnitHandle(h,id,18,n) 
    call SetUnitFlyHeight(n,150,0)
    set n=CreateUnit(GetOwningPlayer(u),'13GH',GetUnitX(u),GetUnitY(u),a)
    call UnitSize(n,1,1,1)
    call SaveUnitHandle(h,id,19,n) 
    call SaveReal(h,GetHandleId(u),SH_ByakuranGhost,0)
    call SaveReal(h,GetHandleId(u),SH_ByakuranGhost2,0)
endif
  if i>1 and i<300+GetUnitAbilityLevel(u,'BGaR')*50 and udg_B and DU2 then
        call SetUnitInvulnerable(c, true)
    call MoveUnit(c,c,5,GetUnitFacing(c))
    call MoveUnit(c,LoadUnitHandle(h,id,18),0,GetUnitFacing(c))
    call MoveUnit(c,LoadUnitHandle(h,id,19),0,GetUnitFacing(c))
    set i1=i1+1
    if i1==25 then
        set i1=0
        call UnitCreateAndMove(u,'suT2',c,a,1,0.7,0.35,0,100,0,30,0,c,0,a)
    endif
    call SaveInteger(h,id,6,i1)
    call GroupEnumUnitsInRange(G,GetUnitX(c),GetUnitY(c),600,Base)
    loop
    set E = FirstOfGroup(G)
    exitwhen  E == null
    if IsUnitInGroup(E,gr)==false and Condition_Base(p,E) and UnitIsAlive(E) == true then
    call GroupAddUnit(gr,E)
    call ByakuranGhost(u,c,E,gr)
    endif
    call GroupRemoveUnit(G,E)
    endloop
    call GroupClear(G)
    call SaveGroupHandle(h,id,4,gr)
    set c=null
    set gr=null
    endif
    if i>=300+GetUnitAbilityLevel(u,'BGaR')*50 or udg_B==false or DU2==false then
    call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)+LoadReal(h,GetHandleId(u),SH_ByakuranGhost))
    call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+LoadReal(h,GetHandleId(u),SH_ByakuranGhost2))
    call RemoveSavedHandle(h,GetHandleId(u),SH_ByakuranGhost)
    call RemoveSavedHandle(h,GetHandleId(u),SH_ByakuranGhost2)
    call DestroyEffect(LoadEffectHandle(h,id,21))
    call DestroyEffect(LoadEffectHandle(h,id,22))
    call RemoveUnit(LoadUnitHandle(h,id,2))
    call RemoveUnit(LoadUnitHandle(h,id,18))
    call RemoveUnit(LoadUnitHandle(h,id,19))
    call DestroyGroup(LoadGroupHandle(h,id,4))
    call PauseTimer(GetExpiredTimer())
    call FlushChildHashtable(h,id)
    call DestroyTimer(GetExpiredTimer())        
    endif
set u=null
endfunction
function Byakuran_Act takes nothing returns nothing
local timer t = CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,1,GetTriggerUnit())
call SaveInteger(h,id,5,0)
call SaveInteger(h,id,6,0)
call SaveReal(h, id, SH_PointX, GetSpellTargetX())
call SaveReal(h, id, SH_PointY, GetSpellTargetY())
call SaveReal(h,id,3,Atan2(GetSpellTargetY()-GetUnitY(GetTriggerUnit()),GetSpellTargetX()-GetUnitX(GetTriggerUnit())))
set soundplay=SndN(858) // Sound\Music\mp3Music\Ghost.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.02,true,function ByakuranFMove)
set t=null
endfunction

function Byakuran_Cond takes nothing returns boolean
    if GetSpellAbilityId() == 'BGaR' then
    return true
    else
    return false
    endif
endfunction
function InitTrig_ByakuranGesso takes nothing returns nothing
    local trigger ByakuranGesso = CreateTrigger(  )
    local integer index
    set index = 0
    loop
        call TriggerRegisterPlayerUnitEvent(ByakuranGesso, Player(index), EVENT_PLAYER_UNIT_SPELL_EFFECT, null)
        set index = index + 1
        exitwhen index == bj_MAX_PLAYER_SLOTS
    endloop
    call TriggerAddCondition(ByakuranGesso, Condition( function Byakuran_Cond ) )
    call TriggerAddAction(ByakuranGesso, function Byakuran_Act )
    set ByakuranGesso = null
endfunction
function WhiteDragonCond takes nothing returns boolean
return GetSpellAbilityId()=='A01F'
endfunction
function WhiteDragonCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local group g=LoadGroupHandle(h,id,4)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,5)
local integer l__idg=GetHandleId(g)
local player p=GetOwningPlayer(u)
local real dmg
if LoadBoolean(h,id,7)==false then
set dmg=(75+GetHeroInt(u,true))*GetUnitAbilityLevel(u,'A01F')
else
set dmg=(75+GetHeroInt(u,true))*GetUnitAbilityLevel(u,'A01F')*1.25
endif
if SR(x,y,x1,y1)<=2500 then
call SetUnitX(l__d,x1+32*Cos(a))
call SetUnitY(l__d,y1+32*Sin(a))
call GroupEnumUnitsInRange(g,x1,y1,140,Base)
set ide=GetHandleId(g)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,l__idg,ide,E)
call DestroyEffect(AddSpecialEffect("war3mapImported\\TealSlam.mdx",GetUnitX(E),GetUnitY(E)))
call SetControlToUnit(E,E, 2, "stun")
endif
call GroupRemoveUnit(g,E)
endloop
call DestroyEffect(AddSpecialEffect("war3mapImported\\WhiteGetsuga.mdx",x1,y1))
else
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
call RemoveUnit(l__d)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function WhiteDragonCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
if GetUnitTypeId(u)!='H00I' then
set n=CreateUnit(GetOwningPlayer(u),'e00V',x+80*Cos(f*bj_DEGTORAD),y+80*Sin(f*bj_DEGTORAD),f)
call UnitAddAbility(n,'Arav')
call SetUnitVertexColor(n,0,0,0,255)
call SetUnitTimeScale(n,2)
call SaveBoolean(h,id,7,true)
else
set n=CreateUnit(GetOwningPlayer(u),'e00V',x+80*Cos(f*bj_DEGTORAD),y+80*Sin(f*bj_DEGTORAD),f)
call UnitAddAbility(n,'Arav')
call SetUnitTimeScale(n,2)
endif
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,n)
call SaveGroupHandle(h,id,4,CreateGroup())
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveReal(h,id,5,a)
call SetUnitFacing(n,a*bj_RADTODEG)
set soundplay=SndN(860) // Sound\Music\mp3Music\WhiteDragon.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.015,true,function WhiteDragonCast2)
set u=null
set t=null
endfunction
function WhiteDragonInit takes nothing returns nothing
endfunction
function Trig_White_Finger_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A01N' and udg_B==true
endfunction
function Trig_White_Finger_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__n=LoadUnitHandle(h,id,DummyHash)
local unit u=LoadUnitHandle(h,id,CasterHash)
local unit c=LoadUnitHandle(h,id,TargetHash)
local real x=GetUnitX(LoadUnitHandle(h,id,DummyHash))
local real y=GetUnitY(LoadUnitHandle(h,id,DummyHash))
local real x1=GetUnitX(LoadUnitHandle(h,id,TargetHash))
local real y1=GetUnitY(LoadUnitHandle(h,id,TargetHash))
local real a=Atan2(y-y1,x-x1)
local integer dist=LoadInteger(h,id,SH_dist)
local real r
call SetUnitPathing(c,false)
if SR(x,y,x1,y1)>30 and dist<1 then
        call SetUnitX(l__n,x-24*Cos(a))
        call SetUnitY(l__n,y-24*Sin(a))
        set n=CreateUnit(GetOwningPlayer(u),'e00W',x,y,a*bj_RADTODEG+180)
        call UnitApplyTimedLife(n,'BTLF',0.30)
        call UnitAddAbility(n,'Arav')
        call SetUnitTimeScale(n,0)
        call UnitAddAbility(l__n,'Arav')
        call SetUnitTimeScale(l__n,0)
else
    if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
        if dist<1000 and IsTerrainPathable(GetUnitX(c),GetUnitY(c),PATHING_TYPE_FLYABILITY)==false then
            call SaveInteger(h,id,SH_dist,dist+24)
            set r=Atan2(GetUnitY(c)-GetUnitY(u),GetUnitX(c)-GetUnitX(u))
            call SetUnitXY_1(c,GetUnitX(c)+24*Cos(r),GetUnitY(c)+24*Sin(r), false)
            call IssueImmediateOrder(c, "stop")
            if SR(x,y,x1,y1)>30 then
                call SetUnitX(l__n,x+24*Cos(r))
                call SetUnitY(l__n,y+24*Sin(r))
                set n=CreateUnit(GetOwningPlayer(u),'e00W',x,y,r*bj_RADTODEG+180)
                call UnitApplyTimedLife(n,'BTLF',0.30)
                call UnitAddAbility(n,'Arav')
                call SetUnitTimeScale(n,0)
                call UnitAddAbility(l__n,'Arav')
                call SetUnitTimeScale(l__n,0)
            endif
        else
            call KillUnit(l__n)
            call RemoveUnit(l__n)
            call myCustomDamage(u,c,(2+GetUnitAbilityLevel(u,'A01N'))*GetHeroInt(u,true),false,false,null,null,null)
            call SlowUnit(u,c,0.3,0.3,3,2,false)
            call SetUnitPathing(c,true)
            call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e0NJ',x1,y1,GetRandomReal(0,359)),'BTLF',3)
            call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e0NK',x1,y1,GetRandomReal(0,359)),'BTLF',6)
            call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e0NI',x1,y1,GetRandomReal(0,359)),'BTLF',3)
            call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e0NL',x1,y1,GetRandomReal(0,359)),'BTLF',3)
            call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e0NM',x1,y1,GetRandomReal(0,359)),'BTLF',3)
            call RemoveSavedHandle(h,id,CasterHash)
            call RemoveSavedHandle(h,id,TargetHash)
            call RemoveSavedHandle(h,id,DummyHash)
            call PauseTimer(t)
            call DestroyTimer(t)
            call FlushChildHashtable(h,id)
        endif
    else
        call KillUnit(l__n)
        call RemoveUnit(l__n)
        call SetUnitPathing(u,true)
        call SetUnitInvulnerable(u,false)
        call PauseUnit(u,false)
        call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
        call PauseTimer(t)
        call DestroyTimer(t)
        call SetUnitVertexColor(u,255,255,255,255)
        call FlushChildHashtable(h,id)
        call SetUnitTimeScale(u,1)
    endif
endif
set c=null
set u=null
set l__n=null
set t=null
endfunction
function Trig_White_Finger_Actions takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveAgentHandle(h,id,CasterHash,GetSpellAbilityUnit())
call SaveAgentHandle(h,id,TargetHash,GetSpellTargetUnit())
call SaveAgentHandle(h,id,DummyHash,CreateUnit(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)),'e00W',GetUnitX(LoadUnitHandle(h,id,CasterHash)),GetUnitY(LoadUnitHandle(h,id,CasterHash)),GetUnitFacing(LoadUnitHandle(h,id,CasterHash))*bj_RADTODEG))
call SaveInteger(h,id,SH_dist,0)
call SaveReal(h,id,SH_ang,Atan2(GetUnitY(LoadUnitHandle(h,id,CasterHash))-GetUnitX(LoadUnitHandle(h,id,TargetHash)),GetUnitX(LoadUnitHandle(h,id,CasterHash))-GetUnitX(LoadUnitHandle(h,id,TargetHash))))
set soundplay=SndN(862) // Sound\Music\mp3Music\WhiteFinger.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.01,true,function Trig_White_Finger_Actions2)
set t=null
endfunction
function Trig_Final_Shot_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A01L'
endfunction
function Trig_Final_Shot_Actions2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit d1=LoadUnitHandle(h,id,1)
    local unit d2=LoadUnitHandle(h,id,7)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=LoadReal(h,id,5)
    local real y1=LoadReal(h,id,6)
    local real i=LoadReal(h,id,7)
    local real f=LoadReal(h,id,8)*bj_RADTODEG
    local real r=0
    local group gn=LoadGroupHandle(h,id,25)
    local group g=LoadGroupHandle(h,id,26)
    local group gn2=LoadGroupHandle(h,id,27)
    local player p=GetOwningPlayer(u)
    local real dmg=GetHeroInt(u,true)*1.0
    local real mm=GetUnitState(u,UNIT_STATE_MAX_MANA)*0.0125
    if OrderId2String(GetUnitCurrentOrder(u))=="channel"and GetUnitState(u,UNIT_STATE_MANA)>20 then
        call SetUnitXY_1(u,x1,y1, false)
        call SetUnitFacingInstant(u,f)
        call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-mm)
        loop
            exitwhen r==13
            call UnitApplyTimedLife(CreateUnit(p,'e010',x+r*150*Cos(f*bj_DEGTORAD),y+r*150*Sin(f*bj_DEGTORAD),f),'BTLF',0.25)
            call UnitApplyTimedLife(CreateUnit(p,'e0RL',x+r*150*Cos(f*bj_DEGTORAD),y+r*150*Sin(f*bj_DEGTORAD),GetRandomReal(0,359)),'BTLF',0.4)
            call GroupEnumUnitsInRange(gn,x+r*150*Cos(f*bj_DEGTORAD),y+r*150*Sin(f*bj_DEGTORAD),230,Base)
            loop
                set E=FirstOfGroup(gn)
                exitwhen E==null
                if Condition_Base(p,E)then
                    call GroupAddUnit(g,E)
                endif
                call GroupRemoveUnit(gn,E)
            endloop
            set r=r+1
        endloop
    loop
        set E=FirstOfGroup(g)
        exitwhen E==null
        if Condition_Base(p,E)then
        call myCustomDamage(u,E,dmg,false,false,null,null,null)
        call SetControlToUnit(E,E,0.6,"stun")
        if IsUnitInGroup(E,gn2)==false then
        call GroupAddUnit(gn2,E)
        endif
        endif
        call GroupRemoveUnit(g,E)
    endloop
    else
    loop
    set E=FirstOfGroup(gn2)
    exitwhen E==null
    call GroupRemoveUnit(gn2,E)
    endloop
    call DestroyTimer(t)
    call RemoveUnit(d1)
    call RemoveUnit(d2)
    call DestroyGroup(gn)
    call DestroyGroup(g)
    call DestroyGroup(gn2)
    call FlushChildHashtable(h,id)
    call SetUnitInvulnerable(u,false)
    endif
    set d1=null
    set d2=null
    set p=null
    set u=null
    set t=null
    set gn=null
    set g=null
    set gn2=null
endfunction
function Trig_Final_Shot_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real f=Atan2(y1-y,x1-x)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit l__d=CreateUnit(GetOwningPlayer(u),'e00Y',x+50*Cos(f*bj_DEGTORAD),y+50*Sin(f*bj_DEGTORAD),f*bj_RADTODEG)
call UnitAddAbility(l__d,'Arav')
call SetUnitInvulnerable(u,true)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,7,CreateUnit(GetOwningPlayer(u),'e00Z',x+50*Cos(f+180*bj_DEGTORAD),y+50*Sin(f+180*bj_DEGTORAD),f*bj_RADTODEG+180))
call SaveUnitHandle(h,id,1,l__d)
call SaveReal(h,id,2,GetSpellTargetX())
call SaveReal(h,id,3,GetSpellTargetY())
call SaveReal(h,id,5,x)
call SaveReal(h,id,6,y)
call SaveReal(h,id,8,f)
call SaveBoolean(h,id,4,true)
call SaveGroupHandle(h,id,25,CreateGroup())
call SaveGroupHandle(h,id,26,CreateGroup())
call SaveGroupHandle(h,id,27,CreateGroup())
set soundplay=SndN(864) // Sound\Music\mp3Music\BlackBurning.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,.25,true,function Trig_Final_Shot_Actions2)
set u=null
set l__d=null
set t=null
endfunction
