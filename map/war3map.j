function SaberNeroWCast8 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real dmg=GetHeroAgi(u,true)*(2+GetUnitAbilityLevel(u,'A1CA'))+75
local real a=LoadReal(h,id,3)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=0
local real y1=0
local real is=0
local real ig=30*bj_DEGTORAD
local player p=GetOwningPlayer(u)
local real dist=LoadReal(h,id,2)
local group g=LoadGroupHandle(h,id,1)
if GetUnitAbilityLevel(u,'B06L')!=0 or GetUnitAbilityLevel(u,'B16L')!=0 then
set dmg=dmg*1.35
endif
loop
set E=FirstOfGroup(g)
exitwhen E==null
call PauseUnit(E,false)
call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,false)
call SetUnitFlyHeight(E,0,0)
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SlowUnit(u,E,0.5,0,5,0,false)
call GroupRemoveUnit(g,E)
endloop
call IssueImmediateOrder(u,"stop")
call DestroyGroup(g)
call SetUnitFlyHeight(u,0,0)
call SetUnitTimeScale(u,1)
call SaveReal(h,id,2,0)
call PauseTimer(t)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call FlushChildHashtable(h,id)
set u=null
set g=null
set p=null
set t=null
endfunction
function SaberNeroWCast7 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real dmg=GetHeroAgi(u,true)*3
local real a=LoadReal(h,id,3)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real dist=LoadReal(h,id,2)
local real sc=0
local real is=0
local real ig=30*bj_DEGTORAD
local real pi=90*bj_DEGTORAD
local group g=LoadGroupHandle(h,id,1)
local group g2
if dist<0.3 then
call SaveReal(h,id,2,dist+0.03)
call SetUnitFlyHeight(u,GetUnitFlyHeight(u)-33,0)
set g2=CopyGroup(g)
loop
set E=FirstOfGroup(g2)
exitwhen E==null
call PauseUnit(E,true)
call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,true)
call SetUnitFlyHeight(E,GetUnitFlyHeight(E)-33,0)
call GroupRemoveUnit(g2,E)
endloop
call DestroyGroupTimed(g2,3)
else
set x=x+250*Cos(a)
set y=y+250*Sin(a)
if GetUnitAbilityLevel(u,'B06L')!=0 or GetUnitAbilityLevel(u,'B16L')!=0 then
call DestroyEffect(AddSpecialEffect("war3mapImported\\LW10.mdl",x,y))
endif
call ShakeCamera(0.25,15)
set n=CreateUnit(p,'e123',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,GetRandomInt(175,255))
call SetUnitFlyHeight(n,25,0)
call UnitApplyTimedLife(n,'BTLF',1.5)
loop
exitwhen is>=13
set n=CreateUnit(p,'e0ZH',x+400*Cos(ig*is),y+400*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,255,255,255,35)
call UnitApplyTimedLife(n,'BTLF',0.6)
call SetUnitTimeScale(n,1)
set n=CreateUnit(p,'e122',x,y,0)
set sc=GetRandomReal(1.75,2.25)
call SetUnitScale(n,sc,sc,sc)
if GetUnitTypeId(u)=='H26B' then
call SetUnitVertexColor(n,255,255,255,75)
else
call SetUnitVertexColor(n,255,25,25,75)
endif
call SetUnitFlyHeight(n,200*is,0)
call UnitApplyTimedLife(n,'BTLF',0.7)
call SetUnitTimeScale(n,2)
set is=is+1
endloop
if GetUnitTypeId(u)=='H26B' then
set n=CreateUnit(p,'e224',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,GetRandomInt(175,255))
call SetUnitFlyHeight(n,25,0)
call UnitApplyTimedLife(n,'BTLF',1.5)
set n=CreateUnit(p,'e11S',x1-300*Cos(a),y1-300*Sin(a),a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call SetUnitScale(n,20,20,20)
call SetUnitTimeScale(n,0.9)
call UnitApplyTimedLife(n,'BTLF',0.7)
else
set n=CreateUnit(p,'e124',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,GetRandomInt(175,255))
call SetUnitFlyHeight(n,25,0)
call UnitApplyTimedLife(n,'BTLF',1.5)
set n=CreateUnit(p,'e11S',x1-300*Cos(a),y1-300*Sin(a),a*bj_RADTODEG)
call SetUnitVertexColor(n,255,75,75,155)
call SetUnitScale(n,20,20,20)
call SetUnitTimeScale(n,0.9)
call UnitApplyTimedLife(n,'BTLF',0.7)
endif
set n=CreateUnit(p,'e0RV',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call SetUnitTimeScale(n,0.3)
call UnitApplyTimedLife(n,'BTLF',0.6)
call SetUnitFlyHeight(u,0,0)
call SaveReal(h,id,2,0)
call PauseTimer(t)
call TimerStart(t,0.3,false,function SaberNeroWCast8)
endif
set u=null
set g=null
set g2=null
set p=null
set t=null
endfunction
