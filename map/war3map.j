function TShikiCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local player p=GetOwningPlayer(u)
local integer idu=GetHandleId(u)
local integer idp=GetHandleId(p)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
call SaveUnitHandle(HH,id,0,u)
call SaveUnitHandle(HH,id,1,c)
call UnitAddAbility(u,'A195')
call SetUnitTimeScale(LoadUnitHandle(HH,idp,ComboBarHash),1000000)
call SaveReal(HH,idu,ComboTimerHash,2)
call SetWidgetMana(u, GetWidgetMana(u)-GetWidgetMaxMana(u)*LoadInteger(HH,idu,ComboCounterHash)*0.005)
call ComboBar(u,0)
set n=CreateUnit(p,'e0ZI',x+75*Cos(a),y+75*Sin(a),a*bj_RADTODEG)
call SaveUnitHandle(HH,id,2,n)
set soundplay=SndN(2624) // Sound\Music\mp3Music\NanayaE2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set soundplay=SndN(2635) // Sound\Music\mp3Music\ShikiN5-1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
if GetAbilityIntegerLevelField(GetUnitAbility(u,'A1BZ'), ABILITY_ILF_TARGET_TYPE,0)==1 then
    call TimerStart(t,0.01,true,function TShikiCast2)
else
    set x1=GetSpellTargetX()
    set y1=GetSpellTargetY()
    set a=Atan2(y1-y,x1-x)
    call SaveReal(HH,id,5,x1)
    call SaveReal(HH,id,6,y1)
    call SaveReal(HH,id,7,a)
    call SaveReal(HH,id,8,0)
    call SetUnitFacingInstant(n,a*bj_RADTODEG)
    call TimerStart(t,0.01,true,function TShikiCast22)
endif
set u=null
set c=null
set p=null
set t=null
endfunction
function InitTrig_TShiki takes nothing returns nothing
set gg_trg_TShiki=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_TShiki,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_TShiki,Condition(function TShikiCond))
call TriggerAddAction(gg_trg_TShiki,function TShikiCast)
endfunction
function SaberNeroQCond takes nothing returns boolean
return GetSpellAbilityId()=='A1C9'
endfunction
function SaberNeroQCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,4)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real dmg=GetHeroAgi(u,true)*(1+GetUnitAbilityLevel(u,'A1C9'))+50+25*GetUnitAbilityLevel(u,'A1C9')
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real a=Atan2(y1-y,x1-x)
local real dist=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
local real pi=90*bj_DEGTORAD
local real sc
if dist<3 then
if dist==0 and GetUnitTypeId(u)=='H26B' then
set soundplay=SndN(2637) // Sound\Music\mp3Music\NeroBrideQ2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
if GetUnitAbilityLevel(u,'B06L')!=0 or GetUnitAbilityLevel(u,'B16L')!=0 then
set dmg=dmg*1.35
call DestroyEffect(AddSpecialEffect("war3mapImported\\LW10.mdl",x1,y1))
endif
set sc=2.5
set n=CreateUnit(p,'e0ZH',x1,y1,a*bj_RADTODEG-225)
call SetUnitVertexColor(n,255,255,255,75)
call SetUnitScale(n,sc,sc,sc)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x1,y1,a*bj_RADTODEG+225)
call SetUnitVertexColor(n,255,255,255,75)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitScale(n,sc,sc,sc)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x1,y1,a*bj_RADTODEG+180)
call SetUnitVertexColor(n,255,255,255,75)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitScale(n,sc,sc,sc)
call SetUnitTimeScale(n,3)
call PauseUnit(l__d,false)
call myCustomDamage(u,l__d,dmg/3,false,false,null,null,null)
call PauseUnit(l__d,true)
set n=CreateUnit(p,'e11M',x1,y1,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,255)
call SetUnitFlyHeight(n,75,0)
set sc=GetRandomReal(1,2)
call SetUnitScale(n,sc,sc,sc)
call UnitApplyTimedLife(n,'BTLF',1.3)
call SetUnitTimeScale(n,0.5)
if GetUnitTypeId(u)=='H26B' then
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,75)
set sc=1
call SetUnitScale(n,sc,sc,sc)
call SetUnitFlyHeight(n,55,0)
call UnitApplyTimedLife(n,'BTLF',0.8)
call SetUnitTimeScale(n,1.5)
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,75)
set sc=2
call SetUnitScale(n,sc,sc,sc)
call SetUnitFlyHeight(n,55,0)
call UnitApplyTimedLife(n,'BTLF',0.8)
call SetUnitTimeScale(n,1.5)
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,75)
set sc=3
