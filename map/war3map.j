local real l__s=GetRandomReal(0.5,1.5)
local real dmg=GetHeroStr(u,true)*(2+GetUnitAbilityLevel(u,'A14E'))
if SR(x,y,x1,y1)<=2250 and IsTerrainPathable(x1,y1,PATHING_TYPE_FLYABILITY)==false then
set x1=x1+65*Cos(a)
set y1=y1+65*Sin(a)
