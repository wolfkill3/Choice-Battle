set soundplay=SndN(3018) // Sound\Music\mp3Music\MeloiT.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call TimerStart(t,0.15,true,function TWaverCast2)
set t=null
set u=null
endfunction
