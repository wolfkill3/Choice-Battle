//==============================================================================
//========= Madara Start
//==============================================================================


// сусано формы


function MadaraSusanoAct1 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local real time=LoadReal(HH,id,5)
local real time1=LoadReal(HH,id,6)
local integer typeSusano=LoadInteger(HH,id,9)
if IsUnitPaused(caster)==false and IsUnitHidden(caster)==false and IsUnitIllusion(caster)==false then
set time=time+0.02
set time1=time1+0.02
call SaveReal(HH,id,5,time)
if time1==1 then
set time1=0
call SaveReal(HH,GetHandleId(caster),SH_MadaraSusDur,LoadReal(HH,GetHandleId(caster),SH_MadaraSusDur)-1)
call SetUnitState(caster,UNIT_STATE_MANA,GetUnitState(caster,UNIT_STATE_MANA)-GetUnitState(caster,UNIT_STATE_MAX_MANA)*0.01)
//if((GetLocalPlayer()==GetOwningPlayer(caster) or GetPlayerAlliance(GetOwningPlayer(caster),GetLocalPlayer(),ALLIANCE_SHARED_CONTROL)) and GetUnitSelected(GetLocalPlayer())==caster )then
//call DisplayTextToPlayer(GetLocalPlayer(),0,0,"Susano Duration: "+R2S(LoadReal(HH,GetHandleId(caster),StringHash("MadaraSusDur")))+" Second ")
//endif
endif
call SaveReal(HH,id,6,time1)
endif
if CheckUnitInvisible(caster) then
    call UnitAddAbility(LoadUnitHandle(HH,id,2),'Ao7S')
else
    call UnitRemoveAbility(LoadUnitHandle(HH,id,2),'Ao7S')
endif
call SetUnitFacingInstant(LoadUnitHandle(HH,id,2),GetUnitFacing(caster))
call SetUnitFlyHeight(LoadUnitHandle(HH,id,2),GetUnitFlyHeight(caster)+50,0)
call MoveUnit(caster,LoadUnitHandle(HH,id,2),0,GetUnitFacing(caster))
if  udg_B==false or DU2==false or UnitIsAlive(caster)==false or (LoadReal(HH,GetHandleId(caster),SH_MadaraSusDur)==0 or LoadUnitHandle(HH,id,2)==null or LoadBoolean(HH,GetHandleId(caster),SH_MadaraSusT)==true or LoadBoolean(HH,GetHandleId(caster),SH_MadaraSusT2)==true) then
//GetUnitState(caster,UNIT_STATE_MANA)<GetUnitState(caster,UNIT_STATE_MAX_MANA)*0.05

call SaveBoolean(HH,GetHandleId(caster),SH_MadaraSusR,false)
if(LoadUnitHandle(HH,id,2))!=null then
call RemoveUnit(LoadUnitHandle(HH,id,2))
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set caster=null
set t=null
endfunction
function MadaraSusanoAct2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local real time=LoadReal(HH,id,5)
local real time1=LoadReal(HH,id,6)
local integer typeSusano=LoadInteger(HH,id,9)
if IsUnitPaused(caster)==false and IsUnitHidden(caster)==false and IsUnitIllusion(caster)==false then
set time=time+0.02
set time1=time1+0.02
call SaveReal(HH,id,5,time)
if time1==1 then
set time1=0
call SaveReal(HH,GetHandleId(caster),SH_MadaraSusDur,LoadReal(HH,GetHandleId(caster),SH_MadaraSusDur)-1)
call SetUnitState(caster,UNIT_STATE_MANA,GetUnitState(caster,UNIT_STATE_MANA)-GetUnitState(caster,UNIT_STATE_MAX_MANA)*0.015)
//if((GetLocalPlayer()==GetOwningPlayer(caster) or GetPlayerAlliance(GetOwningPlayer(caster),GetLocalPlayer(),ALLIANCE_SHARED_CONTROL)) and GetUnitSelected(GetLocalPlayer())==caster )then
//call DisplayTextToPlayer(GetLocalPlayer(),0,0,"Susano Duration: "+R2S(LoadReal(HH,GetHandleId(caster),StringHash("MadaraSusDur")))+" Second ")
//endif
endif
call SaveReal(HH,id,6,time1)
endif
if CheckUnitInvisible(caster) then
    call UnitAddAbility(LoadUnitHandle(HH,id,2),'Ao7S')
    call UnitAddAbility(LoadUnitHandle(HH,id,20),'Ao7S')
else
    call UnitRemoveAbility(LoadUnitHandle(HH,id,2),'Ao7S')
    call UnitRemoveAbility(LoadUnitHandle(HH,id,20),'Ao7S')
endif
call SetUnitFacingInstant(LoadUnitHandle(HH,id,2),GetUnitFacing(caster))
call SetUnitFlyHeight(LoadUnitHandle(HH,id,2),GetUnitFlyHeight(caster)+50,0)
call MoveUnit(caster,LoadUnitHandle(HH,id,2),0,GetUnitFacing(caster))
call SetUnitFacingInstant(LoadUnitHandle(HH,id,20),GetUnitFacing(caster))
call SetUnitFlyHeight(LoadUnitHandle(HH,id,20),GetUnitFlyHeight(caster),0)
call MoveUnit(caster,LoadUnitHandle(HH,id,20),0,GetUnitFacing(caster))
if udg_B==false or DU2==false or UnitIsAlive(caster)==false or (LoadReal(HH,GetHandleId(caster),SH_MadaraSusDur)==0 or LoadUnitHandle(HH,id,2)==null) then
call SaveReal(HH,GetHandleId(caster),SH_MadaraSusDur,0)
//GetUnitState(caster,UNIT_STATE_MANA)<GetUnitState(caster,UNIT_STATE_MAX_MANA)*0.05 or
call SaveBoolean(HH,GetHandleId(caster),SH_MadaraSusT,false)
call RemoveUnit(LoadUnitHandle(HH,id,20))
if(LoadUnitHandle(HH,id,2))!=null then
call RemoveUnit(LoadUnitHandle(HH,id,2))
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set caster=null
set t=null
endfunction
function MadaraSusanoAct3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local real time=LoadReal(HH,id,5)
local real time1=LoadReal(HH,id,6)
local integer typeSusano=LoadInteger(HH,id,9)
if IsUnitPaused(caster)==false and IsUnitHidden(caster)==false and IsUnitIllusion(caster)==false then
set time=time+0.02
set time1=time1+0.02
call SaveReal(HH,id,5,time)
if time1==1 then
set time1=0
call SaveReal(HH,GetHandleId(caster),SH_MadaraSusDur,LoadReal(HH,GetHandleId(caster),SH_MadaraSusDur)-1)
call SetUnitState(caster,UNIT_STATE_MANA,GetUnitState(caster,UNIT_STATE_MANA)-GetUnitState(caster,UNIT_STATE_MAX_MANA)*0.015)
//if((GetLocalPlayer()==GetOwningPlayer(caster) or GetPlayerAlliance(GetOwningPlayer(caster),GetLocalPlayer(),ALLIANCE_SHARED_CONTROL)) and GetUnitSelected(GetLocalPlayer())==caster )then
//call DisplayTextToPlayer(GetLocalPlayer(),0,0,"Susano Duration: "+R2S(LoadReal(HH,GetHandleId(caster),StringHash("MadaraSusDur")))+" Second ")
//endif
endif
call SaveReal(HH,id,6,time1)
endif
if   udg_B==false or DU2==false or UnitIsAlive(caster)==false or  time>0 and ( LoadReal(HH,GetHandleId(caster),SH_MadaraSusDur)==0) then
call SaveBoolean(HH,GetHandleId(caster),SH_MadaraSusT2,false)
call SaveReal(HH,GetHandleId(caster),SH_MadaraSusDur,0)


//GetUnitState(caster,UNIT_STATE_MANA)<GetUnitState(caster,UNIT_STATE_MAX_MANA)*0.05

           // if IsUnitPaused(caster)==false then
           //     call IssueImmediateOrder(caster, "stop")
           //     call UnitAddAbility(caster, 'AMUN')
           //     call IssueImmediateOrder(caster, "bearform")
           //     call UnitRemoveAbility(caster, 'AMUN')
           // else
            //    call PauseUnit(caster, false)
            //    call IssueImmediateOrder(caster, "stop")
             //   call UnitAddAbility(caster, 'AMUN')
             //   call IssueImmediateOrder(caster, "bearform")
             //   call UnitRemoveAbility(caster, 'AMUN')
                
            //endif
                        call UnitRemoveBuffs(caster,false,true)
                  // call UnitRemoveBuffs(caster,true,true)
                  // call IssueImmediateOrder(caster, "stop")
           //call UnitAddAbility(caster, 'AMUN')
          // call IssueImmediateOrder(caster, "bearform")
           //call UnitRemoveAbility(caster, 'AMUN')

call UnitAddAbility(caster, 'AMUB')
call IssueImmediateOrder(caster, "bearform")
call UnitRemoveAbility(caster, 'AMUB')
call CheckUnitBonusRange(caster)
call SaveReal(HH,id,5,-0.04)
endif
if time==-0.02 then

if GetUnitTypeId(caster)!='H033' then
call UnitAddAbility(caster, 'AMUB')
call IssueImmediateOrder(caster, "bearform")
call UnitRemoveAbility(caster, 'AMUB')
call CheckUnitBonusRange(caster)
endif



call UnitSpeed(caster,1)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set caster=null
set t=null
endfunction

function MadaraSusanoAct takes unit caster0,integer typeSusano returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(caster0)
local integer idp=GetHandleId(p)
call SaveUnitHandle(HH,id,1,caster0)
call SaveInteger(HH,id,9,typeSusano)




if typeSusano==1 then
call SaveReal(HH,GetHandleId(caster0),SH_MadaraSusDur,LoadReal(HH,GetHandleId(caster0),SH_MadaraSusDur)+6+R2I((GetUnitState(caster0,UNIT_STATE_MANA)*0.001)))
call SaveReal(HH,id,10,LoadReal(HH,GetHandleId(caster0),SH_MadaraSusDur)+6+R2I((GetUnitState(caster0,UNIT_STATE_MANA)*0.001)))
call SetUnitState(caster0,UNIT_STATE_MANA,GetUnitState(caster0,UNIT_STATE_MANA)-GetUnitState(caster0,UNIT_STATE_MAX_MANA)*0.05)
if LoadBoolean(HH,GetHandleId(caster0),SH_MadaraSusT)==null and LoadBoolean(HH,GetHandleId(caster0),SH_MadaraSusT2)==null and LoadUnitHandle(HH,GetHandleId(caster0),SH_MadaraSusano)==null then
