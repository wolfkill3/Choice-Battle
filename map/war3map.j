if time<3 and SR(x,y,x1,y1)<1800 and IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'CBC2')==0 and GetUnitAbilityLevel(u,'cbc3')==0 and GetUnitAbilityLevel(u,'cbc7')==0 and UnitIsAlive(u) then
call SaveReal(h,id,4,time+0.25)
set soundplay=SndN(1464) // Sound\Music\mp3Music\KizaruShot.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set n=CreateUnit(p,'e0G0',x,y,Atan2(y1-y,x1-x)*bj_RADTODEG)
call UnitApplyTimedLife(CreateUnit(p,'e0G4',x,y,GetRandomReal(0,359)),'BHwe',0.001)
call LaserCannonMissleMovePoint(n,70,0,x1+GetRandomReal(-275,275),y1+GetRandomReal(-275,275),dmg)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set t=null
endfunction
