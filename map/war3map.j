function TGilCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local trigger tt=CreateTrigger()
call StartAbilityCooldown(GetUnitAbility(u,'A12X'),GetAbilityRemainingCooldown(GetUnitAbility(u,'A12X')))
call SetUnitFacing(u,a*bj_RADTODEG)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,x1)
call SaveReal(h,id,2,y1)
call SaveReal(h,id,3,4)
call SaveReal(h,id,4,0)
call SaveInteger(h,id,9,0)
call SaveInteger(h,id,10,1)
call SaveInteger(h,id,5,0)
call SaveGroupHandle(h,id,6,CreateGroup())
call UnitAddAbility(u,'Arav')
call UnitRemoveAbility(u,'Arav')
set n=CreateUnit(p,'e14I',x,y,GetRandomReal(0,359))
call SetUnitTimeScale(n,0.3)
call UnitApplyTimedLife(n,'BTLF',7.5)
call SetUnitVertexColor(n,255,255,255,30)
call SetUnitScale(n,4,4,4)
set n=CreateUnit(p,'e11E',x,y,GetRandomReal(0,359))
call SetUnitTimeScale(n,0.3)
call UnitApplyTimedLife(n,'BTLF',7.5)
call SetUnitVertexColor(n,255,255,255,100)
call SetUnitScale(n,4,4,4)
set n=CreateUnit(p,'e0RV',x,y,0)
call SetUnitTimeScale(n,0.15)
call UnitApplyTimedLife(n,'BTLF',7.5)
call SetUnitVertexColor(n,255,255,255,150)
call SetUnitScale(n,2,2,2)
set n=CreateUnit(p,'e14O',x,y,0)
call SetUnitTimeScale(n,0.5)
call UnitApplyTimedLife(n,'BTLF',7.5)
call SetUnitVertexColor(n,255,255,255,255)
call SetUnitInvulnerable(u,true)
call SaveTriggerHandle(h, id, SH_OrderTrigger, tt)
call UnitAddAbility(u,'A1FU') //Slow
call UnitAddAbility(u,'Pet1')
call SetUnitAcquireRange(u,51)
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerAddAction(tt,function GilTStopOrders)
if GetUnitTypeId(u)=='H059' or GetUnitTypeId(u)=='H070' then
set soundplay=SndN(2841) // Sound\Music\mp3Music\GilEA.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
set soundplay=SndN(2843) // Sound\Music\mp3Music\FemGilEnumaElish.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call TimerStart(t,0.05,true,function TGilCast2)
set t=null
set tt=null
set p=null
set u=null
endfunction
