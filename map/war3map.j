endfunction
function EGilCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,5)
local unit l__d=LoadUnitHandle(h,id,1)
local unit d2=LoadUnitHandle(h,id,4)
local real dmg=(2+GetUnitAbilityLevel(u,'A12Y'))*GetHeroInt(u,true)
local real x1=LoadReal(h,id,6)
local real y1=LoadReal(h,id,7)
local real a=LoadReal(h,id,3)
local real dist=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
if dist>0 and GetWidgetLife(c)>0 then
call SetUnitPosition(c,x1,y1)
call IssueImmediateOrder(c, "stop")
call SaveReal(h,id,2,dist-0.02)
call SetUnitX(d2,x1)
call SetUnitY(d2,y1)
else
call KillUnit(d2)
call SetUnitAnimation(l__d,"death")
call UnitApplyTimedLife(l__d,'BTLF',1)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set d2=null
set c=null
set u=null
set p=null
set t=null
endfunction
function EGilCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,5)
local unit l__d=LoadUnitHandle(h,id,1)
local unit d2=LoadUnitHandle(h,id,4)
local real dmg=(2+GetUnitAbilityLevel(u,'A12Y'))*GetHeroInt(u,true)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=LoadReal(h,id,3)
local real dist=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
local integer i=0
if dist>0 and GetWidgetLife(c)>0 then
    call SetUnitXY_1(l__d,x1,y1, false)
    call SetUnitX(d2,x1)
    call SetUnitY(d2,y1)
    call SaveReal(h,id,2,dist-0.02)
else
    if GetUnitTypeId(u)=='H059' or GetUnitTypeId(u)=='H070' then
        set soundplay=SndN(2829) // Sound\Music\mp3Music\Einkidou.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    else
        set soundplay=SndN(2832) // Sound\Music\mp3Music\FemGilSkillE.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    endif
    call SetUnitAnimation(l__d,"stand")
    set n=CreateUnit(p,'e14Q',x1,y1,GetRandomReal(0,359))
    call SetUnitVertexColor(n,255,255,255,255)
    call SetUnitAnimation(n,"birth")
    call SaveUnitHandle(h,id,1,n)
    call IssueImmediateOrder(c,"stop")
    call PauseTimer(t)
    call KillUnit(l__d)
    call SaveReal(h,id,6,x1)
    call SaveReal(h,id,7,y1)
    call SaveReal(h,id,2,1.5+GetUnitAbilityLevel(u,'A12Y')*0.5)
    loop
    exitwhen i>=10
    if IsUnitAlly(Hero[i],Player(i))and GetUnitTypeId(Hero[i])=='H077' then
        call SaveReal(h,id,2,2.5+GetUnitAbilityLevel(u,'A12Y')*0.5)
    endif
    set i=i+1
    endloop
    call SaveReal(h,id,2,CalculateControlResist(c, LoadReal(h,id,2)))
    call SetControlToUnit(u,c,LoadReal(h,id,2), "stun")
    call TimerStart(t,0.02,true,function EGilCast3)
endif
set c=null
set d2=null
set l__d=null
set u=null
set p=null
set t=null
endfunction
function EGilCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real di=1.0
local real a=Atan2(y1-y,x1-x)
local integer idu=GetHandleId(u)
local integer str=SH_gil1
local integer st=LoadInteger(HH,idu,str)
if st+3<=(8+R2I(GetHeroLevel(u)/5))*2 then
call SaveInteger(HH,idu,str,st+3)
else
call SaveInteger(HH,idu,str,(8+R2I(GetHeroLevel(u)/5))*2)
endif
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,5,c)
set n=CreateUnit(p,'e14U',x+25*Cos(a),y+25*Sin(a),a*bj_RADTODEG)
call SaveUnitHandle(h,id,4,n)
call SaveReal(h,id,2,di)
call SaveReal(h,id,8,di)
call SaveReal(h,id,3,a)
call SetUnitTimeScale(u,1)
call TimerStart(t,0.02,true,function EGilCast2)
set n=CreateUnit(p,'e14V',x+25*Cos(a),y+25*Sin(a),a*bj_RADTODEG)
call SaveUnitHandle(h,id,1,n)
call SetUnitAnimation(n,"birth")
set u=null
set p=null
set t=null
set c=null
endfunction
