                                set cjlocgn_00000002=LoadReal(HH,id,3)-90
                        else
                                set cjlocgn_00000002=LoadReal(HH,id,3)+90
                        endif
                        set EFF=AddSpecialEffect("war3mapImported\\hero_juggernaut_n4s_e_line.mdl",GetUnitX(c),GetUnitY(c))
