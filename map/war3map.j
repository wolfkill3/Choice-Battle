function BlackStar_Act takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(HH,id,1,GetTriggerUnit())
call SaveInteger(HH,id,5,0)
call SaveInteger(HH,id,6,0)
call SaveUnitHandle(HH,id,2,GetSpellTargetUnit())
call SaveReal(HH,id,3,Angle2(GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()),GetUnitX(GetSpellTargetUnit()),GetUnitY(GetSpellTargetUnit())))
call PauseUnit(GetTriggerUnit(),true)
call SetUnitInvulnerable(GetTriggerUnit(),true)
if GetSpellAbilityId()=='A0C3' then
call TimerStart(t,0.02,true,function BlackStarWMove)
endif
if GetSpellAbilityId()=='A0XK' then
call TimerStart(t,0.02,true,function BlackStarTMove)
endif
set t=null
endfunction
function InitTrig_BlackStarChoice takes nothing returns nothing
local trigger BlackStar=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(BlackStar,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(BlackStar,Condition(function BlackStar_Cond))
call TriggerAddAction(BlackStar,function BlackStar_Act)
endfunction
function Gajeel_Cond takes nothing returns boolean
return GetSpellAbilityId()=='A154' and GetUnitAbilityLevel(GetTriggerUnit(),'GAE1')==0
endfunction
function GajeelTMove takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local real d2=Angle2(GetUnitX(LoadUnitHandle(HH,id,1)),GetUnitY(LoadUnitHandle(HH,id,1)),GetLocationX(LoadLocationHandle(HH,id,7)),GetLocationY(LoadLocationHandle(HH,id,7)))
local unit u=LoadUnitHandle(HH,id,1)
local integer i=LoadInteger(HH,id,5)
local integer i2
set i=i+1
call SaveInteger(HH,id,5,i)
if(i==1)then
set soundplay=SndN(2727) // Sound\Music\mp3Music\GajeelT.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SetUnitAnimationByIndex(u,8)
call UnitSpeed(u,0.5)
call UnitAddAbility(u,'Amrf')
call UnitRemoveAbility(u,'Amrf')
call SaveEffectHandle(HH,id,10,AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl",u,"origin"))
//war3mapImported\[A]az_axe_ef1.mdl
call UnitCreateAndMove(u,'e1WB',u,GetRandomReal(0,360),0.4,0.8,0.4,100,100,100,0,0,u,0,GetRandomReal(0,360))
//war3mapImported\BY_Wood_GongChengSiPai_6.mdl
call UnitCreateAndMove(u,'e2WN',u,GetRandomReal(0,360),1,0.35,1,100,100,100,0,0,u,0,GetRandomReal(0,360))
endif
if i==15 then
call UnitSpeed(u,0)
endif
if(i<30)then
call SetUnitFlyHeight(u,GetUnitFlyHeight(u)+30,0)
endif
if i>=30 and i<40 or i>=140 and i<=160 then
call SetUnitFlyHeight(u,GetUnitFlyHeight(u)-30,0)
endif
if i>1 and i<41 then
if SR(GetUnitX(u),GetUnitY(u),GetLocationX(LoadLocationHandle(HH,id,7)),GetLocationY(LoadLocationHandle(HH,id,7)))>50 then
set d2=Angle2(GetUnitX(u),GetUnitY(u),GetLocationX(LoadLocationHandle(HH,id,7)),GetLocationY(LoadLocationHandle(HH,id,7)))
call MoveUnit(u,u,10+SR(GetUnitX(u),GetUnitY(u),GetLocationX(LoadLocationHandle(HH,id,7)),GetLocationY(LoadLocationHandle(HH,id,7)))/35,d2)
endif
endif
if(i==40)then
if LoadEffectHandle(HH,id,10)!=null then
call DestroyEffect(LoadEffectHandle(HH,id,10))
call SaveEffectHandle(HH,id,10,null)
endif
set soundplay=SndN(2730) // Sound\Music\mp3Music\GajeelT1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set soundplay=SndN(2733) // Sound\Music\mp3Music\GajeelTCircle.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
//war3mapImported\1028.mdl
call UnitCreateAndMove(u,'e2WO',u,d2,2,2,0.5,100,100,100,0,-50,u,0,d2)
call UnitCreateAndMove(u,'e2WO',u,d2,2,1,0.8,100,100,100,0,-300,u,0,d2)
call UnitCreateAndMove(u,'e2WO',u,d2,2,1,1.1,100,100,100,0,-500,u,0,d2)
endif
if i>=40 and i<=140 then
set i2=LoadInteger(HH,id,6)
set i2=i2+1
if i2==2 or i2==4 or i2==6 or i2==8 or i2==10 or i==40 then
call GroupClear(G)
call GroupEnumUnitsInRange(G,GetUnitX(u),GetUnitY(u),350,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(GetOwningPlayer(u),E) then
call UnitStop(E)
endif
call GroupRemoveUnit(G,E)
endloop
call GroupClear(G)
endif
if i2==10 or i==40 then

call GroupClear(G)
call GroupEnumUnitsInRange(G,GetUnitX(u),GetUnitY(u),350,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(GetOwningPlayer(u),E) and GetUnitAbilityLevel(E,'Avul')==0 then
call myCustomDamage(u,E,GetHeroStr(u,true),false,false,null,null,null)
call SlowUnit(u,E,0.6,0,4,0,false)
endif
call GroupRemoveUnit(G,E)
endloop
call GroupClear(G)
set i2=0
endif
call SaveInteger(HH,id,6,i2)
endif
if i==40 or i==60 or i==80 or i==100 or i==120 then
//war3mapImported\WindCirclefaster.mdl
call UnitCreateAndMove(u,'e2WI',u,GetRandomReal(0,360),1,GetRandomReal(1,1.5),GetRandomReal(0.6,0.8),100,100,100,GetRandomReal(40,50),-500,u,0,d2)
endif
if i<140 then
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SetUnitPathing(u,false)
call SetUnitFacingInstant(u,d2)
endif
if i==140 then
call UnitSpeed(u,1)
call SetUnitAnimationByIndex(u,0)
call SetUnitPathing(u,true)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
endif
if i==160 then
call RemoveLocation(LoadLocationHandle(HH,id,7))
call FlushChildHashtable(HH,id)
call PauseTimer(GetExpiredTimer())
call DestroyTimer(GetExpiredTimer())
endif
set u=null
endfunction
function Gajeel_Act takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveInteger(HH,id,5,0)
call SaveInteger(HH,id,6,0)
call SaveUnitHandle(HH,id,1,GetTriggerUnit())
call SaveLocationHandle(HH,id,7,GetSpellTargetLoc())
call SaveReal(HH,id,3,Angle2(GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()),SpellTargetLocX(),SpellTargetLocY()))
call PauseUnit(GetTriggerUnit(),true)
call SetUnitInvulnerable(GetTriggerUnit(),true)
call SetUnitPathing(GetTriggerUnit(),false)
call TimerStart(t,0.02,true,function GajeelTMove)
set t=null
endfunction
function InitTrig_Gajeel takes nothing returns nothing
local trigger Gajeel=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(Gajeel,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(Gajeel,Condition(function Gajeel_Cond))
call TriggerAddAction(Gajeel,function Gajeel_Act)
endfunction
function GoldenAppleCond takes nothing returns boolean
return GetSpellAbilityId()=='A1E0' and udg_B
endfunction
function GoldenAppleCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit l__d=LoadUnitHandle(HH,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local player p=GetOwningPlayer(u)
local integer i=10
if UnitIsAlive(l__d)then
call SetUnitX(LoadUnitHandle(HH,id,1), GetUnitX(l__d))
call SetUnitY(LoadUnitHandle(HH,id,1), GetUnitY(l__d))
call GroupEnumUnitsInRange(G,x,y,125,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if IsUnitType(E,UNIT_TYPE_HERO)and UnitIsAlive(l__d)then
if GetUnitTypeId(E)=='H06G' or GetUnitTypeId(E)=='H06H' or GetUnitTypeId(E)=='H06I' or GetUnitTypeId(E)=='H06J' or GetUnitTypeId(E)=='H06K' or GetUnitTypeId(E)=='H06L' then
    call StartAbilityCooldown(GetUnitAbility(E,'A1DZ'),0.1)
    call StartAbilityCooldown(GetUnitAbility(E,'A1DY'),0.1)
    call StartAbilityCooldown(GetUnitAbility(E,'A1DW'),0.1)
    call StartAbilityCooldown(GetUnitAbility(E,'A1DX'),0.1)
    call StartAbilityCooldown(GetUnitAbility(E,'A1DS'),0.1)
    loop
        if GetItemTypeId(UnitItemInSlot(E,i)) != 'I04V' and GetItemTypeId(UnitItemInSlot(E,i)) != 'I13R' and GetItemTypeId(UnitItemInSlot(E,i)) != 'IMDi'  then
            call StartItemCooldown(UnitItemInSlot(E, i),0.1)
        endif
    exitwhen i == 0
    set i=i - 1
    endloop
endif
call HealTextTag(u,E,GetUnitState(E,UNIT_STATE_MAX_LIFE)*0.5*myCustomHeal2(E,1),"HealthRes")
call HealTextTag(u,E,GetUnitState(E,UNIT_STATE_MAX_MANA)*0.5*myCustomMana2(E,1),"ManaRes")
call SetUnitState(E,UNIT_STATE_LIFE,GetWidgetLife(E)+GetUnitState(E,UNIT_STATE_MAX_LIFE)*0.5)
call SetUnitState(E,UNIT_STATE_MANA,GetWidgetLife(E)+GetUnitState(E,UNIT_STATE_MAX_MANA)*0.5)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl",E,"origin"))
call KillUnit(l__d)
endif
call GroupRemoveUnit(G,E)
endloop
set n=LoadUnitHandle(h,GetHandleId(u),SH_arrow)//
if n!=null then
if SR(x,y,GetUnitX(n),GetUnitY(n))<160 then
call StartAbilityCooldown(GetUnitAbility(u,'A1DZ'),0.1)
call StartAbilityCooldown(GetUnitAbility(u,'A1DY'),0.1)
call StartAbilityCooldown(GetUnitAbility(u,'A1DW'),0.1)
call StartAbilityCooldown(GetUnitAbility(u,'A1DX'),0.1)
call StartAbilityCooldown(GetUnitAbility(u,'A1DS'),0.1)
loop
    //call BJDebugMsg(I2S(GetHandleId(UnitItemInSlot(u, i))) + " " + I2S(GetHandleId(GetAbilityOwningItem(LoadAbilityHandle(h,id,45)))) )
    if GetItemTypeId(UnitItemInSlot(u,i)) != 'I04V' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I13R' and GetItemTypeId(UnitItemInSlot(u,i)) != 'IMDi'  then
        call StartItemCooldown(UnitItemInSlot(u, i),0.1)
    endif
exitwhen i == 0
set i=i - 1
endloop
call HealTextTag(u,E,GetUnitState(E,UNIT_STATE_MAX_LIFE)*0.5*myCustomHeal2(E,1),"HealthRes")
call HealTextTag(u,E,GetUnitState(E,UNIT_STATE_MAX_MANA)*0.5*myCustomMana2(E,1),"ManaRes")
call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.5)
call SetUnitState(u,UNIT_STATE_MANA,GetWidgetMana(u)+GetUnitState(u,UNIT_STATE_MAX_MANA)*0.5)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl",u,"origin"))
call KillUnit(l__d)
endif
endif
else
call PauseTimer(t)
call RemoveUnit(LoadUnitHandle(HH,id,1))
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set u=null
set l__d=null
set t=null
endfunction
