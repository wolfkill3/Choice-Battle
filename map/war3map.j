function Jinoka2Cast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local group g=LoadGroupHandle(h,id,1)
local integer i=1
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local real x1
local real y1
local real a
local group g2=CreateGroup()
local group gn=CreateGroup()
local player p=GetOwningPlayer(u)
local integer l__s=SH_block
local real dist=LoadReal(h,id,100)
call SetUnitInvulnerable(u,true)
call GroupEnumUnitsInRange(g2,x,y,600,Base)
call SaveReal(h,id,100,dist+0.25)
call SetUnitAnimation(u,"attack")
call GroupClear(gn)
call GroupRemoveUnit(g2,u)
loop
set E=FirstOfGroup(g2)
exitwhen E==null
if Condition_Base(p,E)then
call GroupAddUnit(gn,E)
endif
call GroupRemoveUnit(g2,E)
endloop
set n10=null
set n10=GetRandomUnitFromGroup2(gn)
if n10!=null then
set x1=GetUnitX(n10)
set y1=GetUnitY(n10)
set a=Atan2(y1-y,x1-x)+GetRandomReal(-0.5,0.5)
set x1=x1+100*Cos(a)
set y1=y1+100*Sin(a)
call SetUnitXY_1(u,x1,y1, false)
call SetUnitFacingInstant(u,Atan2(GetUnitY(n10)-y1,GetUnitX(n10)-x1)*bj_RADTODEG)
call IssueTargetOrder(u,"attack",n10)
call UnitAttackRestart(u)
else
call SetUnitX(u,x+GetRandomReal(-400,400))
call SetUnitY(u,y+GetRandomReal(-400,400))
endif
if dist>=1.5+0.5*GetUnitAbilityLevel(u,'A08M')then
call ForGroup(g,function KillGroup)
call UnitRemoveAbility(u,'A3GN')
call UnitRemoveAbility(u,'A06I')
call SetUnitFlyHeight(u,0,0)
call SetUnitTimeScale(u,1)
call SetUnitTurnSpeed(u,1)
call DestroyGroup(g)
call GroupClear(g2)
call DestroyGroup(g2)
call DestroyTimer(t)
call SetUnitInvulnerable(u,false)
call FlushChildHashtable(h,id)
endif
call DestroyGroup(gn)
set g=null
set u=null
set t=null
set p=null
endfunction
function Jinoka2Cast takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1
local real y1
local real a
local player p=GetOwningPlayer(u)
local group g=CreateGroup()
local integer i=1
local integer l__s=SH_block
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
loop
exitwhen i>=19
set x1=x+470*Cos(i*0.3491)
set y1=y+470*Sin(i*0.3491)
set a=Atan2(y-y1,x-x1)
call GroupAddUnit(g,CreateUnit(p,'e03C',x1,y1,a*bj_RADTODEG))
set i=i+1
endloop
call GroupAddUnit(g,CreateUnit(p,'e082',x,y,a*bj_RADTODEG))
call UnitAddAbility(u,'A06I')
//call UnitAddAbility(u,'A0IG')
call UnitAddAbility(u,'A3GN')
call SetUnitTimeScale(u,4)
call SetUnitTurnSpeed(u,3)
call SetUnitInvulnerable(u,true)
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,1,g)
set soundplay=SndN(954) // Sound\Music\mp3Music\Jiunoka.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,.25,true,function Jinoka2Cast2)
set p=null
set u=null
set t=null
endfunction
