        endloop
    elseif TotalPlayerCount!=1 then
        call SetSpecialEffectVertexColour(Tower,255,255,255,255)
        call SetUnitOwner(TowerUnit,Player(PLAYER_NEUTRAL_PASSIVE),false)
    endif
endif
