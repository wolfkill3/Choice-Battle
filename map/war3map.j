function OmegaBlastCond takes nothing returns boolean
return GetSpellAbilityId()=='A0JK' and udg_B==true
endfunction
function OmegaBlastCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local integer i=1
local player p=GetOwningPlayer(u)
local real x=LoadReal(h,id,5)
local real y=LoadReal(h,id,6)
local real x1=LoadReal(h,id,1)
local real y1=LoadReal(h,id,2)
local real a=Atan2(y1-y,x1-x)
local real dmg=GetHeroStr(u,true)*11
local real hei=GetUnitFlyHeight(u)
local real time=LoadReal(h,id,7)
if time==0 then
call SetUnitAnimationByIndex(u,36)
call SetUnitTimeScale(u,1.2)
endif
call SaveReal(h,id,7,time+0.02)
if time>=1.8 then
set x=x+50*Cos(a)
set y=y+50*Sin(a)
set n=CreateUnit(p,'e2E5',x,y,a)
call SetUnitFlyHeight(n,hei+30,0)
call SetUnitScale(n,2.5,2.5,2.5)
if SR(x,y,x1,y1)>400 then
call OmegaBlastFly(u,n,SR(x,y,x1,y1)/40,0,x1,y1,hei+30,dmg)
else
call OmegaBlastFly3(u,n,SR(x,y,x1,y1)/50,0,x1,y1,hei+30,dmg)
endif
//set soundplay=CreateSound("Sound\\Music\\mp3Music\\BrolyBeam.mp3",false,false,true,12700,12700,"")
//call StartSound(soundplay)
//call KillSoundWhenDone(soundplay)
call UnitRemoveAbility(u,'A0JI')
call SetUnitTimeScale(u,1)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set p=null
set t=null
endfunction
function OmegaBlastCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
call UnitAddAbility(u,'Arav')
call UnitAddAbility(u,'A0JI')
call UnitRemoveAbility(u,'Arav')
call SetUnitFlyHeight(u,350,450)
call SaveUnitHandle(h,id,0,u)
set EFF=AddSpecialEffect("war3mapImported\\BrolyCompression.mdx",GetUnitX(u)+75*Cos(a),GetUnitY(u)+75*Sin(a))
call SetSpecialEffectZ(EFF,455)
call SetSpecialEffectTimeScale(EFF , 0.28)
call SetSpecialEffectScale(EFF , 2)
call RemoveEffect(EFF,1.7,false,CreateTimer())
set n=CreateUnit(p,'e06G',GetUnitX(u),GetUnitY(u),GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',4)
call SetUnitTimeScale(n,0.3)
// set n=CreateUnit(p,'e0EL',GetUnitX(u),GetUnitY(u),GetRandomReal(0,359))
// call UnitApplyTimedLife(n,'BTLF',4)
// call SetUnitTimeScale(n,0.2)
// set n=CreateUnit(p,'e0EF',GetUnitX(u),GetUnitY(u),GetRandomReal(0,359))
// call UnitApplyTimedLife(n,'BTLF',4)
// call SetUnitTimeScale(n,1)
set n=CreateUnit(p,'e0EH',GetUnitX(u),GetUnitY(u),GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',4)
call SetUnitTimeScale(n,1)
set n=CreateUnit(p,'e0EG',GetUnitX(u),GetUnitY(u),GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',4)
call SaveReal(h,id,1,x1)
call SaveReal(h,id,2,y1)
call SaveReal(h,id,5,x)
call SaveReal(h,id,6,y)
call SaveReal(h,id,7,0)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(1381) // Sound\Music\mp3Music\BrolySuperBomb.mp3
else
set soundplay=SndN(1383) // Sound\Music\mp3Music\Broly\BrolySuperBomb-jap.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.02,true,function OmegaBlastCast2)
set u=null
set t=null
set p=null
endfunction
function OmegaBlastInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function OmegaBlastCast)
call TriggerAddCondition(t,Condition(function OmegaBlastCond))
set t=null
endfunction
function GiganticMeteorCond takes nothing returns boolean
return GetSpellAbilityId()=='A0JH'
endfunction
function GiganticMeteorCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local group g=LoadGroupHandle(h,id,6)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real x2
local real y2
local real sp=45
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,5)
local real a2
local player p=GetOwningPlayer(u)
local real dmg=GetHeroStr(u,true)*(GetUnitAbilityLevel(u,'A0JH')+3)
if SR(x,y,x1,y1)<=1750 and IsTerrainPathable(GetUnitX(l__d),GetUnitY(l__d),PATHING_TYPE_FLYABILITY)==false then
call GroupEnumUnitsInRange(G,x1,y1,150,Base)
loop
    set E=FirstOfGroup(G)
    exitwhen E==null
    if Condition_Base(p,E)then
        set x2=GetUnitX(E)
        set y2=GetUnitY(E)
        if IsUnitIllusion(E)==false then
            set sp=sp-7
        endif
        set a2=Atan2(y2-y1,x2-x1)
        call SetUnitPosition(E,x2-58*Cos(a2),y2-58*Sin(a2))
        if IsUnitInGroup(E,g)==false then
            call GroupAddUnit(g,E)
            if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
                call PauseUnit(E,true)
                call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,true)
                call SetUnitPathing(E,false)
            else
                call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,u)
            endif
        endif
    endif
    call GroupRemoveUnit(G,E)
endloop
call SetUnitX(l__d,x1+sp*Cos(a))
call SetUnitY(l__d,y1+sp*Sin(a))
else
loop
set E=FirstOfGroup(g)
exitwhen E==null
call SetUnitFlyHeight(E,0,GetUnitFlyHeight(E))
call GroupRemoveUnit(g,E)
call PauseUnit(E,false)
call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,false)
call SetUnitPathing(E,true)
endloop
call UnitApplyTimedLife(CreateUnit(p,'e0EB',x1,y1,GetRandomReal(0,359)),'BHwe',3)
call UnitApplyTimedLife(CreateUnit(p,'e0E9',x1,y1,GetRandomReal(0,359)),'BHwe',3)
call UnitApplyTimedLife(CreateUnit(p,'e0EM',x1,y1,GetRandomReal(0,359)),'BHwe',5)
call UnitApplyTimedLife(CreateUnit(p,'e0EN',x1,y1,GetRandomReal(0,359)),'BHwe',3)
call GroupEnumUnitsInRange(DG,x1,y1,500,Base)
loop
set E=FirstOfGroup(DG)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(DG,E)
endloop
call FlushChildHashtable(h,id)
call DestroyTimer(t)
call DestroyGroup(g)
call RemoveUnit(l__d)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function GiganticMeteorCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
local unit l__d=CreateUnit(GetOwningPlayer(u),'e0EC',x+80*Cos(f*bj_RADTODEG),y+80*Sin(f*bj_RADTODEG),f)
call SetUnitColor(l__d,PLAYER_COLOR_GREEN)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,l__d)
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveReal(h,id,5,a)
call SaveGroupHandle(h,id,6,CreateGroup())
set soundplay=SndN(1385) // Sound\Music\mp3Music\BrolyCast.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.02,true,function GiganticMeteorCast2)
set u=null
set t=null
set l__d=null
endfunction
function InitTrig_GiganticMeteor takes nothing returns nothing
set gg_trg_GiganticMeteor=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_GiganticMeteor,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_GiganticMeteor,Condition(function GiganticMeteorCond))
call TriggerAddAction(gg_trg_GiganticMeteor,function GiganticMeteorCast)
endfunction
function CondGiganticBlast takes nothing returns boolean
return GetSpellAbilityId()=='A0JF'
endfunction
function GiganticBlastCast2 takes nothing returns nothing //broly w
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local player p=GetOwningPlayer(u)
local integer idu=GetPlayerId(p)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local group g=LoadGroupHandle(h,id,6)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,8)
local real time=LoadReal(h,id,10)
local real dmg=GetHeroStr(u,true)*(GetUnitAbilityLevel(u,'A0JF')+1)
local real Range=LoadReal(h,id,9)
local unit c=LoadUnitHandle(h,id,11)
local real time2=LoadReal(h,id,12)
if time==0 then
    call SetUnitAnimationByIndex(u,35)
    call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BrolyCompression2.mdx",l__d,"origin"))
endif
if time<time2 then
    if LoadInteger(h,id,2)!=0 and time<time2-0.03 then
        if time==0 then
            set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+45)
            call SetUnitVertexColor(n,255,255,255,155)
            call UnitApplyTimedLife(n,'BTLF',0.4)
            call SetUnitTimeScale(n,3)
            set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG-45)
            call SetUnitVertexColor(n,255,255,255,155)
            call UnitApplyTimedLife(n,'BTLF',0.4)
            call SetUnitTimeScale(n,3)
            set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG)
            call SetUnitVertexColor(n,255,255,255,155)
            call UnitApplyTimedLife(n,'BTLF',0.4)
            call SetUnitTimeScale(n,3)
        endif
        set x1=x1+(35-(2+time*5)*(2+time*5))*Cos(a)
        set y1=y1+(35-(2+time*5)*(2+time*5))*Sin(a)
        if IsTerrainPathable(x1,y1,PATHING_TYPE_FLYABILITY)==false then
            call SetUnitXY_1(u,x+(35-(2+time*5)*(2+time*5))*Cos(a),y+(35-(2+time*5)*(2+time*5))*Sin(a), false)
            call SetUnitXY_1(l__d,x1,y1, false)
        endif
    endif
    call SaveReal(h,id,10,LoadReal(h,id,10)+0.03)
    if time<0.35 and c==null and IsTerrainPathable(x1+15*Cos(a),y1+15*Sin(a),PATHING_TYPE_FLYABILITY)==false then
        call SetUnitXY_1(l__d,x1+15*Cos(a),y1+15*Sin(a), false)
    elseif IsTerrainPathable(x1+15*Cos(a),y1+15*Sin(a),PATHING_TYPE_FLYABILITY)==false then
        call SetUnitXY_1(l__d,x1+5*Cos(a),y1+5*Sin(a), false)
        call PauseUnit(c,true)
        call SetUnitXY_1(c,x1+20*Cos(a),y1+20*Sin(a), false)
    endif
    if c==null and (time==0.15 or (time<time2-0.03 and LoadInteger(h,id,2)!=0)) then
        call GroupEnumUnitsInRange(G,x1+20*Cos(a),y1+20*Sin(a),160,Base)
        loop
            set E=FirstOfGroup(G)
            exitwhen E==null
            if Condition_Base(p,E) then
                call SaveUnitHandle(h,id,11,E)
                call SaveReal(h,id,12,0.7)
                call SetUnitTimeScale(u,0.55)
                if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
                    call PauseUnit(E,true)
                    call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,true)
                    call SetUnitXY_1(E,x1+20*Cos(a),y1+20*Sin(a), false)
                else
                    call RemoveUnit(l__d)
                    call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,u)
                    call SaveReal(h,id,10,10)
                    call PauseUnit(u,false)
                    call SetUnitInvulnerable(u,false)
                endif
                call GroupClear(G)
            endif
            call GroupRemoveUnit(G,E)
        endloop
        call GroupClear(G)
    endif
    if time>=time2-0.03 then
        set soundplay=SndN(1387) // Sound\Music\mp3Music\BrolyBeam.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        call SetUnitScale(l__d,0.33,0.33,0.33)
        call SetUnitTimeScale(u,1)
        call PauseUnit(u,false)
        call SetUnitInvulnerable(u,false)
        //call UnitRemoveAbility(l__d,'A1JE')
        //call UnitAddAbility(l__d,'A0JE')
    endif
// полёт только без пойманной цели: если враг был перед Броли при пуске (c),
// снаряд взрывается сразу, а враг сам отлетает на 350 (см. взрыв ниже)
elseif c==null and Range<2000 and UnitIsAlive(l__d) and IsTerrainPathable(x1,y1,PATHING_TYPE_FLYABILITY)==false then
    set x1=x1+50*Cos(a)
    set y1=y1+50*Sin(a)
    call SetUnitXY_1(l__d,x1,y1, false)
    call PauseUnit(c,true)
    call SetUnitXY_1(c,x1+25*Cos(a),y1+25*Sin(a), false)
    call SaveReal(h,id,3,x1)
    call SaveReal(h,id,4,y1)
    call SetUnitFacing(l__d,a*bj_RADTODEG)
    call SaveReal(h,id,9,Range+50)
    call GroupEnumUnitsInRange(g,x1,y1,150,Base)
    set idg=GetHandleId(g)
    loop
        set E=FirstOfGroup(g)
        exitwhen E==null
        set ide=GetHandleId(E)
        if Condition_Base(p,E) and E!=c then
            call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\GreenSlam.mdl",E,"chest"))
            if E!=LoadUnitHandle(h,idg,ide) then
                call myCustomDamage(u,E,dmg,false,false,null,null,null)
                call SetControlToUnit(E,E, 1, "stun")
                call SaveUnitHandle(h,idg,ide,E)
                call Push(E,90,Atan2(GetUnitY(E)-y1,GetUnitX(E)-x1),270)
            endif
        endif
        call GroupRemoveUnit(g,E)
    endloop
    call GroupClear(g)
else
    if c==null then
    set EFF=AddSpecialEffect("BrolyExplosion1.mdl", x1,y1)
    call SetSpecialEffectScale(EFF , 1)
    call DestroyEffect(EFF)
    call UnitApplyTimedLife(CreateUnit(p,'e0EB',x1,y1,GetRandomReal(0,359)),'BHwe',3)
    call UnitApplyTimedLife(CreateUnit(p,'e0E9',x1,y1,GetRandomReal(0,359)),'BHwe',3)
    call UnitApplyTimedLife(CreateUnit(p,'e0EN',x1,y1,GetRandomReal(0,359)),'BHwe',3)
    else
    // взрыв вплотную. Шаровые взрывы — на земле, как у обычного взрыва, но мельче
    // (x0.2 от масштаба юнитов) и с анимацией в 2 раза быстрее
    set EFF=AddSpecialEffect("BrolyExplosion1.mdl", x1,y1)
    call SetSpecialEffectScale(EFF , 0.2)
    call SetSpecialEffectTimeScale(EFF , 2)
    call DestroyEffect(EFF)
    set EFF=AddSpecialEffect("BrolyExplosion3.mdl", x1,y1)
    call SetSpecialEffectScale(EFF , 0.2)
    call SetSpecialEffectTimeScale(EFF , 2)
    call RemoveEffect(EFF,1.5,true,CreateTimer())
    // пыль. GreenSlam — на земле без поворота, как у обычного взрыва; остальная — к врагу (наклон -90, высота 100)
    set EFF=AddSpecialEffect("war3mapImported\\GreenSlam.mdl", x1,y1)
    call SetSpecialEffectScale(EFF , 3.2)
    call RemoveEffect(EFF,3,true,CreateTimer())
    set EFF=AddSpecialEffect("war3mapImported\\GreenShockwave.mdl", x1,y1)
    call SetSpecialEffectOrientation(EFF,Atan2(GetUnitY(c)-y1,GetUnitX(c)-x1)*bj_RADTODEG,-90,0)
    call SetSpecialEffectZ(EFF , 100)
    call SetSpecialEffectScale(EFF , 2.4)
    call RemoveEffect(EFF,3,true,CreateTimer())
    // пыль из взрыва щита E2 (WarStompCaster), зелёная, к врагу
    set EFF=AddSpecialEffect("war3mapImported\\WarStompCaster.mdx", x1,y1)
    call SetSpecialEffectOrientation(EFF,Atan2(GetUnitY(c)-y1,GetUnitX(c)-x1)*bj_RADTODEG,-90,0)
    call SetSpecialEffectZ(EFF , 100)
    call SetSpecialEffectScale(EFF , 2)
    call SetSpecialEffectVertexColour(EFF,90,255,90,255)
    call DestroyEffect(EFF)
    // поток на врага, горизонтально (как у ударов Гоку)
    set EFF=AddSpecialEffect("WindVectorPush.mdx", x1, y1)
    call SetSpecialEffectOrientation(EFF,Atan2(GetUnitY(c)-y1,GetUnitX(c)-x1)*bj_RADTODEG,0,0)
    call SetSpecialEffectZ(EFF , 100)
    call SetSpecialEffectScale(EFF , 0.69)
    call SetSpecialEffectTimeScale(EFF , 0.75)
    call SetSpecialEffectVertexColour(EFF,120,255,120,160)
    call RemoveEffect(EFF,1.35,true,CreateTimer())
    // ударная волна EffectID[6] (Signum\CF2.mdl) с лёгким зелёным оттенком, на врага
    set EFF=AddSpecialEffect(EffectID[6], x1, y1)
    call SetSpecialEffectOrientation(EFF,Atan2(GetUnitY(c)-y1,GetUnitX(c)-x1)*bj_RADTODEG,0,0)
    call SetSpecialEffectZ(EFF , 60)
    call SetSpecialEffectVertexColour(EFF,190,255,190,255)
    call DestroyEffect(EFF)
    endif
    call GroupEnumUnitsInRange(g,x1,y1,500,Base)
    set idg=GetHandleId(g)
    loop
        set E=FirstOfGroup(g)
        exitwhen E==null
        set ide=GetHandleId(E)
        if Condition_Base(p,E) and E!=LoadUnitHandle(h,idg,ide) then
            if E!=c then
                call myCustomDamage(u,E,dmg,false,false,null,null,null)
                call SetControlToUnit(E,E, 1, "stun")
            else
                call PauseUnit(c,false)
                call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
                call myCustomDamage(u,E,dmg*1.1,false,false,null,null,null)
                call SetControlToUnit(E,E, 3, "stun")
                // вместо полёта со снарядом — отлёт на 350
                call Push3(E,50,a,350,"")
            endif
        endif
        call GroupRemoveUnit(g,E)
    endloop
    call GroupClear(g)
    call DestroyGroup(g)
    call RemoveUnit(l__d)
    call FlushChildHashtable(h,id)
    call FlushChildHashtable(h,idg)
    call PauseTimer(t)
    call DestroyTimer(t)
endif
set u=null
set c=null
set p=null
set g=null
set t=null
set l__d=null
endfunction
function CastGiganticBlast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,6,CreateGroup())
call SaveReal(h,id,8,a)
call SaveReal(h,id,10,0)
call SaveReal(h,id,12,0.35)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
if HaveSavedInteger(h,GetHandleId(u),SH_BrolyQ)==true then
call SaveInteger(h,id,2,LoadInteger(h,GetHandleId(u),SH_BrolyQ))
call SaveInteger(h,GetHandleId(u),SH_BrolyQ,0)
else
call SaveInteger(h,id,2,0)
endif
call SetUnitTimeScale(u,0.9)
call RemoveEffect(AddSpecialEffectTarget("war3mapImported\\BrolyCompression.mdx",u,"right hand"),0.2,false,CreateTimer())
set n=CreateUnit(GetOwningPlayer(u),'e1E5',x-90*Cos(a+35*bj_DEGTORAD),y-90*Sin(a+35*bj_DEGTORAD),a*bj_RADTODEG)
call SetUnitScale(n,0.2,0.2,0.2)
call SaveUnitHandle(h,id,1,n)
call TimerStart(t,0.03,true,function GiganticBlastCast2)
set u=null
set t=null
endfunction
function GiganticBlastInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function CastGiganticBlast)
call TriggerAddCondition(t,Condition(function CondGiganticBlast))
set t=null
endfunction
function EraserCannonMissleMovePoint2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
local player p=GetOwningPlayer(l__d)
local integer idu=GetPlayerId(p)
local real dmg=LoadReal(h,id,5)
if SR(x,y,x1,y1)>30 then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
else
call GroupEnumUnitsInRange(G,x1,y1,200,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(Hero[idu],E,dmg,false,false,null,null,null)
call SlowUnit(Hero[idu],E,0.5,0,5,0,false)
endif
call GroupRemoveUnit(G,E)
endloop
call UnitApplyTimedLife(CreateUnit(p,'e0E6',x1,y1,GetRandomReal(0,359)),'BHwe',1)
call UnitApplyTimedLife(CreateUnit(p,'e0E7',x1,y1,GetRandomReal(0,359)),'BHwe',1)
call UnitApplyTimedLife(CreateUnit(p,'e0E8',x1,y1,GetRandomReal(0,359)),'BHwe',1)
set soundplay=SndN(1280) // Sound\Music\mp3Music\PunchStrike.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set l__d=null
set t=null
endfunction
function EraserCannonMissleMovePoint takes unit l__d,real speed,real angle,real x,real y,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,dmg)
call TimerStart(t,0.03,true,function EraserCannonMissleMovePoint2)
set t=null
endfunction
function EraserCannonCond takes nothing returns boolean
return GetSpellAbilityId()=='A0JD'
endfunction
function EraserCannonCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local player p=GetOwningPlayer(u)
local real dmg=(0.7+0.3*GetUnitAbilityLevel(u,'A0JD'))*GetHeroStr(u,true)
if GetUnitCurrentOrder(u)==OrderId("channel")then
call SetUnitAnimation(u,"Spell channel throw one")
set n=CreateUnit(p,'e0E5',x,y,Atan2(y1-y,x1-x)*bj_RADTODEG)
call EraserCannonMissleMovePoint(n,50,0,x1+GetRandomReal(-400,400),y1+GetRandomReal(-400,400),dmg)
else
call SetUnitAnimation(u,"stand")
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set t=null
endfunction
