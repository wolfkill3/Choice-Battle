function GaaraRAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local unit Dummy=LoadUnitHandle(HH,id,20)
local real x0=LoadReal(HH,id,11)
local real y0=LoadReal(HH,id,12)
local real dist=LoadReal(HH,id,8)
local real damage=LoadReal(HH,id,15)
set time=time+0.02
call SaveReal(HH,id,5,time)
if dist==2040 then
call DestroyGroup(LoadGroupHandle(HH,id,4))
call UnitSpeed(Dummy,1)
call UnitSize(Dummy,0.75,1,1)
call MoveUnit(Dummy,Dummy,-300,facing)
call SetUnitAnimationByIndex(Dummy,1)
call MyRemoveUnit(Dummy,1)

call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())


else
if dist==1500 then
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(Dummy),GetUnitY(Dummy),facing)
call SetUnitModel(n0,"Gaara\\[NL]GaaraEffect_SandBall2.mdl")
call UnitSize(n0,1,1,1)
call MoveUnit(n0,n0,300,facing)
call SetUnitFlyHeight(n0,0,0)
call UnitSpeed(n0,0.5)
call MyRemoveUnit(n0,10)
call SaveUnitHandle(HH,GetHandleId(caster),StringHash("GaaraRU"),n0)
call SetUnitAnimationByIndex(n0,1)
endif

if dist>1500 then
call UnitSize(LoadUnitHandle(HH,GetHandleId(caster),StringHash("GaaraRU")),1+(dist-1500)*0.0058,1,1)
endif

if dist==1800 then
call UnitAddAbility(LoadUnitHandle(HH,GetHandleId(caster),StringHash("GaaraRU")),'ASGS')
call UnitSpeed(LoadUnitHandle(HH,GetHandleId(caster),StringHash("GaaraRU")),0)
endif

if time==0.02 then
call UnitSpeed(caster,1)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
call SetUnitModel(n0,"Gaara\\[NL]GaaraEffect_SandBall2.mdl")
call UnitSize(n0,0.75,1,1)
call SetUnitFlyHeight(n0,0,0)
call UnitSpeed(n0,0.5)
call MyRemoveUnit(n0,3)
call SetUnitAnimationByIndex(n0,1)
call UnitSpeed(caster,1)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
call SetUnitModel(n0,"Gaara\\[NL]GaaraLavina.mdl")
call MoveUnit(n0,n0,-300,facing)
call UnitSize(n0,1,1,1)
call SetUnitFlyHeight(n0,0,0)
call UnitSpeed(n0,1.25)
call SaveUnitHandle(HH,id,20,n0)
call SetUnitAnimationByIndex(n0,0)
set n0=null
endif

if time>0 and time<0.5 then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
endif

if time==0.5 then
call SaveGroupHandle(HH,id,4,CreateGroup())
call UnitSpeed(caster,1)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
endif

if time>0.5 then
call MoveUnit(Dummy,Dummy,30,facing)
call SaveReal(HH,id,8,dist+30)
call DamageAoeOneTime3(caster,GetUnitX(Dummy),GetUnitY(Dummy),325+(time-0.5)*350,damage,LoadGroupHandle(HH,id,4),R2I((1.8-time)*25+5),20,facing)
endif

endif
set Dummy=null
set caster=null
endfunction


