return GetSpellAbilityId()=='A0JZ' and udg_B==true
endfunction
function CastChocolateBeam2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real a=LoadReal(h,id,4)
local real dist=LoadReal(h,id,10)
local real time=LoadReal(h,id,11)
local real x=GetUnitX(l__d)+30*Cos(a)
local real y=GetUnitY(l__d)+30*Sin(a)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real dmg=(2+GetUnitAbilityLevel(u,'A0JZ'))*GetHeroStr(u,true)+100
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,3)
if time>=0.44 and time<0.45 then
//call SetUnitAnimation(u,"Spell Slam")
//call UnitApplyTimedLife(CreateUnit(p,'e0D7',x1-25*Cos(a+90*bj_DEGTORAD),y1-25*Sin(a+90*bj_DEGTORAD),GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0DA',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0DB',x1+45*Cos(a),y1+45*Sin(a),a*bj_RADTODEG),'BTLF',1)
endif
if time>=0.4 and time<0.41 then
set soundplay=SndN(1425) // Sound\Music\mp3Music\ChocolateBeam.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SetUnitTimeScale(u,1)
set n=CreateUnit(GetOwningPlayer(u),'e0D9',x1,y1,a*bj_RADTODEG)
call SaveUnitHandle(h,id,1,n)
call SetUnitColor(n,PLAYER_COLOR_PINK)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
endif
call SaveReal(h,id,11,time+0.017)
if dist>0 and IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false and time>0.41 and time<6 then
call SetUnitXY_1(l__d,x,y, false)
set n=CreateUnit(p,'e0D5',x,y,a*bj_RADTODEG)
call SetUnitTimeScale(n,0)
call SetUnitColor(n,PLAYER_COLOR_PINK)
call UnitApplyTimedLife(n,'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0D8',x,y,GetRandomReal(0,359)),'BTLF',1)
call GroupEnumUnitsInRange(g,x,y,150,Base)
set idg=GetHandleId(g)
call SaveReal(h,id,10,dist-30)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then


//call UnitAddAbilityTimed(caster,30,'BuuK')
call UnitAddAbility(E,'BuuK')
call UnitAddAbilityTimed(E,3,'BuuC')
call UnitMakeAbilityPermanent(E,true,'BuuC')
call myCustomDamage(u,E,dmg,false,false,null,null,null)


if IsUnitInvulnerable(E)==false then
set n=CreateUnit(p,'h019',x,y,0)
call UnitAddAbility(n,'A0K0')
call UnitApplyTimedLife(n,'BHwe',1)
call IssueTargetOrder(n,"hex",E)
call SetControlToUnit(E,E, 0.1, "stun")
else
call IssueImmediateOrder(E,"stop")
endif

call UnitRemoveAbility(E,'BuuK')


call SaveUnitHandle(h,idg,ide,E)
endif



call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
elseif time>0.9 then
call GroupEnumUnitsInRange(g,x,y,400,Base)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)


call UnitAddAbilityTimed(E,3,'BuuC')
call UnitMakeAbilityPermanent(E,true,'BuuC')

endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
call ShakeCamera(0.5,20)
call UnitApplyTimedLife(CreateUnit(p,'e0DC',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0DF',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0DE',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0DD',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0C7',x,y,(a*bj_RADTODEG)),'BTLF',6)
call StartSound(soundStr[47])
call RemoveUnit(l__d)
call FlushChildHashtable(h,GetHandleId(g))
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
function CastChocolateBeam takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local effect e
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,3,CreateGroup())
call SaveReal(h,id,4,a)
call SaveReal(h,id,11,0)
call SaveReal(h,id,10,3500)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SetUnitAnimation(u,"Spell Slam")
call SetUnitTimeScale(u,1)
call UnitApplyTimedLife(CreateUnit(p,'e0D7',x-25*Cos(a+90*bj_DEGTORAD),y-25*Sin(a+90*bj_DEGTORAD),GetRandomReal(0,359)),'BTLF',1)
set e=AddSpecialEffectTarget("war3mapImported\\gallit gun.mdx",u,"chest")
call RemoveEffect(e,0.5,true,CreateTimer())
call TimerStart(t,0.017,true,function CastChocolateBeam2)
set u=null
set p=null
set e=null
set t=null
endfunction
