function GetFramePointName takes framehandle fr, framepointtype frtype returns string
local framepointtype lol=GetFrameRelativePointType(fr,frtype)
if lol==FRAMEPOINT_LEFT then
set lol=null
return "FRAMEPOINT_LEFT"
endif
if lol==FRAMEPOINT_CENTER then
set lol=null
return "FRAMEPOINT_CENTER"
endif
if lol==FRAMEPOINT_RIGHT then
set lol=null
return "FRAMEPOINT_RIGHT"
endif
if lol==FRAMEPOINT_TOP then
set lol=null
return "FRAMEPOINT_TOP"
endif
if lol==FRAMEPOINT_TOPRIGHT then
set lol=null
return "FRAMEPOINT_TOPRIGHT"
endif
if lol==FRAMEPOINT_BOTTOMLEFT then
set lol=null
return "FRAMEPOINT_BOTTOMLEFT"
endif
if lol==FRAMEPOINT_BOTTOM then
set lol=null
return "FRAMEPOINT_BOTTOM"
endif
if lol==FRAMEPOINT_BOTTOMRIGHT then
set lol=null
return "FRAMEPOINT_BOTTOMRIGHT"
endif
if lol==FRAMEPOINT_TOPLEFT then
set lol=null
return "FRAMEPOINT_TOPLEFT"
endif
set lol=null
return "nothing"
endfunction
