//call SaveReal(h,GetHandleId(Gon),StringHash("kill"),40)
//call CreateModeIndicatorWithPauseB(Gon, "|c00FF8000Gon's Rage:", 40.0)
//call TimerStart(t,0.1,true,function GonsRage2)
call UnitApplyTimedLife(CreateUnit(p,'e0LA',x,y,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0L8',x,y,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0L9',x,y,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0C7',x,y,0),'BTLF',6)
call UnitApplyTimedLife(CreateUnit(p,'e01O',x,y,0),'BTLF',1.1)
call UnitApplyTimedLife(CreateUnit(p,'e0AX',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0AW',x,y,GetRandomReal(0,359)),'BTLF',0.01)
call UnitApplyTimedLife(CreateUnit(p,'e0B1',x,y,GetRandomReal(0,359)),'BTLF',0.4)
call UnitApplyTimedLife(CreateUnit(p,'e0B4',x,y,GetRandomReal(0,359)),'BTLF',0.4)
call UnitApplyTimedLife(CreateUnit(p,'e0AZ',x,y,GetRandomReal(0,359)),'BTLF',0.4)
call UnitApplyTimedLife(CreateUnit(p,'e0B3',x,y,GetRandomReal(0,359)),'BTLF',0.4)
set soundplay=SndN(2026) // Sound\Music\mp3Music\GonTransformation.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call UnitAddAbility(Gon,'A0UA')
call UnitAddAbility(Gon,'A0UE')
endif
call SetUnitAbilityLevel(Gon,'A0U8',GetUnitAbilityLevel(Gon,'A0U8')+1)
set p=null
set t=null
endfunction

function GonG_Periodic takes nothing returns nothing
    local integer id = GetHandleId(GetExpiredTimer())
    local unit caster = Gon
    local real caster_x = GetUnitX(caster)
    local real caster_y = GetUnitY(caster)
    local real time = LoadReal(h, id, 1)
    local player p=GetOwningPlayer(caster)
    if (time<=3.0 or GetUnitAbilityLevel(caster, 'B07C')>=1) and udg_B and DU2 then
        call SaveReal(h, id, 1, time+0.1)
        if time<3.0 then
            call SetUnitInvulnerable(caster, true)
            call PauseUnit(caster, true)
            set bjLCU = CreateUnit(GetOwningPlayer(caster), 'dH49', caster_x, caster_y, GetRandomInt(0, 360))
            call SetUnitFlyHeight(bjLCU, 75, 0)
            call SetUnitAnimation(bjLCU, "birth")
            call MyRemoveUnit(bjLCU, 2)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR48', caster_x, caster_y, GetRandomInt(0, 360))
            call SetUnitScale(bjLCU, 0.8 + time / 3, 0.8 + time / 3, 0.8 + time / 3)
            call KillUnit(bjLCU)
        endif
        if time>1.5 and time<3 then
            set n=CreateUnit(GetOwningPlayer(caster), 'dR70', caster_x, caster_y, GetRandomInt(0, 360))
            call SetUnitScale(n, 2.5, 2.5, 2.5)
            call MyRemoveUnit(n, 1.5)
            set n=CreateUnit(GetOwningPlayer(caster), 'dR43', caster_x, caster_y, GetRandomInt(0, 360))
            call UnitApplyTimedLife(n,'BTLF', 1.0)
        endif
    else
        call SetUnitInvulnerable(caster, false)
        call PauseUnit(caster, false)
        set n=CreateUnit(GetOwningPlayer(caster), 'dR70', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 2.5, 2.5, 2.5)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'dR43', caster_x, caster_y, GetRandomInt(0, 360))
        call UnitApplyTimedLife(n,'BTLF', 1.0)
        if udg_B then
            call UnitAddAbility(Gon,'S008')
            call IssueImmediateOrder(Gon, "bearform")
            call UnitRemoveAbility(Gon,'S008')
            call CheckUnitBonusRange(Gon)
            call HealTextTag(Gon,Gon,GetUnitState(Gon,UNIT_STATE_MAX_LIFE)*0.15*myCustomHeal2(Gon,1),"HealthRes")
            call SetUnitState(Gon,UNIT_STATE_LIFE,GetWidgetLife(Gon)+GetUnitState(Gon,UNIT_STATE_MAX_LIFE)*0.15)
            call UnitApplyTimedLife(CreateUnit(p,'e0LA',caster_x, caster_y,0),'BTLF',3)
            call UnitApplyTimedLife(CreateUnit(p,'e0L8',caster_x, caster_y,0),'BTLF',3)
            call UnitApplyTimedLife(CreateUnit(p,'e0L9',caster_x, caster_y,0),'BTLF',3)
            call UnitApplyTimedLife(CreateUnit(p,'e0C7',caster_x, caster_y,0),'BTLF',6)
            call UnitApplyTimedLife(CreateUnit(p,'e0AX',caster_x, caster_y,GetRandomReal(0,359)),'BTLF',1)
            call UnitApplyTimedLife(CreateUnit(p,'e0AW',caster_x, caster_y,GetRandomReal(0,359)),'BTLF',0.01)
            call UnitApplyTimedLife(CreateUnit(p,'e0B1',caster_x, caster_y,GetRandomReal(0,359)),'BTLF',0.4)
            call UnitApplyTimedLife(CreateUnit(p,'e0B4',caster_x, caster_y,GetRandomReal(0,359)),'BTLF',0.4)
            call UnitApplyTimedLife(CreateUnit(p,'e0AZ',caster_x, caster_y,GetRandomReal(0,359)),'BTLF',0.4)
            call UnitApplyTimedLife(CreateUnit(p,'e0B3',caster_x, caster_y,GetRandomReal(0,359)),'BTLF',0.4)
            call UnitAddAbility(Gon,'A0UA')
            call UnitAddAbility(Gon,'A0UE')
            call ShowAbility2('A13V',false)
            call ShowAbility2Timed('A23V',true,0.1)
            call UnitRemoveAbility(Gon,'A0QL')
            call SetUnitAbilityLevel(Gon,'A0U8',GetUnitAbilityLevel(Gon,'A0U8')+1)
            call SaveReal(HH,GetHandleId(Gon),SH_kill,40.0)
            call CreateModeIndicatorWithPauseForm(Gon, "ReplaceableTextures\\CommandButtons\\BTNGonG.blp", 40)
            call TimerStart(CreateTimer(),0.1,true,function GonsRage2)
        endif
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
    set p=null
endfunction

function GonG_Cast takes nothing returns nothing
    set n=CreateUnit(GetOwningPlayer(Gon), 'dM32', GetUnitX(Gon), GetUnitY(Gon), 0)
    set soundplay=SndN(2026) // Sound\Music\mp3Music\GonTransformation.mp3
    call StartSound(soundplay)
    call SaveSoundHandle(HH, GetHandleId(Gon), SH_GonG, soundplay)
    call SetUnitVertexColor(n, 255, 255, 255, 190)
    call UnitScale(n, 1, 3, 4)
    call UnitApplyTimedLife(n,'BTLF', 4.2)
    call MyRemoveUnit(n, 5.0)
    call PauseUnit(Gon, true)
    call SetUnitInvulnerable(Gon, true)
    call SetUnitAnimationByIndex(Gon, 14)
    call UnitAddAbility(Gon,'A0QL')
    call TimerStart(CreateTimer(), 0.1, true, function GonG_Periodic)
endfunction

function InitTrig_GonsRage takes nothing returns nothing
set gg_trg_GonsRage=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_GonsRage,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_GonsRage,Condition(function Trig_GonsRage_Conditions))
call TriggerAddAction(gg_trg_GonsRage,function GonG_Cast)
endfunction
function ResoluteFistCond takes nothing returns boolean
return GetSpellAbilityId()=='A2U9'
endfunction
function ResoluteFistCast6 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real sc=LoadReal(h,id,8)
local real dist=LoadReal(h,id,7)
local real damage=10*GetHeroStr(u,true)
local real f=15*bj_DEGTORAD
call DestroyEffect(LoadEffectHandle(h,id,16))
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call SetUnitInvulnerable(c,false)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call UnitApplyTimedLife(CreateUnit(p,'e03X',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0ZB',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0ZB',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03W',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e08R',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03Y',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e08N',x1,y1,a*bj_RADTODEG),'BTLF',1)
if GetUnitAbilityLevel(u,'A0U5') > 0 then
        set damage = damage * (1.125+0.025*GetUnitAbilityLevel(u,'A0U5'))
endif
call myCustomDamage(u,c,damage,false,false,null,null,null)
call SetControlToUnit(u,c, 1, "stun")
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitTimeScale(u,1)
call SetUnitFlyHeight(c,0,0)
call SetUnitPathing(u,true)
call UnitEnableAutoOrientation(c,true)
call FlushChildHashtable(h,id)
set p=null
set u=null
set c=null
set t=null
endfunction
function ResoluteFistCast5 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real sc=LoadReal(h,id,8)
local real dist=LoadReal(h,id,7)
local real f=15*bj_DEGTORAD
if sc<1000 then
call SetUnitOrientation(c,GetUnitFacing(u),-90,0)
call SetUnitX(c,x1+60*Cos(a))
call SetUnitY(c,y1+60*Sin(a))
call UnitApplyTimedLife(CreateUnit(p,'e0YE',x1+60*Cos(a-deg90*2),y1+60*Sin(a-deg90*2),(a-deg90*2)*bj_RADTODEG),'BTLF',0.25)
call UnitApplyTimedLife(CreateUnit(p,'e0XQ',x,y,(a*bj_RADTODEG)),'BTLF',4)
call DestroyEffect(AddSpecialEffect("war3mapImported\\EarthSmash.mdx",x1+GetRandomReal(-150,150),y1+GetRandomReal(-150,150)))
set n=CreateUnit(p,'e0HQ',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitTimeScale(n,0.5)
call SetUnitScale(n,0.75,0.75,0.75)
call SetUnitVertexColor(n,255,255,255,125)
call SetUnitTimeScale(n,1-sc*0.0005)
call SaveReal(h,id,8,sc+60)
else
call PauseTimer(t)
call SetUnitTimeScale(u,0)
call TimerStart(t,0,false,function ResoluteFistCast6)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function ResoluteFistCast4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real sc=LoadReal(h,id,8)
local real dist=LoadReal(h,id,7)
local real f=15*bj_DEGTORAD
if SR(x,y,x1,y1)>140 then
call SetUnitXY_1(u,x+80*Cos(a),y+80*Sin(a),false)
else
if sc<5 then
if GetUnitTypeId(c)!='HMUS' then
call SetUnitOrientation(c,GetUnitFacing(u),-180,0)
endif
call SetUnitFlyHeight(c,35,0)
call SetUnitTimeScale(u,0.1)
call SetUnitXY_1(u,x+3*Cos(a),y+3*Sin(a),false)
call SetUnitXY_1(LoadUnitHandle(h,id,9),x+40*Cos(a),y+40*Sin(a),false)
set n=CreateUnit(p,'e0Z8',x+75*Cos(a),y+75*Sin(a),a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,1.5)
call SetUnitVertexColor(n,255,100,100,125)
call SetUnitScale(n,sc*0.3,sc*0.3,sc*0.3)
set n=CreateUnit(p,'e0HQ',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.5)
call SetUnitFlyHeight(n,GetRandomReal(0,100),0)
call SetUnitScale(n,sc*0.75,sc*0.75,sc*0.75)
call SetUnitVertexColor(n,255,255,255,125-R2I(10*sc))
call SetUnitTimeScale(n,1-sc*0.1)
set n=CreateUnit(p,'e0HQ',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.5)
call SetUnitFlyHeight(n,GetRandomReal(0,100),0)
call SetUnitScale(n,sc*0.5,sc*0.5,sc*0.5)
call SetUnitVertexColor(n,255,255,255,125-R2I(10*sc))
call SetUnitTimeScale(n,1-sc*0.1)
set n=CreateUnit(p,'e0HQ',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.5)
call SetUnitFlyHeight(n,GetRandomReal(0,100),0)
call SetUnitScale(n,sc*0.25,sc*0.25,sc*0.25)
call SetUnitTimeScale(n,1-sc*0.1)
call SetUnitVertexColor(n,255,255,255,125-R2I(10*sc))
call SaveReal(h,id,8,sc+0.20)
call SaveReal(h,id,7,dist+75)
else
call RemoveUnit(LoadUnitHandle(h,id,9))
call UnitApplyTimedLife(CreateUnit(p,'e0RH',x1,y1,(a*bj_RADTODEG)-180),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0RK',x1,y1,(a*bj_RADTODEG)-180),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0RN',x1,y1,(a*bj_RADTODEG)-180),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0XQ',x1,y1,(a*bj_RADTODEG)-180),'BTLF',4)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call SetUnitInvulnerable(c,true)
call PauseTimer(t)
call SaveReal(h,id,8,0)
call SetUnitTimeScale(u,0)
call TimerStart(t,0.03,true,function ResoluteFistCast5)
endif
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function ResoluteFistCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real dist=SR(x,y,x1,y1)
local real RotPitch=LoadReal(h,id,10)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call SetUnitInvulnerable(c,true)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call UnitEnableAutoOrientation(c,false)
if SR(x,y,x1,y1)<320 then
call SaveReal(h,id,10,RotPitch+35)
call SetUnitScale(LoadUnitHandle(h,id,9),40/SR(x,y,x1,y1),40/SR(x,y,x1,y1),40/SR(x,y,x1,y1))
call SetUnitVertexColor(LoadUnitHandle(h,id,9),255,230,100,R2I(0.6*SR(x,y,x1,y1)))
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,0.6,0.6,0.6)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,255,230,100,50)
set n=CreateUnit(p,'e0RE',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,255,230,100,255)
call SetUnitXY_1(c,x1+7*Cos(a),y1+7*Sin(a),false)
if SR(x,y,x1,y1)>100 and SR(x,y,x1,y1)<=107 then
call SetUnitTimeScale(u,0.7)
call SetUnitAnimation(u,"Spell one")
call SaveEffectHandle(h,id,16,AddSpecialEffectTarget("GonRock.mdx",u,"right hand"))
endif
call SetUnitFlyHeight(c,ParabolaZ(1000,210,325-dist),0)
if GetUnitTypeId(c)!='HMUS' then
call SetUnitOrientation(c,GetUnitFacing(u),RotPitch,0)
else
call SetUnitOrientation(c,GetUnitFacing(u),0,0)
endif
else
call SetUnitAnimation(u,"Spell slam one")
set n=CreateUnit(p,'e0MB',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.5)
call SetUnitScale(n,2.5,2.5,2.5)
set n=CreateUnit(p,'e0MB',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.5)
call SetUnitScale(n,2.0,2.0,2.0)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\dash sfx.mdl",u,"origin"))
call ShakeCamera(1.5,20)
call SetUnitFacingInstant(c,GetUnitFacing(u)-180)
call PauseTimer(t)
call TimerStart(t,0.03,true,function ResoluteFistCast4)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function ResoluteFistCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>120 and GetWidgetLife(c)>0 and GetUnitAbilityLevel(u,'A3IH')==0 and GetUnitAbilityLevel(c,'A3IH')==0 and ((GetUnitAbilityLevel(u,'A0IH')==0 and GetUnitAbilityLevel(c,'A0IH')==0) or (GetUnitAbilityLevel(u,'A0IH')>0 and GetUnitAbilityLevel(c,'A0IH')>0)) then
    set x=x+40*Cos(a)
    set y=y+40*Sin(a)
    call SetUnitXY_1(u,x,y,false)
    call SetUnitFacing(u,a*bj_RADTODEG)
    if SR(x,y,x1,y1)>200 then
        call SetUnitAnimation(u,"Stand ready")
    else
        call SetUnitAnimation(u,"Spell four")
    endif
else
    if GetUnitAbilityLevel(u,'A3IH')==0 and GetUnitAbilityLevel(c,'A3IH')==0 and ((GetUnitAbilityLevel(u,'A0IH')==0 and GetUnitAbilityLevel(c,'A0IH')==0) or (GetUnitAbilityLevel(u,'A0IH')>0 and GetUnitAbilityLevel(c,'A0IH')>0)) then
        if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
            call PauseUnit(c,true)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
            call SetUnitInvulnerable(c,true)
            //call SetUnitFlyHeight(c,900,0)
            //call SetUnitFlyHeight(c,0,400)
            call PauseTimer(t)
            call SetUnitTimeScale(u,0.8)
            set n=CreateUnit(p,'e0RD',x+65*Cos(a-deg90),y+65*Sin(a-deg90),a*bj_RADTODEG)
            call SaveUnitHandle(h,id,9,n)
            call SaveReal(h,id,10,0)
            call SetUnitScale(n,4,4,4)
            if GetUnitTypeId(u)=='H04B' then
                set soundplay=SndN(2028) // Sound\Music\mp3Music\GonGT1.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            else
                if GetRandomInt(1,2)==1 then
                    set soundplay=SndN(2031) // Sound\Music\mp3Music\GonT1.mp3
                    call StartSound(soundplay)
                    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                else
                    set soundplay=SndN(2034) // Sound\Music\mp3Music\GonT2.mp3
                    call StartSound(soundplay)
                    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                endif
            endif
            call TimerStart(t,0.03,true,function ResoluteFistCast3)
        else
            call PauseUnit(u,false)
            call SetUnitInvulnerable(u,false)
            call PauseUnit(c,false)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
            call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
            call PauseTimer(t)
            call DestroyTimer(t)
            call SetUnitVertexColor(u,255,255,255,255)
            call FlushChildHashtable(h,id)
        endif
    else
        call SetUnitInvulnerable(u,false)
        call SetUnitInvulnerable(c,false)
        call PauseUnit(u,false)
        call PauseUnit(c,false)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
        call PauseTimer(t)
        call DestroyTimer(t)
        call SetUnitVertexColor(u,255,255,255,255)
        call FlushChildHashtable(h,id)
    endif
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function ResoluteFistCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
call SaveUnitHandle(h,id,0,u)
call SetUnitPathing(u,false)
call SetUnitAnimation(u,"Spell Channel Two")
call PauseUnit(u,true)
call SaveReal(h,id,7,75)
call SaveReal(h,id,8,0.3)
call SaveReal(h,id,9,Atan2(GetUnitY(c)-y,GetUnitX(c)-x))
call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e06H',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e06I',x,y,GetRandomReal(0,359)),'BTLF',1)
call SetUnitTimeScale(u,5)
call SetUnitInvulnerable(u,true)
call SaveUnitHandle(h,id,1,c)
//call SaveEffectHandle(h,id,16,AddSpecialEffectTarget("GonRock.mdx",u,"right hand"))
call TimerStart(t,0.025,true,function ResoluteFistCast2)
set soundplay=SndN(2037) // Sound\Music\mp3Music\GonTStart.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set c=null
set u=null
set t=null
endfunction
function InitTrig_ResoluteFist takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function ResoluteFistCond))
call TriggerAddAction(t,function ResoluteFistCast)
set t=null
endfunction
function RockCond takes nothing returns boolean
return GetSpellAbilityId()=='A0U1' and udg_B==true
endfunction
function GonRockStopOrders2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
call IssueImmediateOrder(u,"stop")
call SetUnitFacing(u,Atan2(LoadReal(h,id,1)-GetUnitY(u),LoadReal(h,id,2)-GetUnitX(u))*bj_RADTODEG)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
set t=null
set u=null
endfunction
function GonRockStopOrders takes nothing returns nothing
local unit u=GetOrderedUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
if GetOrderTargetUnit()==null then
call SaveReal(h,id,2,GetOrderPointX())
call SaveReal(h,id,1,GetOrderPointY())
else
call SaveReal(h,id,2,GetUnitX(GetOrderTargetUnit()))
call SaveReal(h,id,1,GetUnitY(GetOrderTargetUnit()))
endif
//call SetUnitAnimation(u,"Spell Channel One")
call TimerStart(t,0.001,false,function GonRockStopOrders2)
set u=null
set t=null
endfunction
function RockCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real a=LoadReal(h,id,11)
local real dist=LoadReal(h,id,2)
local real x=GetUnitX(u)+45*Cos(a)
local real y=GetUnitY(u)+45*Sin(a)
local real dmg=LoadReal(h,id,4)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,12)
local integer idg2=GetHandleId(g)
if dist>0 and RectContainsUnit(WorldBoundsR(),l__d)and UnitIsAlive(l__d)then
call SetUnitInvulnerable(u,true)
call PauseUnit(u,true)
call SetUnitXY_1(u,x,y, false)
call SetUnitX(l__d,x+65*Cos(a-deg90))
call SetUnitY(l__d,y+65*Sin(a-deg90))
call UnitRemoveAbility(u,'A2VJ')
if GetUnitTypeId(u)=='H04B' then
set n=CreateUnit(p,'e1RM',x,y,a*bj_RADTODEG)
else
set n=CreateUnit(p,'e0RM',x,y,a*bj_RADTODEG)
endif
call UnitApplyTimedLife(n,'BTLF',0.25)
call SetUnitTimeScale(n,2)
call SetUnitVertexColor(n,255,255,255,60)
call SetUnitAnimation(n,"stand")
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,0.65,0.65,0.65)
call SetUnitVertexColor(n,255,230,100,50)
set n=CreateUnit(p,'e0RE',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitVertexColor(n,255,230,100,50)
call GroupEnumUnitsInRange(g,x,y,200,Base)
call SaveReal(h,id,2,dist-45)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg2,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call Push(E,20,a,300)
call SetControlToUnit(E,E, 3, "stun")
call SaveUnitHandle(h,idg2,ide,E)
call KillUnit(l__d)
endif
call GroupRemoveUnit(g,E)
endloop
else
if GetUnitTypeId(u)=='H04B' then
set soundplay=SndN(2039) // Sound\Music\mp3Music\GonGR2.mp3
call StartSound(soundplay)
