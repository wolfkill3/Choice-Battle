set n0=CreateUnit(GetOwningPlayer(caster),0x65303030,GetUnitX(caster),GetUnitY(caster),facing)
call SetUnitModel(n0,"Sabrac\\t_shio_op_noelle_W-1.mdl")
call UnitSize(n0,1.5,1,1)
