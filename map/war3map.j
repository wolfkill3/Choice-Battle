function KireiTCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local integer idu=0
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=0
local real y1=0
local real a=GetUnitFacing(u)*bj_DEGTORAD
local real r=0
local group g=CreateGroup()
local group g2
local player p=GetOwningPlayer(u)
local real sc=0
local real is=0
local real ig=30*bj_DEGTORAD
set n=CreateUnit(p,0x656F3842,x,y,GetRandomReal(0,359))
set soundplay=SndN(3050) // Sound\war3mapImported\Kirei_T.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call UnitApplyTimedLife(n,'BTLF',3.5)
call SetUnitTimeScale(n,1)
if LoadGroupHandle(HH,GetHandleId(u),SH_assa)==null then
set g2=CreateGroup()
else
set g2=LoadGroupHandle(HH,GetHandleId(u),SH_assa)
endif
set n=CreateUnit(p,'ed0O',x,y,0)
call SetUnitTimeScale(n,0.5)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitScale(n,0.65,0.65,0.65)
call SetUnitVertexColor(n,255,255,255,100)
loop
exitwhen is>=13
set n=CreateUnit(p,'eo0N',x+350*Cos(ig*is),y+350*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,255,255,255,55)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,0.5)
set is=is+1
endloop
call GroupEnumUnitsInRect(G,GetPlayableMapRect(),Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)and UnitIsAlive(E) and IsUnitType(E,UNIT_TYPE_HERO) then
set x1=x+250*Cos(a-(60-30*r)*bj_DEGTORAD)
set y1=y+250*Sin(a-(60-30*r)*bj_DEGTORAD)
set n=CreateUnit(p,'eo6Z',x1,y1,Atan2(y-y1,x-x1)*bj_RADTODEG)
call SetUnitFlyHeight(n,25,250)
set idu=GetHandleId(n)
call SaveUnitHandle(HH,idu,0,E)
call SaveGroupHandle(HH,idu,1,g2)
call GroupAddUnit(g2,n)
call GroupAddUnit(g,n)
set r=r+1
endif
call GroupRemoveUnit(G,E)
endloop
call SaveUnitHandle(HH,id,0,u)
call SaveGroupHandle(HH,id,2,g)
call SaveGroupHandle(HH,id,3,g2)
call SaveGroupHandle(HH,GetHandleId(u),SH_assa,g2)
call PauseUnit(u,true)
call TimerStart(t,2.5,false,function KireiTCast2)
set t=null
set p=null
set u=null
set g=null
set g2=null
endfunction
