function Trig_X_Banner_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A00Y' and udg_B==true
endfunction
function Trig_X_Banner_Actions2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit d1=LoadUnitHandle(h,id,1)
    local unit d2=LoadUnitHandle(h,id,11)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=LoadReal(h,id,5)
    local real y1=LoadReal(h,id,6)
    local real x3=GetUnitX(LoadUnitHandle(HH, GetHandleId(u), TsunaR_Circle))
    local real y3=GetUnitY(LoadUnitHandle(HH, GetHandleId(u), TsunaR_Circle))
    local real x2=0
    local real y2=0
    local real i=LoadReal(h,id,7)
    local real f=GetUnitFacing(u)*bj_DEGTORAD //Atan2(y3-y,x3-x)
    local boolean b=LoadBoolean(h,id,10)
    local real r=0
    local group g=LoadGroupHandle(h,id,7)
    local integer l__idg=GetHandleId(g)
    local player p=GetOwningPlayer(u)
    local real dmg=GetHeroAgi(u,true)*(3+GetUnitAbilityLevel(u,'A00Y'))*0.15
    local trigger newTrigger=LoadTriggerHandle(h, id, 100)
    local unit dummy = LoadUnitHandle(HH, GetHandleId(u), TsunaR_Circle)
    local boolean visual_fix = LoadBoolean(h, id, 102)
    local real angle = AU(u, dummy)
    local real caster_facing = GetUnitFacing(u)*bj_DEGTORAD
    local real turn_speed = (36 / 13.3) // первое значение - градусы в секунду 
    if GetUnitState(u,UNIT_STATE_MANA)>GetUnitState(u,UNIT_STATE_MAX_MANA)*0.04 and OrderId2String(GetUnitCurrentOrder(u))=="channel" and GetWidgetLife(LoadUnitHandle(HH, GetHandleId(u), TsunaR_Circle))>1.0 then
        //call SetUnitInvulnerable(u, true)
        //call PauseUnit(u, true)
        if GetOwningPlayer(u)==GetLocalPlayer()then
            call ClearSelection()
            call SetUnitVertexColor(dummy,255,255,255,255)
            call SelectUnit(dummy,true)
        endif
        call SetUnitBonusMoveSpeedPercent(dummy,500)
        call SetUnitMaxMana(dummy, GetWidgetMaxMana(u))
        call SetWidgetMana(dummy, GetWidgetMana(u))

        // call BJDebugMsg(R2S(Rad2Deg(angle)))
        // call BJDebugMsg(R2S(GetUnitFacing(u)))

        if Rad2Deg(angle)<0 then
            set angle = Deg2Rad(Rad2Deg(angle)+360)
        endif
        // call BJDebugMsg(R2S(Rad2Deg(angle)))

        if (Rad2Deg(angle)-GetUnitFacing(u))>180 then
            if GetUnitFacing(u)<180 then
                set angle = Deg2Rad(Rad2Deg(angle)-360)
            endif
        elseif (GetUnitFacing(u)-Rad2Deg(angle))>180 then
            set angle = Deg2Rad(Rad2Deg(angle)+360)
        endif
        
        // call BJDebugMsg(R2S(Rad2Deg(angle)))
        // call BJDebugMsg(R2S(GetUnitFacing(u)))

        if GetUnitFacing(u)<Rad2Deg(angle) then
            if GetUnitFacing(u)+turn_speed>=Rad2Deg(angle) then
                call SetUnitFacing(u, Rad2Deg(angle))
            else
                call SetUnitFacing(u, GetUnitFacing(u)+turn_speed)
            endif
        elseif GetUnitFacing(u)>Rad2Deg(angle) then
            if GetUnitFacing(u)-turn_speed<=Rad2Deg(angle) then
                call SetUnitFacing(u, Rad2Deg(angle))
            else
                call SetUnitFacing(u, GetUnitFacing(u)-turn_speed)
            endif
        endif
        set angle = Deg2Rad(GetUnitFacing(u))
        set f = Deg2Rad(GetUnitFacing(u))
        //call SetUnitFacing(u, angle*bj_RADTODEG)
        // if SquareRootPoint(GetUnitX(u), GetUnitY(u), GetUnitX(dummy), GetUnitY(dummy))<900 then
        //     call IssueImmediateOrder(dummy, "stop")
        //     call IssuePointOrder(dummy, "move", GetUnitX(u) + 901*Cos(AU(u, dummy)), GetUnitY(u) + 601*Sin(AU(u, dummy)))
        // endif
        //call SetUnitBonusMoveSpeedPercent(LoadUnitHandle(HH, GetHandleId(u), TsunaR_Circle),500)
        call SetUnitAnimation(u,"stand channel")
        call SetUnitXY_1(u,x1,y1, false)
        // call SetUnitFacingInstant(u,f*bj_RADTODEG)
        call SetUnitXY_1(d1,x-25*Cos(caster_facing),y-25*Sin(caster_facing), false)
        call SetUnitFacingInstant(d1,caster_facing*bj_RADTODEG+180)
        if visual_fix==false then
            call SaveBoolean(h, id, 102, true)
        else
            call SaveBoolean(h, id, 102, false)
            if i<7 then
                call SaveReal(h,id,7,i+1)
            else
                if b==false then
                    set soundplay=SndN(834) // Sound\Music\mp3Music\XBurner.mp3
                    call StartSound(soundplay)
                    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                    //set d2=CreateUnit(p,'e90K',x+25*Cos(f),y+25*Sin(f),f*bj_RADTODEG)
                    set d2=CreateUnit(p,'d134',x+75*Cos(caster_facing),y+75*Sin(caster_facing),caster_facing*bj_RADTODEG)
                    call SetUnitFlyHeight(d2, 100, 0)
                    call UnitScale(d2, 1.0, 3.7, 0.2)
                    call SaveUnitHandle(h,id,11,d2)
                    call UnitAddAbility(d2,'Arav')
                    //call SetUnitVertexColor(d2,255,50,50,255)
                    call SaveBoolean(h,id,10,true)
                endif
            endif
            if b==true then
                call SetUnitXY_1(d2,x+100*Cos(caster_facing),y+100*Sin(caster_facing), false)
                call SetUnitFacingInstant(d2,caster_facing*bj_RADTODEG)
                call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.15*0.14)
                loop
                exitwhen r==12
                    set x2=80*Cos(f)+x+r*245*Cos(f)
                    set y2=80*Sin(f)+y+r*245*Sin(f)
                    if r>2 then
                        set n=CreateUnit(p,'e00L',x2,y2,f*bj_RADTODEG)
                        call UnitApplyTimedLife(n,'BHwe',0.25)
                        call SetUnitTimeScale(n,2)
                    endif
                    call SaveReal(h,id,7,i+1)
                    call GroupEnumUnitsInRange(g,x2,y2,325,Base)
                    set r=r+1
                    loop
                        set E=FirstOfGroup(g)
                        set ide=GetHandleId(E)
                        if Condition_Base(p,E) and E!=LoadUnitHandle(h,l__idg,ide)then
                            call SaveUnitHandle(h,l__idg,ide,E)
                            call myCustomDamage(u,E,dmg,false,false,null,null,null)
                            if ModuloReal(i,5)<1 then
                                call SetControlToUnit(u,E,0.55,"stun")
                            endif
                        endif
                        call GroupRemoveUnit(g,E)
                    exitwhen E==null
                    endloop
                endloop
                call FlushChildHashtable(h,l__idg)
            endif
        endif
    else
        //call SetUnitInvulnerable(u, false)
        //call PauseUnit(u, false)
        call IssueImmediateOrder(u, "stop")
        if GetOwningPlayer(u)==GetLocalPlayer()then
            call ClearSelection()
            call SelectUnit(u,true)
        endif
        call RemoveUnit(LoadUnitHandle(h, id, 101))
        call RemoveUnit(LoadUnitHandle(HH, GetHandleId(u), TsunaR_Circle))
        call RemoveSavedHandle(HH, GetHandleId(u), TsunaR_Circle)
        call TriggerClearActions(newTrigger)
        call DestroyTrigger(newTrigger)
        call GroupClear(g)
        call DestroyGroup(g)
        //call UnitRemoveAbility(u,'A0GZ')
        call DestroyTimer(t)
        call KillUnit(d1)
        call KillUnit(d2)
        call MyRemoveUnit(d1, 1.5)
        call MyRemoveUnit(d2, 1.5)
        call FlushChildHashtable(h,id)
    endif
    set d1=null
    set d2=null
    set g=null
    set p=null
    set u=null
    set t=null
    set newTrigger=null
    set dummy=null
endfunction

function TsunaR_Order takes nothing returns nothing
    local unit u=GetOrderedUnit()
    local unit caster=Hero[GetPlayerId(GetOwningPlayer(u))]
    local real point_x = 0.0
    local real point_y = 0.0
    local real angle   = 0
    if GetOrderTargetUnit()==null then
        set point_x = GetOrderPointX()
        set point_y = GetOrderPointY()
    else
        set point_x = GetUnitX(GetOrderTargetUnit())
        set point_y = GetUnitY(GetOrderTargetUnit())
    endif
    call SetUnitX(u, point_x)
    call SetUnitY(u, point_y)
    call IssueImmediateOrder(u, "stop")
    // if SquareRootPoint(GetUnitX(caster), GetUnitY(caster), point_x, point_y)<900 then
    //     set angle   = AU(caster, u)
    //     set point_x = GetUnitX(caster) + 901*Cos(angle)
    //     set point_y = GetUnitY(caster) + 901*Sin(angle)
    //     call IssueImmediateOrder(u, "stop")
    //     call IssuePointOrder(u, "move", point_x, point_y)
    // endif
    set u=null
    set caster=null
endfunction
function Trig_X_Banner_Actions takes nothing returns nothing
    local unit u=GetTriggerUnit()
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetSpellTargetX()
    local real y1=GetSpellTargetY()
    local real f=Atan2(y1-y,x1-x)
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local trigger newTrigger=CreateTrigger()
    local real angle = 0
    //call UnitAddAbility(u,'A0GZ')
    call SetUnitFacingInstant(u, f*bj_RADTODEG)
    call SaveUnitHandle(h,id,0,u)
    set n=CreateUnit(GetOwningPlayer(u),'d234',x-50*Cos(f),y-50*Sin(f),f*bj_RADTODEG+180)
    call SetUnitFlyHeight(n, 100, 0)
    call UnitScale(n, 1.0, 4.0, 1)
    call UnitAddAbility(n,'Arav')
    call SaveUnitHandle(h,id,1,n)
    call SaveReal(h,id,2,x1)
    call SaveReal(h,id,3,y1)
    call SaveReal(h,id,5,x)
    call SaveReal(h,id,6,y)
    call SaveGroupHandle(h,id,7,CreateGroup())
    call SaveBoolean(h,id,4,true)
    call SetUnitAnimation(u,"spell six")
    if GetRandomReal(0,100)>10 then
    set soundplay=SndN(837) // Sound\Music\mp3Music\Xburnerstart.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    else
    set soundplay=SndN(839) // Sound\Music\mp3Music\OperationX.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    endif
    call TimerStart(t,0.075,true,function Trig_X_Banner_Actions2)
        set n = CreateUnit(GetOwningPlayer(u), 'd135', x, y, 0)
        call SetUnitFlyHeight(n, 250, 0)
        call SetUnitTimeScale(n, 3.5)
        call SaveUnitHandle(h, id, 101, n)
        set n = CreateUnit(GetOwningPlayer(u), 'd133', x1, y1, 0)
        call SetUnitMoveSpeed(n, 522)
        call SetUnitPathing(n, false)
        call UnitScale(n, 1.0, 3.0, 0.5)
        call SetUnitMaxMana(n, GetWidgetMaxMana(u))
        call SetWidgetMana(n, GetWidgetMana(u))
        call SaveUnitHandle(HH, GetHandleId(u), TsunaR_Circle, n)
        // if SquareRootPoint(GetUnitX(u), GetUnitY(u), GetUnitX(n), GetUnitY(n))<600 then
        //     set angle   = AU(u, n)
        //     call SetUnitX(n, GetUnitX(u) + 601*Cos(angle))
        //     call SetUnitY(n, GetUnitY(u) + 601*Sin(angle))
        // endif
        call SaveTriggerHandle(h, id, 100, newTrigger)
        call TriggerRegisterUnitEvent(newTrigger, n, EVENT_UNIT_ISSUED_TARGET_ORDER)
        call TriggerRegisterUnitEvent(newTrigger, n, EVENT_UNIT_ISSUED_POINT_ORDER)
        call TriggerAddAction(newTrigger,function TsunaR_Order)
    set u=null
    set t=null
    set newTrigger=null
endfunction

function Trig_X_Sream_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A07K' and udg_B==true
endfunction
function Trig_X_Sream_Actions2 takes nothing returns nothing 
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local integer time=LoadInteger(h,id,2)
local real he=LoadReal(h,id,3)
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>300 and GetWidgetLife(c)>0 and GetUnitAbilityLevel(u,'A2IH')!=0 then
    call SetUnitPathing(u,false)
    call SetUnitXY_1(u,x+50*Cos(a),y+50*Sin(a),false)
    call SetUnitPathing(u,true)
    call SetUnitFacing(u,a*bj_RADTODEG)
    call UnitApplyTimedLife(CreateUnit(p,'e00N',x,y,a*bj_RADTODEG),'BTLF',1)
else
    if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
        if LoadEffectHandle(h,id,10)==null then
            call SaveEffectHandle(h,id,10,AddSpecialEffectTarget("war3mapImported\\FireTornado.mdx",c,"origin"))
        endif
        if time<75 and GetWidgetLife(c)>0 and GetUnitAbilityLevel(u,'A2IH')!=0 then
            call SaveInteger(h,id,2,time+1)
            set a=a+90*bj_DEGTORAD
            if IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
                call SetUnitXY_1(u,x+55*Cos(a),y+55*Sin(a),false)
            endif
            call SetUnitFacing(u,a*bj_RADTODEG-45)
            call UnitApplyTimedLife(CreateUnit(p,'e00N',x,y,a*bj_RADTODEG),'BTLF',1)
            call SetUnitFlyHeight(u,he,0)
            call SaveReal(h,id,3,he+2)
            call myCustomDamage(u,c,(((1.75+0.25*GetUnitAbilityLevel(u,'A07K'))+GetUnitAbilityLevel(u,'A07K'))*GetHeroAgi(u,true))/75+1,false,false,null,null,null)
        else
            call DestroyEffect(LoadEffectHandle(h,id,10))
            call SetUnitFlyHeight(u,0,300)
            call SetUnitTimeScale(u,1)
            call SetUnitTurnSpeed(u,3)
            call DestroyTimer(t)
            call PauseUnit(u,false)
            call UnitRemoveAbility(u,'A2IH')
            call FlushChildHashtable(h,id)
            call SetUnitInvulnerable(u,false)
        endif
    else
        call DestroyEffect(LoadEffectHandle(h,id,10))
        call SetUnitTimeScale(u,1)
        call SetUnitTurnSpeed(u,3)
        call SetUnitInvulnerable(u,false)
        call PauseUnit(u,false)
        call UnitRemoveAbility(u,'A2IH')
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
        call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
        call SetUnitFlyHeight(u,0,0)
        call SetUnitFlyHeight(c,0,0)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
    endif
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function Trig_X_Sream_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call UnitAddAbility(u,'Arav')
call UnitAddAbility(u,'A2IH')
call FrozenMinusManaCast(c,5)
call UnitRemoveAbility(u,'Arav')
