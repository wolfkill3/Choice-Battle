        call StartAbilityCooldown(GetUnitAbility(newCaster , 'RenF' ), 5.0)
        call UnitRemoveAbility(newCaster, 'ReFP')
        call SaveUnitHandle(h, id, c_CASTER, newCaster)
        call TimerStart(newTimer, 0.05, true, function RengokuF_Periodic)
    endif
endfunction




