function LucyAriesCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,10)
local real y1=LoadReal(h,id,11)
local player p=GetOwningPlayer(u)
local real a=LoadReal(h,id,3)
local integer lvl=GetUnitAbilityLevel(u,'A1EY')*3
set n=CreateUnit(p,0x65313445,x+155*Cos(a),y+155*Sin(a),a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,2)
call SetUnitAnimation(n,"Spell")
call GroupEnumUnitsInRange(G,x1,y1,500,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if IsUnitAlly(E,p)and IsUnitType(E,UNIT_TYPE_HERO)then
call UnitAddAbility(E,'A1EZ')
call UnitAddAbilityTimed(E,lvl,'A1EZ')
call UnitAddAbility(E,'A1F0')
call UnitAddAbilityTimed(E,lvl,'A1F0')
call UnitAddAbility(E,'A1F1')
call UnitAddAbilityTimed(E,lvl,'A1F1')
endif
call GroupRemoveUnit(G,E)
endloop
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set u=null
set p=null
set t=null
endfunction
