function GokaMekkaykuCond takes nothing returns boolean
return GetSpellAbilityId()=='A0MU'
endfunction
function GokaMekkaykuCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local integer i=6
local real f=0
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local group g=LoadGroupHandle(h,id,4)
local real dist=LoadReal(h,id,SH_dist)
local real x1=0
local real y1=0
local integer l__idg=GetHandleId(g)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroInt(u,true)*(1+GetUnitAbilityLevel(u,'A0MU'))+75*GetUnitAbilityLevel(u,'A0MU')
loop
set n=LoadUnitHandle(h,id,i)
set f=GetUnitFacing(n)*bj_DEGTORAD
set x1=GetUnitX(n)
set y1=GetUnitY(n)
exitwhen i>=9
if dist<=1500 then
set x1=x1+30*Cos(f)
set y1=y1+30*Sin(f)
call SetUnitX(n,x1)
call SetUnitY(n,y1)
call GroupEnumUnitsInRange(g,x1,y1,250,Base)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,l__idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitVertexColor(n,255,230,100,100)
else
call RemoveUnit(LoadUnitHandle(h,id,6))
call RemoveUnit(LoadUnitHandle(h,id,7))
call RemoveUnit(LoadUnitHandle(h,id,8))
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
call DestroyTimer(t)
call DestroyGroup(g)
endif
set i=i+1
endloop
call SaveReal(h,id,SH_dist,dist+25)
set u=null
set p=null
set t=null
set g=null
endfunction
function GokaMekkaykuCast takes nothing returns nothing
