function EKingHassanAct2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local integer i=0
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(c)
local real y=GetUnitY(c)
local real sc=0
local real time=LoadReal(h,id,2)-0.04
local player p=GetOwningPlayer(u)
if time>0 then
call SaveReal(h,id,2,time)
set sc=GetRandomReal(1,2)
call EffectToRandomBone("war3mapImported\\Spear.mdx",c)
if GetRandomInt(0,1)==1 then
set n=CreateUnit(p,'e166',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.6)
call SetUnitScale(n,sc,sc,sc)
call SetUnitTimeScale(n,1.4)
else
set n=CreateUnit(p,'e167',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.6)
call SetUnitScale(n,sc,sc,sc)
call SetUnitTimeScale(n,1.4)
endif
else
set i=GetUnitAbilityLevel(c,'A1GS')
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call myCustomDamage(u,c,GetUnitState(c,UNIT_STATE_MAX_LIFE)*0.06*i,false,false,null,null,null)
call SaveInteger(HH, GetHandleId(c), StringHash("KHE_Stack"), 0)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Tidal.mdx",c,"chest"))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX-Special.mdx",c,"head"))
call UnitRemoveAbility(c,'A1GS')
set n=CreateUnit(p,'e168',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitTimeScale(n,0.7)
set n=CreateUnit(p,'e164',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.8)
call SetUnitVertexColor(n,255,255,255,125)
call SetUnitTimeScale(n,1)
call PauseTimer(t)
call FlushChildHashtable(h,id)
endif
set c=null
set p=null
set u=null
set t=null
endfunction
