function ArcueidTCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local group ge=LoadGroupHandle(h,id,4)
local player p=GetOwningPlayer(u)
if 1==0 then
loop
set E=FirstOfGroup(ge)
exitwhen E==null
call UnitRemoveAbility(E,'A1F9')
call GroupRemoveUnit(ge,E)
endloop
call UnitRemoveAbility(u,'A1F9')
call GroupClear(ge)
call DestroyGroup(ge)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set ge=null
set u=null
set t=null
endfunction
function ArcueidTCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local group g=LoadGroupHandle(h,id,1)
local group ge=LoadGroupHandle(h,id,4)
local real sc=LoadReal(h,id,5)
local player p=GetOwningPlayer(u)
local real time=LoadReal(h,id,1)
if time<4 then
call SaveReal(h,id,1,time+0.01)
if sc<1.5 then
call SetUnitAnimation(u,"Spell Slam")
call SaveReal(h,id,5,sc+2.05)
endif
call SetUnitInvulnerable(u,true)
call GroupEnumUnitsInRect(G,bj_mapInitialPlayableArea,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if IsUnitType(E,UNIT_TYPE_HERO)and IsUnitAlly(E,p)==false and IsUnitInGroup(E,ge)==false and E!=u then
if GetUnitAbilityLevel(E,'A1FA')==0 then
call UnitAddAbility(E,'A1FA')
call UnitMakeAbilityPermanent(E,true,'A1FA')
call GroupAddUnit(ge,E)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIil\\AIilTarget.mdl",E,"origin"))
else
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIil\\AIilTarget.mdl",E,"origin"))
call SetUnitAbilityLevel(E,'A1FA',GetUnitAbilityLevel(E,'A1FA')+1)
call GroupAddUnit(ge,E)
endif
endif
call GroupRemoveUnit(G,E)
endloop
else
call PauseUnit(u,false)
call SetUnitFlyHeight(u,0,0)
call ForGroup(g,function KillGroup)
call GroupClear(g)
call DestroyGroup(g)
if GetUnitAbilityLevel(u,'A1F9')==0 then
call UnitAddAbility(u,'A1F9')
call UnitMakeAbilityPermanent(u,true,'A1F9')
else
call SetUnitAbilityLevel(u,'A1F9',GetUnitAbilityLevel(u,'A1F9')+1)
endif
call SetUnitInvulnerable(u,false)
call SetUnitAnimation(u,"Spell Channel One")
call PauseTimer(t)
call TimerStart(t,0.1,true,function ArcueidTCast3)
endif
set p=null
set ge=null
set g=null
set u=null
set t=null
endfunction
function ArcueidTCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local integer idu=GetHandleId(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local group g=CreateGroup()
local real sc=0
local real is=0
local real ig=15*bj_DEGTORAD
loop
exitwhen is>=25
set n=CreateUnit(p,'e0ZH',x+550*Cos(ig*is),y+550*Sin(ig*is),180+is*15)
call SetUnitVertexColor(n,255,255,255,35)
call UnitApplyTimedLife(n,'BTLF',1.5)
call SetUnitTimeScale(n,0.5)
set is=is+1
endloop
call SetUnitFlyHeight(u,75,0)
set n=CreateUnit(p,'e0RV',x,y,0)
call SetUnitTimeScale(n,0.25)
call UnitApplyTimedLife(n,'BTLF',4.5)
call SetUnitScale(n,2.5,2.5,2.5)
call SetUnitVertexColor(n,255,255,255,225)
set n=CreateUnit(p,'e12S',x,y,GetRandomReal(0,359))
call SetUnitFlyHeight(n,400,0)
call GroupAddUnit(g,n)
set n=CreateUnit(p,'e12T',x,y,GetRandomReal(0,359))
call SetUnitFlyHeight(n,300,0)
call GroupAddUnit(g,n)
set n=CreateUnit(p,'e12U',x,y,GetRandomReal(0,359))
call SetUnitFlyHeight(n,300,0)
call GroupAddUnit(g,n)
set n=CreateUnit(p,'e15E',x,y,GetRandomReal(0,359))
call SetUnitScale(n,3,3,3)
call SetUnitTimeScale(n,0.5)
call SetUnitVertexColor(n,255,255,255,155)
call GroupAddUnit(g,n)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,1,g)
call SaveGroupHandle(h,id,4,CreateGroup())
call SaveReal(h,id,1,0)
call SaveReal(h,id,5,1.05)
set soundplay=SndN(2864) // Sound\Music\mp3Music\ArchtypeT.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.01,true,function ArcueidTCast2)
set u=null
set p=null
set t=null
set g=null
endfunction
