function UnitInChibaku2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local unit u=LoadUnitHandle(h,id,7)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
local real dist=LoadReal(h,id,6)
local real mh=LoadReal(h,id,5)
local real rd=DBP(x,y,x1,y1,GetUnitFlyHeight(l__d),mh)
local player p=GetOwningPlayer(u)
local integer idu=GetPlayerId(p)
local real cof=1-rd/dist
call PauseUnit(l__d,true)
call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,true)
call SetUnitInvulnerable(l__d,true)
if rd>200 and udg_B==true and DU2==true then
call SetUnitPosition(l__d,x+speed*Cos(a),y+speed*Sin(a))
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,mh*cof+3,0)
endif
if udg_B==false or LoadBoolean(h,GetHandleId(u),SH_Chibaku)==false then
call SetUnitPathing(l__d,true)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set p=null
set l__d=null
set t=null
endfunction
function UnitInChibaku takes unit l__d,real speed,real angle,real x,real y,real mh,unit u returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SetUnitPathing(l__d,false)
call PauseUnit(l__d,true)
call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,true)
call UnitAddAbility(l__d,'A0QL')
call SetUnitInvulnerable(l__d,true)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,mh)
call SaveReal(h,id,6,DBP(GetUnitX(l__d),GetUnitY(l__d),x,y,GetUnitFlyHeight(l__d),mh))
call SaveUnitHandle(h,id,7,u)
call TimerStart(t,0.03,true,function UnitInChibaku2)
set t=null
endfunction
function ChibakuTenseiCond takes nothing returns boolean
return GetSpellAbilityId()=='A0QO' and udg_B==true
endfunction
function ChibakuTenseiCast4 takes nothing returns nothing
local timer t=GetExpiredTimer()
