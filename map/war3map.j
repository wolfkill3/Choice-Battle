                        call EffectCreateAndMove1(false,"war3mapImported\\wind4.mdl",GetRandomReal(0,360),1,0.75,0.5,100,100,100,GetRandomInt(30,50),50,0,u,0,LoadReal(HH,id,3))
                        call EffectCreateAndMove1(false,"war3mapImported\\wind3.mdl",GetRandomReal(0,360),1,0.75,0.75,100,100,100,GetRandomInt(30,50),150,0,u,0,LoadReal(HH,id,3))
                endif
                if time==0.5 then
                        call UnitSpeed(c,1)
                        call SetUnitAnimation(c,"stand")
                        call EffectCreateAndMove1(false,"war3mapImported\\HakenSaber2.mdl",LoadReal(HH,id,3),1,0.5,0.8,100,100,100,20,0,0,c,0,LoadReal(HH,id,3))
                        call EffectCreateAndMove1(false,"war3mapImported\\BlackBlink1.mdl",LoadReal(HH,id,3),0.5,1,1,100,100,100,20,0,0,c,0,LoadReal(HH,id,3))
                        call MoveUnit(c,u,-120,LoadReal(HH,id,3))
                        call EffectCreateAndMove1(false,"war3mapImported\\HakenSaber2.mdl",LoadReal(HH,id,3),1,0.5,0.8,100,100,100,20,0,0,u,0,LoadReal(HH,id,3))
                endif
                if time==1.2 then
                        call SetUnitAnimationByIndex(u,13)
                        call UnitSpeed(u,0.75)
                endif
                if time<2 then
                        call SaveReal(HH,id,3,Angle2(GetUnitX(u),GetUnitY(u),GetUnitX(c),GetUnitY(c)))
                        call SetUnitFacing(u,LoadReal(HH,id,3))
                        call SetUnitPathing(u,false)
                        call PauseUnit(u,true)
                        call SetUnitInvulnerable(u,true)
                        if time>0.5 then
                                call MoveUnit(c,u,-120,LoadReal(HH,id,3))
                                call SetUnitPathing(c,false)
                                call SetUnitFacing(c,LoadReal(HH,id,3)+180)
                                call PauseUnit(c,true)
                                call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
                                call SetUnitInvulnerable(c,true)
                        endif
                endif
                if time==2 then
                        call SetUnitAnimation(c,"death")
                        call UnitSpeed(u,1)
                        call UnitSpeed(c,1)
                        call SetUnitPathing(u,true)
                        call PauseUnit(u,false)
                        call PauseUnit(c,false)
                        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
                        call SetUnitInvulnerable(u,false)
                        call SetUnitInvulnerable(c,false)
                        call ShakeCamera(0.2, 10)
                        call myCustomDamage(u,c,10*GetHeroAgi(u,true),false,false,null,null,null)
                        call SetControlToUnit(c,c,1.0,"stun")
                        call EffectCreateAndMove1(false,"war3mapImported\\BY_Wood_GongChengSiPai_1.mdx",LoadReal(HH,id,3)+180,1.5,2,0.75,100,100,100,40,150,0,c,0,LoadReal(HH,id,3))
                        call EffectCreateAndMove1(false,"war3mapImported\\BY_Wood_GongChengSiPai_1.mdx",LoadReal(HH,id,3),1.5,2.5,0.75,100,100,100,40,150,0,c,0,LoadReal(HH,id,3))
                        call EffectCreateAndMove1(false,"war3mapImported\\CF2.mdl",LoadReal(HH,id,3),1,0.6,0.4,100,100,100,20,150,0,c,0,LoadReal(HH,id,3))
                        call EffectCreateAndMove21(false,"war3mapImported\\wind3.mdl",LoadReal(HH,id,3),1,1.25,1.5,100,100,100,40,150,c,0,LoadReal(HH,id,3))
                        call EffectCreateAndMove1(false,"war3mapImported\\[A]hit-white-guangxiao.mdl",LoadReal(HH,id,3),1,1.75,0.5,100,100,100,40,100,0,c,0,LoadReal(HH,id,3))
                endif
                if time>2 then
                        call SetUnitPathing(c,false)
                        if time<=2.4 then
                                call UnitStop(c)
                        endif
                        call MoveUnit(c,c,15,LoadReal(HH,id,3))
                endif
                if time==2.7 then
                        call SetUnitPathing(c,true)
                        call PauseTimer(t)
                        call DestroyTimer(t)
                        call FlushChildHashtable(HH,id)
                endif
        endif
        set t=null
        set c=null
        set u=null
endfunction

function RobLucci_Act takes nothing returns nothing
        local timer t=CreateTimer()
        local integer id=GetHandleId(t)
        local unit u=GetTriggerUnit()
        local unit c=GetSpellTargetUnit()
        local boolean form=true
        call SaveUnitHandle(HH,id,1,u)
        if GetUnitTypeId(u)=='H10L' then
            set form=false
        endif
        call SaveBoolean(HH,id,11,form)
        if c==null then
            call SaveReal(HH,id,3,Angle2(GetUnitX(u),GetUnitY(u),SpellTargetLocX(),SpellTargetLocY()))
        else
            call SaveUnitHandle(HH,id,2,c)
            call SaveReal(HH,id,3,Angle2(GetUnitX(u),GetUnitY(u),GetUnitX(c),GetUnitY(c)))
        endif
        if GetSpellAbilityId()!='LCF1' and GetSpellAbilityId()!='LCG1' and GetSpellAbilityId()!='LCQ1' and GetSpellAbilityId()!='LCW1' then
            call SetUnitPathing(u,false)
        endif
        if GetSpellAbilityId()!='LCF1' and GetSpellAbilityId()!='LCG1' and GetSpellAbilityId()!='LCT1' then
            call PauseUnit(u,true)
        endif
        if GetSpellAbilityId()=='LCR1' or GetSpellAbilityId()=='LCT1' then
            call SetUnitInvulnerable(u,true)
        endif
        if GetSpellAbilityId()=='LCQ1' then
            call SaveGroupHandle(HH,id,4,CreateGroup())
            call TimerStart(t,0.02,true,function RobLucciQ1Move)
        endif
        if GetSpellAbilityId()=='LCW1' then
            call SaveBoolean(HH,GetHandleId(u),SH_LucciTekkai,true)
            call TimerStart(t,0.02,true,function RobLucciW1Move)
        endif
        if GetSpellAbilityId()=='LCG1' then
            set EFF=AddSpecialEffect("war3mapImported\\AZ_LCDark_T2_Buff.mdl",GetUnitX(u),GetUnitY(u))
            call SetSpecialEffectFacing(EFF,Angle2(GetUnitX(u),GetUnitY(u),SpellTargetLocX(),SpellTargetLocY()))
            call SetSpecialEffectScale(EFF,1.75)
            call SetSpecialEffectTimeScale(EFF,2)
            call SetSpecialEffectVertexColour(EFF,ColorPercentT(100,255),ColorPercentT(100,255),ColorPercentT(100,255),ColorPercentT((100),255))
            call SetSpecialEffectZ(EFF,50)
            call SaveEffectHandle(HH,id,21,EFF)
            call SaveBoolean(HH,GetHandleId(u),SH_LucciShigan,true)
            call UnitAddAbility(u, 'AP05')
            call UnitMakeAbilityPermanent(u, true, 'AP05')
            call TimerStart(t,0.02,true,function RobLucciG1Move)
        endif
        if GetSpellAbilityId()=='LCF1' then
            set EFF=AddSpecialEffect("war3mapImported\\AZ_LCDark_W2_buff.mdl",GetUnitX(u),GetUnitY(u))
            call SetSpecialEffectFacing(EFF,Angle2(GetUnitX(u),GetUnitY(u),SpellTargetLocX(),SpellTargetLocY()))
            call SetSpecialEffectScale(EFF,1.25)
            call SetSpecialEffectTimeScale(EFF,3)
            call SetSpecialEffectVertexColour(EFF,ColorPercentT(100,255),ColorPercentT(100,255),ColorPercentT(100,255),ColorPercentT((100),255))
            call SetSpecialEffectZ(EFF,50)
            call SaveEffectHandle(HH,id,21,EFF)
            call SaveBoolean(HH,GetHandleId(u),SH_LucciSoru,true)
            call TimerStart(t,0.02,true,function RobLucciF1Move)
        endif
        if GetSpellAbilityId()=='LCR1' then
            if LoadBoolean(HH,GetHandleId(u),SH_LucciShigan)==true and SquareRootUnit(u, c)<=800 then
                call SaveBoolean(HH,GetHandleId(u),SH_LucciShigan,false)
                if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
                    call PauseUnit(c,true)
                    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
                    call TimerStart(t,0.02,true,function RobLucciRShiganMove)
                else
                    call MoveUnit(c,u,-120,Angle2(GetUnitX(u),GetUnitY(u),GetUnitX(c),GetUnitY(c)))
                    call PauseUnit(u,false)
                    call PauseUnit(c,false)
                    call UnitSpeed(u,1)
                    call UnitSpeed(c,1)
                    call SetUnitPathing(u,true)
                    call SetUnitPathing(c,true)
                    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
                    call SetUnitInvulnerable(u,false)
                    call SetUnitInvulnerable(c,false)
                    call SetUnitVertexColor(u,255,255,255,255)
                    call PauseTimer(t)
                    call SetUnitFlyHeight(u,0,0)
                    call DestroyTimer(t)
                    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
                    call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
                    call FlushChildHashtable(HH,id)
                endif
            else
                call TimerStart(t,0.02,true,function RobLucciRBaseMove)
            endif
        endif
        if GetSpellAbilityId()=='LCT1' then
            if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
                if form==true then
                    call SaveGroupHandle(HH,id,4,CreateGroup())
                    call PauseUnit(c,true)
                    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
                endif
                call TimerStart(t,0.02,true,function RobLucciTMove)
            else
                call MoveUnit(c,u,-120,Angle2(GetUnitX(u),GetUnitY(u),GetUnitX(c),GetUnitY(c)))
                call PauseUnit(u,false)
                call PauseUnit(c,false)
                call UnitSpeed(u,1)
                call UnitSpeed(c,1)
                call SetUnitPathing(u,true)
                call SetUnitPathing(c,true)
                call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
                call SetUnitInvulnerable(u,false)
                call SetUnitInvulnerable(c,false)
                call SetUnitVertexColor(u,255,255,255,255)
                call PauseTimer(t)
                call SetUnitFlyHeight(u,0,0)
                call DestroyTimer(t)
                call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
                call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
                call FlushChildHashtable(HH,id)
            endif
        endif
        set t=null
        set c=null
        set u=null
endfunction
function RobLucci_Cond takes nothing returns boolean
        local boolean cond1=GetSpellAbilityId()=='LCQ1' or GetSpellAbilityId()=='LCW1' or GetSpellAbilityId()=='LCR1' or GetSpellAbilityId()=='LCT1' or GetSpellAbilityId()=='LCF1' or GetSpellAbilityId()=='LCG1'
        if cond1 then
                return true
        else
                return false
        endif
endfunction
function InitTrig_Lucci takes nothing returns nothing
        local trigger trig=CreateTrigger()
        local integer index
        set index=0
        loop
        call TriggerRegisterPlayerUnitEvent(trig,Player(index),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
        set index=index+1
        exitwhen index==bj_MAX_PLAYER_SLOTS
        endloop
        call TriggerAddCondition(trig,Condition(function RobLucci_Cond))
        call TriggerAddAction(trig,function RobLucci_Act)
        set trig=null
        set index=0
endfunction

function LucciSoruAct takes nothing returns nothing
        local real cjlocgn_00000000
        local location lsl=null
        if LoadBoolean(HH,GetHandleId(GetTriggerUnit()),SH_LucciSoru)==true and(OrderId2String(GetUnitCurrentOrder(GetTriggerUnit()))=="smart" or OrderId2String(GetUnitCurrentOrder(GetTriggerUnit()))=="move")then
                set lsl=GetOrderPointLoc()
                call SetUnitFacingInstant(GetTriggerUnit(),Angle2(GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()),GetLocationX(lsl),GetLocationY(lsl)))
                if GetUnitTypeId(GetTriggerUnit())!='H10L' then
                        call SetUnitAnimationByIndex(GetTriggerUnit(),0)
                        set soundplay=SndN(697) // Sound\Music\mp3Music\Soru2.mp3
                        call StartSound(soundplay)
                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                else
                        call SetUnitAnimationByIndex(GetTriggerUnit(),1)
                        set soundplay=SndN(695) // Sound\Music\mp3Music\Soru.mp3
                        call StartSound(soundplay)
                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                endif
                if SR(GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()),GetLocationX(lsl),GetLocationY(lsl))>=800 then
                        set cjlocgn_00000000=Angle2(GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()),GetLocationX(lsl),GetLocationY(lsl))
                        call MoveUnit(GetTriggerUnit(),GetTriggerUnit(),800,Angle2(GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()),GetLocationX(lsl),GetLocationY(lsl)))
                        call EffectCreateAndMove1(false,"war3mapImported\\HakenSaber2.mdl",cjlocgn_00000000,1,0.5,0.8,100,100,100,20,0,0,GetTriggerUnit(),0,cjlocgn_00000000)
                        call SaveBoolean(HH,GetHandleId(GetTriggerUnit()),SH_LucciSoru,false)
                else
                        set cjlocgn_00000000=Angle2(GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()),GetLocationX(lsl),GetLocationY(lsl))
                        call EffectCreateAndMove1(false,"war3mapImported\\HakenSaber2.mdl",cjlocgn_00000000,1,0.5,0.8,100,100,100,20,0,0,GetTriggerUnit(),0,cjlocgn_00000000)
                        call EffectCreateAndMove1(false,"war3mapImported\\BlackBlink1.mdl",cjlocgn_00000000,0.5,1,1,100,100,100,20,0,0,GetTriggerUnit(),0,cjlocgn_00000000)
                        call MoveAoe(lsl,GetTriggerUnit(),0,Angle2(GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()),GetLocationX(lsl),GetLocationY(lsl)))
                        call EffectCreateAndMove1(false,"war3mapImported\\HakenSaber2.mdl",cjlocgn_00000000,1,0.5,0.8,100,100,100,20,0,0,GetTriggerUnit(),0,cjlocgn_00000000)
                        call SaveBoolean(HH,GetHandleId(GetTriggerUnit()),SH_LucciSoru,false)
                endif
        endif
        if lsl!=null then
                call RemoveLocation(lsl)
                set lsl=null
        endif
endfunction
function InitTrig_LucciSoru takes nothing returns nothing
        local trigger t=CreateTrigger()
        local integer i=0
        loop
        call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER,null)
        set i=i+1
        exitwhen i>=bj_MAX_PLAYER_SLOTS
        endloop
        call TriggerAddAction(t,function LucciSoruAct)
        set t=null
endfunction
function LucciShiganAttackMove1 takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(HH,id,1)
        local unit c=LoadUnitHandle(HH,id,2)
        local integer i=LoadInteger(HH,id,5)
        call SaveInteger(HH,id,5,i+1)
        if i==1 then
            call SetUnitAnimation(u,"stand")
            call UnitSpeed(u,1)
            call SaveBoolean(HH,GetHandleId(c),SH_LucciShigan,false)
            call UnitSpeed(c,1)
            set soundplay=SndN(3526) // Sound\Music\mp3Music\Shigan.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            if GetUnitTypeId(c)!='H10L' then
                call UnitSpeed(c,1.5)
                call SetUnitAnimationByIndex(c,13)
            else
                call SetUnitAnimationByIndex(c,9)
            endif
        endif
        call MoveUnit(u,c,-120,LoadReal(HH,id,3))
        call SetUnitFacing(u,LoadReal(HH,id,3)+180)
        call SetUnitFacing(c,LoadReal(HH,id,3))
        if LoadBoolean(HH,GetHandleId(u),ANTITARGET_ABILITY)==false then
            call PauseUnit(u,true)
            call PauseUnit(c,true)
            call SaveBoolean(HH,GetHandleId(u),TARGET_ABILITY,true)
            call SetUnitInvulnerable(c,true)
            if i==20 then
                if GetUnitTypeId(c)!='H10L' then
                    call UnitSpeed(c,1)
                    call EffectCreateAndMove1(false,"war3mapImported\\az-slash-red.mdl",LoadReal(HH,id,3)+180,1,0.9,0.8,100,100,100,0,100,0,u,0,LoadReal(HH,id,3))
                else
                    call EffectCreateAndMove1(false,"war3mapImported\\az-slash-green.mdl",LoadReal(HH,id,3)+180,1,0.9,0.8,100,100,100,0,100,0,u,0,LoadReal(HH,id,3))
                endif
                call EffectCreateAndMove1(false,"war3mapImported\\CF2.mdl",LoadReal(HH,id,3)+180,1,0.5,0.3,70,70,100,40,100,0,u,0,LoadReal(HH,id,3))
            endif
            if i==30 then
                call EffectCreateAndMove1(false,"war3mapImported\\File00003933.mdl",LoadReal(HH,id,3)+180,1,1,1.5,100,100,100,0,100,0,u,0,LoadReal(HH,id,3))
                call SetUnitInvulnerable(c,false)
                call PauseUnit(u,false)
                call PauseUnit(c,false)
                call SaveBoolean(HH,GetHandleId(u),TARGET_ABILITY,false)
                call myCustomDamage(c,u,LoadReal(HH,id,10),false,false,null,null,null)
                call SetControlToUnit(u,u,0.5,"stun")
                call PauseTimer(t)
                call DestroyTimer(t)
                call FlushChildHashtable(HH,id)
                set t=null
                set c=null
                set u=null
            endif
        else
            call UnitSpeed(c,1)
            call SetUnitInvulnerable(c,false)
            call SaveUnitHandle(HH,GetHandleId(u),REVERSE_TARGET,c)
            call PauseUnit(u,false)
            call PauseUnit(c,false)
            call PauseTimer(t)
            call DestroyTimer(t)
            call FlushChildHashtable(HH,id)
        endif
        set c=null
        set u=null
        set t=null
endfunction
function LucciShiganAttackMove takes unit targetU,unit CasterC,real damage returns nothing
        local timer t=CreateTimer()
        local integer id=GetHandleId(t)
        call SaveReal(HH,id,3,Angle2(GetUnitX(CasterC),GetUnitY(CasterC),GetUnitX(targetU),GetUnitY(targetU)))
        call SaveUnitHandle(HH,id,1,targetU)
        call SaveUnitHandle(HH,id,2,CasterC)
        call SaveInteger(HH,id,5,0)
        call SaveReal(HH,id,10,damage)
        call TimerStart(t,0.02,true,function LucciShiganAttackMove1)
        set t=null
        set targetU=null
        set CasterC=null
endfunction
function LucciShiganAct takes nothing returns nothing
        local unit Lucci=GetTriggerUnit()
        local real cjlocgn_00000000
        if (GetUnitTypeId(Lucci)=='H10L' or GetUnitAbilityLevel(Lucci, 'LCF1')>0) and IsUnitAlly(GetOrderTargetUnit(), GetOwningPlayer(Lucci))==false then
                if LoadBoolean(HH,GetHandleId(Lucci),SH_LucciShigan)==true and LoadBoolean(HH,GetHandleId(Lucci),SH_LucciSoru)==true then
                        if IsUnitEnemy(GetOrderTargetUnit(),GetOwningPlayer(Lucci))==true and IsUnitInvulnerable(GetOrderTargetUnit())==false and SR(GetUnitX(Lucci),GetUnitY(Lucci),GetUnitX(GetOrderTargetUnit()),GetUnitY(GetOrderTargetUnit()))<=800 then
                                set cjlocgn_00000000=Angle2(GetUnitX(Lucci),GetUnitY(Lucci),GetUnitX(GetOrderTargetUnit()),GetUnitY(GetOrderTargetUnit()))
                                call EffectCreateAndMove1(false,"war3mapImported\\HakenSaber2.mdl",cjlocgn_00000000,1,0.5,0.8,100,100,100,20,0,0,Lucci,0,cjlocgn_00000000)
                                call EffectCreateAndMove1(false,"war3mapImported\\BlackBlink1.mdl",cjlocgn_00000000,0.5,1,1,100,100,100,20,0,0,Lucci,0,cjlocgn_00000000)
                                call MoveUnit(GetOrderTargetUnit(),Lucci,-150,cjlocgn_00000000)
                                call EffectCreateAndMove1(false,"war3mapImported\\HakenSaber2.mdl",cjlocgn_00000000,1,0.5,0.8,100,100,100,20,0,0,Lucci,0,cjlocgn_00000000)
                                call SaveBoolean(HH,GetHandleId(Lucci),SH_LucciSoru,false)
                                if GetUnitTypeId(Lucci)!='H10L' then
                                        set soundplay=SndN(697) // Sound\Music\mp3Music\Soru2.mp3
                                        call StartSound(soundplay)
                                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                                        call LucciShiganAttackMove(GetOrderTargetUnit(),Lucci,GetHeroAgi(Lucci,true)*5)
                                else
                                        set soundplay=SndN(695) // Sound\Music\mp3Music\Soru.mp3
                                        call StartSound(soundplay)
                                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                                        call LucciShiganAttackMove(GetOrderTargetUnit(),Lucci,GetHeroAgi(Lucci,true)*3)
                                endif
                        endif
                endif
        endif
        set Lucci=null
endfunction
function InitTrig_LucciShigan takes nothing returns nothing
        local trigger t=CreateTrigger()
        local integer i=0
        loop
        call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER,null)
        set i=i+1
        exitwhen i>=bj_MAX_PLAYER_SLOTS
        endloop
        call TriggerAddAction(t,function LucciShiganAct)
        set t=null
endfunction

//=========== Lucci Shigan с руки
function LucciShiganAA_Conditions takes nothing returns boolean
        return (GetUnitAbilityLevel(GetAttacker(), 'LCF1')>0) and udg_B==true and IsUnitEnemy(GetTriggerUnit(),GetOwningPlayer(GetAttacker()))
endfunction

function LucciShiganAA_Actions takes nothing returns nothing
        local unit u=GetAttacker()
        local unit c=GetTriggerUnit()
        local integer id_caster = GetHandleId(u)
        local real damage=GetUnitTotalDamage(u)
        local boolean LucciShiganAttack=LoadBoolean(HH,id_caster,SH_LucciShigan)==true
        if LucciShiganAttack then
                if GetUnitTypeId(u)=='HHT2' then
                        call LucciShiganAttackMove(c,u,damage*(1.95+GetHeroLevel(u)*0.03)+GetHeroAgi(u,true)*1)
                else
                        call LucciShiganAttackMove(c,u,damage*(1.3+GetHeroLevel(u)*0.02)+GetHeroAgi(u,true)*(1.3+GetHeroLevel(u)*0.02))
                endif 
        else
                call RemoveSavedBoolean(HH, id_caster, SH_LucciShigan)
        endif
        set u=null
        set c=null
endfunction

function InitTrig_LucciShiganAA takes nothing returns nothing
        local trigger trig=CreateTrigger()
        call TriggerRegisterAnyUnitEventBJ(trig,EVENT_PLAYER_UNIT_ATTACKED)
        call TriggerAddCondition(trig,Condition(function LucciShiganAA_Conditions))
        call TriggerAddAction(trig,function LucciShiganAA_Actions)
        set trig=null
endfunction



