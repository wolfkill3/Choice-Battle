function PushTimed1Hibari takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local real facing=LoadReal(HH,id,3)
local real speed=LoadReal(HH,id,2)
local real dist=LoadReal(HH,id,6)
if dist>0 then
call MoveUnit(LoadUnitHandle(HH,id,1),LoadUnitHandle(HH,id,1),-speed,facing)
call SaveReal(HH,id,6,dist-speed)
call SaveReal(HH,id,2,speed-speed*0.03)
else
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
endfunction
function PushTimedHibari takes unit caster0,real facing0,real speed,real dist returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(HH,id,1,caster0)
call SaveReal(HH,id,6,dist)
call SaveReal(HH,id,2,speed)
call SaveReal(HH,id,3,facing0)
call TimerStart(t,0.03,true,function PushTimed1Hibari)
set caster0=null
set t=null
endfunction

function HibariQBlockMove1 takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local real time=LoadReal(HH,id,5)
local real x0
local real y0
local real facing
set time=time+0.02
call SaveReal(HH,id,5,time)
if time<5 then
if time>0.25 then
if time>0.25 then
set x0=GetUnitX(LoadUnitHandle(HH,id,1))
set y0=GetUnitY(LoadUnitHandle(HH,id,1))
call GroupClear(G)
call GroupEnumUnitsInRange(G,x0,y0,400,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
set facing=Angle2(x0,y0,GetUnitX(n0),GetUnitY(n0))
if SR(x0,y0,GetUnitX(n0),GetUnitY(n0))<450 then
if SR(x0,y0,GetUnitX(n0),GetUnitY(n0))>350 then
call MoveAoe1(x0,y0,n0,350,facing)
endif
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
endif
endif
else
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
endfunction
function HibariQBlockMove takes unit Dummy0 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(HH,id,1,Dummy0)
call TimerStart(t,0.02,true,function HibariQBlockMove1)
set Dummy0=null
set t=null
endfunction



function HibariGQ1Act takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real damage=LoadReal(HH,id,15)
local real time=LoadReal(HH,id,5)
local real x0=GetUnitX(LoadUnitHandle(HH,id,20))
local real y0=GetUnitY(LoadUnitHandle(HH,id,20))
local real x1=LoadReal(HH,id,11)
local real y1=LoadReal(HH,id,12)
local real distance=SR(x0,y0,x1,y1)
local integer HibariGtype=LoadInteger(HH,id,19)




if distance<=45 or IsTerrainPathable(PolX(x0,50,facing),PolY(y0,50,facing),PATHING_TYPE_FLYABILITY)==true then
//call UnitSpeed(n0,0.1)
if HibariGtype==3 then
call EffectCreateAndMove(true,"Others\\DarkNova.mdl",facing,1,1,1,100,100,100,0,-100,LoadUnitHandle(HH,id,20),0,facing)
call EffectCreateAndMove(true,"Others\\Death Release.mdl",facing,1,3,1.5,100,100,100,0,-100,LoadUnitHandle(HH,id,20),0,facing)
endif

if HibariGtype==1 then
if LoadBoolean(HH,id,21)==true then
call EffectCreateAndMove(true,"Others\\Death Release.mdl",facing,1,2.25,1.25,100,100,100,0,-100,LoadUnitHandle(HH,id,20),0,facing)
else
call EffectCreateAndMove(true,"Others\\Death Release.mdl",facing,1,1.75,1.25,100,100,100,0,-100,LoadUnitHandle(HH,id,20),0,facing)
endif
endif

if HibariGtype==2 then
//
call SetUnitAnimationByIndex(LoadUnitHandle(HH,id,20),0)
//
call EffectCreateAndMove(true,"Others\\s_ShadowEruption_Rain.mdl",facing,1,2,1,100,100,100,0,-100,LoadUnitHandle(HH,id,20),0,facing)
endif

call EffectCreateAndMove(true,"Others\\az_slb.mdl",facing,1,2,1.5,100,100,100,50,0,LoadUnitHandle(HH,id,20),0,facing)
call EffectCreateAndMove(true,"Others\\HakkeStart2.mdl",facing,1,1,1.5,100,100,100,50,0,LoadUnitHandle(HH,id,20),0,facing)
call GroupClear(G)
if HibariGtype!=3 then
if LoadBoolean(HH,id,21)==true then
call GroupEnumUnitsInRange(G,GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),500,Base)
else
call GroupEnumUnitsInRange(G,GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),400,Base)
endif
endif
if HibariGtype==3 then
call GroupEnumUnitsInRange(G,GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),600,Base)
endif
loop
set n0=FirstOfGroup(G)
exitwhen n0==null

if  Condition_Base(GetOwningPlayer(caster),n0)   then

call myCustomDamage(caster,n0,damage,false,false,null,null,null)

if HibariGtype==1 then

call SetControlToUnit(n0,n0, 2, "stun")

if LoadBoolean(HH,id,21)==true then
call PushTimedHibari(n0,Angle2(GetUnitX(n0),GetUnitY(n0),x0,y0),40,400)
else
call PushTimedHibari(n0,Angle2(GetUnitX(n0),GetUnitY(n0),x0,y0),20,200)
endif

endif

if HibariGtype==2 then

call SetControlToUnit(n0,n0, 2, "stun")
endif




endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
if HibariGtype==2 then
call UnitAddAbility(LoadUnitHandle(HH,id,20),'KHQ3')
call MyRemoveUnit(LoadUnitHandle(HH,id,20),5)
call UnitSpeed(LoadUnitHandle(HH,id,20),1.5)
call EffectCreateAndMove(true,"Others\\HakkeStart2.mdl",facing,5,1,0.2,100,100,100,50,0,LoadUnitHandle(HH,id,20),0,facing)
endif
if HibariGtype==1 then
if LoadBoolean(HH,id,21)==true then
call UnitScale(LoadUnitHandle(HH,id,20),1.5,8,0.25)
else
call UnitScale(LoadUnitHandle(HH,id,20),1,6,0.25)
endif
call MyRemoveUnit(LoadUnitHandle(HH,id,20),1.5)
endif
if HibariGtype==3 then
call UnitScale(LoadUnitHandle(HH,id,20),1.5,12,0.25)
call HibariQBlockMove(LoadUnitHandle(HH,id,20))
call MyRemoveUnit(LoadUnitHandle(HH,id,20),5)
call UnitColor(LoadUnitHandle(HH,id,20),100,100,100,60)
call EffectCreateAndMove(true,"Others\\HakkeStart2.mdl",facing,5,1.5,0.2,100,100,100,50,0,LoadUnitHandle(HH,id,20),0,facing)
endif
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else
set time=time+0.02
if time==0.1 then
set time=0
call EffectCreateAndMove(true,"Others\\s_ShadowEruption_Rain.mdl",facing,0.5,0.5,1,100,100,100,0,0,LoadUnitHandle(HH,id,20),0,facing)
endif
call SaveReal(HH,id,5,time)
call MoveUnit(LoadUnitHandle(HH,id,20),LoadUnitHandle(HH,id,20),40,facing)
endif
set caster=null
endfunction


function HibariGQ1 takes integer HibariGtype,unit caster0,real x00,real y00,real facing00,real damage0,boolean origType returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
set n0=CreateUnit(GetOwningPlayer(caster0),'e200',GetUnitX(caster0),GetUnitY(caster0),facing00)

if HibariGtype==3 then
call SetUnitModel(n0,"Others\\HibariBoxFuture_new2.mdl")
else


if HibariGtype==1 then
call SetUnitModel(n0,"Others\\hibary_box_weaponQ1.mdl")
else

//call SetUnitModel(n0,"Others\\hibary box weapon.mdl")
call SetUnitModel(n0,"Others\\hibary_box_weaponQ2.mdl")
endif


endif

call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call SetUnitFlyHeight(n0,100,0)

if HibariGtype==1 then
//call UnitSpeed(n0,0)

if origType==true then
call UnitSize(n0,1.5,1.5,1.5)
else
call UnitSize(n0,1,1,1)
endif

endif

if HibariGtype==2 then

//call UnitSpeed(n0,0.1)
call SetUnitAnimationByIndex(n0,1)
call UnitSize(n0,1.5,1,1)
endif

if HibariGtype==3 then
//call UnitSpeed(n0,0)
call UnitSize(n0,1.5,1,1)
endif

call MoveUnit(n0,n0,50,Angle2(GetUnitX(n0),GetUnitY(n0),x00,y00))
call SaveReal(HH,id,3,Angle2(GetUnitX(n0),GetUnitY(n0),x00,y00))
call SaveUnitHandle(HH,id,20,n0)
call SaveUnitHandle(HH,id,1,caster0)
call SaveReal(HH,id,11,x00)
call SaveReal(HH,id,12,y00)
call SaveReal(HH,id,15,damage0)
call SaveInteger(HH,id,19,HibariGtype)
call SaveBoolean(HH,id,21,origType)
call TimerStart(t,0.02,true,function HibariGQ1Act)
set caster0=null
set n0=null
set t=null
endfunction













function AbilNull takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endfunction

function HibariGChoice_Act takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit caster=GetTriggerUnit()
local real x0=GetUnitX(caster)
local real y0=GetUnitY(caster)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real damage=(GetHeroAgi(caster,true)+50)*(GetUnitAbilityLevel(caster,'A06A'))+100
local real facing=Angle2(x0,y0,x1,y1)
call SaveUnitHandle(HH,id,1,caster)
call SaveReal(HH,id,11,x1)
call SaveReal(HH,id,12,y1)
call SaveReal(HH,id,3,facing)




if GetSpellAbilityId()=='KHG1' then
call UnitRemoveAbility(caster,'KHG1')
call UnitAddAbility(caster,'KHG2')

call TimerStart(t,0.02,false,function AbilNull)
endif

if GetSpellAbilityId()=='KHG2' then
call UnitRemoveAbility(caster,'KHG2')
call UnitAddAbility(caster,'KHG3')

call TimerStart(t,0.02,false,function AbilNull)
endif

if GetSpellAbilityId()=='KHG3' then
call UnitRemoveAbility(caster,'KHG3')
call UnitAddAbility(caster,'KHG1')

call TimerStart(t,0.02,false,function AbilNull)
endif

if GetSpellAbilityId()=='HiW1' then
if GetUnitAbilityLevel(caster,'KHG1')>0 then
call UnitAddAbility(caster,'KHW2')
call SetUnitAcquireRange(caster, 600+B2I(UnitHasBow(caster))*(600*0.3+50))
call SetUnitAttackRangeByIndex(caster, 0, 600+B2I(UnitHasBow(caster))*(600*0.3+50))
call TimerStart(t,0.02,true,function HibarGW1)
endif

if GetUnitAbilityLevel(caster,'KHG2')>0 then
call UnitAddAbility(caster,'KHW3')
call TimerStart(t,0.02,true,function HibarGW2)
endif

if GetUnitAbilityLevel(caster,'KHG3')>0 then
call UnitAddAbility(caster,'KHW4')
call TimerStart(t,0.02,true,function HibarGW3)
endif

endif

if GetSpellAbilityId()=='A06A' then





if GetUnitAbilityLevel(caster,'KHG1')>0 then


set soundplay=SndN(3989) // Sound\Music\mp3Music\HibariQ2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять

call HibariGQ1(1,caster,x1,y1,facing,damage*1.2,true)
call HibariGQ1(1,caster,PolX(x1,300,facing-90),PolY(y1,300,facing-90),facing,damage*0.2,false)
call HibariGQ1(1,caster,PolX(x1,300,facing+90),PolY(y1,300,facing+90),facing,damage*0.2,false)
endif

if GetUnitAbilityLevel(caster,'KHG2')>0 then

set soundplay=SndN(922) // Sound\Music\mp3Music\HibariQ.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять

call HibariGQ1(2,caster,PolX(x1,150,facing-90),PolY(y1,150,facing-90),facing,damage*0.6,true)
call HibariGQ1(2,caster,PolX(x1,150,facing+90),PolY(y1,150,facing+90),facing,damage*0.6,true)
endif

if GetUnitAbilityLevel(caster,'KHG3')>0 then

set soundplay=SndN(3991) // Sound\Music\mp3Music\HibariQ3.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять



call HibariGQ1(3,caster,x1,y1,facing,damage,true)
endif

call TimerStart(t,0.02,false,function AbilNull)
endif






set t=null
set caster=null
endfunction
function HibariGChoice_Cond takes nothing returns boolean
if GetSpellAbilityId()=='A06A' or GetSpellAbilityId()=='HiW1' or GetSpellAbilityId()=='HibE' or GetSpellAbilityId()=='KHG1' or GetSpellAbilityId()=='KHG2' or GetSpellAbilityId()=='KHG3' then
return true
else
return false
endif
endfunction
function InitTrig_HibariG takes nothing returns nothing
local trigger HibariGChoice=CreateTrigger()
local integer index
set index=0
loop
call TriggerRegisterPlayerUnitEvent(HibariGChoice,Player(index),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set index=index+1
exitwhen index==bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddCondition(HibariGChoice,Condition(function HibariGChoice_Cond))
call TriggerAddAction(HibariGChoice,function HibariGChoice_Act)
set HibariGChoice=null
set index=0
endfunction
//hibari end
//Kiyohime start
function KiyohimeGAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit target=LoadUnitHandle(HH,id,2)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real x0=GetUnitX(target)
local real y0=GetUnitY(target)
local real damage=LoadReal(HH,id,15)
set time=time+0.02
call SaveReal(HH,id,5,time)

if time==2 then
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else

if time==1 or time==1.1  or time==1.2 or time==1.3 or time==1.4 or time==1.5 or time==1.6 or time==1.7 or time==1.8 or time==1.9 then
call DamageAoeOneTime0(caster,x0,y0,300,damage*0.1)
call StopAoeOneTime(caster,x0,y0,300)
endif

if time==0.2 then
if LoadBoolean(HH,GetHandleId(target),ANTITARGET_ABILITY)==false then
call EffectCreateAndMove(true,"Others\\BlackBlink1.mdl",facing,1,1,1,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"Others\\WindWeak(Thicker).mdl",facing,1,0.5,1,100,100,100,0,0,caster,0,facing)
else
call MoveAoe1(x0,y0,caster,-150,Angle2(GetUnitX(caster),GetUnitY(caster),x0,y0) )
call UnitSpeed(caster,1)
call PauseUnit(target,false)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
call SetUnitInvulnerable(target,false)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
call SaveUnitHandle(HH,GetHandleId(target),REVERSE_TARGET,caster)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
endif

if time>=0.2 and time<1 then
call MoveAoe1(x0,y0,caster,-150,Angle2(GetUnitX(caster),GetUnitY(caster),x0,y0) )
endif

if time==0.24 then
call EffectCreateAndMove(true,"Others\\HakkeStart2.mdl",facing,2,1,0.5,100,100,100,50,0,caster,0,facing)
call EffectCreateAndMove(true,"Others\\file00001412.mdl",facing,1,0.5,1.5,100,100,100,0,0,caster,100,facing)
endif

if time==0.5 then
call SetUnitAnimationByIndex(caster,7)
endif

if time>0.2 and time<1 then
call PauseUnit(target,true)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
call SetUnitInvulnerable(target,true)
call SetUnitPathing(target,false)
endif

if time<1 then
call SetUnitPathing(caster,false)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
endif

if time==1 then
call EffectCreateAndMove(true,"Others\\file00004805.mdl",facing,1,1.75,1.5,100,100,100,0,100,caster,0,facing)
call UnitSpeed(caster,1)
call SetUnitPathing(caster,true)
call SetUnitPathing(target,true)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
call PauseUnit(target,false)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
call SetUnitInvulnerable(target,false)

call DamageAoeAndStun(caster,x0,y0,300,damage,0.5)


if udg_B==true then
call SaveInteger(HH, GetHandleId(caster) ,SH_BonusSTR,LoadInteger(HH, GetHandleId(caster) ,SH_BonusSTR)+2)
call SetHeroStr(caster,GetHeroStr(caster,false)+2,true)
call SaveInteger(HH, GetHandleId(caster) ,SH_BonusAGI,LoadInteger(HH, GetHandleId(caster) ,SH_BonusAGI)+1)
call SetHeroAgi(caster,GetHeroAgi(caster,false)+1,true)
endif



endif



endif

set caster=null
set target=null
endfunction

function KiyohimeGChoice_Act takes nothing returns nothing
local timer t=null
local integer id=0
local unit caster=GetTriggerUnit()
local unit target=null
local real x0=GetUnitX(caster)
local real y0=GetUnitY(caster)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real facing=Angle2(x0,y0,x1,y1)


if GetSpellAbilityId()=='KiyG' then

set t=CreateTimer()
set id=GetHandleId(t)
set target=GetSpellTargetUnit()

call SaveUnitHandle(HH,id,1,caster)
call SaveUnitHandle(HH,id,2,target)
//call SaveReal(HH,id,11,x1)
//call SaveReal(HH,id,12,y1)
call SaveReal(HH,id,3,facing)

set soundplay=SndN(3993) // Sound\Music\mp3Music\KiyohimeGAttack.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set soundplay=SndN(3995) // Sound\Music\mp3Music\KiyohimeGAtp.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call SetUnitAnimationByIndex(caster,2)
call UnitSpeed(caster,0.5)
call SaveReal(HH,id,15,2*GetUnitTotalDamage(caster) )
call TimerStart(t,0.02,true,function KiyohimeGAct)
else


endif
if GetSpellAbilityId()=='Ao7D' then
set soundplay=SndN(3997) // Sound\Music\mp3Music\KiyohimeW.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif

set t=null
set caster=null
set target=null
endfunction

function KiyohimeGChoice_Cond takes nothing returns boolean
if GetSpellAbilityId()=='KiyG' or GetSpellAbilityId()=='Ao7D' then
return true
else
return false
endif
endfunction

function InitTrig_KiyohimeG takes nothing returns nothing
local trigger KiyohimeGChoice=CreateTrigger()
local integer index
set index=0
loop
call TriggerRegisterPlayerUnitEvent(KiyohimeGChoice,Player(index),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set index=index+1
exitwhen index==bj_MAX_PLAYER_SLOTS
endloop
