function CastThunderStrike2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real a=LoadReal(h,id,4)
local real speed=LoadReal(h,id,5)
local real dist=LoadReal(h,id,10)
local real x=GetUnitX(l__d)+speed*Cos(a)
local real y=GetUnitY(l__d)+speed*Sin(a)
local real x1
local real ab
local real y1
local real dmg=GetHeroInt(u,true)*(2+GetUnitAbilityLevel(u,'A0GS'))
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,3)
local unit c=LoadUnitHandle(h,id,11)
if speed>0 then
        if IsTerrainPathable(x,y, PATHING_TYPE_FLYABILITY)==false then
                call SetUnitXY_1(l__d,x,y, false)
        else
                call SetUnitXY_1(l__d,GetUnitX(l__d),GetUnitY(l__d), false)
        endif
        call UnitApplyTimedLife(CreateUnit(p,0x65304132,x,y,GetRandomReal(0,359)),1,0.5)
        call GroupEnumUnitsInRange(G,x,y,700,Base)
        loop
                set E=FirstOfGroup(G)
                exitwhen E==null
                call GroupRemoveUnit(G,E)
                if Condition_Base(p,E)then
                        set c=E
                        call SaveUnitHandle(h,id,11,c)
                endif
        endloop
        call GroupEnumUnitsInRange(g,x,y,100,Base)
        set idg=GetHandleId(g)
        loop
                set E=FirstOfGroup(g)
                set ide=GetHandleId(E)
                if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
                        set x1=GetUnitX(c)
                        set y1=GetUnitY(c)
                        call SaveReal(h,id,10,0)
                        set dist=0
                        call myCustomDamage(u,E,dmg,false,false,null,null,null)
                        call SaveUnitHandle(h,idg,ide,E)
                        call SaveReal(h,id,5,speed+10)
                        call UnitApplyTimedLife(CreateUnit(p,'e03S',GetUnitX(E),GetUnitY(E),GetRandomReal(0,359)),1,1)
                        if n==null then
                                call SaveReal(h,id,4,GetAngle(x,y,x1,y1,Atan2(y1-y,x1-x),25,100))
                        else
                                call SaveReal(h,id,4,Atan2(GetUnitY(E)-y,GetUnitX(E)-x))
                        endif
                        call SetControlToUnit(E,E, 2, "stun")
                endif
                call GroupRemoveUnit(g,E)
                exitwhen E==null
        endloop
        call SaveReal(h,id,5,LoadReal(h,id,5)-1)
        call SaveReal(h,id,10,dist+speed)
        if dist>250 then
                call FlushChildHashtable(h,idg)
                call SaveReal(h,id,10,0)
                set dist=0
        endif
else
        call RemoveUnit(l__d)
        call FlushChildHashtable(h,GetHandleId(g))
        call DestroyGroup(g)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
endif
set g=null
set u=null
set c=null
set t=null
set l__d=null
set p=null
endfunction
