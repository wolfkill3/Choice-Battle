function CondRFH takes nothing returns boolean
return udg_B==false and round>0
endfunction
function CastRFH takes nothing returns nothing
local integer ip=GetPlayerId(GetTriggerPlayer())
local unit u=Hero[ip]
local item array it
local integer i=0
local integer str=StringHash("tamafrost")
local player p=GetOwningPlayer(u)
if rfhr[ip]!=0 then
set rfhr[ip]=0
set rfhpick=false
if GetUnitTypeId(u)=='H01N' then
set n=CreateUnit(p,'H01M',GetRectCenterX(gg_rct_Resp7),GetRectCenterY(gg_rct_Resp7),0)
else
set n=CreateUnit(p,GetUnitTypeId(u),GetRectCenterX(gg_rct_Resp7),GetRectCenterY(gg_rct_Resp7),0)
endif
set rfhpick=true
set Hero[ip]=n
set udg_Hero[ip+1]=n
call W3MMD_Lite_Set_Integer(p,"Picked_hero",HeroSkin(udg_Hero[ip+1]))
call ShowUnitAbilityTimed(n,'A10B',true,0.13)
call ShowUnitAbilityTimed(n,'A20B',false,0.12)
call ShowUnitAbilityTimed(n,'A30B',false,0.12)
call ShowUnitAbility(n,'TMW0',true)
call ShowAbility2('A0J5',true)
call ShowAbility2('A177',true)
call ShowAbility2('A0TN',true)
call EnableUnitAbility2(n,'A0TN',false,true)
if GetHeroLevel(u)>1 then
call SetHeroLevel(n,GetHeroLevel(u),false)
endif
if GetUnitTypeId(Hero[ip])=='H067' then
call RemoveUnit(LoadUnitHandle(HH,GetHandleId(u),str+1))
call RemoveUnit(LoadUnitHandle(HH,GetHandleId(u),str+2))
call RemoveUnit(LoadUnitHandle(HH,GetHandleId(u),str+3))
call RemoveUnit(LoadUnitHandle(HH,GetHandleId(u),str+4))
endif
if GetUnitTypeId(Hero[ip])=='H05A' or GetUnitTypeId(Hero[ip])=='H05B' then
call ShowAbility2('A901',true)
endif
if GetUnitTypeId(Hero[ip])=='Ho0Z' then
    set cDantesRegen = 0
endif
loop
exitwhen i>=6
        if GetItemTypeId(UnitItemInSlot(u,i))!='Ibrk' then
                set it[i]=UnitItemInSlot(u,i)
        endif
        set i=i+1
endloop
if FFAMode==false then
if ip<5 then
        call GroupAddUnit(udg_CG[1],n)
elseif ip>=5 and ip<10 then
        call GroupAddUnit(udg_CG[2],n)
endif
else
call GroupAddUnit(udg_CG[4],n)
endif
set i=0
loop
exitwhen i>=6
        call UnitAddItemById(n,GetItemTypeId(it[i]))
        set i=i+1
endloop
if GetUnitTypeId(u)=='H069' then
call RemoveUnit(LoadUnitHandle(HH,GetHandleId(GetOwningPlayer(u)),ComboBarHash))
call UnitRemoveAbility(u,'A1BN')
endif
call FlushChildHashtable(HH,GetHandleId(u))
call RemoveUnit(u)
if GetLocalPlayer()==p then
call ClearSelection()
call SelectUnit(n,true)
endif
if GetUnitTypeId(Hero[ip])=='H052' then
call SetHeroInt(Hero[ip],GetHeroInt(Hero[ip],false)+udg_kill[ip]*2,true)
endif
if GetUnitTypeId(Hero[ip])=='H06T' then
set LUcy[ip]=Hero[ip]
set lucy[ip]=false
endif
//if GetUnitTypeId(Hero[ip])=='H01N' then
//    call SetUnitAbilityLevel(Hero[ip],'A0D4',1)
//endif
if GetUnitTypeId(Hero[ip])=='H074' then
set oreha=Hero[ip]
endif
if GetUnitTypeId(Hero[ip])=='H02H' then
set Goku=Hero[ip]
endif
//call AddUnitMaxLife(Hero[ip],(round-1)*150)
call SetHeroInt(Hero[ip],GetHeroInt(Hero[ip],false)+((round-1)-GetPlayerState(p,PLAYER_STATE_RESOURCE_LUMBER))*3,true)
call SetHeroAgi(Hero[ip],GetHeroAgi(Hero[ip],false)+((round-1)-GetPlayerState(p,PLAYER_STATE_RESOURCE_LUMBER))*3,true)
call SetHeroStr(Hero[ip],GetHeroStr(Hero[ip],false)+((round-1)-GetPlayerState(p,PLAYER_STATE_RESOURCE_LUMBER))*3,true)
call SetHeroInt(Hero[ip],GetHeroInt(Hero[ip],false)+hibari[ip]*2,true)
call SetHeroAgi(Hero[ip],GetHeroAgi(Hero[ip],false)+hibari[ip]*2,true)
call SetHeroStr(Hero[ip],GetHeroStr(Hero[ip],false)+hibari[ip]*2,true)
if GetUnitTypeId(Hero[ip]) == 'H02L' then//stats broly
call SetHeroStr(Hero[ip],GetHeroStr(Hero[ip],false)+bState,true)
call ShowAbility2('A3DJ',false)
call ShowAbility2('A2DJ',true)
endif
if GetUnitTypeId(Hero[ip])=='H04B' then         // Gon Откат T
        call PauseUnit(Hero[ip],false)
        call UnitRemoveBuffs(Hero[ip],false,true)
        call ShowAbility2('A23V',false)
        call ShowAbility2Timed('A13V',true,0.1)
        call UnitAddAbility(Hero[ip],'S005')
        call IssueImmediateOrder(Hero[ip], "bearform")
        call UnitRemoveAbility(Hero[ip],'S005')
        call SetUnitAbilityLevel(Hero[ip],'A0U8',1)
endif
if GetUnitTypeId(Hero[ip])=='HYuj' then //0x48303439
set i=0
loop
exitwhen i>yuji4[ip]
call UnitAddAbility(Hero[ip],'A0T8')
call SetUnitAbilityLevel(Hero[ip],'A0T8',2)
call UnitRemoveAbility(Hero[ip],'A0T8')
//call UnitAddAbility(Hero[ip],'A0T7')
//call SetUnitAbilityLevel(Hero[ip],'A0T7',2)
//call UnitRemoveAbility(Hero[ip],'A0T7')
set i=i+1
endloop
endif
if GetUnitTypeId(Hero[ip])=='H04A' then
    set Gon=Hero[ip]
endif
if GetUnitTypeId(Hero[ip])=='H02L' then
    set Broly=Hero[ip]
endif
endif
set u=null
set p=null
endfunction
