function LuccyW_Arrow_Act takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real distance=LoadReal(HH,id,8)
local real time=LoadReal(HH,id,5)
set time=time+0.02
call SaveReal(HH,id,5,time)
if distance>=2000 then
call DestroyGroup(LoadGroupHandle(HH,id,4))
call SetUnitAnimationByIndex(LoadUnitHandle(HH,id,20),2)
call UnitColor(LoadUnitHandle(HH,id,20),0,0,0,100)
call MyRemoveUnit(LoadUnitHandle(HH,id,20),2)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
else
call MoveUnit(LoadUnitHandle(HH,id,20),LoadUnitHandle(HH,id,20),95,facing)


set n=CreateUnit(GetOwningPlayer(caster),'e134',GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),facing)
call SetUnitTimeScale(n,2)
call UnitApplyTimedLife(n,1,0.3)



call DamageAoeOneTime(caster,GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),150,LoadReal(HH,id,15),LoadGroupHandle(HH,id,4))



call SaveReal(HH,id,8,distance+95)


endif
set caster=null
set t=null
endfunction



