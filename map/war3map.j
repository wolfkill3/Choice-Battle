function AizenT2PassiveAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit target=LoadUnitHandle(HH,id,2)
local unit Dummy=LoadUnitHandle(HH,id,20)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real damage=LoadReal(HH,id,15)

set time=time+0.02
call SaveReal(HH,id,5,time)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call PauseUnit(target,true)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
call SetUnitInvulnerable(target,true)
call MoveUnit(target,caster,-150,facing)

if time==0.02 then
call ShowUnit(caster,true)





if GetAbilityCooldown(GetUnitAbility(Dummy, 'ASQ1'))>0 then
  call StartAbilityCooldown(GetUnitAbility(caster, 'ASQ1'), GetAbilityRemainingCooldown(GetUnitAbility(Dummy, 'ASQ1')))
endif

if GetAbilityCooldown(GetUnitAbility(Dummy, 'ASW1'))>0 then
  call StartAbilityCooldown(GetUnitAbility(caster, 'ASW1'), GetAbilityRemainingCooldown(GetUnitAbility(Dummy, 'ASW1')))
endif

if GetAbilityCooldown(GetUnitAbility(Dummy, 'ASE1'))>0 then
  call StartAbilityCooldown(GetUnitAbility(caster, 'ASE1'), GetAbilityRemainingCooldown(GetUnitAbility(Dummy, 'ASE1')))
endif

if GetAbilityCooldown(GetUnitAbility(Dummy, 'ASR1'))>0 then
  call StartAbilityCooldown(GetUnitAbility(caster, 'ASR1'), GetAbilityRemainingCooldown(GetUnitAbility(Dummy, 'ASR1')))
endif


if GetAbilityCooldown(GetUnitAbility(Dummy, 'ASF1'))>0 then
  call StartAbilityCooldown(GetUnitAbility(caster, 'ASF1'), GetAbilityRemainingCooldown(GetUnitAbility(Dummy, 'ASF1')))
endif

if GetAbilityCooldown(GetUnitAbility(Dummy, 'ASG1'))>0 then
  call StartAbilityCooldown(GetUnitAbility(caster, 'ASG1'), GetAbilityRemainingCooldown(GetUnitAbility(Dummy, 'ASG1')))
endif





call SetTextTagVelocity(LoadTextTagHandle(HH,GetHandleId(Dummy),TextTagTargetHash),0.2*Cos(1.571),0.2*Sin(1.571))
call SetTextTagFadepoint(LoadTextTagHandle(HH,GetHandleId(Dummy),TextTagTargetHash),0.5)
call SetTextTagLifespan(LoadTextTagHandle(HH,GetHandleId(Dummy),TextTagTargetHash),0.2)
call RemoveSavedHandle(HH,GetHandleId(Dummy),TextTagTargetHash)
call RemoveUnit(Dummy)


if (GetLocalPlayer()==GetOwningPlayer(caster) or GetPlayerAlliance(GetOwningPlayer(caster),GetLocalPlayer(),ALLIANCE_SHARED_CONTROL)) and GetUnitSelected(GetLocalPlayer())==Dummy then
call ClearSelection()
call SelectUnit(caster,true)
endif
if LoadBoolean(HH,GetHandleId(target),ANTITARGET_ABILITY)==false then
set facing=GetUnitFacing(target)
call SaveReal(HH,id,3,facing)
call SetUnitAnimationByIndex(caster,5)
call UnitSpeed(caster,0.5)
call SetUnitFacing(caster,facing)
set soundplay=SndN(3957) // Sound\Music\mp3Music\AizenT2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call UnitSpeed(caster,1)
call EffectCreateAndMove(true,"BlackGoku\\[A]az_axe_ef1.mdl",GetRandomReal(0,360),1.25,1,0.5,100,60,60,0,0,caster,0,facing)
call EffectCreateAndMove(true,"Sabrac\\red-yumao-zhendiLord.mdl",facing,2,0.8,1,100,100,100,40,0,caster,0,facing)
call EffectCreateAndMove(true,"Aizen\\red-smoke1.mdl",facing,1.5,1.25,1,100,100,100,0,100,caster,0,facing)
call EffectCreateAndMove(true,"Others\\HakkeStart2.mdl",facing,1.5,1.25,0.5,100,100,100,80,0,caster,0,facing)
else
call UnitSpeed(caster,1)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'ASQ1',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'ASW1',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'ASE1',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'ASR1',true)
call PauseUnit(target,false)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
call SetUnitInvulnerable(target,false)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
call SaveUnitHandle(HH,GetHandleId(target),REVERSE_TARGET,caster)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
endif

if time==0.1 then
call EffectCreateAndMove(true,"Aizen\\LXY-ZK_BM_Red knife shine4-1.mdl",facing+60,1.5,0.6,1,100,100,100,0,50,target,-150,facing)
call EffectCreateAndMove(true,"Aizen\\LXY-ZK_BM_Red knife shine4-1.mdl",facing+60,1.5,0.8,1,100,100,100,0,50,target,-150,facing)
call EffectCreateAndMove(true,"Aizen\\LXY-ZK_BM_Red knife shine4-1.mdl",facing+60,1.5,1,1,100,100,100,0,50,target,-150,facing)
endif

if time==0.2 then
call EffectCreateAndMove(true,"Sabrac\\File00003933.mdl",facing,1.5,2,1,100,100,100,0,100,target,0,facing)
call EffectCreateAndMove(true,"Sabrac\\File00003933.mdl",facing,1.5,1,1,100,100,100,0,100,target,0,facing)
call EffectCreateAndMove(true,"Aizen\\red-smoke1.mdl",facing,1.5,2.5,1,100,100,100,0,100,target,0,facing)
call EffectCreateAndMove(true,"Aizen\\red-blood-ball.mdl",facing,0.75,2.5,2.5,100,100,100,0,50,target,0,facing)
call EffectCreateAndMove(true,"Sabrac\\bloodex1.mdl",facing,1,3,1,100,100,100,0,100,target,0,facing)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'ASQ1',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'ASW1',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'ASE1',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'ASR1',true)
call PauseUnit(target,false)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
call SetUnitInvulnerable(target,false)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)



call myCustomDamage(caster,target,damage,false,false,null,null,null)


set soundplay=SndN(3960) // Sound\Music\mp3Music\AizenT2Slash.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
set caster=null
set target=null
set Dummy=null
endfunction

function AizenTPassiveAct takes unit caster0,unit target0,unit dummy0 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit caster=caster0
local unit target=target0
local real facing=GetUnitFacing(target)
call SaveReal(HH,id,3,facing)
call SaveUnitHandle(HH,id,1,caster)
call SaveUnitHandle(HH,id,20,dummy0)
call SaveUnitHandle(HH,id,30,caster)
call SetUnitFacing(caster,facing)
call PauseUnit(target,true)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
call SetUnitInvulnerable(target,true)
call SaveUnitHandle(HH,id,2,target)
call MoveUnit(target,caster,-150,GetUnitFacing(target))
call SaveBoolean(HH,GetHandleId(caster),SH_AizenTAct,false)
call SaveReal(HH,id,15,5*GetHeroInt(caster,true))
call TimerStart(t,0.02,true,function AizenT2PassiveAct)
set caster=null
set caster0=null
set target=null
set target0=null
set t=null
endfunction





function AizenT1Act takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
