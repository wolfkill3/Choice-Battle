function ShunpoCombinationCond takes nothing returns boolean
return GetSpellAbilityId()=='A0MC'
endfunction
function ShunpoCombinationCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=LoadReal(h,id,1)
local real y=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
local real a=GetRandomReal(0,359)
local real dmg=GetHeroAgi(u,true)*1
if GetUnitCurrentOrder(u)==OrderId("curse")then
    set x=x+GetRandomReal(-600,600)
    set y=y+GetRandomReal(-600,600)
    call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
    if IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
        call SetUnitXY_1(u,x,y, false)
    endif
    call SetUnitAnimation(u,"attack")
    call SetUnitFacing(u,a)
    if GetUnitAbilityLevel(u,'B01A')>0 then
        call Slash(CreateUnit(p,'e02R',x,y,a),75,(0.75+0.25*GetUnitAbilityLevel(u,'A07Q'))*GetHeroAgi(u,true),a*bj_DEGTORAD,1500,125,x,y,x,y)
    elseif GetUnitAbilityLevel(u,'BA1A')>0 then
        call Slash(CreateUnit(p,'eA2R',x,y,a),75,(0.75+0.25*GetUnitAbilityLevel(u,'A27Q'))*GetHeroAgi(u,true),a*bj_DEGTORAD,1500,125,x,y,x,y)
    endif
    call GroupEnumUnitsInRange(G,x,y,220,Base)
    loop
        set E=FirstOfGroup(G)
        exitwhen E==null
        if Condition_Base(p,E)then
            call myCustomDamage(u,E,dmg,false,false,null,null,null)
            if SquareRootPoint(GetUnitX(E), GetUnitY(E), LoadReal(h,id,1), LoadReal(h,id,2))>240 then
                call Push3(E,40,Atan2(LoadReal(h,id,1)-GetUnitY(E),LoadReal(h,id,2)-GetUnitX(E)),200,"")
            endif
        endif
        call GroupRemoveUnit(G,E)
    endloop
    call GroupEnumUnitsInRange(G,LoadReal(h,id,1),LoadReal(h,id,2),240,Base)
    loop
        set E=FirstOfGroup(G)
        exitwhen E==null
        if Condition_Base(p,E)then
            call myCustomDamage(u,E,dmg*.5,false,false,null,null,null)
        endif
        call GroupRemoveUnit(G,E)
    endloop
else
    call PauseTimer(t)
    call SetUnitTimeScale(u,1)
    call UnitRemoveAbility(u,'A0MG')
    call UnitRemoveAbility(u,'A0MH')
    call UnitRemoveAbility(u,'A0GJ')
    call SetUnitInvulnerable(u,false)
    call DestroyTimer(t)
    call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set t=null
endfunction
function ShunpoCombinationCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call UnitAddAbility(u,'A0MG')
call UnitAddAbility(u,'A0MH')
call UnitAddAbility(u,'A0GJ')
call SaveReal(h,id,1,GetUnitX(u))
call SaveReal(h,id,2,GetUnitY(u))
call SetUnitTimeScale(u,4)
call SetUnitInvulnerable(u,true)
if GetUnitTypeId(u)=='H06D' or GetUnitTypeId(u)=='H06E' then
set soundplay=SndN(1575) // Sound\Music\mp3Music\Alterl_E.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
elseif GetUnitTypeId(u)=='H013' or GetUnitTypeId(u)=='H012' then
call SetUnitAnimationByIndex(u,5)
set soundplay=SndN(1577) // Sound\Music\mp3Music\IchigoE.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call TimerStart(t,0.1,true,function ShunpoCombinationCast2)
set u=null
set t=null
endfunction
function ShunpoCombinationInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function ShunpoCombinationCast)
call TriggerAddCondition(t,Condition(function ShunpoCombinationCond))
set t=null
endfunction
function HollowScreamCond takes nothing returns boolean
return GetSpellAbilityId()=='A0MC' and(GetUnitTypeId(GetTriggerUnit())=='H013' or GetUnitTypeId(GetTriggerUnit())=='H06E')
endfunction
function HollowScreamCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real dmg=(1.5+.3*GetUnitAbilityLevel(u,'A0MC'))*(GetHeroAgi(u,true))*0.2
if GetUnitCurrentOrder(u)==OrderId("curse")then
call GroupEnumUnitsInRange(G,x,y,800,Base)
call SetUnitInvulnerable(u,true)
call UnitApplyTimedLife(CreateUnit(p,'e0J9',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0JD',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0JB',x,y,GetRandomReal(0,359)),'BTLF',1)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SlowUnit(u,E,0.5,0,5,1,false)
endif
call GroupRemoveUnit(G,E)
endloop
else
call SetUnitInvulnerable(u,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set t=null
endfunction
function HollowScreamCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SetUnitAnimationByIndex(u,20)
if GetUnitTypeId(u)=='H013' then
set soundplay=SndN(1579) // Sound\Music\mp3Music\HollowRoarHichigo.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call SetUnitInvulnerable(u,true)
call TimerStart(t,0.17,true,function HollowScreamCast2)
set u=null
set t=null
endfunction
function HollowScreamInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function HollowScreamCast)
call TriggerAddCondition(t,Condition(function HollowScreamCond))
set t=null
endfunction
function CondHichigoCero takes nothing returns boolean
return GetSpellAbilityId()=='A1M2' or GetSpellAbilityId()=='A2M2'
endfunction
function CastHichigoCero2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local trigger tt=LoadTriggerHandle(h,id,11)
local real a=LoadReal(h,id,4)
local real dist=LoadReal(h,id,10)
local real x=GetUnitX(l__d)+260*Cos(a)
local real y=GetUnitY(l__d)+260*Sin(a)
local real dmg=9*GetHeroAgi(u,true)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,3)
local real time=LoadReal(h,id,5)
if time<1.35 then
call SaveReal(h,id,5,time+0.04)
if GetUnitTypeId(u)=='H013' then
        call SetUnitAnimationByIndex(u,17)
else
        call SetUnitAnimation(u,"Spell Two")
endif
call SetUnitAnimationOffsetPercent(u,time*0.75)
if time==1.32 then
if GetUnitTypeId(u)!='H013' then
call SetUnitTimeScale(u,1)
endif
set a=GetUnitFacing(u)*bj_DEGTORAD
call SaveReal(h,id,4,a)
call SetUnitAcquireRange(u,600)
call UnitRemoveAbility(u,'A1FU')
call UnitRemoveAbility(u,'Pet1')
call UnitRemoveAbility(u,'B00A')
//call PauseUnit(u,false)
call ShakeCamera(0.5,20)
call SaveUnitHandle(h,id,1,CreateUnit(p,'e0J6',GetUnitX(u),GetUnitY(u),a*bj_RADTODEG))
call TriggerClearActions(tt)
call DestroyTrigger(tt)
endif
if time==0.08 then
call SetControlToUnit(u, u, 1.25, "doomdebug")
endif
else
if dist>0 and IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
call SetUnitXY_1(l__d,x,y, false)
call UnitApplyTimedLife(CreateUnit(p,'e0J2',x,y,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0J5',x,y,GetRandomReal(0,359)),'BTLF',4)
if GetUnitTypeId(u)=='H013' then
call StartSound(soundStr[47])
call UnitApplyTimedLife(CreateUnit(p,'e0J4',x,y,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e0J3',x,y,GetRandomReal(0,359)),'BTLF',4)
else
call UnitApplyTimedLife(CreateUnit(p,'e12A',x,y,GetRandomReal(0,359)),'BTLF',4)
endif
call GroupEnumUnitsInRange(g,x,y,350,Base)
set idg=GetHandleId(g)
call SaveReal(h,id,10,dist-260)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
call SetControlToUnit(E,E, 2, "stun")
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
else
call SetTerrainFogExBJ(0,6000.00,10000,0,1,1,1)
call SetUnitInvulnerable(u,false)
call RemoveUnit(l__d)
call FlushChildHashtable(h,GetHandleId(g))
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
endif
set g=null
set tt=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
function HichigoRStopOrders2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
call IssueImmediateOrder(u,"stop")
call SetUnitFacing(u,Atan2(LoadReal(h,id,1)-GetUnitY(u),LoadReal(h,id,2)-GetUnitX(u))*bj_RADTODEG)
call SetUnitAnimationByIndex(u, 17)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
set t=null
set u=null
endfunction
function HichigoRStopOrders takes nothing returns nothing
local unit u=GetOrderedUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
if GetOrderTargetUnit()==null then
call SaveReal(h,id,2,GetOrderPointX())
call SaveReal(h,id,1,GetOrderPointY())
else
call SaveReal(h,id,2,GetUnitX(GetOrderTargetUnit()))
call SaveReal(h,id,1,GetUnitY(GetOrderTargetUnit()))
endif
call TimerStart(t,0.001,false,function HichigoRStopOrders2)
set u=null
set t=null
endfunction
function CastHichigoCero takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local trigger tt=CreateTrigger()
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,3,CreateGroup())
call SaveReal(h,id,10,3000)
call SetUnitInvulnerable(u,true)
set n=CreateUnit(p,'e0J8',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',6)
call SetUnitTimeScale(n,0.4)
//call PauseUnit(u,true)
call SetTerrainFogEx(0,0,6000,25,0.8,0.1,0.1)
if GetUnitTypeId(u)=='H013' then
        call SetUnitAnimationByIndex(u,17)
        set soundplay=SndN(1581) // Sound\Music\mp3Music\HichigoR.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
        call SetUnitAnimation(u,"Spell Two")
        set soundplay=SndN(1583) // Sound\Music\mp3Music\Alterl R.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerAddAction(tt,function HichigoRStopOrders)
call SetUnitAcquireRange(u,51)
