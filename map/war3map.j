function OrochimaruECast takes nothing returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local unit u=GetTriggerUnit()
    local unit c=GetSpellTargetUnit()
    local player p=GetOwningPlayer(u)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetUnitX(c)
    local real y1=GetUnitY(c)
    local real rad=72*bj_DEGTORAD
    local group g=CreateGroup()
    local integer i=0
    if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
        call PauseUnit(u,true)
        call SetControlToUnit(c,c,1,"heavystun")
        set n=CreateUnit(p,'or08',x1,y1,0)
        call SetUnitTimeScale(n,0.25)
        call UnitApplyTimedLife(n,'BTLF',5)
        set n=CreateUnit(p,'ed0O',x1,y1,0)
        call SetUnitTimeScale(n,0.25)
        call SetUnitVertexColor(n,255,255,255,155)
        call SetUnitScale(n,1.2,1.2,1.2)
        call UnitApplyTimedLife(n,'BTLF',5)
        call SetUnitAnimationByIndex(u,10)
        call SetUnitTimeScale(u,3)
        call SaveUnitHandle(h,id,0,u)
        call SaveUnitHandle(h,id,1,c)
        call SaveGroupHandle(h,id,2,g)
        call SaveReal(h,id,3,0)
        call TimerStart(t,0.25,false,function OrochimaruECast2)
    else
        call GroupClear(g)
        call DestroyGroup(g)
        call PauseTimer(t)
        call SetUnitFlyHeight(u,0,0)
        call DestroyTimer(t)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
        call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
        call FlushChildHashtable(h,id)
    endif
    set c=null
    set p=null
    set g=null
    set t=null
    set u=null
endfunction
