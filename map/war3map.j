call UnitCreateAndMove(caster,'hs13',caster,GetRandomReal(0,360),1,2,1,100,100,100,0,190,LoadUnitHandle(HH,id,23),cjlocgn_00000000,cjlocgn_00000001)
call UnitCreateAndMove(caster,'hs36',caster,GetRandomReal(0,360),1,5,0.5,100,100,100,30,200,LoadUnitHandle(HH,id,23),cjlocgn_00000000,cjlocgn_00000001)
endif

if cjlocgn_00000002==0.1 or cjlocgn_00000002==0.2 then
set cjlocgn_00000000=PolX(LoadReal(HH,id,11),800,facing)
set cjlocgn_00000001=PolY(LoadReal(HH,id,12),800,facing)
call StopAoeOneTime(caster,cjlocgn_00000000,cjlocgn_00000001,900)
set cjlocgn_00000000=PolX(LoadReal(HH,id,11),1400,facing)
set cjlocgn_00000001=PolY(LoadReal(HH,id,12),1400,facing)
call StopAoeOneTime(caster,cjlocgn_00000000,cjlocgn_00000001,900)
endif

call SaveReal(HH,id,6,cjlocgn_00000002)
endif

if time==5 then
call SetUnitAnimationByIndex(LoadUnitHandle(HH,id,20),2)
call UnitSpeed(LoadUnitHandle(HH,id,20),1.5)
endif

if time<5 then
call MoveAoe1(LoadReal(HH,id,11),LoadReal(HH,id,12),caster,0,facing)
call MoveAoe1(LoadReal(HH,id,11),LoadReal(HH,id,12),LoadUnitHandle(HH,id,20),100,facing)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
endif

if time==5 then
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
endif

if time>=5 and time<5.5 then
call SetUnitFlyHeight(caster,GetUnitFlyHeight(caster)-48,0)
endif

if time==7 or udg_B==false or DU2==false then
call DestroyGroup(LoadGroupHandle(HH,id,4))
call RemoveUnit(LoadUnitHandle(HH,id,20))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif

set t=null
set caster=null
endfunction

function HashiramaChoice_Act takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit caster=GetTriggerUnit()
local real x0=GetUnitX(caster)
local real y0=GetUnitY(caster)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real facing=Angle2(x0,y0,x1,y1)
local boolean self=false
call SaveUnitHandle(HH,id,1,caster)
call SaveInteger(HH,id,5,0)
call SaveInteger(HH,id,6,0)
call SaveReal(HH,id,11,x1)
call SaveReal(HH,id,12,y1)
call SaveReal(HH,id,3,facing)


if GetSpellTargetUnit()!=null then
call SaveUnitHandle(HH,id,2,GetSpellTargetUnit())
endif
if GetSpellTargetUnit()==caster then
set self=true
endif


if GetSpellAbilityId()=='HSQ1' then

if GetHeroLevel(caster)>=35 then
call SaveBoolean(HH,id,45,true)
endif


if LoadBoolean(HH,GetHandleId(caster),StringHash("HashReg"))==false then
call SaveReal(HH,id,15,(1+GetUnitAbilityLevel(caster,'HSQ1'))*GetHeroStr(caster,true))
else
call SaveReal(HH,id,15,GetUnitState(caster,UNIT_STATE_MAX_LIFE)*0.1+(1+GetUnitAbilityLevel(caster,'HSQ1'))*GetHeroStr(caster,true))
endif

if GetSpellTargetUnit()==caster then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\HashiramaQSelf.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call SetUnitInvulnerable(caster,true)
call TimerStart(t,0.02,true,function HashiramaQSelfAct)
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\HashiramaQ.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.02,true,function HashiramaQAct)
endif

endif


if GetSpellAbilityId()=='HSW1' then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\HashiramaW.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call SaveReal(HH,id,15,100+(1+GetUnitAbilityLevel(caster,'HSW1'))*GetHeroStr(caster,true))
call SaveReal(HH,id,31,GetUnitAbilityLevel(caster,'HSW1'))
call TimerStart(t,0.02,true,function HashiramaWAct)
endif

if GetSpellAbilityId()=='HSW2' then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
if GetRandomInt(1,2)==1 then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\HashiramaWG.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\HashiramaWG1.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
call SaveReal(HH,id,15,GetUnitState(caster,UNIT_STATE_MAX_LIFE)*0.05*GetUnitAbilityLevel(caster,'HSW2'))
call TimerStart(t,0.02,true,function HashiramaW2Act)
endif

if GetSpellAbilityId()=='HSE1' then
call SaveReal(HH,id,15,(3+GetUnitAbilityLevel(caster,'HSE1'))*GetHeroStr(caster,true))
call SaveReal(HH,id,31,GetUnitAbilityLevel(caster,'HSE1'))
set soundplay=CreateSound("Sound\\Music\\mp3Music\\HashiramaE.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.02,true,function HashiramaEAct)
endif
if GetSpellAbilityId()=='HSR1' then
call PauseUnit(caster,true)
if self==true then
call SaveInteger(HH,id,14,GetUnitAbilityLevel(caster,'HSR1'))
call SaveReal(HH,id,15,(3+GetUnitAbilityLevel(caster,'HSR1'))*GetHeroStr(caster,true))
set soundplay=CreateSound("Sound\\Music\\mp3Music\\HashiramaRSelf1.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.02,true,function HashiramaRSelfAct)
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\HashiramaR.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call SaveReal(HH,id,15,(3+GetUnitAbilityLevel(caster,'HSR1'))*GetHeroStr(caster,true))
call TimerStart(t,0.02,true,function HashiramaRAct)
endif
endif

if GetSpellAbilityId()=='HSG1' then
call UnitAddAbility(caster,'HSMP')
call SetUnitAbilityLevel(caster,'HSMP',2)
call UnitRemoveAbility(caster,'HSMP')
call UnitCreateAndMove(caster,'hs09',caster,GetRandomReal(0,360),1,2,0.5,100,100,100,20,0,LoadUnitHandle(HH,id,1),0,facing)
call UnitCreateAndMove(caster,'hs23',caster,GetRandomReal(0,360),1,1.5,0.5,100,100,100,20,0,LoadUnitHandle(HH,id,1),0,facing)
call UnitCreateAndMove(caster,'hs18',caster,GetRandomReal(0,360),1,0.6,0.8,100,100,100,0,0,LoadUnitHandle(HH,id,1),0,facing)
call UnitCreateAndMove(caster,'hs05',caster,GetRandomReal(0,360),1,1,1,100,100,100,0,0,LoadUnitHandle(HH,id,1),0,facing)
call UnitCreateAndMove(caster,'hs11',caster,GetRandomReal(0,360),1,2,0.5,100,100,100,50,0,LoadUnitHandle(HH,id,1),0,facing)
call SaveBoolean(HH,GetHandleId(caster),StringHash("HashReg"),true)
set n0=CreateUnit(GetOwningPlayer(caster),'hs31',GetUnitX(caster),GetUnitY(caster),GetUnitFacing(caster))
call UnitSize(n0,1.5,1,1)
call SetUnitAnimationByIndex(n0,3)
call SaveUnitHandle(HH,id,20,n0)
call PauseUnit(caster,true)
call SetUnitAbilityLevel(caster,'HSC1',2)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\HashiramaG.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.02,true,function HashiramaGAct)
endif

if GetSpellAbilityId()=='HSF1' then
call SaveGroupHandle(HH,id,4,CreateGroup())
set soundplay=CreateSound("Sound\\Music\\mp3Music\\HashiramaESelf.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.02,true,function HashiramaFAct)
endif

if GetSpellAbilityId()=='HST1' then
if GetUnitTypeId(caster)=='HHSN' then
call SaveInteger(HH,id,9,(250*R2I(GetHeroStr(caster,true)*0.02)))
set soundplay=CreateSound("Sound\\Music\\mp3Music\\HashiramaT.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'HST1',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'HST3',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'HST2',true)
call UnitRemoveBuffs(caster,false,true)
call TimerStart(t,0.02,true,function HashiramaT1Act)
else
call TimerStart(t,0.02,true,function HashiramaT0Act)
endif
endif


if GetSpellAbilityId()=='HST2' then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call UnitAddAbility(caster,'Amrf')
call UnitRemoveAbility(caster,'Amrf')
call SetUnitAnimationByIndex(caster,4)
call UnitSpeed(caster,1.25)
call SaveReal(HH,id,16,SR(GetUnitX(caster),GetUnitY(caster),LoadReal(HH,id,11),LoadReal(HH,id,12))-100)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\HashiramaT1.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call SaveReal(HH,id,15,GetUnitState(caster,UNIT_STATE_MAX_LIFE)*0.30)
call TimerStart(t,0.02,true,function HashiramaT2Act)
endif

if GetSpellAbilityId()=='HST3' then
call SaveReal(HH,id,11,x0)
call SaveReal(HH,id,12,y0)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call UnitAddAbility(caster,'Amrf')
call UnitRemoveAbility(caster,'Amrf')
call SaveReal(HH,id,15,GetUnitState(caster,UNIT_STATE_MAX_LIFE)*0.45)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\HashiramaTG.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.02,true,function HashiramaT3Act)
endif


set t=null
set caster=null
endfunction
function HashiramaChoice_Cond takes nothing returns boolean
  local boolean cond1=GetSpellAbilityId()=='HSQ1' or GetSpellAbilityId()=='HSW1' or GetSpellAbilityId()=='HSW2' or GetSpellAbilityId()=='HSE1' or GetSpellAbilityId()=='HSR1' or GetSpellAbilityId()=='HST1' or GetSpellAbilityId()=='HST2' or GetSpellAbilityId()=='HST3' or GetSpellAbilityId()=='HSF1' or GetSpellAbilityId()=='HSG1'
        if cond1 then
                return true
        else
                return false
        endif
endfunction
function InitTrig_HashiramaChoice takes nothing returns nothing
        local trigger trig=CreateTrigger()
        local integer index
        set index=0
        loop
        call TriggerRegisterPlayerUnitEvent(trig,Player(index),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
        set index=index+1
        exitwhen index==bj_MAX_PLAYER_SLOTS
        endloop
call TriggerAddCondition(trig,Condition(function HashiramaChoice_Cond))
call TriggerAddAction(trig,function HashiramaChoice_Act)
set trig=null
endfunction


function HashiramaReheneration takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
if LoadBoolean(HH,GetHandleId(caster),StringHash("HashReg"))==true then
call HealTextTag(caster,caster,  GetUnitState(caster,UNIT_STATE_MAX_LIFE)*.008*myCustomHeal2(caster,1),"HealthRes")
call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)+GetUnitState(caster,UNIT_STATE_MAX_LIFE)*.008)
else
call HealTextTag(caster,caster,  GetUnitState(caster,UNIT_STATE_MAX_LIFE)*.003*myCustomHeal2(caster,1),"HealthRes")
call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)+GetUnitState(caster,UNIT_STATE_MAX_LIFE)*.003)
endif
if GetUnitTypeId(caster)!='HHSN' and GetUnitTypeId(caster)!=0x48485347 then
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set t=null
set caster=null
endfunction
function HashiramaLearnE_Cond takes nothing returns boolean
if GetLearnedSkill()=='HSE1' then
return true
else
return false
endif
endfunction
function HashiramaLearnE_Act takes nothing returns nothing
local unit caster=GetTriggerUnit()
local player skillPlayer=GetOwningPlayer(caster)
local timer cjlocgn_00000000
local integer cjlocgn_00000001
if GetUnitAbilityLevel(caster,'HSE1')==1 then
set cjlocgn_00000000=CreateTimer()
set cjlocgn_00000001=GetHandleId(cjlocgn_00000000)
call SaveUnitHandle(HH,cjlocgn_00000001,1,caster)
call TimerStart(cjlocgn_00000000,1,true,function HashiramaReheneration)
endif
set caster=null
set skillPlayer=null
set cjlocgn_00000000=null
endfunction
function InitTrig_HashiramaLearnE takes nothing returns nothing
local trigger trig=CreateTrigger()
//set trig=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(trig,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(trig,Condition(function HashiramaLearnE_Cond))
call TriggerAddAction(trig,function HashiramaLearnE_Act)
set trig=null
endfunction


