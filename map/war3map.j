function ARFHCast takes nothing returns nothing
local integer ip=GetPlayerId(GetTriggerPlayer())
local unit u=Hero[ip]
local item array it
local integer i=0
local player p=GetOwningPlayer(u)
local integer id=GetUnitTypeId(u)
if id=='H05A' then
call SetDoodadZ(CreateDoodadZ('D01R',GetRectCenterX(gg_rct_UBW1),GetRectCenterY(gg_rct_UBW1),2600,90,2.4,1),1600)
set rfhpick=false
set n=CreateUnit(p,'H05B',GetRectCenterX(gg_rct_Rect1),GetRectCenterY(gg_rct_Rect1),0)
call UnitInventorySetSize(n,10)
set rfhpick=true
set Hero[ip]=n
set udg_Hero[ip+1]=n
if GetHeroLevel(u)>1 then
call SetHeroLevel(n,GetHeroLevel(u),false)
endif
