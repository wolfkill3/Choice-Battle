if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,ide)then
if idn=='e13Y' then
call myCustomDamage(u,E,dmg+(GetHeroInt(Lucy[ip],true)*(1+GetUnitAbilityLevel(Lucy[ip],'A1ES'))),false,false,null,null,null)
call SetControlToUnit(E,E, 2, "stun")
else
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SlowUnit(u,E,0.5,0,5,0,false)
endif
call SaveUnitHandle(h,l__idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
else
call SetUnitTimeScale(u,1)
call DestroyGroup(g)
call KillUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
