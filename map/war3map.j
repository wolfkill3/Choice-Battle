function SaberNeroTCast takes nothing returns nothing
local timer t=CreateTimer()
local timer t2=CreateTimer()
local integer id=GetHandleId(t)
local integer id2=GetHandleId(t2)
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real an=Atan2(y1-y,x1-x)*bj_RADTODEG+180
local force f=CreateForce()
local player p=GetOwningPlayer(u)
local player pc=GetOwningPlayer(c)
call PauseUnit(u,true)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
set Theaternero=true
call SetUnitInvulnerable(u,true)
call SetUnitInvulnerable(c,true)
call SetUnitTargetable(u, false)
call SetUnitTargetable(c, false)
call UnitRemoveAbility(u,'A2VJ')
call UnitRemoveAbility(c,'A2VJ')
call ForceAddPlayer(f,p)
if IsUnitIllusion(c)==false then
call ForceAddPlayer(f,pc)
endif
if(IsPlayerInForce(GetLocalPlayer(),f))then
call EnableUserControl(false)
endif
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveUnitHandle(h,id2,0,u)
call SaveUnitHandle(h,id2,1,c)
call SaveForceHandle(h,id2,2,f)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,x1)
call SaveReal(h,id,6,y1)
call SaveReal(h,id,22,GetWidgetLife(c))
call SaveReal(h,id,25,GetUnitState(c,UNIT_STATE_MANA))
call SaveTimerHandle(h,id,23,t2)
call UnitAddAbility(u,'A0QL')
call UnitAddAbility(c,'A0QL')
call UnitAddAbility(u,'A3IH')
call UnitAddAbility(c,'A3IH')
call SetUnitAnimation(u,"Cinematic One")
call SetUnitTimeScale(u,0.8)
if GetUnitTypeId(u)=='H26B' then
set n=CreateUnit(p,'e224',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,GetRandomInt(125,205))
call SetUnitFlyHeight(n,25,0)
call SetUnitTimeScale(n,0.4)
call SetUnitScale(n,1.3,1.3,1.3)
call UnitApplyTimedLife(n,'BTLF',5.5)
else
set n=CreateUnit(p,'e124',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,GetRandomInt(125,205))
call SetUnitFlyHeight(n,25,0)
call SetUnitTimeScale(n,0.4)
call SetUnitScale(n,1.3,1.3,1.3)
call UnitApplyTimedLife(n,'BTLF',5.5)
endif
set n=CreateUnit(p,'e0RV',x,y,an)
call UnitApplyTimedLife(n,'BTLF',6)
call SetUnitTimeScale(n,0.2)
call SetUnitVertexColor(n,255,255,255,200)
call SetUnitScale(n,5,5,5)
if GetUnitTypeId(u)=='H26B' then
set soundplay=SndN(2667) // Sound\Music\mp3Music\NeroBrideT.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
elseif GetUnitTypeId(u)=='H16B' then
set soundplay=SndN(2669) // Sound\Music\mp3Music\NeroSaber1T1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
set soundplay=SndN(2671) // Sound\Music\mp3Music\NeroSaberT1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call TimerStart(t2,13.7,false,function SaberNeroTCast10)
call TimerStart(t,0.5,false,function SaberNeroTCast2)
set c=null
set f=null
set p=null
set pc=null
set u=null
set t=null
set t2=null
endfunction
function InitTrig_SaberNeroT takes nothing returns nothing
set gg_trg_SaberNeroT=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_SaberNeroT,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_SaberNeroT,Condition(function SaberNeroTCond))
call TriggerAddAction(gg_trg_SaberNeroT,function SaberNeroTCast)
endfunction
