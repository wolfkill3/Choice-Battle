function ELiCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local integer idu=GetHandleId(u)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local integer is=0
local real ig=15*bj_DEGTORAD
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,0)
call SaveReal(h,id,4,a)
call SaveReal(h,id,3,a)
call SaveReal(h,id,6,x)
call SaveReal(h,id,7,y)
call SaveGroupHandle(h,id,5,CreateGroup())
call SetUnitInvulnerable(u,true)
call PauseUnit(u,true)
call SetUnitAnimation(u,"spell slam three")
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG-30)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+30)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0RV',x,y,a)
call UnitApplyTimedLife(n,'BTLF',4)
call SetUnitTimeScale(n,0.4)
call SetUnitVertexColor(n,255,255,255,200)
call SetUnitScale(n,5,5,5)
call UnitAddAbility(u,'A1CR')
set x=x+800*Cos(a)
set y=y+800*Sin(a)
set n=CreateUnit(p,'e0ZO',x,y,0)
call SetUnitVertexColor(n,255,255,255,125)
call SetUnitScale(n,2.7,2.7,2.7)
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.3)
loop
exitwhen is>=25
set n=CreateUnit(p,'e0ZH',x+1000*Cos(ig*is),y+1000*Sin(ig*is),180+is*15)
call SetUnitVertexColor(n,255,255,255,105)
call SetUnitScale(n,1.7,1.7,1.7)
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitTimeScale(n,1)
set is=is+1
endloop
call SaveReal(HH,GetHandleId(u),SH_NoSecond,5)
set soundplay=SndN(2675) // Sound\Music\mp3Music\ShuwenAttack4.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.01,true,function ELiCastP2)
set u=null
set p=null
set t=null
endfunction
