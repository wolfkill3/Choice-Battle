set y=GetUnitY(d)
set a=Atan2(y1-y,x1-x)
set x=x+75*Cos(a)
set y=y+75*Sin(a)
set n=CreateUnit(p,'edT1',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.5)
set n=CreateUnit(p,'edT7',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.5)
set n=CreateUnit(p,'edT3',x1,y1,GetRandomReal(0,359))
call SetUnitTimeScale(n,3)
call UnitApplyTimedLife(n,'BTLF',1.2)
call SetUnitScale(n,3+1.2*time,3+1.2*time,3+1.2*time)
set n=CreateUnit(p,'edT4',x1,y1,GetRandomReal(0,359))
call SetUnitTimeScale(n,3)
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,18+8*time,18+8*time,18+8*time)
else
    call PauseUnit(u,false)
    call ShowUnit(u,true)
    if p==GetLocalPlayer()then
    call ClearSelection()
    call SelectUnit(u,true)
    endif
    call SetUnitAnimation(u,"stand")
    set n=CreateUnit(p,'edT6',x,y,GetRandomReal(0,359))
    call UnitApplyTimedLife(n,'BTLF',0.5)
    call SetUnitTimeScale(n,1)
    call GroupClear(g)
    loop
    exitwhen is>39
        if LoadUnitHandle(h,id,is) != null then
        //call RemoveUnit(LoadUnitHandle(h,id,is))
        call RemoveSavedHandle(h,id,is)
        endif
        set is = is + 1
    endloop
    if GetUnitAbilityLevel(u, 'CB01') > 0 then
        call UnitRemoveAbility(u, 'CE01')
        call UnitRemoveAbility(u, 'CB01')
    endif
    call SetUnitInvulnerable(u,false)
    call SetUnitX(u,x2)
    call SetUnitY(u,y2)
    call UnitRemoveAbility(u,'Ao93')
    call UnitRemoveAbility(u,'Ao94')
    call SetUnitVertexColor(u,255,255,255,255)
    call SetUnitTurnSpeed(u,3)
set x=LoadReal(h,id,6)
set y=LoadReal(h,id,7)
set g2=CopyGroup(g)
loop
set E=FirstOfGroup(g2)
exitwhen E==null
if IsUnitType(E, UNIT_TYPE_HERO) == false then
set n=CreateUnit(p,'edT5',GetUnitX(E),GetUnitY(E),a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.5)
call SetUnitTimeScale(n,1)
call SetUnitFlyHeight(n,GetUnitFlyHeight(E),0)
call SetUnitVertexColor(E,155,75,255,0)
call SetUnitX(E,x)
call SetUnitY(E,y)
call SetUnitFlyHeight(E,0,0)
call GroupRemoveUnit(g2,E)
endif
endloop
call DestroyGroupTimed(g2,3)
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
//call TimerStart(t,0.1,false,function TDantesCast8)
endif
set p=null
set g=null
set g2=null
set u=null
set t=null
endfunction
