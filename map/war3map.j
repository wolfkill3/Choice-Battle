call SaveEffectHandle(HH,id,22,AddSpecialEffectTarget(("Others\\CloudEfBlue.mdl"),caster,"origin"))
call EffectCreateAndMove(true,"Others\\HakkeStart2.mdl",facing,1.5,1,1.5,100,100,100,80,0,caster,0,facing)
