function KireiRCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real sc=0
set soundplay=SndN(3056) // Sound\war3mapImported\Kirei_R.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SetUnitInvulnerable(u,true)
call PauseUnit(u,true)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveReal(h,id,2,1.2)
call SaveReal(h,id,3,0.3)
call SaveReal(h,id,4,x)
call SaveReal(h,id,5,y)
call SaveReal(h,id,6,3.55)
set n=CreateUnit(p,'eo89',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,0.2)
call SetUnitTimeScale(u,1)
set n=CreateUnit(p,'ed0O',x,y,0)
call SetUnitVertexColor(n,255,255,255,125)
call SetUnitScale(n,2.7,2.7,2.7)
call UnitApplyTimedLife(n,'BTLF',5)
call SetUnitTimeScale(n,0.2)
call SetUnitAnimation(u,"Spell Slam Two")
call TimerStart(t,0.05,true,function KireiRCast2)
set t=null
set c=null
set p=null
set u=null
endfunction
function InitTrig_KireiR takes nothing returns nothing
set gg_trg_KireiR=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_KireiR,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_KireiR,Condition(function KireiRCond))
call TriggerAddAction(gg_trg_KireiR,function KireiRCast)
endfunction
function PassiveKazumaCond takes nothing returns boolean
return (GetLearnedSkill()=='Ao8W' or GetLearnedSkill()=='Ao7T' or GetLearnedSkill()=='Ao7W') and IsUnitIllusion(GetTriggerUnit())==false
endfunction
function PassiveKazumaCastAqua takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit d1=LoadUnitHandle(HH,id,1)
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(p)
local integer idu=GetHandleId(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real r
local real a=GetUnitFacing(u)*bj_DEGTORAD
local real x1
local real X1=0
local real Y1=0
local real y1
local real x2=0
local real y2=0
if u!=null then
    if GetWidgetLife(u)>0 then
        call SetUnitFlyHeight(d1,0,0)
    else
        call SetUnitFlyHeight(d1,9000,0)
    endif
    set X1=GetUnitX(d1)
    set Y1=GetUnitY(d1)
    set x1=X1
    set y1=Y1
    set x2=x+150*Cos(a+deg90)
    set y2=y+150*Sin(a+deg90)
    if GetUnitAbilityLevel(d1,'Ao7U')==0 then
        if GetUnitCurrentOrder(d1)==0 then
            call SetUnitFacing(d1,a*bj_RADTODEG)
        endif
        if SR(x,y,x1,y1)<800 then
            if SR(x2,y2,x1,y1)>170 and GetUnitCurrentOrder(d1)==0 and not(x2-30<X1 and X1<x2+30)and not(y2-30<Y1 and Y1<y2+30)then
                call IssuePointOrder(d1,"move",x2,y2)
            endif
        elseif GetUnitCurrentOrder(d1)!=OrderId("move")and SR(x,y,x1,y1)>800 then
            call SetUnitX(d1,x2)
            call SetUnitY(d1,y2)
            call IssueImmediateOrder(d1,"stop")
        endif
    endif
    if CheckUnitInvisible(u) then
        if GetUnitAbilityLevel(d1,'Ao7U')==0 then
            call UnitAddAbility(d1,'Ao7S')
        endif
    else
        call UnitRemoveAbility(d1,'Ao7S')
    endif
else
    call KillUnit(d1)
    call RemoveSavedHandle(HH,idu,SH_aqua)
    call DestroyTimer(t)
    call FlushChildHashtable(HH,id)
endif
set d1=null
set p=null
set u=null
set t=null
endfunction
function PassiveKazumaCastDarkness takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit d2=LoadUnitHandle(HH,id,2)
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(p)
local integer idu=GetHandleId(u)
local integer idn=GetHandleId(d2)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real r
local real a=GetUnitFacing(u)*bj_DEGTORAD
local real x1
local real X1=0
local real Y1=0
local real y1
local real x2=0
local real y2=0
local real x3=GetUnitX(DarknessTarget[ip])
local real y3=GetUnitY(DarknessTarget[ip])
local real a2
local real revivetime=LoadReal(HH,idn,SH_revivetime)
if u!=null then
    if GetWidgetLife(u)>0 then
        call SetUnitFlyHeight(d2,0,0)
    else
        set DarknessTarget[ip]=u
        call SetUnitFlyHeight(d2,9000,0)
    endif
    set X1=GetUnitX(d2)
    set Y1=GetUnitY(d2)
    set x1=X1
    set y1=Y1
    set x2=x3-150*Cos(a+deg90)
    set y2=y3-150*Sin(a+deg90)
    call SaveReal(HH,idn,SH_darkMaxHP,GetWidgetMaxLife(u)*(0.35+0.05*GetUnitAbilityLevel(u,'Ao8W')))
    call SaveReal(HH,idn,SH_darkHPRegen,0.75+0.25*GetUnitAbilityLevel(u,'Ao8W'))
    if DU2==false then
    call SaveReal(HH,idn,SH_darkHP,LoadReal(HH,idn,SH_darkMaxHP))
    endif
    if GetUnitAbilityLevel(d2,'Ao8U')==0 then
        if LoadReal(HH,idn,SH_darkHP)< LoadReal(HH,idn,SH_darkMaxHP) then
            call SaveReal(HH,idn,SH_darkHP,LoadReal(HH,idn,SH_darkHP)+LoadReal(HH,idn,SH_darkHPRegen))
        else
            call SaveReal(HH,idn,SH_darkHP,LoadReal(HH,idn,SH_darkMaxHP))
        endif
        if GetUnitAbilityLevel(d2,'Ao9U')>0 then
            if SR(x,y,x1,y1)>350 then
                set a2=Atan2(y-y1,x-x1)
                call SetUnitX(d2,x1+90*Cos(a2))
                call SetUnitY(d2,y1+90*Sin(a2))
                call IssueImmediateOrder(d2,"stop")
                call SetUnitAnimation(d2,"walk")
                call SetUnitFacingInstant(d2,a2*bj_RADTODEG)
                set n=CreateUnit(p,'kaR2',x1,y1,a*bj_RADTODEG)
                call UnitApplyTimedLife(n,'BTLF',0.2)
                call SetUnitVertexColor(n,255,255,255,75)
                call SetUnitTimeScale(n,0.05)
                call SetUnitAnimation(n,"walk")
            else
                call UnitRemoveAbility(d2,'Ao9U')
                call UnitRemoveAbility(d2,'Ao7U')
                set DarknessTarget[ip]=u
            endif
        endif
        if IsUnitSelected(u,GetLocalPlayer()) and IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(u)) then
            call SetFrameText(GetFrameByName("CustomLeaderboardText",0),"|c00FABF45Darkness HP|r: "+R2SW(LoadReal(HH,idn,SH_darkHP),0,1)+"/"+R2SW(LoadReal(HH,idn,SH_darkMaxHP),0,1))
            call ShowFrame(GetFrameByName("CustomLeaderboard",0), true)
            call SetFrameSize( GetFrameByName("CustomLeaderboard",0), .1775, GetFrameHeight( GetFrameByName("CustomLeaderboardText",0))+0.016)
            call SetFrameTextAlignment( GetFrameByName("CustomLeaderboardText",0), TEXT_JUSTIFY_LEFT, TEXT_JUSTIFY_LEFT )
        endif
        if GetUnitAbilityLevel(d2,'Ao7U')==0 then
            if GetUnitCurrentOrder(d2)==0 then
                call SetUnitFacing(d2,a*bj_RADTODEG)
            endif
            if SR(x3,y3,x1,y1)<800 then
                if SR(x2,y2,x1,y1)>170 and GetUnitCurrentOrder(d2)==0 and not(x2-30<X1 and X1<x2+30)and not(y2-30<Y1 and Y1<y2+30)then
                    call IssuePointOrder(d2,"move",x2,y2)
                endif
            elseif GetUnitCurrentOrder(d2)!=OrderId("move")and SR(x,y,x1,y1)>800 then
                call SetUnitX(d2,x2)
                call SetUnitY(d2,y2)
                call IssueImmediateOrder(d2,"stop")
            endif
            if DarknessTarget[ip]!=u then
                if (SR(x3,y3,x,y)>3000 or GetWidgetLife(DarknessTarget[ip])<0.465) and GetUnitAbilityLevel(d2,'Ao9U')==0 then
                    call UnitAddAbility(d2,'Ao7U')
                    call UnitAddAbility(d2,'Ao9U')
                    set DarknessTarget[ip]=null
                    set soundplay=SndN(3058) // Sound\Music\mp3Music\KazumaR2.mp3
                    call StartSound(soundplay)
                    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                endif
            endif
        endif
        if CheckUnitInvisible(u) then
            if GetUnitAbilityLevel(d2,'Ao7U')==0 then
                call UnitAddAbility(d2,'Ao7S')
            endif
        else
            call UnitRemoveAbility(d2,'Ao7S')
        endif
    else
        call SaveReal(HH,idn,SH_revivetime,revivetime+0.05)
        if IsUnitSelected(u,GetLocalPlayer()) and IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(u)) then
            call SetFrameText(GetFrameByName("CustomLeaderboardText",0),"|c00FD3402Darkness revives in:    "+R2SW(35-revivetime,1,1)+"|r")
            call ShowFrame(GetFrameByName("CustomLeaderboard",0), true)
            call SetFrameSize( GetFrameByName("CustomLeaderboard",0), .1775, GetFrameHeight( GetFrameByName("CustomLeaderboardText",0))+0.016)
            call SetFrameTextAlignment( GetFrameByName("CustomLeaderboardText",0), TEXT_JUSTIFY_LEFT, TEXT_JUSTIFY_LEFT )
        endif
        if revivetime>=35 or udg_B==false or DU2==false then
            call SaveReal(HH,idn,SH_darkHP,LoadReal(HH,idn,SH_darkMaxHP))
            call UnitRemoveAbility(d2,'Ao8U')
            call SetUnitAnimation(d2,"stand")
            set DarknessTarget[ip]=u
        endif
    endif
else
    call KillUnit(d2)
    call RemoveSavedHandle(HH,idu,SH_dark)
    if IsUnitSelected(u,GetLocalPlayer()) and IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(u)) then
        call SetFrameText(GetFrameByName("CustomLeaderboardText",0)," ")
        call ShowFrame(GetFrameByName("CustomLeaderboard",0),false)
    endif
    call DestroyTimer(t)
    call FlushChildHashtable(HH,id)
endif
set d2=null
set p=null
set u=null
set t=null
endfunction
function PassiveKazumaCastMegumin takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit d3=LoadUnitHandle(HH,id,3)
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(p)
local integer idu=GetHandleId(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real r
local real a=GetUnitFacing(u)*bj_DEGTORAD
local real x1
local real X1=0
local real Y1=0
local real y1
local real x2=0
local real y2=0
if u!=null then
    if GetWidgetLife(u)>0 then
        call SetUnitFlyHeight(d3,0,0)
    else
        call SetUnitFlyHeight(d3,9000,0)
    endif
    set X1=GetUnitX(d3)
    set Y1=GetUnitY(d3)
    set x1=X1
    set y1=Y1
    set x2=x+300*Cos(a+deg90)
    set y2=y+300*Sin(a+deg90)
    if GetUnitAbilityLevel(d3,'Ao7U')==0 then
        if GetUnitCurrentOrder(d3)==0 then
            call SetUnitFacing(d3,a*bj_RADTODEG)
        endif
        if SR(x,y,x1,y1)<800 then
            if SR(x2,y2,x1,y1)>320 and GetUnitCurrentOrder(d3)==0 and not(x2-30<X1 and X1<x2+30)and not(y2-30<Y1 and Y1<y2+30)then
                call IssuePointOrder(d3,"move",x2,y2)
            endif
        elseif GetUnitCurrentOrder(d3)!=OrderId("move")and SR(x,y,x1,y1)>800 then
            call SetUnitX(d3,x2)
            call SetUnitY(d3,y2)
            call IssueImmediateOrder(d3,"stop")
        endif
    endif
    if CheckUnitInvisible(u) then
        if GetUnitAbilityLevel(d3,'Ao7U')==0 then
            call UnitAddAbility(d3,'Ao7S')
        endif
    else
        call UnitRemoveAbility(d3,'Ao7S')
    endif
else
    call KillUnit(d3)
    call RemoveSavedHandle(HH,idu,SH_megu)
    call DestroyTimer(t)
    call FlushChildHashtable(HH,id)
endif
set d3=null
set p=null
set u=null
set t=null
endfunction
function PassiveKazumaCast takes nothing returns nothing
local timer t
local integer id
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real a=GetUnitFacing(u)*bj_DEGTORAD
local real a2=a+deg90
local integer idu=GetHandleId(u)
local integer idn
if LoadUnitHandle(HH,idu,SH_aqua)==null and GetLearnedSkill()=='Ao7T' then
set t=CreateTimer()
set id=GetHandleId(t)
call SaveUnitHandle(HH,id,0,u)
set n=CreateUnit(p,'kaW1',x+150*Cos(a2),y+150*Sin(a2),a*bj_RADTODEG)
call SaveUnitHandle(HH,id,1,n)
call SaveUnitHandle(HH,idu,SH_aqua,n)
call TimerStart(t,0.05,true,function PassiveKazumaCastAqua)
endif
if LoadUnitHandle(HH,idu,SH_dark)==null and GetLearnedSkill()=='Ao8W' then
set t=CreateTimer()
set id=GetHandleId(t)
call SaveUnitHandle(HH,id,0,u)
set n=CreateUnit(p,'kaR1',x-150*Cos(a2),y-150*Sin(a2),a*bj_RADTODEG)
call SaveUnitHandle(HH,id,2,n)
call SaveUnitHandle(HH,idu,SH_dark,n)
set Darkness[GetPlayerId(p)]=n
set idn=GetHandleId(n)
call SaveReal(HH,idn,SH_darkMaxHP,GetWidgetMaxLife(u)*(0.25+0.05*GetUnitAbilityLevel(u,'Ao8W')))
call SaveReal(HH,idn,SH_darkHPRegen,0.25*GetUnitAbilityLevel(u,'Ao8W'))
call SaveReal(HH,idn,SH_darkHP,LoadReal(HH,idn,SH_darkMaxHP))
call SaveReal(HH,idn,SH_revivetime,35)
set DarknessTarget[GetPlayerId(p)]=u
call TimerStart(t,0.05,true,function PassiveKazumaCastDarkness)
endif
if LoadUnitHandle(HH,idu,SH_megu)==null and GetLearnedSkill()=='Ao7W' then
set t=CreateTimer()
set id=GetHandleId(t)
call SaveUnitHandle(HH,id,0,u)
set n=CreateUnit(p,'kaT1',x+300*Cos(a2),y+300*Sin(a2),a*bj_RADTODEG)
call SaveUnitHandle(HH,id,3,n)
call SaveUnitHandle(HH,idu,SH_megu,n)
call TimerStart(t,0.05,true,function PassiveKazumaCastMegumin)
endif
set u=null
set p=null
set t=null
endfunction
function InitTrig_PassiveKazuma takes nothing returns nothing
set gg_trg_PassiveKazuma=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_PassiveKazuma,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(gg_trg_PassiveKazuma,Condition(function PassiveKazumaCond))
call TriggerAddAction(gg_trg_PassiveKazuma,function PassiveKazumaCast)
endfunction
function GKazumaCond takes nothing returns boolean
return GetSpellAbilityId()=='Ao8N'
endfunction
function GKazumaCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real time=LoadReal(h,id,2)-0.05
local player p=GetOwningPlayer(u)
if time>0 then
if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
call SaveReal(h,id,2,time)
endif
else
//call UnitRemoveAbility(u,'Ao7O')
call UnitRemoveAbility(u,'Ao8S')
call StartAbilityCooldown(GetUnitAbility(u,'Ao8N'),25)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set t=null
endfunction
function GKazumaCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,7)
//call UnitAddAbility(u,'Ao7O')
call UnitAddAbility(u,'Ao8S')
call CreateModeIndicatorWithPauseFormDispellable(u, "ReplaceableTextures\\CommandButtons\\BTNKazumaG.blp", 7,'Ao8S')
call TimerStart(t,0.05,true,function GKazumaCast2)
set u=null
set t=null
endfunction
function InitTrig_GKazuma takes nothing returns nothing
