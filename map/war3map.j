function MadaraFRinneganAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit bone
local unit caster=LoadUnitHandle(HH,id,1)
set bone=LoadUnitHandle(HH,GetHandleId(caster),StringHash("MadaraBone"))
call SetUnitFacingInstant(LoadUnitHandle(HH,id,2),GetUnitFacing(caster))
call SetUnitFlyHeight(LoadUnitHandle(HH,id,2),GetUnitFlyHeight(caster),0)
if CheckUnitInvisible(caster) then
    call UnitAddAbility(LoadUnitHandle(HH,id,2),'Ao7S')
else
    call UnitRemoveAbility(LoadUnitHandle(HH,id,2),'Ao7S')
endif

if UnitIsAlive(caster)==true then
call MoveUnit(caster,LoadUnitHandle(HH,id,2),0,GetUnitFacing(caster))
call SetUnitVertexColor(LoadUnitHandle(HH,id,2), 255, 255, 255, 255)
else
call SetUnitVertexColor(LoadUnitHandle(HH,id,2), 0, 0, 0, 0)
call MoveAoe1(GetRectCenterX(gg_rct_Rect1),GetRectCenterY(gg_rct_Rect1),LoadUnitHandle(HH,id,2),0,GetUnitFacing(caster))
endif

if bone!=null or LoadUnitHandle(HH,id,1)==null then
call RemoveUnit(LoadUnitHandle(HH,id,2))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set t=null
set caster=null
set bone=null
endfunction
function MadaraFBoneAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit bone=LoadUnitHandle(HH,id,20)
local unit caster=LoadUnitHandle(HH,id,1)
call SetUnitFacingInstant(bone,GetUnitFacing(caster))
if CheckUnitInvisible(caster) then
    call UnitAddAbility(LoadUnitHandle(HH,id,20),'Ao7S')
    call UnitAddAbility(LoadUnitHandle(HH,id,2),'Ao7S')
else
    call UnitRemoveAbility(LoadUnitHandle(HH,id,20),'Ao7S')
    call UnitRemoveAbility(LoadUnitHandle(HH,id,2),'Ao7S')
endif
if LoadUnitHandle(HH,GetHandleId(caster),StringHash("MadaraSusano"))==null and LoadBoolean(HH,GetHandleId(caster),StringHash("MadaraSusT2"))==false then
call SetUnitFlyHeight(bone,GetUnitFlyHeight(caster),0)
call UnitColor(bone,100,100,100,0)
else
call SetUnitFlyHeight(bone,6000,0)
call UnitColor(bone,100,100,100,100)
endif


call SetUnitFacingInstant(LoadUnitHandle(HH,id,2),GetUnitFacing(caster))
call SetUnitFlyHeight(LoadUnitHandle(HH,id,2),GetUnitFlyHeight(caster),0)


if UnitIsAlive(caster)==true then
call MoveUnit(caster,bone,0,GetUnitFacing(caster))
call MoveUnit(caster,LoadUnitHandle(HH,id,2),0,GetUnitFacing(caster))
call SetUnitVertexColor(bone, 255, 255, 255, 255)
call SetUnitVertexColor(LoadUnitHandle(HH,id,2), 255, 255, 255, 255)
else
call SetUnitVertexColor(bone, 0, 0, 0, 0)
call SetUnitVertexColor(LoadUnitHandle(HH,id,2), 0, 0, 0, 0)
call MoveAoe1(GetRectCenterX(gg_rct_Rect1),GetRectCenterY(gg_rct_Rect1),bone,0,GetUnitFacing(caster))
call MoveAoe1(GetRectCenterX(gg_rct_Rect1),GetRectCenterY(gg_rct_Rect1),LoadUnitHandle(HH,id,2),0,GetUnitFacing(caster))
endif



if bone==null or LoadUnitHandle(HH,id,1)==null then

if LoadUnitHandle(HH,id,1)==null then
call RemoveUnit(LoadUnitHandle(HH,id,20))
endif
call RemoveUnit(LoadUnitHandle(HH,id,2))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set caster=null
set bone=null
set t=null
endfunction


