function KrolCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
set n=CreateUnit(GetOwningPlayer(u),'e0ZV',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,0,80)
call SetUnitInvulnerableTimed(n,false,40)
call UnitAddAbility(n,'A0QL')
call UnitMakeAbilityPermanent(n,true,'A0QL')
call UnitAddAbility(n,0x41314944)
call UnitMakeAbilityPermanent(n,true,0x41314944)
call SetUnitInvulnerable(n,true)
call UnitAddAbility(n,'Avul')
call ShowUnit(n,false)
call UnitAddAbility(n,'Aloc')
call SetUnitMoveSpeed(n,0)
call SetUnitTurnSpeed(n,0)
call UnitRemoveAbility(n,'Aloc')
call ShowUnit(n,true)
call SetUnitTurnSpeed(n,0)
call SetUnitTimeScale(n,0)
set u=null
endfunction
