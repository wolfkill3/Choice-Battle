call SaveUnitHandle(h,id,0,u)
call SaveReal(h,GetHandleId(u),StringHash("BroEtime"),0)
call UnitAddAbility(u,'A2DF')
call UnitMakeAbilityPermanent(u,true,'A2DF')
call SaveReal(h,GetHandleId(u),StringHash("shie1"),pr)
call SaveReal(h,GetHandleId(u),StringHash("shie2"),pr)
call ShowAbility2('A2DJ',false)
call ShowAbility2Timed('A3DJ',true,0.2)
call SetUnitAbilityLevel(u,'A3DJ',GetUnitAbilityLevel(u,'A2DJ'))
call TimerStart(t,0.125,true,function BrolyE1Cast2)
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\BrolyShield.mp3",false,false,true,12700,12700,"")
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Broly\\BrolyShield-jap.mp3",false,false,true,12700,12700,"")
endif
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
set u=null
set t=null
endfunction
