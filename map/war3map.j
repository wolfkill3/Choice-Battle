//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,1,false,function SabakuRoCast2)

call SaveInteger(HH,GetHandleId( u ),SH_GaaraGtype,2)
call SaveReal(HH,GetHandleId( u ),SH_GaaraGWX, GetSpellTargetX() )
call SaveReal(HH,GetHandleId( u ),SH_GaaraGWY, GetSpellTargetY() )


set u=null
set p=null
set t=null
endfunction
