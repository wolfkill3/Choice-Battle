function WhiteBallCond takes nothing returns boolean
return GetSpellAbilityId()=='A0T0' and udg_B==true
endfunction
function WhiteBallCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x2=LoadReal(h,id,2)
local real y2=LoadReal(h,id,3)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real a=Atan2(y2-y1,x2-x1)
local real a2
local player p=GetOwningPlayer(u)
local real dmg=GetUnitState(u,UNIT_STATE_MAX_LIFE)*(0.05+0.03*GetUnitAbilityLevel(u,'A0T0'))+75
if SR(x1,y1,x2,y2)>66.00 then
set x1=x1+50*Cos(a+0.35)
set y1=y1+50*Sin(a+0.35)
call SetUnitXY_1(l__d,x1,y1, false)
else
set n=CreateUnit(p,'e0R1',x1,y1,0)
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitTimeScale(n,0.2)
call SetUnitScale(n,1.5,1.5,1.5)
set n=CreateUnit(p,'e0R1',x1,y1,0)
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitTimeScale(n,0.2)
call SetUnitScale(n,1.55,1.55,1.55)
set n=CreateUnit(p,'e0R1',x1,y1,0)
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitTimeScale(n,0.2)
call SetUnitScale(n,1.4,1.4,1.4)
set n=CreateUnit(p,'e0R2',x1,y1,0)
call UnitApplyTimedLife(n,'BTLF',6)
call SetUnitTimeScale(n,0.4)
set n=CreateUnit(p,'e0R0',x1,y1,0)
call UnitApplyTimedLife(n,'BTLF',6)
call SetUnitTimeScale(n,0.25)
set n=CreateUnit(p,'e0R0',x1,y1,0)
call UnitApplyTimedLife(n,'BTLF',6)
call SetUnitTimeScale(n,0.25)
call GroupEnumUnitsInRange(DG,x1,y1,400,Base)
loop
set E=FirstOfGroup(DG)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SlowUnit(u,E,0.85,0.85,1,2,false)
endif
call GroupRemoveUnit(DG,E)
endloop
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call KillUnit(l__d)
endif
set l__d=null
set p=null
set u=null
set t=null
endfunction
function WhiteBallCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,x1)
call SaveReal(h,id,3,y1)
call SaveUnitHandle(h,id,1,CreateUnit(p,'e0QZ',x,y,a*bj_RADTODEG))
set soundplay=SndN(2021) // Sound\Music\mp3Music\YujiFireball.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.03,true,function WhiteBallCast2)
set u=null
set p=null
set t=null
endfunction
function RenDown takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real time=LoadReal(h,GetHandleId(u),SH_SSR)
call SaveReal(h,GetHandleId(u),SH_SSR,time-0.1)
if time<=0 then
call SaveBoolean(HH,GetHandleId(u),SS,false)
call SaveReal(h,GetHandleId(u),SH_SSR,15)
call SetUnitAbilityLevel(u,'A101',1)
call UnitRemoveAbility(u,'A102')
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set t=null
set u=null
endfunction
function RenUpCond takes nothing returns boolean
return GetSpellAbilityId()=='A100' and udg_B
endfunction
function RenUpCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local timer tt=CreateTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real time=LoadReal(h,id,1)
local integer lvl=GetUnitAbilityLevel(u,'A101')
if GetUnitCurrentOrder(u)==OrderId("dispel")then
call SaveReal(h,id,1,time+0.025)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitVertexColor(n,255,230,100,50)
call SetUnitScale(n,.45+.1*lvl,.45+.1*lvl,.45+.1*lvl)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitVertexColor(n,255,230,100,50)
call SetUnitScale(n,.15+.1*lvl,.15+.1*lvl,.15+.1*lvl)
set n=CreateUnit(p,'e0RE',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitVertexColor(n,255,230,100,50)
else
call RemoveUnit(LoadUnitHandle(h,id,10))
call RemoveUnit(LoadUnitHandle(h,id,11))
call RemoveUnit(LoadUnitHandle(h,id,12))
call SetUnitTimeScale(u,1)
if time>2.45 and GetUnitAbilityLevel(u,'A100')>lvl-1 then
if lvl<6 then
call SaveReal(h,GetHandleId(u),SH_SSR,35)
call SetUnitAbilityLevel(u,'A101',lvl+1)
call UnitAddAbility(u,'A102')
call UnitMakeAbilityPermanent(u,true,'A102')
set soundplay=SndN(2023) // Sound\Music\mp3Music\Ren.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
if LoadBoolean(HH,GetHandleId(u),SS)==false then
call SaveUnitHandle(h,GetHandleId(tt),0,u)
call SaveBoolean(HH,GetHandleId(u),SS,true)
call TimerStart(tt,0.1,true,function RenDown)
endif
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set tt=null
set u=null
set t=null
endfunction
function RenUpCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,0)
call SaveUnitHandle(h,id,10,CreateUnit(p,'e0LL',x,y,0))
call SaveUnitHandle(h,id,11,CreateUnit(p,'e0LK',x,y,0))
call SaveUnitHandle(h,id,12,CreateUnit(p,'e0LM',x,y,0))
call SetUnitTimeScale(u,0.5)
call TimerStart(t,0.025,true,function RenUpCast2)
set u=null
set p=null
set t=null
endfunction
