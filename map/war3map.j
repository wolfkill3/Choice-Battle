endfunction
function LineCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real dmg=GetHeroAgi(u,true)*5
local real x1=LoadReal(h,id,1)
local real y1=LoadReal(h,id,2)
local real a=Atan2(y1-y,x1-x)
local real dist=LoadReal(h,id,3)
local real sr=SR(x,y,x1,y1)
local player p=GetOwningPlayer(u)
local group g=null // группа не используется; раньше создавалась каждый тик и не удалялась (утечка)
if dist<LoadReal(h,id,6)then
set x=x+100*Cos(a)
set y=y+100*Sin(a)
call SaveReal(h,id,3,dist+100)
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitXY_1(u,x,y, false)
set n=CreateUnit(p,'e0ZY',x,y,a*bj_RADTODEG)
call UnitAddAbility(n,'A0QL')
call SetUnitInvulnerable(n,true)
call UnitAddAbility(n,'Avul')
call ShowUnit(n,false)
call UnitAddAbility(n,'Aloc')
call UnitRemoveAbility(n,'Aloc')
call ShowUnit(n,true)
call PauseUnit(n,true)
call IssueImmediateOrder(n,"stop")
call PauseUnit(n,false)
call SetUnitTurnSpeed(n,0)
call SetUnitMoveSpeed(n,0)
call UnitApplyTimedLife(n,'BTLF',80)
call SetUnitInvulnerableTimed(n,false,40)
call GroupClear(G)
call GroupEnumUnitsInRange(G,x,y,100,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call SetControlToUnit(E,E, 0.5, "silence")
endif
call GroupRemoveUnit(G,E)
endloop
else
call GroupClear(G)
call PauseTimer(t)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set p=null
set t=null
    set g=null
endfunction
function LineCast takes nothing returns nothing
