call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodySplat Missile.mdx",c,"left hand"))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodySplat Missile.mdx",c,"origin"))
