call TriggerRegisterAnyUnitEventBJ(gg_trg_RKingHassan,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_RKingHassan,Condition(function RKingHassanCond))
call TriggerAddAction(gg_trg_RKingHassan,function RKingHassanCast)
endfunction
function TKingHassanCond takes nothing returns boolean
return GetSpellAbilityId()=='A1GU' and udg_B
endfunction
function TKingHassanCast7 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit l__d=LoadUnitHandle(h,id,6)
local real dmg=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real x2=0
local real y2=0
local real a=Atan2(y1-y,x1-x)
local integer i=0
local real sr=SR(x,y,x1,y1)/2
call KillUnit(l__d)
call SetUnitInvulnerable(c,false)
call SetUnitInvulnerable(u,false)
call SetUnitTimeScale(u,1)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call PauseUnit(u,false)
if dmg<GetUnitState(c,UNIT_STATE_LIFE) then
call myCustomDamage(u,c,dmg,false,false,null,null,null)
else
call SetUnitState(c,UNIT_STATE_LIFE,5)
call myCustomDamage(u,c,dmg,false,false,null,DAMAGE_TYPE_UNIVERSAL,null)
endif
call StartAbilityCooldown(GetUnitAbility(u, 'A1GU'), 30)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set l__d=null
set p=null
set c=null
set u=null
set t=null
endfunction
