call GroupClear(G)
call GroupEnumUnitsInRange(G,x0,y0,range,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if  Condition_Base(GetOwningPlayer(damager),n0) and GetUnitAbilityLevel(n0,'B05G') == 0  then
call UnitStop(n0)
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
set damager=null        
