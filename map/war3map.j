function DarkRayCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=LoadReal(h,id,1)
local real y=LoadReal(h,id,2)
local real a=Atan2(LoadReal(h,id,4)-y,LoadReal(h,id,3)-x)
local real l__d=LoadReal(h,id,5)
local group g=LoadGroupHandle(h,id,6)
local player p=GetOwningPlayer(u)
local real dmg=75*GetUnitAbilityLevel(u,'A0BE')+(GetUnitAbilityLevel(u,'A0BE')+1)*GetHeroInt(u,true)
if l__d<2000 then
set x=x+l__d*Cos(a)
set y=y+l__d*Sin(a)
call SetUnitXY(LoadUnitHandle(h, id, 10), x-200*Cos(a), y-200*Sin(a))
set n=CreateUnit(p,'e05T',x,y,(a*bj_RADTODEG))
call UnitApplyTimedLife(n,1,1)
call SaveReal(h,id,5,l__d+50)
call UnitApplyTimedLife(CreateUnit(p,0x65303553,x,y,(a*bj_RADTODEG)),1,1)
call GroupEnumUnitsInRange(g,x,y,150,Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set ide=GetHandleId(E)
if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
call SetControlToUnit(E,E, 2, "stun")
endif
call GroupRemoveUnit(g,E)
endloop
else
call UnitApplyTimedLife(LoadUnitHandle(h, id, 10), 1, 0.1)
call MyRemoveUnit(LoadUnitHandle(h, id, 10), 2.5)
set idg=GetHandleId(g)
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,idg)
endif
set p=null
set u=null
set g=null
set t=null
endfunction
