function ERinMissles2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real f=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real a=LoadReal(h,id,5)
local real dist=LoadReal(h,id,7)
local group g=LoadGroupHandle(h,id,10)
local player p=GetOwningPlayer(l__d)
local real mod=3-2*(dist/LoadReal(h,id,10))
local real dmg=LoadReal(h,id,9)*mod
local integer idp=GetPlayerId(p)
local integer l__ide=0
local integer l__idg=GetHandleId(g)
if dist>speed and l__d!=null then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SaveReal(h,id,7,dist-speed)
call GroupEnumUnitsInRange(g,x,y,60,Base)
loop
set E=FirstOfGroup(g)
set l__ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,l__ide)then
call SaveUnitHandle(h,l__idg,l__ide,E)
call myCustomDamage(Hero[idp],E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 0.05, "stun")
call SetControlToUnit(E,E, 0.05, "SilenceTE")
call UnitApplyTimedLife(l__d,'BTLF',LoadReal(h,id,8))
endif
call GroupRemoveUnit(g,E)
endloop
else
call UnitApplyTimedLife(l__d,'BTLF',LoadReal(h,id,8))
call PauseTimer(t)
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set p=null
set g=null
set t=null
endfunction
function ERinMissles takes unit l__d,real speed,real a,real dist,real time,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,GetUnitFlyHeight(l__d))
call SaveReal(h,id,3,GetUnitX(l__d))
call SaveReal(h,id,4,GetUnitY(l__d))
call SaveReal(h,id,5,a)
call SaveReal(h,id,7,dist)
call SaveReal(h,id,10,dist)
call SaveReal(h,id,8,time)
call SaveReal(h,id,9,dmg)
call SaveGroupHandle(h,id,10,CreateGroup())
call TimerStart(t,0.014,true,function ERinMissles2)
set t=null
endfunction
function ERinStomOrders2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
call IssueImmediateOrder(u,"stop")
call SetUnitFacing(u,Atan2(LoadReal(h,id,1)-GetUnitY(u),LoadReal(h,id,2)-GetUnitX(u))*bj_RADTODEG)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
set t=null
set u=null
endfunction
function ERinStomOrders takes nothing returns nothing
