call UnitRemoveAbility(u,'A1AY')
endif
set l__d=null
set u=null
set p=null
set t=null
endfunction
function FireBoltCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local integer i=GetRandomInt(1,2)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local integer is=0
local player p=GetOwningPlayer(u)
local real ig=30*bj_DEGTORAD
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,GetSpellTargetX())
call SaveReal(h,id,2,GetSpellTargetY())
call SaveReal(h,id,6,0)
call SaveReal(h,id,5,0)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SetUnitTimeScale(u,0.5)
call SetUnitAnimation(u,"Spell Throw two")
call UnitAddAbility(u,'Arav')
call UnitRemoveAbility(u,'Arav')
loop
exitwhen is>=13
set n=CreateUnit(p,'e0ZH',x+200*Cos(ig*is),y+150*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,255,255,255,125)
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitTimeScale(n,1)
set n=CreateUnit(p,'e0ZH',x+400*Cos(ig*is),y+300*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,255,255,255,125)
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitTimeScale(n,1)
set is=is+1
endloop
if i==1 then
call UnitAddAbility(u,'A1AX')
set n=LoadUnitHandle(HH,GetHandleId(u),SH_tama)
call SetUnitOwner(n,Player(12),false)
call UnitRemoveAbility(n,'A0A1')
call UnitAddAbility(n,'A1AW')
call SaveEffectHandle(h,id,3,AddSpecialEffectTarget("war3mapImported\\Fire Bolt.mdx",n,"origin"))
set n=CreateUnit(p,'e119',x,y,180)
call SetUnitVertexColor(n,255,155,0,50)
call UnitApplyTimedLife(n,'BTLF',5)
call SetUnitTimeScale(n,0.25)
set soundplay=SndN(2582) // Sound\Music\mp3Music\TamaQCast.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
elseif i==2 then
call UnitAddAbility(u,'A1AY')
set n=LoadUnitHandle(HH,GetHandleId(u),SH_tama)
call SetUnitOwner(n,Player(12),false)
call UnitAddAbility(n,'A1AW')
call UnitRemoveAbility(n,'A0A1')
call SaveEffectHandle(h,id,3,AddSpecialEffectTarget("war3mapImported\\FrozenOrb.MDX",n,"origin"))
call SaveEffectHandle(h,id,8,AddSpecialEffectTarget("Abilities\\Weapons\\FrostWyrmMissile\\FrostWyrmMissile.mdl",n,"origin"))
set n=CreateUnit(p,'e119',x,y,180)
call SetUnitVertexColor(n,25,125,255,50)
call UnitApplyTimedLife(n,'BTLF',5)
call SetUnitTimeScale(n,0.25)
set soundplay=SndN(2584) // Sound\Music\mp3Music\TamaQCast2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call TimerStart(t,0.02,true,function RandomSpellCast)
set u=null
set p=null
set t=null
endfunction
