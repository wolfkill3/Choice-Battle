function CrashAttackCond takes nothing returns boolean
return GetSpellAbilityId()=='A0WH'
endfunction
function CrashAttackCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local group g=LoadGroupHandle(h,id,60)
local group gn=LoadGroupHandle(h,id,61)
local integer i=0
local real x=LoadReal(h,id,50)
local real y=LoadReal(h,id,51)
local real x1=0
local real y1=0
local real dist
local real f=0
local real dmg=(GetUnitAbilityLevel(u,'A0WH')+3)*GetHeroStr(u,true)
local integer l__idg=GetHandleId(g)
local player p=GetOwningPlayer(u)
if GetUnitTypeId(u)=='H14H' then
set dist=LoadReal(h,id,StringHash("dist"))+50
call SaveReal(h,id,StringHash("Dist"),dist)
if dist<=50 then
set n=CreateUnit(p,0x6F723136,x,y,0)
call SetUnitTimeScale(n,1)
call UnitApplyTimedLife(n,1,0.01)
set n=CreateUnit(p,0x6F723137,x,y,0)
call SetUnitTimeScale(n,1)
call UnitApplyTimedLife(n,1,0.01)
set n=CreateUnit(p,0x6F723138,x,y,0)
call SetUnitTimeScale(n,1)
call UnitApplyTimedLife(n,1,0.01)
endif
loop
exitwhen i>=9
if dist>650 and dist<=700 then
set x1=x+GetRandomReal(600,700)*Cos(45*i*bj_DEGTORAD-22*bj_DEGTORAD)
set y1=y+GetRandomReal(600,700)*Sin(45*i*bj_DEGTORAD-22*bj_DEGTORAD)
set n=CreateUnit(p,0x6F723139,x1,y1,GetRandomReal(0,359))
call SetUnitScale(n,1,1,1)
call UnitApplyTimedLife(n,1,0.35)
call SetUnitTimeScale(n,1.5)
endif
if dist>450 and dist<=500 then
set x1=x+GetRandomReal(400,500)*Cos(45*i*bj_DEGTORAD-45*bj_DEGTORAD)
set y1=y+GetRandomReal(400,500)*Sin(45*i*bj_DEGTORAD-45*bj_DEGTORAD)
set n=CreateUnit(p,0x6F723139,x1,y1,GetRandomReal(0,359))
call SetUnitScale(n,0.8,0.8,0.8)
call UnitApplyTimedLife(n,1,0.35)
call SetUnitTimeScale(n,1.5)
endif
if dist>150 and dist<=200 then
set x1=x+GetRandomReal(200,300)*Cos(45*i*bj_DEGTORAD)
set y1=y+GetRandomReal(200,300)*Sin(45*i*bj_DEGTORAD)
set n=CreateUnit(p,0x6F723139,x1,y1,GetRandomReal(0,359))
call SetUnitScale(n,0.6,0.6,0.6)
call UnitApplyTimedLife(n,1,0.35)
call SetUnitTimeScale(n,1.5)
endif
set i=i+1
endloop
else
loop
set i=i+1
exitwhen i>24
set n=LoadUnitHandle(h,id,1+i)
set f=GetUnitFacing(n)*bj_DEGTORAD
set dist=LoadReal(h,id,StringHash("dist"+I2S(i)))+50
call SaveReal(h,id,StringHash("Dist"+I2S(i)),dist)
set x1=x+dist*Cos(f)
set y1=y+dist*Sin(f)
call SetUnitFacing(n,f*bj_RADTODEG)
call SetUnitX(n,x1)
call SetUnitY(n,y1)
call DestroyEffect(AddSpecialEffect("war3mapImported\\TealSlam.mdx",x1,y1))
endloop
endif
call GroupEnumUnitsInRange(g,x,y,dist,Base)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set ide=GetHandleId(E)
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E,4-dist*0.0021, "stun")
call SaveUnitHandle(h,l__idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
if dist>=450 and dist<500 then
call PauseUnit(u,false)
endif
if dist>=950 then
call SetUnitInvulnerable(u,false)
if GetUnitTypeId(u)!='H14H' then
set i=0
loop
exitwhen i>24
set n=LoadUnitHandle(h,id,1+i)
call UnitApplyTimedLife(n,1,0.1)
set i=i+1
endloop
endif
call DestroyGroup(g)
call DestroyGroup(gn)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
set gn=null
set u=null
set g=null
set t=null
set p=null
endfunction
function CrashAttackCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local integer i=0
    local real x=LoadReal(h,id,50)
    local real y=LoadReal(h,id,51)
    local real r=0.
    local real x1=0
    local real y1=0
    local real x2
    local real y2
    local real dist
    local real f=0
    local real dmg=(GetUnitAbilityLevel(u,'A0WH')+3)*GetHeroStr(u,true)
    local group g=CreateGroup()
    local integer l__idg=GetHandleId(g)
    local player p=GetOwningPlayer(u)
    call SetUnitTimeScale(u,1)
    call PauseTimer(t)
    if GetUnitTypeId(u)=='H14H' then
    call SaveGroupHandle(h,id,60,CreateGroup())
    call SaveGroupHandle(h,id,61,g)
    call UnitRemoveAbility(u,'A202')
    call TimerStart(t,.02,true,function CrashAttackCast3)
    else
    loop
    exitwhen i>24
    set r=i*15.
    set n=CreateUnit(p,'e0TF',x,y,r)
    call GroupAddUnit(g,n)
    call SaveUnitHandle(h,id,1+i,n)
    set i=i+1
    endloop
    call SaveGroupHandle(h,id,60,CreateGroup())
    call SaveGroupHandle(h,id,61,g)
    call UnitRemoveAbility(u,'A202')
    call TimerStart(t,.02,true,function CrashAttackCast3)
    endif
    set u=null
    set p=null
endfunction
