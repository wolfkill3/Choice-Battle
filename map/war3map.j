                        call EffectCreateAndMove1(false,"war3mapImported\\WindNewFaw4.mdl",GetRandomReal(0,360),1,0.8,1.25,0,0,0,40,0,0,u,0,LoadReal(HH,id,3))
                endif
                if(time==2)then
                        call UnitColor(u,100,100,100,0)
                        call RemoveSavedBoolean(HH,GetHandleId(u),SH_LucciTekkai)
                        call UnitSpeed(u,1)
                        call SetUnitPathing(u,true)
                        call PauseUnit(u,false)
                        call PauseTimer(t)
                        call DestroyTimer(t)
                        call FlushChildHashtable(HH,id)
                endif
        endif
        set t=null
        set u=null
endfunction
