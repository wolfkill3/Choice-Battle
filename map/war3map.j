function Trig_QDeidaraDeath_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local integer idu=GetHandleId(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real dmg=2000
local real lvl=0.2
local integer ids 
local integer idp=GetPlayerId(p)
if GetUnitTypeId(u)=='no02' or GetUnitTypeId(u)=='eo9O' then
set dmg=LoadReal(HH,idu,0)
call DestroyEffect(AddSpecialEffect("war3mapImported\\aerialexplosionv3.mdx",x,y))
call GroupEnumUnitsInRange(G,x,y,250,Base)
set soundplay=SndN(3012) // Sound\war3mapImported\DeidaraQ2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SetSoundVolume(soundplay,350)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
elseif GetUnitTypeId(u)=='eo9M' then
set dmg=LoadReal(HH,idu,0)
set ids='A09B'
set lvl=2
set soundplay=SndN(3014) // Sound\war3mapImported\DeidaraR2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SetSoundVolume(soundplay,250)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call GroupEnumUnitsInRange(G,x,y,800,Base)
set n=CreateUnit(p,'eo9K',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
set n=CreateUnit(p,'eo9L',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0S4',x,y,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e1S5',x,y,GetRandomReal(0,359)),'BTLF',6)
call UnitApplyTimedLife(CreateUnit(p,'e0S3',x,y,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e1S2',x,y,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e0S6',x,y,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e0S7',x,y,GetRandomReal(0,359)),'BTLF',3)
endif
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(Hero[idp],E,dmg,false,false,null,null,null)//
call SetControlToUnit(E,E, lvl, "stun")
endif
call GroupRemoveUnit(G,E)
endloop
set p=null
set u=null
endfunction
