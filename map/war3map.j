set HSE[3]=Hero[i]
endif
set i=i+1
endloop
set i=0
loop
exitwhen i>=12
if GetUnitTypeId(Hero[i])=='H05C' then
set HSE[1]=Hero[i]
endif
set i=i+1
endloop
set i=0
