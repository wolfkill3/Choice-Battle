endfunction
function LucyScorpioCast6 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real a=LoadReal(h,id,3)
local real dist=LoadReal(h,id,20)
local real x=GetUnitX(l__d)+50*Cos(a)
local real y=GetUnitY(l__d)+50*Sin(a)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real dmg=GetHeroInt(u,true)*(1+GetUnitAbilityLevel(u,'A1ES'))
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,12)
local real s1=LoadReal(h,id,10)
local real time=LoadReal(h,id,15)
local integer l__idg=GetHandleId(g)
local integer l__ide=0
if dist>0 then
call SetUnitXY_1(l__d,x,y, false)
call SaveReal(h,id,10,s1+0.075)
set n=CreateUnit(p,'e148',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1.75)
call SetUnitTimeScale(n,0.75)
call SetUnitFlyHeight(n,85+s1*40,0)
call SetUnitScale(n,0.4+s1,0.4+s1,0.4+s1)
set n=CreateUnit(p,'e149',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1.75)
call SetUnitTimeScale(n,1.25)
call SetUnitFlyHeight(n,85+s1*40,0)
call SetUnitScale(n,0.4+s1,0.4+s1,0.4+s1)
call GroupEnumUnitsInRange(g,x,y,120+s1*80,Base)
set l__idg=GetHandleId(g)
call SaveReal(h,id,20,dist-50)
loop
set E=FirstOfGroup(g)
set l__ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,l__idg,l__ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,l__idg,l__ide,E)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
else
call SetUnitTimeScale(u,1)
call RemoveUnit(l__d)
call FlushChildHashtable(h,GetHandleId(g))
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
function LucyScorpioCast5 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,5)
local real y1=LoadReal(h,id,6)
local real a=LoadReal(h,id,11)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,12)
local real dmg=LoadReal(h,id,4)
local real dist=LoadReal(h,id,2)
local real scale=LoadReal(h,id,10)
local real time=LoadReal(h,id,16)
local integer ip=GetPlayerId(p)
if time<0.2 then
set n=CreateUnit(p,'e10N',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,0.65,0.65,0.65)
call SetUnitVertexColor(n,75,255,125,50)
set n=CreateUnit(p,'e10N',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,75,255,125,50)
call SaveReal(h,id,16,time+0.1)
else
if GetUnitAbilityLevel(LUcy[ip],'LUQ2')==0 then
call UnitRemoveAbility(LUcy[ip],'LUQ1')
set n=CreateUnit(p,'e14A',x+45*Cos(a),y+45*Sin(a),a*bj_RADTODEG)
call SaveUnitHandle(h,id,7,n)
call SetUnitTimeScale(n,2)
call PauseTimer(t)
call TimerStart(t,0.025,true,function LucyScorpioCast6)
else
call UnitRemoveAbilityTimed(LUcy[ip],'LUQ1',1)
call SetUnitTimeScale(u,1)
call FlushChildHashtable(h,GetHandleId(g))
call GroupClear(g)
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
endif
set g=null
set d=null
set p=null
set u=null
set t=null
endfunction
function LucyScorpioCast34 takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,5,x1)
call SaveReal(h,id,6,y1)
call SaveReal(h,id,10,0.05)
call SaveReal(h,id,13,0.4)
call SaveReal(h,id,14,100)
call SaveReal(h,id,15,0)
call SaveReal(h,id,16,0)
call SaveReal(h,id,11,a)
call SetUnitTimeScale(u,0)
