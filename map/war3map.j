endfunction
function NejiECast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local group g=LoadGroupHandle(h,id,1)
local integer i=1
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real dmg=GetHeroAgi(u,true)*.1
local real dmg2=GetHeroAgi(u,true)*(GetUnitAbilityLevel(u,'A3G2')+2)
local player p=GetOwningPlayer(u)
local real r=GetRandomReal(0.,6.283185)
local real dist=LoadReal(h,id,6)
local real time=LoadReal(h,id,7)
local unit nje=null // свои вместо общих E / ide / idg: урон внутри перебора
local integer njide=0
local integer njidg=0
set njidg=GetHandleId(g)
call SaveReal(h,id,7,time+0.05)
if GetUnitCurrentOrder(u)==OrderId("root") then
call SetUnitScale(LoadUnitHandle(h,id,8),1.6,1.6,1.6)
call SetUnitVertexColor(LoadUnitHandle(h,id,8),70,70,250,220)
call SetUnitXY_1(LoadUnitHandle(h,id,8),x,y,false)
if dist>=2 then
set n=CreateUnit(p,'e0B2',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',.25)
call SetUnitScale(n,3.5,1.5,1.5)
call SetUnitVertexColor(n,250,255,255,30)
call SaveReal(h,id,6,0)
call GroupEnumUnitsInRange(g,x,y,400,Base)
loop
set nje=FirstOfGroup(g)
set njide=GetHandleId(nje)
exitwhen nje==null
if Condition_Base(p,nje) and LoadUnitHandle(h,njidg,njide)!=nje and IsUnitInvulnerable(nje)==false then
call myCustomDamage(u,nje,dmg2,false,false,null,null,null)
call SaveUnitHandle(h,njidg,njide,nje)
call SetControlToUnit(nje,nje, 0.2, "stun")
if SR(GetUnitY(nje),y,GetUnitX(nje),x)<340 then
call SetUnitXY_1(nje,GetUnitX(nje)+5*Cos(Atan2(GetUnitY(nje)-y,GetUnitX(nje)-x)),GetUnitY(nje)+5*Sin(Atan2(GetUnitY(nje)-y,GetUnitX(nje)-x)),false)
elseif SR(GetUnitY(nje),y,GetUnitX(nje),x)>=340 and SR(GetUnitY(nje),y,GetUnitX(nje),x)<400 then
call SetUnitXY_1(nje,GetUnitX(nje)-5*Cos(Atan2(GetUnitY(nje)-y,GetUnitX(nje)-x)),GetUnitY(nje)-5*Sin(Atan2(GetUnitY(nje)-y,GetUnitX(nje)-x)),false)
endif
elseif Condition_Base(p,nje) then
call myCustomDamage(u,nje,dmg,false,false,null,null,null)
call SetControlToUnit(nje,nje, 0.2, "stun")
if SR(GetUnitY(nje),y,GetUnitX(nje),x)<340 then
call SetUnitXY_1(nje,GetUnitX(nje)+5*Cos(Atan2(GetUnitY(nje)-y,GetUnitX(nje)-x)),GetUnitY(nje)+5*Sin(Atan2(GetUnitY(nje)-y,GetUnitX(nje)-x)),false)
elseif SR(GetUnitY(nje),y,GetUnitX(nje),x)>=340 and SR(GetUnitY(nje),y,GetUnitX(nje),x)<400 then
call SetUnitXY_1(nje,GetUnitX(nje)-5*Cos(Atan2(GetUnitY(nje)-y,GetUnitX(nje)-x)),GetUnitY(nje)-5*Sin(Atan2(GetUnitY(nje)-y,GetUnitX(nje)-x)),false)
endif
endif
call GroupRemoveUnit(g,nje)
endloop
else
call SaveReal(h,id,6,dist+1)
endif
else
set n=CreateUnit(p,'e0B2',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',.25)
call SetUnitScale(n,4.1,1.5,1.5)
call SetUnitVertexColor(n,250,255,255,70)
call SetUnitTimeScale(u,0.13)
call GroupEnumUnitsInRange(G,x,y,410,Base)
loop
set nje=FirstOfGroup(G)
exitwhen nje==null
if Condition_Base(p,nje) then
call Push3(nje,50,Atan2(GetUnitY(nje)-y,GetUnitX(nje)-x),200,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
call SetControlToUnit(nje,nje, 0.3, "stun")
endif
call GroupRemoveUnit(G,nje)
endloop
call SetUnitFlyHeight(u,0,0)
call FlushChildHashtable(h,njidg)
call RemoveUnit(LoadUnitHandle(h,id,8))
call GroupClear(g)
call DestroyGroup(g)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
call SetUnitTimeScale(u,1)
call SetUnitAnimation(u,"stand")
call SetUnitInvulnerable(u,false)
endif
set g=null
set u=null
set t=null
set p=null
set nje=null
endfunction
function NejiECast takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=0
local player p=GetOwningPlayer(u)
local group g=CreateGroup()
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
set n=CreateUnit(p,'e1VA',x,y,0)
call SetUnitVertexColor(n,50,50,250,190)
call SetUnitScale(n,0.5,0.5,0.5)
call SetUnitTimeScale(n,2)
call SaveUnitHandle(h,id,8,n)
call SaveReal(h,id,6,3)
call SaveReal(h,id,7,0)
set soundplay=SndN(848) // Sound\Music\mp3Music\NejiE.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SetUnitTimeScale(u,4)
call SetUnitInvulnerable(u,true)
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,1,g)
call TimerStart(t,.05,true,function NejiECast2)
set p=null
set u=null
set t=null
endfunction
