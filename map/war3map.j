call TriggerAddCondition(gg_trg_Sanzu,Condition(function SanzuReverShootCond))
endfunction
function DeathCannonCond takes nothing returns boolean
return GetSpellAbilityId()=='A0C6'
endfunction
function DeathCannonCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x2=LoadReal(h,id,2)
local real y2=LoadReal(h,id,3)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real a=Atan2(y2-y1,x2-x1)
local real a2
local player p=GetOwningPlayer(u)
local real dmg=GetHeroAgi(u,true)*(GetUnitAbilityLevel(u,'A0C6')+1)+75
if SR(x1,y1,x2,y2)>26.00 then
set x1=x1+47*Cos(a)
set y1=y1+47*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
call UnitApplyTimedLife(CreateUnit(p,'e06L',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e04A',x1,y1,a*bj_RADTODEG),'BTLF',1)
else
call UnitApplyTimedLife(CreateUnit(p,'e048',x1,y1,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e03W',x1,y1,0),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e06O',x1,y1,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e06N',x1,y1,0),'BTLF',3)
call DestroyEffect(AddSpecialEffect("war3mapImported\\explode.mdx",x1,y1))
call DestroyEffect(AddSpecialEffect("war3mapImported\\SuperBigExplosion.mdx",x1,y1))
call GroupEnumUnitsInRange(G,x1,y1,400,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call Push(E,30,Atan2(GetUnitY(E)-y2,GetUnitX(E)-x2),300)
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SlowUnit(u,E,0.5,0,5,0,false)
endif
call GroupRemoveUnit(G,E)
endloop
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call RemoveUnit(l__d)
endif
set l__d=null
set p=null
set u=null
set t=null
endfunction
