function QShikiThreeCast5 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit c=LoadUnitHandle(HH,id,1)
local integer idu=GetHandleId(u)
local real x=GetUnitX(c)
local real y=GetUnitY(c)
local real x1=0
local real y1=0
local real a=LoadReal(HH,idu,StringHash("ANQ"))
local real dist=LoadReal(HH,id,2)
local integer fe=LoadInteger(HH,id,4)
local real he=LoadReal(HH,id,7)*((750-dist)/770)
local real sc=0
local player p=GetOwningPlayer(u)
local integer idp=GetHandleId(p)
if dist<950 then
    if IsTerrainPathable(GetUnitX(c),GetUnitY(c),PATHING_TYPE_FLYABILITY)==false  then
        set x=x+60*Cos(a)
        set y=y+60*Sin(a)
        call SetUnitX(c,x)
        call SetUnitY(c,y)
    endif
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
//call SetUnitInvulnerable(c,c, true)
call SetUnitFlyHeight(c,he,0)
call SaveReal(HH,id,2,dist+60)
if dist>70 and fe==0 then
call SetUnitFlyHeight(u,0,0)
call SaveInteger(HH,id,4,1)
endif
else
call ShakeCamera(0.25,15)
call RemoveSavedHandle(HH,idu,StringHash("Q3"))
call RemoveSavedHandle(HH,idp,StringHash("EW"))
call DestroyEffect(AddSpecialEffect("war3mapImported\\WarStompCaster.mdx",x,y))
call DestroyEffect(AddSpecialEffect("war3mapImported\\SandPoff.mdx",x,y))
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
//call SetUnitInvulnerable(c,c, false)
if ((GetHeroAgi(u,true)*(1+0.6*GetUnitAbilityLevel(u,'A1BR')))+20)*(1-LoadInteger(HH,idu,ComboCounterHash)*0.045)>((GetHeroAgi(u,true)*(1+0.6*GetUnitAbilityLevel(u,'A1BR')))+20)*0.1 then
call myCustomDamage(u,c,((GetHeroAgi(u,true)*(1+0.6*GetUnitAbilityLevel(u,'A1BR')))+20)*(1-LoadInteger(HH,idu,ComboCounterHash)*0.045),false,false,null,null,null)
else
call myCustomDamage(u,E,((GetHeroAgi(u,true)*(1+0.6*GetUnitAbilityLevel(u,'A1BR')))+20)*0.1,false,false,null,null,null)
endif
call SetControlToUnit(u,c,0.5, "stun")
call UnitRemoveAbility(c,'A1BJ')
call UnitRemoveAbility(u,'A1BK')
call SetUnitFlyHeight(c,0,0)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set c=null
set u=null
set p=null
set t=null
endfunction
