function MissleMoveShockingBall2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,2)
local real speed=LoadReal(h,id,4)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,6)
local real y1=LoadReal(h,id,7)
local real a=Atan2(y1-y,x1-x)+LoadReal(h,id,3)
local player p=GetOwningPlayer(u)
local real dmg=LoadReal(h,id,5)
if SR(x,y,x1,y1)>speed+5 then
set x=x+speed*Cos(a)
set y=y+speed*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SaveReal(h,id,4,speed+speed*0.02)
else
call GroupEnumUnitsInRange(DG,x1,y1,500,Base)
loop
set E=FirstOfGroup(DG)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(DG,E)
endloop
call UnitApplyTimedLife(CreateUnit(p,'e095',x1,y1,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e096',x1,y1,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e097',x1,y1,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e098',x1,y1,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e099',x1,y1,0),'BTLF',3)
set soundplay=SndN(1428) // Sound\Music\mp3Music\BuuWExp.mp3
//call SetSoundVolume(soundplay,70)
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
call KillUnit(l__d)
endif
set p=null
set l__d=null
set t=null
set u=null
endfunction
