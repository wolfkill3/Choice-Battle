function ShuJumpsCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real time=LoadReal(h,id,11)
local real ang=LoadReal(h,id,12)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>50 and GetWidgetLife(c)>0 then
set x=x+40*Cos(a)
set y=y+40*Sin(a)
call SetUnitXY_1(u,x,y,false)
call SetUnitFacing(u,a*bj_RADTODEG)
set n=CreateUnit(p,'e08L',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.25)
call SetUnitVertexColor(n,170,170,170,170)
call SetUnitTimeScale(n,2)
call SetUnitAnimation(n,"spell six")
call SetUnitAnimation(u,"spell six")
call SaveReal(h,id,11,time+0.025)
if time>0.1 then
call SaveReal(h,id,11,0)
call SaveReal(h,id,12,ang*(-1))
set x=x+200*Cos(a+bj_PI*ang/2)
set y=y+200*Sin(a+bj_PI*ang/2)
call UnitApplyTimedLife(CreateUnit(p,'e08Q',x,y,a*bj_RADTODEG),'BTLF',1)
call SetUnitXY_1(u,x,y, false)
endif
else
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",c,"chest"))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\s_ShadowEruption_Rain.mdx",c,"chest"))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\MajinHuntSlash.mdx",c,"chest"))
call SetUnitInvulnerable(u,false)
call UnitRemoveAbility(u,'A0BX')
call myCustomDamage(u,c,((3+GetUnitAbilityLevel(u,0x41313559))*GetHeroAgi(u,true)),false,false,null,null,null)
set x=x+150*Cos(LoadReal(h,id,9))
set y=y+150*Sin(LoadReal(h,id,9))
call SetUnitAnimation(u,"spell channel one")
call SetUnitXY_1(u,x,y, false)
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitTimeScale(u,1)
call SetUnitPathing(u,true)
call PauseUnit(u,false)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function ShuJumpsCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real a=Atan2(GetUnitY(c)-y,GetUnitX(c)-x)
call SaveUnitHandle(h,id,0,u)
call SetUnitPathing(u,false)
call SetUnitAnimation(u,"spell two")
call UnitAddAbility(u,'A0BX')
call PauseUnit(u,true)
call SaveReal(h,id,9,a)
call SaveReal(h,id,11,0)
call SaveReal(h,id,12,-1)
call UnitApplyTimedLife(CreateUnit(p,'e08Q',x,y,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e08M',x,y,GetRandomReal(0,359)),'BTLF',1)
set n=CreateUnit(p,'e08N',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',1.25)
call SetUnitVertexColor(n,100,100,100,140)
call SetUnitTimeScale(u,5)
call SetUnitInvulnerable(u,true)
call SaveUnitHandle(h,id,1,c)
set soundplay=SndN(1173) // Sound\Music\mp3Music\OumaShu.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.025,true,function ShuJumpsCast2)
set c=null
set p=null
set u=null
set t=null
endfunction
