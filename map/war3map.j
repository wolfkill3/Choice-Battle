call CameraSetSourceNoise(0,0)
call CameraSetTargetNoise(0,0)
call SetUnitTimeScale(u,1)
call PauseTimer(t)
call TimerStart(t,0.02,true,function RockCast3)
endif
set l__d=null
set p=null
set u=null
set t=null
endfunction
function RockCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local real ang=150*bj_DEGTORAD
local trigger tt=CreateTrigger()
local real damage = ((GetUnitAbilityLevel(u,'A0U1')+4)*GetHeroStr(u,true))
if GetUnitAbilityLevel(u,'A0U5') > 0 then
    set damage = damage * (1.125+0.025*GetUnitAbilityLevel(u,'A0U5'))
endif
call SaveUnitHandle(h,id,0,u)
call SaveTriggerHandle(h,id,1,tt)
call SaveReal(h,id,5,x1)
call SaveReal(h,id,6,y1)
call SaveReal(h,id,4,damage)
call SaveReal(h,id,2,1500)
call SaveReal(h,id,10,1.25)
call SaveReal(h,id,11,a)
call SaveReal(h,id,17,2.4)
call SaveReal(h,id,18,0.4)
call CameraSetTargetNoiseEx(3*2.0,3*Pow(10,2),true)
call CameraSetSourceNoiseEx(3*2.0,3*Pow(10,2),true)
call SetUnitTimeScale(u,0)
call SetUnitInvulnerable(u,true)
call SaveGroupHandle(h,id,12,CreateGroup())
set n=CreateUnit(p,'e0RD',x+65*Cos(a-ang),y+65*Sin(a-ang),a*bj_RADTODEG)
call SaveUnitHandle(h,id,7,n)
call SetUnitScale(n,0.2,0.2,0.2)
if GetUnitTypeId(u)!='H04B' then
set soundplay=SndN(2045) // Sound\Music\mp3Music\JajankenRock.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
set soundplay=SndN(2047) // Sound\Music\mp3Music\GonGR1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call UnitAddAbility(u,'A1FU') //Slow
call UnitAddAbility(u,'Pet1')
call SetUnitAcquireRange(u,51)
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerAddAction(tt,function GonRockStopOrders)
call TimerStart(t,0.1,true,function RockCast2)
set u=null
set p=null
set t=null
endfunction
function InitTrig_Rock takes nothing returns nothing
set gg_trg_Rock=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Rock,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_Rock,Condition(function RockCond))
call TriggerAddAction(gg_trg_Rock,function RockCast)
endfunction
