//=========== Темный Экскалибур - Dark Excalibur
function Trig_VampirikRage_Conditions takes nothing returns boolean
return (UnitHasItemOfTypeBJ(GetAttacker(),'I01S') or GetUnitAbilityLevel(GetAttacker(),'KI18')>0) and (GetUnitTypeId(GetAttacker())!='H059' and GetUnitTypeId(GetAttacker())!='H06S' and GetUnitTypeId(GetAttacker())!='H070')and GetUnitAbilityLevel(GetAttacker(),'A06R')==0 and (GetRandomReal(0,100)<=30. or GetUnitAbilityLevel(GetAttacker(),'A06K')>0) and GetUnitTypeId(GetTriggerUnit())!='H007'  and GetUnitAbilityLevel(GetTriggerUnit(),'GIE1')==0 and IsUnitType(GetAttacker(), UNIT_TYPE_HERO) and IsUnitIllusion(GetAttacker())==false and udg_B==true
endfunction
function DarkExcalibur_CD takes nothing returns nothing
        local integer id = GetHandleId(GetExpiredTimer())
        local integer id_caster = GetHandleId(LoadUnitHandle(h, id, CasterHash))
        call SaveBoolean(h, id_caster, StringHash("ItemDarkExc_CD"), false)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
endfunction
function Trig_VampirikRage_Actions2 takes nothing returns nothing
	local timer t=GetExpiredTimer()
	local integer id=GetHandleId(t)
	local unit u=LoadUnitHandle(h,id,0)
	local integer id_caster=GetHandleId(u)
	call UnitRemoveAbility(u, 'A06R')
	call FlushChildHashtable(h,id)
	call DestroyTimer(t)
	call SaveBoolean(h, id_caster, StringHash("ItemDarkExc_CD"), true)
	set bjLCT=CreateTimer()
	call SaveUnitHandle(h, GetHandleId(bjLCT), CasterHash, u)
	call TimerStart(bjLCT, 9, false, function DarkExcalibur_CD)
	set bjLCT=null
	set u=null
	set t=null
endfunction
function Trig_VampirikRage_Actions takes nothing returns nothing
        local timer t=CreateTimer()
        local unit u=GetAttacker()
        local integer id_caster = GetHandleId(u)
        if LoadBoolean(h, id_caster, StringHash("ItemDarkExc_CD"))==false then
                call SaveBoolean(h, id_caster, StringHash("ItemDarkExc_CD"), true)
                call UnitRemoveAbility(u, 'A06R')
                call UnitAddAbility(u,'A06R')
                call SaveUnitHandle(h,GetHandleId(t),0,u)
                call TimerStart(t,3,false,function Trig_VampirikRage_Actions2)
        else
                call DestroyTimer(t)
        endif
        set u=null
        set t=null
endfunction
function InitTrig_VampirikRage takes nothing returns nothing
        set gg_trg_VampirikRage=CreateTrigger()
        call TriggerRegisterAnyUnitEventBJ(gg_trg_VampirikRage,EVENT_PLAYER_UNIT_ATTACKED)
        call TriggerAddCondition(gg_trg_VampirikRage,Condition(function Trig_VampirikRage_Conditions))
        call TriggerAddAction(gg_trg_VampirikRage,function Trig_VampirikRage_Actions)
endfunction
