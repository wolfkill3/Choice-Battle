function KatonGECond takes nothing returns boolean
return GetSpellAbilityId()=='A0CG'
endfunction
function KatonGECast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local real a=Atan2(y1-y,x1-x)
local real dist=LoadReal(h,id,4)
local real time=LoadReal(h,id,10)
local real dist2=LoadReal(h,id,5)+85
local real r=LoadReal(h,id,9)+0.1
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,8)
local real dmg=((1+GetUnitAbilityLevel(u,'A0CG'))*GetHeroStr(u,true)+150)*0.07
// урон x2 и замедление — через тик (0.14 с): тот же урон в секунду, обработчик урона и система контроля вдвое реже
local boolean hit=ModuloInteger(R2I(time/0.07+0.5),2)==0
set x=x+dist2*Cos(a)
set y=y+dist2*Sin(a)
if time<1.5 then
call SetUnitTimeScale(u,0.1)
call SetUnitAnimation(u,"stand channel")
if dist>dist2 then
set n=CreateUnit(p,'e073',x,y,a*bj_RADTODEG)
call SaveReal(h,id,5,dist2)
call SaveReal(h,id,9,r)
call SetUnitFlyHeight(n,GetUnitFlyHeight(n)-r*7,0)
call SetUnitScale(n,r,r,r)
call GroupAddUnit(g,n)
else
call SaveReal(h,id,10,time+0.07)
call UnitApplyTimedLife(CreateUnit(p,'e075',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e076',x,y,GetRandomReal(0,359)),'BTLF',1)
call GroupEnumUnitsInRange(G,x1,y1,400,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if hit and Condition_Base(p,E)then
if GetUnitAbilityLevel(E,'B02F')>0 then
call myCustomDamage(u,E,dmg*3.,false,false,null,null,null)
else
call myCustomDamage(u,E,dmg*2.,false,false,null,null,null)
endif
call SlowUnit(u,E,0.7,0,5,0,false)
endif
call GroupRemoveUnit(G,E)
endloop
endif
else
loop
set E=FirstOfGroup(g)
call RemoveUnit(E)
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
call SetUnitTimeScale(u,1)
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set p=null
set u=null
set t=null
endfunction
function KatonGECast takes nothing returns nothing
// Jiraya TQ
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)

if LoadBoolean(HH,GetHandleId(u),SH_JirTB)==false then




call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,8,CreateGroup())
call SaveReal(h,id,9,0.7)
call SaveReal(h,id,10,0)
call SetUnitAnimation(u,"stand channel")
call SaveReal(h,id,4,SR(GetUnitX(u),GetUnitY(u),GetSpellTargetX(),GetSpellTargetY()))
call SaveReal(h,id,2,GetSpellTargetX())
call SaveReal(h,id,3,GetSpellTargetY())
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
set soundplay=SndN(4102) // Sound\Music\mp3Music\Endan.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.07,true,function KatonGECast2)





else


call SaveUnitHandle(HH,id,1,GetTriggerUnit())
call SaveReal(HH,id,11,SpellTargetLocX())
call SaveReal(HH,id,12,SpellTargetLocY())
call SaveReal(HH,id,3,Angle2(GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()),SpellTargetLocX(),SpellTargetLocY())) 
call SaveUnitHandle(HH,id,2,LoadUnitHandle(HH,GetHandleId(GetTriggerUnit()),SH_JirTG))
call SaveBoolean(HH,GetHandleId(GetTriggerUnit()),SH_JirTS,true)
call SetUnitFacing(GetTriggerUnit(),LoadReal(HH,id,3))
call TimerStart(t,0.02,true,function JirayaTQAct)






endif


set u=null
set t=null

endfunction
function KatonGEInit takes nothing returns nothing
endfunction
function ChoOdamaRasenganCond takes nothing returns boolean
