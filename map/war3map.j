function MissleMoveDeathBall2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,2)
local real speed=LoadReal(h,id,4)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,6)
local real y1=LoadReal(h,id,7)
local real a=Atan2(y1-y,x1-x)+LoadReal(h,id,3)
local player p=GetOwningPlayer(u)
local real dmg=LoadReal(h,id,5)
if SR(x,y,x1,y1)>speed+5 then
set x=x+speed*Cos(a)
set y=y+speed*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SaveReal(h,id,4,speed+speed*0.02)
else
call GroupEnumUnitsInRange(G,x1,y1,900,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(G,E)
endloop
call UnitApplyTimedLife(CreateUnit(p,'e0DL',x1,y1,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0DK',x1,y1,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0DJ',x1,y1,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0KO',x1,y1,GetRandomReal(0,359)),'BTLF',4)
set n=CreateUnit(p,'e0F1',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',4)
call SetUnitTimeScale(n,2)
call StartSound(soundStr[47])
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
call KillUnit(l__d)
endif
set p=null
set l__d=null
set t=null
set u=null
endfunction
function DeathBallCond takes nothing returns boolean
return GetSpellAbilityId()=='A0SY' and udg_B==true
endfunction
function DeathBallCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,3)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,8)
local real y1=LoadReal(h,id,9)
local real time=LoadReal(h,id,10)+0.05
local real a=Atan2(y1-y,x1-x)
local real dmg=12*GetHeroInt(u,true)
local real l__s=LoadReal(h,id,7)+0.13
if time<2.0 then
call SetUnitScale(l__d,l__s,l__s,l__s)
call SaveReal(h,id,7,l__s)
call SaveReal(h,id,10,time)
else
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(1989) // Sound\Music\mp3Music\FriezaDie!.mp3
else
set soundplay=SndN(1992) // Sound\Music\mp3Music\Frieza\FriezaDie!-jap.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call MissleMovePlanetBurst(u,x1,y1,l__d,30,0,dmg,600,SR(x,y,x1,y1))
call SetUnitFlyHeight(u,0,300)
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
call SetUnitAnimation(u,"Stand")
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set u=null
set t=null
endfunction
function DeathBallCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
call UnitAddAbility(u,'Arav')
call SaveUnitHandle(h,id,0,u)
set n=CreateUnit(GetOwningPlayer(u),0x65305158,x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,200)
call SetUnitTimeScale(n,0.3)
call SetUnitScale(n,0.1,0.1,0.1)
call SaveUnitHandle(h,id,3,n)
call SaveReal(h,id,7,0.1)
call SaveReal(h,id,6,0)
call SaveReal(h,id,8,x1)
call SaveReal(h,id,9,y1)
call SaveReal(h,id,10,0)
call SetUnitFlyHeight(u,300,0)
call SetUnitFlyHeight(n,600,0)
call UnitRemoveAbility(u,'Arav')
call SetUnitInvulnerable(u,true)
call PauseUnit(u,true)
call SetUnitAnimation(u,"Stand Channel")
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(1995) // Sound\Music\mp3Music\FriezaPlanetBurstCast.mp3
else
set soundplay=SndN(1997) // Sound\Music\mp3Music\Frieza\FriezaPlanetBurstCast-jap.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.05,true,function DeathBallCast2)
set u=null
set t=null
endfunction
