local real x1=LoadReal(h,id,1)
local real y1=LoadReal(h,id,2)
local real x2=0
local real y2=0
local real x3=0
local real y3=0
local real a2=0
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real dmg=(4+GetUnitAbilityLevel(u,'A1E8'))*GetHeroAgi(u,true)
local real sc=0
local real is=0
local real ig=20*bj_DEGTORAD
local integer ri=GetRandomInt(0,100)
local integer lvl=GetUnitAbilityLevel(u,'A1EC')
local boolean bPaused=false
set x1=x+700*Cos(a)
set y1=y+700*Sin(a)
set x2=x+500*Cos(a)
set y2=y+500*Sin(a)
set n=CreateUnit(p,'e11Q',x1,y1,GetRandomReal(0,359))
call SetUnitScale(n,6,6,6)
call SetUnitVertexColor(n,75,105,255,255)
call UnitApplyTimedLife(n,1,1.5)
call SetUnitTimeScale(n,1.5)
loop
exitwhen is>=13
set x3=x1+650*Cos(a-240*bj_DEGTORAD-ig*is)
set y3=y1+650*Sin(a-240*bj_DEGTORAD-ig*is)
set a2=Atan2(y3-y,x3-x)
set n=CreateUnit(p,'e0ZH',x3,y3,180+a2*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,75)
call UnitApplyTimedLife(n,1,3)
call SetUnitScale(n,3,3,3)
call SetUnitTimeScale(n,0.5)
set x3=x1+450*Cos(a-240*bj_DEGTORAD-ig*is)
set y3=y1+450*Sin(a-240*bj_DEGTORAD-ig*is)
set a2=Atan2(y3-y,x3-x)
set n=CreateUnit(p,'e0ZH',x3,y3,180+a2*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,75)
call UnitApplyTimedLife(n,1,3)
call SetUnitScale(n,2,2,2)
call SetUnitTimeScale(n,0.5)
set x3=x1+250*Cos(a-240*bj_DEGTORAD-ig*is)
set y3=y1+250*Sin(a-240*bj_DEGTORAD-ig*is)
set a2=Atan2(y3-y,x3-x)
set n=CreateUnit(p,'e0ZH',x3,y3,180+a2*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,75)
call UnitApplyTimedLife(n,1,3)
call SetUnitScale(n,1,1,1)
call SetUnitTimeScale(n,0.5)
set is=is+1
endloop
call GroupEnumUnitsInRange(G,x1,y1,900,Base)
loop
set E=FirstOfGroup(G)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)then
set bPaused=false
if IsUnitPaused(E) then
    set bPaused=true
    call PauseUnit(E,false)
endif
call IssueImmediateOrder(E,"manashieldoff")
call IssueImmediateOrder(E,"unimmolation")
call UnitRemoveAbility(E,'A1GL')
call UnitRemoveAbility(E,'WAE1')
call UnitRemoveAbility(E,'A1WT')
call UnitRemoveBuffs(E,true,false)
if UnitHasItemOfTypeBJ(E, 'I03A') and GetWidgetLife(E)>0 and IsUnitIllusion(E)==false then
    set AlastorPos=0
    loop
    exitwhen AlastorPos==6 or GetItemTypeId(UnitItemInSlot(E,AlastorPos)) == 'I03A'
    set AlastorPos=AlastorPos+1
    endloop
    if IsAbilityEnabled(GetUnitAbility(E,'AInv'))==true then
        set Alastor=GetItemOfTypeFromUnitBJ(E,'I03A')
        call UnitRemoveItem(E,Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(E, 'I03A',AlastorPos)
    else
        call EnableUnitAbility2(E,'AInv',false,true)
        set Alastor=GetItemOfTypeFromUnitBJ(E,'I03A')
        call UnitRemoveItem(E,Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(E, 'I03A',AlastorPos)    
        call DisableUnitAbility2(E,'AInv',false,true)
    endif
endif
call UnitAddItemById(E,'I06B')
if LoadReal(h, ide, StringHash("ShieldBelfF"))>0 then   // Щит Бельфегора
    call SaveReal(h, ide, StringHash("ShieldBelfF"), 0)
else
    call SaveReal(h, ide, StringHash("ShieldBelfF"), 0)
    call RemoveSavedReal(h, ide, StringHash("ShieldBelfF"))
endif
if LoadReal(h, ide, StringHash("YujiE_Shield"))>0 then  // Щит Юджи
    call SaveReal(h, ide, StringHash("YujiE_Shield"), 0)
else
    call RemoveSavedReal(h, ide, StringHash("YujiE_Shield"))
endif
if GetUnitAbilityLevel(E,'A1DF')>=1 then                  // Щит Шилдер Q
    call UnitRemoveAbility(E,'A1DF')
    call SaveReal(h,ide, StringHash("shi1"), 0)
    call SaveReal(h,ide, StringHash("shi2"), 0)
endif
if GetUnitAbilityLevel(E,'A1DG')>=1 then                  // Щит Шилдер E
    call UnitRemoveAbility(E, 'A1DG')
endif
if GetUnitAbilityLevel(E,'A10G')>=1 then                  // Щит Луизы
    call UnitRemoveAbility(E, 'A10G')
endif
if GetUnitAbilityLevel(E, 'A2DF')>0 then                      // Щит Броли
    call SaveReal(h,ide,StringHash("BroEtime"),9)
endif
if GetUnitAbilityLevel(E, 'A0VJ')>0 then                  // Гроза Вонголы
    call UnitRemoveAbility(E, 'A0VJ')
endif
if GetUnitAbilityLevel(E, 'A1HG')>0 then                  // Щит Орехи
    call UnitRemoveAbility(E, 'A1HG')
endif
if GetUnitAbilityLevel(E, 'A3DF')>0 then                  // Щит Waver
    call UnitRemoveAbility(E, 'A3DF')
endif
if GetUnitAbilityLevel(E, 'A1H1')>=1 then                 // Щит от Ульты Жанны Рулер
    call UnitRemoveAbility(E, 'A1H1')
endif
if GetUnitAbilityLevel(E, 'A0VV')>=1 then                 // Броня бороса
    call UnitRemoveAbility(E, 'A0VV')
endif
if GetUnitAbilityLevel(E, 'A28W')>=1 then                 // Броня бороса
    call UnitRemoveAbility(E, 'A28W')
endif
if GetUnitAbilityLevel(E, 'AcF1')>=1 then                 // F Эйса
    call SaveBoolean(HH,ide,SST,false)
    call ShowAbility2('A315',false)
    call ShowAbility2('A015',true)
    call UnitRemoveAbility(E,'AcF1')
endif
if GetUnitAbilityLevel(E, 'ItV1')>=1 then                 // G itachi
    call SaveBoolean(HH,ide,SST,false)
    call ShowAbility2('A30C',false)
    call ShowAbility2('A00C',true)
    call UnitRemoveAbility(E,'ItV1')
endif
if GetUnitAbilityLevel(E, 'GaT1')>=1 then                 // T Gamma
    call SaveBoolean(HH,ide,SST,false)
    call ShowAbility2('A41C',false)
    call ShowAbility2('A0GV',true)
    call UnitRemoveAbility(E,'GaT1')
endif
if GetUnitAbilityLevel(E, 'MgT1')>=1 then                 // T Magnus
    call SaveBoolean(HH,ide,SST,false)
    call ShowAbility2('A42C',false)
    call ShowAbility2('A15C',true)
    call UnitRemoveAbility(E,'MgT1')
endif
if bPaused then
    call PauseUnit(E,true)
endif
call UnitRemoveAbility(E, 'YatB')
call UnitRemoveAbility(E, 'OniC')
if lvl==0 then
call myCustomDamage(u,E,dmg+0.25*(4+GetUnitAbilityLevel(u,'A1E8'))*GetUnitAbilityLevel(E,'A1EA')*GetHeroAgi(u,true),false,false,null,null,null)
elseif lvl>0 and ri<15 then
call myCustomDamage(u,E,(dmg+0.25*(4+GetUnitAbilityLevel(u,'A1E8'))*GetUnitAbilityLevel(E,'A1EA')*GetHeroAgi(u,true))*1.25,false,false,null,null,null)
elseif lvl>0 and ri>15 then
call myCustomDamage(u,E,dmg+0.25*(4+GetUnitAbilityLevel(u,'A1E8'))*GetUnitAbilityLevel(E,'A1EA')*GetHeroAgi(u,true),false,false,null,null,null)
endif
set n=CreateUnit(p,'e11M',GetUnitX(E),GetUnitY(E),GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,255)
call SetUnitScale(n,1,1,1)
call UnitApplyTimedLife(n,1,0.7)
call SetUnitFlyHeight(n,90,0)
call SetUnitTimeScale(n,2)
endif
call GroupRemoveUnit(G,E)
endloop
call TimerStart(t,0.3,false,function HyperExaliburCast4)
set t=null
set p=null
set u=null
endfunction
function HyperExaliburCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
call SaveBoolean(h,id,5,true)
call SetUnitTimeScale(u,1)
call PauseTimer(t)
call TimerStart(t,0.15,false,function HyperExaliburCast3)
set t=null
set u=null
endfunction
function HyperExaliburCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local real sc=0
local real is=0
local real ig=30*bj_DEGTORAD
local player p=GetOwningPlayer(u)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,x1)
call SaveReal(h,id,2,y1)
call PauseUnit(u,true)
call SetUnitAnimation(u,"Spell Channel Three")
call SetUnitTimeScale(u,0.25)
set n=CreateUnit(p,'e13M',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,255)
call SetUnitTimeScale(n,0.5)
call UnitApplyTimedLife(n,1,4)
loop
exitwhen is>=13
set n=CreateUnit(p,'e0ZH',x+350*Cos(ig*is),y+350*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,255,255,255,55)
call UnitApplyTimedLife(n,1,3)
call SetUnitTimeScale(n,0.5)
set is=is+1
endloop
set n=CreateUnit(p,'e11Q',x,y,GetRandomReal(0,359))
call SetUnitScale(n,4,4,4)
call SetUnitVertexColor(n,75,105,255,255)
call UnitApplyTimedLife(n,1,1.5)
call SetUnitTimeScale(n,1.5)
set n=CreateUnit(p,'e0RV',x,y,a*bj_RADTODEG)
call SetUnitTimeScale(n,0.5)
call UnitApplyTimedLife(n,1,3)
call SetUnitScale(n,1.75,1.75,1.75)
call SetUnitVertexColor(n,255,255,255,180)
call UnitAddAbility(u,'A1E3')
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Heroine_X_EX_Atack.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.8,false,function HyperExaliburCast2)
set t=null
set p=null
set u=null
endfunction
function InitTrig_HyperExalibur takes nothing returns nothing
set gg_trg_HyperExalibur=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_HyperExalibur,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_HyperExalibur,Condition(function HyperExaliburCond))
call TriggerAddAction(gg_trg_HyperExalibur,function HyperExaliburCast)
endfunction
function UranoMetriaCond takes nothing returns boolean
return GetSpellAbilityId()=='A1EX'
endfunction
function UranoMetriaPush2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real a=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real sc=0
local real y=GetUnitY(l__d)
local real dist=LoadReal(h,id,3)
if dist>0 and l__d!=null then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SaveReal(h,id,3,dist-speed)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set t=null
endfunction
function UranoMetriaPush takes unit l__d,real speed,real angle,real dist returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle)
call SaveReal(h,id,3,dist)
call TimerStart(t,0.03,true,function UranoMetriaPush2)
set t=null
endfunction
function MissleMoveUranoMetria2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit l__d=LoadUnitHandle(h,id,2)
local real speed=LoadReal(h,id,4)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)+LoadReal(h,id,3)
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(p)
if SR(x,y,x1,y1)>70 then
set x=x+speed*Cos(a)
set y=y+speed*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
else

call myCustomDamage(LUcy[ip],c,LoadReal(h,id,5),false,false,null,null,null)
call UranoMetriaPush(c,20,a,40)
call UnitApplyTimedLife(CreateUnit(p,0x65304731,x1,y1,GetRandomReal(0,359)),'BHwe',1)
call UnitApplyTimedLife(CreateUnit(p,0x65304732,x1,y1,GetRandomReal(0,359)),'BHwe',1)
call UnitApplyTimedLife(CreateUnit(p,0x65304733,x1,y1,GetRandomReal(0,359)),'BHwe',1)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
call UnitApplyTimedLife(l__d,1,0.01)
endif
set p=null
set l__d=null
set c=null
set t=null
set u=null
endfunction
function MissleMoveUranoMetria takes unit u,unit c,unit l__d,real speed,real angle,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveUnitHandle(h,id,2,l__d)
call SaveReal(h,id,3,angle)
call SaveReal(h,id,4,speed)
call SaveReal(h,id,5,dmg)
call TimerStart(t,0.02,true,function MissleMoveUranoMetria2)
set t=null
endfunction
function UranoMetriaCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local group g=LoadGroupHandle(h,id,3)
local player p=GetOwningPlayer(u)
local real sc=0
local integer ip=GetPlayerId(p)
local integer ur=LoadInteger(h,id,4)
if ur>0 then
call SaveInteger(h,id,4,ur-1)
set n=CreateUnit(p,0x65313444,x+GetRandomReal(-300,300),y+GetRandomReal(-300,300),GetRandomReal(0,359))
call GroupAddUnit(g,n)
call SetUnitVertexColor(n,GetRandomInt(50,255),GetRandomInt(50,255),GetRandomInt(50,255),GetRandomInt(150,255))
set sc=GetRandomReal(0.3,0.9)
call SetUnitScale(n,sc,sc,sc)
call SetUnitFlyHeight(n,GetRandomReal(25,125),0)
else
loop
set E=FirstOfGroup(g)
exitwhen E==null
call MissleMoveUranoMetria(u,c,E,GetRandomReal(25,45),GetRandomReal(-0.25,0.25),GetHeroInt(LUcy[ip],true))
call GroupRemoveUnit(g,E)
endloop
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
if LoadInteger(h,id,2)==1 then




if u==Lucy[ip] then
call PauseUnit(LUcy[ip],false)
call SetUnitInvulnerable(LUcy[ip],false)
else
call PauseUnit(Lucy[ip],false)
call SetUnitInvulnerable(Lucy[ip],false)
endif

endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set p=null
set t=null
set u=null
set c=null
endfunction
function UranoMetriaCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(p)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x2=GetUnitX(c)
local real y2=GetUnitY(c)
local real x1=GetUnitX(Lucy[ip])
local real y1=GetUnitY(Lucy[ip])
local real x3=0
local real y3=0
local real a=Atan2(y2-y,x2-x)
local real sc=0
local real is=0
local real ig=30*bj_DEGTORAD




set n=CreateUnit(p,'e0RV',x,y,0)
call SetUnitTimeScale(n,0.5)
call UnitApplyTimedLife(n,1,2)
call SetUnitScale(n,0.65,0.65,0.65)
call SetUnitVertexColor(n,255,255,255,100)
set n=CreateUnit(p,'e0EX',x,y,0)
call SetUnitTimeScale(n,0.75)
call SetUnitScale(n,2.75,2.75,2.75)
call UnitApplyTimedLife(n,1,2)
loop
exitwhen is==13
set n=CreateUnit(p,'e0ZH',x+350*Cos(ig*is),y+350*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,255,255,255,55)
call UnitApplyTimedLife(n,1,2)
call SetUnitTimeScale(n,0.5)
set is=is+1
endloop
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveGroupHandle(h,id,3,CreateGroup())
call PauseUnit(u,true)
call SetUnitAnimation(u,"spell channel")
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitInvulnerable(u,true)


//call UnitRemoveAbility(LUcy[ip],'LUQ1')
if u==Lucy[ip] then// если кастер клон

set x1=GetUnitX(LUcy[ip])
set y1=GetUnitY(LUcy[ip])
if UnitIsAlive(LUcy[ip]) then
call StartAbilityCooldown(GetUnitAbility(LUcy[ip], 'A1EX'), 35)
endif
if SR(x,y,x1,y1)<1000 and UnitIsAlive(LUcy[ip])  then

call SaveInteger(h,id,2,1)
call PauseUnit(LUcy[ip],true)
call SaveInteger(h,id,4,12)
call SetUnitX(LUcy[ip],x)
call SetUnitY(LUcy[ip],y)
call SetUnitInvulnerable(LUcy[ip],true)
call SetUnitAnimation(Lucy[ip],"spell channel")
call SetUnitFacing(LUcy[ip],a*bj_RADTODEG)



call TimerStart(t,0.1,true,function UranoMetriaCast2)




else
call SaveInteger(h,id,2,0)
call SaveInteger(h,id,4,12)
call TimerStart(t,0.2,true,function UranoMetriaCast2)
endif



else



if UnitIsAlive(Lucy[ip]) then
call StartAbilityCooldown(GetUnitAbility(Lucy[ip], 'A1EX'), 35)
endif





if SR(x,y,x1,y1)<1000 and UnitIsAlive(Lucy[ip])  then
call SaveInteger(h,id,2,1)
call PauseUnit(Lucy[ip],true)
call SaveInteger(h,id,4,12)
call SetUnitX(Lucy[ip],x)
call SetUnitY(Lucy[ip],y)
call SetUnitInvulnerable(Lucy[ip],true)
call SetUnitAnimation(Lucy[ip],"spell channel")
call SetUnitFacing(Lucy[ip],a*bj_RADTODEG)





call TimerStart(t,0.1,true,function UranoMetriaCast2)
else
call SaveInteger(h,id,2,0)
call SaveInteger(h,id,4,12)
call TimerStart(t,0.2,true,function UranoMetriaCast2)
endif

endif


set soundplay=CreateSound("Sound\\Music\\mp3Music\\URANOMETORIA.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
////call KillSoundWhenDone(soundplay)
set p=null
set c=null
set u=null
set t=null
endfunction
function InitTrig_UranoMetria takes nothing returns nothing
set gg_trg_UranoMetria=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_UranoMetria,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_UranoMetria,Condition(function UranoMetriaCond))
call TriggerAddAction(gg_trg_UranoMetria,function UranoMetriaCast)
endfunction
function LucyKozelCond takes nothing returns boolean
return GetSpellAbilityId()=='A1ET'
endfunction
function LucyKozelCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real a=GetUnitFacing(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroInt(u,true)*(3+GetUnitAbilityLevel(u,'A1ET'))
call AtalantaPush(c,50,a*bj_DEGTORAD,350)
call PauseUnit(u,false)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call IssueImmediateOrder(u,"stop")
call SetUnitInvulnerable(u,false)
call myCustomDamage(u,c,dmg,false,false,null,null,null)
set n=CreateUnit(p,'e11I',x,y,a)
call UnitApplyTimedLife(n,1,0.4)
call PauseTimer(t)
call SetUnitTimeScale(u,1)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set u=null
set p=null
set t=null
endfunction
function LucyKozelCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,8)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real a=LoadReal(h,id,3)
local real dist=LoadReal(h,id,2)
local integer i=0
local boolean b=LoadBoolean(h,id,1)
local real sc
local player p=GetOwningPlayer(u)
if dist<1250 and b==false then
set x=x+50*Cos(a)
set y=y+50*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SaveReal(h,id,2,dist+40)
set n=CreateUnit(p,'e117',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,GetRandomInt(10,45))
set sc=GetRandomReal(0.55,1.25)
call SetUnitScale(n,sc,sc,sc)
call UnitApplyTimedLife(n,1,0.4)
call SetUnitTimeScale(n,3)
call GroupEnumUnitsInRange(G,x,y,100,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
if GetWidgetLife(E)>0 then
call SaveUnitHandle(h,id,4,E)
call SaveBoolean(h,id,1,true)
call SaveReal(h,id,2,0)
call SetUnitAnimation(u,"Spell Four")
set n=CreateUnit(p,'e11L',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,0.4)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG-30)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,1,0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+30)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,1,0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,1,0.4)
call SetUnitTimeScale(n,2)
set n=CreateUnit(p,'e0RV',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,3.5)
call SaveUnitHandle(h,id,1,E)
call PauseTimer(t)
call PauseUnit(E,true)
call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,true)
call SetControlToUnit(E,E, 2, "stun")
call TimerStart(t,0.05,false,function LucyKozelCast3)
endif
call GroupClear(G)
endif
call GroupRemoveUnit(G,E)
endloop
else
call PauseTimer(t)
call SetUnitTimeScale(u,1)
call PauseUnit(u,false)
call IssueImmediateOrder(u,"stop")
call SetUnitInvulnerable(u,false)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set u=null
set p=null
set t=null
endfunction
function LucyKozelCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local integer i=1
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,0)
call SaveReal(h,id,3,a)
call SaveBoolean(h,id,1,false)
call PauseUnit(u,true)
call SetUnitAnimation(u,"Spell three")
call SetUnitTimeScale(u,2.5)
set n=CreateUnit(p,'e0ZH',x+155*Cos(a),y+155*Sin(a),a*bj_RADTODEG+180)
call UnitApplyTimedLife(n,1,.8)
call SetUnitVertexColor(n,255,255,255,25)
call SetUnitTimeScale(n,0.5)
call SetUnitScale(n,3,3,3)
set n=CreateUnit(p,'e0SX',x+155*Cos(a),y+155*Sin(a),a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,.8)
call SetUnitTimeScale(n,0.8)
call SetUnitFlyHeight(n,0,0)
call SetUnitFlyHeight(n,250,220)
call SetUnitScale(n,0.7,0.7,0.7)
set n=CreateUnit(p,'e13X',x+155*Cos(a),y+155*Sin(a),a*bj_RADTODEG+90)
call UnitApplyTimedLife(n,1,1.5)
call SetUnitTimeScale(n,0.8)
set n=CreateUnit(p,'e14B',x+155*Cos(a),y+155*Sin(a),a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,1.5)
call SetUnitTimeScale(n,2)
call SetUnitAnimation(n,"spell channel")
call SaveUnitHandle(h,id,8,n)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+45)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,1,0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG-45)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,1,0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,1,0.4)
call SetUnitTimeScale(n,3)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Capricorn.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.01,true,function LucyKozelCast2)
set u=null
set p=null
set t=null
endfunction
