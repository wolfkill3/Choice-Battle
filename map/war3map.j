local real f=GetUnitFacing(l__d)*bj_DEGTORAD
local player p=GetOwningPlayer(u)
local real dmg=GetHeroAgi(u,true)*0.5
local integer l__ide
if speed<30+GetHeroAgi(u,true)*0.1 and udg_B==true and IsUnitType(u,UNIT_TYPE_DEAD)==false and GetUnitAbilityLevel(u,0x4255736C)==0 and GetUnitAbilityLevel(u,0x42557370)==0 and GetUnitAbilityLevel(u,0x42757374)==0 then
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",x,y))
call SetUnitAnimation(l__d,"walk alternate")
if GetLocalPlayer()==p then
call SetTextTagVisibility(tx,true)
endif
call SetTextTagText(tx,I2S(R2I(speed))+" км/ч",0.03)
call SetTextTagPosUnit(tx,l__d,0.03)
call SaveReal(h,id,2,speed+0.15)
call PauseUnit(l__d,false)
call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,false)
call PauseUnit(u,true)
call GroupEnumUnitsInRange(G,x,y,100,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
set l__ide=GetHandleId(E)
if IsUnitEnemy(E,p)and IsUnitType(E,UNIT_TYPE_STRUCTURE)==false and IsUnitInGroup(E,udg_Bike)==false and GetWidgetLife(E)>0 then
if IsUnitBack_Bike(u,E)==false and GetUnitAbilityLevel(l__d,'A073')==0 then
call myCustomDamage(u,E,speed*10+dmg,false,false,null,null,null)
elseif IsUnitBack_Bike(u,E)==true and GetUnitAbilityLevel(l__d,'A073')==0 then
call myCustomDamage(u,E,speed*10*1.3+dmg,false,false,null,null,null)
set n=CreateUnit(GetOwningPlayer(u),0x686D7072,x,y,0)
call IssueTargetOrder(n,"cripple",E)
call UnitApplyTimedLife(n,'B001',1)
elseif IsUnitBack_Bike(u,E)==true and GetUnitAbilityLevel(l__d,'A073')>0 then
call myCustomDamage(u,E,speed*10*1.6+dmg,false,false,null,null,null)
set n=CreateUnit(GetOwningPlayer(u),0x686D7072,x,y,0)
call IssueTargetOrder(n,"cripple",E)
call UnitApplyTimedLife(n,'B001',1)
elseif IsUnitBack_Bike(u,E)==false and GetUnitAbilityLevel(l__d,'A073')>0 then
call myCustomDamage(u,E,speed*10*1.3+dmg,false,false,null,null,null)
endif
set x1=GetUnitX(E)
set y1=GetUnitY(E)
call SaveReal(h,l__ide,0,Atan2(y1-y,x1-x))
call GroupAddUnit(udg_Bike,E)
call DestroyEffect(AddSpecialEffect(" ",x1,y1))
call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",x1,y1))
endif
call GroupRemoveUnit(G,E)
endloop
call ForGroup(udg_Bike,function Trig_Bike_Actions3)
if IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
if GetUnitAbilityLevel(l__d,'A073')>0 then
call SetUnitX(l__d,x+speed*1.25*Cos(f))
call SetUnitY(l__d,y+speed*1.25*Sin(f))
else
call SetUnitX(l__d,x+speed*Cos(f))
call SetUnitY(l__d,y+speed*Sin(f))
endif
call SetUnitFacing(l__d,f)
else
call SetUnitX(l__d,x+10*Cos(f/2))
call SetUnitY(l__d,y+10*Sin(f/2))
endif
else
call SetUnitXY_1(u,x,y, false)
call RemoveUnit(l__d)
call ShowUnit(u,true)
if(GetLocalPlayer()==p)then
call ClearSelection()
call SelectUnit(u,true)
endif
call PauseUnit(u,false)
call DestroyTextTag(tx)
call SetUnitInvulnerable(u,false)
call GroupClear(udg_Bike)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
