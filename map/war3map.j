call UnitApplyTimedLife(n,'BTLF',0.35)
set n=CreateUnit(p,'e0Q2',x,y,(a*bj_RADTODEG))
call UnitApplyTimedLife(n,'BTLF',1)
set n=CreateUnit(p,0x65305133,x,y,(a*bj_RADTODEG))
call UnitApplyTimedLife(n,'BTLF',1)
set n=CreateUnit(p,'e0Q4',x,y,(a*bj_RADTODEG))
