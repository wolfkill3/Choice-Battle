function QKiyoCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,1300)
call SaveReal(h,id,2,a)
call SaveReal(h,id,3,0)
call SaveBoolean(h,id,4,false)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\KiyohimeQ.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call SetUnitAnimation(u,"Spell One")
call SetUnitTimeScale(u,2)
call UnitAddAbility(u,'Ao4G')
call TimerStart(t,0.3,false,function QKiyoCast2)
set u=null
set t=null
set p=null
endfunction
