function SuperFreezeArrowCond takes nothing returns boolean
return GetSpellAbilityId()=='A0XO' and udg_B==true
endfunction

function GrayR_Freezing_Periodic takes nothing returns nothing
        local integer id=  GetHandleId(GetExpiredTimer())
        local unit target= LoadUnitHandle(h, id, TargetHash)
        local real time=   LoadReal(h, id, TIME_HASH)+0.01
        local real angle=  LoadReal(h, id, AngleHash)
        if target!=null and time<=2.0 and udg_B then
                call IssueImmediateOrder(target, "stop")
                call SaveReal(h, id, TIME_HASH, time)
                set n=LoadUnitHandle(h, id, Dummy1Hash)
                call SetUnitX(n, GetUnitX(target))
                call SetUnitY(n, GetUnitY(target))
                set n=LoadUnitHandle(h, id, Dummy2Hash)
                call SetUnitX(n, GetUnitX(target))
                call SetUnitY(n, GetUnitY(target))
        else
                set n=LoadUnitHandle(h, id, Dummy1Hash)
                call KillUnit(n)
                call MyRemoveUnit(n, 1.5)
                set n=LoadUnitHandle(h, id, Dummy2Hash)
                call KillUnit(n)
                call MyRemoveUnit(n, 1.5)
                call FlushChildHashtable(h, id)
                call DestroyTimer(GetExpiredTimer())
        endif
        set target=null
endfunction

function GrayR_Freezing takes unit newCaster, unit newTarget, timer newTimer returns nothing
        local integer id=GetHandleId(newTimer)
        local real angle=AU(newCaster, newTarget)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH71', GetUnitX(newTarget)+50*Cos(angle), GetUnitY(newTarget)+50*Sin(angle), angle*bj_RADTODEG)
        call SetUnitVertexColor(n, 233, 90, 255, 255)
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call SetUnitFlyHeight(n, 100, 0)
        call SetUnitAnimation(n, "stand - "+I2S(GetRandomInt(1, 2)))
        call SaveUnitHandle(h, id, Dummy1Hash, n)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH71', GetUnitX(newTarget)-50*Cos(angle), GetUnitY(newTarget)-50*Sin(angle), angle*bj_RADTODEG+180)
        call SetUnitVertexColor(n, 233, 90, 255, 255)
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call SetUnitFlyHeight(n, 100, 0)
        call SetUnitAnimation(n, "stand - "+I2S(GetRandomInt(1, 2)))
        call SaveUnitHandle(h, id, Dummy2Hash, n)
        call SaveUnitHandle(h, id, TargetHash, newTarget)
        call SaveReal(h, id, AngleHash, angle)
        call TimerStart(newTimer, 0.01, true, function GrayR_Freezing_Periodic)
endfunction

function SuperFreezeArrowCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local unit c=LoadUnitHandle(h,id,20)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local real dmg=LoadReal(h,id,40)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,12)
local integer l__idg=GetHandleId(g)
local boolean mod=LoadBoolean(h, id, SH_BooleanMod)
if SR(x,y,x1,y1)>80 then
        if mod then
                call SetUnitX(l__d,x+75*Cos(a))
                call SetUnitY(l__d,y+75*Sin(a))
        else
                call SetUnitX(l__d,x+55*Cos(a))
                call SetUnitY(l__d,y+55*Sin(a))
        endif
        call SetUnitFacing(l__d, a*bj_RADTODEG)
        set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',0.01)
        call SetUnitVertexColor(n,25,100,255,50)
        if mod then
                call SetUnitVertexColor(n,200,150,255,100)
        endif
        set n=CreateUnit(p,'e0UI',x,y,a*bj_RADTODEG)
        call UnitApplyTimedLife(n,'BTLF',0.1)
        call SetUnitVertexColor(n,50,100,255,125)
        if mod then
                call SetUnitVertexColor(n,200,150,255,100)
        endif
else
        call GroupEnumUnitsInRange(g,x1,y1,450,Base)
        loop
        set E=FirstOfGroup(g)
        set ide=GetHandleId(E)
        if Condition_Base(p,E)and LoadUnitHandle(h,l__idg,ide)!=E then
                call myCustomDamage(u,E,dmg,false,false,null,null,null)
                call SaveUnitHandle(h,l__idg,ide,E)
        endif
        call GroupRemoveUnit(g,E)
        exitwhen E==null
        endloop
        call UnitApplyTimedLife(CreateUnit(p,'e0UL',x,y,0),'BTLF',3)
        call UnitApplyTimedLife(CreateUnit(p,'e0UN',x,y,0),'BTLF',3)
        call UnitApplyTimedLife(CreateUnit(p,'e0UG',x,y,0),'BTLF',3)
        call UnitApplyTimedLife(CreateUnit(p,'e0UF',x,y,(a*bj_RADTODEG)),'BTLF',3)
        call UnitApplyTimedLife(CreateUnit(p,'e0UE',x,y,(a*bj_RADTODEG)),'BTLF',3)
        call UnitApplyTimedLife(CreateUnit(p,'e0UG',x,y,(a*bj_RADTODEG)),'BTLF',3)
        call UnitApplyTimedLife(CreateUnit(p,'e0UH',x,y,(a*bj_RADTODEG)),'BTLF',3)
        call UnitApplyTimedLife(CreateUnit(p,'e052',x,y,0),'BTLF',3)
        call UnitApplyTimedLife(CreateUnit(p,'e053',x,y,0),'BTLF',5)
        call UnitApplyTimedLife(CreateUnit(p,'e053',x,y,0),'BTLF',5)
        call UnitApplyTimedLife(CreateUnit(p,'e054',x,y,0),'BTLF',3)
        set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',0.01)
        call SetUnitScale(n,1.2,1.2,1.2)
        call SetUnitTimeScale(n,0.6)
        call SetUnitVertexColor(n,25,100,255,50)
        set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',0.01)
        call SetUnitScale(n,1.5,1.5,1.5)
        call SetUnitTimeScale(n,0.6)
        call SetUnitVertexColor(n,25,100,255,50)
        set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',0.01)
        call SetUnitScale(n,1.7,1.7,1.7)
        call SetUnitTimeScale(n,0.6)
        call SetUnitVertexColor(n,25,100,255,50)
        set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',0.01)
        call SetUnitScale(n,1.9,1.9,1.9)
        call SetUnitTimeScale(n,0.6)
        call SetUnitVertexColor(n,25,200,255,50)
        if LoadBoolean(h, id, SH_BooleanMod) then
                //call GrayR_Freezing(u, c, CreateTimer())
        call SetControlToUnit(u,c,2,"stun")
        set n=CreateUnit(p, 'dH71', x1+50*Cos(a), y1+50*Sin(a), a*bj_RADTODEG)
        call SetUnitVertexColor(n, 233, 90, 255, 255)
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call UnitApplyTimedLife(n,'BTLF',1.5)
        call SetUnitFlyHeight(n, 100, 0)
        call SetUnitAnimation(n, "stand - "+I2S(GetRandomInt(1, 2)))
        set n=CreateUnit(p, 'dH71', x1-50*Cos(a), y1-50*Sin(a), a*bj_RADTODEG+180)
        call SetUnitVertexColor(n, 233, 90, 255, 255)
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call UnitApplyTimedLife(n,'BTLF',1.5)
        call SetUnitFlyHeight(n, 100, 0)
        call SetUnitAnimation(n, "stand - "+I2S(GetRandomInt(1, 2)))
        endif
        call RemoveUnit(l__d)
        call SetUnitTimeScale(u,1)
        // call PauseUnit(u,false)
        // call SetUnitInvulnerable(u,false)
        call FlushChildHashtable(h,GetHandleId(g))
        call DestroyGroup(g)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
endif
set c=null
set g=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
function SuperFreezeArrowCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,20)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real dmg=LoadReal(h,id,4)
local real dist=LoadReal(h,id,2)
local real scale=LoadReal(h,id,10)
local real tm=GetWidgetMana(u)
local real time=LoadReal(h,id,17)
local boolean mod=LoadBoolean(h, id, SH_BooleanMod)
if time>0 then
        if GetUnitTypeId(u)=='h06V' then
                call SetUnitAnimation(u,"Spell Slam One")
        endif
        call SetUnitFacing(u,a*bj_RADTODEG)
        set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',0.01)
        call SetUnitScale(n,0.65,0.65,0.65)
        call SetUnitVertexColor(n,25,150,255,50)
        if mod then
                call SetUnitVertexColor(n,200,150,255,100)
        endif
        set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',0.01)
        call SetUnitScale(n,1,1,1)
        call SetUnitVertexColor(n,25,150,255,40)
        if mod then
                call SetUnitVertexColor(n,200,150,255,100)
        endif
        set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',0.01)
        call SetUnitScale(n,1.65,1.65,1.65)
        call SetUnitVertexColor(n,25,150,255,30)
        if mod then
                call SetUnitVertexColor(n,200,150,255,100)
        endif
        set n=CreateUnit(p,'e0RR',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',0.01)
        call SetUnitVertexColor(n,50,150,255,50)
        if mod then
                call SetUnitVertexColor(n,200,150,255,100)
        endif
        call SaveReal(h,id,17,time-0.1)
else
        call PauseUnit(u,false)
        call SetUnitInvulnerable(u,false)
        call SetUnitTimeScale(u,1)
        set bjLCU=CreateUnit(p,'e0UO',x+100*Cos(a),y+100*Sin(a),a*bj_RADTODEG)
        if mod then
                call SetUnitVertexColor(bjLCU, 200, 50, 255, 255)
        endif
        call SaveUnitHandle(h,id,7,bjLCU)
        call UnitApplyTimedLife(CreateUnit(p,'e0UJ',x+100*Cos(a),y+100*Sin(a),(a*bj_RADTODEG)),'BTLF',3)
        call PauseTimer(t)
        call UnitRemoveAbility(u,'A0XP')
        call TimerStart(t,0.02,true,function SuperFreezeArrowCast3)
endif
set c=null
set p=null
set u=null
set t=null
endfunction
function SuperFreezeArrowCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local real ang=150*bj_DEGTORAD
local real dmg=(GetUnitAbilityLevel(u,'A0XO')+4)*GetHeroInt(u,true)
if GetUnitAbilityLevel(u,'B06U')>0 then
        set dmg=dmg+2*GetHeroAgi(u,true)
        call SaveReal(h,id,17,1.3)
        call SaveBoolean(h, id, SH_BooleanMod, true)
        set soundplay=SndN(2140) // Sound\war3mapImported\Gray_R_Mod.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
        set soundplay=SndN(2142) // Sound\Music\mp3Music\SuperFreezeArrow.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        call SaveReal(h,id,17,2.2)
        call SaveBoolean(h, id, SH_BooleanMod, false)
endif
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,5,x1)
call SaveReal(h,id,6,y1)
call SaveReal(h,id,40,dmg)
call SaveReal(h,id,2,2700)
call SaveReal(h,id,10,1.25)
call SaveUnitHandle(h,id,20,c)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SaveGroupHandle(h,id,12,CreateGroup())
if GetUnitTypeId(u)=='h04L' then
call UnitAddAbility(u,'A0XP')
call SetUnitAnimation(u,"Spell Five")
elseif GetUnitTypeId(u)=='h06V' then
call SetUnitAnimation(u,"Spell Slam One")
endif
call TimerStart(t,0.1,true,function SuperFreezeArrowCast2)
set u=null
set p=null
set c=null
set t=null
endfunction
function InitTrig_SuperFreezeArrow takes nothing returns nothing
set gg_trg_SuperFreezeArrow=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_SuperFreezeArrow,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_SuperFreezeArrow,Condition(function SuperFreezeArrowCond))
call TriggerAddAction(gg_trg_SuperFreezeArrow,function SuperFreezeArrowCast)
endfunction
function OneSidedChaoticDanceCond takes nothing returns boolean
return GetSpellAbilityId()=='A0XR' and udg_B==true
endfunction
function OneSidedChaoticDanceMissleFly2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
local real dist=LoadReal(h,id,6)
local real mh=LoadReal(h,id,5)
local real rad=LoadReal(h,id,7)
local real rd=SR(x,y,x1,y1)
local real dmg=LoadReal(h,id,8)
local player p=GetOwningPlayer(l__d)
local integer idu=GetPlayerId(p)
local real cof=rd/dist
if rd>speed+40 then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SaveReal(h,id,1,speed*1.06)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,mh*cof+50,0)
else
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set l__d=null
set t=null
endfunction
function OneSidedChaoticDanceMissleFly takes unit l__d,real speed,real angle,real x,real y,real mh,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,mh)
call SaveReal(h,id,6,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,8,dmg)
call TimerStart(t,0.03,true,function OneSidedChaoticDanceMissleFly2)
set t=null
endfunction
