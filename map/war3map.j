function Trig_Dark_Candels_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,2)
local real x=LoadReal(h,id,0)
local real y=LoadReal(h,id,1)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real a=Atan2(y1-y,x1-x)
local lightning l=LoadLightningHandle(h,id,3)
if GetUnitAbilityLevel(u,'B01L')>0 and GetWidgetLife(u)>0 and udg_B and DU2 then
call MoveLightningEx(l,false,x,y,50,x1,y1,GetUnitZ10(u)+50)
if SR(x,y,x1,y1)>400 then
call SetUnitX(u,x+400*Cos(a))
call SetUnitY(u,y+400*Sin(a))
endif
else
call DestroyLightning(l)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l=null
set t=null
set u=null
endfunction
function Trig_Dark_Candels_Actions takes nothing returns nothing
local unit c=GetSpellTargetUnit()
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local timer t
local integer id
if GetUnitAbilityLevel(c,'A15H')==0 then
    set t=CreateTimer()
    set id=GetHandleId(t)
    set bj_lastCreatedLightning=AddLightningEx("FORK",false,x,y,50.,x1,y1,GetUnitZ10(c)+50.)
    call SetLightningColor(bj_lastCreatedLightning,127,0,130,100)
    call ComboChecker(c,4,6, false )
    call SaveReal(h,id,0,x1)
    call SaveReal(h,id,1,y1)
    call SaveUnitHandle(h,id,2,c)
    call SaveLightningHandle(h,id,3,bj_lastCreatedLightning)
    call TimerStart(t,0.05,true,function Trig_Dark_Candels_Actions2)
else
    call DisplayTimedWarningMessage(GetOwningPlayer(GetTriggerUnit()),10,"Нельзя использовать на врага под эффектом Imagine Breaker.")
    call IssueImmediateOrder(GetTriggerUnit(),"stop")
endif
set t=null
set c=null
endfunction
