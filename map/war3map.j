function MesHeartKillCond takes nothing returns boolean
return GetUnitTypeId(GetTriggerUnit())==0x68303251 and udg_B
endfunction
function MesHeartKillAct takes nothing returns nothing
local unit u=GetKillingUnit()
local unit c=GetTriggerUnit()
local integer idc=GetPlayerId(GetOwningPlayer(c))
local integer idu=GetPlayerId(GetOwningPlayer(u))
if u!=null then
	call SaveBoolean(h,GetHandleId(c),StringHash("cond"),true)
	call SetUnitInvulnerable(Hero[idc],false)
	call UnitRemoveBuffs(Hero[idc],true,false)
    if UnitHasItemOfTypeBJ(Hero[idc], 'I03A') and GetWidgetLife(Hero[idc])>0 and IsUnitIllusion(Hero[idc])==false then
        set AlastorPos=0
        loop
        exitwhen AlastorPos==6 or GetItemTypeId(UnitItemInSlot(Hero[idc],AlastorPos)) == 'I03A'
        set AlastorPos=AlastorPos+1
        endloop
        if IsAbilityEnabled(GetUnitAbility(Hero[idc],'AInv'))==true then
            set Alastor=GetItemOfTypeFromUnitBJ(Hero[idc],'I03A')
            call UnitRemoveItem(Hero[idc],Alastor)
            call RemoveItem(Alastor)
            call UnitAddItemToSlotById(Hero[idc], 'I03A',AlastorPos)
        else
            call EnableUnitAbility2(Hero[idc],'AInv',false,true)
            set Alastor=GetItemOfTypeFromUnitBJ(Hero[idc],'I03A')
            call UnitRemoveItem(Hero[idc],Alastor)
            call RemoveItem(Alastor)
            call UnitAddItemToSlotById(Hero[idc], 'I03A',AlastorPos)    
            call DisableUnitAbility2(Hero[idc],'AInv',false,true)
        endif
    endif
	call UnitAddAbility(Hero[idc],'A0WR')
	if GetUnitAbilityLevel(Hero[idc],'A18L')==0 then
        call CustomTrueDamage(u,Hero[idc], GetWidgetMaxLife(Hero[idc])*0.4)
	else
		call UnitRemoveAbility(Hero[idc],'A18L')
		call UnitRemoveAbility(Hero[idc],'A0WR')
		call SetUnitState(Hero[idc],UNIT_STATE_LIFE,1)
		call SetUnitState(Hero[idc],UNIT_STATE_MANA,0)
		call myCustomDamage(u,Hero[idc],100,false,false,null,null,null)
        call DamageIndicatorFunction(u, Hero[idc], GetWidgetMaxLife(Hero[idc])*0.4)
        call DamageTextTag(u, Hero[idc], GetWidgetMaxLife(Hero[idc])*0.4)
	endif
	call UnitRemoveAbility(Hero[idc],'A0WR')
endif
call RemoveSavedHandle(h,GetHandleId(u),StringHash("h"))
set u=null
set c=null
endfunction
