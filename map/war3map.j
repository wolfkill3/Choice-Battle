endfunction
function Trig_AngelWings_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local item it=GetManipulatedItem()
local integer id=GetPlayerId(GetTriggerPlayer())
local integer i=0
local integer count=0
if udg_kill[GetPlayerId(GetTriggerPlayer())]<15 then
call RemoveItem(it)
call SetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD)+1500)
call DisplayTextToPlayer(Player(id),0,0,Lng("Недостаточно убийств","Not enough kills"))
set soundplay=SndN(816) // UareNotPrepared.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
loop
exitwhen i>=10
if GetItemTypeId(UnitItemInSlot(u,i))=='I030' then
set count=count+1
endif
set i=i+1
endloop
if count>1 then
call RemoveItem(it)
call SetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD)+1500)
call DisplayTextToPlayer(Player(id),0,0,Lng("Нельзя иметь больше одного такого предмета!","You can't have more than one of these items!"))
endif
endif
set u=null
set it=null
endfunction
