local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x2=GetUnitX(c)
local real y2=GetUnitY(c)
local player p=GetOwningPlayer(u)
local real a=Atan2(y2-y,x2-x)

local integer lvl3=GetUnitAbilityLevel(u,'A1EC')
local integer ri=GetRandomInt(0,100)
if lvl3>0 and ri<=15 then

if (GetLocalPlayer()==GetOwningPlayer(u)) then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"Crit")
endif

call SaveBoolean(h,id,16,true)
else
call SaveBoolean(h,id,16,false)
endif










call SaveReal(h,id,2,0)
call PauseTimer(t)
call TimerStart(t,0.4,true,function BusterAttackCast4)
set u=null
set t=null
set p=null
set c=null
endfunction
function BusterAttackCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local real x2=GetUnitX(c)
local real y2=GetUnitY(c)
local real f=GetUnitFacing(u)
local player p=GetOwningPlayer(u)
local real dist=SR(x,y,x2,y2)
local real a=Atan2(y2-y,x2-x)
local real he=0
local real he2=GetUnitFlyHeight(u)
local real sc=0
local real is=0
local real ig=30*bj_DEGTORAD
if dist>150.00 then
call SetUnitX(u,x+(55-he2*0.05)*Cos(a))
call SetUnitY(u,y+(55-he2*0.05)*Sin(a))
call SetUnitFacing(u,a*bj_RADTODEG)
set he=ParabolaZ(600,SR(x1,y1,x2,y2),dist)
call SetUnitFlyHeight(u,he,0)
set n=CreateUnit(p,'e10G',x,y,a*bj_RADTODEG+90)
call UnitApplyTimedLife(n,'BTLF',0.10)
call SetUnitVertexColor(n,75,155,255,255)
call SetUnitScale(n,1,1,1)
call SetUnitFlyHeight(n,he,0)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e10G',x,y,a*bj_RADTODEG+90)
call UnitApplyTimedLife(n,'BTLF',0.10)
call SetUnitVertexColor(n,75,155,255,255)
call SetUnitScale(n,0.75,0.75,0.75)
call SetUnitFlyHeight(n,he,0)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e10G',x,y,a*bj_RADTODEG+90)
call UnitApplyTimedLife(n,'BTLF',0.10)
call SetUnitVertexColor(n,75,155,255,255)
call SetUnitScale(n,0.5,0.5,0.5)
call SetUnitFlyHeight(n,he,0)
call SetUnitTimeScale(n,3)
else
    if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
        set n=CreateUnit(p,'e11S',x,y,a*bj_RADTODEG)
        call SetUnitVertexColor(n,255,255,255,155)
        call UnitApplyTimedLife(n,'BTLF',2)
        call SetUnitScale(n,8,8,8)
        call SetUnitTimeScale(n,0.5)
        set n=CreateUnit(p,'e13O',x,y,a*bj_RADTODEG)
        call SetUnitVertexColor(n,255,255,255,155)
        call UnitApplyTimedLife(n,'BTLF',2)
        call SetUnitScale(n,1,1,1)
        call SetUnitTimeScale(n,2)
        loop
        exitwhen is>=13
        set n=CreateUnit(p,'e0ZH',x2+350*Cos(ig*is),y2+350*Sin(ig*is),180+is*30)
        call SetUnitVertexColor(n,255,255,255,55)
        call UnitApplyTimedLife(n,'BTLF',3)
        call SetUnitTimeScale(n,0.5)
        set is=is+1
        endloop
        set n=CreateUnit(p,'e0RV',x2,y2,a*bj_RADTODEG)
        call SetUnitTimeScale(n,0.5)
        call UnitApplyTimedLife(n,'BTLF',3)
        call SetUnitScale(n,1.75,1.75,1.75)
        call SetUnitVertexColor(n,255,255,255,180)
        call SetUnitTimeScale(u,1.5)
        call SetUnitFlyHeight(u,0,0)
        call PauseUnit(c,true)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
        call PauseTimer(t)
        call SaveReal(h,id,5,0.1)
        call SetUnitAnimation(u,"Spell One")
        call TimerStart(t,0.2,false,function BusterAttackCast3)
    else
        call UnitRemoveAbility(u,'A1E2')
        call PauseTimer(t)
        call PauseUnit(u,false)
        call SetUnitInvulnerable(u,false)
        call PauseUnit(c,false)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
        call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
        call SetUnitInvulnerable(c,false)
        call SetUnitTimeScale(u,1)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
    endif
endif
set c=null
set u=null
set t=null
set p=null
endfunction
function BusterAttackCast takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real f=GetUnitFacing(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
call DestroyEffect(AddSpecialEffect("war3mapImported\\TealSlam.mdl",x,y))
call PauseUnit(u,true)
call UnitAddAbility(u,'Arav')
call UnitRemoveAbility(u,'Arav')
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SetUnitInvulnerable(u,true)
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveReal(h,id,4,SR(x,y,x1,y1))
call SaveReal(h,id,5,0.1)
call SetUnitAnimation(u,"Spell Channel One")
call SetUnitTimeScale(u,2)
call UnitAddAbility(u,'A1E2')
set soundplay=SndN(2775) // Sound\Music\mp3Music\Heroine_X_attackselect2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.018,true,function BusterAttackCast2)
set u=null
set t=null
set c=null
endfunction
function InitTrig_BusterAttack takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function BusterAttackCond))
call TriggerAddAction(t,function BusterAttackCast)
set t=null
endfunction
function HyperExaliburCond takes nothing returns boolean
return GetSpellAbilityId()=='A1E8'
endfunction
function HyperExaliburCast4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
call SetUnitTimeScale(u,1)
call PauseUnit(u,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call UnitRemoveAbility(u,'A1E3')
set t=null
set u=null
endfunction
function HyperExaliburCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,1)
local real y1=LoadReal(h,id,2)
local real x2=0
local real y2=0
local real x3=0
local real y3=0
local real a2=0
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real dmg=(4+GetUnitAbilityLevel(u,'A1E8'))*GetHeroAgi(u,true)
local real sc=0
local real is=0
local real ig=20*bj_DEGTORAD
local integer ri=GetRandomInt(0,100)
local integer lvl=GetUnitAbilityLevel(u,'A1EC')
local boolean bPaused=false
set x1=x+700*Cos(a)
set y1=y+700*Sin(a)
set x2=x+500*Cos(a)
set y2=y+500*Sin(a)
set n=CreateUnit(p,'e11Q',x1,y1,GetRandomReal(0,359))
call SetUnitScale(n,6,6,6)
call SetUnitVertexColor(n,75,105,255,255)
call UnitApplyTimedLife(n,'BTLF',1.5)
call SetUnitTimeScale(n,1.5)
loop
exitwhen is==13
set x3=x1+650*Cos(a-240*bj_DEGTORAD-ig*is)
set y3=y1+650*Sin(a-240*bj_DEGTORAD-ig*is)
set a2=Atan2(y3-y,x3-x)
set n=CreateUnit(p,'e0ZH',x3,y3,180+a2*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,75)
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitScale(n,3,3,3)
call SetUnitTimeScale(n,0.5)
set x3=x1+450*Cos(a-240*bj_DEGTORAD-ig*is)
set y3=y1+450*Sin(a-240*bj_DEGTORAD-ig*is)
set a2=Atan2(y3-y,x3-x)
set n=CreateUnit(p,'e0ZH',x3,y3,180+a2*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,75)
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitScale(n,2,2,2)
call SetUnitTimeScale(n,0.5)
set x3=x1+250*Cos(a-240*bj_DEGTORAD-ig*is)
set y3=y1+250*Sin(a-240*bj_DEGTORAD-ig*is)
set a2=Atan2(y3-y,x3-x)
set n=CreateUnit(p,'e0ZH',x3,y3,180+a2*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,75)
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitScale(n,1,1,1)
call SetUnitTimeScale(n,0.5)
set is=is+1
endloop
call GroupEnumUnitsInRange(G,x1,y1,900,Base)
loop
set E=FirstOfGroup(G)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E) and GetUnitTypeId( E )!='or01' and GetUnitTypeId( E )!='or02' and udg_B then
set bPaused=false
if IsUnitPaused(E) then
    set bPaused=true
    call PauseUnit(E, false)
endif
call IssueImmediateOrder(E,"manashieldoff")
call IssueImmediateOrder(E,"unimmolation")
call UnitRemoveAbility(E,'A1GL')
call UnitRemoveAbility(E,'WAE1')
call UnitRemoveAbility(E,'A1WT')
call UnitRemoveBuffs(E,true,false)
if UnitHasItemOfTypeBJCustom(E, 'I03A') and GetWidgetLife(E)>0 and IsUnitIllusion(E)==false then
    set AlastorPos=0
    loop
    exitwhen AlastorPos==10 or GetItemTypeId(UnitItemInSlot(E,AlastorPos)) == 'I03A'
    set AlastorPos=AlastorPos+1
    endloop
    if IsAbilityEnabled(GetUnitAbility(E,'AInv'))==true then
        set Alastor=GetItemOfTypeFromUnitBJCustom(E,'I03A')
        call UnitRemoveItem(E,Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(E, 'I03A',AlastorPos)
    else
        call EnableUnitAbility2(E,'AInv',false,true)
        set Alastor=GetItemOfTypeFromUnitBJCustom(E,'I03A')
        call UnitRemoveItem(E,Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(E, 'I03A',AlastorPos)    
        call DisableUnitAbility2(E,'AInv',false,true)
    endif
endif
call UnitAddItemById(E,'I06B')
if LoadReal(h, ide, SH_ShieldBelfF)>0 then   // Щит Бельфегора
    call SaveReal(h, ide, SH_ShieldBelfF, 0)
else
    call SaveReal(h, ide, SH_ShieldBelfF, 0)
    call RemoveSavedReal(h, ide, SH_ShieldBelfF)
endif
if LoadReal(h, ide, SH_YujiE_Shield)>0 then  // Щит Юджи
    call SaveReal(h, ide, SH_YujiE_Shield, 0)
else
    call RemoveSavedReal(h, ide, SH_YujiE_Shield)
endif
if GetUnitAbilityLevel(E,'A1DF')>=1 then                  // Щит Шилдер Q
    call UnitRemoveAbility(E,'A1DF')
    call SaveReal(h,ide, SH_shi1, 0)
    call SaveReal(h,ide, SH_shi2, 0)
endif
if GetUnitAbilityLevel(E,'A1DG')>=1 then                  // Щит Шилдер E
    call UnitRemoveAbility(E, 'A1DG')
endif
if GetUnitAbilityLevel(E,'A10G')>=1 then                  // Щит Луизы
    call UnitRemoveAbility(E, 'A10G')
endif
if GetUnitAbilityLevel(E, 'A2DF')>0 then                      // Щит Броли
    call SaveReal(h,ide,SH_BroEtime,9)
endif
if GetUnitAbilityLevel(E, 'A0VJ')>0 then                  // Гроза Вонголы
    call UnitRemoveAbility(E, 'A0VJ')
endif
if GetUnitAbilityLevel(E, 'A1HG')>0 then                  // Щит Орехи
    call UnitRemoveAbility(E, 'A1HG')
endif
if GetUnitAbilityLevel(E, 'A3DF')>0 then                  // Щит Waver
    call UnitRemoveAbility(E, 'A3DF')
endif
if GetUnitAbilityLevel(E, 'A1H1')>=1 then                 // Щит от Ульты Жанны Рулер
    call UnitRemoveAbility(E, 'A1H1')
endif
if GetUnitAbilityLevel(E, 'A0VV')>=1 then                 // Броня бороса
    call UnitRemoveAbility(E, 'A0VV')
endif
if GetUnitAbilityLevel(E, 'A28W')>=1 then                 // Броня бороса
    call UnitRemoveAbility(E, 'A28W')
endif
if GetUnitAbilityLevel(E, 'AcF1')>=1 then                 // F Эйса
    call SaveBoolean(HH,ide,SST,false)
    call ShowAbility2('A315',false)
    call ShowAbility2('A015',true)
    call UnitRemoveAbility(E,'AcF1')
endif
if GetUnitAbilityLevel(E, 'ItV1')>=1 then                 // G itachi
    call SaveBoolean(HH,ide, SST ,false)
    call ShowAbility2('A30C',false)
    call ShowAbility2('A00C',true)
    call UnitRemoveAbility(E,'ItV1')
endif
if GetUnitAbilityLevel(E, 'GaT1')>=1 then                 // T Gamma
    call SaveBoolean(HH,ide, SST ,false)
    call ShowAbility2('A41C',false)
    call ShowAbility2('A0GV',true)
    call UnitRemoveAbility(E,'GaT1')
endif
if GetUnitAbilityLevel(E, 'MgT1')>=1 then                 // T Magnus
    call SaveBoolean(HH,ide, SST ,false)
    call ShowAbility2('A42C',false)
    call ShowAbility2('A15C',true)
    call UnitRemoveAbility(E,'MgT1')
endif
if GetUnitAbilityLevel(E,'SiTS')>=1 then                 // Щит P Сигнум Tank Spirit
    call UnitRemoveAbility(E,'SiTS')
endif



if bPaused then
    call PauseUnit(E, true)
endif
call UnitRemoveAbility(E, 'YatB')
call UnitRemoveAbility(E, 'OniC')





if LoadBoolean(h,id,16)==true then

call myCustomDamage(u,E,(dmg+0.15*(4+GetUnitAbilityLevel(u,'A1E8'))*GetUnitAbilityLevel(E,'A1EA')*GetHeroAgi(u,true)+0.15*(4+GetUnitAbilityLevel(u,'A1E8'))*GetUnitAbilityLevel(E,'A1EB')*GetHeroAgi(u,true))*1.25,false,false,null,null,null)

else

call myCustomDamage(u,E,dmg+0.15*(4+GetUnitAbilityLevel(u,'A1E8'))*GetUnitAbilityLevel(E,'A1EA')*GetHeroAgi(u,true)+0.15*(4+GetUnitAbilityLevel(u,'A1E8'))*GetUnitAbilityLevel(E,'A1EB')*GetHeroAgi(u,true),false,false,null,null,null)
       

endif

if LoadInteger(HH, GetHandleId( GetOwningPlayer( u ) ) ,SH_HerKill)>=10 then
call UnitAddAbility(E,'HerR')
call UnitRemoveAbility(E,'HerR')
endif


if GetUnitAbilityLevel(E,'A1EA')>0 then
  call SaveUnitHandle(HH,GetHandleId( u ),SH_HerFU,E)
endif



set n=CreateUnit(p,'e11M',GetUnitX(E),GetUnitY(E),GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,255)
call SetUnitScale(n,1,1,1)
call UnitApplyTimedLife(n,'BTLF',0.7)
call SetUnitFlyHeight(n,90,0)
call SetUnitTimeScale(n,2)
endif
call GroupRemoveUnit(G,E)
endloop
call TimerStart(t,0.3,false,function HyperExaliburCast4)
set t=null
set p=null
set u=null
endfunction
function HyperExaliburCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local integer lvl3=GetUnitAbilityLevel(u,'A1EC')
local integer ri=GetRandomInt(0,100)
call SaveBoolean(h,id,5,true)



if lvl3>0 and ri<=15 then

if (GetLocalPlayer()==GetOwningPlayer(u)) then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"Crit")
endif

call SaveBoolean(h,id,16,true)
else
call SaveBoolean(h,id,16,false)
endif


call SetUnitTimeScale(u,1)
call PauseTimer(t)



call TimerStart(t,0.15,false,function HyperExaliburCast3)
set t=null
set u=null
endfunction
function HyperExaliburCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local real sc=0
local real is=0
local real ig=30*bj_DEGTORAD
local player p=GetOwningPlayer(u)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,x1)
call SaveReal(h,id,2,y1)
call PauseUnit(u,true)
call SetUnitAnimation(u,"Spell Channel Three")
call SetUnitTimeScale(u,0.25)
set n=CreateUnit(p,'e13M',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,255)
call SetUnitTimeScale(n,0.5)
call UnitApplyTimedLife(n,'BTLF',4)
loop
exitwhen is==13
set n=CreateUnit(p,'e0ZH',x+350*Cos(ig*is),y+350*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,255,255,255,55)
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.5)
set is=is+1
endloop
set n=CreateUnit(p,'e11Q',x,y,GetRandomReal(0,359))
call SetUnitScale(n,4,4,4)
call SetUnitVertexColor(n,75,105,255,255)
call UnitApplyTimedLife(n,'BTLF',1.5)
call SetUnitTimeScale(n,1.5)
set n=CreateUnit(p,'e0RV',x,y,a*bj_RADTODEG)
call SetUnitTimeScale(n,0.5)
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitScale(n,1.75,1.75,1.75)
call SetUnitVertexColor(n,255,255,255,180)
call UnitAddAbility(u,'A1E3')
set soundplay=SndN(2777) // Sound\Music\mp3Music\Heroine_X_EX_Atack.mp3
call StartSound(soundplay)
////call KillSoundWhenDone(soundplay)
call TimerStart(t,0.8,false,function HyperExaliburCast2)
set t=null
set p=null
set u=null
endfunction
function InitTrig_HyperExalibur takes nothing returns nothing
set gg_trg_HyperExalibur=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_HyperExalibur,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_HyperExalibur,Condition(function HyperExaliburCond))
call TriggerAddAction(gg_trg_HyperExalibur,function HyperExaliburCast)
endfunction
//heroinex2start

function DamageAoeOneTimeHeroine takes unit damager,real x0,real y0,real range,real damage,group gr1 returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local real damage_saber=0
local real damage_plus=0
local real damage0=damage
local boolean CritProc=LoadBoolean(HH,id,16)
call GroupClear(G)
call GroupEnumUnitsInRange(G,x0,y0,range,Base)

loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if Condition_Base(GetOwningPlayer(damager),n0) and IsUnitInGroup(n0,gr1)==false and GetUnitAbilityLevel(n0,'Avul')==0 then
call UnitStop(n0)
set damage_plus=damage0*0.15*GetUnitAbilityLevel(n0,'A1EA')
set damage_saber=damage0*0.15*GetUnitAbilityLevel(n0,'A1EB')
set damage=damage0+damage_plus+damage_saber
if damage_plus>0 then
call SaveUnitHandle(HH,GetHandleId(damager),SH_HerFU,n0)
endif

if CritProc==true then

call myCustomDamage(damager,n0,damage*1.25,false,false,null,null,null)

else
call myCustomDamage(damager,n0,damage,false,false,null,null,null)
endif

call GroupAddUnit(gr1,n0)
endif
call GroupRemoveUnit(G,n0)
endloop




call GroupClear(G)
call SaveGroupHandle(HH,id,4,gr1)
set damager=null
set gr1=null

endfunction






function HeroineGAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real dist=LoadReal(HH,id,8)
local real damage=LoadReal(HH,id,15)
local integer ri=0
local integer lvl=GetUnitAbilityLevel(caster,'A1EC')
local real x1=GetUnitX(LoadUnitHandle(HH,id,20))
local real y1=GetUnitY(LoadUnitHandle(HH,id,20))
set time=time+0.02
call SaveReal(HH,id,5,time)
if time==0.02 or time==0.3 then
call EffectCreateAndMove(true,"Others\\HakkeStart2.mdl",facing,1.5,1,1.5,100,100,100,80,0,caster,0,facing)
call EffectCreateAndMove(true,"Others\\[A]az_axe_ef1.mdl",facing,1.5,1,0.65,60,60,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"Others\\[DoFT]az_pafeathermoon_b.mdl",facing,1.5,2.5,0.65,60,60,100,0,0,caster,0,facing)
endif
if time<0.5 then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
endif
if time==0.2 then
set ri=GetRandomInt(0,100)
if lvl>0 and ri<=15 then
if(GetLocalPlayer()==GetOwningPlayer(caster))then
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"Crit")
endif
call SaveBoolean(HH,id,16,true)
else
call SaveBoolean(HH,id,16,false)
endif
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),LoadReal(HH,id,3))
call SetUnitModel(n0,"Others\\XeXSlash45-1.mdl")
call UnitSize(n0,1.5,1,1)
call UnitSpeed(n0,1)
call UnitColor(n0,100,100,100,0)
call SetUnitFlyHeight(n0,200,0)
call SaveUnitHandle(HH,id,20,n0)
call MoveUnit(caster,n0,100,facing)
set n0=null
endif
if time==0.4 then
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),LoadReal(HH,id,3))
call SetUnitModel(n0,"Others\\XeXSlash45-2.mdl")
call UnitSize(n0,1.5,1,1)
call UnitSpeed(n0,1)
call UnitColor(n0,100,100,100,0)
call SetUnitFlyHeight(n0,200,0)
call SaveUnitHandle(HH,id,21,n0)
call MoveUnit(caster,n0,100,facing)
set n0=null
