function InitTrig_Pick_Heroes takes nothing returns nothing
set gg_trg_Pick_Heroes=CreateTrigger()
call TriggerRegisterTimerEvent(gg_trg_Pick_Heroes,10.00,true)
call TriggerAddCondition(gg_trg_Pick_Heroes,Condition(function Trig_Pick_Heroes_Conditions))
call TriggerAddAction(gg_trg_Pick_Heroes,function Trig_Pick_Heroes_Actions)
endfunction
function Trig_LevelUp_Conditions takes nothing returns boolean  
set n=GetTriggerUnit()
return GetOwningPlayer(n)!=Player(PLAYER_NEUTRAL_PASSIVE)and GetUnitAbilityLevel(n,'Aloc')==0 and  GetUnitTypeId(n)!='HSaC' and  GetUnitTypeId(n)!='HASC' and  GetUnitTypeId(n)!='HAST' and GetUnitTypeId(n)!='Ho13' and GetUnitTypeId(n)!='H34X' and GetUnitTypeId(n)!='H007' and GetUnitTypeId(n)!='H035' and GetUnitTypeId(n)!=0x4830334F and GetUnitTypeId(n)!='H03Y' and GetUnitTypeId(n)!='H03T' and GetUnitTypeId(n)!='H03W' and GetUnitTypeId(n)!='H03X' and GetUnitTypeId(n)!='H03V' and GetUnitTypeId(n)!='H03U'
endfunction
function AvalonCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit u=LoadUnitHandle(HH,GetHandleId(t),0)
local real ml=GetUnitState(u,UNIT_STATE_MAX_LIFE)
local real l=GetWidgetLife(u)
local integer i=0
local integer ip=GetPlayerId(GetOwningPlayer(u))
if Hero[ip]!=u then
call PauseTimer(t)
call DestroyTimer(t)
endif
if IsUnitAlive(u) then
call HealTextTag(u,u,ml*0.0065*myCustomHeal2(u,1),"HealthRes")
call SetUnitState(u,UNIT_STATE_LIFE,l+ml*0.0065)
endif
loop
exitwhen i>=10
if(GetUnitTypeId(Hero[i])=='H05C' or GetUnitTypeId(Hero[i])=='H15C' or GetUnitTypeId(Hero[i])=='H05E' or GetUnitTypeId(Hero[i])=='H06P' or GetUnitTypeId(Hero[i])=='H06P')and IsUnitAlly(Hero[i],GetOwningPlayer(u)) and IsUnitAlive(Hero[i]) then
call HealTextTag(Hero[i],Hero[i],GetUnitState(Hero[i],UNIT_STATE_MAX_LIFE)*0.0065*myCustomHeal2(Hero[i],1),"HealthRes")
call SetUnitState(Hero[i],UNIT_STATE_LIFE,GetWidgetLife(Hero[i])+GetUnitState(Hero[i],UNIT_STATE_MAX_LIFE)*0.0065)
endif
set i=i+1
endloop
set t=null
set u=null
endfunction
function HighSpeedRegenerationCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit u=LoadUnitHandle(HH,GetHandleId(t),0)
local real ml=GetUnitState(u,UNIT_STATE_MAX_LIFE)
local real l=GetWidgetLife(u)
if 0.25<l/ml and IsUnitAlive(u) then
call HealTextTag(u,u,GetHeroAgi(u,true)*0.1*(0.05+(GetUnitAbilityLevel(u,'A0RS')*0.025))*myCustomHeal2(u,1),"HealthRes")
call SetUnitState(u,UNIT_STATE_LIFE,l+GetHeroAgi(u,true)*0.1*(0.05+(GetUnitAbilityLevel(u,'A0RS')*0.025)))
endif
set t=null
set u=null
endfunction
function NejiWCond2 takes nothing returns boolean
return SR(GetUnitX(Neji),GetUnitY(Neji),GetUnitX(GetAttacker()),GetUnitY(GetAttacker()))<=950+GetUnitAbilityLevel(Neji,'A34E')*50 and Neji==GetTriggerUnit() and IsUnitAlly(GetAttacker(),GetOwningPlayer(Neji))==false and GetUnitAbilityLevel(GetAttacker(),'Aloc')==0 and IsUnitType(GetAttacker(),UNIT_TYPE_DEAD)==false and IsUnitType(GetAttacker(),UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(GetAttacker(),'A0QL')==0 and 'dumm'!=GetUnitTypeId(GetAttacker())
endfunction
function NejiWCond3 takes nothing returns boolean
return SR(GetUnitX(Neji),GetUnitY(Neji),GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()))<=950+GetUnitAbilityLevel(Neji,'A34E')*50 and IsUnitAlly(GetTriggerUnit(),GetOwningPlayer(Neji))==false and GetUnitAbilityLevel(GetTriggerUnit(),'Aloc')==0 and IsUnitType(GetTriggerUnit(),UNIT_TYPE_DEAD)==false and IsUnitType(GetTriggerUnit(),UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(GetTriggerUnit(),'A0QL')==0 and 'dumm'!=GetUnitTypeId(GetTriggerUnit()) and AbilIdFilter(GetSpellAbilityId()) and AbilIdFilter2(GetSpellAbilityId()) and GetSpellAbilityId()!='A022'
endfunction
function CellRegeneration takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit u=LoadUnitHandle(HH,GetHandleId(t),0)
local real ml=GetUnitState(u,UNIT_STATE_MAX_LIFE)
local real l=GetWidgetLife(u)
if GetHeroLevel(u)>=6 and IsUnitAlive(u) then
call HealTextTag(u,u,ml*(0.005+(GetUnitAbilityLevel(u,'A105')*0.005))*0.01*myCustomHeal2(u,1),"HealthRes")
call SetUnitState(u,UNIT_STATE_LIFE,l+ml*(0.005+(GetUnitAbilityLevel(u,'A105')*0.005))*0.01)
endif
set t=null
set u=null
endfunction
function MajinVegeta takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local unit u=LoadUnitHandle(HH,GetHandleId(t),0)
    local real ml=GetUnitState(u,UNIT_STATE_MAX_LIFE)
    local real l=GetWidgetLife(u)
    if 0.25>l/ml and GetHeroLevel(u)>=6 and IsUnitAlive(u) then
    call SetUnitAbilityLevel(u,'A0IT',GetUnitAbilityLevel(u,'A0IR')+1)
    call HealTextTag(u,u,ml*(0.0005+0.0001*GetUnitAbilityLevel(u,'A0IR'))*myCustomHeal2(u,1),"HealthRes")
    call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+ml*(0.0005+0.0001*GetUnitAbilityLevel(u,'A0IR')))
    else
    call SetUnitAbilityLevel(u,'A0IT',1)
    endif
    set t=null
    set u=null
endfunction
function HieHieNoMi takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
if UnitIsAlive(u) and CheckUnitInvisible(u)==false then
call GroupEnumUnitsInRange(G,x,y,500,Base)
call UnitApplyTimedLife(CreateUnit(p,'e0GK',x,y,GetRandomReal(0,359)),1,1)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call CC_UnitEx( E, E, 0., 1.5, "ensnare", false, "IcePath.mdl", "origin", 0,0 )
endif
call GroupRemoveUnit(G,E)
endloop
endif
set p=null
set t=null
set u=null
endfunction
