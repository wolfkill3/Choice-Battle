function QScatachPoint takes nothing returns nothing
local trigger tt=GetTriggeringTrigger()
local integer id=GetHandleId(tt)
if GetOrderTargetUnit()==null then
call SaveReal(h,id,0,GetOrderPointX())
call SaveReal(h,id,1,GetOrderPointY())
else
call SaveReal(h,id,0,GetUnitX(GetOrderTargetUnit()))
call SaveReal(h,id,1,GetUnitY(GetOrderTargetUnit()))
endif
call TriggerClearActions(tt)
set tt=null
endfunction
function QScatachCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=LoadReal(h,id,4)
local real dist=LoadReal(h,id,5)
local player p=GetOwningPlayer(u)
local real dmg=(GetUnitAbilityLevel(u,'A1FD')+1)*GetHeroAgi(u,true)*LoadReal(h,id,6)
if dist>0 then
set x=x+75*Cos(a)
set y=y+75*Sin(a)
call SetUnitXY_1(u,x,y, false)
if GetUnitTypeId(u)=='H06Y' then
set n=CreateUnit(p,'e156',x,y,a*bj_RADTODEG)
else
set n=CreateUnit(p,'e15L',x,y,a*bj_RADTODEG)
endif
call UnitApplyTimedLife(n,'BTLF',0.12)
call SetUnitTimeScale(n,20000)
call SetUnitVertexColor(n,255,255,255,50)
call SetUnitAnimation(n,"Spell Two")
call SetUnitFacing(u,a*bj_RADTODEG)
call SaveReal(h,id,5,dist-75)
call GroupEnumUnitsInRange(G,x,y,100,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
call SetControlToUnit(E,E, 2, "stun")
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Tidal.mdx",E,"chest"))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX-Special.mdx",E,"chest"))
endif
call SaveReal(h,id,5,-1)
endif
call GroupRemoveUnit(G,E)
endloop
else
call UnitRemoveAbility(u,'A1F8')
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call IssueImmediateOrder(u,"stop")
call SetUnitTimeScale(u,1)
call SetUnitTurnSpeed(u,1)
call UnitRemoveAbility(u,'A1F6')
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set t=null
set u=null
set p=null
endfunction
function QScatachCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local player p=GetOwningPlayer(u)
local trigger tt=LoadTriggerHandle(h,id,1)
local integer idt=GetHandleId(tt)
local real time=LoadReal(h,id,2)
local real te=LoadReal(h,id,3)
local real sc=0
local real is=0
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=0
local real y1=0
local real ig=30*bj_DEGTORAD
if GetUnitCurrentOrder(u)==OrderId("channel")then
call SaveReal(h,id,2,time+0.05)
call SaveReal(h,id,3,te+0.05)
if te>0.3 then
call SaveReal(h,id,3,0)
loop
exitwhen is>=13
set n=CreateUnit(p,'e0ZH',x+250*Cos(ig*is),y+250*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,200,255,200,55)
call UnitApplyTimedLife(n,'BTLF',0.55)
call SetUnitTimeScale(n,2)
set is=is+1
endloop
endif
else
set x1=LoadReal(h,idt,0)
set y1=LoadReal(h,idt,1)
if x1!=0 and y1!=0 then
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SetUnitAnimation(u,"Spell Two")
call SetUnitTimeScale(u,200)
call SaveReal(h,id,4,Atan2(y1-y,x1-x))
call SaveReal(h,id,5,1500+300*time)
call SaveReal(h,id,7,(1500+300*time)*0.04)
call SaveReal(h,id,6,1.05+time/20)
call SetUnitFacing(u,Atan2(y1-y,x1-x)*bj_RADTODEG)
set soundplay=SndN(2853) // Sound\Music\mp3Music\Scathach1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.01,true,function QScatachCast3)
call FlushChildHashtable(h,idt)
call DestroyTrigger(tt)
else
call SetUnitTurnSpeed(u,1)
call SetUnitTimeScale(u,1)
call UnitRemoveAbility(u,'A1F6')
call DestroyTrigger(tt)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,idt)
endif
endif
set u=null
set tt=null
set p=null
set t=null
endfunction
function QScatachCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local trigger tt=CreateTrigger()
local integer idt=GetHandleId(tt)
call SaveUnitHandle(h,id,0,u)
call SaveTriggerHandle(h,id,1,tt)
call SaveReal(h,idt,0,0)
call SaveReal(h,idt,1,0)
call SaveReal(h,id,2,0)
call SaveReal(h,id,3,0)
call SetUnitAnimation(u,"Spell One")
call SetUnitTurnSpeed(u,100000)
call UnitAddAbility(u,'A1F6')
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerAddAction(tt,function QScatachPoint)
call TimerStart(t,0.05,true,function QScatachCast2)
set u=null
set t=null
set tt=null
endfunction
