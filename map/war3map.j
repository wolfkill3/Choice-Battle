local real damage=LoadReal(HH,id,15)
set time=time+0.02
call SaveReal(HH,id,5,time)
set time1=time1+0.02
if distance<=65 or IsTerrainPathable(PolX(GetUnitX(Dummy),80,facing),PolY(GetUnitY(Dummy),80,facing),PATHING_TYPE_FLYABILITY)==true then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\AizenQHit.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call UnitSpeed(caster,1)
call EffectCreateAndMove(true,"Others\\HakkeStart2.mdl",facing,1.5,1.5,1.5,100,100,100,40,-100,Dummy,0,facing)
call EffectCreateAndMove(true,"Aizen\\white-shandian-qiquan-yellow.mdl",facing,1.5,4,1,100,100,100,0,0,Dummy,0,facing)
call EffectCreateAndMove(true,"Aizen\\file00000006.mdl",facing,1.5,2,0.6,100,100,100,0,0,Dummy,0,facing)
call DamageAoeOneTime0(casterOriginal,GetUnitX(Dummy),GetUnitY(Dummy),500,damage)
call RemoveUnit(Dummy)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else
if time1==0.04 then
set time1=0
call EffectCreateAndMove(true,"Aizen\\white-shandian-qiquan-yellow.mdl",facing,1.5,GetRandomReal(1.5,2),GetRandomReal(1.5,2),100,100,100,0,0,Dummy,0,facing)
endif
call SaveReal(HH,id,6,time1)
if time==0.02 then
call EffectCreateAndMoveAn(true,"Aizen\\LighWave3.mdl",facing,1.5,1.5,1.25,100,100,100,0,0,caster,0,facing,0)
call EffectCreateAndMoveAn(true,"Aizen\\LighWave3.mdl",facing,1.5,1,1.75,100,100,100,0,0,caster,0,facing,0)
call EffectCreateAndMoveAn(true,"Aizen\\LighWave3.mdl",facing,1.5,0.5,2.5,100,100,100,0,0,caster,0,facing,0)
call EffectCreateAndMove(true,"Others\\HakkeStart2.mdl",facing,1.5,1,0.5,100,100,100,60,0,caster,0,facing)
call UnitSpeed(caster,2)
if GetUnitTypeId(caster)=='H12M' then
call SetUnitAnimationByIndex(caster,17)
else
call SetUnitAnimationByIndex(caster,9)
endif
endif
if time==0.1 then
call UnitSpeed(caster,1)
endif
if distance>65 then
call MoveUnit(Dummy,Dummy,60,facing)
endif
endif
set caster=null
set Dummy=null
set casterOriginal=null
endfunction
