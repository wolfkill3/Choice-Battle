function QKazumaCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit c=LoadUnitHandle(HH,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local real time=LoadReal(HH,id,2)-0.1
local player p=GetOwningPlayer(u)
local integer i=0
local integer l__s=0
local integer ls=0
local integer item_id= 0
local integer max_iteration= 30
local integer random_slot= 0
if time>0 then
call PauseUnit(u,true)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call SaveReal(HH,id,2,time)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\SpiritOfVengeance\\SpiritOfVengeanceBirthMissile.mdl",u,"right hand"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\SpiritOfVengeance\\SpiritOfVengeanceBirthMissile.mdl",u,"left hand"))
call EffectToRandomBone("Abilities\\Spells\\NightElf\\SpiritOfVengeance\\SpiritOfVengeanceBirthMissile.mdl",c)
call SetUnitXY_1(u,LoadReal(HH,id,3),LoadReal(HH,id,4),false)
call SetUnitXY_1(c,LoadReal(HH,id,5),LoadReal(HH,id,6),false)
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,155,200,255,75)
call SetUnitTimeScale(n,2)
call SetUnitScale(n,0.5,0.5,0.5)
call UnitApplyTimedLife(n,1,1)
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,155,200,255,75)
call SetUnitTimeScale(n,2)
call SetUnitScale(n,0.75,0.75,0.75)
call UnitApplyTimedLife(n,1,1)
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,155,200,255,75)
call SetUnitTimeScale(n,2)
call SetUnitScale(n,1,1,1)
call UnitApplyTimedLife(n,1,1)
else
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call PauseUnit(u,false)
call SetUnitTimeScale(u,1)
if GetWidgetMaxMana(c)>0 then
call HealTextTag(u,u,GetWidgetMaxMana(c)*(0.10+0.01*GetUnitAbilityLevel(u,'Ao7N'))*0.5*myCustomMana2(u,1),"ManaRes")
call SetWidgetMana(u,GetWidgetMana(u)+GetWidgetMaxMana(c)*(0.10+0.01*GetUnitAbilityLevel(u,'Ao7N'))*0.5)
call SetWidgetMana(c,GetWidgetMana(c)-GetWidgetMaxMana(c)*(0.10+0.01*GetUnitAbilityLevel(u,'Ao7N')))
call myCustomDamage(u,c,(1+0.5*GetUnitAbilityLevel(u,'Ao7N'))*(GetWidgetMaxMana(c)*(0.10+0.01*GetUnitAbilityLevel(u,'Ao7N'))),false,false,null,null,null)
if GetWidgetMana(c)<GetWidgetMaxMana(c)*0.5 then
call SetControlToUnit(u,c,2,"stun")
endif
endif
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set p=null
set c=null
set u=null
set t=null
endfunction
function QKazumaCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit c=LoadUnitHandle(HH,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>150 then
set x=x+50*Cos(a)
set y=y+50*Sin(a)
call SetUnitXY_1(u,x,y, false)
set n=CreateUnit(p,'kaD1',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,0.2)
call SetUnitVertexColor(n,255,255,255,75)
call SetUnitTimeScale(n,0.05)
call SetUnitAnimation(n,"Spell Four")
else
    if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\KazumaQ.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        set x=x-80*Cos(a)
        set y=y-80*Sin(a)
        call SetUnitXY_1(u,x,y, false)
        set n=CreateUnit(p,'kaD2',x,y,a*bj_RADTODEG)
        call UnitApplyTimedLife(n,1,2)
        call SaveReal(HH,id,2,1)
        call SaveReal(HH,id,3,GetUnitX(u))
        call SaveReal(HH,id,4,GetUnitY(u))
        call SaveReal(HH,id,5,GetUnitX(c))
        call SaveReal(HH,id,6,GetUnitY(c))
        call PauseUnit(c,true)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
        call SetUnitTimeScale(u,2)
        call SetUnitAnimationByIndex(u,15)
        call TimerStart(t,0.1,true,function QKazumaCast3)
    else
        call PauseUnit(u,false)
        call SetUnitInvulnerable(u,false)
        call SetUnitVertexColor(u,255,255,255,255)
        call SetUnitTimeScale(u,1)
        call PauseTimer(t)
        call SetUnitFlyHeight(u,0,0)
        call DestroyTimer(t)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
        call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
        call FlushChildHashtable(HH,id)
    endif
endif
set p=null
set c=null
set u=null
set t=null
endfunction
function QKazumaCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
