set l__d=null
set p=null
set u=null
set t=null
endfunction
//UraharaDmgStart вЂ” РїРµСЂРµРЅРµСЃРµРЅРѕ РёР· Choice Random 4.5
function Urahara_DMG takes unit u,real k returns real
if GetUnitAbilityLevel(u,'UKD3')>0 then
return k*GetHeroInt(u,true)*0.5
endif
//else
return 0.0
//endif

endfunction
