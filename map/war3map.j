local real spaceWave
local real timeWave
local real radiusRatio
if time<3 then
call SaveReal(h,id,5,time+0.2)
set n=CreateUnit(p,'e0HQ',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.55)
call SetUnitVertexColor(n,255,255,255,125)
call SetUnitScale(n,time,time,time)
else
call SetUnitTimeScale(u,0.1)
call PauseTimer(t)
call SaveReal(h,id,5,1.3)
set timeWave=2.0*1.7/1
set spaceWave=2.0*3000/500
set radiusRatio=500/3000
set bj_lastCreatedTerrainDeformation=TerrainDeformRipple(x,y,3000,400,R2I(1.7*1000),1,spaceWave,timeWave,radiusRatio,false)
call ShakeCamera(0.5,20)
call TimerStart(t,0.12,true,function KaishinCast3)
endif
set p=null
set u=null
set t=null
endfunction
