set n=CreateUnit(p,'e10Y',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,25)
call SetUnitTimeScale(n,0.5)
call SetUnitFlyHeight(n,150,0)
call SetUnitScale(n,1.5,1.5,1.5)
call UnitApplyTimedLife(n,'BTLF',3)
set n=CreateUnit(p,'e0RV',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,155)
call SetUnitTimeScale(n,0.02)
call SetUnitFlyHeight(n,-175,0)
call SetUnitScale(n,4,4,4)
call UnitApplyTimedLife(n,'BTLF',30)
set n=CreateUnit(p,'e10Y',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,25)
call SetUnitTimeScale(n,0.5)
call SetUnitFlyHeight(n,100,0)
call SetUnitScale(n,2.5,2.5,2.5)
call UnitApplyTimedLife(n,'BTLF',3)
set n=CreateUnit(p,'e10Y',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,25)
call SetUnitTimeScale(n,0.5)
call SetUnitFlyHeight(n,50,0)
call SetUnitScale(n,3.5,3.5,3.5)
call UnitApplyTimedLife(n,'BTLF',3)
set n=CreateUnit(p,'e10S',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
set n=CreateUnit(p,'e10T',x,y,GetRandomReal(0,359))
call SetUnitTimeScale(n,0.25)
call UnitApplyTimedLife(n,'BTLF',26.5)
call SaveUnitHandle(h,idu,SH_hramd,n)
call SaveGroupHandle(h,id,6,CreateGroup())
call SaveGroupHandle(h,id,12,CreateGroup())
set soundplay=SndN(2574) // Sound\Music\mp3Music\Tamamo Noble Phantasm.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.05,true,function HramCast2)
else
call DestroyTimer(t)
endif
set p=null
set u=null
set t=null
endfunction
