function FireBoltCond takes nothing returns boolean
return GetSpellAbilityId()=='A1B0' and udg_B
endfunction
function TrowFireBlastCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real dmg=GetHeroInt(u,true)*(1+GetUnitAbilityLevel(u,'A1B0'))*0.1
local real x=0
local real y=0
local real x1=LoadReal(h,id,1)
local real y1=LoadReal(h,id,2)
local real dist=LoadReal(h,id,5)
local real a=LoadReal(h,id,6)
local player p=GetOwningPlayer(u)
if dist>0 then
set x=x1+350*Cos(a)
set y=y1+350*Sin(a)
set n=CreateUnit(p,0x65313130,x,y,0)
call SetUnitFlyHeight(n,750*dist,0)
call UnitApplyTimedLife(n,1,0.01)
set n=CreateUnit(p,0x65313131,x1,y1,0)
call SetUnitFlyHeight(n,2000-2000*dist,0)
call UnitApplyTimedLife(n,1,1)
call SaveReal(h,id,5,dist-0.1)
call SaveReal(h,id,6,a+0.70)
call GroupEnumUnitsInRange(G,x1,y1,400,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg*1.25,false,false,null,null,null)
call SlowUnit(u,E,0.4,0.4,1.5,1,false)
call SetControlToUnit(E,E,1.5,"silence")
endif
call GroupRemoveUnit(G,E)
endloop
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set p=null
set t=null
endfunction
function TrowFireBlastCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(HH,GetHandleId(u),StringHash("tama"))
local real dmg=GetHeroAgi(u,true)*5
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,1)
local real y1=LoadReal(h,id,2)
local real a=Atan2(y1-y,x1-x)
local real dist=SR(x,y,x1,y1)
local real he=(dist/LoadReal(h,id,6))*LoadReal(h,id,5)
local player p=GetOwningPlayer(u)
if dist>60 and GetWidgetLife(l__d)>0 then
set x=x+40*Cos(a)
set y=y+40*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,he,0)
else
set n=CreateUnit(p,'e112',x1,y1,0)
call UnitApplyTimedLife(n,1,1)
call SaveReal(h,id,5,1)
call SaveReal(h,id,6,0)
call UnitRemoveAbility(l__d,'A1AV')
call UnitAddAbility(l__d,'A0A1')
call DestroyEffect(LoadEffectHandle(h,id,3))
call DestroyEffect(LoadEffectHandle(h,id,8))
call SetUnitOwner(l__d,p,false)
call PauseTimer(t)
call TimerStart(t,0.1,true,function TrowFireBlastCast3)
endif
set l__d=null
set u=null
set p=null
set t=null
endfunction
function TrowFrostBlastCast3 takes nothing returns nothing
