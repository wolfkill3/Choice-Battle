set t=null
set p=null
endfunction
function OneSidedChaoticDanceCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,5)
local real y1=LoadReal(h,id,6)
local real x2
local real y2
local real a
local real an=LoadReal(h,id,30)+0.11
local real fl=LoadReal(h,id,32)+7
local group g=LoadGroupHandle(h,id,31)
local player p=GetOwningPlayer(u)
local real dist=LoadReal(h,id,2)
local real scale=LoadReal(h,id,10)
local real tm=GetWidgetMana(u)
local real time=LoadReal(h,id,17)
local real dmg=GetHeroInt(u,true)*0.1
if time>0 then
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,0.65,0.65,0.65)
call SetUnitVertexColor(n,25,150,255,50)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,25,150,255,40)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.65,1.65,1.65)
call SetUnitVertexColor(n,25,150,255,30)
set n=CreateUnit(p,'e0RR',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitVertexColor(n,50,150,255,50)
call SaveReal(h,id,17,time-0.03)
set x2=x+250*Cos(an)
set y2=y+250*Sin(an)
set a=Atan2(y-y2,x-x2)+bj_PI
set n=CreateUnit(p,0x65305552,x2,y2,a*bj_RADTODEG)
call SetUnitFlyHeight(n,fl,0)
call GroupAddUnit(g,n)
call SaveReal(h,id,32,fl)
call SaveReal(h,id,30,an)
else
call PauseTimer(t)
call TimerStart(t,0.2,false,function OneSidedChaoticDanceCast3)
loop
set E=FirstOfGroup(g)
exitwhen E==null
call OneSidedChaoticDanceMissleFly(E,35,0,x1+GetRandomReal(-300,300)*Cos(GetRandomReal(0,6.28)),y1+GetRandomReal(-300,300)*Sin(GetRandomReal(0,6.28)),GetUnitFlyHeight(E),0)
call GroupRemoveUnit(g,E)
endloop
call DestroyGroup(g)
endif
set g=null
set p=null
set u=null
set t=null
endfunction
