local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real sc=LoadReal(h,id,8)
local real dist=LoadReal(h,id,7)
local real f=15*bj_DEGTORAD
if sc<7 then
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call SetUnitInvulnerable(c,true)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
set n=CreateUnit(p,'e0Z8',x+75*Cos(a),y+75*Sin(a),a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,1.5)
call SetUnitScale(n,sc*1.3,sc*1.3,sc*1.3)
set n=CreateUnit(p,'e0HQ',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.5)
call SetUnitFlyHeight(n,GetRandomReal(0,100),0)
call SetUnitScale(n,sc*0.75,sc*0.75,sc*0.75)
call SetUnitVertexColor(n,255,255,255,125-R2I(10*sc))
call SetUnitTimeScale(n,1-sc*0.1)
set n=CreateUnit(p,'e0HQ',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.5)
call SetUnitFlyHeight(n,GetRandomReal(0,100),0)
call SetUnitScale(n,sc*0.5,sc*0.5,sc*0.5)
call SetUnitVertexColor(n,255,255,255,125-R2I(10*sc))
call SetUnitTimeScale(n,1-sc*0.1)
set n=CreateUnit(p,'e0HQ',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.5)
call SetUnitFlyHeight(n,GetRandomReal(0,100),0)
call SetUnitScale(n,sc*0.25,sc*0.25,sc*0.25)
call SetUnitTimeScale(n,1-sc*0.1)
call SetUnitVertexColor(n,255,255,255,125-R2I(10*sc))
call SaveReal(h,id,8,sc+0.20)
call SaveReal(h,id,7,dist+75)
else
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call SetUnitInvulnerable(c,true)
call PauseTimer(t)
call SaveReal(h,id,8,0)
call SetUnitTimeScale(u,0)
call TimerStart(t,0.03,true,function ShimaYurashiCast5)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function ShimaYurashiCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call SetUnitInvulnerable(c,true)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call PauseTimer(t)
set n=CreateUnit(p,'e0Z8',x+75*Cos(a),y+75*Sin(a),a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,0.5)
call SetUnitScale(n,3,3,3)
set n=CreateUnit(p,'e0XW',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.25)
call SetUnitScale(n,2.5,2.5,2.5)
set n=CreateUnit(p,'e0MB',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.5)
call SetUnitScale(n,2.5,2.5,2.5)
set n=CreateUnit(p,'e0MB',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.5)
call SetUnitScale(n,2.0,2.0,2.0)
set n=CreateUnit(p,'e0Z9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitScale(n,2,2,2)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\dash sfx.mdl",u,"origin"))
set soundplay=SndN(2506) // Sound\Music\mp3Music\Whitebeard4.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call ShakeCamera(1.5,20)
call TimerStart(t,0.05,true,function ShimaYurashiCast4)
set p=null
set u=null
set c=null
set t=null
endfunction
function ShimaYurashiCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>120 and GetWidgetLife(c)>0 and GetUnitAbilityLevel(u,'A3IH')==0 and GetUnitAbilityLevel(c,'A3IH')==0 and ((GetUnitAbilityLevel(u,'A0IH')==0 and GetUnitAbilityLevel(c,'A0IH')==0) or (GetUnitAbilityLevel(u,'A0IH')>0 and GetUnitAbilityLevel(c,'A0IH')>0)) then
set x=x+40*Cos(a)
set y=y+40*Sin(a)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SetUnitXY_1(u,x,y,false)
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitAnimation(u,"Spell Channel One")
else
if GetUnitAbilityLevel(u,'A3IH')==0 and GetUnitAbilityLevel(c,'A3IH')==0 and ((GetUnitAbilityLevel(u,'A0IH')==0 and GetUnitAbilityLevel(c,'A0IH')==0) or (GetUnitAbilityLevel(u,'A0IH')>0 and GetUnitAbilityLevel(c,'A0IH')>0)) then
        if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
            call PauseUnit(c,true)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
            call SetUnitInvulnerable(c,true)
            call UnitEnableAutoOrientation(c,false)
            call SetUnitFlyHeight(c,900,0)
            call SetUnitFlyHeight(c,0,400)
            if GetUnitTypeId(c)!='HMUS' then
            call SetUnitOrientation(c,GetUnitFacing(u),-180,0)
            endif
            call SetUnitAnimation(u,"Spell Three")
            call PauseTimer(t)
            call SetUnitTimeScale(u,0.28)
            call TimerStart(t,2,false,function ShimaYurashiCast3)
        else
            call PauseUnit(u,false)
            call SetUnitInvulnerable(u,false)
            call PauseUnit(c,false)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
            call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
            call PauseTimer(t)
            call DestroyTimer(t)
            call SetUnitVertexColor(u,255,255,255,255)
            call FlushChildHashtable(h,id)
        endif
    else
        call SetUnitInvulnerable(u,false)
        call SetUnitInvulnerable(c,false)
        call PauseUnit(u,false)
        call PauseUnit(c,false)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
        call PauseTimer(t)
        call DestroyTimer(t)
        call SetUnitVertexColor(u,255,255,255,255)
        call FlushChildHashtable(h,id)
    endif
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function ShimaYurashiCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
call SaveUnitHandle(h,id,0,u)
call SetUnitPathing(u,false)
call SetUnitAnimation(u,"Spell Channel Two")
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SaveReal(h,id,7,75)
call SaveReal(h,id,8,0.3)
call SaveReal(h,id,9,Atan2(GetUnitY(c)-y,GetUnitX(c)-x))
call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e06H',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e06I',x,y,GetRandomReal(0,359)),'BTLF',1)
call SetUnitTimeScale(u,5)
call SaveUnitHandle(h,id,1,c)
call SaveEffectHandle(h,id,16,AddSpecialEffectTarget("GuraGuraAttack.mdx",u,"left hand"))
call TimerStart(t,0.025,true,function ShimaYurashiCast2)
set soundplay=SndN(2508) // Sound\war3mapImported\Whitebeard_R1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set c=null
set u=null
set t=null
endfunction
function InitTrig_ShimaYurashi takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function ShimaYurashiCond))
call TriggerAddAction(t,function ShimaYurashiCast)
set t=null
endfunction
function KaishinCond takes nothing returns boolean
return GetSpellAbilityId()=='A18Y' and udg_B
endfunction
function KaishinCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local group g=LoadGroupHandle(h,id,1)
local integer i=1
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local real dist
local real dmg=10*GetHeroStr(u,true)
local real sc=LoadReal(h,id,5)
local integer l__idg=GetHandleId(g)
local real f
local player p=GetOwningPlayer(u)
local integer l__ide
call SaveReal(h,id,5,sc+0.12)
loop
exitwhen i>12
set dist=LoadReal(h,id,StringHash("dist"+I2S(i)))+175
call SaveReal(h,id,StringHash("dist"+I2S(i)),dist)
set f=(30*i)*bj_DEGTORAD
set n=CreateUnit(p,'e0ZC',x+dist*Cos(f),y+dist*Sin(f),GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.8)
call SetUnitTimeScale(n,0.7)
call SetUnitScale(n,sc,sc,sc)
set i=i+1
endloop
call GroupEnumUnitsInRange(g,x,y,dist,Base)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set l__ide=GetHandleId(E)
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,l__ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,l__idg,l__ide,E)
call SlowUnit(u,E,0.5,0,5,0,false)
endif
call GroupRemoveUnit(g,E)
endloop
if dist>=2500 then
call DestroyGroup(g)
call DestroyEffect(LoadEffectHandle(h,id,16))
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
endif
set u=null
set g=null
set t=null
set p=null
endfunction
function KaishinCast2 takes nothing returns nothing
