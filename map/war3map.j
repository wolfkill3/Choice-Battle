function MistEnergyCond takes nothing returns boolean
return GetSpellAbilityId()=='A09W'
endfunction
function MistEnergyCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local integer level=LoadInteger(h,id,0)
local group g=LoadGroupHandle(h,id,1)
local group g2
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local real dur=LoadReal(h,id,4)+0.05
local real speed=LoadReal(h,id,5)
local real dist=LoadReal(h,id,6)+speed
local real tx
local real ty
local real a
if dur<1.7 then
set g2=CopyGroup(g)
loop
set E=FirstOfGroup(g2)
exitwhen E==null
set tx=GetUnitX(E)
set ty=GetUnitY(E)
set a=Atan2(ty-y,tx-x)
if GetUnitState(E,UNIT_STATE_LIFE)>0.405 and not IsTerrainPathable(tx+speed*Cos(a),ty+speed*Sin(a),PATHING_TYPE_FLYABILITY)then
call SetUnitX(E,tx+speed*Cos(a))
call SetUnitY(E,ty+speed*Sin(a))
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl",tx,ty))
else
call GroupRemoveUnit(g,E)
endif
call GroupRemoveUnit(g2,E)
endloop
call DestroyGroupTimed(g2,3)
call SaveReal(h,id,4,dur)
call SaveReal(h,id,5,speed-1)
call SaveReal(h,id,6,dist)
else
call GroupClear(g)
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set t=null
set g2=null
set g=null
endfunction
function MistEnergyCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local boolexpr b=Condition(function Tornado_Filter)
local group g=CreateGroup()
local group g2
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real dmg=(GetUnitAbilityLevel(u,'A09W')+3)*GetHeroInt(u,true)
call UnitApplyTimedLife(CreateUnit(p,'e050',x,y,0),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e051',x,y,0),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e04Z',x,y,0),'BTLF',1)
call GroupEnumUnitsInRange(g,x,y,400,b)
set g2=CopyGroup(g)
loop
set E=FirstOfGroup(g2)
exitwhen E==null
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call GroupRemoveUnit(g2,E)
endloop
call DestroyGroupTimed(g2,3)
call SaveGroupHandle(h,id,1,g)
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveReal(h,id,5,60.)
set soundplay=SndN(995) // Sound\Music\mp3Music\ViperE.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.05,true,function MistEnergyCast2)
set u=null
call DestroyBoolExpr(b)
set b=null
set g=null
set g2=null
set t=null
endfunction
