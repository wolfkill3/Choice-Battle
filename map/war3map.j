call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerAddAction(tt,function ERinStomOrders)
call TimerStart(t,0.07,true,function ERinCast2)
set u=null
set t=null
set p=null
set tt=null
