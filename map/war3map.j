function DanzoFMissleMove1 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
call SaveInteger(HH,id,5,LoadInteger(HH,id,5)+1)
call UnitStop(LoadUnitHandle(HH,id,1))
call MoveUnit(LoadUnitHandle(HH,id,1),LoadUnitHandle(HH,id,1),LoadReal(HH,id,2),LoadReal(HH,id,3))
if LoadInteger(HH,id,5)<LoadInteger(HH,id,6)*0.5 then
call SetUnitFlyHeight(LoadUnitHandle(HH,id,1),GetUnitFlyHeight(LoadUnitHandle(HH,id,1))+LoadReal(HH,id,9),0)
else
call SetUnitFlyHeight(LoadUnitHandle(HH,id,1),GetUnitFlyHeight(LoadUnitHandle(HH,id,1))-LoadReal(HH,id,9),0)
endif
if LoadInteger(HH,id,5)==LoadInteger(HH,id,6)then
call RemoveUnit(LoadUnitHandle(HH,id,1))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set t=null
endfunction
function DanzoFMissleMove takes unit target0,real facing0,integer time,real speed,real high returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(HH,id,1,target0)
call SaveInteger(HH,id,5,0)
call SaveInteger(HH,id,6,time)
call SaveReal(HH,id,2,speed)
call SaveReal(HH,id,3,facing0)
call SaveReal(HH,id,9,high)
call TimerStart(t,0.02,true,function DanzoFMissleMove1)
set target0=null
set t=null
endfunction
function DanzoFPassive1 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real time1=LoadReal(HH,id,6)
set time=time+0.02
call SaveReal(HH,id,5,time)
if time>=3 then
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
call SetUnitTargetable(caster, true)
call GroupClear(G)
call GroupEnumUnitsInRange(G,GetUnitX(caster),GetUnitY(caster),800,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if Condition_Base(GetOwningPlayer(caster),n0) then
call SetControlToUnit(caster,n0, 4, "stun")
if GetUnitState(n0,UNIT_STATE_LIFE)<=GetUnitState(n0,UNIT_STATE_MAX_LIFE)*0.2 then
call SetUnitInvulnerable(n0,false)

call UnitRemoveBuffs(n0,true,true)
call UnitAddAbility(n0,'A0WR')
call myCustomDamage(caster,n0,GetUnitState(n0,UNIT_STATE_MAX_LIFE)*0.2,false,false,null,DAMAGE_TYPE_UNIVERSAL,null)
call DamageIndicatorFunction(caster,n0,GetUnitState(n0,UNIT_STATE_MAX_LIFE)*0.2)
call UnitRemoveAbility(n0,'A0WR')






endif
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
call UnitCreateAndMove(caster,0x64733438,caster,facing,1,7,0.6,100,100,100,0,150,caster,0,facing)
call UnitCreateAndMove(caster,0x64733439,caster,facing,1,5,0.6,100,100,100,60,0,caster,0,facing)
call UnitCreateAndMove(caster,0x64733035,caster,facing,1,3,1,100,100,100,60,0,caster,0,facing)
call SetUnitAnimationByIndex(LoadUnitHandle(HH,id,21),1)
call SetUnitAnimationByIndex(LoadUnitHandle(HH,id,23),1)
call UnitSize(LoadUnitHandle(HH,id,21),5,1,1)
call RemoveUnit(LoadUnitHandle(HH,id,20))
call MyRemoveUnit(LoadUnitHandle(HH,id,21),2)
call RemoveUnit(LoadUnitHandle(HH,id,22))
call MyRemoveUnit(LoadUnitHandle(HH,id,23),0.5)
call RemoveUnit(LoadUnitHandle(HH,id,24))
call SetUnitState(caster,UNIT_STATE_LIFE,1)



call SetUnitInvulnerable(caster,false)
if udg_B==true then
call UnitAddAbility(caster,'A0WR')
call myCustomDamage(LoadUnitHandle(HH,id,2),caster,1000,false,false,null,null,null)
call UnitRemoveAbility(caster,'A0WR')
endif
//call SaveBoolean(HH,GetHandleId(caster),StringHash("DanzoFpassive"),false)
call SaveBoolean(HH,GetHandleId(caster),SH_DanzoD,true)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
else
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
if time==0.5 then
call UnitSpeed(LoadUnitHandle(HH,id,24),0)
endif
if time==0.02 then
call SetUnitAnimationByIndex(caster,14)
set n0=CreateUnit(GetOwningPlayer(caster),0x64733135,GetUnitX(caster),GetUnitY(caster),LoadReal(HH,id,3))
call UnitSize(n0,1.5,1,1)
call UnitSpeed(n0,0.8)
call SaveUnitHandle(HH,id,21,n0)
call SetUnitAnimationByIndex(n0,0)
call SetUnitFlyHeight(n0,0,0)
set n0=null
set n0=CreateUnit(GetOwningPlayer(caster),0x64733230,GetUnitX(caster),GetUnitY(caster),LoadReal(HH,id,3))
call UnitSize(n0,3,1,1)
call UnitSpeed(n0,1)
call SaveUnitHandle(HH,id,22,n0)
set n0=null
set n0=CreateUnit(GetOwningPlayer(caster),'ds04',GetUnitX(caster),GetUnitY(caster),LoadReal(HH,id,3))
call UnitSize(n0,3,1,1)
call UnitSpeed(n0,0.5)
call UnitColor(n0,100,100,100,60)
call SaveUnitHandle(HH,id,24,n0)
call SetUnitAnimationByIndex(n0,0)
call SetUnitFlyHeight(n0,0,0)
set n0=null
set n0=CreateUnit(GetOwningPlayer(caster),0x64733131,GetUnitX(caster),GetUnitY(caster),LoadReal(HH,id,3))
call UnitSize(n0,2.5,1,1)
call UnitSpeed(n0,2)
call SaveUnitHandle(HH,id,20,n0)
call SetUnitAnimationByIndex(n0,0)
call SetUnitFlyHeight(n0,-100,0)
set n0=null
set soundplay=SndN(776) // Sound\Music\mp3Music\DanzoF_Seal.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call MoveUnit(caster,LoadUnitHandle(HH,id,20),0,GetUnitFacing(caster))
call MoveUnit(caster,LoadUnitHandle(HH,id,21),0,GetUnitFacing(caster))
call MoveUnit(caster,LoadUnitHandle(HH,id,22),0,GetUnitFacing(caster))
call MoveUnit(caster,LoadUnitHandle(HH,id,24),0,GetUnitFacing(caster))
if time==1 then
set n0=CreateUnit(GetOwningPlayer(caster),0x64733235,GetUnitX(caster),GetUnitY(caster),LoadReal(HH,id,3))
call UnitSize(n0,5,1,1)
call UnitSpeed(n0,0.5)
call UnitColor(n0,50,50,50,50)
call SaveUnitHandle(HH,id,23,n0)
call SetUnitAnimationByIndex(n0,0)
call SetUnitFlyHeight(n0,200,0)
set n0=null
endif
if time<1 then
set time1=time1+0.02
if time1==0.08 then
set n0=CreateUnit(GetOwningPlayer(caster),0x64733138,GetUnitX(caster),GetUnitY(caster),GetRandomReal(0,360))
call UnitSize(n0,GetRandomReal(0.5,1),1,1)
call UnitSpeed(n0,0.2)
call DanzoFMissleMove(n0,GetRandomReal(0,360),60,10,15)
call MyRemoveUnit(n0,1.02)
call SetUnitFlyHeight(n0,0,0)
set n0=null
set time1=0
endif
call SaveReal(HH,id,6,time1)
endif
if time>1 and time<2.5 then
set time1=time1+0.02
if time1>=0.06 then
set n0=CreateUnit(GetOwningPlayer(caster),0x64733138,GetUnitX(caster),GetUnitY(caster),GetRandomReal(0,360))
call UnitSize(n0,GetRandomReal(2,3),1,1)
call UnitSpeed(n0,0.2)
call DanzoFMissleMove(n0,GetRandomReal(0,360),40,30,20)
call SetUnitFlyHeight(n0,0,0)
set n0=null
set time1=0
endif
call SaveReal(HH,id,6,time1)
endif
if time>1 then
call MoveUnit(caster,LoadUnitHandle(HH,id,23),0,GetUnitFacing(caster))
call GroupClear(G)
if time>1.5 then
if time<2.5 then
call GroupEnumUnitsInRange(G,GetUnitX(caster),GetUnitY(caster),800-(time-1.5)*400,Base)
else
call GroupEnumUnitsInRange(G,GetUnitX(caster),GetUnitY(caster),400+(time-2.5)*1200,Base)
endif
else
call GroupEnumUnitsInRange(G,GetUnitX(caster),GetUnitY(caster),400+(time-1)*1200,Base)
endif
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if SR(GetUnitX(n0),GetUnitY(n0),GetUnitX(caster),GetUnitY(caster))>100 and IsUnitEnemy(n0,GetOwningPlayer(caster))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false then
call MoveUnit(n0,n0,10,Angle2(GetUnitX(n0),GetUnitY(n0),GetUnitX(caster),GetUnitY(caster)))
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
endif
if time>1.5 and time<2.7 then
call UnitSize(LoadUnitHandle(HH,id,23),5-(time-1.5)*3,1,1)
endif
if time>2.7 then
call UnitSize(LoadUnitHandle(HH,id,23),1.4+(time-2.7)*12,1,1)
endif
if time==2.5 then
endif
endif
set t=null
set caster=null
endfunction
function DanzoFPassive takes  unit caster0,unit target0   returns nothing
local timer t = CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(HH,id,1,caster0)
call SaveUnitHandle(HH,id,2,target0)
call SetUnitAnimationByIndex(caster0,14)
call TimerStart(t,0.02,true,function DanzoFPassive1)
set caster0=null
set target0=null
endfunction
//danzo suicide end

function KarnaF_SecondStage takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit source    = LoadUnitHandle(h, id, 1)
    local unit target    = LoadUnitHandle(h, id, 0)
    local integer duration = LoadInteger(h, id, 3)-1
    if duration>0 and udg_B==true and DU2==true then
        if GetWidgetLife(target)>LoadReal(h, id, 2) then
            call SetWidgetLife(target, GetWidgetLife(target)-LoadReal(h, id, 2))
            call DamageIndicatorFunction(source, target, LoadReal(h, id, 2))
        else
            call UnitAddAbility(target, 'KaAD')
            call myCustomDamage(source, target, LoadReal(h, id, 2), false,false,null,null,null)
            call UnitRemoveAbility(target, 'KaAD')
        endif
        call SaveInteger(h, id, 3, duration)
    else
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set newTimer = null
    set source   = null
    set target   = null
endfunction

function KarnaF_FirstStage takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local real    damage = LoadReal(h, id, 2)
    // call SetUnitInvulnerable(LoadUnitHandle(h, id, 0), false)
    if udg_B==true and DU2==true then
    call SetWidgetLife(LoadUnitHandle(h, id, 0), LoadReal(h, id, 4)-damage*0.4)
    endif
    // call UnitAddAbility(LoadUnitHandle(h, id, 1), 'KaAD')
    // call myCustomDamage(LoadUnitHandle(h, id, 1), LoadUnitHandle(h, id, 0), damage*0.4, false,false,null,null,null)
    // call UnitRemoveAbility(LoadUnitHandle(h, id, 1), 'KaAD')

    set damage = damage * 0.6
    call SaveReal   (h, id, 2, damage*0.334 * 0.25)
    call SaveInteger(h, id, 3, 12)
    call TimerStart(newTimer, 0.25, true, function KarnaF_SecondStage)
    set newTimer=null
endfunction

function KarnaF_DamageExtension takes unit newCaster, unit newDamageSource, real newDamage returns nothing
    local timer newTimer = CreateTimer()
    local integer  id    = GetHandleId(newTimer)

    //call SetUnitInvulnerable(newCaster, true)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveUnitHandle(h, id, 1, newDamageSource)
    call SaveReal   (h, id, 2, newDamage)
    call SaveInteger(h, id, 3, 12)
    call SaveReal   (h, id, 4, GetWidgetLife(newCaster))
    call TimerStart(newTimer, 0.0, false, function KarnaF_FirstStage)
    set newTimer=null
endfunction

function newBlockDamage_End takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    call SetUnitInvulnerable(LoadUnitHandle(h, id, 0), false)
    call FlushChildHashtable(h, id)
    call PauseTimer(GetExpiredTimer())
    call DestroyTimer(GetExpiredTimer())
endfunction

function newBlockDamage takes unit newCaster returns nothing
    local timer newTimer = CreateTimer()
    local integer  id = GetHandleId(newTimer)

    call SetUnitInvulnerable(newCaster,true)
    call SaveUnitHandle(h, id, 0, newCaster)
    call TimerStart(newTimer, 0.0, true, function newBlockDamage_End)
    set newTimer=null
endfunction

function HassanE_StackPeriodic takes nothing returns nothing
        local integer id = GetHandleId(GetExpiredTimer())
        local integer id_target = GetHandleId(LoadUnitHandle(HH, id, TargetHash))
        local integer KHEStack = LoadInteger(HH, id_target, SH_KHE_Stack) 
        local unit c
        if KHEStack>0 and LoadUnitHandle(HH, id, TargetHash)!=null and UnitIsAlive(LoadUnitHandle(HH, id, TargetHash)) then
                set c = LoadUnitHandle(HH, id_target, SH_KHE_Indicator)
                call SetUnitFlyHeight(c, GetUnitFlyHeight(LoadUnitHandle(HH, id, TargetHash))+300, 0)
                call SetUnitAnimationByIndex(c, KHEStack)
                call SetUnitX(c, GetUnitX(LoadUnitHandle(HH, id, TargetHash)))
                call SetUnitY(c, GetUnitY(LoadUnitHandle(HH, id, TargetHash)))
                if CheckUnitInvisible(LoadUnitHandle(HH,id,TargetHash)) then
                        if GetUnitAbilityLevel(LoadUnitHandle(HH,id_target,SH_KHE_Indicator),'A0A1')==0 then
                                call UnitAddAbility(LoadUnitHandle(HH,id_target,SH_KHE_Indicator),'A0A1')
                        endif
                else
                        if GetUnitAbilityLevel(LoadUnitHandle(HH,id_target,SH_KHE_Indicator),'A0A1')==1 then
                                call UnitRemoveAbility(LoadUnitHandle(HH,id_target,SH_KHE_Indicator),'A0A1')
                        endif
                endif
        else
                call RemoveUnit(LoadUnitHandle(HH, id_target, SH_KHE_Indicator))
                call RemoveSavedHandle(HH, id_target, SH_KHE_Indicator)
                call FlushChildHashtable(HH, id)
                call DestroyTimer(GetExpiredTimer())
        endif
        set c=null
endfunction

function HassanE_AddStack takes unit newCaster, unit newTarget returns nothing
        local integer id_target = GetHandleId(newTarget)
        local integer KHEStack = LoadInteger(HH, id_target, SH_KHE_Stack)
        local unit c
        if KHEStack<5 and GetUnitAbilityLevel(newCaster, 'A1GR')>=1 then
                if IsUnitInvulnerable(newTarget)==false then
                        call SaveInteger(HH, id_target, SH_KHE_Stack, KHEStack+1)
                        if LoadUnitHandle(HH, id_target, SH_KHE_Indicator)==null then
                                set c = CreateUnit(GetOwningPlayer(newTarget), 'dKHE', GetUnitX(newTarget), GetUnitY(newTarget), 270)
                                call SetUnitScale(c, 2, 2, 2)
                                call SetUnitFlyHeight(c, GetUnitFlyHeight(newTarget)+300, 0)
                                call SaveUnitHandle(HH, id_target, SH_KHE_Indicator, c)
                                set bjLCT = CreateTimer()
                                call SaveUnitHandle(HH, GetHandleId(bjLCT), TargetHash, newTarget)
                                call TimerStart(bjLCT, 0.01, true, function HassanE_StackPeriodic)
                                set bjLCT = null
                        endif
                endif
        endif
        set c=null
endfunction

