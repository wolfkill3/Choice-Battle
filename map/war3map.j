function Trig_Bike_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A072' and udg_B==true
endfunction
function IsUnitBack_Bike takes unit uF,unit uWhichBack returns boolean
local real r1=bj_RADTODEG*Atan2(GetUnitY(uWhichBack)-GetUnitY(uF),GetUnitX(uWhichBack)-GetUnitX(uF))+360
local real r2=GetUnitFacing(uWhichBack)+360
return r1<=(r2+60)and r1>=(r2-60)
endfunction
function Trig_Bike_Actions3 takes nothing returns nothing
local unit e=GetEnumUnit()
local integer l__ide=GetHandleId(e)
local real dist=LoadReal(h,l__ide,1)
local real x=GetUnitX(e)
local real y=GetUnitY(e)
local real a=LoadReal(h,l__ide,0)
if dist<500 then
if IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
call SetUnitX(e,x+30*Cos(a))
call SetUnitY(e,y+30*Sin(a))
else
call SetUnitX(e,x+40*Cos(a/2))
call SetUnitY(e,y+40*Sin(a/2))
endif
call SaveReal(h,l__ide,1,dist+30)
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",x,y))
else
call GroupRemoveUnit(udg_Bike,e)
call RemoveSavedReal(h,l__ide,1)
call RemoveSavedReal(h,l__ide,0)
endif
set e=null
endfunction
function Trig_Bike_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,1)
local unit u=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,2)
local texttag tx=LoadTextTagHandle(h,id,5)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1
local real y1
local real x2
local real y2
local real a
local real fl=GetUnitFlyHeight(l__d)+75+(5.5*0.08)/10
local real f=GetUnitFacing(l__d)*bj_DEGTORAD
local player p=GetOwningPlayer(u)
local real dmg=GetHeroAgi(u,true)*0.5
local integer l__ide
if speed<30+GetHeroAgi(u,true)*0.1 and udg_B==true and IsUnitType(u,UNIT_TYPE_DEAD)==false and GetUnitAbilityLevel(u,'BUsl')==0 and GetUnitAbilityLevel(u,'BUsp')==0 and GetUnitAbilityLevel(u,'Bust')==0 then
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",x,y))
call SetUnitAnimation(l__d,"walk alternate")
if GetLocalPlayer()==p then
call SetTextTagVisibility(tx,true)
endif
call SetTextTagText(tx,I2S(R2I(speed))+Lng(" км/ч","km/h"),0.03)
call SetTextTagPosUnit(tx,l__d,0.03)
call SaveReal(h,id,2,speed+0.15)
call PauseUnit(l__d,false)
call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,false)
call PauseUnit(u,true)
call GroupEnumUnitsInRange(G,x,y,100,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
set l__ide=GetHandleId(E)
if IsUnitEnemy(E,p)and IsUnitType(E,UNIT_TYPE_STRUCTURE)==false and IsUnitInGroup(E,udg_Bike)==false and GetWidgetLife(E)>0 then
if IsUnitBack_Bike(u,E)==false and GetUnitAbilityLevel(l__d,'A073')==0 then
call myCustomDamage(u,E,speed*10+dmg,false,false,null,null,null)
elseif IsUnitBack_Bike(u,E)==true and GetUnitAbilityLevel(l__d,'A073')==0 then
call myCustomDamage(u,E,speed*10*1.3+dmg,false,false,null,null,null)
set n=CreateUnit(GetOwningPlayer(u),'hmpr',x,y,0)
call IssueTargetOrder(n,"cripple",E)
call UnitApplyTimedLife(n,'BTLF',1)
elseif IsUnitBack_Bike(u,E)==true and GetUnitAbilityLevel(l__d,'A073')>0 then
call myCustomDamage(u,E,speed*10*1.6+dmg,false,false,null,null,null)
set n=CreateUnit(GetOwningPlayer(u),'hmpr',x,y,0)
call IssueTargetOrder(n,"cripple",E)
call UnitApplyTimedLife(n,'BTLF',1)
elseif IsUnitBack_Bike(u,E)==false and GetUnitAbilityLevel(l__d,'A073')>0 then
call myCustomDamage(u,E,speed*10*1.3+dmg,false,false,null,null,null)
endif
set x1=GetUnitX(E)
set y1=GetUnitY(E)
call SaveReal(h,l__ide,0,Atan2(y1-y,x1-x))
call GroupAddUnit(udg_Bike,E)
call DestroyEffect(AddSpecialEffect(" ",x1,y1))
call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",x1,y1))
endif
call GroupRemoveUnit(G,E)
endloop
call ForGroup(udg_Bike,function Trig_Bike_Actions3)
if IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
if GetUnitAbilityLevel(l__d,'A073')>0 then
call SetUnitX(l__d,x+speed*1.25*Cos(f))
call SetUnitY(l__d,y+speed*1.25*Sin(f))
else
call SetUnitX(l__d,x+speed*Cos(f))
call SetUnitY(l__d,y+speed*Sin(f))
endif
call SetUnitFacing(l__d,f)
else
call SetUnitX(l__d,x+10*Cos(f/2))
call SetUnitY(l__d,y+10*Sin(f/2))
endif
else
call SetUnitXY_1(u,x,y, false)
call RemoveUnit(l__d)
call ShowUnit(u,true)
if(GetLocalPlayer()==p)then
call ClearSelection()
call SelectUnit(u,true)
endif
call PauseUnit(u,false)
call DestroyTextTag(tx)
call SetUnitInvulnerable(u,false)
call GroupClear(udg_Bike)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set tx=null
set t=null
set u=null
set l__d=null
endfunction
function Trig_Bike_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local player p=GetOwningPlayer(u)
local unit l__d=CreateUnit(p,'e02K',GetUnitX(u),GetUnitY(u),GetUnitFacing(u))
local integer id=GetHandleId(t)
local texttag l__txt=CreateTextTag()
call ShowUnit(u,false)
call SetUnitInvulnerable(u,true)
if(GetLocalPlayer()==p)then
call SetTextTagVisibility(l__txt,true)
call ClearSelection()
call SelectUnit(l__d,true)
endif
call SetTextTagText(l__txt,Lng("0 км/ч","0 km/h"),0.03)
call SetTextTagPosUnit(l__txt,l__d,20)
call SetUnitAnimation(l__d,"Spell One")
if GetUnitAbilityLevel(u,'B014')>0 then
call UnitAddAbility(l__d,'A073')
endif
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,l__d)
call SaveReal(h,id,2,1)
call SaveTextTagHandle(h,id,5,l__txt)
set soundplay=SndN(900) // Sound\Music\mp3Music\GintokiE.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.025,true,function Trig_Bike_Actions2)
set t=null
set u=null
set l__d=null
set p=null
set l__txt=null
endfunction
function HoshikudakiCond takes nothing returns boolean
return GetSpellAbilityId()=='A07A' and udg_B==true
endfunction
function MissleMoveHoshikudaki2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
local real dist=LoadReal(h,id,6)
local real mh=LoadReal(h,id,5)
local real rad=LoadReal(h,id,7)
local real rd=SR(x,y,x1,y1)
local real he=LoadReal(h,id,8)
local player p=GetOwningPlayer(l__d)
local integer idu=GetPlayerId(p)
local real speed=LoadReal(h,id,1)-GetUnitFlyHeight(l__d)*0.02
if rd>30+speed then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,ParabolaZ2(he,0,mh,dist,rd),0)
else
if IsUnitType(l__d,UNIT_TYPE_HERO)==false then
call KillUnit(l__d)
endif
call SetUnitFlyHeight(l__d,0,0)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set l__d=null
set t=null
endfunction
function MissleMoveHoshikudaki takes unit l__d,real speed,real angle,real x,real y,real mh,real r,real he returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,mh)
call SaveReal(h,id,6,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,7,r)
call SaveReal(h,id,8,he)
call TimerStart(t,0.03,true,function MissleMoveHoshikudaki2)
set t=null
endfunction
function HoshikudakiCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=LoadReal(h,id,5)
local real dmg=LoadReal(h,id,15)
local player p=GetOwningPlayer(u)
local real time=LoadReal(h,id,7)
local real mt=LoadReal(h,id,8)
local real ang=GetRandomReal(-1.1,1.1)
local real l__d
local real r
if mt>0 and UnitIsAlive(u)and UnitIsAlive(c)then
set x1=x1-40*Cos(a)
set y1=y1-40*Sin(a)
call SetUnitXY_1(u,x1,y1, false)
if time<0 then
set x1=x1+53*Cos(a)
set y1=y1+53*Sin(a)
call SetUnitXY_1(c,x1,y1, false)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",c,"chest"))
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",c,"chest"))
set n=CreateUnit(p,'e0OI',x1,y1,GetRandomReal(0,359))
set l__d=GetRandomReal(100,450)
set r=GetRandomReal(0,7)
call MissleMoveHoshikudaki(n,GetRandomReal(9,15),0,x1+l__d*Cos(r),y1+l__d*Sin(r),GetRandomReal(150,350),0,75)
set n=CreateUnit(p,'e0S8',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.3)
call SetUnitVertexColor(n,190,255,255,50)
call SetUnitAnimation(n,"attack")
set n=CreateUnit(p,'e0H9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.7)
call SetUnitVertexColor(n,200,200,200,70)
call SaveReal(h,id,7,mt)
call SaveReal(h,id,8,mt-0.12)
endif
call SetUnitFacing(u,a*bj_RADTODEG)
call PauseUnit(u,true)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call SaveReal(h,id,7,LoadReal(h,id,7)-3)
else
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call SetUnitInvulnerable(c,false)
if GetUnitAbilityLevel(u,'B014')==0 then
call myCustomDamage(u,c,dmg,false,false,null,null,null)
else
call myCustomDamage(u,c,dmg,false,false,null,null,null)
call PoisonDamage3(u,c,dmg,10,"Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl","chest")
endif
call Push3(c,35,a,600,"war3mapImported\\BloodEX.mdx")
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitVertexColor(u,255,255,255,255)
call FlushChildHashtable(h,id)
call SetUnitTimeScale(u,1)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function HoshikudakiCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call PauseUnit(u,true)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveReal(h,id,7,10)
call SaveReal(h,id,8,10)
call SaveReal(h,id,15,(11+GetUnitAbilityLevel(u,'A076'))*GetHeroAgi(u,true))
call SaveReal(h,id,5,Atan2(y1-y,x1-x))
call SetUnitXY_1(u,x1,y1, false)
call SetUnitVertexColor(u,255,255,255,125)
call SetUnitTimeScale(u,3)
call SetUnitInvulnerable(u,true)
call SetUnitInvulnerable(c,true)
call SetUnitAnimation(u,"Spell slam one")
call SaveInteger(h,id,12,GetUnitAbilityLevel(u,'A076'))
set soundplay=SndN(902) // Sound\Music\mp3Music\Hoshikudaki.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.04,true,function HoshikudakiCast2)
set t=null
set u=null
set p=null
set c=null
endfunction
function Trig_Uri_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A08C'
endfunction
function ParabolaZ_Uri takes real l__h,real l__d,real x returns real
return(4*l__h/l__d)*(l__d-x)*(x/l__d)
endfunction
function SR_Uri takes real xa,real ya,real xb,real yb returns real
return SquareRoot((xa-xb)*(xa-xb)+(ya-yb)*(ya-yb))
endfunction
function Trig_Uri_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real a
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local real f=GetUnitFacing(u)
local group g=CreateGroup()
local player p=GetOwningPlayer(u)
local real dmg=GetHeroInt(u,true)*12
local real dist=SR_Uri(x,y,x1,y1)
local unit l__n
if(dist>26.00)then
set a=Atan2(y1-y,x1-x)
call SetUnitX(l__d,x+42*Cos(a))
call SetUnitY(l__d,y+42*Sin(a))
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,ParabolaZ_Uri(250,LoadReal(h,id,4),dist),0)
else
call GroupEnumUnitsInRange(g,x1,y1,350,Base)
loop
set E=FirstOfGroup(g)
exitwhen E==null
if Condition_Base(p,E) then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(g,E)
endloop
call UnitApplyTimedLife(CreateUnit(p,'e034',x1,y1,0),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e033',x1,y1,0),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e036',x1,y1,0),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e036',x1,y1,0),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e036',x1,y1,0),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e036',x1,y1,0),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e048',x1,y1,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e048',x1,y1,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e048',x1,y1,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e03W',x1,y1,0),'BTLF',4)
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
endif
call DestroyGroup(g)
set u=null
set l__d=null
set l__n=null
set t=null
set g=null
set p=null
endfunction
function Trig_Uri_Actions takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real f=GetUnitFacing(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,CreateUnit(GetOwningPlayer(u),'e035',x+50*Cos(f*bj_DEGTORAD),y+50*Cos(f*bj_DEGTORAD),f))
call SaveReal(h,id,2,x1)
call SaveReal(h,id,3,y1)
call SaveReal(h,id,4,SR_Uri(x,y,x1,y1))
call TimerStart(t,0.025,true,function Trig_Uri_Actions2)
set soundplay=SndN(904) // Sound\Music\mp3Music\Uri.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set u=null
set t=null
endfunction
function Trig_Hurricane_Arrow_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A089'
endfunction
function SR_Hurricane_Arrow takes real xa,real ya,real xb,real yb returns real
return SquareRoot((xa-xb)*(xa-xb)+(ya-yb)*(ya-yb))
endfunction
function Trig_Hurricane_Arrow_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local group g=LoadGroupHandle(h,id,4)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,5)
local integer l__idg=GetHandleId(g)
local integer l__ide
local player p=GetOwningPlayer(u)
local real dmg=LoadReal(h,id,13)
if SR_Hurricane_Arrow(x,y,x1,y1)<=3250 then
call SetUnitX(l__d,x1+65*Cos(a))
call SetUnitY(l__d,y1+65*Sin(a))
call GroupEnumUnitsInRange(g,x1,y1,220,Base)
loop
set E=FirstOfGroup(g)
set l__ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E) and E!=LoadUnitHandle(h,l__idg,l__ide) then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,l__idg,l__ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
call UnitApplyTimedLife(CreateUnit(p,'e02W',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e030',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e047',x1,y1,a*bj_RADTODEG),'BTLF',1)
else
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
call DestroyTimer(t)
call DestroyGroup(g)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function Trig_Hurricane_Arrow_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
call SaveUnitHandle(h,id,0,u)
set n=CreateUnit(GetOwningPlayer(u),'e0YD',x+80*Cos(f*bj_DEGTORAD),y+80*Sin(f*bj_DEGTORAD),f)
call SaveUnitHandle(h,id,1,n)
call SetUnitScale(n,3,3,3)
call SetUnitFlyHeight(n,75,0)
call SaveGroupHandle(h,id,4,CreateGroup())
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveReal(h,id,5,a)
call SaveReal(h,id,13,GetHeroInt(u,true)*(GetUnitAbilityLevel(u,'A089')+4))
call SetUnitFacing(LoadUnitHandle(h,id,1),a*bj_RADTODEG)
set soundplay=SndN(906) // Sound\Music\mp3Music\TornadoFlameArrow.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.03,true,function Trig_Hurricane_Arrow_Actions2)
set u=null
set t=null
endfunction
function Trig_CAI_Armor_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A088'
endfunction
function Trig_CAI_Armor_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local unit d1=LoadUnitHandle(h,id,2)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
if GetUnitAbilityLevel(u,'B01G')>0 then
call SetUnitX(l__d,x+100*Cos((f+45)*bj_DEGTORAD))
call SetUnitY(l__d,y+100*Sin((f+45)*bj_DEGTORAD))
call SetUnitX(d1,x+100*Cos((f-45)*bj_DEGTORAD))
call SetUnitY(d1,y+100*Sin((f-45)*bj_DEGTORAD))
call SetUnitFacing(l__d,f+45)
call SetUnitFacing(d1,f-45)
else
call RemoveUnit(l__d)
call RemoveUnit(d1)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set d1=null
set u=null
set l__d=null
set t=null
endfunction
function Trig_CAI_Armor_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit l__d
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,CreateUnit(GetOwningPlayer(u),'e02Z',x+100*Cos((f+45)*bj_DEGTORAD),y+100*Sin((f+45)*bj_DEGTORAD),f+45))
call SaveUnitHandle(h,id,2,CreateUnit(GetOwningPlayer(u),'e02Z',x+100*Cos((f-45)*bj_DEGTORAD),y+100*Sin((f-45)*bj_DEGTORAD),f-45))
call TimerStart(t,0.025,true,function Trig_CAI_Armor_Actions2)
