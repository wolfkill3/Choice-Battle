loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function CastBenihiko)
call TriggerAddCondition(t,Condition(function CondBenihiko))
set t=null
endfunction
function TousenSleepCastLoop takes nothing returns nothing
        local integer id = GetHandleID()
        local real x=LoadReal(HH,id,SH_x)
        local real y=LoadReal(HH,id,SH_y)
        local real dmg=GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash),'A0J6') * GetHeroAgi(LoadUnitHandle(HH,MUIHandle(),CasterHash),true)+75
        local real dist=LoadReal(HH,id,SH_dist)
        if dist <= 1000 then
                call SaveReal(HH, id, SH_dist, dist + 50.)
                if dist >= 600. then
                        call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash),false)
                        call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash),false)
                else
                        call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash),true)
                        call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash),true)
                endif 
                call GroupClear(DG)
                call GroupEnumUnitsInRange(DG,x,y,dist,Base)
                loop
                        set E=FirstOfGroup(DG)
                        exitwhen E==null
                        if Condition_Base(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)),E) and IsUnitInGroup(E, LoadGroupHandle(HH,id,GroupHash)) == false then
                                call IssueImmediateOrder(E, "stop")
                                call myCustomDamage(LoadUnitHandle(HH,MUIHandle(),CasterHash),E,dmg,false,false,null,null,null)
                if IsUnitInvulnerable(E)==false then
                call SetControlToUnit(E,E,4,"sleep")
				call SetUnitAnimation(E,"Death")
                endif
                                call GroupAddUnit(LoadGroupHandle(HH,id,GroupHash), E)
                        endif
                        call GroupRemoveUnit(DG,E)
                endloop
        else
                call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash),false)
                call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash),false)
                call GroupClear(LoadGroupHandle(HH,id,GroupHash))
                call DestroyGroup(LoadGroupHandle(HH,id,GroupHash))
                call RemoveSavedHandle(HH,id,GroupHash)
                call RemoveSavedHandle(HH,id,CasterHash)
                call Clear(id)
        endif
endfunction
function TousenSleepCast takes unit u returns nothing
        local integer hId = GetPlayerId(GetTriggerPlayer())
        local integer id = NewTimer(hId) //
        local real x = GetUnitX(u)
        local real y = GetUnitY(u)
        call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e0DZ',x,y,GetRandomReal(0,359)),'BTLF',1)
        call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e06G',x,y,GetRandomReal(0,359)),'BTLF',1)
        call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e0E1',x,y,GetRandomReal(0,359)),'BTLF',1)
        set soundplay=SndN(1361) // Sound\Music\mp3Music\Suzumushi.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        call CinematicFadeBJCustom(bj_CINEFADETYPE_FADEIN,2,"ReplaceableTextures\\CameraMasks\\Black_mask.blp",255,255,255,0)
        set n = CreateUnit(GetOwningPlayer(u),'e0J8',x,y,0)
        call UnitApplyTimedLife(n,'BTLF',1)
        call SetUnitTimeScale(n,.1)
        call SaveAgentHandle(HH,id,CasterHash,u)
        call SaveAgentHandle(HH,id,GroupHash,CreateGroup())
        call SaveReal(HH,id,SH_dist,0.)
        call SaveReal(HH,id,SH_x,x)
        call SaveReal(HH,id,SH_y,y)
        call TimerStart(LoadTimer(hId),.03,true,function TousenSleepCastLoop)
endfunction

function TousenSleepCond takes nothing returns nothing
        if GetSpellAbilityId()=='A0J6' and udg_B==true and DU2==true then
                call TousenSleepCast(GetTriggerUnit())
        endif
endfunction

function TousenSleepInit takes nothing returns nothing
        call GetUnitEvent(CreateTrigger(), EVENT_PLAYER_UNIT_SPELL_EFFECT,function TousenSleepCond)
endfunction

function EnmaKorogiCond takes nothing returns boolean
