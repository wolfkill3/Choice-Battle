function BlackGokuGFastAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local integer cjlocgn_00000000
set time=time+0.02
call SaveReal(HH,id,5,time)
if time==0.02 then



call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'BGG1',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'BGG2',true)



call SaveBoolean(HH,GetHandleId(caster),SH_BGRose,true)
call EffectCreateAndMove(true,"BlackGoku\\aZ_siwen_Pink.mdl",GetRandomReal(0,360),1,1.25,0.4,100,100,100,0,100,caster,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",GetRandomReal(0,360),1,1.5,0.8,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\bymutou-hongse-pink.mdl",GetRandomReal(0,360),1,1,1.5,100,100,100,0,50,caster,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\byakuya-7.mdl",GetRandomReal(0,360),1,1.25,0.8,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMoveAn(true,"BlackGoku\\flowermoonEff (83).mdl",facing,1,2,1,100,100,100,0,0,caster,0,facing,2)
call SaveBoolean(HH,GetHandleId(caster),SH_BGG,true)
set cjlocgn_00000000=LoadInteger(HH,GetHandleId(caster),BGRageIHash)
call SetHeroStr(caster,GetHeroStr(caster,false)+8+8*cjlocgn_00000000,true)
call SetHeroAgi(caster,GetHeroAgi(caster,false)+8+8*cjlocgn_00000000,true)
call SetHeroInt(caster,GetHeroInt(caster,false)+8+8*cjlocgn_00000000,true)
call SaveInteger(HH,id,30,cjlocgn_00000000)


endif
if time>0.02 and (LoadBoolean(HH,GetHandleId(caster),SH_BGRose)==false or udg_B==false or DU2==false)then

call SetHeroStr(caster,GetHeroStr(caster,false)-8-8*LoadInteger(HH,id,30),true)
call SetHeroAgi(caster,GetHeroAgi(caster,false)-8-8*LoadInteger(HH,id,30),true)
call SetHeroInt(caster,GetHeroInt(caster,false)-8-8*LoadInteger(HH,id,30),true)
call SetUnitAbilityLevel(caster,'BGC1',1)
call UnitRemoveAbility(caster,'ABG1')
call UnitAddAbility(caster,'ABG0')
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
set caster=null
endfunction
