call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function Trig_PriestessBow_Conditions))
call TriggerAddAction(t,function Trig_PriestessBow_Actions)
set t=null
endfunction
