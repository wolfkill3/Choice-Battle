call SaveReal(h,id,3,GetUnitY(u))
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,1,CreateGroup())
set soundplay=SndN(886) // Sound\Music\mp3Music\MoriaKishishishis.wav
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,.03,true,function Trig_Steal_Shadow_Actions2)
set u=null
set t=null
endfunction
