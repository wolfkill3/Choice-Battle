if dist>100.00 and time<2 then
call SetUnitX(u,x+(65-he2*0.05)*Cos(a))
call SetUnitY(u,y+(65-he2*0.05)*Sin(a))
call SetUnitFacing(u,a*bj_RADTODEG)
set he=ParabolaZ(600,SR(x1,y1,x2,y2),dist)
call SetUnitFlyHeight(u,he,0)
call SaveReal(h,id,9,time+0.02)
else
call SetUnitTimeScale(u,0.1)
call PauseTimer(t)
call SaveReal(h,id,5,0.1)
call TimerStart(t,0.03,true,function ShieldaWCast3)
endif
set u=null
set t=null
set p=null
endfunction
function ShieldaWCast takes nothing returns nothing
