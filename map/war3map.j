function InitTrig_LVL takes nothing returns nothing
set gg_trg_LVL=CreateTrigger()
call TriggerRegisterPlayerChatEvent(gg_trg_LVL,Player(0),"-lvlamir",true)
call TriggerRegisterPlayerChatEvent(gg_trg_LVL,Player(1),"-lvlamir",true)
call TriggerRegisterPlayerChatEvent(gg_trg_LVL,Player(2),"-lvlamir",true)
call TriggerRegisterPlayerChatEvent(gg_trg_LVL,Player(3),"-lvlamir",true)
call TriggerRegisterPlayerChatEvent(gg_trg_LVL,Player(4),"-lvlamir",true)
call TriggerRegisterPlayerChatEvent(gg_trg_LVL,Player(5),"-lvlamir",true)
call TriggerRegisterPlayerChatEvent(gg_trg_LVL,Player(6),"-lvlamir",true)
call TriggerRegisterPlayerChatEvent(gg_trg_LVL,Player(7),"-lvlamir",true)
call TriggerRegisterPlayerChatEvent(gg_trg_LVL,Player(8),"-lvlamir",true)
call TriggerRegisterPlayerChatEvent(gg_trg_LVL,Player(9),"-lvlamir",true)
//call TriggerRegisterPlayerChatEvent(gg_trg_LVL,Player(10),"-lvlamir",true)
//call TriggerRegisterPlayerChatEvent(gg_trg_LVL,Player(11),"-lvlamir",true)
call TriggerAddCondition(gg_trg_LVL,Condition(function Trig_test_Condition))
call TriggerAddAction(gg_trg_LVL,function Trig_LVL_Actions)
endfunction
function InitTrig_setmr takes nothing returns nothing
    set gg_trg_setmr=CreateTrigger()
    call TriggerRegisterPlayerChatEvent(gg_trg_setmr,Player(0),"-setmr ",false)
    call TriggerRegisterPlayerChatEvent(gg_trg_setmr,Player(1),"-setmr ",false)
