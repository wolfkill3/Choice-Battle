function GintokiKamehamehaCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real a=LoadReal(h,id,11)
local real dist=LoadReal(h,id,2)
local real x=GetUnitX(l__d)+50*Cos(a)
local real y=GetUnitY(l__d)+50*Sin(a)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real dmg=LoadReal(h,id,4)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,12)
if dist>0 and RectContainsUnit(WorldBoundsR(),l__d)and UnitIsAlive(l__d)then
call SetUnitInvulnerable(u,true)
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitXY_1(l__d,x,y, false)
set n=CreateUnit(p,'e0B2',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitVertexColor(n,40,180,255,50)
set n=CreateUnit(p,'e0B2',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,2,2,2)
call SetUnitVertexColor(n,30,200,255,35)
set n=CreateUnit(p,'e0B2',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,2.5,2.5,2.5)
call SetUnitVertexColor(n,20,220,255,20)
set n=CreateUnit(p,'e0C0',x,y,a*bj_RADTODEG)
call SetUnitScale(n,1.5,1.5,1.5)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,60)
set n=CreateUnit(p,'e0CT',x,y,a*bj_RADTODEG)
call SetUnitScale(n,1.5,1.5,1.5)
call UnitApplyTimedLife(n,'BTLF',2)
call GroupEnumUnitsInRange(g,x,y,250,Base)
set idg=GetHandleId(g)
call SaveReal(h,id,2,dist-50)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
else
call GroupEnumUnitsInRange(g,x,y,450,Base)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
call UnitApplyTimedLife(CreateUnit(p,'e0C4',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0C5',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0CC',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0CD',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0C6',x,y,(a*bj_RADTODEG)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e0C7',x,y,(a*bj_RADTODEG)),'BTLF',6)
call ShakeCamera(0.5,20)
call SetUnitTimeScale(u,1)
call StartSound(soundStr[47])
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
call RemoveUnit(l__d)
call FlushChildHashtable(h,GetHandleId(g))
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
function GintokiKamehamehaCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
//local real x1=LoadReal(h,id,5)
