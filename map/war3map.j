function SunStrikeCond takes nothing returns boolean
return GetSpellAbilityId()=='A0WN' and udg_B==true and GetUnitTypeId(GetTriggerUnit())!='H007' and GetUnitAbilityLevel(GetTriggerUnit(),'GIE1')==0
endfunction
function SunStrikeCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=LoadReal(h,id,3)
local real y=LoadReal(h,id,4)
local real dmg=4*(GetHeroStr(u,true)+GetHeroAgi(u,true)+GetHeroInt(u,true))
local player p=GetOwningPlayer(u)
local boolean fast_cd = true
local integer i=6
call GroupEnumUnitsInRange(G,x,y,300,Base)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\SunStrikeImpact0.wav",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
//call DestroyEffect(AddSpecialEffect("SunStrikeImpact2.MDX",x,y))
set n=CreateUnit(GetOwningPlayer(u), 'dA05', x, y, GetRandomInt(0, 360))
call SetUnitScale(n, 1.4, 1.4, 1.4)
call MyRemoveUnit(n, 1.5)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
set fast_cd = false
endif
call GroupRemoveUnit(G,E)
endloop
if fast_cd then
    loop
        if GetItemTypeId(UnitItemInSlot(u, i)) ==  'I044' then
            call SetItemRemainingCooldown(UnitItemInSlot(u, i),GetItemRemainingCooldown(UnitItemInSlot(u, i))-4)
        endif
    exitwhen i == 0
    set i=i - 1
    endloop
endif
call DestroyEffect(LoadEffectHandle(h,id,6))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set p=null
set u=null
set t=null
endfunction
function SunStrikeCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local integer i=0
local player p=GetOwningPlayer(u)
local string e=""
if RectContainsCoords(gg_rct_AntiMh,x,y)==false then
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
if(GetLocalPlayer()==p)then
set e="SunStrikeCharge.MDX"
endif
set soundplay=CreateSound("Sound\\Music\\mp3Music\\SunStrikeCast.wav",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call SaveEffectHandle(h,id,6,AddSpecialEffect(e,x,y))
set n=CreateUnit(p,0x68303449,x,y,0)
call UnitApplyTimedLife(n,0,2)
call UnitAddAbility(n,0x4130574F)
call IssuePointOrder(n,"flare",x,y)
call TimerStart(t,1.7,false,function SunStrikeCast2)
endif
set u=null
set p=null
set t=null
endfunction
