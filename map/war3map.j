function HashiramaFRangeAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local group gr=LoadGroupHandle(HH,id,4)
if SR(GetUnitX(LoadUnitHandle(HH,id,1)),GetUnitY(LoadUnitHandle(HH,id,1)),GetUnitX(GetEnumUnit()),GetUnitY(GetEnumUnit()))>450 then
call GroupRemoveUnit(gr,GetEnumUnit())
call UnitRemoveAbility(GetEnumUnit(),'AHSF')
call UnitRemoveAbility(GetEnumUnit(),'BHSF')
call SaveGroupHandle(HH,id,4,gr)
endif
set t=null
set gr=null
endfunction
function HashiramaFAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local group gr=LoadGroupHandle(HH,id,4)
local real distance=LoadReal(HH,id,8)
local real time=LoadReal(HH,id,5)
set time=time+0.02
call SaveReal(HH,id,5,time)
if(OrderId2String(GetUnitCurrentOrder(caster))!="drain")then
loop
set n0=FirstOfGroup(gr)
exitwhen n0==null
call UnitRemoveAbility(n0,'AHSF')
call UnitRemoveAbility(n0,'BHSF')
call GroupRemoveUnit(gr,n0)
endloop
if LoadGroupHandle(HH,id,4)!=null then
call DestroyGroup(LoadGroupHandle(HH,id,4))
call SaveGroupHandle(HH,id,4,null)
endif
call SetUnitAnimationByIndex(LoadUnitHandle(HH,id,20),2)
call MyRemoveUnit(LoadUnitHandle(HH,id,20),2)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
else
if time==0.02 then
call UnitCreateAndMove(caster,'hs12',caster,GetRandomReal(0,360),1,1.5,0.5,100,100,100,20,0,LoadUnitHandle(HH,id,1),0,facing)
call UnitCreateAndMove(caster,'hs18',caster,GetRandomReal(0,360),1,1.5,0.5,100,100,100,20,0,LoadUnitHandle(HH,id,1),0,facing)
set n0=CreateUnit(GetOwningPlayer(caster),'hs27',GetUnitX(caster),GetUnitY(caster),facing)
call UnitSize(n0,1.2,1,1)
call UnitSpeed(n0,1.5)
call SetUnitAnimationByIndex(n0,1)
call SaveUnitHandle(HH,id,20,n0)
call SetUnitPathing(caster,true)
endif
if time==1 or time==2 or time==3 then
call UnitCreateAndMove(caster,'hs05',caster,GetRandomReal(0,360),1,1.5,0.5,100,100,100,20,0,LoadUnitHandle(HH,id,1),0,facing)
call UnitCreateAndMove(caster,'hs16',caster,GetRandomReal(0,360),1,1.5,0.5,100,100,100,20,0,LoadUnitHandle(HH,id,1),0,facing)
endif
if time<4 then
call MoveUnit(caster,LoadUnitHandle(HH,id,20),0,facing)
call GroupClear(G)
call GroupEnumUnitsInRange(G,GetUnitX(caster),GetUnitY(caster),450,null)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if IsUnitAlly(n0,GetOwningPlayer(caster))==true and IsUnitInGroup(n0,gr)==false and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false then
call UnitAddAbility(n0,'AHSF')
call GroupAddUnit(gr,n0)
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
call SaveGroupHandle(HH,id,4,gr)
call ForGroup(gr,function HashiramaFRangeAct)
if time>0.3 then
call GroupClear(G)
call GroupEnumUnitsInRange(G,GetUnitX(caster),GetUnitY(caster),450,null)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
set facing=Angle2(GetUnitX(caster),GetUnitY(caster),GetUnitX(n0),GetUnitY(n0))
if SR(GetUnitX(caster),GetUnitY(caster),GetUnitX(n0),GetUnitY(n0))<500 then
if SR(GetUnitX(caster),GetUnitY(caster),GetUnitX(n0),GetUnitY(n0))>400 then
call MoveAoe1(GetUnitX(caster),GetUnitY(caster),n0,400,facing)
endif
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
endif
endif
endif
set t=null
set gr=null
set caster=null
endfunction


function HashiramaGAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
if time==0 then
call PauseUnit(caster,false)
call CreateModeIndicatorWithPauseForm(caster, "ReplaceableTextures\\CommandButtons\\BTNHashiramaG.blp", 20.0)
//call UnitStop(caster)
endif
if IsUnitPaused(caster)==false then
set time=time+0.02
call SaveReal(HH,id,5,time)
endif



if time>0.02 then
call MoveUnit(caster,LoadUnitHandle(HH,id,20),0,GetUnitFacing(caster))
call SetUnitFlyHeight(LoadUnitHandle(HH,id,20),GetUnitFlyHeight(caster),0)
endif
if time==20 then
call SetUnitAbilityLevel(caster,'HSC1',1)
call UnitAddAbility(caster,'HSMD')
call SetUnitAbilityLevel(caster,'HSMD',2)
call UnitRemoveAbility(caster,'HSMD')
call SaveBoolean(HH,GetHandleId(caster),SH_HashReg,false)
call RemoveUnit(LoadUnitHandle(HH,id,20))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set t=null
set caster=null
endfunction



function HashiramaRSelfDragon1 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local unit target=LoadUnitHandle(HH,id,2)
local real facing=LoadReal(HH,id,3)
local real distance=SR(GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),GetUnitX(LoadUnitHandle(HH,id,2)),GetUnitY(LoadUnitHandle(HH,id,2)))
local real time=LoadReal(HH,id,5)
local real time42=LoadReal(HH,id,42)
local boolean dist0=LoadBoolean(HH,id,19)
local real cjlocgn_00000000

//call myCustomDamage(caster,target,LoadReal(HH,id,15)*0.35,false,false,null,null,null)


set time42=time42+0.02
call SaveReal(HH,id,42,time42)
if time42==20 then
call SaveReal(HH,GetHandleId(caster),SH_HashiramaR,0)
call RemoveUnit(LoadUnitHandle(HH,id,20))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif


if distance<40 and dist0==false then
call UnitAddAbility(target,'AMUD')
call UnitRemoveAbility(target,'AMUD')
set dist0=true
call SaveBoolean(HH,id,19,true)
call SetUnitAnimationByIndex(LoadUnitHandle(HH,id,20),1)
call UnitCreateAndMove(caster,'hs03',caster,GetRandomReal(0,360),1,1,1,100,100,100,30,0,LoadUnitHandle(HH,id,2),0,facing)
endif
if distance>40 and dist0==false then
set n0=LoadUnitHandle(HH,id,20)
set facing=Angle2(GetUnitX(n0),GetUnitY(n0),GetUnitX(LoadUnitHandle(HH,id,2)),GetUnitY(LoadUnitHandle(HH,id,2)))
call SetUnitFacing(n0,facing)
call MoveUnit(n0,n0,40,facing)
set n0=null
endif
if dist0==true then
if IsUnitPaused(target)==false then
set time=time+0.02
call SaveReal(HH,id,5,time)
endif
if time==3 or GetUnitAbilityLevel(target,'BMUR')==0 then
call UnitRemoveAbility(LoadUnitHandle(HH,id,2),'BMUR')
call SaveReal(HH,GetHandleId(caster),SH_HashiramaR,0)
call RemoveUnit(LoadUnitHandle(HH,id,20))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
else
if time==1 then
call UnitSpeed(LoadUnitHandle(HH,id,20),2)
call SetUnitAnimationByIndex(LoadUnitHandle(HH,id,20),2)
endif
set cjlocgn_00000000=LoadReal(HH,id,6)
set cjlocgn_00000000=cjlocgn_00000000+0.02
if cjlocgn_00000000==1 or time==0.02 then
call UnitCreateAndMove(caster,'hs16',caster,GetRandomReal(0,360),1,1,0.5,100,100,100,40,0,target,0,facing)
set cjlocgn_00000000=0
call myCustomDamage(caster,target,LoadReal(HH,id,15)*0.35,false,false,null,null,null)
call SetControlToUnit(caster,target, 1, "stun")
call SetUnitState(target,UNIT_STATE_MANA,GetUnitState(target,UNIT_STATE_MANA)-GetUnitState(target,UNIT_STATE_MAX_MANA)*(0.03+0.01*LoadInteger(HH,id,14)))
set time=time+0.02
call SaveReal(HH,id,5,time)
endif
call SaveReal(HH,id,6,cjlocgn_00000000)
call SetUnitFacing(LoadUnitHandle(HH,id,20),GetUnitFacing(target))
call SetUnitFlyHeight(LoadUnitHandle(HH,id,20),GetUnitFlyHeight(caster),0)
call MoveUnit(target,LoadUnitHandle(HH,id,20),0,GetUnitFacing(caster))
endif
endif
set t=null
set caster=null
set target=null
endfunction
function HashiramaRSelfDragon takes integer lvlabil,unit caster0,unit dragon0,unit target0,real damage0 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(HH,id,1,caster0)
call SaveUnitHandle(HH,id,2,target0)
call SaveUnitHandle(HH,id,20,dragon0)
call SaveReal(HH,id,15,damage0)
call SaveInteger(HH,id,14,lvlabil)
//call myCustomDamage(caster0,target0,damage0,false,false,null,null,null)
call SetUnitAnimationByIndex(dragon0,0)
call SetUnitFlyHeight(dragon0,100,0)
call RemoveSavedHandle(HH,GetHandleId(caster0),SH_HashiramaRTarget)
set soundplay=SndN(3570) // Sound\Music\mp3Music\HashiramaRSelf2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
//call RemoveSavedHandle(HH,GetHandleId(caster0),StringHash("HashiramaR"))
call TimerStart(t,0.02,true,function HashiramaRSelfDragon1)
set caster0=null
set dragon0=null
set target0=null
set t=null
endfunction
function HashiramaRSelfAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real distance=LoadReal(HH,id,8)
local real time=LoadReal(HH,id,5)
if time>1 then
if IsUnitPaused(caster)==false then
set time=time+0.02
call SaveReal(HH,id,5,time)
endif
else
set time=time+0.02
call SaveReal(HH,id,5,time)
endif
if time>1 and LoadReal(HH,GetHandleId(caster),SH_HashiramaR)>0 then
set n0=LoadUnitHandle(HH,GetHandleId(caster),SH_HashiramaRTarget)

call HashiramaRSelfDragon(LoadInteger(HH,id,14),caster,LoadUnitHandle(HH,id,20),n0,LoadReal(HH,GetHandleId(caster),SH_HashiramaR)+LoadReal(HH,id,15))



call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
if time==7 then
call RemoveSavedHandle(HH,GetHandleId(caster),SH_HashiramaR)
call MyRemoveUnit(LoadUnitHandle(HH,id,20),2)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
else
if time==0.02 then
call SetUnitAnimationByIndex(caster,11)
call UnitCreateAndMove(caster,'hs05',caster,GetRandomReal(0,360),1,3,1,100,100,100,0,100,caster,0,facing)
call UnitCreateAndMove(caster,'hs03',caster,GetRandomReal(0,360),1,1.5,1,100,100,100,0,0,caster,0,facing)
call UnitCreateAndMove(caster,'hs16',caster,GetRandomReal(0,360),1,0.9,0.5,100,100,100,30,0,caster,0,facing)
call UnitCreateAndMove(caster,'hs15',caster,GetRandomReal(0,360),1,1.5,1.75,100,100,100,30,0,caster,0,facing)
endif
if time<1 then
call PauseUnit(caster,true)
endif
if time==1 then
call SaveReal(HH,GetHandleId(caster),SH_HashiramaR,-100)
call PauseUnit(caster,false)
call SetUnitPathing(caster,true)
set n0=CreateUnit(GetOwningPlayer(caster),'hs29',GetUnitX(caster),GetUnitY(caster),GetUnitFacing(caster))
call SetUnitFlyHeight(n0,0,0)
call UnitSize(n0,1.25,1,1)
call UnitSpeed(n0,1.5)
call SetUnitAnimationByIndex(n0,9)
call SaveUnitHandle(HH,id,20,n0)
set n0=null
call UnitCreateAndMove(caster,'hs01',caster,GetRandomReal(0,360),1,1.5,0.75,100,100,100,0,0,caster,0,facing)
call UnitCreateAndMove(caster,'hs02',caster,GetRandomReal(0,360),1,1.5,0.5,100,100,100,0,0,caster,0,facing)
call UnitCreateAndMove1(caster,'hs17',caster,GetRandomReal(0,360),1,1.5,0.5,100,100,100,0,0,caster,0,facing,3)
endif
endif
set t=null
set caster=null
endfunction


function HashiramaRAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real distance=LoadReal(HH,id,8)
local real time=LoadReal(HH,id,5)
set time=time+0.02
call SaveReal(HH,id,5,time)
if time==1.2 then
call UnitCreateAndMove(caster,'hs22',caster,GetRandomReal(0,360),1,2.5,0.75,100,100,100,0,0,LoadUnitHandle(HH,id,20),0,facing)
call UnitCreateAndMove(caster,'hs19',caster,GetRandomReal(0,360),1.5,2,0.8,100,100,100,0,0,LoadUnitHandle(HH,id,20),0,facing)
call UnitCreateAndMove(caster,'hs01',caster,GetRandomReal(0,360),1,3,1,100,100,100,0,0,LoadUnitHandle(HH,id,20),0,facing)
call UnitCreateAndMove(caster,'hs02',caster,GetRandomReal(0,360),1,2.5,0.5,100,100,100,0,0,LoadUnitHandle(HH,id,20),0,facing)
call UnitCreateAndMove(caster,'hs03',caster,GetRandomReal(0,360),1.5,3,0.8,100,100,100,0,0,LoadUnitHandle(HH,id,20),0,facing)
call GroupClear(G)
call GroupEnumUnitsInRange(G,LoadReal(HH,id,11),LoadReal(HH,id,12),400,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if Condition_Base(GetOwningPlayer(caster),n0) then
call myCustomDamage(caster,n0,LoadReal(HH,id,15),false,false,null,null,null)
call SetControlToUnit(caster,n0, 2, "stun")
call SetUnitState(n0,UNIT_STATE_MANA,GetUnitState(n0,UNIT_STATE_MANA)-GetUnitState(n0,UNIT_STATE_MAX_MANA)*0.04*GetUnitAbilityLevel(caster,'HSR1'))
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
call MyRemoveUnit(LoadUnitHandle(HH,id,20),2)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
else
if time==0.02 then
call UnitCreateAndMove(caster,'hs02',caster,GetRandomReal(0,360),1,1.5,1,100,100,100,0,0,caster,0,facing)
call UnitCreateAndMove(caster,'hs12',caster,GetRandomReal(0,360),1,1.25,1,100,100,100,30,0,caster,0,facing)
call UnitCreateAndMove(caster,'hs15',caster,GetRandomReal(0,360),1,1.5,1.75,100,100,100,30,0,caster,0,facing)
endif
if time<0.5 then
call PauseUnit(caster,true)
endif
if time==0.5 then
call PauseUnit(caster,false)
call SetUnitPathing(caster,true)
set n0=CreateUnit(GetOwningPlayer(caster),'hs29',LoadReal(HH,id,11),LoadReal(HH,id,12),facing)
call SetUnitFlyHeight(n0,0,0)
call UnitSize(n0,2,1,1)
call UnitSpeed(n0,1.5)
call SetUnitAnimationByIndex(n0,1)
call SaveUnitHandle(HH,id,20,n0)
call UnitCreateAndMove(caster,'hs20',caster,GetRandomReal(0,360),1,3,1,100,100,100,0,0,LoadUnitHandle(HH,id,20),0,facing)
call UnitCreateAndMove(caster,'hs16',caster,GetRandomReal(0,360),1,1.5,0.7,100,100,100,40,0,LoadUnitHandle(HH,id,20),0,facing)
set n0=null
endif
if time>0.5 and time<1.2 then
call GroupClear(G)
call GroupEnumUnitsInRange(G,GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),500,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if SR(GetUnitX(n0),GetUnitY(n0),GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)))>100 and Condition_Base(GetOwningPlayer(caster),n0) then
call MoveUnit(n0,n0,50,Angle2(GetUnitX(n0),GetUnitY(n0),GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20))))
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
endif
endif
set t=null
set caster=null
endfunction



//call SetUnitX(u1,PolX(GetUnitX(u),distance,l__degrees))
//call SetUnitY(u1,PolY(GetUnitY(u),distance,l__degrees))
function HashiramaEPush takes unit caster0,unit hand0,real x00,real y00 returns nothing
call GroupClear(G)
call GroupEnumUnitsInRange(G,GetUnitX(hand0),GetUnitY(hand0),260,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if IsUnitEnemy(n0,GetOwningPlayer(caster0))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false then
if SR(x00,y00,GetUnitX(n0),GetUnitY(n0))>100 then
call MoveUnit(n0,n0,55,GetUnitFacing(hand0))
endif
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
set hand0=null
set caster0=null
endfunction

