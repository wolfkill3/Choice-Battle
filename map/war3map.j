function EShikiNewTwoCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(HH,id,0)
    local unit c=LoadUnitHandle(HH,id,1)
    local integer idu=GetHandleId(u)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetUnitX(u)
    local real y1=GetUnitY(u)
    local real x2=GetUnitX(c)
    local real y2=GetUnitY(c)
    local real a=LoadReal(HH,idu,SH_ANQ)
    local real dist=LoadReal(HH,id,2)
    local real di=LoadReal(HH,id,8)
    local integer fe=LoadInteger(HH,id,4)
    local real he=GetUnitFlyHeight(c)
    local real he2=ParabolaZ(400,450,450-dist)
    local real sc=0
    local real pr=LoadReal(HH,id,20)
    local player p=GetOwningPlayer(u)
    local group g=LoadGroupHandle(HH,id,11)
    local group g1=LoadGroupHandle(HH,id,12)
    call SaveReal(HH,id,2,dist+6)
    if dist<350 then
        if dist<300 then
            if dist<13 then
                set n=CreateUnit(p,'ed0O',x2,y2,a*bj_RADTODEG-210)
                call SetUnitVertexColor(n,255,255,255,115)
                call UnitApplyTimedLife(n,'BTLF',6)
                call SetUnitTimeScale(n,0.7)
            endif
            if IsTerrainPathable(GetUnitX(u),GetUnitY(u),PATHING_TYPE_FLYABILITY)==false  then
                call SetUnitX(u,x+8*Cos(a))
                call SetUnitY(u,y+8*Sin(a))
            endif
            call SetUnitFlyHeight(u,he2-40,0)
        else
            if dist>300 and dist<=306 then
                set n=CreateUnit(p,'e13O',x1+390*Cos(a),y+390*Sin(a),GetRandomReal(0,359))
                call SetUnitVertexColor(n,255,170,255,140)
                call SetUnitScale(n,1.5,1.5,1.5)
                call UnitApplyTimedLife(n,'BTLF',0.7)
                call SetUnitFlyHeight(n,50,0)
                call SetUnitTimeScale(n,2)
                call SetUnitAnimation(u,"Spell throw six")
                call SetUnitTimeScale(u,2)
            endif
            if GetUnitFlyHeight(u)>10 then
                call SetUnitVertexColor(u,255,255,255,120)
                call SetUnitFlyHeight(u,GetUnitFlyHeight(u)-40,0)
            else
                set n=CreateUnit(p,'e13O',x1,y1,GetRandomReal(0,359))
                call SetUnitVertexColor(n,255,170,255,140)
                call SetUnitScale(n,1,1,1)
                call UnitApplyTimedLife(n,'BTLF',0.4)
                call SetUnitFlyHeight(n,30,0)
                call SetUnitTimeScale(n,2)
                call SetUnitVertexColor(u,255,255,255,255)
                call SetUnitFlyHeight(u,0,0)
            endif
            call SetUnitInvulnerable(u,false)
            if IsTerrainPathable(GetUnitX(u),GetUnitY(u),PATHING_TYPE_FLYABILITY)==false  then
                call SetUnitX(u,x+83*Cos(a))
                call SetUnitY(u,y+83*Sin(a))
                endif
                call GroupEnumUnitsInRange(g1,x1,y1,120,Base)
                loop
                set E=FirstOfGroup(g1)
                exitwhen E==null
                if Condition_Base(p,E)and IsUnitInGroup(E,g)==false and (GetUnitFlyHeight(u)<10 or IsUnitInGroup(c,g)==true) then
                    call GroupAddUnit(g,E)
                endif
                call GroupRemoveUnit(g1,E)
                endloop
        endif
        if IsTerrainPathable(GetUnitX(c),GetUnitY(c),PATHING_TYPE_FLYABILITY)==false  then
            set x2=x2+1*Cos(a)
            set y2=y2+1*Sin(a)
            call SetUnitX(c,x2)
            call SetUnitY(c,y2)
        endif
        call SetUnitFacing(u,a*bj_RADTODEG)
        call SaveReal(HH,id,8,di+0.018)
        call EffectToRandomBone("war3mapImported\\SlashEffectRed by Deckai.mdx",c)
        call SaveReal(HH,id,20,pr+0.02)
        if pr>0.05 then
            set n=CreateUnit(p,'e11F',x1-3*Cos(a),y1-3*Sin(a),a*bj_RADTODEG)
            call SetUnitTimeScale(n,0)
            call UnitApplyTimedLife(n,'BTLF',0.7)
            if dist<300 then
            call SetUnitAnimationPerTime(n,di,"Spell throw five",1)
            call SetUnitFlyHeight(n,GetUnitFlyHeight(u),0)
            else
            call SetUnitFlyHeight(n,GetUnitFlyHeight(u),0)
            call SetUnitAnimation(n,"Spell throw six")
            endif
            call ShikiCloneEffect(n,2.5,0.55,0.75,50)
            call SaveReal(HH,id,20,0)
        endif
        set n=CreateUnit(p,'e117',x2,y2,a*bj_RADTODEG)
        call SetUnitVertexColor(n,255,255,255,GetRandomInt(10,45))
        set sc=GetRandomReal(0.55,1.25)
        call SetUnitFlyHeight(n,he,0)
        call SetUnitTimeScale(n,2)
        call SetUnitScale(n,sc,sc,sc)
        call UnitApplyTimedLife(n,'BTLF',0.4)
        call SetUnitTimeScale(n,3)
    else
        call GroupAddUnit(g,c)
        set n=CreateUnit(p,'e0ZH',x1,y1,a*bj_RADTODEG+210)
        call SetUnitVertexColor(n,255,255,255,125)
        call UnitApplyTimedLife(n,'BTLF',0.4)
        call SetUnitTimeScale(n,2)
        set n=CreateUnit(p,'e0ZH',x1,y1,a*bj_RADTODEG+120)
        call SetUnitVertexColor(n,255,255,255,125)
        call UnitApplyTimedLife(n,'BTLF',0.4)
        call SetUnitTimeScale(n,2)
        set n=CreateUnit(p,'e0ZH',x1,y1,a*bj_RADTODEG+300)
        call SetUnitVertexColor(n,255,255,255,125)
        call UnitApplyTimedLife(n,'BTLF',0.4)
        call SetUnitTimeScale(n,2)
        set shikihe=he
        call SaveReal(HH,id,2,0)
        call SaveReal(HH,id,7,he)
        call DestroyGroup(g1)
        call PauseTimer(t)
        call TimerStart(t,0.03,false,function EShikiNewTwoCast3)
    endif
    set c=null
    set u=null
    set p=null
    set t=null
    set g1=null
    set g=null
endfunction
function EShikiNewTwoCast takes nothing returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local unit u=GetTriggerUnit()
    local unit c=LoadUnitHandle(HH,GetHandleId(u),SH_SKQ)
    local real dmg=GetHeroAgi(u,true)*10
    local player p=GetOwningPlayer(u)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local integer idu=GetHandleId(u)
    local integer idp=GetHandleId(p)
    local real x1=0
    local real y1=0
    local real sc=0
    local real a=GetUnitFacing(u)*bj_DEGTORAD
    if c==null then
    set c=LoadUnitHandle(HH,idu,SH_SKR)
    endif
    call SaveUnitHandle(HH,idu,SH_Q3,c)
    if GetUnitAbilityLevel(u,'A2CM')>0 then
    call UnitRemoveAbility(u,'A2CM')
    call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A23W',false)
    call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1BU',true)
    endif
    set x1=x+100*Cos(a)
    set y1=y+100*Sin(a)
    set n=CreateUnit(p,'e116',x1,y1,GetRandomReal(0,359))
    call SetUnitVertexColor(n,255,255,255,GetRandomInt(50,255))
    set sc=GetRandomReal(0.5,3)
    call SetUnitScale(n,sc,sc,sc)
    call UnitApplyTimedLife(n,'BTLF',0.7)
    call SetUnitTimeScale(n,2.5)
    set n=CreateUnit(p,'e116',x1,y1,GetRandomReal(0,359))
    call SetUnitVertexColor(n,255,255,255,GetRandomInt(50,255))
    set sc=GetRandomReal(0.5,3)
    call SetUnitScale(n,sc,sc,sc)
    call UnitApplyTimedLife(n,'BTLF',0.7)
    call SetUnitTimeScale(n,2.5)
    set n=CreateUnit(p,'e116',x1,y1,GetRandomReal(0,359))
    call SetUnitVertexColor(n,255,255,255,GetRandomInt(50,255))
    set sc=GetRandomReal(0.5,3)
    call SetUnitScale(n,sc,sc,sc)
    call UnitApplyTimedLife(n,'BTLF',0.7)
    call SetUnitTimeScale(n,2.5)
    set n=CreateUnit(p,'e116',x1,y1,GetRandomReal(0,359))
    call SetUnitVertexColor(n,255,255,255,GetRandomInt(50,255))
    set sc=GetRandomReal(0.5,3)
    call SetUnitScale(n,sc,sc,sc)
    call UnitApplyTimedLife(n,'BTLF',0.7)
    call SetUnitTimeScale(n,2.5)
    set n=CreateUnit(p,'e11H',x,y,a*bj_RADTODEG)
    call SetUnitVertexColor(n,255,255,255,155)
    call UnitApplyTimedLife(n,'BTLF',0.4)
    call SetUnitTimeScale(n,2)
    set n=CreateUnit(p,'e153',x,y,a*bj_RADTODEG-30)
    call SetUnitVertexColor(n,255,255,255,155)
    call UnitApplyTimedLife(n,'BTLF',0.4)
    call SetUnitTimeScale(n,3)
    set n=CreateUnit(p,'e153',x,y,a*bj_RADTODEG+30)
    call SetUnitVertexColor(n,255,255,255,155)
    call UnitApplyTimedLife(n,'BTLF',0.4)
    call SetUnitTimeScale(n,3)
    set n=CreateUnit(p,'e153',x,y,a*bj_RADTODEG)
    call SetUnitVertexColor(n,255,255,255,155)
    call UnitApplyTimedLife(n,'BTLF',0.4)
    call SetUnitTimeScale(n,3)
    call SaveUnitHandle(HH,id,0,u)
    call SaveUnitHandle(HH,id,1,c)
    call SaveReal(HH,id,2,0)
    //call SaveReal(HH,id,22,0)
    call SaveReal(HH,id,4,0)
    call SaveReal(HH,id,8,0)
    call SaveReal(HH,id,3,a)
    call SaveGroupHandle(HH,id,11,CreateGroup())
    call SaveGroupHandle(HH,id,12,CreateGroup())
    call UnitAddAbility(u,'A1BI')
    call UnitMakeAbilityPermanent(u,true,'A1BI')
    call SaveReal(HH,idu,ComboTimerHash,2)
    call SetUnitTimeScale(LoadUnitHandle(HH,idp,ComboBarHash),1000000)
    call ComboBar(u,0)
    call SaveInteger(HH,idu,ComboCounterHash,LoadInteger(HH,idu,ComboCounterHash)+1)
    call UnitAddAbility(c,'A1BJ')
    call UnitAddAbility(u,'A1BK')
    call UnitAddAbility(u,'Arav')
    call UnitRemoveAbility(u,'Arav')
    if LoadInteger(HH,idu,ComboCounterHash)>5 and LoadInteger(HH,idu,ComboCounterHash)<8 then
    call SetUnitColor(LoadUnitHandle(HH,idp,ComboBarHash),PLAYER_COLOR_PURPLE)
    elseif LoadInteger(HH,idu,ComboCounterHash)>7 then
    call SetUnitColor(LoadUnitHandle(HH,idp,ComboBarHash),PLAYER_COLOR_RED)
    if LoadUnitHandle(HH,idu,SH_CST)==null then
    call SaveUnitHandle(HH,idu,SH_CST,CreateUnit(p,'h06A',x,y,0))
    endif
    endif
    if LoadInteger(HH,idu,ComboCounterHash)>5 and GetUnitAbilityLevel(u,'A1BN')==0 then
        call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1BU',false)
        call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1BV',true)
    endif
    if LoadInteger(HH,idu,ComboCounterHash)>2 then
        call SetAbilityIntegerLevelField(GetUnitAbility(u,'A1BZ'), ABILITY_ILF_TARGET_TYPE,0,1)
        call SetAbilityRealLevelField(GetUnitAbility(u,'A1BZ'), ABILITY_RLF_CAST_RANGE,0,1400)
    endif
    call SaveReal(HH,id,20,0)
    call TimerStart(t,0.015,true,function EShikiNewTwoCast2)
    set soundplay=SndN(2624) // Sound\Music\mp3Music\NanayaE2.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set soundplay=SndN(2626) // Sound\Music\mp3Music\NanayaEQQE.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call SetWidgetMana(u, GetWidgetMana(u)-GetWidgetMaxMana(u)*LoadInteger(HH,idu,ComboCounterHash)*0.005)
    call PauseUnit(u,true)
    call SetUnitInvulnerable(u,true)
    call SetUnitTimeScale(u,1)
    call SetUnitAnimation(u,"Spell throw five")
    set c=null
    set u=null
    set p=null
    set t=null
endfunction
function InitTrig_EShikiNewTwo takes nothing returns nothing
    set gg_trg_EShikiNewTwo=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_EShikiNewTwo,EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_EShikiNewTwo,Condition(function EShikiNewTwoCond))
    call TriggerAddAction(gg_trg_EShikiNewTwo,function EShikiNewTwoCast)
endfunction
function LearnRShikiCond takes nothing returns boolean
return GetLearnedSkill()=='A1BW'
endfunction
function RShikiPause takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local integer idu=GetHandleId(u)
local real time=LoadReal(HH,GetHandleId(GetOwningPlayer(u)),SH_CE)
if time>0 and GetUnitAbilityLevel(u,'A1BN')>0 then
call SaveReal(HH,GetHandleId(GetOwningPlayer(u)),SH_CE,time-0.1)
elseif time<=0.2 and GetUnitAbilityLevel(u,'A1BN')>0 then
call UnitRemoveAbility(u,'A1BN')
endif
set u=null
set t=null
endfunction
function LearnRShikiCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local integer idu=GetHandleId(u)
local integer idp=GetHandleId(p)
local integer lvl=GetUnitAbilityLevel(u,'A1BW')
if lvl==1 and u==Hero[GetPlayerId(p)] then
call SaveReal(HH,GetHandleId(GetOwningPlayer(u)),SH_CE,0)
call SaveUnitHandle(HH,id,0,u)
call UnitAddAbility(u,'A1BX')
call UnitMakeAbilityPermanent(u,true,'A1BX')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1BX',true)
call UnitAddAbility(u,'A1BY')
call UnitMakeAbilityPermanent(u,true,'A1BY')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1BY',false)
if LoadUnitHandle(HH,idp,ComboBarHash)==null then
set n=CreateUnit(p,'e11G',GetUnitX(u),GetUnitY(u),GetUnitFacing(u))
call SetUnitFlyHeight(n,GetUnitFlyHeight(u)+300,0)
call UnitAddAbility(n,'A0A1')
call SetUnitColor(n,PLAYER_COLOR_LIGHT_GRAY)
call SetUnitTimeScale(n,10000)
call SaveUnitHandle(HH,idp,ComboBarHash,n)
call SaveUnitHandle(HH,id,0,u)
call ComboBar(u,-.5)
call TimerStart(t,0.02,true,function ShikiComboStarter)
endif
else
call SetUnitAbilityLevel(u,'A1BX',lvl)
call SetUnitAbilityLevel(u,'A1BY',lvl)
call DestroyTimer(t)
endif
set p=null
set t=null
set u=null
endfunction
function InitTrig_LearnRShiki takes nothing returns nothing
set gg_trg_LearnRShiki=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_LearnRShiki,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(gg_trg_LearnRShiki,Condition(function LearnRShikiCond))
call TriggerAddAction(gg_trg_LearnRShiki,function LearnRShikiCast)
endfunction
function RShikiOneCond takes nothing returns boolean
return GetSpellAbilityId()=='A1BX'
endfunction
function RemoveSaveHashTimedShikiR2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local real time=LoadReal(HH,id,4)
if time<LoadReal(HH,id,3)then
if GetUnitAbilityLevel(LoadUnitHandle(HH,LoadInteger(HH,id,1),LoadInteger(HH,id,2)),'A1BJ')==0 then
call SaveReal(HH,id,4,time+0.02)
endif
else
set n=LoadUnitHandle(HH,id,5)
call SetPlayerAbilityAvailable(GetOwningPlayer(n),'A1BX',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(n),'A1BY',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(n),'A1BR',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(n),'A1BQ',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(n),'A1BP',true)
call RemoveSavedHandle(HH,LoadInteger(HH,id,1),LoadInteger(HH,id,2))
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set t=null
endfunction
function RemoveSaveHashTimedShikiR takes real time,integer id,integer ip,unit u returns nothing
local timer t=CreateTimer()
local integer idt=GetHandleId(t)
call SaveInteger(HH,idt,1,id)
call SaveInteger(HH,idt,2,ip)
call SaveReal(HH,idt,3,time)
call SaveReal(HH,idt,4,0)
call SaveUnitHandle(HH,idt,5,u)
call TimerStart(t,0.02,true,function RemoveSaveHashTimedShikiR2)
set t=null
endfunction
function RShikiAlterCast6 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(HH,id,0)
    local unit l__d=LoadUnitHandle(HH,id,1)
    local integer idu=GetHandleId(u)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real dmg=GetHeroAgi(u,true)*(5.5+GetUnitAbilityLevel(u,'A1BY')*0.5)*(1-LoadInteger(HH,idu,ComboCounterHash)*0.045)
    local real x1=GetUnitX(l__d)
    local real y1=GetUnitY(l__d)
    local real a=LoadReal(HH,id,5)
    local real dist=LoadReal(HH,id,2)
    local player p=GetOwningPlayer(u)
    if dist<200 and IsTerrainPathable(GetUnitX(u),GetUnitY(u),PATHING_TYPE_FLYABILITY)==false  and GetWidgetLife(l__d)>0 then
    set x=x+40*Cos(a)
    set y=y+40*Sin(a)
    set n=CreateUnit(p,'e11F',x,y,a*bj_RADTODEG+180)
    call SetUnitVertexColor(n,255,255,255,125-R2I((1)*0.05))
    call UnitApplyTimedLife(n,'BTLF',0.2)
    call SetUnitTimeScale(n,4)
    call SetUnitAnimation(n,"spell four")
    set n=CreateUnit(p,'e21S',x,y,a*bj_RADTODEG)
    call UnitApplyTimedLife(n,'BTLF',0.3)
    call SetUnitFlyHeight(n,90,0)
    call SetUnitTimeScale(n,2)
    call SetUnitFacing(u,a*bj_RADTODEG)
    call SetUnitXY_1(u,x,y, false)
    call SaveReal(HH,id,2,dist+40)
    else
    call ComboBar(u,-.5)
    call SetUnitFacing(u,a*bj_RADTODEG)
    call SetUnitXY_1(u,x,y, false)
    call PauseTimer(t)
    set n=CreateUnit(p,'e153',x,y,a*bj_RADTODEG-210)
    call SetUnitVertexColor(n,255,255,255,155)
    call UnitApplyTimedLife(n,'BTLF',0.4)
    call SetUnitTimeScale(n,3)
    set n=CreateUnit(p,'e153',x,y,a*bj_RADTODEG+210)
    call SetUnitVertexColor(n,255,255,255,155)
    call UnitApplyTimedLife(n,'BTLF',0.4)
    call SetUnitTimeScale(n,3)
    set n=CreateUnit(p,'e153',x,y,a*bj_RADTODEG+180)
    call SetUnitVertexColor(n,255,255,255,155)
    call UnitApplyTimedLife(n,'BTLF',0.4)
    call SetUnitTimeScale(n,3)
    call UnitRemoveAbility(u,'A202')
    call UnitRemoveAbility(u,'A1BI')
    call UnitRemoveAbility(l__d,'A1BL')
        //call SetUnitInvulnerable(c,l__d,false)
    call PauseUnit(l__d,false)
    call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,false)
    call PauseUnit(u,false)
    call SetUnitInvulnerable(u,false)
    if dmg>GetHeroAgi(u,true)*(5.5+GetUnitAbilityLevel(u,'A1BY')*0.5)*0.1 then
