function SlowAuraCond takes nothing returns boolean
return GetBuffTypeId(GetTriggerBuff())=='BRRV' or GetBuffTypeId(GetTriggerBuff())=='B05S' or GetBuffTypeId(GetTriggerBuff())=='B05T' or GetBuffTypeId(GetTriggerBuff())=='B05U' or GetBuffTypeId(GetTriggerBuff())=='B05V' or GetBuffTypeId(GetTriggerBuff())=='B05W' or GetBuffTypeId(GetTriggerBuff())=='BHSP' or GetBuffTypeId(GetTriggerBuff())=='BDSE' or GetBuffTypeId(GetTriggerBuff())=='BSa1' or GetBuffTypeId(GetTriggerBuff())=='BSa2' or GetBuffTypeId(GetTriggerBuff())=='BSa3' or GetBuffTypeId(GetTriggerBuff())=='BSa4' or GetBuffTypeId(GetTriggerBuff())=='BSa5' or GetBuffTypeId(GetTriggerBuff())=='BHK2' or GetBuffTypeId(GetTriggerBuff())=='BSGS' or GetBuffTypeId(GetTriggerBuff())=='BKKQ' or GetBuffTypeId(GetTriggerBuff())=='B079' or GetBuffTypeId(GetTriggerBuff())=='B07A' or GetBuffTypeId(GetTriggerBuff())=='B00I' or GetBuffTypeId(GetTriggerBuff())=='BAr2' or GetBuffTypeId(GetTriggerBuff())=='BAS3' or GetBuffTypeId(GetTriggerBuff())=='B00X' or GetBuffTypeId(GetTriggerBuff())=='B01I' or GetBuffTypeId(GetTriggerBuff())=='B02F' or GetBuffTypeId(GetTriggerBuff())=='B02M' or GetBuffTypeId(GetTriggerBuff())=='B06D' or GetBuffTypeId(GetTriggerBuff())=='MaFb' or GetBuffTypeId(GetTriggerBuff())=='BOae'  or GetBuffTypeId(GetTriggerBuff())=='B01K'
endfunction
function SlowAuraStartCast takes nothing returns nothing
local buff buf=GetTriggerBuff()
local unit u=GetTriggerUnit()
local real koeffic=1
if UnitHasItemOfTypeBJCustom(u,'I13S') or UnitHasItemOfTypeBJCustom(u,'I13R') then
    set koeffic=koeffic*0.65
endif
if GetUnitTypeId(u)=='H04H' or  GetUnitTypeId(u)=='H14H' then
    set koeffic=koeffic*0.5
endif
call DisableTrigger(GetTriggeringTrigger())
if GetBuffBaseTypeId(buf)=='Basl' then
    call BJDebugMsg(R2S(GetBuffRealField(buf,ABILITY_RLF_MOVEMENT_SPEED_FACTOR_SLO1)))
    call SetBuffRealField(buf,ABILITY_RLF_MOVEMENT_SPEED_FACTOR_SLO1,GetBuffRealField(buf,ABILITY_RLF_MOVEMENT_SPEED_FACTOR_SLO1)*koeffic)
    call SetBuffRealField(buf,ABILITY_RLF_ATTACK_SPEED_FACTOR_SLO2,GetBuffRealField(buf,ABILITY_RLF_ATTACK_SPEED_FACTOR_SLO2)*koeffic)
    call BJDebugMsg(R2S(GetBuffRealField(buf,ABILITY_RLF_MOVEMENT_SPEED_FACTOR_SLO1)))
elseif GetBuffBaseTypeId(buf)=='BOae' then
    call BJDebugMsg(R2S(GetBuffRealField(buf,ABILITY_RLF_MOVEMENT_SPEED_INCREASE_PERCENT_OAE1)))
    call SetBuffRealField(buf,ABILITY_RLF_MOVEMENT_SPEED_INCREASE_PERCENT_OAE1,GetBuffRealField(buf,ABILITY_RLF_MOVEMENT_SPEED_INCREASE_PERCENT_OAE1)*koeffic)
    call SetBuffRealField(buf,ABILITY_RLF_ATTACK_SPEED_INCREASE_PERCENT_OAE2,GetBuffRealField(buf,ABILITY_RLF_ATTACK_SPEED_INCREASE_PERCENT_OAE2)*koeffic)
    call BJDebugMsg(R2S(GetBuffRealField(buf,ABILITY_RLF_MOVEMENT_SPEED_INCREASE_PERCENT_OAE1)))
elseif GetBuffBaseTypeId(buf)=='BOac' then
    call BJDebugMsg(R2S(GetBuffRealField(buf,ABILITY_RLF_ATTACK_DAMAGE_INCREASE_CAC1)))
    call SetBuffRealField(buf,ABILITY_RLF_ATTACK_DAMAGE_INCREASE_CAC1,GetBuffRealField(buf,ABILITY_RLF_ATTACK_DAMAGE_INCREASE_CAC1)*koeffic)
    call BJDebugMsg(R2S(GetBuffRealField(buf,ABILITY_RLF_ATTACK_DAMAGE_INCREASE_CAC1)))
endif
call EnableTrigger(GetTriggeringTrigger())
set buf=null
set u=null
endfunction
function SlowAuraStartInit takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_BUFF_REFRESHED)
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_BUFF_RECEIVED)
call TriggerAddCondition(t,Condition(function SlowAuraCond))
call TriggerAddAction(t,function SlowAuraStartCast)
set t=null
endfunction
function AlastorItemCond takes nothing returns boolean
return GetSpellAbilityId()=='A0X2' and udg_B==true 
endfunction
function AlastorItemCast1 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local player p=GetOwningPlayer(u)
local integer rand2=GetRandomInt(-1,0)
local real a=LoadReal(h,id,1)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
if rand2==0 then
set rand2=1
endif
call ShowUnit(u,true)
call UnitRemoveAbility(u, 'AoSV')
call UnitRemoveAbility(u, 'A1SV')
call SetUnitXY_1(u,x1+250*Cos((a+rand2*90)*bj_DEGTORAD),y1+250*Sin((a+rand2*90)*bj_DEGTORAD),false)
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\SteamTank\\SteamTankImpact.mdl",GetUnitX(u),GetUnitY(u)))
set n=CreateIllusionFromUnit(u)
call SetUnitFacingInstant(n,a)
call UnitCancelTimedLife(n)
call SetUnitCurrentSight(n,600)
call SetUnitUseFood(n,true)
call UnitAddAbility(n,'A2X2')
// call UnitAddBuffById(n,'B04X')
call UnitApplyTimedLife(n,'B04X',15)
call SetUnitXY_1(n,x1+250*Cos((a-rand2*90)*bj_DEGTORAD),y1+250*Sin((a-rand2*90)*bj_DEGTORAD),false)
call SetIllusionDamageDealt(n,0.5)
call SetIllusionDamageReceived(n,2)
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\SteamTank\\SteamTankImpact.mdl",GetUnitX(n),GetUnitY(n)))
if p==GetLocalPlayer()then
call ClearSelection()
call SelectUnit(u,true)
endif
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
if GetUnitTypeId(u)=='H05A' or GetUnitTypeId(u)=='H05B' then
if GetUnitAbilityLevel(u,'A13D')<6 then
call SetPlayerAbilityAvailable(p,'A13B',false)
elseif GetUnitAbilityLevel(u,'A0IH')>0 then
call SetPlayerAbilityAvailable(p,'A237',true)
else
call SetPlayerAbilityAvailable(p,'A13B',true)
endif
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set t=null
set p=null
set u=null
endfunction
function AlastorItemCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
call SaveUnitHandle(h,id,0,u)
call SetUnitFacingInstant(u,GetUnitFacing(u))
call SaveReal(h,id,1,GetUnitFacing(u))
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
set EFF=AddSpecialEffect("war3mapImported\\magmaburst.mdx",x,y)
call RemoveEffect(EFF,0.5,true,CreateTimer())
call UnitRemoveBuffs(u,false,true)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call ShowUnit(u,false)
call TimerStart(t,.5,false,function AlastorItemCast1)
set t=null
set u=null
endfunction
function AlastorItemInit takes nothing returns nothing
set gg_trg_alastor=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_alastor,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_alastor,Condition(function AlastorItemCond))
call TriggerAddAction(gg_trg_alastor,function AlastorItemCast)
endfunction
