function InitTrig_VergilInt takes nothing returns nothing
    local trigger trig= CreateTrigger()
    local integer index= 0
    loop
        call TriggerRegisterPlayerUnitEvent(trig, Player(index), EVENT_PLAYER_UNIT_SPELL_EFFECT, null)
        set index=index + 1
        exitwhen index == bj_MAX_PLAYER_SLOTS
    endloop
    call TriggerAddAction(trig, function Vergil_Cast)
        set trig=null
endfunction

//===========================================SAKAI YUJI INT 


function YujiD_Target_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
        local unit target=LoadUnitHandle(h, id, 0)
    local real time= LoadReal(h, id, 6)
        local real hp_persent= GetWidgetLife(target) / GetWidgetMaxLife(target)
    local real mp_persent= GetWidgetMana(target) / GetWidgetMaxMana(target)
    if time < 4 and GetUnitAbilityLevel(target, 'CE04')==0 and GetUnitAbilityLevel(target, 'A151')==0 and GetUnitAbilityLevel(target, 'IMDc')==0 then
        call SaveReal(h, id, 6, time + 0.1)
    else
        if GetUnitAbilityLevel(target, 'CE04')==0 and GetUnitAbilityLevel(target, 'A151')==0 and GetUnitAbilityLevel(target, 'IMDc')==0 then
                set n=CreateUnit(GetOwningPlayer(target), 'dR53', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
                call SetUnitScale(n, 1.7, 1.7, 1.7)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(target), 'dR54', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
                call SetUnitScale(n, 1.7, 1.7, 1.7)
                call SetUnitFlyHeight(n, 40, 0)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(target), 'dR55', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
                call SetUnitScale(n, 1.7, 1.7, 1.7)
                call SetUnitFlyHeight(n, 40, 0)
                call MyRemoveUnit(n, 1.5)
                if UnitIsAlive(target) then
                        call SetUnitX(target, LoadReal(h, id, 1))
                        call SetUnitY(target, LoadReal(h, id, 2))
                        set hp_persent = (LoadReal(h, id, 3) - hp_persent)/2
                        set mp_persent = (LoadReal(h, id, 4) - mp_persent)/2
                        call SetUnitState(target, UNIT_STATE_LIFE, GetWidgetLife(target)+GetWidgetMaxLife(target)*hp_persent)
                        call SetUnitState(target, UNIT_STATE_MANA, GetWidgetMana(target)+GetWidgetMaxMana(target)*hp_persent)
                endif
                set n=CreateUnit(GetOwningPlayer(target), 'dR53', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
                call SetUnitScale(n, 1.7, 1.7, 1.7)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(target), 'dR54', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
                call SetUnitScale(n, 1.7, 1.7, 1.7)
                call SetUnitFlyHeight(n, 40, 0)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(target), 'dR55', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
                call SetUnitScale(n, 1.7, 1.7, 1.7)
                call SetUnitFlyHeight(n, 40, 0)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(target), 'dR56', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
                call SetUnitScale(n, 1.1, 1.1, 1.1)
                call SetUnitFlyHeight(n, 40, 0)
                call MyRemoveUnit(n, 1.5)
        endif
        call DestroyEffect(LoadEffectHandle(h, id, 5))
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
        set target=null
endfunction

function YujiDTarget takes unit newTarget,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local real target_x= GetUnitX(newTarget)
    local real target_y= GetUnitY(newTarget)
    local real hp_persent= GetWidgetLife(newTarget) / GetWidgetMaxLife(newTarget)
    local real mp_persent= GetWidgetMana(newTarget) / GetWidgetMaxMana(newTarget)
    if GetUnitTypeId(newTarget) == 'HYuj' then
        set mp_persent=( GetWidgetMana(newTarget) - 400 ) / GetWidgetMaxMana(newTarget)
    endif
        set bjLCU=CreateUnit(GetOwningPlayer(newTarget), 'dR67', target_x, target_y, GetRandomInt(0, 360))
        call SetUnitScale(bjLCU, 1.3, 1.3, 1.3)
        call MyRemoveUnit(bjLCU, 4)
    call SaveUnitHandle(h, id, 0, newTarget)
    call SaveReal(h, id, 1, target_x)
    call SaveReal(h, id, 2, target_y)
    call SaveReal(h, id, 3, hp_persent)
    call SaveReal(h, id, 4, mp_persent)
    call SaveEffectHandle(h, id, 5, AddSpecialEffectTarget("113.mdl", newTarget, "origin"))
    call TimerStart(newTimer, 0.1, true, function YujiD_Target_Periodic)
endfunction

function YujiD_MapCastEnd takes nothing returns nothing
    set soundplay=CreateSound("Sound\\war3mapImported\\YujiD_Voice2.mp3", false, false, true, 12700, 12700, "")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    call CinematicFadeBJCustom(bj_CINEFADETYPE_FADEIN, 1, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 125, 185, 255, 0)
    call DestroyTimer(GetExpiredTimer())
endfunction

function YujiD_MapCast takes unit newCaster,unit loopUnit,timer newTimer returns nothing
    local real caster_x= GetUnitX(newCaster)
    local real caster_y= GetUnitY(newCaster)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dR57', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 5, 5, 5)
        call SetUnitTimeScale(n, 0.7)
        call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(newCaster), 'dR53', caster_x, caster_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 5, 5, 5)
                call SetUnitTimeScale(n, 0.7)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(newCaster), 'dR53', caster_x, caster_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 5, 5, 5)
                call SetUnitTimeScale(n, 0.7)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(newCaster), 'dR53', caster_x, caster_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 5, 5, 5)
                call SetUnitTimeScale(n, 0.7)
                call MyRemoveUnit(n, 1.5)
    set bjLCG=CreateGroup()
        call GroupEnumUnitsInRect(bjLCG, bj_mapInitialPlayableArea, Base)
    //call GroupEnumUnitsInRange(bjLCG, GetUnitX(newCaster), GetUnitY(newCaster), 99999, Base)
    loop
    set E=FirstOfGroup(bjLCG)
    exitwhen E == null
        if newCaster != E and IsUnitType(E, UNIT_TYPE_HERO) and IsUnitIllusion(E)==false and GetUnitAbilityLevel(E, 'A151')==0 and GetUnitAbilityLevel(E,'cbc9')==0 and GetUnitAbilityLevel(E, 'IMDc')==0 then
            call YujiDTarget(E , CreateTimer())
        endif
    call GroupRemoveUnit(bjLCG, E)
    endloop
    call DestroyGroup(bjLCG)
    call TimerStart(newTimer, 4, false, function YujiD_MapCastEnd)
endfunction

function YujiD_Cast takes unit newCaster returns nothing
    local integer id_caster= GetHandleId(newCaster)
