  call StartAbilityCooldown(GetUnitAbility(caster, 'ASR1'), GetAbilityRemainingCooldown(GetUnitAbility(Dummy, 'ASR1')))
endif


if GetAbilityCooldown(GetUnitAbility(Dummy, 'ASF1'))>0 then
  call StartAbilityCooldown(GetUnitAbility(caster, 'ASF1'), GetAbilityRemainingCooldown(GetUnitAbility(Dummy, 'ASF1')))
