call SaveInteger(h,id,l__s,'A0FT')
elseif i==6 then
set soundplay=SndN(1191) // Sound\Music\mp3Music\ShuArgo.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call UnitRemoveAbility(u,r)
call UnitRemoveAbility(u,r1)
call UnitAddAbility(u,'A0FK')
call UnitAddAbility(u,'A0FV')
call SetUnitAbilityLevel(u,'A0FV',lvl)
call SaveInteger(h,id,s1,'A0FK')
call SaveInteger(h,id,l__s,'A0FV')
endif
set c=null
set u=null
endfunction
