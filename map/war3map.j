function CastHiraishin4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x1=LoadReal(h,id,1)
local real y1=LoadReal(h,id,2)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local integer str=SH_number
local real time=LoadReal(h,id,4)
local real dmg=GetHeroAgi(u,true)*0.6
local player p=GetOwningPlayer(u)
local integer idu=GetPlayerId(p)
local integer idun=GetHandleId(Hero[idu])
local group g=LoadGroupHandle(h,idun,SH_kunai3)
local group gn=CopyGroup(g)
local real x2=0
local real y2=0
local integer i=0
if time>0 then
set n=GetRandomUnitFromGroup(gn)
set x2=GetUnitX(n)
set y2=GetUnitY(n)
call SetUnitXY_1(u,x2,y2, false)
call DestroyEffect(AddSpecialEffect("war3mapImported\\DivineRage.mdx",x2,y2))
call DestroyEffect(AddSpecialEffect("war3mapImported\\Flash.mdx",x2,y2))
call SaveReal(h,id,4,time-0.1)
call GroupEnumUnitsInRange(G,x1,y1,800,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
if ModuloReal(time,0.5)<0.1 then
call SetControlToUnit(u,E,0.12,"stun")
endif
endif
call GroupRemoveUnit(G,E)
endloop
else
call UnitRemoveAbility(u,'A0QH')
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call PauseTimer(t)
call DestroyGroup(g)
call DestroyGroup(gn)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set gn=null
set g=null
set u=null
set t=null
endfunction
