function MadaraFRinneganAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit bone
local unit caster=LoadUnitHandle(HH,id,1)
set bone=LoadUnitHandle(HH,GetHandleId(caster),SH_MadaraBone)
call SetUnitFacingInstant(LoadUnitHandle(HH,id,2),GetUnitFacing(caster))
call SetUnitFlyHeight(LoadUnitHandle(HH,id,2),GetUnitFlyHeight(caster),0)
if CheckUnitInvisible(caster) then
    call UnitAddAbility(LoadUnitHandle(HH,id,2),'Ao7S')
else
    call UnitRemoveAbility(LoadUnitHandle(HH,id,2),'Ao7S')
endif

if UnitIsAlive(caster)==true then
call MoveUnit(caster,LoadUnitHandle(HH,id,2),0,GetUnitFacing(caster))
call SetUnitVertexColor(LoadUnitHandle(HH,id,2), 255, 255, 255, 255)
else
call SetUnitVertexColor(LoadUnitHandle(HH,id,2), 0, 0, 0, 0)
call MoveAoe1(GetRectCenterX(gg_rct_Rect1),GetRectCenterY(gg_rct_Rect1),LoadUnitHandle(HH,id,2),0,GetUnitFacing(caster))
endif

if bone!=null or LoadUnitHandle(HH,id,1)==null then
call RemoveUnit(LoadUnitHandle(HH,id,2))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set t=null
set caster=null
set bone=null
endfunction
function MadaraFBoneAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit bone=LoadUnitHandle(HH,id,20)
local unit caster=LoadUnitHandle(HH,id,1)
call SetUnitFacingInstant(bone,GetUnitFacing(caster))
if CheckUnitInvisible(caster) then
    call UnitAddAbility(LoadUnitHandle(HH,id,20),'Ao7S')
    call UnitAddAbility(LoadUnitHandle(HH,id,2),'Ao7S')
else
    call UnitRemoveAbility(LoadUnitHandle(HH,id,20),'Ao7S')
    call UnitRemoveAbility(LoadUnitHandle(HH,id,2),'Ao7S')
endif
if LoadUnitHandle(HH,GetHandleId(caster),SH_MadaraSusano)==null and LoadBoolean(HH,GetHandleId(caster),SH_MadaraSusT2)==false then
call SetUnitFlyHeight(bone,GetUnitFlyHeight(caster),0)
call UnitColor(bone,100,100,100,0)
else
call SetUnitFlyHeight(bone,6000,0)
call UnitColor(bone,100,100,100,100)
endif


call SetUnitFacingInstant(LoadUnitHandle(HH,id,2),GetUnitFacing(caster))
call SetUnitFlyHeight(LoadUnitHandle(HH,id,2),GetUnitFlyHeight(caster),0)


if UnitIsAlive(caster)==true then
call MoveUnit(caster,bone,0,GetUnitFacing(caster))
call MoveUnit(caster,LoadUnitHandle(HH,id,2),0,GetUnitFacing(caster))
call SetUnitVertexColor(bone, 255, 255, 255, 255)
call SetUnitVertexColor(LoadUnitHandle(HH,id,2), 255, 255, 255, 255)
else
call SetUnitVertexColor(bone, 0, 0, 0, 0)
call SetUnitVertexColor(LoadUnitHandle(HH,id,2), 0, 0, 0, 0)
call MoveAoe1(GetRectCenterX(gg_rct_Rect1),GetRectCenterY(gg_rct_Rect1),bone,0,GetUnitFacing(caster))
call MoveAoe1(GetRectCenterX(gg_rct_Rect1),GetRectCenterY(gg_rct_Rect1),LoadUnitHandle(HH,id,2),0,GetUnitFacing(caster))
endif



if bone==null or LoadUnitHandle(HH,id,1)==null then

if LoadUnitHandle(HH,id,1)==null then
call RemoveUnit(LoadUnitHandle(HH,id,20))
endif
call RemoveUnit(LoadUnitHandle(HH,id,2))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set caster=null
set bone=null
set t=null
endfunction


function MadaraGAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local unit b1=null
local real facing=LoadReal(HH,id,3)
local real distance=LoadReal(HH,id,8)
local real time=LoadReal(HH,id,5)
local real damage=GetHeroInt(caster,true)*3
local real time1
local group gr
if LoadBoolean(HH,GetHandleId(caster),TARGET_ABILITY)==false or time==0.02 or time==0.2 or time==0.4 or time==0.6 or time==0.8 or time==1 or time==1.2 or time==1.4 or time==1.6 then
set time=time+0.02
call SaveReal(HH,id,5,time)
endif
if distance==1500 or time==2 then
if time==2 then
call PauseUnit(caster,false)
endif
call SaveBoolean(HH,GetHandleId(caster),SH_MadaraG,false)
call UnitSpeed(caster,1)
call RemoveUnit(LoadUnitHandle(HH,id,22))
if LoadUnitHandle(HH,id,20)!=null then
call DestroyGroup(LoadGroupHandle(HH,id,4))
call RemoveUnit(LoadUnitHandle(HH,id,20))
endif
if LoadBoolean(HH,GetHandleId(caster),ANTITARGET_ABILITY)==true then
    call SetControlToUnit(caster , caster , 0.5 , "doomdebug")
endif
call SaveBoolean(HH,GetHandleId(caster),ANTITARGET_ABILITY,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
else
if time<10 then
call MoveUnit(caster,LoadUnitHandle(HH,id,22),0,GetUnitFacing(caster)*bj_RADTODEG)
endif
if time<2 then
if LoadBoolean(HH,GetHandleId(caster),SH_MadaraG)==false then
set time=10
call SaveReal(HH,id,5,10)
set facing=LoadReal(HH,GetHandleId(caster),SH_MadaraGfacing)
call SaveReal(HH,id,3,facing)




endif
call PauseUnit(caster,true)
endif
if time==0.02 then
call SetUnitPathing(caster,true)
call SetUnitAnimationByIndex(caster,5)
call UnitSpeed(caster,1.75)
set soundplay=SndN(3529) // war3mapimported\MadaraG.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set n0=CreateUnit(GetOwningPlayer(caster),'e210',GetUnitX(caster),GetUnitY(caster),facing*bj_DEGTORAD)
call UnitSize(n0,2,1,1)
call SetUnitFlyHeight(n0,0,0)
call SaveUnitHandle(HH,id,22,n0)
set n0=null
endif
if time==0.02 or time==0.2 or time==0.4 or time==0.6 or time==0.8 or time==1 or time==1.2 or time==1.4 or time==1.6 or time==1.7 or time==1.8 or time==2 or time==2.2 or time==2.4 or time==2.6 or time==2.8 then
call EffectCreateAndMove(true,"Madara\\HakenSaber2.mdl",GetRandomInt(0,360),1,1.25,0.5,100,100,100,60,0,caster,0,facing*bj_RADTODEG)
call EffectCreateAndMove(true,"Madara\\wind4.mdl",GetRandomInt(0,360),1,1.25,0.6,100,100,100,60,100,caster,0,facing*bj_RADTODEG)
endif
if time==10 or LoadUnitHandle(HH,GetHandleId(caster),REVERSE_TARGET)!=null then
set soundplay=SndN(3532) // war3mapimported\MadaraG_Boom.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set time=10.02
call SaveReal(HH,id,5,10.02)
if LoadUnitHandle(HH,GetHandleId(caster),REVERSE_TARGET)!=null then
set facing=AU(caster, LoadUnitHandle(HH,GetHandleId(caster),REVERSE_TARGET))*bj_RADTODEG
call SaveReal(HH,id,3,facing)
call SetUnitFacingInstant(caster,facing)
endif
call SaveBoolean(HH,GetHandleId(caster),ANTITARGET_ABILITY,false)
call RemoveSavedHandle(HH,GetHandleId(caster),REVERSE_TARGET)
call SaveGroupHandle(HH,id,4,CreateGroup())
call EffectCreateAndMove1(false,"Madara\\wind3.mdl",facing,1,1.75,1,100,100,100,40,100,-90,caster,50,facing*bj_RADTODEG)
call EffectCreateAndMove1(false,"Madara\\WindCircleFaster.mdl",facing,1,1.25,0.8,100,100,100,40,100,-90,caster,50,facing*bj_RADTODEG)
call PauseUnit(caster,false)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
call EffectCreateAndMove(false,"Madara\\xuanfeng4-90.mdl",facing-90,1,1.2+(time-10)*1.25,0.8,100,100,100,0,0,caster,50,facing*bj_RADTODEG)
call MoveUnit(n0,n0,100,facing)
call SetUnitFlyHeight(n0,200,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=null
endif
//if time==10.02 then
//set facing=GetUnitFacing(caster)
//call SaveReal(HH,id,3,facing)
//endif


if time>10 then
set time1=LoadReal(HH,id,6)
call SaveReal(HH,id,8,distance+50)
set b1=LoadUnitHandle(HH,id,20)
call MoveUnit(b1,b1,50,facing)



call DamageAoeOneTime3(caster,GetUnitX(b1),GetUnitY(b1),200+(time-10)*500,damage,LoadGroupHandle(HH,id,4),R2I(31-(time-10)*10),50,facing)




set time1=time1+0.02
if time1==0.08 or time==0.04 then
set time1=0
call EffectCreateAndMove(false,"Madara\\xuanfeng4-90.mdl",facing-90,1.2-(time-10),1.2+(time-10)*1.25,0.8,100,100,100,0,0,LoadUnitHandle(HH,id,20),0,facing)
endif
call SaveReal(HH,id,6,time1)
set b1=null
endif
endif
set b1=null
set t=null
set caster=null
    set gr=null
endfunction


function MadaraRSlashesh1 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real distance=LoadReal(HH,id,8)
local real time=LoadReal(HH,id,5)
local real time1
set time=time+0.02
call SaveReal(HH,id,5,time)
if distance==2000 then
if LoadGroupHandle(HH,id,4)!=null then
call DestroyGroup(LoadGroupHandle(HH,id,4))
call SaveGroupHandle(HH,id,4,null)
endif
if LoadUnitHandle(HH,id,20)!=null and UnitIsAlive(LoadUnitHandle(HH,id,20))==true then
call RemoveUnit(LoadUnitHandle(HH,id,20))
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
else
set time1=LoadReal(HH,id,6)
set time1=time1+0.02
if time1==0.1 or time==0.02 then
set time1=0
call EffectCreateAndMove(true,"Madara\\[A]sandpoff123.mdl",facing,1,1,2,100,100,100,40,50,LoadUnitHandle(HH,id,20),0,facing)
endif
call SaveReal(HH,id,6,time1)
