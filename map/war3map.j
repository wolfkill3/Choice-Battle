local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
set n=CreateUnit(p,'h071',x,y,f)
call SetUnitState(n,UNIT_STATE_LIFE,185-3*GetHeroLevel(u))
call SetUnitVertexColor(n,255,255,255,155)
call SetUnitInvulnerable(n,true)


if round>7 or udg_test then
call UnitAddAbility(n,'ArcT')
call StartAbilityCooldown(GetUnitAbility(n, 'ArcT'), 20.0)
endif


if GetLocalPlayer()==p then
call ClearSelection()
call SelectUnit(n,true)
endif
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,n)
call SaveReal(h,id,2,GetWidgetLife(n))
call SaveReal(h,id,3,0.99)
call TimerStart(t,0.2,true,function ArcueidFCast2)
set t=null
set u=null
set p=null
endfunction
