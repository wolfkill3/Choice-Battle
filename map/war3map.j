local real y1=GetSpellTargetY()
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,x1)
call SaveReal(h,id,2,y1)
call SaveReal(h,id,4,Atan2(y1-y,x1-x))
call SaveGroupHandle(h,id,7,CreateGroup())
set n=CreateUnit(GetOwningPlayer(u),'ed0O',x1,y1,0)
call SetUnitTimeScale(n,0.35)
call SetUnitVertexColor(n,255,255,255,155)
call SetUnitScale(n,1.55,1.55,1.55)
call UnitApplyTimedLife(n,0,3)
call SaveInteger(h,id,3,-1)
if GetUnitTypeId(u)=='Ho0O' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\WaverT.mp3",false,false,true,12700,12700,"")
