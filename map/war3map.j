function UnitScale2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real ms=LoadReal(h,id,1)
local real up=LoadReal(h,id,2)
local real state=LoadReal(h,id,3)+up
if ms>state then
call SetUnitScale(l__d,state,state,state)
call SaveReal(h,id,3,state)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set t=null
endfunction
function UnitScale_Increase takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit l__d=LoadUnitHandle(h,id,0)
    local real ms=LoadReal(h,id,1)
    local real up=LoadReal(h,id,2)
    local real state=LoadReal(h,id,3)+up
    if ms>state and l__d!=null then
        call SetUnitScale(l__d,state,state,state)
        call SaveReal(h,id,3,state)
    else
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
    endif
    set l__d=null
    set t=null
endfunction
function UnitScale_Decrease takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit l__d=LoadUnitHandle(h,id,0)
    local real ms=LoadReal(h,id,1)
    local real down=LoadReal(h,id,2)
    local real state=LoadReal(h,id,3)-down
    if ms<state and l__d!=null then
        call SetUnitScale(l__d,state,state,state)
        call SaveReal(h,id,3,state)
    else
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
    endif
    set l__d=null
    set t=null
endfunction
function UnitScale takes unit l__d,real startscale,real maxscale,real time returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    call SaveUnitHandle(h,id,0,l__d)
    call SetUnitScale(l__d,startscale,startscale,startscale)
    call SaveReal(h,id,1,maxscale)
    call SaveReal(h,id,2,(0.01*maxscale)/time)
    call SaveReal(h,id,3,startscale)
    if maxscale>startscale then
        call TimerStart(t,0.01,true,function UnitScale_Increase)
    else
        call TimerStart(t,0.01,true,function UnitScale_Decrease)
    endif
    set t=null
endfunction
