    call SetFrameTextAlignment( SpectacleTeamSelect1Text, TEXT_JUSTIFY_CENTER, TEXT_JUSTIFY_MIDDLE )
    call SetFrameTextColour( SpectacleTeamSelect1Text, 0xFFFFA500 )
    call SetFrameParent( SpectacleTeamSelect1Text, SpectacleTeamSelect1 )
    call SetFrameText( SpectacleTeamSelect1Text, "Current team: All")
    call ShowFrame( SpectacleTeamSelect1Text, GetPlayerId(GetLocalPlayer())==11 )
    call SetFrameRelativePoint( SpectacleTeamSelect1Text, FRAMEPOINT_CENTER, SpectacleTeamSelect1, FRAMEPOINT_CENTER, .00011, .0 ) 

    set tOnPress = CreateTrigger( )
    set tOnUnPress = CreateTrigger( )
    set tOnClick = CreateTrigger( )
