function ShibariBenihimeCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local real l__d=LoadReal(h,id,8)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,6)
local real dmg=(2+GetUnitAbilityLevel(u,'A0BF'))*GetHeroInt(u,true)+Urahara_DMG(u,1)
if SR(x,y,x1,y1)>32 and LoadBoolean(h,id,7)==false then
set x=x+60*Cos(a)
set y=y+60*Sin(a)
set n=CreateUnit(p,'e02W',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.75)
call UnitApplyTimedLife(CreateUnit(p,'e047',x,y,a*bj_RADTODEG),'BTLF',1)
call SetUnitTimeScale(n,0)
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call GroupEnumUnitsInRange(g,x,y,75,Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)

call SetControlToUnit(E,E,1.5,"stun")

call UnitApplyTimedLife(CreateUnit(p,'e05T',x,y,(a*bj_RADTODEG)),'BTLF',1)
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
else
call SaveBoolean(h,id,7,true)
call SaveReal(h,id,6,Atan2(y1-GetUnitY(u),x1-GetUnitX(u)))
endif
if l__d<1300 and LoadBoolean(h,id,7)==true then
set a=LoadReal(h,id,6)
set x=x+60*Cos(a)
set y=y+60*Sin(a)
set n=CreateUnit(p,'e02W',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.75)
call UnitApplyTimedLife(CreateUnit(p,'e047',x,y,a*bj_RADTODEG),'BTLF',1)
call SetUnitTimeScale(n,0)
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call GroupEnumUnitsInRange(g,x,y,75,Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)

call SetControlToUnit(E,E,1.5,"stun")

call UnitApplyTimedLife(CreateUnit(p,'e05T',x,y,(a*bj_RADTODEG)),'BTLF',1)
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
call SaveReal(h,id,8,l__d+60)
elseif LoadBoolean(h,id,7)==true then
call FlushChildHashtable(h,GetHandleId(g))
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set p=null
set u=null
set c=null
set t=null
endfunction
