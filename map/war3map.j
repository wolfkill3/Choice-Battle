function JeanneAlterGSlashMove takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real damage=LoadReal(HH,id,15)
local real time=LoadReal(HH,id,5)
local real x0=GetUnitX(LoadUnitHandle(HH,id,20))
local real y0=GetUnitY(LoadUnitHandle(HH,id,20))
local real x1=LoadReal(HH,id,11)
local real y1=LoadReal(HH,id,12)
local real distance=LoadReal(HH,id,8)//SR(x0,y0,x1,y1)
set time=time+0.02
call SaveReal(HH,id,5,time)
if distance<=0 or time>=5 or IsTerrainPathable(x1,y1,PATHING_TYPE_FLYABILITY)==true then
set soundplay=SndN(4040) // Sound\Music\mp3Music\JeanneAlterGHit.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call EffectCreateAndMove(true,"Others\\blue-guagnzhu-special.mdl",facing,1,2,1.5,100,40,100,0,100,LoadUnitHandle(HH,id,20),0,facing)
call EffectCreateAndMove(true,"Others\\MystoganExp1.mdl",facing,1,1.15,1.75,100,100,100,0,0,LoadUnitHandle(HH,id,20),0,facing)
call EffectCreateAndMove(true,"Others\\JeanneDark1mt_baozha1.mdl",facing,1,1.5,0.9,100,40,100,0,0,LoadUnitHandle(HH,id,20),0,facing)
call EffectCreateAndMove(true,"Others\\JeanneDark1mt_baozha1.mdl",facing,1,1.15,2,100,40,100,0,0,LoadUnitHandle(HH,id,20),0,facing)
call EffectCreateAndMove(true,"BlackGoku\\HakkeStart2.mdl",facing,1,2,1.5,100,100,100,50,0,LoadUnitHandle(HH,id,20),0,facing)
call GroupClear(G)
call GroupEnumUnitsInRange(G,GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),600,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if  Condition_Base(GetOwningPlayer(caster),n0) then


  if GetHeroLevel( caster )>=35 then
    call JanneAlterDecreaseDef( n0 , 10 )
  else
    call JanneAlterDecreaseDef( n0 ,5 )
  endif
call myCustomDamage(caster,n0,damage,false,false,null,null,null)


endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
call RemoveUnit(LoadUnitHandle(HH,id,20))
call RemoveUnit(LoadUnitHandle(HH,id,21))
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else
call MoveUnit(LoadUnitHandle(HH,id,20),LoadUnitHandle(HH,id,20),40,facing)
call MoveUnit(LoadUnitHandle(HH,id,20),LoadUnitHandle(HH,id,21),0,facing)
call SaveReal(HH,id,8,distance-40)
endif
set caster=null
endfunction
function JeanneAlterGSlash takes unit caster0,real damage0,real x00,real y00 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x0=GetUnitX(caster0)
local real y0=GetUnitY(caster0)
local real facing0=Angle2(x0,y0,x00,y00)
call SaveUnitHandle(HH,id,1,caster0)
call SaveReal(HH,id,3,facing0)

call SaveReal(HH,id,11,x00)
call SaveReal(HH,id,12,y00)
call SaveReal(HH,id,15,damage0)
set n0=CreateUnit(GetOwningPlayer(caster0),'e200',x0,y0,facing0)
call SetUnitModel(n0,"Others\\Moon_texiao_pojizhan_01_zise.mdl")
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call SetUnitFlyHeight(n0,200,0)
call UnitSize(n0,1,1,1)
call MoveUnit(n0,n0,100,facing0)


call SaveReal(HH,id,8,SR(GetUnitX(n0),GetUnitY(n0),x00,y00))

call SaveUnitHandle(HH,id,20,n0)
set n0=null
set n0=CreateUnit(GetOwningPlayer(caster0),'e200',x0,y0,facing0)
call SetUnitModel(n0,"Others\\Moon_texiao_pojizhan_02_zise.mdl")
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call SetUnitFlyHeight(n0,200,0)
call UnitSize(n0,1,1,1)
call MoveUnit(n0,n0,100,facing0)
call SaveUnitHandle(HH,id,21,n0)
set n0=null
call TimerStart(t,0.02,true,function JeanneAlterGSlashMove)
set caster0=null
set t=null
endfunction

function JeanneAlterGW2Act takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real damage=LoadReal(HH,id,15)
set time=time+0.02
call SaveReal(HH,id,5,time)
if time==0.02 then
call EffectCreateAndMove(true,"BlackGoku\\HakkeStart2.mdl",facing,1,0.8,1.5,100,100,100,50,0,caster,0,facing)
call EffectCreateAndMove(true,"Others\\windNewFaw6.mdl",facing,1,GetRandomReal(1.5,2),GetRandomReal(1.5,3),100,100,100,30,0,caster,0,facing)
call EffectCreateAndMove(true,"Others\\windNewFaw6.mdl",facing+60,1,GetRandomReal(1.5,2),GetRandomReal(1.5,3),100,100,100,30,0,caster,0,facing)
call EffectCreateAndMove(true,"Others\\windNewFaw6.mdl",facing-60,1,GetRandomReal(1.5,2),GetRandomReal(1.5,3),100,100,100,30,0,caster,0,facing)
call EffectCreateAndMove(true,"Others\\AFB (2556).mdl",facing,0.5,1,1.5,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"Others\\AFB (2697).mdl",facing,0.5,2,1.5,100,100,100,0,0,caster,0,facing)
endif
if time<0.5 then
call SetUnitPathing(caster,false)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
endif
if time==0.5 then
call EffectCreateAndMove(true,"Others\\CarolLightning2.mdl",facing,1,1.25,1.5,100,100,100,0,100,caster,0,facing)
call EffectCreateAndMove(true,"Others\\darkpillar.mdl",facing,1,1.75,2.25,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"Others\\AFB (2092).mdl",facing,1,1,1.5,100,100,100,0,50,caster,0,facing)
call JeanneAlterGSlash(caster,damage,LoadReal(HH,id,11),LoadReal(HH,id,12))
call UnitSpeed(caster,1)
call SetUnitPathing(caster,true)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
endif
if time==1.5 then
