local real y1=LoadReal(h,id,5)
local real x2=0
local real y2=0
local real r=0
local real he=0
local real a=GetUnitFacing(u)*bj_DEGTORAD
local real dist=LoadReal(h,id,2)
local group g=LoadGroupHandle(h,id,10)
local player p=GetOwningPlayer(u)
if dist<2.3 then
call SetControlToUnit(u, u, 0.11, "doom")
call SaveReal(h,id,2,dist+0.1)
call SaveReal(h,id,3,a)
if dist<1.7 then
set x=x-100*Cos(a)
set y=y-100*Sin(a)
set r=GetRandomReal(-550,550)
set x2=x+r*Cos(a+deg90)
set y2=y+r*Sin(a+deg90)
set he=GetRandomReal(160,600)
set n=CreateUnit(p,'e14Y',x2,y2,a*bj_RADTODEG)
call SetUnitFlyHeight(n,he,0)
call SetUnitTimeScale(n,2)
call RGilMissles(n,GetRandomReal(60,85),a,GetRandomReal(1200,1800))
set n=CreateUnit(p,'e14T',x2,y2,a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,1.25)
call SetUnitFlyHeight(n,he,0)
set r=GetRandomReal(-550,550)
set x2=x+r*Cos(a+deg90)
set y2=y+r*Sin(a+deg90)
set he=GetRandomReal(160,600)
set n=CreateUnit(p,'e14Y',x2,y2,a*bj_RADTODEG)
call SetUnitFlyHeight(n,he,0)
call SetUnitTimeScale(n,2)
call RGilMissles(n,GetRandomReal(60,85),a,GetRandomReal(1200,1800))
set n=CreateUnit(p,'e14T',x2,y2,a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,1.25)
call SetUnitFlyHeight(n,he,0)
set r=GetRandomReal(-550,550)
set x2=x+r*Cos(a+deg90)
set y2=y+r*Sin(a+deg90)
set he=GetRandomReal(160,600)
set n=CreateUnit(p,'e14Y',x2,y2,a*bj_RADTODEG)
call SetUnitFlyHeight(n,he,0)
call SetUnitTimeScale(n,2)
call RGilMissles(n,GetRandomReal(60,85),a,GetRandomReal(1200,1800))
set n=CreateUnit(p,'e14T',x2,y2,a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,1.25)
call SetUnitFlyHeight(n,he,0)
set r=GetRandomReal(-550,550)
set x2=x+r*Cos(a+deg90)
set y2=y+r*Sin(a+deg90)
set he=GetRandomReal(160,600)
set n=CreateUnit(p,'e14Y',x2,y2,a*bj_RADTODEG)
call SetUnitFlyHeight(n,he,0)
call SetUnitTimeScale(n,2)
call RGilMissles(n,GetRandomReal(60,85),a,GetRandomReal(1200,1800))
set n=CreateUnit(p,'e14T',x2,y2,a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,1.25)
call SetUnitFlyHeight(n,he,0)
endif
if dist>0.3 then
call GroupEnumUnitsInRange(G,x+225*Cos(a),y+225*Sin(a),450,Base)
call GroupAddGroup(G,g)
call GroupEnumUnitsInRange(G,x+450*Cos(a),y+450*Sin(a),450,Base)
call GroupAddGroup(G,g)
call GroupEnumUnitsInRange(G,x+675*Cos(a),y+675*Sin(a),450,Base)
call GroupAddGroup(G,g)
call GroupEnumUnitsInRange(G,x+900*Cos(a),y+900*Sin(a),450,Base)
call GroupAddGroup(G,g)
call GroupEnumUnitsInRange(G,x+1125*Cos(a),y+1125*Sin(a),450,Base)
call GroupAddGroup(G,g)
loop
set E=FirstOfGroup(g)
exitwhen E==null
if Condition_Base(p,E)then
call EffectToRandomBone("war3mapImported\\SlashEffectRed by Deckai.mdx",E)
call SetUnitPosition(E,GetUnitX(E)+10*Cos(a),GetUnitY(E)+10*Sin(a))
call SetUnitAnimation(E,"death")
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(g,E)
endloop
endif
else
call SetUnitAcquireRange(u, 1500)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call UnitRemoveAbility(u,'A2FU')
call UnitRemoveAbility(u,'B02Z')
call UnitRemoveAbility(u,'B00A')
call PauseTimer(t)
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
