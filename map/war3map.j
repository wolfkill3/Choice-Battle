call SetUnitTurnSpeed(c,0)
call SaveUnitHandle(h,GetHandleId(n),StringHash("door"),c)
call SaveUnitHandle(h,GetHandleId(c),StringHash("door"),n)
endif
call IssueImmediateOrder(u,"stop")
call UnitRemoveAbility(u,'A10H')
loop
exitwhen i>=10
