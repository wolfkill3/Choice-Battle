local unit u=LoadUnitHandle(h,id,0)
local real x=LoadReal(h,id,6)
local real y=LoadReal(h,id,7)
local real x1=LoadReal(h,id,4)
local real y1=LoadReal(h,id,5)
local real time=LoadReal(h,id,3)
local real a=Atan2(y-y1,x-x1)
local real f=0
local player p=GetOwningPlayer(u)
local group G3=LoadGroupHandle(h,id,6)
local integer is = 9
call PauseUnit(u,false)
call ShowUnit(u,true)
if p==GetLocalPlayer()then
call SelectUnit(u,true)
endif
call SetUnitAnimation(u,"stand")
set n=CreateUnit(p,'edT6',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.5)
call SetUnitTimeScale(n,1)
call GroupClear(G3)
        loop
        exitwhen is>19
                if LoadUnitHandle(h,id,is) != null then
                //call RemoveUnit(LoadUnitHandle(h,id,is))
                call RemoveSavedHandle(h,id,is)
                endif
                set is = is + 1
        endloop
if GetUnitAbilityLevel(u, 'CB01') > 0 then
        call UnitRemoveAbility(u, 'CE01')
        call UnitRemoveAbility(u, 'CB01')
endif
call SetUnitInvulnerable(u,false)
call SetUnitXY_1(u,x,y, false)
call UnitRemoveAbility(u,'Ao93')
call UnitRemoveAbility(u,'Ao94')
call SetUnitVertexColor(u,255,255,255,255)
call SetUnitTurnSpeed(u,3)
call DestroyGroup(G3)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set u=null
set p=null
set G3=null
set t=null
endfunction
