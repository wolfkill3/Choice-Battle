        call SetUnitFlyHeight(n,350,0)
        set n=CreateUnit(p,'e0B2',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,1,0.01)
        call SetUnitVertexColor(n,40,150,255,60)
        call SetUnitScale(n,1,1,1)
        call SetUnitFlyHeight(n,350,0)
        set n=CreateUnit(p,'e0B2',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,1,0.01)
        call SetUnitVertexColor(n,40,150,255,50)
        call SetUnitFlyHeight(n,350,0)
        call SetUnitScale(n,1.5,1.5,1.5)
        set n=CreateUnit(p,'e0B2',x,y,GetRandomReal(0,359))
