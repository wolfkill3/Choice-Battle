local real y=GetUnitY(u)
local integer i=0
local real a=GetUnitFacing(u)*bj_DEGTORAD
set soundplay=SndN(2815) // Sound\Music\mp3Music\Gemini.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
if GetUnitTypeId(u)!='H06U' then
if lucy[ip]!=true then
if Lucy[ip]!=null then
    call RemoveUnit(Lucy[ip])
    set Lucy[ip]=null
endif
set n=CreateUnit(p,'e0ZH',x+155*Cos(a),y+155*Sin(a),a*bj_RADTODEG+180)
call UnitApplyTimedLife(n,'BTLF',1.5)
call SetUnitVertexColor(n,255,255,255,25)
call SetUnitTimeScale(n,0.5)
call SetUnitScale(n,3,3,3)
set n=CreateUnit(p,'e0SX',x+155*Cos(a),y+155*Sin(a),a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',.8)
call SetUnitTimeScale(n,0.8)
call SetUnitFlyHeight(n,0,0)
call SetUnitFlyHeight(n,250,220)
call SetUnitScale(n,0.7,0.7,0.7)
set n=CreateUnit(p,'e140',x+155*Cos(a),y+155*Sin(a),a*bj_RADTODEG+90)
call UnitApplyTimedLife(n,'BTLF',1.5)
call SetUnitTimeScale(n,0.8)
set n=CreateUnit(Player(14),'H06U',x+155*Cos(a),y+155*Sin(a),a*bj_RADTODEG)
call SetUnitOwner(n,p,true)
if GetUnitAbilityLevel(u,'A1EK')>0 then
    call UnitAddAbility(n,'A1ES')
    call SetUnitAbilityLevel(n,'A1ES',GetUnitAbilityLevel(u,'A1EK'))
endif
if GetUnitAbilityLevel(u,'A1EM')>0 then
    call UnitAddAbility(n,'A1ET')
    call SetUnitAbilityLevel(n,'A1ET',GetUnitAbilityLevel(u,'A1EM'))
endif
if GetUnitAbilityLevel(u,'A1ER')>0 then
    call UnitAddAbility(n,'A1ER')
    call SetUnitAbilityLevel(n,'A1ER',GetUnitAbilityLevel(u,'A1ER'))
    call StartAbilityCooldown(GetUnitAbility(n,'A1ER'),120)
endif
if GetUnitAbilityLevel(u,'A1EN')>0 then
    call UnitAddAbility(n,'A1EW')
    call SetUnitAbilityLevel(n,'A1EW',GetUnitAbilityLevel(u,'A1EN'))
endif
if GetUnitAbilityLevel(u,'A1EL')>0 then
    call UnitAddAbility(n,'A1EY')
    call SetUnitAbilityLevel(n,'A1EY',GetUnitAbilityLevel(u,'A1EL'))
endif
set Lucy[ip]=n
set LUcy[ip]=u
set lucy[ip]=true
call SetHeroLevel(Lucy[ip],GetHeroLevel(u),false)
call SetHeroAgi(Lucy[ip],R2I(GetHeroAgi(LUcy[ip],true)*1.8),false)
call SetHeroStr(Lucy[ip],R2I(GetHeroStr(LUcy[ip],true)*1.25),false)
call SetHeroInt(Lucy[ip],R2I(GetHeroInt(LUcy[ip],true)*1.15),false)
call SetUnitState(Lucy[ip],UNIT_STATE_MANA,GetUnitState(Lucy[ip],UNIT_STATE_MAX_MANA))
call SetUnitMoveSpeed(Lucy[ip],550)
if FFAMode==false then
if Player(ip)==Player(0)or Player(ip)==Player(1)or Player(ip)==Player(2)or Player(ip)==Player(3)or Player(ip)==Player(4)then
call GroupAddUnit(udg_CG[1],Lucy[ip])
elseif Player(ip)==Player(5)or Player(ip)==Player(6)or Player(ip)==Player(7)or Player(ip)==Player(8)or Player(ip)==Player(9)then
call GroupAddUnit(udg_CG[2],Lucy[ip])
endif
endif
call SaveUnitHandle(h,id,2,n)
call SetUnitTimeScale(n,1)
call SaveUnitHandle(h,id,0,u)
call TimerStart(t,0.5,true,function LucyBlizCast2)
else
if UnitIsAlive(Lucy[ip])==false then
call ReviveHero(Lucy[ip],x+155*Cos(a),y+155*Sin(a),false)
call SetUnitControlCount(Lucy[ip], 11,0)
call SetHeroLevel(Lucy[ip],GetHeroLevel(u),false)
call SetHeroAgi(Lucy[ip],R2I(GetHeroAgi(LUcy[ip],true)*1.8),false)
call SetHeroStr(Lucy[ip],R2I(GetHeroStr(LUcy[ip],true)*1.25),false)
call SetHeroInt(Lucy[ip],R2I(GetHeroInt(LUcy[ip],true)*1.15),false)
call SetUnitMoveSpeed(Lucy[ip],550)
call SetUnitState(Lucy[ip],UNIT_STATE_LIFE,1)
call SetUnitState(Lucy[ip],UNIT_STATE_MANA,1)
call HealTextTag(Lucy[ip],Lucy[ip],GetUnitState(Lucy[ip],UNIT_STATE_MAX_LIFE)*myCustomHeal2(Lucy[ip],1),"HealthRes")
call HealTextTag(Lucy[ip],Lucy[ip],GetUnitState(Lucy[ip],UNIT_STATE_MAX_MANA)*myCustomMana2(Lucy[ip],1),"ManaRes")
call SetUnitState(Lucy[ip],UNIT_STATE_LIFE,GetUnitState(Lucy[ip],UNIT_STATE_MAX_LIFE))
call SetUnitState(Lucy[ip],UNIT_STATE_MANA,GetUnitState(Lucy[ip],UNIT_STATE_MAX_MANA))
call StartAbilityCooldown(GetUnitAbility(Lucy[ip],'A1ER'),120)
else
call SetUnitX(Lucy[ip],x+155*Cos(a))
call SetUnitY(Lucy[ip],y+155*Sin(a))
set n=CreateUnit(p,'e0ZH',x+155*Cos(a),y+155*Sin(a),a*bj_RADTODEG+180)
