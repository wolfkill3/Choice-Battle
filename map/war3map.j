function RLiPush2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real a=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real sc=0
local real y=GetUnitY(l__d)
local real dist=LoadReal(h,id,3)
if dist>0 and l__d!=null then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SaveReal(h,id,3,dist-speed)
call SaveReal(h,id,1,speed-speed*0.03)
set n=CreateUnit(GetOwningPlayer(l__d),'e0ZH',x,y,a*bj_RADTODEG+180)
call SetUnitVertexColor(n,255,255,255,55)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(GetOwningPlayer(l__d),'e117',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,GetRandomInt(25,155))
set sc=GetRandomReal(0.25,1)
call SetUnitScale(n,sc,sc,sc)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set t=null
endfunction
