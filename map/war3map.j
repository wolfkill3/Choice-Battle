function EScatachCast6 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=LoadReal(h,id,6)
local real y=LoadReal(h,id,7)
local real dist=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
local real sc=0
local real is=0
local real ig=30*bj_DEGTORAD
call SetUnitXY_1(u,x,y, false)
loop
exitwhen is>=13
set n=CreateUnit(p,'e0ZH',x+250*Cos(ig*is),y+250*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,200,255,200,55)
call UnitApplyTimedLife(n,'BTLF',0.55)
call SetUnitTimeScale(n,2)
set is=is+1
endloop
call SetUnitFlyHeight(u,0,0)
call SetUnitInvulnerable(u,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call PauseUnit(u,false)
call UnitRemoveAbility(u,'A1F8')
call SetUnitTimeScale(u,1)
set u=null
set p=null
set t=null
endfunction
