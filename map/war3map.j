call UnitApplyTimedLife(n,'BTLF',0.2)
call SetUnitTimeScale(n,2)
call SaveReal(h,id,15,dist+25)
call SetUnitAnimation(n,"attack")
else
call Push(c,50,a,500)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call PauseUnit(u,false)
call myCustomDamage(u,c,GetHeroAgi(u,true)*(3+GetUnitAbilityLevel(u,'A0IU')),false,false,null,null,null)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call SetUnitTimeScale(u,2)
endif
