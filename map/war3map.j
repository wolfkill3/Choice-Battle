function TDeidaraCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
call SaveUnitHandle(h,id,0,u)
set n=CreateUnit(p,'eo9P',x+25*Cos(a),y+25*Sin(a),a*bj_RADTODEG)
call SaveUnitHandle(h,id,1,n)
call SetUnitAnimationByIndex(n,0)
call SetUnitTimeScale(n,2)
call SaveReal(h,id,2,SR(x,y,x1,y1))
call SaveReal(h,id,3,a)
call SaveGroupHandle(h,id,4,CreateGroup())
set n=CreateUnit(p,'eo0N',x,y,a*bj_RADTODEG-45)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'eo0N',x,y,a*bj_RADTODEG+45)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'eo0N',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set soundplay=SndN(3004) // Sound\war3mapImported\DeidaraT1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SetSoundVolume(soundplay,250)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.02,true,function TDeidaraCast2)
set u=null
set p=null
set t=null
endfunction
