function GogetaQCast3 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit l__d=LoadUnitHandle(h,id,4)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real dmg=GetHeroAgi(u,true)*(GetUnitAbilityLevel(u,'A0P5')+1)+75
    local real x1=GetUnitX(l__d)
    local real y1=GetUnitY(l__d)
    local real a=GetUnitFacing(u)*bj_DEGTORAD
    local real dist=LoadReal(h,id,2)
    local player p=GetOwningPlayer(u)
    local group g=LoadGroupHandle(h,id,8)
    local group g2
    call SaveReal(h,id,2,dist+10)
    if dist<610 then
        if dist<90 then
            set x=x+dist*Cos(a)
            set y=y+dist*Sin(a)
            call SetUnitXY_1(u,x,y, false)
            call PauseUnit(u,true)
            call SetUnitVertexColor(u,255-R2I(2.5*dist),255-R2I(2.5*dist),255-R2I(2.5*dist),255-R2I(2.5*dist))
            if SR(x,y,x1,y1)<125 then
                call ShowUnit(u,false)
            else
                set n=CreateUnit(p,'e31F',x,y,a*bj_RADTODEG)
                if GetUnitAbilityLevel(u,'A16X')>0 then
                    call UnitAddAbility(n,'A16X')
                elseif GetUnitAbilityLevel(u,'A16Y')>0 then
                    call UnitAddAbility(n,'A16Y')
                elseif GetUnitAbilityLevel(u,'A170')>0 then
                    call UnitAddAbility(n,'A170')
                    call AddUnitAnimationProperties(n,"alternate",true)
                elseif GetUnitAbilityLevel(u,'A171')>0 then
                    call UnitAddAbility(n,'A171')
                endif
                call SetUnitTimeScale(n,0)
                call UnitApplyTimedLife(n,1,0.15)
                call SetUnitVertexColor(n,255-R2I(2.5*dist),255-R2I(2.5*dist),255-R2I(2.5*dist),255-R2I(2.5*dist))
                call ShikiCloneEffect(n,1.5,1.05,1.25,150)
            endif
        else
            if dist==100 then
                call ShowUnit(u,false)
            endif
            if ModuloReal(dist,70)<1 then
                set g2=CopyGroup(g)
                call ShakeCamera(0.2,25)
                loop
                    set E=FirstOfGroup(g2)
                    exitwhen E==null
                    if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
                        call SetUnitAnimation(E,"death")
                        set EFF=AddSpecialEffect("AZ_DD021.mdx", GetUnitX(E)+GetRandomReal(-35,35)*Cos(a+GetRandomReal(-40,40)*bj_DEGTORAD), GetUnitY(E)+GetRandomReal(-35,35)*Sin(a+GetRandomReal(-40,40)*bj_DEGTORAD))
                        call SetSpecialEffectScale(EFF , GetRandomReal(0.8,1.4))
                        call SetSpecialEffectFacing(EFF , a  * bj_RADTODEG+GetRandomReal(-80,80))
                        call SetSpecialEffectZ(EFF , GetRandomReal(30,80))
                        //call SetSpecialEffectPitch(EFF , GetRandomReal(-15,15))
                        call DestroyEffect(EFF)
                        set EFF=AddSpecialEffect("war3mapImported\\dash sfx.mdl", GetUnitX(E)+GetRandomReal(-35,35)*Cos(a+GetRandomReal(-40,40)*bj_DEGTORAD), GetUnitY(E)+GetRandomReal(-35,35)*Sin(a+GetRandomReal(-40,40)*bj_DEGTORAD))
                        call SetSpecialEffectScale(EFF , 0.2)
                        call SetSpecialEffectZ(EFF , GetRandomReal(30,90))
                        call SetSpecialEffectOrientation(EFF , a* bj_RADTODEG,GetRandomReal(-40,40),90)
                        call DestroyEffect(EFF)
                        set EFF=AddSpecialEffect("AZ_PA_C.mdx", GetUnitX(E)+GetRandomReal(-20,20)*Cos(a+GetRandomReal(-40,40)*bj_DEGTORAD), GetUnitY(E)+GetRandomReal(-20,20)*Sin(a+GetRandomReal(-40,40)*bj_DEGTORAD))
                        call SetSpecialEffectScale(EFF , GetRandomReal(0.5,0.9))
                        call SetSpecialEffectZ(EFF , GetRandomReal(60,150))
                        if GetRandomInt(0,1)==1 then
                        call SetSpecialEffectOrientation(EFF , a * bj_RADTODEG+90,GetRandomReal(-35,35),GetRandomReal(-40,-15))
                        else
                        call SetSpecialEffectOrientation(EFF , a * bj_RADTODEG-90,GetRandomReal(-35,35),GetRandomReal(15,40))
                        endif
                        call SetSpecialEffectVertexColour(EFF , GetRandomInt(30,160) , GetRandomInt(100,200) , GetRandomInt(150,255) , 200)
                        call DestroyEffect(EFF)
                    endif
                    set EFF=AddSpecialEffect("Minato-37.mdx", GetUnitX(E)+GetRandomReal(-35,35)*Cos(a+GetRandomReal(-40,40)*bj_DEGTORAD), GetUnitY(E)+GetRandomReal(-35,35)*Sin(a+GetRandomReal(-40,40)*bj_DEGTORAD))
                    call SetSpecialEffectScale(EFF , GetRandomReal(0.75,1.35))
                    call SetSpecialEffectZ(EFF , GetRandomReal(30,90))
                    call SetSpecialEffectRoll(EFF , 90)
                    call DestroyEffect(EFF)
                    call GroupRemoveUnit(g2,E)
                endloop
                call DestroyGroupTimed(g2,3)
            endif
        endif
    else
    if dist==630 then
        call ShowUnit(u,true)
        call SetUnitXY_1(u,x1+150*Cos(a),y1+150*Sin(a), false)
        if GetLocalPlayer()==p then
            call ClearSelection()
            call SelectUnit(u,true)
        endif
        call SetUnitTimeScale(u,1)
    else
        if dist>630 and dist<=680 then
            call SetUnitVertexColor(u,255,255,255,255)
            //set EFF=AddSpecialEffect("spiritarrow_byepsilon.mdx",x+GetRandomReal(-20,0)*Cos(a+GetRandomReal(-20,20)*bj_DEGTORAD), y+GetRandomReal(-20,0)*Sin(a+GetRandomReal(-20,20)*bj_DEGTORAD))
            //call SetSpecialEffectScale(EFF , GetRandomReal(0.5,0.9))
            //call SetSpecialEffectZ(EFF , GetRandomReal(60,150))
            //call SetSpecialEffectPitch(EFF , GetRandomReal(-35,35))
            //call SetSpecialEffectFacing(EFF , a * bj_RADTODEG)
            //call SetSpecialEffectVertexColour(EFF , GetRandomInt(30,160) , GetRandomInt(30,200) , GetRandomInt(30,255) , 255)
            //call DestroyEffect(EFF)
            set n=CreateUnit(p,'e31F',x,y,a*bj_RADTODEG)
            if GetUnitAbilityLevel(u,'A16X')>0 then
                call UnitAddAbility(n,'A16X')
            elseif GetUnitAbilityLevel(u,'A16Y')>0 then
                call UnitAddAbility(n,'A16Y')
            elseif GetUnitAbilityLevel(u,'A170')>0 then
                call UnitAddAbility(n,'A170')
                call AddUnitAnimationProperties(n,"alternate",true)
            elseif GetUnitAbilityLevel(u,'A171')>0 then
                call UnitAddAbility(n,'A171')
            endif
            call SetUnitTimeScale(n,0)
            call UnitApplyTimedLife(n,1,0.2)
            call ShikiCloneEffect(n,1.5,1.05,1.25,150)
            set x=x+(2600 / (dist-500))*Cos(a)
            set y=y+(2600 / (dist-500))*Sin(a)
            call SetUnitXY_1(u,x,y, false)
        elseif dist>680 then
            loop
            set E=FirstOfGroup(g)
            exitwhen E==null
            call PauseUnit(E,false)
            call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,false)
            call myCustomDamage(u,E,dmg,false,false,null,null,null)
            call SetControlToUnit(E,E,1,"stun")
            call GroupRemoveUnit(g,E)
            endloop
            call PauseTimer(t)
            set punisher=false
            call PauseUnit(u,false)
            call SetUnitInvulnerable(u,false)
            call DestroyTimer(t)
            call FlushChildHashtable(h,id)
            call DestroyGroup(g)
            call DestroyGroup(g2)
        endif
    endif
    endif
    set l__d=null
    set u=null
    set p=null
    set g=null
    set g2=null
    set t=null
endfunction
function GogetaQCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit l__d=LoadUnitHandle(h,id,1)
    local real x=GetUnitX(l__d)
    local real y=GetUnitY(l__d)
    local real x1=GetUnitX(u)
    local real y1=GetUnitY(u)
    local real a=LoadReal(h,id,3)
    local real dist=LoadReal(h,id,2)
    local player p=GetOwningPlayer(u)
    local group g=LoadGroupHandle(h,id,8)
    local real time=LoadReal(h,id,12)
    if time==0 then
        set EFF=AddSpecialEffect("tx_white1.mdx", x1, y1)
        call DestroyEffect(EFF)
    endif
    if time<0.3 then
    set EFF=AddSpecialEffect("AZ_PA_C.mdx", x+GetRandomReal(-10,10)*Cos(a), y+GetRandomReal(-10,10)*Sin(a))
    call SetSpecialEffectScale(EFF , GetRandomReal(0.8,1.5))
    call SetSpecialEffectOrientation(EFF , a* bj_RADTODEG,GetRandomReal(-25,25),GetRandomReal(-180,180))
    call SetSpecialEffectTimeScale(EFF , 0.5) 
    call SetSpecialEffectZ(EFF , GetRandomReal(20,130))
    call SetSpecialEffectVertexColour(EFF , GetRandomInt(110,160) , GetRandomInt(120,250) , GetRandomInt(150,255) , 160)
    call RemoveEffect(EFF, 0.3, false, CreateTimer())
    call SaveReal(h,id,12,time+0.04)
    else
    if dist<1600 then
    call PauseUnit(u,true)
    set x=x+129*Cos(a)
    set y=y+129*Sin(a)
    set EFF=AddSpecialEffect("AZ_PA_C.mdx", x+GetRandomReal(-10,10)*Cos(a), y+GetRandomReal(-10,10)*Sin(a))
    call SetSpecialEffectScale(EFF , GetRandomReal(0.8,1.5))
    call SetSpecialEffectTimeScale(EFF , 0.2)
    call SetSpecialEffectZ(EFF , GetRandomReal(60,130))
    if GetRandomInt(0,1)==1 then
    call SetSpecialEffectOrientation(EFF , a* bj_RADTODEG+GetRandomReal(-75,75),GetRandomReal(-15,15),GetRandomReal(-15,15))
    else
    call SetSpecialEffectOrientation(EFF , a* bj_RADTODEG+GetRandomReal(-75,75),GetRandomReal(-15,15),GetRandomReal(-165,-195))
    endif
    call SetSpecialEffectVertexColour(EFF , GetRandomInt(110,160) , GetRandomInt(120,250) , GetRandomInt(150,255) , 160)
    call DestroyEffect(EFF)
    set EFF=AddSpecialEffect("RougiSlash.mdx", x+GetRandomReal(-10,10)*Cos(a), y+GetRandomReal(-10,10)*Sin(a))
    call SetSpecialEffectScale(EFF , GetRandomReal(0.8,1.5))
    if GetRandomInt(0,1)==1 then
    call SetSpecialEffectOrientation(EFF , a* bj_RADTODEG+GetRandomReal(-75,75),GetRandomReal(-15,15),GetRandomReal(-15,15))
    else
