function Trig_LVL2_Actions takes nothing returns nothing
    local integer LvlS=S2I(SubString(GetEventPlayerChatString(),5,7))
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=10
    loop
    exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
        call SetHeroLevelBJ(udg_Hero[GetForLoopIndexA()],1,false)
        call SetHeroLevelBJ(udg_Hero[GetForLoopIndexA()],LvlS,false)
        call GroupEnumUnitsOfPlayer(GLVL,Player(bj_forLoopAIndex-1),LevelBase) //lvlbool
        loop
        set E=FirstOfGroup(GLVL)
        //call BJDebugMsg(I2S(LvlS))
        //call BJDebugMsg(I2S(LvlS*2))
        exitwhen E==null
        if LvlS<25 and GetUnitTypeId(E)=='h03J' then
            call RemoveUnit(E)
            //call BJDebugMsg("25")
        endif
        if LvlS<20 and GetUnitTypeId(E)=='h246' then
            set lvl20[GetPlayerId(GetOwningPlayer(E))]=0
            call RemoveUnit(E)
            //call BJDebugMsg("20")
        endif
        if LvlS<10 and GetUnitTypeId(E)=='h346' then
            set lvl10[GetPlayerId(GetOwningPlayer(E))]=0
            call RemoveUnit(E)
            //call BJDebugMsg("20")
        endif
        if LvlS<12 and GetUnitTypeId(E)=='h04K' then
            set lvl12[GetPlayerId(GetOwningPlayer(E))]=0
            call RemoveUnit(E)
            //call BJDebugMsg("12")
        endif
        if LvlS<15 and GetUnitTypeId(E)=='h446' then
            set lvl15[GetPlayerId(GetOwningPlayer(E))]=0
            call RemoveUnit(E)
            //call BJDebugMsg("20")
        endif
        if LvlS<25 and GetUnitTypeId(E)=='h546' then
            set lvl25[GetPlayerId(GetOwningPlayer(E))]=0
            call RemoveUnit(E)
            //call BJDebugMsg("20")
        endif
        if LvlS<18 and GetUnitTypeId(E)=='h068' then
            set lvl18[GetPlayerId(GetOwningPlayer(E))]=0
            call RemoveUnit(E)
            //call BJDebugMsg("18")
        endif
        if LvlS<6 and GetUnitTypeId(E)=='h046' then
            set lvl6[GetPlayerId(GetOwningPlayer(E))]=0
            call RemoveUnit(E)
            //call BJDebugMsg("6")
        endif
        if LvlS<5 and GetUnitTypeId(E)=='h146' then
            set lvl5[GetPlayerId(GetOwningPlayer(E))]=0
            call RemoveUnit(E)
            //call BJDebugMsg("5")
        endif
        if LvlS<8 and GetUnitTypeId(E)=='h101' then
            set lvl8[GetPlayerId(GetOwningPlayer(E))]=0
            call RemoveUnit(E)
            //call BJDebugMsg("5")
        endif
        if LvlS<11 and GetUnitTypeId(E)=='h102' then
            set lvl11[GetPlayerId(GetOwningPlayer(E))]=0
            call RemoveUnit(E)
            //call BJDebugMsg("5")
        endif
        if LvlS<14 and GetUnitTypeId(E)=='h103' then
            set lvl14[GetPlayerId(GetOwningPlayer(E))]=0
            call RemoveUnit(E)
            //call BJDebugMsg("5")
        endif
        if LvlS<17 and GetUnitTypeId(E)=='h104' then
            set lvl17[GetPlayerId(GetOwningPlayer(E))]=0
            call RemoveUnit(E)
            //call BJDebugMsg("5")
        endif
        if LvlS<23 and GetUnitTypeId(E)=='h105' then
            set lvl23[GetPlayerId(GetOwningPlayer(E))]=0
            call RemoveUnit(E)
            //call BJDebugMsg("5")
        endif
        if LvlS<26 and GetUnitTypeId(E)=='h106' then
            set lvl26[GetPlayerId(GetOwningPlayer(E))]=0
            call RemoveUnit(E)
            //call BJDebugMsg("5")
        endif
        if LvlS<29 and GetUnitTypeId(E)=='h107' then
            set lvl29[GetPlayerId(GetOwningPlayer(E))]=0
            call RemoveUnit(E)
            //call BJDebugMsg("5")
        endif
        if LvlS<32 and GetUnitTypeId(E)=='h108' then
            set lvl32[GetPlayerId(GetOwningPlayer(E))]=0
            call RemoveUnit(E)
            //call BJDebugMsg("5")
        endif
        if LvlS<35 and GetUnitTypeId(E)=='h109' then
            set lvl35[GetPlayerId(GetOwningPlayer(E))]=0
            call RemoveUnit(E)
            //call BJDebugMsg("5")
        endif
        call GroupRemoveUnit(GLVL,E)
        endloop
        set bj_forLoopAIndex=bj_forLoopAIndex+1
    endloop
endfunction
