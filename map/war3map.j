local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=LoadReal(h,id,12)
local real dist=LoadReal(h,id,5)+40
local real dmg=GetHeroStr(u,true)*(3+GetUnitAbilityLevel(u,'A02W'))
local player p=GetOwningPlayer(u)
local real r=90*bj_DEGTORAD
local real a2=a*bj_RADTODEG
if dist<700 then
call SetUnitXY_1(u,x1,y1, false)
set x1=x1+40*Cos(a)
set y1=y1+40*Sin(a)
call SetUnitXY_1(c,x1,y1, false)
set n=CreateUnit(p,'e01P',x1+90*Cos(a+r),y1+90*Sin(a+r),a2)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
call SetUnitAnimation(n,"attack")
call SetUnitVertexColor(n,255,255,255,100)
set n=CreateUnit(p,'e01P',x1-90*Cos(a+r),y1-90*Sin(a+r),a2)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
call SetUnitAnimation(n,"attack")
call SetUnitVertexColor(n,255,255,255,100)
call UnitApplyTimedLife(CreateUnit(p,'e0B1',x1,y1,GetRandomReal(0,359)),'BTLF',0.4)
call UnitApplyTimedLife(CreateUnit(p,'e0AZ',x1,y1,GetRandomReal(0,359)),'BTLF',0.4)
set n=CreateUnit(p,'e0B2',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitVertexColor(n,255,220,40,50)
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitAnimation(u,"attack")
call SaveReal(h,id,5,dist)
else
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call PauseUnit(u,false)
call myCustomDamage(u,c,dmg,false,false,null,null,null)
call Push3(c,75,a,805,"war3mapImported\\s_Shockwave.mdx")
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitVertexColor(u,255,255,255,255)
call FlushChildHashtable(h,id)
call SetUnitTimeScale(u,1)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
