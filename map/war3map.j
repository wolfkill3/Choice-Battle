function EnkiduQCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real dmg=GetHeroAgi(u,true)*(GetUnitAbilityLevel(u,'A1HW')+1)+50
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=0
local real x1=0
local real y1=0
local real he=GetUnitFlyHeight(u)
local real he2=0
local real time=LoadReal(h,id,1)-0.02
local integer i=20
local integer l__s=60
local integer e=100
local integer per=LoadInteger(h,id,2)
if time>0 then
call SaveReal(h,id,1,time)
loop

if GetUnitAbilityLevel(LoadUnitHandle(h,id,l__s),'B05G') > 0 then
        call DestroyLightning(LoadLightningHandle(h,id,i))
        call UnitRemoveAbility(LoadUnitHandle(h,id,l__s),'A1HT')
        call UnitRemoveAbility(LoadUnitHandle(h,id,l__s),'AP06')
        call RemoveUnit(LoadUnitHandle(h,id,e))
        call RemoveSavedHandle(h,id,i)
        call RemoveSavedHandle(h,id,l__s)
        call RemoveSavedHandle(h,id,e)
endif
if LoadLightningHandle(h,id,i)!= null and LoadUnitHandle(h,id,l__s)!=null and LoadUnitHandle(h,id,e)!=null then
set E=LoadUnitHandle(h,id,l__s)
set x1=GetUnitX(E)
set y1=GetUnitY(E)
set a=Atan2(y1-y,x1-x)
set d=LoadUnitHandle(h,id,e)
call SetUnitX(d,x+75*Cos(a))
call SetUnitY(d,y+75*Sin(a))
call SetUnitFacing(d,a*bj_RADTODEG)
call SetUnitFlyHeight(d,he+100,0)
set he2=GetUnitFlyHeight(E)
set a=Atan2(y-y1,x-x1)
if SR(x,y,x1,y1)>350 then
if he<1 then
set x1=GetUnitX(E)+35*Cos(a)
set y1=GetUnitY(E)+35*Sin(a)
else
set x1=GetUnitX(E)+125*Cos(a)
set y1=GetUnitY(E)+125*Sin(a)
endif
if GetUnitAbilityLevel(E,'A1HU')==0 then
call SetUnitX(E,x1)
call SetUnitY(E,y1)
endif
if he2<1 and UnitIsAlive(E)and GetUnitAbilityLevel(E,'A1HU')==0 then
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl",x1,y1))
endif
endif
if SquareRoot((he2-he)*(he2-he))>350 and he>0 and GetUnitAbilityLevel(E,'A1HU')==0 then
if he2<he then
call SetUnitFlyHeight(E,he2+125,0)
else
call SetUnitFlyHeight(E,he2-125,0)
endif
endif
if he<1 then
if he2>40 then
call SetUnitFlyHeight(E,he2-35,0)
else
call SetUnitFlyHeight(E,0,0)
endif
endif
set L=LoadLightningHandle(h,id,i)
call MoveLightningEx(L,false,x-75*Cos(a),y-75*Sin(a),GetUnitZCustom(u)+100,x1,y1,GetUnitZCustom(E)+100)
endif
set i=i+1
set l__s=l__s+1
set e=e+1
exitwhen i>=per
endloop
else
loop
//if LoadLightningHandle(h,id,i)!= null and LoadUnitHandle(h,id,l__s)!=null and LoadUnitHandle(h,id,e)!=null then
set E=LoadUnitHandle(h,id,l__s)
if LoadLightningHandle(h,id,i)!= null then
call DestroyLightning(LoadLightningHandle(h,id,i))
endif
call UnitRemoveAbility(E,'A1HT')
call UnitRemoveAbility(E,'AP06')
if E!=null then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetUnitFlyHeight(E,0,0)
endif
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Tidal.mdx",E,"chest"))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX-Special.mdx",E,"chest"))
if LoadUnitHandle(h,id,e)!=null then
call RemoveUnit(LoadUnitHandle(h,id,e))
endif
//endif
set i=i+1
set l__s=l__s+1
set e=e+1
exitwhen i>=per
endloop
call PauseTimer(t)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
endif
set u=null
set t=null
endfunction

