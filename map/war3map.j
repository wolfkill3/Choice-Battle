function Trig_Swap_Ability_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A080'
endfunction
function Trig_Swap_Ability_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local integer lvl=GetUnitAbilityLevel(u,'A085')
local integer id=GetPlayerId(GetOwningPlayer(u))
local integer ra=GetRandomInt(1,4)
if GetUnitAbilityLevel(u,'A07Y')>0 then
call UnitRemoveAbility(u,'A07Y')
elseif GetUnitAbilityLevel(u,'A08A')>0 then
call UnitRemoveAbility(u,'A08A')
elseif GetUnitAbilityLevel(u,'A084')>0 then
call UnitRemoveAbility(u,'A084')
elseif GetUnitAbilityLevel(u,'A083')>0 then
call UnitRemoveAbility(u,'A083')
endif
call UnitAddAbility(u,gda[ra])
call SetUnitAbilityLevel(u,gda[ra],lvl)
set abgo[id]=gda[ra]
set u=null
endfunction
function Trig_System_CAI_Conditions takes nothing returns boolean
return GetLearnedSkill()=='A085'
endfunction
function Trig_System_CAI_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local integer lvl=GetUnitAbilityLevel(u,'A085')
local integer id=GetPlayerId(GetOwningPlayer(u))
local integer str=StringHash("skill")
if lvl==1 then
call UnitAddAbility(u,'A080')
call UnitAddAbility(u,'A07Y')
set abgo[id]='A07Y'
set gda[1]='A07Y'
set gda[2]='A08A'
set gda[3]='A084'
set gda[4]='A083'
elseif GetUnitAbilityLevel(u,'A07Y')>0 then
call SetUnitAbilityLevel(u,'A080',lvl)
