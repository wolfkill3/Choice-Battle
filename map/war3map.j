function SecretRoaringThunderCast2 takes nothing returns nothing //Laxus T new
	local timer t=GetExpiredTimer()
	local integer id=GetHandleId(t)
	local unit u=LoadUnitHandle(h,id,0)
	local unit c=LoadUnitHandle(h,id,1)
	local real x=GetUnitX(u)
	local real y=GetUnitY(u)
	local real x1=GetUnitX(c)
	local real y1=GetUnitY(c)
	local real a=Atan2(y1-y,x1-x)
	local real time=LoadReal(h,id,2)
	local boolean DFL=LoadBoolean(h,id,3)
	local player p=GetOwningPlayer(u)
	local integer act=LoadInteger(h,id,SH_Act)
	local real mx
	local real m
	if act==0 then
		if time<0.5 then
			call SaveReal(h,id,2,time+0.025)
		else
			if SR(x,y,x1,y1)>100 and GetWidgetLife(c)>0 then
				set x=x+60*Cos(a)
				set y=y+60*Sin(a)
				call SetUnitXY_1(u,x,y,false)
				call SetUnitFacing(u,a*bj_RADTODEG)
				set n=CreateUnit(p,'e0QG',x,y,GetRandomReal(0,359))
				call UnitApplyTimedLife(n,'BTLF',0.01)
				call SetUnitScale(n,0.65,0.65,0.65)
				if DFL then
					call SetUnitVertexColor(n,255,60,60,95)
				else
					call SetUnitVertexColor(n,255,255,255,25)
				endif
				set n=CreateUnit(p,'e0QG',x,y,GetRandomReal(0,359))
				call UnitApplyTimedLife(n,'BTLF',0.01)
				call SetUnitScale(n,1,1,1)
				if DFL then
					call SetUnitVertexColor(n,255,60,60,95)
				else
					call SetUnitVertexColor(n,255,255,255,50)
				endif
				set n=CreateUnit(p,'e0QH',x,y,GetRandomReal(0,359))
				call UnitApplyTimedLife(n,'BTLF',0.5)
				call SetUnitScale(n,1,1,1)
				call SetUnitFlyHeight(n,75,0)
				if DFL then
					call SetUnitVertexColor(n,255,60,60,255)
				else
					call SetUnitVertexColor(n,255,255,255,255)
				endif
				set n=CreateUnit(p,'e0V1',x,y,a*bj_RADTODEG)
				call UnitApplyTimedLife(n,'BTLF',0.25)
				if DFL then
					call SetUnitVertexColor(n,175,60,60,95)
				else
					call SetUnitVertexColor(n,175,175,175,75)
				endif
				call SetUnitTimeScale(n,2)
				call SetUnitAnimation(n,"attack")
				call SetUnitAnimation(u,"attack")
			else
				call SaveInteger(h,id,SH_Act, 1)
				call SaveReal(h,id,2,0.0)
				set n=CreateUnit(GetOwningPlayer(u), 'dR20', x1, x1, 0)
				call SetUnitVertexColor(n, 255, 255, 255, 100)
				call SetUnitScale(n, 2, 2, 2)
				call UnitApplyTimedLife(n,'BTLF', 1.5)
				call MyRemoveUnit(n, 2)
                if SR(x,y,x1,y1)<100 and LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==true then
                    call PauseUnit(u,false)
                    call SetUnitInvulnerable(u,false)
                    call PauseUnit(c,false)
                    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
                    call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
                    call PauseTimer(t)
                    call DestroyTimer(t)
                    call SetUnitVertexColor(u,255,255,255,255)
                    call FlushChildHashtable(h,id)
                endif
			endif
		endif
	else
		if time<1.5 then
			call SetUnitX(u, GetUnitX(c)-100*Cos(a))
			call SetUnitY(u, GetUnitY(c)-100*Sin(a))
			call PauseUnit(c,true)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
			//call SetUnitInvulnerable(c, true)
			call SetUnitInvulnerable(u, true)
			call SaveReal(h,id,2,time+0.025)
			if time==0.25 then
				call SetUnitAnimationByIndex(u, 4)
				call SetUnitTimeScale(u, 0.3)
			endif
		else
			call ShakeCamera(0.2, 15)
			call PauseUnit(c,false)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
			call SetUnitInvulnerable(c, false)
			call SetUnitInvulnerable(u,false)
			set x1=x1+200*Cos(a)
			set y1=y1+200*Sin(a)
			call UnitApplyTimedLife(CreateUnit(p,'e0QI',x1,y1,GetRandomReal(0,359)),'BTLF',0.01)
			call UnitApplyTimedLife(CreateUnit(p,'e0QG',x1,y1,GetRandomReal(0,359)),'BTLF',0.01)
			call UnitApplyTimedLife(CreateUnit(p,'e0QK',x1,y1,GetRandomReal(0,359)),'BTLF',2)
			call UnitApplyTimedLife(CreateUnit(p,'e0QH',x1,y1,GetRandomReal(0,359)),'BTLF',2)
			call UnitApplyTimedLife(CreateUnit(p,'e0AX',x1,y1,GetRandomReal(0,359)),'BTLF',1)
			call UnitApplyTimedLife(CreateUnit(p,'e0AW',x1,y1,GetRandomReal(0,359)),'BTLF',0.01)
			call UnitApplyTimedLife(CreateUnit(p,'e0B1',x1,y1,GetRandomReal(0,359)),'BTLF',1)
			call UnitApplyTimedLife(CreateUnit(p,'e0B4',x1,y1,GetRandomReal(0,359)),'BTLF',1)
			call UnitApplyTimedLife(CreateUnit(p,'e0AZ',x1,y1,GetRandomReal(0,359)),'BTLF',1)
			call UnitApplyTimedLife(CreateUnit(p,'e0B3',x1,y1,GetRandomReal(0,359)),'BTLF',1)
			set n=CreateUnit(p, 'e0C7', x1, y1, GetRandomInt(0, 360))
			call MyRemoveUnit(n, 6)
			set n=CreateUnit(p, 'e0QH', x1, y1, GetRandomInt(0, 360))
			call SetUnitScale(n, 3, 3, 3)
			call UnitApplyTimedLife(n,'BTLF', 1.7)
			call MyRemoveUnit(n, 2.5)
			set n=CreateUnit(p, 'e0QH', x1, y1, GetRandomInt(0, 360))
			call SetUnitScale(n, 2.5, 2.5, 2.5)
			call UnitApplyTimedLife(n,'BTLF', 1.7)
			call MyRemoveUnit(n, 2.5)
			set n=CreateUnit(p, 'dR99', x1, y1, a)
			call SetUnitScale(n, 3, 3, 3)
			call SetUnitFlyHeight(n, 10, 0)
			call MyRemoveUnit(n, 2.5)
			set n=CreateUnit(p, 'dR99', x1+150*Cos(a+70*bj_DEGTORAD), y1+150*Sin(a+70*bj_DEGTORAD), a*bj_RADTODEG-120)
			call SetUnitScale(n, 3, 3, 3)
			call SetUnitFlyHeight(n, 10, 0)
			call MyRemoveUnit(n, 2.5)
			set n=CreateUnit(p, 'dR99', x1+150*Cos(a-70*bj_DEGTORAD), y1+150*Sin(a-70*bj_DEGTORAD), a*bj_RADTODEG+120)
			call SetUnitScale(n, 3, 3, 3)
			call SetUnitFlyHeight(n, 10, 0)
			call MyRemoveUnit(n, 2.5)
			set n=CreateUnit(p, 'd052', x1, y1, a*bj_RADTODEG+120)
			call SetUnitScale(n, 5, 5, 5)
			call SetUnitFlyHeight(n, 150, 0)
			call MyRemoveUnit(n, 2.5)
			set n=CreateUnit(p, 'd054', x1, y1, GetRandomInt(0, 360))
			call UnitApplyTimedLife(n,'BTLF', 1)
			call MyRemoveUnit(n, 2.7)
			set n=CreateUnit(p, 'd053', x1, y1, GetRandomInt(0, 360))
			call UnitApplyTimedLife(n,'BTLF', 1.0)
			call SetUnitScale(n, 1.2, 1.2, 1.2)
			call MyRemoveUnit(n, 2.7)
			set n=CreateUnit(p, 'd053', x1, y1, GetRandomInt(0, 360))
			call UnitApplyTimedLife(n,'BTLF', 1.0)
			call SetUnitScale(n, 1.2, 1.2, 1.2)
			call MyRemoveUnit(n, 2.7)
			set n=CreateUnit(p, 'd053', x1, y1, GetRandomInt(0, 360))
			call UnitApplyTimedLife(n,'BTLF', 1.0)
			call SetUnitScale(n, 1.2, 1.2, 1.2)
			call MyRemoveUnit(n, 2.7)
			if UnitIsAlive(c)then
				set mx=GetUnitState(c,UNIT_STATE_MAX_LIFE)
				set m=GetWidgetLife(c)
				if DFL==true then
					call myCustomDamage(u,c,((7*GetHeroStr(u,true)+100)*(1+(1-m/mx)))*1.1,false,false,null,null,null)
					call SetControlToUnit(u,c,2,"stun")
				else
					call myCustomDamage(u,c,(7*GetHeroStr(u,true)+100)*(1+(1-m/mx)),false,false,null,null,null)
					call SetControlToUnit(u,c,1,"stun")
				endif
				//call Push(c,30,a,600)
				call UnitAddAbility(c, 'Arav')
				call UnitRemoveAbility(c, 'Arav')
				call MissleMoveParabola(c,15,0,GetUnitX(c)+600*Cos(a),GetUnitY(c)+600*Sin(a),400,u)
			endif
			if GetUnitAbilityLevel(u,'LAE1')>0 then
				call SetUnitVertexColor(u,255,255,25,225)
			else
				call SetUnitVertexColor(u,255,255,255,255)
			endif
			call PauseTimer(t)
			call DestroyTimer(t)
			call SetUnitTimeScale(u,1)
			call SetUnitPathing(u,true)
			call PauseUnit(u,false)
			call FlushChildHashtable(h,id)
		endif
	endif
	set p=null
	set u=null
	set c=null
	set t=null
endfunction

function SecretRoaringThunderCast takes nothing returns nothing
        local unit u=GetTriggerUnit()
        local unit c=GetSpellTargetUnit()
        local timer t=CreateTimer()
        local integer id=GetHandleId(t)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        local player p=GetOwningPlayer(u)
        call SaveUnitHandle(h,id,0,u)
        call SetUnitPathing(u,false)
        call SetUnitAnimation(u,"spell two")
        call PauseUnit(u,true)
        set soundplay=SndN(1979) // Sound\Music\mp3Music\Metsuryu Ogi Narumikazuchi  Roaring Thunder.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        call RemoveEffect(AddSpecialEffectTarget("war3mapImported\\LaxusSpark.mdl", u, "hand right"), 2, true, CreateTimer())
        call RemoveEffect(AddSpecialEffectTarget("krk (1849).mdl", u, "hand right"), 1.5, true, CreateTimer())
        call RemoveEffect(AddSpecialEffectTarget("krk (1849).mdl", u, "hand left"), 1.5, true, CreateTimer())
        //call RemoveEffect(AddSpecialEffectTarget("AFB (1887).mdl", u, "origin"), 2, true, CreateTimer())
                set n=CreateUnit(p, 'd054', x, y, GetRandomInt(0, 360))
                call UnitApplyTimedLife(n,'BTLF', 0.5)
                call MyRemoveUnit(n, 1.7)
                        
        call DestroyEffect(AddSpecialEffectTarget("supershinythingy fire5.mdl", u, "hand right"))
        call SaveReal(h,id,9,Atan2(GetUnitY(c)-y,GetUnitX(c)-x))
        call UnitApplyTimedLife(CreateUnit(p,'e0QJ',x,y,GetRandomReal(0,359)),'BTLF',3)
        call UnitApplyTimedLife(CreateUnit(p,'e0QK',x,y,GetRandomReal(0,359)),'BTLF',0.5)
        call SetUnitInvulnerable(u,true)
        if GetHeroLevel(u)==35 and GetUnitAbilityLevel(u,'LAE1')>0 then
        call SaveBoolean(h,id,3,true)
        call SetUnitVertexColor(u,255,40,10,225)
        else
        call SaveBoolean(h,id,3,false)
        endif
        call SaveUnitHandle(h,id,1,c)
        call SaveReal(h,id,2,0)
        call TimerStart(t,0.025,true,function SecretRoaringThunderCast2)
        set c=null
        set u=null
        set t=null
        set p=null
endfunction

function ThunderSpearCond takes nothing returns boolean // Laxus F new
return GetSpellAbilityId()=='A0SH' and udg_B==true
endfunction

function LaxusF_Exhaustion2 takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local real time=LoadReal(HH, id, 2)
        if time <= 0 or GetUnitAbilityLevel(LoadUnitHandle(HH, id, 0), LoadInteger(HH, id, 1)) == 0 then
                call UnitRemoveAbility(LoadUnitHandle(HH, id, 0), LoadInteger(HH, id, 1))
                call UnitRemoveAbility(LoadUnitHandle(HH, id, 0), 'BP01')
                call FlushChildHashtable(HH, id)
                call DestroyTimer(t)
        else
                call SaveReal(HH, id, 2, time - 0.1)
        endif
        set t=null
endfunction

function LaxusF_Exhaustion takes unit u,integer id,real time returns nothing
        local timer t=CreateTimer()
        local integer idt=GetHandleId(t)
        call SaveInteger(HH, idt, 1, id)
        call SaveUnitHandle(HH, idt, 0, u)
        call SaveReal(HH, idt, 2, time)
        call TimerStart(t, 0.1, true, function LaxusF_Exhaustion2)
        set t=null
endfunction

function ThunderSpearCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local unit c=LoadUnitHandle(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local real f=GetUnitFacing(u)
local real speed=LoadReal(h,id,5)
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>speed+30 then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SaveReal(h,id,5,speed+0.8)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call UnitApplyTimedLife(CreateUnit(p,'e0QN',x,y,a*bj_RADTODEG),'BTLF',1)
else
call UnitApplyTimedLife(CreateUnit(p,'e0QI',x1,y1,GetRandomReal(0,359)),'BTLF',0.01)
call UnitApplyTimedLife(CreateUnit(p,'e0QG',x1,y1,GetRandomReal(0,359)),'BTLF',0.01)
call UnitApplyTimedLife(CreateUnit(p,'e0QK',x1,y1,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0QH',x1,y1,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0AX',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0AW',x1,y1,GetRandomReal(0,359)),'BTLF',0.01)
call UnitApplyTimedLife(CreateUnit(p,'e0B1',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0B4',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0AZ',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0B3',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0C7',x1,y1,GetRandomReal(0,359)),'BTLF',6)
set n=CreateUnit(p, 'd051', x1, y1, GetRandomInt(0, 360))
call SetUnitFlyHeight(n, 150, 0)
call SetUnitScale(n, 3.5, 3.5, 3.5)
call MyRemoveUnit(n, 1.7)
set n=CreateUnit(p, 'd054', x1, y1, GetRandomInt(0, 360))
call UnitApplyTimedLife(n,'BTLF', 1.2)
call MyRemoveUnit(n, 2.7)
set n=CreateUnit(p, 'd053', x1, y1, GetRandomInt(0, 360))
call UnitApplyTimedLife(n,'BTLF', 1.0)
call SetUnitScale(n, 1.2, 1.2, 1.2)
call MyRemoveUnit(n, 2.7)
set n=CreateUnit(p, 'd053', x1, y1, GetRandomInt(0, 360))
call UnitApplyTimedLife(n,'BTLF', 1.0)
call SetUnitScale(n, 1.2, 1.2, 1.2)
call MyRemoveUnit(n, 2.7)
set n=CreateUnit(p, 'd053', x1, y1, GetRandomInt(0, 360))
call UnitApplyTimedLife(n,'BTLF', 1.0)
call SetUnitScale(n, 1.2, 1.2, 1.2)
call MyRemoveUnit(n, 2.7)
if GetWidgetLife(c)>=(GetUnitState(c,UNIT_STATE_MAX_LIFE)*0.20) then
    call CustomTrueDamage(u, c, GetUnitState(u, UNIT_STATE_MAX_LIFE)*0.20)
	call ShakeCamera(0.2, 10)
	call RemoveEffect(AddSpecialEffectTarget("krk (1849).mdl", c, "chest"), 1.5, true, CreateTimer())
else
	call ShakeCamera(0.2, 15)
	call SetUnitInvulnerable(c, false)
    call RemoveEffect(AddSpecialEffectTarget("krk (1849).mdl", c, "chest"), 1.5, true, CreateTimer())
    call CustomTrueDamage(u, c, GetUnitState(u, UNIT_STATE_MAX_LIFE)*0.20)
endif
call RemoveUnit(LoadUnitHandle(HH, GetHandleId(u), SH_LaxusD_Bool))
call UnitRemoveAbility(u, 'LAE1')
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
endif
set p=null
set u=null
set l__d=null
set t=null
set c=null
endfunction
function ThunderSpearCast takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real f=GetUnitFacing(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y1,x1-x)
call UnitAddAbility(u, 'AP01')
call UnitMakeAbilityPermanent(u, true, 'AP01')
call LaxusF_Exhaustion(u, 'AP01', 10.0)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,5,37)
set n=CreateUnit(GetOwningPlayer(u),'e0QM',x+50.*Cos(a),y+50.*Cos(a),a*bj_RADTODEG)
call SetUnitTimeScale(n,2)
call SaveUnitHandle(h,id,1,n)
set n=CreateUnit(GetOwningPlayer(u), 'd054', x, y, GetRandomInt(0, 360))
call UnitApplyTimedLife(n,'BTLF', 0.7)
call MyRemoveUnit(n, 1.7)
set n=CreateUnit(GetOwningPlayer(u), 'd053', x, y, GetRandomInt(0, 360))
call UnitApplyTimedLife(n,'BTLF', 0.5)
call SetUnitScale(n, 1.2, 1.2, 1.2)
call MyRemoveUnit(n, 1.7)
call SaveUnitHandle(h,id,2,c)
set soundplay=SndN(1981) // Sound\Music\mp3Music\LaxusLightningThunderSpear.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.025,true,function ThunderSpearCast2)
set u=null
set c=null
set t=null
endfunction
function DragonForceCond takes nothing returns boolean
return GetSpellAbilityId()=='A0S1'
endfunction

function DragonForceCast2 takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(h,id,0)
        local unit dummy=LoadUnitHandle(HH, GetHandleId(u), SH_LaxusD_Bool)
        call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e0QO',GetUnitX(u),GetUnitY(u),GetRandomReal(0,359)),'BTLF',0.4)
        if GetUnitAbilityLevel(u,'LAE1')==0 or dummy==null or udg_B==false or DU2==false then
                call RemoveUnit(dummy)
                call RemoveSavedHandle(HH, GetHandleId(u), SH_LaxusD_Bool)
                call FlushChildHashtable(h,id)
                call SetUnitVertexColor(u,255,255,255,255)
                call SetUnitScale(u,1,1,1)
                call PauseTimer(t)
                call DestroyTimer(t)
                call UnitRemoveAbility(u,'LAE1')
                call UnitRemoveAbility(u,'A0S2')
                call UnitRemoveAbility(u,'A0S3')
                call UnitRemoveAbility(u,'A0S4')
                call UnitRemoveAbility(u,'A0S5')
                call UnitRemoveAbility(u,'A0S6')
                call UnitRemoveAbility(u,'A0S7')
        endif
        set t=null
        set u=null
    set dummy=null
endfunction
function DragonForceCast takes nothing returns nothing // Laxus_D
        local unit u=GetTriggerUnit()
        local timer t=CreateTimer()
        local integer id=GetHandleId(t)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        local integer lvl=GetUnitAbilityLevel(u,'A0S1')
        local player p=GetOwningPlayer(u)
        call SetUnitVertexColor(u,255,255,25,235)
        call UnitApplyTimedLife(CreateUnit(p,'e0QJ',x,y,GetRandomReal(0,359)),'BTLF',3)
        call UnitApplyTimedLife(CreateUnit(p,'e0QK',x,y,GetRandomReal(0,359)),'BTLF',0.5)
        set n=CreateUnit(p, 'd051', x, y, GetRandomInt(0, 360))
        call SetUnitScale(n, 3, 3, 3)
        call MyRemoveUnit(n, 1.7)
        set n=CreateUnit(p, 'd054', x, y, GetRandomInt(0, 360))
        call UnitApplyTimedLife(n,'BTLF', 0.6)
        call MyRemoveUnit(n, 1.7)
        call RemoveEffect(AddSpecialEffectTarget("krk (1849).mdl", u, "hand right"), 1.5, true, CreateTimer())
        call RemoveEffect(AddSpecialEffectTarget("krk (1849).mdl", u, "hand left"), 1.5, true, CreateTimer())
        call SaveUnitHandle(h,id,0,u)
        call UnitAddAbility(u,'A0S2')
        call UnitAddAbility(u,'LAE1')
        call UnitRemoveAbilityTimed_ExD(u,'LAE1',30)
        call SetUnitAbilityLevel(u,'LAE1',lvl+1)
        if lvl==1 then
                call UnitAddAbility(u,'A0S3')
        elseif lvl==2 then
                call UnitAddAbility(u,'A0S4')
        elseif lvl==3 then
                call UnitAddAbility(u,'A0S5')
        elseif lvl==4 then
                call UnitAddAbility(u,'A0S6')
        elseif lvl==5 then
                call UnitAddAbility(u,'A0S7')
        endif
        set soundplay=SndN(1983) // Sound\Music\mp3Music\LaxusDragonForce.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        call RemoveUnit(LoadUnitHandle(HH, GetHandleId(u), SH_LaxusD_Bool))
        call SaveUnitHandle(HH, GetHandleId(u), SH_LaxusD_Bool, CreateUnit(p, 'dM83', 0, 0, 0))
    call CreateModeIndicatorFormLaxus(u, "war3mapImported\\BTNDragonForce.blp", 30)
        call UnitScale(u,1,1.1,2)
        call TimerStart(t,0.08,true,function DragonForceCast2)
        set u=null
        set p=null
        set t=null
endfunction
function LightningBulletsMovePoint2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
local player p=GetOwningPlayer(l__d)
local integer idu=GetPlayerId(p)
local real dmg=LoadReal(h,id,5)
if SR(x,y,x1,y1)>speed+30 then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SaveReal(h,id,1,speed+1)
else
call GroupEnumUnitsInRange(G,x1,y1,250,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(Hero[idu],E,dmg,false,false,null,null,null)
call SlowUnit(Hero[idu],E,0.5,0,4,0,false)
endif
call GroupRemoveUnit(G,E)
endloop
call UnitApplyTimedLife(CreateUnit(p,'e0LG',x1,y1,GetRandomReal(0,359)),'BHwe',3)
call UnitApplyTimedLife(CreateUnit(p,'e0QJ',x1,y1,GetRandomReal(0,359)),'BHwe',3)
call UnitApplyTimedLife(CreateUnit(p,'e0LF',x1,y1,GetRandomReal(0,359)),'BHwe',3)
set n=CreateUnit(p,'d054',x1,y1,GetRandomReal(0,359))
call SetUnitScale(n, 0.6, 0.6, 0.6)
call SetUnitFlyHeight(n, 25, 0)
call UnitApplyTimedLife(n,'BHwe',0.3)
call MyRemoveUnit(n, 1.5)
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set l__d=null
set t=null
endfunction
function LightningBulletsMovePoint takes unit l__d,real speed,real angle,real x,real y,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,dmg)
call TimerStart(t,0.03,true,function LightningBulletsMovePoint2)
set t=null
endfunction
function LightningBulletsCond takes nothing returns boolean
return GetSpellAbilityId()=='A0S0'
endfunction
function LightningBulletsCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real time=LoadReal(h,id,8)
local real dmg=(0.7+0.1*GetUnitAbilityLevel(u,'A0S0'))*GetHeroStr(u,true)
if time<0.51 then
call SaveReal(h,id,8,time+0.07)
set n=CreateUnit(p,'e0QL',x,y,a*bj_RADTODEG)
call LightningBulletsMovePoint(n,55,0,x1+GetRandomReal(-225,225),y1+GetRandomReal(-225,225),dmg)
else
call PauseUnit(u,false)
//call SetUnitInvulnerable(u, false)
call SetUnitTimeScale(u,1)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set t=null
endfunction
function LightningBulletsCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,GetSpellTargetX())
call SaveReal(h,id,3,GetSpellTargetY())
call SaveReal(h,id,8,0)
call PauseUnit(u,true)
//call SetUnitInvulnerable(u, true)
set soundplay=SndN(1985) // Sound\Music\mp3Music\LaxusLightningOrbs.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
