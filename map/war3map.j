local real y1=GetUnitY(c)
local real x2=0
local real y2=0
local real a=Atan2(y1-y,x1-x)
local real a2=0
local real time=LoadReal(h,id,6)
local real a3=360/15*time*10*bj_DEGTORAD
local player p=GetOwningPlayer(u)
if time<1 then
call PauseUnit(u,true)
call UnitApplyTimedLife(CreateUnit(p,'e0KV',x1+300*Cos(a3),y1+300*Sin(a3),GetRandomReal(0,359)),'BTLF',0.5)
call SaveReal(h,id,6,time+0.1)
