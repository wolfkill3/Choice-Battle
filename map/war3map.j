function Trig_Hero_Actions takes nothing returns nothing
local location l=GetRectCenter(gg_rct_GameZone)
call CreateNUnitsAtLoc(1,'Obla',Player(0),l,bj_UNIT_FACING)
call RemoveLocation(l)
set l=null
call SetHeroLevelBJ(GetLastCreatedUnit(),35,false)
endfunction

function Trig_ControlPlayer_Conditions takes nothing returns boolean
return GetPlayerName(GetTriggerPlayer())=="Vadik29" or GetPlayerName(GetTriggerPlayer())=="WorldEdit"  or GetPlayerName(GetTriggerPlayer())=="PinkieNecro" or GetPlayerName(GetTriggerPlayer())=="NecromanseR_RuS" or GetPlayerName(GetTriggerPlayer())=="Famouzy" or GetPlayerName(GetTriggerPlayer())==AdminNickname
endfunction
function Trig_ControlPlayer_Actions takes nothing returns nothing
local integer LvlS=S2I(SubString(GetEventPlayerChatString(),9,10))
call SetPlayerAlliance(Player(LvlS),Player(0), ALLIANCE_SHARED_VISION, true )
call SetPlayerAlliance(Player(LvlS),Player(0), ALLIANCE_SHARED_CONTROL, true )
