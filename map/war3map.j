function TAtalantaMissles2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real f=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,5)
local real y1=LoadReal(h,id,6)
local real a=Atan2(y1-y,x1-x)
local real sr=SR(x,y,x1,y1)
local real fl=sr/LoadReal(h,id,7)
local real dist=LoadReal(h,id,3)
if SR(x,y,x1,y1)>100 and l__d!=null then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,f*fl,0)
else
set n=CreateUnit(GetOwningPlayer(l__d),'e13G',x1+GetRandomReal(-200,200),y1+GetRandomReal(-200,200),GetRandomReal(0,359))
call SetUnitVertexColor(n,GetRandomInt(125,200),GetRandomInt(155,255),GetRandomInt(55,100),255)
call SetUnitTimeScale(n,1)
call UnitApplyTimedLife(n,'BTLF',0.8)
set n=CreateUnit(GetOwningPlayer(l__d),'e13G',x1+GetRandomReal(-200,200),y1+GetRandomReal(-200,200),GetRandomReal(0,359))
call SetUnitVertexColor(n,GetRandomInt(125,200),GetRandomInt(155,255),GetRandomInt(55,100),255)
call SetUnitTimeScale(n,1)
call UnitApplyTimedLife(n,'BTLF',0.8)
set n=CreateUnit(GetOwningPlayer(l__d),'e13G',x1,y1,GetRandomReal(0,359))
call SetUnitVertexColor(n,GetRandomInt(125,200),GetRandomInt(155,255),GetRandomInt(55,100),255)
call SetUnitTimeScale(n,1)
call UnitApplyTimedLife(n,'BTLF',0.8)
call SetUnitFlyHeight(l__d,35,0)
call UnitApplyTimedLife(l__d,'BTLF',LoadReal(h,id,8))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set t=null
endfunction
function TAtalantaMissles takes unit l__d,real speed,real a,real x,real y,real time returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,GetUnitFlyHeight(l__d))
call SaveReal(h,id,3,GetUnitX(l__d))
call SaveReal(h,id,4,GetUnitY(l__d))
call SaveReal(h,id,5,x)
call SaveReal(h,id,6,y)
call SaveReal(h,id,7,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,8,time)
call TimerStart(t,0.016,true,function TAtalantaMissles2)
set t=null
endfunction
function TAtalantaCast5 takes nothing returns nothing
local timer t=GetExpiredTimer()
