call SaveReal(HH, GetHandleId(LoadFrameHandle(HH, idp,SH_ReplaceableTextures_CommandButtons_BTNMadaraR_blp)), c_DURATION, LoadReal(HH,GetHandleId(caster0),SH_MadaraSusDur))
call RemoveUnit(LoadUnitHandle(HH,GetHandleId(caster0),SH_MadaraSusano))
endif
call SetFrameTexture( LoadFrameHandle(HH, idp,SH_ReplaceableTextures_CommandButtons_BTNMadaraR_blp), "ReplaceableTextures\\CommandButtons\\BTNMadaraT1.blp", 0, true )
call SetFrameTexture( LoadFrameHandle(HH, idp,SH_ReplaceableTextures_CommandButtons_BTNMadaraR_blp), "ReplaceableTextures\\CommandButtons\\BTNMadaraT1.blp", 1, true )
call SetFrameTexture( LoadFrameHandle(HH, idp,SH_ReplaceableTextures_CommandButtons_BTNMadaraR_blp), "ReplaceableTextures\\CommandButtons\\BTNMadaraT1.blp", 2, true )
call SetUnitState(caster0,UNIT_STATE_MANA,GetUnitState(caster0,UNIT_STATE_MANA)-GetUnitState(caster0,UNIT_STATE_MAX_MANA)*0.1)
