call SaveReal(h,id,6,y1)
call SaveReal(h,id,4,(GetUnitAbilityLevel(u,'A132')+2)*GetHeroAgi(u,true))
call SaveReal(h,id,2,0)
call SaveReal(h,id,10,1.25)
call SaveReal(h,id,11,a)
call SaveReal(h,id,12,0)
call SetUnitAnimation(u,"Spell Throw Two")
