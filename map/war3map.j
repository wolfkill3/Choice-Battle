call UnitApplyTimedLife(n,1,0.7)
call SetUnitTimeScale(n,0.7)
set n=CreateUnit(p,'e0NC',x1,y1,a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,0.7)
set n=CreateUnit(p,'e0NE',x1,y1,a*bj_RADTODEG)
