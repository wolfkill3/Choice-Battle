function FrozenCond takes nothing returns boolean
return GetSpellAbilityId()=='A118' and udg_B==true and GetUnitTypeId(GetTriggerUnit())!='H007'  and GetUnitAbilityLevel(GetTriggerUnit(),'GIE1')==0 and GetUnitTypeId(GetTriggerUnit())!='Ho13' and GetUnitTypeId(GetTriggerUnit())!='H34X'
endfunction
function FrozenCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit c=LoadUnitHandle(h,id,1)
local unit u=LoadUnitHandle(h,id,2)
local real life=LoadReal(h,id,0)
local real time=LoadReal(h,id,4)
local real time2=LoadReal(h,id,5)
local real life2=GetWidgetLife(u)
local real dmg=0
local lightning l=LoadLightningHandle(h,id,3)
if time>0 and GetWidgetLife(u)>0 and udg_B==true and DU2==true and LoadInteger(HH,GetHandleId(u),StringHash("cold"))!=1 then
if IsUnitPaused(u)==false and IsUnitHidden(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
call SaveReal(h,id,4,time-0.01)
call SaveReal(h,id,5,time2+0.01)
endif
call UnitAddAbility(u,'A114')
if life2>life then
set dmg=life2-life
if dmg<life2 then
call SetUnitState(u,UNIT_STATE_LIFE,life2-dmg)
else
call SetUnitState(u,UNIT_STATE_LIFE,50)
endif
endif
if time2>0.25 then
call myCustomDamage(c,u,GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.0025,false,false,null,null,null)
call SaveReal(h,id,5,0)
endif
call SaveReal(h,id,0,GetWidgetLife(u))
else
call UnitRemoveAbility(u,'A114')
call SaveInteger(HH,GetHandleId(u),StringHash("cold"),0)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set c=null
set l=null
set t=null
set u=null
endfunction
function FrozenCast takes nothing returns nothing
local unit c=GetSpellTargetUnit()
local unit u=GetTriggerUnit()
local timer t
local integer id
if GetUnitAbilityLevel(c,'A15H')==0 then
    set t=CreateTimer()
    set id=GetHandleId(t)
    call SaveReal(h,id,0,GetWidgetLife(c))
    call SaveReal(h,id,4,10)
    call SaveReal(h,id,5,0)
    call UnitAddAbility(c,'A114')
    call UnitMakeAbilityPermanent(c,true,'A114')
    call SaveUnitHandle(h,id,2,c)
    call SaveUnitHandle(h,id,1,u)
    call SaveInteger(HH,GetHandleId(u),StringHash("cold"),0)
    call TimerStart(t,0.01,true,function FrozenCast2)
else
    call DisplayTimedWarningMessage(GetOwningPlayer(u),10,"Нельзя использовать на врага под эффектом Imagine Breaker.")
    call IssueImmediateOrder(u,"stop")
endif
set t=null
set u=null
set c=null
endfunction
function InitTrig_Frozen takes nothing returns nothing
set gg_trg_Frozen=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Frozen,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_Frozen,Condition(function FrozenCond))
call TriggerAddAction(gg_trg_Frozen,function FrozenCast)
endfunction
function FrozenManaCond takes nothing returns boolean
return GetSpellAbilityId()=='A15E' and udg_B==true and GetUnitTypeId(GetTriggerUnit())!='H007'
endfunction
function FrozenManaCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,1)
local real life=LoadReal(h,id,0)
local real time=LoadReal(h,id,4)
local real time2=LoadReal(h,id,5)
local real life2=GetWidgetMana(u)
local real dmg=0
local lightning l=LoadLightningHandle(h,id,3)
if time>0 and GetUnitAbilityLevel(u,'A15F')>0 and GetWidgetLife(u)>0 and udg_B==true and LoadInteger(HH,GetHandleId(u),StringHash("cold2"))!=1 then
call SaveReal(h,id,4,time-0.01)
call SaveReal(h,id,5,time2+0.01)
call UnitAddAbility(u,'A15F')
if GetUnitAbilityLevel(u,'A25F')>0 then
call SaveReal(h,id,4,0)
endif
if life2<life then
call SetUnitState(u,UNIT_STATE_MANA,life)
endif
call SaveReal(h,id,0,GetWidgetMana(u))
else
call UnitRemoveAbility(u,'A15F')
call SaveInteger(HH,GetHandleId(u),StringHash("cold2"),0)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l=null
set t=null
set u=null
endfunction
function FrozenManaCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveReal(h,id,4,5)
call SaveReal(h,id,5,0)
call UnitAddAbility(c,'A15F')
call SaveUnitHandle(h,id,1,c)
call SaveInteger(HH,GetHandleId(c),StringHash("cold2"),0)
call HealTextTag(u,c,GetUnitState(c,UNIT_STATE_MAX_MANA)*0.2*myCustomMana2(c,1),"ManaRes")
call SetUnitState(c,UNIT_STATE_MANA,GetWidgetMana(c)+GetUnitState(c,UNIT_STATE_MAX_MANA)*0.2)
call SaveReal(h,id,0,GetWidgetMana(c))
call TimerStart(t,0.01,true,function FrozenManaCast2)
set t=null
set c=null
set u=null
endfunction
function Trig_Three_Attack_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A06J' and udg_B==true and GetUnitTypeId(GetTriggerUnit())!='H007'  and GetUnitAbilityLevel(GetTriggerUnit(),'GIE1')==0 and GetUnitTypeId(GetTriggerUnit())!='H04U'
endfunction
function Trig_Three_Attack_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local integer i=LoadInteger(h,id,2)
local real f=GetUnitFacing(u)*bj_DEGTORAD
if i<1 and UnitIsAlive(c)and UnitIsAlive(u)and IsUnitPaused(u)==false then
call SetUnitX(u,x1+100*Cos(f))
call SetUnitY(u,y1+100*Sin(f))
call UnitAttackRestart(u) 
call SetUnitFacingInstant(u,AU(u,c)*bj_RADTODEG)
call IssueTargetOrder(u,"attack",c)
call SaveInteger(h,id,2,i+1)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",c,"chest"))
call DestroyEffect(AddSpecialEffect("war3mapImported\\Slam.mdl",x,y))
else
call UnitRemoveAbilityTimed(u,'A06K',0.4)
if GetUnitTypeId(u)!='H04B' then
call SetUnitVertexColor(u,255,255,255,255)
endif
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set c=null
set t=null
endfunction
function Trig_Three_Attack_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
if GetHeroLevel(u)<6 then
call DisplayTimedWarningMessage(GetOwningPlayer(u),10,"Уровень героя ниже необходимого.")
call UnitForceStopOrder(u,false)
call DestroyTimer(t)
else
call UnitAddAbility(u,'A06K')
if GetUnitTypeId(u)!='H04B' then
call SetUnitVertexColor(u,255,255,255,100)
endif
if GetUnitAbilityLevel(u,'A1FU')>0 then
call UnitRemoveAbility(u,'A1FU')
call UnitRemoveAbility(u,'Pet1')
endif
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SetUnitFacingInstant(u,AU(u,c)*bj_RADTODEG)
call TimerStart(t,0.01,true,function Trig_Three_Attack_Actions2)
endif
set u=null
set t=null
set c=null
endfunction
function InitTrig_Three_Attack takes nothing returns nothing
