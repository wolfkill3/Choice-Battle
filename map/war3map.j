function QShikiTwoAlterCond takes nothing returns boolean
    return GetSpellAbilityId()=='A1BQ' and GetUnitAbilityLevel(GetTriggerUnit(),'A23Z')>0
endfunction
function QShikiTwoAlterCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(HH,id,0)
    local unit c=LoadUnitHandle(HH,id,1)
    local integer idu=GetHandleId(u)
    local real x=GetUnitX(c)
    local real y=GetUnitY(c)
    local real x1=0
    local real y1=0
    local real a=LoadReal(HH,idu,SH_ANQ)
    local real dist=LoadReal(HH,idu,SH_DIQ)
    local integer fe=LoadInteger(HH,id,4)
    local real sc=0
    local player p=GetOwningPlayer(u)
    if dist<700 and GetUnitAbilityLevel(c,'A1BL')==0 then
    if GetUnitAbilityLevel(c,'A1BJ')==0 then
        if IsTerrainPathable(GetUnitX(c),GetUnitY(c),PATHING_TYPE_FLYABILITY)==false  then
            set x=x+11*Cos(a)
            set y=y+11*Sin(a)
            call SetUnitX(c,x)
            call SetUnitY(c,y)
        endif
    if GetUnitFlyHeight(c)<401 then
    call SetUnitFlyHeight(c,ParabolaZ(400,700,700-dist),0)
    else
    call SetUnitFlyHeight(c,ParabolaZ(shikihe,700,700-dist),0)
    endif
    call SaveReal(HH,idu,SH_DIQ,dist+8)
    endif
    if dist>110 and fe==0 then
    call SaveInteger(HH,id,4,1)
    call PauseUnit(u,false)
    endif
    else
    call PauseUnit(c,false)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
    if GetUnitAbilityLevel(u,'A1BK')==0 and GetUnitAbilityLevel(c,'A1BL')==0 then
    call SetUnitFlyHeight(c,0,0)
    call UnitRemoveAbility(u,'A1BI')
    endif
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(HH,id)
    endif
    set c=null
    set u=null
    set p=null
    set t=null
endfunction
function QShikiTwoAlterCast takes nothing returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local unit u=GetTriggerUnit()
    local unit c=null
    local player p=GetOwningPlayer(u)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local integer idu=GetHandleId(u)
    local integer idp=GetHandleId(p)
    local real dmg=((GetHeroAgi(u,true)*(0.75+0.25*GetUnitAbilityLevel(u,'A1BQ')))+20)*(1-LoadInteger(HH,idu,ComboCounterHash)*0.045)
    local real x1=0
    local real y1=0
    local real sc=0
    local real a=GetUnitFacing(u)*bj_DEGTORAD
    local group g=CreateGroup()
    set x1=x+100*Cos(a)
    set y1=y+100*Sin(a)
    call SetUnitAnimation(u,"spell slam six")
    call GroupEnumUnitsInRange(g,x1,y1,170,Base)
    loop
        set E=FirstOfGroup(g)
        exitwhen E==null
        if Condition_Base(p,E)then
            if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
                call SaveUnitHandle(HH,id,1,E)
                set c=E
                if dmg>((GetHeroAgi(u,true)*(0.75+0.25*GetUnitAbilityLevel(u,'A1BQ')))+20)*0.1 then
                    call myCustomDamage(u,E,dmg,false,false,null,null,null)
                else
                    call myCustomDamage(u,E,((GetHeroAgi(u,true)*(0.75+0.25*GetUnitAbilityLevel(u,'A1BQ')))+20)*0.1,false,false,null,null,null)
                endif
                call UnitAddAbility(E,'Arav')
                call UnitRemoveAbility(E,'Arav')
                call PauseUnit(E,true)
                call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,true)
                call GroupClear(g)
            else
                call SaveReal(HH,idu,ComboTimerHash,0)
                call SaveInteger(HH,idu,ComboCounterHash,0)
                call SetUnitTimeScale(LoadUnitHandle(HH,idp,ComboBarHash),-10000000)
                call SetPlayerAbilityAvailable(p,'A1BP',true)
                call SetPlayerAbilityAvailable(p,'A1BQ',false)
                call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,u)
                call SetUnitInvulnerable(u,false)
                call PauseUnit(u,false)
                call PauseTimer(t)
                call DestroyTimer(t)
                call FlushChildHashtable(HH,id)
                call GroupClear(g)
            endif
        endif
        call GroupRemoveUnit(g,E)
    endloop
    set n=CreateUnit(p,'e116',x1,y1,GetRandomReal(0,359))
    call SetUnitVertexColor(n,255,255,255,GetRandomInt(50,255))
    set sc=GetRandomReal(0.5,3)
    call SetUnitScale(n,sc,sc,sc)
    call UnitApplyTimedLife(n,'BTLF',0.7)
    call SetUnitTimeScale(n,2.5)
    set n=CreateUnit(p,'e116',x1,y1,GetRandomReal(0,359))
    call SetUnitVertexColor(n,255,255,255,GetRandomInt(50,255))
    set sc=GetRandomReal(0.5,3)
    call SetUnitScale(n,sc,sc,sc)
    call UnitApplyTimedLife(n,'BTLF',0.7)
    call SetUnitTimeScale(n,2.5)
    set n=CreateUnit(p,'e116',x1,y1,GetRandomReal(0,359))
    call SetUnitVertexColor(n,255,255,255,GetRandomInt(50,255))
    set sc=GetRandomReal(0.5,3)
    call SetUnitScale(n,sc,sc,sc)
    call UnitApplyTimedLife(n,'BTLF',0.7)
    call SetUnitTimeScale(n,2.5)
    set n=CreateUnit(p,'e116',x1,y1,GetRandomReal(0,359))
    call SetUnitVertexColor(n,255,255,255,GetRandomInt(50,255))
    set sc=GetRandomReal(0.5,3)
    call SetUnitScale(n,sc,sc,sc)
    call UnitApplyTimedLife(n,'BTLF',0.7)
    call SetUnitTimeScale(n,2.5)
    set n=CreateUnit(p,'e11H',x,y,a*bj_RADTODEG)
    call SetUnitVertexColor(n,255,255,255,155)
    call UnitApplyTimedLife(n,'BTLF',0.4)
    call SetUnitTimeScale(n,2)
    set n=CreateUnit(p,'e153',x,y,a*bj_RADTODEG-30)
    call SetUnitVertexColor(n,255,255,255,155)
    call UnitApplyTimedLife(n,'BTLF',0.4)
    call SetUnitTimeScale(n,3)
    set n=CreateUnit(p,'e153',x,y,a*bj_RADTODEG+30)
    call SetUnitVertexColor(n,255,255,255,155)
    call UnitApplyTimedLife(n,'BTLF',0.4)
    call SetUnitTimeScale(n,3)
    set n=CreateUnit(p,'e153',x,y,a*bj_RADTODEG)
    call SetUnitVertexColor(n,255,255,255,155)
    call UnitApplyTimedLife(n,'BTLF',0.4)
    call SetUnitTimeScale(n,3)
    call ShakeCamera(0.25,15)
    if c!=null then
        call UnitAddAbility(u,'A2CM')
        call SaveUnitHandle(HH,id,0,u)
        call SaveReal(HH,idu,SH_DIQ,0)
        call SaveReal(HH,id,4,0)
        call SaveReal(HH,idu,SH_ANQ,a)
        call SaveUnitHandle(HH,idu,SH_SKQ,c)
        call TimerStart(t,0.01,true,function QShikiTwoAlterCast2)
        call PauseUnit(u,true)
        call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1BQ',false)
        call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1BR',true)
        call RemoveSaveHashTimedShiki(1.25,idu,SH_SKQ,u)
        if LoadInteger(HH,idu,ComboCounterHash)>5 and LoadInteger(HH,idu,ComboCounterHash)<8 then
            call SetUnitColor(LoadUnitHandle(HH,idp,ComboBarHash),PLAYER_COLOR_PURPLE)
        elseif LoadInteger(HH,idu,ComboCounterHash)>7 then
            call SetUnitColor(LoadUnitHandle(HH,idp,ComboBarHash),PLAYER_COLOR_RED)
            if LoadUnitHandle(HH,idu,SH_CST)==null then
                call SaveUnitHandle(HH,idu,SH_CST,CreateUnit(p,'h06A',x,y,0))
            endif
        endif
        call SetControlToUnit(u,c,0.5, "stun")
        call SetUnitTimeScale(LoadUnitHandle(HH,idp,ComboBarHash),10000000)
        call ComboBar(u,-0.5)
        call SetUnitAnimation(u,"Spell six")
        set soundplay=SndN(2604) // Sound\Music\mp3Music\NanayaHit.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        set soundplay=SndN(2607) // Sound\Music\mp3Music\NanayaDogora.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        call SetWidgetMana(u, GetWidgetMana(u)-GetWidgetMaxMana(u)*LoadInteger(HH,idu,ComboCounterHash)*0.005)
        call UnitAddAbility(u,'A1BI')
        call SaveReal(HH,idu,ComboTimerHash,2)
        call SaveInteger(HH,idu,ComboCounterHash,LoadInteger(HH,idu,ComboCounterHash)+1)
        if LoadInteger(HH,idu,ComboCounterHash)>1 and LoadInteger(HH,idu,ComboCounterHash)<5 then
            call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1BU',false)
            call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A23W',true)
            call RemoveSaveHashTimedShikiE(0.04,idu,SH_SKE,u)
        elseif LoadInteger(HH,idu,ComboCounterHash)>5 and GetUnitAbilityLevel(u,'A1BN')==0 then
            call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1BU',false)
            call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1BV',true)
        endif
        if LoadInteger(HH,idu,ComboCounterHash)>2 then
            call SetAbilityIntegerLevelField(GetUnitAbility(u,'A1BZ'), ABILITY_ILF_TARGET_TYPE,0,1)
            call SetAbilityRealLevelField(GetUnitAbility(u,'A1BZ'), ABILITY_RLF_CAST_RANGE,0,1400)
        endif
    else
        call SaveReal(HH,idu,ComboTimerHash,0)
        call SaveInteger(HH,idu,ComboCounterHash,0)
        call SetUnitTimeScale(LoadUnitHandle(HH,idp,ComboBarHash),-10000000)
        call SetPlayerAbilityAvailable(p,'A1BP',true)
        call SetPlayerAbilityAvailable(p,'A1BQ',false)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(HH,id)
    endif
    set c=null
    set g=null
    set u=null
    set p=null
    set t=null
endfunction
function InitTrig_QShikiTwoAlter takes nothing returns nothing
    set gg_trg_QShikiTwoAlter=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_QShikiTwoAlter,EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_QShikiTwoAlter,Condition(function QShikiTwoAlterCond))
    call TriggerAddAction(gg_trg_QShikiTwoAlter,function QShikiTwoAlterCast)
endfunction
function QShikiThreeCond takes nothing returns boolean
return GetSpellAbilityId()=='A1BR'
endfunction
function QShikiThreeCast5 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit c=LoadUnitHandle(HH,id,1)
local integer idu=GetHandleId(u)
local real x=GetUnitX(c)
local real y=GetUnitY(c)
local real x1=0
local real y1=0
local real a=LoadReal(HH,idu,SH_ANQ)
local real dist=LoadReal(HH,id,2)
local integer fe=LoadInteger(HH,id,4)
local real he=LoadReal(HH,id,7)*((750-dist)/770)
local real sc=0
local player p=GetOwningPlayer(u)
local integer idp=GetHandleId(p)
if dist<950 then
    if IsTerrainPathable(GetUnitX(c),GetUnitY(c),PATHING_TYPE_FLYABILITY)==false  then
        set x=x+60*Cos(a)
        set y=y+60*Sin(a)
        call SetUnitX(c,x)
        call SetUnitY(c,y)
    endif
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
//call SetUnitInvulnerable(c,c, true)
call SetUnitFlyHeight(c,he,0)
call SaveReal(HH,id,2,dist+60)
if dist>70 and fe==0 then
call SetUnitFlyHeight(u,0,0)
call SaveInteger(HH,id,4,1)
endif
else
call ShakeCamera(0.25,15)
call RemoveSavedHandle(HH,idu,SH_Q3)
call RemoveSavedHandle(HH,idp,SH_EW)
call DestroyEffect(AddSpecialEffect("war3mapImported\\WarStompCaster.mdx",x,y))
call DestroyEffect(AddSpecialEffect("war3mapImported\\SandPoff.mdx",x,y))
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
//call SetUnitInvulnerable(c,c, false)
if ((GetHeroAgi(u,true)*(1+0.6*GetUnitAbilityLevel(u,'A1BR')))+20)*(1-LoadInteger(HH,idu,ComboCounterHash)*0.045)>((GetHeroAgi(u,true)*(1+0.6*GetUnitAbilityLevel(u,'A1BR')))+20)*0.1 then
call myCustomDamage(u,c,((GetHeroAgi(u,true)*(1+0.6*GetUnitAbilityLevel(u,'A1BR')))+20)*(1-LoadInteger(HH,idu,ComboCounterHash)*0.045),false,false,null,null,null)
else
call myCustomDamage(u,E,((GetHeroAgi(u,true)*(1+0.6*GetUnitAbilityLevel(u,'A1BR')))+20)*0.1,false,false,null,null,null)
endif
call SetControlToUnit(u,c,0.5, "stun")
call UnitRemoveAbility(c,'A1BJ')
call UnitRemoveAbility(u,'A1BK')
call SetUnitFlyHeight(c,0,0)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set c=null
set u=null
set p=null
set t=null
endfunction
