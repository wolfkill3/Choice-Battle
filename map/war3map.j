    call UnitApplyTimedLife(n,'BTLF',1)
    call SetUnitAnimation(n,"Birth")
    set x2=x1+rg*Cos(a+90*bj_DEGTORAD)
    set y2=y1+rg*Sin(a+90*bj_DEGTORAD)
