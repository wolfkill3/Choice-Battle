function CondRhino takes nothing returns boolean
return GetSpellAbilityId()=='A0Q8'
endfunction
function CastRhino2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real a=LoadReal(h,id,4)
local real speed=LoadReal(h,id,5)
local real x=GetUnitX(l__d)+speed*Cos(a)
local real y=GetUnitY(l__d)+speed*Sin(a)
local real x1
local real ab
local real y1
local real dmg=(75+GetHeroInt(u,true))*GetUnitAbilityLevel(u,'A0Q8')
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,3)
set idg=GetHandleId(g)
if speed>20 then
call SetUnitXY_1(l__d,x,y, false)
call SetUnitFlyHeight(l__d,0,0)
call UnitApplyTimedLife(CreateUnit(p,'e0AC',x,y,GetRandomReal(0,359)),1,0.9)
call GroupEnumUnitsInRange(g,x,y,400,Base)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set ide=GetHandleId(E)
if Condition_Base(p,E)then
if LoadUnitHandle(h,idg,ide)!=E then
set x1=GetUnitX(E)
set y1=GetUnitY(E)
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
endif
call SetControlToUnit(E,E, 1, "stun")
call Push3(E,speed+5,Atan2(GetUnitY(E)-y,GetUnitX(E)-x),125,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
endif
call GroupRemoveUnit(g,E)
endloop
call SaveReal(h,id,5,LoadReal(h,id,5)-0.30)
else
call UnitApplyTimedLife(CreateUnit(p,0x65304B45,x,y,GetRandomReal(0,359)),1,0.3)
call UnitApplyTimedLife(CreateUnit(p,0x65304B47,x,y,GetRandomReal(0,359)),1,0.5)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,idg)
call RemoveUnit(l__d)
call DestroyGroup(g)
endif
set g=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
function CastRhino takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real x2
local real y2
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,3,CreateGroup())
call SaveReal(h,id,4,a)
call SaveReal(h,id,5,45)
set E=CreateUnit(p,'e0KF',x+35*Cos(a),y+35*Sin(a),GetRandomReal(0,359))
call UnitApplyTimedLife(E,1,0.25)
call SetUnitTimeScale(E,0.65)
call SetUnitAnimation(E,"Birth")
set x2=x+200*Cos(a)
set y2=y+200*Sin(a)
call UnitApplyTimedLife(CreateUnit(p,0x65304B45,x2,y2,GetRandomReal(0,359)),1,0.3)
call UnitApplyTimedLife(CreateUnit(p,0x65304B47,x2,y2,GetRandomReal(0,359)),1,0.5)
set n=CreateUnit(p,0x65304F51,x2,y2,a*bj_RADTODEG)
call SaveUnitHandle(h,id,1,n)
call SetUnitAnimation(n,"Walk")
set soundplay=CreateSound("Sound\\Music\\mp3Music\\PainKuchiyoseNoJustu.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.03,true,function CastRhino2)
