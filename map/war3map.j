function HashiramaHPres takes nothing returns nothing
//local integer id=GetHandleId(GetExpiredTimer())
local real antiheal=0.0
if  GetUnitAbilityLevel(GetEnumUnit(), 'BHSP')>0  then

    if   GetWidgetLife(GetEnumUnit())>LoadReal(HH,GetHandleId(GetEnumUnit()),StringHash("HashHpRes")) then
        set antiheal=(GetWidgetLife(GetEnumUnit())-LoadReal( HH,GetHandleId(GetEnumUnit()),StringHash("HashHpRes")  )) * 0.2
        // antiheal=(GetWidgetLife(GetEnumUnit())-   LoadReal(HH,GetHandleId(GetEnumUnit()),StringHash("HashHpRes"))    ) * (I2R(lvl)*0.25)
    
        call SetWidgetLife(GetEnumUnit(), GetWidgetLife(GetEnumUnit())-antiheal)
    endif

    call SaveReal(HH,GetHandleId(GetEnumUnit()),StringHash("HashHpRes"), GetWidgetLife(GetEnumUnit()))
endif

endfunction

function HashiramaQClear takes nothing returns nothing
call UnitSpeed(GetEnumUnit(),1)
call SetUnitAnimation(GetEnumUnit(),"Death")
call MyRemoveUnit(GetEnumUnit(),1)
endfunction

function HashiramaQSelfAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local unit Dummy=null
local real facing=LoadReal(HH,id,3)
local real distance=LoadReal(HH,id,8)
local real time=LoadReal(HH,id,5)
local real time0=LoadReal(HH,id,21)
local group cjlocgn_00000000
local unit cjlocgn_00000001
local real cjlocgn_00000002
local real cjlocgn_00000003
local real cjlocgn_00000004
local real cjlocgn_00000005
local real cjlocgn_00000006
set time=time+0.02
call SaveReal(HH,id,5,time)

if time>1 and LoadBoolean(HH,id,45)==true  then
call ForGroup(LoadGroupHandle(HH,id,4),function HashiramaHPres)
endif

if time<5 then
call SetUnitInvulnerable(caster,true)
endif

if time>5 then
if time==5.02 then
call SetUnitInvulnerable(caster,false)
endif
if time==10 then
call DestroyGroup(LoadGroupHandle(HH,id,4))
call DestroyGroup(LoadGroupHandle(HH,id,41))
if LoadBoolean(HH,id,45)==true then
call RemoveUnit(LoadUnitHandle(HH,id,50))
endif
call ForGroup(LoadGroupHandle(HH,id,40),function HashiramaQClear)
call DestroyGroup(LoadGroupHandle(HH,id,40))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
else
if(OrderId2String(GetUnitCurrentOrder(caster))!="charm")then
call SaveReal(HH,id,5,5)
else
set time0=time0+0.02
if time==0.02 or time0==0.4 then
set time0=0
call UnitCreateAndMove(caster,'hs05',caster,GetRandomReal(0,360),1,GetRandomReal(1,2),GetRandomReal(0.75,1.5),100,100,100,0,100,caster,0,facing)
call UnitCreateAndMove(caster,'hs01',caster,GetRandomReal(0,360),1,GetRandomReal(1,2),GetRandomReal(0.75,1),100,100,100,GetRandomReal(20,40),0,caster,0,facing)
endif
call SaveReal(HH,id,21,time0)
if time==0.02 then
if GetUnitTypeId(caster)=='HHSN' then
call SetUnitAnimationByIndex(caster,10)
else
call SetUnitAnimationByIndex(caster,7)
endif
call SaveGroupHandle(HH,id,4,CreateGroup())
call SaveGroupHandle(HH,id,40,CreateGroup())
call SaveGroupHandle(HH,id,41,CreateGroup())
call PauseUnit(caster,false)
call SetUnitPathing(caster,true)
call SaveReal(HH,id,11,GetUnitX(caster))
call SaveReal(HH,id,12,GetUnitY(caster))
endif
if distance<1000 then
call SaveReal(HH,id,8,distance+20)
endif
call DamageAoeOneTime2Hashirama(caster,LoadReal(HH,id,11),LoadReal(HH,id,12),100+distance*0.9,LoadReal(HH,id,15),LoadGroupHandle(HH,id,4))
set cjlocgn_00000000=LoadGroupHandle(HH,id,40)
set cjlocgn_00000002=LoadReal(HH,id,6)
set cjlocgn_00000002=cjlocgn_00000002+0.02
if LoadBoolean(HH,id,45)==true then
if time==1 then
set n0=CreateUnit(GetOwningPlayer(caster),'e200',LoadReal(HH,id,11),LoadReal(HH,id,12),facing)
call SaveUnitHandle(HH,id,50,n0)
call UnitAddAbility(n0,0x4148534F)
set n0=null
endif
endif
if time>1 and cjlocgn_00000002==0.1 and LoadBoolean(HH,id,45)==true  then
set cjlocgn_00000003=GetRandomReal(-500-distance*0.5,500+distance*0.5)
set cjlocgn_00000004=GetRandomReal(0,360)
set cjlocgn_00000005=PolX(LoadReal(HH,id,11),cjlocgn_00000003,cjlocgn_00000004)
set cjlocgn_00000006=PolY(LoadReal(HH,id,12),cjlocgn_00000003,cjlocgn_00000004)
set cjlocgn_00000001=CreateUnit(GetOwningPlayer(caster),'hs24',cjlocgn_00000005,cjlocgn_00000006,GetRandomReal(0,360))
call UnitSize(cjlocgn_00000001,GetRandomReal(2.5,4),3,3)
call UnitSpeed(cjlocgn_00000001,2.5)
call SetUnitFlyHeight(cjlocgn_00000001,-100,0)
call SetUnitAnimation(cjlocgn_00000001,"attack")
call UnitSpeed(cjlocgn_00000001,1.25)
call GroupAddUnit(cjlocgn_00000000,cjlocgn_00000001)
endif
if cjlocgn_00000002==0.08 or cjlocgn_00000002==0.16 or cjlocgn_00000002==0.22 or cjlocgn_00000002==0.28 then
set cjlocgn_00000003=GetRandomReal(-250-distance*0.6,250+distance*0.6)
set cjlocgn_00000004=GetRandomReal(0,360)
set cjlocgn_00000005=PolX(LoadReal(HH,id,11),cjlocgn_00000003,cjlocgn_00000004)
set cjlocgn_00000006=PolY(LoadReal(HH,id,12),cjlocgn_00000003,cjlocgn_00000004)
set cjlocgn_00000001=CreateUnit(GetOwningPlayer(caster),'hs25',cjlocgn_00000005,cjlocgn_00000006,GetRandomReal(0,360))
call UnitSize(cjlocgn_00000001,GetRandomReal(2.5,3.5),3,3)
call SetUnitFlyHeight(cjlocgn_00000001,-100,0)
call UnitSpeed(cjlocgn_00000001,1.25)
call GroupAddUnit(cjlocgn_00000000,cjlocgn_00000001)
endif
if cjlocgn_00000002==0.08 or cjlocgn_00000002==0.16 or cjlocgn_00000002==0.22 or cjlocgn_00000002==0.28 then
set cjlocgn_00000003=GetRandomReal(-250-distance*0.6,250+distance*0.6)
set cjlocgn_00000004=GetRandomReal(0,360)
set cjlocgn_00000005=PolX(LoadReal(HH,id,11),cjlocgn_00000003,cjlocgn_00000004)
set cjlocgn_00000006=PolY(LoadReal(HH,id,12),cjlocgn_00000003,cjlocgn_00000004)
set cjlocgn_00000001=CreateUnit(GetOwningPlayer(caster),'hs26',cjlocgn_00000005,cjlocgn_00000006,GetRandomReal(0,360))
call UnitSize(cjlocgn_00000001,GetRandomReal(0.5,1),3,3)
call SetUnitAnimationByIndex(cjlocgn_00000001,1)
call GroupAddUnit(cjlocgn_00000000,cjlocgn_00000001)
endif
if cjlocgn_00000002>=0.32 then
set cjlocgn_00000002=0
if LoadBoolean(HH,id,45)==true and distance>1000 then
call DamageAoeOneTime41(caster,LoadReal(HH,id,11),LoadReal(HH,id,12),100+distance*0.9,LoadReal(HH,id,15)*0.05*1.2,LoadGroupHandle(HH,id,41))
else
call DamageAoeOneTime41(caster,LoadReal(HH,id,11),LoadReal(HH,id,12),100+distance*0.9,LoadReal(HH,id,15)*0.05,LoadGroupHandle(HH,id,41))
endif
call GroupClear(LoadGroupHandle(HH,id,41))
endif
call SaveReal(HH,id,6,cjlocgn_00000002)
set cjlocgn_00000000=null
set cjlocgn_00000001=null
endif
endif
set t=null
set caster=null
set Dummy=null
endfunction
function HashiramaQAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local unit Dummy=null
local real facing=LoadReal(HH,id,3)
local real distance=LoadReal(HH,id,8)
local real time=LoadReal(HH,id,5)
local real time0=LoadReal(HH,id,21)
local group cjlocgn_00000000
local real cjlocgn_00000001
local integer cjlocgn_00000002
local real cjlocgn_00000003
local real cjlocgn_00000004
local real cjlocgn_00000005
local integer cjlocgn_00000006
local unit cjlocgn_00000007
set time=time+0.02
call SaveReal(HH,id,5,time)

if time>1 and LoadBoolean(HH,id,45)==true  then
call ForGroup(LoadGroupHandle(HH,id,4),function HashiramaHPres)
endif

if time>5 then
if time==5.02 then
call RemoveUnit(LoadUnitHandle(HH,id,20))
call RemoveUnit(LoadUnitHandle(HH,id,21))
call RemoveUnit(LoadUnitHandle(HH,id,22))
call RemoveUnit(LoadUnitHandle(HH,id,23))
call RemoveUnit(LoadUnitHandle(HH,id,24))
endif
if time==10 then
call DestroyGroup(LoadGroupHandle(HH,id,4))
call DestroyGroup(LoadGroupHandle(HH,id,41))
if LoadBoolean(HH,id,45)==true then
call RemoveUnit(LoadUnitHandle(HH,id,50))
call RemoveUnit(LoadUnitHandle(HH,id,51))
call RemoveUnit(LoadUnitHandle(HH,id,52))
endif
call ForGroup(LoadGroupHandle(HH,id,40),function HashiramaQClear)
call DestroyGroup(LoadGroupHandle(HH,id,40))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
else
if(OrderId2String(GetUnitCurrentOrder(caster))!="charm")then
call SaveReal(HH,id,5,5)
