call SaveUnitHandle(HH,id,4,u)
call SaveEffectHandle(HH,id,0,AddSpecialEffectTarget(l__s,c,s2))
call SaveReal(HH,id,2,dmg)
call SaveReal(HH,id,3,per)
call SaveReal(HH,id,4,0)
call TimerStart(t,0.25,true,function MashDamage2)
