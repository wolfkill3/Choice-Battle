    if LoadBoolean(HH,idu,Silence_Debuff)==false then
        call SaveBoolean(HH,idu,Silence_Debuff,true)
        set Silence_DebuffFrame=CreateFrameByType( "SIMPLEFRAME", "SilenceDebuff", DebuffFrameGrid, "", 0 )
