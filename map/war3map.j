set x=x1-400*Cos(a)
set y=y1-400*Sin(a)
call SetUnitXY_1(u,x,y, false)
call SaveReal(h,id,2,x+400*Cos(a))
call SaveReal(h,id,3,y+400*Sin(a))
call SaveReal(h,id,4,a)
call SaveReal(h,id,5,0)
call UnitAddAbility(u,'Arav')
call UnitRemoveAbility(u,'Arav')
call SetUnitInvulnerable(u,true)
call PauseUnit(u,true)
call SetUnitFlyHeight(u,250,400)
set n=CreateUnit(p,'e06G',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,5)
call SetUnitTimeScale(n,0.1)
set n=CreateUnit(p,'e0DP',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,5)
call SetUnitTimeScale(n,0.1)
set n=CreateUnit(p,'e0DQ',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,5)
call SetUnitTimeScale(n,0.1)
set n=CreateUnit(p,'e0DO',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,5)
call SetUnitTimeScale(n,2)
call UnitAddAbility(n,'A0KM')
call UnitAddAbility(n,'A0KN')
call TimerStart(t,0.15,true,function XXBurnerCast2)
set u=null
set p=null
set t=null
endfunction
function Trig_Zeropoint_first_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A00T'
endfunction
function Trig_Zeropoint_first_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit c=LoadUnitHandle(h,id,0)
local group g=LoadGroupHandle(h,id,1)
local integer i=1
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local real dist
local real dmg=75*GetUnitAbilityLevel(c,'A00T')+GetHeroAgi(c,true)*(1+GetUnitAbilityLevel(c,'A00T'))
local integer l__idg=GetHandleId(g)
local real f
local player p=GetOwningPlayer(c)
local integer idu
loop
exitwhen i>15
set dist=LoadReal(h,id,StringHash("dist"+I2S(i)))+40
call SaveReal(h,id,StringHash("Dist"+I2S(i)),dist)
set f=GetUnitFacing(c)+24*i
if LoadReal(h,id,StringHash("dist"+I2S(i)))>=600 or LoadReal(h,id,StringHash("dist"+I2S(i)))<=60 then
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl",x+dist*Cos(f*bj_DEGTORAD),y+dist*Sin(f*bj_DEGTORAD)))
endif
set i=i+1
endloop
call UnitApplyTimedLife(CreateUnit(p,'est3',x,y,GetRandomReal(0,359)),1,1)
call GroupEnumUnitsInRange(g,x,y,dist,Base)
loop
set E=FirstOfGroup(g)
set idu=GetHandleId(E)
if IsUnitEnemy(E,p)and E!=LoadUnitHandle(h,l__idg,idu)and IsUnitType(E,UNIT_TYPE_STRUCTURE)==false then
call myCustomDamage(c,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,l__idg,idu,E)
call CC_UnitEx( E, E, 0., 2, "stun", false, "Abilities\\Spells\\Undead\\FreezingBreath\\FreezingBreathTargetArt.mdl", "origin", 0,0 )
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
if dist>=700 then
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
call UnitApplyTimedLife(CreateUnit(p,'e00J',x,y,GetRandomReal(0,359)),'BHwe',1)
endif
set c=null
set g=null
set t=null
set p=null
endfunction
function Trig_Zeropoint_first_Actions takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveReal(h,id,2,GetUnitX(u))
call SaveReal(h,id,3,GetUnitY(u))
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,1,CreateGroup())
set soundplay=CreateSound("Sound\\Music\\mp3Music\\ZeroPointBreakthroughFirstEdition2.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,.027,true,function Trig_Zeropoint_first_Actions2)
set u=null
set t=null
endfunction
function Trig_ZeroPoint_Revised_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A00W'
endfunction
function ZeroPointAct3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real time=LoadReal(h,id,1)
local real st=LoadReal(h,id,2)
if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
call SaveReal(h,id,1,time+0.05)
endif
if time>10 or GetUnitAbilityLevel(u,'A00J')>0 then
call SetHeroAgi(u,GetHeroAgi(u,false)-R2I(st),true)
call SetHeroStr(u,GetHeroStr(u,false)-R2I(st),true)
call SetHeroInt(u,GetHeroInt(u,false)-R2I(st),true)
call PauseTimer(t)
call SaveReal(h,GetHandleId(u),StringHash("zero"),0)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set t=null
endfunction
function Trig_ZeroPoint_Revised_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real r=LoadReal(h,id,1)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real st=0//
if r<3 then
call PauseUnit(u,true)
if LoadBoolean(HH,GetHandleId(u),TARGET_ABILITY)==false then
call SaveReal(h,id,1,r+0.1)
endif
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\DivineRage.mdx",u,"left hand"))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\DivineRage.mdx",u,"right hand"))
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,0.5,0.5,0.5)
call SetUnitVertexColor(n,255,255,255,100)
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,0.25,0.25,0.25)
call SetUnitVertexColor(n,255,255,255,75)
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,0.75,0.75,0.75)
call SetUnitVertexColor(n,255,255,255,50)
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,255,255,255,25)
else
call PauseUnit(u,false)
call UnitRemoveBuffs(u,false,true)
set st=LoadReal(h,GetHandleId(u),StringHash("zero"))/3
call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)+(R2I(st)))
set st=LoadReal(h,GetHandleId(u),StringHash("zero"))/35
call SetHeroAgi(u,GetHeroAgi(u,false)+R2I(st),true)
call SetHeroStr(u,GetHeroStr(u,false)+R2I(st),true)
call SetHeroInt(u,GetHeroInt(u,false)+R2I(st),true)
call SaveReal(h,id,2,st)
call PauseTimer(t)
call UnitRemoveAbility(u,'A00J')
call StartAbilityCooldown(GetUnitAbility(u,'A00W'),GetAbilityBaseRealLevelFieldById('A00W',ABILITY_RLF_COOLDOWN,GetUnitAbilityLevel(u,'A00W')-1))
call CreateModeIndicatorWithPauseFormDispellableHash(u, "war3mapImported\\BTNZeropointRevised.blp", 10, StringHash("zero"))
call TimerStart(t,0.05,true,function ZeroPointAct3)
endif
set p=null
set u=null
set t=null
endfunction
