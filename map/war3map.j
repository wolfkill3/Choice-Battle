call SetIllusionDamageReceived(n,1)
call SetUnitCurrentSight(n,600)
call SetUnitUseFood(n,true)
set i=i+1
exitwhen i>=1+GetUnitAbilityLevel(u,'A0B6')
endloop
call SetUnitX(u,x+150*Cos(r))
call SetUnitY(u,y+150*Sin(r))
