local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=LoadReal(h,id,11)
local player p=GetOwningPlayer(u)
local real dmg=LoadReal(h,id,4)
local real dist=LoadReal(h,id,2)
local real scale=LoadReal(h,id,10)
local real time=LoadReal(h,id,17)
local trigger tt=LoadTriggerHandle(h,id,1)
if time>0 then
call SetControlToUnit(u,u,0.11,"doom")
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,0.65,0.65,0.65)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,255,230,100,50)
set n=CreateUnit(p,'e0RE',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,255,230,100,255)
call SetUnitInvulnerable(u,true)
call SetUnitTimeScale(u,0.1)
call SetUnitAnimation(u,"Spell One Three")
call SaveReal(h,id,17,time-0.1)
call SaveReal(h,id,11,GetUnitFacing(u)*bj_DEGTORAD)
else
call UnitRemoveAbility(u,0x41305A49)
call SetUnitTimeScale(u,1)
if GetUnitAbilityLevel(u,'LuG3')==0 then
call SetUnitAnimation(u,"Spell Four Two")
call UnitApplyTimedLife(CreateUnit(p,'e03Z',x,y,a*bj_RADTODEG),0,1)
call SaveUnitHandle(h,id,7,CreateUnit(p,'e045',x+65*Cos(a),y+65*Sin(a),a*bj_RADTODEG))
set n=CreateUnit(p,0x65305359,x+75*Cos(a),y+75*Sin(a),a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,1.5)
call SetUnitTimeScale(n,2)
call UnitRemoveAbility(u,'A1FU')
call UnitRemoveAbility(u,'Pet1')
call TriggerClearActions(tt)
call DestroyTrigger(tt)
call UnitRemoveAbility(u,'B00A')
call UnitRemoveAbility(u,'B02Z')
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call PauseTimer(t)
call SaveReal(h,id,11,a)
call TimerStart(t,0.01,true,function RedHawkCast3)
else
call SetUnitAnimation(u,"Spell Four Two")
set n=CreateUnit(p,'e043',x+75*Cos(a),y+75*Sin(a),a*bj_RADTODEG)
call UnitApplyTimedLife(n,0,3)
call SetUnitScale(n,1.3,1.3,1.3)
call SaveUnitHandle(h,id,7,CreateUnit(p,'e045',x+65*Cos(a),y+65*Sin(a),a*bj_RADTODEG))
call UnitRemoveAbility(u,'A1FU')
call UnitRemoveAbility(u,'Pet1')
call TriggerClearActions(tt)
call DestroyTrigger(tt)
call UnitRemoveAbility(u,'B00A')
call UnitRemoveAbility(u,'B02Z')
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call PauseTimer(t)
call SaveReal(h,id,11,a)
call TimerStart(t,0.01,true,function ThorElephantCast3)
endif
endif
set p=null
set u=null
set t=null
endfunction
function RedHawkCast takes nothing returns nothing //red
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=GetUnitFacing(u)*bj_DEGTORAD
local trigger tt=CreateTrigger()
call SaveUnitHandle(h,id,0,u)
call SaveTriggerHandle(h,id,1,tt)
call SaveReal(h,id,10,0.75)
call SaveReal(h,id,13,0.4)
call SaveReal(h,id,14,100)
call SaveReal(h,id,15,0.3)
call SaveReal(h,id,11,a)
call SaveReal(h,id,17,2)
call SetUnitInvulnerable(u,true)
call SetUnitAcquireRange(u,51)
call SaveGroupHandle(h,id,12,CreateGroup())
if GetUnitAbilityLevel(u,'LuG3')==0 then
call SaveReal(h,id,2,1000)
call SaveReal(h,id,4,(GetUnitAbilityLevel(u,'A0ZJ')+3)*GetHeroAgi(u,true)+100)
call SetUnitTimeScale(u,0.1)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\RedHawk.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call UnitAddAbility(u,0x41305A49)
else
call SaveReal(h,id,2,1500)
call SaveReal(h,id,4,(((GetUnitAbilityLevel(u,'A0ZJ')+3)*GetHeroAgi(u,true))+100)*1.25)
call SetUnitAnimation(u,"Spell One Two")
set soundplay=CreateSound("Sound\\Music\\mp3Music\\One Piece Luffy Thor Elephant Gun.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
call UnitAddAbility(u,'A1FU') //Slow
call UnitAddAbility(u,'Pet1')
call StartAbilityCooldown(GetUnitAbility(u,'A0ZJ'),GetAbilityRemainingCooldown(GetUnitAbility(u,'A0ZJ')))
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerAddAction(tt,function LuffyRedStopOrders)
call TimerStart(t,0.1,true,function RedHawkCast2)
set u=null
set p=null
set t=null
endfunction
function NejiWCond takes nothing returns boolean
return GetSpellAbilityId()=='A34E'
endfunction
function NejiWCast4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,44)
local real x=LoadReal(h,id,11)
local real y=LoadReal(h,id,22)
local real time=LoadReal(h,id,33)
local real x1=GetUnitX(Neji)
local real y1=GetUnitY(Neji)
local real a=Atan2(y-y1,x-x1)
local integer i=6
local real dmg=GetUnitTotalDamage(Neji)+(1+GetUnitAbilityLevel(Neji,'A34E'))*GetHeroAgi(Neji,true)
call SaveReal(h,id,33,time+0.02)
if time<0.5 then
        call IssueImmediateOrder(u,"stop")
        call PauseUnit(u,true)
        call SetUnitInvulnerable(u,false)
        call UnitRemoveAbility(u,'BHds')
        call UnitRemoveAbility(u,'B02T')
        call UnitRemoveAbility(u,'B039')
endif
if time>=0.5 and time<3 and SR(x1,y1,x,y)>50 then
        call PauseUnit(u,true)
        call SetUnitTimeScale(Neji,0.3*time)
        call SetUnitFacing(Neji,a*bj_RADTODEG)
        call SetUnitXY_1(Neji,x1+80*Cos(a),y1+80*Sin(a), false)
        set n=CreateUnit(GetOwningPlayer(Neji),'e1GZ',x1,y1,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,1,0.15)
        call SetUnitVertexColor(n,190,255,255,60)
        call ShikiCloneEffect(n,1.5,1.05,1.25,150)
        call SetUnitAnimation(n,"attack")
endif
if time>=3 then
        call SetUnitXY_1(Neji,x-40*Cos(a),y-40*Sin(a), false)
endif
if SR(x1,y1,x,y)<80 and time>=0.5 then
    call SetUnitXY_1(Neji,x-40*Cos(a),y-40*Sin(a), false)
    call UnitRemoveAbility(Neji,'A0GN')
    call PauseUnit(u,false)
    call SetUnitInvulnerable(u,false)
    if LoadAbilityHandle(h,id,45)!=null then
        call StartAbilityCooldown(LoadAbilityHandle(h,id,45),10)
        loop
            //call BJDebugMsg(I2S(GetHandleId(UnitItemInSlot(u, i))) + " " + I2S(GetHandleId(GetAbilityOwningItem(LoadAbilityHandle(h,id,45)))) )
            if UnitItemInSlot(u, i) == GetAbilityOwningItem(LoadAbilityHandle(h,id,45)) then
                call StartItemCooldown(u,UnitItemInSlot(u, i),10)
            endif
        exitwhen i == 0
        set i=i - 1
        endloop
    endif
    call myCustomDamage(Neji,u,dmg,false,false,null,null,null)
    call SetControlToUnit(Neji,u, 0.5+GetUnitAbilityLevel(Neji,'A34E')*0.5, "silenceTE")
//call SetControlToUnit(Neji,u, 1, "doom")
    //call SaveReal(h,id,56,1)
    call SetUnitInvulnerable(Neji,false)
    call UnitRemoveAbility(u,'BHds')
    call UnitRemoveAbility(u,'B02T')
    call UnitRemoveAbility(u,'B039')
    set EFF=AddSpecialEffect("NejiWJuiken.mdx", x, y)
    call SetSpecialEffectFacing(EFF , a* bj_RADTODEG)
    call SetSpecialEffectZ(EFF , 100)
    call SetSpecialEffectScale(EFF , 0.6)
    call SetSpecialEffectVertexColour(EFF,255,255,255,120)
    call RemoveEffect(EFF,1,true,CreateTimer())
    set EFF=AddSpecialEffect("WindVectorPush.mdx", x, y)
    call SetSpecialEffectFacing(EFF , a* bj_RADTODEG)
    call SetSpecialEffectZ(EFF , 40)
    call SetSpecialEffectScale(EFF , 0.6)
    call SetSpecialEffectVertexColour(EFF,255,255,255,220)
    call RemoveEffect(EFF,1,true,CreateTimer())
    call Push3(u,40,a,400,"")
    call SetUnitTimeScale(Neji,1)
    call PauseUnit(Neji,false)
    call FlushChildHashtable(h,id)
    call PauseTimer(t)
    call DestroyTimer(t)
endif
set t=null
set u=null
endfunction
