endif
exitwhen E==null
call GroupRemoveUnit(G,E)
endloop
set i=i+1
exitwhen i>=5
endloop
call SaveInteger(h,id,4,j+1)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set t=null
set u=null
set p=null
