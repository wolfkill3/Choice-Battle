function CondPSR takes nothing returns boolean
return GetSpellAbilityId()==0x41304341 and udg_B==true
endfunction
function CastPSR takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real x2=0
local real y2=0
local integer i=0
local real r
local real l__d
local real pd=-300
local real a=Atan2(y-y1,x-x1)
local real a2=0
local real dmg=(0.8+0.2*GetUnitAbilityLevel(u,0x41304341))*GetHeroAgi(u,true)
if GetUnitTypeId(u)!='H06N' and GetUnitTypeId(u)!='H06O' then
loop
exitwhen i>7
set l__d=GetRandomReal(-500,500)
set r=GetRandomReal(0,7)
set n=CreateUnit(p,'e0F0',x1,y1,0)
call SetUnitScale(n,4,4,4)
call KidMissleFly(n,50,GetRandomReal(-1,1),x+l__d*Cos(r),y+l__d*Sin(r),900,350,dmg)
set i=i+1
endloop
set soundplay=CreateSound("Sound\\Music\\mp3Music\\KidFourSpell.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
elseif GetUnitTypeId(u)=='H06N' or GetUnitTypeId(u)=='H06O' then
loop
exitwhen i>7
set l__d=GetRandomReal(-500,500)
set r=GetRandomReal(0,7)
set x2=x1+(pd+100*i)*Cos(a+deg90)
set y2=y1+(pd+100*i)*Sin(a+deg90)
set n=CreateUnit(p,0x65313355,x2,y2,0)
set a2=Atan2(y-y2,x-x2)
call SetUnitScale(n,2,2,2)
call DrakeMissleFly(n,50,0,x+l__d*Cos(r),y+l__d*Sin(r),200,350,dmg)
set n=CreateUnit(p,0x65313352,x2,y2,(a2*bj_RADTODEG))
call SetUnitAnimation(n,"Attack")
call UnitApplyTimedLife(n,1,2)
set i=i+1
endloop
set soundplay=CreateSound("Sound\\Music\\mp3Music\\DrakeR.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
set p=null
set u=null
endfunction
