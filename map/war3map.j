call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Tidal.mdx",l__d,"chest"))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX-Special.mdx",l__d,"chest"))
