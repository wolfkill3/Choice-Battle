function TrowIceArrowsCond takes nothing returns boolean
return GetSpellAbilityId()=='A1B2' and udg_B
endfunction
function TrowIceArrowsCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit l__d=LoadUnitHandle(HH,id,1)
local real dmg=(0.75+0.25*GetUnitAbilityLevel(u,'A1B1'))*GetHeroInt(u,true)+15
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real x2=0
local real y2=0
local real a=LoadReal(HH,id,3)
local real dist=LoadReal(HH,id,2)
local player p=GetOwningPlayer(u)
if dist<2500 and GetWidgetLife(l__d)>0 then
set x=x+70*Cos(a)
set y=y+70*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SaveReal(HH,id,2,dist+70)
call GroupEnumUnitsInRange(G,x,y,120,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call KillUnit(l__d)
set x2=GetUnitX(E)
set y2=GetUnitY(E)
call DestroyEffect(AddSpecialEffect("WaterMagic.mdx",x2,y2))
call DestroyEffect(AddSpecialEffect("war3mapImported\\AbsolutelyFrostMelt.mdx",x2,y2))
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 0.5, "stun")
call GroupClear(G)
endif
call GroupRemoveUnit(G,E)
endloop
else
call KillUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set l__d=null
set u=null
set p=null
set t=null
endfunction
function TrowIceArrowsCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real x=0
local real y=0
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=0
local boolean be=false
local integer idu=GetHandleId(u)
local integer str=SH_tamafrost
call SaveUnitHandle(HH,id,0,u)
set n=LoadUnitHandle(HH,idu,str+1)
if UnitIsAlive(n)and be==false and GetUnitAbilityLevel(n,'A1AV')==0 then
call SaveUnitHandle(HH,id,1,n)
set x=GetUnitX(n)
set y=GetUnitY(n)
call SetUnitScale(n,1,1,1)
call UnitAddAbility(n,'A1AV')
call UnitRemoveAbility(n,'A0A1')
set be=true
endif
set n=LoadUnitHandle(HH,idu,str+2)
if UnitIsAlive(n)and be==false and GetUnitAbilityLevel(n,'A1AV')==0 then
call SaveUnitHandle(HH,id,1,n)
set x=GetUnitX(n)
set y=GetUnitY(n)
call SetUnitScale(n,1,1,1)
call UnitAddAbility(n,'A1AV')
call UnitRemoveAbility(n,'A0A1')
set be=true
endif
set n=LoadUnitHandle(HH,idu,str+3)
if UnitIsAlive(n)and be==false and GetUnitAbilityLevel(n,'A1AV')==0 then
call SaveUnitHandle(HH,id,1,n)
set x=GetUnitX(n)
set y=GetUnitY(n)
call SetUnitScale(n,1,1,1)
call UnitAddAbility(n,'A1AV')
call UnitRemoveAbility(n,'A0A1')
set be=true
endif
set n=LoadUnitHandle(HH,idu,str+4)
if UnitIsAlive(n)and be==false and GetUnitAbilityLevel(n,'A1AV')==0 then
call SaveUnitHandle(HH,id,1,n)
set x=GetUnitX(n)
set y=GetUnitY(n)
call SetUnitScale(n,1,1,1)
call UnitAddAbility(n,'A1AV')
call UnitRemoveAbility(n,'A0A1')
set be=true
endif
if be==false then
call StartAbilityCooldown(GetUnitAbility(u, 'A1B2'), 2)
call SetWidgetMana(u,GetWidgetMana(u)+30+10*GetUnitAbilityLevel(u,'A1B2'))
endif
set a=Atan2(y1-y,x1-x)
call SaveReal(HH,id,2,0)
call SaveReal(HH,id,3,a)
set soundplay=SndN(2572) // Sound\Music\mp3Music\TamamoW.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.02,true,function TrowIceArrowsCast2)
set u=null
set p=null
set t=null
endfunction
