function IceBallCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
if IsUnitAlly(c,p)then
    call UnitAddAbility(c,'Ao8X')
    call UnitMakeAbilityPermanent(c,true,'Ao8X')
    call UnitRemoveAbilityTimed(c,'Ao8X',8)
    call PauseUnit(c,true)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
    call SetUnitTimeScale(c,0)
    call SetUnitInvulnerable(c,true)
    call TimerStart(t,3,false,function IceBallCast2)
    call UnitApplyTimedLife(CreateUnit(p,'e0GB',x,y,GetRandomReal(0,359)),'BTLF',3)
    call UnitApplyTimedLife(CreateUnit(p,'e0GD',x1,y1,GetRandomReal(0,359)),'BTLF',3)
    set n=CreateUnit(p,'e0GI',x1,y1,GetRandomReal(0,359))
    call UnitApplyTimedLife(n,'BTLF',2)
    call SetUnitTimeScale(n,0.5)
    set n=CreateUnit(p,'e0GG',x1,y1,GetRandomReal(0,359))
    call UnitApplyTimedLife(n,'BTLF',2)
    call SetUnitTimeScale(n,0.5)
    set n=CreateUnit(p,'e0GH',x1,y1,GetRandomReal(0,359))
    call UnitApplyTimedLife(n,'BTLF',2)
    call SetUnitTimeScale(n,1)
    set n=CreateUnit(p,'e0GF',x1,y1,GetRandomReal(0,359))
    call UnitApplyTimedLife(n,'BTLF',0.01)
    call SetUnitTimeScale(n,0.45)
    set n=CreateUnit(p,'e0GJ',x1,y1,0)
    call UnitApplyTimedLife(n,'BTLF',3)
    call SetUnitTimeScale(n,0)
    call UnitScale(n,1,8,0.25)
    call SetUnitVertexColor(n,255,255,255,150)
else
    if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
        call UnitAddAbility(c,'Pet1')
        call SetControlToUnit(c,c,1.55,"heavystun")
        call SetUnitTimeScale(c,0)
        call UnitApplyTimedLife(CreateUnit(p,'e0GB',x,y,GetRandomReal(0,359)),'BTLF',2)
        call UnitApplyTimedLife(CreateUnit(p,'e0GD',x1,y1,GetRandomReal(0,359)),'BTLF',2)
        set n=CreateUnit(p,'e0GI',x1,y1,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',2)
        call SetUnitTimeScale(n,0.5)
        set n=CreateUnit(p,'e0GG',x1,y1,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',2)
        call SetUnitTimeScale(n,0.5)
        set n=CreateUnit(p,'e0GH',x1,y1,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',2)
        call SetUnitTimeScale(n,1)
        set n=CreateUnit(p,'e0GF',x1,y1,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',0.01)
        call SetUnitTimeScale(n,0.45)
        set n=CreateUnit(p,'e0GJ',x1,y1,0)
        call UnitApplyTimedLife(n,'BTLF',2)
        call SetUnitTimeScale(n,0)
        call UnitScale(n,1,8,0.25)
        call SetUnitVertexColor(n,255,255,255,150)
        call TimerStart(t,1.5,false,function IceBallCast2)
    else
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
        call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
        call SetUnitFlyHeight(u,0,0)
        call SetUnitFlyHeight(c,0,0)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
    endif
endif
set soundplay=SndN(1471) // Sound\Music\mp3Music\IceBall.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set u=null
set c=null
set p=null
set t=null
endfunction
