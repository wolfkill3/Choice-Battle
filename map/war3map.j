local real Roshi_T_time=LoadReal(HH,GetHandleId(GetOwningPlayer(caster)),SH_KimiFormDur)
if (IsUnitPaused(caster)==false and IsUnitHidden(caster)==false and GetUnitAbilityLevel(caster,'Pet1')==0)or time<0.02 then
set time=time+0.02
call SaveReal(HH,id,5,time)
if time>0.02 then
call SaveReal(HH,GetHandleId(GetOwningPlayer(caster)),SH_KimiFormDur,Roshi_T_time-0.02)
endif
endif
if time==0.02 then
if GetRandomInt(1,2)==1 then
set soundplay=SndN(4671) // Sound\Roshi\Roshi_T.mp3
call StartSound(soundplay)
//call SetSoundVolume(soundplay,370)
