function ShintenRaihoCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local real ang=150*bj_DEGTORAD
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,5,x1)
call SaveReal(h,id,6,y1)
call SaveReal(h,id,4,(GetUnitAbilityLevel(u,'A0ZM')+3)*GetHeroInt(u,true)+100+Urahara_DMG(u,1)  )
call SaveReal(h,id,2,2700)
call SaveReal(h,id,10,1.25)
call SaveReal(h,id,11,a)
call SaveReal(h,id,13,0)
call SaveGroupHandle(h,id,12,CreateGroup())
call SetUnitInvulnerable(u,true)
call PauseUnit(u,true)
call SetUnitAnimationByIndex(u, 4)
set soundplay=SndN(1041) // Sound\Music\mp3Music\Hiryu Gekizoku Shinten Raiho.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set n=CreateUnit(p,'e0QQ',x+45*Cos(a),y+45*Sin(a),a*bj_RADTODEG)
call SaveUnitHandle(h,id,7,n)
call UnitRemoveAbility(n,'A0SR')
call UnitRemoveAbility(n,'A0SQ')
call UnitAddAbility(n,'A0ZN')
call SetUnitFlyHeight(n,100,0)
call TimerStart(t,0.1,true,function ShintenRaihoCast2)
set u=null
set p=null
set t=null
endfunction
