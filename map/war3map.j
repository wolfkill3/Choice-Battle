function Trig_BanEnd_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer i=0
loop
if Hero[i]==null then
set TavernPlayerPickAllow[i]=true
endif
set i=i+1
exitwhen i>11
endloop
set TavernPlayerPickAllow[10]=false
set TavernPlayerPickAllow[11]=false
if TavernPlayerPickAllow[GetPlayerId(GetLocalPlayer())]==true then
    call SetFrameColourEx( TavernHeroPick,0, 0xFFFFFFFF )
    call SetFrameColourEx( TavernHeroPick,1, 0xFFFFFFFF )
    call SetFrameColourEx( TavernHeroPick,2, 0xFFFFFFFF )
    call SetFrameColourEx( TavernHeroRandom,0, 0xFFFFFFFF )
    call SetFrameColourEx( TavernHeroRandom,1, 0xFFFFFFFF )
    call SetFrameColourEx( TavernHeroRandom,2, 0xFFFFFFFF )
else
    call SetFrameColourEx( TavernHeroPick,0, 0xFF404040 )
    call SetFrameColourEx( TavernHeroPick,1, 0xFF404040 )
    call SetFrameColourEx( TavernHeroPick,2, 0xFF404040 )
    call SetFrameColourEx( TavernHeroRandom,0, 0xFF404040 )
    call SetFrameColourEx( TavernHeroRandom,1, 0xFF404040 )
    call SetFrameColourEx( TavernHeroRandom,2, 0xFF404040 )
endif
set t=null
endfunction
function Trig_BanEnd_Actions takes nothing returns nothing
local timer t=CreateTimer()
local real x1=GetRectCenterX(gg_rct_Rect1)
local real y1=GetRectCenterY(gg_rct_Rect1)
local integer i=0
call TimerStart(udg_Timer,70,false,null)
call TimerStart(udg_TimerRandom,60,false,null)
call DestroyTimerDialog(udg_Ban)
set pick=0
set udg_TB=CreateTimerDialog(udg_Timer)
call ShowFrame( GetOriginFrame( ORIGIN_FRAME_MULTIBOARD, 0 ), false )
loop
set TavernPlayerPickAllow[i]=false
set i=i+1
exitwhen i>11
endloop
call SetFrameColourEx( TavernHeroPick,0, 0xFF404040 )
call SetFrameColourEx( TavernHeroPick,1, 0xFF404040 )
call SetFrameColourEx( TavernHeroPick,2, 0xFF404040 )
call SetFrameColourEx( TavernHeroRandom,0, 0xFF404040 )
call SetFrameColourEx( TavernHeroRandom,1, 0xFF404040 )
call SetFrameColourEx( TavernHeroRandom,2, 0xFF404040 )
call SetFrameText( TavernHeroPickText, "Select")
call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,"Ban stage is over, its time to pick!")
call LANG_TdTitle(udg_TB,"До начала раунда осталось:","Until the start of the round left:")
call TimerDialogDisplay(udg_TB,true)
call TimerStart(t,1,false,function Trig_BanEnd_Actions2)
set t=null
set randcond=true
set udg_RM=false
set i=0
loop
exitwhen i>=10
if bonus_repick[i]!=0 then
	call DisplayTimedTextToPlayer( Player(i), 0, 0, 5, "   " )
	call DisplayTimedTextToPlayer( Player(i), 0, 0, 5, Lng("Вам доступно два дополнительных репика на 1 раунде","You have two additional repicks available at round 1") )
endif
set i=i+1
endloop
//call AddUnitToStock(tavern_OtherAnime2,'HRen',1,1)             //other anime 2
//call AddUnitToStock(tavern_OtherAnime2,'HMad',1,1)    
//call AddUnitToStock(tavern_Naruto2,'HMin',1,1)                        //Naruto 2
//call AddUnitToStock(tavern_Bleach, 'HIc1',1,1)        
endfunction
function Trig_TimerRandom_Actions takes nothing returns nothing
local integer i=0
local integer id
local unit array u
local boolean triggered=false
if udg_B==false then
loop
exitwhen i>9
if Hero[i]==null and GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING and u[i+1]==null then
if triggered==false then
    call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,"Auto Random!")
    // call AddFrameText(TavernChat,"Auto Random!")
    set triggered=true
endif
call ClickFrame(CloseTavernButton)
set TavernPlayerPickAllow[i]=false
call SetFrameColourEx( TavernHeroPick,0, 0xFF404040 )
call SetFrameColourEx( TavernHeroPick,1, 0xFF404040 )
call SetFrameColourEx( TavernHeroPick,2, 0xFF404040 )
call SetFrameColourEx( TavernHeroRandom,0, 0xFF404040 )
call SetFrameColourEx( TavernHeroRandom,1, 0xFF404040 )
call SetFrameColourEx( TavernHeroRandom,2, 0xFF404040 )
set rand[i]=true
set udg_Repick[i+1]=0
if bonus_repick[i]==2 then
	set udg_Repick[i+1]=-2
endif
loop
set id=GetRandomInt(0,144)
if udg_RH[id]!=0 then
    set u[i+1]=CreateUnit(Player(i),udg_RH[id],GetRectCenterX(gg_rct_Rect1),GetRectCenterY(gg_rct_Rect1),0)
    call UnitInventorySetSize(u[i+1],10)
    set udg_RH[id]=0
    call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,Lng("Игроку ","Player ")+udg_Color[i+1]+GetPlayerName(Player(i))+Lng("|r выпал ","|r gets ")+GetUnitName(u[i+1]))
    call SetFrameTexture( GetFrameByName("SelectedHeroPlayer",i), GetFrameTexture(GetFrameByName("TavernBarHero",id),0), 0, true ) 
    call SetFrameTexture( GetFrameByName("SelectedHeroPlayer",i), GetFrameTexture(GetFrameByName("TavernBarHero",id),1), 1, true )
    call SetFrameTexture( GetFrameByName("SelectedHeroPlayer",i), GetFrameTexture(GetFrameByName("TavernBarHero",id),2), 2, true )
    call SetFrameTexture( GetFrameByName("TavernCMHero",Globalpick), GetFrameTexture(GetFrameByName("TavernBarHero",id),0), 0, true ) 
    call SetFrameTexture( GetFrameByName("TavernCMHero",Globalpick), GetFrameTexture(GetFrameByName("TavernBarHero",id),1), 1, true ) 
    call SetFrameTexture( GetFrameByName("TavernCMHero",Globalpick), GetFrameTexture(GetFrameByName("TavernBarHero",id),2), 2, true )       
    call SetFrameColourEx( GetFrameByName("TavernBarHero",id),0, 0xFF505050 )
    call SetFrameColourEx( GetFrameByName("TavernBarHero",id),1, 0xFF505050 )
    call SetFrameColourEx( GetFrameByName("TavernBarHero",id),2, 0xFF505050 )
    call SetFrameColourEx( GetFrameByName("TavernBarHeroTitle",id),0, 0xFF505050 )
    call SetFrameColourEx( GetFrameByName("TavernBarHeroTitle",id),1, 0xFF505050 )
    call SetFrameColourEx( GetFrameByName("TavernBarHeroTitle",id),2, 0xFF505050 )
    if FFAMode==false then
        if Player(i)==Player(0)or Player(i)==Player(1)or Player(i)==Player(2)or Player(i)==Player(3)or Player(i)==Player(4)then
            call GroupAddUnit(udg_CG[1],u[i+1])
        elseif Player(i)==Player(5)or Player(i)==Player(6)or Player(i)==Player(7)or Player(i)==Player(8)or Player(i)==Player(9)then
            call GroupAddUnit(udg_CG[2],u[i+1])
        endif
    else
        call GroupAddUnit(udg_CG[4],u[i+1])
    endif
    if GetPlayerState(Player(i),PLAYER_STATE_RESOURCE_GOLD)>= 1000 then
        call SetPlayerState(Player(i),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(i),PLAYER_STATE_RESOURCE_GOLD)-1000)
        call UnitAddItemById(u[i+1],'I01F')
    endif
    if GetPlayerState(Player(i),PLAYER_STATE_RESOURCE_GOLD)>= 900 then
        call SetPlayerState(Player(i),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(i),PLAYER_STATE_RESOURCE_GOLD)-900)
        call UnitAddItemById(u[i+1],'I01M')
    endif
    if GetPlayerState(Player(i),PLAYER_STATE_RESOURCE_GOLD)>= 900 then
        call SetPlayerState(Player(i),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(i),PLAYER_STATE_RESOURCE_GOLD)-900)
        call UnitAddItemById(u[i+1],'I01M')
    endif
endif
exitwhen u[i+1]!=null
endloop
call UpdateMultiboard()
endif
//call ConsolePrint(GetUnitName(u[i+1])+" test"+I2S(i)+"\n")
set i=i+1
endloop
endif
endfunction

function Trig_CaptainModeTimer_Actions takes nothing returns nothing
local integer i
local real x1=GetRectCenterX(gg_rct_Rect1)
local real y1=GetRectCenterY(gg_rct_Rect1)
local unit u
local integer id 
if cmb==false then
    call ShowFrame(SpectacleCaptainSelect0,false)
    call ShowFrame(SpectacleCaptainSelect1,false)
    set cmb=true
    call DestroyTimerDialog(udg_Captain)
    call TimerStart(udg_Timer4,  20,false,null) //Start
    call ShowFrame( GetOriginFrame( ORIGIN_FRAME_MULTIBOARD, 0 ), false ) 
    set udg_Captain=CreateTimerDialog(udg_Timer4)
    call LANG_TdTitle(udg_Captain,"Осталось времени на подготовку:","Time left to prepare:")
    call TimerDialogDisplay(udg_Captain,true)
    if cmp==1 then
        call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,Lng("Подготовка, начинает первая команда.","Preparations, the first team begins."))
        // call AddFrameText(TavernChat,"Очередь первой команды.")
    elseif cmp==2 then
        call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,Lng("Подготовка, начинает вторая команда.","Preparations, the second team begins."))
        // call AddFrameText(TavernChat,"Очередь второй команды.")
    endif
else
    set TavernPlayerPickAllow[Globalteam]=true
    if GetLocalPlayer()==Player(Globalteam) then
        call SetFrameColourEx( TavernHeroPick,0, 0xFFFF2020 )
        call SetFrameColourEx( TavernHeroPick,1, 0xFFFF2020 )
        call SetFrameColourEx( TavernHeroPick,2, 0xFFFF2020 )
    endif
    call DestroyTimerDialog(udg_Captain)
    call DestroyTimerDialog(udg_Ban1)
    call TimerStart(udg_Timer3,  30,false,null) //Start
    set udg_Ban1=CreateTimerDialog(udg_Timer3)
    call LANG_TdTitle(udg_Ban1,"Осталось времени:","Time left:")
    call TimerDialogDisplay(udg_Ban1,true)
endif
set u=null
endfunction

function Trig_BanEnd1_Actions takes nothing returns nothing
local integer i
local real x1=GetRectCenterX(gg_rct_Rect1)
local real y1=GetRectCenterY(gg_rct_Rect1)
local unit u
local integer id 
call DestroyTimerDialog(udg_Ban1)
call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,Lng("Выбирается случайный персонаж.","A random character is selected."))
if pick==3 then
    if cmp==2 then
        set i=5
    elseif cmp==1 then
        set i=0
    endif
else
    set i=pick1
endif
loop
set id=GetRandomInt(0,144)
if udg_RH[id]!=0 then
set u=CreateUnit(Player(i),udg_RH[id],GetRectCenterX(gg_rct_Rect1),GetRectCenterY(gg_rct_Rect1),0)
call UnitInventorySetSize(u,10)
//call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,"pick="+I2S(pick))
call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,Lng("Выпал ","Gets ")+GetUnitName(u))
if pick==1 or pick==2 then
call SetFrameTexture( GetFrameByName("SelectedHeroPlayer",i), GetFrameTexture(GetFrameByName("TavernBarHero",id),0), 0, true ) 
call SetFrameTexture( GetFrameByName("SelectedHeroPlayer",i), GetFrameTexture(GetFrameByName("TavernBarHero",id),1), 1, true )
call SetFrameTexture( GetFrameByName("SelectedHeroPlayer",i), GetFrameTexture(GetFrameByName("TavernBarHero",id),2), 2, true )
endif
call SetFrameTexture( GetFrameByName("TavernCMHero",Globalpick), GetFrameTexture(GetFrameByName("TavernBarHero",id),0), 0, true ) 
call SetFrameTexture( GetFrameByName("TavernCMHero",Globalpick), GetFrameTexture(GetFrameByName("TavernBarHero",id),1), 1, true ) 
call SetFrameTexture( GetFrameByName("TavernCMHero",Globalpick), GetFrameTexture(GetFrameByName("TavernBarHero",id),2), 2, true )   
if pick==3 or cmb==true then
    call SetFrameColourEx( GetFrameByName("TavernBarHero",id),0, 0xFFFF5050 )
    call SetFrameColourEx( GetFrameByName("TavernBarHero",id),1, 0xFFFF5050 )
    call SetFrameColourEx( GetFrameByName("TavernBarHero",id),2, 0xFFFF5050 )
    call SetFrameColourEx( GetFrameByName("TavernBarHeroTitle",id),0, 0xFFFF5050 )
    call SetFrameColourEx( GetFrameByName("TavernBarHeroTitle",id),1, 0xFFFF5050 )
    call SetFrameColourEx( GetFrameByName("TavernBarHeroTitle",id),2, 0xFFFF5050 )
else
    call SetFrameColourEx( GetFrameByName("TavernBarHero",id),0, 0xFF505050 )
    call SetFrameColourEx( GetFrameByName("TavernBarHero",id),1, 0xFF505050 )
    call SetFrameColourEx( GetFrameByName("TavernBarHero",id),2, 0xFF505050 )
    call SetFrameColourEx( GetFrameByName("TavernBarHeroTitle",id),0, 0xFF505050 )
    call SetFrameColourEx( GetFrameByName("TavernBarHeroTitle",id),1, 0xFF505050 )
    call SetFrameColourEx( GetFrameByName("TavernBarHeroTitle",id),2, 0xFF505050 )
endif
set udg_RH[id]=0
else
set u=null
endif
exitwhen u!=null
endloop
set u=null
endfunction











function Trig_Start_Actions takes nothing returns nothing
local integer i=0
local integer j=0
local integer ri=0
local group g=CreateGroup()
local real x=GetRectMaxX(gg_rct_Weiw)
local real x1=GetRectMinX(gg_rct_Weiw)
local real y=GetRectMaxY(gg_rct_Weiw)
local real y1=GetRectMinY(gg_rct_Weiw)
// call ClearStrings()
call FlushParentHashtable(h)
set h=InitHashtable()
call DestroyTimerDialog(udg_TB)
if udg_test then
call SetAbilityBaseRealLevelFieldById('Aneu',ABILITY_RLF_CAST_RANGE,0,90000)
call SetAbilityBaseRealLevelFieldById('Aneu',ABILITY_RLF_ACTIVATION_RADIUS,0,90000)
else
call SetAbilityBaseRealLevelFieldById('Aneu',ABILITY_RLF_CAST_RANGE,0,100)
call SetAbilityBaseRealLevelFieldById('Aneu',ABILITY_RLF_ACTIVATION_RADIUS,0,100)
endif
set udg_TB=null
call DisableTrigger(gg_trg_KingOfHill_Enter)
call DisableTrigger(gg_trg_Tower_Enter)
call SetUnitOwner(TowerUnit,Player(PLAYER_NEUTRAL_PASSIVE),false)
call DisableTrigger(gg_trg_Fountain_Enter)
call DestroyEffect(KingOfHill)
call DestroyEffect(Tower)
call DestroyEffect(Fountain)
if FFAMode==false then
    if round==1 then
        if TavernHeroFrame!=null then
        call SetFrameColourEx( TavernHeroPick,0, 0xFF404040 )
        call SetFrameColourEx( TavernHeroPick,1, 0xFF404040 )
        call SetFrameColourEx( TavernHeroPick,2, 0xFF404040 )
    
        endif
        set passedTime=-5
        if udg_test==false then
        set HealRes=-25
        else
        set HealRes=0
        endif
        set SpeedRes=0
        loop
        exitwhen i>=11
            //call DisplayTimedTextToPlayer(Player(i),0,0,5,"Бонусные репики обнулены.")
            call DisplayTimedTextToPlayer(Player(i),0,0,5,Lng("Первый раунд, эффективность регенерации уменьшена на 25% только для этого раунда.","First round, regeneration efficiency reduced by 25% for this round only."))
            if bonus_repick[i]==2 then
                set bonus_repick[i]=0
                if udg_Repick[i+1]<0 then
                    set TavernPlayerPickAllow[i]=false
                    set udg_Repick[i+1]=0
                endif
            endif
        set i=i+1
        endloop
        set i = 0
    elseif round<=2 then
        set passedTime=-5
        set HealRes=0
        set SpeedRes=0
    elseif round>2 and round<=4 then
        set passedTime=-6
        set HealRes=0
        set SpeedRes=0
    elseif round>4 and round<=6 then
        set passedTime=-7
        set HealRes=0
        set SpeedRes=0
    elseif round>6 then
        set passedTime=-8
        set HealRes=0
        set SpeedRes=0
    endif
else
    if round==1 then
        set passedTime=-0
        if udg_test==false then
        set HealRes=-25
        else
        set HealRes=0
        endif
        set SpeedRes=0
        loop
        exitwhen i>=11
            //call DisplayTimedTextToPlayer(Player(i),0,0,5,"Бонусные репики обнулены.")
            if bonus_repick[i]==2 then
                set bonus_repick[i]=0
                if udg_Repick[i+1]<0 then
                    set udg_Repick[i+1]=0
                endif
            endif
        set i=i+1
        endloop
        call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,Lng("Первый раунд, эффективность регенерации уменьшена на 25% только для этого раунда.","First round, regeneration efficiency reduced by 25% for this round only."))
        set i = 0
    elseif round<=2 then
        set passedTime=-0
        set HealRes=0
        set SpeedRes=0
    elseif round>2 and round<=4 then
        set passedTime=-1
        set HealRes=0
        set SpeedRes=0
    elseif round>4 and round<=6 then
        set passedTime=-2
        set HealRes=0
        set SpeedRes=0
    elseif round>6 and round<=8 then
        set passedTime=-3
        set HealRes=0
        set SpeedRes=0
    elseif round>8 then
        set passedTime=-4
        set HealRes=0
        set SpeedRes=0
    endif
endif
call PauseTimer(TD2)
call PauseTimer(TD3)
call PauseTimer(TD4)
set udg_B=true
call ShowFrame( KingOfHillIcon, false)
loop
exitwhen i>=10
    call GroupEnumUnitsOfPlayer(G,Player(i),BuggedBool) //lvlbool
    set TeamPoints[i]=0
    call SetFrameSpriteAnimationOffsetPercent(TeamBar[i],0.00)
    loop
        set E=FirstOfGroup(G)
        exitwhen E==null
        call RemoveUnit(E)
        call GroupRemoveUnit(G,E)
    endloop
    if Hero[i]!=null then
        call SaveReal(HH,GetHandleId(Darkness[i]),SH_darkHP,LoadReal(HH,GetHandleId(Darkness[i]),SH_darkMaxHP))
        call SaveInteger(HH,GetHandleId(Hero[i]),SH_cold3,1)
        call SaveBoolean(HH,GetHandleId(Hero[i]),SS,false)
        call SaveBoolean(HH,GetHandleId(Hero[i]),SST,false)
        call SaveInteger(HH,GetHandleId(Hero[i]),ROYAL_GUARD_STACKS,0)
        call UnitRemoveAbility(Hero[i],'A26F')
        call UnitRemoveAbility(Hero[i],'A25F')
        call SetUnitState(Hero[i],UNIT_STATE_MANA,GetUnitState(Hero[i],UNIT_STATE_MAX_MANA))
        call UnitResetCooldown(Hero[i])
        if UnitHasItemOfTypeBJCustom(Hero[i], 'I03A') and GetWidgetLife(Hero[i])>0 and IsUnitIllusion(Hero[i])==false then
            set AlastorPos=0
            loop
            exitwhen AlastorPos==10 or GetItemTypeId(UnitItemInSlot(Hero[i],AlastorPos)) == 'I03A'
            set AlastorPos=AlastorPos+1
            endloop
            if IsAbilityEnabled(GetUnitAbility(Hero[i],'AInv'))==true then
                set Alastor=GetItemOfTypeFromUnitBJCustom(Hero[i],'I03A')
                call UnitRemoveItem(Hero[i],Alastor)
                call RemoveItem(Alastor)
                call UnitAddItemToSlotById(Hero[i], 'I03A',AlastorPos)
            else
                call EnableUnitAbility2(Hero[i],'AInv',false,true)
                set Alastor=GetItemOfTypeFromUnitBJCustom(Hero[i],'I03A')
                call UnitRemoveItem(Hero[i],Alastor)
                call RemoveItem(Alastor)
                call UnitAddItemToSlotById(Hero[i], 'I03A',AlastorPos)    
                call DisableUnitAbility2(Hero[i],'AInv',false,true)
            endif
        endif
        if GetUnitTypeId( Hero[i] )=='Rosh' then
            call SaveReal(HH,GetHandleId(GetOwningPlayer( Hero[i] )),SH_KimiFormDur,30)

            call SetUnitAnimationByIndex( LoadUnitHandle(HH,GetHandleId(GetOwningPlayer( Hero[i] )),SH_Roshi_S1) ,0)

            call SetUnitAnimationByIndex( LoadUnitHandle(HH,GetHandleId(GetOwningPlayer( Hero[i] )),SH_Roshi_S2) ,0)

            call SetUnitAnimationByIndex( LoadUnitHandle(HH,GetHandleId(GetOwningPlayer( Hero[i] )),SH_Roshi_S3) ,0)



        endif
        if GetUnitTypeId(Hero[i])=='H04A' then
            set Gon=Hero[i]
        endif
        if GetUnitTypeId(Hero[i])=='H02L' then
            set Broly=Hero[i]
        endif

        if UnitHasItemOfTypeBJ( Hero[i] ,'I03A') then //alastor passive
          call Alastor_Passive( Hero[i] )
        endif

        call SetUnitTargetable( Hero[i] ,true)
        if GetUnitTypeId(Hero[i])=='HJi1' then
            call SetUnitModel(Hero[i],"[By XeSHTeG]JirenBase.mdx")
            call ShowAbility2('JNF4',false)
            call ShowAbility2('JNF1',true)
            call SetAbilityRealLevelField(GetUnitAbility(Hero[i],'JNG1'), ABILITY_RLF_CAST_RANGE,0,400)
            call UnitRemoveAbility(Hero[i],'JNF2')
            call UnitRemoveAbility(Hero[i],'JNF3')
        endif
        if GetUnitTypeId( Hero[i] )=='H06M' then
            call SaveUnitHandle(HH,GetHandleId( Hero[i] ),SH_HerFU, Hero[i] )
        endif
        if GetUnitTypeId(Hero[i])=='H02H' then
            call SaveInteger(HH,GetHandleId( GetOwningPlayer(Hero[i]) ),KaiokenHash,0)
            call SetUnitModel(Hero[i],"GokuFull.mdx")
            call SaveInteger(HH,GetHandleId( GetOwningPlayer(Hero[i]) ),MUIDodgeCountHash,0)
            if GetHeroLevel(Hero[i])>=26 then
                if LoadBoolean(HH,GetHandleId( GetOwningPlayer(Hero[i]) ),UIAvailableHash)==false then
                    call SaveReal(HH,GetHandleId( GetOwningPlayer(Hero[i]) ),UIDMGHash,0)
                    call SaveReal(HH,GetHandleId( GetOwningPlayer(Hero[i]) ),UILimitDMGHash,GetUnitMaxLife(Hero[i])*2)
                endif
            endif
        endif
        //Danzo 1 time Izanagi for every rounds
        call SaveBoolean(HH,GetHandleId( Hero[i] ),SH_SabracKillme,false)
        if GetUnitTypeId(Hero[i])=='HDSN' then
            call SaveReal(HH,GetHandleId( Hero[i] ),SH_DanzoF,40)
        endif
            ///Black Goku Rage reset very round
        if GetUnitTypeId(Hero[i])=='HBGN' then
            call SaveReal(HH,GetHandleId( Hero[i] ),BGRageHash,GetHeroStr(Hero[i],true)*12)
            call SaveReal(HH,GetHandleId( Hero[i] ),BGRageBHash,GetHeroStr(Hero[i],true)*12)
            call SaveBoolean(HH,GetHandleId( Hero[i] ),SH_BGRageBool,false)
            call SaveInteger(HH,GetHandleId( Hero[i] ),BGRageIHash,0)
            call SaveBoolean(HH,GetHandleId( Hero[i] ),SH_BGG,false)
            call SaveBoolean(HH,GetHandleId( Hero[i] ),SH_BGRose,false)
            call UnitRemoveAbility( Hero[i],'ABG1')
            call UnitAddAbility( Hero[i],'ABG0')
            call SetPlayerAbilityAvailable(GetOwningPlayer( Hero[i] ),'BGG2',false)
            call SetPlayerAbilityAvailable(GetOwningPlayer( Hero[i] ),'BGG1',true)
            call SetUnitAbilityLevel( Hero[i],'BGC1',1)
        endif
        if GetUnitTypeId(Hero[i])=='HMad' or GetUnitTypeId(Hero[i])=='HMaG' then
            call SaveReal(HH,GetHandleId( Hero[i] ),MadokaDHash,0)
            call SaveReal(HH,GetHandleId( Hero[i] ),MadokaTDHash,4000+round*100)
            call SaveReal(HH,GetHandleId( Hero[i] ),MadokaHHash,0)
            call SaveReal(HH,GetHandleId( Hero[i] ),MadokaTHHash,2000+round*50)
            call SaveInteger(HH,GetHandleId( Hero[i] ),MadokaMHash,0)
        endif
        if LoadBoolean(HH,GetHandleId(Hero[i]),'ShSt') then
            call SaveBoolean(HH,GetHandleId(Hero[i]),'ShSt',false)
            call SetHeroStr(Hero[i],GetHeroStr(Hero[i],false)+LoadInteger(HH,GetHandleId(Hero[i]),'ShSA'),true)
            call SetHeroAgi(Hero[i],GetHeroAgi(Hero[i],false)+LoadInteger(HH,GetHandleId(Hero[i]),'ShAA'),true)
            call SetHeroInt(Hero[i],GetHeroInt(Hero[i],false)+LoadInteger(HH,GetHandleId(Hero[i]),'ShIA'),true)
            call SaveInteger(HH,GetHandleId(Hero[i]),'ShSA',0)
            call SaveInteger(HH,GetHandleId(Hero[i]),'ShAA',0)
            call SaveInteger(HH,GetHandleId(Hero[i]),'ShIA',0)
            call DestroyImage(GetUnitImage(Hero[i],3))
            call SetUnitImage(Hero[i],3,LoadImageHandle(HH,GetHandleId(Hero[i]),'ShIm'))
            call SetImageRender(GetUnitImage(Hero[i],3),true)
            call SetImageRenderAlways(GetUnitImage(Hero[i],3),true)
            call ShowImage(GetUnitImage(Hero[i],3),true)
            call RemoveSavedHandle(HH,GetHandleId(Hero[i]),'ShIm')
        endif
        if LoadInteger(HH,GetHandleId(Hero[i]),'SSG+')>0 then
            call SetHeroStr(Hero[i],GetHeroStr(Hero[i],false)-LoadInteger(HH,GetHandleId(Hero[i]),'SSG+'),true)
            call SetHeroAgi(Hero[i],GetHeroAgi(Hero[i],false)-LoadInteger(HH,GetHandleId(Hero[i]),'SAG+'),true)
            call SetHeroInt(Hero[i],GetHeroInt(Hero[i],false)-LoadInteger(HH,GetHandleId(Hero[i]),'SIG+'),true)
            call SaveInteger(HH,GetHandleId(Hero[i]),'SSG+',0)
            call SaveInteger(HH,GetHandleId(Hero[i]),'SAG+',0)
            call SaveInteger(HH,GetHandleId(Hero[i]),'SIG+',0)
        endif
        if GetUnitTypeId(Hero[i])=='H00P' or GetUnitTypeId(Hero[i])=='H00V' then
            set j=LoadInteger(HH,GetHandleId(GetOwningPlayer(Hero[i])),'ShSn')
            loop
            exitwhen j==0
                call RemoveSavedHandle(HH,GetHandleId(GetOwningPlayer(Hero[i])),'ShPS'+j)
                call RemoveSavedHandle(HH,GetHandleId(GetOwningPlayer(Hero[i])),'ShNT'+j)
                call SaveInteger(HH,GetHandleId(GetOwningPlayer(Hero[i])),'ShSA'+j,0)
                call SaveInteger(HH,GetHandleId(GetOwningPlayer(Hero[i])),'ShAA'+j,0)
                call SaveInteger(HH,GetHandleId(GetOwningPlayer(Hero[i])),'ShIA'+j,0)
                call SaveStr(HH,GetHandleId(GetOwningPlayer(Hero[i])),'ShNP'+j,null)
                set j=j-1
            endloop    
            call SaveInteger(HH,GetHandleId(GetOwningPlayer(Hero[i])),'ShSn',0)
        endif
        // Ли Шувень в игре — все проверяют свою модель, ответ через синхронизацию (ShuwenModelCheck)
        if GetUnitTypeId(Hero[i])=='H06C' then
            call ShuwenModelCheck()
        endif
        //sabrac7start
        if GetUnitTypeId( Hero[i] )=='HSab' then //'H05Z' old sabrac
            call SetUnitBaseDamageByIndex( Hero[i] ,0,GetHeroStr( Hero[i] ,false)+LoadInteger(HH,GetHandleId( (GetOwningPlayer( Hero[i] )) ),SabracSwordsHash)*3)
        endif
        //sabrac7end

        //aizen4start
        if GetUnitTypeId( Hero[i] )=='H02M' and GetHeroLevel( Hero[i] )>=12 then //aizenPassiveStates
            call AizenGPassive( Hero[i] )
        endif
        //aizen4end

        set DantesData=0
        call SaveInteger(HH,GetHandleId(Hero[i]),SH_VegetaDeath,1)
        call SaveBoolean(HH,GetHandleId(Hero[i]),DoflaTHash,false)
        call SaveInteger(HH, GetHandleId(Hero[i]), SH_GaeDeargP_CD, 1)
        call StartAbilityCooldown(GetUnitAbility(Hero[i],'A1FP'),25)
        call StartAbilityCooldown(GetUnitAbility(Hero[i],'BRLS'),40)
        call StartAbilityCooldown(GetUnitAbility(Hero[i],'GKG1'),40-GetHeroLevel(Hero[i]))
        call StartAbilityCooldown(GetUnitAbility(Hero[i],'Ao60'),10)
        call StartAbilityCooldown(GetUnitAbility(Hero[i],'A1HD'),7)
        call UnitRemoveAbility(Hero[i],'ore3')
        call UnitRemoveAbility(Hero[i],'OM17')
        call SetUnitInvulnerableTimed(Hero[i],true,0.01)
        if FFAMode==false then
            call SetUnitInvulnerableTimed(Hero[i],false,1)
        endif
        if UnitIsAlive(Lucy[i])then
            call UnitRemoveAbility(Lucy[i],'ore3')
            call RemoveUnit(Lucy[i])
            set lucy[i]=false
        endif
    endif
    set i=i+1
endloop
call GlobalReduceHeal()
set i=0
if ModuloInteger(round,duelround)!=0 or noduels==true then
if FFAMode==true then
call ForGroup(udg_CG[4],function Trig_Start_FFA)
else
set ri=GetRandomInt(1,3)
if ri==1 then
call ForGroup(udg_CG[1],function Trig_Start_Func001A)
elseif ri==2 then
call ForGroup(udg_CG[1],function Trig_Start_Func001B)
elseif ri==3 then
call ForGroup(udg_CG[1],function Trig_Start_Func001C)
endif
set ri=GetRandomInt(1,3)
if ri==1 then
call ForGroup(udg_CG[2],function Trig_Start_Func002A)
elseif ri==2 then
call ForGroup(udg_CG[2],function Trig_Start_Func002B)
elseif ri==3 then
call ForGroup(udg_CG[2],function Trig_Start_Func002C)
endif
endif
set DU=true
if PauseRes==true then
call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,Lng("Паузы уменьшают урон на 50%","Pauses reduce damage by 50%."))
else
call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,Lng("Паузы не уменьшают урон на 50%","Pauses do not reduce damage by 50%"))
endif
call DisableTrigger(duels)
call DisableTrigger(gg_trg_MoveToArena2)
call DisableTrigger(gg_trg_MoveToBase2)
call DisableTrigger(gg_trg_ArenaCamera)
call DisableTrigger(gg_trg_PauseAllUnits)
call DisableTrigger(gg_trg_ClearAllUnit)
call EnableTrigger(eoc)
call EnableTrigger(gg_trg_MoveToArena)
call TimerStart(TD,630,false,function EndOfRound)
//call TimerStart(TD2,360,false,function ResistReductionFunction)
call TimerStart(TD2,300,false,function ResistReductionFunction)
if BonusTimer==true then
call TimerStart(TD3,20,false,function BonusActivation)
endif
call TimerStart(TD4,120,false,function KingOfHillActivation)
//call TimerStart(CreateTimer(),360,false,function Arena_Narrowing)
call DestroyTimerDialog(TG)
set TG=CreateTimerDialog(TD)
call LANG_TdTitle(TG,"До конца раунда осталось:","Until the end of the round left:")
call TimerDialogDisplay(TG,true)
// if round==1 then
// call AddItemToStock(gg_unit_n00J_0036,'I068',1,1)//Grail
// endif
//if round==6 then
//call AddItemToStock(gg_unit_n00A_0035,'I039',1,1)
//endif
call VoiceStartRound()
else
if noduels==false then
call PauseTimer(TD)
call DestroyTimerDialog(TG)
call PauseTimer(TD2)
call PauseTimer(TD3)
call PauseTimer(TD4)
loop
exitwhen i>=10
if Hero[i]!=null then
call GroupAddUnit(gf,Hero[i])
call GroupAddUnit(g,Hero[i])
call SetUnitFacing(Hero[i],90)
call PauseUnit(Hero[i],true)
endif
set i=i+1
endloop
set i=0
set DU=false
set passedTime=-8
set HealRes=0
set SpeedRes=0
call TimerStart(TD2,30,false,function ResistReductionFunction)
set fi[1]=GetRandomUnitFromGroup2(g)
call GroupRemoveUnit(g,fi[1])
set fi[2]=GetRandomUnitFromGroup2(g)
call GroupRemoveUnit(g,fi[2])
call UnitRemoveAbility(fi[1],'A0QL')
call UnitRemoveAbility(fi[2],'A0QL')
call SetUnitFlyHeight(fi[1],0,0)
call SetUnitFlyHeight(fi[2],0,0)
call SetUnitPosition(fi[1],GetRectCenterX(gg_rct_F1),GetRectCenterY(gg_rct_F1))
call SetUnitPosition(fi[2],GetRectCenterX(gg_rct_F2),GetRectCenterY(gg_rct_F2))
call SetUnitFacing(fi[1],360)
call SetUnitFacing(fi[2],180)
call GroupEnumUnitsInRect(G,bj_mapInitialPlayableArea,FrendaBool)
loop
set E=FirstOfGroup(G)
exitwhen E==null
call RemoveUnit(E)
call GroupRemoveUnit(G,E)
endloop
call SetUnitState(fi[1],UNIT_STATE_LIFE,GetUnitState(fi[1],UNIT_STATE_MAX_LIFE))
call SetUnitState(fi[2],UNIT_STATE_LIFE,GetUnitState(fi[2],UNIT_STATE_MAX_LIFE))
call SetUnitState(fi[1],UNIT_STATE_MANA,GetUnitState(fi[1],UNIT_STATE_MAX_MANA))
call SetUnitState(fi[2],UNIT_STATE_MANA,GetUnitState(fi[2],UNIT_STATE_MAX_MANA))
call SetBuffDispellable(GetUnitBuff( fi[1], 'B06L' ),false)
call SetBuffDispellable(GetUnitBuff( fi[1], 'B16L' ),false)
call SetBuffDispellable(GetUnitBuff( fi[2], 'B06L' ),false)
call SetBuffDispellable(GetUnitBuff( fi[2], 'B16L' ),false)
call UnitRemoveBuffs(fi[1],true,true)
call UnitRemoveBuffs(fi[2],true,true)
call SetUnitInvulnerable(fi[1],true)
call SetUnitInvulnerable(fi[2],true)
call SetCameraPosition(GetRectCenterX(gg_rct_ArenaNormal),GetRectCenterY(gg_rct_ArenaNormal))
call DisableTrigger(eoc)
call DisableTrigger(gg_trg_MoveToArena)
call EnableTrigger(duels)
call EnableTrigger(gg_trg_ClearAllUnit)
call EnableTrigger(gg_trg_MoveToArena2)
call EnableTrigger(gg_trg_ArenaCamera)
call EnableTrigger(gg_trg_MoveToBase2)
call EnableTrigger(gg_trg_PauseAllUnits)
call SetCameraField(CAMERA_FIELD_ZOFFSET,1200.,0)
call Trig_ArenaCamera2_Actions()
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"3!")
call PauseUnit(fi[1],true)
call PauseUnit(fi[2],true)
set soundplay=SndByPath("Voice\\"+InitVoice2(GetUnitTypeId(fi[1]),GetUnitTypeId(fi[2])))
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call PolledWait(1)
call PauseUnit(fi[1],true)
call PauseUnit(fi[2],true)
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"2!")
call PolledWait(1)
call PauseUnit(fi[1],true)
call PauseUnit(fi[2],true)
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"1!")
call PolledWait(1)
call PauseUnit(fi[1],false)
call PauseUnit(fi[2],false)
call DisplayTextToPlayer(GetLocalPlayer(),0,0,"Fight!")
call SetUnitInvulnerable(fi[1],false)
call SetUnitInvulnerable(fi[2],false)
if UnitHasItemOfTypeBJCustom(fi[1], 'I03A') and GetWidgetLife(fi[1])>0 and IsUnitIllusion(fi[1])==false then
    set AlastorPos=0
    loop
    exitwhen AlastorPos==10 or GetItemTypeId(UnitItemInSlot(fi[1],AlastorPos)) == 'I03A'
    set AlastorPos=AlastorPos+1
    endloop
    if IsAbilityEnabled(GetUnitAbility(fi[1],'AInv'))==true then
        set Alastor=GetItemOfTypeFromUnitBJCustom(fi[1],'I03A')
        call UnitRemoveItem(fi[1],Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(fi[1], 'I03A',AlastorPos)
    else
        call EnableUnitAbility2(fi[1],'AInv',false,true)
        set Alastor=GetItemOfTypeFromUnitBJCustom(fi[1],'I03A')
        call UnitRemoveItem(fi[1],Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(fi[1], 'I03A',AlastorPos)    
        call DisableUnitAbility2(fi[1],'AInv',false,true)
    endif
endif
if UnitHasItemOfTypeBJCustom(fi[2], 'I03A') and GetWidgetLife(fi[2])>0 and IsUnitIllusion(fi[2])==false then
    set AlastorPos=0
    loop
    exitwhen AlastorPos==10 or GetItemTypeId(UnitItemInSlot(fi[2],AlastorPos)) == 'I03A'
    set AlastorPos=AlastorPos+1
    endloop
    if IsAbilityEnabled(GetUnitAbility(fi[2],'AInv'))==true then
        set Alastor=GetItemOfTypeFromUnitBJCustom(fi[2],'I03A')
        call UnitRemoveItem(fi[2],Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(fi[2], 'I03A',AlastorPos)
    else
        call EnableUnitAbility2(fi[2],'AInv',false,true)
        set Alastor=GetItemOfTypeFromUnitBJCustom(fi[2],'I03A')
        call UnitRemoveItem(fi[2],Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(fi[2], 'I03A',AlastorPos)    
        call DisableUnitAbility2(fi[2],'AInv',false,true)
    endif
endif
call SetForceAllianceStateBJ(all[0],all[0],bj_ALLIANCE_UNALLIED)
endif
endif
call DestroyGroup(g)
call UpdateMultiboard()
set g=null
endfunction
function InitTrig_Start takes nothing returns nothing
set gg_trg_Start=CreateTrigger()
call TriggerRegisterTimerExpireEvent(gg_trg_Start,udg_Timer)
call TriggerAddAction(gg_trg_Start,function Trig_Start_Actions)
endfunction
function InitTrig_CaptainModeTimer takes nothing returns nothing
set gg_trg_CaptainModeTimer=CreateTrigger()
call TriggerRegisterTimerExpireEvent(gg_trg_CaptainModeTimer,udg_Timer4)
call TriggerAddAction(gg_trg_CaptainModeTimer,function Trig_CaptainModeTimer_Actions)
endfunction
