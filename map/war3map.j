    call TriggerAddAction( tOnPress, function OnButtonPress )
    call TriggerAddAction( tOnUnPress, function OnButtonUnpress )
    call TriggerAddAction( tOnClick, function OnButtonCloseId )

    set OpenIdButton=CreateFrameByType( "SIMPLEBUTTON", "TestBarOpen", null, "", x )
