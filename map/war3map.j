call SetUnitFlyHeight(LoadUnitHandle(HH,id,21),100,0)
call SetUnitFlyHeight(LoadUnitHandle(HH,id,22),150,0)
call SetUnitFlyHeight(LoadUnitHandle(HH,id,23),200,0)
endif
if time<0.1 then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
