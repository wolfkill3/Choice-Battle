function RapidStrikeCast4 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit c=LoadUnitHandle(h,id,1)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetUnitX(c)
    local real y1=GetUnitY(c)
    local real a=LoadReal(h,id,3)
    local player p=GetOwningPlayer(u)
    local real dist=LoadReal(h,id,7)
    local real fl=GetUnitFlyHeight(c)-30
    local real l__d
    local real r
    local real ml=GetUnitState(c,UNIT_STATE_MAX_LIFE)
    if dist<7 then
        call PauseUnit(u,true)
        call PauseUnit(c,true)
        call SetUnitInvulnerable(u,true)
        call SaveReal(h,id,7,dist+1)
        call SetUnitFlyHeight(c,fl,0)
        set n=CreateUnit(p,'e0OE',x1+50*Cos(270),y1+50*Sin(270),180)
        call UnitApplyTimedLife(n,'BTLF',1)
        call SetUnitFlyHeight(n,fl-90,0)
        set n=CreateUnit(p,'e0OE',x1-50*Cos(270),y1-50*Sin(270),0)
        call UnitApplyTimedLife(n,'BTLF',1)
        call SetUnitFlyHeight(n,fl-90,0)
        set n=CreateUnit(p,'e0OE',x1+50*Cos(270),y1+50*Sin(270),0)
        call UnitApplyTimedLife(n,'BTLF',1)
        call SetUnitFlyHeight(n,fl+135,0)
        set n=CreateUnit(p,'e0OE',x1-50*Cos(270),y1-50*Sin(270),180)
        call UnitApplyTimedLife(n,'BTLF',1)
        call SetUnitFlyHeight(n,fl+135,0)
        set n=CreateUnit(p,'e0OI',x1,y1,GetRandomReal(0,359))
        set l__d=GetRandomReal(100,400)
        set r=GetRandomReal(0,7)
        call MissleMovePointRapidStrike(n,GetRandomReal(9,15),0,x+l__d*Cos(r),y+l__d*Sin(r),GetRandomReal(350,600),0,fl)
        set n=CreateUnit(p,'e0OH',x1,y1,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',1)
        call SetUnitFlyHeight(n,fl+75,0)
    else
        call SetUnitFlyHeight(c,0,0)
        //call SetUnitX(u,x1)
        //call SetUnitY(u,y1)
        call SetUnitAnimation(u,"Spell Second")
        call PauseUnit(u,false)
        call UnitRemoveAbility(u,'A0O2')
        call SetUnitInvulnerable(u,false)
        // call SetUnitInvulnerable(c,false)
        call PauseUnit(c,false)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
        call SetControlToUnit(u,c,0.1,"heavystun")
        call MissleMovePointRapidStrike(c,50,0,x+700*Cos(a),y+700*Sin(a),400,0,fl)
        if GetUnitAbilityLevel(c,'A13O')==3 then
            call myCustomDamage(u,c,(3+GetUnitAbilityLevel(u,'A0PY'))*GetHeroAgi(u,true)+ml*(0.065+0.001*GetHeroLevel(u)),false,false,null,null,null)
            call UnitRemoveAbility(E,'A13O')
            call UnitRemoveAbility(c,'A13U')
            call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",E,"chest"))
            call SetControlToUnit(u,c,1,"silence")
            call SlowUnit(u,c,0.5,0.5,5,2,false)
        elseif GetUnitAbilityLevel(c,'A13O')<3 then
            call myCustomDamage(u,c,(3+GetUnitAbilityLevel(u,'A0PY'))*GetHeroAgi(u,true),false,false,null,null,null)
            call SetControlToUnit(u,c,1,"silence")
            if UnitIsAlive(c) then
                if GetUnitAbilityLevel(c,'A13O')==0 then
                    call UnitAddAbility(c,'A13O')
                    call UnitMakeAbilityPermanent(c,true,'A13O')
                    call UnitAddAbility(c,'A13S')
                    call UnitMakeAbilityPermanent(c,true,'A13S')
                elseif GetUnitAbilityLevel(c,'A13O')<3 then
                    if GetUnitAbilityLevel(c,'A13O')==1 then
                        call UnitRemoveAbility(c,'A13S')
                        call UnitAddAbility(c,'A13T')
                        call UnitMakeAbilityPermanent(c,true,'A13T')
                    elseif GetUnitAbilityLevel(c,'A13O')==2 then
                        call UnitRemoveAbility(c,'A13T')
                        call UnitAddAbility(c,'A13U')
                        call UnitMakeAbilityPermanent(c,true,'A13U')
                    endif
                    call SetUnitAbilityLevel(c,'A13O',GetUnitAbilityLevel(c,'A13O')+1)
                endif
            endif
        endif
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
    endif
    set p=null
    set c=null
    set u=null
    set t=null
endfunction
function RapidStrikeCast3 takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(h,id,0)
        local unit c=LoadUnitHandle(h,id,1)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        local real x1=GetUnitX(c)
        local real y1=GetUnitY(c)
        local real a=LoadReal(h,id,3)
        local player p=GetOwningPlayer(u)
        local real dist=LoadReal(h,id,7)
        if dist<4 then
            call SetUnitFlyHeight(c,GetUnitFlyHeight(c)+70,0)
            call SaveReal(h,id,7,dist+1)
            call PauseUnit(u,true)
            call PauseUnit(c,true)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
            call SetUnitInvulnerable(u,true)
            // call SetUnitInvulnerable(c,true)
        else
                call PauseTimer(t)
                call SaveReal(h,id,7,0)
                call TimerStart(t,0.1,true,function RapidStrikeCast4)
        endif
        set p=null
        set c=null
        set u=null
        set t=null
endfunction
function RapidStrikeCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit c=LoadUnitHandle(h,id,1)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetUnitX(c)
    local real y1=GetUnitY(c)
    local real a=LoadReal(h,id,3)
    local real dmg=2*GetHeroStr(u,true)
    local player p=GetOwningPlayer(u)
    local real dist=LoadReal(h,id,7)
    if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then 
        if dist<LoadReal(h,id,9)then
            call PauseUnit(u,true)
            call PauseUnit(c,true)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
            call SetUnitInvulnerable(u,true)
            // call SetUnitInvulnerable(c,true)
            call SetUnitXY_1(u,x+60*Cos(a),y+60*Sin(a), false)
            if GetUnitTypeId(u)=='H03R' then
                set n=CreateUnit(p,'e0OC',x,y,a*bj_RADTODEG)
            else
                set n=CreateUnit(p,'e10B',x,y,a*bj_RADTODEG)
            endif
            call UnitApplyTimedLife(n,'BTLF',0.25)
            call UnitAddAbility(n,'A0O2')
            call SetUnitTimeScale(n,2)
            call SetUnitVertexColor(n,255,255,255,125)
            call SetUnitAnimation(n,"attack")
            call SaveReal(h,id,7,dist+60)
        else
            call PauseTimer(t)
            // call SetUnitInvulnerable(c,false)
            call UnitAddAbility(c,'Arav')
            call UnitRemoveAbility(c,'Arav')
            call SaveReal(h,id,7,0)
            call TimerStart(t,0.1,true,function RapidStrikeCast3)
        endif
    else
        if dist<LoadReal(h,id,9)-840 then
            call PauseUnit(u,true)
            call PauseUnit(c,true)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
            call SetUnitInvulnerable(u,true)
            // call SetUnitInvulnerable(c,true)
            call SetUnitXY_1(u,x+60*Cos(a),y+60*Sin(a), false)
            if GetUnitTypeId(u)=='H03R' then
                set n=CreateUnit(p,'e0OC',x,y,a*bj_RADTODEG)
            else
                set n=CreateUnit(p,'e10B',x,y,a*bj_RADTODEG)
            endif
            call UnitApplyTimedLife(n,'BTLF',0.25)
            call UnitAddAbility(n,'A0O2')
            call SetUnitTimeScale(n,2)
            call SetUnitVertexColor(n,255,255,255,125)
            call SetUnitAnimation(n,"attack")
            call SaveReal(h,id,7,dist+60)
        else
            call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
            call PauseUnit(u,false)
            call UnitRemoveAbility(u,'A0O2')
            call SetUnitInvulnerable(u,false)
            call SetUnitInvulnerable(c,false)
            call PauseUnit(c,false)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
            call PauseTimer(t)
            call DestroyTimer(t)
            call FlushChildHashtable(h,id)
        endif
    endif
    set p=null
    set c=null
    set u=null
    set t=null
endfunction
function RapidStrikeCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local integer i=0
local player p=GetOwningPlayer(u)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
set n=CreateUnit(p,'e06G',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.2)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
// call SetUnitInvulnerable(c,true)
call SaveReal(h,id,9,SR(x,y,x1,y1)+700)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
if GetUnitTypeId(u)!='H03R' then
call SetUnitAnimation(u,"Spell three")
set soundplay=SndN(1800) // Sound\Music\mp3Music\SaberSakura4.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
set soundplay=SndN(1802) // Sound\Music\mp3Music\YomuR.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call UnitAddAbility(u,'A0O2')
call SaveReal(h,id,3,Atan2(GetUnitY(c)-y,GetUnitX(c)-x))
call TimerStart(t,0.01,true,function RapidStrikeCast2)
set u=null
set c=null
set p=null
set t=null
endfunction
function RapidStrikeInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function RapidStrikeCast)
call TriggerAddCondition(t,Condition(function RapidStrikeCond))
set t=null
endfunction
function SpiritSwordCond takes nothing returns boolean
return GetSpellAbilityId()=='A0PW' and udg_B==true
endfunction
function SpiritSwordCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local player p=GetOwningPlayer(u)
local real a=Atan2(y1-y,x1-x)
local real time=LoadReal(h,id,5)
local real ml=0
local real dmg=(3+GetUnitAbilityLevel(u,'A0PW'))*GetHeroAgi(u,true)
local real time2=LoadReal(h,id,6)
if time2<1.5 then
call SaveReal(h,id,6,time2+0.3)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
if time2==1.2 then
if GetUnitTypeId(u)!='H03R' then
call SetUnitAnimation(u,"Spell channel one")
endif
call SetUnitXY_1(u,x1,y1, false)
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
if GetUnitTypeId(u)!='H03R' then
set soundplay=SndN(1804) // Sound\Music\mp3Music\SaberSakura3.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
set soundplay=SndN(1806) // Sound\Music\mp3Music\YomuE.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call UnitApplyTimedLife(CreateUnit(p,'e0FA',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0HL',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0HM',x1,y1,a*bj_RADTODEG),'BTLF',1)
call ShakeCamera(0.4,20)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",c,"chest"))
endif
call SetUnitFacing(u,a*bj_RADTODEG)
endif
else
if time<=3 and LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call UnitApplyTimedLife(CreateUnit(p,'e0FA',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0HL',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0HM',x1,y1,a*bj_RADTODEG),'BTLF',1)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",c,"chest"))
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitX(u,x1-100*Cos(a))
call SetUnitY(u,y1-100*Cos(a))
call SaveReal(h,id,5,time+1)
call GroupEnumUnitsInRange(G,x1,y1,300,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
call SetControlToUnit(E,E, 1, "stun")
else
call SaveReal(h,id,5,time+6)
endif
endif
call GroupRemoveUnit(G,E)
endloop
else
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
call UnitApplyTimedLife(CreateUnit(p,'e0FA',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0HL',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0HM',x1,y1,a*bj_RADTODEG),'BTLF',1)
call ShakeCamera(0.8,20)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",c,"chest"))
endif
call UnitRemoveAbility(u,'A0PX')
call UnitRemoveAbility(u,'A0PX')
call UnitRemoveAbility(u,'A0PX')
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
call SetUnitTimeScale(u,1)
call GroupEnumUnitsInRange(G,x1,y1,300,Base)
loop
set E=FirstOfGroup(G)
set ml=GetUnitState(E,UNIT_STATE_MAX_LIFE)
exitwhen E==null
if Condition_Base(p,E)then
if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
if GetUnitAbilityLevel(E,'A13O')==3 then
call myCustomDamage(u,E,dmg+ml*(0.065+0.001*GetHeroLevel(u)),false,false,null,null,null)
call SlowUnit(u,E,0.5,0.5,5,2,false)
call UnitRemoveAbility(E,'A13O')
call UnitRemoveAbility(E,'A13U')
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",E,"chest"))
elseif GetUnitAbilityLevel(E,'A13O')<3 then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
if UnitIsAlive(E) then
if GetUnitAbilityLevel(E,'A13O')==0 then
call UnitAddAbility(E,'A13O')
call UnitMakeAbilityPermanent(E,true,'A13O')
call UnitAddAbility(E,'A13S')
call UnitMakeAbilityPermanent(E,true,'A13S')
elseif GetUnitAbilityLevel(E,'A13O')<3 then
if GetUnitAbilityLevel(E,'A13O')==1 then
call UnitRemoveAbility(E,'A13S')
call UnitAddAbility(E,'A13T')
call UnitMakeAbilityPermanent(E,true,'A13T')
elseif GetUnitAbilityLevel(E,'A13O')==2 then
call UnitRemoveAbility(E,'A13T')
call UnitAddAbility(E,'A13U')
call UnitMakeAbilityPermanent(E,true,'A13U')
endif
call SetUnitAbilityLevel(E,'A13O',GetUnitAbilityLevel(E,'A13O')+1)
endif
endif
endif
call SetControlToUnit(E,E, 2, "stun")
else
call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,u)
endif
endif
call GroupRemoveUnit(G,E)
endloop
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call SetUnitTimeScale(u,1)
endif
endif
set u=null
set c=null
set t=null
endfunction
function SpiritSwordCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local player p=GetOwningPlayer(u)
local real a=Atan2(y1-y,x1-x)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
set n=CreateUnit(p,'e0HJ',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,0.3)
set n=CreateUnit(p,'e0HK',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,0.4)
call SetUnitTimeScale(u,0.30)
call SaveReal(h,id,5,0)
if GetUnitTypeId(u)=='H03R' then
call SetUnitAnimation(u,"Spell Slam")
call UnitAddAbility(u,'A0PX')
call UnitAddAbility(u,'A0PX')
call UnitAddAbility(u,'A0PX')
else
call SetUnitAnimation(u,"Spell Slam one")
endif
if GetHeroLevel(u)<35 then
call SaveReal(h,id,6,0)
else
call SaveReal(h,id,6,0.9)
endif
call TimerStart(t,0.3,true,function SpiritSwordCast2)
set u=null
set t=null
set p=null
set c=null
endfunction
function SpiritSwordInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function SpiritSwordCast)
call TriggerAddCondition(t,Condition(function SpiritSwordCond))
set t=null
endfunction
function CondBenizakuraWaveSlash takes nothing returns boolean
return GetSpellAbilityId()=='A0PV' and udg_B==true
endfunction
function CastBenizakuraWaveSlash2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real x2=LoadReal(h,id,4)
local real y2=LoadReal(h,id,5)
local real a=LoadReal(h,id,1)
local group g=LoadGroupHandle(h,id,3)
local integer l__idg=GetHandleId(g)
local integer lvl=GetUnitAbilityLevel(u,'A0PV')
local real dmg=GetHeroAgi(u,true)*(lvl+1)+50
local player p=GetOwningPlayer(u)
local integer l__ide
local real dist
local real x3
local real y3
local real ml=0
local real dist2=LoadReal(h,id,100)
if dist2<1250 and LoadBoolean(HH,GetHandleId(u),DASH_USER)==true then
call SaveReal(h,id,100,dist2+65)
call SetUnitXY_1(u,x1+65*Cos(a),y1+65*Sin(a), false)
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitAnimation(u,"attack")
if GetUnitTypeId(u)=='H03R' then
set n=CreateUnit(p,'e0OC',x1,y1,a*bj_RADTODEG)
else
set n=CreateUnit(p,'e10B',x1,y1,a*bj_RADTODEG)
endif
call UnitApplyTimedLife(n,'BTLF',0.25)
call SetUnitVertexColor(n,170,170,170,140)
call SetUnitAnimation(n,"attack")
set dist=GetRandomReal(-70,70)
set x3=x1+dist*Cos(a+deg90)
set y3=y1+dist*Sin(a+deg90)
set n=CreateUnit(p,'e0OD',x3,y3,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.25)
set dist=GetRandomReal(-70,70)
set x3=x1+dist*Cos(a+deg90)
set y3=y1+dist*Sin(a+deg90)
set n=CreateUnit(p,'e0OF',x3,y3,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.25)
call GroupEnumUnitsInRange(G,x1,y1,175,Base)
loop
set E=FirstOfGroup(G)
set ml=GetUnitState(E,UNIT_STATE_MAX_LIFE)
set l__ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,l__idg,l__ide)!=E then
if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
if GetUnitAbilityLevel(E,'A13O')==3 then
call myCustomDamage(u,E,dmg+ml*(0.065+0.001*GetHeroLevel(u)),false,false,null,null,null)
call SlowUnit(u,E,0.5,0.5,5,2,false)
call UnitRemoveAbility(E,'A13O')
call UnitRemoveAbility(E,'A13U')
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",E,"chest"))
elseif GetUnitAbilityLevel(E,'A13O')<3 then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
if UnitIsAlive(E) then
if GetUnitAbilityLevel(E,'A13O')==0 then
call UnitAddAbility(E,'A13O')
call UnitMakeAbilityPermanent(E,true,'A13O')
call UnitAddAbility(E,'A13S')
call UnitMakeAbilityPermanent(E,true,'A13S')
elseif GetUnitAbilityLevel(E,'A13O')<3 then
if GetUnitAbilityLevel(E,'A13O')==1 then
call UnitRemoveAbility(E,'A13S')
call UnitAddAbility(E,'A13T')
call UnitMakeAbilityPermanent(E,true,'A13T')
elseif GetUnitAbilityLevel(E,'A13O')==2 then
call UnitRemoveAbility(E,'A13T')
call UnitAddAbility(E,'A13U')
call UnitMakeAbilityPermanent(E,true,'A13U')
endif
call SetUnitAbilityLevel(E,'A13O',GetUnitAbilityLevel(E,'A13O')+1)
endif
endif
endif
call SaveUnitHandle(h,l__idg,l__ide,E)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",E,"chest"))
call DestroyEffect(AddSpecialEffectTarget("YoumuSlash.mdx",E,"chest"))
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",E,"chest"))
else
call SaveBoolean(HH,GetHandleId(u),DASH_USER,false)
call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,u)
endif
endif
call GroupRemoveUnit(G,E)
exitwhen E==null
endloop
else
call SaveBoolean(HH,GetHandleId(u),DASH_USER,false)
call UnitRemoveAbility(u,'A0GN')
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
call DestroyTimer(t)
call DestroyGroup(g)
