endfunction

function Trig_Table2_Actions takes nothing returns nothing
call TriggerExecute(gg_trg_Dialog2)
endfunction
function Trig_Table_Actions2 takes nothing returns nothing
if udg_button2==false then
call DialogDisplay(Player(0),udg_Dialog, false )
call DialogClear(udg_Dialog)
set udg_button2=true
call TriggerExecute(gg_trg_Dialog2)
endif
endfunction
function Trig_Table_Actions takes nothing returns nothing
set udg_Dialog=DialogCreate()
call DialogClear(udg_Dialog)
call DialogSetMessage(udg_Dialog,"Choice Mode")
set udg_Button[5]=DialogAddButton(udg_Dialog,"FFA: OFF",0)
set udg_Button[1]=DialogAddButton(udg_Dialog,"Standard Mode",0)
set udg_Button[4]=DialogAddButton(udg_Dialog,"Ban Mode",0)
set udg_Button[2]=DialogAddButton(udg_Dialog,"Random Mode",0)
if maxplayers==10 then
set udg_Button[3]=DialogAddButton(udg_Dialog,"Captain Mode",0)
endif
if udg_test==false then
call DialogDisplay(Player(0),udg_Dialog,true)
// Shop32: пока выбирается режим, магазин закрыт
set ShModePick=true
call Sh_CloseLocal()
call TriggerRegisterDialogEvent(gg_trg_Dialog2,udg_Dialog)
call TriggerRegisterDialogEvent(gg_trg_Dialog3,udg_Dialog)
call DestroyTrigger(GetTriggeringTrigger())
endif
call GroupEnumUnitsInRange(G,0,0,99999999,null)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if GetUnitTypeId(E)=='htow' then
call SetUnitVertexColor(E,255,255,255,0)
endif
call GroupRemoveUnit(G,E)
endloop
if udg_test==false then
call TimerStart(CreateTimer(), 15, false, function Trig_Table_Actions2 )
endif        
endfunction
function InitTrig_Table takes nothing returns nothing
set gg_trg_Table=CreateTrigger()
call TriggerRegisterTimerEventSingle(gg_trg_Table,15) // было 10 с: +5 с на загрузку данных
if ValidHLC() then
call TriggerAddAction(gg_trg_Table,function Trig_Table2_Actions)
else
call TriggerAddAction(gg_trg_Table,function Trig_Table_Actions)
endif
endfunction
function Trig_Dialog3_Conditions takes nothing returns boolean
return GetClickedButton()==udg_Button[5]
endfunction
function Trig_Dialog3_Actions takes nothing returns nothing
if FFAMode==false then
set udg_Dialog=DialogCreate()
call DialogClear(udg_Dialog)
call DialogSetMessage(udg_Dialog,"Choice Mode")
set udg_Button[5]=DialogAddButton(udg_Dialog,"FFA: ON",0)
set udg_Button[1]=DialogAddButton(udg_Dialog,"Standard Mode",0)
set udg_Button[4]=DialogAddButton(udg_Dialog,"Ban Mode",0)
set udg_Button[2]=DialogAddButton(udg_Dialog,"Random Mode",0)
//set udg_Button[3]=DialogAddButton(udg_Dialog,"Captain Mode",0)
call DialogDisplay(Player(0),udg_Dialog,true)
// Shop32: пока выбирается режим, магазин закрыт
set ShModePick=true
call Sh_CloseLocal()
call TriggerRegisterDialogEvent(gg_trg_Dialog2,udg_Dialog)
call TriggerRegisterDialogEvent(gg_trg_Dialog3,udg_Dialog)
set FFAMode=true
//set DamageOff=false
else
set udg_Dialog=DialogCreate()
call DialogClear(udg_Dialog)
call DialogSetMessage(udg_Dialog,"Choice Mode")
set udg_Button[5]=DialogAddButton(udg_Dialog,"FFA: OFF",0)
set udg_Button[1]=DialogAddButton(udg_Dialog,"Standard Mode",0)
set udg_Button[4]=DialogAddButton(udg_Dialog,"Ban Mode",0)
set udg_Button[2]=DialogAddButton(udg_Dialog,"Random Mode",0)
if maxplayers==10 then
set udg_Button[3]=DialogAddButton(udg_Dialog,"Captain Mode",0)
endif
call DialogDisplay(Player(0),udg_Dialog,true)
// Shop32: пока выбирается режим, магазин закрыт
set ShModePick=true
call Sh_CloseLocal()
call TriggerRegisterDialogEvent(gg_trg_Dialog2,udg_Dialog)
call TriggerRegisterDialogEvent(gg_trg_Dialog3,udg_Dialog)
set FFAMode=false
//set DamageOff=true
endif
endfunction
function InitTrig_Dialog3 takes nothing returns nothing
set gg_trg_Dialog3=CreateTrigger()
call TriggerAddCondition(gg_trg_Dialog3,Condition(function Trig_Dialog3_Conditions))
call TriggerAddAction(gg_trg_Dialog3,function Trig_Dialog3_Actions)
endfunction
function Trig_Dialog2_Conditions takes nothing returns boolean
return GetClickedButton()==udg_Button[1]or GetClickedButton()==udg_Button[2]or GetClickedButton()==udg_Button[3]or GetClickedButton()==udg_Button[4]
endfunction
function Trig_Dialog2_Actions takes nothing returns nothing
local integer i
local integer id
local real x1=GetRectCenterX(gg_rct_Rect1)
local real y1=GetRectCenterY(gg_rct_Rect1)
local group g=CreateGroup()
local group g2=CreateGroup()
local unit e
local unit array u
local integer typ1=0
local button bu
local framehandle gameUI=GetOriginFrame( ORIGIN_FRAME_GAME_UI, 0 )
local framehandle consoleUI=GetOriginFrame( ORIGIN_FRAME_CONSOLE_UI, 0 )
local framehandle UIFiller
local framehandle TavernHeroGrid
// local framehandle TavernHeroGridText
local framehandle TavernHeroAbilityGrid
local framehandle TavernHeroAdditionalAbilityGrid
// local framehandle TavernHeroAbilityGridText
local framehandle TavernHeroAbilityIcon
local framehandle TavernHeroAbilityTooltip
local framehandle TavernHeroAbilityTooltipIcon
local framehandle TavernHeroAbilityTooltipText
local framehandle TavernHeroAdditionalAbilityIcon
local framehandle TavernHeroAdditionalAbilityTooltip
local framehandle TavernHeroAdditionalAbilityTooltipIcon
local framehandle TavernHeroAdditionalAbilityTooltipText
// local framehandle TavernCMIcon
local framehandle TavernCMIconTooltip
// local framehandle TavernCMText
local framehandle TavernCMGrid
local framehandle TavernCMHero
local framehandle TavernCMStatus
local framehandle SelectedHeroGrid
local framehandle SelectedHeroIcon
local framehandle HeroTavernIcon
local framehandle HeroTavernIconStats
local framehandle HeroTavernIconOpenable
local framehandle HoverHeroTavernIcon
local framehandle HoverHeroTavernIconText
local trigger tOnPress = null
local trigger tOnUnPress = null 
local trigger tOnClick = null
local trigger toggleStatus = null
local trigger tOnHover = null
local trigger tOnUnHover = null 
local integer x=0
local integer y=0
local integer GrX=0
local integer GrY=0
// Shop32: режим выбран — магазин снова можно открыть, открытый закрываем
set ShModePick=false
call Sh_CloseLocal()

if udg_test==false then
    call EditBlackBorders( .0, .0 ) // -.02, .13 | to return to default 
    call HideOriginFrames( true )
    call ShowFrame( StatusBarFrame, false)
    call ShowFrame( CloseStatusButton, false)
    call ShowFrame( OpenStatusButton, false)
    call ShowFrame( OpenResistButton, false)
    call ShowFrame( ResistBarFrame, false)
    call ShowFrame( EmoteBarFrame, false)
    call ShowFrame( CloseEmoteButton, false)
    call ShowFrame( OpenEmoteButton, false)
    call ShowFrame( OpenShopButton, false)
    call ShowFrame( StatsBarFrame, false)
    call ShowFrame( CloseStatsButton, false)
    call ShowFrame( OpenStatsButton, false)
    // call SetFramePriority( StatusBarFrame, 1 )
    // call SetFramePriority( CloseStatusButton, 1 )
    // call SetFramePriority( OpenStatusButton, 1 )
    call ShowFrame( GetOriginFrame( ORIGIN_FRAME_MULTIBOARD, 0 ), false )   
    set TavernHeroFrame=CreateFrameByType("SIMPLEFRAME", "TavernBar", null, "", 0)
    call ClearFrameAllPoints( TavernHeroFrame )
    call SetFrameRelativePoint( TavernHeroFrame, FRAMEPOINT_CENTER, gameUI, FRAMEPOINT_CENTER,  0, 0  )
    call SetFrameSize( TavernHeroFrame, 0.815, .615)
    call SetFrameTexture(TavernHeroFrame, "StatsBackGround.tga",0,true)
    call SetFrameTexture(TavernHeroFrame, "StatsBackGround.tga",1,true)
    call SetFrameTexture(TavernHeroFrame, "StatsBackGround.tga",2,true)
    call SetFramePriority( TavernHeroFrame, 5 )

    set CloseTavernButton=CreateFrameByType( "SIMPLEBUTTON", "TavernBarClose", TavernHeroFrame, "", 0 )
    call ClearFrameAllPoints( CloseTavernButton )
    call SetFrameTexture( CloseTavernButton, "checkbox-depressed2.blp", 0, true )
    call SetFrameTexture( CloseTavernButton, "checkbox-depressed2.blp", 1, true )
    call SetFrameTexture( CloseTavernButton, "checkbox-depressed2.blp", 2, true )
    call SetFrameSize( CloseTavernButton, .12, .025 )
    call SetFrameParent( CloseTavernButton, TavernHeroFrame )
    call ShowFrame( CloseTavernButton, true )
    call SetFramePriority( CloseTavernButton, 7 )
    call SetFrameRelativePoint( CloseTavernButton, FRAMEPOINT_CENTER, TavernHeroFrame, FRAMEPOINT_TOP, 0.001, -.025 )

    set CloseTavernButtonText=CreateFrameByType( "SIMPLETEXT", "TavernBarCloseText", CloseTavernButton, "", 0 )
    call ClearFrameAllPoints( CloseTavernButtonText )
    call SetFrameBlendMode( CloseTavernButtonText, 0, BLEND_MODE_BLEND )
    call SetFrameFont( CloseTavernButtonText, "Fonts\\FRIZQT__.TTF", .01, 0 )
    call SetFrameTextAlignment( CloseTavernButtonText, TEXT_JUSTIFY_CENTER, TEXT_JUSTIFY_MIDDLE )
    call SetFrameTextColour( CloseTavernButtonText, 0xFFFFA500 )
    call SetFrameParent( CloseTavernButtonText, CloseTavernButton )
    call SetFrameText( CloseTavernButtonText, "Close Pick (Shift+I)")
    call ShowFrame( CloseTavernButtonText, true )
    call SetFrameRelativePoint( CloseTavernButtonText, FRAMEPOINT_CENTER, CloseTavernButton, FRAMEPOINT_CENTER, .00011, .0 ) 

    set UIFiller=CreateFrameByType("SIMPLEFRAME", "UIFiller", null, "", 0)
    call ClearFrameAllPoints( UIFiller )
    call SetFrameRelativePoint( UIFiller, FRAMEPOINT_CENTER, gameUI, FRAMEPOINT_CENTER,  0, 0  )
    call SetFrameSize( UIFiller, .12, .015)
    call SetFrameTexture(UIFiller, "UIFiller.blp",0,true)
    call SetFrameTexture(UIFiller, "UIFiller.blp",1,true)
    call SetFrameTexture(UIFiller, "UIFiller.blp",2,true)
    call SetFramePriority( UIFiller, 3 )
    call SetFrameRelativePoint( UIFiller, FRAMEPOINT_CENTER, TavernHeroFrame, FRAMEPOINT_TOP, 0.001, -.011 )

    set tOnPress = CreateTrigger( )
    set tOnUnPress = CreateTrigger( )
    set tOnClick = CreateTrigger( )
    call TriggerRegisterFrameEvent( tOnPress, CloseTavernButton, FRAMEEVENT_MOUSE_DOWN )
    call TriggerRegisterFrameEvent( tOnUnPress, CloseTavernButton, FRAMEEVENT_MOUSE_UP )
    call TriggerRegisterFrameEvent( tOnClick, CloseTavernButton, FRAMEEVENT_CONTROL_CLICK )

    call TriggerAddAction( tOnPress, function OnButtonPress )
    call TriggerAddAction( tOnUnPress, function OnButtonUnpress )
    call TriggerAddAction( tOnClick, function OnButtonCloseTavern )

    set SelectTavernHeroCheck = CreateFrameByType( "SPRITE", "HeroPickSelector", TavernHeroFrame, "", 0 )
    call ClearFrameAllPoints( SelectTavernHeroCheck )
    call SetFrameAbsolutePoint( SelectTavernHeroCheck, FRAMEPOINT_CENTER, .2, .2 )
    call SetFrameSize( SelectTavernHeroCheck, .0237, .0237 )
    call SetFrameSpriteModel( SelectTavernHeroCheck, "UI\\Feedback\\Autocast\\UI-ModalButtonOn.mdl" )
    call SetFrameSpriteScale( SelectTavernHeroCheck, .63)
    call ShowFrame( SelectTavernHeroCheck, false )

    set y=0
    loop 
    exitwhen y>=12
    call HandleListAddHandle(TavernHeroFrameList[y],SelectTavernHeroCheck)    
    call HandleListAddHandle(IdHeroFrameList[y],SelectTavernHeroCheck)    
    set y=y+1
    endloop  

    set OpenTavernButton=CreateFrameByType( "SIMPLEBUTTON", "TavernBarOpen", null, "", x )
    call ClearFrameAllPoints( OpenTavernButton )
    call SetFrameTexture( OpenTavernButton, "checkbox-depressed2.blp", 0, true )
    call SetFrameTexture( OpenTavernButton, "checkbox-depressed2.blp", 1, true )
    call SetFrameTexture( OpenTavernButton, "checkbox-depressed2.blp", 2, true )
    call SetFrameSize( OpenTavernButton, .12, .025 )
    call ShowFrame( OpenTavernButton, false )
    call SetFramePriority( OpenTavernButton, 7 )
    call SetFrameRelativePoint( OpenTavernButton, FRAMEPOINT_CENTER, CloseTavernButton, FRAMEPOINT_CENTER, 0, 0 )

    set OpenTavernButtonText=CreateFrameByType( "SIMPLETEXT", "TavernBarOpenText", OpenTavernButton, "", x )
    call ClearFrameAllPoints( OpenTavernButtonText )
    call SetFrameBlendMode( OpenTavernButtonText, 0, BLEND_MODE_BLEND )
    call SetFrameFont( OpenTavernButtonText, "Fonts\\FRIZQT__.TTF", .01, 0 )
    call SetFrameTextAlignment( OpenTavernButtonText, TEXT_JUSTIFY_CENTER, TEXT_JUSTIFY_MIDDLE )
    call SetFrameTextColour( OpenTavernButtonText, 0xFFFFA500 )
    call SetFrameParent( OpenTavernButtonText, OpenTavernButton )
    call SetFrameText( OpenTavernButtonText, "Open Pick (Shift+I)")
    call ShowFrame( OpenTavernButtonText, true )
    call SetFrameRelativePoint( OpenTavernButtonText, FRAMEPOINT_CENTER, OpenTavernButton, FRAMEPOINT_CENTER, .00011, .0 )

    set tOnPress = CreateTrigger( )
    set tOnUnPress = CreateTrigger( )
    set tOnClick = CreateTrigger( )       
    call TriggerRegisterFrameEvent( tOnPress, OpenTavernButton, FRAMEEVENT_MOUSE_DOWN )
    call TriggerRegisterFrameEvent( tOnUnPress, OpenTavernButton, FRAMEEVENT_MOUSE_UP )
    call TriggerRegisterFrameEvent( tOnClick, OpenTavernButton, FRAMEEVENT_CONTROL_CLICK )

    call TriggerAddAction( tOnPress, function OnButtonPress )
    call TriggerAddAction( tOnUnPress, function OnButtonUnpress )
    call TriggerAddAction( tOnClick, function OnButtonOpenTavern )
    loop
        exitwhen x>=12
        set toggleStatus = CreateTrigger( )  
        call TriggerRegisterPlayerKeyEvent( toggleStatus, Player(x), OSKEY_I, 1 ,true )
        call TriggerAddAction( toggleStatus, function ToggleOpenTavern )
        set x=x+1
    endloop

    set InfoTavernText=CreateFrameByType( "SIMPLETEXT", "TavernBarInfoText", TavernHeroFrame, "", 0 )
    call ClearFrameAllPoints( InfoTavernText )
    call SetFrameBlendMode( InfoTavernText, 0, BLEND_MODE_BLEND )
    call SetFrameFont( InfoTavernText, "Fonts\\FRIZQT__.TTF", .010, 0 )
    call SetFrameTextAlignment( InfoTavernText, TEXT_JUSTIFY_LEFT, TEXT_JUSTIFY_TOP )
    call SetFrameParent( InfoTavernText, TavernHeroFrame )
    call SetFrameText( InfoTavernText, " ")
    call ShowFrame( InfoTavernText, true )
    call SetFrameRelativePoint( InfoTavernText, FRAMEPOINT_TOPLEFT, TavernHeroFrame, FRAMEPOINT_TOPLEFT, .015, -.18 )
    call SetFrameSize( InfoTavernText, .18, .28)

    set TavernHeroPortrait = CreateFrameByType( "SPRITE", "HeroPortrait", TavernHeroFrame, "", 0 )
    call ClearFrameAllPoints( TavernHeroPortrait )
    call SetFrameRelativePoint( TavernHeroPortrait, FRAMEPOINT_TOPLEFT, TavernHeroFrame, FRAMEPOINT_TOPLEFT, .094, -.057 )
    call SetFrameSize( TavernHeroPortrait, .0002, .0002 )
    call SetFrameSpriteModel( TavernHeroPortrait, "Default_Portrait.mdx" )
    call SetFrameSpriteOrientation( TavernHeroPortrait, 0., 90, 90. )
    call SetFrameSpriteScale( TavernHeroPortrait, .0006)
    call ShowFrame( TavernHeroPortrait, true )

    // set TavernChat = CreateFrameByType( "TEXTAREA", "ChatTavern", TavernHeroFrame, "", 0 )
    // call ClearFrameAllPoints( TavernChat )
    // call SetFrameRelativePoint( TavernChat, FRAMEPOINT_CENTER, TavernHeroFrame, FRAMEPOINT_LEFT, 0.085, -0.105 )
    // call SetFrameSize( TavernChat, .235, .13 )
    // call SetFrameItemsBorder( TavernChat, .01 )
    // call SetFrameItemsHeight( TavernChat, .02 )
    // call SetFrameFont( TavernChat, "Fonts\\FRIZQT__.TTF", .01, 0 )
    // call SetFrameTextAlignment( TavernChat, TEXT_JUSTIFY_LEFT, TEXT_JUSTIFY_LEFT )
    // call AddFrameSlider( TavernChat )
    // call SetFrameText( TavernChat, "")
    // call SetFramePriority( TavernChat, 6 )
    // call ShowFrame( TavernChat, false )


    set FrameTop=GetFrameRelativePointParent(GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ),FRAMEPOINT_TOP)
    call ClearFrameAllPoints( GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ) )
    call SetFrameRelativePoint( GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ), FRAMEPOINT_CENTER, TavernHeroFrame, FRAMEPOINT_LEFT, 0.1, -0.105 )
    call SetFrameSize( GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ), .165, .117 )
    call SetFrameFont( GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ), "Fonts\\FRIZQT__.TTF", .011, 0 )

    set TavernHeroAbilityGrid=CreateFrameByType("SIMPLEGRID", "TavernBarAbilityList", TavernHeroFrame, "", 0)
    call ClearFrameAllPoints( TavernHeroAbilityGrid )
    call SetFrameRelativePoint( TavernHeroAbilityGrid, FRAMEPOINT_TOPLEFT, TavernHeroFrame, FRAMEPOINT_TOPLEFT,  .015, -.132  )
    call SetFrameGridSize( TavernHeroAbilityGrid, 1, 9 )
    call SetFrameSize( TavernHeroAbilityGrid, .190, .012)
    call SetFramePriority( TavernHeroAbilityGrid, 5 )

    set x=0
    loop 
    exitwhen x>=8 
    set TavernHeroAbilityIcon=CreateFrameByType( "SIMPLEBUTTON", "TavernAbility", TavernHeroAbilityGrid, "", x )
    call ClearFrameAllPoints( TavernHeroAbilityIcon )
    call SetFrameTexture( TavernHeroAbilityIcon, "UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp", 0, true )
    call SetFrameTexture( TavernHeroAbilityIcon, "UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp", 1, true )
    call SetFrameTexture( TavernHeroAbilityIcon, "UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp", 2, true )
    call SetFrameSize( TavernHeroAbilityIcon, .0198, .0198 )
    call ShowFrame( TavernHeroAbilityIcon, true )
    call SetFramePriority( TavernHeroAbilityIcon, 4 )
    call SetFrameGridFrame( TavernHeroAbilityGrid, 0, x, TavernHeroAbilityIcon )

    set HeroTavernIconOpenable = CreateFrameByType( "SPRITE", "TavernAbilityBorderOpenable", TavernHeroAbilityIcon, "", x )
    call ClearFrameAllPoints( HeroTavernIconOpenable )
    call SetFrameRelativePoint( HeroTavernIconOpenable, FRAMEPOINT_CENTER, TavernHeroAbilityIcon, FRAMEPOINT_CENTER, 0, 0 )
    call SetFrameSize( HeroTavernIconOpenable, .00001, .00001 )
    call SetFrameSpriteModel( HeroTavernIconOpenable, "lastprismrainbow.mdx" )
    call SetFrameSpriteOrientation( HeroTavernIconOpenable, 0., 0, 0. )
    call SetFrameSpriteScale( HeroTavernIconOpenable, 0.215)
    call ShowFrame( HeroTavernIconOpenable, false )

    set TavernHeroAbilityTooltip=CreateFrameByType("SIMPLEFRAME", "TavernAbilityTooltip", TavernHeroAbilityIcon, "", x)
    call ClearFrameAllPoints( TavernHeroAbilityTooltip )
    call SetFrameRelativePoint( TavernHeroAbilityTooltip, FRAMEPOINT_CENTER, TavernHeroAbilityIcon, FRAMEPOINT_CENTER,  3.13, -.1  )
    call ShowFrame( TavernHeroAbilityTooltip, false )
    call SetFrameParent( TavernHeroAbilityTooltip, TavernHeroAbilityIcon )
    call SetFrameTextureEx(TavernHeroAbilityTooltip, 0, "UI\\widgets\\BattleNet\\bnet-tooltip-background.blp", false, "Choice-tooltip-border.blp", 0)
    call SetFramePriority( TavernHeroAbilityTooltip, 8 )
    call SetFrameTooltip(TavernHeroAbilityIcon,TavernHeroAbilityTooltip)

    set TavernHeroAbilityTooltipText=CreateFrameByType( "SIMPLETEXT", "TavernAbilityTooltipText", TavernHeroAbilityTooltip, "", x )
    call ClearFrameAllPoints( TavernHeroAbilityTooltipText )
    call SetFrameTextColour( TavernHeroAbilityTooltipText, ConvertColour(255,255,255,255) )
    call SetFrameParent( TavernHeroAbilityTooltipText, TavernHeroAbilityTooltip )
    call SetFrameText( TavernHeroAbilityTooltipText, Lng("Описание способностей","Description of abilities"))
    call SetFrameFont( TavernHeroAbilityTooltipText, "Fonts\\FRIZQT__.TTF", .01, 0 )
    call SetFrameTextAlignment( TavernHeroAbilityTooltipText, TEXT_JUSTIFY_LEFT, TEXT_JUSTIFY_LEFT )
    call SetFrameWidth( TavernHeroAbilityTooltipText, .24)
    call SetFrameSize( TavernHeroAbilityTooltip, .26, GetFrameHeight(TavernHeroAbilityTooltipText)+0.01)
    call ShowFrame( TavernHeroAbilityTooltipText, true )
    call SetFrameRelativePoint( TavernHeroAbilityTooltipText, FRAMEPOINT_CENTER, TavernHeroAbilityTooltip, FRAMEPOINT_CENTER, 0, .0 )

    set TavernHeroAbilityTooltipIcon=CreateFrameByType( "SIMPLEFRAME", "TavernAbilityTooltipIcon", TavernHeroAbilityTooltip, "", x )
    call ClearFrameAllPoints( TavernHeroAbilityTooltipIcon )
    call SetFrameParent( TavernHeroAbilityTooltipIcon, TavernHeroAbilityTooltip )
    call SetFrameTexture( TavernHeroAbilityTooltipIcon, "UI\\Widgets\\ToolTips\\Human\\ToolTipManaIcon.blp", 0, true )
    call SetFrameTexture( TavernHeroAbilityTooltipIcon, "UI\\Widgets\\ToolTips\\Human\\ToolTipManaIcon.blp", 1, true )
    call SetFrameTexture( TavernHeroAbilityTooltipIcon, "UI\\Widgets\\ToolTips\\Human\\ToolTipManaIcon.blp", 2, true )
    call SetFrameSize( TavernHeroAbilityTooltipIcon, .0117, .0117 )
    call ShowFrame( TavernHeroAbilityTooltipIcon, true )
    call SetFrameRelativePoint( TavernHeroAbilityTooltipIcon, FRAMEPOINT_CENTER, TavernHeroAbilityTooltip, FRAMEPOINT_TOPLEFT, 0.013, -0.019 )

    set y=0
    loop 
    exitwhen y>=12
    call HandleListAddHandle(TavernHeroFrameList[y],TavernHeroAbilityTooltip)      
    set y=y+1
    endloop  

    set tOnHover = CreateTrigger( )
    set tOnUnHover = CreateTrigger( ) 
    set tOnPress = CreateTrigger( )
    set tOnUnPress = CreateTrigger( )
    set tOnClick = CreateTrigger( ) 

    call TriggerRegisterFrameEvent( tOnHover, TavernHeroAbilityIcon, FRAMEEVENT_MOUSE_ENTER )
    call TriggerRegisterFrameEvent( tOnUnHover, TavernHeroAbilityIcon, FRAMEEVENT_MOUSE_LEAVE )
    call TriggerRegisterFrameEvent( tOnPress, TavernHeroAbilityIcon, FRAMEEVENT_MOUSE_DOWN )
    call TriggerRegisterFrameEvent( tOnUnPress, TavernHeroAbilityIcon, FRAMEEVENT_MOUSE_UP )
    call TriggerRegisterFrameEvent( tOnClick, TavernHeroAbilityIcon, FRAMEEVENT_CONTROL_CLICK )

    call TriggerAddAction( tOnHover, function OnButtonHover )
    call TriggerAddAction( tOnUnHover, function OnButtonUnHover )
    call TriggerAddAction( tOnPress, function OnButtonPress )
    call TriggerAddAction( tOnUnPress, function OnButtonUnpress )
    call TriggerAddAction( tOnClick, function OnButtonAddonAbility )

    set x=x+1

    endloop

    set TavernHeroAdditionalAbilityGrid=CreateFrameByType("SIMPLEGRID", "TavernBarAdditionalAbilityList", TavernHeroFrame, "", 0)
    call ClearFrameAllPoints( TavernHeroAdditionalAbilityGrid )
    call SetFrameRelativePoint( TavernHeroAdditionalAbilityGrid, FRAMEPOINT_TOPLEFT, TavernHeroFrame, FRAMEPOINT_TOPLEFT,  .0155, -.18  )
    call SetFrameGridSize( TavernHeroAdditionalAbilityGrid, 6, 8 )
    call SetFrameSize( TavernHeroAdditionalAbilityGrid, .170, .170)
    call SetFramePriority( TavernHeroAdditionalAbilityGrid, 5 )

    set x=0
    set GrY=0
    set GrX=0
    loop 
    exitwhen x>=40
    set TavernHeroAdditionalAbilityIcon=CreateFrameByType( "SIMPLEBUTTON", "TavernAdditionalAbility", TavernHeroAdditionalAbilityGrid, "", x )
    call ClearFrameAllPoints( TavernHeroAdditionalAbilityIcon )
    call SetFrameTexture( TavernHeroAdditionalAbilityIcon, "UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp", 0, true )
    call SetFrameTexture( TavernHeroAdditionalAbilityIcon, "UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp", 1, true )
    call SetFrameTexture( TavernHeroAdditionalAbilityIcon, "UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp", 2, true )
    call SetFrameSize( TavernHeroAdditionalAbilityIcon, .0198, .0198  )
    call ShowFrame( TavernHeroAdditionalAbilityIcon, true )
    call SetFramePriority( TavernHeroAdditionalAbilityIcon, 4 )
    call SetFrameGridFrame( TavernHeroAdditionalAbilityGrid, GrX, GrY, TavernHeroAdditionalAbilityIcon )
    
    set HeroTavernIconOpenable = CreateFrameByType( "SPRITE", "TavernAdditionalAbilityBorderOpenable", TavernHeroAdditionalAbilityIcon, "", x )
    call ClearFrameAllPoints( HeroTavernIconOpenable )
    call SetFrameRelativePoint( HeroTavernIconOpenable, FRAMEPOINT_CENTER, TavernHeroAdditionalAbilityIcon, FRAMEPOINT_CENTER, 0, 0 )
    call SetFrameSize( HeroTavernIconOpenable, .00001, .00001 )
    call SetFrameSpriteModel( HeroTavernIconOpenable, "lastprismrainbow.mdx" )
    call SetFrameSpriteOrientation( HeroTavernIconOpenable, 0., 0, 0. )
    call SetFrameSpriteScale( HeroTavernIconOpenable, 0.215)
    call ShowFrame( HeroTavernIconOpenable, false )

    set TavernHeroAdditionalAbilityTooltip=CreateFrameByType("SIMPLEFRAME", "TavernAdditionalAbilityTooltip", TavernHeroAdditionalAbilityIcon, "", x)
    call ClearFrameAllPoints( TavernHeroAdditionalAbilityTooltip )
    call SetFrameRelativePoint( TavernHeroAdditionalAbilityTooltip, FRAMEPOINT_CENTER, TavernHeroAdditionalAbilityIcon, FRAMEPOINT_CENTER,  3.13, -.1  )
    call ShowFrame( TavernHeroAdditionalAbilityTooltip, false )
    call SetFrameParent( TavernHeroAdditionalAbilityTooltip, TavernHeroAdditionalAbilityIcon )
    call SetFrameTextureEx(TavernHeroAdditionalAbilityTooltip, 0, "UI\\widgets\\BattleNet\\bnet-tooltip-background.blp", false, "Choice-tooltip-border.blp", 0)
    call SetFramePriority( TavernHeroAdditionalAbilityTooltip, 8 )
    call SetFrameSize( TavernHeroAdditionalAbilityTooltip, .22, .0455)
    call SetFrameTooltip(TavernHeroAdditionalAbilityIcon,TavernHeroAdditionalAbilityTooltip)

    set TavernHeroAdditionalAbilityTooltipText=CreateFrameByType( "SIMPLETEXT", "TavernAdditionalAbilityTooltipText", TavernHeroAdditionalAbilityTooltip, "", x )
    call ClearFrameAllPoints( TavernHeroAdditionalAbilityTooltipText )
    call SetFrameTextColour( TavernHeroAdditionalAbilityTooltipText, ConvertColour(255,255,255,255) )
    call SetFrameParent( TavernHeroAdditionalAbilityTooltipText, TavernHeroAdditionalAbilityTooltip )
    call SetFrameFont( TavernHeroAdditionalAbilityTooltipText, "Fonts\\FRIZQT__.TTF", .01, 0 )
    call SetFrameText( TavernHeroAdditionalAbilityTooltipText, Lng("Описание способностей","Ability description"))
    call SetFrameTextAlignment( TavernHeroAdditionalAbilityTooltipText, TEXT_JUSTIFY_LEFT, TEXT_JUSTIFY_LEFT )
    call SetFrameWidth( TavernHeroAdditionalAbilityTooltipText, .24)
    call SetFrameSize( TavernHeroAdditionalAbilityTooltip, .26, GetFrameHeight(TavernHeroAdditionalAbilityTooltipText)+0.01)
    call ShowFrame( TavernHeroAdditionalAbilityTooltipText, true )
