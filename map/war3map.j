function Trig_Tsukuoymi_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real x=0
local real y=0
local real x2=0
local real y2=0
local real r=GetRandomReal(0,360*bj_DEGTORAD)
local real r2=GetRandomReal(0,360*bj_DEGTORAD)
local real a2=0
local real a=0
local player p=GetOwningPlayer(u)
local integer idn='e003'
if GetUnitCurrentOrder(u)==OrderId("channel") and UnitIsAlive(c) and LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
if GetUnitAbilityLevel(u,'S004')>0 then
set idn='e0N3'
endif
call SetControlToUnit(c,c,0.5,"stunbkb")
call myCustomDamage(u,c,(1+0.5*GetUnitAbilityLevel(u,'A008'))*GetHeroInt(u,true)/10,false,false,null,null,null)
if IsUnitInvulnerable(c)==true then
call IssueImmediateOrder(u,"stop")
endif
set x=x1-350*Cos(r)
set y=y1-350*Sin(r)
set x2=x1-100*Cos(r2)
set y2=y1-100*Sin(r2)
set a=Atan2(y1-y,x1-x)
set a2=Atan2(y1-y2,x1-x2)
set n=CreateUnit(p,idn,x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,125,125,125,255)
call SetUnitTimeScale(n,3)
call MissleMovePointTsukuoymi(n,30,0,x1+350*Cos(a),y1+350*Sin(a))
set n=CreateUnit(p,idn,x2,y2,a2*bj_RADTODEG)
call SetUnitVertexColor(n,125,125,125,255)
call SetUnitTimeScale(n,3)
call UnitApplyTimedLife(n,1,0.3)
call SetUnitAnimation(n,"attack")
call UnitApplyTimedLife(CreateUnit(p,'e0FX',x1,y1,GetRandomReal(0,359)),1,1)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",c,"chest"))
else
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==true then
call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
endif
call PauseTimer(t)
call DestroyTimer(t)
call RemoveUnit(LoadUnitHandle(h,id,2))
call RemoveUnit(LoadUnitHandle(h,id,3))
call FlushChildHashtable(h,id)
endif
set p=null
set c=null
set u=null
set t=null
endfunction
