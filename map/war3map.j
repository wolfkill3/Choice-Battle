call SaveReal(h,id,2,x1)
call SaveReal(h,id,3,y1)
call SaveUnitHandle(h,id,1,CreateUnit(p,0x6530515A,x,y,a*bj_RADTODEG))
set soundplay=CreateSound("Sound\\Music\\mp3Music\\YujiFireball.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.03,true,function WhiteBallCast2)
set u=null
set p=null
set t=null
endfunction
function RenDown takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real time=LoadReal(h,GetHandleId(u),StringHash("SSR"))
call SaveReal(h,GetHandleId(u),StringHash("SSR"),time-0.1)
if time<=0 then
call SaveBoolean(HH,GetHandleId(u),SS,false)
call SaveReal(h,GetHandleId(u),StringHash("SSR"),15)
call SetUnitAbilityLevel(u,'A101',1)
call UnitRemoveAbility(u,0x41313032)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set t=null
set u=null
endfunction
function RenUpCond takes nothing returns boolean
return GetSpellAbilityId()==0x41313030 and udg_B
endfunction
function RenUpCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local timer tt=CreateTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real time=LoadReal(h,id,1)
local integer lvl=GetUnitAbilityLevel(u,'A101')
if GetUnitCurrentOrder(u)==OrderId("dispel")then
call SaveReal(h,id,1,time+0.025)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitVertexColor(n,255,230,100,50)
call SetUnitScale(n,.45+.1*lvl,.45+.1*lvl,.45+.1*lvl)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitVertexColor(n,255,230,100,50)
call SetUnitScale(n,.15+.1*lvl,.15+.1*lvl,.15+.1*lvl)
set n=CreateUnit(p,'e0RE',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitVertexColor(n,255,230,100,50)
else
call RemoveUnit(LoadUnitHandle(h,id,10))
call RemoveUnit(LoadUnitHandle(h,id,11))
call RemoveUnit(LoadUnitHandle(h,id,12))
call SetUnitTimeScale(u,1)
if time>2.45 and GetUnitAbilityLevel(u,0x41313030)>lvl-1 then
if lvl<6 then
call SaveReal(h,GetHandleId(u),StringHash("SSR"),35)
call SetUnitAbilityLevel(u,'A101',lvl+1)
call UnitAddAbility(u,0x41313032)
call UnitMakeAbilityPermanent(u,true,0x41313032)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Ren.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
if LoadBoolean(HH,GetHandleId(u),SS)==false then
call SaveUnitHandle(h,GetHandleId(tt),0,u)
call SaveBoolean(HH,GetHandleId(u),SS,true)
call TimerStart(tt,0.1,true,function RenDown)
endif
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set tt=null
set u=null
set t=null
endfunction
function RenUpCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,0)
call SaveUnitHandle(h,id,10,CreateUnit(p,'e0LL',x,y,0))
call SaveUnitHandle(h,id,11,CreateUnit(p,'e0LK',x,y,0))
call SaveUnitHandle(h,id,12,CreateUnit(p,'e0LM',x,y,0))
call SetUnitTimeScale(u,0.5)
call TimerStart(t,0.025,true,function RenUpCast2)
set u=null
set p=null
set t=null
endfunction
