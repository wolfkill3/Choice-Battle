endfunction
function CastLevelUP takes nothing returns nothing
local unit u=GetTriggerUnit()
local integer i=0
local integer r=0
local integer exp=0
local integer lvl=0
loop
exitwhen i>9
if Hero[i]!=null and Hero[i]!=u then
set lvl=lvl+GetHeroLevel(Hero[i])
set r=r+1
endif
set i=i+1
endloop
set exp=GetHeroXP(u)+50*(GetHeroLevel(u)+round)
call SetHeroXP(u,exp,true)
set u=null
endfunction
