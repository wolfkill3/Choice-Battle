call SetUnitInvulnerable(u,false)
if GetWidgetLife(l__d)>dmg*0.25+5 then
call SetUnitState(l__d,UNIT_STATE_LIFE,GetWidgetLife(l__d)-dmg*0.25)
else
call SetUnitInvulnerable(l__d,false)
call UnitRemoveBuffs(l__d,true,true)
call UnitAddAbility(l__d,'A0WR')
call DamageIndicatorFunction(u,l__d,dmg)
call myCustomDamage(u,l__d,10000000,false,false,null,null,null)
call UnitRemoveAbility(l__d,'A0WR')
endif
call SetUnitInvulnerable(l__d,false)
call DamageTextTag(u,l__d,dmg*0.25)
call DamageIndicatorFunction(u,l__d,dmg*0.25)
call myCustomDamage(u,l__d,dmg-dmg*0.25,false,false,null,null,null)
call WeakenUnit(u,l__d,3,0.8, false )
call SlowUnit(u,l__d,0.6,0.6,3,2,false)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set l__d=null
set u=null
set p=null
set t=null
endfunction
