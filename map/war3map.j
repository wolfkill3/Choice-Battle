call PauseUnit(u,true)
call UnitAddAbility(u,'A0PC')
call UnitMakeAbilityPermanent(u,true,'A0PC')
set soundplay=SndN(1723) // Sound\Music\mp3Music\NelielW.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.05,true,function AbsorbCast2)
set u=null
set t=null
endfunction
