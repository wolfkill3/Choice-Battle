function CondJCV takes nothing returns boolean
return GetSpellAbilityId()=='A0PI'
endfunction
function CastJCV2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real r=GetRandomReal(-7,7)
local real dist=GetRandomReal(-450,450)
local real x=LoadReal(h,id,1)+dist*Cos(r)
local real y=LoadReal(h,id,2)+dist*Sin(r)
local group g=LoadGroupHandle(h,id,5)
local integer num=LoadInteger(h,id,3)
local integer max_num=LoadInteger(h, id, 10)
local real he=0
local player p=GetOwningPlayer(u)
local integer i=0
local real l__s=GetRandomReal(0.9,2)
local real dmg=LoadReal(h, id, 11)
local integer l__idg=GetHandleId(g)
if num<max_num then
set n=CreateUnit(p,0x65304E59,x,y,GetRandomReal(0,360))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitFlyHeight(n,GetRandomReal(-50,50),0)
call SetUnitScale(n,l__s,l__s,l__s)
call SetUnitTimeScale(n,GetRandomReal(0.7,1.5))
call SetUnitAnimation(n,"Death")
set n=CreateUnit(p,0x65304E5A,x,y,GetRandomReal(0,360))
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitFlyHeight(n,GetRandomReal(-50,50),0)
call SetUnitScale(n,l__s,l__s,l__s)
call SetUnitTimeScale(n,GetRandomReal(0.7,1.5))
call GroupEnumUnitsInRange(g,x,y,150,Base)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",GetUnitX(E),GetUnitY(E)))
call SaveUnitHandle(h,l__idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
call SaveInteger(h,id,3,num+1)
else
call FlushChildHashtable(h,l__idg)
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set g=null
set t=null
set p=null
endfunction
function CastJCV_Old takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local integer lvl=GetUnitAbilityLevel(u,'A0PI')
local real dmg=GetHeroAgi(u,true)*(3+lvl)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,GetSpellTargetX())
call SaveReal(h,id,2,GetSpellTargetY())
call SaveGroupHandle(h,id,5,CreateGroup())
call SaveInteger(h,id,3,0)
if GetUnitTypeId(u)!='H03O' then
set soundplay=SndN(1763) // Sound\Music\mp3Music\VergilQ.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif

set n=LoadUnitHandle(h,GetHandleId(u),SH_clone)
if n!=null then
        call UnitResetCooldown(n)
        call SetUnitState(n,UNIT_STATE_MANA,GetUnitState(n,UNIT_STATE_MAX_MANA))
        //call IssuePointOrder(n,"absorb",GetSpellTargetX(),GetSpellTargetY())
        call SaveInteger(h, id, 10, 12)
        call SaveReal(h, id, 11, dmg*2)
        call TimerStart(t,0.07,true,function CastJCV2)
else
        call SaveInteger(h, id, 10, 8)
        call SaveReal(h, id, 11, dmg)
        call TimerStart(t,0.08,true,function CastJCV2)
endif
set u=null
set t=null
endfunction


function VergilPatriot_ModifEnd takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(h,id,0)
        local unit c=LoadUnitHandle(h,id,1)
        call SetHeroAgi(u,GetHeroAgi(u,false)+3,true)
        call SetHeroStr(u,GetHeroStr(u,false)+3,true)
        call SetHeroInt(u,GetHeroInt(u,false)+3,true)
        call SetHeroAgi(c,GetHeroAgi(c,false)-3,true)
        call SetHeroStr(c,GetHeroStr(c,false)-3,true)
        call SetHeroInt(c,GetHeroInt(c,false)-3,true)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
        set u=null
        set c=null
        set t=null
endfunction

function VergilExcalibur_ModifEnd2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
if IsUnitAlive(u)==true and u!=null then
call SetUnitArmour(u,GetUnitArmour(u)+4)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
elseif u==null then
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set t=null
endfunction
function VergilExcalibur_ModifEnd takes nothing returns nothing
local timer t=GetExpiredTimer()
