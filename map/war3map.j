function BelfegorRPassive takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local real dur=0.5+I2R(GetUnitAbilityLevel(LoadUnitHandle(h,id,StringHash("Belfegor")),'BelR'))*0.5
local integer cd=65-GetUnitAbilityLevel(LoadUnitHandle(h,id,StringHash("Belfegor")),'BelR')*5
local real tik=LoadReal(h,id,StringHash("Tik"))
call SaveReal(h,id,StringHash("Tik"),tik+0.1)
if tik<dur then
call UnitRemoveAbility(LoadUnitHandle(h,id,StringHash("Belfegor")),'A0J4')
call UnitRemoveAbility(LoadUnitHandle(h,id,StringHash("Belfegor")),'A128')
call UnitRemoveAbility(LoadUnitHandle(h,id,StringHash("Belfegor")),'A15F')
call UnitRemoveBuffs(LoadUnitHandle(h,id,StringHash("Belfegor")),false,true)
endif
if tik>=cd then
call SaveBoolean(h,GetHandleId(LoadUnitHandle(h,id,StringHash("Belfegor"))),StringHash("BelfegorRPassiveCD"),false)
call FlushChildHashtable(h,id)
call DestroyTimer(GetExpiredTimer())
endif
if tik==dur then
call SaveBoolean(h,GetHandleId(LoadUnitHandle(h,id,StringHash("Belfegor"))),StringHash("BelfegorRPassive"),false)
call RemoveSavedBoolean(h,GetHandleId(LoadUnitHandle(h,id,StringHash("Belfegor"))),StringHash("BelfegorRPassive"))
set bjLCE=LoadEffectHandle(h,id,StringHash("EffectAura"))
call RemoveEffect(bjLCE,0.1,false,CreateTimer())
endif
endfunction
function Lampo_Damage_Actions takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real r=LoadReal(h,id,3)
local lightning l=LoadLightningHandle(h,id,2)
local real x=GetUnitX(c)
local real y=GetUnitY(c)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local unit d1=LoadUnitHandle(h,id,4)
local unit d2=LoadUnitHandle(h,id,5)
if r>0 then
call MoveLightningEx(l,false,x1,y1,GetUnitZ(u)+75,x,y,GetUnitZ(c)+75)
call SaveReal(h,id,3,r-6)
call SetLightningColor(l,0,100,0,r)
call SetUnitX(d1,x)
call SetUnitY(d1,y)
call SetUnitX(d2,x1)
call SetUnitY(d2,y1)
else
call RemoveUnit(d1)
call RemoveUnit(d2)
call DestroyTimer(t)
call DestroyLightning(l)
call FlushChildHashtable(h,id)
endif
set t=null
set u=null
set l=null
set c=null
set d1=null
set d2=null
endfunction

function AlbedoEPass_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
        local unit target= LoadUnitHandle(HH, id, c_TARGET)
    local real time= LoadReal(HH, id, c_TIME)
    if IsUnitHidden(target)==false and GetUnitAbilityLevel(target,'cbc9')==0 then
        call SaveReal(HH, id, c_TIME, time + 0.05)
    endif
    if time > 3 or udg_B==false then
        if UnitIsAlive(target) then
            //call BJDebugMsg("Item returned: " + I2S(LoadInteger(HH, id, StringHash("BrokenItemId"))) + ", slot: " + I2S(LoadInteger(h, id, StringHash("BrokenItemSlot"))))
            call RemoveItem(UnitItemInSlot(target, LoadInteger(HH, id, StringHash("BrokenItemSlot"))))
            if GetUnitAbilityLevel(target,'cbc5')>0 then
                call EnableUnitAbility2(target,'AInv',false,true)
            endif
            if IsUnitPaused(target)==false then
				call UnitAddItemToSlotById(target, LoadInteger(HH, id, StringHash("BrokenItemId")), LoadInteger(HH, id, StringHash("BrokenItemSlot")))
			else
				call PauseUnit(target,false)
				call UnitAddItemToSlotById(target, LoadInteger(HH, id, StringHash("BrokenItemId")), LoadInteger(HH, id, StringHash("BrokenItemSlot")))
				call PauseUnit(target,true)
			endif
            if GetUnitAbilityLevel(target,'cbc5')>0 then
                call EnableUnitAbility2(target,'AInv',false,true)
            endif
            call FlushChildHashtable(HH, id)
            call DestroyTimer(GetExpiredTimer())
        endif
    endif
        set target=null
endfunction

function AlbedoBreakCond takes unit u,integer i returns boolean
    if GetItemTypeId(UnitItemInSlot(u,i)) != 'Ibrk' and GetItemTypeId(UnitItemInSlot(u,i)) != 'Ibrk' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I13R' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I02Q' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I13V' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I04V' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I03R' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I03S' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I02K'and GetItemTypeId(UnitItemInSlot(u,i)) != 'I13S' and GetItemTypeId(UnitItemInSlot(u,i)) != 'IMDi' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I01R' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I01T' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I02Z' and GetItemTypeId(UnitItemInSlot(u,i)) != 'IPar' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I03M' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I045' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I047' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I04U' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I055' and GetItemTypeId(UnitItemInSlot(u,i)) != 'ISHs' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I02W' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I046' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I054' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I01F' and GetItemTypeId(UnitItemInSlot(u,i)) != 'I039' then
        return true
    else
        return false
    endif
endfunction

function AlbedoEPassive takes unit newSource, unit newTarget, timer newTimer returns nothing
    //local real new_dmg= GetUnitTotalDamage(newSource)
    local integer AlbedoEPassiveCounter= LoadInteger(HH, GetHandleId(newSource), StringHash("AlbedoEPassive"))
    local integer id= GetHandleId(newTimer)
    local integer item_id= 0
    local integer max_iteration= 30
    local integer random_slot= 0
    if AlbedoEPassiveCounter >=4 and UnitIsAlive(newTarget) then
                if IsUnitType(newTarget, UNIT_TYPE_HERO) and IsUnitIllusion(newTarget)==false and GetUnitAbilityLevel(newSource, 'AlEp')>0 and GetUnitTypeId(newTarget)!='H007' and GetUnitTypeId(newTarget)!='Ho13' and GetUnitTypeId(newTarget)!='H34X' then
            loop
            exitwhen max_iteration <= 0
                set max_iteration=max_iteration - 1
                set random_slot=GetRandomInt(0, 5)
                if GetItemTypeId(UnitItemInSlot(newTarget, random_slot)) != 0 and AlbedoBreakCond(newTarget , random_slot) then
                    set item_id=GetItemTypeId(UnitItemInSlot(newTarget, random_slot))
                    call RemoveItem(UnitItemInSlot(newTarget, random_slot))
                    set max_iteration=0
                endif
            endloop
            if item_id != 0 then
                if GetUnitAbilityLevel(newTarget,'cbc5')>0 then
                    call EnableUnitAbility2(newTarget,'AInv',false,true)
                endif
				if IsUnitPaused(newTarget)==false then
					call UnitAddItemToSlotById(newTarget, 'Ibrk', random_slot)
				else
					call PauseUnit(newTarget, false)
					call UnitAddItemToSlotById(newTarget, 'Ibrk', random_slot)
					call PauseUnit(newTarget,true)
				endif
                if GetUnitAbilityLevel(newTarget,'cbc5')>0 then
                    call EnableUnitAbility2(newTarget,'AInv',false,true)
                endif
                                set bj_lastCreatedItem = UnitItemInSlot(newTarget, random_slot)
                                call SetItemDroppable(bj_lastCreatedItem,false)
                                call SaveItemHandle(HH, id, StringHash("BrokenItem"), bj_lastCreatedItem)
                call SaveUnitHandle(HH, id, c_TARGET, newTarget)
                call SaveReal(HH, id, c_TIME, 0)
                call SaveInteger(HH, id, StringHash("BrokenItemSlot"), random_slot)
                call SaveInteger(HH, id, StringHash("BrokenItemId"), item_id)
                call TimerStart(newTimer, 0.05, true, function AlbedoEPass_Periodic)
            //else
                //call BJDebugMsg("Item not found")
            endif
		endif
		// if GetUnitTypeId(newTarget)=='H04A' and GetUnitTypeId(newTarget)=='H04B' then
			// set new_dmg = new_dmg + GetWidgetMaxLife(newTarget)*0.065
		// endif
		//call myCustomDamage(UltimateDamage, newTarget , new_dmg , false , false , null , null , null)
		call SaveInteger(HH, GetHandleId(newSource), StringHash("AlbedoEPassive"), 0)
        call SaveInteger(HH, GetHandleId(newSource), BlockPenetrate, 0)
		set n=CreateUnit(GetOwningPlayer(newSource), 'dH61', GetUnitX(newTarget), GetUnitY(newTarget), GetRandomInt(0, 360))
		call SetUnitFlyHeight(n, 1, 0)
		call MyRemoveUnit(n, 1.5)
	else
		call SaveInteger(HH, GetHandleId(newSource), StringHash("AlbedoEPassive"), AlbedoEPassiveCounter + 1)
	endif
endfunction

function RengokuF_Pass_Cooldown takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local integer id_caster= GetHandleId(LoadUnitHandle(h, id, c_CASTER))
    local real time= LoadReal(HH, id_caster, RengokuF_CD)
    if time > 0 and udg_B and UnitIsAlive(LoadUnitHandle(h, id, c_CASTER)) then
        call SaveReal(HH, id_caster, RengokuF_CD, time - 0.5)
    else
        call SaveReal(HH, id_caster, RengokuF_CD, 0.0)
                call RemoveSavedReal(HH, id_caster, RengokuF_CD)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
endfunction


function RengokuF_Pass_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local integer id_caster= GetHandleId(LoadUnitHandle(h, id, c_CASTER))
    local real time= LoadReal(h, id, c_TIME)
        local unit caster=LoadUnitHandle(h, id, c_CASTER)
    local real caster_hp= GetWidgetLife(caster)
    if caster_hp>0.1 and time<=18 then
        if time < 1 then
                        call SetUnitInvulnerable(caster, true)
                        call PauseUnit(caster, true)
            //call SetUnitState(caster, UNIT_STATE_LIFE, GetWidgetMaxLife(caster) * 0.35)
            set bjLCU=LoadUnitHandle(h, id, c_DUMMY1)
            call SetUnitScale(bjLCU , 1 + time / 2, 1 + time / 2, 1 + time / 2)
            call SetUnitTimeScale(bjLCU , 1 + time / 2)
            call SetUnitX(bjLCU, GetUnitX(caster))
            call SetUnitY(bjLCU, GetUnitY(caster))
            set bjLCU=LoadUnitHandle(h, id, c_DUMMY2)
            call SetUnitScale(bjLCU , 2.5 + time / 2, 2.5 + time / 2, 2.5 + time / 2)
            call SetUnitTimeScale(bjLCU , 1 + time / 2)
            call SetUnitX(bjLCU, GetUnitX(caster))
            call SetUnitY(bjLCU, GetUnitY(caster))
            set bjLCU=LoadUnitHandle(h, id, c_DUMMY3)
            call SetUnitScale(bjLCU , 1.5 + time / 3, 1.5 + time / 3, 1.5 + time / 3)
            call SetUnitTimeScale(bjLCU , 1 + time / 3)
            call SetUnitX(bjLCU, GetUnitX(caster))
            call SetUnitY(bjLCU, GetUnitY(caster))
        endif
        if time == 1 then
            call KillUnit(LoadUnitHandle(h, id, c_DUMMY1))
            call KillUnit(LoadUnitHandle(h, id, c_DUMMY2))
            call KillUnit(LoadUnitHandle(h, id, c_DUMMY3))
                        call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY1), 1.5)
                        call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY2), 1.5)
                        call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY3), 1.5)
            call SetUnitInvulnerable(caster, false)
            call PauseUnit(caster, false)
                        call IssueImmediateOrder(caster, "stop")
                        call UnitRemoveBuffs(caster, false, true)
                        set n=CreateUnit(GetOwningPlayer(caster), 'dR11', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
                        call SetUnitScale(n, 1.85, 1.85, 1.85)
                        call MyRemoveUnit(n, 1.5)
        endif
        set bjLCU=LoadUnitHandle(h, id, c_DUMMY4)
        call SetUnitX(bjLCU, GetUnitX(caster))
                call SetUnitY(bjLCU, GetUnitY(caster))
        call SetUnitFlyHeight(bjLCU, GetUnitFlyHeight(caster) + 10, 0)
        set bjLCU=LoadUnitHandle(h, id, c_DUMMY5)
        call SetUnitX(bjLCU, GetUnitX(caster))
                call SetUnitY(bjLCU, GetUnitY(caster))
        call SetUnitFlyHeight(bjLCU, GetUnitFlyHeight(caster) + 10, 0)
         if GetUnitAbilityLevel(caster, 'B00V') != 0 then //проверки для инвиза (туман)
            if GetUnitAbilityLevel(LoadUnitHandle(h, id, c_DUMMY4), 'A0A1') == 0 then
                call UnitAddAbility(LoadUnitHandle(h, id, c_DUMMY4), 'A0A1')
                call UnitAddAbility(LoadUnitHandle(h, id, c_DUMMY5), 'A0A1')
            endif
        else
            if GetUnitAbilityLevel(LoadUnitHandle(h, id, c_DUMMY4), 'A0A1') == 1 then
                call UnitRemoveAbility(LoadUnitHandle(h, id, c_DUMMY4), 'A0A1')
                call UnitRemoveAbility(LoadUnitHandle(h, id, c_DUMMY5), 'A0A1')
            endif
        endif
        if time < 1.1 then
            call SaveReal(h, id, c_TIME, time + 0.02)
        else
            if IsUnitPaused(caster) == false then
                call SaveReal(h, id, c_TIME, time + 0.02)
            endif
        endif
    else
        call SetHeroStr(caster, GetHeroStr(caster, false) - 20, false)
        call SetHeroAgi(caster, GetHeroAgi(caster, false) - 20, false)
        call SetHeroInt(caster, GetHeroInt(caster, false) - 20, false)
        call UnitRemoveAbility(caster, 'ReFa')
        call UnitRemoveAbility(caster, 'ReFm')
                if caster_hp>GetWidgetMaxLife(caster) then
                        call SetWidgetLife(caster, GetWidgetMaxLife(caster))
                else
                        call SetWidgetLife(caster, caster_hp)
                endif
        call KillUnit(LoadUnitHandle(h, id, c_DUMMY4))
        call KillUnit(LoadUnitHandle(h, id, c_DUMMY5))
        call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY4) , 1.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY5) , 1.5)
        call SaveBoolean(HH, id_caster, RengokuF_Pass, false)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
        set caster=null
endfunction

function RengokuF_Pass_Act takes unit newCaster,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local integer id_caster= GetHandleId(newCaster)
    local real caster_x= GetUnitX(newCaster)
    local real caster_y= GetUnitY(newCaster)
        set soundplay=CreateSound("Sound\\war3mapImported\\RengokuF1.mp3", false, false, true, 12700, 12700, "")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        set soundplay=CreateSound("Sound\\war3mapImported\\RengokuF2.mp3", false, false, true, 12700, 12700, "")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR15', caster_x, caster_y, GetRandomInt(0, 360))
    call SaveUnitHandle(h, id, c_DUMMY1, bjLCU)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dRe9', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(bjLCU, 2.5, 2.5, 2.5)
    call SaveUnitHandle(h, id, c_DUMMY2, bjLCU)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dRe9', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
    call SaveUnitHandle(h, id, c_DUMMY3, bjLCU)
    
        // set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR96', caster_x, caster_y, GetRandomInt(0, 360))
        // call SetUnitScale(bjLCU, 1.25, 1.25, 1.25) 
        // call SetUnitTimeScale(bjLCU, 0.65)
        // call SetUnitFlyHeight(bjLCU, 120, 0)
        // call MyRemoveUnit(bjLCU, 1.5)
        // set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR34', caster_x, caster_y, GetRandomInt(0, 360))
        // call MyRemoveUnit(bjLCU, 1.5)
        // set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dH62', caster_x, caster_y, GetRandomInt(0, 360))
        // call SetUnitScale(bjLCU, 2, 2, 2) 
        // call SetUnitFlyHeight(bjLCU, 25, 0)
        // call MyRemoveUnit(bjLCU, 1.5)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dRe9', caster_x, caster_y, GetRandomInt(0, 360))
    call SetUnitScale(bjLCU, 2.35, 2.35, 2.35)
        call SetUnitAnimationByIndex(bjLCU, 0)
    call SaveUnitHandle(h, id, c_DUMMY4, bjLCU)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dRe9', caster_x, caster_y, GetRandomInt(0, 360))
    call SetUnitScale(bjLCU, 1.35, 1.35, 1.35)
        call SetUnitAnimationByIndex(bjLCU, 0)
    call SaveUnitHandle(h, id, c_DUMMY5, bjLCU)
    
    call ShakeCamera(0.3 , 30)
    call SetHeroStr(newCaster, GetHeroStr(newCaster, false) + 20, false)
    call SetHeroAgi(newCaster, GetHeroAgi(newCaster, false) + 20, false)
    call SetHeroInt(newCaster, GetHeroInt(newCaster, false) + 20, false)
    call UnitAddAbility(newCaster, 'ReFa')
    call UnitAddAbility(newCaster, 'ReFm')
    call SetUnitAnimationByIndex(newCaster, 10)
    call UnitRemoveBuffs(newCaster, false, true)
    call SetUnitInvulnerable(newCaster, true)
    call PauseUnit(newCaster, true)
    call HealTextTag(newCaster,newCaster,((GetWidgetMaxLife(newCaster) * 0.20)-GetWidgetLife(newCaster))*myCustomHeal2(newCaster,1),"HealthRes")
    call SetWidgetLife(newCaster, GetWidgetMaxLife(newCaster)*0.20)
    call SaveUnitHandle(h, id, c_CASTER, newCaster)
    call SaveBoolean(HH, id_caster, RengokuF_Pass, true)
    call SaveReal(HH, id_caster, RengokuF_CD, 200) //CD
    call CreateModeIndicatorForm(newCaster, "ReplaceableTextures\\CommandButtons\\BTNRengokuF.blp", 200)
    call TimerStart(newTimer, 0.02, true, function RengokuF_Pass_Periodic)
    set newTimer=null
    set newTimer=CreateTimer()
    set id=GetHandleId(newTimer)
    call SaveUnitHandle(h, id, c_CASTER, newCaster)
    call TimerStart(newTimer, 0.5, true, function RengokuF_Pass_Cooldown)
        set newTimer=null
endfunction


//===========================================================================
// Trigger: MadokaDamage
//===========================================================================

function MadokaF1_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local unit caster=LoadUnitHandle(h, id, CasterHash)
    local real time=LoadReal(h, id, TIME_HASH)
    if time < 8.0 then
        call SaveReal(h, id, TIME_HASH, time + 0.1)
        call PauseUnit(caster, true)
        call SetUnitInvulnerable(caster, true)
                call SetWidgetLife(caster, GetWidgetMaxLife(caster)*0.5)
        call SetUnitX(LoadUnitHandle(h, id, Dummy2Hash), GetUnitX(caster))
        call SetUnitY(LoadUnitHandle(h, id, Dummy2Hash), GetUnitY(caster))
        if time < 3.0 then
            set n=CreateUnit(GetOwningPlayer(caster), 'dM42', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
            call SetUnitScale(n, 1.0 + time * 0.8, 1.0 + time * 0.8, 1.0 + time * 0.8)
            call SetUnitVertexColor(n, 255, 255, 255, 100)
            call SetUnitFlyHeight(n, 10, 0)
            call MyRemoveUnit(n , 1.5)
        endif
        if time == 3.0 then
            call SetTerrainFogExBJ(0, 0.00, 9000, 0, 0.1, 0.1, 0.7)
            call ShakeCamera(0.2 , 5)
            set n=CreateUnit(GetOwningPlayer(caster), 'dM54', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
            call SetUnitScale(n, 1.8, 1.8, 1.8)
            call SetUnitFlyHeight(n, 150, 0)
            call SetUnitTimeScale(n, 0.6)
            call MyRemoveUnit(n , 2.5)
            set n=CreateUnit(GetOwningPlayer(caster), 'dM55', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
            call SetUnitScale(n, 1.8, 1.8, 1.8)
            call MyRemoveUnit(n , 2.5)
        endif
        if time == 4.0 then
            call ShakeCamera(4 , 10)
            set soundplay=CreateSound("Sound\\war3mapImported\\MadokaF1_Sound1.mp3", false, false, true, 12700, 12700, "")
            call StartSound(soundplay)
            call KillSoundWhenDone(soundplay)
            call KillUnit(LoadUnitHandle(h, id, Dummy2Hash))
            call MyRemoveUnit(LoadUnitHandle(h, id, Dummy2Hash) , 1.5)
            set n=CreateUnit(GetOwningPlayer(caster), 'dM56', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
            call SetUnitScale(n, 3.2, 3.2, 3.2)
            call SaveUnitHandle(h, id, Dummy2Hash, n)
        endif
        if time > 4.0 then
            set bjLCG=LoadGroupHandle(h, id, GroupHash)
            call GroupEnumUnitsInRange(bjLCG, GetUnitX(caster), GetUnitY(caster), 1300, Base)
            loop
            set E=FirstOfGroup(bjLCG)
            exitwhen E == null
                if E!=caster then
                    call myCustomDamage(caster , E , GetWidgetMaxLife(caster) * 0.03125 , false , false , null , null , null)
                    if SquareRootUnit(E,caster)>150 then
                        call Push3(E,30,AU(E,caster),50,"")
                    endif
                endif
                call GroupRemoveUnit(bjLCG, E)
            endloop
        endif
    else
        call SetTerrainFogExBJ(0,6000.00,10000,0,1,1,1)
        call SetUnitTimeScale(LoadUnitHandle(h, id, Dummy2Hash), 0.5)
        call KillUnit(LoadUnitHandle(h, id, Dummy1Hash))
        call KillUnit(LoadUnitHandle(h, id, Dummy2Hash))
        call MyRemoveUnit(LoadUnitHandle(h, id, Dummy1Hash) , 1.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, Dummy2Hash) , 1.5)
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call SetUnitTargetable(caster, true)
        call UnitRemoveAbility(caster,'A0QL')
        call UnitRemoveBuffs(caster, false, true)
        call UnitRemoveAbility(caster, 'MaF5')
        if udg_B then
            call UnitAddAbility(caster, 'MaF2')
            call UnitAddAbility(caster, 'A0WR')
            call myCustomDamage(LoadUnitHandle(h, id, StringHash("Source")) , caster , 99999 , false , false , null , null , null)
            call UnitRemoveAbility(caster, 'MaF2')
            call UnitRemoveAbility(caster, 'A0WR')
        endif
        call DestroyGroup(LoadGroupHandle(h, id, GroupHash))
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
endfunction

function MadokaF1_Cast takes unit newCaster,unit newSource,timer newTimer returns nothing
    local integer id=GetHandleId(newTimer)
    set soundplay=CreateSound("Sound\\war3mapImported\\MadokaF1_Voice1.mp3", false, false, true, 12700, 12700, "")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    set soundplay=CreateSound("Sound\\war3mapImported\\MadokaF1_Sound2.mp3", false, false, true, 12700, 12700, "")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM32', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    call SetUnitScale(n, 1.9, 1.9, 1.9)
    call SetUnitVertexColor(n, 255, 255, 255, 150)
    call SaveUnitHandle(h, id, Dummy1Hash, n)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM53', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    call UnitScale(n , 0.5 , 1.5 , 4)
    call SetUnitFlyHeight(n, 50, 0)
        call UnitAddAbility(newCaster, 'MaF5')
    call SaveUnitHandle(h, id, Dummy2Hash, n)
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call SaveUnitHandle(h, id, StringHash("Source"), newSource)
    call SaveGroupHandle(h, id, GroupHash, CreateGroup())
    call TimerStart(newTimer, 0.1, true, function MadokaF1_Periodic)
endfunction

function MadokaF2_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local unit caster=LoadUnitHandle(h, id, CasterHash)
    local real time=LoadReal(h, id, TIME_HASH)
    if udg_B then
        if time<0.5 then
            call PauseUnit(caster, true)
            call SetUnitInvulnerable(caster, true)
        endif
        call SaveReal(h, id, TIME_HASH, time + 0.1)
        set bjLCG=LoadGroupHandle(h, id, GroupHash)
        call GroupEnumUnitsInRect(bjLCG, bj_mapInitialPlayableArea, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E == null
            if IsUnitAlly(E, GetOwningPlayer(caster)) and UnitIsAlive(E) then
                call HealTextTag(E,E,GetWidgetMaxLife(caster) * 0.001*myCustomHeal2(E,1),"HealthRes")
                call SetWidgetLife(E, GetWidgetLife(E) + GetWidgetMaxLife(caster) * 0.001)
            endif
            call GroupRemoveUnit(bjLCG, E)
        endloop
                if time==0.5 then
                        call PauseUnit(caster, false)
                        call SetUnitInvulnerable(caster, false)
                        call UnitRemoveBuffs(caster, false, true)
                        call SetUnitTargetable(caster, true)
                        call UnitRemoveAbility(caster,'A0QL')
                        call UnitAddAbility(caster, 'MaF2')
                        call UnitAddAbility(caster, 'A0WR')
                        call myCustomDamage(LoadUnitHandle(h, id, StringHash("Source")) , caster , 99999 , false , false , null , null , null)
                        call UnitRemoveAbility(caster, 'MaF2')
                        call UnitRemoveAbility(caster, 'A0WR')
                endif
        if time == 4.0 then
            set soundplay=CreateSound("Sound\\war3mapImported\\MadokaF2_Sound.mp3", false, false, true, 12700, 12700, "")
            call StartSound(soundplay)
            call KillSoundWhenDone(soundplay)
        endif
    else
        call DestroyGroup(LoadGroupHandle(h, id, GroupHash))
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
endfunction

function MadokaF2_Cast takes unit newCaster,unit newSource,timer newTimer returns nothing
    local integer id=GetHandleId(newTimer)
    set soundplay=CreateSound("Sound\\war3mapImported\\MadokaF2_Voice.mp3", false, false, true, 12700, 12700, "")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    call SetTerrainFogExBJ(0,6000.00,10000,0,1,1,1)

    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM66', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    call UnitScale(n , 0.5 , 3 , 1)
    call UnitApplyTimedLife(n, 1, 4)
    call MyRemoveUnit(n , 6)
    call RemoveEffect(AddSpecialEffectTarget("az_20200523153.mdl", newCaster, "origin") , 1 , true , CreateTimer())
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call SaveUnitHandle(h, id, StringHash("Source"), newSource)
    call SaveGroupHandle(h, id, GroupHash, CreateGroup())
    call TimerStart(newTimer, 0.1, true, function MadokaF2_Periodic)
endfunction

function MadokaF3_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local unit caster=LoadUnitHandle(h, id, CasterHash)
    local unit dummy0=LoadUnitHandle(h, id, StringHash("Dummy0"))
    local real time=LoadReal(h, id, TIME_HASH)
    if time < 10.0 then
        call SaveReal(h, id, TIME_HASH, time + 0.1)
        call SetWidgetLife(caster, GetWidgetMaxLife(caster))
        call SetWidgetMana(caster, GetWidgetMaxMana(caster))
        call PauseUnit(caster, true)
        call SetUnitInvulnerable(caster, true)
        call SetUnitX(dummy0, GetUnitX(caster) + 300 * Cos(LoadReal(h, id, AngleHash)))
        call SetUnitY(dummy0, GetUnitY(caster) + 300 * Sin(LoadReal(h, id, AngleHash)))
                call SetUnitX(LoadUnitHandle(h, id, Dummy1Hash), GetUnitX(caster))
        call SetUnitY(LoadUnitHandle(h, id, Dummy1Hash), GetUnitY(caster))
                call SetUnitX(LoadUnitHandle(h, id, Dummy2Hash), GetUnitX(caster))
        call SetUnitY(LoadUnitHandle(h, id, Dummy2Hash), GetUnitY(caster))
                call SetUnitX(LoadUnitHandle(h, id, StringHash("Dummy4")), GetUnitX(caster))
        call SetUnitY(LoadUnitHandle(h, id, StringHash("Dummy4")), GetUnitY(caster))
        call SetUnitFacing(dummy0, AU(dummy0 , caster) * bj_RADTODEG)
        if time < 3.5 then
            set n=CreateUnit(GetOwningPlayer(caster), 'dM42', GetUnitX(dummy0), GetUnitY(dummy0), GetRandomInt(0, 360))
            call SetUnitScale(n, 0.5 + time * 0.8, 0.5 + time * 0.8, 0.5 + time * 0.8)
            call SetUnitVertexColor(n, 255, 255, 255, 50)
            call SetUnitFlyHeight(n, 10, 0)
            call MyRemoveUnit(n , 1.5)
        endif
        if time == 4.0 then
            call ShakeCamera(0.2 , 5)
            set n=CreateUnit(GetOwningPlayer(caster), 'dM60', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
            call UnitScale(n , 2 , 8 , 4)
            call SetUnitFlyHeight(n, 0, 0)
            call SetUnitTimeScale(n, 0.6)
            call UnitApplyTimedLife(n, 1, 4.0)
            call MyRemoveUnit(n , 6.0)
            set n=CreateUnit(GetOwningPlayer(caster), 'dM55', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
            call SetUnitScale(n, 1.8, 1.8, 1.8)
            call MyRemoveUnit(n , 2.5)
        endif
        if time == 4.0 then
            call ShakeCamera(3.5 , 10)
            set n=CreateUnit(GetOwningPlayer(caster), 'dM65', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
            call UnitScale(n , 1 , 3.8 , 3)
            call SaveUnitHandle(h, id, StringHash("Dummy3"), n)
        endif
        if time == 5.0 then
                        set soundplay=CreateSound("Sound\\war3mapImported\\MadokaF3_Sound"+I2S(GetRandomInt(0,1))+".mp3", false, false, true, 12700, 12700, "")
            call StartSound(soundplay)
            call KillSoundWhenDone(soundplay)
            call UnitScale(LoadUnitHandle(h, id, StringHash("Dummy4")) , 0.7 , 2.1 , 2.2)
        endif
    else
        call CinematicFadeBJCustom(bj_CINEFADETYPE_FADEIN, 0.5, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 125, 185, 255, 0)
        set n=CreateUnit(GetOwningPlayer(caster), 'dM62', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
        call UnitScale(n , 3 , 6 , 1)
        call SetUnitTimeScale(n, 0.7)
        call MyRemoveUnit(n , 2.7)
        set n=CreateUnit(GetOwningPlayer(caster), 'dM71', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
        call SetUnitScale(n, 0.7, 0.7, 0.7)
        call SetUnitTimeScale(n, 0.7)
        call MyRemoveUnit(n , 3.5)
        call ShakeCamera(0.2 , 25)
        call SetTerrainFogExBJ(0,6000.00,10000,0,1,1,1)
        call SetUnitTimeScale(LoadUnitHandle(h, id, Dummy2Hash), 0.5)
        call KillUnit(LoadUnitHandle(h, id, Dummy1Hash))
        call KillUnit(LoadUnitHandle(h, id, Dummy2Hash))
        call KillUnit(LoadUnitHandle(h, id, StringHash("Dummy3")))
        call KillUnit(LoadUnitHandle(h, id, StringHash("Dummy4")))
                call UnitRemoveAbility(dummy0, 'A16C')
        call MyRemoveUnit(LoadUnitHandle(h, id, Dummy1Hash) , 1.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, Dummy2Hash) , 1.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, StringHash("Dummy3")) , 1.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, StringHash("Dummy4")) , 1.5)
                if UnitIsAlive(caster)==false then
                        call ReviveHero(caster, GetUnitX(caster),GetUnitY(caster), false)
                endif
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call SetUnitState(caster,UNIT_STATE_LIFE,1)
        call SetUnitState(caster,UNIT_STATE_MANA,1)
        call HealTextTag(caster,caster,GetWidgetMaxLife(caster) * 0.35*myCustomHeal2(caster,1),"HealthRes")
        call HealTextTag(caster,caster,GetWidgetMaxLife(caster) * 0.35*myCustomMana2(caster,1),"ManaRes")
		call SetWidgetLife(caster, GetWidgetMaxLife(caster)*0.35)
		call SetWidgetMana(caster, GetWidgetMaxMana(caster)*0.35)
		call UnitRemoveBuffs(caster, false, true)
		if udg_B then
			call UnitAddAbility(caster, 'MaF3')
			call IssueImmediateOrder(caster, "bearform")
			call UnitRemoveAbility(caster, 'MaF3')
			if GetHeroLevel(caster) >= 25 then
				call ShowAbility2( 'MaT1' , false)
				call UnitAddAbility(caster, 'MaT2')
			endif
			call UnitAddAbility(caster, 'MaE2')
			call UnitAddAbility(caster, 'MaR2')
			call ShowAbility2( 'MaE1' , false)
			call ShowAbility2( 'MadR' , false)
		endif
        call SetUnitTargetable(caster, true)
        call UnitRemoveAbility(caster,'A0QL')
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set dummy0=null
    set caster=null
endfunction

function MadokaF3_Cast takes unit newCaster,unit newSource,timer newTimer returns nothing
    local integer id=GetHandleId(newTimer)
    local real angle=GetUnitFacing(newCaster) * bj_DEGTORAD
        if GetRandomInt(0,1)==0 or GetPlayerName(GetOwningPlayer(newCaster))=="Uriska" then
                set soundplay=CreateSound("Sound\\war3mapImported\\MadokaF3_Voice2.mp3", false, false, true, 12700, 12700, "")
        else
                set soundplay=CreateSound("Sound\\war3mapImported\\MadokaF3_Voice1.mp3", false, false, true, 12700, 12700, "")
        endif
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        
        call UnitAddAbility(LoadUnitHandle(HH,GetPlayerId(GetOwningPlayer(newCaster)),StringHash("kyubei")), 'A16C')
    call SaveUnitHandle(h, id, StringHash("Dummy0"), LoadUnitHandle(HH,GetPlayerId(GetOwningPlayer(newCaster)),StringHash("kyubei")))
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM32', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    call SetUnitScale(n, 1.9, 1.9, 1.9)
    call SetUnitVertexColor(n, 255, 255, 255, 150)
    call SaveUnitHandle(h, id, Dummy1Hash, n)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM58', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    call UnitScale(n , 0.5 , 3.0 , 4)
    call SetUnitFlyHeight(n, 50, 0)
    call SaveUnitHandle(h, id, Dummy2Hash, n)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM61', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    //call UnitScale(n, 0.5, 3.0, 4)
    call SetUnitScale(n, 0.7, 0.7, 0.7)
    call SetUnitFlyHeight(n, 50, 0)
    call SaveUnitHandle(h, id, StringHash("Dummy4"), n)
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call SaveUnitHandle(h, id, StringHash("Source"), newSource)
    call SaveReal(h, id, AngleHash, angle)
    call TimerStart(newTimer, 0.1, true, function MadokaF3_Periodic)
endfunction


function MadokaF4_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local unit caster=LoadUnitHandle(h, id, CasterHash)
    local unit target=LoadUnitHandle(h, id, TargetHash)
    local real time=LoadReal(h, id, TIME_HASH)
    if time < 5.0 then
                call SetWidgetLife(caster, GetWidgetMaxLife(caster)*0.5)
        call SaveReal(h, id, TIME_HASH, time + 0.1)
        call PauseUnit(caster, true)
        call SetUnitInvulnerable(caster, true)
        if time < 3.0 then
            set n=CreateUnit(GetOwningPlayer(caster), 'dM42', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
            call SetUnitScale(n, 1.0 + time * 0.8, 1.0 + time * 0.8, 1.0 + time * 0.8)
            call SetUnitVertexColor(n, 255, 255, 255, 100)
            call SetUnitFlyHeight(n, 10, 0)
            call MyRemoveUnit(n , 1.5)
        endif
        if time == 3.0 then
            call ShakeCamera(0.2 , 5)
            set n=CreateUnit(GetOwningPlayer(caster), 'dM62', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
            call SetUnitScale(n, 1.8, 1.8, 1.8)
            call SetUnitFlyHeight(n, 150, 0)
            call SetUnitTimeScale(n, 0.6)
            call MyRemoveUnit(n , 2.5)
        endif
        if time == 4.0 then
            call ShakeCamera(0.2 , 10)
        endif
    else
        set soundplay=CreateSound("Sound\\war3mapImported\\MadokaF4_Sound1.mp3", false, false, true, 12700, 12700, "")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        call ReviveHero(target, GetUnitX(target), GetUnitY(target), true)
        call UnitRemoveBuffs(target, false, true)
        call SetUnitState(target,UNIT_STATE_LIFE,1)
        call SetUnitState(target,UNIT_STATE_MANA,1)
        call HealTextTag(target,target,GetWidgetMaxLife(target) * 0.5*myCustomHeal2(target,1),"HealthRes")
        call HealTextTag(target,target,GetWidgetMaxLife(target) * 0.5*myCustomMana2(target,1),"ManaRes")
        call SetWidgetLife(target, GetWidgetMaxLife(target)*0.5)
        call SetWidgetMana(target, GetWidgetMaxMana(target)*0.5)
        if GetOwningPlayer(target)==GetLocalPlayer()then
                call SetCameraPosition(GetUnitX(target),GetUnitY(target))
        endif

        call RemoveEffect(AddSpecialEffectTarget("FS (19).mdl", target, "origin") , 1.5 , true , CreateTimer())
        set n=CreateUnit(GetOwningPlayer(caster), 'dM70', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
        call SetUnitTimeScale(n, 0.6)
        call UnitApplyTimedLife(n, 1, 1.5)
        call MyRemoveUnit(n , 2.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'dM70', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
        call SetUnitScale(n, 0.5, 0.5, 0.5)
        call SetUnitTimeScale(n, 0.6)
        call UnitApplyTimedLife(n, 1, 1.5)
        call MyRemoveUnit(n , 2.5)
        
        call SetTerrainFogExBJ(0,6000.00,10000,0,1,1,1)
        call KillUnit(LoadUnitHandle(h, id, Dummy1Hash))
        call KillUnit(LoadUnitHandle(h, id, Dummy2Hash))
        call KillUnit(LoadUnitHandle(h, id, StringHash("Dummy3")))
        call MyRemoveUnit(LoadUnitHandle(h, id, Dummy1Hash) , 1.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, Dummy2Hash) , 1.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, StringHash("Dummy3")) , 1.5)
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call UnitRemoveAbility(caster,'A0QL')
        call SetUnitTargetable(caster, true)
        call UnitRemoveBuffs(caster, false, true)
        if udg_B then
            call UnitAddAbility(caster, 'MaF2')
            call UnitAddAbility(caster, 'A0WR')
            call myCustomDamage(LoadUnitHandle(h, id, StringHash("Source")) , caster , 99999 , false , false , null , null , null)
            call UnitRemoveAbility(caster, 'MaF2')
            call UnitRemoveAbility(caster, 'A0WR')
        endif
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
    set target=null
endfunction

function MadokaF4_Cast takes unit newCaster,unit newSource,unit newTarget,timer newTimer returns nothing
    local integer id=GetHandleId(newTimer)
    local real angle=GetUnitFacing(newCaster) * bj_DEGTORAD
    local integer idu=GetPlayerId(GetOwningPlayer(newCaster))
    local integer i=0
    set soundplay=CreateSound("Sound\\war3mapImported\\MadokaF4_Voice1.mp3", false, false, true, 12700, 12700, "")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM66', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    call UnitScale(n , 0.5 , 3 , 1)
    call UnitApplyTimedLife(n, 1, 4)
    call MyRemoveUnit(n , 6)
    call RemoveEffect(AddSpecialEffectTarget("az_20200523153.mdl", newCaster, "origin") , 1 , true , CreateTimer())
            set n=CreateUnit(GetOwningPlayer(newCaster), 'dM67', GetUnitX(newTarget), GetUnitY(newTarget), GetRandomInt(0, 360))
            call SaveUnitHandle(h, id, Dummy2Hash, n)
            set n=CreateUnit(GetOwningPlayer(newCaster), 'dM68', GetUnitX(newTarget), GetUnitY(newTarget), GetRandomInt(0, 360))
            call SaveUnitHandle(h, id, StringHash("Dummy3"), n)
                        set n=CreateUnit(Player(0), 'dAlb', GetUnitX(newTarget), GetUnitY(newTarget), GetRandomInt(0, 360))
                        call MyRemoveUnit(n, 5.5)
                        set n=CreateUnit(Player(5), 'dAlb', GetUnitX(newTarget), GetUnitY(newTarget), GetRandomInt(0, 360))
                        call MyRemoveUnit(n, 5.5)
    call SaveUnitHandle(h, id, TargetHash, newTarget)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM69', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    call UnitScale(n , 0.5 , 1.5 , 4)
    call SetUnitFlyHeight(n, 50, 0)
    call SaveUnitHandle(h, id, Dummy1Hash, n)
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call SaveUnitHandle(h, id, StringHash("Source"), newSource)
    call TimerStart(newTimer, 0.1, true, function MadokaF4_Periodic)
endfunction

function MadokaF_Death takes unit newCaster,unit newSource returns nothing
    local unit newRevive=null
    local integer idu=GetPlayerId(GetOwningPlayer(newCaster))
    local integer i=0
    local integer random_i=0
    local integer idut
    if newSource==null then
            set newSource=newCaster
    endif
    if FFAMode==false then
        if idu >= 0 and idu <= 4 then
            set idut=1
        elseif idu >= 5 and idu <= 9 then
            set idut=2
        endif
    endif
    call SetUnitTargetable(newCaster, false)
    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
    call UnitAddAbility(newCaster,'A0QL')
    call SetUnitAnimationByIndex(newCaster, 10)
    call SetWidgetLife(newCaster, GetWidgetMaxLife(newCaster) * 0.5)
    if LoadInteger(HH,GetHandleId(newCaster),MadokaMHash)==0 then
        call MadokaF1_Cast(newCaster , newSource , CreateTimer())
    elseif LoadInteger(HH,GetHandleId(newCaster),MadokaMHash)==3 then
        call MadokaF3_Cast(newCaster , newSource , CreateTimer())
    elseif LoadInteger(HH,GetHandleId(newCaster),MadokaMHash)==1 then
        if GroupAlive(udg_CG[idut])!=1 and FFAMode==false then
            call MadokaF2_Cast(newCaster , newSource , CreateTimer())
        else
            call MadokaF1_Cast(newCaster , newSource , CreateTimer())
        endif
    elseif LoadInteger(HH,GetHandleId(newCaster),MadokaMHash)==2 then
        if idu >= 0 and idu <= 4 then
            set i=0
            loop
            exitwhen i >= 10
                set random_i=GetRandomInt(0, 4)
                if Hero[random_i] != newCaster and UnitIsAlive(Hero[random_i]) == false and Hero[random_i] != null then
                    set newRevive=Hero[random_i]
                    set i=11
                endif
                set i=i + 1
            endloop
        elseif idu >= 5 and idu <= 9 then
            set i=0
            loop
            exitwhen i >= 10
                set random_i=GetRandomInt(5, 9)
                if Hero[random_i] != newCaster and UnitIsAlive(Hero[random_i]) == false and Hero[random_i] != null then
                    set newRevive=Hero[random_i]
                    set i=11
                endif
                set i=i + 1
            endloop
        endif
        if newRevive != null and FFAMode==false then
            call MadokaF4_Cast(newCaster , newSource , newRevive , CreateTimer())
        else
            if GroupAlive(udg_CG[idut])!=1 and FFAMode==false then
                call MadokaF2_Cast(newCaster , newSource , CreateTimer())
            else
                call MadokaF1_Cast(newCaster , newSource , CreateTimer())
            endif
        endif
    endif
    set newRevive=null
endfunction

function GaeDearg_Passive_Periodic takes nothing returns nothing
        local integer id = GetHandleId(GetExpiredTimer())
        local integer id_caster = GetHandleId(LoadUnitHandle(h, id, CasterHash))
    call SaveInteger(HH, id_caster, StringHash("GaeDeargP_CD"), 1)
    call FlushChildHashtable(h, id)
    call DestroyTimer(GetExpiredTimer())
endfunction

function GaeDearg_Passive takes unit newCaster returns nothing
    local timer t=CreateTimer()
        call SaveUnitHandle(h, GetHandleId(t), CasterHash, newCaster)
        call TimerStart(t, 10, false, function GaeDearg_Passive_Periodic)
        set t=null
endfunction

function AnbuSet_CD takes nothing returns nothing 
        local integer id=GetHandleId(GetExpiredTimer())
        local integer id_caster=GetHandleId(LoadUnitHandle(h, id, 0))
        if LoadInteger(h, id_caster, StringHash("AnbuSet_CD"))>0 and udg_B then
                call SaveInteger(h, id_caster, StringHash("AnbuSet_CD"), LoadInteger(h, id_caster, StringHash("AnbuSet_CD"))-1)
        else
                call SaveInteger(h, id_caster, StringHash("AnbuSet_CD"), 0)
                call RemoveSavedInteger(h, id_caster, StringHash("AnbuSet_CD"))
                call FlushChildHashtable(h, id)
                call DestroyTimer(GetExpiredTimer())
        endif
endfunction

function AnbuSet_Action takes nothing returns nothing
        local integer id=GetHandleId(GetExpiredTimer())
        local real x=GetUnitX(LoadUnitHandle(h, id, CasterHash))
        local real y=GetUnitY(LoadUnitHandle(h, id, CasterHash))
        //call ShowUnit(LoadUnitHandle(h, id, CasterHash), true)
        //call PauseUnit(LoadUnitHandle(h, id, CasterHash), false)
        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)),'h019',x,y,GetRandomReal(0,359))
        call UnitAddAbility(n,'A0TT')
        call UnitApplyTimedLife(n,1,2)
        call IssueTargetOrder(n,"invisibility",LoadUnitHandle(h, id, CasterHash))
        call SetUnitX(LoadUnitHandle(h, id, CasterHash),x+300*Cos(GetRandomReal(0,6.28)))
        call SetUnitY(LoadUnitHandle(h, id, CasterHash),y+300*Sin(GetRandomReal(0,6.28)))
        call UnitRemoveBuffs(LoadUnitHandle(h, id, CasterHash), false, true)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
endfunction

function Minato_RasenganPush takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local real distance=LoadReal(h, id, StringHash("Distance"))
    local real speed=LoadReal(h, id, StringHash("Speed"))
    local real angle=LoadReal(h, id, AngleHash)
    if distance > 0 then
        if LoadReal(h, id, TIME_HASH) > 0.2 then
            call SaveReal(h, id, StringHash("Speed"), speed - speed * 0.03)
            call SaveReal(h, id, StringHash("Distance"), distance - speed)
            set bjLCU=LoadUnitHandle(h, id, TargetHash)
            call SetUnitX(bjLCU, GetUnitX(bjLCU) + speed * Cos(angle))
            call SetUnitY(bjLCU, GetUnitY(bjLCU) + speed * Sin(angle))
            if LoadInteger(h, id, EffectPeriodHash) >= LoadInteger(h, id, StringHash("MaxEffPeriod")) then
                set E=CreateUnit(GetOwningPlayer(bjLCU), 'dM11', GetUnitX(bjLCU), GetUnitY(bjLCU), angle * bj_RADTODEG)
                call SetUnitFlyHeight(E, 150, 0)
                call SetUnitScale(E, 0.7, 0.7, 0.7)
                call SetUnitTimeScale(E, 0.5)
                call SetUnitVertexColor(E, 255, 255, 255, 150)
                call MyRemoveUnit(E , 1.0)
                set E=CreateUnit(GetOwningPlayer(bjLCU), 'dM20', GetUnitX(bjLCU), GetUnitY(bjLCU), angle * bj_RADTODEG)
                call SetUnitScale(E, 1.2, 1.2, 1.2)
                call MyRemoveUnit(E , 1.0)
                call SaveInteger(h, id, EffectPeriodHash, 2)
            endif
            call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash) + 1)
        else
            call SaveReal(h, id, TIME_HASH, LoadReal(h, id, TIME_HASH) + 0.03)
            call SetUnitScale(LoadUnitHandle(h, id, StringHash("Rasengan")), 60 * LoadReal(h, id, TIME_HASH), 60 * LoadReal(h, id, TIME_HASH), 60 * LoadReal(h, id, TIME_HASH))
        endif
    else
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
endfunction

function MinatoRemoveRasengan takes unit newCaster returns nothing
    local integer id_caster=GetHandleId(newCaster)
    call UnitRemoveAbility(newCaster, 'MiW1')
    call UnitRemoveAbility(newCaster, 'MiW2')
    call SaveReal(h, id_caster, StringHash("MinatoW_Damage"), 0.0)
        call RemoveSavedHandle(h, id_caster, StringHash("MinatoW_Damage"))
    call DestroyEffect(LoadEffectHandle(h, id_caster, StringHash("MinatoW_Eff")))
    call RemoveSavedHandle(h, id_caster, StringHash("MinatoW_Eff"))
    if GetUnitAbilityLevel(newCaster, 'MiQ3') >= 1 then
        call UnitRemoveAbility(newCaster, 'MiQ3')
    endif
endfunction

function Minato_BaseRasengan takes unit newCaster,unit newTarget,real dop_damage,real speed,real distance,timer newTimer returns nothing
    local integer id_caster= GetHandleId(newCaster)
    local real damage= LoadReal(h, id_caster, StringHash("MinatoW_Damage")) + dop_damage
    local real angle= AU(newCaster , newTarget)
    call myCustomDamage(newCaster , newTarget , damage , false , false , null , null , null)
    call SetControlToUnit(newCaster , newTarget , 1.5 , "stun")
    call ShakeCamera(0.2 , 10)
    set bjLCT=CreateTimer()

    set soundplay=CreateSound("Sound\\war3mapImported\\Minato_Rasengan_Hit.mp3", false, false, true, 12700, 12700, "")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
        
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM04', GetUnitX(newCaster), GetUnitY(newCaster), angle * bj_RADTODEG)
    call SetUnitFlyHeight(n, 150, 0)
    call SetUnitTimeScale(n, 0.6)
    call SetUnitVertexColor(n, 255, 255, 255, 185)
    call MyRemoveUnit(n , 2.5)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM13', GetUnitX(newCaster) + 200 * Cos(angle), GetUnitY(newCaster) + 200 * Sin(angle), GetRandomInt(0, 360))
    call SetUnitScale(n, 3, 3, 3)
    call SetUnitTimeScale(n, 0.50)
    call SetUnitFlyHeight(n, 200, 0)
    call SetUnitAnimation(n, "Birth")
        call UnitApplyTimedLife(n, 1, 0.5)
    call MyRemoveUnit(n , 0.5)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM13', GetUnitX(newCaster) + 200 * Cos(angle), GetUnitY(newCaster) + 200 * Sin(angle), GetRandomInt(0, 360))
    call SetUnitScale(n, 5, 5, 5)
    call SetUnitTimeScale(n, 0.50)
    call SetUnitFlyHeight(n, 200, 0)
    call SetUnitAnimation(n, "Birth")
        call UnitApplyTimedLife(n, 1, 0.5)
    call MyRemoveUnit(n , 0.5)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM13', GetUnitX(newCaster) + 200 * Cos(angle), GetUnitY(newCaster) + 200 * Sin(angle), GetRandomInt(0, 360))
    call SetUnitScale(n, 12, 12, 12)
    call SetUnitFlyHeight(n, 130, 0)
    call SetUnitAnimation(n, "Stand")
    call SaveUnitHandle(h, GetHandleId(bjLCT), StringHash("Rasengan"), n)
        call UnitApplyTimedLife(n, 1, 0.5)
    call MyRemoveUnit(n , 0.5)
    //set n=CreateUnit(GetOwningPlayer(newCaster), 'dM15', GetUnitX(newCaster)+170*Cos(angle), GetUnitY(newCaster)+170*Sin(angle), angle*bj_RADTODEG)
    //call SetUnitScale(n, 1.4, 1.4, 1.4)
    //call SetUnitFlyHeight(n, 50, 0)
    //call SetUnitVertexColor(n, 255, 255, 255, 150)
    //call MyRemoveUnit(n, 0.65)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM16', GetUnitX(newCaster) + 200 * Cos(angle), GetUnitY(newCaster) + 200 * Sin(angle), angle * bj_RADTODEG)
    call SetUnitScale(n, 1.5, 1.5, 1.5)
    call SetUnitFlyHeight(n, 150, 0)
    call SetUnitTimeScale(n, 0.5)
    call MyRemoveUnit(n , 1.5)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM17', GetUnitX(newCaster) + 200 * Cos(angle), GetUnitY(newCaster) + 200 * Sin(angle), GetRandomInt(0, 360))
    call SetUnitScale(n, 5, 5, 5)
    call SetUnitFlyHeight(n, 120, 0)
    call SetUnitTimeScale(n, 0.65)
    call MyRemoveUnit(n , 3.0)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM18', GetUnitX(newCaster) + 170 * Cos(angle), GetUnitY(newCaster) + 170 * Sin(angle), angle * bj_RADTODEG)
    call SetUnitScale(n, 1.2, 1.2, 1.2)
    call SetUnitFlyHeight(n, 120, 0)
    call SetUnitTimeScale(n, 0.6)
    call MyRemoveUnit(n , 3.0)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM18', GetUnitX(newCaster) + 170 * Cos(angle), GetUnitY(newCaster) + 170 * Sin(angle), angle * bj_RADTODEG)
    call SetUnitScale(n, 1.2, 1.2, 1.2)
    call SetUnitFlyHeight(n, 120, 0)
    call SetUnitTimeScale(n, 0.6)
    call MyRemoveUnit(n , 3.0)
    call SaveUnitHandle(h, GetHandleId(bjLCT), TargetHash, newTarget)
    call SaveReal(h, GetHandleId(bjLCT), StringHash("Speed"), speed)
    call SaveReal(h, GetHandleId(bjLCT), StringHash("Distance"), distance)
    call SaveReal(h, GetHandleId(bjLCT), AngleHash, angle)
    call SaveInteger(h, GetHandleId(bjLCT), StringHash("MaxEffPeriod"), R2I(12 / speed * 40))
    call TimerStart(bjLCT, 0.03, true, function Minato_RasenganPush)
    call MinatoRemoveRasengan(newCaster)
    call DestroyTimer(newTimer)
    set newTimer=null
endfunction

function SabrackE_Periodic takes nothing returns nothing
        local integer id=GetHandleId(GetExpiredTimer())
        local unit caster=LoadUnitHandle(HH, id, 0)
        local real time=LoadReal(HH, id, 1)
        if time<74 and udg_B and GetUnitAbilityLevel(caster, 'A182')==0 then
                call SaveReal(HH, id, 1, time+1)
        else
                if GetUnitAbilityLevel(caster, 'A182')==0 then
                        call UnitAddAbility(caster, 'A182')
                endif
                call FlushChildHashtable(HH, id)
                call DestroyTimer(GetExpiredTimer())
        endif
        set caster=null
endfunction
function SabrackE_RemoveAbil takes unit newCaster, real fictia returns nothing
        local timer newTimer=CreateTimer()
        local integer id=GetHandleId(newTimer)
        call UnitRemoveAbility(newCaster, 'A182')
        if GetUnitAbilityLevel(newCaster, 'A185')==0 then
        call CreateModeIndicatorForm(newCaster, "ReplaceableTextures\\CommandButtons\\BTNSabrac3.blp", 75)
        endif
        call SaveUnitHandle(HH, id, 0, newCaster)
        call TimerStart(newTimer, 1, true, function SabrackE_Periodic)
        set newTimer=null
endfunction

function CalculatePhysDamage takes unit newTarget, real damage returns real
        local real multiplier = 0.04
        local real armor = GetUnitArmour(newTarget)
        local real armor_reduce = 0.0
        local real total_damage = 0.0
        set armor_reduce = (multiplier * armor) / (1 + multiplier * armor)
        set total_damage = damage - (damage * armor_reduce)
        // call DisplayTimedTextToAllPlayers(3, "Armor: "+R2S(armor))
        // call DisplayTimedTextToAllPlayers(3, "Armor Reduce: "+R2S(armor_reduce))
        // call DisplayTimedTextToAllPlayers(3, "Total Damage: "+R2S(total_damage))
        return total_damage
endfunction

function HibariW_Attack takes unit newSource, unit newTarget, real b returns real
        local real damage = b*(0.6 + 0.2*GetUnitAbilityLevel(newSource,'HiW1'))
        local real target_x = GetUnitX(newTarget)
        local real target_y = GetUnitY(newTarget)
        local player p = GetOwningPlayer(newSource)
        call UnitRemoveAbility(newSource, 'HiW2')
        call UnitRemoveAbility(newSource, 'ReFa')
        call myCustomDamage(newSource , newTarget , damage , false , false , ATTACK_TYPE_HERO , DAMAGE_TYPE_UNIVERSAL , null)
        //call SetControlToUnit(newTarget, newTarget, 1, "stun")
        //return damage*myCustomDamage2(newTarget, 1)
        
        set n=CreateUnit(p,'e0CV', target_x, target_y,0)
        call SetUnitScale(n, 1, 1, 1)
        call UnitApplyTimedLife(n,1,3)
        set n=CreateUnit(p,'e0CX', target_x, target_y,0)
        call SetUnitScale(n, 1, 1, 1)
        call UnitApplyTimedLife(n,1,3)
        set n=CreateUnit(p,'e0D7', target_x, target_y,0)
        call SetUnitFlyHeight(n, 5, 0)
        call UnitApplyTimedLife(n,1,3)
        set n=CreateUnit(p,'dR58', target_x, target_y,AU(newSource, newTarget)*bj_RADTODEG)
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call UnitApplyTimedLife(n,1,3)
        set n=CreateUnit(p,'e0LF', target_x, target_y,AU(newSource, newTarget)*bj_RADTODEG)
        //call SetUnitScale(n, 1.5, 1.5, 1.5)
        call SetUnitVertexColor(n, 255, 155, 255, 255)
        call UnitApplyTimedLife(n,1,3)
        
        set p = null
        return CalculatePhysDamage(newTarget, damage)
endfunction


function IchigoShikaiQ_CounterPeriodic takes nothing returns nothing
	local timer newTimer = GetExpiredTimer()
	local integer id     = GetHandleId(newTimer)
	local unit caster    = LoadUnitHandle(h, id, 0)
	local unit target    = LoadUnitHandle(h, id, 1)
	local real time      = LoadReal(h, id, 2)+0.02
	local real angle     = LoadReal(h, id, 3)
	local integer eff_period = LoadInteger(h, id, 4)
	call SaveReal(h, id, 2, time)
	if time<1.85 then
		if time<1.5 then
			call IssueImmediateOrder(target, "stop")
            //call SetControlToUnit(target, target, 0.11, "silenceTE")
			call PauseUnit(caster, true)
			call SetUnitInvulnerable(caster, true)
			call SetUnitFacing(caster, angle*bj_RADTODEG)
			call SaveReal(h, id, 3, AU(caster, target))
		endif
		if time==1.0 then
			set n=CreateUnit(GetOwningPlayer(caster), 'd042', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
			call SetUnitScale(n, 1, 1, 1)
			call MyRemoveUnit(n, 1.5)
			call SetUnitX(caster, GetUnitX(target)-170*Cos(angle))
			call SetUnitY(caster, GetUnitY(target)-170*Sin(angle))
			set n=CreateUnit(GetOwningPlayer(caster), 'd042', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
			call SetUnitScale(n, 1, 1, 1)
			call MyRemoveUnit(n, 1.5)
			call SetUnitAnimationByIndex(caster, 1)
			call RemoveEffect(AddSpecialEffectTarget("supershinythingyhg23.mdl", caster, "hand left"), 1.5, true, CreateTimer())
		endif
		if time==1.2 then
			set n=CreateUnit(GetOwningPlayer(caster), 'd014', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG)
			call SetUnitScale(n, 1, 1, 1)
			call MyRemoveUnit(n, 1.5)
			set n=CreateUnit(GetOwningPlayer(caster), 'd003', GetUnitX(target), GetUnitY(target), angle*bj_RADTODEG)
			call SetUnitScale(n, 2.5, 2.5, 2.5)
			call SetUnitFlyHeight(n, 10, 0)
			call MyRemoveUnit(n, 1.5)
		endif
		if time==1.5 then
			set n=CreateUnit(GetOwningPlayer(caster), 'd074', GetUnitX(target), GetUnitY(target), angle*bj_RADTODEG)
			call SetUnitScale(n, 1.7, 1.7, 1.7)
			call SetUnitFlyHeight(n, 150, 0)
			call MyRemoveUnit(n, 0.2)
			set n=CreateUnit(GetOwningPlayer(caster), 'd036', GetUnitX(target), GetUnitY(target), angle*bj_RADTODEG)
			call SetUnitScale(n, 1.7, 1.7, 1.7)
			call SetUnitFlyHeight(n, 150, 0)
			call MyRemoveUnit(n, 1.5)
			set n=CreateUnit(GetOwningPlayer(caster), 'd037', GetUnitX(target), GetUnitY(target), angle*bj_RADTODEG)
			//call SetUnitScale(n, 1.7, 1.7, 1.7)
			//call SetUnitFlyHeight(n, 150, 0)
			call MyRemoveUnit(n, 1.5)
			set n=CreateUnit(GetOwningPlayer(caster), 'd018', GetUnitX(target), GetUnitY(target), angle*bj_RADTODEG)
			call SetUnitScale(n, 2.7, 2.7, 2.7)
			call MyRemoveUnit(n, 1.5)
			set n=CreateUnit(GetOwningPlayer(caster), 'd025', GetUnitX(target), GetUnitY(target), angle*bj_RADTODEG)
			call SetUnitScale(n, 2.7, 2.7, 2.7)
			call MyRemoveUnit(n, 1.5)
			set n=CreateUnit(GetOwningPlayer(caster), 'd074', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG)
			call SetUnitFlyHeight(n, 150, 0)
			call SetUnitScale(n, 2, 2, 2)
			call SaveUnitHandle(h, id, 5, n)
			set n=CreateUnit(GetOwningPlayer(caster), 'd077', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG)
			call SetUnitFlyHeight(n, 130, 0)
			call SetUnitScale(n, 1.2, 1.2, 1.2)
			call SaveUnitHandle(h, id, 6, n)
			call Push3(target , 30 , AU(caster, target) , 250 , "")
			call PauseUnit(caster, false)
			call SetUnitInvulnerable(caster, false)
			call myCustomDamage(caster, target, LoadReal(h, id, 9), false,false,null,null,null)
			call SetControlToUnit(target, target, 1.0, "stun")
		endif
		if time>1.5 then
			call SetUnitX(target, GetUnitX(target)+30*Cos(angle))
			call SetUnitY(target, GetUnitY(target)+30*Sin(angle))
			call SetUnitX(LoadUnitHandle(h, id, 5), GetUnitX(target))
			call SetUnitY(LoadUnitHandle(h, id, 5), GetUnitY(target))
			call SetUnitX(LoadUnitHandle(h, id, 6), GetUnitX(target)-200*Cos(angle))
			call SetUnitY(LoadUnitHandle(h, id, 6), GetUnitY(target)-200*Sin(angle))
			if eff_period<=0 then
				// set n=CreateUnit(GetOwningPlayer(caster), 'd045', GetUnitX(target)-50*Cos(angle), GetUnitY(target)-50*Sin(angle), angle*bj_RADTODEG)
				// call SetUnitScale(n, 2.8, 2.8, 2.8)
				// call SetUnitFlyHeight(n, 125, 0)
				// call MyRemoveUnit(n, 1.0)
				set n=CreateUnit(GetOwningPlayer(caster), 'd003', GetUnitX(target), GetUnitY(target), angle*bj_RADTODEG)
				call SetUnitScale(n, 1, 1, 1)
				call SetUnitFlyHeight(n, 10, 0)
				call MyRemoveUnit(n, 1.5)
				set n=CreateUnit(GetOwningPlayer(caster), 'd025', GetUnitX(target), GetUnitY(target), angle*bj_RADTODEG)
				call SetUnitScale(n, 1, 1, 1)
				call SetUnitFlyHeight(n, 5, 0)
				call MyRemoveUnit(n, 1.5)
				call SaveInteger(h, id, 4, 3)
			else
				call SaveInteger(h, id, 4, eff_period-1)
			endif
		endif
	else
		set n=CreateUnit(GetOwningPlayer(caster), 'd001', GetUnitX(target), GetUnitY(target), angle*bj_RADTODEG)
		call SetUnitFlyHeight(n, 10, 0)
		//call SetUnitScale(n, 2, 2, 2)
		call MyRemoveUnit(n, 1.5)
		call UnitApplyTimedLife(LoadUnitHandle(h, id, 5),1,0.1)
		call UnitApplyTimedLife(LoadUnitHandle(h, id, 6),1,0.1)
		call MyRemoveUnit(LoadUnitHandle(h, id, 5), 1.5)
		call MyRemoveUnit(LoadUnitHandle(h, id, 6), 1.5)
		call FlushChildHashtable(h, id)
		call PauseTimer(newTimer)
		call DestroyTimer(newTimer)
	endif
	set newTimer=null
	set caster=null
	set target=null
endfunction


function IchigoShikaiQ_Counter takes unit newCaster, unit newTarget, real newDamage returns nothing
        local timer newTimer = CreateTimer()
        local integer id     = GetHandleId(newTimer)
        local real caster_x  = GetUnitX(newCaster)
        local real caster_y  = GetUnitY(newCaster)
        local real angle     =  AU(newCaster, newTarget)
        local real damage    = GetHeroStr(newCaster, true)*GetUnitAbilityLevel(newCaster, 'IcQ1') + newDamage*2.5
        set soundplay=CreateSound("Sound\\war3mapImported\\IchigoBankaiQ2Reverse.mp3", false, false, true, 12700, 12700, "")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd001', caster_x, caster_y, GetRandomInt(0, 360))
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd047', caster_x+200*Cos(angle), caster_y+200*Sin(angle), GetRandomInt(0, 360))
        call SetUnitScale(n, 3, 3, 3)
        call SetUnitFlyHeight(n, 100, 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd032', caster_x+200*Cos(angle), caster_y+200*Sin(angle), GetRandomInt(0, 360))
        call SetUnitScale(n, 2, 2, 2)
        call SetUnitFlyHeight(n, 100, 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd074', caster_x+200*Cos(angle), caster_y+200*Sin(angle), angle*bj_RADTODEG)
        call SetUnitScale(n, 2, 2, 2)
        call SetUnitFlyHeight(n, 75, 0)
        call UnitApplyTimedLife(n, 1, 0.2)
        call MyRemoveUnit(n, 1.5)
        
        call UnitRemoveAbility(newCaster, 'IcQ2')
        call PauseUnit(newCaster, true)
        call SetUnitInvulnerable(newCaster, true)
        call SetUnitAnimationByIndex(newCaster, 3)
        call SaveUnitHandle(h, id, 0, newCaster)
        call SaveUnitHandle(h, id, 1, newTarget)
        call SaveReal      (h, id, 2, 0.0)
        call SaveReal      (h, id, 3, angle)
        call SaveReal      (h, id, 9, damage)
        call TimerStart(newTimer, 0.02, true, function IchigoShikaiQ_CounterPeriodic)
        set newTimer=null

endfunction

function IchigoBankaiW_CounterPeriodic takes nothing returns nothing
	local timer newTimer = GetExpiredTimer()
	local integer id     = GetHandleId(newTimer)
	local unit caster    = LoadUnitHandle(h, id, 0)
	local unit target    = LoadUnitHandle(h, id, 1)
	local real time      = LoadReal(h, id, 2)
	local real angle     = LoadReal(h, id, 3)
	local integer eff_period = LoadInteger(h, id, 4)
	call SaveReal(h, id, 2, time+0.02)
	if time<2.2 then
		if time<1.7 then
			call IssueImmediateOrder(target, "stop")
			call PauseUnit(caster, true)
			call SetUnitInvulnerable(caster, true)
            //call SetControlToUnit(target, target, 0.11, "silenceTE")
			call SetUnitFacing(caster, angle*bj_RADTODEG)
			call SaveReal(h, id, 3, AU(caster, target))
		endif
		if time>0.8 and time<1.4 then
			call SetUnitXY(target, GetUnitX(target)+8*Cos(angle), GetUnitY(target)+8*Sin(angle))
			call SetUnitXY(LoadUnitHandle(h, id, 20), GetUnitX(target), GetUnitY(target))
			if eff_period<=0 then
				set n=CreateUnit(GetOwningPlayer(caster), 'd010', GetUnitX(target), GetUnitY(target), angle*bj_RADTODEG)
				call SetUnitScale(n, 2.5, 2.5, 2.5)
				call SetUnitFlyHeight(n, 5, 0)
				call MyRemoveUnit(n, 1.5)
				call SaveInteger(h, id, 4, 4)
			else
				call SaveInteger(h, id, 4, eff_period-1)
			endif
		endif
		if time==0.8 then
            if LoadBoolean(HH,GetHandleId(target),ANTITARGET_ABILITY)==false then
                set soundplay=CreateSound("Sound\\war3mapImported\\IchigoTW2.mp3", false, false, true, 12700, 12700, "")
