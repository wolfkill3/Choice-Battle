                elseif (GetWidgetMana(Hero[x])<100 or GetWidgetMana(udg_DM[x+1])<100) and manaMoria[x]==1 then
                    call RemoveUnit(udg_DMM[x])
                    set manaMoria[x]=0
                endif
            endif
        endif
