function EraserCannonCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local player p=GetOwningPlayer(u)
local real dmg=(0.7+0.3*GetUnitAbilityLevel(u,'A0JD'))*GetHeroStr(u,true)
if GetUnitCurrentOrder(u)==OrderId("channel")then
call SetUnitAnimation(u,"Spell channel throw one")
set n=CreateUnit(p,'e0E5',x,y,Atan2(y1-y,x1-x)*bj_RADTODEG)
call EraserCannonMissleMovePoint(n,50,0,x1+GetRandomReal(-400,400),y1+GetRandomReal(-400,400),dmg)
else
call SetUnitAnimation(u,"stand")
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set t=null
endfunction
