    call ShowFrame( CustomAbilityVarTooltipText, true )
    call SetFrameRelativePoint( CustomAbilityVarTooltipText, FRAMEPOINT_CENTER, CustomAbilityVarTooltip, FRAMEPOINT_CENTER, 0, .0 )

