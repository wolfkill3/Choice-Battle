function aTAtalantaCast3 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit l__d=LoadUnitHandle(h,id,1)
    local real dmg=GetHeroAgi(u,true)*10
    local real x=GetUnitX(l__d)
    local real y=GetUnitY(l__d)
    local real x1=GetUnitX(u)
    local real y1=GetUnitY(u)
    local real x2=LoadReal(h,id,4)
    local real y2=LoadReal(h,id,5)
    local real a=LoadReal(h,id,3)
    local real dist=LoadReal(h,id,2)
    local real rd=LoadReal(h,id,4)
    local real he=GetUnitFlyHeight(l__d)+75
    local player p=GetOwningPlayer(u)
    if dist<2600 and GetWidgetLife(l__d)>0 then
        call SaveReal(h,id,2,dist+75)
        if dist>1100 and GetWidgetLife(l__d)>0 then
            call SetUnitScale(l__d,4,4,4)
            call SetUnitX(l__d,x)
            call SetUnitY(l__d,y)
            call SetUnitFlyHeight(l__d,he,0)
            set n=CreateUnit(p,'e136',x,y,a*bj_RADTODEG)
            call SetUnitVertexColor(n,70,0,255,255)
            call SetUnitTimeScale(n,2)
            call SetUnitFlyHeight(n,he,0)
            call UnitApplyTimedLife(n,1,0.3)
        endif
    else
    call SetUnitInvulnerable(u,false)
    call UnitRemoveAbility(u,'A2DV')
    call CinematicFadeBJCustom(bj_CINEFADETYPE_FADEIN,2,"ReplaceableTextures\\CameraMasks\\White_mask.blp",100,0,255,0)
    call SaveReal(h,id,2,0)
    call SetUnitTimeScale(u,1)
    set n=CreateUnit(p,'e13F',x2,y2,a*bj_RADTODEG+180)
    call SetUnitVertexColor(n,70,0,255,125)
    call SetUnitScale(n,10,10,10)
    call SetUnitTimeScale(n,2)
    call UnitApplyTimedLife(n,1,3)
    call ShakeCamera(3.5,15)
    call RemoveUnit(l__d)
    call PauseTimer(t)
    call TimerStart(t,0.5,false,function aTAtalantaCast4)
    endif
    set l__d=null
    set u=null
    set p=null
    set t=null
endfunction
function aTAtalantaCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=LoadReal(h,id,4)
    local real y1=LoadReal(h,id,5)
    local player p=GetOwningPlayer(u)
    local real a=LoadReal(h,id,3)
    local real sc=0
    local real is=0
    local real ig=30*bj_DEGTORAD
    loop
    exitwhen is>=13
    set n=CreateUnit(p,'e0ZH',x+250*Cos(ig*is),y+250*Sin(ig*is),180+is*30)
    call SetUnitVertexColor(n,50,0,255,55)
    call UnitApplyTimedLife(n,1,3)
    call SetUnitTimeScale(n,1.2)
    set is=is+1
    endloop
    set n=CreateUnit(p,'e0BO',x,y,a*bj_RADTODEG)
    call UnitApplyTimedLife(n,1,1)
    call SetUnitTimeScale(n,3)
    call SetUnitVertexColor(n,70,0,255,155)
    set n=CreateUnit(p,'e230',x+15*Cos(a),y+15*Sin(a),a*bj_RADTODEG+180)
    call SetUnitVertexColor(n,50,0,255,35)
    call SaveUnitHandle(h,id,1,n)
    call SetUnitScale(n,0,0,0)
    call PauseTimer(t)
    call TimerStart(t,0.02,true,function aTAtalantaCast3)
    set u=null
    set p=null
    set t=null
endfunction
function aTAtalantaCast takes nothing returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local unit u=GetTriggerUnit()
    local player p=GetOwningPlayer(u)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetUnitX(u)
    local real y1=GetUnitY(u)
    local real a=Atan2(y1-y,x1-x)
    local real sc=0
    local real is=0
    local real ig=30*bj_DEGTORAD
    call SaveUnitHandle(h,id,0,u)
    call SaveReal(h,id,2,0)
    call SaveReal(h,id,3,a)
    call SaveReal(h,id,4,x1)
    call SaveReal(h,id,5,y1)
    call SaveReal(h,id,6,x)
    call SaveReal(h,id,7,y)
    call UnitAddAbility(u,'A2DV')
    call SetUnitAnimation(u,"Spell Four")
    call SetUnitTimeScale(u,0.8)
    set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG-45)
    call SetUnitVertexColor(n,70,0,255,155)
    call UnitApplyTimedLife(n,1,0.4)
    call SetUnitTimeScale(n,3)
    set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+45)
    call SetUnitVertexColor(n,70,0,255,155)
    call UnitApplyTimedLife(n,1,0.4)
    call SetUnitTimeScale(n,3)
    set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG)
    call SetUnitVertexColor(n,70,0,255,155)
    call UnitApplyTimedLife(n,1,0.4)
    call SetUnitTimeScale(n,3)
    call SetUnitTimeScale(u,1.5)
    call SetUnitInvulnerable(u,true)
    set soundplay=CreateSound("Sound\\Music\\mp3Music\\Tauropolos.mp3",false,false,true,12700,12700,"")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    call TimerStart(t,0.9,false,function aTAtalantaCast2)
    set u=null
    set p=null
    set t=null
    endfunction

function InitTrig_TAlterAtalanta takes nothing returns nothing
set gg_trg_TAlterAtalanta=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_TAlterAtalanta,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_TAlterAtalanta,Condition(function TAlterAtalantaCond))
call TriggerAddAction(gg_trg_TAlterAtalanta,function aTAtalantaCast)
endfunction
function RAtalantaCond takes nothing returns boolean
return GetSpellAbilityId()=='A1DY'
endfunction
function RAtalantaMissles2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real f=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,5)
local real y1=LoadReal(h,id,6)
local real dmg=LoadReal(h,id,9)
local real a=Atan2(y1-y,x1-x)
local real sr=SR(x,y,x1,y1)
local real fl=sr/LoadReal(h,id,7)
local real dist=LoadReal(h,id,3)
local player p=GetOwningPlayer(l__d)
if SR(x,y,x1,y1)>30 and l__d!=null then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,f*fl,0)
else
call GroupEnumUnitsInRange(G,x,y,400,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(l__d,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(G,E)
endloop
set n=CreateUnit(p,'e13C',x1,y1,GetRandomReal(0,359))
call SetUnitTimeScale(n,1)
call UnitApplyTimedLife(n,1,0.5)
set n=CreateUnit(p,'e13D',x1,y1,GetRandomReal(0,359))
call SetUnitTimeScale(n,1)
call UnitApplyTimedLife(n,1,0.6)
call UnitApplyTimedLife(l__d,1,0.15)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set t=null
endfunction
function RAtalantaMissles takes unit l__d,real speed,real a,real x,real y,real time,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,GetUnitFlyHeight(l__d))
call SaveReal(h,id,3,GetUnitX(l__d))
call SaveReal(h,id,4,GetUnitY(l__d))
call SaveReal(h,id,5,x)
call SaveReal(h,id,6,y)
call SaveReal(h,id,7,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,8,time)
call SaveReal(h,id,9,dmg)
call TimerStart(t,0.022,true,function RAtalantaMissles2)
set t=null
endfunction
function RAtalantaCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real dmg=0
local real x=LoadReal(h,id,6)
local real y=LoadReal(h,id,7)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real x2=0
local real y2=0
local real sr2=0
local real a=LoadReal(h,id,3)+bj_PI+GetRandomReal(0,6.28)
local real dist=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
if dist<7 then
call SaveReal(h,id,2,dist+1)
if IsUnitType(c,UNIT_TYPE_HERO)then
if GetHeroAgi(c,false)>GetHeroInt(c,false)and GetHeroAgi(c,false)>GetHeroStr(c,false)then
set dmg=GetHeroAgi(c,true)*(0.75+0.25*GetUnitAbilityLevel(u,'A1DY'))
elseif GetHeroStr(c,false)>GetHeroInt(c,false)and GetHeroStr(c,false)>GetHeroAgi(c,false)then
set dmg=GetHeroStr(c,true)*(0.75+0.25*GetUnitAbilityLevel(u,'A1DY'))
elseif GetHeroInt(c,false)>GetHeroAgi(c,false)and GetHeroInt(c,false)>GetHeroStr(c,false)then
set dmg=GetHeroInt(c,true)*(0.75+0.25*GetUnitAbilityLevel(u,'A1DY'))
endif
else
set dmg=GetHeroAgi(u,true)*(0.75+0.25*GetUnitAbilityLevel(u,'A1DY'))
endif
set x2=x1
set y2=y1
set sr2=SR(x2,y2,x,y)
set n=CreateUnit(p,'e13B',x2-(700)*Cos(a),y2-(700)*Sin(a),a*bj_RADTODEG)
call SetUnitFlyHeight(n,GetRandomReal(1550,1800),0)
call SetUnitTimeScale(n,1)
call RAtalantaMissles(n,20,a,x2,y2,1.25-dist/2,dmg)
set x2=x1
set y2=y1
set sr2=SR(x2,y2,x,y)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set c=null
set p=null
set t=null
endfunction
function RAtalantaCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
