call UnitCreateAndMove(caster,0x64733437,caster,GetRandomReal(0,360),1,GetRandomReal(1.5,2),GetRandomReal(1.75,2.25),100,100,100,GetRandomReal(60,80),0,Dummy,0,facing)
set time1=0
endif
call SaveReal(HH,id,6,time1)
endif
endif
set t=null
set Dummy=null
set caster=null
endfunction


function DanzoW2Act takes nothing returns nothing
local timer t=GetExpiredTimer()
