            call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),0x65315439,x,y,(a*bj_RADTODEG)),1,3)
            call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),0x65315442,x,y,(a*bj_RADTODEG)),1,3)
