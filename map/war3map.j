function WGilCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real dmg=GetHeroInt(u,true)*(0.1+0.02*GetUnitAbilityLevel(u,'A131'))
local real x=LoadReal(h,id,6)
local real y=LoadReal(h,id,7)
local real x1=LoadReal(h,id,4)
local real y1=LoadReal(h,id,5)
local real x2=0
local real y2=0
local real r=0
local real he=0
local real a2=0
local real a=LoadReal(h,id,3)
local real dist=LoadReal(h,id,2)
local real dist2=LoadReal(h,id,12)
local real dist3=LoadReal(h,id,22)
local group g=LoadGroupHandle(h,id,10)
local group g2
local player p=GetOwningPlayer(u)
if dist<2 then
call SaveReal(h,id,2,dist+0.04)
call SaveReal(h,id,12,dist2+0.04)
call SaveReal(h,id,22,dist3+0.04)
if dist2>0.12 then
set n=CreateUnit(p,'e14W',x1,y1,GetRandomReal(0,359))
call SetUnitTimeScale(n,1)
call SetUnitFlyHeight(n,750,0)
call SetUnitVertexColor(n,255,255,255,120)
call SetUnitScale(n,0.8,0.8,0.8)
call UnitApplyTimedLife(n,1,0.24)
call SaveReal(h,id,12,0)
endif
if dist>0.1 then
set g2=CopyGroup(g)
loop
set E=FirstOfGroup(g2)
exitwhen E==null
set x2=GetUnitX(E)
set y2=GetUnitY(E)
set a2=Atan2(y1-y2,x1-x2)
set x2=x1-200*Cos(a2+0.03)
set y2=y1-200*Sin(a2+0.03)
call SetUnitX(E,x2)
call SetUnitY(E,y2)
if dist3>0.12 then
set n=CreateUnit(p,'e14X',x2,y2,GetRandomReal(0,359))
call SetUnitTimeScale(n,1.5)
call SetUnitFlyHeight(n,0,0)
call SetUnitVertexColor(n,255,255,255,255)
call UnitApplyTimedLife(n,1,0.5)
endif
call GroupRemoveUnit(g2,E)
endloop
call DestroyGroupTimed(g2,3)
if dist3>0.12 then
call SaveReal(h,id,22,0)
endif
call GroupEnumUnitsInRange(G,x1,y1,400,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(G,E)
endloop
endif
else
call PauseTimer(t)
call ForGroup(g,function KillGroup)
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set g=null
set g2=null
set p=null
set t=null
endfunction
function WGilCast takes nothing returns nothing
