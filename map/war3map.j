function CondRandomBlink takes nothing returns boolean
return GetItemTypeId(GetManipulatedItem())=='I027' and GetUnitTypeId(GetTriggerUnit())!='n008' and GetUnitTypeId(GetTriggerUnit())!='H007'
endfunction
function CastRandomBlink takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetRectMaxX(gg_rct_GameZone)
local real x1=GetRectMinX(gg_rct_GameZone)
local real y=GetRectMaxY(gg_rct_GameZone)
local real y1=GetRectMinY(gg_rct_GameZone)
local real x2=GetRandomReal(x1+50,x-50)
local real y2=GetRandomReal(y1+50,y-50)
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",GetUnitX(u),GetUnitY(u)))
call SetUnitXY_1(u,x2,y2, false)
if GetLocalPlayer()==GetOwningPlayer(u)then
call SetCameraPosition(x2,y2)
endif
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x2,y2))
set u=null
endfunction
function RandomBlinkInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_PICKUP_ITEM,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function CastRandomBlink)
call TriggerAddCondition(t,Condition(function CondRandomBlink))
set t=null
endfunction
function Trig_Dark_Candels_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A09A' and udg_B==true and GetUnitTypeId(GetTriggerUnit())!='H007'  and GetUnitAbilityLevel(GetTriggerUnit(),'GIE1')==0
endfunction
function Trig_Dark_Candels_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,2)
local real x=LoadReal(h,id,0)
local real y=LoadReal(h,id,1)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real a=Atan2(y1-y,x1-x)
local lightning l=LoadLightningHandle(h,id,3)
if GetUnitAbilityLevel(u,'B01L')>0 and GetWidgetLife(u)>0 and udg_B and DU2 then
call MoveLightningEx(l,false,x,y,50,x1,y1,GetUnitZ10(u)+50)
if SR(x,y,x1,y1)>400 then
call SetUnitX(u,x+400*Cos(a))
call SetUnitY(u,y+400*Sin(a))
endif
else
call DestroyLightning(l)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l=null
set t=null
set u=null
endfunction
function Trig_Dark_Candels_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local timer t
local integer id
if GetUnitAbilityLevel(c,'A15H')==0 then
    set t=CreateTimer()
    set id=GetHandleId(t)
    set bj_lastCreatedLightning=AddLightningEx("FORK",false,x,y,50.,x1,y1,GetUnitZ10(c)+50.)
    call SetLightningColor(bj_lastCreatedLightning,127,0,130,100)
    call ComboChecker(c,4,6, false )
    if IsUnitEnemy(u,GetOwningPlayer(c))==true then
        call SetControlToUnit(u,c,6,"disarm")
    endif
    call SaveReal(h,id,0,x1)
    call SaveReal(h,id,1,y1)
    call SaveUnitHandle(h,id,2,c)
    call SaveLightningHandle(h,id,3,bj_lastCreatedLightning)
    call TimerStart(t,0.05,true,function Trig_Dark_Candels_Actions2)
else
    call DisplayTimedWarningMessage(GetOwningPlayer(GetTriggerUnit()),10,Lng("Нельзя использовать на врага под эффектом Imagine Breaker.","Cannot be used on an enemy under the effect of Imagine Breaker."))
    call IssueImmediateOrder(GetTriggerUnit(),"stop")
endif
set t=null
set u=null
set c=null
endfunction
function InitTrig_Dark_Candels takes nothing returns nothing
set gg_trg_Dark_Candels=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Dark_Candels,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_Dark_Candels,Condition(function Trig_Dark_Candels_Conditions))
call TriggerAddAction(gg_trg_Dark_Candels,function Trig_Dark_Candels_Actions)
endfunction
function FrozenCond takes nothing returns boolean
return GetSpellAbilityId()=='A118' and udg_B==true and GetUnitTypeId(GetTriggerUnit())!='H007'  and GetUnitAbilityLevel(GetTriggerUnit(),'GIE1')==0 and GetUnitTypeId(GetTriggerUnit())!='Ho13' and GetUnitTypeId(GetTriggerUnit())!='H34X' and GetUnitTypeId(GetTriggerUnit())!='H14F'
endfunction
function FrozenCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit c=LoadUnitHandle(h,id,1)
local unit u=LoadUnitHandle(h,id,2)
local real life=LoadReal(h,id,0)
local real time2=LoadReal(h,id,5)
local real life2=GetWidgetLife(u)
local real dmg=0
local lightning l=LoadLightningHandle(h,id,3)
if GetUnitAbilityLevel(u,'BNC2')>0 and GetWidgetLife(u)>0 and udg_B==true and DU2==true and LoadInteger(HH,GetHandleId(u),SH_cold)!=1 then
    if IsUnitPaused(u)==false and IsUnitHidden(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
        call SaveReal(h,id,5,time2+0.01)
    endif
    if life2>life then
        set dmg=life2-life
        if dmg<life2 then
            call SetUnitState(u,UNIT_STATE_LIFE,life2-dmg)
        else
            call SetUnitState(u,UNIT_STATE_LIFE,50)
        endif
    endif
    if time2>0.25 then
        // неуязвимые урона не получают (запрет восстановления HP действует); myCustomDamage снимает 1 HP напрямую у полного HP
        if (GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.0075)-40>0 and IsUnitInvulnerable(u)==false then
            call myCustomDamage(c,u,(GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.0075)-40,false,false,null,null,null)
        endif
        call SaveReal(h,id,5,0)
    endif
    call SaveReal(h,id,0,GetWidgetLife(u))
else
    call UnitRemoveAbility(u,'BNC2')
    call SaveInteger(HH,GetHandleId(u),SH_cold,0)
    call DestroyTimer(t)
    call FlushChildHashtable(h,id)
endif
set c=null
set l=null
set t=null
set u=null
endfunction
function FrozenCast takes nothing returns nothing
local unit c=GetSpellTargetUnit()
local unit u=GetTriggerUnit()
local timer t
local integer id
if GetUnitAbilityLevel(c,'A15H')==0 then
    if GetUnitAbilityLevel(c,'BNC2')==0 then
        set t=CreateTimer()
        set id=GetHandleId(t)
        call SaveReal(h,id,0,GetWidgetLife(c))
        call SaveUnitHandle(h,id,1,u)
        call SaveUnitHandle(h,id,2,c)
        call SaveReal(h,id,5,0)
        call SaveInteger(HH,GetHandleId(c),SH_cold,0)
        call SetControlToUnit(u,c,10,"frostbite")
        call TimerStart(t,0.01,true,function FrozenCast2)
        set t=null
    else
        call SetControlToUnit(u,c,10,"frostbite")
    endif
else
    call DisplayTimedWarningMessage(GetOwningPlayer(u),10,Lng("Нельзя использовать на врага под эффектом Imagine Breaker.","Cannot be used on an enemy under the effect of Imagine Breaker."))
    call IssueImmediateOrder(u,"stop")
endif
set t=null
set u=null
set c=null
endfunction
function InitTrig_Frozen takes nothing returns nothing
set gg_trg_Frozen=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Frozen,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_Frozen,Condition(function FrozenCond))
call TriggerAddAction(gg_trg_Frozen,function FrozenCast)
endfunction
function FrozenManaCond takes nothing returns boolean
return GetSpellAbilityId()=='A15E' and udg_B==true and GetUnitTypeId(GetTriggerUnit())!='H007'
endfunction
function FrozenManaCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,1)
local real life=LoadReal(h,id,0)
local real time=LoadReal(h,id,4)
local real time2=LoadReal(h,id,5)
local real life2=GetWidgetMana(u)
local real dmg=0
local lightning l=LoadLightningHandle(h,id,3)
if time>0 and GetUnitAbilityLevel(u,'A15F')>0 and GetWidgetLife(u)>0 and udg_B==true and LoadInteger(HH,GetHandleId(u),SH_cold2)!=1 then
call SaveReal(h,id,4,time-0.01)
call SaveReal(h,id,5,time2+0.01)
call UnitAddAbility(u,'A15F')
if GetUnitAbilityLevel(u,'A25F')>0 then
call SaveReal(h,id,4,0)
endif
if life2<life then
    if LoadInteger(h,GetHandleId(u),HRHash)!=1 then
        call SetUnitState(u,UNIT_STATE_MANA,life-(life-life2)*0.45)
    endif
endif
call SaveReal(h,id,0,GetUnitState(u,UNIT_STATE_MANA))
else
call UnitRemoveAbility(u,'A15F')
call SaveInteger(HH,GetHandleId(u),SH_cold2,0)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l=null
set t=null
set u=null
endfunction
function FrozenManaCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
if GetAbilityIntegerLevelField(GetUnitAbility(u,'A15E'), ABILITY_ILF_TARGET_TYPE,0)==0 then
set c=u
endif
call SaveReal(h,id,4,8)
call SaveReal(h,id,5,0)
call UnitAddAbility(c,'A15F')
call CreateModeIndicatorForm(c,"ReplaceableTextures\\CommandButtons\\BTNINV_Boots_Plate_05.blp",8)
call SaveUnitHandle(h,id,1,c)
call SaveInteger(HH,GetHandleId(c),SH_cold2,0)
call HealTextTag(u,c,GetUnitState(c,UNIT_STATE_MAX_MANA)*0.15*myCustomMana2(c,1),"ManaRes")
call SetUnitState(c,UNIT_STATE_MANA,GetWidgetMana(c)+GetUnitState(c,UNIT_STATE_MAX_MANA)*0.15)
call SaveReal(h,id,0,GetWidgetMana(c))
call TimerStart(t,0.01,true,function FrozenManaCast2)
set t=null
set c=null
set u=null
endfunction
function Trig_Three_Attack_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A06J' and udg_B==true and GetUnitTypeId(GetTriggerUnit())!='H007'  and GetUnitAbilityLevel(GetTriggerUnit(),'GIE1')==0 and GetUnitTypeId(GetTriggerUnit())!='H04U'
endfunction
function Trig_Three_Attack_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local integer i=LoadInteger(h,id,2)
local real f=GetUnitFacing(u)*bj_DEGTORAD
if i<1 and UnitIsAlive(c)and UnitIsAlive(u)and IsUnitPaused(u)==false then
call SetUnitX(u,x1+100*Cos(f))
call SetUnitY(u,y1+100*Sin(f))
call UnitAttackRestart(u) 
call SetUnitFacingInstant(u,AU(u,c)*bj_RADTODEG)
call IssueTargetOrder(u,"attack",c)
call SaveInteger(h,id,2,i+1)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",c,"chest"))
call DestroyEffect(AddSpecialEffect("war3mapImported\\Slam.mdl",x,y))
else
call UnitRemoveAbilityTimed(u,'A06K',0.4)
if GetUnitTypeId(u)!='H04B' then
call SetUnitVertexColor(u,255,255,255,255)
endif
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set c=null
set t=null
endfunction
function Trig_Three_Attack_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
if GetHeroLevel(u)<6 then
call DisplayTimedWarningMessage(GetOwningPlayer(u),10,Lng("Уровень героя ниже необходимого.","The hero's level is below the required level."))
call UnitForceStopOrder(u,false)
call DestroyTimer(t)
else
call UnitAddAbility(u,'A06K')
if GetUnitTypeId(u)!='H04B' then
call SetUnitVertexColor(u,255,255,255,100)
endif
if GetUnitAbilityLevel(u,'A1FU')>0 then
call UnitRemoveAbility(u,'A1FU')
call UnitRemoveAbility(u,'Pet1')
endif
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SetUnitFacingInstant(u,AU(u,c)*bj_RADTODEG)
