endif
if time==10.5 then
call UnitSpeed(caster,1)
call RemoveUnit(LoadUnitHandle(HH,id,20))
call RemoveUnit(LoadUnitHandle(HH,id,21))
call RemoveUnit(LoadUnitHandle(HH,id,22))
