function Trig_Magma_Charge_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A06X' and udg_B==true
endfunction
function Trig_Magma_Charge_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=LoadReal(h,id,1)
local real y=LoadReal(h,id,2)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real a=Atan2(y-y1,x-x1)
local group g=LoadGroupHandle(h,id,3)
local real dist=LoadReal(h,id,100)
local integer l__idg=GetHandleId(g)
local integer l__ide
local real dmg=GetHeroStr(u,true)*(GetUnitAbilityLevel(u,'A06X')+1)
local real time=LoadReal(h, id, TIME_HASH)
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>42 and udg_B==true and GetUnitAbilityLevel(u,'A3IH')==0 and time<2.5 and LoadBoolean(HH,GetHandleId(u),DASH_USER)==true then
call SaveReal(h,id,100,dist-47)
call SetUnitX(u,x1+47*Cos(a))
call SetUnitY(u,y1+47*Sin(a))
call SaveReal(h, id, TIME_HASH, time+0.025)
call GroupEnumUnitsInRange(g,x1,y1,180,Base)
call UnitApplyTimedLife(CreateUnit(p,'e02E',x1,y1,a*bj_RADTODEG),'BTLF',1)
loop
set E=FirstOfGroup(g)
set l__ide=GetHandleId(E)
exitwhen E==null
if(IsUnitEnemy(E,p)and E!=LoadUnitHandle(h,l__idg,l__ide)and IsUnitType(E,UNIT_TYPE_STRUCTURE)==false and GetWidgetLife(E)>0) then
if LoadBoolean(HH,ide,ANTITARGET_ABILITY)==false then
call myCustomDamage(u,E,GetUnitState(E,UNIT_STATE_MAX_LIFE)*0.10+dmg,false,false,null,null,null)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Flameshock.mdx",E,"chest"))
call DestroyEffect(AddSpecialEffect("war3mapImported\\Abyssal_Impact_Base.mdx",GetUnitX(E),GetUnitY(E)))
call SaveUnitHandle(h,l__idg,l__ide,E)
else
call SaveBoolean(HH,GetHandleId(u),DASH_USER,false)
call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,u)
endif
endif
call GroupRemoveUnit(g,E)
endloop
else
call DestroyEffect(LoadEffectHandle(h,id,4))
call DestroyEffect(LoadEffectHandle(h,id,5))
call SaveBoolean(HH,GetHandleId(u),DASH_USER,false)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
call DestroyTimer(t)
call DestroyGroup(g)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call SetUnitTimeScale(u,1)
endif
set u=null
set p=null
set t=null
set g=null
endfunction
function Trig_Magma_Charge_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveBoolean(HH,GetHandleId(u),DASH_USER,true)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,GetSpellTargetX())
call SaveReal(h,id,2,GetSpellTargetY())
call SaveGroupHandle(h,id,3,CreateGroup())
call SaveEffectHandle(h,id,4,AddSpecialEffectTarget("war3mapImported\\s_LavaBomb.mdl",u,"left hand"))
call SaveEffectHandle(h,id,5,AddSpecialEffectTarget("war3mapImported\\s_LavaBomb.mdl",u,"right hand"))
call PauseUnit(u,true)
call UnitRemoveAbility(u,'A2VJ')
if GetUnitAbilityLevel(u,'A155')==0 and GetHeroLevel(u)>5 then
call UnitAddAbility(u,'A155')
call UnitMakeAbilityPermanent(u,true,'A155')
else
call SetUnitAbilityLevel(u,'A155',GetUnitAbilityLevel(u,'A155')+1)
endif
call SetUnitInvulnerable(u,true)
call SetUnitTimeScale(u,0)
call SaveReal(h,id,100,SR(GetUnitX(u),GetUnitY(u),GetSpellTargetX(),GetSpellTargetY()))
set soundplay=SndN(888) // Sound\Music\mp3Music\AkainuE.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.025,true,function Trig_Magma_Charge_Actions2)
set u=null
set t=null
endfunction
function Trig_Dai_Funka_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A06V'
endfunction
function Trig_Dai_Funka_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local group g=LoadGroupHandle(h,id,4)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,5)
local integer l__idg=GetHandleId(g)
local integer l__ide
local player p=GetOwningPlayer(u)
local real dmg=GetHeroStr(u,true)*GetUnitAbilityLevel(u,'A06V')+100*GetUnitAbilityLevel(u,'A06V')
if SR(x,y,x1,y1)<=2000 then
call SetUnitX(l__d,x1+60*Cos(a))
call SetUnitY(l__d,y1+60*Sin(a))
call GroupEnumUnitsInRange(g,x1,y1,200,Base)
loop
set E=FirstOfGroup(g)
set l__ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,l__ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,l__idg,l__ide,E)
call SetControlToUnit(E,E, 2, "stun")
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Flameshock.mdx",E,"chest"))
endif
call GroupRemoveUnit(g,E)
endloop
call UnitApplyTimedLife(CreateUnit(p,'e02F',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e02G',x1,y1,a*bj_RADTODEG),'BTLF',2)
else
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
call DestroyTimer(t)
call DestroyGroup(g)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function Trig_Dai_Funka_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,CreateUnit(GetOwningPlayer(u),'e044',x+80*Cos(a),y+80*Sin(a),f))
call SaveGroupHandle(h,id,4,CreateGroup())
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveReal(h,id,5,a)
set soundplay=SndN(890) // Sound\Music\mp3Music\InugamiGuren.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
if GetUnitAbilityLevel(u,'A155')==0 and GetHeroLevel(u)>5 then
call UnitAddAbility(u,'A155')
call UnitMakeAbilityPermanent(u,true,'A155')
else
call SetUnitAbilityLevel(u,'A155',GetUnitAbilityLevel(u,'A155')+1)
endif
call SetUnitFacing(LoadUnitHandle(h,id,1),a*bj_RADTODEG)
call TimerStart(t,0.03,true,function Trig_Dai_Funka_Actions2)
set u=null
set t=null
endfunction
