local unit u=LoadUnitHandle(HH,id,0)
local integer idu=GetHandleId(u)
//local real dmg=GetHeroAgi(u,true)*(5.25+(0.25*GetUnitAbilityLevel(u,'A1BV')))*(1-LoadInteger(HH,idu,ComboCounterHash)*0.045)
local real dmg=GetHeroAgi(u,true)*(5.25+(0.25*GetUnitAbilityLevel(u,'A1BV')))
local real x=LoadReal(HH,id,6)
local real y=LoadReal(HH,id,7)
local real a=LoadReal(HH,id,3)
local real sc=0
local group g=LoadGroupHandle(HH,id,5)
local player p=GetOwningPlayer(u)
call PauseTimer(t)
call PauseUnit(u,false)
call ShakeCamera(0.25,15)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1BV',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1BU',true)
call UnitRemoveAbility(u,'A1BI')
loop
set E=FirstOfGroup(g)
exitwhen E==null
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Tidal.mdx",E,"head"))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX-Special.mdx",E,"head"))
set n=CreateUnit(p,'e11O',GetUnitX(E),GetUnitY(E),GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,1)
call SetUnitTimeScale(n,2)
set n=CreateUnit(p,'e03V',GetUnitX(E),GetUnitY(E),GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,1)
call SetUnitScale(n,2,2,2)
call SetUnitTimeScale(n,2)
call PauseUnit(E,false)
call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,false)
//call SetUnitInvulnerable(c,E,false)
call myCustomDamage(u,E,dmg,false,false,null,null,null)
//if dmg>GetHeroAgi(u,true)*(5.25+(0.25*GetUnitAbilityLevel(u,'A1BV')))*0.1 then
//call myCustomDamage(u,E,dmg,false,false,null,null,null)
//else 
//call myCustomDamage(u,E,GetHeroAgi(u,true)*(5.25+(0.25*GetUnitAbilityLevel(u,'A1BV')))*0.1,false,false,null,null,null)
//endif
call SetControlToUnit(E,E, 0.3, "stun")
call GroupRemoveUnit(g,E)
endloop
set x=x+575*Cos(a)
set y=y+575*Sin(a)
set n=CreateUnit(p,'e11O',x,y,GetRandomReal(0,359))
call SetUnitScale(n,6,6,6)
call UnitApplyTimedLife(n,1,1.5)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e11Q',x,y,GetRandomReal(0,359))
call SetUnitScale(n,6,6,6)
call UnitApplyTimedLife(n,1,1.5)
call SetUnitTimeScale(n,1.5)
call StartAbilityCooldown(GetUnitAbility(u, 'A1BU'), 0.01)
call CreateModeIndicatorFormDispellable(u, "ReplaceableTextures\\CommandButtons\\BTNNanaya32.blp", 20,'A1BN')
call SaveReal(HH,GetHandleId(GetOwningPlayer(u)),StringHash("CE"),20)
call UnitRemoveAbility(u,'A1BM')
call UnitAddAbility(u,'A1BN')
call ComboBar(u,-.5)
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
set u=null
set g=null
set p=null
set t=null
endfunction
function EShikiTwoCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local integer idu=GetHandleId(u)
local real dmg=GetHeroAgi(u,true)*10*(1+LoadInteger(HH,idu,ComboCounterHash)*0.05)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=0
local real y1=0
local real a=LoadReal(HH,id,3)
local real dist=LoadReal(HH,id,2)
local real fe=LoadReal(HH,id,4)
local real ig=30*bj_DEGTORAD
local group g=LoadGroupHandle(HH,id,5)
local integer is=0
local real sc=0
local player p=GetOwningPlayer(u)
local integer idp=GetHandleId(p)
if dist<950 then
    if IsTerrainPathable(GetUnitX(u),GetUnitY(u),PATHING_TYPE_FLYABILITY)==false  then
        set x=x+150*Cos(a)
        set y=y+150*Sin(a)
    endif
call SetUnitXY_1(u,x,y, false)
call SaveReal(HH,id,2,dist+150)
call SaveReal(HH,id,4,fe+0.8)
set n=CreateUnit(p,'e11F',x,y,fe*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,75-R2I(fe*15))
call SetUnitAnimation(n,"spell slam three")
call SetUnitAnimation(u,"spell slam three")
call UnitApplyTimedLife(n,1,0.25)
call SetUnitTimeScale(n,3)
call SetUnitFacing(u,fe*bj_RADTODEG)
set n=CreateUnit(p,'e116',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,155,75,255,GetRandomInt(50,255))
set sc=GetRandomReal(0.5,3)
call SetUnitScale(n,sc,sc,sc)
call UnitApplyTimedLife(n,1,0.7)
call SetUnitTimeScale(n,2.5)
set n=CreateUnit(p,'e116',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,155,75,255,GetRandomInt(50,255))
set sc=GetRandomReal(0.5,3)
call SetUnitScale(n,sc,sc,sc)
call UnitApplyTimedLife(n,1,0.7)
call SetUnitTimeScale(n,2.5)
set n=CreateUnit(p,'e116',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,155,75,255,GetRandomInt(50,255))
set sc=GetRandomReal(0.5,3)
call SetUnitScale(n,sc,sc,sc)
call UnitApplyTimedLife(n,1,0.7)
call SetUnitTimeScale(n,2.5)
set n=CreateUnit(p,'e116',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,155,75,255,GetRandomInt(50,255))
set sc=GetRandomReal(0.5,3)
call SetUnitScale(n,sc,sc,sc)
call UnitApplyTimedLife(n,1,0.7)
call SetUnitTimeScale(n,2.5)
loop
exitwhen is>=13
set n=CreateUnit(p,'e0ZH',x+400*Cos(ig*is),y+400*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,255,255,255,35)
call UnitApplyTimedLife(n,1,1)
call SetUnitTimeScale(n,1)
set is=is+1
endloop
set n=CreateUnit(p,'e0RV',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,2)
call SetUnitTimeScale(n,0.7)
call SetUnitVertexColor(n,255,255,255,50)
set n=CreateUnit(p,'e11N',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.4)
call SetUnitTimeScale(n,2)
call SetUnitFlyHeight(n,-50,0)
set n=CreateUnit(p,'e11P',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.8)
call SetUnitFlyHeight(n,100,0)
call GroupEnumUnitsInRange(G,x,y,250,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)and IsUnitInGroup(E,g)==false then
    if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
        call GroupAddUnit(g,E)
        call PauseUnit(E,true)
        call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,true)
        //call SetUnitInvulnerable(c,E,true)
    else
        call SaveReal(HH,id,2,dist+1500)
        call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,u)
        call SaveReal(HH,idu,ComboTimerHash,0)
        call SaveInteger(HH,idu,ComboCounterHash,0)
        call SetUnitTimeScale(LoadUnitHandle(HH,idp,ComboBarHash),-10000000)
    endif
endif
call GroupRemoveUnit(G,E)
endloop
loop
set E=GroupForEachUnit(g)
exitwhen E==null
call PauseUnit(E,true)
call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,true)
endloop
else
if IsTerrainPathable(GetUnitX(u),GetUnitY(u),PATHING_TYPE_FLYABILITY)==false  then
    set x=x+350*Cos(a)
    set y=y+350*Sin(a)
endif
call SetUnitXY_1(u,x,y, false)
call SetUnitTimeScale(u,0.5)
call SetUnitAnimation(u,"spell slam four")
call IssueImmediateOrder(u,"stop")
call PauseTimer(t)
call TimerStart(t,0.8,false,function EShikiTwoCast3)
endif
set g=null
set u=null
set p=null
set t=null
endfunction
function EShikiTwoCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local integer idu=GetHandleId(u)
local integer idp=GetHandleId(p)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
call SaveUnitHandle(HH,id,0,u)
call SaveReal(HH,id,2,0)
call SaveReal(HH,id,4,a)
call SaveReal(HH,id,3,a)
call SaveReal(HH,id,6,x)
call SaveReal(HH,id,7,y)
call SaveGroupHandle(HH,id,5,CreateGroup())
call PauseUnit(u,true)
call SetUnitAnimation(u,"spell slam three")
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG-30)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,1,0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+30)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,1,0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,1,0.4)
call SetUnitTimeScale(n,3)
call SetUnitTimeScale(LoadUnitHandle(HH,idp,ComboBarHash),100000)
call ComboBar(u,0)
call SaveReal(HH,idu,ComboTimerHash,2)
call SaveInteger(HH,idu,ComboCounterHash,LoadInteger(HH,idu,ComboCounterHash)+1)
call UnitAddAbility(u,'A1BI')
call UnitAddAbility(u,'A1BM')

if LoadInteger(HH,idu,ComboCounterHash)>5 and LoadInteger(HH,idu,ComboCounterHash)<8 then
    call SetUnitColor(LoadUnitHandle(HH,idp,ComboBarHash),PLAYER_COLOR_PURPLE)
elseif LoadInteger(HH,idu,ComboCounterHash)>7 then
    call SetUnitColor(LoadUnitHandle(HH,idp,ComboBarHash),PLAYER_COLOR_RED)
    if LoadUnitHandle(HH,idu,StringHash("CST"))==null then
        call SaveUnitHandle(HH,idu,StringHash("CST"),CreateUnit(p,'h06A',x,y,0))
    endif
endif
set soundplay=CreateSound("Sound\\Music\\mp3Music\\NanayaE2.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call SetWidgetMana(u, GetWidgetMana(u)-GetWidgetMaxMana(u)*LoadInteger(HH,idu,ComboCounterHash)*0.005)
call TimerStart(t,0.07,true,function EShikiTwoCast2)
set u=null
set p=null
set t=null
endfunction
function InitTrig_EShikiTwo takes nothing returns nothing
set gg_trg_EShikiTwo=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_EShikiTwo,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_EShikiTwo,Condition(function EShikiTwoCond))
call TriggerAddAction(gg_trg_EShikiTwo,function EShikiTwoCast)
endfunction
function EShikiNewTwoCond takes nothing returns boolean
    return GetSpellAbilityId()=='A23W'
endfunction
function EShikiNewTwoCast5 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(HH,id,0)
    local unit c=LoadUnitHandle(HH,id,1)
    local integer idu=GetHandleId(u)
    local real x=GetUnitX(c)
    local real y=GetUnitY(c)
    local real x1=GetUnitX(u)
    local real y1=GetUnitY(u)
    local real a=LoadReal(HH,idu,StringHash("ANQ"))
    local real dist=LoadReal(HH,id,2)
    local integer fe=LoadInteger(HH,id,4)
    local real he=LoadReal(HH,id,7)*((750-dist)/750)
    local real sc=0
    local player p=GetOwningPlayer(u)
    local group g=LoadGroupHandle(HH,id,11)
    call TextTagFull2(I2S(LoadInteger(HH,idu,ComboCounterHash))+" x COMBO!",x,y,175,75,255,255,p,0.023+0.001*LoadInteger(HH,idu,ComboCounterHash))
    if IsUnitInGroup(c,g)==false then
        call UnitRemoveAbility(c,'A1BJ')
    endif
    loop
    set E=FirstOfGroup(g)
    exitwhen E==null
    call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Tidal.mdx",E,"head"))
    call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX-Special.mdx",E,"head"))
    call SetControlToUnit(E,E, 0.3, "stun")
    set n=CreateUnit(p,'e11O',GetUnitX(E),GetUnitY(E),GetRandomReal(0,359))
    call UnitApplyTimedLife(n,1,1)
    call SetUnitTimeScale(n,2)
    set n=CreateUnit(p,'e03V',GetUnitX(E),GetUnitY(E),GetRandomReal(0,359))
    call UnitApplyTimedLife(n,1,1)
    call SetUnitScale(n,2,2,2)
    call SetUnitTimeScale(n,2)
    call myCustomDamage(u,E,GetHeroAgi(u,true)*(3.25+GetUnitAbilityLevel(u,'A23W')*.75),false,false,null,null,null)
    //if GetHeroAgi(u,true)*(3.25+GetUnitAbilityLevel(u,'A23W')*.75)*(1-LoadInteger(HH,idu,ComboCounterHash)*0.045)>GetHeroAgi(u,true)*(3.25+GetUnitAbilityLevel(u,'A23W')*.75)*0.1 then
    //call myCustomDamage(u,E,GetHeroAgi(u,true)*(3.25+GetUnitAbilityLevel(u,'A23W')*.75)*(1-LoadInteger(HH,idu,ComboCounterHash)*0.045),false,false,null,null,null)
    //else
    //call myCustomDamage(u,E,GetHeroAgi(u,true)*(3.25+GetUnitAbilityLevel(u,'A23W')*.75)*0.1,false,false,null,null,null)
    //endif
    call UnitRemoveAbility(E,'A1BJ')
    call GroupRemoveUnit(g,E)
    endloop
    call UnitRemoveAbility(u,'A1BK')
    if GetUnitAbilityLevel(u,'A1BM')==0 then
    call UnitRemoveAbility(u,'A1BI')
    endif
    call RemoveSaveHashTimedShiki(0.5,idu,StringHash("SKQ"),u)
    call SetUnitFlyHeight(u,0,0)
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(HH,id)
    set c=null
    set u=null
    set p=null
    set t=null
endfunction
