function TornadoCirculCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real dmg=(GetUnitAbilityLevel(u,'A0QR'))*(GetHeroAgi(u,true)+75)
local real dmg1=(3*GetHeroAgi(u,true))
local integer array idu
local integer ran=GetRandomInt(1,3)
local real time=LoadReal(h,id,5)
local real a=0
local group g=LoadGroupHandle(h,id,2)
local integer l__idg=GetHandleId(g)
local integer l__ide
if GetUnitCurrentOrder(u)==OrderId("heal")then
call GroupEnumUnitsInRange(g,x,y,275,Base)
call SetUnitFacing(u,GetRandomReal(0,359))
call UnitApplyTimedLife(CreateUnit(p,'e0H0',x,y,GetRandomReal(0,359)),'BTLF',0.2)
call UnitApplyTimedLife(CreateUnit(p,'e0H1',x,y,GetRandomReal(0,359)),'BTLF',0.2)
call UnitApplyTimedLife(CreateUnit(p,'e0H2',x,y,GetRandomReal(0,359)),'BTLF',0.2)
call UnitApplyTimedLife(CreateUnit(p,'e0H3',x,y,GetRandomReal(0,359)),'BTLF',0.2)
call UnitApplyTimedLife(CreateUnit(p,'e0H4',x,y,GetRandomReal(0,359)),'BTLF',0.2)
call UnitApplyTimedLife(CreateUnit(p,'e0H5',x,y,GetRandomReal(0,359)),'BTLF',0.2)
set n=CreateUnit(p,'e0GZ',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.15)
call SetUnitVertexColor(n,255,255,255,125)
call SetUnitTimeScale(n,5)
call SetUnitInvulnerable(u,true)
call SetUnitAnimation(n,"attack")
set n=CreateUnit(p,'e0H9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.7)
call SetUnitVertexColor(n,200,200,200,70)
call SaveReal(h,id,5,time+0.08)
if time>0.1 then
call SaveReal(h,id,5,0)
set a=GetRandomReal(0,7)
set idu[1]=0x65304836
set idu[2]=0x65304837
set idu[3]=0x65304838
call Slash(CreateUnit(p,idu[ran],x,y,a*bj_RADTODEG),100,dmg,a,1000,50,x,y,x,y)
endif
loop
set E=FirstOfGroup(g)
set l__ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)then
if E!=LoadUnitHandle(h,l__idg,l__ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,l__idg,l__ide,E)
endif
call Push(E,50,Atan2(GetUnitY(E)-y,GetUnitX(E)-x),300)
endif
call GroupRemoveUnit(g,E)
endloop
else
call SetUnitTimeScale(u,1)
call SetUnitInvulnerable(u,false)
call PauseTimer(t)
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
set p=null
set g=null
set u=null
set t=null
endfunction

function TorandoBeeLoop takes nothing returns nothing
        local integer id = GetHandleID()
        local integer time = LoadInt("Time")
        local real x = GetUnitX(LoadUnitHandle(HH,MUIHandle(),CasterHash))
        local real y = GetUnitY(LoadUnitHandle(HH,MUIHandle(),CasterHash))
        local real ang = LoadFloat("ang")
        local real tick = LoadFloat("tick")
        local real dmg = ((GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash),'A0QR'))*(GetHeroAgi(LoadUnitHandle(HH,MUIHandle(),CasterHash),true)+75))
    local group g=LoadGroup("Group")
    set idg=GetHandleId(LoadGroup("Group"))
        call ExtraTime()
        
        if time == 0 then
                set soundplay=SndN(1506) // Sound\war3mapImported\BeeW1.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                call SetUnitAnimation(LoadUnitHandle(HH,MUIHandle(),CasterHash), "spell channel")
        endif
        
        if GetUnitCurrentOrder(LoadUnitHandle(HH,MUIHandle(),CasterHash)) == OrderId("heal") and GetUnitTypeId(LoadUnitHandle(HH,MUIHandle(),CasterHash)) == 'H03I' then
                call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash),true)
                set EFF = AddSpecialEffect("war3mapImported\\DustWave.mdx",x,y)
                call SetSpecialEffectFacing(EFF , GetRandomReal(0,359))
                call SetSpecialEffectScale(EFF, GetRandomReal(0.5,4))
                call DestroyEffect(EFF)
                
                set n = CreateUnit(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)), 'e116',x,y, GetRandomReal(0,359))
                call SetUnitVertexColor(n, 255,255,255,120)
                call UnitAddAbility(n, 'Arav')
                call SetUnitFlyHeight(n, GetRandomReal(75,150),0)
                call UnitRemoveAbility(n, 'Arav')
                call SetUnitScale(n, GetRandomReal(0.5,4),GetRandomReal(0.5,4),GetRandomReal(0.5,4))
                call UnitApplyTimedLife( n,'BTLF', 0.8)
                set n = CreateUnit(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)), 'eo9R',x,y, GetRandomReal(0,359))
                call SetUnitVertexColor(n, 255,255,255,110)
                call UnitAddAbility(n, 'Arav')
                call SetUnitFlyHeight(n, GetRandomReal(75,150),0)
                call UnitRemoveAbility(n, 'Arav')
                call SetUnitScale(n, GetRandomReal(0.6,2),GetRandomReal(0.6,2),GetRandomReal(0.6,2))
                call UnitApplyTimedLife( n,'BTLF', 0.6)
                
                call GroupEnumUnitsInRange(g,x,y,550,Base)
        loop
            set E=FirstOfGroup(g)
            exitwhen E==null
            set ide=GetHandleId(E)
            if Condition_Base(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)),E) and LoadUnitHandle(h,idg,ide)!=E then
                                call myCustomDamage(LoadUnitHandle(HH,MUIHandle(),CasterHash),E,dmg,false,false,null,null,null)
                                call Push(E,25,Atan2(GetUnitY(E)-y,GetUnitX(E)-x),50)
                call SaveUnitHandle(h,idg,ide,E)
            elseif Condition_Base(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)),E) and E==LoadUnitHandle(h,idg,ide) then
                call myCustomDamage(LoadUnitHandle(HH,MUIHandle(),CasterHash),E,dmg*0.03,false,false,null,null,null)
                                call Push(E,25,Atan2(GetUnitY(E)-y,GetUnitX(E)-x),50)
            endif
            call GroupRemoveUnit(g,E)
        endloop 
        else
                call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash),false)
        call GroupClear(g)
                call Clear(id)
        call FlushChildHashtable(h,idg)
        endif
    set g=null
endfunction

function TornadoCirculCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local integer id2 = NewTimer(GetPlayerId(GetTriggerPlayer()))
if GetUnitTypeId(u) != 'H03I' then
        call SaveUnitHandle(h,id,0,u)
        call SaveGroupHandle(h,id,2,CreateGroup())
        call SaveReal(h,id,5,0)
        call SetUnitTimeScale(u,5)
        call SetUnitInvulnerable(u,true)
    set soundplay=SndN(1509) // Sound\Music\mp3Music\KillerBeeW.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        call TimerStart(t,0.08,true,function TornadoCirculCast2)
else
        call SaveAgentHandle(HH,id2, CasterHash, u)
        call SaveReal(HH,id2,TickHash,0)
        call SaveGroupHandle(HH,id2,GroupHash,CreateGroup())
        call SetUnitInvulnerable(u,true)
        call TimerStart(LoadTimer(GetPlayerId(GetTriggerPlayer())),0.06,true,function TorandoBeeLoop)
endif
set u=null
set t=null
endfunction
function TornadoCirculInit takes nothing returns nothing
endfunction
function MissleMoveSumiBunshinNoJutsu22 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local unit u=LoadUnitHandle(h,id,7)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
local real dist=LoadReal(h,id,6)
local real mh=LoadReal(h,id,5)
local real rd=SR(x,y,x1,y1)
local player p=GetOwningPlayer(u)
local integer idu=GetPlayerId(p)
if rd>30+speed and IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
call SetUnitPosition(l__d,x+speed*Cos(a),y+speed*Sin(a))
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,ParabolaZ(mh,dist,rd),0)
else
call SetUnitVertexColor(u,255,255,255,255)
call SetUnitFlyHeight(u,0,0)
call SetUnitPathing(l__d,true)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set p=null
set l__d=null
set t=null
endfunction
function MissleMoveSumiBunshinNoJutsu2 takes unit l__d,real speed,real angle,real x,real y,real mh,unit u returns nothing
