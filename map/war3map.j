function JeanneAlterGSlashMove takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real damage=LoadReal(HH,id,15)
local real time=LoadReal(HH,id,5)
local real x0=GetUnitX(LoadUnitHandle(HH,id,20))
local real y0=GetUnitY(LoadUnitHandle(HH,id,20))
local real x1=LoadReal(HH,id,11)
local real y1=LoadReal(HH,id,12)
local real distance=LoadReal(HH,id,8)//SR(x0,y0,x1,y1)
set time=time+0.02
call SaveReal(HH,id,5,time)
if distance<=0 or time>=5 or IsTerrainPathable(x1,y1,PATHING_TYPE_FLYABILITY)==true then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\JeanneAlterGHit.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call EffectCreateAndMove(true,"Others\\blue-guagnzhu-special.mdl",facing,1,2,1.5,100,40,100,0,100,LoadUnitHandle(HH,id,20),0,facing)
call EffectCreateAndMove(true,"Others\\MystoganExp1.mdl",facing,1,1.15,1.75,100,100,100,0,0,LoadUnitHandle(HH,id,20),0,facing)
call EffectCreateAndMove(true,"Others\\JeanneDark1mt_baozha1.mdl",facing,1,1.5,0.9,100,40,100,0,0,LoadUnitHandle(HH,id,20),0,facing)
call EffectCreateAndMove(true,"Others\\JeanneDark1mt_baozha1.mdl",facing,1,1.15,2,100,40,100,0,0,LoadUnitHandle(HH,id,20),0,facing)
call EffectCreateAndMove(true,"BlackGoku\\HakkeStart2.mdl",facing,1,2,1.5,100,100,100,50,0,LoadUnitHandle(HH,id,20),0,facing)
call GroupClear(G)
call GroupEnumUnitsInRange(G,GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),600,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if  Condition_Base(GetOwningPlayer(caster),n0) then


  if GetHeroLevel( caster )>=35 then
    call JanneAlterDecreaseDef( n0 , 10 )
  else
    call JanneAlterDecreaseDef( n0 ,5 )
  endif
call myCustomDamage(caster,n0,damage,false,false,null,null,null)


endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
call RemoveUnit(LoadUnitHandle(HH,id,20))
call RemoveUnit(LoadUnitHandle(HH,id,21))
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else
call MoveUnit(LoadUnitHandle(HH,id,20),LoadUnitHandle(HH,id,20),40,facing)
call MoveUnit(LoadUnitHandle(HH,id,20),LoadUnitHandle(HH,id,21),0,facing)
call SaveReal(HH,id,8,distance-40)
endif
set caster=null
endfunction
