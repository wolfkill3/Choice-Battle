endfunction
function GuraGuraCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real dist=0
local integer i=0
local player p=GetOwningPlayer(u)
call GroupEnumUnitsInRange(G,x,y,1500,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
if GetWidgetLife(E)>GetUnitState(E,UNIT_STATE_MAX_LIFE)*0.03 then
call myCustomDamage(u,E,GetUnitState(E,UNIT_STATE_MAX_LIFE)*0.03,false,false,null,null,null)
else
call SetUnitState(E,UNIT_STATE_LIFE,1)
endif
call SetControlToUnit(E,E, 0.5, "stun")
endif
call GroupRemoveUnit(G,E)
endloop
set p=null
set u=null
endfunction
