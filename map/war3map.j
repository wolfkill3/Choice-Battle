local real x=GetRectMaxX(gg_rct_GameZone)
local real x1=GetRectMinX(gg_rct_GameZone)
local real y=GetRectMaxY(gg_rct_GameZone)
local real y1=GetRectMinY(gg_rct_GameZone)
