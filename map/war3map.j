function MadaraSusanoAct takes unit caster0,integer typeSusano returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(caster0)
local integer idp=GetHandleId(p)
call SaveUnitHandle(HH,id,1,caster0)
call SaveInteger(HH,id,9,typeSusano)




if typeSusano==1 then
call SaveReal(HH,GetHandleId(caster0),StringHash("MadaraSusDur"),LoadReal(HH,GetHandleId(caster0),StringHash("MadaraSusDur"))+6+R2I((GetUnitState(caster0,UNIT_STATE_MANA)*0.001)))
call SaveReal(HH,id,10,LoadReal(HH,GetHandleId(caster0),StringHash("MadaraSusDur"))+6+R2I((GetUnitState(caster0,UNIT_STATE_MANA)*0.001)))
call SetUnitState(caster0,UNIT_STATE_MANA,GetUnitState(caster0,UNIT_STATE_MANA)-GetUnitState(caster0,UNIT_STATE_MAX_MANA)*0.1)
if LoadBoolean(HH,GetHandleId(caster0),StringHash("MadaraSusT"))==null and LoadBoolean(HH,GetHandleId(caster0),StringHash("MadaraSusT2"))==null and LoadUnitHandle(HH,GetHandleId(caster0),StringHash("MadaraSusano"))==null then
set n0=CreateUnit(GetOwningPlayer(caster0),'e211',GetUnitX(caster0),GetUnitY(caster0),GetUnitFacing(caster0))
call UnitSize(n0,14,1,1)
call SaveUnitHandle(HH,id,2,n0)
call TimerStart(t,0.02,true,function MadaraSusanoAct1)
call SaveUnitHandle(HH,GetHandleId(caster0),StringHash("MadaraSusano"),n0)
call SaveBoolean(HH,GetHandleId(caster0),StringHash("MadaraSusR"),true)
call CreateModeIndicatorWithPauseFormMadara(caster0, "ReplaceableTextures\\CommandButtons\\BTNMadaraR.blp", LoadReal(HH,GetHandleId(caster0),StringHash("MadaraSusDur")))
call SetFrameTexture( LoadFrameHandle(HH, idp,StringHash("ReplaceableTextures\\CommandButtons\\BTNMadaraR.blp")), "ReplaceableTextures\\CommandButtons\\BTNMadaraR.blp", 0, true )
call SetFrameTexture( LoadFrameHandle(HH, idp,StringHash("ReplaceableTextures\\CommandButtons\\BTNMadaraR.blp")), "ReplaceableTextures\\CommandButtons\\BTNMadaraR.blp", 1, true )
call SetFrameTexture( LoadFrameHandle(HH, idp,StringHash("ReplaceableTextures\\CommandButtons\\BTNMadaraR.blp")), "ReplaceableTextures\\CommandButtons\\BTNMadaraR.blp", 2, true )
else
call SaveReal(HH, GetHandleId(LoadFrameHandle(HH, idp,StringHash("ReplaceableTextures\\CommandButtons\\BTNMadaraR.blp"))), c_DURATION, LoadReal(HH,GetHandleId(caster0),StringHash("MadaraSusDur")))
endif


set n0=null
endif

if typeSusano==2 then
call SaveReal(HH,GetHandleId(caster0),StringHash("MadaraSusDur"),6+LoadReal(HH,GetHandleId(caster0),StringHash("MadaraSusDur")))
if LoadBoolean(HH,GetHandleId(caster0),StringHash("MadaraSusT"))==null and LoadBoolean(HH,GetHandleId(caster0),StringHash("MadaraSusT2"))==null then
if LoadUnitHandle(HH,GetHandleId(caster0),StringHash("MadaraSusano"))==null then
call CreateModeIndicatorWithPauseFormMadara(caster0, "ReplaceableTextures\\CommandButtons\\BTNMadaraR.blp", LoadReal(HH,GetHandleId(caster0),StringHash("MadaraSusDur")))
else
call RemoveUnit(LoadUnitHandle(HH,GetHandleId(caster0),StringHash("MadaraSusano")))
call SaveReal(HH, GetHandleId(LoadFrameHandle(HH, idp,StringHash("ReplaceableTextures\\CommandButtons\\BTNMadaraR.blp"))), c_DURATION, LoadReal(HH,GetHandleId(caster0),StringHash("MadaraSusDur")))
endif
call SetFrameTexture( LoadFrameHandle(HH, idp,StringHash("ReplaceableTextures\\CommandButtons\\BTNMadaraR.blp")), "ReplaceableTextures\\CommandButtons\\BTNMadaraT2.blp", 0, true )
call SetFrameTexture( LoadFrameHandle(HH, idp,StringHash("ReplaceableTextures\\CommandButtons\\BTNMadaraR.blp")), "ReplaceableTextures\\CommandButtons\\BTNMadaraT2.blp", 1, true )
call SetFrameTexture( LoadFrameHandle(HH, idp,StringHash("ReplaceableTextures\\CommandButtons\\BTNMadaraR.blp")), "ReplaceableTextures\\CommandButtons\\BTNMadaraT2.blp", 2, true )
call SetUnitState(caster0,UNIT_STATE_MANA,GetUnitState(caster0,UNIT_STATE_MANA)-GetUnitState(caster0,UNIT_STATE_MAX_MANA)*0.15)
call SaveReal(HH,id,10,LoadReal(HH,GetHandleId(caster0),StringHash("MadaraSusDur")))
call SaveBoolean(HH,GetHandleId(caster0),StringHash("MadaraSusT"),true)
set n0=CreateUnit(GetOwningPlayer(caster0),'e211',GetUnitX(caster0),GetUnitY(caster0),GetUnitFacing(caster0))
call UnitSize(n0,14,1,1)
call SetUnitAnimationByIndex(n0,6)
call SaveUnitHandle(HH,GetHandleId(caster0),StringHash("MadaraSusano"),n0)
call SaveUnitHandle(HH,id,2,n0)
set n0=CreateUnit(GetOwningPlayer(caster0),'e212',GetUnitX(caster0),GetUnitY(caster0),GetUnitFacing(caster0))
call UnitSize(n0,0.8,1,1)
call SaveUnitHandle(HH,id,20,n0)
call TimerStart(t,0.02,true,function MadaraSusanoAct2)
set n0=null
endif
endif

if typeSusano==3 then
call SaveReal(HH,GetHandleId(caster0),StringHash("MadaraSusDur"),8+LoadReal(HH,GetHandleId(caster0),StringHash("MadaraSusDur")))
if LoadBoolean(HH,GetHandleId(caster0),StringHash("MadaraSusT"))==null and LoadBoolean(HH,GetHandleId(caster0),StringHash("MadaraSusT2"))==null then
if LoadUnitHandle(HH,GetHandleId(caster0),StringHash("MadaraSusano"))==null then
call CreateModeIndicatorWithPauseFormMadara(caster0, "ReplaceableTextures\\CommandButtons\\BTNMadaraR.blp", LoadReal(HH,GetHandleId(caster0),StringHash("MadaraSusDur")))
//call CreateModeIndicatorWithPauseB(caster0, "|c00169EFAPerfect Susano:", LoadReal(HH,GetHandleId(caster0),StringHash("MadaraSusDur")))
else
//call SaveStr(HH, GetHandleId(caster0), c_NAME, "|c00169EFAPerfect Susano:")
call SaveReal(HH,id,10,LoadReal(HH,GetHandleId(caster0),StringHash("MadaraSusDur")))
call SaveReal(HH, GetHandleId(LoadFrameHandle(HH, idp,StringHash("ReplaceableTextures\\CommandButtons\\BTNMadaraR.blp"))), c_DURATION, LoadReal(HH,GetHandleId(caster0),StringHash("MadaraSusDur")))
call RemoveUnit(LoadUnitHandle(HH,GetHandleId(caster0),StringHash("MadaraSusano")))
endif
call SetFrameTexture( LoadFrameHandle(HH, idp,StringHash("ReplaceableTextures\\CommandButtons\\BTNMadaraR.blp")), "ReplaceableTextures\\CommandButtons\\BTNMadaraT1.blp", 0, true )
call SetFrameTexture( LoadFrameHandle(HH, idp,StringHash("ReplaceableTextures\\CommandButtons\\BTNMadaraR.blp")), "ReplaceableTextures\\CommandButtons\\BTNMadaraT1.blp", 1, true )
call SetFrameTexture( LoadFrameHandle(HH, idp,StringHash("ReplaceableTextures\\CommandButtons\\BTNMadaraR.blp")), "ReplaceableTextures\\CommandButtons\\BTNMadaraT1.blp", 2, true )
call SetUnitState(caster0,UNIT_STATE_MANA,GetUnitState(caster0,UNIT_STATE_MANA)-GetUnitState(caster0,UNIT_STATE_MAX_MANA)*0.15)
call TimerStart(t,0.02,true,function MadaraSusanoAct3)
endif
endif

set caster0=null
set p=null
set t=null
endfunction

// толчок для E в риннегане
function PushTimedMadara1 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local real time=LoadReal(HH,id,6)
local real distance=LoadReal(HH,id,8)
call MoveUnit(LoadUnitHandle(HH,id,1),LoadUnitHandle(HH,id,1),LoadReal(HH,id,2),LoadReal(HH,id,3))
set time=time+0.02
if time==0.02 then
set time=-0.1
call EffectCreateAndMove(true,"Madara\\[A]sandpoff123.mdl",GetRandomReal(0,360),1,1,1.25,100,100,100,0,0,LoadUnitHandle(HH,id,1),0,GetRandomReal(0,360))
endif
call SaveReal(HH,id,6,time)
if LoadReal(HH,id,2)<=0 then
set distance=distance-LoadReal(HH,id,2)
else
set distance=distance+LoadReal(HH,id,2)
endif
call SaveReal(HH,id,8,distance)
if distance>=LoadReal(HH,id,10)then
call PauseTimer(t)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set t=null
endfunction
function PushTimedMadara takes unit a00,real facing0,real distance0,real x00,real y00,real speed00 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(HH,id,1,a00)
call SaveReal(HH,id,2,speed00)
call SaveReal(HH,id,3,facing0)
call SaveReal(HH,id,8,SR(GetUnitX(a00),GetUnitY(a00),x00,y00))
call SaveReal(HH,id,10,distance0)
call TimerStart(t,0.02,true,function PushTimedMadara1)
set a00=null
set t=null
endfunction
// толчок для Т в шарингане
function PushTimed1 takes nothing returns nothing
