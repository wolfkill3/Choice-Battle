return GetSpellAbilityId()=='A0XQ'
endfunction
function GrappingHookCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,301)
local unit hd=LoadUnitHandle(h,id,302)
local real x=LoadReal(h,id,1)
local real y=LoadReal(h,id,2)
local real a=Atan2(LoadReal(h,id,4)-y,LoadReal(h,id,3)-x)
local real l__d=LoadReal(h,id,5)
local group g=LoadGroupHandle(h,id,6)
local player p=GetOwningPlayer(u)
local integer l__s=StringHash("chain")
local integer ss=StringHash("chain2")
local integer numb=LoadInteger(h,id,10)
local real dmg=(3+GetUnitAbilityLevel(u,'A0XQ'))*GetHeroInt(u,true)
local integer lvl=GetUnitAbilityLevel(u,'A0XQ')
local boolean b=LoadBoolean(h,id,300)
if l__d<1000+GetHeroInt(u,true)*12 and b==false then
set x=x+l__d*Cos(a)
set y=y+l__d*Sin(a)
call SetUnitX(hd,x+30*Cos(a))
call SetUnitY(hd,y+30*Sin(a))
set n=CreateUnit(p,'e0UP',x,y,a*bj_RADTODEG)
call SaveReal(h,id,5,l__d+30)
call UnitApplyTimedLife(n,1,30)
call SaveUnitHandle(h,id,ss+numb,n)
call SaveInteger(h,id,10,numb+1)
call GroupEnumUnitsInRange(g,x,y,100,Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set ide=GetHandleId(E)
if IsUnitAliveBJ(E)and GetWidgetLife(E)>0 and E!=u then
if b==false then
call SaveUnitHandle(h,id,301,E)
call SaveBoolean(h,id,300,true)
call IssueImmediateOrder(E, "stop")
call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",GetUnitX(E),GetUnitY(E)))
endif
endif
call GroupRemoveUnit(g,E)
endloop
else
if numb>=0 then
set n=LoadUnitHandle(h,id,ss+numb)
call RemoveUnit(n)
call SetUnitX(c,GetUnitX(n))
call SetUnitY(c,GetUnitY(n))
call SetUnitX(hd,GetUnitX(n)+30*Cos(a))
call SetUnitY(hd,GetUnitY(n)+30*Sin(a))
call SetUnitFacing(hd,a*bj_RADTODEG)
call SaveInteger(h,id,10,numb-1)
else
set idg=GetHandleId(g)
call PauseUnit(u,false)
call SetUnitTimeScale(u,1)
call SetUnitInvulnerable(u,false)
call PauseTimer(t)
call RemoveUnit(hd)
call DestroyTimer(t)
call DestroyGroup(g)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,idg)
endif
endif
set hd=null
set c=null
set p=null
set u=null
set g=null
set t=null
endfunction
function GrappingHookCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
local player p=GetOwningPlayer(u)
call SaveGroupHandle(h,id,6,CreateGroup())
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,302,CreateUnit(p,'e0UQ',x,y,a*bj_RADTODEG))
call SaveReal(h,id,1,x+50*Cos(a))
call SaveReal(h,id,8,2)
call SaveReal(h,id,2,y+50*Sin(a))
