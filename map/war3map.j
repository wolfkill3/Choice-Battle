endfunction
function LanzoDelRampagoCond takes nothing returns boolean
return GetSpellAbilityId()=='A0RU' and udg_B==true
endfunction
function LanzoDelRampagoCast2 takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(h,id,0)
        local unit l__d=LoadUnitHandle(h,id,1)
        local player p=GetOwningPlayer(u)
        local integer idu=GetPlayerId(p)
        local real x=LoadReal(h,id,3)
        local real y=LoadReal(h,id,4)
        local real x1=GetUnitX(l__d)
        local real y1=GetUnitY(l__d)
        local real f=GetUnitFacing(l__d)
        local real a=LoadReal(h,id,8)
        local real dmg=GetHeroAgi(u,true)*12
        local real Range=LoadReal(h,id,9)
        local real speed=LoadReal(h,id,11)
        local integer i=0
        if Range<4000 and UnitIsAlive(l__d)then
                set x1=x1+speed*Cos(a)
                set y1=y1+speed*Sin(a)
                // if Range>1000 then
                        // set a=a*GetRandomReal(0.95, 1.05)
                        // call SaveReal(h, id, 8, a)
                // endif
                call SetUnitXY_1(l__d,x1,y1, false)
                call SaveReal(h,id,3,x1)
                call SaveReal(h,id,4,y1)
                call SetUnitFacing(l__d,a*bj_RADTODEG)
                call SaveReal(h,id,9,Range+speed)
                call SaveReal(h,id,11,speed+1)
                call GroupEnumUnitsInRange(DG,x1,y1,140,Base)
                loop
                set E=FirstOfGroup(DG)
                exitwhen E==null
                        if Condition_Base(p,E)then
                                call RemoveUnit(l__d)
                        endif
                call GroupRemoveUnit(DG,E)
                endloop
        else
                call ShakeCamera(0.1, 15)
                call GroupEnumUnitsInRange(DG,x,y,800,Base)
                loop
                set E=FirstOfGroup(DG)
                exitwhen E==null
                        if Condition_Base(p,E)then
                                call myCustomDamage(u,E,dmg,false,false,null,null,null)
                        endif
                call GroupRemoveUnit(DG,E)
                endloop
                call UnitApplyTimedLife(CreateUnit(p,0x65305138,x,y,GetRandomReal(0,359)),1,3)
                call UnitApplyTimedLife(CreateUnit(p,0x65305139,x,y,GetRandomReal(0,359)),1,3)
                call RemoveUnit(l__d)
                call FlushChildHashtable(h,id)
                call PauseTimer(t)
                call DestroyTimer(t)
        endif
        set u=null
        set p=null
        set t=null
        set l__d=null
endfunction

function UlquiorraT_WaitTimer takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(h,id,0)
        local player p=GetOwningPlayer(u)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        local real a=LoadReal(h,id,8)
        local integer time=LoadInteger(h, id, 20)
        call SaveInteger(h, id, 20, time+1)
        if time==1 then
                call ShakeCamera(0.1, 5)
                call SaveReal(h, id, 8, a)
                call SetUnitFacing(u, a*bj_RADTODEG)
                call SetUnitAnimationByIndex(u, 16)
                call SetUnitTimeScale(u, 1.0)
                set soundplay=CreateSound("Sound\\Music\\mp3Music\\LanzaDelRelampagoThrow.mp3",false,false,true,12700,12700,"")
                call StartSound(soundplay)
                call KillSoundWhenDone(soundplay)
        elseif time==2 then
                set n=CreateUnit(GetOwningPlayer(u),'dM04',x,y,a*bj_RADTODEG)
                call SetUnitTimeScale(n, 0.8)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(u),'dM11',x,y,a*bj_RADTODEG)
                call SetUnitVertexColor(n, 0, 255, 175, 200)
                call MyRemoveUnit(n, 1.5)
                call ShakeCamera(0.1, 10)
                set n=CreateUnit(GetOwningPlayer(u),'e0Q7',x,y,a*bj_RADTODEG)
                call SaveUnitHandle(h,id,1,n)
                call PauseUnit(u, false)
                call SetUnitInvulnerable(u, false)
                call PauseTimer(t)
                call TimerStart(t,0.02,true,function LanzoDelRampagoCast2)
        endif
        set t=null
        set u=null
        set p=null
endfunction

function CastLanzoDelRampago takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
set n=CreateUnit(p, 'dM30', x, y, GetRandomInt(0, 360))
call SetUnitVertexColor(n, 0, 255, 175, 255)
call MyRemoveUnit(n, 1.5)
set n=CreateUnit(p, 'dM30', x, y, GetRandomInt(0, 360))
call SetUnitVertexColor(n, 0, 255, 175, 255)
call SetUnitScale(n, 1.5, 1.5, 1.5)
call MyRemoveUnit(n, 1.5)
set n=CreateUnit(p, 'dM32', x, y, GetRandomInt(0, 360))
call SetUnitVertexColor(n, 255, 255, 255, 100)
call UnitScale(n, 0.5, 1.7, 0.5)
call UnitApplyTimedLife(n, 1, 1.0)
call MyRemoveUnit(n, 1.5)
call PauseUnit(u, true)
call SetUnitInvulnerable(u, true)
call SetUnitAnimationByIndex(u, 15)
call SetUnitTimeScale(u, 1.25)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,8,a)
call SaveReal(h,id,11,50)
call RemoveEffect(AddSpecialEffectTarget("war3mapImported\\UlkiorraSpear.mdl", u, "right hand"), 0.8, true, CreateTimer())
call TimerStart(t,0.1,true,function UlquiorraT_WaitTimer)
set u=null
set p=null
set t=null
endfunction
function InitTrig_LanzoDelRampago takes nothing returns nothing
set gg_trg_LanzoDelRampago=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_LanzoDelRampago,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_LanzoDelRampago,Condition(function LanzoDelRampagoCond))
call TriggerAddAction(gg_trg_LanzoDelRampago,function CastLanzoDelRampago)
endfunction


function IchigoVaster_OvertimeForm_Periodic takes nothing returns nothing
    local timer t               =GetExpiredTimer()
    local integer id            =GetHandleId(t)
    local unit caster           =LoadUnitHandle(HH, id, c_CASTER)
    local player p              =LoadPlayerHandle(HH, id, c_PLAYER)
    local integer idp           =GetHandleId(p)
    local string mode_name      =LoadStr(HH, id, c_NAME)
    local framehandle NewFrame  =LoadFrameHandle(HH, idp,StringHash(mode_name))
    local real duration         =LoadReal(HH, GetHandleId(NewFrame), c_DURATION)-0.05
    local integer position         =LoadInteger(HH, id, c_POSITION)
    if position>0 then
        if LoadBoolean(HH,idp,position-1)==false then
        call SaveBoolean(HH,idp,position-1,true)
        call SaveBoolean(HH,idp,position,false)
        call SaveInteger(HH, id, c_POSITION,position-1)
        set position=position-1
        endif
    endif
    if IsUnitPaused(caster)==false and IsUnitHidden(caster)==false and GetUnitAbilityLevel(caster,'Pet1')==0 then
        call SaveReal           (HH, GetHandleId(NewFrame), c_DURATION, duration)
        call SetFrameText( LoadFrameHandle(HH, idp,StringHash(mode_name+"2")), R2SW(duration,2, 1) )
    endif
    call SetFrameRelativePoint( NewFrame, FRAMEPOINT_CENTER, StatusBarFrame, FRAMEPOINT_LEFT, 0.017+position*0.025, 0.005 )
    if duration<=0 or udg_B==false or DU2==false or UnitIsAlive(caster)==false then
        if udg_B and UnitIsAlive(caster) then
			call PauseUnit(caster, false)
			call ShowAbility2('IcQ1', true)
			call ShowAbility2('IcW1', true)
			call ShowAbility2('IcE1', true)
			call ShowAbility2('IcR1', true)
			call ShowAbility2('IcT1', true)
			call UnitAddAbility(caster, 'IcT7')
			call IssueImmediateOrder(caster, "bearform")
			call UnitRemoveAbility(caster, 'IcT7')
		endif
        call ShowFrame( NewFrame, false )
        call SaveReal(HH, GetHandleId(NewFrame), c_DURATION, 0)
        call SaveReal(HH, GetHandleId(LoadFrameHandle(HH, idp,StringHash(mode_name+"2"))), c_DURATION, 0)
        call SaveBoolean(HH,idp,position,false)
        call FlushChildHashtable(HH, id)
        call DestroyTimer(t)
    endif
    set t=null
    set caster=null
    set NewFrame=null
    set p=null
endfunction

function IchigoVaster_OvertimeForm takes unit newCaster, string newString, real newDur returns nothing
        local timer newTimer        = CreateTimer()
        local integer id            = GetHandleId(newTimer)
    local framehandle NewFrame  = null
    local framehandle NewFrameText  = null
    local player p              =GetOwningPlayer(newCaster)
    local integer idp           =GetHandleId(p)    
    local integer i=9
    local integer j=0
    if LoadFrameHandle(HH, idp,StringHash(newString))==null then    
        set NewFrame = CreateFrameByType( "SIMPLEBUTTON", newString, StatusBarFrame, "", 0 )
        call ClearFrameAllPoints( NewFrame )
        call SetFrameTexture( NewFrame, newString, 0, true )
        call SetFrameTexture( NewFrame, newString, 1, true )
        call SetFrameTexture( NewFrame, newString, 2, true )
        call SetFrameSize( NewFrame, .0237, .0237 )
        call SetFramePriority( NewFrame, 7 )
        call HandleListAddHandle(StatusBarFrameList[GetPlayerId(p)],NewFrame)
        call SetFrameParent(NewFrame,StatusBarFrame)
        call ShowFrame( NewFrame, GetOwningPlayer(GetUnitSelected(GetLocalPlayer()))==GetOwningPlayer(newCaster) and (IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(newCaster)) or GetPlayerId(GetLocalPlayer())==10 or GetPlayerId(GetLocalPlayer())==11))
        call ShowFrame( NewFrameText, GetOwningPlayer(GetUnitSelected(GetLocalPlayer()))==GetOwningPlayer(newCaster) and (IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(newCaster)) or GetPlayerId(GetLocalPlayer())==10 or GetPlayerId(GetLocalPlayer())==11))
        call SaveFrameHandle(HH,idp,StringHash(newString),NewFrame)
        //call SaveReal               (HH, GetHandleId(NewFrame), c_DURATION, 2)
        
        set NewFrameText=CreateFrameByType( "SIMPLETEXT", newString+"1", NewFrame, "", 0 )
        call ClearFrameAllPoints( NewFrameText )
        call SetFrameBlendMode( NewFrameText, 0, BLEND_MODE_BLEND )
        call SetFrameFont( NewFrameText, "Fonts\\FRIZQT__.TTF", .008, 0 )
        call SetFrameTextAlignment( NewFrameText, TEXT_JUSTIFY_CENTER, TEXT_JUSTIFY_LEFT )
        call SetFrameText( NewFrameText, R2SW(newDur,2, 1) )
        call SetFrameTextColour( NewFrameText, 0xFFFFA500 )
        call HandleListAddHandle(StatusBarFrameList[GetPlayerId(p)],NewFrameText)
        call ShowFrame( NewFrameText, GetOwningPlayer(GetUnitSelected(GetLocalPlayer()))==GetOwningPlayer(newCaster) and (IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(newCaster)) or GetPlayerId(GetLocalPlayer())==10 or GetPlayerId(GetLocalPlayer())==11))
        call SaveFrameHandle(HH,idp,StringHash(newString+"2"),NewFrameText)
    else
        if LoadReal(HH, GetHandleId(NewFrame), c_DURATION)<=0 then
            set NewFrame=LoadFrameHandle(HH, idp,StringHash(newString))
            set NewFrameText=LoadFrameHandle(HH, idp,StringHash(newString+"2"))
            call SetFrameText( NewFrameText, R2SW(newDur,2, 1) )
            call ShowFrame( NewFrame, GetOwningPlayer(GetUnitSelected(GetLocalPlayer()))==GetOwningPlayer(newCaster) and (IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(newCaster)) or GetPlayerId(GetLocalPlayer())==10 or GetPlayerId(GetLocalPlayer())==11))
            call ShowFrame( NewFrameText, GetOwningPlayer(GetUnitSelected(GetLocalPlayer()))==GetOwningPlayer(newCaster) and (IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(newCaster)) or GetPlayerId(GetLocalPlayer())==10 or GetPlayerId(GetLocalPlayer())==11))
        endif
    endif
    if LoadReal(HH, GetHandleId(NewFrame), c_DURATION)<=0 then
        loop
            exitwhen i==0
            if LoadBoolean(HH,idp,i)==false then
            call SaveBoolean(HH,idp,i,true)
            call SaveBoolean(HH,idp,i+1,false)
            set j=i
            endif
            set i=i-1
        endloop
        call SetFrameRelativePoint( NewFrame, FRAMEPOINT_CENTER, StatusBarFrame, FRAMEPOINT_LEFT, 0.017+j*0.025, 0.005 )
        call SetFrameRelativePoint( NewFrameText, FRAMEPOINT_BOTTOM, NewFrame, FRAMEPOINT_BOTTOM, .0, -.01 )
        call SaveUnitHandle         (HH, id, c_CASTER, newCaster)
        call SavePlayerHandle       (HH, id, c_PLAYER, GetOwningPlayer(newCaster))
        call SaveReal               (HH, GetHandleId(NewFrame), c_DURATION, newDur)
        call SaveReal               (HH, GetHandleId(NewFrameText), c_DURATION, newDur)
        call SaveInteger            (HH, id, c_POSITION, j)
        call SaveStr                (HH, id, c_NAME, newString)
        call TimerStart             (newTimer, 0.05, true, function IchigoVaster_OvertimeForm_Periodic)
    else
        call SaveReal           (HH, GetHandleId(NewFrame), c_DURATION, newDur)
        call SaveReal           (HH, GetHandleId(NewFrameText), c_DURATION, newDur)
    endif
    set newTimer=null
    set p=null
    set NewFrame=null
    set NewFrameText=null
endfunction

function IchigoVaster_Ressurection takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id = GetHandleId(newTimer)
    local unit caster = LoadUnitHandle(h, id, 0)
    local unit orihime = LoadUnitHandle(h, id, 2)
    local real time   = LoadReal(h, id, 1)+0.1
    call SaveReal(h, id, 1, time)
    if time==0.2 then 
        call SetUnitAnimation(caster, "death")
    endif
	if time<7.0 and UnitIsAlive(caster) then
		call PauseUnit(caster, true)
		call SetUnitInvulnerable(caster, true)
        call HealTextTag(orihime,caster,GetWidgetMaxLife(caster)*0.0043*myCustomHeal2(caster,1),"HealthRes")
        call HealTextTag(orihime,caster,GetWidgetMaxMana(caster)*0.0043*myCustomMana2(caster,1),"ManaRes")
		call SetWidgetLife(caster, GetWidgetLife(caster)+GetWidgetMaxLife(caster)*0.0043)
		call SetWidgetMana(caster, GetWidgetMana(caster)+GetWidgetMaxMana(caster)*0.0043)
	else
		if UnitIsAlive(caster) and udg_B then
			call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectCaster.mdl", caster, "origin"))
			call PauseUnit(caster, false)
			call SetUnitInvulnerable(caster, false)
			call ShowAbility2('IcQ1', false)
			call ShowAbility2('IcW1', false)
			call ShowAbility2('IcE1', false)
			call ShowAbility2('IcR1', false)
			call ShowAbility2('IcT1', false)
			call UnitAddAbility(caster, 'IcT6')
			call IssueImmediateOrder(caster, "bearform")
			call UnitRemoveAbility(caster, 'IcT6')
			call SetUnitAnimationByIndex(caster, 15)
            call IchigoVaster_OvertimeForm(caster, "war3mapImported\\BTNHollowIchigo.blp", 70)
        endif
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call FlushChildHashtable(h, id)
        call PauseTimer(newTimer)
        call DestroyTimer(newTimer)
    endif
    set newTimer = null
    set orihime   = null
    set caster   = null
endfunction

function OrehimeT_IchigoVaster takes unit u, unit newCaster returns nothing
        local timer newTimer = CreateTimer()
        local integer id    = GetHandleId(newTimer)
        local real caster_x = GetUnitX(newCaster)
        local real caster_y = GetUnitY(newCaster)
        local player p = GetOwningPlayer(newCaster)
        if UnitIsAlive(newCaster)==false then
                call SaveBoolean(h, id, 10, true)
                call ReviveHero(newCaster, caster_x, caster_y, false)
        else
                call SaveBoolean(h, id, 10, false)
        endif
        call SetUnitState(newCaster,UNIT_STATE_LIFE,1)
        call SetUnitState(newCaster,UNIT_STATE_MANA,1)
        call HealTextTag(u,newCaster,GetWidgetMaxLife(newCaster)*0.1*myCustomHeal2(newCaster,1),"HealthRes")
        call HealTextTag(u,newCaster,GetWidgetMaxMana(newCaster)*0.2*myCustomMana2(newCaster,1),"ManaRes")
        call SetWidgetLife(newCaster, GetWidgetMaxLife(newCaster)*0.1)
        call SetWidgetMana(newCaster, GetWidgetMaxMana(newCaster)*0.2)
    call RemoveTransformation(newCaster)
        if GetUnitTypeId(newCaster)=='HIc2' then
                call SaveBoolean(HH, GetHandleId(newCaster), 9595, true)
        endif
        call SetUnitInvulnerable(newCaster, true)
        call SetUnitAnimation(newCaster, "death")
        call PauseUnit(newCaster, true)
        set n=CreateUnit(p,'e10S',caster_x,caster_y,GetUnitFacing(newCaster))
        call UnitApplyTimedLife(n,3,7)
        call SetUnitVertexColor(n,255,0,0,255)
        call SetUnitTimeScale(n,0.25)
        set n=CreateUnit(p,'e11E',caster_x,caster_y,GetUnitFacing(newCaster))
        call UnitApplyTimedLife(n,3,7)
        call SetUnitTimeScale(n,0.5)
        set n=CreateUnit(p,0x65313144,caster_x,caster_y,GetUnitFacing(newCaster))
        call UnitApplyTimedLife(n,3,7)
        call SetUnitTimeScale(n,0.5)
        set n=CreateUnit(p,0x65313143,caster_x,caster_y,GetUnitFacing(newCaster))
        call UnitApplyTimedLife(n,3,7)
        call SetUnitTimeScale(n,0.25)
        call UnitApplyTimedLife(CreateUnit(p,0x65313241,caster_x,caster_y,GetRandomReal(0,359)),1,4)
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\OriSecret2.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        
        call SaveUnitHandle(h, id, 0, newCaster)
        call SaveUnitHandle(h, id, 2, u)
        call SaveReal(h, id, 1, 0.0)
        call TimerStart(newTimer, 0.1, true, function IchigoVaster_Ressurection)
        set p=null
        set newTimer=null
endfunction

function CeroOscurasCond takes nothing returns boolean
return GetSpellAbilityId()=='A0RR' and udg_B==true and GetUnitTypeId(GetTriggerUnit())=='H04J'
endfunction
function CeroOscurasCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=LoadReal(h,id,1)
local real y=LoadReal(h,id,2)
local real a=Atan2(LoadReal(h,id,4)-y,LoadReal(h,id,3)-x)
local real l__d=LoadReal(h,id,5)
local group g=LoadGroupHandle(h,id,6)
local player p=GetOwningPlayer(u)
local real dmg=(GetUnitAbilityLevel(u,'A0RR')+3)*(GetHeroAgi(u,true))+50+GetUnitAbilityLevel(u,'A0RR')*50
local real l__s=LoadReal(h,id,8)
local real speed=LoadReal(h,id,14)
if l__d<3000 then
set x=x+l__d*Cos(a)
set y=y+l__d*Sin(a)
set n=CreateUnit(p,0x65305135,x,y,(a*bj_RADTODEG))
call SetUnitScale(n,l__s,l__s,l__s)
call SaveReal(h,id,8,l__s+0.15)
call SaveReal(h,id,14,speed+1.5)
call UnitApplyTimedLife(n,1,1)
call SaveReal(h,id,5,l__d+speed)
call GroupEnumUnitsInRange(g,x,y,150+15*l__s,Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set ide=GetHandleId(E)
    if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
        call myCustomDamage(u,E,dmg,false,false,null,null,null)
        call SaveUnitHandle(h,idg,ide,E)
    endif
        call GroupRemoveUnit(g,E)
endloop
else
set idg=GetHandleId(g)
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,idg)
endif
set p=null
set u=null
set g=null
set t=null
endfunction
function CeroOscurasCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
local player p=GetOwningPlayer(u)
set x=x+75*Cos(a)
set y=y+75*Sin(a)
call UnitApplyTimedLife(CreateUnit(p,0x65305136,x,y,a*bj_RADTODEG),1,0.45)
call SaveGroupHandle(h,id,6,CreateGroup())
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,x)
call SaveReal(h,id,8,0.75)
call SaveReal(h,id,14,30)
call SaveReal(h,id,2,y)
call SaveReal(h,id,3,GetSpellTargetX())
call SaveReal(h,id,4,GetSpellTargetY())
set soundplay=CreateSound("Sound\\Music\\mp3Music\\CeroOscuras.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.013,true,function CeroOscurasCast2)
set p=null
set u=null
set t=null
endfunction
function InitTrig_CeroOscuras takes nothing returns nothing
set gg_trg_CeroOscuras=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_CeroOscuras,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_CeroOscuras,Condition(function CeroOscurasCond))
call TriggerAddAction(gg_trg_CeroOscuras,function CeroOscurasCast)
endfunction
function CeroBCond takes nothing returns boolean
return GetSpellAbilityId()=='A0RR' and udg_B==true and GetUnitTypeId(GetTriggerUnit())=='H045'
endfunction
function CeroBCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=LoadReal(h,id,1)
local real y=LoadReal(h,id,2)
local real a=Atan2(LoadReal(h,id,4)-y,LoadReal(h,id,3)-x)
local real l__d=LoadReal(h,id,5)
local group g=LoadGroupHandle(h,id,6)
local player p=GetOwningPlayer(u)
local real dmg=(GetUnitAbilityLevel(u,'A0RR')+1)*(GetHeroAgi(u,true))+50+GetUnitAbilityLevel(u,'A0RR')*50
local real l__s=LoadReal(h,id,8)
local real speed=LoadReal(h,id,14)
if l__d<3000 then
set x=x+l__d*Cos(a)
set y=y+l__d*Sin(a)
set n=CreateUnit(p,0x6530544A,x,y,(a*bj_RADTODEG))
call SetUnitColor(n,PLAYER_COLOR_LIGHT_BLUE)
call SetUnitScale(n,l__s+0.5,l__s+0.5,l__s+0.5)
call SaveReal(h,id,8,l__s+0.15)
call SaveReal(h,id,14,speed+1.5)
call UnitApplyTimedLife(n,1,1)
call SaveReal(h,id,5,l__d+speed)
call GroupEnumUnitsInRange(g,x,y,150+15*l__s,Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set ide=GetHandleId(E)
        //if (GetUnitTypeId(E)=='HIc1' or GetUnitTypeId(E)=='HIc2' or GetUnitTypeId(E)=='HIc3') and dmg>GetWidgetLife(E) and GetHeroLevel(E)>=25 and E!=LoadUnitHandle(h,idg,ide)then
        //      call OrehimeT_IchigoVaster(E)
        //      call SaveUnitHandle(h,idg,ide,E)
        //else
                if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
                        call myCustomDamage(u,E,dmg,false,false,null,null,null)
                        call SaveUnitHandle(h,idg,ide,E)
                endif
        //endif
        call GroupRemoveUnit(g,E)
endloop
else
set idg=GetHandleId(g)
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,idg)
endif
set p=null
set u=null
set g=null
set t=null
endfunction
