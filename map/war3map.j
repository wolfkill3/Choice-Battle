//call GroupAddUnit(g,n)
//call SetUnitAnimation(l__d,"Attack")
//call SaveReal(h,GetHandleId(n),0,2000)
//call SaveInteger(h,id,5,an+1)
set n=CreateUnit(p,'e0SX',x+155*Cos(a),y+155*Sin(a),a*bj_RADTODEG)
