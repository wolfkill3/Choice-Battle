local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit l__d=LoadUnitHandle(h,id,2)
local real speed=LoadReal(h,id,4)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real dist=SR(x,y,x1,y1)
local real mdist=LoadReal(h,id,6)
local real a=Atan2(y1-y,x1-x)+LoadReal(h,id,3)
local player p=GetOwningPlayer(u)
local integer idc=GetPlayerId(p)
if dist>40 then
set x=x+speed*Cos(a)
set y=y+speed*Sin(a)
call SetUnitFlyHeight(l__d,375*(dist/mdist),0)
call SetUnitXY_1(l__d,x,y, false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
else
call UnitApplyTimedLife(CreateUnit(p,'e0LG',x1,y1,GetRandomReal(0,359)),'BHwe',3)
call UnitApplyTimedLife(CreateUnit(p,'e0G3',x1,y1,GetRandomReal(0,359)),'BHwe',3)
call UnitApplyTimedLife(CreateUnit(p,'e0LF',x1,y1,GetRandomReal(0,359)),'BHwe',3)
call myCustomDamage(u,c,LoadReal(h,id,5),false,false,null,null,null)
if xun[idc]>5 then
set xun[idc]=0
if GetHeroLevel(u)>=6 then
call SetControlToUnit(u,c, 0.25, "stun")
call UnitApplyTimedLife(CreateUnit(p,'e0G1',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0G2',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0G3',x1,y1,GetRandomReal(0,359)),'BTLF',1)
endif
else
set xun[idc]=xun[idc]+1
endif
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
call KillUnit(l__d)
endif
set p=null
set l__d=null
set c=null
set t=null
set u=null
endfunction
