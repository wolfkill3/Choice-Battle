function GaeDearg_Periodic takes nothing returns nothing
        local integer id = GetHandleId(GetExpiredTimer())
        local unit target       = LoadUnitHandle(h, id, c_TARGET)
        local boolean bGaeDearg = LoadBoolean(HH, GetHandleId(target), GAE_DEARG_CONDITION)
        local real time         = LoadReal(h, id, c_TIME)
        if time<=10 and UnitIsAlive(target) then
                call SaveReal(h, id, c_TIME, time+0.025)
                if GetUnitAbilityLevel(target, 'cbc9')>=1 then
                    call UnitRemoveAbility(target, 'cbc9')
                endif
                // if time<=3 then
                        // call SetUnitInvulnerable(LoadUnitHandle(h, id, TargetHash), false)
                // endif 
                call SaveBoolean(HH, GetHandleId(target), GAE_DEARG_CONDITION, true)
        else
                call SaveBoolean(HH, GetHandleId(target), GAE_DEARG_CONDITION, false)
                call RemoveSavedBoolean(HH, GetHandleId(target), GAE_DEARG_CONDITION)
                call FlushChildHashtable(h, id)
                call DestroyTimer(GetExpiredTimer())
        endif
        set target=null
endfunction

function GaeDearg_Active takes unit newCaster, unit newTarget, real newAngle, timer newTimer returns nothing
        local integer id = GetHandleId(newTimer)
        local integer id_target = GetHandleId(newTarget)
        local real target_x = GetUnitX(newTarget)
        local real target_y = GetUnitY(newTarget)
        local real dmg = 4*(GetHeroAgi(newCaster,true)+GetHeroInt(newCaster, true))
        local boolean bControl = false
        local boolean bPaused = false
        set soundplay=CreateSound("Sound\\war3mapImported\\Gae_Dearg.mp3", false, false, true, 12700, 12700, "")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        if IsUnitPaused(newTarget) then
                set bPaused=true
                call PauseUnit(newTarget, false)
        endif
        if GetUnitAbilityLevel(newTarget, 'CBC2')>0 or GetUnitAbilityLevel(newTarget, 'cbc3')>0 or GetUnitAbilityLevel(newTarget, 'CBC1')>0 or GetUnitAbilityLevel(newTarget, 'cbc5')>0 or GetUnitAbilityLevel(newTarget, 'cbc6')>0 then
                set bControl = true
                call SaveBoolean(h, id, StringHash("Control"), true)
                call UnitRemoveAbility(newTarget, 'CBC2')
                call UnitRemoveAbility(newTarget, 'cbc3')
                call UnitRemoveAbility(newTarget, 'CBC1')
                call UnitRemoveAbility(newTarget, 'cbc5')
        call UnitRemoveAbility(newTarget, 'cbc6')
        endif
        //====== GAE DEARG снятие эффектов и щитов
        call UnitRemoveBuffs(newTarget,true,true)
        call UnitAddItemById(newTarget,'I06B')
        call UnitRemoveAbility(newTarget, 'cbc9')
        call UnitRemoveAbility(newTarget,'WAE1')
        if LoadReal(h, id_target, StringHash("ShieldBelfF"))>0 then   // Щит Бельфегора
                call SaveReal(h, id_target, StringHash("ShieldBelfF"), 0)
        else
                call SaveReal(h, id_target, StringHash("ShieldBelfF"), 0)
                call RemoveSavedReal(h, id_target, StringHash("ShieldBelfF"))
        endif
        if LoadReal(h, id_target, StringHash("YujiE_Shield"))>0 then  // Щит Юджи
                call SaveReal(h, id_target, StringHash("YujiE_Shield"), 0)
        else
                call RemoveSavedReal(h, id_target, StringHash("YujiE_Shield"))
        endif
        if GetUnitAbilityLevel(newTarget,'A1DF')>=1 then                  // Щит Шилдер Q
                call UnitRemoveAbility(newTarget,'A1DF')
                call SaveReal(h,id_target, StringHash("shi1"), 0)
                call SaveReal(h,id_target, StringHash("shi2"), 0)
        endif
        if GetUnitAbilityLevel(newTarget,'A1DG')>=1 then                  // Щит Шилдер E
                call UnitRemoveAbility(newTarget, 'A1DG')
        endif
        if GetUnitAbilityLevel(newTarget,'A10G')>=1 then                  // Щит Луизы
                call UnitRemoveAbility(newTarget, 'A10G')
        endif
        if GetUnitAbilityLevel(newTarget, 'A2DF')>0 then                      // Щит Броли
                call SaveReal(h,GetHandleId(newTarget),StringHash("BroEtime"),9)
        endif
        if GetUnitAbilityLevel(newTarget, 'A0VJ')>0 then                  // Гроза Вонголы
                call UnitRemoveAbility(newTarget, 'A0VJ')
        endif
        if GetUnitAbilityLevel(newTarget, 'A1HG')>0 then                  // Щит Орехи
                call UnitRemoveAbility(newTarget, 'A1HG')
        endif
        if GetUnitAbilityLevel(newTarget, 'A3DF')>0 then                  // Щит Waver
            call UnitRemoveAbility(newTarget, 'A3DF')
        endif
        if GetUnitAbilityLevel(newTarget, 'A1H1')>=1 then                 // Щит от Ульты Жанны Рулер
                call SetUnitInvulnerable(newTarget, false)
                call myCustomDamage(newCaster, newTarget, 220 , false , false , null , DAMAGE_TYPE_UNKNOWN , null) 
        endif
        if UnitHasItemOfTypeBJ(newTarget,'I03R') or UnitHasItemOfTypeBJ(newTarget,'I13R') then      // Сфера Пустоты или Броня Бороса
                call SetUnitInvulnerable(newTarget, false)
                call myCustomDamage(newCaster, newTarget, 600 , false , false , null , DAMAGE_TYPE_UNKNOWN , null) 
        endif
        //======
        if bControl then
                
        endif
        
        call SaveBoolean(HH, id_target, GAE_DEARG_CONDITION, true)
        //call myCustomDamage(newCaster, newTarget , dmg , false , false , null , null , null)
        
        if bPaused then
                call PauseUnit(newTarget, true)
        endif
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH02', target_x, target_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 2, 2, 2)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH15', target_x, target_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 2, 2, 2)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH39', target_x, target_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 1.2, 1.2, 1.2)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH40', target_x, target_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 1.2, 1.2, 1.2)
        call MyRemoveUnit(n, 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(newTarget), 'diGD', target_x, target_y, newAngle*bj_RADTODEG)
        call SaveUnitHandle(h, id, c_DUMMY1, bjLCU)
        call SaveUnitHandle(h, id, c_TARGET, newTarget)
        call TimerStart(newTimer, 0.025, true, function GaeDearg_Periodic)
endfunction

function GaeDeargThrow_Periodic takes nothing returns nothing
        local integer id = GetHandleId(GetExpiredTimer())
        local unit caster = LoadUnitHandle(h, id, c_CASTER)
        local real angle = LoadReal(h, id, c_ANGLE)
        local real distance = LoadReal(h, id, c_DISTANCE)
        local real speed = 7.5+distance*0.025
        local real dummy_x = GetUnitX(LoadUnitHandle(h, id, c_DUMMY1))
        local real dummy_y = GetUnitY(LoadUnitHandle(h, id, c_DUMMY1))
        if distance<2000 then
                call SetUnitX(LoadUnitHandle(h, id, c_DUMMY1), dummy_x+speed*Cos(angle))
                call SetUnitY(LoadUnitHandle(h, id, c_DUMMY1), dummy_y+speed*Sin(angle))
                call SaveReal(h, id, c_DISTANCE, distance+speed)
                if LoadInteger(h, id, c_EFFPERIOD)==0 then
                        set n=CreateUnit(GetOwningPlayer(caster), 'dH38', dummy_x, dummy_y, angle*bj_RADTODEG)
                        call SetUnitVertexColor(n, 255, 255, 255, 110)
                        call MyRemoveUnit(n, 1.0)
                        call SaveInteger(h, id, c_EFFPERIOD, 8)
                else
                        call SaveInteger(h, id, c_EFFPERIOD, LoadInteger(h, id, c_EFFPERIOD)-1)
                endif
                set bjLCG = LoadGroupHandle(h, id, c_GROUP1)
                call GroupEnumUnitsInRange(bjLCG, GetUnitX(LoadUnitHandle(h, id, c_DUMMY1)), GetUnitY(LoadUnitHandle(h, id, c_DUMMY1)), 125, Base)
                loop
                set bjLCU=FirstOfGroup(bjLCG)
                exitwhen bjLCU==null
                        if Condition_Base(GetOwningPlayer(caster), bjLCU) then
                                if GetUnitTypeId(bjLCU)=='e0VE' then // World Door Louise? hahaha fuck it
                                        call KillUnit(bjLCU)
                                else
                                        call GaeDearg_Active(caster, bjLCU, angle, CreateTimer())
                                        call SaveReal(h, id, c_DISTANCE, 22222)
                                        call GroupClear(bjLCG)
                                endif
                        endif
                        if GetUnitTypeId(bjLCU)=='h02Q' then
                                call UnitRemoveBuffs(bjLCU, true, true)
                        endif
                call GroupRemoveUnit(bjLCG, bjLCU)
                endloop
        else
                call DestroyGroup(LoadGroupHandle(h, id, c_GROUP1))
                call KillUnit(LoadUnitHandle(h, id, c_DUMMY1))
                call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY1), 0.2)
                call FlushChildHashtable(h, id)
                call DestroyTimer(GetExpiredTimer())
        endif
        set caster=null
endfunction

function GaeDeargThrow_Cast takes unit newCaster, real point_x, real point_y, timer newTimer returns nothing
        local integer id = GetHandleId(newTimer)
        local real caster_x = GetUnitX(newCaster)
        local real caster_y = GetUnitY(newCaster)
        local real angle = AtanPoint(caster_x, caster_y, point_x, point_y)
        if GetUnitAbilityLevel(newCaster, 'A1FU')==0 then
                set n=CreateUnit(GetOwningPlayer(newCaster), 'dR42', caster_x, caster_y, angle*bj_RADTODEG)
                call SetUnitFlyHeight(n, 50, 0)
                call SetUnitScale(n, 0.7, 0.7, 0.7)
                call MyRemoveUnit(n, 1.5)
                set bjLCU = CreateUnit(GetOwningPlayer(newCaster), 'diGD', caster_x, caster_y, angle*bj_RADTODEG) //e04I
                call SetUnitScale(bjLCU, 1.85, 1.85, 1.85)
                call SetUnitFlyHeight(bjLCU, 90, 0)
                call SetUnitAnimationByIndex(bjLCU, 1)
                call SaveUnitHandle(h, id, c_DUMMY1, bjLCU)
                call SaveUnitHandle(h, id, c_CASTER, newCaster)
                call SaveReal(h, id, c_ANGLE, angle)
                call SaveGroupHandle(h, id, c_GROUP1, CreateGroup())
                call TimerStart(newTimer, 0.01, true, function GaeDeargThrow_Periodic)
        endif
endfunction

function Trig_Gaedearg_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='IGDs' and GetUnitTypeId(GetTriggerUnit())!='H007'  and GetUnitAbilityLevel(GetTriggerUnit(),'GIE1')==0
endfunction

function Trig_Gaedearg_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit l__d=LoadUnitHandle(HH,id,1)
local unit c=LoadUnitHandle(HH,id,2)
local real a
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real f=GetUnitFacing(u)
if(SR_Storm_Ring(x,y,x1,y1)>47.00)then
set a=Atan2(y1-y,x1-x)
call SetUnitX(l__d,x+69*Cos(a))
call SetUnitY(l__d,y+69*Sin(a))
call SetUnitFacing(l__d,a*bj_RADTODEG)
call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e221',x,y,a*bj_RADTODEG),1,1.1)
else
call myCustomDamage(u,c,3*GetHeroAgi(u,true)+3*GetHeroInt(u,true),false,false,null,null,null)
if IsUnitInvulnerable(c)==false and UnitIsAlive(c) then
call ComboChecker(c,6,5, false )
endif
call RemoveUnit(l__d)
call DestroyTimer(t)
call FlushChildHashtable(HH, id)
endif
set u=null
set l__d=null
set t=null
set c=null
endfunction
function Trig_Gaedearg_Actions takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real f=GetUnitFacing(u)
call SaveUnitHandle(HH,id,0,u)
call SaveUnitHandle(HH,id,1,CreateUnit(GetOwningPlayer(u),'dR42',GetUnitX(u)+50.*Cos(f*bj_DEGTORAD),GetUnitY(u)+50.*Cos(f*bj_DEGTORAD),f))
call SaveUnitHandle(HH,id,2,GetSpellTargetUnit())
call TimerStart(t,0.04,true,function Trig_Gaedearg_Actions2)
set u=null
set t=null
endfunction

