loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function RapidSlashCast)
call TriggerAddCondition(t,Condition(function RapidSlashCond))
set t=null
endfunction
