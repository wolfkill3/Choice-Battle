local integer l__s=SH_Void
local integer s1=SH_VoidBuff
local integer i=GetRandomInt(1,6)
local integer id=GetPlayerId(GetOwningPlayer(u))
local integer r=LoadInteger(h,id,l__s)
local integer r1=LoadInteger(h,id,s1)
