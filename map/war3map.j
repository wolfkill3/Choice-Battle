local unit c=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local real dist=LoadReal(h,id,4)
if dist<1000 and GetWidgetLife(c)>0 and IsTerrainPathable(x1,y1,PATHING_TYPE_FLYABILITY)==false then
call SetUnitXY_1(c,x1+25*Cos(a),y1+25*Sin(a), false)
call SaveReal(h,id,4,dist+25)
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\NightElf\\NEDeathSmall\\NEDeathSmall.mdl",c,"origin"))
call DestroyEffect(AddSpecialEffect(" ",x1,y1))
call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e007',x1,y1,GetUnitFacing(u)),'BTLF',0.5)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set c=null
set t=null
endfunction
