    local real y=GetUnitY(l__d)
    local real x1=GetUnitX(u)
    local real y1=GetUnitY(u)
    local real dmg=LoadReal(h,id,4)
    local player p=GetOwningPlayer(u)
    local real s1=LoadReal(h,id,10)
    local real fl=LoadReal(h,id,20)
    local real time=LoadReal(h,id,15)
    if fl<2000 and UnitIsAlive(l__d)then
    call PauseUnit(c,true)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
    call CameraSetTargetNoiseEx(3*4.,3*Pow(10,2),true)
    call CameraSetSourceNoiseEx(3*4.,3*Pow(10,2),true)
    call UnitApplyTimedLife(CreateUnit(p,'e0QI',x,y,GetRandomReal(0,359)),1,0.01)
    call UnitApplyTimedLife(CreateUnit(p,'e0QG',x,y,GetRandomReal(0,359)),1,0.01)
    call UnitApplyTimedLife(CreateUnit(p,0x6530514B,x,y,GetRandomReal(0,359)),1,0.5)
    set n=CreateUnit(p, 'd054', x+GetRandomReal(-200, 200), y+GetRandomReal(-200, 200), GetRandomInt(0, 360))
    call SetUnitScale(n, 0.7, 0.7, 0.7)
    call SetUnitFlyHeight(n, 5, 0)
    call MyRemoveUnit(n, 0.4)
    call SetUnitX(l__d,x)
    call SetUnitY(l__d,y)
    set n=CreateUnit(p,0x65305942,x,y,a*bj_RADTODEG)
    call UnitApplyTimedLife(n,1,0.5-fl*0.0002)
    call SetUnitTimeScale(n,2)
    call SetUnitScale(n,1.5+s1,1.5+s1,1.5+s1)
    call SetUnitFlyHeight(n,fl,0)
    set n=CreateUnit(p,'e3PT',x,y,a*bj_RADTODEG)
    call UnitApplyTimedLife(n,1,0.5-fl*0.00025)
    call SetUnitTimeScale(n,1)
    call SetUnitScale(n,4.5+s1,4.5+s1,4.5+s1)
    call SetUnitFlyHeight(n,fl,0)
    call SetUnitFlyHeight(c,fl*0.8,0)
    call SetUnitXY_1(c,x,y, false)
    call SaveReal(h,id,2,dist-10)
    call SaveReal(h,id,20,fl+100)
    call SaveReal(h,id,10,s1+0.1)
    else
    call SetUnitInvulnerable(c,false)
    call PauseUnit(c,false)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
    call PauseUnit(u,false)
    call SetUnitInvulnerable(u,false)
    call myCustomDamage(u,c,dmg,false,false,null,null,null)
    call CameraSetTargetNoiseEx(0,0,true)
    call CameraSetSourceNoiseEx(0,0,true)
    call SetControlToUnit(u,c,1,"stun")
    call SetUnitFlyHeight(c,0,2400)
    call Push(c,50,a,600)
    call SetUnitTimeScale(u,1)
    call UnitApplyTimedLife(l__d,1,0.01)
    call RemoveUnit(l__d)
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(h,id)
    endif
    set u=null
    set t=null
    set l__d=null
    set p=null
endfunction
