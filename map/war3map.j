                call SaveReal(HH,GetHandleId(newTarget),MinusHealHash,LoadReal(HH,GetHandleId(newTarget),MinusHealHash)*0.75)
                call TimerStart(newTimer, 0.01, true, function OS_ReduceHeal_Periodic)
        endif
        
        call SaveReal(HH, GetHandleId(newTarget), ONIZUKASET_CONDITION, 5)
        
        set newTimer=null
endfunction

