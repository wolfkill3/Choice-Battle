function RegenerationAuraCond takes nothing returns boolean
return GetSpellAbilityId()=='A1SK' or GetSpellAbilityId()=='A0SK'
endfunction
function RegenerationAuraCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real l=GetWidgetLife(u)
local real m=GetWidgetMana(u)
local real lm=GetUnitState(u,UNIT_STATE_MAX_LIFE)
local real mm=GetUnitState(u,UNIT_STATE_MANA)
if GetUnitAbilityLevel(u,'BuF1')>0 and GetUnitAbilityLevel(u,'BNC1')==0 and GetUnitAbilityLevel(u,'BNC2')==0 and m>mm*0.03 and LoadBoolean(HH,GetHandleId(u),SST)==true then
    if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
        if l<lm*0.97 then
            call HealTextTag(u,u,mm*0.075*0.03*myCustomHeal2(u,1),"HealthRes")
            call SetUnitState(u,UNIT_STATE_LIFE,l+mm*0.075*0.03)
            call SetUnitState(u,UNIT_STATE_MANA,m-mm*0.05*0.03)
        endif
    endif
else
    call SaveBoolean(HH,GetHandleId(u),SS,false)
    call SaveBoolean(HH,GetHandleId(u),SST,false)
    call ShowAbility2('A1SK',false)
    call ShowAbility2('A0SK',true)
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(h,id)
    call UnitRemoveAbility(u,'BuF1')
endif
set u=null
set t=null
endfunction
function RegenerationAuraCast takes nothing returns nothing // Buu F
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
if GetSpellAbilityId()=='A0SK' then
call SaveUnitHandle(h,id,0,u)
call ShowAbility2Timed('A0SK',false,0.3)
call ShowAbility2Timed('A1SK',true,0.32)
call UnitAddAbility(u,'BuF1')
call SaveBoolean(HH,GetHandleId(u),SST,true)
set soundplay=SndN(1415) // Sound\Music\mp3Music\ActualRegen.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
call SaveBoolean(HH,GetHandleId(u),SST,false)
call ShowAbility2('A1SK',false)
call ShowAbility2('A0SK',true)
call UnitRemoveAbility(u,'BuF1')
endif
if LoadBoolean(HH,GetHandleId(u),SS)==false then
    call SaveBoolean(HH,GetHandleId(u),SS,true)
    call TimerStart(t,0.03,true,function RegenerationAuraCast2)
endif
set u=null
set t=null
endfunction
