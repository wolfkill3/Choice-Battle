local trigger tt=CreateTrigger()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real time=LoadReal(HH, GetHandleId(LoadFrameHandle(HH, GetHandleId(p),StringHash("ReplaceableTextures\\CommandButtons\\BTNRinW.blp"))), c_DURATION) //WRIN
if time>0 then
call SaveReal(HH, GetHandleId(LoadFrameHandle(HH, GetHandleId(p),StringHash("ReplaceableTextures\\CommandButtons\\BTNRinW.blp"))), c_DURATION,time+(0.5+0.25*GetUnitAbilityLevel(u,'A1FX'))/3)
endif
call SaveUnitHandle(h,id,0,u)
call SaveTriggerHandle(h,id,1,tt)
call SaveInteger(h,id,2,GetUnitAbilityLevel(u,'A1G1'))
call SaveReal(h,id,3,((GetUnitAbilityLevel(u,'A1G1')*0.05)+0.05)*GetHeroInt(u,true)+5)
call SetUnitTurnSpeed(u,400000)
call SetUnitAcquireRange(u,51)
call ShowAbility2('A1G1',false)
call UnitAddAbility(u,'A1G2')
set soundplay=CreateSound("Sound\\Music\\mp3Music\\ERin.mp3",false,false,true,12700,12700,"")
