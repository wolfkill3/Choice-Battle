function HandCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveReal(h,id,2,0)
call SaveReal(h,id,3,a)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG-30)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,1,0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+30)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,1,0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,1,0.4)
call SetUnitTimeScale(n,3)
call UnitAddAbility(u,'A195')
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Shiki3.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.01,true,function HandCast2)
set u=null
set p=null
set t=null
endfunction
function InitTrig_Hand takes nothing returns nothing
set gg_trg_Hand=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Hand,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_Hand,Condition(function HandCond))
call TriggerAddAction(gg_trg_Hand,function HandCast)
endfunction
function FatalityCond takes nothing returns boolean
return GetSpellAbilityId()=='A198'
endfunction
function FatalityCast8 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real dmg=GetHeroAgi(u,true)*(4+GetUnitAbilityLevel(u,'A198'))
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local integer i=LoadInteger(h,id,9)
local integer l__s=0
local real a=i*bj_PI/6
local real dist=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
call SetUnitFacing(u,a*bj_RADTODEG)
call PauseTimer(t)
call UnitRemoveAbility(u,'A195')
loop
exitwhen l__s==12
set n=CreateUnit(p,0x65305A4A,x1,y1,l__s*30)
call SetUnitVertexColor(n,255,255,255,255)
call UnitApplyTimedLife(n,1,0.5)
call SetUnitTimeScale(n,1.5)
set n=CreateUnit(p,'e0F6',x1,y1,l__s*30)
call SetUnitFlyHeight(n,90,0)
call SetUnitVertexColor(n,255,255,255,255)
call UnitApplyTimedLife(n,1,0.5)
call SetUnitTimeScale(n,1.5)
set l__s=l__s+1
endloop
call PauseUnit(l__d,false)
call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,false)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call SetUnitInvulnerable(u,false)
if GetWidgetLife(l__d)>dmg*0.25+5 then
call SetUnitState(l__d,UNIT_STATE_LIFE,GetWidgetLife(l__d)-dmg*0.25)
else
call SetUnitInvulnerable(l__d,false)
call UnitRemoveBuffs(l__d,true,true)
call UnitAddAbility(l__d,'A0WR')
call DamageIndicatorFunction(u,l__d,dmg)
call myCustomDamage(u,l__d,10000000,false,false,null,null,null)
call UnitRemoveAbility(l__d,'A0WR')
endif
call SetUnitInvulnerable(l__d,false)
call DamageTextTag(u,l__d,dmg*0.25)
call DamageIndicatorFunction(u,l__d,dmg*0.25)
call myCustomDamage(u,l__d,dmg-dmg*0.25,false,false,null,null,null)
call WeakenUnit(u,l__d,3,0.8, false )
call SlowUnit(u,l__d,0.6,0.6,3,2,false)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set l__d=null
set u=null
set p=null
set t=null
endfunction
