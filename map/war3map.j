call UnitApplyTimedLife(CreateUnit(p,'e0G2',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0G3',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call DestroyEffect(AddSpecialEffect("war3mapImported\\Slam.mdx",x1,y1))
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set l__d=null
set t=null
    set u=null
