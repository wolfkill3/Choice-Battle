local real dmg=.04*GetHeroStr(u,true)
local group g=CreateGroup()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
if m>mx*.02 and GetUnitAbilityLevel(u,'AcF1')>0 and GetWidgetLife(u)>0.5 and LoadBoolean(HH,GetHandleId(u),SST)==true then
if IsUnitPaused(u)==false and IsUnitHidden(u)==false then
call SetUnitState(u,UNIT_STATE_MANA,m-mx*0.015*.02)
call SetUnitXY_1(l__d,x,y, false)
call SetUnitFacing(l__d,GetUnitFacing(u))
call GroupEnumUnitsInRange(g,x,y,400,Base)
loop
set E=FirstOfGroup(g)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(g,E)
endloop
endif
else
call SaveBoolean(HH,GetHandleId(u),SS,false)
call SaveBoolean(HH,GetHandleId(u),SST,false)
call RemoveUnit(l__d)
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call ShowAbility2('A315',false)
call ShowAbility2('A015',true)
call UnitRemoveAbility(u,'AcF1')
call FlushChildHashtable(h,id)
endif
set g=null
set p=null
set u=null
set t=null
set l__d=null
endfunction
