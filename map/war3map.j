function CondStardustBreaker takes nothing returns boolean
return GetSpellAbilityId()=='A1P6' and GetUnitState(GetTriggerUnit(),UNIT_STATE_MAX_MANA)*0.20<GetUnitState(GetTriggerUnit(),UNIT_STATE_MANA) and udg_B==true
endfunction
function RemoveSaveHashTimedGogeta2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local real time=LoadReal(h,id,4)
if time<LoadReal(h,id,3)then
if GetUnitAbilityLevel(LoadUnitHandle(h,LoadInteger(h,id,1),LoadInteger(h,id,2)),'A1BJ')==0 then
call SaveReal(h,id,4,time+0.02)
endif
else
set n=LoadUnitHandle(h,id,5)
call ShowAbility2('A1P6',false)
call ShowAbility2('A0P6',true)
call RemoveSavedHandle(h,LoadInteger(h,id,1),LoadInteger(h,id,2))
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set t=null
endfunction
function RemoveSaveHashTimedGogeta takes real time,integer id,integer ip,unit u returns nothing
local timer t=CreateTimer()
local integer idt=GetHandleId(t)
call SaveInteger(h,idt,1,id)
call SaveInteger(h,idt,2,ip)
call SaveReal(h,idt,3,time)
call SaveReal(h,idt,4,0)
call SaveUnitHandle(h,idt,5,u)
call TimerStart(t,0.02,true,function RemoveSaveHashTimedGogeta2)
set t=null
endfunction
function GogetaRCond takes nothing returns boolean
return GetSpellAbilityId()=='A2FF'
endfunction
function GogetaRMissles2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real f=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,5)
local real y1=LoadReal(h,id,6)
local real a=Atan2(y1-y,x1-x)
local real sr=SR(x,y,x1,y1)
local real fl=sr/LoadReal(h,id,7)
if SR(x,y,x1,y1)>50 and l__d!=null and GetUnitFlyHeight(l__d)>10 then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
if IsTerrainPathable(GetUnitX(l__d),GetUnitY(l__d),PATHING_TYPE_FLYABILITY)==false then
call UnitApplyTimedLife(l__d,1,0.05)
endif
call SetUnitFacing(l__d,a*bj_RADTODEG)
if LoadInteger(h,id,9)==0 then
call SetUnitFlyHeight(l__d,ParabolaZ2(0,850,650,LoadReal(h,id,8),sr),0)
elseif LoadInteger(h,id,9)==1 then
call SetUnitFlyHeight(l__d,ParabolaZ2(10,850,90,LoadReal(h,id,8),sr),0)
elseif LoadInteger(h,id,9)==2 then
call SetUnitFlyHeight(l__d,ParabolaZ2(0,850,510,LoadReal(h,id,8),sr),0)
endif
call SaveReal(h,id,1,speed*0.984)
else
if l__d!=null then
call SetUnitFlyHeight(l__d,5,0)
call UnitRemoveAbility(l__d,'A1DB')
call UnitApplyTimedLife(l__d,1,0.03)
endif
if GetRandomInt(0,2)==1 then
set EFF=AddSpecialEffect("war3mapImported\\BlueBoom.mdx",GetUnitX(l__d),GetUnitY(l__d))
call SetSpecialEffectScale(EFF,0.65)
call SetSpecialEffectTimeScale(EFF , 3)
call DestroyEffect(EFF)
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set t=null
endfunction
function GogetaRMissles takes unit l__d,real speed,real a,real x,real y,unit u,integer mode returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,GetUnitFlyHeight(l__d))
call SaveReal(h,id,5,x)
call SaveReal(h,id,6,y)
call SaveReal(h,id,7,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,8,SR(x,y,GetUnitX(u),GetUnitY(u)))
call SaveInteger(h,id,9,mode)
call TimerStart(t,0.015,true,function GogetaRMissles2)
set t=null
endfunction
function GogetaRCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real dmg=GetHeroAgi(u,true)*(3+GetUnitAbilityLevel(u,'A2FF'))*0.1
local unit l__d=LoadUnitHandle(h,id,9)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,4)
local real y1=LoadReal(h,id,5)
local real x2=0
local real y2=0
local real sr2=0
