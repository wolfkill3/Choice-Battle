endfunction
function CastKH2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit l__d=LoadUnitHandle(HH,id,1)
local real a=LoadReal(HH,id,4)
local real dist=LoadReal(HH,id,5)
local real x=GetUnitX(l__d)+63*Cos(a)
local real y=GetUnitY(l__d)+63*Sin(a)
local real dmg=GetHeroAgi(u,true)*6
local group g=LoadGroupHandle(HH,id,3)
local integer idg2=GetHandleId(g)
local player p=GetOwningPlayer(u)
if dist<1500 and IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
call SetUnitXY_1(l__d,x,y, false)
set n=CreateUnit(p,'e062',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,1)
call UnitApplyTimedLife(CreateUnit(p,0x65303633,x,y,GetRandomReal(0,360)),1,2)
call GroupEnumUnitsInRange(g,x,y,175,Base)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(HH,idg2,ide)!=E then
call SaveUnitHandle(HH,idg2,ide,E)
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 1, "stun")
endif
call GroupRemoveUnit(g,E)
endloop
call SaveReal(HH,id,5,dist+63)
else
call RemoveUnit(l__d)
call FlushChildHashtable(HH,idg2)
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set g=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
function CastKH takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
call SaveUnitHandle(HH,id,0,u)
call SaveGroupHandle(HH,id,3,CreateGroup())
call SaveReal(HH,id,4,a)
call SaveUnitHandle(HH,id,1,CreateUnit(GetOwningPlayer(u),'e062',x,y,a*bj_RADTODEG))
call TimerStart(t,0.03,true,function CastKH2)
set u=null
set t=null
endfunction
