                                else
                                        call SaveUnitHandle( htMain, GetHandleId( htMain ), SH_CC_Dummy, n )
                                endif
                        endif
                        set i = i + 1
                endloop
    endfunction

function ResetSound2 takes nothing returns nothing
local integer l__h=GetHandleID()
local real mDur=LoadReal(HH,l__h,SH_Dur)
local real min=LoadReal(HH,l__h,SH_min)
if mDur>0 then
call SaveReal(HH,l__h,SH_Dur,mDur-0.1)
else
call KillSoundWhenDone(LoadSoundHandle(HH,l__h,SH_TriggeredSound))
call StopSound(LoadSoundHandle(HH,l__h,SH_TriggeredSound),false,false)
call Clear(l__h)
endif
endfunction
function ResetSound takes sound S,player WP returns nothing
local integer hId=GetPlayerId(WP)
local integer l__h=NewTimer(hId)
call SaveReal(HH,l__h,SH_Dur,GetSoundDuration(S)-0.03)
call SaveReal(HH,l__h,SH_min,0)
call SaveSoundHandle(HH,l__h,SH_TriggeredSound,S)
call TimerStart(LoadTimer(hId),0.1,true,function ResetSound2)
endfunction
function EnableUnitAbility2 takes unit whichUnit, integer abilCode, boolean show, boolean enable returns nothing
