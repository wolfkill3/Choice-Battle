        if time<0.9 then
        call SetUnitX(c,GetUnitX(c)-2*Cos(a))
        call SetUnitY(c,GetUnitY(c)-2*Sin(a))
        call SetUnitFlyHeight(c,he2-160,0)
        else
        if GetRandomInt(0,100) < 8 or GetUnitState(c,UNIT_STATE_LIFE)<(6*GetHeroAgi(u,true)) then
            if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
                set soundplay=CreateSound("Sound\\Music\\mp3Music\\Trunks T2.mp3",false,false,true,12700,12700,"")
            else
                set soundplay=CreateSound("Sound\\Music\\mp3Music\\Trunks\\Trunks T-jap.mp3",false,false,true,12700,12700,"")
            endif
        else
            if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
                set soundplay=CreateSound("Sound\\Music\\mp3Music\\Trunks T.mp3",false,false,true,12700,12700,"")
            else
                set soundplay=CreateSound("Sound\\Music\\mp3Music\\Trunks\\Trunks T-jap.mp3",false,false,true,12700,12700,"")
            endif
        endif
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        set n=CreateUnit(p,'e0PT',x+37*Cos(a),y+37*Sin(a),a*bj_RADTODEG)
        call UnitApplyTimedLife(n,1,2.7)
        call SetUnitScale(n,19,19,19)
        call SetUnitVertexColor(n,255,220,40,250)
        call SetUnitTimeScale(u,1)
        call SetUnitAnimationByIndex(u,38)
        call PauseTimer(t)
        call TimerStart(t,0.05,true,function HeatDomeAttackCast3)
        endif
        set l__d=null
        set p=null
        set u=null
        set t=null
endfunction
function HeatDomeAttackCast takes nothing returns nothing
    local unit u=GetTriggerUnit()
    local unit c=GetSpellTargetUnit()
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local player p=GetOwningPlayer(u)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetUnitX(c)
    local real y1=GetUnitY(c)
    local real a=GetUnitFacing(u)*bj_DEGTORAD
    if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
        call SaveUnitHandle(h,id,0,u)
        call SaveReal(h,id,10,0.05)
        call SaveReal(h,id,13,0.4)
        call SaveReal(h,id,14,100)
        call SaveReal(h,id,15,0)
        call SaveReal(h,id,11,Atan2(y1-y,x1-x))
        call SetUnitTimeScale(u,0)
        call SaveReal(h,id,18,6)
        call SaveReal(h,id,20,330)
        call SaveReal(h,id,17,6)
        call SetUnitInvulnerable(u,true)
        //    set n=CreateUnit(p,'e0TN',x,y,0)
        //    call UnitApplyTimedLife(n,1,4)
        call PauseUnit(c,true)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
        call SetUnitInvulnerable(c,true)
        call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
        call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x1,y1))
        call UnitAddAbility(c,'Arav')
        call UnitRemoveAbility(c,'Arav')
        call SetUnitFacingInstant(u,Atan2(y1-y,x1-x)*bj_RADTODEG)
        call SetUnitX(u,x1)
        call SetUnitY(u,y1)
        call SetUnitX(c,x1+60*Cos(a))
        call SetUnitY(c,y1+60*Sin(a))
        call SaveReal(h,id,4,11*GetHeroAgi(u,true))
        call SaveReal(h,id,2,100)
        call SaveReal(h,id,22,0)
        call SaveUnitHandle(h,id,0,u)
        call SaveUnitHandle(h,id,1,c)
        call PauseUnit(u,true)
        call SetUnitInvulnerable(u,true)
        call SetUnitTimeScale(u,1)
        call SetUnitAnimationByIndex(u,18)
        if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
            set soundplay=CreateSound("Sound\\Music\\mp3Music\\Trunks T3.mp3",false,false,true,12700,12700,"")
        else
            set soundplay=CreateSound("Sound\\Music\\mp3Music\\Trunks\\Trunks T3-jap.mp3",false,false,true,12700,12700,"")
        endif    
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        call TimerStart(t,0.05,true,function HeatDomeAttackCast2)
    else
        call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
        call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x1,y1))
        call SetUnitX(u,x1)
        call SetUnitY(u,y1)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
        call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
        call SetUnitAnimationByIndex(u,18)
        call PauseTimer(t)
        call DestroyTimer(t)
        call SetUnitVertexColor(u,255,255,255,255)
        call FlushChildHashtable(h,id)
    endif
    set u=null
    set p=null
    set t=null
    endfunction
function InitTrig_HeatDomeAttack takes nothing returns nothing
set gg_trg_HeatDomeAttack=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_HeatDomeAttack,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_HeatDomeAttack,Condition(function HeatDomeAttackCond))
call TriggerAddAction(gg_trg_HeatDomeAttack,function HeatDomeAttackCast)
endfunction
function ShiningSwordAttackCond takes nothing returns boolean
return GetSpellAbilityId()=='A0RB' and udg_B==true
endfunction
function MissleMoveShiningSwordAttack2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit l__d=LoadUnitHandle(h,id,2)
local real speed=LoadReal(h,id,4)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)+LoadReal(h,id,3)
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>1050 and UnitIsAlive(l__d) then
set x=x+4*speed*Cos(a)
set y=y+4*speed*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
else
call KillUnit(l__d)
call UnitApplyTimedLife(CreateUnit(p,'e0NJ',x1,y1,GetRandomReal(0,359)),1,3)
//call UnitApplyTimedLife(CreateUnit(p,'e0NK',x1,y1,GetRandomReal(0,359)),1,6)
call UnitApplyTimedLife(CreateUnit(p,'e0NI',x1,y1,GetRandomReal(0,359)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0NL',x1,y1,GetRandomReal(0,359)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0NM',x1,y1,GetRandomReal(0,359)),1,3)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call myCustomDamage(u,c,LoadReal(h,id,5),false,false,null,null,null)
call SetControlToUnit(u,c,1,"stun")
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
endif
set p=null
set l__d=null
set c=null
set t=null
set u=null
endfunction
function MissleMoveShiningSwordAttack takes unit u,unit c,unit dc,real speed,real angle,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveUnitHandle(h,id,2,dc)
call SaveReal(h,id,3,angle)
call SaveReal(h,id,4,speed)
call SaveReal(h,id,5,dmg)
call TimerStart(t,0.04,true,function MissleMoveShiningSwordAttack2)
set t=null
endfunction
function ShiningSwordAttackCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=LoadReal(h,id,3)
local real dmg=(GetUnitAbilityLevel(u,'A0RB')+2)*GetHeroAgi(u,true)+50
local player p=GetOwningPlayer(u)
local real dist=LoadReal(h,id,7)
local real time=LoadReal(h,id,8)
local real a2
if time<0.61 then
    call SaveReal(h,id,8,time+0.01)
    if time==0.6 then
        if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
            call SetUnitTimeScale(u,1)
            if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
                set soundplay=CreateSound("Sound\\Music\\mp3Music\\Trunks R.mp3",false,false,true,12700,12700,"")
            else
                set soundplay=CreateSound("Sound\\Music\\mp3Music\\Trunks\\Trunks R-jap.mp3",false,false,true,12700,12700,"")
            endif
            call StartSound(soundplay)
            call KillSoundWhenDone(soundplay)
            call SetUnitXY_1(u,x1,y1, false)
            call SaveReal(h,id,3,Atan2(y1-y,x1-x))
        else
            call SetUnitTimeScale(u,1)
            call SetUnitX(u,x1)
            call SetUnitY(u,y1)
            call PauseUnit(u,false)
            call SetUnitInvulnerable(u,false)
            call PauseUnit(c,false)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
            call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
            call PauseTimer(t)
            call DestroyTimer(t)
            call SetUnitVertexColor(u,255,255,255,255)
            call FlushChildHashtable(h,id)
        endif
    endif
else
if dist<650 then
call SetUnitXY_1(u,x+40*Cos(a),y+40*Sin(a), false)
set n=CreateUnit(p,0x65305051,x,y,a*bj_RADTODEG)
call MyRemoveUnit(n,0.1)
call SetUnitTimeScale(n,2)
call SetUnitVertexColor(n,255,255,255,125)
call SetUnitAnimation(n,"attack")
call SaveReal(h,id,7,dist+40)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
elseif dist>=950 then
set a2=Atan2(y1-y,x1-x)
set n=CreateUnit(p,'e0M1',x+225*Cos(a2),y+225*Sin(a2),a2*bj_RADTODEG)
call SetUnitVertexColor(n,0,0,0,0)
call SetUnitTimeScale(n,0)
call UnitApplyTimedLife(n,2,30)
call MissleMoveShiningSwordAttack(u,c,n,60,0,dmg)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),1,2)
call UnitApplyTimedLife(CreateUnit(p,'e04D',x1,y1,GetRandomReal(0,359)),1,2)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),1,2)
call UnitApplyTimedLife(CreateUnit(p,'e04D',x1,y1,GetRandomReal(0,359)),1,2)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),1,2)
call UnitApplyTimedLife(CreateUnit(p,'e04D',x1,y1,GetRandomReal(0,359)),1,2)
call UnitApplyTimedLife(CreateUnit(p,'e0HM',x1,y1,GetRandomReal(0,359)),1,1.4)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call UnitRemoveAbility(u,'A1O2')
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
elseif dist>=650 and dist <690 then
call SaveReal(h,id,7,dist+40)
elseif dist>=690 and dist <950 then
call SaveReal(h,id,7,dist+4)
endif
endif
set p=null
set c=null
set u=null
set t=null
endfunction
function ShiningSwordAttackCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local integer i=0
local player p=GetOwningPlayer(u)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call UnitAddAbility(u,'A1O2')
call SetUnitTimeScale(u,0.4)
call SetUnitAnimationByIndex(u,25)
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Trunks R1.mp3",false,false,true,12700,12700,"")
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Trunks\\Trunks R1-jap.mp3",false,false,true,12700,12700,"")
endif
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call TimerStart(t,0.01,true,function ShiningSwordAttackCast2)
set u=null
set c=null
set p=null
set t=null
endfunction
function InitTrig_ShiningSwordAttack takes nothing returns nothing
set gg_trg_ShiningSwordAttack=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_ShiningSwordAttack,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_ShiningSwordAttack,Condition(function ShiningSwordAttackCond))
call TriggerAddAction(gg_trg_ShiningSwordAttack,function ShiningSwordAttackCast)
endfunction
function DubleBusterCond takes nothing returns boolean
return GetSpellAbilityId()=='A0RA'
endfunction
function DubleBusterCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,5)
local unit d1=LoadUnitHandle(h,id,1)
local unit d2=LoadUnitHandle(h,id,4)
local real x2=LoadReal(h,id,2)
local real y2=LoadReal(h,id,3)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local group g=LoadGroupHandle(h,id,6)
local real x3
local real y3
local real a=Atan2(y2-y1,x2-x1)
local real a2
local player p=GetOwningPlayer(u)
local real dmg=(GetHeroAgi(u,true)+50)*(GetUnitAbilityLevel(u,'A0RA')+2)
local integer l__idg=GetHandleId(g)
if SR(x1,y1,x2,y2)>26.00 then
set x1=x1+47*Cos(a)
set y1=y1+47*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
if GetUnitAbilityLevel(u,'A16T')>0 or GetUnitAbilityLevel(u,'A26T')>0 then
set dmg=dmg+1*GetHeroAgi(u,true)
endif
call GroupEnumUnitsInRange(g,x1,y1,200,Base)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call DestroyEffect(AddSpecialEffect("war3mapImported\\Slam.mdx",GetUnitX(E),GetUnitY(E)))
call SaveUnitHandle(h,l__idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
set x2=x1+75*Cos(a)
set y2=y1+75*Sin(a)
call SetUnitX(d1,x2)
call SetUnitY(d1,y2)
set n=CreateUnit(p,'e0FZ',x2,y2,a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,1.2)
else
call UnitApplyTimedLife(CreateUnit(p,'e048',x1,y1,0),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e03W',x1,y1,0),0,4)
call UnitApplyTimedLife(CreateUnit(p,'e06O',x1,y1,0),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e06N',x1,y1,0),1,3)
call DestroyEffect(AddSpecialEffect("war3mapImported\\explode.mdx",x1,y1))
call DestroyEffect(AddSpecialEffect("war3mapImported\\SuperBigExplosion.mdx",x1,y1))
call GroupEnumUnitsInRange(G,x1,y1,400,Base)
loop
set E=FirstOfGroup(G)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)then
if E!=LoadUnitHandle(h,l__idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SlowUnit(u,E,0.5,0,5,0,false)
endif
call Push(E,40,Atan2(GetUnitY(E)-y2,GetUnitX(E)-x2),600)
endif
call GroupRemoveUnit(G,E)
endloop
call PauseTimer(t)
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call RemoveUnit(l__d)
call RemoveUnit(d1)
call RemoveUnit(d2)
endif
set g=null
set l__d=null
set d1=null
set d2=null
set p=null
set u=null
set t=null
endfunction
function DubleBusterCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,x1)
call SaveReal(h,id,3,y1)
call SaveGroupHandle(h,id,6,CreateGroup())
set n=CreateUnit(p,'e0M1',x+25*Cos(a),y+25*Sin(a),a*bj_RADTODEG)
call SetUnitTimeScale(n,3.5)
call SaveUnitHandle(h,id,1,n)
call SaveUnitHandle(h,id,5,CreateUnit(p,0x65305052,x+75*Cos(a),y+75*Sin(a),a*bj_RADTODEG))
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Trunks3.mp3",false,false,true,12700,12700,"")
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Trunks\\Trunks3-jap.mp3",false,false,true,12700,12700,"")
endif
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.025,true,function DubleBusterCast2)
set u=null
set p=null
set t=null
endfunction
function InitTrig_DubleBuster takes nothing returns nothing
set gg_trg_DubleBuster=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_DubleBuster,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_DubleBuster,Condition(function DubleBusterCond))
call TriggerAddAction(gg_trg_DubleBuster,function DubleBusterCast)
endfunction
