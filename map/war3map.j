function DanzoChoice_Cond takes nothing returns boolean
if GetSpellAbilityId()=='DSF1' or GetSpellAbilityId()=='DSG1' or GetSpellAbilityId()=='DSQ1' or GetSpellAbilityId()=='DSW1' or GetSpellAbilityId()=='DSW2' or GetSpellAbilityId()=='DSE1' or GetSpellAbilityId()=='DSR1' or GetSpellAbilityId()=='DST1' then
return true
else
return false
endif
endfunction

function InitTrig_DanzoChoice takes nothing returns nothing
        local trigger trig=CreateTrigger()
        local integer index
        set index=0
        loop
        call TriggerRegisterPlayerUnitEvent(trig,Player(index),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
        set index=index+1
        exitwhen index==bj_MAX_PLAYER_SLOTS
        endloop
call TriggerAddCondition(trig,Condition(function DanzoChoice_Cond))
call TriggerAddAction(trig,function DanzoChoice_Act)
set trig=null
endfunction

///Danzo End
