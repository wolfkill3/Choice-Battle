endfunction
function MadaraRAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real damage=GetHeroInt(caster,true) * (2+GetUnitAbilityLevel(caster,'AMUR'))
set time=time+0.02
call SaveReal(HH,id,5,time)
if time==1 then
call PauseUnit(caster,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)

else

if time<1 then
call PauseUnit(caster,true)
endif

if time==0.02 then


if LoadBoolean(HH,GetHandleId(caster),SH_MadaraSusT2)==true then
call SetUnitTimeScale(caster,5)
call SetUnitAnimationByIndex(caster,4)
elseif LoadUnitHandle(HH,GetHandleId(caster),SH_MadaraSusano)!=null then
call SetUnitAnimationByIndex(LoadUnitHandle(HH,GetHandleId(caster),SH_MadaraSusano),16)
endif

call EffectCreateAndMove(true,"Madara\\[A]RinRfire1.mdl",GetRandomInt(0,360),1,1.5,2,100,100,100,60,0,caster,0,facing)
call SaveReal(HH,id,3,GetUnitFacing(caster))
set soundplay=SndN(3535) // war3mapimported\MadaraR.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять

call GroupClear(G)
call GroupEnumUnitsInRange(G,GetUnitX(caster),GetUnitY(caster),450,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if  Condition_Base(GetOwningPlayer(caster),n0)  then
//call UnitStop(n0)
call myCustomDamage(caster,n0,damage,false,false,null,null,null)
call SetControlToUnit(caster,n0, 1.5, "stun")
call PushTimedMadara(n0,Angle2(GetUnitX(n0),GetUnitY(n0),GetUnitX(caster),GetUnitY(caster)),600,GetUnitX(caster),GetUnitY(caster),-30)
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)


endif

if time==0.02 or time==0.32 or time==0.62 or time==0.92 then
call EffectCreateAndMove(true,"Madara\\[A]az_axe_ef1.mdl",GetRandomInt(0,360),1,GetRandomReal(1.25,2),GetRandomReal(0.3,0.6),70,70,100,30,0,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\HakenSaber2.mdl",GetRandomInt(0,360),1,GetRandomReal(1.25,2),GetRandomReal(0.5,1),70,70,100,30,0,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\WindNewFaw4.mdl",GetRandomInt(0,360),1,GetRandomReal(1.25,2),GetRandomReal(0.5,1),70,70,100,30,100,caster,0,facing)
endif

if time==0.5 then
if LoadBoolean(HH,GetHandleId(caster),SH_MadaraSusT2)==true then
call SetUnitTimeScale(caster,1)
endif
call EffectCreateAndMove(true,"Madara\\az_siwen.mdl",GetRandomInt(0,360),1.5,2.5,0.3,100,100,100,30,100,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\blue-blink.mdl",GetRandomInt(0,360),1.5,4,0.3,100,100,100,0,0,caster,0,facing)
call MadaraRSlashesh(caster,LoadReal(HH,id,3)+45,3*GetHeroInt(caster,true))
call MadaraRSlashesh(caster,LoadReal(HH,id,3)-45,3*GetHeroInt(caster,true))
call MadaraRSlashesh(caster,LoadReal(HH,id,3)+135,3*GetHeroInt(caster,true))
call MadaraRSlashesh(caster,LoadReal(HH,id,3)-135,3*GetHeroInt(caster,true))
endif

endif

set t=null
set caster=null
endfunction






