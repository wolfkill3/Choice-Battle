endfunction
function IzanamiCast4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local integer idu=GetHandleId(c)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,4)
local real y1=LoadReal(h,id,5)
local real dmg=LoadReal(h,idu,StringHash("dmg2"))
call SetUnitXY_1(c,x1,y1, false)
call CinematicFadeBJCustom(bj_CINEFADETYPE_FADEIN,1,"ReplaceableTextures\\CameraMasks\\DreamFilter_Mask.blp",255,55,55,0)
call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),0x65305737,x1,y1,GetRandomReal(0,359)),0,0.01)
call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",x1,y1))
call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",x1,y1))
call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",x1,y1))
call myCustomDamage(u,c,dmg*0.25,false,false,null,null,null)
call RemoveSavedReal(h,idu,StringHash("dmg2"))
call RemoveSavedHandle(h,idu,StringHash("u2"))
call RemoveSavedHandle(h,idu,StringHash("c2"))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set u=null
set c=null
set t=null
endfunction
