call SaveReal(HH,id,27,timeleft)
set facing0=Angle2(GetUnitX(caster0),GetUnitY(caster0),GetUnitX(target1),GetUnitY(target1))
set n0=CreateUnit(GetOwningPlayer(caster0),'e200',GetUnitX(caster0),GetUnitY(caster0),facing0)
call SetUnitModel(n0,"BlackGoku\\[AB]eros.mdl")
call UnitSize(n0,1.5,1,1)
call UnitSpeed(n0,1)
call UnitColor(n0,100,100,100,0)
call SetUnitFlyHeight(n0,GetUnitFlyHeight(caster0)+GetRandomInt(100,250),0)
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
if GetRandomInt(1,2)==1 then
call MoveUnit(caster0,n0,GetRandomInt(50,150),facing0+90)
else
call MoveUnit(caster0,n0,GetRandomInt(50,150),facing0-90)
endif
call MoveUnit(n0,n0,GetRandomInt(50,150),facing0)
call UnitSpeed(n0,1)
call SaveReal(HH,id,9,randomspeed)
call SaveReal(HH,id,3,facing0)
call SaveUnitHandle(HH,id,20,n0)
call SetUnitFacing(n0,Angle2(GetUnitX(n0),GetUnitY(n0),GetUnitX(target1),GetUnitY(target1)))
set n0=null
call TimerStart(t,0.02,true,function BlackGokGEBalls1)
set caster0=null
set target1=null
set t=null
endfunction







