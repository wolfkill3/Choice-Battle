        elseif GetUnitTypeId(u)=='H16B' then
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\NeroSaber1W.mp3",false,false,true,12700,12700,"")
        call SetSoundVolumeBJ(soundplay,150)
