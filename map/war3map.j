local real y1=GetUnitY(Dummy)
local real damage=LoadReal(HH,id,15)



call MoveUnit(LoadUnitHandle(HH,id,20),LoadUnitHandle(HH,id,21),0,facing)


if LoadUnitHandle(HH,GetHandleId(Dummy),SH_AizenTKillU)!=null then
call AizenTPassiveAct(caster,LoadUnitHandle(HH,GetHandleId(Dummy),SH_AizenTKillU),Dummy)
