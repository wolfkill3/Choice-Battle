if i==1 then
call DestroyEffect(AddSpecialEffectTarget(l__s,u,"head"))
elseif i==2 then
call DestroyEffect(AddSpecialEffectTarget(l__s,u,"chest"))
elseif i==3 then
call DestroyEffect(AddSpecialEffectTarget(l__s,u,"right hand"))
elseif i==4 then
call DestroyEffect(AddSpecialEffectTarget(l__s,u,"left hand"))
elseif i==5 then
call DestroyEffect(AddSpecialEffectTarget(l__s,u,"left foot"))
elseif i==6 then
call DestroyEffect(AddSpecialEffectTarget(l__s,u,"right foot"))
endif
endfunction
