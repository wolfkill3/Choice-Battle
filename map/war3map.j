call SaveInteger(h,id,3,0)
call SaveInteger(h,id,4,time)
call TimerStart(t,1,true,function HealCast2)
set t=null
endfunction
function Fade2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real per=LoadReal(h,id,1)
local real i=LoadReal(h,id,2)
local real alf=LoadReal(h,id,3)
local real up=LoadReal(h,id,4)
local integer red=LoadInteger(h,id,5)
local integer green=LoadInteger(h,id,6)
local integer blue=LoadInteger(h,id,7)
if i<per then
call SaveReal(h,id,2,i+0.05)
call SetUnitVertexColor(u,red,green,blue,R2I(alf-up))
call SaveReal(h,id,3,alf-up)
else
call SetUnitVertexColor(u,red,green,blue,R2I(alf))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set t=null
endfunction
function Fade takes unit u,integer red,integer green,integer blue,real l__start,real time returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,time)
call SaveReal(h,id,2,0)
call SaveReal(h,id,3,l__start)
call SaveReal(h,id,4,l__start/(time/0.05))
call SaveInteger(h,id,5,red)
call SaveInteger(h,id,6,green)
call SaveInteger(h,id,7,blue)
call TimerStart(t,0.05,true,function Fade2)
set t=null
endfunction
function Sabraidgoison2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit c=LoadUnitHandle(h,id,1)
local unit u=LoadUnitHandle(h,id,4)
local real dmg=0.09*GetHeroAgi(u,true)
local integer i=GetRandomInt(1,6)
if(udg_B==true and UnitIsAlive(c)and DU==true) or (DU==false and(fi[1]==u or fi[2]==u))then
if i==1 then
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Critters\\Albatross\\CritterBloodAlbatross.mdl",c,"chest"))
elseif i==2 then
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Critters\\Albatross\\CritterBloodAlbatross.mdl",c,"head"))
elseif i==3 then
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Critters\\Albatross\\CritterBloodAlbatross.mdl",c,"right hand"))
elseif i==4 then
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Critters\\Albatross\\CritterBloodAlbatross.mdl",c,"left hand"))
elseif i==5 then
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Critters\\Albatross\\CritterBloodAlbatross.mdl",c,"right foot"))
elseif i==6 then
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Critters\\Albatross\\CritterBloodAlbatross.mdl",c,"left foot"))
endif
if dmg<26 then
call myCustomDamage(u,c,dmg,false,false,null,DAMAGE_TYPE_UNIVERSAL,null)
else
call myCustomDamage(u,c,25,false,false,null,DAMAGE_TYPE_UNIVERSAL,null)
endif
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set c=null
set u=null
set t=null
endfunction
