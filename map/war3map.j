function IzanamiCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local integer idu=GetHandleId(c)
local real x=GetUnitX(c)
local real y=GetUnitY(c)
local integer i=0
local player p=GetOwningPlayer(u)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveReal(h,id,4,x)
call SaveReal(h,id,5,y)
call UnitAddAbility(c,'A12J')
call SaveReal(h,idu,StringHash("dmg2"),0)
call UnitApplyTimedLife(CreateUnit(p,'e001',x,y,GetRandomReal(0,359)),0,13.1)
call SaveUnitHandle(h,idu,StringHash("u2"),u)
call SaveUnitHandle(h,idu,StringHash("c2"),c)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Izanami.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call myCustomDamage(u,c,5*GetHeroInt(u,true),false,false,null,null,null)
call TimerStart(t,7,false,function IzanamiCast2)
set u=null
set c=null
set p=null
set t=null
endfunction
function GenjutsuSharinganFly2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,3)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)+angle
local real dist=LoadReal(h,id,6)
local real mh=LoadReal(h,id,5)
local real rad=LoadReal(h,id,7)
local real rd=SR(x,y,x1,y1)
local real dmg=LoadReal(h,id,8)
local player p=GetOwningPlayer(l__d)
local integer idu=GetPlayerId(p)
local integer i=0
local real cof=rd/dist
if rd>speed+20 then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SaveReal(h,id,1,speed*1.02)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,mh*cof+50,0)
else
call myCustomDamage(Hero[idu],c,dmg,false,false,null,null,null)
call UnitApplyTimedLife(CreateUnit(p,0x65305734,x1,y1,GetRandomReal(0,359)),0,1)
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set l__d=null
set c=null
set t=null
endfunction
function GenjutsuSharinganFly takes unit l__d,unit c,real speed,real angle,real mh,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveUnitHandle(h,id,3,c)
call SaveReal(h,id,5,mh)
call SaveReal(h,id,6,SR(GetUnitX(c),GetUnitY(c),GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,8,dmg)
call TimerStart(t,0.03,true,function GenjutsuSharinganFly2)
set t=null
endfunction
function GenjutsuSharinganCond takes nothing returns boolean
return GetSpellAbilityId()=='A12H' and udg_B==true
endfunction
function GenjutsuSharinganCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local integer ip=GetPlayerId(GetOwningPlayer(u))
local player p=GetOwningPlayer(u)
local real x=GetUnitX(c)
local real y=GetUnitY(c)
local real x1=0
local real y1=0
local real r=GetRandomReal(75,125)
local real a=GetRandomReal(0,7)
local integer i=0
local real dmg=(2+GetUnitAbilityLevel(u,'A12H'))*GetHeroInt(u,true)
local group g=LoadGroupHandle(h,id,6)
loop
exitwhen i>=16
set E=FirstOfGroup(g)
call KillUnit(E)
call GroupRemoveUnit(g,E)
set x1=GetUnitX(E)
set y1=GetUnitY(E)
set n=CreateUnit(p,0x65305732,x1,y1,Atan2(y-y1,x-x1)*bj_RADTODEG)
call GenjutsuSharinganFly(n,c,40,0,GetUnitFlyHeight(E),dmg/16)
set i=i+1
endloop
call SetControlToUnit(u,c,1, "stun")
call PauseUnit(u,false)
call ShowUnit(u,true)
call SetUnitInvulnerable(u,false)
if GetLocalPlayer()==p then
call SelectUnit(u,true)
endif
call SetUnitXY_1(u,x+r*Cos(a),y+r*Sin(a), false)
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
call FlushChildHashtable(h,id)
set u=null
set p=null
set g=null
set c=null
set t=null
endfunction
function GenjutsuSharinganCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local integer i=0
local real dist=0
local group g=CreateGroup()
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveGroupHandle(h,id,6,g)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call ShowUnit(u,false)
loop
exitwhen i>=16
set n=CreateUnit(p,'u000',x,y,GetRandomReal(0,359))
call SetUnitMoveSpeed(n,100)
call SetUnitScale(n,1,1,1)
call GroupAddUnit(g,n)
call UnitAddAbility(n,'A00D')
call SetUnitFlyHeight(n,GetRandomReal(55,95),0)
set dist=GetRandomReal(350,450)
call IssuePointOrder(n,"move",x+dist*Cos(GetRandomReal(0,6.28)),y+dist*Sin(GetRandomReal(0,6.28)))
set i=i+1
endloop
set soundplay=CreateSound("Sound\\Music\\mp3Music\\CrowGenjutsu.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,3,false,function GenjutsuSharinganCast2)
set u=null
set p=null
set c=null
set g=null
set t=null
endfunction
function HousenkaTsumabeniMissleFly2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
local real dist=LoadReal(h,id,6)
local real mh=LoadReal(h,id,5)
local real rad=LoadReal(h,id,7)
local real rd=SR(x,y,x1,y1)
local real dmg=LoadReal(h,id,8)
local player p=GetOwningPlayer(l__d)
local integer idu=GetPlayerId(p)
local integer i=0
local real cof=rd/dist
if rd>speed+20 then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SaveReal(h,id,1,speed*1.02)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,mh*cof+50,0)
else
call GroupEnumUnitsInRange(G,x1,y1,125,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(l__d,E,dmg,false,false,null,null,null)
call SetControlToUnit(l__d,E, 0.08, "stun")
endif
call GroupRemoveUnit(G,E)
endloop
call UnitApplyTimedLife(CreateUnit(p,0x65305734,x1,y1,a*bj_RADTODEG),0,1)
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set l__d=null
set t=null
endfunction
function HousenkaTsumabeniMissleFly takes unit l__d,real speed,real angle,real x,real y,real mh,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,mh)
call SaveReal(h,id,6,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,8,dmg)
call TimerStart(t,0.03,true,function HousenkaTsumabeniMissleFly2)
set t=null
endfunction
function HousenkaTsumabeniCond takes nothing returns boolean
return GetSpellAbilityId()=='A12E' and udg_B==true
endfunction
function HousenkaTsumabeniCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,4)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local real time=LoadReal(h,id,5)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroInt(u,true)*(0.15*GetUnitAbilityLevel(u,'A12E'))+10
local real he=0
local integer i=0
local real dist=0
if time<3 then
call SaveReal(h,id,5,time+0.04)
set n=CreateUnit(p,0x65305732,x,y,Atan2(y1-y,x1-x)*bj_RADTODEG)
call SetUnitFlyHeight(n,75,0)
call HousenkaTsumabeniMissleFly(n,40,0,x1+GetRandomReal(-250,250),y1+GetRandomReal(-250,250),75,dmg)
else
call RemoveUnit(l__d)
loop
exitwhen i>=8
set n=CreateUnit(p,'u000',x,y,GetRandomReal(0,359))
call SetUnitMoveSpeed(n,100)
call SetUnitScale(n,1,1,1)
call UnitAddAbility(n,'A00D')
call SetUnitFlyHeight(n,GetRandomReal(55,95),0)
set dist=GetRandomReal(250,350)
call UnitApplyTimedLife(n,1,dist/100)
call Fade(n,0,0,0,255,dist/100)
call IssuePointOrder(n,"move",x+dist*Cos(GetRandomReal(0,6.28)),y+dist*Sin(GetRandomReal(0,6.28)))
set i=i+1
endloop
call DestroyEffect(AddSpecialEffect("war3mapImported\\FeatherCrow.MDX",x,y))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set p=null
set u=null
set t=null
endfunction
function HousenkaTsumabeniCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)+GetRandomReal(-100,100)
local real y=GetUnitY(u)+GetRandomReal(-100,100)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,GetSpellTargetX())
call SaveReal(h,id,5,0)
call SaveReal(h,id,3,GetSpellTargetY())
set n=CreateUnit(p,0x65305733,x,y,a*bj_RADTODEG)
call SetUnitAnimation(n,"spell channel")
call DestroyEffect(AddSpecialEffect("war3mapImported\\FeatherCrow.MDX",x,y))
call SaveUnitHandle(h,id,4,n)
if SR(x,y,x1,y1)<600 then
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
set x=x-600*Cos(a)
set y=y-600*Sin(a)
call SetUnitX(n,x)
call SetUnitY(n,y)
call DestroyEffect(AddSpecialEffect("war3mapImported\\FeatherCrow.MDX",x,y))
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
endif
set soundplay=CreateSound("Sound\\Music\\mp3Music\\KatonHousenkaTsumabeni.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.04,true,function HousenkaTsumabeniCast2)
set u=null
set p=null
set t=null
endfunction

function Trig_itemblock_Conditions takes nothing returns boolean
return GetUnitTypeId(GetTriggerUnit())=='H007'
endfunction

