set caster=null
set t=null
endfunction

// Danzo end Skills
function DanzoChoice_Act takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit caster=GetTriggerUnit()
local real x0
local real y0
local real x1
local real y1
local real facing
local boolean self=false
local boolean cjlocgn_00000000
local timer cjlocgn_00000001
local integer cjlocgn_00000002

set x0=GetUnitX(caster)
set y0=GetUnitY(caster)
set x1=GetSpellTargetX()
set y1=GetSpellTargetY()
set facing=Angle2(x0,y0,x1,y1)

call SaveUnitHandle(HH,id,1,caster)
call SaveReal(HH,id,11,x1)
call SaveReal(HH,id,12,y1)
call SaveReal(HH,id,3,facing)

if GetSpellTargetUnit()!=null then
call SaveUnitHandle(HH,id,2,GetSpellTargetUnit())
endif

if GetSpellTargetUnit()==caster then
set self=true
endif

if GetSpellTargetUnit()==caster then
set self=true
endif


if GetSpellAbilityId()=='DSQ1' then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)

if LoadBoolean(HH,GetHandleId(caster),SH_DanzoT)==false then
set soundplay=SndN(3628) // Sound\Music\mp3Music\DanzoQ.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SaveReal(HH,id,15,50+(2+GetUnitAbilityLevel(caster,'DSQ1'))*GetHeroInt(caster,true))
call TimerStart(t,0.02,true,function DanzoQ1Act)
else
set soundplay=SndN(3630) // Sound\Music\mp3Music\DanzoQT.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SaveReal(HH,id,15,50+(2+GetUnitAbilityLevel(caster,'DSQ1'))*GetHeroInt(caster,true))
call TimerStart(t,0.02,true,function DanzoTQAct)

endif

endif

if GetSpellAbilityId()=='DSW1' then

if self==true then
call SaveReal(HH,id,5,-2.02)
call SaveUnitHandle(HH,id,2,null)
call SaveBoolean(HH,GetHandleId(caster),ANTITARGET_ABILITY,true)
endif
call PauseUnit(caster,true)
call SaveReal(HH,id,15,(1+GetUnitAbilityLevel(caster,'DSW1'))*GetHeroInt(caster,true))
call SaveBoolean(HH,GetHandleId(caster),TARGET_ABILITY,false)
call TimerStart(t,0.02,true,function DanzoW1Act)
endif

if GetSpellAbilityId()=='DSW2' then
set soundplay=SndN(3632) // Sound\Music\mp3Music\DanzoW_Activate.mp3
call StartSound(soundplay)
