local real y=GetUnitY(c)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real a=Atan2(y-y1,x-x1)
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>60 and GetWidgetLife(c)>0 then
set x1=x1+(50)*Cos(a)
set y1=y1+(50)*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
else
call SetUnitTimeScale(u,1)
call KillUnit(l__d)
if UnitIsAlive(c)then
call UnitAddAbility(c,'A1EO')
call SetUnitAbilityLevel(c,'A1EO',GetUnitAbilityLevel(u,'A1EN'))
call UnitMakeAbilityPermanent(c,true,'A1EO')
call UnitAddAbilityTimed(c,15,'A1EO')
call UnitAddAbility(c,'A1EQ')
call UnitMakeAbilityPermanent(c,true,'A1EQ')
call UnitAddAbilityTimed(c,15,'A1EQ')
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set c=null
set l__d=null
set u=null
set p=null
set t=null
endfunction
function LucyLokeCast takes nothing returns nothing
