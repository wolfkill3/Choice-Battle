function RegenerativeSerumCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real heal=LoadReal(h,id,2)/61
local integer i=LoadInteger(h,id,3)
if i<61 then
call HealTextTag(u,c,heal*myCustomHeal2(c,1),"HealthRes")
call SetUnitState(c,UNIT_STATE_LIFE,GetWidgetLife(c)+heal)
call SaveInteger(h,id,3,i+1)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\FaerieDragonInvis\\FaerieDragon_Invis.mdl",c,"origin"))
else
call PauseTimer(t)
call DestroyTimer(t)
call DestroyEffect(LoadEffectHandle(h,id,0))
call FlushChildHashtable(h,id)
endif
set u=null
set c=null
set t=null
endfunction
function RegenerativeSerumCast takes nothing returns nothing
local timer t=CreateTimer()
local unit u=GetTriggerUnit()
local unit l__d=GetSpellTargetUnit()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,l__d)
call SaveEffectHandle(h,id,0,AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Rejuvenation\\RejuvenationTarget.mdl",l__d,"chest"))
call SaveReal(h,id,2,GetHeroInt(u,true)*(1+GetUnitAbilityLevel(u,'A0CS'))+100)
if GetHeroLevel(u)>=35 then
call HealTextTag(u,l__d,4*GetHeroInt(u,true)*myCustomHeal2(l__d,1),"HealthRes")
call SetUnitState(l__d,UNIT_STATE_LIFE,GetWidgetLife(l__d)+4*GetHeroInt(u,true))
endif
set soundplay=CreateSound("Sound\\Music\\mp3Music\\MayuriW.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.5,true,function RegenerativeSerumCast2)
set t=null
set u=null
set l__d=null
endfunction
