    exitwhen x>33
    set EmoteFrame=CreateFrameByType( "SIMPLEBUTTON", "EmoteFrame", EmoteBarGridFrame, "", x )
    call ClearFrameAllPoints( EmoteFrame )
    call SetFrameTexture( EmoteFrame, EmoteList[x], 0, true )
