function GyokutenhouCast9 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real dmg=GetHeroInt(u,true)*(2+GetUnitAbilityLevel(u,'A1B4'))
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real a=LoadReal(h,id,3)
local real dist=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
if dist<800 and GetWidgetLife(l__d)>0 then
set x=x+50*Cos(a)
set y=y+50*Sin(a)
call SetUnitFlyHeight(u,ParabolaZ(550,800,800-dist),0)
set n=CreateUnit(p,'e10P',x,y,a*bj_RADTODEG+180)
call SetUnitFlyHeight(n,ParabolaZ(550,800,800-dist),0)
call SetUnitVertexColor(n,255,255,255,75)
call UnitApplyTimedLife(n,'BTLF',0.2)
call SetUnitTimeScale(n,3)
call SetUnitAnimation(n,"spell slam five")
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitXY_1(u,x,y, false)
call SaveReal(h,id,2,dist+50)
else
call SetUnitFlyHeight(u,0,0)
call SetUnitXY_1(u,x,y, false)
call UnitApplyTimedLife(CreateUnit(p,'e0S4',x1,y1,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e0S5',x1,y1,GetRandomReal(0,359)),'BTLF',6)
call UnitApplyTimedLife(CreateUnit(p,'e0S3',x1,y1,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e0S2',x1,y1,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e0S6',x1,y1,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e0S7',x1,y1,GetRandomReal(0,359)),'BTLF',3)
call PauseTimer(t)
call SetUnitInvulnerable(l__d,false)
call SetUnitInvulnerable(u,false)
call PauseUnit(l__d,false)
call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,false)
call PauseUnit(u,false)
call myCustomDamage(u,l__d,dmg,false,false,null,null,null)
call SetControlToUnit(u,l__d,2,"stun")
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,120)
call SetUnitScale(n,1,1,1)
call SetUnitTimeScale(n,0.7)
call UnitApplyTimedLife(n,'BTLF',2)
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitScale(n,2,2,2)
call SetUnitVertexColor(n,255,255,255,100)
call SetUnitTimeScale(n,0.7)
call UnitApplyTimedLife(n,'BTLF',2)
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,80)
call SetUnitScale(n,3,3,3)
call SetUnitTimeScale(n,0.7)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitAnimation(u,"stand gold")
call UnitRemoveAbility(u,'A1AZ')
set soundplay=SndN(2586) // Sound\Music\mp3Music\TamaEend.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set u=null
set p=null
set t=null
endfunction
function GyokutenhouCast8 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real dmg=GetHeroAgi(u,true)*10
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real a=LoadReal(h,id,3)
local real dist=SR(LoadReal(h,id,14),LoadReal(h,id,15),x1,y1)
local real sr=LoadReal(h,id,16)
local integer is=0
local real ig=30*bj_DEGTORAD
local player p=GetOwningPlayer(u)
if sr>60 and GetWidgetLife(l__d)>0 then
set x=x+50*Cos(a)
set y=y+50*Sin(a)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call PauseUnit(l__d,true)
call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,true)
call SetUnitInvulnerable(l__d,true)
call SetUnitFlyHeight(u,ParabolaZ(550,dist,dist-sr),0)
set n=CreateUnit(p,'e10P',x,y,a*bj_RADTODEG)
call SetUnitFlyHeight(n,ParabolaZ(550,dist,dist-sr),0)
call SetUnitVertexColor(n,255,255,255,75)
call UnitApplyTimedLife(n,'BTLF',0.2)
call SetUnitTimeScale(n,3)
if LoadInteger(h,id,16)==1 then
call SetUnitAnimation(u,"spell slam two")
else
call SetUnitAnimation(n,"spell slam four")
endif
if GetUnitFlyHeight(u)>500 and LoadInteger(h,id,16)==0 then
call SetUnitAnimation(u,"spell slam two")
set soundplay=SndN(2589) // Sound\Music\mp3Music\TamaNinetella.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SaveInteger(h,id,16,1)
endif
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitXY_1(u,x,y, false)
call SaveReal(h,id,16,sr-50)
else
call SetUnitFlyHeight(u,0,0)
call SetUnitXY_1(u,x,y, false)
set n=CreateUnit(p,'e11C',x1,y1,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,1.5)
loop
exitwhen is>=13
set n=CreateUnit(p,'e0ZH',x1+200*Cos(ig*is),y1+150*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,255,255,255,125)
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitTimeScale(n,1)
set n=CreateUnit(p,'e0ZH',x1+400*Cos(ig*is),y1+300*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,255,255,255,125)
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitTimeScale(n,1)
set is=is+1
endloop
call SetUnitAnimation(u,"spell slam four")
call PauseTimer(t)
call SaveReal(h,id,2,0)
call TimerStart(t,0.03,true,function GyokutenhouCast9)
endif
set l__d=null
set u=null
set p=null
set t=null
endfunction
