call SetUnitFlyHeight(n,GetRandomReal(1550,1800)+sr2/4,0)
call SetUnitVertexColor(n,GetRandomInt(125,200),GetRandomInt(155,255),GetRandomInt(55,100),255)
call SetUnitTimeScale(n,2.5)
call TAtalantaMissles(n,105,a,x2,y2,1.25-dist/2)
call GroupEnumUnitsInRange(G,x1,y1,950,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call EffectToRandomBone("war3mapImported\\SlashEffectRed by Deckai.mdx",E)
