call SaveReal(HH,id,12,GetLocationY(GetSpellTargetLoc()))
call SaveReal(HH,id,3,Angle2(GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()),GetLocationX(GetSpellTargetLoc()),GetLocationY(GetSpellTargetLoc()))) 
