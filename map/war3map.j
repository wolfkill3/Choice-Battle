set soundplay=CreateSound("Sound\\Music\\mp3Music\\AizenTself2.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call SetUnitState(caster,UNIT_STATE_MANA,GetUnitState(Dummy,UNIT_STATE_MANA)*0.5)
//call RemoveUnit(Dummy)
call SaveUnitHandle(HH,GetHandleId(Dummy),StringHash("AizenTKillU"),null)
endif
if IsUnitPaused(Dummy)==false then
set time=time+0.02
call SaveReal(HH,id,5,time)
endif
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
if IsUnitHidden(caster)==false then
call ShowUnit(caster,false)
endif
if time==0.02 then
call UnitStop(caster)
if GetRandomInt(1,2)==1 then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\AizenTstart.mp3",false,false,true,12700,12700,"")
else
