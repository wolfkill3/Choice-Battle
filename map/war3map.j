function EnmaKorogiCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local group g=LoadGroupHandle(h,id,1)
local integer i=1
local real a=0
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local real x1=0
local real y1=0
local real dmg=GetHeroAgi(u,true)*0.1
local player p=GetOwningPlayer(u)
local real r=GetRandomReal(0.,6.283185)
local integer l__s=StringHash("block")
local real dist=LoadReal(h,id,100)
local real time=LoadReal(h,id,4)
local real f=360/60*bj_DEGTORAD
if time<1.05 then
call SaveReal(h,id,4,time+0.05)
if time<1 then
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
endif
if time==1 then
set n=CreateUnit(p,'e0E4',x,y,0)
call UnitApplyTimedLife(n,1,5)
call SetUnitVertexColor(n,255,255,255,25)
loop
exitwhen i>=61
set x1=x+800*Cos(i*f)
set y1=y+800*Sin(i*f)
set a=Atan2(y-y1,x-x1)
call SaveDestructableHandle(h,id,l__s+i,CreateDestructable('B003',x1,y1,a*bj_DEGTORAD,1,1))
set i=i+1
endloop
set i=1
call SetUnitTimeScale(u,1)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
endif
else
if ModuloReal(dist,0.5)<0.05 then
endif
call GroupEnumUnitsInRange(G,x,y,800,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
if GetUnitTypeId(E)!='h019' then
call SetControlToUnit(E,E,1,"doom")
call SetControlToUnit(E,E,1,"blind")
endif
endif
call GroupRemoveUnit(G,E)
endloop
call SaveReal(h,id,100,dist+0.05)
if dist>=5.0 then
loop
exitwhen i>=61
call RemoveDestructable(LoadDestructableHandle(h,id,l__s+i))
set i=i+1
endloop
call SetUnitFlyHeight(u,0,0)
call SetUnitTimeScale(u,1)
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
endif
set g=null
set u=null
set t=null
set p=null
endfunction
