function FrozenMinusManaCast4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,1)
local real life=LoadReal(h,id,0)
local real time=LoadReal(h,id,4)
local real time2=LoadReal(h,id,5)
local real life2=GetWidgetMana(u)
local real dmg=0
if time>0 and GetUnitAbilityLevel(u,'A26F')>0 and GetWidgetLife(u)>0 and udg_B==true and LoadInteger(HH,GetHandleId(u),SH_cold3)!=1 then
call SaveReal(h,id,4,time-0.01)
call SaveReal(h,id,5,time2+0.01)
call UnitAddAbility(u,'A26F')
if life2>life then
call SetUnitState(u,UNIT_STATE_MANA,life)
endif
call SaveReal(h,id,0,GetWidgetMana(u))
else
call UnitRemoveAbility(u,'A26F')
call SaveInteger(HH,GetHandleId(u),SH_cold3,0)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set t=null
set u=null
endfunction
