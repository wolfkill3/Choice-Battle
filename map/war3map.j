function MadaraQSharinganAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local unit b1=LoadUnitHandle(HH,id,20)
local real facing=LoadReal(HH,id,3)
local real distance=LoadReal(HH,id,8)
local real time=LoadReal(HH,id,5)
local real time1
local real damage=LoadReal(HH,id,35)
set time=time+0.02
call SaveReal(HH,id,5,time)
if distance==2000+LoadInteger(HH,id,30) then
        call FlushChildHashtable(HH,id)
        call FlushChildHashtable(HH,GetHandleId(LoadGroupHandle(HH,id,4)))
        call PauseTimer(t)
        call DestroyTimer(t)
        if LoadGroupHandle(HH,id,4)!=null then
        call DestroyGroup(LoadGroupHandle(HH,id,4))
        call SaveGroupHandle(HH,id,4,null)
        endif
        call RemoveUnit(b1)
    //call MyRemoveUnit(b1,1.5)
else
if time<0.4 then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
endif
if time==0.02 then
call SaveGroupHandle(HH,id,4,CreateGroup())
call SetUnitPathing(caster,true)
                        set soundplay=SndN(3547) // war3mapimported\MadaraQ.mp3
                        call StartSound(soundplay)
                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call EffectCreateAndMove(true,"Madara\\blue-blink.mdl",facing,1,2.5,0.5,100,100,100,30,0,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\WindNewFaw4.mdl",facing,1,1.25,0.5,100,100,100,30,0,caster,0,facing)
if LoadBoolean(HH,GetHandleId(caster),SH_MadaraSusT2)==false then
call SetUnitAnimationByIndex(caster,1)
else
call SetUnitTimeScale(caster,5)
call SetUnitAnimationByIndex(caster,7)
endif
if LoadUnitHandle(HH,GetHandleId(caster),SH_MadaraSusano)!=null then
call SetUnitAnimationByIndex(LoadUnitHandle(HH,GetHandleId(caster),SH_MadaraSusano),17)
else
call SetUnitAnimationByIndex(LoadUnitHandle(HH,GetHandleId(caster),SH_MadaraBone),4)
endif
endif
if time==0.4 then

if LoadUnitHandle(HH,GetHandleId(caster),SH_MadaraSusano)!=null or LoadBoolean(HH,GetHandleId(caster),SH_MadaraSusT2)==true then
call SetUnitState(caster,UNIT_STATE_MANA,GetUnitState(caster,UNIT_STATE_MANA)-GetUnitState(caster,UNIT_STATE_MAX_MANA)*0.1)
call SaveInteger(HH,id,30,1000)
endif

call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
call SetUnitModel(n0,"Madara\\shirouichigosl.mdl")
call UnitSize(n0,3,1,1)
call MoveUnit(n0,n0,200,facing)
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call SetUnitFlyHeight(n0,200,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=null
endif
if time==0.6 then
if LoadBoolean(HH,GetHandleId(caster),SH_MadaraSusT2)==true then
call SetUnitTimeScale(caster,1)
call SetUnitAnimationByIndex(caster,10)
endif
if LoadUnitHandle(HH,GetHandleId(caster),SH_MadaraSusano)!=null then
call SetUnitAnimationByIndex(LoadUnitHandle(HH,GetHandleId(caster),SH_MadaraSusano),0)
else
call SetUnitAnimationByIndex(LoadUnitHandle(HH,GetHandleId(caster),SH_MadaraBone),0)
endif
endif
if time>0.4 then
set time1=LoadReal(HH,id,6)
call SaveReal(HH,id,8,distance+50)
set b1=LoadUnitHandle(HH,id,20)
call MoveUnit(b1,b1,50,facing)
if LoadUnitHandle(HH,GetHandleId(caster),SH_MadaraSusano)!=null or LoadBoolean(HH,GetHandleId(caster),SH_MadaraSusT2)==true then
set damage=damage+GetUnitState(caster,UNIT_STATE_MAX_MANA)*0.1
endif
call DamageAoeOneTime(caster,GetUnitX(b1),GetUnitY(b1),300,damage,LoadGroupHandle(HH,id,4))
set time1=time1+0.02
if time1==0.06 or time==0.04 then
set time1=0
call EffectCreateAndMove(true,"Madara\\az_yine(nosmoke).mdl",facing,1,1,1,80,80,100,0,0,LoadUnitHandle(HH,id,20),0,facing)
call EffectCreateAndMove(true,"Madara\\[A]blue--zhendi3.mdl",facing,0.5,2,1.75,100,100,100,40,-100,LoadUnitHandle(HH,id,20),0,facing)
call EffectCreateAndMove(true,"Madara\\az_goods_force staff(3).mdl",facing,1,5,0.8,100,100,100,40,-100,LoadUnitHandle(HH,id,20),0,facing)
endif
call SaveReal(HH,id,6,time1)
endif
endif
set t=null
set caster=null
set b1=null

endfunction

function MadaraWYasaka1 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local unit b1=LoadUnitHandle(HH,id,20)
local real facing=LoadReal(HH,id,3)
local real distance=SR(GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),LoadReal(HH,id,11),LoadReal(HH,id,12))
local real time=LoadReal(HH,id,5)
set time=time+0.02
call SaveReal(HH,id,5,time)
if time>10 or distance<50 then
call EffectCreateAndMove(true,"Madara\\Madara-huitu-20.mdl",facing,1,1.5,0.8,100,100,100,0,0,LoadUnitHandle(HH,id,20),0,facing)
call EffectCreateAndMove(true,"Madara\\File00002270.mdl",facing,1,3,0.8,100,100,100,0,0,LoadUnitHandle(HH,id,20),0,facing)
        set soundplay=SndN(3550) // war3mapimported\MadaraWBoom.mp3
                        call StartSound(soundplay)
                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять

call DamageAoeAndStun(caster,GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),400,LoadReal(HH,id,15),1)
call RemoveUnit(LoadUnitHandle(HH,id,20))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
else
if LoadInteger(HH,id,25)==1 then
set facing=Angle2(GetUnitX(b1),GetUnitY(b1),LoadReal(HH,id,11),LoadReal(HH,id,12))+30
else
set facing=Angle2(GetUnitX(b1),GetUnitY(b1),LoadReal(HH,id,11),LoadReal(HH,id,12))-30
endif
call MoveUnit(b1,b1,50,facing)
endif
set caster=null
set t=null
set b1=null
endfunction

function MadaraWYasaka takes unit caster10,real x00,real y00,real damage00,integer random00,boolean susR0 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real facing=Angle2(GetUnitX(caster10),GetUnitY(caster10),x00,y00)
call SaveUnitHandle(HH,id,1,caster10)
call SaveReal(HH,id,11,x00)
call SaveReal(HH,id,12,y00)
if susR0==false then
call SaveInteger(HH,id,25,random00)
else
if random00==1 then
call SaveInteger(HH,id,25,2)
else
call SaveInteger(HH,id,25,1)
endif
endif
call SaveReal(HH,id,15,damage00)
set n0=CreateUnit(GetOwningPlayer(caster10),'e219',GetUnitX(caster10),GetUnitY(caster10),facing)
set facing=Angle2(GetUnitX(n0),GetUnitY(n0),x00,y00)
call SaveReal(HH,id,3,facing)
call UnitSize(n0,2,1,1)

call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call SetUnitFlyHeight(n0,200,0)



call MoveUnit(n0,n0,200,facing)
if random00==1 then
call MoveUnit(n0,n0,200,facing+90)
else
call MoveUnit(n0,n0,200,facing-90)
endif
call SetUnitFlyHeight(n0,100,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=null
call TimerStart(t,0.02,true,function MadaraWYasaka1)
set caster10=null
set t=null
endfunction

function MadaraWSharinganAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real distance=SR(GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),LoadReal(HH,id,11),LoadReal(HH,id,12))
local real time=LoadReal(HH,id,5)
local real damage=LoadReal(HH,id,35)
set time=time+0.02
call SaveReal(HH,id,5,time)
if time==0.6 then
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
else
if time<0.4 then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
endif
if time==0.02 then
call SaveInteger(HH,id,25,GetRandomInt(1,2))
call SetUnitPathing(caster,true)
if LoadBoolean(HH,GetHandleId(caster),SH_MadaraSusT2)==false then
call SetUnitAnimationByIndex(caster,1)
else
call UnitSpeed(caster,4)
call SetUnitAnimationByIndex(caster,1)
endif
        set soundplay=SndN(3553) // war3mapimported\MadaraW.mp3
                        call StartSound(soundplay)
                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call EffectCreateAndMove(true,"Madara\\[A]az_axe_ef1.mdl",facing,1,1,0.5,100,100,100,30,0,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\az_siwen.mdl",facing,1,1.25,0.5,100,100,100,30,100,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\HakenSaber2.mdl",facing,1,1.5,0.5,100,100,100,30,0,caster,0,facing)
if LoadBoolean(HH,GetHandleId(caster),SH_MadaraSusT2)==false then
if LoadInteger(HH,id,25)==1 then
if LoadUnitHandle(HH,GetHandleId(caster),SH_MadaraSusano)!=null then
call SetUnitAnimationByIndex(LoadUnitHandle(HH,GetHandleId(caster),SH_MadaraSusano),3)
else
call SetUnitAnimationByIndex(LoadUnitHandle(HH,GetHandleId(caster),SH_MadaraBone),2)
endif
else
if LoadUnitHandle(HH,GetHandleId(caster),SH_MadaraSusano)!=null then
call SetUnitAnimationByIndex(LoadUnitHandle(HH,GetHandleId(caster),SH_MadaraSusano),1)
else
call SetUnitAnimationByIndex(LoadUnitHandle(HH,GetHandleId(caster),SH_MadaraBone),1)
endif
endif
endif
endif
if time==0.4 then
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
if LoadUnitHandle(HH,GetHandleId(caster),SH_MadaraSusano)!=null or LoadBoolean(HH,GetHandleId(caster),SH_MadaraSusT2)==true then
call MadaraWYasaka(caster,LoadReal(HH,id,11),LoadReal(HH,id,12),damage*0.75,LoadInteger(HH,id,25),true)
call MadaraWYasaka(caster,LoadReal(HH,id,11),LoadReal(HH,id,12),damage*0.75,LoadInteger(HH,id,25),false)
else
call MadaraWYasaka(caster,LoadReal(HH,id,11),LoadReal(HH,id,12),damage,LoadInteger(HH,id,25),false)
endif
endif
if time==0.6 then
if LoadBoolean(HH,GetHandleId(caster),SH_MadaraSusT2)==true then
call UnitSpeed(caster,1)
call SetUnitAnimationByIndex(caster,1)
elseif LoadUnitHandle(HH,GetHandleId(caster),SH_MadaraSusano)!=null then
call SetUnitAnimationByIndex(LoadUnitHandle(HH,GetHandleId(caster),SH_MadaraSusano),0)
else
call SetUnitAnimationByIndex(LoadUnitHandle(HH,GetHandleId(caster),SH_MadaraBone),0)
endif
endif
endif
set t=null
set caster=null
endfunction





function MadaraEMokutonDragon1 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local unit l__target=LoadUnitHandle(HH,id,2)
local real facing=LoadReal(HH,id,3)
local real distance=SR(GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),GetUnitX(LoadUnitHandle(HH,id,2)),GetUnitY(LoadUnitHandle(HH,id,2)))
local real time=LoadReal(HH,id,5)
local real time1
if IsUnitPaused(l__target)==false then
set time=time+0.02
call SaveReal(HH,id,5,time)
endif
if time==3 or GetUnitAbilityLevel(l__target,'BMUR')==0 then
call UnitRemoveAbility(LoadUnitHandle(HH,id,2),'BMUR')
call RemoveUnit(LoadUnitHandle(HH,id,20))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
else
if time==1 then
call UnitSpeed(LoadUnitHandle(HH,id,20),2)
call SetUnitAnimationByIndex(LoadUnitHandle(HH,id,20),2)
endif
set time1=LoadReal(HH,id,6)
set time1=time1+0.02
if time1==1 or time==0.02 then
call EffectCreateAndMove(true,"Madara\\[A]az_axe_ef1.mdl",facing,1,1,0.5,100,100,100,40,0,l__target,0,facing)
set time1=0
if IsUnitInvulnerable(l__target)==false then
call myCustomDamage(caster,l__target,LoadReal(HH,id,15),false,false,null,null,null)
call SetControlToUnit(caster,l__target,1, "stun")
call SetUnitState(l__target,UNIT_STATE_MANA,GetUnitState(l__target,UNIT_STATE_MANA)-GetUnitState(l__target,UNIT_STATE_MAX_MANA)*LoadReal(HH,id,11)*0.0135)
endif
set time=time+0.02
call SaveReal(HH,id,5,time)
endif
call SaveReal(HH,id,6,time1)
call SetUnitFacingInstant(LoadUnitHandle(HH,id,20),GetUnitFacing(l__target))
call SetUnitFlyHeight(LoadUnitHandle(HH,id,20),GetUnitFlyHeight(caster),0)
call MoveUnit(l__target,LoadUnitHandle(HH,id,20),0,GetUnitFacing(caster))
endif
set caster=null
set l__target=null
set t=null
endfunction
function MadaraEMokutonDragon takes unit caster1,unit dragon,unit targetD, real damage0, real Level returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(HH,id,1,caster1)
