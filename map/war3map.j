function SaberNeroWCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real a=LoadReal(h,id,3)
local group g=CreateGroup()
local group g1=CreateGroup()
local boolean b=false
local boolean b2=false
call GroupEnumUnitsInRange(g1,x+150*Cos(a),y+150*Sin(a),400,Base)
call SetUnitFacing(u,a*bj_RADTODEG)
loop
    set E=FirstOfGroup(g1)
    exitwhen E==null
    if Condition_Base(p,E)and IsUnitInvulnerable(E)==false and IsUnitIllusion(E)==false and GetUnitTypeId(E)!='Ho13' and GetUnitTypeId(E)!='H34X' and GetUnitTypeId(E)!='H14F' and GetUnitTypeId(E)!='H007' and IsUnitType(E,UNIT_TYPE_HERO)then
        if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
            set b=true
            call PauseUnit(E,true)
            call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,true)
            call GroupAddUnit(g,E)
            call UnitAddAbility(E,'Arav')
            call UnitRemoveAbility(E,'Arav')
        else
            set b2=true
            call PauseUnit(E,false)
            call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,false)
            call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,u)
        endif
    endif
    call GroupRemoveUnit(g1,E)
endloop
call PauseTimer(t)
if b==true then
    if b2==false then
        call SaveGroupHandle(h,id,1,g)
        if GetUnitTypeId(u)=='H26B' then
        set soundplay=SndN(2645) // Sound\Music\mp3Music\NeroBrideW.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        elseif GetUnitTypeId(u)=='H16B' then
        set soundplay=SndN(2647) // Sound\Music\mp3Music\NeroSaber1W.mp3
        call SetSoundVolumeBJ(soundplay,150)
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        else
        set soundplay=SndN(2649) // Sound\Music\mp3Music\NeroSaberW.mp3
        call SetSoundVolumeBJ(soundplay,150)
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        endif
        call TimerStart(t,0.3,false,function SaberNeroWCast3)
    else
        loop
            set E=FirstOfGroup(g)
            exitwhen E==null
            call PauseUnit(E,false)
            call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,false)
            call SetUnitFlyHeight(E,0,0)
            call GroupRemoveUnit(g,E)
        endloop
        call PauseUnit(u,false)
        call SetUnitInvulnerable(u,false)
        call SetUnitTurnSpeed(u,1.00)
        call SetUnitTimeScale(u,1)
        call PauseTimer(t)
        call DestroyTimer(t)
        call SetUnitVertexColor(u,255,255,255,255)
        call FlushChildHashtable(h,id)
    endif
else
call DestroyGroup(g)
call DestroyGroup(g1)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call FlushChildHashtable(h,id)
endif
set g=null
set g1=null
set u=null
set p=null
set t=null
endfunction
function SaberNeroWCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=GetUnitFacing(u)*bj_DEGTORAD
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,0)
call SaveReal(h,id,3,a)
call PauseUnit(u,true)
call UnitAddAbility(u,'Arav')
call UnitRemoveAbility(u,'Arav')
set n=CreateUnit(p,'e0RV',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call SetUnitTimeScale(n,0.3)
call SetUnitAnimation(u,"attack")
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitInvulnerable(u,true)
call SaveReal(h,id,5,x)
call SaveReal(h,id,6,y)
call TimerStart(t,0.01,false,function SaberNeroWCast2)
set u=null
set p=null
set t=null
endfunction
function InitTrig_SaberNeroW takes nothing returns nothing
set gg_trg_SaberNeroW=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_SaberNeroW,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_SaberNeroW,Condition(function SaberNeroWCond))
call TriggerAddAction(gg_trg_SaberNeroW,function SaberNeroWCast)
endfunction
function SaberNeroECond takes nothing returns boolean
return GetSpellAbilityId()=='A1CB'
endfunction
function SaberNeroECast4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call SetUnitTimeScale(u,1)
call SetUnitFlyHeight(u,0,0)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call UnitRemoveAbility(u,'A1CI')
call UnitRemoveAbility(u,'A1CJ')
set u=null
set t=null
endfunction
function SaberNeroECast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real he=LoadReal(h,id,1)
local real sp=LoadReal(h,id,2)
local real dmg=GetHeroAgi(u,true)*(4+GetUnitAbilityLevel(u,'A1CB'))
local integer is=0
local real ig=30*bj_DEGTORAD
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
if he>0 then
set he=he-sp
call SaveReal(h,id,1,he)
call SaveReal(h,id,2,sp+9.8*0.24)
call SetUnitFlyHeight(u,he,0)
else
if GetUnitAbilityLevel(u,'B06L')!=0 or GetUnitAbilityLevel(u,'B16L')!=0 then
call DestroyEffect(AddSpecialEffect("war3mapImported\\LW10.mdl",x,y))
set dmg=dmg*1.35
endif
call GroupEnumUnitsInRange(G,x,y,500,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\BatTrollMissile\\BatTrollMissile.mdl",E,"chest"))
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 2, "stun")
endif
call GroupRemoveUnit(G,E)
endloop
loop
exitwhen is>=13
set n=CreateUnit(p,'e0ZH',x+200*Cos(ig*is),y+200*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,255,255,255,125)
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitTimeScale(n,1)
set n=CreateUnit(p,'e0ZH',x+400*Cos(ig*is),y+300*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,255,255,255,125)
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitTimeScale(n,1)
set is=is+1
endloop
set n=CreateUnit(p,'e123',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,GetRandomInt(175,255))
call SetUnitFlyHeight(n,25,0)
call UnitApplyTimedLife(n,'BTLF',1.5)
call DestroyEffect(AddSpecialEffect("war3mapImported\\Cherry Blossom Impact.mdx",x,y))
call SetUnitAnimation(u,"Spell Slam")
call PauseTimer(t)
call TimerStart(t,0.1,false,function SaberNeroECast4)
endif
set p=null
set u=null
set t=null
endfunction
function SaberNeroECast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real he=LoadReal(h,id,1)
local real sp=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real time=LoadReal(h,id,3)
if sp>0 then
set he=he+sp
call SaveReal(h,id,1,he)
call SaveReal(h,id,2,sp-9.8*0.16)
call SaveReal(h,id,3,time+0.02)
call SetUnitFlyHeight(u,he,0)
if time>0.1 then
if GetUnitTypeId(u)=='H26B' then
set n=CreateUnit(p,'e224',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,GetRandomInt(125,205))
call SetUnitFlyHeight(n,he,0)
call SetUnitTimeScale(n,0.4)
call SetUnitScale(n,1.3,1.3,1.3)
call UnitApplyTimedLife(n,'BTLF',4.5)
call SaveReal(h,id,3,0)
else
set n=CreateUnit(p,'e124',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,GetRandomInt(125,205))
call SetUnitFlyHeight(n,he,0)
call SetUnitTimeScale(n,0.4)
call SetUnitScale(n,1.3,1.3,1.3)
call UnitApplyTimedLife(n,'BTLF',4.5)
call SaveReal(h,id,3,0)
endif
endif
else
call SetUnitTimeScale(u,2)
call PauseTimer(t)
call SaveReal(h,id,2,35)
call TimerStart(t,0.015,true,function SaberNeroECast3)
endif
set p=null
set u=null
set t=null
endfunction
function SaberNeroECast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,0)
call SaveReal(h,id,2,50)
call SaveReal(h,id,3,0)
if GetUnitAbilityLevel(u,'B06L')!=0 or GetUnitAbilityLevel(u,'B16L')!=0 then
call UnitAddAbility(u,'A1CJ')
else
call UnitAddAbility(u,'A1CI')
endif
call UnitAddAbility(u,'Arav')
call UnitRemoveAbility(u,'Arav')
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
if GetUnitTypeId(u)=='H26B' then
set soundplay=SndN(2651) // Sound\Music\mp3Music\NeroBrideE.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SetUnitAnimationByIndex(u,13)
call SetUnitTimeScale(u,3)
elseif GetUnitTypeId(u)=='H16B' then
set soundplay=SndN(2653) // Sound\Music\mp3Music\NeroSaber1E.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SetUnitAnimation(u,"Spell Six")
call SetUnitTimeScale(u,3)
else
set soundplay=SndN(2655) // Sound\Music\mp3Music\NeroSaberE.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SetUnitAnimation(u,"Spell Six")
call SetUnitTimeScale(u,3)
endif
call TimerStart(t,0.015,true,function SaberNeroECast2)
set t=null
set u=null
set p=null
endfunction
function InitTrig_SaberNeroE takes nothing returns nothing
set gg_trg_SaberNeroE=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_SaberNeroE,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_SaberNeroE,Condition(function SaberNeroECond))
call TriggerAddAction(gg_trg_SaberNeroE,function SaberNeroECast)
endfunction
function SaberNeroRCond takes nothing returns boolean
return GetSpellAbilityId()=='A1CC'
endfunction
function SaberNeroRCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local trigger tt=LoadTriggerHandle(h,id,2)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real sc=0
local real time=LoadReal(h,id,3)
local integer lvl=GetUnitAbilityLevel(u,'A1CC')
local player p=GetOwningPlayer(u)
if time<3 then
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
if GetUnitAbilityLevel(u,'A1CE')!=0 then
call UnitRemoveAbility(u,'A1CE')
call UnitRemoveAbility(u,'A1CF')
call SetUnitAnimation(u,"death")
endif
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,25,25,75)
set sc=2.5
call SetUnitScale(n,sc,sc,sc)
call SetUnitFlyHeight(n,55,0)
call UnitApplyTimedLife(n,'BTLF',0.8)
call SetUnitTimeScale(n,1)
call SaveReal(h,id,3,time+0.1)
if time==2.8 then
set n=CreateUnit(p,'h019',x,y,0)
call UnitApplyTimedLife(n,'BTLF',2)
if GetUnitTypeId(u)=='H26B' then
call UnitAddAbility(n,'A2CH')
call SetUnitAbilityLevel(n,'A2CH',1)
else
call UnitAddAbility(n,'A1CH')
call SetUnitAbilityLevel(n,'A1CH',1)
endif
call IssueTargetOrder(n,"innerfire",u)
endif
else
set n=CreateUnit(p,'e11V',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,GetRandomInt(125,205))
call SetUnitFlyHeight(n,0,0)
call SetUnitTimeScale(n,0.6)
call UnitApplyTimedLife(n,'BTLF',3)
if p==GetLocalPlayer()then
call ClearSelection()
call SelectUnit(u,true)
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl",u,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectCaster.mdl",u,"origin"))
call SetUnitTimeScale(u,1)
call SetUnitAnimation(u,"stand")
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
if GetUnitAbilityLevel(u,'B06L')!=0 or GetUnitAbilityLevel(u,'B16L')!=0 then
call SetBuffDispellable(GetUnitBuff( u, 'B06L' ),false)
call SetBuffDispellable(GetUnitBuff( u, 'B16L' ),false)
endif
call SetUnitState(u,UNIT_STATE_LIFE,1)
call HealTextTag(u,u,GetUnitState(u,UNIT_STATE_MAX_LIFE)*(0.25+0.1*lvl)*myCustomHeal2(u,1),"HealthRes")
call SetUnitLifePercentBJ(u,25+10*lvl)
call TriggerClearActions(tt)
call DestroyTrigger(tt)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set tt=null
set u=null
set t=null
endfunction
function SaberNeroReincornation takes nothing returns nothing
local trigger tt=GetTriggeringTrigger()
local timer t=LoadTimerHandle(h,GetHandleId(tt),0)
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real time=LoadReal(h,id,3)
call SetUnitInvulnerable(u,true)
call PauseUnit(u,true)
call PauseTimer(t)
call SaveReal(h,id,3,0)
call SetUnitAnimation(u,"death")
call SetUnitTimeScale(u,0.4)
call TimerStart(t,0.1,true,function SaberNeroRCast3)
set tt=null
set u=null
set t=null
endfunction
