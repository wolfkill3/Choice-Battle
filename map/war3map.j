function HashiramaT1Act takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local real time=LoadReal(HH,id,5)
local real time1=LoadReal(HH,id,6)
local real facing=LoadReal(HH,id,3)
local integer cjlocgn_00000000
if time<1 then
set time=time+0.02
call SaveReal(HH,id,5,time)
if time==0.02 then
set cjlocgn_00000000=R2I(GetHeroStr(caster,true)*0.02)
call SaveInteger(HH,id,30,cjlocgn_00000000)
call CreateModeIndicatorWithPauseForm(caster, "ReplaceableTextures\\CommandButtons\\BTNHashiramaT.blp", 20.0)
loop
exitwhen cjlocgn_00000000==0
call UnitAddAbility(caster,'HSHP')
call SetUnitAbilityLevel(caster,'HSHP',2)
call UnitRemoveAbility(caster,'HSHP')
//call DisplayTextToPlayer(GetLocalPlayer(),0,0,"Increase HP: "+I2S((cjlocgn_00000000))+"Times")
set cjlocgn_00000000=cjlocgn_00000000-1
endloop
call SetUnitAnimationByIndex(caster,8)
endif
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
if time==0.02 or time==0.4 or time==0.6 or time==0.9 then
call UnitCreateAndMove(caster,'hs06',caster,GetRandomReal(0,360),1.5,3,1.5,100,100,100,0,0,caster,0,facing)
call UnitCreateAndMove(caster,'hs11',caster,GetRandomReal(0,360),1.5,2.25,0.3,100,100,100,40,50,caster,0,facing)
endif
set time1=time1+0.02
if time1==0.06 then
set time1=0
call UnitCreateAndMove1(caster,'hs10',caster,GetRandomReal(0,360),1,GetRandomReal(0.5,1.25),GetRandomReal(0.5,1.25),100,100,100,GetRandomReal(80,90),0,caster,0,facing,0)
endif
call SaveReal(HH,id,6,time1)
if time>=1 then
call SaveReal(HH,id,6,0)
call UnitCreateAndMove(caster,'hs01',caster,GetRandomReal(0,360),1,1.25,0.75,100,100,100,0,0,caster,0,facing)
call UnitCreateAndMove(caster,'hs05',caster,GetRandomReal(0,360),1,1.5,1,100,100,100,0,50,caster,0,facing)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
endif
endif
if time>=1 then
if IsUnitPaused(caster)==false then
set time=time+0.02
call SaveReal(HH,id,5,time)
endif
if LoadReal(HH, GetHandleId(LoadFrameHandle(HH, GetHandleId(GetOwningPlayer(caster)),StringHash("ReplaceableTextures\\CommandButtons\\BTNHashiramaT.blp"))), c_DURATION)==0 then
set cjlocgn_00000000=LoadInteger(HH,id,30)
loop
exitwhen cjlocgn_00000000==0
call UnitAddAbility(caster,'HSHR')
call SetUnitAbilityLevel(caster,'HSHR',2)
call UnitRemoveAbility(caster,'HSHR')
//call DisplayTextToPlayer(GetLocalPlayer(),0,0,"Decrease HP: "+I2S((cjlocgn_00000000))+"Times")
set cjlocgn_00000000=cjlocgn_00000000-1
endloop
call UnitAddAbility(caster, 'HST4')
call IssueImmediateOrder(caster,"bearform") 
call UnitRemoveAbility(caster, 'HST4')
call ShowAbility2('HST3',false)
call ShowAbility2('HST2',false)
call ShowAbility2Timed('HST1',true,0.1)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
endif
set t=null
set caster=null
endfunction
function HashiramaT2Act takes nothing returns nothing
