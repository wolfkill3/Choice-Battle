if ra==0 then
set soundplay=SndN(3075) // Sound\Music\mp3Music\KazumaT1.mp3
endif
if ra==1 then
set soundplay=SndN(3077) // Sound\Music\mp3Music\KazumaT2.mp3
endif
if ra==2 then
set soundplay=SndN(3079) // Sound\Music\mp3Music\KazumaT3.mp3
endif
