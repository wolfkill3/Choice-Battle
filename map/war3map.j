function LucyKozelCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real a=GetUnitFacing(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroInt(u,true)*(3+GetUnitAbilityLevel(u,'A1ET'))
call AtalantaPush(c,50,a*bj_DEGTORAD,350)
call PauseUnit(u,false)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call IssueImmediateOrder(u,"stop")
call SetUnitInvulnerable(u,false)
call myCustomDamage(u,c,dmg,false,false,null,null,null)
set n=CreateUnit(p,'e11I',x,y,a)
call UnitApplyTimedLife(n,'BTLF',0.4)
call PauseTimer(t)
call SetUnitTimeScale(u,1)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set u=null
set p=null
set t=null
endfunction
function LucyKozelCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,8)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real a=LoadReal(h,id,3)
local real dist=LoadReal(h,id,2)
local integer i=0
local boolean b=LoadBoolean(h,id,1)
local real sc
local player p=GetOwningPlayer(u)
if dist<1250 and b==false then
set x=x+50*Cos(a)
set y=y+50*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SaveReal(h,id,2,dist+40)
set n=CreateUnit(p,'e117',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,GetRandomInt(10,45))
set sc=GetRandomReal(0.55,1.25)
call SetUnitScale(n,sc,sc,sc)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
call GroupEnumUnitsInRange(G,x,y,100,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
if GetWidgetLife(E)>0 then
call SaveUnitHandle(h,id,4,E)
call SaveBoolean(h,id,1,true)
call SaveReal(h,id,2,0)
call SetUnitAnimation(u,"Spell Four")
set n=CreateUnit(p,'e11L',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.4)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG-30)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+30)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,2)
set n=CreateUnit(p,'e0RV',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',3.5)
call SaveUnitHandle(h,id,1,E)
call PauseTimer(t)
call PauseUnit(E,true)
call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,true)
call SetControlToUnit(E,E, 2, "stun")
call TimerStart(t,0.05,false,function LucyKozelCast3)
endif
call GroupClear(G)
endif
call GroupRemoveUnit(G,E)
endloop
else
call PauseTimer(t)
call SetUnitTimeScale(u,1)
call PauseUnit(u,false)
call IssueImmediateOrder(u,"stop")
call SetUnitInvulnerable(u,false)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set u=null
set p=null
set t=null
endfunction
