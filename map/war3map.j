call SaveUnitHandle(h,id,1,c)
set x2=x+75*Cos(a+deg90)
set y2=y+75*Sin(a+deg90)
set n=CreateUnit(p,'e16P',x2,y2,a*bj_RADTODEG)
call SaveUnitHandle(h,id,3,n)
set x2=x+75*Cos(a-deg90)
set y2=y+75*Sin(a-deg90)
set n=CreateUnit(p,'e16P',x2,y2,a*bj_RADTODEG)
call SaveUnitHandle(h,id,4,n)
set x2=x+75*Cos(a)
set y2=y+75*Sin(a)
