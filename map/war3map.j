    call ClickFrame(GetFrameByName( "AbilityVarBarIcon", 10 ))
endif
call TimerStart(t,0.01,true,function KiBlastCast2)
set u=null
set p=null
set t=null
endfunction
function GokuKiBlastInit takes nothing returns nothing
