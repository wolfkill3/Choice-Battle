        call SetUnitX(d,x+75*Cos(a))
        call SetUnitY(d,y+75*Sin(a))
        call SetUnitFlyHeight(d,GetUnitFlyHeight(u)+100,0)
        call SetUnitFacing(d,a*bj_RADTODEG)
endif
set i=i+1
set l__s=l__s+1
set e=e+1
exitwhen i>=per
endloop
else
call SaveReal(h,id,1,3)
call PauseTimer(t)
call TimerStart(t,0.02,true,function EnkiduQCast3)
endif
set u=null
set t=null
endfunction
function EnkiduQCast takes nothing returns nothing
local timer t=CreateTimer()
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=0
local real y1=0
local real a=0
local integer i=20
local integer l__s=60
local integer e=100
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,3)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Enkido Q.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call GroupEnumUnitsInRange(G,x,y,800,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E) and GetUnitTypeId(E) != 'Ho13' then
set x1=GetUnitX(E)
set y1=GetUnitY(E)
set a=Atan2(y1-y,x1-x)
call SaveLightningHandle(h,id,i,AddLightningEx("ZRLI",false,x+75*Cos(a),y+75*Cos(a),GetUnitZ(u)+100,GetUnitX(E),GetUnitY(E),GetUnitZ(E)+100))
call SaveUnitHandle(h,id,l__s,E)
call SaveUnitHandle(h,id,e,CreateUnit(p,'e174',x+75*Cos(a),y+75*Cos(a),a*bj_RADTODEG))
call UnitAddAbility(E,'Arav')
call UnitRemoveAbility(E,'Arav')
call UnitAddAbility(E,'A1HT')
call UnitMakeAbilityPermanent(E,true,'A1HT')
call UnitAddAbility(E,'AP06')
call UnitMakeAbilityPermanent(E,true,'AP06')
set i=i+1
set l__s=l__s+1
set e=e+1
endif
call GroupRemoveUnit(G,E)
endloop
if i!=20 then
call SaveInteger(h,id,2,i)
call SaveInteger(h,id,3,l__s)
call TimerStart(t,0.02,true,function EnkiduQCast2)
else
call PauseTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set t=null
set p=null
endfunction
