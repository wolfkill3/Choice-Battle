call UnitApplyTimedLife(CreateUnit(p,'e04K',x1,y1,a*bj_RADTODEG),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e04D',x1,y1,a*bj_RADTODEG),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e04D',x1,y1,a*bj_RADTODEG),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e04D',x1,y1,a*bj_RADTODEG),'BTLF',2)
