function LaserMaginoCond takes nothing returns boolean
return GetSpellAbilityId()=='A19N'
endfunction
function LaserMaginoCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,5)
local real dmg=GetHeroInt(u,true)*8
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real a=LoadReal(h,id,3)
local real dist=LoadReal(h,id,2)
local real dist2=LoadReal(h,id,6)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,8)
if dist<5500 and GetWidgetLife(l__d)>0 then
set x=x+70*Cos(a)
set y=y+70*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SaveReal(h,id,2,dist+70)
call SaveReal(h,id,6,dist2+70)
if dist2>200 then
call SaveReal(h,id,6,0)
set n=CreateUnit(p,0x65305A55,x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,125)
call UnitApplyTimedLife(n,1,1)
endif
set n=CreateUnit(p,0x65305A57,x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,125)
call UnitApplyTimedLife(n,1,1)
call SetUnitColor(n,PLAYER_COLOR_GREEN)
call GroupEnumUnitsInRange(g,x,y,150,Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 2, "stun")
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
else
call RemoveUnit(l__d)
call DestroyGroup(g)
call RemoveUnit(LoadUnitHandle(h,id,1))
call RemoveUnit(LoadUnitHandle(h,id,2))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,idg)
endif
set g=null
set l__d=null
set u=null
set p=null
set t=null
endfunction
function LaserMaginoCast2 takes nothing returns nothing
