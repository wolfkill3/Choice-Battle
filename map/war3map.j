exitwhen index==bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddCondition(SabracChoice,Condition(function SabracChoice_Cond))
call TriggerAddAction(SabracChoice,function SabracChoice_Act)
set SabracChoice=null
set index=0
endfunction















function SabracHeroSwordLife takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit Dummy=LoadUnitHandle(HH,id,20)
local real time=0
local integer swords=0
local integer HeroSwords=LoadInteger(HH,id,25)
//call SaveReal(HH,id,5,time)
if SR(GetUnitX(caster),GetUnitY(caster),GetUnitX(Dummy),GetUnitY(Dummy))<100 and udg_B==true then
set soundplay=SndByPath("Sound\\Music\\mp3Music\\SabracG_Sword"+I2S(GetRandomInt(1,4))+".mp3")
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set swords=LoadInteger(HH,GetHandleId( (GetOwningPlayer( caster )) ),SabracSwordsHash)+HeroSwords
call SaveInteger(HH,GetHandleId( (GetOwningPlayer( caster )) ),SabracSwordsHash,swords)


call SetUnitBaseDamageByIndex(caster,0,GetHeroStr(caster,false)+swords*3)


//if((GetLocalPlayer()==GetOwningPlayer(caster) or GetPlayerAlliance(GetOwningPlayer(caster),GetLocalPlayer(),ALLIANCE_SHARED_CONTROL)) and GetUnitSelected(GetLocalPlayer())==caster )then
//call DisplayTextToPlayer(GetLocalPlayer(),0,0,"Swords take")
//endif

//if((GetLocalPlayer()==GetOwningPlayer(caster) or GetPlayerAlliance(GetOwningPlayer(caster),GetLocalPlayer(),ALLIANCE_SHARED_CONTROL)) and GetUnitSelected(GetLocalPlayer())==caster )then
//call DisplayTextToPlayer(GetLocalPlayer(),0,0,"Swords "+I2S(swords))
//endif

set time=1
endif
if time>=1 or udg_B==false or DU2==false or UnitIsAlive(caster)==false then
call RemoveUnit(Dummy)
call RemoveUnit(LoadUnitHandle(HH,id,21))
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
set caster=null
set Dummy=null
endfunction
