function RinneTenseiCond takes nothing returns boolean
return GetSpellAbilityId()==0x4130584A
endfunction
function RinneTenseiCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local integer idu=GetPlayerId(p)
local integer i=0
local real sc=GetRandomReal(1,4)
local real time=LoadReal(h,id,6)
local real f=GetUnitFacing(u)*bj_DEGTORAD
local integer random_i=0
if GetUnitCurrentOrder(u)==OrderId("root")then
set n=CreateUnit(p,0x65305537,x,y,0)
call SetUnitScale(n,sc,sc,sc)
call UnitApplyTimedLife(n,1,0.4)
call SaveReal(h,id,6,time+0.1)
else
if time>11.8 and FFAMode==false then
        if idu>=0 and idu<=4 then
        set i=0
        loop
        exitwhen i>=10
        set random_i=GetRandomInt(0, 4)
        if Hero[random_i]!=u and UnitIsAlive(Hero[random_i])==false and Hero[random_i]!=null then
            call ReviveHero(Hero[random_i],x-200*Cos(f),y-200*Sin(f),true)
            call SaveInteger(HH,GetHandleId(Hero[random_i]),StringHash("VegetaDeath"),1)
            call SetUnitState(Hero[random_i],UNIT_STATE_LIFE,1)
            call SetUnitState(Hero[random_i],UNIT_STATE_MANA,1)
            call HealTextTag(u,Hero[random_i],GetUnitState(Hero[random_i],UNIT_STATE_MAX_LIFE)*0.2*myCustomHeal2(Hero[random_i],1),"HealthRes")
            call HealTextTag(u,Hero[random_i],GetUnitState(Hero[random_i],UNIT_STATE_MAX_MANA)*0.2*myCustomMana2(Hero[random_i],1),"ManaRes")
            call SetUnitState(Hero[random_i],UNIT_STATE_LIFE,GetUnitState(Hero[random_i],UNIT_STATE_MAX_LIFE)*0.2)
            call SetUnitState(Hero[random_i],UNIT_STATE_MANA,GetUnitState(Hero[random_i],UNIT_STATE_MAX_MANA)*0.2)
            call RemoveTransformation(Hero[random_i])
            call SetUnitTargetable(Hero[random_i],true)
            call IssuePointOrder(Hero[random_i],"move",x+500*Cos(f),y+500*Sin(f))
            call DestroyEffect(AddSpecialEffect("war3mapImported\\AncientExplode.mdx",x-200*Cos(f),y-200*Sin(f)))
            set i=11
        endif
        set i=i+1
        endloop
    elseif idu>=5 and idu<=9 then
        set i=0
        loop
        exitwhen i>=10
        set random_i=GetRandomInt(5, 9)
        if Hero[random_i]!=u and UnitIsAlive(Hero[random_i])==false and Hero[random_i]!=null then
            call ReviveHero(Hero[random_i],x-200*Cos(f),y-200*Sin(f),true)
            call SaveInteger(HH,GetHandleId(Hero[random_i]),StringHash("VegetaDeath"),1)
            call SetUnitState(Hero[random_i],UNIT_STATE_LIFE,1)
            call SetUnitState(Hero[random_i],UNIT_STATE_MANA,1)
            call HealTextTag(u,Hero[random_i],GetUnitState(Hero[random_i],UNIT_STATE_MAX_LIFE)*0.2*myCustomHeal2(Hero[random_i],1),"HealthRes")
            call HealTextTag(u,Hero[random_i],GetUnitState(Hero[random_i],UNIT_STATE_MAX_MANA)*0.2*myCustomMana2(Hero[random_i],1),"ManaRes")
            call SetUnitState(Hero[random_i],UNIT_STATE_LIFE,GetUnitState(Hero[random_i],UNIT_STATE_MAX_LIFE)*0.2)
            call SetUnitState(Hero[random_i],UNIT_STATE_MANA,GetUnitState(Hero[random_i],UNIT_STATE_MAX_MANA)*0.2)
            call RemoveTransformation(Hero[random_i])
            call SetUnitTargetable(Hero[random_i],true)
            call IssuePointOrder(Hero[random_i],"move",x+500*Cos(f),y+500*Sin(f))
            call DestroyEffect(AddSpecialEffect("war3mapImported\\AncientExplode.mdx",x-200*Cos(f),y-200*Sin(f)))
            set i=11
        endif
        set i=i+1
        endloop
    endif
        call SetUnitState(u,UNIT_STATE_MANA,0)
        call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)*0.25)
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set t=null
endfunction
