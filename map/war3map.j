call SaveUnitHandle(HH,id,0,u)
if IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==true then
set x=GetUnitX(u)
set y=GetUnitY(u)
endif
set n=CreateUnit(p,0x65313257,x,y,0)
