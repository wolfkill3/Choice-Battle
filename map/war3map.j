function GrailCond takes nothing returns boolean
return GetSpellAbilityId()=='A19Z' or GetSpellAbilityId()=='A127' or GetSpellAbilityId()=='A1GB' and udg_B==true and GetUnitTypeId(GetTriggerUnit())!='H007'  and GetUnitAbilityLevel(GetTriggerUnit(),'GIE1')==0 and GetUnitTypeId(GetTriggerUnit())!='H04U'
endfunction
function HealGrailCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,5)
local unit c=LoadUnitHandle(h,id,1)
local real heal=LoadReal(h,id,2)
local real i=LoadReal(h,id,3)
if i<LoadReal(h,id,4)then
call HealTextTag(u,c,heal*myCustomHeal2(c,1),"HealthRes")
call SetUnitState(c,UNIT_STATE_LIFE,GetWidgetLife(c)+heal)
call SaveReal(h,id,3,i+1)
else
call PauseTimer(t)
call DestroyTimer(t)
call DestroyEffect(LoadEffectHandle(h,id,0))
call RemoveSaveHashTimed(15,GetHandleId(c),SH_Grail)
call FlushChildHashtable(h,id)
endif
set u=null
set c=null
set t=null
endfunction
function HealGrailCast takes unit u, unit c,real heal,real time returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,5,u)
call SaveUnitHandle(h,id,1,c)
call SaveReal(h,id,2,heal)
call SaveReal(h,id,3,0)
call SaveReal(h,id,4,time)
if time==10 then
call SaveEffectHandle(h,id,0,AddSpecialEffectTarget("war3mapImported\\NatsuAura2(Black).mdx",c,"origin"))
else
call SaveEffectHandle(h,id,0,AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectCaster.mdl",c,"origin"))
call SaveInteger(h,GetHandleId(c),SH_Grail,1)
set EFF=AddSpecialEffectTarget("Abilities\\Spells\\Orc\\SpiritLink\\SpiritLinkZapTarget.mdl",c,"origin")
call RemoveEffect(EFF,21,false,CreateTimer())
endif
call TimerStart(t,1,true,function HealGrailCast2)
set t=null
endfunction
function GrailCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local integer id=GetSpellAbilityId()
local real heal=0
if id=='A19Z' then
set heal=83.333+GetHeroLevel(u)*1.666
elseif id=='A1GB' then
set heal=166.666+GetHeroLevel(u)*3.333
else
set heal=10+GetHeroLevel(u)*0.5
endif
if id!='A127' then
call GroupEnumUnitsInRange(G,x,y,1000,Base)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\IllidanMissile\\IllidanMissile.mdl",u,"chest"))
loop
set E=FirstOfGroup(G)
exitwhen E==null
if IsUnitAlly(E,p) and LoadInteger(h,GetHandleId(E),SH_Grail)!=1 then
call HealGrailCast(u,E,heal,6)
endif
call GroupRemoveUnit(G,E)
endloop
else
call GroupEnumUnitsInRange(G,x,y,900,Base)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\LaxusSpark.mdx",u,"right,hand"))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\LaxusSpark.mdx",u,"left,hand"))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\NatsuAura2(Black).mdx",u,"origin"))
loop
set E=FirstOfGroup(G)
exitwhen E==null
if IsUnitAlly(E,p) then
call HealGrailCast(u,E,heal,10)
endif
call GroupRemoveUnit(G,E)
endloop
endif
set p=null
set u=null
endfunction
function InitTrig_Grail takes nothing returns nothing
set gg_trg_Grail=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Grail,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_Grail,Condition(function GrailCond))
call TriggerAddAction(gg_trg_Grail,function GrailCast)
endfunction
function Killself2Cond takes nothing returns boolean
return GetSpellAbilityId()=='A0WL' and udg_B==true and GetUnitTypeId(GetTriggerUnit())!='H007' and GetUnitTypeId(GetTriggerUnit())!='H04U'
endfunction
function Killself2Cast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real time=LoadReal(h,id,2)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real ms=0
local real mn=0
if UnitIsAlive(u)and udg_B==false then
call GroupEnumUnitsInRange(G,x,y,1000,Base)
call GroupRemoveUnit(G,u)
call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)-0.05*GetUnitState(u,UNIT_STATE_MAX_LIFE))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\IllidanMissile\\IllidanMissile.mdl",u,"chest"))
loop
set E=FirstOfGroup(G)
set ms=GetUnitState(E,UNIT_STATE_MAX_LIFE)
set mn=GetUnitState(E,UNIT_STATE_MAX_MANA)
exitwhen E==null
if IsUnitAlly(E,p)==false and IsUnitIllusion(E)==false and IsUnitType(E,UNIT_TYPE_HERO)then
call SetUnitState(E,UNIT_STATE_MANA,GetWidgetMana(E)-0.05*mn)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BluefireBolt.mdx",E,"chest"))
else
call SetUnitState(E,UNIT_STATE_LIFE,GetWidgetLife(E)+0.05*ms)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Unleash the power.mdx",E,"chest"))
endif
call GroupRemoveUnit(G,E)
endloop
else
call SetTerrainFogExBJ(0,6000.00,10000,0,1,1,1)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set t=null
set u=null
endfunction
function Killself2Cast takes nothing returns nothing // Сфера Крови
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real ms=0
local real mu=GetWidgetLife(u)
local player p=GetOwningPlayer(u)
local real heal=0.0
call GroupEnumUnitsInRange(G,x,y,1750,Base)
call GroupRemoveUnit(G,u)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x,y,GetRandomReal(0,359)),'BTLF',1)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\IllidanMissile\\IllidanMissile.mdl",u,"chest"))
loop
set E=FirstOfGroup(G)
set ms=GetWidgetLife(E)
exitwhen E==null
if IsUnitAlly(E,p)==false and IsUnitIllusion(E)==false and IsUnitType(E,UNIT_TYPE_HERO)then
call SetUnitState(E,UNIT_STATE_LIFE,ms-0.09*ms)
set heal = heal + ms*0.09
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BluefireBolt.mdx",E,"chest"))
endif
call GroupRemoveUnit(G,E)
endloop
if heal>3000 then
    set heal=3000
endif
if heal>0.25*GetWidgetMaxLife(u) then
    set heal=0.25*GetWidgetMaxLife(u)
endif
call HealTextTag(u,u,heal*myCustomHeal2(u,1),"HealthRes")
call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+heal)
set p=null
set u=null
endfunction
function InitTrig_Killself2 takes nothing returns nothing
set gg_trg_Killself2=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Killself2,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_Killself2,Condition(function Killself2Cond))
call TriggerAddAction(gg_trg_Killself2,function Killself2Cast)
endfunction
function ForceStaffCond takes nothing returns boolean
return GetSpellAbilityId()=='A0WP' and GetUnitAbilityLevel(GetTriggerUnit(),'B04U')==0 and GetUnitTypeId(GetTriggerUnit())!='H007' and GetUnitTypeId(GetTriggerUnit())!='H04U'
endfunction
function ForceStaffCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real a=LoadReal(h,id,1)
local real dist=LoadReal(h,id,100)
local player p=GetOwningPlayer(u)
if dist<600 and IsTerrainPathable(x1,y1,PATHING_TYPE_FLYABILITY)==false then
call SaveReal(h,id,100,dist+30)
call SetUnitX(u,x1+30*Cos(a))
call SetUnitY(u,y1+30*Sin(a))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\FlakCannons\\FlakTarget.mdl",x1,y1))
else
set n=CreateUnit(p,'h019',x1,y1,0)
call UnitAddAbility(n,'A0HM')
call IssueTargetOrder(n,"slow",u)
call UnitApplyTimedLife(n,'BTLF',1)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
endif
set u=null
set t=null
endfunction
function ForceStaffCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,4,GetUnitX(u))
call SaveReal(h,id,5,GetUnitY(u))
call SaveReal(h,id,1,GetUnitFacing(u)*bj_DEGTORAD)
call SaveReal(h,id,100,0)
call TimerStart(t,0.01,true,function ForceStaffCast2)
set u=null
set t=null
endfunction
