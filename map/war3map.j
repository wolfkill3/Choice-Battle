endfunction
function Trig_RemovePerDie_Actions takes nothing returns nothing
set n=GetTriggerUnit()
call RemoveUnit(n)
if GetUnitAbilityLevel(n,'A16Q')>0 then
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",GetUnitX(n),GetUnitY(n)))
endif
if GetUnitAbilityLevel(n,'A0ZT')>0 then
call SetUnitOwner(n,Player(14),true)
endif
endfunction
function InitTrig_RemovePerDie takes nothing returns nothing
set gg_trg_RemovePerDie=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_RemovePerDie,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(gg_trg_RemovePerDie,Condition(function Trig_RemovePerDie_Conditions))
call TriggerAddAction(gg_trg_RemovePerDie,function Trig_RemovePerDie_Actions)
endfunction
function Trig_Target_Func002C takes nothing returns boolean
if((GetPlayerName(GetTriggerPlayer())=="Vadik29"))then
return true
endif
if((GetPlayerName(GetTriggerPlayer())=="WorldEdit"))then
return true
endif
if((GetPlayerName(GetTriggerPlayer())=="PinkieNecro"))then
return true
endif
if((GetPlayerName(GetTriggerPlayer())=="NecromanseR_RuS"))then
return true
endif
if((GetPlayerName(GetTriggerPlayer())=="Famouzy"))then
return true
endif
return false
endfunction
function Trig_Target_Conditions takes nothing returns boolean
if(not Trig_Target_Func002C())then
return false
endif
return true
endfunction
function Trig_Sync_Actions takes nothing returns nothing
local player p=GetTriggerPlayer()
if GetLocalPlayer() == p then
call SaveReal(HSYNC,GetHandleId(p),c_MOUSE_X,GetMouseWorldX())
call SaveReal(HSYNC,GetHandleId(p),c_MOUSE_Y,GetMouseWorldY())
call SyncSavedReal(HSYNC, GetHandleId(p), c_MOUSE_X)
call SyncSavedReal(HSYNC, GetHandleId(p), c_MOUSE_Y)
set p=null
endif
endfunction
function Trig_Target_Actions takes nothing returns nothing
local player p=null
if GetSyncSavedChildKey()==c_MOUSE_Y and GetSyncSavedHashtable()==HSYNC then
set p=GetTriggerSyncPlayer()
set n=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE),'ogru',LoadReal(HSYNC,GetHandleId(p),c_MOUSE_X),LoadReal(HSYNC,GetHandleId(p),c_MOUSE_Y),GetRandomDirectionDeg())
call UnitAddAbility(n,'Arav')
call UnitRemoveAbility(n,'Arav')
endif
set p=null
endfunction
function InitTrig_Target takes nothing returns nothing
local integer i=0
set gg_trg_Target=CreateTrigger()
loop
    call TriggerRegisterPlayerKeyEvent( gg_trg_Target, Player(i), OSKEY_L, 0 ,true )
    exitwhen i>=12
    set i=i+1
endloop
call TriggerAddCondition(gg_trg_Target,Condition(function Trig_test_Condition))
call TriggerAddAction(gg_trg_Target,function Trig_Sync_Actions)
set i=0
set gg_trg_Target=CreateTrigger()
loop
    call TriggerRegisterPlayerHashtableDataSyncEvent(gg_trg_Target,Player(i),HSYNC)
    exitwhen i>=12
    set i=i+1
endloop
call TriggerAddAction(gg_trg_Target,function Trig_Target_Actions)
endfunction
function Trig_Set_Ability_Conditions takes nothing returns boolean
return IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO) and pick!=3
endfunction
function IndexTouma2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local integer ip=LoadInteger(HH,id,0)
local unit u=Hero[ip]
local unit l__d=LoadUnitHandle(HH,StringHash(I2S(ip)),StringHash("index"))
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real time=LoadReal(HH,id,2)
call SaveReal(HH,id,2,time+0.1)
if CheckUnitInvisible(u) then
    call UnitAddAbility(l__d,'Ao7S')
else
    call UnitRemoveAbility(l__d,'Ao7S')
endif
if UnitIsAlive(l__d)and GetUnitTypeId(Hero[ip])=='H05R' then
if SR(x,y,x1,y1)>400 and GetUnitAbilityLevel(l__d,'A16C')==0 then
call IssuePointOrder(l__d,"move",x+GetRandomReal(-300,300),y+GetRandomReal(-300,300))
endif
if SR(x,y,x1,y1)>1000 and GetUnitAbilityLevel(l__d,'A169')==0 and GetUnitAbilityLevel(l__d,'A16C')==0 then
call SetUnitPosition(l__d,x+GetRandomReal(-300,300),y+GetRandomReal(-300,300))
endif
if time>12 and GetUnitAbilityLevel(l__d,'A16C')==0 then
call IssuePointOrder(l__d,"move",x+GetRandomReal(-300,300),y+GetRandomReal(-300,300))
call SaveReal(HH,id,2,0)
endif
else
call SaveInteger(HH,ip,10,0)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
call RemoveUnit(l__d)
endif
set u=null
set t=null
set l__d=null
endfunction
function MadokaKyubei2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local integer ip=LoadInteger(HH,id,0)
local unit u=Hero[ip]
local unit l__d=LoadUnitHandle(HH,ip,StringHash("kyubei"))
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real time=LoadReal(HH,id,2)
call SaveReal(HH,id,2,time+0.1)
if CheckUnitInvisible(u) then
    call UnitAddAbility(l__d,'Ao7S')
else
    call UnitRemoveAbility(l__d,'Ao7S')
endif
if UnitIsAlive(l__d)and GetUnitTypeId(Hero[ip])=='HMad' then
        if SR(x,y,x1,y1)>400 and GetUnitAbilityLevel(l__d,'A16C')==0 then
                call IssuePointOrder(l__d,"move",x+GetRandomReal(-300,300),y+GetRandomReal(-300,300))
        endif
        if SR(x,y,x1,y1)>1000 and GetUnitAbilityLevel(l__d,'A169')==0 and GetUnitAbilityLevel(l__d,'A16C')==0 then
                call SetUnitPosition(l__d,x+GetRandomReal(-300,300),y+GetRandomReal(-300,300))
        endif
        if time>12 and GetUnitAbilityLevel(l__d,'A16C')==0 then
                call IssuePointOrder(l__d,"move",x+GetRandomReal(-300,300),y+GetRandomReal(-300,300))
                call SaveReal(HH,id,2,0)
        endif
else
        call SaveInteger(HH,ip,10,0)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(HH,id)
        call RemoveUnit(l__d)
endif
set u=null
set t=null
set l__d=null
endfunction
function MadokaScenario takes integer mode returns string
if mode==0 then
return "|c008000FFCataclysm|r"
elseif mode==1 then
return "|c00FFFF00Heal|r"
elseif mode==2 then
return "|c0080FF00Ressurection|r"
elseif mode==3 then
return "|c00FF80FFGoddess|r"
else
return "Error"
endif
endfunction
function MadokaDBoard2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local integer ip=LoadInteger(HH,id,0)
local unit u=Hero[ip]
if GetUnitAbilityLevel(u, 'MaDs')>0 then
    if IsUnitSelected(u,GetLocalPlayer()) and IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(u)) then
        if GetHeroLevel(u)>=25 then
            call SetFrameText(GetFrameByName("CustomLeaderboardText",0),"|c00FFFC01Soul gems|r: "+I2S(GetUnitAbilityLevel(u, 'MaDs')-1)+".    Scenario: "+MadokaScenario(LoadInteger(HH,GetHandleId(u),MadokaMHash))+"|n|c00FF8080DMG|r: "+I2S(R2I(LoadReal(HH,GetHandleId(u),MadokaDHash)))+ "/"+I2S(R2I(LoadReal(HH,GetHandleId(u),MadokaTDHash)))+". |c0080FF00Heal|r: "+I2S(R2I(LoadReal(HH,GetHandleId(u),MadokaHHash)))+ "/"+I2S(R2I(LoadReal(HH,GetHandleId(u),MadokaTHHash)))+".")
        else
            call SetFrameText(GetFrameByName("CustomLeaderboardText",0),"|c00FFFC01Soul gems|r: "+I2S(GetUnitAbilityLevel(u, 'MaDs')-1))
        endif
        call ShowFrame(GetFrameByName("CustomLeaderboard",0), true)
        call SetFrameSize( GetFrameByName("CustomLeaderboard",0), .1775, GetFrameHeight( GetFrameByName("CustomLeaderboardText",0))+0.016)
        call SetFrameTextAlignment( GetFrameByName("CustomLeaderboardText",0), TEXT_JUSTIFY_LEFT, TEXT_JUSTIFY_LEFT )
        //call SetFrameRelativePoint( GetFrameByName("CustomLeaderboard",0), FRAMEPOINT_CENTER, GetFrameByName("CustomLeaderboard",0), FRAMEPOINT_CENTER,  -.08, (0.5*GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",i)))+.04  )
    endif
else
    if IsUnitSelected(u,GetLocalPlayer()) and IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(u)) then
        call SetFrameText(GetFrameByName("CustomLeaderboardText",0)," ")
        call ShowFrame(GetFrameByName("CustomLeaderboard",0),false)
    endif
    call SaveInteger(HH,ip,StringHash("MadokaDBoard"),0)
    call RemoveSavedInteger(HH,ip,StringHash("MadokaDBoard"))
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(HH,id)
endif
set u=null
set t=null
endfunction

function GokuDBoard2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local integer ip=LoadInteger(HH,id,0)
local unit u=Hero[ip]
local player p=GetOwningPlayer(u)
local integer idp=GetHandleId(p)
if GetUnitTypeId(u)=='H02H' then
    if IsUnitSelected(u,GetLocalPlayer()) and IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(u)) then
        if GetHeroLevel(u)<26 then
            call SetFrameText(GetFrameByName("CustomLeaderboardText",0),"|c00FF0000Kaioken|r: "+I2S(R2I(LoadInteger(HH,idp, KaiokenHash))))
        elseif GetHeroLevel(u)>=26 and LoadBoolean(HH,idp,UIAvailableHash)==false then
            call SetFrameText(GetFrameByName("CustomLeaderboardText",0),"|c00FF0000Kaioken|r: "+I2S(R2I(LoadInteger(HH,idp, KaiokenHash)))+"  |c00C7C7D6UI Unlock|r: "+I2S(R2I(LoadReal(HH,idp, UIDMGHash)))+ "/"+I2S(R2I(LoadReal(HH,idp,UILimitDMGHash))))
        elseif GetHeroLevel(u)>=26 and GetHeroLevel(u)<35 and LoadBoolean(HH,idp,UIAvailableHash)==true then
            call SetFrameText(GetFrameByName("CustomLeaderboardText",0),"|c00FF0000Kaioken|r: "+I2S(R2I(LoadInteger(HH,idp, KaiokenHash)))+"  |c00C7C7D6Dodges|r: "+I2S(LoadInteger(HH,idp, UIDodgeHash))+ "/"+I2S(LoadInteger(HH,idp,UIMaxDodgeHash)))
        elseif GetHeroLevel(u)>=35 and LoadBoolean(HH,idp,UIAvailableHash)==true and LoadBoolean(HH,idp,MUIAvailableHash)==false then
            call SetFrameText(GetFrameByName("CustomLeaderboardText",0),"|c00FF0000Kaioken|r: "+I2S(R2I(LoadInteger(HH,idp, KaiokenHash)))+"  |c00C7C7D6Dodges|r: "+I2S(LoadInteger(HH,idp, UIDodgeHash))+ "/"+I2S(LoadInteger(HH,idp,UIMaxDodgeHash))+"|n|c00F1F1F5MUI Unlock|r: "+I2S(LoadInteger(HH,idp, MUIDodgeCountHash))+ "/20")
        elseif GetHeroLevel(u)>=35 and LoadBoolean(HH,idp,UIAvailableHash)==true and LoadBoolean(HH,idp,MUIAvailableHash)==true then
            call SetFrameText(GetFrameByName("CustomLeaderboardText",0),"|c00FF0000Kaioken|r: "+I2S(R2I(LoadInteger(HH,idp, KaiokenHash)))+"  |c00C7C7D6Dodges|r: "+I2S(LoadInteger(HH,idp, UIDodgeHash))+ "/"+I2S(LoadInteger(HH,idp,UIMaxDodgeHash)))
        endif
        call ShowFrame(GetFrameByName("CustomLeaderboard",0), true)
        call SetFrameSize( GetFrameByName("CustomLeaderboard",0), .1775, GetFrameHeight( GetFrameByName("CustomLeaderboardText",0))+0.016)
        call SetFrameTextAlignment( GetFrameByName("CustomLeaderboardText",0), TEXT_JUSTIFY_LEFT, TEXT_JUSTIFY_LEFT )
    endif
else
    if IsUnitSelected(u,GetLocalPlayer()) and IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(u)) then
        call SetFrameText(GetFrameByName("CustomLeaderboardText",0)," ")
        call ShowFrame(GetFrameByName("CustomLeaderboard",0),false)
    endif
    call SaveInteger(HH,ip,StringHash("GokuDBoard"),0)
    call RemoveSavedInteger(HH,ip,StringHash("GokuDBoard"))
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(HH,id)
endif
set u=null
set p=null
set t=null
endfunction

