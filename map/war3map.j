function SoundsHeroesAct takes nothing returns nothing
if GetSpellAbilityId()=='A1FI' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\ScatachF.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
if GetSpellAbilityId()=='A27Q' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Alterl_battle_exattack.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
if GetSpellAbilityId()=='A09J' and GetUnitTypeId(GetTriggerUnit())=='H00L' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\LucciE.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
if GetSpellAbilityId()=='A1E7' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\HeroineE.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
if GetSpellAbilityId()=='A0X7' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\ShanaF.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
if GetSpellAbilityId()=='A0L4' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\MagnusE.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
if GetSpellAbilityId()=='A1EJ' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\NarutoF.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
if GetSpellAbilityId()=='A023' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\MinatoQ.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
if GetSpellAbilityId()=='A191' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\YujiR.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
if GetSpellAbilityId()=='A07Q' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\IchigoW.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
if GetSpellAbilityId()=='A0P8' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\GogetaR.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
if GetSpellAbilityId()=='A1DC' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\JeanneAlterF.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
endfunction
