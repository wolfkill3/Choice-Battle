function UnitIsAlive takes unit u returns boolean
return IsUnitType(u,UNIT_TYPE_DEAD)==false and GetUnitTypeId(u)!=0 and GetWidgetLife(u)>0
endfunction
function Push_without_facing2 takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local real speed=LoadReal(h, id, 1)
local real a=LoadReal(h, id, 2)
local real dist=LoadReal(h, id, 3)
if dist > 0 and udg_B == true and LoadUnitHandle(h, id, 0) != null and GetUnitAbilityLevel(LoadUnitHandle(h, id, 0), 'A1BL') == 0 then
        call SetUnitXY_1(LoadUnitHandle(h, id, 0) , GetUnitX(LoadUnitHandle(h, id, 0)) + speed * Cos(a) , GetUnitY(LoadUnitHandle(h, id, 0)) + speed * Sin(a) , true)
        call SaveReal(h, id, 3, dist - speed)
        call SaveReal(h, id, 1, speed - speed * 0.03)
    if LoadInteger(h, id, EffectPeriodHash) <= 0 then
        call DestroyEffect(AddSpecialEffect("war3mapImported\\Sand.mdx", GetUnitX(LoadUnitHandle(h, id, 0)), GetUnitY(LoadUnitHandle(h, id, 0))))
        call SaveInteger(h, id, EffectPeriodHash, 2)
    else
        call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash) - 1)
    endif
else
        call FlushChildHashtable(h, id)
        call PauseTimer(GetExpiredTimer())
        call DestroyTimer(GetExpiredTimer())
endif
endfunction
function Push_without_facing takes unit l__d,real speed,real angle,real dist returns nothing
        local integer id=0
        set sysTimer=CreateTimer()
        set id=GetHandleId(sysTimer)
        call SaveUnitHandle(h, id, 0, l__d)
        call SaveReal(h, id, 1, speed)
        call SaveReal(h, id, 2, angle)
        call SaveReal(h, id, 3, dist)
        call TimerStart(sysTimer, 0.03, true, function Push_without_facing2)
        set sysTimer=null
endfunction

function UnitRemoveAbilityTimed_ExD2 takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local real time=LoadReal(HH, id, 2)
        if time <= 0 or GetUnitAbilityLevel(LoadUnitHandle(HH, id, 0), LoadInteger(HH, id, 1)) == 0 then
                call UnitRemoveAbility(LoadUnitHandle(HH, id, 0), LoadInteger(HH, id, 1))
                call FlushChildHashtable(HH, id)
                call DestroyTimer(t)
        else
                call SaveReal(HH, id, 2, time - 0.1)
        endif
        set t=null
endfunction
function UnitRemoveAbilityTimed_ExD takes unit u,integer id,real time returns nothing
        local timer t=CreateTimer()
        local integer idt=GetHandleId(t)
        call SaveInteger(HH, idt, 1, id)
        call SaveUnitHandle(HH, idt, 0, u)
        call SaveReal(HH, idt, 2, time)
        call TimerStart(t, 0.1, true, function UnitRemoveAbilityTimed_ExD2)
        set t=null
endfunction


function UnitRemoveAbilityTimedPause_ExD2 takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local real time=LoadReal(HH, id, 2)
        if time <= 0 or GetUnitAbilityLevel(LoadUnitHandle(HH, id, 0), LoadInteger(HH, id, 1)) == 0 then
                call UnitRemoveAbility(LoadUnitHandle(HH, id, 0), LoadInteger(HH, id, 1))
                call FlushChildHashtable(HH, id)
                call DestroyTimer(t)
        elseif IsUnitPaused(LoadUnitHandle(HH, id, 0))==false then
                call SaveReal(HH, id, 2, time - 0.1)
        endif
        set t=null
endfunction

function UnitRemoveAbilityTimedPause_ExD takes unit u,integer id,real time returns nothing
        local timer t=CreateTimer()
        local integer idt=GetHandleId(t)
        call SaveInteger(HH, idt, 1, id)
        call SaveUnitHandle(HH, idt, 0, u)
        call SaveReal(HH, idt, 2, time)
        call TimerStart(t, 0.1, true, function UnitRemoveAbilityTimedPause_ExD2)
        set t=null
endfunction

// ==== Индикаторы статус-бара: размер консоли читается раз в 0.25 сек., иконка переставляется только при смене
// места или размера консоли, текст переписывается только когда меняется показываемое значение.
// полоса прокрутки: сколько мест занято у владельца выделенного юнита, размер и положение ползунка
function StatusIndicatorScrollUpdate takes nothing returns nothing
    local integer idp=GetHandleId(GetOwningPlayer(GetUnitSelected(GetLocalPlayer())))
    local integer top=-1
    local integer k=0
    local integer mo
    local real tw
    local real thw
    if SB_Track==null then
        return
    endif
    loop
        exitwhen k>=24
        if LoadBoolean(HH,idp,k) then
            set top=k
        endif
        set k=k+1
    endloop
    set mo=top+1-8
    if mo<0 then
        set mo=0
    endif
    if SB_Scroll>mo then
        set SB_Scroll=mo
        set SB_Ver=SB_Ver+1
    endif
    set SB_MaxOff=mo
    call ShowFrame(SB_Track,mo>0)
    call ShowFrame(SB_Thumb,mo>0)
    call ShowFrame(SB_BtnL,mo>0)
    call ShowFrame(SB_BtnR,mo>0)
    if mo>0 then
        call SetFrameSize(SB_Track,GetFrameWidth(StatusBarFrame)-0.02,0.003)
        set tw=GetFrameWidth(SB_Track)
        set thw=tw*8./I2R(mo+8)
        call SetFrameSize(SB_Thumb,thw,0.003)
        call SetFrameRelativePoint(SB_Thumb,FRAMEPOINT_LEFT,SB_Track,FRAMEPOINT_LEFT,(tw-thw)*I2R(SB_Scroll)/I2R(mo),0.)
    endif
endfunction
function StatusIndicatorScrollBy takes integer sbd returns nothing
    set SB_Scroll=SB_Scroll+sbd
    if SB_Scroll>SB_MaxOff then
        set SB_Scroll=SB_MaxOff
    endif
    if SB_Scroll<0 then
        set SB_Scroll=0
    endif
    set SB_Ver=SB_Ver+1
    call StatusIndicatorScrollUpdate()
endfunction
// клик по левой/правой половине полосы — на одну иконку; колесо над статус-баром — тоже
function StatusBarScrollClick takes nothing returns nothing
    local integer sbd=1
    if GetTriggerFrame()==SB_BtnL then
        set sbd=-1
    endif
    if GetTriggerPlayer()==GetLocalPlayer() then
        call StatusIndicatorScrollBy(sbd)
    endif
endfunction
