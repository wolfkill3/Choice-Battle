function LearnQAtalantaCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local integer lvl=GetUnitAbilityLevel(u,'A1DR')
local player p=GetOwningPlayer(u)
if GetUnitAbilityLevel(u,'A1DR')==1 then
call UnitAddAbility(u,'A1DS')
call UnitMakeAbilityPermanent(u,true,'A1DS')
call ShowAbility2('A1DS',true)
call UnitAddAbility(u,'A1DT')
call UnitMakeAbilityPermanent(u,true,'A1DT')
call ShowAbility2('A1DT',false)
else
if GetUnitTypeId(u)=='H06G' then
call SetUnitAbilityLevel(u,'A1DS',lvl)
else
call SetUnitAbilityLevel(u,'A1DS',lvl+5)
endif
call SetUnitAbilityLevel(u,'A1DT',lvl)
endif
set t=null
set p=null
set u=null
endfunction
