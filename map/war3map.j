set gg_trg_UFastStrike=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_UFastStrike,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_UFastStrike,Condition(function UFastStrikeCond))
