endloop
set n=CreateUnit(p,'eo87',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitTimeScale(n,0.5)
set n=CreateUnit(p,'eo88',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitTimeScale(n,1)
call DestroyEffect(AddSpecialEffect("war3mapImported\\AZ_TormentedSoul_T1.mdl",x,y))
call DestroyEffect(AddSpecialEffect("war3mapImported\\AZ_TormentedSoul_T2.mdl",x,y))
call DestroyEffect(AddSpecialEffect("war3mapImported\\WarStompCaster.mdx",x,y))
call DestroyEffect(AddSpecialEffect("war3mapImported\\Slam.mdx",x,y))
call ShakeCamera(0.5,35)
call SetUnitVertexColor(u,255,255,255,255)
loop
exitwhen i>=7
set x2=x+240*Cos(60*i*bj_DEGTORAD)
set y2=y+240*Sin(60*i*bj_DEGTORAD)
set a2=Atan2(y-y2,x-x2)
set n=CreateUnit(p,'e15N',x2,y2,a2*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1.5)
call SetUnitVertexColor(n,255,255,255,180)
call SetUnitTimeScale(n,1.5)
set i=i+1
endloop
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set l__d=null
set t=null
endfunction
function KireiRPush takes unit u,unit l__d,real dmg,real speed,real angle,real dist returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,4,u)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle)
call SaveReal(h,id,3,dist)
call SaveReal(h,id,5,dmg)
call SaveGroupHandle(h,id,6,CreateGroup())
call TimerStart(t,0.02,true,function KireiRPush2)
call PauseUnit(l__d,true)
call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,true)
set t=null
endfunction
function KireiRCloneEffect2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local real time=LoadReal(h,id,1)
local unit u=LoadUnitHandle(h,id,0)
local real sc=LoadReal(h,id,2)
local real nsc=LoadReal(h,id,3)
local integer al=LoadInteger(h,id,4)
local integer nal=LoadInteger(h,id,5)
if time>0 then
call SaveReal(h,id,1,time-0.02)
call SetUnitScale(u,sc+nsc,sc+nsc,sc+nsc)
call SaveReal(h,id,2,sc+nsc)
call SetUnitVertexColor(u,255,255,255,al)
call SaveInteger(h,id,4,al-nal)
else
call RemoveUnit(u)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set t=null
endfunction
function KireiRCloneEffect takes unit u,real time,real sc1,real sc2,integer alpha returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real a=0.02*(sc2-sc1)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,time)
call SaveReal(h,id,2,sc1)
call SaveReal(h,id,3,a/time)
call SaveInteger(h,id,4,alpha)
call SaveInteger(h,id,5,R2I(0.02*(I2R(alpha)/time)))
call SetUnitVertexColor(u,255,255,255,alpha)
call TimerStart(t,0.02,true,function KireiRCloneEffect2)
set t=null
endfunction
