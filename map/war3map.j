if time1<0 then
set time1=0.2
call DamageAoeOneTime0(caster,x0,y0,600,damage*0.1)
call SetUnitAnimationByIndex(Dummy,2)
endif
call SaveReal(HH,id,6,time1)
endif
endif
set caster=null
set Dummy=null
set gr=null
endfunction

