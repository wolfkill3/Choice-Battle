call SetUnitTimeScale(n,2)
call SetUnitScale(n,1.25,1.25,1.25)
call UnitApplyTimedLife(n,'BTLF',1)
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,155,255,200,105)
call SetUnitTimeScale(n,2)
call SetUnitScale(n,1.55,1.55,1.55)
call UnitApplyTimedLife(n,'BTLF',1)
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,155,255,200,95)
call SetUnitTimeScale(n,2)
call SetUnitScale(n,1.75,1.75,1.75)
call UnitApplyTimedLife(n,'BTLF',1)
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,155,255,200,85)
call SetUnitTimeScale(n,2)
call SetUnitScale(n,2,2,2)
call UnitApplyTimedLife(n,'BTLF',1)
else
loop
exitwhen i>=10
if GetUnitAbilityLevel(Hero[i],'A1DO')>0 then
call UnitRemoveAbility(Hero[i],'A1DO')
endif
set i=i+1
endloop
set n=CreateUnit(p,'h019',x,y,0)
call UnitAddAbility(n,'A1DQ')
call UnitApplyTimedLife(n,'BHwe',1)
call IssueTargetOrder(n,"innerfire",u)
call PauseUnit(u,false)
call GroupEnumUnitsInRange(G,x,y,900,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if IsUnitAlly(E,p)and E!=u then
set n=CreateUnit(p,'h019',x,y,0)
call UnitAddAbility(n,'A1DI')
call UnitApplyTimedLife(n,'BHwe',1)
call IssueTargetOrder(n,"innerfire",E)
endif
call GroupRemoveUnit(G,E)
endloop
call ForGroup(g,function KillGroup)
call GroupClear(g)
call DestroyGroup(g)
call SetUnitInvulnerable(u,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set g=null
set u=null
set t=null
