function WScatachCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local player p=GetOwningPlayer(u)
local integer idu=GetPlayerId(p)
local real x=LoadReal(h,id,3)
local real y=LoadReal(h,id,4)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,8)
local real dmg=GetHeroAgi(u,true)*(1.75+1.25*GetUnitAbilityLevel(u,'A1FC'))
local real Range=LoadReal(h,id,9)
local real speed=LoadReal(h,id,11)
local integer i=0
if Range<2500 and UnitIsAlive(l__d)then
set x1=x1+speed*Cos(a)
set y1=y1+speed*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
call SaveReal(h,id,3,x1)
call SaveReal(h,id,4,y1)
set n=CreateUnit(p,'e14Z',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,25)
call SetUnitTimeScale(n,1)
call SetUnitFlyHeight(n,125,0)
call UnitApplyTimedLife(n,'BTLF',0.15)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SaveReal(h,id,9,Range+speed)
call SaveReal(h,id,11,speed+1)
call GroupEnumUnitsInRange(DG,x1,y1,125,Base)
loop
set E=FirstOfGroup(DG)
exitwhen E==null
if Condition_Base(p,E)then
call RemoveUnit(l__d)
endif
call GroupRemoveUnit(DG,E)
endloop
else
call GroupEnumUnitsInRange(DG,x,y,400,Base)
loop
set E=FirstOfGroup(DG)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(DG,E)
endloop
call ShakeCamera(0.5,20)
call UnitApplyTimedLife(CreateUnit(p,'e0DC',x,y,(a*bj_RADTODEG)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0DF',x,y,(a*bj_RADTODEG)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0DE',x,y,(a*bj_RADTODEG)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0DD',x,y,(a*bj_RADTODEG)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0C7',x,y,(a*bj_RADTODEG)),'BTLF',2)
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
endif
set u=null
set p=null
set t=null
set l__d=null
endfunction
