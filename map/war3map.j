call PauseTimer(t)
call DestroyTimer(t)
call SetUnitTimeScale(u,1)
call SetUnitPathing(u,true)
call PauseUnit(u,false)
if GetLocalPlayer()==p then
call ClearSelection()
call SelectUnit(u,true)
endif
call UnitRemoveAbility(u,'A14C')
call UnitRemoveAbility(u,'A00D')
call SaveInteger(HH,GetHandleId(u),SH_SaberPassive,0)
call FlushChildHashtable(h,id)
call SetUnitInvulnerable(u,false)
set u=null
set p=null
set c=null
set t=null
endfunction
function ExcaliburCombinationCast3 takes nothing returns nothing
