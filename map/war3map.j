call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,2,l__d)
call SaveReal(h,id,3,angle)
call SaveReal(h,id,4,speed)
call SaveReal(h,id,5,dmg)
call SaveReal(h,id,6,x)
call SaveReal(h,id,7,y)
call TimerStart(t,0.03,true,function MissleMoveRedBomb2)
set t=null
endfunction
function RedBombCond takes nothing returns boolean
return GetSpellAbilityId()==0x41304658 and udg_B==true
endfunction
function RedBombCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,3)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,8)
local real y1=LoadReal(h,id,9)
local real a=Atan2(y1-y,x1-x)
local real dmg=LoadReal(h,id,6)+(0.8+0.2*GetUnitAbilityLevel(u,0x41304658))*GetHeroAgi(u,true)*0.1
local real l__s=LoadReal(h,id,7)+0.04
if GetUnitCurrentOrder(u)==OrderId("channel")then
call SetUnitScale(l__d,l__s,l__s,l__s)
call SaveReal(h,id,6,dmg)
call SaveReal(h,id,7,l__s)
else
call MissleMoveRedBomb(u,x1,y1,l__d,40,0,dmg)
call SetUnitInvulnerable(u,false)
call PauseTimer(t)
call UnitRemoveAbility(u,0x41304659)
call DestroyTimer(t)
call RemoveUnit(LoadUnitHandle(h,id,2))
call FlushChildHashtable(h,id)
endif
set l__d=null
set u=null
set t=null
endfunction
function RedBombCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,2,CreateUnit(GetOwningPlayer(u),'e08P',x,y,0))
set n=CreateUnit(GetOwningPlayer(u),0x65303934,x+125*Cos(a),y+125*Sin(a),a*bj_RADTODEG)
call SetUnitScale(n,0.7,0.7,0.7)
call SaveUnitHandle(h,id,3,n)
call SaveReal(h,id,7,0.7)
call SaveReal(h,id,6,(1.75+.25*GetUnitAbilityLevel(u,0x41304658))*GetHeroAgi(u,true))
call SaveReal(h,id,8,x1)
call SaveReal(h,id,9,y1)
call UnitAddAbility(u,0x41304659)
call SetUnitInvulnerable(u,true)
set soundplay=SndN(1175) // Sound\Music\mp3Music\ShuRedBomb.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.05,true,function RedBombCast2)
set u=null
set t=null
endfunction
