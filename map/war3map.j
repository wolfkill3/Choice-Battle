function AssualtRainMissleFly2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
local real dist=LoadReal(h,id,6)
local real mh=LoadReal(h,id,5)
local real rad=LoadReal(h,id,7)
local real rd=SR(x,y,x1,y1)
local real dmg=LoadReal(h,id,8)
local player p=GetOwningPlayer(l__d)
local integer idu=GetPlayerId(p)
if rd>30+speed then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,ParabolaZ(mh,dist,rd),0)
else
call GroupEnumUnitsInRange(DG,x1,y1,rad,Base)
loop
set E=FirstOfGroup(DG)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(Hero[idu],E,dmg,false,false,null,null,null)
call SetControlToUnit(Hero[idu],E, 2, "stun")
endif
call GroupRemoveUnit(DG,E)
endloop
call UnitApplyTimedLife(CreateUnit(p,'e0DC',x1,y1,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0DF',x1,y1,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0DE',x1,y1,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0DD',x1,y1,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0C7',x1,y1,(a*bj_RADTODEG)),'BTLF',6)
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set l__d=null
set t=null
endfunction
function AssualtRainMissleFly takes unit l__d,real speed,real angle,real x,real y,real mh,real r,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,mh)
call SaveReal(h,id,6,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,7,r)
call SaveReal(h,id,8,dmg)
call TimerStart(t,0.03,true,function AssualtRainMissleFly2)
set t=null
endfunction
function AssualtRainCond takes nothing returns boolean
return GetSpellAbilityId()=='A0K4' and udg_B==true
endfunction
function AssualtRainCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real dmg=(3.0+GetUnitAbilityLevel(u,'A0K4'))*GetHeroStr(u,true)
call GroupEnumUnitsInRange(G,x,y,9999999,Base)
set soundplay=SndN(1421) // Sound\Music\mp3Music\AssualtRain.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E) and (IsUnitType(E, UNIT_TYPE_HERO) or IsUnitIllusion(E)==true )  then
set n=CreateUnit(p,'e0F0',x,y,0)
call SetUnitScale(n,2,2,2)
if SR(x,y,GetUnitX(E),GetUnitY(E))>700 then
call AssualtRainMissleFly(n,52,0,GetUnitX(E),GetUnitY(E),GetRandomReal(900,1300),350,dmg)
else
call AssualtRainMissleFly(n,52,0,GetUnitX(E),GetUnitY(E),GetRandomReal(300,500),350,dmg)
endif
endif
call GroupRemoveUnit(G,E)
endloop
call SetUnitAnimation(u,"Spell Channel Two")
set u=null
set p=null
endfunction
