call SaveReal(h,ide,1,LoadReal(h,ide,1)+dmg2)
call SaveReal(h,ide,2,10)
else
call UnitAddAbility(E,'A12N')
call AmaterasuSasuke(u,E,dmg,10,"null","origin")
endif
endif
call GroupRemoveUnit(G,E)
endloop
elseif GetUnitAbilityLevel(u,'A12P')>0 then
call GroupEnumUnitsInRange(G,x,y,220,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
set ide=GetHandleId(E)
if Condition_Base(p,E)then
if GetUnitAbilityLevel(E,'A12N')>0 then
call SaveReal(h,ide,1,LoadReal(h,ide,1)+dmg2)
call SaveReal(h,ide,2,10)
else
call UnitAddAbility(E,'A12N')
call AmaterasuSasuke(u,E,dmg,10,"null","origin")
endif
endif
call GroupRemoveUnit(G,E)
endloop
endif
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\SharinganEnd.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call UnitRemoveAbility(u,'A12O')
call UnitRemoveAbility(u,'A12P')
call RemoveUnit(LoadUnitHandle(h,id,7))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,GetHandleId(u))
call RemoveUnit(l__d)
endif
set u=null
set l__d=null
set t=null
endfunction
