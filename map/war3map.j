function YujiR_CD2 takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
        local unit caster=LoadUnitHandle(h, id, c_CASTER)
    local real time= LoadReal(h, id, c_TIME)
        if time<10 and GetUnitAbilityLevel(caster, 'YuR2')>=1 then
                call SaveReal(h, id, c_TIME, time+0.1)
        else
        if GetUnitAbilityLevel(caster, 'YuR2')>=1 then
			call UnitRemoveAbility(caster, 'YuR2')
		endif
		call ShowAbility2('YujR', true)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
        set caster=null
endfunction


function YujiR_CD takes unit newCaster,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
	call ShowAbility2('YujR', false)
	call UnitAddAbility(newCaster, 'YuR2')
	call SetUnitAbilityLevel(newCaster, 'YuR2', GetUnitAbilityLevel(newCaster, 'YujR'))
	call SaveUnitHandle(h, id, c_CASTER, newCaster)
	call TimerStart(newTimer, 0.1, true, function YujiR_CD2)
endfunction

function YujiR1_Cast takes unit newCaster, real point_x, real point_y returns nothing
    local integer id_caster= GetHandleId(newCaster)
    local real caster_x= GetUnitX(newCaster)
    local real caster_y= GetUnitY(newCaster)
    local real angle= 0.0
    local real index_real= 0
    local boolean yuji_morf=LoadBoolean(h, id_caster, SH_YujiT_Morf)
        
    if GetRandomInt(0, 1) == 0 then
        set soundplay=SndN(3355) // Sound\war3mapImported\YujiR1.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    else
        set soundplay=SndN(3357) // Sound\war3mapImported\YujiR2.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    endif
    if SR(caster_x,caster_y,point_x,point_y)>1200 and RectContainsUnit(gg_rct_UBW2,newCaster) then
        set point_x=GetUnitX(newCaster)+1200*Cos(Angle2(GetUnitX(newCaster),GetUnitY(newCaster),point_x,point_y)*bj_DEGTORAD)
        set point_y=GetUnitY(newCaster)+1200*Sin(Angle2(GetUnitX(newCaster),GetUnitY(newCaster),point_x,point_y)*bj_DEGTORAD)
    endif
    call SetUnitX(newCaster, point_x)
    call SetUnitY(newCaster, point_y)
    call YujiR_CD(newCaster , CreateTimer())
    // call SaveBoolean(h, id_caster, StringHash("YujiR_SecondStack"), false)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR20', caster_x, caster_y, GetRandomInt(0, 360))
    call SetUnitVertexColor(bjLCU, 255, 255, 255, 120)
    call SetUnitScale(bjLCU, 0.6, 0.6, 0.6)
    call UnitApplyTimedLife(bjLCU, 'BTLF', 1)
    call MyRemoveUnit(bjLCU, 2)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR20', point_x, point_y, GetRandomInt(0, 360))
    call SetUnitVertexColor(bjLCU, 255, 255, 255, 120)
    call SetUnitScale(bjLCU, 0.6, 0.6, 0.6)
    call UnitApplyTimedLife(bjLCU, 'BTLF', 1)
    call MyRemoveUnit(bjLCU, 2)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR87', caster_x, caster_y, GetRandomInt(0, 360))
    call SetUnitScale(bjLCU, 1.35, 1.35, 1.35)
    call SetUnitFlyHeight(bjLCU, 50, 0)
    call MyRemoveUnit(bjLCU, 2)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR87', point_x, point_y, GetRandomInt(0, 360))
    call SetUnitScale(bjLCU, 1.35, 1.35, 1.35)
    call SetUnitFlyHeight(bjLCU, 50, 0)
    call MyRemoveUnit(bjLCU, 2)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR50', caster_x, caster_y, 0)
    call SetUnitScale(bjLCU, 0.7, 0.7, 0.7)
    call SetUnitVertexColor(bjLCU, 255, 255, 255, 150)
    call MyRemoveUnit(bjLCU, 2)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR50', caster_x, caster_y, 90)
    call SetUnitScale(bjLCU, 0.6, 0.6, 0.6)
    call SetUnitVertexColor(bjLCU, 255, 255, 255, 150)
    call MyRemoveUnit(bjLCU, 2)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR50', point_x, point_y, 45)
    call SetUnitScale(bjLCU, 0.7, 0.7, 0.7)
    call SetUnitVertexColor(bjLCU, 255, 255, 255, 150)
    call MyRemoveUnit(bjLCU, 2)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR50', point_x, point_y, 150)
    call SetUnitScale(bjLCU, 0.6, 0.6, 0.6)
    call SetUnitVertexColor(bjLCU, 255, 255, 255, 150)
    call MyRemoveUnit(bjLCU, 2)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR88', caster_x, caster_y, GetRandomInt(0, 360))
    call SetUnitFlyHeight(bjLCU, 10, 0)
    call MyRemoveUnit(bjLCU, 2)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR88', point_x, point_y, GetRandomInt(0, 360))
    call SetUnitFlyHeight(bjLCU, 10, 0)
    call MyRemoveUnit(bjLCU, 2)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR54', caster_x, caster_y, GetRandomInt(0, 360))
    call SetUnitScale(bjLCU, 1.7, 1.7, 1.7)
    call SetUnitFlyHeight(bjLCU, 10, 0)
    call MyRemoveUnit(bjLCU, 2)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR54', point_x, point_y, GetRandomInt(0, 360))
    call SetUnitScale(bjLCU, 1.7, 1.7, 1.7)
    call SetUnitFlyHeight(bjLCU, 10, 0)
    call MyRemoveUnit(bjLCU, 2)
    
    set bjLCG = CreateGroup()
    call GroupEnumUnitsInRange(bjLCG, GetUnitX(newCaster), GetUnitY(newCaster), 400, Base)
    loop
    set E=FirstOfGroup(bjLCG)
    exitwhen E==null
        if Condition_Base(GetOwningPlayer(newCaster), E) then
            call myCustomDamage(newCaster , E , GetWidgetMana(newCaster)*0.2 , false , false , null , null , null)
        endif
        call GroupRemoveUnit(bjLCG, E)
    endloop
    call DestroyGroup(bjLCG)
    
    call ShakeCamera(0.1, 10)
    set caster_x = GetUnitX(newCaster)
    set caster_y = GetUnitY(newCaster)
    if yuji_morf == false then
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dR68', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 2.2, 2.2, 2.2)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dR68', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 1.2, 1.2, 1.2)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dR69', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 3.2, 3.2, 3.2)
        call MyRemoveUnit(n, 1)
    else
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dR70', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 2.2, 2.2, 2.2)
        call MyRemoveUnit(n, 2)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dR70', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 1.2, 1.2, 1.2)
        call MyRemoveUnit(n, 2)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dR43', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 1.2, 1.2, 1.2)
        call UnitApplyTimedLife(n,'BTLF', 0.6)
        call MyRemoveUnit(n, 2)
    endif
endfunction

function YujiR2_Cast takes unit newCaster, real point_x, real point_y returns nothing
    local integer id_caster= GetHandleId(newCaster)
    local real caster_x= GetUnitX(newCaster)
    local real caster_y= GetUnitY(newCaster)
    local real angle= 0.0
    local real index_real= 0
    local boolean yuji_morf=LoadBoolean(h, id_caster, SH_YujiT_Morf)
        
    if GetRandomInt(0, 1) == 0 then
        set soundplay=SndN(3355) // Sound\war3mapImported\YujiR1.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    else
        set soundplay=SndN(3357) // Sound\war3mapImported\YujiR2.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    endif
    if SR(caster_x,caster_y,point_x,point_y)>1200 and RectContainsUnit(gg_rct_UBW2,newCaster) then
        set point_x=GetUnitX(newCaster)+1200*Cos(Angle2(GetUnitX(newCaster),GetUnitY(newCaster),point_x,point_y)*bj_DEGTORAD)
        set point_y=GetUnitY(newCaster)+1200*Sin(Angle2(GetUnitX(newCaster),GetUnitY(newCaster),point_x,point_y)*bj_DEGTORAD)
    endif
        call SetUnitX(newCaster, point_x)
        call SetUnitY(newCaster, point_y)
        set bjLCG=CreateGroup()
        call GroupEnumUnitsInRange(bjLCG, caster_x, caster_y, 400, Base)
        loop
        set bjLCU=FirstOfGroup(bjLCG)
        exitwhen bjLCU == null
                set angle=GetRandomReal(0, 360) * bj_DEGTORAD
        if IsUnitEnemy(bjLCU,GetOwningPlayer(newCaster))==false then
                call SetUnitX(bjLCU, point_x + 150 * Cos(angle))
                call SetUnitY(bjLCU, point_y + 150 * Sin(angle))
        endif
                call GroupRemoveUnit(bjLCG, bjLCU)
        endloop
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR20', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitVertexColor(bjLCU, 255, 255, 255, 120)
        call UnitApplyTimedLife(bjLCU, 'BTLF', 1)
        call MyRemoveUnit(bjLCU, 2)
        loop
        exitwhen index_real >= 8
                set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR99', caster_x - 300 * Cos(angle * bj_DEGTORAD), caster_y - 300 * Sin(angle * bj_DEGTORAD), angle)
                call SetUnitVertexColor(bjLCU, 255, 255, 255, 120)
                call MyRemoveUnit(bjLCU, 1.5)
                set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR99', point_x - 300 * Cos(angle * bj_DEGTORAD), point_y - 300 * Sin(angle * bj_DEGTORAD), angle)
                call SetUnitVertexColor(bjLCU, 255, 255, 255, 120)
                call MyRemoveUnit(bjLCU, 1.5)
                set angle=angle + 45
                set index_real=index_real + 1
        endloop
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR20', point_x, point_y, GetRandomInt(0, 360))
        call SetUnitVertexColor(bjLCU, 255, 255, 255, 120)
        call SetUnitScale(bjLCU, 0.6, 0.6, 0.6)
        call UnitApplyTimedLife(bjLCU, 'BTLF', 1)
        call MyRemoveUnit(bjLCU, 2)
        
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR87', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(bjLCU, 1.7, 1.7, 1.7)
        call SetUnitFlyHeight(bjLCU, 50, 0)
        call MyRemoveUnit(bjLCU, 2)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR87', point_x, point_y, GetRandomInt(0, 360))
        call SetUnitScale(bjLCU, 1.7, 1.7, 1.7)
        call SetUnitFlyHeight(bjLCU, 50, 0)
        call MyRemoveUnit(bjLCU, 2)
        
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR76', caster_x, caster_y, GetRandomInt(0, 360))
        call MyRemoveUnit(bjLCU, 2)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR89', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
        call MyRemoveUnit(bjLCU, 2)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR90', point_x, point_y, GetRandomInt(0, 360))
        call SetUnitScale(bjLCU, 2.7, 2.7, 2.7)
        call MyRemoveUnit(bjLCU, 2)
        
        call IssueImmediateOrder(newCaster, "stop")
        call UnitRemoveAbility(newCaster, 'YuR2')
        
        set bjLCG = CreateGroup()
        call GroupEnumUnitsInRange(bjLCG, GetUnitX(newCaster), GetUnitY(newCaster), 400, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
                if Condition_Base(GetOwningPlayer(newCaster), E) then
                        call myCustomDamage(newCaster , E , GetWidgetMana(newCaster)*0.2 , false , false , null , null , null)
                endif
                call GroupRemoveUnit(bjLCG, E)
        endloop
        call DestroyGroup(bjLCG)
        
        call ShakeCamera(0.1, 10)
        set caster_x = GetUnitX(newCaster)
        set caster_y = GetUnitY(newCaster)
        if yuji_morf == false then
                set n=CreateUnit(GetOwningPlayer(newCaster), 'dR68', caster_x, caster_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 2.2, 2.2, 2.2)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(newCaster), 'dR68', caster_x, caster_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 1.2, 1.2, 1.2)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(newCaster), 'dR69', caster_x, caster_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 3.2, 3.2, 3.2)
                call MyRemoveUnit(n, 1)
    else
                set n=CreateUnit(GetOwningPlayer(newCaster), 'dR70', caster_x, caster_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 2.2, 2.2, 2.2)
                call MyRemoveUnit(n, 2)
                set n=CreateUnit(GetOwningPlayer(newCaster), 'dR70', caster_x, caster_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 1.2, 1.2, 1.2)
                call MyRemoveUnit(n, 2)
                set n=CreateUnit(GetOwningPlayer(newCaster), 'dR43', caster_x, caster_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 1.2, 1.2, 1.2)
                call UnitApplyTimedLife(n,'BTLF', 0.6)
                call MyRemoveUnit(n, 2)
    endif
endfunction

function YujiT_Morf_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
        local unit caster=LoadUnitHandle(h, id, 0)
    local real time= LoadReal(h, id, c_TIME)
    if time < 30 and UnitIsAlive(caster) and udg_B then
        // реген и надписи — раз в 5 тиков (0.1 c) пятикратной порцией: было 100 HealTextTag в секунду (просадки FPS)
        call SaveInteger(h, id, 'YTrg', LoadInteger(h, id, 'YTrg') + 1)
        if ModuloInteger(LoadInteger(h, id, 'YTrg'), 5) == 0 then
            call HealTextTag(caster,caster,GetWidgetMaxLife(caster)*0.01 *0.1*myCustomHeal2(caster,1),"HealthRes")
            call HealTextTag(caster,caster,GetWidgetMaxMana(caster)*0.04 *0.1*myCustomMana2(caster,1),"ManaRes")
            call SetWidgetLife(caster, GetWidgetLife(caster) + GetWidgetMaxLife(caster)*0.01 *0.1)
            call SetWidgetMana(caster , GetWidgetMana(caster) + GetWidgetMaxMana(caster)*0.04 *0.1)
        endif
        call SetUnitX(LoadUnitHandle(h, id, 1), GetUnitX(caster))
        call SetUnitY(LoadUnitHandle(h, id, 1), GetUnitY(caster))
        call SetUnitFlyHeight(LoadUnitHandle(h, id, 1), GetUnitFlyHeight(caster) - 10, 0)
        if IsUnitPaused(caster) == false then
            call SaveReal(h, id, c_TIME, time + 0.02)
        endif
    else
        call SaveBoolean(h, GetHandleId(caster), SH_YujiT_Morf, false)
        call UnitRemoveAbility(caster, 'YuT1')
        call UnitRemoveAbility(caster, 'YuT2')
                //call UnitRemoveAbility(caster, 'YuT3')
        //call UnitRemoveAbility(caster, 'YuT4')
        //call ReduceUnitMaxLifePercentage(caster , 1300)
        //call ReduceUnitMaxManaPercentage(caster , 1300)
        call KillUnit(LoadUnitHandle(h, id, 1))
        call MyRemoveUnit(LoadUnitHandle(h, id, 1) , 1.5)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
        set caster=null
endfunction

function YujiT_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
        local unit caster = LoadUnitHandle(h, id, c_CASTER)
    local real caster_x= GetUnitX(caster)
    local real caster_y= GetUnitY(caster)
    local real time= LoadReal(h, id, c_TIME)
    local real angle= 0
    local real percent_hpmp= 0.0
    if time < 4 then
                call SetUnitXY(LoadUnitHandle(h, id, c_DUMMY1), caster_x, caster_y)
                call SetUnitXY(LoadUnitHandle(h, id, c_DUMMY2), caster_x, caster_y)
        call SetUnitScale(LoadUnitHandle(h, id, c_DUMMY2), 2 + time, 2 + time, 2 + time)
        if time > 2 then
                        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR48', caster_x, caster_y, GetRandomInt(0, 360))
                        call SetUnitScale(bjLCU, 0.8 + time / 3, 0.8 + time / 3, 0.8 + time / 3)
                        call KillUnit(bjLCU)
                        call MyRemoveUnit(bjLCU, 1.5)
                        set angle=GetRandomReal(0, 360) * bj_DEGTORAD
                        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR49', caster_x + GetRandomInt(300, 800) * Cos(angle), caster_y + GetRandomInt(300, 800) * Sin(angle), GetRandomInt(0, 360))
                        call SetUnitScale(bjLCU, 1.2, 1.2, 1.2)
                        call MyRemoveUnit(bjLCU, 1.5)
                        
        else
            if LoadBoolean(h, id, SH_ExtraEffect2) == false then
                                set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR50', caster_x, caster_y, GetRandomInt(0, 360))
                                call SetUnitScale(bjLCU, 0.5 + time / 3, 0.5 + time / 3, 0.5 + time / 3)
                                call SetUnitVertexColor(bjLCU, 255, 255, 255, 185)
                                call MyRemoveUnit(bjLCU, 1.2)
                call SaveBoolean(h, id, SH_ExtraEffect2, true)
            else
                call SaveBoolean(h, id, SH_ExtraEffect2, false)
            endif
        endif
        if time == 2 then
                        set n=CreateUnit(GetOwningPlayer(caster), 'dR93', caster_x, caster_y, 0)
                        call SetUnitScale(n, 10, 10, 10)
                        call UnitApplyTimedLife(n,'BTLF', 2)
                        call MyRemoveUnit(n, 3)
                        set n=CreateUnit(GetOwningPlayer(caster), 'dR93', caster_x, caster_y, 0)
                        call SetUnitScale(n, 3, 3, 3)
                        call MyRemoveUnit(n, 3)
                        set n=CreateUnit(GetOwningPlayer(caster), 'dR43', caster_x, caster_y, 0)
                        call SetUnitScale(n, 1.5, 1.5, 1.5)
                        call UnitApplyTimedLife(n,'BTLF', 2)
                        call MyRemoveUnit(n, 3)
        endif
        if time < 2 and LoadInteger(h, id, SH_ExtraEffect1) == 0 then
                        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR91', caster_x, caster_y, GetRandomInt(0, 360))
                        call SetUnitScale(bjLCU, 1+time/2, 1+time/2, 1+time/2)
                        call SetUnitFlyHeight(bjLCU, 20, 0)
                        call MyRemoveUnit(bjLCU, 0.7)
        endif
        if LoadInteger(h, id, SH_ExtraEffect1) == 0 then
                        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR92', caster_x, caster_y, GetRandomInt(0, 360))
                        call SetUnitScale(bjLCU, 3.8, 3.8, 3.8)
                        call SetUnitFlyHeight(bjLCU, 150, 0)
                        call MyRemoveUnit(bjLCU, 1.5)
            call SaveInteger(h, id, SH_ExtraEffect1, 4)
        else
            call SaveInteger(h, id, SH_ExtraEffect1, LoadInteger(h, id, SH_ExtraEffect1) - 1)
        endif
        call SaveReal(h, id, c_TIME, time + 0.1)
    else
        //call SaveBoolean(h, GetHandleId(caster), StringHash("ResetMorf"), false)
        call SaveBoolean(h, GetHandleId(caster), SH_YujiT_Morf, true)
        call UnitAddAbility(caster, 'YuT1')
        call UnitAddAbility(caster, 'YuT2')
        //call UnitAddAbility(caster, 'YuT3') // call AddUnitMaxLifePercentage(caster , 1300)
        //call UnitAddAbility(caster, 'YuT4') // call AddUnitMaxManaPercentage(caster , 1300)
        set bjLCT=CreateTimer()
        //set bjLCE = AddSpecialEffectTarget("orgia mode6.mdl", caster, "origin")
        //set bjLCE = AddSpecialEffectTarget("EnviromentUpLineBlack.mdl", caster, "origin")
        //set bjLCE = AddSpecialEffectTarget("NDA! (268).mdl", caster, "origin")
        //set bjLCE = AddSpecialEffect("FantasyBattle (910).mdl", GetUnitX(caster), GetUnitY(caster))
        //call SetSpecialEffectScale(bjLCE, 0.3)
        //call SetSpecialEffectAlpha(bjLCE, 100)
       // call SaveEffectHandle(h, GetHandleId(bjLCT), StringHash("YujiT_Aura"), bjLCE)
        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR93', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
        call SetUnitFlyHeight(bjLCU, - 50, 0)
        call SetUnitScale(bjLCU, 0.8, 0.8, 0.8)
        call SaveUnitHandle(h, GetHandleId(bjLCT), 1, bjLCU)
        call SaveUnitHandle(h, GetHandleId(bjLCT), 0, caster)
        call TimerStart(bjLCT, 0.02, true, function YujiT_Morf_Periodic)
        call CreateModeIndicatorWithPauseForm(caster, "ReplaceableTextures\\CommandButtons\\BTNYujiT.blp", 30)
                set bjLCT=null
        call KillUnit(LoadUnitHandle(h, id, c_DUMMY1))
        call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY1) , 1)
        call KillUnit(LoadUnitHandle(h, id, c_DUMMY2))
        call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY2) , 1)
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call IssueImmediateOrder(caster, "stop")
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
        set caster=null
endfunction

function YujiT_Cast takes unit newCaster,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local integer id_caster= GetHandleId(newCaster)
        local real caster_x= GetUnitX(newCaster)
        local real caster_y= GetUnitY(newCaster)
    set soundplay=SndN(3359) // Sound\war3mapImported\YujiT.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dH67', caster_x, caster_y, GetUnitFacing(newCaster))
    call SetUnitScale(bjLCU, 2, 2, 2)
    call SaveUnitHandle(h, id, c_DUMMY1, bjLCU)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dH68', caster_x, caster_y, GetUnitFacing(newCaster))
    call SetUnitScale(bjLCU, 2, 2, 2)
    call SaveUnitHandle(h, id, c_DUMMY2, bjLCU)
    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
    //call SaveBoolean(h, id_caster, StringHash("ResetMorf"), true)
    //call SaveBoolean(h, id_caster, StringHash("YujiT_Morf"), true)
    call SaveUnitHandle(h, id, c_CASTER, newCaster)
    call TimerStart(newTimer, 0.1, true, function YujiT_Periodic)
endfunction



function Trig_YujiInt_Actions takes nothing returns nothing
    if GetSpellAbilityId() == 'YujD' then
        call YujiD_Cast(GetSpellAbilityUnit())
    endif
    if GetSpellAbilityId() == 'YujF' then
        call YujiF_Cast(GetSpellAbilityUnit() , CreateTimer())
    endif
    if GetSpellAbilityId() == 'YuF2' then
        call SaveBoolean(h, GetHandleId(GetSpellAbilityUnit()), SH_YujiF_ForcedCancel, true)
    endif
    if GetSpellAbilityId() == 'YujQ' then
        call YujiQ_Cast(GetSpellAbilityUnit() , GetSpellTargetX() , GetSpellTargetY() , CreateTimer())
    endif
    if GetSpellAbilityId() == 'YujW' then
        call YujiW_Cast(GetSpellAbilityUnit() , GetSpellTargetX() , GetSpellTargetY() , CreateTimer())
    endif
    if GetSpellAbilityId() == 'YujE' then
        if GetSpellTargetUnit() != null then
            call YujiE_Target(GetSpellAbilityUnit() , GetSpellTargetUnit() , CreateTimer())
                        if GetSpellAbilityUnit()==GetSpellTargetUnit() then
                                set soundplay=SndN(3361) // Sound\war3mapImported\YujiE_Himself.mp3
                        else
                                set soundplay=SndN(3363) // Sound\war3mapImported\YujiE_Target.mp3
                        endif
                        call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        else
                        if LoadBoolean(h, GetHandleId(GetSpellAbilityUnit()), SH_YujiT_Morf) then
                                set soundplay=SndN(3365) // Sound\war3mapImported\YujiE_Voice2.mp3
                        else
                                set soundplay=SndN(3367) // Sound\war3mapImported\YujiE_Voice1.mp3
                        endif
                        call StartSound(soundplay)
                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            call YujiE_AOE(GetSpellAbilityUnit() , GetSpellTargetX() , GetSpellTargetY() , CreateTimer())
        endif
        endif
        if GetSpellAbilityId() == 'YujR' then   // Первое тп
        call YujiR1_Cast(GetSpellAbilityUnit() , GetSpellTargetX() , GetSpellTargetY())
    endif
        if GetSpellAbilityId() == 'YuR2' then   // Второе тп
        call YujiR2_Cast(GetSpellAbilityUnit() , GetSpellTargetX() , GetSpellTargetY())
    endif
    if GetSpellAbilityId() == 'YujT' then
        call YujiT_Cast(GetSpellAbilityUnit() , CreateTimer())
    endif
endfunction

//===========================================================================
function InitTrig_YujiInt takes nothing returns nothing
    local trigger trig= CreateTrigger()
    local integer index= 0
    loop
        call TriggerRegisterPlayerUnitEvent(trig, Player(index), EVENT_PLAYER_UNIT_SPELL_EFFECT, null)
        set index=index + 1
        exitwhen index == bj_MAX_PLAYER_SLOTS
    endloop
    call TriggerAddAction(trig, function Trig_YujiInt_Actions)
        set trig=null
endfunction


//===========================================================================
// Minato Namikaze INT
//===========================================================================

function MinatoRemoveSpellTimed2 takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local real time= LoadReal(h, id, TIME_HASH)
    local integer spell_first= LoadInteger(h, id, SH_Spell_First)
    local integer spell_second= LoadInteger(h, id, SH_Spell_Second)
    if time > 0 and GetUnitAbilityLevel(LoadUnitHandle(h, id, CasterHash), spell_first) > 0 then
        if IsUnitPaused(LoadUnitHandle(h, id, CasterHash)) == false then
            call SaveReal(h, id, TIME_HASH, time - 0.05)
        endif
    else
        if GetUnitAbilityLevel(LoadUnitHandle(h, id, CasterHash), spell_first) > 0 then
            call UnitRemoveAbility(LoadUnitHandle(h, id, CasterHash), spell_first)
            if spell_first == 'MiW1' then
                call UnitRemoveAbility(LoadUnitHandle(h, id, CasterHash), 'MiW2')
                //call DisplayTimedTextToPlayer(Player(0), 0, 0, 3, "Rasengan is removed")
                call DestroyEffect(LoadEffectHandle(h, GetHandleId(LoadUnitHandle(h, id, CasterHash)), SH_MinatoW_Eff))
                call RemoveSavedHandle(h, GetHandleId(LoadUnitHandle(h, id, CasterHash)), SH_MinatoW_Eff)
                if GetUnitAbilityLevel(LoadUnitHandle(h, id, CasterHash), 'MiQ3') >= 1 then
                    call UnitRemoveAbility(LoadUnitHandle(h, id, CasterHash), 'MiQ3')
                endif
            endif
        endif
        if spell_second=='MiQ1' or spell_second=='MiQ4' then
            if LoadBoolean(h, GetHandleId(LoadUnitHandle(h, id, CasterHash)), SH_MinatoR_Mod) then
                set spell_second='MiQ4'
            else
                set spell_second='MiQ1'
            endif
        endif
        if spell_second != 0 then
            call ShowAbility2( spell_second , true)
        endif
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
endfunction

function MinatoRemoveSpellTimed takes unit newCaster,integer spell_first,integer spell_second,real time,timer newTimer returns nothing
    local integer id=GetHandleId(newTimer)
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call SaveReal(h, id, TIME_HASH, time)
    call SaveInteger(h, id, SH_Spell_First, spell_first)
    call SaveInteger(h, id, SH_Spell_Second, spell_second)
    call TimerStart(newTimer, 0.05, true, function MinatoRemoveSpellTimed2)
endfunction


function MinatoSeal_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local integer id_target= GetHandleId(LoadUnitHandle(h, id, TargetHash))
    call SaveReal(h, id_target, SH_MinatoSeal_Dur, LoadReal(h, id_target, SH_MinatoSeal_Dur) - 0.1)
    if LoadReal(h, id_target, SH_MinatoSeal_Dur) <= 0 or GetUnitAbilityLevel(LoadUnitHandle(h, id, TargetHash), 'MiDp') == 0 then
        if GetUnitAbilityLevel(LoadUnitHandle(h, id, TargetHash), 'MiDp') >= 1 then
            call UnitRemoveAbility(LoadUnitHandle(h, id, TargetHash), 'MiDp')
        endif
        call SaveReal(h, id_target, SH_MinatoSeal_Dur, 0.0)
        call RemoveSavedReal(h, id_target, SH_MinatoSeal_Dur)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
endfunction

function MinatoAddHiraishinSeal takes unit newTarget,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local integer id_target= GetHandleId(newTarget)
    local real time= LoadReal(h, id_target, SH_MinatoSeal_Dur)
    if time == 0.0 then
        call UnitAddAbility(newTarget, 'MiDp')
        call UnitMakeAbilityPermanent(newTarget, true, 'MiDp')
        call SaveReal(h, id_target, SH_MinatoSeal_Dur, 15)
        call SaveUnitHandle(h, id, TargetHash, newTarget)
        call TimerStart(newTimer, 0.1, true, function MinatoSeal_Periodic)
    else
        //call DisplayTimedTextToPlayer(Player(0), 0, 0, 3, "Hiraishin Seal updated: " + GetUnitName(newTarget) + ", handle: " + I2S(GetHandleId(newTarget)))
        if time>15.0 then
            call SaveReal(h, id_target, SH_MinatoSeal_Dur, 25)
        else
            call SaveReal(h, id_target, SH_MinatoSeal_Dur, 15)
        endif
        call DestroyTimer(newTimer)
    endif
endfunction

function MinatoAddHiraishinSeal25sec takes unit newTarget,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local integer id_target= GetHandleId(newTarget)
    local real time= LoadReal(h, id_target, SH_MinatoSeal_Dur)
    if time == 0.0 then
        call UnitAddAbility(newTarget, 'MiDp')
        call UnitMakeAbilityPermanent(newTarget, true, 'MiDp')
        call SaveReal(h, id_target, SH_MinatoSeal_Dur, 25)
        call SaveUnitHandle(h, id, TargetHash, newTarget)
        call TimerStart(newTimer, 0.1, true, function MinatoSeal_Periodic)
    else
        //call DisplayTimedTextToPlayer(Player(0), 0, 0, 3, "Hiraishin Seal updated: " + GetUnitName(newTarget) + ", handle: " + I2S(GetHandleId(newTarget)))
        call SaveReal(h, id_target, SH_MinatoSeal_Dur, 25)
        call DestroyTimer(newTimer)
    endif
endfunction


function MinatoD1_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local real angle=AU(LoadUnitHandle(h, id, CasterHash) , LoadUnitHandle(h, id, TargetHash))
    if SquareRootUnit(LoadUnitHandle(h, id, CasterHash) , LoadUnitHandle(h, id, TargetHash)) > 100 then
        call SetUnitX(LoadUnitHandle(h, id, CasterHash), GetUnitX(LoadUnitHandle(h, id, CasterHash)) + 35 * Cos(angle))
        call SetUnitY(LoadUnitHandle(h, id, CasterHash), GetUnitY(LoadUnitHandle(h, id, CasterHash)) + 35 * Sin(angle))
        if LoadInteger(h, id, EffectPeriodHash) == 0 then
            set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM11', GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)), angle * bj_RADTODEG)
            call SetUnitFlyHeight(bjLCU, 150, 0)
            call SetUnitVertexColor(bjLCU, 255, 255, 255, 140)
            call SetUnitScale(bjLCU, 0.5, 0.5, 0.5)
            call MyRemoveUnit(bjLCU , 1.5)
            set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM29', GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)), angle * bj_RADTODEG)
            call SetUnitVertexColor(bjLCU, 255, 255, 255, 180)
            call SetUnitScale(bjLCU, 0.8, 0.8, 0.8)
            call MyRemoveUnit(bjLCU , 1.5)
            call SaveInteger(h, id, EffectPeriodHash, 8)
        else
            call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash) - 1)
        endif
    else
        call DestroyEffect(LoadEffectHandle(h, id, Effect1Hash))
        call DestroyEffect(LoadEffectHandle(h, id, Effect2Hash))
        call MinatoAddHiraishinSeal(LoadUnitHandle(h, id, TargetHash) , CreateTimer())
        call PauseUnit(LoadUnitHandle(h, id, CasterHash), false)
        call SetUnitVertexColor(LoadUnitHandle(h, id, CasterHash), 255, 255, 255, 255)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
endfunction

function MinatoD1_Cast takes unit newCaster,unit newTarget,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local real caster_x= GetUnitX(newCaster)
    local real caster_y= GetUnitY(newCaster)
    local real angle= AU(newCaster , newTarget)
    if newCaster == newTarget then
        set soundplay=SndN(3369) // Sound\war3mapImported\Minato_D(self).mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        if GetAbilityRemainingCooldown(GetUnitAbility(newCaster , 'MiQ1')) > 1.0 and GetUnitAbilityLevel(newCaster, 'MiQ1') > 0 then
            call StartAbilityCooldown(GetUnitAbility(newCaster , 'MiQ1' ), 0.1)
        else
            set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM02', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
            call UnitApplyTimedLife(bjLCU, 'BTLF', 15)
            call UnitEnableInventoryCustom(bjLCU,false,false )
            call UnitEnableMovement(bjLCU,false,false )
            call UnitEnableAttack(bjLCU,false,false )
        endif
        call DestroyTimer(newTimer)
    else
        set soundplay=SndN(3371) // Sound\war3mapImported\Minato_D.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM04', caster_x, caster_y, angle * bj_RADTODEG)
        call SetUnitFlyHeight(bjLCU, 150, 0)
        call SetUnitScale(bjLCU, 0.8, 0.8, 0.8)
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM11', caster_x, caster_y, angle * bj_RADTODEG)
        call SetUnitFlyHeight(bjLCU, 150, 0)
        call MyRemoveUnit(bjLCU , 1.5)
        call SaveEffectHandle(h, id, Effect1Hash, AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Rejuvenation\\RejuvenationTarget.mdl", newCaster, "chest"))
        call SaveEffectHandle(h, id, Effect2Hash, AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Rejuvenation\\RejuvenationTarget.mdl", newCaster, "hand right"))
        call PauseUnit(newCaster, true)
        call SetUnitAnimationByIndex(newCaster, 3)
        call SetUnitVertexColor(newCaster, 255, 255, 255, 110)
        call SaveUnitHandle(h, id, CasterHash, newCaster)
        call SaveUnitHandle(h, id, TargetHash, newTarget)
        call TimerStart(newTimer, 0.01, true, function MinatoD1_Periodic)
    endif
endfunction

function MinatoD2_AirCombination_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local unit caster= LoadUnitHandle(h, id, CasterHash)
    local unit target= LoadUnitHandle(h, id, TargetHash)
    local unit dummy= LoadUnitHandle(h, id, Dummy1Hash)
    local integer act= LoadInteger(h, id, SH_Act)
    local real time=LoadReal(h, id, TIME_HASH)
    local real angle=LoadReal(h, id, AngleHash)
    if act < 3 then
        call SaveReal(h, id, TIME_HASH, time + 0.01)
        call PauseUnit(caster, true)
        call PauseUnit(target,true)
        call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
        if act == 0 then
            if time < 1.2 then
                call SetUnitX(target, GetUnitX(target) + 6 * Cos(angle))
                call SetUnitY(target, GetUnitY(target) + 6 * Sin(angle))
                call SetUnitFlyHeight(target, GetUnitFlyHeight(target) + 10, 0)
                call SetUnitFlyHeight(dummy, GetUnitFlyHeight(target) + 10, 0)
                if LoadInteger(h, id, EffectPeriodHash) == 0 then
                    call SetUnitX(dummy, GetUnitX(target) + GetRandomReal(- 250, 250))
                    call SetUnitY(dummy, GetUnitY(target) + GetRandomReal(- 250, 250))
                    set n=CreateUnit(GetOwningPlayer(caster), 'dM08', GetUnitX(dummy), GetUnitY(dummy), GetRandomInt(0, 360))
                    call SetUnitFlyHeight(n, GetUnitFlyHeight(dummy) + 150, 0)
                    call SetUnitScale(n, 0.5, 0.5, 0.5)
                    call MyRemoveUnit(n , 1.5)
                    set n=CreateUnit(GetOwningPlayer(caster), 'dM09', GetUnitX(dummy), GetUnitY(dummy), GetRandomInt(0, 360))
                    call SetUnitFlyHeight(n, GetUnitFlyHeight(dummy) + 150, 0)
                    call MyRemoveUnit(n , 1.5)
                    set n=CreateUnit(GetOwningPlayer(caster), 'dM38', GetUnitX(dummy), GetUnitY(dummy), GetRandomInt(0, 360))
                    call SetUnitFlyHeight(n, GetUnitFlyHeight(dummy) + 150, 0)
                    call MyRemoveUnit(n , 1.5)
                    set n=CreateUnit(GetOwningPlayer(caster), 'dM39', GetUnitX(dummy), GetUnitY(dummy), angle * bj_RADTODEG)
                    call SetUnitFlyHeight(n, GetUnitFlyHeight(target) + 55, 0)
                    call SetUnitTimeScale(n, 1.2)
                    call SetUnitFacing(n, AU(n , target) * bj_RADTODEG)
                    call SetUnitVertexColor(n, 255, 255, 255, 130)
                    if LoadBoolean(h, GetHandleId(caster), SH_MinatoR_Mod) then
                        call SetUnitAnimationByIndex(n, GetRandomInt(13, 14))
                    else
                        call SetUnitAnimationByIndex(n, GetRandomInt(2, 3))
                    endif
                    call MyRemoveUnit(n , 0.4)
                    call SaveInteger(h, id, EffectPeriodHash, 8)
                else
                    call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash) - 1)
                endif
            else
                call SaveInteger(h, id, SH_Act, 1)
                call SaveReal(h, id, TIME_HASH, 0.0)
                call SetUnitX(caster, GetUnitX(target) + 150 * Cos(angle))
                call SetUnitY(caster, GetUnitY(target) + 150 * Sin(angle))
                call SetUnitFlyHeight(caster, GetUnitFlyHeight(target), 0)
                call SetUnitFacing(caster, angle * bj_RADTODEG + 180)
                call SetUnitAnimationByIndex(caster, 17)
                set n=CreateUnit(GetOwningPlayer(caster), 'dM08', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
                call SetUnitFlyHeight(n, GetUnitFlyHeight(caster) + 115, 0)
                call MyRemoveUnit(n , 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'dM09', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
                call SetUnitFlyHeight(n, GetUnitFlyHeight(caster) + 115, 0)
                call MyRemoveUnit(n , 1.5)
                set soundplay=SndN(3373) // Sound\war3mapImported\MinatoT_Sound3.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            endif
        elseif act == 1 then
            if time == 0.2 then
                call KillUnit(dummy)
                call MyRemoveUnit(dummy , 1)
                set dummy=CreateUnit(GetOwningPlayer(caster), 'dM13', GetUnitX(target), GetUnitY(target), 0)
                call SetUnitScale(dummy, 12, 12, 12)
                call SetUnitFlyHeight(dummy, GetUnitFlyHeight(target) + 120, 0)
                call SaveUnitHandle(h, id, Dummy1Hash, dummy)
                set angle=angle - 180 * bj_DEGTORAD
                set n=CreateUnit(GetOwningPlayer(caster), 'dH07', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
                call SetUnitFlyHeight(n, GetUnitFlyHeight(target) + 150, 0)
                call SetUnitTimeScale(n, 0.6)
                call SetUnitVertexColor(n, 255, 255, 255, 185)
                call SetUnitScale(n, 2, 2, 2)
                call MyRemoveUnit(n , 2.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'dM16', GetUnitX(caster) + 200 * Cos(angle), GetUnitY(caster) + 200 * Sin(angle), angle * bj_RADTODEG)
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call SetUnitFlyHeight(n, GetUnitFlyHeight(target) + 150, 0)
                call SetUnitTimeScale(n, 0.5)
                call MyRemoveUnit(n , 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'dM17', GetUnitX(caster) + 200 * Cos(angle), GetUnitY(caster) + 200 * Sin(angle), GetRandomInt(0, 360))
                call SetUnitScale(n, 5, 5, 5)
                call SetUnitFlyHeight(n, GetUnitFlyHeight(target) + 120, 0)
                call SetUnitTimeScale(n, 0.65)
                call MyRemoveUnit(n , 3.0)
                set n=CreateUnit(GetOwningPlayer(caster), 'dM37', GetUnitX(caster) + 170 * Cos(angle), GetUnitY(caster) + 170 * Sin(angle), angle * bj_RADTODEG)
                call SetUnitScale(n, 1.2, 1.2, 1.2)
                call SetUnitFlyHeight(n, GetUnitFlyHeight(target) + 120, 0)
                call SetUnitTimeScale(n, 0.6)
                call MyRemoveUnit(n , 3.0)
                set n=CreateUnit(GetOwningPlayer(caster), 'dM37', GetUnitX(caster) + 170 * Cos(angle), GetUnitY(caster) + 170 * Sin(angle), angle * bj_RADTODEG)
                call SetUnitScale(n, 1.2, 1.2, 1.2)
                call SetUnitFlyHeight(n, GetUnitFlyHeight(target) + 120, 0)
                call SetUnitTimeScale(n, 0.6)
                call MyRemoveUnit(n , 3.0)
                set n=CreateUnit(GetOwningPlayer(caster), 'dM17', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
                call SetUnitFlyHeight(n, GetUnitFlyHeight(caster) + 150, 0)
                call SetUnitScale(n, 6, 6, 6)
                call MyRemoveUnit(n , 1.5)
            endif
            if time > 0.45 then
                call ShakeCamera(0.2 , 10)
                call SaveInteger(h, id, SH_Act, 2)
                call SaveReal(h, id, TIME_HASH, 0.0)
                call SaveReal(h, id, SH_Damage, LoadReal(h, GetHandleId(caster), SH_MinatoW_Damage))
                call MinatoRemoveRasengan(caster)
            endif
        elseif act == 2 then
            if time < 0.6 then
                call SetUnitX(target, GetUnitX(target) - 12 * Cos(angle))
                call SetUnitY(target, GetUnitY(target) - 12 * Sin(angle))
                call SetUnitX(dummy, GetUnitX(target))
                call SetUnitY(dummy, GetUnitY(target))
                call SetUnitFlyHeight(target, GetUnitFlyHeight(target) - 20, 0)
                call SetUnitFlyHeight(dummy, GetUnitFlyHeight(target) + 120, 0)
            else
                call ShakeCamera(0.2 , 15)
                call SaveInteger(h, id, SH_Act, 3)
                set n=CreateUnit(GetOwningPlayer(caster), 'dM34', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call KillUnit(n)
                call MyRemoveUnit(n , 2.5)
            endif
        endif
    else
        set soundplay=SndN(3376) // Sound\war3mapImported\MinatoT_Sound4.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        if GetRandomInt(0, 1) == 0 then
            set soundplay=SndN(3379) // Sound\war3mapImported\MinatoRWD_Voice3.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        endif
        set n=CreateUnit(GetOwningPlayer(caster), 'dM08', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
        call SetUnitFlyHeight(n, GetUnitFlyHeight(caster) + 115, 0)
        call MyRemoveUnit(n , 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'dM09', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
        call SetUnitFlyHeight(n, GetUnitFlyHeight(caster) + 115, 0)
        call MyRemoveUnit(n , 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'dM08', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
        call MyRemoveUnit(n , 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'dM09', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
        call MyRemoveUnit(n , 1.5)
        call SetUnitFlyHeight(caster, 0, 0)
        call SetUnitFlyHeight(target, 0, 0)
        call KillUnit(dummy)
        call MyRemoveUnit(dummy , 1)
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call IssueImmediateOrder(caster, "stop")
        call StartAbilityCooldown(GetUnitAbility(caster , 'MiD2' ), 45)
        call PauseUnit(target,false)
        call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
        call SetUnitInvulnerable(target, false)
        call myCustomDamage(caster , target , GetHeroAgi(caster, true)*5 + LoadReal(h, id, SH_Damage) , false , false , null , null , null)
        call SetControlToUnit(caster , target , 1.0 , "stun")
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
    set target=null
    set dummy=null
endfunction


function MinatoD2_AirCombination_Cast takes unit newCaster,unit newTarget,real newAngle,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local real caster_x= GetUnitX(newCaster)
    local real caster_y= GetUnitY(newCaster)
    local real angle=newAngle
    call UnitAddAbility(newCaster, 'Arav')
    call UnitRemoveAbility(newCaster, 'Arav')
    call UnitAddAbility(newTarget, 'Arav')
    call UnitRemoveAbility(newTarget, 'Arav')
    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, 12)
    call PauseUnit(newTarget,true)
    call SaveBoolean(HH,GetHandleId(newTarget),TARGET_ABILITY,true)
    call SetUnitInvulnerable(newTarget, true)
    set soundplay=SndN(3382) // Sound\war3mapImported\MinatoT_Sound2.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set soundplay=SndByPath("Sound\\war3mapImported\\MinatoRWD_Voice" + I2S(GetRandomInt(1, 2)) + ".mp3")
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM35', caster_x, caster_y, GetRandomInt(0, 360))
    call SetUnitScale(n, 2, 2, 2)
    call SaveUnitHandle(h, id, Dummy1Hash, n)
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call SaveUnitHandle(h, id, TargetHash, newTarget)
    call SaveReal(h, id, AngleHash, angle)
    call TimerStart(newTimer, 0.01, true, function MinatoD2_AirCombination_Periodic)
endfunction

function MinatoD2_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local real distance=LoadReal(h, id, SH_Distance)
    local real angle=LoadReal(h, id, AngleHash)
    if distance < 800 then
        call SetUnitX(LoadUnitHandle(h, id, CasterHash), GetUnitX(LoadUnitHandle(h, id, CasterHash)) + 35 * Cos(angle))
        call SetUnitY(LoadUnitHandle(h, id, CasterHash), GetUnitY(LoadUnitHandle(h, id, CasterHash)) + 35 * Sin(angle))
        call SaveReal(h, id, SH_Distance, distance + 35)
        set bjLCG=LoadGroupHandle(h, id, SH_Group1)
        call GroupEnumUnitsInRange(bjLCG, GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)), 150, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E == null
            if IsUnitInGroup(E, LoadGroupHandle(h, id, SH_Group2)) == false and E != LoadUnitHandle(h, id, CasterHash) then
                if GetUnitAbilityLevel(LoadUnitHandle(h, id, CasterHash), 'MiW1') >= 1 and Condition_Base(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)) , E) and IsUnitInvulnerable(E)==false then
                    if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
                        call MinatoD2_AirCombination_Cast(LoadUnitHandle(h, id, CasterHash) , E , angle , CreateTimer())
                        call GroupClear(bjLCG)
                    else
                        call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,LoadUnitHandle(h, id, CasterHash))
                        call MinatoRemoveRasengan(LoadUnitHandle(h, id, CasterHash))
                    endif
                    call SaveReal(h, id, SH_Distance, 800)
                else
                    call MinatoAddHiraishinSeal(E , CreateTimer())
                    call GroupAddUnit(LoadGroupHandle(h, id, SH_Group2), E)
                endif
            endif
        call GroupRemoveUnit(bjLCG, E)
        endloop
        if LoadInteger(h, id, EffectPeriodHash) == 0 then
            set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM11', GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)), angle * bj_RADTODEG)
            call SetUnitFlyHeight(bjLCU, 150, 0)
            call SetUnitVertexColor(bjLCU, 255, 255, 255, 140)
            call SetUnitScale(bjLCU, 0.6, 0.6, 0.6)
            call MyRemoveUnit(bjLCU , 1.5)
            set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM29', GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)), angle * bj_RADTODEG)
            call SetUnitVertexColor(bjLCU, 255, 255, 255, 180)
            call SetUnitScale(bjLCU, 0.8, 0.8, 0.8)
            call MyRemoveUnit(bjLCU , 1.5)
            call SaveInteger(h, id, EffectPeriodHash, 8)
        else
            call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash) - 1)
        endif
    else
        set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM30', GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)), angle * bj_RADTODEG)
        call SetUnitScale(bjLCU, 0.85, 0.85, 0.85)
        call SetUnitVertexColor(bjLCU, 255, 255, 255, 200)
        call MyRemoveUnit(bjLCU , 1.5)
        call DestroyEffect(LoadEffectHandle(h, id, Effect1Hash))
        call DestroyEffect(LoadEffectHandle(h, id, Effect2Hash))
        call DestroyGroup(LoadGroupHandle(h, id, SH_Group1))
        call DestroyGroup(LoadGroupHandle(h, id, SH_Group2))
        call PauseUnit(LoadUnitHandle(h, id, CasterHash), false)
        call SetUnitVertexColor(LoadUnitHandle(h, id, CasterHash), 255, 255, 255, 255)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
endfunction

function MinatoD2_Cast takes unit newCaster,unit newTarget,real point_x,real point_y,timer newTimer returns nothing
    local integer id=GetHandleId(newTimer)
    local real caster_x=GetUnitX(newCaster)
    local real caster_y=GetUnitY(newCaster)
    local real angle=AtanPoint(caster_x , caster_y , point_x , point_y)
    if newCaster == newTarget then
        set soundplay=SndN(3369) // Sound\war3mapImported\Minato_D(self).mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        if GetAbilityRemainingCooldown(GetUnitAbility(newCaster , 'MiQ4')) > 1.0 and GetUnitAbilityLevel(newCaster, 'MiQ4') > 0 then
            call StartAbilityCooldown(GetUnitAbility(newCaster , 'MiQ4' ), 0.1)
        else
            set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM02', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
            call UnitApplyTimedLife(bjLCU, 'BTLF', 15)
            call UnitEnableInventoryCustom(bjLCU,false,false )
            call UnitEnableMovement(bjLCU,false,false )
            call UnitEnableAttack(bjLCU,false,false )
        endif
        call DestroyTimer(newTimer)
    else
        if GetUnitAbilityLevel(newCaster, 'MiW1') > 0 then
            set soundplay=SndN(3388) // Sound\war3mapImported\Minato_R_WD1.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        else
            set soundplay=SndN(3390) // Sound\war3mapImported\Minato_RD.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        endif
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM04', caster_x, caster_y, angle * bj_RADTODEG)
        call SetUnitFlyHeight(bjLCU, 150, 0)
        call SetUnitScale(bjLCU, 0.8, 0.8, 0.8)
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM11', caster_x, caster_y, angle * bj_RADTODEG)
        call SetUnitFlyHeight(bjLCU, 150, 0)
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM30', caster_x, caster_y, angle * bj_RADTODEG)
        call SetUnitScale(bjLCU, 0.85, 0.85, 0.85)
        call SetUnitVertexColor(bjLCU, 255, 255, 255, 200)
        call MyRemoveUnit(bjLCU , 1.5)
        call SaveEffectHandle(h, id, Effect1Hash, AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Rejuvenation\\RejuvenationTarget.mdl", newCaster, "chest"))
        call SaveEffectHandle(h, id, Effect2Hash, AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Rejuvenation\\RejuvenationTarget.mdl", newCaster, "hand right"))
        call PauseUnit(newCaster, true)
        call SetUnitAnimationByIndex(newCaster, 11)
        call SetUnitVertexColor(newCaster, 255, 255, 255, 110)
        call SaveUnitHandle(h, id, CasterHash, newCaster)
        call SaveReal(h, id, AngleHash, angle)
        call SaveGroupHandle(h, id, SH_Group1, CreateGroup())
        call SaveGroupHandle(h, id, SH_Group2, CreateGroup())
        call TimerStart(newTimer, 0.01, true, function MinatoD2_Periodic)
    endif
endfunction


function MinatoQ3_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local real time= LoadReal(h, id, TIME_HASH) + 0.01
    local real angle= LoadReal(h, id, AngleHash)
    call SaveReal(h, id, TIME_HASH, time)
    if time < 0.55 then
        call PauseUnit(LoadUnitHandle(h, id, TargetHash), true)
        call SaveBoolean(HH,GetHandleId(LoadUnitHandle(h, id, TargetHash)),TARGET_ABILITY,true)
        call SetUnitX(LoadUnitHandle(h, id, CasterHash), GetUnitX(LoadUnitHandle(h, id, TargetHash)) + 150 * Cos(angle))
        call SetUnitY(LoadUnitHandle(h, id, CasterHash), GetUnitY(LoadUnitHandle(h, id, TargetHash)) + 150 * Sin(angle))
        call SetUnitFacing(LoadUnitHandle(h, id, CasterHash), angle * bj_RADTODEG + 180)
    else
        call PauseUnit(LoadUnitHandle(h, id, CasterHash), false)
        call SetUnitInvulnerable(LoadUnitHandle(h, id, CasterHash), false)
        call PauseUnit(LoadUnitHandle(h, id, TargetHash), false)
        call SaveBoolean(HH,GetHandleId(LoadUnitHandle(h, id, TargetHash)),TARGET_ABILITY,false)
        call Minato_BaseRasengan(LoadUnitHandle(h, id, CasterHash) , LoadUnitHandle(h, id, TargetHash) , 1.5 * GetHeroAgi(LoadUnitHandle(h, id, CasterHash), true) , 120 , 1200 , CreateTimer())
        //call UnitRemoveAbility(LoadUnitHandle(h, id, CasterHash), 'MiQ3') Интегрировал внутрь Minato_BaseRasengan
        call RemoveSavedHandle(h, GetHandleId(LoadUnitHandle(h, id, CasterHash)), SH_MinatoQ_Target)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
endfunction

function MinatoQ3_Cast takes unit newCaster,unit newTarget,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local integer id_caster= GetHandleId(newCaster)
    local real angle=0.0
    set newTarget=LoadUnitHandle(h, id_caster, SH_MinatoQ3_Target)
    if LoadBoolean(HH,GetHandleId(newTarget),ANTITARGET_ABILITY)==false then
        set angle=AU(newCaster , newTarget)
        
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM08', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM09', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM08', GetUnitX(newTarget) + 150 * Cos(angle), GetUnitY(newTarget) + 150 * Sin(angle), GetRandomInt(0, 360))
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM09', GetUnitX(newTarget) + 150 * Cos(angle), GetUnitY(newTarget) + 150 * Sin(angle), GetRandomInt(0, 360))
        call MyRemoveUnit(bjLCU , 1.5)
        
        set soundplay=SndN(3392) // Sound\war3mapImported\Minato_Hiraishin_Sound.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        
        call ShakeCamera(0.1 , 5)
        call SetUnitX(newCaster, GetUnitX(newTarget) + 150 * Cos(angle))
        call SetUnitY(newCaster, GetUnitY(newTarget) + 150 * Sin(angle))
        call SetUnitFacingInstant(newCaster , angle * bj_RADTODEG + 180)
        call PauseUnit(newCaster, true)
        call SetUnitInvulnerable(newCaster, true)
        call PauseUnit(newTarget,true)
        call SaveBoolean(HH,GetHandleId(newTarget),TARGET_ABILITY,true)
        if LoadBoolean(h, GetHandleId(newCaster), SH_MinatoR_Mod) then
            call SetUnitAnimationByIndex(newCaster, 17)
        else
            call SetUnitAnimationByIndex(newCaster, 6)
        endif
        call UnitRemoveAbility(newTarget, 'MiDp')
        call SaveUnitHandle(h, id, CasterHash, newCaster)
        call SaveUnitHandle(h, id, TargetHash, newTarget)
        call SaveReal(h, id, AngleHash, angle)
        call TimerStart(newTimer, 0.01, true, function MinatoQ3_Periodic)
    else
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM08', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM09', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM08', GetUnitX(newTarget) + 150 * Cos(angle), GetUnitY(newTarget) + 150 * Sin(angle), GetRandomInt(0, 360))
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM09', GetUnitX(newTarget) + 150 * Cos(angle), GetUnitY(newTarget) + 150 * Sin(angle), GetRandomInt(0, 360))
        call MyRemoveUnit(bjLCU , 1.5)
        
        set soundplay=SndN(3392) // Sound\war3mapImported\Minato_Hiraishin_Sound.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        call MinatoRemoveRasengan(newCaster)
        call SetUnitX(newCaster, GetUnitX(newTarget) + 150 * Cos(angle))
        call SetUnitY(newCaster, GetUnitY(newTarget) + 150 * Sin(angle))
        call SetUnitFacingInstant(newCaster , angle * bj_RADTODEG + 180)
        call SaveUnitHandle(HH,GetHandleId(newTarget),REVERSE_TARGET,newCaster)
        call DestroyTimer(newTimer)
    endif
endfunction

function MinatoQWQ_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local unit caster= LoadUnitHandle(h, id, CasterHash)
    local real angle= LoadReal(h, id, AngleHash)
    local real distance= LoadReal(h, id, SH_Distance)
    local real time= LoadReal(h, id, TIME_HASH)
    local integer act= LoadInteger(h, id, SH_Act)
    if act < 3 then
        if act == 0 then
            call SaveReal(h, id, TIME_HASH, time + 0.01)
            if time > 0.05 then
                if distance > 0 then
                    call SetUnitX(caster, GetUnitX(caster) + 20 * Cos(angle))
                    call SetUnitY(caster, GetUnitY(caster) + 20 * Sin(angle))
                    call SetUnitX(LoadUnitHandle(h, id, Dummy1Hash), GetUnitX(caster) + 225 * Cos(angle))
                    call SetUnitY(LoadUnitHandle(h, id, Dummy1Hash), GetUnitY(caster) + 225 * Sin(angle))
                    call SetUnitX(LoadUnitHandle(h, id, Dummy2Hash), GetUnitX(caster) + 115 * Cos(angle))
                    call SetUnitY(LoadUnitHandle(h, id, Dummy2Hash), GetUnitY(caster) + 115 * Sin(angle))
                    call SetUnitFacing(caster, angle * bj_RADTODEG)
                    call SaveReal(h, id, SH_Distance, distance - 20)
                    set bjLCG=LoadGroupHandle(h, id, GroupHash)
                    call GroupEnumUnitsInRange(bjLCG, GetUnitX(caster) + 225 * Cos(angle), GetUnitY(caster) + 225 * Sin(angle), 225, Base)
                    loop
                    set E=FirstOfGroup(bjLCG)
                    exitwhen E == null
                        if Condition_Base(GetOwningPlayer(caster) , E) then
                            if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
                                call SetUnitX(E, GetUnitX(LoadUnitHandle(h, id, Dummy1Hash)))
                                call SetUnitY(E, GetUnitY(LoadUnitHandle(h, id, Dummy1Hash)))
                                call SaveBoolean(h, id, SH_NextAct, true)
                                call IssueImmediateOrder(E, "stop")
                                call SetControlToUnit(caster , E , 0.2 , "stun")
                            else
                                call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,LoadUnitHandle(h, id, CasterHash))
                                call SaveReal(h, id, SH_Distance, 0)
                                call MinatoRemoveRasengan(LoadUnitHandle(h, id, CasterHash))
                                call SaveInteger(h, id, SH_Act, 4)
                            endif
                        endif
                    call GroupRemoveUnit(bjLCG, E)
                    endloop
                    if LoadInteger(h, id, EffectPeriodHash) == 0 then
                        set n=CreateUnit(GetOwningPlayer(caster), 'dM11', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
                        call SetUnitFlyHeight(n, 150, 0)
                        call SetUnitVertexColor(n, 255, 255, 255, 140)
                        call SetUnitScale(n, 0.85, 0.85, 0.85)
                        call MyRemoveUnit(n , 1.5)
                        set n=CreateUnit(GetOwningPlayer(caster), 'dM29', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
                        call SetUnitVertexColor(n, 255, 255, 255, 180)
                        call SetUnitScale(n, 0.9, 0.9, 0.9)
                        call MyRemoveUnit(n , 1.5)
                        call SaveInteger(h, id, EffectPeriodHash, 17)
                    else
                        call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash) - 1)
                    endif
                else
                    call MinatoRemoveRasengan(caster)
                    if LoadBoolean(h, id, SH_NextAct) then
                        call SaveInteger(h, id, SH_Act, 1)
                        call SaveReal(h, id, TIME_HASH, 0.0)
                        call SaveReal(h, id, SH_Distance, .0)
                        set n=CreateUnit(GetOwningPlayer(caster), 'dM04', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
                        call SetUnitFlyHeight(n, 150, 0)
                        call SetUnitTimeScale(n, 0.6)
                        call SetUnitVertexColor(n, 255, 255, 255, 185)
                        call SetUnitScale(n, 2, 2, 2)
                        call MyRemoveUnit(n , 2.5)
                        set n=CreateUnit(GetOwningPlayer(caster), 'dM13', GetUnitX(caster) + 200 * Cos(angle), GetUnitY(caster) + 200 * Sin(angle), GetRandomInt(0, 360))
                        call SetUnitScale(n, 3, 3, 3)
                        //call SetUnitTimeScale(n, 0.50)
                        call SetUnitFlyHeight(n, 200, 0)
                        call SetUnitAnimation(n, "Birth")
                                                call UnitApplyTimedLife(n,'BTLF', 0.3)
                        call MyRemoveUnit(n , 0.3)
                        set n=CreateUnit(GetOwningPlayer(caster), 'dM13', GetUnitX(caster) + 200 * Cos(angle), GetUnitY(caster) + 200 * Sin(angle), GetRandomInt(0, 360))
                        call SetUnitScale(n, 5, 5, 5)
                        //call SetUnitTimeScale(n, 0.50)
                        call SetUnitFlyHeight(n, 200, 0)
                        call SetUnitAnimation(n, "Birth")
                                                call UnitApplyTimedLife(n,'BTLF', 0.3)
                        call MyRemoveUnit(n , 0.3)
                        set n=CreateUnit(GetOwningPlayer(caster), 'dM16', GetUnitX(caster) + 200 * Cos(angle), GetUnitY(caster) + 200 * Sin(angle), angle * bj_RADTODEG)
                        call SetUnitScale(n, 1.5, 1.5, 1.5)
                        call SetUnitFlyHeight(n, 150, 0)
                        call SetUnitTimeScale(n, 0.5)
                        call MyRemoveUnit(n , 1.5)
                        set n=CreateUnit(GetOwningPlayer(caster), 'dM17', GetUnitX(caster) + 200 * Cos(angle), GetUnitY(caster) + 200 * Sin(angle), GetRandomInt(0, 360))
                        call SetUnitScale(n, 5, 5, 5)
                        call SetUnitFlyHeight(n, 120, 0)
                        call SetUnitTimeScale(n, 0.65)
                        call MyRemoveUnit(n , 3.0)
                        set n=CreateUnit(GetOwningPlayer(caster), 'dM18', GetUnitX(caster) + 170 * Cos(angle), GetUnitY(caster) + 170 * Sin(angle), angle * bj_RADTODEG)
                        call SetUnitScale(n, 1.2, 1.2, 1.2)
                        call SetUnitFlyHeight(n, 120, 0)
                        call SetUnitTimeScale(n, 0.6)
                        call MyRemoveUnit(n , 3.0)
                        set n=CreateUnit(GetOwningPlayer(caster), 'dM18', GetUnitX(caster) + 170 * Cos(angle), GetUnitY(caster) + 170 * Sin(angle), angle * bj_RADTODEG)
                        call SetUnitScale(n, 1.2, 1.2, 1.2)
                        call SetUnitFlyHeight(n, 120, 0)
                        call SetUnitTimeScale(n, 0.6)
                        call MyRemoveUnit(n , 3.0)
                    else
                        call SaveInteger(h, id, SH_Act, 3)
                    endif
                endif
            endif
        elseif act == 1 then
            call SaveReal(h, id, TIME_HASH, time + 0.01)
            if time > 0.25 then
                call SaveInteger(h, id, SH_Act, 2)
                call SaveReal(h, id, TIME_HASH, 0.0)
                call SaveReal(h, id, SH_Distance, .0)
            endif
        elseif act == 2 then
            if distance < 1500 then
                if IsTerrainPathable(GetUnitX(LoadUnitHandle(h, id, Dummy1Hash)) + 20 * Cos(angle), GetUnitY(LoadUnitHandle(h, id, Dummy1Hash)) + 20 * Sin(angle), PATHING_TYPE_FLYABILITY)==false then
                    call SetUnitX(LoadUnitHandle(h, id, Dummy1Hash), GetUnitX(LoadUnitHandle(h, id, Dummy1Hash)) + 20 * Cos(angle))
                    call SetUnitY(LoadUnitHandle(h, id, Dummy1Hash), GetUnitY(LoadUnitHandle(h, id, Dummy1Hash)) + 20 * Sin(angle))
                    call SetUnitX(LoadUnitHandle(h, id, Dummy2Hash), GetUnitX(LoadUnitHandle(h, id, Dummy2Hash)) + 20 * Cos(angle))
                    call SetUnitY(LoadUnitHandle(h, id, Dummy2Hash), GetUnitY(LoadUnitHandle(h, id, Dummy2Hash)) + 20 * Sin(angle))
                endif
                call SaveReal(h, id, SH_Distance, distance + 20)
                set bjLCG=LoadGroupHandle(h, id, GroupHash)
                call GroupEnumUnitsInRange(bjLCG, GetUnitX(LoadUnitHandle(h, id, Dummy1Hash)), GetUnitY(LoadUnitHandle(h, id, Dummy1Hash)), 225, Base)
                loop
                set E=FirstOfGroup(bjLCG)
                exitwhen E == null
                    if Condition_Base(GetOwningPlayer(caster) , E) then
                        call SetUnitX(E, GetUnitX(LoadUnitHandle(h, id, Dummy1Hash)))
                        call SetUnitY(E, GetUnitY(LoadUnitHandle(h, id, Dummy1Hash)))
                        call IssueImmediateOrder(E, "stop")
                        call SetControlToUnit(caster , E , 0.2 , "stun")
                    endif
                call GroupRemoveUnit(bjLCG, E)
                endloop
            else
                set n=CreateUnit(GetOwningPlayer(caster), 'dM17', GetUnitX(LoadUnitHandle(h, id, Dummy1Hash)), GetUnitY(LoadUnitHandle(h, id, Dummy1Hash)), GetRandomInt(0, 360))
                call SetUnitScale(n, 9, 9, 9)
                call SetUnitFlyHeight(n, 100, 0)
                call SetUnitTimeScale(n, 0.65)
                call MyRemoveUnit(n , 3.0)
                set n=CreateUnit(GetOwningPlayer(caster), 'dM17', GetUnitX(LoadUnitHandle(h, id, Dummy1Hash)), GetUnitY(LoadUnitHandle(h, id, Dummy1Hash)), GetRandomInt(0, 360))
                call SetUnitScale(n, 9, 9, 9)
                call SetUnitFlyHeight(n, 100, 0)
                call SetUnitTimeScale(n, 0.65)
                call MyRemoveUnit(n , 3.0)
                set n=CreateUnit(GetOwningPlayer(caster), 'dM34', GetUnitX(LoadUnitHandle(h, id, Dummy1Hash)), GetUnitY(LoadUnitHandle(h, id, Dummy1Hash)), GetRandomInt(0, 360))
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call KillUnit(n)
                call MyRemoveUnit(n , 2.5)
                
                
                set n=CreateUnit(GetOwningPlayer(caster), 'dM25', GetUnitX(LoadUnitHandle(h, id, Dummy1Hash)), GetUnitY(LoadUnitHandle(h, id, Dummy1Hash)), GetRandomInt(0, 360))
                call SetUnitScale(n, 3, 3, 3)
                call SetUnitTimeScale(n, 1.2)
                call SetUnitVertexColor(n, 255, 255, 255, 170)
                call MyRemoveUnit(n , 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'dM25', GetUnitX(LoadUnitHandle(h, id, Dummy1Hash)), GetUnitY(LoadUnitHandle(h, id, Dummy1Hash)), GetRandomInt(0, 360))
                call SetUnitScale(n, 3, 3, 3)
                call SetUnitTimeScale(n, 1.0)
                call SetUnitVertexColor(n, 255, 255, 255, 170)
                call MyRemoveUnit(n , 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'dM25', GetUnitX(LoadUnitHandle(h, id, Dummy1Hash)), GetUnitY(LoadUnitHandle(h, id, Dummy1Hash)), GetRandomInt(0, 360))
                call SetUnitScale(n, 3, 3, 3)
                call SetUnitTimeScale(n, 0.8)
                call SetUnitVertexColor(n, 255, 255, 255, 170)
                call MyRemoveUnit(n , 1.5)
                call ShakeCamera(0.3 , 10)
                call SaveInteger(h, id, SH_Act, 3)
                set bjLCG=LoadGroupHandle(h, id, GroupHash)
                call GroupEnumUnitsInRange(bjLCG, GetUnitX(LoadUnitHandle(h, id, Dummy1Hash)), GetUnitY(LoadUnitHandle(h, id, Dummy1Hash)), 350, Base)
                loop
                set E=FirstOfGroup(bjLCG)
                exitwhen E == null
                    if Condition_Base(GetOwningPlayer(caster) , E) then
                        if SquareRootUnit(LoadUnitHandle(h, id, Dummy1Hash) , E) < 75 then
                            call SetUnitX(E, GetUnitX(LoadUnitHandle(h, id, Dummy1Hash)) + GetRandomInt(- 100, 100))
                            call SetUnitY(E, GetUnitY(LoadUnitHandle(h, id, Dummy1Hash)) + GetRandomInt(- 100, 100))
                        endif
                        call myCustomDamage(caster , E , LoadReal(h, id, SH_Damage) , false , false , null , null , null)
                        call SetControlToUnit(E , E , 1.0 , "stun")
                    endif
                call GroupRemoveUnit(bjLCG, E)
                endloop
            endif
        endif
    else
        call KillUnit(LoadUnitHandle(h, id, Dummy1Hash))
        call KillUnit(LoadUnitHandle(h, id, Dummy2Hash))
        call RemoveUnit(LoadUnitHandle(h, id, Dummy1Hash))
        call RemoveUnit(LoadUnitHandle(h, id, Dummy2Hash))
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call DestroyGroup(LoadGroupHandle(h, id, GroupHash))
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
endfunction

function MinatoQWQ_Cast takes unit newCaster,real angle,real distance,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local integer id_caster= GetHandleId(newCaster)
    local real damage= GetHeroAgi(newCaster, true) * ( 1.5 + 0.5 * GetUnitAbilityLevel(newCaster, 'MiQ1') ) + LoadReal(h, id_caster, SH_MinatoW_Damage)
    
    set soundplay=SndN(3395) // Sound\war3mapImported\Minato_WQQ.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM08', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    call MyRemoveUnit(n , 1.5)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM09', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    call MyRemoveUnit(n , 1.5)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM08', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    call MyRemoveUnit(n , 1.5)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM09', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    call MyRemoveUnit(n , 1.5)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM11', GetUnitX(newCaster), GetUnitY(newCaster), angle * bj_RADTODEG)
    call SetUnitFlyHeight(n, 150, 0)
    call MyRemoveUnit(n , 1.5)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM17', GetUnitX(newCaster) + 200 * Cos(angle), GetUnitY(newCaster) + 200 * Sin(angle), GetRandomInt(0, 360))
    call SetUnitScale(n, 5, 5, 5)
    call SetUnitFlyHeight(n, 120, 0)
    call SetUnitTimeScale(n, 0.65)
    call MyRemoveUnit(n , 3.0)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM18', GetUnitX(newCaster) + 170 * Cos(angle), GetUnitY(newCaster) + 170 * Sin(angle), angle * bj_RADTODEG)
    call SetUnitScale(n, 1.2, 1.2, 1.2)
    call SetUnitFlyHeight(n, 120, 0)
    call SetUnitTimeScale(n, 0.6)
    call MyRemoveUnit(n , 3.0)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM18', GetUnitX(newCaster) + 170 * Cos(angle), GetUnitY(newCaster) + 170 * Sin(angle), angle * bj_RADTODEG)
    call SetUnitScale(n, 1.2, 1.2, 1.2)
    call SetUnitFlyHeight(n, 120, 0)
    call SetUnitTimeScale(n, 0.6)
    call MyRemoveUnit(n , 3.0)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM13', GetUnitX(newCaster) + 200 * Cos(angle), GetUnitY(newCaster) + 200 * Sin(angle), angle * bj_RADTODEG)
    call SetUnitScale(n, 12, 12, 12)
    call SetUnitFlyHeight(n, 130, 0)
    call SetUnitAnimation(n, "stand")
    call SaveUnitHandle(h, id, Dummy1Hash, n)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM33', GetUnitX(newCaster) + 200 * Cos(angle), GetUnitY(newCaster) + 200 * Sin(angle), angle * bj_RADTODEG)
    call SetUnitScale(n, 1.3, 1.3, 1.3)
    call SetUnitFlyHeight(n, 130, 0)
    call SaveUnitHandle(h, id, Dummy2Hash, n)
    call ShakeCamera(0.1 , 5)
    call SetUnitFacing(newCaster, angle * bj_RADTODEG)
    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
    if LoadBoolean(h, GetHandleId(newCaster), SH_MinatoR_Mod) then
        call SetUnitAnimationByIndex(newCaster, 17)
    else
        call SetUnitAnimationByIndex(newCaster, 6)
    endif
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call SaveReal(h, id, AngleHash, angle)
    call SaveReal(h, id, SH_Distance, 650)
    call SaveReal(h, id, SH_Damage, damage)
    call SaveGroupHandle(h, id, GroupHash, CreateGroup())
    call TimerStart(newTimer, 0.01, true, function MinatoQWQ_Periodic)
endfunction

function MinatoRQWQ_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local integer act=LoadInteger(h, id, SH_Act)
    local real time=LoadReal(h, id, TIME_HASH)
    local real point_x=LoadReal(h, id, SH_Point_X)
    local real point_y=LoadReal(h, id, SH_Point_Y)
    local real angle=0.0
    local unit caster=LoadUnitHandle(h, id, CasterHash)
    if act < 3 then
        call SaveReal(h, id, TIME_HASH, time + 0.05)
        if act == 0 then
            if time == 0.00 then
                call SetUnitFlyHeight(caster, 500, 0)
                set angle=AtanPoint(GetUnitX(caster) , GetUnitY(caster) , point_x , point_y)
                set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dM08', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
                call MyRemoveUnit(bjLCU , 1.5)
                set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dM09', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
                call MyRemoveUnit(bjLCU , 1.5)
                call SetUnitX(LoadUnitHandle(h, id, CasterHash), point_x)
                call SetUnitY(LoadUnitHandle(h, id, CasterHash), point_y)
                set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dM08', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
                call SetUnitFlyHeight(bjLCU, 650, 0)
                call MyRemoveUnit(bjLCU , 1.5)
                set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dM09', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
                call SetUnitFlyHeight(bjLCU, 650, 0)
                call MyRemoveUnit(bjLCU , 1.5)
            elseif time == 0.45 then
                call DestroyEffect(LoadEffectHandle(h, id, Effect1Hash))
                call DestroyEffect(LoadEffectHandle(h, id, Effect2Hash))
                if LoadBoolean(h, GetHandleId(caster), SH_MinatoR_Mod) then
                    call SetUnitAnimationByIndex(LoadUnitHandle(h, id, CasterHash), 22)
                else
                    call SetUnitAnimationByIndex(LoadUnitHandle(h, id, CasterHash), 23)
                endif
                call MinatoRemoveRasengan(LoadUnitHandle(h, id, CasterHash))
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM13', point_x, point_y, GetRandomInt(0, 360))
                call SetUnitScale(bjLCU, 3, 3, 3)
                call SetUnitTimeScale(bjLCU, 0.50)
                call SetUnitFlyHeight(bjLCU, 300, 0)
                call SetUnitAnimation(bjLCU, "Birth")
                call UnitApplyTimedLife(bjLCU, 'BTLF', 0.5)
                call MyRemoveUnit(bjLCU , 0.5)
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM13', point_x, point_y, GetRandomInt(0, 360))
                call SetUnitScale(bjLCU, 5, 5, 5)
                call SetUnitTimeScale(bjLCU, 0.50)
                call SetUnitFlyHeight(bjLCU, 300, 0)
                call SetUnitAnimation(bjLCU, "Birth")
                call UnitApplyTimedLife(bjLCU, 'BTLF', 0.5)
                call MyRemoveUnit(bjLCU , 0.5)
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM16', point_x, point_y, GetRandomInt(0, 360))
                call SetUnitScale(bjLCU, 2, 2, 2)
                call SetUnitTimeScale(bjLCU, 0.5)
                call MyRemoveUnit(bjLCU , 1.5)
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM17', point_x, point_y, GetRandomInt(0, 360))
                call SetUnitScale(bjLCU, 10, 10, 10)
                call SetUnitTimeScale(bjLCU, 0.65)
                call MyRemoveUnit(bjLCU , 1.5)
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM24', point_x, point_y, 75)
                call SetUnitTimeScale(bjLCU, 0.8)
                call SetUnitFlyHeight(bjLCU, 30, 0)
                call MyRemoveUnit(bjLCU , 1.5)
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM24', point_x, point_y, 75)
                call SetUnitTimeScale(bjLCU, 0.8)
                call SetUnitFlyHeight(bjLCU, 30, 0)
                call MyRemoveUnit(bjLCU , 1.5)
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM26', point_x, point_y, GetRandomInt(0, 360))
                call SetUnitScale(bjLCU, 2, 2, 2)
                call SetUnitTimeScale(bjLCU, 0.8)
                call SetUnitFlyHeight(bjLCU, 10, 0)
                call MyRemoveUnit(bjLCU , 1.5)
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM13', point_x, point_y, GetRandomInt(0, 360))
                call SetUnitScale(bjLCU, 25, 25, 25)
                call SetUnitTimeScale(bjLCU, 1.5)
                call SetUnitFlyHeight(bjLCU, 80, 0)
                call SaveUnitHandle(h, id, SH_EffectDummy1, bjLCU)
                
                call ShakeCamera(0.3 , 15)
                call SaveReal(h, id, TIME_HASH, 0)
                call SaveInteger(h, id, SH_Act, 1)
            endif
        elseif act == 1 then
            if time == 0.05 then
                set angle=0.0
                loop
                exitwhen angle == 360 * bj_DEGTORAD
                    set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM40', point_x + 330 * Cos(angle), point_y + 330 * Sin(angle), angle * bj_RADTODEG + 180)
                    call SetUnitScale(n, 1.5, 1.5, 1.5)
                    //call SetUnitTimeScale(n, 0.8)
                    call SetUnitVertexColor(n, 255, 255, 255, 180)
                    call MyRemoveUnit(n , 1.5)
                set angle=angle + 30 * bj_DEGTORAD
                endloop
                set soundplay=SndN(768) // Sound\war3mapImported\Minato_Rasengan_Hit.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM25', point_x, point_y, GetRandomInt(0, 360))
                call SetUnitScale(bjLCU, 2.8, 2.8, 2.8)
                call SetUnitTimeScale(bjLCU, 1.2)
                call SetUnitVertexColor(bjLCU, 255, 255, 255, 200)
                call MyRemoveUnit(bjLCU , 1.5)
            
                set bjLCG=LoadGroupHandle(h, id, GroupHash)
                call GroupEnumUnitsInRange(bjLCG, point_x, point_y, 400, Base)
                loop
                set E=FirstOfGroup(bjLCG)
                exitwhen E == null
                    if Condition_Base(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)) , E) then
                        call myCustomDamage(LoadUnitHandle(h, id, CasterHash) , E , LoadReal(h, id, SH_Damage)*1.2 , false , false , null , null , null)
                        call SetControlToUnit(LoadUnitHandle(h, id, CasterHash) , E , 1 , "stun")
                    endif
                    call GroupRemoveUnit(bjLCG, E)
                endloop
            endif
            if time == 0.5 then
                call SaveEffectHandle(h, id, Effect1Hash, AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Rejuvenation\\RejuvenationTarget.mdl", LoadUnitHandle(h, id, CasterHash), "chest"))
                call SaveEffectHandle(h, id, Effect2Hash, AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Rejuvenation\\RejuvenationTarget.mdl", LoadUnitHandle(h, id, CasterHash), "hand right"))
                call MyRemoveUnit(LoadUnitHandle(h, id, SH_EffectDummy1) , 0.7)
                if LoadBoolean(h, GetHandleId(LoadUnitHandle(h, id, CasterHash)), SH_MinatoR_Mod) then
                    call SetUnitAnimationByIndex(LoadUnitHandle(h, id, CasterHash), 25)
                else
                    call SetUnitAnimationByIndex(LoadUnitHandle(h, id, CasterHash), 24)
                endif
                call SaveReal(h, id, TIME_HASH, 0)
                call SaveInteger(h, id, SH_Act, 2)
            endif
        elseif act == 2 then
            if time == 0.35 then
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM08', GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)), GetRandomInt(0, 360))
                call SetUnitFlyHeight(bjLCU, 650, 0)
                call MyRemoveUnit(bjLCU , 1.5)
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM09', GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)), GetRandomInt(0, 360))
                call SetUnitFlyHeight(bjLCU, 650, 0)
                call MyRemoveUnit(bjLCU , 1.5)
                call SaveInteger(h, id, SH_Act, 3)
            endif
        endif
    else
        set bjLCU=LoadUnitHandle(h, id, DummyHash)
        call SetUnitFlyHeight(LoadUnitHandle(h, id, CasterHash), 0, 0)
        call SetUnitX(LoadUnitHandle(h, id, CasterHash), GetUnitX(bjLCU))
        call SetUnitY(LoadUnitHandle(h, id, CasterHash), GetUnitY(bjLCU))
        call RemoveUnit(bjLCU)
        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dM08', GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)), GetRandomInt(0, 360))
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dM09', GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)), GetRandomInt(0, 360))
        call MyRemoveUnit(bjLCU , 1.5)
        call DestroyGroup(LoadGroupHandle(h, id, GroupHash))
        call DestroyEffect(LoadEffectHandle(h, id, Effect1Hash))
        call DestroyEffect(LoadEffectHandle(h, id, Effect2Hash))
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
endfunction


function MinatoRQWQ_Cast takes unit newCaster,real angle,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local integer id_caster= GetHandleId(newCaster)
    local boolean MinatoR_Mod= LoadBoolean(h, id_caster, SH_MinatoR_Mod)
    local real damage= ( 1.5 + 0.5 * GetUnitAbilityLevel(newCaster, 'MiQ4') ) * GetHeroAgi(newCaster, true)
    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
    call UnitAddAbility(newCaster, 'Arav')
    call UnitRemoveAbility(newCaster, 'Arav')
    
    
    if MinatoR_Mod then
        call SetUnitAnimationByIndex(newCaster, 18)
    else
        call SetUnitAnimationByIndex(newCaster, 7)
    endif
    call SaveEffectHandle(h, id, Effect1Hash, AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Rejuvenation\\RejuvenationTarget.mdl", newCaster, "chest"))
    call SaveEffectHandle(h, id, Effect2Hash, AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Rejuvenation\\RejuvenationTarget.mdl", newCaster, "hand right"))
    
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM23', GetUnitX(newCaster) + 500 * Cos(angle), GetUnitY(newCaster) + 500 * Sin(angle), GetRandomInt(0, 360))
    call SetUnitFlyHeight(n, 100, 0)
    call MyRemoveUnit(n , 1.5)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM22', GetUnitX(newCaster) + 500 * Cos(angle), GetUnitY(newCaster) + 500 * Sin(angle), GetRandomInt(0, 360))
    call SaveUnitHandle(h, id, DummyHash, n)
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call SaveReal(h, id, SH_Point_X, GetUnitX(newCaster))
    call SaveReal(h, id, SH_Point_Y, GetUnitY(newCaster))
    call SaveReal(h, id, SH_Damage, damage + LoadReal(h, id_caster, SH_MinatoW_Damage))
    call SaveGroupHandle(h, id, GroupHash, CreateGroup())
    call TimerStart(newTimer, 0.05, true, function MinatoRQWQ_Periodic)
endfunction

function MinatoQ1_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local integer id_caster= GetHandleId(LoadUnitHandle(h, id, CasterHash))
    local real angle= LoadReal(h, id, AngleHash)
    local real distance= LoadReal(h, id, SH_Distance)
    local boolean MinatoR_Mod= LoadBoolean(h, id_caster, SH_MinatoR_Mod)
    set bjLCU=LoadUnitHandle(h, id, DummyHash)
    if distance < 2000 and UnitIsAlive(bjLCU) and LoadBoolean(h, id_caster, SH_MinatoQ_Blink) == false then
        call SetUnitX(bjLCU, GetUnitX(bjLCU) + 20 * Cos(angle))
        call SetUnitY(bjLCU, GetUnitY(bjLCU) + 20 * Sin(angle))
        call SaveReal(h, id, SH_Distance, distance + 20)
        if LoadInteger(h, id, EffectPeriodHash) == 0 then
            set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM11', GetUnitX(bjLCU), GetUnitY(bjLCU), angle * bj_RADTODEG)
            call SetUnitScale(n, 0.4, 0.4, 0.4)
            call SetUnitVertexColor(n, 255, 255, 255, 150)
            call SetUnitTimeScale(E, 0.5)
            call MyRemoveUnit(n , 1.5)
            call SaveInteger(h, id, EffectPeriodHash, 5)
        else
            call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash) - 1)
        endif
        set bjLCG=LoadGroupHandle(h, id, GroupHash)
        call GroupEnumUnitsInRange(bjLCG, GetUnitX(bjLCU), GetUnitY(bjLCU), 100, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E == null
            if Condition_Base(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)) , E) then
                call SetUnitX(bjLCU, GetUnitX(bjLCU) + 120 * Cos(angle))
                call SetUnitY(bjLCU, GetUnitY(bjLCU) + 120 * Sin(angle))
                call Push3(bjLCU , 75 , angle , 50 , "")
                call KillUnit(bjLCU)
                call DestroyEffect(AddSpecialEffectTarget("HeroBladeMasterpf_E1.mdl", E, "origin"))
                call myCustomDamage(LoadUnitHandle(h, id, CasterHash) , E , GetHeroAgi(LoadUnitHandle(h, id, CasterHash), true) * ( 1.5 + 0.5 * GetUnitAbilityLevel(LoadUnitHandle(h, id, CasterHash), 'MiQ1') ) , false , false , null , null , null)
                call SetControlToUnit(LoadUnitHandle(h, id, CasterHash) , E , 0.5 , "stun")
                call Push(E , 75 , angle , 50)
                call MinatoAddHiraishinSeal(E , CreateTimer())
                if GetUnitAbilityLevel(LoadUnitHandle(h, id, CasterHash), 'MiW1') >= 1 and GetUnitAbilityLevel(LoadUnitHandle(h, id, CasterHash), 'MiQ3') == 0  then
                    call UnitAddAbility(LoadUnitHandle(h, id, CasterHash), 'MiQ3')
                    if IsUnitPaused(LoadUnitHandle(h, id, CasterHash)) then
                        call PauseUnit(LoadUnitHandle(h, id, CasterHash), false)
                        if MinatoR_Mod then
                            call ShowAbility2( 'MiQ4' , false)
                            call MinatoRemoveSpellTimed(LoadUnitHandle(h, id, CasterHash) , 'MiQ3' , 'MiQ4' , 3 , CreateTimer())
                        else
                            call ShowAbility2( 'MiQ1' , false)
                            call MinatoRemoveSpellTimed(LoadUnitHandle(h, id, CasterHash) , 'MiQ3' , 'MiQ1' , 3 , CreateTimer())
                        endif
                        call PauseUnit(LoadUnitHandle(h, id, CasterHash), true)
                    else
                        if MinatoR_Mod then
                            call ShowAbility2( 'MiQ4' , false)
                            call MinatoRemoveSpellTimed(LoadUnitHandle(h, id, CasterHash) , 'MiQ3' , 'MiQ4' , 3 , CreateTimer())
                        else
                            call ShowAbility2( 'MiQ1' , false)
                            call MinatoRemoveSpellTimed(LoadUnitHandle(h, id, CasterHash) , 'MiQ3' , 'MiQ1' , 3 , CreateTimer())
                        endif
                    endif
                    call SaveUnitHandle(h, id_caster, SH_MinatoQ3_Target, E)
                endif
                set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM01', GetUnitX(E), GetUnitY(E), angle * bj_RADTODEG)
                call SetUnitTimeScale(n, 0.4)
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call SetUnitFlyHeight(n, 30, 0)
                call Push3(n , 75 , angle , 50 , "")
                call MyRemoveUnit(n , 1.5)
                call GroupClear(bjLCG)
                set soundplay=SndN(3397) // Sound\war3mapImported\MinatoQ_Hit.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            endif
        call GroupRemoveUnit(bjLCG, E)
        endloop
    else
        if LoadBoolean(h, id_caster, SH_MinatoQ_Blink) then
                        set soundplay=SndN(3392) // Sound\war3mapImported\Minato_Hiraishin_Sound.mp3
                        call StartSound(soundplay)
                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM08', GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)), GetRandomInt(0, 360))
            call MyRemoveUnit(n , 1.5)
            set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM09', GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)), GetRandomInt(0, 360))
            call MyRemoveUnit(n , 1.5)
            call GroupClear(bjLCG)
            call SetUnitX(LoadUnitHandle(h, id, CasterHash), GetUnitX(bjLCU))
            call SetUnitY(LoadUnitHandle(h, id, CasterHash), GetUnitY(bjLCU))
            call GroupClear(bjLCG)
            if GetUnitAbilityLevel(LoadUnitHandle(h, id, CasterHash), 'MiW1') >= 1 then
                if MinatoR_Mod then
                    call MinatoRQWQ_Cast(LoadUnitHandle(h, id, CasterHash) , angle , CreateTimer())
                else
                    set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM08', GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)), GetRandomInt(0, 360))
                    call MyRemoveUnit(n , 1.5)
                    set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM09', GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)), GetRandomInt(0, 360))
                    call MyRemoveUnit(n , 1.5)
                    call MinatoQWQ_Cast(LoadUnitHandle(h, id, CasterHash) , angle , 2000 - distance , CreateTimer())
                endif
            else
                set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM08', GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)), GetRandomInt(0, 360))
                call MyRemoveUnit(n , 1.5)
                set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM09', GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)), GetRandomInt(0, 360))
                call MyRemoveUnit(n , 1.5)
            endif
        endif
        if UnitIsAlive(bjLCU) then
            call KillUnit(bjLCU)
        endif
        if GetUnitAbilityLevel(LoadUnitHandle(h, id, CasterHash), 'MiQ3') == 0 then
            if MinatoR_Mod then
                call ShowAbility2( 'MiQ4' , true)
            else
                call ShowAbility2( 'MiQ1' , true)
            endif
        endif
        call RemoveSavedHandle(h, id_caster, SH_MinatoQ_Kunai)
        call MyRemoveUnit(bjLCU , 0.5)
        call UnitRemoveAbility(LoadUnitHandle(h, id, CasterHash), 'MiQ2')
        call SaveBoolean(h, id_caster, SH_MinatoQ_Blink, false)
        call DestroyGroup(LoadGroupHandle(h, id, GroupHash))
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
endfunction

function MinatoQ1_Cast takes unit newCaster,real point_x,real point_y,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local integer id_caster= GetHandleId(newCaster)
    local real caster_x= GetUnitX(newCaster)
    local real caster_y= GetUnitY(newCaster)
    local real angle= AtanPoint(caster_x , caster_y , point_x , point_y)
    local boolean MinatoR_Mod= LoadBoolean(h, id_caster, SH_MinatoR_Mod)
    
    set soundplay=SndN(3400) // Sound\war3mapImported\Minato_Kunai.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    if GetRandomInt(0, 1) == 0 then
        set soundplay=SndByPath("Sound\\war3mapImported\\MinatoQ_Voice" + I2S(GetRandomInt(1, 2)) + ".mp3")
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    endif
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM04', caster_x + 50 * Cos(angle), caster_y + 50 * Sin(angle), angle * bj_RADTODEG)
    call SetUnitTimeScale(bjLCU, 0.6)
    call SetUnitVertexColor(bjLCU, 255, 255, 255, 180)
    call MyRemoveUnit(bjLCU , 1.5)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM11', caster_x + 50 * Cos(angle), caster_y + 50 * Sin(angle), angle * bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 150, 0)
    call MyRemoveUnit(bjLCU , 1.5)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM12', caster_x + 50 * Cos(angle), caster_y + 50 * Sin(angle), angle * bj_RADTODEG)
    call MyRemoveUnit(bjLCU , 1.5)
    //set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM08', caster_x+50*Cos(angle), caster_y+50*Sin(angle), angle*bj_RADTODEG)
    //call MyRemoveUnit(bjLCU, 1.5)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM03', caster_x, caster_y, angle * bj_RADTODEG)
    call SaveUnitHandle(h, id, DummyHash, bjLCU)
    call SaveUnitHandle(h, id_caster, SH_MinatoQ_Kunai, bjLCU)
    if MinatoR_Mod then
        call ShowAbility2( 'MiQ4' , false)
    else
        call ShowAbility2( 'MiQ1' , false)
    endif
    if GetUnitAbilityLevel(LoadUnitHandle(h, id, CasterHash), 'MiQ3') == 0 then
        call UnitAddAbility(newCaster, 'MiQ2')
    endif
    call SaveBoolean(h, id_caster, SH_MinatoQ_Blink, false)
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call SaveGroupHandle(h, id, GroupHash, CreateGroup())
    call SaveReal(h, id, AngleHash, angle)
    call TimerStart(newTimer, 0.01, true, function MinatoQ1_Periodic)
endfunction


function MinatoQR_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local integer id_caster= GetHandleId(LoadUnitHandle(h, id, CasterHash))
    local real angle= LoadReal(h, id, AngleHash)
    local real distance= LoadReal(h, id, SH_Distance)
    set bjLCU=LoadUnitHandle(h, id, DummyHash)
    if distance < 2000 and UnitIsAlive(bjLCU) and LoadBoolean(h, id_caster, SH_MinatoQ_Blink) == false then
        call SetUnitX(bjLCU, GetUnitX(bjLCU) + 20 * Cos(angle))
        call SetUnitY(bjLCU, GetUnitY(bjLCU) + 20 * Sin(angle))
        call SaveReal(h, id, SH_Distance, distance + 20)
        if LoadInteger(h, id, EffectPeriodHash) == 0 then
            set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM11', GetUnitX(bjLCU), GetUnitY(bjLCU), angle * bj_RADTODEG)
            call SetUnitScale(n, 0.4, 0.4, 0.4)
            call SetUnitVertexColor(n, 255, 255, 255, 150)
            call SetUnitTimeScale(E, 0.5)
            call MyRemoveUnit(n , 1.5)
            call SaveInteger(h, id, EffectPeriodHash, 5)
        else
            call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash) - 1)
        endif
        set bjLCG=LoadGroupHandle(h, id, GroupHash)
        call GroupEnumUnitsInRange(bjLCG, GetUnitX(bjLCU), GetUnitY(bjLCU), 100, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E == null
            if Condition_Base(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)) , E) then
                call SetUnitX(bjLCU, GetUnitX(bjLCU) + 120 * Cos(angle))
                call SetUnitY(bjLCU, GetUnitY(bjLCU) + 120 * Sin(angle))
                call Push3(bjLCU , 75 , angle , 50 , "")
                call KillUnit(bjLCU)
                call DestroyEffect(AddSpecialEffectTarget("HeroBladeMasterpf_E1.mdl", E, "origin"))
                call myCustomDamage(LoadUnitHandle(h, id, CasterHash) , E , 50 + GetHeroAgi(LoadUnitHandle(h, id, CasterHash), true) * ( 0.5 + 0.5 * GetUnitAbilityLevel(LoadUnitHandle(h, id, CasterHash), 'MiQ1') ) , false , false , null , null , null)
                call SetControlToUnit(LoadUnitHandle(h, id, CasterHash) , E , 0.5 , "stun")
                call Push(E , 75 , angle , 50)
                call MinatoAddHiraishinSeal(E , CreateTimer())
                set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM01', GetUnitX(E), GetUnitY(E), angle * bj_RADTODEG)
                call SetUnitTimeScale(n, 0.4)
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call SetUnitFlyHeight(n, 30, 0)
                call Push3(n , 75 , angle , 50 , "")
                call MyRemoveUnit(n , 1.5)
                call GroupClear(bjLCG)
                set soundplay=SndN(3397) // Sound\war3mapImported\MinatoQ_Hit.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            endif
        call GroupRemoveUnit(bjLCG, E)
        endloop
    else
        if UnitIsAlive(bjLCU) then
            call KillUnit(bjLCU)
        endif
        call MyRemoveUnit(bjLCU , 0.5)
        call SaveBoolean(h, id_caster, SH_MinatoQ_Blink, false)
        call DestroyGroup(LoadGroupHandle(h, id, GroupHash))
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
endfunction

function MinatoQR_Single takes unit newCaster,real angle,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local integer id_caster= GetHandleId(newCaster)
    local real caster_x= GetUnitX(newCaster)
    local real caster_y= GetUnitY(newCaster)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM04', caster_x + 50 * Cos(angle), caster_y + 50 * Sin(angle), angle * bj_RADTODEG)
    call SetUnitTimeScale(bjLCU, 0.6)
    call SetUnitVertexColor(bjLCU, 255, 255, 255, 180)
    call MyRemoveUnit(bjLCU , 1.5)
    // set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM11', caster_x+50*Cos(angle), caster_y+50*Sin(angle), angle*bj_RADTODEG)
    // call SetUnitFlyHeight(bjLCU, 150, 0)
    // call SetUnitTimeScale(E, 0.5)
    // call MyRemoveUnit(bjLCU, 1.5)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM03', caster_x, caster_y, angle * bj_RADTODEG)
    call SaveUnitHandle(h, id, DummyHash, bjLCU)
    call SaveBoolean(h, id_caster, SH_MinatoQ_Blink, false)
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call SaveGroupHandle(h, id, GroupHash, CreateGroup())
    call SaveReal(h, id, AngleHash, angle)
    call TimerStart(newTimer, 0.01, true, function MinatoQR_Periodic)
endfunction

function MinatoQR_Cast takes unit newCaster,real point_x,real point_y returns nothing
    local real angle= AP(GetUnitX(newCaster) , GetUnitY(newCaster) , point_x , point_y)
    call MinatoQ1_Cast(newCaster , point_x , point_y , CreateTimer())
    call MinatoQR_Single(newCaster , angle + 20 * bj_DEGTORAD , CreateTimer())
    call MinatoQR_Single(newCaster , angle - 20 * bj_DEGTORAD , CreateTimer())
endfunction

function MinatoW_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
        local unit caster = LoadUnitHandle(h, id, 0)
    local integer id_caster= GetHandleId(caster)
    local real caster_x= GetUnitX(caster)
    local real caster_y= GetUnitY(caster)
    local real damage= LoadReal(h, id_caster, SH_MinatoW_Damage)
    local real damage_force= LoadReal(h, id, SH_Damage) * 0.25 * 0.05
        local real time = LoadReal(h, id, 1)+0.05
        
        call SaveReal(h, id, 1, time)
    call SaveReal(h, id_caster, SH_MinatoW_Damage, damage + damage_force)
        
    if time<2 and IsUnitPaused(caster)==false and GetUnitAbilityLevel(caster, 'MiW1')>0 then
        
        call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash) + 1)
        if LoadInteger(h, id, EffectPeriodHash) == 5 then
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dM05', caster_x, caster_y, GetRandomInt(0, 360))
            call SetUnitScale(bjLCU, 0.45, 0.45, 0.45)
            call SetUnitTimeScale(bjLCU, 0.75)
            call SetUnitVertexColor(bjLCU, 255, 255, 255, 130)
            call MyRemoveUnit(bjLCU , 1.5)
            call SaveInteger(h, id, EffectPeriodHash, 0)
        endif
                
    else
        
                if GetUnitAbilityLevel(caster , 'MiW1')>0 then
                        call MinatoRemoveSpellTimed(caster , 'MiW1' , 0 , 6 , CreateTimer())
                endif
        //call DisplayTimedTextToPlayer(Player(0), 0, 0, 3, "Scaled damage: " + R2S(damage + damage_force))
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
                
    endif
        set caster=null
endfunction

function MinatoW_Cast takes unit newCaster,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local integer id_caster= GetHandleId(newCaster)
    local real caster_x= GetUnitX(newCaster)
    local real caster_y= GetUnitY(newCaster)
    local real angle= GetUnitFacing(newCaster) * bj_DEGTORAD
    local real damage= 100 + GetHeroAgi(newCaster, true) * GetUnitAbilityLevel(newCaster, 'MinW')
    set soundplay=SndN(3406) // Sound\war3mapImported\Minato_Rasengan_Start.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM14', caster_x, caster_y, GetRandomInt(0, 360))
    call SetUnitScale(bjLCU, 2, 2, 2)
    call UnitApplyTimedLife(bjLCU, 'BTLF', 0.6)
    call MyRemoveUnit(bjLCU , 1.0)
    call UnitAddAbility(newCaster, 'MiW1')
    if LoadEffectHandle(h, id_caster, SH_MinatoW_Eff) != null then
        call DestroyEffect(LoadEffectHandle(h, id_caster, SH_MinatoW_Eff))
        call RemoveSavedHandle(h, id_caster, SH_MinatoW_Eff)
    endif
    call SaveEffectHandle(h, id_caster, SH_MinatoW_Eff, AddSpecialEffectTarget("RasenganImpact_W.mdx", newCaster, "hand right"))
    call SaveReal(h, id_caster, SH_MinatoW_Damage, damage)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveReal(h, id, SH_Damage_force, 0.0)
    call SaveReal(h, id, SH_Damage, damage)
    call SaveInteger(h, id, EffectPeriodHash, 3)
    call TimerStart(newTimer, 0.05, true, function MinatoW_Periodic)
endfunction


function MinatoE1_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local integer act=LoadInteger(h, id, SH_Act)
    local real time=LoadReal(h, id, TIME_HASH)
    local real angle=0.0
    if act < 3 then
        set angle=AU(LoadUnitHandle(h, id, CasterHash) , LoadUnitHandle(h, id, TargetHash))
        call SaveReal(h, id, TIME_HASH, time + 0.01)
        if act == 0 then
            call UnitAddAbility(LoadUnitHandle(h, id, TargetHash),'Pet1')
            call SetControlToUnit(LoadUnitHandle(h, id, CasterHash),LoadUnitHandle(h, id, TargetHash),0.32,"heavystun")
            if time == 0.35 then
                if LoadBoolean(h, GetHandleId(LoadUnitHandle(h, id, CasterHash)), SH_MinatoR_Mod) then
                    call SetUnitAnimationByIndex(LoadUnitHandle(h, id, CasterHash), 13)
                else
                    call SetUnitAnimationByIndex(LoadUnitHandle(h, id, CasterHash), 2)
                endif
            elseif time == 0.45 then
                call SaveInteger(h, id, SH_Act, 1)
                call UnitRemoveAbility(LoadUnitHandle(h, id, TargetHash),'Pet1')
                call SaveReal(h, id, TIME_HASH, 0.0)
            endif
        elseif act == 1 then
            if SquareRootUnit(LoadUnitHandle(h, id, CasterHash) , LoadUnitHandle(h, id, TargetHash)) > 60 then
                if LoadBoolean(h, GetHandleId(LoadUnitHandle(h, id, CasterHash)), SH_MinatoR_Mod) == false then
                    call SetUnitX(LoadUnitHandle(h, id, CasterHash), GetUnitX(LoadUnitHandle(h, id, CasterHash)) + 40 * Cos(angle))
                    call SetUnitY(LoadUnitHandle(h, id, CasterHash), GetUnitY(LoadUnitHandle(h, id, CasterHash)) + 40 * Sin(angle))
                    call SetUnitFacing(LoadUnitHandle(h, id, CasterHash), angle * bj_RADTODEG)
                else
                    call SaveReal(h, id, TIME_HASH, time + 0.01)
                    if time >= 0.1 then
                        call SetUnitFacing(LoadUnitHandle(h, id, CasterHash), angle * bj_RADTODEG)
                        call SaveInteger(h, id, SH_PeriodicAngle, LoadInteger(h, id, SH_PeriodicAngle) * ( - 1 ))
                        set angle=angle + ( 31 * LoadInteger(h, id, SH_PeriodicAngle) ) * bj_DEGTORAD
                        call SetUnitX(LoadUnitHandle(h, id, CasterHash), GetUnitX(LoadUnitHandle(h, id, CasterHash)) + 350 * Cos(angle))
                        call SetUnitY(LoadUnitHandle(h, id, CasterHash), GetUnitY(LoadUnitHandle(h, id, CasterHash)) + 350 * Sin(angle))
                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM08', GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)), GetRandomInt(0, 360))
                        call MyRemoveUnit(n , 1.5)
                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM09', GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)), GetRandomInt(0, 360))
                        call MyRemoveUnit(n , 1.5)
                        call SaveReal(h, id, TIME_HASH, 0.0)
                        if SquareRootUnit(LoadUnitHandle(h, id, CasterHash) , LoadUnitHandle(h, id, TargetHash)) < 220 then
                            set angle=AU(LoadUnitHandle(h, id, CasterHash) , LoadUnitHandle(h, id, TargetHash))
                            call SetUnitX(LoadUnitHandle(h, id, CasterHash), GetUnitX(LoadUnitHandle(h, id, TargetHash)) - 50 * Cos(angle))
                            call SetUnitY(LoadUnitHandle(h, id, CasterHash), GetUnitY(LoadUnitHandle(h, id, TargetHash)) - 50 * Sin(angle))
                        endif
                    endif
                endif
            else
                set soundplay=SndN(3408) // Sound\war3mapImported\MinatoE_Hit.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                call SaveInteger(h, id, SH_Act, 2)
                call SaveReal(h, id, TIME_HASH, 0.0)
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM21', GetUnitX(LoadUnitHandle(h, id, TargetHash)), GetUnitY(LoadUnitHandle(h, id, TargetHash)), GetRandomInt(0, 360))
                call SetUnitFlyHeight(bjLCU, 150, 0)
                call SetUnitTimeScale(bjLCU, 0.7)
                call Push3(bjLCU , 75 , angle , 50 , "")
                call MyRemoveUnit(bjLCU , 1.5)
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM01', GetUnitX(LoadUnitHandle(h, id, TargetHash)), GetUnitY(LoadUnitHandle(h, id, TargetHash)), GetRandomInt(0, 360))
                call SetUnitTimeScale(bjLCU, 0.4)
                call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
                call SetUnitFlyHeight(bjLCU, 30, 0)
                call Push3(bjLCU , 75 , angle , 50 , "")
                call MyRemoveUnit(bjLCU , 1.5)
                call DestroyEffect(AddSpecialEffectTarget("HeroBladeMasterpf_E1.mdl", LoadUnitHandle(h, id, TargetHash), "origin"))
                
                call ShakeCamera(0.1 , 10)
                call myCustomDamage(LoadUnitHandle(h, id, CasterHash) , LoadUnitHandle(h, id, TargetHash) , ( GetHeroAgi(LoadUnitHandle(h, id, CasterHash), true) * ( 1+GetUnitAbilityLevel(LoadUnitHandle(h, id, CasterHash), 'MiE1') ) ) / 2 , false , false , null , null , null)
                call SetControlToUnit(LoadUnitHandle(h, id, CasterHash) , LoadUnitHandle(h, id, TargetHash) , 1.0 , "stun")
                call Push(LoadUnitHandle(h, id, TargetHash) , 75 , angle , 50)
                call SaveReal(h, id, AngleHash, angle)
            endif
        elseif act == 2 then
            set angle=LoadReal(h, id, AngleHash)
            if time < 0.1 then
                call SetUnitX(LoadUnitHandle(h, id, CasterHash), GetUnitX(LoadUnitHandle(h, id, CasterHash)) + 40 * Cos(angle))
                call SetUnitY(LoadUnitHandle(h, id, CasterHash), GetUnitY(LoadUnitHandle(h, id, CasterHash)) + 40 * Sin(angle))
            else
                call SaveInteger(h, id, SH_Act, 3)
            endif
        endif
    else
        call DestroyEffect(LoadEffectHandle(h, id, Effect1Hash))
        call DestroyEffect(LoadEffectHandle(h, id, Effect2Hash))
        call PauseUnit(LoadUnitHandle(h, id, CasterHash), false)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
endfunction

function MinatoE2_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local integer act=LoadInteger(h, id, SH_Act)
        local unit caster=LoadUnitHandle(h, id, CasterHash)
    local real time=LoadReal(h, id, TIME_HASH)
    local real angle=0.0
    if act < 2 then
        if act == 0 then
            set angle=AU(caster , LoadUnitHandle(h, id, TargetHash))
            if SquareRootUnit(caster , LoadUnitHandle(h, id, TargetHash)) > 75.0 then
                if LoadBoolean(h, GetHandleId(caster), SH_MinatoR_Mod) == false then
                    call SetUnitX(caster, GetUnitX(caster) + 40 * Cos(angle))
                    call SetUnitY(caster, GetUnitY(caster) + 40 * Sin(angle))
                    call SetUnitFacing(caster, angle * bj_RADTODEG)
                else
                    call SaveReal(h, id, TIME_HASH, time + 0.01)
                    if time >= 0.1 then
                        call SetUnitFacing(caster, angle * bj_RADTODEG)
                        call SaveInteger(h, id, SH_PeriodicAngle, LoadInteger(h, id, SH_PeriodicAngle) * ( - 1 ))
                        set angle=angle + ( 36 * LoadInteger(h, id, SH_PeriodicAngle) ) * bj_DEGTORAD
                        call SetUnitX(caster, GetUnitX(caster) + 300 * Cos(angle))
                        call SetUnitY(caster, GetUnitY(caster) + 300 * Sin(angle))
                        set n=CreateUnit(GetOwningPlayer(caster), 'dM08', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
                        call MyRemoveUnit(n , 1.5)
                        set n=CreateUnit(GetOwningPlayer(caster), 'dM09', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
                        call MyRemoveUnit(n , 1.5)
                        call SaveReal(h, id, TIME_HASH, 0.0)
                        if SquareRootUnit(caster , LoadUnitHandle(h, id, TargetHash)) < 250 then
                            set angle=AU(caster , LoadUnitHandle(h, id, TargetHash))
                            call SetUnitX(caster, GetUnitX(LoadUnitHandle(h, id, TargetHash)) - 65 * Cos(angle))
                            call SetUnitY(caster, GetUnitY(LoadUnitHandle(h, id, TargetHash)) - 65 * Sin(angle))
                        endif
                    endif
                endif
            else
                set soundplay=SndN(3408) // Sound\war3mapImported\MinatoE_Hit.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                call SetUnitInvulnerable(caster, false)
                set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dM21', GetUnitX(LoadUnitHandle(h, id, TargetHash)), GetUnitY(LoadUnitHandle(h, id, TargetHash)), GetRandomInt(0, 360))
                call SetUnitFlyHeight(bjLCU, 150, 0)
                call SetUnitTimeScale(bjLCU, 0.7)
                call Push3(bjLCU , 75 , angle , 50 , "")
                call MyRemoveUnit(bjLCU , 1.5)
                set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dM01', GetUnitX(LoadUnitHandle(h, id, TargetHash)), GetUnitY(LoadUnitHandle(h, id, TargetHash)), GetRandomInt(0, 360))
                call SetUnitTimeScale(bjLCU, 0.4)
                call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
                call SetUnitFlyHeight(bjLCU, 30, 0)
                call Push3(bjLCU , 75 , angle , 50 , "")
                call MyRemoveUnit(bjLCU , 1.5)
                call DestroyEffect(AddSpecialEffectTarget("HeroBladeMasterpf_E1.mdl", LoadUnitHandle(h, id, TargetHash), "origin"))
                call ShakeCamera(0.1 , 10)
                call myCustomDamage(caster , LoadUnitHandle(h, id, TargetHash) , (50+GetHeroAgi(caster, true)*(0.5+0.5*GetUnitAbilityLevel(caster, 'MiQ1')))+(GetHeroAgi(caster, true)*(1+GetUnitAbilityLevel(caster, 'MiE1'))) , false , false , null , null , null)
                call SetControlToUnit(caster , LoadUnitHandle(h, id, TargetHash) , 1.0 , "stun")
                call MinatoAddHiraishinSeal25sec(LoadUnitHandle(h, id, TargetHash) , CreateTimer())
                call Push(LoadUnitHandle(h, id, TargetHash) , 75 , angle , 50)
                call SetUnitFacingInstant(caster , angle * bj_RADTODEG)
                call SaveReal(h, id, AngleHash, angle)
                call SaveReal(h, id, TIME_HASH, 0.0)
                call SaveInteger(h, id, SH_Act, 1)
            endif
        elseif act == 1 then
            set angle=LoadReal(h, id, AngleHash)
            call SaveReal(h, id, TIME_HASH, time + 0.01)
            if time < 0.10 then
                call SetUnitX(caster, GetUnitX(caster) + 40 * Cos(angle))
                call SetUnitY(caster, GetUnitY(caster) + 40 * Sin(angle))
            else
                call SaveInteger(h, id, SH_Act, 2)
            endif
        endif
    else
        call DestroyEffect(LoadEffectHandle(h, id, Effect1Hash))
        call DestroyEffect(LoadEffectHandle(h, id, Effect2Hash))
        call PauseUnit(LoadUnitHandle(h, id, CasterHash), false)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
        set caster=null
endfunction

function MinatoE3_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local integer act=LoadInteger(h, id, SH_Act)
    local real time=LoadReal(h, id, TIME_HASH)
    local real point_x=LoadReal(h, id, SH_Point_X)
    local real point_y=LoadReal(h, id, SH_Point_Y)
    local real angle=0.0
    if act < 3 then
        call SaveReal(h, id, TIME_HASH, time + 0.05)
        if act == 0 then
            if time == 0.00 then
                set soundplay=SndN(3411) // Sound\war3mapImported\Minato_WQElvl2.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                call SetUnitFlyHeight(LoadUnitHandle(h, id, CasterHash), 500, 0)
                set angle=AtanPoint(GetUnitX(LoadUnitHandle(h, id, CasterHash)) , GetUnitY(LoadUnitHandle(h, id, CasterHash)) , point_x , point_y)
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM08', GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)), GetRandomInt(0, 360))
                call MyRemoveUnit(bjLCU , 1.5)
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM09', GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)), GetRandomInt(0, 360))
                call MyRemoveUnit(bjLCU , 1.5)
                call SetUnitX(LoadUnitHandle(h, id, CasterHash), point_x)
                call SetUnitY(LoadUnitHandle(h, id, CasterHash), point_y)
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM08', GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)), GetRandomInt(0, 360))
                call SetUnitFlyHeight(bjLCU, 650, 0)
                call MyRemoveUnit(bjLCU , 1.5)
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM09', GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)), GetRandomInt(0, 360))
                call SetUnitFlyHeight(bjLCU, 650, 0)
                call MyRemoveUnit(bjLCU , 1.5)
            elseif time == 0.25 then
                call DestroyEffect(LoadEffectHandle(h, id, Effect1Hash))
                call DestroyEffect(LoadEffectHandle(h, id, Effect2Hash))
                if LoadBoolean(h, GetHandleId(LoadUnitHandle(h, id, CasterHash)), SH_MinatoR_Mod) then
                    call SetUnitAnimationByIndex(LoadUnitHandle(h, id, CasterHash), 22)
                else
                    call SetUnitAnimationByIndex(LoadUnitHandle(h, id, CasterHash), 23)
                endif
                call MinatoRemoveRasengan(LoadUnitHandle(h, id, CasterHash))
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM13', point_x, point_y, GetRandomInt(0, 360))
                call SetUnitScale(bjLCU, 3, 3, 3)
                call SetUnitTimeScale(bjLCU, 0.50)
                call SetUnitFlyHeight(bjLCU, 300, 0)
                call SetUnitAnimation(bjLCU, "Birth")
                                call UnitApplyTimedLife(bjLCU, 'BTLF', 0.5)
                call MyRemoveUnit(bjLCU , 0.5)
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM13', point_x, point_y, GetRandomInt(0, 360))
                call SetUnitScale(bjLCU, 5, 5, 5)
                call SetUnitTimeScale(bjLCU, 0.50)
                call SetUnitFlyHeight(bjLCU, 300, 0)
                call SetUnitAnimation(bjLCU, "Birth")
                                call UnitApplyTimedLife(bjLCU, 'BTLF', 0.5)
                call MyRemoveUnit(bjLCU , 0.5)
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM16', point_x, point_y, GetRandomInt(0, 360))
                call SetUnitScale(bjLCU, 2, 2, 2)
                call SetUnitTimeScale(bjLCU, 0.5)
                call MyRemoveUnit(bjLCU , 1.5)
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM17', point_x, point_y, GetRandomInt(0, 360))
                call SetUnitScale(bjLCU, 10, 10, 10)
                call SetUnitTimeScale(bjLCU, 0.65)
                call MyRemoveUnit(bjLCU , 1.5)
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM24', point_x, point_y, 75)
                call SetUnitTimeScale(bjLCU, 0.8)
                call SetUnitFlyHeight(bjLCU, 30, 0)
                call MyRemoveUnit(bjLCU , 1.5)
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM24', point_x, point_y, 75)
                call SetUnitTimeScale(bjLCU, 0.8)
                call SetUnitFlyHeight(bjLCU, 30, 0)
                call MyRemoveUnit(bjLCU , 1.5)
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM26', point_x, point_y, GetRandomInt(0, 360))
                call SetUnitScale(bjLCU, 2, 2, 2)
                call SetUnitTimeScale(bjLCU, 0.8)
                call SetUnitFlyHeight(bjLCU, 10, 0)
                call MyRemoveUnit(bjLCU , 1.5)
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM13', point_x, point_y, GetRandomInt(0, 360))
                call SetUnitScale(bjLCU, 25, 25, 25)
                call SetUnitTimeScale(bjLCU, 1.5)
                call SetUnitFlyHeight(bjLCU, 80, 0)
                call SaveUnitHandle(h, id, SH_EffectDummy1, bjLCU)
                
                call SaveReal(h, id, TIME_HASH, 0)
                call SaveInteger(h, id, SH_Act, 1)
            endif
        elseif act == 1 then
            if time == 0.1 then
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM27', point_x, point_y, GetRandomInt(0, 360))
                call SetUnitScale(bjLCU, 1.45, 1.45, 1.45)
                call SetUnitAnimation(bjLCU, "birth")
                call SetUnitTimeScale(bjLCU, 0.7)
                call SetUnitVertexColor(bjLCU, 255, 255, 255, 200)
                call UnitApplyTimedLife(bjLCU, 'BTLF', 2)
                call SaveUnitHandle(h, id, SH_EffectDummy2, bjLCU)
            endif
            if time < 0.5 then
                if LoadInteger(h, id, EffectPeriodHash) == 0 then
                    set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM25', point_x, point_y, GetRandomInt(0, 360))
                    call SetUnitScale(bjLCU, 2.8, 2.8, 2.8)
                    call SetUnitTimeScale(bjLCU, 1.2)
                    call SetUnitVertexColor(bjLCU, 255, 255, 255, 200)
                    call MyRemoveUnit(bjLCU , 1.5)
                    call SaveInteger(h, id, EffectPeriodHash, 2)
                else
                    call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash) - 1)
                endif
                set bjLCG=LoadGroupHandle(h, id, GroupHash)
                call GroupEnumUnitsInRange(bjLCG, point_x, point_y, 350, Base)
                loop
                set E=FirstOfGroup(bjLCG)
                exitwhen E == null
                    if Condition_Base(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)) , E) then
                        call myCustomDamage(LoadUnitHandle(h, id, CasterHash) , E , LoadReal(h, id, SH_Damage)*0.05/0.5 , false , false , null , null , null)
                        if time==0.1 then
                                                        call SetControlToUnit(LoadUnitHandle(h, id, CasterHash) , E , 1.0 , "stun")
                                                endif
                    endif
                    call GroupRemoveUnit(bjLCG, E)
                endloop
            else
                call SaveEffectHandle(h, id, Effect1Hash, AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Rejuvenation\\RejuvenationTarget.mdl", LoadUnitHandle(h, id, CasterHash), "chest"))
                call SaveEffectHandle(h, id, Effect2Hash, AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Rejuvenation\\RejuvenationTarget.mdl", LoadUnitHandle(h, id, CasterHash), "hand right"))
                call MyRemoveUnit(LoadUnitHandle(h, id, SH_EffectDummy1) , 0.5)
                if LoadBoolean(h, GetHandleId(LoadUnitHandle(h, id, CasterHash)), SH_MinatoR_Mod) then
                    call SetUnitAnimationByIndex(LoadUnitHandle(h, id, CasterHash), 25)
                else
                    call SetUnitAnimationByIndex(LoadUnitHandle(h, id, CasterHash), 24)
                endif
                call SaveReal(h, id, TIME_HASH, 0)
                call SaveInteger(h, id, SH_Act, 2)
            endif
        elseif act == 2 then
            if time == 0.2 then
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM08', GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)), GetRandomInt(0, 360))
                call SetUnitFlyHeight(bjLCU, 650, 0)
                call MyRemoveUnit(bjLCU , 1.5)
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM09', GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)), GetRandomInt(0, 360))
                call SetUnitFlyHeight(bjLCU, 650, 0)
                call MyRemoveUnit(bjLCU , 1.5)
                call SaveInteger(h, id, SH_Act, 3)
            endif
        endif
    else
        set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM16', point_x, point_y, GetRandomInt(0, 360))
        call SetUnitScale(bjLCU, 2, 2, 2)
        call SetUnitTimeScale(bjLCU, 0.5)
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM17', point_x, point_y, GetRandomInt(0, 360))
        call SetUnitScale(bjLCU, 10, 10, 10)
        call SetUnitTimeScale(bjLCU, 0.65)
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM24', point_x, point_y, 75)
        call SetUnitTimeScale(bjLCU, 0.8)
        call SetUnitFlyHeight(bjLCU, 30, 0)
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM24', point_x, point_y, 75)
        call SetUnitTimeScale(bjLCU, 0.8)
        call SetUnitFlyHeight(bjLCU, 30, 0)
        call MyRemoveUnit(bjLCU , 1.5)
        call ShakeCamera(0.2 , 15)
        call KillUnit(LoadUnitHandle(h, id, SH_EffectDummy2))
        call MyRemoveUnit(LoadUnitHandle(h, id, SH_EffectDummy2) , 2.5)
        set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM28', point_x, point_y, GetRandomInt(0, 360))
        call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
        call MyRemoveUnit(bjLCU , 2.5)
        set bjLCU=LoadUnitHandle(h, id, DummyHash)
        call SetUnitFlyHeight(LoadUnitHandle(h, id, CasterHash), 0, 0)
        call SetUnitX(LoadUnitHandle(h, id, CasterHash), GetUnitX(bjLCU))
        call SetUnitY(LoadUnitHandle(h, id, CasterHash), GetUnitY(bjLCU))
        call RemoveUnit(bjLCU)
        set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM08', GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)), GetRandomInt(0, 360))
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM09', GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)), GetRandomInt(0, 360))
        call MyRemoveUnit(bjLCU , 1.5)
        call DestroyGroup(LoadGroupHandle(h, id, GroupHash))
        call DestroyEffect(LoadEffectHandle(h, id, Effect1Hash))
        call DestroyEffect(LoadEffectHandle(h, id, Effect2Hash))
        call PauseUnit(LoadUnitHandle(h, id, CasterHash), false)
        call SetUnitInvulnerable(LoadUnitHandle(h, id, CasterHash), false)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
endfunction


function MinatoE_Ally_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local unit caster=LoadUnitHandle(h, id, CasterHash)
    local unit target=LoadUnitHandle(h, id, TargetHash)
    local real time=LoadReal(h, id, TIME_HASH)
    local real angle=AP(GetUnitX(caster) , GetUnitY(caster) , GetUnitX(target) , GetUnitY(target))
    if time < 0.25 then
        call SetUnitX(target, GetUnitX(caster) + 100 * Cos(angle))
        call SetUnitY(target, GetUnitY(caster) + 100 * Sin(angle))
        call SaveReal(h, id, TIME_HASH, time + 0.01)
    else
        set soundplay=SndN(3392) // Sound\war3mapImported\Minato_Hiraishin_Sound.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call SetUnitX(caster, LoadReal(h, id, SH_PointX))
        call SetUnitY(caster, LoadReal(h, id, SH_PointY))
        set angle=AP(GetUnitX(caster) , GetUnitY(caster) , GetUnitX(target) , GetUnitY(target))
        call SetUnitX(target, GetUnitX(caster) + 100 * Cos(angle))
        call SetUnitY(target, GetUnitY(caster) + 100 * Sin(angle))
        call MyRemoveUnit(CreateUnit(GetOwningPlayer(caster), 'dM08', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360)) , 1.5)
        call MyRemoveUnit(CreateUnit(GetOwningPlayer(caster), 'dM09', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360)) , 1.5)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
    set target=null
endfunction


function MinatoE_Cast takes unit newCaster,unit newTarget,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local integer id_caster= GetHandleId(newCaster)
    local real caster_x= GetUnitX(newCaster)
    local real caster_y= GetUnitY(newCaster)
    local real angle= GetUnitFacing(newCaster) * bj_DEGTORAD
    local real damage= GetHeroAgi(newCaster, true) * (GetUnitAbilityLevel(newCaster, 'MiE1')+1)
    local boolean MinatoR_Mod= LoadBoolean(h, id_caster, SH_MinatoR_Mod)
    local real range=1100
    if IsUnitAlly(newTarget, GetOwningPlayer(newCaster)) then
        if GetUnitAbilityLevel(newTarget, 'MiDp') >= 1 then
            set soundplay=SndN(3392) // Sound\war3mapImported\Minato_Hiraishin_Sound.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            set soundplay=SndN(3414) // Sound\war3mapImported\MinatoE_TargetAlly.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            call UnitRemoveAbility(newTarget, 'MiDp')
            set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM08', GetUnitX(newTarget), GetUnitY(newTarget), GetRandomInt(0, 360))
            call MyRemoveUnit(bjLCU , 1.5)
            set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM09', GetUnitX(newTarget), GetUnitY(newTarget), GetRandomInt(0, 360))
            call MyRemoveUnit(bjLCU , 1.5)
            call SetUnitX(newCaster, GetUnitX(newTarget) - 100 * Cos(angle))
            call SetUnitY(newCaster, GetUnitY(newTarget) - 100 * Sin(angle))
            call PauseUnit(newCaster, true)
            call SetUnitInvulnerable(newCaster, true)
            call SaveUnitHandle(h, id, CasterHash, newCaster)
            call SaveUnitHandle(h, id, TargetHash, newTarget)
            call SaveReal(h, id, SH_PointX, caster_x)
            call SaveReal(h, id, SH_PointY, caster_y)
            call TimerStart(newTimer, 0.01, true, function MinatoE_Ally_Periodic)
        else
            call IssueImmediateOrder(newCaster, "stop")
            call StartAbilityCooldown(GetUnitAbility(newCaster , 'MiE1' ), 0.1)
            call DestroyTimer(newTimer)
        endif
    else
        if GetUnitAbilityLevel(newTarget, 'MiDp') >= 1 then
            call UnitRemoveAbility(newTarget, 'MiDp')
            set angle=AU(newCaster , newTarget)
            call ShakeCamera(0.1 , 10)
            if GetUnitAbilityLevel(newCaster, 'MiW1') == 0 then
                if LoadBoolean(HH,GetHandleId(newTarget),ANTITARGET_ABILITY)==false then
                    if MinatoR_Mod then
                        set soundplay=SndN(3416) // Sound\war3mapImported\Minato_R_E.mp3
                        call StartSound(soundplay)
                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                        call SetUnitAnimationByIndex(newCaster, 13)
                    else
                        set soundplay=SndN(3418) // Sound\war3mapImported\Minato_E.mp3
                        call StartSound(soundplay)
                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                        call SetUnitAnimationByIndex(newCaster, 2)
                    endif
                    call PauseUnit(newCaster, true)
                    call SetControlToUnit(newCaster,newTarget,0.3,"stun")
                    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM08', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
                    call MyRemoveUnit(bjLCU , 1.5)
                    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM09', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
                    call MyRemoveUnit(bjLCU , 1.5)
                    call SetUnitX(newCaster, GetUnitX(newTarget) + 75 * Cos(angle))
                    call SetUnitY(newCaster, GetUnitY(newTarget) + 75 * Sin(angle))
                    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM08', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
                    call MyRemoveUnit(bjLCU , 1.5)
                    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM09', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
                    call MyRemoveUnit(bjLCU , 1.5)
                    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM04', GetUnitX(newCaster), GetUnitY(newCaster), AU(newCaster , newTarget) * bj_RADTODEG)
                    call SetUnitVertexColor(bjLCU, 255, 255, 255, 150)
                    call SetUnitTimeScale(bjLCU, 0.6)
                    call SetUnitFlyHeight(bjLCU, 150, 0)
                    call SetUnitScale(bjLCU, 0.62, 0.62, 0.62)
                    call MyRemoveUnit(bjLCU , 1.5)
                    set angle=AU(newCaster , newTarget)
                    if MinatoR_Mod then
                    call Push3(newTarget , 25 , angle , 450, "")
                    else
                    call Push3(newTarget , 20 , angle , 350, "")
                    endif
                    call SetUnitFacingInstant(newCaster , angle * bj_RADTODEG)
                    call SetUnitAnimation(newCaster, "attack")
                    
                    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM01', GetUnitX(newTarget), GetUnitY(newTarget), GetRandomInt(0, 360))
                    call SetUnitTimeScale(bjLCU, 0.4)
                    call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
                    call SetUnitFlyHeight(bjLCU, 30, 0)
                    if MinatoR_Mod then
                    call Push3(bjLCU , 25 , angle , 450, "")
                    else
                    call Push3(bjLCU , 20 , angle , 350, "")
                    endif
                    call MyRemoveUnit(bjLCU , 1.5)
                    call DestroyEffect(AddSpecialEffectTarget("HeroBladeMasterpf_E1.mdl", newTarget, "origin"))
                    call myCustomDamage(newCaster , newTarget , damage / 2 , false , false , null , null , null)
                    
                    call SaveInteger(h, id, SH_PeriodicAngle, 1)
                    call SaveUnitHandle(h, id, CasterHash, newCaster)
                    call SaveUnitHandle(h, id, TargetHash, newTarget)
                    call SaveEffectHandle(h, id, Effect1Hash, AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Rejuvenation\\RejuvenationTarget.mdl", newCaster, "chest"))
                    call SaveEffectHandle(h, id, Effect2Hash, AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Rejuvenation\\RejuvenationTarget.mdl", newCaster, "hand right"))
                    call TimerStart(newTimer, 0.01, true, function MinatoE1_Periodic)
                else
                    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM08', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
                    call MyRemoveUnit(bjLCU , 1.5)
                    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM09', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
                    call MyRemoveUnit(bjLCU , 1.5)
                    call SetUnitX(newCaster, GetUnitX(newTarget) + 75 * Cos(angle))
                    call SetUnitY(newCaster, GetUnitY(newTarget) + 75 * Sin(angle))
                    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM08', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
                    call MyRemoveUnit(bjLCU , 1.5)
                    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM09', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
                    call MyRemoveUnit(bjLCU , 1.5)
                    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM04', GetUnitX(newCaster), GetUnitY(newCaster), AU(newCaster , newTarget) * bj_RADTODEG)
                    call SetUnitVertexColor(bjLCU, 255, 255, 255, 150)
                    call SetUnitTimeScale(bjLCU, 0.6)
                    call SetUnitFlyHeight(bjLCU, 150, 0)
                    call SetUnitScale(bjLCU, 0.62, 0.62, 0.62)
                    call MyRemoveUnit(bjLCU , 1.5)
                    set angle=AU(newCaster , newTarget)
                    call SetUnitFacingInstant(newCaster , angle * bj_RADTODEG)
                    call SetUnitAnimation(newCaster, "attack")
                    call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,LoadUnitHandle(h, id, CasterHash))
                    call DestroyTimer(newTimer)
                endif
            else
                set soundplay=SndN(3392) // Sound\war3mapImported\Minato_Hiraishin_Sound.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                call PauseUnit(newCaster, true)
                call SetUnitInvulnerable(newCaster, true)
                call UnitAddAbility(newCaster, 'Arav')
                call UnitRemoveAbility(newCaster, 'Arav')
                if MinatoR_Mod then
                    call SetUnitAnimationByIndex(newCaster, 18)
                else
                    call SetUnitAnimationByIndex(newCaster, 7)
                endif
                call SaveEffectHandle(h, id, Effect1Hash, AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Rejuvenation\\RejuvenationTarget.mdl", newCaster, "chest"))
                call SaveEffectHandle(h, id, Effect2Hash, AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Rejuvenation\\RejuvenationTarget.mdl", newCaster, "hand right"))
                
                
                set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM23', GetUnitX(newTarget) + 500 * Cos(angle), GetUnitY(newTarget) + 500 * Sin(angle), GetRandomInt(0, 360))
                call SetUnitFlyHeight(bjLCU, 100, 0)
                call MyRemoveUnit(bjLCU , 1.5)
                
                set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM22', GetUnitX(newTarget) + 500 * Cos(angle), GetUnitY(newTarget) + 500 * Sin(angle), GetRandomInt(0, 360))
                call SaveUnitHandle(h, id, DummyHash, bjLCU)
                call SaveUnitHandle(h, id, CasterHash, newCaster)
                call SaveUnitHandle(h, id, TargetHash, newTarget)
                call SaveReal(h, id, SH_Point_X, GetUnitX(newTarget))
                call SaveReal(h, id, SH_Point_Y, GetUnitY(newTarget))
                call SaveReal(h, id, SH_Damage, damage + LoadReal(h, id_caster, SH_MinatoW_Damage))
                call SaveGroupHandle(h, id, GroupHash, CreateGroup())
                call TimerStart(newTimer, 0.05, true, function MinatoE3_Periodic)
            endif
        elseif LoadUnitHandle(h, id_caster, SH_MinatoQ_Kunai) != null then
            if SquareRootUnit(LoadUnitHandle(h, id_caster, SH_MinatoQ_Kunai) , newTarget) <= range then
                if LoadBoolean(HH,GetHandleId(newTarget),ANTITARGET_ABILITY)==false then    
                    call ShakeCamera(0.1 , 10)
                    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM02', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
                    call UnitApplyTimedLife(bjLCU, 'BTLF', 15)
                    call UnitEnableInventoryCustom(bjLCU,false,false )
                    call UnitEnableMovement(bjLCU,false,false )
                    call UnitEnableAttack(bjLCU,false,false )
                    call SaveInteger(h, id, SH_PeriodicAngle, 1)
                    
                    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM08', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
                    call MyRemoveUnit(bjLCU , 1.5)
                    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM09', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
                    call MyRemoveUnit(bjLCU , 1.5)
                    call SetUnitX(newCaster, GetUnitX(LoadUnitHandle(h, id_caster, SH_MinatoQ_Kunai)))
                    call SetUnitY(newCaster, GetUnitY(LoadUnitHandle(h, id_caster, SH_MinatoQ_Kunai)))
                    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM08', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
                    call MyRemoveUnit(bjLCU , 1.5)
                    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM09', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
                    call MyRemoveUnit(bjLCU , 1.5)
                    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM04', GetUnitX(newCaster), GetUnitY(newCaster), AU(newCaster , newTarget) * bj_RADTODEG)
                    call SetUnitVertexColor(bjLCU, 255, 255, 255, 150)
                    call SetUnitTimeScale(bjLCU, 0.6)
                    call SetUnitFlyHeight(bjLCU, 150, 0)
                    call SetUnitScale(bjLCU, 0.62, 0.62, 0.62)
                    call MyRemoveUnit(bjLCU , 1.5)
                    call PauseUnit(newCaster, true)
                    call SetUnitInvulnerable(newCaster, true)
                    if MinatoR_Mod then
                        set soundplay=SndN(3416) // Sound\war3mapImported\Minato_R_E.mp3
                        call StartSound(soundplay)
                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                        call SetUnitAnimationByIndex(newCaster, 13)
                    else
                        set soundplay=SndN(3418) // Sound\war3mapImported\Minato_E.mp3
                        call StartSound(soundplay)
                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                        call SetUnitAnimationByIndex(newCaster, 2)
                    endif
                    call SetUnitFacingInstant(newCaster , AU(newCaster , newTarget) * bj_RADTODEG)
                    call SaveUnitHandle(h, id, CasterHash, newCaster)
                    call SaveUnitHandle(h, id, TargetHash, newTarget)
                    call SaveEffectHandle(h, id, Effect1Hash, AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Rejuvenation\\RejuvenationTarget.mdl", newCaster, "chest"))
                    call SaveEffectHandle(h, id, Effect2Hash, AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Rejuvenation\\RejuvenationTarget.mdl", newCaster, "hand right"))
                    call TimerStart(newTimer, 0.01, true, function MinatoE2_Periodic)
                else
                    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM08', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
                    call MyRemoveUnit(bjLCU , 1.5)
                    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM09', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
                    call MyRemoveUnit(bjLCU , 1.5)
                    call SetUnitX(newCaster, GetUnitX(newTarget) + 75 * Cos(angle))
                    call SetUnitY(newCaster, GetUnitY(newTarget) + 75 * Sin(angle))
                    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM08', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
                    call MyRemoveUnit(bjLCU , 1.5)
                    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM09', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
                    call MyRemoveUnit(bjLCU , 1.5)
                    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM04', GetUnitX(newCaster), GetUnitY(newCaster), AU(newCaster , newTarget) * bj_RADTODEG)
                    call SetUnitVertexColor(bjLCU, 255, 255, 255, 150)
                    call SetUnitTimeScale(bjLCU, 0.6)
                    call SetUnitFlyHeight(bjLCU, 150, 0)
                    call SetUnitScale(bjLCU, 0.62, 0.62, 0.62)
                    call MyRemoveUnit(bjLCU , 1.5)
                    set angle=AU(newCaster , newTarget)
                    call SetUnitFacingInstant(newCaster , angle * bj_RADTODEG)
                    call SetUnitAnimation(newCaster, "attack")
                    call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,LoadUnitHandle(h, id, CasterHash))
                    call DestroyTimer(newTimer)
                endif
            else
                call IssueImmediateOrder(newCaster, "stop")
                call StartAbilityCooldown(GetUnitAbility(newCaster , 'MiE1' ), 0.1)
                call DestroyTimer(newTimer)
            endif
        else
            call IssueImmediateOrder(newCaster, "stop")
            call StartAbilityCooldown(GetUnitAbility(newCaster , 'MiE1' ), 0.1)
            call DestroyTimer(newTimer)
        endif
    endif
endfunction

function MinatoR_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local integer id_caster= GetHandleId(LoadUnitHandle(h, id, CasterHash))
    local integer allstats=LoadInteger(h, id, SH_Allstats)
    local real time= LoadReal(h, id, TIME_HASH)
    if time < 21.2 and udg_B and UnitIsAlive(LoadUnitHandle(h, id, CasterHash)) then
        if (IsUnitPaused(LoadUnitHandle(h, id, CasterHash)) == false and IsUnitHidden(LoadUnitHandle(h, id, CasterHash)) == false and GetUnitAbilityLevel(LoadUnitHandle(h, id, CasterHash),'Pet1')==0) or time <= 1.2 then
            call SaveReal(h, id, TIME_HASH, time + 0.05)
        endif
        if time == 1.2 then
            call PauseUnit(LoadUnitHandle(h, id, CasterHash), false)
            call SetUnitInvulnerable(LoadUnitHandle(h, id, CasterHash), false) 
            call CreateModeIndicatorWithPauseForm(LoadUnitHandle(h, id, CasterHash), "ReplaceableTextures\\CommandButtons\\BTNMinatoR.blp", 20)
        endif
        if time == 0.7 then
            call ShakeCamera(0.3 , 10)
            set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM31', GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)), GetRandomInt(0, 360))
            call SetUnitScale(bjLCU, 0.55, 0.55, 0.55)
            call UnitApplyTimedLife(bjLCU, 'BTLF', 1.0)
            call MyRemoveUnit(bjLCU , 1.8)
        endif
        if time < 0.7 then
            if LoadInteger(h, id, EffectPeriodHash) == 0 then
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM25', GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)), GetRandomInt(0, 360))
                call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
                call SetUnitFlyHeight(bjLCU, 5, 0)
                call SetUnitVertexColor(bjLCU, 255, 255, 255, 130)
                call MyRemoveUnit(bjLCU , 0.8)
                call SaveInteger(h, id, EffectPeriodHash, 2)
            else
                call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash) - 1)
            endif
        endif
        call HealTextTag(LoadUnitHandle(h, id, CasterHash),LoadUnitHandle(h, id, CasterHash),LoadReal(h, id, SH_HP_Regen)*myCustomHeal2(LoadUnitHandle(h, id, CasterHash),1),"HealthRes")
        call HealTextTag(LoadUnitHandle(h, id, CasterHash),LoadUnitHandle(h, id, CasterHash),LoadReal(h, id, SH_MP_Regen)*myCustomMana2(LoadUnitHandle(h, id, CasterHash),1),"ManaRes")
        call SetWidgetLife(LoadUnitHandle(h, id, CasterHash), GetWidgetLife(LoadUnitHandle(h, id, CasterHash)) + LoadReal(h, id, SH_HP_Regen))
        call SetWidgetMana(LoadUnitHandle(h, id, CasterHash) , GetWidgetMana(LoadUnitHandle(h, id, CasterHash)) + LoadReal(h, id, SH_MP_Regen))
    else
        call UnitRemoveAbility(LoadUnitHandle(h, id, CasterHash), 'MiD2')
        call ShowAbility2( 'MiD1' , true)
        call UnitRemoveAbility(LoadUnitHandle(h, id, CasterHash), 'MiQ4')
        if GetUnitAbilityLevel(LoadUnitHandle(h, id, CasterHash), 'MiQ3') == 0 then
            call ShowAbility2( 'MiQ1' , true)
        endif
        call SetHeroStr(LoadUnitHandle(h, id, CasterHash), GetHeroStr(LoadUnitHandle(h, id, CasterHash), false) - allstats, false)
        call SetHeroAgi(LoadUnitHandle(h, id, CasterHash), GetHeroAgi(LoadUnitHandle(h, id, CasterHash), false) - allstats, false)
        call SetHeroInt(LoadUnitHandle(h, id, CasterHash), GetHeroInt(LoadUnitHandle(h, id, CasterHash), false) - allstats, false)
        call SaveBoolean(h, id_caster, SH_MinatoR_Mod, false)
        call AddUnitAnimationProperties(LoadUnitHandle(h, id, CasterHash), "Alternate", false)
                // if GetLocalPlayer()==GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)) then
                        // call ClearSelection()
                        // call SelectUnit(LoadUnitHandle(h, id, CasterHash), true)
                // endif
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
endfunction

function MinatoR_Cast takes unit newCaster,timer newTimer returns nothing
    local integer id=GetHandleId(newTimer)
    local integer id_caster=GetHandleId(newCaster)
    local real hp_regen=10 * GetUnitAbilityLevel(newCaster, 'MiR1')
    local real mp_regen=4 * GetUnitAbilityLevel(newCaster, 'MiR1')
    local integer allstats=5 + 5 * GetUnitAbilityLevel(newCaster, 'MiR1')
    set soundplay=SndN(3420) // Sound\war3mapImported\Minato_R.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM32', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    call SetUnitFlyHeight(bjLCU, 2, 0)
    call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
    call SetUnitVertexColor(bjLCU, 255, 255, 255, 130)
    call UnitApplyTimedLife(bjLCU, 'BTLF', 1.3)
    call MyRemoveUnit(bjLCU , 1.7)
    call SetHeroStr(newCaster, GetHeroStr(newCaster, false) + allstats, false)
    call SetHeroAgi(newCaster, GetHeroAgi(newCaster, false) + allstats, false)
    call SetHeroInt(newCaster, GetHeroInt(newCaster, false) + allstats, false)
    call AddUnitAnimationProperties(newCaster, "Alternate", true)
    call SetUnitAnimationByIndex(newCaster, 9)
    if GetUnitAbilityLevel(newCaster, 'MiQ3') == 0 then
        call ShowAbility2( 'MiQ4' , true)
    endif
    call ShowAbility2( 'MiD1' , false)
    call UnitAddAbility(newCaster, 'MiD2')
    call UnitAddAbility(newCaster, 'MiQ4')
    call SetUnitAbilityLevel(newCaster, 'MiQ4', GetUnitAbilityLevel(newCaster, 'MiQ1'))
    call ShowAbility2( 'MiQ1' , false)
    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
        // if GetLocalPlayer()==GetOwningPlayer(newCaster) then
                // call ClearSelection()
                // call SelectUnit(newCaster, true)
        // endif
    call SaveBoolean(h, id_caster, SH_MinatoR_Mod, true)
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call SaveInteger(h, id, SH_Allstats, allstats)
    call SaveReal(h, id, SH_HP_Regen, hp_regen * 0.05)
    call SaveReal(h, id, SH_MP_Regen, mp_regen * 0.05)
    call TimerStart(newTimer, 0.05, true, function MinatoR_Periodic)
endfunction


function MinatoT_Combination_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local unit caster= LoadUnitHandle(h, id, CasterHash)
    local unit target= LoadUnitHandle(h, id, TargetHash)
    local unit dummy= LoadUnitHandle(h, id, Dummy1Hash)
    local integer act= LoadInteger(h, id, SH_Act)
    local real time=LoadReal(h, id, TIME_HASH)
    local real angle=LoadReal(h, id, AngleHash)
    local trigger tt=LoadTriggerHandle(h, id, SH_Trigger_Direction)
    if act < 3 then
        call SaveReal(h, id, TIME_HASH, time + 0.01)
        call PauseUnit(target,true)
        call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
        if act == 0 then
            call SetUnitInvulnerable(caster, true)
            call SetControlToUnit(caster , caster , 0.11 , "doomdebug")
            if time < 1.5 then
                call SetUnitX(target, GetUnitX(target) + 10 * Cos(angle))
                call SetUnitY(target, GetUnitY(target) + 10 * Sin(angle))
                
                if LoadInteger(h, id, EffectPeriodHash) == 0 then
                    set n=CreateUnit(GetOwningPlayer(caster), 'dM08', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
                    call SetUnitFlyHeight(n, GetUnitFlyHeight(dummy) + 150, 0)
                    call SetUnitScale(n, 0.6, 0.6, 0.6)
                    call SetUnitTimeScale(n, 0.75)
                    call MyRemoveUnit(n , 1.5)
                    set n=CreateUnit(GetOwningPlayer(caster), 'dM09', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
                    call SetUnitFlyHeight(n, GetUnitFlyHeight(dummy) + 150, 0)
                    call SetUnitScale(n, 1.7, 1.7, 1.7)
                    call MyRemoveUnit(n , 1.5)
                    set n=CreateUnit(GetOwningPlayer(caster), 'dM38', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
                    call SetUnitFlyHeight(n, GetUnitFlyHeight(dummy) + 150, 0)
                    call MyRemoveUnit(n , 1.5)
                    if GetRandomInt(0, 1) == 0 then
                        set n=CreateUnit(GetOwningPlayer(caster), 'dM39', GetUnitX(target), GetUnitY(target), angle * bj_RADTODEG)
                        call SetUnitTimeScale(n, 1.2)
                        call SetUnitVertexColor(n, 255, 255, 255, 180)
                        if LoadBoolean(h, GetHandleId(caster), SH_MinatoR_Mod) then
                            call SetUnitAnimationByIndex(n, GetRandomInt(13, 14))
                        else
                            call SetUnitAnimationByIndex(n, GetRandomInt(2, 3))
                        endif
                        call MyRemoveUnit(n , 0.4)
                    endif
                    call SaveInteger(h, id, SH_EffectAngle, LoadInteger(h, id, SH_EffectAngle) * ( - 1 ))
                    set angle=angle + 110 * LoadInteger(h, id, SH_EffectAngle) * bj_DEGTORAD
                    set n=CreateUnit(GetOwningPlayer(caster), 'dM08', GetUnitX(target) + 250 * Cos(angle), GetUnitY(target) + 250 * Sin(angle), GetRandomInt(0, 360))
                    call SetUnitFlyHeight(n, GetUnitFlyHeight(dummy) + 150, 0)
                    call SetUnitScale(n, 0.5, 0.5, 0.5)
                    call MyRemoveUnit(n , 1.5)
                    set n=CreateUnit(GetOwningPlayer(caster), 'dM09', GetUnitX(target) + 250 * Cos(angle), GetUnitY(target) + 250 * Sin(angle), GetRandomInt(0, 360))
                    call SetUnitFlyHeight(n, GetUnitFlyHeight(dummy) + 150, 0)
                    call MyRemoveUnit(n , 1.5)
                    set n=CreateUnit(GetOwningPlayer(caster), 'dM38', GetUnitX(target) + 250 * Cos(angle), GetUnitY(target) + 250 * Sin(angle), GetRandomInt(0, 360))
                    call SetUnitFlyHeight(n, GetUnitFlyHeight(dummy) + 150, 0)
                    call MyRemoveUnit(n , 1.5)
                    if GetRandomInt(0, 3) == 0 then
                        set n=CreateUnit(GetOwningPlayer(caster), 'dM39', GetUnitX(target) + 250 * Cos(angle), GetUnitY(target) + 250 * Sin(angle), angle * bj_RADTODEG - 110 * LoadInteger(h, id, SH_EffectAngle))
                        call SetUnitTimeScale(n, 1.2)
                        call SetUnitFacing(n, AU(n , target) * bj_RADTODEG)
                        call SetUnitVertexColor(n, 255, 255, 255, 180)
                        if LoadBoolean(h, GetHandleId(caster), SH_MinatoR_Mod) then
                            call SetUnitAnimationByIndex(n, GetRandomInt(13, 14))
                        else
                            call SetUnitAnimationByIndex(n, GetRandomInt(2, 3))
                        endif
                        call MyRemoveUnit(n , 0.4)
                    endif
                    call SetUnitX(dummy, GetUnitX(n))
                    call SetUnitY(dummy, GetUnitY(n))
                    call SaveInteger(h, id, EffectPeriodHash, 7)
                else
                    call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash) - 1)
                endif
            else
                call TriggerClearActions(tt)
                call DestroyTrigger(tt)
                call UnitRemoveAbility(caster, 'A1FU')
                call UnitRemoveAbility(caster,'Pet1')
                call UnitRemoveAbility(caster, 'B00A')
                call IssueImmediateOrder(caster, "stop")
                call PauseUnit(caster, true)
                call SetUnitAcquireRange(caster, 600)
                if LoadBoolean(h, GetHandleId(caster), SH_MinatoR_Mod) then
                    call SetUnitAnimationByIndex(caster, 14)
                else
                    call SetUnitAnimationByIndex(caster, 3)
                endif
                set angle=GetUnitFacing(caster) * bj_DEGTORAD
                call SaveReal(h, id, AngleHash, angle)
                call SaveInteger(h, id, SH_Act, 1)
                call SaveReal(h, id, TIME_HASH, 0.0)
                call SetUnitX(target, GetUnitX(caster) + 150 * Cos(angle))
                call SetUnitY(target, GetUnitY(caster) + 150 * Sin(angle))
                call KillUnit(dummy)
                call MyRemoveUnit(dummy , 1)
                call RemoveSavedHandle(h, id, Dummy1Hash)
                set dummy=null
                set n=CreateUnit(GetOwningPlayer(caster), 'dM08', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
                call SetUnitFlyHeight(n, GetUnitFlyHeight(caster) + 115, 0)
                call MyRemoveUnit(n , 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'dM09', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
                call SetUnitFlyHeight(n, GetUnitFlyHeight(caster) + 115, 0)
                call MyRemoveUnit(n , 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'dM17', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
                call SetUnitFlyHeight(n, GetUnitFlyHeight(caster) + 150, 0)
                call SetUnitScale(n, 6, 6, 6)
                call MyRemoveUnit(n , 1.5)
                set soundplay=SndN(3373) // Sound\war3mapImported\MinatoT_Sound3.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            endif
        elseif act == 1 then
            if time == 0.2 then
                set n=CreateUnit(GetOwningPlayer(caster), 'dM13', GetUnitX(caster) + 175 * Cos(angle), GetUnitY(caster) + 175 * Sin(angle), GetRandomInt(0, 360))
                call SetUnitScale(n, 3, 3, 3)
                call SetUnitFlyHeight(n, 200, 0)
                call SetUnitAnimation(n, "Birth")
                                call UnitApplyTimedLife(n,'BTLF', 0.3)
                call MyRemoveUnit(n , 0.3)
                set n=CreateUnit(GetOwningPlayer(caster), 'dM13', GetUnitX(caster) + 175 * Cos(angle), GetUnitY(caster) + 175 * Sin(angle), GetRandomInt(0, 360))
                call SetUnitScale(n, 5, 5, 5)
                call SetUnitFlyHeight(n, 200, 0)
                call SetUnitAnimation(n, "Birth")
                                call UnitApplyTimedLife(n,'BTLF', 0.3)
                call MyRemoveUnit(n , 0.3)
            endif
            if time == 0.25 then
                set dummy=CreateUnit(GetOwningPlayer(caster), 'dM13', GetUnitX(target), GetUnitY(target), 0)
                call SetUnitScale(dummy, 12, 12, 12)
                call SetUnitFlyHeight(dummy, 125, 0)
                call SaveUnitHandle(h, id, Dummy1Hash, dummy)
            endif
            if time == 0.35 then
                call PauseUnit(caster, false)
                call SetUnitInvulnerable(caster, false)
                                call UnitRemoveAbility(caster, 'BlTP')
                call DestroyEffect(LoadEffectHandle(h, id, SH_Effect_Rasengan))
                set n=CreateUnit(GetOwningPlayer(caster), 'dM04', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
                call SetUnitFlyHeight(n, 150, 0)
                call SetUnitTimeScale(n, 0.6)
                call SetUnitVertexColor(n, 255, 255, 255, 185)
                call SetUnitScale(n, 2, 2, 2)
                call MyRemoveUnit(n , 2.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'dM16', GetUnitX(caster) + 200 * Cos(angle), GetUnitY(caster) + 200 * Sin(angle), angle * bj_RADTODEG)
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call SetUnitFlyHeight(n, 150, 0)
                call SetUnitTimeScale(n, 0.5)
                call MyRemoveUnit(n , 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'dM17', GetUnitX(caster) + 200 * Cos(angle), GetUnitY(caster) + 200 * Sin(angle), GetRandomInt(0, 360))
                call SetUnitScale(n, 5, 5, 5)
                call SetUnitFlyHeight(n, 120, 0)
                call SetUnitTimeScale(n, 0.65)
                call MyRemoveUnit(n , 3.0)
                set n=CreateUnit(GetOwningPlayer(caster), 'dM18', GetUnitX(caster) + 170 * Cos(angle), GetUnitY(caster) + 170 * Sin(angle), angle * bj_RADTODEG)
                call SetUnitScale(n, 1.2, 1.2, 1.2)
                call SetUnitFlyHeight(n, 120, 0)
                call SetUnitTimeScale(n, 0.6)
                call MyRemoveUnit(n , 3.0)
                set n=CreateUnit(GetOwningPlayer(caster), 'dM18', GetUnitX(caster) + 170 * Cos(angle), GetUnitY(caster) + 170 * Sin(angle), angle * bj_RADTODEG)
                call SetUnitScale(n, 1.2, 1.2, 1.2)
                call SetUnitFlyHeight(n, 120, 0)
                call SetUnitTimeScale(n, 0.6)
                call MyRemoveUnit(n , 3.0)
            endif
            if time >= 0.5 then
                call ShakeCamera(0.2 , 10)
                call SaveInteger(h, id, SH_Act, 2)
                call SaveReal(h, id, TIME_HASH, 0.0)
            endif
        elseif act == 2 then
            if time < 0.5 then
                call SetUnitX(target, GetUnitX(target) + 40 * Cos(angle))
                call SetUnitY(target, GetUnitY(target) + 40 * Sin(angle))
                call SetUnitX(dummy, GetUnitX(target))
                call SetUnitY(dummy, GetUnitY(target))
                if LoadInteger(h, id, EffectPeriodHash) == 0 then
                    set n=CreateUnit(GetOwningPlayer(caster), 'dM11', GetUnitX(target), GetUnitY(target), angle * bj_RADTODEG)
                    call SetUnitFlyHeight(n, 120, 0)
                    call SetUnitScale(n, 0.85, 0.85, 0.85)
                    call MyRemoveUnit(n , 1.5)
                    call SaveInteger(h, id, EffectPeriodHash, 7)
                else
                    call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash) - 1)
                endif
            else
                call ShakeCamera(0.5 , 20)
                call SaveInteger(h, id, SH_Act, 3)
                set n=CreateUnit(GetOwningPlayer(caster), 'dM34', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call KillUnit(n)
                call MyRemoveUnit(n , 2.5)
            endif
        endif
    else
        set soundplay=SndN(3376) // Sound\war3mapImported\MinatoT_Sound4.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        call KillUnit(dummy)
        call MyRemoveUnit(dummy , 1)
        call PauseUnit(target,false)
        call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
        call SetUnitInvulnerable(target, false)
        call myCustomDamage(caster , target , GetHeroAgi(caster, true) * 10 , false , false , null , null , null)
        call SetControlToUnit(caster , target , 1.0 , "stun")
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
    set target=null
    set dummy=null
    set tt=null
endfunction


function MinatoT_StopOrders2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h, id, 0)
    call IssueImmediateOrder(u, "stop")
    call SetUnitFacing(u, Atan2(LoadReal(h, id, 1) - GetUnitY(u), LoadReal(h, id, 2) - GetUnitX(u)) * bj_RADTODEG)
    if LoadBoolean(h, GetHandleId(u), SH_MinatoR_Mod) then
        call SetUnitAnimationByIndex(u, 12)
    else
        call SetUnitAnimationByIndex(u, 1)
    endif
    call FlushChildHashtable(h, id)
    call DestroyTimer(t)
    set t=null
    set u=null
endfunction
function MinatoT_StopOrders takes nothing returns nothing
    local unit u=GetOrderedUnit()
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    call SaveUnitHandle(h, id, 0, u)
    if GetOrderTargetUnit() == null then
        call SaveReal(h, id, 2, GetOrderPointX())
        call SaveReal(h, id, 1, GetOrderPointY())
    else
    call SaveReal(h, id, 2, GetUnitX(GetOrderTargetUnit()))
    call SaveReal(h, id, 1, GetUnitY(GetOrderTargetUnit()))
    endif
    call TimerStart(t, 0.001, false, function MinatoT_StopOrders2)
    set u=null
    set t=null
endfunction

function MinatoT_Combination_Cast takes unit newCaster,unit newTarget,real newAngle,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local real caster_x= GetUnitX(newCaster)
    local real caster_y= GetUnitY(newCaster)
    local real angle=newAngle
    local trigger tt= CreateTrigger()
    set soundplay=SndN(3382) // Sound\war3mapImported\MinatoT_Sound2.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set soundplay=SndN(3422) // Sound\war3mapImported\MinatoT_Voice2.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call SetUnitInvulnerable(newCaster, true)
    call PauseUnit(newTarget,true)
    call SaveBoolean(HH,GetHandleId(newTarget),TARGET_ABILITY,true)
    call SetUnitInvulnerable(newTarget, true)
    call UnitAddAbility(newCaster, 'A1FU')
    call UnitAddAbility(newCaster,'Pet1')
    call TriggerRegisterUnitEvent(tt, newCaster, EVENT_UNIT_ISSUED_TARGET_ORDER)
    call TriggerRegisterUnitEvent(tt, newCaster, EVENT_UNIT_ISSUED_POINT_ORDER)
    call SaveTriggerHandle(h, id, SH_Trigger_Direction, tt)
    call TriggerAddAction(tt, function MinatoT_StopOrders)
    call SetUnitAcquireRange(newCaster, 51)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM35', caster_x, caster_y, GetRandomInt(0, 360))
    call SetUnitScale(n, 2, 2, 2)
    call SaveUnitHandle(h, id, Dummy1Hash, n)
    call SaveUnitHandle(h, id, CasterHash, newCaster)
        call UnitAddAbility(newCaster, 'BlTP')
    call SaveUnitHandle(h, id, TargetHash, newTarget)
    call SaveReal(h, id, AngleHash, angle)
    call SaveInteger(h, id, SH_EffectAngle, 1)
    call SaveEffectHandle(h, id, SH_Effect_Rasengan, AddSpecialEffectTarget("RasenganImpact_W.mdx", newCaster, "hand right"))
    call TimerStart(newTimer, 0.01, true, function MinatoT_Combination_Periodic)
    set tt=null
endfunction

function MinatoT_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local real distance=LoadReal(h, id, SH_Distance)
    local real angle=LoadReal(h, id, AngleHash)
    if distance < 1000 then
        if LoadReal(h, id, TIME_HASH) > 0.3 then
            call SetUnitX(LoadUnitHandle(h, id, Clone0Hash), GetUnitX(LoadUnitHandle(h, id, Clone0Hash)) + 35 * Cos(angle))
            call SetUnitY(LoadUnitHandle(h, id, Clone0Hash), GetUnitY(LoadUnitHandle(h, id, Clone0Hash)) + 35 * Sin(angle))
            call SaveReal(h, id, SH_Distance, distance + 35)
            set bjLCG=LoadGroupHandle(h, id, SH_Group1)
            call GroupEnumUnitsInRange(bjLCG, GetUnitX(LoadUnitHandle(h, id, Clone0Hash)), GetUnitY(LoadUnitHandle(h, id, Clone0Hash)), 150, Base)
            loop
            set E=FirstOfGroup(bjLCG)
            exitwhen E == null
                if Condition_Base(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)) , E) and IsUnitInGroup(E, LoadGroupHandle(h, id, SH_Group2)) == false and E != LoadUnitHandle(h, id, CasterHash) and IsUnitInvulnerable(E)==false then
                    if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
                        call MinatoT_Combination_Cast(LoadUnitHandle(h, id, CasterHash) , E , angle , CreateTimer())
                    else
                        call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,LoadUnitHandle(h, id, CasterHash))
                    endif
                    call GroupClear(bjLCG)
                    call SaveReal(h, id, SH_Distance, 1000)
                endif
            call GroupRemoveUnit(bjLCG, E)
            endloop
            if LoadInteger(h, id, EffectPeriodHash) == 0 then
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM11', GetUnitX(LoadUnitHandle(h, id, Clone0Hash)), GetUnitY(LoadUnitHandle(h, id, Clone0Hash)), angle * bj_RADTODEG)
                call SetUnitFlyHeight(bjLCU, 150, 0)
                call SetUnitVertexColor(bjLCU, 255, 255, 255, 140)
                call SetUnitScale(bjLCU, 0.6, 0.6, 0.6)
                call MyRemoveUnit(bjLCU , 1.5)
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM29', GetUnitX(LoadUnitHandle(h, id, Clone0Hash)), GetUnitY(LoadUnitHandle(h, id, Clone0Hash)), angle * bj_RADTODEG)
                call SetUnitVertexColor(bjLCU, 255, 255, 255, 180)
                call SetUnitScale(bjLCU, 0.8, 0.8, 0.8)
                call MyRemoveUnit(bjLCU , 1.5)
                call SaveInteger(h, id, EffectPeriodHash, 8)
            else
                call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash) - 1)
            endif
        elseif LoadReal(h, id, TIME_HASH) == 0.3 then
            if LoadBoolean(h, GetHandleId(LoadUnitHandle(h, id, CasterHash)), SH_MinatoR_Mod) then
                call SetUnitAnimationByIndex(LoadUnitHandle(h, id, Clone0Hash), 14)
                call SetUnitAnimationByIndex(LoadUnitHandle(h, id, Clone1Hash), 12)
                call SetUnitAnimationByIndex(LoadUnitHandle(h, id, Clone2Hash), 12)
            else
                call SetUnitAnimationByIndex(LoadUnitHandle(h, id, Clone0Hash), 3)
                call SetUnitAnimationByIndex(LoadUnitHandle(h, id, Clone1Hash), 1)
                call SetUnitAnimationByIndex(LoadUnitHandle(h, id, Clone2Hash), 1)
            endif
            set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM04', GetUnitX(LoadUnitHandle(h, id, Clone0Hash)), GetUnitY(LoadUnitHandle(h, id, Clone0Hash)), angle * bj_RADTODEG)
            call SetUnitFlyHeight(n, 150, 0)
            call SetUnitScale(n, 0.8, 0.8, 0.8)
            call MyRemoveUnit(n , 1.5)
            set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM11', GetUnitX(LoadUnitHandle(h, id, Clone0Hash)), GetUnitY(LoadUnitHandle(h, id, Clone0Hash)), angle * bj_RADTODEG)
            call SetUnitFlyHeight(n, 150, 0)
            call MyRemoveUnit(n , 1.5)
            set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM30', GetUnitX(LoadUnitHandle(h, id, Clone0Hash)), GetUnitY(LoadUnitHandle(h, id, Clone0Hash)), angle * bj_RADTODEG)
            call SetUnitScale(n, 0.85, 0.85, 0.85)
            call SetUnitVertexColor(n, 255, 255, 255, 200)
            call MyRemoveUnit(n , 1.5)
            call SaveReal(h, id, TIME_HASH, LoadReal(h, id, TIME_HASH) + 0.01)
        else
            call SaveReal(h, id, TIME_HASH, LoadReal(h, id, TIME_HASH) + 0.01)
        endif
    else
        set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM30', GetUnitX(LoadUnitHandle(h, id, Clone0Hash)), GetUnitY(LoadUnitHandle(h, id, Clone0Hash)), angle * bj_RADTODEG)
        call SetUnitScale(bjLCU, 0.85, 0.85, 0.85)
        call SetUnitVertexColor(bjLCU, 255, 255, 255, 200)
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM08', GetUnitX(LoadUnitHandle(h, id, Clone0Hash)), GetUnitY(LoadUnitHandle(h, id, Clone0Hash)), angle * bj_RADTODEG)
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM08', GetUnitX(LoadUnitHandle(h, id, Clone1Hash)), GetUnitY(LoadUnitHandle(h, id, Clone1Hash)), angle * bj_RADTODEG)
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM08', GetUnitX(LoadUnitHandle(h, id, Clone2Hash)), GetUnitY(LoadUnitHandle(h, id, Clone2Hash)), angle * bj_RADTODEG)
        call MyRemoveUnit(bjLCU , 1.5)
        call RemoveUnit(LoadUnitHandle(h, id, Clone0Hash))
        call RemoveUnit(LoadUnitHandle(h, id, Clone1Hash))
        call RemoveUnit(LoadUnitHandle(h, id, Clone2Hash))
        call DestroyEffect(LoadEffectHandle(h, id, Effect1Hash))
        call DestroyEffect(LoadEffectHandle(h, id, Effect2Hash))
        call DestroyGroup(LoadGroupHandle(h, id, SH_Group1))
        call DestroyGroup(LoadGroupHandle(h, id, SH_Group2))
        call PauseUnit(LoadUnitHandle(h, id, CasterHash), false)
        call SetUnitInvulnerable(LoadUnitHandle(h, id, CasterHash), false)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
endfunction

function MinatoT_Cast takes unit newCaster,real point_x,real point_y,timer newTimer returns nothing
    local integer id=GetHandleId(newTimer)
    local real caster_x=GetUnitX(newCaster)
    local real caster_y=GetUnitY(newCaster)
    local real angle=AtanPoint(caster_x , caster_y , point_x , point_y)
    local real hybrid_angle=angle
    
    set soundplay=SndN(3424) // Sound\war3mapImported\MinatoT_Sound1.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set soundplay=SndN(3426) // Sound\war3mapImported\MinatoT_Voice1.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM39', caster_x + 150 * Cos(hybrid_angle), caster_y + 150 * Sin(hybrid_angle), angle * bj_RADTODEG)
    call SetUnitFlyHeight(n, 0, 0)
    if LoadBoolean(h, GetHandleId(newCaster), SH_MinatoR_Mod) then
        call SetUnitAnimationByIndex(n, 11)
    endif
    call SaveEffectHandle(h, id, Effect1Hash, AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Rejuvenation\\RejuvenationTarget.mdl", newCaster, "chest"))
    call SaveEffectHandle(h, id, Effect2Hash, AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Rejuvenation\\RejuvenationTarget.mdl", newCaster, "hand right"))
    call SaveUnitHandle(h, id, Clone0Hash, n)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM38', caster_x + 150 * Cos(hybrid_angle), caster_y + 150 * Sin(hybrid_angle), angle * bj_RADTODEG)
    call MyRemoveUnit(n , 1.5)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM08', caster_x + 150 * Cos(hybrid_angle), caster_y + 150 * Sin(hybrid_angle), GetRandomInt(0, 360))
    call MyRemoveUnit(n , 1.5)
    
    set hybrid_angle=angle - 90 * bj_DEGTORAD
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM39', caster_x + 150 * Cos(hybrid_angle), caster_y + 150 * Sin(hybrid_angle), angle * bj_RADTODEG)
    call SetUnitFlyHeight(n, 0, 0)
    if LoadBoolean(h, GetHandleId(newCaster), SH_MinatoR_Mod) then
        call SetUnitAnimationByIndex(n, 11)
    endif
    call SaveUnitHandle(h, id, Clone1Hash, n)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM38', caster_x + 150 * Cos(hybrid_angle), caster_y + 150 * Sin(hybrid_angle), angle * bj_RADTODEG)
    call MyRemoveUnit(n , 1.5)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM08', caster_x + 150 * Cos(hybrid_angle), caster_y + 150 * Sin(hybrid_angle), GetRandomInt(0, 360))
    call MyRemoveUnit(n , 1.5)
    
    set hybrid_angle=angle + 90 * bj_DEGTORAD
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM39', caster_x + 150 * Cos(hybrid_angle), caster_y + 150 * Sin(hybrid_angle), angle * bj_RADTODEG)
    call SetUnitFlyHeight(n, 0, 0)
    if LoadBoolean(h, GetHandleId(newCaster), SH_MinatoR_Mod) then
        call SetUnitAnimationByIndex(n, 11)
    endif
    call SaveUnitHandle(h, id, Clone2Hash, n)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM38', caster_x + 150 * Cos(hybrid_angle), caster_y + 150 * Sin(hybrid_angle), angle * bj_RADTODEG)
    call MyRemoveUnit(n , 1.5)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM08', caster_x + 150 * Cos(hybrid_angle), caster_y + 150 * Sin(hybrid_angle), GetRandomInt(0, 360))
    call MyRemoveUnit(n , 1.5)
    
    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call SaveReal(h, id, AngleHash, angle)
    call SaveGroupHandle(h, id, SH_Group1, CreateGroup())
    call SaveGroupHandle(h, id, SH_Group2, CreateGroup())
    call TimerStart(newTimer, 0.01, true, function MinatoT_Periodic)
endfunction

function Trig_MinatoInt_Actions takes nothing returns nothing
    if GetSpellAbilityId() == 'MiD1' then
        call MinatoD1_Cast(GetSpellAbilityUnit() , GetSpellTargetUnit() , CreateTimer())
    endif
    if GetSpellAbilityId() == 'MiD2' then
        if GetSpellTargetUnit() == null then
            call MinatoD2_Cast(GetSpellAbilityUnit() , null , GetSpellTargetX() , GetSpellTargetY() , CreateTimer())
        else
            call MinatoD2_Cast(GetSpellAbilityUnit() , GetSpellTargetUnit() , GetUnitX(GetSpellTargetUnit()) , GetUnitY(GetSpellTargetUnit()) , CreateTimer())
        endif
    endif
    if GetSpellAbilityId() == 'MiQ1' then
        call MinatoQ1_Cast(GetSpellAbilityUnit() , GetSpellTargetX() , GetSpellTargetY() , CreateTimer())
    endif
    if GetSpellAbilityId() == 'MiQ2' then
        call SaveBoolean(h, GetHandleId(GetSpellAbilityUnit()), SH_MinatoQ_Blink, true)
    endif
    if GetSpellAbilityId() == 'MiQ3' then
        call MinatoQ3_Cast(GetSpellAbilityUnit() , null , CreateTimer())
    endif
    if GetSpellAbilityId() == 'MiQ4' then
        call MinatoQR_Cast(GetSpellAbilityUnit() , GetSpellTargetX() , GetSpellTargetY())
    endif
    if GetSpellAbilityId() == 'MinW' then
        call MinatoW_Cast(GetSpellAbilityUnit() , CreateTimer())
    endif
    if GetSpellAbilityId() == 'MiE1' then
        call MinatoE_Cast(GetSpellAbilityUnit() , GetSpellTargetUnit() , CreateTimer())
    endif
    if GetSpellAbilityId() == 'MiR1' then
        call MinatoR_Cast(GetSpellAbilityUnit() , CreateTimer())
    endif
    if GetSpellAbilityId() == 'MiT1' then
        call MinatoT_Cast(GetSpellAbilityUnit() , GetSpellTargetX() , GetSpellTargetY() , CreateTimer())
    endif
endfunction



//===========================================================================
function InitTrig_MinatoInt takes nothing returns nothing
    local trigger trig= CreateTrigger()
    local integer index= 0
    loop
        call TriggerRegisterPlayerUnitEvent(trig, Player(index), EVENT_PLAYER_UNIT_SPELL_EFFECT, null)
        set index=index + 1
        exitwhen index == bj_MAX_PLAYER_SLOTS
    endloop
    call TriggerAddAction(trig, function Trig_MinatoInt_Actions)
    set trig=null
endfunction

//===========================================================================
// Global Click, для отлова кликов
//===========================================================================


function StopTarget_Action takes nothing returns nothing
        local integer id=GetHandleId(GetExpiredTimer())
        call IssueImmediateOrder(LoadUnitHandle(h,id,0), "stop")
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
endfunction

function ClobalClick_Action takes nothing returns nothing
        local unit triggerUnit=GetTriggerUnit()
        local unit targetUnit=GetOrderTargetUnit()
    if GetUnitTypeId(triggerUnit)=='HMin' and GetOrderTargetUnit()==null then
		if GetUnitCurrentOrder(triggerUnit)==851971 and GetWidgetMana(triggerUnit)>=GetWidgetMaxMana(triggerUnit)*0.05 and GetUnitAbilityLevel(triggerUnit,'CBC2')==0 and GetUnitAbilityLevel(triggerUnit,'cbc3')==0 and GetUnitAbilityLevel(triggerUnit,'cbc5')==0 and GetUnitAbilityLevel(triggerUnit,'cbc6')==0  and GetUnitAbilityLevel(triggerUnit, 'cbc7')==0 and GetUnitAbilityLevel(triggerUnit, 'cbc8')==0 and GetUnitAbilityLevel(triggerUnit, 'cbc9')==0 then
			set bjLCG=CreateGroup()
			call GroupEnumUnitsInRange(bjLCG, GetOrderPointX(), GetOrderPointY(), 200, null)
			loop
			set E=FirstOfGroup(bjLCG)
			exitwhen E==null
				if GetUnitTypeId(E)=='dM02' and UnitIsAlive(E) then
					if SquareRootUnit(triggerUnit, E)<2500 then
						call SetWidgetMana(triggerUnit , GetWidgetMana(triggerUnit) - GetWidgetMaxMana(triggerUnit) * 0.05)
						set n=CreateUnit(GetOwningPlayer(triggerUnit), 'dM08', GetUnitX(triggerUnit), GetUnitY(triggerUnit), GetRandomInt(0, 360))
						call MyRemoveUnit(n, 1.5)
						set n=CreateUnit(GetOwningPlayer(triggerUnit), 'dM09', GetUnitX(triggerUnit), GetUnitY(triggerUnit), GetRandomInt(0, 360))
						call MyRemoveUnit(n, 1.5)
						call SetUnitX(triggerUnit, GetUnitX(E))
						call SetUnitY(triggerUnit, GetUnitY(E))
						set soundplay=SndN(3392) // Sound\war3mapImported\Minato_Hiraishin_Sound.mp3
						call StartSound(soundplay)
						//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
						if LoadBoolean(h, GetHandleId(triggerUnit), SH_MinatoR_Mod) then
							if GetAbilityRemainingCooldown(GetUnitAbility(triggerUnit, 'MiQ4')) > 0.1 then
								call StartAbilityCooldown(GetUnitAbility(triggerUnit, 'MiQ4' ), 0.1)
							endif
						else
							if GetAbilityRemainingCooldown(GetUnitAbility(triggerUnit, 'MiQ1')) > 0.1 then
								call StartAbilityCooldown(GetUnitAbility(triggerUnit, 'MiQ1' ), 0.1)
							endif
						endif
						set n=CreateUnit(GetOwningPlayer(triggerUnit), 'dM08', GetUnitX(triggerUnit), GetUnitY(triggerUnit), GetRandomInt(0, 360))
						call MyRemoveUnit(n, 1.5)
						set n=CreateUnit(GetOwningPlayer(triggerUnit), 'dM09', GetUnitX(triggerUnit), GetUnitY(triggerUnit), GetRandomInt(0, 360))
						call MyRemoveUnit(n, 1.5)
						call KillUnit(E)
						call MyRemoveUnit(E, 1.0)
						call GroupClear(bjLCG)
					else
						call DisplayTimedTextToPlayer(GetOwningPlayer(triggerUnit), 0, 0, 3, Lng("Дистанция: ","Distance:") + R2S(SquareRootUnit(triggerUnit, E)))
					endif
				endif
			call GroupRemoveUnit(bjLCG, E)
			endloop
			call DestroyGroup(bjLCG)
		endif
	endif
	
	if targetUnit!=null and GetUnitAbilityLevel(targetUnit, 'AP02')>0 and FilterA(targetUnit, triggerUnit)==false then
		set bjLCT=CreateTimer()
		call SaveUnitHandle(h, GetHandleId(bjLCT), 0, triggerUnit)
		call TimerStart(bjLCT, 0.0, false, function StopTarget_Action)
		call IssueImmediateOrder(triggerUnit,"stop")
	endif
	
	// if GetUnitAbilityLevel(triggerUnit, 'AP04')>0 and targetUnit==null and GetUnitAbilityLevel(triggerUnit, 'IMDc')==0 then
	// 	call VergilD_Tricker(triggerUnit, GetOrderPointX(), GetOrderPointY())
	// endif
	
    if GetUnitTypeId(triggerUnit)=='HKar' and GetOrderTargetUnit()==null then
        set n = LoadUnitHandle(HH, GetHandleId(triggerUnit), KarnaT_Circle)
        if n!=null then
            call IssueImmediateOrder(n, "stop")
            call IssuePointOrder(n, "move", GetOrderPointX(), GetOrderPointY())
        endif
    endif
        set triggerUnit=null
        set targetUnit=null
endfunction

//===========================================================================
function InitTrig_GlobalClick takes nothing returns nothing
        local trigger trig= CreateTrigger()
    local integer index= 0
    loop
        call TriggerRegisterPlayerUnitEvent(trig, Player(index), EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER, null)
        call TriggerRegisterPlayerUnitEvent(trig, Player(index), EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER, null)
        set index=index + 1
        exitwhen index == bj_MAX_PLAYER_SLOTS
    endloop
    call TriggerAddAction(trig, function ClobalClick_Action)
endfunction

//===========================================================================
// Trigger: MadokaInt
//===========================================================================


function Calculate_MadokaWHeal takes unit newCaster,unit newTarget returns real
    local real heal=GetWidgetMaxLife(newCaster) * 0.05 + ( 0.03 + 0.02 * GetUnitAbilityLevel(newCaster, 'MadW') ) * GetWidgetMaxLife(newTarget)
    return heal
endfunction


function MadokaD_UseStacks takes unit newCaster,real ratio returns real
    local real r_ratio=0.0
    if GetUnitAbilityLevel(newCaster, 'MaDu') > 0 then
        set r_ratio=ratio * GetUnitAbilityLevel(newCaster, 'MaDu')
        call SetUnitAbilityLevel(newCaster, 'MaDs', GetUnitAbilityLevel(newCaster, 'MaDs') - GetUnitAbilityLevel(newCaster, 'MaDu'))
        call UnitRemoveAbility(newCaster, 'MaDu')
        call UnitRemoveAbility(newCaster, 'MaDb')
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dM76', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
        call MyRemoveUnit(n , 2)
    endif
    return r_ratio
endfunction

function MadokaD_Cast takes unit newCaster returns nothing
    if GetUnitAbilityLevel(newCaster, 'MaDs') > 1 then
        if GetUnitAbilityLevel(newCaster, 'MaDu') == 0 then
            call UnitAddAbility(newCaster, 'MaDu')
        else
            if ( GetUnitAbilityLevel(newCaster, 'MaDs') - 1 ) > GetUnitAbilityLevel(newCaster, 'MaDu') then
                call UnitRemoveAbility(newCaster, 'MaDb')
                call SetUnitAbilityLevel(newCaster, 'MaDu', GetUnitAbilityLevel(newCaster, 'MaDu') + 1)
            elseif GetUnitAbilityLevel(newCaster, 'MaDu')>1 then
                call DisplayTimedTextToPlayer(GetOwningPlayer(newCaster), 0, 0, 3, "|c00FF80C0There are no soul fragments!|r")
            endif
        endif
    else
        call DisplayTimedTextToPlayer(GetOwningPlayer(newCaster), 0, 0, 3, "|c00FF80C0There are no soul fragments!|r")
    endif
endfunction

function MadokaQ1_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local unit caster=LoadUnitHandle(h, id, CasterHash)
    local unit arrow=LoadUnitHandle(h, id, Dummy1Hash)
    local unit target=null
    local real time=LoadReal(h, id, TIME_HASH)
    local real distance=LoadReal(h, id, SH_Distance)
    local real angle=LoadReal(h, id, AngleHash)
    local real damage=LoadReal(h, id, SH_Damage)
    local integer act=LoadInteger(h, id, SH_Act)
    local boolean bool_heal=LoadBoolean(h, id, SH_HealBoolean)
    if act < 3 then
        if act == 0 then
            if time < 0.5 then
                call PauseUnit(caster, true)
                call SetUnitInvulnerable(caster, true)
                call SetUnitX(arrow, GetUnitX(caster))
                call SetUnitY(arrow, GetUnitY(caster))
                call SaveReal(h, id, TIME_HASH, time + 0.01)
                if LoadInteger(h, id, EffectPeriodHash) <= 0 then
                    set n=CreateUnit(GetOwningPlayer(caster), 'dM42', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
                    call SetUnitScale(n, 1.2 - time * 0.85, 1.2 - time * 0.85, 1.2 - time * 0.85)
                    call SetUnitVertexColor(n, 255, 150, 150, 160)
                    call MyRemoveUnit(n , 1.5)
                    call SaveInteger(h, id, EffectPeriodHash, 14)
                else
                    call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash) - 1)
                endif
            else
                call ShakeCamera(0.2 , 10)
                call PauseUnit(caster, false)
                call SetUnitInvulnerable(caster, false)
                if GetUnitTypeId(caster) == 'HMaG' then
                    call SetUnitAnimationByIndex(caster, 10)
                endif
                call SaveInteger(h, id, SH_Act, 1)
                call SaveInteger(h, id, EffectPeriodHash, 0)
                set n=CreateUnit(GetOwningPlayer(caster), 'dM04', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
                call SetUnitTimeScale(n, 0.5)
                call SetUnitVertexColor(n, 255, 255, 255, 180)
                call MyRemoveUnit(n , 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'dM11', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
                call SetUnitFlyHeight(n, 150, 0)
                call SetUnitTimeScale(n, 0.85)
                call MyRemoveUnit(n , 1.5)
                set soundplay=SndN(3428) // Sound\war3mapImported\Madoka_LaunchArrow1.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            endif
        endif
        if act == 1 then
            if distance < 4000 then
                call SetUnitX(arrow, GetUnitX(arrow) + 50 * Cos(angle))
                call SetUnitY(arrow, GetUnitY(arrow) + 50 * Sin(angle))
                call SaveReal(h, id, SH_Distance, distance + 50)
                set bjLCG=LoadGroupHandle(h, id, GroupHash)
                call GroupEnumUnitsInRange(bjLCG, GetUnitX(arrow), GetUnitY(arrow), 125, Base)
                loop
                set E=FirstOfGroup(bjLCG)
                exitwhen E == null
                    if Condition_Base(GetOwningPlayer(caster) , E) then
                        if LoadReal(h, id, SH_Dop_Damage) > 0.0 then
                            set damage=damage + damage * LoadReal(h, id, SH_Dop_Damage)
                            set n=CreateUnit(GetOwningPlayer(caster), 'dM55', GetUnitX(E), GetUnitY(E), GetRandomInt(0, 360))
                            call SetUnitScale(n, 1 + LoadReal(h, id, SH_Dop_Damage) / 2, 1 + LoadReal(h, id, SH_Dop_Damage) / 2, 1 + LoadReal(h, id, SH_Dop_Damage) / 2)
                            call MyRemoveUnit(n , 3)
                            if LoadReal(h, id, SH_Dop_Damage) > 1.0 then
                                set n=CreateUnit(GetOwningPlayer(caster), 'dM75', GetUnitX(E), GetUnitY(E), GetRandomInt(0, 360))
                                call SetUnitScale(n, 0.5 + LoadReal(h, id, SH_Dop_Damage) / 2, 0.5 + LoadReal(h, id, SH_Dop_Damage) / 2, 0.5 + LoadReal(h, id, SH_Dop_Damage) / 2)
                                call MyRemoveUnit(n , 3)
                            endif
                        endif
                        //call myCustomDamage(caster , E , damage - damage * ( ( distance / 4000 ) * 0.3 ) , false , false , null , null , null)
                                                call myCustomDamage(caster , E , damage , false , false , null , null , null)
                        call SetControlToUnit(caster , E , 1.5 , "stun")
                        call GroupClear(bjLCG)
                        call SaveInteger(h, id, SH_Act, 2)
                        call SaveUnitHandle(h, id, TargetHash, E)
                        call SaveReal(h, id, SH_Distance, ( 4000 - distance ) / 4 + 300)
                        call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl", E, "chest"))
                        set n=CreateUnit(GetOwningPlayer(caster), 'dM43', GetUnitX(E), GetUnitY(E), GetRandomInt(0, 360))
                        call SetUnitFlyHeight(n, 150, 0)
                        call MyRemoveUnit(n , 3)
                    elseif IsUnitInGroup(E, LoadGroupHandle(h, id, SH_Group2)) == false and E != caster and bool_heal then
                        call HealTextTag(caster,E,  0.7*Calculate_MadokaWHeal(caster , E)*myCustomHeal2(E,1),"HealthRes")
                        call SetWidgetLife(E, GetWidgetLife(E) + Calculate_MadokaWHeal(caster , E) * 0.7)
                        call GroupAddUnit(LoadGroupHandle(h, id, SH_Group2), E)
                    endif
                    call GroupRemoveUnit(bjLCG, E)
                endloop
                if LoadInteger(h, id, EffectPeriodHash) <= 0 then
                    set n=CreateUnit(GetOwningPlayer(caster), 'dM11', GetUnitX(arrow), GetUnitY(arrow), angle * bj_RADTODEG)
                    call SetUnitScale(n, 0.25, 0.25, 0.25)
                    call SetUnitVertexColor(n, 255, 150, 150, 250)
                    call SetUnitTimeScale(n, 0.65)
                    call MyRemoveUnit(n , 1.5)
                    call SaveInteger(h, id, EffectPeriodHash, 3)
                else
                    call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash) - 1)
                endif
            else
                call SaveInteger(h, id, SH_Act, 3)
            endif
        endif
        if act == 2 then
            set target=LoadUnitHandle(h, id, TargetHash)
            if distance > 0 then
                call SetUnitX(arrow, GetUnitX(arrow) + 30 * Cos(angle))
                call SetUnitY(arrow, GetUnitY(arrow) + 30 * Sin(angle))
                call SetUnitX(target, GetUnitX(target) + 30 * Cos(angle))
                call SetUnitY(target, GetUnitY(target) + 30 * Sin(angle))
                call SaveReal(h, id, SH_Distance, distance - 30)
                if LoadInteger(h, id, EffectPeriodHash) <= 0 then
                    set n=CreateUnit(GetOwningPlayer(caster), 'dM29', GetUnitX(arrow), GetUnitY(arrow), angle * bj_RADTODEG)
                    call MyRemoveUnit(n , 1.5)
                    call SaveInteger(h, id, EffectPeriodHash, 4)
                else
                    call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash) - 1)
                endif
            else
                call SaveInteger(h, id, SH_Act, 3)
            endif
        endif
    else
        call KillUnit(arrow)
        call MyRemoveUnit(arrow , 1.0)
        call GroupClear(LoadGroupHandle(h, id, GroupHash))
        call GroupClear(LoadGroupHandle(h, id, SH_Group2))
        call DestroyGroup(LoadGroupHandle(h, id, GroupHash))
        call DestroyGroup(LoadGroupHandle(h, id, SH_Group2))
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
    set arrow=null
    set target=null
endfunction


function MadokaQ1_Cast takes unit newCaster,real point_x,real point_y,timer newTimer returns nothing
    local integer id=GetHandleId(newTimer)
    local real caster_x=GetUnitX(newCaster)
    local real caster_y=GetUnitY(newCaster)
    local real angle=AP(caster_x , caster_y , point_x , point_y)
    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, 9)
    if LoadBoolean(h, GetHandleId(newCaster), SH_MadokaW) then
        call SaveBoolean(h, id, SH_HealBoolean, true)
    endif
    set soundplay=SndN(3431) // Sound\war3mapImported\Madoka_Charging.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM30', caster_x, caster_y, GetRandomInt(0, 360))
    call MyRemoveUnit(n , 1.0)
    
    call DestroyEffect(AddSpecialEffectTarget("yx_xiaoyuanxuli2.mdl", newCaster, "weapon"))
    if GetUnitTypeId(newCaster) == 'HMad' then // Madoka Default
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dM41', caster_x, caster_y, angle * bj_RADTODEG)
        call SaveUnitHandle(h, id, Dummy1Hash, n)
    else
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dM63', caster_x, caster_y, angle * bj_RADTODEG)
        call SaveUnitHandle(h, id, Dummy1Hash, n)
    endif
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call SaveReal(h, id, AngleHash, angle)
    call SaveReal(h, id, SH_Damage, GetHeroInt(newCaster, true) * ( 3 + GetUnitAbilityLevel(newCaster, 'MaQ1') ))
    call SaveReal(h, id, SH_Dop_Damage, MadokaD_UseStacks(newCaster , 0.35))
    call SaveGroupHandle(h, id, GroupHash, CreateGroup())
    call SaveGroupHandle(h, id, SH_Group2, CreateGroup())
    call TimerStart(newTimer, 0.01, true, function MadokaQ1_Periodic)
endfunction


function MadokaQ2_SinglePeriodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local unit caster=LoadUnitHandle(h, id, CasterHash)
    local unit arrow=LoadUnitHandle(h, id, Dummy1Hash)
    local unit target=null
    local real time=LoadReal(h, id, TIME_HASH)
    local real distance=LoadReal(h, id, SH_Distance)
    local real angle=LoadReal(h, id, AngleHash)
    local real damage=LoadReal(h, id, SH_Damage)
    local integer act=LoadInteger(h, id, SH_Act)
    local boolean bool_heal=LoadBoolean(h, id, SH_HealBoolean)
    if act < 3 then
        if act == 1 then
            if distance < 1500 then
                call SetUnitX(arrow, GetUnitX(arrow) + 50 * Cos(angle))
                call SetUnitY(arrow, GetUnitY(arrow) + 50 * Sin(angle))
                call SaveReal(h, id, SH_Distance, distance + 50)
                set bjLCG=LoadGroupHandle(h, id, GroupHash)
                call GroupEnumUnitsInRange(bjLCG, GetUnitX(arrow), GetUnitY(arrow), 125, Base)
                loop
                set E=FirstOfGroup(bjLCG)
                exitwhen E == null
                    if Condition_Base(GetOwningPlayer(caster) , E) then
                        if LoadReal(h, id, SH_Dop_Damage) > 0.0 then
                            set damage=damage + damage * LoadReal(h, id, SH_Dop_Damage)
                            set n=CreateUnit(GetOwningPlayer(caster), 'dM55', GetUnitX(E), GetUnitY(E), GetRandomInt(0, 360))
                            call SetUnitScale(n, 1 + LoadReal(h, id, SH_Dop_Damage) / 2, 1 + LoadReal(h, id, SH_Dop_Damage) / 2, 1 + LoadReal(h, id, SH_Dop_Damage) / 2)
                            call MyRemoveUnit(n , 3)
                            if LoadReal(h, id, SH_Dop_Damage) > 1.0 then
                                set n=CreateUnit(GetOwningPlayer(caster), 'dM75', GetUnitX(E), GetUnitY(E), GetRandomInt(0, 360))
                                call SetUnitScale(n, 0.5 + LoadReal(h, id, SH_Dop_Damage) / 2, 0.5 + LoadReal(h, id, SH_Dop_Damage) / 2, 0.5 + LoadReal(h, id, SH_Dop_Damage) / 2)
                                call MyRemoveUnit(n , 3)
                            endif
                        endif
                        call GroupClear(bjLCG)
                        call SaveInteger(h, id, SH_Act, 2)
                        call SaveUnitHandle(h, id, TargetHash, E)
                                                if GetUnitAbilityLevel(E, 'MaQ4')==0 then
                                                        call UnitAddAbility(E, 'MaQ4')
                                                        //call myCustomDamage(caster , E , damage - damage * ( ( distance / 4000 ) * 0.3 ) , false , false , null , null , null)
                                                        call myCustomDamage(caster , E , damage , false , false , null , null , null)
                                                        call SaveReal(h, id, SH_Distance, ( 4000 - distance ) / 4 + 300)
                                                else
                                                        call myCustomDamage(caster, E, damage*0.3, false, false, null, null, null)
                                                        call SaveReal(h, id, SH_Distance, 100)
                                                endif
                        call SetControlToUnit(caster , E , 1.5 , "stun")
                        call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl", E, "chest"))
                        set n=CreateUnit(GetOwningPlayer(caster), 'dM43', GetUnitX(E), GetUnitY(E), GetRandomInt(0, 360))
                        call SetUnitFlyHeight(n, 150, 0)
                        call MyRemoveUnit(n , 3)
                    elseif IsUnitInGroup(E, LoadGroupHandle(h, id, SH_Group2)) == false and E != caster and bool_heal then
                        call HealTextTag(caster,E,  0.3*Calculate_MadokaWHeal(caster , E)*myCustomHeal2(E,1),"HealthRes")
                        call SetWidgetLife(E, GetWidgetLife(E) + Calculate_MadokaWHeal(caster , E) * 0.3)
                        call GroupAddUnit(LoadGroupHandle(h, id, SH_Group2), E)
                    endif
                    call GroupRemoveUnit(bjLCG, E)
                endloop
                if LoadInteger(h, id, EffectPeriodHash) <= 0 then
                    set n=CreateUnit(GetOwningPlayer(caster), 'dM11', GetUnitX(arrow), GetUnitY(arrow), angle * bj_RADTODEG)
                    call SetUnitScale(n, 0.25, 0.25, 0.25)
                    call SetUnitVertexColor(n, 255, 150, 150, 250)
                    call SetUnitTimeScale(n, 0.65)
                    call MyRemoveUnit(n , 1.5)
                    call SaveInteger(h, id, EffectPeriodHash, 3)
                else
                    call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash) - 1)
                endif
            else
                call SaveInteger(h, id, SH_Act, 3)
            endif
        endif
        if act == 2 then
            set target=LoadUnitHandle(h, id, TargetHash)
            if distance > 0 then
                call SetUnitX(arrow, GetUnitX(arrow) + 30 * Cos(angle))
                call SetUnitY(arrow, GetUnitY(arrow) + 30 * Sin(angle))
                call SetUnitX(target, GetUnitX(target) + 30 * Cos(angle))
                call SetUnitY(target, GetUnitY(target) + 30 * Sin(angle))
                call SaveReal(h, id, SH_Distance, distance - 30)
                if LoadInteger(h, id, EffectPeriodHash) <= 0 then
                    set n=CreateUnit(GetOwningPlayer(caster), 'dM29', GetUnitX(arrow), GetUnitY(arrow), angle * bj_RADTODEG)
                    call MyRemoveUnit(n , 1.5)
                    call SaveInteger(h, id, EffectPeriodHash, 4)
                else
                    call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash) - 1)
                endif
            else
                call UnitRemoveAbility(target, 'MaQ4')
                call SaveInteger(h, id, SH_Act, 3)
            endif
        endif
    else
        call KillUnit(arrow)
        call MyRemoveUnit(arrow , 1.0)
        call GroupClear(LoadGroupHandle(h, id, GroupHash))
        call GroupClear(LoadGroupHandle(h, id, SH_Group2))
        call DestroyGroup(LoadGroupHandle(h, id, GroupHash))
        call DestroyGroup(LoadGroupHandle(h, id, SH_Group2))
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
    set arrow=null
    set target=null
endfunction


function MadokaQ2_Single takes unit newCaster,unit newArrow,boolean bool_heal, real dop_damage, timer newTimer returns nothing
    local integer id=GetHandleId(newTimer)
    local real angle=GetUnitFacing(newArrow) * bj_DEGTORAD
    call SaveBoolean(h, id, SH_HealBoolean, bool_heal)
    call SaveUnitHandle(h, id, Dummy1Hash, newArrow)
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call SaveReal(h, id, AngleHash, angle)
    call SaveInteger(h, id, SH_Act, 1)
    call SaveReal(h, id, SH_Damage, GetHeroInt(newCaster, true) * ( 5 + GetUnitAbilityLevel(newCaster, 'MaQ1') ))
    call SaveReal(h, id, SH_Dop_Damage, dop_damage)
    call SaveGroupHandle(h, id, GroupHash, CreateGroup())
    call SaveGroupHandle(h, id, SH_Group2, CreateGroup())
    call TimerStart(newTimer, 0.01, true, function MadokaQ2_SinglePeriodic)
endfunction

function MadokaQ2_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local unit caster=LoadUnitHandle(h, id, CasterHash)
    local real time=LoadReal(h, id, TIME_HASH)
    local real angle=LoadReal(h, id, AngleHash)
    local real dinam_angle=angle
    local boolean bool_heal=LoadBoolean(h, id, SH_HealBoolean)
    if time < 0.5 then
        call PauseUnit(caster, true)
        call SetUnitInvulnerable(caster, true)
        set n=LoadUnitHandle(h, id, Dummy1Hash)
        call SetUnitX(n, GetUnitX(caster) + 35 * Cos(dinam_angle))
        call SetUnitY(n, GetUnitY(caster) + 35 * Sin(dinam_angle))
        call SetUnitFacing(n, dinam_angle * bj_RADTODEG)
        set dinam_angle=angle + 30 * bj_DEGTORAD
        set n=LoadUnitHandle(h, id, Dummy2Hash)
        call SetUnitX(n, GetUnitX(caster) + 35 * Cos(dinam_angle))
        call SetUnitY(n, GetUnitY(caster) + 35 * Sin(dinam_angle))
        call SetUnitFacing(n, dinam_angle * bj_RADTODEG)
        set dinam_angle=angle + 60 * bj_DEGTORAD
        set n=LoadUnitHandle(h, id, SH_Dummy3)
        call SetUnitX(n, GetUnitX(caster) + 35 * Cos(dinam_angle))
        call SetUnitY(n, GetUnitY(caster) + 35 * Sin(dinam_angle))
        call SetUnitFacing(n, dinam_angle * bj_RADTODEG)
        set dinam_angle=angle - 30 * bj_DEGTORAD
        set n=LoadUnitHandle(h, id, SH_Dummy4)
        call SetUnitX(n, GetUnitX(caster) + 35 * Cos(dinam_angle))
        call SetUnitY(n, GetUnitY(caster) + 35 * Sin(dinam_angle))
        call SetUnitFacing(n, dinam_angle * bj_RADTODEG)
        set dinam_angle=angle - 60 * bj_DEGTORAD
        set n=LoadUnitHandle(h, id, SH_Dummy5)
        call SetUnitX(n, GetUnitX(caster) + 35 * Cos(dinam_angle))
        call SetUnitY(n, GetUnitY(caster) + 35 * Sin(dinam_angle))
        call SetUnitFacing(n, dinam_angle * bj_RADTODEG)
        call SaveReal(h, id, TIME_HASH, time + 0.01)
        if LoadInteger(h, id, EffectPeriodHash) <= 0 then
            set n=CreateUnit(GetOwningPlayer(caster), 'dM42', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
            call SetUnitScale(n, 1.2 - time * 0.85, 1.2 - time * 0.85, 1.2 - time * 0.85)
            call SetUnitVertexColor(n, 255, 150, 150, 160)
            call MyRemoveUnit(n , 1.5)
            call SaveInteger(h, id, EffectPeriodHash, 14)
        else
            call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash) - 1)
        endif
    else
        set soundplay=SndN(3433) // Sound\war3mapImported\MadokaQ2.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        call MadokaQ2_Single(caster , LoadUnitHandle(h, id, Dummy1Hash) , bool_heal , LoadReal(h,id,SH_Dop_Damage), CreateTimer())
        call MadokaQ2_Single(caster , LoadUnitHandle(h, id, Dummy2Hash) , bool_heal , LoadReal(h,id,SH_Dop_Damage), CreateTimer())
        call MadokaQ2_Single(caster , LoadUnitHandle(h, id, SH_Dummy3) , bool_heal , LoadReal(h,id,SH_Dop_Damage), CreateTimer())
        call MadokaQ2_Single(caster , LoadUnitHandle(h, id, SH_Dummy4) , bool_heal , LoadReal(h,id,SH_Dop_Damage), CreateTimer())
        call MadokaQ2_Single(caster , LoadUnitHandle(h, id, SH_Dummy5) , bool_heal , LoadReal(h,id,SH_Dop_Damage), CreateTimer())
        call ShakeCamera(0.2 , 10)
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        if GetUnitTypeId(caster) == 'HMaG' then
            call SetUnitAnimationByIndex(caster, 10)
        endif
        call SaveInteger(h, id, SH_Act, 1)
        call SaveInteger(h, id, EffectPeriodHash, 0)
        set n=CreateUnit(GetOwningPlayer(caster), 'dM04', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
        call SetUnitTimeScale(n, 0.5)
        call SetUnitVertexColor(n, 255, 255, 255, 180)
        call MyRemoveUnit(n , 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'dM11', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
        call SetUnitFlyHeight(n, 150, 0)
        call SetUnitTimeScale(n, 0.85)
        call MyRemoveUnit(n , 1.5)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
endfunction


function MadokaQ2_Cast takes unit newCaster,real point_x,real point_y,timer newTimer returns nothing
    local integer id=GetHandleId(newTimer)
    local real caster_x=GetUnitX(newCaster)
    local real caster_y=GetUnitY(newCaster)
    local real angle=AP(caster_x , caster_y , point_x , point_y)
    local real dinam_angle=angle
    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, 9)
    if LoadBoolean(h, GetHandleId(newCaster), SH_MadokaW) then
        call SaveBoolean(h, id, SH_HealBoolean, true)
    endif
    set soundplay=SndN(3431) // Sound\war3mapImported\Madoka_Charging.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM30', caster_x, caster_y, GetRandomInt(0, 360))
    call MyRemoveUnit(n , 1.0)
    
    call DestroyEffect(AddSpecialEffectTarget("yx_xiaoyuanxuli2.mdl", newCaster, "weapon"))
    if GetUnitTypeId(newCaster) == 'HMad' then
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dM41', caster_x + 35 * Cos(dinam_angle), caster_y + 35 * Sin(dinam_angle), dinam_angle * bj_RADTODEG)
        call SetUnitScale(n, 1, 1, 1)
    else
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dM63', caster_x + 35 * Cos(dinam_angle), caster_y + 35 * Sin(dinam_angle), dinam_angle * bj_RADTODEG)
        call SetUnitScale(n, 0.7, 0.7, 0.7)
    endif
    call SaveUnitHandle(h, id, Dummy1Hash, n)
    set dinam_angle=angle + 30 * bj_DEGTORAD
    if GetUnitTypeId(newCaster) == 'HMad' then
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dM41', caster_x + 35 * Cos(dinam_angle), caster_y + 35 * Sin(dinam_angle), dinam_angle * bj_RADTODEG)
        call SetUnitScale(n, 1, 1, 1)
    else
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dM63', caster_x + 35 * Cos(dinam_angle), caster_y + 35 * Sin(dinam_angle), dinam_angle * bj_RADTODEG)
        call SetUnitScale(n, 0.7, 0.7, 0.7)
    endif
    call SaveUnitHandle(h, id, Dummy2Hash, n)
    set dinam_angle=angle + 60 * bj_DEGTORAD
    if GetUnitTypeId(newCaster) == 'HMad' then
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dM41', caster_x + 35 * Cos(dinam_angle), caster_y + 35 * Sin(dinam_angle), dinam_angle * bj_RADTODEG)
        call SetUnitScale(n, 1, 1, 1)
    else
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dM63', caster_x + 35 * Cos(dinam_angle), caster_y + 35 * Sin(dinam_angle), dinam_angle * bj_RADTODEG)
        call SetUnitScale(n, 0.7, 0.7, 0.7)
    endif
    call SaveUnitHandle(h, id, SH_Dummy3, n)
    set dinam_angle=angle - 30 * bj_DEGTORAD
    if GetUnitTypeId(newCaster) == 'HMad' then
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dM41', caster_x + 35 * Cos(dinam_angle), caster_y + 35 * Sin(dinam_angle), dinam_angle * bj_RADTODEG)
        call SetUnitScale(n, 1, 1, 1)
    else
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dM63', caster_x + 35 * Cos(dinam_angle), caster_y + 35 * Sin(dinam_angle), dinam_angle * bj_RADTODEG)
        call SetUnitScale(n, 0.7, 0.7, 0.7)
    endif
    call SaveUnitHandle(h, id, SH_Dummy4, n)
    set dinam_angle=angle - 60 * bj_DEGTORAD
    if GetUnitTypeId(newCaster) == 'HMad' then
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dM41', caster_x + 35 * Cos(dinam_angle), caster_y + 35 * Sin(dinam_angle), dinam_angle * bj_RADTODEG)
        call SetUnitScale(n, 1, 1, 1)
    else
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dM63', caster_x + 35 * Cos(dinam_angle), caster_y + 35 * Sin(dinam_angle), dinam_angle * bj_RADTODEG)
        call SetUnitScale(n, 0.7, 0.7, 0.7)
    endif
    call SaveUnitHandle(h, id, SH_Dummy5, n)
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call SaveReal(h, id, AngleHash, angle)
        call SaveReal(h, id, SH_Dop_Damage, MadokaD_UseStacks(newCaster , 0.35))
    call SaveGroupHandle(h, id, GroupHash, CreateGroup())
    call SaveGroupHandle(h, id, SH_Group2, CreateGroup())
    call TimerStart(newTimer, 0.01, true, function MadokaQ2_Periodic)
endfunction



function MadokaQ3_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local unit caster=LoadUnitHandle(h, id, CasterHash)
    local unit arrow=LoadUnitHandle(h, id, Dummy1Hash)
    local real time=LoadReal(h, id, TIME_HASH)
    local real distance=LoadReal(h, id, SH_Distance)
    local real damage=LoadReal(h, id, SH_Damage)
    local real angle=AP(GetUnitX(arrow) , GetUnitY(arrow) , LoadReal(h, id, SH_Point_X) , LoadReal(h, id, SH_Point_Y))
    local integer act=LoadInteger(h, id, SH_Act)
    local boolean bool_heal=LoadBoolean(h, id, SH_HealBoolean)
    if act < 3 then
        if act == 0 then
            if time < 0.5 then
                call SetUnitFlyHeight(caster, time * 1120, 0)
                if GetUnitTypeId(caster) == 'HMaG' then
                    call SetUnitFlyHeight(arrow, GetUnitFlyHeight(caster) + 100, 0)
                else
                    call SetUnitFlyHeight(arrow, GetUnitFlyHeight(caster) + 50, 0)
                endif
                call PauseUnit(caster, true)
                call SetUnitInvulnerable(caster, true)
                call SetUnitX(caster, GetUnitX(caster) - 4 * Cos(angle))
                call SetUnitY(caster, GetUnitY(caster) - 4 * Sin(angle))
                call SetUnitX(arrow, GetUnitX(caster))
                call SetUnitY(arrow, GetUnitY(caster))
                call SaveReal(h, id, TIME_HASH, time + 0.01)
                if LoadInteger(h, id, EffectPeriodHash) <= 0 then
                    set n=CreateUnit(GetOwningPlayer(caster), 'dM42', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
                    call SetUnitScale(n, 1.2 - time * 0.85, 1.2 - time * 0.85, 1.2 - time * 0.85)
                    call SetUnitVertexColor(n, 255, 150, 150, 160)
                    call SetUnitFlyHeight(n, GetUnitFlyHeight(caster), 0)
                    call MyRemoveUnit(n , 1.5)
                    call SaveInteger(h, id, EffectPeriodHash, 14)
                else
                    call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash) - 1)
                endif
            else
                call SetUnitFlyHeight(caster, 0, 1000)
                call ShakeCamera(0.2 , 10)
                call PauseUnit(caster, false)
                call SetUnitInvulnerable(caster, false)
                if GetUnitTypeId(caster) == 'HMaG' then
                    call SetUnitAnimationByIndex(caster, 18)
                endif
                call Push_without_facing(caster , 35 , angle - 180 * bj_DEGTORAD , 400)
                call SaveInteger(h, id, SH_Act, 1)
                call SaveInteger(h, id, EffectPeriodHash, 0)
                set distance=SquareRootPoint(GetUnitX(arrow) , GetUnitY(arrow) , LoadReal(h, id, SH_Point_X) , LoadReal(h, id, SH_Point_Y))
                call SaveReal(h, id, SH_CurrentFall, GetUnitFlyHeight(arrow) / ( distance / 50 ))
                call SaveReal(h, id, SH_Distance, distance)
                
                set n=CreateUnit(GetOwningPlayer(caster), 'dM47', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
                call SetUnitTimeScale(n, 0.5)
                call SetUnitVertexColor(n, 255, 255, 255, 180)
                call SetUnitFlyHeight(n, GetUnitFlyHeight(arrow) + 40, 0)
                call MyRemoveUnit(n , 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'dM45', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
                call SetUnitFlyHeight(n, 150, 0)
                call SetUnitTimeScale(n, 0.85)
                call SetUnitFlyHeight(n, GetUnitFlyHeight(arrow) + 100, 0)
                call MyRemoveUnit(n , 1.5)
                set soundplay=SndN(3436) // Sound\war3mapImported\MadokaQ3.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            endif
        endif
        if act == 1 then
            if distance > 0 then
                call SetUnitX(arrow, GetUnitX(arrow) + 70 * Cos(angle))
                call SetUnitY(arrow, GetUnitY(arrow) + 70 * Sin(angle))
                call SetUnitFlyHeight(arrow, GetUnitFlyHeight(arrow) - LoadReal(h, id, SH_CurrentFall), 0)
                call SaveReal(h, id, SH_Distance, distance - 70)
                if LoadInteger(h, id, EffectPeriodHash) <= 0 then
                    set n=CreateUnit(GetOwningPlayer(caster), 'dM45', GetUnitX(arrow), GetUnitY(arrow), angle * bj_RADTODEG)
                    call SetUnitScale(n, 0.25, 0.25, 0.25)
                    call SetUnitVertexColor(n, 255, 150, 150, 250)
                    call SetUnitTimeScale(n, 0.65)
                    call SetUnitFlyHeight(n, GetUnitFlyHeight(arrow) + 100, 0)
                    call MyRemoveUnit(n , 1.5)
                    call SaveInteger(h, id, EffectPeriodHash, 3)
                else
                    call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash) - 1)
                endif
            else
                call SetUnitX(arrow, LoadReal(h, id, SH_Point_X))
                call SetUnitY(arrow, LoadReal(h, id, SH_Point_Y))
                                if LoadReal(h, id, SH_Dop_Damage) > 0.0 then
                    set damage=damage + damage * LoadReal(h, id, SH_Dop_Damage)
                    set n=CreateUnit(GetOwningPlayer(caster), 'dM55', GetUnitX(arrow), GetUnitY(arrow), GetRandomInt(0, 360))
                    call SetUnitScale(n, 1.5 + LoadReal(h, id, SH_Dop_Damage) / 2, 1.5 + LoadReal(h, id, SH_Dop_Damage) / 2, 1.5 + LoadReal(h, id, SH_Dop_Damage) / 2)
                    call MyRemoveUnit(n , 3)
                    if LoadReal(h, id, SH_Dop_Damage) > 1.0 then
                        set n=CreateUnit(GetOwningPlayer(caster), 'dM75', GetUnitX(arrow), GetUnitY(arrow), GetRandomInt(0, 360))
                        call SetUnitScale(n, 1.5 + LoadReal(h, id, SH_Dop_Damage) / 2, 1.5 + LoadReal(h, id, SH_Dop_Damage) / 2, 1.5 + LoadReal(h, id, SH_Dop_Damage) / 2)
                        call MyRemoveUnit(n , 3)
                        set n=CreateUnit(GetOwningPlayer(caster), 'dM77', GetUnitX(arrow), GetUnitY(arrow), GetRandomInt(0, 360))
                        call SetUnitScale(n, 1.5 + LoadReal(h, id, SH_Dop_Damage) / 2, 1.5 + LoadReal(h, id, SH_Dop_Damage) / 2, 1.5 + LoadReal(h, id, SH_Dop_Damage) / 2)
                        call MyRemoveUnit(n , 3)
                    endif
                endif
                set soundplay=SndN(3439) // Sound\war3mapImported\MadokaQ3-hit.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                set n=CreateUnit(GetOwningPlayer(caster), 'dM48', GetUnitX(arrow), GetUnitY(arrow), angle * bj_RADTODEG)
                call SetUnitScale(n, 0.65, 0.65, 0.65)
                call SetUnitTimeScale(n, 0.5)
                call MyRemoveUnit(n , 2.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'dM49', GetUnitX(arrow), GetUnitY(arrow), angle * bj_RADTODEG)
                call SetUnitScale(n, 1.55, 1.55, 1.55)
                call MyRemoveUnit(n , 2.5)
                set bjLCG=LoadGroupHandle(h, id, GroupHash)
                call GroupEnumUnitsInRange(bjLCG, GetUnitX(arrow), GetUnitY(arrow), 450, Base)
                loop
                set E=FirstOfGroup(bjLCG)
                exitwhen E == null
                    if Condition_Base(GetOwningPlayer(caster) , E) then
                        call myCustomDamage(caster , E , damage , false , false , null , null , null)
                        call SetControlToUnit(caster , E , 1.5 , "stun")
                        
                        call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl", E, "chest"))
                        set n=CreateUnit(GetOwningPlayer(caster), 'dM43', GetUnitX(E), GetUnitY(E), GetRandomInt(0, 360))
                        call SetUnitFlyHeight(n, 150, 0)
                        call MyRemoveUnit(n , 3)
                    elseif E != caster and bool_heal then
                        call HealTextTag(caster,E,  0.7*Calculate_MadokaWHeal(caster , E)*myCustomHeal2(E,1),"HealthRes")
                        call SetWidgetLife(E, GetWidgetLife(E) + Calculate_MadokaWHeal(caster , E) * 0.7)
                    endif
                    call GroupRemoveUnit(bjLCG, E)
                endloop
                call SaveInteger(h, id, SH_Act, 3)
            endif
        endif
    else
        call KillUnit(arrow)
        call MyRemoveUnit(arrow , 1.0)
        call GroupClear(LoadGroupHandle(h, id, GroupHash))
        call GroupClear(LoadGroupHandle(h, id, SH_Group2))
        call DestroyGroup(LoadGroupHandle(h, id, GroupHash))
        call DestroyGroup(LoadGroupHandle(h, id, SH_Group2))
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
    set arrow=null
endfunction


function MadokaQ3_Cast takes unit newCaster,real point_x,real point_y,timer newTimer returns nothing
    local integer id=GetHandleId(newTimer)
    local real caster_x=GetUnitX(newCaster)
    local real caster_y=GetUnitY(newCaster)
    local real angle=AP(caster_x , caster_y , point_x , point_y)
    call UnitAddAbility(newCaster, 'Arav')
    call UnitRemoveAbility(newCaster, 'Arav')
    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
    if GetUnitTypeId(newCaster) == 'HMaG' then
        call SetUnitAnimationByIndex(newCaster, 16)
    else
        call SetUnitAnimationByIndex(newCaster, 6)
    endif
    if LoadBoolean(h, GetHandleId(newCaster), SH_MadokaW) then
        call SaveBoolean(h, id, SH_HealBoolean, true)
    endif
    set soundplay=SndN(3431) // Sound\war3mapImported\Madoka_Charging.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM30', caster_x, caster_y, GetRandomInt(0, 360))
    call MyRemoveUnit(n , 1.0)
    
    call DestroyEffect(AddSpecialEffectTarget("yx_xiaoyuanxuli2.mdl", newCaster, "weapon"))
    if GetUnitTypeId(newCaster) == 'HMad' then
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dM44', caster_x, caster_y, angle * bj_RADTODEG)
    else
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dM64', caster_x, caster_y, angle * bj_RADTODEG)
    endif
        call SaveUnitHandle(h, id, Dummy1Hash, n)
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call SaveReal(h, id, SH_Point_X, point_x)
    call SaveReal(h, id, SH_Point_Y, point_y)
    call SaveReal(h, id, SH_Damage, GetHeroInt(newCaster, true) * ( 3 + GetUnitAbilityLevel(newCaster, 'MaQ1') ))
    call SaveReal(h, id, SH_Dop_Damage, MadokaD_UseStacks(newCaster , 0.5))
    call SaveGroupHandle(h, id, GroupHash, CreateGroup())
    call SaveGroupHandle(h, id, SH_Group2, CreateGroup())
    call TimerStart(newTimer, 0.01, true, function MadokaQ3_Periodic)
endfunction

function MadokaQ_Switcher takes unit newCaster,real point_x,real point_y returns nothing
    if GetUnitAbilityLevel(newCaster, 'MaR1')==0 and GetUnitTypeId(newCaster)=='HMad' then
        call MadokaQ1_Cast(GetSpellAbilityUnit() , GetSpellTargetX() , GetSpellTargetY() , CreateTimer())
    else
        call UnitRemoveAbility(newCaster, 'MaR1')
        call UnitRemoveAbility(newCaster, 'MaRb')
        if SquareRootPoint(GetUnitX(newCaster) , GetUnitY(newCaster) , GetSpellTargetX() , GetSpellTargetY()) <= 1500 then
            call MadokaQ2_Cast(GetSpellAbilityUnit() , GetSpellTargetX() , GetSpellTargetY() , CreateTimer())
        else
            call MadokaQ3_Cast(GetSpellAbilityUnit() , GetSpellTargetX() , GetSpellTargetY() , CreateTimer())
        endif
    endif
endfunction



function MadokaW_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local real time=LoadReal(h, id, TIME_HASH)
    local real full_heal=LoadReal(h, id, SH_Heal)
    local unit target=LoadUnitHandle(h, id, TargetHash)
    if time < 10 and IsUnitAlive(target)==true then
        call HealTextTag(LoadUnitHandle(h, id, CasterHash),target,  full_heal * 0.01*myCustomHeal2(target,1),"HealthRes")
        call SetWidgetLife(target, GetWidgetLife(target) + full_heal * 0.01)
        call SaveReal(h, id, TIME_HASH, time + 0.1)
        call SaveBoolean(h, GetHandleId(target), SH_MadokaW, true)
    else
        call SaveBoolean(h, GetHandleId(target), SH_MadokaW, false)
        call DestroyEffect(LoadEffectHandle(h, id, Effect1Hash))
        call DestroyEffect(LoadEffectHandle(h, id, Effect2Hash))
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set target=null
endfunction


function MadokaW_Cast takes unit newCaster,unit newTarget,timer newTimer returns nothing
    local integer id=GetHandleId(newTimer)
    local real caster_x=GetUnitX(newCaster)
    local real caster_y=GetUnitY(newCaster)
    local real target_x=GetUnitX(newTarget)
    local real target_y=GetUnitY(newTarget)
    local real full_heal=Calculate_MadokaWHeal(newCaster , newTarget)
    call HealTextTag(newCaster,newTarget,  full_heal * 0.3*myCustomHeal2(newTarget,1),"HealthRes")
    call SetWidgetLife(newTarget, GetWidgetLife(newTarget) + full_heal * 0.3)
    set full_heal=full_heal * 0.7
    call SaveReal(h, id, SH_Heal, full_heal)
    if newCaster == newTarget then
        call SaveBoolean(h, GetHandleId(newCaster), SH_MadokaW, true)
    endif
    if newCaster != newTarget then
        set soundplay=SndN(3442) // Sound\war3mapImported\MadokaW_Voice1.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    else
        set soundplay=SndN(3444) // Sound\war3mapImported\MadokaW_Self.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    endif
    call SaveEffectHandle(h, id, Effect1Hash, AddSpecialEffectTarget("cure.mdl", newTarget, "origin"))
    call SaveEffectHandle(h, id, Effect2Hash, AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIso\\BIsvTarget.mdl", newTarget, "chest"))
    call SaveUnitHandle(h, id, TargetHash, newTarget)
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call TimerStart(newTimer, 0.1, true, function MadokaW_Periodic)
endfunction


function MadokaE1_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local real time=LoadReal(h, id, TIME_HASH)
    local unit target=LoadUnitHandle(h, id, TargetHash)
    local real damage=GetWidgetMaxLife(target) * 0.0015
    if time < 15 and UnitIsAlive(target) then
        if IsUnitPaused(target)==false and GetUnitAbilityLevel(target,'Pet1')==0 then
            if GetWidgetLife(target) > GetWidgetMaxLife(target)*0.055 then
                call SetWidgetLife(target, GetWidgetLife(target) - damage)
            else
                call UnitAddAbility(target, 'A0WR')
                call DamageIndicatorFunction(LoadUnitHandle(h, id, CasterHash), target, GetWidgetMaxLife(target)*0.055)
                call myCustomDamage(LoadUnitHandle(h, id, CasterHash) , target , 99999 , false , false , null , null , null)
                call UnitRemoveAbility(target, 'A0WR')
            endif
            call SaveReal(h, id, TIME_HASH, time + 0.1)
        endif
    else
        call SetHeroStr(target, GetHeroStr(target, false) - LoadInteger(h, id, SH_Bonus_Stat), false)
        call SetHeroAgi(target, GetHeroAgi(target, false) - LoadInteger(h, id, SH_Bonus_Stat), false)
        call SetHeroInt(target, GetHeroInt(target, false) - LoadInteger(h, id, SH_Bonus_Stat), false)
        call UnitRemoveAbility(target, 'MaE3')
        call DestroyEffect(LoadEffectHandle(h, id, Effect1Hash))
        call DestroyEffect(LoadEffectHandle(h, id, Effect2Hash))
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set target=null
endfunction


function MadokaE1_Cast takes unit newCaster,unit newTarget,timer newTimer returns nothing
    local integer id=GetHandleId(newTimer)
    local real caster_x=GetUnitX(newCaster)
    local real caster_y=GetUnitY(newCaster)
    local real target_x=GetUnitX(newTarget)
    local real target_y=GetUnitY(newTarget)
    local integer bonus_stat=15 + 5 * GetUnitAbilityLevel(newCaster, 'MaE1')
    set soundplay=SndN(3446) // Sound\war3mapImported\Madoka_E.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call UnitAddAbility(newTarget, 'MaE3')
    call UnitMakeAbilityPermanent(newTarget, true, 'MaE3')
    call SetHeroStr(newTarget, GetHeroStr(newTarget, false) + bonus_stat, false)
    call SetHeroAgi(newTarget, GetHeroAgi(newTarget, false) + bonus_stat, false)
    call SetHeroInt(newTarget, GetHeroInt(newTarget, false) + bonus_stat, false)
    call SaveEffectHandle(h, id, Effect2Hash, AddSpecialEffectTarget("buff-obsidiandestroyer_n2s_t_target.mdl", newTarget, "origin"))
    call SaveEffectHandle(h, id, Effect1Hash, AddSpecialEffectTarget("buff-cbb_m.mdl", newTarget, "chest"))
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call SaveUnitHandle(h, id, TargetHash, newTarget)
    call SaveInteger(h, id, SH_Bonus_Stat, bonus_stat)
    call TimerStart(newTimer, 0.1, true, function MadokaE1_Periodic)
endfunction




function MadokaE_Switcher takes unit newCaster,unit newTarget returns nothing
    if GetUnitAbilityLevel(newTarget, 'Wome')>0 then // Проверка на отсутствие письки (на женский пол)
        if (IsUnitAlly(newTarget, GetOwningPlayer(newCaster)) or GetWidgetLife(newTarget) <= GetWidgetMaxLife(newTarget) * 0.3) and GetUnitAbilityLevel(newTarget, 'MaE3')==0 then
            call MadokaE1_Cast(newCaster , newTarget , CreateTimer())
        else
            call IssueImmediateOrder(newCaster, "stop")
            call SetWidgetMana(newCaster, GetWidgetMana(newCaster)+GetAbilityIntegerLevelField(GetUnitAbility(newCaster,'MaE1'),ABILITY_ILF_MANA_COST,GetUnitAbilityLevel(newCaster,'MaE1')-1))
            call StartAbilityCooldown(GetUnitAbility(newCaster , 'MaE1' ), 0.5)
            call DisplayTimedWarningMessage(GetOwningPlayer(newCaster),10,Lng("Неподходящая цель для Kyubey.","Invalid target for Kyubey."))
        endif
    else
        set soundplay=SndN(3448) // Sound\war3mapImported\MadokaE_Man.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        call SetControlToUnit(newTarget, newTarget, 3.0, "silenceTE")
        call SetControlToUnit(newTarget, newTarget, GetUnitAbilityLevel(newCaster, 'MaE1')+1, "blind")
        call StartAbilityCooldown(GetUnitAbility(newCaster , 'MaE1' ), 20)
        call RemoveEffect(AddSpecialEffectTarget("az_atropos_f1.mdl", newTarget, "origin"), 3, true, CreateTimer())
    endif
endfunction


function MadokaE2_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local real time=LoadReal(h, id, TIME_HASH)
    local unit target=LoadUnitHandle(h, id, TargetHash)
    if time < 40 and UnitIsAlive(target) and udg_B then
        call SaveReal(h, id, TIME_HASH, time + 0.1)
    else
        call SetHeroStr(target, GetHeroStr(target, false) - LoadInteger(h, id, SH_Bonus_Stat), false)
        call SetHeroAgi(target, GetHeroAgi(target, false) - LoadInteger(h, id, SH_Bonus_Stat), false)
        call SetHeroInt(target, GetHeroInt(target, false) - LoadInteger(h, id, SH_Bonus_Stat), false)
        call UnitRemoveAbility(target, 'MaE4')
        call DestroyEffect(LoadEffectHandle(h, id, Effect1Hash))
        call DestroyEffect(LoadEffectHandle(h, id, Effect2Hash))
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set target=null
endfunction


function MadokaE2_Cast takes unit newCaster,unit newTarget,timer newTimer returns nothing
    local integer id=GetHandleId(newTimer)
    local real caster_x=GetUnitX(newCaster)
    local real caster_y=GetUnitY(newCaster)
    local real target_x=GetUnitX(newTarget)
    local real target_y=GetUnitY(newTarget)
    local integer bonus_stat=40
    set soundplay=SndN(3450) // Sound\war3mapImported\MadokaE2.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call UnitAddAbility(newTarget, 'MaE4')
        call UnitMakeAbilityPermanent(newTarget, true, 'MaE4')
    call SetHeroStr(newTarget, GetHeroStr(newTarget, false) + bonus_stat, false)
    call SetHeroAgi(newTarget, GetHeroAgi(newTarget, false) + bonus_stat, false)
    call SetHeroInt(newTarget, GetHeroInt(newTarget, false) + bonus_stat, false)
    call SaveEffectHandle(h, id, Effect1Hash, AddSpecialEffectTarget("buff-obsidiandestroyer_n2s_t_target.mdl", newTarget, "origin"))
    call SaveEffectHandle(h, id, Effect2Hash, AddSpecialEffectTarget("buff-bcy1.mdl", newTarget, "origin"))
    call SaveUnitHandle(h, id, TargetHash, newTarget)
    call SaveInteger(h, id, SH_Bonus_Stat, bonus_stat)
    call TimerStart(newTimer, 0.1, true, function MadokaE2_Periodic)
endfunction


function MadokaR_Buff_Delete takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local unit caster=LoadUnitHandle(h, id, CasterHash)
    call UnitRemoveAbility(caster, 'MaRb')
    call FlushChildHashtable(h, id)
    call DestroyTimer(GetExpiredTimer())
endfunction

function MadokaR_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local real distance=LoadReal(h, id, SH_Distance)
    local real angle=LoadReal(h, id, AngleHash)
    local unit caster=LoadUnitHandle(h, id, CasterHash)
    local timer bjTTT=GetExpiredTimer()
    if distance < 800 then
        call SetUnitX(caster, GetUnitX(caster) + 36 * Cos(angle))
        call SetUnitY(caster, GetUnitY(caster) + 36 * Sin(angle))
        call SaveReal(h, id, SH_Distance, distance + 36)
        if LoadInteger(h, id, EffectPeriodHash) == 0 then
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dM11', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
            call SetUnitFlyHeight(bjLCU, 150, 0)
            call SetUnitVertexColor(bjLCU, 255, 255, 255, 140)
            call SetUnitScale(bjLCU, 0.6, 0.6, 0.6)
            call MyRemoveUnit(bjLCU , 1.5)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dM29', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
            call SetUnitVertexColor(bjLCU, 255, 255, 255, 180)
            call MyRemoveUnit(bjLCU , 1.5)
            call SaveInteger(h, id, EffectPeriodHash, 8)
        else
            call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash) - 1)
        endif
    else
        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dM30', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
        call SetUnitScale(bjLCU, 0.85, 0.85, 0.85)
        call SetUnitVertexColor(bjLCU, 255, 255, 255, 200)
        call MyRemoveUnit(bjLCU , 1.5)
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call SetUnitVertexColor(caster, 255, 255, 255, 255)
        call UnitAddAbility(caster, 'MaR1')
        call UnitRemoveAbilityTimed_ExD(caster , 'MaR1' , 10.0)
        if GetAbilityRemainingCooldown(GetUnitAbility(caster , 'MaQ1')) > 0.5 then
            call StartAbilityCooldown(GetUnitAbility(caster , 'MaQ1' ), 0.5)
        endif
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
        set bjLCT=CreateTimer()
        call SaveUnitHandle(h, GetHandleId(bjLCT), CasterHash, caster)
        call TimerStart(bjLCT, 10, false, function MadokaR_Buff_Delete)
        set bjLCT=null
    endif
    set caster=null
    set bjTTT=null
endfunction

function MadokaR_Cast takes unit newCaster,real point_x,real point_y,timer newTimer returns nothing
    local integer id=GetHandleId(newTimer)
    local real caster_x=GetUnitX(newCaster)
    local real caster_y=GetUnitY(newCaster)
    local real angle=AtanPoint(caster_x , caster_y , point_x , point_y)
        local real distance=0
        if SquareRootPoint(caster_x, caster_y, point_x, point_y)<1000 then
                set distance=1000-SquareRootPoint(caster_x, caster_y, point_x, point_y)
        endif
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM04', caster_x, caster_y, angle * bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 150, 0)
    call SetUnitScale(bjLCU, 0.8, 0.8, 0.8)
    call MyRemoveUnit(bjLCU , 1.5)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM11', caster_x, caster_y, angle * bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 150, 0)
    call MyRemoveUnit(bjLCU , 1.5)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM30', caster_x, caster_y, angle * bj_RADTODEG)
    call SetUnitScale(bjLCU, 0.85, 0.85, 0.85)
    call SetUnitVertexColor(bjLCU, 255, 255, 255, 200)
    call MyRemoveUnit(bjLCU , 1.5)
    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, 3)
    call SetUnitVertexColor(newCaster, 255, 255, 255, 110)
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call SaveReal(h, id, AngleHash, angle)
        call SaveReal(h, id, SH_Distance, distance)
    set soundplay=SndN(3452) // Sound\war3mapImported\MadokaR.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call TimerStart(newTimer, 0.01, true, function MadokaR_Periodic)
endfunction


function MadokaT1_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local real time=LoadReal(h, id, TIME_HASH)
    local unit caster=LoadUnitHandle(h, id, CasterHash)
    local unit seal=LoadUnitHandle(h, id, Dummy1Hash)
    local real angle=0.0
    local real damage=LoadReal(h, id, SH_Damage)
    if time < 4.5 then
        call SaveReal(h, id, TIME_HASH, time + 0.1)
        
        if time == 1.0 then
            set angle=AU(caster , seal)
            set n=CreateUnit(GetOwningPlayer(caster), 'dM79', GetUnitX(caster) + 50 * Cos(angle), GetUnitY(caster) + 50 * Sin(angle), angle * bj_RADTODEG)
            call SaveUnitHandle(h, id, SH_Dummy3, n)
        endif
        if time == 1.3 then
            call ShakeCamera(0.2 , 10)
            call PauseUnit(caster, false)
            call SetUnitInvulnerable(caster, false)
            set angle=0.0
            loop
            exitwhen angle == 360 * bj_DEGTORAD
                set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM40', GetUnitX(caster) + 330 * Cos(angle), GetUnitY(caster) + 330 * Sin(angle), angle * bj_RADTODEG + 180)
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call SetUnitVertexColor(n, 255, 255, 255, 110)
                call MyRemoveUnit(n , 1.5)
            set angle=angle + 30 * bj_DEGTORAD
            endloop
            call SetUnitFlyHeight(LoadUnitHandle(h, id, SH_Dummy3), 3000, 2500)
            call Push3(LoadUnitHandle(h, id, SH_Dummy3) , 60 , AU(caster , seal) , 1300 , "")
            set n=CreateUnit(GetOwningPlayer(caster), 'dM80', GetUnitX(caster), GetUnitY(caster), AU(caster , seal) * bj_RADTODEG)
            call SetUnitScale(n, 0.8, 0.8, 0.8)
            call SetUnitTimeScale(n, 0.6)
            call MyRemoveUnit(n , 1.5)
        endif
        if time == 1.8 then
            call KillUnit(LoadUnitHandle(h, id, SH_Dummy3))
            call RemoveUnit(LoadUnitHandle(h, id, SH_Dummy3))
            set soundplay=SndN(3454) // Sound\war3mapImported\MadokaT1_Sound2.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            set n=CreateUnit(GetOwningPlayer(caster), 'dM52', GetUnitX(seal), GetUnitY(seal), GetRandomInt(0, 360))
            call SetUnitScale(n, 4.5, 4.5, 4.5)
            call SetUnitVertexColor(n, 255, 155, 155, 255)
            call SetUnitFlyHeight(n, 1200, 0)
            call MyRemoveUnit(n , 1.5)
                        call RemoveUnit(seal)
                        set n=CreateUnit(GetOwningPlayer(caster), 'dM50', GetUnitX(seal), GetUnitY(seal), GetRandomInt(0, 360))
                        call SetUnitScale(n, 7, 7, 7)
                        call SetUnitFlyHeight(n, 1200, 0)
                        set seal=n
                        call SaveUnitHandle(h, id, Dummy1Hash, n)
                        set n=CreateUnit(GetOwningPlayer(caster), 'dM50', GetUnitX(seal), GetUnitY(seal), GetRandomInt(0, 360))
                        call SetUnitScale(n, 7, 7, 7)
                        call SetUnitFlyHeight(n, 1200, 0)
                        call SaveUnitHandle(h, id, Dummy2Hash, n)
        endif
        if time == 2.0 then
            call ShakeCamera(2.5 , 10)
            set soundplay=SndN(3457) // Sound\war3mapImported\MadokaT1_Sound3.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            set n=CreateUnit(GetOwningPlayer(caster), 'dM72', GetUnitX(seal), GetUnitY(seal), GetRandomInt(0, 360))
            call SetUnitScale(n, 1.5, 1.5, 1.5)
            call SetUnitFlyHeight(n, 1200, 0)
            call MyRemoveUnit(n , 1.5)
            set n=CreateUnit(GetOwningPlayer(caster), 'dM81', GetUnitX(seal), GetUnitY(seal), GetRandomInt(0, 360))
            call SetUnitVertexColor(n, 255, 255, 155, 125)
            call SetUnitScale(n, 5, 5, 5)
            call SetUnitTimeScale(n, 2)
            call SetUnitFlyHeight(n, 200, 0)
            call UnitApplyTimedLife(n,'BTLF', 2.5)
            call MyRemoveUnit(n , 4)
        endif
        if time > 2.0 then
            set bj_forLoopAIndex=0
            loop
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
            exitwhen bj_forLoopAIndex == 5
                set n=CreateUnit(GetOwningPlayer(caster), 'dM78', GetUnitX(seal) + GetRandomInt(- 750, 750), GetUnitY(seal) + GetRandomInt(- 750, 750), GetRandomInt(0, 360))
                call SetUnitFlyHeight(n, 0, GetRandomInt(3500, 5000))
                call SetUnitScale(n, 1.6, 1.6, 1.6)
                call SetUnitTimeScale(n, 1.6)
                call UnitApplyTimedLife(n,'BTLF', 0.5)
                call MyRemoveUnit(n , 1.5)
            endloop
            set bjLCG=LoadGroupHandle(h, id, GroupHash)
            call GroupEnumUnitsInRange(bjLCG, GetUnitX(seal), GetUnitY(seal), 1000, Base)
            loop
            set E=FirstOfGroup(bjLCG)
            exitwhen E == null
                if Condition_Base(GetOwningPlayer(caster) , E) then
                    call myCustomDamage(caster , E , damage , false , false , null , null , null)
                elseif IsUnitAlly(E, GetOwningPlayer(caster)) and LoadBoolean(h, id, SH_Heal) then
                    call HealTextTag(caster,E,  damage*0.40*myCustomHeal2(E,1),"HealthRes")
                    call SetWidgetLife(E, GetWidgetLife(E)+damage*0.40)
                endif
            call GroupRemoveUnit(bjLCG, E)
            endloop
        endif
    else
        set n=CreateUnit(GetOwningPlayer(caster), 'dM52', GetUnitX(seal), GetUnitY(seal), GetRandomInt(0, 360))
        call SetUnitScale(n, 3, 3, 3)
        call SetUnitVertexColor(n, 255, 155, 155, 255)
        call SetUnitFlyHeight(n, 1000, 0)
        call MyRemoveUnit(n , 1.5)
        call SetUnitAnimation(seal, "Birth")
        call SetUnitAnimation(LoadUnitHandle(h, id, Dummy2Hash), "Birth")
        call MyRemoveUnit(seal , 0.25)
        call MyRemoveUnit(LoadUnitHandle(h, id, Dummy2Hash) , 0.25)
        call DestroyGroup(LoadGroupHandle(h, id, GroupHash))
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
    set seal=null
endfunction

function MadokaT1_Cast takes unit newCaster,real point_x,real point_y,timer newTimer returns nothing
    local integer id=GetHandleId(newTimer)
    set soundplay=SndN(3460) // Sound\war3mapImported\MadokaT1_Sound1.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        set soundplay=SndN(3462) // Sound\war3mapImported\MadokaT1_Voice1.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
        if GetUnitTypeId(newCaster)=='HMad' then
                call SetUnitAnimationByIndex(newCaster, 7)
        else
                call SetUnitAnimationByIndex(newCaster, 9)
        endif
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call DestroyEffect(AddSpecialEffectTarget("yx_xiaoyuanxuli2.mdl", newCaster, "weapon"))
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM32', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    call SetUnitScale(n, 3, 3, 3)
    call SetUnitVertexColor(n, 255, 255, 255, 150)
    call UnitApplyTimedLife(n,'BTLF', 3)
    call MyRemoveUnit(n , 3.7)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dAlb', point_x, point_y, GetRandomInt(0, 360))
        call SetUnitFlyHeight(n, 1200, 0)
        call SaveUnitHandle(h, id, Dummy1Hash, n)
    call SaveBoolean(h, id, SH_Heal, LoadBoolean(h, GetHandleId(newCaster), SH_MadokaW))
    call SaveReal(h, id, SH_Damage, ( GetHeroInt(newCaster, true) * 5 ) * ( 1 + MadokaD_UseStacks(newCaster , 0.25) ) * 0.1)
    call SaveGroupHandle(h, id, GroupHash, CreateGroup())
    call TimerStart(newTimer, 0.1, true, function MadokaT1_Periodic)
endfunction

function MadokaT2_Single_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local real time=LoadReal(h, id, TIME_HASH) + 0.02
    local unit target=LoadUnitHandle(h, id, TargetHash)
    call SaveReal(h, id, TIME_HASH, time)
    if time < 3.0 then
        call SetUnitX(LoadUnitHandle(h, id, Dummy1Hash), GetUnitX(target))
        call SetUnitY(LoadUnitHandle(h, id, Dummy1Hash), GetUnitY(target))
        if time == 2.0 then
            set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM72', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
            call SetUnitScale(n, 1.4, 1.4, 1.4)
            call SetUnitTimeScale(n, 0.5)
            call SaveUnitHandle(h, id, Dummy2Hash, n)
        endif
        if time > 2.0 then
            call SetUnitX(LoadUnitHandle(h, id, Dummy2Hash), GetUnitX(target))
            call SetUnitY(LoadUnitHandle(h, id, Dummy2Hash), GetUnitY(target))
        endif
    else
        set bjLCG=CreateGroup()
        call GroupEnumUnitsInRange(bjLCG, GetUnitX(target), GetUnitY(target), 450, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E == null
            if Condition_Base(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)) , E) then
                call myCustomDamage(LoadUnitHandle(h, id, CasterHash) , E , GetHeroInt(LoadUnitHandle(h, id, CasterHash), true) * 7 + ( GetWidgetMaxLife(E) - GetWidgetLife(E) ) * 0.6 , false , false , null , null , null)
            endif
        call GroupRemoveUnit(bjLCG, E)
        endloop
        call DestroyGroup(bjLCG)
        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM71', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
        call SetUnitScale(n, 0.3, 0.3, 0.3)
        call MyRemoveUnit(n , 1.5)
        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM73', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
        call SetUnitScale(n, 0.5, 0.5, 0.5)
        call MyRemoveUnit(n , 1.5)
        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM28', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call MyRemoveUnit(n , 1.5)
        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM74', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
        call SetUnitScale(n, 0.25, 0.25, 0.25)
        call MyRemoveUnit(n , 3.5)
        call KillUnit(LoadUnitHandle(h, id, Dummy1Hash))
        call MyRemoveUnit(LoadUnitHandle(h, id, Dummy1Hash) , 1.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, Dummy2Hash) , 1.5)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set target=null
endfunction

function MadokaT2_Single takes unit newCaster,unit newTarget,timer newTimer returns nothing
    local integer id=GetHandleId(newTimer)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM61', GetUnitX(newTarget), GetUnitY(newTarget), GetRandomInt(0, 360))
    call SetUnitVertexColor(n, 255, 255, 255, 150)
    call UnitScale(n , 2.0 , 0.7 , 1.8)
    call SaveUnitHandle(h, id, Dummy1Hash, n)
    //set n=CreateUnit(GetOwningPlayer(newCaster), 'dM65', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    //call UnitScale(n, 1, 3.8, 3)
    //call SaveUnitHandle(h, id, Dummy2Hash, n)
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call SaveUnitHandle(h, id, TargetHash, newTarget)
    call TimerStart(newTimer, 0.02, true, function MadokaT2_Single_Periodic)
endfunction

function MadokaT2_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local unit caster=LoadUnitHandle(h, id, CasterHash)
    local real time=LoadReal(h, id, TIME_HASH) + 0.05
    local real angle=0.0
    call SaveReal(h, id, TIME_HASH, time)
    if time < 6.0 then
        call SetUnitX(LoadUnitHandle(h, id, Dummy1Hash), GetUnitX(caster))
        call SetUnitY(LoadUnitHandle(h, id, Dummy1Hash), GetUnitY(caster))
        call SetUnitX(LoadUnitHandle(h, id, Dummy2Hash), GetUnitX(caster))
        call SetUnitY(LoadUnitHandle(h, id, Dummy2Hash), GetUnitY(caster))
        if time == 3.0 then
            call SetUnitAnimationByIndex(caster, 13)
            call DestroyEffect(AddSpecialEffectTarget("supershinythingy fire5.mdl", caster, "weapon"))
            set soundplay=SndN(3464) // Sound\war3mapImported\MadokaT2_Channel.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            set bjLCG=CreateGroup()
                        call GroupEnumUnitsInRange(bjLCG, 0, 0, 99999, Base)
            loop
            set E=FirstOfGroup(bjLCG)
            exitwhen E == null
                if Condition_Base(GetOwningPlayer(caster) , E) and IsUnitType(E, UNIT_TYPE_HERO) then
                    call MadokaT2_Single(caster , E , CreateTimer())
                endif
                call GroupRemoveUnit(bjLCG, E)
            endloop
            call DestroyGroup(bjLCG)
        endif
        if time == 5.6 then
            call SetUnitAnimationByIndex(caster, 14)
        endif
    else
        call ShakeCamera(0.3 , 20)
        set angle=0.0
        loop
        exitwhen angle == 360 * bj_DEGTORAD
            set n=CreateUnit(GetOwningPlayer(caster), 'dM40', GetUnitX(caster) + 330 * Cos(angle), GetUnitY(caster) + 330 * Sin(angle), angle * bj_RADTODEG + 180)
            call SetUnitScale(n, 1.5, 1.5, 1.5)
            call SetUnitVertexColor(n, 255, 255, 255, 180)
            call MyRemoveUnit(n , 1.5)
        set angle=angle + 30 * bj_DEGTORAD
        endloop
        call KillUnit(LoadUnitHandle(h, id, Dummy1Hash))
        call KillUnit(LoadUnitHandle(h, id, Dummy2Hash))
        call MyRemoveUnit(LoadUnitHandle(h, id, Dummy1Hash) , 1.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, Dummy2Hash) , 1.5)
        set soundplay=SndN(3467) // Sound\war3mapImported\MadokaT2_Blast.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
                call IssueImmediateOrder(caster, "stop")
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
endfunction

function MadokaT2_Cast takes unit newCaster,timer newTimer returns nothing
    local integer id=GetHandleId(newTimer)
        if GetRandomInt(0,1)==0 or GetPlayerName(GetOwningPlayer(newCaster))=="Uriska" then
                set soundplay=SndN(3470) // Sound\war3mapImported\MadokaT2_Voice2.mp3
        else
                set soundplay=SndN(3472) // Sound\war3mapImported\MadokaT2_Voice1.mp3
        endif
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, 11)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM65', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    call UnitScale(n , 1 , 3.8 , 3)
    call SaveUnitHandle(h, id, Dummy1Hash, n)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM61', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    call SetUnitVertexColor(n, 255, 255, 255, 150)
    call UnitScale(n , 0.7 , 2.1 , 3)
    call SaveUnitHandle(h, id, Dummy2Hash, n)
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call TimerStart(newTimer, 0.05, true, function MadokaT2_Periodic)
endfunction

function Trig_MadokaInt_Actions takes nothing returns nothing
    if GetSpellAbilityId() == 'MadD' and udg_B then
        call MadokaD_Cast(GetSpellAbilityUnit())
    endif
    if GetSpellAbilityId() == 'MaQ1' then
        call MadokaQ_Switcher(GetSpellAbilityUnit() , GetSpellTargetX() , GetSpellTargetY())
    endif
    if GetSpellAbilityId() == 'MadW' then
        call MadokaW_Cast(GetSpellAbilityUnit() , GetSpellTargetUnit() , CreateTimer())
    endif
    if GetSpellAbilityId() == 'MadR' then
        call MadokaR_Cast(GetSpellAbilityUnit() , GetSpellTargetX() , GetSpellTargetY() , CreateTimer())
    endif
    if GetSpellAbilityId() == 'MaE1' then
        call MadokaE_Switcher(GetSpellAbilityUnit() , GetSpellTargetUnit())
    endif
    if GetSpellAbilityId() == 'MaE2' then
        call MadokaE2_Cast(GetSpellAbilityUnit() , GetSpellTargetUnit() , CreateTimer())
    endif
    if GetSpellAbilityId() == 'MaT1' or GetSpellAbilityId() == 'MaR2' then
        call MadokaT1_Cast(GetSpellAbilityUnit() , GetSpellTargetX() , GetSpellTargetY() , CreateTimer())
    endif
    if GetSpellAbilityId() == 'MaT2' then
        call MadokaT2_Cast(GetSpellAbilityUnit() , CreateTimer())
    endif
endfunction

//===========================================================================
function InitTrig_MadokaInt takes nothing returns nothing
    local trigger trig= CreateTrigger()
    local integer index= 0
    loop
        call TriggerRegisterPlayerUnitEvent(trig, Player(index), EVENT_PLAYER_UNIT_SPELL_EFFECT, null)
        set index=index + 1
        exitwhen index == bj_MAX_PLAYER_SLOTS
    endloop
    call TriggerAddAction(trig, function Trig_MadokaInt_Actions)
    set trig=null
endfunction

//===========================================================================
// Trigger: MadokaDDeath
//===========================================================================
function MadokaE1_Death_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local unit caster=LoadUnitHandle(h, id, CasterHash)
        local real caster_x=LoadReal(h, id, SH_PointX)
        local real caster_y=LoadReal(h, id, SH_PointY)
    local real time=LoadReal(h, id, TIME_HASH)
    if time < 5.0 and udg_B then
        call SaveReal(h, id, TIME_HASH, time + 0.1)
        if time < 1.0 then
            set n=CreateUnit(GetOwningPlayer(caster), 'dM42', caster_x, caster_y, GetRandomInt(0, 360))
            call SetUnitScale(n, 1.0 + time * 0.8, 1.0 + time * 0.8, 1.0 + time * 0.8)
            call SetUnitVertexColor(n, 255, 255, 255, 80)
            call SetUnitFlyHeight(n, 10, 0)
            call MyRemoveUnit(n , 1.5)
        endif
        if time == 0.1 then
            call ShakeCamera(0.2 , 5)
            set n=CreateUnit(GetOwningPlayer(caster), 'dM54', caster_x, caster_y, GetRandomInt(0, 360))
            call SetUnitScale(n, 1.1, 1.1, 1.1)
            call SetUnitFlyHeight(n, 150, 0)
            call SetUnitTimeScale(n, 0.6)
            call MyRemoveUnit(n , 2.5)
            set n=CreateUnit(GetOwningPlayer(caster), 'dM55', caster_x, caster_y, GetRandomInt(0, 360))
            call SetUnitScale(n, 1.8, 1.8, 1.8)
            call MyRemoveUnit(n , 2.5)
        endif
        if time == 1.0 then
            call ShakeCamera(1 , 5)
            set soundplay=SndN(3474) // Sound\war3mapImported\MadokaE1_DeathSound.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            call KillUnit(LoadUnitHandle(h, id, Dummy2Hash))
            call MyRemoveUnit(LoadUnitHandle(h, id, Dummy2Hash) , 1.5)
            set n=CreateUnit(GetOwningPlayer(caster), 'dM56', caster_x, caster_y, GetRandomInt(0, 360))
            call SetUnitScale(n, 1.8, 1.8, 1.8)
            call SaveUnitHandle(h, id, Dummy2Hash, n)
        endif
        if time > 1.0 then
            set bjLCG=LoadGroupHandle(h, id, GroupHash)
            call GroupEnumUnitsInRange(bjLCG, caster_x, caster_y, 600, Base)
            loop
            set E=FirstOfGroup(bjLCG)
            exitwhen E == null
                call myCustomDamage(caster , E , GetWidgetMaxLife(caster) * 0.025 , false , false , null , null , null)
                                if SquareRootPoint(caster_x, caster_y, GetUnitX(E), GetUnitY(E))>100 then
                                        call Push3(E,30,AtanPoint(GetUnitX(E),GetUnitY(E),caster_x, caster_y),30,"")
                                endif
                call GroupRemoveUnit(bjLCG, E)
            endloop
        endif
    else
        call SetUnitTimeScale(LoadUnitHandle(h, id, Dummy2Hash), 0.5)
        call KillUnit(LoadUnitHandle(h, id, Dummy1Hash))
        call KillUnit(LoadUnitHandle(h, id, Dummy2Hash))
        call MyRemoveUnit(LoadUnitHandle(h, id, Dummy1Hash) , 1.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, Dummy2Hash) , 1.5)
        
        call DestroyGroup(LoadGroupHandle(h, id, GroupHash))
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
endfunction

function MadokaE1_Death takes unit newCaster,timer newTimer returns nothing
    local integer id=GetHandleId(newTimer)
    set soundplay=SndN(3477) // Sound\war3mapImported\MadokaE1_DeathVoice.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM32', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    call SetUnitScale(n, 1.9, 1.9, 1.9)
    call SetUnitVertexColor(n, 255, 255, 255, 100)
    call SaveUnitHandle(h, id, Dummy1Hash, n)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM53', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    call UnitScale(n , 0.5 , 1.0 , 4)
    call SetUnitFlyHeight(n, 50, 0)
        call UnitAddAbility(n, 'MaF5')
    call SaveUnitHandle(h, id, Dummy2Hash, n)
    call SaveUnitHandle(h, id, CasterHash, Hero[GetPlayerId(GetOwningPlayer(newCaster))])
        call SaveReal(h, id, SH_PointX, GetUnitX(newCaster))
        call SaveReal(h, id, SH_PointY, GetUnitY(newCaster))
    call SaveGroupHandle(h, id, GroupHash, CreateGroup())
    call TimerStart(newTimer, 0.1, true, function MadokaE1_Death_Periodic)
endfunction

function MadokaE2_Death takes unit newCaster returns nothing
    set soundplay=SndN(3479) // Sound\war3mapImported\MadokaE2_Death.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set bjLCG=CreateGroup()
    call GroupEnumUnitsInRange(bjLCG, GetUnitX(newCaster), GetUnitY(newCaster), 1000, Base)
    loop
    set E=FirstOfGroup(bjLCG)
    exitwhen E == null
        if IsUnitAlly(E, GetOwningPlayer(E)) and UnitIsAlive(E) and E != newCaster then
            call SetWidgetLife(E, GetWidgetLife(E) + GetWidgetMaxLife(newCaster) * 0.1)
        endif
    call GroupRemoveUnit(bjLCG, E)
    endloop
    call DestroyGroup(bjLCG)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM66', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    call UnitScale(n , 0.5 , 1.5 , 1)
    call UnitApplyTimedLife(n,'BTLF', 4)
    call MyRemoveUnit(n , 6)
    call RemoveEffect(AddSpecialEffectTarget("az_20200523153.mdl", newCaster, "origin") , 1 , true , CreateTimer())
endfunction


function Trig_MadokaDDeath_Actions takes nothing returns nothing
    if IsUnitType(GetDyingUnit(), UNIT_TYPE_HERO) and IsUnitIllusion(GetDyingUnit())==false and GetKillingUnit()!=null then
        set bjLCG=CreateGroup()
                call GroupEnumUnitsInRect(bjLCG, bj_mapInitialPlayableArea, Base)
                loop
                set E=FirstOfGroup(bjLCG)
                exitwhen E == null
            if GetUnitAbilityLevel(E, 'MaDs') > 0 and GetHeroLevel(E)>5 and udg_B then
                                call DisplayTimedTextToPlayer(GetOwningPlayer(E), 0, 0, 3, Lng("|c00FF80C0Получен самоцвет души!|r","|c00FF80C0Acquired a Soul Gem!|r"))
                                //call DisplayTimedTextToPlayer(GetOwningPlayer(E), 0, 0, 3, "DebugMSG || Убитый герой: "+GetUnitName(GetDyingUnit()))
                call SetUnitAbilityLevel(E, 'MaDs', GetUnitAbilityLevel(E, 'MaDs') + 1)
                call HealTextTag(E,E,GetWidgetMaxMana(E) * 0.1*myCustomMana2(E,1),"ManaRes")
                call SetWidgetMana(E , GetWidgetMana(E) + GetWidgetMaxMana(E) * 0.1)
            endif
        call GroupRemoveUnit(bjLCG, E)
                endloop
                call DestroyGroup(bjLCG)
    endif
    if GetUnitAbilityLevel(GetDyingUnit(), 'MaE3') > 0 then
        call MadokaE1_Death(GetDyingUnit() , CreateTimer())
    endif
    if GetUnitAbilityLevel(GetDyingUnit(), 'MaE4') > 0 then
        call MadokaE2_Death(GetDyingUnit())
    endif
endfunction

//===========================================================================
function InitTrig_MadokaDDeath takes nothing returns nothing
    local trigger trig= CreateTrigger()
    local integer index= 0
    loop
        call TriggerRegisterPlayerUnitEvent(trig, Player(index), EVENT_PLAYER_UNIT_DEATH, null)
        set index=index + 1
        exitwhen index == bj_MAX_PLAYER_SLOTS
    endloop
    call TriggerAddAction(trig, function Trig_MadokaDDeath_Actions)
    set trig=null
endfunction


