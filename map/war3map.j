    call TriggerRegisterFrameEvent( tOnUnPress, IdHeroPick, FRAMEEVENT_MOUSE_UP )
    call TriggerRegisterFrameEvent( tOnClick, IdHeroPick, FRAMEEVENT_CONTROL_CLICK )
    
    call TriggerAddAction( tOnPress, function OnButtonPress )
    call TriggerAddAction( tOnUnPress, function OnButtonUnpress )
    call TriggerAddAction( tOnClick, function OnButtonPickHeroId )

    set x=x+1
    endloop
    set IdHeroGrid=CreateFrameByType("SIMPLEGRID", "TestBarHeroList", IdHeroFrame, "", 0)
    call ClearFrameAllPoints( IdHeroGrid )
    call SetFrameRelativePoint( IdHeroGrid, FRAMEPOINT_CENTER, IdHeroFrame, FRAMEPOINT_BOTTOM,  .0, .245  )
    call SetFrameGridSize( IdHeroGrid, 5, 25 )
    call SetFrameSize( IdHeroGrid, .655, .12)
    call SetFramePriority( IdHeroGrid, 5 )

    set IdHeroGridText=CreateFrameByType( "SIMPLETEXT", "TestBarHeroListText", IdHeroGrid, "", 0 )
    call ClearFrameAllPoints( IdHeroGridText )
    call SetFrameBlendMode( IdHeroGridText, 0, BLEND_MODE_BLEND )
    call SetFrameFont( IdHeroGridText, "Fonts\\FRIZQT__.TTF", .016, 0 )
    call SetFrameTextAlignment( IdHeroGridText, TEXT_JUSTIFY_CENTER, TEXT_JUSTIFY_MIDDLE )
    call SetFrameTextColour( IdHeroGridText, ConvertColour(255,255,30,30) )
    call SetFrameParent( IdHeroGridText, CloseIdButton )
    call SetFrameText( IdHeroGridText, "Strength")
    call ShowFrame( IdHeroGridText, true )
    call SetFrameRelativePoint( IdHeroGridText, FRAMEPOINT_TOPLEFT, IdHeroGrid, FRAMEPOINT_TOPLEFT, .00015, .02 )

    set x=0
    loop 
    exitwhen x>=220
    if RH_Force[x]!=0 and GetUnitBaseIntegerFieldById(RH_Force[x],UNIT_IF_PRIMARY_ATTRIBUTE)==1 then
    set HeroIdIcon=CreateFrameByType( "SIMPLEBUTTON", "TestBarHero", IdHeroGrid, "", x )
