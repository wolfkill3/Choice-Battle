//set n0=CreateUnit(GetOwningPlayer(caster),0x67623031,GetUnitX(caster),GetUnitY(caster),GetUnitFacing(caster))

//set n=CreateUnit(p,'kaT1',x+300*Cos(a2),y+300*Sin(a2),a*bj_RADTODEG)

call UnitSize(n0,1,1,1)
call SetUnitFlyHeight(n0,0,0)
