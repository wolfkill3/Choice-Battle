set t=null
endfunction
function TJeanneCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real di=GetRandomReal(0,7)
local real a=Atan2(y1-y,x1-x)
local real sc=0
local real is=0
local real ig=30*bj_DEGTORAD
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,5,c)
call SaveReal(h,id,2,di)
call SaveReal(h,id,3,a)
call SaveReal(h,id,4,0.2)
call SaveInteger(h,id,5,1)
call SetUnitTimeScale(u,1)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
loop
exitwhen is>=13
set n=CreateUnit(p,'e0ZH',x+200*Cos(ig*is),y+200*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,255,255,255,55)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,1)
set is=is+1
endloop
// set n=CreateUnit(p,'e12Q',x,y,a*bj_RADTODEG)
// call SetUnitTimeScale(n,0.5)
// call UnitApplyTimedLife(n,'BTLF',1.5)
set n=CreateUnit(p,'e0RV',x,y,a*bj_RADTODEG)
call SetUnitTimeScale(n,0.5)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitScale(n,0.75,0.75,0.75)
call SetUnitVertexColor(n,255,255,255,175)
call DestroyEffect(AddSpecialEffect("war3mapImported\\LW10.mdl",x,y))
set soundplay=SndN(2690) // Sound\Music\mp3Music\Alter Jeanne d'Arc Noble Phantasm.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,1.5,false,function TJeanneCast22)
set u=null
set p=null
set t=null
set c=null
endfunction
