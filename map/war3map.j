function SpiritSwordsCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)*bj_DEGTORAD
local group g=LoadGroupHandle(h,GetHandleId(u),SH_vg)
if GetUnitAbilityLevel(u,'B046')>0 and FirstOfGroup(g)!=null then
set E=LoadUnitHandle(h,id,1)
if UnitIsAlive(E)and GetUnitAbilityLevel(E,'A08I')==0 then
call SetUnitX(E,x+70*Cos(f+deg90))
call SetUnitY(E,y+70*Sin(f+deg90))
call SetUnitFacing(E,f*bj_RADTODEG)
endif
set E=LoadUnitHandle(h,id,2)
if UnitIsAlive(E)and GetUnitAbilityLevel(E,'A08I')==0 then
call SetUnitX(E,x-70*Cos(f+deg90))
call SetUnitY(E,y-70*Sin(f+deg90))
call SetUnitFacing(E,f*bj_RADTODEG)
endif
set E=LoadUnitHandle(h,id,3)
if UnitIsAlive(E)and GetUnitAbilityLevel(E,'A08I')==0 then
call SetUnitX(E,x+100*Cos(f+deg90))
call SetUnitY(E,y+100*Sin(f+deg90))
call SetUnitFacing(E,f*bj_RADTODEG)
endif
set E=LoadUnitHandle(h,id,4)
if UnitIsAlive(E)and GetUnitAbilityLevel(E,'A08I')==0 then
call SetUnitX(E,x-100*Cos(f+deg90))
call SetUnitY(E,y-100*Sin(f+deg90))
call SetUnitFacing(E,f*bj_RADTODEG)
endif
set E=LoadUnitHandle(h,id,5)
if UnitIsAlive(E)and GetUnitAbilityLevel(E,'A08I')==0 then
call SetUnitX(E,x+70*Cos(f+deg90))
call SetUnitY(E,y+70*Sin(f+deg90))
call SetUnitFacing(E,f*bj_RADTODEG)
endif
set E=LoadUnitHandle(h,id,6)
if UnitIsAlive(E)and GetUnitAbilityLevel(E,'A08I')==0 then
call SetUnitX(E,x-70*Cos(f+deg90))
call SetUnitY(E,y-70*Sin(f+deg90))
call SetUnitFacing(E,f*bj_RADTODEG)
endif
else
call DestroyGroup(g)
set E=LoadUnitHandle(h,id,1)
if GetUnitAbilityLevel(E,'A08I')==0 then
call RemoveUnit(E)
endif
set E=LoadUnitHandle(h,id,2)
if GetUnitAbilityLevel(E,'A08I')==0 then
call RemoveUnit(E)
endif
set E=LoadUnitHandle(h,id,3)
if GetUnitAbilityLevel(E,'A08I')==0 then
call RemoveUnit(E)
endif
set E=LoadUnitHandle(h,id,4)
if GetUnitAbilityLevel(E,'A08I')==0 then
call RemoveUnit(E)
endif
set E=LoadUnitHandle(h,id,5)
if GetUnitAbilityLevel(E,'A08I')==0 then
call RemoveUnit(E)
endif
set E=LoadUnitHandle(h,id,6)
if GetUnitAbilityLevel(E,'A08I')==0 then
call RemoveUnit(E)
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set u=null
set t=null
endfunction
function SpiritSwordsCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)*bj_DEGTORAD
local player p=GetOwningPlayer(u)
local group g=CreateGroup()
local integer ty='e0O0'
call SaveUnitHandle(h,id,0,u)
set n=CreateUnit(p,ty,x+70*Cos(f+deg90),y+70*Sin(f+deg90),f*bj_RADTODEG)
call GroupAddUnit(g,n)
call SaveUnitHandle(h,id,1,n)
set n=CreateUnit(p,ty,x-70*Cos(f+deg90),y-70*Sin(f+deg90),f*bj_RADTODEG)
call GroupAddUnit(g,n)
call SaveUnitHandle(h,id,2,n)
set n=CreateUnit(p,ty,x+100*Cos(f+deg90),y+100*Sin(f+deg90),f*bj_RADTODEG)
call SetUnitFlyHeight(n,120,0)
call SaveUnitHandle(h,id,3,n)
call GroupAddUnit(g,n)
set n=CreateUnit(p,ty,x-100*Cos(f+deg90),y-100*Sin(f+deg90),f*bj_RADTODEG)
call SetUnitFlyHeight(n,120,0)
call SaveUnitHandle(h,id,4,n)
call GroupAddUnit(g,n)
set n=CreateUnit(p,ty,x+70*Cos(f+deg90),y+70*Sin(f+deg90),f*bj_RADTODEG)
call SetUnitFlyHeight(n,180,0)
call SaveUnitHandle(h,id,5,n)
call GroupAddUnit(g,n)
set n=CreateUnit(p,ty,x-70*Cos(f+deg90),y-70*Sin(f+deg90),f*bj_RADTODEG)
call SetUnitFlyHeight(n,180,0)
call SaveUnitHandle(h,id,6,n)
call GroupAddUnit(g,n)
call SaveGroupHandle(h,GetHandleId(u),SH_vg,g)
call GroupRemoveUnit(g,u)
if GetRandomInt(0, 1)==0 then
        set soundplay=SndN(1759) // Sound\Music\mp3Music\VergilW.mp3
