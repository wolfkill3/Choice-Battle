function ShieldaWCast4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real a=LoadReal(h,id,4)
local real dist=LoadReal(h,id,11)
local real x=GetUnitX(l__d)+75*Cos(a)
local real y=GetUnitY(l__d)+75*Sin(a)
local real dmg=(2+GetUnitAbilityLevel(u,'A1DK'))*GetHeroStr(u,true)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,10)
if dist>0 then
call SetUnitXY_1(l__d,x,y, false)
set n=CreateUnit(p,'e0YE',x,y,(a+180*bj_DEGTORAD)*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitScale(n,3,3,3)
call DestroyEffect(AddSpecialEffect("war3mapImported\\EarthSmash.mdx",x+GetRandomReal(-150,150),y+GetRandomReal(-150,150)))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\EarthQuake\\EarthQuakeTarget.mdl",x+GetRandomReal(-150,150),y+GetRandomReal(-150,150)))
call GroupEnumUnitsInRange(g,x,y,250,Base)
set idg=GetHandleId(g)
call SaveReal(h,id,11,dist-75)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
call SlowUnit(u,E,0.5,0,5,0,false)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
else
call RemoveUnit(l__d)
call FlushChildHashtable(h,GetHandleId(g))
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,idg)
endif
set g=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
