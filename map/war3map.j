function RKiyoCast4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local unit d1=LoadUnitHandle(h,id,11)
local real dmg=0.15*(1+GetUnitAbilityLevel(u,'Ao7B'))*GetHeroStr(u,true)
local real x=LoadReal(h,id,3)
local real y=LoadReal(h,id,4)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real x2=0
local real y2=0
local real a=Atan2(y-y1,x-x1)
local real time=LoadReal(h,id,7)+0.03
local real time2=LoadReal(h,id,12)+0.03
local integer act=LoadInteger(h,id,13)
local real dist=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
local real rad=LoadReal(h,id,5)-5
if dist<2.7 then
call SaveReal(h,id,7,time)
call SaveReal(h,id,12,time2)
call SetUnitX(d1,x1)
call SetUnitY(d1,y1)
if dist==0.21 then
set n=CreateUnit(p,'eo9G',x1,y1,a*bj_RADTODEG)
call SetUnitTimeScale(n,0.2)
call UnitApplyTimedLife(n,1,3)
endif
if time>0.05 then
set n=CreateUnit(p,'eo9E',x1,y1,a*bj_RADTODEG)
call SetUnitFlyHeight(n,LoadReal(h,id,6),0)
call SetUnitScale(n,1.4,1.4,1.4)
call UnitApplyTimedLife(n,1,1.2-dist/3)
call SaveReal(h,id,7,0)
endif
if time2>0.2 then
set n=CreateUnit(p,'e169',x,y,a*bj_RADTODEG)
call SetUnitFlyHeight(n,LoadReal(h,id,6),0)
call SetUnitScale(n,1.3,1.3,1.3)
call UnitApplyTimedLife(n,1,1.7-dist/2.3)
call SaveReal(h,id,12,0)
endif
call SetUnitFlyHeight(l__d,LoadReal(h,id,6),0)
call SetUnitFacingInstant(d1,a*bj_RADTODEG)
call SetUnitFlyHeight(d1,LoadReal(h,id,6),0)
call SaveReal(h,id,2,dist+0.03)
if dist>2.5 then
call SaveInteger(h,id,13,4)
endif
if act == 0 then
call SaveReal(h,id,6,LoadReal(h,id,6)+27)
set x2=x1+48*Cos(a+95*bj_DEGTORAD)
set y2=y1+48*Sin(a+95*bj_DEGTORAD)
call SetUnitX(l__d,x2)
call SetUnitY(l__d,y2)
call SetUnitFacingInstant(l__d,a*bj_RADTODEG+95)
if GetUnitFlyHeight(l__d)>420 or SR(x,y,x1,y1)>420 then
call SaveInteger(h,id,13,1)
set x2=x1+50*Cos(a+55*bj_DEGTORAD)
set y2=y1+50*Sin(a+55*bj_DEGTORAD)
call SetUnitX(l__d,x2)
call SetUnitY(l__d,y2)
call SetUnitFacingInstant(l__d,a*bj_RADTODEG+75)
endif
elseif act == 1 then
set x2=x1+50*Cos(a+80*bj_DEGTORAD)
set y2=y1+50*Sin(a+80*bj_DEGTORAD)
call SetUnitX(l__d,x2)
call SetUnitY(l__d,y2)
call SetUnitFacingInstant(l__d,a*bj_RADTODEG+80)
call SaveReal(h,id,6,LoadReal(h,id,6)-21)
if GetUnitFlyHeight(l__d)<20 or SR(x,y,x1,y1)>420 then
call SaveInteger(h,id,13,2)
endif
elseif act == 2 then
call SaveReal(h,id,6,LoadReal(h,id,6)+30)
set x2=x1+42*Cos(a+100*bj_DEGTORAD)
set y2=y1+42*Sin(a+100*bj_DEGTORAD)
call SetUnitX(l__d,x2)
call SetUnitY(l__d,y2)
call SetUnitFacingInstant(l__d,a*bj_RADTODEG+100)
if GetUnitFlyHeight(l__d)>420 or SR(x,y,x1,y1)>420 then
call SaveInteger(h,id,13,3)
set x2=x1+50*Cos(a+55*bj_DEGTORAD)
set y2=y1+50*Sin(a+55*bj_DEGTORAD)
call SetUnitX(l__d,x2)
call SetUnitY(l__d,y2)
call SetUnitFacingInstant(l__d,a*bj_RADTODEG+75)
endif
elseif act == 3 then
set x2=x1+53*Cos(a+75*bj_DEGTORAD)
set y2=y1+53*Sin(a+75*bj_DEGTORAD)
call SetUnitX(l__d,x2)
call SetUnitY(l__d,y2)
call SetUnitFacingInstant(l__d,a*bj_RADTODEG+75)
call SaveReal(h,id,6,LoadReal(h,id,6)-23)
if GetUnitFlyHeight(l__d)<20 or SR(x,y,x1,y1)>420 then
call SaveInteger(h,id,13,0)
endif
elseif act == 4 then
set x2=x1+35*Cos(a+20*bj_DEGTORAD)
set y2=y1+35*Sin(a+20*bj_DEGTORAD)
call SetUnitX(l__d,x2)
call SetUnitY(l__d,y2)
call SetUnitFacingInstant(l__d,a*bj_RADTODEG+20)
call SaveReal(h,id,6,LoadReal(h,id,6)-34)
endif
call SaveReal(h,id,5,rad)
if dist>0.2 then
if ModuloReal(dist,0.15)<0.04 then
call GroupEnumUnitsInRange(G,x,y,550,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call SetUnitAnimation(E,"death")
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(u,E,0.04,"stun")
endif
call GroupRemoveUnit(G,E)
endloop
endif
endif
else
set EFF=AddSpecialEffect("model (62).mdx", x1, y1)
call SetSpecialEffectScale(EFF , 2)
call DestroyEffect(EFF)
call RemoveUnit(l__d)
call KillUnit(d1)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set l__d=null
set d1=null
set p=null
set t=null
endfunction
function RKiyoCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local unit d1=LoadUnitHandle(h,id,11)
local real x=LoadReal(h,id,3)
local real y=LoadReal(h,id,4)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real x2=0
local real y2=0
local real a=Atan2(y-y1,x-x1)
local real time=LoadReal(h,id,7)+0.03
local real dist=LoadReal(h,id,2)
local real ig=15*bj_DEGTORAD
local real is=0
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>250 then
set x1=x1+65*Cos(a-11*bj_DEGTORAD)
set y1=y1+65*Sin(a-11*bj_DEGTORAD)
call SetUnitXY_1(d1,x1,y1, false)
set x2=x1+65*Cos(a-11*bj_DEGTORAD)
set y2=y1+65*Sin(a-11*bj_DEGTORAD)
call SetUnitXY_1(l__d,x1,y1, false)
call SetUnitFacingInstant(d1,a*bj_RADTODEG-11)
call SetUnitFacingInstant(l__d,a*bj_RADTODEG-11)
call SaveReal(h,id,7,time)
if time>0.05 then
    set n=CreateUnit(p,'eo9E',x1,y1,a*bj_RADTODEG)
    call SetUnitFlyHeight(n,290,0)
    call SetUnitScale(n,1.4,1.4,1.4)
    call UnitApplyTimedLife(n,1,1.2)
    call SaveReal(h,id,7,0)
endif
else
loop
exitwhen is>=25 //nitu
