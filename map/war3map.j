function GinT_AddStack takes unit newCaster, unit newTarget returns nothing
        local integer id_target = GetHandleId(newTarget)
        local integer GinTStack = LoadInteger(HH, id_target, StringHash("GinT_Stack"))
        if GinTStack<5 and GetUnitAbilityLevel(newCaster, 'GinT')>=1 then
                if IsUnitInvulnerable(newTarget)==false then
                        call SaveInteger(HH, id_target, StringHash("GinT_Stack"), GinTStack+1)
                        if LoadUnitHandle(HH, id_target, StringHash("GinT_Indicator"))==null then
                                set bjLCU = CreateUnit(GetOwningPlayer(newTarget), 'dGiT', GetUnitX(newTarget), GetUnitY(newTarget), 270)
                                call SetUnitScale(bjLCU, 2, 2, 2)
                                call SetUnitFlyHeight(bjLCU, GetUnitFlyHeight(newTarget)+300, 0)
                                call SaveUnitHandle(HH, id_target, StringHash("GinT_Indicator"), bjLCU)
                                set bjLCT = CreateTimer()
                                call SaveUnitHandle(HH, GetHandleId(bjLCT), TargetHash, newTarget)
                                call TimerStart(bjLCT, 0.01, true, function GinT_StackPeriodic)
                                set bjLCT = null
                        endif
                endif
        endif
endfunction

function Trig_Text_Damage_Actions takes nothing returns nothing
local real b=GetEventDamage()
local timer t
local timer tres
local timer tlambo
local timer tyam
local unit c=GetEventDamageSource()
local unit u=GetTriggerUnit()
local real l=GetWidgetLife(u)
local real m=GetUnitState(u,UNIT_STATE_MANA)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local boolean CurrentEventAttack= (GetEventIsAttack() or BitwiseAND( GetEventDamageFlags(), 0x100 ) > 0)
local unit n3
local real x3
local real y3
local real dmg
local string dmgtext=""
local integer idt
local real a=Atan2(y-y1,x-x1)
local real a2=Atan2(y1-y,x1-x)
local integer lvl
local integer idc=GetPlayerId(GetOwningPlayer(c))
local integer idu=GetPlayerId(GetOwningPlayer(u))
local integer pb=StringHash("pblock")
local integer uid=GetHandleId(u)
local integer cid=GetHandleId(c)
local real f=GetUnitFacing(c)
local real critcoef
local real r
local integer FI
local real mm=GetUnitState(u,UNIT_STATE_MAX_MANA)
local real ll=GetUnitState(u,UNIT_STATE_MAX_LIFE)
local real nb
local integer cond=0
local integer i=0
local integer numb=0
local real basedmg=0
local real newdmg=0
local timer cjlocgn_00000000
local integer cjlocgn_00000001
//madara choice random int
local real randomint0=0
//end madara choice random int
// black goku var
local real bgreal=0
local real tdamage=0
local real ragebase=0
local integer ragecount=0
//local boolean fullrage=false
//
set nb=b
set critcoef=1
call UnitRemoveAbility(u,'cbc7')
if GetUnitAbilityLevel(c,'Bwk1')>0 and nb>0 then
    call SaveReal(HH,GetHandleId(bufh),0,b)
    call HandleListEnumUnitBuffs(bufh,c,Condition(function WeakenBool))
    call HandleListForEach(bufh,function Weaken)
    call SetEventDamage(LoadReal(HH,GetHandleId(bufh),0))
    call FlushChildHashtable(HH,GetHandleId(bufh))
    call HandleListClear(bufh)
    set b=GetEventDamage()
    set nb=b
endif
if GetUnitAbilityLevel(c,'BAr2')>0 and nb>0 then 
    call SetEventDamage(nb*0.85) 
    set b=GetEventDamage()
    set nb=b               
endif

if GetUnitAbilityLevel(c,'BAr1')>0 and nb>0 then 
    call SetEventDamage(nb*1.15) 
    set b=GetEventDamage()
    set nb=b                    
endif

if GetUnitAbilityLevel(c,'KkR3')>0 and nb>0 then //курапика цепи уменьшение наносимого урона цели
//call SetUnitState(GetTriggerUnit(),UNIT_STATE_LIFE,GetWidgetLife(GetTriggerUnit())+nb*0.4)
    call SetEventDamage(nb*0.6) 
    set b=GetEventDamage()
    set nb=b                  
endif

if GetUnitAbilityLevel(c,'KkR4')>0 and nb>0 then //курапика увеличение урона союзника курапики
    call SetEventDamage(nb*1.2) 
    set b=GetEventDamage()
    set nb=b  
endif
if CurrentEventAttack and GetUnitAbilityLevel(c,'A1F5')>0 then        // Гильгамеш блок обычных автух
    call newBlockDamage(u)
    set nb=0
endif
if (LoadReal(HH,GetHandleId(c),StringHash("yamato"))==1 or GetRandomInt(0,100)<15) and (UnitHasItemOfTypeBJ(c,'I02V') or GetUnitAbilityLevel(c,'KIG4')>0) and CurrentEventAttack and IsUnitType(c, UNIT_TYPE_HERO) and IsUnitIllusion(c)==false and GetUnitAbilityLevel(c,'A3WR')==0 then
    call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",u,"chest"))
    call SaveReal(HH,GetHandleId(c),StringHash("yamato"),0)
    set critcoef=critcoef+2
    set n3=CreateUnit(Player(14),GetUnitTypeId(c),x+100,y+100,GetUnitFacing(u))
    call SetUnitFacing(n3,Atan2(GetUnitY(n3)-y,GetUnitX(n3)-x)*bj_RADTODEG)
    call UnitAddAbility(n3,'Aloc')
    call UnitAddAbility(n3,'A0GN')
    call SetUnitX(n3,x-100)
    call SetUnitY(n3,y-100)
    call UnitApplyTimedLife(n3,0,0.3)
    call SetUnitVertexColor(n3,255,255,255,140)
    call IssueTargetOrder(n3,"attack",u)
    set n3=CreateUnit(Player(14),GetUnitTypeId(c),x-100,y-100,GetUnitFacing(u))
    call SetUnitFacing(n3,Atan2(GetUnitY(n3)-y,GetUnitX(n3)-x)*bj_RADTODEG)
    call UnitAddAbility(n3,'Aloc')
    call UnitAddAbility(n3,'A0GN')
    call SetUnitX(n3,x+100)
    call SetUnitY(n3,y+100)
    call UnitApplyTimedLife(n3,0,0.3)
    call SetUnitVertexColor(n3,255,255,255,140)
    call IssueTargetOrder(n3,"attack",u)
    set n3=CreateUnit(Player(14),GetUnitTypeId(c),x-100,y+100,GetUnitFacing(u))
    call SetUnitFacing(n3,Atan2(GetUnitY(n3)-y,GetUnitX(n3)-x)*bj_RADTODEG)
    call UnitAddAbility(n3,'Aloc')
    call UnitAddAbility(n3,'A0GN')
    call SetUnitX(n3,x+100)
    call SetUnitY(n3,y-100)
    call UnitApplyTimedLife(n3,0,0.3)
    call SetUnitVertexColor(n3,255,255,255,140)
    call IssueTargetOrder(n3,"attack",u)
    set n3=CreateUnit(Player(14),GetUnitTypeId(c),x+100,y-100,GetUnitFacing(u))
    call SetUnitFacing(n3,Atan2(GetUnitY(n3)-y,GetUnitX(n3)-x)*bj_RADTODEG)
    call UnitAddAbility(n3,'Aloc')
    call UnitAddAbility(n3,'A0GN')
    call SetUnitX(n3,x-100)
    call SetUnitY(n3,y+100)
    call UnitApplyTimedLife(n3,0,0.3)
    call SetUnitVertexColor(n3,255,255,255,140)
    call IssueTargetOrder(n3,"attack",u)
    if GetUnitTypeId(c)!='H04U' then
        call SetUnitX(c,x+100*Cos(a2))
        call SetUnitY(c,y+100*Sin(a2))
    endif
endif
if GetRandomInt(0,100)<15 and (UnitHasItemOfTypeBJ(c,'I01J') or GetUnitAbilityLevel(c,'KI06')>0) and CurrentEventAttack and IsUnitType(c, UNIT_TYPE_HERO) and IsUnitIllusion(c)==false and GetUnitAbilityLevel(c,'A3WR')==0 then
    set critcoef=critcoef+0.5
endif
if GetRandomInt(0,100)<15 and (UnitHasItemOfTypeBJ(c,'I01I') or GetUnitAbilityLevel(c,'KI08')>0) and CurrentEventAttack and IsUnitType(c, UNIT_TYPE_HERO) and IsUnitIllusion(c)==false and GetUnitAbilityLevel(c,'A3WR')==0 then
    set critcoef=critcoef+0.75
endif
if GetRandomInt(0,100)<15 and (UnitHasItemOfTypeBJ(c,'I01K') or GetUnitAbilityLevel(c,'KI10')>0) and CurrentEventAttack and IsUnitType(c, UNIT_TYPE_HERO) and IsUnitIllusion(c)==false and GetUnitAbilityLevel(c,'A3WR')==0 then
    set critcoef=critcoef+1
endif
if GetRandomInt(0,100)<15 and (UnitHasItemOfTypeBJ(c,'I01L') or GetUnitAbilityLevel(c,'KI12')>0) and CurrentEventAttack and IsUnitType(c, UNIT_TYPE_HERO) and IsUnitIllusion(c)==false and GetUnitAbilityLevel(c,'A3WR')==0 then
    set critcoef=critcoef+1
endif
if GetRandomInt(0,100)<20 and (UnitHasItemOfTypeBJ(c,'I01O') or GetUnitAbilityLevel(c,'KI14')>0) and CurrentEventAttack and IsUnitType(c, UNIT_TYPE_HERO) and IsUnitIllusion(c)==false and GetUnitAbilityLevel(c,'A3WR')==0 then
    set critcoef=critcoef+1
endif
if GetRandomInt(0,100)<20 and (UnitHasItemOfTypeBJ(c,'I01Q') or GetUnitAbilityLevel(c,'KI16')>0) and CurrentEventAttack and IsUnitType(c, UNIT_TYPE_HERO) and IsUnitIllusion(c)==false and GetUnitAbilityLevel(c,'A3WR')==0 then
    set critcoef=critcoef+1
endif
if GetRandomInt(0,100)<30 and (UnitHasItemOfTypeBJ(c,'I01S') or GetUnitAbilityLevel(c,'KI18')>0) and CurrentEventAttack and IsUnitType(c, UNIT_TYPE_HERO) and IsUnitIllusion(c)==false and GetUnitAbilityLevel(c,'A3WR')==0 then
    set critcoef=critcoef+1
endif
if GetRandomInt(0,100)<20 and (UnitHasItemOfTypeBJ(c,'I01U') or GetUnitAbilityLevel(c,'KI20')>0) and CurrentEventAttack and IsUnitType(c, UNIT_TYPE_HERO) and IsUnitIllusion(c)==false and GetUnitAbilityLevel(c,'A3WR')==0 then
    set critcoef=critcoef+1
endif
if GetRandomInt(0,100)<15 and (UnitHasItemOfTypeBJ(c,'IBSI') or GetUnitAbilityLevel(c,'KI0Y')>0) and CurrentEventAttack and IsUnitType(c, UNIT_TYPE_HERO) and IsUnitIllusion(c)==false and GetUnitAbilityLevel(c,'A3WR')==0 then
    set critcoef=critcoef+1
endif
if GetRandomInt(0,100)<7.5+3.5*GetUnitAbilityLevel(c,'A0IR') and GetUnitAbilityLevel(c,'A0IR')>0 and CurrentEventAttack and IsUnitType(c, UNIT_TYPE_HERO) and IsUnitIllusion(c)==false and GetUnitAbilityLevel(c,'A3WR')==0 and GetHeroLevel(c)>5 then
    set critcoef=critcoef+1
endif
if GetRandomInt(0,100)<15 and GetUnitAbilityLevel(c,'CS02')>0 and CurrentEventAttack and IsUnitType(c, UNIT_TYPE_HERO) and IsUnitIllusion(c)==false and GetUnitAbilityLevel(c,'A3WR')==0 and GetHeroLevel(c)>5 then
    set critcoef=critcoef+1
endif
if GetRandomInt(0,100)<30 and GetUnitAbilityLevel(c,'WAE1')>0 and CurrentEventAttack and IsUnitType(c, UNIT_TYPE_HERO) and IsUnitIllusion(c)==false and GetUnitAbilityLevel(c,'A3WR')==0 then
    set critcoef=critcoef+0.5
endif
if b>l and GetUnitTypeId(u)=='H03T' or GetUnitTypeId(u)=='H03W' or GetUnitTypeId(u)=='H03S' or GetUnitTypeId(u)=='H03V' or GetUnitTypeId(u)=='H03U' and LoadBoolean(h,GetHandleId(Hero[idu]),StringHash("alive"))==true then
    call SetUnitInvulnerable(u,true)
    call SetUnitState(u,UNIT_STATE_LIFE,1)
    call UnitAddAbility(u,'A0QL')
    call UnitAddAbility(u,'Aeth')
    call PauseUnit(u,true)
    call SetUnitAnimation(u,"Death")
    set n=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE),'h019',x,y,GetRandomReal(0,359))
    call UnitAddAbility(n,'A0VZ')
    call IssueTargetOrder(n,"magicleash",u)
    set nb=0
else
if (not((GetUnitAbilityLevel(u,'A0IH')==0 and GetUnitAbilityLevel(c,'A0IH')==0) or (GetUnitAbilityLevel(u,'A0IH')>0 and GetUnitAbilityLevel(c,'A0IH')>0)) and GetUnitAbilityLevel(c,'Aloc')==0 and nb>0) or GetUnitAbilityLevel(u,'A295')>0 then
call newBlockDamage(u)
set nb=0
endif
if (GetUnitAbilityLevel(u,'A14J')>0  and (nb>200 or CurrentEventAttack)) or (GetUnitAbilityLevel(u,'A24J')>0 and (nb>200 or CurrentEventAttack)) or (GetUnitAbilityLevel(u,'A34J')>0 and (nb>200 or CurrentEventAttack)) then
    if GetUnitAbilityLevel(u,'A34J')>0 then
        if GetHeroLevel(u)>=35 and LoadBoolean(HH,GetHandleId( GetOwningPlayer(u) ),MUIAvailableHash)==false then
