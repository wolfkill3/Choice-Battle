function PushTimed1Hibari takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local real facing=LoadReal(HH,id,3)
local real speed=LoadReal(HH,id,2)
local real dist=LoadReal(HH,id,6)
if dist>0 then
call MoveUnit(LoadUnitHandle(HH,id,1),LoadUnitHandle(HH,id,1),-speed,facing)
call SaveReal(HH,id,6,dist-speed)
call SaveReal(HH,id,2,speed-speed*0.03)
else
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
endfunction
function PushTimedHibari takes unit caster0,real facing0,real speed,real dist returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(HH,id,1,caster0)
call SaveReal(HH,id,6,dist)
call SaveReal(HH,id,2,speed)
call SaveReal(HH,id,3,facing0)
