call UnitApplyTimedLife(CreateUnit(p,'e0F5',x+GetRandomReal(-450,450),y+GetRandomReal(-450,450),0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0F5',x+GetRandomReal(-450,450),y+GetRandomReal(-450,450),0),'BTLF',3)
