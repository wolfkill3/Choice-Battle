local real dmg=(GetUnitAbilityLevel(u,'A15P')+4)*GetHeroInt(u,true)
call GroupEnumUnitsInRange(g,x,y,900,b)
loop
exitwhen i>24
set r=(i*15)*bj_DEGTORAD
set x1=x+300*Cos(r)
set y1=y+300*Sin(r)
set n=CreateUnit(p,'e0YE',x1,y1,Atan2(y-y1,x-x1)*bj_RADTODEG)
