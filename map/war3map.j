function OrochimaruQCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local real dmg=60+GetHeroInt(u,true)*(GetUnitAbilityLevel(u,'ore7')+1)
    local real x=LoadReal(h,id,4)
    local real y=LoadReal(h,id,5)
    local real a=LoadReal(h,id,3)
    local real dist=LoadReal(h,id,2)
    local real sc1=LoadReal(h,id,6)
    local real sc2=LoadReal(h,id,7)
    local real rad=LoadReal(h,id,8)
    local real per=LoadReal(h,id,9)
    local real he=LoadReal(h,id,10)
    local group g=LoadGroupHandle(h,id,11)
    local real k=1.15
    local player p=GetOwningPlayer(u)
    if dist<2000 then
    set x=x+per*Cos(a)
    set y=y+per*Sin(a)
    call SaveReal(h,id,4,x)
    call SaveReal(h,id,5,y)
    call SaveReal(h,id,2,dist+per)
    call SaveReal(h,id,6,sc1*k)
    call SaveReal(h,id,7,sc2*k)
    call SaveReal(h,id,8,rad*1.12)
    call SaveReal(h,id,9,per*k)
    call SaveReal(h,id,10,he*k)
    if dist<1700 then
    set n=CreateUnit(p,0x6F723035,x,y,a*bj_RADTODEG)
    call SetUnitVertexColor(n,255,255,255,35)
    call SetUnitFlyHeight(n,he,0)
    call SetUnitScale(n,sc1,sc1,sc1)
    call UnitApplyTimedLife(n,1,0.3)
    endif
    set n=CreateUnit(p,0x6F723036,x,y,a*bj_RADTODEG)
    call SetUnitVertexColor(n,255,255,255,125)
    call SetUnitFlyHeight(n,he,0)
    call SetUnitTimeScale(n,3)
    call SetUnitScale(n,sc2,sc2,sc2)
    call UnitApplyTimedLife(n,1,0.3)
    call GroupEnumUnitsInRange(g,x,y,rad,Base)
    set idg=GetHandleId(g)
    loop
    set E=FirstOfGroup(g)
    set ide=GetHandleId(E)
    exitwhen E==null
    if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
    call myCustomDamage(u,E,dmg,false,false,null,null,null)
    call SaveUnitHandle(h,idg,ide,E)
    endif
    call GroupRemoveUnit(g,E)
    endloop
    elseif dist>2000 then
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(h,id)
    call FlushChildHashtable(h,idg)
    call DestroyGroup(g)
    endif
    set u=null
    set p=null
    set t=null
endfunction
