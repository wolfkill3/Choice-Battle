call TriggerRegisterAnyUnitEventBJ(gg_trg_Paper,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_Paper,Condition(function PaperCond))
call TriggerAddAction(gg_trg_Paper,function PaperCast)
endfunction
function InoriDieCond takes nothing returns boolean
return(GetUnitTypeId(GetTriggerUnit())=='H04C' or GetUnitTypeId(GetTriggerUnit())=='H04D')and udg_B==true and DU==true and UnitIsAlive(GetTriggerUnit())==false
endfunction
function InoriDieCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(c)
local real y=GetUnitY(c)
local real heal=0.02*GetHeroInt(u,true)
local sound l__s=LoadSoundHandle(h,id,4)
local player p=GetOwningPlayer(u)
if udg_B==true and DU==true and GetHeroLevel(u)>=12 and IsUnitAlive(u)==false then
call GroupEnumUnitsInRange(G,x,y,100000,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if IsUnitAlly(E,p)then
call HealTextTag(u,E,heal*myCustomHeal2(E,1),"HealthRes")
call SetUnitState(E,UNIT_STATE_LIFE,GetWidgetLife(E)+heal)
endif
call GroupRemoveUnit(G,E)
endloop
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,0.65,0.65,0.65)
call SetUnitVertexColor(n,180,75,255,50)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,130,25,200,30)
else
call RemoveUnit(c)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call StopSound(l__s,false,true) // звук из массива — останавливаем, не удаляем
call SetUnitTimeScale(u,1)
endif
set p=null
set u=null
set t=null
set c=null
set l__s=null
endfunction
