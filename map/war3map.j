function LucyAquariusCond takes nothing returns boolean
return GetSpellAbilityId()=='A1EM'
endfunction
function LucyAquariusCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit l__d
local real dmg=GetHeroInt(u,true)*(3+GetUnitAbilityLevel(u,'A1EM'))
local real x
local real y
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=LoadReal(h,id,3)
local real f
local real rd=LoadReal(h,id,4)
local player p=GetOwningPlayer(u)
local real time=LoadReal(h,id,7)
local real dist
local integer l__ide
local group g=LoadGroupHandle(h,id,6)
local group g2=LoadGroupHandle(h,id,10)
local group g3
local integer l__idg=GetHandleId(g2)
if FirstOfGroup(g)!=null then
set g3=CopyGroup(g)
loop
set l__d=FirstOfGroup(g3)
exitwhen l__d==null
set l__ide=GetHandleId(l__d)
set dist=LoadReal(h,l__ide,0)
if dist>0 then
set f=GetUnitFacing(l__d)*bj_DEGTORAD
set x=GetUnitX(l__d)+95*Cos(f)
set y=GetUnitY(l__d)+95*Sin(f)
call SetUnitXY_1(l__d,x,y, false)
call SaveReal(h,l__ide,0,dist-95)
set n=CreateUnit(p,'e143',x,y,f*bj_RADTODEG)
call SetUnitScale(n,1,1,1)
call SetUnitTimeScale(n,2)
call UnitApplyTimedLife(n,'BTLF',0.3)
call GroupEnumUnitsInRange(GJ,x,y,300,Base)
call GroupAddGroup(GJ,g2)
else
call GroupRemoveUnit(g,l__d)
call RemoveUnit(l__d)
endif
call GroupRemoveUnit(g3,l__d)
endloop
call DestroyGroupTimed(g3,3)
loop
set E=FirstOfGroup(g2)
set l__ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)then
call SetUnitX(E,GetUnitX(E)+105*Cos(a))
call SetUnitY(E,GetUnitY(E)+105*Sin(a))
if E!=LoadUnitHandle(h,l__idg,l__ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,l__idg,l__ide,E)
endif
endif
call GroupRemoveUnit(g2,E)
endloop
else
call SetUnitTimeScale(u,1)
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
call DestroyGroup(g2)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
set c=null
set g=null
set g3=null
set l__d=null
set g2=null
set u=null
set p=null
set t=null
endfunction
function LucyAquariusCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1
local real y1
local player p=GetOwningPlayer(u)
local real a=LoadReal(h,id,3)
local integer an=-2
local group g=LoadGroupHandle(h,id,6)
set l__d=CreateUnit(p,'e144',x+155*Cos(a),y+155*Sin(a),a*bj_RADTODEG)
call SaveUnitHandle(h,id,1,l__d)
call UnitApplyTimedLife(l__d,'BTLF',3)
call SetUnitTimeScale(l__d,2)
set x1=GetUnitX(l__d)
set y1=GetUnitY(l__d)
call SetUnitAnimation(l__d,"spell")
loop
exitwhen an==3
set n=CreateUnit(p,'e143',x1+75*Cos(a),y1+75*Sin(a),a*bj_RADTODEG+20*an)
call GroupAddUnit(g,n)
call SaveReal(h,GetHandleId(n),0,1500)
set an=an+1
endloop
set n=CreateUnit(p,'e0SX',x+155*Cos(a),y+155*Sin(a),a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',.8)
call SetUnitTimeScale(n,0.8)
call SetUnitFlyHeight(n,0,0)
call SetUnitFlyHeight(n,300,300)
call SetUnitScale(n,0.7,0.7,0.7)
set n=CreateUnit(p,'e13X',x+155*Cos(a),y+155*Sin(a),a*bj_RADTODEG+90)
call UnitApplyTimedLife(n,'BTLF',1.5)
call SetUnitTimeScale(n,0.8)
call SetUnitInvulnerable(u,false)
call PauseTimer(t)
call TimerStart(t,0.04,true,function LucyAquariusCast3)
set u=null
set p=null
set l__d=null
set g=null
set t=null
endfunction
