function RemoveSaveHashTimedGogeta2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local real time=LoadReal(h,id,4)
if time<LoadReal(h,id,3)then
if GetUnitAbilityLevel(LoadUnitHandle(h,LoadInteger(h,id,1),LoadInteger(h,id,2)),'A1BJ')==0 then
call SaveReal(h,id,4,time+0.02)
endif
else
set n=LoadUnitHandle(h,id,5)
call ShowAbility2('A1P6',false)
call ShowAbility2('A0P6',true)
call RemoveSavedHandle(h,LoadInteger(h,id,1),LoadInteger(h,id,2))
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set t=null
endfunction
function RemoveSaveHashTimedGogeta takes real time,integer id,integer ip,unit u returns nothing
local timer t=CreateTimer()
local integer idt=GetHandleId(t)
call SaveInteger(h,idt,1,id)
call SaveInteger(h,idt,2,ip)
call SaveReal(h,idt,3,time)
call SaveReal(h,idt,4,0)
call SaveUnitHandle(h,idt,5,u)
call TimerStart(t,0.02,true,function RemoveSaveHashTimedGogeta2)
set t=null
endfunction
