function QKingHassanCast takes nothing returns nothing //q hassan
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local unit Elocal
local real dist=300
local real f=GetUnitFacing(u)*bj_DEGTORAD
local real dmg=GetHeroStr(u,true)*(0.5+0.5*GetUnitAbilityLevel(u,'A1GM'))+25
local integer sid=GetSpellAbilityId()
local player p=GetOwningPlayer(u)
local group g=CreateGroup()
if sid=='A1GM' then
set dist=300
set soundplay=CreateSound("Sound\\Music\\mp3Music\\KingHassanAttack1.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
elseif sid=='A1GN' then
set dist=700
set soundplay=CreateSound("Sound\\Music\\mp3Music\\KingHassanAttack2.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
elseif sid=='A1GO' then
set dist=1100
set soundplay=CreateSound("Sound\\Music\\mp3Music\\KingHassanAttack3.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
set n=CreateUnit(p,'e160',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.6)
call SetUnitTimeScale(n,1.4)
set n=CreateUnit(p,'e161',x,y,f*bj_RADTODEG)
call UnitApplyTimedLife(n,1,0.6)
call SetUnitTimeScale(n,1.4)
call SetUnitAnimationByIndex(u,5)
call SetUnitTimeScale(u,2)
call SaveUnitHandle(h,id,0,u)
set x=x+dist*Cos(f)
set y=y+dist*Sin(f)
set n=CreateUnit(p,'e162',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.8)
call SetUnitTimeScale(n,0.7)
set n=CreateUnit(p,'e163',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.8)
call SetUnitTimeScale(n,2)
set n=CreateUnit(p,'e164',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.8)
call SetUnitTimeScale(n,1)
set n=CreateUnit(p,'e165',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.8)
call SetUnitTimeScale(n,1)
call GroupEnumUnitsInRange(g,x,y,400,Base)
loop
set Elocal=FirstOfGroup(g)
exitwhen Elocal==null
if Condition_Base(p,Elocal)then
if GetUnitAbilityLevel(Elocal,'A1GP')==0 then
call UnitAddAbility(Elocal,'A1GP')
call UnitRemoveAbilityTimed(Elocal,'A1GP',7)
else
if GetUnitAbilityLevel(Elocal,'A1GP')<3 then
call SetUnitAbilityLevel(Elocal,'A1GP',GetUnitAbilityLevel(Elocal,'A1GP')+1)
endif
endif
call myCustomDamage(u,Elocal,dmg+dmg*(0.3*GetUnitAbilityLevel(Elocal,'A1GP')),false,false,null,null,null)
endif
call GroupRemoveUnit(g,Elocal)
endloop
call TimerStart(t,1,false,function QKingHassanCast2)
call DestroyGroup(g)
set Elocal=null
set g=null
set p=null
set u=null
set t=null
endfunction
