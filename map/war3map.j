    call SetHeroAgi(newTarget, GetHeroAgi(newTarget, false) + bonus_stat, false)
    call SetHeroInt(newTarget, GetHeroInt(newTarget, false) + bonus_stat, false)
    call SaveEffectHandle(h, id, Effect1Hash, AddSpecialEffectTarget("buff-obsidiandestroyer_n2s_t_target.mdl", newTarget, "origin"))
    call SaveEffectHandle(h, id, Effect2Hash, AddSpecialEffectTarget("buff-bcy1.mdl", newTarget, "origin"))
    call SaveUnitHandle(h, id, TargetHash, newTarget)
    call SaveInteger(h, id, StringHash("Bonus_Stat"), bonus_stat)
    call TimerStart(newTimer, 0.1, true, function MadokaE2_Periodic)
