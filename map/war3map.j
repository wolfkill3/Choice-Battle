function HashiramaT1Act takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local real time=LoadReal(HH,id,5)
local real time1=LoadReal(HH,id,6)
local real facing=LoadReal(HH,id,3)
local integer cjlocgn_00000000
if time<1 then
set time=time+0.02
call SaveReal(HH,id,5,time)
if time==0.02 then
set cjlocgn_00000000=R2I(GetHeroStr(caster,true)*0.02)
call SaveInteger(HH,id,30,cjlocgn_00000000)
call CreateModeIndicatorWithPauseForm(caster, "ReplaceableTextures\\CommandButtons\\BTNHashiramaT.blp", 20.0)
loop
exitwhen cjlocgn_00000000==0
call UnitAddAbility(caster,'HSHP')
call SetUnitAbilityLevel(caster,'HSHP',2)
call UnitRemoveAbility(caster,'HSHP')
//call DisplayTextToPlayer(GetLocalPlayer(),0,0,"Increase HP: "+I2S((cjlocgn_00000000))+"Times")
set cjlocgn_00000000=cjlocgn_00000000-1
endloop
call SetUnitAnimationByIndex(caster,8)
endif
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
if time==0.02 or time==0.4 or time==0.6 or time==0.9 then
call UnitCreateAndMove(caster,'hs06',caster,GetRandomReal(0,360),1.5,3,1.5,100,100,100,0,0,caster,0,facing)
call UnitCreateAndMove(caster,'hs11',caster,GetRandomReal(0,360),1.5,2.25,0.3,100,100,100,40,50,caster,0,facing)
endif
set time1=time1+0.02
if time1==0.06 then
set time1=0
call UnitCreateAndMove1(caster,'hs10',caster,GetRandomReal(0,360),1,GetRandomReal(0.5,1.25),GetRandomReal(0.5,1.25),100,100,100,GetRandomReal(80,90),0,caster,0,facing,0)
endif
call SaveReal(HH,id,6,time1)
if time>=1 then
call SaveReal(HH,id,6,0)
call UnitCreateAndMove(caster,'hs01',caster,GetRandomReal(0,360),1,1.25,0.75,100,100,100,0,0,caster,0,facing)
call UnitCreateAndMove(caster,'hs05',caster,GetRandomReal(0,360),1,1.5,1,100,100,100,0,50,caster,0,facing)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
endif
endif
if time>=1 then
if IsUnitPaused(caster)==false then
set time=time+0.02
call SaveReal(HH,id,5,time)
endif
if LoadReal(HH, GetHandleId(LoadFrameHandle(HH, GetHandleId(GetOwningPlayer(caster)),SH_ReplaceableTextures_CommandButtons_BTNHashiramaT_blp)), c_DURATION)==0 then
set cjlocgn_00000000=LoadInteger(HH,id,30)
loop
exitwhen cjlocgn_00000000==0
call UnitAddAbility(caster,'HSHR')
call SetUnitAbilityLevel(caster,'HSHR',2)
call UnitRemoveAbility(caster,'HSHR')
//call DisplayTextToPlayer(GetLocalPlayer(),0,0,"Decrease HP: "+I2S((cjlocgn_00000000))+"Times")
set cjlocgn_00000000=cjlocgn_00000000-1
endloop
call UnitAddAbility(caster, 'HST4')
call IssueImmediateOrder(caster,"bearform") 
call UnitRemoveAbility(caster, 'HST4')
call CheckUnitBonusRange(caster)
call ShowAbility2('HST3',false)
call ShowAbility2('HST2',false)
call ShowAbility2Timed('HST1',true,0.1)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
endif
set t=null
set caster=null
endfunction
function HashiramaT2Act takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
set time=time+0.02
call SaveReal(HH,id,5,time)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
if time==0.02 then
call UnitCreateAndMove(caster,'hs05',caster,GetRandomReal(0,360),1,3,1,100,100,100,0,100,caster,0,facing)
call UnitCreateAndMove(caster,'hs01',caster,GetRandomReal(0,360),1,1.25,0.75,100,100,100,0,0,caster,0,facing)
call UnitCreateAndMove(caster,'hs02',caster,GetRandomReal(0,360),1,1.5,0.5,100,100,100,0,0,caster,0,facing)
call UnitCreateAndMove(caster,'hs03',caster,GetRandomReal(0,360),1,1.5,1,100,100,100,0,0,caster,0,facing)
call SaveEffectHandle(HH,id,25,AddSpecialEffectTarget("war3mapImported\\az_alleria_e1.mdl",caster,"hand right"))
call SaveEffectHandle(HH,id,26,AddSpecialEffectTarget("war3mapImported\\az_alleria_e1.mdl",caster,"origin"))
endif
if time<0.5 then
call SetUnitFlyHeight(caster,GetUnitFlyHeight(caster)+25,0)
else
call SetUnitFlyHeight(caster,GetUnitFlyHeight(caster)-25,0)
endif
if time<=1 then
call MoveUnit(caster,caster,LoadReal(HH,id,16)*0.02,facing)
endif
if time==1 then
if LoadEffectHandle(HH,id,25)!=null then
call DestroyEffect(LoadEffectHandle(HH,id,25))
call SaveEffectHandle(HH,id,25,null)
endif
if LoadEffectHandle(HH,id,26)!=null then
call DestroyEffect(LoadEffectHandle(HH,id,26))
call SaveEffectHandle(HH,id,26,null)
endif
set soundplay=SndN(3578) // Sound\Music\mp3Music\HashiramaT2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call UnitSpeed(caster,1)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
call UnitCreateAndMove(caster,'hs01',caster,GetRandomReal(0,360),1,2.5,0.75,100,100,100,0,50,caster,100,facing)
call UnitCreateAndMove(caster,'hs02',caster,GetRandomReal(0,360),1,3,0.5,100,100,100,0,0,caster,100,facing)
call UnitCreateAndMove(caster,'hs03',caster,GetRandomReal(0,360),1,3,1,100,100,100,0,50,caster,100,facing)
call UnitCreateAndMove(caster,0x68733034,caster,GetRandomReal(0,360),1,5,0.8,100,100,100,60,100,caster,100,facing)
if GetRandomInt(1,2)==1 then
call UnitCreateAndMove(caster,0x68733037,caster,GetRandomReal(0,360),1,4,1,100,100,100,0,0,caster,100,facing)
else
call UnitCreateAndMove(caster,0x68733038,caster,GetRandomReal(0,360),1,1.75,2.5,100,100,100,0,0,caster,100,facing)
endif
call DamageAoeAndStun(caster,PolX(GetUnitX(caster),100,facing),PolY(LoadReal(HH,id,12),100,facing),500,LoadReal(HH,id,15),2)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set t=null
set caster=null
endfunction






function HashiramaT3Act takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real cjlocgn_00000000
local real cjlocgn_00000001
local real cjlocgn_00000002
set time=time+0.02
call SaveReal(HH,id,5,time)
if time>0.1 and time<0.7 then
call SetUnitFlyHeight(caster,GetUnitFlyHeight(caster)+40,0)
endif
if time==2 then
call UnitSpeed(LoadUnitHandle(HH,id,22),0)
call UnitSpeed(LoadUnitHandle(HH,id,23),0)
endif
if time==0.02 then
call UnitCreateAndMove(caster,'hs01',caster,GetRandomReal(0,360),2,3,0.75,100,100,100,40,0,caster,0,facing)
call UnitCreateAndMove(caster,'hs02',caster,GetRandomReal(0,360),2,4,0.5,100,100,100,0,0,caster,0,facing)
call UnitCreateAndMove(caster,'hs03',caster,GetRandomReal(0,360),1,4.5,1,100,100,100,0,0,caster,0,facing)
set n0=CreateUnit(GetOwningPlayer(caster),'hs33',LoadReal(HH,id,11),LoadReal(HH,id,12),GetUnitFacing(caster))
call MoveAoe1(LoadReal(HH,id,11),LoadReal(HH,id,12),n0,800,facing)
call UnitSize(n0,1.75,1,1)
call UnitSpeed(n0,0.25)
call MyRemoveUnit(n0,5)
call SaveUnitHandle(HH,id,22,n0)
set n0=CreateUnit(GetOwningPlayer(caster),'hs33',LoadReal(HH,id,11),LoadReal(HH,id,12),GetUnitFacing(caster))
call MoveAoe1(LoadReal(HH,id,11),LoadReal(HH,id,12),n0,1400,facing)
call UnitSize(n0,1.75,1,1)
call UnitSpeed(n0,0.25)
call MyRemoveUnit(n0,5)
call SaveUnitHandle(HH,id,23,n0)
set n0=null
call SaveGroupHandle(HH,id,4,CreateGroup())
set n0=CreateUnit(GetOwningPlayer(caster),'hs34',LoadReal(HH,id,11),LoadReal(HH,id,12),facing)
call SetUnitFlyHeight(n0,0,0)
call UnitSize(n0,1,1,1)
call UnitSpeed(n0,1.5)
call SetUnitAnimationByIndex(n0,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=null
call SetUnitAnimationByIndex(caster,7)
endif
if time==1.5 then
call SetUnitAnimationByIndex(LoadUnitHandle(HH,id,20),4)
endif
if time==2 then
call SetUnitAnimationByIndex(LoadUnitHandle(HH,id,20),5)
endif
if time>2 and time<5 then
set cjlocgn_00000000=PolX(LoadReal(HH,id,11),800,facing)
set cjlocgn_00000001=PolY(LoadReal(HH,id,12),800,facing)
set cjlocgn_00000002=LoadReal(HH,id,6)
set cjlocgn_00000002=cjlocgn_00000002+0.02
if cjlocgn_00000002==0.2 then
set cjlocgn_00000002=0
call DamageAoeOneTime(caster,cjlocgn_00000000,cjlocgn_00000001,900,LoadReal(HH,id,15)*0.06,LoadGroupHandle(HH,id,4))
set cjlocgn_00000000=PolX(LoadReal(HH,id,11),1400,facing)
set cjlocgn_00000001=PolY(LoadReal(HH,id,12),1400,facing)
call DamageAoeOneTime(caster,cjlocgn_00000000,cjlocgn_00000001,900,LoadReal(HH,id,15)*0.06,LoadGroupHandle(HH,id,4))
call GroupClear(LoadGroupHandle(HH,id,4))
endif

if cjlocgn_00000002==0.1 or cjlocgn_00000002==0.2 then
set cjlocgn_00000000=GetRandomInt(-600,600)
set cjlocgn_00000001=GetRandomReal(0,360)
call UnitCreateAndMove(caster,'hs35',caster,GetRandomReal(0,360),1,4,0.5,100,100,100,0,200,LoadUnitHandle(HH,id,22),cjlocgn_00000000,cjlocgn_00000001)
call UnitCreateAndMove(caster,'hs13',caster,GetRandomReal(0,360),1,2,1,100,100,100,0,190,LoadUnitHandle(HH,id,22),cjlocgn_00000000,cjlocgn_00000001)
call UnitCreateAndMove(caster,'hs36',caster,GetRandomReal(0,360),1,5,0.5,100,100,100,30,200,LoadUnitHandle(HH,id,22),cjlocgn_00000000,cjlocgn_00000001)
set cjlocgn_00000000=GetRandomInt(-600,600)
call UnitCreateAndMove(caster,'hs35',caster,GetRandomReal(0,360),1,4,0.5,100,100,100,0,200,LoadUnitHandle(HH,id,23),cjlocgn_00000000,cjlocgn_00000001)
call UnitCreateAndMove(caster,'hs13',caster,GetRandomReal(0,360),1,2,1,100,100,100,0,190,LoadUnitHandle(HH,id,23),cjlocgn_00000000,cjlocgn_00000001)
call UnitCreateAndMove(caster,'hs36',caster,GetRandomReal(0,360),1,5,0.5,100,100,100,30,200,LoadUnitHandle(HH,id,23),cjlocgn_00000000,cjlocgn_00000001)
endif

if cjlocgn_00000002==0.1 or cjlocgn_00000002==0.2 then
set cjlocgn_00000000=PolX(LoadReal(HH,id,11),800,facing)
set cjlocgn_00000001=PolY(LoadReal(HH,id,12),800,facing)
call StopAoeOneTime(caster,cjlocgn_00000000,cjlocgn_00000001,900)
set cjlocgn_00000000=PolX(LoadReal(HH,id,11),1400,facing)
set cjlocgn_00000001=PolY(LoadReal(HH,id,12),1400,facing)
call StopAoeOneTime(caster,cjlocgn_00000000,cjlocgn_00000001,900)
endif

call SaveReal(HH,id,6,cjlocgn_00000002)
endif

if time==5 then
call SetUnitAnimationByIndex(LoadUnitHandle(HH,id,20),2)
call UnitSpeed(LoadUnitHandle(HH,id,20),1.5)
endif

if time<5 then
call MoveAoe1(LoadReal(HH,id,11),LoadReal(HH,id,12),caster,0,facing)
call MoveAoe1(LoadReal(HH,id,11),LoadReal(HH,id,12),LoadUnitHandle(HH,id,20),100,facing)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
endif

if time==5 then
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
endif

if time>=5 and time<5.5 then
call SetUnitFlyHeight(caster,GetUnitFlyHeight(caster)-48,0)
endif

if time==7 or udg_B==false or DU2==false then
if LoadGroupHandle(HH,id,4)!=null then
call DestroyGroup(LoadGroupHandle(HH,id,4))
call SaveGroupHandle(HH,id,4,null)
endif
call RemoveUnit(LoadUnitHandle(HH,id,20))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif

set t=null
set caster=null
endfunction

function HashiramaChoice_Act takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit caster=GetTriggerUnit()
local real x0=GetUnitX(caster)
local real y0=GetUnitY(caster)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real facing=Angle2(x0,y0,x1,y1)
local boolean self=false
call SaveUnitHandle(HH,id,1,caster)
call SaveInteger(HH,id,5,0)
call SaveInteger(HH,id,6,0)
call SaveReal(HH,id,11,x1)
call SaveReal(HH,id,12,y1)
call SaveReal(HH,id,3,facing)


if GetSpellTargetUnit()!=null then
call SaveUnitHandle(HH,id,2,GetSpellTargetUnit())
endif
if GetSpellTargetUnit()==caster then
set self=true
endif


if GetSpellAbilityId()=='HSQ1' then

if GetHeroLevel(caster)>=35 then
call SaveBoolean(HH,id,45,true)
endif


if LoadBoolean(HH,GetHandleId(caster),SH_HashReg)==false then
call SaveReal(HH,id,15,(1+GetUnitAbilityLevel(caster,'HSQ1'))*GetHeroStr(caster,true))
else
call SaveReal(HH,id,15,GetUnitState(caster,UNIT_STATE_MAX_LIFE)*0.1+(1+GetUnitAbilityLevel(caster,'HSQ1'))*GetHeroStr(caster,true))
endif

if GetSpellTargetUnit()==caster then
set soundplay=SndN(3581) // Sound\Music\mp3Music\HashiramaQSelf.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SetUnitInvulnerable(caster,true)
call TimerStart(t,0.02,true,function HashiramaQSelfAct)
else
set soundplay=SndN(3583) // Sound\Music\mp3Music\HashiramaQ.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.02,true,function HashiramaQAct)
endif

endif


if GetSpellAbilityId()=='HSW1' then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
set soundplay=SndN(3585) // Sound\Music\mp3Music\HashiramaW.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SaveReal(HH,id,15,100+(1+GetUnitAbilityLevel(caster,'HSW1'))*GetHeroStr(caster,true))
call SaveReal(HH,id,31,GetUnitAbilityLevel(caster,'HSW1'))
call TimerStart(t,0.02,true,function HashiramaWAct)
endif

if GetSpellAbilityId()=='HSW2' then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
if GetRandomInt(1,2)==1 then
set soundplay=SndN(3587) // Sound\Music\mp3Music\HashiramaWG.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
set soundplay=SndN(3589) // Sound\Music\mp3Music\HashiramaWG1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call SaveReal(HH,id,15,GetUnitState(caster,UNIT_STATE_MAX_LIFE)*0.05*GetUnitAbilityLevel(caster,'HSW2'))
call TimerStart(t,0.02,true,function HashiramaW2Act)
endif

if GetSpellAbilityId()=='HSE1' then
call SaveReal(HH,id,15,(3+GetUnitAbilityLevel(caster,'HSE1'))*GetHeroStr(caster,true))
call SaveReal(HH,id,31,GetUnitAbilityLevel(caster,'HSE1'))
set soundplay=SndN(3591) // Sound\Music\mp3Music\HashiramaE.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.02,true,function HashiramaEAct)
endif
if GetSpellAbilityId()=='HSR1' then
call PauseUnit(caster,true)
if self==true then
call SaveInteger(HH,id,14,GetUnitAbilityLevel(caster,'HSR1'))
call SaveReal(HH,id,15,(3+GetUnitAbilityLevel(caster,'HSR1'))*GetHeroStr(caster,true))
set soundplay=SndN(3593) // Sound\Music\mp3Music\HashiramaRSelf1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.02,true,function HashiramaRSelfAct)
else
set soundplay=SndN(3595) // Sound\Music\mp3Music\HashiramaR.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SaveReal(HH,id,15,(3+GetUnitAbilityLevel(caster,'HSR1'))*GetHeroStr(caster,true))
call TimerStart(t,0.02,true,function HashiramaRAct)
endif
endif

if GetSpellAbilityId()=='HSG1' then
call UnitAddAbility(caster,'HSMP')
call SetUnitAbilityLevel(caster,'HSMP',2)
call UnitRemoveAbility(caster,'HSMP')
call UnitCreateAndMove(caster,'hs09',caster,GetRandomReal(0,360),1,2,0.5,100,100,100,20,0,LoadUnitHandle(HH,id,1),0,facing)
call UnitCreateAndMove(caster,'hs23',caster,GetRandomReal(0,360),1,1.5,0.5,100,100,100,20,0,LoadUnitHandle(HH,id,1),0,facing)
call UnitCreateAndMove(caster,'hs18',caster,GetRandomReal(0,360),1,0.6,0.8,100,100,100,0,0,LoadUnitHandle(HH,id,1),0,facing)
call UnitCreateAndMove(caster,'hs05',caster,GetRandomReal(0,360),1,1,1,100,100,100,0,0,LoadUnitHandle(HH,id,1),0,facing)
call UnitCreateAndMove(caster,'hs11',caster,GetRandomReal(0,360),1,2,0.5,100,100,100,50,0,LoadUnitHandle(HH,id,1),0,facing)
call SaveBoolean(HH,GetHandleId(caster),SH_HashReg,true)
set n0=CreateUnit(GetOwningPlayer(caster),'hs31',GetUnitX(caster),GetUnitY(caster),GetUnitFacing(caster))
call UnitSize(n0,1.5,1,1)
call SetUnitAnimationByIndex(n0,3)
call SaveUnitHandle(HH,id,20,n0)
call PauseUnit(caster,true)
call SetUnitAbilityLevel(caster,'HSC1',2)
set soundplay=SndN(3597) // Sound\Music\mp3Music\HashiramaG.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.02,true,function HashiramaGAct)
endif

if GetSpellAbilityId()=='HSF1' then
call SaveGroupHandle(HH,id,4,CreateGroup())
set soundplay=SndN(3599) // Sound\Music\mp3Music\HashiramaESelf.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.02,true,function HashiramaFAct)
endif

if GetSpellAbilityId()=='HST1' then
if GetUnitTypeId(caster)=='HHSN' then
call SaveInteger(HH,id,9,(250*R2I(GetHeroStr(caster,true)*0.02)))
set soundplay=SndN(3601) // Sound\Music\mp3Music\HashiramaT.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'HST1',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'HST3',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'HST2',true)
call UnitRemoveBuffs(caster,false,true)
call TimerStart(t,0.02,true,function HashiramaT1Act)
else
call TimerStart(t,0.02,true,function HashiramaT0Act)
endif
endif


if GetSpellAbilityId()=='HST2' then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call UnitAddAbility(caster,'Amrf')
call UnitRemoveAbility(caster,'Amrf')
call SetUnitAnimationByIndex(caster,4)
call UnitSpeed(caster,1.25)
call SaveReal(HH,id,16,SR(GetUnitX(caster),GetUnitY(caster),LoadReal(HH,id,11),LoadReal(HH,id,12))-100)
set soundplay=SndN(3603) // Sound\Music\mp3Music\HashiramaT1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SaveReal(HH,id,15,GetUnitState(caster,UNIT_STATE_MAX_LIFE)*0.30)
call TimerStart(t,0.02,true,function HashiramaT2Act)
endif

if GetSpellAbilityId()=='HST3' then
call SaveReal(HH,id,11,x0)
call SaveReal(HH,id,12,y0)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call UnitAddAbility(caster,'Amrf')
call UnitRemoveAbility(caster,'Amrf')
call SaveReal(HH,id,15,GetUnitState(caster,UNIT_STATE_MAX_LIFE)*0.45)
set soundplay=SndN(3605) // Sound\Music\mp3Music\HashiramaTG.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.02,true,function HashiramaT3Act)
endif


set t=null
set caster=null
endfunction
function HashiramaChoice_Cond takes nothing returns boolean
  local boolean cond1=GetSpellAbilityId()=='HSQ1' or GetSpellAbilityId()=='HSW1' or GetSpellAbilityId()=='HSW2' or GetSpellAbilityId()=='HSE1' or GetSpellAbilityId()=='HSR1' or GetSpellAbilityId()=='HST1' or GetSpellAbilityId()=='HST2' or GetSpellAbilityId()=='HST3' or GetSpellAbilityId()=='HSF1' or GetSpellAbilityId()=='HSG1'
        if cond1 then
                return true
        else
                return false
        endif
endfunction
function InitTrig_HashiramaChoice takes nothing returns nothing
        local trigger trig=CreateTrigger()
        local integer index
        set index=0
        loop
        call TriggerRegisterPlayerUnitEvent(trig,Player(index),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
        set index=index+1
        exitwhen index==bj_MAX_PLAYER_SLOTS
        endloop
call TriggerAddCondition(trig,Condition(function HashiramaChoice_Cond))
call TriggerAddAction(trig,function HashiramaChoice_Act)
set trig=null
endfunction


function HashiramaReheneration takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
if LoadBoolean(HH,GetHandleId(caster),SH_HashReg)==true then
call HealTextTag(caster,caster,  GetUnitState(caster,UNIT_STATE_MAX_LIFE)*.008*myCustomHeal2(caster,1),"HealthRes")
call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)+GetUnitState(caster,UNIT_STATE_MAX_LIFE)*.008)
else
call HealTextTag(caster,caster,  GetUnitState(caster,UNIT_STATE_MAX_LIFE)*.003*myCustomHeal2(caster,1),"HealthRes")
call SetUnitState(caster,UNIT_STATE_LIFE,GetUnitState(caster,UNIT_STATE_LIFE)+GetUnitState(caster,UNIT_STATE_MAX_LIFE)*.003)
endif
if GetUnitTypeId(caster)!='HHSN' and GetUnitTypeId(caster)!='HHSG' then
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set t=null
set caster=null
endfunction
function HashiramaLearnE_Cond takes nothing returns boolean
if GetLearnedSkill()=='HSE1' and IsUnitIllusion(GetTriggerUnit())==false then
return true
else
return false
endif
endfunction
function HashiramaLearnE_Act takes nothing returns nothing
local unit caster=GetTriggerUnit()
local player skillPlayer=GetOwningPlayer(caster)
local timer cjlocgn_00000000
local integer cjlocgn_00000001
if GetUnitAbilityLevel(caster,'HSE1')==1 then
set cjlocgn_00000000=CreateTimer()
set cjlocgn_00000001=GetHandleId(cjlocgn_00000000)
call SaveUnitHandle(HH,cjlocgn_00000001,1,caster)
call TimerStart(cjlocgn_00000000,1,true,function HashiramaReheneration)
endif
set caster=null
set skillPlayer=null
set cjlocgn_00000000=null
endfunction
function InitTrig_HashiramaLearnE takes nothing returns nothing
local trigger trig=CreateTrigger()
//set trig=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(trig,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(trig,Condition(function HashiramaLearnE_Cond))
call TriggerAddAction(trig,function HashiramaLearnE_Act)
set trig=null
endfunction


//========== Hashirama END

