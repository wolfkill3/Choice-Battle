function DanzoTQAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local unit Dummy=LoadUnitHandle(HH,id,20)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real time1=LoadReal(HH,id,6)
local real damage=LoadReal(HH,id,15)
local real x0=GetUnitX(Dummy)
local real y0=GetUnitY(Dummy)
local boolean DanzoTQHit=LoadBoolean(HH,id,19)
local real distance
set time=time+0.02
set distance=LoadReal(HH,id,8)
call SaveReal(HH,id,5,time)
if distance==4020 then
call DestroyGroup(LoadGroupHandle(HH,id,4))
call UnitColor(LoadUnitHandle(HH,id,20),0,0,0,100)
call MyRemoveUnit(LoadUnitHandle(HH,id,20),3)
call RemoveUnit(LoadUnitHandle(HH,id,21))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
else
if time==0.02 then
call UnitSpeed(caster,1)
if LoadBoolean(HH,GetHandleId(caster),StringHash("DanzoFBool"))==true then
call SetUnitAnimationByIndex(caster,13)
else
call SetUnitAnimationByIndex(caster,24)
endif
call UnitCreateAndMove(caster,'ds36',caster,facing,0.65,0.5,1.5,100,100,100,0,100,caster,100,facing)
call UnitCreateAndMove(caster,'ds24',caster,facing,1,1,0.8,100,100,100,0,0,caster,0,facing)
call UnitCreateAndMove(caster,'ds29',caster,facing,1,1,0.8,100,100,100,0,0,caster,0,facing)
call UnitCreateAndMove(caster,'ds27',caster,facing,1,1,0.8,100,100,100,0,0,caster,0,facing)
call UnitCreateAndMove(caster,'ds26',caster,facing,1,1.5,0.8,100,100,100,0,0,caster,0,facing)
if GetRandomInt(1,2)==1 and GetHeroLevel(caster)>12 then
call DanzoGPassive(caster,facing,GetHeroInt(caster,true)*2)
endif
endif
if time<0.5 then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
endif
if time==0.5 then
call UnitCreateAndMove(caster,'ds43',caster,facing,1,0.4,0.8,100,100,100,0,150,caster,100,facing)
call UnitCreateAndMove(caster,'ds22',caster,facing,1,0.5,0.6,100,100,100,0,100,caster,50,facing)
call SaveGroupHandle(HH,id,4,CreateGroup())
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
set n0=CreateUnit(GetOwningPlayer(caster),'ds41',GetUnitX(caster),GetUnitY(caster),facing)
call UnitSize(n0,0.8,1,1)
call MoveUnit(n0,n0,200,facing)
call SetUnitFlyHeight(n0,200,0)
call SaveUnitHandle(HH,id,21,n0)
set n0=null
set n0=CreateUnit(GetOwningPlayer(caster),0x64733434,GetUnitX(caster),GetUnitY(caster),facing)
call UnitSize(n0,0.6,1,1)
call MoveUnit(n0,n0,200,facing)
call SetUnitFlyHeight(n0,200,0)
call SaveUnitHandle(HH,id,20,n0)
call SetUnitAnimationByIndex(n0,0)
set n0=null
endif
if time>0.5 then
if DanzoTQHit==true then
call MoveUnit(Dummy,Dummy,20,facing)
call MoveUnit(Dummy,LoadUnitHandle(HH,id,21),-50,facing)
call SaveReal(HH,id,8,distance+60)
call DamageAoeOneTimeDanzoQET(caster,x0,y0,LoadReal(HH,id,21),LoadReal(HH,id,15),LoadGroupHandle(HH,id,4))
call ForGroup(LoadGroupHandle(HH,id,4),function DanzoTQPush)
else
call MoveUnit(Dummy,Dummy,60,facing)
call MoveUnit(Dummy,LoadUnitHandle(HH,id,21),-50,facing)
call UnitSize(Dummy,0.8+(time-0.5)*1.25,1,1)
call UnitSize(LoadUnitHandle(HH,id,21),0.6+(time-0.5),1,1)
call SaveReal(HH,id,8,distance+60)
call GroupClear(G)
call GroupEnumUnitsInRange(G,x0,y0,250+(time-0.5)*411,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if Condition_Base(GetOwningPlayer(caster),n0) then
set DanzoTQHit=true
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
call SaveReal(HH,id,21,250+(time-0.5)*200)
call SaveBoolean(HH,id,19,DanzoTQHit)
