local real dmg=GetHeroAgi(u,true)*2
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real a=LoadReal(h,id,3)
local real fl=LoadReal(h,id,4)
local real speed=LoadReal(h,id,5)
local real dist=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
if dist>0 and GetWidgetLife(l__d)>0 then
set x=x+speed*Cos(a)
set y=y+speed*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SaveReal(h,id,2,dist-speed)
call SaveReal(h,id,4,fl+speed*0.15)
call SetUnitFlyHeight(l__d,fl,0)
if GetUnitTypeId(u)=='H012' then
set n=CreateUnit(p,'d093',x,y,a*bj_RADTODEG)
call SetUnitScale(n, 0.8, 0.8, 0.8)
elseif GetUnitTypeId(u)=='H013' then
set n=CreateUnit(p,'d095',x,y,a*bj_RADTODEG)
elseif GetUnitTypeId(u)=='H06D' then
set n=CreateUnit(p,'d094',x,y,a*bj_RADTODEG)
elseif GetUnitTypeId(u)=='H06E' then
set n=CreateUnit(p,'d096',x,y,a*bj_RADTODEG)
call SetUnitScale(n, 0.9, 0.9, 0.9)
endif
