call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e03T',GetUnitX(u),GetUnitY(u),GetRandomReal(0,359)),'BTLF',1)
call TimerStart(t,.01,true,function ThunderSetCast2)
