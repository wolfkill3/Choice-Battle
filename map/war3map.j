return GetSpellAbilityId()=='A1HY'
endfunction
function AddSpecialEffectToAllBones takes unit c,string l__s returns nothing
call DestroyEffect(AddSpecialEffectTarget(l__s,c,"chest"))
call DestroyEffect(AddSpecialEffectTarget(l__s,c,"head"))
call DestroyEffect(AddSpecialEffectTarget(l__s,c,"right hand"))
call DestroyEffect(AddSpecialEffectTarget(l__s,c,"left hand"))
call DestroyEffect(AddSpecialEffectTarget(l__s,c,"right foot"))
call DestroyEffect(AddSpecialEffectTarget(l__s,c,"left foot"))
call DestroyEffect(AddSpecialEffectTarget(l__s,c,"origin"))
endfunction
function EnkiduECast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local integer idc=GetHandleId(c)
local group g=CreateGroup()
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local boolean bPaused=false
if IsUnitAlly(c,p) then
call UnitRemoveBuffs(c,false,true)
else
set bPaused=false
if IsUnitPaused(c) then
    set bPaused=true
    call PauseUnit(c,false)
endif
call IssueImmediateOrder(c,"manashieldoff")
call IssueImmediateOrder(c,"unimmolation")
call UnitRemoveAbility(c,'A1GL')
call UnitRemoveAbility(c,'WAE1')
call UnitRemoveAbility(c,'A1WT')
call UnitRemoveBuffs(c,true,false)
if UnitHasItemOfTypeBJ(c, 'I03A') and GetWidgetLife(c)>0 and IsUnitIllusion(c)==false then
    set AlastorPos=0
    loop
    exitwhen AlastorPos==6 or GetItemTypeId(UnitItemInSlot(c,AlastorPos)) == 'I03A'
    set AlastorPos=AlastorPos+1
    endloop
    if IsAbilityEnabled(GetUnitAbility(c,'AInv'))==true then
        set Alastor=GetItemOfTypeFromUnitBJ(c,'I03A')
        call UnitRemoveItem(c,Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(c, 'I03A',AlastorPos)
    else
        call EnableUnitAbility2(c,'AInv',false,true)
        set Alastor=GetItemOfTypeFromUnitBJ(c,'I03A')
        call UnitRemoveItem(c,Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(c, 'I03A',AlastorPos)    
        call DisableUnitAbility2(c,'AInv',false,true)
    endif
endif
call UnitAddItemById(c,'I06B')
if LoadReal(h, idc, StringHash("ShieldBelfF"))>0 then   // Щит Бельфегора
    call SaveReal(h, idc, StringHash("ShieldBelfF"), 0)
else
    call SaveReal(h, idc, StringHash("ShieldBelfF"), 0)
    call RemoveSavedReal(h, idc, StringHash("ShieldBelfF"))
endif
if LoadReal(h, idc, StringHash("YujiE_Shield"))>0 then  // Щит Юджи
    call SaveReal(h, idc, StringHash("YujiE_Shield"), 0)
else
    call RemoveSavedReal(h, idc, StringHash("YujiE_Shield"))
endif
if GetUnitAbilityLevel(c,'A1DF')>=1 then                  // Щит Шилдер Q
    call UnitRemoveAbility(c,'A1DF')
    call SaveReal(h,idc, StringHash("shi1"), 0)
    call SaveReal(h,idc, StringHash("shi2"), 0)
endif
if GetUnitAbilityLevel(c,'A1DG')>=1 then                  // Щит Шилдер E
    call UnitRemoveAbility(c, 'A1DG')
endif
if GetUnitAbilityLevel(c,'A10G')>=1 then                  // Щит Луизы
    call UnitRemoveAbility(c, 'A10G')
endif
if GetUnitAbilityLevel(c, 'A2DF')>0 then                      // Щит Броли
    call SaveReal(h,idc,StringHash("BroEtime"),9)
endif
if GetUnitAbilityLevel(c, 'A0VJ')>0 then                  // Гроза Вонголы
    call UnitRemoveAbility(c, 'A0VJ')
endif
if GetUnitAbilityLevel(c, 'A1HG')>0 then                  // Щит Орехи
    call UnitRemoveAbility(c, 'A1HG')
endif
if GetUnitAbilityLevel(c, 'A3DF')>0 then                  // Щит Waver
    call UnitRemoveAbility(c, 'A3DF')
endif

if GetUnitAbilityLevel(c, 'A1H1')>=1 then                 // Щит от Ульты Жанны Рулер
    call UnitRemoveAbility(c, 'A1H1')
endif
if GetUnitAbilityLevel(c, 'A0VV')>=1 then                 // Броня бороса
    call UnitRemoveAbility(c, 'A0VV')
endif
if GetUnitAbilityLevel(c, 'A28W')>=1 then                 // Броня бороса
    call UnitRemoveAbility(c, 'A28W')
endif
if GetUnitAbilityLevel(c, 'AcF1')>=1 then                 // F Эйса
    call SaveBoolean(HH,idc,SST,false)
    call ShowAbility2('A315',false)
    call ShowAbility2('A015',true)
    call UnitRemoveAbility(c,'AcF1')
endif
if GetUnitAbilityLevel(c, 'ItV1')>=1 then                 // G itachi
    call SaveBoolean(HH,idc,SST,false)
    call ShowAbility2('A30C',false)
    call ShowAbility2('A00C',true)
    call UnitRemoveAbility(c,'ItV1')
endif
if GetUnitAbilityLevel(c, 'GaT1')>=1 then                 // T Gamma
    call SaveBoolean(HH,idc,SST,false)
    call ShowAbility2('A41C',false)
    call ShowAbility2('A0GV',true)
    call UnitRemoveAbility(c,'GaT1')
endif
if GetUnitAbilityLevel(c, 'MgT1')>=1 then                 // T Magnus
    call SaveBoolean(HH,idc,SST,false)
    call ShowAbility2('A42C',false)
    call ShowAbility2('A15C',true)
    call UnitRemoveAbility(c,'MgT1')
endif
if bPaused then
    call PauseUnit(c,true)
endif
call UnitRemoveAbility(c, 'YatB')
call UnitRemoveAbility(c, 'OniC')
endif
call AddSpecialEffectToAllBones(c,"war3mapImported\\t_stormboltmissile.mdx")
call AddSpecialEffectToAllBones(c,"Abilities\\Spells\\Orc\\Purge\\PurgeBuffTarget.mdl")
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\az_goods_lvlup(3).mdx",c,"origin"))
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,2,g)
call GroupEnumUnitsInRange(G,x,y,700,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if IsUnitType(E,UNIT_TYPE_HERO)and IsUnitAlly(E,p)and UnitIsAlive(E)then
call GroupAddUnit(g,E)
call UnitAddAbility(E,'A1HV')
call UnitMakeAbilityPermanent(E,true,'A1HV')
call UnitRemoveAbilityTimedPause(E,'A1HV',2)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\az_sg2.mdx",E,"origin"))
endif
call GroupRemoveUnit(G,E)
endloop
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Enkido E.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set u=null
set c=null
set p=null
set g=null
set t=null
endfunction
function InitTrig_EnkiduE takes nothing returns nothing
set gg_trg_EnkiduE=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_EnkiduE,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_EnkiduE,Condition(function EnkiduECond))
call TriggerAddAction(gg_trg_EnkiduE,function EnkiduECast)
endfunction
