call EffectCreateAndMove(true,EffectID[23],GetRandomReal(0,360),1.25,GetRandomReal(0.75,1),GetRandomReal(0.2,0.5),100,100,100,GetRandomReal(30,50),0,caster,0,facing)
endif
endif
call SaveReal(HH,id,6,time1)
