if time>0 then
call SaveReal(HH, GetHandleId(LoadFrameHandle(HH, GetHandleId(GetOwningPlayer(u)),SH_ReplaceableTextures_CommandButtons_BTNRinW_blp)), c_DURATION,time+0.5+0.25*GetUnitAbilityLevel(u,'A1FX'))
