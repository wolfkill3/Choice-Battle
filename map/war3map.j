function ConcentratedShotCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=LoadReal(h,id,1)
local real y=LoadReal(h,id,2)
local real a=Atan2(LoadReal(h,id,4)-y,LoadReal(h,id,3)-x)
local real l__d=LoadReal(h,id,5)
local group g=LoadGroupHandle(h,id,6)
local player p=GetOwningPlayer(u)
local real dmg=LoadReal(h,id,17)
local real speed=LoadReal(h,id,14)
if l__d<5700 then
set x=x+l__d*Cos(a)
set y=y+l__d*Sin(a)
set n=CreateUnit(p,'e0Q1',x,y,(a*bj_RADTODEG))
call UnitApplyTimedLife(n,1,0.35)
set n=CreateUnit(p,'e0Q2',x,y,(a*bj_RADTODEG))
call UnitApplyTimedLife(n,1,1)
set n=CreateUnit(p,0x65305133,x,y,(a*bj_RADTODEG))
call UnitApplyTimedLife(n,1,1)
set n=CreateUnit(p,'e0Q4',x,y,(a*bj_RADTODEG))
call UnitApplyTimedLife(n,1,1)
call UnitApplyTimedLife(CreateUnit(p,'e04A',x,y,a*bj_RADTODEG),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e06L',x,y,a*bj_RADTODEG),1,1)
call SaveReal(h,id,14,speed+1.85)
call UnitApplyTimedLife(n,1,1)
call SaveReal(h,id,5,l__d+speed)
call GroupEnumUnitsInRange(g,x,y,220,Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set ide=GetHandleId(E)
if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
else
set idg=GetHandleId(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,idg)
call DestroyGroup(g)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set g=null
set t=null
endfunction
