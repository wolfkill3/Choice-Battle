function ChangeMusicInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function ChangeMusicCast)
call TriggerAddCondition(t,Condition(function ChangeMusicCond))
set t=null
endfunction
function Trig_RemovePerDie_Conditions takes nothing returns boolean
