if dist>0 and IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false and l__d!=null then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a),false)
call IssueImmediateOrder(l__d,"stop")
call SaveReal(h,id,3,dist-speed)
if ModuloReal(dist,speed*3)<speed+1 then
