function LucyCowCond takes nothing returns boolean
return GetSpellAbilityId()=='A1EK'
endfunction
function LucyCowCast4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real dmg=GetHeroInt(u,true)*(2+GetUnitAbilityLevel(u,'A1EK'))
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real a=LoadReal(h,id,3)
local real dist=LoadReal(h,id,2)
local real slow=LoadReal(h,id,4)
local real time=LoadReal(h,id,5)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,8)
local integer ip=GetPlayerId(p)
local integer l__idg=GetHandleId(g)
local integer idn=GetUnitTypeId(l__d)
if dist<3000 and GetWidgetLife(l__d)>0 then
set x=x+(50-slow)*Cos(a)
set y=y+(50-slow)*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SaveReal(h,id,2,dist+50-slow)
call SaveReal(h,id,4,slow+0.4)
call SaveReal(h,id,5,time+0.02)
if time>0.08 then
call DestroyEffect(AddSpecialEffect("war3mapImported\\WarStompCaster.mdx",x,y))
set n=CreateUnit(p,'e12I',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',1.3)
set n=CreateUnit(p,'e13Z',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',1.3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+180)
call UnitApplyTimedLife(n,'BTLF',1.3)
call SetUnitVertexColor(n,255,255,255,125)
call SetUnitTimeScale(n,0.75)
call SetUnitScale(n,3,3,3)
call SaveReal(h,id,5,0)
endif
call GroupEnumUnitsInRange(g,x,y,225,Base)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,ide)then
if idn=='e13Y' then
call myCustomDamage(u,E,dmg+(GetHeroInt(Lucy[ip],true)*(1+GetUnitAbilityLevel(Lucy[ip],'A1ES'))),false,false,null,null,null)
call SetControlToUnit(E,E, 2, "stun")
else
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SlowUnit(u,E,0.5,0,5,0,false)
endif
call SaveUnitHandle(h,l__idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
else
call SetUnitTimeScale(u,1)
call DestroyGroup(g)
call KillUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
set g=null
set l__d=null
set u=null
set p=null
set t=null
endfunction
function LucyCowCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(p)
local real a=LoadReal(h,id,3)
if GetUnitAbilityLevel(LUcy[ip],'LUQ1')==0 then
call UnitRemoveAbility(LUcy[ip],'LUQ2')
set n=CreateUnit(p,'e0ZH',x+155*Cos(a),y+155*Sin(a),a*bj_RADTODEG+180)
call SaveUnitHandle(h,id,1,n)
call SetUnitVertexColor(n,255,255,255,25)
call SetUnitTimeScale(n,1)
call SetUnitScale(n,3,3,3)
set n=CreateUnit(p,'e0SX',x+155*Cos(a),y+155*Sin(a),a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',.8)
call SetUnitTimeScale(n,0.8)
call SetUnitFlyHeight(n,0,0)
call SetUnitFlyHeight(n,250,220)
call SetUnitScale(n,0.7,0.7,0.7)
set n=CreateUnit(p,'e13X',x+155*Cos(a),y+155*Sin(a),a*bj_RADTODEG+90)
call UnitApplyTimedLife(n,'BTLF',1.5)
call SetUnitTimeScale(n,0.8)
set n=CreateUnit(p,'e13Y',x+155*Cos(a),y+155*Sin(a),a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1.5)
call SetUnitTimeScale(n,2)
