local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real f
if SR(x,y,x1,y1)>32 and UnitIsAlive(c)then
set x=x+50*Cos(a)
set y=y+50*Sin(a)
call UnitRemoveAbility(u,'A2VJ')
call PauseUnit(u,true)
call SetUnitXY_1(u,x,y,false)
call SetUnitFacing(u,a*bj_RADTODEG)
call UnitApplyTimedLife(CreateUnit(p,0x65303451,x,y,a*bj_RADTODEG),1,1)
else
call PauseUnit(u,false)
call UnitApplyTimedLife(CreateUnit(p,'e03X',x1,y1,GetRandomReal(0,359)),0,4)
call UnitApplyTimedLife(CreateUnit(p,'e03W',x1,y1,GetRandomReal(0,359)),0,4)
call UnitApplyTimedLife(CreateUnit(p,'e03Y',x1,y1,GetRandomReal(0,359)),0,4)
call DestroyEffect(LoadEffectHandle(h,id,3))
call SetUnitPathing(u,true)
if GetUnitAbilityLevel(c,'AA01')>0 then
call myCustomDamage(u,c,((GetUnitAbilityLevel(u,'A09V'))*GetHeroInt(u,true)+75)*1.3,false,false,null,null,null)
else
call myCustomDamage(u,c,(GetUnitAbilityLevel(u,'A09V'))*GetHeroInt(u,true)+75,false,false,null,null,null)
endif
call SetControlToUnit(u,c,2, "stun")
call SetUnitInvulnerable(u,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
