function FatalityCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveReal(h,id,2,0)
call SaveInteger(h,id,9,0)
call SaveReal(h,id,3,a)
call SaveReal(h,id,10,a)
call UnitAddAbility(c,'Arav')
call UnitRemoveAbility(c,'Arav')
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG-30)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+30)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
call UnitAddAbility(u,'A195')
call TimerStart(t,0.01,true,function FatalityCast2)
set u=null
set p=null
set t=null
endfunction
function InitTrig_Fatality takes nothing returns nothing
set gg_trg_Fatality=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Fatality,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_Fatality,Condition(function FatalityCond))
call TriggerAddAction(gg_trg_Fatality,function FatalityCast)
endfunction
function Trig_Lines_Conditions takes nothing returns boolean
return GetUnitTypeId(GetTriggerUnit())=='e0ZV' or GetUnitTypeId(GetTriggerUnit())=='e0ZY' or GetUnitTypeId(GetTriggerUnit())=='fSDL'
endfunction
function Trig_Lines_Actions takes nothing returns nothing
call IssueImmediateOrder(GetTriggerUnit(),"stop")
endfunction
function InitTrig_Lines takes nothing returns nothing
set gg_trg_Lines=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Lines,EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterAnyUnitEventBJ(gg_trg_Lines,EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
call TriggerAddCondition(gg_trg_Lines,Condition(function Trig_Lines_Conditions))
call TriggerAddAction(gg_trg_Lines,function Trig_Lines_Actions)
endfunction
function Trig_Timed_Conditions takes nothing returns boolean
return(GetSpellAbilityId()==0x41313956 or GetSpellAbilityId()==0x41313958 or GetSpellAbilityId()==0x41313957)and udg_B
endfunction
function Trig_Timed_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local integer id=GetSpellAbilityId()
if id==0x41313956 then
call UnitApplyTimedLife(u,'BTLF',4)
elseif id==0x41313957 then
call UnitApplyTimedLife(u,'BTLF',2)
elseif id==0x41313958 then
call UnitApplyTimedLife(u,'BTLF',0.5)
endif
set u=null
endfunction
function InitTrig_Timed takes nothing returns nothing
set gg_trg_Timed=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Timed,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_Timed,Condition(function Trig_Timed_Conditions))
call TriggerAddAction(gg_trg_Timed,function Trig_Timed_Actions)
endfunction
function FrendaRushCond takes nothing returns boolean
return GetSpellAbilityId()=='A19S'
endfunction
function Push_FrendaCombo2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local unit u=LoadUnitHandle(h,id,5)
local real speed=LoadReal(h,id,1)
local real a=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real dist=LoadReal(h,id,3)
local player p=GetOwningPlayer(u)
local real dmg=(3+GetUnitAbilityLevel(u,'A19S'))*GetHeroInt(u,true)
local group g=LoadGroupHandle(h,id,6)
if dist>0 and IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SaveReal(h,id,3,dist-speed)
call SaveReal(h,id,1,speed-speed*0.03)
call DestroyEffect(AddSpecialEffect(LoadStr(h,id,4),x,y))
else
call PauseUnit(l__d,false)
call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,false)
call SetUnitInvulnerable(l__d,false)
call GroupEnumUnitsInRange(g,x,y,400,BaseFrenda)
loop
set E=FirstOfGroup(g)
exitwhen E==null
if(GetUnitTypeId(E)=='fSDL' or GetUnitTypeId(E)=='e0ZY' or GetUnitTypeId(E)=='e0ZV')and GetUnitAbilityLevel(E,'A1C3')==0 then
call UnitAddAbility(E,'A1C3')
call UnitApplyTimedLife(E,'BTLF',0.06)
endif
if Condition_Base(p,E) then 
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(u,E,1,"stun")
endif
call GroupRemoveUnit(g,E)
endloop
call UnitRemoveAbility(l__d,'A1US')
set n=CreateUnit(p,'eo9K',x,y,GetRandomReal(0,359))
call SetUnitScale(n,1,1,1)
call UnitApplyTimedLife(n,'BTLF',3)
