local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,8)
local real y1=LoadReal(h,id,9)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(l__d)
local real dist=LoadReal(h,id,10)
local real mh=900
local real rd=SR(x,y,x1,y1)
local real cof=1-rd/dist
if SR(x,y,x1,y1)>60 then
call SetUnitX(l__d,x+20*Cos(a))
call SetUnitY(l__d,y+20*Sin(a))
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,mh*cof,0)
else
call UnitApplyTimedLife(CreateUnit(p,0x65304F59,x1,y1,GetRandomReal(0,359)),1,7)
call UnitApplyTimedLife(CreateUnit(p,'e0PB',x1,y1,GetRandomReal(0,359)),1,8)
set n=CreateUnit(p,0x65305041,x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,12)
call UnitScale(n,0.01,3.5,8)
call PauseTimer(t)
call TimerStart(t,0.085,true,function ChibakuTenseiCast3)
endif
set p=null
set l__d=null
set t=null
endfunction
function ChibakuTenseiCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real sr=SR(x,y,x1,y1)
local real a=Atan2(y1-y,x1-x)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,3,CreateUnit(GetOwningPlayer(u),0x65305031,x,y,a*bj_RADTODEG))
call SaveReal(h,id,7,0)
if sr>200 then
call SaveReal(h,id,8,x1)
call SaveReal(h,id,9,y1)
call SaveReal(h,id,10,SR(x,y,x1,y1))
else
set x1=x1+GetRandomReal(-200,200)
set y1=y1+GetRandomReal(-200,200)
call SaveReal(h,id,8,x1)
call SaveReal(h,id,9,y1)
call SaveReal(h,id,10,SR(x,y,x1,y1))
endif
call SaveGroupHandle(h,id,11,CreateGroup())
call SaveGroupHandle(h,id,12,CreateGroup())
set soundplay=CreateSound("Sound\\Music\\mp3Music\\PainChibakuTensei.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
set Cambug=true
call TimerStart(t,0.03,true,function ChibakuTenseiCast2)
set u=null
set t=null
endfunction
function InitChibakuTensei takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function ChibakuTenseiCast)
call TriggerAddCondition(t,Condition(function ChibakuTenseiCond))
set t=null
endfunction
function SixPathsCond takes nothing returns boolean
return GetSpellAbilityId()=='A0QK' and udg_B==true
endfunction
function SixPathsCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real time=LoadReal(h,id,2)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,10)
local group g2=null
local integer idu=GetHandleId(u)
local integer i=0
local real mana=0
if RectContainsUnit(gg_rct_UBW2,u)==false then
set mana=mana+GetUnitManaPercent(u)
set i=i+1
endif
if time<50 and not(GetUnitAbilityLevel(u,'A0QL')==1 and GetUnitAbilityLevel(LoadUnitHandle(h,idu,StringHash("one")),'A0QL')==1 and GetUnitAbilityLevel(LoadUnitHandle(h,idu,StringHash("two")),'A0QL')==1 and GetUnitAbilityLevel(LoadUnitHandle(h,idu,StringHash("four")),'A0QL')==1 and GetUnitAbilityLevel(LoadUnitHandle(h,idu,StringHash("five")),'A0QL')==1 and UnitIsAlive(LoadUnitHandle(h,idu,StringHash("three")))==false) and udg_B then
call SaveReal(h,id,2,time+0.3)
if DU==true then
set g2=CopyGroup(g)
loop
set E=FirstOfGroup(g2)
exitwhen E==null
if RectContainsUnit(gg_rct_UBW2,E)==false then
set mana=mana+GetUnitManaPercent(E)
if GetUnitAbilityLevel(E,'A0QL')>0 then
call PauseUnit(E,true)
call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,true)
endif
set i=i+1
endif
call GroupRemoveUnit(g2,E)
endloop
call DestroyGroupTimed(g2,3)
set mana=mana/i
set g2=CopyGroup(g)
loop
set E=FirstOfGroup(g2)
exitwhen E==null
if RectContainsUnit(gg_rct_UBW2,E)==false then
call SetUnitManaPercentBJ(E,mana)
endif
call GroupRemoveUnit(g2,E)
endloop
call DestroyGroupTimed(g2,3)
if RectContainsUnit(gg_rct_UBW2,u)==false then
call SetUnitManaPercentBJ(u,mana)
endif
endif
else
call UnitRemoveAbility(u,'A0QL')
call SaveBoolean(h,idu,StringHash("alive"),false)
call PauseTimer(t)
call ForGroup(g,function KillGroup)
call GroupClear(g)
call DestroyGroup(g)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,idu)
endif
set p=null
set g=null
set g2=null
set t=null
set u=null
endfunction
