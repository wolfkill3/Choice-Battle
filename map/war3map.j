call Bof_zU(1.,LoadEffectHandle(bof_OI,GetHandleId(GetExpiredTimer()),$2260746D))
call FlushChildHashtable(bof_OI,GetHandleId(GetExpiredTimer()))
call DestroyTimer(GetExpiredTimer())
endif
endfunction
