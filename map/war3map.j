function SabracRFlySwords takes unit caster1,real aoe1,real timelife returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real randomspeed=GetRandomReal(60,90)
local real x0=GetUnitX(caster1)
local real y0=GetUnitY(caster1)
local real hight=0
call SaveReal(HH,id,8,4000)
call SaveReal(HH,id,9,randomspeed)
call SaveReal(HH,id,11,x0)
call SaveReal(HH,id,12,y0)
call SaveUnitHandle(HH,id,1,caster1)
set x0=PolX(x0,GetRandomReal(-aoe1*0.8,aoe1*0.8),GetRandomReal(0,360))
set y0=PolY(y0,GetRandomReal(-aoe1*0.8,aoe1*0.8),GetRandomReal(0,360))
set n0=CreateUnit(GetOwningPlayer(caster1),'270e',x0,y0,GetUnitFacing(caster1))
call SetUnitModel(n0,"Sabrac\\SabracKnife.mdl")
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call SetUnitFlyHeight(n0,hight,0)
call UnitSize(n0,1.5,1,1)
call SetUnitFlyHeight(n0,0,0)
call SaveUnitHandle(HH,id,20,n0)
call MyRemoveUnit(n0,timelife)
set n0=null
call TimerStart(t,0.02,true,function SabracRFlySwords1)
set caster1=null
set t=null
endfunction


function SabracRAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit casterOriginal=LoadUnitHandle(HH,id,30)
local real x0=GetUnitX(caster)
local real y0=GetUnitY(caster)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real time1=0
local real damage=LoadReal(HH,id,15)*0.1
local real aoe=LoadReal(HH,id,16)
local integer swordcount=R2I(aoe*0.01)
set time=time+0.02
call SaveReal(HH,id,5,time)
if time==0.02 then
call EffectCreateAndMove90(true,"Sabrac\\3ydj_11.mdl",facing+90,2,aoe*0.003,1,100,100,100,20,50,caster,0,facing)
call EffectCreateAndMove90(true,"Sabrac\\3ydj_11.mdl",facing+90,2,aoe*0.002,1,100,100,100,20,50,caster,0,facing)
call EffectCreateAndMove(true,"Sabrac\\HakkeStart2.mdl",facing,2,aoe*0.002,0.5,100,100,100,60,0,caster,0,facing)
call UnitSpeed(caster,1)
call SabracStackOneTime(casterOriginal,x0,y0,aoe)
call GroupClear(G)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',x0,y0,GetUnitFacing(caster))
call SetUnitModel(n0,"Sabrac\\AOE2m.mdl")
call UnitSize(n0,aoe*0.0095,1,1)
call UnitSpeed(n0,1)
call UnitColor(n0,100,20,20,40)
call SetUnitFlyHeight(n0,0,0)
call SaveUnitHandle(HH,id,20,n0)
call MyRemoveUnit(n0,2)
set n0=null
set n0=CreateUnit(GetOwningPlayer(caster),'e200',x0,y0,GetUnitFacing(caster))
call SetUnitModel(n0,"Sabrac\\AFB (2697).mdl")
call UnitSize(n0,aoe*0.0132,1,1)
call UnitSpeed(n0,1)
call UnitColor(n0,100,20,20,40)
call SetUnitFlyHeight(n0,0,0)
call SaveUnitHandle(HH,id,21,n0)
call MyRemoveUnit(n0,2)
set n0=null
endif
if time<=2.02 then
call MoveUnit(caster,LoadUnitHandle(HH,id,20),0,facing)
call MoveUnit(caster,LoadUnitHandle(HH,id,21),0,facing)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
set time1=LoadReal(HH,id,6)
set time1=time1-0.02
if time1==0 or time1==0.1 then
if swordcount>5 then
set swordcount=5
endif
if swordcount>0 then
loop
call SabracRFlySwords(caster,aoe,2-time)
set swordcount=swordcount-1
exitwhen swordcount==0
endloop
endif
endif


if time1==0.18 or time1==0.14 or time1==0.1 or time1==0.06 or time1==0.02 then
call StopAoeOneTime1(caster,x0,y0,aoe)
endif

if time1==0 then
set time1=0.2
call DamageAoeOneTime0(casterOriginal,x0,y0,aoe,damage)
endif
call SaveReal(HH,id,6,time1)
endif
if time==2.02 then
call SetUnitAnimationByIndex(caster,8)
call UnitSpeed(caster,1)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
set caster=null
set casterOriginal=null
endfunction



function SabracWActForClone takes unit caster0,unit Dummy0 returns nothing
