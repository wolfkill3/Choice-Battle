set y2=y+sr*Sin(a)
loop
exitwhen i>120
set n=CreateUnit(p,'e16A',x1+GetRandomReal(-800,800),y1+GetRandomReal(-800,800),GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',2.5)
call SetUnitTimeScale(n,GetRandomReal(0.20,0.65))
call SetUnitFlyHeight(n,GetRandomReal(600,800),0)
call SetUnitFlyHeight(n,0,GetRandomReal(10,150))
call SetUnitScale(n,sc,sc,sc)
call SetUnitMoveSpeed(n,GetRandomReal(15,85))
call IssuePointOrder(n,"move",x2+GetRandomReal(-1*sr,sr),y2+GetRandomReal(-1*sr,sr))
set i=i+1
endloop
call SetUnitInvulnerable(c,true)
call SetUnitInvulnerable(u,true)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call PauseUnit(u,true)
call PauseTimer(t)
call TimerStart(t,1.25,false,function TKingHassanCast6)
set l__d=null
set p=null
set c=null
set u=null
set t=null
endfunction
