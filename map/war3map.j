local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real a=LoadReal(h,id,4)
local real dist=LoadReal(h,id,5)
local real x=GetUnitX(l__d)+55*Cos(a)
local real y=GetUnitY(l__d)+55*Sin(a)
local real dmg=(GetHeroInt(u,true))*(GetUnitAbilityLevel(u,'A0KT')+1)+(GetUnitAbilityLevel(u,'A0KT')*50)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,3)
if dist<1500 then
call SetUnitXY_1(l__d,x,y, false)
call UnitApplyTimedLife(CreateUnit(p,0x65304741,x,y,a*bj_RADTODEG),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e0GB',x,y,a*bj_RADTODEG),1,1)
call DestroyEffect(AddSpecialEffect("iceao.mdx",x,y))
call GroupEnumUnitsInRange(g,x,y,175,Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
call SlowUnit(u,E,0.5,0,5,2,false)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
call SaveReal(h,id,5,dist+45)
else
call RemoveUnit(l__d)
call FlushChildHashtable(h,GetHandleId(g))
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
