local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(p)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local integer i=0
local real a=GetUnitFacing(u)*bj_DEGTORAD
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Gemini.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
if GetUnitTypeId(u)!='H06U' then
if lucy[ip]!=true then
if Lucy[ip]!=null then
    call RemoveUnit(Lucy[ip])
    set Lucy[ip]=null
endif
set n=CreateUnit(p,'e0ZH',x+155*Cos(a),y+155*Sin(a),a*bj_RADTODEG+180)
call UnitApplyTimedLife(n,1,1.5)
call SetUnitVertexColor(n,255,255,255,25)
call SetUnitTimeScale(n,0.5)
call SetUnitScale(n,3,3,3)
set n=CreateUnit(p,'e0SX',x+155*Cos(a),y+155*Sin(a),a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,.8)
call SetUnitTimeScale(n,0.8)
call SetUnitFlyHeight(n,0,0)
call SetUnitFlyHeight(n,250,220)
call SetUnitScale(n,0.7,0.7,0.7)
set n=CreateUnit(p,'e140',x+155*Cos(a),y+155*Sin(a),a*bj_RADTODEG+90)
call UnitApplyTimedLife(n,1,1.5)
call SetUnitTimeScale(n,0.8)
set n=CreateUnit(Player(14),'H06U',x+155*Cos(a),y+155*Sin(a),a*bj_RADTODEG)
call SetUnitOwner(n,p,true)
if GetUnitAbilityLevel(u,'A1EK')>0 then
    call UnitAddAbility(n,'A1ES')
    call SetUnitAbilityLevel(n,'A1ES',GetUnitAbilityLevel(u,'A1EK'))
endif
if GetUnitAbilityLevel(u,'A1EM')>0 then
    call UnitAddAbility(n,'A1ET')
    call SetUnitAbilityLevel(n,'A1ET',GetUnitAbilityLevel(u,'A1EM'))
endif
if GetUnitAbilityLevel(u,'A1ER')>0 then
    call UnitAddAbility(n,'A1ER')
    call SetUnitAbilityLevel(n,'A1ER',GetUnitAbilityLevel(u,'A1ER'))
    call StartAbilityCooldown(GetUnitAbility(n,'A1ER'),120)
endif
if GetUnitAbilityLevel(u,'A1EN')>0 then
    call UnitAddAbility(n,'A1EW')
    call SetUnitAbilityLevel(n,'A1EW',GetUnitAbilityLevel(u,'A1EN'))
