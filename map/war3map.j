call SaveReal(h,id,10,0)
call SaveReal(h,id,12,x)
call SaveReal(h,id,11,y)
call UnitApplyTimedLife(CreateUnit(p,0x6530594F,x,y,0),'BTLF',10)
call UnitApplyTimedLife(CreateUnit(p,'e0Y0',x,y,0),'BTLF',10)
call UnitApplyTimedLife(CreateUnit(p,0x6530594E,x,y,0),'BTLF',10)
call SetUnitTimeScale(l__d,1)
