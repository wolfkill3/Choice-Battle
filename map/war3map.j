call SaveUnitHandle(HH,id,20,n0)
set n0=null
call EffectCreateAndMove(true,"Sabrac\\red-yumao-zhendiLord.mdl",facing,1,1,1,100,100,100,40,0,caster,0,facing)
call EffectCreateAndMove(true,"Sabrac\\wind4.mdl",facing,1,1,0.6,100,40,40,40,0,caster,0,facing)
call EffectCreateAndMove(true,"Sabrac\\HakkeStart2.mdl",facing,1,0.5,1,100,100,100,60,0,caster,0,facing)
endif
call MoveUnit(caster,Dummy,0,facing)
call SetUnitFlyHeight(Dummy,GetUnitFlyHeight(caster),0)


if CheckUnitInvisible(caster)==true then
   
    if GetUnitAbilityLevel( LoadUnitHandle(HH,id,20) ,'A0A1')==0 then
      call UnitAddAbility( LoadUnitHandle(HH,id,20) ,'A0A1')
    endif

else

   if GetUnitAbilityLevel( LoadUnitHandle(HH,id,20) ,'A0A1')==1 then
     call UnitRemoveAbility( LoadUnitHandle(HH,id,20) ,'A0A1')
   endif

endif




if GetUnitAbilityLevel(caster,'BSaE')==0 or (time>0.02 and  udg_B==false) or UnitIsAlive(caster)==false  then
call RemoveUnit(Dummy)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
set caster=null
set Dummy=null
endfunction
