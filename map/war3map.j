call SetUnitVertexColor(n,255,255,255,50)
call SaveReal(h,id,17,time-0.1)
else
call SaveReal(h,id,11,Atan2(GetUnitY(c)-y,GetUnitX(c)-x))
set soundplay=SndN(2098) // Sound\Music\mp3Music\Rasenrendan.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SetUnitTimeScale(u,1)
call PauseTimer(t)
call TimerStart(t,0.02,true,function RasenRenganCast3)
endif
set c=null
set p=null
set u=null
set t=null
endfunction
function RasenRenganCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real x2=0
local real y2=0
local real a=Atan2(y1-y,x1-x)
local real ang=90*bj_DEGTORAD
local group gNaruto=CreateGroup()
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,22,c)
call SaveReal(h,id,5,x1)
call SaveReal(h,id,6,y1)
call SaveReal(h,id,2,0)
call SaveReal(h,id,10,1.25)
call SaveReal(h,id,11,a)
call SaveReal(h,id,17,1)
call PauseUnit(u,true)
call SetUnitAnimation(u,"Spell Three")
call SetUnitInvulnerable(u,true)
call GroupEnumUnitsInRange(gNaruto,0,0,999999,Base)
loop
    set E=FirstOfGroup(gNaruto)
    exitwhen E==null
    if GetUnitAbilityLevel(E,'A0V8')>0 and E!=u and GetOwningPlayer(E)==p then
        call SetUnitState(E,UNIT_STATE_MANA,GetUnitState(E,UNIT_STATE_MANA)-GetAbilityIntegerLevelField(GetUnitAbility(u,'A0V8'),ABILITY_ILF_MANA_COST,GetUnitAbilityLevel(u,'A0V8')-1))
        call StartAbilityCooldown(GetUnitAbility(E, 'A0V8'), GetAbilityRealLevelField(GetUnitAbility(E,'A0V8'),ABILITY_RLF_COOLDOWN,GetUnitAbilityLevel(E,'A0V8')-1))
    endif
    call GroupRemoveUnit(gNaruto,E)
endloop
call DestroyGroup(gNaruto)
call SaveGroupHandle(h,id,12,CreateGroup())
set x2=x+65*Cos(a-ang)
set y2=y+65*Sin(a-ang)
set n=CreateUnit(p,'e0S9',x2,y2,(a+ang)*bj_RADTODEG)
call UnitApplyTimedLife(n,'B008',1.2)
call SetUnitTimeScale(n,0.5)
call SetUnitAnimation(n,"spell one")
call DestroyEffect(AddSpecialEffect("war3mapImported\\shadowclone.mdl",x2,y2))
set x2=x+65*Cos(a+ang)
set y2=y+65*Sin(a+ang)
set n=CreateUnit(p,'e0S9',x2,y2,(a-ang)*bj_RADTODEG)
call UnitApplyTimedLife(n,'B008',1.2)
call SetUnitTimeScale(n,0.5)
call SetUnitAnimation(n,"spell one")
call UnitAddAbility(u,'A0V0')
call DestroyEffect(AddSpecialEffect("war3mapImported\\shadowclone.mdl",x2,y2))
set soundplay=SndN(2101) // Sound\Music\mp3Music\RasenganStart.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.1,true,function RasenRenganCast2)
set u=null
set p=null
set c=null
set t=null
set gNaruto=null
endfunction
