function PainW_ShinraTenseiCast takes unit u returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real dmg=(2+GetUnitAbilityLevel(u,0x41304C42))*GetHeroInt(u,true)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local integer i=0
local real r=0
call GroupEnumUnitsInRange(DG,x,y,450,Base)
loop
set E=FirstOfGroup(DG)
exitwhen E==null
if Condition_Base(p,E)then
call Push3(E,50,Atan2(GetUnitY(E)-y,GetUnitX(E)-x),800,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 1, "stun")
endif
call GroupRemoveUnit(DG,E)
endloop
loop
exitwhen i>12
set r=i*30.
set n=CreateUnit(p,'e0OO',x,y,r)
call UnitApplyTimedLife(n,1,0.4)
set i=i+1
endloop
set n=CreateUnit(p,'e0ON',x,y,0)
call UnitApplyTimedLife(n,1,0.4)
call UnitScale(n,0.01,0.7,0.4)
set n=CreateUnit(p,'e0OP',x,y,0)
call UnitApplyTimedLife(n,1,0.4)
call SetUnitTimeScale(n,2)
call UnitScale(n,0.01,1.6,0.4)
call SaveUnitHandle(h,id,0,u)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SetUnitAnimation(u,"Spell Defend")
set soundplay=CreateSound("Sound\\Music\\mp3Music\\PeinShinraTensei.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.4,false,function ShinraTenseiCast2)
set u=null
set t=null
set p=null
endfunction

function ShinraTenseiCast takes nothing returns nothing
        call PainW_ShinraTenseiCast(GetTriggerUnit())
endfunction

