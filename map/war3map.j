call ShowUnit(u,true)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
loop
exitwhen i>=6
call UnitApplyTimedLife(CreateUnit(p,'e04D',x,y,GetRandomReal(0,359)),1,2)
set i=i+1
endloop
call SetUnitX(u,LoadReal(h,id,1))
call SetUnitY(u,LoadReal(h,id,2))
if GetLocalPlayer()==p then
call SelectUnit(u,true)
endif
call DestroyEffect(AddSpecialEffectTarget(LoadStr(h,id,3),c,"origin"))
call myCustomDamage(u,c,(3+GetUnitAbilityLevel(u,'A0B0'))*GetHeroInt(u,true),false,false,null,null,null)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set u=null
set c=null
set p=null
set t=null
endfunction
