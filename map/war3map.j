function RengokuQWE_CD takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local unit caster=LoadUnitHandle(h, id, c_CASTER)
    local integer id_caster= GetHandleId(caster)
    if LoadReal(HH, id_caster, RengokuQWE_Time)>0.0 and UnitIsAlive(caster) then
        call SaveReal(HH, id_caster, RengokuQWE_Time, LoadReal(HH, id_caster, RengokuQWE_Time) - 0.5)
    else
        if UnitIsAlive(caster) then
            call DestroyEffect(AddSpecialEffectTarget("WindCirclefaster.mdl", caster, "origin"))
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR94', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
            call SetUnitScale(bjLCU, 1.2, 1.2, 1.2)
            call MyRemoveUnit(bjLCU, 1.5)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR94', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
            call SetUnitScale(bjLCU, 0.8, 0.8, 0.8)
            call MyRemoveUnit(bjLCU, 1.5)
            call SaveReal(HH, id_caster, RengokuQWE_Time, 0.0)
            call RemoveSavedReal(HH, id_caster, RengokuQWE_Time)
            call SetUnitAbilityLevel(caster, 'ReD1', 1)
            call FlushChildHashtable(h, id)
            call PauseTimer(GetExpiredTimer())
            call DestroyTimer(GetExpiredTimer())
        endif
    endif
    set caster=null
endfunction

function RengokuQWE_Combination takes unit newCaster,string nextComb returns string
    local integer id_caster= GetHandleId(newCaster)
    local string get_comb=""
        local real QWE_Comb= LoadReal(HH, id_caster, RengokuQWE_Time)
        local timer local_timer=null
        if GetHeroLevel(newCaster)>=6 and GetUnitAbilityLevel(newCaster, 'ReD1')>0 then
            if GetUnitAbilityLevel(newCaster, 'ReD1')==1 then
                set get_comb=""
            elseif GetUnitAbilityLevel(newCaster, 'ReD1')==2 then
                set get_comb="Q"
            elseif GetUnitAbilityLevel(newCaster, 'ReD1')==3 then
                set get_comb="W"
            elseif GetUnitAbilityLevel(newCaster, 'ReD1')==4 then
                set get_comb="E"
            endif
            if nextComb=="Q" then
                call SetUnitAbilityLevel(newCaster, 'ReD1', 2)
            elseif nextComb=="W" then
                call SetUnitAbilityLevel(newCaster, 'ReD1', 3)
            elseif nextComb=="E" then
                call SetUnitAbilityLevel(newCaster, 'ReD1', 4)
            endif
            if QWE_Comb==0.0 then
                set local_timer=CreateTimer()
                call SaveUnitHandle(h, GetHandleId(local_timer), c_CASTER, newCaster)
                call TimerStart(local_timer, 0.5, true, function RengokuQWE_CD)
            endif
            call SaveReal(HH, id_caster, RengokuQWE_Time, 10)
        endif
        set local_timer=null
        return get_comb
endfunction

function RengokuE_Shifting_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local integer eff_period= LoadInteger(h, id, c_EFFPERIOD)
    local real target_x= GetUnitX(LoadUnitHandle(h, id, c_TARGET))
    local real target_y= GetUnitY(LoadUnitHandle(h, id, c_TARGET))
    local real angle= LoadReal(h, id, c_ANGLE)
    local real distance= LoadReal(h, id, c_DISTANCE)
    local real power= 2 + distance / 10
    if distance > 0 then
        call SetUnitX(LoadUnitHandle(h, id, c_TARGET), target_x + power * Cos(angle))
        call SetUnitY(LoadUnitHandle(h, id, c_TARGET), target_y + power * Sin(angle))
        if eff_period == 0 then
            set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, c_CASTER)), 'dR45', target_x, target_y, GetRandomInt(0, 360))
            call SetUnitVertexColor(n, 255, 255, 255, 120)
            call MyRemoveUnit(n, 1)
            call SaveInteger(h, id, c_EFFPERIOD, 10)
        else
            call SaveInteger(h, id, c_EFFPERIOD, eff_period - 1)
        endif
        call SaveReal(h, id, c_DISTANCE, distance - power)
    else
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
endfunction



function RengokuE_Shifting takes unit newCaster,unit newTarget,real newAngle,real newDist,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    if newDist < 50 then
        call SaveInteger(h, id, c_EFFPERIOD, 100)
    endif
    call SaveUnitHandle(h, id, c_CASTER, newCaster)
    call SaveUnitHandle(h, id, c_TARGET, newTarget)
    call SaveReal(h, id, c_ANGLE, newAngle)
    call SaveReal(h, id, c_DISTANCE, newDist)
    call TimerStart(newTimer, 0.02, true, function RengokuE_Shifting_Periodic)
endfunction

function RengokuQ_Tossing_Periodic takes nothing returns nothing
    local integer id    = GetHandleId(GetExpiredTimer())
    local real time             = LoadReal(h, id, c_TIME)
    local unit target       = LoadUnitHandle(h, id, c_TARGET)
    local real target_x = GetUnitX(target)
    local real target_y = GetUnitY(target)
    local boolean eff_bool= LoadBoolean(h, id, 15)
    if time < 1 then
        call IssueImmediateOrder(target, "stop")
        if time > 0 and time < 0.8 then
            call SetUnitFlyHeight(target, 500, 2000)
        endif
        if time > 0.8 and time < 1 then
            call SetUnitFlyHeight(target, 0, 2000)
        endif
        if time > 0 and eff_bool == false then
            
            set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, c_CASTER)), 'dR58', target_x, target_y, GetRandomInt(0, 360))
            call SetUnitFlyHeight(n, 155, 0)
            call SetUnitScale(n, 1.65, 1.65, 1.65)
            call MyRemoveUnit(n , 1.2)
            set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, c_CASTER)), 'dR25', target_x, target_y, GetRandomInt(0, 360))
            call SetUnitTimeScale(n , 0.65)
            call MyRemoveUnit(n , 1.2)
            // set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, c_CASTER)), 'dR25', target_x, target_y, GetRandomInt(0, 360))
            // call SetUnitTimeScale(n , 0.65)
            // call MyRemoveUnit(n , 1.2)
            
            set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, c_CASTER)), 'dR97', target_x, target_y, GetRandomInt(0, 360))
            call SetUnitTimeScale(n , 0.85)
            call SetUnitScale(n, 0.85, 0.85, 0.85)
            call MyRemoveUnit(n , 1.5)
                        
            call SaveBoolean(h, id, 15, true)
        endif
        call SaveReal(h, id, c_TIME, time + 0.03)
    else
        call SetUnitFlyHeight(target, 0, 0)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
        set target=null
endfunction


function RengokuQ_Tossing takes unit newCaster,unit newTarget,real newDamage,real newAngle,real newDelay,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    if newDelay == 0.0 then
        call ShakeCamera(0.3 , 5)
    endif
    call RemoveEffect(AddSpecialEffectTarget("123 (1081).mdl", newTarget, "origin"), 1+newDelay, true, CreateTimer())
    call UnitAddAbility(newTarget, 'Arav')
    call UnitRemoveAbility(newTarget, 'Arav')
    call myCustomDamage(newCaster , newTarget , newDamage , false , false , null , null , null)
    call SaveUnitHandle(h, id, c_CASTER, newCaster)
    call SaveUnitHandle(h, id, c_TARGET, newTarget)
    call SaveReal(h, id, c_TIME,                 0 - newDelay)
    //call SaveReal(h, id, AngleHash, newAngle)
    call TimerStart(newTimer, 0.03, true, function RengokuQ_Tossing_Periodic)
endfunction

function RengokuQ_Base_Periodic takes nothing returns nothing
    local integer id    =       GetHandleId(GetExpiredTimer())
    local unit caster       =       LoadUnitHandle(h, id, c_CASTER)
    local real caster_x =       GetUnitX(caster)
    local real caster_y =       GetUnitY(caster)
    local real distance =       LoadReal(h, id, c_DISTANCE)
    local real speed    =       LoadReal(h, id, c_SPEED)
    local real angle    =       LoadReal(h, id, c_ANGLE)
    local real time             =       LoadReal(h, id, c_TIME)
    local boolean target_detected= LoadBoolean(h, id, 16)
    if distance > 0 and LoadBoolean(HH,GetHandleId(caster),DASH_USER)==true then
        call SetUnitX(caster, caster_x + speed * Cos(angle))
        call SetUnitY(caster, caster_y + speed * Sin(angle))
        call SetUnitFacing(caster, angle * bj_RADTODEG)
        set bjLCU=LoadUnitHandle(h, id, c_DUMMY1)
        call SetUnitX(bjLCU , caster_x)
        call SetUnitY(bjLCU , caster_y)
        call SaveReal(h, id, c_DISTANCE, distance - speed)
        set bjLCG=LoadGroupHandle(h, id, c_GROUP1)
        call GroupEnumUnitsInRange(bjLCG, caster_x, caster_y, 175, Base)
        loop
        set bjLCU=FirstOfGroup(bjLCG)
        exitwhen bjLCU == null
            if Condition_Base(GetOwningPlayer(caster) , bjLCU) and IsUnitInvulnerable(bjLCU)==false then
                if LoadBoolean(HH,GetHandleId(bjLCU),ANTITARGET_ABILITY)==false then    
                    call SetUnitX(caster, GetUnitX(bjLCU) + 250 * Cos(angle))
                    call SetUnitY(caster, GetUnitY(bjLCU) + 250 * Sin(angle))
                    call SetUnitFacingInstant(caster , angle * bj_RADTODEG + 180)
                    call SetUnitAnimationByIndex(caster, 8)
                    call SetUnitTimeScale(caster, 4)
                    set n=LoadUnitHandle(h, id, c_DUMMY1)
                    call SetUnitX(n , GetUnitX(caster))
                    call SetUnitY(n , GetUnitY(caster))
                    call GroupClear(bjLCG)
                    call SaveReal(h, id, c_DISTANCE, 0)
                    call SaveBoolean(h, id, 16, true)
                    call RengokuQ_Tossing(caster , bjLCU , LoadReal(h, id, c_DAMAGE) , angle , 0 , CreateTimer())
                    call SetControlToUnit(caster , bjLCU , 1 , "stun")
                    set caster_x= GetUnitX(caster)
                    set caster_y= GetUnitY(caster)
                    set n=CreateUnit(GetOwningPlayer(caster), 'dR60', caster_x, caster_y, angle * bj_RADTODEG + 180)
                    call SetUnitScale(n, 1.85, 1.85, 1.85)
                    call SetUnitTimeScale(n, 0.4)
                    call SetUnitFlyHeight(n, 160, 0)
                    call KillUnit(n)
                    call MyRemoveUnit(n , 2.6)
                    set n=CreateUnit(GetOwningPlayer(caster), 'dR60', caster_x, caster_y, angle * bj_RADTODEG + 180)
                    call SetUnitScale(n, 1.65, 1.65, 1.65)
                    call SetUnitTimeScale(n, 0.4)
                    call SetUnitFlyHeight(n, 160, 0)
                    call KillUnit(n)
                    call MyRemoveUnit(n , 2.6)
                    set n=CreateUnit(GetOwningPlayer(caster), 'dR60', caster_x, caster_y, angle * bj_RADTODEG + 180)
                    call SetUnitScale(n, 1.3, 1.3, 1.3)
                    call SetUnitTimeScale(n, 0.4)
                    call SetUnitFlyHeight(n, 160, 0)
                    call KillUnit(n)
                    call MyRemoveUnit(n , 2.6)
                else
                    call SaveBoolean(HH,GetHandleId(caster),DASH_USER,false)
                    call SaveUnitHandle(HH,GetHandleId(bjLCU),REVERSE_TARGET,caster)
                    call SaveReal(h, id, c_TIME, 12)
                endif
            endif
            call GroupRemoveUnit(bjLCG, bjLCU)
        endloop
    else
        call SaveBoolean(HH,GetHandleId(caster),DASH_USER,false)
        if time < 12 and target_detected == true then
            call SetUnitFacingInstant(caster , angle * bj_RADTODEG + 180)
            call SaveReal(h, id, c_TIME, time + 1)
        else
            if target_detected == false then
                set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR94', caster_x, caster_y, GetRandomInt(0, 360))
                call SetUnitScale(bjLCU, 0.75, 0.75, 0.75)
                call SetUnitVertexColor(bjLCU, 255, 255, 255, 185)
                call MyRemoveUnit(bjLCU, 1.2)
            endif
            call KillUnit(LoadUnitHandle(h, id, c_DUMMY1))
            call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY1), 1.5)
            call SetUnitTimeScale(caster, 1)
            call PauseUnit(caster, false)
            call SetUnitInvulnerable(caster, false)
            call DestroyGroup(LoadGroupHandle(h, id, c_GROUP1))
            call FlushChildHashtable(h, id)
            call DestroyTimer(GetExpiredTimer())
        endif
    endif
    set caster=null
endfunction

function RengokuQ_Base takes unit newCaster,real newDmg,real newAngle,real newDistance,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local real caster_x= GetUnitX(newCaster)
    local real caster_y= GetUnitY(newCaster)
    
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR42', caster_x, caster_y, newAngle*bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 60, 0)
    call SetUnitTimeScale(bjLCU, 0.7)
    call MyRemoveUnit(bjLCU, 1.5)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR39', caster_x, caster_y, newAngle*bj_RADTODEG+90)
    call SetUnitFlyHeight(bjLCU, 50, 0)
    call SetUnitTimeScale(bjLCU, 0.7)
    call SetUnitScale(bjLCU, 2, 2, 2)
    call MyRemoveUnit(bjLCU, 1.5)
        
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR64', caster_x + 50 * Cos(newAngle), caster_y + 50 * Sin(newAngle), newAngle * bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 160, 0)
    call SetUnitScale(bjLCU, 1.2, 1.2, 1.2)
    call MyRemoveUnit(bjLCU , 1.5)
        
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dRe8', caster_x, caster_y, newAngle * bj_RADTODEG)
        //set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dAlb', caster_x, caster_y, newAngle * bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 125, 0)
    call SetUnitScale(bjLCU, 2, 2, 2)
    call SaveUnitHandle(h, id, c_DUMMY1, bjLCU)
    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, 7)
    call SetUnitFacingInstant(newCaster, newAngle * bj_RADTODEG)
    call SaveUnitHandle(h, id, c_CASTER,        newCaster)
    call SaveReal(h, id, c_DAMAGE,              newDmg)
    call SaveReal(h, id, c_ANGLE,               newAngle)
    call SaveReal(h, id, c_DISTANCE,    newDistance)
    call SaveReal(h, id, c_SPEED,               newDistance / 18)
    call SaveBoolean(h, id, 16, false)
    call SaveGroupHandle(h, id, c_GROUP1, CreateGroup())
    call TimerStart(newTimer, 0.02, true, function RengokuQ_Base_Periodic)
endfunction


function RengokuQ_WQ_Periodic takes nothing returns nothing
    local integer id    = GetHandleId(GetExpiredTimer())
    local unit caster       = LoadUnitHandle(h, id, c_CASTER)
    local real caster_x = GetUnitX(caster)
    local real caster_y = GetUnitY(caster)
    local real distance = LoadReal(h, id, c_DISTANCE)
    local real speed    = LoadReal(h, id, c_SPEED)
    local real angle    = LoadReal(h, id, c_ANGLE)
    local real time             = LoadReal(h, id, c_TIME)
    local boolean target_detected= LoadBoolean(h, id, 16)
    local integer eff_period= LoadInteger(h, id, c_EFFPERIOD)
    local real rand_facing= 0
    if distance > 0 and LoadBoolean(HH,GetHandleId(caster),DASH_USER)==true then
        call SetUnitX(caster, caster_x + speed * Cos(angle))
        call SetUnitY(caster, caster_y + speed * Sin(angle))
        call SetUnitFacing(caster, angle * bj_RADTODEG)
        set bjLCU=LoadUnitHandle(h, id, c_DUMMY1)
        call SetUnitX(bjLCU , caster_x)
        call SetUnitY(bjLCU , caster_y)
        // set bjLCU=LoadUnitHandle(h, id, StringHash("Effect3"))
        // call SetUnitX(bjLCU , caster_x - speed * 3.5 * Cos(angle))
        // call SetUnitY(bjLCU , caster_y - speed * 3.5 * Sin(angle))
        if distance*2 >= speed * 17 then
            set bjLCU=LoadUnitHandle(h, id, c_DUMMY2)
            call SetUnitX(bjLCU , caster_x)
            call SetUnitY(bjLCU , caster_y)
        endif
        call SaveReal(h, id, c_DISTANCE, distance - speed)
        if eff_period == 0 then
            set rand_facing=GetRandomInt(0, 360)
            set n=CreateUnit(GetOwningPlayer(caster), 'dR47', caster_x, caster_y, rand_facing)
            call SetUnitScale(n, 3, 3, 3)
            call SetUnitTimeScale(n, 0.45)
            call SetUnitFlyHeight(n, - 100, 0)
            call MyRemoveUnit(n , 2)
            set n=CreateUnit(GetOwningPlayer(caster), 'dR47', caster_x, caster_y, rand_facing)
            call SetUnitScale(n, 3, 3, 3)
            call SetUnitTimeScale(n, 0.45)
            call SetUnitFlyHeight(n, - 100, 0)
            call MyRemoveUnit(n , 2)
            call SaveInteger(h, id, c_EFFPERIOD, 8)
        else
            call SaveInteger(h, id, c_EFFPERIOD, eff_period - 1)
        endif
        set bjLCG=LoadGroupHandle(h, id, c_GROUP1)
        call GroupEnumUnitsInRange(bjLCG, caster_x, caster_y, 300, Base)
        loop
        set bjLCU=FirstOfGroup(bjLCG)
        exitwhen bjLCU == null
            if Condition_Base(GetOwningPlayer(caster) , bjLCU) and IsUnitInGroup(bjLCU, LoadGroupHandle(h, id, c_GROUP2)) == false and IsUnitInvulnerable(bjLCU)==false then
                if LoadBoolean(HH,GetHandleId(bjLCU),ANTITARGET_ABILITY)==false then  
                    call RengokuQ_Tossing(caster , bjLCU , LoadReal(h, id, c_DAMAGE) , angle , 0.75 + distance * 0.0001 , CreateTimer())
                    call SetControlToUnit(caster , bjLCU , 1 , "stun")
                    call GroupAddUnit(LoadGroupHandle(h, id, c_GROUP2), bjLCU)
                    call SaveBoolean(h, id, 16, true)
                else
                    call PauseUnit(caster, false)
                    call SetUnitInvulnerable(caster, false)
                    call SaveBoolean(HH,GetHandleId(caster),DASH_USER,false)
                    call SaveUnitHandle(HH,GetHandleId(bjLCU),REVERSE_TARGET,caster)
                    call SaveReal(h, id, c_TIME, 38)
                    call KillUnit(LoadUnitHandle(h, id, c_DUMMY1))
                    // call KillUnit(LoadUnitHandle(h, id, StringHash("Effect3")))
                    call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY1), 1)
                endif
            endif
            call GroupRemoveUnit(bjLCG, bjLCU)
        endloop
    else
        call SaveBoolean(HH,GetHandleId(caster),DASH_USER,false)
        if time < 38 then
            if time == 1 then
                call PauseUnit(caster, false)
                call SetUnitInvulnerable(caster, false)
                call KillUnit(LoadUnitHandle(h, id, c_DUMMY1))
                // call KillUnit(LoadUnitHandle(h, id, StringHash("Effect3")))
                call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY1), 1)
                // call MyRemoveUnit(LoadUnitHandle(h, id, StringHash("Effect3")), 1)
            endif
            call SaveReal(h, id, c_TIME, time + 1)
        else
            if target_detected == true then
                call ShakeCamera(0.3 , 30)
                set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dAlb', caster_x, caster_y, 0)
                call MyRemoveUnit(bjLCU , 3)
                set n=CreateUnit(GetOwningPlayer(caster), 'dR46', GetUnitX(LoadUnitHandle(h, id, c_DUMMY2)), GetUnitY(LoadUnitHandle(h, id, c_DUMMY2)), 0)
                call SetUnitScale(n, 5, 5, 5)
                call SetUnitFlyHeight(n, 150, 0)
                call MyRemoveUnit(n , 1.5)
            
                set rand_facing=angle * bj_RADTODEG + 90
                set n=CreateUnit(GetOwningPlayer(caster), 'dR47', GetUnitX(LoadUnitHandle(h, id, c_DUMMY2)), GetUnitY(LoadUnitHandle(h, id, c_DUMMY2)), rand_facing)
                call SetUnitScale(n, 5, 5, 5)
                call SetUnitTimeScale(n, 0.5)
                call MyRemoveUnit(n , 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'dR47', GetUnitX(LoadUnitHandle(h, id, c_DUMMY2)), GetUnitY(LoadUnitHandle(h, id, c_DUMMY2)), rand_facing)
                call SetUnitScale(n, 5, 5, 5)
                call SetUnitTimeScale(n, 0.5)
                call MyRemoveUnit(n , 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'dR47', GetUnitX(LoadUnitHandle(h, id, c_DUMMY2)), GetUnitY(LoadUnitHandle(h, id, c_DUMMY2)), rand_facing)
                call SetUnitScale(n, 5, 5, 5)
                call SetUnitTimeScale(n, 0.5)
                call MyRemoveUnit(n , 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'dR47', GetUnitX(LoadUnitHandle(h, id, c_DUMMY2)), GetUnitY(LoadUnitHandle(h, id, c_DUMMY2)), rand_facing)
                call SetUnitScale(n, 5, 5, 5)
                call SetUnitTimeScale(n, 0.5)
                call MyRemoveUnit(n, 1.5)
            endif
            call KillUnit(LoadUnitHandle(h, id, c_DUMMY2))
            call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY2), 1.5)
            call SetUnitTimeScale(caster, 1)
            call DestroyGroup(LoadGroupHandle(h, id, c_GROUP1))
            call DestroyGroup(LoadGroupHandle(h, id, c_GROUP2))
            call FlushChildHashtable(h, id)
            call DestroyTimer(GetExpiredTimer())
        endif
    endif
    set caster=null
endfunction

function RengokuQ_WQ takes unit newCaster,real newDmg,real newAngle,real newDistance,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local real caster_x= GetUnitX(newCaster)
    local real caster_y= GetUnitY(newCaster)
    
    set soundplay=SndN(3239) // Sound\war3mapImported\RengokuQ_WQ.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set soundplay=SndN(3241) // Sound\war3mapImported\RengokuQ_WQ2.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR42', caster_x, caster_y, newAngle*bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 60, 0)
    call SetUnitTimeScale(bjLCU, 0.7)
    call MyRemoveUnit(bjLCU, 1.5)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR39', caster_x, caster_y, newAngle*bj_RADTODEG+90)
    call SetUnitFlyHeight(bjLCU, 50, 0)
    call SetUnitTimeScale(bjLCU, 0.7)
    call SetUnitScale(bjLCU, 2, 2, 2)
    call MyRemoveUnit(bjLCU, 1.5)
    
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dH10', caster_x, caster_y, newAngle*bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 60, 0)
    call SetUnitScale(bjLCU, 1.6, 1.6, 1.6)
    call MyRemoveUnit(bjLCU, 1.5)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dH11', caster_x, caster_y, newAngle*bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 10, 0)
    call SetUnitScale(bjLCU, 0.55, 0.55, 0.55)
    call MyRemoveUnit(bjLCU, 1.5)
        
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dRe8', caster_x, caster_y, newAngle * bj_RADTODEG)
        //set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dAlb', caster_x, caster_y, newAngle * bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 125, 0)
    call SetUnitScale(bjLCU, 2, 2, 2)
    call SaveUnitHandle(h, id, c_DUMMY1, bjLCU)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR20', caster_x, caster_y, newAngle * bj_RADTODEG)
    //set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dAlb', caster_x, caster_y, newAngle * bj_RADTODEG)
    call SetUnitScale(bjLCU, 3.5, 3.5, 3.5)
    call SetUnitVertexColor(bjLCU, 255, 255, 255, 180)
    call SetUnitTimeScale(bjLCU, 0.85)
    call SaveUnitHandle(h, id, c_DUMMY2, bjLCU)
        // set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR25', caster_x, caster_y, newAngle * bj_RADTODEG)
    // call SetUnitScale(bjLCU, 0.6, 0.6, 0.6)
        // call SetUnitFlyHeight(bjLCU, 50, 0)
    // call SaveUnitHandle(h, id, StringHash("Effect3"), bjLCU)
    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, 7)
    call SetUnitFacingInstant(newCaster , newAngle * bj_RADTODEG)
    call SaveUnitHandle(h, id, c_CASTER, newCaster)
    call SaveReal(h, id, c_DAMAGE,      newDmg)
    call SaveReal(h, id, c_ANGLE,       newAngle)
    call SaveReal(h, id, c_DISTANCE,newDistance)
    call SaveReal(h, id, c_SPEED,       newDistance / 18)
    call SaveBoolean(h, id, 16, false)
    call SaveGroupHandle(h, id, c_GROUP1,       CreateGroup())
    call SaveGroupHandle(h, id, c_GROUP2,       CreateGroup())
    call SaveInteger(h, id, c_EFFPERIOD,        3)
    call TimerStart(newTimer, 0.02, true, function RengokuQ_WQ_Periodic)
endfunction



function RengokuQ_EQ_Periodic takes nothing returns nothing
    local integer id    = GetHandleId(GetExpiredTimer())
    local unit caster       = LoadUnitHandle(h, id, c_CASTER)
    local unit target       = null
    local real caster_x = GetUnitX(caster)
    local real caster_y = GetUnitY(caster)
    local real distance = LoadReal(h, id, c_DISTANCE)
    local real speed    = LoadReal(h, id, c_SPEED)
    local real angle    = LoadReal(h, id, c_ANGLE)
    local real time             = LoadReal(h, id, c_TIME)
    local boolean target_detected= LoadBoolean(h, id, 16)
    local real target_x= 0
    local real target_y= 0
    local real anglespell= 0
    local real distancespell= 0
    if distance > 0 and LoadBoolean(HH,GetHandleId(caster),DASH_USER)==true then
        call SetUnitX(caster, caster_x + speed * Cos(angle))
        call SetUnitY(caster, caster_y + speed * Sin(angle))
        call SetUnitFacing(caster, angle * bj_RADTODEG)
        set bjLCU=LoadUnitHandle(h, id, c_DUMMY1)
        call SetUnitX(bjLCU , caster_x)
        call SetUnitY(bjLCU , caster_y)
        call SaveReal(h, id, c_DISTANCE, distance - speed)
        set bjLCG=LoadGroupHandle(h, id, c_GROUP1)
        call GroupEnumUnitsInRange(bjLCG, caster_x, caster_y, 175, Base)
        loop
        set bjLCU=FirstOfGroup(bjLCG)
        exitwhen bjLCU == null
            if Condition_Base(GetOwningPlayer(caster) , bjLCU) and IsUnitInvulnerable(bjLCU)==false then
                if LoadBoolean(HH,GetHandleId(bjLCU),ANTITARGET_ABILITY)==false then      
                    call SetUnitX(caster, GetUnitX(bjLCU) - 170 * Cos(angle))
                    call SetUnitY(caster, GetUnitY(bjLCU) - 170 * Sin(angle))
                    call SetUnitFacingInstant(caster , angle * bj_RADTODEG)
                    call SetUnitAnimationByIndex(caster, 8)
                    call SetUnitTimeScale(caster, 4)
                    set n=LoadUnitHandle(h, id, c_DUMMY1)
                    call SetUnitX(n , GetUnitX(caster))
                    call SetUnitY(n , GetUnitY(caster))
                    call GroupClear(bjLCG)
                    call SaveReal(h, id, c_DISTANCE, 0)
                    call SaveBoolean(h, id, 16, true)
                    call SaveUnitHandle(h, id, c_TARGET, bjLCU)
                    call RengokuQ_Tossing(caster , bjLCU , LoadReal(h, id, c_DAMAGE) , angle , 0 , CreateTimer())
                    set caster_x= GetUnitX(caster)
                    set caster_y= GetUnitY(caster)
                    set n=CreateUnit(GetOwningPlayer(caster), 'dR60', caster_x, caster_y, angle * bj_RADTODEG)
                    call SetUnitScale(n, 1.85, 1.85, 1.85)
                    call SetUnitTimeScale(n, 0.4)
                    call SetUnitFlyHeight(n, 160, 0)
                    call KillUnit(n)
                    call MyRemoveUnit(n , 2.6)
                    set n=CreateUnit(GetOwningPlayer(caster), 'dR60', caster_x, caster_y, angle * bj_RADTODEG)
                    call SetUnitScale(n, 1.65, 1.65, 1.65)
                    call SetUnitTimeScale(n, 0.4)
                    call SetUnitFlyHeight(n, 160, 0)
                    call KillUnit(n)
                    call MyRemoveUnit(n , 2.6)
                    set n=CreateUnit(GetOwningPlayer(caster), 'dR60', caster_x, caster_y, angle * bj_RADTODEG)
                    call SetUnitScale(n, 1.3, 1.3, 1.3)
                    call SetUnitTimeScale(n, 0.4)
                    call SetUnitFlyHeight(n, 160, 0)
                    call KillUnit(n)
                    call MyRemoveUnit(n , 2.6)
                else
                    call PauseUnit(caster, false)
                    call SetUnitInvulnerable(caster, false)
                    call SaveBoolean(HH,GetHandleId(caster),DASH_USER,false)
                    call SaveUnitHandle(HH,GetHandleId(bjLCU),REVERSE_TARGET,caster)
                    call SaveReal(h, id, c_TIME, 0.85)
                endif
            endif
            call GroupRemoveUnit(bjLCG, bjLCU)
        endloop
    else
        call SaveBoolean(HH,GetHandleId(caster),DASH_USER,false)
        if time < 0.85 and target_detected == true then
            call SaveReal(h, id, c_TIME, time + 0.02)
            set target=LoadUnitHandle(h, id, c_TARGET)
            if time == 0.44 then
                set n=CreateUnit(GetOwningPlayer(caster), 'dR88', caster_x, caster_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 0.85, 0.85, 0.85)
                call SetUnitFlyHeight(n, 5, 0)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'dR88', GetUnitX(bjLCU) + 170 * Cos(angle), GetUnitY(bjLCU) + 170 * Sin(angle), GetRandomInt(0, 360))
                call SetUnitScale(n, 0.85, 0.85, 0.85)
                call SetUnitFlyHeight(n, 450, 0)
                call MyRemoveUnit(n, 1.5)
                                
                call SetUnitX(caster, GetUnitX(target) + 170 * Cos(angle))
                call SetUnitY(caster, GetUnitY(target) + 170 * Sin(angle))
                call SetUnitFacingInstant(caster , angle * bj_RADTODEG + 180)
                call UnitAddAbility(caster, 'Arav')
                call UnitRemoveAbility(caster, 'Arav')
                call SetUnitFlyHeight(caster, 500, 0)
                set n=LoadUnitHandle(h, id, c_DUMMY1)
                call SetUnitX(n , GetUnitX(target) + 170 * Cos(angle))
                call SetUnitY(n , GetUnitY(target) + 170 * Sin(angle))
                call SetUnitFlyHeight(n , 500, 0)
                call SetUnitFacing(n , angle * bj_RADTODEG + 180)
            endif
            if time == 0.64 then
                call SetUnitFlyHeight(caster, 0, 600)
                call SetUnitAnimationByIndex(caster, 9)
            endif
            if time == 0.7 then
                set target_x=GetUnitX(target)
                set target_y=GetUnitY(target)
                set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH07', target_x, target_y, angle * bj_RADTODEG + 180)
                call SetUnitTimeScale(bjLCU, 0.6)
                call SetUnitFlyHeight(bjLCU, 600, 0)
                call MyRemoveUnit(bjLCU , 1.2)
                set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH08', target_x, target_y, angle * bj_RADTODEG + 180)
                call SetUnitTimeScale(bjLCU, 0.6)
                call SetUnitScale(bjLCU, 2, 2, 2)
                call SetUnitFlyHeight(bjLCU, 600, 0)
                call MyRemoveUnit(bjLCU , 1.2)
                set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR61', caster_x, caster_y, angle * bj_RADTODEG + 180)
                call SetUnitScale(bjLCU, 2, 2, 2)
                call SetUnitFlyHeight(bjLCU, 600, 0)
                call MyRemoveUnit(bjLCU , 1.2)
                set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR61', caster_x, caster_y, angle * bj_RADTODEG + 180)
                call SetUnitScale(bjLCU, 1.7, 1.7, 1.7)
                call SetUnitFlyHeight(bjLCU, 600, 0)
                call MyRemoveUnit(bjLCU , 1.2)
                set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH09', target_x, target_y, angle * bj_RADTODEG + 180)
                call SetUnitScale(bjLCU, 2, 2, 2)
                call SetUnitFlyHeight(bjLCU, 600, 0)
                call MyRemoveUnit(bjLCU , 1.2)
                call ShakeCamera(0.05 , 10)
            endif
            if time > 0.64 and time < 0.8 then
                call SetUnitFlyHeight(target, 500, 0)
                call IssueImmediateOrder(target, "stop")
            endif
            if time == 0.80 then
                set target_x=GetUnitX(target)
                set target_y=GetUnitY(target)
                set anglespell=AP(target_x , target_y , LoadReal(h, id, 17) , LoadReal(h, id, 18))
                set distancespell=SquareRootPoint(target_x , target_y , LoadReal(h, id, 17) , LoadReal(h, id, 18))
                call RengokuE_Shifting(caster , target , anglespell , distancespell , CreateTimer())
                call SetUnitFlyHeight(target, 0, 600)
                call SetControlToUnit(caster , target, 3 , "stun")
            endif
        else
            if target_detected == false then
                // set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR94', caster_x, caster_y, GetRandomInt(0, 360))
                // call SetUnitScale(bjLCU, 0.75, 0.75, 0.75)
                // call SetUnitVertexColor(bjLCU, 255, 255, 255, 185)
                // call MyRemoveUnit(bjLCU, 1.5)
            endif
            call KillUnit(LoadUnitHandle(h, id, c_DUMMY1))
            call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY1), 1)
            call SetUnitTimeScale(caster, 1)
            call PauseUnit(caster, false)
            call SetUnitInvulnerable(caster, false)
            call DestroyGroup(LoadGroupHandle(h, id, c_GROUP1))
            call FlushChildHashtable(h, id)
            call DestroyTimer(GetExpiredTimer())
        endif
    endif
    set caster=null
    set target=null
endfunction

function RengokuQ_EQ takes unit newCaster,real newDmg,real newAngle,real newDistance,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local real caster_x= GetUnitX(newCaster)
    local real caster_y= GetUnitY(newCaster)
    
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR42', caster_x, caster_y, newAngle*bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 60, 0)
    call SetUnitTimeScale(bjLCU, 0.7)
    call MyRemoveUnit(bjLCU, 1.5)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR39', caster_x, caster_y, newAngle*bj_RADTODEG+90)
    call SetUnitFlyHeight(bjLCU, 50, 0)
    call SetUnitTimeScale(bjLCU, 0.7)
    call SetUnitScale(bjLCU, 2, 2, 2)
    call MyRemoveUnit(bjLCU, 1.5)
        
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR64', caster_x + 50 * Cos(newAngle), caster_y + 50 * Sin(newAngle), newAngle * bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 160, 0)
    call SetUnitScale(bjLCU, 1.2, 1.2, 1.2)
    call MyRemoveUnit(bjLCU , 1.5)
    //currect set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dRe8', caster_x, caster_y, newAngle * bj_RADTODEG)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dAlb', caster_x, caster_y, newAngle * bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 125, 0)
    call SetUnitScale(bjLCU, 2, 2, 2)
    call SaveUnitHandle(h, id, c_DUMMY1, bjLCU)
    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, 7)
    call SetUnitFacingInstant(newCaster , newAngle * bj_RADTODEG)
    call SaveUnitHandle(h, id, c_CASTER, newCaster)
    call SaveReal(h, id, c_DAMAGE, newDmg)
    call SaveReal(h, id, c_ANGLE, newAngle)
    call SaveReal(h, id, 17, caster_x)  //DistanceCounterX
    call SaveReal(h, id, 18, caster_y)  //DistanceCounterY
    call SaveReal(h, id, c_DISTANCE, newDistance)
    call SaveReal(h, id, c_SPEED, newDistance / 17)
    call SaveBoolean(h, id, 16, false)
    call SaveGroupHandle(h, id, c_GROUP1, CreateGroup())
    call TimerStart(newTimer, 0.02, true, function RengokuQ_EQ_Periodic)
endfunction

function RengokuQ_Point takes nothing returns nothing
    local integer id= GetHandleId(GetTriggeringTrigger())
    local integer id_caster= GetHandleId(LoadUnitHandle(h, id, c_CASTER))
    if GetOrderTargetUnit() == null then
        call SaveReal(h, id_caster, 21, GetOrderPointX())
        call SaveReal(h, id_caster, 22, GetOrderPointY())
    else
        call SaveReal(h, id_caster, 21, GetUnitX(GetOrderTargetUnit()))
        call SaveReal(h, id_caster, 22, GetUnitY(GetOrderTargetUnit()))
    endif
    call FlushChildHashtable(h, id)
    call TriggerClearActions(GetTriggeringTrigger())
    call DestroyTrigger(GetTriggeringTrigger())
endfunction


function RengokuQ_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local integer id_caster= GetHandleId(LoadUnitHandle(h, id, c_CASTER))
    local real RengokuQ_X= LoadReal(h, id_caster, 21)
    local real RengokuQ_Y= LoadReal(h, id_caster, 22)
    local real caster_x= GetUnitX(LoadUnitHandle(h, id, c_CASTER))
    local real caster_y= GetUnitY(LoadUnitHandle(h, id, c_CASTER))
    local real time= LoadReal(h, id, c_TIME)
    local integer eff_period= LoadInteger(h, id, c_EFFPERIOD)
    local string combination= LoadStr(h, id, 15)
    if GetUnitCurrentOrder(LoadUnitHandle(h, id, c_CASTER)) == OrderId("channel") then
        call SaveReal(h, id, c_TIME, time + 0.05)
        if eff_period == 0 then
            set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, c_CASTER)), 'dR50', caster_x, caster_y, GetRandomInt(0, 360))
            call SetUnitScale(bjLCU, 0.45, 0.45, 0.45)
            call SetUnitVertexColor(bjLCU, 255, 255, 255, 125)
            call SetUnitTimeScale(bjLCU, 0.7)
            call SetUnitFlyHeight(bjLCU, 10, 0)
            call MyRemoveUnit(bjLCU, 1.5)
                        
            call SaveInteger(h, id, c_EFFPERIOD, 4)
        else
            call SaveInteger(h, id, c_EFFPERIOD, eff_period - 1)
        endif
    else
        call SetUnitTimeScale(LoadUnitHandle(h, id, c_CASTER), 1)
        call SaveBoolean(HH,GetHandleId(LoadUnitHandle(h, id, c_CASTER)),DASH_USER,true)
        if RengokuQ_X != 0 and RengokuQ_Y != 0 then
            if combination == "W" then
                call RengokuQ_WQ(LoadUnitHandle(h, id, c_CASTER) , LoadReal(h, id, c_DAMAGE) , AP(caster_x, caster_y, RengokuQ_X, RengokuQ_Y), 1250 , CreateTimer())
            elseif combination == "E" then
                set soundplay=SndN(3243) // Sound\war3mapImported\RengokuQ2.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                set soundplay=SndN(3246) // Sound\war3mapImported\RengokuQ3.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                call RengokuQ_EQ(LoadUnitHandle(h, id, c_CASTER) , LoadReal(h, id, c_DAMAGE) , AP(caster_x, caster_y, RengokuQ_X, RengokuQ_Y), 1250+250*time , CreateTimer())
            else
                set soundplay=SndN(3243) // Sound\war3mapImported\RengokuQ2.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                set soundplay=SndN(3246) // Sound\war3mapImported\RengokuQ3.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                call RengokuQ_Base(LoadUnitHandle(h, id, c_CASTER) , LoadReal(h, id, c_DAMAGE) , AP(caster_x, caster_y, RengokuQ_X, RengokuQ_Y), 1250+250*time , CreateTimer())
            endif
        endif
        call RemoveSavedReal(h, id_caster, 21)
        call RemoveSavedReal(h, id_caster, 25)
        call FlushChildHashtable(h, GetHandleId(LoadTriggerHandle(h, id, 16)))
        call TriggerClearActions(LoadTriggerHandle(h, id, 16))
        call DestroyTrigger(LoadTriggerHandle(h, id, 16))
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
endfunction

function RengokuQ_Cast takes unit newCaster,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local integer id_caster= GetHandleId(newCaster)
    local real caster_x= GetUnitX(newCaster)
    local real caster_y= GetUnitY(newCaster)
    local boolean RengokuD_Buff= RengokuD_Cast(newCaster)
    local trigger newTrigger= CreateTrigger()
    local string RengokuQWE_Comb= RengokuQWE_Combination(newCaster , "Q")
    local real full_damage= ( 2 + GetUnitAbilityLevel(newCaster, 'RenQ') ) * GetHeroAgi(newCaster, true)
    if GetUnitAbilityLevel(newCaster, 'ReFP') >= 1 or LoadBoolean(HH, id_caster, RengokuF_Pass) == true then
        set full_damage=full_damage + GetHeroAgi(newCaster, true)
    endif
    if RengokuD_Buff == true then
        set full_damage=full_damage * 1.15
    endif
    call SetUnitTimeScale(newCaster, 0.4)
    call SetUnitAnimationByIndex(newCaster, 7)
    set soundplay=SndN(3249) // Sound\war3mapImported\RengokuQ1.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call SaveUnitHandle(h, GetHandleId(newTrigger), c_CASTER, newCaster)
    call TriggerRegisterUnitEvent(newTrigger, newCaster, EVENT_UNIT_ISSUED_POINT_ORDER)
    call TriggerRegisterUnitEvent(newTrigger, newCaster, EVENT_UNIT_ISSUED_TARGET_ORDER)
    call TriggerAddAction(newTrigger, function RengokuQ_Point)
    call SaveReal(h, id_caster, 21, 0)  //RengokuQ_X
    call SaveReal(h, id_caster, 22, 0)  //RengokuQ_Y
    call SaveTriggerHandle(h, id, 16, newTrigger)
    call SaveUnitHandle(h, id, c_CASTER, newCaster)
    call SaveStr(h, id, 15, RengokuQWE_Comb)    //Combination
    call SaveReal(h, id, c_DAMAGE, full_damage)
    call TimerStart(newTimer, 0.05, true, function RengokuQ_Periodic)
    set newTrigger=null 
endfunction


function RengokuW_EW_Act takes unit newCaster,unit newTarget,real BaseAngle,unit newDummy,real newDistance returns nothing
    local real newAngle= BaseAngle
    
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH01', GetUnitX(newTarget), GetUnitY(newTarget), AU(newCaster , newTarget) * bj_RADTODEG)
        call SetUnitScale(n, 1.8, 1.8, 1.8)
        call SetUnitFlyHeight(n, 100, 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH02', GetUnitX(newTarget), GetUnitY(newTarget), AU(newCaster , newTarget) * bj_RADTODEG)
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call SetUnitFlyHeight(n, 75, 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH03', GetUnitX(newTarget), GetUnitY(newTarget), GetRandomInt(0, 360))
        call SetUnitScale(n, 0.8, 0.8, 0.8)
        call SetUnitFlyHeight(n, 150, 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dR42', GetUnitX(newTarget), GetUnitY(newTarget), newAngle * bj_RADTODEG)
        call SetUnitScale(n, 0.6, 0.6, 0.6)
        call SetUnitFlyHeight(n, 125, 0)
        call MyRemoveUnit(n, 1.5)
    
    call SetControlToUnit(newCaster , newTarget , 0.15 , "stun")
    call RengokuE_Shifting(newCaster , newTarget , BaseAngle , newDistance , CreateTimer())
endfunction


function RengokuW_Cast_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
        local unit caster=LoadUnitHandle(h, id, c_CASTER)
    local real caster_x= GetUnitX(caster)
    local real caster_y= GetUnitY(caster)
    local real angle= LoadReal(h, id, c_ANGLE)
    local real time= LoadReal(h, id, c_TIME)
    local real damage= LoadReal(h, id, c_DAMAGE)
    local string combination= LoadStr(h, id, 16)
    local integer eff_period= LoadInteger(h, id, c_EFFPERIOD)
    if time < 20 then
        call SaveReal(h, id, c_TIME, time + 1)
        if time == 1 then
            call SetUnitAnimationByIndex(LoadUnitHandle(h, id, c_CASTER), 9)
        endif
        if time < 18 then
            set bjLCU=LoadUnitHandle(h, id, 16)
            call SetUnitX(bjLCU , caster_x + 200 * Cos(angle + ( 90 - time * 11 ) * bj_DEGTORAD))
            call SetUnitY(bjLCU , caster_y + 200 * Sin(angle + ( 90 - time * 11 ) * bj_DEGTORAD))
            set bjLCU=LoadUnitHandle(h, id, 17)
            call SetUnitX(bjLCU , caster_x + 325 * Cos(angle + ( 90 - time * 11 ) * bj_DEGTORAD))
            call SetUnitY(bjLCU , caster_y + 325 * Sin(angle + ( 90 - time * 11 ) * bj_DEGTORAD))
            set bjLCU=LoadUnitHandle(h, id, 18)
            call SetUnitX(bjLCU , caster_x + 450 * Cos(angle + ( 90 - time * 11 ) * bj_DEGTORAD))
            call SetUnitY(bjLCU , caster_y + 450 * Sin(angle + ( 90 - time * 11) * bj_DEGTORAD))
            call SetUnitFacing(LoadUnitHandle(h, id, c_DUMMY1), angle * bj_RADTODEG + 75 - time * 4)
            call SetUnitFacing(LoadUnitHandle(h, id, c_DUMMY2), angle * bj_RADTODEG + 75 - time * 4)
            call SetUnitFacing(LoadUnitHandle(h, id, c_DUMMY3), angle * bj_RADTODEG + 75 - time * 4)
            call SetUnitFacing(LoadUnitHandle(h, id, c_DUMMY4), angle * bj_RADTODEG + 75 - time * 4)
            if combination == "E" then
                if eff_period == 0 then
                    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR99', caster_x+150*Cos(angle+(90-time*11)*bj_DEGTORAD), caster_y+150*Sin(angle+(90-time*11)*bj_DEGTORAD), 140 + angle * bj_RADTODEG + 33 - time * 4)
                    call SetUnitScale(bjLCU, 0.8, 0.8, 0.8)
                    call SetUnitVertexColor(bjLCU, 255, 255, 255, 100)
                    call MyRemoveUnit(bjLCU, 1.5)
                    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR99', caster_x + 300 * Cos(angle + ( 90 - time * 11 ) * bj_DEGTORAD), caster_y + 300 * Sin(angle + ( 90 - time * 11 ) * bj_DEGTORAD), 140 + angle * bj_RADTODEG + 33 - time * 4)
                    call SetUnitVertexColor(bjLCU, 255, 255, 255, 100)
                    call MyRemoveUnit(bjLCU, 1.5)
                    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR99', caster_x + 450 * Cos(angle + ( 90 - time * 11 ) * bj_DEGTORAD), caster_y + 450 * Sin(angle + ( 90 - time * 11 ) * bj_DEGTORAD), 140 + angle * bj_RADTODEG + 33 - time * 4)
                    call SetUnitScale(bjLCU, 1.3, 1.3, 1.3)
                    call SetUnitVertexColor(bjLCU, 255, 255, 255, 100)
                    call MyRemoveUnit(bjLCU, 1.5)
                    call SaveInteger(h, id, c_EFFPERIOD, 3)
                else
                    call SaveInteger(h, id, c_EFFPERIOD, eff_period - 1)
                endif
            endif
            set bjLCG=LoadGroupHandle(h, id, c_GROUP1)
            call GroupEnumUnitsInRange(bjLCG, caster_x + 320 * Cos(angle + ( 49 - time * 5 ) * bj_DEGTORAD), caster_y + 320 * Sin(angle + ( 49 - time * 5 ) * bj_DEGTORAD), 330, Base)
            loop
            set bjLCU=FirstOfGroup(bjLCG)
            exitwhen bjLCU == null
                if Condition_Base(GetOwningPlayer(caster) , bjLCU) and IsUnitInGroup(bjLCU, LoadGroupHandle(h, id, c_GROUP2)) == false then
                    call myCustomDamage(caster , bjLCU , damage , false , false , null , null , null)
                    call SetControlToUnit(caster, bjLCU , 0.15 , "stun")
                    call RengokuE_Shifting(caster , bjLCU , LoadReal(h, id, 19) , 150 , CreateTimer())
                    call SlowUnit(caster,bjLCU,0.5,0.5,3,0,false)
					set n=CreateUnit(GetOwningPlayer(caster), 'dR36', GetUnitX(bjLCU), GetUnitY(bjLCU), GetRandomInt(0, 360))
					call SetUnitScale(n, 2, 2, 2)
					call MyRemoveUnit(n, 1.5)
                    if combination == "Q" then
                        call SetControlToUnit(caster, bjLCU , 2 , "stun")
                        set n=CreateUnit(GetOwningPlayer(caster), 'dH04', GetUnitX(bjLCU), GetUnitY(bjLCU), 0)
                        call SetUnitScale(n, 2, 2, 2)
                        call MyRemoveUnit(n, 1.5)
                    endif
                    if combination == "E" then
                        call RengokuW_EW_Act(caster, bjLCU , LoadReal(h, id, 19) , null, 1000)
                    endif
                    call GroupAddUnit(LoadGroupHandle(h, id, c_GROUP2), bjLCU)
                endif
                call GroupRemoveUnit(bjLCG, bjLCU)
            endloop
        endif
    else
        call KillUnit(LoadUnitHandle(h, id, 16))
        call KillUnit(LoadUnitHandle(h, id, 17))
        call KillUnit(LoadUnitHandle(h, id, 18))
        call MyRemoveUnit(LoadUnitHandle(h, id, 16), 1.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, 17), 1.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, 18), 1.5)
        call DestroyGroup(LoadGroupHandle(h, id, c_GROUP1))
        call DestroyGroup(LoadGroupHandle(h, id, c_GROUP2))
        //call PauseUnit(LoadUnitHandle(h, id, CasterHash), false)
        //call SetUnitInvulnerable(LoadUnitHandle(h, id, CasterHash), false)
        //call SetUnitTimeScale(LoadUnitHandle(h, id, CasterHash), 1.0)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
        set caster=null
endfunction



function RengokuW_Cast takes unit newCaster,real point_x,real point_y,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local integer id_caster= GetHandleId(newCaster)
    local real caster_x= GetUnitX(newCaster)
    local real caster_y= GetUnitY(newCaster)
    local real angle= AP(caster_x , caster_y , point_x , point_y)
    local boolean RengokuD_Buff= RengokuD_Cast(newCaster)
    local string RengokuQWE_Comb= RengokuQWE_Combination(newCaster , "W")
    local real full_damage= GetUnitAbilityLevel(newCaster, 'RenW') * GetHeroAgi(newCaster, true) + 60 * GetUnitAbilityLevel(newCaster, 'RenW') 
    if GetUnitAbilityLevel(newCaster, 'ReFP') >= 1 or LoadBoolean(h, id_caster, RengokuF_Pass) == true then
        set full_damage=full_damage + GetHeroAgi(newCaster, true)
    endif
    if RengokuD_Buff == true then
        set full_damage=full_damage * 1.15
    endif
    //call PauseUnit(newCaster, true)
    //call SetUnitInvulnerable(newCaster, true)
    //call SetUnitTimeScale(newCaster, 1.2)
        
    call ShakeCamera(0.3 , 10)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR42', caster_x, caster_y, angle*bj_RADTODEG)
        call SetUnitVertexColor(bjLCU, 255, 255, 255, 100)
        call SetUnitFlyHeight(bjLCU, 100, 0)
        call MyRemoveUnit(bjLCU, 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dH05', caster_x, caster_y, angle*bj_RADTODEG)
        call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
        call MyRemoveUnit(bjLCU, 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dH06', caster_x, caster_y, angle*bj_RADTODEG)
        call SetUnitScale(bjLCU, 1.2, 1.2, 1.2)
        call SetUnitTimeScale(bjLCU, 0.6)
        call SetUnitFlyHeight(bjLCU, 50, 0)
        call MyRemoveUnit(bjLCU, 1.5)

    set soundplay=SndN(3251) // Sound\war3mapImported\RengokuW3.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR18', caster_x - 50 * Cos(angle), caster_y - 50 * Sin(angle), angle * bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 200, 0)
    call SetUnitScale(bjLCU, 3.5, 3.5, 3.5)
    call SetUnitTimeScale(bjLCU, 0.5)
    call SaveUnitHandle(h, id, c_DUMMY1, bjLCU)
    call MyRemoveUnit(bjLCU , 3)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR18', caster_x - 90 * Cos(angle), caster_y - 90 * Sin(angle), angle * bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 200, 0)
    call SetUnitScale(bjLCU, 3, 3, 3)
    call SetUnitTimeScale(bjLCU, 0.5)
    call SaveUnitHandle(h, id, c_DUMMY2, bjLCU)
    call MyRemoveUnit(bjLCU , 3)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR18', caster_x - 150 * Cos(angle), caster_y - 150 * Sin(angle), angle * bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 200, 0)
    call SetUnitScale(bjLCU, 2.8, 2.8, 2.8)
    call SetUnitTimeScale(bjLCU, 0.5)
    call SaveUnitHandle(h, id, c_DUMMY3, bjLCU)
    call MyRemoveUnit(bjLCU , 3)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR18', caster_x - 150 * Cos(angle), caster_y - 150 * Sin(angle), angle * bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 200, 0)
    call SetUnitScale(bjLCU, 2, 2, 2)
    call SetUnitTimeScale(bjLCU, 0.5)
    call SaveUnitHandle(h, id, c_DUMMY4, bjLCU)
    call MyRemoveUnit(bjLCU , 3)
    
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dRe9', caster_x+150*Cos(angle), caster_y+150*Sin(angle), angle*bj_RADTODEG)
        call SetUnitScale(bjLCU, 2.25, 2.25, 2.25)
        call SaveUnitHandle(h, id, 16, bjLCU)
    if RengokuQWE_Comb == "Q" then
        call SetUnitScale(bjLCU, 3.25, 3.25, 3.25)
    endif
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dRe9', caster_x+150*Cos(angle), caster_y+150*Sin(angle), angle*bj_RADTODEG)
        call SetUnitScale(bjLCU, 2.75, 2.75, 2.75)
        call SaveUnitHandle(h, id, 17, bjLCU)
    if RengokuQWE_Comb == "Q" then
        call SetUnitScale(bjLCU, 3.75, 3.75, 3.75)
    endif
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dRe9', caster_x+150*Cos(angle), caster_y+150*Sin(angle), angle*bj_RADTODEG)
        call SetUnitScale(bjLCU, 3, 3, 3)
        call SaveUnitHandle(h, id, 18, bjLCU)
    if RengokuQWE_Comb == "Q" then
        call SetUnitScale(bjLCU, 4, 4, 4)
    endif
    call SaveUnitHandle(h, id, c_CASTER, newCaster)
    call SaveReal(h, id, c_ANGLE, angle)
    call SaveReal(h, id, 19, angle)
    call SaveReal(h, id, c_DAMAGE, full_damage)
    call SaveStr(h, id, 16, RengokuQWE_Comb)
    call SaveGroupHandle(h, id, c_GROUP1, CreateGroup())
    call SaveGroupHandle(h, id, c_GROUP2, CreateGroup())
    call TimerStart(newTimer, 0.02, true, function RengokuW_Cast_Periodic)
endfunction





function RengokuE_QE_Periodic takes nothing returns nothing
    local integer id    = GetHandleId(GetExpiredTimer())
        local unit caster       = LoadUnitHandle(h, id, c_CASTER)
        local unit target       = LoadUnitHandle(h, id, c_TARGET)
    local real caster_x = GetUnitX(caster)
    local real caster_y = GetUnitY(caster)
    local real target_x = GetUnitX(target)
    local real target_y = GetUnitY(target)
    local real angle    = LoadReal(h, id, c_ANGLE)
    local real time             = LoadReal(h, id, c_TIME)
    local boolean AOE_Bool= LoadBoolean(h, id, 20)
    if time < 2.8 then
        call SaveReal(h, id, c_TIME, time + 0.02)
        if time > 0.4 and time < 1 then
            call SetUnitX(caster, caster_x - ( 7 - time * 3 ) * Cos(angle))
            call SetUnitY(caster, caster_y - ( 7 - time * 3 ) * Sin(angle))
            call PauseUnit(target,true)
            call SetUnitInvulnerable(target, true)
            call PauseUnit(caster,true)
            call SetUnitInvulnerable(caster, true)
        endif
        if AOE_Bool == true and time > 1 and time < 1.6 then
            call PauseUnit(target,true)
            call SetUnitInvulnerable(target, true)
            call PauseUnit(caster,true)
            call SetUnitInvulnerable(caster, true)
            set bjLCG=LoadGroupHandle(h, id, c_GROUP1)
            call GroupEnumUnitsInRange(bjLCG, target_x, target_y, 400, Base)
            loop
            set bjLCU=FirstOfGroup(bjLCG)
            exitwhen bjLCU == null
                if Condition_Base(GetOwningPlayer(caster) , bjLCU) then
                    call IssueImmediateOrder(bjLCU, "stop")
                    if LoadInteger(h, id, 32) == 0 then
                        set n=CreateUnit(GetOwningPlayer(caster), 'dH12', GetUnitX(bjLCU), GetUnitY(bjLCU), GetRandomInt(0, 360))
                        call SetUnitFlyHeight(n, GetUnitFlyHeight(bjLCU)+GetRandomInt(60,100), 0)
                        call SetUnitScale(n, 0.5, 0.5, 0.5)
                        call MyRemoveUnit(n, 0.5)
                    endif
                endif
                call GroupRemoveUnit(bjLCG, bjLCU)
            endloop
            if LoadInteger(h, id, 32) <= 0 then
                call SaveInteger(h, id, 32, 3)
            else
                call SaveInteger(h, id, 32, LoadInteger(h, id, 32) - 1)
            endif
        endif
        if time == 1.1 then
            call PauseUnit(target,true)
            call SetUnitInvulnerable(target, true)
            call PauseUnit(caster,true)
            call SetUnitInvulnerable(caster, true)
            set n=CreateUnit(GetOwningPlayer(caster), 'dR42', caster_x, caster_y, angle*bj_RADTODEG)
            call SetUnitFlyHeight(n, 60, 0)
            call SetUnitTimeScale(n, 0.7)
            call MyRemoveUnit(n, 1.5)
            set n=CreateUnit(GetOwningPlayer(caster), 'dR88', caster_x, caster_y, angle*bj_RADTODEG+90)
            call SetUnitFlyHeight(n, 1, 0)
            call SetUnitTimeScale(n, 0.65)
            call SetUnitScale(n, 0.9, 0.9, 0.9)
            call MyRemoveUnit(n, 1.5)
            set n=CreateUnit(GetOwningPlayer(caster), 'dR27', caster_x, caster_y, angle*bj_RADTODEG)
            call SetUnitFlyHeight(n, 1, 0)
            call SetUnitScale(n, 0.4, 0.4, 0.4)
            call SetUnitVertexColor(n, 255, 255, 255, 110)
            call MyRemoveUnit(n, 1.5)
        endif
        if time == 1.2 or time == 1.3 or time == 1.4 or time == 1.5 then
            call PauseUnit(target,true)
            call SetUnitInvulnerable(target, true)
            call PauseUnit(caster,true)
            call SetUnitInvulnerable(caster, true)
            set angle=LoadReal(h, id, 29) + 90 * bj_DEGTORAD
            call SetUnitX(caster, target_x - 200 * Cos(angle))
            call SetUnitY(caster, target_y - 200 * Sin(angle))
            call SaveReal(h, id, 29, angle)
            call SetUnitFacingInstant(caster , angle * bj_RADTODEG)
            call SetUnitAnimationByIndex(caster, 8)
            set caster_x=GetUnitX(caster)
            set caster_y=GetUnitY(caster)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR59', caster_x - 100 * Cos(angle), caster_y - 100 * Sin(angle), angle * bj_RADTODEG)
            call SetUnitScale(bjLCU, 1.9, 1.9, 1.9)
            call SetUnitFlyHeight(bjLCU, 180, 0)
            call SetUnitAnimation(bjLCU, "birth")
            call UnitApplyTimedLife(bjLCU, 'BTLF', 0.4)
            call MyRemoveUnit(bjLCU , 1.6)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR60', caster_x - 100 * Cos(angle), caster_y - 100 * Sin(angle), angle * bj_RADTODEG)
            call SetUnitScale(bjLCU, 2.3, 2.3, 2.3)
            call SetUnitFlyHeight(bjLCU, 180, 0)
            call SetUnitTimeScale(bjLCU, 0.7)
            call MyRemoveUnit(bjLCU , 1.6)
                        set bjLCU = CreateUnit(GetOwningPlayer(caster), 'dR10', target_x - 200 * Cos(angle), target_y - 200 * Sin(angle), angle * bj_RADTODEG)
                        call SetUnitVertexColor(bjLCU, 255, 255, 255, 75)
                        call SetUnitTimeScale(bjLCU, 3)
                        call SetUnitAnimationByIndex(bjLCU, 8)
                        call MyRemoveUnit(bjLCU, 0.4)
                        set n=CreateUnit(GetOwningPlayer(caster), 'dR42', caster_x, caster_y, angle*bj_RADTODEG)
                        call SetUnitFlyHeight(n, 60, 0)
                        call SetUnitTimeScale(n, 0.7)
                        call MyRemoveUnit(n, 1.5)
                        set n=CreateUnit(GetOwningPlayer(caster), 'dR88', caster_x, caster_y, angle*bj_RADTODEG+90)
                        call SetUnitFlyHeight(n, 1, 0)
                        call SetUnitTimeScale(n, 0.65)
                        call SetUnitScale(n, 0.8, 0.8, 0.8)
                        call MyRemoveUnit(n, 1.5)
                        set n=CreateUnit(GetOwningPlayer(caster), 'dR27', caster_x, caster_y, angle*bj_RADTODEG)
                        call SetUnitFlyHeight(n, 1, 0)
                        call SetUnitScale(n, 0.2, 0.2, 0.2)
                        call SetUnitVertexColor(n, 255, 255, 255, 90)
                        call MyRemoveUnit(n, 1.5)
                        
            // set bjLCE=AddSpecialEffect("zhendi-qiquan-boom.mdl", caster_x, caster_y)
            // call SetSpecialEffectScale(bjLCE , 2)
            // call DestroyEffect(bjLCE)
        endif
        if time == 1.6 then
            call UnitAddAbility(target, 'Arav')
            call UnitRemoveAbility(target, 'Arav')
            call PauseUnit(target,true)
            call SetUnitInvulnerable(target, true)
            call PauseUnit(caster,true)
            call SetUnitInvulnerable(caster, true)
            call SetUnitFlyHeight(target, 600, 2500)
            if AOE_Bool == true then
            set bjLCG=LoadGroupHandle(h, id, c_GROUP1)
            call GroupEnumUnitsInRange(bjLCG, target_x, target_y, 400, Base)
            loop
            set bjLCU=FirstOfGroup(bjLCG)
            exitwhen bjLCU == null
                if Condition_Base(GetOwningPlayer(caster) , bjLCU) and bjLCU != target then
                    call IssueImmediateOrder(bjLCU, "stop")
                    call GroupAddUnit(LoadGroupHandle(h, id, c_GROUP2), bjLCU)
                    call UnitAddAbility(bjLCU, 'Arav')
                    call UnitRemoveAbility(bjLCU, 'Arav')
                    call SetUnitFlyHeight(bjLCU, 600, 2500)
                endif
                call GroupRemoveUnit(bjLCG, bjLCU)
            endloop
            endif
        elseif time == 1.86 then
                        call UnitAddAbility(caster, 'Arav')
            call SetUnitFlyHeight(caster, 600, 0)
                        call UnitRemoveAbility(caster, 'Arav')
            call SetUnitX(caster, target_x - 200 * Cos(angle))
            call SetUnitY(caster, target_y - 200 * Sin(angle))
        elseif time == 2.3 then
            call SetUnitAnimationByIndex(caster, 6)
        elseif time == 2.4 then
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH07', target_x, target_y, angle * bj_RADTODEG)
            call SetUnitTimeScale(bjLCU, 0.6)
            call SetUnitFlyHeight(bjLCU, 600, 0)
            call MyRemoveUnit(bjLCU , 1.2)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH08', target_x, target_y, angle * bj_RADTODEG)
            call SetUnitTimeScale(bjLCU, 0.6)
            call SetUnitScale(bjLCU, 2.5, 2.5, 2.5)
            call SetUnitFlyHeight(bjLCU, 600, 0)
            call MyRemoveUnit(bjLCU , 1.2)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR61', caster_x, caster_y, angle * bj_RADTODEG)
            call SetUnitScale(bjLCU, 2.5, 2.5, 2.5)
            call SetUnitFlyHeight(bjLCU, 600, 0)
            call MyRemoveUnit(bjLCU , 1.2)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR61', caster_x, caster_y, angle * bj_RADTODEG)
            call SetUnitScale(bjLCU, 2, 2, 2)
            call SetUnitFlyHeight(bjLCU, 600, 0)
            call MyRemoveUnit(bjLCU , 1.2)
                        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH09', caster_x, caster_y, angle * bj_RADTODEG)
            call SetUnitScale(bjLCU, 2, 2, 2)
            call SetUnitFlyHeight(bjLCU, 600, 0)
            call MyRemoveUnit(bjLCU , 1.2)
            call ShakeCamera(0.05 , 10)
        endif
        if time >= 2.4 and time < 2.6 then
            call PauseUnit(target,true)
            call SetUnitInvulnerable(target, true)
            call PauseUnit(caster,true)
            call SetUnitInvulnerable(caster, true)
            set angle=LoadReal(h, id, c_ANGLE)
            call SetUnitX(target, target_x + 5 * Cos(angle))
            call SetUnitY(target, target_y + 5 * Sin(angle))
            call SetUnitFlyHeight(target, GetUnitFlyHeight(target) - 30, 0)
            if AOE_Bool == true then
            set bjLCG=LoadGroupHandle(h, id, c_GROUP1)
            loop
            set bjLCU=FirstOfGroup(LoadGroupHandle(h, id, c_GROUP2))
            exitwhen bjLCU == null
            call GroupAddUnit(bjLCG, bjLCU)
            call GroupRemoveUnit(LoadGroupHandle(h, id, c_GROUP2), bjLCU)
            endloop
            loop
            set bjLCU=FirstOfGroup(bjLCG)
            exitwhen bjLCU == null
                if Condition_Base(GetOwningPlayer(caster) , bjLCU) and bjLCU != target then
                    call IssueImmediateOrder(bjLCU, "stop")
                    call SetUnitX(bjLCU, GetUnitX(bjLCU) + 5 * Cos(angle))
                    call SetUnitY(bjLCU, GetUnitY(bjLCU) + 5 * Sin(angle))
                    call SetUnitFlyHeight(bjLCU, GetUnitFlyHeight(bjLCU) - 30, 0)
                    call GroupAddUnit(LoadGroupHandle(h, id, c_GROUP2), bjLCU)
                endif
                call GroupRemoveUnit(bjLCG, bjLCU)
            endloop
            endif
        endif
        if time == 2.6 then
            call ShakeCamera(0.3 , 20)
            call SetUnitFlyHeight(target, 0, 0)
            call PauseUnit(target,false)
            call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
            call SetUnitInvulnerable(target, false)
            call SetUnitAnimation(target, "death")
            call myCustomDamage(caster , target , LoadReal(h, id, c_DAMAGE) , false , false , null , null , null)
            call SetControlToUnit(caster , target , 2 , "stun")
            if AOE_Bool == true then
            set bjLCG=LoadGroupHandle(h, id, c_GROUP1)
            loop
            set bjLCU=FirstOfGroup(LoadGroupHandle(h, id, c_GROUP2))
            exitwhen bjLCU == null
            call GroupAddUnit(bjLCG, bjLCU)
            call GroupRemoveUnit(LoadGroupHandle(h, id, c_GROUP2), bjLCU)
            endloop
            loop
            set bjLCU=FirstOfGroup(bjLCG)
            exitwhen bjLCU == null
                if Condition_Base(GetOwningPlayer(caster) , bjLCU) and bjLCU!=target then
                    call IssueImmediateOrder(bjLCU, "stop")
                    call SetUnitAnimation(bjLCU, "death")
                    call myCustomDamage(caster , bjLCU , LoadReal(h, id, c_DAMAGE) , false , false , null , null , null)
                    call SetControlToUnit(caster , bjLCU , 2 , "stun")
                    call GroupAddUnit(LoadGroupHandle(h, id, c_GROUP2), bjLCU)
                endif
                call GroupRemoveUnit(bjLCG, bjLCU)
            endloop
            endif
            // set bjLCE=AddSpecialEffect("OPm (496).mdl", target_x, target_y)
            // call SetSpecialEffectZ(bjLCE , 1)
            // call SetSpecialEffectScale(bjLCE , 0.75)
            // call SetSpecialEffectFacing(bjLCE , LoadReal(h, id, c_ANGLE) * bj_RADTODEG)
            // call DestroyEffect(bjLCE)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH13', target_x, target_y, GetRandomInt(0, 360))
            call SetUnitScale(bjLCU, 1.65, 1.65, 1.65)
            call UnitApplyTimedLife(bjLCU, 'BTLF', 0.8)
            call MyRemoveUnit(bjLCU, 1.5)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR13', target_x, target_y, LoadReal(h, id, AngleHash) * bj_RADTODEG)
            call SetUnitScale(bjLCU, 1.35, 1.35, 1.35)
            call SetUnitFlyHeight(bjLCU, 10, 0)
            call MyRemoveUnit(bjLCU, 1.5)
            

            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH14', target_x, target_y, LoadReal(h, id, AngleHash) * bj_RADTODEG)
            call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
            call SetUnitFlyHeight(bjLCU, 10, 0)
            call MyRemoveUnit(bjLCU, 1.5)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH15', target_x, target_y, LoadReal(h, id, AngleHash) * bj_RADTODEG)
            call SetUnitFlyHeight(bjLCU, 10, 0)
            call MyRemoveUnit(bjLCU, 1.5)
        endif
    else
        if AOE_Bool == true then
            call DestroyGroup(LoadGroupHandle(h, id, c_GROUP1))
            call DestroyGroup(LoadGroupHandle(h, id, c_GROUP2))
        endif
        set n=CreateUnit(GetOwningPlayer(caster), 'dR88', caster_x, caster_y, angle*bj_RADTODEG+90)
        call SetUnitFlyHeight(n, 600, 0)
        call SetUnitTimeScale(n, 0.65)
        call SetUnitScale(n, 0.8, 0.8, 0.8)
        call MyRemoveUnit(n, 1.5)
        call SetUnitTimeScale(caster, 1)
        call SetUnitFlyHeight(caster, 0, 0)
        call DestroyEffect(LoadEffectHandle(h, id, 30))
        call DestroyEffect(LoadEffectHandle(h, id, 31))
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
        set caster=null
        set target=null
endfunction

function RengokuE_QE takes unit newCaster,unit newTarget,real newAngle,real newDmg,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local integer id_caster= GetHandleId(newCaster)
    if GetUnitAbilityLevel(newCaster, 'ReFP') >= 1 or LoadBoolean(HH, id_caster, RengokuF_Pass) == true then
        call SaveBoolean(h, id, 20, true)
        call SaveGroupHandle(h, id, c_GROUP1, CreateGroup())
        call SaveGroupHandle(h, id, c_GROUP2, CreateGroup())
    else
        call SaveBoolean(h, id, 20, false)
    endif
    call PauseUnit(newTarget,true)
    call SetUnitInvulnerable(newTarget, true)
    call PauseUnit(newCaster,true)
    call SetUnitInvulnerable(newCaster, true)
    call SetUnitTimeScale(newCaster, 1.5)
    call UnitAddAbility(newCaster, 'Arav')
    call UnitRemoveAbility(newCaster, 'Arav')
    call UnitAddAbility(newTarget, 'Arav')
    call UnitRemoveAbility(newTarget, 'Arav')
    call RengokuE_Shifting(newCaster , newTarget , newAngle , 450 , CreateTimer())
    call SaveEffectHandle(h, id, 30, AddSpecialEffectTarget("fireglow.mdl", newCaster, "hand right"))
    call SaveEffectHandle(h, id, 31, AddSpecialEffectTarget("fireglow.mdl", newCaster, "hand left"))
    call SaveUnitHandle(h, id, c_CASTER, newCaster)
    call SaveUnitHandle(h, id, c_TARGET, newTarget)
    call SaveReal(h, id, c_ANGLE, newAngle)
    call SaveReal(h, id, 29, newAngle)
    call SaveReal(h, id, c_DAMAGE, newDmg)
    call TimerStart(newTimer, 0.02, true, function RengokuE_QE_Periodic)
endfunction


function RengokuE_WE_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local unit caster = LoadUnitHandle(h, id, c_CASTER) 
    local unit target = LoadUnitHandle(h, id, c_TARGET)
    local real caster_x= GetUnitX(caster)
    local real caster_y= GetUnitY(caster)
    local real target_x= GetUnitX(target)
    local real target_y= GetUnitY(target)
    local real angle= LoadReal(h, id, c_ANGLE)
    local real time= LoadReal(h, id, c_TIME)
    local integer eff_period= LoadInteger(h, id, c_EFFPERIOD)
    local boolean AOEbool= LoadBoolean(h, id, 20)
    if time < 2.75 then
        call SaveReal(h, id, c_TIME, time + 0.02)
        call PauseUnit(target,true)
        call SetUnitInvulnerable(target, true)
        call PauseUnit(caster,true)
        call SetUnitInvulnerable(caster, true)
        if time == 0.7 then
            set soundplay=SndN(3253) // Sound\war3mapImported\RengokuE33.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            set n=CreateUnit(GetOwningPlayer(caster), 'dR39', caster_x, caster_y, angle*bj_RADTODEG+90)
            call SetUnitScale(n, 1.5, 1.5, 1.5)
            call SetUnitFlyHeight(n, 100, 0)
            call MyRemoveUnit(n, 1.5)
            set n=CreateUnit(GetOwningPlayer(caster), 'dR42', caster_x, caster_y, angle*bj_RADTODEG)
            call SetUnitFlyHeight(n, 60, 0)
            call SetUnitTimeScale(n, 0.7)
            call MyRemoveUnit(n, 1.5)
            set n=CreateUnit(GetOwningPlayer(caster), 'dR88', caster_x, caster_y, angle*bj_RADTODEG+90)
            call SetUnitTimeScale(n, 0.85)
            call SetUnitScale(n, 0.8, 0.8, 0.8)
            call MyRemoveUnit(n, 1.5)
            set n=CreateUnit(GetOwningPlayer(caster), 'dR27', caster_x, caster_y, angle*bj_RADTODEG)
            call SetUnitScale(n, 0.45, 0.45, 0.45)
            call SetUnitVertexColor(n, 255, 255, 255, 90)
            call MyRemoveUnit(n, 1.5)
        endif
        if time == 0.8 then
            call ShakeCamera(0.3 , 10)
            call RengokuE_Shifting(caster , target , angle , 300 , CreateTimer())
            call SetUnitX(caster, target_x - 100 * Cos(angle))
            call SetUnitY(caster, target_y - 100 * Sin(angle))
            set caster_x=GetUnitX(caster)
            set caster_y=GetUnitY(caster)
        endif
        if time > 0.8 then
            if LoadBoolean(h, id, 28)==false then
                set angle = LoadReal(h, id, 33)
                if LoadInteger(h, id, 34)==0 then
                    set angle = GetRandomInt(0, 360)*bj_DEGTORAD
                    call SaveReal(h, id, 33, angle)
                    call SaveInteger(h, id, 34, 16)
                else
                    call SaveInteger(h, id, 34, LoadInteger(h, id, 34)-1)
                endif
            endif
            //call RengokuE_Shifting(caster , target , angle , 100 , CreateTimer())
            call SetUnitX(target, target_x + 6 * Cos(angle))
            call SetUnitY(target, target_y + 6 * Sin(angle))
            call SetUnitX(caster, target_x - 100 * Cos(angle))
            call SetUnitY(caster, target_y - 100 * Sin(angle))
            if AOEbool == true then
                set bjLCG=LoadGroupHandle(h, id, c_GROUP1)
                call GroupEnumUnitsInRange(bjLCG, target_x, target_y, 400, Base)
                loop
                set bjLCU=FirstOfGroup(bjLCG)
                exitwhen bjLCU == null
                    if Condition_Base(GetOwningPlayer(caster) , bjLCU) and bjLCU != target then
                        call IssueImmediateOrder(bjLCU, "stop")
                        call SetControlToUnit(caster , bjLCU , 0.1 , "stun")
                        call SetUnitX(bjLCU, GetUnitX(bjLCU) + 7.5 * Cos(angle))
                        call SetUnitY(bjLCU, GetUnitY(bjLCU) + 7.5 * Sin(angle))
                        if eff_period == 0 then
                            set n=CreateUnit(GetOwningPlayer(caster), 'dH12', GetUnitX(bjLCU), GetUnitY(bjLCU), GetRandomInt(0, 360))
                            call SetUnitFlyHeight(n, GetUnitFlyHeight(bjLCU)+GetRandomInt(60,100), 0)
                            call SetUnitScale(n, 0.5, 0.5, 0.5)
                            call MyRemoveUnit(n, 0.5)
                        endif
                    endif
                    call GroupRemoveUnit(bjLCG, bjLCU)
                endloop
            endif
            if eff_period == 0 then
                if LoadBoolean(h, id, 27) == false then
                    call SetUnitAnimationByIndex(caster, 3)
                    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR62', caster_x + 50 * Cos(angle), caster_y + 50 * Sin(angle), angle * bj_RADTODEG)
                    call SetUnitScale(bjLCU, 2.3, 2.3, 2.3)
                    call SetUnitTimeScale(bjLCU, 0.7)
                    call SetUnitFlyHeight(bjLCU, 150, 0)
                    call MyRemoveUnit(bjLCU , 2)
                    
                    set n=CreateUnit(GetOwningPlayer(caster), 'dH32', target_x + 50 * Cos(angle), target_y + 50 * Sin(angle),  angle * bj_RADTODEG + GetRandomInt(- 15, 15))
                    call SetUnitFlyHeight(n, GetRandomInt(80, 100), 0)
                    call SetUnitScale(n, 4, 4, 4)
                    call MyRemoveUnit(n, 1.5)
                    
                    set bjLCU = CreateUnit(GetOwningPlayer(caster), 'dR10', caster_x, caster_y, angle * bj_RADTODEG)
                    call SetUnitVertexColor(bjLCU, 255, 255, 255, 60)
                    call SetUnitTimeScale(bjLCU, 2)
                    call SetUnitAnimationByIndex(bjLCU, 3)
                    call MyRemoveUnit(bjLCU, 0.18)
                    
                    set n=CreateUnit(GetOwningPlayer(caster), 'dH12', target_x, target_y, angle * bj_RADTODEG - GetRandomReal(25, 45))
                    call SetUnitFlyHeight(n, 70, 0)
                    call SetUnitScale(n, 1.25, 1.25, 1.25)
                    call MyRemoveUnit(n, 1)
                                        
                    call SaveBoolean(h, id, 27, true)
                else
                    call SetUnitAnimationByIndex(caster, 9)
                    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR63', caster_x + 50 * Cos(angle), caster_y + 50 * Sin(angle), angle * bj_RADTODEG)
                    call SetUnitScale(bjLCU, 2.3, 2.3, 2.3)
                    call SetUnitTimeScale(bjLCU, 0.7)
                    call SetUnitFlyHeight(bjLCU, 150, 0)
                    call MyRemoveUnit(bjLCU , 2)
                    
                    set n=CreateUnit(GetOwningPlayer(caster), 'dH32', target_x + 50 * Cos(angle), target_y + 50 * Sin(angle), angle * bj_RADTODEG + GetRandomInt(- 15, 15))
                    call SetUnitFlyHeight(n, GetRandomInt(80, 100), 0)
                    call SetUnitScale(n, 4, 4, 4)
                    call MyRemoveUnit(n, 1.5)
                    
                    set bjLCU = CreateUnit(GetOwningPlayer(caster), 'dR10', caster_x, caster_y, angle * bj_RADTODEG)
                    call SetUnitVertexColor(bjLCU, 255, 255, 255, 60)
                    call SetUnitTimeScale(bjLCU, 2)
                    call SetUnitAnimationByIndex(bjLCU, 9)
                    call MyRemoveUnit(bjLCU, 0.18)
                    
                    set n=CreateUnit(GetOwningPlayer(caster), 'dH12', target_x, target_y, angle * bj_RADTODEG + GetRandomReal(25, 45))
                    call SetUnitFlyHeight(n, 70, 0)
                    call SetUnitScale(n, 1.25, 1.25, 1.25)
                    call MyRemoveUnit(n, 1)
                    call SaveBoolean(h, id, 27, false)
                endif
                call SaveInteger(h, id, c_EFFPERIOD, 7)
                if GetRandomInt(0, 3) == 0 then
                    call SetUnitAnimationByIndex(caster, 7)
                endif
            else
                call SaveInteger(h, id, c_EFFPERIOD, eff_period - 1)
            endif
        endif
    else
        call PauseUnit(target,false)
        call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
        call SetUnitInvulnerable(target, false)
        if AOEbool == false then
            call myCustomDamage(caster , target , LoadReal(h, id, c_DAMAGE) , false , false , null , null , null)
            call SlowUnit(caster,target,0.5,0.5,3,0,false)
            call RengokuE_Shifting(caster , target , angle , 900 , CreateTimer())
        else
            set bjLCG=LoadGroupHandle(h, id, c_GROUP1)
            call GroupEnumUnitsInRange(bjLCG, target_x, target_y, 400, Base)
            loop
            set bjLCU=FirstOfGroup(bjLCG)
            exitwhen bjLCU == null
                if Condition_Base(GetOwningPlayer(caster) , bjLCU) then
                    call myCustomDamage(caster , bjLCU , LoadReal(h, id, c_DAMAGE) , false , false , null , null , null)
                    call SetControlToUnit(caster , target , 0.25 , "stun")
                    call SlowUnit(caster,bjLCU,0.5,0.5,3,0,false)
                    call RengokuE_Shifting(caster , bjLCU , angle , 900 , CreateTimer())
                endif
                call GroupRemoveUnit(bjLCG, bjLCU)
            endloop
            call DestroyGroup(bjLCG)
        endif
        call ShakeCamera(0.3 , 20)
                
                set n=CreateUnit(GetOwningPlayer(caster), 'dR42', caster_x, caster_y, angle * bj_RADTODEG)
                call SetUnitFlyHeight(n, 60, 0)
                call SetUnitTimeScale(n, 0.7)
                call MyRemoveUnit(n, 1)
                
        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR64', caster_x + 50 * Cos(angle), caster_y + 50 * Sin(angle), angle * bj_RADTODEG)
        call SetUnitFlyHeight(bjLCU, 160, 0)
        call SetUnitScale(bjLCU, 1.7, 1.7, 1.7)
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH33', caster_x + 100 * Cos(angle), caster_y + 100 * Sin(angle), angle * bj_RADTODEG)
        call SetUnitFlyHeight(bjLCU, 160, 0)
        call SetUnitScale(bjLCU, 1.3, 1.3, 1.3)
        call MyRemoveUnit(bjLCU , 1.5)
                
                set n=CreateUnit(GetOwningPlayer(caster), 'dR13', caster_x, caster_y, angle * bj_RADTODEG)
                call SetUnitFlyHeight(n, 50, 0)
                call SetUnitScale(n, 0.95, 0.95, 0.95)
                call MyRemoveUnit(n, 1)
                set n=CreateUnit(GetOwningPlayer(caster), 'dH01', caster_x, caster_y, angle * bj_RADTODEG)
                call SetUnitFlyHeight(n, 100, 0)
                call SetUnitScale(n, 2, 2, 2)
                call MyRemoveUnit(n, 1)
                
        call SetUnitTimeScale(caster, 1)
        call SetUnitFlyHeight(caster, 0, 0)
        call DestroyEffect(LoadEffectHandle(h, id, 30))
        call DestroyEffect(LoadEffectHandle(h, id, 31))
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
        set caster=null
        set target=null
endfunction

function RengokuE_WE takes unit newCaster,unit newTarget,real newAngle,real newDmg,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local integer id_caster= GetHandleId(newCaster)
    call SetUnitTimeScale(newCaster, 1.5)
    call RengokuE_Shifting(newCaster , newTarget , newAngle , 400 , CreateTimer())
    if GetUnitAbilityLevel(newCaster, 'ReFP') >= 1 or LoadBoolean(HH, id_caster, RengokuF_Pass) == true then
        call SaveBoolean(h, id, 20, true)
        call SaveGroupHandle(h, id, c_GROUP1, CreateGroup())
    else
        call SaveBoolean(h, id, 20, false)
    endif
    call PauseUnit(newTarget,true)
    call SetUnitInvulnerable(newTarget, true)
    call PauseUnit(newCaster,true)
    call SetUnitInvulnerable(newCaster, true)
    call SaveEffectHandle(h, id, 30, AddSpecialEffectTarget("fireglow.mdl", newCaster, "hand right"))
    call SaveEffectHandle(h, id, 31, AddSpecialEffectTarget("fireglow.mdl", newCaster, "hand left"))
    call SaveUnitHandle(h, id, c_CASTER, newCaster)
    call SaveUnitHandle(h, id, c_TARGET, newTarget)
    call SaveReal(h, id, c_ANGLE, newAngle)
    call SaveReal(h, id, 29, newAngle)
    call SaveReal(h, id, c_DAMAGE, newDmg)
        call SaveBoolean(h, id, 28, LoadBoolean(HH, id_caster, RengokuF_Pass))
    call TimerStart(newTimer, 0.02, true, function RengokuE_WE_Periodic)
endfunction

function RengokuE_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local unit caster  = LoadUnitHandle(h, id, c_CASTER)
    local unit target  = LoadUnitHandle(h, id, c_TARGET)
    local real caster_x= GetUnitX(caster)
    local real caster_y= GetUnitY(caster)
    local real target_x= GetUnitX(target)
    local real target_y= GetUnitY(target)
    local real angle= AP(caster_x , caster_y , target_x , target_y)
    local real time= LoadReal(h, id, c_TIME)
    local real force_speed= LoadReal(h, id, 22)
    local integer act_spell= LoadInteger(h, id, c_ACT)
    local integer eff_period= LoadInteger(h, id, c_EFFPERIOD)
    local boolean AOE_bool= LoadBoolean(h, id, 20)
    if act_spell < 3 then
        if act_spell <= 1 then
            if SRS(caster_x , caster_y , target_x , target_y) > 150 then
                call SetUnitX(caster, caster_x + 75 * Cos(angle))
                call SetUnitY(caster, caster_y + 75 * Sin(angle))
                if eff_period == 0 then
                    // set bjLCE=AddSpecialEffect("Rengoku_ExD.mdl", caster_x, caster_y)
                    // call SetSpecialEffectTimeScale(bjLCE , 1.5)
                    // call SetSpecialEffectAnimationByIndex(bjLCE , 7)
                    // call SetSpecialEffectAlpha(bjLCE , 60)
                    // call SetSpecialEffectFacing(bjLCE , angle * bj_RADTODEG)
                    // call RemoveEffect(bjLCE , 0.15 , false , CreateTimer())
                    set bjLCU = CreateUnit(GetOwningPlayer(caster), 'dR10', caster_x, caster_y, angle * bj_RADTODEG)
                    call SetUnitVertexColor(bjLCU, 255, 255, 255, 60)
                    call SetUnitTimeScale(bjLCU, 1.5)
                    call SetUnitAnimationByIndex(bjLCU, 7)
                    call MyRemoveUnit(bjLCU, 0.15)
                    call SaveInteger(h, id, c_EFFPERIOD, 1)
                else
                    call SaveInteger(h, id, c_EFFPERIOD, eff_period - 1)
                endif
            else
                if LoadBoolean(HH,GetHandleId(target),ANTITARGET_ABILITY)==false then
                    call PauseUnit(target,true)
                    call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
                    call SetUnitInvulnerable(target, true)
                    call SaveInteger(h, id, c_ACT, 2)
                    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR62', caster_x, caster_y, angle * bj_RADTODEG)
                    call SetUnitScale(bjLCU, 2.3, 2.3, 2.3)
                    call SetUnitFlyHeight(bjLCU, 180, 0)
                    call SetUnitTimeScale(bjLCU, 0.7)
                    call MyRemoveUnit(bjLCU , 2)
                    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR62', caster_x, caster_y, angle * bj_RADTODEG)
                    call SetUnitScale(bjLCU, 1.8, 1.8, 1.8)
                    call SetUnitFlyHeight(bjLCU, 180, 0)
                    call SetUnitTimeScale(bjLCU, 0.7)
                    call MyRemoveUnit(bjLCU , 2)
                    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH01', target_x, target_y, angle * bj_RADTODEG)
                    call SetUnitFlyHeight(bjLCU, 100, 0)
                    call MyRemoveUnit(bjLCU , 1.5)
                    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR13', target_x, target_y, angle * bj_RADTODEG)
                    call SetUnitFlyHeight(bjLCU, 50, 0)
                    call SetUnitScale(bjLCU, 0.7, 0.7, 0.7)
                    call MyRemoveUnit(bjLCU, 1.5)
                                    
                    call RengokuE_Shifting(caster , target , angle , 350 , CreateTimer())
                else
                    call PauseUnit(caster,false)
                    call SaveUnitHandle(HH,GetHandleId(target),REVERSE_TARGET,caster)
                    call SetUnitInvulnerable(caster,false)
                    call FlushChildHashtable(h,id)
                    call DestroyTimer(GetExpiredTimer())
                endif
            endif
        else // act 2
            if time <= 1.3 then
                call SetUnitX(caster, target_x - 130 * Cos(angle))
                call SetUnitY(caster, target_y - 130 * Sin(angle))
                call SaveReal(h, id, 22, force_speed + 0.04)
                if time == 0.3 or time == 0.8 then
                    call SetUnitAnimationByIndex(caster, 3)
                    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR63', caster_x, caster_y, angle * bj_RADTODEG)
                    call SetUnitScale(bjLCU, 2, 2, 2)
                    call SetUnitTimeScale(bjLCU, 0.65)
                    call SetUnitFlyHeight(bjLCU, 150, 0)
                    call MyRemoveUnit(bjLCU , 2)
                                                // set bjLCE=AddSpecialEffect("zhendi-qiquan-boom.mdl", target_x, target_y)
                                                // call SetSpecialEffectScale(bjLCE , 1)
                                                // call SetSpecialEffectZ(bjLCE , 100)
                                                // call DestroyEffect(bjLCE)
                    
                                        // set bjLCU = CreateUnit(GetOwningPlayer(caster), 'dR10', caster_x, caster_y, angle * bj_RADTODEG)
                                        // call SetUnitVertexColor(bjLCU, 255, 255, 255, 60)
                                        // call SetUnitAnimationByIndex(bjLCU, 3)
                                        // call MyRemoveUnit(bjLCU, 0.15)
                    call RengokuE_Shifting(caster , target , angle , 80 , CreateTimer())
                elseif time == 0.5 or time == 1.0 then
                    call SetUnitAnimationByIndex(caster, 8)
                    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR62', caster_x, caster_y, angle * bj_RADTODEG)
                    call SetUnitScale(bjLCU, 2, 2, 0.1)
                    call SetUnitTimeScale(bjLCU, 0.65)
                    call SetUnitFlyHeight(bjLCU, 150, 0)
                    call MyRemoveUnit(bjLCU , 2)
                    
                    set bjLCU = CreateUnit(GetOwningPlayer(caster), 'dR10', caster_x, caster_y, angle * bj_RADTODEG)
                    call SetUnitVertexColor(bjLCU, 255, 255, 255, 60)
                    call SetUnitAnimationByIndex(bjLCU, 8)
                    call MyRemoveUnit(bjLCU, 0.15)
                    call RengokuE_Shifting(caster , target , angle , 110 , CreateTimer())
                endif
                if time == 1.3 then
                    call SetUnitAnimationByIndex(caster, 7)
                    call SetUnitTimeScale(caster, 2)
                    set bjLCU = CreateUnit(GetOwningPlayer(caster), 'dR42', caster_x, caster_y, angle * bj_RADTODEG)
                    call SetUnitFlyHeight(bjLCU, 60, 0)
                    call SetUnitTimeScale(bjLCU, 0.7)
                    call MyRemoveUnit(bjLCU, 1.5)
                    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR64', caster_x + 50 * Cos(angle), caster_y + 50 * Sin(angle), angle * bj_RADTODEG)
                    call SetUnitFlyHeight(bjLCU, 160, 0)
                    call SetUnitScale(bjLCU, 1.2, 1.2, 1.2)
                    call MyRemoveUnit(bjLCU , 1.5)
                endif
            else
                if LoadStr(h, id, 23) == "Q" then
                    set soundplay=SndN(3256) // Sound\war3mapImported\RengokuE1_2.mp3
                    call StartSound(soundplay)
                    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                    call RengokuE_QE(caster , target , angle , LoadReal(h, id, c_DAMAGE) , CreateTimer())
                    call SaveInteger(h, id, c_ACT, 3)
                elseif LoadStr(h, id, 23) == "W" then
                    call RengokuE_WE(caster , target , angle , LoadReal(h, id, c_DAMAGE) , CreateTimer())
                    call SaveInteger(h, id, c_ACT, 3)
                else
                    if time == 1.32 then
                        set soundplay=SndN(3256) // Sound\war3mapImported\RengokuE1_2.mp3
                        call StartSound(soundplay)
                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                    endif
                    if time <= 2.2 then
                        call SetUnitX(target, target_x + ( 3 + force_speed ) * Cos(angle))
                        call SetUnitY(target, target_y + ( 3 + force_speed ) * Sin(angle))
                        call SetUnitX(caster, target_x - 100 * Cos(angle))
                        call SetUnitY(caster, target_y - 100 * Sin(angle))
                        if AOE_bool == true then
                            set bjLCG=LoadGroupHandle(h, id, c_GROUP1)
                            call GroupEnumUnitsInRange(bjLCG, target_x, target_y, 250, Base)
                            loop
                            set bjLCU=FirstOfGroup(bjLCG)
                            exitwhen bjLCU == null
                                if Condition_Base(GetOwningPlayer(caster) , bjLCU) and bjLCU != target then
                                    call IssueImmediateOrder(bjLCU, "stop")
                                    call SetControlToUnit(caster , bjLCU , 0.1 , "stun")
                                    call SetUnitX(bjLCU, GetUnitX(bjLCU) + ( 3.3 + force_speed ) * Cos(angle))
                                    call SetUnitY(bjLCU, GetUnitY(bjLCU) + ( 3.3 + force_speed ) * Sin(angle))
                                endif
                                call GroupRemoveUnit(bjLCG, bjLCU)
                            endloop
                        endif
                        if GetRandomInt(0, 7) == 0 then
                            call RengokuE_Shifting(caster , target , angle , 10 , CreateTimer())
                        endif
                        if eff_period == 0 then
                            if LoadBoolean(h, id, 27) == false then
                                call SetUnitAnimationByIndex(caster, 3)
                                set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR62', caster_x + 50 * Cos(angle), caster_y + 50 * Sin(angle), angle * bj_RADTODEG)
                                call SetUnitScale(bjLCU, 1.3, 1.3, 1.3)
                                call SetUnitTimeScale(bjLCU, 1.3)
                                call SetUnitFlyHeight(bjLCU, 150, 0)
                                call MyRemoveUnit(bjLCU , 2)
                                set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH32', target_x, target_y, angle * bj_RADTODEG + GetRandomInt(- 15, 15))
                                call SetUnitScale(bjLCU, 2.5, 2.5, 2.5)
                                call SetUnitFlyHeight(bjLCU, GetRandomInt(80, 100), 0)
                                call MyRemoveUnit(bjLCU , 2)
                                                                
                                set bjLCU = CreateUnit(GetOwningPlayer(caster), 'dR10', caster_x, caster_y, angle * bj_RADTODEG)
                                call SetUnitVertexColor(bjLCU, 255, 255, 255, 60)
                                call SetUnitTimeScale(bjLCU, 2)
                                call SetUnitAnimationByIndex(bjLCU, 3)
                                call MyRemoveUnit(bjLCU, 0.18)
                                call SaveBoolean(h, id, 27, true)
                            else
                                call SetUnitAnimationByIndex(caster, 9)
                                set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR63', caster_x + 50 * Cos(angle), caster_y + 50 * Sin(angle), angle * bj_RADTODEG)
                                call SetUnitScale(bjLCU, 1.3, 1.3, 1.3)
                                call SetUnitTimeScale(bjLCU, 1.3)
                                call SetUnitFlyHeight(bjLCU, 150, 0)
                                call MyRemoveUnit(bjLCU , 2)
                                set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH32', target_x, target_y, angle * bj_RADTODEG + GetRandomInt(- 15, 15))
                                call SetUnitScale(bjLCU, 2.5, 2.5, 2.5)
                                call SetUnitFlyHeight(bjLCU, GetRandomInt(80, 100), 0)
                                call MyRemoveUnit(bjLCU , 2)
                                set bjLCU = CreateUnit(GetOwningPlayer(caster), 'dR10', caster_x, caster_y, angle * bj_RADTODEG)
                                call SetUnitVertexColor(bjLCU, 255, 255, 255, 60)
                                call SetUnitTimeScale(bjLCU, 2)
                                call SetUnitAnimationByIndex(bjLCU, 9)
                                call MyRemoveUnit(bjLCU, 0.18)
                                call SaveBoolean(h, id, 27, false)
                            endif
                            call SaveInteger(h, id, c_EFFPERIOD, 4)
                            if GetRandomInt(0, 3) == 0 then
                                call SetUnitAnimationByIndex(caster, 7)
                            endif
                        else
                            call SaveInteger(h, id, c_EFFPERIOD, eff_period - 1)
                        endif
                    else
                        call PauseUnit(target,false)
                        call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
                        call SetUnitInvulnerable(target, false)
                        if AOE_bool == true then
                            set bjLCG=LoadGroupHandle(h, id, c_GROUP1)
                            call GroupEnumUnitsInRange(bjLCG, target_x, target_y, 250, Base)
                            loop
                            set bjLCU=FirstOfGroup(bjLCG)
                            exitwhen bjLCU == null
                                if Condition_Base(GetOwningPlayer(caster) , bjLCU) then
                                    call RengokuE_Shifting(caster , bjLCU , angle , 350 , CreateTimer())
                                    call myCustomDamage(caster , bjLCU , LoadReal(h, id, c_DAMAGE) , false , false , null , null , null)
                                    call SetControlToUnit(caster , bjLCU , 0.25 , "stun")
                                endif
                                call GroupRemoveUnit(bjLCG, bjLCU)
                            endloop
                        else
                            call RengokuE_Shifting(caster , target , angle , 350 , CreateTimer())
                            call myCustomDamage(caster , target , LoadReal(h, id, c_DAMAGE) , false , false , null , null , null)
                            call SetControlToUnit(caster , target , 0.25 , "stun")
                        endif
                        call SetUnitTimeScale(caster, 1)
                        call PauseUnit(caster, false)
                        call SetUnitInvulnerable(caster, false)
                        call SaveInteger(h, id, c_ACT, 3)
                                                
                        set bjLCU = CreateUnit(GetOwningPlayer(caster), 'dR42', caster_x, caster_y, angle * bj_RADTODEG)
                        call SetUnitFlyHeight(bjLCU, 60, 0)
                        call SetUnitTimeScale(bjLCU, 0.7)
                        call MyRemoveUnit(bjLCU, 1.5)
                                        
                        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR64', caster_x + 50 * Cos(angle), caster_y + 50 * Sin(angle), angle * bj_RADTODEG)
                        call SetUnitFlyHeight(bjLCU, 160, 0)
                        call SetUnitScale(bjLCU, 1.2, 1.2, 1.2)
                        call MyRemoveUnit(bjLCU , 1.5)
                        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH33', caster_x + 100 * Cos(angle), caster_y + 100 * Sin(angle), angle * bj_RADTODEG)
                        call SetUnitFlyHeight(bjLCU, 160, 0)
                        call SetUnitScale(bjLCU, 0.8, 0.8, 0.8)
                        call MyRemoveUnit(bjLCU , 1.5)
                                                
                                                
                        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR13', target_x, target_y, angle * bj_RADTODEG)
                        call SetUnitFlyHeight(bjLCU, 50, 0)
                        call SetUnitScale(bjLCU, 0.85, 0.85, 0.85)
                        call MyRemoveUnit(bjLCU , 1.5)
                        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR11', target_x, target_y, angle * bj_RADTODEG)
                        call SetUnitFlyHeight(bjLCU, 50, 0)
                        call SetUnitScale(bjLCU, 0.85, 0.85, 0.85)
                        call MyRemoveUnit(bjLCU , 1.5)
                    endif
                endif
                
            endif
            call SaveReal(h, id, c_TIME, time + 0.02)
        endif
    else
        if AOE_bool == true then
            call DestroyGroup(LoadGroupHandle(h, id, c_GROUP1))
        endif
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
    set target=null
endfunction

function RengokuE_Cast takes unit newCaster,unit newTarget,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local integer id_caster= GetHandleId(newCaster)
    local real caster_x= GetUnitX(newCaster)
    local real caster_y= GetUnitY(newCaster)
    local real angle= AP(caster_x , caster_y , GetUnitX(newTarget) , GetUnitY(newTarget))
    local real full_damage= ( 2 + GetUnitAbilityLevel(newCaster, 'RenE') ) * GetHeroAgi(newCaster, true)
    local boolean RengokuD_Buff= RengokuD_Cast(newCaster)
    local string RengokuQWE_Comb= RengokuQWE_Combination(newCaster , "E")
    if GetUnitAbilityLevel(newCaster, 'ReFP') >= 1 or LoadBoolean(HH, id_caster, RengokuF_Pass) == true then
        set full_damage=full_damage + GetHeroAgi(newCaster, true)
        call SaveBoolean(h, id, 20, true)
        call SaveGroupHandle(h, id, c_GROUP1, CreateGroup())
    else
        call SaveBoolean(h, id, 20, false)
    endif
    if RengokuD_Buff == true then
        set full_damage=full_damage * 1.15
    endif
    if RengokuQWE_Comb == "W" then
        set soundplay=SndN(3259) // Sound\war3mapImported\RengokuE1.mp3
        //set soundplay=CreateSound("Sound\\war3mapImported\\RengokuE_QE2.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    else
        set soundplay=SndN(3259) // Sound\war3mapImported\RengokuE1.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    endif
    set soundplay=SndN(3261) // Sound\war3mapImported\Rengoku_Dash1.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR42', caster_x, caster_y, angle * bj_RADTODEG)
    call SetUnitTimeScale(bjLCU, 0.7)
    call SetUnitFlyHeight(bjLCU, 60, 0)
    call MyRemoveUnit(bjLCU, 1.5)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR88', caster_x, caster_y, angle * bj_RADTODEG + 90)
    call SetUnitTimeScale(bjLCU, 0.65)
    call SetUnitScale(bjLCU, 0.8, 0.8, 0.8)
    call MyRemoveUnit(bjLCU, 1.5)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR27', caster_x, caster_y, angle * bj_RADTODEG + 90)
    call SetUnitVertexColor(bjLCU, 255, 255, 255, 110)
    call SetUnitScale(bjLCU, 0.35, 0.35, 0.35)
    call MyRemoveUnit(bjLCU, 1.5)
        
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR64', caster_x + 50 * Cos(angle), caster_y + 50 * Sin(angle), angle * bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 160, 0)
    call SetUnitScale(bjLCU, 1.2, 1.2, 1.2)
    call MyRemoveUnit(bjLCU , 1.5)
    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, 7)
    call SetUnitTimeScale(newCaster, 1.2)
    call SaveUnitHandle(h, id, c_CASTER, newCaster)
    call SaveUnitHandle(h, id, c_TARGET, newTarget)
    call SaveReal(h, id, c_DAMAGE, full_damage)
    call SaveReal(h, id, 22, 0.0)
    call SaveInteger(h, id, c_ACT, 1)
    call SaveReal(h, id, c_TIME, 0.0)
    call SaveStr(h, id, 23, RengokuQWE_Comb)
    call TimerStart(newTimer, 0.02, true, function RengokuE_Periodic)
endfunction

function RengokuE_Shield_Periodic takes nothing returns nothing
        local integer id= GetHandleId(GetExpiredTimer())
        local integer act= LoadInteger(h, id, c_ACT)
        local unit caster= LoadUnitHandle(h, id, c_CASTER)
        local unit target= LoadUnitHandle(h, id, c_TARGET)
        local real caster_x= GetUnitX(caster)
        local real caster_y= GetUnitY(caster)
        local real target_x= GetUnitX(target)
        local real target_y= GetUnitY(target)
        local real angle= AU(caster, target)
        local real time= LoadReal(h, id, c_TIME)
        local integer eff_period= LoadInteger(h, id, c_EFFPERIOD)
        if act <= 2 then
            if act == 1 then
                if SquareRootUnit(caster , target) > 60 then
                    call SetUnitX(caster, caster_x + 70 * Cos(angle))
                    call SetUnitY(caster, caster_y + 70 * Sin(angle))
                    call SetUnitFacingInstant(caster , angle * bj_RADTODEG)
                    if eff_period == 0 then
                        if LoadInteger(h, id, 17) == 0 then
                            set n=CreateUnit(GetOwningPlayer(caster), 'dR64', caster_x + 50 * Cos(angle), caster_y + 50 * Sin(angle), angle * bj_RADTODEG)
                            call SetUnitFlyHeight(n, 160, 0)
                            call SetUnitScale(n, 0.6, 0.6, 0.6)
                            call SetUnitVertexColor(n, 255, 255, 255, 140)
                            call MyRemoveUnit(n , 1.5)
                            call SaveInteger(h, id, 17, 3)
                        else
                            call SaveInteger(h, id, 17, LoadInteger(h, id, 17) - 1)
                        endif
                        set bjLCU = CreateUnit(GetOwningPlayer(caster), 'dR10', caster_x + 35 * Cos(angle), caster_y + 35 * Sin(angle), angle * bj_RADTODEG)
                        call SetUnitVertexColor(bjLCU, 255, 255, 255, 80)
                        call SetUnitAnimationByIndex(bjLCU, 7)
                        call MyRemoveUnit(bjLCU, 0.1)
                        call SaveInteger(h, id, c_EFFPERIOD, 2)
                    else
                        call SaveInteger(h, id, c_EFFPERIOD, eff_period - 1)
                    endif
                else
                    call SaveInteger(h, id, c_ACT, 2)
                    call SetUnitAnimationByIndex(caster, 6)
                    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR21', target_x, target_y, GetRandomInt(0, 360))
                    call SetUnitScale(bjLCU, 2, 2, 2)
                    call SaveUnitHandle(h, id, c_DUMMY1, bjLCU)
                    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR21', target_x, target_y, GetRandomInt(0, 360))
                    call SetUnitScale(bjLCU, 1.8, 1.8, 1.8)
                    call SaveUnitHandle(h, id, c_DUMMY2, bjLCU)
                    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR15', caster_x, caster_y, GetRandomInt(0, 360))
                    call SetUnitScale(bjLCU, 1.55, 1.55, 1.55)
                    call SetUnitFlyHeight(bjLCU, 15, 0)
                    call SaveUnitHandle(h, id, c_DUMMY3, bjLCU)
                    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR15', caster_x, caster_y, GetRandomInt(0, 360))
                    call SetUnitScale(bjLCU, 0.85, 0.85, 0.85)
                    call SetUnitFlyHeight(bjLCU, 15, 0)
                    call SaveUnitHandle(h, id, c_DUMMY4, bjLCU)
                    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR20', caster_x, caster_y, GetRandomInt(0, 360))
                    call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
                    call SetUnitVertexColor(bjLCU, 255, 255, 255, 100)
                    call SetUnitTimeScale(bjLCU, 0.9)
                    call SaveUnitHandle(h, id, c_DUMMY5, bjLCU)
                endif
            else
                if time < 2 then
                    set bjLCU=LoadUnitHandle(h, id, c_DUMMY1)
                    call SetUnitX(bjLCU, caster_x)
                    call SetUnitY(bjLCU, caster_y)
                    set bjLCU=LoadUnitHandle(h, id, c_DUMMY2)
                    call SetUnitX(bjLCU, caster_x)
                    call SetUnitY(bjLCU, caster_y)
                    set bjLCU=LoadUnitHandle(h, id, c_DUMMY3)
                    call SetUnitX(bjLCU, caster_x)
                    call SetUnitY(bjLCU, caster_y)
                    set bjLCU=LoadUnitHandle(h, id, c_DUMMY4)
                    call SetUnitX(bjLCU, caster_x)
                    call SetUnitY(bjLCU, caster_y)
                    set bjLCU=LoadUnitHandle(h, id, c_DUMMY5)
                    call SetUnitX(bjLCU, caster_x)
                    call SetUnitY(bjLCU, caster_y)
                    call SetUnitFacing(bjLCU , angle * bj_RADTODEG + time * 180)
                    set bjLCG=LoadGroupHandle(h, id, c_GROUP1)
                    call GroupEnumUnitsInRange(bjLCG, caster_x, caster_y, 30000, Base)
                    loop
                    set bjLCU=FirstOfGroup(bjLCG)
                    exitwhen bjLCU == null
                        if FilterA(bjLCU , caster) then
                            if SquareRootUnit(bjLCU , caster) <= 400 then
                                if LoadBoolean(h, GetHandleId(bjLCU), Shield_RengokuE) == false then
                                    call SaveEffectHandle(h, GetHandleId(bjLCU), SH_ShieldEff_RengokuE, AddSpecialEffectTarget("Soundwaveshield.mdx", bjLCU, "origin"))
                                    call GroupAddUnit(LoadGroupHandle(h, id, c_GROUP2), bjLCU)
                                    call SaveBoolean(h, GetHandleId(bjLCU), Shield_RengokuE, true)
                                endif
                            else
                                if LoadBoolean(h, GetHandleId(bjLCU), Shield_RengokuE) == true then
                                    call DestroyEffect(LoadEffectHandle(h, GetHandleId(bjLCU), SH_ShieldEff_RengokuE))
                                    call RemoveSavedHandle(h, GetHandleId(bjLCU), SH_ShieldEff_RengokuE)
                                    call GroupRemoveUnit(LoadGroupHandle(h, id, c_GROUP2), bjLCU)
                                    call SaveBoolean(h, GetHandleId(bjLCU), Shield_RengokuE, false)
                                    call RemoveSavedBoolean(h, GetHandleId(bjLCU), Shield_RengokuE)
                                endif
                            endif
                        else
                            if SquareRootUnit(bjLCU , caster) <= 400 then
                                set angle=AU(caster , bjLCU)
                                call SetUnitX(bjLCU, GetUnitX(caster) + 420 * Cos(angle))
                                call SetUnitY(bjLCU, GetUnitY(caster) + 420 * Sin(angle))
                            endif
                        endif
                        call GroupRemoveUnit(bjLCG, bjLCU)
                    endloop
                    if eff_period == 0 then
                        set n=CreateUnit(GetOwningPlayer(caster), 'dH16', caster_x, caster_y, GetRandomInt(0, 360))
                        call SetUnitScale(n, 3.15, 3.15, 3.15)
                        call SetUnitVertexColor(n, 255, 255, 255, 110)
                        call MyRemoveUnit(n, 1.5)
                        call SaveInteger(h, id, c_EFFPERIOD, 17)
                    else
                        call SaveInteger(h, id, c_EFFPERIOD, eff_period - 1)
                    endif
                    call SaveReal(h, id, c_TIME, time + 0.02)
                else
                    call SaveInteger(h, id, c_ACT, 3)
                    set bjLCG=LoadGroupHandle(h, id, c_GROUP2)
                    loop
                    set bjLCU=FirstOfGroup(bjLCG)
                    exitwhen bjLCU == null
                        if LoadBoolean(h, GetHandleId(bjLCU), Shield_RengokuE) == true then
                            call DestroyEffect(LoadEffectHandle(h, GetHandleId(bjLCU), SH_ShieldEff_RengokuE))
                            call SaveBoolean(h, GetHandleId(bjLCU), Shield_RengokuE, false)
                            call RemoveSavedHandle(h, GetHandleId(bjLCU), SH_ShieldEff_RengokuE)
                            call RemoveSavedBoolean(h, GetHandleId(bjLCU), Shield_RengokuE)
                        endif
                        call GroupRemoveUnit(bjLCG, bjLCU)
                    endloop
                endif
            endif
        else
            call PauseUnit(caster, false)
            call SetUnitInvulnerable(caster, false)
            call KillUnit(LoadUnitHandle(h, id, c_DUMMY1))
            call KillUnit(LoadUnitHandle(h, id, c_DUMMY2))
            call KillUnit(LoadUnitHandle(h, id, c_DUMMY3))
            call KillUnit(LoadUnitHandle(h, id, c_DUMMY4))
            call KillUnit(LoadUnitHandle(h, id, c_DUMMY5))
            call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY1) , 1.5)
            call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY2) , 1.5)
            call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY3) , 1.5)
            call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY4) , 1.5)
            call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY5) , 1.5)
            call DestroyGroup(LoadGroupHandle(h, id, c_GROUP1))
            call DestroyGroup(LoadGroupHandle(h, id, c_GROUP2))
            call FlushChildHashtable(h, id)
            call DestroyTimer(GetExpiredTimer())
        endif
        set caster=null
        set target=null
endfunction

function RengokuE_Shield takes unit newCaster,unit newTarget,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local real caster_x= GetUnitX(newCaster)
    local real caster_y= GetUnitY(newCaster)
    local real angle= AU(newCaster , newTarget)
    local boolean RengokuD_Buff= RengokuD_Cast(newCaster)
    local string RengokuQWE_Comb= RengokuQWE_Combination(newCaster , "E")
    set soundplay=SndN(3263) // Sound\war3mapImported\RengokuE_2.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    if newCaster != newTarget then
                set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR42', caster_x, caster_y, angle * bj_RADTODEG)
        call SetUnitFlyHeight(bjLCU, 60, 0)
        call SetUnitScale(bjLCU, 0.7, 0.7, 0.7)
                call SetUnitTimeScale(bjLCU, 0.7)
        call MyRemoveUnit(bjLCU , 1.5)
        //currect 
                set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR64', caster_x + 50 * Cos(angle), caster_y + 50 * Sin(angle), angle * bj_RADTODEG)
        call SetUnitFlyHeight(bjLCU, 160, 0)
        call SetUnitScale(bjLCU, 1.2, 1.2, 1.2)
        call MyRemoveUnit(bjLCU , 1.5)
        call SaveInteger(h, id, c_EFFPERIOD, 5)
    endif
        call PauseUnit(newCaster, true)
        call SetUnitInvulnerable(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, 7)
        call SaveUnitHandle(h, id, c_CASTER, newCaster)
        call SaveUnitHandle(h, id, c_TARGET, newTarget)
    call SaveGroupHandle(h, id, c_GROUP1, CreateGroup())
    call SaveGroupHandle(h, id, c_GROUP2, CreateGroup())
        call SaveInteger(h, id, c_ACT, 1)
        call TimerStart(newTimer, 0.02, true, function RengokuE_Shield_Periodic)
endfunction


function Rengoku_Fear_Select takes nothing returns nothing
    local integer id= LoadInteger(h, GetHandleId(GetTriggeringTrigger()), 20)
    local real duration= LoadReal(h, id, c_DURATION)
    if duration > 0 then
        if GetLocalPlayer() == GetOwningPlayer(GetTriggerUnit()) then
            call ClearSelection()
        endif
    else
                call RemoveSavedReal(h, id, c_DURATION)
        call FlushChildHashtable(h, GetHandleId(GetTriggeringTrigger()))
                call TriggerClearActions(GetTriggeringTrigger())
        call DestroyTrigger(GetTriggeringTrigger())
    endif
endfunction

function RengokuR_Fear_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local real angle= LoadReal(h, id, c_ANGLE)
    local real target_x= GetUnitX(LoadUnitHandle(h, id, c_TARGET))
    local real target_y= GetUnitY(LoadUnitHandle(h, id, c_TARGET))
    local real target_z= GetUnitFlyHeight(LoadUnitHandle(h, id, c_TARGET))
    local real duration= LoadReal(h, id, c_DURATION)
    local real oldHP= LoadReal(h, id, 15)
    local real oldMaxHP= LoadReal(h, id, 16)
    local real newHP= GetWidgetLife(LoadUnitHandle(h, id, c_TARGET))
    local real newMaxHP= GetWidgetMaxLife(LoadUnitHandle(h, id, c_TARGET))
    if duration > 0.0  and UnitIsAlive(LoadUnitHandle(h, id, c_TARGET)) then
        if IsUnitPaused(LoadUnitHandle(h, id, c_TARGET)) == false then
            call SaveReal(h, id, c_DURATION, duration - 0.03)
        endif
        set n=LoadUnitHandle(h, id, 17)
        call SetUnitX(n, target_x)
        call SetUnitY(n, target_y)
        call SetUnitFlyHeight(n, target_z + 250, 0)
        set n=LoadUnitHandle(h, id, 18)
        call SetUnitX(n, target_x)
        call SetUnitY(n, target_y)
        call SetUnitFlyHeight(n, target_z, 0)
        //call SetUnitFacingInstant(LoadUnitHandle(h, id, TargetHash), angle*bj_RADTODEG)
        call IssuePointOrder(LoadUnitHandle(h, id, c_TARGET), "smart", target_x + 100 * Cos(angle), target_y + 100 * Sin(angle))
        if newHP / newMaxHP < oldHP / oldMaxHP - 0.03 then
            call SaveReal(h, id, c_DURATION, 0)
        else
            call SaveReal(h, id, 15, GetWidgetLife(LoadUnitHandle(h, id, c_TARGET)))
            call SaveReal(h, id, 16, GetWidgetMaxLife(LoadUnitHandle(h, id, c_TARGET)))
        endif
    else
        if GetLocalPlayer() == GetOwningPlayer(LoadUnitHandle(h, id, c_TARGET)) and UnitIsAlive(LoadUnitHandle(h, id, c_TARGET)) and IsUnitSelected(LoadUnitHandle(h, id, c_TARGET),GetOwningPlayer(LoadUnitHandle(h, id, c_TARGET))) then
            call ClearSelection()
            call SelectUnit(LoadUnitHandle(h, id, c_TARGET), true)
        endif
                call FlushChildHashtable(h, GetHandleId(LoadTriggerHandle(h, id, 21)))
                call TriggerClearActions(LoadTriggerHandle(h, id, 21))
        call DestroyTrigger             (LoadTriggerHandle(h, id, 21))
        call KillUnit                   (LoadUnitHandle(h, id, 17))
        call KillUnit                   (LoadUnitHandle(h, id, 18))
                call MyRemoveUnit               (LoadUnitHandle(h, id, 17), 1)
                call MyRemoveUnit               (LoadUnitHandle(h, id, 18), 1)
        call UnitRemoveAbility  (LoadUnitHandle(h, id, c_TARGET), 'ReRf')
        call UnitRemoveAbility  (LoadUnitHandle(h, id, c_TARGET), 'cbc5')
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
endfunction

function RengokuR_Fear takes unit newCaster,unit newTarget,timer newTimer,trigger newTrigger returns nothing
    local integer id            = GetHandleId(newTimer)
    local integer id_target     = GetHandleId(newTarget)
    local real caster_x         = GetUnitX(newCaster)
    local real caster_y         = GetUnitY(newCaster)
    local real target_x         = GetUnitX(newTarget)
    local real target_y         = GetUnitY(newTarget)
    local real angle            = AU(newCaster , newTarget)
    set n=CreateUnit(GetOwningPlayer(newTarget), 'dAlb', target_x, target_y, angle * bj_RADTODEG)
    // call UnitAddAbility(n, 'RenS')
    // call SetUnitAbilityLevel(n, 'RenS', 2)
    // call IssueTargetOrder(n, "slow", newTarget)
    call MyRemoveUnit(n , 2)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dR22', target_x, target_y, angle * bj_RADTODEG)
    call SetUnitScale(n, 3, 3, 3)
    call SetUnitFlyHeight(n, GetUnitFlyHeight(newTarget) + 250, 0)
    call SaveUnitHandle(h, id, 17, n)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dR23', target_x, target_y, angle * bj_RADTODEG)
    call SetUnitScale(n, 1.4, 1.4, 1.4)
    call SetUnitFlyHeight(n, GetUnitFlyHeight(newTarget), 0)
    call SaveUnitHandle(h, id, 18, n)
    if GetLocalPlayer() == GetOwningPlayer(newTarget) and IsUnitSelected(newTarget,GetOwningPlayer(newTarget)) then
        call ClearSelection()
    endif
    call SetControlToUnit(newCaster, newTarget, 3.0, "doom")
    call SaveInteger(h, GetHandleId(newTrigger), 20, id)
    call TriggerRegisterUnitEvent(newTrigger, newTarget, EVENT_UNIT_SELECTED)
    call TriggerAddAction(newTrigger, function Rengoku_Fear_Select)
    call SaveTriggerHandle(h, id, 21, newTrigger)
    call SaveUnitHandle (h, id,         c_TARGET, newTarget)
    call SaveReal               (h, id, c_ANGLE, angle)
    call SaveReal               (h, id, c_DURATION, 3)
    call SaveReal               (h, id, 15, GetWidgetLife(newTarget))
    call SaveReal               (h, id, 16, GetWidgetMaxLife(newTarget))
    call TimerStart(newTimer, 0.03, true, function RengokuR_Fear_Periodic)
    set newTrigger=null
endfunction

function RengokuR_Enko_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local real distance= LoadReal(h, id, c_DISTANCE)
    local real speed= 38
    local unit caster = LoadUnitHandle(h, id, c_CASTER)
    local real dummy_x= GetUnitX(LoadUnitHandle(h, id, c_DUMMY1))
    local real dummy_y= GetUnitY(LoadUnitHandle(h, id, c_DUMMY1))
    local real angle= LoadReal(h, id, c_ANGLE)
    local integer eff_period= LoadInteger(h, id, c_EFFPERIOD)
    if distance > 0 and IsTerrainPathable(dummy_x + speed * Cos(angle), dummy_y + speed * Sin(angle), PATHING_TYPE_FLYABILITY)==false then
        call SaveReal(h, id, c_DISTANCE, distance - speed)
        set bjLCU=LoadUnitHandle(h, id, c_DUMMY1)
        call SetUnitX(bjLCU, dummy_x + speed * Cos(angle))
        call SetUnitY(bjLCU, dummy_y + speed * Sin(angle))
        call SetUnitFacingInstant(bjLCU , angle * bj_RADTODEG)
        call SetUnitVertexColor(bjLCU, 255, 100 + R2I(200 - distance / 15), 100, 100)
        set bjLCU=LoadUnitHandle(h, id, c_DUMMY2)
        call SetUnitX(bjLCU , dummy_x + ( speed + 50 ) * Cos(angle))
        call SetUnitY(bjLCU , dummy_y + ( speed + 50 ) * Sin(angle))
        call SetUnitFacing(bjLCU , angle * bj_RADTODEG)
        set bjLCU=LoadUnitHandle(h, id, c_DUMMY3)
        call SetUnitX(bjLCU , dummy_x + ( speed + 50 ) * Cos(angle))
        call SetUnitY(bjLCU , dummy_y + ( speed + 50 ) * Sin(angle))
        call SetUnitFacing(bjLCU , angle * bj_RADTODEG)
        set bjLCU=null
        set bjLCG=LoadGroupHandle(h, id, c_GROUP1)
        call GroupEnumUnitsInRange(bjLCG, dummy_x, dummy_y, 200, Base)
        loop
        set bjLCU=FirstOfGroup(bjLCG)
        exitwhen bjLCU == null
            if Condition_Base(GetOwningPlayer(caster) , bjLCU) and IsUnitInGroup(bjLCU, LoadGroupHandle(h, id, c_GROUP2)) == false then
                call myCustomDamage(caster , bjLCU , LoadReal(h, id, c_DAMAGE) , false , false , null , null , null)
                if IsUnitInvulnerable(bjLCU)==false then
                    //call RengokuR_Fear(caster , bjLCU , CreateTimer() , CreateTrigger())
                    call PoisonDamage3(caster,bjLCU,LoadReal(h, id, c_PARTDAMAGE),8,"Environment\\LargeBuildingFire\\LargeBuildingFire1.mdl","origin")
                endif
                call GroupAddUnit(LoadGroupHandle(h, id, c_GROUP2), bjLCU)
            endif
        call GroupRemoveUnit(bjLCG, bjLCU)
        endloop
        set dummy_x=GetUnitX(LoadUnitHandle(h, id, c_DUMMY1)) + 150 * Cos(angle)
        set dummy_y=GetUnitY(LoadUnitHandle(h, id, c_DUMMY1)) + 150 * Sin(angle)
        if eff_period == 0 then
                        // set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dRe9', dummy_x, dummy_y, GetRandomInt(0, 360))
                        // call SetUnitScale(bjLCU, 1.8, 1.8, 1.8)
                        // call SetUnitFlyHeight(bjLCU, 60, 0)
                        // call UnitApplyTimedLife(bjLCU, 'BTLF', 0.5)
                        // call MyRemoveUnit(bjLCU, 1.0)
                        // set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dRe9', dummy_x + 100 * Cos(angle + 90 * bj_DEGTORAD), dummy_y + 100 * Sin(angle + 90 * bj_DEGTORAD), GetRandomInt(0, 360))
                        // call SetUnitScale(bjLCU, 1.8, 1.8, 1.8)
                        // call SetUnitFlyHeight(bjLCU, 60, 0)
                        // call UnitApplyTimedLife(bjLCU, 'BTLF', 0.5)
                        // call MyRemoveUnit(bjLCU, 1.0)
                        // set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dRe9', dummy_x - 100 * Cos(angle + 90 * bj_DEGTORAD), dummy_y - 100 * Sin(angle + 90 * bj_DEGTORAD), GetRandomInt(0, 360))
                        // call SetUnitScale(bjLCU, 1.8, 1.8, 1.8)
                        // call SetUnitFlyHeight(bjLCU, 60, 0)
                        // call UnitApplyTimedLife(bjLCU, 'BTLF', 0.5)
                        // call MyRemoveUnit(bjLCU, 1.0)
        
            call SaveInteger(h, id, c_EFFPERIOD, 6)
        else
            call SaveInteger(h, id, c_EFFPERIOD, eff_period - 1)
        endif
    else
        set bjLCG=LoadGroupHandle(h, id, c_GROUP1)
        call GroupEnumUnitsInRange(bjLCG, dummy_x, dummy_y, 700, Base)
        loop
        set bjLCU=FirstOfGroup(bjLCG)
        exitwhen bjLCU == null
            if Condition_Base(GetOwningPlayer(caster) , bjLCU) and IsUnitInGroup(bjLCU, LoadGroupHandle(h, id, c_GROUP2)) == false then
                call myCustomDamage(caster , bjLCU , LoadReal(h, id, c_DAMAGE) , false , false , null , null , null)
                                if IsUnitInvulnerable(bjLCU)==false then
                                        //call RengokuR_Fear(caster , bjLCU , CreateTimer() , CreateTrigger())
                    call PoisonDamage3(caster,bjLCU,LoadReal(h, id, c_PARTDAMAGE),7,"Environment\\LargeBuildingFire\\LargeBuildingFire1.mdl","origin")
                                endif
                call GroupAddUnit(LoadGroupHandle(h, id, c_GROUP2), bjLCU)
            endif
        call GroupRemoveUnit(bjLCG, bjLCU)
        endloop
        call MyRemoveUnit(CreateUnit(GetOwningPlayer(caster),'dAlb', dummy_x, dummy_y, 0), 3)
        // call MyRemoveUnit(CreateUnit(GetOwningPlayer(caster),'dR28', dummy_x, dummy_y, GetRandomInt(0, 360)), 4)
        set n=CreateUnit(GetOwningPlayer(caster),'eo9K',dummy_x, dummy_y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',3)
        set n=CreateUnit(GetOwningPlayer(caster),'eo9L',dummy_x, dummy_y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',3)
        call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(caster),'e0S4',dummy_x, dummy_y,GetRandomReal(0,359)),'BTLF',4)
        call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(caster),'e1S5',dummy_x, dummy_y,GetRandomReal(0,359)),'BTLF',6)
        call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(caster),'e0S3',dummy_x, dummy_y,GetRandomReal(0,359)),'BTLF',4)
        call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(caster),'e1S2',dummy_x, dummy_y,GetRandomReal(0,359)),'BTLF',4)
        call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(caster),'e0S6',dummy_x, dummy_y,GetRandomReal(0,359)),'BTLF',4)
        call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(caster),'e0S7',dummy_x, dummy_y,GetRandomReal(0,359)),'BTLF',3)
        call KillUnit(LoadUnitHandle(h, id, c_DUMMY2))
        call KillUnit(LoadUnitHandle(h, id, c_DUMMY3))
        call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY2), 1.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY3), 1.5)
        call RemoveUnit(LoadUnitHandle(h, id, c_DUMMY1))
        call DestroyGroup(LoadGroupHandle(h, id, c_GROUP1))
        call DestroyGroup(LoadGroupHandle(h, id, c_GROUP1))
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
        set caster=null
endfunction

function RengokuR_Enko_Cast takes unit newCaster,real newDmg, real newDmg2, real newAngle,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local integer id_caster= GetHandleId(newCaster)
    local real caster_x= GetUnitX(newCaster)
    local real caster_y= GetUnitY(newCaster)
    local real angle= newAngle
    call ShakeCamera(0.3 , 10)
    set soundplay=SndN(3265) // Sound\war3mapImported\RengokuR2.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR42', caster_x, caster_y, angle*bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 100, 0)
    call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
    call MyRemoveUnit(bjLCU, 1.5)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR94', caster_x, caster_y, angle*bj_RADTODEG)
    call SetUnitScale(bjLCU, 1.2, 1.2, 1.2)
    call MyRemoveUnit(bjLCU, 1.5)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR95', caster_x, caster_y, angle*bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 100, 0)
    call MyRemoveUnit(bjLCU, 1.5)
        
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR11', caster_x, caster_y, angle * bj_RADTODEG)
    call SetUnitScale(bjLCU, 2, 2, 2)
    call MyRemoveUnit(bjLCU , 1.5)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR96', caster_x, caster_y, angle * bj_RADTODEG)
    call SetUnitScale(bjLCU, 2, 2, 2)
    call MyRemoveUnit(bjLCU , 1.5)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR17', caster_x, caster_y, angle * bj_RADTODEG)
    call SetUnitScale(bjLCU, 2.5, 2.5, 2.5)
    call SetUnitVertexColor(bjLCU, 255, 100, 100, 100)
    call SetUnitAnimationByIndex(bjLCU, 6)
    call SaveUnitHandle(h, id, c_DUMMY1, bjLCU) //BY_Wood_Effect_YuZhiBoYou_Fire_HaoHuoQiu
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dRe8', caster_x, caster_y, angle*bj_RADTODEG)
    call SetUnitScale(bjLCU, 1.2, 1.2, 1.2)
    call SetUnitFlyHeight(bjLCU, 250, 0)
    call SaveUnitHandle(h, id, c_DUMMY2, bjLCU)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dRe9', caster_x, caster_y, angle*bj_RADTODEG)
    call SetUnitScale(bjLCU, 2, 2, 2)
    call SaveUnitHandle(h, id, c_DUMMY3, bjLCU)

    call SetUnitAnimationByIndex(newCaster, 9)
    call SaveUnitHandle(h, id, c_CASTER, newCaster)
    call SaveReal(h, id, c_DISTANCE, 3000)
    call SaveReal(h, id, c_ANGLE, angle)
    call SaveReal(h, id, c_DAMAGE, newDmg)
    call SaveReal(h, id, c_PARTDAMAGE, newDmg2)
    call SaveGroupHandle(h, id, c_GROUP1, CreateGroup())
    call SaveGroupHandle(h, id, c_GROUP2, CreateGroup())
    call TimerStart(newTimer, 0.02, true, function RengokuR_Enko_Periodic)
endfunction

function RengokuR_Periodic takes nothing returns nothing
    local integer id    = GetHandleId(GetExpiredTimer())
    local real time             = LoadReal(h, id, c_TIME)
        local unit caster       = LoadUnitHandle(h, id, c_CASTER)
    local real caster_x = GetUnitX(caster)
    local real caster_y = GetUnitY(caster)
    local integer eff_period= LoadInteger(h, id, c_EFFPERIOD)
    if time < 1.3 then
        call SaveReal(h, id, c_TIME, time + 0.03)
        call SetUnitInvulnerable(caster, true)
                call SetUnitXY(LoadUnitHandle(h, id, c_DUMMY2), caster_x, caster_y)
        if eff_period == 0 then
                        set n=CreateUnit(GetOwningPlayer(caster), 'dR50', caster_x, caster_y, GetRandomInt(0, 360))
                        call SetUnitScale(n, 0.6, 0.6, 0.6)
                        call SetUnitVertexColor(n, 255, 255, 255, 225)
                        call SetUnitFlyHeight(n, 10, 0)
                        call MyRemoveUnit(n, 1.5)
            call SaveInteger(h, id, c_EFFPERIOD, 9)
        else
            call SaveInteger(h, id, c_EFFPERIOD, eff_period - 1)
        endif
    else
                set n = CreateUnit(GetOwningPlayer(caster), 'dR27', caster_x, caster_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 0.75, 0.75, 0.75)
                call SetUnitVertexColor(n, 255, 255, 255, 195)
                call KillUnit(n)
                call MyRemoveUnit(n, 3)
                call RemoveUnit(LoadUnitHandle(h, id, c_DUMMY2))
                call UnitRemoveAbility(caster, 'ReEp')
        call SetUnitTimeScale(caster, 1)
        call RengokuR_Enko_Cast(caster , LoadReal(h, id, c_DAMAGE), LoadReal(h, id, c_PARTDAMAGE) , LoadReal(h, id, c_ANGLE) , CreateTimer())
                call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY1), 1.5)
        // call RemoveEffect(LoadEffectHandle(h, id, StringHash("Effect3")) , 1 , true , CreateTimer())
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
        set caster=null
endfunction

function RengokuR_Cast takes unit newCaster,real newX,real newY,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local integer id_caster= GetHandleId(newCaster)
    local real caster_x= GetUnitX(newCaster)
    local real caster_y= GetUnitY(newCaster)
    local real angle= AP(caster_x , caster_y , newX , newY)
    local boolean RengokuD_Buff= RengokuD_Cast(newCaster)
    local real full_damage= ( 4 + GetUnitAbilityLevel(newCaster, 'RenR') ) * GetHeroAgi(newCaster, true)
    local real dmg2=(1.5+0.5*GetUnitAbilityLevel(newCaster,'RenR'))*GetHeroAgi(newCaster,true)
    if GetUnitAbilityLevel(newCaster, 'ReFP') >= 1 or LoadBoolean(HH, id_caster, RengokuF_Pass) == true then
        set full_damage=full_damage + GetHeroAgi(newCaster, true)
    endif
    if RengokuD_Buff == true then
        set full_damage=full_damage * 1.15
        set dmg2=dmg2*1.15
    endif
    set soundplay=SndN(3267) // Sound\war3mapImported\RengokuR1.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call RemoveEffect(AddSpecialEffectTarget("123 (1081).mdl", newCaster, "weapon"), 2.5, true, CreateTimer())
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR25', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(bjLCU, 1.6, 1.6, 1.6)
        call SetUnitTimeScale(bjLCU, 0.4)
        //call SetUnitVertexColor(bjLCU, 255, 255, 255, 100)
        call SetUnitFlyHeight(bjLCU, 5, 0)
        call SaveUnitHandle(h, id, c_DUMMY1, bjLCU)
        
        
        set bjLCU = CreateUnit(GetOwningPlayer(newCaster), 'dAlb', caster_x, caster_y, 0)
        call SaveUnitHandle(h, id, c_DUMMY2, bjLCU)
    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
    call SetUnitTimeScale(newCaster, 0.3)
    call SetUnitAnimationByIndex(newCaster, 6)
    call SaveUnitHandle(h, id, c_CASTER, newCaster)
    call SaveReal(h, id, c_DAMAGE, full_damage)
    call SaveReal(h, id, c_PARTDAMAGE, dmg2)
    call SaveReal(h, id, c_ANGLE, angle)
    call TimerStart(newTimer, 0.03, true, function RengokuR_Periodic)
endfunction


function RengokuT_Act3 takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local unit caster       = LoadUnitHandle(h, id, c_CASTER)
    local unit target       = LoadUnitHandle(h, id, c_TARGET)
    local real time= LoadReal(h, id, c_TIME)
    local integer act= LoadInteger(h, id, c_ACT)
    local boolean b_SecondDamage_Chaos= LoadBoolean(h, id, 21)
    local real angle= AU(caster , target)
    if act == 2 then
        call SaveReal(h, id, c_TIME, time + 0.02)
        call SetUnitX(caster, GetUnitX(target) - 170 * Cos(angle))
        call SetUnitY(caster, GetUnitY(target) - 170 * Sin(angle))
        call SetUnitFacing(caster, angle * bj_RADTODEG)
        call SetUnitInvulnerable(caster, true)
        call PauseUnit(target,true)
        call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
        call SetUnitInvulnerable(target, true)
        call UnitRemoveAbility(caster,'A2VJ')
        if time < 2 then
            call PauseUnit(caster, true)
            call SetUnitInvulnerable(caster, true)
            call PauseUnit(target,true)
            call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
            call SetUnitInvulnerable(target, true)
            set bjLCU=LoadUnitHandle(h, id, 26)
            call SetUnitX(bjLCU , GetUnitX(target))
            call SetUnitY(bjLCU , GetUnitY(target))
            // set bjLCU=LoadUnitHandle(h, id, StringHash("EffectAct2_2"))
            // call SetUnitX(bjLCU , GetUnitX(target))
            // call SetUnitY(bjLCU , GetUnitY(target))
        endif
        if time==0.9 then
            call SetUnitTimeScale(caster, 0.3)
            call SetUnitAnimationByIndex(caster, 33)
        endif
        if time == 2 then

            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR33', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
            call SetUnitScale(bjLCU, 2, 2, 2)
            call MyRemoveUnit(bjLCU, 2.5)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR34', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
            call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
            call MyRemoveUnit(bjLCU, 2.5)
            
            
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR35', GetUnitX(target), GetUnitY(target), angle * bj_RADTODEG)
            call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
            call MyRemoveUnit(bjLCU, 2.5)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR36', GetUnitX(target), GetUnitY(target), angle * bj_RADTODEG)
            call SetUnitScale(bjLCU, 3.5, 3.5, 3.5)
            call MyRemoveUnit(bjLCU, 2.5)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR37', GetUnitX(target), GetUnitY(target), angle * bj_RADTODEG)
            call SetUnitScale(bjLCU, 2.5, 2.5, 2.5)
            call SetUnitFlyHeight(bjLCU, 50, 0)
            call MyRemoveUnit(bjLCU, 2.5)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR38', GetUnitX(target), GetUnitY(target), angle * bj_RADTODEG)
            call SetUnitScale(bjLCU, 1.75, 1.75, 1.75)
            call MyRemoveUnit(bjLCU, 2.5)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR39', GetUnitX(target), GetUnitY(target), angle * bj_RADTODEG+90)
            call SetUnitScale(bjLCU, 1.75, 1.75, 1.75)
            call MyRemoveUnit(bjLCU, 2.5)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR40', GetUnitX(target), GetUnitY(target), angle * bj_RADTODEG)
            call SetUnitScale(bjLCU, 5, 5, 5)
            call MyRemoveUnit(bjLCU, 2.5)
            
            call PauseUnit(target,false)
            call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
            call SetUnitInvulnerable(target, false)
            if UnitIsAlive(target) then
                call myCustomDamage(caster , target , GetHeroAgi(caster, true)*5 , false , false , null , null , null)
            endif
            call PauseUnit(target,true)
            call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
            call SetUnitInvulnerable(target, true)
            call SetUnitTimeScale(target, 0.3)
            call SetUnitAnimation(target, "death")
            set bjLCG=CreateGroup()
            set bj_lastCreatedGroup=CreateGroup()
            set bj_forLoopAIndex=0
            loop
            exitwhen bj_forLoopAIndex >= 10
                set bj_forLoopAIndex=bj_forLoopAIndex + 1
                call GroupEnumUnitsInRange(bjLCG, GetUnitX(caster) + ( bj_forLoopAIndex * 130 ) * Cos(angle), GetUnitY(caster) + ( bj_forLoopAIndex * 130 ) * Sin(angle), 50 + bj_forLoopAIndex * 40, Base)
                loop
                set bjLCU=FirstOfGroup(bjLCG)
                exitwhen bjLCU == null
                    if Condition_Base(GetOwningPlayer(caster) , bjLCU) then
                        call GroupAddUnit(bj_lastCreatedGroup, bjLCU)
                    endif
                    call GroupRemoveUnit(bjLCG, bjLCU)
                endloop
            endloop
            set bj_forLoopAIndex=0
            call DestroyGroup(bjLCG)
            set bjLCG=bj_lastCreatedGroup
            loop
            set bjLCU=FirstOfGroup(bjLCG)
            exitwhen bjLCU == null
                if Condition_Base(GetOwningPlayer(caster) , bjLCU) then
                    call myCustomDamage(caster , bjLCU , GetHeroAgi(caster, true)*5 , false , false , null , null , null)
                endif
                call GroupRemoveUnit(bjLCG, bjLCU)
            endloop
            call DestroyGroup(bjLCG)
        elseif time == 3.8 then
            call PauseUnit(target,false)
            call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
            call SetUnitInvulnerable(target, false)
            set bjLCG=CreateGroup()
            call GroupEnumUnitsInRange(bjLCG, GetUnitX(caster), GetUnitY(caster), 700, Base)
            loop
            set bjLCU=FirstOfGroup(bjLCG)
            exitwhen bjLCU == null
                if Condition_Base(GetOwningPlayer(caster) , bjLCU) then
                    call SetControlToUnit(caster , bjLCU , 1 , "stun")
                    if b_SecondDamage_Chaos == true then
                        if GetWidgetLife(bjLCU) > ( GetHeroAgi(caster, true) * 6 ) then
                            call SetWidgetLife(bjLCU, GetWidgetLife(bjLCU) - ( GetHeroAgi(caster, true)*6 ))
                        else
                            call SetUnitInvulnerable(bjLCU, false)
                            call UnitAddAbility(bjLCU, 'A0WR')
                            call DamageIndicatorFunction(caster , bjLCU, GetHeroAgi(caster, true) * 6)
                            call myCustomDamage(caster , bjLCU , 999999999 , false , false , null , DAMAGE_TYPE_UNKNOWN , null)
                            call UnitRemoveAbility(bjLCU, 'A0WR')
                        endif
                    else
                        call myCustomDamage(caster , bjLCU , GetHeroAgi(caster, true)*6 , false , false , null , null , null)
                    endif
                endif
                call GroupRemoveUnit(bjLCG, bjLCU)
            endloop
            call DestroyGroup(bjLCG)
            call SetUnitTimeScale(target, 1)
            call SetUnitAnimation(target, "death")
            call SaveInteger(h, id, c_ACT, 3)
            call SaveReal(h, id, c_TIME, 0)
            set soundplay=SndN(3269) // Sound\war3mapImported\RengokuT4.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR32', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
            call SetUnitScale(bjLCU, 2.75, 2.75, 2.75)
            call SetUnitVertexColor(bjLCU, 255, 255, 255, 100)
            call MyRemoveUnit(bjLCU, 2.5)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR31', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
            call SetUnitScale(bjLCU, 3, 3, 3)
            call SetUnitVertexColor(bjLCU, 255, 150, 0, 255)
            call MyRemoveUnit(bjLCU, 2.5)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR31', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
            call SetUnitScale(bjLCU, 5, 5, 5)
            call SetUnitVertexColor(bjLCU, 255, 150, 0, 255)
            call MyRemoveUnit(bjLCU, 2.5)
            
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR30', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
            call SetUnitScale(bjLCU, 0.65, 0.65, 0.65)
            call MyRemoveUnit(bjLCU , 2.5)
            // set bjLCE=AddSpecialEffect("az_coco_t2_2.mdl", GetUnitX(target), GetUnitY(target))
            // call SetSpecialEffectZ(bjLCE , 15)
            // call SetSpecialEffectScale(bjLCE , 3)
            // call SetSpecialEffectFacing(bjLCE , GetRandomInt(0, 360))
            // call RemoveEffect(bjLCE , 3.2 , true , CreateTimer())
            
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dRe7', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
            call SetUnitScale(bjLCU, 5, 5, 1)
            call SetUnitTimeScale(bjLCU, 0.4)
            call MyRemoveUnit(bjLCU , 2.5)
            //call RengokuT_SpecialEffectControl(bjLCU)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR14',  GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
            call SetUnitFlyHeight(bjLCU, 10, 0)
            call SetUnitScale(bjLCU, 1.2, 1.2, 1.2)
            call SetUnitVertexColor(bjLCU, 255, 255, 255, 180)
            call UnitApplyTimedLife(bjLCU, 'BTLF', 1.5)
            call MyRemoveUnit(bjLCU , 2.5)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR15',  GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
            call SetUnitFlyHeight(bjLCU, 10, 0)
            call SetUnitScale(bjLCU, 2.3, 2.3, 2.3)
            call MyRemoveUnit(bjLCU , 2.5)
        endif
    else
        call KillUnit(LoadUnitHandle(h, id, 26))
        //call KillUnit(LoadUnitHandle(h, id, StringHash("EffectAct2_2")))
        call MyRemoveUnit(LoadUnitHandle(h, id, 26), 1.5)
        //call MyRemoveUnit(LoadUnitHandle(h, id, StringHash("EffectAct2_2")), 1.5)
        // call DestroyEffect(LoadEffectHandle(h, id, Effect1Hash))
        // call DestroyEffect(LoadEffectHandle(h, id, Effect2Hash))
        // call DestroyEffect(LoadEffectHandle(h, id, StringHash("Effect3")))
        call DestroyEffect(LoadEffectHandle(h, id, 22))
        call DestroyEffect(LoadEffectHandle(h, id, 23))
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call IssueImmediateOrder(caster, "stop")
        call PauseUnit(target,false)
        call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
        call SetUnitInvulnerable(target, false)
        call SetUnitTimeScale(caster, 1)
        call SetUnitTimeScale(target, 1)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
        call StartAbilityCooldown(GetUnitAbility(caster, 'RenT'), 35)
    endif
    set caster=null
    set target=null
endfunction

function RengokuT_Act2 takes nothing returns nothing
    local integer id        = GetHandleId(GetExpiredTimer())
    local unit caster       = LoadUnitHandle(h, id, c_CASTER)
    local unit target       = LoadUnitHandle(h, id, c_TARGET)
    local real time             = LoadReal(h, id, c_TIME)
    local integer act   = LoadInteger(h, id, c_ACT)
    local boolean b_SecondDamage_Chaos= LoadBoolean(h, id, 21)
    local real angle= AU(caster , target)
    if act==1 then
        if SquareRootUnit(caster , target) > 60 then
            call UnitRemoveAbility(caster,'A2VJ')
            call SetUnitX(caster, GetUnitX(caster) + 40 * Cos(angle))
            call SetUnitY(caster, GetUnitY(caster) + 40 * Sin(angle))
            set bjLCU=LoadUnitHandle(h, id, 24)
            call SetUnitX(bjLCU , GetUnitX(caster))
            call SetUnitY(bjLCU , GetUnitY(caster))
            call SetUnitFacing(bjLCU , angle * bj_RADTODEG)
            set bjLCU=LoadUnitHandle(h, id, 25)
            call SetUnitX(bjLCU, GetUnitX(caster))
            call SetUnitY(bjLCU, GetUnitY(caster))
            call SetUnitFacing(bjLCU , angle * bj_RADTODEG)
            if LoadInteger(h, id, c_EFFPERIOD) == 0 then     
                set bjLCU = CreateUnit(GetOwningPlayer(caster), 'dR10', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
                call SetUnitVertexColor(bjLCU, 255, 255, 255, 80)
                call SetUnitTimeScale(bjLCU, 1.5)
                call SetUnitAnimationByIndex(bjLCU, 7)
                call MyRemoveUnit(bjLCU, 0.15)
                call SaveInteger(h, id, c_EFFPERIOD, 1)
            else
                call SaveInteger(h, id, c_EFFPERIOD, c_EFFPERIOD - 1)
            endif
        else
            if LoadBoolean(HH,GetHandleId(target),ANTITARGET_ABILITY)==false then
                if time == 0 then
                    call RengokuE_Shifting(caster , target , angle , 500 , CreateTimer())
                    call PauseUnit(caster, true)
                    call SetUnitInvulnerable(caster, true)
                    call PauseUnit(target,true)
                    call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
                    call SetUnitInvulnerable(target, true)
                    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR13', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
                    call SetUnitScale(bjLCU, 2, 2, 2)
                    call SetUnitTimeScale(bjLCU, 0.6)
                    call MyRemoveUnit(bjLCU , 2.5)
                    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR11', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
                    call SetUnitScale(bjLCU, 1.3, 1.3, 1.3)
                    call SetUnitFlyHeight(bjLCU, 75, 0)
                    call MyRemoveUnit(bjLCU , 2.5)
                    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR25', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
                    call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
                    call SetUnitFlyHeight(bjLCU, 100, 0)
                    call SetUnitTimeScale(bjLCU, 0.8)
                    call MyRemoveUnit(bjLCU , 2.5)
                endif
                if time == 0.6 then
                    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR13', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
                    call SetUnitScale(bjLCU, 5, 5, 5)
                    call SetUnitTimeScale(bjLCU, 0.6)
                    call MyRemoveUnit(bjLCU , 2.5)
                    // set bjLCE=AddSpecialEffect("war3mapImported\\FireEffectOrange.mdl", GetUnitX(target), GetUnitY(target))
                    // call SetSpecialEffectZ(bjLCE , 75)
                    // call SetSpecialEffectScale(bjLCE , 1.3)
                    // call SetSpecialEffectFacing(bjLCE , GetRandomInt(0, 360))
                    // call DestroyEffect(bjLCE)
                    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR11', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
                    call SetUnitScale(bjLCU, 1.7, 1.7, 1.7)
                    call SetUnitFlyHeight(bjLCU, 75, 0)
                    call MyRemoveUnit(bjLCU , 2.5)
                    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR41', GetUnitX(target), GetUnitY(target), angle * bj_RADTODEG)
                    call MyRemoveUnit(bjLCU , 2.5)
                    set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h,id,c_CASTER)),'dR24', GetUnitX(target), GetUnitY(target), GetRandomInt(0,360))
                    call SetUnitFlyHeight(bjLCU, 100, 0)
                    call SetUnitScale(bjLCU, 2.7, 2.7, 2.7)
                    call SetUnitTimeScale(bjLCU, 0.6)
                    call SaveUnitHandle(h, id, 26, bjLCU)
                    // set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h,id,c_CASTER)),'dR25', GetUnitX(target), GetUnitY(target), GetRandomInt(0,360))
                    // call SetUnitFlyHeight(bjLCU, 100, 0)
                    // call SetUnitScale(bjLCU, 1.7, 1.7, 1.7)
                    // call SetUnitTimeScale(bjLCU, 0.4)
                    // call SaveUnitHandle(h, id, StringHash("EffectAct2_1"), bjLCU)
                    // set bjLCE=AddSpecialEffect("az_doomdragon_t.mdl", GetUnitX(target), GetUnitY(target))
                    // call SetSpecialEffectZ(bjLCE , 5)
                    // call SetSpecialEffectFacing(bjLCE , GetRandomInt(0, 360))
                    // call SetSpecialEffectScale(bjLCE , 5)
                    // call RemoveEffect(bjLCE , 5 , true , CreateTimer())
                    set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR12', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
                    call SetUnitScale(bjLCU, 1.8, 1.8, 1.8)
                    call SetUnitFlyHeight(bjLCU, 75, 0)
                    call MyRemoveUnit(bjLCU , 5)
                    
                    set soundplay=SndN(3272) // Sound\war3mapImported\RengokuT3.mp3
                    call StartSound(soundplay)
                    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                    call RemoveUnit(LoadUnitHandle(h, id, 24))
                    call RemoveUnit(LoadUnitHandle(h, id, 25))
                    call SetUnitTimeScale(caster, 0.2)
                    call SetUnitAnimationByIndex(caster, 9)
                    call PauseUnit(caster, true)
                    call SetUnitInvulnerable(caster, true)
                    call PauseUnit(target,true)
                    call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
                    call SetUnitInvulnerable(target, true)
                    call SaveInteger(h, id, c_ACT, 2)
                    call SaveReal(h, id, c_TIME, 0)
                else
                    call SaveReal(h, id, c_TIME, time + 0.02)
                endif
            else
                call DestroyEffect(LoadEffectHandle(h, id, 22))
                call DestroyEffect(LoadEffectHandle(h, id, 23))
                call RemoveUnit(LoadUnitHandle(h, id, 24))
                call RemoveUnit(LoadUnitHandle(h, id, 25))
                call PauseUnit(caster,false)
                call SaveUnitHandle(HH,GetHandleId(target),REVERSE_TARGET,caster)
                call SetUnitInvulnerable(caster,false)
                call FlushChildHashtable(h,id)
                call DestroyTimer(GetExpiredTimer())
                call StartAbilityCooldown(GetUnitAbility(caster, 'RenT'), 35)
            endif
        endif
    else
        call PauseTimer(GetExpiredTimer())
        call TimerStart(GetExpiredTimer(), 0.02, true, function RengokuT_Act3)
    endif
    set caster=null
    set target=null
endfunction



function RengokuT_Act1 takes nothing returns nothing
    local integer id                = GetHandleId(GetExpiredTimer())
    local unit caster               = LoadUnitHandle(h, id, c_CASTER)
    local real time                     = LoadReal(h, id, c_TIME)
    local integer act           = LoadInteger(h, id, c_ACT)
    local boolean b_SecondDamage_Chaos= LoadBoolean(h, id, 21)
    local real angle            = AU(caster , LoadUnitHandle(h, id, c_TARGET))
    if act==0 then
        call SaveReal(h, id, c_TIME, time + 0.05)
        call SetUnitFacing(caster, angle * bj_RADTODEG)
        call PauseUnit(caster, true)
        call SetUnitInvulnerable(caster, true)
        //call SetUnitX(LoadUnitHandle(h, id, Effect1Hash), GetUnitX(caster))
        //call SetUnitY(LoadUnitHandle(h, id, Effect1Hash), GetUnitY(caster))
        call SetUnitXY(LoadUnitHandle(h, id, c_DUMMY2), GetUnitX(caster), GetUnitY(caster))
        call SetUnitXY(LoadUnitHandle(h, id, c_DUMMY3), GetUnitX(caster), GetUnitY(caster))
        if time == 2 then
            set soundplay=SndN(3275) // Sound\war3mapImported\RengokuT2.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        endif
        if time == 3 then
            set soundplay=SndN(3278) // Sound\war3mapImported\RengokuT1.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        elseif time == 4 then
            call SetUnitAnimationByIndex(caster, 7)
            call SaveEffectHandle(h, id, 22, AddSpecialEffectTarget("OPm (897).mdx", caster, "hand right"))
            call SaveEffectHandle(h, id, 23, AddSpecialEffectTarget("OPm (897).mdx", caster, "hand left"))
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR39', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG + 90)
            call SetUnitFlyHeight(bjLCU, 100, 0)
            call SetUnitScale(bjLCU, 2.5, 2.5, 2.5)
            call MyRemoveUnit(bjLCU, 2.5)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR42', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
            call SetUnitFlyHeight(bjLCU, 60, 0)
            call SetUnitScale(bjLCU, 2, 2, 2)
            call SetUnitTimeScale(bjLCU, 0.7)
            call MyRemoveUnit(bjLCU, 2.5)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR27', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
            call SetUnitScale(bjLCU, 0.75, 0.75, 0.75)
            call SetUnitVertexColor(bjLCU, 255, 255, 255, 90)
            call MyRemoveUnit(bjLCU, 2.5)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dRe8', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
            call SetUnitFlyHeight(bjLCU, 125, 0)
            call SetUnitScale(bjLCU, 3, 3, 3)
            call SaveUnitHandle(h, id, 24, bjLCU)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dRe8', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
            call SetUnitFlyHeight(bjLCU, 100, 0)
            call SetUnitVertexColor(bjLCU, 255, 255, 255, 150)
            call SetUnitScale(bjLCU, 3, 3, 3)
            call SaveUnitHandle(h, id, 25, bjLCU)
            // call KillUnit(LoadUnitHandle(h, id, Effect1Hash))
            call KillUnit(LoadUnitHandle(h, id, c_DUMMY2))
            call KillUnit(LoadUnitHandle(h, id, c_DUMMY3))
            // call MyRemoveUnit(LoadUnitHandle(h, id, Effect1Hash), 1.5)
            call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY2), 1.5)
            call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY3), 1.5)
            call SaveInteger(h, id, c_ACT, 1)
            call SaveReal(h, id, c_TIME, 0)
        endif
    else
        call PauseTimer(GetExpiredTimer())
        call TimerStart(GetExpiredTimer(), 0.02, true, function RengokuT_Act2)
    endif
    set caster=null
endfunction



function RengokuT_Cast takes unit newCaster,unit newTarget,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local integer id_caster= GetHandleId(newCaster)
    local real caster_x= GetUnitX(newCaster)
    local real caster_y= GetUnitY(newCaster)
    local boolean b_RengokuF_Pass= LoadBoolean(HH, id_caster, RengokuF_Pass)
    set soundplay=SndN(3281) // Sound\war3mapImported\RengokuT0.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR12', caster_x, caster_y, GetRandomInt(0, 360))
    call SetUnitFlyHeight(bjLCU, 5, 0)
    call SetUnitScale(bjLCU, 5, 5, 5)
    call MyRemoveUnit(bjLCU, 5)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR13', caster_x, caster_y, GetRandomInt(0, 360))
    call SetUnitFlyHeight(bjLCU, 5, 0)
    call SetUnitScale(bjLCU, 1.6, 1.6, 1.6)
    call SetUnitTimeScale(bjLCU, 0.6)
    call MyRemoveUnit(bjLCU, 2)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR13', caster_x, caster_y, GetRandomInt(0, 360))
    call SetUnitFlyHeight(bjLCU, 5, 0)
    call SetUnitScale(bjLCU, 5.0, 5.0, 5.0)
    call SetUnitTimeScale(bjLCU, 0.6)
    call MyRemoveUnit(bjLCU, 2)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR11', caster_x, caster_y, GetRandomInt(0, 360))
    call SetUnitFlyHeight(bjLCU, 75, 0)
    call SetUnitScale(bjLCU, 1.3, 1.3, 1.3)
    call MyRemoveUnit(bjLCU, 2)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR11', caster_x, caster_y, GetRandomInt(0, 360))
    call SetUnitFlyHeight(bjLCU, 75, 0)
    call SetUnitScale(bjLCU, 2.1, 2.1, 2.1)
    call MyRemoveUnit(bjLCU, 2)
    // set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR12', caster_x, caster_y, GetRandomInt(0, 360))
    // call SetUnitFlyHeight(bjLCU, 10, 0)
    // call SetUnitScale(bjLCU, 1.8, 1.8, 1.8)
// call SaveUnitHandle(h, id, Effect1Hash, bjLCU)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR14', caster_x, caster_y, GetRandomInt(0, 360))
    call SetUnitFlyHeight(bjLCU, 10, 0)
    call SetUnitScale(bjLCU, 0.85, 0.85, 0.85)
    call SetUnitVertexColor(bjLCU, 255, 255, 255, 150)
    call SaveUnitHandle(h, id, c_DUMMY2, bjLCU)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR15', caster_x, caster_y, GetRandomInt(0, 360))
    call SetUnitFlyHeight(bjLCU, 10, 0)
    call SetUnitScale(bjLCU, 2, 2, 2)
    call SaveUnitHandle(h, id, c_DUMMY3, bjLCU)
    if b_RengokuF_Pass == true then
        call SaveBoolean(h, id, 21, true)
    else
        call SaveBoolean(h, id, 21, false)
    endif
    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, 10)
    call SaveUnitHandle(h, id, c_CASTER, newCaster)
    call SaveUnitHandle(h, id, c_TARGET, newTarget)
    call SaveInteger(h, id, c_ACT, 0)
    call TimerStart(newTimer, 0.05, true, function RengokuT_Act1)
endfunction

function Trig_RengokuInt_Actions takes nothing returns nothing

    if GetSpellAbilityId() == 'RenF' then
        call RengokuF_Cast(GetSpellAbilityUnit() , CreateTimer())
    endif
    
    if GetSpellAbilityId() == 'RenQ' then
        call RengokuQ_Cast(GetSpellAbilityUnit() , CreateTimer())
    endif
        
    if GetSpellAbilityId() == 'RenW' then
        call RengokuW_Cast(GetSpellAbilityUnit() , GetSpellTargetX() , GetSpellTargetY() , CreateTimer())
    endif
        
    if GetSpellAbilityId() == 'RenE' then
        if IsUnitEnemy(GetSpellTargetUnit(), GetOwningPlayer(GetSpellAbilityUnit())) == false then
            call RengokuE_Shield(GetSpellAbilityUnit() , GetSpellTargetUnit() , CreateTimer())
        else
            call RengokuE_Cast(GetSpellAbilityUnit() , GetSpellTargetUnit() , CreateTimer())
        endif
    endif
        
    if GetSpellAbilityId() == 'RenR' then
        call RengokuR_Cast(GetSpellAbilityUnit() , GetSpellTargetX() , GetSpellTargetY() , CreateTimer())
    endif
    
    if GetSpellAbilityId() == 'RenT' then
        call RengokuT_Cast(GetSpellAbilityUnit() , GetSpellTargetUnit() , CreateTimer())
    endif
endfunction


//===========================================================================
function InitTrig_RengokuInt takes nothing returns nothing
    local trigger trig= CreateTrigger()
    local integer index= 0
    loop
        call TriggerRegisterPlayerUnitEvent(trig, Player(index), EVENT_PLAYER_UNIT_SPELL_EFFECT, null)
        set index=index + 1
        exitwhen index == bj_MAX_PLAYER_SLOTS
    endloop
    call TriggerAddAction(trig, function Trig_RengokuInt_Actions)
        set trig=null
endfunction


//=================================================
function LawNewD_Periodic takes nothing returns nothing
	local integer id = GetHandleId(GetExpiredTimer())
	local integer id_caster = GetHandleId(LoadUnitHandle(h, id, CasterHash))
	local real caster_mp = GetWidgetMana(LoadUnitHandle(h, id, CasterHash))
	local real time = LoadReal(h, id, TIME_HASH)
	if GetUnitAbilityLevel(LoadUnitHandle(h, id, CasterHash), 'LaD2')>=1 then
		if time<0.5 then
			call SetUnitScale(LoadUnitHandle(h, id, SH_Room), 0.8+time*2.5, 0.8+time*2.5, 0.8+time*2)
			call SetUnitScale(LoadUnitHandle(h, id, SH_EffectUnit1), 0.8+time*17, 0.8+time*17, 1)
			call SaveReal(h, id, TIME_HASH, time+0.01)
		else
			if caster_mp>50 and IsUnitAliveBJ(LoadUnitHandle(h, id, CasterHash)) then
				call SetWidgetMana(LoadUnitHandle(h, id, CasterHash), caster_mp-GetWidgetMaxMana(LoadUnitHandle(h, id, CasterHash))*0.0065*0.01)
			else
				call UnitRemoveAbility(LoadUnitHandle(h, id, CasterHash), 'LaD2')
			endif
		endif
	else
		call KillUnit(LoadUnitHandle(h, id, SH_EffectUnit1))
		call MyRemoveUnit(LoadUnitHandle(h, id, SH_EffectUnit1), 2)
		call KillUnit(LoadUnitHandle(h, id, SH_Room))
		call MyRemoveUnit(LoadUnitHandle(h, id, SH_Room), 2)
		call ShowAbility2( 'LawD', true)
		call StartAbilityCooldown(GetUnitAbility(LoadUnitHandle(h, id, CasterHash), 'LawD'), 3)
		call SaveBoolean(h, id_caster, SH_RoomBoolean, false)
		call FlushChildHashtable(h, id)
		call DestroyTimer(GetExpiredTimer())
	endif
endfunction

function LawNewD takes unit newCaster, real point_x, real point_y, timer newTimer returns nothing
        local integer id = GetHandleId(newTimer)
        local integer id_caster = GetHandleId(newCaster)
        local integer loop_index = 0
        set soundplay=SndN(3283) // Sound\war3mapImported\LawD_Sound1.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
	//if GetRandomInt(0, 1)==0 then
		set soundplay=SndN(3285) // Sound\war3mapImported\LawD_Voice1.mp3
		call StartSound(soundplay)
		//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
	//endif
	call ShowAbility2('LawD', false)
	call UnitAddAbility(newCaster, 'LaD2')
	set n=CreateUnit(GetOwningPlayer(newCaster), 'dH37', point_x, point_y, GetRandomInt(0, 360))
	call SetUnitFlyHeight(n, 20, 0)
	call SetUnitScale(n, 3.2, 3.2, 3.2)
	call MyRemoveUnit(n, 1.5)
	loop
	exitwhen loop_index==12
		//war3mapImported\\DustWaveAnimate.mdl
		// set bjLCE = AddSpecialEffect("war3mapImported\\DustWaveAnimate.mdl", point_x, point_y)
		// call SetSpecialEffectZ(bjLCE, 20)
		// call SetSpecialEffectScale(bjLCE, 0.5+I2R(loop_index)*0.5)
		// call SetSpecialEffectFacing(bjLCE, GetRandomInt(0, 360))
		// call SetSpecialEffectAlpha(bjLCE, 110)
		// call SetSpecialEffectTimeScale(bjLCE, 0.9)
		// call SetSpecialEffectAnimationByIndex(bjLCE, 0)
		// call DestroyEffect(bjLCE)
		set bjLCU = CreateUnit(GetOwningPlayer(newCaster), 'e007', point_x, point_y, GetRandomInt(0, 360))
		call SetUnitFlyHeight(bjLCU, 20, 0)
		call SetUnitScale(bjLCU, 0.5+I2R(loop_index)*0.5, 0.5+I2R(loop_index)*0.5, 0.5+I2R(loop_index)*0.5)
		call SetUnitVertexColor(bjLCU, 255, 255, 255, 110)
		call SetUnitTimeScale(bjLCU, 0.9)
		call SetUnitAnimationByIndex(bjLCU, 0)
		call MyRemoveUnit(bjLCU, 1)
		set loop_index = loop_index + 1
	endloop
	set bjLCU = CreateUnit(GetOwningPlayer(newCaster), 'dH36', point_x, point_y, GetRandomInt(0, 360))
	call SetUnitAnimation(bjLCU, "birth")
	call SetUnitTimeScale(bjLCU, 2)
	call SetUnitScale(bjLCU, 0.5, 0.5, 0.5)
	call UnitAddAbility(bjLCU, 'A0K6')
	call SaveUnitHandle(h, id, SH_Room, bjLCU)
	set bjLCU = CreateUnit(GetOwningPlayer(newCaster), 'dR71', point_x, point_y, GetRandomInt(0, 360))
	call SetUnitAnimation(bjLCU, "birth")
	call SetUnitTimeScale(bjLCU, 0.5)
	call SetUnitScale(bjLCU, 0.5, 0.5, 0.5)
	call SaveUnitHandle(h, id, SH_EffectUnit1, bjLCU)
	call SaveUnitHandle(h, id, CasterHash, newCaster)
	call SaveBoolean(h, id_caster, SH_RoomBoolean, true)
	call SaveReal(h, id_caster, SH_Room_X, point_x)
	call SaveReal(h, id_caster, SH_Room_Y, point_y)
	call TimerStart(newTimer, 0.01, true, function LawNewD_Periodic)
endfunction

function LawNewD2_Periodic takes nothing returns nothing
        local integer id = GetHandleId(GetExpiredTimer())
        if GetUnitAbilityLevel(LoadUnitHandle(h, id, CasterHash), 'LaD2')>=1 then
                call UnitRemoveAbility(LoadUnitHandle(h, id, CasterHash), 'LaD2')
        endif
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
endfunction

function LawNewD2 takes unit newCaster, timer newTimer returns nothing
        local integer id = GetHandleId(newTimer)
        call SaveUnitHandle(h, id, CasterHash, newCaster)
        call TimerStart(newTimer, 0.01, false, function LawNewD2_Periodic)
endfunction

function LawNewF_Periodic takes nothing returns nothing
	local integer id = GetHandleId(GetExpiredTimer())
    local unit caster = LoadUnitHandle(h, id, CasterHash)
    local unit target = LoadUnitHandle(h, id, TargetHash)
	local real time = LoadReal(h, id, TIME_HASH)
	local real target_x = GetUnitX(target)
	local real target_y = GetUnitY(target)
	
	if GetUnitCurrentOrder(caster)==OrderId("carrionswarm") then
		call SaveReal(h, id, TIME_HASH, time+0.01)
		if LoadInteger(h, id, EffectPeriodHash)==0 then
			set bjLCU = CreateUnit(GetOwningPlayer(caster), 'dR73', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0,360))
			call SetUnitAnimation(bjLCU, "stand")
			call SetUnitVertexColor(bjLCU, 255, 255, 255, 170)
			call SetUnitScale(bjLCU, 1.05, 1.05, 1.05)
			call MyRemoveUnit(bjLCU, 1)
			set bjLCU = CreateUnit(GetOwningPlayer(caster), 'dR73', GetUnitX(target), GetUnitY(target), GetRandomInt(0,360))
			call SetUnitAnimation(bjLCU, "stand")
			call SetUnitVertexColor(bjLCU, 255, 255, 255, 170)
			call SetUnitScale(bjLCU, 1.05, 1.05, 1.05)
			call MyRemoveUnit(bjLCU, 1)
			call SaveInteger(h, id, EffectPeriodHash, 15)
		else
			call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash)-1)
		endif
		if SquareRootPoint(target_x, target_y, LoadReal(h, id, SH_OriginalTargetX), LoadReal(h, id, SH_OriginalTargetY))>500 then
			call IssueImmediateOrder(caster, "stop")
		endif
		if time==1.0 then
			call IssueImmediateOrder(caster, "stop")
			set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH41', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
			call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
			call SetUnitFlyHeight(bjLCU, 20, 0)
			call MyRemoveUnit(bjLCU, 1.5)
			set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH18', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
			call SetUnitScale(bjLCU, 0.85, 0.85, 0.85)
			call SetUnitFlyHeight(bjLCU, 20, 0)
			call MyRemoveUnit(bjLCU, 1.5)
			set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH41', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
			call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
			call SetUnitFlyHeight(bjLCU, 20, 0)
			call MyRemoveUnit(bjLCU, 1.5)
			set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH18', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
			call SetUnitScale(bjLCU, 0.85, 0.85, 0.85)
			call SetUnitFlyHeight(bjLCU, 20, 0)
			call MyRemoveUnit(bjLCU, 1.5)

			call SetUnitX(target, GetUnitX(caster))
			call SetUnitY(target, GetUnitY(caster))
			call SetUnitX(caster, target_x)
			call SetUnitY(caster, target_y) 
			set soundplay=SndN(3287) // Sound\war3mapImported\LawF.mp3
			call StartSound(soundplay)
			//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
			set soundplay=SndN(3290) // Sound\war3mapImported\LawF_Voice1.mp3
			call StartSound(soundplay)
			//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
		endif
	else
		call FlushChildHashtable(h, id)
		call DestroyTimer(GetExpiredTimer())
	endif
    set caster = null
    set target = null
endfunction

function LawNewF_Cast takes unit newCaster, unit newTarget, timer newTimer returns nothing
	local integer id = GetHandleId(newTimer)
	local integer id_caster = GetHandleId(newCaster)
	local real Room_X = LoadReal(h, id_caster, SH_Room_X)
	local real Room_Y = LoadReal(h, id_caster, SH_Room_Y)
	local real target_x = GetUnitX(newTarget)
	local real target_y = GetUnitY(newTarget)
	local boolean bRoom = LoadBoolean(h, id_caster, SH_RoomBoolean)
	local boolean bMassiveRoom = LoadBoolean(h, id_caster, SH_MassiveRoomBoolean)
	local boolean SwapBoolean = false
	
	if bMassiveRoom then
		set SwapBoolean = true
	else
		if SquareRootPoint(GetUnitX(newTarget), GetUnitY(newTarget), Room_X, Room_Y)<=1000 and bRoom then
			set SwapBoolean = true
		endif
	endif
	if SwapBoolean and IsUnitType(newTarget, UNIT_TYPE_STRUCTURE)==false then
		if SquareRootUnit(newCaster, newTarget)<=1500 then
			call DestroyTimer(newTimer)
			set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dH41', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
			call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
			call SetUnitFlyHeight(bjLCU, 20, 0)
			call MyRemoveUnit(bjLCU, 1.5)
			set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dH18', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
			call SetUnitScale(bjLCU, 0.85, 0.85, 0.85)
			call SetUnitFlyHeight(bjLCU, 20, 0)
			call MyRemoveUnit(bjLCU, 1.5)
			set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dH41', GetUnitX(newTarget), GetUnitY(newTarget), GetRandomInt(0, 360))
			call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
			call SetUnitFlyHeight(bjLCU, 20, 0)
			call MyRemoveUnit(bjLCU, 1.5)
			set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dH18', GetUnitX(newTarget), GetUnitY(newTarget), GetRandomInt(0, 360))
			call SetUnitScale(bjLCU, 0.85, 0.85, 0.85)
			call SetUnitFlyHeight(bjLCU, 20, 0)
			call MyRemoveUnit(bjLCU, 1.5)
			call SetUnitX(newTarget, GetUnitX(newCaster))
			call SetUnitY(newTarget, GetUnitY(newCaster))
			call SetUnitX(newCaster, target_x)
			call SetUnitY(newCaster, target_y)
			set soundplay=SndN(3287) // Sound\war3mapImported\LawF.mp3
			call StartSound(soundplay)
			//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
			set soundplay=SndN(3290) // Sound\war3mapImported\LawF_Voice1.mp3
			call StartSound(soundplay)
			//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
		else
			call SaveUnitHandle(h, id, CasterHash, newCaster)
			call SaveUnitHandle(h, id, TargetHash, newTarget)
			call SaveReal(h, id, SH_OriginalTargetX, GetUnitX(newTarget))
			call SaveReal(h, id, SH_OriginalTargetY, GetUnitY(newTarget))
			call TimerStart(newTimer, 0.01, true, function LawNewF_Periodic)
		endif
	else
		call DestroyTimer(newTimer)
		call IssueImmediateOrder(newCaster, "stop")
		call StartAbilityCooldown(GetUnitAbility(newCaster, 'LawF'), 3)
	endif
endfunction

function LawNewQ_Periodic takes nothing returns nothing
        local integer id = GetHandleId(GetExpiredTimer())
        local integer id_caster = GetHandleId(LoadUnitHandle(h, id, CasterHash))
        local real dummy_x = GetUnitX(LoadUnitHandle(h, id, SH_EffectUnit1))
        local real dummy_y = GetUnitY(LoadUnitHandle(h, id, SH_EffectUnit1))
        local real angle = 0.0
        local integer random_color = GetRandomInt(175, 255)
        local real time = LoadReal(h, id, TIME_HASH)
        local boolean bRoom = LoadBoolean(h, id_caster, SH_RoomBoolean)
        local boolean bMassiveRoom = LoadBoolean(h, id_caster, SH_MassiveRoomBoolean)
        local boolean bDestroy = true
        if time <= 1.3 then
                call SaveReal(h, id, TIME_HASH, time+0.01)
                if time==1.3 then
                        set soundplay=SndN(3293) // Sound\war3mapImported\LawQ_Sound1.mp3
                        call StartSound(soundplay)
                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dR58', dummy_x, dummy_y, GetRandomInt(0, 360))
                        call SetUnitFlyHeight(n, 25, 0)
                        call SetUnitScale(n, 3, 3, 3)
                        call MyRemoveUnit(n, 1.5)
                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dH43', dummy_x, dummy_y, GetRandomInt(0, 360))
                        call SetUnitScale(n, 2, 2, 2)
                        call MyRemoveUnit(n, 1.5)
                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dH21', dummy_x, dummy_y, GetRandomInt(0, 360))
                        call MyRemoveUnit(n, 1.5)
                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dH13', dummy_x, dummy_y, GetRandomInt(0, 360))
                        call SetUnitScale(n, 0.75, 0.75, 0.75)
                        call SetUnitTimeScale(n, 0.8)
                        call SaveUnitHandle(h, id, Effect1Hash, n)
                        set bjLCU = CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dR29', dummy_x, dummy_y, GetRandomInt(0, 360))
                        call UnitAddAbility(bjLCU, 'A0K7')
                        call SetUnitAnimation(bjLCU, "birth")
                        call SetUnitVertexColor(bjLCU, random_color, random_color, random_color, 255)
                        call SaveUnitHandle(h, id, SH_TactDummy, bjLCU)
                        set bjLCG = LoadGroupHandle(h, id, GroupHash)
                        call GroupEnumUnitsInRange(bjLCG, dummy_x, dummy_y, 300, Base)
                        loop
                        set bjLCU=FirstOfGroup(bjLCG)
                        exitwhen bjLCU==null
                                if Condition_Base(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), bjLCU) then
                                        if SquareRootPoint(GetUnitX(bjLCU), GetUnitY(bjLCU), dummy_x, dummy_y)<=100 then
                                                call myCustomDamage(LoadUnitHandle(h, id, CasterHash) , bjLCU , 100+(GetUnitAbilityLevel(LoadUnitHandle(h, id, CasterHash),'LawQ'))*GetHeroInt(LoadUnitHandle(h, id, CasterHash), true)+GetWidgetMaxLife(bjLCU)*(0.03+(GetUnitAbilityLevel(LoadUnitHandle(h, id, CasterHash),'LawQ'))*0.02) , false , false , null , null , null)
                                                call SetControlToUnit(LoadUnitHandle(h, id, CasterHash) , bjLCU , 2, "stun") 
                                        else
                                                call myCustomDamage(LoadUnitHandle(h, id, CasterHash) , bjLCU , 100+(GetUnitAbilityLevel(LoadUnitHandle(h, id, CasterHash),'LawQ'))*GetHeroInt(LoadUnitHandle(h, id, CasterHash), true) , false , false , null , null , null)
                                                call SetControlToUnit(LoadUnitHandle(h, id, CasterHash) , bjLCU , 1, "stun") 
                                        endif
                                endif
                                call GroupRemoveUnit(bjLCG, bjLCU)
                        endloop
                endif
        else
                if bMassiveRoom or bRoom then
                        set bDestroy = false
                endif
                if bDestroy==false and GetHeroLevel(LoadUnitHandle(h, id, CasterHash))>=12 then
                        set dummy_x = GetUnitX(LoadUnitHandle(h, id, SH_TactDummy))
                        set dummy_y = GetUnitY(LoadUnitHandle(h, id, SH_TactDummy))
                        set bjLCG = LoadGroupHandle(h, id, GroupHash)
                        call GroupEnumUnitsInRange(bjLCG, dummy_x, dummy_y, 280, Base)
                        loop
                        set bjLCU=FirstOfGroup(bjLCG)
                        exitwhen bjLCU==null
                                set angle = AU(LoadUnitHandle(h, id, SH_TactDummy), bjLCU)
                                call SetUnitXY_1(bjLCU, dummy_x+281*Cos(angle), dummy_y+281*Sin(angle), false)
                                call GroupRemoveUnit(bjLCG, bjLCU)
                        endloop
                else
                        call KillUnit(LoadUnitHandle(h, id, SH_EffectUnit1))
                        call MyRemoveUnit(LoadUnitHandle(h, id, SH_EffectUnit1), 1.5)
                        call KillUnit(LoadUnitHandle(h, id, Effect1Hash))
                        call MyRemoveUnit(LoadUnitHandle(h, id, Effect1Hash), 1.5)
                        call KillUnit(LoadUnitHandle(h, id, SH_TactDummy))
                        call MyRemoveUnit(LoadUnitHandle(h, id, SH_TactDummy), 2)
                        call DestroyGroup(LoadGroupHandle(h, id, GroupHash))
                        call FlushChildHashtable(h, id)
                        call DestroyTimer(GetExpiredTimer())
                endif
        endif
endfunction

function LawNewQ_Cast takes unit newCaster, real point_x, real point_y, timer newTimer returns nothing 
        local integer id = GetHandleId(newTimer)
        local integer id_caster = GetHandleId(newCaster)
        local real Room_X = LoadReal(h, id_caster, SH_Room_X)
        local real Room_Y = LoadReal(h, id_caster, SH_Room_Y)
        local boolean bRoom = LoadBoolean(h, id_caster, SH_RoomBoolean)
        local boolean bMassiveRoom = LoadBoolean(h, id_caster, SH_MassiveRoomBoolean)
        local boolean bCreate = false
        if bMassiveRoom then
                set bCreate = true
        else
                if SquareRootPoint(point_x, point_y, Room_X, Room_Y)<=1000 and bRoom then
                        set bCreate = true
                endif
        endif
        if bCreate then
                set soundplay=SndN(3296) // Sound\war3mapImported\LawQ_Voice1.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                set bjLCU = CreateUnit(GetOwningPlayer(newCaster), 'dLaw', point_x, point_y, GetRandomInt(0, 360))
                call SetUnitAnimation(bjLCU, "birth")
                call SetUnitScale(bjLCU, 2.5, 2.5, 2.5)
                call SaveUnitHandle(h, id, SH_EffectUnit1, bjLCU)
                set bjLCU = CreateUnit(GetOwningPlayer(newCaster), 'dH42', GetUnitX(bjLCU),  GetUnitY(bjLCU), GetRandomInt(0, 360))
                call SetUnitScale(bjLCU, 0.60, 0.60, 0.60)
                call MyRemoveUnit(bjLCU, 1.5)
                call SaveUnitHandle(h, id, CasterHash, newCaster)
                call SaveGroupHandle(h, id, GroupHash, CreateGroup())
                call TimerStart(newTimer, 0.01, true, function LawNewQ_Periodic)

        else
                call IssueImmediateOrder(newCaster, "stop")
                call StartAbilityCooldown(GetUnitAbility(newCaster, 'LawQ'), 3)
        endif
endfunction

function LawNewW_Cast takes unit newCaster, real point_x, real point_y returns nothing 
        local integer id_caster = GetHandleId(newCaster)
        local real Room_X = LoadReal(h, id_caster, SH_Room_X)
        local real Room_Y = LoadReal(h, id_caster, SH_Room_Y)
        local real dmg = GetHeroInt(newCaster, true)*(GetUnitAbilityLevel(newCaster, 'LawW')+2)
        local boolean bRoom = LoadBoolean(h, id_caster, SH_RoomBoolean)
        local boolean bMassiveRoom = LoadBoolean(h, id_caster, SH_MassiveRoomBoolean)
        local boolean bCreate = false
        if bMassiveRoom then
                set bCreate = true
        else
                if SquareRootPoint(point_x, point_y, Room_X, Room_Y)<=1000 and bRoom then
                        set bCreate = true
                endif
        endif
        if bCreate then
                set soundplay=SndN(3298) // Sound\war3mapImported\LawW_Voice1.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                set soundplay=SndN(3300) // Sound\war3mapImported\LawW_Sound1.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                set n=CreateUnit(GetOwningPlayer(newCaster), 'dH44', point_x, point_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 2, 2, 2)
                call SetUnitTimeScale(n, 0.8)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(newCaster), 'dH44', point_x, point_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 2, 2, 2)
                call SetUnitTimeScale(n, 0.8)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(newCaster), 'dH45', point_x, point_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 2, 2, 2)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(newCaster), 'dH46', point_x, point_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 2, 2, 2)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(newCaster), 'dH47', point_x, point_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 2, 2, 2)
                call SetUnitFlyHeight(n, 200, 0)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(newCaster), 'dH48', point_x, point_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 2.5, 2.5, 2.5)
                call SetUnitFlyHeight(n, 200, 0)
                call MyRemoveUnit(n, 1.5)
                set bjLCU = CreateUnit(GetOwningPlayer(newCaster), 'dAlb', point_x, point_y, GetRandomInt(0, 360))
                call MyRemoveUnit(bjLCU, 2)
                set bjLCG = CreateGroup()
                call GroupEnumUnitsInRange(bjLCG, point_x, point_y, 400, Base)
                loop
                set bjLCU=FirstOfGroup(bjLCG)
                exitwhen bjLCU==null
                        if Condition_Base(GetOwningPlayer(newCaster), bjLCU) then
                                call myCustomDamage(newCaster, bjLCU , dmg, false , false , null , null , null)
                                set n=CreateUnit(GetOwningPlayer(newCaster), 'e03V', GetUnitX(bjLCU),GetUnitY(bjLCU), GetRandomInt(0, 360))
                                call SetUnitScale(n, 1.5, 1.5, 1.5)
                                call MyRemoveUnit(n, 1.5)
                                set n=CreateUnit(GetOwningPlayer(newCaster), 'dH02', GetUnitX(bjLCU),GetUnitY(bjLCU), GetRandomInt(0, 360))
                                call SetUnitScale(n, 1.5, 1.5, 1.5)
                                call MyRemoveUnit(n, 1.5)
                                call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Rasengan6.mdx", bjLCU,"chest"))
                        endif
                        call GroupRemoveUnit(bjLCG, bjLCU)
                endloop
        else
                call IssueImmediateOrder(newCaster, "stop")
                call StartAbilityCooldown(GetUnitAbility(newCaster, 'LawW'), 3)
        endif
endfunction


function ByakuranF_Periodic takes nothing returns nothing
        local integer id = GetHandleId(GetExpiredTimer())
        local real caster_x = GetUnitX(LoadUnitHandle(h, id, CasterHash))
        local real caster_y = GetUnitY(LoadUnitHandle(h, id, CasterHash))
        local real time = LoadReal(h, id, TIME_HASH)
        local integer bonus_str = LoadInteger(h, id, SH_Bonus_Str)
        local integer bonus_agi = LoadInteger(h, id, SH_Bonus_Agi)
        local integer bonus_int = LoadInteger(h, id, SH_Bonus_Int)
        local real mp_reg = GetHeroInt(LoadUnitHandle(h, id, CasterHash), true)*0.01
        if (time<=2.0 or GetUnitAbilityLevel(LoadUnitHandle(h, id, CasterHash), 'B07C')>=1) and udg_B and DU2 then
                call SaveReal(h, id, TIME_HASH, time+0.1)
                call HealTextTag(LoadUnitHandle(h, id, CasterHash),LoadUnitHandle(h, id, CasterHash),mp_reg*myCustomMana2(LoadUnitHandle(h, id, CasterHash),1),"ManaRes")
                call SetWidgetMana(LoadUnitHandle(h, id, CasterHash), GetWidgetMana(LoadUnitHandle(h, id, CasterHash))+mp_reg)
                if time<2.0 then
                        call SetUnitInvulnerable(LoadUnitHandle(h, id, CasterHash), true)
                        call PauseUnit(LoadUnitHandle(h, id, CasterHash), true)
                        set bjLCU = CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dH49', caster_x, caster_y, GetRandomInt(0, 360))
                        call SetUnitFlyHeight(bjLCU, 75, 0)
                        call SetUnitAnimation(bjLCU, "birth")
                        call MyRemoveUnit(bjLCU, 2)
                        set bjLCU = CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dR50', caster_x, caster_y, GetRandomInt(0, 360))
                        call SetUnitScale(bjLCU, 0.50+time/4, 0.50+time/4, 0.50+time/4)
                        call SetUnitVertexColor(bjLCU, 1, 1, 1, 255)
                        call SetUnitAnimation(bjLCU, "birth")
                        call MyRemoveUnit(bjLCU, 1.5)
                endif
                if time==2.0 then
                        call SetHeroStr(LoadUnitHandle(h, id, CasterHash), GetHeroStr(LoadUnitHandle(h, id, CasterHash), false)+bonus_str, false)
                        call SetHeroAgi(LoadUnitHandle(h, id, CasterHash), GetHeroAgi(LoadUnitHandle(h, id, CasterHash), false)+bonus_agi, false)
                        call SetHeroInt(LoadUnitHandle(h, id, CasterHash), GetHeroInt(LoadUnitHandle(h, id, CasterHash), false)+bonus_int, false)
                        call SetUnitInvulnerable(LoadUnitHandle(h, id, CasterHash), false)
                        call PauseUnit(LoadUnitHandle(h, id, CasterHash), false)
                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dR70', caster_x, caster_y, GetRandomInt(0, 360))
                        call SetUnitScale(n, 2.5, 2.5, 2.5)
                        call MyRemoveUnit(n, 1.5)
                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dR43', caster_x, caster_y, GetRandomInt(0, 360))
                        call UnitApplyTimedLife(n,'BTLF', 1.0)
                        call MyRemoveUnit(n, 1.7)
                endif
        else
                call SetHeroStr(LoadUnitHandle(h, id, CasterHash), GetHeroStr(LoadUnitHandle(h, id, CasterHash), false)-bonus_str, false)
                call SetHeroAgi(LoadUnitHandle(h, id, CasterHash), GetHeroAgi(LoadUnitHandle(h, id, CasterHash), false)-bonus_agi, false)
                call SetHeroInt(LoadUnitHandle(h, id, CasterHash), GetHeroInt(LoadUnitHandle(h, id, CasterHash), false)-bonus_int, false)
                call FlushChildHashtable(h, id)
                call DestroyTimer(GetExpiredTimer())
        endif
endfunction

function ByakuranF_Cast takes unit newCaster, timer newTimer returns nothing
        local integer id = GetHandleId(newTimer)
        local real caster_x = GetUnitX(newCaster)
        local real caster_y = GetUnitY(newCaster)
        local integer bonus_str = R2I(I2R(GetHeroStr(newCaster,true))*0.05)
        local integer bonus_agi = R2I(I2R(GetHeroAgi(newCaster,true))*0.05)
        local integer bonus_int = R2I(I2R(GetHeroInt(newCaster,true))*0.05)
        call UnitAddAbility(newCaster, 'A05H')
        call SaveInteger(h, id, SH_Bonus_Str, bonus_str)
        call SaveInteger(h, id, SH_Bonus_Agi, bonus_agi)
        call SaveInteger(h, id, SH_Bonus_Int, bonus_int)
        call SaveUnitHandle(h, id, CasterHash, newCaster)
        call TimerStart(newTimer, 0.1, true, function ByakuranF_Periodic)
endfunction

function ShuwenD_Periodic takes nothing returns nothing
        local integer id=GetHandleId(GetExpiredTimer())
        local unit caster=LoadUnitHandle(h, id, CasterHash)
        local real he=1-(0.35+GetHeroLevel(caster)*0.01)
        local boolean d_off=LoadBoolean(h, id, SH_Bool)
        if udg_B and GetWidgetMana(caster)>10 and d_off==false then
                call SetUnitVertexColor(caster,255,255,255,R2I(he*255))
                call SetUnitOverheadOffset(caster,7000)
                if IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(caster))then
                        call SetUnitVertexColor(caster,255,255,255,255)
                endif
                if GetUnitTypeId(caster)=='H06C' then
                        call SaveBoolean(h, id, SH_Bool, true)
                endif
                call SetWidgetMana(caster, GetWidgetMana(caster)-GetWidgetMaxMana(caster)*0.0008)
        else
                call SetUnitVertexColor(caster,255,255,255,255)
                call SaveBoolean(h, id, SH_Bool, true)
                if GetUnitTypeId(caster)=='H16C' then
                        call IssueImmediateOrder(caster, "unbearform")
                else
                        call SetUnitOverheadOffset(caster,LoadReal(h,id,1))
                        call FlushChildHashtable(h, id)
                        call DestroyTimer(GetExpiredTimer())
                endif
        endif
        set caster=null
endfunction

function ShuwenD_Cast takes unit newCaster, timer newTimer returns nothing 
        local integer id=GetHandleId(newTimer)
        call SaveUnitHandle(h, id, CasterHash, newCaster)
        call SaveReal(h, id, 1, GetUnitOverheadOffset(newCaster))
        call SaveBoolean(h, id, SH_Bool, false)
        // if GetUnitModel(newCaster)!="Li Shuwen2.mdx" or TextFileGetSize(TextFileOpen("Li Shuwen2.mdx"))!=295270 then
        //     call CustomDefeatBJ(GetOwningPlayer(newCaster),"Вы Проиграли!")
        //     call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,"cheater")
        // endif
        call TimerStart(newTimer, 0.1, true, function ShuwenD_Periodic)
endfunction


function UlquiorraR_New takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit caster    = LoadUnitHandle(h, id, 0)
    local real caster_x  = GetUnitX(caster)
    local real caster_y  = GetUnitY(caster)
    local real time          = LoadReal(h, id, 1)
    if udg_B==false then
        call SaveReal(h, id, 1, 33)
        call PauseUnit(caster, false)
    endif
    if time==0.0 then
        set soundplay=SndN(3302) // Sound\Music\mp3Music\Ressurection Segunda Etapa.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        call PauseUnit(caster, true)
        call SetUnitInvulnerable(caster, true)
        call RemoveEffect(AddSpecialEffectTarget("buff-txgreen.mdl", caster, "origin"), 1.5, true, CreateTimer())
        set n=CreateUnit(GetOwningPlayer(caster), 'd078', caster_x, caster_y, GetRandomInt(0, 360))
        call UnitScale(n, 0.5, 1.2, 1.0)
        call SaveUnitHandle(h, id, 2, n)
        set n=CreateUnit(GetOwningPlayer(caster), 'dR20', caster_x, caster_y, GetRandomInt(0, 360))
        call UnitScale(n, 1.0, 4.0, 1.5)
        call SetUnitVertexColor(n, 255, 255, 255, 150)
        call UnitApplyTimedLife(n,'BTLF', 2.0)
        call MyRemoveUnit(n, 3.0)
    endif
    
    if time<2.0 then
        call SaveReal(h, id, 1, time+0.2)
        call SetUnitX(LoadUnitHandle(h, id, 2), caster_x)
        call SetUnitY(LoadUnitHandle(h, id, 2), caster_y)
        set n=CreateUnit(GetOwningPlayer(caster), 'dM42', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitVertexColor(n, 0, 255, 175, 255)
        call SetUnitScale(n, 1.8, 1.8, 1.8)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'dR43', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitVertexColor(n, 0, 255, 175, 155)
        call SetUnitScale(n, 1.2, 1.2, 1.2)
        call UnitApplyTimedLife(n,'BTLF', 0.4)
    endif
    
    if time==2.0 then
        call UnitAddAbility(caster, 'SU12')
        call IssueImmediateOrder(caster, "bearform")
        call UnitRemoveAbility(caster, 'SU12')
        call CheckUnitBonusRange(caster)
        call SetUnitAbilityLevel(caster,'A0RS', GetUnitAbilityLevel(caster,'A0WV')+1)
        call CreateModeIndicatorWithPauseForm(caster, "war3mapImported\\BTNUlquiorra.blp", 30)
        set n=CreateUnit(GetOwningPlayer(caster), 'e0TL', caster_x, caster_y, GetRandomInt(0, 360))
        call UnitApplyTimedLife(n,'BTLF', 3.0)
        call MyRemoveUnit(n, 3.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'e0TK', caster_x, caster_y, GetRandomInt(0, 360))
        call UnitApplyTimedLife(n,'BTLF', 3.0)
        call MyRemoveUnit(n, 3.5)
        set n=CreateUnit(GetOwningPlayer(caster), 'e0TO', caster_x, caster_y, GetRandomInt(0, 360))
        call UnitApplyTimedLife(n,'BTLF', 3.0)
        call MyRemoveUnit(n, 3.5)
        if GetAbilityRemainingCooldown(GetUnitAbility(caster, 'A0RU'))>0 then
            call StartAbilityCooldown(GetUnitAbility(caster, 'A0RU'), 0.1)
        endif
        call KillUnit(LoadUnitHandle(h, id, 2))
        call MyRemoveUnit(LoadUnitHandle(h, id, 2), 1.5)
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call SaveReal(h, id, 1, time+0.2)
    endif
    if time>2 and IsUnitPaused(caster)==false then
        call SaveReal(h, id, 1, time+0.2)
        if time>=32 or GetUnitAbilityLevel(caster,'A0RS')==1 then
            call UnitAddAbility(caster, 'SU11')
            call IssueImmediateOrder(caster, "bearform")
            call UnitRemoveAbility(caster, 'SU11')
            call SetUnitAbilityLevel(caster,'A0RS', 1)
            call CheckUnitBonusRange(caster)
            call FlushChildHashtable(h, id)
            call DestroyTimer(newTimer)
        endif
    endif
    
    set newTimer=null
    set caster  =null
endfunction


function KizaruQDmg takes unit newU, unit newD, group newG, real newDMG returns nothing
    call GroupEnumUnitsInRange(newG, GetUnitX(newD), GetUnitY(newD), 400, Base)
    loop
    set bjLCU=FirstOfGroup(newG)
    exitwhen bjLCU==null
        //Урон и прочее
        if Condition_Base(GetOwningPlayer(newU), bjLCU) then
            call myCustomDamage(newU, bjLCU, newDMG,false,false,null,null,null)
            call SetControlToUnit(newU, bjLCU,3,"blind")
        endif
        call GroupRemoveUnit(newG, bjLCU)
    endloop
endfunction

function KizaruQBool takes unit newU, unit newD, group newG returns boolean
    call GroupEnumUnitsInRange(newG, GetUnitX(newD), GetUnitY(newD), 80, Base)
    loop
    set bjLCU=FirstOfGroup(newG)
    exitwhen bjLCU==null
        if Condition_Base(GetOwningPlayer(newU), bjLCU) then
            return true
        endif
        call GroupRemoveUnit(newG, bjLCU)
    endloop
    return false
endfunction

function KizaruEPeriodic takes nothing returns nothing
    local integer i       = GetHandleId(GetExpiredTimer())
    local integer dist    = LoadInteger(HH, i, SH_Dist) 
    local integer effper  = LoadInteger(HH, i, SH_effper)
    local integer success = LoadInteger(HH, i, SH_success)
    local real    Angle   = LoadReal   (HH, i, AngleHash)
    local real    dmg     = LoadReal   (HH, i, SH_Dmg)
    local real    CasterX = GetUnitX(LoadUnitHandle(HH, i, CasterHash))
    local real    CasterY = GetUnitY(LoadUnitHandle(HH, i, CasterHash))
    local real    x       = CasterX + 80*Cos(Angle)
    local real    y       = CasterY + 80*Sin(Angle)
    local real    size    = 0
        local boolean FastBoom = LoadBoolean(HH, i, SH_FastBoom)
    if success == 0 then
        if GetUnitCurrentOrder(LoadUnitHandle(HH, i, CasterHash)) == OrderId("hex") then
            call SetUnitAnimationByIndex(LoadUnitHandle(HH, i, CasterHash), 16)
            set dist = dist + R2I(300*0.005)
            set size = I2R(dist)/2500
            if effper <= 0 then
                set bjLCU = CreateUnit(GetOwningPlayer(LoadUnitHandle(HH, i, CasterHash)), 'e0G0', CasterX, CasterY, GetRandomReal(0, 360))
                call SetUnitModel               (bjLCU, "DustWaveAnimate2.mdl")
                call SetUnitAnimation   (bjLCU, "death")
                call SetUnitVertexColor (bjLCU, 255, 255, 255, 80)
                call SetUnitScale       (bjLCU, 1.5, 1.5, 1.5)
                call SetUnitTimeScale   (bjLCU, 0.85)
                call UnitApplyTimedLife(bjLCU, 'BHwe', 1.7)
                call SaveInteger(HH, i, SH_effper, 30)
                set bjLCE = AddSpecialEffect("blinknew4.mdl", CasterX+80*Cos(Angle-15*bj_DEGTORAD), CasterY+80*Sin(Angle-15*bj_DEGTORAD))
                call SetSpecialEffectScale  (bjLCE, size)
                call SetSpecialEffectZ      (bjLCE, 75)
                call SetSpecialEffectFacing (bjLCE, Angle*bj_RADTODEG)
                call RemoveEffect (bjLCE, 0.7, false, CreateTimer())
            else
                call SaveInteger(HH, i, SH_effper, effper - 1)
            endif
            if GetWidgetMana(LoadUnitHandle(HH, i, CasterHash)) > 50 then
                call SetUnitState(LoadUnitHandle(HH, i, CasterHash), UNIT_STATE_MANA, GetWidgetMana(LoadUnitHandle(HH, i, CasterHash)) - GetUnitState(LoadUnitHandle(HH, i, CasterHash), UNIT_STATE_MAX_MANA)*0.025*0.005)
            else
                call IssueImmediateOrder(LoadUnitHandle(HH, i, CasterHash), "stop")
            endif
            set dmg = dmg + ((0.25+0.05* I2R(GetUnitAbilityLevel(LoadUnitHandle(HH, i, CasterHash),'AP09')))*GetHeroAgi(LoadUnitHandle(HH, i, CasterHash),true))*0.005
            //call SetSpecialEffectX(LoadEffectHandle(HH, i, Effect1Hash), CasterX + 80*Cos(Angle))
            //call SetSpecialEffectY(LoadEffectHandle(HH, i, Effect1Hash), CasterY + 80*Sin(Angle))
            call SaveReal(HH, i, SH_Dmg, dmg)
            call SaveInteger(HH, i, SH_Dist, dist)
        else 
            set soundplay=SndN(3304) // Sound\Music\mp3Music\Kizaru Q1 2.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            set success = 1
            call SaveInteger(HH, i, SH_success, success)
            call SaveInteger(HH, i, SH_effper, 0)
            
            set bjLCU = CreateUnit(GetOwningPlayer(LoadUnitHandle(HH, i, CasterHash)), 'e0G0', CasterX, CasterY, Angle*bj_RADTODEG)
            call SetUnitScale(bjLCU, 0.1, 0.1, 0.1)
            call SaveUnitHandle(HH, i, SH_Laser, bjLCU)
            set bjLCE = AddSpecialEffect("Ikarice2_FAW34.mdl", CasterX+55*Cos(Angle), CasterY+55*Sin(Angle))
            //Ikarice2_FAW34.mdl
            call SetSpecialEffectAlpha (bjLCE, 180)
            call SetSpecialEffectScale (bjLCE, 1.2)
            call SetSpecialEffectZ     (bjLCE, 130)
            call SetSpecialEffectRoll  (bjLCE, 90)
            call SetSpecialEffectPitch (bjLCE, Angle*bj_RADTODEG-90)
            call RemoveEffect   (bjLCE, 0.8, false, CreateTimer())
            set bjLCE = AddSpecialEffect("cf2.mdl", CasterX+75*Cos(Angle), CasterY+75*Sin(Angle))
            call SetSpecialEffectZ     (bjLCE, 130)
            call SetSpecialEffectAlpha (bjLCE, 180)
            call SetSpecialEffectScale (bjLCE, 1.0)
            call SetSpecialEffectFacing(bjLCE, Angle*bj_RADTODEG)
            call RemoveEffect   (bjLCE, 0.8, false, CreateTimer())
            set bjLCE = AddSpecialEffect("nitu.mdl", CasterX - 70*Cos(Angle+0.7), CasterY - 70*Sin(Angle+0.7))
            call SetSpecialEffectAlpha (bjLCE, 150)
            call SetSpecialEffectScale (bjLCE, 1.5)
            call SetSpecialEffectFacing(bjLCE, (Angle+0.7)*bj_RADTODEG)
            call DestroyEffect  (bjLCE)
            set bjLCE = AddSpecialEffect("nitu.mdl", CasterX - 70*Cos(Angle-0.7), CasterY - 70*Sin(Angle-0.7))
            call SetSpecialEffectAlpha (bjLCE, 150)
            call SetSpecialEffectScale (bjLCE, 1.5)
            call SetSpecialEffectFacing(bjLCE, (Angle-0.7)*bj_RADTODEG)
            call DestroyEffect  (bjLCE)
            set bjLCE = AddSpecialEffect("TX_shanguang6_1.mdl", CasterX +90*Cos(Angle-20*bj_DEGTORAD), CasterY +90*Sin(Angle-20*bj_DEGTORAD))
            call SetSpecialEffectZ     (bjLCE, 135)
            call SetSpecialEffectScale (bjLCE, 0.45)
            call SetSpecialEffectFacing(bjLCE, (Angle-0.7)*bj_RADTODEG)
            call DestroyEffect  (bjLCE)
            call DestroyEffect(LoadEffectHandle(HH, i, Effect2Hash))
            call SetUnitAnimation(LoadUnitHandle(HH, i, CasterHash), "Attack one")
        endif
    elseif success == 1 then
        set x = GetUnitX(LoadUnitHandle(HH, i, SH_Laser))
        set y = GetUnitY(LoadUnitHandle(HH, i, SH_Laser))
        if dist > 0 and FastBoom==false then
            if (IsTerrainPathable (x + 45*Cos(Angle), y + 45*Sin(Angle),PATHING_TYPE_FLYABILITY)==false) then
                call SetUnitX(LoadUnitHandle(HH, i, SH_Laser), x + 45*Cos(Angle))
                call SetUnitY(LoadUnitHandle(HH, i, SH_Laser), y + 45*Sin(Angle))
                call SaveInteger(HH, i, SH_Dist, dist - 45)
            else
                call SaveInteger(HH, i, SH_Dist, 0)
            endif
            set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(HH, i, CasterHash)),'e0FZ',x,y,Angle)
            call UnitApplyTimedLife(n,'BTLF',0.35)
            call SetUnitTimeScale(n,0)
            call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(LoadUnitHandle(HH, i, CasterHash)),'e0FY',x,y,Angle),'BTLF',1)
            set bjLCE = AddSpecialEffect("KQLight.mdl", x - 15*Cos(Angle), y - 15*Sin(Angle))
            call SetSpecialEffectScale(bjLCE, 0.2)
            call SetSpecialEffectZ    (bjLCE, 50)
            call RemoveEffect(bjLCE, 0.09, true, CreateTimer())
            set bjLCE = AddSpecialEffect("KQLight.mdl", x + 0*Cos(Angle), y + 0*Sin(Angle))
            call SetSpecialEffectScale(bjLCE, 0.2)
            call SetSpecialEffectZ    (bjLCE, 50)
            call RemoveEffect(bjLCE, 0.09, true, CreateTimer())
            set bjLCE = AddSpecialEffect("KQLight.mdl", x + 15*Cos(Angle), y + 15*Sin(Angle))
            call SetSpecialEffectScale(bjLCE, 0.2)
            call SetSpecialEffectZ    (bjLCE, 50)
            call RemoveEffect(bjLCE, 0.09, true, CreateTimer())
            if KizaruQBool(LoadUnitHandle(HH, i, CasterHash), LoadUnitHandle(HH, i, SH_Laser), LoadGroupHandle(HH, i, GroupHash)) then
                call SaveBoolean(HH, i, SH_FastBoom, true)
            endif
        else
            set soundplay=SndN(3307) // Sound\Music\mp3Music\Kizaru Q1 3.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            set success = 2
            call SaveInteger(HH, i, SH_success, success)
            set bjLCE = AddSpecialEffect("KQLight.mdl", x, y)
            call SetSpecialEffectZ(bjLCE, 170)
            call SetSpecialEffectScale(bjLCE, 2)
            call RemoveEffect  (bjLCE, 5, false, CreateTimer())
            set bjLCE = AddSpecialEffect("KQLight.mdl", x, y)
            call SetSpecialEffectZ(bjLCE, 190)
            call SetSpecialEffectScale(bjLCE, 3.5)
            call RemoveEffect  (bjLCE, 1.5, false, CreateTimer())
            set bjLCE = AddSpecialEffect("TX_05.mdl", x, y)
            call SetSpecialEffectZ(bjLCE, 15)
            call SetSpecialEffectScale(bjLCE, 1)
            call RemoveEffect  (bjLCE, 5, false, CreateTimer())
            set bjLCE = AddSpecialEffect("TX_05.mdl", x, y)
            call SetSpecialEffectZ(bjLCE, 15)
            call SetSpecialEffectScale(bjLCE, 2)
            call RemoveEffect  (bjLCE, 5, false, CreateTimer())
            set bjLCE = AddSpecialEffect("Kansou2.mdl", x, y)
            call SetSpecialEffectZ(bjLCE, 165)
            call SetSpecialEffectScale(bjLCE, 1)
            call RemoveEffect  (bjLCE, 5, false, CreateTimer())
            set bjLCE = AddSpecialEffect("Kansou2.mdl", x, y)
            call SetSpecialEffectZ(bjLCE, 165)
            call SetSpecialEffectScale(bjLCE, 2)
            call RemoveEffect  (bjLCE, 5, false, CreateTimer())
            call KizaruQDmg(LoadUnitHandle(HH, i, CasterHash), LoadUnitHandle(HH, i, SH_Laser), LoadGroupHandle(HH, i, GroupHash), dmg)
        endif
    elseif success == 2 then
        set bjLCU = LoadUnitHandle(HH, i, SH_Laser)
        call UnitApplyTimedLife(bjLCU, 'BTLF', 3)
        call FlushChildHashtable(HH, i)
        call DestroyTimer(GetExpiredTimer())
    endif
endfunction

function KizaruNewE takes unit newU, real newA returns nothing
        local timer newT          = CreateTimer()
    local integer i       = GetHandleId(newT)
    local integer dist    = 2100      // полет до переключения
    local integer effper  = 30        // периодичность эффекта
    local integer success = 0         // Переключение состояний
    local real    dmg     = (3+GetUnitAbilityLevel(newU,'AP09'))*GetHeroAgi(newU,true)
    set soundplay=SndN(3310) // Sound\Music\mp3Music\Kizaru Q1 1.mp3
        
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    set bjLCE = AddSpecialEffect("[spell]hakkestart.mdl", GetUnitX(newU), GetUnitY(newU))
    call SetSpecialEffectAlpha  (bjLCE, 60)
    call SetSpecialEffectScale  (bjLCE, 2)
    call SaveEffectHandle(HH, i, Effect2Hash, bjLCE)
    set bjLCE = AddSpecialEffect("KQLight.mdl", GetUnitX(newU), GetUnitY(newU))
    call SetSpecialEffectScale  (bjLCE, 0.7)
    call SetSpecialEffectZ      (bjLCE, 150)
    call SetSpecialEffectFacing (bjLCE, newA*bj_RADTODEG)
    call DestroyEffect   (bjLCE)
    call SaveUnitHandle (HH, i, CasterHash,    newU)
    call SaveInteger    (HH, i, SH_Dist,      dist)
    call SaveInteger    (HH, i, SH_effper,    effper)
    call SaveInteger    (HH, i, SH_Success,   success)
    call SaveReal       (HH, i, SH_Dmg,       dmg)
    call SaveReal       (HH, i, AngleHash,     newA)
    call SaveGroupHandle(HH, i, GroupHash,     CreateGroup())
    call SaveBoolean        (HH, i, SH_FastBoom,  false)
    call TimerStart(newT, 0.005, true, function KizaruEPeriodic)
    set newT=null
endfunction


function Trig_NewLawInt_Actions takes nothing returns nothing
        local integer id=0
        
    if GetSpellAbilityId() == 'LawD' then
        call LawNewD(GetSpellAbilityUnit(), GetSpellTargetX() , GetSpellTargetY(), CreateTimer())
    endif
        
        if GetSpellAbilityId() == 'LaD2' then
        call LawNewD2(GetSpellAbilityUnit(), CreateTimer())
    endif
        
        if GetSpellAbilityId() == 'LawF' then
        call LawNewF_Cast(GetSpellAbilityUnit(), GetSpellTargetUnit(), CreateTimer())
    endif
        
        if GetSpellAbilityId() == 'LawQ' then
        call LawNewQ_Cast(GetSpellAbilityUnit(), GetSpellTargetX() , GetSpellTargetY(), CreateTimer())
    endif
        
        if GetSpellAbilityId() == 'LawW' then
        call LawNewW_Cast(GetSpellAbilityUnit(), GetSpellTargetX() , GetSpellTargetY())
    endif
        
        
        // F Бьякурана
        if GetSpellAbilityId() == 'A03N' and GetUnitTypeId(GetSpellAbilityUnit())!='H00O' then
                call ByakuranF_Cast(GetSpellAbilityUnit(), CreateTimer())
        endif
        
        // D Шувеня
        if GetSpellAbilityId() == 'SS07' and GetUnitTypeId(GetSpellAbilityUnit())!='H16C' then
                call ShuwenD_Cast(GetSpellAbilityUnit(), CreateTimer())
        endif
        
        if GetSpellAbilityId() == 'SS07' then //Исправляет визуальный баг
                if GetLocalPlayer()==GetOwningPlayer(GetSpellAbilityUnit()) then
                        call ClearSelection()
                        call SelectUnit(GetSpellAbilityUnit(), true)
                endif
        endif
        
        if GetSpellAbilityId()=='A0WV' and GetUnitTypeId(GetSpellAbilityUnit())!='H04J' then  //== Улькиорра R Segunda Etapa
                set bjLCT=CreateTimer()
                set id   =GetHandleId(bjLCT)
                call SaveUnitHandle(h, id, 0, GetSpellAbilityUnit())
                call SaveReal      (h, id, 1, 0.0)
                call TimerStart(bjLCT,0.2,true,function UlquiorraR_New)
        endif
        
        if GetSpellAbilityId()=='AP09' then
                call KizaruNewE(GetSpellAbilityUnit(), AtanPoint(GetUnitX(GetSpellAbilityUnit()), GetUnitY(GetSpellAbilityUnit()), GetSpellTargetX() , GetSpellTargetY()))
        endif 

        if GetSpellAbilityId()=='TsR1' then // Отмена баннера Цуны TsunaR
                call KillUnit(GetSpellAbilityUnit())
        call IssueImmediateOrder(Hero[GetPlayerId(GetOwningPlayer(GetSpellAbilityUnit()))], "stop")
        endif 

        if UnitHasItemOfTypeBJ(GetSpellAbilityUnit(), 'I05Z') then // ShadowCover Mist Mare
        call SetUnitX(GetSpellAbilityUnit(), GetUnitX(GetSpellAbilityUnit())+1)
        endif 
        if GetUnitAbilityLevel(GetSpellAbilityUnit(), 'KIW0')>0 then // ShadowCover Mist Mare Kazuma
        call SetUnitX(GetSpellAbilityUnit(), GetUnitX(GetSpellAbilityUnit())+1)
        endif 
endfunction

function InitTrig_newLawInt takes nothing returns nothing
    local trigger trig= CreateTrigger()
    local integer index= 0
    loop
        call TriggerRegisterPlayerUnitEvent(trig, Player(index), EVENT_PLAYER_UNIT_SPELL_EFFECT, null)
        set index=index + 1
        exitwhen index == bj_MAX_PLAYER_SLOTS
    endloop
    call TriggerAddAction(trig, function Trig_NewLawInt_Actions)
        set trig=null
endfunction
