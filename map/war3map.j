endfunction
function EJeanneCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,5)
local unit l__d=LoadUnitHandle(h,id,1)
local unit d2=LoadUnitHandle(h,id,4)
local real dmg=GetHeroInt(u,true)*3
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=LoadReal(h,id,3)
local real dist=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
if dist>0 and GetWidgetLife(c)>0 and LoadBoolean(h,GetHandleId(u),SH_JeanneAlterEact)==false then
call SetUnitXY_1(l__d,x1,y1, false)
call SetUnitX(d2,x1)
call SetUnitY(d2,y1)
call SaveReal(h,id,2,dist-0.02)
else

call SaveBoolean(h,GetHandleId(u),SH_JeanneAlterEact,false)

call UnitRemoveAbility(u,'JAE2')
call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A1D7',true)
call SetUnitAnimation(l__d,"stand")
set soundplay=SndN(2687) // Sound\Music\mp3Music\AlterJeanneSkill1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set n=CreateUnit(p,'e0ZT',x1,y1,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,255)
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(u,1)
call myCustomDamage(u,c,dmg+GetUnitState(c,UNIT_STATE_MAX_LIFE)*(0.005*GetUnitAbilityLevel(u,'A1D7')+0.025)*(8-dist),false,false,null,null,null)
call SetControlToUnit(u,c,2, "stun")
call KillUnit(l__d)
call KillUnit(d2)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set c=null
set d2=null
set l__d=null
set u=null
set p=null
set t=null
endfunction
function EJeanneCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real di=8
local real a=Atan2(y1-y,x1-x)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,5,c)
set n=CreateUnit(p,'e12D',x+25*Cos(a),y+25*Sin(a),a*bj_RADTODEG)
call UnitAddAbility(n,'A1D8')
call SaveUnitHandle(h,id,4,n)
call SaveReal(h,id,2,di)
call SaveReal(h,id,8,di)
call SaveReal(h,id,3,a)
call SetUnitTimeScale(u,1)
call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A1D7',false)
call UnitAddAbility(u,'JAE2')
call TimerStart(t,0.02,true,function EJeanneCast2)
set n=CreateUnit(p,'e12C',x+25*Cos(a),y+25*Sin(a),a*bj_RADTODEG)
call SaveUnitHandle(h,id,1,n)
call SetUnitAnimation(n,"birth")
set u=null
set p=null
set t=null
set c=null
endfunction
