//Jiraya TW
if LoadBoolean(HH,GetHandleId(u),StringHash("JirTB"))==true and GetHeroLevel(u)>=35 then
call JirayaTW(u,x1,y1)
endif


call TimerStart(t,0.025,true,function ChoOdamaRasenganCast2)
set u=null
set t=null
endfunction
