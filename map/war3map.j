endfunction
function SanzuReverShootCond takes nothing returns boolean
return GetSpellAbilityId()==0x41304337
endfunction
function SanzuReverShootCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local integer iud=0
local integer i=0
local real sc=1.5
if GetUnitTypeId(u)!='H06N' and GetUnitTypeId(u)!='H06O' then
set iud='e0F0'
set soundplay=SndN(1081) // Sound\Music\mp3Music\SanzuRiverShot.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
elseif GetUnitTypeId(u)=='H06N' or GetUnitTypeId(u)=='H06O' then
set iud='e13U'
set soundplay=SndN(1083) // Sound\Music\mp3Music\DrakeW.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set sc=0.5
call SetUnitAnimation(u,"Spell four")
endif
loop
exitwhen i>=2+GetUnitAbilityLevel(u,0x41304337)
set n=CreateUnit(p,iud,x,y,a*bj_RADTODEG)
call SetUnitScale(n,sc,sc,sc)
call SanzuReverShootFly(n,GetRandomReal(55,65),GetRandomReal(-1.6,1.6),x1,y1,GetRandomReal(25,300),200,GetHeroAgi(u,true))
set i=i+1
endloop
set u=null
set p=null
endfunction
