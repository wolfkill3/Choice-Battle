function SusanoMadaraCond takes nothing returns boolean
return GetSpellAbilityId()=='A0N0' or GetSpellAbilityId()=='A40C'
endfunction
function SusanoMadaraCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real l=GetWidgetLife(u)
local real m=GetWidgetMana(u)
local real lm=GetUnitState(u,UNIT_STATE_MAX_LIFE)
local real mm=GetUnitState(u,UNIT_STATE_MAX_MANA)
if GetUnitAbilityLevel(u,'ItV1')>0 and l>=lm*0.025 and m>=mm*0.025 and LoadBoolean(HH,GetHandleId(u),SST)==true  then
call SetUnitX(l__d,GetUnitX(u))
call SetUnitY(l__d,GetUnitY(u))
call SetUnitFacing(l__d,GetUnitFacing(u))
call SetUnitFlyHeight(l__d,GetUnitFlyHeight(u),0)
if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
call SetUnitState(u,UNIT_STATE_MANA,m-mm*0.03*0.03)
endif
else
set soundplay=SndN(1611) // Sound\Music\mp3Music\SharinganEnd.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SaveBoolean(HH,GetHandleId(u),SS,false)
call SaveBoolean(HH,GetHandleId(u),SST,false)
call ShowAbility2('A40C',false)
call ShowAbility2('A0N0',true)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call RemoveUnit(l__d)
call RemoveSavedHandle(h,GetHandleId(u),SH_immolation)
call UnitRemoveAbility(u,'ItV1')
endif
set u=null
set l__d=null
set t=null
endfunction
function SusanoMadaraCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
if GetSpellAbilityId()=='A0N0' then
call SaveUnitHandle(h,id,0,u)
call ShowAbility2Timed('A0N0',false,0.3)
call ShowAbility2Timed('A40C',true,0.32)
call UnitAddAbility(u,'ItV1')
call SaveBoolean(HH,GetHandleId(u),SST,true)
set soundplay=SndN(1614) // Sound\Music\mp3Music\SusanoMadara.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
call SaveBoolean(HH,GetHandleId(u),SST,false)
call ShowAbility2('A40C',false)
call ShowAbility2('A0N0',true)
call UnitRemoveAbility(u,'ItV1')
endif
if LoadBoolean(HH,GetHandleId(u),SS)==false then
    call SaveBoolean(HH,GetHandleId(u),SS,true)
    set n=CreateUnit(GetOwningPlayer(u),'e0KQ',GetUnitX(u),GetUnitY(u),GetUnitFacing(u))
    call SetUnitTimeScale(n,2)
    call SetUnitVertexColor(n,200,200,255,150)
    call SetUnitAnimation(n,"Birth")
    call SaveUnitHandle(h,id,1,n)
    call SaveUnitHandle(h,GetHandleId(u),SH_immolation,n)
    call TimerStart(t,0.03,true,function SusanoMadaraCast2)
endif
set u=null
set t=null
endfunction
function SusanoMadaraInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function SusanoMadaraCast)
call TriggerAddCondition(t,Condition(function SusanoMadaraCond))
set t=null
endfunction
