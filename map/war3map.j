function MeiF_Periodic takes nothing returns nothing
        local timer newTimer = GetExpiredTimer()
        local integer id = GetHandleId(newTimer)
        local unit caster  = LoadUnitHandle(h, id, 0)
        local real point_x = LoadReal(h, id, 1)
        local real point_y = LoadReal(h, id, 2)
        local real duration = LoadReal(h, id, 3)-0.05
        call SaveReal(h, id, 3, duration)
        
        if duration > 0 then
                if SquareRootPoint(GetUnitX(caster), GetUnitY(caster), point_x, point_y)>1000 then
                        call UnitRemoveAbility(caster, 0x41304D4D)
                endif
                if GetUnitAbilityLevel(caster, 0x41304D4D)==0 then
                        if SquareRootPoint(GetUnitX(caster), GetUnitY(caster), point_x, point_y)<=1000 then
                                call UnitAddAbility(caster, 0x41304D4D)
                        endif
                endif
        else
                call UnitRemoveAbility(caster, 0x41304D4D)
                call FlushChildHashtable(h, id)
                call DestroyTimer(newTimer)
        endif
        set newTimer = null
        set caster = null
endfunction

function MeiF_AllyCast takes unit newCaster, real point_x, real point_y, real duration returns nothing
        local timer newTimer = CreateTimer()
        local integer id = GetHandleId(newTimer)
        
        call SaveUnitHandle(h, id, 0, newCaster)
        call SaveReal(h, id, 1, point_x)
        call SaveReal(h, id, 2, point_y)
        call SaveReal(h, id, 3, duration)
        call TimerStart(newTimer, 0.05, true, function MeiF_Periodic)
        set newTimer = null
endfunction

