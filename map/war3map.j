call TriggerAddCondition(gg_trg_FiveAttack,Condition(function FiveAttackCond))
call TriggerAddAction(gg_trg_FiveAttack,function FiveAttackCast)
endfunction
function OmnislashCond takes nothing returns boolean
return GetSpellAbilityId()=='A26J' and udg_B==true and GetUnitTypeId(GetTriggerUnit())!='H007'  and GetUnitAbilityLevel(GetTriggerUnit(),'GIE1')==0 and GetUnitTypeId(GetTriggerUnit())!='H04U'
endfunction
function OmnislashCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local integer i=LoadInteger(h,id,2)
local real f=GetUnitFacing(u)*bj_DEGTORAD
if i<7 and UnitIsAlive(c)and UnitIsAlive(u)and IsUnitPaused(u)==false then
call SetUnitX(u,x1+100*Cos(f))
call SetUnitY(u,y1+100*Sin(f))
call UnitAttackRestart(u) 
call SetUnitFacingInstant(u,AU(u,c)*bj_RADTODEG)
call IssueTargetOrder(u,"attack",c)
call SaveInteger(h,id,2,i+1)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",c,"chest"))
call DestroyEffect(AddSpecialEffect("war3mapImported\\Slam.mdl",x,y))
else
call RemoveAbility(LoadAbilityHandle(h,id,3))
call UnitRemoveAbilityTimed(u,'A26K',0.3)
if GetUnitTypeId(u)!='H04B' then
call SetUnitVertexColor(u,255,255,255,255)
endif
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set c=null
set t=null
endfunction
function OmnislashCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call UnitAddAbility(u,'A26K')
if GetHeroPrimaryAttribute(u)==HERO_ATTRIBUTE_INT then
call SaveAbilityHandle(h,id,3,CreateAbility( 'SHD1' ))
call SetAbilityOwner(LoadAbilityHandle(h,id,3),u)
endif
if GetUnitTypeId(u)!='H04B' then
call SetUnitVertexColor(u,255,255,255,100)
endif
if GetUnitAbilityLevel(u,'A1FU')>0 then
call UnitRemoveAbility(u,'A1FU')
call UnitRemoveAbility(u,'Pet1')
endif
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SetUnitFacingInstant(u,AU(u,c)*bj_RADTODEG)
call TimerStart(t,0.33,true,function OmnislashCast2)
set u=null
set t=null
set c=null
endfunction
