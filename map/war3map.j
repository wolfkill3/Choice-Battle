local integer i=1
local real r=0
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local real time=LoadReal(h,id,4)
local real dmg=GetUnitState(u,UNIT_STATE_MAX_MANA)*(0.02+0.005*GetUnitAbilityLevel(u,'A191'))/1.5
local player p=GetOwningPlayer(u)
call SaveReal(h,id,4,time+0.1)
if time>0.5 then
call SetUnitInvulnerable(u,true)
call GroupEnumUnitsInRange(G,x,y,900,Base)
set r=GetRandomReal(-1,1)
set n=CreateUnit(p,'e08J',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'B001',0.5)
call SetUnitScale(n,1.5+r,1.5+r,1.5+r)
call SetUnitFlyHeight(n,GetRandomReal(0,350),0)
call SetUnitTimeScale(n,1.5)
call SetUnitVertexColor(n,0,0,0,125)
set r=GetRandomReal(0,2)
set n=CreateUnit(p,'e08J',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'B001',0.5)
call SetUnitScale(n,1.5+r,1.5+r,1.5+r)
call SetUnitFlyHeight(n,GetRandomReal(0,350),0)
call SetUnitTimeScale(n,1.5)
call SetUnitVertexColor(n,0,0,0,125)
set r=GetRandomReal(-1.4,0.5)
set n=CreateUnit(p,'e08J',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'B001',0.5)
call SetUnitScale(n,1.5+r,1.5+r,1.5+r)
call SetUnitFlyHeight(n,GetRandomReal(0,350),0)
call SetUnitTimeScale(n,1.5)
call SetUnitVertexColor(n,0,0,0,125)
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl",x+GetRandomReal(-450,450),y+GetRandomReal(-450,450)))
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl",x+GetRandomReal(-450,450),y+GetRandomReal(-450,450)))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\CarrionSwarm\\CarrionSwarmDamage.mdl",x+GetRandomReal(-450,450),y+GetRandomReal(-450,450)))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\CarrionSwarm\\CarrionSwarmDamage.mdl",x+GetRandomReal(-450,450),y+GetRandomReal(-450,450)))
set n=CreateUnit(p,0x65304258,x,y,GetRandomReal(0,359))
call SetUnitScale(n,3,3,3)
call SetUnitTimeScale(n,2)
call SetUnitFlyHeight(n,350,0)
call UnitApplyTimedLife(n,1,0.45)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl",E,"chest"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\CarrionSwarm\\CarrionSwarmDamage.mdl",E,"origin"))
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(G,E)
endloop
if time>2.5 then
call SetUnitFlyHeight(u,0,0)
call SetUnitTimeScale(u,1)
call DestroyGroup(g)
call RemoveUnit(LoadUnitHandle(h,id,2))
call DestroyTimer(t)
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
call FlushChildHashtable(h,id)
endif
endif
set g=null
set u=null
set t=null
set p=null
endfunction
