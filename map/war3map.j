        call SetUnitVertexColor(n,255,255,255,155)
        call UnitApplyTimedLife(n,1,0.4)
        call SetUnitTimeScale(n,3)
        set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG)
        call SetUnitVertexColor(n,255,255,255,155)
        call UnitApplyTimedLife(n,1,0.4)
        call SetUnitTimeScale(n,3)
        call PauseTimer(t)
        call PauseUnit(l__d,true)
        call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,true)
        call SetUnitInvulnerable(l__d,true)
        call SetUnitTimeScale(u,1.5)
        call SaveReal(h,id,3,a)
        //call SetUnitAnimation(l__d,"death")
        call UnitEnableAutoOrientation(l__d,false)
        call SetUnitOrientation(l__d,GetUnitFacing(u)-180,-45,0)
        //call SetUnitAnimationByIndex(u,39)
        set EFF=AddSpecialEffect("war3mapImported\\CF2.mdl", x1,y1)
        call SetSpecialEffectFacing(EFF , a* bj_RADTODEG)
        call SetSpecialEffectScale(EFF , 1)
        call DestroyEffect(EFF)
        set EFF=AddSpecialEffect("Minato-37.mdx", x1,y1)
        call SetSpecialEffectFacing(EFF , a* bj_RADTODEG)
        call SetSpecialEffectZ(EFF , 30)
        call SetSpecialEffectScale(EFF , 3)
        call DestroyEffect(EFF)
        set n=CreateUnit(p,'e0RV',x1,y1,a*bj_RADTODEG)
        call UnitApplyTimedLife(n,1,1)
        if GetWidgetLife(l__d)>0 then
            call TimerStart(t,0.03,true,function EaraserMeteorCast3)
        else
            call PauseUnit(u,false)
            call SetUnitInvulnerable(u,false)
            call PauseTimer(t)
            call SetUnitFlyHeight(u,0,0)
            call SetUnitTimeScale(u,1)
            call DestroyTimer(t)
            call FlushChildHashtable(h,id)
        endif
    else
        call PauseUnit(u,false)
        call SetUnitInvulnerable(u,false)
        call SetUnitTimeScale(u,1)
        call SetUnitFlyHeight(u,0,0)
        call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,false)
        call SaveUnitHandle(HH,GetHandleId(l__d),REVERSE_TARGET,u)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
    endif
endif
set l__d=null
set u=null
set p=null
set t=null
endfunction
function EaraserMeteorCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveReal(h,id,2,0)
call SaveReal(h,id,3,a)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG-30)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,1,0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+30)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,1,0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,1,0.4)
call SetUnitTimeScale(n,3)
call SetUnitAnimationByIndex(u,15)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\BrolyR1.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.04,true,function EaraserMeteorCast2)
set u=null
set c=null
set p=null
set t=null
endfunction
function InitTrig_EaraserMeteor takes nothing returns nothing
set gg_trg_EaraserMeteor=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_EaraserMeteor,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_EaraserMeteor,Condition(function EaraserMeteorCond))
call TriggerAddAction(gg_trg_EaraserMeteor,function EaraserMeteorCast)
endfunction
function PlanetGeyserMissleFly2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,9)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
local real dist=LoadReal(h,id,6)
local real he=LoadReal(h,id,10)
local real mh=LoadReal(h,id,5)
local real rad=LoadReal(h,id,7)
local real rd=SR(x,y,x1,y1)
local real dmg=LoadReal(h,id,8)
local player p=GetOwningPlayer(l__d)
local integer idu=GetPlayerId(p)
if rd>speed+20 then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SaveReal(h,id,1,speed*1.02)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,ParabolaZ2(0,he,mh,dist,rd),0)
else
call GroupEnumUnitsInRange(DG,x1,y1,250,Base)
loop
set E=FirstOfGroup(DG)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(DG,E)
endloop
set n=CreateUnit(p,'e0E6',x1,y1,GetRandomReal(0,359))
call SetUnitTimeScale(n,1.5)
call UnitApplyTimedLife(n,'BHwe',1.2)
call UnitApplyTimedLife(CreateUnit(p,'e0E7',x1,y1,GetRandomReal(0,359)),'BHwe',1)
call UnitApplyTimedLife(CreateUnit(p,'e0E8',x1,y1,GetRandomReal(0,359)),'BHwe',1)
call UnitApplyTimedLife(l__d,1,0.3)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set l__d=null
set t=null
endfunction
function PlanetGeyserMissleFly takes unit u,unit l__d,real speed,real angle,real x,real y,real mh,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,mh)
call SaveReal(h,id,6,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,8,dmg)
call SaveUnitHandle(h,id,9,u)
call SaveReal(h,id,10,GetUnitFlyHeight(l__d))
call TimerStart(t,0.03,true,function PlanetGeyserMissleFly2)
set t=null
endfunction
function PlanetGeyserCond takes nothing returns boolean
return GetSpellAbilityId()==0x4130535A and udg_B==true
endfunction
function PlanetGeyserCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,2)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroStr(u,true)*1.5
local real time=LoadReal(h,id,1)
local real size=LoadReal(h,id,3)
local real he=0
call SaveReal(h,id,1,time+0.05)
set bjLCE=AddSpecialEffect("DustWaveAnimate.mdl",x,y)
call SetSpecialEffectScale(bjLCE,size*1.2)
call SetSpecialEffectVertexColour(bjLCE,205,225,235,190)
call RemoveEffect(bjLCE,0.25,false,CreateTimer())
if time<2.5 then
    if time<0.5 then
        call SaveReal(h,id,3,size+0.22)
        call SetUnitScale(c,size,size,size)
    else
        set n=CreateUnit(p,'e0QY',x,y,0)
        set he=GetRandomReal(100,300)
        call SetUnitFlyHeight(n,GetRandomReal(40,110),0)
        call PlanetGeyserMissleFly(u,n,50,0,x+GetRandomReal(-1000,1000),y+GetRandomReal(-1000,1000),he,dmg)
    endif
else
    call SaveReal(h,id,3,size-0.44)
    call SetUnitScale(c,size,size,size)
endif
if time==2.65 then
call UnitApplyTimedLife(c,1,0.1)
endif
if time==2.75 then
    call PauseUnit(u,false)
    call SetControlToUnit(u,u,1,"stun")
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set t=null
endfunction
function PlanetGeyserCast takes unit u returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,0)
call PauseUnit(u,true)
set n=CreateUnit(p,'e0EH',GetUnitX(u),GetUnitY(u),GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,2)
call SetUnitTimeScale(n,1)
set n=CreateUnit(p,'e0EG',GetUnitX(u),GetUnitY(u),GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,2)
call SetUnitTimeScale(n,2)
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
    call StartSound(soundStr[15])
else
    call StartSound(soundStr[16])
endif
set n=CreateUnit(p,'e3E5',x,y,0)
call SetUnitFlyHeight(n,10,0)
call SetUnitScale(n,0.1,0.1,0.1)
call SaveUnitHandle(h,id,2,n)
call SaveReal(h,id,3,0.1)
call SetUnitAnimationByIndex(u,20)
call TimerStart(t,0.05,true,function PlanetGeyserCast2)
set u=null
set p=null
set t=null
endfunction
function PowerDownBroly takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
        if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
            if GetUnitAbilityLevel(u,'A0TJ')>0 or GetUnitAbilityLevel(u,'A0TK')>0 then
                call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.0003)
            endif
            if GetUnitAbilityLevel(u,'A0TL')>0 then
                call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)+GetUnitState(u,UNIT_STATE_MAX_MANA)*0.0006)
                if GetUnitState(u,UNIT_STATE_MAX_MANA)*0.99<GetUnitState(u,UNIT_STATE_MANA) and GetUnitAbilityLevel(u,'A5IH')==0 then
                    call PlanetGeyserCast(u)
                    call UnitAddAbility(u,'A5IH')
                    call UnitRemoveAbilityTimedPause(u,'A5IH',10)
                    call CreateModeIndicatorWithPauseForm(u, "war3mapImported\\BTNOmegaBlast.blp", 10)
                    if GetWidgetLife(u)>GetWidgetMaxLife(u)*0.1 then
                        call SetWidgetLife(u,GetWidgetLife(u)-GetWidgetMaxLife(u)*0.1)
                    else
                        call SetWidgetLife(u,1)
                    endif
                    call SetWidgetMana(u,GetWidgetMana(u)-GetWidgetMaxMana(u)*0.1)
                endif
            endif
        endif
        if GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.1>GetUnitState(u,UNIT_STATE_LIFE) or GetUnitState(u,UNIT_STATE_MAX_MANA)*0.04>GetUnitState(u,UNIT_STATE_MANA) or LoadBoolean(HH,GetHandleId(u),SST)==true then
            call SaveBoolean(HH,GetHandleId(u),SS,false)
            call SaveBoolean(HH,GetHandleId(u),SST,false)
            if GetUnitAbilityLevel(u,'A0TL')>0 then
                call EnableUnitAbility2(u,'A0TN',false,true)
                call StartAbilityCooldown(GetUnitAbility(u,'BRLS'),20)
            endif
            call UnitRemoveAbility(u,'A0TJ')
            call UnitRemoveAbility(u,'A0TK')
            call UnitRemoveAbility(u,'A0TL')
            call UnitAddAbility(u,'A0TI')
            call SetUnitAbilityLevel(u,'A1NM',1)
            call SetUnitScale(u,.9,.9,.9)
            call UnitMakeAbilityPermanent(u,true,'A0TI')
            call SetUnitModel(u,"Broly.mdl")
            call PauseTimer(t)
            call DestroyTimer(t)
            call FlushChildHashtable(h,id)
        endif
    set t=null
    set u=null
endfunction
function PowerUpBrolyCond takes nothing returns boolean
return (GetSpellAbilityId()=='BRBS' or GetSpellAbilityId()=='BRSS' or GetSpellAbilityId()=='BRRS' or GetSpellAbilityId()=='BRLS') and udg_B==true
endfunction
function PowerUpBrolyCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local timer tt=CreateTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local player p=GetOwningPlayer(u)
    local real time=LoadReal(h,id,1)
    local boolean GokuIn=false
    local integer i=0
    if time<7 then
        call PauseUnit(u,true)
        call SaveReal(h,id,1,time+0.025)
        if LoadInteger(h,id,3)==3 then
            call SetUnitInvulnerable(u,true)
            if time==.025 then
                call SetUnitAnimationByIndex(u,23)
                set bjLCE=AddSpecialEffect("DustWaveAnimate.mdl",x,y)
                call SetSpecialEffectScale(bjLCE,2.1)
                call SetSpecialEffectVertexColour(bjLCE,205,225,235,190)
                call DestroyEffect(bjLCE)
                set bjLCE=AddSpecialEffect("BrolyLSSEarth.mdl",x,y)
                call SetSpecialEffectScale(bjLCE,0.25)
                call RemoveEffect(bjLCE,1.1,false,CreateTimer())
                loop
                exitwhen i>=10
                if (GetUnitTypeId(Hero[i])=='H02H' or GetUnitTypeId(Hero[i])=='HBGN') and IsUnitEnemy(Hero[i],p) and UnitIsAlive(Hero[i]) then
                    set GokuIn=true
                endif
                set i=i+1
                endloop
                if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
                    if GokuIn==false then
                        call StartSound(soundStr[1])
                    else
                        call StartSound(soundStr[2])
                    endif
                else
                    if GokuIn==false then
                        call StartSound(soundStr[4])
                    else
                        call StartSound(soundStr[5])
                    endif
                endif
            endif
            if time==1.025 then
                call SetUnitAnimationByIndex(u,30)
                set bjLCE=AddSpecialEffect("BrolyLSSEarth.mdl",x,y)
                call SetSpecialEffectScale(bjLCE,0.5)
                call RemoveEffect(bjLCE,3.5,true,CreateTimer())
            endif
            if ModuloReal(time,0.1)<0.025 and time>1.6 and time<6 then
                set bjLCE=AddSpecialEffect("DustWaveAnimate.mdl",x,y)
                call SetSpecialEffectScale(bjLCE,2.1)
                call SetSpecialEffectAnimationByIndex(bjLCE,0)
                call SetSpecialEffectVertexColour(bjLCE,205,225,235,190)
                call DestroyEffect(bjLCE)
            endif
            if time==3 then
                set EFF=AddSpecialEffect("war3mapImported\\BrolySSAura1.mdx", x, y)
                call SetSpecialEffectScale(EFF , 3)
                call RemoveEffect(EFF,2.5,false,CreateTimer())
                set EFF=AddSpecialEffect("war3mapImported\\BrolySSAura1.mdx", x, y)
                call SetSpecialEffectZ(EFF,110)
                call SetSpecialEffectScale(EFF , 1.2)
                call RemoveEffect(EFF,2.5,false,CreateTimer())
                set EFF=AddSpecialEffect("war3mapImported\\BrolySSAura1.mdx", x, y)
                call SetSpecialEffectZ(EFF,210)
                call SetSpecialEffectScale(EFF , 1.2)
                call RemoveEffect(EFF,2.5,false,CreateTimer())
                set EFF=AddSpecialEffect("war3mapImported\\BrolySSAura1.mdx", x, y)
                call SetSpecialEffectZ(EFF,310)
                call SetSpecialEffectScale(EFF , 1.2)
                call RemoveEffect(EFF,2.5,false,CreateTimer())
            endif
            if time==2 and GetUnitAbilityLevel(u,'A0TJ')==0 and GetUnitAbilityLevel(u,'A0TK')==0 then
                set EFF=AddSpecialEffect("Yellow--zhendi.mdl", x, y)
                call DestroyEffect(EFF)
                call SetUnitScale(u,.95,.95,.95)
                call UnitRemoveAbility(u,'A0TI')
                call UnitRemoveAbility(u,'A0TJ')
                call UnitRemoveAbility(u,'A0TK')
                call UnitRemoveAbility(u,'A0TL')
                call UnitAddAbility(u,'A0TJ')
                call UnitMakeAbilityPermanent(u,true,'A0TJ')
                call StartSound(soundStr[90])
            endif
            if time==3.025 then
                call SetUnitTimeScale(u,1)
                if GetAbilityBaseStringFieldById('BRRS',ABILITY_SF_ICON_NORMAL)==GetAbilityBaseStringFieldById('BRSS',ABILITY_SF_ICON_NORMAL) then
                    call SetUnitAnimationByIndex(u,30)
                    set bjLCE=AddSpecialEffect("BrolyLSSEarth.mdl",x,y)
                    call SetSpecialEffectScale(bjLCE,0.5)
                    call RemoveEffect(bjLCE,1.5,true,CreateTimer())
                endif
            endif
            if time==4 and GetAbilityBaseStringFieldById('BRRS',ABILITY_SF_ICON_NORMAL)==GetAbilityBaseStringFieldById('BRSS',ABILITY_SF_ICON_NORMAL) and GetUnitAbilityLevel(u,'A0TK')==0 then
                call SetUnitScale(u,.95,.95,.95)
                set EFF=AddSpecialEffect("Yellow--zhendi.mdl", x, y)
                call DestroyEffect(EFF)
                call UnitRemoveAbility(u,'A0TI')
                call UnitRemoveAbility(u,'A0TJ')
                call UnitRemoveAbility(u,'A0TK')
                call UnitRemoveAbility(u,'A0TL')
                call UnitAddAbility(u,'A0TK')
                call UnitMakeAbilityPermanent(u,true,'A0TK')
                call StartSound(soundStr[90])
            endif
            if ModuloReal(time,0.1)<0.025 and time>4 and time<4.7 then
                set EFF=AddSpecialEffect("BrolyLight1.mdl", x, y)
                call SetSpecialEffectOrientation(EFF , GetRandomReal(0,359),GetRandomReal(0,359),0)
                call SetSpecialEffectZ(EFF,GetRandomReal(60,120))
                call RemoveEffect(EFF,1.1,false,CreateTimer())
                set EFF=AddSpecialEffect("war3mapImported\\WarStompCaster3.mdx", x, y)
                call SetSpecialEffectScale(EFF , 1.6)
                call DestroyEffect(EFF)
            endif
            if time==4.5 then
                // set n=CreateUnit(p,'e3E5',x,y,0)
                // call SetUnitFlyHeight(n,10,0)
                // call SetUnitScale(n,0.1,0.1,0.1)
                // call SaveUnitHandle(h,id,2,n)
                // call SaveReal(h,id,3,0.1)
                set EFF=AddSpecialEffect("slamEarth.mdl",x,y)
                call SetSpecialEffectScale(EFF , 1.6)
                call RemoveEffect(EFF,0.3,false,CreateTimer())
                set EFF=AddSpecialEffect("BrolyTExplosion.mdl", x,y)
                call SetSpecialEffectScale(EFF , 0.8)
                call SetSpecialEffectTimeScale(EFF , 1.2)
                call DestroyEffect(EFF)
            endif
            // if time>4.6 and time<5 then
            //     call SaveReal(h,id,3,LoadReal(h,id,3)+0.15)
            //     call SetUnitScale(LoadUnitHandle(h,id,2),LoadReal(h,id,3),LoadReal(h,id,3),LoadReal(h,id,3))
            // endif
            if time==4.7 then
                set EFF=AddSpecialEffect("BrolyCompression6.mdl", x, y)
                call SetSpecialEffectZ(EFF,100)
                call SetSpecialEffectScale(EFF , 2.5)
                call DestroyEffect(EFF)
            endif
            if time==5 then
                set EFF=AddSpecialEffect("BrolyCompression3.mdl", x, y)
                call SetSpecialEffectZ(EFF,100)
                call SetSpecialEffectScale(EFF , 2.5)
                call DestroyEffect(EFF)
            endif
            if time==5.3 then
                set EFF=AddSpecialEffect("BrolyCompression4.mdl", x, y)
                call SetSpecialEffectZ(EFF,100)
                call SetSpecialEffectScale(EFF , 2.5)
                call DestroyEffect(EFF)
                call SetUnitScale(u,1.1,1.1,1.1)
                call SetUnitModel(u,"BrolyBuff.mdl")
                call SetUnitFlyHeight(u,0,1000)
                call UnitRemoveAbility(u,'A0TI')
                call UnitRemoveAbility(u,'A0TJ')
                call UnitRemoveAbility(u,'A0TK')
                call UnitRemoveAbility(u,'A0TL')
                call UnitAddAbility(u,'A0TL')
                call UnitMakeAbilityPermanent(u,true,'A0TL')
                call SetUnitTimeScale(u,0.5)
                call SetUnitAnimationByIndex(u,26)
            endif
            if time==5.6 then
                set EFF=AddSpecialEffect("BrolyCompression5.mdl", x, y)
                call SetSpecialEffectZ(EFF,100)
                call SetSpecialEffectScale(EFF , 2.5)
                call RemoveEffect(EFF,1.8,false,CreateTimer())
                if BrolySTRTransform[GetPlayerId(p)]==true then
                    call SetAbilityBaseStringFieldById('A0TI',ABILITY_SLF_TARGET,"war3mapImported\\NormalBrolyHeadWithoutCrown.mdx")
                    call SetAbilityBaseStringFieldById('BRRS',ABILITY_SF_ICON_NORMAL,GetAbilityBaseStringFieldById('BRSS',ABILITY_SF_ICON_NORMAL))
                    call SetAbilityBaseStringFieldById('BRRS',ABILITY_SLF_TOOLTIP_NORMAL_EXTENDED,GetAbilityBaseStringFieldById('BRSS',ABILITY_SLF_TOOLTIP_NORMAL_EXTENDED))
                    set BrolySTRTransform[GetPlayerId(p)]=false
                endif
            endif
            if time>6.4 and time<6.9 then
                // call SaveReal(h,id,3,LoadReal(h,id,3)-0.07)
                // call SetUnitScale(LoadUnitHandle(h,id,2),LoadReal(h,id,3),LoadReal(h,id,3),LoadReal(h,id,3))
                if ModuloReal(time,0.15)<0.025 then
                    set bjLCE=AddSpecialEffect("DustWaveAnimate.mdl",x,y)
                    call SetSpecialEffectScale(bjLCE,3.1)
                    call SetSpecialEffectAnimationByIndex(bjLCE,0)
                    call SetSpecialEffectVertexColour(bjLCE,205,225,235,190)
                    call DestroyEffect(bjLCE)
                endif
            endif
            if time==6.825 then
                // call UnitApplyTimedLife(LoadUnitHandle(h,id,2),1,0.1)
                set EFF=AddSpecialEffect("BrolyLight2.mdx", x, y)
                call SetSpecialEffectZ(EFF,120)
                call RemoveEffect(EFF,0.3,true,CreateTimer())
            endif
        endif
    else
        call PauseUnit(u,false)
        call SetUnitTimeScale(u,1)
        call SetUnitAbilityLevel(u,'A1NM',LoadInteger(h,id,3)+1)
        if LoadInteger(h,id,3)==1 and GetUnitAbilityLevel(u,'A0TJ')==0 then //fss
            call SetUnitScale(u,.95,.95,.95)
            set EFF=AddSpecialEffect("Yellow--zhendi.mdl", x, y)
            call DestroyEffect(EFF)
            call UnitRemoveAbility(u,'A0TI')
            call UnitRemoveAbility(u,'A0TJ')
            call UnitRemoveAbility(u,'A0TK')
            call UnitRemoveAbility(u,'A0TL')
            call UnitAddAbility(u,'A0TJ')
            call UnitMakeAbilityPermanent(u,true,'A0TJ')
            call StartSound(soundStr[90])
        elseif LoadInteger(h,id,3)==2 and GetUnitAbilityLevel(u,'A0TK')==0 then //ss
            call SetUnitScale(u,.95,.95,.95)
            set EFF=AddSpecialEffect("Yellow--zhendi.mdl", x, y)
            call DestroyEffect(EFF)
            call UnitRemoveAbility(u,'A0TI')
            call UnitRemoveAbility(u,'A0TJ')
            call UnitRemoveAbility(u,'A0TK')
            call UnitRemoveAbility(u,'A0TL')
            call UnitAddAbility(u,'A0TK')
            call UnitMakeAbilityPermanent(u,true,'A0TK')
            call StartSound(soundStr[90])
        elseif LoadInteger(h,id,3)==3 then //Lss
            call SetUnitInvulnerable(u,false)
        endif
        if LoadInteger(h,id,3)==0 and GetUnitAbilityLevel(u,'A0TI')==0 then
            call StartSound(soundStr[89])
        endif
        if LoadBoolean(HH,GetHandleId(u),SS)==false then
            call SaveUnitHandle(h,GetHandleId(tt),0,u)
            call SaveBoolean(HH,GetHandleId(u),SS,true)
            call TimerStart(tt,0.1,true,function PowerDownBroly)
        endif
        if LoadInteger(h,id,3)==0 then
            call SaveBoolean(HH,GetHandleId(u),SST,true)
        endif
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
    endif
    set p=null
    set tt=null
    set u=null
    set t=null
endfunction
function PowerUpBrolyCast takes nothing returns nothing
    local unit u=GetTriggerUnit()
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local player p=GetOwningPlayer(u)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    call SaveUnitHandle(h,id,0,u)
    if GetSpellAbilityId()=='BRRS' then
        call SaveReal(h,id,1,6.975)
    elseif GetSpellAbilityId()=='BRBS' then
        call SaveReal(h,id,1,6.975)
        call SaveInteger(h,id,3,0)
    elseif GetSpellAbilityId()=='BRLS' then
        call SaveReal(h,id,1,3)
    endif
    if GetSpellAbilityId()=='BRRS' and GetAbilityBaseStringFieldById('BRRS',ABILITY_SF_ICON_NORMAL)=="ReplaceableTextures\\Commandbuttons\\BTNBrolyRSSJ.blp" then
        // set soundplay=CreateSound("Sound\\Music\\mp3Music\\trunks ss1.mp3",false,false,true,12700,12700,"")
        call SaveInteger(h,id,3,1)
    elseif GetSpellAbilityId()=='BRRS' and GetAbilityBaseStringFieldById('BRRS',ABILITY_SF_ICON_NORMAL)=="ReplaceableTextures\\Commandbuttons\\BTNBrolySSJ.blp" then
        // set soundplay=CreateSound("Sound\\Music\\mp3Music\\trunks ss2.mp3",false,false,true,12700,12700,"")
        call SaveInteger(h,id,3,2)
    elseif GetSpellAbilityId()=='BRLS' then
        // set soundplay=CreateSound("Sound\\Music\\mp3Music\\trunks ss2.mp3",false,false,true,12700,12700,"")
        call SaveInteger(h,id,3,3)
        call UnitAddAbility(u,'A5IH')
        call UnitRemoveAbilityTimedPause(u,'A5IH',10)
        call DisableUnitAbility2(u,'A0TN',false,true)
        call CreateModeIndicatorWithPauseForm(u, "war3mapImported\\BTNOmegaBlast.blp", 10)
        if BrolySTRTransform[GetPlayerId(p)]==true then
            call SaveReal(h,id,1,0)
        else
            if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
                call StartSound(soundStr[3])
            else
                call StartSound(soundStr[6])
            endif
        endif
    endif
    call SetUnitTimeScale(u,0.9)
    call TimerStart(t,0.025,true,function PowerUpBrolyCast2)
    set u=null
    set p=null
    set t=null
endfunction
function InitTrig_PowerUpBroly takes nothing returns nothing
set gg_trg_PowerUpBroly=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_PowerUpBroly,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_PowerUpBroly,Condition(function PowerUpBrolyCond))
call TriggerAddAction(gg_trg_PowerUpBroly,function PowerUpBrolyCast)
endfunction
function GigantiidgressCond takes nothing returns boolean
return GetSpellAbilityId()==0x41304A4C and udg_B==true
endfunction
function GigantiidgressCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local real f=GetUnitFacing(u)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroStr(u,true)*10
local real dist=SR(x,y,x1,y1)
local real a=Atan2(y1-y,x1-x)
local real he=0
local real dist2=LoadReal(h,id,100)
if dist2>50.00 and udg_B==true and DU2==true then
call SaveReal(h,id,100,dist2-33)
call SetUnitXY_1(u,x+33*Cos(a),y+33*Sin(a), true)
call SetUnitFacing(u,a*bj_RADTODEG)
set he=ParabolaZ(400,LoadReal(h,id,4),dist)
call SetUnitFlyHeight(u,he,0)
call SetUnitAnimation(u,"Spell Channel")
else
call GroupEnumUnitsInRange(DG,x1,y1,500,Base)
loop
set E=FirstOfGroup(DG)
exitwhen E==null
if Condition_Base(p,E)then
call Push(E,30,Atan2(GetUnitY(E)-y1,GetUnitX(E)-x1),300)
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(DG,E)
endloop
call SetUnitInvulnerable(u,false)
call SetUnitFlyHeight(u,0,0)
call SetUnitTimeScale(u,1)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\PunchStrike.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call UnitApplyTimedLife(CreateUnit(p,0x65304549,x1+GetRandomReal(-200,200),y1+GetRandomReal(-200,200),GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,0x65304549,x1+GetRandomReal(-200,200),y1+GetRandomReal(-200,200),GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,0x65304549,x1+GetRandomReal(-200,200),y1+GetRandomReal(-200,200),GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,0x6530454A,x1,y1,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e0E9',x1,y1,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e0EB',x1,y1,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,0x6530454B,x1,y1,GetRandomReal(0,359)),1,1)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
endif
set u=null
set t=null
set p=null
endfunction
