function TKingHassanCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit l__d=LoadUnitHandle(h,id,6)
local real dmg=LoadReal(h,id,2)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local real walk=LoadReal(h,id,3)
local real fire=LoadReal(h,id,4)
local player p=GetOwningPlayer(u)
local real sc=0
local integer is=0
local real ig=15*bj_DEGTORAD
if SR(x,y,x1,y1)>400 then
call SaveReal(h,id,3,walk+0.03)
call SaveReal(h,id,4,fire+0.03)
call SaveReal(h,id,2,dmg+GetHeroStr(u,true)*0.015)
call SetUnitInvulnerable(u,true)
if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
call PauseUnit(u,true)
endif
if walk>1.2 then
call SetUnitAnimationByIndex(u,1)
call SetUnitTimeScale(l__d,0)
call SaveReal(h,id,3,0)
endif
call SetUnitXY_1(l__d,x,y, false)
call SetUnitX(u,x+7*Cos(a))
call SetUnitY(u,y+7*Sin(a))
call SetUnitFacing(u,a*bj_RADTODEG)
if fire>0.2 then
set n=CreateUnit(p,'e16B',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,75)
call UnitApplyTimedLife(n,1,0.4)
set x=x+40*Cos(a)
set y=y+40*Sin(a)
set n=CreateUnit(p,'e160',x,y,a*bj_RADTODEG+45)
call UnitApplyTimedLife(n,1,0.7)
call SetUnitMoveSpeed(n,400)
call SetUnitPathing(n,false)
call IssuePointOrder(n,"move",x+800*Cos(a+bj_PI/4),y+800*Sin(a+bj_PI/4))
set n=CreateUnit(p,'e160',x,y,a*bj_RADTODEG-45)
call UnitApplyTimedLife(n,1,0.7)
call IssuePointOrder(n,"move",x+800*Cos(a-bj_PI/4),y+800*Sin(a-bj_PI/4))
call SetUnitMoveSpeed(n,400)
call SetUnitPathing(n,false)
call SaveReal(h,id,4,0)
endif
if dmg>GetUnitState(c,UNIT_STATE_LIFE)then
call SetUnitX(u,x1-390*Cos(a))
call SetUnitY(u,y1-390*Sin(a))
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
endif
else
    if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
        call PauseUnit(c,true)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
        call SetUnitAnimation(u,"attack")
        call PauseTimer(t)
        call TimerStart(t,0.75,false,function TKingHassanCast3)
        loop
        exitwhen is>=25
        set n=CreateUnit(p,'e0ZH',x1+850*Cos(ig*is),y1+850*Sin(ig*is),180+is*15)
        call SetUnitVertexColor(n,255,255,255,25)
        call SetUnitScale(n,2.0,2.0,2.0)
        call UnitApplyTimedLife(n,1,3)
        call SetUnitTimeScale(n,0.2)
        set is=is+1
        endloop
        call SetUnitScale(l__d,1.75,1.75,1.75)
        call SetUnitVertexColor(l__d,255,255,255,0)
        set n=CreateUnit(p,'e13F',x1,y1,a*bj_RADTODEG+90)
        call SetUnitVertexColor(n,255,255,155,100)
        call SetUnitScale(n,4,4,4)
        call SetUnitTimeScale(n,2)
        call UnitApplyTimedLife(n,1,4)
        call SetUnitXY_1(l__d,x1,y1, false)
    else
        call PauseUnit(u,false)
        call PauseUnit(c,false)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
        call SetUnitInvulnerable(u,false)
        call SetUnitVertexColor(u,255,255,255,255)
        call SetUnitTimeScale(u,1)
        call PauseTimer(t)
        call SetUnitFlyHeight(u,0,0)
        call DestroyTimer(t)
        call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
        call FlushChildHashtable(h,id)
    endif
endif
set l__d=null
set p=null
set c=null
set u=null
set t=null
endfunction
function TKingHassanCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
set n=CreateUnit(GetOwningPlayer(u),'e0RV',GetUnitX(u),GetUnitY(u),0)
call SetUnitTimeScale(n,0.75)
call SaveUnitHandle(h,id,6,n)
call SetUnitScale(n,0.85,0.85,0.85)
call SetUnitVertexColor(n,255,255,255,200)
call SaveReal(h,id,2,GetHeroStr(u,true)*10)
call SaveReal(h,id,3,0)
call SaveReal(h,id,4,0)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SetUnitAnimationByIndex(u,1)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\KingHassanNP1.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.03,true,function TKingHassanCast2)
set u=null
set c=null
set t=null
endfunction
