function Trig_Lone_Sparrow_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local group g=LoadGroupHandle(h,id,4)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,5)
local integer l__idg=GetHandleId(g)
local integer l__ide
local player p=GetOwningPlayer(u)
local real dmg=GetHeroInt(u,true)*(GetUnitAbilityLevel(u,'A08Z')+3)
if SRS(x,y,x1,y1)<=LoadReal(h,id,15)then
call SetUnitX(l__d,x1+60*Cos(a))
call SetUnitY(l__d,y1+60*Sin(a))
call GroupEnumUnitsInRange(g,x1,y1,200,Base)
loop
set E=FirstOfGroup(g)
set l__ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,l__ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
if IsUnitInvulnerable(E)==false then
call SetUnitState(E,UNIT_STATE_MANA,GetUnitState(E,UNIT_STATE_MANA)-GetUnitState(E,UNIT_STATE_MAX_MANA)*0.125)
endif
call SaveUnitHandle(h,l__idg,l__ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
call UnitApplyTimedLife(CreateUnit(p,0x6530334C,x1,y1,a*bj_RADTODEG),1,0.25)
else
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
call DestroyTimer(t)
call DestroyGroup(g)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function Trig_Lone_Sparrow_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,CreateUnit(GetOwningPlayer(u),0x6530334D,x+80*Cos(a),y+80*Sin(a),f))
call SaveGroupHandle(h,id,4,CreateGroup())
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveReal(h,id,5,a)
if GetUnitAbilityLevel(u,'B04L')>0 then
call SaveReal(h,id,15,5000)
else
call SaveReal(h,id,15,2500)
endif
set soundplay=CreateSound("Sound\\Music\\mp3Music\\IshidaShot.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call SetUnitFacing(LoadUnitHandle(h,id,1),a*bj_RADTODEG)
call TimerStart(t,0.02,true,function Trig_Lone_Sparrow_Actions2)
set u=null
set t=null
endfunction
function Trig_Sprenger_Conditions takes nothing returns boolean
return GetSpellAbilityId()==0x41303930
endfunction
function Trig_Sprenger_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local integer i=1
local player p=GetOwningPlayer(u)
local real x=LoadReal(h,id,50)
local real y=LoadReal(h,id,51)
local real dmg=(6+GetUnitAbilityLevel(u,0x41303930))*GetHeroInt(u,true)
loop
exitwhen i>=4
call UnitApplyTimedLife(CreateUnit(p,0x6530334F,x,y,GetRandomReal(0,359)),1,2)
call UnitApplyTimedLife(CreateUnit(p,0x6530344E,x,y,GetRandomReal(0,359)),1,2)
call UnitApplyTimedLife(CreateUnit(p,'e03P',x,y,GetRandomReal(0,359)),1,2)
set i=i+1
endloop
call GroupEnumUnitsInRange(G,x,y,500,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 1, "stun")
endif
call GroupRemoveUnit(G,E)
endloop
set i=1
loop
exitwhen i>=7
call RemoveUnit(LoadUnitHandle(h,id,i+1))
set i=i+1
endloop
set i=5
loop
exitwhen i>=40
call DestroyLightning(LoadLightningHandle(h,id,i+1))
set i=i+1
endloop
call SetUnitInvulnerable(u,false)
//call PauseUnit(u,false)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set u=null
set p=null
set t=null
endfunction
function Trig_Sprenger_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit l__d
local integer i=1
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local player p=GetOwningPlayer(u)
call SetUnitInvulnerable(u,true)
//call PauseUnit(u,true)
loop
exitwhen i>=6
set l__d=CreateUnit(p,0x6530334E,x+500*Cos(72*i*bj_DEGTORAD),y+500*Sin(72*i*bj_DEGTORAD),0)
call SaveUnitHandle(h,id,1+i,l__d)
call SaveLightningHandle(h,id,10+i,AddLightningEx("DRAM",false,x,y,50,GetUnitX(l__d),GetUnitY(l__d),50))
set i=i+1
endloop
call SaveLightningHandle(h,id,20,AddLightningEx("DRAM",false,x+500*Cos(1*72*bj_DEGTORAD),y+500*Sin(1*72*bj_DEGTORAD),50,x+500*Cos(2*72*bj_DEGTORAD),y+500*Sin(2*72*bj_DEGTORAD),50))
call SaveLightningHandle(h,id,21,AddLightningEx("DRAM",false,x+500*Cos(2*72*bj_DEGTORAD),y+500*Sin(2*72*bj_DEGTORAD),50,x+500*Cos(3*72*bj_DEGTORAD),y+500*Sin(3*72*bj_DEGTORAD),50))
call SaveLightningHandle(h,id,22,AddLightningEx("DRAM",false,x+500*Cos(3*72*bj_DEGTORAD),y+500*Sin(3*72*bj_DEGTORAD),50,x+500*Cos(4*72*bj_DEGTORAD),y+500*Sin(4*72*bj_DEGTORAD),50))
call SaveLightningHandle(h,id,23,AddLightningEx("DRAM",false,x+500*Cos(4*72*bj_DEGTORAD),y+500*Sin(4*72*bj_DEGTORAD),50,x+500*Cos(5*72*bj_DEGTORAD),y+500*Sin(5*72*bj_DEGTORAD),50))
call SaveLightningHandle(h,id,24,AddLightningEx("DRAM",false,x+500*Cos(5*72*bj_DEGTORAD),y+500*Sin(5*72*bj_DEGTORAD),50,x+500*Cos(1*72*bj_DEGTORAD),y+500*Sin(1*72*bj_DEGTORAD),50))
call SaveUnitHandle(h,id,1+i,CreateUnit(p,0x6530334E,x,y,0))
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,50,x)
call SaveReal(h,id,51,y)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Sprenger.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,1.5,false,function Trig_Sprenger_Actions2)
set l__d=null
set t=null
set u=null
set p=null
endfunction
function RankaykuCond takes nothing returns boolean
return GetSpellAbilityId()=='A09G' and udg_B==true
endfunction
function RankaykuCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local group g=LoadGroupHandle(h,id,4)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,5)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroAgi(u,true)*(2+GetUnitAbilityLevel(u,'A09G'))+100
if SR(x,y,x1,y1)<70 then
if GetUnitTypeId(u)=='H00L' then
call SetUnitAnimationByIndex(u,3)
else
call SetUnitAnimationByIndex(u,4)
endif
endif
if SR(x,y,x1,y1)<=2000 then
set x1=x1+52*Cos(a)
set y1=y1+52*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
call GroupEnumUnitsInRange(g,x1,y1,225,Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",E,"chest"))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\mihawkslashhit.mdl",E,"chest"))
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
else
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,GetHandleId(g))
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
call RemoveUnit(l__d)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function RankaykuCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local timer t=CreateTimer()
