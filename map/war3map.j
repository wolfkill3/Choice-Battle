return BaseSkinBuffCond(P) or GetPlayerName(P)=="Annieh" or GetPlayerName(P)=="KamaBr" or GetPlayerName(P)=="[OSV] Kama" or GetPlayerName(P)=="Slaikee" or GetPlayerName(P)=="zld6334" or GetPlayerName(P)=="PinkieNecro" or GetPlayerName(P)=="DBFag" or GetPlayerName(P)=="NecromanseR_RuS" or GetPlayerName(P)=="DBFag" or GetPlayerName(P)=="Wolfkill" or GetPlayerName(P)=="xxNu-13xx" or GetPlayerName(P)=="zelim9" or GetPlayerName(P)=="Denamesh" or GetPlayerName(P)=="MoonX3" or GetPlayerName(P)=="AkazaThree" or GetPlayerName(P)=="Kuzeyuta" or GetPlayerName(P)=="[Nirvash][Neo]" or GetPlayerName(P)=="KazuneReyes" or GetPlayerName(P)=="Kakaroto228" or GetPlayerName(P)=="zelim9" or GetPlayerName(P)=="terin000" or GetPlayerName(P)=="madaras0" or GetPlayerName(P)=="kisame-h" or GetPlayerName(P)=="terin000" or GetPlayerName(P)=="Motorka3" or GetPlayerName(P)=="Faimon" or GetPlayerName(P)=="Oma_Kurotsu" or GetPlayerName(P)=="xFyntuk" or GetPlayerName(P)=="Uchiha.sasuke01" or GetPlayerName(P)=="Vadik29" or GetPlayerName(P)=="Anwa_Abdul" or GetPlayerName(P)=="antonpoganui" or GetPlayerName(P)=="Wasteriomind" or GetPlayerName(P)=="bkmz008" or GetPlayerName(P)=="ttashhanov" or GetPlayerName(P)=="Wolkern" or GetPlayerName(P)=="WorldEdit" or GetPlayerName(P)=="PinkieNecro" or GetPlayerName(P)=="DBFag" or GetPlayerName(P)=="NecromanseR_RuS" or GetPlayerName(P)=="DBFag" or GetPlayerName(P)=="Hirako321"and GetUnitTypeId(Hero[GetPlayerId(P)])!='H02H'
endfunction
function Fran takes nothing returns nothing
local integer ip=GetPlayerId(GetTriggerPlayer())
local integer id=GetHandleId(Hero[ip])
call DestroyEffect(LoadEffectHandle(HH,id,StringHash("ss")))
set EFF=AddSpecialEffectTarget("franhead.mdx",Hero[ip],"head")
call SaveEffectHandle(HH,id,StringHash("ss"),EFF)
call DestroyEffect(LoadEffectHandle(HH,id,StringHash("ss2")))
call UnitRemoveAbility(Hero[ip],'A1AU')
call UnitRemoveAbility(Hero[ip],'A2AU')
call UnitRemoveAbility(Hero[ip],'A3AU')
endfunction
