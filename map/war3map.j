if time<20 then
if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
call SaveReal(h,id,1,time+0.05)
endif
else
call RemoveUnit(LoadUnitHandle(HH, GetHandleId(u), StringHash("SasukeF_Bool")))
call UnitRemoveAbility(u,'A40X')
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
endif
set t=null
set u=null
endfunction
function SasukeFCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
call UnitAddAbility(u,'A40X')
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,0)
call RemoveUnit(LoadUnitHandle(HH, GetHandleId(u), StringHash("SasukeF_Bool")))
call SaveUnitHandle(HH, GetHandleId(u), StringHash("SasukeF_Bool"), CreateUnit(p, 'dM84', 0, 0, 0))
call CreateModeIndicatorWithPauseForm(u, "war3mapImported\\BTNSasuke 0.blp", 20)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\SasukeMangeku.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.05,true,function SasukeFCast2)
set u=null
set p=null
set t=null
endfunction

function SasukeF_Cast takes unit newCaster, unit newTarget returns nothing
        local real caster_x = GetUnitX(newCaster)
        local real caster_y = GetUnitY(newCaster)
        local real target_x = GetUnitX(newTarget)
        local real target_y = GetUnitY(newTarget)
        set soundplay=CreateSound("Sound\\war3mapImported\\SasukeF"+I2S(GetRandomInt(1,2))+".mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        call SetUnitXY(newCaster, target_x, target_y)
        call SetUnitXY(newTarget, caster_x, caster_y)
        call StartAbilityCooldown(GetUnitAbility(newCaster, 'SasF'), 6)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd042', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 1.8, 1.8, 1.8)
        call SetUnitFlyHeight(n, 5, 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dM30', caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 0.85, 0.85, 0.85)
        call SetUnitVertexColor(n, 255, 255, 255, 200)
        call SetUnitFlyHeight(n, 5, 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd042', target_x, target_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 1.8, 1.8, 1.8)
        call SetUnitFlyHeight(n, 5, 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dM30', target_x, target_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 0.85, 0.85, 0.85)
        call SetUnitVertexColor(n, 255, 255, 255, 200)
        call SetUnitFlyHeight(n, 5, 0)
        call MyRemoveUnit(n, 1.5)
endfunction

function VergilD_Periodic takes nothing returns nothing
	local timer newTimer = GetExpiredTimer()
	local integer id     = GetHandleId(newTimer)
	local unit caster    = LoadUnitHandle(h, id, 0)
	local real angle     = LoadReal(h, id, 1)
	local real distance  = LoadReal(h, id, 2)
	local integer eff_period = LoadInteger(h, id, 3)
	if distance>0 then
	
		call SetUnitXY(caster, GetUnitX(caster)+50*Cos(angle), GetUnitY(caster)+50*Sin(angle))
		call SaveReal(h, id, 2, distance-50)
		call SetUnitInvulnerable(caster, true)
		
		if LoadInteger(h, id, 4)<=0 then
			set n=CreateUnit(GetOwningPlayer(caster), 'd088', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG)
			call SetUnitVertexColor(n, 200, 200, 255, 80)
			call SetUnitAnimationByIndex(n, 2)
			call MyRemoveUnit(n, 0.1)
			call SaveInteger(h, id, 4, 1)
		else
			call SaveInteger(h, id, 4, LoadInteger(h, id, 4)-1)
		endif
			
		if eff_period<=0 then
			set n=CreateUnit(GetOwningPlayer(caster), 'dM29', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
			call MyRemoveUnit(n, 2.0)
			call SaveInteger(h, id, 3, 3)
		else
			call SaveInteger(h, id, 3, eff_period-1)
		endif
	else
		set n=CreateUnit(GetOwningPlayer(caster), 'dM30', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
		call SetUnitFlyHeight(n, 2, 0)
		call SetUnitScale(n, 0.75, 0.75, 0.75)
        call SetUnitVertexColor(n, 255, 255, 255, 200)
		call MyRemoveUnit(n, 2.0)
		//call IssueImmediateOrder(caster, "stop")
		call SetUnitVertexColor(caster, 255, 255, 255, 255)
        call SetUnitTargetable(caster, false)
        call SetUnitTargetableTimed(caster, true, 0.5)
		call SetUnitInvulnerable(caster, false)
		call FlushChildHashtable(h, id)
		call PauseTimer(newTimer)
		call DestroyTimer(newTimer)
	endif

	set newTimer=null
	set caster=null
endfunction

function VergilD_Tricker takes unit newCaster, real point_x, real point_y returns nothing
	local timer newTimer = CreateTimer()
	local integer id     = GetHandleId(newTimer)
	local real caster_x  = GetUnitX(newCaster)
	local real caster_y  = GetUnitY(newCaster)
	local real angle     = AtanPoint(caster_x, caster_y, point_x, point_y)
	local real distance  = 500
	local real cooldown  = GetAbilityCooldown(GetUnitAbility(newCaster, 'A0PI'))
//	local boolean fast_cd = false
	
//	if GetRandomInt(1, 10)<=2 then
//		set fast_cd = true
//	endif
    set n=LoadUnitHandle(HH, GetHandleId(newCaster), StringHash("VergilD"))
    call RemoveUnit(n)
    call StartAbilityCooldown(GetUnitAbility(newCaster, 'AP03'), GetAbilityCooldown(GetUnitAbility(newCaster, 'AP03')))

	if GetAbilityRemainingCooldown(GetUnitAbility(newCaster, 'A0PI'))>cooldown*0.5 then
		call StartAbilityCooldown(GetUnitAbility(newCaster, 'A0PI'), GetAbilityRemainingCooldown(GetUnitAbility(newCaster, 'A0PI'))-cooldown*0.5)
    elseif GetAbilityRemainingCooldown(GetUnitAbility(newCaster, 'A0PI'))>0 then
        call StartAbilityCooldown(GetUnitAbility(newCaster, 'A0PI'), 0.01)
	endif
	
    set soundplay=CreateSound("Sound\\war3mapImported\\VergilD1.wav", false, false, true, 12700, 12700, "")
    call StartSound(soundplay)
	call KillSoundWhenDone(soundplay)
	if GetRandomInt(0, 2)==0 then
		set soundplay=CreateSound("Sound\\war3mapImported\\VergilD2.wav", false, false, true, 12700, 12700, "")

	else
		set soundplay=CreateSound("Sound\\war3mapImported\\VergilD_Sound"+I2S(GetRandomInt(1,2))+".mp3",false,false,true,12700,12700,"")
	endif
	call StartSound(soundplay)
	call KillSoundWhenDone(soundplay)
	set n=CreateUnit(GetOwningPlayer(newCaster), 'dR42', caster_x+100*Cos(angle), caster_y+100*Sin(angle), angle*bj_RADTODEG)
	call SetUnitTimeScale(n, 0.7)
	call SetUnitFlyHeight(n, 100, 0)
	call SetUnitVertexColor(n, 255, 255, 255, 200)
	call SetUnitScale(n, 0.7, 0.7, 0.7)
	call MyRemoveUnit(n, 2.0)
	// set n=CreateUnit(GetOwningPlayer(newCaster), 'e2WB', caster_x+100*Cos(angle), caster_y+100*Sin(angle), angle*bj_RADTODEG)
	// call SetUnitTimeScale(n, 1.4)
	// call SetUnitFlyHeight(n, 50, 0)
	// call SetUnitScale(n, 0.45, 0.45, 0.45)
	// call MyRemoveUnit(n, 2.0)
	set n=CreateUnit(GetOwningPlayer(newCaster), 'dH19', caster_x, caster_y, angle*bj_RADTODEG)
	call SetUnitFlyHeight(n, 20, 0)
	call SetUnitVertexColor(n, 255, 255, 255, 200)
	call MyRemoveUnit(n, 2.0)
	set n=CreateUnit(GetOwningPlayer(newCaster), 'd082', caster_x, caster_y, angle*bj_RADTODEG)
	call SetUnitFlyHeight(n, 20, 0)
	call SetUnitScale(n, 1.2, 1.2, 1.2)
	call MyRemoveUnit(n, 2.0)
	
	call RemoveEffect(AddSpecialEffectTarget("war3mapImported\\AZ_LCDark_W2_buff.mdl", newCaster, "right hand"), 1.0, true, CreateTimer())
	call RemoveEffect(AddSpecialEffectTarget("war3mapImported\\AZ_LCDark_W2_buff.mdl", newCaster, "left hand"), 1.0, true, CreateTimer())
	if SquareRootPoint(caster_x, caster_y, point_x, point_y)<600 then
		set distance = SquareRootPoint(caster_x, caster_y, point_x, point_y)
	endif
	call UnitRemoveAbility(newCaster, 'AP04')
	//call IssueImmediateOrder(newCaster, "stop")
	call SetUnitInvulnerable(newCaster, true)
	call SetUnitVertexColor(newCaster, 255, 255, 255, 120)
	call SaveUnitHandle(h, id, 0, newCaster)
	call SaveReal(h, id, 1, angle)
	call SaveReal(h, id, 2, distance)
	call SaveInteger(h, id, 3, 1)
	call TimerStart(newTimer, 0.01, true, function VergilD_Periodic)
	set newTimer=null
endfunction

function InstantSpell_Action takes nothing returns nothing
	// F new Саске
	if GetSpellAbilityId()=='SasF' then
		call SasukeF_Cast(GetSpellAbilityUnit(), GetSpellTargetUnit())
	endif

	// F Vergil
	if GetSpellAbilityId()=='AP03' then
		call VergilD_Tricker(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY())
	endif
    
endfunction

function InitTrig_InstantSpell takes nothing returns nothing
    local trigger trig= CreateTrigger()
    local integer index= 0
    loop
        call TriggerRegisterPlayerUnitEvent(trig, Player(index), EVENT_PLAYER_UNIT_SPELL_CAST, null)
        set index=index + 1
        exitwhen index == bj_MAX_PLAYER_SLOTS
    endloop
    call TriggerAddAction(trig, function InstantSpell_Action)
        set trig=null
endfunction
