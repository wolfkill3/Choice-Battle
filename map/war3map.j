call SaveReal(HH,id,5,time)
if time==1 then
call PauseUnit(caster,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)

else

if time<1 then
call PauseUnit(caster,true)
endif

if time==0.02 then


if LoadBoolean(HH,GetHandleId(caster),StringHash("MadaraSusT2"))==true then
call SetUnitTimeScale(caster,5)
call SetUnitAnimationByIndex(caster,4)
