function Trig_Bunshin_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A009'
endfunction
function Trig_Bunshin_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local player p=GetOwningPlayer(u)
local integer dmg=4*GetHeroInt(u,true)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
if UnitIsAlive(l__d)then
call GroupEnumUnitsInRange(G,x,y,300,Base)
call DestroyEffect(AddSpecialEffect("war3mapImported\\NewDirtEXNofire.mdx",x,y))
call DestroyEffect(AddSpecialEffect("war3mapImported\\explode.mdx",x,y))
call DestroyEffect(AddSpecialEffect("war3mapImported\\LW10.mdx",x,y))
loop
set E=FirstOfGroup(G)
set ide=GetHandleId(E)
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(G,E)
exitwhen E==null
endloop
endif
call UnitApplyTimedLife(l__d,'BTLF',0.05)
call SaveReal(HH,GetHandleId(l__d),TextTagTimeHash,-0.03)
call SaveReal(HH,GetHandleId(l__d),TextTagHealTimeHash,-0.03)
//call FlushChildHashtable(HH,GetHandleId(l__d))
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
set u=null
set l__d=null
set p=null
set t=null
endfunction
function Trig_Bunshin_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
local unit l__d=CreateUnit(GetOwningPlayer(u),'H007',x,y,f)
local string dmgtext=""
local string Healtext=""
local integer i=0
call UnitInventorySetSize(l__d,10)
call SetUnitCurrentSight(l__d,600)
call SetUnitPathing(l__d,false)
call SetUnitXY_1(l__d,x,y, false)
call SetUnitFacing(l__d,f)
call SetHeroLevel(l__d,GetHeroLevel(u),false)
call SetUnitPathing(l__d,true)
loop
exitwhen i>=17
    if Hero[i]!=null then
    call SaveInteger(HH,GetHandleId(l__d),TextDamageValueHash+GetPlayerId(GetOwningPlayer(Hero[i])),LoadInteger(HH,GetHandleId(u),TextDamageValueHash+GetPlayerId(GetOwningPlayer(Hero[i]))))
    if LoadInteger(HH,GetHandleId(l__d),TextDamageValueHash+GetPlayerId(GetOwningPlayer(Hero[i])))==0 then
        call SaveStr(HH,GetPlayerId(GetOwningPlayer(Hero[i])),GetHandleId(l__d)+TextDmgValueTextHash,"")
    else
        call SaveStr(HH,GetPlayerId(GetOwningPlayer(Hero[i])),GetHandleId(l__d)+TextDmgValueTextHash,Color[GetPlayerId(GetOwningPlayer(Hero[i]))]+I2S( LoadInteger(HH,GetHandleId(l__d),TextDamageValueHash+GetPlayerId(GetOwningPlayer(Hero[i]))))+"|r  ")
    endif
    set dmgtext=dmgtext+LoadStr(HH,GetPlayerId(GetOwningPlayer(Hero[i]))+GetHandleId(u),TextDmgValueTextHash)    
    endif
    set i=i+1
endloop
call SaveInteger(HH,GetHandleId(l__d),TextHealValueHash+SH_HealthRes,LoadInteger(HH,GetHandleId(u),TextHealValueHash+SH_HealthRes))
if LoadInteger(HH,GetHandleId(l__d),TextHealValueHash+SH_HealthRes)==0 then
    call SaveStr(HH,GetHandleId(l__d),SH_HealthRes+TextHealValueTextHash,"")
else
    call SaveStr(HH,GetHandleId(l__d),SH_HealthRes+TextHealValueTextHash,Color[13]+"+"+I2S( LoadInteger(HH,GetHandleId(l__d),TextHealValueHash+SH_HealthRes))+"|r  ")
endif
set Healtext=Healtext+LoadStr(HH,GetHandleId(u),SH_HealthRes+TextHealValueTextHash)    
call SaveInteger(HH,GetHandleId(l__d),TextHealValueHash+SH_ManaRes,LoadInteger(HH,GetHandleId(u),TextHealValueHash+SH_ManaRes))
if LoadInteger(HH,GetHandleId(l__d),TextHealValueHash+SH_ManaRes)==0 then
    call SaveStr(HH,GetHandleId(l__d),SH_ManaRes+TextHealValueTextHash,"")
else
    call SaveStr(HH,GetHandleId(l__d),SH_ManaRes+TextHealValueTextHash,Color[12]+"+"+I2S( LoadInteger(HH,GetHandleId(l__d),TextHealValueHash+SH_ManaRes))+"|r  ")
endif
set Healtext=Healtext+LoadStr(HH,GetHandleId(u),SH_ManaRes+TextHealValueTextHash) 
call AllTextTag2(dmgtext,l__d)
call AllTextTagHeal2(Healtext,l__d)
set dmgtext=""
set Healtext=""
call IssuePointOrder(l__d,"move",x+200*Cos(f*bj_DEGTORAD),y+200*Sin(f*bj_DEGTORAD))
set i=0
loop
exitwhen i>=10
if GetItemTypeId(UnitItemInSlot(u,i))!='I039' then
set bj_lastCreatedItem=UnitAddItemById(l__d,GetItemTypeId(UnitItemInSlot(u,i)))
call SetItemDroppable(bj_lastCreatedItem,false)
endif
set i=i+1
endloop
call SaveReal(HH,GetHandleId(u),TextTagTimeHash,-0.03)
call SaveReal(HH,GetHandleId(u),TextTagHealTimeHash,-0.03)
call SetUnitState(l__d,UNIT_STATE_LIFE,GetWidgetLife(u))
call SetUnitState(l__d,UNIT_STATE_MANA,GetWidgetMana(u))
call UnitEnableInventoryCustom(l__d,false,false)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,l__d)
call TimerStart(t,3,false,function Trig_Bunshin_Actions2)

set u=null
set l__d=null
set t=null
endfunction
function InitTrig_Bunshin takes nothing returns nothing
set gg_trg_Bunshin=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Bunshin,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_Bunshin,Condition(function Trig_Bunshin_Conditions))
call TriggerAddAction(gg_trg_Bunshin,function Trig_Bunshin_Actions)
endfunction
function GenjutsuMasterCond takes nothing returns boolean
return(GetSpellAbilityId()=='A1D0' or GetSpellAbilityId()=='A12E' or GetSpellAbilityId()=='A008' or GetSpellAbilityId()=='A03B' or GetSpellAbilityId()=='A12K')and GetHeroLevel(GetTriggerUnit())>5 and GetSpellAbilityId()!='A009' and GetUnitTypeId(GetTriggerUnit())=='H006' or GetUnitTypeId(GetTriggerUnit())=='H037'
endfunction
function GenjutsuMasterCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real dist=0
local integer i=0
local player p=GetOwningPlayer(u)
set n=CreateUnit(p,'h019',x,y,GetRandomReal(0,359))
call UnitAddAbility(n,'A12G')
call UnitApplyTimedLife(n,'BTLF',1)
call IssueTargetOrder(n,"invisibility",u)
loop
exitwhen i>=8
set n=CreateUnit(p,'u000',x,y,GetRandomReal(0,359))
call SetUnitMoveSpeed(n,100)
call SetUnitScale(n,1,1,1)
call UnitAddAbility(n,'A00D')
call SetUnitFlyHeight(n,GetRandomReal(55,95),0)
set dist=GetRandomReal(250,350)
call UnitApplyTimedLife(n,'BTLF',dist/100)
call Fade(n,0,0,0,255,dist/100)
call IssuePointOrder(n,"move",x+dist*Cos(GetRandomReal(0,6.28)),y+dist*Sin(GetRandomReal(0,6.28)))
set i=i+1
endloop
set p=null
set u=null
endfunction
function InitTrig_GenjutsuMaster takes nothing returns nothing
set gg_trg_GenjutsuMaster=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_GenjutsuMaster,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_GenjutsuMaster,Condition(function GenjutsuMasterCond))
call TriggerAddAction(gg_trg_GenjutsuMaster,function GenjutsuMasterCast)
endfunction
function Trig_Tsukuoymi_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A008' and udg_B==true
endfunction
function MissleMovePointTsukuoymi2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
if SR(x,y,x1,y1)>30 then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitAnimation(l__d,"walk")
else
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set t=null
endfunction
function MissleMovePointTsukuoymi takes unit l__d,real speed,real angle,real x,real y returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call TimerStart(t,0.03,true,function MissleMovePointTsukuoymi2)
set t=null
endfunction
function Trig_Tsukuoymi_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real x=0
local real y=0
local real x2=0
local real y2=0
local real r=GetRandomReal(0,360*bj_DEGTORAD)
local real r2=GetRandomReal(0,360*bj_DEGTORAD)
local real a2=0
local real a=0
local player p=GetOwningPlayer(u)
local integer idn='e003'
if GetUnitCurrentOrder(u)==OrderId("channel") and UnitIsAlive(c) and LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
if GetUnitAbilityLevel(u,'S004')>0 then
set idn='e0N3'
endif
call SetControlToUnit(c,c,0.5,"stunbkb")
call myCustomDamage(u,c,(1+0.5*GetUnitAbilityLevel(u,'A008'))*GetHeroInt(u,true)/10,false,false,null,null,null)
if IsUnitInvulnerable(c)==true then
call IssueImmediateOrder(u,"stop")
endif
set x=x1-350*Cos(r)
set y=y1-350*Sin(r)
set x2=x1-100*Cos(r2)
set y2=y1-100*Sin(r2)
set a=Atan2(y1-y,x1-x)
set a2=Atan2(y1-y2,x1-x2)
set n=CreateUnit(p,idn,x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,125,125,125,255)
call SetUnitTimeScale(n,3)
call MissleMovePointTsukuoymi(n,30,0,x1+350*Cos(a),y1+350*Sin(a))
set n=CreateUnit(p,idn,x2,y2,a2*bj_RADTODEG)
call SetUnitVertexColor(n,125,125,125,255)
call SetUnitTimeScale(n,3)
call UnitApplyTimedLife(n,'BTLF',0.3)
call SetUnitAnimation(n,"attack")
call UnitApplyTimedLife(CreateUnit(p,'e0FX',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",c,"chest"))
else
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==true then
call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
endif
call PauseTimer(t)
call DestroyTimer(t)
call RemoveUnit(LoadUnitHandle(h,id,2))
call RemoveUnit(LoadUnitHandle(h,id,3))
call FlushChildHashtable(h,id)
endif
set p=null
set c=null
set u=null
set t=null
endfunction
function Trig_Tsukuoymi_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local real x=GetUnitX(c)
local real y=GetUnitY(c)
local player p=GetOwningPlayer(u)
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveUnitHandle(h,id,2,CreateUnit(p,'e001',x,y,0))
call SaveUnitHandle(h,id,3,CreateUnit(p,'e002',x,y,0))
set soundplay=SndN(2284) // Sound\Music\mp3Music\Tsukuoymi.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.1,true,function Trig_Tsukuoymi_Actions2)
set u=null
set p=null
set c=null
set t=null
endfunction
function InitTrig_Tsukuoymi takes nothing returns nothing
set gg_trg_Tsukuoymi=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Tsukuoymi,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_Tsukuoymi,Condition(function Trig_Tsukuoymi_Conditions))
call TriggerAddAction(gg_trg_Tsukuoymi,function Trig_Tsukuoymi_Actions)
endfunction
