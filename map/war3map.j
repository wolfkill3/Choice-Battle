function CastNC2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(HH,id,1)
local group g2
local integer i=0
local integer l__s
local integer time=LoadInteger(HH,id,5)
call SaveInteger(HH,id,5,time+1)
if time<15 and udg_B then
set g2=CopyGroup(g)
loop
set E=FirstOfGroup(g2)
exitwhen E==null
set ide=GetHandleId(E)
if IsUnitEnemy(E,p)and GetUnitAbilityLevel(E,'B026')==0 then
set i=LoadInteger(HH,ide,SH_makaagi)
set l__s=GetHeroAgi(E,false)
call SetHeroAgi(E,l__s+i,false)
set i=LoadInteger(HH,ide,SH_makastr)
set l__s=GetHeroStr(E,false)
call SetHeroStr(E,l__s+i,false)
set i=LoadInteger(HH,ide,SH_makaint)
set l__s=GetHeroInt(E,false)
call SetHeroInt(E,l__s+i,false)
call GroupRemoveUnit(g,E)
elseif IsUnitAlly(E,p)and GetUnitAbilityLevel(E,'B025')==0 then
set i=LoadInteger(HH,ide,SH_makaagi)
set l__s=GetHeroAgi(E,false)
call SetHeroAgi(E,l__s-i,false)
set i=LoadInteger(HH,ide,SH_makastr)
set l__s=GetHeroStr(E,false)
call SetHeroStr(E,l__s-i,false)
set i=LoadInteger(HH,ide,SH_makaint)
set l__s=GetHeroInt(E,false)
call SetHeroInt(E,l__s-i,false)
call GroupRemoveUnit(g,E)
endif
call GroupRemoveUnit(g2,E)
endloop
call DestroyGroupTimed(g2,3)
else
set g2=CopyGroup(g)
loop
set E=FirstOfGroup(g2)
exitwhen E==null
set ide=GetHandleId(E)
if IsUnitEnemy(E,p)then
set i=LoadInteger(HH,ide,SH_makaagi)
set l__s=GetHeroAgi(E,false)
call SetHeroAgi(E,l__s+i,false)
set i=LoadInteger(HH,ide,SH_makastr)
set l__s=GetHeroStr(E,false)
call SetHeroStr(E,l__s+i,false)
set i=LoadInteger(HH,ide,SH_makaint)
set l__s=GetHeroInt(E,false)
call SetHeroInt(E,l__s+i,false)
call GroupRemoveUnit(g,E)
elseif IsUnitAlly(E,p)then
set i=LoadInteger(HH,ide,SH_makaagi)
set l__s=GetHeroAgi(E,false)
call SetHeroAgi(E,l__s-i,false)
set i=LoadInteger(HH,ide,SH_makastr)
set l__s=GetHeroStr(E,false)
call SetHeroStr(E,l__s-i,false)
set i=LoadInteger(HH,ide,SH_makaint)
set l__s=GetHeroInt(E,false)
call SetHeroInt(E,l__s-i,false)
call GroupRemoveUnit(g,E)
endif
call GroupRemoveUnit(g2,E)
endloop
call DestroyGroupTimed(g2,3)
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set g=null
set g2=null
set u=null
set t=null
set p=null
endfunction
function CastNC takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local group g=CreateGroup()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local integer i
local integer lvl=GetUnitAbilityLevel(u,'A0BM')
local real c=0.2
call GroupEnumUnitsInRange(G,x,y,500,Base)
loop
set E=FirstOfGroup(G)
set ide=GetHandleId(E)
if IsUnitEnemy(E,p)and IsUnitType(E,UNIT_TYPE_HERO)then
set i=GetHeroAgi(E,false)
call SetHeroAgi(E,i-R2I(I2R(i)*c),false)
call SaveInteger(HH,ide,SH_makaagi,R2I(I2R(i)*c))
set i=GetHeroStr(E,false)
call SetHeroStr(E,i-R2I(I2R(i)*c),false)
call SaveInteger(HH,ide,SH_makastr,R2I(I2R(i)*c))
set i=GetHeroInt(E,false)
call SetHeroInt(E,i-R2I(I2R(i)*c),false)
call SaveInteger(HH,ide,SH_makaint,R2I(I2R(i)*c))
elseif(IsUnitAlly(E,p)or E==u)and IsUnitType(E,UNIT_TYPE_HERO)then
set i=GetHeroAgi(E,false)
call SetHeroAgi(E,i+R2I(I2R(i)*c),false)
call SaveInteger(HH,ide,SH_makaagi,R2I(I2R(i)*c))
set i=GetHeroStr(E,false)
call SetHeroStr(E,i+R2I(I2R(i)*c),false)
call SaveInteger(HH,ide,SH_makastr,R2I(I2R(i)*c))
set i=GetHeroInt(E,false)
call SetHeroInt(E,i+R2I(I2R(i)*c),false)
call SaveInteger(HH,ide,SH_makaint,R2I(I2R(i)*c))
endif
call GroupAddUnit(g,E)
call GroupRemoveUnit(G,E)
exitwhen E==null
endloop
set n=CreateUnit(p,'h019',x,y,0)
call UnitAddAbility(n,'A0BQ')
call SetUnitAbilityLevel(n,'A0BQ',lvl)
call UnitApplyTimedLife(n,'BTLF',1)
call IssueImmediateOrderById(n,852285)
set n=CreateUnit(p,'h019',x,y,0)
call UnitAddAbility(n,'A0BP')
call SetUnitAbilityLevel(n,'A0BP',lvl)
call UnitApplyTimedLife(n,'BTLF',1)
call IssueImmediateOrderById(n,852285)
set n=CreateUnit(p,'h019',x,y,0)
call UnitAddAbility(n,'A0BN')
call SetUnitAbilityLevel(n,'A0BN',lvl)
call UnitApplyTimedLife(n,'BTLF',1)
call IssueImmediateOrder(n,"battleroar")
set n=CreateUnit(p,'h019',x,y,0)
call UnitAddAbility(n,'A0BO')
call SetUnitAbilityLevel(n,'A0BO',lvl)
call UnitApplyTimedLife(n,'BTLF',1)
call IssueImmediateOrder(n,"battleroar")
call UnitApplyTimedLife(CreateUnit(p,'e050',x,y,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e061',x,y,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0F2',x,y,0),'BTLF',3)
call SaveUnitHandle(HH,id,0,u)
call SaveGroupHandle(HH,id,1,g)
call SaveInteger(HH,id,5,0)
set soundplay=SndN(1063) // Sound\Music\mp3Music\MakaSoulResonans.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,1,true,function CastNC2)
set g=null
set u=null
set t=null
set p=null
endfunction
