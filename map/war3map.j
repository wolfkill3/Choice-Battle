function QRinCastTarget2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local integer idd=GetHandleId(l__d)
local integer i=LoadInteger(h,id,3)
local player p=GetOwningPlayer(u)
if i<7 then
call SaveInteger(h,id,3,i+1)
else
call UnitRemoveAbility(l__d,'A1G0')
call PauseTimer(t)
call DestroyTimer(t)
call RemoveSavedHandle(h,idd,SH_QR2)
call RemoveSavedReal(h,idd,SH_QR1)
call RemoveSavedReal(h,idd,SH_QR3)
call FlushChildHashtable(h,id)
endif
set u=null
set l__d=null
set t=null
set p=null
endfunction
function QRinCastTarget takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local integer idd=GetHandleId(c)
local player p=GetOwningPlayer(u)
local unit l__d=LoadUnitHandle(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
if SR(x,y,x1,y1)>50 then
set n=CreateUnit(p,GetUnitTypeId(l__d),x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.05)
call SetUnitVertexColor(n,255,255,255,55)
call SetUnitScale(n,1,1,1)
set x=x+15*Cos(a)
set y=y+15*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
else
call UnitAddAbility(c,'A1G0')
call SaveReal(h,idd,SH_QR1,GetHeroInt(u,true)*(1+GetUnitAbilityLevel(u,'A1FV')))
call SaveReal(h,idd,SH_QR3,GetHeroInt(u,true)*(1+GetUnitAbilityLevel(u,'A1FV')))
call SaveUnitHandle(h,idd,SH_QR2,u)
// длительность щита в статус-баре (снимается на 8-м тике секундного таймера)
call CreateModeIndicatorFormDispellable(c, "ReplaceableTextures\\CommandButtons\\BTNRinQ.blp", 8, 'A1G0')
call RemoveUnit(l__d)
call SaveInteger(h,id,3,0)
call PauseTimer(t)
call TimerStart(t,1,true,function QRinCastTarget2)
endif
set p=null
set c=null
set l__d=null
set t=null
set u=null
endfunction
function QRinCastPoint takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,1)
local real dmg=GetHeroInt(u,true)*(1+GetUnitAbilityLevel(u,'A1FV'))
local unit l__d
local real a=0
local real x=0
local real y=0
local integer i=3
local integer idu
local real dist=LoadReal(h,id,6)
local integer lvl=GetUnitAbilityLevel(u,'A1G4')
if dist>0 then
call SaveReal(h,id,6,dist-20)
loop
exitwhen i>=6
set l__d=LoadUnitHandle(h,id,i)
set a=GetUnitFacing(l__d)*bj_DEGTORAD
set x=GetUnitX(l__d)
set y=GetUnitY(l__d)
set idu=GetUnitTypeId(l__d)
set n=CreateUnit(p,idu,x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.05)
call SetUnitVertexColor(n,255,255,255,55)
call SetUnitScale(n,1,1,1)
set x=x+20*Cos(a)
set y=y+20*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call GroupEnumUnitsInRange(G,x,y,100,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)and IsUnitInGroup(E,g)==false then
if LoadBoolean(h,GetHandleId(E),'RQG+')==true and lvl>0 then
call UnitRemoveAbility(u,'A1G5')
call UnitAddAbility(u,'A1G5')
call SetUnitAbilityLevel(u,'A1G5',lvl)
call UnitMakeAbilityPermanent(u,true,'A1G5')
endif
if idu=='e15S' then
call UnitAddAbility(E,'A1FR')
elseif idu=='e15T' then
call UnitAddAbility(E,'A1FS')
elseif idu=='e15U' then
call UnitAddAbility(E,'A1FT')
endif
call SaveBoolean(h,GetHandleId(E),'RQG+',true)
call RemoveSaveHashTimed(3,GetHandleId(E),'RQG+')
call GroupAddUnit(g,E)
endif
call GroupRemoveUnit(G,E)
endloop
set i=i+1
endloop
else
loop
set E=FirstOfGroup(g)
exitwhen E==null
if GetUnitAbilityLevel(E,'A1FR')>0 then
call UnitRemoveAbility(E,'A1FR')
set dmg=dmg+GetUnitState(E,UNIT_STATE_MAX_LIFE)*0.1
call DestroyEffect(AddSpecialEffect("sound\\NewGroundEX.mdx",GetUnitX(E),GetUnitY(E)))
elseif GetUnitAbilityLevel(E,'A1FS')>0 then
call UnitRemoveAbility(E,'A1FS')
call DestroyEffect(AddSpecialEffect("war3mapImported\\File00000377.mdx",GetUnitX(E),GetUnitY(E)))
call SlowUnit(u,E,0.3,0.3,3,2,false)
call SetControlToUnit(E,E,3,"silence")
elseif GetUnitAbilityLevel(E,'A1FT')>0 then
call UnitRemoveAbility(E,'A1FT')
call DestroyEffect(AddSpecialEffect("war3mapImported\\ReiatsuOverFlowbyDeckai.mdx",GetUnitX(E),GetUnitY(E)))
call CC_UnitEx( E, E, 0., 2, "stun", false, "Abilities\\Spells\\Undead\\FreezingBreath\\FreezingBreathTargetArt.mdl", "origin", 0,0 )
endif
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call GroupRemoveUnit(g,E)
endloop
call GroupClear(g)
call DestroyGroup(g)
call RemoveUnit(LoadUnitHandle(h,id,3))
call RemoveUnit(LoadUnitHandle(h,id,4))
call RemoveUnit(LoadUnitHandle(h,id,5))
call FlushChildHashtable(h,id)
call DestroyTimer(t)
endif
set p=null
set l__d=null
set t=null
set u=null
set g=null
endfunction
function QRinCast takes nothing returns nothing
local timer t
local integer id=0
local unit u=GetTriggerUnit()
local unit c
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=0
local real a2=0
local player p=GetOwningPlayer(u)
local integer array ui
local integer i=1
local integer ri=0
local real time=LoadReal(HH, GetHandleId(LoadFrameHandle(HH, GetHandleId(p),SH_ReplaceableTextures_CommandButtons_BTNRinW_blp)), c_DURATION) //WRIN
if time>0 then
call SaveReal(HH, GetHandleId(LoadFrameHandle(HH, GetHandleId(p),SH_ReplaceableTextures_CommandButtons_BTNRinW_blp)), c_DURATION,time+0.5+0.25*GetUnitAbilityLevel(u,'A1FX'))
endif
set c=GetSpellTargetUnit()
if c!=null and c!=u and IsUnitEnemy(u,GetOwningPlayer(c))==false then
set a=Atan2(y1-y,x1-x)
set t=CreateTimer()
set id=GetHandleId(t)
set x=x+75*Cos(a)
set y=y+75*Sin(a)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
set ui[1]='e15S'
set ui[2]='e15T'
set ui[3]='e15U'
call SaveUnitHandle(h,id,2,CreateUnit(p,ui[GetRandomInt(1,3)],x,y,a*bj_RADTODEG))
call TimerStart(t,0.01,true,function QRinCastTarget)
elseif c==null or IsUnitEnemy(u,GetOwningPlayer(c))then
set a=Atan2(y1-y,x1-x)
set t=CreateTimer()
set id=GetHandleId(t)
set x=x+75*Cos(a)
set y=y+75*Sin(a)
set ui[1]='e15S'
set ui[2]='e15T'
set ui[3]='e15U'
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,1,CreateGroup())
call SaveReal(h,id,2,a)
call SaveReal(h,id,6,3000)
call SaveUnitHandle(h,id,3,CreateUnit(p,ui[GetRandomInt(1,3)],x,y,a*bj_RADTODEG-20))
call SaveUnitHandle(h,id,4,CreateUnit(p,ui[GetRandomInt(1,3)],x,y,a*bj_RADTODEG))
call SaveUnitHandle(h,id,5,CreateUnit(p,ui[GetRandomInt(1,3)],x,y,a*bj_RADTODEG+20))
call TimerStart(t,0.01,true,function QRinCastPoint)
endif
set soundplay=SndN(2906) // Sound\Music\mp3Music\RinLightBullet.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set p=null
set c=null
set u=null
set t=null
endfunction
