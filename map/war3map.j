call SetUnitInvulnerable(caster,false)
call PauseUnit(target,false)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
call SetUnitInvulnerable(target,false)
if HogCond==1 then



call myCustomDamage(casterOriginal,target,damage,false,false,null,null,null)


call EffectCreateAndMove(true,"Sabrac\\File00003933.mdl",facing,1,1.25,1.25,100,100,100,0,50,target,0,facing)
