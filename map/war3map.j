function CastCS takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local group g=CreateGroup()
local player p=GetOwningPlayer(u)
local group l__n=CreateGroup()
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
call SaveUnitHandle(h,id,0,u)
call GroupEnumUnitsInRange(g,x,y,455,Base)
loop
set E=FirstOfGroup(g)
if Condition_Base(p,E)then
call GroupAddUnit(l__n,E)
call SavePlayerHandle(h,GetHandleId(E),SH_CS,GetOwningPlayer(E))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\s_ShadowEruption_Rain.mdx",E,"chest"))
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
set soundplay=SndN(1023) // Sound\Music\mp3Music\Mukuro2Form.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call UnitApplyTimedLife(CreateUnit(p,'e029',x,y,GetRandomReal(0,360)),'BTLF',1)
call SaveGroupHandle(h,GetHandleId(u),SH_GB,l__n)
call SaveBoolean(h,GetHandleId(u),SH_bullet,true)
call TimerStart(t,1,true,function CastCS2)
call DestroyGroup(g)
set p=null
set g=null
set u=null
set t=null
endfunction
