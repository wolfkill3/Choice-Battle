function LearnQShikiCond takes nothing returns boolean
return GetLearnedSkill()=='A1BO'
endfunction
function ComboBar2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
call SetUnitTimeScale(LoadUnitHandle(HH,GetHandleId(LoadUnitHandle(HH,id,0)),ComboBarHash),LoadReal(HH,id,1))
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
set t=null
endfunction
function ComboBar takes unit u,real r returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(HH,id,0,u)
call SaveReal(HH,id,1,r)
call TimerStart(t,0.03,false,function ComboBar2)
set t=null
endfunction
function ShikiComboStarter takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local integer idu=GetHandleId(u)
local integer idp=GetHandleId(GetOwningPlayer(u))
local unit c=LoadUnitHandle(HH,idp,ComboBarHash)
local real ml=GetUnitState(u,UNIT_STATE_MAX_LIFE)
local real time=LoadReal(HH,idu,ComboTimerHash)
// юнит пересоздан или удалён (обмен, повторный выбор) — этот таймер больше не нужен
if u!=null and GetUnitTypeId(u)!=0 then
call SetUnitX(c,GetUnitX(u))
call SetUnitY(c,GetUnitY(u))
call SetUnitFlyHeight(c,GetUnitFlyHeight(u)+300,0)
if GetUnitAbilityLevel(u,'A1BT')!=0 then
call SetUnitAbilityLevel(u,'A1BU',GetUnitAbilityLevel(u,'A1BT'))
call SetUnitAbilityLevel(u,'A1BV',GetUnitAbilityLevel(u,'A1BT'))
call SetUnitAbilityLevel(u,'A23W',GetUnitAbilityLevel(u,'A1BT'))
endif
if GetUnitAbilityLevel(u,'A1BO')!=0 then
call SetUnitAbilityLevel(u,'A1BP',GetUnitAbilityLevel(u,'A1BO'))
call SetUnitAbilityLevel(u,'A1BQ',GetUnitAbilityLevel(u,'A1BO'))
call SetUnitAbilityLevel(u,'A1BR',GetUnitAbilityLevel(u,'A1BO'))
endif
if GetUnitAbilityLevel(u,'A1BW')!=0 then
call SetUnitAbilityLevel(u,'A1BX',GetUnitAbilityLevel(u,'A1BW'))
call SetUnitAbilityLevel(u,'A1BY',GetUnitAbilityLevel(u,'A1BW'))
endif
if ml*0.40>GetWidgetLife(u)then
        if GetWidgetLife(u)<=ml*0.25 then
                call UnitRemoveBuffs(u,false,true)
        endif
        if GetUnitAbilityLevel(u,'A1C4')==0 then
                call UnitAddAbility(u,'A1C4')
        endif
elseif ml*0.40<GetWidgetLife(u)and GetUnitAbilityLevel(u,'A1C4')!=0 then
        call UnitRemoveAbility(u,'A1C4')
endif
if time>0 and GetUnitAbilityLevel(u,'A1BI')==0 then
call SaveReal(HH,idu,ComboTimerHash,time-0.02)
elseif time<0.1 and GetUnitAbilityLevel(u,'A1BI')==0 then
call SetUnitTimeScale(LoadUnitHandle(HH,idp,ComboBarHash),-10000000)
call SetUnitColor(LoadUnitHandle(HH,idp,ComboBarHash),PLAYER_COLOR_LIGHT_GRAY)
call RemoveUnit(LoadUnitHandle(HH,idu,SH_CST))
call RemoveSavedHandle(HH,idu,SH_CST)
call SaveInteger(HH,idu,ComboCounterHash,0)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1BV',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A23W',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1BU',true)
call SetAbilityIntegerLevelField(GetUnitAbility(u,'A1BZ'), ABILITY_ILF_TARGET_TYPE,0,2)
call SetAbilityRealLevelField(GetUnitAbility(u,'A1BZ'), ABILITY_RLF_CAST_RANGE,0,99999)
endif
else
// полоску не трогаем: у удалённого юнита владелец уже другой, это была бы чужая полоска
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set c=null
set u=null
set t=null
endfunction
function LearnQShikiCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local integer idu=GetHandleId(u)
local integer idp=GetHandleId(p)
local integer lvl=GetUnitAbilityLevel(u,'A1BO')
if lvl==1 and u==Hero[GetPlayerId(p)] then
call AddUnitAnimationProperties(u,"nanaya",true)
call UnitAddAbility(u,'A1BP')
call UnitMakeAbilityPermanent(u,true,'A1BP')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1BP',true)
call UnitAddAbility(u,'A1BQ')
call UnitMakeAbilityPermanent(u,false,'A1BQ')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1BQ',false)
call UnitAddAbility(u,'A1BR')
call UnitMakeAbilityPermanent(u,false,'A1BR')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1BR',false)
call SaveUnitHandle(HH,id,0,u)
call SaveReal(HH,idu,ComboTimerHash,0)
call SaveReal(HH,idu,ComboTimerHash,0)
call SaveReal(HH,idu,ComboCounterHash,0)
if LoadUnitHandle(HH,idp,ComboBarHash)==null then
set n=CreateUnit(p,'e11G',GetUnitX(u),GetUnitY(u),GetUnitFacing(u))
call SetUnitFlyHeight(n,GetUnitFlyHeight(u)+300,0)
call UnitAddAbility(n,'A0A1')
call SetUnitColor(n,PLAYER_COLOR_LIGHT_GRAY)
call SetUnitTimeScale(n,10000)
call SaveUnitHandle(HH,idp,ComboBarHash,n)
call ComboBar(u,-.5)
call TimerStart(t,0.02,true,function ShikiComboStarter)
endif
else
call SetUnitAbilityLevel(u,'A1BP',lvl)
call SetUnitAbilityLevel(u,'A1BQ',lvl)
call SetUnitAbilityLevel(u,'A1BR',lvl)
call DestroyTimer(t)
endif
set t=null
set p=null
set u=null
endfunction
function InitTrig_LearnQShiki takes nothing returns nothing
set gg_trg_LearnQShiki=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_LearnQShiki,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(gg_trg_LearnQShiki,Condition(function LearnQShikiCond))
call TriggerAddAction(gg_trg_LearnQShiki,function LearnQShikiCast)
endfunction
