call DestroyEffect(LoadEffectHandle(HH,idu,StringHash("yamatoEffect2")))
call DestroyEffect(LoadEffectHandle(HH,idu,StringHash("yamatoEffect3")))
call PauseTimer(t)
endif
set u=null
set p=null
set t=null
endfunction
