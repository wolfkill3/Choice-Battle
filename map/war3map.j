    //#ExportTo Scripts\API\MUI.j
    function SetMUITimerEx takes hashtable table, integer pid returns integer
        local integer MaxTimer = 1000
        local integer idp=GetHandleId(Player( pid ))
        local integer Iterator = LoadInteger( table, idp, TIMER_ITERATOR_HASH )
    
        if pid >= 12 and pid <= 15 then
            set MaxTimer = 4000
        endif
    
        loop
            exitwhen not LoadBoolean( table, GetHandleId( LoadTimerHandle( table, idp, StringHash( "Timer_Num_" + I2S( Iterator ) ) ) ), TIMER_STARTED_HASH ) and Iterator <= MaxTimer
            if Iterator > MaxTimer then
                set Iterator = 0
            else
                set Iterator = Iterator + 1
            endif
        endloop
    
        call SaveInteger( table, idp, TIMER_ITERATOR_HASH, Iterator )
    
        if LoadTimerHandle( table, idp, StringHash( "Timer_Num_" + I2S( Iterator ) ) ) == null then
            call SaveTimerHandle( table, idp, StringHash( "Timer_Num_" + I2S( Iterator ) ), CreateTimer( ) )
        endif
    
        return GetHandleId( LoadTimerHandle( table, idp, StringHash( "Timer_Num_" + I2S( Iterator ) ) ) )
    endfunction
    
    function LoadMUITimerEx takes hashtable table, integer pid returns timer
        local integer Iterator = LoadInteger( table, GetHandleId( Player( pid ) ), TIMER_ITERATOR_HASH )
        call SaveBoolean( table, GetHandleId( LoadTimerHandle( table, GetHandleId( Player( pid ) ), StringHash( "Timer_Num_" + I2S( Iterator ) ) ) ), TIMER_STARTED_HASH, true )
        return LoadTimerHandle( table, GetHandleId( Player( pid ) ), StringHash( "Timer_Num_" + I2S( Iterator ) ) )
    endfunction
    
    function SetMUITimer takes integer pid returns integer
        return SetMUITimerEx( htMain, pid )
    endfunction
    
    function LoadMUITimer takes integer pid returns timer
        return LoadMUITimerEx( htMain, pid )
    endfunction
    
    function TimerPause1 takes timer LocTimer returns nothing
        if LoadBoolean( htMain, GetHandleId( LocTimer ), TIMER_STARTED_HASH ) then
            call PauseTimer( LocTimer )
            //call DestroyTimer(LocTimer)
            call SaveBoolean( htMain, GetHandleId( LocTimer ), TIMER_STARTED_HASH, false )
        endif
    endfunction 
    
    function TimerResume1 takes timer LocTimer returns nothing
        if not LoadBoolean( htMain, GetHandleId( LocTimer ), TIMER_STARTED_HASH ) then
            call ResumeTimer( LocTimer )
            call SaveBoolean( htMain, GetHandleId( LocTimer ), TIMER_STARTED_HASH, true )
        endif
    endfunction
    
    function PTimer takes handle target, string hashname returns integer
