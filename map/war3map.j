call KillSoundWhenDone(soundplay)
call UnitSpeed(caster,1)
call EffectCreateAndMove(true,"BlackGoku\\[A]az_axe_ef1.mdl",GetRandomReal(0,360),1.25,1,0.5,100,60,60,0,0,caster,0,facing)
