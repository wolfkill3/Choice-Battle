function SuperExplosionWaveCond takes nothing returns boolean
return GetSpellAbilityId()==0x41305037
endfunction
function SuperExplosionWaveCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local integer i=1
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real dmg=(4+GetUnitAbilityLevel(u,0x41305037))*GetHeroAgi(u,true)
if GetUnitAbilityLevel(u,0x42303434)>0 then
set dmg=dmg+(1.75+GetUnitAbilityLevel(u,0x41305038)*0.50)*GetHeroAgi(u,true)+(1.75+GetUnitAbilityLevel(u,0x41305038)*0.50)*GetHeroStr(u,true)
endif
set soundplay=CreateSound("Sound\\Music\\mp3Music\\SuperExploWave.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call UnitApplyTimedLife(CreateUnit(p,'e0S4',x,y,GetRandomReal(0,359)),1,4)
call UnitApplyTimedLife(CreateUnit(p,'e0S5',x,y,GetRandomReal(0,359)),1,6)
call UnitApplyTimedLife(CreateUnit(p,'e0S3',x,y,GetRandomReal(0,359)),1,4)
call UnitApplyTimedLife(CreateUnit(p,0x65305332,x,y,GetRandomReal(0,359)),1,4)
call UnitApplyTimedLife(CreateUnit(p,'e0S6',x,y,GetRandomReal(0,359)),1,4)
call UnitApplyTimedLife(CreateUnit(p,'e0S7',x,y,GetRandomReal(0,359)),1,3)
call GroupEnumUnitsInRange(G,x,y,850,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call Push(E,30,Atan2(GetUnitY(E)-y,GetUnitX(E)-x),700)
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(G,E)
endloop
call UnitRemoveAbility(u,0x42303434)
call SetUnitTimeScale(u,1)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set u=null
set p=null
set t=null
endfunction
function SuperExplosionWaveCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
call SaveUnitHandle(h,id,0,u)
call PauseUnit(u,true)
call SetUnitTimeScale(u,0.5)
call SetUnitInvulnerable(u,true)
if GetUnitAbilityLevel(u,'A171')==0 then
call SetUnitAnimation(u,"Stand Swim")
else
call SetUnitAnimation(u,"Stand Swim Alternate")
endif
call TimerStart(t,2,false,function SuperExplosionWaveCast2)
set u=null
set t=null
set p=null
endfunction
