call LANG_A('A02D',1,2,"\"Path of Hell\": Mukuro breaks the ground under the enemies' feet (5*|r|c0077FFFFINT|r|cFF00A5FF). \"Path of the Animals\": Each enemy within a radius of 400 is grabbed and held for 4 seconds. snake (100 per sec.). \"Path of Demons\": Mukuro runs in the direction he is looking and attacks all oppon"+"ents (distance 750, damage (4*|r|c0077FFFFINT|r|cFF00A5FF). \"Path of People\": HP regeneration, Mukuro's damage and defense increase (+30 ,+60%,+10 pts for 15 sec) Path of Paradise: Mukuro creates (6) copies of himself (copies deal 25% damage and take 100% damage for 15 sec).|n|n|cFF00A5FF|nCooldow"+"n: 20 seconds|r")
call LANG_A('A02D',1,3,"\"Path of Hell\": Mukuro breaks the ground under the enemies' feet (6*|r|c0077FFFFINT|r|cFF00A5FF). \"Path of the Animals\": Each enemy within a radius of 400 is grabbed and held for 4 seconds. snake 125 in sec.). \"Path of Demons\": Mukuro runs in the direction he is looking and attacks all opponen"+"ts (distance 750, damage (5*|r|c0077FFFFINT|r|cFF00A5FF). \"Path of People\": HP regeneration, Mukuro's damage and defense increase (+40 ,+80%,+13 pts for 15 sec) Path of Paradise: Mukuro creates (8) copies of himself (copies deal 25% damage and take 100% damage for 15 sec).|n|n|cFF00A5FF|nCooldown:"+" 20 seconds|r")
