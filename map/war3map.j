endfunction
function OgiShikenCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local real x2=GetUnitX(c)
local real y2=GetUnitY(c)
local real f=GetUnitFacing(u)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroInt(u,true)*(GetUnitAbilityLevel(u,'A0LV')+3)
local real dist=SR(x,y,x2,y2)
local real a=Atan2(y2-y,x2-x)
local real he=0
if dist>26.00 and udg_B==true and DU2==true then
call SetUnitXY_1(u,x+43*Cos(a),y+43*Sin(a), false)
call SetUnitFacing(u,a*bj_RADTODEG)
set he=ParabolaZ(400,SR(x1,y1,x2,y2),dist)
call SetUnitFlyHeight(u,he,0)
call SetUnitAnimation(u,"attack")
set n=CreateUnit(p,'e0I0',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.70)
call SetUnitFlyHeight(n,he,0)
call SetUnitTimeScale(n,2)
else
call SetUnitInvulnerable(u,false)
call GroupEnumUnitsInRange(G,x2,y2,400,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call Push(E,30,Atan2(GetUnitY(E)-y2,GetUnitX(E)-x2),300)
else
call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,u)
endif
endif
call GroupRemoveUnit(G,E)
endloop
call PauseUnit(u,false)
call SetUnitFlyHeight(u,0,0)
call SetUnitTimeScale(u,1)
call UnitApplyTimedLife(CreateUnit(p,'e0HW',x2,y2,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0HX',x2,y2,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0HY',x2,y2,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0HZ',x2,y2,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0HV',x2,y2,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0HU',x2,y2,GetRandomReal(0,359)),'BTLF',2)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
endif
set c=null
set u=null
set t=null
set p=null
endfunction
