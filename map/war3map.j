function MissleMovePlasmaShot2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit l__d=LoadUnitHandle(h,id,2)
local real speed=LoadReal(h,id,4)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)+LoadReal(h,id,3)
local player p=GetOwningPlayer(u)
local real dmg=LoadReal(h,id,5)
if SR(x,y,x1,y1)>70 then
set x=x+speed*Cos(a)
set y=y+speed*Sin(a)
if IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
call SetUnitXY_1(l__d,x,y, false)
endif
call SetUnitFacing(l__d,a*bj_RADTODEG)
call UnitApplyTimedLife(CreateUnit(p,0x65304132,x,y,a*bj_RADTODEG),'BTLF',0.5)
else
call UnitApplyTimedLife(CreateUnit(p,'e03S',x1,y1,0),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e03T',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call myCustomDamage(u,c,dmg,false,false,null,null,null)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
call RemoveUnit(l__d)
endif
set p=null
set l__d=null
set c=null
set t=null
set u=null
endfunction
function MissleMovePlasmaShot takes unit u,unit c,unit l__d,real speed,real angle,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveUnitHandle(h,id,2,l__d)
call SaveReal(h,id,3,angle)
call SaveReal(h,id,4,speed)
call SaveReal(h,id,5,dmg)
call TimerStart(t,0.04,true,function MissleMovePlasmaShot2)
set t=null
endfunction
function PlasmaShotCond takes nothing returns boolean
return GetSpellAbilityId()=='A0GU' and udg_B==true
endfunction
function PlasmaShotCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local real l__d=LoadReal(h,id,8)
local player p=GetOwningPlayer(u)
local real dmg=(1+GetUnitAbilityLevel(u,'A0GU'))*(GetHeroInt(u,true))+75*GetUnitAbilityLevel(u,'A0GU')
if SR(x,y,x1,y1)>32 and LoadBoolean(h,id,7)==false then
set x=x+50*Cos(a)
set y=y+50*Sin(a)
call UnitApplyTimedLife(CreateUnit(p,'eGA1',x,y,a*bj_RADTODEG),'BTLF',0.5)
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
else
call GroupEnumUnitsInRange(G,x1,y1,750,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)and E!=c then
call MissleMovePlasmaShot(u,E,CreateUnit(p,'e0A0',x1,y1,0),50,0,dmg)
endif
call GroupRemoveUnit(G,E)
endloop
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call UnitApplyTimedLife(CreateUnit(p,'e03S',x1,y1,GetRandomReal(0,359)),'BHwe',0.5)
call UnitApplyTimedLife(CreateUnit(p,'e03T',x1,y1,GetRandomReal(0,359)),'BTLF',0.5)
call myCustomDamage(u,c,dmg,false,false,null,null,null)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function PlasmaShotCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveReal(h,id,5,100)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,GetSpellTargetUnit())
call SaveReal(h,id,2,GetUnitX(u))
call SaveReal(h,id,3,GetUnitY(u))
set soundplay=SndN(1239) // Sound\Music\mp3Music\GammaQ.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.03,true,function PlasmaShotCast2)
set u=null
set t=null
endfunction
function PlasmaShotInit takes nothing returns nothing
endfunction
// Battle Healing — пассивка F Кирито: включается, когда герой дорос до 6 уровня (вместе с F), один таймер на героя
function Trig_DubleLearn_Conditions takes nothing returns boolean
local unit u=GetTriggerUnit()
local boolean b=(GetUnitTypeId(u)=='H02F' or GetUnitTypeId(u)=='H05Y') and IsUnitIllusion(u)==false and GetHeroLevel(u)>=6 and LoadBoolean(HH,GetHandleId(u),'KrBH')==false
set u=null
return b
endfunction
function BattleHealing takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,1)
local real l=GetWidgetLife(u)
local real ml=GetUnitState(u,UNIT_STATE_MAX_LIFE)
local real heal=LoadReal(h, GetHandleId(u), SH_KiritoD_BattleHealing)
if UnitIsAlive(u)then
        call HealTextTag(u,u,(ml*0.08+heal)*myCustomHeal2(u,1),"HealthRes")
        call SetUnitState(u,UNIT_STATE_LIFE,l+ml*0.08+heal)
        call SaveReal(h, GetHandleId(u), SH_KiritoD_BattleHealing, 0.0)
endif
set t=null
set u=null
endfunction
function Trig_DubleLearn_Actions takes nothing returns nothing
local timer kirito
local unit u=GetTriggerUnit()
call SaveBoolean(HH,GetHandleId(u),'KrBH',true)
set kirito=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(kirito),1,u)
call TimerStart(kirito,10,true,function BattleHealing)
set kirito=null
set u=null
endfunction
function InitTrig_DubleLearn takes nothing returns nothing
set gg_trg_DubleLearn=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_DubleLearn,EVENT_PLAYER_HERO_LEVEL)
call TriggerAddCondition(gg_trg_DubleLearn,Condition(function Trig_DubleLearn_Conditions))
call TriggerAddAction(gg_trg_DubleLearn,function Trig_DubleLearn_Actions)
endfunction
function DubleCirculirCond takes nothing returns boolean
return GetSpellAbilityId()=='A0H9'
endfunction
// E — Double Circular (Dual Blades): рывок к точке (до 400) и два круговых удара обоими клинками.
// Кирито неуязвим на весь приём. Урон (3+ур)*STR — поровну на два удара; каждый удар бьёт всех в 350 и расталкивает.
// HH[id]: 0 Кирито, 1 угол, 2 оставшийся путь рывка, 3 тики после прибытия, 4 урон одного удара
// подлёт Кирито в стиле Q Йоруичи: веер nitu на старте, шлейф SaberExtra + ветер на каждом шаге
function KrDashStart takes player p,real x,real y,real a returns nothing
local integer i=-1
loop
exitwhen i>1
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+45*i)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set i=i+1
endloop
set n=null
endfunction
function KrDashFx takes player p,real x,real y,real a returns nothing
local real sc=GetRandomReal(0.55,1.25)
set n=CreateUnit(p,'e11T',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,75)
call UnitApplyTimedLife(n,'BTLF',0.15)
set n=CreateUnit(p,'e117',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,GetRandomInt(10,45))
call SetUnitScale(n,sc,sc,sc)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=null
endfunction
// E: потоки ветра наружу вокруг Кирито
function KrSpinWind takes player p,real x,real y returns nothing
local integer i=0
local real b=GetRandomReal(0,59)
loop
exitwhen i>=6
set n=CreateUnit(p,'e117',x+120*Cos((b+i*60)*bj_DEGTORAD),y+120*Sin((b+i*60)*bj_DEGTORAD),b+i*60)
call SetUnitVertexColor(n,255,255,255,90)
call SetUnitScale(n,1,1,1)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set i=i+1
endloop
set n=null
endfunction
function DubleCirculirSpin takes unit u,real dmg,real pd returns nothing
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
// два горизонтальных взмаха клинками и кольцо ветра — по размеру AoE 400
call EffectCreateAndMove(true,"Others\\daoguang-blue-hengsao.mdl",GetUnitFacing(u),0.6,1.1,1.5,100,100,100,0,60,u,0,0)
call EffectCreateAndMove(true,"Others\\daoguang-blue-hengsao.mdl",GetUnitFacing(u)+180,0.6,1.1,1.5,100,100,100,0,60,u,0,0)
call EffectCreateAndMove(true,"war3mapImported\\WindCircleFaster.mdl",GetRandomReal(0,359),0.8,3,1,100,100,100,0,0,u,0,0)
call KrSpinWind(p,x,y)
set n=CreateUnit(p,'e0AD',x,y,GetUnitFacing(u))
call UnitApplyTimedLife(n,'BTLF',0.2)
call SetUnitVertexColor(n,255,255,255,125)
call SetUnitTimeScale(n,4)
call SetUnitAnimation(n,"attack")
set n=null
call GroupClear(G)
call GroupEnumUnitsInRange(G,x,y,400,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E) then
if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(u,E,1,"stun")
call Push(E,40,Atan2(GetUnitY(E)-y,GetUnitX(E)-x),pd)
else
call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,u)
endif
endif
call GroupRemoveUnit(G,E)
endloop
call GroupClear(G)
set p=null
endfunction
function DubleCirculirCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local real a=LoadReal(HH,id,1)
local real left=LoadReal(HH,id,2)
local integer k=LoadInteger(HH,id,3)
local real st
if UnitIsAlive(u)==false or udg_B==false then
set k=99
endif
if k==0 and left>0 then
// рывок: 50 за тик (2500/с)
set st=50
if left<st then
set st=left
endif
call SetUnitXY_1(u,GetUnitX(u)+st*Cos(a),GetUnitY(u)+st*Sin(a),true)
call SaveReal(HH,id,2,left-st)
call KrDashFx(GetOwningPlayer(u),GetUnitX(u),GetUnitY(u),a)
else
set k=k+1
call SaveInteger(HH,id,3,k)
if k==1 then
// первый круговой удар
call SetUnitAnimation(u,"attack")
call QueueUnitAnimation(u,"stand") // после анимации — stand, иначе в паузе встаёт в T-позу
call DubleCirculirSpin(u,LoadReal(HH,id,4),60) // первый удар — слабое отталкивание
elseif k==15 then
// второй круговой удар через 0.28 с
call SetUnitFacing(u,a*bj_RADTODEG+180)
call SetUnitAnimation(u,"attack")
call QueueUnitAnimation(u,"stand") // после анимации — stand, иначе в паузе встаёт в T-позу
call DubleCirculirSpin(u,LoadReal(HH,id,4),200)
elseif k<26 then
call SetUnitFacingInstant(u,GetUnitFacing(u)+30)
elseif k>=26 then
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call SetUnitTimeScale(u,1)
call SetUnitAnimation(u,"stand")
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
endif
set u=null
set t=null
endfunction
function DubleCirculirCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real kdist=SR(x,y,x1,y1)
if kdist>400 then
set kdist=400
endif
call SaveUnitHandle(HH,id,0,u)
call SaveReal(HH,id,1,Atan2(y1-y,x1-x))
call SaveReal(HH,id,2,kdist)
call SaveInteger(HH,id,3,0)
call SaveReal(HH,id,4,0.5*(1+GetUnitAbilityLevel(u,'A0H9'))*GetHeroStr(u,true)+GetHeroStr(u,true))
call SetUnitFacing(u,Atan2(y1-y,x1-x)*bj_RADTODEG)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SetUnitTimeScale(u,3)
call KrDashStart(GetOwningPlayer(u),x,y,Atan2(y1-y,x1-x))
call SetUnitAnimation(u,"attack")
call QueueUnitAnimation(u,"stand") // после анимации — stand, иначе в паузе встаёт в T-позу
set soundplay=SndN(1241) // Sound\Music\mp3Music\KiritoE1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.02,true,function DubleCirculirCast2)
set u=null
set t=null
endfunction
function DubleCirculirInit takes nothing returns nothing
endfunction
function Reaver2Cond takes nothing returns boolean
return GetSpellAbilityId()=='A0H3' and udg_B==true
endfunction
function Reaver2Cast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local real f=GetUnitFacing(u)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroStr(u,true)*(GetUnitAbilityLevel(u,'A0H3')+1)+50
local real dist=SR(x,y,x1,y1)
local real a=Atan2(y1-y,x1-x)
local real he=0
local real dist2=LoadReal(h,id,100)
if dist2>50.00 and udg_B==true and GetUnitAbilityLevel(u,'A1BL')==0 then
call SaveReal(h,id,100,dist2-43)
call SetUnitXY_1(u,x+43*Cos(a),y+43*Sin(a), true)
call SetUnitFacing(u,a*bj_RADTODEG)
set he=ParabolaZ(400,LoadReal(h,id,4),dist)
call SetUnitFlyHeight(u,he,0)
// атака раз в 10 тиков (0.25 c) на скорости x4 — раньше перезапускалась каждый тик и дёргалась
call SaveInteger(h,id,101,LoadInteger(h,id,101)+1)
if ModuloInteger(LoadInteger(h,id,101),10)==1 then
call SetUnitAnimation(u,"attack")
endif
else
call GroupEnumUnitsInRange(G,x1,y1,350,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call Push(E,30,Atan2(GetUnitY(E)-y1,GetUnitX(E)-x1),300)
call myCustomDamage(u,E,dmg,false,false,null,null,null)
// Sonic Leap: оглушение 1.2 c, источник — Кирито (раньше сама цель: контроль не засчитывался в ассисты)
call SetControlToUnit(u,E, 2, "stun")
endif
call GroupRemoveUnit(G,E)
endloop
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call SetUnitFlyHeight(u,0,0)
call SetUnitTimeScale(u,1)
call UnitApplyTimedLife(CreateUnit(p,'e08O',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e08U',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e08T',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e08R',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0AK',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0AI',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0AJ',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0AG',x1,y1,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0AH',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
endif
set u=null
set t=null
set p=null
endfunction
function Reaver2Cast takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real f=GetUnitFacing(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
call DestroyEffect(AddSpecialEffect("war3mapImported\\TealSlam.mdl",x,y))
call SetUnitTimeScale(u,4)
call PauseUnit(u,true)
call UnitAddAbility(u,'Arav')
call UnitRemoveAbility(u,'Arav')
call SaveUnitHandle(h,id,0,u)
call SetUnitInvulnerable(u,true)
call SaveReal(h,id,2,x1)
call SaveReal(h,id,3,y1)
call SaveReal(h,id,4,SR(x,y,x1,y1))
call SaveReal(h,id,100,SR(x,y,x1,y1))
call TimerStart(t,0.025,true,function Reaver2Cast2)
// KiritoSwitchTeam теперь на F (Switch)
set soundplay=SndN(4823) // Sound\Music\mp3Music\KiritoQ.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set u=null
set t=null
endfunction
function Reaver2Init takes nothing returns nothing
endfunction
function SlashHorizontalSquare2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local player p=GetOwningPlayer(l__d)
local unit u=Hero[GetPlayerId(p)]
local real speed=LoadReal(h,id,1)
local real x=LoadReal(h,id,3)
local real y=LoadReal(h,id,4)
local group g=LoadGroupHandle(h,id,5)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,2)
local real dmg=LoadReal(h,id,6)
local real Range=LoadReal(h,id,9)
if Range>0 then
call SetUnitXY_1(l__d,x1+speed*Cos(a),y1+speed*Sin(a), false)
call SaveReal(h,id,9,Range-speed)
if Range<120 then
// затухание на последних 120 пути (цвет волны как в unit.ini: 0,220,255)
call SetUnitVertexColor(l__d,0,220,255,R2I(255*RMaxBJ(Range-speed,0)/120))
endif
call SetUnitFacing(l__d,a*bj_RADTODEG+180) // модель волны развёрнута на 180
if dmg>0 then
call GroupEnumUnitsInRange(g,x1,y1,LoadReal(h,id,10),Base)
endif
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
else
call RemoveUnit(l__d) // к этому моменту уже прозрачна
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,GetHandleId(g))
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function SlashHorizontalSquare takes unit l__d,real speed,real dmg,real angle,real range,real mas returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle)
call SaveGroupHandle(h,id,5,CreateGroup())
call SaveReal(h,id,3,GetUnitX(l__d))
call SaveReal(h,id,4,GetUnitY(l__d))
call SaveReal(h,id,6,dmg)
call SaveReal(h,id,9,range)
call SaveReal(h,id,10,mas)
call TimerStart(t,0.03,true,function SlashHorizontalSquare2)
set t=null
endfunction
function HorizontalSquareCond takes nothing returns boolean
return GetSpellAbilityId()=='A0H7' and udg_B==true
endfunction
// R Кирито, Horizontal Square: цель удерживается 1 c, Кирито обходит её по квадрату — 4 удара по сторонам
// (каждые 0.25 c, урон по области у цели + оглушение 0.5 c), затем общая волна вокруг цели с отталкиванием.
// h[id]: 0 Кирито, 1 цель, 5 время, 6 угол первой стороны, 7 номер следующего удара
function HorizontalSquareHit takes unit u,unit c,real r,real dmg,boolean fin returns nothing
local player p=GetOwningPlayer(u)
local real x=GetUnitX(c)
local real y=GetUnitY(c)
call GroupClear(G)
call GroupEnumUnitsInRange(G,x,y,r,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E) then
if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
if dmg>0 then
// цель держится на паузе — обработчик резал бы урон по ней вдвое; Bof_DmgFull отдаёт 100%
call Bof_DmgFull(u,E,dmg)
endif
if fin then
if E!=c then
call Push(E,40,Atan2(GetUnitY(E)-y,GetUnitX(E)-x),200)
call SetControlToUnit(u,E,0.5,"stun")
endif
endif
else
call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,u)
endif
endif
call GroupRemoveUnit(G,E)
endloop
call GroupClear(G)
set p=null
endfunction
function HorizontalSquareCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real time=LoadReal(h,id,5)+0.05
local integer k=LoadInteger(h,id,7)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real b
local real lvl=GetUnitAbilityLevel(u,'A0H7')
local player p=GetOwningPlayer(u)
call SaveReal(h,id,5,time)
if UnitIsAlive(u) and UnitIsAlive(c) and udg_B and time<1 then
if k<4 and time>=0.05+0.25*k then
// удар k: Кирито на k-й стороне квадрата, разрез вдоль стороны
set b=LoadReal(h,id,6)+(k-1)*bj_PI/2
set n=CreateUnit(p,'e0AD',GetUnitX(u),GetUnitY(u),GetUnitFacing(u))
call SetUnitVertexColor(n,255,255,255,110)
call SetUnitTimeScale(n,3)
call SetUnitAnimation(n,"attack")
call UnitApplyTimedLife(n,'BTLF',0.3)
set n=null
call SetUnitXY_1(u,x1+120*Cos(b),y1+120*Sin(b),false)
call SetUnitFacingInstant(u,b*bj_RADTODEG+180)
call SetUnitTimeScale(u,2.5)
call SetUnitAnimation(u,"attack")
call QueueUnitAnimation(u,"stand") // после анимации — stand, иначе в паузе встаёт в T-позу
set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\SlashBlueKojiro.mdl",x1+60*Cos(b),y1+60*Sin(b))
call SetSpecialEffectHeight(bj_lastCreatedEffect,60)
call SetSpecialEffectScale(bj_lastCreatedEffect,0.45)
call SetSpecialEffectOrientation(bj_lastCreatedEffect,b*bj_RADTODEG+90,0,0)
call DestroyEffect(bj_lastCreatedEffect)
set n=CreateUnit(p,'e0AF',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitVertexColor(n,190,255,255,50)
set n=null
call HorizontalSquareHit(u,c,200,(0.5+0.25*lvl)*GetHeroStr(u,true),false)
call SaveInteger(h,id,7,k+1)
endif
else
if UnitIsAlive(u) and UnitIsAlive(c) and udg_B then
// квадрат вспыхивает: общая волна вокруг цели
call EffectCreateAndMove(true,"war3mapImported\\WindCircleFaster.mdl",GetRandomReal(0,359),0.8,1.2,1,100,100,100,0,0,c,0,0)
call UnitApplyTimedLife(CreateUnit(p,'e0B5',x1,y1,GetRandomReal(0,359)),'BTLF',0.8)
call UnitApplyTimedLife(CreateUnit(p,'e0AN',x1,y1,GetRandomReal(0,359)),'BTLF',0.7)
call HorizontalSquareHit(u,c,350,GetHeroStr(u,true),true)
set b=LoadReal(h,id,6)
set k=0
loop
exitwhen k>=4
call SlashHorizontalSquare(CreateUnit(p,'e0AM',x1+200*Cos(b+k*bj_PI/2),y1+200*Sin(b+k*bj_PI/2),(b+k*bj_PI/2)*bj_RADTODEG+180),8,0,b+k*bj_PI/2,200,0) // волны только визуальные: старт в 200 от цели, полёт 200 за ~0.75 c
set k=k+1
endloop
endif
call SetUnitInvulnerable(u,false)
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitVertexColor(u,255,255,255,255)
call FlushChildHashtable(h,id)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
if UnitIsAlive(u) and UnitIsAlive(c) and udg_B and time>=1 then
// цель весь приём на паузе (урон проходит полностью), в конце — короткое оглушение
call SetControlToUnit(u,c,0.5,"stun")
endif
call PauseUnit(u,false)
call SetUnitTimeScale(u,1)
call SetUnitAnimation(u,"stand")
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function HorizontalSquareCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveReal(h,id,6,Atan2(y-y1,x-x1))
call SetUnitXY_1(u,x1,y1, false)
call SetUnitVertexColor(u,255,255,255,125)
call SetUnitTimeScale(u,3)
call SetUnitAnimation(u,"attack")
call QueueUnitAnimation(u,"stand") // после анимации — stand, иначе в паузе встаёт в T-позу
call UnitApplyTimedLife(CreateUnit(p,'e0AK',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0AI',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0AJ',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0AG',x,y,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0AH',x,y,GetRandomReal(0,359)),'BTLF',1)
set soundplay=SndN(1245) // Sound\Music\mp3Music\KiritoR.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.05,true,function HorizontalSquareCast2)
else
call SetUnitXY_1(u,x1,y1, false)
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitVertexColor(u,255,255,255,255)
call FlushChildHashtable(h,id)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
call SetUnitTimeScale(u,1)
endif
set t=null
set u=null
set p=null
set c=null
endfunction
function HorizontalSquareInit takes nothing returns nothing
endfunction
// ===== T Кирито: Starburst Stream (режим 0) и вариация The Eclipse (режим 1, Ctrl+T).
// Обе идут по одной схеме (бывшая T Героини X): замах -> рывок к цели -> две серии ударов с удержанием цели ->
// отброс цели -> рывок за ней, остановка на её позиции, финальный удар и толчок.
// Starburst: синие эффекты, масштаб 0.7, все фазы на 25% короче, урон 10*STR сквозь щиты, только озвучка Starburst Stream.
// The Eclipse: жёлтые модели (eKY*, пак F:\ChoiceModels3), урон 14*STR, своя озвучка KiritoEclipse на весь приём.
// HH[id]: 0 Кирито, 1 цель, 2 режим, 3 угол, 4 счётчик фазы, 5 таймер шага, 6 множитель длительности, 7 звук серии сыгран, 8 шаг рывка
function KrSB_Id takes integer m,integer blue,integer yellow returns integer
if m==1 then
return yellow
endif
return blue
endfunction
// масштаб эффекта: в Starburst меньше
function KrSB_Sc takes integer m,real kscl returns real
if m==1 then
return kscl
endif
return kscl*0.6
endfunction
// синий оттенок для белых моделей (NanayaSlash, WindSlash) — в The Eclipse жёлтый
function KrSB_Tint takes unit e,integer m,integer al returns nothing
if m==1 then
call SetUnitVertexColor(e,255,215,70,al)
else
call SetUnitVertexColor(e,75,105,255,al)
endif
endfunction
// анимация героя с запасной для скина ALO (у KiritoAlo нет Spell Five / Spell Channel / Spell Slam Three);
// после неё в очередь — stand: иначе по окончании короткой анимации в паузе модель встаёт в T-позу
function KrSB_Anim takes unit u,string hq,string alo returns nothing
if GetUnitTypeId(u)=='H05Y' then
call SetUnitAnimation(u,alo)
else
call SetUnitAnimation(u,hq)
endif
call QueueUnitAnimation(u,"stand")
endfunction
function KrSB_Fx takes player p,integer ty,real x,real y,real f,real sc,real ts,real life,integer al returns unit
set n=CreateUnit(p,ty,x,y,f)
call SetUnitScale(n,sc,sc,sc)
call SetUnitTimeScale(n,ts)
call SetUnitVertexColor(n,255,255,255,al)
call UnitApplyTimedLife(n,'BTLF',life)
return n
endfunction
// остаточное изображение Кирито при подлёте: застывшая полупрозрачная копия в цвете вариации, 0.3 c
function KrSB_Ghost takes player p,integer m,real x,real y,real a returns nothing
set n=CreateUnit(p,'e0AD',x,y,a*bj_RADTODEG)
call SetUnitAnimation(n,"spell two")
call SetUnitTimeScale(n,0)
if m==1 then
call SetUnitVertexColor(n,255,220,90,110)
else
call SetUnitVertexColor(n,110,160,255,110)
endif
call UnitApplyTimedLife(n,'BTLF',0.3)
endfunction
// одна из трёх нарезок Starburst
function KrSB_Slash takes player p,integer m,real x,real y,real a returns nothing
local integer r=GetRandomInt(1,3)
if r==1 then
call KrSB_Fx(p,KrSB_Id(m,'e13N','eKY1'),x,y,a*bj_RADTODEG,KrSB_Sc(m,1.25),2,0.4,200)
elseif r==2 then
call KrSB_Fx(p,KrSB_Id(m,'e13O','eKY2'),x,y,a*bj_RADTODEG,KrSB_Sc(m,1.5),2,0.4,200)
else
call KrSB_Fx(p,KrSB_Id(m,'e13P','eKY3'),x,y,a*bj_RADTODEG,KrSB_Sc(m,1.25),2,0.4,200)
endif
endfunction
// вспышка и кольцо из 6 рывков вокруг Кирито
function KrSB_Burst takes player p,integer m,real x,real y returns nothing
local integer i=0
set n=KrSB_Fx(p,'e11Q',x,y,GetRandomReal(0,359),KrSB_Sc(m,4),1.5,1.5,255)
call KrSB_Tint(n,m,255)
loop
exitwhen i>=6
call KrSB_Fx(p,'e0ZH',x+KrSB_Sc(m,350)*Cos(i*60*bj_DEGTORAD),y+KrSB_Sc(m,350)*Sin(i*60*bj_DEGTORAD),180+i*60,KrSB_Sc(m,1.2),0.5,3,55)
set i=i+1
endloop
endfunction
// отброс цели со шлейфом
function KrSB_Push2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit c=LoadUnitHandle(HH,id,0)
local real sp=LoadReal(HH,id,1)
local real a=LoadReal(HH,id,2)
local real left=LoadReal(HH,id,3)
local integer m=LoadInteger(HH,id,4)
local real x=GetUnitX(c)
local real y=GetUnitY(c)
if left>0 and c!=null then
call SetUnitXY_1(c,x+sp*Cos(a),y+sp*Sin(a),true)
call SaveReal(HH,id,3,left-sp)
call SaveReal(HH,id,1,sp*0.97)
call SaveInteger(HH,id,5,LoadInteger(HH,id,5)+1)
if ModuloInteger(LoadInteger(HH,id,5),2)==0 then
call KrSB_Fx(GetOwningPlayer(c),'e0ZH',x,y,a*bj_RADTODEG+180,KrSB_Sc(m,1.2),3,0.4,55)
call KrSB_Fx(GetOwningPlayer(c),KrSB_Id(m,'e117','eKY7'),x,y,a*bj_RADTODEG,KrSB_Sc(m,GetRandomReal(0.25,1)),3,0.4,GetRandomInt(25,155))
endif
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set c=null
set t=null
endfunction
function KrSB_Push takes unit c,real sp,real a,real dist,integer m returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(HH,id,0,c)
call SaveReal(HH,id,1,sp)
call SaveReal(HH,id,2,a)
call SaveReal(HH,id,3,dist)
call SaveInteger(HH,id,4,m)
call TimerStart(t,0.03,true,function KrSB_Push2)
set t=null
endfunction
// Т: каждый тик заново ставим паузу и неуязвимость — чужие снятия паузы/развеивания не прерывают приём
// (Кирито — с начала каста, цель — с момента захвата)
function KrSB_Hold takes unit u,unit c returns nothing
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
if c!=null then
call PauseUnit(c,true)
call SetUnitInvulnerable(c,true)
endif
endfunction
// конец приёма или обрыв: отпустить обоих
function KrSB_End takes timer t,unit u,unit c returns nothing
local integer id=GetHandleId(t)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call SetUnitTimeScale(u,1)
call QueueUnitAnimation(u,"stand")
if c!=null then
call PauseUnit(c,false)
call SetUnitInvulnerable(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endfunction
// фаза E: рывок за отброшенной целью, остановка на её позиции, финальный удар и толчок
function KrSB_Final takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit c=LoadUnitHandle(HH,id,1)
local integer m=LoadInteger(HH,id,2)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=Atan2(GetUnitY(c)-y,GetUnitX(c)-x)
local integer k=LoadInteger(HH,id,8)+1
local real kst
call SaveInteger(HH,id,8,k)
call KrSB_Hold(u,c)
if UnitIsAlive(u)==false or udg_B==false then
call KrSB_End(t,u,c)
elseif SR(x,y,GetUnitX(c),GetUnitY(c))>100 and k<30 then
// шаг 100 за 0.02 c (5000/с), не дальше чем до цели
set kst=SR(x,y,GetUnitX(c),GetUnitY(c))-90
if kst>100 then
set kst=100
endif
call SetUnitXY_1(u,x+kst*Cos(a),y+kst*Sin(a),false)
call SetUnitFacing(u,a*bj_RADTODEG)
if ModuloInteger(k,2)==1 then
call KrSB_Ghost(p,m,x,y,a)
endif
else
call KrSB_Burst(p,m,GetUnitX(c),GetUnitY(c))
// крест — на противнике
call KrSB_Fx(p,KrSB_Id(m,'e13Q','eKY4'),GetUnitX(c),GetUnitY(c),a*bj_RADTODEG+45,KrSB_Sc(m,4),1,2,255)
call KrSB_Fx(p,KrSB_Id(m,'e13Q','eKY4'),GetUnitX(c),GetUnitY(c),a*bj_RADTODEG-45,KrSB_Sc(m,4),1,2,255)
call KrSB_End(t,u,c)
// обе вариации бьют сквозь щиты и общие резисты
call SaveInteger(HH,GetHandleId(u),BlockPenetrate,1)
if m==1 then
call myCustomDamage(u,c,14*GetHeroStr(u,true),false,false,null,null,null)
else
call myCustomDamage(u,c,10*GetHeroStr(u,true),false,false,null,null,null)
endif
call SaveInteger(HH,GetHandleId(u),BlockPenetrate,0)
call KrSB_Push(c,42,a,300,m) // толчок вдвое короче
endif
set p=null
set u=null
set c=null
set t=null
endfunction
// фазы C и D: серии ударов. HH[4] — сколько шагов (0.035 c) осталось; каждые 2 шага оба сдвигаются вперёд.
// HH[9] — фаза: 1 первая серия, 2 вторая, 3 пауза перед финальным рывком; HH[10] — шагов паузы между фазами
function KrSB_Series takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit c=LoadUnitHandle(HH,id,1)
local integer m=LoadInteger(HH,id,2)
local real a=LoadReal(HH,id,3)
local real left=LoadReal(HH,id,4)
local real k=LoadReal(HH,id,6)
local integer step=LoadInteger(HH,id,8)+1
local integer ph=LoadInteger(HH,id,9)
local integer w=LoadInteger(HH,id,10)
local integer ss
local integer sl
local integer tot=R2I(1.25*k/0.035)+R2I(1.0*k/0.035)
local integer cnt=16
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1
local real y1
call SaveInteger(HH,id,8,step)
call KrSB_Hold(u,c)
if m==1 then
set cnt=27
endif
if UnitIsAlive(u)==false or udg_B==false then
call KrSB_End(t,u,c)
elseif w>0 then
// пауза между фазами
call SaveInteger(HH,id,10,w-1)
if w==1 and ph==3 then
call PauseTimer(t)
call SaveInteger(HH,id,8,0)
// финальный удар — выпад, как у W (Vorpal Strike)
call KrSB_Anim(u,"spell two","spell two")
call SetUnitTimeScale(u,2)
call TimerStart(t,0.02,true,function KrSB_Final)
endif
elseif ph==3 then
call SaveInteger(HH,id,10,1)
elseif left>0 then
call SaveReal(HH,id,4,left-1)
// удар Кирито раз в 11 шагов (~0.385 c) на x2.6 — анимация доигрывает до следующей, без stand между ними
if ModuloInteger(step,11)==0 then
call SetUnitTimeScale(u,2.6)
call SetUnitAnimation(u,"attack")
endif
if ModuloInteger(step,2)==0 then
set x=x+12*Cos(a)
set y=y+12*Sin(a)
call SetUnitXY_1(u,x,y,false)
call SetUnitXY_1(c,x+150*Cos(a),y+150*Sin(a),false)
endif
// разрез: ровно cnt штук (16 / 27, как в описании), равномерно по шагам обеих серий
set ss=LoadInteger(HH,id,13)+1
set sl=LoadInteger(HH,id,12)
call SaveInteger(HH,id,13,ss)
if ss*cnt>=(sl+1)*tot and sl<cnt then
call SaveInteger(HH,id,12,sl+1)
if ph==2 then
call KrSB_Fx(p,'e10N',x,y,a*bj_RADTODEG,KrSB_Sc(m,0.5),2,0.4,125)
set n=KrSB_Fx(p,'e11L',x+150*Cos(a),y+150*Sin(a),GetRandomReal(0,359),KrSB_Sc(m,GetRandomReal(1.5,3.5)),2.5,0.7,255)
call KrSB_Tint(n,m,GetRandomInt(50,255))
call SetUnitFlyHeight(n,GetRandomReal(60,90),0)
endif
set x1=x+150*Cos(a)
set y1=y+150*Sin(a)
set n=KrSB_Fx(p,KrSB_Id(m,'e11M','eKY5'),x1,y1,GetRandomReal(0,359),KrSB_Sc(m,1),2,0.7,255)
call SetUnitFlyHeight(n,90,0)
call KrSB_Slash(p,m,x,y,a)
endif
call SetUnitFacing(u,a*bj_RADTODEG)
else
call KrSB_Burst(p,m,x,y)
if ph==1 then
// между сериями
call SaveInteger(HH,id,9,2)
call SaveReal(HH,id,4,R2I(1.0*k/0.035))
call SaveInteger(HH,id,10,R2I(0.35*k/0.035))
call KrSB_Anim(u,"attack","attack")
call SetUnitTimeScale(u,3)
else
// отброс цели и пауза перед рывком за ней
call SaveInteger(HH,id,9,3)
call SaveInteger(HH,id,10,R2I(0.8*k/0.035))
call KrSB_Push(c,53,a,375,m) // отброс вдвое короче
call PauseUnit(c,true)
call KrSB_Anim(u,"Spell Five","Spell Four")
call SetUnitTimeScale(u,1)
endif
endif
set p=null
set u=null
set c=null
set t=null
endfunction
// фаза B: рывок к цели; на месте — захват (или ответ реверсом)
function KrSB_Dash takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit c=LoadUnitHandle(HH,id,1)
local integer m=LoadInteger(HH,id,2)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=Atan2(GetUnitY(c)-y,GetUnitX(c)-x)
call KrSB_Hold(u,null)
if UnitIsAlive(u)==false or udg_B==false or UnitIsAlive(c)==false then
call KrSB_End(t,u,null)
elseif SR(x,y,GetUnitX(c),GetUnitY(c))>100 then
call SaveInteger(HH,id,11,LoadInteger(HH,id,11)+1)
if ModuloInteger(LoadInteger(HH,id,11),3)==0 then
call KrSB_Ghost(p,m,x,y,a)
endif
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitXY_1(u,x+40*Cos(a),y+40*Sin(a),false)
elseif LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY) then
call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
call StopSound(LoadSoundHandle(HH,id,15),false,false) // реверс — озвучка каста обрывается
call KrSB_End(t,u,null)
else
call PauseTimer(t)
call SaveReal(HH,id,3,a)
call PauseUnit(c,true)
call SetUnitInvulnerable(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
// попадание (не реверс) — озвучка удара: KiritoT1-sfx / KiritoT2-sfx
if m==1 then
set soundplay=SndN(4831) // Sound\Music\mp3Music\KiritoT2-sfx.mp3
else
set soundplay=SndN(4829) // Sound\Music\mp3Music\KiritoT1-sfx.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
// захват: сразу удар (Spell Slam Three у модели давал T-позу до первой атаки серии)
call SetUnitTimeScale(u,2.6)
call SetUnitAnimation(u,"attack")
call KrSB_Fx(p,KrSB_Id(m,'e0RV','eKY9'),x,y,a*bj_RADTODEG,KrSB_Sc(m,3.75),0.1,8*LoadReal(HH,id,6),180)
call SaveInteger(HH,id,9,1)
call SaveReal(HH,id,4,R2I(1.25*LoadReal(HH,id,6)/0.035))
call SaveInteger(HH,id,8,0)
call TimerStart(t,0.035,true,function KrSB_Series)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
// фаза A: замах с волнами вокруг
function KrSB_Windup takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local integer m=LoadInteger(HH,id,2)
local real k=LoadReal(HH,id,6)
local real time=LoadReal(HH,id,5)+0.05
local player p=GetOwningPlayer(u)
call SaveReal(HH,id,5,time)
call KrSB_Hold(u,null)
if UnitIsAlive(u)==false or udg_B==false then
call KrSB_End(t,u,null)
elseif time<0.75*k then
if time>0.3*k then
call KrSB_Fx(p,KrSB_Id(m,'e13I','eKY6'),GetUnitX(u),GetUnitY(u),GetRandomReal(0,359),KrSB_Sc(m,1),2,0.5,55)
endif
else
call PauseTimer(t)
call KrSB_Fx(p,'e10N',GetUnitX(u),GetUnitY(u),LoadReal(HH,id,3)*bj_RADTODEG,KrSB_Sc(m,0.5),3,1,255)
// подлёт — выпад, как у W (Spell Channel One у модели давал T-позу)
call KrSB_Anim(u,"spell two","spell two")
call TimerStart(t,0.02,true,function KrSB_Dash)
endif
set p=null
set u=null
set t=null
endfunction
function KrSB_Cast takes unit u,unit c,integer m returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real k=0.75
if m==1 then
set k=1.1 // финальный удар The Eclipse ~ на 5-й секунде — совпадает с последним ударом в озвучке KiritoEclipse
endif
call SaveUnitHandle(HH,id,0,u)
call SaveUnitHandle(HH,id,1,c)
call SaveInteger(HH,id,2,m)
call SaveReal(HH,id,3,Atan2(GetUnitY(c)-y,GetUnitX(c)-x))
call SaveReal(HH,id,5,0)
call SaveReal(HH,id,6,k)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call KrSB_Anim(u,"Spell Five","Spell Four")
call KrSB_Fx(p,KrSB_Id(m,'e13M','eKY8'),x,y,GetRandomReal(0,359),KrSB_Sc(m,2),0.5,4*k,255)
call KrSB_Burst(p,m,x,y)
call KrSB_Fx(p,KrSB_Id(m,'e0RV','eKY9'),x,y,GetUnitFacing(u),KrSB_Sc(m,1.75),0.5,3*k,180)
if m==1 then
set soundplay=SndN(4825) // Sound\Music\mp3Music\KiritoT2.mp3 — отрезок 3–8.4 c, последний удар на 5-й секунде
else
set soundplay=SndN(1247) // Sound\Music\mp3Music\KiritoT1.mp3
endif
call StartSound(soundplay)
call SaveSoundHandle(HH,id,15,soundplay) // озвучка каста — реверс её выключает
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.05,true,function KrSB_Windup)
set t=null
set p=null
endfunction
function EclipsCond takes nothing returns boolean
return GetSpellAbilityId()=='A0H8' and udg_B==true
endfunction
function EclipsCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local integer m=0
// вариация Ctrl+T — The Eclipse: своя перезарядка 70 c (мана 650 ставит переключатель вариации)
if LoadReal(HH,GetHandleId(GetOwningPlayer(u)),VariationTHash)==1 then
set m=1
call StartAbilityCooldown(GetUnitAbility(u,'A0H8'),70)
endif
call KrSB_Cast(u,GetSpellTargetUnit(),m)
set u=null
endfunction
function EclipsInit takes nothing returns nothing
endfunction
// W — Vorpal Strike: замах 0.4 c, потом выпад вперёд на 900 (50 за тик 0.02 c), бьёт каждого врага на пути (ширина 300) один раз
// и отбрасывает. Кирито неуязвим во время выпада. Урон (3+0.5*ур)*STR+100.
// HH[id]: 0 Кирито, 1 угол, 2 оставшийся путь, 3 время замаха, 4 урон, 5 группа задетых
function VStrikeCond takes nothing returns boolean
return GetSpellAbilityId()=='A0H4' and udg_B==true
endfunction
function VStrikeCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local real a=LoadReal(HH,id,1)
local real left=LoadReal(HH,id,2)
local real time=LoadReal(HH,id,3)+0.02
local group gr=LoadGroupHandle(HH,id,5)
local player p=GetOwningPlayer(u)
local real x
local real y
call SaveReal(HH,id,3,time)
if UnitIsAlive(u)==false or udg_B==false or (time>0.4 and left<=0) then
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call SetUnitTimeScale(u,1)
call DestroyGroup(gr)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
elseif time<=0.4 then
// замах
call SetUnitFacing(u,a*bj_RADTODEG)
if time==0.02 or time==0.2 then
set n=CreateUnit(p,'e0AF',GetUnitX(u),GetUnitY(u),GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitVertexColor(n,255,190,190,100)
// красный отблеск клинка на замахе
call EffectCreateAndMove(true,"Others\\red-lizi-shunjian.mdl",a*bj_RADTODEG,0.6,1,1,100,100,100,0,60,u,0,0)
set n=null
endif
if time>0.39 then
// колющий выпад по направлению
call KrDashStart(p,GetUnitX(u),GetUnitY(u),a)
set n=CreateUnit(p,'e0AF',GetUnitX(u),GetUnitY(u),a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.01)
set n=null
call EffectCreateAndMove(true,"BlackGoku\\[AB]AZ_JianCi.mdl",a*bj_RADTODEG,0.8,1.2,0.6,100,100,100,0,70,u,0,0)
call SetUnitInvulnerable(u,true)
call SetUnitAnimation(u,"spell two")
call QueueUnitAnimation(u,"stand") // после анимации — stand, иначе в паузе встаёт в T-позу
call SetUnitTimeScale(u,2)
endif
else
// выпад
call SetUnitXY_1(u,GetUnitX(u)+50*Cos(a),GetUnitY(u)+50*Sin(a),true)
call SaveReal(HH,id,2,left-50)
set x=GetUnitX(u)
set y=GetUnitY(u)
call KrDashFx(p,x,y,a)
call GroupClear(G)
call GroupEnumUnitsInRange(G,x,y,150,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E) and IsUnitInGroup(E,gr)==false then
call GroupAddUnit(gr,E)
if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
call DestroyEffect(AddSpecialEffectTarget("az_hit-red-blade.mdx",E,"chest"))
set EFF=AddSpecialEffect("WindVectorPush.mdx",GetUnitX(E),GetUnitY(E))
call SetSpecialEffectFacing(EFF,a*bj_RADTODEG)
call SetSpecialEffectZ(EFF,100)
call SetSpecialEffectScale(EFF,0.6)
call SetSpecialEffectVertexColour(EFF,255,255,255,120)
call RemoveEffect(EFF,1,true,CreateTimer())
call myCustomDamage(u,E,LoadReal(HH,id,4),false,false,null,null,null)
call SlowUnit(u,E,0.5,0.5,2,2,false)
call Push3(E,45,a,400,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
else
call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,u)
endif
endif
call GroupRemoveUnit(G,E)
endloop
call GroupClear(G)
endif
set gr=null
set p=null
set u=null
set t=null
endfunction
function VStrikeCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real a=Atan2(GetSpellTargetY()-GetUnitY(u),GetSpellTargetX()-GetUnitX(u))
call SaveUnitHandle(HH,id,0,u)
call SaveReal(HH,id,1,a)
call SaveReal(HH,id,2,1100)
call SaveReal(HH,id,3,0)
call SaveReal(HH,id,4,(1+GetUnitAbilityLevel(u,'A0H4'))*GetHeroStr(u,true)+100)
call SaveGroupHandle(HH,id,5,CreateGroup())
call SetUnitFacing(u,a*bj_RADTODEG)
call PauseUnit(u,true)
// замах: Spell Five (у ALO Spell Four) длиннее замаха — короткий Spell One доигрывал на паузе и давал T-позу
call KrSB_Anim(u,"Spell Five","Spell Four")
call SetUnitTimeScale(u,1)
set soundplay=SndN(1249) // Sound\Music\mp3Music\KiritoScream1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.02,true,function VStrikeCast2)
set u=null
set t=null
endfunction
function InitVStrike takes nothing returns nothing
endfunction
function MissleMoveSunshineUppercut2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local unit u=LoadUnitHandle(h,id,7)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
local real dist=LoadReal(h,id,6)
local real mh=LoadReal(h,id,5)
local real rd=SR(x,y,x1,y1)
local player p=GetOwningPlayer(u)
local integer idu=GetPlayerId(p)
if rd>30+speed and IsTerrainPathable(x1,y1,PATHING_TYPE_FLYABILITY)==false then
call SetUnitPosition(l__d,x+speed*Cos(a),y+speed*Sin(a))
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,ParabolaZ(mh,dist,rd),0)
else
call UnitApplyTimedLife(CreateUnit(p,'e0AX',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0AW',x1,y1,GetRandomReal(0,359)),'BTLF',0.01)
call UnitApplyTimedLife(CreateUnit(p,'e0B1',x1,y1,GetRandomReal(0,359)),'BTLF',0.4)
call UnitApplyTimedLife(CreateUnit(p,'e0B4',x1,y1,GetRandomReal(0,359)),'BTLF',0.4)
call UnitApplyTimedLife(CreateUnit(p,'e0AZ',x1,y1,GetRandomReal(0,359)),'BTLF',0.4)
call UnitApplyTimedLife(CreateUnit(p,'e0B3',x1,y1,GetRandomReal(0,359)),'BTLF',0.4)
call SetUnitFlyHeight(l__d,0,0)
call SetUnitPathing(l__d,true)
call SetControlToUnit(u,l__d,2,"stun")
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set p=null
set l__d=null
set t=null
endfunction
function MissleMoveSunshineUppercut takes unit l__d,real speed,real angle,real x,real y,real mh,unit u returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SetUnitPathing(l__d,false)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,mh)
call SaveReal(h,id,6,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveUnitHandle(h,id,7,u)
call SaveReal(h,id,7,0)
call TimerStart(t,0.03,true,function MissleMoveSunshineUppercut2)
set t=null
endfunction
function SunshineUppercutCond takes nothing returns boolean
return GetSpellAbilityId()=='A0HF' and udg_B==true
endfunction
function SunshineUppercutCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>50 and GetWidgetLife(c)>0 then
set x=x+60*Cos(a)
set y=y+60*Sin(a)
call SetUnitXY_1(u,x,y,false)
call SetUnitFacing(u,a*bj_RADTODEG)
set n=CreateUnit(p,'e01P',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.25)
call SetUnitVertexColor(n,255,255,255,100)
call SetUnitTimeScale(n,2)
call SetUnitAnimation(n,"walk")
call SetUnitAnimation(u,"walk")
else
call SetUnitAnimation(u,"Attack Five")
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
call myCustomDamage(u,c,11*GetHeroStr(u,true),false,false,null,null,null)
call MissleMoveSunshineUppercut(c,30,0,x1+900*Cos(a),y1+900*Sin(a),450,u)
else
call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
endif
call UnitAddAbility(c,'Arav')
call UnitRemoveAbility(c,'Arav')
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitTimeScale(u,1)
call SetUnitPathing(u,true)
call PauseUnit(u,false)
call FlushChildHashtable(h,id)
call SetUnitInvulnerable(u,false)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function SunshineUppercutCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
call SaveUnitHandle(h,id,0,u)
call SetUnitPathing(u,false)
call SetUnitAnimation(u,"walk")
call PauseUnit(u,true)
call SaveReal(h,id,9,Atan2(GetUnitY(c)-y,GetUnitX(c)-x))
call SetUnitTimeScale(u,5)
call SetUnitInvulnerable(u,true)
call SaveUnitHandle(h,id,1,c)
set soundplay=SndN(1252) // Sound\Music\mp3Music\RyoheiT2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.025,true,function SunshineUppercutCast2)
set c=null
set u=null
set t=null
endfunction
function SunshineUppercutInit takes nothing returns nothing
endfunction
function CambioEffectCond takes nothing returns boolean
return GetLearnedSkill()=='A0HC' and IsUnitIllusion(GetTriggerUnit())==false
endfunction
function CambioEffectAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local integer i=0
local integer idu=GetHandleId(u)
local integer strh=TIME_HASH
local integer hs=LoadInteger(HH,idu,SH_d)
local real f=0
local real time=LoadReal(HH,idu,strh)+0.04
local integer ids=0
local real ml=GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.05
set txt=LoadTextTagHandle(HH,id,1)
if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
call SaveReal(HH,idu,strh,time)
call HealTextTag(u,u,(GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.0025)*hs*0.04*myCustomHeal2(u,1),"HealthRes")
call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+(GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.0025)*hs*0.04)
endif
if hs>=3 and hs<=5 then
set ids='A0HE'
elseif hs>=6 and hs<=8 then
set ids='A0HF'
elseif hs>8 then
set ids='A0HG'
endif
if GetUnitAbilityLevel(u,'A0HE')>0 and hs>5 then
call UnitRemoveAbility(u,'A0HE')
elseif GetUnitAbilityLevel(u,'A0HF')>0 and hs>8 then
call UnitRemoveAbility(u,'A0HF')
elseif GetUnitAbilityLevel(u,'A0HF')>0 and hs<8 then
call UnitRemoveAbility(u,'A0HG')
endif
if time>=25 then
call SaveReal(HH,idu,strh,0)
call UnitRemoveAbility(u,'A1A3')
if hs>0 then
call SaveInteger(HH,idu,SH_d,hs-1)
endif
endif
call SetTextTagPos(txt,GetUnitX(u)-190*Cos(f),GetUnitY(u)-190*Sin(f),GetUnitFlyHeight(u)+100+(10.5*0.08)/10)
if GetUnitAbilityLevel(u,'A1A3')>0 then
if GetUnitAbilityLevel(u,'A0HE')==0 and GetUnitAbilityLevel(u,'A0HF')==0 and GetUnitAbilityLevel(u,'A0HG')==0 then
call UnitAddAbility(u,ids)
endif
if GetLocalPlayer()==GetOwningPlayer(u)then
call SetTextTagVisibility(txt,true)
endif
else
call SaveInteger(HH,idu,SH_d,0)
call UnitRemoveAbility(u,'A0HE')
call UnitRemoveAbility(u,'A0HF')
call UnitRemoveAbility(u,'A0HG')
call SetTextTagVisibility(txt,false)
call DestroyTextTag(txt)
endif
if hs<10 then
loop
exitwhen i>=10
if i<hs then
call SetTextTagText(txt,s,(10.5*0.08)/10)
set s=s+"|cFFFFFF00•|r"
else
set s=s+"•"
call SetTextTagText(txt,s,(10.5*0.08)/10)
endif
set i=i+1
endloop
else
set s="|cFFFFFF00••••••••••|r"
call SetTextTagText(txt,s,(10.5*0.08)/10)
endif
set s=null
set t=null
set u=null
endfunction
function CambioEffectStart takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local integer i=1
local integer idu=GetHandleId(u)
set txt=CreateTextTag()
set s="•"
loop
exitwhen i>=11
call SetTextTagText(txt,s,(10.5*0.08)/10)
set s=s+"•"
set i=i+1
endloop
call SetTextTagVisibility(txt,false)
if GetLocalPlayer()==p then
call SetTextTagVisibility(txt,true)
endif
call SetTextTagPosUnit(txt,u,(10.5*0.08)/10)
call SetTextTagColor(txt,255,255,255,255)
call SaveUnitHandle(HH,id,0,u)
call SaveTextTagHandle(HH,id,1,txt)
call SaveInteger(HH,GetHandleId(u),SH_d,0)
call SaveReal(HH,GetHandleId(u),TIME_HASH,0)
call TimerStart(t,0.04,true,function CambioEffectAct)
set txt=null
set s=null
set t=null
set u=null
set p=null
endfunction
function InitCambioEffect takes nothing returns nothing
endfunction
function MaxCombCond takes nothing returns boolean
return GetSpellAbilityId()=='A02X' and udg_B==true
endfunction
function MaxCombCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=LoadReal(h,id,5)
local real dmg=(3+GetUnitAbilityLevel(u,'A02X'))*GetHeroStr(u,true)
local player p=GetOwningPlayer(u)
local real time=LoadReal(h,id,7)
local real mt=LoadReal(h,id,8)
local real dist=GetRandomReal(-100,100)
local real a2=a+90*bj_DEGTORAD
if mt>0 and UnitIsAlive(u)then
set x1=x1-40*Cos(a)
set y1=y1-40*Sin(a)
call SetUnitXY_1(u,x1,y1, false)
if time<0 then
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call PauseUnit(u,true)
set x1=x1+53*Cos(a)
set y1=y1+53*Sin(a)
call SetUnitXY_1(c,x1,y1, false)
call UnitApplyTimedLife(CreateUnit(p,'e0B1',x1,y1,GetRandomReal(0,359)),'BTLF',0.4)
call UnitApplyTimedLife(CreateUnit(p,'e0B4',x1,y1,GetRandomReal(0,359)),'BTLF',0.4)
set n=CreateUnit(p,'e01P',x1+dist*Cos(a2),y1+dist*Sin(a2),a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,4)
call SetUnitAnimation(n,"attack")
call SetUnitVertexColor(n,255,255,255,100)
set n=CreateUnit(p,'e0B2',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitVertexColor(n,255,220,40,50)
call SaveReal(h,id,7,mt)
call SaveReal(h,id,8,mt-0.2)
endif
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitAnimation(u,"attack")
call SaveReal(h,id,7,LoadReal(h,id,7)-3)
