call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,2,c)
call SaveReal(h,id,1,x1)
call SaveReal(h,id,2,y1)
loop
exitwhen i>=4
set r=120*i*bj_DEGTORAD
set n=CreateUnit(p,'e05A',x1+700*Cos(r),y1+700*Sin(r),f)
call UnitAddAbility(n,'A013')
call MissleMoveMukuro(n,60,0,c,"Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",0,u)
set i=i+1
endloop
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Mukuro4Form3.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.6,false,function CastASA2)
set t=null
set p=null
set u=null
set c=null
endfunction
