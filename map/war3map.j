set facingNew=30
endif

if facingRand==2 then
set facingNew=-30
endif

set n0=CreateUnit(GetOwningPlayer(caster),'e218',GetUnitX(LoadUnitHandle(HH,id,24)),GetUnitY(LoadUnitHandle(HH,id,24)),facing+facingNew)
call GroupAddUnit(gr,n0)

call UnitSize(n0,0.5,1,1)
call SetUnitFlyHeight(n0,50,0)
call MoveUnit(n0,n0,-50,facing)
call UnitSpeed(n0,0.7)
call UnitColor(n0,100,100,100,20)
call SetUnitAnimationByIndex(n0,2)
call MyRemoveUnit(n0,5.1-time)
call SaveGroupHandle(HH,GetHandleId(caster),SH_MadWGroup1,gr)

endif

call SaveReal(HH,id,6,time1)
  endif








    endif
set caster=null
set t=null
set n0=null
set b1=null
set gr=null
endfunction
