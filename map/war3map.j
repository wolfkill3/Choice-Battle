function InitTrig_Dialog2 takes nothing returns nothing
set gg_trg_Dialog2=CreateTrigger()
call TriggerAddCondition(gg_trg_Dialog2,Condition(function Trig_Dialog2_Conditions))
call TriggerAddAction(gg_trg_Dialog2,function Trig_Dialog2_Actions)
endfunction

function GearScore2 takes integer i returns real
local integer id=1
local real sc=0
loop
exitwhen id==175
if score[id]==i then
set sc=gear[id]
endif
set id=id+1
endloop
return sc
endfunction
function SunRing takes unit u returns real
local integer i=0
local real sc=0
loop
exitwhen i>=6
if GetItemTypeId(UnitItemInSlot(u,i))=='I05H' or GetUnitAbilityLevel(u,'KIS4')>0 then
set sc=sc+1
endif
if GetItemTypeId(UnitItemInSlot(u,i))=='I05G' or GetUnitAbilityLevel(u,'KIS2')>0 then
set sc=sc+0.9
endif
if GetItemTypeId(UnitItemInSlot(u,i))=='I05F' or GetUnitAbilityLevel(u,'KIS0')>0 then
set sc=sc+0.8
endif
if GetItemTypeId(UnitItemInSlot(u,i))=='I05E' or GetUnitAbilityLevel(u,'KIR8')>0 then
set sc=sc+0.7
endif
if GetItemTypeId(UnitItemInSlot(u,i))=='I05D' or GetUnitAbilityLevel(u,'KIR6')>0 then
set sc=sc+0.6
endif
if GetItemTypeId(UnitItemInSlot(u,i))=='I05C' or GetUnitAbilityLevel(u,'KIR4')>0 then
set sc=sc+0.5
endif
set i=i+1
endloop
return sc
endfunction
function GearScore takes unit u returns real
local integer i=0
local real sc=0
loop
exitwhen i>=6
set sc=sc+GearScore2(GetItemTypeId(UnitItemInSlot(u,i)))
set i=i+1
endloop
return sc
endfunction
function UpdateMultiboard takes nothing returns nothing
        local multiboarditem mbitem
        local integer Rowx
        set Rowx=0
        loop
        exitwhen Rowx>=10
        if ingame[Rowx]==true then
                set nick[Rowx]=udg_Color[Rowx+1]+GetPlayerName(Player(Rowx))+"["+I2S(Rowx+1)+"]"
                set mbitem=MultiboardGetItem(mbg,row[Rowx],0)
