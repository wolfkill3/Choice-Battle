call TriggerAddCondition(gg_trg_TAtalanta,Condition(function TAtalantaCond))
call TriggerAddAction(gg_trg_TAtalanta,function TAtalantaCast)
endfunction
function TAlterAtalantaCond takes nothing returns boolean
return GetSpellAbilityId()=='A1DZ' and GetUnitTypeId(GetTriggerUnit())=='H06L'
endfunction
function TAlterAtalantaCast2 takes nothing returns nothing
