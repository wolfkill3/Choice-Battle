function ShukakuLanceCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local player p=GetOwningPlayer(u)
local integer idu=GetPlayerId(p)
local real x=LoadReal(h,id,3)
local real y=LoadReal(h,id,4)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,8)
local real dmg=GetHeroInt(u,true)*4
local real Range=LoadReal(h,id,9)
if Range<2100 and UnitIsAlive(l__d)then
set x1=x1+50*Cos(a)
set y1=y1+50*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
call SaveReal(h,id,3,x1)
call SaveReal(h,id,4,y1)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SaveReal(h,id,9,Range+40)
call GroupEnumUnitsInRange(G,x1,y1,110,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)and UnitIsAlive(l__d)then
call SetControlToUnit(E,E, 0.1, "stun")
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\SandExplosion.mdx",E,"chest"))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\SandPoff.mdx",E,"chest"))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",E,"chest"))
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call RemoveUnit(l__d)
endif
call GroupRemoveUnit(G,E)
endloop
else
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
endif
set u=null
set p=null
set t=null
set l__d=null
endfunction
