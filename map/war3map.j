function TDeidaraCast4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real dmg=GetHeroInt(u,true)*3
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real a=LoadReal(h,id,3)
local real dist=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,4)
local group g2
if dist<4 and GetWidgetLife(l__d)>0 then
call SaveReal(h,id,2,dist+0.1)
set g2=CopyGroup(g)
loop
set E=FirstOfGroup(g2)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,GetUnitState(E,UNIT_STATE_MAX_LIFE)*0.02,false,false,null, DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_WHOKNOWS)
endif
call GroupRemoveUnit(g2,E)
endloop
call DestroyGroupTimed(g2,3)
else
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set g2=null
set l__d=null
set u=null
set p=null
set t=null
endfunction
