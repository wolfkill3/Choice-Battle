        call SaveReal(HH, id, 1, GetWidgetLife(newCaster))
        call SaveReal(HH, id, 2, 7.0)
        call SaveReal(HH, id, 3, GetUnitX(newCaster))
        call SaveReal(HH, id, 4, GetUnitY(newCaster))
        call TimerStart(newTimer, 0.1, true, function ShadowCover_KazumaPeriodic)
    else
        call DestroyTimer(newTimer)
    endif
    set newTimer = null
endfunction

