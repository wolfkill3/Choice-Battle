function InitTrig_ByakuranGesso takes nothing returns nothing
    local trigger ByakuranGesso = CreateTrigger(  )
    local integer index
    set index = 0
    loop
        call TriggerRegisterPlayerUnitEvent(ByakuranGesso, Player(index), EVENT_PLAYER_UNIT_SPELL_EFFECT, null)
        set index = index + 1
        exitwhen index == bj_MAX_PLAYER_SLOTS
    endloop
    call TriggerAddCondition(ByakuranGesso, Condition( function Byakuran_Cond ) )
    call TriggerAddAction(ByakuranGesso, function Byakuran_Act )
    set ByakuranGesso = null
endfunction
