local group g=LoadGroupHandle(h,id,3)
if SR(x,y,x1,y1)>40 and IsTerrainPathable(GetUnitX(l__d),GetUnitY(l__d),PATHING_TYPE_FLYABILITY)==false then
set x=x+50*Cos(a)
set y=y+50*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitVertexColor(n,255,255,255,50)
set n=CreateUnit(p,'e0TQ',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,255,255,255,50)
else
call GroupEnumUnitsInRange(g,x1,y1,800,Base)
loop
set E=FirstOfGroup(g)
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
set n=CreateUnit(p,'e0P7',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',15)
call SetUnitFlyHeight(n,350,0)
call SetUnitTimeScale(n,.25)
set n=CreateUnit(p,'e0P6',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',15)
call SetUnitFlyHeight(n,350,0)
call SetUnitTimeScale(n,.25)
set n=CreateUnit(p,'e0P5',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',15)
call SetUnitFlyHeight(n,350,0)
call SetUnitTimeScale(n,.25)
set n=CreateUnit(p,'e0P4',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',15)
call SetUnitFlyHeight(n,350,0)
call SetUnitTimeScale(n,.25)
set n=CreateUnit(p,'e0P8',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',15)
call SetUnitFlyHeight(n,350,0)
call SetUnitTimeScale(n,.25)
set n=CreateUnit(p,'e0P5',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',15)
call SetUnitFlyHeight(n,350,0)
call SetUnitTimeScale(n,.25)
set n=CreateUnit(p,'e0P8',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',15)
call SetUnitFlyHeight(n,350,0)
call SetUnitTimeScale(n,.25)
call RemoveUnit(l__d)
call FlushChildHashtable(h,GetHandleId(g))
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
function CastKuchiouseKuibi takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real x2=0
local real y2=0
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local unit l__n
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,3,CreateGroup())
call SaveReal(h,id,4,a)
call SaveReal(h,id,10,2000)
set E=CreateUnit(p,'e0KF',x+35*Cos(a),y+35*Sin(a),GetRandomReal(0,359))
call UnitApplyTimedLife(E,'BTLF',0.25)
call SetUnitTimeScale(E,0.65)
call SetUnitAnimation(E,"Birth")
set x2=x-500*Cos(a)
set y2=y-500*Sin(a)
call UnitAddAbility(u,'A0MX')
call UnitApplyTimedLife(CreateUnit(p,'e0KE',x2,y2,GetRandomReal(0,359)),'BTLF',0.3)
call UnitApplyTimedLife(CreateUnit(p,'e0KG',x2,y2,GetRandomReal(0,359)),'BTLF',0.5)
set l__n=CreateUnit(p,0x65304B44,x2,y2,a*bj_RADTODEG)
call SetUnitAnimation(l__n,"Spell One")
call UnitApplyTimedLife(l__n,'BTLF',3)
call SetUnitTimeScale(l__n,3)
set soundplay=SndN(1618) // Sound\Music\mp3Music\KuchiyoseNoJutsuKuybi.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call PolledWait(1)
call SetUnitAnimation(l__n,"Spell Two")
call PolledWait(0.4)
call SetUnitAnimation(l__n,"Spell Three")
call PolledWait(0.2)
call UnitRemoveAbility(u,'A0MX')
call ShakeCamera(0.5,20)
call SaveReal(h,id,8,x1)
call SaveReal(h,id,9,y1)
call SaveReal(h,id,10,x2+150*Cos(a))
call SaveReal(h,id,11,y2+150*Sin(a))
set l__n=CreateUnit(p,0x65305450,x2+150*Cos(a),y2+150*Sin(a),a*bj_RADTODEG)
call SetUnitAnimation(l__n,"birth")
call SetUnitTimeScale(l__n,0.75)
call SaveUnitHandle(h,id,1,l__n)
call TimerStart(t,0.03,true,function CastKuchiouseKuibi2)
set u=null
set l__n=null
set p=null
set t=null
endfunction
function KuchiouseKuibiInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function CastKuchiouseKuibi)
call TriggerAddCondition(t,Condition(function CondKuchiouseKuibi))
set t=null
endfunction
