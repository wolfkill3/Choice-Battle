endfunction
function HookCond takes nothing returns boolean
return GetSpellAbilityId()=='A0CR' and udg_B==true
endfunction
function HookCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit l__d=LoadUnitHandle(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real x2=GetUnitX(u)
local real y2=GetUnitY(u)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local integer count=LoadInteger(h,id,9)
local integer l__s=StringHash("chain")
local boolean b=LoadBoolean(h,id,7)
local integer min=LoadInteger(h,id,11)-1
local group g=LoadGroupHandle(h,id,12)
local real time=LoadReal(h,id,13)
local boolean b2=LoadBoolean(h,id,14)
set n=LoadUnitHandle(h,id,l__s+min+1)
if SR(x2,y2,GetUnitX(n),GetUnitY(n))>50 and GetUnitAbilityLevel(u,'A3IH')==0 and GetUnitAbilityLevel(c,'A3IH')==0 and ((GetUnitAbilityLevel(u,'A0IH')==0 and GetUnitAbilityLevel(c,'A0IH')==0) or (GetUnitAbilityLevel(u,'A0IH')>0 and GetUnitAbilityLevel(c,'A0IH')>0)) and time<2 then
    if min==-1 then
        set n=CreateUnit(p,'e07K',x2,y2,a*bj_RADTODEG)
    else
        set n=CreateUnit(p,'e07K',x2,y2,Atan2(GetUnitY(n)-y2,GetUnitX(n)-x2)*bj_RADTODEG)
    endif
    call GroupAddUnit(g,n)
    call SaveUnitHandle(h,id,l__s+min,n)
    call SaveInteger(h,id,11,min)
endif
if SR(x,y,x1,y1)>32 and b==false then
    if time>1.5 then
        call SaveBoolean(h,id,7,true)
    else
        set x=x+50*Cos(a)
        set y=y+50*Sin(a)
        call SaveReal(h,id,13,time+0.03)
        call SetUnitXY_1(l__d,x,y, false)
        call SetUnitFacing(l__d,a*bj_RADTODEG)
        set n=CreateUnit(p,'e07K',x,y,a*bj_RADTODEG)
        call SaveUnitHandle(h,id,l__s+count,n)
        call SaveInteger(h,id,9,count+1)
        call GroupAddUnit(g,n)
    endif
elseif SR(x,y,x1,y1)<32 and b==false and LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
    call SaveReal(h,id,13,0)
    set time=0
    call SaveBoolean(h,id,7,true)
    call SaveBoolean(h,id,14,true)
elseif SR(x,y,x1,y1)<32 and b==false and (LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==true or IsUnitHidden(c)==true ) then
    call SaveBoolean(h,id,7,true)
    if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==true then
        call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
    endif
endif
if count>min-1 and b==true then
    set n10=LoadUnitHandle(h,id,l__s+count-1)
    set x=GetUnitX(n10)
    set y=GetUnitY(n10)
    call SetUnitXY_1(l__d,x,y, false)
    if time<2 then
        if b2==true then
            call PauseUnit(c,true)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
            call SetUnitXY_1(c,x,y, false)
        endif
        call SaveReal(h,id,13,time+0.03)
        call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",x,y))
    endif
    call SaveInteger(h,id,9,count-1)
    call GroupRemoveUnit(g,n10)
    call RemoveUnit(n10)
endif
if (FirstOfGroup(g)==null or time>1.5) and time<2.5 then
if b2==true then
    call PauseUnit(c,false)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
    call myCustomDamage(u,c,(1+GetUnitAbilityLevel(u,'A0CR'))*GetHeroInt(u,true)+100,false,false,null,null,null)
    call SetControlToUnit(u,c,1, "stun")
endif
if FirstOfGroup(g)==null and b2==true then
call SetUnitXY_1(c,x2,y2, false)
endif
call SaveReal(h,id,13,4)
endif
if FirstOfGroup(g)==null and b==true then
call SetUnitInvulnerable(u,false)
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
call FlushChildHashtable(h,id)
endif
set g=null
set l__d=null
set p=null
set u=null
set c=null
set t=null
endfunction
