function AizenRChargeExpAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit Dummy=LoadUnitHandle(HH,id,20)
local unit casterOriginal=LoadUnitHandle(HH,id,30)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real time2=LoadReal(HH,id,8)
local real x1=GetUnitX(Dummy)
local real y1=GetUnitY(Dummy)
local real damage=LoadReal(HH,id,15)
local real Hado90Buff=LoadReal(HH,id,17)
set time=time+0.02
call SaveReal(HH,id,5,time)
if time==2 then


call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())

else
if time<0.9 then
set time2=time2+0.02

if time2==0.06 or time==0.02 then
set time2=0
call EffectCreateAndMove(true,"BlackGoku\\dustwaveanimate2.mdl",GetRandomReal(0,360),1.25,1.3+Hado90Buff*0.2,GetRandomReal(0.4,0.8),60,0,100,GetRandomReal(30,60),0,caster,0,facing)
endif

call SaveReal(HH,id,8,time2)
call PauseUnit(caster,true)
endif

if time==0.02 then
call SaveEffectHandle(HH,id,24,AddSpecialEffectTarget("Aizen\\file00001326.mdl",caster,"hand left"))
call SaveEffectHandle(HH,id,23,AddSpecialEffectTarget("Aizen\\buff_zi.mdl",caster,"hand left"))
set soundplay=CreateSound("Sound\\Music\\mp3Music\\AizenR.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",facing,1.5,1.5+Hado90Buff*0.15,1,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"Others\\HakkeStart2.mdl",facing,2,1.5+Hado90Buff*0.1,0.5,100,100,100,60,0,caster,0,facing)
call EffectCreateAndMove(true,"Others\\HakkeStart2.mdl",facing,2.5,2.5+Hado90Buff*0.2,0.5,100,100,100,40,-100,Dummy,0,facing)
call EffectCreateAndMove(true,"Aizen\\az_cocoguanyu_t2_death_purple.mdl",facing,1.25,1.5,0.5,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"Aizen\\beamdarkpurple.mdl",facing,1.25,1+Hado90Buff*0.15,0.5,100,100,100,0,0,caster,0,facing)
call UnitSpeed(caster,1)
if GetUnitTypeId(caster)=='H12M' then
call SetUnitAnimationByIndex(caster,17)
else
call SetUnitAnimationByIndex(caster,9)
endif
endif
if time==0.3 then
call UnitSpeed(Dummy,1)
endif
if time>0.2 and time<0.9 then
call GroupClear(G)
call GroupEnumUnitsInRange(G,GetUnitX(Dummy),GetUnitY(Dummy),500+50*Hado90Buff,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null

if SR(GetUnitX(n0),GetUnitY(n0),x1,y1)>400 and IsUnitEnemy(n0,GetOwningPlayer(caster))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false then
call MoveUnit(n0,n0,Hado90Buff*2+50,Angle2(GetUnitX(n0),GetUnitY(n0),x1,y1))
endif

call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
endif


if time==0.9 then


if caster!=casterOriginal then

call StartAbilityCooldown(GetUnitAbility(casterOriginal, 'ASR1'), 34.1 )

endif

call StartAbilityCooldown(GetUnitAbility(caster, 'ASR1'), 34.1 )
call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",facing,1.5,2.5+Hado90Buff*0.1,1.5,100,100,100,0,0,Dummy,0,facing)
call EffectCreateAndMove(true,"Aizen\\TohkaEf4.mdl",facing,3,1.2+Hado90Buff*0.15,0.5,100,100,100,0,0,Dummy,0,facing)
call EffectCreateAndMove(true,"Aizen\\chushou_by_wood_huozhu_black.mdl",facing,3,1.5+Hado90Buff*0.3,1,100,100,100,60,0,Dummy,0,facing)
call DestroyEffect(LoadEffectHandle(HH,id,23))
call DestroyEffect(LoadEffectHandle(HH,id,24))
call PauseUnit(caster,false)

if LoadBoolean(HH,id,35)==true then
call StunAoeOneTime(casterOriginal,x1,y1,500+50*Hado90Buff,2)
endif

call UnitSpeed(caster,1)
call UnitSpeed(Dummy,0.55)
call MyRemoveUnit(Dummy,3)

endif

if time==0.9 or time==1 or time==1.1 or time==1.2 or time==1.3 or time==1.4 or time==1.5 or time==1.6 or time==1.7 or time==1.8 then
call DamageAoeOneTime0(casterOriginal,x1,y1,500+50*Hado90Buff,damage*0.1035)
endif








endif
set caster=null
set Dummy=null
set casterOriginal=null
endfunction
















function AizenRChargeAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit Dummy=LoadUnitHandle(HH,id,20)
local unit casterOriginal=LoadUnitHandle(HH,id,30)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real time1=LoadReal(HH,id,6)
local real time2=LoadReal(HH,id,8)
local real x1=GetUnitX(Dummy)
local real y1=GetUnitY(Dummy)
local real damage=LoadReal(HH,id,15)
set time=time+0.02
call SaveReal(HH,id,5,time)
set time1=time1+0.02
call SaveReal(HH,id,6,time1)
if time==1 or time==2 or time==3 or time==4 or time==5 or time==6 or time==7 or time==8 or time==9 or time==10 or time==11 or time==12 or time==13 or time==14 or time==15 or time==16 or time==17 or time==18  or time==19    then
call SetUnitState(caster,UNIT_STATE_MANA,GetUnitState(caster,UNIT_STATE_MANA)-GetUnitState(caster,UNIT_STATE_MAX_MANA)*0.01-50)

endif


if time==23 then
call SaveReal(HH,GetHandleId(casterOriginal),StringHash("AizenR"),0)
call UnitRemoveAbility(caster,'ASR2')
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'ASR1',true)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else

if time<19 then
set time2=time2+0.02
if time2==0.06 or time==0.02 then
set time2=0
call EffectCreateAndMove(true,"BlackGoku\\dustwaveanimate2.mdl",GetRandomReal(0,360),1.25,1.3+time*0.2,GetRandomReal(0.4,0.8),60,0,100,GetRandomReal(30,60),0,caster,0,facing)
endif
call SaveReal(HH,id,8,time2)
endif

if time==0.02 then
if GetUnitTypeId(caster)=='H12M' then
call SetUnitAnimationByIndex(caster,17)
else
call SetUnitAnimationByIndex(caster,12)
endif
call SaveEffectHandle(HH,id,28,AddSpecialEffectTarget("Aizen\\file00001326.mdl",caster,"hand left"))
call SaveEffectHandle(HH,id,29,AddSpecialEffectTarget("Aizen\\buff_zi.mdl",caster,"hand left"))
set soundplay=CreateSound("Sound\\Music\\mp3Music\\AizenRself.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call SaveSoundHandle(HH,id,24,soundplay)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
call SetUnitModel(n0,"Others\\HakkeStart2.mdl")
call UnitSize(n0,0.6,1,1)
call UnitSpeed(n0,0.75)
call UnitColor(n0,100,100,100,40)
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call SetUnitFlyHeight(n0,0,0)
call SaveUnitHandle(HH,id,25,n0)
set n0=null
set n0=CreateUnit(GetOwningPlayer(caster),'e200',x1,y1,facing)
call SetUnitModel(n0,"Aizen\\beamdarkpurple.mdl")
call UnitSize(n0,1,1,1)
call UnitSpeed(n0,0.75)
call UnitColor(n0,100,100,100,0)
call SetUnitFlyHeight(n0,0,0)
call SaveUnitHandle(HH,id,27,n0)
set n0=null
endif
call UnitSize(LoadUnitHandle(HH,id,25),1+time*0.1,1,1)
call UnitSize(LoadUnitHandle(HH,id,27),1+time*0.1,1,1)
call MoveUnit(caster,LoadUnitHandle(HH,id,25),0,facing)
call MoveUnit(caster,LoadUnitHandle(HH,id,27),0,facing)
if time==0.5 then
call UnitSpeed(LoadUnitHandle(HH,id,25),0)
endif
if time==5 then
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'ASR1',false)
call UnitAddAbility(caster,'ASR2')
if LoadBoolean(HH,id,16)==true then
call SetUnitAbilityLevel(caster,'ASR2',2)
endif
endif


if time==8 or time==12 or time==16 or time==19.8 then
call SetUnitAbilityLevel(caster,'ASR2',GetUnitAbilityLevel(caster,'ASR2')+1)
endif

if OrderId2String(GetUnitCurrentOrder(caster))!="drain"and time<20 then
set time=20
call SaveReal(HH,id,5,time)
endif

if GetUnitAbilityLevel(caster,'ASR1')<5 then

if time==5.1*GetUnitAbilityLevel(caster,'ASR1') then

call UnitStop(caster)

endif


endif

if GetUnitState(caster,UNIT_STATE_MANA)<GetUnitState(caster,UNIT_STATE_MAX_MANA)*0.1 and time<20 then
call UnitStop(caster)
call SaveReal(HH,id,5,19.98)
endif



if time==20 then
call RemoveUnit(LoadUnitHandle(HH,id,25))
call RemoveUnit(LoadUnitHandle(HH,id,27))
call DestroyEffect(LoadEffectHandle(HH,id,28))
call DestroyEffect(LoadEffectHandle(HH,id,29))
//if(GetLocalPlayer()==GetOwningPlayer(caster))then
//call DisplayTextToPlayer(GetLocalPlayer(),0,0,"time left"+R2S(time1))
//endif
call SaveReal(HH,GetHandleId(casterOriginal),StringHash("AizenR"),time1)
call StopSound(LoadSoundHandle(HH,id,24),true,false)
call KillSoundWhenDone(LoadSoundHandle(HH,id,24))
endif
endif


set caster=null
set Dummy=null
set casterOriginal=null
endfunction





function AizenRAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit Dummy=LoadUnitHandle(HH,id,20)
local unit casterOriginal=LoadUnitHandle(HH,id,30)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real distance=LoadReal(HH,id,8)
local real x1=GetUnitX(Dummy)
local real y1=GetUnitY(Dummy)
local real damage=LoadReal(HH,id,15)
set time=time+0.02
call SaveReal(HH,id,5,time)
if time==1 then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\AizenR2.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else
if time<0.5 then
call PauseUnit(caster,true)
endif
if time==0.02 then
call SaveEffectHandle(HH,id,24,AddSpecialEffectTarget("Aizen\\file00001326.mdl",caster,"hand left"))
call SaveEffectHandle(HH,id,23,AddSpecialEffectTarget("Aizen\\buff_zi.mdl",caster,"hand left"))
set soundplay=CreateSound("Sound\\Music\\mp3Music\\AizenR1.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",facing,1.5,1.5,1,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"Others\\HakkeStart2.mdl",facing,2,1.5,0.5,100,100,100,60,0,caster,0,facing)
call EffectCreateAndMove(true,"Others\\HakkeStart2.mdl",facing,2.5,2.5,0.5,100,100,100,40,-100,Dummy,0,facing)
call EffectCreateAndMove(true,"Aizen\\az_cocoguanyu_t2_death_purple.mdl",facing,1.25,1.5,0.5,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"Aizen\\beamdarkpurple.mdl",facing,1.25,1,0.5,100,100,100,0,0,caster,0,facing)
call UnitSpeed(caster,2)
if GetUnitTypeId(caster)=='H12M' then
call SetUnitAnimationByIndex(caster,17)
else
call SetUnitAnimationByIndex(caster,9)
endif
endif
if time==0.1 then
call UnitSpeed(caster,1)
endif
if time>0.2 and time<0.5 then
call GroupClear(G)
call GroupEnumUnitsInRange(G,GetUnitX(Dummy),GetUnitY(Dummy),500,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if SR(GetUnitX(n0),GetUnitY(n0),x1,y1)>200 and IsUnitEnemy(n0,GetOwningPlayer(caster))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false then
call MoveUnit(n0,n0,50,Angle2(GetUnitX(n0),GetUnitY(n0),x1,y1))
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
endif
if time==0.5 then
call EffectCreateAndMove(true,"BlackGoku\\aZ_siwenBlackGoku.mdl",facing,1.5,1.75,0.5,60,0,100,0,300,Dummy,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\aZ_siwenBlackGoku.mdl",facing,1.5,1.75,0.5,60,0,100,0,600,Dummy,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\aZ_siwenBlackGoku.mdl",facing,1.5,1.75,0.5,60,0,100,0,900,Dummy,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\aZ_siwenBlackGoku.mdl",facing,1.5,1.75,0.5,60,0,100,0,1200,Dummy,0,facing)
call DestroyEffect(LoadEffectHandle(HH,id,23))
call DestroyEffect(LoadEffectHandle(HH,id,24))
call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",facing,1.5,2.5,1.5,100,100,100,0,0,Dummy,0,facing)
call PauseUnit(caster,false)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\AizenRSFX.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call DamageAoeOneTime0(casterOriginal,x1,y1,500,damage)
call StunAoeOneTime(casterOriginal,x1,y1,500,2)
call UnitSpeed(caster,1)
call UnitSpeed(Dummy,0.55)
call MyRemoveUnit(Dummy,2)
endif
endif
set caster=null
set Dummy=null
set casterOriginal=null
endfunction


