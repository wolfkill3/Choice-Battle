function SinonAmmo_Periodic takes nothing returns nothing
	local integer id = GetHandleId(GetExpiredTimer())
    local integer ip_target = LoadInteger(HH, id, 0)
	local integer id_target = GetHandleId(Hero[ip_target])
    local unit    indicator = LoadUnitHandle(HH, ip_target, SinonIndicator)
    local unit    target    = Hero[ip_target]
	local integer ammo = LoadInteger(HH, id_target, Sinon_Ammo)

	if target!=null and GetUnitTypeId(target)=='H04T' then
        if indicator==null then
            set indicator = CreateUnit(GetOwningPlayer(target), 'dSin', GetUnitX(target)-20, GetUnitY(target), 270)
            call SetUnitScale(indicator, 1.5, 1.5, 1.5)
            call SaveUnitHandle(HH, ip_target, SinonIndicator, indicator)
        endif
		call SetUnitFlyHeight(indicator, GetUnitFlyHeight(target)+250, 0)
		call SetUnitAnimationByIndex(indicator, ammo)
		call SetUnitXY(indicator, GetUnitX(target), GetUnitY(target))
		if CheckUnitInvisible(target) then
			if GetUnitAbilityLevel(indicator, 'A0A1')==0 then
				call UnitAddAbility(indicator, 'A0A1')
			endif
		else
			if GetUnitAbilityLevel(indicator, 'A0A1')==1 then
				call UnitRemoveAbility(indicator, 'A0A1')
			endif
		endif
	else
		call RemoveUnit(indicator)
		call RemoveSavedHandle(HH, ip_target, SinonIndicator)
		call FlushChildHashtable(HH, id)
		call DestroyTimer(GetExpiredTimer())
	endif
    set indicator = null
    set target = null
endfunction

function SinonAmmo_Create takes unit newCaster returns nothing
    local timer newTimer = CreateTimer()
    local integer ip_target = GetPlayerId(GetOwningPlayer(newCaster))
    if LoadUnitHandle(HH, ip_target, SinonIndicator)==null and GetHeroLevel(newCaster)>=12 then
		call SaveInteger(HH, GetHandleId(newTimer), 0, ip_target)
        call SaveInteger(HH, GetHandleId(newCaster), Sinon_Ammo, 7) // Обновление магазина Синон

		set bjLCU = CreateUnit(GetOwningPlayer(newCaster), 'dSin', GetUnitX(newCaster), GetUnitY(newCaster), 270)
        call SetUnitAnimationByIndex(bjLCU, 0)
        call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
        call SetUnitFlyHeight(bjLCU, GetUnitFlyHeight(newCaster)+250, 0)
        call SaveUnitHandle(HH, ip_target, SinonIndicator, bjLCU)

		call TimerStart(newTimer, 0.02, true, function SinonAmmo_Periodic)
    else
        call DestroyTimer(newTimer)
	endif
    set newTimer  = null
endfunction

function TextTagFull3 takes string l__s,unit u,integer r,integer g,integer b,integer l__v,player p,real size returns nothing
local texttag l__txt=CreateTextTag()
local real f=(GetUnitFacing(u)+90)*bj_DEGTORAD
call SetTextTagText(l__txt,l__s,size)
call SetTextTagVisibility(l__txt,false)
if GetLocalPlayer()==p then
call SetTextTagVisibility(l__txt,true)
endif
call SetTextTagPos(l__txt,GetUnitX(u)-50*Cos(f),GetUnitY(u)-50*Sin(f),GetUnitFlyHeight(u)+75)
call SetTextTagColor(l__txt,r,g,b,l__v)
call SetTextTagVelocity(l__txt,0.05*Cos(1.571),0.05*Sin(1.571))
call SetTextTagFadepoint(l__txt,.75)
call SetTextTagLifespan(l__txt,3)
call SetTextTagPermanent(l__txt,false)
set l__txt=null
endfunction
function RecoveryCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit u=LoadUnitHandle(HH,GetHandleId(t),0)
local real ml=GetUnitState(u,UNIT_STATE_MAX_LIFE)
local real l=GetWidgetLife(u)
if UnitIsAlive(u) and GetHeroLevel(u)>5 then
call UnitRemoveBuffs(u,false,true)
call HealTextTag(u,u,ml*0.025*myCustomHeal2(u,1),"HealthRes")
call SetUnitState(u,UNIT_STATE_LIFE,l+GetUnitState(u,UNIT_STATE_MAX_LIFE)*.025)
if GetUnitTypeId(u)=='H14H' then
call DestroyEffect(AddSpecialEffect("war3mapImported\\Death Release.mdx",GetUnitX(u),GetUnitY(u)))
else
call DestroyEffect(AddSpecialEffect("war3mapImported\\Energy_Release.mdx",GetUnitX(u),GetUnitY(u)))
endif
if GetRandomInt(0,100) < 15 and GetUnitTypeId(u)!='H14H' then
set soundplay=SndN(311) // Sound\Music\mp3Music\KONJOU_DA.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
endif
set t=null
set u=null
endfunction
