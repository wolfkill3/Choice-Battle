function Trig_Storm_Ring_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A04Y' and GetUnitTypeId(GetTriggerUnit())!='H007'  and GetUnitAbilityLevel(GetTriggerUnit(),'GIE1')==0
endfunction
function SR_Storm_Ring takes real xa,real ya,real xb,real yb returns real
return SquareRoot((xa-xb)*(xa-xb)+(ya-yb)*(ya-yb))
endfunction
function Trig_Storm_Ring_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit l__d=LoadUnitHandle(HH,id,1)
local unit c=LoadUnitHandle(HH,id,2)
local real a
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real f=GetUnitFacing(u)
if(SR_Storm_Ring(x,y,x1,y1)>47.00)then
set a=Atan2(y1-y,x1-x)
call SetUnitX(l__d,x+49*Cos(a))
call SetUnitY(l__d,y+49*Sin(a))
call SetUnitFacing(l__d,a*bj_RADTODEG)
call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e021',x,y,a*bj_RADTODEG),1,1.1)
else
call myCustomDamage(u,c,3*GetHeroAgi(u,true)+3*GetHeroInt(u,true),false,false,null,null,null)
if IsUnitInvulnerable(c)==false and UnitIsAlive(c) then
call ComboChecker(c,5,5, false )
endif
call RemoveUnit(l__d)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set u=null
set l__d=null
set t=null
set c=null
endfunction
function Trig_Storm_Ring_Actions takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real f=GetUnitFacing(u)
call SaveUnitHandle(HH,id,0,u)
call SaveUnitHandle(HH,id,1,CreateUnit(GetOwningPlayer(u),'e021',GetUnitX(u)+50.*Cos(f*bj_DEGTORAD),GetUnitY(u)+50.*Cos(f*bj_DEGTORAD),f))
call SaveUnitHandle(HH,id,2,GetSpellTargetUnit())
call TimerStart(t,0.04,true,function Trig_Storm_Ring_Actions2)
set u=null
set t=null
endfunction
