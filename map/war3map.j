endfunction
function Trig_Sky_ring_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local player p=GetOwningPlayer(u)
call myCustomDamage(u,c,2*(GetHeroAgi(u,true)+GetHeroStr(u,true)+GetHeroInt(u,true)),false,false,null,null,null)
call SetControlToUnit(u,c,1,"doom")
call SetControlToUnit(u,c,3,"silence")
call SlowUnit(u,c,0.5,0.,3,2,false)
call DestroyEffect(AddSpecialEffect("war3mapImported\\LW10.mdx",GetUnitX(c),GetUnitY(c)))
set u=null
set c=null
endfunction
