//call ForGroup(LoadGroupHandle(HH,id,4),function BlackGokuQPush)
set time1=time1+0.02
if time1==0.08 then
call EffectCreateAndMove(true,"BlackGoku\\sand.mdl",facing,1,1,GetRandomReal(1,1.5),100,100,100,0,-150,Dummy,100,facing-90)
call EffectCreateAndMove(true,"BlackGoku\\sand.mdl",facing,1,1,GetRandomReal(1,1.5),100,100,100,0,-150,Dummy,100,facing+90)
set time1=0
endif
call SaveReal(HH,id,6,time1)
endif
endif
set Dummy=null
set caster=null
endfunction


function BlackGokuChoice_Act takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit caster=GetTriggerUnit()
local real x0=GetUnitX(caster)
local real y0=GetUnitY(caster)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real facing=Angle2(x0,y0,x1,y1)
local boolean self=false
local boolean Wtarget=false
call SaveUnitHandle(HH,id,1,caster)
call SaveReal(HH,id,11,x1)
call SaveReal(HH,id,12,y1)
call SaveReal(HH,id,3,facing)



if GetSpellTargetUnit()!=null then
call SaveUnitHandle(HH,id,2,GetSpellTargetUnit())
endif

if GetSpellTargetUnit()==caster then
set self=true
endif

if GetSpellAbilityId()=='BGE2' then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call SaveReal(HH,id,15,(3+GetUnitAbilityLevel(caster,'BGE2'))*GetHeroAgi(caster,true))
call TimerStart(t,0.02,true,function BlackGokuE2Act)
endif

if GetSpellAbilityId()=='BGT1' then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)

call SaveReal(HH,id,15,(8+1.5*LoadInteger(HH,GetHandleId(caster),BGRageIHash))*GetHeroAgi(caster,true))
call TimerStart(t,0.02,true,function BlackGokuT1Act)
endif
if GetSpellAbilityId()=='BGQ2' then
call EffectCreateAndMove(true,"BlackGoku\\BlackBlink1.mdl",facing,1,1,1,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",facing,1,1,1,100,100,100,40,0,caster,0,facing)
if SR(x0,y0,x1,y1)<600 then
call MoveAoe1(x1,y1,caster,-600,facing)
endif
call EffectCreateAndMove(true,"BlackGoku\\HakenSaber2.mdl",facing,1,0.75,0.5,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\kaizokusfxbyvalk4.mdl",facing,1,1,1.5,100,100,100,30,0,caster,0,facing)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)

if LoadBoolean(HH,GetHandleId(caster),StringHash("BGF"))==true then
call SaveBoolean(HH,GetHandleId(caster),StringHash("BGF"),false)
call SaveReal(HH,id,15,3*GetHeroInt(caster,true)+(3+GetUnitAbilityLevel(caster,'BGQ2'))*GetHeroAgi(caster,true))
call TimerStart(t,0.02,true,function BlackGokuFGQAct)
else
call SaveReal(HH,id,15,(3+GetUnitAbilityLevel(caster,'BGQ2'))*GetHeroAgi(caster,true))
call TimerStart(t,0.02,true,function BlackGokuQGAct)
endif
endif



if GetSpellAbilityId()=='BGW4' then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call SaveReal(HH,id,15,4*GetHeroAgi(caster,true))
call TimerStart(t,0.02,true,function BlackGokuW4Act)
endif

if GetSpellAbilityId()=='BGQ1' then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call SaveReal(HH,id,15,25+(1+GetUnitAbilityLevel(caster,'BGQ1'))*GetHeroAgi(caster,true))
call TimerStart(t,0.02,true,function BlackGokuQAct)
if LoadBoolean(HH,GetHandleId(caster),StringHash("BGF"))==true then
call BlackGokuZamasuQAct(caster,x1,y1,3*GetHeroInt(caster,true))
endif
endif





if GetSpellAbilityId()=='BGW1' then
    call GroupClear(G)
    call GroupEnumUnitsInRange(G,x1,y1,300,Base)
    loop
        set n0=FirstOfGroup(G)
        exitwhen n0==null
        if IsUnitEnemy(n0,GetOwningPlayer(caster))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false and IsUnitInvulnerable(n0)==false then
            call SaveUnitHandle(HH,id,2,n0)
            set Wtarget=true
            call SaveReal(HH,id,15,(1+GetUnitAbilityLevel(caster,'BGW1'))*GetHeroAgi(caster,true))
            call GroupClear(G)
        endif
        call GroupRemoveUnit(G,n0)
    endloop
    call GroupClear(G)
    if Wtarget==false then
        call SaveReal(HH,id,5,-0.04)
        call TimerStart(t,0.02,true,function BlackGokuW1Act)
    elseif LoadBoolean(HH,GetHandleId(LoadUnitHandle(HH,id,2)),ANTITARGET_ABILITY)==false then
        call TimerStart(t,0.02,true,function BlackGokuW1Act)
    else
        call SetUnitAnimationByIndex(caster,64)
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\SoundJap\\BlackGokuW1.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        call EffectCreateAndMove(true,"BlackGoku\\BlackBlink1.mdl",facing,1,1,1,100,100,100,0,0,caster,0,facing)
        call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",facing,1,1,1,100,100,100,40,0,caster,0,facing)
        call MoveUnit(LoadUnitHandle(HH,id,2),caster,150,GetRandomReal(0,360))
        call EffectCreateAndMove(true,"BlackGoku\\HakenSaber2.mdl",facing,1,0.75,0.5,100,100,100,0,0,caster,0,facing)
        call EffectCreateAndMove(true,"BlackGoku\\az_fireringblue.mdl",facing,1,1.5,0.8,100,100,100,0,0,caster,0,facing)
        call EffectCreateAndMove(true,"BlackGoku\\kaizokusfxbyvalk4.mdl",facing,1,1,1.5,100,100,100,30,0,caster,0,facing)
        call SaveUnitHandle(HH,GetHandleId(LoadUnitHandle(HH,id,2)),REVERSE_TARGET,caster)
        call SetUnitPathing(caster,true)
        call PauseUnit(caster,false)
        call SetUnitInvulnerable(caster,false)
        call UnitSpeed(caster,1)
        call PauseUnit(LoadUnitHandle(HH,id,2),false)
        call SaveBoolean(HH,GetHandleId(LoadUnitHandle(HH,id,2)),TARGET_ABILITY,false)
        call PauseTimer(GetExpiredTimer())
        call FlushChildHashtable(HH,id)
        call DestroyTimer(GetExpiredTimer())
    endif
endif

if GetSpellAbilityId()=='BGW2' then
    call PauseUnit(caster,true)
    call SetUnitInvulnerable(caster,true)
    call SaveReal(HH,id,15,3*GetHeroAgi(caster,true))
    call SetUnitAnimationByIndex(caster,45)
    call TimerStart(t,0.02,true,function BlackGokuW2Act)
endif


if GetSpellAbilityId()=='BGW3' then
    call GroupClear(G)
    call GroupEnumUnitsInRange(G,x1,y1,300,Base)
    loop
        set n0=FirstOfGroup(G)
        exitwhen n0==null
        if IsUnitEnemy(n0,GetOwningPlayer(caster))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false and IsUnitInvulnerable(n0)==false then
            call SaveUnitHandle(HH,id,2,n0)
            set Wtarget=true
            call SaveReal(HH,id,15,(1+GetUnitAbilityLevel(caster,'BGW3'))*GetHeroAgi(caster,true))
            call GroupClear(G)
        endif
        call GroupRemoveUnit(G,n0)
    endloop
    call GroupClear(G)
    if Wtarget==false then
        call SaveReal(HH,id,5,-0.04)
        call TimerStart(t,0.02,true,function BlackGokuW3Act)
    elseif LoadBoolean(HH,GetHandleId(LoadUnitHandle(HH,id,2)),ANTITARGET_ABILITY)==false then
        call TimerStart(t,0.02,true,function BlackGokuW3Act)
    else
        call SetUnitAnimationByIndex(caster,64)
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\SoundJap\\BlackGokuW1.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        call EffectCreateAndMove(true,"BlackGoku\\BlackBlink1.mdl",facing,1,1,1,100,100,100,0,0,caster,0,facing)
        call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",facing,1,1,1,100,100,100,40,0,caster,0,facing)
        call MoveUnit(LoadUnitHandle(HH,id,2),caster,150,GetRandomReal(0,360))
        call EffectCreateAndMove(true,"BlackGoku\\HakenSaber2.mdl",facing,1,0.75,0.5,100,100,100,0,0,caster,0,facing)
        call EffectCreateAndMove(true,"BlackGoku\\az_fireringblue.mdl",facing,1,1.5,0.8,100,100,100,0,0,caster,0,facing)
        call EffectCreateAndMove(true,"BlackGoku\\kaizokusfxbyvalk4.mdl",facing,1,1,1.5,100,100,100,30,0,caster,0,facing)
        call SaveUnitHandle(HH,GetHandleId(LoadUnitHandle(HH,id,2)),REVERSE_TARGET,caster)
        call SetUnitPathing(caster,true)
        call PauseUnit(caster,false)
        call SetUnitInvulnerable(caster,false)
        call UnitSpeed(caster,1)
        call PauseUnit(LoadUnitHandle(HH,id,2),false)
        call SaveBoolean(HH,GetHandleId(LoadUnitHandle(HH,id,2)),TARGET_ABILITY,false)
        call PauseTimer(GetExpiredTimer())
        call FlushChildHashtable(HH,id)
        call DestroyTimer(GetExpiredTimer())
    endif
endif


if GetSpellAbilityId()=='BGE1' then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call SaveReal(HH,id,15,(1+GetUnitAbilityLevel(caster,'BGE1'))*GetHeroAgi(caster,true))
call TimerStart(t,0.02,true,function BlackGokuE1Act)
endif

if GetSpellAbilityId()=='BGR1' then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
if LoadBoolean(HH,GetHandleId(caster),StringHash("BGRose"))==true then
call SaveReal(HH,id,15,(2+GetUnitAbilityLevel(caster,'BGR1')))
else
call SaveReal(HH,id,15,(1+GetUnitAbilityLevel(caster,'BGR1')))
endif
call TimerStart(t,0.02,true,function BlackGokuRAct)
endif

if GetSpellAbilityId()=='BGR2' then
call SaveBoolean(HH,GetHandleId(caster),StringHash("BGR"),true)
call SaveReal(HH,GetHandleId(caster),StringHash("BGRA"),facing)
call TimerStart(t,0.02,true,function BlackGokuR2Act)
endif

if GetSpellAbilityId()=='BGF0' then
if GetRandomInt(1,2)==1 then
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then


set soundplay=CreateSound("Sound\\Music\\mp3Music\\SoundEng\\BlackGokuFeng.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)


else

set soundplay=CreateSound("Sound\\Music\\mp3Music\\SoundJap\\BlackGokuF.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)

