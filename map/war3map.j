function CastBenihiko takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local real x1=0
local real y1=0
local real x2=GetUnitX(u)
local real y2=GetUnitY(u)
local real r=0
local real f=GetUnitFacing(u)-90
local real a=Atan2(y-y2,x-x2)*bj_RADTODEG-90
local integer i=0
local group g=CreateGroup()
loop
exitwhen i>=30
set r=(a+6*i)*bj_DEGTORAD
set x1=x2+50*Cos(r)
set y1=y2+50*Sin(r)
set n=CreateUnit(p,'e0E2',x1,y1,r*bj_RADTODEG)
call GroupAddUnit(g,n)
set i=i+1
endloop
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
set soundplay=SndN(1359) // Sound\Music\mp3Music\Benihiko.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,1,g)
call TimerStart(t,0.5,false,function CastBenihiko2)
set g=null
set t=null
set p=null
set u=null
endfunction
