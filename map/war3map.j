function ExcaliburCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real a=LoadReal(h,id,11)
local real dist=LoadReal(h,id,2)
local real x=GetUnitX(l__d)+75*Cos(a)
local real y=GetUnitY(l__d)+75*Sin(a)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real dmg=LoadReal(h,id,4)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,12)
local real s1=LoadReal(h,id,10)
local real time=LoadReal(h,id,15)
if dist>0 and RectContainsUnit(GetWorldBounds(),l__d)and UnitIsAlive(l__d)then
call SetUnitXY_1(l__d,x,y, false)
call SetUnitScale(l__d,0.10+s1,0.10+s1,0.10+s1)
call SaveReal(h,id,10,s1+0.11)
set n=CreateUnit(p,'e0XZ',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,1.75)
call SetUnitTimeScale(n,1)
call SetUnitFlyHeight(n,85+s1*40,0)
call SetUnitScale(n,1+s1,1+s1,1+s1)
call SetUnitVertexColor(n,255,255,255,150)
set n=CreateUnit(p,'e0Y2',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,1.75)
call SetUnitTimeScale(n,1)
call SetUnitFlyHeight(n,85+s1*40,0)
call SetUnitScale(n,0.5+s1,0.5+s1,0.5+s1)
call SetUnitVertexColor(n,255,255,255,255)
call GroupEnumUnitsInRange(g,x,y,150+(4000-dist)*0.125,Base)
set idg=GetHandleId(g)
call SaveReal(h,id,2,dist-75)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
else
call UnitRemoveAbility(u,'A17E')
call SetUnitTimeScale(u,1)
call RemoveUnit(l__d)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call FlushChildHashtable(h,GetHandleId(g))
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
