function SaberNeroQCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real dmg=GetHeroAgi(u,true)*(1+GetUnitAbilityLevel(u,'A1C9'))+50+25*GetUnitAbilityLevel(u,'A1C9')
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=LoadReal(h,id,3)
local real dist=LoadReal(h,id,2)
local integer i=0
local boolean b=LoadBoolean(h,id,1)
local real sc
local player p=GetOwningPlayer(u)
if dist<1250 and b==false then
set x=x+50*Cos(a)
set y=y+50*Sin(a)
call SetUnitXY_1(u,x,y, false)
call SaveReal(h,id,2,dist+40)
set n=CreateUnit(p,'e11T',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,75)
call UnitApplyTimedLife(n,'BTLF',0.15)
set n=CreateUnit(p,'e117',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,GetRandomInt(10,45))
set sc=GetRandomReal(0.55,1.25)
call SetUnitScale(n,sc,sc,sc)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
call GroupEnumUnitsInRange(G,x,y,100,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E) and IsUnitInvulnerable(E)==false then
    if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
        if GetWidgetLife(E)>0 then
            call SaveUnitHandle(h,id,4,E)
            call SaveBoolean(h,id,1,true)
            call SaveReal(h,id,2,0)
            call SetUnitAnimation(u,"Spell Four")
            set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG-30)
            call SetUnitVertexColor(n,255,255,255,155)
            call UnitApplyTimedLife(n,'BTLF',0.4)
            call SetUnitTimeScale(n,3)
            set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+30)
            call SetUnitVertexColor(n,255,255,255,155)
            call UnitApplyTimedLife(n,'BTLF',0.4)
            call SetUnitTimeScale(n,3)
            set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG)
            call SetUnitVertexColor(n,255,255,255,155)
            call UnitApplyTimedLife(n,'BTLF',0.4)
            call SetUnitTimeScale(n,2)
            set n=CreateUnit(p,'e0RV',x,y,a*bj_RADTODEG)
            call UnitApplyTimedLife(n,'BTLF',3.5)
            call SetUnitTimeScale(n,0.4)
            call SetUnitTimeScale(u,1.5)
            call SetUnitInvulnerable(u,true)
            call PauseUnit(u,true)
            call PauseTimer(t)
            call TimerStart(t,0.45,true,function SaberNeroQCast3)
        endif
    else
        call PauseUnit(u,false)
        call SetUnitInvulnerable(u,false)
        call PauseUnit(E,false)
        call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,false)
        call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,u)
        call SetUnitTurnSpeed(u,1.00)
        call SetUnitTimeScale(u,1)
        call PauseTimer(t)
        call DestroyTimer(t)
        call SetUnitVertexColor(u,255,255,255,255)
        call FlushChildHashtable(h,id)
    endif
    call GroupClear(G)
endif
call GroupRemoveUnit(G,E)
endloop
else
call SetUnitTimeScale(u,1)
call PauseUnit(u,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set d=null
set u=null
set p=null
set t=null
endfunction
function SaberNeroQCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local integer i=1
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,0)
call SaveReal(h,id,3,a)
call SaveBoolean(h,id,1,false)
call PauseUnit(u,true)
call SetUnitAnimation(u,"Spell Two")
call SetUnitTimeScale(u,2.5)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+45)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG-45)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
if GetUnitTypeId(u)=='H26B' then
set soundplay=SndN(2639) // Sound\Music\mp3Music\NeroBrideQ.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
elseif GetUnitTypeId(u)=='H16B' then
set soundplay=SndN(2641) // Sound\Music\mp3Music\NeroSaber1Q.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
set soundplay=SndN(2643) // Sound\Music\mp3Music\NeroSaberQ.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call TimerStart(t,0.01,true,function SaberNeroQCast2)
set u=null
set p=null
set t=null
endfunction
function InitTrig_SaberNeroQ takes nothing returns nothing
set gg_trg_SaberNeroQ=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_SaberNeroQ,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_SaberNeroQ,Condition(function SaberNeroQCond))
call TriggerAddAction(gg_trg_SaberNeroQ,function SaberNeroQCast)
endfunction
function SaberNeroWCond takes nothing returns boolean
return GetSpellAbilityId()=='A1CA'
endfunction
function SaberPushHeight2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real dist=LoadReal(h,id,2)
local real speed=LoadReal(h,id,1)
local real a=LoadReal(h,id,3)
if dist>0 then
call SetUnitFlyHeight(u,GetUnitFlyHeight(u)+speed,0)
call SaveReal(h,id,2,dist-speed)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set t=null
endfunction
function SaberPushHeight takes unit u,real time,real dist,real a returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,(dist/time)*0.02)
call SaveReal(h,id,2,dist)
call SaveReal(h,id,3,a)
call TimerStart(t,0.02,true,function SaberPushHeight2)
set t=null
endfunction
function SaberPush2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real dist=LoadReal(h,id,2)
