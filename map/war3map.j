function ArcueidRCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit l__d=LoadUnitHandle(h,id,4)
local force f=LoadForceHandle(h,id,17)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real dmg=GetHeroInt(u,true)*(4+GetUnitAbilityLevel(u,'A1FO'))
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real a=Atan2(y1-y,x1-x)
local real dist=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
local player pc=GetOwningPlayer(c)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call SetUnitInvulnerable(c,false)
call UnitRemoveAbility(c,'A3IH')
call UnitRemoveAbility(c,'A0QL')
if IsUnitIllusion(c)==false and IsUnitType(c, UNIT_TYPE_HERO)==true then
if GetLocalPlayer()==pc then
call CameraSetupApplyForceDuration(gg_cam_Gamecam,false,0)
call SetCameraPosition(GetUnitX(c),GetUnitY(c))
endif
set archR=false
endif
call SetUnitZ(c,0)
call ResetUnitZ(c)
call RemoveUnit(l__d)
if(IsPlayerInForce(GetLocalPlayer(),f))then
call EnableUserControl(true)
endif
call DestroyForce(f)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call myCustomDamage(u,c,dmg,false,false,null,null,null)
call SetUnitTargetable(c,true)
set f=null
set c=null
set pc=null
set l__d=null
set u=null
set p=null
set t=null
endfunction
