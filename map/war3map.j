function JujmentChainCast takes nothing returns nothing
        local unit u=GetTriggerUnit()
        local timer t=CreateTimer()
        local integer id=GetHandleId(t)
        local player p=GetOwningPlayer(u)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        set Kurapika=u
        set n=LoadUnitHandle(h,GetHandleId(u),TargetHash)
        call SaveUnitHandle(h,id,0,n)
        call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",n,"chest"))
        call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",n,"chest"))
        if GetUnitTypeId(u)=='H04O' then
                call UnitAddAbility(n,'A0YY')
                set soundplay=SndN(2154) // Sound\Music\mp3Music\JujumentChain.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        else
                call UnitAddAbility(n,'A1AC')
                set soundplay=SndN(2156) // Sound\Music\mp3Music\ArcueidUlt.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        endif
        call TimerStart(t,6,false,function JujmentChainCast2)
        set u=null
        set t=null
        set p=null
endfunction
function EnchantedFistCond takes nothing returns boolean
return GetSpellAbilityId()=='A0YQ'
endfunction
function EnchantedFistCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real dmg=0
local integer idd=0
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>50 and GetWidgetLife(c)>0 then
set x=x+60*Cos(a)
set y=y+60*Sin(a)
call SetUnitXY_1(u,x,y,false)
if GetUnitTypeId(u)=='H04O' then
set idd='e0UV'
else
set idd='e10C'
endif
call SetUnitFacing(u,a*bj_RADTODEG)
set n=CreateUnit(p,idd,x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.25)
call SetUnitVertexColor(n,170,170,170,255)
call SetUnitTimeScale(n,2)
call SetUnitAnimation(n,"attack")
call SetUnitAnimation(u,"attack")
else
call Push(c,50,LoadReal(h,id,9),300)
if GetUnitTypeId(u)=='H04O' then
call UnitApplyTimedLife(CreateUnit(p,'e0SA',x1,y1,a*bj_RADTODEG),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0SB',x1,y1,a*bj_RADTODEG),'BTLF',2)
set n=CreateUnit(p,'e0SC',x1,y1,a*bj_RADTODEG)
call SetUnitAnimation(n,"death")
call UnitApplyTimedLife(n,'BTLF',1)
set n=CreateUnit(p,'e0SD',x1,y1,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,2)
call UnitApplyTimedLife(CreateUnit(p,'e0SE',x1,y1,a*bj_RADTODEG),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0SF',x1,y1,a*bj_RADTODEG),'BTLF',2)
else
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03D',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03D',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03D',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e06F',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e06F',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e06F',x1,y1,GetRandomReal(0,359)),'BTLF',1)
endif









//kurapikaQ Buff
if GetUnitAbilityLevel(u,'A1A6')>0 or GetUnitAbilityLevel(u,'A1AD')>0 then//ловкость

set dmg=((2+GetUnitAbilityLevel(u,'A0YQ'))*GetHeroAgi(u,true))
elseif GetUnitAbilityLevel(u,'A1A7')>0 or GetUnitAbilityLevel(u,'A1AF')>0 then//инта

call UnitAddAbility(c,'AKKQ')
call UnitRemoveAbility(c,'AKKQ')

set dmg=((2+GetUnitAbilityLevel(u,'A0YQ'))*GetHeroInt(u,true))
elseif GetUnitAbilityLevel(u,'A1A8')>0 or GetUnitAbilityLevel(u,'A1AE')>0 then//сила

set dmg=((4+GetUnitAbilityLevel(u,'A0YQ'))*GetHeroStr(u,true))
endif
//KurapikaQ buff end



if GetUnitAbilityLevel(c,'A0ZF')==0 and GetUnitAbilityLevel(c,'KkR3')==0 then
call myCustomDamage(u,c,dmg,false,false,null,null,null)
else
call myCustomDamage(u,c,dmg*1.5,false,false,null,null,null)
endif

if GetUnitAbilityLevel(u,'A1A6')>0 or GetUnitAbilityLevel(u,'A1AD')>0 then
call SetControlToUnit(u,c,2.5, "stun")
else
call SetControlToUnit(u,c,1, "stun")
endif


call PauseTimer(t)
call DestroyTimer(t)
call UnitRemoveAbility(u,'A0BX')
call SetUnitTimeScale(u,1)
call SetUnitPathing(u,true)
call PauseUnit(u,false)
call FlushChildHashtable(h,id)
call SetUnitInvulnerable(u,false)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function EnchantedFistCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
call SaveUnitHandle(h,id,0,u)
call SetUnitPathing(u,false)
call SetUnitAnimation(u,"spell two")
call UnitAddAbility(u,'A0BX')
call PauseUnit(u,true)
if GetUnitTypeId(u)=='H04O' then
set soundplay=SndN(2158) // Sound\Music\mp3Music\EnchantedFist.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
set soundplay=SndN(2160) // Sound\Music\mp3Music\ArcueidQ.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call SaveReal(h,id,9,Atan2(GetUnitY(c)-y,GetUnitX(c)-x))
call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e06H',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e06I',x,y,GetRandomReal(0,359)),'BTLF',1)
call SetUnitTimeScale(u,5)
call SetUnitInvulnerable(u,true)
call SaveUnitHandle(h,id,1,c)
call TimerStart(t,0.025,true,function EnchantedFistCast2)
set c=null
set u=null
set t=null
endfunction
function Condition_Base_Random takes unit caster000,unit target000 returns boolean
return UnitIsAlive(target000)and IsUnitEnemy(target000,GetOwningPlayer(caster000))==true and IsUnitType(target000,UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(target000,'Avul')==0
endfunction
