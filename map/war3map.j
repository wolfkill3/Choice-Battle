function InitTrig_GaeDeargInt takes nothing returns nothing
    local trigger trig= CreateTrigger()
    local integer index= 0
    loop
        call TriggerRegisterPlayerUnitEvent(trig, Player(index), EVENT_PLAYER_UNIT_SPELL_EFFECT, null)
        set index=index + 1
        exitwhen index == bj_MAX_PLAYER_SLOTS
    endloop
    call TriggerAddCondition(trig,Condition(function Trig_Gaedearg_Conditions))
    call TriggerAddAction(trig, function Trig_Gaedearg_Actions)
        set trig=null
endfunction
//=========================================== Medusa Dr.Stone

function DrStone_Periodic takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local real time=LoadReal(HH,id,1)
if LoadBoolean(HH,GetHandleId(u),TARGET_ABILITY)==false or time==2 then
    call SaveReal(HH,id,1,time+0.05)
endif
if time<2 then
    call SetWidgetLife(u, LoadReal(HH,id,StringHash("HP")))
    call PauseUnit(u, true)
    call SetUnitInvulnerable(u, true)
    call SetUnitXY_1(LoadUnitHandle(HH, id, 99), GetUnitX(u), GetUnitY(u), false)
endif
if time==2 then
    set n=CreateUnit(GetOwningPlayer(u), 'dA02', GetUnitX(u), GetUnitY(u), GetRandomInt(0, 360))
    call MyRemoveUnit(n, 1.8)
    set n=CreateUnit(GetOwningPlayer(u), 'dA03', GetUnitX(u), GetUnitY(u), GetRandomInt(0, 360))
    call SetUnitVertexColor(n, 100, 100, 100, 255)
    call MyRemoveUnit(n, 1.8)
    call UnitRemoveAbility(u,'IMDc')
    call PauseUnit(u, false)
    call SetUnitInvulnerable(u, false)
    call UnitRemoveBuffs(u,false,true)
    call SetUnitVertexColor(u, 255, 255, 255, 255)
    call SetUnitTimeScale(u, 1)
    call HealTextTag(u,u,GetWidgetMaxLife(u)*0.15*myCustomHeal2(u,1),"HealthRes")
    call SetWidgetLife(u, LoadReal(HH,id,StringHash("HP"))+GetWidgetMaxLife(u)*0.15)
endif
if time>2 then
    if GetUnitAbilityLevel(u, 'B05G')>0 and u!=null then
        call UnitRemoveBuffs(u,false,true)
        call UnitRemoveAbility(u,'A15H')
        call UnitRemoveAbility(u,'B039')
        call UnitRemoveAbility(u,'CE04')
        call UnitRemoveAbility(u,'IMDc')
        call UnitRemoveAbility(u,'CB03')
        call UnitRemoveAbility(u, 'IHYs')
        call UnitRemoveAbility(u, 'IOb3')
        call UnitRemoveAbility(u, 'B05G')
        call UnitRemoveAbility(u, 'B05H')
        call UnitRemoveAbility(u, 'A2VJ')
        call UnitRemoveAbility(u, 'AoSV')
        call UnitRemoveAbility(u, 'A1SV')
    else
        call UnitRemoveBuffs(u,false,true)
        call UnitRemoveAbility(u,'A15H')
        call UnitRemoveAbility(u,'B039')
        call UnitRemoveAbility(u,'CE04')
        call UnitRemoveAbility(u,'IMDc')
        call UnitRemoveAbility(u,'CB03')
        call UnitRemoveAbility(u, 'IHYs')
        call UnitRemoveAbility(u, 'IOb3')
        call UnitRemoveAbility(u, 'B05G')
        call UnitRemoveAbility(u, 'B05H')
        call UnitRemoveAbility(u, 'A2VJ')
        call UnitRemoveAbility(u, 'AoSV')
        call UnitRemoveAbility(u, 'A1SV')
        call PauseTimer(t)
        call FlushChildHashtable(HH,id)
    endif
endif
set u=null
set t=null
endfunction

function DrStone_Cast takes unit u returns nothing
    local timer t=CreateTimer()
    local player p=GetOwningPlayer(u)
    local integer id=GetHandleId(t)
    local integer i=0
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    call SaveUnitHandle(HH,id,0,u)
    call SaveReal(HH,id,StringHash("HP"),GetWidgetLife(u))
    call SaveReal(HH,id,1,0)
    call UnitAddAbility(u,'A15H')
    call UnitRemoveBuffs(u,false,true)
    call UnitRemoveAbility(u, 'cbc3')
    call UnitRemoveAbility(u, 'cbc7')
    call UnitRemoveAbility(u, 'CBC2')
    call UnitRemoveAbility(u, 'CBC1')
    call UnitRemoveAbility(u, 'Bslo')
    call UnitRemoveAbility(u, 'Bsl1')
    call UnitRemoveAbility(u, 'WAE1')
    call UnitRemoveAbility(u, 'Ao53')
    call UnitRemoveAbility(u, 'A00D')
    call UnitRemoveAbility(u, 'Ao2Z')
    call UnitRemoveAbility(u, 'A1VJ')
    call UnitRemoveAbility(u, 'A0J4')
    call UnitRemoveAbility(u, 'IHYs')
    call UnitRemoveAbility(u, 'IOb3')
    call UnitRemoveAbility(u, 'A2VJ')
    call UnitRemoveAbility(u, 'AoSV')
    call UnitRemoveAbility(u, 'A1SV')
    call UnitRemoveAbility(u,'A128')
    call UnitRemoveAbility(u,'A15F')
    call DestroyEffect(AddSpecialEffect("war3mapImported\\BlinkCaster.mdx",x,y))
    call RemoveEffect(AddSpecialEffectTarget("war3mapImported\\GlowGreen.mdl",u,"chest"), 1.5, true, CreateTimer())
    call RemoveEffect(AddSpecialEffectTarget("war3mapImported\\az_jugggreen_e2_impact.mdl",u,"hand right"), 1.5, true, CreateTimer())
    call RemoveEffect(AddSpecialEffectTarget("war3mapImported\\az_jugggreen_e2_impact.mdl",u,"hand left"), 1.5, true, CreateTimer())
    set n=CreateUnit(GetOwningPlayer(u), 'dA04', GetUnitX(u), GetUnitY(u), GetRandomInt(0, 360))
    call SetUnitTimeScale(n, 0.6)
    call MyRemoveUnit(n, 1.8)
    set n=CreateUnit(GetOwningPlayer(u), 'dA06', GetUnitX(u), GetUnitY(u), GetRandomInt(0, 360))
    call SetUnitScale(n, 3, 3, 3)
    call UnitApplyTimedLife(n, 1, 2)
    call SaveUnitHandle(HH, id, 99, n)
    call MyRemoveUnit(n, 2.8)
    call UnitRemoveAbility(u,'A224')
    call UnitAddAbility(u,'CE04')
    call UnitAddAbility(u,'IMDc')
    call PauseUnit(u, true)
    call SetUnitInvulnerable(u, true)
    call SetUnitVertexColor(u, 100, 100, 100, 255)
    call SetUnitTimeScale(u, 0.0)
    set n=CreateUnit(GetOwningPlayer(u), 'dAlb', GetUnitX(u), GetUnitY(u), 0)
    call UnitAddAbility(n, 'MDs2')
    call IssueTargetOrder(n, "antimagicshell", u)
    call MyRemoveUnit(n, 1.5)
    call TimerStart(t,0.05,true,function DrStone_Periodic)
    set u=null
    set t=null
    set p=null
endfunction

function InitTrig_DrStoneInt_Action takes nothing returns nothing
        if GetSpellAbilityId() == 'IMDs' then
        call DrStone_Cast(GetSpellAbilityUnit())
    endif
endfunction

function DrStoneESC_Cond takes nothing returns boolean
return udg_B
endfunction

function DrStoneESC takes nothing returns nothing
local integer i=GetPlayerId(GetTriggerPlayer())
local integer ind=0
local integer lp=0
if GetTriggerPlayerKey()==OSKEY_OEM_3 then
    if GetTriggerPlayer()==GetLocalPlayer()then
        call ClearSelection()
        call SelectUnit(Hero[i],true)
        call PanCameraToTimed(GetUnitX(Hero[i]),GetUnitY(Hero[i]),0)
    endif
endif
if UnitHasItemOfTypeBJ(Hero[GetPlayerId(GetTriggerPlayer())],'IMDi') and IsUnitPaused(Hero[GetPlayerId(GetTriggerPlayer())])==false and RectContainsUnit(gg_rct_AntiMh,Hero[GetPlayerId(GetTriggerPlayer())])==false and GetUnitAbilityLevel(Hero[GetPlayerId(GetTriggerPlayer())],'Pet1')==0 and GetUnitAbilityLevel(Hero[GetPlayerId(GetTriggerPlayer())],'cbc8')==0 then
    loop
    exitwhen lp==6
        if GetItemTypeId(UnitItemInSlot(Hero[i],lp))=='IMDi' then
            set ind=lp
        endif
        set lp=lp+1
    endloop
    if IsAbilityOnCooldown(GetUnitAbility(Hero[i],'IMDs'))==false and IsUnitPaused(Hero[i])==false and (GetUnitAbilityLevel(Hero[i],'A3BJ')>0 or GetTriggerPlayerKey()==OSKEY_OEM_3 )then
        call UnitRemoveBuffs(Hero[i],false,true)
        call UnitRemoveAbility(Hero[i], 'cbc3')
        call UnitRemoveAbility(Hero[i], 'cbc7')
        call UnitRemoveAbility(Hero[i], 'CBC2')
        call UnitRemoveAbility(Hero[i], 'Bslo')
        call UnitRemoveAbility(Hero[i], 'Bsl1')
        call UnitRemoveAbility(Hero[i], 'WAE1')
        call UnitRemoveAbility(Hero[i], 'Ao53')
        call UnitRemoveAbility(Hero[i], 'A00D')
        call UnitRemoveAbility(Hero[i], 'Ao2Z')
        call UnitRemoveAbility(Hero[i], 'A1VJ')
        call UnitRemoveAbility(Hero[i], 'A3BJ')
        call SetUnitMoveSpeed(Hero[i], GetUnitDefaultMoveSpeed(Hero[i]))
        call UnitUseItem(Hero[i],UnitItemInSlot(Hero[i],ind))
    elseif IsAbilityOnCooldown(GetUnitAbility(Hero[i],'A12B'))==false and IsUnitPaused(Hero[i])==false and GetUnitAbilityLevel(Hero[i],'A3BJ')==0 then
        call UnitAddAbility(Hero[i],'A3BJ')
        call UnitRemoveAbilityTimed(Hero[i],'A3BJ',0.4)
    endif
endif
endfunction

function InitTrig_DrStoneInt takes nothing returns nothing
    local trigger trig= CreateTrigger()
    local integer index= 0
    loop
        call TriggerRegisterPlayerUnitEvent(trig, Player(index), EVENT_PLAYER_UNIT_SPELL_EFFECT, null)
        set index=index + 1
        exitwhen index == bj_MAX_PLAYER_SLOTS
    endloop
    call TriggerAddAction(trig, function InitTrig_DrStoneInt_Action)
        set trig=null
        
        set trig=CreateTrigger()
        set index=0
        loop
        exitwhen index==10
            call TriggerRegisterPlayerKeyEvent( trig, Player(index), OSKEY_OEM_3, 0 ,true )
            call TriggerRegisterPlayerKeyEvent( trig, Player(index), OSKEY_ESCAPE, 0 ,true )
            set index=index+1
        endloop
        call TriggerAddCondition(trig,Condition(function DrStoneESC_Cond))
        call TriggerAddAction(trig,function DrStoneESC)
        set trig=null
endfunction
