call SaveLightningHandle(h,id,4,AddLightningEx("MFPB",true,GetLocationX(GetUnitLoc(c)), GetLocationY(GetUnitLoc(c)), GetLocationZ(GetUnitLoc(c)), GetLocationX(GetUnitLoc(n)), GetLocationY(GetUnitLoc(n)), GetLocationZ(GetUnitLoc(n))))
call TimerStart(t,0.02,true,function ByakuranGhost1)
