call UnitApplyTimedLife(n,1,1)
call SetUnitTimeScale(n,2)
if GetUnitTypeId(u)!='H03R' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\SaberSakura5.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\YomuT.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
call TimerStart(t,.03,true,function IllusionBenizkuraStrikeCast2)
set u=null
set t=null
set c=null
set p=null
