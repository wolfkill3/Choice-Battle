                call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+nb*0.16)

                set nb=nb*0.84
            elseif UnitHasItemOfTypeBJ(u,'I010')and nb>0 then

                call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+nb*0.19)

                set nb=nb*0.81
            elseif UnitHasItemOfTypeBJ(u,'I011')and nb>0 then

                call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+nb*0.22)

                set nb=nb*0.78
            elseif UnitHasItemOfTypeBJ(u,'I012')and nb>0 then

            call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+nb*0.25)

            set nb=nb*0.75
        endif
        // if GetUnitAbilityLevel(u,'ReFP')>=1 and nb>0 then //Ренгоку стандартный резист 15% от F
            // call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+nb*0.15)
            // set nb=nb*0.85
        // endif
                // if LoadBoolean(h, uid, RengokuF_Pass)==true and nb>0 then //Ренгоку резист 40% от реса F
            // call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+nb*0.4)
            // set nb=nb*0.6
        // endif
                
        if GetUnitAbilityLevel(u,'AlEp')>=1 and nb>0 then
            call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+nb*(0.075+GetUnitAbilityLevel(u,'AlEp')*0.025))

            set nb=nb*(0.925-GetUnitAbilityLevel(u,'AlEp')*0.025)
        endif
        if LoadInteger(HH,uid,StringHash("AlbedoF_Mod"))==3 then
            call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+nb*0.15)
            set nb=nb*0.85
                elseif GetUnitTypeId(u)!='HAlb' then
                        call RemoveSavedInteger(HH,uid,StringHash("AlbedoF_Mod"))
        endif
                
                if (UnitHasItemOfTypeBJ(u,'ISTi') or GetUnitAbilityLevel(u, 'KI0S')>0 ) and nb>0 then // Stigmata Resist
            call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+nb*0.1)

            set nb=nb*0.9
        endif
                
                if nb>0 and GetUnitAbilityLevel(c, 'AP06')>0 and GetUnitAbilityLevel(u, 'A1HW')>0 then          // Enkidu Q Resist
            call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+nb*0.35)
            set nb=nb*0.65
        endif
                if GetUnitAbilityLevel(u,'A2A1')>0 and nb>0 then 
            call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+nb*0.3)
            set nb=nb*0.7
        endif
        if (UnitHasItemOfTypeBJ(u,'I065') or GetUnitAbilityLevel(u, 'KIX2')>0 ) and nb>ll*0.05 then
            set cjlocgn_00000000=CreateTimer()
            call SetHeroStr(u,GetHeroStr(u,false)+R2I(5*(nb/(ll*0.05))),true)
            call SaveUnitHandle(h,GetHandleId(cjlocgn_00000000),0,u)
            call SaveInteger(h,GetHandleId(cjlocgn_00000000),1,R2I(5*(nb/(ll*0.05))))
            call TimerStart(cjlocgn_00000000,10,false,function CloudMare)
            set cjlocgn_00000000=null
        endif
        if GetUnitAbilityLevel(u,'A12J')>0 then
            set ide=GetHandleId(u)
            call SaveReal(h,ide,StringHash("dmg2"),LoadReal(h,ide,StringHash("dmg2"))+b)
        endif
        if GetUnitTypeId(u)=='H066' and nb>0 then
            set doffyh[idu]=0
        endif
        if(CurrentEventAttack)and GetUnitAbilityLevel(c,'A1CY')>0 and GetUnitAbilityLevel(c,'A00D')==0 and GetUnitAbilityLevel(c,'A1D1')==0 then
        endif
    endif
    if(UnitHasItemOfTypeBJ(u,'I13R')and nb>500) and CurrentEventAttack==false and GetUnitAbilityLevel(u,'BorB')>0 and IsUnitType(u,UNIT_TYPE_SUMMONED)==false and u==Hero[idu] then
        set cjlocgn_00000000=CreateTimer()
        set t=CreateTimer()
        call SaveUnitHandle(h,GetHandleId(cjlocgn_00000000),0,u)
        set bj_lastCreatedItem=GetItemOfTypeFromUnitBJ(u,'I13R')
        call UnitRemoveItem(u,bj_lastCreatedItem)
        call RemoveItem(bj_lastCreatedItem)
        call UnitAddAbility(u,'A0VV')
        call UnitRemoveAbilityTimedPause(u,'A0VV',4)
        call UnitAddAbility(u,'A28W')
        call UnitRemoveAbilityTimedPause(u,'A28W',4)
        call UnitRemoveBuffs(u,false,true)
        call UnitRemoveAbility(u,'A0J4')
        set bj_lastCreatedItem=UnitAddItemById(u,'I13S')
        call SetItemDroppable(bj_lastCreatedItem,false)
        call SaveItemHandle(h,GetHandleId(cjlocgn_00000000),1,bj_lastCreatedItem)
        call TimerStart(cjlocgn_00000000,0.1,true,function LinkenSphere2)
        call SaveReal(h,GetHandleId(cjlocgn_00000000),2,30)
        call SaveInteger(h,GetHandleId(cjlocgn_00000000),3,idu)
        call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\EMPBubble2.mdx",u,"chest"))
        call DestroyEffect(AddSpecialEffectTarget("GhostLighthin3.mdl",u,"chest"))
        call SetUnitInvulnerable(u,true)
        call UnitRemoveAbility(u,'B14S')
        call UnitRemoveAbility(u,'B14R')
        call SaveUnitHandle(h,GetHandleId(t),33,u)
        call TimerStart(t,0.02,false,function Linken_Block)
        set nb=0
        set t=null
        set cjlocgn_00000000=null
    endif
    if (UnitHasItemOfTypeBJ(c,'I02V') or GetUnitAbilityLevel(c,'KIG4')>0) and nb>0 and GetUnitAbilityLevel(c,'A3WR')==0 and CurrentEventAttack and IsUnitType(c, UNIT_TYPE_HERO) and IsUnitIllusion(c)==false then
        call Essence(c,u,1)
    endif
    if critcoef>1 and GetUnitAbilityLevel(c,'A3WR')==0 then
        call UnitAddAbility(c,'A3WR')
        call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",u,"chest"))
        call myCustomDamage(c,u,nb*(critcoef-1),false,false,ATTACK_TYPE_HERO,DAMAGE_TYPE_UNIVERSAL,null)
        call UnitRemoveAbility(c,'A3WR')
    endif
    if(CurrentEventAttack)and nb>0 and GetUnitAbilityLevel(c,'A17K')>0 and GetUnitAbilityLevel(c,'A3WR')==0 then
        call UnitAddAbility(c,'A3WR')
        call myCustomDamage(c,u,GetHeroAgi(c,true)*2 + GetUnitTotalDamage(c)*0.6,false,false,null,null,null)
        call UnitRemoveAbility(c,'A17K')
        call SetControlToUnit(u,u, 1, "stun")
        call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\jiejinmao.mdx",c,"Right Hand"))
        call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",u,"origin"))
        call SetUnitAttackRangeByIndex(c,0, 600)
        call UnitRemoveAbility(c,'A3WR')
    endif
    if CurrentEventAttack and nb>0 and GetUnitAbilityLevel(c,'A160')>0 and c!=UltimateDamage and GetHeroLevel(c)>=6 and GetRandomReal(0,100)<30 then
        set n=CreateUnit(GetOwningPlayer(c),'e0F0',x1,y1,a*bj_RADTODEG)
        call SetUnitScale(n,0.5,0.5,0.5)
        call SetUnitFlyHeight(n,180,0)
        call Slash_Dante(n,100,GetHeroAgi(c,true),a,1000,75,x1,y1,0,0,true)
    endif
    if CurrentEventAttack and nb>0 and GetUnitAbilityLevel(c,'A3WR')==0 and GetUnitAbilityLevel(c,'B05R')>0 and c!=UltimateDamage then
        set FI=LoadInteger(HH,cid,StringHash("SA"))
        if FI>=1 then
            call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BlackBlink.mdx",c,"origin"))
            call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\DarkRibbon.mdx",c,"origin"))
            call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",u,"head"))
            call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",u,"chest"))
            call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",u,"origin"))
            call SaveInteger(HH,cid,StringHash("SA"),FI-1)
            call MissUnit(c,u,3,0.2,false)
            else
            call UnitRemoveAbility(c,'B05R')
        endif
    endif
    if (UnitHasItemOfTypeBJ(c,'I03N') or GetUnitAbilityLevel(c,'KIJ6')>0) and (GetUnitTypeId(c)!='H059' and GetUnitTypeId(c)!='H06S' and GetUnitTypeId(c)!='H070') and(c==Hero[idc]or GetUnitAbilityLevel(c,'A14Y')>0)and nb>0 and CurrentEventAttack and udg_B==true and DU2==true then
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Feedback\\ArcaneTowerAttack.mdl",u,"origin"))
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl",u,"chest"))
        if GetUnitState(u,UNIT_STATE_MANA)>0 then
            call HealTextTag(c,c,GetUnitState(c,UNIT_STATE_LIFE)+GetUnitState(u,UNIT_STATE_MANA)*.12*myCustomHeal2(c,1),"HealthRes")
            call SetUnitState(c,UNIT_STATE_LIFE,GetUnitState(c,UNIT_STATE_LIFE)+GetUnitState(u,UNIT_STATE_MANA)*.12)
        endif
        call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MANA)*0.08)
    endif
    if GetUnitAbilityLevel(c,'A14C')>0 and LoadInteger(HH,cid,StringHash("SaberPassive")) == 1 and c!=UltimateDamage and nb>0 then
        //call SetUnitOwner(UltimateDamage,Player(idc),false)
        //set lkp=idc
        call SaveInteger(HH,cid,StringHash("SaberPassive"),0)
        call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\mihawkslashhit.mdx",u,"chest"))
        //call SetUnitOwner(UltimateDamage,Player(PLAYER_NEUTRAL_PASSIVE),false)
        call UnitAddAbility(c,'A00D')
        //set nb=nb+GetHeroStr(c,true)*0.5*myCustomDamage2(u,1)
    endif
    if (UnitHasItemOfTypeBJ(c,'I050')==true or GetUnitAbilityLevel(c,'KIQ0')>0) and GetUnitAbilityLevel(c,'GEP1')==0 and IsUnitIllusion(c) == false and nb>0 and (CurrentEventAttack)and GetRandomIntMem(0,100)<=20 and udg_B==true and DU2==true then //Gegetsu
        call UnitAddAbility(c,'GEP1')
        call UnitRemoveAbilityTimed(c,'GEP1',1)
        call SetControlToUnit(c,u, 1,"stun") //"stunbkb"
        call SetControlToUnit(c,u, 0.2,"stunbkb") //"stunbkb"
        call DestroyEffect(AddSpecialEffect("war3mapImported\\Cleave.mdx",GetUnitX(u),GetUnitFlyHeight(u)))
    endif
    if GetUnitAbilityLevel(c,'A0OP')>0 and nb>0 then
        call myCustomDamage(Hero[idc],u,GetHeroInt(Hero[idc],true)*GetUnitAbilityLevel(Hero[idc],'A0OQ')*0.05,false,false,null,null,null)
        call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\GyroCopter\\GyroCopterMissile.mdl",x,y))
    endif
    if GetUnitTypeId(c)=='h002' and nb>0 and GetUnitAbilityLevel(Hero[idc],'A3WR')==0 then
        call PoisonDamage(Hero[idc],u,7*(25+GetUnitAbilityLevel(Hero[idc],'A0AS')*15),14,"Abilities\\Weapons\\PoisonSting\\PoisonStingTarget.mdl")
        call SlowUnit(Hero[idc],u,0.08,0.08,7,2,false)
    endif
    if GetUnitTypeId(c)=='h004' and nb>0 and GetUnitAbilityLevel(Hero[idc],'A3WR')==0 then
        call SlowUnit(Hero[idc],u,0.1,0.1,7,4,false)
    endif
    if CurrentEventAttack and nb>0 and GetUnitAbilityLevel(c,'A0UT')>0 and GetRandomIntMem(0,100)<=17 and GetHeroLevel(c)>5 then
        
        call myCustomDamage(c,u,GetHeroAgi(c,true)*2,false,false,null,null,null)
        call SetControlToUnit(c,u, 0.2, "stun")
        set i=0
        loop
        exitwhen i>=3
        set n=CreateUnit(GetOwningPlayer(c),'e016',x,y,GetRandomReal(0,359))
        call UnitAddAbility(n,'Arav')
        call SetUnitTimeScale(n,3)
        call UnitApplyTimedLife(n,1,0.1)
        set i=i+1
        endloop
        set nb=nb+2*GetHeroAgi(c,true)*myCustomDamage2(u,1)
    endif
    if CurrentEventAttack and nb>0 and GetUnitAbilityLevel(c,'A0VB')>0 and GetRandomIntMem(0,100)<=15+GetUnitAbilityLevel(c,'A0VB')then
        set dmg=GetHeroAgi(c,true)+GetHeroStr(c,true)
        
        call GroupEnumUnitsInRange(G,x+200*Cos(a),y+200*Sin(a),350,Base)
        set n=CreateUnit(GetOwningPlayer(u),'e0SD',x1,y1,a*bj_RADTODEG)
        call SetUnitTimeScale(n,3)
        call UnitApplyTimedLife(n,'BHwe',1)
        loop
        set E=FirstOfGroup(G)
        set x3=GetUnitX(E)
        set y3=GetUnitY(E)
        exitwhen E==null
        if Condition_Base(GetOwningPlayer(c),E)then
            call myCustomDamage(c,E,dmg,false,false,null,null,null)
            call Push(E,20,a,200)
            set n=CreateUnit(GetOwningPlayer(u),'e0SD',x3,y3,a*bj_RADTODEG)
            call SetUnitTimeScale(n,3)
            call UnitApplyTimedLife(n,'BHwe',1)
            set n=CreateUnit(GetOwningPlayer(u),0x6530534B,x1,y1,Atan2(y3-y1,x3-x1)*bj_RADTODEG)
            call SetUnitTimeScale(n,3)
            call SetUnitVertexColor(n,55,155,255,50)
            call UnitApplyTimedLife(n,'BHwe',0.25)
        endif
        call GroupRemoveUnit(G,E)
        set nb=nb+(GetHeroAgi(c,true)+GetHeroStr(c,true))*myCustomDamage2(E,1)
        endloop
    endif
//==============================================================================
//========= BlackGoku Choice Start
//==============================================================================
/// take damage
// (c==UltimateDamage and GetOwningPlayer(UltimateDamage)==GetOwningPlayer(Broly)))
    if nb>0 and  LoadBoolean(HH,GetHandleId( u ),StringHash("BGRageBool"))==false and GetUnitTypeId( u )=='HBGN' and LoadBoolean(HH,GetHandleId( u ),StringHash("BGG"))==false then
        set bgreal=LoadReal(HH,GetHandleId( u ),BGRageHash)
        set tdamage=bgreal-nb
        set ragebase=LoadReal(HH,GetHandleId( u ),BGRageBHash)
        set ragecount=LoadInteger(HH,GetHandleId( u ),BGRageIHash)
        if tdamage<=0 then
            set ragecount=ragecount+1
            call DestroyEffect(AddSpecialEffectTarget("BlackGoku\\byakuya-7.mdl", u ,"origin"))
            call SetUnitState( u ,UNIT_STATE_LIFE,GetUnitState( u ,UNIT_STATE_LIFE)+GetUnitState( u ,UNIT_STATE_MAX_LIFE)*0.05)
            call SaveInteger(HH,GetHandleId( u ),BGRageIHash,  ragecount )
            call SaveReal(HH,GetHandleId( u ),BGRageHash,  ragebase  )
            set tdamage=ragebase
        else
            call SaveReal(HH,GetHandleId( u ),BGRageHash,tdamage)
        endif
        if LoadInteger(HH,GetHandleId( u ),BGRageIHash)==4 then
            set tdamage=0
            call SaveBoolean(HH,GetHandleId( u ),StringHash("BGRageBool"),true)
            if LoadBoolean(HH,GetHandleId( GetLocalPlayer() ),SOUND_LANGUAGE)==true then 
                set soundplay=CreateSound("Sound\\Music\\mp3Music\\SoundEng\\BlackGokuRage_eng.mp3",false,false,true,12700,12700,"")
                call StartSound(soundplay)
                call KillSoundWhenDone(soundplay)
            else
                set soundplay=CreateSound("Sound\\Music\\mp3Music\\SoundJap\\BlackGokuRage.mp3",false,false,true,12700,12700,"")
                call StartSound(soundplay)
                call KillSoundWhenDone(soundplay)
            endif
        endif
    endif
/// do damage


//( c ==UltimateDamage and GetOwningPlayer(UltimateDamage)==GetOwningPlayer( c )  and nb>0 and  LoadBoolean(HH,GetHandleId( c ),StringHash("BGRageBool"))==false and GetUnitTypeId( c )=='HBGN' and LoadBoolean(HH,GetHandleId( c ),StringHash("BGG"))==false  ) or  
    if nb>0 and  LoadBoolean(HH,GetHandleId( c ),StringHash("BGRageBool"))==false and GetUnitTypeId( c )=='HBGN' and LoadBoolean(HH,GetHandleId( c ),StringHash("BGG"))==false then


        set bgreal=LoadReal(HH,GetHandleId( c ),BGRageHash)
        set tdamage=bgreal-nb
        set ragebase=LoadReal(HH,GetHandleId( c ),BGRageBHash)
        set ragecount=LoadInteger(HH,GetHandleId( c ),BGRageIHash)


        if tdamage<=0 then


            call DestroyEffect(AddSpecialEffectTarget("BlackGoku\\byakuya-7.mdl", c ,"origin"))
            call HealTextTag(c,c,  GetUnitState( c ,UNIT_STATE_MAX_LIFE)*0.05*myCustomHeal2(c,1),"HealthRes")
            call SetUnitState( c ,UNIT_STATE_LIFE,GetUnitState( c ,UNIT_STATE_LIFE)+GetUnitState( c ,UNIT_STATE_MAX_LIFE)*0.05)
            set ragecount=ragecount+1
            call SaveInteger(HH,GetHandleId( c ),BGRageIHash,  ragecount )
            call SaveReal(HH,GetHandleId( c ),BGRageHash,  ragebase  )
            set tdamage=ragebase
        else
            call SaveReal(HH,GetHandleId( c ),BGRageHash,tdamage)
        endif

        if LoadInteger(HH,GetHandleId( c ),BGRageIHash)==4 then
            set tdamage=0
            call SaveBoolean(HH,GetHandleId( c ),StringHash("BGRageBool"),true)
            if LoadBoolean(HH,GetHandleId( GetLocalPlayer() ),SOUND_LANGUAGE)==true then 
                set soundplay=CreateSound("Sound\\Music\\mp3Music\\SoundEng\\BlackGokuRage_eng.mp3",false,false,true,12700,12700,"")
                call StartSound(soundplay)
                call KillSoundWhenDone(soundplay)
            else
                set soundplay=CreateSound("Sound\\Music\\mp3Music\\SoundJap\\BlackGokuRage.mp3",false,false,true,12700,12700,"")
                call StartSound(soundplay)
                call KillSoundWhenDone(soundplay)
            endif
        endif
    endif
    //
    //==============================================================================
    //========= BlackGoku Choice end
    //==============================================================================

    if GetUnitAbilityLevel(u,'BKKQ')>0 and nb>0 then 
    //call SetUnitState(GetTriggerUnit(),UNIT_STATE_LIFE,GetWidgetLife(GetTriggerUnit())+nb*0.3)
        if GetUnitState(u,UNIT_STATE_LIFE)>nb*1.2 then
            call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)-nb*0.2) 
        else
            call SetUnitState(u,UNIT_STATE_LIFE,1) 
        endif
        set nb=nb*1.2                     
    endif

    if GetUnitAbilityLevel(u,'BKKE')>0 and nb>0 then 
        call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+nb*0.4)
        set nb=nb*0.6                     
    endif

    if GetUnitAbilityLevel(u,'KkR4')>0 and nb>0 then //курапика уменьшение получаемого урона
        call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+nb*0.4)
        set nb=nb*0.6                     
    endif


    //===========
    //==============================================================================
    //========= Kurapika Q E R Choice END
    //==============================================================================


    if CurrentEventAttack and nb>0 and GetUnitTypeId(c) == 'H02L' and GetHeroLevel(c)>=6 then
        set dmg=GetHeroStr(c,true) * 0.45
        
        call myCustomDamage(c,u,dmg,false,false,null,null,null)
        call Push(u,40,a,75)
        set nb=nb+dmg*myCustomDamage2(u,1)
    endif
    if nb>0 and ((GetUnitTypeId(c) == 'H02L' and c == Hero[GetPlayerId(GetOwningPlayer(c))]) or (c==UltimateDamage and GetOwningPlayer(UltimateDamage)==GetOwningPlayer(Broly))) and IsUnitType(c, UNIT_TYPE_SUMMONED) == false and IsUnitIllusion(c) == false and DU==true then
        set bDamage = bDamage + nb
        if bDamage >= 30*GetHeroStr(Broly,true) then
            
            set bDamage = bDamage - (30*GetHeroStr(Broly,true))
            if bDamage < 0 then
                set bDamage = 0
            endif
            call SetHeroStr(Broly, GetHeroStr(Broly,false) + 1,true)
            set bState = bState + 1
            call StopSound(soundStr[7],false,false)
            call StopSound(soundStr[8],false,false)
            call StopSound(soundStr[9],false,false)
            call StopSound(soundStr[10],false,false)
            call StopSound(soundStr[11],false,false)
            call StopSound(soundStr[12],false,false)
            call StopSound(soundStr[13],false,false)
            call StopSound(soundStr[14],false,false)            
            if bState!=10 then
                set BrolyRandom=GetRandomInt(1,3)
                if BrolyRandom == 1 then
                    if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
                        call StartSound(soundStr[7])
                    else
                        call StartSound(soundStr[8])
                    endif
                elseif BrolyRandom == 2 then
                    if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
                        call StartSound(soundStr[9])
                    else
                        call StartSound(soundStr[10])
                    endif
                elseif BrolyRandom == 3 then
                    if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
                        call StartSound(soundStr[11])
                    else
                        call StartSound(soundStr[12])
                    endif
                endif
            else
                call ClearMapMusic()
                call StopMusic(false)
                call PlayMusic(music[251])
                if expMTimer!=null then
                    call PauseTimer(expMTimer)
                    call DestroyTimer(expMTimer)
                endif
                set expMTimer=CreateTimer()
                call TimerStart(expMTimer, 360, false, function expMusicPlayer)
                set BrolySTRTransform[GetPlayerId(GetOwningPlayer(Broly))]=true
                if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
                    call StartSound(soundStr[13])
                else
                    call StartSound(soundStr[14])
                endif
            endif
            if BrolySTRCond[GetPlayerId(GetOwningPlayer(Broly))]==null and bState>=10 then
                set BrolySTRCond[GetPlayerId(GetOwningPlayer(Broly))]=CreateUnit(GetOwningPlayer(Broly),'h23J',RX,RY,0)
            endif
        endif
    endif
    if nb>0 and GetUnitTypeId(c) == 'HMad' and c == Hero[GetPlayerId(GetOwningPlayer(c))] then
        call SaveReal(HH,GetHandleId( c ),MadokaDHash,LoadReal(HH,GetHandleId( c ),MadokaDHash)+nb)
        if LoadReal(HH,GetHandleId( c ),MadokaDHash)>= LoadReal(HH,GetHandleId( c ),MadokaTDHash) and LoadInteger(HH,GetHandleId( c ),MadokaMHash)==2 then
            call SaveInteger(HH,GetHandleId( c ),MadokaMHash,3)
        endif
    endif
    if CurrentEventAttack and nb>0 and GetUnitAbilityLevel(c,0x4230334A)>0 and GetUnitAbilityLevel(c,'A3WR')==0 then
        call UnitAddAbility(c,'A3WR')
        if GetUnitAbilityLevel(u,'B03I')==0 then
            call myCustomDamage(c,u,GetHeroInt(c,true)*2,false,false,null,null,null)
            else
            call myCustomDamage(c,u,GetHeroInt(c,true)*2.4,false,false,null,null,null)
        endif
        call UnitRemoveAbility(c,'A3WR')
        call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl",x,y))
    endif
