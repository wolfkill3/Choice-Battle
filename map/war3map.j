call RemoveUnit(d1)
set n=LoadUnitHandle(h,id,2)
call SetUnitFlyHeight(n,125,0)
call SetUnitX(n,x)
call SetUnitY(n,y)
set n=LoadUnitHandle(h,id,3)
call SetUnitFlyHeight(n,125,0)
call SetUnitX(n,x)
call SetUnitY(n,y)
set n=LoadUnitHandle(h,id,4)
call SetUnitFlyHeight(n,125,0)
call SetUnitX(n,x)
call SetUnitY(n,y)
call PauseTimer(t)
call TimerStart(t,0.03,true,function EOrihimeCast4)
endif
set d1=null
set p=null
set t=null
set u=null
set c=null
