function JSCond takes nothing returns boolean
return GetSpellAbilityId()=='A0PG' and udg_B==true
endfunction
function JSCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local integer per=LoadInteger(h,id,10)
if SR(x,y,x1,y1)>50 and GetWidgetLife(c)>0 and udg_B==true and DU2==true then
set x=x+60*Cos(a)
set y=y+60*Sin(a)
call SetUnitXY_1(u,x,y,false)
call SetUnitFacing(u,a*bj_RADTODEG)
set n=CreateUnit(p,0x65304E58,x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'B000',0.15)
call SetUnitVertexColor(n,170,170,170,170)
call SetUnitTimeScale(n,2)
call SetUnitAnimation(n,"walk")
call SetUnitAnimation(u,"walk")
else
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,0x6530384D,x1,y1,GetRandomReal(0,359)),1,1)
set n=CreateUnit(p,'e08N',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'B000',1.5)
call SetUnitVertexColor(n,100,100,100,140)
call SetUnitX(u,x1+700*Cos(a+(GetRandomReal(-75,75)*bj_DEGTORAD)))
call SetUnitY(u,y1+700*Sin(a+(GetRandomReal(-75,75)*bj_DEGTORAD)))
call SaveInteger(h,id,10,per+1)
call UnitRemoveAbility(u,'A0G3')
if per>7 then
call myCustomDamage(u,c,75+((4+GetUnitAbilityLevel(u,'A0PG'))*GetHeroAgi(u,true)),false,false,null,null,null)
call SetControlToUnit(u,c,2, "stun")
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitTimeScale(u,1)
call SetUnitPathing(u,true)
call PauseUnit(u,false)
call FlushChildHashtable(h,id)
call SetUnitInvulnerable(u,false)
endif
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function JSCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real a=Atan2(GetUnitY(c)-y,GetUnitX(c)-x)
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
call SaveUnitHandle(h,id,0,u)
call SetUnitPathing(u,false)
call SetUnitAnimation(u,"walk")
call UnitAddAbility(u,'A0G3')
call UnitRemoveAbility(u,'A2VJ')
call PauseUnit(u,true)
call SaveReal(h,id,9,a)
call SaveInteger(h,id,10,0)
call SetUnitInvulnerable(u,true)
call SaveUnitHandle(h,id,1,c)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\NelielR.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.01,true,function JSCast2)
else
call SetUnitX(u,GetUnitX(c))
call SetUnitY(u,GetUnitY(c))
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitVertexColor(u,255,255,255,255)
call FlushChildHashtable(h,id)
endif
set c=null
set p=null
set u=null
set t=null
endfunction
