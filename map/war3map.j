local player p=GetOwningPlayer(u)
local real time=LoadReal(h,id,7)
local real mt=LoadReal(h,id,8)
local real ang=GetRandomReal(-1.1,1.1)
if mt>0 and UnitIsAlive(u)and UnitIsAlive(c)then
set x1=x1-40*Cos(a)
set y1=y1-40*Sin(a)
call SetUnitXY_1(u,x1,y1, false)
if time<0 then
set x1=x1+53*Cos(a)
set y1=y1+53*Sin(a)
call SetUnitXY_1(c,x1,y1, false)
call UnitApplyTimedLife(CreateUnit(p,'e0HD',x,y,a*bj_RADTODEG),1,0.4)
call UnitApplyTimedLife(CreateUnit(p,'e0HE',x,y,a*bj_RADTODEG),1,0.4)
call UnitApplyTimedLife(CreateUnit(p,'e0HC',x1,y1,a*bj_RADTODEG),1,0.6)
call UnitApplyTimedLife(CreateUnit(p,'e0HB',x1,y1,GetRandomReal(0,359)),1,0.6)
call UnitApplyTimedLife(CreateUnit(p,'e0HA',x1,y1,GetRandomReal(0,359)),1,0.6)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",c,"chest"))
set n=CreateUnit(p,'e0UT',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.3)
call SetUnitVertexColor(n,190,255,255,50)
call SetUnitAnimation(n,"attack")
set n=CreateUnit(p,'e0H9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.7)
call SetUnitVertexColor(n,200,200,200,70)
call SaveReal(h,id,7,mt)
call SaveReal(h,id,8,mt-0.12)
endif
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitAnimation(u,"attack")
call SaveReal(h,id,7,LoadReal(h,id,7)-3)
else
if GetUnitAbilityLevel(u,'B06U')>0 then
set dmg=dmg+2*GetHeroAgi(u,true)
endif
call SetUnitInvulnerable(u,false)
call SetUnitInvulnerable(c,false)
call PauseUnit(u,false)
call UnitRemoveAbility(u,'A0XV')
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call myCustomDamage(u,c,dmg+125,false,false,null,null,null)
call Push3(c,35,a,600,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
call SetControlToUnit(u,c,2, "stun")
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitVertexColor(u,255,255,255,255)
call FlushChildHashtable(h,id)
call SetUnitTimeScale(u,1)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function IceBringerCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SetUnitInvulnerable(c,true)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveReal(h,id,7,4)
call SaveReal(h,id,8,4)
call SaveReal(h,id,5,Atan2(y1-y,x1-x))
call SetUnitXY_1(u,x1,y1, false)
call SetUnitVertexColor(u,255,255,255,125)
call SetUnitTimeScale(u,3)
call SetUnitAnimation(u,"attack")
call UnitAddAbility(u,'A0XV')
set soundplay=CreateSound("Sound\\Music\\mp3Music\\GrayE.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.04,true,function IceBringerCast2)
else
    call PauseUnit(u,false)
    call SetUnitInvulnerable(u,false)
    call SetUnitAnimation(u,"attack")
    call PauseUnit(c,false)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
    call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
    call PauseTimer(t)
    call DestroyTimer(t)
    call SetUnitVertexColor(u,255,255,255,255)
    call FlushChildHashtable(h,id)
endif
set t=null
set u=null
set p=null
set c=null
endfunction
