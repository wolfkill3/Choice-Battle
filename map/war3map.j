                        call SetControlToUnit(c,c,1.0,"stun")
                        call PauseTimer(t)
                        call DestroyTimer(t)
                        call FlushChildHashtable(HH,id)
                endif
        else
                if time==0.02 then
                        call UnitSpeed(u,1)
