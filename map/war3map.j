function NodensSokuteiCond takes nothing returns boolean
return GetSpellAbilityId()=='A17S'
endfunction
function NodensSokuteiCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real time=LoadReal(h,id,2)
local real x=LoadReal(h,id,5)
local real y=LoadReal(h,id,6)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(p)
local boolean b=LoadBoolean(h,id,10)
local real dmg=7*GetHeroInt(u,true)
local real dmg2=0.3*GetHeroInt(u,true)
local group g=LoadGroupHandle(h,id,8)
if time<6 and b==false then
call GroupEnumUnitsInRange(G,x,y,1200,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg2,false,false,null,null,null)
endif
call GroupRemoveUnit(G,E)
endloop
call SaveReal(h,id,2,time+0.15)
if SR(x,y,x1,y1)>1100 then
call SaveBoolean(h,id,10,true)
endif
else
loop
set E=FirstOfGroup(g)
exitwhen E==null
call UnitApplyTimedLife(E,'BTLF',1)
call GroupRemoveUnit(g,E)
endloop
if b==true then
if IsUnitInvulnerable(c)==true then
    call SetUnitInvulnerable(c,false)
    call UnitRemoveBuffs(c,true,true)
    if UnitHasItemOfTypeBJCustom(c, 'I03A') and GetWidgetLife(c)>0 and IsUnitIllusion(c)==false then
        set AlastorPos=0
        loop
        exitwhen AlastorPos==10 or GetItemTypeId(UnitItemInSlot(c,AlastorPos)) == 'I03A'
        set AlastorPos=AlastorPos+1
        endloop
        set Alastor=GetItemOfTypeFromUnitBJCustom(c,'I03A')
        call UnitRemoveItem(c,Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(c, 'I03A',AlastorPos)
    endif
    call UnitAddAbility(c,'A0WR')
    call myCustomDamage(u,c,dmg,false,false,null,DAMAGE_TYPE_UNIVERSAL,null)
    call DamageIndicatorFunction(u, c, dmg)
    call DamageTextTag(u, c, dmg)
    call UnitRemoveAbility(c,'A0WR')
    call SetUnitInvulnerable(c,true)
else
    call UnitRemoveBuffs(c,true,true)
    if UnitHasItemOfTypeBJCustom(c, 'I03A') and GetWidgetLife(c)>0 and IsUnitIllusion(c)==false then
        set AlastorPos=0
        loop
        exitwhen AlastorPos==10 or GetItemTypeId(UnitItemInSlot(c,AlastorPos)) == 'I03A'
        set AlastorPos=AlastorPos+1
        endloop
        set Alastor=GetItemOfTypeFromUnitBJCustom(c,'I03A')
        call UnitRemoveItem(c,Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(c, 'I03A',AlastorPos)
    endif
    call UnitAddAbility(c,'A0WR')
    call myCustomDamage(u,c,dmg,false,false,null,DAMAGE_TYPE_UNIVERSAL,null)
    call DamageIndicatorFunction(u, c, dmg)
    call DamageTextTag(u, c, dmg)
    call UnitRemoveAbility(c,'A0WR')
endif
endif
call SetUnitInvulnerable(u,false)
call PauseTimer(t)
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set c=null
set t=null
set u=null
set g=null
endfunction
function NodensSokuteiCast takes nothing returns nothing
local timer t=CreateTimer()
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local integer id=GetHandleId(t)
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(p)
local real a=0
local integer i=0
local group g=CreateGroup()
local real x1
local real y1
// кольцо огня: 25 моделей через 14.4° (раньше 50 через 7.2° — 50 источников частиц), масштаб 5 вместо 4
local real f=(14.4)*bj_DEGTORAD
call SaveGroupHandle(h,id,8,g)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveReal(h,id,2,0)
call SaveBoolean(h,id,10,false)
call SetUnitInvulnerable(u,true)
call GroupAddUnit(g,CreateUnit(p,'e0Z1',x,y,0))
call GroupAddUnit(g,CreateUnit(p,'e0Z2',x,y,0))
loop
exitwhen i>=25
set x1=x+1100*Cos((i*f))
set y1=y+1100*Sin((i*f))
set a=Atan2(y-y1,x-x1)
set n=CreateUnit(p,'e0Z0',x1,y1,0)
call SetUnitScale(n,5.,5.,5.)
call GroupAddUnit(g,n)
set i=i+1
endloop
set soundplay=SndN(1680) // Sound\Music\mp3Music\Kuuko5.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SaveReal(h,id,5,x)
call SaveReal(h,id,6,y)
call TimerStart(t,0.15,true,function NodensSokuteiCast2)
set t=null
set g=null
set p=null
set u=null
endfunction
function BurningBodyCond takes nothing returns boolean
return GetSpellAbilityId()=='A0OU'
endfunction
function BurningBodyCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
local real l=GetWidgetLife(u)
local real m=GetWidgetMana(u)
local real lm=GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.003
local real mm=GetUnitState(u,UNIT_STATE_MAX_MANA)
local player p=GetOwningPlayer(u)
if GetUnitAbilityLevel(u,'B043')>0 then
call HealTextTag(u,u,GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.003*myCustomHeal2(u,1),"HealthRes")
call SetUnitState(u,UNIT_STATE_LIFE,l+lm)
call DestroyEffect(AddSpecialEffect("war3mapImported\\Fire Bolt.mdl",x+GetRandomReal(-600,600),y+GetRandomReal(-600,600)))
call DestroyEffect(AddSpecialEffect("war3mapImported\\Fire Bolt.mdl",x+GetRandomReal(-600,600),y+GetRandomReal(-600,600)))
call GroupEnumUnitsInRange(G,x,y,600,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,lm,false,false,null,null,null)
endif
call GroupRemoveUnit(G,E)
endloop
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set t=null
endfunction
function BurningBodyCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,GetHeroInt(u,true)*GetUnitAbilityLevel(u,'A0OU'))
call TimerStart(t,0.1,true,function BurningBodyCast2)
set soundplay=SndN(1682) // Sound\Music\mp3Music\Kuuko4.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set u=null
set t=null
endfunction
function BurningBodyInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function BurningBodyCast)
call TriggerAddCondition(t,Condition(function BurningBodyCond))
set t=null
endfunction
function MissleMoveFireLaserStrike2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,4)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)+angle
if SR(x,y,x1,y1)>30 then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitAnimation(l__d,"walk")
call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(l__d),'e0N6',x,y,a*bj_RADTODEG),'BTLF',0.5)
else
call myCustomDamage(LoadUnitHandle(h,id,6),c,LoadReal(h,id,5),false,false,null,null,null)
call DestroyEffect(AddSpecialEffect("war3mapImported\\Fire Bolt.mdx",x1,y1))
call DestroyEffect(AddSpecialEffect("war3mapImported\\SuperBigExplosion.mdx",x1,y1))
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set c=null
set l__d=null
set t=null
endfunction
function MissleMoveFireLaserStrike takes unit l__d,real speed,real angle,unit target,string l__s,real dmg,unit damager returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveStr(h,id,3,l__s)
call SaveUnitHandle(h,id,4,target)
call SaveReal(h,id,5,dmg)
call SaveUnitHandle(h,id,6,damager)
call TimerStart(t,0.035,true,function MissleMoveFireLaserStrike2)
set t=null
endfunction
function CondFireLaserStrike takes nothing returns boolean
return GetSpellAbilityId()=='A0OS'
endfunction
function CastFireLaserStrike2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,2)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,1)
local real dmg=GetHeroInt(u,true)*(3+GetUnitAbilityLevel(u,'A0OS'))+120
loop
set E=FirstOfGroup(g)
exitwhen E==null
set n=CreateUnit(p,'e0N6',GetUnitX(E),GetUnitY(E),GetUnitFacing(E))
call MissleMoveFireLaserStrike(n,50,0,c,"",dmg/6,u)
call GroupRemoveUnit(g,E)
call RemoveUnit(E)
endloop
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
set c=null
set p=null
set u=null
set g=null
endfunction
function CastFireLaserStrike takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local unit c=GetSpellTargetUnit()
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local real x1=0
local real y1=0
local group g=CreateGroup()
local real r=60
local real a=0
local integer i=0
local timer t=CreateTimer()
local integer id=GetHandleId(t)
loop
exitwhen i>=6
set a=r*i*bj_DEGTORAD
set x1=x+600*Cos(a)
set y1=y+600*Sin(a)
set a=Atan2(y-y1,x-x1)
set n=CreateUnit(p,0x68303347,x1,y1,a*bj_RADTODEG)
call PauseUnit(n,true)
call GroupAddUnit(g,n)
set i=i+1
endloop
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,2,c)
call SaveGroupHandle(h,id,1,g)
set soundplay=SndN(1684) // Sound\Music\mp3Music\KukoE.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,1,false,function CastFireLaserStrike2)
set g=null
set c=null
set t=null
set p=null
set u=null
endfunction
function FireLaserStrikeInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function CastFireLaserStrike)
call TriggerAddCondition(t,Condition(function CondFireLaserStrike))
set t=null
endfunction
function KillGroup2 takes nothing returns nothing
call KillUnit(GetEnumUnit())
endfunction
function FireStormCond takes nothing returns boolean
return GetSpellAbilityId()=='A0OR'
endfunction
function FireStormCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local group g=LoadGroupHandle(h,id,60)
local group gn=LoadGroupHandle(h,id,61)
local integer i=0
local real x=LoadReal(h,id,50)
local real y=LoadReal(h,id,51)
local real x1=0
local real y1=0
local real x2
local real y2
local real dist
local real f=0
local real dmg=(50+GetHeroInt(u,true))*GetUnitAbilityLevel(u,'A0OR')
local integer l__idg=GetHandleId(g)
local player p=GetOwningPlayer(u)
loop
set i=i+1
exitwhen i>6
set n=LoadUnitHandle(h,id,1+i)
set f=(GetUnitFacing(n)+7.5)*bj_DEGTORAD
set dist=LoadReal(h,id,StringHash("dist"+I2S(i)))+30
call SaveReal(h,id,StringHash("Dist"+I2S(i)),dist)
set x1=x+dist*Cos(f)
set y1=y+dist*Sin(f)
call SetUnitFacing(n,f*bj_RADTODEG)
call DestroyEffect(AddSpecialEffect("war3mapImported\\Fire Bolt.mdl",x1,y1))
call SetUnitX(n,x1)
call SetUnitY(n,y1)
endloop
call GroupEnumUnitsInRange(g,x,y,dist,Base)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set ide=GetHandleId(E)
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 2, "stun")
call SaveUnitHandle(h,l__idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
if dist>=500 then
call ForGroup(gn,function KillGroup2)
call DestroyGroup(g)
call DestroyGroup(gn)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
set gn=null
set u=null
set g=null
set t=null
set p=null
endfunction
function FireStormCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local real r=0.
local integer i=1
local group g=CreateGroup()
local player p=GetOwningPlayer(u)
loop
exitwhen i>6
set r=i*60.
set n=CreateUnit(p,'e0N4',x,y,r)
call GroupAddUnit(g,n)
call SaveUnitHandle(h,id,1+i,n)
set i=i+1
endloop
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,60,CreateGroup())
call SaveGroupHandle(h,id,61,g)
call SaveReal(h,id,50,x)
call SaveReal(h,id,51,y)
set soundplay=SndN(1686) // Sound\Music\mp3Music\Kuuko2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,.03,true,function FireStormCast2)
set u=null
set t=null
set p=null
endfunction
