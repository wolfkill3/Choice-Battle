function AbsorbCond takes nothing returns boolean
return GetSpellAbilityId()=='A0PB'
endfunction
function AbsorbCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local integer idu=GetHandleId(u)
local real time=LoadReal(h,idu,SH_nell)
if time>0 and GetUnitAbilityLevel(u,'A0PC')==0 then
if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
call SaveReal(h,GetHandleId(u),SH_nell,time-0.05)
endif
else
call SaveReal(h,idu,SH_nell,0)
call SaveReal(h,idu,SH_nelld,0)
call RemoveSavedHandle(h,idu,SH_nell1)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set t=null
endfunction
function AbsorbCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local integer idu=GetHandleId(u)
local real time=LoadReal(h,id,4)
if time<=3.3 then
call PauseUnit(u,true)
if LoadBoolean(HH,GetHandleId(u),TARGET_ABILITY)==false then
call SaveReal(h,id,4,time+0.05)
endif
else
call UnitMakeAbilityPermanent(u,false,'A0PC')
call UnitRemoveAbility(u,'A0PC')
call PauseUnit(u,false)
call SetUnitTimeScale(u,1)
call SaveReal(h,idu,SH_nell,10.0)
if LoadTimerHandle(h,idu,SH_nell1)==null then
call SaveTimerHandle(h,idu,SH_nell1,t)
endif
if GetHeroLevel(u)==35 and LoadReal(h,idu,SH_nelld)>0 and GetAbilityRemainingCooldown(GetUnitAbility(u, 'A0PA'))>1.0 then
    call StartAbilityCooldown(GetUnitAbility(u, 'A0PA'), 0.1)
endif
call UnitRemoveBuffs(u,false,true)
call TextTagFull(I2S(R2I(LoadReal(h,idu,SH_nelld)))+"!",u,50,125,255,1,GetOwningPlayer(u),0.24)
call CreateModeIndicatorWithPauseFormDispellableHash(u, "war3mapImported\\BTNNell 2.blp", 10,SH_nelld)
call PauseTimer(t)
call TimerStart(t,0.05,true,function AbsorbCast3)
endif
set u=null
set t=null
endfunction
function AbsorbCast takes nothing returns nothing
local unit u=GetTriggerUnit()
