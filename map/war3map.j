call DestroyEffect(LoadEffectHandle(h,id,3))
call DestroyEffect(LoadEffectHandle(h,id,8))
call SetUnitOwner(l__d,p,false)
call PauseTimer(t)
call TimerStart(t,0.1,true,function TrowFireBlastCast3)
endif
set l__d=null
set u=null
set p=null
set t=null
endfunction
