call SetUnitX(d1,x1)
call SetUnitY(d1,y1)
call GroupEnumUnitsInRange(g,x1,y1,250,Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
call PoisonDamage3(u,E,dmg2,7,"Environment\\LargeBuildingFire\\LargeBuildingFire1.mdl","origin")
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
call UnitApplyTimedLife(CreateUnit(p,0x65304657,x1,y1,a*bj_RADTODEG),1,1)
else
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,GetHandleId(g))
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
call RemoveUnit(l__d)
call RemoveUnit(d1)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
set d1=null
endfunction
