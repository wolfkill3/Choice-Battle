set r=GetRandomReal(0,7)
call MissleMovePointMagmaBurst(n,GetRandomReal(5,9),0,x+l__d*Cos(r),y+l__d*Sin(r),GetRandomReal(300,600),0,0)
set n=CreateUnit(p,'e0JS',x,y,GetRandomReal(0,359))
