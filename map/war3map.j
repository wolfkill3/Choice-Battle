call KillSoundWhenDone(soundplay)

else

set soundplay=CreateSound("Sound\\Music\\mp3Music\\ArcueidR2Hit.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)

endif





call RemoveUnit(LoadUnitHandle(HH,id,20))
if l!=null then
call DestroyLightning(l)
endif
if LoadBoolean(HH,id,21)==true then
call EffectCreateAndMove(true,"Kurapika\\Zhendi-sand.mdl",facing,1.5,1.75,0.75,100,100,100,0,-100,target,0,facing)
call EffectCreateAndMove(true,"Kurapika\\WindCircleFaster.mdl",facing,1.5,1.5,0.5,100,100,100,0,50,target,0,facing)
call DamageAoeAndStun(caster,GetUnitX(target),GetUnitY(target),400,LoadReal(HH,id,15),3)
else
call EffectCreateAndMove(true,"Kurapika\\Zhendi-sand.mdl",facing,1.5,1,0.75,100,100,100,0,0,target,0,facing)
call EffectCreateAndMove(true,"Kurapika\\WindCircleFaster.mdl",facing,1.5,1,0.5,100,100,100,0,50,target,0,facing)


if IsUnitAlly(target,GetOwningPlayer(caster))==false then
call UnitStop(target)
call myCustomDamage(caster,target,LoadReal(HH,id,15),false,false,null,null,null)
call SetControlToUnit(caster,target, 2, "stun")
endif



endif



call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else
if time==0.3 then
call UnitSpeed(LoadUnitHandle(HH,id,20),0)
endif
if time==0.02 then



if GetUnitTypeId(caster)=='H04O' then

set soundplay=CreateSound("Sound\\Music\\mp3Music\\KurapikaR2Start.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)

else

set soundplay=CreateSound("Sound\\Music\\mp3Music\\ArcueidR2Start.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)

endif




set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
call UnitSize(n0,2.5,1,1)
call SetUnitModel(n0,"Kurapika\\KurapikaChainJail.mdl")
if GetUnitTypeId(caster)=='H04O' then
call SetUnitVertexColor(n0,255,255,255,255)
else
call SetUnitVertexColor(n0,255,55,55,255)
endif
call MoveUnit(n0,n0,100,facing)
call SetUnitFlyHeight(n0,100,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=null
call EffectCreateAndMove(true,"Kurapika\\WindWeak(Thicker).mdl",facing,1,0.5,0.5,100,100,100,0,50,caster,0,facing)
call EffectCreateAndMove(true,"Kurapika\\HakenSaber2.mdl",facing,1,0.5,0.5,100,100,100,0,0,caster,0,facing)
if GetUnitTypeId(caster)=='H04O' then
call SaveLightningHandle(HH,id,16,AddLightningEx("DRAL",true,GetUnitX(caster),GetUnitY(caster),GetUnitFlyHeight(caster)+75,GetUnitX(target),GetUnitY(target),GetUnitFlyHeight(target)+75))
else
call SaveLightningHandle(HH,id,16,AddLightningEx("DRAA",true,GetUnitX(caster),GetUnitY(caster),GetUnitFlyHeight(caster)+75,GetUnitX(target),GetUnitY(target),GetUnitFlyHeight(target)+75))
endif
if GetRandomInt(1,2)==1 then
call SaveInteger(HH,id,19,40)
else
call SaveInteger(HH,id,19,-40)
endif
call UnitSpeed(caster,2)
call SetUnitAnimationByIndex(caster,2)
endif
if time<0.1 then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
endif
if time==0.1 then
call UnitSpeed(caster,1)
call EffectCreateAndMove90(true,"Kurapika\\WindWeak(Thicker).mdl",GetUnitFacing(caster),1,0.3,0.5,100,100,100,0,100,caster,100,GetUnitFacing(caster))
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)

if dist>1200+LoadReal(HH,id,22)then
call SaveReal(HH,id,11,PolX(GetUnitX(target),1200+LoadReal(HH,id,22),facing))
call SaveReal(HH,id,12,PolY(GetUnitY(target),1200+LoadReal(HH,id,22),facing))
endif
endif
if time>0.1 then


set x0=PolX(GetUnitX(target),45+LoadReal(HH,id,23),facing)
set y0=PolY(GetUnitY(target),45+LoadReal(HH,id,23),facing)

if IsTerrainPathable(x0,y0,PATHING_TYPE_FLYABILITY)==true then
call SaveReal(HH,id,5, 10+LoadReal(HH,id,24) )
endif



call MoveUnit(target,target,45+LoadReal(HH,id,23),facing)




endif
endif
set l=null
set target=null
set caster=null
endfunction
function KurapikaR1Act takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit target=LoadUnitHandle(HH,id,2)
local real facing=Angle2(GetUnitX(caster),GetUnitY(caster),GetUnitX(target),GetUnitY(target))
local real time=LoadReal(HH,id,5)
local unit Dummy=LoadUnitHandle(HH,id,20)
local real dist=SR(GetUnitX(caster),GetUnitY(caster),GetUnitX(target),GetUnitY(target))
local lightning l=LoadLightningHandle(HH,id,16)

set time=time+0.02
call SaveReal(HH,id,5,time)
if  time>0.2 and (GetUnitAbilityLevel(target,'B05G') > 0 or (time==21.02+GetUnitAbilityLevel(caster,'KkR1')+LoadReal(HH,id,24)or dist>=1200+LoadReal(HH,id,22)or LoadBoolean(HH,GetHandleId(caster),StringHash("KurapRcheck"))==false ) ) then


if IsUnitAlly(target,GetOwningPlayer(caster))==false then

call UnitRemoveAbility(target,'KkR3')
call UnitRemoveAbility(target,'BKkR')

else

call UnitRemoveAbility(target,'KkR4')
call UnitRemoveAbility(target,'BKk2')

endif

call RemoveUnit(Dummy)
call SaveUnitHandle(HH,GetHandleId(caster),StringHash("KurapRTarg"),caster)
call UnitRemoveAbility(caster,'KkR2')
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'KkR1',true)
if l!=null then
call DestroyLightning(l)
endif
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())

else
if time==20.3 then
call UnitSpeed(Dummy,0)
endif
if time==20.02 then




if GetUnitTypeId(caster)=='H04O' then

set soundplay=CreateSound("Sound\\Music\\mp3Music\\KurapikaRHit.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)

else

set soundplay=CreateSound("Sound\\Music\\mp3Music\\ArcueidRHit.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)

endif






if IsUnitAlly(target,GetOwningPlayer(caster))==false then

call UnitStop(target)
call UnitAddAbility(target,'KkR3')

else

call UnitAddAbility(target,'KkR4')

endif

call UnitSize(Dummy,2.5,1,1)
call SetUnitModel(Dummy,"Kurapika\\KurapikaChainJail.mdl")
if GetUnitTypeId(caster)=='H04O' then
call SetUnitVertexColor(Dummy,255,255,255,255)
else
call SetUnitVertexColor(Dummy,255,55,55,255)
endif
call SaveUnitHandle(HH,GetHandleId(caster),StringHash("KurapRTarg"),target)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'KkR1',false)
call UnitAddAbility(caster,'KkR2')




if LoadBoolean(HH,id,21)==true then
call GroupClear(G)
call GroupEnumUnitsInRange(G,GetUnitX(target),GetUnitY(target),300,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if n0!=target and IsUnitEnemy(n0,GetOwningPlayer(caster))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(n0,'Avul')==0 then
call EffectCreateAndMove(true,"war3mapImported\\KurapikaChainJail.mdl",facing,1,2.5,0.5,100,100,100,0,100,n0,0,facing)
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
call DamageAoeOneTime0(caster,GetUnitX(target),GetUnitY(target),300,LoadReal(HH,id,15))
else

if IsUnitAlly(target,GetOwningPlayer(caster))==false then

call myCustomDamage(caster,target,LoadReal(HH,id,15),false,false,null,null,null)
endif

endif
endif
if time==0.02 then






if GetUnitTypeId(caster)=='H04O' then
call SetUnitAnimationByIndex(caster,11)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\KurapikaRStart.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)

else
call SetUnitAnimation(caster,"spell two")
set soundplay=CreateSound("Sound\\Music\\mp3Music\\ArcueidRStart.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)

endif






call EffectCreateAndMove(true,"Kurapika\\WindWeak(Thicker).mdl",facing,1,0.5,0.5,100,100,100,0,50,caster,0,facing)
call EffectCreateAndMove(true,"Kurapika\\[A]az_axe_ef1.mdl",facing,1,0.5,0.5,100,100,100,0,0,caster,0,facing)

call UnitSpeed(caster,2)
endif
if time<0.2 then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
endif
if time==0.2 then
call EffectCreateAndMove(true,"Kurapika\\red-smoke1.mdl",facing,1,0.5,0.5,100,100,100,0,100,caster,100,facing)
call EffectCreateAndMove90(true,"Kurapika\\WindWeak(Thicker).mdl",facing,1,0.3,0.5,100,100,100,0,100,caster,100,facing)
call UnitSpeed(caster,1)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
call SetUnitModel(n0,"Others\\KurapikaRSkin.mdl")
call MoveUnit(n0,n0,100,facing)
call SetUnitFlyHeight(n0,100,0)
call SaveUnitHandle(HH,id,20,n0)
if GetUnitTypeId(caster)=='H04O' then
call SaveLightningHandle(HH,id,16,AddLightningEx("DRAL",true,GetUnitX(caster),GetUnitY(caster),GetUnitFlyHeight(caster)+75,GetUnitX(n0),GetUnitY(n0),GetUnitFlyHeight(n0)+75))
else
call SaveLightningHandle(HH,id,16,AddLightningEx("DRAA",true,GetUnitX(caster),GetUnitY(caster),GetUnitFlyHeight(caster)+75,GetUnitX(n0),GetUnitY(n0),GetUnitFlyHeight(n0)+75))
endif
set n0=null
endif
if time>20 then
if dist>300 then
if LoadBoolean(HH,id,25)==true then
call MoveUnit(target,target,-(6+dist*0.01),facing)
else
call MoveUnit(target,target,-(3+dist*0.005),facing)
endif
endif
call MoveUnit(target,Dummy,0,facing)
call SetUnitFlyHeight(Dummy,GetUnitFlyHeight(target)+100,0)
call MoveLightningEx(l,true,GetUnitX(caster),GetUnitY(caster),GetUnitFlyHeight(caster)+75,GetUnitX(target),GetUnitY(target),GetUnitFlyHeight(target)+75)
endif
if time>0.2 and time<20 then
call MoveLightningEx(l,true,GetUnitX(caster),GetUnitY(caster),GetUnitFlyHeight(caster)+75,GetUnitX(Dummy),GetUnitY(Dummy),GetUnitFlyHeight(target))

set facing=Angle2(GetUnitX(Dummy),GetUnitY(Dummy),GetUnitX(target),GetUnitY(target))
call SaveReal(HH,id,3,facing)
if SR(GetUnitX(Dummy),GetUnitY(Dummy),GetUnitX(target),GetUnitY(target))>50 then
call MoveUnit(Dummy,Dummy,45+LoadReal(HH,id,23),facing)

call SetUnitFacing(Dummy,Angle2(GetUnitX( Dummy ),GetUnitY( Dummy ),GetUnitX( target ),GetUnitY( target )))


else
set time=20
call SaveReal(HH,id,5,time)
endif
endif
endif
set l=null
set Dummy=null
set target=null
set caster=null
endfunction

function KurapikaEAct2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,1)
local unit c=LoadUnitHandle(HH,id,2)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)-bj_PI
local player p=GetOwningPlayer(u)
local integer i=1
call SetUnitInvulnerable(u,true)
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
call SetUnitX(u,x1)
call SetUnitY(u,y1)
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x1,y1))
call Push(c,50,a,300)
set n=CreateUnit(GetOwningPlayer(u),'e09P',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,0.4)
call SetUnitTimeScale(n,2)
if IsUnitInvulnerable(c)==true then
    call SetUnitInvulnerable(c,false)
    if GetUnitAbilityLevel(u,'A1A6')>0 or GetUnitAbilityLevel(u,'A1AD')>0 then
        call myCustomDamage(u,c,(2+GetUnitAbilityLevel(u,'A0YR'))*GetHeroAgi(u,true),false,false,null,null,null)
    elseif GetUnitAbilityLevel(u,'A1A7')>0 or GetUnitAbilityLevel(u,'A1AF')>0 then
        call myCustomDamage(u,c,(2+GetUnitAbilityLevel(u,'A0YR'))*GetHeroInt(u,true),false,false,null,null,null)
    elseif GetUnitAbilityLevel(u,'A1A8')>0 or GetUnitAbilityLevel(u,'A1AE')>0 then
        call myCustomDamage(u,c,(2+GetUnitAbilityLevel(u,'A0YR'))*GetHeroStr(u,true),false,false,null,null,null)
    endif
    call SetUnitInvulnerable(c,true)
else
    if GetUnitAbilityLevel(u,'A1A6')>0 or GetUnitAbilityLevel(u,'A1AD')>0 then
        call myCustomDamage(u,c,(2+GetUnitAbilityLevel(u,'A0YR'))*GetHeroAgi(u,true),false,false,null,null,null)
    elseif GetUnitAbilityLevel(u,'A1A7')>0 or GetUnitAbilityLevel(u,'A1AF')>0 then
        call myCustomDamage(u,c,(2+GetUnitAbilityLevel(u,'A0YR'))*GetHeroInt(u,true),false,false,null,null,null)
    elseif GetUnitAbilityLevel(u,'A1A8')>0 or GetUnitAbilityLevel(u,'A1AE')>0 then
        call myCustomDamage(u,c,(2+GetUnitAbilityLevel(u,'A0YR'))*GetHeroStr(u,true),false,false,null,null,null)
    endif
endif
///KurapikaE Buff
if GetUnitAbilityLevel( u ,'A1A6')>0 or GetUnitAbilityLevel( u ,'A1AD')>0 then//ловкость


    call UnitAddAbility( u ,'AKKE')
    call UnitRemoveAbility( u ,'AKKE')

elseif GetUnitAbilityLevel( u ,'A1A7')>0 or GetUnitAbilityLevel( u ,'A1AF')>0 then//инта

    call SetControlToUnit( u ,c,2, "silence")


elseif GetUnitAbilityLevel( u ,'A1A8')>0 or GetUnitAbilityLevel( u ,'A1AE')>0 then//сила
    call SetUnitState( c ,UNIT_STATE_MANA,GetUnitState(c,UNIT_STATE_MANA)- GetUnitState(c,UNIT_STATE_MAX_MANA)*0.2 )

endif
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitTimeScale(u,1)
call SetUnitPathing(u,true)
call PauseUnit(u,false)
call FlushChildHashtable(HH,id)
call SetUnitInvulnerable(u,false)
set p=null
set u=null
set c=null
set t=null
endfunction
function KurapikaEAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,1)
local integer idu=GetHandleId(u)
local unit c=LoadUnitHandle(HH,idu,REVERSE_TARGET)
if GetUnitAbilityLevel(u,'B054')==0 or c!=null then
call UnitMakeAbilityPermanent(u,false,'B054')
call UnitRemoveAbility(u,'B054')
call UnitRemoveBuffs(u,false,true)
call SetUnitTimeScale(u,1)
call SaveBoolean(HH,idu,ANTITARGET_ABILITY,false)
if c!=null then
call SaveUnitHandle(HH,id,2,c)
call RemoveSavedHandle(HH,idu,REVERSE_TARGET)
call PauseTimer(t)
call TimerStart(t,0.02,true,function KurapikaEAct2)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
endif
set c=null
set u=null
set t=null
endfunction

function KurapikaChoice_Act takes nothing returns nothing
local timer t=CreateTimer()
local unit caster=GetTriggerUnit()
local integer id=GetHandleId(t)
local real x0=GetUnitX(caster)
local real y0=GetUnitY(caster)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real facing=Angle2(x0,y0,x1,y1)

call SaveUnitHandle(HH,id,1,caster)
call SaveReal(HH,id,11,x1)
call SaveReal(HH,id,12,y1)
call SaveReal(HH,id,3,facing)

if GetSpellAbilityId()=='A0YR' then
call UnitMakeAbilityPermanent(caster,true,'B054')

set soundplay=CreateSound("Sound\\Music\\mp3Music\\KurapikaE.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)

call SaveBoolean(HH,GetHandleId(caster),ANTITARGET_ABILITY,true)
call TimerStart(t,0.02,true,function KurapikaEAct)
endif

if GetSpellAbilityId()=='KkR2' then

    if GetUnitAbilityLevel(caster,'A1A6')>0 or GetUnitAbilityLevel(caster,'A1AD')>0 then//ловкость
        call SaveReal(HH,id,15,5*GetHeroAgi(caster,true))
        call SaveReal(HH,id,24,4)
    elseif GetUnitAbilityLevel(caster,'A1A7')>0 or GetUnitAbilityLevel(caster,'A1AF')>0 then//инта
        call SaveReal(HH,id,15,5*GetHeroInt(caster,true))
        call SaveBoolean(HH,id,21,true)
    elseif GetUnitAbilityLevel(caster,'A1A8')>0 or GetUnitAbilityLevel(caster,'A1AE')>0 then//сила
        call SaveReal(HH,id,15,5*GetHeroStr(caster,true))
        call SaveReal(HH,id,22,1200)
        call SaveReal(HH,id,23,45)
    endif

    call SaveBoolean(HH,GetHandleId(caster),StringHash("KurapRcheck"),false)
    call SaveUnitHandle(HH,id,2,LoadUnitHandle(HH,GetHandleId(caster),StringHash("KurapRTarg")))
    call PauseUnit(caster,true)
    call SetUnitInvulnerable(caster,true)


    call TimerStart(t,0.02,true,function KurapikaR2Act)
endif

if GetSpellAbilityId()=='KkR1' then

    call SaveBoolean(HH,GetHandleId(caster),StringHash("KurapRcheck"),true)
    call SaveUnitHandle(HH,id,2,GetSpellTargetUnit())
    call PauseUnit(caster,true)
    call SetUnitInvulnerable(caster,true)


    if GetUnitAbilityLevel(caster,'A1A6')>0 or GetUnitAbilityLevel(caster,'A1AD')>0 then//ловкость

        call SaveReal(HH,id,15,GetUnitAbilityLevel(caster,'KkR1')*GetHeroAgi(caster,true))
        call SaveReal(HH,id,22,10000)
        call SaveReal(HH,id,24,4)
        call SaveBoolean(HH,id,25,true)

    elseif GetUnitAbilityLevel(caster,'A1A7')>0 or GetUnitAbilityLevel(caster,'A1AF')>0 then//инта

        call SaveReal(HH,id,15,GetUnitAbilityLevel(caster,'KkR1')*GetHeroInt(caster,true))
        call SaveBoolean(HH,id,21,true)

    elseif GetUnitAbilityLevel(caster,'A1A8')>0 or GetUnitAbilityLevel(caster,'A1AE')>0 then//сила

        call SaveReal(HH,id,15,GetUnitAbilityLevel(caster,'KkR1')*GetHeroStr(caster,true))
        call SaveReal(HH,id,22,1200)
        call SaveReal(HH,id,23,45)

    endif

    call TimerStart(t,0.02,true,function KurapikaR1Act)
endif

set t=null
set caster=null
endfunction

function KurapikaChoice_Cond takes nothing returns boolean
if GetSpellAbilityId()=='KkR1' or GetSpellAbilityId()=='KkR2' or GetSpellAbilityId()=='A0YR' then
return true
else
return false
endif
endfunction
function InitTrig_KurapikaR takes nothing returns nothing
local trigger KurapikaChoice=CreateTrigger()
local integer index
set index=0
loop
call TriggerRegisterPlayerUnitEvent(KurapikaChoice,Player(index),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set index=index+1
exitwhen index==bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddCondition(KurapikaChoice,Condition(function KurapikaChoice_Cond))
call TriggerAddAction(KurapikaChoice,function KurapikaChoice_Act)
set KurapikaChoice=null
set index=0
endfunction
//kurapika choice end

//Gaara Choice start
function GaaraTGRangeAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local group gr=LoadGroupHandle(HH,id,4)
if SR(GetUnitX(LoadUnitHandle(HH,id,1)),GetUnitY(LoadUnitHandle(HH,id,1)),GetUnitX(GetEnumUnit()),GetUnitY(GetEnumUnit()))>500 then
call SaveBoolean(HH,GetHandleId(GetEnumUnit()),StringHash("GaaraTshield"),false)
call GroupRemoveUnit(gr,GetEnumUnit())
call SaveGroupHandle(HH,id,4,gr)
endif
set gr=null
endfunction

function GaaraTGAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local group gr=LoadGroupHandle(HH,id,4)
local unit Dummy=LoadUnitHandle(HH,id,20)
local real x0=LoadReal(HH,id,11)
local real y0=LoadReal(HH,id,12)
local real damage=LoadReal(HH,id,15)
set time=time+0.02
call SaveReal(HH,id,5,time)
if time==5 then
loop
set n0=FirstOfGroup(gr)
exitwhen n0==null
call SaveBoolean(HH,GetHandleId(n0),StringHash("GaaraTshield"),false)
call GroupRemoveUnit(gr,n0)
endloop
call DestroyGroup(LoadGroupHandle(HH,id,4))
call UnitSpeed(Dummy,2)
call SetUnitAnimationByIndex(Dummy,1)
call RemoveUnit(Dummy)
call RemoveUnit(LoadUnitHandle(HH,id,21))

call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())

else
if time==0.02 then
call SaveReal(HH,id,11,GetUnitX(caster))
call SaveReal(HH,id,12,GetUnitY(caster))
call UnitSpeed(caster,1)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
call SetUnitModel(n0,"Gaara\\KaruraGaara.mdl")
call UnitSize(n0,3,1,1)
call SetUnitFlyHeight(n0,0,0)
call UnitSpeed(n0,1)
call SetUnitAnimationByIndex(n0,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
call SetUnitModel(n0,"Gaara\\[NL]GaaraEffect_SandBall2.mdl")
call UnitSize(n0,1.5,1,1)
call SetUnitFlyHeight(n0,0,0)
call UnitSpeed(n0,0.5)
call SaveUnitHandle(HH,id,21,n0)
call SetUnitAnimationByIndex(n0,1)
set n0=null
endif
if time==2 or time==4 then
call SetUnitAnimationByIndex(LoadUnitHandle(HH,id,21),1)
endif
if time>0.02 then
call MoveUnit(caster,Dummy,0,facing)
call MoveUnit(caster,LoadUnitHandle(HH,id,21),0,facing)
call SetUnitFacing(Dummy,GetUnitFacing(caster))
call SetUnitFlyHeight(Dummy,GetUnitFlyHeight(caster)+50,0)
call GroupClear(G)
call GroupEnumUnitsInRange(G,GetUnitX(Dummy),GetUnitY(Dummy),500,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if IsUnitAlly(n0,GetOwningPlayer(caster))==true and IsUnitInGroup(n0,gr)==false and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false then
call GroupAddUnit(gr,n0)
call SaveBoolean(HH,GetHandleId(n0),StringHash("GaaraTshield"),true)
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
call SaveGroupHandle(HH,id,4,gr)
call ForGroup(gr,function GaaraTGRangeAct)
endif
endif
set gr=null
set Dummy=null
set caster=null
endfunction

function GaaraQGAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit target=LoadUnitHandle(HH,id,2)
local real facing=Angle2(GetUnitX(caster),GetUnitY(caster),GetUnitX(target),GetUnitY(target))
local real time=LoadReal(HH,id,5)
local unit Dummy=LoadUnitHandle(HH,id,20)
set time=time+0.02
call SaveReal(HH,id,5,time)
if time==2 then
call RemoveUnit(Dummy)

call SaveBoolean(HH,GetHandleId( caster ),StringHash("GaaraGQactB"),false)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())

else

if time==0.02 then
call SetControlToUnit(caster,target,2, "stun")
call UnitSpeed(LoadUnitHandle(HH,id,21),0.5)
call SetUnitFacing(caster,facing)

set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
call SetUnitModel(n0,"Gaara\\[NL]GaaraEffect_SandBall2.mdl")
call UnitSize(n0,0.75,1,1)
call SetUnitFlyHeight(n0,0,0)
call UnitSpeed(n0,1)
call MyRemoveUnit(n0,1)
call SetUnitAnimationByIndex(n0,0)
call UnitAddAbility(target,'Amrf')
call UnitRemoveAbility(target,'Amrf')
call UnitSpeed(caster,0.5)

set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(target),GetUnitY(target),facing)
call SetUnitModel(n0,"Gaara\\[NL]GaaraEffect_SandBall.mdl")
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call UnitSize(n0,1,1,1)
call SetUnitFlyHeight(n0,GetUnitFlyHeight(target),0)
call SaveUnitHandle(HH,id,20,n0)
call SetUnitAnimationByIndex(n0,1)
set n0=null
endif

if time<=0.5 then
call MoveUnit(target,LoadUnitHandle(HH,id,21),0,facing)
call UnitSize(LoadUnitHandle(HH,id,21),1-(time*1.8),1,1)
endif

if time>0 and time<0.2 then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
endif

if time==0.2 then
call UnitSpeed(caster,1)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
endif

if time>0.02 and time<0.5 then
call UnitSize(Dummy,1+(time),1,1)
endif

if time==0.5 then
call UnitSpeed(Dummy,1)
endif

if time>0.5 and time<1 then

call SetUnitFlyHeight(target,GetUnitFlyHeight(target)+25,0)
call SetUnitFlyHeight(Dummy,GetUnitFlyHeight(target)-50,0)
call MoveUnit(target,Dummy,0,facing)
endif

if time==1.5 then
call SetUnitFlyHeight(target,0,GetUnitFlyHeight(target))
endif

if time==1 then
call UnitSpeed(Dummy,2)
call EffectCreateAndMove(true,"Gaara\\File00003933.mdl",facing,1,2,1,100,100,100,0,50,target,0,facing)
call EffectCreateAndMove(true,"Gaara\\bloodex1.mdl",facing,1,2,1,100,100,100,0,50,target,0,facing)
call RemoveUnit(LoadUnitHandle(HH,id,21))

call myCustomDamage(caster, target , LoadReal(HH,id,15) ,false,false,null,null,null)
call SetUnitAnimationByIndex(Dummy,0)
endif

endif

set Dummy=null
set target=null
set caster=null
endfunction







//Gaara GW
function GaaraWGAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=Angle2(GetUnitX(caster),GetUnitY(caster),LoadReal(HH,id,11),LoadReal(HH,id,12))
local real time=LoadReal(HH,id,5)
local real time1=LoadReal(HH,id,6)
local unit Dummy=LoadUnitHandle(HH,id,20)
local real x0=LoadReal(HH,id,11)
local real y0=LoadReal(HH,id,12)
set time=time+0.02
call SaveReal(HH,id,5,time)

if time==4.5 then
call RemoveUnit(Dummy)


call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())

else
if time==0.02 then
call SetUnitFacing(caster,facing)
call UnitSpeed(caster,1)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
call SetUnitModel(n0,"Gaara\\[NL]GaaraEffect_SandBall2.mdl")
call UnitSize(n0,0.75,1,1)
call SetUnitFlyHeight(n0,0,0)
call UnitSpeed(n0,1)
call MyRemoveUnit(n0,1)
call SetUnitAnimationByIndex(n0,1)
call UnitSpeed(caster,1)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',LoadReal(HH,id,11),LoadReal(HH,id,12),facing)
call SetUnitModel(n0,"Gaara\\[NL]GaaraEffect_Pit2.mdl")
call UnitSize(n0,2,1,1)
call SetUnitFlyHeight(n0,0,0)
call UnitSpeed(n0,1.5)
call SaveUnitHandle(HH,id,21,n0)
call SetUnitAnimationByIndex(n0,0)
set n0=null
endif
if time>0 and time<0.2 then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
endif
if time==0.2 then
call UnitSpeed(caster,1)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
endif
if time==0.5 then
call RemoveUnit(LoadUnitHandle(HH,id,21))
set n0=CreateUnit(GetOwningPlayer(caster),'e200',LoadReal(HH,id,11),LoadReal(HH,id,12),facing)
call SetUnitModel(n0,"Gaara\\[NL]GaaraEffect_Pit.mdl")
call UnitSize(n0,2,1,1)
call SaveUnitHandle(HH,id,20,n0)
call UnitSpeed(n0,0.5)
call SetUnitAnimationByIndex(n0,0)
set n0=null
endif
if time>0.5 and time<4.5 then
set time1=time1+0.02
if time1==0.02 then
call DamageAoeOneTime0(caster,x0,y0,550,LoadReal(HH,id,15)*0.1)
set time1=-0.38
endif
call SaveReal(HH,id,6,time1)
call GroupClear(G)
call GroupEnumUnitsInRange(G,x0,y0,550,null)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if IsUnitEnemy(n0,GetOwningPlayer(caster))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false then
if SR(GetUnitX(n0),GetUnitY(n0),x0,y0)>100 then
call MoveUnit(n0,n0,8,Angle2(GetUnitX(n0),GetUnitY(n0),x0,y0))
endif
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
endif
endif
set Dummy=null
set caster=null
endfunction
