function BlackGokuRAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit Dummy=LoadUnitHandle(HH,id,20)
local unit Dummy1=LoadUnitHandle(HH,id,2)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real time1=LoadReal(HH,id,6)
local real timePlus=LoadReal(HH,id,22)
local real damage=LoadReal(HH,id,15)
local real x0=GetUnitX(Dummy)
local real y0=GetUnitY(Dummy)
local real x1=0
local real y1=0
local real distance
local real facing_new=LoadReal(HH, GetHandleId( (GetOwningPlayer( caster )) ), SH_DummyFacing )
set time=time+0.02
set time1=time1+0.02
set distance=LoadReal(HH,id,8)
call SaveReal(HH,id,5,time)
if distance>=2000+timePlus*1000 then
call EffectCreateAndMove(true,"BlackGoku\\HakkeStart2.mdl",GetRandomReal(0,360),1,1.5,1.5,60,60,60,60,0,Dummy,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",GetRandomReal(0,360),1,2.5,1.5,100,100,100,40,0,Dummy,0,facing)
if LoadBoolean(HH,id,19)then
call EffectCreateAndMove(true,"BlackGoku\\bymutou-hongse-pink.mdl",GetRandomReal(0,360),1,1.75,0.6,100,100,100,0,100,Dummy,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\[A]InuyashaExpPink.mdl",GetRandomReal(0,360),1,2,1.5,100,100,100,0,150,Dummy,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\aZ_siwen_Pink.mdl",GetRandomReal(0,360),1,2,0.4,100,100,100,0,150,Dummy,0,facing)
else
call EffectCreateAndMove(true,"BlackGoku\\[A]RinRfire2BlackGoku.mdl",GetRandomReal(0,360),1,1.75,0.6,100,100,100,0,100,Dummy,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\[A]ExplodeorangeBlueBlackGoku.mdl",GetRandomReal(0,360),1,2,1,100,100,100,0,150,Dummy,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\aZ_siwenBlackGoku.mdl",GetRandomReal(0,360),1,2,0.3,100,100,100,0,150,Dummy,0,facing)
endif

set soundplay=SndN(3794) // Sound\Music\mp3Music\SoundJap\BlackGokuR3.mp3
call StartSound(soundplay)
// call KillSoundWhenDone(soundplay)

call UnitSpeed(caster,1)
call DamageAoeOneTime0(caster,x0,y0,500,(LoadReal(HH,id,15)+0.01)*GetHeroAgi(caster,true))
call RemoveUnit(LoadUnitHandle(HH,id,20))
call RemoveUnit(Dummy1)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else

if time==0.02 then

call SaveReal(HH, GetHandleId( (GetOwningPlayer( caster )) ), SH_DummyFacing, facing )

if LoadBoolean(HH,GetHandleId(GetLocalPlayer()), SOUND_LANGUAGE )==true then
set soundplay=SndN(3797) // Sound\Music\mp3Music\SoundEng\BlackGokuR1-1eng.mp3
else
set soundplay=SndN(3800) // Sound\Music\mp3Music\SoundJap\BlackGokuR1-1.mp3
endif

call SetSoundVolume(soundplay,370)
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay)
call SaveSoundHandle(HH,id,24,soundplay)
set soundplay=SndN(3803) // Sound\Music\mp3Music\SoundJap\BlackGokuR1.mp3
call SetSoundVolume(soundplay,370)
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay)
call SaveSoundHandle(HH,id,25,soundplay)
call UnitSpeed(caster,2)
call SetUnitAnimationByIndex(caster,63)
