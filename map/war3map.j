endfunction
function BurningAxelVerXCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local player p=GetOwningPlayer(u)
local integer idu=GetPlayerId(p)
local real x=LoadReal(h,id,3)
local real y=LoadReal(h,id,4)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,8)
local real dmg=(GetHeroAgi(u,true)+GetHeroStr(u,true)+GetHeroInt(u,true))*2
local real Range=LoadReal(h,id,9)
local real speed=LoadReal(h,id,11)
local integer i=0
if Range<2000 and UnitIsAlive(l__d)then
set x1=x1+speed*Cos(a)
set y1=y1+speed*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
call SaveReal(h,id,3,x1)
call SaveReal(h,id,4,y1)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SaveReal(h,id,9,Range+40)
call SaveReal(h,id,11,speed+1)
call GroupEnumUnitsInRange(G,x1,y1,175,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call KillUnit(l__d)
endif
call GroupRemoveUnit(G,E)
endloop
else
call UnitApplyTimedLife(CreateUnit(p,'e00N',x,y,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e067',x,y,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e06O',x,y,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0B9',x,y,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0IK',x,y,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0IL',x,y,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0IJ',x,y,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0IM',x,y,GetRandomReal(0,359)),'BTLF',1.5)
call UnitApplyTimedLife(CreateUnit(p,'e0IN',x,y,GetRandomReal(0,359)),'BTLF',3)
call GroupEnumUnitsInRange(G,x,y,500,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 0.2, "stun")
endif
call GroupRemoveUnit(G,E)
endloop
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
endif
set u=null
set p=null
set t=null
set l__d=null
endfunction
function CastBurningAxelVerX takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
call UnitAddAbility(u, 'PV01')
call UnitMakeAbilityPermanent(u, true, 'PV01')
call UnitRemoveAbilityTimedPause(u, 'PV01', 6.0)
call CreateModeIndicatorWithPauseForm(u, "war3mapImported\\BTNXGlovesVerX.blp", 6)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,8,a)
call SaveReal(h,id,11,50)
set n=CreateUnit(GetOwningPlayer(u),'e0RB',x,y,a*bj_RADTODEG)
call SetUnitScale(n,3,3,3)
call SaveUnitHandle(h,id,1,n)
set x=x+80*Cos(a)
set y=y+80*Sin(a)
set n=CreateUnit(p,'e0IH',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.25)
set n=CreateUnit(p,'e0IO',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,1.5)
set n=CreateUnit(p,'e0IG',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.5)
call SetUnitScale(n,2.5,2.5,2.5)
set n=CreateUnit(p,'e0IG',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.5)
call SetUnitScale(n,3.5,3.5,3.5)
set n=CreateUnit(p,'e0IG',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.5)
call SetUnitScale(n,5,5,5)
set n=CreateUnit(p,'e0IG',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.5)
call SetUnitScale(n,6.5,6.5,6.5)
set n=CreateUnit(p,'e0II',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.25)
call TimerStart(t,0.03,true,function BurningAxelVerXCast2)
set u=null
set p=null
set t=null
endfunction
