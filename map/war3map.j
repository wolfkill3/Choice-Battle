function LiCloneEffect2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local real time=LoadReal(h,id,1)
local unit u=LoadUnitHandle(h,id,0)
local real sc=LoadReal(h,id,2)
local real nsc=LoadReal(h,id,3)
local integer al=LoadInteger(h,id,4)
local integer nal=LoadInteger(h,id,5)
if time>0 then
call SaveReal(h,id,1,time-0.02)
call SetUnitScale(u,sc+nsc,sc+nsc,sc+nsc)
call SaveReal(h,id,2,sc+nsc)
call SetUnitVertexColor(u,255,255,255,al)
call SaveInteger(h,id,4,al-nal)
else
call RemoveUnit(u)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set t=null
endfunction
function LiCloneEffect takes unit u,real time,real sc1,real sc2,integer alpha returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real a=0.02*(sc2-sc1)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,time)
call SaveReal(h,id,2,sc1)
call SaveReal(h,id,3,a/time)
call SaveInteger(h,id,4,alpha)
call SaveInteger(h,id,5,R2I(0.02*(I2R(alpha)/time)))
call SetUnitVertexColor(u,255,255,255,alpha)
call TimerStart(t,0.02,true,function LiCloneEffect2)
set t=null
endfunction
function TLiCast7 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit c=LoadUnitHandle(h,id,1)
local unit u=LoadUnitHandle(h,id,0)
local real time=LoadReal(h,id,2)-0.05
local real time2=LoadReal(h,id,3)-0.05
local real time3=LoadReal(h,id,6)-0.05
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
if time>0 then
call SaveReal(h,id,2,time)
call SaveReal(h,id,3,time2)
call SaveReal(h,id,6,time3)
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitTimeScale(u,1+(3.55-time3)/10)
if time2<0 then
set n=CreateUnit(p,'e125',x,y,a*bj_RADTODEG)
call LiCloneEffect(n,0.8,1.15,1.8-(3.55-time3)/5,100)
call SetUnitAnimationPerTime(n,3.55-time3,"Spell Slam Two",1+(3.55-time3)/10)
call SaveReal(h,id,3,0.25)
endif
else
call UnitApplyTimedLife(CreateUnit(p,'e0RH',x1,y1,(a*bj_RADTODEG)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0RK',x1,y1,(a*bj_RADTODEG)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0RN',x1,y1,(a*bj_RADTODEG)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0XQ',x1,y1,(a*bj_RADTODEG)),1,4)
set n=CreateUnit(p,'e0RO',x1+100*Cos(a),y1+100*Sin(a),(a*bj_RADTODEG))
