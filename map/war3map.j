function QKiyoMissles2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local unit u=LoadUnitHandle(h,id,10)
local real speed=LoadReal(h,id,1)
local real f=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real a=LoadReal(h,id,5)
local real dist=LoadReal(h,id,7)
local real sc=LoadReal(h,id,9)
local real dmg=GetHeroStr(u,true)*(0.2+GetUnitAbilityLevel(u,'Ao7A')*0.2)
local group g=LoadGroupHandle(h,id,11)
if dist>speed and l__d!=null then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SaveReal(h,id,7,dist-speed)
if SR(x,y,GetUnitX(u),GetUnitY(u))<300 then
set dmg=dmg/5
endif
if sc<2.3 then
call SaveReal(h,id,9,sc+LoadReal(h,id,8))
endif
call SetUnitScale(l__d,sc,sc,sc)
call GroupEnumUnitsInRange(g,x,y,100,Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(GetOwningPlayer(u),E) and E!=LoadUnitHandle(h,idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
else
call KillUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,idg)
call DestroyGroup(g)
endif
set u=null
set l__d=null
set t=null
    set g=null
endfunction
function QKiyoMissles takes unit l__d,real speed,real a,real dist,real sct,real sidg, unit u returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,GetUnitFlyHeight(l__d))
call SaveReal(h,id,3,GetUnitX(l__d))
call SaveReal(h,id,4,GetUnitY(l__d))
call SaveReal(h,id,5,a)
call SaveReal(h,id,7,dist)
call SaveReal(h,id,8,sidg)
call SaveReal(h,id,9,sct)
call SaveUnitHandle(h,id,10,u)
call SaveGroupHandle(h,id,11,CreateGroup())
call TimerStart(t,0.014,true,function QKiyoMissles2)
set t=null
endfunction
function QKiyoCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real dist=LoadReal(h,id,1)+25
local real a2=LoadReal(h,id,3)
local real a=LoadReal(h,id,2)+a2
local boolean b=LoadBoolean(h,id,4)
local player p=GetOwningPlayer(u)
if dist>0 then
call SaveReal(h,id,1,dist)
call SetUnitFacing(u,a*bj_RADTODEG)
if a2<35*bj_DEGTORAD and a2>=0*bj_DEGTORAD and b==false then
call SaveReal(h,id,3,a2+0.07)
elseif a2>35*bj_DEGTORAD and b==false then
call SaveBoolean(h,id,4,true)
elseif a2>-35*bj_DEGTORAD and b==true then
call SaveReal(h,id,3,a2-0.07)
elseif a2<-35*bj_DEGTORAD and b==true then
call SaveBoolean(h,id,4,false)
elseif a2<-1*bj_DEGTORAD and b==false then
call SaveReal(h,id,3,a2+0.07)
elseif a2>-1*bj_DEGTORAD and a2<0*bj_DEGTORAD and b==false then
call SaveReal(h,id,1,-100)
endif
call QKiyoMissles(CreateUnit(p,'eo9C',x+25*Cos(a),y+25*Sin(a),a*bj_RADTODEG),25,a,dist,0.7,0.04,u)
else
call SetUnitAnimationByIndex(u,8)
call SetUnitTimeScale(u,1)
call UnitRemoveAbility(u,'Ao4G')
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
endif
set p=null
set u=null
set t=null
endfunction
