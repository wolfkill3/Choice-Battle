endfunction
function CastLuckyBox takes nothing returns nothing
local integer r=GetRandomInt(1,250)
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
call UnitRemoveItem(u,GetManipulatedItem())
set ite=UnitAddItemById(u,score[r])
if r==98 then
call SetItemCharges(ite,3)
endif
if ite==null then
set soundplay=SndN(814) // LeeroyJenkins.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call DestroyEffect(AddSpecialEffect(" ",x,y))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Items\\AIam\\AIamTarget.mdl",x,y))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Resurrect\\ResurrectCaster.mdl",x,y))
set u=null
endfunction
