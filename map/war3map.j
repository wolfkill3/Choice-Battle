function NullFieldCast takes nothing returns nothing
local timer t=CreateTimer()
local unit u=GetTriggerUnit()
local unit l__d=GetSpellTargetUnit()
local integer id=GetHandleId(t)
local integer idd=GetHandleId(l__d)
call SaveUnitHandle(h,id,1,l__d)
call SaveUnitHandle(h,id,0,u)
call UnitAddAbility(l__d,'A10G')
call UnitMakeAbilityPermanent(l__d,true,'A10G')
call SaveReal(h,idd,SH_lnf1,(GetUnitAbilityLevel(u,'A10F')*2)*GetHeroInt(u,true)+100)
call SaveReal(h,idd,SH_lnf3,(GetUnitAbilityLevel(u,'A10F')*2)*GetHeroInt(u,true)+100)
call SaveUnitHandle(h,idd,SH_lnf2,u)
// длительность щита в статус-баре (снимается на 8+ур. тике секундного таймера)
call CreateModeIndicatorFormDispellable(l__d, "war3mapImported\\BTNLouiseNullField.blp", 8+GetUnitAbilityLevel(u,'A10F'), 'A10G')
if GetUnitTypeId(GetTriggerUnit())=='H053' then
set soundplay=SndN(2214) // Sound\Music\mp3Music\LouiseLightning.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
set soundplay=SndN(2216) // Sound\Music\mp3Music\WMomonga.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call TimerStart(t,1,true,function NullFieldCast2)
set t=null
set u=null
set l__d=null
endfunction
