function QWaverCast4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real dmg=GetHeroInt(u,true)*6
local real x=LoadReal(h,id,4)
local real y=LoadReal(h,id,5)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real sc=LoadReal(h,id,7)
local real a=LoadReal(h,id,3)
local real dist=LoadReal(h,id,2)
local group g=LoadGroupHandle(h,id,6)
local player p=GetOwningPlayer(u)
if dist<2000 then
set x=x+dist*Cos(a)
set y=y+dist*Sin(a)
call SaveReal(h,id,2,dist+100)
set n=CreateUnit(p,'eo5T',x,y,a*bj_RADTODEG)
call SetUnitTimeScale(n,2)
call SetUnitScale(n,sc,sc,sc)
call UnitApplyTimedLife(n,1,0.3)
if LoadInteger(h,id,8)==1 then
set n=CreateUnit(p,'eo5T',x+125*Cos(a+deg90),y+125*Sin(a+deg90),a*bj_RADTODEG)
call SetUnitTimeScale(n,2)
call SetUnitFlyHeight(n,175,0)
call SetUnitScale(n,sc,sc,sc)
call UnitApplyTimedLife(n,1,0.3)
set n=CreateUnit(p,'eo5T',x-155*Cos(a+deg90),y-155*Cos(a+deg90),a*bj_RADTODEG)
call SetUnitTimeScale(n,2)
call SetUnitFlyHeight(n,75,0)
call SetUnitScale(n,sc,sc,sc)
call UnitApplyTimedLife(n,1,0.3)
endif
call SaveReal(h,id,7,sc+0.0075)
call GroupEnumUnitsInRange(G,x,y,300,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call GroupAddUnit(g,E)
endif
call GroupRemoveUnit(G,E)
endloop
else
loop
set E=FirstOfGroup(g)
exitwhen E==null
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\OrbOfFire.mdx",E,"chest"))
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call GroupRemoveUnit(g,E)
if GetUnitAbilityLevel(E,'Ao56')>0 and LoadInteger(h,id,8)!=1 then
call SaveInteger(h,id,8,1)
elseif LoadInteger(h,id,8)==1 then
call SaveInteger(h,id,8,2)
endif
endloop
call SetUnitTimeScale(u,1)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set u=null
set p=null
set t=null
endfunction
