function CondRounds takes nothing returns boolean
return Rounds==false and ValidHLC()==false
endfunction
function CastRounds1 takes nothing returns nothing
local integer str=S2I(SubString(GetEventPlayerChatString(),8,10))
local integer i
if str<50 and str>1 then
set Rounds=true
set udg_rou=I2R(str)
call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,Lng("Для победы, одной из команд достаточно выйграть |cFFFF0000","To win, one team only needs to win |cFFFF0000")+I2S(str)+Lng("|r раз!","|r times!"))
set i=0
loop
exitwhen i>9
call W3MMD_Lite_Set_Integer(Player(i),"Rounds_to_win",str)
set i=i+1
endloop
endif
endfunction
function RoundsInit takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterPlayerChatEvent(t,Player(0),"-rounds ",false)
call TriggerAddAction(t,function CastRounds1)
call TriggerAddCondition(t,Condition(function CondRounds))
set t=null
endfunction
