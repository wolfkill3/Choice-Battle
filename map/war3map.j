set gg_trg_PartyTable=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_PartyTable,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_PartyTable,Condition(function Trig_PartyTable_Conditions))
call TriggerAddAction(gg_trg_PartyTable,function PartyTableCast)
endfunction
function FlamebageShotCond takes nothing returns boolean
return GetSpellAbilityId()==0x41305234 and udg_B==true
endfunction
function FlamebageShotMissleFly2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local unit d1=LoadUnitHandle(h,id,9)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=angle
local real dist=LoadReal(h,id,6)
local real mh=LoadReal(h,id,5)
local real rad=LoadReal(h,id,7)
local real rd=SR(x,y,x1,y1)
local player p=GetOwningPlayer(d1)
local integer idu=GetPlayerId(p)
local real range=LoadReal(h,id,9)
local real dmg=(GetUnitAbilityLevel(Hero[idu],0x41305234)+3)*GetHeroAgi(Hero[idu],true)
local real cof=rd/dist
if rd>speed+30 and udg_B==true and UnitIsAlive(l__d)and range>0 then
set n=CreateUnit(p,0x6530504B,x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'B000',1)
call SetUnitFlyHeight(n,mh*cof,0)
set x=x+speed*Cos(a)
set y=y+speed*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SaveReal(h,id,1,speed*1.02)
call SaveReal(h,id,9,range-speed*1.02)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,mh*cof,0)
call SetUnitX(d1,x)
call SetUnitY(d1,y)
call SetUnitFacing(d1,a*bj_RADTODEG)
call SetUnitFlyHeight(d1,mh*cof,0)
if (range >= 475 and range < 500) or UnitIsAlive(l__d)==false then
    call PauseUnit(Hero[idu],false)
endif
else
if GetUnitAbilityLevel(Hero[idu],'A0O1')>0 then
set dmg=dmg+1.5*GetHeroAgi(Hero[idu],true)
endif
if UnitIsAlive(l__d)==false then
    call PauseUnit(Hero[idu],false)
endif
call PauseUnit(l__d,false)
call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,false)
call myCustomDamage(Hero[idu],l__d,dmg,false,false,null,null,null)
call SetControlToUnit(Hero[idu],l__d,1,"stun")
call ShakeCamera(0.5,20)
call StartSound(soundStr[47])
call UnitApplyTimedLife(CreateUnit(p,'e0NJ',x,y,GetRandomReal(0,359)),1,3)
//call UnitApplyTimedLife(CreateUnit(p,'e0NK',x,y,GetRandomReal(0,359)),1,6)
call UnitApplyTimedLife(CreateUnit(p,'e0NI',x,y,GetRandomReal(0,359)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0NL',x,y,GetRandomReal(0,359)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0NM',x,y,GetRandomReal(0,359)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0MI',x,y,GetRandomReal(0,359)),1,1)
call SetUnitFlyHeight(l__d,0,0)
call RemoveUnit(d1)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set d1=null
set p=null
set l__d=null
set t=null
endfunction
function FlamebageShotMissleFly takes unit l__d,unit d1,real speed,real angle,real x,real y,real mh,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveUnitHandle(h,id,9,d1)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,mh)
call SaveReal(h,id,6,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,8,dmg)
call SaveReal(h,id,9,600)
call TimerStart(t,0.03,true,function FlamebageShotMissleFly2)
set t=null
endfunction
function FlamebageShotCast3 takes nothing returns nothing //ESan
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=LoadReal(h,id,15)
local player p=GetOwningPlayer(u)
local real fh=GetUnitFlyHeight(c)+40
local real time=LoadReal(h,id,16)
if time<600 and UnitIsAlive(c) then
call SetUnitXY_1(c,x+75*Cos(a),y+75*Sin(a), false)
call SetUnitFlyHeight(c,fh,0)
call SetUnitFlyHeight(u,fh,0)
set n=CreateUnit(p,0x65304D43,x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'B000',0.70)
call SetUnitFlyHeight(n,fh,0)
call SetUnitAnimation(u,"attack")
call SaveReal(h,id,16,time+40)
call PauseUnit(u,true)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
else
call UnitRemoveAbility(c,'A0QL')
if GetUnitAbilityLevel(u,'A0O1')==2 then
    call SetUnitAbilityLevel(u,'A0O1',1)
    call UnitMakeAbilityPermanent(u,true,'A0O1')
    elseif GetUnitAbilityLevel(u,'A0O1')==1 then
    call UnitRemoveAbility(u,'A0O1')
    call UnitMakeAbilityPermanent(u,false,'A0O1')
endif
if UnitIsAlive(c)==false then
    call PauseUnit(u,false)
endif
set n=CreateUnit(p,'e0MY',x,y,GetRandomReal(0,359))
call FlamebageShotMissleFly(c,n,25,a,x1+1000*Cos(a),y1+1000*Sin(a),700,0)
set n=CreateUnit(p,'e0ME',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,1)
call SetUnitFlyHeight(n,GetUnitFlyHeight(c),0)
call SetUnitAnimation(u,"Spell Four")
call SetUnitFlyHeight(u,0,600)
call SetUnitInvulnerable(u,false)
call SetUnitInvulnerable(c,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function FlamebageShotCast takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real f=GetUnitFacing(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call PauseUnit(u,true)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call SetUnitInvulnerable(u,true)
call SetUnitInvulnerable(c,true)
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveReal(h,id,7,0)
call SaveReal(h,id,15,a)
call SaveReal(h,id,16,0)
call SetUnitX(u,x1-75*Cos(a))
call SetUnitY(u,y1-75*Sin(a))
call UnitAddAbility(c,'A0QL')
call UnitAddAbility(c,'Arav')
call UnitRemoveAbility(c,'Arav')
call UnitAddAbility(u,'Arav')
call UnitRemoveAbility(u,'Arav')
call UnitAddAbility(u,0x41304F38)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\FlambageShot.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.15,true,function FlamebageShotCast3)
else
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitTimeScale(u,1)
call SetUnitInvulnerable(u,false)
call SetUnitPathing(u,true)
call PauseUnit(u,false)
call FlushChildHashtable(h,id)
call SetUnitInvulnerable(u,false)
call SetUnitX(u,x1-75*Cos(a))
call SetUnitY(u,y1-75*Sin(a))
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
if GetUnitAbilityLevel(u,'A0O1')==2 then
call SetUnitAbilityLevel(u,'A0O1',1)
call UnitMakeAbilityPermanent(u,true,'A0O1')
elseif GetUnitAbilityLevel(u,'A0O1')==1 then
call UnitRemoveAbility(u,'A0O1')
call UnitMakeAbilityPermanent(u,false,'A0O1')
endif
endif
set u=null
set t=null
set p=null
set c=null
set n=null
endfunction
