call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",facing,1.5,0.8+0.006*LoadInteger(HH,id,17),1,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\WindNewFaw4.mdl",facing,1.5,0.6+0.0045*LoadInteger(HH,id,17),0.75,100,100,100,0,0,caster,0,facing)
