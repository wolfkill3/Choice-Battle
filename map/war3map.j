local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local effect e
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,3,CreateGroup())
call SaveReal(h,id,4,a)
//call SetUnitInvulnerable(u,true)
call SaveReal(h,id,10,2500)
call PauseUnit(u,true)
call SetUnitTimeScale(u,0.7)
set soundplay=SndN(2516) // Sound\Music\mp3Music\Whitebeard1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SetUnitAnimation(u,"Spell Three")
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\dash sfx.mdl",u,"origin"))
call SaveEffectHandle(h,id,5,AddSpecialEffectTarget("GuraGuraAttack.mdx",u,"left hand"))
call TimerStart(t,0.025,true,function CastGekishin2)
set u=null
set e=null
set p=null
set t=null
endfunction
