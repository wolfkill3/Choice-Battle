endfunction
function OrochimaruF2Cond takes nothing returns boolean
    return GetUnitAbilityLevel(GetTriggerUnit(),'ore3')>0 and GetSpellAbilityId()!='A16E' and GetSpellAbilityId()!='A1AA' and GetSpellAbilityId()!='A1AB' and GetSpellAbilityId()!='A11E' and GetSpellAbilityId()!='A11D' and GetSpellAbilityId()!='A11F' and GetSpellAbilityId()!='A0N1' and GetSpellAbilityId()!='A0N2' and GetSpellAbilityId()!='A0A2' and GetSpellAbilityId()!='A0EH' and GetSpellAbilityId()!='A0UG' and GetSpellAbilityId()!='AaS0' and GetSpellAbilityId()!='A1I3'  and GetSpellAbilityId()!='A0X6'  and GetSpellAbilityId()!='A0B3'
endfunction
function OrochimaruF2Cast takes nothing returns nothing
    local unit u=GetTriggerUnit()
    local real mh=GetUnitState(u,UNIT_STATE_MAX_LIFE)
    local real mm=GetUnitState(u,UNIT_STATE_MAX_MANA)
    local real m=GetUnitState(u,UNIT_STATE_MANA)
    local real l__h=GetUnitState(u,UNIT_STATE_LIFE)
    local real dmg=mh*0.025
    if GetUnitAbilityLevel(u,'OM17')<1 then
        call AddSpecialEffectToAllBones(u,"Abilities\\Spells\\Other\\BlackArrow\\BlackArrowMissile.mdl")
        if GetUnitAbilityLevel(u,'ore5')>0 then
        set dmg=dmg*1.5
        call SetUnitState(u,UNIT_STATE_MANA,m-mm*0.025)
        endif
        if dmg<l__h then
        call SetUnitState(u,UNIT_STATE_LIFE,l__h-dmg)
        else
        call SetUnitState(u,UNIT_STATE_LIFE,1)
        endif
        call SetUnitState(u,UNIT_STATE_MANA,m-mm*0.0125)
    endif
    set u=null
endfunction
function InitTrig_OrochimaruF2 takes nothing returns nothing
    set gg_trg_OrochimaruF2=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_OrochimaruF2,EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_OrochimaruF2,Condition(function OrochimaruF2Cond))
    call TriggerAddAction(gg_trg_OrochimaruF2,function OrochimaruF2Cast)
endfunction
function OrochimaruFCond takes nothing returns boolean
    return GetSpellAbilityId()=='OM13'
endfunction
function OrochimaruFCast3 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit c=LoadUnitHandle(h,id,1)
    local unit l__d=LoadUnitHandle(h,id,12)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetUnitX(c)
    local real dmg=GetHeroInt(u,true)*3
    local real y1=GetUnitY(c)
    local real a=Atan2(y1-y,x1-x)
    local player p=GetOwningPlayer(u)
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\OrbOfDeath\\AnnihilationMissile.mdl",c,"chest"))
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\OrbOfDeath\\AnnihilationMissile.mdl",c,"head"))
    call UnitAddAbility(c,'ore4')
    call UnitMakeAbilityPermanent(c,true,'ore4')
    call UnitRemoveAbilityTimed(c,'ore4',1.5)
    if GetUnitAbilityLevel(c,'ore3')==0 and IsUnitIllusion(c)==false then
    call UnitAddAbility(c,'ore3')
    call UpdateClassBar(c)
    call UnitMakeAbilityPermanent(c,true,'ore3')
    endif
    if GetUnitTypeId(c)=='H057' or GetUnitTypeId(c)=='H00E' then
        call UnitAddAbility(c,'OM17')
        call UnitMakeAbilityPermanent(c,true,'OM17')
    endif
    call PauseUnit(u,false)
    call PauseUnit(c,false)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
    call SetUnitInvulnerable(u,false)
    call myCustomDamage(u,c,dmg,false,false,null,null,null)
    call SetControlToUnit(u,c,1,"stun")
    call UnitApplyTimedLife(l__d,'BTLF',0.2)
    call SetUnitVertexColor(u,255,255,255,255)
    call SetUnitTimeScale(u,1)
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(h,id)
    set p=null
    set l__d=null
    set u=null
    set c=null
    set t=null
endfunction
function OrochimaruFCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit c=LoadUnitHandle(h,id,1)
    local unit l__d=LoadUnitHandle(h,id,12)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetUnitX(c)
    local real y1=GetUnitY(c)
    local real a=Atan2(y1-y,x1-x)
    local real time=LoadReal(h,id,2)+0.03
    local real rd=LoadReal(h,id,3)
    local real f=GetUnitFacing(u)
    local player p=GetOwningPlayer(u)
    if SR(x,y,x1,y1)>150 then
        set x=x+40*Cos(a+rd)
        set y=y+40*Sin(a+rd)
        call SetUnitXY_1(u,x,y, false)
        call SetUnitX(l__d,x)
        call SetUnitY(l__d,y)
        call SaveReal(h,id,2,time)
        if time>0.35 then
            call SaveReal(h,id,2,0)
            call SaveReal(h,id,3,rd*(-1))
        endif
        call PauseUnit(u,true)
        call SetUnitInvulnerable(u,true)
        call SetUnitFacing(l__d,a*bj_RADTODEG)
        set n=CreateUnit(p,'or00',x,y,f)
        call SetUnitAnimationByIndex(n,12)
        call SetUnitVertexColor(n,255,255,255,125)
        call UnitApplyTimedLife(n,'BTLF',0.2)
        set n=CreateUnit(p,'eo0N',x,y,a*bj_RADTODEG)
        call SetUnitVertexColor(n,255,255,255,75)
        call UnitApplyTimedLife(n,'BTLF',0.2)
    else
        if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
            call UnitRemoveAbility(l__d,'ore2')
            call SetUnitTimeScale(l__d,1)
            call PauseUnit(c,true)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
            call SetUnitAnimationByIndex(l__d,25)
            call PauseTimer(t)
            call TimerStart(t,0.75,false,function OrochimaruFCast3)
        else
            call UnitApplyTimedLife(l__d,'BTLF',0.05)
            call PauseUnit(u,false)
            call PauseUnit(c,false)
            call SetUnitTimeScale(u,1)
            call SetUnitTimeScale(c,1)
            call SetUnitPathing(u,true)
            call SetUnitPathing(c,true)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
            call SetUnitInvulnerable(u,false)
            call SetUnitInvulnerable(c,false)
            call SetUnitVertexColor(u,255,255,255,255)
            call PauseTimer(t)
            call SetUnitFlyHeight(u,0,0)
            call DestroyTimer(t)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
            call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
            call FlushChildHashtable(h,id)
        endif
    endif
    set l__d=null
    set p=null
    set u=null
    set c=null
    set t=null
endfunction
function OrochimaruFCast takes nothing returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local unit u=GetTriggerUnit()
    local unit c=GetSpellTargetUnit()
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real f=GetUnitFacing(u)
    local player p=GetOwningPlayer(u)
    set soundplay=SndN(4787) // Sound\Music\mp3Music\OrochimaruF.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call SaveUnitHandle(h,id,0,u)
    call SaveUnitHandle(h,id,1,c)
    call SaveReal(h,id,2,0)
    call SaveReal(h,id,3,0.3)
    call SetUnitVertexColor(u,255,255,255,0)
    set n=CreateUnit(p,'or00',x,y,f)
    call SetUnitAnimationByIndex(n,12)
    call SetUnitVertexColor(n,255,255,255,255)
    call SaveUnitHandle(h,id,12,n)
    call UnitAddAbility(n,'ore2')
    call UnitApplyTimedLife(n,'BTLF',35)
    call PauseUnit(u,true)
    call SetUnitInvulnerable(u,true)
    call SetUnitAnimationByIndex(u,12)
    call SetUnitTimeScale(u,2)
    call TimerStart(t,0.03,true,function OrochimaruFCast2)
    set u=null
    set p=null
    set t=null
    set c=null
endfunction
function InitTrig_OrochimaruF takes nothing returns nothing
    set gg_trg_OrochimaruF=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_OrochimaruF,EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_OrochimaruF,Condition(function OrochimaruFCond))
    call TriggerAddAction(gg_trg_OrochimaruF,function OrochimaruFCast)
endfunction
function OrochimaruQCond takes nothing returns boolean
    return GetSpellAbilityId()=='ore7'
endfunction
function OrochimaruQCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local real dmg=60+GetHeroInt(u,true)*(GetUnitAbilityLevel(u,'ore7')+1)
    local real x=LoadReal(h,id,4)
    local real y=LoadReal(h,id,5)
    local real a=LoadReal(h,id,3)
    local real dist=LoadReal(h,id,2)
    local real sc1=LoadReal(h,id,6)
    local real sc2=LoadReal(h,id,7)
    local real rad=LoadReal(h,id,8)
    local real per=LoadReal(h,id,9)
    local real he=LoadReal(h,id,10)
    local group g=LoadGroupHandle(h,id,11)
    local real k=1.15
    local player p=GetOwningPlayer(u)
    if dist<2000 then
    set x=x+per*Cos(a)
    set y=y+per*Sin(a)
    call SaveReal(h,id,4,x)
    call SaveReal(h,id,5,y)
    call SaveReal(h,id,2,dist+per)
    call SaveReal(h,id,6,sc1*k)
    call SaveReal(h,id,7,sc2*k)
    call SaveReal(h,id,8,rad*1.12)
    call SaveReal(h,id,9,per*k)
    call SaveReal(h,id,10,he*k)
    if dist<1700 then
    set n=CreateUnit(p,'or05',x,y,a*bj_RADTODEG)
    call SetUnitVertexColor(n,255,255,255,35)
    call SetUnitFlyHeight(n,he,0)
    call SetUnitScale(n,sc1,sc1,sc1)
    call UnitApplyTimedLife(n,'BTLF',0.3)
    endif
    set n=CreateUnit(p,'or06',x,y,a*bj_RADTODEG)
    call SetUnitVertexColor(n,255,255,255,125)
    call SetUnitFlyHeight(n,he,0)
    call SetUnitTimeScale(n,3)
    call SetUnitScale(n,sc2,sc2,sc2)
    call UnitApplyTimedLife(n,'BTLF',0.3)
    call GroupEnumUnitsInRange(g,x,y,rad,Base)
    set idg=GetHandleId(g)
    loop
    set E=FirstOfGroup(g)
    set ide=GetHandleId(E)
    exitwhen E==null
    if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
    call myCustomDamage(u,E,dmg,false,false,null,null,null)
    call SaveUnitHandle(h,idg,ide,E)
    endif
    call GroupRemoveUnit(g,E)
    endloop
    elseif dist>2000 then
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(h,id)
    call FlushChildHashtable(h,idg)
    call DestroyGroup(g)
    endif
    set u=null
    set p=null
    set t=null
    set g=null
endfunction
function OrochimaruQCast takes nothing returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local unit u=GetTriggerUnit()
    local player p=GetOwningPlayer(u)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetSpellTargetX()
    local real y1=GetSpellTargetY()
    local real a=Atan2(y1-y,x1-x)
    call SaveUnitHandle(h,id,0,u)
    call SaveReal(h,id,2,0)
    call SaveReal(h,id,3,a)
    call SaveReal(h,id,4,x+75*Cos(a))
    call SaveReal(h,id,5,y+75*Sin(a))
    call SaveReal(h,id,6,0.6)
    call SaveReal(h,id,7,0.2)
    call SaveReal(h,id,8,125)
    call SaveReal(h,id,9,50)
    call SaveReal(h,id,10,75)
    call DestroyEffect(AddSpecialEffect("war3mapImported\\by_wood_effect_yuanbanlin_sand2.mdx",x,y))
    set n=CreateUnit(p,'e21N',x,y,a*bj_RADTODEG-45)
    call SetUnitVertexColor(n,255,255,255,155)
    call UnitApplyTimedLife(n,'BTLF',0.4)
    call SetUnitTimeScale(n,3)
    set n=CreateUnit(p,'e21N',x,y,a*bj_RADTODEG+45)
    call SetUnitVertexColor(n,255,255,255,155)
    call UnitApplyTimedLife(n,'BTLF',0.4)
    call SetUnitTimeScale(n,3)
    set n=CreateUnit(p,'e21N',x,y,a*bj_RADTODEG)
    call SetUnitVertexColor(n,255,255,255,155)
    call UnitApplyTimedLife(n,'BTLF',0.4)
    call SetUnitTimeScale(n,3)
    set soundplay=SndN(4789) // Sound\Music\mp3Music\OrochimaruQ.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call SaveGroupHandle(h,id,11,CreateGroup())
    call TimerStart(t,0.05,true,function OrochimaruQCast2)
    set u=null
    set p=null
    set t=null
endfunction
