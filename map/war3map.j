                                call UnitRemoveAbility(LoadUnitHandle(HH,id_target,StringHash("GinT_Indicator")),'A0A1')
                        endif
                endif
        else
                call RemoveUnit(LoadUnitHandle(HH, id_target, StringHash("GinT_Indicator")))
