set soundplay=CreateSound("Sound\\Music\\mp3Music\\DrakeW.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
set sc=0.5
call SetUnitAnimation(u,"Spell four")
endif
loop
exitwhen i>=2+GetUnitAbilityLevel(u,0x41304337)
set n=CreateUnit(p,iud,x,y,a*bj_RADTODEG)
call SetUnitScale(n,sc,sc,sc)
call SanzuReverShootFly(n,GetRandomReal(55,65),GetRandomReal(-1.6,1.6),x1,y1,GetRandomReal(25,300),200,GetHeroAgi(u,true))
set i=i+1
endloop
set u=null
set p=null
endfunction
