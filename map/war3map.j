return GetSpellAbilityId()=='A0DF'
endfunction
function NormalShotCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local real x2
local real y2
local real r=GetRandomReal(-50,50)
local real angle=(GetUnitFacing(u)+90)*bj_DEGTORAD
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local integer time=LoadInteger(h,id,5)
local real dmg=LoadReal(h,id,11)
// if GetUnitAbilityLevel(u,'A28U')>0 and GetUnitState(u,UNIT_STATE_LIFE)<=GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.25 then
// set dmg=dmg+dmg*.2
// else
if GetUnitAbilityLevel(u,'A28U')>0 then
set dmg=dmg+dmg*.1
endif
if GetUnitCurrentOrder(u)==OrderId("drain")then
set x2=x+r*Cos(angle)
set y2=y+r*Sin(angle)
call Slash_Dante(CreateUnit(p,'h01U',x2,y2,a*bj_RADTODEG),65,dmg,a,1800,30,x2,y2,x1,y1,false)
call SaveInteger(h,id,5,time+3)
else
call StopSound(LoadSoundHandle(h,id,16),false,true) // звук из массива — останавливаем, не удаляем
set soundplay=SndN(1117) // Sound\Music\mp3Music\EffectQQ2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SetUnitInvulnerable(u,false)
call AddUnitAnimationProperties(u,"alternate",true)
call RemoveUnit(LoadUnitHandle(h,id,10))
call SaveInteger(HH,GetHandleId(u),ROYAL_GUARD_STACKS,0)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set t=null
endfunction
function NormalShotCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real f=Atan2(y1-y,x1-x)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,10,CreateUnit(GetOwningPlayer(u),'h01T',GetUnitX(u)+100*Cos(f),GetUnitY(u)+100*Sin(f),f*bj_RADTODEG))
call SetUnitInvulnerable(u,true)
call SaveReal(h,id,2,x1)
call SaveReal(h,id,3,y1)
call SaveReal(h,id,11,GetHeroStr(u,true)*(0.25+0.05*GetUnitAbilityLevel(u,'A0DF'))*(1+0.1*LoadInteger(HH,GetHandleId(u),ROYAL_GUARD_STACKS)))
call SetUnitAnimationByIndex(u,9)
set soundplay=SndN(1120) // Sound\Music\mp3Music\EffectQQ.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay)
call SaveSoundHandle(h,id,16,soundplay)
if GetUnitTypeId(u)=='H01N' then
set soundplay=SndN(1122) // Sound\Music\mp3Music\DanteQQ.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
elseif GetUnitTypeId(u)=='H21N' then
set soundplay=SndN(1124) // Sound\Music\mp3Music\DTDanteQQ.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call TimerStart(t,0.025,true,function NormalShotCast2)
set u=null
set t=null
endfunction
