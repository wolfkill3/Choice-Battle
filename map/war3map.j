local real y=GetUnitY(u)
local real x1=LoadReal(h,id,8)
local real y1=LoadReal(h,id,9)
local real x2=0
local real y2=0
local real a=Atan2(y1-y,x1-x)
local real a2
local real time=LoadReal(h,id,7)+0.1
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,11)
local group g2=LoadGroupHandle(h,id,12)
local group g3
local real sc=0
local real dmg=GetHeroInt(u,true)*12
set idg=GetHandleId(g)
if time<4 then
set g3=CopyGroup(g2)
loop
set E=FirstOfGroup(g3)
exitwhen E==null
call SetUnitPosition(E,x1,y1)
call PauseUnit(E,true)
call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,true)
call SetUnitInvulnerable(E,true)
call GroupRemoveUnit(g3,E)
endloop
call DestroyGroupTimed(g3,3)
call SaveReal(h,id,7,time)
else
loop
set E=FirstOfGroup(g2)
set x2=GetUnitX(E)
set y2=GetUnitY(E)
set a2=GetRandomReal(0,7)
exitwhen E==null
if Condition_Base(p,E)then
call SetUnitInvulnerable(E,false)
call UnitRemoveAbility(E,'A0QL')
call SetUnitPathing(E,true)
call PauseUnit(E,false)
call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,false)
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetUnitInvulnerable(E,true)
call UnitAddAbility(E,'A0QL')
call PauseUnit(E,true)
call SetUnitInvulnerableTimed(E,false,0.4)
call UnitRemoveAbilityTimed(E,'A0QL',0.4)
call PauseUnitTimed(E,false,0.4)
call Push3(E,45,a2,1250,"0")
call SetUnitFlyHeight(E,0,900)
endif
call GroupRemoveUnit(g2,E)
endloop
call UnitApplyTimedLife(CreateUnit(p,'e0P7',x1,y1,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e0P6',x1,y1,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e0P5',x1,y1,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e0P8',x1,y1,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e0P5',x1,y1,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e0P8',x1,y1,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e0P5',x1,y1,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e0P8',x1,y1,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e0P4',x1,y1,GetRandomReal(0,359)),'BTLF',4)
call ForGroup(g,function KillGroup)
call DestroyGroup(g)
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,GetHandleId(g2))
call DestroyGroup(g2)
call CambugTimed(3)
endif
set p=null
set g=null
set g2=null
set g3=null
set l__d=null
set u=null
set t=null
endfunction
