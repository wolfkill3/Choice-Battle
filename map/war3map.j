function MinibombCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local real f=GetUnitFacing(u)
local player p=GetOwningPlayer(u)
local real dist=SR(x,y,x1,y1)
local real a=Atan2(y1-y,x1-x)
local integer i=GetRandomInt(1,4)
local real dmg=GetHeroInt(u,true)*(2+GetUnitAbilityLevel(u,'A0CX'))
local real di
local real r
local integer b=0
local integer lvl=GetUnitAbilityLevel(u,'A0CX')
if dist>46.00 then
call SetUnitX(l__d,x+43*Cos(a))
call SetUnitY(l__d,y+43*Sin(a))
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,ParabolaZ(400,LoadReal(h,id,4),dist),0)
else
call UnitApplyTimedLife(CreateUnit(p,'e07M',x1,y1,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e07M',x1,y1,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e07N',x1,y1,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e07Q',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e07Q',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call GroupEnumUnitsInRange(G,x1,y1,500,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 1, "stun")
endif
call GroupRemoveUnit(G,E)
endloop
if GetRandomIntMem(0,100)<=5 then
call TextTagFull("Everything!",u,250,255,50,1,GetOwningPlayer(u),0.028)
set i=-1
set b=0
loop
set dist=GetRandomReal(-450,450)
set r=GetRandomReal(0,7)
set n=CreateUnit(p,'e07S',x1,y1,a)
call MauryMissleFly(n,30,GetRandomReal(-1,1),x1+dist*Cos(r),y1+dist*Sin(r),250,350,GetHeroInt(u,true))
exitwhen b>4+lvl
set b=b+1
endloop
call GroupEnumUnitsInRange(G,x1,y1,500,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call PoisonDamage(u,E,GetUnitState(E,UNIT_STATE_MAX_LIFE)*(0.07+0.03*lvl),10,"war3mapImported\\DeathFumesBreathDamage.mdx")
call SetUnitState(E,UNIT_STATE_MANA,GetUnitState(E,UNIT_STATE_MANA)-GetUnitState(E,UNIT_STATE_MAX_MANA)*(0.06+0.06*lvl))
call SetControlToUnit(E,E, 3, "stun")
endif
call GroupRemoveUnit(G,E)
endloop
elseif i==1 then
call TextTagFull("Poison",u,200,255,155,1,GetOwningPlayer(u),0.028)
call GroupEnumUnitsInRange(G,x1,y1,500,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call PoisonDamage(u,E,GetUnitState(E,UNIT_STATE_MAX_LIFE)*(0.07+0.03*lvl),10,"war3mapImported\\DeathFumesBreathDamage.mdx")
endif
call GroupRemoveUnit(G,E)
endloop
elseif i==2 then
call TextTagFull("Mana Loss",u,100,155,255,1,GetOwningPlayer(u),0.028)
call GroupEnumUnitsInRange(G,x1,y1,500,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call SetUnitState(E,UNIT_STATE_MANA,GetUnitState(E,UNIT_STATE_MANA)-GetUnitState(E,UNIT_STATE_MAX_MANA)*(0.06+0.06*lvl))
endif
call GroupRemoveUnit(G,E)
endloop
elseif i==3 then
call TextTagFull("Stun",u,150,155,155,1,GetOwningPlayer(u),0.028)
call GroupEnumUnitsInRange(G,x1,y1,500,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call SetControlToUnit(E,E, 3, "stun")
endif
call GroupRemoveUnit(G,E)
endloop
elseif i==4 then
call TextTagFull("Missiles",u,230,155,155,1,GetOwningPlayer(u),0.028)
set b=0
loop
set di=GetRandomReal(-450,450)
set r=GetRandomReal(0,7)
set n=CreateUnit(p,'e07S',x1,y1,a)
call MauryMissleFly(n,30,GetRandomReal(-1,1),x1+di*Cos(r),y1+di*Sin(r),250,350,GetHeroInt(u,true))
exitwhen b>2+lvl
set b=b+1
endloop
endif
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
endif
set l__d=null
set u=null
set t=null
set p=null
endfunction
function MinibombCast takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real f=GetUnitFacing(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,CreateUnit(GetOwningPlayer(u),'e07S',x,y,f))
call SaveReal(h,id,2,x1)
call SaveReal(h,id,3,y1)
call SaveReal(h,id,4,SR(x,y,x1,y1))
set soundplay=SndN(1101) // Sound\Music\mp3Music\MayuriR.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.04,true,function MinibombCast2)
set u=null
set t=null
endfunction
function MinibombInit takes nothing returns nothing
endfunction
function MissleMoveNevan2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit l__d=LoadUnitHandle(h,id,2)
local real speed=LoadReal(h,id,4)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)+LoadReal(h,id,3)
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>40 then
set x=x+speed*Cos(a)
set y=y+speed*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
else
call UnitApplyTimedLife(CreateUnit(p,'e0K5',x,y,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0K7',x,y,a*bj_RADTODEG),'BTLF',1)
set n=CreateUnit(p,'e0K6',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',2)
call myCustomDamage(u,c,LoadReal(h,id,5),false,false,null,null,null)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
call KillUnit(l__d)
endif
set p=null
set l__d=null
set c=null
set t=null
set u=null
endfunction
function MissleMoveNevan takes unit u,unit c,unit l__d,real speed,real angle,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveUnitHandle(h,id,2,l__d)
call SaveReal(h,id,3,angle)
call SaveReal(h,id,4,speed)
call SaveReal(h,id,5,dmg)
call TimerStart(t,0.04,true,function MissleMoveNevan2)
set t=null
endfunction
function NevanCond takes nothing returns boolean
return GetSpellAbilityId()=='A0DI' and udg_B==true
endfunction
function NevanCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real l__d=GetRandomReal(-250,250)
local real dmg=LoadReal(h,id,11)
// if GetUnitAbilityLevel(u,'A28U')>0 and GetUnitState(u,UNIT_STATE_LIFE)<=GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.25 then
// set dmg=dmg+dmg*.2
// else
if GetUnitAbilityLevel(u,'A28U')>0 then
set dmg=dmg+dmg*.1
endif
if GetUnitCurrentOrder(u)==OrderId("slow")then
call UnitApplyTimedLife(CreateUnit(p,'e0K4',x,y,a*bj_RADTODEG),'BTLF',1)
set n=CreateUnit(p,'e0K2',x+45*Cos(a),y+45*Sin(a),a*bj_RADTODEG)
call SetUnitFlyHeight(n,60,0)
call MissleMoveNevan(u,c,n,40,GetRandomReal(-0.7,0.7),dmg)
else
call SetUnitTimeScale(u,1)
call AddUnitAnimationProperties(u,"alternate",true)
call PauseTimer(t)
call DestroyTimer(t)
call RemoveUnit(LoadUnitHandle(h,id,2))
call FlushChildHashtable(h,id)
call SaveInteger(HH,GetHandleId(u),ROYAL_GUARD_STACKS,0)
endif
set c=null
set p=null
set u=null
set t=null
endfunction
function NevanCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,GetSpellTargetUnit())
call SaveUnitHandle(h,id,2,CreateUnit(GetOwningPlayer(u),'e0K3',x,y,0))
set n=CreateUnit(GetOwningPlayer(u),'e0K5',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,0.2)
call SaveGroupHandle(h,id,3,CreateGroup())
call SetUnitAnimationByIndex(u,2)
call SetUnitTimeScale(u,0.7)
call SaveReal(h,id,11,(0.25+(0.25*GetUnitAbilityLevel(u,'A0DI')))*GetHeroStr(u,true)*(1+0.1*LoadInteger(HH,GetHandleId(u),ROYAL_GUARD_STACKS)))
set soundplay=SndN(1103) // Sound\Music\mp3Music\EffectWW.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
if GetUnitTypeId(u)=='H01N' then
set soundplay=SndN(1105) // Sound\Music\mp3Music\DanteWW.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
elseif GetUnitTypeId(u)=='H21N' then
set soundplay=SndN(1107) // Sound\Music\mp3Music\DTDanteWW.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call TimerStart(t,0.25,true,function NevanCast2)
set u=null
set t=null
endfunction
function InitNevan takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function NevanCast)
call TriggerAddCondition(t,Condition(function NevanCond))
set t=null
endfunction
function RainShotCond takes nothing returns boolean
return GetSpellAbilityId()=='A0DL' and udg_B==true
endfunction
function RainShotCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1
local real y1
local real f=GetUnitFlyHeight(l__d)
local real time=LoadReal(h,id,3)
local real r
local real l__s
local integer i=0
local player p=GetOwningPlayer(u)
local real dmg=GetHeroStr(u,true)*(0.4+0.1*GetUnitAbilityLevel(u,'A0DL'))
// if GetUnitAbilityLevel(u,'A28U')>0 and GetUnitState(u,UNIT_STATE_LIFE)<=GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.25 then
        // set dmg=dmg+dmg*.2
// else
if GetUnitAbilityLevel(u,'A28U')>0 then
    set dmg=dmg+dmg*.1
endif
call PauseUnit(u,true)
if f>185 then
    set f=f-10
    call SetUnitFacing(u,GetRandomReal(0,359))
    call SetUnitFlyHeight(l__d,f,0)
    set r=GetRandomReal(0,7)
    set l__s=GetRandomReal(-300,300)
    set n=CreateUnit(p,'h025',x,y,0)
    call SetUnitFlyHeight(n,f,0)
    call SetUnitFlyHeight(n,0,1200)
    call UnitApplyTimedLife(n,'BTLF',0.5)
    set x1=x+l__s*Cos(r)
    set y1=y+l__s*Sin(r)
    call SetUnitX(n,x1)
    call SetUnitY(n,y1)
    set n=CreateUnit(p,'h023',x,y,0)
    call SetUnitFlyHeight(n,f+75,0)
    call UnitApplyTimedLife(n,'BTLF',0.2)
    call DestroyEffect(AddSpecialEffect("war3mapImported\\Slam.mdx",x1,y1))
    call GroupEnumUnitsInRange(G,x1,y1,100,Base)
    loop
        set E=FirstOfGroup(G)
        exitwhen E==null
        if Condition_Base(p,E)then
            call myCustomDamage(u,E,dmg,false,false,null,null,null)
            call SetControlToUnit(E,E, 0.12, "stun")
        endif
        call GroupRemoveUnit(G,E)
    endloop
else
    call ShowUnit(u,true)
    call PauseUnit(u,false)
    call AddUnitAnimationProperties(u,"alternate",true)
    if(GetLocalPlayer()==p)then
        call ClearSelection()
        call SelectUnit(u,true)
    endif
    call SetUnitInvulnerable(u,false)
    call RemoveUnit(l__d)
    call SetUnitXY_1(u,x,y, false)
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set t=null
set l__d=null
endfunction
function RainShotCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
if GetUnitTypeId(u)=='H01N' then
call SaveUnitHandle(h,id,1,CreateUnit(GetOwningPlayer(u),'h024',GetSpellTargetX(),GetSpellTargetY(),0))
set soundplay=SndN(1109) // Sound\Music\mp3Music\DanteRR.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
elseif GetUnitTypeId(u)=='H21N' then
call SaveUnitHandle(h,id,1,CreateUnit(GetOwningPlayer(u),'h124',GetSpellTargetX(),GetSpellTargetY(),0))
set soundplay=SndN(1111) // Sound\Music\mp3Music\DTDanteRR.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call SetUnitAnimationByIndex(LoadUnitHandle(h,id,1),5)
call ShowUnit(u,false)
call SetUnitInvulnerable(u,true)
call SaveUnitHandle(h,id,0,u)
call TimerStart(t,0.03,true,function RainShotCast2)
set t=null
set u=null
endfunction
function RainShotInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function RainShotCast)
call TriggerAddCondition(t,Condition(function RainShotCond))
set t=null
endfunction
function DevilTriggerCond takes nothing returns boolean
return GetSpellAbilityId()=='A2DM' or GetSpellAbilityId()=='A0DM'
endfunction
function DevilTriggerCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
local real l=GetWidgetLife(u)
local real m=GetWidgetMana(u)
local real lm=GetUnitState(u,UNIT_STATE_MAX_LIFE)
local real mm=GetUnitState(u,UNIT_STATE_MAX_MANA)
if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
if GetUnitState(u,UNIT_STATE_LIFE)<=GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.25 then
    call HealTextTag(u,u,lm*.002*myCustomHeal2(u,1),"HealthRes")
    call SetUnitState(u,UNIT_STATE_LIFE,l+lm*.002)
    call SetUnitVertexColor(u,255,90,90,255)
else
    call HealTextTag(u,u,lm*.0015*myCustomHeal2(u,1),"HealthRes")
    call SetUnitState(u,UNIT_STATE_LIFE,l+lm*.0015)
    call SetUnitVertexColor(u,255,255,255,255)
endif
call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.0025)
endif
if GetUnitState(u,UNIT_STATE_MAX_MANA)*0.04>GetUnitState(u,UNIT_STATE_MANA) or LoadBoolean(HH,GetHandleId(u),SST)==true or GetWidgetLife(u) < 0.405 then
call SaveBoolean(HH,GetHandleId(u),SS,false)
call SaveBoolean(HH,GetHandleId(u),SST,false)
call SetUnitVertexColor(u,255,255,255,255)
call SetHeroStr(u, GetHeroStr(u, false)-LoadInteger(HH,GetHandleId(u),'SASB'), true)
call SetHeroAgi(u, GetHeroAgi(u, false)-LoadInteger(HH,GetHandleId(u),'SAAB'), true)
call SetHeroInt(u, GetHeroInt(u, false)-LoadInteger(HH,GetHandleId(u),'SAIB'), true)
call SaveInteger(HH,GetHandleId(u),'SASB',0)
call SaveInteger(HH,GetHandleId(u),'SAAB',0)
call SaveInteger(HH,GetHandleId(u),'SAIB',0)
if GetUnitTypeId(u)=='H21M' then //ss
    call ShowAbility2('A2DM',false)
    call ShowAbility2('A2CZ',false)
    call UnitAddAbility(u, 'S211')
    call IssueImmediateOrder(u, "bearform")
    call UnitRemoveAbility(u, 'S211')
    call SetUnitAbilityLevel(u,'A0D4',1)
    call ShowAbility2('A0DM',true)
    call ShowAbility2('A0CZ',true)
elseif GetUnitTypeId(u)=='H21N' then //ss
    call ShowAbility2('A2DM',false)
    call ShowAbility2('A2CZ',false)
    call UnitAddAbility(u, 'S221')
    call IssueImmediateOrder(u, "bearform")
    call UnitRemoveAbility(u, 'S221')
    call SetUnitAbilityLevel(u,'A0D4',2)
    call ShowAbility2('A0DM',true)
    call ShowAbility2('A0CZ',true)
endif
call CheckUnitBonusRange(u)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set t=null
endfunction
function DevilTriggerCast2 takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local timer tt=CreateTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(h,id,0)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        local player p=GetOwningPlayer(u)
        local real time=LoadReal(h,id,1)
        if time<0.1 then
            call PauseUnit(u,true)
            call SaveReal(h,id,1,time+0.025)
        else
            call PauseUnit(u,false)
            call SetUnitTimeScale(u,1)
            if LoadInteger(h,id,3)==0 then
                call ShowAbility2('A2DM',false)
                call ShowAbility2('A2CZ',false)
                call UnitAddAbility(u, 'S211')
                call IssueImmediateOrder(u, "bearform")
                call UnitRemoveAbility(u, 'S211')
                call SetUnitAbilityLevel(u,'A0D4',1)
                call ShowAbility2('A0DM',true)
                call ShowAbility2('A0CZ',true)
                    elseif LoadInteger(h,id,3)==1 then
                call ShowAbility2('A2DM',false)
                call ShowAbility2('A2CZ',false)
                call UnitAddAbility(u, 'S221')
                call IssueImmediateOrder(u, "bearform")
                call UnitRemoveAbility(u, 'S221')
                call SetUnitAbilityLevel(u,'A0D4',2)
                call ShowAbility2('A0DM',true)
                call ShowAbility2('A0CZ',true)
                    elseif LoadInteger(h,id,3)==2 then
                call ShowAbility2('A0DM',false)
                call ShowAbility2('A0CZ',false)
                call UnitAddAbility(u, 'S212')
                call IssueImmediateOrder(u, "bearform")
                call UnitRemoveAbility(u, 'S212')
                call SetUnitAbilityLevel(u,'A0D4',1)
                call ShowAbility2('A2DM',true)
                call ShowAbility2('A2CZ',true)
            elseif LoadInteger(h,id,3)==3 then
                call ShowAbility2('A0DM',false)
                call ShowAbility2('A0CZ',false)
                call UnitAddAbility(u, 'S222')
                call IssueImmediateOrder(u, "bearform")
                call UnitRemoveAbility(u, 'S222')
                call SetUnitAbilityLevel(u,'A0D4',2)
                call ShowAbility2('A2DM',true)
                call ShowAbility2('A2CZ',true)
            endif
            call CheckUnitBonusRange(u)
            if LoadBoolean(HH,GetHandleId(u),SS)==false then
                call SaveBoolean(HH,GetHandleId(u),SS,true)
                call SaveUnitHandle(h,GetHandleId(tt),0,u)
                call TimerStart(tt,0.1,true,function DevilTriggerCast3)
            endif
            if LoadInteger(h,id,3)==0 or LoadInteger(h,id,3)==1 then
                    call SaveBoolean(HH,GetHandleId(u),SST,true)
            endif
            call PauseTimer(t)
            call DestroyTimer(t)
            call FlushChildHashtable(h,id)
        endif
        set p=null
        set tt=null
        set u=null
        set t=null
endfunction
function DevilTriggerCast takes nothing returns nothing //dt
        local unit u=GetTriggerUnit()
        local timer t=CreateTimer()
        local integer id=GetHandleId(t)
        local player p=GetOwningPlayer(u)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        call SaveUnitHandle(h,id,0,u)
    call SaveReal(h,id,1,0.0)
    if GetSpellAbilityId()=='A2DM' and GetUnitTypeId(u)=='H21M' then
                call SaveInteger(h,id,3,0)
        call AddUnitAnimationProperties(u,"alternate",false)
        endif
    if GetSpellAbilityId()=='A2DM' and GetUnitTypeId(u)=='H21N' then
                call SaveInteger(h,id,3,1)
        call AddUnitAnimationProperties(u,"alternate",true)
        endif
        if GetSpellAbilityId()=='A0DM' and GetUnitTypeId(u)=='H01M' then
                call SaveInteger(h,id,3,2)
        call AddUnitAnimationProperties(u,"alternate",false)
        endif
    if GetSpellAbilityId()=='A0DM' and GetUnitTypeId(u)=='H01N' then
                call SaveInteger(h,id,3,3)
        call AddUnitAnimationProperties(u,"alternate",true)
        endif
    if GetUnitTypeId(u)=='H01N' or GetUnitTypeId(u)=='H01M' then
    set soundplay=SndN(1113) // Sound\Music\mp3Music\EffectDT(ON).mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call SaveInteger(HH,GetHandleId(u),'SASB',R2I(GetHeroStr(u,true)*0.125))
    call SaveInteger(HH,GetHandleId(u),'SAAB',R2I(GetHeroAgi(u,true)*0.125))
    call SaveInteger(HH,GetHandleId(u),'SAIB',R2I(GetHeroInt(u,true)*0.125))
    call SetHeroStr(u, GetHeroStr(u, false)+LoadInteger(HH,GetHandleId(u),'SASB'), true)
    call SetHeroAgi(u, GetHeroAgi(u, false)+LoadInteger(HH,GetHandleId(u),'SAAB'), true)
    call SetHeroInt(u, GetHeroInt(u, false)+LoadInteger(HH,GetHandleId(u),'SAIB'), true)
    call UnitMakeAbilityPermanent(u, true, 'A28U')
    call DestroyEffect(AddSpecialEffect("AZ_BNPF_V_yellow.mdl", x, y))
    call DestroyEffect(AddSpecialEffect("war3mapImported\\Holy_Fire_Slam2.mdx", x, y))
    call DestroyEffect(AddSpecialEffect("WindCirclefaster.mdl", x, y))
    call RemoveEffect(AddSpecialEffect("123 (1081).mdl", x, y) , 0.35 , true , CreateTimer())
    elseif GetUnitTypeId(u)=='H21N' or GetUnitTypeId(u)=='H21M' then
    set soundplay=SndN(1115) // Sound\Music\mp3Music\EffectDT(OFF).mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call UnitRemoveAbility(u,'A28U')
    endif
        call SetUnitTimeScale(u,0.5)
        call TimerStart(t,0.025,true,function DevilTriggerCast2)
        set u=null
        set p=null
        set t=null
endfunction
