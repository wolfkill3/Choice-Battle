function CastExpl2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real r=GetRandomReal(-7,7)
local real dist=GetRandomReal(-350,350)
local real x=LoadReal(h,id,1)+dist*Cos(r)
local real y=LoadReal(h,id,2)+dist*Sin(r)
local group g=LoadGroupHandle(h,id,5)
local integer num=LoadInteger(h,id,3)
local real he=0
local player p=GetOwningPlayer(u)
local integer i=0
local real l__s=GetRandomReal(0.9,2)
local integer lvl=GetUnitAbilityLevel(u,'A10D')
local real dmg=GetHeroInt(u,true)*(2+lvl)+50
local integer l__idg=GetHandleId(g)
if num<10 then
set n=CreateUnit(p,0x65305643,x,y,GetRandomReal(0,360))
call UnitApplyTimedLife(n,'BTLF',1)
set n=CreateUnit(p,0x65305642,x,y,GetRandomReal(0,360))
call UnitApplyTimedLife(n,'BTLF',1)
set n=CreateUnit(p,0x65305644,x,y,GetRandomReal(0,360))
call UnitApplyTimedLife(n,'BTLF',1)
call GroupEnumUnitsInRange(g,LoadReal(h,id,1),LoadReal(h,id,2),600,Base)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 2, "stun")
call DestroyEffect(AddSpecialEffect("war3mapImported\\BluefireBolt.mdx",GetUnitX(E),GetUnitY(E)))
call SaveUnitHandle(h,l__idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
call SaveInteger(h,id,3,num+1)
else
call FlushChildHashtable(h,l__idg)
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call UnitRemoveAbility(u,'A10H')
call FlushChildHashtable(h,id)
endif
set u=null
set g=null
set t=null
set p=null
endfunction
