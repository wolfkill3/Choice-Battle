    call SetUnitAnimation(target,"stand")
    call UnitSpeed(target,1)
    call SetUnitPathing(target,true)
    call PauseUnit(target,false)
    call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
    call SetUnitInvulnerable(target,false)
    call DamageAoeOneTime0(caster,GetUnitX(target),GetUnitY(target),400,LoadReal(HH,id,15))

    call SetControlToUnit(caster,target, 2, "stun")
    call PauseTimer(GetExpiredTimer())
    call FlushChildHashtable(HH,id)
    call DestroyTimer(GetExpiredTimer())
else




    set facing=Angle2(GetUnitX(caster),GetUnitY(caster),GetUnitX(target),GetUnitY(target))
    call SaveReal(HH,id,3,facing)
    call SetUnitFacing(caster,facing)
    call SetUnitPathing(caster,false)
    call PauseUnit(caster,true)
    call SetUnitInvulnerable(caster,true)
    if time==0.02 then
        call EffectCreateAndMove(true,"BlackGoku\\HakenSaber21.mdl",facing,1,1,0.75,100,100,100,0,0,caster,50,facing)
        call EffectCreateAndMove(true,"BlackGoku\\wind41.mdl",facing,1,1,0.75,100,100,100,0,0,caster,50,facing)
        call SaveReal(HH,id,11,GetUnitX(caster))
        call SaveReal(HH,id,12,GetUnitY(caster))
        call SaveReal(HH,id,8,SR(GetUnitX(caster),GetUnitY(caster),GetUnitX(target),GetUnitY(target)))
        call UnitAddAbility(caster,'Amrf')
        call UnitRemoveAbility(caster,'Amrf')
        call SetUnitAnimationByIndex(caster,47)
        if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
            set soundplay=SndN(3743) // Sound\Music\mp3Music\SoundEng\BlackGokuEG1-1eng.mp3
            call StartSound(soundplay)
            // call KillSoundWhenDone(soundplay)
        else
            set soundplay=SndN(3746) // Sound\Music\mp3Music\SoundJap\BlackGokuEG1-1.mp3
            call StartSound(soundplay)
            // call KillSoundWhenDone(soundplay)
        endif
        set facing=Angle2(GetUnitX(caster),GetUnitY(caster),GetUnitX(target),GetUnitY(target))
        call SaveReal(HH,id,3,facing)
        call SetUnitFacing(caster,facing)
        call UnitSpeed(caster,6)
    endif


    if time==0.2 then
        call EffectCreateAndMove(true,"BlackGoku\\CF21.mdl",facing,1,0.6,0.5,100,100,100,0,100,caster,50,facing)
        call EffectCreateAndMove90(true,"BlackGoku\\wind41.mdl",facing+180,1,1.25,0.75,100,100,100,0,100,caster,50,facing)
        set soundplay=SndN(3749) // Sound\Music\mp3Music\SoundJap\BlackGokuE1.mp3
        call StartSound(soundplay)
        // call KillSoundWhenDone(soundplay)
    endif
    if time==0.3 then
        call UnitSpeed(caster,0)
    endif



    if time>0.2 and time<20 then
        set facing=Angle2(GetUnitX(caster),GetUnitY(caster),GetUnitX(target),GetUnitY(target))
        call SaveReal(HH,id,3,facing)
        if SR(x,y,x2,y2)<=400 and LoadBoolean(HH,id,19)==false then
            if GetRandomInt(1,2)==1 then
                call SetUnitAnimationByIndex(caster,50)
            else
                call SetUnitAnimationByIndex(caster,51)
            endif
            call UnitSpeed(caster,0.75)
            call SaveBoolean(HH,id,19,true)
        endif
        if SR(x,y,x2,y2)>100 then
            call MoveUnit(caster,caster,45,facing)
        else
            call UnitSpeed(caster,2)
            set time=20
            call SaveReal(HH,id,5,time)
        endif
    endif
    if time==20 and LoadBoolean(HH,GetHandleId(target),ANTITARGET_ABILITY)==true then
        call SaveUnitHandle(HH,GetHandleId(target),REVERSE_TARGET,caster)
        call SetUnitPathing(caster,true)
        call PauseUnit(caster,false)
        call SetUnitInvulnerable(caster,false)
        call UnitSpeed(caster,1)
        call PauseUnit(target,false)
        call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
        call PauseTimer(GetExpiredTimer())
        call DestroyTimer(GetExpiredTimer())
        call FlushChildHashtable(HH,id)
    endif
    if time>20 and time<23 then
        call SetUnitFacing(target,facing+180)
        call PauseUnit(target,true)
        call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
        call SetUnitInvulnerable(target,true)
    endif


    if time==20.02 then
        call SaveInteger(HH,id,19,1)
        call EffectCreateAndMove(true,"BlackGoku\\aZ_siwen_Pink.mdl",facing,1,1.5,0.75,100,100,100,0,100,target,50,facing)
        call EffectCreateAndMove90(true,"BlackGoku\\WindCircleFaster.mdl",facing,1,1,1.5,100,100,100,40,100,target,50,facing)
        call EffectCreateAndMove(true,"BlackGoku\\HakkeStart2.mdl",facing,1,1,1.5,100,100,100,60,100,target,50,facing)
        call EffectCreateAndMove(true,"BlackGoku\\[AB]PurpleAz-hit.mdl",facing,1.5,1.75,0.8,100,100,100,0,100,target,50,facing)
        call EffectCreateAndMove(true,"BlackGoku\\[AB]by_wood_bashenan_juqi_2.mdl",facing,1.5,0.75,0.6,100,100,100,0,100,target,50,facing)
        call SetUnitAnimation(target,"Death")
        call UnitSpeed(target,0.3)
        set soundplay=SndN(3752) // Sound\Music\mp3Music\SoundJap\BlackGokuE2.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        if LoadBoolean(HH,GetHandleId(caster),SH_BGF)==true then
            call BlackGokuZamasuGEAct(caster,target,GetHeroInt(caster,true)*0.6)
        endif
    endif


    if time==20.5 then
        call SetUnitAnimationByIndex(caster,57)
        call UnitSpeed(caster,0.8)

        if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
            set soundplay=SndN(3755) // Sound\Music\mp3Music\SoundEng\BlackGokuEG2-1eng.mp3
            call StartSound(soundplay)
            // call KillSoundWhenDone(soundplay)
        else
            set soundplay=SndN(3758) // Sound\Music\mp3Music\SoundJap\BlackGokuEG2-1.mp3
            call StartSound(soundplay)
            // call KillSoundWhenDone(soundplay)
        endif

    endif

    if time==20.6 then
        set soundplay=SndN(3761) // Sound\Music\mp3Music\SoundJap\BlackGokuEG4.mp3
        call StartSound(soundplay)
        // call KillSoundWhenDone(soundplay)
    endif
    if time==22 then
        call EffectCreateAndMove(true,"BlackGoku\\tg_az_pafeathermoon_b_bai.mdl",facing,1,1.5,0.75,100,100,100,0,50,caster,0,facing)
        call EffectCreateAndMove(true,"BlackGoku\\[A]az_axe_ef11.mdl",facing,1,1,0.75,100,100,100,0,50,caster,0,facing)
        call SetUnitAnimationByIndex(caster,48)
        call UnitSpeed(caster,1.5)
        set soundplay=SndN(3764) // Sound\Music\mp3Music\SoundJap\BlackGokuEG5.mp3
        call StartSound(soundplay)
        // call KillSoundWhenDone(soundplay)
    endif
    if time==22.5 then
        if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
            set soundplay=SndN(3767) // Sound\Music\mp3Music\SoundEng\BlackGokuEG6-1eng.mp3
            call StartSound(soundplay)
            // call KillSoundWhenDone(soundplay)
        else
            set soundplay=SndN(3770) // Sound\Music\mp3Music\SoundJap\BlackGokuEG6-1.mp3
            call StartSound(soundplay)
            // call KillSoundWhenDone(soundplay)
        endif
    endif

    if time==22.58 then
        call SetUnitAnimation(target,"Death")
        set soundplay=SndN(3773) // Sound\Music\mp3Music\SoundJap\BlackGokuEG6.mp3
        call StartSound(soundplay)
        // call KillSoundWhenDone(soundplay)
    endif
    if time>20 and time<20.5 then
        call MoveUnit(target,target,30,facing)
    endif

    if time>20.5 and time<22 then
        set time1=time1+0.02

        if time1==0.06 or time1==0.12 or time1==0.18 or time1==0.24 or time1==0.30 then
            call BlackGokGEBalls(caster,target,GetHeroAgi(caster,true)*0.08,facing,22.6-time)
        endif


        if time1==0.3 then
            call EffectCreateAndMove(true,"BlackGoku\\wind41.mdl",GetRandomReal(0,360),1,GetRandomReal(1,1.25),GetRandomReal(0.5,0.8),100,100,100,0,100,caster,0,facing)

            if LoadInteger(HH,id,19)==1 then
                call SaveInteger(HH,id,19,2)
                call EffectCreateAndMove(true,"BlackGoku\\[AB] tG_animeslashfinal_2.mdl",facing,0.5,1.75,0.8,100,100,100,0,120,caster,100,facing)
            else
                call SaveInteger(HH,id,19,1)
                call EffectCreateAndMove(true,"BlackGoku\\[AB] tG_animeslashfinal_1.mdl",facing,0.5,1.75,0.8,100,100,100,0,120,caster,100,facing)
            endif

            set time1=0
        endif

        call SaveReal(HH,id,6,time1)
    endif

endif
set target=null
set caster=null
endfunction



function BlackGokuQGAct takes nothing returns nothing

local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit Dummy=LoadUnitHandle(HH,id,20)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real damage=LoadReal(HH,id,15)
local real x1=LoadReal(HH,id,11)
local real y1=LoadReal(HH,id,12)
local real x0=GetUnitX(Dummy)
local real y0=GetUnitY(Dummy)
local real dist=LoadReal(HH,id,8)
local real rd=SR(x0,y0,x1,y1)


local real x2=PolX(x0,40,facing)
local real y2=PolY(y0,40,facing)

set time=time+0.02
call SaveReal(HH,id,5,time)




 



if time>1 and rd<=50 or time==6 or IsTerrainPathable(x2,y2,PATHING_TYPE_FLYABILITY)==true  then 
call EffectCreateAndMove(true,"BlackGoku\\CarolAFBTohka-R.mdl",facing,1.5,1.5,1.5,100,100,100,0,0,Dummy,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",facing,1.5,2,1,100,100,100,0,0,Dummy,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\az_siwen2.mdl",facing,1.5,1.5,0.6,100,100,100,30,0,Dummy,0,facing)

set soundplay=SndN(3776) // Sound\Music\mp3Music\SoundJap\BlackGokuQG2.mp3
call StartSound(soundplay)
// call KillSoundWhenDone(soundplay)

call GroupClear(G)
call GroupEnumUnitsInRange(G,x0,y0,500,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if Condition_Base(GetOwningPlayer(caster),n0) then

call myCustomDamage(caster,n0,damage,false,false,null,null,null)

endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
call UnitColor(LoadUnitHandle(HH,id,20),0,0,0,100)
call MyRemoveUnit(LoadUnitHandle(HH,id,20),3)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else
if time==0.02 then
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(3779) // Sound\Music\mp3Music\SoundEng\BlackGokuQG1-1eng.mp3
call StartSound(soundplay)
// call KillSoundWhenDone(soundplay)

else

set soundplay=SndN(3782) // Sound\Music\mp3Music\SoundJap\BlackGokuQG1-1.mp3
call StartSound(soundplay)
// call KillSoundWhenDone(soundplay)


endif
call UnitSpeed(caster,0.4)
call SetUnitAnimationByIndex(caster,46)
call UnitAddAbility(caster,'Amrf')
call UnitRemoveAbility(caster,'Amrf')
call SetUnitFlyHeight(caster,600,0)
call EffectCreateAndMove(true,"BlackGoku\\tohkaenergy.mdl",facing,1.5,0.75,1,100,100,100,0,0,caster,0,facing)
endif
if time==0.5 then
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
call SetUnitModel(n0,"BlackGoku\\[AB]white-heidong-boom.mdl")
call UnitSize(n0,1,1,1)
call UnitColor(n0,100,100,100,0)
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call SetUnitFlyHeight(n0,800,0)
call SaveUnitHandle(HH,id,20,n0)
call SetUnitAnimationByIndex(n0,0)
call SaveReal(HH,id,3,Angle2(GetUnitX(n0),GetUnitY(n0),x1,y1))
call SaveReal(HH,id,8,SR(GetUnitX(n0),GetUnitY(n0),x1,y1))
call EffectCreateAndMove(true,"BlackGoku\\[a]lotusstar.mdl",facing,1,0.6,0.5,100,100,100,0,150,caster,0,facing)
set n0=null
endif
if time>0.5 and time<1 then
call UnitSize(Dummy,1+(time-0.5)*9,1,1)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
endif
if time==1 then
call SetUnitFlyHeight(caster,0,600)
call UnitSpeed(caster,1)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
endif
if time>1 then
call MoveUnit(Dummy,Dummy,40,facing)
call SetUnitFlyHeight(Dummy,800*rd/dist,0)
endif
endif
set Dummy=null
set caster=null
endfunction


function BlackGokuFGQAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit caster1=LoadUnitHandle(HH,GetHandleId(caster),SH_Zamasu)
local unit Dummy=LoadUnitHandle(HH,id,20)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real damage=LoadReal(HH,id,15)
local real x1=LoadReal(HH,id,11)
local real y1=LoadReal(HH,id,12)
local real x0=GetUnitX(Dummy)
local real y0=GetUnitY(Dummy)
local real dist=LoadReal(HH,id,8)
local real rd=SR(x0,y0,x1,y1)

local real x2=PolX(x0,40,facing)
local real y2=PolY(y0,40,facing)

set time=time+0.02
call SaveReal(HH,id,5,time)




 



if time>1 and rd<=50 or time==6 or IsTerrainPathable(x2,y2,PATHING_TYPE_FLYABILITY)==true  then 
call EffectCreateAndMove(true,"BlackGoku\\[A]A_P.blast2.mdl",facing,1.5,1.5,2.25,100,100,100,0,0,Dummy,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\[A]SuperBigExpPurpleLow.mdl",facing,1.5,2.5,1.5,100,100,100,0,0,Dummy,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",facing,1.5,2.75,1,100,100,100,20,0,Dummy,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\az_siwen2.mdl",facing,1.5,2,0.6,100,100,100,30,0,Dummy,0,facing)
call PauseUnit(caster1,false)
call SaveBoolean(HH,GetHandleId(caster),SH_ZamasuSpell,false)

set soundplay=SndN(3785) // Sound\Music\mp3Music\SoundJap\BlackGokuQGF.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять

call GroupClear(G)
call GroupEnumUnitsInRange(G,x0,y0,700,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if Condition_Base(GetOwningPlayer(caster),n0) then


call myCustomDamage(caster,n0,damage,false,false,null,null,null)

endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
call UnitColor(LoadUnitHandle(HH,id,20),0,0,0,100)
call MyRemoveUnit(LoadUnitHandle(HH,id,20),3)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else



if time==0.02 then
call EffectCreateAndMove(true,"BlackGoku\\A(BlackPurple).mdl",facing,1.5,0.5,2,100,100,100,0,750,caster,0,facing)
call IssueImmediateOrder(caster1,"stop")
call SaveBoolean(HH,GetHandleId(caster),SH_ZamasuSpell,true)
call UnitAddAbility(caster,'Amrf')
call UnitRemoveAbility(caster,'Amrf')
call SetUnitFlyHeight(caster,600,0)
call UnitSpeed(caster,0.4)
call SetUnitAnimationByIndex(caster,46)
call PauseUnit(caster1,true)
call EffectCreateAndMove(true,"BlackGoku\\BlackBlink1.mdl",facing,1,1,1,100,100,100,0,0,caster1,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",facing,1,1,1,100,100,100,40,0,caster1,0,facing)
call MoveUnit(caster,caster1,150,facing-90)
call MoveUnit(caster,caster,150,facing+90)
call EffectCreateAndMove(true,"BlackGoku\\HakenSaber2.mdl",facing,1,0.5,0.5,100,100,100,0,0,caster1,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\[A]az_axe_ef1.mdl",facing,1,0.5,0.5,100,100,100,0,0,caster1,0,facing)
call UnitAddAbility(caster1,'Amrf')
call UnitRemoveAbility(caster1,'Amrf')
call SetUnitFlyHeight(caster1,600,0)
call UnitSpeed(caster1,0.4)
call SetUnitAnimationByIndex(caster1,10)

if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(3788) // Sound\Music\mp3Music\SoundEng\BlackGokuQGF-1eng.mp3
call StartSound(soundplay)
// call KillSoundWhenDone(soundplay)
else
set soundplay=SndN(3791) // Sound\Music\mp3Music\SoundJap\BlackGokuQGF-1.mp3
call StartSound(soundplay)
// call KillSoundWhenDone(soundplay)
endif

call EffectCreateAndMove(true,"BlackGoku\\BYmutou_huozhu_zise1.mdl",facing,1.5,0.75,1,100,100,100,0,-50,caster1,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\tohkaenergy.mdl",facing,1.5,0.75,1,100,100,100,0,-50,caster,0,facing)
endif



if time==0.5 then
call UnitSpeed(caster1,0.4)
call SetUnitAnimationByIndex(caster1,11)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
call SetUnitModel(n0,"BlackGoku\\white-heidong-boom.mdl")
call UnitColor(n0,100,100,100,0)
call UnitSize(n0,1,1,1)
call MoveUnit(n0,n0,150,facing-90)
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call SetUnitFlyHeight(n0,800,0)
call SaveUnitHandle(HH,id,20,n0)
call SetUnitAnimationByIndex(n0,0)
call SaveReal(HH,id,3,Angle2(GetUnitX(n0),GetUnitY(n0),x1,y1))
call SaveReal(HH,id,8,SR(GetUnitX(n0),GetUnitY(n0),x1,y1))
set n0=null
endif

if time>0.5 and time<1 then
set facing=Angle2(GetUnitX(caster),GetUnitY(caster),x1,y1)
call SetUnitFacing(caster,facing)
set facing=Angle2(GetUnitX(caster1),GetUnitY(caster1),x1,y1)
call SetUnitFacing(caster1,facing)
call UnitSize(Dummy,1+(time-0.5)*12,1,1)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
endif

if time==0.8 then
call UnitSpeed(caster1,1)
call SetUnitAnimationByIndex(caster1,12)
endif

if time==1 then
call SetUnitFlyHeight(caster,0,600)
call SetUnitFlyHeight(caster1,0,600)
call UnitSpeed(caster,1)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
endif

if time>1 then
call MoveUnit(Dummy,Dummy,40,facing)
call SetUnitFlyHeight(Dummy,800*rd/dist,0)
endif






endif

set Dummy=null
set caster=null
set caster1=null
endfunction
