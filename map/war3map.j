function GranadeSmokeCond takes nothing returns boolean
return GetSpellAbilityId()=='A17P'
endfunction
function GranadeSmokeCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real a
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local real x2=0
local real y2=0
local group g=LoadGroupHandle(h,id,15)
local group g2
local player p=GetOwningPlayer(u)
local integer l__ide
local integer turn=SH_turn
local real ts
local real sm=LoadReal(h,id,13)
local real time=LoadReal(h,id,12)
local real dist=SR(x,y,x1,y1)
if time<8 then
call SaveReal(h,id,12,time+0.4)
call GroupEnumUnitsInRange(DG,x1,y1,700,Base)
loop
set E=FirstOfGroup(DG)
exitwhen E==null
if Condition_Base(p,E)then
if IsUnitInGroup(E,g)==false then
set l__ide=GetHandleId(E)
set ts=GetUnitTurnSpeed(E)
call SaveReal(h,l__ide,turn,ts)
call SetUnitTurnSpeed(E,ts*0.1)
call GroupAddUnit(g,E)
endif
call MissUnit(u,E,0.4,0.5, false)
call SlowUnit(u,E,0.4,0.4,1,0,false)
call SetControlToUnit(E,E,1,"shortsight")
endif
call GroupRemoveUnit(DG,E)
endloop
set g2=CopyGroup(g)
loop
set E=FirstOfGroup(g2)
exitwhen E==null
set x2=GetUnitX(E)
set y2=GetUnitY(E)
if SR(x1,y1,x2,y2)>800 then
set l__ide=GetHandleId(E)
call SetUnitTurnSpeed(E,2)
call GroupRemoveUnit(g,E)
endif
call GroupRemoveUnit(g2,E)
endloop
call DestroyGroupTimed(g2,3)
else
loop
set E=FirstOfGroup(g)
set l__ide=GetHandleId(E)
exitwhen E==null
call SetUnitTurnSpeed(E,2)
call UnitRemoveAbility(E,'B063')
call GroupRemoveUnit(g,E)
endloop
call DestroyGroup(g)
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
endif
set g=null
set g2=null
set u=null
set l__d=null
set t=null
set p=null
endfunction
function GranadeSmokeCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real a
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local real x2=0
local real y2=0
local player p=GetOwningPlayer(u)
local integer l__ide
local integer turn=SH_turn
local real ts
local real sm=LoadReal(h,id,13)
local real time=LoadReal(h,id,12)
local real dist=SR(x,y,x1,y1)
if(dist>45.00)then
set a=Atan2(y-y1,x-x1)
call SetUnitX(l__d,x-40*Cos(a))
call SetUnitY(l__d,y-40*Sin(a))
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,ParabolaZ2(0,90,250,LoadReal(h,id,4),dist),0)
else
set n=CreateUnit(p,'e0YX',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',8)
call SaveReal(h,id,13,10)
set soundplay=SndN(2482) // Sound\Music\mp3Music\Sinon0.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call PauseTimer(t)
call TimerStart(t,0.4,true,function GranadeSmokeCast3)
endif
set u=null
set l__d=null
set t=null
set p=null
endfunction
function GranadeSmokeCast takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real f=GetUnitFacing(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,CreateUnit(GetOwningPlayer(u),'e0YY',x+50*Cos(f*bj_DEGTORAD),y+50*Cos(f*bj_DEGTORAD),f))
call SaveReal(h,id,2,x1)
call SaveReal(h,id,12,0)
call SaveReal(h,id,13,0)
call SaveReal(h,id,3,y1)
call SaveGroupHandle(h,id,15,CreateGroup())
call SaveReal(h,id,4,SR(x,y,x1,y1))
call SetUnitAnimation(u,"Spell four")
call TimerStart(t,0.03,true,function GranadeSmokeCast2)
set u=null
set t=null
endfunction
