function CircleCastCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local integer idu=GetHandleId(u)
local integer i=GetRandomInt(1,5)
local integer ids=GetSpellAbilityId()
set n=LoadUnitHandle(HH,idu,SH_tama)
if ids=='A1B2' then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\FrostWyrmMissile\\FrostWyrmMissile.mdl",n,"origin"))
endif
if i==1 then
call SetUnitAnimation(n,"Spell")
elseif i==2 then
call SetUnitAnimation(n,"Spell First")
elseif i==3 then
call SetUnitAnimation(n,"Spell Second")
elseif i==4 then
call SetUnitAnimation(n,"Spell Slam")
elseif i==5 then
call SetUnitAnimation(n,"Spell Third")
endif
set u=null
endfunction
