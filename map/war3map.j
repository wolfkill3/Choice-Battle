function IDCond takes nothing returns boolean
return GetSpellAbilityId()=='A0A0' and udg_B==true
endfunction
function IDCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local group g=LoadGroupHandle(h,id,4)
local real time=LoadReal(h,id,2)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local integer i=0
local player p=GetOwningPlayer(u)
if time<51 then
        call SaveReal(h,id,2,time+1)
        loop
    exitwhen i>=10
        if IsUnitAlly(Hero[i],p) and SquareRootUnit(Hero[i], u)>2000 then
            call UnitRemoveAbility(Hero[i],'A0A1')
                elseif IsUnitAlly(Hero[i],p) and GetUnitAbilityLevel(Hero[i],'A0A1')==0 then
                        call UnitAddAbility(Hero[i],'A0A1')
            call GroupAddUnit(g,Hero[i])
        endif
    set i=i+1
        endloop
else
	loop
	set E=FirstOfGroup(g)
	exitwhen E==null
	call UnitRemoveAbility(E,'A0A1')
	call GroupRemoveUnit(g,E)
	endloop
	set bj_lastCreatedGroup = CreateGroup() //mirage
	call GroupEnumUnitsInRange(bj_lastCreatedGroup,0.,0.,999999.,Base)
	loop
		set SysUnit = FirstOfGroup( bj_lastCreatedGroup )
		exitwhen SysUnit == null
		if GetUnitAbilityLevel( SysUnit,'A0A1') > 0 then
			call UnitRemoveAbility(SysUnit,'A0A1')
			call GroupRemoveUnit(g,SysUnit)
		endif
		call GroupRemoveUnit( bj_lastCreatedGroup, SysUnit )
	endloop
	call GroupClear(bj_lastCreatedGroup)
	call DestroyGroup(bj_lastCreatedGroup)
	call SetTerrainFogExBJ(0,6000.00,10000,0,1,1,1)
	call DestroyGroup(g)
	call UnitRemoveAbility(u,'A0A1')
	call PauseTimer(t)
	call DestroyTimer(t)
	call FlushChildHashtable(h,id)
endif
set g=null
set t=null
set u=null
set p=null
endfunction
function IDCast takes nothing returns nothing
local timer t=CreateTimer()
local unit u=GetTriggerUnit()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local integer i=0
local player p=GetOwningPlayer(u)
local group g=CreateGroup()
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,0)
call SaveGroupHandle(h,id,4,g)
call CreateModeIndicatorForm(u, "ReplaceableTextures\\CommandButtons\\BTNViper 5.blp", 5)
loop
    exitwhen i>=10
        if IsUnitAlly(Hero[i],p) or Hero[i]==u then
            call UnitAddAbility(Hero[i],'A0A1')
            call GroupAddUnit(g,Hero[i])
        else
            call SetControlToUnit(Hero[i],Hero[i], 5, "silenceTE")
        endif
    set i=i+1
endloop
call SetTerrainFogEx(0,0,6000,0,0.6,0,0)
set soundplay=SndN(991) // Sound\Music\mp3Music\ViperT.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.1,true,function IDCast2)
set t=null
set u=null
set p=null
set g=null
endfunction
function CondFrostZone takes nothing returns boolean
return GetSpellAbilityId()=='A09X'
endfunction
function FrostZoneCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local group g=LoadGroupHandle(h,id,1)
local integer i=1
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local real dist
local real dmg=(3+GetUnitAbilityLevel(u,'A09X'))*GetHeroInt(u,true)
local integer l__idg=GetHandleId(g)
local real f
local player p=GetOwningPlayer(u)
local integer l__ide
loop
exitwhen i>15
set dist=LoadReal(h,id,StringHash("dist"+I2S(i)))+50
call SaveReal(h,id,StringHash("dist"+I2S(i)),dist)
set f=(24*i)*bj_DEGTORAD
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl",x+dist*Cos(f),y+dist*Sin(f)))
set i=i+1
endloop
call GroupEnumUnitsInRange(g,x,y,dist,Base)
loop
set E=FirstOfGroup(g)
set l__ide=GetHandleId(E)
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,l__ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call UnitAddAbility(E, 'AA01')
call UnitMakeAbilityPermanent(E, true, 'AA01')
call UnitRemoveAbilityTimed(E, 'AA01', 2)
call SaveUnitHandle(h,l__idg,l__ide,E)
call CC_UnitEx( E, E, 0., 2, "stun", false, "Abilities\\Spells\\Undead\\FreezingBreath\\FreezingBreathTargetArt.mdl", "origin", 0,0 )
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
if dist>=700 then
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
set u=null
set g=null
set t=null
set p=null
endfunction
