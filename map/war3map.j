function BlackGokuW2Act takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit Dummy=LoadUnitHandle(HH,id,20)
local unit target=LoadUnitHandle(HH,GetHandleId(caster),SH_BGW2Targ)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real x0=GetUnitX(Dummy)
local real y0=GetUnitY(Dummy)
local real x1=GetUnitX(target)
local real y1=GetUnitY(target)
local real damage=LoadReal(HH,id,15)
local boolean targinv=false
local boolean targpaus=false
set time=time+0.02
call SaveReal(HH,id,5,time)
if time>0.1 and(SR(x0,y0,x1,y1)<=50 or time>10)then
call EffectCreateAndMove(true,"BlackGoku\\Singularity II Purple.mdl",facing,1,1.75,0.75,100,100,100,0,100-GetUnitFlyHeight(target),target,0,facing)
if IsUnitInvulnerable(target)==true then
set targinv=true
call SetUnitInvulnerable(target,false)
endif
if IsUnitPaused(target)==true then
set targpaus=true
call PauseUnit(target,false)
endif
call GroupClear(G)
call GroupEnumUnitsInRange(G,x1,y1,250,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if Condition_Base(GetOwningPlayer(caster),n0) then

call myCustomDamage(caster,n0,damage,false,false,null,null,null)
call SetControlToUnit(caster,n0, 0.5, "stun")
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
if targinv==true then
call SetUnitInvulnerable(target,true)
endif
if targpaus==true then
call PauseUnit(target,true)
endif
call SetUnitAnimationByIndex(LoadUnitHandle(HH,id,20),1)
call UnitColor(LoadUnitHandle(HH,id,20),100,100,100,100)
call MyRemoveUnit(LoadUnitHandle(HH,id,20),3)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else
if time<0.1 then
set facing=Angle2(GetUnitX(caster),GetUnitY(caster),x1,y1)
call SetUnitFacing(caster,facing)
call SaveReal(HH,id,3,facing)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call SetUnitPathing(caster,false)
endif
if time==0.02 then
call EffectCreateAndMove(true,"BlackGoku\\WindNewFaw4.mdl",facing,1,1,0.5,100,100,100,40,-GetUnitFlyHeight(caster),caster,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\HakenSaber22.mdl",facing,1,1,0.5,100,100,100,40,-GetUnitFlyHeight(caster),caster,0,facing)
endif
if time==0.1 then
call EffectCreateAndMove(true,"BlackGoku\\[DoFT]purple-shoot.mdl",facing,1,1,0.75,100,100,100,0,100-GetUnitFlyHeight(target),caster,50,facing)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'BGW2',false)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'BGW1',true)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'BGW3',true)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
call SetUnitPathing(caster,true)
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(3833) // Sound\Music\mp3Music\SoundEng\BlackGokuW5-1eng.mp3
call StartSound(soundplay)
// call KillSoundWhenDone(soundplay)

else

set soundplay=SndN(3836) // Sound\Music\mp3Music\SoundJap\BlackGokuW5-1.mp3
call StartSound(soundplay)
// call KillSoundWhenDone(soundplay)


endif
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
call SetUnitModel(n0,"BlackGoku\\[A]fense-lizi-toushewu.mdl")
call UnitSize(n0,1,1,1)
call MoveUnit(n0,n0,100,facing)
call SetUnitFlyHeight(n0,150,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=null
endif
if time>0.1 then
set Dummy=LoadUnitHandle(HH,id,20)
set facing=Angle2(x0,y0,x1,y1)
call SaveReal(HH,id,3,facing)
call MoveUnit(Dummy,Dummy,40,facing)
endif
endif
set Dummy=null
set caster=null
set target=null
endfunction
function BlackGokuW1Act takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit target=LoadUnitHandle(HH,id,2)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real time1=LoadReal(HH,id,6)
local real damage=LoadReal(HH,id,15)
set time=time+0.02
call SaveReal(HH,id,5,time)


if time<0 then
if time==-0.02 then

call SetUnitAnimationByIndex(caster,64)


call StartAbilityCooldown(GetUnitAbility(caster, 'BGW1'), 10)


set soundplay=SndN(3719) // Sound\Music\mp3Music\SoundJap\BlackGokuW1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять


call EffectCreateAndMove(true,"BlackGoku\\BlackBlink1.mdl",facing,1,1,1,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",facing,1,1,1,100,100,100,40,0,caster,0,facing)
call MoveAoe1(LoadReal(HH,id,11),LoadReal(HH,id,12),caster,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\HakenSaber2.mdl",facing,1,0.75,0.5,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\az_fireringblue.mdl",facing,1,1.5,0.8,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\kaizokusfxbyvalk4.mdl",facing,1,1,1.5,100,100,100,30,0,caster,0,facing)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
endif

if time>0 then

 if time==2.5 then

if GetHeroLevel(caster)>=12 then
call SaveUnitHandle(HH,GetHandleId(caster),SH_BGW2Targ,target)
call ChangeAbilityTimeBlackG(caster,8,'BGW1','BGW2','BGW3')
endif
call UnitSpeed(caster,1)
call SetUnitPathing(caster,true)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
call SetUnitAnimation(target,"death")
call UnitSpeed(target,1)
call SetUnitPathing(target,true)
call PauseUnit(target,false)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
call SetUnitInvulnerable(target,false)

call myCustomDamage(caster,target,damage,false,false,null,null,null)

call SetControlToUnit(caster,target, 1.5, "stun")
call PushTimed(target,facing,30,30)
call EffectCreateAndMove(true,"BlackGoku\\[doft]purpleaz-hit1.mdl",facing,1,1.5,0.75,100,100,100,0,100,target,150,facing)
call EffectCreateAndMove(true,"BlackGoku\\fadespearpurple.mdl",facing,1,1,0.75,100,100,100,0,100,target,150,facing)
call EffectCreateAndMove(true,"BlackGoku\\CF2.mdl",facing,1,0.6,0.5,100,100,100,0,100,target,150,facing)
call EffectCreateAndMove(true,"BlackGoku\\BY_Wood_GongChengSiPai_1.mdl",facing+180,1,2,0.75,100,100,100,0,100,target,150,facing)
call EffectCreateAndMove(true,"BlackGoku\\by_wood_bashenan_juqi_2.mdl",facing,1,0.5,0.75,100,100,100,0,100,target,150,facing)
call EffectCreateAndMove(true,"BlackGoku\\op (744).mdl",facing+90,0.5,1.5,0.75,100,100,100,0,100,target,150,facing)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else

set facing=Angle2(GetUnitX(caster),GetUnitY(caster),GetUnitX(target),GetUnitY(target))
call SaveReal(HH,id,3,facing)
call SetUnitPathing(caster,false)
call SetUnitPathing(target,false)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call PauseUnit(target,true)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
call SetUnitInvulnerable(target,true)
if time==0.02 then
call EffectCreateAndMove(true,"BlackGoku\\BlackBlink1.mdl",facing,1,1,1,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",facing,1,1,1,100,100,100,40,0,caster,0,facing)

set soundplay=SndN(3719) // Sound\Music\mp3Music\SoundJap\BlackGokuW1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять

if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(3839) // Sound\Music\mp3Music\SoundEng\BlackGokuW1-1eng.mp3
call StartSound(soundplay)
// call KillSoundWhenDone(soundplay)
else
