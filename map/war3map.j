function MillionStabCast3 takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(h,id,0)
        local unit c=LoadUnitHandle(h,id,1)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        local real x1=GetUnitX(c)
        local real y1=GetUnitY(c)
        local real x2
        local real y2
        local real r=LoadReal(h,id,2)
        local real a=Atan2(y1-y,x1-x)
        local real l__d=GetRandomReal(-30,30)
        local player p=GetOwningPlayer(u)
        local real dmg=LoadReal(h,id,11)
        local boolean b=LoadBoolean(h,id,7)
        // if GetUnitAbilityLevel(u,'A28U')>0 and GetUnitState(u,UNIT_STATE_LIFE)<=GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.25 then
                // set dmg=dmg+dmg*.2
        // else
        if GetUnitAbilityLevel(u,'A28U')>0 then
                set dmg=dmg+dmg*.1
        endif
        if r<120 then
            call SetUnitInvulnerable(u,true)
            set x2=x1-150*Cos(a)
            set y2=y1-150*Sin(a)
            call SetUnitXY_1(u,x2,y2, false)
            call SetUnitXY_1(c,x2+150*Cos(a),y2+150*Sin(a),false)
            call PauseUnit(c,true)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
            call SaveReal(h,id,2,r+2)
            if r< 60 then
                call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",x+(120+r)*Cos(a+(145-r)*bj_DEGTORAD),y+(120+r)*Sin(a+(145-r)*bj_DEGTORAD)))
                call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",x+(120+r)*Cos(a+(215+r)*bj_DEGTORAD),y+(120+r)*Sin(a+(215+r)*bj_DEGTORAD)))
            else
                if r< 110 then
                    call SetUnitTimeScale(u,0.15)
                    call DestroyEffect(AddSpecialEffectTarget("az_hit-red-blade.mdx",c,"chest"))
                    call DestroyEffect(AddSpecialEffectTarget("Minato-37.mdx",c,"chest"))
                    call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",c,"chest"))
                else
                    call SetUnitTimeScale(u,2)
                endif
            endif
            call SetUnitFacing(u,a*bj_RADTODEG)
        else
            call PauseUnit(c,false)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
            call SetUnitInvulnerable(u,false)
            call PauseUnit(u,false)
            call Push(c,50,a,100)
            call myCustomDamage(u,c,dmg,false,false,null,null,null)
            call SetControlToUnit(u,c, 0.5, "stun")
            call PauseTimer(t)
            call DestroyTimer(t)
            call FlushChildHashtable(h,id)
            call SetUnitTimeScale(u,1)
            call UnitRemoveAbility(u,'A0DB')
            call SaveInteger(HH,GetHandleId(u),ROYAL_GUARD_STACKS,0)
        endif
        set p=null
        set u=null
        set c=null
        set t=null
endfunction
function MillionStabCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
