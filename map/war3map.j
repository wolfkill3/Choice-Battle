            call SetFrameColourEx( TavernHeroPick,2, 0xFF404040 )
            endif
            call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,"Очередь выбирать для "+Color[3]+GetPlayerName(Player(3))+"\r")
            set pickon[3]=true
            set pick1=3

        elseif GetPlayerSlotState(Player(4))==PLAYER_SLOT_STATE_PLAYING and pickon[4]!=true then
            set TavernPlayerPickAllow[0]=true
            set TavernPlayerPickAllow[5]=false
            if GetLocalPlayer()==Player(0) then
            call SetFrameColourEx( TavernHeroPick,0, 0xFFFFFFFF )
            call SetFrameColourEx( TavernHeroPick,1, 0xFFFFFFFF )
            call SetFrameColourEx( TavernHeroPick,2, 0xFFFFFFFF )
            endif
            if GetLocalPlayer()==Player(5) then
            call SetFrameColourEx( TavernHeroPick,0, 0xFF404040 )
            call SetFrameColourEx( TavernHeroPick,1, 0xFF404040 )
            call SetFrameColourEx( TavernHeroPick,2, 0xFF404040 )
            endif
            call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,"Очередь выбирать для "+Color[4]+GetPlayerName(Player(4))+"\r")
            set pickon[4]=true
            set pick1=4
        elseif GetPlayerSlotState(Player(0))==PLAYER_SLOT_STATE_PLAYING and pickon[0]!=true then
            set TavernPlayerPickAllow[0]=true
            set TavernPlayerPickAllow[5]=false
            if GetLocalPlayer()==Player(0) then
            call SetFrameColourEx( TavernHeroPick,0, 0xFFFFFFFF )
            call SetFrameColourEx( TavernHeroPick,1, 0xFFFFFFFF )
            call SetFrameColourEx( TavernHeroPick,2, 0xFFFFFFFF )
            endif
            if GetLocalPlayer()==Player(5) then
            call SetFrameColourEx( TavernHeroPick,0, 0xFF404040 )
            call SetFrameColourEx( TavernHeroPick,1, 0xFF404040 )
            call SetFrameColourEx( TavernHeroPick,2, 0xFF404040 )
            endif
            call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,"Очередь выбирать для "+Color[0]+GetPlayerName(Player(0))+"\r")
            set pickon[0]=true
            set pick1=0
        endif
    endif
    if nowpick2==playedplayers and timerg==false then //cmi
        call DestroyTimerDialog(udg_Ban1)
        call DestroyTimer(udg_Timer3)
        call TimerStart(udg_Timer,50.0,false,null)
        set udg_TB=CreateTimerDialog(udg_Timer)
        call TimerDialogSetTitle(udg_TB,"До начала раунда:")
        call TimerDialogDisplay(udg_TB,true)
        set TavernPlayerPickAllow[5]=false
        set TavernPlayerPickAllow[0]=false
        call SetFrameColourEx( TavernHeroPick,0, 0xFF404040 )
        call SetFrameColourEx( TavernHeroPick,1, 0xFF404040 )
        call SetFrameColourEx( TavernHeroPick,2, 0xFF404040 )
        set timerg=true
        set pick=0
    endif
endif
call DestroyGroup(g)
call UpdateMultiboard()
set u=null
set p=null
set g=null
endfunction
