set t=null
endfunction
function YotonYokaiNoJutsuMissleFly2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
local real dist=LoadReal(h,id,6)
local real mh=LoadReal(h,id,5)
local real rad=LoadReal(h,id,7)
local real rd=SR(x,y,x1,y1)
local real dmg=LoadReal(h,id,8)
local player p=GetOwningPlayer(l__d)
local integer idu=GetPlayerId(p)
local integer idun=GetHandleId(Hero[idu])
local integer l__s=LoadInteger(h,idun,SH_number)+1
if rd>30+speed and IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,ParabolaZ(mh,dist,rd),0)
else
call UnitApplyTimedLife(CreateUnit(p,0x65304A57,x1,y1,GetRandomReal(0,359)),'BTLF',0.5)
call UnitApplyTimedLife(CreateUnit(p,0x65304A58,x1,y1,GetRandomReal(0,359)),'BTLF',5.5)
set n=CreateUnit(p,0x65304A56,x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',6)
call SaveDestructableHandle(h,idun,l__s,CreateDestructable('B003',x1,y1,GetRandomReal(0,359),1,1))
call SaveInteger(h,idun,SH_number,l__s)
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set l__d=null
set t=null
endfunction
function YotonYokaiNoJutsuMissleFly takes unit l__d,real speed,real angle,real x,real y,real mh,real r,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,mh)
call SaveReal(h,id,6,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,7,r)
call SaveReal(h,id,8,dmg)
call TimerStart(t,0.03,true,function YotonYokaiNoJutsuMissleFly2)
set t=null
endfunction
function CondYotonYokaiNoJutsu takes nothing returns boolean
return GetSpellAbilityId()=='A0MR'
endfunction
// союзник из списка T Мей больше не в радиусе 500 (или T закончилась) — снять флаг щита
function MeiTShieldLeave takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
if LoadReal(h,id,4)<=0 or SR(GetUnitX(GetEnumUnit()),GetUnitY(GetEnumUnit()),LoadReal(h,id,1),LoadReal(h,id,2))>500 then
call SaveBoolean(h,GetHandleId(GetEnumUnit()),SH_MeiT_Shield,false)
call GroupRemoveUnit(LoadGroupHandle(h,id,GroupHash),GetEnumUnit())
endif
endfunction
function CastYotonYokaiNoJutsu4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x1=LoadReal(h,id,1)
local real y1=LoadReal(h,id,2)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local integer str=SH_number
local real time=LoadReal(h,id,4)
local real dmg=GetHeroInt(u,true)*0.4
local player p=GetOwningPlayer(u)
local integer idu=GetPlayerId(p)
local integer idun=GetHandleId(Hero[idu])
local integer i=0
if time>0 then
        call SaveReal(h,id,4,time-0.2)
        // только юниты рядом с зоной (раньше — все юниты карты, радиус 999999, 5 раз в секунду); союзникам в зоне — флаг щита и в список
        call GroupEnumUnitsInRange(G,x1,y1,600,Base)
        loop
        set E=FirstOfGroup(G)
        exitwhen E==null
                if SR(GetUnitX(E), GetUnitY(E), x1, y1)<=500 then
                        if Condition_Base(p,E)then
                                call myCustomDamage(u,E,dmg,false,false,null,null,null)
                                call SetControlToUnit(E,E, 0.5, "silenceTE")
                                call SlowUnit(u,E,0.85,0.85,0.2,2,false)
                        else
                                call SaveBoolean(h, GetHandleId(E), SH_MeiT_Shield, true)
                                call GroupAddUnit(LoadGroupHandle(h, id, GroupHash),E)
                        endif
                endif
                call GroupRemoveUnit(G,E)
        endloop
        call ForGroup(LoadGroupHandle(h, id, GroupHash),function MeiTShieldLeave)
        if SR(x,y,x1,y1)<400 then
                call SetUnitInvulnerable(u,true)
        else
                call SetUnitInvulnerable(u,false)
        endif
else
        loop
                exitwhen i>=31
                call RemoveDestructable(LoadDestructableHandle(h,idun,i))
                set i=i+1
        endloop
        // T закончилась (время <= 0) — снять флаг у всех из списка
        call ForGroup(LoadGroupHandle(h, id, GroupHash),function MeiTShieldLeave)
        call DestroyGroup(LoadGroupHandle(h, id, GroupHash))
        call SetUnitInvulnerable(u,false)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set t=null
endfunction
function CastYotonYokaiNoJutsu3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local integer str=SH_number
local integer idu=GetPlayerId(GetOwningPlayer(u))
local integer l__s=LoadInteger(h,GetHandleId(Hero[idu]),str)
if l__s>=20 then
call PauseTimer(t)
call TimerStart(t,0.2,true,function CastYotonYokaiNoJutsu4)
endif
set u=null
set t=null
endfunction
function CastYotonYokaiNoJutsu2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x1=LoadReal(h,id,1)
local real y1=LoadReal(h,id,2)
local real x2=0
local real y2=0
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=(360/20)*bj_DEGTORAD
local real a=0
local integer time=LoadInteger(h,id,3)
if time>=0 then
call SaveInteger(h,id,3,time-1)
set x2=x1+400*Cos(time*f)
set y2=y1+400*Sin(time*f)
set a=Atan2(y-y1,x-x1)
set n=CreateUnit(GetOwningPlayer(u),'e0JI',x,y,GetRandomReal(0,359))
call YotonYokaiNoJutsuMissleFly(n,38,0,x2,y2,GetRandomReal(250,350),0,0)
else
call PauseTimer(t)
call TimerStart(t,0.03,true,function CastYotonYokaiNoJutsu3)
endif
set u=null
set t=null
endfunction
function CastYotonYokaiNoJutsu takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real a=Atan2(y-y1,x-x1)*bj_DEGTORAD
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,x)
call SaveReal(h,id,2,y)
call SaveInteger(h,id,3,20)
call SaveReal(h,id,4,6)
call SaveGroupHandle(h, id, GroupHash, CreateGroup())
call SaveInteger(h,GetHandleId(u),SH_number,0)
set soundplay=SndN(1601) // Sound\Music\mp3Music\YotonYokainoJutsu.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.03,true,function CastYotonYokaiNoJutsu2)
set p=null
set t=null
set u=null
endfunction
function YotonYokaiNoJutsuInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function CastYotonYokaiNoJutsu)
call TriggerAddCondition(t,Condition(function CondYotonYokaiNoJutsu))
set t=null
endfunction
function FuttonKomoNoJutsuCond takes nothing returns boolean
return GetSpellAbilityId()=='A0MO'
endfunction
function FuttonKomoNoJutsuCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local integer i=1
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local player p=GetOwningPlayer(u)
local integer lvl=LoadInteger(h,id,5)
local real dist=LoadReal(h,id,1)
if dist>=lvl+5 then
call DestroyTimer(t)
call SetUnitInvulnerable(u,false)
call FlushChildHashtable(h,id)
else
call SaveReal(h,id,1,dist+0.2)
call GroupEnumUnitsInRange(G,x,y,500,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
        if GetUnitState(E,UNIT_STATE_LIFE)<GetUnitState(E,UNIT_STATE_MAX_LIFE)*0.02 then
            call myCustomDamage(u,E,GetUnitState(E,UNIT_STATE_MAX_LIFE)*0.05,false,false,null,null,null)
        else
            call DamageIndicatorFunction(u,E,GetUnitState(E,UNIT_STATE_LIFE)*0.012)
            call SetUnitState(E,UNIT_STATE_LIFE,GetUnitState(E,UNIT_STATE_LIFE)-GetUnitState(E,UNIT_STATE_LIFE)*0.012)
            call DamageIndicatorFunction(u,E,(GetUnitAbilityLevel(u, 'A0MO')*30 + 15)*0.2)
            call SetUnitState(E,UNIT_STATE_LIFE,GetUnitState(E,UNIT_STATE_LIFE)-(GetUnitAbilityLevel(u, 'A0MO')*30 + 15)*0.2)
        endif
        if GetUnitAbilityLevel(E,'B03T')==0 then
            set n=CreateUnit(p,'h019',x,y,0)
            call UnitAddAbility(n,'A0MP')
            call SetUnitAbilityLevel(n,'A0MP',lvl)
            call UnitApplyTimedLife(n,'BHwe',1)
            call IssueTargetOrder(n,"acidbomb",E)
        endif
endif
call GroupRemoveUnit(G,E)
endloop
endif
set u=null
set t=null
set p=null
endfunction
function FuttonKomoNoJutsuCast takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local real x1=0
local real y1=0
local real a=0
local player p=GetOwningPlayer(u)
local integer i=1
local real f=(360/15)*bj_DEGTORAD
local integer lvl=GetUnitAbilityLevel(u,'A0MO')
local real dist=470
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveInteger(h,id,5,lvl)
set n=CreateUnit(p,'h019',x,y,0)
call UnitApplyTimedLife(n,'BTLF',1)
call UnitAddAbility(n,'A0MN')
call SetUnitAbilityLevel(n,'A0MN',lvl)
call IssuePointOrder(n,"flamestrike",x,y)
loop
exitwhen i>=16
set x1=x+dist*Cos(i*f)
set y1=y+dist*Sin(i*f)
set a=Atan2(y-y1,x-x1)
call UnitApplyTimedLife(CreateUnit(p,'e0JU',x1,y1,GetRandomReal(0,359)),'BTLF',10)
set i=i+1
endloop
set soundplay=SndN(1603) // Sound\Music\mp3Music\FuttonKoumunoJutsu.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SaveUnitHandle(h,id,0,u)
call TimerStart(t,.2,true,function FuttonKomoNoJutsuCast2)
set p=null
set u=null
set t=null
endfunction
