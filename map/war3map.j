function GExplosionCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,5)
local real y1=LoadReal(h,id,6)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real dmg=LoadReal(h,id,4)
local real dist=LoadReal(h,id,2)
local real scale=LoadReal(h,id,10)
local real tm=GetWidgetMana(u)
local real time=LoadReal(h,id,17)
local real mt=LoadReal(h,id,18)
if time>0 then
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,0.65,0.65,0.65)
call SetUnitVertexColor(n,75,155,255,50)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,75,155,255,50)
set n=CreateUnit(p,'e0RE',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,75,155,255,50)
call SaveReal(h,id,18,mt-0.1)
if mt<0.1 then
call SaveReal(h,id,18,0.4)
set n=CreateUnit(p,'e0RP',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitTimeScale(n,0.4)
call SetUnitVertexColor(n,75,155,255,50)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,2,2,2)
call SetUnitTimeScale(n,0.4)
call SetUnitVertexColor(n,75,155,255,50)
endif
call SetUnitX(l__d,x+25*Cos(a-deg90))
call SetUnitY(l__d,y+25*Sin(a-deg90))
call SaveReal(h,id,17,time-0.1)
else
call CameraSetSourceNoise(0,0)
call CameraSetTargetNoise(0,0)
call SetUnitTimeScale(u,1)
call PauseTimer(t)
call TimerStart(t,0.02,true,function GExplosionCast3)
endif
set l__d=null
set p=null
set u=null
set t=null
endfunction
function GExplosionCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local real ang=150*bj_DEGTORAD
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,5,x1)
call SaveReal(h,id,6,y1)
call SaveReal(h,id,4,((GetUnitAbilityLevel(u,'A0WD')+2)*GetHeroStr(u,true)))
call SaveReal(h,id,2,SR1(x,y,x1,y1))
call SaveReal(h,id,10,1.25)
call SaveReal(h,id,11,a)
call SaveReal(h,id,17,0.6)
call SaveReal(h,id,18,0.4)
call CameraSetTargetNoiseEx(3*2.0,3*Pow(10,2),true)
call CameraSetSourceNoiseEx(3*2.0,3*Pow(10,2),true)
call SetUnitTimeScale(u,0)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
if GetUnitTypeId(u)=='H14H' then
set soundplay=SndN(2121) // Sound\Music\mp3Music\MidoriyaW.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
set soundplay=SndN(2123) // Sound\Music\mp3Music\GunhaW.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call SaveGroupHandle(h,id,12,CreateGroup())
set n=CreateUnit(p,0x65305443,x+25*Cos(a-ang),y+25*Sin(a-ang),a*bj_RADTODEG)
if GetUnitTypeId(u)=='H14H' then
call SetUnitVertexColor(n,255,100,100,255)
endif
call SaveUnitHandle(h,id,7,n)
call SetUnitScale(n,0.2,0.2,0.2)
call TimerStart(t,0.05,true,function GExplosionCast2)
set u=null
set p=null
set t=null
endfunction
