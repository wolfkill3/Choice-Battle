endfunction
function Trig_Getsuga_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A07O' and udg_B==true
endfunction
function Trig_Getsuga_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=LoadReal(h,id,1)
local real y=LoadReal(h,id,2)
local real a=Atan2(LoadReal(h,id,4)-y,LoadReal(h,id,3)-x)
local real l__d=LoadReal(h,id,5)
local group g=LoadGroupHandle(h,id,6)
local integer l__idg=GetHandleId(g)
local player p=GetOwningPlayer(u)
local integer l__ide
local real dmg=80*GetUnitAbilityLevel(u,'A07O')+GetUnitAbilityLevel(u,'A07O')*GetHeroAgi(u,true)
if l__d<2500 then
    set x=x+l__d*Cos(a)
    set y=y+l__d*Sin(a)
    set n=CreateUnit(p,'e02Q',x,y,a*bj_RADTODEG)
    call UnitApplyTimedLife(n,'BTLF',0.55)
    if GetUnitTypeId(u)=='H013' or GetUnitTypeId(u)=='H012' then
        set n=CreateUnit(p,'e09I',x,y,(a+GetRandomReal(-1,1))*bj_RADTODEG)
    elseif GetUnitTypeId(u)=='H06D' or GetUnitTypeId(u)=='H06E' then
        set n=CreateUnit(p,'e12B',x,y,(a+GetRandomReal(-1,1))*bj_RADTODEG)
    endif
    call UnitApplyTimedLife(n,'BTLF',0.7)
    call SetUnitTimeScale(n,2)
    call SaveReal(h,id,5,l__d+100)
    call UnitAddAbility(n,'Arav')
    call GroupEnumUnitsInRange(g,x,y,175,Base)
    loop
        set E=FirstOfGroup(g)
        exitwhen E==null
        set l__ide=GetHandleId(E)
        if Condition_Base(p,E) and E!=LoadUnitHandle(h,l__idg,l__ide) then
            call myCustomDamage(u,E,dmg,false,false,null,null,null)
            if SquareRootUnit(u,E)<300 then
                call SetControlToUnit(u,E, 1, "stun")
            endif
            call SaveUnitHandle(h,l__idg,l__ide,E)
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\Purge\\PurgeBuffTarget.mdl",E,"chest"))
        endif
        call GroupRemoveUnit(g,E)
    endloop
else
    call DestroyTimer(t)
    call DestroyGroup(g)
    call FlushChildHashtable(h,id)
    call FlushChildHashtable(h,l__idg)
endif
set p=null
set u=null
set g=null
set t=null
endfunction
function Trig_Getsuga_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
call SaveGroupHandle(h,id,6,CreateGroup())
call SaveReal(h,id,5,0)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,x)
call SaveReal(h,id,2,y)
call SaveReal(h,id,3,GetSpellTargetX())
call SaveReal(h,id,4,GetSpellTargetY())
if GetUnitTypeId(u)=='H013' or GetUnitTypeId(u)=='H012' then
set soundplay=SndN(1595) // Sound\Music\mp3Music\HichigoQ.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
elseif GetUnitTypeId(u)=='H06D' or GetUnitTypeId(u)=='H06E' then
set soundplay=SndN(1597) // Sound\Music\mp3Music\Alterl_Q .mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call SetUnitAnimation(u,"Spell Two")
call TimerStart(t,0.02,true,function Trig_Getsuga_Actions2)
set u=null
set t=null
endfunction
function InitTrig_Getsuga takes nothing returns nothing
set gg_trg_Getsuga=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Getsuga,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_Getsuga,Condition(function Trig_Getsuga_Conditions))
call TriggerAddAction(gg_trg_Getsuga,function Trig_Getsuga_Actions)
endfunction
function YotonYumesuCond takes nothing returns boolean
return GetSpellAbilityId()=='A14B'
endfunction
function YotonYumesuCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local player p=GetOwningPlayer(u)
local integer idu=GetPlayerId(p)
local real x=LoadReal(h,id,3)
local real y=LoadReal(h,id,4)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,8)
local real dmg=GetHeroInt(u,true)*(3+GetUnitAbilityLevel(u,'A14B'))
local real Range=LoadReal(h,id,9)
if Range<2500 and UnitIsAlive(l__d)then
set x1=x1+55*Cos(a)
set y1=y1+55*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
call SaveReal(h,id,3,x1)
call SaveReal(h,id,4,y1)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SaveReal(h,id,9,Range+55)
call GroupEnumUnitsInRange(G,x1,y1,150,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Slam.mdl",E,"chest"))
call RemoveUnit(l__d)
endif
call GroupRemoveUnit(G,E)
endloop
else
call UnitApplyTimedLife(CreateUnit(p,'e00N',x,y,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e067',x,y,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e06O',x,y,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0B9',x,y,GetRandomReal(0,359)),'BTLF',3)
call GroupEnumUnitsInRange(G,x,y,500,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(G,E)
endloop
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
endif
set u=null
set p=null
set t=null
set l__d=null
endfunction
function YotonYumesuBall takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
