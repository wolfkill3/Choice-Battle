function RuneCircleCast takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local real x1=0
local real y1=0
local real a=0
local player p=GetOwningPlayer(u)
local integer i=1
local real f=(360/30)*bj_DEGTORAD
local integer lvl=GetUnitAbilityLevel(u,'A0L2')
local real dist=(450+50*lvl)
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveInteger(h,id,5,lvl)
loop
exitwhen i>=31
set x1=x+dist*Cos(i*f)
set y1=y+dist*Sin(i*f)
set a=Atan2(y-y1,x-x1)
call UnitApplyTimedLife(CreateUnit(p,'e0GM',x1,y1,GetRandomReal(0,359)),'BTLF',5)
set i=i+1
endloop
call SaveUnitHandle(h,id,0,u)
set soundplay=SndN(1487) // Sound\Music\mp3Music\MagnusW.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,.2,true,function RuneCircleCast2)
set p=null
set u=null
set t=null
endfunction
function RuneCircleInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function RuneCircleCast)
call TriggerAddCondition(t,Condition(function RuneCircleCond))
set t=null
endfunction
function LariatCond takes nothing returns boolean
return GetSpellAbilityId()=='A0LM' and udg_B==true
endfunction
function MissleMovePointLariat2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
local real dist=LoadReal(h,id,6)
local real mh=LoadReal(h,id,5)
local real rad=LoadReal(h,id,7)
local real rd=SR(x,y,x1,y1)
local real he=LoadReal(h,id,8)
local player p=GetOwningPlayer(l__d)
local integer idu=GetPlayerId(p)
if rd>30+speed and IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,ParabolaZ2(he,0,mh,dist,rd),0)
else
if IsUnitType(l__d,UNIT_TYPE_HERO)==false then
call KillUnit(l__d)
endif
call SetUnitFlyHeight(l__d,0,0)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set l__d=null
set t=null
endfunction
function MissleMovePointLariat takes unit l__d,real speed,real angle,real x,real y,real mh,real r,real he returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,mh)
call SaveReal(h,id,6,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,7,r)
call SaveReal(h,id,8,he)
call TimerStart(t,0.03,true,function MissleMovePointLariat2)
set t=null
endfunction
function LariatCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,22)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=LoadReal(h,id,11)
local real a2=Atan2(y1-y,x1-x)
local real dmg=GetHeroAgi(u,true)*10
local player p=GetOwningPlayer(u)
local real l__d=0
local real r=0
local real dist=LoadReal(h,id,2)
local real time=LoadReal(h,id,17)
if SR(x,y,x1,y1)>400 and time>0 and LoadBoolean(h,id,12)==false then
    call SaveReal(h,id,17,time-0.015)
    call PauseUnit(u,true)
    call SetUnitInvulnerable(u,true)
    call PauseUnit(c,true)
    call SetUnitInvulnerable(c,true)
    set x=x+80*Cos(a2)
    set y=y+80*Sin(a2)
    call SetUnitXY_1(u,x,y, false)
    call SetUnitFacingInstant(u,a2*bj_RADTODEG)
    set n=CreateUnit(p,'e0GZ',x,y,a2*bj_RADTODEG)
    call UnitApplyTimedLife(n,'BTLF',0.25)
    call SetUnitTimeScale(n,2)
    call SetUnitVertexColor(n,255,255,255,125)
    call SetUnitAnimation(n,"spell channel")
    set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
    call UnitApplyTimedLife(n,'BTLF',0.01)
    call SetUnitScale(n,0.65,0.65,0.65)
    call SetUnitVertexColor(n,255,230,100,50)
    set n=CreateUnit(p,'e0RE',x,y,GetRandomReal(0,359))
    call UnitApplyTimedLife(n,'BTLF',0.01)
    call SetUnitVertexColor(n,255,230,100,50)
else
    if time>0 then
        if LoadBoolean(h,id,12)==false then
            call SaveReal(h,id,11,Atan2(y1-y,x1-x))
            call SaveBoolean(h,id,12,true)
            set soundplay=SndN(1489) // Sound\Music\mp3Music\KillerBeeLariat.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        endif
        if dist<1000 then
            if IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
                set x=x+60*Cos(a)
                set y=y+60*Sin(a)
            else
                set x=x-10*Cos(a)
                set y=y-10*Sin(a)
            endif
            call SetUnitXY_1(u,x,y, false)
            set n=CreateUnit(p,'e0GZ',x,y,a*bj_RADTODEG)
            call UnitApplyTimedLife(n,'BTLF',0.25)
            call SetUnitTimeScale(n,2)
            call SetUnitVertexColor(n,255,255,255,125)
            call SetUnitAnimation(n,"spell channel")
            set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
            call UnitApplyTimedLife(n,'BTLF',0.01)
            call SetUnitScale(n,0.65,0.65,0.65)
            call SetUnitVertexColor(n,255,230,100,50)
            set n=CreateUnit(p,'e0RE',x,y,GetRandomReal(0,359))
            call UnitApplyTimedLife(n,'BTLF',0.01)
            call SetUnitVertexColor(n,255,230,100,50)
            call SaveReal(h,id,2,dist+60)
            if SR(x,y,x1,y1)<200 and LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==true then
                call PauseUnit(u,false)
                call SetUnitInvulnerable(u,false)
                call PauseUnit(c,false)
                call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
                call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
                call SetUnitInvulnerable(c,false)
                call PauseTimer(t)
                call DestroyTimer(t)
                call FlushChildHashtable(h,id)
            endif
        else
            set n=CreateUnit(p,'e0UC',x1,y1,GetRandomReal(0,359))
            set l__d=GetRandomReal(100,400)
            set r=GetRandomReal(0,7)
            call MissleMovePointLariat(n,GetRandomReal(6,9),0,x+l__d*Cos(r),y+l__d*Sin(r),GetRandomReal(350,600),0,GetRandomReal(0,359))
            call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),'BTLF',2)
            call UnitApplyTimedLife(CreateUnit(p,'e04D',x1,y1,GetRandomReal(0,359)),'BTLF',2)
            call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),'BTLF',2)
            call UnitApplyTimedLife(CreateUnit(p,'e04D',x1,y1,GetRandomReal(0,359)),'BTLF',2)
            call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),'BTLF',2)
            call UnitApplyTimedLife(CreateUnit(p,'e04D',x1,y1,GetRandomReal(0,359)),'BTLF',2)
            call UnitApplyTimedLife(CreateUnit(p,'e0HM',x1,y1,GetRandomReal(0,359)),'BTLF',1.4)
            call PauseUnit(u,false)
            call SetUnitAnimation(u,"Spell Throw")
            call SetUnitInvulnerable(u,false)
            call PauseUnit(c,false)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
            call SetUnitInvulnerable(c,false)
            call myCustomDamage(u,c,dmg,false,false,null,null,null)
            call PauseTimer(t)
            call DestroyTimer(t)
            call FlushChildHashtable(h,id)
        endif
    else
        call PauseUnit(u,false)
        call RemoveUnit(LoadUnitHandle(h,id,16))
        call SetUnitInvulnerable(u,false)
        call PauseUnit(c,false)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
        call SetUnitInvulnerable(c,false)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
    endif
endif
set p=null
set c=null
set u=null
set t=null
endfunction
function LariatCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,22)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,5)
local real y1=LoadReal(h,id,6)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real dmg=LoadReal(h,id,4)
local real dist=LoadReal(h,id,2)
local real scale=LoadReal(h,id,10)
local real time=LoadReal(h,id,17)
if time>0 then
call SaveReal(h,id,17,time-0.1)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call PauseUnit(c,true)
call SetUnitInvulnerable(c,true)
else
call SaveReal(h,id,17,3)
call SetUnitTimeScale(u,1)
call PauseTimer(t)
call TimerStart(t,0.015,true,function LariatCast3)
endif
set c=null
set p=null
set u=null
set t=null
endfunction
function LariatCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local real ang=150*bj_DEGTORAD
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,22,c)
call SaveReal(h,id,5,x1)
call SaveReal(h,id,6,y1)
call SaveReal(h,id,2,0)
call SaveReal(h,id,10,1.25)
call SaveReal(h,id,11,a)
call SaveReal(h,id,17,0.8)
call SetUnitTimeScale(u,0)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call SetUnitInvulnerable(c,true)
call TimerStart(t,0.1,true,function LariatCast2)
set u=null
set p=null
set c=null
set t=null
endfunction
function NejiTCond takes nothing returns boolean
return GetSpellAbilityId()=='A2LL' and udg_B==true
endfunction
function MissleMoveNeji2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,4)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)+angle
// цель пропала или умерла — копия больше не летит к (0,0)
if c!=null and UnitIsAlive(c) and SR(x,y,x1,y1)>100 then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
if GetUnitTypeId(l__d)=='e1GZ' then
set n=CreateUnit(GetOwningPlayer(l__d),'e1GZ',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.15)
call SetUnitVertexColor(n,190,255,255,60)
call ShikiCloneEffect(n,1.5,1.05,1.25,150)
call SetUnitAnimation(n,"attack")
endif
else
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set c=null
set l__d=null
set t=null
endfunction
function MissleMoveNeji takes unit l__d,real speed,real angle,unit target returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveUnitHandle(h,id,4,target)
call SetUnitVertexColor(l__d,190,255,255,60)
call TimerStart(t,0.02,true,function MissleMoveNeji2)
set t=null
endfunction
function NejiTCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit c1=LoadUnitHandle(h,id,15)
local unit c2
local real x0=LoadReal(h,id,10)
local real y0=LoadReal(h,id,11)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real x2=GetUnitX(c1)
local real y2=GetUnitY(c1)
local real a=LoadReal(h,id,5)
local real a2=Atan2(y1-y,x1-x)
local real dmg=14*GetHeroAgi(u,true)
local player p=GetOwningPlayer(u)
local real time=LoadReal(h,id,7)
local real speed=LoadReal(h,id,8)
local real count=LoadReal(h,id,9)
local group g=LoadGroupHandle(h,id,12)
local group g2=LoadGroupHandle(h,id,13)
local group g4=null // создаётся только на тике выбора следующей цели (раньше — каждый тик, удалялась одна)
local unit nje=null // свои вместо общих E / ide / idg: номер группы раньше брался со 2-го тика и мог быть перезаписан
local integer njide=0
local integer njidg=GetHandleId(g)
local boolean njstop=udg_B==false or UnitIsAlive(u)==false
// конец раунда или Неджи умер — сразу к развязке (без урона ниже)
if njstop then
    call SaveReal(h,id,9,count+999)
    set count=count+999
    if time<=2 then
        call SaveReal(h,id,7,2.02)
        set time=2.02
    endif
endif
if time==0.02 then
    set njidg=GetHandleId(g)
    set njide=GetHandleId(c)
    //call BJDebugMsg("Name = "+GetUnitName(c))
    call SaveReal(h,njide,SH_NejiAngle,a)
    call GroupAddUnit(g,c)
    call SetUnitTimeScale(c,0.05)
    call SetUnitAnimation(u,"Spell Five")
    set EFF=AddSpecialEffect("Hakke128.mdl", x, y)
    call SetSpecialEffectZ(EFF , 30)
    call SetSpecialEffectScale(EFF , 9.6)
    call RemoveEffect(EFF,1,true,CreateTimer())
    set n=CreateUnit(p,'e06G',x,y,GetRandomReal(0,359))
    call UnitApplyTimedLife(n,'BTLF',1.3)
    call SetUnitTimeScale(n,0.8)
endif
if time<=1.5 then
    call SetUnitTimeScale(u,1)
    call SaveReal(h,id,7,time+0.02)
endif
if time<=2 and time>1.5 then
    call SaveReal(h,id,7,time+0.02)
    call SetUnitAnimation(u,"walk")
    call SetUnitFacingInstant(u,a2*bj_RADTODEG)
    call SetUnitXY_1(u,x+45*Cos(a2),y+45*Sin(a2), false)
    if SR(x,y,x1,y1)<100 or time==2 then
        set soundplay=SndN(1492) // Sound\Music\mp3Music\NejiT2_1.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        call SaveReal(h,id,7,2.02)
        call Push5(c,2,a,6,"")
    endif
endif
if NumberOfEnemiesInEachGroupHeroes(g,p)<1 and time>0.05 and count<128 then
    call SaveReal(h,id,9,count+128)
    call SaveReal(h,id,7,time+2)
    set count=LoadReal(h,id,9)
    set time=LoadReal(h,id,7)
endif
if count<=127 and time>2 and UnitIsAlive(u)==true then
    if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
        call PauseUnit(c,true)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
        call SetUnitTimeScale(c,0.05)
        call PauseUnit(u,true)
        call SetUnitInvulnerable(u,true)
        if ModuloReal((time-2),speed)<0.02 then
            set x1=x1-60*Cos(GetRandomReal(-65,65)*bj_DEGTORAD)
            set y1=y1-60*Sin(GetRandomReal(-65,65)*bj_DEGTORAD)
            call SetUnitXY_1(u,x1,y1, false)
            call SetUnitAnimation(u,"attack")
            call SetUnitAnimation(c,"death")
            call Push5(c,2,a,3,"")
            call SetUnitTimeScale(u,R2I(time)-1)
            set EFF=AddSpecialEffect("Minato-37.mdx", x1+GetRandomReal(25,65)*Cos(a+GetRandomReal(-20,20)*bj_DEGTORAD),y1+GetRandomReal(25,65)*Sin(a+GetRandomReal(-20,20)*bj_DEGTORAD))
            call SetSpecialEffectScale(EFF , GetRandomReal(0.75,1.75))
            call SetSpecialEffectZ(EFF , GetRandomReal(30,90))
            call SetSpecialEffectRoll(EFF , 90)
            call DestroyEffect(EFF)
            if GetRandomInt(1,2)==1 then
                set EFF=AddSpecialEffect("war3mapImported\\SlashBlueKojiro.mdl", x1+GetRandomReal(25,65)*Cos(a+GetRandomReal(-20,20)*bj_DEGTORAD),y1+GetRandomReal(25,65)*Sin(a+GetRandomReal(-20,20)*bj_DEGTORAD))
                call SetSpecialEffectScale(EFF , GetRandomReal(0.3,0.7))
                call SetSpecialEffectZ(EFF , GetRandomReal(30,90))
                call SetSpecialEffectRoll(EFF , 90)
                call DestroyEffect(EFF)
            else
                set EFF=AddSpecialEffect("FawEffects_7.mdx", x1+GetRandomReal(25,65)*Cos(a+GetRandomReal(-20,20)*bj_DEGTORAD),y1+GetRandomReal(25,65)*Sin(a+GetRandomReal(-20,20)*bj_DEGTORAD))
                call SetSpecialEffectScale(EFF , GetRandomReal(0.55,0.95))
                call SetSpecialEffectZ(EFF , GetRandomReal(30,90))
                call SetSpecialEffectRoll(EFF , 90)
                call DestroyEffect(EFF)
            endif
            if GetRandomInt(1,3)==1 then
                if GroupGetCount(g)>0 then
                    set c1=GroupGetUnitByIndex(g,GetRandomInt(0,CountUnitsInGroup(g)-1))
                    call SaveUnitHandle(h,id,15,c1)
                    set n=CreateUnit(p,'e1GZ',x2+GetRandomReal(-85,85),y2+GetRandomReal(-85,85),GetRandomReal(0,359))
                else
                    set n=CreateUnit(p,'e1GZ',x1+GetRandomReal(-85,85),y1+GetRandomReal(-85,85),GetRandomReal(0,359))
                endif
                call UnitApplyTimedLife(n,'BTLF',0.15)
                call SetUnitTimeScale(n,2)
                call SetUnitVertexColor(n,190,255,255,120)
                call SetUnitAnimation(n,"attack")
            endif
            call SaveReal(h,id,9,count+1)
            if count==4 or count==8 or count==16 or count==32 or count==64 then
                set g4=CreateGroup()
                call GroupEnumUnitsInRange(g4,x0,y0,900,Base)
                if FirstOfGroup(g4)!=null then
                    loop
                        set nje=FirstOfGroup(g4)
                        exitwhen nje==null
                        if Condition_Base(p,nje) and IsUnitInvulnerable(nje)==false and IsUnitIllusion(nje)==false and IsUnitType(nje,UNIT_TYPE_HERO)==true and IsUnitInGroup(nje,g)==false then
                            call GroupAddUnit(g2,nje)
                        endif
                        call GroupRemoveUnit(g4,nje)
                    endloop
                    if FirstOfGroup(g2)!=null and GroupGetCount(g2)>0 then
                        set c2=GroupGetUnitByIndex(g2,GetRandomInt(0,GroupGetCount(g2)-1))
                        //call BJDebugMsg("g "+I2S(GroupGetCount(g2)))
                        //call BJDebugMsg("g2var, g = "+I2S(NumberOfEnemiesInEachGroupHeroes(g,p))+" g2 = "+I2S(NumberOfEnemiesInEachGroupHeroes(g2,p)))
                    elseif FirstOfGroup(g2)==null and FirstOfGroup(g)!=null and GroupGetCount(g)>0 then
                        set c2=GroupGetUnitByIndex(g,GetRandomInt(0,GroupGetCount(g)-1))
                        //call BJDebugMsg("g2 "+I2S(GroupGetCount(g2)))
                        //call BJDebugMsg("g1var, g = "+I2S(NumberOfEnemiesInEachGroupHeroes(g,p))+" g2 = "+I2S(NumberOfEnemiesInEachGroupHeroes(g2,p)))
                    elseif GroupGetCount(g)==0 then
                        call SaveReal(h,id,9,count+128)
                        call SaveReal(h,id,7,time+2)
                    endif
                    //call BJDebugMsg("Name = "+GetUnitName(c2))
                elseif GroupGetCount(g)==0 then
                    call SaveReal(h,id,9,count+128)
                    call SaveReal(h,id,7,time+2)
                endif
                set njide=GetHandleId(c2)
                if IsUnitInGroup(c2,g)==false then
                call GroupAddUnit(g,c2)
                call GroupRemoveUnit(g2,c2)
                endif
                call Push3(c,2,a,12,"")
                call SetUnitTimeScale(c2,0.05)
                call SaveUnitHandle(h,id,1,c2)
                call SaveUnitHandle(h,njidg,njide,c2)
                if c2!=c then
                call MissleMoveNeji(CreateUnit(p,'e1GZ',x,y,GetRandomReal(0,359)),90,Atan2(GetUnitY(c2)-y,GetUnitX(c2)-x),c2)
                endif
                call SaveReal(h,njide,SH_NejiAngle,Atan2(GetUnitY(c2)-y,GetUnitX(c2)-x))
                call SaveInteger(h,njide,SH_NejiDMG,LoadInteger(h,njide,SH_NejiDMG)+R2I( dmg / (96 / count)))
                call SaveReal(h,id,5,Atan2(GetUnitY(c2)-y,GetUnitX(c2)-x))
                loop
                    set nje=GroupForEachUnit(g)
                    exitwhen nje==null
                    call PauseUnit(nje,true)
                    call SaveBoolean(HH,GetHandleId(nje),TARGET_ABILITY,true)
                endloop
                call GroupClear(g2)
            endif
        endif
        call SetUnitTimeScale(u,4)
        call SetUnitFacing(u,a*bj_RADTODEG)
    else
        call SaveReal(h,id,9,count+128)
        call SaveReal(h,id,7,time+2)
        set count=LoadReal(h,id,9)
        set time=LoadReal(h,id,7)
        call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
    endif
elseif time>2 then
call SetUnitInvulnerable(u,false)
loop
set nje=FirstOfGroup(g)
exitwhen nje==null
set njide=GetHandleId(nje)
if LoadInteger(h,njide,SH_NejiDMG)<5*GetHeroAgi(u,true) then
call SaveInteger(h,njide,SH_NejiDMG,5*GetHeroAgi(u,true))
endif
if LoadInteger(h,njide,SH_NejiDMG)>14*GetHeroAgi(u,true) then
call SaveInteger(h,njide,SH_NejiDMG,14*GetHeroAgi(u,true))
endif
call PauseUnit(nje,false)
call SaveBoolean(HH,GetHandleId(nje),TARGET_ABILITY,false)
if njstop==false then
call FrozenMinusManaCast(nje,5)
call Push3(nje,45,LoadReal(h,njide,SH_NejiAngle),700,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
call myCustomDamage(u,nje,LoadInteger(h,njide,SH_NejiDMG),false,false,null,null,null)
endif
set EFF=AddSpecialEffect("WindVectorPush.mdx", GetUnitX(nje), GetUnitY(nje))
call SetSpecialEffectFacing(EFF , LoadReal(h,njide,SH_NejiAngle)* bj_RADTODEG)
call SetSpecialEffectZ(EFF , 40)
call SetSpecialEffectScale(EFF , 0.6)
call SetSpecialEffectVertexColour(EFF,255,255,255,220)
call RemoveEffect(EFF,1,true,CreateTimer())

//call SetControlToUnit(u,E,1+2*(I2R(LoadInteger(h,ide,StringHash("NejiDMG")))/(14*GetHeroAgi(u,true))), "stun")
//call BJDebugMsg(R2SW(I2R(LoadInteger(h,ide,StringHash("NejiDMG")))/(16*GetHeroAgi(u,true)),2,2))
call SaveInteger(h,njide,SH_NejiDMG,0)
call RemoveSavedInteger(h,njide,SH_NejiDMG)
call RemoveSavedReal(h,njide,SH_NejiAngle)
call GroupRemoveUnit(g,nje)
call SetUnitTimeScale(nje,1)
endloop
call PauseUnit(u,false)
call GroupClear(g)
call GroupClear(g2)
call GroupClear(g4)
call DestroyGroup(g)
call DestroyGroup(g2)
call DestroyGroup(g4)
call SetUnitVertexColor(u,255,255,255,255)
call FlushChildHashtable(h,id)
call RemoveSavedHandle(h,njide,SH_NejiDMG)
call RemoveSavedHandle(h,njide,SH_NejiAngle)
call FlushChildHashtable(h,njidg)
call SetUnitTimeScale(u,1)
call DestroyTimer(t)
endif
set g=null
set g2=null
if g4!=null then
call DestroyGroup(g4) // группа выбора цели этого тика
endif
set g4=null
set p=null
set u=null
set c=null
set c1=null
set c2=null
set t=null
set nje=null
endfunction
function NejiTCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveReal(h,id,7,0)
call SaveReal(h,id,8,0.2)
call SaveReal(h,id,9,0)
call SaveReal(h,id,10,x)
call SaveReal(h,id,11,y)
call SaveGroupHandle(h,id,12,CreateGroup())
call SaveGroupHandle(h,id,13,CreateGroup())
call SaveReal(h,id,5,Atan2(y1-y,x1-x))
call SaveUnitHandle(h,id,15,c)
call SetUnitVertexColor(u,255,255,255,255)
call SetUnitTimeScale(u,0.4)
set soundplay=SndN(1495) // Sound\Music\mp3Music\NejiT1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.03,true,function NejiTCast2)
set t=null
set u=null
set p=null
set c=null
endfunction
function NejiRCond takes nothing returns boolean
return GetSpellAbilityId()=='A1LL' and udg_B==true //nejiR start
endfunction
function NejiRCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=LoadReal(h,id,5)
local real dmg=(GetUnitAbilityLevel(u,'A1LL')+4)*GetHeroAgi(u,true)
local player p=GetOwningPlayer(u)
local real time=LoadReal(h,id,7)
local real speed=LoadReal(h,id,8)
local real count=LoadReal(h,id,9)
// конец раунда, Неджи или цель умерли — сразу к развязке без урона (раньше при смерти цели на подходе таймер висел вечно)
local boolean njstop=udg_B==false or UnitIsAlive(u)==false or UnitIsAlive(c)==false
if njstop then
call SaveReal(h,id,9,99)
set count=99
if time<=2 then
call SaveReal(h,id,7,2.02)
set time=2.02
endif
endif
if time==0.02 then
call SetUnitAnimation(u,"Spell Five")
set EFF=AddSpecialEffect("Hakke64.mdl", x, y)
call SetSpecialEffectZ(EFF , 50)
call SetSpecialEffectScale(EFF , 8)
call RemoveEffect(EFF,0.5,true,CreateTimer())
set n=CreateUnit(p,'e06G',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitTimeScale(n,0.7)
endif
if time<=1 then
call SetUnitTimeScale(u,1)
call SaveReal(h,id,7,time+0.02)
endif
if time<=1.5 and time>1 then
call SaveReal(h,id,7,time+0.02)
call SaveReal(h,id,5,Atan2(y1-y,x1-x))
call SetUnitAnimation(u,"walk")
call SetUnitXY_1(u,x+45*Cos(a),y+45*Sin(a), false)
call SetUnitFacingInstant(u,a*bj_RADTODEG)
if SR(x,y,x1,y1)<100 or time==1.5 then
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
call SaveReal(h,id,7,2.02)
call Push5(c,5,a,10,"")
set soundplay=SndN(1497) // Sound\Music\mp3Music\NejiR2_1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
call SaveReal(h,id,7,2.02)
call SaveReal(h,id,9,99)
endif
endif
endif
if count<=63 and time>1.5 and UnitIsAlive(u)==true and UnitIsAlive(c)==true then
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SetUnitInvulnerable(c,true)
if ModuloReal((time-2),speed)<0.02 then
set x1=x1-60*Cos(a)
set y1=y1-60*Sin(a)
call SetUnitXY_1(u,x1,y1, false)
call SetUnitAnimation(u,"attack")
call Push5(c,1,a,2,"")
call SetUnitTimeScale(u,R2I(time)-1)
set EFF=AddSpecialEffect("Minato-37.mdx", x1+GetRandomReal(25,65)*Cos(a+GetRandomReal(-20,20)*bj_DEGTORAD),y1+GetRandomReal(25,65)*Sin(a+GetRandomReal(-20,20)*bj_DEGTORAD))
call SetSpecialEffectScale(EFF , GetRandomReal(0.75,1.75))
call SetSpecialEffectZ(EFF , GetRandomReal(30,90))
call SetSpecialEffectRoll(EFF , 90)
call DestroyEffect(EFF)
set n=CreateUnit(p,'e1GZ',x,y,GetRandomReal(0,359))
call SetUnitTimeScale(u,5)
call UnitApplyTimedLife(n,'BTLF',0.25)
call SetUnitVertexColor(n,190,255,255,110)
call SetUnitAnimation(n,"attack")
call SaveReal(h,id,9,count+1)
if count==4 or count==8 or count==16 or count==32 then
call SaveReal(h,id,5,Atan2(y1-y,x1-x)+GetRandomReal(-25,25)*bj_DEGTORAD)
endif
endif
call SetUnitTimeScale(u,5)
call SaveReal(h,id,7,time+0.02)
call SetUnitFacing(u,a*bj_RADTODEG)
elseif time>2 then
set EFF=AddSpecialEffect("WindVectorPush.mdx", x1, y1)
call SetSpecialEffectFacing(EFF , a* bj_RADTODEG)
call SetSpecialEffectZ(EFF , 40)
call SetSpecialEffectScale(EFF , 0.6)
call SetSpecialEffectVertexColour(EFF,255,255,255,220)
call RemoveEffect(EFF,1,true,CreateTimer())
call SetUnitInvulnerable(c,false)
call SetUnitInvulnerable(u,false)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call PauseUnit(u,false)
if njstop then
// обрыв: без удара
elseif LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
call myCustomDamage(u,c,dmg,false,false,null,null,null)
call FrozenMinusManaCast(c,5)
call SetControlToUnit(u,c,2, "stun")
call Push3(c,45,a,700,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
else
call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
endif
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitVertexColor(u,255,255,255,255)
call SetUnitTimeScale(u,1)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
