call PauseTimer(t)
call SaveReal(h,id,5,1.3)
set timeWave=2.0*1.7/1
set spaceWave=2.0*3000/500
set radiusRatio=500/3000
set bj_lastCreatedTerrainDeformation=TerrainDeformRipple(x,y,3000,400,R2I(1.7*1000),1,spaceWave,timeWave,radiusRatio,false)
call ShakeCamera(0.5,20)
call TimerStart(t,0.12,true,function KaishinCast3)
endif
set p=null
set u=null
set t=null
endfunction
