function BlackGokuEBalls1 takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit target=LoadUnitHandle(HH,id,2)
local real facing=LoadReal(HH,id,3)
local real distance=LoadReal(HH,id,8)
local real time=LoadReal(HH,id,5)
local real dist=LoadReal(HH,id,18)
local real rd=SR(GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),LoadReal(HH,id,11),LoadReal(HH,id,12))
local real cof=rd/dist
local boolean targinv=false
local boolean targpaus=false
set time=time+0.02
call SaveReal(HH,id,5,time)
if distance<50 or time==5 then
call EffectCreateAndMoveAn(true,"BlackGoku\\[AB]by_wood_effect_qigongbo_hong.mdl",facing,1,2.5,1.5,100,100,100,50,50,LoadUnitHandle(HH,id,20),0,facing,1)
if GetUnitAbilityLevel(target,'Avul')>0 then
set targinv=true
call SetUnitInvulnerable(target,false)
endif
if IsUnitPaused(target)==true then
set targpaus=true
call PauseUnit(target,false)
endif
call DamageAoeOneTime0(caster,GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),200,LoadReal(HH,id,15))
if targinv==true then
call SetUnitInvulnerable(target,true)
endif
if targpaus==true then
call PauseUnit(target,true)
endif
call RemoveUnit(LoadUnitHandle(HH,id,20))
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else
call SetUnitFlyHeight(LoadUnitHandle(HH,id,20),LoadReal(HH,id,10)*cof,0)
call MoveUnit(LoadUnitHandle(HH,id,20),LoadUnitHandle(HH,id,20),LoadReal(HH,id,9),facing)
call SaveReal(HH,id,8,distance-LoadReal(HH,id,9))
endif
set caster=null
set target=null
endfunction
function BlackGokuEBalls takes unit caster1,unit target1,real x00,real y00,real facing0,real damage0 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real randomspeed=GetRandomReal(35,45)
local real randomDist=GetRandomReal(-100,200)
local real randomFacing=facing0+GetRandomReal(-45,45)
call SaveUnitHandle(HH,id,1,caster1)
call SaveUnitHandle(HH,id,2,target1)
call SaveReal(HH,id,15,damage0)
set x00=PolX(x00,randomDist,randomFacing)
set y00=PolY(y00,randomDist,randomFacing)
call SaveReal(HH,id,11,x00)
call SaveReal(HH,id,12,y00)
set n0=CreateUnit(GetOwningPlayer(caster1),'e200',GetUnitX(caster1),GetUnitY(caster1),facing0)
call SetUnitModel(n0,"BlackGoku\\xtyball3yellow.mdl")
call UnitSize(n0,0.5,1,1)
call SaveReal(HH,id,10,GetUnitFlyHeight(caster1)+100)
call SetUnitFlyHeight(n0,GetUnitFlyHeight(caster1)+100,0)
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call MoveUnit(n0,n0,100,facing0)
if GetRandomInt(1,2)==1 then
call MoveUnit(n0,n0,50,facing0+90)
else
call MoveUnit(n0,n0,50,facing0-90)
endif
call UnitSpeed(n0,1)
call SaveReal(HH,id,9,randomspeed)
call SetUnitAnimationByIndex(n0,0)
