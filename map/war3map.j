local real l__d=LoadReal(h,id,5)
local group g=LoadGroupHandle(h,id,6)
local player p=GetOwningPlayer(u)
local real dmg=LoadReal(h,id,17)
local real speed=LoadReal(h,id,14)
if l__d<5700 then
set x=x+l__d*Cos(a)
set y=y+l__d*Sin(a)
