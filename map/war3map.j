            set dmg = dmg * 1.15
        endif
        call myCustomDamage(u,c,dmg,false,false,null,null,null)
        call PauseUnit(c,true)
        call SetUnitInvulnerable(c,true)
        set n=CreateUnit(p,'eo9E',x1,y1,a*bj_RADTODEG)
        call SetUnitFlyHeight(n,15,0)
        call SetUnitScale(n,1.2,1.2,1.2)
        call UnitApplyTimedLife(n,1,1.2)
    endif
    if time==0.3 then
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\DantesBGR3.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        set EFF = AddSpecialEffect("az_juli01_Blue.mdx",x1,y1)
        call SetSpecialEffectScale(EFF, 1.2)
        call SetSpecialEffectZ(EFF, GetUnitFlyHeight(c)+60)
        call SetSpecialEffectTimeScale(EFF,0.2)
        call RemoveEffect(EFF,0.4,true,CreateTimer())
    endif
else
    call SetUnitAnimation(u,"Stand Ready")
    call PauseTimer(t)
    call SaveReal(h,id,3,2.3)

    call TimerStart(t,0.03,true,function RDantesCast4)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function RDantesCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real x2=0
local real y2=0
local integer i=LoadInteger(h,id,2)
local integer is=0
local real ig=30*bj_DEGTORAD
local player p=GetOwningPlayer(u)
local real a=Atan2(y1-y,x1-x)
local real f
local real dist=SR(x,y,x1,y1)
local real time=LoadReal(h,id,3)
if time==0.03 then
call SetUnitAnimation(u,"Stand Ready")
set EFF=AddSpecialEffect("AuraExplBlue.mdl", x, y)
call SetSpecialEffectScale(EFF , 0.8)
call DestroyEffect(EFF)
loop
exitwhen is>=13
set n=CreateUnit(p,'e0ZH',x+400*Cos(ig*is),y+400*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,255,255,255,35)
call UnitApplyTimedLife(n,1,1)
call SetUnitTimeScale(n,1)
set is=is+1
endloop
endif
call SaveReal(h,id,3,time+0.03)
if time<1.1 then
    call PauseUnit(u,true)
    call SetUnitInvulnerable(u,true)
else
    if time==1.11 then
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\DantesBGR7.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
    endif
    if dist>120 and UnitIsAlive(u)and UnitIsAlive(c) and time<6 then
        set x=x+65*Cos(a)
        set y=y+65*Sin(a)
        call SetUnitXY_1(u,x,y, false)
        call SetUnitFacing(u,a*bj_RADTODEG)
        set n=CreateUnit(p,'e3QV',x,y,a*bj_DEGTORAD)
        call UnitApplyTimedLife(n,1,0.14)
        call SetUnitVertexColor(n,255,255,255,50)
        call SetUnitAnimation(n,"walk")
        if dist<240 then
            call SetUnitAnimation(u,"Spell Four")
        else
            call SetUnitAnimation(u,"walk")
        endif
    elseif UnitIsAlive(c) then
        if time>=6 then
            call SetUnitXY_1(u,x1,y1, false)
        endif
        if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
            call PauseUnit(c,true)
            call SetUnitInvulnerable(c,true)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
            call SaveReal(h,id,3,0)
            //call UnitAddAbility(c,'A1US')
            call UnitEnableAutoOrientation(u,false)
            call SetUnitOrientation(u,GetUnitFacing(u),25,0)
            call SetUnitFlyHeight(c,115,0)
            set soundplay=CreateSound("Sound\\Music\\mp3Music\\DantesR2.mp3",false,false,true,12700,12700,"")
            call StartSound(soundplay)
            call KillSoundWhenDone(soundplay)
            set soundplay=CreateSound("Sound\\Music\\mp3Music\\DantesBGR2.mp3",false,false,true,12700,12700,"")
            call StartSound(soundplay)
            call KillSoundWhenDone(soundplay)
            call PauseTimer(t)
            set n=CreateUnit(p,'ed0O',x1,y1,a*bj_RADTODEG)
            call SetUnitTimeScale(n,0.3)
            call UnitApplyTimedLife(n,1,3)
            call SetUnitScale(n,1.1,1.1,1.1)
            call SetUnitVertexColor(n,255,255,255,170)
            call TimerStart(t,0.03,true,function RDantesCast3)
        else
            call PauseUnit(u,false)
            call SetUnitInvulnerable(u,false)
            call SetUnitVertexColor(u,255,255,255,255)
            call SetUnitTimeScale(u,1)
            call PauseTimer(t)
            call SetUnitFlyHeight(u,0,0)
            call DestroyTimer(t)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
            call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
            call FlushChildHashtable(h,id)
        endif
    else
        call SetUnitTimeScale(u,1)
        call PauseUnit(u,false)
        call SetUnitInvulnerable(u,false)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
    endif
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function RDantesCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
local player p=GetOwningPlayer(u)
if GetUnitAbilityLevel(u, 'CB01') > 0 then
    call SaveBoolean(h,id,4,true)
else
    call SaveBoolean(h,id,4,false)
endif
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveReal(h,id,3,0)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call UnitAddAbility(u,'Arav')
call UnitRemoveAbility(u,'Arav')
set soundplay=CreateSound("Sound\\Music\\mp3Music\\DantesR1.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\DantesBGR1.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call SetUnitTurnSpeed(u,5000.00)
call SetUnitTimeScale(u,2)
call TimerStart(t,0.03,true,function RDantesCast2)
set p=null
set u=null
set t=null
endfunction
function InitTrig_RDantes takes nothing returns nothing
set gg_trg_RDantes=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_RDantes,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_RDantes,Condition(function RDantesCond))
call TriggerAddAction(gg_trg_RDantes,function RDantesCast)
endfunction
function TDantesCond takes nothing returns boolean
return GetSpellAbilityId()=='Ad8T'
endfunction

function RemoveUnitTimedLoop takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    if LoadUnit("unit") != null then
          call RemoveUnit(LoadUnit("unit"))
    endif
    call RemoveSavedHandle(HH,id,StringHash("unit"))
    call FlushChildHashtable(HH,id)
    call DestroyTimer(t)
    set t = null
endfunction

function RemoveUnitTimed takes unit a, real time returns nothing
    local integer hId = GetPlayerId(GetTriggerPlayer())
    local timer t=CreateTimer()
    local integer id = GetHandleId(t)
    if a != null and not IsUnitType(a, UNIT_TYPE_HERO) then
        call SaveAgentHandle(HH,id,StringHash("unit"),a)
    endif
    call SaveReal(HH,id,TIME_HASH, time)
    call TimerStart(t,time,false,function RemoveUnitTimedLoop)
    set t = null
endfunction

function TDantesCast8 takes nothing returns nothing
