function CastKagutsuchi takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
call SaveUnitHandle(h,id,0,u)
if GetUnitAbilityLevel(GetTriggerUnit(),'A12O')==1 then
    call SaveReal(h,id,3,x1)
    call SaveReal(h,id,4,y1)
    call SaveReal(h,id,8,a)
    call SaveReal(h,id,11,SR(x,y,x1,y1)/30)
    call SaveReal(h,id,15,500/30)
    call UnitAddAbility(LoadUnitHandle(h,GetHandleId(u),SusanoCnst),'S009')
    set soundplay=CreateSound("Sound\\Music\\mp3Music\\Enton Susanoo Kagatsuchi.mp3",false,false,true,12700,12700,"")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    call PauseUnit(u,true)
    call TimerStart(t,0.02,true,function KagutsuchiCast2)
elseif GetUnitAbilityLevel(GetTriggerUnit(),'A12P')==1 then
    call SaveReal(h,id,3,x1)
    call SaveReal(h,id,4,y1)
    call SaveReal(h,id,8,a)
    call SaveReal(h,id,11,SR(x,y,x1,y1)/30)
    call SaveReal(h,id,15,600/30)
    call UnitAddAbility(LoadUnitHandle(h,GetHandleId(u),SusanoCnst),'S00B')
    set soundplay=CreateSound("war3mapImported\\SasukeT2.mp3",false,false,true,12700,12700,"")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    call PauseUnit(u,true)
    call TimerStart(t,0.02,true,function KagutsuchiCast3)
endif
set u=null
set p=null
set t=null
endfunction
function KatonGoruukaFly2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
local real dist=LoadReal(h,id,6)
local real mh=LoadReal(h,id,5)
local real rad=LoadReal(h,id,7)
local real rd=SR(x,y,x1,y1)
local real dmg=LoadReal(h,id,8)
local real dmg2=LoadReal(h,id,9)
local integer m=LoadInteger(h,id,13)
local player p=GetOwningPlayer(l__d)
local integer idu=GetPlayerId(p)
local real to=GetUnitFlyHeight(l__d)*0.01
if to*2<speed then
set speed=speed-to/2
else
set speed=speed-to/8
endif
if rd>30+speed and IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,ParabolaZ(mh,dist,rd),0)
if m!=1 and dist/2>rd then
call SaveInteger(h,id,13,1)
call SetUnitAnimationByIndex(l__d,1)
endif
else
call GroupEnumUnitsInRange(G,x1,y1,rad,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
call GroupRemoveUnit(G,E)
if Condition_Base(p,E)then
call myCustomDamage(Hero[idu],E,dmg,false,false,null,null,null)
call PoisonDamage3(Hero[idu],E,dmg2,14,"war3mapImported\\amaterasu2.mdx","origin")
endif
endloop
call UnitApplyTimedLife(CreateUnit(p,'e048',x1,y1,0),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e03W',x1,y1,0),0,4)
call UnitApplyTimedLife(CreateUnit(p,'e06O',x1,y1,0),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e06N',x1,y1,0),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0RH',x1,y1,(a*bj_RADTODEG)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0RK',x1,y1,(a*bj_RADTODEG)),1,3)
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,1.2,1.2,1.2)
call SetUnitTimeScale(n,0.6)
call SetUnitVertexColor(n,255,230,100,50)
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitTimeScale(n,0.6)
call SetUnitVertexColor(n,255,230,100,50)
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,1.7,1.7,1.7)
call SetUnitTimeScale(n,0.6)
call SetUnitVertexColor(n,255,230,100,50)
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,1.9,1.9,1.9)
call SetUnitTimeScale(n,0.6)
call SetUnitVertexColor(n,255,230,100,50)
call UnitApplyTimedLife(CreateUnit(p,'e0C7',x1,y1,(a*bj_RADTODEG)),1,6)
call DestroyEffect(AddSpecialEffect("war3mapImported\\SuperBigExplosion.mdx",x1,y1))
call KillUnit(l__d)
call AddUnitAnimationProperties(l__d,"dragon",false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set l__d=null
set t=null
endfunction
function KatonGoruukaFly takes unit l__d,real speed,real angle,real x,real y,real mh,real r,real dmg,real dmg2 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,mh)
call SaveReal(h,id,6,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,7,r)
call SaveReal(h,id,8,dmg)
call SaveReal(h,id,9,dmg2)
call SaveInteger(h,id,13,0)
call AddUnitAnimationProperties(l__d,"dragon",true)
call TimerStart(t,0.02,true,function KatonGoruukaFly2)
set t=null
endfunction
function KatonGoruukaCond takes nothing returns boolean
return GetSpellAbilityId()=='A006' and GetUnitAbilityLevel(GetTriggerUnit(),'A40X')>0
endfunction
function KatonGoruukaCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x1=GetSpellTargetX()+1.0
local real y1=GetSpellTargetY()+1.0
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x2=0
local real y2=0
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroAgi(u,true)*(1+GetUnitAbilityLevel(u,'A006'))+75*GetUnitAbilityLevel(u,'A006')
local real dmg2=GetHeroAgi(u,true)*(1+GetUnitAbilityLevel(u,'A006')*0.5)
local integer i=0
if SR(x,y,x1,y1)<800 then
