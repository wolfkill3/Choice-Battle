function Trig_die6_Conditions takes nothing returns boolean
return GetUnitTypeId(GetTriggerUnit())=='H34X' or GetUnitTypeId(GetTriggerUnit())=='H14F' or GetUnitAbilityLevel(GetTriggerUnit(),'A2X2')>0 or GetUnitAbilityLevel(GetTriggerUnit(),'B03P')>0 or GetUnitAbilityLevel(GetTriggerUnit(),'B03O')>0 or GetUnitAbilityLevel(GetTriggerUnit(),'B03Q')>0 or GetUnitAbilityLevel(GetTriggerUnit(),'B01N')>0 or GetUnitAbilityLevel(GetTriggerUnit(),'B01Z')>0 or GetUnitAbilityLevel(GetTriggerUnit(),'B02A')>0 or GetUnitAbilityLevel(GetTriggerUnit(),'B11N')>0 
endfunction
function Trig_die6_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
if (GetUnitTypeId(u)=='H34X' or GetUnitTypeId(u)=='H14F') and GetUnitAbilityLevel(u,'A2X2')==0 then
set EFF=AddSpecialEffect("war3mapImported\\shadowclone.mdx",GetUnitX(u),GetUnitY(u))
call SetSpecialEffectScale(EFF,1.3)
call DestroyEffect(EFF)
else
set EFF=AddSpecialEffect("war3mapImported\\a-bomb.mdx",GetUnitX(u),GetUnitY(u))
call SetSpecialEffectScale(EFF,0.6)
call DestroyEffect(EFF)
endif
if GetUnitAbilityLevel(u,'B03P')>0 or GetUnitAbilityLevel(u,'B03O')>0 or GetUnitAbilityLevel(u,'B03Q')>0 or GetUnitAbilityLevel(u,'B01N')>0 or GetUnitAbilityLevel(u,'B01Z')>0 or GetUnitAbilityLevel(u,'B02A')>0 then
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",GetUnitX(u),GetUnitY(u)))
endif
if GetUnitAbilityLevel(u,'B11N')>0 then
call DestroyEffect(AddSpecialEffect("war3mapImported\\Flameshock.mdx",GetUnitX(u),GetUnitY(u)))
endif
call RemoveUnit(u)
set u=null
endfunction
function InitTrig_die6 takes nothing returns nothing
set gg_trg_die6=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_die6,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(gg_trg_die6,Condition(function Trig_die6_Conditions))
call TriggerAddAction(gg_trg_die6,function Trig_die6_Actions)
endfunction
function Trig_Amaterasu_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A03B'
endfunction
function Trig_Amaterasu_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,3)
local real x=LoadReal(h,id,1)
local real y=LoadReal(h,id,2)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real a=Atan2(y-y1,x-x1)
local integer i=0
local real time=LoadReal(h,id,6)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroInt(u,true)*GetUnitAbilityLevel(u,'A03B')*0.05
if SR(x,y,x1,y1)>50 then
call SetUnitX(l__d,x1+60*Cos(a))
call SetUnitY(l__d,y1+60*Sin(a))
call UnitApplyTimedLife(CreateUnit(p,'e04F',x1,y1,a*bj_RADTODEG),'BTLF',2)
else
if time<=7 then
call SaveReal(h,id,6,time+0.1)
if LoadBoolean(h,id,5)==false then
set n=CreateUnit(p,'h019',x,y,0)
call UnitApplyTimedLife(n,'BTLF',1)
call UnitAddAbility(n,'A00B')
call IssuePointOrder(n,"flamestrike",x,y)
call SetUnitScale(l__d,2,2,2)
call DestroyEffect(AddSpecialEffect("war3mapImported\\DarkNova.mdx",x,y))
call UnitApplyTimedLife(CreateUnit(p,'e04G',x,y,0),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e04E',x,y,0),'BTLF',7)
call SaveBoolean(h,id,5,true)
endif
call GroupEnumUnitsInRange(G,x,y,500,Base)
loop
set E=FirstOfGroup(G)
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 1, "silence")
endif
call GroupRemoveUnit(G,E)
exitwhen E==null
endloop
else
call PauseTimer(t)
call DestroyTimer(t)
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
endif
endif
set t=null
set u=null
set l__d=null
set p=null
endfunction
function Trig_Amaterasu_Actions takes nothing returns nothing
local timer t=CreateTimer()
local unit u=GetTriggerUnit()
