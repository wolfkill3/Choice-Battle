function RulerRCast4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=0
local real y1=0
local group g=LoadGroupHandle(h,id,2)
local group gg
local group g3=LoadGroupHandle(h,id,4)
local real dmg=(0.25+GetUnitAbilityLevel(u,'A1GZ')*0.05)*GetHeroInt(u,true)
local unit ug
local real time=LoadReal(h,id,1)
local real an=GetRandomReal(0,6.28)
if time>0 then
call SaveReal(h,id,1,time-0.2)
set gg=CopyGroup(g)
loop
set E=FirstOfGroup(gg)
exitwhen E==null
set x1=GetUnitX(E)
set y1=GetUnitY(E)
call GroupEnumUnitsInRange(G,x1,y1,180,Base)
loop
set ug=FirstOfGroup(G)
exitwhen ug==null
call GroupAddUnit(g3,ug)
call GroupRemoveUnit(G,ug)
endloop
call GroupRemoveUnit(gg,E)
endloop
call DestroyGroupTimed(gg,3)
loop
set E=FirstOfGroup(g3)
exitwhen E==null
if IsUnitAlly(E,p)==false then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
else
call HealTextTag(u,E,dmg*0.5*myCustomHeal2(E,1),"HealthRes")
call SetUnitState(E,UNIT_STATE_LIFE,GetUnitState(E,UNIT_STATE_LIFE)+dmg*0.5)
endif
call GroupRemoveUnit(g3,E)
endloop
else
call ForGroup(g,function KillGroup)
call DestroyGroup(g)
call DestroyGroup(g3)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set gg=null
set g3=null
set p=null
set u=null
set t=null
endfunction
