function CondBOO takes nothing returns boolean
return GetSpellAbilityId()==0x4130414D and udg_B
endfunction
function CastBOO2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,1)
local integer i=0
local item it
call PauseUnit(u,true)
if LoadBoolean(h,GetHandleId(u),StringHash("bullet"))==false or UnitIsAlive(u)==false then
loop
set E=FirstOfGroup(g)
call UnitRemoveAbility(E,'A0YT')
call SetUnitOwner(E,LoadPlayerHandle(h,GetHandleId(E),StringHash("CS")),true)
call GroupRemoveUnit(g,E)
set i=0
loop
exitwhen i>=6
set it=UnitItemInSlot(E,i)
call SetItemDroppable(it,true)
set i=i+1
endloop
exitwhen E==null
endloop
call DestroyGroup(g)
call PauseUnit(u,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set it=null
set g=null
set u=null
set t=null
set p=null
endfunction
function CastBOO takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local group l__n=LoadGroupHandle(h,GetHandleId(u),StringHash("GB"))
local group g=CopyGroup(l__n)
local integer i=0
local item it
call SaveUnitHandle(h,id,0,u)
call PauseUnit(u,true)
call SetUnitAnimation(u,"death")
call SaveGroupHandle(h,id,1,g)
loop
set E=FirstOfGroup(l__n)
call SetUnitOwner(E,p,true)
call UnitAddAbility(E,'A0YT')
set i=0
loop
exitwhen i>=6
set it=UnitItemInSlot(E,i)
call SetItemDroppable(it,false)
set i=i+1
endloop
call GroupRemoveUnit(l__n,E)
exitwhen E==null
endloop
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Undead\\UndeadDissipate\\UndeadDissipate.mdl",u,"origin"))
call TimerStart(t,0.1,true,function CastBOO2)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Mukuro2Form2.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call DestroyGroup(l__n)
set it=null
set l__n=null
set g=null
set u=null
set t=null
set p=null
endfunction
