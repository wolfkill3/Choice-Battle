function Trig_Goddess_Actions takes nothing returns nothing
    set bj_forLoopAIndex=0
    set bj_forLoopAIndexEnd=10
    loop
    exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
    //call BJDebugMsg(Id2String(GetUnitTypeId(udg_Hero[GetForLoopIndexA()])))
    if GetUnitTypeId(udg_Hero[GetForLoopIndexA()]) == 'HMad' then
        call UnitAddAbility(udg_Hero[GetForLoopIndexA()], 'MaF3')
        call IssueImmediateOrder(udg_Hero[GetForLoopIndexA()], "bearform")
        call UnitRemoveAbility(udg_Hero[GetForLoopIndexA()], 'MaF3')
        if GetHeroLevel(udg_Hero[GetForLoopIndexA()]) >= 25 then
            call ShowAbility2( 'MaT1' , false)
            call UnitAddAbility(udg_Hero[GetForLoopIndexA()], 'MaT2')
        endif
        call UnitAddAbility(udg_Hero[GetForLoopIndexA()], 'MaE2')
        call UnitAddAbility(udg_Hero[GetForLoopIndexA()], 'MaR2')
        call ShowAbility2( 'MaE1' , false)
        call ShowAbility2( 'MadR' , false)
    elseif GetUnitTypeId(udg_Hero[GetForLoopIndexA()]) == 'HMaG' then      // Madoka Goddess обратно в обычную 
        call ShowAbility2( 'MaT1' , true)
        call ShowAbility2( 'MaE1' , true)
        call ShowAbility2( 'MadR' , true)
        call UnitRemoveAbility(udg_Hero[GetForLoopIndexA()], 'MaE2')
        call UnitRemoveAbility(udg_Hero[GetForLoopIndexA()], 'MaR2')
        call UnitAddAbility(udg_Hero[GetForLoopIndexA()], 'MaF4')
        call IssueImmediateOrder(udg_Hero[GetForLoopIndexA()], "bearform")
        call UnitRemoveAbility(udg_Hero[GetForLoopIndexA()], 'MaF4')
        if LoadInteger(HH,GetPlayerId(GetOwningPlayer(udg_Hero[GetForLoopIndexA()])),10)!=1  and LoadUnitHandle(HH,GetPlayerId(GetOwningPlayer(udg_Hero[GetForLoopIndexA()])),StringHash("kyubei"))==null then
            set bjLCT=CreateTimer()
            call SaveInteger(HH,GetHandleId(bjLCT),0,GetPlayerId(GetOwningPlayer(udg_Hero[GetForLoopIndexA()])))
            call SaveInteger(HH,GetPlayerId(GetOwningPlayer(udg_Hero[GetForLoopIndexA()])),10,1)
            call SaveUnitHandle(HH,GetPlayerId(GetOwningPlayer(udg_Hero[GetForLoopIndexA()])),StringHash("kyubei"),CreateUnit(GetOwningPlayer(udg_Hero[GetForLoopIndexA()]),'dM57',GetUnitX(udg_Hero[GetForLoopIndexA()])+GetRandomReal(-100,100),GetUnitY(udg_Hero[GetForLoopIndexA()])+GetRandomReal(-100,100),GetRandomReal(6.28,0)))
            call TimerStart(bjLCT,0.1,true,function MadokaKyubei2)
            set bjLCT=null
        endif
    endif
    set bj_forLoopAIndex=bj_forLoopAIndex+1
    endloop
endfunction
function Trig_UIunlock_Actions takes nothing returns nothing
    set bj_forLoopAIndex=0
    set bj_forLoopAIndexEnd=10
    loop
    exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
        if LoadBoolean(HH,GetHandleId( GetOwningPlayer(Hero[GetForLoopIndexA()]) ),UIAvailableHash)==false then
            call SaveBoolean(HH,GetHandleId( GetOwningPlayer(Hero[GetForLoopIndexA()])) ,MUIAvailableHash,true)
            set MUIUnlock[GetPlayerId(GetOwningPlayer(Hero[GetForLoopIndexA()]))]=CreateUnit(GetOwningPlayer(Hero[GetForLoopIndexA()]),'h111',RX,RY,0)
            call SaveBoolean(HH,GetHandleId( GetOwningPlayer(Hero[GetForLoopIndexA()])) ,UIAvailableHash,true)
            set UIUnlock[GetPlayerId(GetOwningPlayer(Hero[GetForLoopIndexA()]))]=CreateUnit(GetOwningPlayer(Hero[GetForLoopIndexA()]),'h110',RX,RY,0)
        else
            call SaveBoolean(HH,GetHandleId( GetOwningPlayer(Hero[GetForLoopIndexA()])) ,MUIAvailableHash,false)
            call RemoveUnit(MUIUnlock[GetPlayerId(GetOwningPlayer(Hero[GetForLoopIndexA()]))])
            call SaveBoolean(HH,GetHandleId( GetOwningPlayer(Hero[GetForLoopIndexA()])) ,UIAvailableHash,false)
            call RemoveUnit(UIUnlock[GetPlayerId(GetOwningPlayer(Hero[GetForLoopIndexA()]))])
            call SaveReal(HH,GetHandleId( GetOwningPlayer(Hero[GetForLoopIndexA()]) ),UIDMGHash,0)
            call SaveReal(HH,GetHandleId( GetOwningPlayer(Hero[GetForLoopIndexA()]) ),UILimitDMGHash,GetUnitMaxLife(Hero[GetForLoopIndexA()])*2)
        endif
    set bj_forLoopAIndex=bj_forLoopAIndex+1
    endloop
endfunction
function Trig_cd_Actions takes nothing returns nothing
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=12
    loop
    exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
    call UnitResetCooldown(udg_Hero[GetForLoopIndexA()])
    call UnitResetCooldown(Lucy[GetForLoopIndexA()-1])
    call SaveReal(HH,GetHandleId(Darkness[GetForLoopIndexA()]),StringHash("darkHP"),LoadReal(HH,GetHandleId(Darkness[GetForLoopIndexA()]),StringHash("darkMaxHP")))
    call SaveReal(HH,GetHandleId(Darkness[GetForLoopIndexA()]),StringHash("revivetime"),35)
    call SaveReal(HH,GetHandleId(LoadFrameHandle(HH, GetHandleId(GetOwningPlayer(udg_Hero[GetForLoopIndexA()])),StringHash("ReplaceableTextures\\CommandButtons\\BTNTobiramaW2.blp"))), c_DURATION, 0)
    call SaveReal(HH,GetHandleId(LoadFrameHandle(HH, GetHandleId(GetOwningPlayer(udg_Hero[GetForLoopIndexA()])),StringHash("ReplaceableTextures\\CommandButtons\\BTNTobiramaFSelf.blp"))), c_DURATION, 0)
    if GetUnitTypeId(udg_Hero[GetForLoopIndexA()]) == 'H069' then
    call SaveReal(HH,GetHandleId(GetOwningPlayer(udg_Hero[GetForLoopIndexA()])),StringHash("CE"),0)
    endif
    set bj_forLoopAIndex=bj_forLoopAIndex+1
    endloop
endfunction
function Trig_setmr_Actions takes nothing returns nothing
    local integer LvlS=S2I(SubString(GetEventPlayerChatString(),7,11))
    set passedTime = (-1)*R2I(LvlS/5)
    call UpdateMultiboard()
    call DisplayTextToPlayer(Player(GetPlayerId(GetTriggerPlayer())),0,0,"Всегда идет округление до кратных 5 чисел, в меньшую сторону")
endfunction
