function Trig_Bone_Stomp_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A01A'
endfunction
function Stomp_Filter takes nothing returns boolean
return IsPlayerEnemy(GetOwningPlayer(GetTriggerUnit()),GetOwningPlayer(GetFilterUnit()))and GetWidgetLife(GetFilterUnit())>0.405 and not IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)and not IsUnitType(GetFilterUnit(),UNIT_TYPE_FLYING)
endfunction
function Bone_Stomp_Move takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local integer level=LoadInteger(h,id,0)
local group g=LoadGroupHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local real dur=LoadReal(h,id,4)+0.05
local real speed=LoadReal(h,id,5)
local real dist=LoadReal(h,id,6)+speed
local group l__n=CopyGroup(g)
local real tx
local real ty
local real a
local unit e
if dur<1 then
loop
set e=FirstOfGroup(l__n)
exitwhen e==null
set tx=GetUnitX(e)
set ty=GetUnitY(e)
set a=Atan2(ty-y,tx-x)
if GetUnitState(e,UNIT_STATE_LIFE)>0.405 and not IsTerrainPathable(tx+speed*Cos(a),ty+speed*Sin(a),PATHING_TYPE_FLYABILITY)then
call SetUnitX(e,tx+speed*Cos(a))
call SetUnitY(e,ty+speed*Sin(a))
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl",tx,ty))
else
call GroupRemoveUnit(g,e)
endif
call GroupRemoveUnit(l__n,e)
endloop
call SaveReal(h,id,4,dur)
call SaveReal(h,id,5,speed-(1.2-0.2*level))
call SaveReal(h,id,6,dist)
else
call GroupClear(g)
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
call DestroyGroup(l__n)
set l__n=null
set e=null
set t=null
set g=null
endfunction
function Trig_Bone_Stomp_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local integer level=GetUnitAbilityLevel(u,'A01A')
local boolexpr b=Condition(function Stomp_Filter)
local group g=CreateGroup()
local group l__n
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real dmg=100*GetUnitAbilityLevel(u,'A01A')+3*GetHeroAgi(u,true)
local integer i=0
local unit l__d
call GroupEnumUnitsInRange(g,x,y,300,b)
set l__n=CopyGroup(g)
loop
set E=FirstOfGroup(l__n)
exitwhen E==null
