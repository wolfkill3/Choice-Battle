function GilgameshQ1_Periodic takes nothing returns nothing
	local integer id 	= GetHandleId(GetExpiredTimer())
	local unit caster	= LoadUnitHandle(h, id, 0)
	local unit target	= LoadUnitHandle(h, id, 1)
	local real angle	= SquareRootUnit(caster, target)
	local real caster_x	= GetUnitX(caster)
	local real caster_y	= GetUnitY(caster)
	local real target_x = GetUnitX(target)
	local real target_y = GetUnitY(target)
	if SquareRootUnit(caster, target)>50 then
		call SetUnitX(caster, caster_x+60*Cos(angle))
		call SetUnitY(caster, caster_y+60*Sin(angle))
		set n=CreateUnit(GetOwningPlayer(caster),'e0WT',caster_x,caster_y,angle*bj_RADTODEG)
		call UnitApplyTimedLife(n,'B000',0.25)
		call SetUnitVertexColor(n,255,255,255,155)
		call SetUnitTimeScale(n,2)
		call SetUnitAnimation(n,"attack")
		call SetUnitAnimation(caster,"attack")
	else
		call SetUnitX(caster,LoadReal(h,id,2))
		call SetUnitY(caster,LoadReal(h,id,3))
		call myCustomDamage(caster,target,LoadReal(h, id, 4),false,false,null,null,null)
        call SlowUnit(caster,target,0.9,0,5,2,false)
		call MyRemoveUnit(n,0.1)
		call Push(target,30,angle,300)
		call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(caster),'e03X',target_x,target_y,GetRandomReal(0,359)),1,1)
		call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(caster),'e03W',target_x,target_y,GetRandomReal(0,359)),1,1)
		call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(caster),'e08R',target_x,target_y,GetRandomReal(0,359)),1,1)
		call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(caster),'e03Y',target_x,target_y,GetRandomReal(0,359)),1,1)
		call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(caster),'e08N',target_x,target_y,GetRandomReal(0,359)),1,1)
		call PauseUnit			(caster, false)
		call SetUnitInvulnerable(caster, false)
		call UnitRemoveAbility	(caster, 'A0BX')
		call FlushChildHashtable(h, id)
		call DestroyTimer		(GetExpiredTimer())
	endif
endfunction

function GilgameshQ1_Cast takes unit newCaster, unit newTarget, real point_x, real point_y returns nothing
        local timer   newTimer  = CreateTimer()
        local integer id                = GetHandleId(newTimer)
        local real        damage        = 2*GetUnitTotalDamage(newCaster) + (1+GetUnitAbilityLevel(newCaster, 'GiQ1'))*GetHeroInt(newCaster, true)
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\DestroyStorms.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        call PauseUnit                  (newCaster, true)
        call SetUnitInvulnerable(newCaster, true)
        call UnitAddAbility             (newCaster, 'A0BX')
        call SaveUnitHandle     (h, id, 0, newCaster)
        call SaveUnitHandle     (h, id, 1, newTarget)
        call SaveReal           (h, id, 2, GetUnitX(newCaster))
        call SaveReal           (h, id, 3, GetUnitY(newCaster))
        call SaveReal           (h, id, 4, damage)
        call TimerStart         (newTimer, 0.025, true, function GilgameshQ1_Periodic)
        set newTimer=null
endfunction

function GilgameshW1_Periodic takes nothing returns nothing
        local timer newT        = GetExpiredTimer()
        local integer id        = GetHandleId(newT)
        local real duration = LoadReal(h, id, 1)
        if duration>0 and udg_B and UnitIsAlive(LoadUnitHandle(h, id, 0)) then
                call SaveReal(h, id, 1, duration-0.1)
        else
                call UnitRemoveAbility(LoadUnitHandle(h, id, 0), 'Gi01')
                call FlushChildHashtable(h, id)
                call DestroyTimer(newT)
        endif
        set newT=null
endfunction

function GilgameshW1_Cast takes unit newCaster returns nothing  // Право Короля: Кишар || Ō TADASHI KEN KISHARU
        local timer newT        = CreateTimer()
        local integer id        = GetHandleId(newT)
        call UnitAddAbility(newCaster, 'Gi01')
        call UnitMakeAbilityPermanent(newCaster, true, 'Gi01')
        call SaveUnitHandle     (h, id, 0, newCaster)
        call SaveReal           (h, id, 1, 10)  // Duration
        call TimerStart         (newT, 0.1, true, function GilgameshW1_Periodic)
        set newT=null
endfunction

function GilgameshW2_Cast takes unit newCaster, real point_x, real point_y returns nothing
        local real caster_x = GetUnitX(newCaster)
        local real caster_y = GetUnitY(newCaster)
        local real angle        = AtanPoint(caster_x, caster_y, point_x, point_y)
        if SquareRootPoint(caster_x, caster_y, point_x, point_y)>700 then
                call SetUnitXY(newCaster, caster_x+700*Cos(angle), caster_y+700*Sin(angle))
        else
                call SetUnitXY(newCaster, point_x, point_y)
        endif
        call UnitAddAbility(newCaster, 'ReFm')
        call UnitAddAbility(newCaster, 'ReFa')
        call UnitMakeAbilityPermanent(newCaster, true, 'ReFm')
        call UnitMakeAbilityPermanent(newCaster, true, 'ReFa')
        call UnitRemoveAbilityTimedPause(newCaster, 'ReFm', 2)
        call UnitRemoveAbilityTimedPause(newCaster, 'ReFa', 2)
endfunction

function GilgameshW3_Periodic takes nothing returns nothing
        local timer newT        = GetExpiredTimer()
        local integer id        = GetHandleId(newT)
        local unit caster       = LoadUnitHandle(h, id, 4)
        local real duration = LoadReal(h, id, 1)
        if duration>0 and udg_B and UnitIsAlive(caster) then
                call SaveReal(h, id, 1, duration-0.1)
                call SetWidgetLife(caster, GetWidgetLife(caster)+LoadReal(h, id, 2)/8)
                call SetWidgetLife(caster, GetWidgetLife(caster)+LoadReal(h, id, 3)/8)
        else
                call FlushChildHashtable(h, id)
                call DestroyTimer(newT)
        endif
        set newT=null
        set caster=null
endfunction

function GilgameshW3_Cast takes unit newCaster returns nothing  // Право Короля: Дамкина || Ō TADASHI KEN DAMUKINA
        local timer newT        = CreateTimer()
        local integer id        = GetHandleId(newT)
        call SaveUnitHandle     (h, id, 0, newCaster)
        call SaveReal           (h, id, 1, 4)   // Duration
        call SaveReal           (h, id, 2, GetWidgetLife(newCaster)*0.2)
        call SaveReal           (h, id, 3, GetWidgetMana(newCaster)*0.2)
        call SaveUnitHandle     (h, id, 4, newCaster)
        call TimerStart         (newT, 0.5, true, function GilgameshW3_Periodic)
        set newT=null
endfunction

function GilAttackCond takes nothing returns boolean
return GetLearnedSkill()=='A131'
endfunction

function GilgameshAADetails takes nothing returns nothing
        call DisplayTimedTextToPlayer(GetTriggerPlayer(), 0, 0, 7, "Подборности автоатаки Гильгамеша.")
        call DisplayTimedTextToPlayer(GetTriggerPlayer(), 0, 0, 7, "Теперь на мечи работают большая часть модификаторов автоатаки с 30% эффективностью. Для примера: Самехада теперь наносит (150+40% aa)*20% = 30+8% aa с каждого меча")
        call DisplayTimedTextToPlayer(GetTriggerPlayer(), 0, 0, 7, "  ")
        call DisplayTimedTextToPlayer(GetTriggerPlayer(), 0, 0, 7, "• Меч Анбу: 16.5 чистого урона")
        call DisplayTimedTextToPlayer(GetTriggerPlayer(), 0, 0, 7, "• Гегецебури: 30 чистого урона + вероятный стан уменьшен до 0.3 сек")
        call DisplayTimedTextToPlayer(GetTriggerPlayer(), 0, 0, 7, "• Самехада Манажор: 2.6% текущего мп выжигание за меч и 3.6% восстановление хп от вражеской текущей маны.")
        call DisplayTimedTextToPlayer(GetTriggerPlayer(), 0, 0, 7, "• Жилет Анбу: враг восстанавливает 35 хп за каждый меч.")
        call DisplayTimedTextToPlayer(GetTriggerPlayer(), 0, 0, 7, "• Комлпект Анбу: враг восстанавливает 50 хп за каждый меч.")
        call DisplayTimedTextToPlayer(GetTriggerPlayer(), 0, 0, 7, "• Все облака маре: эффект блокирования каждого кольца теперь работает на каждый меч Гильгамеша.")
        call DisplayTimedTextToPlayer(GetTriggerPlayer(), 0, 0, 7, "• Патриот: каждая автоатака отнимает 1 Allstat на 5 сек, но при этом уменьшается сила атаки Гильгамеша на 30% ед.")
        call DisplayTimedTextToPlayer(GetTriggerPlayer(), 0, 0, 7, "• Экскалибур: каждая автоатака восстанавливает 20% от урона меча после маг резистов. Каждая автоатака уменьшает броню на 1 на 10 сек.")
        call DisplayTimedTextToPlayer(GetTriggerPlayer(), 0, 0, 7, "• Темный экскалибур: пассивка работает также как и должна.")
        call DisplayTimedTextToPlayer(GetTriggerPlayer(), 0, 0, 7, "• Туфли Анбу/Комплект Анбу: Гильгамеш может промахиваться с шансом 35%.")
        call DisplayTimedTextToPlayer(GetTriggerPlayer(), 0, 0, 7, "• Демон Глаз: Гильгамеш полностью промахивается мечами.")
        call DisplayTimedTextToPlayer(GetTriggerPlayer(), 0, 0, 7, "• Патриот: активка дает возможность Гильгамешу не промахиваться.")
endfunction

function GilgameshAADetails_Int takes nothing returns nothing
        local trigger trig=CreateTrigger()
        local integer i=0
        loop
        exitwhen i>=12
                call TriggerRegisterPlayerChatEvent(trig,Player(i),"-gilmodif",true)
        set i=i+1
        endloop
    call TriggerAddAction(trig,function GilgameshAADetails)
        set trig=null
endfunction

function GilPatriotModifEnd takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(h,id,0)
        local unit c=LoadUnitHandle(h,id,1)
        call SetHeroAgi(u,GetHeroAgi(u,false)+1,true)
        call SetHeroStr(u,GetHeroStr(u,false)+1,true)
        call SetHeroInt(u,GetHeroInt(u,false)+1,true)
        call SetHeroAgi(c,GetHeroAgi(c,false)-1,true)
        call SetHeroStr(c,GetHeroStr(c,false)-1,true)
        call SetHeroInt(c,GetHeroInt(c,false)-1,true)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
        set u=null
        set c=null
        set t=null
endfunction

function GilExcaliburModifEnd2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    if IsUnitAlive(u)==true and u!=null then
        call SetUnitArmour(u,GetUnitArmour(u)+1)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
    elseif u==null then
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
    endif
    set u=null
    set t=null
endfunction

function GilExcaliburModifEnd takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(h,id,0)
        local unit c=LoadUnitHandle(h,id,1)
    if IsUnitAlive(u)==true then
        call SetUnitArmour(u, GetUnitArmour(u)+1)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
    else
        call TimerStart(t, 0.1, true, function GilExcaliburModifEnd2)
    endif
        set u=null
        set c=null
        set t=null
endfunction

function GilDarkExcaliburModifEnd takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(h,id,0)
        local integer id_caster=GetHandleId(u)
    local timer tt
	call UnitRemoveAbility(u, 'A26R')
	call FlushChildHashtable(h,id)
	call DestroyTimer(t)
	call SaveBoolean(h, id_caster, StringHash("ItemDarkExc_CD"), true)
	set tt=CreateTimer()
	call SaveUnitHandle(h, GetHandleId(tt), CasterHash, u)
	call TimerStart(tt, 9, false, function DarkExcalibur_CD)
	set tt=null
	set u=null
	set t=null
endfunction



function GilgameshModifiedAttack takes unit newCaster, unit newTarget returns boolean
    local real damage=GetUnitTotalDamage(newCaster)*0.4
    local real bonus_damage=0.0
    local real critcoef
    local boolean fatal_damage=false
    local boolean miss=false
    local timer tt
    
    set critcoef=1
	if GetUnitAbilityLevel(newCaster, 'A3IG')==0 then	// Патриот анти-миссы и миссы в целом
	
		if (UnitHasItemOfTypeBJ(newTarget, 'I03E') or UnitHasItemOfTypeBJ(newTarget, 'I03F') or GetUnitAbilityLevel(newTarget, 'KIJ2')>0 or GetUnitAbilityLevel(newTarget, 'KIJ4')>0) and GetRandomInt(0, 99)<=34 then	// Туфли или Комплект Анбу - уклонение
			set damage=0
			set miss=true
		endif
		
		if GetUnitAbilityLevel(newTarget, 'A14R')>0 or GetUnitAbilityLevel(newCaster, 'B037')>0 or GetUnitAbilityLevel(newCaster, 'cb10')>0 then	// Демон Глаз активка или слепота
			set damage=0
			set miss=true
		endif

		if GetUnitAbilityLevel(newCaster, 'cb12')>0 then 		// Промахи все
            call SaveReal(HH,GetHandleId(bufh),0,1)
            call HandleListEnumUnitBuffs(bufh,newCaster,Condition(function MissBool))
            call HandleListForEach(bufh,function MissBuff)
            if LoadReal(HH,GetHandleId(bufh),0)==0 then
                set damage=0
                set miss=true
            endif
            call FlushChildHashtable(HH,GetHandleId(bufh))
            call HandleListClear(bufh)	
		endif
	endif
	
	if IsUnitType(newCaster,UNIT_TYPE_HERO) and IsUnitIllusion(newCaster)==false and miss==false then
    if (LoadReal(HH,GetHandleId(newCaster),StringHash("yamato"))==1 or GetRandomInt(0,100)<15) and (UnitHasItemOfTypeBJ(newCaster,'I02V') or GetUnitAbilityLevel(newCaster,'KIG4')>0) and IsUnitType(newCaster, UNIT_TYPE_HERO) and IsUnitIllusion(newCaster)==false then
        call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",newTarget,"chest"))
        call SaveReal(HH,GetHandleId(newCaster),StringHash("yamato"),0)
        set critcoef=critcoef+2
    endif
	if GetRandomInt(0,100)<15 and (UnitHasItemOfTypeBJ(newCaster,'I01J') or GetUnitAbilityLevel(newCaster,'KI06')>0) and IsUnitType(newCaster, UNIT_TYPE_HERO) and IsUnitIllusion(newCaster)==false then
        set critcoef=critcoef+0.5
    endif
    if GetRandomInt(0,100)<15 and (UnitHasItemOfTypeBJ(newCaster,'I01I') or GetUnitAbilityLevel(newCaster,'KI08')>0) and IsUnitType(newCaster, UNIT_TYPE_HERO) and IsUnitIllusion(newCaster)==false then
        set critcoef=critcoef+0.75
    endif
    if GetRandomInt(0,100)<15 and (UnitHasItemOfTypeBJ(newCaster,'I01K') or GetUnitAbilityLevel(newCaster,'KI10')>0) and IsUnitType(newCaster, UNIT_TYPE_HERO) and IsUnitIllusion(newCaster)==false then
        set critcoef=critcoef+1
    endif
    if GetRandomInt(0,100)<15 and (UnitHasItemOfTypeBJ(newCaster,'I01L') or GetUnitAbilityLevel(newCaster,'KI12')>0) and IsUnitType(newCaster, UNIT_TYPE_HERO) and IsUnitIllusion(newCaster)==false then
        set critcoef=critcoef+1
    endif
    if GetRandomInt(0,100)<20 and (UnitHasItemOfTypeBJ(newCaster,'I01O') or GetUnitAbilityLevel(newCaster,'KI14')>0) and IsUnitType(newCaster, UNIT_TYPE_HERO) and IsUnitIllusion(newCaster)==false then
        set critcoef=critcoef+1
    endif
    if GetRandomInt(0,100)<20 and (UnitHasItemOfTypeBJ(newCaster,'I01Q') or GetUnitAbilityLevel(newCaster,'KI16')>0) and IsUnitType(newCaster, UNIT_TYPE_HERO) and IsUnitIllusion(newCaster)==false then
        set critcoef=critcoef+1
    endif
    if GetRandomInt(0,100)<30 and (UnitHasItemOfTypeBJ(newCaster,'I01S') or GetUnitAbilityLevel(newCaster,'KI18')>0) and IsUnitType(newCaster, UNIT_TYPE_HERO) and IsUnitIllusion(newCaster)==false then
        set critcoef=critcoef+1
    endif
    if GetRandomInt(0,100)<20 and (UnitHasItemOfTypeBJ(newCaster,'I01U') or GetUnitAbilityLevel(newCaster,'KI20')>0) and IsUnitType(newCaster, UNIT_TYPE_HERO) and IsUnitIllusion(newCaster)==false then
        set critcoef=critcoef+1
    endif
    if GetRandomInt(0,100)<15 and (UnitHasItemOfTypeBJ(newCaster,'IBSI') or GetUnitAbilityLevel(newCaster,'KI0Y')>0) and IsUnitType(newCaster, UNIT_TYPE_HERO) and IsUnitIllusion(newCaster)==false then
        set critcoef=critcoef+1
    endif
    if GetRandomInt(0,100)<7.5+3.5*GetUnitAbilityLevel(newCaster,'A0IR') and GetUnitAbilityLevel(newCaster,'A0IR')>0 and IsUnitType(newCaster, UNIT_TYPE_HERO) and IsUnitIllusion(newCaster)==false and GetHeroLevel(newCaster)>5 then
        set critcoef=critcoef+1
    endif
    if GetRandomInt(0,100)<15 and GetUnitAbilityLevel(newCaster,'CS02')>0 and IsUnitType(newCaster, UNIT_TYPE_HERO) and IsUnitIllusion(newCaster)==false and GetHeroLevel(newCaster)>5 then
        set critcoef=critcoef+1
    endif
    if GetRandomInt(0,100)<30 and GetUnitAbilityLevel(newCaster,'WAE1')>0 and IsUnitType(newCaster, UNIT_TYPE_HERO) and IsUnitIllusion(newCaster)==false then
        set critcoef=critcoef+0.5
    endif
	if UnitHasItemOfTypeBJ(newCaster, 'I031') and IsUnitType(newTarget,UNIT_TYPE_HERO) and IsUnitIllusion(newTarget)==false then 	// Патриот
		set tt=CreateTimer()
			call SetHeroAgi(newCaster,GetHeroAgi(newCaster,false)+1,true)
			call SetHeroStr(newCaster,GetHeroStr(newCaster,false)+1,true)
			call SetHeroInt(newCaster,GetHeroInt(newCaster,false)+1,true)
			call SetHeroAgi(newTarget,GetHeroAgi(newTarget,false)-1,true)
			call SetHeroStr(newTarget,GetHeroStr(newTarget,false)-1,true)
			call SetHeroInt(newTarget,GetHeroInt(newTarget,false)-1,true)
			call SaveUnitHandle(h,GetHandleId(tt), 0, newTarget)
			call SaveUnitHandle(h,GetHandleId(tt), 1, newCaster)
			call TimerStart(tt, 5, false, function GilPatriotModifEnd)
		set tt=null
		//set damage=damage-damage*0.3
	endif
	
	if UnitHasItemOfTypeBJ(newCaster, 'I04F') then 				// Экскалибур
		call SetWidgetLife(newCaster, GetWidgetLife(newCaster)+damage*0.2*myCustomDamage2(newTarget,1))
		
		set tt=CreateTimer()
			call SetUnitArmour(newTarget, GetUnitArmour(newTarget)-1)
			call SaveUnitHandle(h,GetHandleId(tt), 0, newTarget)
			call SaveUnitHandle(h,GetHandleId(tt), 1, newCaster)
			call TimerStart(tt, 10, false, function GilExcaliburModifEnd)
		set tt=null
	endif
	
	if UnitHasItemOfTypeBJ(newCaster, 'I01S') and GetRandomInt(0, 9)<=3 then 				// Темный Экскалибур
		if LoadBoolean(h, GetHandleId(newCaster), StringHash("ItemDarkExc_CD"))==false then
			set tt=CreateTimer()
			call SaveBoolean(h, GetHandleId(newCaster), StringHash("ItemDarkExc_CD"), true)
			call UnitRemoveAbility(newCaster, 'A26R')
			call UnitAddAbility(newCaster,'A26R')
			call SaveUnitHandle(h,GetHandleId(tt),0,newCaster)
			call TimerStart(tt,3,false,function GilDarkExcaliburModifEnd)
			set tt=null
		endif
	endif
	
	if GetUnitAbilityLevel(newCaster, 'A26R')>0 then										// Темный Экскалибур Хилл
		call SetWidgetLife(newCaster, GetWidgetLife(newCaster)+damage*0.6*myCustomDamage2(newTarget, 1))
	endif
	
	if GetUnitAbilityLevel(newCaster, 'B06N')>0 then										// Темный Экскалибур Хилл
		call SetWidgetLife(newCaster, GetWidgetLife(newCaster)+damage*0.4*myCustomDamage2(newTarget, 1))
	endif
	
	if UnitHasItemOfTypeBJ(newCaster, 'I03O') then 				// Самехада: Чистый Урон
		set bonus_damage=30+GetUnitTotalDamage(newCaster)*0.08
		if GetWidgetLife(newTarget)>bonus_damage then
			call SetWidgetLife(newTarget, GetWidgetLife(newTarget)-bonus_damage)
		else
			set fatal_damage=true
		endif
	endif
	
	if UnitHasItemOfTypeBJ(newCaster, 'I03B') then				// Меч Анбу
		set bonus_damage=16.5
		if GetWidgetLife(newTarget)>bonus_damage then
			call SetWidgetLife(newTarget, GetWidgetLife(newTarget)-bonus_damage)
		else
			set fatal_damage=true
		endif
	endif
	
	if UnitHasItemOfTypeBJ(newCaster, 'I050') then				// Гегецебури
		set bonus_damage=30
		if GetWidgetLife(newTarget)>bonus_damage then
			call SetWidgetLife(newTarget, GetWidgetLife(newTarget)-bonus_damage)
		else
			set fatal_damage=true
		endif
		if GetRandomInt(0, 99)<=19 then
			call DestroyEffect(AddSpecialEffect("war3mapImported\\Cleave.mdx",GetUnitX(newTarget),GetUnitY(newTarget)))
			call SetControlToUnit(newTarget, newTarget, 0.3, "stun")
		endif
	endif
	
	if GetUnitAbilityLevel(newCaster,'WAE4')==0 and GetUnitAbilityLevel(newCaster,'WAE1')>0 then
        call SetControlToUnit(newTarget,newTarget, 0.3, "stun")
        call UnitAddAbility(newCaster,'WAE4')
        call UnitRemoveAbilityTimed(newCaster,'WAE4',0.7)
        call myCustomDamage(newCaster,newTarget,GetHeroInt(newCaster,true),false,false,null,null,null)
    endif
        
        if UnitHasItemOfTypeBJ(newCaster, 'I03N') then                          // Самехада: Манажор
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Feedback\\ArcaneTowerAttack.mdl", newTarget,"origin"))
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl", newTarget,"chest"))
            if GetWidgetMana(newTarget)>0 then
                call HealTextTag(newCaster,newCaster,GetWidgetMana(newTarget)*0.036*myCustomHeal2(newCaster,1),"HealthRes")
                call SetWidgetLife(newCaster, GetWidgetLife(newCaster)+GetWidgetMana(newTarget)*0.036)
            endif
            call SetWidgetMana(newTarget, GetWidgetMana(newTarget)-GetWidgetMana(newTarget)*0.024)
        endif
        
        
        
        if UnitHasItemOfTypeBJ(newTarget, 'I03C') and UnitHasItemOfTypeBJ(newTarget, 'I03F')==false then        // Жилет Анбу у таргета
                call SetWidgetLife(newTarget, GetWidgetLife(newTarget)+35)
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Heal\\HealTarget.mdl", newTarget,"origin"))
        endif
        
        if UnitHasItemOfTypeBJ(newTarget, 'I03F') then                                                                                                          // Комплект Анбу у таргета
                call SetWidgetLife(newTarget, GetWidgetLife(newTarget)+50)
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Heal\\HealTarget.mdl", newTarget,"origin"))
        endif
        
        if UnitHasItemOfTypeBJ(newTarget, 'I060') then                                                                                                          // Облако Маре D ранг
                set damage=damage-30*2
        endif
        
        if UnitHasItemOfTypeBJ(newTarget, 'I061') then                                                                                                          // Облако Маре C ранг
                set damage=damage-50*2
        endif
        
        if UnitHasItemOfTypeBJ(newTarget, 'I062') then                                                                                                          // Облако Маре B ранг
                set damage=damage-70*2
        endif
        
        if UnitHasItemOfTypeBJ(newTarget, 'I063') then                                                                                                          // Облако Маре A ранг
                set damage=damage-90*2
        endif
                
        if UnitHasItemOfTypeBJ(newTarget, 'I064') then                                                                                                          // Облако Маре Фальшивое
                set damage=damage-110*2
        endif
        
        if UnitHasItemOfTypeBJ(newTarget, 'I065') then                                                                                                          // Облако Маре Истинное
                set damage=damage-130*2
        endif
        
        endif
        
        if miss then
                call AllTextTag("|c00C0C0C0Miss!|r" , newTarget)
        endif
        if critcoef>1 then
            call AllTextTag("|c00FF3737CRIT x"+R2SW(critcoef,2,2)+"|r" , newCaster)
        endif
        if fatal_damage==false then
                if damage>0 then
                    call myCustomDamage(newCaster,newTarget,damage*critcoef,false,false,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,null)
                endif
        else
                call UnitRemoveBuffs(newTarget,true,true)
                call UnitAddAbility(newTarget,'A0WR')
                call DamageIndicatorFunction(newCaster,newTarget,damage)
                call myCustomDamage(newCaster, newTarget, GetWidgetMaxLife(newTarget)*2,false,false,null,null,null)
                call UnitRemoveAbility(newTarget,'A0WR')
        endif
        return miss
endfunction

function AGilPush2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real a=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real sc=0
local real y=GetUnitY(l__d)
local real dist=LoadReal(h,id,3)
if dist>0 and l__d!=null then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SaveReal(h,id,3,dist-speed)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set t=null
endfunction
function AGilPush takes unit l__d,real speed,real angle,real dist returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle)
call SaveReal(h,id,3,dist)
call TimerStart(t,0.03,true,function AGilPush2)
set t=null
endfunction
function GilProjectileCond takes nothing returns boolean
return(GetUnitTypeId(GetTriggerProjectileSource())=='H059' or GetUnitTypeId(GetTriggerProjectileSource())=='H06S' or GetUnitTypeId(GetTriggerProjectileSource())=='H070')and GetUnitAbilityLevel(GetTriggerProjectileSource(),'A131')>0
endfunction
function GilProjectileAct takes nothing returns nothing
call KillProjectile(GetTriggerProjectile())
endfunction
function GilAttackActCond takes nothing returns boolean
return(GetUnitTypeId(GetAttacker())=='H059' or GetUnitTypeId(GetAttacker())=='H06S' or GetUnitTypeId(GetAttacker())=='H070')and GetUnitAbilityLevel(GetAttacker(),'A131')>0
endfunction
function GilAttackAct3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit l__d=LoadUnitHandle(HH,id,1)
local unit c=LoadUnitHandle(HH,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=GetUnitFacing(l__d)*bj_DEGTORAD
local real sr=LoadReal(HH,id,3)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroInt(u,true)*0.6
local integer r=GetRandomInt(1,4)
if sr>0 and UnitIsAlive(l__d)then
set x=x+50*Cos(a)
set y=y+50*Sin(a)
call SetUnitFacing(l__d,AU(l__d,c)*bj_RADTODEG)
call SetUnitXY_1(l__d,x,y, false)
call SaveReal(HH,id,3,sr-50)
call GroupEnumUnitsInRange(G,x,y,75,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E) or (IsUnitEnemy(E,p)!=true and E==c and IsUnitType(E,UNIT_TYPE_STRUCTURE)==false and 'cdm1'!=GetUnitTypeId(E) and 'dumm'!=GetUnitTypeId(E) and 'e16T'!=GetUnitTypeId(E) and GetUnitState(E,UNIT_STATE_LIFE)<=GetUnitState(E,UNIT_STATE_MAX_LIFE)*0.10)then
        //call myCustomDamage(u,E,dmg,false,false,null,null,null)
        if GilgameshModifiedAttack(u,E)==false then
                if r==1 then
                        call EffectToRandomBone("Objects\\Spawnmodels\\Critters\\Albatross\\CritterBloodAlbatross.mdl",E)
                elseif r==2 then
                        call EffectToRandomBone("Objects\\Spawnmodels\\Human\\HumanBlood\\HumanBloodKnight.mdl",E)
                elseif r==3 then
                        call EffectToRandomBone("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",E)
                elseif r==4 then
                        call EffectToRandomBone("war3mapImported\\BloodEX.mdx",E)
                endif
                call AGilPush(E,10,a,40)
        endif
call KillUnit(l__d)
endif
call GroupRemoveUnit(G,E)
endloop
else
call KillUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set p=null
set t=null
set u=null
set l__d=null
set c=null
endfunction
function GilAttackAct2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(HH,id,1)
local unit c=LoadUnitHandle(HH,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real f=GetUnitFacing(c)*bj_DEGTORAD
local real sr=SR(x,y,x1,y1)/50+25
local real x2=0
local real y2=0
local real a=0
set x2=x1+sr*Cos(f)
set y2=y1+sr*Sin(f)
set a=Atan2(y2-y,x2-x)
call PauseTimer(t)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call TimerStart(t,0.01,true,function GilAttackAct3)
set l__d=null
set c=null
set t=null
endfunction
function GilAttackAct takes nothing returns nothing
local unit u=GetAttacker()
local unit c=GetTriggerUnit()
local integer idu=GetHandleId(u)
local integer str=StringHash("gil1")
local integer st=LoadInteger(HH,idu,str)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a2=0
local real a=Atan2(y1-y,x1-x)
local real dist=GetRandomReal(-300,300)
local real he=GetRandomReal(180,220)
if st>0 then
call SaveInteger(HH,idu,str,st-1)
set x=x-70*Cos(a)
set y=y-70*Sin(a)
set x=x+dist*Cos(a+deg90)
set y=y+dist*Sin(a+deg90)
set a2=Atan2(y1-y,x1-x)
call SaveInteger(HH,idu,str,st-1)
call UnitApplyTimedLife(CreateUnit(p,'e14T',x,y,a2*bj_RADTODEG),1,1)
set n=CreateUnit(p,'e14Y',x,y,a2*bj_RADTODEG)
call SetUnitTimeScale(n,2)
call SaveUnitHandle(HH,id,1,n)
call SaveUnitHandle(HH,id,0,u)
call SaveUnitHandle(HH,id,2,c)
call SaveReal(HH,id,3,2500)
call TimerStart(t,0.4,false,function GilAttackAct2)
else
call IssueImmediateOrder(u,"stop")
call DestroyTimer(t)
endif
set u=null
set t=null
set c=null
endfunction
function GilAttackCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,1)
local integer idu=GetHandleId(u)
local player p=GetOwningPlayer(u)
local integer idp=GetPlayerId(p)
local integer str=StringHash("gil1")
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=GetUnitFacing(u)*bj_DEGTORAD
local real time=LoadReal(HH,id,2)
local integer st=LoadInteger(HH,idu,str)
local texttag l__txt=LoadTextTagHandle(HH,id,4)
if time<I2R(8-GetHeroLevel(u)/5)then
call SaveReal(HH,id,2,time+0.03)
set x=x+150*Cos(a+deg90)
set y=y+150*Sin(a+deg90)
call SetTextTagPos(l__txt,x,y,120)
call SetTextTagText(l__txt,I2S(st),TextTagSize2Height(12))
if GetUnitAbilityLevel(u,'A1F4')==0 and st==0 then
call UnitAddAbility(u,'A1F4')
elseif GetUnitAbilityLevel(u,'A1F4')>0 and st>0 then
call UnitRemoveAbility(u,'A1F4')
endif
else
if st<8+R2I(GetHeroLevel(u)/5)then
call SaveInteger(HH,idu,str,st+1)
endif
call SaveReal(HH,id,2,0)
endif
if Hero[idp]!=u then
call PauseTimer(t)
call DestroyTimer(t)
call DestroyTextTag(l__txt)
call DestroyTrigger(LoadTriggerHandle(HH,id,18))
call FlushChildHashtable(HH,id)
endif
set u=null
set l__txt=null
set t=null
endfunction
function GilAttackCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local trigger tt=CreateTrigger()
local trigger tt2=CreateTrigger()
local integer id=GetHandleId(t)
local integer lvl=GetUnitAbilityLevel(u,'A131')
local integer idu=GetHandleId(u)
local integer str=StringHash("gil1")
local player p=GetOwningPlayer(u)
local texttag l__txt=CreateTextTag()
if lvl==1 then
call SaveInteger(HH,idu,str,8+R2I(GetHeroLevel(u)/5))
call SaveUnitHandle(HH,idu,str+1,u)
call SaveUnitHandle(HH,id,1,u)
call SaveTriggerHandle(HH,id,18,tt)
call SaveReal(HH,id,2,0)
call TriggerAddAction(tt,function GilAttackAct)
call TriggerAddCondition(tt,Condition(function GilAttackActCond))
call TriggerRegisterAnyUnitEventBJ(tt,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddAction(tt2,function GilProjectileAct)
call TriggerAddCondition(tt2,Condition(function GilProjectileCond))
call TriggerRegisterAnyUnitEventBJ(tt2,EVENT_PLAYER_UNIT_PROJECTILE_LAUNCH)
call TimerStart(t,0.03,true,function GilAttackCast2)
call SetTextTagText(l__txt,I2S(8+R2I(GetHeroLevel(u)/5)),TextTagSize2Height(12))
call SetTextTagVisibility(l__txt,false)
if GetLocalPlayer()==p then
call SetTextTagVisibility(l__txt,true)
endif
call SetTextTagPos(l__txt,GetUnitX(u),GetUnitY(u),120)
call SetTextTagColor(l__txt,255,225,25,255)
call SetTextTagPermanent(l__txt,true)
call SaveTextTagHandle(HH,id,4,l__txt)
else
call DestroyTimer(t)
call DestroyTextTag(l__txt)
call DestroyTrigger(tt)
call DestroyTrigger(tt2)
endif
set p=null
set l__txt=null
set tt=null
set tt2=null
set t=null
set u=null
endfunction
function InitTrig_GilAttack takes nothing returns nothing
set gg_trg_GilAttack=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_GilAttack,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(gg_trg_GilAttack,Condition(function GilAttackCond))
call TriggerAddAction(gg_trg_GilAttack,function GilAttackCast)
endfunction
function EGilCond takes nothing returns boolean
return GetSpellAbilityId()=='A12Y'
endfunction
function EGilCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,5)
local unit l__d=LoadUnitHandle(h,id,1)
local unit d2=LoadUnitHandle(h,id,4)
local real dmg=(2+GetUnitAbilityLevel(u,'A12Y'))*GetHeroInt(u,true)
local real x1=LoadReal(h,id,6)
local real y1=LoadReal(h,id,7)
local real a=LoadReal(h,id,3)
local real dist=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
if dist>0 and GetWidgetLife(c)>0 then
call SetUnitPosition(c,x1,y1)
call IssueImmediateOrder(c, "stop")
call SaveReal(h,id,2,dist-0.02)
call SetUnitX(d2,x1)
call SetUnitY(d2,y1)
else
call KillUnit(d2)
call SetUnitAnimation(l__d,"death")
call UnitApplyTimedLife(l__d,1,1)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set d2=null
set c=null
set u=null
set p=null
set t=null
endfunction
function EGilCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,5)
local unit l__d=LoadUnitHandle(h,id,1)
local unit d2=LoadUnitHandle(h,id,4)
local real dmg=(2+GetUnitAbilityLevel(u,'A12Y'))*GetHeroInt(u,true)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=LoadReal(h,id,3)
local real dist=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
local integer i=0
if dist>0 and GetWidgetLife(c)>0 then
    call SetUnitXY_1(l__d,x1,y1, false)
    call SetUnitX(d2,x1)
    call SetUnitY(d2,y1)
    call SaveReal(h,id,2,dist-0.02)
else
    if GetUnitTypeId(u)=='H059' or GetUnitTypeId(u)=='H070' then
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\Einkidou.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
    else
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\FemGilSkillE.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
    endif
    call SetUnitAnimation(l__d,"stand")
    set n=CreateUnit(p,'e14Q',x1,y1,GetRandomReal(0,359))
    call SetUnitVertexColor(n,255,255,255,255)
    call SetUnitAnimation(n,"birth")
    call SaveUnitHandle(h,id,1,n)
    call IssueImmediateOrder(c,"stop")
    call PauseTimer(t)
    call KillUnit(l__d)
    call SetControlToUnit(u,c,3, "stun")
    call SaveReal(h,id,6,x1)
    call SaveReal(h,id,7,y1)
    call SaveReal(h,id,2,3.5)
    loop
    exitwhen i>=10
    if IsUnitAlly(Hero[i],Player(i))and GetUnitTypeId(Hero[i])=='H077' then
        call SaveReal(h,id,2,4.5)
    endif
    set i=i+1
    endloop
    call TimerStart(t,0.02,true,function EGilCast3)
endif
set c=null
set d2=null
set l__d=null
set u=null
set p=null
set t=null
endfunction
function EGilCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real di=1.0
local real a=Atan2(y1-y,x1-x)
local integer idu=GetHandleId(u)
local integer str=StringHash("gil1")
local integer st=LoadInteger(HH,idu,str)
if st+3<=(8+R2I(GetHeroLevel(u)/5))*2 then
call SaveInteger(HH,idu,str,st+3)
else
call SaveInteger(HH,idu,str,(8+R2I(GetHeroLevel(u)/5))*2)
endif
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,5,c)
set n=CreateUnit(p,'e14U',x+25*Cos(a),y+25*Sin(a),a*bj_RADTODEG)
call SaveUnitHandle(h,id,4,n)
call SaveReal(h,id,2,di)
call SaveReal(h,id,8,di)
call SaveReal(h,id,3,a)
call SetUnitTimeScale(u,1)
call TimerStart(t,0.02,true,function EGilCast2)
set n=CreateUnit(p,'e14V',x+25*Cos(a),y+25*Sin(a),a*bj_RADTODEG)
call SaveUnitHandle(h,id,1,n)
call SetUnitAnimation(n,"birth")
set u=null
set p=null
set t=null
set c=null
endfunction
