call SaveUnitHandle(HH,id,20,n0)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing+180)
call SetUnitModel(n0,"Aizen\\AZ_LCDark_W2_buff.mdl")
call UnitSize(n0,1.5,1,1)
