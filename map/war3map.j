function Trig_SwapOk_Actions takes nothing returns nothing //swap
local player p=GetTriggerPlayer()
local integer i=GetPlayerId(p)+1
local integer j=0
local item array t1
local item array t2
local unit u1
local unit u2
if GetEventPlayerChatString()=="-ok"and udg_B==false and udg_Swap[i]==true and udg_Swap[udg_SwapId[i]]==true then
loop
set t1[j]=UnitRemoveItemFromSlot(udg_Hero[i],j)
set t2[j]=UnitRemoveItemFromSlot(udg_Hero[udg_SwapId[i]],j)
exitwhen j==5
set j=j+1
endloop
call SetUnitOwner(udg_Hero[i],Player(udg_SwapId[i]-1),true)
call SetUnitOwner(udg_Hero[udg_SwapId[i]],Player(i-1),true)
set j=0
loop
call UnitAddItem(udg_Hero[i],t2[j])
call UnitAddItem(udg_Hero[udg_SwapId[i]],t1[j])
exitwhen j==5
set j=j+1
endloop
set u1=udg_Hero[i]
set u2=udg_Hero[udg_SwapId[i]]
set udg_Hero[i]=u2
set udg_Hero[udg_SwapId[i]]=u1
set udg_Swap[udg_SwapId[i]]=false
set udg_Swap[i]=false
call SetUnitPosition(u1,GetRectCenterX(gg_rct_Rect1),GetRectCenterY(gg_rct_Rect1))
if GetUnitTypeId(udg_Hero[i])=='H06G' or GetUnitTypeId(udg_Hero[udg_SwapId[i]])=='H06G' then
call SetPlayerAbilityAvailable(Player(udg_SwapId[i]-1),'A1DT',false)
call SetPlayerAbilityAvailable(Player(i-1),'A1DT',false)
endif
call SetUnitPosition(u2,GetRectCenterX(gg_rct_Rect1),GetRectCenterY(gg_rct_Rect1))
set Hero[i-1]=udg_Hero[i]
set udg_Hero[i]=udg_Hero[i]
set Hero[udg_SwapId[i]-1]=udg_Hero[udg_SwapId[i]]
set udg_Hero[udg_SwapId[i]]=udg_Hero[udg_SwapId[i]]
if GetUnitTypeId(Hero[i-1])=='H04A' then
    set Gon=udg_Hero[i]
endif
if GetUnitTypeId(Hero[udg_SwapId[i]-1])=='H04A' then
    set Gon=udg_Hero[udg_SwapId[i]]
endif
call SetFrameTexture( GetFrameByName("SelectedHeroPlayer",i-1), GetUnitStringField(udg_Hero[i],UNIT_SF_ICON_NORMAL), 0, true ) 
call SetFrameTexture( GetFrameByName("SelectedHeroPlayer",i-1), GetUnitStringField(udg_Hero[i],UNIT_SF_ICON_NORMAL), 1, true )
call SetFrameTexture( GetFrameByName("SelectedHeroPlayer",i-1), GetUnitStringField(udg_Hero[i],UNIT_SF_ICON_NORMAL), 2, true )
call SetFrameTexture( GetFrameByName("SelectedHeroPlayer",udg_SwapId[i]-1), GetUnitStringField(udg_Hero[udg_SwapId[i]],UNIT_SF_ICON_NORMAL), 0, true ) 
call SetFrameTexture( GetFrameByName("SelectedHeroPlayer",udg_SwapId[i]-1), GetUnitStringField(udg_Hero[udg_SwapId[i]],UNIT_SF_ICON_NORMAL), 1, true )
call SetFrameTexture( GetFrameByName("SelectedHeroPlayer",udg_SwapId[i]-1), GetUnitStringField(udg_Hero[udg_SwapId[i]],UNIT_SF_ICON_NORMAL), 2, true )
if GetUnitTypeId(Hero[i-1])=='H02L' then
    set Broly=udg_Hero[i]
    call RemoveUnit(BrolySTRCond[i])
    call SetAbilityBaseStringFieldById('BRRS',ABILITY_SF_ICON_NORMAL,GetAbilityBaseStringFieldById('BRR2',ABILITY_SF_ICON_NORMAL))
    call SetAbilityBaseStringFieldById('BRRS',ABILITY_SLF_TOOLTIP_NORMAL_EXTENDED,GetAbilityBaseStringFieldById('BRR2',ABILITY_SLF_TOOLTIP_NORMAL_EXTENDED))
endif
if GetUnitTypeId(Hero[udg_SwapId[i]-1])=='H02L' then
    set Broly=udg_Hero[udg_SwapId[i]]
    call RemoveUnit(BrolySTRCond[udg_SwapId[i]])
    call SetAbilityBaseStringFieldById('BRRS',ABILITY_SF_ICON_NORMAL,GetAbilityBaseStringFieldById('BRR2',ABILITY_SF_ICON_NORMAL))
    call SetAbilityBaseStringFieldById('BRRS',ABILITY_SLF_TOOLTIP_NORMAL_EXTENDED,GetAbilityBaseStringFieldById('BRR2',ABILITY_SLF_TOOLTIP_NORMAL_EXTENDED))
endif
call CastRFH2(i-1)
call CastRFH2(udg_SwapId[i]-1)
elseif GetEventPlayerChatString()=="-no"and udg_B==false then
set udg_Swap[udg_SwapId[i]]=false
set udg_Swap[i]=false
endif
call UpdateMultiboard()
set p=null
endfunction
