function MadaraQSharinganAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local unit b1=LoadUnitHandle(HH,id,20)
local real facing=LoadReal(HH,id,3)
local real distance=LoadReal(HH,id,8)
local real time=LoadReal(HH,id,5)
local real time1
local real damage=LoadReal(HH,id,35)
set time=time+0.02
call SaveReal(HH,id,5,time)
if distance==2000+LoadInteger(HH,id,30) then
        call FlushChildHashtable(HH,id)
        call FlushChildHashtable(HH,GetHandleId(LoadGroupHandle(HH,id,4)))
        call PauseTimer(t)
        call DestroyTimer(t)
        call DestroyGroup(LoadGroupHandle(HH,id,4))
        call RemoveUnit(b1)
    //call MyRemoveUnit(b1,1.5)
else
if time<0.4 then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
endif
if time==0.02 then
call SaveGroupHandle(HH,id,4,CreateGroup())
call SetUnitPathing(caster,true)
                        set soundplay=CreateSound("war3mapimported\\MadaraQ.mp3",false,false,true,12700,12700,"")
                        call StartSound(soundplay)
                        call KillSoundWhenDone(soundplay)
call EffectCreateAndMove(true,"Madara\\blue-blink.mdl",facing,1,2.5,0.5,100,100,100,30,0,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\WindNewFaw4.mdl",facing,1,1.25,0.5,100,100,100,30,0,caster,0,facing)
if LoadBoolean(HH,GetHandleId(caster),StringHash("MadaraSusT2"))==false then
call SetUnitAnimationByIndex(caster,1)
else
call SetUnitTimeScale(caster,5)
call SetUnitAnimationByIndex(caster,7)
endif
if LoadUnitHandle(HH,GetHandleId(caster),StringHash("MadaraSusano"))!=null then
call SetUnitAnimationByIndex(LoadUnitHandle(HH,GetHandleId(caster),StringHash("MadaraSusano")),17)
else
call SetUnitAnimationByIndex(LoadUnitHandle(HH,GetHandleId(caster),StringHash("MadaraBone")),4)
endif
endif
if time==0.4 then

if LoadUnitHandle(HH,GetHandleId(caster),StringHash("MadaraSusano"))!=null or LoadBoolean(HH,GetHandleId(caster),StringHash("MadaraSusT2"))==true then
call SetUnitState(caster,UNIT_STATE_MANA,GetUnitState(caster,UNIT_STATE_MANA)-GetUnitState(caster,UNIT_STATE_MAX_MANA)*0.1)
call SaveInteger(HH,id,30,1000)
endif

call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
call SetUnitModel(n0,"Madara\\shirouichigosl.mdl")
call UnitSize(n0,3,1,1)
call MoveUnit(n0,n0,200,facing)
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call SetUnitFlyHeight(n0,200,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=null
endif
if time==0.6 then
if LoadBoolean(HH,GetHandleId(caster),StringHash("MadaraSusT2"))==true then
call SetUnitTimeScale(caster,1)
call SetUnitAnimationByIndex(caster,10)
endif
if LoadUnitHandle(HH,GetHandleId(caster),StringHash("MadaraSusano"))!=null then
call SetUnitAnimationByIndex(LoadUnitHandle(HH,GetHandleId(caster),StringHash("MadaraSusano")),0)
else
call SetUnitAnimationByIndex(LoadUnitHandle(HH,GetHandleId(caster),StringHash("MadaraBone")),0)
endif
endif
if time>0.4 then
set time1=LoadReal(HH,id,6)
call SaveReal(HH,id,8,distance+50)
set b1=LoadUnitHandle(HH,id,20)
call MoveUnit(b1,b1,50,facing)
if LoadUnitHandle(HH,GetHandleId(caster),StringHash("MadaraSusano"))!=null or LoadBoolean(HH,GetHandleId(caster),StringHash("MadaraSusT2"))==true then
set damage=damage+GetUnitState(caster,UNIT_STATE_MAX_MANA)*0.1
endif
call DamageAoeOneTime(caster,GetUnitX(b1),GetUnitY(b1),300,damage,LoadGroupHandle(HH,id,4))
set time1=time1+0.02
if time1==0.06 or time==0.04 then
set time1=0
call EffectCreateAndMove(true,"Madara\\az_yine(nosmoke).mdl",facing,1,1,1,80,80,100,0,0,LoadUnitHandle(HH,id,20),0,facing)
call EffectCreateAndMove(true,"Madara\\[A]blue--zhendi3.mdl",facing,0.5,2,1.75,100,100,100,40,-100,LoadUnitHandle(HH,id,20),0,facing)
call EffectCreateAndMove(true,"Madara\\az_goods_force staff(3).mdl",facing,1,5,0.8,100,100,100,40,-100,LoadUnitHandle(HH,id,20),0,facing)
endif
call SaveReal(HH,id,6,time1)
endif
endif
set t=null
set caster=null
set b1=null

endfunction

function MadaraWYasaka1 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
