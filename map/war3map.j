function JokerHealing takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local integer ty=LoadInteger(HH,id,1)
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(p)
local real hel=0
if GetUnitTypeId(Hero[ip])==ty and u==Hero[ip] then
set hel=(GetUnitState(u,UNIT_STATE_MAX_LIFE)-GetUnitState(u,UNIT_STATE_LIFE))*0.015
if doffyh[ip]>20 and GetUnitState(u,UNIT_STATE_MAX_LIFE)!=GetWidgetLife(u)and hel>1 and GetHeroLevel(u)>=6 then
call HealTextTag(u,u,hel*myCustomHeal2(u,1),"HealthRes")
call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+hel)
else
set doffyh[ip]=doffyh[ip]+0.5
endif
else
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set p=null
set t=null
set u=null
endfunction
function Trig_LearnParasite_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local integer lvl=GetUnitAbilityLevel(u,0x4131414A)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
if lvl==1 then
call UnitAddAbility(u,'A1AK')
call UnitMakeAbilityPermanent(u,true,'A1AK')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1AK',true)
call UnitAddAbility(u,'A1AL')
call UnitMakeAbilityPermanent(u,false,'A1AL')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1AL',false)
set doffyh[GetPlayerId(GetOwningPlayer(u))]=0
call SaveUnitHandle(HH,id,0,u)
call SaveInteger(HH,id,1,GetUnitTypeId(u))
call TimerStart(t,0.5,true,function JokerHealing)
else
call DestroyTimer(t)
call SetUnitAbilityLevel(u,'A1AK',lvl)
call SetUnitAbilityLevel(u,'A1AL',lvl)
endif
set t=null
set u=null
endfunction
function InitTrig_LearnParasite takes nothing returns nothing
set gg_trg_LearnParasite=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_LearnParasite,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(gg_trg_LearnParasite,Condition(function Trig_LearnParasite_Conditions))
