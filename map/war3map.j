call SetFrameTexture( LoadFrameHandle(HH, idp,SH_ReplaceableTextures_CommandButtons_BTNMadaraR_blp), "ReplaceableTextures\\CommandButtons\\BTNMadaraR.blp", 0, true )
call SetFrameTexture( LoadFrameHandle(HH, idp,SH_ReplaceableTextures_CommandButtons_BTNMadaraR_blp), "ReplaceableTextures\\CommandButtons\\BTNMadaraR.blp", 1, true )
call SetFrameTexture( LoadFrameHandle(HH, idp,SH_ReplaceableTextures_CommandButtons_BTNMadaraR_blp), "ReplaceableTextures\\CommandButtons\\BTNMadaraR.blp", 2, true )
else
call SaveReal(HH, GetHandleId(LoadFrameHandle(HH, idp,SH_ReplaceableTextures_CommandButtons_BTNMadaraR_blp)), c_DURATION, LoadReal(HH,GetHandleId(caster0),SH_MadaraSusDur))
endif


set n0=null
endif

if typeSusano==2 then
call SaveReal(HH,GetHandleId(caster0),SH_MadaraSusDur,6+LoadReal(HH,GetHandleId(caster0),SH_MadaraSusDur))
if LoadBoolean(HH,GetHandleId(caster0),SH_MadaraSusT)==null and LoadBoolean(HH,GetHandleId(caster0),SH_MadaraSusT2)==null then
if LoadUnitHandle(HH,GetHandleId(caster0),SH_MadaraSusano)==null then
call CreateModeIndicatorWithPauseFormMadara(caster0, "ReplaceableTextures\\CommandButtons\\BTNMadaraR.blp", LoadReal(HH,GetHandleId(caster0),SH_MadaraSusDur))
else
call RemoveUnit(LoadUnitHandle(HH,GetHandleId(caster0),SH_MadaraSusano))
call SaveReal(HH, GetHandleId(LoadFrameHandle(HH, idp,SH_ReplaceableTextures_CommandButtons_BTNMadaraR_blp)), c_DURATION, LoadReal(HH,GetHandleId(caster0),SH_MadaraSusDur))
endif
call SetFrameTexture( LoadFrameHandle(HH, idp,SH_ReplaceableTextures_CommandButtons_BTNMadaraR_blp), "ReplaceableTextures\\CommandButtons\\BTNMadaraT2.blp", 0, true )
call SetFrameTexture( LoadFrameHandle(HH, idp,SH_ReplaceableTextures_CommandButtons_BTNMadaraR_blp), "ReplaceableTextures\\CommandButtons\\BTNMadaraT2.blp", 1, true )
call SetFrameTexture( LoadFrameHandle(HH, idp,SH_ReplaceableTextures_CommandButtons_BTNMadaraR_blp), "ReplaceableTextures\\CommandButtons\\BTNMadaraT2.blp", 2, true )
call SetUnitState(caster0,UNIT_STATE_MANA,GetUnitState(caster0,UNIT_STATE_MANA)-GetUnitState(caster0,UNIT_STATE_MAX_MANA)*0.1)
call SaveReal(HH,id,10,LoadReal(HH,GetHandleId(caster0),SH_MadaraSusDur))
call SaveBoolean(HH,GetHandleId(caster0),SH_MadaraSusT,true)
set n0=CreateUnit(GetOwningPlayer(caster0),'e211',GetUnitX(caster0),GetUnitY(caster0),GetUnitFacing(caster0))
call UnitSize(n0,14,1,1)
call SetUnitAnimationByIndex(n0,6)
call SaveUnitHandle(HH,GetHandleId(caster0),SH_MadaraSusano,n0)
call SaveUnitHandle(HH,id,2,n0)
set n0=CreateUnit(GetOwningPlayer(caster0),'e212',GetUnitX(caster0),GetUnitY(caster0),GetUnitFacing(caster0))
call UnitSize(n0,0.8,1,1)
call SaveUnitHandle(HH,id,20,n0)
call TimerStart(t,0.02,true,function MadaraSusanoAct2)
set n0=null
endif
endif

if typeSusano==3 then
