function LariatCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local real ang=150*bj_DEGTORAD
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,22,c)
call SaveReal(h,id,5,x1)
call SaveReal(h,id,6,y1)
call SaveReal(h,id,2,0)
call SaveReal(h,id,10,1.25)
call SaveReal(h,id,11,a)
call SaveReal(h,id,17,0.8)
call SetUnitTimeScale(u,0)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call SetUnitInvulnerable(c,true)
call SaveGroupHandle(h,id,12,CreateGroup())
call TimerStart(t,0.1,true,function LariatCast2)
set u=null
set p=null
set c=null
set t=null
endfunction
function NejiTCond takes nothing returns boolean
return GetSpellAbilityId()=='A2LL' and udg_B==true
endfunction
function MissleMoveNeji2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,4)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)+angle
if SR(x,y,x1,y1)>100 then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
set n=CreateUnit(GetOwningPlayer(l__d),'e1GZ',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.15)
call SetUnitVertexColor(n,190,255,255,60)
call ShikiCloneEffect(n,1.5,1.05,1.25,150)
call SetUnitAnimation(n,"attack")
else
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set c=null
set l__d=null
set t=null
endfunction
function MissleMoveNeji takes unit l__d,real speed,real angle,unit target returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveUnitHandle(h,id,4,target)
call SetUnitVertexColor(l__d,190,255,255,60)
call TimerStart(t,0.02,true,function MissleMoveNeji2)
set t=null
endfunction
function NejiTCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit c1=LoadUnitHandle(h,id,15)
local unit c2
local real x0=LoadReal(h,id,10)
local real y0=LoadReal(h,id,11)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real x2=GetUnitX(c1)
local real y2=GetUnitY(c1)
local real a=LoadReal(h,id,5)
local real a2=Atan2(y1-y,x1-x)
local real dmg=14*GetHeroAgi(u,true)
local player p=GetOwningPlayer(u)
local real time=LoadReal(h,id,7)
local real speed=LoadReal(h,id,8)
local real count=LoadReal(h,id,9)
local group g=LoadGroupHandle(h,id,12)
local group g2=LoadGroupHandle(h,id,13)
local group g4=CreateGroup()
if time==0.02 then
    set idg=GetHandleId(g)
    set ide=GetHandleId(c)
    //call BJDebugMsg("Name = "+GetUnitName(c))
    call SaveReal(h,ide,StringHash("NejiAngle"),a)
    call GroupAddUnit(g,c)
    call SetUnitTimeScale(c,0.05)
    call SetUnitAnimation(u,"Spell Five")
    set EFF=AddSpecialEffect("Hakke128.mdl", x, y)
    call SetSpecialEffectZ(EFF , 30)
    call SetSpecialEffectScale(EFF , 9.6)
    call RemoveEffect(EFF,1,true,CreateTimer())
    set n=CreateUnit(p,'e06G',x,y,GetRandomReal(0,359))
    call UnitApplyTimedLife(n,1,1.3)
    call SetUnitTimeScale(n,0.8)
endif
if time<=1.5 then
    call SetUnitTimeScale(u,1)
    call SaveReal(h,id,7,time+0.02)
endif
if time<=2 and time>1.5 then
    call SaveReal(h,id,7,time+0.02)
    call SetUnitAnimation(u,"walk")
    call SetUnitFacingInstant(u,a2*bj_RADTODEG)
    call SetUnitXY_1(u,x+45*Cos(a2),y+45*Sin(a2), false)
    if SR(x,y,x1,y1)<100 or time==2 then
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\NejiT2_1.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        call SaveReal(h,id,7,2.02)
        call Push5(c,2,a,6,"")
    endif
endif
if NumberOfEnemiesInEachGroupHeroes(g,p)<1 and time>0.05 and count<128 then
    call SaveReal(h,id,9,count+128)
    call SaveReal(h,id,7,time+2)
    set count=LoadReal(h,id,9)
    set time=LoadReal(h,id,7)
endif
if count<=127 and time>2 and UnitIsAlive(u)==true then
    if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
        call PauseUnit(c,true)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
        call SetUnitTimeScale(c,0.05)
        call PauseUnit(u,true)
        call SetUnitInvulnerable(u,true)
        if ModuloReal((time-2),speed)<0.02 then
            set x1=x1-60*Cos(GetRandomReal(-65,65)*bj_DEGTORAD)
            set y1=y1-60*Sin(GetRandomReal(-65,65)*bj_DEGTORAD)
            call SetUnitXY_1(u,x1,y1, false)
            call SetUnitAnimation(u,"attack")
            call SetUnitAnimation(c,"death")
            call Push5(c,2,a,3,"")
            call SetUnitTimeScale(u,R2I(time)-1)
            set EFF=AddSpecialEffect("Minato-37.mdx", x1+GetRandomReal(25,65)*Cos(a+GetRandomReal(-20,20)*bj_DEGTORAD),y1+GetRandomReal(25,65)*Sin(a+GetRandomReal(-20,20)*bj_DEGTORAD))
            call SetSpecialEffectScale(EFF , GetRandomReal(0.75,1.75))
            call SetSpecialEffectZ(EFF , GetRandomReal(30,90))
            call SetSpecialEffectRoll(EFF , 90)
            call DestroyEffect(EFF)
            if GetRandomInt(1,2)==1 then
                set EFF=AddSpecialEffect("war3mapImported\\SlashBlueKojiro.mdl", x1+GetRandomReal(25,65)*Cos(a+GetRandomReal(-20,20)*bj_DEGTORAD),y1+GetRandomReal(25,65)*Sin(a+GetRandomReal(-20,20)*bj_DEGTORAD))
                call SetSpecialEffectScale(EFF , GetRandomReal(0.3,0.7))
                call SetSpecialEffectZ(EFF , GetRandomReal(30,90))
                call SetSpecialEffectRoll(EFF , 90)
                call DestroyEffect(EFF)
            else
                set EFF=AddSpecialEffect("FawEffects_7.mdx", x1+GetRandomReal(25,65)*Cos(a+GetRandomReal(-20,20)*bj_DEGTORAD),y1+GetRandomReal(25,65)*Sin(a+GetRandomReal(-20,20)*bj_DEGTORAD))
                call SetSpecialEffectScale(EFF , GetRandomReal(0.55,0.95))
                call SetSpecialEffectZ(EFF , GetRandomReal(30,90))
                call SetSpecialEffectRoll(EFF , 90)
                call DestroyEffect(EFF)
            endif
            if GetRandomInt(1,3)==1 then
                if GroupGetCount(g)>0 then
                    set c1=GroupGetUnitByIndex(g,GetRandomInt(0,CountUnitsInGroup(g)-1))
                    call SaveUnitHandle(h,id,15,c1)
                    set n=CreateUnit(p,'e1GZ',x2+GetRandomReal(-85,85)*bj_DEGTORAD,y2+GetRandomReal(-85,85)*bj_DEGTORAD,GetRandomReal(0,359))
                else
                    set n=CreateUnit(p,'e1GZ',x1+GetRandomReal(-85,85)*bj_DEGTORAD,y1+GetRandomReal(-85,85)*bj_DEGTORAD,GetRandomReal(0,359))
                endif
                call UnitApplyTimedLife(n,1,0.15)
                call SetUnitTimeScale(n,2)
                call SetUnitVertexColor(n,190,255,255,120)
                call SetUnitAnimation(n,"attack")
            endif
            call SaveReal(h,id,9,count+1)
            if count==4 or count==8 or count==16 or count==32 or count==64 then
                call GroupEnumUnitsInRange(g4,x0,y0,900,Base)
                if FirstOfGroup(g4)!=null then
                    loop
                        set E=FirstOfGroup(g4)
                        exitwhen E==null
                        if Condition_Base(p,E) and IsUnitInvulnerable(E)==false and IsUnitIllusion(E)==false and IsUnitType(E,UNIT_TYPE_HERO)==true and IsUnitInGroup(E,g)==false then
                            call GroupAddUnit(g2,E)
                        endif
                        call GroupRemoveUnit(g4,E)
                    endloop
                    if FirstOfGroup(g2)!=null and GroupGetCount(g2)>0 then
                        set c2=GroupGetUnitByIndex(g2,GetRandomInt(0,GroupGetCount(g2)-1))
                        //call BJDebugMsg("g "+I2S(GroupGetCount(g2)))
                        //call BJDebugMsg("g2var, g = "+I2S(NumberOfEnemiesInEachGroupHeroes(g,p))+" g2 = "+I2S(NumberOfEnemiesInEachGroupHeroes(g2,p)))
                    elseif FirstOfGroup(g2)==null and FirstOfGroup(g)!=null and GroupGetCount(g)>0 then
                        set c2=GroupGetUnitByIndex(g,GetRandomInt(0,GroupGetCount(g)-1))
                        //call BJDebugMsg("g2 "+I2S(GroupGetCount(g2)))
                        //call BJDebugMsg("g1var, g = "+I2S(NumberOfEnemiesInEachGroupHeroes(g,p))+" g2 = "+I2S(NumberOfEnemiesInEachGroupHeroes(g2,p)))
                    elseif GroupGetCount(g)==0 then
                        call SaveReal(h,id,9,count+128)
                        call SaveReal(h,id,7,time+2)
                    endif
                    //call BJDebugMsg("Name = "+GetUnitName(c2))
                elseif GroupGetCount(g)==0 then
                    call SaveReal(h,id,9,count+128)
                    call SaveReal(h,id,7,time+2)
                endif
                set ide=GetHandleId(c2)
                if IsUnitInGroup(c2,g)==false then
                call GroupAddUnit(g,c2)
                call GroupRemoveUnit(g2,c2)
                endif
                call Push3(c,2,a,12,"")
                call SetUnitTimeScale(c2,0.05)
                call SaveUnitHandle(h,id,1,c2)
                call SaveUnitHandle(h,idg,ide,c2)
                if c2!=c then
                call MissleMoveNeji(CreateUnit(p,'e1GZ',x,y,GetRandomReal(0,359)),90,Atan2(GetUnitY(c2)-y,GetUnitX(c2)-x),c2)
                endif
                call SaveReal(h,ide,StringHash("NejiAngle"),Atan2(GetUnitY(c2)-y,GetUnitX(c2)-x))
                call SaveInteger(h,ide,StringHash("NejiDMG"),LoadInteger(h,ide,StringHash("NejiDMG"))+R2I( dmg / (96 / count)))
                call SaveReal(h,id,5,Atan2(GetUnitY(c2)-y,GetUnitX(c2)-x))
                loop
                    set E=GroupForEachUnit(g)
                    exitwhen E==null
                    call PauseUnit(E,true)
                    call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,true)
                endloop
                call GroupClear(g2)
            endif
        endif
        call SetUnitTimeScale(u,4)
        call SetUnitFacing(u,a*bj_RADTODEG)
    else
        call SaveReal(h,id,9,count+128)
        call SaveReal(h,id,7,time+2)
        set count=LoadReal(h,id,9)
        set time=LoadReal(h,id,7)
        call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
    endif
elseif time>2 then
call SetUnitInvulnerable(u,false)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set ide=GetHandleId(E)
if LoadInteger(h,ide,StringHash("NejiDMG"))<5*GetHeroAgi(u,true) then
call SaveInteger(h,ide,StringHash("NejiDMG"),5*GetHeroAgi(u,true))
endif
if LoadInteger(h,ide,StringHash("NejiDMG"))>14*GetHeroAgi(u,true) then
call SaveInteger(h,ide,StringHash("NejiDMG"),14*GetHeroAgi(u,true))
endif
call PauseUnit(E,false)
call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,false)
call FrozenMinusManaCast(E,5)
call Push3(E,45,LoadReal(h,ide,StringHash("NejiAngle")),700,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
call myCustomDamage(u,E,LoadInteger(h,ide,StringHash("NejiDMG")),false,false,null,null,null)
set EFF=AddSpecialEffect("WindVectorPush.mdx", GetUnitX(E), GetUnitY(E))
call SetSpecialEffectFacing(EFF , LoadReal(h,ide,StringHash("NejiAngle"))* bj_RADTODEG)
call SetSpecialEffectZ(EFF , 40)
call SetSpecialEffectScale(EFF , 0.6)
call SetSpecialEffectVertexColour(EFF,255,255,255,220)
call RemoveEffect(EFF,1,true,CreateTimer())

//call SetControlToUnit(u,E,1+2*(I2R(LoadInteger(h,ide,StringHash("NejiDMG")))/(14*GetHeroAgi(u,true))), "stun")
//call BJDebugMsg(R2SW(I2R(LoadInteger(h,ide,StringHash("NejiDMG")))/(16*GetHeroAgi(u,true)),2,2))
call SaveInteger(h,ide,StringHash("NejiDMG"),0)
call GroupRemoveUnit(g,E)
call SetUnitTimeScale(E,1)
endloop
call PauseUnit(u,false)
call GroupClear(g)
call GroupClear(g2)
call GroupClear(g4)
call DestroyGroup(g)
call DestroyGroup(g2)
call DestroyGroup(g4)
call SetUnitVertexColor(u,255,255,255,255)
call FlushChildHashtable(h,id)
call RemoveSavedHandle(h,ide,StringHash("NejiDMG"))
call RemoveSavedHandle(h,ide,StringHash("NejiAngle"))
call FlushChildHashtable(h,idg)
call SetUnitTimeScale(u,1)
call DestroyTimer(t)
endif
set g=null
set g2=null
set g4=null
set p=null
set u=null
set c=null
set c1=null
set c2=null
set t=null
endfunction
function NejiTCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveReal(h,id,7,0)
call SaveReal(h,id,8,0.2)
call SaveReal(h,id,9,0)
call SaveReal(h,id,10,x)
call SaveReal(h,id,11,y)
call SaveGroupHandle(h,id,12,CreateGroup())
call SaveGroupHandle(h,id,13,CreateGroup())
call SaveReal(h,id,5,Atan2(y1-y,x1-x))
call SaveUnitHandle(h,id,15,c)
call SetUnitVertexColor(u,255,255,255,255)
call SetUnitTimeScale(u,0.4)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\NejiT1.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.03,true,function NejiTCast2)
set t=null
set u=null
set p=null
set c=null
endfunction
function NejiRCond takes nothing returns boolean
return GetSpellAbilityId()=='A1LL' and udg_B==true //nejiR start
endfunction
function NejiRCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=LoadReal(h,id,5)
local real dmg=(GetUnitAbilityLevel(u,'A1LL')+4)*GetHeroAgi(u,true)
local player p=GetOwningPlayer(u)
local real time=LoadReal(h,id,7)
local real speed=LoadReal(h,id,8)
local real count=LoadReal(h,id,9)
if time==0.02 then
call SetUnitAnimation(u,"Spell Five")
set EFF=AddSpecialEffect("Hakke64.mdl", x, y)
call SetSpecialEffectZ(EFF , 50)
