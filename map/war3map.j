function TrunksR_Act3 takes nothing returns nothing
        local timer newTimer = GetExpiredTimer()
        local integer id = GetHandleId(newTimer)
        local unit caster = LoadUnitHandle(h, id, 0)
        local unit target = LoadUnitHandle(h, id, 1)
        local real point_x = GetUnitX(target)
        local real point_y = GetUnitY(target)
        local real angle  = AU(caster, target)
        local real time   = LoadReal(h, id, 3)
        local integer eff_period = LoadInteger(h, id, 4)
        local integer i   = 0
        call SaveReal(h, id, 3, time+0.03)
        if time<2.0 then
            call PauseUnit(caster, true)
            call PauseUnit(target,true)
            call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
            if time<1.5 then
                call SetUnitXY(caster, point_x-100*Cos(angle), point_y-100*Sin(angle))
                call SetUnitXY(target, point_x+1*Cos(angle), point_y+1*Sin(angle))
                if eff_period<=0 then
                    if GetRandomInt(0,3)==0 then
                        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", target,"chest"))
                        if GetRandomInt(0,1)==0 then
                                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", target,"head"))
                        else
                                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",target,"hand left"))
                                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",target,"hand right"))
                        endif
                    endif
                    // set n=CreateUnit(GetOwningPlayer(caster), 'd079', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG+GetRandomInt(-60,60))
                    // call UnitScale(n, GetRandomReal(0.45,0.75), GetRandomReal(0.45,0.75), 0.1)
                    // call SetUnitVertexColor(n, 10, 191, 255, 220)
                    // call MyRemoveUnit(n, 0.40)
                    set n=CreateUnit(GetOwningPlayer(caster), 'e0ZG', GetUnitX(caster)+40*Cos(angle), GetUnitY(caster)+40*Sin(angle), angle*bj_RADTODEG+GetRandomInt(-55,55))
                    call UnitScale(n, GetRandomReal(0.7,1.15), GetRandomReal(0.7,1.15), 0.1)
                    call SetUnitTimeScale(n,1.5)
                    call MyRemoveUnit(n, 0.4)
                    set n=CreateUnit(GetOwningPlayer(caster), 'e0ZF', GetUnitX(caster)+40*Cos(angle), GetUnitY(caster)+40*Sin(angle), angle*bj_RADTODEG+GetRandomInt(-55,55))
                    call UnitScale(n, GetRandomReal(0.7,1.15), GetRandomReal(0.7,1.15), 0.1)
                    call SetUnitTimeScale(n,1.5)
                    call MyRemoveUnit(n, 0.4)
                    set EFF=AddSpecialEffect("AZ_PA_C.mdx", GetUnitX(caster)+40*Cos(angle), GetUnitY(caster)+40*Sin(angle))
                    call SetSpecialEffectScale(EFF , GetRandomReal(1.4,1.7))
                    call SetSpecialEffectTimeScale(EFF , 0.3)
                    call SetSpecialEffectZ(EFF , GetRandomReal(20,130))
                    call SetSpecialEffectOrientation(EFF , angle * bj_RADTODEG,GetRandomReal(-70,70),GetRandomReal(-150,150))
                    call SetSpecialEffectVertexColour(EFF , 0 , 180 , 255, 220)
                    call DestroyEffect(EFF)
                    call SaveInteger(h,id,4,2)
                    if ModuloReal(time,0.12)<0.01 then
                        set n=CreateUnit(GetOwningPlayer(caster),0x65305051,GetUnitX(caster),GetUnitY(caster),angle*bj_RADTODEG)
                        call MyRemoveUnit(n,0.3)
                        call SetUnitTimeScale(n,GetRandomReal(2,4))
                        call SetUnitVertexColor(n,255,255,255,75)
                        call SetUnitAnimationByIndex(n,31)
                    endif
                else
                    call SaveInteger(h,id,4,eff_period-1)
                endif
            elseif time>1.68 and time<=1.72 then
                call SetUnitTimeScale(caster, 1.6)
                call SetUnitAnimationByIndex(caster,32)
            endif
        else
            call SetUnitTimeScale(caster, 1.0)
            
            loop
            exitwhen i>=4
                set n=CreateUnit(GetOwningPlayer(caster),'e0Y2',point_x+120*i*Cos(angle),point_y+120*i*Sin(angle),angle*bj_RADTODEG)
                call UnitApplyTimedLife(n,'BTLF',1)
                call SetUnitScale(n,0.4+0.4*i,0.4+0.4*i,0.4+0.4*i)
                call SetUnitFlyHeight(n,75+20*i,0)
                call SetUnitTimeScale(n,3)
                call SetUnitVertexColor(n,255,255,255,255)
            set i=i+1
            endloop
            set bjLCG=CreateGroup()
            call GroupEnumUnitsInRange(bjLCG, GetUnitX(target)+250*Cos(angle), GetUnitY(target)+250*Sin(angle), 350, Base)
            loop
            set E=FirstOfGroup(bjLCG)
                if Condition_Base(GetOwningPlayer(caster), E) and E!=target then
                    call myCustomDamage(caster, E, (GetHeroAgi(caster, true)*(GetUnitAbilityLevel(caster, 'A0R9')+3))*0.5, false,false,null,null,null)
                endif
                call GroupRemoveUnit(bjLCG, E)
            exitwhen E==null
            endloop
            call DestroyGroup(bjLCG)
            set n=CreateUnit(GetOwningPlayer(caster), 'd014', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG+180)
            call MyRemoveUnit(n, 1.7)
            set n=CreateUnit(GetOwningPlayer(caster), 'd019', GetUnitX(target)+200*Cos(angle), GetUnitY(target)+200*Sin(angle), angle*bj_RADTODEG)
            call SetUnitTimeScale(n, 0.8)
            call SetUnitFlyHeight(n, 200, 0) 
            call SetUnitScale(n, 1.6, 1.6, 1.6)
            call MyRemoveUnit(n, 1.5)
            set n=CreateUnit(GetOwningPlayer(caster), 'dH01', GetUnitX(target), GetUnitY(target), angle*bj_RADTODEG)
            call SetUnitScale(n, 2.5, 2.5, 2.5)
            call MyRemoveUnit(n, 1.7)
            
            call ShakeCamera(0.1, 15)
            call Push3(target,20,angle,400,"")
            call SetUnitInvulnerable(caster, false)
            call SetUnitInvulnerable(target, false)
            call PauseUnit(caster, false)
            call PauseUnit(target,false)
            call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
            call myCustomDamage(caster, target, GetHeroAgi(caster, true)*(GetUnitAbilityLevel(caster, 'A0R9')+3), false,false,null,null,null)
            call SetControlToUnit(target, target, 2.0, "stun")
            call FlushChildHashtable(h, id)
            call PauseTimer(newTimer)
            call DestroyTimer(newTimer)
        endif
        set newTimer=null
        set caster=null
        set target=null
endfunction

function TrunksR_Act2 takes nothing returns nothing
        local timer newTimer = GetExpiredTimer()
        local integer id = GetHandleId(newTimer)
        local unit caster = LoadUnitHandle(h, id, 0)
        local unit target = LoadUnitHandle(h, id, 1)
        local real angle  = LoadReal(h, id, 2)
        local real time   = LoadReal(h, id, 3)
        local real dist = LoadReal(h, id, 5)
        call SaveReal(h, id, 3, time+0.03)
        if time<0.6 then
            call SetUnitFlyHeight(caster, ParabolaZ2(0,460,510,dist,SR(GetUnitX(caster)+5*Cos(angle),GetUnitY(caster)+5*Sin(angle),GetUnitX(target),GetUnitY(target))), 0)
            if time==0.03 then
                call Push3(caster,30,angle,190,"")
            endif
            if time==0.06 then
                call SetUnitTimeScale(caster, .2)
                if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
                    if GetUnitTypeId(target)=='H048' or GetUnitTypeId(target)=='H248' then
                        set soundplay=SndN(1873) // Sound\war3mapImported\TrunksR_Frieza.mp3
                    else
                        set soundplay=SndN(1876) // Sound\war3mapImported\TrunksR.mp3
                    endif
                else
                    if GetUnitTypeId(target)=='H048' or GetUnitTypeId(target)=='H248' then
                        set soundplay=SndN(1879) // Sound\Music\mp3Music\Trunks\TrunksR_Frieza-jap.mp3
                    else
                        set soundplay=SndN(1882) // Sound\Music\mp3Music\Trunks\TrunksR-jap.mp3
                    endif
                endif
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            endif
                
            if time==0.45 then
                call ShakeCamera(0.1, 10)
                call Push3(target,35,angle,300,"")
                set n=CreateUnit(GetOwningPlayer(caster), 'd080', GetUnitX(target)+100*Cos(angle), GetUnitY(target)+100*Sin(angle), angle*bj_RADTODEG)
                call SetUnitTimeScale(n, 0.8)
                call SetUnitFlyHeight(n, 250, 0) 
                call SetUnitScale(n, 1.6, 1.6, 1.6)
                call MyRemoveUnit(n, 1.5)
            endif
        else
            set n=CreateUnit(GetOwningPlayer(caster), 'd014', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG)
            call MyRemoveUnit(n, 1.7)
            set n=CreateUnit(GetOwningPlayer(caster), 'dH01', GetUnitX(target), GetUnitY(target), angle*bj_RADTODEG)
            call SetUnitScale(n, 2.5, 2.5, 2.5)
            call MyRemoveUnit(n, 1.7)
            set n=CreateUnit(GetOwningPlayer(caster), 'dR20', GetUnitX(target), GetUnitY(target), angle*bj_RADTODEG)
            call SetUnitScale(n, 1.5, 1.5, 1.5)
            call SetUnitVertexColor(n, 255, 255, 255, 150)
            call UnitApplyTimedLife(n,'BTLF', 2.0)
            call MyRemoveUnit(n, 2.5)
            call SetUnitTimeScale(caster, 1.0)
            call SetUnitAnimationByIndex(caster,31)
            call SetUnitVertexColor(caster,255,255,255,255)
            call SetUnitXY_1(caster,GetUnitX(target)-20*Cos(angle), GetUnitY(target)-20*Sin(angle), false)
            call SaveReal(h, id, 3, 0.0)
            call SetUnitFlyHeight(caster,0,0)
            call PauseTimer(newTimer)
            call TimerStart(newTimer, 0.03, true, function TrunksR_Act3)
        endif
        set newTimer=null
        set caster=null
        set target=null
endfunction

function BurningSlashCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=AU(u,c)
local real x1=GetSpellTargetX()-200*Cos(a)
local real y1=GetSpellTargetY()-200*Sin(a)
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
    call PauseUnit(u,true)
    call SaveUnitHandle(h,id,0,u)
    call SaveUnitHandle(h,id,1,c)
    call SaveReal(h,id,2,a)
    call SaveReal(h,id,3,0.0)
    set n=CreateUnit(p, 'd042', x, y, 0)
    call MyRemoveUnit(n, 1.5)
    set n=CreateUnit(p, 'd042', x1, y1, 0)
    call SetUnitFlyHeight(n, 450, 0)
    call MyRemoveUnit(n, 1.5)
    call SetUnitXY_1(u,x1,y1, false)
    call SetUnitFacingInstant(u,a*bj_RADTODEG)
    call SaveReal(h,id,5,SR(x1,y1,GetUnitX(c),GetUnitY(c)))
    call UnitAddAbility(u, 'Arav')
    call SetUnitFlyHeight(u, 450, 0)
    call UnitRemoveAbility(u, 'Arav')
    call SetUnitVertexColor(u,255,255,255,150)
    call SetUnitInvulnerable(u,true)
    call SetUnitTimeScale(u, 2.0)
    call SetUnitAnimationByIndex(u,45)
    call PauseUnit(c,true)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
    call SetUnitInvulnerable(c,true)
    set soundplay=SndN(697) // Sound\Music\mp3Music\Soru2.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call TimerStart(t,0.03,true,function TrunksR_Act2)
else
    call SetUnitTimeScale(u,1)
    set n=CreateUnit(p, 'd042', x, y, 0)
    call MyRemoveUnit(n, 1.5)
    set n=CreateUnit(p, 'd042', x1, y1, 0)
    call SetUnitFlyHeight(n, 450, 0)
    call MyRemoveUnit(n, 1.5)
    call SetUnitXY_1(u,x1,y1, false)
    call SetUnitFacingInstant(u,a*bj_RADTODEG)
    call SetUnitX(u,x1)
    call SetUnitY(u,y1)
    call SetUnitFlyHeight(u, 450, 0)
    call PauseUnit(u,false)
    call SetUnitInvulnerable(u,false)
    call PauseUnit(c,false)
    call SetUnitAnimationByIndex(u,45)
    call SetUnitFlyHeight(u, 0, 800)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
    call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
    call PauseTimer(t)
    call DestroyTimer(t)
    call SetUnitVertexColor(u,255,255,255,255)
    call FlushChildHashtable(h,id)
endif
set t=null
set u=null
set p=null
set c=null
endfunction
function InitTrig_BurningSlash takes nothing returns nothing
set gg_trg_BurningSlash=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_BurningSlash,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_BurningSlash,Condition(function BurningSlashCond))
call TriggerAddAction(gg_trg_BurningSlash,function BurningSlashCast)
endfunction
function BurningAttackCond takes nothing returns boolean
return GetSpellAbilityId()=='A0R8'
endfunction
function BurningAttackCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local group g=LoadGroupHandle(h,id,6)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real x2
local real y2
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,5)
local real a2
local player p=GetOwningPlayer(u)
local real dmg=GetHeroAgi(u,true)*(GetUnitAbilityLevel(u,'A0R8')+1)
local real time=LoadReal(h,id,7)
if time<0.76 then
call SaveReal(h,id,7,time+0.02)
if time==0.74 then
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
set soundplay=SndN(1885) // Sound\Music\mp3Music\ThrowBurningAttack.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
else
if SR(x,y,x1,y1)<=1750 and IsTerrainPathable(GetUnitX(l__d),GetUnitY(l__d),PATHING_TYPE_FLYABILITY)==false then
set x1=x1+35*Cos(a)
set y1=y1+35*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,0.7,0.7,0.7)
call SetUnitVertexColor(n,255,230,100,70)
call GroupEnumUnitsInRange(G,x1,y1,150,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
set x2=GetUnitX(E)
set y2=GetUnitY(E)
set a2=Atan2(y2-y1,x2-x1)
call SetUnitXY_1(E,x2-58*Cos(a2),y2-58*Sin(a2),false)
call SetControlToUnit(u,E,0.04,"heavystun")
if IsUnitInGroup(E,g)==false then
call GroupAddUnit(g,E)
call SetUnitPathing(E,false)
endif
endif
call GroupRemoveUnit(G,E)
endloop
else
loop
set E=FirstOfGroup(g)
exitwhen E==null
call SetUnitFlyHeight(E,0,GetUnitFlyHeight(E))
call GroupRemoveUnit(g,E)
call SetUnitPathing(E,true)
endloop
if GetUnitAbilityLevel(u,0x41313653)>0 then
set dmg=dmg+1*GetHeroAgi(u,true)
elseif GetUnitAbilityLevel(u,'A16T')>0 or GetUnitAbilityLevel(u,'A26T')>0 then
set dmg=dmg+2*GetHeroAgi(u,true)
endif
call UnitApplyTimedLife(CreateUnit(p,'e0NJ',x1,y1,GetRandomReal(0,359)),'BTLF',3)
//call UnitApplyTimedLife(CreateUnit(p,'e0NK',x1,y1,GetRandomReal(0,359)),'BTLF',6)
call UnitApplyTimedLife(CreateUnit(p,'e0NI',x1,y1,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0NL',x1,y1,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0NM',x1,y1,GetRandomReal(0,359)),'BTLF',3)
call GroupEnumUnitsInRange(DG,x1,y1,500,Base)
loop
set E=FirstOfGroup(DG)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(DG,E)
endloop
call SetUnitTimeScale(u,1)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
call DestroyGroup(g)
call RemoveUnit(l__d)
endif
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function BurningAttackCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
local unit l__d=CreateUnit(GetOwningPlayer(u),'e0PP',x+150*Cos(a),y+150*Sin(a),f)
call SetUnitColor(l__d,PLAYER_COLOR_GREEN)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,l__d)
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveReal(h,id,5,a)
call SaveGroupHandle(h,id,6,CreateGroup())
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(1888) // Sound\Music\mp3Music\BurningAttack.mp3
else
set soundplay=SndN(1890) // Sound\Music\mp3Music\Trunks\BurningAttack-jap.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call PauseUnit(u,true)
call SetUnitTimeScale(u,2.1)
call SetUnitAnimationByIndex(u,30)
call SetUnitInvulnerable(u,true)
call TimerStart(t,0.02,true,function BurningAttackCast2)
set u=null
set t=null
set l__d=null
endfunction
function InitTrig_BurningAttack takes nothing returns nothing
set gg_trg_BurningAttack=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_BurningAttack,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_BurningAttack,Condition(function BurningAttackCond))
call TriggerAddAction(gg_trg_BurningAttack,function BurningAttackCast)
endfunction
function PowerDownVegito takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
    if GetUnitAbilityLevel(u,'A174')>0 then
        call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.0003)
    endif
    if GetUnitAbilityLevel(u,'A176')>0 then
        call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.00115)
    endif
else
    if GetUnitState(u,UNIT_STATE_MAX_MANA)*0.05>GetUnitState(u,UNIT_STATE_MANA) then
        if GetUnitAbilityLevel(u,'A174')>0 then
            call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.00015)
        endif
        if GetUnitAbilityLevel(u,'A176')>0 then
            call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.000575)
        endif
    endif
endif
if GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.1>GetUnitState(u,UNIT_STATE_LIFE) or GetUnitState(u,UNIT_STATE_MAX_MANA)*0.04>GetUnitState(u,UNIT_STATE_MANA) or LoadBoolean(HH,GetHandleId(u),SST)==true then
if GetUnitAbilityLevel(u,'A176')>0 then
call ShowAbility2Timed('VTBB',false,4.95)
call ShowAbility2Timed('A177',true,4.97)
endif
call SaveBoolean(HH,GetHandleId(u),SS,false)
call SaveBoolean(HH,GetHandleId(u),SST,false)
call UnitRemoveAbility(u,'A174')
call UnitRemoveAbility(u,'A176')
call UnitAddAbility(u,'A173')
call SetUnitAbilityLevel(u,'A278',1)
call UnitMakeAbilityPermanent(u,true,'A173')
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set t=null
set u=null
endfunction
function PowerUpVegitoCond takes nothing returns boolean
return (GetSpellAbilityId()=='VTSS' or GetSpellAbilityId()=='VTBS' or GetSpellAbilityId()=='VTBB' or GetSpellAbilityId()=='VTSG') and udg_B==true
endfunction
function PowerUpVegitoCast2 takes nothing returns nothing
	local timer t=GetExpiredTimer()
	local timer tt=CreateTimer()
	local integer id=GetHandleId(t)
	local unit u=LoadUnitHandle(h,id,0)
	local real x=GetUnitX(u)
	local real y=GetUnitY(u)
	local player p=GetOwningPlayer(u)
	local real time=LoadReal(h,id,1)
	if time<0.1 then
		call PauseUnit(u,true)
		call SaveReal(h,id,1,time+0.025)
	else
		call PauseUnit(u,false)
		call SetUnitTimeScale(u,1)
		call SetUnitAbilityLevel(u,'A278',LoadInteger(h,id,3)+1)
		if LoadInteger(h,id,3)==1 and GetUnitAbilityLevel(u,'A174')==0 then //ss
			set EFF=AddSpecialEffect("Yellow--zhendi.mdl", x, y)
			call DestroyEffect(EFF)
			call UnitRemoveAbility(u,'A173')
			call UnitRemoveAbility(u,'A174')
			call UnitRemoveAbility(u,'A176')
			call UnitAddAbility(u,'A174')
			call UnitMakeAbilityPermanent(u,true,'A174')
            call StartSound(soundStr[90])
		elseif LoadInteger(h,id,3)==2 then //ssgss
			call UnitRemoveAbility(u,'A173')
			call UnitRemoveAbility(u,'A174')
			call UnitRemoveAbility(u,'A176')
			call UnitAddAbility(u,'A176')
			set EFF=AddSpecialEffect("Blue--zhendi.mdl", x, y)
			call DestroyEffect(EFF)
            call ShowAbility2('A177',false)
            call ShowAbility2('VTBB',true)
			call UnitMakeAbilityPermanent(u,true,'A176')
			call StartSound(soundStr[90])
		endif
		if LoadInteger(h,id,3)==0 and GetUnitAbilityLevel(u,'A173')==0 then
			call StartSound(soundStr[89]) 
		endif
		if LoadBoolean(HH,GetHandleId(u),SS)==false then
			call SaveUnitHandle(h,GetHandleId(tt),0,u)
			call SaveBoolean(HH,GetHandleId(u),SS,true)
			call TimerStart(tt,0.1,true,function PowerDownVegito)
		endif
		if LoadInteger(h,id,3)==0 then
			call SaveBoolean(HH,GetHandleId(u),SST,true)
		endif
		call PauseTimer(t)
		call DestroyTimer(t)
		call FlushChildHashtable(h,id)
		endif
	set p=null
	set tt=null
	set u=null
	set t=null
endfunction
function PowerUpVegitoCast takes nothing returns nothing
	local unit u=GetTriggerUnit()
	local timer t=CreateTimer()
	local integer id=GetHandleId(t)
	local player p=GetOwningPlayer(u)
	local real x=GetUnitX(u)
	local real y=GetUnitY(u)
	call SaveUnitHandle(h,id,0,u)
	if (GetSpellAbilityId()=='VTSS' and GetUnitAbilityLevel(u,'A174')==0) or GetSpellAbilityId()=='VTSG' then
		call SaveReal(h,id,1,0.075)
        call ShowAbility2('A177',false)
        call ShowAbility2Timed('A177',true,0.025)
		//call UnitApplyTimedLife(CreateUnit(p,'e0LK',x,y,0),'BTLF',0.3)
		call UnitApplyTimedLife(CreateUnit(p,'e0LM',x,y,0),'BTLF',0.35)
	elseif GetSpellAbilityId()=='VTBS' or GetSpellAbilityId()=='VTBB' then
		call SaveReal(h,id,1,0.075)
		call SaveInteger(h,id,3,0)
    else
        call ShowAbility2('A177',false)
        call ShowAbility2Timed('A177',true,0.02)
        call SaveReal(h,id,1,0.1)
	endif
	if GetSpellAbilityId()=='VTSS' then
		// set soundplay=CreateSound("Sound\\Music\\mp3Music\\trunks ss1.mp3",false,false,true,12700,12700,"")
		call SaveInteger(h,id,3,1)
	elseif GetSpellAbilityId()=='VTSG' then
		// set soundplay=CreateSound("Sound\\Music\\mp3Music\\trunks ss2.mp3",false,false,true,12700,12700,"")
		call SaveInteger(h,id,3,2)
	endif
	call SetUnitTimeScale(u,0.5)
	call TimerStart(t,0.025,true,function PowerUpVegitoCast2)
	set u=null
	set p=null
	set t=null
endfunction
function InstantTransmissionVegitoCond takes nothing returns boolean
return GetSpellAbilityId()=='A0RI' and udg_B==true
endfunction
function InstantTransmissionVegitoCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local unit c=LoadUnitHandle(h,id,11)
local real a=LoadReal(h,id,4)
local real x1=GetUnitX(c)+70*Cos(a)
local real y1=GetUnitY(c)+70*Sin(a)
local real x2=GetUnitX(u)
local real y2=GetUnitY(u)
local real x3=GetUnitX(c)
local real y3=GetUnitY(c)
local real x4=LoadReal(h,id,16)
local real y4=LoadReal(h,id,17)
local real x5=LoadReal(h,id,18)
local real y5=LoadReal(h,id,19)
local real dmg=(0.5+GetHeroLevel(u)*0.1)*GetHeroStr(u,true)
local player p=GetOwningPlayer(u)
local real time=LoadReal(h,id,5)
local real starttime=LoadReal(h,id,6)
local real timeEnd=LoadReal(h,id,15)
if time<2.21 and GetAbilityIntegerLevelField(GetUnitAbility(u,'A0RI'), ABILITY_ILF_TARGET_TYPE,GetUnitAbilityLevel(u,'A0RI')-1)!=1 then
    call SaveReal(h,id,5,time+0.01)
    if time==starttime+0.02 then
        call SetUnitAnimationByIndex(u,23)
        call DisableUnitAbility2(u,'A0RD',false,true)
        call DisableUnitAbility2(u,'A0RE',false,true)
        call DisableUnitAbility2(u,'A0RF',false,true)
        call DisableUnitAbility2(u,'A0RH',false,true)
        call DisableUnitAbility2(u,'A0IV',false,true)
        call DisableUnitAbility2(u,'A177',false,true)
        call UnitEnableInventoryCustom(u,false,false )
    endif
    if time==starttime+0.2 and starttime<-0.7 then
        call SetAbilityStringField(GetUnitAbility(u,'A0RI'),ABILITY_SF_ICON_NORMAL,"ReplaceableTextures\\CommandButtons\\BTNCancel1.blp")
        call SetAbilityRemainingCooldown(GetUnitAbility(u,'A0RI'),0.01)
    endif
    if time==starttime+0.5 and starttime<-0.7 then
        call SetUnitTimeScale(u,0.01)
    endif
    if time<0 then
        call SetUnitFacingInstant(u,a*bj_RADTODEG)
        if not(GetUnitState(u,UNIT_STATE_LIFE)>0.405 and IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'CBC2')==0 and GetUnitAbilityLevel(u,'cbc3')==0  and GetUnitAbilityLevel(u,'cbc5')==0  and GetUnitAbilityLevel(u, 'cbc7')==0 and GetUnitAbilityLevel(u, 'cbc8')==0 and GetUnitAbilityLevel(u, 'cbc9')==0 and UnitIsAlive(u) and udg_B and DU2 and timeEnd<1) then
            call SaveReal(h,id,5,20)
            call SetUnitAcquireRange(u,600)
        endif
        if IsUnitVisible(c,p) then
            call SaveReal(h,id,15,0)
        else
            call SaveReal(h,id,15,timeEnd+0.01)
        endif
    endif
    if time==0.01 then
        call UnitRemoveAbility(u,'A1FU') //Slow
        call UnitRemoveAbility(u,'B00A')
        call SetUnitAcquireRange(u,600)
        call SetUnitInvulnerable(u,true)
        call PauseUnit(u,true)
        if IsUnitEnemy(c,p) then
            if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
                call StartSound(soundStr[134])
            else
                call StartSound(soundStr[135])
            endif
            set EFF=AddSpecialEffect("GokuAuraBurstBlue.mdl", x2, y2)
            call SetSpecialEffectTimeScale(EFF , 0.5)
            call SetSpecialEffectScale(EFF , 0.32)
            call RemoveEffect(EFF,0.3,true,CreateTimer())
        endif
    endif
    if IsUnitEnemy(c,p) then
        if time==0.51 then
            call SetUnitInvulnerable(u,true)
            call PauseUnit(u,true)
            call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x2,y2))
            call SetUnitXY_1(u,x3-60*Cos(a),y3-60*Sin(a), false)
            call SetUnitFlyHeight(u,GetUnitFlyHeight(c)+350,0)
            call SetUnitFacingInstant(u,a*bj_RADTODEG)
            set EFF=AddSpecialEffect("war3mapImported\\BlackBlink.mdx", GetUnitX(u), GetUnitY(u))
            call SetSpecialEffectZ(EFF, GetUnitFlyHeight(u))
            call DestroyEffect(EFF)
            call StartSound(soundStr[54])
            call SetUnitTimeScale(u,3)
            call SetUnitAnimationByIndex(u,25)
            set EFF=AddSpecialEffectTarget("war3mapImported\\RuneSphere.mdx",u,"left hand")
            call SetSpecialEffectScale(EFF , 0.6)
            call RemoveEffect(EFF,0.6,false,CreateTimer())
            set EFF=AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\SpiritOfVengeance\\SpiritOfVengeanceBirthMissile.mdl",u,"left hand")
            call SetSpecialEffectScale(EFF , 1.6)
            call RemoveEffect(EFF,0.6,false,CreateTimer())
        endif
        if time>0.56 and time<0.81 then
            call SetUnitInvulnerable(u,true)
            call PauseUnit(u,true) 
            call SetUnitXY_1(u,x3-60*Cos(a),y3-60*Sin(a), false)
            call SetUnitFlyHeight(u,GetUnitFlyHeight(u)+(36-R2I(time*94)),0)
        endif
        if time==0.81 or (time>0.56 and time<0.81 and GetUnitFlyHeight(u)+20<GetUnitFlyHeight(c)) then
            if IsUnitInvulnerable(c)==false and LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then    
                if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
                    call StartSound(soundStr[97])
                else
                    call StartSound(soundStr[98])
                endif
                call SaveReal(h,id,5,0.82)
                call SaveReal(h,id,16,x2)
                call SaveReal(h,id,17,y2)
                call SaveReal(h,id,18,x3)
                call SaveReal(h,id,19,y3)
                call SetUnitInvulnerable(u,true)
                call PauseUnit(u,true)
                call SetUnitInvulnerable(c,true)
                call PauseUnit(c,true)
                call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
                call SetUnitTimeScale(u,0.00)
                set EFF=AddSpecialEffect("chushou_by_wood_effect_earth_sandycrack_fag.mdl",x3,y3)
                call SetSpecialEffectScale(EFF , 0.6)
                call SetSpecialEffectZ(EFF, GetUnitFlyHeight(c))
                call RemoveEffect(EFF,1.5,false,CreateTimer())
                set EFF=AddSpecialEffect("Minato-37.mdx", x3,y3)
                call SetSpecialEffectFacing(EFF , a* bj_RADTODEG)
                call SetSpecialEffectZ(EFF, GetUnitFlyHeight(c)+30)
                call SetSpecialEffectScale(EFF , 3)
                call DestroyEffect(EFF)
                set EFF=AddSpecialEffect("WindVectorPush.mdx", x3, y3)
                call SetSpecialEffectOrientation(EFF,a*bj_RADTODEG,-90,0)
                call SetSpecialEffectZ(EFF , GetUnitFlyHeight(c)+50)
                call SetSpecialEffectVertexColour(EFF,255,255,255,120)
                call RemoveEffect(EFF,1,true,CreateTimer())
                set EFF=AddSpecialEffect("GokuAuraBurstBlue.mdl", x3, y3)
                call SetSpecialEffectTimeScale(EFF , 0.5)
                call SetSpecialEffectScale(EFF , 0.32)
                call SetSpecialEffectZ(EFF , GetUnitFlyHeight(c)+50)
                call RemoveEffect(EFF,1.1,true,CreateTimer())
                set EFF=AddSpecialEffect("war3mapImported\\Energy_Release.mdl", x3, y3)
                call SetSpecialEffectTimeScale(EFF , 0.5)
                call SetSpecialEffectScale(EFF , 1.42)
                call SetSpecialEffectZ(EFF , GetUnitFlyHeight(c))
                call RemoveEffect(EFF,1.1,true,CreateTimer())
            else
                if IsUnitInvulnerable(c)==true then
                    call SaveReal(h,id,5,20)
                    call SetUnitInvulnerable(u,false)
                    call PauseUnit(u,false)
                    call Push9(u,10,a,30)
                    call SetUnitAnimationByIndex(u,26)
                elseif LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==true then
                    call SaveReal(h,id,5,20)
                    call SetUnitInvulnerable(u,false)
                    call PauseUnit(u,false)
                    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
                    call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
                    call Push9(u,10,a,30)
                    call SetUnitAnimationByIndex(u,26)
                endif
            endif
        endif
        if time>0.82 and time<2.05 then
            call SetUnitXY_1(u,x4,y4, false)
            call SetUnitXY_1(c,x5,y5, false)
            call SetUnitFlyHeight(c,GetUnitFlyHeight(u)-39,0)
            call SetUnitInvulnerable(u,true)
            call PauseUnit(u,true)
            call SetUnitInvulnerable(c,true)
            call PauseUnit(c,true)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
        endif
        if time==2.05 then
            call SetUnitAnimationByIndex(u,26)
            call Push9(c,10,a,50)
            set EFF=AddSpecialEffect("war3mapImported\\CF2.mdl", x3,y3)
            call SetSpecialEffectOrientation(EFF,a*bj_RADTODEG,90,0)
            call SetSpecialEffectZ(EFF, GetUnitFlyHeight(c)+50)
            call SetSpecialEffectScale(EFF , 1)
            call DestroyEffect(EFF)
            set EFF=AddSpecialEffect("GokuAuraBurstBlue.mdl", x3, y3)
            call SetSpecialEffectTimeScale(EFF , 2)
            call SetSpecialEffectScale(EFF , 0.22)
            call SetSpecialEffectZ(EFF , GetUnitFlyHeight(c))
            call SetSpecialEffectOrientation(EFF,a*bj_RADTODEG,-180,0)
            call RemoveEffect(EFF,0.2,true,CreateTimer())
            set EFF=AddSpecialEffect("war3mapImported\\Energy_Release.mdl", x3, y3)
            call SetSpecialEffectTimeScale(EFF , 1)
            call SetSpecialEffectScale(EFF , 0.62)
            call SetSpecialEffectZ(EFF , GetUnitFlyHeight(c)-60)
            call RemoveEffect(EFF,0.3,true,CreateTimer())
        endif
        if time==2.2 then
            call SetUnitInvulnerable(c,false)
            call PauseUnit(c,false)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
            if GetUnitAbilityLevel(u,'A176')>0 then
                set dmg=dmg+1*GetHeroStr(u,true)
            endif
            call myCustomDamage(u,c,dmg,false,false,null,null,null)
            call SetControlToUnit(u,c, 0.75, "stun")
            call SetUnitTimeScale(u,1)
            call SetUnitFlyHeight(u,0,2500)
            call SetUnitInvulnerable(u,false)
            call PauseUnit(u,false)
            call UnitEnableInventoryCustom(u,true,false )
            set a=Atan2(y3-y2,x3-x2)
            call SaveReal(h,id,4,a)
            call SetUnitFacingInstant(u,a*bj_RADTODEG)
        endif
    else
        if time==0.21 then
            call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x2,y2))
            call SetUnitXY_1(u,x1,y1, false)
            set EFF=AddSpecialEffect("war3mapImported\\BlackBlink.mdx", GetUnitX(u), GetUnitY(u))
            call SetSpecialEffectZ(EFF, GetUnitFlyHeight(u))
            call DestroyEffect(EFF)
            call StartSound(soundStr[54])
            set a=Atan2(GetUnitY(u)-y3,GetUnitX(u)-x3)
            call SaveReal(h,id,4,a)
            call SetUnitFacingInstant(u,a*bj_RADTODEG)
            call SetUnitTimeScale(u,1)
            call SetUnitInvulnerable(u,false)
            call PauseUnit(u,false)
            call UnitEnableInventoryCustom(u,true,false )
            call SaveReal(h,id,5,20)
        endif
    endif
else
    if GetAbilityIntegerLevelField(GetUnitAbility(u,'A0RI'), ABILITY_ILF_TARGET_TYPE,GetUnitAbilityLevel(u,'A0RI')-1)!=1 and timeEnd<1 then
        call SetAbilityRemainingCooldown(GetUnitAbility(u,'A0RI'),GetAbilityBaseRealLevelFieldById('A0RI',ABILITY_RLF_COOLDOWN,GetUnitAbilityLevel(u,'A0RI')-1))
        if LoadBoolean(HH,GetHandleId(u),ITRangeHash) then
            if GetUnitState(u,UNIT_STATE_MANA)>GetUnitState(u,UNIT_STATE_MAX_MANA)*0.05 then
                call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.05)
            else
                call SetUnitState(u,UNIT_STATE_MANA,1)
            endif
        else
            if GetUnitState(u,UNIT_STATE_MANA)>GetUnitState(u,UNIT_STATE_MAX_MANA)*0.1 then
                call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.1)
            else
                call SetUnitState(u,UNIT_STATE_MANA,1)
            endif
        endif
    else
        call SetAbilityRemainingCooldown(GetUnitAbility(u,'A0RI'),5)
    endif
    call PauseTimer(t)
    call DestroyTimer(t)
    call EnableUnitAbility2(u,'A0RD',false,true)
    call EnableUnitAbility2(u,'A0RE',false,true)
    call EnableUnitAbility2(u,'A0RF',false,true)
    call EnableUnitAbility2(u,'A0RH',false,true)
    call EnableUnitAbility2(u,'A0IV',false,true)
    call EnableUnitAbility2(u,'A177',false,true)
    call UnitEnableInventoryCustom(u,true,false )
    call UnitRemoveAbility(u,'A1FU')
    call UnitRemoveAbility(u,'B00A')
    call SetAbilityStringField(GetUnitAbility(u,'A0RI'),ABILITY_SF_ICON_NORMAL,"ReplaceableTextures\\CommandButtons\\BTNVegitoG.blp")
    call SetAbilityStringLevelField(GetUnitAbility(u,'A0RI'),ABILITY_SLF_TOOLTIP_NORMAL,GetUnitAbilityLevel(u,'A0RI')-1,GetAbilityBaseStringLevelFieldById('A0RI',ABILITY_SLF_TOOLTIP_NORMAL,GetUnitAbilityLevel(u,'A0RI')-1))
    call SetAbilityStringLevelField(GetUnitAbility(u,'A0RI'),ABILITY_SLF_TOOLTIP_NORMAL_EXTENDED,GetUnitAbilityLevel(u,'A0RI')-1,GetAbilityBaseStringLevelFieldById('A0RI',ABILITY_SLF_TOOLTIP_NORMAL_EXTENDED,GetUnitAbilityLevel(u,'A0RI')-1))
    call SetAbilityIntegerLevelField(GetUnitAbility(u,'A0RI'), ABILITY_ILF_TARGET_TYPE,GetUnitAbilityLevel(u,'A0RI')-1,1)
    call SetUnitAnimation(u,"stand")
    call SetUnitTimeScale(u,1)
    call FlushChildHashtable(h,id)
endif
set u=null
set c=null
set t=null
set p=null
    set l__d=null
endfunction
function InstantTransmissionVegitoCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1
local real y1
local real a
local player p=GetOwningPlayer(u)
if GetAbilityIntegerLevelField(GetUnitAbility(u,'A0RI'), ABILITY_ILF_TARGET_TYPE,GetUnitAbilityLevel(u,'A0RI')-1)==1 then
    set c=GetSpellTargetUnit()
    set x1=GetUnitX(c)
    set y1=GetUnitY(c)
    set a=Atan2(y1-y,x1-x)
    if SquareRootUnit(u,c)<1000 then
        call SaveBoolean(HH,GetHandleId(u),ITRangeHash,true)
    else
        call SaveBoolean(HH,GetHandleId(u),ITRangeHash,false)
    endif
    if GetUnitAbilityLevel(u,'Pet1')==0 then
        call SetAbilityIntegerLevelField(GetUnitAbility(u,'A0RI'), ABILITY_ILF_TARGET_TYPE,GetUnitAbilityLevel(u,'A0RI')-1,0)
        call SaveUnitHandle(h,id,0,u)
        call SaveUnitHandle(h,id,11,c)
        call SaveReal(h,id,4,a)
        call UnitAddAbility(u,'A1FU') //Slow
        call SetUnitAcquireRange(u,51)
        if SquareRootUnit(u,c)<1000 then
            call SaveReal(h,id,5,0)
            call SetUnitInvulnerable(u,true)
            call PauseUnit(u,true)
        else
            call SetAbilityStringLevelField(GetUnitAbility(u,'A0RI'),ABILITY_SLF_TOOLTIP_NORMAL,GetUnitAbilityLevel(u,'A0RI')-1,GetAbilityBaseStringLevelFieldById('A1RI',ABILITY_SLF_TOOLTIP_NORMAL,0))
            call SetAbilityStringLevelField(GetUnitAbility(u,'A0RI'),ABILITY_SLF_TOOLTIP_NORMAL_EXTENDED,GetUnitAbilityLevel(u,'A0RI')-1,GetAbilityBaseStringFieldById('A1RI',ABILITY_SLF_TOOLTIP_NORMAL_EXTENDED))
            if SquareRootUnit(u,c)<8000 then
                call SaveReal(h,id,5,-0.001*((SquareRootUnit(u,c)-1000-ModuloReal(SquareRootUnit(u,c),10))))
                call SaveReal(h,id,6,-0.001*((SquareRootUnit(u,c)-1000-ModuloReal(SquareRootUnit(u,c),10))))
            else
                call SaveReal(h,id,5,-7)
                call SaveReal(h,id,6,-7)
            endif
        endif
        call TimerStart(t,0.01,true,function InstantTransmissionVegitoCast2)
    endif
else
    call DestroyTimer(t)
    call EnableUnitAbility2(u,'A0RD',false,true)
    call EnableUnitAbility2(u,'A0RE',false,true)
    call EnableUnitAbility2(u,'A0RF',false,true)
    call EnableUnitAbility2(u,'A0RH',false,true)
    call EnableUnitAbility2(u,'A0IV',false,true)
    call EnableUnitAbility2(u,'A177',false,true)
    call SetAbilityStringLevelField(GetUnitAbility(u,'A0RI'),ABILITY_SLF_TOOLTIP_NORMAL,GetUnitAbilityLevel(u,'A0RI')-1,GetAbilityBaseStringLevelFieldById('A0RI',ABILITY_SLF_TOOLTIP_NORMAL,GetUnitAbilityLevel(u,'A0RI')-1))
    call SetAbilityStringLevelField(GetUnitAbility(u,'A0RI'),ABILITY_SLF_TOOLTIP_NORMAL_EXTENDED,GetUnitAbilityLevel(u,'A0RI')-1,GetAbilityBaseStringLevelFieldById('A0RI',ABILITY_SLF_TOOLTIP_NORMAL_EXTENDED,GetUnitAbilityLevel(u,'A0RI')-1))
    call SetAbilityIntegerLevelField(GetUnitAbility(u,'A0RI'), ABILITY_ILF_TARGET_TYPE,GetUnitAbilityLevel(u,'A0RI')-1,1)
endif
set u=null
set c=null
set p=null
set t=null
endfunction
function InitTrig_InstantTransmissionVegito takes nothing returns nothing
set gg_trg_InstantTransmissionVegito=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_InstantTransmissionVegito,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_InstantTransmissionVegito,Condition(function InstantTransmissionVegitoCond))
call TriggerAddAction(gg_trg_InstantTransmissionVegito,function InstantTransmissionVegitoCast)
endfunction
function FinalFlashCond takes nothing returns boolean
return GetSpellAbilityId()=='A0RJ' and udg_B==true
endfunction
function FinalFlashCast4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real a=LoadReal(h,id,11)
local real dist=LoadReal(h,id,2)
local real x=GetUnitX(l__d)+55*Cos(a)
local real y=GetUnitY(l__d)+55*Sin(a)
local real lvl=LoadReal(h,id,13)
local real dmg=LoadReal(h,id,4)
local real Cg1=LoadReal(h,id,14)
local real scale=LoadReal(h,id,10)
local real temp=LoadReal(h,id,15)
local group g=LoadGroupHandle(h,id,12)
local integer idg2=GetHandleId(g)
local player p=GetOwningPlayer(u)
if dist>0 and RectContainsUnit(WorldBoundsR(),l__d) and UnitIsAlive(l__d) and udg_B then
call SetUnitXY_1(l__d,x,y, false)
call SetUnitScale(l__d,Cg1*.018,Cg1*.018,Cg1*.018)
if Cg1*2.9<lvl or 2*Cg1>dist then
call SaveReal(h,id,14,Cg1+(2*SquareRoot(dist*2.9)-8*SquareRoot(Cg1)))
endif
if LoadReal(h,id,14)<lvl then
call SaveReal(h,id,14,LoadReal(h,id,14)*1.07)
elseif 2*LoadReal(h,id,14)<dist then
call SaveReal(h,id,14,lvl)
endif
if temp==0 then
    set n=CreateUnit(p,'e1CK',x+95*Cos(a),y+95*Sin(a),a*bj_RADTODEG+GetRandomReal(-20,20))
    call UnitApplyTimedLife(n,'BTLF',1+dist/4150)
    call SetUnitScale(n,scale*1.1,scale*1.1,scale*1.1)
    set n=CreateUnit(p,'e0LN',GetUnitX(u),GetUnitY(u),a*bj_RADTODEG+GetRandomReal(-20,20))
    call SetUnitFlyHeight(n,10,0)
    call UnitApplyTimedLife(n,'BTLF',2)
    call SetUnitScale(n,scale/3.3,scale/3.3,scale/3.3)
elseif temp>=9 then
    set n=CreateUnit(p,'e2PT',x,y,a*bj_RADTODEG+GetRandomReal(-20,20))
    call UnitApplyTimedLife(n,'BTLF',1+dist/4150)
    call SetUnitScale(n,Cg1*.012,Cg1*.012,Cg1*.012)
    call SetUnitFlyHeight(n,10,0)
    call SetUnitTimeScale(n,1)
//    set n=CreateUnit(p,'e0LN',GetUnitX(u),GetUnitY(u),a*bj_RADTODEG)
//    call SetUnitFlyHeight(n,10,0)
//    call UnitApplyTimedLife(n,'BTLF',1)
//    call SetUnitScale(n,scale/3,scale/3,scale/3)
    call SaveReal(h,id,15,0)
endif
set n=CreateUnit(p,'e1PT',x,y,a*bj_RADTODEG+GetRandomReal(-20,20))
call UnitApplyTimedLife(n,'BTLF',1+dist/4150)
call SetUnitScale(n,Cg1*.015,Cg1*.015,Cg1*.015)
call SetUnitVertexColor(n,255,220,40,50)
call SetUnitTimeScale(n,7)
set n=CreateUnit(p,'e0PT',x,y,a*bj_RADTODEG+GetRandomReal(-20,20))
call UnitApplyTimedLife(n,'BTLF',1+dist/4150)
call SetUnitScale(n,Cg1*.037,Cg1*.037,Cg1*.037)
call SetUnitVertexColor(n,255,220,40,170)
call SaveReal(h,id,2,dist-55)
call SaveReal(h,id,15,temp+1)
call GroupEnumUnitsInRange(g,x,y,Cg1,Base)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E) and LoadUnitHandle(h,idg2,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg2,ide,E)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
else
call CameraSetTargetNoiseEx(0,0,true)
call CameraSetSourceNoiseEx(0,0,true)
call SetUnitInvulnerable(u,false)
call RemoveUnit(l__d)
call PauseUnit(u,false)
call StartAbilityCooldown(GetUnitAbility(u, 'A0RJ'), 35)
call FlushChildHashtable(h,idg2)
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set u=null
set l__d=null
set p=null
    set t=null
endfunction
function FinalFlashCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real a=LoadReal(h,id,11)
local real dist=LoadReal(h,id,2)
local real lvl=LoadReal(h,id,13)
local real Cg1=LoadReal(h,id,14)
local real dmg=LoadReal(h,id,4)
local real scale=LoadReal(h,id,10)
local real scale2=LoadReal(h,id,17)
local real x1=LoadReal(h,id,5)
local real y1=LoadReal(h,id,6)
local real time=LoadReal(h,id,16)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,12)
if time>0 then
call SaveReal(h,id,16,time-0.05)
call SaveReal(h,id,17,scale2+.1)
call SetUnitScale(l__d,scale2,scale2,scale2)
call SetUnitFacingInstant(u,a*bj_RADTODEG)
call SetUnitX(u,GetUnitX(l__d)-55*Cos(a))
call SetUnitY(u,GetUnitY(l__d)-55*Sin(a))
if time==1 then
call RemoveEffect(AddSpecialEffectTarget("krk (1849).mdl", u, "hand right"), 1.5, true, CreateTimer())
endif
else
call UnitApplyTimedLife(CreateUnit(p,'e0L6',x+55*Cos(a),y+55*Sin(a),a*bj_RADTODEG),'BTLF',1)
call UnitAddAbility(l__d,'A0NN')
call SetUnitX(u,x-55*Cos(a))
call SetUnitY(u,y-55*Sin(a))
call PauseTimer(t)
call TimerStart(t,.015,true,function FinalFlashCast4)
endif
    set t=null
    set u=null
    set l__d=null
    set g=null
endfunction
function FinalFlashCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,5)
local real y1=LoadReal(h,id,6)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real dmg=LoadReal(h,id,4)
local real dist=LoadReal(h,id,2)
local real scale=LoadReal(h,id,10)
local real lvl=LoadReal(h,id,13)
if GetUnitCurrentOrder(u)==OrderId("curse") then
set n=CreateUnit(p,'e0B2',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',.01)
call SetUnitVertexColor(n,255,220,40,50)
call SaveReal(h,id,4,dmg+.14*GetHeroStr(u,true))
call SaveReal(h,id,2,dist+125)
call SaveReal(h,id,13,lvl+5)
call SetUnitX(l__d,x+55*Cos(a))
call SetUnitY(l__d,y+55*Sin(a))
call SaveReal(h,id,10,scale+.025)
call SetUnitFacingInstant(u,a*bj_RADTODEG)
call SetUnitScale(l__d,scale,scale,scale)
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\FarseerMissile\\FarseerMissile.mdl",x+GetRandomReal(-355,355),y+GetRandomReal(-355,355)))
else
call IssueImmediateOrder(u,"stop")
call PauseUnit(u,true)
call StopSound(LoadSoundHandle(h,id,16),false,true) // звук из массива — останавливаем, не удаляем
if dist>5250 then
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(1892) // Sound\Music\mp3Music\FinalFlash.mp3
else
set soundplay=SndN(1895) // Sound\Music\mp3Music\Vegeta\FinalFlash-jap.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(1898) // Sound\Music\mp3Music\FinalFlash2.mp3
else
set soundplay=SndN(1901) // Sound\Music\mp3Music\Vegeta\FinalFlash2-jap.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call SetUnitInvulnerable(u,true)
call SetUnitTimeScale(u,1)
if GetUnitAbilityLevel(u,'VGH4')==0 then
call SetUnitAnimation(u,"Spell Throw")
else
call SetUnitAnimation(u,"Spell Throw Alternate")
endif
if dist>5250 then
call SaveReal(h,id,16,3)
else
call SaveReal(h,id,16,1.2)
endif
call SaveReal(h,id,17,scale)
call SetUnitScale(l__d,scale+0.3,scale+0.3,scale+0.3)
call PauseTimer(t)
call TimerStart(t,0.05,true,function FinalFlashCast3)
endif
set l__d=null
set p=null
set u=null
set t=null
endfunction
function FinalFlashCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
call SaveUnitHandle(h,id,0,u)
if GetUnitAbilityLevel(u,'VGH4')==0 then
call SetUnitAnimation(u,"Spell Channel")
else
call SetUnitAnimation(u,"Spell Channel Alternate")
endif
call SaveReal(h,id,5,x1)
call SaveReal(h,id,6,y1)
call SaveReal(h,id,4,11*GetHeroStr(u,true))
call SaveReal(h,id,2,4000)
call SaveReal(h,id,10,1.25)
call SaveReal(h,id,11,a)
call SaveReal(h,id,14,200)
call SetUnitTimeScale(u,.6)
call SaveGroupHandle(h,id,12,CreateGroup())
call SaveReal(h,id,13,550)
call CameraSetTargetNoiseEx(3*2.,3*Pow(10,2),true)
call CameraSetSourceNoiseEx(3*2.,3*Pow(10,2),true)
call SaveUnitHandle(h,id,7,CreateUnit(p,'e0PS',x+40*Cos(a),y+40*Sin(a),a*bj_RADTODEG))
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(1904) // Sound\Music\mp3Music\FinalKamehamehaCharges.mp3
else
set soundplay=SndN(1906) // Sound\Music\mp3Music\Vegeta\FinalKamehamehaCharges-jap.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay)
call SaveSoundHandle(h,id,16,soundplay)
call TimerStart(t,0.1,true,function FinalFlashCast2)
set u=null
set p=null
set t=null
endfunction
function InitTrig_FinalFlash takes nothing returns nothing
set gg_trg_FinalFlash=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_FinalFlash,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_FinalFlash,Condition(function FinalFlashCond))
call TriggerAddAction(gg_trg_FinalFlash,function FinalFlashCast)
endfunction
function SpiritSwordVegitoCond takes nothing returns boolean
return GetSpellAbilityId()=='A0RH' and udg_B==true
endfunction
function SpiritSwordVegitoCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=LoadReal(h,id,5)
local real dmg=(GetUnitAbilityLevel(u,'A0RH')+4)*GetHeroStr(u,true)
local player p=GetOwningPlayer(u)
local real time=LoadReal(h,id,7)
local real mt=LoadReal(h,id,8)
local real ang=GetRandomReal(-1.1,1.1)
if mt>0 and UnitIsAlive(u)and UnitIsAlive(c) and udg_B then
    if mt>11 then
        set x1=x1+((10-mt)+31)*Cos(a)
        set y1=y1+((10-mt)+31)*Sin(a)
        call SetUnitXY_1(c,x1,y1, false)
        set x1=x1+(time*2-140)*Cos(a)
        set y1=y1+(time*2-140)*Sin(a)
        call SetUnitXY_1(u,x1,y1, false)
        call PauseUnit(c,true)
        call SetUnitInvulnerable(c,true)
        call PauseUnit(u,true)
        call SetUnitInvulnerable(u,true)
    endif
    if mt==20 and time>=16 then
        call SetUnitAnimationByIndex(u,22)
    endif
    if mt==11 and time>=9 then
        call SetUnitAnimationByIndex(u,27)
        call Push3(c,50,a,100,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
    endif
    if mt==9 and time>6 then
        set EFF=AddSpecialEffect("WindVectorPush.mdx", x1,y1)
        call SetSpecialEffectOrientation(EFF,a*bj_RADTODEG,0,0)
        call SetSpecialEffectScale(EFF , 0.6)
        call SetSpecialEffectZ(EFF , 90)
        call SetSpecialEffectVertexColour(EFF,255,255,255,220)
        call RemoveEffect(EFF,1,true,CreateTimer())
    endif
    if mt==8 and time>=6  then
        call UnitAddAbility(u,'A0RG')
        call Push3(c,50,a,300,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
        call EffectToRandomBone("war3mapImported\\BloodEX.mdx",c)
    endif
    if mt==6 and time>=4 then
        call SetUnitTimeScale(u,0.7)
        call SetUnitAnimationByIndex(u,17)
    endif
    if mt==5 and time>=3 then
        call Push(u,100,a,1200)
    endif
    if mt==4 and time>1 then
        set EFF=AddSpecialEffect("BrolyKickSlash.mdl", x+140*Cos(a),y+140*Sin(a))
        call SetSpecialEffectOrientation(EFF , a* bj_RADTODEG,0,-179)
        call SetSpecialEffectTimeScale(EFF , 0.5)
        call SetSpecialEffectScale(EFF , 1.6)
        call SetSpecialEffectZ(EFF, 170)
        call SaveEffectHandle(h,id,21,EFF)
        call RemoveEffect(EFF,1.2,true,CreateTimer())
        set EFF=AddSpecialEffect("BrolyKickSlash.mdl", x+140*Cos(a),y+140*Sin(a))
        call SetSpecialEffectOrientation(EFF , a* bj_RADTODEG,0,-179)
        call SetSpecialEffectTimeScale(EFF , 0.5)
        call SetSpecialEffectScale(EFF , 2.1)
        call SetSpecialEffectZ(EFF, 200)
        call SaveEffectHandle(h,id,22,EFF)
        call RemoveEffect(EFF,1.2,true,CreateTimer())
        set EFF=AddSpecialEffect("BrolyKickSlash.mdl", x+140*Cos(a),y+140*Sin(a))
        call SetSpecialEffectOrientation(EFF , a* bj_RADTODEG,0,-179)
        call SetSpecialEffectTimeScale(EFF , 0.5)
        call SetSpecialEffectScale(EFF , 2.7)
        call SetSpecialEffectZ(EFF, 240)
        call SaveEffectHandle(h,id,23,EFF)
        call RemoveEffect(EFF,1.2,true,CreateTimer())
        set EFF=AddSpecialEffect("BrolyKickSlash.mdl", x+140*Cos(a),y+140*Sin(a))
        call SetSpecialEffectOrientation(EFF , a* bj_RADTODEG,0,-179)
        call SetSpecialEffectTimeScale(EFF , 0.5)
        call SetSpecialEffectScale(EFF , 3.3)
        call SetSpecialEffectZ(EFF, 280)
        call SaveEffectHandle(h,id,24,EFF)
        call RemoveEffect(EFF,1.2,true,CreateTimer())
        set EFF=AddSpecialEffect("BrolyKickSlash.mdl", x+140*Cos(a),y+140*Sin(a))
        call SetSpecialEffectOrientation(EFF , a* bj_RADTODEG,0,-179)
        call SetSpecialEffectTimeScale(EFF , 0.5)
        call SetSpecialEffectScale(EFF , 4)
        call SetSpecialEffectZ(EFF, 320)
        call SaveEffectHandle(h,id,25,EFF)
        call RemoveEffect(EFF,1.2,true,CreateTimer())
    endif
    if mt<=4 then
        call SetSpecialEffectX(LoadEffectHandle(h,id,21),x+140*Cos(a))
        call SetSpecialEffectY(LoadEffectHandle(h,id,21),y+140*Sin(a))
        call SetSpecialEffectX(LoadEffectHandle(h,id,22),x+140*Cos(a))
        call SetSpecialEffectY(LoadEffectHandle(h,id,22),y+140*Sin(a))
        call SetSpecialEffectX(LoadEffectHandle(h,id,23),x+140*Cos(a))
        call SetSpecialEffectY(LoadEffectHandle(h,id,23),y+140*Sin(a))
        call SetSpecialEffectX(LoadEffectHandle(h,id,24),x+140*Cos(a))
        call SetSpecialEffectY(LoadEffectHandle(h,id,24),y+140*Sin(a))
        call SetSpecialEffectX(LoadEffectHandle(h,id,25),x+140*Cos(a))
        call SetSpecialEffectY(LoadEffectHandle(h,id,25),y+140*Sin(a))
    endif
    if mt==2 then
        call UnitRemoveAbility(u,'A0RG')
    endif
    if time<0 then
        if GetUnitAbilityLevel(u,'A0RG')==0 then
            call EffectToRandomBone("az_hit-red-blade.mdx",c)
            call EffectToRandomBone("az_hit-red-blade.mdx",c)
            call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",x1,y1))
            if mt>8 then
                set EFF=AddSpecialEffect("Minato-37.mdx", (x1+170*Cos(a))+GetRandomReal(-45,45)*Cos(GetRandomReal(0,359)),(y1+170*Sin(a))+GetRandomReal(-45,45)*Sin(GetRandomReal(0,359)))
                call SetSpecialEffectFacing(EFF , a* bj_RADTODEG)
                call SetSpecialEffectScale(EFF , GetRandomReal(1.25,2.35))
                call SetSpecialEffectZ(EFF , GetRandomReal(30,90))
                call DestroyEffect(EFF)
                set EFF=AddSpecialEffect("WindVectorPush.mdx", (x1+170*Cos(a))+GetRandomReal(-45,45)*Cos(GetRandomReal(0,359)),(y1+170*Sin(a))+GetRandomReal(-45,45)*Sin(GetRandomReal(0,359)))
                call SetSpecialEffectOrientation(EFF,a*bj_RADTODEG,0,0)
                call SetSpecialEffectScale(EFF , GetRandomReal(0.25,0.45))
                call SetSpecialEffectZ(EFF , GetRandomReal(70,100))
                call SetSpecialEffectVertexColour(EFF,255,255,255,160)
                call RemoveEffect(EFF,1,true,CreateTimer())
            endif
        endif
        set n=CreateUnit(p,'e0H9',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',0.7)
        call SetUnitVertexColor(n,200,200,200,70)
        call SaveReal(h,id,7,mt)
        call SaveReal(h,id,8,mt-1)
    endif
    call SetUnitFacing(u,a*bj_RADTODEG)
    call SaveReal(h,id,7,LoadReal(h,id,7)-3)
else
    call ShakeCamera(0.8,20)
    call EffectToRandomBone("war3mapImported\\BloodEX.mdx",c)
    call PauseUnit(c,false)
    call SetUnitInvulnerable(c,false)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
    call PauseUnit(u,false)
    call SetUnitInvulnerable(u,false)
    call myCustomDamage(u,c,dmg,false,false,null,null,null)
    call SetControlToUnit(u,c,2, "stun")
    call PauseTimer(t)
    call DestroyTimer(t)
    call SetUnitVertexColor(u,255,255,255,255)
    call FlushChildHashtable(h,id)
    call SetUnitTimeScale(u,1)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function SpiritSwordVegitoCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
    call PauseUnit(c,true)
    call SetUnitInvulnerable(c,true)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
    call PauseUnit(u,true)
    call SetUnitInvulnerable(u,true)
    call SaveUnitHandle(h,id,0,u)
    call SaveUnitHandle(h,id,1,c)
    call SaveReal(h,id,7,20)
    call SaveReal(h,id,8,20)
    call SaveReal(h,id,5,Atan2(y1-y,x1-x))
    call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
    call SetUnitXY_1(u,x1,y1, false)
    call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x1,y1))
    call SetUnitVertexColor(u,255,255,255,225)
    if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
        set soundplay=SndN(1908) // Sound\Music\mp3Music\VegittoR.mp3
    else
        set soundplay=SndN(1910) // Sound\Music\mp3Music\Vegitto\VegittoR-jap.mp3
    endif
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call TimerStart(t,0.03,true,function SpiritSwordVegitoCast2)
else
    call SetUnitTimeScale(u,1)
    call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
    call SetUnitXY_1(u,x1,y1, false)
    call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x1,y1))
    call PauseUnit(u,false)
    call SetUnitInvulnerable(u,false)
    call PauseUnit(c,false)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
    call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
    call PauseTimer(t)
    call DestroyTimer(t)
    call SetUnitVertexColor(u,255,255,255,255)
    call FlushChildHashtable(h,id)
endif
set t=null
set u=null
set p=null
set c=null
endfunction
function InitTrig_SpiritSwordVegito takes nothing returns nothing
set gg_trg_SpiritSwordVegito=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_SpiritSwordVegito,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_SpiritSwordVegito,Condition(function SpiritSwordVegitoCond))
call TriggerAddAction(gg_trg_SpiritSwordVegito,function SpiritSwordVegitoCast)
endfunction
function BigBangBeamCond takes nothing returns boolean
return GetSpellAbilityId()=='A0RE' and udg_B==true
endfunction
function BigBangBeamCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local unit c=LoadUnitHandle(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local real f=GetUnitFacing(u)
local real speed=LoadReal(h,id,5)
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>speed+30 then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SaveReal(h,id,5,speed+0.8)
call SetUnitFacing(l__d,a*bj_RADTODEG)
set n=CreateUnit(p,'e0C0',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0C2',x,y,GetRandomReal(0,359)),'BTLF',1)
else
call UnitApplyTimedLife(CreateUnit(p,'e0C4',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0C5',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0CC',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0CD',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0C6',x,y,(a*bj_RADTODEG)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e0C7',x,y,(a*bj_RADTODEG)),'BTLF',6)
call StartSound(soundStr[47])
call myCustomDamage(u,c,(GetUnitAbilityLevel(u,'A0RE')+1)*GetHeroStr(u,true)+50,false,false,null,null,null)
call SetControlToUnit(u,c,2, "stun")
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
endif
set p=null
set u=null
set l__d=null
set t=null
set c=null
endfunction
function BigBangBeamCast takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real f=GetUnitFacing(u)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,5,37)
call SaveUnitHandle(h,id,1,CreateUnit(GetOwningPlayer(u),'e0C1',GetUnitX(u)+50.*Cos(f*bj_DEGTORAD),GetUnitY(u)+50.*Cos(f*bj_DEGTORAD),f))
call SaveUnitHandle(h,id,2,GetSpellTargetUnit())
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
    set soundplay=SndN(1912) // Sound\Music\mp3Music\BigBangBeam.mp3
else
    set soundplay=SndN(1914) // Sound\Music\mp3Music\Vegitto\BigBangBeam-jap.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.025,true,function BigBangBeamCast2)
set u=null
set t=null
endfunction
