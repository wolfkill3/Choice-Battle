local real f=GetUnitFacing(u)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,CreateUnit(GetOwningPlayer(u),0x65303258,GetUnitX(u)+50.*Cos(f*bj_DEGTORAD),GetUnitY(u)+50.*Cos(f*bj_DEGTORAD),f))
call SaveUnitHandle(h,id,2,GetSpellTargetUnit())
call SaveReal(h,id,13,(1+GetUnitAbilityLevel(u,'A084'))*GetHeroInt(u,true))
set soundplay=SndN(910) // Sound\Music\mp3Music\GokuGunSound.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
