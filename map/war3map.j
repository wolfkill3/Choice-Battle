set GS=CreateTrigger()
loop
call TriggerRegisterPlayerUnitEvent(GS,Player(i),EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER,null)
call TriggerRegisterPlayerUnitEvent(GS,Player(i),EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(GS,function Godspeed2Cast)
call TriggerAddCondition(GS,Condition(function Godspeed2Cond))
endfunction
function GodspeedCond takes nothing returns boolean
return GetSpellAbilityId()=='A0UU'
endfunction
function GodspeedCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local integer idu=GetHandleId(GetOwningPlayer(u))
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
call UnitApplyTimedLife(CreateUnit(p,'e0IP',x,y,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0IU',x,y,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0IS',x,y,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0IV',x,y,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0IR',x,y,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0IT',x,y,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e086',x,y,GetRandomReal(0,359)),'BTLF',2)
set soundplay=SndN(2088) // Sound\Music\mp3Music\GodSpeed.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SaveReal(HH,idu,SH_st,LoadReal(HH,idu,SH_st)+1350+GetHeroAgi(u,true)*(GetUnitAbilityLevel(u,'A0UU')+1))
set u=null
set p=null
endfunction
