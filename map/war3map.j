call SaveReal(HH,id,12,y00)
call TimerStart(t,0.02,true,function JirayaTWAct)
set JirayaBunta=null
set t=null
set Jiraya=null
endfunction


function JirayaTQAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local real facing
local real time
local unit Dummy
local real time1
set n0=LoadUnitHandle(HH,id,2)
set facing=LoadReal(HH,id,3)
set time=LoadReal(HH,id,5)
set time=time+0.02
call SaveReal(HH,id,5,time)
if time==12 then
    call GroupClear(LoadGroupHandle(HH,id,4))
    if LoadGroupHandle(HH,id,4)!=null then
    call DestroyGroup(LoadGroupHandle(HH,id,4))
    call SaveGroupHandle(HH,id,4,null)
    endif
    call UnitSpeed(n0,1)
    call UnitSpeed(caster,1)
    call SetUnitFlyHeight(caster,0,0)
    call PauseUnit(caster,false)
    call SetUnitInvulnerable(caster,false)
    call SaveBoolean(HH,GetHandleId(caster),SH_JirTS,false)
    call RemoveUnit(LoadUnitHandle(HH,id,20))
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(HH,id)
else
    call PauseUnit(caster,true)
    call SetUnitInvulnerable(caster,true)
    call SetUnitFacing(caster,facing)
    if time==0.02 then
        call SaveGroupHandle(HH,id,4,CreateGroup())
        set soundplay=SndN(4081) // Sound\Music\mp3Music\JirayaTQ.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        call SetUnitAnimationByIndex(caster,9)
        call SetUnitAnimationByIndex(n0,5)
        call EffectCreateAndMove(true,"Madara\\HakenSaber2.mdl",GetRandomReal(0,360),1,0.5,0.4,100,100,100,40,0,caster,0,GetRandomReal(0,360))
        call EffectCreateAndMove(true,"Madara\\BlackBlink1.mdl",GetRandomReal(0,360),1,1.5,0.4,100,100,100,0,0,caster,0,GetRandomReal(0,360))
        call UnitAddAbility(caster,'Amrf')
        call UnitRemoveAbility(caster,'Amrf')
        call SetUnitFlyHeight(caster,450,0)
        set facing=Angle2(GetUnitX(n0),GetUnitY(n0),LoadReal(HH,id,11),LoadReal(HH,id,12))
        if SR(GetUnitX(n0),GetUnitY(n0),LoadReal(HH,id,11),LoadReal(HH,id,12))<400 then
            call SetUnitX(n0,PolX(LoadReal(HH,id,11),-400,facing))
            call SetUnitY(n0,PolY(LoadReal(HH,id,12),-400,facing))
        endif
        set facing=Angle2(GetUnitX(n0),GetUnitY(n0),LoadReal(HH,id,11),LoadReal(HH,id,12))
        call SaveReal(HH,id,3,facing)
        call SetUnitFacingInstant(n0,facing)
        call MoveUnit(n0,caster,100,facing)
        call SetUnitFacing(caster,facing)
        call UnitSpeed(n0,3.5)
        call UnitSpeed(caster,1.75)
    endif
    if time==0.3 then
        call UnitSpeed(n0,0)
        call UnitSpeed(caster,0)
        set soundplay=SndN(4084) // Sound\Music\mp3Music\JirayaTQ1.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        set n=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(n0),GetUnitY(n0),facing)
        call SaveUnitHandle(HH,id,20,n)
        call SetUnitFlyHeight(n,400,0)
        call MoveUnit(n,n,200,facing)
        call SaveReal(HH,id,16,400/SR(GetUnitX(n),GetUnitY(n),LoadReal(HH,id,11),LoadReal(HH,id,12))/30)
        call EffectCreateAndMove(true,"Madara\\[A]File00002800.mdl",facing,2.7,2,1.5,100,100,100,0,50,caster,120,facing)
        call EffectCreateAndMove(true,"Madara\\fire collection.mdl",facing,2.7,0.35,1,100,100,100,0,50,caster,120,facing)
    endif
    if time>=0.3 and time<10 then
        set Dummy=LoadUnitHandle(HH,id,20)

        set facing=Angle2(GetUnitX(Dummy),GetUnitY(Dummy),LoadReal(HH,id,11),LoadReal(HH,id,12))
        call SetUnitFacingInstant(Dummy,facing)


        if SR(GetUnitX(Dummy),GetUnitY(Dummy),LoadReal(HH,id,11),LoadReal(HH,id,12))>50 then
            call MoveUnit(Dummy,Dummy,35,facing)
            call SetUnitFlyHeight(Dummy,GetUnitFlyHeight(Dummy)-LoadReal(HH,id,16),0)

            // урон по площади раз в 3 тика (0.06 с), раньше каждые 0.02 с: каждую цель он бьёт один раз, радиус растёт медленно
            if ModuloInteger(R2I(time/0.02+0.5),3)==0 then
            call DamageAoeOneTime(caster,GetUnitX(Dummy),GetUnitY(Dummy),200+time*100,GetHeroStr(caster,true)*2+150,LoadGroupHandle(HH,id,4))
            endif

            set time1=LoadReal(HH,id,6)
            set time1=time1+0.02
            // эффект дерева 1 раз в 0.1 с вместо 2 (крупные, живут 3+ с — нагрузка на видеокарту)
            if time1==0.06 then
                //jiraya need pitch -90
                call EffectCreateAndMove2(true,"Madara\\BY_Wood_Effect_ShuiYing_Unusual_RongDun_2_31.mdl",facing,3.5-time,1+time*1.9,GetRandomReal(1,1.8),100,100,100,30,-150,Dummy,0,facing)
            endif
            if time1==0.1 then
                set time1=0
                //jiraya need pitch -90
                call EffectCreateAndMove2(true,"Madara\\[A]AceFireShockRun.mdl",facing,3.5-time,0.8+time*0.8,GetRandomReal(1,1.8),100,100,100,60,50,Dummy,0,facing)
            endif
            call SaveReal(HH,id,6,time1)
        else
            call SaveReal(HH,id,5,10)
            call DamageAoeOneTime(caster,GetUnitX(Dummy),GetUnitY(Dummy),500,GetHeroStr(caster,true)*2+150,LoadGroupHandle(HH,id,4))

            call SaveReal(HH,id,6,0.28)
        endif
        set Dummy=null
    endif
    if time>10 then
        set Dummy=LoadUnitHandle(HH,id,20)
        set time1=LoadReal(HH,id,6)
        set time1=time1+0.02
        if time1==0.1 or time1==0.2 or time1==0.3 then
            call DamageAoeOneTimeJirayaQ(caster,GetUnitX(Dummy),GetUnitY(Dummy),500,GetHeroStr(caster,true)*0.8)
            set n=null

        endif
        if time1==0.3 then
            set time1=0
            call EffectCreateAndMove(true,"Madara\\[A]BY_Wood_Flame_explosion_2.mdl",facing,1,2,1,100,100,100,30,0,Dummy,0,facing)
        endif
        call SaveReal(HH,id,6,time1)
        set Dummy=null
    endif
endif
set caster=null
set n0=null
set t=null
endfunction
function JirayaTAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local real facing
local real time
set n0=LoadUnitHandle(HH,id,20)
set facing=LoadReal(HH,id,3)
set time=LoadReal(HH,id,5)
if time<1.04 or LoadBoolean(HH,GetHandleId(caster),SH_JirTS)==false then//проверка на буль для остановки отсчета время жизни пока кастуется любая его совместная способность
set time=time+0.02
endif
call SaveReal(HH,id,5,time)
if (time>=10.52 and LoadBoolean(HH,GetHandleId(caster),SH_JirTS)==false) or udg_B==false or DU2==false then
call RemoveUnit(LoadUnitHandle(HH,id,20))
call RemoveSavedHandle(HH,GetHandleId(caster),SH_JirTG)
call RemoveSavedBoolean(HH,GetHandleId(caster),SH_JirTB)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
else
if time==0.02 then
if SR(GetUnitX(caster),GetUnitY(caster),LoadReal(HH,id,11),LoadReal(HH,id,12))<300 then
call MoveUnit(caster,caster,-300,facing)
endif
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
call SetUnitModel(n0,"Madara\\Gamabunta.mdl")
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call MoveUnit(caster,n0,300,facing)
call SaveReal(HH,id,16,SR(GetUnitX(n0),GetUnitY(n0),LoadReal(HH,id,11),LoadReal(HH,id,12)))
if GetUnitTypeId(caster)=='H01J' then
call SetUnitAnimationByIndex(caster,16)
else
call SetUnitAnimationByIndex(caster,25)
endif
call SetUnitAnimationByIndex(n0,3)
call SaveUnitHandle(HH,id,20,n0)
call UnitStop(caster)
set soundplay=SndN(4087) // Sound\Music\mp3Music\GamabuntaTQ.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set soundplay=SndN(4090) // Sound\Music\mp3Music\JirayaT.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set soundplay=SndN(4093) // Sound\Music\mp3Music\JirayaT1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call EffectCreateAndMove(true,"Madara\\narutopuff.mdl",facing,1,4.5,0.6,100,100,100,30,50,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\wind4.mdl",facing,1,1.75,1.5,100,100,100,0,50,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\WindCircleFaster.mdl",facing,1,1.5,1.25,100,100,100,0,50,caster,0,facing)
endif
if time>=0.02 and time<=1.02 then
if SR(GetUnitX(n0),GetUnitY(n0),LoadReal(HH,id,11),LoadReal(HH,id,12))>20 then
call MoveUnit(n0,n0,LoadReal(HH,id,16)*0.02,facing)
endif
if time<0.52 then
call SetUnitFlyHeight(n0,GetUnitFlyHeight(n0)+20,0)
else
call SetUnitFlyHeight(n0,GetUnitFlyHeight(n0)-20,0)
endif
endif
if time==1.02 then
if GetHeroLevel(caster)<35 then
call SaveReal(HH,id,5,6.02)
else
call SaveBoolean(HH,GetHandleId(caster),SH_JirTB,true)
call SaveUnitHandle(HH,GetHandleId(caster),SH_JirTG,n0)
endif
call EffectCreateAndMove(true,"Madara\\BY_Wood_GongChengSiPai_6.mdl",GetRandomReal(0,360),1.5,3,0.8,100,100,100,0,0,n0,0,facing)
call EffectCreateAndMove(true,"Madara\\ChuShou_Effect_Earth1.mdl",GetRandomReal(0,360),1.5,1,1.5,100,100,100,0,0,n0,0,facing)
call EffectCreateAndMove(true,"Madara\\[A]Sand3.mdl",GetRandomReal(0,360),1.5,3,1,100,100,100,0,-50,n0,0,facing)
call EffectCreateAndMove(true,"Madara\\az_slb.mdl",GetRandomReal(0,360),1.5,3.5,1.5,100,100,100,0,-50,n0,0,facing)
//jirayaneed Pitch -90
call EffectCreateAndMove(true,"Madara\\BY_Wood_GongChengSiPai_1-90.mdl",GetRandomReal(0,360),1.5,3.5,0.75,100,100,100,30,50,n0,0,facing)
call EffectCreateAndMove(true,"Madara\\WindCircleFaster.mdl",facing,1,1.75,1.55,100,100,100,0,50,n0,0,facing)
call EffectCreateAndMove(true,"Madara\\wind3.mdl",GetRandomReal(0,360),1.5,2,1.5,100,100,100,30,50,n0,0,facing)

call DamageAoeAndStun(caster,LoadReal(HH,id,11),LoadReal(HH,id,12),550,GetHeroStr(caster,true)*9,2)





endif
if time==10.02 then
call SaveBoolean(HH,GetHandleId(caster),SH_JirTB,false)
call RemoveSavedHandle(HH,GetHandleId(caster),SH_JirTG)
endif
if time>10.02 then
call UnitColor(n0,100,100,100,200*(time-6.02))
endif
endif
set caster=null
set n0=null
set t=null
endfunction



function JirayaChoice_Act takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(HH,id,1,GetTriggerUnit())
call SaveInteger(HH,id,5,0)
call SaveInteger(HH,id,6,0)
call SaveReal(HH,id,11,SpellTargetLocX())
call SaveReal(HH,id,12,SpellTargetLocY())
call SaveReal(HH,id,3,Angle2(GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit()),SpellTargetLocX(),SpellTargetLocY()))
call TimerStart(t,0.02,true,function JirayaTAct)

set t=null
endfunction


function JirayaChoice_Cond takes nothing returns boolean
        //if GetSpellAbilityId()=='AJIT' then
        //      return true
        //else
                return GetSpellAbilityId()=='AJIT' //false
        //endif
endfunction
function InitTrig_JirayaChoice takes nothing returns nothing
        local trigger trig=CreateTrigger()
        local integer index
        set index=0
        loop
        call TriggerRegisterPlayerUnitEvent(trig,Player(index),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
        set index=index+1
        exitwhen index==bj_MAX_PLAYER_SLOTS
        endloop
        call TriggerAddCondition(trig,Condition(function JirayaChoice_Cond))
        call TriggerAddAction(trig,function JirayaChoice_Act)
        set trig=null
        set index=0
endfunction


//AJIT

//========== Jiraya END
// Jiraya choice base abil
function MagenGamarinshoCond takes nothing returns boolean
return GetSpellAbilityId()=='A0CO' and udg_B==true
endfunction
function MagenGamarinshoCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1
local real y1
local real a
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,6)
local real time=LoadReal(h,id,5)-1
local real dmg=4*GetHeroStr(u,true)+150
local group g2=CreateGroup()
if time>0 then
call SetUnitXY_1(l__d,x,y, false)
call SetUnitFlyHeight(l__d,GetUnitFlyHeight(u),0)
call GroupEnumUnitsInRange(g2,x,y,750,Base)
call UnitApplyTimedLife(CreateUnit(p,'e07G',x,y,GetRandomReal(0,359)),'BTLF',1)
call SaveReal(h,id,5,time)
loop
set E=FirstOfGroup(g2)
exitwhen E==null
if Condition_Base(p,E) and GetUnitAbilityLevel(E,'A128')==0 and IsUnitInvulnerable(E)==false then
call SlowUnit(u,E,0.8,0.8,6,2,false)
call UnitAddAbility(E,'A128')
if IsUnitInGroup(E,g)==false then
call GroupAddUnit(g,E)
endif
endif
call GroupRemoveUnit(g2,E)
endloop
call GroupClear(g2)
call DestroyGroup(g2)
else
set n=CreateUnit(p,'e07F',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BHwe',4)
call SetUnitVertexColor(n,255,255,255,140)
call UnitApplyTimedLife(CreateUnit(p,'e070',x,y,0),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e07H',x,y,0),'BTLF',4)
set x1=x+350*Cos(0)
set y1=y+350*Sin(0)
set a=Atan2(y-y1,x-x1)*bj_RADTODEG
call UnitApplyTimedLife(CreateUnit(p,'e07J',x1,y1,a),'BTLF',5)
set x1=x+350*Cos(90*bj_DEGTORAD)
set y1=y+350*Sin(90*bj_DEGTORAD)
set a=Atan2(y-y1,x-x1)*bj_RADTODEG
call UnitApplyTimedLife(CreateUnit(p,'e07J',x1,y1,a),'BTLF',5)
set x1=x+350*Cos(180*bj_DEGTORAD)
set y1=y+350*Sin(180*bj_DEGTORAD)
set a=Atan2(y-y1,x-x1)*bj_RADTODEG
call UnitApplyTimedLife(CreateUnit(p,'e07J',x1,y1,a),'BTLF',5)
set x1=x+350*Cos(270*bj_DEGTORAD)
set y1=y+350*Sin(270*bj_DEGTORAD)
set a=Atan2(y-y1,x-x1)*bj_RADTODEG
call UnitApplyTimedLife(CreateUnit(p,'e07J',x1,y1,a),'BTLF',5)
// конец: живым с меткой (и не под циклоном) — телепорт к Джирайе, урон, оглушение; после конца раунда — без этого.
// Метка A128 снимается со всех из списка (раньше оставалась у погибших и под циклоном — G на них больше не действовала)
loop
set E=FirstOfGroup(g)
exitwhen E==null
if udg_B and UnitIsAlive(E)and GetUnitAbilityLevel(E,'A128')>0 then
call SetUnitX(E,x)
call SetUnitY(E,y)
if IsUnitInvulnerable(E)==true and GetUnitAbilityLevel(E,'cbc9')==0 then
    call SetUnitInvulnerable(E,false)
    call myCustomDamage(u,E,dmg,false,false,null,null,null)
    call UnitRemoveAbility(E,'A128')
    call SetControlToUnit(E,E, 3, "stun")
    call SetUnitInvulnerable(E,true)
elseif GetUnitAbilityLevel(E,'cbc9')==0 then
    call myCustomDamage(u,E,dmg,false,false,null,null,null)
    call UnitRemoveAbility(E,'A128')
    call SetControlToUnit(E,E, 3, "stun")
endif
endif
call UnitRemoveAbility(E,'A128')
call GroupRemoveUnit(g,E)
endloop
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set g2=null
set u=null
set p=null
set l__d=null
set t=null
endfunction
