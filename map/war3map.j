function EchoRitmCond takes nothing returns boolean
return GetSpellAbilityId()=='A0UR' and udg_B
endfunction
function Slash_EchoRitm2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local player p=GetOwningPlayer(l__d)
local unit u=Hero[GetPlayerId(p)]
local real speed=LoadReal(h,id,1)
local real x=LoadReal(h,id,3)
local real y=LoadReal(h,id,4)
local group g=LoadGroupHandle(h,id,5)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,2)
local real dmg=LoadReal(h,id,6)
local real Range=LoadReal(h,id,9)
// копия — через тик (0.06 с)
local integer tk=LoadInteger(h,id,11)+1
call SaveInteger(h,id,11,tk)
if SR(x,y,x1,y1)<=Range then
call SetUnitXY_1(l__d,x1+speed*Cos(a),y1+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitAnimation(l__d,"walk")
if ModuloInteger(tk,2)==0 then
set n=CreateUnit(p,'e0RU',x1,y1,f)
call UnitApplyTimedLife(n,'BTLF',0.1)
call SetUnitTimeScale(n,2)
call SetUnitVertexColor(n,255,255,255,50)
call SetUnitAnimation(n,"walk")
endif
else
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,GetHandleId(g))
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function Slash_EchoRitm takes unit l__d,real speed,real dmg,real angle,real range,real mas,real x,real y,real x1,real y1 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle)
call SaveGroupHandle(h,id,5,CreateGroup())
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,6,dmg)
call SaveReal(h,id,9,range)
call SaveReal(h,id,10,mas)
call TimerStart(t,0.03,true,function Slash_EchoRitm2)
set t=null
endfunction
function EchoRitmCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,100)
local group g=LoadGroupHandle(h,id,60)
local group gn=LoadGroupHandle(h,id,61)
local integer i=0
local real x=LoadReal(h,id,50)
local real y=LoadReal(h,id,51)
local real x1=0
local real y1=0
local real x2
local real y2
local real x3=GetUnitX(c)
local real y3=GetUnitY(c)
local real dist=LoadReal(h,id,101)
local real f=0
local real dmg=GetHeroAgi(u,true)*(GetUnitAbilityLevel(u,'A0UR')+2)
local integer l__idg=GetHandleId(g)
local player p=GetOwningPlayer(u)
local real speed=LoadReal(h,id,102)
// копии клонов — через тик (0.08 с), раньше каждые 0.04 с: 150 юнитов в секунду
local integer tk=LoadInteger(h,id,103)+1
call SaveInteger(h,id,103,tk)
loop
set i=i+1
exitwhen i>6
set n=LoadUnitHandle(h,id,1+i)
set f=Atan2(y-GetUnitY(n),x-GetUnitX(n))*bj_RADTODEG-90
set x1=GetUnitX(n)+speed*Cos(f*bj_DEGTORAD)
set y1=GetUnitY(n)+speed*Sin(f*bj_DEGTORAD)
call SetUnitFacing(n,f)
call SetUnitX(n,x1)
call SetUnitY(n,y1)
if ModuloInteger(tk,2)==0 then
set n=CreateUnit(p,'e0RU',x1,y1,f)
call UnitApplyTimedLife(n,'BTLF',0.15)
call SetUnitTimeScale(n,2)
call SetUnitVertexColor(n,255,255,255,50)
call SetUnitAnimation(n,"walk")
endif
endloop
set n=CreateUnit(p,'e0RW',x,y,f*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.3)
call SetUnitTimeScale(n,2)
if GetUnitCurrentOrder(c)!=0 then
call IssueImmediateOrder(c,"stop")
endif
call SaveReal(h,id,101,dist+0.04)
call SaveReal(h,id,102,speed+0.8)
if dist>=2 then
call PauseTimer(t)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
set i=0
loop
set E=FirstOfGroup(gn)
exitwhen E==null
call Slash_EchoRitm(E,80,0,Atan2(y-GetUnitY(E),x-GetUnitX(E)),500,40,0,0,0,0)
call GroupRemoveUnit(gn,E)
endloop
call ShowUnit(u,true)
if GetLocalPlayer()==p then
call ClearSelection()
call SelectUnit(u,true)
endif
call SetUnitX(u,x3)
call SetUnitY(u,y3)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x3,y3,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e04D',x3,y3,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0HM',x3,y3,GetRandomReal(0,359)),'BTLF',1.4)
call myCustomDamage(u,c,dmg,false,false,null,null,null)
call DestroyGroup(g)
call DestroyGroup(gn)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
set gn=null
set u=null
set g=null
set t=null
set c=null
set p=null
endfunction
function EchoRitmCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,100)
local group g=LoadGroupHandle(h,id,60)
local group gn=LoadGroupHandle(h,id,61)
local integer i=0
local real x=LoadReal(h,id,50)
local real y=LoadReal(h,id,51)
local real x1=0
local real y1=0
local real x2
local real y2
local real x3=GetUnitX(c)
local real y3=GetUnitY(c)
local real dist
local real f=0
local real dmg=GetHeroAgi(u,true)*(GetUnitAbilityLevel(u,'A0UR')+2)
local integer l__idg=GetHandleId(g)
local player p=GetOwningPlayer(u)
// копии клонов — через тик (0.08 с)
local integer tk=LoadInteger(h,id,103)+1
call SaveInteger(h,id,103,tk)
loop
set i=i+1
exitwhen i>6
set n=LoadUnitHandle(h,id,1+i)
set f=(GetUnitFacing(n)+7.5)*bj_DEGTORAD
set dist=LoadReal(h,id,StringHash("dist"+I2S(i)))+23
call SaveReal(h,id,StringHash("Dist"+I2S(i)),dist)
set x1=x+dist*Cos(f)
set y1=y+dist*Sin(f)
call SetUnitFacing(n,f*bj_RADTODEG)
call SetUnitX(n,x1)
call SetUnitY(n,y1)
if ModuloInteger(tk,2)==0 then
set n=CreateUnit(p,'e0RU',x1,y1,f*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.12)
call SetUnitTimeScale(n,2)
call SetUnitVertexColor(n,255,255,255,50)
call SetUnitAnimation(n,"walk")
endif
endloop
if dist>=400 then
call PauseTimer(t)
call TimerStart(t,.04,true,function EchoRitmCast3)
set i=0
loop
set i=i+1
exitwhen i>6
set n=LoadUnitHandle(h,id,1+i)
set f=Atan2(y3-GetUnitY(n),x3-GetUnitX(n))*bj_RADTODEG+90
call SetUnitFacing(n,f)
endloop
endif
set gn=null
set u=null
set g=null
set t=null
set c=null
set p=null
endfunction
function EchoRitmCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit c=GetSpellTargetUnit()
local real x=GetUnitX(c)
local real y=GetUnitY(c)
local real r=0.
local integer i=1
local group g=CreateGroup()
local player p=GetOwningPlayer(u)
loop
exitwhen i>6
set r=i*60.
set n=CreateUnit(p,'e0RU',x,y,r)
call UnitAddAbility(n,'A0US')
call GroupAddUnit(g,n)
call SaveUnitHandle(h,id,1+i,n)
set i=i+1
endloop
set n=CreateUnit(p,'e0RV',x,y,0)
call UnitApplyTimedLife(n,'BTLF',6)
call SetUnitTimeScale(n,0.3)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,100,c)
call SaveGroupHandle(h,id,60,CreateGroup())
call SaveGroupHandle(h,id,61,g)
call SaveReal(h,id,50,x)
call SaveReal(h,id,101,0)
call SaveReal(h,id,102,0)
call SaveReal(h,id,51,y)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call ShowUnit(u,false)
set soundplay=SndN(2090) // Sound\Music\mp3Music\RiphmEcho.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,.03,true,function EchoRitmCast2)
set u=null
set t=null
set c=null
set p=null
endfunction
