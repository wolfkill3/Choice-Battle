call UnitAddAbility(u,'A0FP')
call SetUnitAbilityLevel(u,'A0FP',lvl)
call SaveInteger(h,id,s1,'A0FM')
call SaveInteger(h,id,l__s,'A0FP')
elseif i==3 then
set soundplay=SndN(1185) // Sound\Music\mp3Music\ShuYahiro.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call UnitRemoveAbility(u,r)
call UnitRemoveAbility(u,r1)
call UnitAddAbility(u,'A0FJ')
call UnitAddAbility(u,'A0FR')
call SetUnitAbilityLevel(u,'A0FR',lvl)
call SaveInteger(h,id,s1,'A0FJ')
call SaveInteger(h,id,l__s,'A0FR')
