call ShowAbility2Timed('A0N0',false,0.3)
call ShowAbility2Timed('A40C',true,0.32)
call UnitAddAbility(u,'ItV1')
call SaveBoolean(HH,GetHandleId(u),SST,true)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\SusanoMadara.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
else
call SaveBoolean(HH,GetHandleId(u),SST,false)
call ShowAbility2('A40C',false)
call ShowAbility2('A0N0',true)
call UnitRemoveAbility(u,'ItV1')
endif
if LoadBoolean(HH,GetHandleId(u),SS)==false then
    call SaveBoolean(HH,GetHandleId(u),SS,true)
    set n=CreateUnit(GetOwningPlayer(u),0x65304B51,GetUnitX(u),GetUnitY(u),GetUnitFacing(u))
    call SetUnitTimeScale(n,2)
    call SetUnitVertexColor(n,200,200,255,150)
    call SetUnitAnimation(n,"Birth")
    call SaveUnitHandle(h,id,1,n)
    call SaveUnitHandle(h,GetHandleId(u),StringHash("immolation"),n)
    call TimerStart(t,0.03,true,function SusanoMadaraCast2)
endif
set u=null
set t=null
endfunction
