function WDantesCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real dmg=GetHeroAgi(u,true)*(1+(1*GetUnitAbilityLevel(u,'Ad8M')))
local real x=LoadReal(h,id,6)
local real y=LoadReal(h,id,7)
local real x1=LoadReal(h,id,4)
local real y1=LoadReal(h,id,5)
local real x2=0
local real y2=0
local real r=0
local real he=0
local real a=GetRandomReal(0,6.28)
local real dist=LoadReal(h,id,2)
local group g=LoadGroupHandle(h,id,10)
local player p=GetOwningPlayer(u)
local integer array tu
local real sc=0
if dist<0.75 then
if LoadBoolean(h,id,8) == true then
        set dmg = dmg * 1.15
endif
set tu[1]='ed9U'
set tu[2]='ed9V'
set tu[3]='ed9W'
set tu[4]='ed9X'
call SaveReal(h,id,2,dist+0.1)
set r=GetRandomReal(-500,500)
set x2=x1-r*Cos(a)
set y2=y1-r*Sin(a)
set n=CreateUnit(p,tu[GetRandomInt(1,4)],x2,y2,GetRandomReal(0,359))
call SetUnitTimeScale(n,3)
set sc=GetRandomReal(0.7,1.5)
call SetUnitScale(n,sc,sc,sc)
call UnitApplyTimedLife(n,'BTLF',0.5)
set r=GetRandomReal(-500,500)
set x2=x1+r*Cos(a)
set y2=y1+r*Sin(a)
set n=CreateUnit(p,tu[GetRandomInt(1,4)],x2,y2,GetRandomReal(0,359))
call SetUnitTimeScale(n,3)
set sc=GetRandomReal(0.7,1.5)
call SetUnitScale(n,sc,sc,sc)
call UnitApplyTimedLife(n,'BTLF',0.5)
set r=GetRandomReal(-500,500)
set x2=x1+r*Cos(a)
set y2=y1+r*Sin(a)
set n=CreateUnit(p,tu[GetRandomInt(1,4)],x2,y2,GetRandomReal(0,359))
call SetUnitTimeScale(n,3)
set sc=GetRandomReal(0.7,1.5)
call SetUnitScale(n,sc,sc,sc)
call UnitApplyTimedLife(n,'BTLF',0.5)
call GroupEnumUnitsInRange(G,x1,y1,500,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)and IsUnitInGroup(E,g)==false then
call SetUnitAnimation(E,"death")
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SlowUnit(u,E,0.5,0,5,0,false)
call GroupAddUnit(g,E)
endif
call GroupRemoveUnit(G,E)
endloop
else
call PauseTimer(t)
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set g=null
set p=null
set t=null
endfunction
function WDantesCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local real sc=0
local real is=0
local real ig=30*bj_DEGTORAD
local integer idu=GetHandleId(u)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,0)
call SaveReal(h,id,3,a)
call SaveReal(h,id,4,x1)
call SaveReal(h,id,5,y1)
call SaveReal(h,id,6,x)
call SaveReal(h,id,7,y)
if GetUnitAbilityLevel(u, 'CB01') > 0 then
        call UnitRemoveAbility(u, 'CE01')
        call UnitRemoveAbility(u, 'CB01')
    call SaveBoolean(h,id,8,true)
else
    call SaveBoolean(h,id,8,false)
endif
call SaveGroupHandle(h,id,10,CreateGroup())
set soundplay=SndN(2958) // Sound\war3mapImported\EdmondW.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set n=CreateUnit(p,'ed7T',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.75)
call SetUnitVertexColor(n,255,255,255,155)
call SetUnitTimeScale(n,1)
set n=CreateUnit(p,0x6B615734,x1,y1,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1.25)
call SetUnitTimeScale(n,0.5)
set n=CreateUnit(p,'ed9Y',x1,y1,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1.25)
call SetUnitAnimation(n,"death")
call SetUnitTimeScale(n,0.75)
call SetUnitVertexColor(n,0,0,255,255)
set n=CreateUnit(p,'ed0N',x,y,a*bj_RADTODEG-45)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'ed0N',x,y,a*bj_RADTODEG+45)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'ed0N',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
call SetUnitAnimationByIndex(u,9)
call TimerStart(t,0.1,true,function WDantesCast2)
set u=null
set p=null
set t=null
