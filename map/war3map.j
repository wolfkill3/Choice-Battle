function MesCond takes nothing returns boolean
return GetSpellAbilityId()==0x41304B42 and GetUnitTypeId(GetTriggerUnit())!='H03S' and GetUnitTypeId(GetTriggerUnit())!='H03W' and GetUnitTypeId(GetTriggerUnit())!='H03X' and GetUnitTypeId(GetTriggerUnit())!='H03V' and GetUnitTypeId(GetTriggerUnit())!='H03U' and udg_B==true
endfunction
function MesCast2 takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(h,id,0)
        local unit c=LoadUnitHandle(h,id,1)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        local real x1=GetUnitX(c)
        local real y1=GetUnitY(c)
        local real a=Atan2(y1-y,x1-x)
        local player p=GetOwningPlayer(u)
        local real time=LoadReal(h,id,2)
        if SR(x,y,x1,y1)>50 and time<3 and GetWidgetLife(c)>0 then
            call SaveReal(h,id,2,time+0.02)
            set x=x+60*Cos(a)
            set y=y+60*Sin(a)
            call SetUnitXY_1(u,x,y,false)
            call SetUnitFacing(u,a*bj_RADTODEG)
            set n=CreateUnit(p,0x65304637,x,y,a*bj_RADTODEG)
            call UnitApplyTimedLife(n,'B000',0.25)
            call SetUnitVertexColor(n,170,170,170,170)
            call SetUnitTimeScale(n,2)
            call SetUnitAnimation(n,"attack")
            call SetUnitAnimation(u,"attack")
        else
            if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
                if time>=2.96 then
                    call SetUnitXY_1(u,x1,y1,false)
                endif
                set n=CreateUnit(GetOwningPlayer(c),0x68303251,x1,y1,0)
                if RectContainsUnit(gg_rct_UBW2,c)==true then
                    call UnitAddAbility(n,'A0IH')
                endif
                call Push(n,50,LoadReal(h,id,9),400)
                call SaveUnitHandle(h,GetHandleId(u),StringHash("h"),n)
                call UnitApplyTimedLife(n,'B000',10)
                call SaveUnitHandle(h,GetHandleId(c),StringHash("heart"),n)
                if GetWidgetLife(c)>GetWidgetMaxLife(c)*0.2 then
                        call SetWidgetLife(c, GetWidgetLife(c)-GetWidgetMaxLife(c)*0.2)
                else
                        call SetWidgetLife(c, 1)
                endif
                call DamageIndicatorFunction(u, c, GetWidgetMaxLife(c)*0.2)
                call DamageTextTag(u, c, GetWidgetMaxLife(c)*0.2)
                call SetUnitState(n,UNIT_STATE_LIFE,GetWidgetMaxLife(c)*0.4)
                call SetUnitMaxLife(n,GetWidgetMaxLife(c)*0.4)
                call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",x1,y1))
                call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",x1,y1))
                call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",x1,y1))
                call PauseTimer(t)
                call DestroyTimer(t)
                call UnitRemoveAbility(u,'A0BX')
                call SetUnitTimeScale(u,1)
                call SetUnitPathing(u,true)
                call PauseUnit(u,false)
                call FlushChildHashtable(h,id)
                call SetUnitInvulnerable(u,false)
            else
                call SetUnitTimeScale(u,1)
                call SetUnitInvulnerable(u,false)
                call PauseUnit(u,false)
                call UnitRemoveAbility(u,'A0BX')
                call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
                call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
                call SetUnitFlyHeight(u,0,0)
                call SetUnitFlyHeight(c,0,0)
                call PauseTimer(t)
                call DestroyTimer(t)
                call FlushChildHashtable(h,id)
            endif
        endif
        set p=null
        set u=null
        set c=null
        set t=null
endfunction
function MesCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local integer id_caster=GetHandleId(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real Room_X = LoadReal(h, id_caster, StringHash("Room_X"))
local real Room_Y = LoadReal(h, id_caster, StringHash("Room_Y"))
local boolean bRoom = LoadBoolean(h, id_caster, StringHash("RoomBoolean"))
local boolean bMassiveRoom = LoadBoolean(h, id_caster, StringHash("MassiveRoomBoolean"))
local boolean bPullOut = false
if bMassiveRoom then
        set bPullOut = true
else
        if SquareRootPoint(GetUnitX(c), GetUnitY(c), Room_X, Room_Y)<=1000 and bRoom then
                set bPullOut = true
        endif
endif
if c==Hero[GetPlayerId(GetOwningPlayer(c))] and bPullOut then
        call SaveUnitHandle(h,id,0,u)
        call SetUnitPathing(u,false)
        call SetUnitAnimation(u,"spell two")
        call UnitAddAbility(u,'A0BX')
        call PauseUnit(u,true)
        call SaveReal(h,id,9,Atan2(GetUnitY(c)-y,GetUnitX(c)-x))
        call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e06H',x,y,GetRandomReal(0,359)),1,1)
        call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e06I',x,y,GetRandomReal(0,359)),1,1)
        call SetUnitTimeScale(u,5)
        call SetUnitInvulnerable(u,true)
        call SaveUnitHandle(h,id,1,c)
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\LawMes.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        call TimerStart(t,0.020,true,function MesCast2)
else
        call IssueImmediateOrder(u, "stop")
        call StartAbilityCooldown(GetUnitAbility(u, 0x41304B42), 0.5)
        call SetWidgetMana(u, GetWidgetMana(u)+350)
endif
set c=null
set u=null
set t=null
endfunction
