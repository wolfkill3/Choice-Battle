    call SetFrameTextColour( InfoIdText, 0xFFFFA500 )
    call SetFrameParent( InfoIdText, IdHeroFrame )
    //call SetFrameText( InfoIdText, "• Hover your mouse over icons, to get hero ids\n• To Spawn hero, write \"-hero x y\", where x - Player slot (from 0 to 9) and y - hero ID.\n• Press L to spawn Target at your cursor location\n• -cd will restore Hero cooldowns, -heal will completly heal every Hero.")
    call SetFrameText( InfoIdText, "• To spawn a hero, select him and the colour, then click \"Summon Hero\".\n• Press L to spawn Target at your cursor location\n• -cd will restore Hero cooldowns, -heal will completly heal every Hero\n• -unheal sets HP and MP to 1. -Setmr to set magic resistance\n• -control x allows for everyone to take control of units of that player")
    call ShowFrame( InfoIdText, true )
    call SetFrameRelativePoint( InfoIdText, FRAMEPOINT_TOPLEFT, IdHeroFrame, FRAMEPOINT_TOPLEFT, .02, -.02 )
    
    set IdPlayerGrid=CreateFrameByType("SIMPLEGRID", "TestBarPlayerList", IdHeroFrame, "", 0)
