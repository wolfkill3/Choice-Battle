set y1=y1+62*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
call UnitApplyTimedLife(CreateUnit(p,0x65304430,x1,y1,a*bj_RADTODEG),1,1)
else
call UnitApplyTimedLife(CreateUnit(p,'e0CW',x1,y1,0),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0CV',x1,y1,0),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0CX',x1,y1,0),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0CY',x1,y1,0),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0CZ',x1,y1,0),1,3)
set n=CreateUnit(p,'e0D1',x1,y1,0)
call UnitApplyTimedLife(n,1,2)
call UnitScale(n,1,8,0.25)
call GroupEnumUnitsInRange(G,x1,y1,400,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call Push(E,50,Atan2(GetUnitY(E)-y2,GetUnitX(E)-x2),500)
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 2, "stun")
endif
call GroupRemoveUnit(G,E)
endloop
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call RemoveUnit(l__d)
endif
set l__d=null
set p=null
set u=null
set t=null
endfunction
function RollExplCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,GetSpellTargetX())
call SaveReal(h,id,3,GetSpellTargetY())
set n=CreateUnit(GetOwningPlayer(u),0x65304355,GetUnitX(u),GetUnitY(u),GetUnitFacing(u))
call SetUnitAnimation(n,"attack")
call SetUnitTimeScale(n,0.5)
call SaveUnitHandle(h,id,1,n)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\HibariQ.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.03,true,function RollExplCast2)
set u=null
set t=null
endfunction
