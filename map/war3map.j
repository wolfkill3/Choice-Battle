call SaveBoolean(HH,GetHandleId(caster),SH_BGF,true)
call TimerStart(t,0.02,true,function BlackGokuF1Act)
endif

if GetSpellAbilityId()=='BGFR' then
call SaveUnitHandle(HH,id,1,LoadUnitHandle(HH,GetHandleId(caster),SH_BGokuRU))
call SaveBoolean(HH,GetHandleId(LoadUnitHandle(HH,GetHandleId(caster),SH_BGokuRU)),SH_BGF,false)
call TimerStart(t,0.02,true,function BlackGokuZamasuRAct)
endif

if GetSpellAbilityId()=='BGG1' then




if LoadBoolean(HH,GetHandleId(caster),SH_BGG)==true then
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then


set soundplay=SndN(3871) // Sound\Music\mp3Music\SoundEng\BlackGokuGnext_eng.mp3
call StartSound(soundplay)
// call KillSoundWhenDone(soundplay)



else

set soundplay=SndN(3873) // Sound\Music\mp3Music\SoundJap\BlackGokuGnext.mp3
call StartSound(soundplay)
// call KillSoundWhenDone(soundplay)



endif
call UnitRemoveAbility(caster,'ABG0')
call UnitAddAbility(caster,'ABG1')
call SetUnitAnimationByIndex(caster,87)
call SetUnitAbilityLevel(caster,'BGC1',2)
call TimerStart(t,0.02,true,function BlackGokuGFastAct)
else
call SaveBoolean(HH,GetHandleId(caster),SH_BGG,true)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then


set soundplay=SndN(3875) // Sound\Music\mp3Music\SoundEng\BlackGokuGfirst_eng.mp3
call StartSound(soundplay)
// call KillSoundWhenDone(soundplay)

else



set soundplay=SndN(3877) // Sound\Music\mp3Music\SoundJap\BlackGokuGfirst.mp3
call StartSound(soundplay)
// call KillSoundWhenDone(soundplay)

endif
call TimerStart(t,0.02,true,function BlackGokuGAct)
endif
endif
if GetSpellAbilityId()=='BGG2' then


call SaveBoolean(HH,GetHandleId(caster),SH_BGRose,false)
call TimerStart(t,0.02,true,function BlackGokuGOff)
endif




set t=null
set caster=null
endfunction
function BlackGokuChoice_Cond takes nothing returns boolean
if GetSpellAbilityId()=='BGG2' or GetSpellAbilityId()=='BGW4' or GetSpellAbilityId()=='BGF0' or GetSpellAbilityId()=='BGFR' or GetSpellAbilityId()=='BGG1' or GetSpellAbilityId()=='BGQ1' or GetSpellAbilityId()=='BGW1' or GetSpellAbilityId()=='BGE1' or GetSpellAbilityId()=='BGQ2' or GetSpellAbilityId()=='BGW2' or GetSpellAbilityId()=='BGE2' or GetSpellAbilityId()=='BGW3' or GetSpellAbilityId()=='BGR1' or GetSpellAbilityId()=='BGR2' or GetSpellAbilityId()=='BGT1' then
return true
else
return false
endif
endfunction
function InitTrig_BlackGokuCHoice takes nothing returns nothing
local trigger BlackGokuChoice=CreateTrigger()
local integer index
set index=0
loop
call TriggerRegisterPlayerUnitEvent(BlackGokuChoice,Player(index),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set index=index+1
exitwhen index==bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddCondition(BlackGokuChoice,Condition(function BlackGokuChoice_Cond))
call TriggerAddAction(BlackGokuChoice,function BlackGokuChoice_Act)
set BlackGokuChoice=null
set index=0
endfunction
function BlackGokuZamasu takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=GetUnitFacing(caster)*bj_DEGTORAD
local unit Dummy=LoadUnitHandle(HH,id,2)//LoadUnitHandle(HH,GetHandleId(caster),StringHash("Zamasu"))
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real x1=GetUnitX(Dummy)
local real y1=GetUnitY(Dummy)
local real x2=x+GetRandomInt(250,400)*Cos(facing+LoadReal(HH,id,19)*bj_DEGTORAD)
local real y2=y+GetRandomInt(250,400)*Sin(facing+LoadReal(HH,id,19)*bj_DEGTORAD)
if LoadBoolean(HH,GetHandleId(caster),SH_ZamasuSpell)==false then
if SR(x,y,x1,y1)<1000 then
if SR(x2,y2,x1,y1)>500 and GetUnitCurrentOrder(Dummy)==0 and not(x2-50<x1 and x1<x2+50)and not(y2-50<y1 and y1<y2+50)then
call IssuePointOrder(Dummy,"move",x2,y2)
if GetRandomInt(1,2)==1 then
call SaveReal(HH,id,19,-90)
else
call SaveReal(HH,id,19,90)
endif
endif
elseif GetUnitCurrentOrder(Dummy)!=OrderId("move")and SR(x,y,x1,y1)>1000 then

set soundplay=SndN(3719) // Sound\Music\mp3Music\SoundJap\BlackGokuW1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять


call EffectCreateAndMove(true,"BlackGoku\\BlackBlink1.mdl",facing,1,1,1,100,100,100,0,0,Dummy,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",facing,1,1,1,100,100,100,40,0,Dummy,0,facing)
call SetUnitX(Dummy,x2)
call SetUnitY(Dummy,y2)
call EffectCreateAndMove(true,"BlackGoku\\HakenSaber2.mdl",facing,1,0.5,0.5,100,100,100,0,0,Dummy,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\[A]az_axe_ef1.mdl",facing,1,0.5,0.5,100,100,100,0,0,Dummy,0,facing)
call IssueImmediateOrder(Dummy,"stop")
endif
endif
if GetWidgetLife(caster)>0 then
else
call SetUnitFlyHeight(Dummy,5000,0)
endif
if CheckUnitInvisible(caster)then
if GetUnitAbilityLevel(Dummy,'Ao7U')==0 then
call UnitAddAbility(Dummy,'Ao7U')
endif
else
call UnitRemoveAbility(Dummy,'Ao7U')
endif
if GetUnitTypeId(caster)!='HBGN' then
call RemoveUnit(Dummy)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
set caster=null
set Dummy=null
endfunction
function BlackGokuLearnR_Cond takes nothing returns boolean
