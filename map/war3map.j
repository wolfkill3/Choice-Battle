function EnkiduWCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real sc=0
local real is=0
local real ig=30*bj_DEGTORAD
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
set n=CreateUnit(p,'e17I',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitAnimation(n,"death")
call SetUnitTimeScale(n,0.4)
set n=CreateUnit(p,'e17K',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitAnimation(n,"death")
call SetUnitTimeScale(n,0.6)
set n=CreateUnit(p,'e17K',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitAnimation(n,"death")
call SetUnitTimeScale(n,0.6)
set n=CreateUnit(p,'e0RV',x,y,0)
call SetUnitTimeScale(n,0.5)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitScale(n,0.65,0.65,0.65)
call SetUnitVertexColor(n,255,255,255,100)
loop
exitwhen is>=13
set n=CreateUnit(p,'e0ZH',x+250*Cos(ig*is),y+250*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,255,255,255,55)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,0.5)
set is=is+1
endloop
call SaveReal(h,id,10,0.2)
call SaveReal(h,id,11,1)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SetUnitAnimation(u,"Spell Slam One")
call TimerStart(t,0.6,false,function EnkiduWCast2)
set c=null
set u=null
set t=null
set p=null
endfunction
function InitTrig_EnkiduW takes nothing returns nothing
set gg_trg_EnkiduW=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_EnkiduW,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_EnkiduW,Condition(function EnkiduWCond))
call TriggerAddAction(gg_trg_EnkiduW,function EnkiduWCast)
endfunction
function EnkiduECond takes nothing returns boolean
return GetSpellAbilityId()=='A1HY'
endfunction
function AddSpecialEffectToAllBones takes unit c,string l__s returns nothing
call DestroyEffect(AddSpecialEffectTarget(l__s,c,"chest"))
call DestroyEffect(AddSpecialEffectTarget(l__s,c,"head"))
call DestroyEffect(AddSpecialEffectTarget(l__s,c,"right hand"))
call DestroyEffect(AddSpecialEffectTarget(l__s,c,"left hand"))
call DestroyEffect(AddSpecialEffectTarget(l__s,c,"right foot"))
call DestroyEffect(AddSpecialEffectTarget(l__s,c,"left foot"))
call DestroyEffect(AddSpecialEffectTarget(l__s,c,"origin"))
endfunction
function EnkiduECast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local integer idc=GetHandleId(c)
local group g=CreateGroup()
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local boolean bPaused=false
if IsUnitAlly(c,p) then
call UnitRemoveBuffs(c,false,true)
else
set bPaused=false
if IsUnitPaused(c) then
    set bPaused=true
    call PauseUnit(c,false)
endif
call IssueImmediateOrder(c,"manashieldoff")
call IssueImmediateOrder(c,"unimmolation")
call UnitRemoveAbility(c,'A1GL')
call UnitRemoveAbility(c,'WAE1')
call UnitRemoveAbility(c,'A1WT')
call UnitRemoveBuffs(c,true,false)
if UnitHasItemOfTypeBJCustom(c, 'I03A') and GetWidgetLife(c)>0 and IsUnitIllusion(c)==false then
    set AlastorPos=0
    loop
    exitwhen AlastorPos==10 or GetItemTypeId(UnitItemInSlot(c,AlastorPos)) == 'I03A'
    set AlastorPos=AlastorPos+1
    endloop
    if IsAbilityEnabled(GetUnitAbility(c,'AInv'))==true then
        set Alastor=GetItemOfTypeFromUnitBJCustom(c,'I03A')
        call UnitRemoveItem(c,Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(c, 'I03A',AlastorPos)
    else
        call EnableUnitAbility2(c,'AInv',false,true)
        set Alastor=GetItemOfTypeFromUnitBJCustom(c,'I03A')
        call UnitRemoveItem(c,Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(c, 'I03A',AlastorPos)    
        call DisableUnitAbility2(c,'AInv',false,true)
    endif
endif
call UnitAddItemById(c,'I06B')
if LoadReal(h, idc, SH_ShieldBelfF)>0 then   // Щит Бельфегора
    call SaveReal(h, idc, SH_ShieldBelfF, 0)
else
    call SaveReal(h, idc, SH_ShieldBelfF, 0)
    call RemoveSavedReal(h, idc, SH_ShieldBelfF)
endif
if LoadReal(h, idc, SH_YujiE_Shield)>0 then  // Щит Юджи
    call SaveReal(h, idc, SH_YujiE_Shield, 0)
else
    call RemoveSavedReal(h, idc, SH_YujiE_Shield)
endif
if GetUnitAbilityLevel(c,'A1DF')>=1 then                  // Щит Шилдер Q
    call UnitRemoveAbility(c,'A1DF')
    call SaveReal(h,idc, SH_shi1, 0)
    call SaveReal(h,idc, SH_shi2, 0)
endif
if GetUnitAbilityLevel(c,'A1DG')>=1 then                  // Щит Шилдер E
    call UnitRemoveAbility(c, 'A1DG')
endif
if GetUnitAbilityLevel(c,'A10G')>=1 then                  // Щит Луизы
    call UnitRemoveAbility(c, 'A10G')
endif
if GetUnitAbilityLevel(c, 'A2DF')>0 then                      // Щит Броли
    call SaveReal(h,idc,SH_BroEtime,9)
endif
if GetUnitAbilityLevel(c, 'A0VJ')>0 then                  // Гроза Вонголы
    call UnitRemoveAbility(c, 'A0VJ')
endif
if GetUnitAbilityLevel(c, 'A1HG')>0 then                  // Щит Орехи
    call UnitRemoveAbility(c, 'A1HG')
endif
if GetUnitAbilityLevel(c, 'A3DF')>0 then                  // Щит Waver
    call UnitRemoveAbility(c, 'A3DF')
endif

if GetUnitAbilityLevel(c, 'A1H1')>=1 then                 // Щит от Ульты Жанны Рулер
    call UnitRemoveAbility(c, 'A1H1')
endif
if GetUnitAbilityLevel(c, 'A0VV')>=1 then                 // Броня бороса
    call UnitRemoveAbility(c, 'A0VV')
endif
if GetUnitAbilityLevel(c, 'A28W')>=1 then                 // Броня бороса
    call UnitRemoveAbility(c, 'A28W')
endif
if GetUnitAbilityLevel(c, 'AcF1')>=1 then                 // F Эйса
    call SaveBoolean(HH,idc,SST,false)
    call ShowAbility2('A315',false)
    call ShowAbility2('A015',true)
    call UnitRemoveAbility(c,'AcF1')
endif
if GetUnitAbilityLevel(c, 'ItV1')>=1 then                 // G itachi
    call SaveBoolean(HH,idc,SST,false)
    call ShowAbility2('A30C',false)
    call ShowAbility2('A00C',true)
    call UnitRemoveAbility(c,'ItV1')
endif
if GetUnitAbilityLevel(c, 'GaT1')>=1 then                 // T Gamma
    call SaveBoolean(HH,idc,SST,false)
    call ShowAbility2('A41C',false)
    call ShowAbility2('A0GV',true)
    call UnitRemoveAbility(c,'GaT1')
endif
if GetUnitAbilityLevel(c, 'MgT1')>=1 then                 // T Magnus
    call SaveBoolean(HH,idc,SST,false)
    call ShowAbility2('A42C',false)
    call ShowAbility2('A15C',true)
    call UnitRemoveAbility(c,'MgT1')
endif
if GetUnitAbilityLevel(c,'SiTS')>=1 then                 // Щит P Сигнум Tank Spirit
    call UnitRemoveAbility(c,'SiTS')
endif
if bPaused then
    call PauseUnit(c,true)
endif
call UnitRemoveAbility(c, 'YatB')
call UnitRemoveAbility(c, 'OniC')
endif
call AddSpecialEffectToAllBones(c,"war3mapImported\\t_stormboltmissile.mdx")
call AddSpecialEffectToAllBones(c,"Abilities\\Spells\\Orc\\Purge\\PurgeBuffTarget.mdl")
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\az_goods_lvlup(3).mdx",c,"origin"))
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,2,g)
call GroupEnumUnitsInRange(G,x,y,700,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if IsUnitType(E,UNIT_TYPE_HERO)and IsUnitAlly(E,p)and UnitIsAlive(E)then
call GroupAddUnit(g,E)
call UnitAddAbility(E,'A1HV')
call UnitMakeAbilityPermanent(E,true,'A1HV')
call UnitRemoveAbilityTimedPause(E,'A1HV',2)
call CreateModeIndicatorWithPauseFormDispellable(E,"ReplaceableTextures\\CommandButtons\\BTNEnkiduE.blp",2,'A1HV')
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\az_sg2.mdx",E,"origin"))
endif
call GroupRemoveUnit(G,E)
endloop
set soundplay=SndN(2947) // Sound\Music\mp3Music\Enkido E.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set u=null
set c=null
set p=null
set g=null
set t=null
endfunction
function InitTrig_EnkiduE takes nothing returns nothing
set gg_trg_EnkiduE=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_EnkiduE,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_EnkiduE,Condition(function EnkiduECond))
call TriggerAddAction(gg_trg_EnkiduE,function EnkiduECast)
endfunction
function EnkiduRCond takes nothing returns boolean
return GetSpellAbilityId()=='A1HZ'
endfunction
function EnkiduRMissles3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real he=LoadReal(h,id,2)
local real rate=GetRandomReal(5000,7000)
set n=CreateUnit(GetOwningPlayer(l__d),'e176',GetUnitX(l__d),GetUnitY(l__d),GetRandomReal(0,359))
call SetUnitFlyHeight(n,he,0)
call SetUnitTimeScale(n,4)
call SetUnitFlyHeight(n,0,rate)
call UnitApplyTimedLife(n,'BTLF',he/rate+0.01)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set t=null
set l__d=null
endfunction
function EnkiduRMissles2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real r=LoadReal(h,id,1)
local real he=GetRandomReal(3500,4000)
local real rate=GetRandomReal(5000,7000)
call SetUnitFlyHeight(l__d,he,rate)
call SaveReal(h,id,2,he)
call UnitApplyTimedLife(l__d,'BTLF',he/rate+0.01)
if r<1.1 then
call PauseTimer(t)
call TimerStart(t,he/rate,false,function EnkiduRMissles3)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set t=null
set l__d=null
endfunction
function EnkiduRMissles takes unit l__d,real r returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,r)
call TimerStart(t,0.35,false,function EnkiduRMissles2)
set t=null
endfunction
function EnkiduRCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real dmg=GetHeroAgi(u,true)*(7+GetUnitAbilityLevel(u,'A1HZ'))/23
local real x=LoadReal(h,id,6)
local real y=LoadReal(h,id,7)
local real x1=LoadReal(h,id,4)
local real y1=LoadReal(h,id,5)
local real x2=0
local real y2=0
local real r=0
local real he=0
local real a=LoadReal(h,id,3)
local real dist=LoadReal(h,id,2)
local group g=LoadGroupHandle(h,id,10)
local player p=GetOwningPlayer(u)
local real rad=800
if dist<2.6 then
call SaveReal(h,id,2,dist+0.1)
call SetUnitInvulnerable(u,true)
call PauseUnit(u,true)
if dist<2.3 then
set x2=x+GetRandomReal(rad*(-1),rad)
set y2=y+GetRandomReal(rad*(-1),rad)
set he=5
set n=CreateUnit(p,'e175',x2,y2,GetRandomReal(0,359))
call SetUnitFlyHeight(n,he,0)
call SetUnitTimeScale(n,2)
call EnkiduRMissles(n,dist)
set x2=x+GetRandomReal(rad*(-1),rad)
set y2=y+GetRandomReal(rad*(-1),rad)
set he=5
set n=CreateUnit(p,'e175',x2,y2,GetRandomReal(0,359))
call SetUnitFlyHeight(n,he,0)
call SetUnitTimeScale(n,2)
call EnkiduRMissles(n,dist)
set x2=x+GetRandomReal(rad*(-1),rad)
set y2=y+GetRandomReal(rad*(-1),rad)
set he=5
set n=CreateUnit(p,'e175',x2,y2,GetRandomReal(0,359))
call SetUnitFlyHeight(n,he,0)
call SetUnitTimeScale(n,2)
call EnkiduRMissles(n,dist)
set x2=x+GetRandomReal(rad*(-1),rad)
set y2=y+GetRandomReal(rad*(-1),rad)
set he=5
set n=CreateUnit(p,'e175',x2,y2,GetRandomReal(0,359))
call SetUnitFlyHeight(n,he,0)
call SetUnitTimeScale(n,2)
call EnkiduRMissles(n,dist)
endif
if dist>0.3 then
call GroupEnumUnitsInRange(g,x,y,1000,Base)
loop
