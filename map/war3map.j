endfunction
function DobleCeroCond takes nothing returns boolean
return GetSpellAbilityId()=='A0PA' and udg_B==true
endfunction
function DobleCeroCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=LoadReal(h,id,1)
local real y=LoadReal(h,id,2)
local real a=Atan2(LoadReal(h,id,4)-y,LoadReal(h,id,3)-x)
local real l__d=LoadReal(h,id,5)
local group g=LoadGroupHandle(h,id,6)
local player p=GetOwningPlayer(u)
local real dmg=GetUnitAbilityLevel(u,'A0PA')*(GetHeroAgi(u,true)+100)+LoadReal(h,GetHandleId(u),SH_nelld)
local real l__s=LoadReal(h,id,8)
if l__d<2300 then
set x=x+l__d*Cos(a)
set y=y+l__d*Sin(a)
set n=CreateUnit(p,'e0NS',x,y,(a*bj_RADTODEG))
call SetUnitScale(n,l__s,l__s,l__s)
call SaveReal(h,id,8,l__s+0.24)
call UnitApplyTimedLife(n,'BTLF',1)
call SaveReal(h,id,5,l__d+40)
call GroupEnumUnitsInRange(g,x,y,125+15*l__s,Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set ide=GetHandleId(E)
if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
else
call SaveReal(h,GetHandleId(u),SH_nelld,0)
set x=x+l__d*Cos(a)
set y=y+l__d*Sin(a)
call UnitApplyTimedLife(CreateUnit(p,'e0NJ',x,y,GetRandomReal(0,359)),'BTLF',3)
//call UnitApplyTimedLife(CreateUnit(p,'e0NK',x,y,GetRandomReal(0,359)),'BTLF',6)
call UnitApplyTimedLife(CreateUnit(p,'e0NI',x,y,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0NL',x,y,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0NM',x,y,GetRandomReal(0,359)),'BTLF',3)
set idg=GetHandleId(g)
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,idg)
endif
set p=null
set u=null
set g=null
set t=null
endfunction
