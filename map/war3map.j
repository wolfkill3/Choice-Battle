local integer str5=StringHash("lightwalkcondgroup")
local integer str6=StringHash("lightdist")
local real speed=LoadReal(HH,idu,str4)
local player p=GetOwningPlayer(u)
if x!=0 and y!=0 and x1!=x and y1!=y then
call SaveReal(HH,idu,str,x)
call SaveReal(HH,idu,str+1,y)
call SaveReal(HH,idu,str6,0)
if speed>10 then
endif
if LoadBoolean(HH,idu,str3)==false then
if speed>10 then
call UnitAddAbility(u,0x41305556)
call UnitAddAbility(u,0x41305557)
endif
call SaveUnitHandle(HH,id,0,u)
call SaveBoolean(HH,idu,str3,true)
call SaveGroupHandle(HH,idu,str5,CreateGroup())
call TimerStart(t,0.01,true,function Godspeed2Cast2)
else
call FlushChildHashtable(HH,GetHandleId(LoadGroupHandle(HH,idu,str5)))
endif
endif
set p=null
set u=null
set t=null
endfunction
