function MissleMoveQDeidara2 takes nothing returns nothing //pauk
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit l__d=LoadUnitHandle(h,id,2)
local real speed=LoadReal(h,id,4)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)+LoadReal(h,id,3)*bj_DEGTORAD
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>70 and UnitIsAlive(c) and RectContainsCoords(gg_rct_Base, GetUnitX(c), GetUnitY(c)) == false then
set x=x+speed*Cos(a)
set y=y+speed*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
else
call PauseUnit(l__d,false)
call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,false)
if UnitIsAlive(c) and UnitIsAlive(l__d) then
call IssueTargetOrder(l__d,"attack",c)
endif
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
endif
set p=null
set l__d=null
set c=null
set t=null
set u=null
endfunction
function MissleMoveQDeidara takes unit u,unit c,unit l__d,real speed,real angle,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveUnitHandle(h,id,2,l__d)
call SaveReal(h,id,3,angle)
call SaveReal(h,id,4,speed)
call SaveReal(h,id,5,dmg)
call PauseUnit(l__d,true)
call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,true)
call UnitApplyTimedLife(l__d,'BTLF', 40.)
call TimerStart(t,0.03,true,function MissleMoveQDeidara2)
set t=null
endfunction
function QDeidaraCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=0
local real y1=0
local real a=0
local player p=GetOwningPlayer(u)
local real dmg=(1+GetUnitAbilityLevel(u,'Ad07'))*GetHeroInt(u,true)+(GetUnitAbilityLevel(u,'Ad07')*40)
call SetUnitAnimation(u,"Spell Three")
set soundplay=SndN(3010) // Sound\war3mapImported\DeidaraQ1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SetSoundVolume(soundplay,220)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call GroupEnumUnitsInRange(G,x,y,2500,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)and IsUnitVisible(E,p)and IsUnitType(E,UNIT_TYPE_HERO)and GetUnitAbilityLevel(E,'Asud') == 0 then
set x1=GetUnitX(u)
set y1=GetUnitY(u)
set a=Atan2(y1-y,x1-x)*bj_RADTODEG
set n=CreateUnit(p,'no02',x,y,a)
call SaveReal(HH,GetHandleId(n),0,dmg/4)
call IssueImmediateOrderById(n,OrderId("selfdestructon"))
//call UnitApplyTimedLife(n,'BTLF',900)
call MissleMoveQDeidara(u,E,n,GetRandomReal(22,36),GetRandomReal(-13,13),GetHeroInt(u,true)*2)
set n=CreateUnit(p,'no02',x,y,a)
call SaveReal(HH,GetHandleId(n),0,dmg/4)
call IssueImmediateOrderById(n,OrderId("selfdestructon"))
//call UnitApplyTimedLife(n,'BTLF',900)
call MissleMoveQDeidara(u,E,n,GetRandomReal(22,36),GetRandomReal(-13,13),GetHeroInt(u,true)*2)
set n=CreateUnit(p,'no02',x,y,a)
call SaveReal(HH,GetHandleId(n),0,dmg/4)
call IssueImmediateOrderById(n,OrderId("selfdestructon"))
//call UnitApplyTimedLife(n,'BTLF',900)
call MissleMoveQDeidara(u,E,n,GetRandomReal(22,36),GetRandomReal(-13,13),GetHeroInt(u,true)*2)
endif
call GroupRemoveUnit(G,E)
endloop
set t=null
set u=null
set p=null
endfunction
