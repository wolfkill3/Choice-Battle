call EffectCreateAndMove(true,EffectID[6],facing,1.5,0.4,0.4,80,20,100,0,50,Dummy,0,facing)
call EffectCreateAndMove(true,EffectID[397],facing,1.5,1.25,1,100,100,100,40,50,Dummy,0,facing)
