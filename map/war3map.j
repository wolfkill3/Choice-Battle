function QFriezaCond takes nothing returns boolean
return GetSpellAbilityId()=='A0SP'
endfunction
function QFriezaMissles2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real f=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local player p=GetOwningPlayer(l__d)
local integer idp=GetPlayerId(p)
local real x1=GetUnitX(Hero[idp])+1900*Cos(GetUnitFacing(Hero[idp])*bj_DEGTORAD)
local real y1=GetUnitY(Hero[idp])+1900*Sin(GetUnitFacing(Hero[idp])*bj_DEGTORAD)
local real a=Atan2(y1-y,x1-x)+LoadReal(h,id,5)
local real dist=LoadReal(h,id,7)
local group g=LoadGroupHandle(h,id,10)
local real mod=3-2.7*(dist/LoadReal(h,id,10))
local real dmg=LoadReal(h,id,9)*mod
local integer l__ide=0
local integer l__idg=GetHandleId(g)
if dist>speed and l__d!=null and IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SaveReal(h,id,7,dist-speed)
call GroupEnumUnitsInRange(g,x,y,70,Base)
loop
set E=FirstOfGroup(g)
set l__ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,l__ide)then
call SaveUnitHandle(h,l__idg,l__ide,E)
call myCustomDamage(Hero[idp],E,dmg,false,false,null,null,null)
call IssueImmediateOrder(E,"stop")
call UnitApplyTimedLife(l__d,'BTLF',LoadReal(h,id,8))
call SaveReal(h,id,7,dist-(speed*6))
endif
call GroupRemoveUnit(g,E)
endloop
else
call UnitApplyTimedLife(l__d,'BTLF',LoadReal(h,id,8))
call PauseTimer(t)
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set p=null
set g=null
set t=null
endfunction
function QFriezaMissles takes unit l__d,real speed,real a,real dist,real time,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,GetUnitFlyHeight(l__d))
call SaveReal(h,id,3,GetUnitX(l__d))
call SaveReal(h,id,4,GetUnitY(l__d))
call SaveReal(h,id,5,a*GetRandomReal(-0.042,0.042))
call SaveReal(h,id,7,dist)
call SaveReal(h,id,10,dist)
call SaveReal(h,id,8,time)
call SaveReal(h,id,9,dmg)
call SaveGroupHandle(h,id,10,CreateGroup())
call TimerStart(t,0.014,true,function QFriezaMissles2)
set t=null
endfunction
function QFriezaStomOrders2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
call IssueImmediateOrder(u,"stop")
call SetUnitFacingTimed(u,Atan2(LoadReal(h,id,1)-GetUnitY(u),LoadReal(h,id,2)-GetUnitX(u))*bj_RADTODEG,2.9)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
set t=null
set u=null
endfunction
function QFriezaStomOrders takes nothing returns nothing
local unit u=GetOrderedUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,GetOrderPointY())
call SaveReal(h,id,2,GetOrderPointX())
call TimerStart(t,0.001,false,function QFriezaStomOrders2)
set u=null
set t=null
endfunction
function QFriezaCast2 takes nothing returns nothing
local integer id = GetHandleID()
local integer time = LoadInt("Time")
local real x = GetUnitX(LoadUnit("Dummy"))
local real y = GetUnitY(LoadUnit("Dummy"))
local real ang = LoadFloat("ang")
local player p=GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash))
local real dmg = GetHeroInt(LoadUnitHandle(HH,MUIHandle(),CasterHash),true) * (2.0+(0.4 * GetUnitAbilityLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash),'A0SP')))
if GetUnitTypeId(LoadUnitHandle(HH,MUIHandle(),CasterHash))=='H248' then
set dmg = dmg*1.25
endif
call ExtraTime()
if time == 0 then
set n = CreateUnit(p,'e55V',GetUnitX(LoadUnitHandle(HH,MUIHandle(),CasterHash)),GetUnitY(LoadUnitHandle(HH,MUIHandle(),CasterHash)),LoadFloat("ang")*bj_RADTODEG)
call SetUnitScale(n, 0.9, 0.9, 0.9)
call UnitApplyTimedLife(n,'BTLF',0.2)
call SetUnitTimeScale(LoadUnit("Dummy"),2.8)
call SetUnitScale(LoadUnit("Dummy"), 1.4, 1.4, 1.4)
call SetUnitFlyHeight(LoadUnit("Dummy"),GetRandomReal(40,70),0)
call SetUnitAnimation(LoadUnitHandle(HH,MUIHandle(),CasterHash),"Spell Channel")
set soundplay=SndN(3091) // Sound\Music\mp3Music\deathbeams.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
if GetRandomInt(0,5) == 1 then
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(3094) // Sound\Music\mp3Music\FriezaQ1.mp3
else
set soundplay=SndN(3097) // Sound\Music\mp3Music\Frieza\FriezaQ1-jap.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
elseif GetRandomInt(0,5) == 2 then
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(3100) // Sound\Music\mp3Music\FriezaQ2.mp3
else
set soundplay=SndN(3103) // Sound\Music\mp3Music\Frieza\FriezaQ2-jap.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call GroupEnumUnitsInRange(G,x,y,135,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)),E)then
call myCustomDamage(LoadUnitHandle(HH,MUIHandle(),CasterHash),E,dmg,false,false,null,null,null)
call IssueImmediateOrder(E, "stop")
if GetUnitTypeId(LoadUnitHandle(HH,MUIHandle(),CasterHash))=='H248' then
call SlowUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash),E,0.4,0.4,3,2,false)
endif
endif
call GroupRemoveUnit(G,E)
endloop
call GroupClear(G)
endif

if time < 26 and not IsTerrainPathable(x + 80 * Cos(ang),y + 80 * Sin(ang),PATHING_TYPE_FLYABILITY) then
call SetUnitX(LoadUnit("Dummy"), x + 80 * Cos(ang))
call SetUnitY(LoadUnit("Dummy"), y + 80 * Sin(ang))
call GroupClear(G)
call GroupEnumUnitsInRange(G,x,y,130,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)),E)then
call SaveInteger(HH,id, TIME_HASH, 106)
set time=27
endif
call GroupRemoveUnit(G,E)
endloop
else
call SetUnitAnimation(LoadUnitHandle(HH,MUIHandle(),CasterHash),"Stand")
call SaveInteger(HH,id, TIME_HASH, 106)
set time=27
endif

if time >= 26 then
call GroupClear(G)
call GroupEnumUnitsInRange(G,x,y,135,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)),E)then
call myCustomDamage(LoadUnitHandle(HH,MUIHandle(),CasterHash),E,dmg,false,false,null,null,null)
call IssueImmediateOrder(E, "stop")
if GetUnitTypeId(LoadUnitHandle(HH,MUIHandle(),CasterHash))=='H248' then
call SlowUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash),E,0.4,0.4,3,2,false)
endif
call SaveInteger(HH,id, TIME_HASH, 126)
endif
call GroupRemoveUnit(G,E)
endloop
call GroupClear(G)
call UnitApplyTimedLife(LoadUnit("Dummy"),'BTLF',0.2)
call RemoveSavedHandle(HH,id,DummyHash)
call Clear(id)
endif
endfunction
function QFriezaCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real a=Atan2(GetSpellTargetY()-GetUnitY(u),GetSpellTargetX()-GetUnitX(u))
local integer id2 = NewTimer(GetPlayerId(GetTriggerPlayer()))
call SaveAgentHandle(HH,id2, CasterHash, u)
if GetUnitTypeId(u)=='H248' then
call SaveAgentHandle(HH,id2, DummyHash, CreateUnit(p,'e35V',GetUnitX(u)-60*Cos(a),GetUnitY(u)-60*Sin(a),a*bj_RADTODEG))
else
call SaveAgentHandle(HH,id2, DummyHash, CreateUnit(p,'e25V',GetUnitX(u)-60*Cos(a),GetUnitY(u)-60*Sin(a),a*bj_RADTODEG))
endif
call SetUnitTimeScale(LoadUnitHandle(HH,id2,DummyHash),2.5)
call SetUnitScale(LoadUnitHandle(HH,id2,DummyHash), 1.4, 1.4, 1.4)
call SetUnitFlyHeight(LoadUnitHandle(HH,id2,DummyHash),GetRandomReal(80,100),0)
call SaveReal(HH,id2,SH_tx,GetSpellTargetX())
call SaveReal(HH,id2,SH_ty,GetSpellTargetY())
call SaveReal(HH,id2,SH_ang,a)
call SetUnitAnimation(u,"Spell Channel")
call TimerStart(LoadTimer(GetPlayerId(GetTriggerPlayer())),0.01,true,function QFriezaCast2)
set u=null
set t=null
endfunction
function InitTrig_QFrieza takes nothing returns nothing
set gg_trg_DeathBeam=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_DeathBeam,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_DeathBeam,Condition(function QFriezaCond))
call TriggerAddAction(gg_trg_DeathBeam,function QFriezaCast)
endfunction

function GoldenFriezaStartLoop takes nothing returns nothing
local integer id = GetHandleID()
local integer time = LoadInt("Time")
local real x= GetUnitX(LoadUnitHandle(HH,MUIHandle(),CasterHash))
local real y= GetUnitY(LoadUnitHandle(HH,MUIHandle(),CasterHash))
if time > 0 and GetWidgetLife(LoadUnitHandle(HH,MUIHandle(),CasterHash)) > 0.405 and udg_B==true and DU2==true then
if time>150 then
call SaveInteger(HH,id,TIME_HASH, time - 1)
else
if IsUnitPaused(LoadUnitHandle(HH,MUIHandle(),CasterHash))==false then
    call SaveInteger(HH,id,TIME_HASH, time - 1)
endif
endif
if time >= 170 then
call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash),true)
call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash),true)
set EFF = AddSpecialEffect("war3mapImported\\DustWave.mdx",x,y)
call SetSpecialEffectFacing(EFF , GetRandomReal(0,359))
call SetSpecialEffectScale(EFF, GetRandomReal(0.3,2))
call DestroyEffect(EFF)
set n =CreateUnit(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)),'e0U6',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitAnimation(n,"death")
call SetUnitFlyHeight(n,GetRandomReal(50.,150.),0)
call SetUnitScale(n,GetRandomReal(1.3,2),GetRandomReal(1.3,2),GetRandomReal(1.3,2))
call SetUnitVertexColor(n,255,255,255,50)
else
if time == 169 then
call UnitAddAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'SS02')
call IssueImmediateOrder(LoadUnitHandle(HH,MUIHandle(),CasterHash), "bearform")
call SetAbilityCastPoint(GetUnitAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'A0SP'), 0.02)
call SetAbilityCastPoint(GetUnitAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'A0SS'), 0.02)
call SetAbilityCastPoint(GetUnitAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'A0SW'), 0.02)
call SetAbilityCastPoint(GetUnitAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'A0SX'), 0.02)
call SetAbilityCastPoint(GetUnitAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'A0SY'), 0.02)
call UnitRemoveAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'SS02')
call CheckUnitBonusRange(LoadUnitHandle(HH,MUIHandle(),CasterHash))
call UnitAddAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'All1')
call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash),true)
set EFF = AddSpecialEffect("war3mapImported\\kansou2.mdx",x,y)
call SetSpecialEffectFacing(EFF , 0)
call SetSpecialEffectScale(EFF, 2)
call DestroyEffect(EFF)
set EFF = AddSpecialEffect("war3mapImported\\groundshock1.mdx",x+75*Cos(120*bj_DEGTORAD),y+75*Sin(120*bj_DEGTORAD))
call SetSpecialEffectFacing(EFF , 120)
call SetSpecialEffectScale(EFF, 1.5)
call DestroyEffect(EFF)
set EFF = AddSpecialEffect("war3mapImported\\groundshock1.mdx",x+75*Cos(240*bj_DEGTORAD),y+75*Sin(240*bj_DEGTORAD))
call SetSpecialEffectFacing(EFF , 240)
call SetSpecialEffectScale(EFF, 1.5)
call DestroyEffect(EFF)
set EFF = AddSpecialEffect("war3mapImported\\groundshock1.mdx",x+75*Cos(360*bj_DEGTORAD),y+75*Sin(360*bj_DEGTORAD))
call SetSpecialEffectFacing(EFF , 360)
call SetSpecialEffectScale(EFF, 1.5)
call DestroyEffect(EFF)
endif
if time == 150 then
call PauseUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash),false)
call SetUnitInvulnerable(LoadUnitHandle(HH,MUIHandle(),CasterHash),false)
endif
endif
else
if IsUnitType(LoadUnitHandle(HH,MUIHandle(),CasterHash), UNIT_TYPE_DEAD) == false and GetWidgetLife(LoadUnitHandle(HH,MUIHandle(),CasterHash)) > 0.405 then
call UnitAddAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'SS01')
call IssueImmediateOrder(LoadUnitHandle(HH,MUIHandle(),CasterHash), "bearform")
call UnitRemoveAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'SS01')
call CheckUnitBonusRange(LoadUnitHandle(HH,MUIHandle(),CasterHash))
call SetAbilityCastPoint(GetUnitAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'A0SP'), 0.35)
call SetAbilityCastPoint(GetUnitAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'A0SS'), 0.35)
call SetAbilityCastPoint(GetUnitAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'A0SW'), 0.35)
call SetAbilityCastPoint(GetUnitAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'A0SX'), 0.35)
call SetAbilityCastPoint(GetUnitAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'A0SY'), 0.35)
call UnitRemoveAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'All1')
if GetHeroLevel(LoadUnitHandle(HH,MUIHandle(),CasterHash))<35 then
call SetUnitAnimation(LoadUnitHandle(HH,MUIHandle(),CasterHash), "death")
call SlowUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash),LoadUnitHandle(HH,MUIHandle(),CasterHash),0.5,0.5,6,2,false)
call SetControlToUnit(LoadUnitHandle(HH,MUIHandle(),CasterHash),LoadUnitHandle(HH,MUIHandle(),CasterHash), 3, "stun")
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(LoadUnitHandle(HH,MUIHandle(),CasterHash)), 'AFUP', true)
call Clear(id)
endif
endif
endfunction

function GoldenFriezaStart takes unit a returns nothing
local integer hId = GetPlayerId(GetTriggerPlayer())
local integer id = NewTimer(hId)
call SetPlayerAbilityAvailable(GetOwningPlayer(a), 'AFUP', false)
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(3106) // Sound\war3mapImported\GoldenFrieza.mp3
else
set soundplay=SndN(3108) // Sound\Music\mp3Music\GoldenFrieza-jap.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SaveAgentHandle(HH,id,CasterHash,a)
call SaveInteger(HH,id,TIME_HASH, 180)
call CreateModeIndicatorWithPauseForm(a, "war3mapImported\\BTNTrue_Golden_Frieza_aura.blp", 15)
call TimerStart(LoadTimer(hId),.1,true,function GoldenFriezaStartLoop)
endfunction

function TransformationStartLoop takes nothing returns nothing
local integer id = GetHandleID()
local integer time = LoadInt("Time")
local integer time2 = LoadInt("Time2")
local integer TransfID = LoadInt("ID")
local unit u=LoadUnitHandle(HH,MUIHandle(),CasterHash)
if time > 0 and time2!=0 and GetWidgetLife(u) > 0.405 and udg_B==true and DU2==true then
    if time2==time then
        if GetUnitTypeId(u)=='H012' then
            set soundplay=SndN(3110) // Sound\Music\mp3Music\HichigoT.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            call SaveInteger(HH,GetHandleId(u),'SASB',R2I(GetHeroStr(u,true)*0.10))
            call SaveInteger(HH,GetHandleId(u),'SAAB',R2I(GetHeroAgi(u,true)*0.10))
            call SaveInteger(HH,GetHandleId(u),'SAIB',R2I(GetHeroInt(u,true)*0.10))
            call SetHeroStr(u, GetHeroStr(u, false)+LoadInteger(HH,GetHandleId(u),'SASB'), true)
            call SetHeroAgi(u, GetHeroAgi(u, false)+LoadInteger(HH,GetHandleId(u),'SAAB'), true)
            call SetHeroInt(u, GetHeroInt(u, false)+LoadInteger(HH,GetHandleId(u),'SAIB'), true)
            call CreateModeIndicatorWithPauseForm(u, "war3mapImported\\BTNHollowHichigo.blp", 25)
            call UnitAddAbility(u, 'S102')
            call IssueImmediateOrder(u, "bearform")
            call UnitRemoveAbility(u, 'S102')
            call SaveInteger(HH,id,SH_ID, 1)
        endif
        if GetUnitTypeId(u)=='H06D' then
            set soundplay=SndN(3113) // Sound\Music\mp3Music\Alterl_T.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            call SaveInteger(HH,GetHandleId(u),'SASB',R2I(GetHeroStr(u,true)*0.10))
            call SaveInteger(HH,GetHandleId(u),'SAAB',R2I(GetHeroAgi(u,true)*0.10))
            call SaveInteger(HH,GetHandleId(u),'SAIB',R2I(GetHeroInt(u,true)*0.10))
            call SetHeroStr(u, GetHeroStr(u, false)+LoadInteger(HH,GetHandleId(u),'SASB'), true)
            call SetHeroAgi(u, GetHeroAgi(u, false)+LoadInteger(HH,GetHandleId(u),'SAAB'), true)
            call SetHeroInt(u, GetHeroInt(u, false)+LoadInteger(HH,GetHandleId(u),'SAIB'), true)
            call CreateModeIndicatorWithPauseForm(u, "ReplaceableTextures\\CommandButtons\\BTNSaberAlterArmoured.blp", 25)
            call UnitAddAbility(u, 'S202')
            call IssueImmediateOrder(u, "bearform")
            call UnitRemoveAbility(u, 'S202')
            call SaveInteger(HH,id,SH_ID, 2)
        endif
        if GetUnitTypeId(u)=='H00P' then
            call SaveInteger(HH,GetHandleId(u),'SASB',R2I(GetHeroStr(u,true)*0.20))
            call SaveInteger(HH,GetHandleId(u),'SAAB',R2I(GetHeroAgi(u,true)*0.20))
            call SaveInteger(HH,GetHandleId(u),'SAIB',R2I(GetHeroInt(u,true)*0.20))
            call SetHeroStr(u, GetHeroStr(u, false)+LoadInteger(HH,GetHandleId(u),'SASB'), true)
            call SetHeroAgi(u, GetHeroAgi(u, false)+LoadInteger(HH,GetHandleId(u),'SAAB'), true)
            call SetHeroInt(u, GetHeroInt(u, false)+LoadInteger(HH,GetHandleId(u),'SAIB'), true)
            call CreateModeIndicatorWithPauseForm(u, "ReplaceableTextures\\CommandButtons\\BTNMoria5.blp", 25)
            call UnitAddAbility(u, 'S302')
            call IssueImmediateOrder(u, "bearform")
            call UnitRemoveAbility(u, 'S302')
            call SaveInteger(HH,id,SH_ID, 3)
            call ShowAbility2('MrF1',false)
            call ShowAbility2('MrG1',false)
            call ShowAbility2('MrW1',false)
            call UnitAddAbility(u, 'MrW2')
            call UnitMakeAbilityPermanent(u,true,'MrW2')  
        endif
        if GetUnitTypeId(u)=='H02Y' then
            set soundplay=SndN(3116) // Sound\Music\mp3Music\GenkshiT.mp3
