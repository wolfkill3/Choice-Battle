function LucyArcherCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
call PauseUnit(u,true)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,0)
call SaveReal(h,id,3,a)
call SaveReal(h,id,4,1500)
call SaveReal(h,id,7,0.1)
call SaveReal(h,id,8,1.2)
call SaveInteger(h,id,5,-1-GetUnitAbilityLevel(u,'A1EL'))
call SaveGroupHandle(h,id,6,CreateGroup())
call SetUnitTimeScale(u,2)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG-45)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+45)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
call SetUnitAnimation(u,"Spell three")
set soundplay=SndN(2805) // Sound\Music\mp3Music\LucyArcher.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.6,false,function LucyArcherCastP2)
set u=null
set p=null
set t=null
endfunction
function InitTrig_LucyArcher takes nothing returns nothing
set gg_trg_LucyArcher=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_LucyArcher,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_LucyArcher,Condition(function LucyArcherCond))
call TriggerAddAction(gg_trg_LucyArcher,function LucyArcherCast)
endfunction
function LucyAriesCond takes nothing returns boolean
return GetSpellAbilityId()=='A1EY'
endfunction
function LucyAriesCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,10)
local real y1=LoadReal(h,id,11)
local player p=GetOwningPlayer(u)
local real a=LoadReal(h,id,3)
local integer lvl=GetUnitAbilityLevel(u,'A1EY')*3
set n=CreateUnit(p,'e14E',x+155*Cos(a),y+155*Sin(a),a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitAnimation(n,"Spell")
call GroupEnumUnitsInRange(G,x1,y1,500,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if IsUnitAlly(E,p)and IsUnitType(E,UNIT_TYPE_HERO)then
call UnitAddAbility(E,'A1EZ')
call UnitAddAbilityTimed(E,lvl,'A1EZ')
call UnitAddAbility(E,'A1F0')
call UnitAddAbilityTimed(E,lvl,'A1F0')
call UnitAddAbility(E,'A1F1')
call UnitAddAbilityTimed(E,lvl,'A1F1')
endif
call GroupRemoveUnit(G,E)
endloop
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set u=null
set p=null
set t=null
endfunction
