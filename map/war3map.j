function PresentDCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local integer array it
local integer i
local integer b=0
set it[0]='I021'
set it[1]='I022'
set it[2]='I023'
set it[3]='I024'
set it[4]='I025'
set it[5]='I06D'
set it[6]='I027'
set it[7]='I028'
set it[8]='I029'
set it[9]='I02A'
set it[10]='I02B'
set it[11]='I02C'
set it[12]='I02D'
call RemoveBonus(CreateItem(it[GetRandomInt(0,12)],x,y),25)
call DestroyEffect(AddSpecialEffect("war3mapImported\\Slam.mdx",x,y))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",x,y))
set u=null
