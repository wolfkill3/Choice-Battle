call UnitApplyTimedLife(CreateUnit(p,'e0RH',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0RK',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0RN',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0XQ',x,y,(a*bj_RADTODEG)),'BTLF',4)
set n=CreateUnit(p,'e0RO',x+100*Cos(a),y+100*Sin(a),(a*bj_RADTODEG))
call UnitApplyTimedLife(n,'BTLF',6)
call SetUnitAnimation(u,"Spell four")
call Push3(n,7,a,200,"null")
call ShakeCamera(0.5,20)
call SetUnitTimeScale(n,0.5)
set n=CreateUnit(p,'e0RQ',x+100*Cos(a),y+100*Sin(a),(a*bj_RADTODEG))
call UnitApplyTimedLife(n,'BTLF',6)
call Push3(n,7,a,200,"null")
call SetUnitTimeScale(n,0.5)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.2,1.2,1.2)
call SetUnitTimeScale(n,0.6)
call SetUnitVertexColor(n,255,230,100,50)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitTimeScale(n,0.6)
call SetUnitVertexColor(n,255,230,100,50)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.7,1.7,1.7)
call SetUnitTimeScale(n,0.6)
call SetUnitVertexColor(n,255,230,100,50)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.9,1.9,1.9)
call SetUnitTimeScale(n,0.6)
call SetUnitVertexColor(n,255,230,100,50)
call UnitApplyTimedLife(CreateUnit(p,'e0C7',x,y,(a*bj_RADTODEG)),'BTLF',6)
call RemoveUnit(l__d)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call FlushChildHashtable(h,GetHandleId(g))
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
function RockCast2 takes nothing returns nothing
