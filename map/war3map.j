call SetUnitFlyHeight(n,0,1000)
call UnitApplyTimedLife(n,'BTLF',1)
set n=CreateUnit(p,'e0YT',x,y,a*bj_RADTODEG)
call SetUnitFlyHeight(n,90,0)
call UnitApplyTimedLife(n,'BTLF',1.5)
call UnitAddAbility(d1,'A107')
call UnitRemoveAbility(d1,'A107')
call GroupEnumUnitsInRange(g,x,y,150,Base)
loop
set E=FirstOfGroup(g)
set l__ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and LoadUnitHandle(h,l__idg,l__ide)!=E then
call SaveUnitHandle(h,l__idg,l__ide,E)
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(g,E)
endloop
else
call GroupEnumUnitsInRange(g,x,y,700,Base)
loop
set E=FirstOfGroup(g)
set l__ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and LoadUnitHandle(h,l__idg,l__ide)!=E then
call SaveUnitHandle(h,l__idg,l__ide,E)
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(g,E)
endloop
loop
exitwhen i>=15
set n=CreateUnit(p,'e0YS',x+GetRandomReal(-1000,1000)*Cos(GetRandomReal(-6.28,6.28)),y+GetRandomReal(-1000,1000)*Sin(GetRandomReal(-6.28,6.28)),GetRandomReal(0,359))
call SetUnitFlyHeight(n,1000,0)
call SetUnitFlyHeight(n,0,1000)
call UnitApplyTimedLife(n,'BTLF',1)
set i=i+1
endloop
call PauseUnit(d1,false)
call SetUnitInvulnerable(u,false)
call SetUnitInvulnerable(d1,false)
call UnitApplyTimedLife(CreateUnit(p,'e0DL',x,y,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0DK',x,y,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0DJ',x,y,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0KO',x,y,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e0LA',x,y,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0L8',x,y,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0L9',x,y,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0LV',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0LU',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0LW',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0C7',x,y,(a*bj_RADTODEG)),'BTLF',6)
call FlushChildHashtable(h,l__idg)
call GroupClear(g)
call DestroyGroup(g)
call RemoveUnit(l__d)
call UnitRemoveAbility(d1,'A16C')
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set p=null
set l__d=null
set d1=null
set t=null
    set u=null
endfunction
function DragonBreathCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real x=LoadReal(h,id,21)
local real y=LoadReal(h,id,22)
local real x1=LoadReal(h,id,5)
local real y1=LoadReal(h,id,6)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real dmg=LoadReal(h,id,4)
local real dist=LoadReal(h,id,2)
local real scale=LoadReal(h,id,10)
local real mdist=LoadReal(h,id,12)
local real tm=GetWidgetMana(u)
local real deg=75*bj_DEGTORAD
local integer ip=GetPlayerId(p)
local unit d1=LoadUnitHandle(HH,StringHash(I2S(ip)),SH_index)
local real time=LoadReal(h,id,24)
if time<2 then
call SaveReal(h,id,24,time+0.1)
set n=CreateUnit(p,'e0B2',x,y,GetRandomReal(0,359))
call SetUnitScale(n,0.5,0.5,0.5)
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitVertexColor(n,40,150,255,70)
call SetUnitFlyHeight(n,0,0)
set n=CreateUnit(p,'e0B2',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitVertexColor(n,40,150,255,60)
call SetUnitScale(n,1,1,1)
call SetUnitFlyHeight(n,0,0)
set n=CreateUnit(p,'e0B2',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitVertexColor(n,40,150,255,50)
call SetUnitFlyHeight(n,0,0)
call SetUnitScale(n,1.5,1.5,1.5)
set n=CreateUnit(p,'e0B2',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitVertexColor(n,40,150,255,40)
call SetUnitFlyHeight(n,0,0)
call SetUnitScale(n,2,2,2)
call SetUnitX(l__d,x+mdist*Cos(a-deg))
call SetUnitY(l__d,y+mdist*Sin(a-deg))
call SaveReal(h,id,10,scale+0.005)
call SaveReal(h,id,12,mdist+1)
call SetUnitScale(l__d,scale,scale,scale)
call SetUnitFacing(d1,a*bj_RADTODEG)
call UnitAddAbility(d1,'A107')
call UnitRemoveAbility(d1,'A107')
else
call PauseUnit(d1,true)
call SetUnitInvulnerable(d1,true)
call SaveReal(h,id,11,SR(x,y,x1,y1))
call SetUnitTimeScale(u,1)
call SetUnitX(l__d,x+100*Cos(a))
call SetUnitY(l__d,y+100*Sin(a))
call RemoveUnit(l__d)
set n=CreateUnit(p,'e0R6',x+35*Cos(a),y+35*Sin(a),a*bj_RADTODEG)
call SetUnitScale(n,scale+2,scale+2,scale+2)
call SetUnitFlyHeight(n,0,90)
call SaveUnitHandle(h,id,12,n)
call SetUnitAnimation(u,"Cinematic Throw")
call SetUnitScale(l__d,0.8,0.8,0.8)
call PauseTimer(t)
call TimerStart(t,0.02,true,function DragonBreathCast3)
endif
set d1=null
set l__d=null
set p=null
set u=null
set t=null
endfunction
function DragonBreathCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(p)
local unit l__d=LoadUnitHandle(HH,StringHash(I2S(ip)),SH_index)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x2=GetUnitX(u)
local real y2=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y2,x1-x2)
local real ang=120*bj_DEGTORAD
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
if IsTerrainPathable(x2-800*Cos(a),y2-800*Sin(a),PATHING_TYPE_FLYABILITY)==false then
set x=x2-800*Cos(a)
set y=y2-800*Sin(a)
elseif IsTerrainPathable(x2,y2,PATHING_TYPE_FLYABILITY)==false then
set x=x2
set y=y2
elseif IsTerrainPathable(x2+200*Cos(a),y2+200*Sin(a),PATHING_TYPE_FLYABILITY)==false then
set x=x2+200*Cos(a)
set y=y2+200*Sin(a)
endif
call SetUnitXY_1(l__d,x,y, false)
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
call PauseUnit(l__d,true)
call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,true)
call UnitAddAbility(l__d,'Arav')
call UnitRemoveAbility(l__d,'Arav')
call SetUnitFlyHeight(l__d,0,0)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,21,x)
call SaveReal(h,id,22,y)
call SaveGroupHandle(h,id,28,CreateGroup())
call SaveReal(h,id,27,SR(x,y,x1,y1))
call SaveReal(h,id,5,x1)
call SaveReal(h,id,6,y1)
call SaveReal(h,id,4,10*GetHeroStr(u,true))
call SaveReal(h,id,2,2700)
call SaveReal(h,id,10,0.05)
call SaveReal(h,id,11,a)
call SaveReal(h,id,33,a)
call SaveReal(h,id,12,25)
call SaveReal(h,id,24,0)
call SetUnitTimeScale(u,0)
call SaveGroupHandle(h,id,12,CreateGroup())
call SetUnitInvulnerable(l__d,true)
set n=CreateUnit(p,'e0YT',x+25*Cos(a),y+25*Sin(a),a*bj_RADTODEG)
call SaveUnitHandle(h,id,7,n)
call SetUnitVertexColor(n,125,200,255,180)
call SetUnitFlyHeight(n,90,0)
set n=CreateUnit(p,0x65305952,x+45*Cos(a+45*bj_DEGTORAD),y+45*Sin(a+45*bj_DEGTORAD),a*bj_RADTODEG)
call SetUnitFlyHeight(n,90,0)
call UnitApplyTimedLife(n,'BTLF',4)
set n=CreateUnit(p,0x65305952,x+45*Cos(a-45*bj_DEGTORAD),y+45*Sin(a-45*bj_DEGTORAD),a*bj_RADTODEG)
call SetUnitFlyHeight(n,90,0)
call UnitApplyTimedLife(n,'BTLF',4)
call UnitAddAbility(l__d,'A16C')
set soundplay=SndN(2470) // Sound\Music\mp3Music\ToumaUlt.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.1,true,function DragonBreathCast2)
set u=null
set l__d=null
set p=null
set t=null
endfunction
function DarkMoonCond takes nothing returns boolean
return GetSpellAbilityId()=='A16L' and udg_B==true
endfunction
function DarkMoonCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x2=LoadReal(h,id,2)
local real y2=LoadReal(h,id,3)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real a=Atan2(y2-y1,x2-x1)
local real a2
local real he=GetUnitFlyHeight(l__d)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroStr(u,true)*(GetUnitAbilityLevel(u,'A16L')+5)
if SR(x1,y1,x2,y2)>40.00 then
set x1=x1+30*Cos(a)
set y1=y1+30*Sin(a)
call SetUnitFlyHeight(l__d,he-90,0)
call SetUnitXY_1(l__d,x1,y1, false)
else
call UnitApplyTimedLife(CreateUnit(p,'e03H',x2,y2,0),'BTLF',5)
call UnitApplyTimedLife(CreateUnit(p,'e03I',x2,y2,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e03K',x2,y2,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e04B',x2,y2,0),'BTLF',3)
call GroupEnumUnitsInRange(DG,x1,y1,600,Base)
loop
set E=FirstOfGroup(DG)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(u, E, 1, "stun")
endif
call GroupRemoveUnit(DG,E)
endloop
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call RemoveUnit(l__d)
endif
set l__d=null
set p=null
set u=null
set t=null
endfunction
function DarkMoonCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local real r=GetRandomReal(0,6.28)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
set n=CreateUnit(GetOwningPlayer(u),0x65304545,x+1000*Cos(r),y+1000*Sin(r),GetRandomReal(0,359))
call UnitAddAbility(n,0x4131364B)
call SetUnitVertexColor(n,255,255,255,255)
call SaveUnitHandle(h,id,1,n)
call SetUnitFlyHeight(n,3000,0)
call SetUnitScale(n,10,10,10)
set n=CreateUnit(GetOwningPlayer(u),0x65305951,GetUnitX(u)+GetRandomReal(-200,200),GetUnitY(u)+GetRandomReal(-200,200),GetUnitFacing(u))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitAnimation(n,"spell")
set soundplay=SndN(2472) // Sound\Music\mp3Music\ToumaR.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.035,true,function DarkMoonCast2)
set u=null
set t=null
endfunction
function FaceBreakerCond takes nothing returns boolean
return GetSpellAbilityId()=='A16F'
endfunction
function FaceBreakerUltCast4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local integer idc=GetHandleId(c)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local boolean bPaused=false
local real damage=150+((1+GetUnitAbilityLevel(u,'A16F'))*GetHeroStr(u,true))*2
call SetUnitTimeScale(u,1)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call SetUnitPathing(u,true)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),'BTLF',1)
if GetHeroLevel(u)>34 then
set bPaused=false
if IsUnitPaused(c) then
    set bPaused=true
    call PauseUnit(c,false)
endif
call IssueImmediateOrder(c,"manashieldoff")
call IssueImmediateOrder(c,"unimmolation")
call UnitRemoveAbility(c,'A1GL')
call UnitRemoveAbility(c,'WAE1')
call UnitRemoveAbility(c,'A1WT')
call UnitRemoveBuffs(c,true,false)
if UnitHasItemOfTypeBJCustom(c, 'I03A') and GetWidgetLife(c)>0 and IsUnitIllusion(c)==false then
    set AlastorPos=0
    loop
    exitwhen AlastorPos==10 or GetItemTypeId(UnitItemInSlot(c,AlastorPos)) == 'I03A'
    set AlastorPos=AlastorPos+1
    endloop
    if IsAbilityEnabled(GetUnitAbility(c,'AInv'))==true then
        set Alastor=GetItemOfTypeFromUnitBJCustom(c,'I03A')
        call UnitRemoveItem(c,Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(c, 'I03A',AlastorPos)
    else
        call EnableUnitAbility2(c,'AInv',false,true)
        set Alastor=GetItemOfTypeFromUnitBJCustom(c,'I03A')
        call UnitRemoveItem(c,Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(c, 'I03A',AlastorPos)    
        call DisableUnitAbility2(c,'AInv',false,true)
    endif
endif
call UnitAddItemById(c,'I06B')
if LoadReal(h, idc, SH_ShieldBelfF)>0 then   // Щит Бельфегора
    call SaveReal(h, idc, SH_ShieldBelfF, 0)
else
    call SaveReal(h, idc, SH_ShieldBelfF, 0)
    call RemoveSavedReal(h, idc, SH_ShieldBelfF)
endif
if LoadReal(h, idc, SH_YujiE_Shield)>0 then  // Щит Юджи
    call SaveReal(h, idc, SH_YujiE_Shield, 0)
else
    call RemoveSavedReal(h, idc, SH_YujiE_Shield)
endif
if GetUnitAbilityLevel(c,'A1DF')>=1 then                  // Щит Шилдер Q
    call UnitRemoveAbility(c,'A1DF')
    call SaveReal(h,idc, SH_shi1, 0)
    call SaveReal(h,idc, SH_shi2, 0)
endif
if GetUnitAbilityLevel(c,'A1DG')>=1 then                  // Щит Шилдер E
    call UnitRemoveAbility(c, 'A1DG')
endif
if GetUnitAbilityLevel(c,'A10G')>=1 then                  // Щит Луизы
    call UnitRemoveAbility(c, 'A10G')
endif
if GetUnitAbilityLevel(c, 'A2DF')>0 then                      // Щит Броли
    call SaveReal(h,idc,SH_BroEtime,9)
endif
if GetUnitAbilityLevel(c, 'A0VJ')>0 then                  // Гроза Вонголы
    call UnitRemoveAbility(c, 'A0VJ')
endif
if GetUnitAbilityLevel(c, 'A1HG')>0 then                  // Щит Орехи
    call UnitRemoveAbility(c, 'A1HG')
endif
if GetUnitAbilityLevel(c, 'A3DF')>0 then                  // Щит Waver
    call UnitRemoveAbility(c, 'A3DF')
endif

if GetUnitAbilityLevel(c, 'A1H1')>=1 then                 // Щит от Ульты Жанны Рулер
    call UnitRemoveAbility(c, 'A1H1')
endif
if GetUnitAbilityLevel(c, 'A0VV')>=1 then                 // Броня бороса
    call UnitRemoveAbility(c, 'A0VV')
endif
if GetUnitAbilityLevel(c, 'A28W')>=1 then                 // Броня бороса
    call UnitRemoveAbility(c, 'A28W')
endif
if GetUnitAbilityLevel(c, 'AcF1')>=1 then                 // F Эйса
    call SaveBoolean(HH,idc,SST,false)
    call ShowAbility2('A315',false)
    call ShowAbility2('A015',true)
    call UnitRemoveAbility(c,'AcF1')
endif
if GetUnitAbilityLevel(c, 'ItV1')>=1 then                 // G itachi
    call SaveBoolean(HH,idc,SST,false)
    call ShowAbility2('A30C',false)
    call ShowAbility2('A00C',true)
    call UnitRemoveAbility(c,'ItV1')
endif
if GetUnitAbilityLevel(c, 'GaT1')>=1 then                 // T Gamma
    call SaveBoolean(HH,idc,SST,false)
    call ShowAbility2('A41C',false)
    call ShowAbility2('A0GV',true)
    call UnitRemoveAbility(c,'GaT1')
endif
if GetUnitAbilityLevel(c, 'MgT1')>=1 then                 // T Magnus
    call SaveBoolean(HH,idc,SST,false)
    call ShowAbility2('A42C',false)
    call ShowAbility2('A15C',true)
    call UnitRemoveAbility(c,'MgT1')
endif
if GetUnitAbilityLevel(c,'SiTS')>=1 then                 // Щит P Сигнум Tank Spirit
    call UnitRemoveAbility(c,'SiTS')
endif
if bPaused then
    call PauseUnit(c,true)
endif
endif
//if GetUnitAbilityLevel(c, 'Wome')>0 then
//    set damage = damage * 1.35
//endif
call myCustomDamage(u,c,damage,false,false,null,null,null)
call SetControlToUnit(u,c,2, "stun")
call PauseTimer(t)
call DestroyTimer(t)
call UnitRemoveAbility(u,'A0BX')
call SetUnitTimeScale(u,1)
call FlushChildHashtable(h,id)
set p=null
set u=null
set c=null
set t=null
endfunction
function FaceBreakerCast3 takes nothing returns nothing
