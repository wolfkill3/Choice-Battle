function DanzoW1Act takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local unit target=LoadUnitHandle(HH,id,2)
local real facing=Angle2(GetUnitX(caster),GetUnitY(caster),GetUnitX(target),GetUnitY(target))
local real time=LoadReal(HH,id,5)
set time=time+0.02
if time<0 then
    if LoadBoolean(HH,GetHandleId(caster),TARGET_ABILITY)==false then
        call SaveReal(HH,id,5,time)
    endif
else
    call SaveReal(HH,id,5,time)
endif
if time<0 then
if time==-2 or time==-1.5 or time==-1 or time==-0.5 then
call UnitCreateAndMove1(caster,'ds34',caster,GetRandomReal(0,360),1,GetRandomReal(0.8,1),GetRandomReal(0.5,0.75),0,0,0,GetRandomReal(70,90),0,caster,0,facing,0)
call UnitCreateAndMove(caster,'ds29',caster,GetRandomReal(0,360),1,GetRandomReal(1,1.5),GetRandomReal(0.5,0.75),0,0,0,40,0,caster,0,facing)
endif
if time==-2 then
call UnitCreateAndMove(caster,'ds33',caster,GetRandomReal(0,360),2,2,0.3,100,100,100,50,0,caster,0,facing)
call UnitSpeed(caster,1)
if LoadBoolean(HH,GetHandleId(caster),SH_DanzoFBool)==true then
call SetUnitAnimationByIndex(caster,26)
else
call SetUnitAnimationByIndex(caster,25)
endif
call SaveBoolean(HH,GetHandleId(caster),SH_DanzoWBool,true)
set soundplay=SndN(3616) // Sound\Music\mp3Music\DanzoW_Counter.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif

if time<-0.02 then

if LoadBoolean(HH,GetHandleId(caster),SH_DanzoWBool)==false then
call SaveBoolean(HH,GetHandleId(caster),ANTITARGET_ABILITY,false)
set target=LoadUnitHandle(HH,GetHandleId(caster),SH_DanzoW)
call SaveUnitHandle(HH,id,2,target)
set time=0.02
call SaveReal(HH,id,5,time)
set facing=Angle2(GetUnitX(caster),GetUnitY(caster),GetUnitX(target),GetUnitY(target))
call SaveReal(HH,id,3,facing)
call SetUnitFacing(caster,facing)
call SaveBoolean(HH,id,19,true)
endif

if LoadUnitHandle(HH,GetHandleId(caster),REVERSE_TARGET)!=null then
call SaveBoolean(HH,GetHandleId(caster),ANTITARGET_ABILITY,false)
set target=LoadUnitHandle(HH,GetHandleId(caster),REVERSE_TARGET)
call SaveUnitHandle(HH,id,2,target)
set time=0.02
call SaveReal(HH,id,5,time)
set facing=Angle2(GetUnitX(caster),GetUnitY(caster),GetUnitX(target),GetUnitY(target))
call SaveReal(HH,id,3,facing)
call SetUnitFacing(caster,facing)
call SaveBoolean(HH,id,19,true)
call RemoveSavedHandle(HH,GetHandleId(caster),REVERSE_TARGET)
endif

call PauseUnit(caster,true)
endif

if time==-0.02 then
if LoadBoolean(HH,GetHandleId(caster),ANTITARGET_ABILITY)==true then
    call SetControlToUnit(caster , caster , 0.5 , "doomdebug")
endif
call SaveBoolean(HH,GetHandleId(caster),ANTITARGET_ABILITY,false)
call SaveBoolean(HH,GetHandleId(caster),SH_DanzoWBool,false)
call PauseUnit(caster,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif

endif

if time>0 then

if time==20.34 then
    if LoadBoolean(HH,GetHandleId(target),ANTITARGET_ABILITY)==false then
        call UnitCreateAndMove(caster,'ds13',caster,GetRandomReal(0,360),1,8,0.4,100,100,100,0,100,target,0,facing)
        call UnitCreateAndMove(caster,'ds28',caster,GetRandomReal(0,360),1,0.3,0.3,100,100,100,30,100,target,0,facing)
        call UnitCreateAndMove(caster,'ds22',caster,facing,1,0.5,0.6,100,100,100,0,100,target,-50,facing)
        set soundplay=SndN(3619) // Sound\Music\mp3Music\DanzoW.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'DSW1',false)
        call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'DSW2',true)
        call ReturnW2Danzo(caster)
        call SetUnitPathing(caster,true)
        call PauseUnit(caster,false)
        call SetUnitInvulnerable(caster,false)
        call PauseUnit(target,false)
        call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)

        call myCustomDamage(caster,target,LoadReal(HH,id,15),false,false,null,null,null)
        call SaveUnitHandle(HH,GetHandleId(caster),SH_DanzoW,target)

        if LoadBoolean(HH,id,19)==false then
            call SetControlToUnit(caster,target, 2, "stun")
        endif

        if LoadEffectHandle(HH,id,21)!=null then
        call DestroyEffect(LoadEffectHandle(HH,id,21))
        call SaveEffectHandle(HH,id,21,null)
        endif
        if LoadEffectHandle(HH,id,22)!=null then
        call DestroyEffect(LoadEffectHandle(HH,id,22))
        call SaveEffectHandle(HH,id,22,null)
        endif
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(HH,id)
    else
        call SaveUnitHandle(HH,GetHandleId(target),REVERSE_TARGET,caster)
        call SetUnitPathing(caster,true)
        call PauseUnit(caster,false)
        call SetUnitInvulnerable(caster,false)
        call PauseUnit(target,false)
        call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
        if LoadEffectHandle(HH,id,21)!=null then
        call DestroyEffect(LoadEffectHandle(HH,id,21))
        call SaveEffectHandle(HH,id,21,null)
        endif
        if LoadEffectHandle(HH,id,22)!=null then
        call DestroyEffect(LoadEffectHandle(HH,id,22))
        call SaveEffectHandle(HH,id,22,null)
        endif
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(HH,id)
    endif
else

call SetUnitPathing(caster,false)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)

if time==0.02 then
call UnitCreateAndMove(caster,'ds21',caster,facing,1,1,0.6,100,100,100,0,0,caster,0,facing)
call UnitCreateAndMove(caster,'ds23',caster,facing,1,0.75,0.8,100,100,100,0,50,caster,0,facing)
call UnitCreateAndMove(caster,'ds24',caster,facing,1,0.75,0.8,100,100,100,0,50,caster,0,facing)
set soundplay=SndN(3622) // Sound\Music\mp3Music\DanzoW_Start.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SaveEffectHandle(HH,id,21,AddSpecialEffectTarget("Danzo\\file00002360.mdl",caster,"hand Right"))
call SaveEffectHandle(HH,id,22,AddSpecialEffectTarget("Danzo\\file00002360.mdl",caster,"hand left"))
call UnitSpeed(caster,1)

if LoadBoolean(HH,GetHandleId(caster),SH_DanzoFBool)==true then
call SetUnitAnimationByIndex(caster,15)
else
call SetUnitAnimationByIndex(caster,6)
endif
endif

if time<20 then
set facing=Angle2(GetUnitX(caster),GetUnitY(caster),GetUnitX(target),GetUnitY(target))
call SaveReal(HH,id,3,facing)

if SR(GetUnitX(caster),GetUnitY(caster),GetUnitX(target),GetUnitY(target))>400 then
call MoveUnit(caster,caster,40,facing)
else
call PauseUnit(target,true)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
set time=20
call SetUnitAnimationByIndex(caster,20)
call UnitSpeed(caster,1)

if LoadBoolean(HH,GetHandleId(caster),SH_DanzoFBool)==true then
call SetUnitAnimationByIndex(caster,19)
else
call SetUnitAnimationByIndex(caster,20)
endif

call SaveReal(HH,id,5,time)
endif

endif

if time>20 and time<20.14 then

if SR(GetUnitX(caster),GetUnitY(caster),GetUnitX(target),GetUnitY(target))>120 then
call MoveUnit(caster,caster,40,facing)
endif

endif

if time>20.14 then
call PauseUnit(target,true)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
endif

endif
endif
set t=null
set target=null
set caster=null
endfunction

function DanzoEBullets1 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real distance=LoadReal(HH,id,8)
local real time=LoadReal(HH,id,5)
set time=time+0.02
call SaveReal(HH,id,5,time)
if distance>=2000 then
if LoadGroupHandle(HH,id,4)!=null then
call DestroyGroup(LoadGroupHandle(HH,id,4))
call SaveGroupHandle(HH,id,4,null)
endif
call SetUnitAnimationByIndex(LoadUnitHandle(HH,id,20),2)
call UnitColor(LoadUnitHandle(HH,id,20),0,0,0,100)
call MyRemoveUnit(LoadUnitHandle(HH,id,20),2)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
else
call MoveUnit(LoadUnitHandle(HH,id,20),LoadUnitHandle(HH,id,20),LoadReal(HH,id,9),facing)
call DamageAoeOneTimeDanzoE(caster,GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),100,LoadReal(HH,id,15),LoadGroupHandle(HH,id,4))
call SaveReal(HH,id,8,distance+LoadReal(HH,id,9))
endif
set caster=null
set t=null
endfunction
function DanzoEBullets takes unit caster1,real facing0,real damage0 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real randomspeed=GetRandomReal(40,80)
call SaveUnitHandle(HH,id,1,caster1)
call SaveReal(HH,id,3,facing0)
call SaveGroupHandle(HH,id,4,CreateGroup())
call SaveReal(HH,id,15,damage0)
set n0=CreateUnit(GetOwningPlayer(caster1),0x64733037,GetUnitX(caster1),GetUnitY(caster1),facing0)
call UnitSize(n0,0.35,1,1)
call SetUnitZ(n0,GetUnitZCustom(caster1)+100)
call MoveUnit(n0,n0,100,facing0)
call UnitSpeed(n0,0.5+randomspeed*0.0125)
call SaveReal(HH,id,9,randomspeed)
call SetUnitAnimationByIndex(n0,1)
call SaveUnitHandle(HH,id,20,n0)
call UnitCreateAndMove(caster1,'ds43',caster1,facing0+180,0.3,0.2,1,100,100,100,0,150,caster1,100,GetUnitFacing(caster1))
set n0=null
call TimerStart(t,0.02,true,function DanzoEBullets1)
set caster1=null
set t=null
endfunction
function DanzoEAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real time1=0
local real damage=LoadReal(HH,id,15)
set time=time+0.02
call SaveReal(HH,id,5,time)
if time>=3.5 then
call UnitSpeed(caster,1)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
else
call SetUnitFacing(caster,facing)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
if time==0.02 then
call UnitCreateAndMove(caster,'ds36',caster,facing,0.65,0.5,1.5,100,100,100,0,100,caster,100,facing)
call UnitCreateAndMove(caster,'ds32',caster,GetRandomReal(0,360),1,2,0.5,100,100,100,0,0,caster,0,facing)
call UnitCreateAndMove(caster,'ds29',caster,GetRandomReal(0,360),1,0.85,0.75,100,100,100,30,0,caster,0,facing)
if GetRandomInt(1,2)==1 and GetHeroLevel(caster)>12 then
call DanzoGPassive(caster,facing,GetHeroInt(caster,true)*2)
endif
call UnitSpeed(caster,1.5)
if LoadBoolean(HH,GetHandleId(caster),SH_DanzoFBool)==true then
call SetUnitAnimationByIndex(caster,23)
else
call SetUnitAnimationByIndex(caster,17)
endif
endif
if time==0.4 then
call UnitSpeed(caster,0)
endif
if time>0.4 then
set time1=LoadReal(HH,id,6)
set time1=time1+0.02
if time1==0.1 or time1==0.2 or time1==0.3 then
call DanzoEBullets(caster,facing+GetRandomInt(-15,15),LoadReal(HH,id,15)*0.05)
endif
if time1==0.3 then
set time1=0
call UnitCreateAndMove(caster,'ds24',caster,GetRandomReal(0,360),1,0.75,0.5,100,100,100,30,0,caster,0,facing)
endif


call SaveReal(HH,id,6,time1)
endif
endif
set t=null
set caster=null
endfunction


function DanzoRAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local unit Dummy=LoadUnitHandle(HH,id,20)
local real x0=LoadReal(HH,id,11)
local real y0=LoadReal(HH,id,12)
local real x1=GetUnitX(Dummy)
local real y1=GetUnitY(Dummy)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real damage=LoadReal(HH,id,15)
local real distance
set time=time+0.02
set distance=LoadReal(HH,id,8)
call SaveReal(HH,id,5,time)
if distance==500 then
call UnitCreateAndMove(caster,0x64733337,caster,facing,1,4,0.6,100,100,100,60,200,Dummy,0,facing)
call UnitCreateAndMove(caster,0x64733335,caster,facing,1,8,0.6,100,100,100,30,200,Dummy,0,facing)
call UnitCreateAndMove(caster,'ds26',caster,facing,1,2,0.9,100,100,100,30,50,Dummy,0,facing)
call UnitCreateAndMove(caster,0x64733338,caster,facing,1,2,0.4,100,100,100,0,200,Dummy,0,facing)
call GroupClear(G)
call GroupEnumUnitsInRange(G,x1,y1,500,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if Condition_Base(GetOwningPlayer(caster),n0) then
if GetUnitAbilityLevel(n0,'DST2')>0 then
set damage=damage*1.3
endif


call myCustomDamage(caster,n0,damage,false,false,null,null,null)


set facing=facing+0.2*Angle2(x1,y1,GetUnitX(n0),GetUnitY(n0))
call PushTimed(n0,facing,50,10)
call SetControlToUnit(caster,n0, 2, "stun")
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
call SetUnitAnimationByIndex(Dummy,1)
call MyRemoveUnit(Dummy,3)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
else
if time==0.02 or time==0.4 or time==0.8 then
call UnitCreateAndMove(caster,'ds30',caster,GetRandomReal(0,360),1,1,0.75,100,100,100,40,0,caster,0,facing)
call UnitCreateAndMove(caster,'ds24',caster,GetRandomReal(0,360),1,0.5,0.75,100,100,100,10,0,caster,0,facing)
endif
if time==0.02 then
call UnitCreateAndMove(caster,'ds36',caster,facing,0.65,0.75,1.5,100,100,100,0,100,caster,100,facing)
if GetRandomInt(1,2)==1 and GetHeroLevel(caster)>12 then
call DanzoGPassive(caster,facing,GetHeroInt(caster,true)*2)
endif
call UnitSpeed(caster,0.5)
if LoadBoolean(HH,GetHandleId(caster),SH_DanzoFBool)==true then
call SetUnitAnimationByIndex(caster,13)
else
call SetUnitAnimationByIndex(caster,24)
endif
endif
if time<1 then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
endif
if time==1 then
call UnitSpeed(caster,1)
call UnitCreateAndMove(caster,'ds22',caster,facing,1,0.35,0.5,100,100,100,0,100,caster,100,facing)
set soundplay=SndN(3625) // Sound\Music\mp3Music\DanzoRHit.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
endif
if time==0.5 then
set n0=CreateUnit(GetOwningPlayer(caster),0x64733036,GetUnitX(caster),GetUnitY(caster),facing)
call UnitSize(n0,0.2,1,1)
call MoveUnit(n0,n0,200,facing)
call SetUnitFlyHeight(n0,200,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=null
endif
if time>0.5 and time<1 then
call UnitSize(Dummy,0.2+(time-0.5)*1.5,1,1)
call GroupClear(G)
call GroupEnumUnitsInRange(G,x1,y1,200+(time-0.5)*300,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if SR(GetUnitX(n0),GetUnitY(n0),x1,y1)>50 and Condition_Base(GetOwningPlayer(caster),n0) then
call MoveUnit(n0,n0,10,Angle2(GetUnitX(n0),GetUnitY(n0),x1,y1))
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
endif
if time>1 then
call UnitSize(Dummy,0.2+(time-0.5)*1.5,1,1)
call MoveUnit(Dummy,Dummy,20,facing)
call SaveReal(HH,id,8,distance+20)
call GroupClear(G)
call GroupEnumUnitsInRange(G,x1,y1,350,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if SR(GetUnitX(n0),GetUnitY(n0),x1,y1)>50 and Condition_Base(GetOwningPlayer(caster),n0) then
call MoveUnit(n0,n0,20,Angle2(GetUnitX(n0),GetUnitY(n0),x1,y1))
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
endif
endif
set t=null
set Dummy=null
set caster=null
endfunction

function DanzoTClearDebuff takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local real x0=LoadReal(HH,id,11)
local real y0=LoadReal(HH,id,12)
local real time=LoadReal(HH,id,5)
if time<7.05 then

// замедление — раз в 0.25 с на 0.275 с (то же соотношение, что 0.055 на тик 0.05): общая система контроля в 5 раз реже
if ModuloInteger(R2I(time/0.05+0.5),5)==0 then
call SlowUnit(GetEnumUnit(),GetEnumUnit(),0.5,0.5,0.275,2,false)
endif

if SR(GetUnitX( GetEnumUnit() ),GetUnitY( GetEnumUnit() ),x0,y0)>150 then
call MoveUnit( GetEnumUnit() , GetEnumUnit() ,30+2000/SR(GetUnitX( GetEnumUnit() ),GetUnitY( GetEnumUnit() ),x0,y0),Angle2(GetUnitX( GetEnumUnit() ),GetUnitY( GetEnumUnit() ),x0,y0))
endif

endif

if time==7.05 or SR(GetUnitX(GetEnumUnit()),GetUnitY(GetEnumUnit()),x0,y0)>800 then
call GroupRemoveUnit(LoadGroupHandle(HH,id,4), GetEnumUnit() )
endif

set t=null
endfunction

