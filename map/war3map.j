set gg_trg_Torikago=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Torikago,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_Torikago,Condition(function TorikagoCond))
call TriggerAddAction(gg_trg_Torikago,function TorikagoCast)
endfunction
