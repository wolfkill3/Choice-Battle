    call SetFrameTextColour( HoverHeroIdIconText, ConvertColour(255,255,255,255) )
    call SetFrameParent( HoverHeroIdIconText, HoverHeroIdIcon )
    call SetFrameText( HoverHeroIdIconText, GetUnitBaseStringFieldById(RH_Force[x],UNIT_SF_PROPER_NAME)+", \n"+GetUnitBaseStringFieldById(RH_Force[x],UNIT_SF_NAME)+", "+I2S(x))
    call ShowFrame( HoverHeroIdIconText, true )
