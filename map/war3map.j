function HealRuler2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real per=LoadReal(h,id,3)
local integer i=LoadInteger(h,id,3)
if GetUnitAbilityLevel(c,'A1H1')>0 then
call HealTextTag(u,c,GetUnitState(c,UNIT_STATE_MAX_LIFE)*0.004*myCustomHeal2(c,1),"HealthRes")
call SetUnitState(c,UNIT_STATE_LIFE,GetWidgetLife(c)+GetUnitState(c,UNIT_STATE_MAX_LIFE)*0.004)
else
call SaveInteger(h,id,3,i+1)
if i>per then
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
endif
set u=null
set c=null
set t=null
endfunction
