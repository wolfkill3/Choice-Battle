function GetRandomUnitFromGroupDeath takes group g returns unit
local real l__s=GetRandomReal(-10,10)
local real l=0
local real lm=0
local group g2
if CountUnitsInGroup(g)>1 then
set g2=CopyGroup(g)
loop
set E=FirstOfGroup(g2)
set lm=GetUnitState(E,UNIT_STATE_LIFE)/GetUnitState(E,UNIT_STATE_MAX_LIFE)*100
exitwhen E==null
if lm+l__s>l then
set l=lm
set n10=E
endif
call GroupRemoveUnit(g2,E)
endloop
call DestroyGroupTimed(g2,3)
else
set n10=FirstOfGroup(g)
endif
set g2=null
return n10
endfunction
function AI2DeathAct takes nothing returns nothing
local integer i=GetRandomInt(1,3)
local real x=GetUnitX(ks)
local real y=GetUnitY(ks)
local real x1=0
local real y1=0
local real a=0
call GroupEnumUnitsInRange(G,x,y,1450,Base)
set E=GetRandomUnitFromGroupDeath(G)
if E!=null then
set x1=GetUnitX(E)
set y1=GetUnitY(E)
endif
if i==1 and E!=null then
call IssuePointOrder(ks,"frenzy",x1,y1)
elseif i==2 and E!=null then
call IssuePointOrder(ks,"heal",x1,y1)
elseif i==3 then
call GroupEnumUnitsInRange(G,x,y,650,Base)
if CountUnitsInGroup(G)>=2 then
call IssueImmediateOrder(ks,"mount")
endif
endif
endfunction
