call BlzFrameSetSize(ShUseBtn[i],0.022,0.022)
call Sh_NoHi(ShUseBtn[i])
set ShUseRim[i]=BlzCreateFrameByType("BACKDROP","ShUseRim",ShUseBtn[i],"",0)
call BlzFrameSetAllPoints(ShUseRim[i],ShUseBtn[i])
