set soundplay=CreateSound("Sound\\Music\\mp3Music\\Whitebeard3.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.02,true,function KabutowariCast2)
set u=null
set t=null
set c=null
endfunction
