function SabracRWAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit casterOriginal=LoadUnitHandle(HH,id,30)
local real x0=LoadReal(HH,id,11)
local real y0=LoadReal(HH,id,12)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real time1=0
local real dist=LoadReal(HH,id,8)
local real damage=LoadReal(HH,id,15)*0.1
local real aoe=LoadReal(HH,id,16)
local integer swordcount=R2I(aoe*0.01)
set time=time+0.02
call SaveReal(HH,id,5,time)
if time==0.08 then
call EffectCreateAndMove(true,"Sabrac\\HakkeStart2.mdl",facing,1.92,aoe*0.0023,0.52,100,100,100,60,0,caster,300,facing)
endif
if time==0.12 then
call EffectCreateAndMove(true,"Sabrac\\HakkeStart2.mdl",facing,1.88,aoe*0.0023,0.55,100,100,100,60,0,caster,600,facing)
endif
if time==0.16 then
call EffectCreateAndMove(true,"Sabrac\\HakkeStart2.mdl",facing,1.84,aoe*0.0023,0.57,100,100,100,60,0,caster,900,facing)
endif
if time==0.2 then
call EffectCreateAndMove(true,"Sabrac\\HakkeStart2.mdl",facing,1.8,aoe*0.0023,0.59,100,100,100,60,0,caster,1200,facing)
endif
if time==0.24 then
call EffectCreateAndMove(true,"Sabrac\\HakkeStart2.mdl",facing,1.76,aoe*0.0023,0.61,100,100,100,60,0,caster,1500,facing)
endif
if time==0.28 and dist>=2100 then
call EffectCreateAndMove(true,"Sabrac\\HakkeStart2.mdl",facing,1.72,aoe*0.0023,0.63,100,100,100,60,0,caster,1800,facing)
endif
if time==0.32 and dist>=2400 then
call EffectCreateAndMove(true,"Sabrac\\HakkeStart2.mdl",facing,1.68,aoe*0.0023,0.65,100,100,100,60,0,caster,2100,facing)
endif
if time==0.36 and dist>=2700 then
call EffectCreateAndMove(true,"Sabrac\\HakkeStart2.mdl",facing,1.64,aoe*0.0023,0.67,100,100,100,60,0,caster,2400,facing)
endif
if time==0.4 and dist>=3000 then
call EffectCreateAndMove(true,"Sabrac\\HakkeStart2.mdl",facing,1.6,aoe*0.0023,0.69,100,100,100,60,0,caster,2700,facing)
endif
if time==0.02 then
call EffectCreateAndMove(true,"Sabrac\\3ydj_1.mdl",facing,2,aoe*0.004,0.7,100,100,100,80,75,caster,0,facing)
call EffectCreateAndMove(true,"Sabrac\\3ydj_1.mdl",facing,2,aoe*0.002,0.7,100,100,100,80,75,caster,0,facing)
call EffectCreateAndMove(true,"Sabrac\\HakkeStart2.mdl",facing,2,aoe*0.0023,0.5,100,100,100,60,0,caster,0,facing)
call SaveGroupHandle(HH,id,4,CreateGroup())
call UnitSpeed(caster,1)
endif
if time<=2.02 then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
set time1=LoadReal(HH,id,6)
set time1=time1-0.02
if time1==0 or time1==0.1 then
if swordcount>5 then
set swordcount=5
endif
if swordcount>0 then
loop
call SabracRWFlySwords(caster,aoe,2-time,dist,facing)
set swordcount=swordcount-1
exitwhen swordcount==0
endloop
endif
endif



if time1==0.18 or time1==0.14 or time1==0.1 or time1==0.06 or time1==0.02 then
call StopAoeOneTime1(caster,x0,y0,aoe)
if time>0.08 then
call StopAoeOneTime1(caster, PolX(x0,350,facing) , PolY(y0,350,facing) ,aoe)
endif
if time>0.12 then
call StopAoeOneTime1(caster, PolX(x0,700,facing) , PolY(y0,700,facing) ,aoe)
endif
