local real is=0
local real ig=30*bj_DEGTORAD
call SaveUnitHandle(HH,id,0,u)
call SetUnitInvulnerable(u,true)
call SetUnitTimeScale(u,0.4)
call SetWidgetMana(u, GetWidgetMana(u)-GetWidgetMaxMana(u)*LoadInteger(HH,idu,ComboCounterHash)*0.005)
if GetUnitAbilityLevel(u,'A34Z')>0 and LoadUnitHandle(HH,idp,SH_EW)!=null and IsUnitInvulnerable(LoadUnitHandle(HH,idp,SH_EW))==false then
    set c=LoadUnitHandle(HH,idp,SH_EW)
    if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
        set x1=GetUnitX(c)
        set y1=GetUnitY(c)
        set a=Atan2(y1-y,x1-x)
        call SaveReal(HH,id,5,a)
        call ComboBar(u,0)
        call PauseUnit(u,true)
        call PauseUnit(c,true)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
        call SetUnitInvulnerable(u,true)
        call SetUnitAnimation(u,"spell four")
        call UnitAddAbility(u,'Arav')
        call UnitRemoveAbility(u,'Arav')
        call SetUnitTimeScale(LoadUnitHandle(HH,idp,ComboBarHash),100000)
        if LoadInteger(HH,idu,ComboCounterHash)>5 and LoadInteger(HH,idu,ComboCounterHash)<8 then
            call SetUnitColor(LoadUnitHandle(HH,idp,ComboBarHash),PLAYER_COLOR_PURPLE)
        elseif LoadInteger(HH,idu,ComboCounterHash)>7 then
            call SetUnitColor(LoadUnitHandle(HH,idp,ComboBarHash),PLAYER_COLOR_RED)
            if LoadUnitHandle(HH,idu,SH_CST)==null then
                call SaveUnitHandle(HH,idu,SH_CST,CreateUnit(p,'h06A',x,y,0))
            endif
        endif
        call SaveUnitHandle(HH,id,0,u)
        call SaveUnitHandle(HH,id,1,c)
        call UnitAddAbility(c,'Arav')
        call UnitRemoveAbility(c,'Arav')
        set soundplay=SndN(2630) // sound\Music\mp3Music\NanayaWR.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        if GetAbilityRemainingCooldown(GetUnitAbility(u,'A1BP'))>8.1 then
            call StartAbilityCooldown(GetUnitAbility(u, 'A1BP'), GetAbilityRemainingCooldown(GetUnitAbility(u,'A1BP'))-8)
            call StartAbilityCooldown(GetUnitAbility(u, 'A1BQ'), GetAbilityRemainingCooldown(GetUnitAbility(u,'A1BQ'))-8)
            call StartAbilityCooldown(GetUnitAbility(u, 'A1BR'), GetAbilityRemainingCooldown(GetUnitAbility(u,'A1BR'))-8)
        else
            call StartAbilityCooldown(GetUnitAbility(u, 'A1BP'), 0.1)
            call StartAbilityCooldown(GetUnitAbility(u, 'A1BQ'), 0.1)
            call StartAbilityCooldown(GetUnitAbility(u, 'A1BR'), 0.1)
        endif
        call TimerStart(t,0.2,false,function RShikiWCast2)
    else
        call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
        call SaveReal(HH,idu,ComboTimerHash,0)
        call SaveInteger(HH,idu,ComboCounterHash,0)
        call UnitRemoveAbility(u,'A1BI')
        call SetUnitInvulnerable(u,false)
        call SetUnitTimeScale(u,1)
        call PauseUnit(u,false)
        call DestroyTimer(t)
        call FlushChildHashtable(HH,id)
    endif
else
    set n=CreateUnit(p,'e116',x,y,GetRandomReal(0,359))
    call SetUnitVertexColor(n,155,75,255,GetRandomInt(50,255))
    set sc=GetRandomReal(0.5,3)
    call SetUnitScale(n,sc,sc,sc)
    call UnitApplyTimedLife(n,'BTLF',0.7)
    call SetUnitTimeScale(n,2.5)
    set n=CreateUnit(p,'e116',x,y,GetRandomReal(0,359))
    call SetUnitVertexColor(n,155,75,255,GetRandomInt(50,255))
    set sc=GetRandomReal(0.5,3)
    call SetUnitScale(n,sc,sc,sc)
    call UnitApplyTimedLife(n,'BTLF',0.7)
    call SetUnitTimeScale(n,2.5)
    set n=CreateUnit(p,'e116',x,y,GetRandomReal(0,359))
    call SetUnitVertexColor(n,155,75,255,GetRandomInt(50,255))
    set sc=GetRandomReal(0.5,3)
    call SetUnitScale(n,sc,sc,sc)
    call UnitApplyTimedLife(n,'BTLF',0.7)
    call SetUnitTimeScale(n,2.5)
    set n=CreateUnit(p,'e116',x,y,GetRandomReal(0,359))
    call SetUnitVertexColor(n,155,75,255,GetRandomInt(50,255))
    set sc=GetRandomReal(0.5,3)
    call SetUnitScale(n,sc,sc,sc)
    call UnitApplyTimedLife(n,'BTLF',0.7)
    call SetUnitTimeScale(n,2.5)
    loop
    exitwhen is>=13
        set n=CreateUnit(p,'e0ZH',x+400*Cos(ig*is),y+400*Sin(ig*is),180+is*30)
        call SetUnitVertexColor(n,255,255,255,35)
        call UnitApplyTimedLife(n,'BTLF',1)
        call SetUnitTimeScale(n,1)
        set is=is+1
    endloop
    set n=CreateUnit(p,'e0RV',x,y,0)
    call UnitApplyTimedLife(n,'BTLF',2)
    call SetUnitTimeScale(n,1.2)
    call SetUnitVertexColor(n,255,255,255,100)
    if LoadUnitHandle(HH,idu,SH_Q3)==null then
        call GroupEnumUnitsInRange(G,x,y,1500,Base)
        loop
            set E=FirstOfGroup(G)
            call GroupRemoveUnit(G,E)
            exitwhen E==null
            if Condition_Base(p,E) and IsUnitInvulnerable(E)==false and GetUnitFlyHeight(E)>150 then
                call GroupClear(G)
                set c=E
                if GetAbilityRemainingCooldown(GetUnitAbility(u,'A1BP'))>8.1 then
                    call StartAbilityCooldown(GetUnitAbility(u, 'A1BP'), GetAbilityRemainingCooldown(GetUnitAbility(u,'A1BP'))-8)
                    call StartAbilityCooldown(GetUnitAbility(u, 'A1BQ'), GetAbilityRemainingCooldown(GetUnitAbility(u,'A1BQ'))-8)
                    call StartAbilityCooldown(GetUnitAbility(u, 'A1BR'), GetAbilityRemainingCooldown(GetUnitAbility(u,'A1BR'))-8)
                else
                    call StartAbilityCooldown(GetUnitAbility(u, 'A1BP'), 0.1)
                    call StartAbilityCooldown(GetUnitAbility(u, 'A1BQ'), 0.1)
                    call StartAbilityCooldown(GetUnitAbility(u, 'A1BR'), 0.1)
                endif
                call SaveUnitHandle(HH,id,1,c)
                call SaveReal(HH,id,2,GetUnitFlyHeight(E)+100)
            endif
        endloop
        if LoadInteger(HH,idu,ComboCounterHash)>0 and c!=null then
            call SaveReal(HH,idu,ComboTimerHash,2)
            call SaveInteger(HH,idu,ComboCounterHash,LoadInteger(HH,idu,ComboCounterHash)+1)
            if LoadInteger(HH,idu,ComboCounterHash)>5 and GetUnitAbilityLevel(u,'A1BN')==0 then
                call SetPlayerAbilityAvailable(p,'A1BU',false)
                call SetPlayerAbilityAvailable(p,'A1BV',true)
            endif
            if LoadInteger(HH,idu,ComboCounterHash)>2 then
                call SetAbilityIntegerLevelField(GetUnitAbility(u,'A1BZ'), ABILITY_ILF_TARGET_TYPE,0,1)
                call SetAbilityRealLevelField(GetUnitAbility(u,'A1BZ'), ABILITY_RLF_CAST_RANGE,0,1400)
            endif
        endif
        call PauseUnit(u,true)
        call SetUnitAnimation(u,"spell slam two")
        if c!=null then
            call UnitAddAbility(u,'Arav')
            call UnitRemoveAbility(u,'Arav')
            call UnitAddAbility(u,'A195')
            call UnitAddAbility(c,'A1BL')
            call SetPlayerAbilityAvailable(p,'A1BX',false)
            call SetPlayerAbilityAvailable(p,'A1BY',true)
            call SetUnitTimeScale(LoadUnitHandle(HH,idp,ComboBarHash),100000)
            if LoadInteger(HH,idu,ComboCounterHash)>5 and LoadInteger(HH,idu,ComboCounterHash)<8 then
                call SetUnitColor(LoadUnitHandle(HH,idp,ComboBarHash),PLAYER_COLOR_PURPLE)
            elseif LoadInteger(HH,idu,ComboCounterHash)>7 then
                call SetUnitColor(LoadUnitHandle(HH,idp,ComboBarHash),PLAYER_COLOR_RED)
                if LoadUnitHandle(HH,idu,SH_CST)==null then
                    call SaveUnitHandle(HH,idu,SH_CST,CreateUnit(p,'h06A',x,y,0))
                endif
            endif
            call ComboBar(u,0)
            call TimerStart(t,0.2,false,function RShikiOneCast2)
        else
            call SaveReal(HH,idu,ComboTimerHash,0)
            call SaveInteger(HH,idu,ComboCounterHash,0)
            call UnitRemoveAbility(u,'A1BI')
            call SetUnitInvulnerable(u,false)
            call SetUnitTimeScale(u,1)
            call PauseUnit(u,false)
            call DestroyTimer(t)
            call FlushChildHashtable(HH,id)
        endif
        set soundplay=SndN(2624) // Sound\Music\mp3Music\NanayaE2.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    else
        if GetAbilityRemainingCooldown(GetUnitAbility(u,'A1BP'))>8 then
            call StartAbilityCooldown(GetUnitAbility(u, 'A1BP'), GetAbilityRemainingCooldown(GetUnitAbility(u,'A1BP'))-8)
            call StartAbilityCooldown(GetUnitAbility(u, 'A1BQ'), 0.1)
            call StartAbilityCooldown(GetUnitAbility(u, 'A1BR'), 0.1)
        else
            call StartAbilityCooldown(GetUnitAbility(u, 'A1BP'), 0.1)
            call StartAbilityCooldown(GetUnitAbility(u, 'A1BQ'), 0.1)
            call StartAbilityCooldown(GetUnitAbility(u, 'A1BR'), 0.1)
        endif
        set c=LoadUnitHandle(HH,idu,SH_Q3)
        set x1=GetUnitX(c)
        set y1=GetUnitY(c)
        set a=Atan2(y1-y,x1-x)
        call SaveReal(HH,id,5,a)
        call ComboBar(u,0)
        if LoadInteger(HH,idu,ComboCounterHash)>0 and c!=null then
            call SaveReal(HH,idu,ComboTimerHash,2)
            call SaveInteger(HH,idu,ComboCounterHash,LoadInteger(HH,idu,ComboCounterHash)+1)
            if LoadInteger(HH,idu,ComboCounterHash)>5 and GetUnitAbilityLevel(u,'A1BN')==0 then
                call SetPlayerAbilityAvailable(p,'A1BU',false)
                call SetPlayerAbilityAvailable(p,'A1BV',true)
            endif
            if LoadInteger(HH,idu,ComboCounterHash)>2 then
                call SetAbilityIntegerLevelField(GetUnitAbility(u,'A1BZ'), ABILITY_ILF_TARGET_TYPE,0,1)
                call SetAbilityRealLevelField(GetUnitAbility(u,'A1BZ'), ABILITY_RLF_CAST_RANGE,0,1400)
            endif
        endif
        call PauseUnit(u,true)
        call SetUnitAnimation(u,"spell slam two")
        call UnitAddAbility(u,'Arav')
        call UnitRemoveAbility(u,'Arav')
        call UnitAddAbility(u,'A202')
        call UnitAddAbility(c,'A1BL')
        call SetUnitTimeScale(LoadUnitHandle(HH,idp,ComboBarHash),100000)
        if LoadInteger(HH,idu,ComboCounterHash)>5 and LoadInteger(HH,idu,ComboCounterHash)<8 then
            call SetUnitColor(LoadUnitHandle(HH,idp,ComboBarHash),PLAYER_COLOR_PURPLE)
        elseif LoadInteger(HH,idu,ComboCounterHash)>7 then
            call SetUnitColor(LoadUnitHandle(HH,idp,ComboBarHash),PLAYER_COLOR_RED)
            if LoadUnitHandle(HH,idu,SH_CST)==null then
                call SaveUnitHandle(HH,idu,SH_CST,CreateUnit(p,'h06A',x,y,0))
            endif
        endif
        call SaveUnitHandle(HH,id,0,u)
        call SaveUnitHandle(HH,id,1,c)
        call TimerStart(t,0.5,false,function RShikiAlterCast2)
    endif
endif
set c=null
set u=null
set p=null
set t=null
endfunction
function InitTrig_RShikiOne takes nothing returns nothing
set gg_trg_RShikiOne=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_RShikiOne,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_RShikiOne,Condition(function RShikiOneCond))
call TriggerAddAction(gg_trg_RShikiOne,function RShikiOneCast)
endfunction
function RShikiTwoCond takes nothing returns boolean
return GetSpellAbilityId()=='A1BY'
endfunction
function RShikiTwoCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit c=LoadUnitHandle(HH,id,1)
local integer idu=GetHandleId(u)
local real x=GetUnitX(c)
local real y=GetUnitY(c)
local real x1=0
local real y1=0
local real a=LoadReal(HH,id,8)
local real ge=LoadReal(HH,id,6)
local real dist=LoadReal(HH,id,7)
local real sc=0
local player p=GetOwningPlayer(u)
if dist>30 and GetUnitAbilityLevel(u,'A1BK')==0 then
if GetUnitAbilityLevel(c,'A1BJ')==0 then
set x=x+4*Cos(a)
set y=y+4*Sin(a)
call SetUnitXY_1(c,x,y, false)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
//call SetUnitInvulnerable(c,c, true)
call IssueImmediateOrder(c,"stop")
call SaveReal(HH,id,6,ge+1.25)
call SaveReal(HH,id,7,dist-5-ge)
call SetUnitFlyHeight(c,dist,0)
endif
else
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
//call SetUnitInvulnerable(c,c, false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
if GetUnitAbilityLevel(u,'A1BK')==0 and GetUnitAbilityLevel(c,'A1BL')==0 then
call SetUnitFlyHeight(c,0,0)
call UnitRemoveAbility(u,'A1BI')
endif
endif
set c=null
set u=null
set p=null
set t=null
endfunction
function RShikiTwoCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit c=LoadUnitHandle(HH,id,1)
local integer idu=GetHandleId(u)
local real x=GetUnitX(c)
local real y=GetUnitY(c)
local real x1=0
local real y1=0
local real ge=LoadReal(HH,id,6)
local real a=LoadReal(HH,id,8)
local real dist=LoadReal(HH,id,7)+25-ge
local integer fe=LoadInteger(HH,id,4)
local real sc=0
local player p=GetOwningPlayer(u)
if dist<550 then
if GetUnitAbilityLevel(c,'A1BJ')==0 then
set x=x+2*Cos(a)
set y=y+2*Sin(a)
call SetUnitXY_1(c,x,y, false)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
//call SetUnitInvulnerable(c,c, true)
call IssueImmediateOrder(c,"stop")
call SetUnitFlyHeight(c,dist,0)
call SaveReal(HH,id,6,ge+0.55)
call SaveReal(HH,id,7,dist)
endif
if dist>60 and fe==0 then
call SaveInteger(HH,id,4,1)
call PauseUnit(u,false)
call SetUnitX(u,GetUnitX(u)-40*Cos(a))
call SetUnitY(u,GetUnitY(u)-40*Sin(a))
endif
else
call SaveReal(HH,id,6,0)
call PauseTimer(t)
call TimerStart(t,0.02,true,function RShikiTwoCast3)
endif
set c=null
set u=null
set p=null
set t=null
endfunction
function RShikiTwoCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=null
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local integer idu=GetHandleId(u)
local integer idp=GetHandleId(p)
local real dmg=GetHeroAgi(u,true)*(2.75+0.25*GetUnitAbilityLevel(u,'A1BY'))*(1-LoadInteger(HH,idu,ComboCounterHash)*0.045)
local real x1=0
local real y1=0
local real sc=0
local real a=GetUnitFacing(u)*bj_DEGTORAD
local group g1=CreateGroup()
set x1=x+100*Cos(a)
set y1=y+100*Sin(a)
call SetUnitAnimation(u,"spell slam gold")
call SetWidgetMana(u, GetWidgetMana(u)-GetWidgetMaxMana(u)*LoadInteger(HH,idu,ComboCounterHash)*0.005)
call GroupEnumUnitsInRange(g1,x1,y1,150,Base)
loop
set E=FirstOfGroup(g1)
exitwhen E==null
if Condition_Base(p,E)then
call SaveUnitHandle(HH,id,1,E)
set c=E
if dmg>GetHeroAgi(u,true)*(2.75+0.25*GetUnitAbilityLevel(u,'A1BY'))*0.1 then
call myCustomDamage(u,c,dmg,false,false,null,null,null)
else
call myCustomDamage(u,c,GetHeroAgi(u,true)*(2.75+0.25*GetUnitAbilityLevel(u,'A1BY'))*0.1,false,false,null,null,null)
endif
call UnitAddAbility(E,'Arav')
call UnitRemoveAbility(E,'Arav')
call PauseUnit(E,true)
call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,true)
//call SetUnitInvulnerable(c,E, true)
call GroupClear(g1)
endif
call GroupRemoveUnit(g1,E)
endloop
set n=CreateUnit(p,'e116',x1,y1,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,GetRandomInt(50,255))
set sc=GetRandomReal(0.5,3)
call SetUnitScale(n,sc,sc,sc)
call UnitApplyTimedLife(n,'BTLF',0.7)
call SetUnitTimeScale(n,2.5)
set n=CreateUnit(p,'e116',x1,y1,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,GetRandomInt(50,255))
set sc=GetRandomReal(0.5,3)
call SetUnitScale(n,sc,sc,sc)
call UnitApplyTimedLife(n,'BTLF',0.7)
call SetUnitTimeScale(n,2.5)
set n=CreateUnit(p,'e116',x1,y1,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,GetRandomInt(50,255))
set sc=GetRandomReal(0.5,3)
call SetUnitScale(n,sc,sc,sc)
call UnitApplyTimedLife(n,'BTLF',0.7)
call SetUnitTimeScale(n,2.5)
set n=CreateUnit(p,'e116',x1,y1,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,GetRandomInt(50,255))
set sc=GetRandomReal(0.5,3)
call SetUnitScale(n,sc,sc,sc)
call UnitApplyTimedLife(n,'BTLF',0.7)
call SetUnitTimeScale(n,2.5)
set n=CreateUnit(p,'e11H',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,2)
set n=CreateUnit(p,'e11S',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',1.4)
call SetUnitTimeScale(n,0.5)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG-30)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+30)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
call ShakeCamera(0.25,15)
if c!=null then
call SaveUnitHandle(HH,id,0,u)
call SaveReal(HH,idu,SH_DIR,0)
call SaveReal(HH,id,4,0)
call SaveReal(HH,id,6,0)
call SaveReal(HH,id,7,GetUnitFlyHeight(c))
call SaveReal(HH,id,8,a)
call SaveUnitHandle(HH,idu,SH_SKQ,c)
call TimerStart(t,0.01,true,function RShikiTwoCast2)
call PauseUnit(u,true)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
//call SetUnitInvulnerable(c,c, true)
call SetControlToUnit(E,E, 0.5, "stun")
call SetPlayerAbilityAvailable(p,'A1BR',true)
call SetPlayerAbilityAvailable(p,'A1BQ',false)
call SetPlayerAbilityAvailable(p,'A1BP',false)
call SaveUnitHandle(HH,idu,SH_SKR,c)
call RemoveSaveHashTimedShiki(1.10,idu,SH_SKR,u)
set soundplay=SndN(2604) // Sound\Music\mp3Music\NanayaHit.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SetUnitTimeScale(LoadUnitHandle(HH,idp,ComboBarHash),100000)
if LoadInteger(HH,idu,ComboCounterHash)>5 and LoadInteger(HH,idu,ComboCounterHash)<8 then
    call SetUnitColor(LoadUnitHandle(HH,idp,ComboBarHash),PLAYER_COLOR_PURPLE)
elseif LoadInteger(HH,idu,ComboCounterHash)>7 then
    call SetUnitColor(LoadUnitHandle(HH,idp,ComboBarHash),PLAYER_COLOR_RED)
    if LoadUnitHandle(HH,idu,SH_CST)==null then
        call SaveUnitHandle(HH,idu,SH_CST,CreateUnit(p,'h06A',x,y,0))
    endif
endif
call ComboBar(u,-.5)
call UnitAddAbility(u,'A1BI')
call SaveReal(HH,idu,ComboTimerHash,2)
call SaveInteger(HH,idu,ComboCounterHash,LoadInteger(HH,idu,ComboCounterHash)+1)
call TextTagFull2(I2S(LoadInteger(HH,idu,ComboCounterHash))+" x COMBO!",x,y,175,75,255,255,p,0.023+0.001*LoadInteger(HH,idu,ComboCounterHash))
if LoadInteger(HH,idu,ComboCounterHash)>5 and GetUnitAbilityLevel(u,'A1BN')==0 then
    call SetPlayerAbilityAvailable(p,'A1BU',false)
    call SetPlayerAbilityAvailable(p,'A1BV',true)
endif
if LoadInteger(HH,idu,ComboCounterHash)>2 then
    call SetAbilityIntegerLevelField(GetUnitAbility(u,'A1BZ'), ABILITY_ILF_TARGET_TYPE,0,1)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A1BZ'), ABILITY_RLF_CAST_RANGE,0,1400)
endif
else
call SaveReal(HH,idu,ComboTimerHash,0)
call SaveInteger(HH,idu,ComboCounterHash,0)
call SetUnitTimeScale(LoadUnitHandle(HH,idp,ComboBarHash),-10000000)
call SetPlayerAbilityAvailable(p,'A1BY',false)
call SetPlayerAbilityAvailable(p,'A1BX',true)
endif
set c=null
set u=null
set p=null
set g1=null
set t=null
endfunction
function InitTrig_RShikiTwo takes nothing returns nothing
set gg_trg_RShikiTwo=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_RShikiTwo,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_RShikiTwo,Condition(function RShikiTwoCond))
call TriggerAddAction(gg_trg_RShikiTwo,function RShikiTwoCast)
endfunction
function TShikiCond takes nothing returns boolean
return GetSpellAbilityId()=='A1BZ'
endfunction
function TShikiCast6 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit l__d=LoadUnitHandle(HH,id,1)
local integer idu=GetHandleId(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real dmg=GetHeroAgi(u,true)*(9+LoadInteger(HH,idu,ComboCounterHash))
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real a=LoadReal(HH,id,3)
local real dist=LoadReal(HH,id,2)
local player p=GetOwningPlayer(u)
local integer idp=GetHandleId(p)
if dist<400 and GetWidgetLife(l__d)>0 then
set x=x+40*Cos(a)
set y=y+40*Sin(a)
set n=CreateUnit(p,'e11F',x,y,a*bj_RADTODEG+180)
call SetUnitVertexColor(n,255,255,255,125-R2I((1)*0.05))
call UnitApplyTimedLife(n,'BTLF',0.2)
call SetUnitTimeScale(n,4)
call SetUnitAnimation(n,"spell four")
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitXY_1(u,x,y, false)
call SaveReal(HH,id,2,dist+40)
else
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitXY_1(u,x,y, false)
call PauseTimer(t)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG-210)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+210)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+180)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
call UnitRemoveAbility(u,'A195')
call PauseUnit(l__d,false)
call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,false)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
//if GetUnitTypeId(l__d)=='H075' then
//call myCustomDamage(u,l__d,GetHeroAgi(u,true)*12,false,false,null,null,null)
//else
call myCustomDamage(u,l__d,dmg,false,false,null,null,null)
//endif
if LoadInteger(HH,idu,ComboCounterHash)>2 then
call SetControlToUnit(u,l__d, 2, "stun")
else
call SetControlToUnit(u,l__d, 1, "stun")
endif
call ComboBar(u,-.5)
call SaveReal(HH,idu,ComboTimerHash,2)
call SaveInteger(HH,idu,ComboCounterHash,LoadInteger(HH,idu,ComboCounterHash)+1)
call TextTagFull2(I2S(LoadInteger(HH,idu,ComboCounterHash))+" x COMBO!",x,y,175,75,255,255,p,0.023+0.001*LoadInteger(HH,idu,ComboCounterHash))
call SetUnitTimeScale(LoadUnitHandle(HH,idp,ComboBarHash),-.5)
call SaveUnitHandle(HH,id,0,u)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set l__d=null
set u=null
set p=null
set t=null
endfunction
