    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=12
    loop
    exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
    call SetUnitState(udg_Hero[GetForLoopIndexA()],UNIT_STATE_LIFE,GetUnitState(udg_Hero[GetForLoopIndexA()],UNIT_STATE_MAX_LIFE))
    call SetUnitState(udg_Hero[GetForLoopIndexA()],UNIT_STATE_MANA,GetUnitState(udg_Hero[GetForLoopIndexA()],UNIT_STATE_MAX_MANA))
