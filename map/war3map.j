call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,GetUnitFlyHeight(l__d))
call SaveReal(h,id,3,GetUnitX(l__d))
call SaveReal(h,id,4,GetUnitY(l__d))
call SaveReal(h,id,5,a)
call SaveReal(h,id,7,dist)
call SaveReal(h,id,10,dist)
call SaveReal(h,id,8,time)
call SaveReal(h,id,9,dmg)
call SaveGroupHandle(h,id,10,CreateGroup())
call TimerStart(t,0.014,true,function ERinMissles2)
set t=null
endfunction
