function BrolyE1Cast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
if LoadReal(h,GetHandleId(u),SH_BroEtime)<=5 and udg_B then
if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
call SaveReal(h,GetHandleId(u),SH_BroEtime,LoadReal(h,GetHandleId(u),SH_BroEtime)+0.125)
endif
else
call UnitRemoveAbility(u,'A2DF')
if LoadReal(h,GetHandleId(u),SH_shie1)>0 then
call BrolyE2FastCast(u,0.5*LoadReal(h,GetHandleId(u),SH_shie1))
endif
call SaveReal(h,GetHandleId(u),SH_shie1,0)
call SaveReal(h,GetHandleId(u),SH_shie2,0)
call ShowAbility2('A3DJ',false)
call ShowAbility2('A2DJ',true)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set t=null
set u=null
endfunction
function BrolyE1Cast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real pr=100+GetUnitState(u,UNIT_STATE_MAX_LIFE)*(0.15+GetUnitAbilityLevel(u,'A2DJ')*0.05)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,GetHandleId(u),SH_BroEtime,0)
call UnitAddAbility(u,'A2DF')
call UnitMakeAbilityPermanent(u,true,'A2DF')
call SaveReal(h,GetHandleId(u),SH_shie1,pr)
call SaveReal(h,GetHandleId(u),SH_shie2,pr)
call ShowAbility2('A2DJ',false)
call ShowAbility2Timed('A3DJ',true,0.2)
call SetUnitAbilityLevel(u,'A3DJ',GetUnitAbilityLevel(u,'A2DJ'))
call TimerStart(t,0.125,true,function BrolyE1Cast2)
// длительность щита в статус-баре (как мантия Тсуны); таймер щита идёт ~5.25 сек. и стоит на паузе вместе с героем,
// индикатор пропадает, когда щит сломан или взорван (A2DF снята)
call CreateModeIndicatorWithPauseFormDispellable(u, "ReplaceableTextures\\CommandButtons\\BTNBrolyE1.blp", 5.25,'A2DF')
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(2698) // Sound\Music\mp3Music\BrolyShield.mp3
else
set soundplay=SndN(2700) // Sound\Music\mp3Music\Broly\BrolyShield-jap.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set u=null
set t=null
endfunction
