function BlackGokuQPushTarget1 takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit target=LoadUnitHandle(HH,id,1)
local unit Dummy=LoadUnitHandle(HH,id,20)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real distance=LoadReal(HH,id,8)
local real x0=GetUnitX(Dummy)
local real y0=GetUnitY(Dummy)
local real x1=GetUnitX(target)
local real y1=GetUnitY(target)
local real x2=PolX(x1,40,facing)
local real y2=PolY(y1,40,facing)

set time=time+0.02
call SaveReal(HH,id,5,time)
call MoveUnit(target,target,30,facing)
call SetUnitPathing(target,false)
call SaveReal(HH,id,8,distance+30)








if distance>=2040 or SR(x0,y0,x1,y1)>500 or  IsTerrainPathable(x2,y2,PATHING_TYPE_FLYABILITY)==true  then
call SetUnitPathing(target,true)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif

set Dummy=null
set target=null


endfunction



function BlackGokuQPushTarget takes  unit target0 ,real x00,real y00,real facing00,unit Dummy2,real distance00 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(HH,id,1,target0)
call SaveReal(HH,id,3,facing00)
call SaveReal(HH,id,11,x00)
call SaveReal(HH,id,12,y00)
call SaveUnitHandle(HH,id,20,Dummy2)
call SaveReal(HH,id,8,distance00)
//call SaveUnitHandle(HH,GetHandleId(caster),StringHash("GaaraRU"),n0)

call TimerStart(t,0.02,true,function BlackGokuQPushTarget1)

set t=null
set target0=null
endfunction






function DamageAoeOneTimeBlackGokuQ takes unit damager,real x0,real y0,real range,real damage,group gr1,real facing0, unit Dummy1,real distance0 returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
call GroupClear(G)
call GroupEnumUnitsInRange(G,x0,y0,range,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if  Condition_Base(GetOwningPlayer(damager),n0) and IsUnitInGroup(n0,gr1)==false  then
call myCustomDamage(damager,n0,damage,false,false,null,null,null)

call BlackGokuQPushTarget(n0,x0,y0,facing0,Dummy1,distance0)

call GroupAddUnit(gr1,n0)
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
call SaveGroupHandle(HH,id,4,gr1)
set damager=null
set gr1=null
set t=null                      
endfunction
