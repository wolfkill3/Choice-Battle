function CondLightKick takes nothing returns boolean
return GetSpellAbilityId()=='A0KQ' and udg_B==true
endfunction
function LightKickAct2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real x2=0
local real y2=0
local integer i=LoadInteger(h,id,2)
local player p=GetOwningPlayer(u)
local real a=0
local real f=GetRandomReal(0,359)*bj_DEGTORAD
local real dmg=(4+GetUnitAbilityLevel(u,'A0KQ'))*GetHeroAgi(u,true)
if i<11 and GetWidgetLife(c)>0 and GetWidgetLife(u)>0 and udg_B and DU2 then
call PauseUnit(u,true)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
set x2=x1+100*Cos(f)
set y2=y1+100*Sin(f)
call SetUnitXY_1(u,x2,y2, false)
set a=Atan2(y1-GetUnitY(u),x1-GetUnitX(u))
call UnitApplyTimedLife(CreateUnit(p,'e0B1',x1,y1,GetRandomReal(0,359)),1,0.4)
call UnitApplyTimedLife(CreateUnit(p,'e0B4',x1,y1,GetRandomReal(0,359)),1,0.4)
set n=CreateUnit(p,'e0B2',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitVertexColor(n,255,220,40,50)
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitAnimation(u,"spell")
call SaveInteger(h,id,2,i+1)
call Push3(c,50,a+GetRandomReal(-0.9,0.9),600,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
call SetControlToUnit(u,c,1, "stun")
else
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call myCustomDamage(u,c,dmg,false,false,null,null,null)
call UnitRemoveAbility(u,'A0KM')
call UnitRemoveAbility(u,'A0KN')
call SetUnitTurnSpeed(u,0.60)
call SetUnitVertexColor(u,255,255,255,255)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function LightKickAct takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
    call SetUnitVertexColor(u,255,255,255,100)
    call SaveUnitHandle(h,id,0,u)
    call SaveUnitHandle(h,id,1,c)
    call UnitAddAbility(u,'A0KM')
    call UnitAddAbility(u,'A0KN')
    call PauseUnit(u,true)
    call PauseUnit(c,true)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
    call SetUnitInvulnerable(u,true)
    set soundplay=CreateSound("Sound\\Music\\mp3Music\\KizaruR.mp3",false,false,true,12700,12700,"")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    call TimerStart(t,0.25,true,function LightKickAct2)
    call SetUnitTurnSpeed(u,3.00)
else
    call SetUnitXY_1(u,x1,y1, false)
    call SetUnitTimeScale(u,1)
    call SetUnitInvulnerable(u,false)
    call PauseUnit(u,false)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
    call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
    call SetUnitFlyHeight(u,0,0)
    call SetUnitFlyHeight(c,0,0)
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(h,id)
endif
set u=null
set t=null
set c=null
endfunction
function LightKickInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function LightKickAct)
call TriggerAddCondition(t,Condition(function CondLightKick))
set t=null
endfunction
function CondYatanoKagami takes nothing returns boolean
return GetSpellAbilityId()=='A0KO' and udg_B==true
endfunction
function CastYatanoKagami2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real x2=LoadReal(h,id,4)
local real y2=LoadReal(h,id,5)
local real a=LoadReal(h,id,1)
local group g=LoadGroupHandle(h,id,3)
local integer l__idg=GetHandleId(g)
local integer lvl=GetUnitAbilityLevel(u,'A0KO')
local real dmg=100*lvl+GetHeroAgi(u,true)*lvl
local player p=GetOwningPlayer(u)
local integer l__ide
local real r=LoadReal(h,id,6)+1
local real a3=LoadReal(h,id,7)
local real a2=a+a3
local real dist=LoadReal(h,id,100)
if dist<2000 and LoadBoolean(HH,GetHandleId(u),DASH_USER)==true then
call SaveReal(h,id,100,dist+30)
if IsTerrainPathable(x1,y1,PATHING_TYPE_FLYABILITY)==false then
call SetUnitX(u,x1+65*Cos(a2))
call SetUnitY(u,y1+65*Sin(a2))
else
call SetUnitX(u,x1+15*Cos(a2))
call SetUnitY(u,y1+15*Sin(a2))
endif
call SetUnitFacing(u,a2*bj_RADTODEG)
call SetUnitAnimation(u,"walk")
set n=CreateUnit(p,0x65304736,x1,y1,a2*bj_RADTODEG)
call UnitApplyTimedLife(n,0,0.65)
call SetUnitTimeScale(n,0)
call GroupEnumUnitsInRange(G,x1,y1,210,Base)
call SaveReal(h,id,6,r)
if r>5 then
call SaveReal(h,id,7,a3*(-1))
call SaveReal(h,id,6,0)
endif
loop
set E=FirstOfGroup(G)
set l__ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,l__idg,l__ide)!=E then
    if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
        call myCustomDamage(u,E,dmg,false,false,null,null,null)
        call SaveUnitHandle(h,l__idg,l__ide,E)
    else
        call SaveBoolean(HH,GetHandleId(u),DASH_USER,false)
        call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,u)
    endif
endif
call GroupRemoveUnit(G,E)
exitwhen E==null
endloop
else
call SaveBoolean(HH,GetHandleId(u),DASH_USER,false)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
call DestroyTimer(t)
call DestroyGroup(g)
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
endif
set u=null
set p=null
set t=null
set g=null
endfunction
function CastYatanoKagami takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,4,GetUnitX(u))
call SaveReal(h,id,5,GetUnitY(u))
call SaveReal(h,id,1,Atan2(GetSpellTargetY()-GetUnitY(u),GetSpellTargetX()-GetUnitX(u)))
call SaveGroupHandle(h,id,3,CreateGroup())
call SetUnitInvulnerable(u,true)
call PauseUnit(u,true)
call SaveBoolean(HH,GetHandleId(u),DASH_USER,true)
call SaveReal(h,id,6,0)
call SaveReal(h,id,100,0)
call SaveReal(h,id,7,60*bj_DEGTORAD)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\YatoNoKagami.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.012,true,function CastYatanoKagami2)
set u=null
set t=null
endfunction
