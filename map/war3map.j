function WOrihimeCast4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit d1=LoadUnitHandle(h,id,3)
local unit d2=LoadUnitHandle(h,id,4)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(d1)
local real y1=GetUnitY(d1)
local real a=0
local player p=GetOwningPlayer(u)
if UnitIsAlive(d1)or UnitIsAlive(d2)then
if SR(x,y,x1,y1)>90 and UnitIsAlive(d1)and UnitIsAlive(u)then
set a=Atan2(y-y1,x-x1)-0.25
set x1=x1+70*Cos(a)
set y1=y1+70*Sin(a)
call SetUnitX(d1,x1)
call SetUnitY(d1,y1)
elseif UnitIsAlive(d1)then
call KillUnit(d1)
endif
set x1=GetUnitX(d2)
set y1=GetUnitY(d2)
if SR(x,y,x1,y1)>90 and UnitIsAlive(d2)and UnitIsAlive(u)then
set a=Atan2(y-y1,x-x1)+0.25
set x1=x1+70*Cos(a)
set y1=y1+70*Sin(a)
call SetUnitX(d2,x1)
call SetUnitY(d2,y1)
elseif UnitIsAlive(d2)then
call KillUnit(d2)
endif
else
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set d2=null
set d1=null
set t=null
set u=null
endfunction
function WOrihimeCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,13)
local real time=LoadReal(h,id,10)
local real x=LoadReal(h,id,1)
local real y=LoadReal(h,id,2)
local real x1=0
local real y1=0
local real a=LoadReal(h,id,9)
local group g=LoadGroupHandle(h,id,11)
local player p=GetOwningPlayer(u)
local integer i=0
local real br=(0.03)*0.05
if time>0 then
call SaveReal(h,id,10,time-0.1)
loop
exitwhen i>=4
set x1=x+125*i*Cos(a-deg90)+75*Cos(a-deg90)
set y1=y+125*i*Sin(a-deg90)+75*Sin(a-deg90)
call GroupEnumUnitsInRange(G,x1,y1,260-40*i,Base)
call GroupAddGroup(G,g)
set i=i+1
endloop
set i=0
loop
exitwhen i>=4
set x1=x+125*i*Cos(a+deg90)+75*Cos(a+deg90)
set y1=y+125*i*Sin(a+deg90)+75*Sin(a+deg90)
call GroupEnumUnitsInRange(G,x1,y1,260-40*i,Base)
call GroupAddGroup(G,g)
set i=i+1
endloop
call GroupEnumUnitsInRange(G,x,y,300,Base)
call GroupAddGroup(G,g)
loop
set E=FirstOfGroup(g)
exitwhen E==null
if IsUnitAlly(E,p)and IsUnitType(E,UNIT_TYPE_HERO)then
call HealTextTag(u,E,(GetUnitState(E,UNIT_STATE_MAX_LIFE)*(br+0.0005)+0.2)*myCustomHeal2(E,1),"HealthRes")
call SetUnitState(E,UNIT_STATE_LIFE,GetWidgetLife(E)+GetUnitState(E,UNIT_STATE_MAX_LIFE)*(br+0.0005)+0.2)
if time==7.8 then
call HealTextTag(u,E,(GetUnitState(E,UNIT_STATE_MAX_LIFE)*(br*40)+0.2)*myCustomHeal2(E,1),"HealthRes")
call SetUnitState(E,UNIT_STATE_LIFE,GetWidgetLife(E)+GetUnitState(E,UNIT_STATE_MAX_LIFE)*(br*40)+0.2)
endif
endif
call GroupRemoveUnit(g,E)
endloop
else
call DestroyGroup(g)
call SetUnitFlyHeight(LoadUnitHandle(h,id,3),125,0)
call SetUnitFlyHeight(LoadUnitHandle(h,id,4),125,0)
call RemoveUnit(c)
call PauseTimer(t)
call TimerStart(t,0.03,true,function WOrihimeCast4)
endif
set g=null
set p=null
set t=null
set u=null
set c=null
endfunction
function WOrihimeCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit d1=LoadUnitHandle(h,id,3)
local unit d2=LoadUnitHandle(h,id,4)
local real x1=LoadReal(h,id,1)
local real y1=LoadReal(h,id,2)
local real x=GetUnitX(d1)
local real y=GetUnitY(d1)
local real x2=LoadReal(h,id,5)
local real y2=LoadReal(h,id,6)
local real x3=LoadReal(h,id,7)
local real y3=LoadReal(h,id,8)
local real a=0
local real a2=LoadReal(h,id,9)
local real sr=SR(x,y,x2,y2)
local player p=GetOwningPlayer(u)
if sr>90 then
set a=Atan2(y2-y,x2-x)-0.25
set x=x+70*Cos(a)
set y=y+70*Sin(a)
call SetUnitX(d1,x)
call SetUnitY(d1,y)
set x=GetUnitX(d2)
set y=GetUnitY(d2)
set a=Atan2(y3-y,x3-x)+0.25
set x=x+70*Cos(a)
set y=y+70*Sin(a)
call SetUnitX(d2,x)
call SetUnitY(d2,y)
else
set n=CreateUnit(p,'e16N',x1+400*Cos(a2-deg90),y1+400*Sin(a2-deg90),a2*bj_RADTODEG+90)
call SaveUnitHandle(h,id,13,n)
call SetUnitVertexColor(n,255,155,155,155)
set n=CreateUnit(p,'e16O',x2,y2,Atan2(y1-y2,x1-x2)*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',4)
set n=CreateUnit(p,'e16G',x2,y2,LoadReal(h,id,9)*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1)
set n=CreateUnit(p,'e16O',x3,y3,Atan2(y1-y3,x1-x3)*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',4)
set n=CreateUnit(p,'e16G',x3,y3,LoadReal(h,id,9)*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitX(d1,x2)
call SetUnitY(d1,y2)
call SetUnitX(d2,x3)
call SetUnitY(d2,y3)
call SetUnitFlyHeight(d1,25,0)
call SetUnitFlyHeight(d2,25,0)
call SaveReal(h,id,10,8)
call PauseTimer(t)
call TimerStart(t,0.1,true,function WOrihimeCast3)
endif
set p=null
set d2=null
set d1=null
set t=null
set u=null
endfunction
