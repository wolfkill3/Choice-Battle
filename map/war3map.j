                                set n = CreateUnit( Player( i ), 'dumm', 8000., 8000., 0. )
                                call UnitAddAbility( n, 'Abun' )
                                if i != PLAYER_NEUTRAL_PASSIVE then
//                                      call SaveUnitHandle( htMain, GetHandleId( Player( i ) ), StringHash( "Damage_Dummy" ), uSys_1 )
