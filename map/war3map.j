call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,2)
call UnitApplyTimedLife(CreateUnit(p,'e0SE',x1,y1,a*bj_RADTODEG),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0SF',x1,y1,a*bj_RADTODEG),'BTLF',2)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call SetUnitPathing(u,true)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
if GetHeroLevel(u)>34 then
set bPaused=false
if IsUnitPaused(c) then
    set bPaused=true
    call PauseUnit(c,false)
endif
call IssueImmediateOrder(c,"manashieldoff")
call IssueImmediateOrder(c,"unimmolation")
call UnitRemoveAbility(c,'A1GL')
call UnitRemoveAbility(c,'WAE1')
call UnitRemoveAbility(c,'A1WT')
call UnitRemoveBuffs(c,true,false)
if UnitHasItemOfTypeBJCustom(c, 'I03A') and GetWidgetLife(c)>0 and IsUnitIllusion(c)==false then
    set AlastorPos=0
    loop
    exitwhen AlastorPos==10 or GetItemTypeId(UnitItemInSlot(c,AlastorPos)) == 'I03A'
    set AlastorPos=AlastorPos+1
    endloop
    if IsAbilityEnabled(GetUnitAbility(c,'AInv'))==true then
        set Alastor=GetItemOfTypeFromUnitBJCustom(c,'I03A')
        call UnitRemoveItem(c,Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(c, 'I03A',AlastorPos)
    else
        call EnableUnitAbility2(c,'AInv',false,true)
        set Alastor=GetItemOfTypeFromUnitBJCustom(c,'I03A')
        call UnitRemoveItem(c,Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(c, 'I03A',AlastorPos)    
        call DisableUnitAbility2(c,'AInv',false,true)
    endif
endif
call UnitAddItemById(c,'I06B')
if LoadReal(h, idc, SH_ShieldBelfF)>0 then   // Щит Бельфегора
    call SaveReal(h, idc, SH_ShieldBelfF, 0)
else
    call SaveReal(h, idc, SH_ShieldBelfF, 0)
    call RemoveSavedReal(h, idc, SH_ShieldBelfF)
endif
if LoadReal(h, idc, SH_YujiE_Shield)>0 then  // Щит Юджи
    call SaveReal(h, idc, SH_YujiE_Shield, 0)
else
    call RemoveSavedReal(h, idc, SH_YujiE_Shield)
endif
if GetUnitAbilityLevel(c,'A1DF')>=1 then                  // Щит Шилдер Q
    call UnitRemoveAbility(c,'A1DF')
    call SaveReal(h,idc, SH_shi1, 0)
    call SaveReal(h,idc, SH_shi2, 0)
endif
if GetUnitAbilityLevel(c,'A1DG')>=1 then                  // Щит Шилдер E
    call UnitRemoveAbility(c, 'A1DG')
endif
if GetUnitAbilityLevel(c,'A10G')>=1 then                  // Щит Луизы
    call UnitRemoveAbility(c, 'A10G')
endif
if GetUnitAbilityLevel(c, 'A2DF')>0 then                      // Щит Броли
    call SaveReal(h,idc,SH_BroEtime,9)
endif
if GetUnitAbilityLevel(c, 'A0VJ')>0 then                  // Гроза Вонголы
    call UnitRemoveAbility(c, 'A0VJ')
endif
if GetUnitAbilityLevel(c, 'A1HG')>0 then                  // Щит Орехи
    call UnitRemoveAbility(c, 'A1HG')
endif
if GetUnitAbilityLevel(c, 'A3DF')>0 then                  // Щит Waver
    call UnitRemoveAbility(c, 'A3DF')
endif

if GetUnitAbilityLevel(c, 'A1H1')>=1 then                 // Щит от Ульты Жанны Рулер
    call UnitRemoveAbility(c, 'A1H1')
endif
if GetUnitAbilityLevel(c, 'A0VV')>=1 then                 // Броня бороса
    call UnitRemoveAbility(c, 'A0VV')
endif
if GetUnitAbilityLevel(c, 'A28W')>=1 then                 // Броня бороса
    call UnitRemoveAbility(c, 'A28W')
endif
if GetUnitAbilityLevel(c, 'AcF1')>=1 then                 // F Эйса
    call SaveBoolean(HH,idc,SST,false)
    call ShowAbility2('A315',false)
    call ShowAbility2('A015',true)
    call UnitRemoveAbility(c,'AcF1')
endif
if GetUnitAbilityLevel(c, 'ItV1')>=1 then                 // G itachi
    call SaveBoolean(HH,idc,SST,false)
    call ShowAbility2('A30C',false)
    call ShowAbility2('A00C',true)
    call UnitRemoveAbility(c,'ItV1')
endif
if GetUnitAbilityLevel(c, 'GaT1')>=1 then                 // T Gamma
    call SaveBoolean(HH,idc,SST,false)
    call ShowAbility2('A41C',false)
    call ShowAbility2('A0GV',true)
    call UnitRemoveAbility(c,'GaT1')
endif
if GetUnitAbilityLevel(c, 'MgT1')>=1 then                 // T Magnus
    call SaveBoolean(HH,idc,SST,false)
    call ShowAbility2('A42C',false)
    call ShowAbility2('A15C',true)
    call UnitRemoveAbility(c,'MgT1')
endif
if GetUnitAbilityLevel(c,'SiTS')>=1 then                 // Щит P Сигнум Tank Spirit
    call UnitRemoveAbility(c,'SiTS')
endif
if bPaused then
    call PauseUnit(c,true)
endif
endif
//if GetUnitAbilityLevel(c, 'Wome')>0 then
//    set damage = damage * 1.35
//endif
call myCustomDamage(u,c, damage,false,false,null,null,null)
call PauseTimer(t)
call DestroyTimer(t)
call UnitRemoveAbility(u,'A0BX')
call SetUnitTimeScale(u,1)
call FlushChildHashtable(h,id)
set p=null
set u=null
set c=null
set t=null
endfunction
function FaceBreakerUltCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call SetUnitAnimation(u,"Spell Two")
call SetUnitTimeScale(u,2)
call PauseTimer(t)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",u,"right hand"))
call TimerStart(t,1,false,function FaceBreakerUltCast4)
set p=null
set u=null
set c=null
set t=null
endfunction
function FaceBreakerCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>120 and GetWidgetLife(c)>0 then
set x=x+60*Cos(a)
set y=y+60*Sin(a)
call SetUnitXY_1(u,x,y,false)
call SetUnitFacing(u,a*bj_RADTODEG)
set n=CreateUnit(p,'e0YP',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.25)
call SetUnitVertexColor(n,170,170,170,255)
call SetUnitTimeScale(n,2)
call SetUnitAnimation(n,"attack")
call SetUnitAnimation(u,"attack")
else
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call SetUnitAnimation(u,"Spell Six")
call SetUnitTimeScale(u,0.5)
call PauseTimer(t)
call TimerStart(t,0.8,false,function FaceBreakerCast3)
else
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call SetUnitAnimation(u,"attack")
call PauseUnit(c,false)
call UnitRemoveAbility(u,'A0BX')
call SetUnitTimeScale(u,1)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitVertexColor(u,255,255,255,255)
call FlushChildHashtable(h,id)
endif
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function FaceBreakerUltCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>650 and GetWidgetLife(c)>0 then
set x=x+60*Cos(a)
set y=y+60*Sin(a)
call SetUnitXY_1(u,x,y,false)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",u,"right hand"))
call SetUnitFacing(u,a*bj_RADTODEG)
set n=CreateUnit(p,'e0YP',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.25)
call SetUnitVertexColor(n,170,170,170,255)
call SetUnitTimeScale(n,2)
call SetUnitAnimation(n,"attack")
call SetUnitAnimation(u,"attack")
else
set x=x1-650*Cos(a)
set y=y1-650*Sin(a)
call SetUnitXY_1(u,x,y, false)
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",u,"right hand"))
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call SetUnitAnimation(u,"Spell One")
call SetUnitTimeScale(u,1)
call PauseTimer(t)
call TimerStart(t,1.8,false,function FaceBreakerUltCast3)
else
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call SetUnitAnimation(u,"attack")
call PauseUnit(c,false)
call UnitRemoveAbility(u,'A0BX')
call SetUnitTimeScale(u,1)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitVertexColor(u,255,255,255,255)
call FlushChildHashtable(h,id)
endif
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function FaceBreakerCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
call SaveUnitHandle(h,id,0,u)
call SetUnitPathing(u,false)
call SetUnitAnimation(u,"spell two")
call UnitAddAbility(u,'A0BX')
call PauseUnit(u,true)
call SaveReal(h,id,9,Atan2(GetUnitY(c)-y,GetUnitX(c)-x))
call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e06H',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e06I',x,y,GetRandomReal(0,359)),'BTLF',1)
call SetUnitTimeScale(u,5)
call SetUnitInvulnerable(u,true)
call SaveUnitHandle(h,id,1,c)
if GetUnitAbilityLevel(u,'A16H')>0 and GetHeroLevel(u)>5 then
set soundplay=SndN(2476) // Sound\Music\mp3Music\Touma62.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.03,true,function FaceBreakerUltCast2)
else
call TimerStart(t,0.025,true,function FaceBreakerCast2)
endif
set c=null
set u=null
set t=null
endfunction
function PortableChurchCond takes nothing returns boolean
return GetSpellAbilityId()=='A16B'
endfunction
function PortableChurchCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real heal
local real dmg
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(GetOwningPlayer(u))
local unit l__d=LoadUnitHandle(HH,StringHash(I2S(ip)),SH_index)
local real x=LoadReal(h,id,12)
local real y=LoadReal(h,id,11)
local real time=LoadReal(h,id,10)
if time==10 then
call PauseTimer(t)
call PauseUnit(l__d,false)
call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,false)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call SetUnitTimeScale(u,1)
call UnitRemoveAbility(l__d,'A16C')
else
call SaveReal(h,id,10,time+0.1)
call GroupEnumUnitsInRange(G,x,y,600,Base)
loop
set E=FirstOfGroup(G)
set heal=(GetUnitState(E,UNIT_STATE_MAX_LIFE)-GetWidgetLife(E))*0.004
set dmg=(GetUnitState(E,UNIT_STATE_MAX_MANA)-GetUnitState(E,UNIT_STATE_MANA))*0.002
exitwhen E==null
if IsUnitAlly(E,p)then
call HealTextTag(u,E,heal*myCustomHeal2(E,1),"HealthRes")
call SetUnitState(E,UNIT_STATE_LIFE,GetWidgetLife(E)+heal)
call HealTextTag(u,E,dmg*myCustomMana2(E,1),"ManaRes")
call SetUnitState(E,UNIT_STATE_MANA,GetUnitState(E,UNIT_STATE_MANA)+dmg)
endif
call GroupRemoveUnit(G,E)
endloop
endif
set l__d=null
set p=null
set u=null
set t=null
endfunction
