local real r=GetRandomReal(-350,350)
local real a=GetRandomReal(0,7)
local unit c=LoadUnitHandle(h,GetHandleId(Hero[ip]),SH_IMR)
call SetUnitX(u,GetUnitX(c)+r*Cos(a))
call SetUnitY(u,GetUnitY(c)+r*Sin(a))
if GetUnitTypeId(c)!='H00N' then
        call IssueTargetOrder(u,"attack",c)
endif
call SetUnitVertexColor(u,GetRandomInt(0,255),GetRandomInt(0,255),GetRandomInt(0,255),255)
call UnitAddAbility(u,'Aloc')
call UnitRemoveAbility(u,'A0A1')
set u=null
set c=null
set p=null
endfunction
