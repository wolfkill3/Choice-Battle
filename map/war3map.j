function FinalExplosionCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local integer i=1
local player p=GetOwningPlayer(u)
local integer iu=GetPlayerId(p)
local player pc=GetOwningPlayer(c)
local integer ic=GetPlayerId(pc)
local effect ef=null
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real kf
local real dmg=((GetUnitState(u,UNIT_STATE_MAX_LIFE)*(GetUnitAbilityLevel(u,'A0IQ')*0.1+0.25))+3*GetHeroStr(u,true))
set ef=AddSpecialEffect("war3mapImported\\[DoFT]Natsu_Fire_Ball_n.mdl",x1,y1)
call SetSpecialEffectScale(ef , 1.6)
call SetSpecialEffectTimeScale(ef , 1.7)
call SetSpecialEffectVertexColour(ef,255,255,255,165)
call SetSpecialEffectZ(ef,350)
call DestroyEffect(ef)
set n=CreateUnit(p,'e0P7',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,4)
call SetUnitFlyHeight(n,350,0)
set n=CreateUnit(p,'e0P6',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,4)
call SetUnitFlyHeight(n,350,0)
set n=CreateUnit(p,'e0P5',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,4)
call SetUnitFlyHeight(n,350,0)
set n=CreateUnit(p,'e0P8',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,4)
call SetUnitFlyHeight(n,350,0)
set n=CreateUnit(p,'e0P5',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,4)
call SetUnitFlyHeight(n,350,0)
set n=CreateUnit(p,'e0P5',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,4)
call SetUnitFlyHeight(n,350,0)
set n=CreateUnit(p,'e0P8',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,4)
call SetUnitFlyHeight(n,350,0)
set n=CreateUnit(p,'e0P8',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,4)
call SetUnitFlyHeight(n,350,0)
call GroupEnumUnitsInRange(DG,x1,y1,1250,Base)
call SetUnitAnimation(u,"Death")
loop
set E=FirstOfGroup(DG)
call GroupRemoveUnit(DG,E)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
endloop
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call SetUnitTargetable(u, true)
call UnitRemoveBuffs(u,true,true)
call SetUnitState(u,UNIT_STATE_LIFE,1)
call UnitAddAbility(c,'A0WR')
call myCustomDamage(c,u,50,false,false,null,DAMAGE_TYPE_UNIVERSAL,null)
call UnitRemoveAbility(c,'A0WR')
call PauseTimer(t)
call FlushChildHashtable(h,id)
set u=null
set c=null
set p=null
set pc=null
set ef=null
set t=null
endfunction
function SakuraSlashDamage4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,2)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real dmg=GetHeroAgi(u,true)*11
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=LoadReal(h,id,6)
local integer i=0
local real dist=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
if dist<2.4 then
call SetUnitInvulnerable(u,true)
set n=CreateUnit(p,'e0ZO',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,125,255,120)
call SetUnitScale(n,1,1,1)
call SetUnitTimeScale(n,0.6)
call UnitApplyTimedLife(n,1,0.4)
set n=CreateUnit(p,'e0ZO',x,y,GetRandomReal(0,359))
call SetUnitScale(n,1.25,1.25,1.25)
call SetUnitVertexColor(n,255,125,255,100)
call SetUnitTimeScale(n,0.6)
call UnitApplyTimedLife(n,1,0.4)
set n=CreateUnit(p,'e0ZO',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,125,255,80)
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitTimeScale(n,0.6)
call UnitApplyTimedLife(n,1,1.1)
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,170,200,120)
call SetUnitScale(n,1,1,1)
call SetUnitTimeScale(n,0.9)
call UnitApplyTimedLife(n,1,1.1)
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitScale(n,2,2,2)
call SetUnitVertexColor(n,255,170,200,100)
call SetUnitTimeScale(n,0.9)
call UnitApplyTimedLife(n,1,1.6)
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,170,200,80)
call SetUnitScale(n,3,3,3)
call SetUnitTimeScale(n,0.9)
call UnitApplyTimedLife(n,1,1.1)
call SaveReal(h,id,2,dist+0.3)
else
set n=CreateUnit(p,'e0ZT',x1,y1,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,255)
call UnitApplyTimedLife(n,1,3)
set n=CreateUnit(p,0x65305A4D,x1,y1,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,255)
call UnitApplyTimedLife(n,1,2)
call SetUnitTimeScale(n,1)
set n=CreateUnit(p,0x65305A4E,x1,y1,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,255)
call UnitApplyTimedLife(n,1,0.5)
call SetUnitTimeScale(n,3)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Tidal.mdx",c,"chest"))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX-Special.mdx",c,"chest"))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Tidal.mdx",c,"head"))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX-Special.mdx",c,"head"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",c,"chest"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",c,"head"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",c,"hand right"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",c,"hand left"))
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call PauseUnit(u,false)
call ShowUnit(u,true)
call SetUnitAnimation(u,"Spell Four")
if GetLocalPlayer()==p then
call SelectUnit(u,true)
endif
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitXY_1(u,x,y, false)
call PauseTimer(t)
call UnitRemoveAbility(u,'A19B')
call UnitRemoveAbility(u,'A295')
call RemoveUnit(l__d)
call SetUnitInvulnerable(u,false)
call SetUnitInvulnerable(c,false)
if GetWidgetLife(c)>dmg*0.25+5 then
