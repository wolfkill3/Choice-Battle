function ForceStaffCond takes nothing returns boolean
return GetSpellAbilityId()==0x41305750 and GetUnitAbilityLevel(GetTriggerUnit(),0x42303455)==0 and GetUnitTypeId(GetTriggerUnit())!='H007' and GetUnitTypeId(GetTriggerUnit())!='H04U'
endfunction
function ForceStaffCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real a=LoadReal(h,id,1)
local real dist=LoadReal(h,id,100)
local player p=GetOwningPlayer(u)
if dist<600 and IsTerrainPathable(x1,y1,PATHING_TYPE_FLYABILITY)==false then
call SaveReal(h,id,100,dist+30)
call SetUnitX(u,x1+30*Cos(a))
call SetUnitY(u,y1+30*Sin(a))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\FlakCannons\\FlakTarget.mdl",x1,y1))
else
set n=CreateUnit(p,'h019',x1,y1,0)
call UnitAddAbility(n,'A0HM')
call IssueTargetOrder(n,"slow",u)
call UnitApplyTimedLife(n,0,1)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
endif
set u=null
set t=null
endfunction
function ForceStaffCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,4,GetUnitX(u))
call SaveReal(h,id,5,GetUnitY(u))
call SaveReal(h,id,1,GetUnitFacing(u)*bj_DEGTORAD)
call SaveReal(h,id,100,0)
call TimerStart(t,0.01,true,function ForceStaffCast2)
set u=null
set t=null
endfunction
