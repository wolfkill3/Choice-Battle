call StartSound(soundplay)
call KillSoundWhenDone(soundplay)

else

set soundplay=CreateSound("Sound\\Music\\mp3Music\\SoundJap\\BlackGokuF2.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)

endif
endif
call SaveBoolean(HH,GetHandleId(caster),StringHash("BGF"),true)
call TimerStart(t,0.02,true,function BlackGokuF1Act)
endif

if GetSpellAbilityId()=='BGFR' then
call SaveUnitHandle(HH,id,1,LoadUnitHandle(HH,GetHandleId(caster),StringHash("BGokuRU")))
call SaveBoolean(HH,GetHandleId(LoadUnitHandle(HH,GetHandleId(caster),StringHash("BGokuRU"))),StringHash("BGF"),false)
call TimerStart(t,0.02,true,function BlackGokuZamasuRAct)
endif

if GetSpellAbilityId()=='BGG1' then




if LoadBoolean(HH,GetHandleId(caster),StringHash("BGG"))==true then
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then


set soundplay=CreateSound("Sound\\Music\\mp3Music\\SoundEng\\BlackGokuGnext_eng.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)



else

set soundplay=CreateSound("Sound\\Music\\mp3Music\\SoundJap\\BlackGokuGnext.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)



endif
call UnitRemoveAbility(caster,'ABG0')
call UnitAddAbility(caster,'ABG1')
call SetUnitAnimationByIndex(caster,87)
call SetUnitAbilityLevel(caster,'BGC1',2)
call TimerStart(t,0.02,true,function BlackGokuGFastAct)
else
call SaveBoolean(HH,GetHandleId(caster),StringHash("BGG"),true)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then


set soundplay=CreateSound("Sound\\Music\\mp3Music\\SoundEng\\BlackGokuGfirst_eng.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
