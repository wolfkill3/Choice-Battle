else
call GroupEnumUnitsInRange(G,x,y,900,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call GroupAddUnit(g,E)
call SetControlToUnit(E,E, 0.3, "stun")
endif
call GroupRemoveUnit(G,E)
endloop
call SaveReal(h,id,2,2)
