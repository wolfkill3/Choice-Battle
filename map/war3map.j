function TRinCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real dmg=GetHeroAgi(u,true)*2
local real a=LoadReal(h,id,3)
local integer alp=LoadInteger(h,id,8)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,5)
local group g2
local real l__s=LoadReal(h,id,4)
if alp>0 then
set g2=CopyGroup(g)
call SaveInteger(h,id,8,alp-10)
loop
set E=FirstOfGroup(g2)
exitwhen E==null
call SetUnitVertexColor(E,255,255,255,alp)
call GroupRemoveUnit(g2,E)
endloop
call DestroyGroupTimed(g2,3)
else
call ForGroup(g,function KillGroup)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set g2=null
set u=null
set p=null
set t=null
endfunction
function TRinCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real dmg=GetHeroInt(u,true)*11
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real a=LoadReal(h,id,3)
local real dist=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,5)
local real l__s=LoadReal(h,id,4)
local integer l__idg=GetHandleId(g)
local integer l__ide=0
if dist<1650 and GetWidgetLife(l__d)>0 then
set x=x+55*Cos(a)
set y=y+55*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SaveReal(h,id,2,dist+55)
call SaveReal(h,id,4,l__s+0.07)
set n=CreateUnit(p,'e15Z',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,255)
call SetUnitTimeScale(n,0.75)
call SetUnitFlyHeight(n,150,0)
call SetUnitScale(n,l__s,l__s,l__s)
call GroupAddUnit(g,n)
call UnitApplyTimedLife(n,'BTLF',1)
call GroupEnumUnitsInRange(G,x,y,200*l__s,Base)
loop
set E=FirstOfGroup(G)
set l__ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,l__ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,l__idg,l__ide,E)
endif
call GroupRemoveUnit(G,E)
endloop
else
call RemoveUnit(l__d)
call PauseTimer(t)
call SaveInteger(h,id,8,255)
call TimerStart(t,0.05,true,function TRinCast3)
endif
set l__d=null
set g=null
set u=null
set p=null
set t=null
endfunction
