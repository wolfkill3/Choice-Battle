function NejiFCond takes nothing returns boolean
return GetSpellAbilityId()=='A21N'
endfunction
function NejiFCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
if GetUnitAbilityLevel(u,'B15A')==0 then
call SetUnitAbilityLevel(u,'A2HK',1)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
endif
set t=null
set u=null
endfunction
function NejiFCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local player p=GetOwningPlayer(u)
call SetUnitAbilityLevel(u,'A2HK',2)
call SaveUnitHandle(h,id,0,u)
set soundplay=SndN(2244) // Sound\Music\mp3Music\NejiF.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.08,true,function NejiFCast2)
set u=null
set p=null
set t=null
endfunction
function ModoRaienryuCond takes nothing returns boolean
return GetSpellAbilityId()=='A10T'
endfunction
function ModoRaienryuCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local integer lvl=LoadInteger(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
if GetUnitAbilityLevel(u,'NAE1')==0 and IsUnitAlive(u)==true then
call SetUnitLifeRegen(u,GetUnitLifeRegen(u)-5+(-5*lvl))
call EnableUnitAbility(u,'A10T',false,true)
call StartAbilityCooldown(GetUnitAbility(u,'A10T'),GetAbilityBaseRealLevelFieldById('A10T',ABILITY_RLF_COOLDOWN,GetUnitAbilityLevel(u,'A10T')-1))
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
elseif Hero[GetPlayerId(GetOwningPlayer(u))]==null then
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
endif
set t=null
set u=null
endfunction
function ModoRaienryuCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local player p=GetOwningPlayer(u)
call UnitApplyTimedLife(CreateUnit(p,'e0QI',x1,y1,GetRandomReal(0,359)),'BTLF',0.01)
call UnitApplyTimedLife(CreateUnit(p,'e0QG',x1,y1,GetRandomReal(0,359)),'BTLF',0.01)
call UnitApplyTimedLife(CreateUnit(p,'e0QK',x1,y1,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0QH',x1,y1,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0AX',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0AW',x1,y1,GetRandomReal(0,359)),'BTLF',0.01)
call UnitApplyTimedLife(CreateUnit(p,'e0B1',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0B4',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0AZ',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0B3',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0C7',x1,y1,GetRandomReal(0,359)),'BTLF',6)
call UnitAddAbility(u,'NAE1')
call SetUnitAbilityLevel(u,'NAE1',GetUnitAbilityLevel(u,'A10T')+1)
call UnitRemoveAbilityTimed(u,'NAE1',25)
call UnitAddAbility(u,'NAE2')
call SetUnitAbilityLevel(u,'NAE2',GetUnitAbilityLevel(u,'A10T')+1)
call UnitRemoveAbilityTimed(u,'NAE2',25)
call SetUnitLifeRegen(u,GetUnitLifeRegen(u)+5+5*GetUnitAbilityLevel(u,'A10T'))
call SaveUnitHandle(h,id,0,u)
call SaveInteger(h,id,1,GetUnitAbilityLevel(u,'A10T'))
set soundplay=SndN(2246) // Sound\Music\mp3Music\Modo Raienryu.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call DisableUnitAbility(u,'A10T',false,true)
call CreateModeIndicatorWithPauseForm(u, "war3mapImported\\BTNLightningDragonMod.blp", 25)
call TimerStart(t,0.08,true,function ModoRaienryuCast2)
set u=null
set p=null
set t=null
endfunction
function BrilliantFlameCond takes nothing returns boolean
return GetSpellAbilityId()=='A10S' and udg_B==true
endfunction
function BrilliantFlameCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local real f=GetUnitFacing(u)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroStr(u,true)*(GetUnitAbilityLevel(u,'A10S')+2)
local real dist=SR(x,y,x1,y1)
local real a=Atan2(y1-y,x1-x)
local real he=0
local real dist2=LoadReal(h,id,100)
local real mxd=LoadReal(h,id,4)
local real time=LoadReal(h,id,8)
if dist2>580 and dist2<620 and udg_B==true and time==0 then
call SetUnitXY_1(l__d,GetUnitX(u)+25*Cos(a),GetUnitY(u)+25*Sin(a), false)
call SaveReal(h,id,100,dist2-25)
call SaveReal(h,id,8,time+0.03)
endif
if dist2>50.00 and udg_B==true and DU2==true then
call SaveReal(h,id,100,dist2-mxd/50)
set x=x+mxd/50*Cos(a)
set y=y+mxd/50*Sin(a)
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,450*(dist/mxd),0)
call SetUnitXY_1(l__d,x,y, false)
call PauseUnit(u,true)
call SetUnitAnimation(u,"Spell Three")
else
call SaveReal(h,id,8,time+0.03)
if time<1.03 then
call GroupEnumUnitsInRange(G,x1,y1,400,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg/32,false,false,null,null,null)
call SetControlToUnit(E,E, 1, "stun")
endif
call GroupRemoveUnit(G,E)
endloop
call SetUnitFlyHeight(u,0,450)
if GetUnitAbilityLevel(u,'A10V')>0 then
call UnitRemoveAbility(u,'A10V')
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
endif
if ModuloReal(time,0.06)<0.01 then
call UnitApplyTimedLife(CreateUnit(p,'e0VL',x1,y1,GetRandomReal(0,359)),'BTLF',0.7)
call UnitApplyTimedLife(CreateUnit(p,'e0VM',x1,y1,GetRandomReal(0,359)),'BTLF',0.7)
endif
else
call KillUnit(l__d)
call UnitApplyTimedLife(CreateUnit(p,'e0VN',x1,y1,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0VL',x1,y1,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0VM',x1,y1,GetRandomReal(0,359)),'BTLF',2)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call UnitRemoveAbility(u,'A10V')
call DestroyTimer(t)
endif
endif
set u=null
set t=null
set l__d=null
set p=null
endfunction
function BrilliantFlameLightningCast2 takes nothing returns nothing//nats
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local unit d1=LoadUnitHandle(h,id,9)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local real f=GetUnitFacing(u)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroStr(u,true)*(GetUnitAbilityLevel(u,'A10S')+3)
local real dist=SR(x,y,x1,y1)
local real a=Atan2(y1-y,x1-x)
local real he=0
local real dist2=LoadReal(h,id,100)
local real mxd=LoadReal(h,id,4)
local real time=LoadReal(h,id,8)
if dist2>580 and dist2<620 and udg_B==true and time==0 then
call SetUnitXY_1(l__d,GetUnitX(u)+25*Cos(a),GetUnitY(u)+25*Sin(a), false)
call SaveReal(h,id,100,dist2-25)
call SaveReal(h,id,8,time+0.03)
endif
if dist2>50.00 and udg_B==true and DU2==true then
call SaveReal(h,id,100,dist2-mxd/50)
set x=x+mxd/50*Cos(a)
set y=y+mxd/50*Sin(a)
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,450*(dist/mxd),0)
call SetUnitFlyHeight(d1,450*(dist/mxd),0)
call SetUnitXY_1(l__d,x,y, false)
set x=GetUnitX(d1)
set y=GetUnitY(d1)
set a=Atan2(y1-y,x1-x)
set x=x+mxd/50*Cos(a)
set y=y+mxd/50*Sin(a)
call SetUnitX(d1,x)
call SetUnitY(d1,y)
call PauseUnit(u,true)
call SetUnitAnimation(u,"Spell Three")
else
call SaveReal(h,id,8,time+0.03)
if time<1.03 then
call GroupEnumUnitsInRange(G,x1,y1,400,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg/32,false,false,null,null,null)
call SetControlToUnit(E,E, 1, "stun")
endif
call GroupRemoveUnit(G,E)
endloop
call SetUnitFlyHeight(u,0,450)
if GetUnitAbilityLevel(u,'A10V')>0 then
call UnitRemoveAbility(u,'A10V')
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
endif
if ModuloReal(time,0.07)<0.01 then
call UnitApplyTimedLife(CreateUnit(p,'e0VL',x1,y1,GetRandomReal(0,359)),'BTLF',0.5)
call UnitApplyTimedLife(CreateUnit(p,'e0VM',x1,y1,GetRandomReal(0,359)),'BTLF',0.5)
set n=CreateUnit(p,'e0VP',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.5)
call SetUnitScale(n,5,5,5)
call SetUnitFlyHeight(n,75,0)
endif
else
call KillUnit(l__d)
call KillUnit(d1)
call UnitApplyTimedLife(CreateUnit(p,'e0VN',x1,y1,GetRandomReal(0,359)),'BTLF',2)
//call UnitApplyTimedLife(CreateUnit(p,'e0VL',x1,y1,GetRandomReal(0,359)),'BTLF',2)
//call UnitApplyTimedLife(CreateUnit(p,'e0VM',x1,y1,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0QI',x1,y1,GetRandomReal(0,359)),'BTLF',0.01)
call UnitApplyTimedLife(CreateUnit(p,'e0QG',x1,y1,GetRandomReal(0,359)),'BTLF',0.01)
//call UnitApplyTimedLife(CreateUnit(p,'e0QK',x1,y1,GetRandomReal(0,359)),'BTLF',2)
//call UnitApplyTimedLife(CreateUnit(p,'e0QH',x1,y1,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0AX',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0AW',x1,y1,GetRandomReal(0,359)),'BTLF',0.01)
//call UnitApplyTimedLife(CreateUnit(p,'e0B1',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0B4',x1,y1,GetRandomReal(0,359)),'BTLF',1)
//call UnitApplyTimedLife(CreateUnit(p,'e0AZ',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0B3',x1,y1,GetRandomReal(0,359)),'BTLF',1)
//call UnitApplyTimedLife(CreateUnit(p,'e0C7',x1,y1,GetRandomReal(0,359)),'BTLF',6)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
endif
endif
set d1=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
function BrilliantFlameCast takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real f=GetUnitFacing(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local real x2=GetUnitX(u)-600*Cos(a)
local real y2=GetUnitY(u)-600*Sin(a)
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)<600 then
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
call SetUnitXY_1(u,x2,y2, false)
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
endif
if SR(x,y,x1,y1)<101 then
call SaveReal(h,id,100,600)
call SaveReal(h,id,4,600)
else
call SaveReal(h,id,100,SR(x,y,x1,y1))
call SaveReal(h,id,4,SR(x,y,x1,y1))
endif
call DestroyEffect(AddSpecialEffect("war3mapImported\\Slam.mdl",x,y))
call UnitAddAbility(u,'Arav')
call UnitRemoveAbility(u,'Arav')
call SaveUnitHandle(h,id,0,u)
call SetUnitInvulnerable(u,true)
call SaveReal(h,id,2,x1)
call SaveReal(h,id,3,y1)
call SaveReal(h,id,8,0)
call PauseUnit(u,true)
call UnitAddAbility(u,'A10V')
if GetUnitAbilityLevel(u,'NAE1')==0 then
call SetUnitFlyHeight(u,450,0)
if LoadReal(h,id,100)==600 then
set n=CreateUnit(p,0x6530564B,x2,y2,GetRandomReal(0,359))
else
set n=CreateUnit(p,0x6530564B,x,y,a*bj_RADTODEG)
endif
call SaveUnitHandle(h,id,7,n)
set soundplay=SndN(2248) // Sound\Music\mp3Music\Natsu Dragneel  Fire Dragon's Brilliant Flame.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.03,true,function BrilliantFlameCast2)
else
call SetUnitFlyHeight(u,350,0)
if LoadReal(h,id,100)==600 then
set n=CreateUnit(p,0x6530564B,x2,y2,GetRandomReal(0,359))
call SaveUnitHandle(h,id,7,n)
set n=CreateUnit(p,'e0VP',x2,y2,GetRandomReal(0,359))
call SaveUnitHandle(h,id,9,n)
else
set n=CreateUnit(p,0x6530564B,x+200*Cos(a+deg90),y+200*Sin(a+deg90),a*bj_RADTODEG)
call SaveUnitHandle(h,id,7,n)
set n=CreateUnit(p,'e0VP',x-200*Cos(a+deg90),y-200*Sin(a+deg90),a*bj_RADTODEG)
call SaveUnitHandle(h,id,9,n)
endif
set soundplay=SndN(2250) // Sound\Music\mp3Music\Ryuujin no Kouen.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.03,true,function BrilliantFlameLightningCast2)
endif
set u=null
set p=null
set t=null
endfunction
function NatsuDragonRoarCond takes nothing returns boolean
return GetSpellAbilityId()=='A10R' and udg_B==true
endfunction
function NatsuDragonRoarLightningCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real a=LoadReal(h,id,11)
local real dist=LoadReal(h,id,2)
local real x=GetUnitX(l__d)+65*Cos(a)
local real y=GetUnitY(l__d)+65*Sin(a)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real dmg=LoadReal(h,id,4)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,12)
local real s1=LoadReal(h,id,10)
local real time=LoadReal(h,id,15)
if dist>0 and RectContainsUnit(WorldBoundsR(),l__d)and UnitIsAlive(l__d)then
call SetUnitXY_1(l__d,x,y, false)
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,0.65,0.65,0.65)
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,255,230,100,50)
set n=CreateUnit(p,'e0RE',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,255,230,100,255)
set n=CreateUnit(p,'e0QG',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,255,255,255,75)
set n=CreateUnit(p,'e0QG',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitVertexColor(n,255,255,255,50)
set n=CreateUnit(p,'e0QG',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,2,2,2)
call SetUnitVertexColor(n,255,255,255,25)
set n=CreateUnit(p,'e0QO',x1,y1,GetRandomReal(0,359))
call SetUnitTimeScale(n,3)
call UnitApplyTimedLife(n,'BTLF',0.1)
call SetUnitScale(l__d,0.10+s1,0.10+s1,0.10+s1)
call SaveReal(h,id,10,s1+0.15)
set n=CreateUnit(p,'e0VJ',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',2.5)
call SetUnitTimeScale(n,1)
call SetUnitFlyHeight(n,85+s1*40,0)
call SetUnitScale(n,0.3+s1,0.3+s1,0.3+s1)
set n=CreateUnit(p,'e0QH',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',2.5)
call SetUnitScale(n,0.65+s1,0.65+s1,0.65+s1)
call GroupEnumUnitsInRange(g,x,y,150+s1*30,Base)
set idg=GetHandleId(g)
call SaveReal(h,id,2,dist-65)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
else
call SaveReal(h,id,15,time+0.05)
if time<0.3 then
call SetUnitTimeScale(u,1)
call RemoveUnit(l__d)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call FlushChildHashtable(h,GetHandleId(g))
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
endif
set g=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
function NatsuDragonRoarLightningCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,5)
local real y1=LoadReal(h,id,6)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real dmg=LoadReal(h,id,4)
local real dist=LoadReal(h,id,2)
local real scale=LoadReal(h,id,10)
local real time=LoadReal(h,id,15)
if time<0.5 then
call SaveReal(h,id,15,time+0.1)
call PauseUnit(u,true)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,0.65,0.65,0.65)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,255,230,100,50)
set n=CreateUnit(p,'e0RE',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,255,230,100,255)
set n=CreateUnit(p,'e0QG',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,255,255,255,75)
set n=CreateUnit(p,'e0QG',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitVertexColor(n,255,255,255,50)
set n=CreateUnit(p,'e0QG',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,2,2,2)
call SetUnitVertexColor(n,255,255,255,25)
set n=CreateUnit(p,'e0QO',x,y,GetRandomReal(0,359))
call SetUnitTimeScale(n,3)
call UnitApplyTimedLife(n,'BTLF',0.1)
call SetUnitInvulnerable(u,true)
else
call SaveReal(h,id,15,0)
set n=CreateUnit(p,'e0VO',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1.5)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,255,230,255,255)
call SetUnitTimeScale(u,3)
call SetUnitAnimation(u,"spell two")
call RemoveUnit(l__d)
call SaveUnitHandle(h,id,7,CreateUnit(p,'e0VJ',x+45*Cos(a),y+45*Sin(a),a*bj_RADTODEG))
set n=CreateUnit(p,'e0VI',x+75*Cos(a),y+75*Sin(a),a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1.5)
call SetUnitTimeScale(n,2)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call PauseTimer(t)
call TimerStart(t,0.05,true,function NatsuDragonRoarLightningCast3)
endif
set l__d=null
set p=null
set u=null
set t=null
endfunction
function NatsuDragonRoarCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real a=LoadReal(h,id,11)
local real dist=LoadReal(h,id,2)
local real x=GetUnitX(l__d)+65*Cos(a)
local real y=GetUnitY(l__d)+65*Sin(a)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real dmg=LoadReal(h,id,4)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,12)
local real s1=LoadReal(h,id,10)
local real time=LoadReal(h,id,15)
if dist>0 and RectContainsUnit(WorldBoundsR(),l__d)and UnitIsAlive(l__d)then
call SetUnitXY_1(l__d,x,y, false)
call PauseUnit(u,true)
call SetUnitScale(l__d,0.10+s1,0.10+s1,0.10+s1)
call SaveReal(h,id,10,s1+0.15)
set n=CreateUnit(p,'e0VJ',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1.75)
call SetUnitTimeScale(n,1)
call SetUnitFlyHeight(n,85+s1*40,0)
call SetUnitScale(n,0.1+s1,0.1+s1,0.1+s1)
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl",x,y))
call GroupEnumUnitsInRange(g,x,y,150+s1*30,Base)
set idg=GetHandleId(g)
call SaveReal(h,id,2,dist-65)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
else
call SaveReal(h,id,15,time+0.05)
if time<0.3 then
call SetUnitTimeScale(u,1)
call RemoveUnit(l__d)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call FlushChildHashtable(h,GetHandleId(g))
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
endif
set g=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
