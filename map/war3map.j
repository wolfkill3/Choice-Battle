    set n=CreateUnit(p,'ed0O',x1,y1,0)
    call SetUnitVertexColor(n,255,255,255,155)
    call SetUnitScale(n,1.2,1.2,1.2)
    call UnitApplyTimedLife(n,'BTLF',1.8)
    call GroupEnumUnitsInRange(G,x1,y1,600,Base)
    loop
    set E=FirstOfGroup(G)
    exitwhen E==null
    if Condition_Base(p,E)then
    call myCustomDamage(u,E,dmg,false,false,null,null,null)
    call CC_UnitEx( E, E, 0., 4, "root", false, "war3mapImported\\Aoda2.mdx", "origin", 0,0 )
    set n=CreateUnit(p,'or10',GetUnitX(E),GetUnitY(E),a*bj_RADTODEG)
    call UnitApplyTimedLife(n,'BTLF',3)
    endif
    call GroupRemoveUnit(G,E)
    endloop
    call SaveReal(h,id,3,0)
    call GroupClear(g1)
    call PauseTimer(t)
    call TimerStart(t,0.05,true,function OrochimaruWCast6)
    endif
    set g=null
    set g1=null
    set p=null
    set t=null
    set u=null
endfunction
