function CastGalickGun2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real a=LoadReal(h,id,4)
local real dist=LoadReal(h,id,10)
local real x=GetUnitX(l__d)+30*Cos(a)
local real y=GetUnitY(l__d)+30*Sin(a)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real dmg=(2+GetUnitAbilityLevel(u,'A0IM'))*GetHeroStr(u,true)+75
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,3)
local real time=LoadReal(h,id,5)
if time<0.8 then
call SaveReal(h,id,5,time+0.017)
if time==0.799 then
if GetUnitAbilityLevel(u,'A0P1')==0 then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\GalickGun.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call DestroyEffect(LoadEffectHandle(h,id,7))
call DestroyEffect(LoadEffectHandle(h,id,8))
call SetUnitTimeScale(u,1)
call UnitApplyTimedLife(CreateUnit(p,'e0DA',x1,y1,a*bj_RADTODEG),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e0DB',x1+45*Cos(a),y1+45*Sin(a),a*bj_RADTODEG),1,1)
set n=CreateUnit(GetOwningPlayer(u),'e0D9',x1+35*Cos(a),y1+35*Sin(a),a*bj_RADTODEG)
call SaveUnitHandle(h,id,1,n)
call SetUnitColor(n,PLAYER_COLOR_PINK)
else
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call DestroyEffect(LoadEffectHandle(h,id,7))
call SetUnitTimeScale(u,1)
set n=CreateUnit(GetOwningPlayer(u),'e0E5',x1+35*Cos(a),y1+35*Sin(a),a*bj_RADTODEG)
call SaveUnitHandle(h,id,1,n)
call SetUnitColor(n,PLAYER_COLOR_GREEN)
endif
endif
else
if dist>0 and IsTerrainPathable(GetUnitX(l__d),GetUnitY(l__d),PATHING_TYPE_FLYABILITY)==false then
call SetUnitXY_1(l__d,x,y, false)
if GetUnitAbilityLevel(u,'A0OY')>0 then
set dmg=dmg+GetHeroStr(u,true)
set n=CreateUnit(p,'e0HN',x,y,a*bj_RADTODEG)
call SetUnitTimeScale(n,0)
call SetUnitColor(n,PLAYER_COLOR_PINK)
call UnitApplyTimedLife(n,1,1)
call UnitApplyTimedLife(CreateUnit(p,'e0D8',x,y,GetRandomReal(0,359)),1,1)
elseif GetUnitAbilityLevel(u,'A0TE')>0 then
set dmg=dmg+GetHeroStr(u,true)
set n=CreateUnit(p,'e0HN',x,y,a*bj_RADTODEG)
call SetUnitTimeScale(n,0)
call SetUnitColor(n,PLAYER_COLOR_PINK)
call UnitApplyTimedLife(n,1,1)
call UnitApplyTimedLife(CreateUnit(p,'e0D8',x,y,GetRandomReal(0,359)),1,1)
elseif GetUnitAbilityLevel(u,'A0OZ')>0 then
set dmg=dmg+2*GetHeroStr(u,true)
set n=CreateUnit(p,'e0HN',x,y,a*bj_RADTODEG)
call SetUnitTimeScale(n,0)
call SetUnitColor(n,PLAYER_COLOR_PINK)
call UnitApplyTimedLife(n,1,1)
call UnitApplyTimedLife(CreateUnit(p,'e0D8',x,y,GetRandomReal(0,359)),1,1)
elseif GetUnitAbilityLevel(u,'A0P0')>0 then
set dmg=dmg+3*GetHeroStr(u,true)
set n=CreateUnit(p,'e0HN',x,y,a*bj_RADTODEG)
call SetUnitTimeScale(n,0)
call SetUnitColor(n,PLAYER_COLOR_PINK)
call UnitApplyTimedLife(n,1,1)
call UnitApplyTimedLife(CreateUnit(p,'e0D8',x,y,GetRandomReal(0,359)),1,1)
elseif GetUnitAbilityLevel(u,'A0P1')>0 then
set dmg=dmg+4*GetHeroStr(u,true)
set n=CreateUnit(p,'e0R8',x,y,a*bj_RADTODEG)
call SetUnitTimeScale(n,0)
call SetUnitColor(n,PLAYER_COLOR_GREEN)
call UnitApplyTimedLife(n,1,1.2)
call UnitApplyTimedLife(CreateUnit(p,'e0R9',x,y,GetRandomReal(0,359)),1,1.2)
elseif GetUnitAbilityLevel(u,'A16J')==0 or GetUnitAbilityLevel(u,'A16W')==0 then
set dmg=dmg+4*GetHeroStr(u,true)
set n=CreateUnit(p,'e0HN',x,y,a*bj_RADTODEG)
call SetUnitTimeScale(n,0)
call SetUnitColor(n,PLAYER_COLOR_PINK)
call UnitApplyTimedLife(n,1,1)
call UnitApplyTimedLife(CreateUnit(p,'e0D8',x,y,GetRandomReal(0,359)),1,1)
endif
call GroupEnumUnitsInRange(g,x,y,150,Base)
set idg=GetHandleId(g)
call SaveReal(h,id,10,dist-30)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
else
call GroupEnumUnitsInRange(g,x,y,400,Base)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
call ShakeCamera(0.5,20)
call UnitApplyTimedLife(CreateUnit(p,'e0DC',x,y,(a*bj_RADTODEG)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0DF',x,y,(a*bj_RADTODEG)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0DE',x,y,(a*bj_RADTODEG)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0DD',x,y,(a*bj_RADTODEG)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0C7',x,y,(a*bj_RADTODEG)),1,6)
call StartSound(soundStr[47])
call RemoveUnit(l__d)
call FlushChildHashtable(h,GetHandleId(g))
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
endif
set g=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
function CastGalickGun takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local effect e
local effect e1
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,3,CreateGroup())
call SaveReal(h,id,4,a)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
if GetUnitAbilityLevel(u,'A0P1')==0 then
if GetUnitAbilityLevel(u,'A16J')==0 and GetUnitAbilityLevel(u,'A16W')==0 then
call SaveReal(h,id,10,3500)
else
call SaveReal(h,id,10,5500)
endif
call UnitApplyTimedLife(CreateUnit(p,'e0D7',x-25*Cos(a+90*bj_DEGTORAD),y-25*Sin(a+90*bj_DEGTORAD),GetRandomReal(0,359)),1,1)
call SetUnitTimeScale(u,0.58)
set e=AddSpecialEffectTarget("war3mapImported\\gallit gun.mdx",u,"chest")
set e1=AddSpecialEffectTarget("war3mapImported\\PurpleMissile.mdl",u,"hand")
call SaveEffectHandle(h,id,7,e)
call SaveEffectHandle(h,id,8,e1)
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\GalickGun2.mp3",false,false,true,12700,12700,"")
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Vegeta\\GalickGun2-jap.mp3",false,false,true,12700,12700,"")
endif
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call SetUnitAnimation(u,"Spell Two")
else
call SaveReal(h,id,10,5500)
call SetUnitTimeScale(u,0.7)
set e=AddSpecialEffectTarget("war3mapImported\\GreenChakra.mdx",u,"origin")
call SaveEffectHandle(h,id,7,e)
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\FinalShineAttack.mp3",false,false,true,12700,12700,"")
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Vegeta\\FinalShineAttack-jap.mp3",false,false,true,12700,12700,"")
endif
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
if GetUnitAbilityLevel(u,'A0P1')>0 then
call SetUnitAnimation(u,"Spell One Alternate")
else
call SetUnitAnimation(u,"Spell One")
endif
endif
call TimerStart(t,0.017,true,function CastGalickGun2)
set u=null
set p=null
set e=null
set e1=null
set t=null
endfunction
function GalickGunInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function CastGalickGun)
call TriggerAddCondition(t,Condition(function CondGalickGun))
set t=null
endfunction
function BigBangAttackCond takes nothing returns boolean
return GetSpellAbilityId()=='A0IO'
endfunction
function BigBangAttackCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x2=LoadReal(h,id,2)
local real y2=LoadReal(h,id,3)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real a=Atan2(y2-y1,x2-x1)
local real a2
local player p=GetOwningPlayer(u)
local real dmg=150+GetHeroStr(u,true)*(GetUnitAbilityLevel(u,'A0IO')+1)
if SR(x1,y1,x2,y2)>26.00 then
set x1=x1+45*Cos(a)
set y1=y1+45*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
else
call UnitApplyTimedLife(CreateUnit(p,'e048',x1,y1,0),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e03W',x1,y1,0),0,4)
call UnitApplyTimedLife(CreateUnit(p,'e06O',x1,y1,0),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e06N',x1,y1,0),1,3)
call DestroyEffect(AddSpecialEffect("war3mapImported\\explode.mdx",x1,y1))
call DestroyEffect(AddSpecialEffect("war3mapImported\\SuperBigExplosion.mdx",x1,y1))
call StartSound(soundStr[47])
call GroupEnumUnitsInRange(DG,x1,y1,400,Base)
loop
set E=FirstOfGroup(DG)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 2, "stun")
endif
call GroupRemoveUnit(DG,E)
endloop
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call RemoveUnit(l__d)
endif
set l__d=null
set p=null
set u=null
set t=null
endfunction
function BigBangAttackCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
if GetUnitAbilityLevel(u,'A0P1')==0 then
call SetUnitAnimation(u,"Spell One")
else
call SetUnitAnimation(u,"Spell One Alternate")
endif
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,x1)
call SaveReal(h,id,3,y1)
call SaveUnitHandle(h,id,1,CreateUnit(p,'e0DG',x,y,a*bj_RADTODEG))
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\BigBandAttack.mp3",false,false,true,12700,12700,"")
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Vegeta\\BigBandAttack-jap.mp3",false,false,true,12700,12700,"")
endif
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call UnitApplyTimedLife(CreateUnit(p,'e0DH',x+25*Cos(a),y+25*Sin(a),a*bj_RADTODEG),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e0DI',x+25*Cos(a),y+25*Sin(a),a*bj_RADTODEG),1,1)
call TimerStart(t,0.03,true,function BigBangAttackCast2)
set u=null
set p=null
set t=null
endfunction
function InitBigBangAttack takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function BigBangAttackCast)
call TriggerAddCondition(t,Condition(function BigBangAttackCond))
set t=null
endfunction



function GinD_Periodic takes nothing returns nothing
        local integer id = GetHandleId(GetExpiredTimer())
        local real point_x = LoadReal(h, id, StringHash("PointX"))
        local real point_y = LoadReal(h, id, StringHash("PointY"))
        local real time = LoadReal(h, id, TIME_HASH)
        local boolean bTeleport = LoadBoolean(h, id, StringHash("TeleportBoolean"))
        if GetUnitCurrentOrder(LoadUnitHandle(h,id,CasterHash))==OrderId("acidbomb") then
                call SaveReal(h, id, TIME_HASH, time+0.05)
                set bjLCU = LoadUnitHandle(h, id, StringHash("EffectUnit1"))
                call SetUnitX(bjLCU, GetUnitX(LoadUnitHandle(h,id,CasterHash)))
                call SetUnitY(bjLCU, GetUnitY(LoadUnitHandle(h,id,CasterHash)))
                if time<1 then
                        if LoadInteger(h, id, EffectPeriodHash)==0 then
                                set bjLCU = CreateUnit(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)),'e0DT',GetUnitX(LoadUnitHandle(h,id,CasterHash)),GetUnitY(LoadUnitHandle(h,id,CasterHash)),GetRandomInt(0,360))
                                call UnitApplyTimedLife(bjLCU,1,1)
                                call SetUnitVertexColor(bjLCU, 255, 255, 255, 100)
                                call MyRemoveUnit(bjLCU, 2)
                                call SaveInteger(h, id, EffectPeriodHash, 2)
                        else
                                call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash)-1)
                        endif
                else
                        call IssueImmediateOrder(LoadUnitHandle(h,id,CasterHash), "stop")
                        call SaveBoolean(h, id, StringHash("TeleportBoolean"), true)
                endif
        else
                set bjLCG = LoadGroupHandle(h, id, GroupHash)
                if bTeleport then
                        set soundplay=CreateSound("Sound\\war3mapImported\\GinD_2.mp3",false,false,true,12700,12700,"")
                        call StartSound(soundplay)
                        call KillSoundWhenDone(soundplay)
                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dH18', GetUnitX(LoadUnitHandle(h,id,CasterHash)),GetUnitY(LoadUnitHandle(h,id,CasterHash)), GetRandomInt(0, 360))
                        call SetUnitScale(n, 1.5, 1.5, 1.5)
                        call MyRemoveUnit(n, 1.5)
                        call GroupEnumUnitsInRange(bjLCG, GetUnitX(LoadUnitHandle(h,id,CasterHash)), GetUnitY(LoadUnitHandle(h,id,CasterHash)), 300, Base)
                        loop
                        set E=FirstOfGroup(bjLCG)
                        exitwhen E==null
                                if FilterA(LoadUnitHandle(h,id,CasterHash), E) then
                                        call SetUnitX(E, point_x+100*Cos(GetRandomReal(0.0, 6.28)))
                                        call SetUnitY(E, point_y+100*Sin(GetRandomReal(0.0, 6.28)))
                                endif
                                call GroupRemoveUnit(bjLCG, E)
                        endloop
                        call SetUnitX(LoadUnitHandle(h,id,CasterHash), point_x)
                        call SetUnitY(LoadUnitHandle(h,id,CasterHash), point_y)
                        set bjLCU = CreateUnit(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)),'e0DT', point_x, point_y,GetRandomInt(0,360))
                        call UnitApplyTimedLife(bjLCU,1,1)
                        call SetUnitVertexColor(bjLCU, 255, 255, 255, 130)
                        call MyRemoveUnit(bjLCU, 2)
                        set bjLCU = CreateUnit(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)),'e0DS', point_x, point_y,GetRandomInt(0,360))
                        call UnitApplyTimedLife(bjLCU,1,1)
                        call SetUnitTimeScale(bjLCU, 0.75)
                        call MyRemoveUnit(bjLCU, 2)
                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dH18', point_x, point_y, GetRandomInt(0, 360))
                        call SetUnitScale(n, 1.5, 1.5, 1.5)
                        call MyRemoveUnit(n, 1.5)
                endif
                call KillUnit(LoadUnitHandle(h, id, StringHash("EffectUnit1")))
                call MyRemoveUnit(LoadUnitHandle(h, id, StringHash("EffectUnit1")), 2)
                call DestroyGroup(bjLCG)
                call FlushChildHashtable(h, id)
                call DestroyTimer(GetExpiredTimer())
        endif
endfunction

function GinD_Cast takes unit newCaster, real point_x, real point_y, timer newTimer returns nothing
        local integer id = GetHandleId(newTimer)
        local real caster_x = GetUnitX(newCaster)
        local real caster_y = GetUnitY(newCaster)
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\GinW.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        set bjLCU = CreateUnit(GetOwningPlayer(newCaster),'e0DS',caster_x,caster_y,GetRandomInt(0,360))
        call SetUnitTimeScale(bjLCU, 0.75)
        call SaveUnitHandle(h, id, StringHash("EffectUnit1"), bjLCU)
        set bjLCU = CreateUnit(GetOwningPlayer(newCaster),'e0DT',caster_x,caster_y,GetRandomInt(0,360))
        call UnitApplyTimedLife(bjLCU,1,1)
        call MyRemoveUnit(bjLCU, 2)
        call SaveUnitHandle(h, id, CasterHash, newCaster)
        call SaveReal(h, id, StringHash("PointX"), point_x)
        call SaveReal(h, id, StringHash("PointY"), point_y)
        call SaveGroupHandle(h, id, GroupHash, CreateGroup())
        call TimerStart(newTimer, 0.05, true, function GinD_Periodic)
endfunction


function GinW_Act2_Periodic takes nothing returns nothing
        local integer id = GetHandleId(GetExpiredTimer())
        local real angle = LoadReal(h, id, AngleHash)
        local real time = LoadReal(h, id, TIME_HASH)
        local real damage = 150 + GetHeroAgi(LoadUnitHandle(h, id, CasterHash), true)*GetUnitAbilityLevel(LoadUnitHandle(h, id, CasterHash), 'GinW')
        if time<2 then
                call SaveReal(h, id, TIME_HASH, time+0.01)
                call SetUnitX(LoadUnitHandle(h, id, TargetHash), GetUnitX(LoadUnitHandle(h, id, TargetHash))+4*Cos(angle))
                call SetUnitY(LoadUnitHandle(h, id, TargetHash), GetUnitY(LoadUnitHandle(h, id, TargetHash))+4*Sin(angle))
                call SetUnitX(LoadUnitHandle(h, id, CasterHash), GetUnitX(LoadUnitHandle(h, id, TargetHash))-45*Cos(angle))
                call SetUnitY(LoadUnitHandle(h, id, CasterHash), GetUnitY(LoadUnitHandle(h, id, TargetHash))-45*Sin(angle))
                call SetUnitInvulnerable(LoadUnitHandle(h, id, CasterHash), true)
                call SetUnitInvulnerable(LoadUnitHandle(h, id, TargetHash), true)
                call PauseUnit(LoadUnitHandle(h, id, TargetHash), true)
                call PauseUnit(LoadUnitHandle(h, id, CasterHash), true)
                if LoadInteger(h, id, EffectPeriodHash)==0 then
                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dH34', GetUnitX(LoadUnitHandle(h, id, TargetHash))+60*Cos(angle), GetUnitY(LoadUnitHandle(h, id, TargetHash))+60*Sin(angle), angle*bj_RADTODEG+GetRandomInt(-45, 45))
                        call SetUnitFlyHeight(n, 75, 0)
                        call SetUnitScale(n, 0.75, 0.75, 0.75)
                        call MyRemoveUnit(n, 1)
                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dH35', GetUnitX(LoadUnitHandle(h, id, TargetHash))+60*Cos(angle), GetUnitY(LoadUnitHandle(h, id, TargetHash))+60*Sin(angle), angle*bj_RADTODEG+GetRandomInt(-45, 45)+180)
                        call SetUnitFlyHeight(n, 75, 0)
                        call SetUnitScale(n, 1.5, 1.5, 1.5)
                        call MyRemoveUnit(n, 1)
                        call SaveInteger(h, id, EffectPeriodHash, 9)
                else
                        call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash)-1)
                endif
        else
                call SetUnitTimeScale(LoadUnitHandle(h, id, CasterHash), 1)
                call ShakeCamera(0.2, 5)
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dR64', GetUnitX(LoadUnitHandle(h, id, TargetHash)) + 50 * Cos(angle), GetUnitY(LoadUnitHandle(h, id, TargetHash)) + 50 * Sin(angle), angle * bj_RADTODEG)
                call SetUnitFlyHeight(bjLCU, 160, 0)
                call SetUnitScale(bjLCU, 1.2, 1.2, 1.2)
                call MyRemoveUnit(bjLCU , 1.5)
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dH34', GetUnitX(LoadUnitHandle(h, id, TargetHash)) + 100 * Cos(angle), GetUnitY(LoadUnitHandle(h, id, TargetHash)) + 100 * Sin(angle), angle * bj_RADTODEG)
                call SetUnitFlyHeight(bjLCU, 75, 0)
                call SetUnitScale(bjLCU, 1.25, 1.25, 1.25)
                call SetUnitTimeScale(bjLCU, 0.7)
                call MyRemoveUnit(bjLCU , 1.5)
                set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dH02', GetUnitX(LoadUnitHandle(h, id, TargetHash)), GetUnitY(LoadUnitHandle(h, id, TargetHash)), angle*bj_RADTODEG)
                call SetUnitFlyHeight(n, 75, 0)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dR37', GetUnitX(LoadUnitHandle(h, id, TargetHash)), GetUnitY(LoadUnitHandle(h, id, TargetHash)), angle*bj_RADTODEG)
                call SetUnitFlyHeight(n, 75, 0)
                call SetUnitScale(n, 2, 2, 2)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dH02', GetUnitX(LoadUnitHandle(h, id, TargetHash)), GetUnitY(LoadUnitHandle(h, id, TargetHash)), angle*bj_RADTODEG)
                call SetUnitFlyHeight(n, 75, 0)
                call SetUnitScale(n, 2, 2, 2)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dR42', GetUnitX(LoadUnitHandle(h, id, TargetHash)), GetUnitY(LoadUnitHandle(h, id, TargetHash)), angle*bj_RADTODEG)
                call SetUnitFlyHeight(n, 75, 0)
                call SetUnitScale(n, 0.6, 0.6, 0.6)
                call SetUnitTimeScale(n, 0.6)
                call MyRemoveUnit(n, 1.5)
                
                call SetUnitInvulnerable(LoadUnitHandle(h, id, CasterHash), false)
                call PauseUnit(LoadUnitHandle(h, id, CasterHash), false)
                call SetUnitAnimationByIndex(LoadUnitHandle(h, id, CasterHash), 9)
                call SetUnitInvulnerable(LoadUnitHandle(h, id, TargetHash), false)
                call PauseUnit(LoadUnitHandle(h, id, TargetHash), false)
                call SaveBoolean(HH,GetHandleId(LoadUnitHandle(h, id, TargetHash)),TARGET_ABILITY,false)
                call GinT_AddStack(LoadUnitHandle(h, id, CasterHash), LoadUnitHandle(h, id, TargetHash))
                call myCustomDamage(LoadUnitHandle(h, id, CasterHash), LoadUnitHandle(h, id, TargetHash), damage, false , false , null , null , null)
                call SetControlToUnit(LoadUnitHandle(h, id, CasterHash), LoadUnitHandle(h, id, TargetHash), 1.0, "stun")
                call Push(LoadUnitHandle(h, id, CasterHash), 60, angle-180*bj_DEGTORAD, 750)
                call Push(LoadUnitHandle(h, id, TargetHash), 60, angle, 350)
                call IssueImmediateOrder(LoadUnitHandle(h, id, CasterHash), "stop")
                call FlushChildHashtable(h, id)
                call DestroyTimer(GetExpiredTimer())
        endif
endfunction

function GinW_Periodic takes nothing returns nothing
        local integer id = GetHandleId(GetExpiredTimer())
        local real distance = LoadReal(h, id, StringHash("Distance"))
        local real caster_x = GetUnitX(LoadUnitHandle(h, id, CasterHash))
        local real caster_y = GetUnitY(LoadUnitHandle(h, id, CasterHash))
        local real angle = LoadReal(h, id, AngleHash)
        if distance<1000 then
            call SetUnitX(LoadUnitHandle(h, id, CasterHash), caster_x+35*Cos(angle))
            call SetUnitY(LoadUnitHandle(h, id, CasterHash), caster_y+35*Sin(angle))
            call SaveReal(h, id, StringHash("Distance"), distance+35)
            if LoadInteger(h, id, EffectPeriodHash)<=0 then
                set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dR88', caster_x, caster_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 0.7, 0.7, 0.7)
                call MyRemoveUnit(n, 1.3)
                set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dR45', caster_x, caster_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 0.7, 0.7, 0.7)
                call MyRemoveUnit(n, 1.3)
                call SaveInteger(h, id, EffectPeriodHash, 7)
            else
                call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash)-1)
            endif
            set bjLCG = LoadGroupHandle(h, id, GroupHash)
            call GroupEnumUnitsInRange(bjLCG, caster_x, caster_y, 125, Base)
            loop
            set bjLCU = FirstOfGroup(bjLCG)
            exitwhen bjLCU==null
                if Condition_Base(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), bjLCU) and IsUnitInvulnerable(bjLCU)==false then
                    call SaveReal(h, id, StringHash("Distance"), 99999)
                    if LoadBoolean(HH,GetHandleId(bjLCU),ANTITARGET_ABILITY)==false then
                        call SaveUnitHandle(h, id, TargetHash, bjLCU)
                    else
                        call SaveBoolean(HH,GetHandleId(LoadUnitHandle(h, id, CasterHash)),DASH_USER,false)
                        call SaveUnitHandle(HH,GetHandleId(bjLCU),REVERSE_TARGET,LoadUnitHandle(h, id, CasterHash))
                    endif
                    call GroupClear(bjLCG)
                endif
                call GroupRemoveUnit(bjLCG, bjLCU)
            endloop
        else
            if LoadUnitHandle(h, id, TargetHash)==null then
                call PauseUnit(LoadUnitHandle(h, id, CasterHash), false)
                call IssueImmediateOrder(LoadUnitHandle(h, id, CasterHash), "stop")
                call SetUnitAnimationByIndex(LoadUnitHandle(h, id, CasterHash), 9)
                call StartAbilityCooldown(GetUnitAbility(LoadUnitHandle(h, id, CasterHash), 'GinW'), 12)
                
                set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dH18', caster_x, caster_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 0.85, 0.85, 0.85)
                call SetUnitVertexColor(n, 255, 255, 255, 200)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dR88', caster_x, caster_y, GetRandomInt(0, 360))
                call MyRemoveUnit(n, 1.5)
            else
                call SetUnitInvulnerable(LoadUnitHandle(h, id, CasterHash), true)
                call SetUnitInvulnerable(LoadUnitHandle(h, id, TargetHash), true)
                call PauseUnit(LoadUnitHandle(h, id, TargetHash), true)
                call SaveBoolean(HH,GetHandleId(LoadUnitHandle(h, id, TargetHash)),TARGET_ABILITY,true)
                call SetUnitAnimationByIndex(LoadUnitHandle(h, id, CasterHash), 8)
                call SetUnitTimeScale(LoadUnitHandle(h, id, CasterHash), 3)
                set bjLCT = CreateTimer()
                call SaveReal(h, GetHandleId(bjLCT), AngleHash, angle)
                call SaveUnitHandle(h, GetHandleId(bjLCT), CasterHash, LoadUnitHandle(h, id, CasterHash))
                call SaveUnitHandle(h, GetHandleId(bjLCT), TargetHash, LoadUnitHandle(h, id, TargetHash))
                call TimerStart(bjLCT, 0.01, true, function GinW_Act2_Periodic)
                set bjLCT = null
                set soundplay=CreateSound("Sound\\war3mapImported\\GinW"+I2S(GetRandomInt(1,3))+".mp3", false, false, true, 12700, 12700, "")
                call StartSound(soundplay)
                call KillSoundWhenDone(soundplay)
            endif
            call SetUnitVertexColor(LoadUnitHandle(h, id, CasterHash), 255, 255, 255, 255)
            call DestroyGroup(LoadGroupHandle(h, id, GroupHash))
            call FlushChildHashtable(h, id)
            call DestroyTimer(GetExpiredTimer())
        endif
endfunction

function GinW_Cast takes unit newCaster, real point_x, real point_y, timer newTimer returns nothing
        local integer id = GetHandleId(newTimer)
        local real caster_x = GetUnitX(newCaster)
        local real caster_y = GetUnitY(newCaster)
        local real angle = AtanPoint(caster_x, caster_y, point_x, point_y)
        // set soundplay=CreateSound("Sound\\Music\\mp3Music\\Soru2.mp3", false, false, true, 12700, 12700, "")
        set soundplay=CreateSound("Sound\\war3mapImported\\GinWRush.mp3", false, false, true, 12700, 12700, "")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH18',  caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 0.85, 0.85, 0.85)
        call SetUnitVertexColor(n, 255, 255, 255, 200)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dR88',  caster_x, caster_y, GetRandomInt(0, 360))
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dR42',  caster_x, caster_y, angle*bj_RADTODEG)
        call SetUnitFlyHeight(n, 50, 0)
        call SetUnitScale(n, 0.55, 0.55, 0.55)
        call MyRemoveUnit(n, 1.5)
        
        call SetUnitVertexColor(newCaster, 255, 255, 255, 100)
        call PauseUnit(newCaster, true)
        call SaveUnitHandle(h, id, CasterHash, newCaster)
        call SetUnitAnimationByIndex(newCaster, 1)
        call SaveReal(h, id, AngleHash, angle)
        call SaveGroupHandle(h, id, GroupHash, CreateGroup())
        call TimerStart(newTimer, 0.007, true, function GinW_Periodic)
endfunction

function GinT_Execute takes unit newCaster, unit newTarget returns nothing
        local real target_x = GetUnitX(newTarget)
        local real target_y = GetUnitY(newTarget)
        local real angle = GetRandomInt(0, 360)
        local integer loop_index = 0
        call ShakeCamera(0.2, 15)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH29', target_x, target_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 2, 2, 2)
        call SetUnitTimeScale(n, 0.65)
        call UnitApplyTimedLife(n, 1, 1)
        call MyRemoveUnit(n, 2.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dR90', target_x, target_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 3, 3, 3)
        call MyRemoveUnit(n, 2.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH02', target_x, target_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 3, 3, 3)
        call MyRemoveUnit(n, 2.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH30', target_x, target_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 3, 3, 3)
        call MyRemoveUnit(n, 2.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH30', target_x, target_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call MyRemoveUnit(n, 2.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH22', target_x, target_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 2, 2, 2)
        call MyRemoveUnit(n, 2.5)
        
        loop
        exitwhen loop_index==6
                set n=CreateUnit(GetOwningPlayer(newCaster), 'dR37', target_x, target_y, angle)
                call SetUnitScale(n, 3, 3, 3)
                call SetUnitFlyHeight(n, 50, 0)
                call MyRemoveUnit(n, 2.5)
                set n=CreateUnit(GetOwningPlayer(newCaster), 'dR37', target_x, target_y, angle)
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call SetUnitFlyHeight(n, 50, 0)
                call MyRemoveUnit(n, 2.5)
                set n=CreateUnit(GetOwningPlayer(newCaster), 'dH30', target_x+30*Cos(angle*bj_DEGTORAD), target_y+30*Sin(angle*bj_DEGTORAD), angle)
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call MyRemoveUnit(n, 2.5)
        set loop_index = loop_index + 1
        set angle = angle + 60
        endloop
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH31', target_x, target_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 3, 3, 3)
        call UnitApplyTimedLife(n, 1, 2)
        call MyRemoveUnit(n, 2.7)
endfunction

function GinT_Periodic takes nothing returns nothing
	local integer id = GetHandleId(GetExpiredTimer())
	local integer id_target = GetHandleId(LoadUnitHandle(HH, id, TargetHash))
	local boolean bGinT = LoadBoolean(HH, id_target, StringHash("GinT_Boolean"))
	local real damage = LoadReal(HH, id, StringHash("Damage"))/10
	local real duration = LoadReal(HH, id, StringHash("Duration"))
	local boolean bExecute = LoadBoolean(HH, id, StringHash("Execute"))
    local unit caster = LoadUnitHandle(HH, id, CasterHash)
    local unit target = LoadUnitHandle(HH, id, TargetHash)
	if duration>=0 and bGinT and GetWidgetLife(target)>0.1 then
		call SaveReal(HH, id, StringHash("Duration"), duration-0.1)
		if GetWidgetLife(target)<GetWidgetMaxLife(target)*0.125 and bExecute then
			call SaveBoolean(HH, id_target, StringHash("GinT_Boolean"), false)
			call SetUnitInvulnerable(target, false)
			call GinT_Execute(caster, target)
            call CustomTrueDamage(caster, target, GetWidgetMaxLife(target)*0.15)
            call DamageIndicatorFunction(caster, target, GetWidgetMaxLife(target)*0.15)
		else
		    call CustomTrueDamage(caster, target, damage)
		endif
	else
		call DestroyEffect(LoadEffectHandle(HH, id, Effect1Hash))
		call SaveBoolean(HH, id_target, StringHash("GinT_Boolean"), false)
		call FlushChildHashtable(HH, id)
		call DestroyTimer(GetExpiredTimer())
	endif
    set caster = null
    set target = null
endfunction


function GinT_Cast takes unit newCaster, unit newTarget, timer newTimer returns nothing
	local integer id = GetHandleId(newTimer)
	local integer id_target = GetHandleId(newTarget)
	local integer GinTStack = LoadInteger(HH, id_target, StringHash("GinT_Stack"))
	local boolean bGinT = LoadBoolean(HH, id_target, StringHash("GinT_Boolean"))
	local real full_damage = 0
	local real full_duration = 4
	if GinTStack>0 and bGinT==false then
		if GinTStack>=4 then
			set soundplay=CreateSound("Sound\\war3mapImported\\GinT_Voice.mp3", false, false, true, 12700, 12700, "")
			call StartSound(soundplay)
			call KillSoundWhenDone(soundplay)
			set soundplay=CreateSound("Sound\\war3mapImported\\GinT_Sound.mp3", false, false, true, 12700, 12700, "")
			call StartSound(soundplay)
			call KillSoundWhenDone(soundplay)
		else
			set soundplay=CreateSound("Sound\\war3mapImported\\GinT_VoiceShort.mp3", false, false, true, 12700, 12700, "")
			call StartSound(soundplay)
			call KillSoundWhenDone(soundplay)
			set soundplay=CreateSound("Sound\\war3mapImported\\GinT_SoundShort.mp3", false, false, true, 12700, 12700, "")
			call StartSound(soundplay)
			call KillSoundWhenDone(soundplay)
		endif
		set n=CreateUnit(GetOwningPlayer(newCaster), 'dR56', GetUnitX(newTarget), GetUnitY(newTarget), GetRandomInt(0, 360))
		call SetUnitScale(n, 1.25+GinTStack/5, 1.25+GinTStack/5, 1.25+GinTStack/5)
		call MyRemoveUnit(n, 2.5)
		set n=CreateUnit(GetOwningPlayer(newCaster), 'dH28', GetUnitX(newTarget), GetUnitY(newTarget), GetRandomInt(0, 360))
		call SetUnitScale(n, 1.25, 1.25, 1.25)
		call SetUnitFlyHeight(n, 75, 0)
		call SetUnitTimeScale(n, 0.65)
		call MyRemoveUnit(n, 2.5)
		if GinTStack>3 then
			call ShakeCamera(0.2, 10)
			set n=CreateUnit(GetOwningPlayer(newCaster), 'dH29', GetUnitX(newTarget), GetUnitY(newTarget), GetRandomInt(0, 360))
			call SetUnitScale(n, 2, 2, 2)
			call SetUnitTimeScale(n, 0.65)
			call UnitApplyTimedLife(n, 1, 1)
			call MyRemoveUnit(n, 2.7)
			set n=CreateUnit(GetOwningPlayer(newCaster), 'dR90', GetUnitX(newTarget), GetUnitY(newTarget), GetRandomInt(0, 360))
			call SetUnitScale(n, 3, 3, 3)
			call MyRemoveUnit(n, 2.5)
			set n=CreateUnit(GetOwningPlayer(newCaster), 'dR56', GetUnitX(newTarget), GetUnitY(newTarget), GetRandomInt(0, 360))
			call SetUnitScale(n, 1.5, 1.5, 1.255)
			call MyRemoveUnit(n, 2.5)
		endif
		//set bjLCU = CreateUnit(GetOwningPlayer(newCaster), 'dAlb', GetUnitX(newTarget), GetUnitY(newTarget), 0)
		//call UnitAddAbility(bjLCU, 'GiTs')
		//call SetUnitAbilityLevel(bjLCU, 'GiTs', GinTStack)
		//call IssueTargetOrder(bjLCU, "slow", newTarget)
        call SlowUnit(newTarget,newTarget,GinTStack*0.07,GinTStack*0.07,1.8+GinTStack*0.7,2,false)
		call MyRemoveUnit(bjLCU, 1)
		call SaveEffectHandle(HH, id, Effect1Hash, AddSpecialEffectTarget("war3mapImported\\AuraLightBlue.mdx", newTarget, "origin"))
		call SaveInteger(HH, id_target, StringHash("GinT_Stack"), 0)
		set full_damage = GetWidgetMaxLife(newTarget)*0.1 + GetWidgetMaxLife(newTarget)*(I2R(GinTStack-1)/16)
		set full_duration = 2.5 + GinTStack/2
		call SetControlToUnit(newCaster, newTarget, 1.5, "stun")
		if SquareRootUnit(newCaster, newTarget)<=800 then
			call SaveBoolean(HH, id, StringHash("Execute"), true)
			set n=CreateUnit(GetOwningPlayer(newCaster), 'dR56', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
			call SetUnitScale(n, 0.85, 0.85, 0.85)
			call MyRemoveUnit(n, 2.5)
			set n=CreateUnit(GetOwningPlayer(newCaster), 'dH28', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
			call SetUnitScale(n, 0.85, 0.85, 0.85)
			call SetUnitFlyHeight(n, 75, 0)
			call SetUnitTimeScale(n, 0.65)
			call MyRemoveUnit(n, 2.5)
		endif
		call SaveUnitHandle(HH, id, CasterHash, newCaster)
		call SaveUnitHandle(HH, id, TargetHash, newTarget)
		call SaveReal(HH, id, StringHash("Damage"), full_damage/full_duration)
		call SaveReal(HH, id, StringHash("Duration"), full_duration)
		call SaveBoolean(HH, id_target, StringHash("GinT_Boolean"), true)
		call TimerStart(newTimer, 0.1, true, function GinT_Periodic)
	else
		call IssueImmediateOrder(newCaster, "stop")
		call StartAbilityCooldown(GetUnitAbility(newCaster, 'GinT'), 3)
		call SetWidgetMana(newCaster, GetWidgetMana(newCaster)+150)
	endif
endfunction

function GinR2_CD_Periodic takes nothing returns nothing
        local integer id = GetHandleId(GetExpiredTimer())
        local integer id_caster = GetHandleId(LoadUnitHandle(h, id, CasterHash))
        local integer cd = LoadInteger(h, id_caster, StringHash("ButoRenjin"))
        if cd>0 then
                call SaveInteger(h, id_caster, StringHash("ButoRenjin"), cd-1)
        else
                call SaveInteger(h, id_caster, StringHash("ButoRenjin"), 0)
                call FlushChildHashtable(h, id)
                call DestroyTimer(GetExpiredTimer())
        endif
endfunction

function GinR2_CD takes unit newCaster, timer newTimer returns nothing
        local integer id = GetHandleId(newTimer)
        local integer id_caster = GetHandleId(newCaster)
        call SaveInteger(h, id_caster, StringHash("ButoRenjin"), 15)
        call SaveUnitHandle(h, id, CasterHash, newCaster)
        call TimerStart(newTimer, 1, true, function GinR2_CD_Periodic)
endfunction

function GinNewR_Periodic takes nothing returns nothing
        local integer id = GetHandleId(GetExpiredTimer())
        local real point_x = GetUnitX(LoadUnitHandle(h, id, CasterHash))
        local real point_y = GetUnitY(LoadUnitHandle(h, id, CasterHash))
        local real angle = LoadReal(h, id, AngleHash)
        local real time = LoadReal(h, id, TIME_HASH)
        local real dmg=(5+GetUnitAbilityLevel(LoadUnitHandle(h, id, CasterHash),'GinR'))*GetHeroAgi(LoadUnitHandle(h, id, CasterHash),true)
        local integer EffectPeriod = LoadInteger(h, id, StringHash("EffectButo"))
        local boolean second_act = LoadBoolean(h, id, StringHash("SecondAct"))
        if time<=1.1 then
                call SaveReal(h, id, TIME_HASH, time+0.005)
                if time<=1 then
                        call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash)-1)
                        if LoadInteger(h, id, EffectPeriodHash)<=0 then
                                set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)), 'dR52', point_x, point_y, GetRandomInt(0,360))
                                call SetUnitScale(n, 1.25, 1.25, 1.25)
                                call SetUnitVertexColor(n, 255, 255, 255, 90)
                                call MyRemoveUnit(n, 1.5)
                                call SaveInteger(h, id, EffectPeriodHash, 32)
                        endif
                else
                        set soundplay=CreateSound("Sound\\war3mapImported\\GinR2_Sound.mp3", false, false, true, 12700, 12700, "")
                        call StartSound(soundplay)
                        call KillSoundWhenDone(soundplay)
                        call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)),'e0DX', point_x, point_y,GetRandomReal(0,359)),1,1.5)
                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dR42', point_x, point_y, angle*bj_RADTODEG)
                        call SetUnitScale(n, 1.25, 1.25, 1.25)
                        call SetUnitTimeScale(n, 0.55)
                        call MyRemoveUnit(n, 1.5)
                        
                        call SaveReal(h, id, TIME_HASH, 12)
                        call SaveBoolean(h, id, StringHash("SecondAct"), true)
                        set bjLCU = CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'e0DY', point_x, point_y, angle*bj_RADTODEG)
                        call SetUnitScale(bjLCU,5,5,5)
                        call SaveUnitHandle(h, id, DummyHash, bjLCU)
                        call PauseUnit(LoadUnitHandle(h, id, CasterHash), false)
                        //call SetUnitInvulnerable(LoadUnitHandle(h, id, CasterHash), false)
                        call IssueImmediateOrder(LoadUnitHandle(h, id, CasterHash), "stop")
                endif
        else
                if second_act then
                        set bjLCU = LoadUnitHandle(h, id, DummyHash)
                        set point_x = GetUnitX(bjLCU)+65*Cos(angle)
                        set point_y = GetUnitY(bjLCU)+65*Sin(angle)
                        if IsTerrainPathable(point_x, point_y, PATHING_TYPE_FLYABILITY)==false then
                                call SetUnitX(bjLCU, point_x)
                                call SetUnitY(bjLCU, point_y)
                                call SaveInteger(h, id, StringHash("EffectButo"), EffectPeriod - 1)
                                if EffectPeriod == 0 then
                                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dR99', point_x+50*Cos(angle+90*bj_DEGTORAD), point_y+50*Sin(angle+90*bj_DEGTORAD), angle*bj_RADTODEG-120)
                                        call UnitApplyTimedLife(n, 1, 1.5)
                                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dR99', point_x+50*Cos(angle-90*bj_DEGTORAD), point_y+50*Sin(angle-90*bj_DEGTORAD), angle*bj_RADTODEG+120)
                                        call UnitApplyTimedLife(n, 1, 1.5)
                                        
                                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dR42', point_x, point_y, angle*bj_RADTODEG)
                                        call SetUnitScale(n, 0.25, 0.25, 0.25)
                                        call SetUnitTimeScale(n, 0.6)
                                        call UnitApplyTimedLife(n, 1, 1.5)
                                        call SaveInteger(h, id, StringHash("EffectButo"), 1)
                                endif
                                set n=CreateUnit(GetOwningPlayer(bjLCU),'e0DY', point_x, point_y,(angle*bj_RADTODEG))
                                call SetUnitScale(n,3.75,3.6,75.75)
                                call UnitApplyTimedLife(n,1,1)
                                call MyRemoveUnit(n, 1.5)
                                set bjLCG=LoadGroupHandle(h, id, GroupHash)
                                call GroupEnumUnitsInRange(bjLCG, point_x, point_y, 200, Base)
                                loop
                                set E=FirstOfGroup(bjLCG)
                                exitwhen E==null
                                set ide=GetHandleId(E)
                                if Condition_Base(GetOwningPlayer(bjLCU),E)and E!=LoadUnitHandle(h, GetHandleId(bjLCG),ide)then
                                        call GinT_AddStack(LoadUnitHandle(h, id, CasterHash), E)
                                        call myCustomDamage(LoadUnitHandle(h, id, CasterHash),E,dmg,false,false,null,null,null)
                                        call SetControlToUnit(LoadUnitHandle(h, id, CasterHash),E, 1.0, "stun")
                                        call SaveUnitHandle(h,GetHandleId(bjLCG),ide,E)
                                endif
                                call GroupRemoveUnit(bjLCG,E)
                                endloop
                        else
                                call KillUnit(bjLCU)
                                call MyRemoveUnit(bjLCU, 1)
                                call SaveBoolean(h, id, StringHash("SecondAct"), false)
                        endif
                else
                        call UnitRemoveAbility(LoadUnitHandle(h, id, CasterHash), 'GinR')
                        call ShowAbility2('A0J5', true)
                        call KillUnit(LoadUnitHandle(h, id, StringHash("Effect0")))
                        call MyRemoveUnit(LoadUnitHandle(h, id, StringHash("Effect0")), 1.5)
                        //call SaveBoolean(h, GetHandleId(LoadUnitHandle(h, id, CasterHash)), StringHash("GinBankai"), false)
                        call GinR2_CD(LoadUnitHandle(h, id, CasterHash), CreateTimer())
                        call FlushChildHashtable(h, GetHandleId(LoadGroupHandle(h, id, GroupHash)))
                        call DestroyGroup(LoadGroupHandle(h, id, GroupHash))
                        call FlushChildHashtable(h, id)
                        call DestroyTimer(GetExpiredTimer())
                endif
        endif
endfunction


function GinNewR_Cast takes unit newCaster, real point_x, real point_y, timer newTimer returns nothing
        local integer id = GetHandleId(newTimer)
        local integer id_caster = GetHandleId(newCaster)
        local real angle = AtanPoint(GetUnitX(newCaster), GetUnitY(newCaster), point_x, point_y)
        set soundplay=CreateSound("Sound\\war3mapImported\\GinR2_Voice.mp3", false, false, true, 12700, 12700, "")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dR20', GetUnitX(newCaster), GetUnitY(newCaster), 0)
        call SetUnitVertexColor(n, 255, 255, 255, 100)
        call SetUnitScale(n, 2, 2, 2)
        call SaveUnitHandle(h, id, StringHash("Effect0"), n)
        
        call PauseUnit(newCaster, true)
        //call SetUnitInvulnerable(newCaster, true)
        call SetUnitAnimationByIndex(newCaster, 5)
        call SaveUnitHandle(h, id, CasterHash, newCaster)
        call SaveReal(h, id, AngleHash, angle)
        call SaveGroupHandle(h, id, GroupHash, CreateGroup())
        call TimerStart(newTimer, 0.005, true, function GinNewR_Periodic)
endfunction


function ReginCond takes nothing returns boolean
        return GetSpellAbilityId()=='A0J5' and udg_B==true
endfunction
function ReginCast2 takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(h,id,0)
        local real x=LoadReal(h,id,1)
        local real y=LoadReal(h,id,2)
        local real a=Atan2(LoadReal(h,id,4)-y,LoadReal(h,id,3)-x)
        local real l__d=LoadReal(h,id,5)
        local group g=LoadGroupHandle(h,id,6)
        local player p=GetOwningPlayer(u)
        local real dmg=(3+GetUnitAbilityLevel(u,'A0J5'))*GetHeroAgi(u,true)
        local real l__s=LoadReal(h,id,8)
        local integer lvl=GetUnitAbilityLevel(u,'A0J3')
        if l__d<GetHeroAgi(u,true)*10.0+2000 then
                set x=x+l__d*Cos(a)
                set y=y+l__d*Sin(a)
                set n=CreateUnit(p,'e0DY',x,y,(a*bj_RADTODEG))
                call SetUnitScale(n,l__s,l__s,l__s)
                call SaveReal(h,id,8,l__s+0.03)
                call UnitApplyTimedLife(n,1,1)
                call SaveReal(h,id,5,l__d+60)
                call GroupEnumUnitsInRange(g,x,y,175,Base)
                set idg=GetHandleId(g)
                loop
                set E=FirstOfGroup(g)
                exitwhen E==null
                set ide=GetHandleId(E)
                if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
                        call GinT_AddStack(u, E)
                        call UnitAddAbility(E,'A15G')
                        call myCustomDamage(u,E,dmg,false,false,null,null,null)
                        call UnitRemoveAbility(E,'A15G')
                        call SaveUnitHandle(h,idg,ide,E)
                        if lvl>0 then
                        endif
                endif
                call GroupRemoveUnit(g,E)
                endloop
        else
                if LoadBoolean(h, GetHandleId(u), StringHash("GinBankai")) and LoadInteger(h, GetHandleId(u), StringHash("ButoRenjin"))==0 then
                        call ShowAbility2('A0J5', false)
                        call UnitAddAbility(u, 'GinR')
                        call SetUnitAbilityLevel(u, 'GinR', GetUnitAbilityLevel(u, 'A0J5'))
                endif
                set idg=GetHandleId(g)
                call PauseTimer(t)
                call DestroyTimer(t)
                call DestroyGroup(g)
                call FlushChildHashtable(h,id)
                call FlushChildHashtable(h,idg)
        endif
        set p=null
        set u=null
        set g=null
        set t=null
endfunction
function ReginCast takes nothing returns nothing
        local unit u=GetTriggerUnit()
        local timer t=CreateTimer()
        local integer id=GetHandleId(t)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
        local player p=GetOwningPlayer(u)
        call SaveGroupHandle(h,id,6,CreateGroup())
        call SaveUnitHandle(h,id,0,u)
        call SaveReal(h,id,1,x)
        call SaveReal(h,id,8,2)
        call SaveReal(h,id,2,y)
        call SaveReal(h,id,3,GetSpellTargetX())
        call SaveReal(h,id,4,GetSpellTargetY())
        call UnitApplyTimedLife(CreateUnit(p,'e0DX',x,y,GetRandomReal(0,359)),1,1)
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\GinButo.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        call TimerStart(t,0.01-0.0001*GetHeroLevel(u),true,function ReginCast2)
        set p=null
        set u=null
        set t=null
endfunction
function ReginInit takes nothing returns nothing
        local trigger t=CreateTrigger()
        local integer i=0
        loop
        call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
        set i=i+1
        exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function ReginCast)
call TriggerAddCondition(t,Condition(function ReginCond))
set t=null
endfunction
function BankaiGinCond takes nothing returns boolean
return GetSpellAbilityId()=='A0J2' and udg_B==true
endfunction

function GinBankai_Timer takes nothing returns nothing
        local integer id = GetHandleId(GetExpiredTimer())
        local integer id_caster = GetHandleId(LoadUnitHandle(h, id, CasterHash))
        local real time = LoadReal(h, id, TIME_HASH)
        local boolean bGinBankai = LoadBoolean(h, id_caster, StringHash("GinBankai"))
        if time<10 and bGinBankai and udg_B then
                call SaveReal(h, id, TIME_HASH, time+1)
        else
                if GetUnitAbilityLevel(LoadUnitHandle(h, id, CasterHash), 'GinR')>0 then
                        call UnitRemoveAbility(LoadUnitHandle(h, id, CasterHash), 'GinR')
                endif
                call ShowAbility2('A0J5', true)
                call SaveBoolean(h, id_caster, StringHash("GinBankai"), false)
                call FlushChildHashtable(h, id)
                call DestroyTimer(GetExpiredTimer())
        endif
endfunction

function BankaiGinCast2 takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(h,id,0)
        local integer i=1
        local player p=GetOwningPlayer(u)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        local integer lvl=GetUnitAbilityLevel(u,'A0J2')
        local real dmg=(lvl+2)*GetHeroAgi(u,true)
        local real angle=LoadReal(h, id, AngleHash)
    local real time=LoadReal(h,id,3)
        local real ai = 0
    if time<4 then
        call SaveReal(h,id,3,time+0.1)
        call PauseUnit(u,true)
        call SetUnitInvulnerable(u,true)
    else
        call SetUnitFacing(u, angle*bj_RADTODEG)
        set n=CreateUnit(p,'e0DU',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,1,1)
        call SetUnitTimeScale(n,1)
        set n=CreateUnit(p,'e0DX',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,1,1)
        call SetUnitTimeScale(n,2)
        set n=CreateUnit(p,'e0DX',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,1,1)
        call SetUnitTimeScale(n,2)
        set n=CreateUnit(p,'e0DX',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,1,1)
        call SetUnitTimeScale(n,2)
        call CinematicFadeBJCustom(bj_CINEFADETYPE_FADEIN,1,"ReplaceableTextures\\CameraMasks\\White_mask.blp",255,255,255,0)
        call GroupEnumUnitsInRange(DG,x,y,2000+400*lvl,Base)
        loop
            set E=FirstOfGroup(DG)
            exitwhen E==null
            if Condition_Base(p,E) and (Rad2Deg(AU(u,E)-angle)<=75 and Rad2Deg(AU(u,E)-angle)>=-75) then
                call UnitAddAbility(E,'A15G')
                call GinT_AddStack(u, E)
                call myCustomDamage(u,E,dmg,false,false,null,null,null)
                call UnitRemoveAbility(E,'A15G')
                call SetUnitAnimation(E,"Death")
                call SetControlToUnit(E,E, 2, "stun")
                call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",GetUnitX(E),GetUnitY(E)))
            endif
            call GroupRemoveUnit(DG,E)
        endloop
        call PauseUnit(u,false)
        call SetUnitInvulnerable(u,false)
        call SetUnitAnimationByIndex(u, 11)
        if GetUnitAbilityLevel(u, 'A0J5')>0 then
            if GetAbilityRemainingCooldown(GetUnitAbility(u, 'A0J5'))>0 and LoadInteger(h, GetHandleId(u), StringHash("ButoRenjin"))==0 then
                call UnitAddAbility(u, 'GinR')
                call SetUnitAbilityLevel(u, 'GinR', GetUnitAbilityLevel(u, 'A0J5'))
                call ShowAbility2('A0J5', false)
            endif
            set bjLCT = CreateTimer()
            call SaveBoolean(h, GetHandleId(u), StringHash("GinBankai"), true)
            call SaveUnitHandle(h, GetHandleId(bjLCT), CasterHash, u)
            call TimerStart(bjLCT, 1, true, function GinBankai_Timer)
            set bjLCT = null
        endif
        set ai = angle*bj_RADTODEG-60
        loop
            exitwhen ai > angle*bj_RADTODEG+60
            set n=CreateUnit(GetOwningPlayer(u), 'dR99', x+400*Cos(ai*bj_DEGTORAD), y+400*Sin(ai*bj_DEGTORAD), ai+180)
            call SetUnitScale(n, 3, 3, 3)
            call SetUnitTimeScale(n, 0.9)
            call MyRemoveUnit(n, 1.5)
            set ai = ai + 60
        endloop
        set ai = angle*bj_RADTODEG-60
        loop
            exitwhen ai > angle*bj_RADTODEG+60
            set n=CreateUnit(GetOwningPlayer(u), 'dR99', x+1000*Cos(ai*bj_DEGTORAD), y+1000*Sin(ai*bj_DEGTORAD), ai+180)
            call SetUnitScale(n, 3, 3, 3)
            call SetUnitTimeScale(n, 0.9)
            call MyRemoveUnit(n, 1.5)
            set n=CreateUnit(GetOwningPlayer(u), 'dR99', x+1500*Cos(ai*bj_DEGTORAD), y+1500*Sin(ai*bj_DEGTORAD), ai+180)
            call SetUnitScale(n, 3, 3, 3)
            call SetUnitTimeScale(n, 0.9)
            call MyRemoveUnit(n, 1.5)
            set n=CreateUnit(GetOwningPlayer(u), 'dR99', x+1850*Cos(ai*bj_DEGTORAD), y+1850*Sin(ai*bj_DEGTORAD), ai+180)
            call SetUnitScale(n, 3.2, 3.2, 3.2)
            call SetUnitTimeScale(n, 0.9)
            call MyRemoveUnit(n, 1.5)
            set ai = ai + 30
        endloop
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
    endif
        set u=null
        set p=null
        set t=null
endfunction
function BankaiGinCast takes nothing returns nothing
        local unit u=GetTriggerUnit()
        local timer t=CreateTimer()
        local integer id=GetHandleId(t)
        local player p=GetOwningPlayer(u)
        call SaveUnitHandle(h,id,0,u)
        call SaveReal(h,id,3,0)
        call SaveReal(h, id, AngleHash, AtanPoint(GetUnitX(u), GetUnitY(u), GetSpellTargetX(), GetSpellTargetY()))
        call PauseUnit(u,true)
        call SetUnitInvulnerable(u,true)
        call SetUnitAnimationByIndex(u, 10)
        set n=CreateUnit(p,'e06G',GetUnitX(u),GetUnitY(u),GetRandomReal(0,359))
        call UnitApplyTimedLife(n,1,2)
        call SetUnitTimeScale(n,0.25)
