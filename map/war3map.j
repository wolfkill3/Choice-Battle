endfunction
function Trig_Storm_Rocket_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A084' and udg_B==true
endfunction
function SR_Storm_Rocket takes real xa,real ya,real xb,real yb returns real
return SquareRoot((xa-xb)*(xa-xb)+(ya-yb)*(ya-yb))
endfunction
function Trig_Storm_Rocket_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local unit c=LoadUnitHandle(h,id,2)
local real a
local unit l__dm
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real f=GetUnitFacing(u)
local player p=GetOwningPlayer(u)
if(SR_Storm_Rocket(x,y,x1,y1)>46.00)then
set a=Atan2(y1-y,x1-x)
call SetUnitX(l__d,x+37*Cos(a))
call SetUnitY(l__d,y+37*Sin(a))
call SetUnitFacing(l__d,a*bj_RADTODEG)
call UnitApplyTimedLife(CreateUnit(p,'e02W',x,y,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e047',x,y,a*bj_RADTODEG),'BTLF',1)
else
call DestroyEffect(AddSpecialEffect("war3mapImported\\explode.mdx",x1,y1))
call DestroyEffect(AddSpecialEffect("war3mapImported\\SuperBigExplosion.mdx",x1,y1))
call UnitApplyTimedLife(CreateUnit(p,'e048',x1,y1,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e03W',x1,y1,0),'BTLF',4)
call myCustomDamage(u,c,LoadReal(h,id,13),false,false,null,null,null)
call SetControlToUnit(u,c,2, "stun")
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
endif
set p=null
set l__dm=null
set u=null
set l__d=null
set t=null
set c=null
endfunction
function Trig_Storm_Rocket_Actions takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
