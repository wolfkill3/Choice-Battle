function CastSAS takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real x
local real y
local integer i=0
local real r=0
set soundplay=CreateSound("Sound\\Music\\mp3Music\\MukuroSnakeQ.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call GroupEnumUnitsInRange(G,GetSpellTargetX(),GetSpellTargetY(),455,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
set i=0
set x=GetUnitX(E)
set y=GetUnitY(E)
loop
set r=GetRandomReal(-7,7)
exitwhen i>=2+GetUnitAbilityLevel(u,'A0AP')
set n=CreateUnit(p,'h004',x+100*Cos(r),y+100*Sin(r),0)
call SetUnitBaseDamageByIndex(n,0,10+R2I(GetHeroInt(u,true)*0.1))
call Snakes(n,E)
call IssueTargetOrder(n,"attack",E)
call SetUnitFlyHeight(n,GetRandomReal(0,100),0)
call SetUnitVertexColor(n,GetRandomInt(0,255),GetRandomInt(0,255),GetRandomInt(0,255),255)
call UnitApplyTimedLife(n,1,15)
set i=i+1
endloop
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Earthshock.mdx",E,"chest"))
endif
call GroupRemoveUnit(G,E)
endloop
set p=null
set u=null
endfunction
