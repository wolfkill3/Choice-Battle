local real y=GetUnitY(u)
local integer idu=GetHandleId(u)
local player p=GetOwningPlayer(u)
if LoadBoolean(h,idu,SH_hramb)!=true then
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,3,0)
call SaveReal(h,id,4,0)
call SaveReal(h,id,5,0)
call SaveReal(h,id,7,x)
call SaveReal(h,id,8,y)
call SaveReal(h,idu,SH_hramx,x)
call SaveReal(h,idu,SH_hramy,y)
call SaveBoolean(h,idu,SH_hramb,true)
call SaveInteger(h,id,14,0)
call UnitAddAbility(u,'Arav')
call UnitAddAbility(u,'A0QL')
call UnitMakeAbilityPermanent(u,true,'A0QL')
call UnitRemoveAbility(u,'Arav')
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
set n=LoadUnitHandle(HH,GetHandleId(u),SH_tama)
