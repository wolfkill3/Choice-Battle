function SinonAmmo_Periodic takes nothing returns nothing
	local integer id = GetHandleId(GetExpiredTimer())
    local integer ip_target = LoadInteger(HH, id, 0)
	local integer id_target = GetHandleId(Hero[ip_target])
    local unit    indicator = LoadUnitHandle(HH, ip_target, SinonIndicator)
    local unit    target    = Hero[ip_target]
	local integer ammo = LoadInteger(HH, id_target, Sinon_Ammo)

	if target!=null and GetUnitTypeId(target)=='H04T' then
        if indicator==null then
            set indicator = CreateUnit(GetOwningPlayer(target), 'dSin', GetUnitX(target)-20, GetUnitY(target), 270)
            call SetUnitScale(indicator, 1.5, 1.5, 1.5)
            call SaveUnitHandle(HH, ip_target, SinonIndicator, indicator)
        endif
		call SetUnitFlyHeight(indicator, GetUnitFlyHeight(target)+250, 0)
		call SetUnitAnimationByIndex(indicator, ammo)
		call SetUnitXY(indicator, GetUnitX(target), GetUnitY(target))
		if CheckUnitInvisible(target) then
			if GetUnitAbilityLevel(indicator, 'A0A1')==0 then
				call UnitAddAbility(indicator, 'A0A1')
			endif
		else
			if GetUnitAbilityLevel(indicator, 'A0A1')==1 then
				call UnitRemoveAbility(indicator, 'A0A1')
			endif
		endif
	else
		call RemoveUnit(indicator)
		call RemoveSavedHandle(HH, ip_target, SinonIndicator)
		call FlushChildHashtable(HH, id)
		call DestroyTimer(GetExpiredTimer())
	endif
    set indicator = null
    set target = null
endfunction

function SinonAmmo_Create takes unit newCaster returns nothing
    local timer newTimer = CreateTimer()
    local integer ip_target = GetPlayerId(GetOwningPlayer(newCaster))
    if LoadUnitHandle(HH, ip_target, SinonIndicator)==null and GetHeroLevel(newCaster)>=12 then
		call SaveInteger(HH, GetHandleId(newTimer), 0, ip_target)
        call SaveInteger(HH, GetHandleId(newCaster), Sinon_Ammo, 7) // Обновление магазина Синон

		set bjLCU = CreateUnit(GetOwningPlayer(newCaster), 'dSin', GetUnitX(newCaster), GetUnitY(newCaster), 270)
        call SetUnitAnimationByIndex(bjLCU, 0)
        call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
        call SetUnitFlyHeight(bjLCU, GetUnitFlyHeight(newCaster)+250, 0)
        call SaveUnitHandle(HH, ip_target, SinonIndicator, bjLCU)

		call TimerStart(newTimer, 0.02, true, function SinonAmmo_Periodic)
    else
        call DestroyTimer(newTimer)
	endif
    set newTimer  = null
endfunction

function TextTagFull3 takes string l__s,unit u,integer r,integer g,integer b,integer l__v,player p,real size returns nothing
local texttag l__txt=CreateTextTag()
local real f=(GetUnitFacing(u)+90)*bj_DEGTORAD
call SetTextTagText(l__txt,l__s,size)
call SetTextTagVisibility(l__txt,false)
if GetLocalPlayer()==p then
call SetTextTagVisibility(l__txt,true)
endif
call SetTextTagPos(l__txt,GetUnitX(u)-50*Cos(f),GetUnitY(u)-50*Sin(f),GetUnitFlyHeight(u)+75)
call SetTextTagColor(l__txt,r,g,b,l__v)
call SetTextTagVelocity(l__txt,0.05*Cos(1.571),0.05*Sin(1.571))
call SetTextTagFadepoint(l__txt,.75)
call SetTextTagLifespan(l__txt,3)
call SetTextTagPermanent(l__txt,false)
set l__txt=null
endfunction
function RecoveryCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit u=LoadUnitHandle(HH,GetHandleId(t),0)
local real ml=GetUnitState(u,UNIT_STATE_MAX_LIFE)
local real l=GetWidgetLife(u)
if UnitIsAlive(u) and GetHeroLevel(u)>5 then
call UnitRemoveBuffs(u,false,true)
call HealTextTag(u,u,ml*0.025*myCustomHeal2(u,1),"HealthRes")
call SetUnitState(u,UNIT_STATE_LIFE,l+GetUnitState(u,UNIT_STATE_MAX_LIFE)*.025)
if GetUnitTypeId(u)=='H14H' then
call DestroyEffect(AddSpecialEffect("war3mapImported\\Death Release.mdx",GetUnitX(u),GetUnitY(u)))
else
call DestroyEffect(AddSpecialEffect("war3mapImported\\Energy_Release.mdx",GetUnitX(u),GetUnitY(u)))
endif
if GetRandomInt(0,100) < 15 and GetUnitTypeId(u)!='H14H' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\KONJOU_DA.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
endif
set t=null
set u=null
endfunction
function MadokaGoddesCreate takes nothing returns nothing
        set n=CreateUnit(Player(0), 'HMaG', 0.0, 0.0, 0)
        call PauseUnit(n, true)
        call MyRemoveUnit(n, 0.1)
        call DestroyTimer(GetExpiredTimer())
endfunction

function ShadowCoverIndicator_Periodic takes nothing returns nothing
    local timer t               =GetExpiredTimer()
    local integer id            =GetHandleId(t)
    local unit caster           =LoadUnitHandle(HH, id, c_CASTER)
    local player p              =LoadPlayerHandle(HH, id, c_PLAYER)
    local integer idp           =GetHandleId(p)
    local string mode_name      =LoadStr(HH, id, c_NAME)
    local framehandle NewFrame  =LoadFrameHandle(HH, idp,StringHash(mode_name))
    local real duration         =LoadReal(HH, GetHandleId(NewFrame), c_DURATION)-0.05
    local integer position         =LoadInteger(HH, id, c_POSITION)
    if position>0 then
        if LoadBoolean(HH,idp,position-1)==false then
        call SaveBoolean(HH,idp,position-1,true)
        call SaveBoolean(HH,idp,position,false)
        call SaveInteger(HH, id, c_POSITION,position-1)
        set position=position-1
        endif
    endif
    //if IsUnitPaused(caster)==false and IsUnitHidden(caster)==false and GetUnitAbilityLevel(caster,'Pet1')==0 then
    call SaveReal           (HH, GetHandleId(NewFrame), c_DURATION, duration)
    call SetFrameText( LoadFrameHandle(HH, idp,StringHash(mode_name+"2")), R2SW(duration,2, 1) )
    //endif
    call SetFrameRelativePoint( NewFrame, FRAMEPOINT_CENTER, StatusBarFrame, FRAMEPOINT_LEFT, 0.017+position*0.025, 0.005 )
    if duration<=0 or udg_B==false or DU2==false or UnitIsAlive(caster)==false then
        call SaveReal(HH, GetHandleId(NewFrame), c_DURATION, 0)
        call SaveReal(HH, GetHandleId(LoadFrameHandle(HH, idp,StringHash(mode_name+"2"))), c_DURATION, 0)
        call ShowFrame( NewFrame, false )
        call SaveBoolean(HH,idp,position,false)
        call FlushChildHashtable(HH, id)
        call DestroyTimer(t)
    endif
    set t=null
    set caster=null
    set p=null
    set NewFrame=null
endfunction

function ShadowCoverIndicator takes unit newCaster, string newString, real newDur, timer newTimer returns nothing //wrin
    local integer id            = GetHandleId(newTimer)
    local framehandle NewFrame  = null
    local framehandle NewFrameText  = null
    local player p=GetOwningPlayer(newCaster)
    local integer idp=GetHandleId(p)
    local integer i=9
    local integer j=0
    if LoadFrameHandle(HH, idp,StringHash(newString))==null then    
        set NewFrame = CreateFrameByType( "SIMPLEBUTTON", newString, StatusBarFrame, "", 0 )
        call ClearFrameAllPoints( NewFrame )
        call SetFrameTexture( NewFrame, newString, 0, true )
        call SetFrameTexture( NewFrame, newString, 1, true )
        call SetFrameTexture( NewFrame, newString, 2, true )
        call SetFrameSize( NewFrame, .0237, .0237 )
        call SetFramePriority( NewFrame, 7 )
        call HandleListAddHandle(StatusBarFrameList[GetPlayerId(p)],NewFrame)
        call SetFrameParent(NewFrame,StatusBarFrame)
        call ShowFrame( NewFrame, GetOwningPlayer(GetUnitSelected(GetLocalPlayer()))==GetOwningPlayer(newCaster) and (IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(newCaster)) or GetPlayerId(GetLocalPlayer())==10 or GetPlayerId(GetLocalPlayer())==11))
        call ShowFrame( NewFrameText, GetOwningPlayer(GetUnitSelected(GetLocalPlayer()))==GetOwningPlayer(newCaster) and (IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(newCaster)) or GetPlayerId(GetLocalPlayer())==10 or GetPlayerId(GetLocalPlayer())==11))
        call SaveFrameHandle(HH,idp,StringHash(newString),NewFrame)
        //call SaveReal               (HH, GetHandleId(NewFrame), c_DURATION, 2)
        
        set NewFrameText=CreateFrameByType( "SIMPLETEXT", newString+"1", NewFrame, "", 0 )
        call ClearFrameAllPoints( NewFrameText )
        call SetFrameBlendMode( NewFrameText, 0, BLEND_MODE_BLEND )
        call SetFrameFont( NewFrameText, "Fonts\\FRIZQT__.TTF", .008, 0 )
        call SetFrameTextAlignment( NewFrameText, TEXT_JUSTIFY_CENTER, TEXT_JUSTIFY_LEFT )
        call SetFrameText( NewFrameText, R2SW(newDur,2, 1) )
        call SetFrameTextColour( NewFrameText, ConvertColour(255,255,30,30) )
        call HandleListAddHandle(StatusBarFrameList[GetPlayerId(p)],NewFrameText)
        call ShowFrame( NewFrameText, GetOwningPlayer(GetUnitSelected(GetLocalPlayer()))==GetOwningPlayer(newCaster) and (IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(newCaster)) or GetPlayerId(GetLocalPlayer())==10 or GetPlayerId(GetLocalPlayer())==11))
        call SaveFrameHandle(HH,idp,StringHash(newString+"2"),NewFrameText)
    else
        if LoadReal(HH, GetHandleId(NewFrame), c_DURATION)<=0 then
            set NewFrame=LoadFrameHandle(HH, idp,StringHash(newString))
            set NewFrameText=LoadFrameHandle(HH, idp,StringHash(newString+"2"))
            call SetFrameText( NewFrameText, R2SW(newDur,2, 1) )
            call ShowFrame( NewFrame, GetOwningPlayer(GetUnitSelected(GetLocalPlayer()))==GetOwningPlayer(newCaster) and (IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(newCaster)) or GetPlayerId(GetLocalPlayer())==10 or GetPlayerId(GetLocalPlayer())==11))
            call ShowFrame( NewFrameText, GetOwningPlayer(GetUnitSelected(GetLocalPlayer()))==GetOwningPlayer(newCaster) and (IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(newCaster)) or GetPlayerId(GetLocalPlayer())==10 or GetPlayerId(GetLocalPlayer())==11))
        endif
    endif
    if LoadReal(HH, GetHandleId(NewFrame), c_DURATION)<=0 then
        loop
            exitwhen i==0
            if LoadBoolean(HH,idp,i)==false then
            call SaveBoolean(HH,idp,i,true)
            call SaveBoolean(HH,idp,i+1,false)
            set j=i
            endif
            set i=i-1
        endloop
        call SetFrameRelativePoint( NewFrame, FRAMEPOINT_CENTER, StatusBarFrame, FRAMEPOINT_LEFT, 0.017+j*0.025, 0.005 )
        call SetFrameRelativePoint( NewFrameText, FRAMEPOINT_BOTTOM, NewFrame, FRAMEPOINT_BOTTOM, .0, -.01 )
        call SaveUnitHandle         (HH, id, c_CASTER, newCaster)
        call SavePlayerHandle       (HH, id, c_PLAYER, GetOwningPlayer(newCaster))
        call SaveReal               (HH, GetHandleId(NewFrame), c_DURATION, newDur)
        call SaveReal               (HH, GetHandleId(NewFrameText), c_DURATION, newDur)
        call SaveInteger            (HH, id, c_POSITION, j)
        call SaveStr                (HH, id, c_NAME, newString)
        call TimerStart             (newTimer, 0.05, true, function ShadowCoverIndicator_Periodic)
    else
        call SaveReal           (HH, GetHandleId(NewFrame), c_DURATION, newDur)
        call SaveReal           (HH, GetHandleId(NewFrameText), c_DURATION, newDur)
    endif
    set newTimer=null
    set p=null
    set NewFrame=null
    set NewFrameText=null
endfunction

function ShadowCover_Periodic takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id   = GetHandleId(LoadUnitHandle(HH, id, 0))
    local unit    caster = LoadUnitHandle(HH, id, 0)
    local real    life   = LoadReal(HH, id, 1)
    local real    duration = LoadReal(HH, id, 2)
    local real    position_x = LoadReal(HH, id, 3)
    local real    position_y = LoadReal(HH, id, 4)

    if UnitHasItemOfTypeBJ(caster, 'I05Z') then

        if GetWidgetLife(caster)<life then
            set duration = 4.0
        endif

        if GetUnitX(caster)!=position_x or GetUnitY(caster)!=position_y then
            set duration = 4.0
        endif

        if SpeedRes<0 then
            set duration = 4.0
        endif
        
        if duration==0.0 then
            call DisplayTextToPlayer(GetOwningPlayer(caster),0,0,"|c0077FFFFАктивирован теневой покров!")
            call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",GetUnitX(caster),GetUnitY(caster)))
        endif

        if duration<=0.0 then
            if GetUnitAbilityLevel(caster, 'A0A1')==0 then
                call UnitAddAbility(caster, 'A0A1')
            endif
        else
            call UnitRemoveAbility(caster, 'A0A1')
        endif
        
        call SaveReal(HH, id, 1, GetWidgetLife(caster))
        call SaveReal(HH, id, 2, duration-0.1)
        call SaveReal(HH, id, 3, GetUnitX(caster))
        call SaveReal(HH, id, 4, GetUnitY(caster))
    else
        call UnitRemoveAbility(caster, 'A0A1')
        call SaveBoolean(HH, c_id, ShadowCover, false)
        call FlushChildHashtable(HH, id)
        call DestroyTimer(newTimer)
    endif
    set newTimer = null
    set caster   = null
endfunction

function ShadowCover_Start takes unit newCaster returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id   = GetHandleId(newCaster)
    if LoadBoolean(HH, c_id, ShadowCover)==false then
        call SaveBoolean(HH, c_id, ShadowCover, true)
        call SaveUnitHandle(HH, id, 0, newCaster)
        call SaveReal(HH, id, 1, GetWidgetLife(newCaster))
        call SaveReal(HH, id, 2, 7.0)
        call SaveReal(HH, id, 3, GetUnitX(newCaster))
        call SaveReal(HH, id, 4, GetUnitY(newCaster))
        call TimerStart(newTimer, 0.1, true, function ShadowCover_Periodic)
    else
        call DestroyTimer(newTimer)
    endif
    set newTimer = null
endfunction

function ShadowCover_KazumaPeriodic takes nothing returns nothing
