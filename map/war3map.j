endfunction
function ShinkaShiranuiCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local unit d1=LoadUnitHandle(h,id,3)
local unit c=LoadUnitHandle(h,id,2)
local real a
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x2=GetUnitX(d1)
local real y2=GetUnitY(d1)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real f=GetUnitFacing(u)
local player p=GetOwningPlayer(u)
local real dmg=(3+GetUnitAbilityLevel(u,'A09D'))*GetHeroStr(u,true)
if(SR(x,y,x1,y1)>51.00)then
set a=Atan2(y1-y,x1-x)-15*bj_DEGTORAD
set x=x+50*Cos(a)
set y=y+50*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
set n=CreateUnit(p,'e049',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.75)
call SetUnitTimeScale(n,0)
call UnitApplyTimedLife(CreateUnit(p,'e04A',x,y,a*bj_RADTODEG),'BTLF',1)
call SetUnitFacing(l__d,a*bj_RADTODEG)
set a=Atan2(y1-y2,x1-x2)+15*bj_DEGTORAD
set x2=x2+50*Cos(a)
set y2=y2+50*Sin(a)
call SetUnitX(d1,x2)
call SetUnitY(d1,y2)
call SetUnitFacing(d1,a*bj_RADTODEG)
call UnitApplyTimedLife(CreateUnit(p,'e04A',x2,y2,a*bj_RADTODEG),'BTLF',1)
set n=CreateUnit(p,'e049',x2,y2,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.75)
call SetUnitTimeScale(n,0)
else
call myCustomDamage(u,c,dmg,false,false,null,null,null)
call SlowUnit(u,c,0.5,0,3,2,false)
if GetUnitAbilityLevel(u,'AcF1')>0 then
call PoisonDamage3Ace(u,c,GetHeroStr(u,true),4,"Environment\\LargeBuildingFire\\LargeBuildingFire1.mdl","origin")
endif
call UnitApplyTimedLife(CreateUnit(p,'e01Z',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e048',x1,y1,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e03W',x1,y1,0),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e04C',x1,y1,0),'BTLF',4)
call RemoveUnit(l__d)
call RemoveUnit(d1)
call DestroyEffect(AddSpecialEffect("war3mapImported\\SuperBigExplosion.mdx",x1,y1))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set l__d=null
set d1=null
set t=null
set c=null
endfunction
