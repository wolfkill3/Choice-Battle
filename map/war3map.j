function EnkiduFCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real a=GetUnitFacing(u)*bj_DEGTORAD
local group g=CreateGroup()
set n=CreateUnit(p,'e173',x+585*Cos(a),y+585*Sin(a),a*bj_RADTODEG+180)
call GroupAddUnit(g,n)
call SetUnitTimeScale(n,0.2)
set n=CreateUnit(p,'e16Z',x,y,0)
call GroupAddUnit(g,n)
set n=CreateUnit(p,'e16Z',x,y,0)
call GroupAddUnit(g,n)
set n=CreateUnit(p,'e16K',x,y,0)
call GroupAddUnit(g,n)
call SetUnitVertexColor(n,55,255,55,75)
call SetUnitScale(n,8,8,8)
set n=CreateUnit(p,'e16Z',x,y,0)
call GroupAddUnit(g,n)
set n=CreateUnit(p,'e0RV',x,y,0)
call SetUnitVertexColor(n,255,255,255,180)
call SetUnitScale(n,3.7,3.7,3.7)
call GroupAddUnit(g,n)
call SetUnitTimeScale(n,0.05)
call SaveGroupHandle(h,id,11,g)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,x)
call SaveReal(h,id,2,y)
call SaveReal(h,id,3,0)
call SaveReal(h,id,8,a*bj_RADTODEG)
call SaveInteger(h,id,4,20)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
set soundplay=SndN(2954) // Sound\Music\mp3Music\Enkido F(2T).mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.04,true,function EnkiduFCast2)
set t=null
set g=null
set u=null
set p=null
endfunction
