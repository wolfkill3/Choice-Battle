set time1=time1+0.05


if time1==0.5 then
set time1=0
call DamageAoeOneTime0(caster,x0,y0,800,LoadReal(HH,id,15)*0.075)
endif

call SaveReal(HH,id,6,time1)
call GroupClear(G)
call GroupEnumUnitsInRange(G,x0,y0,800,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
