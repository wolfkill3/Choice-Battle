function Trig_GonsRage_Conditions takes nothing returns boolean
set n=GetTriggerUnit()
return GetSpellAbilityId()=='A1U9' and udg_B==true and DU==true
endfunction
function GonsRage2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local real time=LoadReal(HH,GetHandleId(Gon),SH_kill)
if udg_B and DU2 and UnitIsAlive(Gon) then
    if IsUnitPaused(Gon)==false and IsUnitHidden(Gon)==false and GetUnitAbilityLevel(Gon,'Pet1')==0 then
        call SaveReal(HH,GetHandleId(Gon),SH_kill,time-0.1)
    endif
    if time<=0 then
        call SetUnitInvulnerable(Gon,false)
        call UnitRemoveBuffs(Gon,true,true)
        call UnitAddAbility(Gon,'A0WR')
        call myCustomDamage(Gon,Gon,100000,false,false,null,null,null)
        call UnitRemoveAbility(Gon,'A0WR')
        call ShowAbility2('A23V',false)
        call ShowAbility2Timed('A13V',true,0.1)
        call DisplayTimedTextToAllPlayers(5.0, Lng("|c00FF0000Gon Freecss умер!|r","|c00FF0000Gon Freecss is dead!|r"))
        call RemoveSavedReal(HH,GetHandleId(Gon),SH_kill)
        call PauseTimer(t)
        call DestroyTimer(t)
    endif
else
    call RemoveSavedReal(HH,GetHandleId(Gon),SH_kill)
    call StopSound(LoadSoundHandle(HH, GetHandleId(Gon), SH_GonG), true, true)
    call RemoveSavedHandle(HH, GetHandleId(Gon), SH_GonG)
    call PauseTimer(t)
    call DestroyTimer(t)
endif
set t=null
endfunction
