function SlashGrilShot2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local player p=GetOwningPlayer(l__d)
local unit u=Hero[GetPlayerId(p)]
local real speed=LoadReal(h,id,1)
local real x=LoadReal(h,id,3)
local real y=LoadReal(h,id,4)
local group g=LoadGroupHandle(h,id,5)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,2)
local real dmg=LoadReal(h,id,6)
local real Range=LoadReal(h,id,9)
if Range>0 then
call SetUnitXY_1(l__d,x1+speed*Cos(a),y1+speed*Sin(a), false)
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\PhoenixMissile\\Phoenix_Missile.mdl",x1,y1))
call SaveReal(h,id,9,Range-speed)
call SetUnitFacing(l__d,a*bj_RADTODEG)
else
call UnitApplyTimedLife(CreateUnit(p,'e0PM',x1,y1,GetRandomReal(0,359)),'BTLF',4)
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,GetHandleId(g))
call PauseTimer(t)
if UnitIsAlive(u)==true then
    if GetUnitAbilityLevel(u,'A0O1')==2 then
        call SetUnitAbilityLevel(u,'A0O1',1)
        call UnitMakeAbilityPermanent(u,true,'A0O1')
        elseif GetUnitAbilityLevel(u,'A0O1')==1 then
        call UnitRemoveAbility(u,'A0O1')
        call UnitMakeAbilityPermanent(u,false,'A0O1')
endif
endif
call DestroyTimer(t)
call DestroyGroup(g)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function SlashGrilShot takes unit l__d,real speed,real dmg,real angle,real range,real mas returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle)
call SaveGroupHandle(h,id,5,CreateGroup())
call SaveReal(h,id,3,GetUnitX(l__d))
call SaveReal(h,id,4,GetUnitY(l__d))
call SaveReal(h,id,6,dmg)
call SaveReal(h,id,9,range)
call SaveReal(h,id,10,mas)
call TimerStart(t,0.03,true,function SlashGrilShot2)
set t=null
endfunction
function GrillShottCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local real f=GetUnitFacing(u)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroAgi(u,true)*6+GetHeroStr(u,true)*6
local real dist=SR(x,y,x1,y1)
local real a=Atan2(y1-y,x1-x)
local real he=0
local real dist2=LoadReal(h,id,100)
local group g
local group g2
if dist2>50.00 and udg_B==true and UnitIsAlive(u) then
call PauseUnit(u,true)
call SaveReal(h,id,100,dist2-39)
call SetUnitXY_1(u,x+39*Cos(a),y+39*Sin(a), true)
call SetUnitFacing(u,a*bj_RADTODEG)
set he=ParabolaZ(550,LoadReal(h,id,4),dist)
call SetUnitFlyHeight(u,he,0)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitVertexColor(n,255,230,100,100)
call SetUnitScale(n,0.5,0.5,0.5)
call UnitApplyTimedLife(n,'BTLF',0.70)
call SetUnitFlyHeight(n,he,0)
set n=CreateUnit(p,'e0MB',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.70)
call SetUnitFlyHeight(n,he,0)
else
call PauseUnit(u,false)
if GetUnitAbilityLevel(u,'A0O1')>0 then
set dmg=dmg+GetHeroAgi(u,true)+GetHeroStr(u,true)
endif
set g=CreateGroup()
call GroupEnumUnitsInRange(g,x1,y1,500,Base)
set g2=CopyGroup(g)
loop
set E=FirstOfGroup(g2)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(g2,E)
endloop
call DestroyGroupTimed(g2,3)
if GetUnitAbilityLevel(u,'A0O1')==2 then
    call SetUnitAbilityLevel(u,'A0O1',1)
    call UnitMakeAbilityPermanent(u,true,'A0O1')
    elseif GetUnitAbilityLevel(u,'A0O1')==1 then
    call UnitRemoveAbility(u,'A0O1')
    call UnitMakeAbilityPermanent(u,false,'A0O1')
endif
call SetUnitInvulnerable(u,false)
call SetUnitFlyHeight(u,0,0)
call SlashGrilShot(CreateUnit(p,'e0PN',x,y,0),30,0,0,700,100)
call SlashGrilShot(CreateUnit(p,'e0PN',x,y,60),30,0,60*bj_DEGTORAD,500,100)
call SlashGrilShot(CreateUnit(p,'e0PN',x,y,120),30,0,120*bj_DEGTORAD,700,100)
call SlashGrilShot(CreateUnit(p,'e0PN',x,y,180),30,0,180*bj_DEGTORAD,500,100)
call SlashGrilShot(CreateUnit(p,'e0PN',x,y,240),30,0,240*bj_DEGTORAD,700,100)
call SlashGrilShot(CreateUnit(p,'e0PN',x,y,300),30,0,300*bj_DEGTORAD,500,100)
call UnitApplyTimedLife(CreateUnit(p,'e0NJ',x,y,GetRandomReal(0,359)),'BTLF',3)
//call UnitApplyTimedLife(CreateUnit(p,'e0NK',x,y,GetRandomReal(0,359)),'BTLF',6)
call UnitApplyTimedLife(CreateUnit(p,'e0NI',x,y,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0NL',x,y,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0NM',x,y,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0MI',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0PL',x,y,GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e0PM',x,y,GetRandomReal(0,359)),'BTLF',4)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
endif
set g=null
set g2=null
set u=null
set t=null
set p=null
endfunction
