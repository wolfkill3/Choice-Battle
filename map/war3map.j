                        call EffectCreateAndMove1(false,"war3mapImported\\wind3.mdl",GetRandomReal(0,360),1,GetRandomReal(1,1.25),GetRandomReal(0.75,1.25),100,100,100,GetRandomInt(30,50),150,0,c,0,LoadReal(HH,id,3))
                        call EffectCreateAndMove1(false,"war3mapImported\\[A]az_axe_ef1.mdl",GetRandomReal(0,360),1,GetRandomReal(0.75,1),GetRandomReal(0.4,0.6),100,100,100,GetRandomInt(30,40),50,0,c,0,LoadReal(HH,id,3))
                endif
