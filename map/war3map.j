call UnitApplyTimedLife(n,'BTLF',3)
set n=CreateUnit(p,'e0QC',x,y,0)
call UnitApplyTimedLife(n,'BTLF',3)
set n=CreateUnit(p,'e0QA',x,y,0)
call SetUnitTimeScale(n,0.4)
call UnitApplyTimedLife(n,'BTLF',3)
set n=CreateUnit(p,'e0TK',x,y,0)
call UnitApplyTimedLife(n,'BTLF',3)
set n=CreateUnit(p,'e0TO',x,y,0)
call UnitApplyTimedLife(n,'BTLF',3)
call SaveUnitHandle(h,id,0,u)
call SetUnitInvulnerable(u,true)
call SetUnitAnimation(u,"stand")
set soundplay=SndN(1952) // Sound\Music\mp3Music\UlquiorraW.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,1,false,function ReiatsuSlamCast2)
set u=null
set t=null
set p=null
endfunction
