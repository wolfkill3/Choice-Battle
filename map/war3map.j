local boolean tr=LoadBoolean(h,id,13)
local real dist=LoadReal(h,id,2)
local integer i=0
local player p=GetOwningPlayer(u)
local real rd=0
local real time=LoadReal(h,id,10)
call SaveReal(h,id,10,time+0.25)
if time==0.25 then
call SetUnitAnimation(u,"spell three")
endif
if time<0.45 then
call PauseUnit(u,true)
set rd=45
set x1=x+rd*Cos(a+deg90)
set y1=y+rd*Sin(a+deg90)
set rd=45
set x1=x1+rd*Cos(a)
set y1=y1+rd*Sin(a)
set n=CreateUnit(p,'eo70',x1,y1,a*bj_RADTODEG)
call KireiQMissles(n,75,a,1800+dist,0.05,dmg,u,tr)
set rd=0
set x1=x+rd*Cos(a+deg90)
set y1=y+rd*Sin(a+deg90)
set rd=135
set x1=x1+rd*Cos(a)
set y1=y1+rd*Sin(a)
set n=CreateUnit(p,'eo70',x1,y1,a*bj_RADTODEG)
call KireiQMissles(n,75,a,1800+dist,0.05,dmg,u,tr)
set rd=-45
set x1=x+rd*Cos(a+deg90)
set y1=y+rd*Sin(a+deg90)
set rd=45
set x1=x1+rd*Cos(a)
set y1=y1+rd*Sin(a)
set n=CreateUnit(p,'eo70',x1,y1,a*bj_RADTODEG)
call KireiQMissles(n,75,a,1800+dist,0.05,dmg,u,tr)
call SaveReal(h,id,2,dist+500)
call SaveBoolean(h,id,13,true)
else
call PauseUnit(u,false)
call SetUnitAnimation(u,"stand")
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set p=null
set t=null
endfunction
function KireiQCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local integer i=1
local real sc=0
local real is=0
local real ig=30*bj_DEGTORAD
set soundplay=SndN(3052) // Sound\war3mapImported\Kirei_Q.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
loop
exitwhen is>=13
set n=CreateUnit(p,'eo0N',x+250*Cos(ig*is),y+250*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,255,255,255,35)
call UnitApplyTimedLife(n,'BTLF',1.5)
call SetUnitTimeScale(n,0.5)
set is=is+1
endloop
set n=CreateUnit(p,'ed0O',x,y,a*bj_RADTODEG)
call SetUnitTimeScale(n,0.5)
call UnitApplyTimedLife(n,'BTLF',1.5)
call SetUnitScale(n,0.5,0.5,0.5)
call SetUnitVertexColor(n,255,255,255,100)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,0)
call SaveReal(h,id,10,0)
call SaveBoolean(h,id,13,false)
call PauseUnit(u,true)
call SaveReal(h,id,3,a)
call SetUnitAnimation(u,"Spell Channel Three")
call TimerStart(t,0.25,true,function KireiQCast2)
set u=null
set p=null
set t=null
endfunction
