function AndroidBarrierCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local group g=LoadGroupHandle(h,id,1)
local integer i=1
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local real dmg=GetHeroInt(u,true)*.375
local real dmg2=GetHeroInt(u,true)*8
local player p=GetOwningPlayer(u)
local real r=GetRandomReal(0.,6.283185)
local real sc=LoadReal(h,id,4)
local real cof=LoadReal(h,id,5)
local real dist=LoadReal(h,id,6)
local real time=LoadReal(h,id,7)
set idg=GetHandleId(g)
call SaveReal(h,id,7,time+0.05)
if time<=2 then
call SaveReal(h,id,5,cof+cof*0.062)
call SaveReal(h,id,4,sc*(1.042-cof))
call SetUnitScale(LoadUnitHandle(h,id,8),3.2,3.2,3.2)
call SetUnitScale(LoadUnitHandle(h,id,9),10-sc,10-sc,10-sc)
call SetUnitVertexColor(LoadUnitHandle(h,id,8),250,120,100,R2I(100*(sc-1.6)))
call SetUnitVertexColor(LoadUnitHandle(h,id,9),250,R2I(140-4*sc),R2I(170-3*sc),R2I(9*sc))
call GroupEnumUnitsInRange(G,x,y,300,Base)
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\FarseerMissile\\FarseerMissile.mdl",x+GetRandomReal(-140,140)*Cos(GetRandomReal(0,359)*bj_DEGTORAD) ,y+GetRandomReal(-140,140)*Sin(GetRandomReal(0,359)*bj_DEGTORAD)))
//if sc>8 then
//call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\FarseerMissile\\FarseerMissile.mdl",x+GetRandomReal(-65*sc,65*sc)*Cos(GetRandomReal(0,359)*bj_DEGTORAD) ,y+GetRandomReal(-65*sc,65*sc)*Sin(GetRandomReal(0,359)*bj_DEGTORAD)))
//endif
set n=CreateUnit(p,'e0IT',x,y,GetRandomReal(0,359))
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitVertexColor(n,250,225,100,140)
call SetUnitTimeScale(n,3)
call UnitApplyTimedLife(n,1,.25)
if dist>=3 then
set n=CreateUnit(p,'e0B2',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,.25)
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitVertexColor(n,250,255,255,30)
call SaveReal(h,id,6,0)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E) then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 0.5, "stun")
endif
call GroupRemoveUnit(G,E)
endloop
else
call SaveReal(h,id,6,dist+1)
endif
elseif time>=2 and time<3.5 then
call SetUnitTimeScale(u,0.27)
call SaveReal(h,id,4,sc*1.027)
call GroupEnumUnitsInRange(g,x,y,80*(sc-5),Base)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E) and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg2,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
call SetControlToUnit(E,E, 0.8, "stun")
call Push3(E,50,Atan2(GetUnitY(E)-y,GetUnitX(E)-x),200,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
elseif Condition_Base(p,E) then
call Push3(E,50,Atan2(GetUnitY(E)-y,GetUnitX(E)-x),200,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
call SetControlToUnit(E,E, 0.8, "stun")
endif
call GroupRemoveUnit(g,E)
endloop
call SetUnitScale(LoadUnitHandle(h,id,8),sc-4,sc-4,sc-4)
if dist>=3 then
set n=CreateUnit(p,'e0B2',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,.02)
call SetUnitScale(n,sc-6.3,sc-6.3,sc-6.3)
call SetUnitVertexColor(n,250,255,255,30)
call SaveReal(h,id,6,0)
endif
set n=CreateUnit(p,'e0IT',x,y,GetRandomReal(0,359))
call SetUnitScale(n,sc-6,sc-6,sc-6)
call SetUnitVertexColor(n,250,225,100,170)
call SetUnitTimeScale(n,3)
call UnitApplyTimedLife(n,1,.25)
call SetUnitVertexColor(LoadUnitHandle(h,id,8),250,120,100,R2I(210/(sc*0.08)))
call SaveReal(h,id,6,dist+1)
endif
if time>=3.5 then
call SetUnitFlyHeight(u,0,0)
call DestroyGroup(g)
call RemoveUnit(LoadUnitHandle(h,id,8))
call RemoveUnit(LoadUnitHandle(h,id,9))
call DestroyTimer(t)
call SetUnitTimeScale(u,1)
call SetUnitAnimation(u,"stand")
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,idg)
endif
set g=null
set u=null
set t=null
set p=null
endfunction
