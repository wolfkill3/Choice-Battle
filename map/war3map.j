function AizenESlow takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit Dummy=LoadUnitHandle(HH,id,1)
local group gr=LoadGroupHandle(HH,id,4)
if SR(GetUnitX(GetEnumUnit()),GetUnitY(GetEnumUnit()),GetUnitX(Dummy),GetUnitY(Dummy))>350+LoadInteger(HH,id,17)*3 or LoadReal(HH,id,5)==6.28 then
call GroupRemoveUnit(gr,GetEnumUnit())
call SaveGroupHandle(HH,id,4,gr)
call UnitRemoveAbility(GetEnumUnit(),'ASE3')
call UnitRemoveAbility(GetEnumUnit(),'BAS3')
endif
set gr=null
set Dummy=null
endfunction
function AizenEAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit casterOriginal=LoadUnitHandle(HH,id,30)
