function AsuraMakyusenCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroStr(u,true)*0.385
local real time=LoadReal(h,id,1)+0.15
if time<4 then
call SetUnitInvulnerable(u,true)
call PauseUnit(u,true)
call SetUnitAnimation(u,"attack")
call GroupEnumUnitsInRange(G,x,y,350,Base)
call SetUnitFacing(u,GetRandomReal(0,359))
call UnitApplyTimedLife(CreateUnit(p,'e0U3',x,y,GetRandomReal(0,359)),'BTLF',0.6)
call UnitApplyTimedLife(CreateUnit(p,'e0U4',x,y,GetRandomReal(0,359)),'BTLF',0.6)
call UnitApplyTimedLife(CreateUnit(p,'e0U5',x,y,GetRandomReal(0,359)),'BTLF',0.6)
set n=CreateUnit(p,'e0TQ',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitTimeScale(n,0.4)
set n=CreateUnit(p,'e0AF',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitVertexColor(n,150,25,105,75)
set n=CreateUnit(p,'e01S',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.3)
call SetUnitVertexColor(n,255,255,255,125)
call SetUnitTimeScale(n,5)
call SetUnitAnimation(n,"attack")
call SaveReal(h,id,1,time)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 1, "stun")
endif
call GroupRemoveUnit(G,E)
endloop
else
call SetUnitTimeScale(u,1)
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set t=null
endfunction

