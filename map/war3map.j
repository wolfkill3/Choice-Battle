if GetUnitAbilityLevel(u,'A17A')>0 then
call SetUnitModel(n,"(By XeSHTeG)[DBZ RAMPAGE]GhostGotenksSS.mdx")
set dmg=0.25*GetHeroAgi(u,true)
elseif GetUnitAbilityLevel(u,'A17C')>0 then
