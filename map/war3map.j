function GetsugaBlastCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real dmg=GetHeroAgi(u,true)*2
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real a=LoadReal(h,id,3)
local real fl=LoadReal(h,id,4)
local real speed=LoadReal(h,id,5)
local real dist=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
if dist>0 and GetWidgetLife(l__d)>0 then
set x=x+speed*Cos(a)
set y=y+speed*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SaveReal(h,id,2,dist-speed)
call SaveReal(h,id,4,fl+speed*0.15)
call SetUnitFlyHeight(l__d,fl,0)
if GetUnitTypeId(u)=='H012' then
set n=CreateUnit(p,'d093',x,y,a*bj_RADTODEG)
call SetUnitScale(n, 0.8, 0.8, 0.8)
elseif GetUnitTypeId(u)=='H013' then
set n=CreateUnit(p,'d095',x,y,a*bj_RADTODEG)
elseif GetUnitTypeId(u)=='H06D' then
set n=CreateUnit(p,'d094',x,y,a*bj_RADTODEG)
elseif GetUnitTypeId(u)=='H06E' then
set n=CreateUnit(p,'d096',x,y,a*bj_RADTODEG)
call SetUnitScale(n, 0.9, 0.9, 0.9)
endif
call SetUnitVertexColor(n,255,255,255,25)
call SetUnitTimeScale(n,1)
call SetUnitFlyHeight(n,fl,0)
call UnitApplyTimedLife(n,1,0.15)
call MyRemoveUnit(n, 0.15)
else
call PauseTimer(t)
call TimerStart(t,0,false,function GetsugaBlastCast3)
endif
set l__d=null
set u=null
set p=null
set t=null
endfunction
function GetsugaBlastCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
call SaveUnitHandle(h,id,0,u)
call ShowUnit(u, false)
if SquareRootPoint(x, y, x1, y1)>1000 then
        set x1 = x+1000*Cos(a)
        set y1 = y+1000*Sin(a)
endif
if GetUnitTypeId(u)=='H012'  then
set n=CreateUnit(p,'d093',x+25*Cos(a),y+25*Sin(a),a*bj_RADTODEG)
call SetUnitScale(n, 0.8, 0.8, 0.8)
elseif GetUnitTypeId(u)=='H013' then
set n=CreateUnit(p,'d095',x+25*Cos(a),y+25*Sin(a),a*bj_RADTODEG)
elseif GetUnitTypeId(u)=='H06D' then
set n=CreateUnit(p,'d094',x+25*Cos(a),y+25*Sin(a),a*bj_RADTODEG)
elseif GetUnitTypeId(u)=='H06E' then
set n=CreateUnit(p,'d096',x+25*Cos(a),y+25*Sin(a),a*bj_RADTODEG)
call SetUnitScale(n, 0.9, 0.9, 0.9)
endif
call SaveUnitHandle(h,id,1,n)
call SaveReal(h,id,2,SR(x,y,x1,y1))
call SaveReal(h,id,3,a)
call SaveReal(h,id,4,90)
call SaveReal(h,id,5,SR(x,y,x1,y1)*0.04)
call SaveReal(h,id,6,x)
call SaveReal(h,id,7,y)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SetUnitAnimation(u,"Spell Four")
call SetUnitTimeScale(u,3)
call UnitAddAbility(u,'Arav')
call UnitRemoveAbility(u,'Arav')
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG-45)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,1,0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+45)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,1,0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,1,0.4)
call SetUnitTimeScale(n,3)
if GetUnitTypeId(u)=='H012' then
if GetRandomInt(0,1)==0 then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\HichigoR1.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\HichigoR2.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
elseif GetUnitTypeId(u)=='H06D' then
