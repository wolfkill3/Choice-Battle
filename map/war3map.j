function BlackGokGEBalls1 takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit target=LoadUnitHandle(HH,id,2)
local real facing=LoadReal(HH,id,3)
local real distance=SR(GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),GetUnitX(target),GetUnitY(target))
local real time=LoadReal(HH,id,5)
local boolean targinv=false
local boolean targpaus=false
set time=time+0.02
call SaveReal(HH,id,5,time)
if time==0.2 then
call UnitSpeed(LoadUnitHandle(HH,id,20),0)
endif
if distance<175 or time==1.5 then
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(target),GetUnitY(target),facing+GetRandomInt(-30,30))
call UnitSpeed(n0,0.2)
call SetUnitModel(n0,"BlackGoku\\[AB]AZ_JianCi.mdl")
call UnitSize(n0,0.7,1,1)
call UnitColor(n0,100,100,100,0)
call BlackGokuGEDummy(n0,LoadReal(HH,id,27))
call SetUnitFlyHeight(n0,GetUnitFlyHeight(target)+GetRandomInt(50,100),0)
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call MoveUnit(target,n0,GetRandomInt(-150,75),facing+GetRandomInt(-30,30))
set n0=null
if GetUnitAbilityLevel(target,'Avul')>0 then
set targinv=true
call SetUnitInvulnerable(target,false)
endif
call SetUnitAnimation(target,"death")
if IsUnitPaused(target)==true then
set targpaus=true

call PauseUnit(target,false)
endif
call DamageAoeOneTime0(caster,GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),200,LoadReal(HH,id,15))
if targinv==true then
call SetUnitInvulnerable(target,true)
endif
if targpaus==true then
call PauseUnit(target,true)
endif
call RemoveUnit(LoadUnitHandle(HH,id,20))
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else
set facing=GetUnitFacing(LoadUnitHandle(HH,id,20))
call MoveUnit(LoadUnitHandle(HH,id,20),LoadUnitHandle(HH,id,20),LoadReal(HH,id,9),facing)
call SaveReal(HH,id,8,distance-LoadReal(HH,id,9))
endif
set caster=null
set target=null
endfunction
function BlackGokGEBalls takes unit caster0,unit target1,real damage0,real facing0,real timeleft returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real randomspeed=GetRandomReal(30,40)
call SaveUnitHandle(HH,id,1,caster0)
call SaveUnitHandle(HH,id,2,target1)
