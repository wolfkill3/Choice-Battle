function MissleMoveKeshaStrike2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit l__d=LoadUnitHandle(h,id,2)
local real speed=LoadReal(h,id,4)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)+LoadReal(h,id,3)
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>90 and UnitIsAlive(l__d)then
set x=x+speed*Cos(a)
set y=y+speed*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call UnitApplyTimedLife(CreateUnit(p,'e0K9',x,y,a*bj_RADTODEG),'BTLF',0.5)
else
if UnitIsAlive(l__d)then
call UnitApplyTimedLife(CreateUnit(p,'e00N',x1,y1,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e067',x1,y1,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e06O',x1,y1,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0B9',x1,y1,GetRandomReal(0,359)),'BTLF',3)
call PauseUnit(l__d,false)
call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,false)
if GetUnitAbilityLevel(c,'B03I')==0 then
call myCustomDamage(u,c,LoadReal(h,id,5),false,false,null,null,null)
else
call myCustomDamage(u,c,LoadReal(h,id,5)*1.2,false,false,null,null,null)
endif
endif
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
endif
set p=null
set l__d=null
set c=null
set t=null
set u=null
endfunction
