function SpiritSwordsCond takes nothing returns boolean
return GetSpellAbilityId()==0x4130504A
endfunction
function SpiritSwordsCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)*bj_DEGTORAD
local group g=LoadGroupHandle(h,GetHandleId(u),StringHash("vg"))
if GetUnitAbilityLevel(u,0x42303436)>0 and FirstOfGroup(g)!=null then
set E=LoadUnitHandle(h,id,1)
if UnitIsAlive(E)and GetUnitAbilityLevel(E,0x41303849)==0 then
call SetUnitX(E,x+70*Cos(f+deg90))
call SetUnitY(E,y+70*Sin(f+deg90))
call SetUnitFacing(E,f*bj_RADTODEG)
endif
set E=LoadUnitHandle(h,id,2)
if UnitIsAlive(E)and GetUnitAbilityLevel(E,0x41303849)==0 then
call SetUnitX(E,x-70*Cos(f+deg90))
call SetUnitY(E,y-70*Sin(f+deg90))
call SetUnitFacing(E,f*bj_RADTODEG)
endif
set E=LoadUnitHandle(h,id,3)
if UnitIsAlive(E)and GetUnitAbilityLevel(E,0x41303849)==0 then
call SetUnitX(E,x+100*Cos(f+deg90))
call SetUnitY(E,y+100*Sin(f+deg90))
call SetUnitFacing(E,f*bj_RADTODEG)
endif
set E=LoadUnitHandle(h,id,4)
if UnitIsAlive(E)and GetUnitAbilityLevel(E,0x41303849)==0 then
call SetUnitX(E,x-100*Cos(f+deg90))
call SetUnitY(E,y-100*Sin(f+deg90))
call SetUnitFacing(E,f*bj_RADTODEG)
endif
set E=LoadUnitHandle(h,id,5)
if UnitIsAlive(E)and GetUnitAbilityLevel(E,0x41303849)==0 then
call SetUnitX(E,x+70*Cos(f+deg90))
call SetUnitY(E,y+70*Sin(f+deg90))
call SetUnitFacing(E,f*bj_RADTODEG)
endif
set E=LoadUnitHandle(h,id,6)
if UnitIsAlive(E)and GetUnitAbilityLevel(E,0x41303849)==0 then
call SetUnitX(E,x-70*Cos(f+deg90))
call SetUnitY(E,y-70*Sin(f+deg90))
call SetUnitFacing(E,f*bj_RADTODEG)
endif
else
call DestroyGroup(g)
set E=LoadUnitHandle(h,id,1)
if GetUnitAbilityLevel(E,0x41303849)==0 then
call RemoveUnit(E)
endif
set E=LoadUnitHandle(h,id,2)
if GetUnitAbilityLevel(E,0x41303849)==0 then
call RemoveUnit(E)
endif
set E=LoadUnitHandle(h,id,3)
if GetUnitAbilityLevel(E,0x41303849)==0 then
call RemoveUnit(E)
endif
set E=LoadUnitHandle(h,id,4)
if GetUnitAbilityLevel(E,0x41303849)==0 then
call RemoveUnit(E)
endif
set E=LoadUnitHandle(h,id,5)
if GetUnitAbilityLevel(E,0x41303849)==0 then
call RemoveUnit(E)
endif
set E=LoadUnitHandle(h,id,6)
if GetUnitAbilityLevel(E,0x41303849)==0 then
call RemoveUnit(E)
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set u=null
set t=null
endfunction
function SpiritSwordsCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)*bj_DEGTORAD
local player p=GetOwningPlayer(u)
local group g=CreateGroup()
local integer ty='e0O0'
call SaveUnitHandle(h,id,0,u)
set n=CreateUnit(p,ty,x+70*Cos(f+deg90),y+70*Sin(f+deg90),f*bj_RADTODEG)
call GroupAddUnit(g,n)
call SaveUnitHandle(h,id,1,n)
set n=CreateUnit(p,ty,x-70*Cos(f+deg90),y-70*Sin(f+deg90),f*bj_RADTODEG)
call GroupAddUnit(g,n)
call SaveUnitHandle(h,id,2,n)
set n=CreateUnit(p,ty,x+100*Cos(f+deg90),y+100*Sin(f+deg90),f*bj_RADTODEG)
call SetUnitFlyHeight(n,120,0)
call SaveUnitHandle(h,id,3,n)
call GroupAddUnit(g,n)
set n=CreateUnit(p,ty,x-100*Cos(f+deg90),y-100*Sin(f+deg90),f*bj_RADTODEG)
call SetUnitFlyHeight(n,120,0)
call SaveUnitHandle(h,id,4,n)
call GroupAddUnit(g,n)
set n=CreateUnit(p,ty,x+70*Cos(f+deg90),y+70*Sin(f+deg90),f*bj_RADTODEG)
call SetUnitFlyHeight(n,180,0)
call SaveUnitHandle(h,id,5,n)
call GroupAddUnit(g,n)
set n=CreateUnit(p,ty,x-70*Cos(f+deg90),y-70*Sin(f+deg90),f*bj_RADTODEG)
call SetUnitFlyHeight(n,180,0)
call SaveUnitHandle(h,id,6,n)
call GroupAddUnit(g,n)
call SaveGroupHandle(h,GetHandleId(u),StringHash("vg"),g)
call GroupRemoveUnit(g,u)
if GetRandomInt(0, 1)==0 then
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\VergilW.mp3",false,false,true,12700,12700,"")
else
        set soundplay=CreateSound("Sound\\war3mapImported\\VergilW_Sound.mp3",false,false,true,12700,12700,"")
endif
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
	if GetUnitTypeId(u)!='H03O' then
		set n=LoadUnitHandle(HH, GetHandleId(u), StringHash("VergilD"))
		call RemoveUnit(n)
		set n=CreateUnit(p, 'd081', 0.0, 0.0, 0.0)
		call SaveUnitHandle(HH, GetHandleId(u), StringHash("VergilD"), n)
		call MyRemoveUnit(n, 3)
	endif
call TimerStart(t,0.025,true,function SpiritSwordsCast2)
set n=LoadUnitHandle(h,GetHandleId(u),StringHash("clone"))
if n!=null then
call UnitResetCooldown(n)
call SetUnitState(n,UNIT_STATE_MANA,GetUnitState(n,UNIT_STATE_MAX_MANA))
call IssueImmediateOrder(n,"berserk")
endif
set u=null
set t=null
set p=null
endfunction
function SpiritSwordsInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function SpiritSwordsCast)
call TriggerAddCondition(t,Condition(function SpiritSwordsCond))
set t=null
endfunction
function CondJCV takes nothing returns boolean
return GetSpellAbilityId()==0x41305049
endfunction
function CastJCV2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real r=GetRandomReal(-7,7)
local real dist=GetRandomReal(-450,450)
local real x=LoadReal(h,id,1)+dist*Cos(r)
local real y=LoadReal(h,id,2)+dist*Sin(r)
local group g=LoadGroupHandle(h,id,5)
local integer num=LoadInteger(h,id,3)
local integer max_num=LoadInteger(h, id, 10)
local real he=0
local player p=GetOwningPlayer(u)
local integer i=0
local real l__s=GetRandomReal(0.9,2)
local real dmg=LoadReal(h, id, 11)
local integer l__idg=GetHandleId(g)
if num<max_num then
set n=CreateUnit(p,0x65304E59,x,y,GetRandomReal(0,360))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitFlyHeight(n,GetRandomReal(-50,50),0)
call SetUnitScale(n,l__s,l__s,l__s)
call SetUnitTimeScale(n,GetRandomReal(0.7,1.5))
call SetUnitAnimation(n,"Death")
set n=CreateUnit(p,0x65304E5A,x,y,GetRandomReal(0,360))
call UnitApplyTimedLife(n,1,1)
call SetUnitFlyHeight(n,GetRandomReal(-50,50),0)
call SetUnitScale(n,l__s,l__s,l__s)
call SetUnitTimeScale(n,GetRandomReal(0.7,1.5))
call GroupEnumUnitsInRange(g,x,y,150,Base)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",GetUnitX(E),GetUnitY(E)))
call SaveUnitHandle(h,l__idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
call SaveInteger(h,id,3,num+1)
else
call FlushChildHashtable(h,l__idg)
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set g=null
set t=null
set p=null
endfunction
function CastJCV_Old takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local integer lvl=GetUnitAbilityLevel(u,0x41305049)
local real dmg=GetHeroAgi(u,true)*(3+lvl)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,GetSpellTargetX())
call SaveReal(h,id,2,GetSpellTargetY())
call SaveGroupHandle(h,id,5,CreateGroup())
call SaveInteger(h,id,3,0)
if GetUnitTypeId(u)!='H03O' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\VergilQ.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif

set n=LoadUnitHandle(h,GetHandleId(u),StringHash("clone"))
if n!=null then
        call UnitResetCooldown(n)
        call SetUnitState(n,UNIT_STATE_MANA,GetUnitState(n,UNIT_STATE_MAX_MANA))
        //call IssuePointOrder(n,"absorb",GetSpellTargetX(),GetSpellTargetY())
        call SaveInteger(h, id, 10, 12)
        call SaveReal(h, id, 11, dmg*2)
        call TimerStart(t,0.07,true,function CastJCV2)
else
        call SaveInteger(h, id, 10, 8)
        call SaveReal(h, id, 11, dmg)
        call TimerStart(t,0.08,true,function CastJCV2)
endif
set u=null
set t=null
endfunction


function VergilPatriot_ModifEnd takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(h,id,0)
        local unit c=LoadUnitHandle(h,id,1)
        call SetHeroAgi(u,GetHeroAgi(u,false)+3,true)
        call SetHeroStr(u,GetHeroStr(u,false)+3,true)
        call SetHeroInt(u,GetHeroInt(u,false)+3,true)
        call SetHeroAgi(c,GetHeroAgi(c,false)-3,true)
        call SetHeroStr(c,GetHeroStr(c,false)-3,true)
        call SetHeroInt(c,GetHeroInt(c,false)-3,true)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
        set u=null
        set c=null
        set t=null
endfunction

function VergilExcalibur_ModifEnd2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
if IsUnitAlive(u)==true and u!=null then
call SetUnitArmour(u,GetUnitArmour(u)+4)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
elseif u==null then
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set t=null
endfunction
function VergilExcalibur_ModifEnd takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
if IsUnitAlive(u)==true then
call SetUnitArmour(u,GetUnitArmour(u)+4)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
else
call TimerStart(t, 0.1, true, function VergilExcalibur_ModifEnd2)
endif
set u=null
set t=null
endfunction

function SinonExcalibur_ModifEnd takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit c=LoadUnitHandle(h,id,1)
    if IsUnitPaused(u)==false and GetWidgetLife(u)>=1 then
        call SetUnitArmour(u, GetUnitArmour(u)+4)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
    endif
    set u=null
    set c=null
    set t=null
endfunction

function VergilDarkExcalibur_ModifEnd takes nothing returns nothing
	local timer t=GetExpiredTimer()
	local integer id=GetHandleId(t)
	local unit u=LoadUnitHandle(h,id,0)
	local integer id_caster=GetHandleId(u)
	call UnitRemoveAbility(u, 'A26R')
	call FlushChildHashtable(h,id)
	call DestroyTimer(t)
	call SaveBoolean(h, id_caster, StringHash("ItemDarkExc_CD"), true)
	set bjLCT=CreateTimer()
	call SaveUnitHandle(h, GetHandleId(bjLCT), CasterHash, u)
	call TimerStart(bjLCT, 9, false, function DarkExcalibur_CD)
	set bjLCT=null
	set u=null
	set t=null
endfunction

function VergilQ_ModifAttack takes unit newCaster, unit newTarget, boolean b_clone returns boolean
	local real damage=GetUnitTotalDamage(newCaster)
	local real bonus_damage=0.0
	local real currect_damage = damage
	local boolean fatal_damage=false
	local boolean miss=false
	local real heal = 0.0
	
	if b_clone then
		set damage = damage * 1.6
		set currect_damage = damage
	endif
	
	if IsUnitType(newCaster,UNIT_TYPE_HERO) and IsUnitIllusion(newCaster)==false and miss==false then
	
	if UnitHasItemOfTypeBJ(newCaster, 'I01J') and GetRandomIntMem(0,100)<15 then	// Меч C ранга
		set damage=damage*1.5
	endif
	if UnitHasItemOfTypeBJ(newCaster, 'I01I') and GetRandomIntMem(0,100)<15 then	// Меч B ранга
		set damage=damage*1.75
	endif
	if UnitHasItemOfTypeBJ(newCaster, 'I01K') and GetRandomIntMem(0,100)<15 then	// Меч A ранга
		set damage=damage*2.0
	endif
	if UnitHasItemOfTypeBJ(newCaster, 'I01L') and GetRandomIntMem(0,100)<15 then	// Закаленный меч
		set damage=damage*2.0
	endif
	if (UnitHasItemOfTypeBJ(newCaster, 'I01O') or UnitHasItemOfTypeBJ(newCaster, 'I01Q') or UnitHasItemOfTypeBJ(newCaster, 'I01U'))  and GetRandomIntMem(0,100)<20 then	// Сандай Китецу, Сюсуй, Фэнг
		set damage=damage*2.5
	endif
	if UnitHasItemOfTypeBJ(newCaster, 'I01S') and GetRandomIntMem(0,100)<30 then	// Темный Экскалибур
		set damage=damage*2.5
	endif
	
	if UnitHasItemOfTypeBJ(newCaster, 'I02V') then	// Ямато
		call Essence(newCaster,newTarget,1)
		if (LoadReal(HH,GetHandleId(newCaster),StringHash("yamato"))==1 or GetRandomIntMem(0,100)<15) then
			set damage=damage*4.5
			call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",newTarget,"chest"))
			call SaveReal(HH,GetHandleId(newCaster),StringHash("yamato"),0)
			call AllTextTag("|c000080FFYAMATO!|r" , newCaster)
		endif
	endif
	
	if currect_damage*2 < damage then
		set damage = currect_damage*2
	endif
	
	if UnitHasItemOfTypeBJ(newCaster, 'I031') and IsUnitType(newTarget,UNIT_TYPE_HERO) and IsUnitIllusion(newTarget)==false then 	// Патриот
		set bjLCT=CreateTimer()
			call SetHeroAgi(newCaster,GetHeroAgi(newCaster,false)+3,true)
			call SetHeroStr(newCaster,GetHeroStr(newCaster,false)+3,true)
			call SetHeroInt(newCaster,GetHeroInt(newCaster,false)+3,true)
			call SetHeroAgi(newTarget,GetHeroAgi(newTarget,false)-3,true)
			call SetHeroStr(newTarget,GetHeroStr(newTarget,false)-3,true)
			call SetHeroInt(newTarget,GetHeroInt(newTarget,false)-3,true)
			call SaveUnitHandle(h,GetHandleId(bjLCT), 0, newTarget)
			call SaveUnitHandle(h,GetHandleId(bjLCT), 1, newCaster)
			call TimerStart(bjLCT, 5, false, function VergilPatriot_ModifEnd)
		set bjLCT=null
		//set damage=damage-damage*0.3
	endif
	
	if UnitHasItemOfTypeBJ(newCaster, 'I04F') then 				// Экскалибур
		call SetWidgetLife(newCaster, GetWidgetLife(newCaster)+CalculatePhysDamage(newTarget, damage*0.2))
		set heal = heal + CalculatePhysDamage(newTarget, damage*0.2)
		set bjLCT=CreateTimer()
			call SetUnitArmour(newTarget, GetUnitArmour(newTarget)-4)
			call SaveUnitHandle(h,GetHandleId(bjLCT), 0, newTarget)
			call TimerStart(bjLCT, 10, false, function VergilExcalibur_ModifEnd)
		set bjLCT=null
	endif
	
	if UnitHasItemOfTypeBJ(newCaster, 'I01S') and GetRandomInt(0, 9)<=3 then 				// Темный Экскалибур
		if LoadBoolean(h, GetHandleId(newCaster), StringHash("ItemDarkExc_CD"))==false then
			set bjLCT=CreateTimer()
			call SaveBoolean(h, GetHandleId(newCaster), StringHash("ItemDarkExc_CD"), true)
			call UnitRemoveAbility(newCaster, 'A26R')
			call UnitAddAbility(newCaster,'A26R')
			call SaveUnitHandle(h,GetHandleId(bjLCT),0,newCaster)
			call TimerStart(bjLCT,3,false,function VergilDarkExcalibur_ModifEnd)
			set bjLCT=null
		endif
	endif
	
	if GetUnitAbilityLevel(newCaster, 'A26R')>0 then										// Темный Экскалибур Хилл
		call SetWidgetLife(newCaster, GetWidgetLife(newCaster)+CalculatePhysDamage(newTarget, damage*0.5))
		set heal = heal + CalculatePhysDamage(newTarget, damage*0.5)
	endif
	
	if GetUnitAbilityLevel(newCaster, 'B06N')>0 then										// Жанна Альтер Хилл
		call SetWidgetLife(newCaster, GetWidgetLife(newCaster)+CalculatePhysDamage(newTarget, damage*0.4))
		set heal = heal + CalculatePhysDamage(newTarget, damage*0.2)
	endif
	
	if UnitHasItemOfTypeBJ(newCaster, 'I03O') then 				// Самехада: Чистый Урон
		set bonus_damage=150+GetUnitTotalDamage(newCaster)*0.4
		if GetWidgetLife(newTarget)>bonus_damage then
			call SetWidgetLife(newTarget, GetWidgetLife(newTarget)-bonus_damage)
		else
			set fatal_damage=true
		endif
	endif
	
	if UnitHasItemOfTypeBJ(newCaster, 'I03B') then				// Меч Анбу
		set bonus_damage=55
		if GetWidgetLife(newTarget)>bonus_damage then
			call SetWidgetLife(newTarget, GetWidgetLife(newTarget)-bonus_damage)
		else
			set fatal_damage=true
		endif
	endif
	
	if UnitHasItemOfTypeBJ(newCaster, 'I050') then				// Гегецебури
		set bonus_damage=100
		if GetWidgetLife(newTarget)>bonus_damage then
			call SetWidgetLife(newTarget, GetWidgetLife(newTarget)-bonus_damage)
		else
			set fatal_damage=true
		endif
		call DestroyEffect(AddSpecialEffect("war3mapImported\\Cleave.mdx",GetUnitX(newTarget),GetUnitY(newTarget)))
		call SetControlToUnit(newTarget, newTarget, 1.0, "stun")
	endif
	
	if GetUnitAbilityLevel(newCaster,'WAE4')==0 and GetUnitAbilityLevel(newCaster,'WAE1')>0 then
        call SetControlToUnit(newTarget,newTarget, 0.3, "stun")
        call UnitAddAbility(newCaster,'WAE4')
        call UnitRemoveAbilityTimed(newCaster,'WAE4',0.7)
        call myCustomDamage(newCaster,newTarget,GetHeroInt(newCaster,true),false,false,null,null,null)
                set damage = damage * 1.5
    endif
        
        if UnitHasItemOfTypeBJ(newCaster, 'I03N') then                          // Самехада: Манажор
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Feedback\\ArcaneTowerAttack.mdl", newTarget,"origin"))
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl", newTarget,"chest"))
                if GetWidgetMana(newTarget)>0 then
                        call SetWidgetLife(newCaster, GetWidgetLife(newCaster)+GetWidgetMana(newTarget)*0.16)
        endif
		set heal = heal + GetWidgetMana(newTarget)*0.16
		call SetWidgetMana(newTarget, GetWidgetMana(newTarget)-GetWidgetMana(newTarget)*0.08)
	endif
	
	if UnitHasItemOfTypeBJ(newCaster, 'I01U') and GetRandomInt(1, 100)<=45 then 		// Feng
		call PoisonDamage5(newCaster,newTarget,2.5*GetHeroInt(newCaster,true),6,"Abilities\\Weapons\\PoisonSting\\PoisonStingTarget.mdl","chest")
        call SlowUnit(newCaster,newTarget,0.5,0.,1,1,false)
    endif
	if UnitHasItemOfTypeBJ(newCaster, 'I01Q') and (GetRandomInt(1, 100)<=20 or GetUnitAbilityLevel(newCaster,'A06K')>0) then 		// Сюсуй
		call Shusui_Cast(newCaster,1)
	endif
	
	if UnitHasItemOfTypeBJ(newTarget, 'I03C') and UnitHasItemOfTypeBJ(newTarget, 'I03F')==false then	// Жилет Анбу у таргета
		call SetWidgetLife(newTarget, GetWidgetLife(newTarget)+35)
		call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Heal\\HealTarget.mdl", newTarget,"origin"))
	endif
	
	if UnitHasItemOfTypeBJ(newTarget, 'I03F') then														// Комплект Анбу у таргета
		call SetWidgetLife(newTarget, GetWidgetLife(newTarget)+50)
		call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Heal\\HealTarget.mdl", newTarget,"origin"))
	endif
	
	if UnitHasItemOfTypeBJ(newTarget, 'I060') then														// Облако Маре D ранг
		set damage=damage-30
	endif
	
	if UnitHasItemOfTypeBJ(newTarget, 'I061') then														// Облако Маре C ранг
		set damage=damage-50
	endif
	
	if UnitHasItemOfTypeBJ(newTarget, 'I062') then														// Облако Маре B ранг
		set damage=damage-70
	endif
	
	if UnitHasItemOfTypeBJ(newTarget, 'I063') then														// Облако Маре A ранг
		set damage=damage-90
	endif
		
	if UnitHasItemOfTypeBJ(newTarget, 'I064') then														// Облако Маре Фальшивое
		set damage=damage-110
	endif
	
	if UnitHasItemOfTypeBJ(newTarget, 'I065') then														// Облако Маре Истинное
		set damage=damage-130
	endif
	
	endif
	
	if miss then
		call AllTextTag("|c00C0C0C0Miss!|r" , newTarget)
	endif
	
	if heal>0.0 then
		call HealTextTag(newCaster,newCaster,heal*myCustomHeal2(newCaster,1),"HealthRes")
	endif
	
	if fatal_damage==false then
		if damage>0 then
			call myCustomDamage(newCaster,newTarget,damage,false,false,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,null)
		endif
	else
		call UnitRemoveBuffs(newTarget,true,true)
		call UnitAddAbility(newTarget,'A0WR')
        call DamageIndicatorFunction(newCaster,newTarget,damage)
                call myCustomDamage(newCaster, newTarget, GetWidgetMaxLife(newTarget),false,false,null,null,null)
                call UnitRemoveAbility(newTarget,'A0WR')
                call AllTextTag("|c000080FFSCUM!|r" , newTarget)
        endif   
        return miss
endfunction


function VergilQ_CutAction takes nothing returns nothing
    local integer id    = GetHandleId(GetExpiredTimer())
        local real time    = LoadReal(h, id, 4)
        local real point_x = LoadReal(h, id, 2)
        local real point_y = LoadReal(h, id, 3)
        
        call SaveReal(h, id, 4, time+0.01)
        if time<1.0 then
                
                if time == 0.2 then
                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, 0)), 'd086', point_x, point_y, GetRandomInt(0, 360))
                        call SetUnitScale(n, 0.75, 0.75, 0.75)
                        call SetUnitFlyHeight(n, 80, 0)
                        call MyRemoveUnit(n, 2.0)
                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, 0)), 'd086', point_x, point_y, GetRandomInt(0, 360))
                        call SetUnitScale(n, 0.75, 0.75, 0.75)
                        call SetUnitFlyHeight(n, 80, 0)
                        call MyRemoveUnit(n, 2.0)
                        
                        // set bjLCE = AddSpecialEffect("AZ_WXLZ2.mdl", point_x, point_y)
                        // call SetSpecialEffectScale    (bjLCE, 0.9)
                        // call SetSpecialEffectZ        (bjLCE, 50)
                        // call SetSpecialEffectAlpha    (bjLCE, 200)
                        // call DestroyEffect     (bjLCE)
                elseif time == 4.0 then
                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, 0)), 'd092', point_x, point_y, GetRandomInt(0, 360))
                        call SetUnitScale(n, 2.6, 2.6, 2.6)
                        call SetUnitFlyHeight(n, 75, 0)
                        call UnitApplyTimedLife(n, 1, 0.6)
                        call MyRemoveUnit(n, 1.5)
                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, 0)), 'd090', point_x, point_y, GetRandomInt(0, 360))
                        call SetUnitScale(n, 2.6, 2.6, 2.6)
                        call SetUnitFlyHeight(n, 75, 0)
                        call UnitApplyTimedLife(n, 1, 0.6)
                        call MyRemoveUnit(n, 1.5)
                elseif time == 0.53 then
                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, 0)), 'd087', point_x, point_y, GetRandomInt(0, 360))
                        call SetUnitScale(n, 2.9, 2.9, 2.9)
                        call SetUnitTimeScale(n, 0.6)
                        call SetUnitFlyHeight(n, 150, 0)
                        call MyRemoveUnit(n, 1.0)
                        // set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, 0)), 'dH53', point_x, point_y, GetRandomInt(0, 360))
                        // call SetUnitScale(n, 1.6, 1.6, 1.6)
                        // call SetUnitTimeScale(n, 0.85)
                        // call SetUnitFlyHeight(n, 50, 0)
                        // call MyRemoveUnit(n, 0.8)
                endif
        else
                call FlushChildHashtable(h, id)
                call DestroyTimer(GetExpiredTimer())
        endif
        
endfunction

function VergilQ_Cut takes unit newCaster, real point_x, real point_y, boolean b_clone, group newGroup returns nothing
        local timer newTimer = CreateTimer()
        local integer id     = GetHandleId(newTimer)
        local real damage    = 50 + GetHeroAgi(newCaster, true)*(2 + GetUnitAbilityLevel(newCaster, 'A0PI')*1)
        if b_clone then
                set damage = damage*1.6
        endif
        
        set bjLCG=CreateGroup()
        call GroupEnumUnitsInRange(bjLCG, point_x, point_y, 300, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
                if Condition_Base(GetOwningPlayer(newCaster), E) and IsUnitInGroup(E, newGroup)==false then
                        call GroupAddUnit(newGroup, E)
                        call myCustomDamage(newCaster, E, damage, false, false, null, null, null)
                        //call VergilQ_ModifAttack(newCaster, E, b_clone)
                        call SetControlToUnit(E, E, 0.5, "stun")
                        set n=CreateUnit(GetOwningPlayer(newCaster), 'e04D', GetUnitX(E), GetUnitY(E), GetRandomInt(0, 360))
                        call SetUnitScale(n, 1.3, 1.3, 1.3)
                        call SetUnitTimeScale(n, 0.9)
                        call SetUnitFlyHeight(n, 50, 0)
                        call MyRemoveUnit(n, 2)
                        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH02', GetUnitX(E), GetUnitY(E), GetRandomInt(0, 360))
                        call SetUnitScale(n, 1.3, 1.3, 1.3)
                        call SetUnitTimeScale(n, 0.9)
                        call SetUnitFlyHeight(n, 50, 0)
                        call MyRemoveUnit(n, 2)
                endif
                call GroupRemoveUnit(bjLCG, E)
        endloop
        
        call SaveUnitHandle(h, id, 0, newCaster)
        call SaveReal(h, id, 2, point_x)
        call SaveReal(h, id, 3, point_y)
        call SaveReal(h, id, 4, 0.0)
    call TimerStart(newTimer, 0.01, true, function VergilQ_CutAction)
        
                // set n=CreateUnit(GetOwningPlayer(newCaster), 'dR86', point_x, point_y, GetRandomInt(0, 360))
                // call SetUnitScale(n, 1.9, 1.9, 1.9)
                // call SetUnitTimeScale(n, 0.6)
                // call SetUnitFlyHeight(n, 150, 0)
                // call MyRemoveUnit(n, 2)
                set n=CreateUnit(GetOwningPlayer(newCaster), 'd089', point_x, point_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 2.4, 2.4, 2.4)
                call SetUnitFlyHeight(n, 0, 0)
                call UnitApplyTimedLife(n, 1, 0.75)
                call MyRemoveUnit(n, 2)
                set n=CreateUnit(GetOwningPlayer(newCaster), 'd084', point_x, point_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 1.45, 1.45, 1.45)
                call SetUnitTimeScale(n, 0.9)
                call SetUnitFlyHeight(n, 100, 0)
                call MyRemoveUnit(n, 2)
                set n=CreateUnit(GetOwningPlayer(newCaster), 'dH28', point_x, point_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 1.45, 1.45, 1.45)
                call SetUnitTimeScale(n, 0.9)
                call SetUnitFlyHeight(n, 100, 0)
                call MyRemoveUnit(n, 2)
                set n=CreateUnit(GetOwningPlayer(newCaster), 'd085', point_x, point_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 0.8, 0.8, 0.8)
                call SetUnitFlyHeight(n, 150, 0)
                call MyRemoveUnit(n, 2)

        // set bjLCE = AddSpecialEffect("-!dimensionslash!-.mdl", point_x, point_y)
        // call SetSpecialEffectScale    (bjLCE, 0.75)
        // call SetSpecialEffectZ        (bjLCE, 50)
        // call SetSpecialEffectAlpha    (bjLCE, 120)
        // call DestroyEffect     (bjLCE)
endfunction

function VergilQ_Periodic takes nothing returns nothing
	local timer newTimer = GetExpiredTimer()
	local integer id     = GetHandleId(newTimer)
	local unit caster    = LoadUnitHandle(h, id, 0)
	local unit dummy     = LoadUnitHandle(h, id, 5)
	local real angle     = LoadReal(h, id, 1)
	local real distance  = LoadReal(h, id, 3)
	local group newGroup = LoadGroupHandle(h, id, 4)
	if distance>0 then
		call SetUnitXY(dummy, GetUnitX(dummy)+50*Cos(angle), GetUnitY(dummy)+50*Sin(angle))
		call SaveReal(h, id, 3, distance-50)
		// call GroupEnumUnitsInRange(newGroup, GetUnitX(dummy), GetUnitY(dummy), 300, Base)
		// loop
		// set E=FirstOfGroup(newGroup)
		// exitwhen E==null
		// 	if Condition_Base(GetOwningPlayer(dummy), E) then
		// 		call SaveReal(h, id, 3, 0)
		// 		call SetUnitXY(dummy, GetUnitX(dummy)+200*Cos(angle), GetUnitY(dummy)+200*Sin(angle))
		// 		call GroupClear(newGroup)
		// 	endif
		// 	call GroupRemoveUnit(newGroup, E)
		// endloop
	else
		call ShakeCamera(0.1, 10)
		call SetUnitTimeScale(caster, 1.0)
		//call SetUnitInvulnerable(caster, false)
		set n=LoadUnitHandle(h,GetHandleId(caster),StringHash("clone"))
		if n!=null then
			set angle = AU(n, caster)
			call VergilQ_Cut(caster, GetUnitX(dummy)+150*Cos(angle), GetUnitY(dummy)+150*Sin(angle), true, LoadGroupHandle(h, id, 4))
			call VergilQ_Cut(caster, GetUnitX(dummy)-150*Cos(angle), GetUnitY(dummy)-150*Sin(angle), true, LoadGroupHandle(h, id, 4))
			set soundplay=CreateSound("Sound\\war3mapImported\\VergilQ_Sound2.mp3",false,false,true,12700,12700,"")
		else
			call VergilQ_Cut(caster, GetUnitX(dummy), GetUnitY(dummy), false, LoadGroupHandle(h, id, 4))
			if GetRandomInt(0, 1)==0 then
				set soundplay=CreateSound("Sound\\war3mapImported\\VergilQ1_Sound.wav",false,false,true,12700,12700,"")
			else
				set soundplay=CreateSound("Sound\\war3mapImported\\VergilQ_Sound1.mp3",false,false,true,12700,12700,"")
			endif
		endif
		call StartSound(soundplay)
		call KillSoundWhenDone(soundplay)
		call KillUnit(dummy)
		call MyRemoveUnit(dummy, 2.0)
		call DestroyGroup(newGroup)
		call FlushChildHashtable(h, id)
		call PauseTimer(newTimer)
		call DestroyTimer(newTimer)
	endif
	set caster=null
	set newTimer=null
	set dummy=null
	set newGroup=null
endfunction

function CastJCV takes nothing returns nothing
        local timer newTimer = CreateTimer()
        local integer id     = GetHandleId(newTimer)
        local unit newCaster = GetSpellAbilityUnit()
        local real caster_x = GetUnitX(newCaster)
        local real caster_y = GetUnitY(newCaster)
        local real angle  = AtanPoint(caster_x, caster_y, GetSpellTargetX(), GetSpellTargetY())
        local real a      = 0.0
        local real distance = SquareRootPoint(caster_x, caster_y, GetSpellTargetX(), GetSpellTargetY())
        //local real damage = GetHeroAgi(newCaster, true)*3
        
    if distance>900 then
        set distance=900
    endif

		set n=CreateUnit(GetOwningPlayer(newCaster), 'dH65', caster_x+20*Cos(angle+Deg2Rad(130)), caster_y+20*Sin(angle+Deg2Rad(130)), angle*bj_RADTODEG)
		call SetUnitFlyHeight(n, 20, 0)
		call MyRemoveUnit(n, 2.0)
		
	if GetRandomInt(0, 5)==0 then
		set soundplay=CreateSound("Sound\\Music\\mp3Music\\VergilQ.mp3",false,false,true,12700,12700,"")
	else
		set soundplay=CreateSound("Sound\\war3mapImported\\VergilQ_Voice"+I2S(GetRandomInt(1,6))+".mp3",false,false,true,12700,12700,"")
	endif
	call StartSound(soundplay)
	call KillSoundWhenDone(soundplay)
	set n=LoadUnitHandle(h,GetHandleId(newCaster),StringHash("clone"))
	if n!=null then
		//set damage = damage*1.6
		call SetUnitFacingInstant(n, AtanPoint(GetUnitX(n), GetUnitY(n), GetSpellTargetX(), GetSpellTargetY())*bj_RADTODEG)
		call SetUnitAnimation(n, "spell")
		set n=CreateUnit(GetOwningPlayer(newCaster), 'd083', GetUnitX(n), GetUnitY(n), GetRandomInt(0, 360))
		call SetUnitScale(n, 0.25, 0.25, 0.25)
		call SetUnitVertexColor(n, 255, 255, 255, 100)
		call MyRemoveUnit(n, 2.0)
		set n=CreateUnit(GetOwningPlayer(newCaster), 'dR42', GetUnitX(n)+100*Cos(angle), GetUnitY(n)+100*Sin(angle), angle*bj_RADTODEG)
		call SetUnitScale(n, 0.45, 0.45, 0.45)
		call SetUnitVertexColor(n, 255, 255, 255, 180)
		call MyRemoveUnit(n, 2.0)
		set a = AtanPoint(GetUnitX(n), GetUnitY(n), GetSpellTargetX(), GetSpellTargetY())
		set n=CreateUnit(GetOwningPlayer(newCaster), 'dH65', GetUnitX(n)+20*Cos(a+Deg2Rad(130)), GetUnitY(n)+20*Sin(a+Deg2Rad(130)), a*bj_RADTODEG)
		call SetUnitFlyHeight(n, 20, 0)
		call MyRemoveUnit(n, 2.0)
	endif
	set n=LoadUnitHandle(HH, GetHandleId(newCaster), StringHash("VergilD"))
	call RemoveUnit(n)
	
	set n=CreateUnit(GetOwningPlayer(newCaster), 'd081', 0.0, 0.0, 0.0)
	call SaveUnitHandle(HH, GetHandleId(newCaster), StringHash("VergilD"), n)
	call MyRemoveUnit(n, 3)
		
	set n=CreateUnit(GetOwningPlayer(newCaster), 'd083', caster_x, caster_y, GetRandomInt(0, 360))
	call SetUnitScale(n, 0.25, 0.25, 0.25)
	call SetUnitVertexColor(n, 255, 255, 255, 100)
	call MyRemoveUnit(n, 2.0)
	set n=CreateUnit(GetOwningPlayer(newCaster), 'dR42', caster_x+100*Cos(angle), caster_y+100*Sin(angle), angle*bj_RADTODEG)
	call SetUnitScale(n, 0.45, 0.45, 0.45)
	call SetUnitVertexColor(n, 255, 255, 255, 180)
	call MyRemoveUnit(n, 2.0)
	
	set n=CreateUnit(GetOwningPlayer(newCaster), 'dAlb', caster_x+100*Cos(angle), caster_y+100*Sin(angle), angle*bj_RADTODEG)
	call SetUnitFlyHeight(n, 50, 0)
	call SaveUnitHandle(h, id, 5, n)
	call SetUnitTimeScale(newCaster, 2.0)
	//call SetUnitInvulnerable(newCaster, true)
	call SaveUnitHandle(h, id, 0, newCaster)
	call SaveReal(h, id, 1, angle)
	//call SaveReal(h, id, 2, damage)
	call SaveReal(h, id, 3, distance)
	call SaveGroupHandle(h, id, 4, CreateGroup())
	call TimerStart(newTimer, 0.005, true, function VergilQ_Periodic)

        set newTimer=null
        set newCaster=null
endfunction

function JCVInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function CastJCV)
call TriggerAddCondition(t,Condition(function CondJCV))
set t=null
endfunction
function DzuraRapCond takes nothing returns boolean
return GetSpellAbilityId()==0x41305054
endfunction
function DzuraRapCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real time=LoadReal(h,id,2)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroAgi(u,true)*0.16
if time<16 then
call UnitApplyTimedLife(CreateUnit(p,0x65304634,x,y,0),1,2)
call UnitApplyTimedLife(CreateUnit(p,'e0F3',x,y,0),1,2)
call UnitApplyTimedLife(CreateUnit(p,0x65304F38,x,y,0),1,2)
call GroupEnumUnitsInRange(G,x,y,950,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if IsUnitAlly(E,p)==false then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
else
call HealTextTag(u,E,dmg*1.5625*myCustomHeal2(E,1),"HealthRes")
call SetUnitState(E,UNIT_STATE_LIFE,GetWidgetLife(E)+dmg*1.5625)
endif
call GroupRemoveUnit(G,E)
endloop
call SaveReal(h,id,2,time+0.25)
else
call SetTerrainFogExBJ(0,6000.00,10000,0,1,1,1)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set t=null
set u=null
endfunction
function DzuraRapCast takes nothing returns nothing
local timer t=CreateTimer()
local unit u=GetTriggerUnit()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,0)
set soundplay=CreateSound("ZuraRap.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.25,true,function DzuraRapCast2)
set t=null
set u=null
endfunction
function InitTrig_DzuraRap takes nothing returns nothing
set gg_trg_DzuraRap=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_DzuraRap,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_DzuraRap,Condition(function DzuraRapCond))
call TriggerAddAction(gg_trg_DzuraRap,function DzuraRapCast)
endfunction
function EleCannonCond takes nothing returns boolean
return GetSpellAbilityId()==0x41305053
endfunction
function EleCannonCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x2=LoadReal(h,id,2)
local real y2=LoadReal(h,id,3)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real a=Atan2(y2-y1,x2-x1)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroAgi(u,true)*(3+GetUnitAbilityLevel(u,0x41305053))
if SR(x1,y1,x2,y2)>26.00 then
set x1=x1+47*Cos(a)
set y1=y1+47*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
call UnitApplyTimedLife(CreateUnit(p,0x65304F36,x1,y1,a*bj_RADTODEG),1,0.01)
else
call UnitApplyTimedLife(CreateUnit(p,'e048',x1,y1,0),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e03W',x1,y1,0),0,4)
call DestroyEffect(AddSpecialEffect("war3mapImported\\explode.mdx",x1,y1))
call DestroyEffect(AddSpecialEffect("war3mapImported\\SuperBigExplosion.mdx",x1,y1))
call GroupEnumUnitsInRange(DG,x1,y1,400,Base)
loop
set E=FirstOfGroup(DG)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 2, "stun")
endif
call GroupRemoveUnit(DG,E)
endloop
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call KillUnit(l__d)
endif
set l__d=null
set p=null
set u=null
set t=null
endfunction
function EleCannonCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,GetSpellTargetX())
call SaveReal(h,id,3,GetSpellTargetY())
call SaveUnitHandle(h,id,1,CreateUnit(GetOwningPlayer(u),0x65304F35,GetUnitX(u),GetUnitY(u),GetUnitFacing(u)))
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Elizabeth.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.02,true,function EleCannonCast2)
set u=null
set t=null
endfunction
function InitEleCannon takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function EleCannonCast)
call TriggerAddCondition(t,Condition(function EleCannonCond))
set t=null
endfunction
function CurryCond takes nothing returns boolean
return GetSpellAbilityId()=='A0PQ' and udg_B==true
endfunction
function HealCurry2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real per=LoadReal(h,id,3)
local real dmg=LoadReal(h,id,2)/per
local integer i=LoadInteger(h,id,3)
if i<per then
call HealTextTag(u,c,dmg*myCustomHeal2(c,1),"HealthRes")
call SetUnitState(c,UNIT_STATE_LIFE,GetWidgetLife(c)+dmg)
call SaveInteger(h,id,3,i+1)
else
call PauseTimer(t)
call DestroyTimer(t)
call DestroyEffect(LoadEffectHandle(h,id,0))
call FlushChildHashtable(h,id)
endif
set u=null
set c=null
set t=null
endfunction
function HealCurry takes unit u, unit c,real dmg,real per,string l__s returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveEffectHandle(h,id,0,AddSpecialEffectTarget(l__s,c,"origin"))
call SaveReal(h,id,2,dmg)
call SaveReal(h,id,3,per)
call TimerStart(t,1,true,function HealCurry2)
set t=null
endfunction
function MissleMoveCurry2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,4)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)+angle
if SR(x,y,x1,y1)>30 then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
else
if IsUnitAlly(c,GetOwningPlayer(LoadUnitHandle(h,id,6)))==false then
call PoisonDamage3(LoadUnitHandle(h,id,6),c,LoadReal(h,id,5),6,"Environment\\LargeBuildingFire\\LargeBuildingFire1.mdl","origin")
else
call HealCurry(LoadUnitHandle(h,id,6),c,LoadReal(h,id,5),6,"Environment\\LargeBuildingFire\\LargeBuildingFire1.mdl")
endif
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set c=null
set l__d=null
set t=null
endfunction
function MissleMoveCurry takes unit l__d,real speed,real angle,unit target,string l__s,real dmg,unit damager returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveStr(h,id,3,l__s)
call SaveUnitHandle(h,id,4,target)
call SaveReal(h,id,5,dmg)
call SaveUnitHandle(h,id,6,damager)
call TimerStart(t,0.035,true,function MissleMoveCurry2)
set t=null
endfunction
function CurryCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local player p=GetOwningPlayer(u)
local integer i=0
local real dmg=(1+GetUnitAbilityLevel(u,'A0PQ'))*GetHeroAgi(u,true)+50
call GroupEnumUnitsInRange(G,x1,y1,400,Base)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Curry Ninja.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if UnitIsAlive(E)==true then
call MissleMoveCurry(CreateUnit(p,0x65304F34,x,y,0),50,0,E,"",dmg,u)
endif
call GroupRemoveUnit(G,E)
endloop
set u=null
set p=null
endfunction
function InitTrig_Curry takes nothing returns nothing
set gg_trg_Curry=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Curry,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_Curry,Condition(function CurryCond))
call TriggerAddAction(gg_trg_Curry,function CurryCast)
endfunction
function TimedBombCond takes nothing returns boolean
return GetSpellAbilityId()==0x41305050
endfunction
function TimedBombCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local player p=GetOwningPlayer(u)
if UnitIsAlive(l__d)then
call GroupEnumUnitsInRange(G,x,y,150,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call KillUnit(l__d)
endif
call GroupRemoveUnit(G,E)
endloop
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set t=null
set u=null
endfunction
