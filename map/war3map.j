function RDantesCast4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real z=GetUnitFlyHeight(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real z1=GetUnitFlyHeight(c)
local player p=GetOwningPlayer(u)
local real a=Atan2(y1-y,x1-x)
local real f
local real dist=SR3D(x,y,z,x1,y1,z1)
local real PitchA=Atan2(dist,z)
local real time=LoadReal(h,id,3)
local real he=GetUnitFlyHeight(u)
local boolean DMGBool=LoadBoolean(h,id,4)
local real dmg=(3+GetUnitAbilityLevel(u,'Ad9R'))*GetHeroAgi(u,true)*0.25
if time>0 then
    call SaveReal(h,id,3,time-0.03)
    call SetUnitOrientation(u,a*bj_RADTODEG,(PitchA*bj_RADTODEG)-80,0)
    if time>=1.8 then
        set x=x-4*time*Cos(a)
        set y=y-4*time*Sin(a)
        call SetUnitXY_1(u,x,y, false)
        call SetUnitFlyHeight(u,he+8*time,0)
    elseif time>=1.4 and time<1.8 then
        set x=x-2*time*Cos(a)
        set y=y-2*time*Sin(a)
        call SetUnitXY_1(u,x,y, false)
        call SetUnitFlyHeight(u,he+2*time,0)
        if time==1.7 then
            call SetUnitAnimationByIndex(u,7)
        endif
        if time==1.55 then
            set soundplay=CreateSound("Sound\\Music\\mp3Music\\DantesBGR5.mp3",false,false,true,12700,12700,"")
            call StartSound(soundplay)
            call KillSoundWhenDone(soundplay)
        endif
    elseif (time>=1.15 and time<1.4) or time<0.8 then
        set x=x-6*Cos(a)
        set y=y-6*Sin(a)
        call SetUnitXY_1(u,x,y, false)
        if time>0.3 then
            call SetUnitFlyHeight(u,he+5*time,0)
        else
            call SetUnitFlyHeight(u,he-3,0)
        endif
    elseif time>=0.8 and time<1.15 then
        set x=x+2*time*Cos(a)
        set y=y+2*time*Sin(a)
        call SetUnitXY_1(u,x,y, false)
        call SetUnitFlyHeight(u,he-2*time,0)
        if time==0.95 then
            call SetUnitAnimationByIndex(u,9)
        endif
    endif
    if time==0.8 then
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\DantesBGR6.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
    endif
else
    call SetUnitAnimation(n,"stand")
    call PauseUnit(u,false)
    call SetUnitInvulnerable(u,false)
    call PauseUnit(c,false)
    call SetUnitInvulnerable(c,false)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
    call UnitEnableAutoOrientation(c,true)
    call UnitEnableAutoOrientation(u,true)
    call SetControlToUnit(c,c, 1, "stun")
    if GetUnitAbilityLevel(u, 'CB01') > 0 then
        call UnitRemoveAbility(u, 'CE01')
        call UnitRemoveAbility(u, 'CB01')
    endif
    call SetUnitFlyHeight(u,0,2300)
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(h,id)
endif
if time==0.8 or time==1.4 then
    set n=CreateUnit(p,'e1DM',x+5*Cos(a),y+5*Sin(a),a*bj_RADTODEG)
    call UnitEnableAutoOrientation(n,false)
    call SetUnitFlyHeight(n,GetUnitFlyHeight(u)-80+PitchA*bj_RADTODEG*0.3,0)
    call SetUnitOrientation(n,a*bj_RADTODEG,(PitchA*0.5*bj_RADTODEG)-90,0)
    call UnitApplyTimedLife(n,'BHwe',0.2)
    call SetUnitTimeScale(n,1)
    call PauseUnit(c,false)
    call SetUnitInvulnerable(c,false)
    set n=CreateUnit(p,'e168',x1,y1,GetRandomReal(0,359))
    call SetUnitModel(n,"DantesExplosion1R.mdx")
    call UnitApplyTimedLife(n,1,0.03)
    call SetUnitScale(n,0.7,0.7,0.7)
    call SetUnitVertexColor(n,255,255,255,125)
    call SetUnitTimeScale(n,1.3)
    set EFF=AddSpecialEffect("war3mapImported\\blue-guagnzhu-special.mdl",x1,y1)
    call SetSpecialEffectScale(EFF , 1.3)
    call SetSpecialEffectTimeScale(EFF, 4)
    call RemoveEffect(EFF,0.5,true,CreateTimer())
    set EFF=AddSpecialEffect("tx_huoyandaji_blue.mdl",x1,y1)
    call SetSpecialEffectScale(EFF , 1.8)
    call RemoveEffect(EFF,0.9,true,CreateTimer())
    if DMGBool then
        set dmg = dmg * 1.15
    endif
    call GroupEnumUnitsInRange(DG,x1,y1,300,Base)
    loop
        set E=FirstOfGroup(DG)
        exitwhen E==null
        if Condition_Base(p,E) then
            call myCustomDamage(u,E,dmg,false,false,null,null,null)
        endif
        call GroupRemoveUnit(DG,E)
    endloop
    call PauseUnit(c,true)
    call SetUnitInvulnerable(c,true)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function RDantesCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
