if time==0.5 then
call UnitSpeed(n0,1.25)
call SaveBoolean(HH,GetHandleId(caster),SH_JirTS,false)
call EffectCreateAndMove(true,"Madara\\[DoFT]az_hit-blue-blade.mdl",facing+180,1,2.5,0.3,100,100,100,0,200,n0,350,facing)
call EffectCreateAndMove(true,"Madara\\[A]n3s_o_target.mdl",facing,1,2.5,0.7,100,100,100,0,200,n0,350,facing)
call EffectCreateAndMove(true,"Madara\\File00000827.mdl",facing,1,3,0.4,100,100,100,0,0,n0,150,facing)
call EffectCreateAndMove(true,"Madara\\[DoFT]az_pafeathermoon_b.mdl",facing,1,3,0.5,100,100,100,0,150,n0,350,facing)
call EffectCreateAndMove(true,"Madara\\blue-slash-more.mdl",facing,1,1.1,0.6,100,100,100,80,100,n0,350,facing)
call EffectCreateAndMove(true,"Madara\\WindCircleFaster.mdl",GetRandomReal(0,360),1,1.35,0.8,100,100,100,60,100,n0,350,facing)
call EffectCreateAndMove(true,"Madara\\[A]az_axe_ef1.mdl",GetRandomReal(0,360),0.7,0.8,0.5,100,100,100,60,0,n0,350,facing)



call DamageAoeOneTime0(caster,LoadReal(HH,id,11),LoadReal(HH,id,12),450,GetHeroStr(caster,true)*3)





call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)

else

if time==0.02 then
set soundplay=SndN(4075) // Sound\Music\mp3Music\GamabuntaTR.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SetUnitAnimationByIndex(n0,1)
call SetUnitFacingInstant(n0,Angle2(GetUnitX(n0),GetUnitY(n0),LoadReal(HH,id,11),LoadReal(HH,id,12)))
call UnitSpeed(n0,1.5)
call EffectCreateAndMove(true,"Madara\\StarSlashNew.mdl",facing,1,1.5,0.45,100,100,100,0,100,n0,0,facing)
endif
if time==0.2 then
call SetUnitAnimationByIndex(n0,2)
call UnitSpeed(n0,0.75)
endif
if time==0.3 then
call EffectCreateAndMove(true,"Madara\\HakenSaber2.mdl",GetRandomReal(0,360),1,0.75,0.4,100,100,100,40,0,n0,0,GetRandomReal(0,360))
call EffectCreateAndMove(true,"Madara\\BlackBlink1.mdl",GetRandomReal(0,360),1,2,0.4,100,100,100,0,0,n0,0,GetRandomReal(0,360))
call MoveAoe1(LoadReal(HH,id,11),LoadReal(HH,id,12),n0,-350,facing)
call EffectCreateAndMove(true,"Madara\\HakenSaber2.mdl",GetRandomReal(0,360),1,0.75,0.4,100,100,100,40,0,n0,0,GetRandomReal(0,360))
call EffectCreateAndMove(true,"Madara\\BlackBlink1.mdl",GetRandomReal(0,360),1,2,0.4,100,100,100,0,0,n0,0,GetRandomReal(0,360))
endif
if time==0.4 then
call UnitSpeed(n0,1.5)
endif
endif
set caster=null
set n0=null
set t=null
endfunction

function JirayaTR takes unit Jiraya,real x00,real y00 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit JirayaBunta=LoadUnitHandle(HH,GetHandleId(Jiraya),SH_JirTG)
local real facing=Angle2(GetUnitX(JirayaBunta),GetUnitY(JirayaBunta),x00,y00)
call SaveUnitHandle(HH,id,1,Jiraya)
call SaveUnitHandle(HH,id,2,JirayaBunta)
call SaveReal(HH,id,3,facing)
call SaveBoolean(HH,GetHandleId(Jiraya),SH_JirTS,true)
call SaveReal(HH,id,11,x00)
call SaveReal(HH,id,12,y00)
call TimerStart(t,0.02,true,function JirayaTRAct)
set JirayaBunta=null
set t=null
set Jiraya=null
endfunction


function JirayaTWAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local real facing
local real time
local unit Dummy
local real time1
set n0=LoadUnitHandle(HH,id,2)
set facing=LoadReal(HH,id,3)
set time=LoadReal(HH,id,5)
set time=time+0.02
call SaveReal(HH,id,5,time)
if time==20 then
call SaveBoolean(HH,GetHandleId(caster),SH_JirTS,false)
call EffectCreateAndMove(true,"Madara\\file00003531.mdl",facing,1,1.75,0.8,100,100,100,0,-100,LoadUnitHandle(HH,id,20),0,facing)
call EffectCreateAndMove(true,"Madara\\file00002678.mdl",facing,1,1.5,0.8,100,100,100,0,-100,LoadUnitHandle(HH,id,20),0,facing)
call EffectCreateAndMove(true,"Madara\\file00000097.mdl",facing,1,1.5,0.8,100,100,100,0,-100,LoadUnitHandle(HH,id,20),0,facing)



call DamageAoeOneTime0(caster,LoadReal(HH,id,11),LoadReal(HH,id,12),400,GetHeroStr(caster,true)*2)



call RemoveUnit(LoadUnitHandle(HH,id,20))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
else
if time==0.02 then
set soundplay=SndN(4078) // Sound\Music\mp3Music\GamabuntaTW.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять



//set facing=Angle2(GetUnitX(n0),GetUnitY(n0),LoadReal(HH,id,11),LoadReal(HH,id,12))
if SR(GetUnitX(n0),GetUnitY(n0),LoadReal(HH,id,11),LoadReal(HH,id,12))<400 then
call SetUnitX(n0,PolX(LoadReal(HH,id,11),-400,facing))
call SetUnitY(n0,PolY(LoadReal(HH,id,12),-400,facing))
endif
call SetUnitAnimationByIndex(n0,5)
//set facing=Angle2(GetUnitX(n0),GetUnitY(n0),LoadReal(HH,id,11),LoadReal(HH,id,12))
//call SaveReal(HH,id,3,facing)
//call SetUnitFacingInstant(n0,facing)
call UnitSpeed(n0,1.5)
endif
if time==0.3 then
set n=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(n0),GetUnitY(n0),facing)
call SaveUnitHandle(HH,id,20,n)
call SetUnitFlyHeight(n,300,0)
call MoveUnit(n,n,100,facing)
call SaveReal(HH,id,16,300/SR(GetUnitX(n),GetUnitY(n),LoadReal(HH,id,11),LoadReal(HH,id,12))/40)
endif
if time>=0.3 then
set Dummy=LoadUnitHandle(HH,id,20)
set facing=Angle2(GetUnitX(Dummy),GetUnitY(Dummy),LoadReal(HH,id,11),LoadReal(HH,id,12))
call SetUnitFacingInstant(Dummy,facing)
if SR(GetUnitX(Dummy),GetUnitY(Dummy),LoadReal(HH,id,11),LoadReal(HH,id,12))>40 then
call MoveUnit(Dummy,Dummy,40,facing)
call SetUnitFlyHeight(Dummy,GetUnitFlyHeight(Dummy)-LoadReal(HH,id,16),0)
set time1=LoadReal(HH,id,6)
set time1=time1+0.02
if time1==0.1 then
set time1=0
call EffectCreateAndMove(true,"Madara\\file0000 (621).mdl",facing,1,1.25,GetRandomReal(0.6,0.8),100,100,100,30,50,Dummy,0,facing)
endif
call SaveReal(HH,id,6,time1)
else
call SaveReal(HH,id,5,19.98)
endif

endif
endif

set Dummy=null
set caster=null
set n0=null
set t=null
endfunction
function JirayaTW takes unit Jiraya,real x00,real y00 returns nothing
