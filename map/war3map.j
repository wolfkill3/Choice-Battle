function CreateModeIndicatorWithPauseSabrac_Periodic takes nothing returns nothing
    local timer t               =GetExpiredTimer()
    local integer id            =GetHandleId(t)
    local unit caster           =LoadUnitHandle(HH, id, c_CASTER)
    local player p              =GetOwningPlayer(caster)
    local integer idp           =GetHandleId(p)
    local string mode_name      =LoadStr(HH, id, c_NAME)
    local framehandle NewFrame  =LoadFrameHandle(HH, idp,StringHash(mode_name))
    local real duration         =LoadReal(HH, GetHandleId(NewFrame), c_DURATION)-0.05
    local integer position         =LoadInteger(HH, id, c_POSITION)
    local boolean SabracTOn=LoadBoolean(HH,GetHandleId( LoadUnitHandle(HH, id,30) ),SH_SabracTBool)
    if position>0 then
        if LoadBoolean(HH,idp,position-1)==false then
        call SaveBoolean(HH,idp,position-1,true)
        call SaveBoolean(HH,idp,position,false)
        call SaveInteger(HH, id, c_POSITION,position-1)
        set position=position-1
        endif
    endif

    if IsUnitPaused(caster)==false and IsUnitHidden(caster)==false and GetUnitAbilityLevel(caster,'Pet1')==0 then
        call SaveReal           (HH, GetHandleId(NewFrame), c_DURATION, duration)
        call StatusIndicatorText(NewFrame, idp, mode_name, duration)
    endif

    call StatusIndicatorPlace(NewFrame, position)
    if duration<=0 or udg_B==false or DU2==false or UnitIsAlive(caster)==false  or SabracTOn==false then
        call ShowFrame( NewFrame, false )
        call SaveReal(HH, GetHandleId(NewFrame), c_DURATION, 0)
        call SaveReal(HH, GetHandleId(LoadFrameHandle(HH, idp,StringHash(mode_name+"2"))), c_DURATION, 0)
        call SaveBoolean(HH,idp,position,false)
        call FlushChildHashtable(HH, id)
        call DestroyTimer(t)
    endif
    set t=null
    set caster=null
    set NewFrame=null
    set p=null
endfunction


function CreateModeIndicatorWithPauseSabrac takes unit newCasterOwner,unit newCaster, string newString, real newDur returns nothing
        local timer newTimer        = CreateTimer()
        local integer id            = GetHandleId(newTimer)
    local framehandle NewFrame  = null
    local framehandle NewFrameText  = null
    local player p              =GetOwningPlayer(newCaster)
    local integer idp           =GetHandleId(p)
    local integer i=23
    local integer j=0
    if LoadFrameHandle(HH, idp,StringHash(newString))==null then    
        set NewFrame = CreateFrameByType( "SIMPLEBUTTON", newString, StatusBarFrame, "", 0 )
        call ClearFrameAllPoints( NewFrame )
        call SetFrameTexture( NewFrame, newString, 0, true )
        call SetFrameTexture( NewFrame, newString, 1, true )
        call SetFrameTexture( NewFrame, newString, 2, true )
        call SetFrameSize( NewFrame, .019, .019 )
        call SetFramePriority( NewFrame, 7 )
        call HandleListAddHandle(StatusBarFrameList[GetPlayerId(p)],NewFrame)
        call SetFrameParent(NewFrame,StatusBarFrame)
        //if IsUnitSelected( newCaster, GetLocalPlayer())==false then
        call ShowFrame( NewFrame, GetOwningPlayer(GetUnitSelected(GetLocalPlayer()))==GetOwningPlayer(newCaster) and (IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(newCaster)) or GetPlayerId(GetLocalPlayer())==10 or GetPlayerId(GetLocalPlayer())==11))
        call ShowFrame( NewFrameText, GetOwningPlayer(GetUnitSelected(GetLocalPlayer()))==GetOwningPlayer(newCaster) and (IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(newCaster)) or GetPlayerId(GetLocalPlayer())==10 or GetPlayerId(GetLocalPlayer())==11))
        call SaveFrameHandle(HH,idp,StringHash(newString),NewFrame)
        call StatusIndicatorTooltip(NewFrame, newString)
        //call SaveReal               (HH, GetHandleId(NewFrame), c_DURATION, 2)
        
        set NewFrameText=CreateFrameByType( "SIMPLETEXT", newString+"1", NewFrame, "", 0 )
        call ClearFrameAllPoints( NewFrameText )
        call SetFrameBlendMode( NewFrameText, 0, BLEND_MODE_BLEND )
        call SetFrameFont( NewFrameText, "Fonts\\FRIZQT__.TTF", .008, 0 )
        call SetFrameTextAlignment( NewFrameText, TEXT_JUSTIFY_CENTER, TEXT_JUSTIFY_LEFT )
        call SetFrameText( NewFrameText, R2SW(newDur,2, 1) )
        call SetFrameTextColour( NewFrameText, 0xFFFFA500 )
        call HandleListAddHandle(StatusBarFrameList[GetPlayerId(p)],NewFrameText)
        call ShowFrame( NewFrameText, GetOwningPlayer(GetUnitSelected(GetLocalPlayer()))==GetOwningPlayer(newCaster) and (IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(newCaster)) or GetPlayerId(GetLocalPlayer())==10 or GetPlayerId(GetLocalPlayer())==11))
        call SaveFrameHandle(HH,idp,StringHash(newString+"2"),NewFrameText)
    else
        if LoadReal(HH, GetHandleId(NewFrame), c_DURATION)<=0 then
            set NewFrame=LoadFrameHandle(HH, idp,StringHash(newString))
            set NewFrameText=LoadFrameHandle(HH, idp,StringHash(newString+"2"))
            call SetFrameText( NewFrameText, R2SW(newDur,2, 1) )
            call ShowFrame( NewFrame, GetOwningPlayer(GetUnitSelected(GetLocalPlayer()))==GetOwningPlayer(newCaster) and (IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(newCaster)) or GetPlayerId(GetLocalPlayer())==10 or GetPlayerId(GetLocalPlayer())==11))
            call ShowFrame( NewFrameText, GetOwningPlayer(GetUnitSelected(GetLocalPlayer()))==GetOwningPlayer(newCaster) and (IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(newCaster)) or GetPlayerId(GetLocalPlayer())==10 or GetPlayerId(GetLocalPlayer())==11))
        endif
    endif
    if LoadReal(HH, GetHandleId(NewFrame), c_DURATION)<=0 then
        loop
            exitwhen i==0
            if LoadBoolean(HH,idp,i)==false then
            call SaveBoolean(HH,idp,i,true)
            call SaveBoolean(HH,idp,i+1,false)
            set j=i
            endif
            set i=i-1
        endloop
        call SetFrameRelativePoint( NewFrame, FRAMEPOINT_CENTER, StatusBarFrame, FRAMEPOINT_LEFT, 0.017+j*0.025, 0.005 )
        call SetFrameRelativePoint( NewFrameText, FRAMEPOINT_BOTTOM, NewFrame, FRAMEPOINT_BOTTOM, .0, -.01 )
        call SaveUnitHandle         (HH, id, c_CASTER, newCaster)
        call SaveUnitHandle         (HH, id, 30, newCasterOwner)
        call SaveReal               (HH, GetHandleId(NewFrame), c_DURATION, newDur)
        call SaveReal               (HH, GetHandleId(NewFrameText), c_DURATION, newDur)
        call SaveInteger            (HH, id, c_POSITION, j)
        call SaveInteger(HH,GetHandleId(NewFrame),SB_POS,0)
        call RemoveSavedString(HH,GetHandleId(NewFrame),SB_TXT)
        call SaveStr                (HH, id, c_NAME, newString)
        call TimerStart             (newTimer, 0.05, true, function CreateModeIndicatorWithPauseSabrac_Periodic)
    else
        call SaveReal           (HH, GetHandleId(NewFrame), c_DURATION, newDur)
        call SaveReal           (HH, GetHandleId(NewFrameText), c_DURATION, newDur)
    endif
    set newTimer=null
    set p=null
    set NewFrame=null
    set NewFrameText=null
endfunction




///////////////////savracUjapiend














function SabracTAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real damage=LoadReal(HH,id,15)
local boolean SabracTOn=LoadBoolean(HH,GetHandleId(caster),SH_SabracTBool)
local real distance=SR(GetUnitX(caster),GetUnitY(caster),GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)))


//local fogmodifier f
if IsUnitPaused( LoadUnitHandle(HH,id,20) ) ==false then
set time=time+0.02
call SaveReal(HH,id,5,time)
endif


call MoveUnit(LoadUnitHandle(HH,id,20),LoadUnitHandle(HH,id,21),0,facing)
//call CreateFogModifierRadius(Player(GetPlayerId(GetOwningPlayer(caster))),FOG_OF_WAR_VISIBLE,GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),1500,true,true)

//call FogModifierStart(f)

if LoadUnitHandle(HH,GetHandleId(LoadUnitHandle(HH,id,20)),SH_SabracTKillU)!=null then
call SabracTPassiveAct(caster,LoadUnitHandle(HH,GetHandleId(LoadUnitHandle(HH,id,20)),SH_SabracTKillU))
call SaveUnitHandle(HH,GetHandleId(LoadUnitHandle(HH,id,20)),SH_SabracTKillU,null)
call UnitRemoveAbility(caster,'SaT2')
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'SaT1',true)
call SaveBoolean(HH,GetHandleId(caster),SH_SabracTBool,false)
if LoadUnitHandle(HH,id,20)!=null then
call SabracCloneDie(LoadUnitHandle(HH,id,20))
endif

call RemoveUnit(LoadUnitHandle(HH,id,21))

call UnitRemoveAbility(caster,'SaTI')


//call SetItemDroppable(UnitItemInSlot(caster,0),true)
//call SetItemDroppable(UnitItemInSlot(caster,1),true)
//call SetItemDroppable(UnitItemInSlot(caster,2),true)
//call SetItemDroppable(UnitItemInSlot(caster,3),true)
//call SetItemDroppable(UnitItemInSlot(caster,4),true)
//call SetItemDroppable(UnitItemInSlot(caster,5),true)

call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif





if  udg_B==false or LoadUnitHandle(HH,id,20)==null or (time>=15 or SabracTOn==false or distance>2500)and IsUnitPaused(LoadUnitHandle(HH,id,20))==false then
call UnitRemoveAbility(caster,'SaT2')
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'SaT1',true)
call SaveUnitHandle(HH,GetHandleId(caster),SH_SabracTU,null)
call SaveBoolean(HH,GetHandleId(caster),SH_SabracTBool,false)
if LoadUnitHandle(HH,id,20)!=null then
call SabracCloneDie(LoadUnitHandle(HH,id,20))
endif


call RemoveUnit(LoadUnitHandle(HH,id,21))

call UnitRemoveAbility(caster,'SaTI')


//call SetItemDroppable(UnitItemInSlot(caster,0),true)
//call SetItemDroppable(UnitItemInSlot(caster,1),true)
//call SetItemDroppable(UnitItemInSlot(caster,2),true)
//call SetItemDroppable(UnitItemInSlot(caster,3),true)
//call SetItemDroppable(UnitItemInSlot(caster,4),true)
//call SetItemDroppable(UnitItemInSlot(caster,5),true)




call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
set caster=null



//set f=null


endfunction





function SabracThrowKnife1 takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real distance=LoadReal(HH,id,8)
local real speed=LoadReal(HH,id,9)
local real distanceMax=LoadReal(HH,id,10)
local real x1=PolX(GetUnitX( LoadUnitHandle(HH,id,20) ), speed ,facing)
local real y1=PolY(GetUnitY( LoadUnitHandle(HH,id,20) ), speed ,facing)
local real damage=LoadReal(HH,id,15)
local real time=LoadReal(HH,id,5)
local real KnifeAoe=LoadReal(HH,id,22)
local real KnifeFacing=LoadReal(HH,id,23)
local boolean FakeSword=LoadBoolean(HH,id,19)
set time=time+0.02
if time==0.1 then
set time=0
if FakeSword==true then
call EffectCreateAndMove90(true,"Sabrac\\wind3.mdl",facing+180,1,GetRandomReal(0.2,0.4),speed*0.02+GetRandomReal(1,1.5),100,50,50,30,0,LoadUnitHandle(HH,id,20),50,facing)
else
call EffectCreateAndMove90(true,"Sabrac\\wind3.mdl",facing+180,1,GetRandomReal(0.4,0.7),speed*0.02+GetRandomReal(1,1.5),100,50,50,30,0,LoadUnitHandle(HH,id,20),50,facing)
endif
endif
call SaveReal(HH,id,5,time)



if distance>=distanceMax or IsTerrainPathable(x1,y1,PATHING_TYPE_FLYABILITY)==true then
if LoadBoolean(HH,id,31)==true then
if FakeSword==true then
call EffectCreateAndMove(true,"Sabrac\\az_siwen3.mdl",facing,1,1,0.8,100,100,100,0,50,LoadUnitHandle(HH,id,20),0,facing)
call DamageAoeOneTime(caster,GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),KnifeAoe*3,damage*1.2,LoadGroupHandle(HH,id,4))
set soundplay=SndN(3882) // Sound\Music\mp3Music\SabracQF_Hit.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
call EffectCreateAndMove(true,"Sabrac\\az_siwen3.mdl",facing,1,1.5,0.8,100,100,100,0,50,LoadUnitHandle(HH,id,20),0,facing)
call EffectCreateAndMove(true,"Sabrac\\red-yumao-zhendiLord.mdl",facing,1,1.5,1.5,100,100,100,0,0,LoadUnitHandle(HH,id,20),0,facing)
set soundplay=SndN(3882) // Sound\Music\mp3Music\SabracQF_Hit.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SabracStackOneTime(caster,GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),KnifeAoe*3)
call DamageAoeOneTime(caster,GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),KnifeAoe*3,damage*1.2,LoadGroupHandle(HH,id,4))
endif
endif
if LoadGroupHandle(HH,id,4)!=null then
call DestroyGroup(LoadGroupHandle(HH,id,4))
call SaveGroupHandle(HH,id,4,null)
endif
call RemoveUnit(LoadUnitHandle(HH,id,20))
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else
call MoveUnit(LoadUnitHandle(HH,id,20),LoadUnitHandle(HH,id,20),speed,facing)
if LoadBoolean(HH,id,31)==true then
call GroupClear(G)
call GroupEnumUnitsInRange(G,GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),KnifeAoe,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if IsUnitEnemy(n0,GetOwningPlayer(caster))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(n0,'Avul')==0 then
set distance=distanceMax
call SaveReal(HH,id,8,distanceMax)
call GroupClear(G)
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
else

if FakeSword==true then
call DamageAoeOneTime(caster,GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),KnifeAoe,damage,LoadGroupHandle(HH,id,4))
else
call DamageAoeOneTimeSabracE(caster,GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),KnifeAoe,damage,LoadGroupHandle(HH,id,4))
endif

endif
call SaveReal(HH,id,8,distance+speed)
endif
set caster=null
endfunction
function SabracThrowKnife takes unit caster1,unit casterOriginal1,real facing0,real damage0,integer swords0,boolean plussword0,real x00,real y00,boolean sabraczoneF returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real randomspeed=40
local real x0=GetUnitX(caster1)
local real y0=GetUnitY(caster1)
local real hight=GetRandomInt(100,250)
local boolean lowrange=false
call SaveReal(HH,id,11,x00)
call SaveReal(HH,id,12,y00)
call SaveUnitHandle(HH,id,1,caster1)
call SaveGroupHandle(HH,id,4,CreateGroup())
call SaveReal(HH,id,15,damage0)
call SaveBoolean(HH,id,19,plussword0)
call SaveReal(HH,id,25,facing0)
call SaveUnitHandle(HH,id,30,casterOriginal1)
call SaveBoolean(HH,id,31,sabraczoneF)
if plussword0==true then
if GetRandomInt(1,2)==1 then
call SaveReal(HH,id,10,0.8*(1600+35*swords0)+GetRandomReal(-120,-60))
else
call SaveReal(HH,id,10,0.8*(1600+35*swords0)+GetRandomReal(60,120))
endif
else

call SaveReal(HH,id,10,1600+35*swords0)

endif

if 35*swords0>3400 then
call SaveReal(HH,id,10,5000)
endif

if SR(x0,y0,x00,y00)<400 then
set lowrange=true
call SaveBoolean(HH,id,24,lowrange)
endif
if plussword0==true then
if GetRandomInt(1,2)==1 then
set x0=PolX(x0,GetRandomInt(50,20),facing0+90)
set y0=PolY(y0,GetRandomInt(50,20),facing0+90)
if lowrange==false then
set facing0=Angle2(x0,y0,x00,y00)+4000/SR(x0,y0,x00,y00)
endif
else
set x0=PolX(x0,GetRandomInt(50,200),facing0-90)
set y0=PolY(y0,GetRandomInt(50,200),facing0-90)
if lowrange==false then
set facing0=Angle2(x0,y0,x00,y00)-4000/SR(x0,y0,x00,y00)
endif
endif
call SaveReal(HH,id,22,100)
else
call SaveReal(HH,id,22,135)
endif
set n0=CreateUnit(GetOwningPlayer(caster1),'e200',x0,y0,facing0)
call SetUnitModel(n0,"Sabrac\\SabracKnife.mdl")
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call SetUnitFlyHeight(n0,hight,0)
if plussword0==true then
call EffectCreateAndMove(true,"Sabrac\\red-lizi-shunjian.mdl",GetRandomReal(0,360),1,0.1,0.75,100,100,100,0,0,n0,150,facing0)
call EffectCreateAndMove90(true,"Sabrac\\rasengan_eff4.mdl",facing0+180,0.75,0.25,0.8,100,100,100,0,0,n0,150,facing0)
else
call EffectCreateAndMove(true,"Sabrac\\red-zhendi-shanguang.mdl",GetRandomReal(0,360),1,1,1,100,100,100,0,0,caster1,0,facing0)
call EffectCreateAndMove(true,"Sabrac\\red-lizi-shunjian.mdl",GetRandomReal(0,360),1,1,0.75,100,100,100,0,0,n0,150,facing0)
call EffectCreateAndMove90(true,"Sabrac\\rasengan_eff4.mdl",facing0+180,0.75,0.4,0.8,100,100,100,0,0,n0,150,facing0)
endif
call MoveUnit(n0,n0,80,facing0)
if plussword0==true then
call UnitSize(n0,1.4,1,1)
set randomspeed=randomspeed*0.8
else
call UnitSize(n0,1.75,1,1)
endif
call SaveReal(HH,id,9,randomspeed+0.6*swords0)
call SetUnitFlyHeight(n0,100,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=null
call SaveReal(HH,id,3,facing0)
call TimerStart(t,0.02,true,function SabracThrowKnife1)
set caster1=null
set t=null
endfunction



function SabracQAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit casterOriginal=LoadUnitHandle(HH,id,30)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real distance=LoadReal(HH,id,8)
local integer SabracSwords=(LoadInteger(HH,GetHandleId( (GetOwningPlayer( casterOriginal )) ),SabracSwordsHash))
local real damage=LoadReal(HH,id,15)
local integer PlusSwords=R2I(SabracSwords*0.2)
set time=time+0.02
call SaveReal(HH,id,5,time)
if time>0 and time<0.1 then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
endif
if time==0.1 then
set damage=damage+SabracSwords*10
call UnitSpeed(caster,1)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
call SabracThrowKnife(caster,casterOriginal,facing,damage,SabracSwords,false,LoadReal(HH,id,11),LoadReal(HH,id,12),LoadBoolean(HH,id,31))
if PlusSwords>5 then
set PlusSwords=5
endif
if PlusSwords>0 then
loop
call SabracThrowKnife(caster,casterOriginal,facing,damage*0.2,SabracSwords,true,LoadReal(HH,id,11),LoadReal(HH,id,12),LoadBoolean(HH,id,31))
set PlusSwords=PlusSwords-1
exitwhen PlusSwords==0
endloop
endif
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
set caster=null
set casterOriginal=null
endfunction



function SabracWAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit casterOriginal=LoadUnitHandle(HH,id,30)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real time1=LoadReal(HH,id,6)
local real mp=GetUnitState(caster,UNIT_STATE_MANA)
local real mm=GetUnitState(caster,UNIT_STATE_MAX_MANA)
local integer SabracSwords=(LoadInteger(HH,GetHandleId( (GetOwningPlayer( casterOriginal )) ),SabracSwordsHash))
local unit SabrackFU=LoadUnitHandle(HH,GetHandleId(casterOriginal),SH_SabracZoneU)
local integer lvl=LoadInteger(HH,id,15)
local real damage=(0.025+0.025*lvl)*GetHeroStr(casterOriginal,true)*SabracSwords
set time=time+0.02
call SaveReal(HH,id,5,time)
set time1=time1+0.02
if time1==1 then
call SetUnitState(caster,UNIT_STATE_MANA,mp-mm*(0.03-0.004*lvl))
if SabracSwords>0 then
call SetUnitAnimationByIndex(LoadUnitHandle(HH,id,21),0)
call DamageAoeOneTime0(caster,GetUnitX(caster),GetUnitY(caster),250,damage)
endif
set time1=0
endif
call SaveReal(HH,id,6,time1)
if time==0.02 then
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
if SR(GetUnitX(caster),GetUnitY(caster),GetUnitX(SabrackFU),GetUnitY(SabrackFU))<1500 and SabrackFU!=null then

call SetUnitAcquireRange(caster, 800+B2I(UnitHasBow(caster))*(800*0.3+50))
call SetUnitAttackRangeByIndex(caster, 0, 800+B2I(UnitHasBow(caster))*(800*0.3+50))

else

call SetUnitAcquireRange(caster, 600+B2I(UnitHasBow(caster))*(600*0.3+50))
call SetUnitAttackRangeByIndex(caster, 0, 600+B2I(UnitHasBow(caster))*(600*0.3+50))

endif
endif
if time>0 then
call MoveUnit(caster,LoadUnitHandle(HH,id,20),0,facing)
call SetUnitFlyHeight(LoadUnitHandle(HH,id,20),GetUnitFlyHeight(caster),0)
call MoveUnit(caster,LoadUnitHandle(HH,id,21),0,facing)
call SetUnitFlyHeight(LoadUnitHandle(HH,id,21),GetUnitFlyHeight(caster),0)


if CheckUnitInvisible(caster)==true then
   
    if GetUnitAbilityLevel( LoadUnitHandle(HH,id,20) ,'A0A1')==0 then
      call UnitAddAbility( LoadUnitHandle(HH,id,20) ,'A0A1')
    endif

    if GetUnitAbilityLevel( LoadUnitHandle(HH,id,21) ,'A0A1')==0 then
      call UnitAddAbility( LoadUnitHandle(HH,id,21) ,'A0A1')
    endif  

else

   if GetUnitAbilityLevel( LoadUnitHandle(HH,id,20) ,'A0A1')==1 then
     call UnitRemoveAbility( LoadUnitHandle(HH,id,20) ,'A0A1')
   endif

   if GetUnitAbilityLevel( LoadUnitHandle(HH,id,21) ,'A0A1')==1 then
     call UnitRemoveAbility( LoadUnitHandle(HH,id,21) ,'A0A1')
   endif

endif







if SR(GetUnitX(caster),GetUnitY(caster),GetUnitX(SabrackFU),GetUnitY(SabrackFU))<1500 and SabrackFU!=null then
call SetUnitPathing(caster,false)
endif
if SR(GetUnitX(caster),GetUnitY(caster),GetUnitX(SabrackFU),GetUnitY(SabrackFU))>=1500 and SabrackFU!=null then
call SetUnitPathing(caster,true)
endif
endif
call SetPlayerAbilityAvailable(GetOwningPlayer(casterOriginal),'SaW1',false)
if mp<mm*0.1 or LoadBoolean(HH,GetHandleId(caster),SH_SabracW)==true or udg_B==false or DU2==false or caster==null or UnitIsAlive(caster)==false then
call SaveBoolean(HH,GetHandleId(caster),SH_SabracW,false)
//if(GetLocalPlayer()==GetOwningPlayer(casterOriginal))then
//call DisplayTextToPlayer(GetLocalPlayer(),0,0,"W1off")
//endif
call SetUnitAbilityLevel(caster,'SaC1',1)
call UnitRemoveAbility(caster,'SaW2')
call UnitRemoveAbility(caster,'SaWB')
call UnitRemoveAbility(caster,'BSaW')
call SetPlayerAbilityAvailable(GetOwningPlayer(casterOriginal),'SaW1',true)

call SetUnitAcquireRange(caster, 150+B2I(UnitHasBow(caster))*(150*0.3+50))
call SetUnitAttackRangeByIndex(caster, 0, 150+B2I(UnitHasBow(caster))*(150*0.3+50))

call SetUnitPathing(caster,true)
call RemoveUnit(LoadUnitHandle(HH,id,20))
call RemoveUnit(LoadUnitHandle(HH,id,21))
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif

set casterOriginal=null
set caster=null
set SabrackFU=null
endfunction










function SabracW2Act takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit casterOriginal=LoadUnitHandle(HH,id,30)
local unit target=LoadUnitHandle(HH,id,2)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local unit SabrackFU=LoadUnitHandle(HH,GetHandleId(casterOriginal),SH_SabracZoneU)
local real damage=LoadReal(HH,id,15)
set time=time+0.02

if time==0.2 or time==0.4 or time==0.8 or time==20.1 or time==20.3 or time==20.5 or time==20.7 then
call EffectCreateAndMove90(true,"Sabrac\\wind3.mdl",facing,1,0.75,1,100,100,100,0,100,caster,0,facing)
endif

if time==0.1 or time==0.3 or time==0.5 or time==0.7 or time==0.9 or time==20.2 or time==20.4 or time==20.6 or time==20.8 then
call EffectCreateAndMove(true,"Sabrac\\sand.mdl",facing,1,1,1,100,100,100,0,0,caster,0,facing)
endif

call SaveReal(HH,id,5,time)
call MoveUnit(caster,LoadUnitHandle(HH,id,20),100,facing)
call MoveUnit(caster,LoadUnitHandle(HH,id,22),100,facing)
if time>0 then
if time>20 then
call SetUnitPathing(target,false)
call PauseUnit(target,true)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
call SetUnitInvulnerable(target,true)
call SetUnitInvulnerable(caster,true)
else
call MoveUnit(caster,caster,31.12,facing)
endif
call SetUnitPathing(caster,false)
call PauseUnit(caster,true)
endif
if time==0.9 then


call StartAbilityCooldown(GetUnitAbility(caster, 'SaW1'), 15)

call SaveBoolean(HH,GetHandleId(caster),DASH_USER,false)
call StopSound(LoadSoundHandle(HH,id,24),false,false) // звук из массива — останавливаем, не удаляем
//call KillSoundWhenDone(LoadSoundHandle(HH,id,24)) // звук из массива — не удалять
call SetUnitPathing(caster,true)
call UnitSpeed(caster,1)
call PauseUnit(caster,false)
call RemoveUnit(LoadUnitHandle(HH,id,20))
call RemoveUnit(LoadUnitHandle(HH,id,21))
call RemoveUnit(LoadUnitHandle(HH,id,22))
call SetUnitInvulnerable(caster,false)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
if time<0.9 then
call GroupClear(G)
call GroupEnumUnitsInRange(G,GetUnitX(caster),GetUnitY(caster),150,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if UnitIsAlive(n0)and IsUnitEnemy(n0,GetOwningPlayer(caster))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(n0,'Avul')==0 then
if LoadBoolean(HH,GetHandleId(n0),ANTITARGET_ABILITY)==false then
call SaveReal(HH,id,5,20+time)
call SaveUnitHandle(HH,id,2,n0)
call UnitSpeed(caster,0.75+time*0.5)
call SetUnitAnimationByIndex(caster,8)
set time=20+time
else
call StopSound(LoadSoundHandle(HH,id,24),false,false) // звук из массива — останавливаем, не удаляем
//call KillSoundWhenDone(LoadSoundHandle(HH,id,24)) // звук из массива — не удалять
call SetUnitPathing(caster,true)
call UnitSpeed(caster,1)
call PauseUnit(caster,false)
call RemoveUnit(LoadUnitHandle(HH,id,20))
call RemoveUnit(LoadUnitHandle(HH,id,21))
call RemoveUnit(LoadUnitHandle(HH,id,22))
call SetUnitInvulnerable(caster,false)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
call SaveBoolean(HH,GetHandleId(caster),DASH_USER,false)
call SaveUnitHandle(HH,GetHandleId(n0),REVERSE_TARGET,caster)
endif
call GroupClear(G)
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
endif
if time>20 and time<21 then
call MoveUnit(caster,caster,20,facing)
call MoveUnit(caster,target,120,facing)
endif
if time>=21 then
call EffectCreateAndMove45(true,"Sabrac\\LXY_tx-shqy10-E.mdl",facing+15,1,1.1,1,100,100,100,0,150,target,50,facing+15)
call EffectCreateAndMove45(true,"Sabrac\\LXY_tx-shqy10-E.mdl",facing-15,1,1.1,1,100,100,100,0,150,target,50,facing-15)
call EffectCreateAndMove(true,"Sabrac\\Az_hit-red.mdl",facing+210,1,1.5,0.7,100,100,100,0,150,target,50,facing+15)
call EffectCreateAndMove(true,"Sabrac\\Az_hit-red.mdl",facing+150,1,1.5,0.7,100,100,100,0,150,target,50,facing-15)
call EffectCreateAndMove(true,"Sabrac\\CF2.mdl",facing,1,0.5,0.8,100,100,100,0,50,target,0,facing)
call EffectCreateAndMove(true,"Sabrac\\File00003933.mdl",facing,1,1.75,1,100,100,100,0,50,target,0,facing)
call RemoveUnit(LoadUnitHandle(HH,id,20))
call RemoveUnit(LoadUnitHandle(HH,id,21))
call RemoveUnit(LoadUnitHandle(HH,id,22))
call UnitStop(target)



call StartAbilityCooldown(GetUnitAbility(caster, 'SaW1'), 15)

//call KillSoundWhenDone(LoadSoundHandle(HH,id,24)) // звук из массива — не удалять
call SetUnitPathing(caster,true)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
call UnitSpeed(caster,1)
call SetUnitPathing(target,true)
call PauseUnit(target,false)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
call SetUnitInvulnerable(target,false)
if GetUnitAbilityLevel(casterOriginal,'SaE1')>0 or GetUnitAbilityLevel(casterOriginal,'SaE2')>0 then
call SabracEPassiveAct(caster,target)
endif
if SabrackFU!=null and SR(GetUnitX(caster),GetUnitY(caster),GetUnitX(SabrackFU),GetUnitY(SabrackFU))<1500 then
set damage=GetHeroStr(casterOriginal,true)*3+5*( GetUnitBaseDamageByIndex( casterOriginal ,0)+GetUnitBonusDamageByIndex( casterOriginal ,0) )





call myCustomDamage(casterOriginal,target,damage,false,false,null,null,null)
call SetControlToUnit(caster, target, 2, "stun")

else


call myCustomDamage(casterOriginal,target,damage,false,false,null,null,null)

endif



call SaveBoolean(HH,GetHandleId(caster),DASH_USER,false)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
set caster=null
set casterOriginal=null
set target=null
set SabrackFU=null
endfunction



function SabracEAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit Dummy=LoadUnitHandle(HH,id,20)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
set time=time+0.02
call SaveReal(HH,id,5,time)
if time==0.02 then
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
call SetUnitModel(n0,"Sabrac\\t_shio_op_noelle_W-1.mdl")
call UnitSize(n0,1.5,1,1)
call UnitColor(n0,100,30,30,0)
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call SetUnitFlyHeight(n0,0,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=null
call EffectCreateAndMove(true,"Sabrac\\red-yumao-zhendiLord.mdl",facing,1,1,1,100,100,100,40,0,caster,0,facing)
call EffectCreateAndMove(true,"Sabrac\\wind4.mdl",facing,1,1,0.6,100,40,40,40,0,caster,0,facing)
call EffectCreateAndMove(true,"Sabrac\\HakkeStart2.mdl",facing,1,0.5,1,100,100,100,60,0,caster,0,facing)
endif
call MoveUnit(caster,Dummy,0,facing)
call SetUnitFlyHeight(Dummy,GetUnitFlyHeight(caster),0)


if CheckUnitInvisible(caster)==true then
   
    if GetUnitAbilityLevel( LoadUnitHandle(HH,id,20) ,'A0A1')==0 then
      call UnitAddAbility( LoadUnitHandle(HH,id,20) ,'A0A1')
    endif

else

   if GetUnitAbilityLevel( LoadUnitHandle(HH,id,20) ,'A0A1')==1 then
     call UnitRemoveAbility( LoadUnitHandle(HH,id,20) ,'A0A1')
   endif

endif




if GetUnitAbilityLevel(caster,'BSaE')==0 or (time>0.02 and  udg_B==false) or UnitIsAlive(caster)==false  then
call RemoveUnit(Dummy)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
set caster=null
set Dummy=null
endfunction
function SabracEWAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
