function QRulerCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local player p
local real x
local real y
if UnitIsAlive(u)then
set x=GetUnitX(u)
set y=GetUnitY(u)
