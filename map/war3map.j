function OnButtonSelectType takes nothing returns nothing
    local player p = GetTriggerPlayer( )
    local integer pHid = GetHandleId( p )
    local integer buttonId = LoadInteger( HH, pHid, '+bId' )
    local framehandle but = GetTriggerFrame()
    local integer i=0

    if buttonId == -1 then
        return
    endif
    if p==GetLocalPlayer() then  
        if GetFrameTexture(TavernChangeStats,1)=="TitleTavernIcon.blp" then
            call SetFrameTexture( TavernHeroFrame, "TavernBackGround.tga", 0, true )
            call SetFrameTexture( TavernHeroFrame, "TavernBackGround.tga", 1, true )
            call SetFrameTexture( TavernHeroFrame, "TavernBackGround.tga", 2, true )
            call SetFrameTexture(TavernChangeStats,"StatsTavernIcon.blp",0,true)
            call SetFrameTexture(TavernChangeStats,"StatsTavernIcon.blp",1,true)
            call SetFrameTexture(TavernChangeStats,"StatsTavernIcon.blp",2,true)
            call ShowFrame( TavernHeroFrameStats, false )
            call ShowFrame( TavernHeroFrameTitles, true )
        elseif GetFrameTexture(TavernChangeStats,1)=="StatsTavernIcon.blp" then
            call SetFrameTexture( TavernHeroFrame, "StatsBackGround.tga", 0, true )
            call SetFrameTexture( TavernHeroFrame, "StatsBackGround.tga", 1, true )
            call SetFrameTexture( TavernHeroFrame, "StatsBackGround.tga", 2, true )
            call SetFrameTexture(TavernChangeStats,"TitleTavernIcon.blp",0,true)
            call SetFrameTexture(TavernChangeStats,"TitleTavernIcon.blp",1,true)
            call SetFrameTexture(TavernChangeStats,"TitleTavernIcon.blp",2,true)
            call ShowFrame( TavernHeroFrameTitles, false )
            call ShowFrame( TavernHeroFrameStats, true )
        else
            call BJDebugMsg(GetFrameTexture(TavernChangeStats,1))
            call BJDebugMsg("TitleTavernIcon.blp")
            call BJDebugMsg(B2S(GetFrameTexture(TavernChangeStats,1)=="TitleTavernIcon.blp"))
        endif
    endif
    set P=p
    //call ConsolePrint(GetFrameTexture(TavernHeroFrame,0)+", ")
    loop
    exitwhen i>=12
        if GetPlayerId(p)==i then
            call HandleListForEach(TavernHeroFrameList[i],function HideId)
        endif
        set i=i+1
    endloop
    set p = null
    set but = null
endfunction

function OnButtonSelectPlayer takes nothing returns nothing
    local player p = GetTriggerPlayer( )
    local integer pHid = GetHandleId( p )
    local integer buttonId = LoadInteger( HH, pHid, '+bId' )
    local framehandle but = GetTriggerFrame()
    local framehandle selector = GetCFrameByName( "PlayerPickSelector", 0 )

    if buttonId == -1 then
        return
    endif
    set TestModePlayerId[GetPlayerId(p)]=GetFrameContext(but)
    if p==GetLocalPlayer() then
        call ClearFrameAllPoints( selector )
        call SetFrameRelativePoint( selector, FRAMEPOINT_BOTTOMLEFT, but, FRAMEPOINT_BOTTOMLEFT, -.001, -.001 )        
        call ShowFrame( selector, true )
    endif
    set p = null
    set but = null
    set selector = null
endfunction

function OnButtonSelectTeam takes nothing returns nothing
    local player p = GetTriggerPlayer( )
    local integer pHid = GetHandleId( p )
    local integer buttonId = LoadInteger( HH, pHid, '+bId' )
    local framehandle but = GetTriggerFrame()

    if buttonId == -1 then
        return
    endif
    if GetTriggerFrame()==SpectacleCaptainSelect0 then
        set cmp=1
        set Globalteam=0
    else
        set cmp=2
        set Globalteam=5         
    endif
    set cmb=true
    call ShowFrame(SpectacleCaptainSelect0,false)
    call ShowFrame(SpectacleCaptainSelect1,false)
    call ShowFrame( GetOriginFrame( ORIGIN_FRAME_MULTIBOARD, 0 ), false )
    call DestroyTimerDialog(udg_Captain)
    call TimerStart(udg_Timer4,  20,false,null) //Start 
    set udg_Captain=CreateTimerDialog(udg_Timer4)
    call TimerDialogSetTitle(udg_Captain,"Осталось времени на подготовку:")
    call TimerDialogDisplay(udg_Captain,true)
    if cmp==1 then
        call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,"Подготовка, начинает первая команда.")
        // call AddFrameText(TavernChat,"Очередь первой команды.")
    elseif cmp==2 then
        call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,"Подготовка, начинает вторая команда.")
        // call AddFrameText(TavernChat,"Очередь второй команды.")
    endif
    set p = null
    set but = null
endfunction

function OnButtonAddonAbility takes nothing returns nothing
    local player p = GetTriggerPlayer( )
    local integer pHid = GetHandleId( p )
    local integer buttonId = LoadInteger( HH, pHid, '+bId' )
    local framehandle but = GetTriggerFrame()
    local string abilList 
    local string abilList2 
    local string s = ""
    local integer i=0
    local integer j=0
    local integer len = 0

    if buttonId == -1 then
        return
    endif
    if p==GetLocalPlayer() then
        loop
        exitwhen i>=35
        
            if GetFrameTexture(but,0)==GetAbilityBaseStringFieldById('A1HO',ABILITY_SF_ICON_NORMAL) and IsFrameVisible(GetFrameByName("TavernBarAdditionalAbilityList",0))==false and i==GetFrameContext(but) then
                call ShowFrame( InfoTavernText, false )
                call ShowFrame( GetFrameByName("TavernBarAdditionalAbilityList",0), true )
                set j=0
                loop
                call ShowFrame( GetFrameByName("TavernAdditionalAbilityTooltip",j), false )
                call ShowFrame( GetFrameByName("TavernAdditionalAbilityBorderOpenable",j), false )
                if j>=3 then
                call ShowFrame(GetFrameByName("TavernAdditionalAbility",j),false)
                endif
                set j=j+1
                exitwhen j>35
                endloop
                call SetFrameText( GetFrameByName("TavernAdditionalAbilityTooltipText",0), "     " )
                call SetFrameText( GetFrameByName("TavernAdditionalAbilityTooltipText",1), "     " )
                call SetFrameText( GetFrameByName("TavernAdditionalAbilityTooltipText",2), "     " )
                set j=0
                loop
                    call AddFrameText( GetFrameByName("TavernAdditionalAbilityTooltipText",0), "|cffffcc00"+I2S(GetAbilityBaseIntegerLevelFieldById( String2Id( "A1HQ" ), ABILITY_ILF_MANA_COST, j ))+"|r")
                    exitwhen j==GetAbilityBaseIntegerFieldById(String2Id( "A1HQ" ), ABILITY_IF_LEVELS)-1
                    call AddFrameText( GetFrameByName("TavernAdditionalAbilityTooltipText",0), "/")
                    set j=j+1
                endloop
                set j=0
                loop
                    call AddFrameText( GetFrameByName("TavernAdditionalAbilityTooltipText",1), "|cffffcc00"+I2S(GetAbilityBaseIntegerLevelFieldById( String2Id( "A1HR" ), ABILITY_ILF_MANA_COST, j ))+"|r")
                    exitwhen j==GetAbilityBaseIntegerFieldById(String2Id( "A1HR" ), ABILITY_IF_LEVELS)-1
                    call AddFrameText( GetFrameByName("TavernAdditionalAbilityTooltipText",1), "/")
                    set j=j+1
                endloop
                set j=0
                loop
                    call AddFrameText( GetFrameByName("TavernAdditionalAbilityTooltipText",2), "|cffffcc00"+I2S(GetAbilityBaseIntegerLevelFieldById( String2Id( "A1HS" ), ABILITY_ILF_MANA_COST, j ))+"|r")
                    exitwhen j==GetAbilityBaseIntegerFieldById(String2Id( "A1HS" ), ABILITY_IF_LEVELS)-1
                    call AddFrameText( GetFrameByName("TavernAdditionalAbilityTooltipText",2), "/")
                    set j=j+1
                endloop
                call SetFrameTexture( GetFrameByName("TavernAdditionalAbility",0), GetAbilityBaseStringFieldById( String2Id( "A1HQ" ), ABILITY_SF_ICON_NORMAL ), 0, true )
                call SetFrameTexture( GetFrameByName("TavernAdditionalAbility",0), GetAbilityBaseStringFieldById( String2Id( "A1HQ" ), ABILITY_SF_ICON_NORMAL ), 1, true )
                call SetFrameTexture( GetFrameByName("TavernAdditionalAbility",0), GetAbilityBaseStringFieldById( String2Id( "A1HQ" ), ABILITY_SF_ICON_NORMAL ), 2, true )
                call SetFrameTexture( GetFrameByName("TavernAdditionalAbility",1), GetAbilityBaseStringFieldById( String2Id( "A1HR" ), ABILITY_SF_ICON_NORMAL ), 0, true )
                call SetFrameTexture( GetFrameByName("TavernAdditionalAbility",1), GetAbilityBaseStringFieldById( String2Id( "A1HR" ), ABILITY_SF_ICON_NORMAL ), 1, true )
                call SetFrameTexture( GetFrameByName("TavernAdditionalAbility",1), GetAbilityBaseStringFieldById( String2Id( "A1HR" ), ABILITY_SF_ICON_NORMAL ), 2, true )
                call SetFrameTexture( GetFrameByName("TavernAdditionalAbility",2), GetAbilityBaseStringFieldById( String2Id( "A1HS" ), ABILITY_SF_ICON_NORMAL ), 0, true )
                call SetFrameTexture( GetFrameByName("TavernAdditionalAbility",2), GetAbilityBaseStringFieldById( String2Id( "A1HS" ), ABILITY_SF_ICON_NORMAL ), 1, true )
                call SetFrameTexture( GetFrameByName("TavernAdditionalAbility",2), GetAbilityBaseStringFieldById( String2Id( "A1HS" ), ABILITY_SF_ICON_NORMAL ), 2, true )
