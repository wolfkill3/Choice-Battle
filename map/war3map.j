local integer idu=GetPlayerId(p)
local real x=LoadReal(h,id,3)
local real y=LoadReal(h,id,4)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,8)
local real dmg=(GetHeroAgi(u,true)+GetHeroStr(u,true)+GetHeroInt(u,true))*2
local real Range=LoadReal(h,id,9)
local real speed=LoadReal(h,id,11)
local integer i=0
if Range<2000 and UnitIsAlive(l__d)then
set x1=x1+speed*Cos(a)
set y1=y1+speed*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
call SaveReal(h,id,3,x1)
call SaveReal(h,id,4,y1)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SaveReal(h,id,9,Range+40)
call SaveReal(h,id,11,speed+1)
call GroupEnumUnitsInRange(G,x1,y1,175,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call KillUnit(l__d)
endif
call GroupRemoveUnit(G,E)
endloop
else
call UnitApplyTimedLife(CreateUnit(p,'e00N',x,y,GetRandomReal(0,359)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e067',x,y,GetRandomReal(0,359)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e06O',x,y,GetRandomReal(0,359)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0B9',x,y,GetRandomReal(0,359)),1,3)
call UnitApplyTimedLife(CreateUnit(p,0x6530494B,x,y,GetRandomReal(0,359)),1,3)
call UnitApplyTimedLife(CreateUnit(p,0x6530494C,x,y,GetRandomReal(0,359)),1,3)
call UnitApplyTimedLife(CreateUnit(p,0x6530494A,x,y,GetRandomReal(0,359)),1,3)
call UnitApplyTimedLife(CreateUnit(p,0x6530494D,x,y,GetRandomReal(0,359)),1,1.5)
call UnitApplyTimedLife(CreateUnit(p,0x6530494E,x,y,GetRandomReal(0,359)),1,3)
call GroupEnumUnitsInRange(G,x,y,500,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 0.2, "stun")
endif
call GroupRemoveUnit(G,E)
endloop
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
endif
set u=null
set p=null
set t=null
set l__d=null
endfunction
