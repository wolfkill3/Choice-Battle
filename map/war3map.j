function AizenFAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit casterOriginal=LoadUnitHandle(HH,id,30)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real distance=LoadReal(HH,id,8)
local real x1=LoadReal(HH,id,11)
local real y1=LoadReal(HH,id,12)
local real damage=LoadReal(HH,id,15)
set time=time+0.02
call SaveReal(HH,id,5,time)
if time==0.5 then
call UnitSpeed(caster,1)
call RemoveUnit(LoadUnitHandle(HH,id,20))
call RemoveUnit(LoadUnitHandle(HH,id,21))
call RemoveUnit(LoadUnitHandle(HH,id,22))
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else
if time==0.02 then
if SR(GetUnitX(caster),GetUnitY(caster),x1,y1)>100 then
call EffectCreateAndMove(true,"Aizen\\File0000 (644).mdl",facing,1.5,1,0.85,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove90(true,"Others\\wind4.mdl",facing+180,1,0.75,1.5,100,100,100,0,50,caster,0,facing)
endif
if SR(GetUnitX(caster),GetUnitY(caster),x1,y1)>300 then
call EffectCreateAndMove(true,"Aizen\\File0000 (644).mdl",facing,1.5,1,0.85,100,100,100,0,0,caster,200,facing)
call EffectCreateAndMove90(true,"Others\\wind4.mdl",facing+180,1,0.75,1.5,100,100,100,0,50,caster,200,facing)
endif
if SR(GetUnitX(caster),GetUnitY(caster),x1,y1)>500 then
call EffectCreateAndMove(true,"Aizen\\File0000 (644).mdl",facing,1.5,1,0.85,100,100,100,0,0,caster,400,facing)
call EffectCreateAndMove90(true,"Others\\wind4.mdl",facing+180,1,0.75,1.5,100,100,100,0,50,caster,400,facing)
endif
if SR(GetUnitX(caster),GetUnitY(caster),x1,y1)>700 then
call EffectCreateAndMove(true,"Aizen\\File0000 (644).mdl",facing,1.5,1,0.85,100,100,100,0,0,caster,600,facing)
call EffectCreateAndMove90(true,"Others\\wind4.mdl",facing+180,1,0.75,1.5,100,100,100,0,50,caster,600,facing)
endif
call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",facing,1.5,1,1.25,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"Others\\BlackBlink1.mdl",facing,1,1,1,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"Others\\HakkeStart2.mdl",facing,1.5,0.5,0.5,100,100,100,60,0,caster,0,facing)
call MoveAoe1(x1,y1,caster,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",facing,1.5,1,1.25,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"Others\\HakkeStart2.mdl",facing,1.5,0.5,0.5,100,100,100,60,0,caster,0,facing)
call UnitSpeed(caster,2)
call SetUnitAnimationByIndex(caster,14)
endif
if time==0.06 then
call MoveAoe1(x1,y1,LoadUnitHandle(HH,id,20),0,facing)
call MoveAoe1(x1,y1,LoadUnitHandle(HH,id,21),0,facing)
call MoveAoe1(x1,y1,LoadUnitHandle(HH,id,22),0,facing)
call UnitSpeed(caster,1)
endif
endif
set caster=null
set casterOriginal=null
endfunction

function AizenFTargetAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit casterOriginal=LoadUnitHandle(HH,id,30)
local real facing=Angle2(GetUnitX(caster),GetUnitY(caster),GetUnitX(LoadUnitHandle(HH,id,2)),GetUnitY(LoadUnitHandle(HH,id,2)))
local real time=LoadReal(HH,id,5)
local real time1=LoadReal(HH,id,6)
local real distance=LoadReal(HH,id,8)
local real x1=LoadReal(HH,id,11)
local real y1=LoadReal(HH,id,12)
local real damage=LoadReal(HH,id,15)
local real dist=SR(GetUnitX(caster),GetUnitY(caster),GetUnitX(LoadUnitHandle(HH,id,2)),GetUnitY(LoadUnitHandle(HH,id,2)))
call SetUnitPathing(caster,false)
set time=time+0.02
call SaveReal(HH,id,5,time)
call UnitStop(LoadUnitHandle(HH,id,2))
if time==5.5 then
//if caster!=casterOriginal then

//call StartAbilityCooldown(GetUnitAbility(casterOriginal, 'ASF1'), 20)

//endif

call StartAbilityCooldown(GetUnitAbility(caster, 'ASF1'), 20)

call EffectCreateAndMove(true,"BlackGoku\\CF2.mdl",facing,1,0.45,0.7,100,100,100,0,100,caster,50,facing)
call PauseUnit(caster,false)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\AizenFslash.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call SetUnitPathing(caster,true)
call EffectCreateAndMove(true,"Aizen\\hero_skeletonking_n2s_e_star.mdl",facing,1.5,1.5,0.5,100,100,100,0,100,LoadUnitHandle(HH,id,2),0,facing)
call EffectCreateAndMove(true,"Sabrac\\bloodex1.mdl",facing,1.25,2,1.5,100,100,100,0,100,LoadUnitHandle(HH,id,2),0,facing)



call myCustomDamage(caster,LoadUnitHandle(HH,id,2),damage,false,false,null,null,null)


call UnitSpeed(caster,1)
call DestroyEffect(LoadEffectHandle(HH,id,21))
call DestroyEffect(LoadEffectHandle(HH,id,22))
call DestroyEffect(LoadEffectHandle(HH,id,23))
call DestroyEffect(LoadEffectHandle(HH,id,24))
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else
if dist>85 and time<5 then
call SaveReal(HH,id,3,Angle2(GetUnitX(caster),GetUnitY(caster),GetUnitX(LoadUnitHandle(HH,id,2)),GetUnitY(LoadUnitHandle(HH,id,2))))
call MoveUnit(caster,caster,80,facing)
set time1=time+0.02
if time1==0.1 or time==0.02 then
set time1=0
call EffectCreateAndMove(true,"Aizen\\File0000 (644).mdl",facing,1,1,0.85,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove90(true,"BlackGoku\\wind3.mdl",facing+180,1,0.75,1.5,100,100,100,0,100,caster,0,facing)
endif
call SaveReal(HH,id,6,time1)
endif
call PauseUnit(caster,true)
if dist<=85 and time<5 then
if LoadBoolean(HH,GetHandleId(LoadUnitHandle(HH,id,2)),ANTITARGET_ABILITY)==false then
set time=5
call SaveReal(HH,id,5,time)
call SaveReal(HH,id,3,facing)
call EffectCreateAndMove(true,"BlackGoku\\CF2.mdl",facing,1,0.45,0.7,100,100,100,0,100,caster,50,facing)
call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",facing,1.5,1,1.25,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"Others\\HakkeStart2.mdl",facing,1.5,0.5,0.5,100,100,100,60,0,caster,0,facing)
call EffectCreateAndMove(true,"Aizen\\File0000 (644).mdl",facing,1,1,0.85,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove90(true,"BlackGoku\\wind3.mdl",facing+180,1,0.75,1.5,100,100,100,0,100,caster,0,facing)
call EffectCreateAndMove(true,"Aizen\\hero_skeletonking_n2s_e_star.mdl",facing,1.5,1.5,0.5,100,100,100,0,100,LoadUnitHandle(HH,id,2),0,facing)
call EffectCreateAndMove(true,"Sabrac\\bloodex1.mdl",facing,1.25,2,1.5,100,100,100,0,100,LoadUnitHandle(HH,id,2),0,facing)

call myCustomDamage(caster,LoadUnitHandle(HH,id,2),damage,false,false,null,null,null)

set soundplay=CreateSound("Sound\\Music\\mp3Music\\AizenFslash.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
else
call SetUnitPathing(caster,true)
call UnitSpeed(caster,1)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
call PauseTimer(GetExpiredTimer())
call DestroyEffect(LoadEffectHandle(HH,id,21))
call DestroyEffect(LoadEffectHandle(HH,id,22))
call DestroyEffect(LoadEffectHandle(HH,id,23))
call DestroyEffect(LoadEffectHandle(HH,id,24))
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
call SaveBoolean(HH,GetHandleId(caster),DASH_USER,false)
call SaveUnitHandle(HH,GetHandleId(LoadUnitHandle(HH,id,2)),REVERSE_TARGET,caster)
endif
endif
if time==0.02 then
call SaveEffectHandle(HH,id,21,AddSpecialEffectTarget("Aizen\\AZ_LCDark_W2_buff.mdl",caster,"hand left"))
call SaveEffectHandle(HH,id,22,AddSpecialEffectTarget("Aizen\\AZ_LCDark_W2_buff.mdl",caster,"hand righ"))
call SaveEffectHandle(HH,id,23,AddSpecialEffectTarget("Aizen\\file00002360.mdl",caster,"hand Right"))
call SaveEffectHandle(HH,id,24,AddSpecialEffectTarget("Aizen\\file00002360.mdl",caster,"hand left"))
call UnitSpeed(caster,2)
call SetUnitAnimationByIndex(caster,14)
call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",facing,1.5,1,1.25,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"Others\\HakkeStart2.mdl",facing,1.5,0.5,0.5,100,100,100,60,0,caster,0,facing)
endif
if time>5 and time<5.2 then
call MoveUnit(caster,caster,60,LoadReal(HH,id,3))
endif
if time==5.2 then
set facing=facing
call SaveReal(HH,id,3,facing)
call UnitSpeed(caster,1)
call SetUnitAnimationByIndex(caster,5)
call SetUnitFacingInstant(caster,facing)
endif
if time==5.08 or time==5.16 or time==5.3 or time==5.36 then
call EffectCreateAndMove(true,"Aizen\\File0000 (644).mdl",facing,1,1,0.85,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove90(true,"BlackGoku\\wind3.mdl",facing+180,1,0.75,1.5,100,100,100,0,100,caster,0,facing)
endif
if time>5.3 and time<5.5 then
call MoveUnit(caster,caster,35,facing)
endif
endif
set caster=null
set casterOriginal=null
endfunction

function AizenFBlockAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit casterOriginal=LoadUnitHandle(HH,id,30)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real distance=LoadReal(HH,id,8)
local real x1=LoadReal(HH,id,11)
local real y1=LoadReal(HH,id,12)
local real damage=LoadReal(HH,id,15)
if IsUnitPaused(caster)==false or time>5 then
set time=time+0.02
call SaveReal(HH,id,5,time)
endif
if time==5 then
//if caster!=casterOriginal then



//call StartAbilityCooldown(GetUnitAbility(casterOriginal, 'ASF1'), 25)






//endif

call StartAbilityCooldown(GetUnitAbility(caster, 'ASF1'), 25)
call SaveBoolean(HH,GetHandleId(caster),ANTITARGET_ABILITY,false)
call SaveBoolean(HH,GetHandleId(caster),StringHash("AizenFB"),false)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
if time<5 and (LoadBoolean(HH,GetHandleId(caster),StringHash("AizenFB"))==true or LoadUnitHandle(HH,GetHandleId(caster),REVERSE_TARGET)!=null) then
call SaveBoolean(HH,GetHandleId(caster),StringHash("AizenFB"),false)
call SaveBoolean(HH,GetHandleId(caster),ANTITARGET_ABILITY,false)
call SaveReal(HH,id,5,10)
if LoadUnitHandle(HH,GetHandleId(caster),REVERSE_TARGET)!=null then
call SaveReal(HH,GetHandleId( caster ),StringHash("AizenFR"),Angle2(GetUnitX( caster ),GetUnitY( caster ),GetUnitX( LoadUnitHandle(HH,GetHandleId(caster),REVERSE_TARGET) ),GetUnitY( LoadUnitHandle(HH,GetHandleId(caster),REVERSE_TARGET) )))
call RemoveSavedHandle(HH,GetHandleId(caster),REVERSE_TARGET)
endif
endif
if time==10.02 then
//if caster!=casterOriginal then


//call StartAbilityCooldown(GetUnitAbility(casterOriginal, 'ASF1'), 25)



//endif
call StartAbilityCooldown(GetUnitAbility(caster, 'ASF1'), 25)
call PauseUnit(caster,false)
call UnitRemoveAbility(caster,'BASF')
set facing=LoadReal(HH,GetHandleId(caster),StringHash("AizenFR"))
