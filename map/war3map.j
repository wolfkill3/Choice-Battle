function OrochimaruF3Cast takes nothing returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local unit u=GetDyingUnit()
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local player p=GetOwningPlayer(u)
    local real f=GetUnitFacing(u)
    if GetHeroLevel(u)>5 then
        set n=CreateUnit(p,'or01',x,y,f)
        call SetUnitAbilityLevel(n,'OM16',GetHeroLevel(u)/5)
        call SetUnitScaleTimed(n,0.01,2,1)
        call SetUnitBaseDamageByIndex(n,0,100+GetHeroInt(u,true))
        call SetUnitMoveSpeed(n,300+GetHeroLevel(u)*15)
        call SetUnitMaxLife(n,3400+GetHeroLevel(u)*80)
        call SaveUnitHandle(h,id,0,n)
        call SetUnitInvulnerable(n,true)
        call UnitApplyTimedLife(n,1,30)
        if p==GetLocalPlayer()then
        call ClearSelection()
        call SelectUnit(n,true)
        endif
        call TimerStart(t,1.0,false,function OrochimaruF3Cast12)
        call SetUnitTimeScale(n,1.5)
    endif
    set t=null
    set u=null
    set p=null
endfunction
function InitTrig_OrochimaruF3 takes nothing returns nothing
    set gg_trg_OrochimaruF3=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_OrochimaruF3,EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_OrochimaruF3,Condition(function OrochimaruF3Cond))
    call TriggerAddAction(gg_trg_OrochimaruF3,function OrochimaruF3Cast)
endfunction
function OrochimaruF2Cond takes nothing returns boolean
    return GetUnitAbilityLevel(GetTriggerUnit(),'ore3')>0 and GetSpellAbilityId()!='A16E' and GetSpellAbilityId()!='A1AA' and GetSpellAbilityId()!='A1AB' and GetSpellAbilityId()!='A11E' and GetSpellAbilityId()!='A11D' and GetSpellAbilityId()!='A11F' and GetSpellAbilityId()!='A0N1' and GetSpellAbilityId()!='A0N2' and GetSpellAbilityId()!='A0A2' and GetSpellAbilityId()!='A0EH' and GetSpellAbilityId()!='A0UG' and GetSpellAbilityId()!='A1I3'  and GetSpellAbilityId()!='A0X6'  and GetSpellAbilityId()!='A0B3'
endfunction
function OrochimaruF2Cast takes nothing returns nothing
    local unit u=GetTriggerUnit()
    local real mh=GetUnitState(u,UNIT_STATE_MAX_LIFE)
    local real mm=GetUnitState(u,UNIT_STATE_MAX_MANA)
    local real m=GetUnitState(u,UNIT_STATE_MANA)
    local real l__h=GetUnitState(u,UNIT_STATE_LIFE)
    local real dmg=mh*0.025
    if GetUnitAbilityLevel(u,'OM17')<1 then
        call AddSpecialEffectToAllBones(u,"Abilities\\Spells\\Other\\BlackArrow\\BlackArrowMissile.mdl")
        if GetUnitAbilityLevel(u,'ore5')>0 then
        set dmg=dmg*1.5
        call SetUnitState(u,UNIT_STATE_MANA,m-mm*0.025)
        endif
        if dmg<l__h then
        call SetUnitState(u,UNIT_STATE_LIFE,l__h-dmg)
        else
        call SetUnitState(u,UNIT_STATE_LIFE,1)
        endif
        call SetUnitState(u,UNIT_STATE_MANA,m-mm*0.0125)
    endif
    set u=null
endfunction
function InitTrig_OrochimaruF2 takes nothing returns nothing
    set gg_trg_OrochimaruF2=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_OrochimaruF2,EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_OrochimaruF2,Condition(function OrochimaruF2Cond))
    call TriggerAddAction(gg_trg_OrochimaruF2,function OrochimaruF2Cast)
endfunction
function OrochimaruFCond takes nothing returns boolean
    return GetSpellAbilityId()=='OM13'
endfunction
function OrochimaruFCast3 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit c=LoadUnitHandle(h,id,1)
    local unit l__d=LoadUnitHandle(h,id,12)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetUnitX(c)
    local real dmg=GetHeroInt(u,true)*3
    local real y1=GetUnitY(c)
    local real a=Atan2(y1-y,x1-x)
    local player p=GetOwningPlayer(u)
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\OrbOfDeath\\AnnihilationMissile.mdl",c,"chest"))
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\OrbOfDeath\\AnnihilationMissile.mdl",c,"head"))
    call UnitAddAbility(c,'ore4')
    call UnitMakeAbilityPermanent(c,true,'ore4')
    call UnitRemoveAbilityTimed(c,'ore4',1.5)
    if GetUnitAbilityLevel(c,'ore3')==0 and IsUnitIllusion(c)==false then
    call UnitAddAbility(c,'ore3')
    call UnitMakeAbilityPermanent(c,true,'ore3')
    endif
    if GetUnitTypeId(c)=='H057' or GetUnitTypeId(c)=='H00E' then
        call UnitAddAbility(c,'OM17')
