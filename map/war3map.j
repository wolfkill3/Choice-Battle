function JSCond takes nothing returns boolean
return GetSpellAbilityId()=='A0PG' and udg_B==true
endfunction
function JSCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local integer per=LoadInteger(h,id,10)
if SR(x,y,x1,y1)>50 and GetWidgetLife(c)>0 and udg_B==true and DU2==true then
set x=x+60*Cos(a)
set y=y+60*Sin(a)
call SetUnitXY_1(u,x,y,false)
call SetUnitFacing(u,a*bj_RADTODEG)
set n=CreateUnit(p,'e0NX',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.15)
call SetUnitModel(n,GetUnitModel(u))
call SetUnitScale(n,GetUnitScale(u),GetUnitScale(u),GetUnitScale(u))
call SetUnitVertexColor(n,170,170,170,170)
call SetUnitTimeScale(n,2)
call SetUnitAnimation(n,"walk")
call SetUnitAnimation(u,"walk")
else
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e08M',x1,y1,GetRandomReal(0,359)),'BTLF',1)
set n=CreateUnit(p,'e08N',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',1.5)
call SetUnitVertexColor(n,100,100,100,140)
call SetUnitX(u,x1+700*Cos(a+(GetRandomReal(-75,75)*bj_DEGTORAD)))
call SetUnitY(u,y1+700*Sin(a+(GetRandomReal(-75,75)*bj_DEGTORAD)))
call SaveInteger(h,id,10,per+1)
call UnitRemoveAbility(u,'A0G3')
if per>7 then
call myCustomDamage(u,c,75+((4+GetUnitAbilityLevel(u,'A0PG'))*GetHeroAgi(u,true)),false,false,null,null,null)
call SetControlToUnit(u,c,2, "stun")
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitTimeScale(u,1)
call SetUnitPathing(u,true)
call PauseUnit(u,false)
call FlushChildHashtable(h,id)
call SetUnitInvulnerable(u,false)
endif
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function JSCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real a=Atan2(GetUnitY(c)-y,GetUnitX(c)-x)
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
call SaveUnitHandle(h,id,0,u)
call SetUnitPathing(u,false)
call SetUnitAnimation(u,"walk")
call UnitAddAbility(u,'A0G3')
call UnitRemoveAbility(u,'A2VJ')
call PauseUnit(u,true)
call SaveReal(h,id,9,a)
call SaveInteger(h,id,10,0)
call SetUnitInvulnerable(u,true)
call SaveUnitHandle(h,id,1,c)
set soundplay=SndN(1719) // Sound\Music\mp3Music\NelielR.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.01,true,function JSCast2)
else
call SetUnitX(u,GetUnitX(c))
call SetUnitY(u,GetUnitY(c))
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitVertexColor(u,255,255,255,255)
call FlushChildHashtable(h,id)
endif
set c=null
set p=null
set u=null
set t=null
endfunction
function JSInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function JSCast)
call TriggerAddCondition(t,Condition(function JSCond))
set t=null
endfunction
function LanzadorVerdeCond takes nothing returns boolean
return GetSpellAbilityId()=='A0PF'
endfunction
function LanzadorVerdeCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local group g=LoadGroupHandle(h,id,4)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,5)
local integer l__idg=GetHandleId(g)
local player p=GetOwningPlayer(u)
local real dmg=12*GetHeroAgi(u,true)
local unit c=LoadUnitHandle(h,id,6)
if SR(x,y,x1,y1)<=3250 and IsTerrainPathable(GetUnitX(l__d),GetUnitY(l__d),PATHING_TYPE_FLYABILITY)==false then
set x1=x1+70*Cos(a)
set y1=y1+70*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
if c==null then
    call GroupEnumUnitsInRange(g,x1,y1,180,Base)
    loop
    set E=FirstOfGroup(g)
    set ide=GetHandleId(E)
    exitwhen E==null
    if Condition_Base(p,E) then
    call myCustomDamage(u,E,dmg,false,false,null,null,null)
    call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",GetUnitX(E),GetUnitY(E)))
    call SaveUnitHandle(h,id,6,E)
    endif
    call GroupRemoveUnit(g,E)
    endloop
endif
set x1=x1+75*Cos(a)
set y1=y1+75*Sin(a)
if c!=null then
    call SetControlToUnit(c,c,0.2,"heavystun")
    call SetUnitFacingInstant(c,a*bj_RADTODEG-180)
    call SetUnitXY_1(c,x1,y1, false)
endif
call UnitApplyTimedLife(CreateUnit(p,'e0NU',x1,y1,a*bj_RADTODEG),'BTLF',0.001)
call UnitApplyTimedLife(CreateUnit(p,'e0NV',x1,y1,a*bj_RADTODEG),'BTLF',0.75)
call UnitApplyTimedLife(CreateUnit(p,'e0NW',x1,y1,a*bj_RADTODEG),'BTLF',0.75)
else
if c!=null then
    call Push5(c,15,a,200,"null")
endif
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
call DestroyTimer(t)
call DestroyGroup(g)
endif
set u=null
set c=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function LanzadorVerdeCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,CreateUnit(GetOwningPlayer(u),'e0NT',x+80*Cos(a),y+80*Sin(a),a*bj_RADTODEG))
call SaveGroupHandle(h,id,4,CreateGroup())
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveReal(h,id,5,a)
call SetUnitFacing(LoadUnitHandle(h,id,1),a*bj_RADTODEG)
set soundplay=SndN(1721) // Sound\Music\mp3Music\LanzadorVerde.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.015,true,function LanzadorVerdeCast2)
set u=null
set t=null
endfunction
