function PainBirdCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,3)
local real x1=LoadReal(h,id,1)
local real y1=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real a=LoadReal(h,id,4)
local real r=0
local real di=0
local integer i=0
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)<2000 and IsTerrainPathable(GetUnitX(l__d),GetUnitY(l__d),PATHING_TYPE_FLYABILITY)==false then
call SetUnitX(l__d,x+75*Cos(a))
call SetUnitY(l__d,y+75*Sin(a))
call SetUnitFacing(u,a*bj_RADTODEG)
set r=GetRandomReal(0,7)
set di=GetRandomReal(-300,300)
set n=CreateUnit(p,'e0OS',x+di*Cos(r),y+di*Sin(a),GetRandomReal(0,359))
call SetUnitFlyHeight(n,250,0)
call SetUnitFlyHeight(n,0,500)
call UnitApplyTimedLife(n,1,0.6)
else
call UnitApplyTimedLife(CreateUnit(p,0x65304B45,x,y,GetRandomReal(0,359)),1,0.3)
call UnitApplyTimedLife(CreateUnit(p,0x65304B47,x,y,GetRandomReal(0,359)),1,0.5)
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
endif
set p=null
set t=null
set u=null
endfunction
function PainBirdCast takes nothing returns nothing
local timer t=CreateTimer()
local unit u=GetTriggerUnit()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
call SaveReal(h,id,1,x)
call SaveReal(h,id,2,y)
call UnitApplyTimedLife(CreateUnit(p,0x65304B45,x,y,GetRandomReal(0,359)),1,0.3)
call UnitApplyTimedLife(CreateUnit(p,0x65304B47,x,y,GetRandomReal(0,359)),1,0.5)
set E=CreateUnit(p,'e0KF',x+35*Cos(a),y+35*Sin(a),GetRandomReal(0,359))
call UnitApplyTimedLife(E,1,0.25)
call SetUnitTimeScale(E,0.65)
call SetUnitAnimation(E,"Birth")
set E=null
set n=CreateUnit(p,0x65304F52,x,y,a*bj_RADTODEG)
call SetUnitFlyHeight(n,350,350)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,3,n)
call SaveReal(h,id,4,Atan2(y1-y,x1-x))
set soundplay=CreateSound("Sound\\Music\\mp3Music\\PainKuchiyoseNoJustu.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.04,true,function PainBirdCast2)
set u=null
set p=null
set t=null
endfunction
