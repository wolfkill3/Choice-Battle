function TrunksR_Act3 takes nothing returns nothing
        local timer newTimer = GetExpiredTimer()
        local integer id = GetHandleId(newTimer)
        local unit caster = LoadUnitHandle(h, id, 0)
        local unit target = LoadUnitHandle(h, id, 1)
        local real point_x = GetUnitX(target)
        local real point_y = GetUnitY(target)
        local real angle  = AU(caster, target)
        local real time   = LoadReal(h, id, 3)
        local integer eff_period = LoadInteger(h, id, 4)
        local integer i   = 0
        call SaveReal(h, id, 3, time+0.03)
        if time<2.0 then
            call PauseUnit(caster, true)
            call PauseUnit(target,true)
            call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
            if time<1.5 then
                call SetUnitXY(caster, point_x-100*Cos(angle), point_y-100*Sin(angle))
                call SetUnitXY(target, point_x+1*Cos(angle), point_y+1*Sin(angle))
                if eff_period<=0 then
                    if GetRandomInt(0,3)==0 then
                        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", target,"chest"))
                        if GetRandomInt(0,1)==0 then
                                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", target,"head"))
                        else
                                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",target,"hand left"))
                                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",target,"hand right"))
                        endif
                    endif
                    // set n=CreateUnit(GetOwningPlayer(caster), 'd079', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG+GetRandomInt(-60,60))
                    // call UnitScale(n, GetRandomReal(0.45,0.75), GetRandomReal(0.45,0.75), 0.1)
                    // call SetUnitVertexColor(n, 10, 191, 255, 220)
                    // call MyRemoveUnit(n, 0.40)
                    set n=CreateUnit(GetOwningPlayer(caster), 'e0ZG', GetUnitX(caster)+40*Cos(angle), GetUnitY(caster)+40*Sin(angle), angle*bj_RADTODEG+GetRandomInt(-55,55))
                    call UnitScale(n, GetRandomReal(0.7,1.15), GetRandomReal(0.7,1.15), 0.1)
                    call SetUnitTimeScale(n,1.5)
                    call MyRemoveUnit(n, 0.4)
                    set n=CreateUnit(GetOwningPlayer(caster), 'e0ZF', GetUnitX(caster)+40*Cos(angle), GetUnitY(caster)+40*Sin(angle), angle*bj_RADTODEG+GetRandomInt(-55,55))
                    call UnitScale(n, GetRandomReal(0.7,1.15), GetRandomReal(0.7,1.15), 0.1)
                    call SetUnitTimeScale(n,1.5)
                    call MyRemoveUnit(n, 0.4)
                    set EFF=AddSpecialEffect("AZ_PA_C.mdx", GetUnitX(caster)+40*Cos(angle), GetUnitY(caster)+40*Sin(angle))
                    call SetSpecialEffectScale(EFF , GetRandomReal(1.4,1.7))
                    call SetSpecialEffectTimeScale(EFF , 0.3)
                    call SetSpecialEffectZ(EFF , GetRandomReal(20,130))
                    call SetSpecialEffectOrientation(EFF , angle * bj_RADTODEG,GetRandomReal(-70,70),GetRandomReal(-150,150))
                    call SetSpecialEffectVertexColour(EFF , 0 , 180 , 255, 220)
                    call DestroyEffect(EFF)
                    call SaveInteger(h,id,4,2)
                    if ModuloReal(time,0.12)<0.01 then
                        set n=CreateUnit(GetOwningPlayer(caster),0x65305051,GetUnitX(caster),GetUnitY(caster),angle*bj_RADTODEG)
                        call MyRemoveUnit(n,0.3)
                        call SetUnitTimeScale(n,GetRandomReal(2,4))
                        call SetUnitVertexColor(n,255,255,255,75)
                        call SetUnitAnimationByIndex(n,31)
                    endif
                else
                    call SaveInteger(h,id,4,eff_period-1)
                endif
            elseif time>1.68 and time<=1.72 then
                call SetUnitTimeScale(caster, 1.6)
                call SetUnitAnimationByIndex(caster,32)
            endif
        else
            call SetUnitTimeScale(caster, 1.0)
            
            loop
            exitwhen i>=4
                set n=CreateUnit(GetOwningPlayer(caster),'e0Y2',point_x+120*i*Cos(angle),point_y+120*i*Sin(angle),angle*bj_RADTODEG)
                call UnitApplyTimedLife(n,'B000',1)
                call SetUnitScale(n,0.4+0.4*i,0.4+0.4*i,0.4+0.4*i)
                call SetUnitFlyHeight(n,75+20*i,0)
                call SetUnitTimeScale(n,3)
                call SetUnitVertexColor(n,255,255,255,255)
            set i=i+1
            endloop
            set bjLCG=CreateGroup()
            call GroupEnumUnitsInRange(bjLCG, GetUnitX(target)+250*Cos(angle), GetUnitY(target)+250*Sin(angle), 350, Base)
            loop
            set E=FirstOfGroup(bjLCG)
                if Condition_Base(GetOwningPlayer(caster), E) and E!=target then
                    call myCustomDamage(caster, E, (GetHeroAgi(caster, true)*(GetUnitAbilityLevel(caster, 'A0R9')+3))*0.5, false,false,null,null,null)
                endif
                call GroupRemoveUnit(bjLCG, E)
            exitwhen E==null
            endloop
            call DestroyGroup(bjLCG)
            set n=CreateUnit(GetOwningPlayer(caster), 'd014', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG+180)
            call MyRemoveUnit(n, 1.7)
            set n=CreateUnit(GetOwningPlayer(caster), 'd019', GetUnitX(target)+200*Cos(angle), GetUnitY(target)+200*Sin(angle), angle*bj_RADTODEG)
            call SetUnitTimeScale(n, 0.8)
            call SetUnitFlyHeight(n, 200, 0) 
            call SetUnitScale(n, 1.6, 1.6, 1.6)
            call MyRemoveUnit(n, 1.5)
            set n=CreateUnit(GetOwningPlayer(caster), 'dH01', GetUnitX(target), GetUnitY(target), angle*bj_RADTODEG)
            call SetUnitScale(n, 2.5, 2.5, 2.5)
            call MyRemoveUnit(n, 1.7)
            
            call ShakeCamera(0.1, 15)
            call Push3(target,20,angle,400,"")
            call SetUnitInvulnerable(caster, false)
            call SetUnitInvulnerable(target, false)
            call PauseUnit(caster, false)
            call PauseUnit(target,false)
            call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
            call myCustomDamage(caster, target, GetHeroAgi(caster, true)*(GetUnitAbilityLevel(caster, 'A0R9')+3), false,false,null,null,null)
            call SetControlToUnit(target, target, 2.0, "stun")
            call FlushChildHashtable(h, id)
            call PauseTimer(newTimer)
            call DestroyTimer(newTimer)
        endif
        set newTimer=null
        set caster=null
        set target=null
endfunction

function TrunksR_Act2 takes nothing returns nothing
        local timer newTimer = GetExpiredTimer()
        local integer id = GetHandleId(newTimer)
        local unit caster = LoadUnitHandle(h, id, 0)
        local unit target = LoadUnitHandle(h, id, 1)
        local real angle  = LoadReal(h, id, 2)
        local real time   = LoadReal(h, id, 3)
        local real dist = LoadReal(h, id, 5)
        call SaveReal(h, id, 3, time+0.03)
        if time<0.6 then
            call SetUnitFlyHeight(caster, ParabolaZ2(0,460,510,dist,SR(GetUnitX(caster)+5*Cos(angle),GetUnitY(caster)+5*Sin(angle),GetUnitX(target),GetUnitY(target))), 0)
            if time==0.03 then
                call Push3(caster,30,angle,190,"")
            endif
            if time==0.06 then
                call SetUnitTimeScale(caster, .2)
                if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
                    if GetUnitTypeId(target)=='H048' or GetUnitTypeId(target)=='H248' then
                        set soundplay=CreateSound("Sound\\war3mapImported\\TrunksR_Frieza.mp3",false,false,true,12700,12700,"")
                    else
                        set soundplay=CreateSound("Sound\\war3mapImported\\TrunksR.mp3",false,false,true,12700,12700,"")
                    endif
                else
                    if GetUnitTypeId(target)=='H048' or GetUnitTypeId(target)=='H248' then
                        set soundplay=CreateSound("Sound\\Music\\mp3Music\\Trunks\\TrunksR_Frieza-jap.mp3",false,false,true,12700,12700,"")
                    else
                        set soundplay=CreateSound("Sound\\Music\\mp3Music\\Trunks\\TrunksR-jap.mp3",false,false,true,12700,12700,"")
                    endif
                endif
                call StartSound(soundplay)
                call KillSoundWhenDone(soundplay)
            endif
                
            if time==0.45 then
                call ShakeCamera(0.1, 10)
                call Push3(target,35,angle,300,"")
                set n=CreateUnit(GetOwningPlayer(caster), 'd080', GetUnitX(target)+100*Cos(angle), GetUnitY(target)+100*Sin(angle), angle*bj_RADTODEG)
                call SetUnitTimeScale(n, 0.8)
                call SetUnitFlyHeight(n, 250, 0) 
                call SetUnitScale(n, 1.6, 1.6, 1.6)
                call MyRemoveUnit(n, 1.5)
            endif
        else
            set n=CreateUnit(GetOwningPlayer(caster), 'd014', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG)
            call MyRemoveUnit(n, 1.7)
            set n=CreateUnit(GetOwningPlayer(caster), 'dH01', GetUnitX(target), GetUnitY(target), angle*bj_RADTODEG)
            call SetUnitScale(n, 2.5, 2.5, 2.5)
            call MyRemoveUnit(n, 1.7)
            set n=CreateUnit(GetOwningPlayer(caster), 'dR20', GetUnitX(target), GetUnitY(target), angle*bj_RADTODEG)
            call SetUnitScale(n, 1.5, 1.5, 1.5)
            call SetUnitVertexColor(n, 255, 255, 255, 150)
            call UnitApplyTimedLife(n, 1, 2.0)
            call MyRemoveUnit(n, 2.5)
            call SetUnitTimeScale(caster, 1.0)
            call SetUnitAnimationByIndex(caster,31)
            call SetUnitVertexColor(caster,255,255,255,255)
            call SetUnitXY_1(caster,GetUnitX(target)-20*Cos(angle), GetUnitY(target)-20*Sin(angle), false)
            call SaveReal(h, id, 3, 0.0)
            call SetUnitFlyHeight(caster,0,0)
            call PauseTimer(newTimer)
            call TimerStart(newTimer, 0.03, true, function TrunksR_Act3)
        endif
        set newTimer=null
        set caster=null
        set target=null
endfunction

function BurningSlashCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=AU(u,c)
local real x1=GetSpellTargetX()-200*Cos(a)
local real y1=GetSpellTargetY()-200*Sin(a)
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
    call PauseUnit(u,true)
    call SaveUnitHandle(h,id,0,u)
    call SaveUnitHandle(h,id,1,c)
    call SaveReal(h,id,2,a)
    call SaveReal(h,id,3,0.0)
    set n=CreateUnit(p, 'd042', x, y, 0)
    call MyRemoveUnit(n, 1.5)
    set n=CreateUnit(p, 'd042', x1, y1, 0)
    call SetUnitFlyHeight(n, 450, 0)
    call MyRemoveUnit(n, 1.5)
    call SetUnitXY_1(u,x1,y1, false)
    call SetUnitFacingInstant(u,a*bj_RADTODEG)
    call SaveReal(h,id,5,SR(x1,y1,GetUnitX(c),GetUnitY(c)))
    call UnitAddAbility(u, 'Arav')
    call SetUnitFlyHeight(u, 450, 0)
    call UnitRemoveAbility(u, 'Arav')
    call SetUnitVertexColor(u,255,255,255,150)
    call SetUnitInvulnerable(u,true)
    call SetUnitTimeScale(u, 2.0)
    call SetUnitAnimationByIndex(u,45)
    call PauseUnit(c,true)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
    call SetUnitInvulnerable(c,true)
    set soundplay=CreateSound("Sound\\Music\\mp3Music\\Soru2.mp3",false,false,true,12700,12700,"")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    call TimerStart(t,0.03,true,function TrunksR_Act2)
else
    call SetUnitTimeScale(u,1)
    set n=CreateUnit(p, 'd042', x, y, 0)
    call MyRemoveUnit(n, 1.5)
    set n=CreateUnit(p, 'd042', x1, y1, 0)
    call SetUnitFlyHeight(n, 450, 0)
    call MyRemoveUnit(n, 1.5)
    call SetUnitXY_1(u,x1,y1, false)
    call SetUnitFacingInstant(u,a*bj_RADTODEG)
    call SetUnitX(u,x1)
    call SetUnitY(u,y1)
    call SetUnitFlyHeight(u, 450, 0)
    call PauseUnit(u,false)
    call SetUnitInvulnerable(u,false)
    call PauseUnit(c,false)
    call SetUnitAnimationByIndex(u,45)
    call SetUnitFlyHeight(u, 0, 800)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
    call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
    call PauseTimer(t)
    call DestroyTimer(t)
    call SetUnitVertexColor(u,255,255,255,255)
    call FlushChildHashtable(h,id)
endif
set t=null
set u=null
set p=null
set c=null
endfunction
function InitTrig_BurningSlash takes nothing returns nothing
set gg_trg_BurningSlash=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_BurningSlash,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_BurningSlash,Condition(function BurningSlashCond))
call TriggerAddAction(gg_trg_BurningSlash,function BurningSlashCast)
endfunction
function BurningAttackCond takes nothing returns boolean
return GetSpellAbilityId()=='A0R8'
endfunction
function BurningAttackCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local group g=LoadGroupHandle(h,id,6)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real x2
local real y2
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,5)
local real a2
local player p=GetOwningPlayer(u)
local real dmg=GetHeroAgi(u,true)*(GetUnitAbilityLevel(u,'A0R8')+1)
local real time=LoadReal(h,id,7)
if time<0.76 then
call SaveReal(h,id,7,time+0.02)
if time==0.74 then
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\ThrowBurningAttack.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
else
if SR(x,y,x1,y1)<=1750 and IsTerrainPathable(GetUnitX(l__d),GetUnitY(l__d),PATHING_TYPE_FLYABILITY)==false then
set x1=x1+35*Cos(a)
set y1=y1+35*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,0.7,0.7,0.7)
call SetUnitVertexColor(n,255,230,100,70)
call GroupEnumUnitsInRange(G,x1,y1,150,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
set x2=GetUnitX(E)
set y2=GetUnitY(E)
set a2=Atan2(y2-y1,x2-x1)
call SetUnitXY_1(E,x2-58*Cos(a2),y2-58*Sin(a2),false)
call SetControlToUnit(u,E,0.04,"heavystun")
if IsUnitInGroup(E,g)==false then
call GroupAddUnit(g,E)
call SetUnitPathing(E,false)
endif
endif
call GroupRemoveUnit(G,E)
endloop
else
loop
set E=FirstOfGroup(g)
exitwhen E==null
call SetUnitFlyHeight(E,0,GetUnitFlyHeight(E))
call GroupRemoveUnit(g,E)
call SetUnitPathing(E,true)
endloop
if GetUnitAbilityLevel(u,0x41313653)>0 then
set dmg=dmg+1*GetHeroAgi(u,true)
elseif GetUnitAbilityLevel(u,'A16T')>0 or GetUnitAbilityLevel(u,'A26T')>0 then
set dmg=dmg+2*GetHeroAgi(u,true)
endif
call UnitApplyTimedLife(CreateUnit(p,'e0NJ',x1,y1,GetRandomReal(0,359)),1,3)
//call UnitApplyTimedLife(CreateUnit(p,'e0NK',x1,y1,GetRandomReal(0,359)),1,6)
call UnitApplyTimedLife(CreateUnit(p,'e0NI',x1,y1,GetRandomReal(0,359)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0NL',x1,y1,GetRandomReal(0,359)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0NM',x1,y1,GetRandomReal(0,359)),1,3)
call GroupEnumUnitsInRange(DG,x1,y1,500,Base)
loop
set E=FirstOfGroup(DG)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(DG,E)
endloop
call SetUnitTimeScale(u,1)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
call DestroyGroup(g)
call RemoveUnit(l__d)
endif
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function BurningAttackCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
local unit l__d=CreateUnit(GetOwningPlayer(u),'e0PP',x+150*Cos(a),y+150*Sin(a),f)
call SetUnitColor(l__d,PLAYER_COLOR_GREEN)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,l__d)
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveReal(h,id,5,a)
call SaveGroupHandle(h,id,6,CreateGroup())
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\BurningAttack.mp3",false,false,true,12700,12700,"")
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Trunks\\BurningAttack-jap.mp3",false,false,true,12700,12700,"")
endif
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call PauseUnit(u,true)
call SetUnitTimeScale(u,2.1)
call SetUnitAnimationByIndex(u,30)
call SetUnitInvulnerable(u,true)
call TimerStart(t,0.02,true,function BurningAttackCast2)
set u=null
set t=null
set l__d=null
endfunction
function InitTrig_BurningAttack takes nothing returns nothing
set gg_trg_BurningAttack=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_BurningAttack,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_BurningAttack,Condition(function BurningAttackCond))
call TriggerAddAction(gg_trg_BurningAttack,function BurningAttackCast)
endfunction
function PowerDownVegito takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
if GetUnitAbilityLevel(u,'A174')>0 then
    call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.0003)
endif
if GetUnitAbilityLevel(u,'A176')>0 then
    call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.001)
endif
endif
if GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.1>GetUnitState(u,UNIT_STATE_LIFE) or GetUnitState(u,UNIT_STATE_MAX_MANA)*0.04>GetUnitState(u,UNIT_STATE_MANA) or LoadBoolean(HH,GetHandleId(u),SST)==true then
if GetUnitAbilityLevel(u,'A176')>0 then
call ShowAbility2Timed('VTBB',false,4.95)
call ShowAbility2Timed('A177',true,4.97)
endif
call SaveBoolean(HH,GetHandleId(u),SS,false)
call SaveBoolean(HH,GetHandleId(u),SST,false)
call UnitRemoveAbility(u,'A174')
call UnitRemoveAbility(u,'A176')
call UnitAddAbility(u,'A173')
call SetUnitAbilityLevel(u,'A278',1)
call UnitMakeAbilityPermanent(u,true,'A173')
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set t=null
set u=null
endfunction
function PowerUpVegitoCond takes nothing returns boolean
return (GetSpellAbilityId()=='VTSS' or GetSpellAbilityId()=='VTBS' or GetSpellAbilityId()=='VTBB' or GetSpellAbilityId()=='VTSG') and udg_B==true
endfunction
function PowerUpVegitoCast2 takes nothing returns nothing
	local timer t=GetExpiredTimer()
	local timer tt=CreateTimer()
	local integer id=GetHandleId(t)
	local unit u=LoadUnitHandle(h,id,0)
	local real x=GetUnitX(u)
	local real y=GetUnitY(u)
	local player p=GetOwningPlayer(u)
	local real time=LoadReal(h,id,1)
	if time<0.1 then
		call PauseUnit(u,true)
		call SaveReal(h,id,1,time+0.025)
	else
		call PauseUnit(u,false)
		call SetUnitTimeScale(u,1)
		call SetUnitAbilityLevel(u,'A278',LoadInteger(h,id,3)+1)
		if LoadInteger(h,id,3)==1 and GetUnitAbilityLevel(u,'A174')==0 then //ss
			set EFF=AddSpecialEffect("Yellow--zhendi.mdl", x, y)
			call DestroyEffect(EFF)
			call UnitRemoveAbility(u,'A173')
			call UnitRemoveAbility(u,'A174')
			call UnitRemoveAbility(u,'A176')
			call UnitAddAbility(u,'A174')
			call UnitMakeAbilityPermanent(u,true,'A174')
            call StartSound(soundStr[90])
		elseif LoadInteger(h,id,3)==2 then //ssgss
			call UnitRemoveAbility(u,'A173')
			call UnitRemoveAbility(u,'A174')
			call UnitRemoveAbility(u,'A176')
			call UnitAddAbility(u,'A176')
			set EFF=AddSpecialEffect("Blue--zhendi.mdl", x, y)
			call DestroyEffect(EFF)
            call ShowAbility2('A177',false)
            call ShowAbility2('VTBB',true)
			call UnitMakeAbilityPermanent(u,true,'A176')
			call StartSound(soundStr[90])
		endif
		if LoadInteger(h,id,3)==0 and GetUnitAbilityLevel(u,'A173')==0 then
			call StartSound(soundStr[89]) 
		endif
		if LoadBoolean(HH,GetHandleId(u),SS)==false then
			call SaveUnitHandle(h,GetHandleId(tt),0,u)
			call SaveBoolean(HH,GetHandleId(u),SS,true)
			call TimerStart(tt,0.1,true,function PowerDownVegito)
		endif
		if LoadInteger(h,id,3)==0 then
			call SaveBoolean(HH,GetHandleId(u),SST,true)
		endif
		call PauseTimer(t)
		call DestroyTimer(t)
		call FlushChildHashtable(h,id)
		endif
	set p=null
	set tt=null
	set u=null
	set t=null
