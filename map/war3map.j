                        call SetSpecialEffectScale(EFF,GetRandomReal(0.85,1.15))
                        call SetSpecialEffectTimeScale(EFF,GetRandomReal(0.75,1.25))
                        call SetSpecialEffectVertexColour(EFF,ColorPercentT(100,255),ColorPercentT(100,255),ColorPercentT(100,255),ColorPercentT((100),255))
                        call SetSpecialEffectZ(EFF,100)
                        call EffectLifeTime(EFF,0.5)
                        call MoveEffect(c,EFF,cjlocgn_00000000,LoadReal(HH,id,3))
                        call MoveEffect(c,EFF,cjlocgn_00000001,cjlocgn_00000002)
                        set EFF=AddSpecialEffect("war3mapImported\\CF2.mdl",GetUnitX(c),GetUnitY(c))
                        call SetSpecialEffectFacing(EFF,LoadReal(HH,id,3))
                        call SetSpecialEffectScale(EFF,GetRandomReal(0.25,0.35))
                        call SetSpecialEffectTimeScale(EFF,GetRandomReal(0.7,0.9))
                        call SetSpecialEffectVertexColour(EFF,ColorPercentT(70,255),ColorPercentT(70,255),ColorPercentT(100,255),ColorPercentT((100-GetRandomInt(30,40)),255))
                        call SetSpecialEffectZ(EFF,100)
                        call EffectLifeTime(EFF,0.5)
                        call MoveEffect(c,EFF,cjlocgn_00000000,LoadReal(HH,id,3))
                        call MoveEffect(c,EFF,cjlocgn_00000001,cjlocgn_00000002)
                        set cjlocgn_00000000=GetRandomReal(-50,150)
                        set cjlocgn_00000001=GetRandomReal(-125,125)
                        if GetRandomInt(1,2)==1 then
                                set cjlocgn_00000002=LoadReal(HH,id,3)-90
                        else
                                set cjlocgn_00000002=LoadReal(HH,id,3)+90
                        endif
                        set EFF=AddSpecialEffect("war3mapImported\\hero_juggernaut_n4s_e_line.mdl",GetUnitX(c),GetUnitY(c))
                        call SetSpecialEffectFacing(EFF,LoadReal(HH,id,3))
                        call SetSpecialEffectScale(EFF,GetRandomReal(0.85,1.15))
                        call SetSpecialEffectTimeScale(EFF,GetRandomReal(0.75,1.25))
                        call SetSpecialEffectVertexColour(EFF,ColorPercentT(100,255),ColorPercentT(100,255),ColorPercentT(100,255),ColorPercentT((100),255))
                        call SetSpecialEffectZ(EFF,100)
                        call EffectLifeTime(EFF,0.5)
                        call MoveEffect(c,EFF,cjlocgn_00000000,LoadReal(HH,id,3))
                        call MoveEffect(c,EFF,cjlocgn_00000001,cjlocgn_00000002)
                        set EFF=AddSpecialEffect("war3mapImported\\CF2.mdl",GetUnitX(c),GetUnitY(c))
                        call SetSpecialEffectFacing(EFF,LoadReal(HH,id,3))
                        call SetSpecialEffectScale(EFF,GetRandomReal(0.25,0.35))
                        call SetSpecialEffectTimeScale(EFF,GetRandomReal(0.7,0.9))
                        call SetSpecialEffectVertexColour(EFF,ColorPercentT(70,255),ColorPercentT(70,255),ColorPercentT(100,255),ColorPercentT((100-GetRandomInt(30,40)),255))
                        call SetSpecialEffectZ(EFF,100)
                        call EffectLifeTime(EFF,0.5)
                        call MoveEffect(c,EFF,cjlocgn_00000000,LoadReal(HH,id,3))
                        call MoveEffect(c,EFF,cjlocgn_00000001,cjlocgn_00000002)
