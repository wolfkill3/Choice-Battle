set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 0.25, "silenceTE")
call SlowUnit(u,E,0.85,0.85,0.15,2,false)
endif
call GroupRemoveUnit(G,E)
endloop
if dist>=5.0 then
call ForGroup(g,function KillGroup)
loop
exitwhen i>=19
call RemoveDestructable(LoadDestructableHandle(h,id,l__s+i))
