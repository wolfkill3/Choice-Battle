function TKingHassanCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit l__d=LoadUnitHandle(h,id,6)
local real dmg=LoadReal(h,id,2)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local real walk=LoadReal(h,id,3)
local real fire=LoadReal(h,id,4)
local player p=GetOwningPlayer(u)
local real sc=0
local integer is=0
local real ig=15*bj_DEGTORAD
if SR(x,y,x1,y1)>400 then
call SaveReal(h,id,3,walk+0.03)
call SaveReal(h,id,4,fire+0.03)
call SaveReal(h,id,2,dmg+GetHeroStr(u,true)*0.015)
call SetUnitInvulnerable(u,true)
if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
call PauseUnit(u,true)
endif
if walk>1.2 then
call SetUnitAnimationByIndex(u,1)
call SetUnitTimeScale(l__d,0)
call SaveReal(h,id,3,0)
endif
call SetUnitXY_1(l__d,x,y, false)
call SetUnitX(u,x+7*Cos(a))
call SetUnitY(u,y+7*Sin(a))
call SetUnitFacing(u,a*bj_RADTODEG)
if fire>0.2 then
set n=CreateUnit(p,'e16B',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,75)
call UnitApplyTimedLife(n,'BTLF',0.4)
set x=x+40*Cos(a)
set y=y+40*Sin(a)
set n=CreateUnit(p,'e160',x,y,a*bj_RADTODEG+45)
call UnitApplyTimedLife(n,'BTLF',0.7)
call SetUnitMoveSpeed(n,400)
call SetUnitPathing(n,false)
call IssuePointOrder(n,"move",x+800*Cos(a+bj_PI/4),y+800*Sin(a+bj_PI/4))
set n=CreateUnit(p,'e160',x,y,a*bj_RADTODEG-45)
call UnitApplyTimedLife(n,'BTLF',0.7)
call IssuePointOrder(n,"move",x+800*Cos(a-bj_PI/4),y+800*Sin(a-bj_PI/4))
call SetUnitMoveSpeed(n,400)
call SetUnitPathing(n,false)
call SaveReal(h,id,4,0)
endif
if dmg>GetUnitState(c,UNIT_STATE_LIFE)then
call SetUnitX(u,x1-390*Cos(a))
call SetUnitY(u,y1-390*Sin(a))
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
endif
else
    if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
        call PauseUnit(c,true)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
        call SetUnitAnimation(u,"attack")
        call PauseTimer(t)
        call TimerStart(t,0.75,false,function TKingHassanCast3)
        loop
        exitwhen is>=25
        set n=CreateUnit(p,'e0ZH',x1+850*Cos(ig*is),y1+850*Sin(ig*is),180+is*15)
        call SetUnitVertexColor(n,255,255,255,25)
        call SetUnitScale(n,2.0,2.0,2.0)
        call UnitApplyTimedLife(n,'BTLF',3)
        call SetUnitTimeScale(n,0.2)
        set is=is+1
        endloop
        call SetUnitScale(l__d,1.75,1.75,1.75)
        call SetUnitVertexColor(l__d,255,255,255,0)
        set n=CreateUnit(p,'e13F',x1,y1,a*bj_RADTODEG+90)
        call SetUnitVertexColor(n,255,255,155,100)
        call SetUnitScale(n,4,4,4)
        call SetUnitTimeScale(n,2)
        call UnitApplyTimedLife(n,'BTLF',4)
        call SetUnitXY_1(l__d,x1,y1, false)
    else
        call PauseUnit(u,false)
        call PauseUnit(c,false)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
        call SetUnitInvulnerable(u,false)
        call SetUnitVertexColor(u,255,255,255,255)
        call SetUnitTimeScale(u,1)
        call RemoveUnit(l__d)
        call PauseTimer(t)
        call SetUnitFlyHeight(u,0,0)
        call DestroyTimer(t)
        call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
        call FlushChildHashtable(h,id)
    endif
endif
set l__d=null
set p=null
set c=null
set u=null
set t=null
endfunction
function TKingHassanCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
set n=CreateUnit(GetOwningPlayer(u),'e0RV',GetUnitX(u),GetUnitY(u),0)
call SetUnitTimeScale(n,0.75)
call SaveUnitHandle(h,id,6,n)
call SetUnitScale(n,0.85,0.85,0.85)
call SetUnitVertexColor(n,255,255,255,200)
call SaveReal(h,id,2,GetHeroStr(u,true)*10)
call SaveReal(h,id,3,0)
call SaveReal(h,id,4,0)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SetUnitAnimationByIndex(u,1)
set soundplay=SndN(2928) // Sound\Music\mp3Music\KingHassanNP1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.03,true,function TKingHassanCast2)
set u=null
set c=null
set t=null
endfunction
function InitTrig_TKingHassan takes nothing returns nothing
set gg_trg_TKingHassan=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_TKingHassan,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_TKingHassan,Condition(function TKingHassanCond))
call TriggerAddAction(gg_trg_TKingHassan,function TKingHassanCast)
endfunction
function Trig_RulerF_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A1HQ' or GetSpellAbilityId()=='A1HR' or GetSpellAbilityId()=='A1HS'
endfunction
function Trig_RulerF_Actions takes nothing returns nothing
local unit c=GetSpellTargetUnit()
local unit u=GetTriggerUnit()
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\DTRed.mdx",c,"origin"))
if GetSpellAbilityId()=='A1HQ' then
call UnitAddAbility(c,'A1HP')
call UnitRemoveAbilityTimed(c,'A1HP',30)
elseif GetSpellAbilityId()=='A1HR' then
call HealTextTag(u,c,GetUnitState(c,UNIT_STATE_MAX_LIFE)*0.3*myCustomHeal2(c,1),"HealthRes")
call SetUnitState(c,UNIT_STATE_LIFE,GetWidgetLife(c)+GetUnitState(c,UNIT_STATE_MAX_LIFE)*0.3)
elseif GetSpellAbilityId()=='A1HS' then
call SetUnitPosition(c,GetUnitX(u),GetUnitY(u))
call UnitRemoveBuffs(c,false,true)
endif
set soundplay=SndN(2930) // Sound\Music\mp3Music\JeanneF.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set c=null
set u=null
endfunction
function InitTrig_RulerF takes nothing returns nothing
set gg_trg_RulerF=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_RulerF,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_RulerF,Condition(function Trig_RulerF_Conditions))
call TriggerAddAction(gg_trg_RulerF,function Trig_RulerF_Actions)
endfunction
function WRulerCond takes nothing returns boolean
return GetSpellAbilityId()=='A1HN'
endfunction
function WRulerCast4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real dmg=GetHeroInt(u,true)*(1+GetUnitAbilityLevel(u,'A1HN'))+50
local real x=0
local real y=0
local real x1=LoadReal(h,id,1)
local real y1=LoadReal(h,id,2)
local real a=Atan2(y1-y,x1-x)
local group g=LoadGroupHandle(h,id,4)
local group g2
local real dist=LoadReal(h,id,3)-50
if dist>0 then
set g2=CopyGroup(g)
loop
set E=FirstOfGroup(g2)
exitwhen E==null
call SetUnitFlyHeight(E,GetUnitFlyHeight(E)-50,0)
call GroupRemoveUnit(g2,E)
endloop
call DestroyGroupTimed(g2,3)
call SaveReal(h,id,3,dist)
else
loop
set E=FirstOfGroup(g)
set x=GetUnitX(E)
set y=GetUnitY(E)
exitwhen E==null
call SetUnitFlyHeight(E,0,GetUnitFlyHeight(E))
call PauseUnit(E,false)
call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,false)
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call DestroyEffect(AddSpecialEffect("war3mapImported\\WarStompCaster.mdx",x,y))
call DestroyEffect(AddSpecialEffect("war3mapImported\\SandPoff.mdx",x,y))
call DestroyEffect(AddSpecialEffect("war3mapImported\\Slam.mdx",x,y))
call GroupRemoveUnit(g,E)
endloop
call GroupClear(g)
call DestroyGroup(g)
call PauseTimer(t)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
endif
set g=null
set g2=null
set t=null
set u=null
endfunction
function WRulerCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
