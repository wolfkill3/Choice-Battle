function Trig_AngelWings_Conditions takes nothing returns boolean
return UnitHasItemOfTypeBJ(GetTriggerUnit(),'I030')and GetUnitTypeId(GetTriggerUnit())!='H007'  and GetUnitAbilityLevel(GetTriggerUnit(),'GIE1')==0
endfunction
function Trig_AngelWings_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local item it=GetManipulatedItem()
local integer id=GetPlayerId(GetTriggerPlayer())
local integer i=0
local integer count=0
if udg_kill[GetPlayerId(GetTriggerPlayer())]<15 then
call RemoveItem(it)
call SetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD)+1500)
call DisplayTextToPlayer(Player(id),0,0,"Недостаточно убийств")
set soundplay=CreateSound("UareNotPrepared.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
else
loop
exitwhen i>=6
if GetItemTypeId(UnitItemInSlot(u,i))=='I030' then
set count=count+1
endif
set i=i+1
endloop
if count>1 then
call RemoveItem(it)
call SetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(id),PLAYER_STATE_RESOURCE_GOLD)+1500)
call DisplayTextToPlayer(Player(id),0,0,"Нельзя иметь больше одного такого предмета!")
endif
endif
set u=null
set it=null
endfunction
