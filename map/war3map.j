set x2=GetUnitX(E)
set y2=GetUnitY(E)
set a2=Atan2(y1-y2,x1-x2)+0.1
call SetUnitX(E,x1+250*Cos(a2))
call SetUnitY(E,y1+250*Sin(a2))
call SetUnitFacing(E,Atan2(y1-GetUnitY(E),x1-GetUnitX(E))*bj_RADTODEG)
set E=LoadUnitHandle(h,id,2)
call SetUnitAnimation(E,"Attack")
set x2=GetUnitX(E)
set y2=GetUnitY(E)
set a2=Atan2(y1-y2,x1-x2)-0.1
call SetUnitX(E,x1+250*Cos(a2))
call SetUnitY(E,y1+250*Sin(a2))
call SetUnitFacing(E,Atan2(y1-GetUnitY(E),x1-GetUnitX(E))*bj_RADTODEG)
set E=LoadUnitHandle(h,id,3)
call SetUnitAnimation(E,"Attack")
set x2=GetUnitX(E)
set y2=GetUnitY(E)
set a2=Atan2(y1-y2,x1-x2)+0.1
call SetUnitX(E,x1+250*Cos(a2))
call SetUnitY(E,y1+250*Sin(a2))
call SetUnitFacing(E,Atan2(y1-GetUnitY(E),x1-GetUnitX(E))*bj_RADTODEG)
set E=LoadUnitHandle(h,id,4)
call SetUnitAnimation(E,"Attack")
set x2=GetUnitX(E)
set y2=GetUnitY(E)
set a2=Atan2(y1-y2,x1-x2)-0.1
call SetUnitX(E,x1+250*Cos(a2))
call SetUnitY(E,y1+250*Sin(a2))
call SetUnitFacing(E,Atan2(y1-GetUnitY(E),x1-GetUnitX(E))*bj_RADTODEG)
else
call SetUnitInvulnerable(u,false)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call PauseUnit(u,false)
call ShowUnit(u,true)
if GetLocalPlayer()==p then
call ClearSelection()
call SelectUnit(u,true)
endif
call PoisonDamage3(u,c,GetHeroInt(u,true)*3,3,"war3mapImported\\amaterasu2.mdx","origin")
call RemoveUnit(LoadUnitHandle(h,id,1))
call RemoveUnit(LoadUnitHandle(h,id,2))
call RemoveUnit(LoadUnitHandle(h,id,3))
call RemoveUnit(LoadUnitHandle(h,id,4))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set c=null
set t=null
set u=null
endfunction
function BonusDMGYuji takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local integer idu=GetHandleId(u)
local real time=LoadReal(HH,idu,SH_bu3)
local integer numb=0
