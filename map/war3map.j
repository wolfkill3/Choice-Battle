endfunction
function ShikaiAizenCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local integer idu=GetHandleId(u)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real dmg=LoadReal(HH,idu,StringHash("dmg"))
local real life=LoadReal(HH,idu,StringHash("hp"))
local real time=LoadReal(h,id,10)
if time>0 then
if time==7.0 then
        call SetWidgetMana(u, GetWidgetMana(u)+500)
endif
if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
call SaveReal(h,id,10,time-0.1)
endif
else
if GetUnitAbilityLevel(u,'A0JS')>0 then
call SetUnitXY_1(u,x1,y1, false)
call SetUnitXY_1(c,x,y, false)
call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",x,y))
call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",x,y))
call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",x,y))
call SetUnitInvulnerable(c,false)
call UnitRemoveBuffs(c,true,false)
if UnitHasItemOfTypeBJ(c, 'I03A') and GetWidgetLife(c)>0 and IsUnitIllusion(c)==false then
    set AlastorPos=0
    loop
    exitwhen AlastorPos==6 or GetItemTypeId(UnitItemInSlot(c,AlastorPos)) == 'I03A'
    set AlastorPos=AlastorPos+1
    endloop
    if IsAbilityEnabled(GetUnitAbility(c,'AInv'))==true then
        set Alastor=GetItemOfTypeFromUnitBJ(c,'I03A')
        call UnitRemoveItem(c,Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(c, 'I03A',AlastorPos)
    else
        call EnableUnitAbility2(c,'AInv',false,true)
        set Alastor=GetItemOfTypeFromUnitBJ(c,'I03A')
        call UnitRemoveItem(c,Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(c, 'I03A',AlastorPos)    
        call DisableUnitAbility2(c,'AInv',false,true)
    endif
endif
call UnitAddAbility(c,'A0WR')
call myCustomDamage(u,c,dmg,false,false,null,DAMAGE_TYPE_UNIVERSAL,null)
call DamageIndicatorFunction(u, c, dmg)
call UnitRemoveAbility(c,'A0WR')
if GetUnitAbilityLevel(u,'A114')>0 then
call UnitRemoveAbility(u,'A114')
endif
call SetUnitState(u,UNIT_STATE_LIFE,life)
call RemoveSavedReal(HH,idu,StringHash("hp"))
call RemoveSavedReal(HH,idu,StringHash("dmg"))
call RemoveSavedHandle(HH,idu,StringHash("u"))
call RemoveSavedHandle(HH,idu,StringHash("c"))
set soundplay=CreateSound("Sound\\Music\\mp3Music\\AizenShikai.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
call UnitRemoveAbility(u,'A0JS')
call SetWidgetMana(u, GetWidgetMana(u)-500)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set t=null
endfunction
