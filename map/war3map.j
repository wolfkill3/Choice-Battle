function LucyVirgoCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,2)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real r=GetRandomReal(-300,300)
local real r1=GetRandomReal(-300,300)
local group g=LoadGroupHandle(h,id,1)
local player p=GetOwningPlayer(u)
local real sc=0
local real is=0
local real ig=30*bj_DEGTORAD
set x=x+r
set y=y+r
call SetUnitXY_1(l__d,x,y, false)
loop
exitwhen is>=13
set n=CreateUnit(p,'e0ZH',x+300*Cos(ig*is),y+300*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,255,255,255,55)
call UnitApplyTimedLife(n,'BTLF',10)
call SetUnitTimeScale(n,0.1)
set is=is+1
endloop
set n=CreateUnit(p,'e0RV',x,y,0)
call SetUnitTimeScale(n,0.4)
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitScale(n,0.6,0.6,0.6)
call SetUnitVertexColor(n,255,255,255,150)
loop
set E=FirstOfGroup(g)
exitwhen E==null
if E!=null then
set r=GetRandomReal(-200,200)
set r1=GetRandomReal(-200,200)
call ShowUnit(E,true)
call SetUnitX(E,x+r)
call SetUnitY(E,y+r1)
call DestroyEffect(AddSpecialEffect("war3mapImported\\SandPoff.mdx",x+r,y+r1))
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl",x+r,y+r1))
call SetUnitInvulnerable(E,false)
endif
call GroupRemoveUnit(g,E)
endloop
call SetUnitAnimation(l__d,"Spell Two")
call UnitApplyTimedLife(l__d,'BTLF',2)
set g=null
set l__d=null
set u=null
set t=null
endfunction
function LucyVirgoCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real r=GetRandomReal(-300,300)
local real r1=GetRandomReal(-300,300)
local group g=LoadGroupHandle(h,id,1)
local player p=GetOwningPlayer(u)
call GroupEnumUnitsInRange(G,x,y,400,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if IsUnitAlly(E,p)and GetUnitTypeId(E)!='e054' and IsUnitType(E,UNIT_TYPE_HERO)then
call ShowUnit(E,false)
call GroupAddUnit(g,E)
call SetUnitInvulnerable(E,true)
call DestroyEffect(AddSpecialEffect("war3mapImported\\SandPoff.mdx",GetUnitX(E),GetUnitY(E)))
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl",GetUnitX(E),GetUnitY(E)))
endif
call GroupRemoveUnit(G,E)
endloop
call SetUnitAnimation(l__d,"Spell One")
call TimerStart(t,1,false,function LucyVirgoCast3)
set g=null
set l__d=null
set u=null
set t=null
endfunction
function LucyVirgoCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local player p=GetOwningPlayer(u)
local group g=CreateGroup()
local real sc=0
local real is=0
local real ig=30*bj_DEGTORAD
loop
exitwhen is>=13
set n=CreateUnit(p,'e0ZH',x1+250*Cos(ig*is),y1+250*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,255,255,255,55)
call UnitApplyTimedLife(n,'BTLF',10)
call SetUnitTimeScale(n,0.1)
set is=is+1
endloop
set n=CreateUnit(p,'e0RV',x1,y1,0)
call SetUnitTimeScale(n,0.4)
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitScale(n,0.5,0.5,0.5)
call SetUnitVertexColor(n,255,255,255,150)
set n=CreateUnit(p,'e14C',x1,y1,GetRandomReal(0,359))
call DestroyEffect(AddSpecialEffect("war3mapImported\\SandPoff.mdx",x1,y1))
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl",x1,y1))
call SetUnitAnimation(n,"Spell Two")
call SaveUnitHandle(h,id,2,n)
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,1,g)
set soundplay=SndN(2803) // Sound\Music\mp3Music\Deva.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,1,false,function LucyVirgoCast2)
set t=null
set u=null
set g=null
set p=null
endfunction
