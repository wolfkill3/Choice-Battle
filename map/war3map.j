function GaaraChoice_Act takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit caster=GetTriggerUnit()
local real x0=GetUnitX(caster)
local real y0=GetUnitY(caster)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real facing=Angle2(x0,y0,x1,y1)
local boolean GaaraFly=LoadBoolean(HH,GetHandleId(caster),StringHash("GaaraF"))

call SaveUnitHandle(HH,id,1,caster)
call SaveReal(HH,id,11,x1)
call SaveReal(HH,id,12,y1)
call SaveReal(HH,id,3,facing)

if GetSpellAbilityId()=='ASGR' then


set soundplay=CreateSound("Sound\\Music\\mp3Music\\GaaraR1.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\GaaraR2.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)


call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
if GaaraFly==true then
call SetUnitAnimationByIndex(caster,15)
else
call SetUnitAnimationByIndex(caster,9)
endif
call SaveInteger(HH,GetHandleId( caster ),StringHash("GaaraGtype"),3)
call SaveReal(HH,id,15,(GetUnitAbilityLevel(caster,'ASGR')+3)*GetHeroInt(caster,true))
call TimerStart(t,0.02,true,function GaaraRAct)
endif

if GetSpellAbilityId()=='ASGG' then
//Gaara not have skills
if  LoadInteger(HH,GetHandleId( caster ),StringHash("GaaraGtype"))==1 and LoadUnitHandle(HH,GetHandleId(caster),StringHash("GaaraQUDummy"))==null  then
call SaveInteger(HH,GetHandleId( caster ),StringHash("GaaraGtype"),0)
endif
if  LoadInteger(HH,GetHandleId( caster ),StringHash("GaaraGtype"))==0 then

call TimerStart(t,0.02,false,function GaaraGNullAct)
endif
// Gaara G Q
if  LoadInteger(HH,GetHandleId( caster ),StringHash("GaaraGtype"))==1 then
call SaveInteger(HH,GetHandleId( caster ),StringHash("GaaraGtype"),0)
call SaveUnitHandle(HH,id,2,  LoadUnitHandle(HH,GetHandleId( caster ),StringHash("GaaraQU"))  )
call SaveUnitHandle(HH,GetHandleId( caster ),StringHash("GaaraQU"), null)

call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
if GaaraFly==true then
call SetUnitAnimationByIndex(caster,17)
else
call SetUnitAnimationByIndex(caster,8)
endif

set soundplay=CreateSound("Sound\\Music\\mp3Music\\GaaraQG.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)

call SaveReal(HH,id,15,3*GetHeroInt(caster,true))




call SaveBoolean(HH,GetHandleId( caster ),StringHash("GaaraGQactB"),true)
call SaveUnitHandle(HH,id,21,LoadUnitHandle(HH,GetHandleId(caster),StringHash("GaaraQUDummy"))   )

call TimerStart(t,0.02,true,function GaaraQGAct)

endif
//Gaara G W
if  LoadInteger(HH,GetHandleId( caster ),StringHash("GaaraGtype"))==2 then
call SaveInteger(HH,GetHandleId( caster ),StringHash("GaaraGtype"),0)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\GaaraWG.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)

call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
if GaaraFly==true then
call SetUnitAnimationByIndex(caster,16)
else
call SetUnitAnimationByIndex(caster,6)
endif



call SaveReal(HH,id,11, LoadReal(HH,GetHandleId( caster ),StringHash("GaaraGWX") ) )
call SaveReal(HH,id,12, LoadReal(HH,GetHandleId( caster ),StringHash("GaaraGWY") ) )
call SaveReal(HH,GetHandleId( caster ),StringHash("GaaraGWX"),0 )
call SaveReal(HH,GetHandleId( caster ),StringHash("GaaraGWY"),0 )
call SaveReal(HH,id,15,6*GetHeroInt(caster,true))
call TimerStart(t,0.02,true,function GaaraWGAct)
endif
// Gaara GR
if  LoadInteger(HH,GetHandleId( caster ),StringHash("GaaraGtype"))==3 then 
call SaveInteger(HH,GetHandleId( caster ),StringHash("GaaraGtype"),0)
if LoadUnitHandle(HH,GetHandleId(caster),StringHash("GaaraRU"))!=null then



call SaveReal(HH,id,11,GetUnitX(LoadUnitHandle(HH,GetHandleId(caster),StringHash("GaaraRU"))))
call SaveReal(HH,id,12,GetUnitY(LoadUnitHandle(HH,GetHandleId(caster),StringHash("GaaraRU"))))

set soundplay=CreateSound("Sound\\Music\\mp3Music\\GaaraRG1.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
if GaaraFly==true then
call SetUnitAnimationByIndex(caster,14)
else
call SetUnitAnimationByIndex(caster,5)
endif
call SaveReal(HH,id,15,5*GetHeroInt(caster,true))
call TimerStart(t,0.02,true,function GaaraRGAct)

else
call TimerStart(t,0.02,false,function GaaraGNullAct)
endif


endif





//Gaara G T 
if  LoadInteger(HH,GetHandleId( caster ),StringHash("GaaraGtype"))==4 then
call SaveInteger(HH,GetHandleId( caster ),StringHash("GaaraGtype"),0)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\GaaraTG.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)

if GaaraFly==true then
call SetUnitAnimationByIndex(caster,15)
else
call SetUnitAnimationByIndex(caster,9)
endif
call SaveGroupHandle(HH,id,4,CreateGroup())
call TimerStart(t,0.02,true,function GaaraTGAct)
endif



endif
set t=null
set caster=null
endfunction
function GaaraChoice_Cond takes nothing returns boolean
if  GetSpellAbilityId()=='ASGR' or GetSpellAbilityId()=='ASGG' then
return true
else
return false
endif
endfunction
function InitTrig_GaaraChoice takes nothing returns nothing
local trigger GaaraChoice=CreateTrigger()
local integer index
set index=0
loop
call TriggerRegisterPlayerUnitEvent(GaaraChoice,Player(index),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set index=index+1
exitwhen index==bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddCondition(GaaraChoice,Condition(function GaaraChoice_Cond))
call TriggerAddAction(GaaraChoice,function GaaraChoice_Act)
set GaaraChoice=null
set index=0
endfunction


//gaara fly



function GaaraFlyMove takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local real facing
local real time=LoadReal(HH,id,5)
set time=time+0.02
call SaveReal(HH,id,5,time)
if time==0.02 then
call CreateModeIndicatorForm(caster, "ReplaceableTextures\\CommandButtons\\BTNGaaraP.blp", 10)
call UnitAddType(caster,UNIT_TYPE_FLYING)
call UnitAddAbility(caster,'Amrf')
call SetUnitFlyHeight(caster,150,0)
call UnitRemoveAbility(caster,'Amrf')
call SaveBoolean(HH,GetHandleId(caster),StringHash("GaaraF"),true)
call SaveBoolean(HH,GetHandleId(caster),StringHash("GaaraFCD"),true)
call AddUnitAnimationProperties(caster,"alternate",true)
endif
if time<10 then
call SetUnitPathing(caster,false)
endif
if time==10 then
call SetUnitPathing(caster,true)
call UnitRemoveType(caster,UNIT_TYPE_FLYING)
call SetUnitFlyHeight(caster,0,0)
call SaveBoolean(HH,GetHandleId(caster),StringHash("GaaraF"),false)
call AddUnitAnimationProperties(caster,"alternate",false)
endif
if time==10.02 then
call CreateModeIndicatorForm(caster, "war3mapImported\\BTNGaara.blp", 19.98)
endif
if time>30 then
call SaveBoolean(HH,GetHandleId(caster),StringHash("GaaraFCD"),false)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
set caster=null
endfunction

function GaaraFlyAct takes unit caster0 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(HH,id,1,caster0)
call SetUnitPathing(caster0,false)
call TimerStart(t,0.02,true,function GaaraFlyMove)
set t=null
endfunction

function GaaraFlyAct0 takes nothing returns nothing
local unit caster=GetTriggerUnit()

if LoadBoolean(HH,GetHandleId(caster),StringHash("GaaraFCD"))==false and OrderId2String(GetUnitCurrentOrder(caster))=="patrol" and GetHeroLevel(caster)>=12 and GetUnitAbilityLevel(caster,'CBC2')==0 and GetUnitAbilityLevel(caster,'cbc3')==0  and GetUnitAbilityLevel(caster,'cbc5')==0  and GetUnitAbilityLevel(caster, 'cbc7')==0 and GetUnitAbilityLevel(caster, 'cbc8')==0 and GetUnitAbilityLevel(caster, 'cbc9')==0 then
call GaaraFlyAct(caster)
endif

set caster=null
endfunction
function GaaraFlyCond0 takes nothing returns boolean
return  GetUnitTypeId( GetTriggerUnit() )== 'H02R'
endfunction
function InitTrig_GaaraFly takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddCondition(t,Condition(function GaaraFlyCond0) )
call TriggerAddAction(t,function GaaraFlyAct0)


set t=null
endfunction

function GaaraFlyMoveAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster= LoadUnitHandle(HH,id,1)
local integer idu=GetHandleId(caster)
local integer str=StringHash("gafx")
local integer str1=StringHash("gafy")
local real x=GetUnitX(caster)
local real y=GetUnitY(caster)
local real x1=LoadReal(HH,idu,str)
local real y1=LoadReal(HH,idu,str1)
local real facing=Angle2(x,y,x1,y1)
local real speed=GetHeroInt(caster,true)*0.02*(1+SpeedRes*0.01)

if  OrderId2String(GetUnitCurrentOrder(caster))=="smart" and SR(x,y,x1,y1)>speed+10 and IsUnitPaused(caster)==false and  LoadBoolean(HH,idu,StringHash("GaaraF"))==true then//or time>=4
  //call SetUnitPathing(caster,false)
  set x=PolX(GetUnitX(caster),speed,facing)
  set y=PolY(GetUnitY(caster),speed,facing)
  if IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
    call SetUnitX(caster,x)
    call SetUnitY(caster,y)
  else
    call SetUnitX(caster,PolX(GetUnitX(caster),-speed*2,facing))
    call SetUnitY(caster,PolY(GetUnitY(caster),-speed*2,facing))
    //call SetUnitPathing(caster,true)
  endif

else

  call SaveBoolean(HH,idu,StringHash("GaaraFcond"),false )
  call PauseTimer(GetExpiredTimer())
  call FlushChildHashtable(HH,id)
  call DestroyTimer(GetExpiredTimer())
    
endif

set caster=null
endfunction

function GaaraFlyMoveStart takes nothing returns nothing

local unit caster = GetTriggerUnit()
local timer t 
local integer id
local real x=GetOrderPointX()
local real y=GetOrderPointY()
local real x1=GetUnitX(caster)
local real y1=GetUnitY(caster)
local integer str=StringHash("gafx")
local integer str1=StringHash("gafy")
local integer idu=GetHandleId(caster)
if x!=0 and y!=null and x1!=x and y1!=y then
  call SaveReal(HH,idu,str,x)
  call SaveReal(HH,idu,str1,y)
  call SetUnitPathing(caster,false)
  if LoadBoolean(HH,idu,StringHash("GaaraFcond"))==false then
    set t = CreateTimer()
    set id=GetHandleId(t)
    call SaveUnitHandle(HH,id,1,caster)
    call SaveBoolean(HH,idu,StringHash("GaaraFcond"),true)
    call TimerStart(t,0.02,true,function GaaraFlyMoveAct)
  endif   
endif
set t=null
set caster=null
endfunction

function GaaraFlyCond takes nothing returns boolean
return GetIssuedOrderId()==OrderId("smart")and LoadBoolean(HH,GetHandleId( GetTriggerUnit() ),StringHash("GaaraF"))==true
endfunction

function InitTrig_GaaraFlyMove takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddCondition(t,Condition(function GaaraFlyCond) )
call TriggerAddAction(t,function GaaraFlyMoveStart)

set t=null
endfunction
