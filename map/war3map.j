function GomasionsCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,3)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,8)
local real y1=LoadReal(h,id,9)
local real x2
local real a2
local real y2
local real a=Atan2(y1-y,x1-x)
local unit l__s
local real dmg=LoadReal(h,id,6)+(0.8+0.2*GetUnitAbilityLevel(u,'A0KH'))*GetHeroInt(u,true)*0.08
local real time=LoadReal(h, id, TIME_HASH)+0.04
local player p=GetOwningPlayer(u)
call SaveReal(h, id, TIME_HASH, time)
if GetUnitCurrentOrder(u)==OrderId("channel") and time<4 then
call SetUnitInvulnerable(u, true)
call GroupEnumUnitsInRange(G,x1,y1,450,Base)
set n=CreateUnit(p,0x65304650,x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'B001',0.3)
call SetUnitAnimation(n,"spell two")
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)and IsUnitIllusion(E)then
call KillUnit(E)
endif
if Condition_Base(p,E)and IsUnitType(E,UNIT_TYPE_HERO)then
set x2=GetUnitX(E)
set y2=GetUnitY(E)
set a2=Atan2(y2-y1,x2-x1)
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetUnitX(E,x2-52*Cos(a2))
call SetUnitY(E,y2-52*Sin(a2))
if GetUnitAbilityLevel(E,0x4230344B)==0 then
call SetControlToUnit(u,E,1.2,"silence")
endif
endif
call GroupRemoveUnit(G,E)
endloop
else
call SetUnitInvulnerable(u, false)
call PauseTimer(t)
call DestroyTimer(t)
call RemoveUnit(LoadUnitHandle(h,id,2))
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
endif
set l__s=null
set p=null
set l__d=null
set u=null
set t=null
endfunction
