function GoshikitoCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real dmg=75+(1+GetUnitAbilityLevel(u,'A1AI'))*GetHeroInt(u,true)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real a=LoadReal(h,id,3)
local real dist=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,9)
local integer l__idg=GetHandleId(g)
if dist<2500 and GetWidgetLife(l__d)>0 then
set x=x+50*Cos(a)
set y=y+50*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SaveReal(h,id,2,dist+50)
set n=CreateUnit(p,'e10J',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,25)
call SetUnitTimeScale(n,3)
call SetUnitFlyHeight(n,150,0)
call SetUnitScale(n,2.5,2.5,2.5)
call UnitApplyTimedLife(n,'BTLF',0.3)
set n=CreateUnit(p,'e10K',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,255)
call SetUnitTimeScale(n,15)
call SetUnitFlyHeight(n,150,0)
call SetUnitScale(n,8,8,8)
call UnitApplyTimedLife(n,'BTLF',0.5)
call GroupEnumUnitsInRange(G,x,y,225,Base)
loop
set E=FirstOfGroup(G)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,ide)then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",E,"chest"))
call SaveUnitHandle(h,l__idg,ide,E)
if GetUnitAbilityLevel(E,'A1AH')>0 then
call myCustomDamage(u,E,dmg*1.25,false,false,null,null,null)
set n=CreateUnit(p,'h019',x,y,a*bj_RADTODEG)
call UnitAddAbility(n,'A1AM')
call SetUnitAbilityLevel(n,'A1AM',1)
call UnitApplyTimedLife(n,'BHwe',1)
call IssueTargetOrder(n,"drunkenhaze",E)
else
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
endif
call GroupRemoveUnit(G,E)
endloop
else
call SetUnitTimeScale(u,1)
call GroupClear(g)
call DestroyGroup(g)
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
set l__d=null
set g=null
set u=null
set p=null
set t=null
endfunction
function GoshikitoCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
call SaveUnitHandle(h,id,0,u)
set n=CreateUnit(p,'e10I',x+25*Cos(a),y+25*Sin(a),a*bj_RADTODEG)
call SaveUnitHandle(h,id,1,n)
call SaveReal(h,id,2,0)
call SaveReal(h,id,3,a)
call SaveGroupHandle(h,id,9,CreateGroup())
call SetUnitTimeScale(u,4)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG-45)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+45)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set soundplay=SndN(2566) // Sound\Music\mp3Music\Doflamingo1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.02,true,function GoshikitoCast2)
set u=null
set p=null
set t=null
endfunction
