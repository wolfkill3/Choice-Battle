endfunction
function FallenAngelCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real time=LoadReal(h,id,2)
local real x=LoadReal(h,id,5)
local real y=LoadReal(h,id,6)
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(p)
local group g=LoadGroupHandle(h,id,8)
if time<5 then
call GroupEnumUnitsInRange(G,x,y,500,Base)
loop
set E=FirstOfGroup(G)
if Condition_Base(p,E)then
set n=CreateUnit(p,'h019',x,y,0)
call UnitAddAbility(n,'A0LO')
call SetUnitAbilityLevel(n,'A0LO',1)
call UnitApplyTimedLife(n,'BHwe',1)
call IssueTargetOrder(n,"thunderbolt",E)
if IsUnitInGroup(E,g)==false then
call SetUnitTimeScale(E,0)
call GroupAddUnit(g,E)
endif
endif
call GroupRemoveUnit(G,E)
exitwhen E==null
endloop
call SaveReal(h,id,2,time+0.1)
else
loop
set E=FirstOfGroup(g)
exitwhen E==null
call SetUnitTimeScale(E,1)
call GroupRemoveUnit(g,E)
endloop
call PauseTimer(t)
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set t=null
set u=null
set g=null
endfunction
