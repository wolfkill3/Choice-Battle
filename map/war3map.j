function EndOfChoiceAct takes nothing returns nothing
    local integer he=0
    local integer is=0
    local unit gon
    local item array it
    local integer i
    local integer j
    set i=0
    loop
    exitwhen(i>12)
    set j=0
    loop
    exitwhen(j>12)
    call SaveInteger(HPlayer,i+20,j+20,0)
    set j=j+1
    endloop
    set i=i+1
    endloop
    set i=0
    set j=0
    set round=round+1
    set udg_B=false
    call DisableTrigger(gg_trg_KingOfHill_Enter)
    call DisableTrigger(gg_trg_Tower_Enter)
    call SetUnitOwner(TowerUnit,Player(PLAYER_NEUTRAL_PASSIVE),false)
    call DisableTrigger(gg_trg_Fountain_Enter)
    call DestroyEffect(KingOfHill)
    call DestroyEffect(Tower)
    call DestroyEffect(Fountain)
    if FFAMode==false then
        if round<=2 then
            set passedTime=-5
            set HealRes=0
            set SpeedRes=0
        elseif round>2 and round<=4 then
            set passedTime=-6
            set HealRes=0
            set SpeedRes=0
        elseif round>4 and round<=6 then
            set passedTime=-7
            set HealRes=0
            set SpeedRes=0
        elseif round>6 then
            set passedTime=-8
            set HealRes=0
            set SpeedRes=0
        endif
    else
        if round<=2 then
            set passedTime=-0
            set HealRes=0
            set SpeedRes=0
        elseif round>2 and round<=4 then
            set passedTime=-1
            set HealRes=0
            set SpeedRes=0
        elseif round>4 and round<=6 then
            set passedTime=-2
            set HealRes=0
            set SpeedRes=0
        elseif round>6 and round<=8 then
            set passedTime=-3
            set HealRes=0
            set SpeedRes=0
        elseif round>8 then
            set passedTime=-4
            set HealRes=0
            set SpeedRes=0
        endif
    endif
        // if round==1 then
        // call UIS_RegisterItem('I02R','I035','I06N',0,0,0,'I068') //grail
        // endif
    call SetAbilityBaseRealLevelFieldById('Aneu',ABILITY_RLF_CAST_RANGE,0,2000)
    call SetAbilityBaseRealLevelFieldById('Aneu',ABILITY_RLF_ACTIVATION_RADIUS,0,2500)
    // call SetAbilityBaseIntegerFieldById('A0LH',ABILITY_ILF_HIT_POINTS_REGENERATED_PER_SECOND,30+round*2)
    // call SetAbilityBaseIntegerFieldById('A26P',ABILITY_ILF_AGILITY_BONUS,20+round)
    // call SetAbilityBaseIntegerFieldById('A26P',ABILITY_ILF_INTELLIGENCE_BONUS,20+round)
    // call SetAbilityBaseIntegerFieldById('A26P',ABILITY_ILF_STRENGTH_BONUS_ISTR,20+round)
    // call SetAbilityBaseIntegerFieldById('A0PH',ABILITY_ILF_DAMAGE_PER_DURATION,12+round*2)
    call PauseTimer(TD2)
    call PauseTimer(TD3)
    call PauseTimer(TD4)
    if TC==false then
        if FFAMode==false then
            if GroupIsDeath(udg_CG[2]) then
                set he=0
                set win[1]=win[1]+1
                set win2=1
                loop
                exitwhen he==4
                    if round>5 then
                        call SetPlayerState(Player(he),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(he),PLAYER_STATE_RESOURCE_GOLD)+150)
                    endif
                    call W3MMD_Lite_Set_Integer(Player(he),"Won_rounds",win[1])
                    call SetPlayerState(Player(he),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(Player(he),PLAYER_STATE_RESOURCE_LUMBER)+1)
                    set he=he+1
                endloop
                if round>5 then
                    call DisplayTextToPlayer(GetLocalPlayer(),0,0,Lng("Побеждает первая команда и получает дополнительное вознаграждение в виде 150 ед. золота","The first team wins and receives an additional reward in the form of 150 units. gold"))
                else
                    call DisplayTextToPlayer(GetLocalPlayer(),0,0,Lng("Побеждает первая команда.","The first team wins."))
                endif
            elseif GroupIsDeath(udg_CG[1]) then
                set he=5
                set win[2]=win[2]+1
                set win2=2
                loop
                exitwhen he==9
                    if round>5 then
                        call SetPlayerState(Player(he),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(he),PLAYER_STATE_RESOURCE_GOLD)+150)
                    endif
                    call W3MMD_Lite_Set_Integer(Player(he),"Won_rounds",win[2])
                    call SetPlayerState(Player(he),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(Player(he),PLAYER_STATE_RESOURCE_LUMBER)+1)
                    set he=he+1
                endloop
                if round>5 then
                    call DisplayTextToPlayer(GetLocalPlayer(),0,0,Lng("Побеждает вторая команда и получает дополнительное вознаграждение в виде 150 ед. золота","The second team wins and receives an additional reward in the form of 150 units. gold"))
                else
                    call DisplayTextToPlayer(GetLocalPlayer(),0,0,Lng("Побеждает вторая команда","Second team wins"))
                endif
            endif
        else
            set i=GetPlayerId(GetOwningPlayer(GroupAliveUnit(udg_CG[4])))
            set win[i]=win[i]+1
            call W3MMD_Lite_Set_Integer(Player(i),"Won_rounds",win[i])
            set win2=i
            call SetPlayerState(Player(i),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(Player(i),PLAYER_STATE_RESOURCE_LUMBER)+1)
            call DisplayTextToPlayer(GetLocalPlayer(),0,0,Lng("Побеждает ","wins")+Color[i]+GetPlayerName(Player(i)))
            set i=0
        endif
    else
        call DisplayTextToPlayer(GetLocalPlayer(),0,0,Lng("Ничья.","Draw."))
        set win2=0
    endif
    set n=GetTriggerUnit()
    if GetUnitAbilityLevel(n,'A0YT')>0 then
        call SetUnitOwner(n,LoadPlayerHandle(h,GetHandleId(n),SH_CS),true)
        call UnitRemoveAbility(n,'A0YT')
    endif
    call GroupEnumUnitsInRect(G,bj_mapInitialPlayableArea,FrendaBool)
    loop
    set E=FirstOfGroup(G)
    exitwhen E==null
    call RemoveUnit(E)
    call GroupRemoveUnit(G,E)
    endloop
    if round<3 then
        call DisplayTextToPlayer(GetLocalPlayer(),0,0,Lng("Передача золота ограничена. Лимит на передачу на игрока - 500","Gold transfer is limited. Transfer limit per player - 500"))
    elseif round>=3 and round<15 then
        call DisplayTextToPlayer(GetLocalPlayer(),0,0,Lng("Передача золота ограничена. Лимит на передачу на игрока - 1000","Gold transfer is limited. Transfer limit per player - 1000"))
    elseif round>15 then
        call DisplayTextToPlayer(GetLocalPlayer(),0,0,Lng("Передача золота больше не ограничена.","Gold transfer is no longer limited."))
    endif
    loop
    exitwhen i>9
        if round<3 then
        set GoldLimit[i]=500
        set GoldTotalLimit[i]=500
        elseif round>=3 and round<15 then
        set GoldLimit[i]=1000
        set GoldTotalLimit[i]=1000
        else
        set GoldLimit[i]=100000
        set GoldTotalLimit[i]=100000
        endif
        set lucy[i]=false
        call CreateFogModifierRect(Player(i),FOG_OF_WAR_FOGGED,gg_rct_GameZone,true,true)
        call W3mmdPlayercheck(Hero[i])
        call UnitRemoveAbility(Hero[i],'BOhx')
        call UnitRemoveAbility(Hero[i],'BO3E')
        call UnitRemoveAbility(Hero[i],'A0QL')
        call UnitRemoveAbility(Hero[i],'A1DH')
        call UnitRemoveAbility(Hero[i],'A0IH')
        call UnitRemoveAbility(Hero[i],'A2IH')
        call UnitRemoveAbility(Hero[i],'A3IH')
        call UnitRemoveAbility(Hero[i],'A13O')
        call UnitRemoveAbility(Hero[i],'B05L')
        call UnitRemoveAbility(Hero[i],'B05M')
        call UnitRemoveAbility(Hero[i],'B05N')
        call UnitRemoveAbility(Hero[i],'A13U')
        call UnitRemoveAbility(Hero[i],'A1FA')
        call UnitRemoveAbility(Hero[i],'A1F9')
        call UnitRemoveAbility(Hero[i],'ore3')
        call UnitRemoveAbility(Hero[i],'OM17')
        call UnitRemoveAbility(Hero[i],'A1GS')
        call UnitRemoveAbility(Hero[i],'A13S')
        call UnitRemoveAbility(Hero[i],'A13T')
        call UnitRemoveAbility(Hero[i],'A13U')
        call UnitRemoveAbility(Hero[i],'A1H1')
        call UnitRemoveAbility(Hero[i],'A0VV')
        call UnitRemoveAbility(Hero[i],'A28W')
        call UnitRemoveAbility(Hero[i],'A149')
        call UnitRemoveAbility(Hero[i],'A16I')
        call SaveInteger(HH, GetHandleId(Hero[i]), SH_GinT_Stack, 0)
        call SaveInteger(HH, GetHandleId(Hero[i]), SH_KHE_Stack, 0)
        call SaveReal(HH,GetHandleId(Darkness[i]),SH_darkHP,LoadReal(HH,GetHandleId(Darkness[i]),SH_darkMaxHP))
        call UnitRemoveAbility(Hero[i], 'YuFe')
        call UnitRemoveAbility(Hero[i], 'A06R') //Темный Экскалибур
        call UnitRemoveAbility(Hero[i], 'A26R') //Темный Экскалибур Гильгамеш
        call UnitRemoveAbility(Hero[i], 'MaDu') //Используемые стаки D Madoka
        call UnitRemoveAbility(Hero[i], 'MaDb')
        call UnitRemoveAbility(Hero[i], 'AP06') //Enkidu Q
        if GetUnitAbilityLevel(Hero[i], 'MaDs')>0 then
            call SetUnitAbilityLevel(Hero[i], 'MaDs', 1)
        endif
        call IssueImmediateOrder(Hero[i], "stop")
        call ShowAbility2Timed('A10B',true,1.33)
        call ShowAbility2Timed('A20B',false,1.32)
        call ShowAbility2Timed('A30B',false,1.32)
        call SetBuffDispellable(GetUnitBuff( Hero[i], 'B06L' ),false)
        call SetBuffDispellable(GetUnitBuff( Hero[i], 'B16L' ),false)
        call ShowAbility2('TMW0',true)
        call ShowAbility2('A0J5',true)
        call GroupRemoveUnit(LoadGroupHandle(h,GetHandleId(Hero[i]),SH_katsuya),Hero[i])
        call UnitRemoveBuffs(Hero[i],true,true)
        call GroupEnumUnitsOfPlayer(G,Player(i),BuggedBool) //lvlbool
        loop
        set E=FirstOfGroup(G)
        exitwhen E==null
                call SetUnitPosition(E,RX,RY)
                if GetUnitTypeId(E)=='ewsp' then
                        call RemoveUnit(E)
                endif
                call GroupRemoveUnit(G,E)
        endloop
        if GetUnitTypeId(Hero[i])=='H04F' then//
                call SaveInteger(HH,GetHandleId(Hero[i]),SH_recall,2)
        endif
        call UnitRemoveAbility(Hero[i],'A0WR')
        call SetHeroLevel(Hero[i],GetHeroLevel(Hero[i])+3,true)
        call SetUnitMoveSpeed(Hero[i], GetUnitDefaultMoveSpeed(Hero[i]))
        if round>5 then
            call SetPlayerState(Player(i),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(i),PLAYER_STATE_RESOURCE_GOLD)+1250)
        else
            call SetPlayerState(Player(i),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(i),PLAYER_STATE_RESOURCE_GOLD)+1000)
        endif
        if noduels==true and ModuloInteger(round,duelround)==0 then
            call SetPlayerState(Player(i),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(i),PLAYER_STATE_RESOURCE_GOLD)+250)
            call DisplayTextToPlayer(Player(i),0,0,Lng("Дуэли отключены, поэтому каждый игрок получает компенсацию в 250 ед. золотых","Duels are disabled, so each player is compensated with 250 units. gold"))
        endif
        if GetPlayerState(Player(i),PLAYER_STATE_LUMBER_GATHERED)>=udg_rou then
            call CustomVictoryBJ(Player(i),true,true)
            set GameEnd=true
        endif
        if UnitIsAlive(Hero[i])==false then
            call ReviveHero(Hero[i],RX,RY,false)
            call SetUnitControlCount(Hero[i], 11,0)
        endif
        if GetUnitTypeId(Hero[i]) == 'H069' then
            call SaveReal(HH,GetHandleId(GetOwningPlayer(Hero[i])),SH_CE,0)
        endif
        if GetUnitTypeId(Hero[i]) == 'Hbel' then        // Бельфегор очистка лесок и удаление группы
            call ClearGroupBelfegorMark(Hero[i])
        endif
        if GetUnitTypeId(Hero[i])=='H04T' then
            call SinonAmmo_Create(Hero[i])
            call SaveInteger(HH, GetHandleId(Hero[i]), Sinon_Ammo, 7) // Обновление магазина Синон
        endif
                //блекгоку конец раунда
        if GetUnitTypeId(Hero[i])=='HBGN' then
            call SaveReal(HH,GetHandleId( Hero[i] ),BGRageHash,GetHeroStr(Hero[i],true)*12)
            call SaveReal(HH,GetHandleId( Hero[i] ),BGRageBHash,GetHeroStr(Hero[i],true)*12)
            call SaveBoolean(HH,GetHandleId( Hero[i] ),SH_BGRageBool,false)
            call SaveInteger(HH,GetHandleId( Hero[i] ),BGRageIHash,0)
            call SaveBoolean(HH,GetHandleId( Hero[i] ),SH_BGG,false)
            call SaveBoolean(HH,GetHandleId( Hero[i] ),SH_BGRose,false)
            call UnitRemoveAbility( Hero[i],'ABG1')
            call UnitAddAbility( Hero[i],'ABG0')
            call SetPlayerAbilityAvailable(GetOwningPlayer( Hero[i] ),'BGG2',false)
            call SetPlayerAbilityAvailable(GetOwningPlayer( Hero[i] ),'BGG1',true)
            call SetUnitAbilityLevel( Hero[i],'BGC1',1)
        endif
        if GetUnitTypeId(Hero[i])=='HMad' or GetUnitTypeId(Hero[i])=='HMaG' then
            call SaveReal(HH,GetHandleId( Hero[i] ),MadokaDHash,0)
            call SaveReal(HH,GetHandleId( Hero[i] ),MadokaTDHash,4000+round*100)
            call SaveReal(HH,GetHandleId( Hero[i] ),MadokaHHash,0)
            call SaveReal(HH,GetHandleId( Hero[i] ),MadokaTHHash,2000+round*50)
            call SaveInteger(HH,GetHandleId( Hero[i] ),MadokaMHash,0)
        endif
        if LoadBoolean(HH,GetHandleId(Hero[i]),'ShSt') then
            call SaveBoolean(HH,GetHandleId(Hero[i]),'ShSt',false)
            call SetHeroStr(Hero[i],GetHeroStr(Hero[i],false)+LoadInteger(HH,GetHandleId(Hero[i]),'ShSA'),true)
            call SetHeroAgi(Hero[i],GetHeroAgi(Hero[i],false)+LoadInteger(HH,GetHandleId(Hero[i]),'ShAA'),true)
            call SetHeroInt(Hero[i],GetHeroInt(Hero[i],false)+LoadInteger(HH,GetHandleId(Hero[i]),'ShIA'),true)
            call SaveInteger(HH,GetHandleId(Hero[i]),'ShSA',0)
            call SaveInteger(HH,GetHandleId(Hero[i]),'ShAA',0)
            call SaveInteger(HH,GetHandleId(Hero[i]),'ShIA',0)
            call DestroyImage(GetUnitImage(Hero[i],3))
            call SetUnitImage(Hero[i],3,LoadImageHandle(HH,GetHandleId(Hero[i]),'ShIm'))
            call SetImageRender(GetUnitImage(Hero[i],3),true)
            call SetImageRenderAlways(GetUnitImage(Hero[i],3),true)
            call ShowImage(GetUnitImage(Hero[i],3),true)
            call RemoveSavedHandle(HH,GetHandleId(Hero[i]),'ShIm')
        endif
        if LoadInteger(HH,GetHandleId(Hero[i]),'SSG+')>0 then
            call SetHeroStr(Hero[i],GetHeroStr(Hero[i],false)-LoadInteger(HH,GetHandleId(Hero[i]),'SSG+'),true)
            call SetHeroAgi(Hero[i],GetHeroAgi(Hero[i],false)-LoadInteger(HH,GetHandleId(Hero[i]),'SAG+'),true)
            call SetHeroInt(Hero[i],GetHeroInt(Hero[i],false)-LoadInteger(HH,GetHandleId(Hero[i]),'SIG+'),true)
            call SaveInteger(HH,GetHandleId(Hero[i]),'SSG+',0)
            call SaveInteger(HH,GetHandleId(Hero[i]),'SAG+',0)
            call SaveInteger(HH,GetHandleId(Hero[i]),'SIG+',0)
        endif
        if GetUnitTypeId(Hero[i])=='H00P' or GetUnitTypeId(Hero[i])=='H00V' then
            set j=LoadInteger(HH,GetHandleId(GetOwningPlayer(Hero[i])),'ShSn')
            loop
            exitwhen j==0
                call RemoveSavedHandle(HH,GetHandleId(GetOwningPlayer(Hero[i])),'ShPS'+j)
                call RemoveSavedHandle(HH,GetHandleId(GetOwningPlayer(Hero[i])),'ShNT'+j)
                call SaveInteger(HH,GetHandleId(GetOwningPlayer(Hero[i])),'ShSA'+j,0)
                call SaveInteger(HH,GetHandleId(GetOwningPlayer(Hero[i])),'ShAA'+j,0)
                call SaveInteger(HH,GetHandleId(GetOwningPlayer(Hero[i])),'ShIA'+j,0)
                call SaveStr(HH,GetHandleId(GetOwningPlayer(Hero[i])),'ShNP'+j,null)
                set j=j-1
            endloop    
            call SaveInteger(HH,GetHandleId(GetOwningPlayer(Hero[i])),'ShSn',0)
        endif
        //блекгоку конец раунда
        if GetUnitTypeId(Hero[i]) == 'H35Z' then
            call UnitRemoveAbility(Hero[i], 'YoF1')
            call ShowAbility2( 'YoF0', true)
        endif
        call RemoveTransformation(Hero[i])
        call SetUnitTargetable(Hero[i],true)
        if GetUnitTypeId(Hero[i]) == 'H00H' and GetUnitAbilityLevel(Hero[i],'A1A3')>0 then
            call SaveReal(HH,GetHandleId(Hero[i]),TIME_HASH,45)
        endif
        call SaveBoolean(HH,GetHandleId(Hero[i]),SS,false)
        call SaveBoolean(HH,GetHandleId(Hero[i]),SST,false)
        call SaveInteger(HH,GetHandleId(Hero[i]),ROYAL_GUARD_STACKS,0)
        call SetUnitVertexColor(Hero[i],255,255,255,255)
        call UnitRemoveAbility(Hero[i],'A28U')
        if GetUnitTypeId(Hero[i])=='H21M' then 
            call SetUnitVertexColor(Hero[i],255,255,255,255)
            call UnitRemoveAbility(Hero[i],'A28U')
            call ShowAbility2('A2DM',false)
            call ShowAbility2('A2CZ',false)
            call UnitAddAbility(Hero[i], 'S211')
            call IssueImmediateOrder(Hero[i], "bearform")
            call UnitRemoveAbility(Hero[i], 'S211')
            call SetUnitAbilityLevel(Hero[i],'A0D4',1)
            call ShowAbility2('A0DM',true)
            call ShowAbility2('A0CZ',true)
        elseif GetUnitTypeId(Hero[i])=='H21N' then
            call SetUnitVertexColor(Hero[i],255,255,255,255)
            call UnitRemoveAbility(Hero[i],'A28U')
            call ShowAbility2('A2DM',false)
            call ShowAbility2('A2CZ',false)
            call UnitAddAbility(Hero[i], 'S221')
            call IssueImmediateOrder(Hero[i], "bearform")
            call UnitRemoveAbility(Hero[i], 'S221')
            call SetUnitAbilityLevel(Hero[i],'A0D4',2)
            call ShowAbility2('A0DM',true)
            call ShowAbility2('A0CZ',true)
        endif
        set rfhr[i]=1
        if GetUnitTypeId(Hero[i])=='H04B' then          // Gon Откат T
            call PauseUnit(Hero[i],false)
            call UnitRemoveBuffs(Hero[i],false,true)
            call ShowAbility2('A23V',false)
            call ShowAbility2Timed('A13V',true,0.1)
            call UnitAddAbility(Hero[i],'S005')
            call IssueImmediateOrder(Hero[i], "bearform")
            call UnitRemoveAbility(Hero[i],'S005')
            call SetUnitAbilityLevel(Hero[i],'A0U8',1)
            // set n=CreateUnit(GetOwningPlayer(Hero[i]),'H04A',GetRectCenterX(gg_rct_Resp7),GetRectCenterY(gg_rct_Resp7),0)
            // set gon=Hero[i]
            // set Gon=n
            // set Hero[i]=n
            // set udg_Hero[i+1]=n
            // if GetHeroLevel(gon)>1 then
                    // call SetHeroLevel(n,GetHeroLevel(gon),false)
            // endif
            // loop
            // exitwhen is==6
                    // set it[is]=UnitItemInSlot(gon,is)
                    // set is=is+1
            // endloop
            // if GetPlayerId(GetOwningPlayer(n))<5 then//
                    // call GroupAddUnit(udg_CG[1],n)
            // elseif GetPlayerId(GetOwningPlayer(n))>=5 and GetPlayerId(GetOwningPlayer(n))<10 then
                    // call GroupAddUnit(udg_CG[2],n)
            // endif
            // set is=0
            // loop
            // exitwhen is==6
                    // if GetItemTypeId(it[is])!='I03S' and GetItemTypeId(it[is])!='I13S' then
                            // call UnitAddItemById(n,GetItemTypeId(it[is]))
                    // endif
                    // set is=is+1
            // endloop
            // call RemoveUnit(gon)
            // if GetLocalPlayer()==Player(i)then
                    // call ClearSelection()
                    // call SelectUnit(n,true)
            // endif
        endif
        if Player(i)==GetLocalPlayer()then
            call ClearSelection()
            call SelectUnit(Hero[i],true)
        endif
        call CheckUnitBonusRange(Hero[i])
        if GetUnitTypeId(Hero[i])=='HJi1' then
            call SetUnitModel(Hero[i],"[By XeSHTeG]JirenBase.mdx")
            call ShowAbility2('JNF4',false)
            call ShowAbility2('JNF1',true)
            call SetAbilityRealLevelField(GetUnitAbility(Hero[i],'JNG1'), ABILITY_RLF_CAST_RANGE,0,400)
            call UnitRemoveAbility(Hero[i],'JNF2')
            call UnitRemoveAbility(Hero[i],'JNF3')
        endif
        if GetUnitTypeId(Hero[i])=='H02H' then
            call SaveInteger(HH,GetHandleId( GetOwningPlayer(Hero[i]) ),KaiokenHash,0)
            call SetUnitModel(Hero[i],"GokuFull.mdx")
            call SaveInteger(HH,GetHandleId( GetOwningPlayer(Hero[i]) ),MUIDodgeCountHash,0)
            if GetHeroLevel(Hero[i])>=26 then
                if LoadBoolean(HH,GetHandleId( GetOwningPlayer(Hero[i]) ),UIAvailableHash)==false then
                    call SaveReal(HH,GetHandleId( GetOwningPlayer(Hero[i]) ),UIDMGHash,0)
                    call SaveReal(HH,GetHandleId( GetOwningPlayer(Hero[i]) ),UILimitDMGHash,GetUnitMaxLife(Hero[i])*2)
                endif
            endif
        endif
        call SetUnitTimeScale(Hero[i],1)
        call UnitAddType(Hero[i],UNIT_TYPE_ETHEREAL)
        call UnitRemoveType(Hero[i],UNIT_TYPE_ETHEREAL)
        call UnitAddAbility(Hero[i],'Agho')
        call UnitRemoveAbility(Hero[i],'Agho')
        call UnitAddAbility(Hero[i],'A00D')
        call UnitRemoveAbility(Hero[i],'A00D')
        call IssueImmediateOrder(Hero[i],"unimmolation")
        call SetUnitFlyHeight(Hero[i],0,0)
        call GroupClear(udg_KG[i])
        set i=i+1
    endloop
    if GetPlayerState(Player(0),PLAYER_STATE_LUMBER_GATHERED)>=udg_rou or GetPlayerState(Player(5),PLAYER_STATE_LUMBER_GATHERED)>=udg_rou  then
        set GameEnd=true
    endif
    if GameEnd then
        call ClickFrame(OpenStatsButton)
    endif
    set i=0
    loop
    exitwhen i>9
    if GetPlayerState(Player(i),PLAYER_STATE_LUMBER_GATHERED)>=udg_rou then
        call CustomVictoryBJ(Player(i),true,true)
        set GameEnd=true
    endif
    set i=i+1
    endloop
    if GameEnd==true then
        call DestroyTimer(udg_Timer)
        call DestroyTimerDialog(udg_TB)
        set i=0
        loop
        exitwhen i>9
        if GetPlayerState(Player(i),PLAYER_STATE_LUMBER_GATHERED)<udg_rou then
                    call CustomDefeatBJ(Player(i),Lng("Вы Проиграли!","You lose!"))
        endif
        set i=i+1
        endloop
    else
        call DestroyTimerDialog(udg_TB)
        call DestroyTimerDialog(TG)
        if FFAMode==false then
        call TimerStart(udg_Timer2,0.05,false,function EndOfChoiceAct2)
        else
        call TimerStart(udg_Timer2,0.05,false,function EndOfChoiceAct3)
        endif
        call TimerStart(udg_Timer,40,false,null)
        set udg_TB=CreateTimerDialog(udg_Timer)
        call LANG_TdTitle(udg_TB,"До начала раунда осталось:","Until the start of the round left:")
        call TimerDialogDisplay(udg_TB,true)
    endif
    call UpdateMultiboard()
    set Rounds=true
    if FFAMode==false then
    if win[1]>=udg_rou then
    call ClickFrame(OpenStatsButton)
    call DisplayTextToPlayer(GetLocalPlayer(),0,0,"TEAM 1 wins the game")
    call TriggerClearActions(LoadTriggerHandle( W3MMDTable, GetHandleId( W3MMDTable ), SH_GetLeaveTrig ))
    set i=0
    loop
    exitwhen i>9
    if i<5 then
    call W3MMD_Lite_Flag_Winner( Player(i) )
    else
    call W3MMD_Lite_Flag_Loser( Player(i) )
    endif
    set i=i+1
    endloop
    //call CustomVictoryBJ(Player(0),true,true)
    //call CustomVictoryBJ(Player(1),true,true)
    //call CustomVictoryBJ(Player(2),true,true)
    //call CustomVictoryBJ(Player(3),true,true)
    //call CustomVictoryBJ(Player(4),true,true)
    //call CustomDefeatBJ(Player(5),"Вы проиграли!")
    //call CustomDefeatBJ(Player(6),"Вы проиграли!")
    //call CustomDefeatBJ(Player(7),"Вы проиграли!")
    //call CustomDefeatBJ(Player(8),"Вы проиграли!")
    //call CustomDefeatBJ(Player(9),"Вы проиграли!")
    call DestroyTimer(udg_Timer)
    call DestroyTimerDialog(udg_TB)
    elseif win[2]>=udg_rou then
    call ClickFrame(OpenStatsButton)
    call DisplayTextToPlayer(GetLocalPlayer(),0,0,"TEAM 2 wins the game")
    call TriggerClearActions(LoadTriggerHandle( W3MMDTable, GetHandleId( W3MMDTable ), SH_GetLeaveTrig ))
    set i=0
    loop
    exitwhen i>9
    if i<5 then
    call W3MMD_Lite_Flag_Loser( Player(i) )
    else
    call W3MMD_Lite_Flag_Winner( Player(i) )
    endif
    set i=i+1
    endloop
    //call CustomDefeatBJ(Player(0),"Вы проиграли!")
    //call CustomDefeatBJ(Player(1),"Вы проиграли!")
    //call CustomDefeatBJ(Player(2),"Вы проиграли!")
    //call CustomDefeatBJ(Player(3),"Вы проиграли!")
    //call CustomDefeatBJ(Player(4),"Вы проиграли!")
    //call CustomVictoryBJ(Player(5),true,true)
    //call CustomVictoryBJ(Player(6),true,true)
    //call CustomVictoryBJ(Player(7),true,true)
    //call CustomVictoryBJ(Player(8),true,true)
    //call CustomVictoryBJ(Player(9),true,true)
    call DestroyTimer(udg_Timer)
    call DestroyTimerDialog(udg_TB)
    elseif win[3]>=udg_rou then
    call ClickFrame(OpenStatsButton)
    //call CustomDefeatBJ(Player(0),"Вы проиграли!")
    //call CustomDefeatBJ(Player(1),"Вы проиграли!")
    //call CustomDefeatBJ(Player(2),"Вы проиграли!")
    //call CustomDefeatBJ(Player(3),"Вы проиграли!")
    //call CustomDefeatBJ(Player(4),"Вы проиграли!")
    //call CustomDefeatBJ(Player(5),"Вы проиграли!")
    //call CustomDefeatBJ(Player(6),"Вы проиграли!")
    //call CustomDefeatBJ(Player(7),"Вы проиграли!")
    //call CustomVictoryBJ(Player(8),true,true)
    //call CustomVictoryBJ(Player(9),true,true)
    //call CustomVictoryBJ(Player(10),true,true)
    //call CustomVictoryBJ(Player(11),true,true)
    call DestroyTimer(udg_Timer)
    call DestroyTimerDialog(udg_TB)
    endif
    else
    set he=1
    loop
    if win[he]>=udg_rou then
    call ClickFrame(OpenStatsButton)
    call DestroyTimer(udg_Timer)
    call DestroyTimerDialog(udg_TB)
    call DisplayTextToPlayer(GetLocalPlayer(),0,0,GetPlayerName(Player(he))+" wins FFA Match")
    call TriggerClearActions(LoadTriggerHandle( W3MMDTable, GetHandleId( W3MMDTable ), SH_GetLeaveTrig ))
    if udg_test==false then
    endif
    set i=0
    loop
    exitwhen i>9
    if i+1!=he then
    call W3MMD_Lite_Flag_Loser( Player(i) )
    else
    call W3MMD_Lite_Flag_Winner( Player(i) )
    endif
    set i=i+1
    endloop
    //if GetPlayerId(GetLocalPlayer())!=he then
    //call CustomDefeatBJ(GetLocalPlayer(),"Вы проиграли!")
    //else
    //call CustomVictoryBJ(Player(he),true,true)
    //endif
    endif
    exitwhen he==10
    set he=he+1
    endloop
    endif
    set gon=null
    call UpdateMultiboard()
endfunction
function EndOfChoiceInit takes nothing returns nothing
local integer i=0
set eoc=CreateTrigger()
loop
call TriggerRegisterPlayerUnitEvent(eoc,Player(i),EVENT_PLAYER_UNIT_DEATH,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(eoc,function EndOfChoiceAct)
call TriggerAddCondition(eoc,Condition(function EndOfChoiceCond))
endfunction
function ResistReductionFunction2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer i=0
    if udg_B==true or DU==false then
        set passedTime=passedTime+1
        if HealRes>-90 then
            set HealRes=HealRes-5
        endif
        if SpeedRes>-90 then
            set SpeedRes=SpeedRes-10
        endif
        call UpdateMultiboard()
    else
        call PauseTimer(t)
        call DestroyTimer(t)
    endif
    set t=null
endfunction
function ResistReductionFunction takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer i=0
    call PauseTimer(t)
    call DisplayTextToPlayer(GetLocalPlayer(),0,0,Lng("Deathmatch! Началось глобальное уменьшение скорости полётов, восстановления здоровья и магического сопротивления.","Deathmatch! Global reduction of flight speed, health regeneration and magic resistance has begun."))
    if passedTime<15 then
    set passedTime=passedTime+1
    endif
    set HealRes=HealRes-5
    set SpeedRes=SpeedRes-10
    loop
    exitwhen i>12
    call CreateFogModifierRect(Player(i),FOG_OF_WAR_VISIBLE,gg_rct_GameZone,true,true)
    set i=i+1
    endloop
    call UpdateMultiboard()
    call TimerStart(t,15,true,function ResistReductionFunction2)
    set t=null
endfunction
function KingOfHillActivation takes nothing returns nothing
    local timer t=GetExpiredTimer()
    call PauseTimer(t)
    if DU2==true then
        call DisplayTextToPlayer(GetLocalPlayer(),0,0,Lng("Активирован режим \"Царь горы\".","\"King of the Hill\" mode activated."))
        set KingOfHill=AddSpecialEffect("SquarePulse.mdx",GetRectCenterX(gg_rct_KingOfHillRect),GetRectCenterY(gg_rct_KingOfHillRect))
        call SetSpecialEffectScale(KingOfHill,6.2)
        call ShowFrame( KingOfHillIcon, true)
        call EnableTrigger(gg_trg_KingOfHill_Enter)
    endif
    set t=null
endfunction
function BonusActivation takes nothing returns nothing
    local timer t=GetExpiredTimer()
    call PauseTimer(t)
    if DU2==true then
        call DisplayTextToPlayer(GetLocalPlayer(),0,0,Lng("Зоны бонусов активированы.","Bonus zones are activated."))
        set Tower=AddSpecialEffect("SquarePulse.mdx",GetRectCenterX(gg_rct_TowerRect),GetRectCenterY(gg_rct_TowerRect))
        call SetSpecialEffectScale(Tower,6.2)
        call EnableTrigger(gg_trg_Tower_Enter)
        set Fountain=AddSpecialEffect("SquarePulse.mdx",GetRectCenterX(gg_rct_FountainRect),GetRectCenterY(gg_rct_FountainRect))
        call SetSpecialEffectScale(Fountain,6.2)
        call EnableTrigger(gg_trg_Fountain_Enter)
    endif
    set t=null
endfunction
function Arena_Narrowing_Periodic takes nothing returns nothing
        local integer id=GetHandleId(GetExpiredTimer())
        local real angle=0
        local integer i=0
        loop
        exitwhen i>=11
                set n=LoadUnitHandle(h, id, StringHash("Dum"+I2S(i)))
                set angle=AP(GetRectCenterX(gg_rct_GameZone1),GetRectCenterY(gg_rct_GameZone1), GetUnitX(n), GetUnitY(n))+0.5*bj_DEGTORAD
                call SetUnitX(n, GetRectCenterX(gg_rct_GameZone1)+(3000-passedTime*270)*Cos(angle))
                call SetUnitY(n, GetRectCenterY(gg_rct_GameZone1)+(3000-passedTime*270)*Sin(angle))
        set i=i+1
        endloop
        
        set bjLCG=LoadGroupHandle(h,id,GroupHash)
        if udg_B==true or DU==false then
                call GroupEnumUnitsInRect(bjLCG, gg_rct_GameZone1, Base)
                loop
                set E=FirstOfGroup(bjLCG)
                exitwhen E==null
                        set angle=AP(GetRectCenterX(gg_rct_GameZone1),GetRectCenterY(gg_rct_GameZone1), GetUnitX(E), GetUnitY(E))
                        if SR(GetRectCenterX(gg_rct_GameZone1),GetRectCenterY(gg_rct_GameZone1), GetUnitX(E), GetUnitY(E))>(3000-passedTime*270) then
                                call SetUnitX(E, GetRectCenterX(gg_rct_GameZone1)+(3000-passedTime*270)*Cos(angle))
                                call SetUnitY(E, GetRectCenterY(gg_rct_GameZone1)+(3000-passedTime*270)*Sin(angle))
                        endif
                call GroupRemoveUnit(bjLCG, E)
                endloop
    else
                set i=0
                loop
                exitwhen i>=11
                        set n=LoadUnitHandle(h, id, StringHash("Dum"+I2S(i)))
                        call KillUnit(n)
                        call MyRemoveUnit(n, 0.5)
                        set i=i+1
                endloop
                call DestroyGroup(LoadGroupHandle(h,id,GroupHash))
                call FlushChildHashtable(h, id)
        call PauseTimer(GetExpiredTimer())
        call DestroyTimer(GetExpiredTimer())
    endif
        set bjLCG=null
endfunction
function Arena_Narrowing takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local integer i=0
        local real angle=-36*bj_DEGTORAD
        call PauseTimer(t)
        loop
        exitwhen i>=11
        set angle=angle+36*bj_DEGTORAD
        set bjLCU=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), 'dA01', GetRectCenterX(gg_rct_GameZone1)+3000*Cos(angle), GetRectCenterY(gg_rct_GameZone1)+3000*Sin(angle), 0)
        call SaveUnitHandle(h, id, StringHash("Dum"+I2S(i)), bjLCU)
        set i=i+1
        endloop
        call SaveGroupHandle(h, id, GroupHash, CreateGroup())
        call TimerStart(t, 0.01, true, function Arena_Narrowing_Periodic)
        set t=null
endfunction
function DuelsCond takes nothing returns boolean
return IsUnitInGroup(GetTriggerUnit(),gf)
endfunction
function DuelsAct takes nothing returns nothing
local integer i=0
local integer l__s=0
local integer idp=GetPlayerId(GetOwningPlayer(GetKillingUnit()))
local unit ichigo
local unit u=GetTriggerUnit()
local integer idpu=GetPlayerId(GetOwningPlayer(u))
local unit c=Hero[idp]
local group g
if GetUnitTypeId(u)=='H06T' then
set lucy[idpu]=false
call UnitRemoveAbility(Lucy[idpu],'ore3')
call RemoveUnit(Lucy[idpu])
endif
if GetUnitTypeId(u)=='Ho11' then//
call SetHeroStr(u,GetHeroStr(u,false)-LoadInteger(HH,GetHandleId(u),SH_BonusSTR),true)
call SetHeroAgi(u,GetHeroAgi(u,false)-LoadInteger(HH,GetHandleId(u),SH_BonusAGI),true)
call SaveInteger(HH,GetHandleId(u),SH_BonusSTR,0)
call SaveInteger(HH,GetHandleId(u),SH_BonusAGI,0)
endif
if GetUnitTypeId(c)=='Ho11' then//
call SetHeroStr(c,GetHeroStr(c,false)-LoadInteger(HH,GetHandleId(c),SH_BonusSTR),true)
call SetHeroAgi(c,GetHeroAgi(c,false)-LoadInteger(HH,GetHandleId(c),SH_BonusAGI),true)
call SaveInteger(HH,GetHandleId(c),SH_BonusSTR,0)
call SaveInteger(HH,GetHandleId(c),SH_BonusAGI,0)
endif
if GetUnitTypeId(u)=='Ho14' then
call SaveReal(HH,GetHandleId(Darkness[idpu]),SH_darkHP,LoadReal(HH,GetHandleId(Darkness[idpu]),SH_darkMaxHP))
endif
call GroupRemoveUnit(gf,c)
set g=CopyGroup(gf)
call GroupRemoveUnit(g,c)
set fi[1]=null
set fi[2]=null
if CountUnitsInGroup(gf)>1 then
set fi[1]=GetRandomUnitFromGroup2(g)
call GroupRemoveUnit(g,fi[1])
set fi[2]=GetRandomUnitFromGroup2(g)
call GroupRemoveUnit(g,fi[2])
call UnitResetCooldown(fi[1])
call UnitResetCooldown(fi[2])
call UnitRemoveAbility(fi[1],'A1F9')
call UnitRemoveAbility(fi[1],'A1FA')
call UnitRemoveAbility(fi[1],'A26F')
call UnitRemoveAbility(fi[1],'A25F')
call UnitRemoveAbility(fi[2],'A1F9')
call UnitRemoveAbility(fi[2],'A1FA')
call UnitRemoveAbility(fi[2],'A26F')
call UnitRemoveAbility(fi[2],'A25F')
call RemoveTransformation(fi[1])
call RemoveTransformation(fi[2])
call SetUnitPosition(c,RX,RY)
call ReviveHero(u,RX,RY,false)
call SetUnitControlCount(u, 11,0)
call PauseTimer(TD2)
set passedTime=-8
call DisableTrigger(gg_trg_KingOfHill_Enter)
call DisableTrigger(gg_trg_Tower_Enter)
call SetUnitOwner(TowerUnit,Player(PLAYER_NEUTRAL_PASSIVE),false)
call DisableTrigger(gg_trg_Fountain_Enter)
call DestroyEffect(KingOfHill)
call DestroyEffect(Tower)
call DestroyEffect(Fountain)
set HealRes=0
set SpeedRes=0
set DU2=false
call RemoveTransformation(u)
call TimerStart(TD2,30,false,function ResistReductionFunction)
call GroupEnumUnitsInRect(G,gg_rct_ArenaNormal,null)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if E!=Hero[GetPlayerId(GetOwningPlayer(E))] then
call RemoveUnit(E)
endif
call GroupRemoveUnit(G,E)
endloop
call SetUnitPosition(fi[1],GetRectCenterX(gg_rct_F1),GetRectCenterY(gg_rct_F1))
call SetUnitPosition(fi[2],GetRectCenterX(gg_rct_F2),GetRectCenterY(gg_rct_F2))
call SetUnitFacing(fi[1],360)
call SetUnitFacing(fi[2],180)
call SaveInteger(HH,GetHandleId(fi[1]),SH_cold,1)
call SaveInteger(HH,GetHandleId(fi[2]),SH_cold,1)
call SaveInteger(HH,GetHandleId(fi[1]),SH_cold2,1)
call SaveInteger(HH,GetHandleId(fi[2]),SH_cold2,1)
call SaveInteger(HH,GetHandleId(fi[1]),SH_cold3,1)
call SaveInteger(HH,GetHandleId(fi[2]),SH_cold3,1)
call UnitRemoveAbility(fi[1],'BNC2')
call UnitRemoveAbility(fi[2],'BNC2')
call UnitRemoveAbility(fi[1],'BNC1')
call UnitRemoveAbility(fi[2],'BNC1')
call UnitRemoveAbility(fi[1],'A0QL')
call UnitRemoveAbility(fi[2],'A0QL')
call UnitRemoveAbility(fi[1],'A1AC')
call UnitRemoveAbility(fi[2],'A1AC')
call UnitRemoveAbility(fi[1],'A0YY')
call UnitRemoveAbility(fi[2],'A0YY')
call SetUnitFlyHeight(fi[1],0,0)
call SetUnitFlyHeight(fi[2],0,0)
call SetUnitState(fi[1],UNIT_STATE_LIFE,GetUnitState(fi[1],UNIT_STATE_MAX_LIFE))
call SetUnitState(fi[2],UNIT_STATE_LIFE,GetUnitState(fi[2],UNIT_STATE_MAX_LIFE))
call SetUnitState(fi[1],UNIT_STATE_MANA,GetUnitState(fi[1],UNIT_STATE_MAX_MANA))
call SetUnitState(fi[2],UNIT_STATE_MANA,GetUnitState(fi[2],UNIT_STATE_MAX_MANA))
call SetBuffDispellable(GetUnitBuff( fi[1], 'B06L' ),false)
call SetBuffDispellable(GetUnitBuff( fi[1], 'B16L' ),false)
call SetBuffDispellable(GetUnitBuff( fi[2], 'B06L' ),false)
call SetBuffDispellable(GetUnitBuff( fi[2], 'B16L' ),false)
call UnitRemoveBuffs(fi[1],true,true)
call UnitRemoveBuffs(fi[2],true,true)
call SaveInteger(HH,GetHandleId(fi[1]),SH_VegetaDeath,1)
call SaveInteger(HH,GetHandleId(fi[2]),SH_VegetaDeath,1)
call UnitRemoveAbility(fi[1],'ore3')
call UnitRemoveAbility(fi[1],'OM17')
call UnitRemoveAbility(fi[2],'ore3')
call UnitRemoveAbility(fi[2],'OM17')
if GetUnitTypeId(fi[1])=='Ho11' then//
call SetHeroStr(fi[1],GetHeroStr(fi[1],false)-LoadInteger(HH,GetHandleId(fi[1]),SH_BonusSTR),true)
call SetHeroAgi(fi[1],GetHeroAgi(fi[1],false)-LoadInteger(HH,GetHandleId(fi[1]),SH_BonusAGI),true)
call SaveInteger(HH,GetHandleId(fi[1]),SH_BonusSTR,0)
call SaveInteger(HH,GetHandleId(fi[1]),SH_BonusAGI,0)
endif
if GetUnitTypeId(fi[2])=='Ho11' then//
call SetHeroStr(fi[2],GetHeroStr(fi[2],false)-LoadInteger(HH,GetHandleId(fi[2]),SH_BonusSTR),true)
call SetHeroAgi(fi[2],GetHeroAgi(fi[2],false)-LoadInteger(HH,GetHandleId(fi[2]),SH_BonusAGI),true)
call SaveInteger(HH,GetHandleId(fi[2]),SH_BonusSTR,0)
call SaveInteger(HH,GetHandleId(fi[2]),SH_BonusAGI,0)
endif
call UpdateMultiboard()
call SetUnitInvulnerable(fi[1],true)
call SetUnitInvulnerable(fi[2],true)
call UnitAddAbility(fi[1],'Avul')
call UnitAddAbility(fi[2],'Avul')
//call SetCameraField(CAMERA_FIELD_ZOFFSET,1200.,0)
//call CameraSetupApplyForceDuration(gg_cam_Camera,false,0)
call SetCameraPosition(GetRectCenterX(gg_rct_ArenaNormal),GetRectCenterY(gg_rct_ArenaNormal))
call PauseUnit(fi[1],true)
call PauseUnit(fi[2],true)
call DisplayTextToPlayer(GetLocalPlayer(),256,128,"3!")
set soundplay=SndByPath("Voice\\"+InitVoice2(GetUnitTypeId(fi[1]),GetUnitTypeId(fi[2])))
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call PolledWait(1)
call SetUnitPosition(fi[1],GetRectCenterX(gg_rct_F1),GetRectCenterY(gg_rct_F1))
call SetUnitPosition(fi[2],GetRectCenterX(gg_rct_F2),GetRectCenterY(gg_rct_F2))
call SetUnitFacing(fi[1],360)
call SetUnitFacing(fi[2],180)
call PauseUnit(fi[1],true)
call PauseUnit(fi[2],true)
call DisplayTextToPlayer(GetLocalPlayer(),256,128,"2!")
call PolledWait(1)
call SetUnitPosition(fi[1],GetRectCenterX(gg_rct_F1),GetRectCenterY(gg_rct_F1))
call SetUnitPosition(fi[2],GetRectCenterX(gg_rct_F2),GetRectCenterY(gg_rct_F2))
call SetUnitFacing(fi[1],360)
call SetUnitFacing(fi[2],180)
call PauseUnit(fi[1],true)
call PauseUnit(fi[2],true)
call DisplayTextToPlayer(GetLocalPlayer(),256,128,"1!")
call PolledWait(1)
call SetUnitPosition(fi[1],GetRectCenterX(gg_rct_F1),GetRectCenterY(gg_rct_F1))
call SetUnitPosition(fi[2],GetRectCenterX(gg_rct_F2),GetRectCenterY(gg_rct_F2))
call SetUnitFacing(fi[1],360)
call SetUnitFacing(fi[2],180)
call PauseUnit(fi[1],false)
call PauseUnit(fi[2],false)
call SetUnitState(fi[1],UNIT_STATE_LIFE,GetUnitState(fi[1],UNIT_STATE_MAX_LIFE))
call SetUnitState(fi[2],UNIT_STATE_LIFE,GetUnitState(fi[2],UNIT_STATE_MAX_LIFE))
call SetUnitState(fi[1],UNIT_STATE_MANA,GetUnitState(fi[1],UNIT_STATE_MAX_MANA))
call SetUnitState(fi[2],UNIT_STATE_MANA,GetUnitState(fi[2],UNIT_STATE_MAX_MANA))
call UnitRemoveAbility(fi[1],'Avul')
call UnitRemoveAbility(fi[2],'Avul')
if GetUnitAbilityLevel(fi[1],'A17X')>0 then
call UnitAddAbility(fi[1],'A182')
endif
if GetUnitAbilityLevel(fi[2],'A17X')>0 then
call UnitAddAbility(fi[2],'A182')
endif
set DU2=true
call DisplayTextToPlayer(GetLocalPlayer(),256,128,"Fight!")
call SetUnitInvulnerable(fi[1],false)
call SetUnitInvulnerable(fi[2],false)
if UnitHasItemOfTypeBJCustom(fi[1], 'I03A') and GetWidgetLife(fi[1])>0 and IsUnitIllusion(fi[1])==false then
    set AlastorPos=0
    loop
    exitwhen AlastorPos==10 or GetItemTypeId(UnitItemInSlot(fi[1],AlastorPos)) == 'I03A'
    set AlastorPos=AlastorPos+1
    endloop
    if IsAbilityEnabled(GetUnitAbility(fi[1],'AInv'))==true then
        set Alastor=GetItemOfTypeFromUnitBJCustom(fi[1],'I03A')
        call UnitRemoveItem(fi[1],Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(fi[1], 'I03A',AlastorPos)
    else
        call EnableUnitAbility2(fi[1],'AInv',false,true)
        set Alastor=GetItemOfTypeFromUnitBJCustom(fi[1],'I03A')
        call UnitRemoveItem(fi[1],Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(fi[1], 'I03A',AlastorPos)    
        call DisableUnitAbility2(fi[1],'AInv',false,true)
    endif
endif
if UnitHasItemOfTypeBJCustom(fi[2], 'I03A') and GetWidgetLife(fi[2])>0 and IsUnitIllusion(fi[2])==false then
    set AlastorPos=0
    loop
    exitwhen AlastorPos==10 or GetItemTypeId(UnitItemInSlot(fi[2],AlastorPos)) == 'I03A'
    set AlastorPos=AlastorPos+1
    endloop
    if IsAbilityEnabled(GetUnitAbility(fi[2],'AInv'))==true then
        set Alastor=GetItemOfTypeFromUnitBJCustom(fi[2],'I03A')
        call UnitRemoveItem(fi[2],Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(fi[2], 'I03A',AlastorPos)
    else
        call EnableUnitAbility2(fi[2],'AInv',false,true)
        set Alastor=GetItemOfTypeFromUnitBJCustom(fi[2],'I03A')
        call UnitRemoveItem(fi[2],Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(fi[2], 'I03A',AlastorPos)    
        call DisableUnitAbility2(fi[2],'AInv',false,true)
    endif
endif
call SetUnitState(fi[1],UNIT_STATE_LIFE,GetUnitState(fi[1],UNIT_STATE_MAX_LIFE))
call SetUnitState(fi[2],UNIT_STATE_LIFE,GetUnitState(fi[2],UNIT_STATE_MAX_LIFE))
call SetUnitState(fi[1],UNIT_STATE_MANA,GetUnitState(fi[1],UNIT_STATE_MAX_MANA))
call SetUnitState(fi[2],UNIT_STATE_MANA,GetUnitState(fi[2],UNIT_STATE_MAX_MANA))
else
call DisableTrigger(duels)
call DisableTrigger(gg_trg_MoveToArena2)
call DisableTrigger(gg_trg_MoveToBase2)
call DisableTrigger(gg_trg_ClearAllUnit)
call EnableTrigger(eoc)
call EnableTrigger(gg_trg_MoveToArena)
loop
exitwhen i>9
call SetUnitPosition(Hero[i],RX,RY)
call UnitRemoveAbility(Hero[i],'BOhx')
call UnitRemoveAbility(Hero[i],'A0QL')
call SetUnitFlyHeight(Hero[i],0,0)
if UnitIsAlive(Hero[i])==false then
call ReviveHero(Hero[i],RX,RY,false)
call SetUnitControlCount(Hero[i], 11,0)
endif
call SetHeroLevel(Hero[i],GetHeroLevel(Hero[i])+3,true)
call SetUnitMoveSpeed(Hero[i], GetUnitDefaultMoveSpeed(Hero[i]))
call PauseUnit(Hero[i],false)
call SaveBoolean(HH,GetHandleId(Hero[i]),TARGET_ABILITY,false)
call ShowUnit(Hero[i],false)
call ShowUnit(Hero[i],true)
call SetUnitTimeScale(Hero[i],1)
call UnitAddType(Hero[i],UNIT_TYPE_ETHEREAL)
call UnitRemoveType(Hero[i],UNIT_TYPE_ETHEREAL)
call UnitAddAbility(Hero[i],'Agho')
call UnitRemoveAbility(Hero[i],'Agho')
call UnitAddAbility(Hero[i],'A00D')
call UnitRemoveAbility(Hero[i],'A00D')
call IssueImmediateOrder(Hero[i],"unimmolation")
call RemoveTransformation(Hero[i])
call SetUnitFlyHeight(Hero[i],0,0)
set i=i+1
endloop
call PauseTimer(TD2)
call TimerStart(udg_Timer,40,false,null)
call SetAbilityBaseRealLevelFieldById('Aneu',ABILITY_RLF_CAST_RANGE,0,2000)
call SetAbilityBaseRealLevelFieldById('Aneu',ABILITY_RLF_ACTIVATION_RADIUS,0,2500)
set udg_TB=CreateTimerDialog(udg_Timer)
call LANG_TdTitle(udg_TB,"До начала раунда:","Before the start of the round:")
call ResetToGameCamera(1.0)
call TimerDialogDisplay(udg_TB,true)
set udg_B=false
set round=round+1
set Rounds=true
if FFAMode==false then
call SetForceAllianceStateBJ(all[1],all[1],bj_ALLIANCE_ALLIED_VISION)
call SetForceAllianceStateBJ(all[2],all[2],bj_ALLIANCE_ALLIED_VISION)
endif
endif
call DestroyGroup(g)
set g=null
set u=null
set c=null
set ichigo=null
endfunction
function DuelsInit takes nothing returns nothing
local integer i=0
set duels=CreateTrigger()
loop
call TriggerRegisterPlayerUnitEvent(duels,Player(i),EVENT_PLAYER_UNIT_DEATH,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(duels,function DuelsAct)
call TriggerAddCondition(duels,Condition(function DuelsCond))
endfunction
function VoiceStartRound takes nothing returns nothing
local integer i=0
loop
exitwhen i>=12
if GetUnitTypeId(Hero[i])=='H03P' then
set HSE[1]=Hero[i]
endif
set i=i+1
endloop
set i=0
loop
exitwhen i>=12
if GetUnitTypeId(Hero[i])=='H00Z' then
set HSE[2]=Hero[i]
endif
set i=i+1
endloop
set i=0
loop
exitwhen i>=12
if GetUnitTypeId(Hero[i])=='H04F' then
set HSE[1]=Hero[i]
endif
set i=i+1
endloop
set i=0
loop
exitwhen i>=12
if GetUnitTypeId(Hero[i])=='H057' then
set HSE[2]=Hero[i]
endif
set i=i+1
endloop
set i=0
loop
exitwhen i>=12
if GetUnitTypeId(Hero[i])=='H05D' then
set HSE[3]=Hero[i]
endif
set i=i+1
endloop
set i=0
loop
exitwhen i>=12
if GetUnitTypeId(Hero[i])=='H05C' then
set HSE[1]=Hero[i]
endif
set i=i+1
endloop
set i=0
loop
exitwhen i>=12
if GetUnitTypeId(Hero[i])=='H05A' then
set HSE[2]=Hero[i]
endif
set i=i+1
endloop
set i=0
if IsUnitAlly(HSE[1],GetOwningPlayer(HSE[2]))and GetUnitTypeId(HSE[1])=='H03P' then
set soundplay=SndByPath(zura[GetRandomInt(1,4)])
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
if IsUnitAlly(HSE[1],GetOwningPlayer(HSE[2]))and IsUnitAlly(HSE[2],GetOwningPlayer(HSE[3]))and GetUnitTypeId(HSE[3])=='H05D' then
set soundplay=SndN(736) // Sound\Music\mp3Music\TeamSeven.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
if IsUnitAlly(HSE[1],GetOwningPlayer(HSE[2]))and GetUnitTypeId(HSE[1])=='H05C' then
set soundplay=SndByPath("SaberShirou"+I2S(GetRandomInt(1,5))+".mp3")
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif

//Madara
loop
exitwhen i>=10
if GetUnitTypeId(Hero[i])=='H033' then
set HSE[1]=Hero[i]
endif
set i=i+1
endloop
set i=0

//Hashirama 
loop
exitwhen i>=10
if GetUnitTypeId(Hero[i])=='HHSN' then
set HSE[2]=Hero[i]
endif
set i=i+1
endloop
set i=0



if IsUnitAlly(HSE[1],GetOwningPlayer(HSE[2]))and GetUnitTypeId(HSE[1])=='H033' and GetUnitTypeId(HSE[2])=='HHSN' then
set soundplay=SndN(280) // Sound\Music\mp3Music\HashiramaRefuseMadara.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif

if IsUnitEnemy(HSE[1],GetOwningPlayer(HSE[2]))and GetUnitTypeId(HSE[1])=='H033' and GetUnitTypeId(HSE[2])=='HHSN' then
set soundplay=SndN(278) // Sound\Music\mp3Music\HashiramaMadara.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif



endfunction
function EndOfRound takes nothing returns nothing
local integer i=0
set TC=true
loop
exitwhen i>12
call KillUnit(Hero[i])
set i=i+1
endloop
endfunction
function EndroundCast takes nothing returns nothing
    if udg_test then
    call DestroyTimerDialog(udg_TB)
    call DestroyTimerDialog(TG)
    call TimerStart(TD,3,false,function EndOfRound)
    set TG=CreateTimerDialog(TD)
    call LANG_TdTitle(TG,"До конца раунда осталось:","Until the end of the round left:")
    call TimerDialogDisplay(TG,true)
    endif
endfunction
function EndroundInit takes nothing returns nothing
    set gg_trg_EndR=CreateTrigger()
    call TriggerRegisterPlayerChatEvent(gg_trg_EndR,Player(0),"-endround",true)
    call TriggerRegisterPlayerChatEvent(gg_trg_EndR,Player(1),"-endround",true)
    call TriggerRegisterPlayerChatEvent(gg_trg_EndR,Player(2),"-endround",true)
    call TriggerRegisterPlayerChatEvent(gg_trg_EndR,Player(3),"-endround",true)
    call TriggerRegisterPlayerChatEvent(gg_trg_EndR,Player(4),"-endround",true)
    call TriggerRegisterPlayerChatEvent(gg_trg_EndR,Player(5),"-endround",true)
    call TriggerRegisterPlayerChatEvent(gg_trg_EndR,Player(6),"-endround",true)
    call TriggerRegisterPlayerChatEvent(gg_trg_EndR,Player(7),"-endround",true)
    call TriggerRegisterPlayerChatEvent(gg_trg_EndR,Player(8),"-endround",true)
    call TriggerRegisterPlayerChatEvent(gg_trg_EndR,Player(9),"-endround",true)
    //call TriggerRegisterPlayerChatEvent(gg_trg_EndR,Player(10),"-endround",true)
    //call TriggerRegisterPlayerChatEvent(gg_trg_EndR,Player(11),"-endround",true)
    call TriggerAddAction(gg_trg_EndR,function EndroundCast)
endfunction
function Trig_Start_Func001C takes nothing returns nothing
call SetUnitPosition(GetEnumUnit(),GetRectCenterX(gg_rct_Resp4),GetRectCenterY(gg_rct_Resp4))
call UnitRemoveAbility(GetEnumUnit(),'A1F9')
call UnitRemoveAbility(GetEnumUnit(),'A1FA')
