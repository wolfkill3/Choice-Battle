call SetUnitTimeScale(n,2)
call StartSound(soundStr[47])
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
call KillUnit(l__d)
endif
set p=null
set l__d=null
set t=null
set u=null
