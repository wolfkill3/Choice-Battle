function RyougiFCond takes nothing returns boolean
    return GetSpellAbilityId()=='RSF0'
endfunction
function RyougiF_Cast3 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(HH,id,0)
    local unit c=LoadUnitHandle(HH,id,4)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real dmg=GetHeroAgi(u,true)*(2.5+GetHeroLevel(u)*0.1)+100
    local real x1=GetUnitX(c)
    local real y1=GetUnitY(c)
    local real a=LoadReal(HH,id,3)
    local real time=LoadReal(HH,id,2)
    local player p=GetOwningPlayer(u)
    local real RotPitch=LoadReal(HH,id,10)
    call SaveReal(HH,id,2,time+0.03)
    if time<1.3 then
        call SetUnitInvulnerable(u,true)
        call PauseUnit(u,true)
        call SetUnitInvulnerable(c,true)
        call PauseUnit(c,true)
        if time<0.45 then
            call SetUnitXY_1(c,x1-2*Cos(a),y1-2*Sin(a), false)
            call SetUnitXY_1(u,x+1*Cos(a),y+1*Sin(a), false)
        endif
        if time>0.3 and time<0.6 then
            call SaveReal(HH,id,10,RotPitch+9)
            call SetUnitOrientation(c,GetUnitFacing(u)-180,RotPitch,0)
        endif
        if time==0.6 then
            set EFF=AddSpecialEffect("chushou_by_wood_effect_earth_sandycrack_fag.mdl",x1+50*Cos(a),y1+50*Sin(a))
            call SetSpecialEffectScale(EFF ,     0.3)
            call RemoveEffect(EFF,1.5,false,CreateTimer())
            set EFF=AddSpecialEffect("war3mapImported\\WindCircleFaster.mdl",x1+50*Cos(a),y1+50*Sin(a))
            call SetSpecialEffectScale(EFF , 0.7)
            call RemoveEffect(EFF,2,false,CreateTimer())
        endif
        if time==0.9 then
            set n=CreateUnit(p,'e11S',x+50*Cos(a),y+50*Sin(a),a*bj_RADTODEG)
            call SetUnitVertexColor(n,255,255,255,155)
            call SetUnitScale(n,2,2,2)
            call UnitApplyTimedLife(n,'BTLF',1.4)
            call SetUnitTimeScale(n,0.5)
            call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Tidal.mdx",c,"chest"))
            call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX-Special.mdx",c,"chest"))
        endif
    else
        call SetUnitInvulnerable(u,false)
        call PauseUnit(u,false)
        if GetWidgetLife(c)>dmg*0.25+5 then
            call SetUnitState(c,UNIT_STATE_LIFE,GetWidgetLife(c)-dmg*0.25)
        else
            call SetUnitInvulnerable(c,false)
            call UnitRemoveBuffs(c,true,true)
            call UnitAddAbility(c,'A0WR')
            call DamageIndicatorFunction(u,c,dmg)
            call myCustomDamage(u,c,10000000,false,false,null,null,null)
            call UnitRemoveAbility(c,'A0WR')
        endif
        call PauseUnit(c,false)
        call SetUnitInvulnerable(c,false)
        call DamageTextTag(u,c,dmg*0.25)
        call DamageIndicatorFunction(u,c,dmg*0.25)
        call myCustomDamage(u,c,dmg-dmg*0.25,false,false,null,null,null)
        call SetControlToUnit(u,c,1, "stun")
        call SetUnitTimeScale(c,1)
        call PauseTimer(t)
        call SetUnitTimeScale(u,1)
        call UnitEnableAutoOrientation(c,true)
        call SetUnitAnimationByIndex(u,0)
        call DestroyTimer(t)
        call FlushChildHashtable(HH,id)
    endif
    set c=null
    set u=null
    set p=null
    set t=null
endfunction

function RyougiF_Cast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(HH,id,0)
    local real dmg=GetHeroAgi(u,true)*(2.5+GetHeroLevel(u)*0.1)+100
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real a=LoadReal(HH,id,3)
    local real dist=LoadReal(HH,id,2)
    local integer i=0
    local boolean b=LoadBoolean(HH,id,1)
    local real time=LoadReal(HH,id,2)
    local real sc
    local player p=GetOwningPlayer(u)
    call SaveReal(HH,id,2,time+0.01)
    call PauseUnit(u,true)
    if time==0.01 then
        call SetUnitAnimationByIndex(u,16)
        set EFF=AddSpecialEffect("Keyesdevilslamita.mdl",x,y)
        call SetSpecialEffectScale(EFF,1)
        call SetSpecialEffectTimeScale(EFF,1.4)
        call SetSpecialEffectVertexColour(EFF,255,200,200,200)
        call RemoveEffect(EFF,.5,false,CreateTimer())
    endif
    if dist<850 and b==false then
        if time>0.15 then
            set x=x+30*Cos(a)
            set y=y+30*Sin(a)
            call SetUnitXY_1(u,x,y, false)
            call SaveReal(HH,id,2,dist+30)
            set n=CreateUnit(p,'e11T',x-20*Cos(a),y,a*bj_RADTODEG)
            call SetUnitVertexColor(n,255,255,255,75)
            call UnitApplyTimedLife(n,'BTLF',0.15)
            set n=CreateUnit(p,'e117',x,y,a*bj_RADTODEG)
            call SetUnitVertexColor(n,255,255,255,GetRandomInt(10,45))
            set sc=GetRandomReal(0.75,1.15)
            call SetUnitScale(n,sc,sc,sc)
            call UnitApplyTimedLife(n,'BTLF',0.4)
            call SetUnitTimeScale(n,2)
            set n = CreateUnit(p, 'dR45', x, y, a*bj_RADTODEG)
            call SetUnitScale(n, 0.5, 0.5, 0.5)
            call MyRemoveUnit(n, 1.5)
            call GroupEnumUnitsInRange(G,x,y,150,Base)
            loop
                set E=FirstOfGroup(G)
                exitwhen E==null
                if Condition_Base(p,E)and IsUnitInvulnerable(E)==false then
                    if GetWidgetLife(E)>0 then
                        call SetSpecialEffectTimeScale(LoadEffectHandle(HH,id,5),1)
                        call RemoveEffect(LoadEffectHandle(HH,id,5),0.3,false,CreateTimer())
                        if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
                            call SaveUnitHandle(HH,id,4,E)
                            call SetUnitFacingInstant(E,a*bj_RADTODEG-180)
                            call SaveReal(HH,id,2,0)
                            call SetUnitInvulnerable(u,true)
                            call PauseUnit(u,true)
                            call PauseTimer(t)
                            call StartSound(soundStr[137])
                            call SetUnitAnimationByIndex(u,22)
                            call SetUnitTimeScale(u,1.37)
                            call SetUnitXY_1(E,x+100*Cos(a),y+100*Sin(a), false)
                            call UnitEnableAutoOrientation(E,false)
                            call TimerStart(t,0.03,true,function RyougiF_Cast3)
                        else
                            call SetUnitTimeScale(u,1)
                            call SetUnitAnimationByIndex(u,0)
                            call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,u)
                            call SetUnitInvulnerable(u, false)
                            call PauseUnit(u, false)
                            call PauseTimer(t)
                            call DestroyTimer(t)
                            call FlushChildHashtable(HH,id)
                        endif
                    endif
                    call GroupClear(G)
                endif
                call GroupRemoveUnit(G,E)
            endloop
        endif
    else
        call SetUnitAnimationByIndex(u,0)
        call SetUnitTimeScale(u,1)
        call PauseUnit(u,false)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(HH,id)
    endif
    set u=null
    set p=null
    set t=null
endfunction

function RyougiF_Cast takes nothing returns nothing
    local timer t=CreateTimer()
    local unit u=GetTriggerUnit()
    local integer id=GetHandleId(t)
    local player p=GetOwningPlayer(u)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetSpellTargetX()
    local real y1=GetSpellTargetY()
    local real a=Atan2(y1-y,x1-x)
    local integer i=1
    call SaveUnitHandle(HH,id,0,u)
    call SaveReal(HH,id,2,0)
    call SaveReal(HH,id,3,a)
    call SaveBoolean(HH,id,1,false)
    call PauseUnit(u,true)
    call SetUnitTimeScale(u,1)
    set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+55)
    call SetUnitVertexColor(n,255,255,255,155)
    call UnitApplyTimedLife(n,'BTLF',0.4)
    call SetUnitTimeScale(n,3)
    set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG-55)
    call SetUnitVertexColor(n,255,255,255,155)
    call UnitApplyTimedLife(n,'BTLF',0.4)
    call SetUnitTimeScale(n,3)
    set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG)
    call SetUnitVertexColor(n,255,255,255,155)
    call UnitApplyTimedLife(n,'BTLF',0.4)
    call SetUnitTimeScale(n,3)
    call StartSound(soundStr[136])
    call TimerStart(t,0.01,true,function RyougiF_Cast2)
    set p=null
    set t=null
endfunction
function InitTrig_RyougiF takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function RyougiFCond))
call TriggerAddAction(t,function RyougiF_Cast)
set t=null
endfunction
function GogetaQCond takes nothing returns boolean
    return GetSpellAbilityId()=='A0P5'
endfunction
function GogetaQCast3 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit l__d=LoadUnitHandle(h,id,4)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real dmg=GetHeroStr(u,true)*(GetUnitAbilityLevel(u,'A0P5')+1)+75
    local real x1=GetUnitX(l__d)
    local real y1=GetUnitY(l__d)
    local real a=GetUnitFacing(u)*bj_DEGTORAD
    local real dist=LoadReal(h,id,2)
    local player p=GetOwningPlayer(u)
    local group g=LoadGroupHandle(h,id,8)
    local group g2
    call SaveReal(h,id,2,dist+10)
    if dist<610 then
        if dist<90 then
            set x=x+dist*Cos(a)
            set y=y+dist*Sin(a)
            call SetUnitXY_1(u,x,y, false)
            call PauseUnit(u,true)
            call SetUnitVertexColor(u,255-R2I(2.5*dist),255-R2I(2.5*dist),255-R2I(2.5*dist),255-R2I(2.5*dist))
            if SR(x,y,x1,y1)<125 then
                call ShowUnit(u,false)
            else
                set n=CreateUnit(p,'e31F',x,y,a*bj_RADTODEG)
                if GetUnitAbilityLevel(u,'A16X')>0 then
                    call UnitAddAbility(n,'A16X')
                elseif GetUnitAbilityLevel(u,'A16Y')>0 then
                    call UnitAddAbility(n,'A16Y')
                elseif GetUnitAbilityLevel(u,'A170')>0 then
                    call UnitAddAbility(n,'A170')
                    call AddUnitAnimationProperties(n,"alternate",true)
                elseif GetUnitAbilityLevel(u,'A171')>0 then
                    call UnitAddAbility(n,'A171')
                endif
                call SetUnitTimeScale(n,0)
                call UnitApplyTimedLife(n,'BTLF',0.15)
                call SetUnitVertexColor(n,255-R2I(2.5*dist),255-R2I(2.5*dist),255-R2I(2.5*dist),255-R2I(2.5*dist))
                call ShikiCloneEffect(n,1.5,1.05,1.25,150)
            endif
        else
            if dist==100 then
                call ShowUnit(u,false)
            endif
            if ModuloReal(dist,70)<1 then
                set g2=CopyGroup(g)
                call ShakeCamera(0.2,25)
                loop
                    set E=FirstOfGroup(g2)
                    exitwhen E==null
                    if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
                        call SetUnitAnimation(E,"death")
                        set EFF=AddSpecialEffect("AZ_DD021.mdx", GetUnitX(E)+GetRandomReal(-35,35)*Cos(a+GetRandomReal(-40,40)*bj_DEGTORAD), GetUnitY(E)+GetRandomReal(-35,35)*Sin(a+GetRandomReal(-40,40)*bj_DEGTORAD))
                        call SetSpecialEffectScale(EFF , GetRandomReal(0.8,1.4))
                        call SetSpecialEffectFacing(EFF , a  * bj_RADTODEG+GetRandomReal(-80,80))
                        call SetSpecialEffectZ(EFF , GetRandomReal(30,80))
                        //call SetSpecialEffectPitch(EFF , GetRandomReal(-15,15))
                        call DestroyEffect(EFF)
                        set EFF=AddSpecialEffect("war3mapImported\\dash sfx.mdl", GetUnitX(E)+GetRandomReal(-35,35)*Cos(a+GetRandomReal(-40,40)*bj_DEGTORAD), GetUnitY(E)+GetRandomReal(-35,35)*Sin(a+GetRandomReal(-40,40)*bj_DEGTORAD))
                        call SetSpecialEffectScale(EFF , 0.2)
                        call SetSpecialEffectZ(EFF , GetRandomReal(30,90))
                        call SetSpecialEffectOrientation(EFF , a* bj_RADTODEG,GetRandomReal(-40,40),90)
                        call DestroyEffect(EFF)
                        set EFF=AddSpecialEffect("AZ_PA_C.mdx", GetUnitX(E)+GetRandomReal(-20,20)*Cos(a+GetRandomReal(-40,40)*bj_DEGTORAD), GetUnitY(E)+GetRandomReal(-20,20)*Sin(a+GetRandomReal(-40,40)*bj_DEGTORAD))
                        call SetSpecialEffectScale(EFF , GetRandomReal(0.5,0.9))
                        call SetSpecialEffectZ(EFF , GetRandomReal(60,150))
                        if GetRandomInt(0,1)==1 then
                        call SetSpecialEffectOrientation(EFF , a * bj_RADTODEG+90,GetRandomReal(-35,35),GetRandomReal(-40,-15))
                        else
                        call SetSpecialEffectOrientation(EFF , a * bj_RADTODEG-90,GetRandomReal(-35,35),GetRandomReal(15,40))
                        endif
                        call SetSpecialEffectVertexColour(EFF , GetRandomInt(30,160) , GetRandomInt(100,200) , GetRandomInt(150,255) , 200)
                        call DestroyEffect(EFF)
                    endif
                    set EFF=AddSpecialEffect("Minato-37.mdx", GetUnitX(E)+GetRandomReal(-35,35)*Cos(a+GetRandomReal(-40,40)*bj_DEGTORAD), GetUnitY(E)+GetRandomReal(-35,35)*Sin(a+GetRandomReal(-40,40)*bj_DEGTORAD))
                    call SetSpecialEffectScale(EFF , GetRandomReal(0.75,1.35))
                    call SetSpecialEffectZ(EFF , GetRandomReal(30,90))
                    call SetSpecialEffectRoll(EFF , 90)
                    call DestroyEffect(EFF)
                    call GroupRemoveUnit(g2,E)
                endloop
                call DestroyGroupTimed(g2,3)
            endif
        endif
    else
    if dist==630 then
        call ShowUnit(u,true)
        call SetUnitXY_1(u,x1+150*Cos(a),y1+150*Sin(a), false)
        if GetLocalPlayer()==p then
            call ClearSelection()
            call SelectUnit(u,true)
        endif
        call SetUnitTimeScale(u,1)
    else
        if dist>630 and dist<=680 then
            call SetUnitVertexColor(u,255,255,255,255)
            //set EFF=AddSpecialEffect("spiritarrow_byepsilon.mdx",x+GetRandomReal(-20,0)*Cos(a+GetRandomReal(-20,20)*bj_DEGTORAD), y+GetRandomReal(-20,0)*Sin(a+GetRandomReal(-20,20)*bj_DEGTORAD))
            //call SetSpecialEffectScale(EFF , GetRandomReal(0.5,0.9))
            //call SetSpecialEffectZ(EFF , GetRandomReal(60,150))
            //call SetSpecialEffectPitch(EFF , GetRandomReal(-35,35))
            //call SetSpecialEffectFacing(EFF , a * bj_RADTODEG)
            //call SetSpecialEffectVertexColour(EFF , GetRandomInt(30,160) , GetRandomInt(30,200) , GetRandomInt(30,255) , 255)
            //call DestroyEffect(EFF)
            set n=CreateUnit(p,'e31F',x,y,a*bj_RADTODEG)
            if GetUnitAbilityLevel(u,'A16X')>0 then
                call UnitAddAbility(n,'A16X')
            elseif GetUnitAbilityLevel(u,'A16Y')>0 then
                call UnitAddAbility(n,'A16Y')
            elseif GetUnitAbilityLevel(u,'A170')>0 then
                call UnitAddAbility(n,'A170')
                call AddUnitAnimationProperties(n,"alternate",true)
            elseif GetUnitAbilityLevel(u,'A171')>0 then
                call UnitAddAbility(n,'A171')
            endif
            call SetUnitTimeScale(n,0)
            call UnitApplyTimedLife(n,'BTLF',0.2)
            call ShikiCloneEffect(n,1.5,1.05,1.25,150)
            set x=x+(2600 / (dist-500))*Cos(a)
            set y=y+(2600 / (dist-500))*Sin(a)
            call SetUnitXY_1(u,x,y, false)
        elseif dist>680 then
            loop
            set E=FirstOfGroup(g)
            exitwhen E==null
            call PauseUnit(E,false)
            call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,false)
            call myCustomDamage(u,E,dmg,false,false,null,null,null)
            call SetControlToUnit(E,E,1,"stun")
            call GroupRemoveUnit(g,E)
            endloop
            call PauseTimer(t)
            set punisher=false
            call PauseUnit(u,false)
            call SetUnitInvulnerable(u,false)
            call DestroyTimer(t)
            call FlushChildHashtable(h,id)
            call DestroyGroup(g)
            call DestroyGroup(g2)
        endif
    endif
    endif
    set l__d=null
    set u=null
    set p=null
    set g=null
    set g2=null
    set t=null
endfunction
function GogetaQCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit l__d=LoadUnitHandle(h,id,1)
    local real x=GetUnitX(l__d)
    local real y=GetUnitY(l__d)
    local real x1=GetUnitX(u)
    local real y1=GetUnitY(u)
    local real a=LoadReal(h,id,3)
    local real dist=LoadReal(h,id,2)
    local player p=GetOwningPlayer(u)
    local group g=LoadGroupHandle(h,id,8)
    local real time=LoadReal(h,id,12)
    if time==0 then
        set EFF=AddSpecialEffect("tx_white1.mdx", x1, y1)
        call DestroyEffect(EFF)
    endif
    if time<0.3 then
    set EFF=AddSpecialEffect("AZ_PA_C.mdx", x+GetRandomReal(-10,10)*Cos(a), y+GetRandomReal(-10,10)*Sin(a))
    call SetSpecialEffectScale(EFF , GetRandomReal(0.8,1.5))
    call SetSpecialEffectOrientation(EFF , a* bj_RADTODEG,GetRandomReal(-25,25),GetRandomReal(-180,180))
    call SetSpecialEffectTimeScale(EFF , 0.5) 
    call SetSpecialEffectZ(EFF , GetRandomReal(20,130))
    call SetSpecialEffectVertexColour(EFF , GetRandomInt(110,160) , GetRandomInt(120,250) , GetRandomInt(150,255) , 160)
    call RemoveEffect(EFF, 0.3, false, CreateTimer())
    call SaveReal(h,id,12,time+0.04)
    else
    if dist<1600 then
    call PauseUnit(u,true)
    set x=x+129*Cos(a)
    set y=y+129*Sin(a)
    set EFF=AddSpecialEffect("AZ_PA_C.mdx", x+GetRandomReal(-10,10)*Cos(a), y+GetRandomReal(-10,10)*Sin(a))
    call SetSpecialEffectScale(EFF , GetRandomReal(0.8,1.5))
    call SetSpecialEffectTimeScale(EFF , 0.2)
    call SetSpecialEffectZ(EFF , GetRandomReal(60,130))
    if GetRandomInt(0,1)==1 then
    call SetSpecialEffectOrientation(EFF , a* bj_RADTODEG+GetRandomReal(-75,75),GetRandomReal(-15,15),GetRandomReal(-15,15))
    else
    call SetSpecialEffectOrientation(EFF , a* bj_RADTODEG+GetRandomReal(-75,75),GetRandomReal(-15,15),GetRandomReal(-165,-195))
    endif
    call SetSpecialEffectVertexColour(EFF , GetRandomInt(110,160) , GetRandomInt(120,250) , GetRandomInt(150,255) , 160)
    call DestroyEffect(EFF)
    set EFF=AddSpecialEffect("RougiSlash.mdx", x+GetRandomReal(-10,10)*Cos(a), y+GetRandomReal(-10,10)*Sin(a))
    call SetSpecialEffectScale(EFF , GetRandomReal(0.8,1.5))
    if GetRandomInt(0,1)==1 then
    call SetSpecialEffectOrientation(EFF , a* bj_RADTODEG+GetRandomReal(-75,75),GetRandomReal(-15,15),GetRandomReal(-15,15))
    else
    call SetSpecialEffectOrientation(EFF , a* bj_RADTODEG+GetRandomReal(-75,75),GetRandomReal(-15,15),GetRandomReal(-165,-195))
    endif
    call SetSpecialEffectTimeScale(EFF , 0.3)
    call SetSpecialEffectZ(EFF , GetRandomReal(20,130))
    call SetSpecialEffectVertexColour(EFF , GetRandomInt(110,160) , GetRandomInt(120,250) , GetRandomInt(150,255) , 160)
    call RemoveEffect(EFF, 0.6, false, CreateTimer())
    call SetUnitXY_1(l__d,x,y, false)
    call SaveReal(h,id,2,dist+129)
    call GroupEnumUnitsInRange(G,x,y,200,Base)
    loop
    set E=FirstOfGroup(G)
    exitwhen E==null
    if Condition_Base(p,E) and IsUnitInvulnerable(E)==false then
    set punisher=true
    call SaveUnitHandle(h,id,4,E)
    call PauseUnit(E,true)
    call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,true)
    call GroupAddUnit(g,E)
    endif
    call GroupRemoveUnit(G,E)
    endloop
    else
    call SaveReal(h,id,2,0)
    if punisher==true then
    set soundplay=SndN(2520) // Sound\Music\mp3Music\GogetaQ2.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call SetUnitTimeScale(u,0.1)
    call PauseTimer(t)
    call TimerStart(t,0.017,true,function GogetaQCast3)
    else
    if GetUnitAbilityLevel(u,'A170')>0 then
        call SetUnitAnimation(u,"Stand Alternate")
    else
        call SetUnitAnimation(u,"Stand")
    endif
    call SetUnitTimeScale(u,1)
    call PauseUnit(u,false)
    call SetUnitInvulnerable(u,false)
    call PauseTimer(t)
    call DestroyTimer(t)
    endif
    endif
    set l__d=null
    set u=null
    set g=null
    set p=null
    set t=null
    endif
endfunction
function GogetaQCast takes nothing returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local unit u=GetTriggerUnit()
    local player p=GetOwningPlayer(u)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetSpellTargetX()
    local real y1=GetSpellTargetY()
    local real a=Atan2(y1-y,x1-x)
    local group g=CreateGroup()
    call SaveUnitHandle(h,id,0,u)
    set n=CreateUnit(p,'cdm1',x+75*Cos(a),y+75*Sin(a),a*bj_RADTODEG)
    call UnitApplyTimedLife(n,'BTLF',1.6)
    call SaveUnitHandle(h,id,1,n)
    call SaveReal(h,id,2,0)
    call SaveReal(h,id,12,0)
    call SaveReal(h,id,3,a)
    call SaveGroupHandle(h,id,8,g)
    call SetUnitInvulnerable(u,true)
    call PauseUnit(u,true)
    if GetUnitAbilityLevel(u,'A170')>0 then
        call SetUnitAnimationByIndex(u,85)
    else
        call SetUnitAnimationByIndex(u,41)
    endif
    call SetUnitTimeScale(u,0.6)
    set soundplay=SndN(2523) // Sound\Music\mp3Music\GogetaQ.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call TimerStart(t,0.04,true,function GogetaQCast2)
    set u=null
    set p=null
    set t=null
    endfunction
function InitTrig_GogetaQ takes nothing returns nothing
    set gg_trg_GogetaQ=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_GogetaQ,EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_GogetaQ,Condition(function GogetaQCond))
    call TriggerAddAction(gg_trg_GogetaQ,function GogetaQCast)
endfunction
function KnifeCond takes nothing returns boolean
return GetSpellAbilityId()=='A194'
endfunction
function KnifeCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,4)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real dmg=(GetHeroAgi(u,true)*(GetUnitAbilityLevel(u,'A194')+1)+75)/2
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real a=Atan2(y1-y,x1-x)
local real dist=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>125 and GetWidgetLife(l__d)>0 then
set x=x+50*Cos(a)
set y=y+50*Sin(a)
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitXY_1(u,x,y, false)
set n=CreateUnit(p,'e0ZE',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,125-R2I((1)*0.05))
call UnitApplyTimedLife(n,'BTLF',0.1)
call SetUnitAnimation(n,"Spell Four")
call SetUnitTimeScale(n,3)
else
set n=CreateUnit(p,'e0ZG',x-50*Cos(a),y-50*Sin(a),a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,255)
call UnitApplyTimedLife(n,'BTLF',0.2)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZF',x-50*Cos(a),y-50*Sin(a),a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,255)
call UnitApplyTimedLife(n,'BTLF',0.2)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0F6',x,y,GetRandomReal(0,359))
call SetUnitFlyHeight(n,90,0)
call SetUnitVertexColor(n,255,255,255,255)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0F6',x,y,GetRandomReal(0,359))
call SetUnitFlyHeight(n,90,0)
call SetUnitVertexColor(n,255,255,255,255)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
if GetWidgetLife(l__d)>dmg*0.25 then
call SetUnitState(l__d,UNIT_STATE_LIFE,GetWidgetLife(l__d)-dmg*0.25)
else
call SetUnitInvulnerable(l__d,false)
call UnitRemoveBuffs(l__d,true,true)
call UnitAddAbility(l__d,'A0WR')
call DamageIndicatorFunction(u,l__d,dmg)
call myCustomDamage(u,l__d,10000000,false,false,null,null,null)
call UnitRemoveAbility(l__d,'A0WR')
endif
call DamageTextTag(u,l__d,dmg*0.25)
call DamageIndicatorFunction(u,l__d,dmg*0.25)
call myCustomDamage(u,l__d,dmg-dmg*0.25,false,false,null,null,null)
call PauseTimer(t)
call UnitRemoveAbility(u,'A195')
set soundplay=SndN(2525) // Sound\Music\mp3Music\ShikiSlash2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set knife=false
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set u=null
set p=null
set t=null
endfunction
function KnifeCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real dmg=(GetHeroAgi(u,true)*(GetUnitAbilityLevel(u,'A194')+1)+75)/2
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real a=LoadReal(h,id,3)
local real dist=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
if dist<2000 and GetWidgetLife(l__d)>0 then
set x=x+50*Cos(a)
set y=y+50*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SaveReal(h,id,2,dist+50)
set n=CreateUnit(p,'e0ZI',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,125)
call UnitApplyTimedLife(n,'BTLF',0.2)
call GroupEnumUnitsInRange(G,x,y,100,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call SaveUnitHandle(h,id,4,E)
call KillUnit(l__d)
if GetWidgetLife(E)>dmg*0.25 then
call SetUnitState(E,UNIT_STATE_LIFE,GetWidgetLife(E)-dmg*0.25)
else
call SetUnitInvulnerable(E,false)
call UnitRemoveBuffs(E,true,true)
call UnitAddAbility(E,'A0WR')
call DamageIndicatorFunction(u,E,dmg)
call myCustomDamage(u,E,10000000,false,false,null,null,null)
call UnitRemoveAbility(E,'A0WR')
endif
call DamageTextTag(u,E,dmg*0.25)
call DamageIndicatorFunction(u,E,dmg*0.25)
call myCustomDamage(u,E,dmg-dmg*0.25,false,false,null,null,null)
if GetWidgetLife(E)>0 then
call SetUnitAnimation(u,"Spell Four")
set n=CreateUnit(p,'e0ZH',x1,y1,a*bj_RADTODEG-30)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x1,y1,a*bj_RADTODEG+30)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x1,y1,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
call SetUnitInvulnerable(u,true)
call PauseUnit(u,true)
call UnitAddAbility(u,'A195')
call PauseTimer(t)
call TimerStart(t,0.01,true,function KnifeCast3)
endif
call GroupClear(G)
endif
call GroupRemoveUnit(G,E)
endloop
else
set knife=false
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set u=null
set p=null
set t=null
endfunction
function KnifeCast takes nothing returns nothing
