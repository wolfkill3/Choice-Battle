endif
if l__Q+l__Q+l__E==id then
set LSP2[ip]=LSP[ip]
set LSP[ip]='A11X'
call SetPlayerAbilityAvailable(p,LSP[ip],true)
endif
if l__W+l__W+l__W==id then
set LSP2[ip]=LSP[ip]
set LSP[ip]='A11O'
call SetPlayerAbilityAvailable(p,LSP[ip],true)
endif
if l__W+l__W+l__Q==id then
set LSP2[ip]=LSP[ip]
set LSP[ip]='A11M'
call SetPlayerAbilityAvailable(p,LSP[ip],true)
endif
if l__W+l__W+l__E==id then
set LSP2[ip]=LSP[ip]
set LSP[ip]='A11L'
call SetPlayerAbilityAvailable(p,LSP[ip],true)
endif
if l__E+l__E+l__E==id then
set LSP2[ip]=LSP[ip]
set LSP[ip]='A11V'
call SetPlayerAbilityAvailable(p,LSP[ip],true)
endif
if l__E+l__E+l__W==id then
set LSP2[ip]=LSP[ip]
set LSP[ip]='A11S'
call SetPlayerAbilityAvailable(p,LSP[ip],true)
endif
if l__E+l__E+l__Q==id then
set LSP2[ip]=LSP[ip]
set LSP[ip]='A11Y'
call SetPlayerAbilityAvailable(p,LSP[ip],true)
endif
if l__Q+l__W+l__E==id then
set LSP2[ip]=LSP[ip]
set LSP[ip]='A11N'
call SetPlayerAbilityAvailable(p,LSP[ip],true)
endif
call SaveUnitHandle(h,GetHandleId(t),0,u)
call TimerStart(t,0,false,function CreateSpellNamiCast2)
set t=null
set p=null
set u=null
endfunction
function NamiSystemCond takes nothing returns boolean
