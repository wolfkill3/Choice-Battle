function Stigmata_Cond takes nothing returns boolean
return GetSpellAbilityId()=='ISTs'
endfunction

function Stigmata_Cast takes nothing returns nothing
        local unit target=GetSpellTargetUnit()
        local real target_x = GetUnitX(target)
        local real target_y = GetUnitY(target)
        call ComboChecker(target,3,6, false )
        
        set n=CreateUnit(GetOwningPlayer(target), 'd071', target_x, target_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 3, 3, 3)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(target), 'd071', target_x, target_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 2, 2, 2)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(target), 'd072', target_x, target_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 0.3, 0.3, 0.3)
        call UnitApplyTimedLife(n, 1, 0.8)
        call MyRemoveUnit(n, 1.5)
        
        set target=null
endfunction

function InitTrig_StigmataInt takes nothing returns nothing
    local trigger trig= CreateTrigger()
    local integer index= 0
    loop
        call TriggerRegisterPlayerUnitEvent(trig, Player(index), EVENT_PLAYER_UNIT_SPELL_EFFECT, null)
        set index=index + 1
        exitwhen index == bj_MAX_PLAYER_SLOTS
    endloop
        call TriggerAddCondition(trig,Condition(function Stigmata_Cond))
    call TriggerAddAction(trig, function Stigmata_Cast)
        set trig=null
endfunction

//=========================================== Vergil New

function VergilW_SD2 takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit dummy     = LoadUnitHandle(h, id, 0)
    local unit target    = LoadUnitHandle(h, id, 1)
    local real duration  = LoadReal(h, id, 2)-0.02

    if duration>=0 and GetWidgetLife(target)>1 and target!=null then
        call SaveReal(h, id, 2, duration)
        call SetUnitXY(dummy, GetUnitX(target), GetUnitY(target))
    else
        call KillUnit(dummy)
        call MyRemoveUnit(dummy, 0.2)
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set newTimer = null
    set dummy = null
    set target = null
endfunction

function VergilW_SwordDelay takes unit dummy, unit target, real duration returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)

    call SaveUnitHandle(h, id, 0, dummy)
    call SaveUnitHandle(h, id, 1, target)
    call SaveReal(h, id, 2, duration)
    call TimerStart(newTimer, 0.02, true, function VergilW_SD2)

    set newTimer = null
endfunction


function VergilWAttack_Periodic takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    d_sword  = LoadUnitHandle(h, id, 3)
    local real    angle    = AU(d_sword, LoadUnitHandle(h, id, 2)) //LoadReal(h, id, 6)
    local real    distance = LoadReal(h, id, 5)
    local real    dummy_x  = GetUnitX(d_sword)
    local real    dummy_y  = GetUnitY(d_sword)
    local integer ability_level = GetUnitAbilityLevel(LoadUnitHandle(h, id, 1), 'VerW')
    local real    damage   = GetHeroAgi(LoadUnitHandle(h, id, 1), true)*(0.2*ability_level) + (10+10*ability_level)
    local boolean delay    = LoadBoolean(h, id, 100)
    if distance>0 and LoadUnitHandle(h, id, 2)!=null and GetWidgetLife(LoadUnitHandle(h, id, 2))>=1 then
        call SetUnitX(d_sword, dummy_x+80*Cos(angle))
        call SetUnitY(d_sword, dummy_y+80*Sin(angle))
        call SetUnitFacing(d_sword, angle*bj_RADTODEG)
        call SaveReal(h, id, 5, distance-80)
        set bjLCG = CreateGroup()
        call GroupEnumUnitsInRange(bjLCG, dummy_x, dummy_y, 100, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
            if Condition_Base(GetOwningPlayer(d_sword), E) then
                call SaveReal(h, id, 5, 0)
                call GroupClear(bjLCG)
                if delay==false then
                    call SaveReal(h, id, 6, angle)
                    call AGilPush(E,10,angle,40)
                    call VergilW_SwordDelay(d_sword, E, 1.3)
                    call SaveBoolean(h, id, 100, true)
                endif
                call SetUnitX(d_sword, dummy_x+60*Cos(angle))
                call SetUnitY(d_sword, dummy_y+60*Sin(angle))
            endif
            call GroupRemoveUnit(bjLCG, E)
        endloop
        call DestroyGroup(bjLCG)
    else
        set angle = LoadReal(h, id, 6)

        set n=CreateUnit(GetOwningPlayer(d_sword), 'd136', dummy_x, dummy_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call SetUnitFlyHeight(n, 100, 0)
        call MyRemoveUnit(n, 2.5)
        set n=CreateUnit(GetOwningPlayer(d_sword), 'd137', dummy_x, dummy_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call SetUnitFlyHeight(n, 50, 0)
        call MyRemoveUnit(n, 2.5)
        set n=CreateUnit(GetOwningPlayer(d_sword), 'd238', dummy_x, dummy_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call SetUnitFlyHeight(n, 50, 0)
        call MyRemoveUnit(n, 2.5)
        set n=CreateUnit(GetOwningPlayer(d_sword), 'dH50', dummy_x, dummy_y, GetRandomInt(0, 360))
		call SetUnitScale(n, 2, 2, 2)
		call SetUnitFlyHeight(n, 40, 0)
		call MyRemoveUnit(n, 1.5)
		// set n=CreateUnit(GetOwningPlayer(d_sword), 'dH51', dummy_x, dummy_y, GetRandomInt(0, 360))
		// call SetUnitScale(n, 0.75, 0.75, 0.75)
		// call MyRemoveUnit(n, 1.5)
        // set n=CreateUnit(GetOwningPlayer(d_sword), 'dH52', dummy_x, dummy_y, GetRandomInt(0, 360))
        // call SetUnitScale(n, 1.5, 1.5, 1.5)
        // call MyRemoveUnit(n, 1.5)

        // set n=CreateUnit(GetOwningPlayer(d_sword), 'd052', dummy_x, dummy_y, angle*bj_RADTODEG+120)
        // call SetUnitScale(n, 5, 5, 5)
        // call SetUnitFlyHeight(n, 150, 0)
        // call MyRemoveUnit(n, 2.5)
        // set n=CreateUnit(GetOwningPlayer(d_sword), 'dR13', dummy_x, dummy_y, angle*bj_RADTODEG+120)
        // call SetUnitScale(n, 0.5, 0.5, 0.5)
        // call SetUnitFlyHeight(n, 0, 0)
        // call MyRemoveUnit(n, 3.5)
        // set n = CreateUnit(GetOwningPlayer(d_sword), 'd111', dummy_x, dummy_y, angle*bj_RADTODEG)
        // call SetUnitScale(n, 0.8, 0.8, 0.8)
        // call SetUnitTimeScale(n, 0.8)
        // call SetUnitFlyHeight(n, 0, 0)
        // call SetUnitVertexColor(n, 255, 0, 0, 255)
        // call MyRemoveUnit(n, 1.5)

        call GroupEnumUnitsInRange(G, dummy_x, dummy_y, 150, Base)
        loop
        set E=FirstOfGroup(G)
        exitwhen E==null
        if Condition_Base(GetOwningPlayer(d_sword), E) then
            call myCustomDamage(LoadUnitHandle(h, id, 1), E, damage , false , false , null , null , null)
            call AGilPush(E,10,angle,40)
            if delay==false then
                call VergilW_SwordDelay(d_sword, E, 1.3)
                call SaveBoolean(h, id, 100, true)
            endif
        endif
        call GroupRemoveUnit(G, E)
        endloop
        //call RemoveUnit(LoadUnitHandle(h, id, 7))
        if delay==false then
            call KillUnit(d_sword)
            call MyRemoveUnit(d_sword, 1.3)
        endif
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set newTimer = null
    set d_sword  = null
endfunction

function VergilWAttack_WaitTime takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    d_sword = LoadUnitHandle(h, id, 3)
    local real    angle   = AU(d_sword, LoadUnitHandle(h, id, 2))
    set n = CreateUnit(GetOwningPlayer(d_sword), 'dR42', GetUnitX(d_sword), GetUnitY(d_sword), angle*bj_RADTODEG)
    call SetUnitScale(n, 0.75, 0.75, 0.75)
	call SetUnitTimeScale(n, 0.75)
	call MyRemoveUnit(n , 1.5)
    
    // set n = CreateUnit(GetOwningPlayer(d_sword), 'd099', GetUnitX(d_sword), GetUnitY(d_sword), angle*bj_RADTODEG+180)
    // call SetUnitScale(n, 1.5, 1.5, 1.5)
	// call SetUnitFlyHeight(n, GetUnitFlyHeight(d_sword), 0)
    // call SetUnitTimeScale(n, 2.0)
	// call SaveUnitHandle(h, id, 7, n)
    call SetUnitFacingInstant(d_sword, angle*bj_RADTODEG)
    call SaveReal(h, id, 6, angle)
    call TimerStart(newTimer, 0.02, true, function VergilWAttack_Periodic)
    set newTimer = null
    set d_sword  = null
endfunction

function VergilW_SingleSwordTarget takes unit newCaster, unit newTarget returns nothing
    local unit source = newCaster
    local unit target = newTarget
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id   = GetHandleId(source)
    local group   g_swords = LoadGroupHandle(HH, c_id, KarnaW_Swords)
    local unit    d_sword  = FirstOfGroup(g_swords)
    local real    damage   = GetHeroAgi(source, true) * (GetUnitAbilityLevel(source, 'KaA6')*0.2)
    local real    angle    = AU(d_sword, target)
    if d_sword!=null then
        if GetRandomInt(0, 1)==0 then
            set soundplay=CreateSound("Sound\\Music\\mp3Music\\VergilF.mp3",false,false,true,12700,12700,"")
        else
            set soundplay=CreateSound("Sound\\war3mapImported\\VergilW_Sound"+I2S(GetRandomInt(1,2))+".mp3",false,false,true,12700,12700,"")
        endif
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        call GroupRemoveUnit(g_swords, d_sword)
        // set n = CreateUnit(GetOwningPlayer(source), 'd110', GetUnitX(d_sword), GetUnitY(d_sword), AU(d_sword, target)*bj_RADTODEG)
        // call SetUnitScale(n, 1.0, 1.0, 1.0)
        // call SetUnitFlyHeight(n, GetUnitFlyHeight(d_sword), 0)
        // call RemoveUnit(d_sword)
        // set d_sword = n
        set n = CreateUnit(GetOwningPlayer(d_sword), 'dH35', GetUnitX(d_sword)+35*Cos(angle), GetUnitY(d_sword)+35*Sin(angle), angle*bj_RADTODEG)
        //call SetUnitScale(n, 0.75, 0.75, 0.75)
        call SetUnitFlyHeight(n, GetUnitFlyHeight(d_sword), 0)
        call MyRemoveUnit(n , 1.5)

        call SetUnitAnimation(d_sword, "Spell")
        call SaveUnitHandle(h, id, 1, source)
        call SaveUnitHandle(h, id, 2, target)
        call SaveUnitHandle(h, id, 3, d_sword)
        call SaveReal(h, id, 4, damage)
        call SaveReal(h, id, 5, 10000)
        call TimerStart(newTimer, 0.1, false, function VergilWAttack_WaitTime)
    else
        call DestroyTimer(newTimer)
    endif
    set source = null
    set target = null
    set g_swords = null
endfunction


function VergilW_TargetPeriodic takes nothing returns nothing 
    local timer newTimer = GetExpiredTimer()
    local integer id     = GetHandleId(newTimer)
    local unit    caster = LoadUnitHandle(h, id, 0)
    local unit    target = LoadUnitHandle(h, id, 1)
    local integer c_id   = GetHandleId(caster)
    local real    duration = LoadReal(h, id, 2)+0.02
    local real    angle    = 0.0
    local real    distance = 0.0
    local group   g_swords = LoadGroupHandle(HH, c_id, KarnaW_Swords)
    local integer index    = 0
    if caster==null then
        set g_swords = LoadGroupHandle(h, id, 100)
        loop
        set E=FirstOfGroup(g_swords)
        exitwhen E==null
            call RemoveSavedReal(HH, GetHandleId(E), 0)
            call RemoveUnit(E)
            call GroupRemoveUnit(g_swords, E)
        endloop
        call DestroyGroup(g_swords)
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    else
        if FirstOfGroup(g_swords)!=null then
            if IsUnitPaused(caster)==false then
                call SaveReal(h, id, 2, duration)
            endif
            set bjLCG = CopyGroup(g_swords)
            loop
            set E=FirstOfGroup(bjLCG)
            exitwhen E==null
                set angle    = LoadReal(HH, GetHandleId(E), 0)
                set distance = LoadReal(HH, GetHandleId(E), 1)
                call SetUnitX(E, GetUnitX(caster)+(distance)*Cos(angle))
                call SetUnitY(E, GetUnitY(caster)+(distance)*Sin(angle))
                call SetUnitFacing(E, AU(caster, target)*bj_RADTODEG)
                call GroupRemoveUnit(bjLCG, E)
            endloop
            call DestroyGroup(bjLCG)
            if duration>1.0 then
                if LoadReal(h, id, 3)>=0.1 then
                    call VergilW_SingleSwordTarget(caster, target)
                    call SaveReal(h, id, 3, 0)
                else
                    call SaveReal(h, id, 3, LoadReal(h, id, 3)+0.02)
                endif
            endif
        else
            loop
            set E=FirstOfGroup(g_swords)
            exitwhen E==null
                call RemoveSavedReal(HH, GetHandleId(E), 0)
                call RemoveUnit(E)
                call GroupRemoveUnit(g_swords, E)
            endloop
            call DestroyGroup(g_swords)
            call FlushChildHashtable(h, id)
            call DestroyTimer(newTimer)
        endif
    endif
    set newTimer = null
    set caster   = null
    set target   = null
    set g_swords = null
endfunction

function VergilW_Target takes unit newCaster, unit newTarget returns nothing
    local timer newTimer = CreateTimer()
    local integer id     = GetHandleId(newTimer)
    local integer c_id   = GetHandleId(newCaster)
    local real caster_x  = GetUnitX(newCaster)
    local real caster_y  = GetUnitY(newCaster)
    local real angle     = AU(newCaster, newTarget)
    local group g_swords = CreateGroup()
    local integer index  = 1

    if GetRandomInt(0, 1)==0 then
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\VergilW.mp3",false,false,true,12700,12700,"")
    else
        set soundplay=CreateSound("Sound\\war3mapImported\\VergilW_Sound.mp3",false,false,true,12700,12700,"")
    endif
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)

    // set n=CreateUnit(p,0x6530484A, caster_x, caster_y, GetRandomReal(0,359))
    // call UnitApplyTimedLife(n, 1, 2)
    // call SetUnitTimeScale(n, 0.3)
    // set n=CreateUnit(p,0x6530484B, caster_x, caster_y, GetRandomReal(0,359))
    // call UnitApplyTimedLife(n, 1, 2)
    // call SetUnitTimeScale(n ,0.4)

    set n=CreateUnit(GetOwningPlayer(newCaster), 'e0O0', caster_x+70*Cos(angle+deg90), caster_y+70*Sin(angle+deg90), angle*bj_RADTODEG)
    call GroupAddUnit(g_swords, n)
    call SaveReal(HH, GetHandleId(n), 0, AU(newCaster, n))
    call SaveReal(HH, GetHandleId(n), 1, 70)
    set E=CreateUnit(GetOwningPlayer(newCaster), 'dR54', GetUnitX(n), GetUnitY(n), GetRandomInt(0, 360))
    call SetUnitScale(E, 0.55, 0.55, 0.55)
    call SetUnitFlyHeight(E, GetUnitFlyHeight(n), 0)
    call MyRemoveUnit(E, 2.0)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'e0O0', caster_x-70*Cos(angle+deg90), caster_y-70*Sin(angle+deg90), angle*bj_RADTODEG)
    call GroupAddUnit(g_swords, n)
    call SaveReal(HH, GetHandleId(n), 0, AU(newCaster, n))
    call SaveReal(HH, GetHandleId(n), 1, 70)
    set E=CreateUnit(GetOwningPlayer(newCaster), 'dR54', GetUnitX(n), GetUnitY(n), GetRandomInt(0, 360))
    call SetUnitScale(E, 0.55, 0.55, 0.55)
    call SetUnitFlyHeight(E, GetUnitFlyHeight(n), 0)
    call MyRemoveUnit(E, 2.0)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'e0O0', caster_x+100*Cos(angle+deg90), caster_y+100*Sin(angle+deg90), angle*bj_RADTODEG)
    call SetUnitFlyHeight(n,120,0)
    call GroupAddUnit(g_swords, n)
    call SaveReal(HH, GetHandleId(n), 0, AU(newCaster, n))
    call SaveReal(HH, GetHandleId(n), 1, 100)
    set E=CreateUnit(GetOwningPlayer(newCaster), 'dR54', GetUnitX(n), GetUnitY(n), GetRandomInt(0, 360))
    call SetUnitScale(E, 0.55, 0.55, 0.55)
    call SetUnitFlyHeight(E, GetUnitFlyHeight(n), 0)
    call MyRemoveUnit(E, 2.0)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'e0O0', caster_x-100*Cos(angle+deg90), caster_y-100*Sin(angle+deg90), angle*bj_RADTODEG)
    call SetUnitFlyHeight(n,120,0)
    call GroupAddUnit(g_swords, n)
    call SaveReal(HH, GetHandleId(n), 0, AU(newCaster, n))
    call SaveReal(HH, GetHandleId(n), 1, 100)
    set E=CreateUnit(GetOwningPlayer(newCaster), 'dR54', GetUnitX(n), GetUnitY(n), GetRandomInt(0, 360))
    call SetUnitScale(E, 0.55, 0.55, 0.55)
    call SetUnitFlyHeight(E, GetUnitFlyHeight(n), 0)
    call MyRemoveUnit(E, 2.0)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'e0O0', caster_x+70*Cos(angle+deg90), caster_y+70*Sin(angle+deg90), angle*bj_RADTODEG)
    call SetUnitFlyHeight(n,180,0)
    call GroupAddUnit(g_swords, n)
    call SaveReal(HH, GetHandleId(n), 0, AU(newCaster, n))
    call SaveReal(HH, GetHandleId(n), 1, 70)
    set E=CreateUnit(GetOwningPlayer(newCaster), 'dR54', GetUnitX(n), GetUnitY(n), GetRandomInt(0, 360))
    call SetUnitScale(E, 0.55, 0.55, 0.55)
    call SetUnitFlyHeight(E, GetUnitFlyHeight(n), 0)
    call MyRemoveUnit(E, 2.0)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'e0O0', caster_x-70*Cos(angle+deg90), caster_y-70*Sin(angle+deg90), angle*bj_RADTODEG)
    call SetUnitFlyHeight(n,180,0)
    call SaveReal(HH, GetHandleId(n), 0, AU(newCaster, n))
    call SaveReal(HH, GetHandleId(n), 1, 70)
    call GroupAddUnit(g_swords, n)
    set E=CreateUnit(GetOwningPlayer(newCaster), 'dR54', GetUnitX(n), GetUnitY(n), GetRandomInt(0, 360))
    call SetUnitScale(E, 0.55, 0.55, 0.55)
    call SetUnitFlyHeight(E, GetUnitFlyHeight(n), 0)
    call MyRemoveUnit(E, 2.0)
    
    // set n = CreateUnit(GetOwningPlayer(newCaster), 'd111', caster_x, caster_y, angle)
    // call SetUnitScale(n, 0.8, 0.8, 0.8)
    // call SetUnitTimeScale(n, 0.8)
    // call SetUnitFlyHeight(n, 0, 0)
    // call MyRemoveUnit(n, 1.5)

    call SaveGroupHandle(HH, c_id, KarnaW_Swords, g_swords)
    call SaveUnitHandle(h, id, 0, newCaster)
    call SaveUnitHandle(h, id, 1, newTarget)
    call SaveGroupHandle(h, id, 100, g_swords)
    call TimerStart(newTimer, 0.02, true, function VergilW_TargetPeriodic)

    set newTimer = null
    set g_swords = null
endfunction

function VergilW_Cast takes unit newCaster, unit newTarget returns nothing
    if newCaster!=newTarget then
        call VergilW_Target(newCaster, newTarget)
        set n=LoadUnitHandle(h,GetHandleId(newCaster),StringHash("clone"))
	    if n!=null then
            call VergilW_Target(n, newTarget)
        endif
    else

    endif
    set n=LoadUnitHandle(HH, GetHandleId(newCaster), StringHash("VergilD"))
	call RemoveUnit(n)
	set n=CreateUnit(GetOwningPlayer(newCaster), 'd081', 0.0, 0.0, 0.0)
	call SaveUnitHandle(HH, GetHandleId(newCaster), StringHash("VergilD"), n)
	call MyRemoveUnit(n, 3)
endfunction


