        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
    //endif
endfunction


function YujiF_Periodic takes nothing returns nothing
    local integer id            = GetHandleId(GetExpiredTimer())
        local unit        caster        = LoadUnitHandle(h, id, c_CASTER)
    local integer id_caster     = GetHandleId(caster)
    local integer act           = LoadInteger(h, id, c_ACT)
    local integer index_integer= LoadInteger(h, id, StringHash("IndexEffect"))
    local real angle            = 0
    local real time                     = LoadReal(h, id, c_TIME)
        local real point_x              = LoadReal(h, id, c_POINT_X)
        local real point_y              = LoadReal(h, id, c_POINT_Y)
    if act < 3 and time<10 then
        if act == 1 then
            // call PauseUnit(caster, true)
            // call SetUnitInvulnerable(caster, true)
            if time < 2 then
                call SaveReal(h, id, c_TIME, time + 0.05)
                // if LoadInteger(h, id, StringHash("PeriodIndexEffect")) == 0 then
                    // call SaveInteger(h, id, StringHash("PeriodIndexEffect"), 1)
                    if index_integer < 30 then
                        set n=CreateUnit(GetOwningPlayer(caster), 'eYG0', point_x+2050*Cos(12*index_integer*bj_DEGTORAD), point_y+2050*Sin(12*index_integer*bj_DEGTORAD), 12*index_integer)
                        call SetUnitScale(n, 1.8, 1.8, 1.8)
                        call SetUnitFlyHeight(n, 100, 0)
                        call SetUnitTimeScale(n, 0.4)
                        call GroupAddUnit(LoadGroupHandle(h, id, StringHash("GroupEffect")), n)
                        call SaveInteger(h, id, StringHash("IndexEffect"), index_integer + 1)
                    endif
                // else
                    // call SaveInteger(h, id, StringHash("PeriodIndexEffect"), LoadInteger(h, id, StringHash("PeriodIndexEffect")) - 1)
                // endif
                if LoadBoolean(HH,GetHandleId(caster),TARGET_ABILITY)==true or GetUnitAbilityLevel(caster,'CBC2')>0 or GetUnitAbilityLevel(caster,'cbc3')>0 or GetUnitAbilityLevel(caster,'cbc5')>0 or GetUnitAbilityLevel(caster,'cbc6')>0 or GetUnitAbilityLevel(caster, 'cbc7')>0 or GetUnitAbilityLevel(caster, 'cbc8')>0 or GetUnitAbilityLevel(caster, 'cbc9')==0 then
                    call SaveInteger(h, id, c_ACT, 3)
                endif
            else
                call SetUnitAnimation(LoadUnitHandle(h, id, StringHash("EffectUnit2")), "stand")
                // call PauseUnit(caster, false)
                                // call SetUnitInvulnerable(caster, false)
                call SaveInteger(h, id, c_ACT, 2)
                call SaveReal(h, id, c_TIME, 0)
            endif
        elseif act == 2 then
            if GetWidgetMana(caster) > 50 and UnitIsAlive(caster) and udg_B then
                call SetWidgetMana(caster , GetWidgetMana(caster) - GetWidgetMaxMana(caster) * 0.004)
                if IsUnitPaused(caster) == false then
                                        call SaveReal(h, id, c_TIME, time + 0.05)
                endif
                if LoadBoolean(h, id_caster, StringHash("YujiF_ForcedCancel")) or SquareRootPoint(point_x, point_y, GetUnitX(caster), GetUnitY(caster))>2300 then
                    call SaveInteger(h, id, c_ACT, 3)
                endif
                set bjLCG=LoadGroupHandle(h, id, c_GROUP1)
                call GroupEnumUnitsInRange(bjLCG, point_x, point_y, 10000, Base)
                loop
                set bjLCU=FirstOfGroup(bjLCG)
                exitwhen bjLCU == null
                if SquareRootPoint(point_x, point_y, GetUnitX(bjLCU), GetUnitY(bjLCU)) < 2000 or GetUnitAbilityLevel(bjLCU, 'YuFe')>0 then
                    if SquareRootPoint(point_x, point_y, GetUnitX(bjLCU), GetUnitY(bjLCU)) > 2000 then
                        set angle=AP(point_x, point_y, GetUnitX(bjLCU), GetUnitY(bjLCU))
                        call SetUnitX(bjLCU, point_x + 2000 * Cos(angle))
                        call SetUnitY(bjLCU, point_y + 2000 * Sin(angle))
                    else
                        if GetUnitAbilityLevel(bjLCU, 'YuFe')==0 then
                                                        call UnitAddAbility(bjLCU, 'YuFe')
                        endif
                    endif
                    if bjLCU!=caster and GetUnitAbilityLevel(E, 'CE04')==0 then
                            call SetControlToUnit(caster, bjLCU, 0.2, "silence")
                    endif
                endif
                call GroupRemoveUnit(bjLCG, bjLCU)
                endloop
            else
                call SaveInteger(h, id, c_ACT, 3)
            endif
        endif
    else
                set bjLCG=LoadGroupHandle(h, id, StringHash("GroupEffect"))
                loop
                set E=FirstOfGroup(bjLCG)
                exitwhen E==null
                        call KillUnit(E)
                        call MyRemoveUnit(E, 1.5)
                        call GroupRemoveUnit(bjLCG, E)
                endloop
                
        set bjLCG=LoadGroupHandle(h, id, c_GROUP1)
        call GroupEnumUnitsInRange(bjLCG, point_x, point_y, 10000, Base)
        loop
        set bjLCU=FirstOfGroup(bjLCG)
        exitwhen bjLCU == null
        if GetUnitAbilityLevel(bjLCU, 'YuFe')>0 then
            call UnitRemoveAbility(bjLCU, 'YuFe')
        endif
        call GroupRemoveUnit(bjLCG, bjLCU)
        endloop
                
        call KillUnit(LoadUnitHandle(h, id, c_DUMMY1))
        call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY1) , 1)
        if LoadBoolean(h, id_caster, StringHash("YujiF_ForcedCancel")) then
            call SaveBoolean(h, id_caster, StringHash("YujiF_ForcedCancel"), false)
                        call RemoveSavedBoolean(h, id_caster, StringHash("YujiF_ForcedCancel"))
        endif
        call UnitRemoveAbility(caster, 'YuF2')
        call ShowAbility2( 'YujF' , true)
        call DestroyGroup(LoadGroupHandle(h, id, c_GROUP1))
        call DestroyGroup(LoadGroupHandle(h, id, c_GROUP2))
                call DestroyGroup(LoadGroupHandle(h, id, StringHash("GroupEffect")))
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
        set caster=null
endfunction

function YujiF_Cast takes unit newCaster,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local real caster_x= GetUnitX(newCaster)
    local real caster_y= GetUnitY(newCaster)
    set soundplay=CreateSound("Sound\\war3mapImported\\YujiF.mp3", false, false, true, 12700, 12700, "")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR44', caster_x, caster_y, 0)
    call SetUnitFlyHeight(bjLCU, 1, 0)
    call SetUnitAnimation(bjLCU, "birth")
    call SetUnitScale(bjLCU, 1.7, 1.7, 1.7)
    call SetUnitVertexColor(bjLCU, 255, 255, 255, 255)
    call SaveUnitHandle(h, id, c_DUMMY1, bjLCU)
    call ShowAbility2( 'YujF' , false)
    call UnitAddAbility(newCaster, 'YuF2')
    call SaveUnitHandle(h, id, c_CASTER, newCaster)
    call SaveReal(h, id, c_POINT_X, caster_x)
    call SaveReal(h, id, c_POINT_Y, caster_y)
    call SaveGroupHandle(h, id, c_GROUP1, CreateGroup())
    call SaveGroupHandle(h, id, c_GROUP2, CreateGroup())
        call SaveGroupHandle(h, id, StringHash("GroupEffect"), CreateGroup())
    call SaveInteger(h, id, c_ACT, 1)
    call TimerStart(newTimer, 0.05, true, function YujiF_Periodic)
endfunction




function YujiQ_BlastDamage takes unit newCaster,unit newDummy,real new_dmg,group new_group,group new_group2,unit new_dummy,boolean yuji_morf returns nothing
        set soundplay=CreateSound("Sound\\war3mapImported\\YujiQ_2.mp3", false, false, true, 12700, 12700, "")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    call GroupEnumUnitsInRange(new_group, GetUnitX(newDummy), GetUnitY(newDummy), 300, Base)
        loop
        set new_dummy=FirstOfGroup(new_group)
        exitwhen new_dummy == null
                if Condition_Base(GetOwningPlayer(newCaster) , new_dummy) == true and IsUnitInGroup(new_dummy, new_group2) == false then
                        call myCustomDamage(newCaster , new_dummy , new_dmg , false , false , null , null , null)
            if yuji_morf == true then
                call RemoveEffect(AddSpecialEffectTarget("az_tzfire2.mdl", newDummy, "origin") , 2 , true , CreateTimer())
            endif
            call GroupAddUnit(new_group2, new_dummy)
                endif
                call GroupRemoveUnit(new_group, new_dummy)
        endloop
    if yuji_morf == false then
                set n=CreateUnit(GetOwningPlayer(newCaster), 'dR68', GetUnitX(newDummy), GetUnitY(newDummy), GetRandomInt(0, 360))
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(newCaster), 'dR69', GetUnitX(newDummy), GetUnitY(newDummy), GetRandomInt(0, 360))
                call SetUnitScale(n, 3.2, 3.2, 3.2)
                call MyRemoveUnit(n, 1)
    else
                set n=CreateUnit(GetOwningPlayer(newCaster), 'dR70', GetUnitX(newDummy), GetUnitY(newDummy), GetRandomInt(0, 360))
                call SetUnitScale(n, 1.3, 1.3, 1.3)
                call MyRemoveUnit(n, 2)
                set n=CreateUnit(GetOwningPlayer(newCaster), 'dR43', GetUnitX(newDummy), GetUnitY(newDummy), GetRandomInt(0, 360))
                call SetUnitScale(n, 0.7, 0.7, 0.7)
                call UnitApplyTimedLife(n, 1, 0.6)
                call MyRemoveUnit(n, 2)
    endif
endfunction

function YujiQ_Period takes nothing returns nothing
        local integer id= GetHandleId(GetExpiredTimer())
        local unit caster=LoadUnitHandle(h, id, c_CASTER)
        local real distance= LoadReal(h, id, c_DISTANCE)
        local real angle= LoadReal(h, id, c_ANGLE)
        local real speed= 75 - distance * 0.005
    local real full_dmg= LoadReal(h, id, c_DAMAGE)
    local boolean Yuji_Morf= LoadBoolean(h, id, 15)
        if distance > 0 then
                set bjLCU=LoadUnitHandle(h, id, c_DUMMY1)
                call SetUnitX(bjLCU, GetUnitX(bjLCU) + speed * Cos(angle))
                call SetUnitY(bjLCU, GetUnitY(bjLCU) + speed * Sin(angle))
                call SetUnitFacing(bjLCU , angle * bj_RADTODEG)
        // if LoadInteger(h, id, EffectPeriodHash) == 0 then
            // set bjLCE=AddSpecialEffect("NDA! (849).mdl", GetUnitX(bjLCU), GetUnitY(bjLCU))
            // call SetSpecialEffectFacing(bjLCE , angle * bj_RADTODEG + GetRandomInt(- 45, 45))
            // call SetSpecialEffectVertexColour(bjLCE , 50 , 50 , 50 , 150)
            // call SetSpecialEffectZ(bjLCE , 150)
            // call DestroyEffect(bjLCE)
            // call RemoveEffect(bjLCE , 0.25 , false , CreateTimer())
            // call SaveInteger(h, id, EffectPeriodHash, 2)
        // else
            // call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash) - 1)
        // endif
                call SaveReal(h, id, c_DISTANCE, distance - speed)
        set bjLCG=LoadGroupHandle(h, id, c_GROUP1)
        call GroupEnumUnitsInRange(bjLCG, GetUnitX(bjLCU), GetUnitY(bjLCU), 350, Base)
        loop
        set bjLCU=FirstOfGroup(bjLCG)
        exitwhen bjLCU == null
            if Condition_Base(GetOwningPlayer(caster) , bjLCU) == true and IsUnitInGroup(bjLCU, LoadGroupHandle(h, id, c_GROUP2)) == false then
                call YujiQ_BlastDamage(caster, bjLCU , full_dmg , CreateGroup() , LoadGroupHandle(h, id, c_GROUP2) , null , Yuji_Morf)
                call GroupAddUnit(LoadGroupHandle(h, id, c_GROUP2), bjLCU)
            endif
            call GroupRemoveUnit(bjLCG, bjLCU)
        endloop
        else
                call DestroyGroup(LoadGroupHandle(h, id, c_GROUP1))
                call DestroyGroup(LoadGroupHandle(h, id, c_GROUP2))
        call KillUnit(LoadUnitHandle(h, id, c_DUMMY1))
                call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY1) , 1)
                call FlushChildHashtable(h, id)
                call DestroyTimer(GetExpiredTimer())
        endif
        set caster=null
endfunction

function YujiQ_Cast takes unit newCaster,real point_x,real point_y,timer newTimer returns nothing
        local integer id= GetHandleId(newTimer)
    local integer id_caster= GetHandleId(newCaster)
        local real caster_x= GetUnitX(newCaster)
        local real caster_y= GetUnitY(newCaster)
        local real angle= AP(caster_x , caster_y , point_x , point_y)
    local real distance= 1250+250*GetUnitAbilityLevel(newCaster, 'YujQ')
    local real dmg= (GetUnitAbilityLevel(newCaster, 'YujQ')*50+100) + GetHeroAgi(newCaster, true)* GetUnitAbilityLevel(newCaster, 'YujQ')
    local boolean YujiT_Morf= LoadBoolean(h, id_caster, StringHash("YujiT_Morf"))
    if YujiT_Morf == true then
        set dmg=dmg + GetHeroAgi(newCaster, true)*2
        set distance=distance + 1000
    endif
        call UnitAddAbility(newCaster, 'YuQ1')
        call UnitMakeAbilityPermanent(newCaster, true, 'YuQ1')
        call UnitRemoveAbilityTimed_ExD(newCaster, 'YuQ1', 5.0)
    set soundplay=CreateSound("Sound\\war3mapImported\\YujiQ1.mp3", false, false, true, 12700, 12700, "")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR42', caster_x, caster_y , angle * bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 60, 0)
        call SetUnitTimeScale(bjLCU, 0.7)
    call MyRemoveUnit(bjLCU , 1.5)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR64', caster_x + 50 * Cos(angle), caster_y + 50 * Sin(angle), angle * bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 160, 0)
    call SetUnitScale(bjLCU, 1.2, 1.2, 1.2)
    if YujiT_Morf == false then
        call SetUnitVertexColor(bjLCU, 10, 10, 10, 255)
    endif
    call MyRemoveUnit(bjLCU , 1.5)
    if YujiT_Morf == false then
                set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR65', caster_x, caster_y, angle * bj_RADTODEG)
        call SetUnitScale(bjLCU, 2, 2, 2)
    else
                set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR66', caster_x, caster_y, angle * bj_RADTODEG)
        call SetUnitScale(bjLCU, 1.7, 1.7, 1.7)
    endif
    call SetUnitFlyHeight(bjLCU, 160, 0)
        call SaveUnitHandle(h, id, c_DUMMY1, bjLCU)
    call SetUnitAnimation(newCaster, "attack")
        call SaveUnitHandle(h, id, c_CASTER, newCaster)
        call SaveReal(h, id, c_ANGLE, angle)
    call SaveReal(h, id, c_DAMAGE, dmg)
        call SaveReal(h, id, c_DISTANCE, distance)
    call SaveBoolean(h, id, 15, YujiT_Morf)
        call SaveGroupHandle(h, id, c_GROUP1, CreateGroup())
        call SaveGroupHandle(h, id, c_GROUP2, CreateGroup())
        call TimerStart(newTimer, 0.02, true, function YujiQ_Period)
endfunction

function YujiW_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
        local unit caster = LoadUnitHandle(h, id, c_CASTER)
    local integer act= LoadInteger(h, id, c_ACT)
    local real time= LoadReal(h, id, c_TIME)
    local real angle= LoadReal(h, id, c_ANGLE)
    local real caster_x= GetUnitX(caster)
    local real caster_y= GetUnitY(caster)
        local real point_x=LoadReal(h, id, c_POINT_X)
        local real point_y=LoadReal(h, id, c_POINT_Y)
    if act > 0 then
        call SaveReal(h, id, c_TIME, time + 0.02)
        if time == 0.2 then
            call SetUnitAnimationByIndex(caster, 7)
        elseif time < 0.5 then
            if LoadInteger(h, id, c_EFFPERIOD) == 0 then
                if act == 1 then
                                        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR73', caster_x, caster_y, GetRandomInt(0, 360))
                                        call SetUnitScale(bjLCU, 2, 2, 2)
                                        call SetUnitVertexColor(bjLCU, 255, 255, 255, 150)
                                        call SetUnitFlyHeight(bjLCU, 5, 0)
                                        call SetUnitAnimationByIndex(bjLCU, 0)
                                        call MyRemoveUnit(bjLCU, 0.5)
                else
                                        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR74', caster_x, caster_y, GetRandomInt(0, 360))
                                        call SetUnitScale(bjLCU, 1.2, 1.2, 1.2)
                                        call SetUnitVertexColor(bjLCU, 255, 255, 255, 100)
                                        call SetUnitFlyHeight(bjLCU, 1, 0)
                                        call KillUnit(bjLCU)
                                        call MyRemoveUnit(bjLCU, 0.7)
                endif
                call SaveInteger(h, id, c_EFFPERIOD, 8)
            else
                call SaveInteger(h, id, c_EFFPERIOD, LoadInteger(h, id, c_EFFPERIOD) - 1)
            endif
        endif
        if time == 0.5 then
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR75', caster_x + 80 * Cos(angle), caster_y + 80 * Sin(angle), angle * bj_RADTODEG)
            call SetUnitTimeScale(bjLCU, 0.6)
            call SetUnitFlyHeight(bjLCU, 125, 0)
            call MyRemoveUnit(bjLCU , 1.5)
                        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR76', caster_x, caster_y, GetRandomInt(0, 360))
                        call SetUnitScale(bjLCU, 0.65, 0.65, 0.65)
                        call SetUnitTimeScale(bjLCU, 0.5)
                        call MyRemoveUnit(bjLCU, 0.7)
                        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR76', caster_x, caster_y, GetRandomInt(0, 360))
                        call SetUnitTimeScale(bjLCU, 0.5)
                        call MyRemoveUnit(bjLCU, 0.7)
        endif
        if time == 1 then
                        set act=act-1
                        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR77', point_x, point_y, GetRandomInt(0,360))
                        call SetUnitScale(bjLCU, 0.7, 0.7, 0.7)
                        call SetUnitFlyHeight(bjLCU, 5, 0)
                        call SetUnitAnimation(bjLCU, "stand")
                        call UnitApplyTimedLife(bjLCU, 1, 0.2+act*5)
                        call MyRemoveUnit(bjLCU, 1.5+act*5)
                        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR78', point_x, point_y, 0)
                        call SetUnitScale(bjLCU, 3.4, 3.4, 3.4)
                        call UnitApplyTimedLife(bjLCU, 1, 0.2+act*5)
                        call MyRemoveUnit(bjLCU, 1.5+act*5)
                        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR78', point_x, point_y, 45)
                        call SetUnitScale(bjLCU, 3.4, 3.4, 3.4)
                        call UnitApplyTimedLife(bjLCU, 1, 0.2+act*5)
                        call MyRemoveUnit(bjLCU, 1.5+act*5)
                        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR78', point_x, point_y, 90)
                        call SetUnitScale(bjLCU, 3.4, 3.4, 3.4)
                        call UnitApplyTimedLife(bjLCU, 1, 0.2+act*5)
                        call MyRemoveUnit(bjLCU, 1.5+act*5)
            call SaveInteger(h, id, c_ACT, act)
            call SaveBoolean(h, id, StringHash("Act2_Bool"), true)
            set bjLCG=LoadGroupHandle(h, id, c_GROUP1)
            call GroupEnumUnitsInRange(bjLCG, point_x, point_y, 450, Base)
            loop
            set bjLCU=FirstOfGroup(bjLCG)
            exitwhen bjLCU == null
                if Condition_Base(GetOwningPlayer(caster) , bjLCU) == true then
                    call myCustomDamage(caster , bjLCU , LoadReal(h, id, c_DAMAGE) , false , false , null , null , null)
                    set n=CreateUnit(GetOwningPlayer(caster), 'dAlb', GetUnitX(bjLCU), GetUnitY(bjLCU), 0)
                    call UnitAddAbility(n, 'YuWd')
                    call IssueTargetOrder(n, "drunkenhaze", bjLCU)
                    call MyRemoveUnit(n , 1)
                endif
            call GroupRemoveUnit(bjLCG, bjLCU)
            endloop
            call PauseUnit(caster, false)
            call SetUnitInvulnerable(caster, false)
            call ShakeCamera(0.3 , 10)
            if LoadInteger(h, id, c_ACT) == 1 then
                set bj_forLoopAIndex=0
                loop
                exitwhen bj_forLoopAIndex == 12
                                        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR79', point_x + 390 * Cos(angle + ( bj_forLoopAIndex * 30 ) * bj_DEGTORAD), point_y + 390 * Sin(angle + ( bj_forLoopAIndex * 30 ) * bj_DEGTORAD), 0)
                    call SetUnitFlyHeight(bjLCU, 5, 0)
                                        call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
                                        call UnitApplyTimedLife(bjLCU, 1, 6)
                                        call MyRemoveUnit(bjLCU, 7)
                                        set bj_forLoopAIndex=bj_forLoopAIndex + 1
                endloop
                                
                set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR80', point_x, point_y, GetRandomInt(0, 360))
                                call SetUnitFlyHeight(bjLCU, 5, 0)
                                call SetUnitScale(bjLCU, 2, 2, 2)
                                call SetUnitTimeScale(bjLCU, 0.5)
                                call MyRemoveUnit(bjLCU, 1.5)
                                set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR70', point_x, point_y, 0)
                                call SetUnitFlyHeight(bjLCU, 1, 0)
                                call SetUnitScale(bjLCU, 2.5, 2.5, 2.5)
                                call MyRemoveUnit(bjLCU, 1.5)
                                set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR70', point_x, point_y, 90)
                                call SetUnitFlyHeight(bjLCU, 1, 0)
                                call SetUnitScale(bjLCU, 2.5, 2.5, 2.5)
                                call MyRemoveUnit(bjLCU, 1.5)
                                
                                set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR81', point_x, point_y, 90)
                                call SetUnitFlyHeight(bjLCU, 1, 0)
                                call SetUnitScale(bjLCU, 2, 2, 2)
                                call UnitApplyTimedLife(bjLCU, 1, 2)
                                call MyRemoveUnit(bjLCU, 2.5)
                                set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR43', point_x, point_y, 90)
                                call SetUnitFlyHeight(bjLCU, 1, 0)
                                call UnitApplyTimedLife(bjLCU, 1, 0.8)
                                call MyRemoveUnit(bjLCU, 1.5)
                                // set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR82', point_x, point_y, 90)
                                // call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
                                // call MyRemoveUnit(bjLCU, 3)
                                
            else
                                set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR83', point_x, point_y, 90)
                                call SetUnitScale(bjLCU, 2, 2, 2)
                                call SetUnitFlyHeight(bjLCU, 2, 0)
                                call MyRemoveUnit(bjLCU, 1.5)
                set bj_forLoopAIndex=1
                loop
                exitwhen bj_forLoopAIndex == 7
                    //bymutou_huozhu_siwang-baise.mdl
                    //by_wood_k_huoyantuowei.mdl
                                        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR69', point_x + 250 * Cos(( 60 * bj_forLoopAIndex ) * bj_DEGTORAD), point_y + 250 * Sin(( 60 * bj_forLoopAIndex ) * bj_DEGTORAD), 90)
                                        call SetUnitScale(bjLCU, 4, 4, 4)
                                        call SetUnitFlyHeight(bjLCU, 2, 0)
                                        call MyRemoveUnit(bjLCU, 1)
                                        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR68', point_x + 250 * Cos(( 60 * bj_forLoopAIndex ) * bj_DEGTORAD), point_y + 250 * Sin(( 60 * bj_forLoopAIndex ) * bj_DEGTORAD), 90)
                                        call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
                                        call SetUnitFlyHeight(bjLCU, 2, 0)
                                        call MyRemoveUnit(bjLCU, 1.5)
                                
                    set bj_forLoopAIndex=bj_forLoopAIndex + 1
                endloop
            endif
        endif
        if LoadBoolean(h, id, StringHash("Act2_Bool")) == true and time < 6 then
            set bjLCG=LoadGroupHandle(h, id, c_GROUP1)
            call GroupEnumUnitsInRange(bjLCG, point_x, point_y, 450, Base)
            loop
            set bjLCU=FirstOfGroup(bjLCG)
            exitwhen bjLCU == null
                if Condition_Base(GetOwningPlayer(caster) , bjLCU) == true then
                    call GroupAddUnit(LoadGroupHandle(h, id, c_GROUP2), bjLCU)
                endif
            call GroupRemoveUnit(bjLCG, bjLCU)
            endloop
            set bjLCG=LoadGroupHandle(h, id, c_GROUP3)
            loop
            set bjLCU=FirstOfGroup(bjLCG)
            exitwhen bjLCU == null
                call GroupAddUnit(LoadGroupHandle(h, id, c_GROUP2), bjLCU)
                call GroupRemoveUnit(bjLCG, bjLCU)
            endloop
            set bjLCG=LoadGroupHandle(h, id, c_GROUP2)
            loop
            set bjLCU=FirstOfGroup(bjLCG)
            exitwhen bjLCU == null
                set angle=AP(point_x , point_y , GetUnitX(bjLCU) , GetUnitY(bjLCU))
                if SquareRootPoint(point_x , point_y , GetUnitX(bjLCU) , GetUnitY(bjLCU)) < 500 then
                    if SquareRootPoint(point_x , point_y , GetUnitX(bjLCU) , GetUnitY(bjLCU)) > 400 then
                        call SetUnitX(bjLCU, point_x + 400 * Cos(angle))
                        call SetUnitY(bjLCU, point_y + 400 * Sin(angle))
                    endif
                    call GroupAddUnit(LoadGroupHandle(h, id, c_GROUP3), bjLCU)
                endif
            call GroupRemoveUnit(bjLCG, bjLCU)
            endloop
        endif
        if time >= 6 then
            call SaveInteger(h, id, c_ACT, 0)
        endif
    else
                call KillUnit(LoadUnitHandle(h, id, c_DUMMY1))
                call KillUnit(LoadUnitHandle(h, id, c_DUMMY2))
        call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY1) , 1)
        call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY2) , 1)
        call DestroyGroup(LoadGroupHandle(h, id, c_GROUP1))
        call DestroyGroup(LoadGroupHandle(h, id, c_GROUP2))
        call DestroyGroup(LoadGroupHandle(h, id, c_GROUP3))
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
        set caster=null
endfunction


function YujiW_Cast takes unit newCaster,real point_x,real point_y,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local integer id_caster= GetHandleId(newCaster)
        local real caster_x= GetUnitX(newCaster)
        local real caster_y= GetUnitY(newCaster)
        local real angle= AP(caster_x , caster_y , point_x , point_y)
    local real dmg= GetHeroAgi(newCaster, true) * ( 2 + GetUnitAbilityLevel(newCaster, 'YujW'))
    local boolean YujiT_Morf= LoadBoolean(h, id_caster, StringHash("YujiT_Morf"))
    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
        call SaveUnitHandle(h, id, c_CASTER, newCaster)
    call SaveReal(h, id, c_ANGLE, angle)
    if YujiT_Morf == false then
                set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR71', point_x, point_y, 0)
                call SetUnitScale(bjLCU, 4.3, 4.3, 4.3)
                call SetUnitFlyHeight(bjLCU, 25, 0)
                call SaveUnitHandle(h, id, c_DUMMY1, bjLCU)
                set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR71', point_x, point_y, 0)
                call SetUnitScale(bjLCU, 4.3, 4.3, 4.3)
                call SetUnitFlyHeight(bjLCU, 25, 0)
                call SaveUnitHandle(h, id, c_DUMMY2, bjLCU)
    else
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR72', point_x, point_y, 0)
                call SetUnitScale(bjLCU, 4.3, 4.3, 4.3)
                call SetUnitFlyHeight(bjLCU, 25, 0)
                call SaveUnitHandle(h, id, c_DUMMY1, bjLCU)
                set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR72', point_x, point_y, 0)
                call SetUnitScale(bjLCU, 4.3, 4.3, 4.3)
                call SetUnitFlyHeight(bjLCU, 25, 0)
                call SaveUnitHandle(h, id, c_DUMMY2, bjLCU)
    endif
    if YujiT_Morf == true then
        set dmg=dmg + GetHeroAgi(newCaster, true)*3
        call SaveInteger(h, id, c_ACT, 2)
        set soundplay=CreateSound("Sound\\war3mapImported\\YujiW2.mp3", false, false, true, 12700, 12700, "")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
    else
        call SaveInteger(h, id, c_ACT, 1)
        set soundplay=CreateSound("Sound\\war3mapImported\\YujiW_Voice2.mp3", false, false, true, 12700, 12700, "")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
    endif
    call IssueImmediateOrder(newCaster, "stop")
    call SaveReal(h, id, c_POINT_X, point_x)
    call SaveReal(h, id, c_POINT_Y, point_y)
    call SaveReal(h, id, c_DAMAGE, dmg)
    call SaveGroupHandle(h, id, c_GROUP1, CreateGroup())
    call SaveGroupHandle(h, id, c_GROUP2, CreateGroup())
    call SaveGroupHandle(h, id, c_GROUP3, CreateGroup())
        call TimerStart(newTimer, 0.02, true, function YujiW_Periodic)
endfunction



function YujiE_AOE_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
        local real target_x= LoadReal(h, id, c_POINT_X)
        local real target_y= LoadReal(h, id, c_POINT_Y)
        local real angle= 0
        local real time= LoadReal(h, id, c_TIME)
        if GetUnitCurrentOrder(LoadUnitHandle(h, id, c_CASTER)) == OrderId("cloudoffog") or time<8.0 then
        call SaveReal(h, id, c_TIME, time + 0.02)
        if LoadInteger(h, id, c_EFFPERIOD) == 0 then
                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h,id,c_CASTER)), 'dR52', target_x, target_y, GetRandomInt(0,360))
                        call SetUnitScale(n, 2.85, 2.85, 2.85)
                        call SetUnitVertexColor(n, 255, 255, 255, 130)
                        call MyRemoveUnit(n, 1.5)
            call SaveInteger(h, id, c_EFFPERIOD, 9)
        else
            call SaveInteger(h, id, c_EFFPERIOD, LoadInteger(h, id, c_EFFPERIOD) - 1)
        endif
        set bjLCG=LoadGroupHandle(h, id, c_GROUP1)
        call GroupEnumUnitsInRange(bjLCG, target_x, target_y, 10000, Base)
        loop
        set bjLCU=FirstOfGroup(bjLCG)
        exitwhen bjLCU == null
            if FilterA(bjLCU , LoadUnitHandle(h, id, c_CASTER)) then
                if SquareRootPoint(target_x , target_y , GetUnitX(bjLCU) , GetUnitY(bjLCU)) <= 400 then
                    if LoadBoolean(h, GetHandleId(bjLCU), Shield_YujiE) == false then
                        call GroupAddUnit(LoadGroupHandle(h, id, c_GROUP2), bjLCU)
                        call SaveBoolean(h, GetHandleId(bjLCU), Shield_YujiE, true)
                    endif
                else
                    if LoadBoolean(h, GetHandleId(bjLCU), Shield_YujiE) == true then
                        call GroupRemoveUnit(LoadGroupHandle(h, id, c_GROUP2), bjLCU)
                        call SaveBoolean(h, GetHandleId(bjLCU), Shield_YujiE, false)
                                                call RemoveSavedBoolean(h, GetHandleId(bjLCU), Shield_YujiE)
                    endif
                endif
            elseif Condition_Base(GetOwningPlayer(LoadUnitHandle(h, id, c_CASTER)) , bjLCU) == true then
                set angle=AP(target_x, target_y, GetUnitX(bjLCU) , GetUnitY(bjLCU))
                if SquareRootPoint(target_x, target_y, GetUnitX(bjLCU) , GetUnitY(bjLCU)) < 400 then
                    call SetUnitXY_1(bjLCU, target_x + 401*Cos(angle), target_y + 401*Sin(angle), false)
                endif
            endif
            call GroupRemoveUnit(bjLCG, bjLCU)
        endloop
        else
        set bjLCG=LoadGroupHandle(h, id, c_GROUP2)
        loop
        set bjLCU=FirstOfGroup(bjLCG)
        exitwhen bjLCU == null
            if LoadBoolean(h, GetHandleId(bjLCU), Shield_YujiE) == true then
                call SaveBoolean(h, GetHandleId(bjLCU), Shield_YujiE, false)
                                call RemoveSavedBoolean(h, GetHandleId(bjLCU), Shield_YujiE)
            endif
            call GroupRemoveUnit(bjLCG, bjLCU)
        endloop
                call KillUnit(LoadUnitHandle(h, id, c_DUMMY1))
                call KillUnit(LoadUnitHandle(h, id, c_DUMMY2))
                call KillUnit(LoadUnitHandle(h, id, c_DUMMY3))
        call KillUnit(LoadUnitHandle(h, id, c_DUMMY4))
        call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY1) , 1)
                call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY2) , 1)
                call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY3) , 1)
        call MyRemoveUnit(LoadUnitHandle(h, id, c_DUMMY4) , 1)
        call DestroyGroup(LoadGroupHandle(h, id, c_GROUP1))
        call DestroyGroup(LoadGroupHandle(h, id, c_GROUP2))
                call FlushChildHashtable(h, id)
                call DestroyTimer(GetExpiredTimer())
        endif
endfunction

function YujiE_AOE takes unit newCaster,real point_x,real point_y,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local integer id_caster= GetHandleId(newCaster)
        local real caster_x= GetUnitX(newCaster)
        local real caster_y= GetUnitY(newCaster)
        local real angle= AP(caster_x , caster_y , point_x , point_y)
    local boolean YujiT_Morf= LoadBoolean(h, id_caster, StringHash("YujiT_Morf"))
        
        if YujiT_Morf then
                call SaveReal(h, id, c_TIME, 0.0)
        else
                call SaveReal(h, id, c_TIME, 8.0)
        endif
        
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR85', point_x, point_y, angle * bj_RADTODEG)
    call SetUnitScale(bjLCU, 5, 5, 5)
    call SetUnitFlyHeight(bjLCU, 10, 0)
    call SaveUnitHandle(h, id, c_DUMMY4, bjLCU)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR84', point_x, point_y, GetRandomInt(0,360))
        call SetUnitFlyHeight(bjLCU, 10, 0)
        call SetUnitScale(bjLCU, 0.7, 0.7, 0.7)
        call SetUnitAnimationByIndex(bjLCU, 1)
        call SaveUnitHandle(h, id, c_DUMMY1, bjLCU)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR71', point_x, point_y, GetRandomInt(0, 360))
        call SetUnitScale(bjLCU, 3.6, 3.6, 3.6)
        call SetUnitFlyHeight(bjLCU, 25, 0)
        call SaveUnitHandle(h, id, c_DUMMY2, bjLCU)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR20', point_x, point_y, GetRandomInt(0, 360))
        call SetUnitScale(bjLCU, 0.85, 0.85, 0.85)
        call SetUnitVertexColor(bjLCU, 255, 255, 255, 150)
        call SetUnitFlyHeight(bjLCU, 2, 0)
        call SaveUnitHandle(h, id, c_DUMMY3, bjLCU)
        
    call SaveUnitHandle(h, id, c_CASTER, newCaster)
    call SaveReal(h, id, c_POINT_X, point_x)
    call SaveReal(h, id, c_POINT_Y, point_y)
    call SaveGroupHandle(h, id, c_GROUP1, CreateGroup())
    call SaveGroupHandle(h, id, c_GROUP2, CreateGroup())
        call TimerStart(newTimer, 0.02, true, function YujiE_AOE_Periodic)
endfunction

function YujiE_Target_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
        local unit target=LoadUnitHandle(h, id, c_TARGET)
        local unit dummy0=LoadUnitHandle(h, id, c_DUMMY1)
    local real shield_dur= LoadReal(h, id, c_DURATION)
    local real shield_str= LoadReal(h, GetHandleId(target), StringHash("YujiE_Shield"))
    if shield_str > 0 and shield_dur > 0 and UnitIsAlive(target) then
        if IsUnitPaused(target) == false then
            call SaveReal(h, id, c_DURATION, shield_dur - 0.02)
        endif
        call SetUnitX(dummy0, GetUnitX(target))
        call SetUnitY(dummy0, GetUnitY(target))
        call SetUnitFlyHeight(dummy0, GetUnitFlyHeight(target) + 120, 0)
        if GetUnitAbilityLevel(target, 'B00V') != 0 then //проверки для инвиза (туман)
            if GetUnitAbilityLevel(dummy0, 'A0A1') == 0 then
                call UnitAddAbility(dummy0, 'A0A1')
            endif
        else
            if GetUnitAbilityLevel(target, 'A0A1') == 1 then
                call UnitRemoveAbility(dummy0, 'A0A1')
            endif
        endif
    else
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, c_CASTER)), 'dR86', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
        call SetUnitScale(bjLCU, 2, 2, 2)
                call SetUnitFlyHeight(bjLCU, 100, 0)
                call MyRemoveUnit(bjLCU, 1.5)
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, c_CASTER)), 'dR53', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
        call SetUnitScale(bjLCU, 2, 2, 2)
                call SetUnitFlyHeight(bjLCU, 100, 0)
                call SetUnitTimeScale(bjLCU, 0.7)
                call MyRemoveUnit(bjLCU, 1.5)
        call SaveReal(h, GetHandleId(target), StringHash("YujiE_Shield"), 0)
                call RemoveSavedReal(h, GetHandleId(target), StringHash("YujiE_Shield"))
        call KillUnit(dummy0)
        call MyRemoveUnit(dummy0, 1.5)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
        set target=null
        set dummy0=null
endfunction

function YujiE_Target takes unit newCaster,unit newTarget,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local integer id_caster= GetHandleId(newCaster)
        local real caster_x= GetUnitX(newCaster)
        local real caster_y= GetUnitY(newCaster)
    local real target_x= GetUnitX(newTarget)
    local real target_y= GetUnitY(newTarget)
    local boolean YujiT_Morf= LoadBoolean(h, id_caster, StringHash("YujiT_Morf"))
    local real shield_str= (I2R(GetUnitAbilityLevel(newCaster, 'YujE')) * 0.04 +0.04) * GetWidgetMaxLife(newCaster) + I2R(GetUnitAbilityLevel(newCaster, 'YujE')) * 200
    if YujiT_Morf then
        set shield_str=shield_str + GetWidgetMana(newCaster) * 0.15
    endif
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR85', target_x, target_y, GetRandomInt(0, 360))
    call SetUnitScale(bjLCU, 2, 2, 2)
    call SaveUnitHandle(h, id, c_DUMMY1, bjLCU)
    call SaveUnitHandle(h, id, c_CASTER, newCaster)
    call SaveUnitHandle(h, id, c_TARGET, newTarget)
    call SaveReal(h, id, c_DURATION, 5.0)
    call SaveReal(h, GetHandleId(newTarget), StringHash("YujiE_Shield"), shield_str)
    call TimerStart(newTimer, 0.02, true, function YujiE_Target_Periodic)
endfunction

