function MissleMoveTransmission2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local unit u=LoadUnitHandle(h,id,7)
local real time=LoadReal(h,id,9)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
local real dist=LoadReal(h,id,6)
local real mh=LoadReal(h,id,5)
local real rd=SR(x,y,x1,y1)
local player p=GetOwningPlayer(u)
local integer idu=GetPlayerId(p)
local real fl
if rd>speed+30 and udg_B==true and time<3 and UnitIsAlive(l__d)and GetUnitAbilityLevel(l__d,'A1BL')==0 then
call SaveReal(h,id,9,time+0.02)
call SetUnitPosition(l__d,x1,y1)
call SetUnitPosition(l__d,x+speed*Cos(a),y+speed*Sin(a))
call SetUnitFacing(l__d,a*bj_RADTODEG)
set fl=ParabolaZ(mh,dist,rd)
call SetUnitFlyHeight(l__d,fl,0)
call SetUnitPathing(l__d,false)
set n=CreateUnit(p,0x65305047,x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitFlyHeight(n,fl,0)
call SetUnitTimeScale(n,3)
else
call UnitApplyTimedLife(CreateUnit(p,'e03X',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03W',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e08R',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03Y',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e08N',x1,y1,a*bj_RADTODEG),'BTLF',1)
if GetUnitAbilityLevel(l__d,'A1BL')==0 then
call Push(l__d,25,LoadReal(h,id,8),400)
call SetUnitFlyHeight(l__d,0,0)
endif
call SetUnitPathing(l__d,true)
call PauseUnit(l__d,false)
call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,false)
call myCustomDamage(u,l__d,(3+GetUnitAbilityLevel(u,0x41305155))*GetHeroAgi(u,true)+LoadReal(h, id, 99),false,false,null,null,null)
call SetControlToUnit(u,l__d,2,"stun")
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set p=null
set l__d=null
set t=null
endfunction
function MissleMoveTransmission takes unit l__d,real speed,real angle,real x,real y,real mh,unit u returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SetUnitPathing(l__d,false)
call PauseUnit(l__d,true)
call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,true)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,mh)
call SaveReal(h,id,6,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,99,SR(x,y,GetUnitX(l__d),GetUnitY(l__d))*(0.06*GetUnitAbilityLevel(u, 0x41305155)))
call SaveUnitHandle(h,id,7,u)
call SaveReal(h,id,8,Atan2(y-GetUnitY(l__d),x-GetUnitX(l__d)))
call TimerStart(t,0.02,true,function MissleMoveTransmission2)
set t=null
endfunction
function TransmissionCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real x2=0
local real x3=0
local real y2=0
local real y3=0
local real x4=0
local real y4=0
local real spd=0
if SR(x,y,x1,y1)>50 and GetWidgetLife(c)>0 then
set x=x+60*Cos(a)
set y=y+60*Sin(a)
call SetUnitXY_1(u,x,y,false)
call SetUnitFacing(u,a*bj_RADTODEG)
set n=CreateUnit(p,'e09K',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.25)
call SetUnitVertexColor(n,170,170,170,170)
call SetUnitTimeScale(n,2)
call SetUnitAnimation(n,"walk")
call SetUnitAnimation(u,"spell three")
else
call SetUnitAnimation(u,"spell throw")
if GetUnitAbilityLevel(u,'A0IH')>0 and GetUnitAbilityLevel(c,'A0IH')>0 then
set x2=GetRectMaxX(gg_rct_UBW2)-2550
set y2=GetRectMaxY(gg_rct_UBW2)-2550
set x3=GetRectMinX(gg_rct_UBW2)+2550
set y3=GetRectMinY(gg_rct_UBW2)+2550
set x4=GetRandomReal(x3,x2)
set y4=GetRandomReal(y3,y2)
elseif DU==true then
set x2=GetRectMaxX(gg_rct_GameZone)-1000
set y2=GetRectMaxY(gg_rct_GameZone)-1000
set x3=GetRectMinX(gg_rct_GameZone)+1000
set y3=GetRectMinY(gg_rct_GameZone)+1000
set x4=GetRandomReal(x3,x2)
set y4=GetRandomReal(y3,y2)
else
set x2=GetRectMaxX(gg_rct_ArenaNormal)-500
set y2=GetRectMaxY(gg_rct_ArenaNormal)-500
set x3=GetRectMinX(gg_rct_ArenaNormal)+500
set y3=GetRectMinY(gg_rct_ArenaNormal)+500
set x4=GetRandomReal(x3,x2)
set y4=GetRandomReal(y3,y2)
endif
set spd=SR(x1,y1,x4,y4)
call UnitApplyTimedLife(CreateUnit(p,'e08O',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e08M',x1,y1,GetRandomReal(0,359)),'BTLF',1)
set n=CreateUnit(p,'e08N',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',1.5)
call SetUnitVertexColor(n,100,100,100,140)
call UnitRemoveAbility(u,'A0BX')
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
call UnitAddAbility(c,'Arav')
call UnitRemoveAbility(c,'Arav')
call SetUnitPathing(c,false)
call MissleMoveTransmission(c,spd/70,0,x4,y4,3000,u)
else
call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
endif
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitTimeScale(u,1)
call SetUnitPathing(u,true)
call PauseUnit(u,false)
call FlushChildHashtable(h,id)
call SetUnitInvulnerable(u,false)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function TransmissionCast takes nothing returns nothing
