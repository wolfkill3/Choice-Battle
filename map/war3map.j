function SteelVoidsCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,3)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real dmg=GetHeroAgi(u,true)*0.5
local real heal=GetHeroAgi(u,true)*0.5
local real l=GetWidgetLife(u)+heal
local player p=GetOwningPlayer(u)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Unleash the power.mdx",u,"right hand"))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BluefireBolt.mdx",u,"right hand"))
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,0.65,0.65,0.65)
call SetUnitVertexColor(n,75,25,255,50)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,75,25,255,50)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.25,1.25,1.25)
call SetUnitVertexColor(n,75,25,255,50)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.65,1.65,1.65)
call SetUnitVertexColor(n,75,25,255,50)
set n=CreateUnit(p,'e0RR',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitVertexColor(n,255,255,255,50)
if GetUnitCurrentOrder(u)==OrderId("charm")then
call GroupEnumUnitsInRect(G,WorldBoundsR(),Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)and IsUnitType(E,UNIT_TYPE_HERO)then
call HealTextTag(u,u,heal*myCustomHeal2(u,1),"HealthRes")
call myCustomDamage(u,E,dmg+GetUnitState(E,UNIT_STATE_MAX_LIFE)*0.015,false,false,null,null,null)
call SetUnitState(u,UNIT_STATE_LIFE,l)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\UDeathBlu.mdl",E,"origin"))
endif
call GroupRemoveUnit(G,E)
endloop
else
call SetUnitTargetable(u, true)
call PauseTimer(t)
call DestroyTimer(t)
call RemoveUnit(LoadUnitHandle(h,id,2))
call FlushChildHashtable(h,id)
endif
set p=null
set l__d=null
set u=null
set t=null
endfunction
