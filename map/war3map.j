endfunction
function PainSummonCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local integer id=GetPlayerId(p)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=0
local real y1=0
local real a=GetUnitFacing(u)*bj_DEGTORAD
local integer idu=GetHandleId(Hero[id])
local group g2
set E=CreateUnit(p,'e0KF',x+35*Cos(a),y+35*Sin(a),GetRandomReal(0,359))
call UnitApplyTimedLife(E,1,0.25)
call SetUnitTimeScale(E,0.65)
call SetUnitAnimation(E,"Birth")
set g2=CopyGroup(LoadGroupHandle(h,idu,GroupHash))
loop
set E=FirstOfGroup(g2)
exitwhen E==null
if E!=u then
set x1=x+GetRandomReal(-200,200)
set y1=y+GetRandomReal(-200,200)
call DestroyEffect(AddSpecialEffect("war3mapImported\\shadowclone.mdx",x1,y1))
call SetUnitX(E,x1)
call SetUnitY(E,y1)
if GetUnitCurrentOrder(E)==null then
call IssueImmediateOrder(E,"Stop")
endif
endif
call GroupRemoveUnit(g2,E)
endloop
call DestroyGroupTimed(g2,3)
set x1=x+GetRandomReal(-200,200)
set y1=y+GetRandomReal(-200,200)
call DestroyEffect(AddSpecialEffect("war3mapImported\\shadowclone.mdx",x1,y1))
call SetUnitX(Hero[id],x1)
call SetUnitY(Hero[id],y1)
call IssueImmediateOrder(Hero[id],"Stop")
set soundplay=CreateSound("Sound\\Music\\mp3Music\\PainKuchiyoseNoJustu.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
set g2=null
set u=null
set p=null
endfunction
