function CastUtsushiAme2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local real time=LoadReal(h,id,25)
if SR(x,y,x1,y1)>40 and GetWidgetLife(c)>0 and GetWidgetLife(u)>0 and time<0.3 then
call SetUnitPosition(u,x+20*Cos(a),y+20*Sin(a))
call SaveReal(h,id,25,time+0.025)
call SetUnitFacing(u,a*bj_RADTODEG)
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl",x1,y1))
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl",u,"origin"))
else
call RemoveUnit(LoadUnitHandle(h,id,4))
call DestroyEffect(AddSpecialEffect("war3mapImported\\TidalErruption.mdx",x,y))
call DestroyEffect(AddSpecialEffect("war3mapImported\\IceNova.mdx",x,y))
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl",x,y))
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call SetUnitPathing(u,true)
call myCustomDamage(u,c,(GetUnitAbilityLevel(u,'A08G')+3)*GetHeroAgi(u,true),false,false,null,null,null)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set c=null
set t=null
endfunction
