function Trig_Raiga_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local player p=GetOwningPlayer(u)
local real r=LoadReal(h,id,10)
local real f=LoadReal(h,id,11)
local integer i=0
local lightning l=LoadLightningHandle(h,id,2)
if(OrderId2String(GetUnitCurrentOrder(u))=="channel")then
call GroupEnumUnitsInRange(G,x,y,100000000,Base)
set n=CreateUnit(p,'e019',x,y,GetRandomReal(0,359))
call SetUnitScale(n,2+r,2+r,2+r)
call UnitApplyTimedLife(n,'BHwe',0.5)
set n=CreateUnit(p,'e019',x,y,GetRandomReal(0,359))
call SetUnitScale(n,2+r,2+r,2+r)
call UnitApplyTimedLife(n,'BHwe',0.5)
call SetUnitScale(l__d,r,r,r)
call UnitApplyTimedLife(n,'BHwe',0.5)
call SaveReal(h,id,11,f+0.125)
call SaveReal(h,id,10,r+0.1)
call MoveLightningEx(l,false,GetUnitX(u),GetUnitY(u),GetUnitZCustom(u)+75,x,y,200)
else
call GroupEnumUnitsInRange(G,x,y,1000,Base)
call SetUnitInvulnerable(u,false)
call UnitApplyTimedLife(CreateUnit(p,'e087',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0PI',x,y,GetRandomReal(0,359)),'BTLF',1)
loop
exitwhen i>=7
