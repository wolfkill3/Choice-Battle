function PlanetBurstCond takes nothing returns boolean
return GetSpellAbilityId()=='A0SN' and udg_B==true
endfunction
function PlanetBurstCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,3)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,8)
local real y1=LoadReal(h,id,9)
local real a=Atan2(y1-y,x1-x)
local real dmg=11*GetHeroStr(u,true)
local real l__s=LoadReal(h,id,7)+0.055
local real he=GetUnitFlyHeight(l__d)
local real sc=0
local real x2=0
local real y2=0
local real time=LoadReal(h,id,10)+0.03
local player p=GetOwningPlayer(u)
if time<=0.03 then
call SetUnitAnimation(u,"Spell five")
endif
if time <= 2.1 then
call SetUnitScale(l__d,l__s,l__s,l__s)
call SetUnitX(l__d,x+(l__s+1)*Cos(a))
call SetUnitY(l__d,y+(l__s+1)*Sin(a))
call SetUnitFlyHeight(l__d,he+9,0)
call SetUnitFlyHeight(u,GetUnitFlyHeight(u)+3,0)
call SaveReal(h,id,7,l__s)
call SaveReal(h,id,10,time)
set sc=GetRandomReal(0.5,1.5)
set x2=x+GetRandomReal(-500,500)
set y2=y+GetRandomReal(-500,500)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl",x2,y2))
else
if time>2.1 then
call SetUnitTimeScale(u,1)
call MissleMovePlanetBurst(u,x1,y1,l__d,30,0,dmg,he,SR(x,y,x1,y1))
else
call RemoveUnit(l__d)
endif
call Trig_ArenaCamera1_Actions()
call CambugTimed(3)
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
call SetUnitFlyHeight(u,0,1000)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set l__d=null
set u=null
set t=null
endfunction
function PlanetBurstCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
if SR(x,y,x1,y1)<600 then
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
set x=x-600*Cos(a)
set y=y-600*Sin(a)
call SetUnitXY_1(u,x,y, false)
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
endif
call SaveUnitHandle(h,id,0,u)
set n=CreateUnit(GetOwningPlayer(u),'e0QP',x-75*Cos(a),y-75*Sin(a),a*bj_RADTODEG)
call SetUnitScale(n,0.1,0.1,0.1)
call SaveUnitHandle(h,id,3,n)
call SaveReal(h,id,7,0.01)
call SaveReal(h,id,10,0)
call SaveReal(h,id,6,150)
call SaveReal(h,id,8,x1)
call SaveReal(h,id,9,y1)
call SetUnitAnimation(u,"Spell five")
call SetUnitTimeScale(u,0.85)
call SetUnitInvulnerable(u,true)
call PauseUnit(u,true)
call UnitAddAbility(u,'Arav')
call UnitRemoveAbility(u,'Arav')
call Trig_ArenaCamera2_Actions()
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()), SOUND_LANGUAGE )==true then
set soundplay=SndN(1411) // Sound\war3mapImported\BuuT.mp3
else
set soundplay=SndN(1413) // Sound\Music\mp3Music\Buu\BuuT-jap.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set Cambug=true
call TimerStart(t,0.03,true,function PlanetBurstCast2)
set u=null
set t=null
endfunction
