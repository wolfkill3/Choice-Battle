function ShiroF_Cond takes nothing returns boolean
return GetSpellAbilityId()=='A901'
endfunction
function ShiroF_Periodic takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit c=LoadUnitHandle(HH,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local real time=LoadReal(HH,id,2)-0.1
local player p=GetOwningPlayer(u)
local integer i=0
local integer l__s=0
local integer ls=0
local integer item_id= 0
local integer max_iteration= 30
local integer random_slot= 0
local effect effh1=LoadEffectHandle(HH,id,8)
local effect effh2=LoadEffectHandle(HH,id,9)
    if time>0 then
        call SaveReal(HH,id,2,time)
        if c!=u then
        call SetUnitFacing(u,a*bj_RADTODEG)
        endif
        set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
        call SetUnitVertexColor(n,155,200,255,75)
        call SetUnitTimeScale(n,2)
        call SetUnitScale(n,0.5,0.5,0.5)
        call UnitApplyTimedLife(n,1,1)
        set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
        call SetUnitVertexColor(n,155,200,255,75)
        call SetUnitTimeScale(n,2)
        call SetUnitScale(n,0.75,0.75,0.75)
        call UnitApplyTimedLife(n,1,1)
        set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
        call SetUnitVertexColor(n,155,200,255,75)
        call SetUnitTimeScale(n,2)
        call SetUnitScale(n,1,1,1)
        call UnitApplyTimedLife(n,1,1)
    else
        call PauseUnit(u,false)
        //call SetUnitInvulnerable(u,false)
        if (IsUnitType(c, UNIT_TYPE_HERO) or IsUnitIllusion(c)==true) and p!=GetOwningPlayer(c) then
            call ShowAbility2('A901',false)
            call ShowAbility2Timed('A901',true,15.1)
            loop
            exitwhen max_iteration <= 0
                set max_iteration=max_iteration - 1
                set random_slot=GetRandomInt(0, 5)
                if GetItemTypeId(UnitItemInSlot(c, random_slot)) != 0 and AlbedoBreakCond(c, random_slot) then
                    set item_id=GetItemTypeId(UnitItemInSlot(c, random_slot))
                    if ShiroFList(u,item_id) then
                        set max_iteration=0
                    endif
                endif
            endloop
        endif
        //call SetUnitInvulnerable(u,false)
        call PauseUnit(u,false)
        call DestroyEffect(effh1)
        call DestroyEffect(effh2)
        call DestroyTimer(t)
        call FlushChildHashtable(HH,id)
    endif
set p=null
set c=null
set u=null
set t=null
set effh1=null
set effh2=null
endfunction
function ShiroF_Cast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
call SaveUnitHandle(HH,id,0,u)
call SaveUnitHandle(HH,id,1,c)
call PauseUnit(u,true)
//call SetUnitInvulnerable(u,true) 
call SetUnitAnimation(u,"stand")
call SetUnitTimeScale(u,0.05)
set n=CreateUnit(p,'eo8A',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,1)
set n=CreateUnit(p,'eo0N',x,y,a*bj_RADTODEG-45)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,1,0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'eo0N',x,y,a*bj_RADTODEG+45)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,1,0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'eo0N',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,1,0.4)
call SetUnitTimeScale(n,3)
call SaveEffectHandle(HH,id,8,AddSpecialEffectTarget("war3mapImported\\OrbOfLightningGreen2.mdx",u,"right hand"))
call SaveEffectHandle(HH,id,9,AddSpecialEffectTarget("war3mapImported\\OrbOfLightningGreen2.mdx",u,"left hand"))
if GetUnitTypeId(u)=='H05A' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\ShiroF_"+I2S(GetRandomInt(1, 3))+".mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\ArcherF_"+I2S(GetRandomInt(1, 2))+".mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
if GetUnitAbilityLevel(u,'A0IH')==0 then
        call SaveReal(HH,id,2,1.0)
else
        call SaveReal(HH,id,2,0.1)
endif
call SetUnitTimeScale(u,1)
call TimerStart(t,0.1,true,function ShiroF_Periodic)
set u=null
set t=null
set c=null
set p=null
endfunction
function InitTrig_ShiroF takes nothing returns nothing
set gg_trg_ShiroF=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_ShiroF,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_ShiroF,Condition(function ShiroF_Cond))
call TriggerAddAction(gg_trg_ShiroF,function ShiroF_Cast)
endfunction
function BerserkerSwordCond takes nothing returns boolean
return GetSpellAbilityId()=='A13F'
endfunction
function BerserkerSwordCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real a=LoadReal(h,id,5)
local real dmg=(3+GetUnitAbilityLevel(u,'A13F'))*GetHeroAgi(u,true)*0.065
local player p=GetOwningPlayer(u)
local real time=LoadReal(h,id,7)
local real ang=0
local real mt=LoadReal(h,id,8)
local real dist=GetRandomReal(-100,100)
local real a2=a+90*bj_DEGTORAD
local real r=0
local real l__d=0
if GetUnitAbilityLevel(u,'A0IH')>0 then
set dmg=(5+GetUnitAbilityLevel(u,'A13F'))*GetHeroAgi(u,true)*0.065
endif
if mt>0 and UnitIsAlive(u)then
call GroupEnumUnitsInRange(G,x,y,350,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
    if Condition_Base(p,E)then
    call myCustomDamage(u,E,dmg,false,false,null,null,null)
    call SetControlToUnit(E,E, 0.7, "stun")
    call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",E,"chest"))
    endif
call GroupRemoveUnit(G,E)
endloop
call PauseUnit(u,true)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Omnislash.mdx",u,"chest"))
set n=CreateUnit(p,0x65304146,x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitVertexColor(n,190,255,255,75)
    if GetRandomInt(1,3)==1 then
    set n=CreateUnit(p,'e13N',x,y,a*bj_RADTODEG)
    call SetUnitVertexColor(n,255,255,255,200)
    call SetUnitTimeScale(n,2)
    call UnitApplyTimedLife(n,1,0.4)
    elseif GetRandomInt(1,3)==2 then
    set n=CreateUnit(p,'e13O',x,y,a*bj_RADTODEG)
    call SetUnitVertexColor(n,255,255,255,200)
    call SetUnitTimeScale(n,2)
    call UnitApplyTimedLife(n,1,0.4)
    elseif GetRandomInt(1,3)==3 then
    set n=CreateUnit(p,'e13P',x,y,a*bj_RADTODEG)
    call SetUnitVertexColor(n,255,255,255,200)
    call SetUnitTimeScale(n,2)
    call UnitApplyTimedLife(n,1,0.4)
    endif
call PauseUnit(u,true)
call SetUnitFacing(u,a*bj_RADTODEG)
    if GetUnitTypeId(u)=='H05A' then
    call SetUnitAnimation(u,"Spell")
    else
    call SetUnitAnimation(u,"Attack")
    endif
call SaveReal(h,id,8,mt-0.1)
else
call SetUnitInvulnerable(u,false)
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitVertexColor(u,255,255,255,255)
call FlushChildHashtable(h,id)
call PauseUnit(u,false)
call SetUnitTimeScale(u,1)
endif
set p=null
set u=null
set t=null
endfunction
function BerserkerSwordCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,5)
local real y1=LoadReal(h,id,6)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real dmg=LoadReal(h,id,4)
local real dist=LoadReal(h,id,2)
local real scale=LoadReal(h,id,10)
local real time=LoadReal(h,id,11)
local real tm=GetWidgetMana(u)
if time==0 then
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SetUnitTimeScale(u,3)
if GetUnitTypeId(u)=='H05A' then
call SetUnitAnimation(u,"spell channel")
set soundplay=CreateSound("Sound\\Music\\mp3Music\\NineLivesBladeWorks.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\ArcherR.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call SetUnitAnimation(u,"Spell Two")
endif
endif
if time<0.75 or (time<0.5 and GetUnitAbilityLevel(u,'A0IH')>0) then
set n=CreateUnit(p,'e0WR',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,0.65,0.65,0.65)
call SetUnitVertexColor(n,255,255,255,100)
set n=CreateUnit(p,'e0WR',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,255,255,255,50)
set n=CreateUnit(p,'e0WR',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,1.4,1.4,1.4)
call SetUnitVertexColor(n,255,255,255,100)
call SaveReal(h,id,10,scale+0.015)
call SaveReal(h,id,11,time+0.04)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
else
if GetUnitTypeId(u)=='H05A' then
call SetUnitAnimation(u,"Spell")
else
call SetUnitAnimation(u,"Spell Two")
endif
call SetUnitTimeScale(u,3)
call PauseUnit(u,true)
call PauseTimer(t)
call TimerStart(t,0.1,true,function BerserkerSwordCast3)
endif
set p=null
set u=null
set t=null
endfunction
