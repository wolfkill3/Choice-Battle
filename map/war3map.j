call UnitApplyTimedLife(CreateUnit(p,0x65304D43,x,y,GetRandomReal(0,359)),1,2)
endif
if LoadBoolean(HH,GetHandleId(u),SS)==false then
call SaveReal(h,GetHandleId(u),StringHash("SSR"),15+GetHeroLevel(u))
call SaveUnitHandle(h,GetHandleId(tt),25,CreateUnit(p,0x68303431,RX,RY,0))
call SaveUnitHandle(h,GetHandleId(tt),0,u)
call SaveBoolean(HH,GetHandleId(u),SS,true)
call TimerStart(tt,0.1,true,function DiableJambe3)
call IssueImmediateOrder(u,"stop")
set soundplay=CreateSound("Sound\\Music\\mp3Music\\DiableJumble.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
endif
call SetUnitTimeScale(u,1)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set tt=null
set u=null
set t=null
endfunction
