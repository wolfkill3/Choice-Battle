call TriggerRegisterAnyUnitEventBJ(gg_trg_Three_Attack,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_Three_Attack,Condition(function Trig_Three_Attack_Conditions))
call TriggerAddAction(gg_trg_Three_Attack,function Trig_Three_Attack_Actions)
endfunction
