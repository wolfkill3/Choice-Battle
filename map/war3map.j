call SaveUnitHandle(h,id,0,u)
if GetOrderTargetUnit()==null then
call SaveReal(h,id,2,GetOrderPointX())
call SaveReal(h,id,1,GetOrderPointY())
else
call SaveReal(h,id,2,GetUnitX(GetOrderTargetUnit()))
call SaveReal(h,id,1,GetUnitY(GetOrderTargetUnit()))
endif
call TimerStart(t,0.001,false,function ERinStomOrders2)
set u=null
set t=null
endfunction
function ERinCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=GetUnitFacing(u)*bj_DEGTORAD+GetRandomReal(-0.08,0.08)
local real dmg=LoadReal(h,id,3)
local player p=GetOwningPlayer(u)
local trigger tt=LoadTriggerHandle(h,id,1)
if GetUnitAbilityLevel(u,'A1FU')>0 and GetUnitState(u,UNIT_STATE_MANA)>100 and GetUnitState(u,UNIT_STATE_LIFE)>0.405 and IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'CBC2')==0 and GetUnitAbilityLevel(u,'cbc3')==0 and GetUnitAbilityLevel(u,'cbc5')==0  and GetUnitAbilityLevel(u, 'cbc7')==0 and GetUnitAbilityLevel(u, 'cbc8')==0 and GetUnitAbilityLevel(u, 'cbc9')==0 and UnitIsAlive(u)then
set n=CreateUnit(p,'e15V',x-100*Cos(a),y-100*Sin(a),a*bj_RADTODEG)
call SetUnitTimeScale(n,2.5)
call SetUnitFlyHeight(n,GetRandomReal(80,100),0)
call ERinMissles(n,GetRandomReal(65,95),a,GetRandomReal(1600,2600),0.15,dmg)
call SetUnitAnimation(u,"Spell channel")
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\VengeanceMissile\\VengeanceMissile.mdl",u,"right hand"))
call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*.0035)
else
call UnitRemoveAbility(u,'A1FU')
call UnitRemoveAbility(u,'A1G2')
call ShowAbility2('A1G1',true)
call UnitRemoveAbility(u,'B00A')
call SetUnitAcquireRange(u,600)
call StartAbilityCooldown(GetUnitAbility(u, 'A1G1'), 10.0)
call TriggerClearActions(tt)
call DestroyTrigger(tt)
call IssueImmediateOrder(u,"stop")
call FlushChildHashtable(h,id)
call DestroyTimer(t)
endif
set p=null
set tt=null
set u=null
set t=null
endfunction
function ERinCast takes nothing returns nothing
local timer t=CreateTimer()
local trigger tt=CreateTrigger()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real time=LoadReal(HH, GetHandleId(LoadFrameHandle(HH, GetHandleId(p),SH_ReplaceableTextures_CommandButtons_BTNRinW_blp)), c_DURATION) //WRIN
if time>0 then
call SaveReal(HH, GetHandleId(LoadFrameHandle(HH, GetHandleId(p),SH_ReplaceableTextures_CommandButtons_BTNRinW_blp)), c_DURATION,time+(0.5+0.25*GetUnitAbilityLevel(u,'A1FX'))/3)
endif
call SaveUnitHandle(h,id,0,u)
call SaveTriggerHandle(h,id,1,tt)
call SaveInteger(h,id,2,GetUnitAbilityLevel(u,'A1G1'))
call SaveReal(h,id,3,((GetUnitAbilityLevel(u,'A1G1')*0.05)+0.05)*GetHeroInt(u,true)+5)
call SetUnitTurnSpeed(u,400000)
call SetUnitAcquireRange(u,51)
call ShowAbility2('A1G1',false)
call UnitAddAbility(u,'A1G2')
set soundplay=SndN(2908) // Sound\Music\mp3Music\ERin.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call UnitAddAbility(u,'A1FU') //Slow
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerAddAction(tt,function ERinStomOrders)
call TimerStart(t,0.07,true,function ERinCast2)
set u=null
set t=null
set p=null
set tt=null
endfunction
