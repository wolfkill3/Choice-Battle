call SaveReal(h,id,8,dmg)
call SaveReal(h,id,9,0.3)
call SetUnitScale(l__d,0.3,0.3,0.3)
call TimerStart(t,0.03,true,function OmegaBlastFly4)
set t=null
endfunction
