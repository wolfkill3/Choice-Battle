call SaveBoolean(h,id,7,true)
else
set n=CreateUnit(GetOwningPlayer(u),0x65303056,x+80*Cos(f*bj_DEGTORAD),y+80*Sin(f*bj_DEGTORAD),f)
call UnitAddAbility(n,'Arav')
