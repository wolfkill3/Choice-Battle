call SaveReal(HH,id,7,0.01)
call KiBlastBlast(u,dmg)
call SetUnitAnimation(u,"stand")
call SetUnitTimeScale(u,1)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif

set u=null
set p=null
set t=null
endfunction
function KiBlastCast takes nothing returns nothing
