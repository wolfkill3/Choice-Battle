else
call Push(c,30,a,300)
call PauseTimer(t)
call SetUnitTimeScale(u,0.5)
call TimerStart(t,0.4,false,function ExcaliburCombinationCast4)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function ExcaliburCombinationCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>60 and GetWidgetLife(c)>0 then
set x=x+50*Cos(a)
set y=y+50*Sin(a)
call SetUnitXY_1(u,x,y,false)
call SetUnitFacingInstant(u,a*bj_RADTODEG)
if GetUnitTypeId(u)=='H05C' then
set n=CreateUnit(p,'e0XU',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.25)
call SetUnitVertexColor(n,255,255,255,100)
call SetUnitTimeScale(n,2)
call SetUnitModel(n,GetUnitModel(u))
call SetUnitAnimation(n,"spell two")
elseif GetUnitTypeId(u)=='H05E' then
set n=CreateUnit(p,'e0YU',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.25)
call SetUnitVertexColor(n,255,255,255,100)
call SetUnitTimeScale(n,2)
call SetUnitAnimation(n,"spell two")
elseif GetUnitTypeId(u)=='H06P' then
set n=CreateUnit(p,'e13V',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.25)
call SetUnitVertexColor(n,255,255,255,100)
call SetUnitTimeScale(n,2)
call SetUnitAnimation(n,"spell two")
elseif GetUnitTypeId(u)=='H15C' then
set n=CreateUnit(p,'e13V',x,y,a*bj_RADTODEG)
call SetUnitModel(n,"Proto_Arthur.mdl")
call UnitApplyTimedLife(n,'BTLF',0.25)
call SetUnitVertexColor(n,255,255,255,100)
call SetUnitTimeScale(n,2)
call SetUnitAnimation(n,"spell two")
endif
else
    if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
        call PauseUnit(u,false)
        call SetUnitAnimation(u,"Stand Channel")
        call SaveInteger(HH,GetHandleId(u),SH_SaberPassive,1)
        // if GetHeroLevel(u)>=35 then
        // call SetControlToUnit(u,c,3, "stun")
        // endif
        call PauseTimer(t)
        call TimerStart(t,0.3,true,function ExcaliburCombinationCast3)
    else
        call PauseUnit(u,false)
        call SetUnitInvulnerable(u,false)
        call SetUnitAnimation(u,"attack")
        call PauseUnit(c,false)
        call UnitRemoveAbility(u,'A14C')
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
        call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
        call SetUnitXY_1(u,x1,y1, false)
        call PauseTimer(t)
        call DestroyTimer(t)
        call SetUnitVertexColor(u,255,255,255,255)
        call FlushChildHashtable(h,id)
    endif
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function ExcaliburCombinationCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
call SaveUnitHandle(h,id,0,u)
call SetUnitPathing(u,false)
call SetUnitAnimation(u,"spell two")
call UnitAddAbility(u,'A14C')
call SetUnitTimeScale(u,1)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SaveReal(h,id,8,0)
call SaveReal(h,id,11,x)
call SaveReal(h,id,12,y)
call SaveReal(h,id,25,Atan2(GetUnitY(c)-y,GetUnitX(c)-x))
call SaveUnitHandle(h,id,1,c)
if GetUnitTypeId(u)=='H15C' then
    set soundplay=SndN(2446) // Sound\Music\mp3Music\ArthurW.mp3
else
    set soundplay=SndN(2448) // Sound\Music\mp3Music\SaberCombo.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.02,true,function ExcaliburCombinationCast2)
set c=null
set u=null
set t=null
endfunction
function ShadowDragonCond takes nothing returns boolean
return GetSpellAbilityId()=='A14W'
endfunction
function ShadowDragonCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local integer lvl=LoadInteger(HH,id,2)
if GetUnitAbilityLevel(u,'GAE1')==0 and IsUnitAlive(u)==true then
call SetUnitLifeRegen(u,GetUnitLifeRegen(u)-5+(-5*lvl))
call RemoveUnit(LoadUnitHandle(HH,id,1))
call FlushChildHashtable(HH,id)
call SetUnitVertexColor(u,255,255,255,255)
call PauseTimer(t)
call DestroyTimer(t)
call EnableUnitAbility(u,'A14W',false,true)
call StartAbilityCooldown(GetUnitAbility(u,'A14W'),GetAbilityBaseRealLevelFieldById('A14W',ABILITY_RLF_COOLDOWN,GetUnitAbilityLevel(u,'A14W')-1))
elseif Hero[GetPlayerId(GetOwningPlayer(u))]==null then
call FlushChildHashtable(HH,id)
call PauseTimer(t)
call DestroyTimer(t)
endif
set t=null
set u=null
endfunction
function ShadowDragonCast takes nothing returns nothing //GajeelF
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
call SetUnitVertexColor(u,100,100,100,225)
call SaveUnitHandle(HH,id,0,u)
call SaveUnitHandle(HH,id,1,CreateUnit(GetOwningPlayer(u),0x68303550,x,y,0))
call UnitAddAbility(u,'GAE1')
call SetUnitAbilityLevel(u,'GAE1',GetUnitAbilityLevel(u,'A14W')+1)
call UnitRemoveAbilityTimedPause(u,'GAE1',20)
call UnitAddAbility(u,'GAE2')
call SetUnitAbilityLevel(u,'GAE2',GetUnitAbilityLevel(u,'A14W')+1)
call UnitRemoveAbilityTimedPause(u,'GAE2',20)
call SetUnitLifeRegen(u,GetUnitLifeRegen(u)+5+5*GetUnitAbilityLevel(u,'A14W'))
call SaveInteger(HH,id,2,GetUnitAbilityLevel(u,'A14W'))
call UnitAddAbility(u,'GAE4')
call SetUnitAbilityLevel(u,'GAE4',GetUnitAbilityLevel(u,'A14W')+1)
call ShowUnitAbility(u,'GAE4',false)
call UnitRemoveAbilityTimedPause(u,'GAE4',20)
call DisableUnitAbility(u,'A14W',false,true)
call CreateModeIndicatorWithPauseForm(u, "ReplaceableTextures\\CommandButtons\\BTNGajeel0.blp", 20)
call TimerStart(t,0.08,true,function ShadowDragonCast2)
set u=null
set p=null
set t=null
endfunction
function GajeelIronShadowDragonRoarCond takes nothing returns boolean
return GetSpellAbilityId()==0x41313534 and udg_B==true and GetUnitAbilityLevel(GetTriggerUnit(),'GAE1')>0
endfunction
function GajeelIronShadowDragonRoarCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real a=LoadReal(h,id,11)
local real dist=LoadReal(h,id,2)
local real x=GetUnitX(l__d)+30*Cos(a)
local real y=GetUnitY(l__d)+30*Sin(a)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real dmg=LoadReal(h,id,4)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,12)
local group g2
local real s1=LoadReal(h,id,10)
local real fl=LoadReal(h,id,20)
local real time=LoadReal(h,id,15)
if dist>0 and RectContainsUnit(WorldBoundsR(),l__d)and UnitIsAlive(l__d)then
call SetUnitXY_1(l__d,x,y, false)
set n=CreateUnit(p,0x65305942,x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1.5)
call SetUnitTimeScale(n,2)
call SetUnitScale(n,2+s1,2+s1,2+s1)
call SetUnitFlyHeight(n,fl,0)
set n=CreateUnit(p,'e0YC',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.8)
call SetUnitTimeScale(n,0.6)
call SetUnitScale(n,0.05+s1/10,0.05+s1/10,0.05+s1/10)
call SetUnitFlyHeight(n,fl-25,0)
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,0.65,0.65,0.65)
call SetUnitVertexColor(n,0,0,0,50)
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,0,0,0,50)
set g2=CopyGroup(g)
loop
set E=FirstOfGroup(g2)
exitwhen E==null
if Condition_Base(p,E)then
call PauseUnit(E,true)
call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,true)
call SetUnitX(E,x)
call SetUnitY(E,y)
call SetUnitFlyHeight(E,fl,0)
endif
call GroupRemoveUnit(g2,E)
endloop
call DestroyGroupTimed(g2,3)
call SaveReal(h,id,2,dist-30)
call SaveReal(h,id,20,fl+100)
call SaveReal(h,id,10,s1+0.15)
else
loop
set E=FirstOfGroup(g)
exitwhen E==null
if Condition_Base(p,E)then
call PauseUnit(E,false)
call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,false)
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetUnitFlyHeight(E,0,1000)
call Push(E,50,a,1000)
endif
call GroupRemoveUnit(g,E)
endloop
call SetUnitTimeScale(u,1)
call RemoveUnit(l__d)
