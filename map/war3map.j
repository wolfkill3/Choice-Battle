function SanzuFallShotMissleFly2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,9)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
local real dist=LoadReal(h,id,6)
local real mh=LoadReal(h,id,5)
local real rad=LoadReal(h,id,7)
local real rd=SR(x,y,x1,y1)
local real dmg=LoadReal(h,id,8)
local player p=GetOwningPlayer(l__d)
local integer idu=GetPlayerId(p)
local real cof=rd/dist
if rd>speed+20 then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SaveReal(h,id,1,speed*1.02)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,mh*cof+50,0)
else
call GroupEnumUnitsInRange(G,x1,y1,200,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SlowUnit(u,E,0.8,0,5,0,false)
endif
call GroupRemoveUnit(G,E)
endloop
call UnitApplyTimedLife(CreateUnit(p,'e0G1',x1,y1,GetRandomReal(0,359)),0,1)
call UnitApplyTimedLife(CreateUnit(p,'e0G2',x1,y1,GetRandomReal(0,359)),0,1)
call UnitApplyTimedLife(CreateUnit(p,'e0G3',x1,y1,GetRandomReal(0,359)),0,1)
call DestroyEffect(AddSpecialEffect("war3mapImported\\Slam.mdx",x1,y1))
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set l__d=null
set t=null
endfunction
function SanzuFallShotMissleFly takes unit u,unit l__d,real speed,real angle,real x,real y,real mh,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,mh)
call SaveReal(h,id,6,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,8,dmg)
call SaveUnitHandle(h,id,9,u)
call TimerStart(t,0.03,true,function SanzuFallShotMissleFly2)
set t=null
endfunction
function SFSCond takes nothing returns boolean
return GetSpellAbilityId()==0x41304342 and udg_B==true
endfunction
function SanzuFallShotCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroAgi(u,true)*3
local real he=0
local real l__d=0
if GetUnitCurrentOrder(u)==OrderId("channel")then
if GetUnitTypeId(u)!='H06N' and GetUnitTypeId(u)!='H06O' then
set n=CreateUnit(p,0x65303654,x,y,Atan2(y1-y,x1-x)*bj_RADTODEG)
call SetUnitFlyHeight(n,475,0)
call SetUnitInvulnerable(u,true)
elseif GetUnitTypeId(u)=='H06N' or GetUnitTypeId(u)=='H06O' then
set l__d=GetRandomReal(-400,400)
set x=x+l__d*Cos(a+deg90)
set y=y+l__d*Sin(a+deg90)
set n=CreateUnit(p,0x65313352,x,y,(Atan2(y1-y,x1-x)*bj_RADTODEG))
call SetUnitAnimation(n,"Attack")
call UnitApplyTimedLife(n,1,0.5)
call SetUnitFlyHeight(n,325,0)
set n=CreateUnit(p,0x65313355,x,y,Atan2(y1-y,x1-x)*bj_RADTODEG)
call SetUnitFlyHeight(n,405,0)
call SetUnitInvulnerable(u,true)
endif
call SanzuFallShotMissleFly(u,n,50,0,x1+GetRandomReal(-475,475)*Cos(GetRandomReal(0,359)*bj_DEGTORAD),y1+GetRandomReal(-475,475)*Sin(GetRandomReal(0,359)*bj_DEGTORAD),375,dmg)
else
call SetUnitFlyHeight(u,0,400)
call SetUnitInvulnerable(u,false)
call PauseTimer(t)
call DestroyTimer(t)
call KillUnit(LoadUnitHandle(h,id,15))
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set t=null
endfunction
function SFSCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,GetSpellTargetX())
call SaveReal(h,id,3,GetSpellTargetY())
call UnitAddAbility(u,'Arav')
call UnitRemoveAbility(u,'Arav')
call SetUnitInvulnerable(u,true)
if SR(x,y,x1,y1)<600 then
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
if IsTerrainPathable(x-600*Cos(a),y-600*Sin(a),PATHING_TYPE_FLYABILITY)==false then
set x=x-600*Cos(a)
set y=y-600*Sin(a)
else
set x=x-50*Cos(a)
set y=y-50*Sin(a)
endif
call SetUnitXY_1(u,x,y, false)
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
endif
if GetUnitTypeId(u)!='H06N' and GetUnitTypeId(u)!='H06O' then
call SetUnitFlyHeight(u,400,0)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\UltimateKid.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
elseif GetUnitTypeId(u)=='H06N' or GetUnitTypeId(u)=='H06O' then
call SetUnitFlyHeight(u,330,0)
set n=CreateUnit(p,0x65313354,x,y,a*bj_RADTODEG)
call SaveUnitHandle(h,id,15,n)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\DrakeT.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
call TimerStart(t,0.07,true,function SanzuFallShotCast2)
set u=null
set p=null
set t=null
endfunction
function SFSInit takes nothing returns nothing
set gg_trg_SFS=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_SFS,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddAction(gg_trg_SFS,function SFSCast)
call TriggerAddCondition(gg_trg_SFS,Condition(function SFSCond))
endfunction
function SanzuReverShootFly2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
local real dist=LoadReal(h,id,6)
local real mh=LoadReal(h,id,5)
local real rad=LoadReal(h,id,7)
local real rd=SR(x,y,x1,y1)
local real dmg=LoadReal(h,id,8)
local player p=GetOwningPlayer(l__d)
local integer idu=GetPlayerId(p)
if rd>speed+30 then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,ParabolaZ(mh,dist,rd),0)
else
call GroupEnumUnitsInRange(G,x1,y1,rad,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(Hero[idu],E,dmg,false,false,null,null,null)
call SetControlToUnit(Hero[idu],E, 1, "stun")
endif
call GroupRemoveUnit(G,E)
endloop
if GetUnitTypeId(l__d)!=0x65313355 then
call DestroyEffect(AddSpecialEffect("war3mapImported\\PinkShockwave.mdx",x,y))
call DestroyEffect(AddSpecialEffect("war3mapImported\\PinkSlam.mdx",x,y))
else
call UnitApplyTimedLife(CreateUnit(p,'e0G1',x,y,GetRandomReal(0,359)),0,1)
call UnitApplyTimedLife(CreateUnit(p,'e0G2',x,y,GetRandomReal(0,359)),0,1)
call UnitApplyTimedLife(CreateUnit(p,'e0G3',x,y,GetRandomReal(0,359)),0,1)
call DestroyEffect(AddSpecialEffect("war3mapImported\\Slam.mdx",x,y))
endif
call KillUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set l__d=null
set t=null
endfunction
function SanzuReverShootFly takes unit l__d,real speed,real angle,real x,real y,real mh,real r,real dmg returns nothing
