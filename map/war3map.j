// set n=CreateUnit(p,'e12Q',x,y,GetRandomReal(0,359))
// call SetUnitVertexColor(n,255,255,255,255)
// call UnitApplyTimedLife(n,'BTLF',3)
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set l__d=null
set t=null
endfunction
