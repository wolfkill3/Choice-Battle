// Стоячий вихрь: пойманных (группа g) не выпускаем — кто живой ушёл от центра дальше r, того ставим на край r.
// Выйти можно только разовым рывком: оказался дальше края больше чем на 300 — пойманный отпущен.
// Раньше вихрь тянул к центру слабее, чем герой бежит, и из него можно было просто выйти (E Мисаки).
function VortexHold takes group g,real cx,real cy,real r returns nothing
local group tmp=CreateGroup()
local unit e
local real vhd
local real vha
loop
set e=FirstOfGroup(g)
exitwhen e==null
call GroupRemoveUnit(g,e)
set vhd=SR(cx,cy,GetUnitX(e),GetUnitY(e))
if UnitIsAlive(e) and vhd>r+300. then
// выпрыгнул разом далеко (рывок, прыжок, телепорт) — отпускаем совсем: ходьбой за тик так не уйти
call SetUnitPathing(e,true)
call SetUnitFlyHeight(e,0,GetUnitFlyHeight(e))
else
call GroupAddUnit(tmp,e)
if UnitIsAlive(e) then
if vhd>r then
set vha=Atan2(GetUnitY(e)-cy,GetUnitX(e)-cx)
call SetUnitX(e,cx+r*Cos(vha))
call SetUnitY(e,cy+r*Sin(vha))
endif
endif
endif
endloop
loop
set e=FirstOfGroup(tmp)
exitwhen e==null
call GroupRemoveUnit(tmp,e)
call GroupAddUnit(g,e)
endloop
call DestroyGroup(tmp)
set tmp=null
set e=null
endfunction
function IronSand2Cond takes nothing returns boolean
return GetSpellAbilityId()=='A0RN' and udg_B
endfunction
function IronSand2Cast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local group g=LoadGroupHandle(h,id,5)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real x2
local real y2
local real f=GetUnitFacing(l__d)
local real a=Atan2(y-y1,x-x1)
local real a2
local player p=GetOwningPlayer(u)
local real dmg2=LoadReal(h,id,10)
local real dmg=GetHeroAgi(u,true)*0.0875+dmg2*0.01
local real lvl=3.0
local boolean b=LoadBoolean(h,id,8)
local real time=LoadReal(h,id,7)
if SR(x,y,x1,y1)>34 then
call SetUnitX(l__d,x1+31*Cos(a))
call SetUnitY(l__d,y1+31*Sin(a))
elseif SR(x,y,x1,y1)<34 and time<lvl then
if b==false then
        call UnitApplyTimedLife(CreateUnit(p,'e0PZ',x,y,a*bj_RADTODEG),'BTLF',lvl)
        call UnitApplyTimedLife(CreateUnit(p,'e0Q0',x,y,a*bj_RADTODEG),'BTLF',lvl)
        call SaveBoolean(h,id,8,true)
        call SetUnitScale(l__d,1.5,1.5,1.5)
        set soundplay=SndN(1930) // Sound\war3mapImported\Misaka E2.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call GroupEnumUnitsInRange(G,x1,y1,350,Base)
set n=CreateUnit(p,'e08J',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.5)
call SetUnitTimeScale(n,1.5)
call SetUnitVertexColor(n,0,0,0,125)
call SaveReal(h,id,7,time+0.05)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
set x2=GetUnitX(E)
set y2=GetUnitY(E)
set a2=Atan2(y2-y1,x2-x1)+1.35
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(u,E,0.11, "silenceTE")
call SetUnitX(E,x2-19*Cos(a2))
call SetUnitY(E,y2-19*Sin(a2))
call SetUnitX(E,GetUnitX(E)+10*Cos(AU(E, l__d)))
call SetUnitY(E,GetUnitY(E)+10*Sin(AU(E, l__d)))
//call IssueImmediateOrder(E,"stop")
if GetUnitFlyHeight(E)<500 then
call SetUnitFlyHeight(E,GetUnitFlyHeight(E)+1.3,0)
endif
if IsUnitInGroup(E,g)==false then
call UnitAddAbility(E,'Arav')
call UnitRemoveAbility(E,'Arav')
call GroupAddUnit(g,E)
call SetUnitPathing(E,false)
endif
endif
call GroupRemoveUnit(G,E)
endloop
// пойманные не выходят из вихря (радиус 350, держим в 300)
call VortexHold(g,x1,y1,300)
elseif time>lvl then
loop
set E=FirstOfGroup(g)
exitwhen E==null
call SetUnitFlyHeight(E,0,GetUnitFlyHeight(E))
call GroupRemoveUnit(g,E)
call SetUnitPathing(E,true)
endloop
call FlushChildHashtable(h,id)
call DestroyTimer(t)
call DestroyGroup(g)
call RemoveUnit(l__d)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function IronSand2Cast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
set n=CreateUnit(GetOwningPlayer(u),'e0PZ',x+80*Cos(a),y+80*Sin(a),f)
call SetUnitScale(n,0.5,0.5,0.5)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,n)
call SaveReal(h,id,2,GetSpellTargetX())
call SaveReal(h,id,3,GetSpellTargetY())
call SaveReal(h,id,5,a)
call SaveGroupHandle(h,id,5,CreateGroup())
call SaveReal(h,id,7,0)
call SaveBoolean(h,id,8,false)
call SaveReal(h,id,10,0)
if GetUnitAbilityLevel(u,'B05A')>0 then
        call SaveReal(h,id,10,GetHeroInt(u,true)*2)
        set soundplay=SndN(1933) // Sound\war3mapImported\Misaka EF.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
        set soundplay=SndN(1935) // Sound\war3mapImported\Misaka E1.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
// set soundplay=CreateSound("Sound\\Music\\mp3Music\\IronSand.mp3",false,false,true,12700,12700,"")
// call StartSound(soundplay)
// call KillSoundWhenDone(soundplay)
call TimerStart(t,0.05,true,function IronSand2Cast2)
set u=null
set t=null
set d=null
endfunction
function LightningStrikeCond takes nothing returns boolean
return GetSpellAbilityId()=='A0RM' and udg_B==true
endfunction

function MisakaWMorf_Periodic takes nothing returns nothing
        local integer id=GetHandleId(GetExpiredTimer())
        local real time = LoadReal(h, id, TIME_HASH)
        local real point_x = LoadReal(h, id, SH_Point_X)
        local real point_y = LoadReal(h, id, SH_Point_Y)
        local real dmg = GetHeroAgi(LoadUnitHandle(h, id, CasterHash), true)*0.15
        local real angle = GetRandomInt(0, 360)
        local integer PeriodicStun = LoadInteger(h, id, SH_PeriodicStun)
        if time<3.0 then
                call SaveReal(h, id, TIME_HASH, time+0.1)
                if PeriodicStun==2 then
                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dH55', point_x+400*Cos(angle), point_y+400*Sin(angle), GetRandomInt(0, 360))
                        call SetUnitScale(n, 1.4, 1.4, 1.4)
                        call MyRemoveUnit(n, 1.0)
                        // set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dH51', point_x+400*Cos(angle), point_y+400*Sin(angle), GetRandomInt(0, 360))
                        // call SetUnitScale(n, 0.5, 0.5, 0.5)
                        // call MyRemoveUnit(n, 1.0)
                        call SaveInteger(h, id, SH_PeriodicStun, 0)
                else
                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dH56', point_x, point_y, GetRandomInt(0, 360))
                        call SetUnitScale(n, 2.0, 2.0, 2.0)
                        call UnitApplyTimedLife(n,'BTLF', 0.5)
                        call MyRemoveUnit(n, 1.0)
                        call SaveInteger(h, id, SH_PeriodicStun, PeriodicStun+1)
                endif
                set bjLCG = CreateGroup()
                call GroupEnumUnitsInRange(bjLCG, point_x, point_y, 400, Base)
                loop
                set bjLCU=FirstOfGroup(bjLCG)
                exitwhen bjLCU==null
                        if Condition_Base(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), bjLCU) then
                                if PeriodicStun==0 then
                                        call SetControlToUnit(LoadUnitHandle(h, id, CasterHash), bjLCU, 0.03, "stun")
                                endif
                                call MisakaRemoveElectrification(LoadUnitHandle(h, id, CasterHash), bjLCU, dmg)
                                // set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dH54', GetUnitX(bjLCU), GetUnitY(bjLCU), GetRandomInt(0, 360))
                                // call SetUnitFlyHeight(n, 50, 0)
                                // call SetUnitScale(n, 1.5, 1.5, 1.5)
                                // call MyRemoveUnit(n, 1.0)
                        endif
                        call GroupRemoveUnit(bjLCG, bjLCU)
                endloop
                call DestroyGroup(bjLCG)
        else
                call FlushChildHashtable(h, id)
                call DestroyTimer(GetExpiredTimer())
        endif
endfunction

function MisakaW_Periodic takes nothing returns nothing
        local integer id=GetHandleId(GetExpiredTimer())
        local integer time = LoadInteger(h, id, TIME_HASH)
        local real point_x = LoadReal(h, id, SH_Point_X)
        local real point_y = LoadReal(h, id, SH_Point_Y)
        local real dmg = GetHeroAgi(LoadUnitHandle(h, id, CasterHash), true)*1.2
        if time<6 then
                if LoadReal(h, id, SH_PrepareTime)<1.0 then
                        call SaveReal(h, id, SH_PrepareTime, LoadReal(h, id, SH_PrepareTime)+1 )
                else
                        call SaveInteger(h, id, TIME_HASH, time+1)
                        call ShakeCamera(0.05,2)
                        set point_x = point_x + GetRandomInt(-300, 300)
                        set point_y = point_y + GetRandomInt(-300, 300)
                        call MyRemoveUnit(CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dAlb', point_x, point_y, 0), 1)
                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dH55', point_x, point_y, GetRandomInt(0, 360))
                        call SetUnitScale(n, 1.3, 1.3, 1.3)
                        call MyRemoveUnit(n, 1.5)
                        call DestroyEffect(AddSpecialEffect(" ", point_x, point_y))
                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dH51', point_x, point_y, GetRandomInt(0, 360))
                        call SetUnitScale(n, 0.5, 0.5, 0.5)
                        call MyRemoveUnit(n, 1.5)
                        set bjLCG = CreateGroup()
                        call GroupEnumUnitsInRange(bjLCG, point_x, point_y, 260, Base)
                        loop
                        set bjLCU=FirstOfGroup(bjLCG)
                        exitwhen bjLCU==null
                                if Condition_Base(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), bjLCU) then
                                        // call myCustomDamage(LoadUnitHandle(h, id, CasterHash), bjLCU, dmg,false,false,null,null,null)
                                        call SetControlToUnit(LoadUnitHandle(h, id, CasterHash), bjLCU, 0.15, "stun")
                                        call MisakaRemoveElectrification(LoadUnitHandle(h, id, CasterHash), bjLCU, dmg)
                                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dH54', GetUnitX(bjLCU), GetUnitY(bjLCU), GetRandomInt(0, 360))
                                        call SetUnitFlyHeight(n, 50, 0)
                                        call SetUnitScale(n, 1.5, 1.5, 1.5)
                                        call MyRemoveUnit(n, 1.0)
                                endif
                                call GroupRemoveUnit(bjLCG, bjLCU)
                        endloop
                        call DestroyGroup(bjLCG)
                endif
        else
                call FlushChildHashtable(h, id)
                call DestroyTimer(GetExpiredTimer())
        endif
endfunction

function LightningStrikeCast takes nothing returns nothing
        local unit u=GetTriggerUnit()
        local real x=GetSpellTargetX()
        local real y=GetSpellTargetY()
        local player p=GetOwningPlayer(u)
        local real i=0
        local real dmg=(1+GetUnitAbilityLevel(u,'A0RM'))*GetHeroAgi(u,true)
        if GetUnitAbilityLevel(u,'B05A')>0 then
                set dmg=dmg+GetHeroInt(u,true)*2
                set soundplay=SndN(1937) // Sound\war3mapImported\Misaka WF.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        else
                set soundplay=SndByPath("Sound\\war3mapImported\\Misaka W1-" +I2S(GetRandomInt(1, 3))+".mp3")
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        endif
        call ShakeCamera(0.2,10)
        set n=CreateUnit(p, 'dH66', x, y, GetRandomInt(0, 360))
        call SetUnitTimeScale(n, 0.75)
        call MyRemoveUnit(n, 1.5)
        call DestroyEffect(AddSpecialEffect(" ",x,y))
        set n=CreateUnit(p, 'dH57', x, y, GetRandomInt(0, 360))
        call SetUnitScale(n, 4, 4, 4)
        call MyRemoveUnit(n, 1.5)
        set bjLCU = CreateUnit(p, 'dH52', x, y, GetRandomInt(0, 360))
        call SetUnitScale(bjLCU, 6, 6, 15)
        call SetUnitTimeScale(bjLCU, 0.75)
        call MyRemoveUnit(bjLCU, 2)
        set bjLCU = CreateUnit(p, 'dH58', x, y, GetRandomInt(0, 360))
        call SetUnitScale(bjLCU, 6, 6, 6)
        call SetUnitTimeScale(bjLCU, 1.5)
        call SetUnitAnimation(bjLCU, "stand large")
        call MyRemoveUnit(bjLCU, 5)
        set n=CreateUnit(p, 'dH59', x, y, GetRandomInt(0, 360))
        call SetUnitScale(n, 4, 4, 4)
        call MyRemoveUnit(n, 1.5)
        set bjLCU = CreateUnit(p, 'dH55', x, y, GetRandomInt(0, 360))
        call SetUnitScale(bjLCU, 4, 4, 4)
        call MyRemoveUnit(bjLCU, 2)
        loop
        exitwhen i>=8
                set bjLCU = CreateUnit(p, 'dH55', x+200*Cos(i*45), y+200*Sin(i*45), GetRandomInt(0, 360))
                call SetUnitScale(bjLCU, 2.5, 2.5, 2.5)
                call SetUnitTimeScale(bjLCU, 0.75)
                call MyRemoveUnit(bjLCU, 2)
                call DestroyEffect(AddSpecialEffect(" ", x, y))
                set bjLCU = CreateUnit(p, 'dH52', x+150*Cos(i*45), y+150*Sin(i*45), GetRandomInt(0, 360))
                call SetUnitScale(bjLCU, 2, 2, 2)
                call SetUnitTimeScale(bjLCU, 0.75)
                call MyRemoveUnit(bjLCU, 2)
                set i=i+1
        endloop
        
        call GroupEnumUnitsInRange(DG,x,y,400,Base)
        // call UnitApplyTimedLife(CreateUnit(p,'e087',x,y,GetRandomReal(0,359)),'BTLF',1)
        // loop
        // exitwhen i>=7
                // call UnitApplyTimedLife(CreateUnit(p,'e086',x,y,GetRandomReal(0,359)),'BTLF',1)
                // set n=CreateUnit(p,'e016',x,y,GetRandomReal(0,359))
                // call UnitAddAbility(n,'Arav')
                // call UnitApplyTimedLife(n,'BTLF',0.1)
                // set i=i+1
        // endloop
        loop
        set E=FirstOfGroup(DG)
        exitwhen E==null
                if Condition_Base(p,E)then
                        // call myCustomDamage(u,E,dmg,false,false,null,null,null)
                        call MisakaRemoveElectrification(u, E, dmg)
                endif
                call GroupRemoveUnit(DG,E)
        endloop
        //call CinematicFadeBJCustom(bj_CINEFADETYPE_FADEIN, 1,"ReplaceableTextures\\CameraMasks\\White_mask.blp",125,185,255,0)
        set bjLCT = CreateTimer()
        call SaveUnitHandle(h, GetHandleId(bjLCT), CasterHash, u)
        call SaveReal(h, GetHandleId(bjLCT), SH_Point_X, x)
        call SaveReal(h, GetHandleId(bjLCT), SH_Point_Y, y)
        if GetUnitAbilityLevel(u,'B05A')>0 then
                call TimerStart(bjLCT, 0.1, true, function MisakaWMorf_Periodic)
        else
                call TimerStart(bjLCT, 0.5, true, function MisakaW_Periodic)
        endif
        set bjLCT = null
        set u=null
        set p=null
endfunction
function LightningShinsoCond takes nothing returns boolean
return GetSpellAbilityId()=='A0RL' and udg_B==true
endfunction
function LightningShinsoCast2 takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(h,id,0)
        local unit l__d=LoadUnitHandle(h,id,1)
        local player p=GetOwningPlayer(u)
        local integer idu=GetPlayerId(p)
        local real x=LoadReal(h,id,3)
        local real y=LoadReal(h,id,4)
        local real x1=GetUnitX(l__d)
        local real y1=GetUnitY(l__d)
        local real x2=GetUnitX(u)
        local real y2=GetUnitY(u)
        local real f=GetUnitFacing(l__d)
        local real a=LoadReal(h,id,8)
        local real dmg2=LoadReal(h,id,10)
        local real dmg=100+GetHeroAgi(u,true)*(2+GetUnitAbilityLevel(u,'A0RL'))+dmg2
        local real Range=LoadReal(h,id,9)
        local real speed=LoadReal(h,id,11)
        local integer i=0
        if Range<4000 and UnitIsAlive(l__d)then
                set x1=x1+speed*Cos(a)
                set y1=y1+speed*Sin(a)
                call SetUnitXY_1(l__d,x1,y1, false)
                call SaveReal(h,id,3,x1)
                call SaveReal(h,id,4,y1)
                call SetUnitFacing(l__d,a*bj_RADTODEG)
                call SaveReal(h,id,9,Range+speed)
                call SaveReal(h,id,11,speed+1)
                call GroupEnumUnitsInRange(G,x1,y1,125,Base)
                call UnitApplyTimedLife(CreateUnit(p,'e0PY',x,y,a*bj_RADTODEG),'BTLF',1)
                set n=CreateUnit(p,0x65305058,x,y,GetRandomReal(0,359))
                call UnitApplyTimedLife(n,'BTLF',1)
                call SetUnitTimeScale(n,3)
                if dmg2>0 then
                        set n=CreateUnit(p,'e08J',x2,y2,GetRandomReal(0,359))
                        call UnitApplyTimedLife(n,'BTLF',0.5)
                        call SetUnitScale(n,1.5,1.5,1.5)
                        call SetUnitTimeScale(n,1.5)
                        call SetUnitVertexColor(n,0,0,0,125)
                        call UnitApplyTimedLife(CreateUnit(p,'e0F5',x2+GetRandomReal(-75,75),y2+GetRandomReal(-75,75),0),'BTLF',1)
                        call UnitApplyTimedLife(CreateUnit(p,'e0F3',x1+GetRandomReal(-75,75),y1+GetRandomReal(-75,75),0),'BTLF',1)
                endif
                loop
                set E=FirstOfGroup(G)
                exitwhen E==null
                if Condition_Base(p,E)then
                        call KillUnit(l__d)
                endif
                call GroupRemoveUnit(G,E)
                endloop
        else
                loop
                exitwhen i>=7
                        call UnitApplyTimedLife(CreateUnit(p,'e086',x,y,GetRandomReal(0,359)),'BTLF',1)
                        set n=CreateUnit(p,'e016',x,y,GetRandomReal(0,359))
                        call UnitAddAbility(n,'Arav')
                        call UnitApplyTimedLife(n,'BTLF',0.1)
                        set i=i+1
                endloop
                set n=CreateUnit(p, 'dH60', x, y, GetRandomInt(0, 360))
                call SetUnitScale(n, 2, 2, 2)
                call MyRemoveUnit(n, 1.5)
                set soundplay=SndN(1945) // Sound\war3mapImported\Misaka Q2.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                call GroupEnumUnitsInRange(G,x,y,500,Base)
                loop
                set E=FirstOfGroup(G)
                exitwhen E==null
                        if Condition_Base(p,E)then
                                // call myCustomDamage(u,E,dmg,false,false,null,null,null)
                                if Range>=1500 and GetHeroLevel(u)>11 then
                                        call MisakaAddElectrification(u, E, dmg)
                                else
                                        call MisakaRemoveElectrification(u, E, dmg)
                                endif
                        endif
                        call GroupRemoveUnit(G,E)
                endloop
                call RemoveUnit(l__d)
                call FlushChildHashtable(h,id)
                call PauseTimer(t)
                call DestroyTimer(t)
        endif
        set u=null
        set p=null
        set t=null
        set l__d=null
endfunction
function CastLightningShinso takes nothing returns nothing
        local unit u=GetTriggerUnit()
        local timer t=CreateTimer()
        local integer id=GetHandleId(t)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        local real x1=GetSpellTargetX()
        local real y1=GetSpellTargetY()
        local real a=Atan2(y1-y,x1-x)
        local player p=GetOwningPlayer(u)
        call SaveUnitHandle(h,id,0,u)
        call SaveReal(h,id,3,x)
        call SaveReal(h,id,4,y)
        call SaveReal(h,id,8,a)
        call SaveReal(h,id,11,50)
        set n=CreateUnit(GetOwningPlayer(u),'e0PY',x,y,a*bj_RADTODEG)
        call SetUnitScale(n,3,3,3)
        call SaveUnitHandle(h,id,1,n)
        set x=x+80*Cos(a)
        set y=y+80*Sin(a)
        call UnitApplyTimedLife(CreateUnit(p,'e0PU',x,y,a*bj_RADTODEG),'BTLF',2)
        call UnitApplyTimedLife(CreateUnit(p,'e0PV',x,y,a*bj_RADTODEG),'BTLF',2)
        set n=CreateUnit(p,'e0PW',x,y,a*bj_RADTODEG)
        call UnitApplyTimedLife(n,'BTLF',2)
        call SetUnitTimeScale(n,3)
        call SaveReal(h,id,10,0)
        if GetUnitAbilityLevel(u,'B05A')>0 then
                call SaveReal(h,id,10,GetHeroInt(u,true)*2)
                set soundplay=SndN(1948) // Sound\war3mapImported\Misaka QF.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        else
                set soundplay=SndN(1950) // Sound\war3mapImported\Misaka Q1.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        endif
        // set soundplay=CreateSound("Sound\\Music\\mp3Music\\lightningShinso.mp3",false,false,true,12700,12700,"")
        // call StartSound(soundplay)
        // call KillSoundWhenDone(soundplay)
        call TimerStart(t,0.03,true,function LightningShinsoCast2)
        set u=null
        set p=null
        set t=null
endfunction
