function ScissorsCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,22)
local unit l__d=LoadUnitHandle(h,id,7)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=LoadReal(h,id,11)
local real a2=Atan2(y1-y,x1-x)
local real dmg=0
local player p=GetOwningPlayer(u)
local real dist=LoadReal(h,id,2)
local real time=LoadReal(h,id,17)
if SR(x,y,x1,y1)>400 and time>0 and LoadBoolean(h,id,12)==false then
    call SaveReal(h,id,17,time-0.02)
    call PauseUnit(u,true)
    call SetUnitInvulnerable(u,true)
    if GetUnitTypeId(u)!='H04B' then
        set x=x+60*Cos(a2)
        set y=y+60*Sin(a2)
        call SetUnitXY_1(u,x,y, false)
        call SetUnitFacingInstant(u,a2*bj_RADTODEG)
        call SetUnitX(l__d,x+25*Cos(a2-deg90))
        call SetUnitY(l__d,y+25*Sin(a2-deg90))
        call UnitRemoveAbility(u,'A2VJ')
        set n=CreateUnit(p,'e0RM',x,y,a2*bj_RADTODEG)
        call UnitApplyTimedLife(n,'BTLF',0.25)
        call SetUnitTimeScale(n,2)
        call SetUnitVertexColor(n,255,255,255,125)
        set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',0.01)
        call SetUnitScale(n,0.65,0.65,0.65)
        call SetUnitVertexColor(n,255,230,100,50)
        set n=CreateUnit(p,'e0RE',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',0.01)
        call SetUnitVertexColor(n,255,230,100,50)
    else
        call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
        set x=x1-350*Cos(a2)
        set y=y1-350*Sin(a2)
        call SetUnitXY_1(u,x,y, false)
        call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
    endif
else
    if time>0 then
        if LoadBoolean(h,id,12)==false then
            call SaveReal(h,id,11,Atan2(y1-y,x1-x))
            call SaveBoolean(h,id,12,true)
            if GetUnitTypeId(u)!='H04B' then
                set soundplay=SndN(2049) // Sound\Music\mp3Music\JajankenChiii.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            endif
        endif
        if dist<1000 then
            set x=x+60*Cos(a)
            set y=y+60*Sin(a)
            call SetUnitXY_1(u,x,y, false)
            call SetUnitX(l__d,x+25*Cos(a-deg90))
            call SetUnitY(l__d,y+25*Sin(a-deg90))
            call UnitRemoveAbility(u,'A2VJ')
            if GetUnitTypeId(u)=='H04B' then
                set n=CreateUnit(p,'e1RM',x,y,a*bj_RADTODEG)
            else
                set n=CreateUnit(p,'e0RM',x,y,a*bj_RADTODEG)
            endif
            call UnitApplyTimedLife(n,'BTLF',0.25)
            call SetUnitTimeScale(n,2)
            call SetUnitVertexColor(n,255,255,255,125)
            call SetUnitAnimation(n,"spell channel")
            set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
            call UnitApplyTimedLife(n,'BTLF',0.01)
            call SetUnitScale(n,0.65,0.65,0.65)
            call SetUnitVertexColor(n,255,230,100,50)
            set n=CreateUnit(p,'e0RE',x,y,GetRandomReal(0,359))
            call UnitApplyTimedLife(n,'BTLF',0.01)
            call SetUnitVertexColor(n,255,230,100,50)
            call SaveReal(h,id,2,dist+60)
            if SR(x,y,x1,y1)<200 and LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==true then
                call RemoveUnit(l__d)
                call PauseUnit(u,false)
                call SetUnitInvulnerable(u,false)
                call PauseUnit(c,false)
                call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
                call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
                call PauseTimer(t)
                call DestroyTimer(t)
                call FlushChildHashtable(h,id)
            endif
        else
            call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),'BTLF',2)
            call UnitApplyTimedLife(CreateUnit(p,'e04D',x1,y1,GetRandomReal(0,359)),'BTLF',2)
            call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),'BTLF',2)
            call UnitApplyTimedLife(CreateUnit(p,'e04D',x1,y1,GetRandomReal(0,359)),'BTLF',2)
            call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),'BTLF',2)
            call UnitApplyTimedLife(CreateUnit(p,'e04D',x1,y1,GetRandomReal(0,359)),'BTLF',2)
            call UnitApplyTimedLife(CreateUnit(p,'e0HM',x1,y1,GetRandomReal(0,359)),'BTLF',1.4)
            call UnitApplyTimedLife(CreateUnit(p,'e0XQ',x,y,(a*bj_RADTODEG)),'BTLF',4)
            call PauseUnit(u,false)
            call RemoveUnit(l__d)
            call SetUnitInvulnerable(u,false)
            set dmg=((GetUnitAbilityLevel(u,'A0U6')+1)*GetHeroStr(u,true))+(GetUnitAbilityLevel(u,'A0U6')*75)
            if GetUnitAbilityLevel(u,'A0U5') > 0 then
                set dmg = dmg * (1.125+0.025*GetUnitAbilityLevel(u,'A0U5'))
            endif
            call IssueImmediateOrder(c,"stop")
            call myCustomDamage(u,c,dmg,false,false,null,null,null)
            call SetControlToUnit(u,c, 1, "silence")
            call PauseTimer(t)
            call DestroyTimer(t)
            call FlushChildHashtable(h,id)
        endif
    else
        call RemoveUnit(l__d)
        call PauseUnit(u,false)
        call SetUnitInvulnerable(u,false)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
    endif
endif
set l__d=null
set p=null
set c=null
set u=null
set t=null
endfunction
