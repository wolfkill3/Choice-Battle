function ScathachGTarget1 takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit target=LoadUnitHandle(HH,id,2)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real time1=LoadReal(HH,id,6)
local real x0=LoadReal(HH,id,11)
local real y0=LoadReal(HH,id,12)
local real damage=GetUnitState(target,UNIT_STATE_MAX_MANA)*0.2
set time1=time1+0.02
//set time1=time1+0.02
if time1==0.5 then
set time1=0
call SetUnitState(target,UNIT_STATE_MANA,GetUnitState(target,UNIT_STATE_MANA)-damage*0.066)
endif
call SaveReal(HH,id,6,time1)
set time=time-0.02
call SetUnitInvulnerable(target,true)
call PauseUnit(target,true)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
call SaveReal(HH,id,5,time)

if LoadBoolean(HH,id,19)==true then
call MoveAoe1(x0,y0,target,0,facing)
call SetUnitFlyHeight(target,1000,0)
endif

if SR(GetUnitX(target),GetUnitY(target),x0,y0)>150 and LoadBoolean(HH,id,19)==false then
call MoveUnit(target,target,20+1000/SR(GetUnitX(target),GetUnitY(target),x0,y0),Angle2(GetUnitX(target),GetUnitY(target),x0,y0))
call SetUnitFlyHeight(target,950-SR(GetUnitX(target),GetUnitY(target),x0,y0),0)
if SR(GetUnitX(target),GetUnitY(target),x0,y0)<=150 then
call SaveBoolean(HH,id,19,true)
call SaveReal(HH,id,11,GetUnitX(target))
call SaveReal(HH,id,12,GetUnitY(target))
endif
endif

if time<=0 or  udg_B==false then
call SetUnitFlyHeight(target,0,1000)
call PushTimed(target,facing,40,-30)
call SetUnitInvulnerable(target,false)
call PauseUnit(target,false)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
call UnitRemoveAbility(target,'A0QL')
if GetUnitState(target,UNIT_STATE_MANA)<GetUnitState(target,UNIT_STATE_MAX_MANA)*0.2 then
set damage=damage*5
endif




call myCustomDamage(caster,target,damage,false,false,null,null,null)
call SetUnitInvulnerable(target,true)
call UnitAddAbility(target,'A0QL')
call PauseUnit(target,true)
call SetUnitInvulnerableTimed(target,false,0.4)
call UnitRemoveAbilityTimed(target,'A0QL',0.4)
call PauseUnitTimed(target,false,0.4)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif





set target=null
set caster=null
endfunction
function ScathachGTarget takes unit caster0,unit target0,real x00,real y00,real facing0,real time0 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(HH,id,1,caster0)
call SaveUnitHandle(HH,id,2,target0)
call SaveReal(HH,id,3,Angle2(GetUnitX(target0),GetUnitY(target0),x00,y00))
call SaveReal(HH,id,5,time0)
call SaveReal(HH,id,11,x00)
call SaveReal(HH,id,12,y00)
call UnitAddAbility(target0,'Amrf')
call UnitRemoveAbility(target0,'Amrf')
call UnitAddAbility(target0,'A0QL')
call SetUnitInvulnerable(target0,true)
call PauseUnit(target0,true)
call SaveBoolean(HH,GetHandleId(target0),TARGET_ABILITY,true)
call TimerStart(t,0.02,true,function ScathachGTarget1)
set t=null
endfunction




function ScathachGAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real time1=LoadReal(HH,id,6)
local real x0=LoadReal(HH,id,11)
local real y0=LoadReal(HH,id,12)
set time=time+0.02
call SaveReal(HH,id,5,time)
if time==5  then
call RemoveUnit(LoadUnitHandle(HH,id,20))
if LoadGroupHandle(HH,id,4)!=null then
call DestroyGroup(LoadGroupHandle(HH,id,4))
call SaveGroupHandle(HH,id,4,null)
endif
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else
set time1=time1+0.02
if time1==0.2 then
call EffectCreateAndMove(true,"Others\\wind4.mdl",GetRandomReal(0,360),1,GetRandomReal(1.5,2.5),GetRandomReal(0.6,1),100,100,100,GetRandomReal(40,60),-200,LoadUnitHandle(HH,id,20),0,facing)
set time1=0
endif
call SaveReal(HH,id,6,time1)
if time==0.02 then
set n0=CreateUnit(GetOwningPlayer(caster),'e200',x0,y0,facing)
call SetUnitModel(n0,"Others\\HakkeStart2.mdl")
call UnitSize(n0,1.9,1,1)
call UnitSpeed(n0,1)
call UnitColor(n0,100,100,100,20)
call SetUnitFlyHeight(n0,0,0)
call SaveUnitHandle(HH,id,21,n0)
call MyRemoveUnit(n0,5)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',x0,y0,facing)
call SetUnitModel(n0,"Others\\HakkeStart2.mdl")
call UnitSize(n0,1,1,1)
call UnitSpeed(n0,1)
call UnitColor(n0,100,100,100,20)
call MoveAoe1(x0,y0,n0,600,facing)
call SetUnitFlyHeight(n0,0,0)
call SaveUnitHandle(HH,id,22,n0)
call MyRemoveUnit(n0,5)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',x0,y0,facing)
call SetUnitModel(n0,"Others\\HakkeStart2.mdl")
call UnitSize(n0,1,1,1)
call UnitSpeed(n0,1)
call UnitColor(n0,100,100,100,20)
call MoveAoe1(x0,y0,n0,1200,facing)
call SetUnitFlyHeight(n0,0,0)
call SaveUnitHandle(HH,id,23,n0)
call MyRemoveUnit(n0,5)
set n0=null
call SaveGroupHandle(HH,id,4,CreateGroup())
set soundplay=SndN(4072) // Sound\Music\mp3Music\ScathachG.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set n0=CreateUnit(GetOwningPlayer(caster),'e200',x0,y0,facing)
call SetUnitModel(n0,"Others\\ScathachGateNew.mdl")
call UnitSize(n0,1,1,1)
call UnitSpeed(n0,1)
call UnitColor(n0,100,100,100,100)
call SetUnitFlyHeight(n0,1000,0)
call SetUnitAnimationByIndex(n0,3)
call SaveUnitHandle(HH,id,20,n0)
call EffectCreateAndMove(true,"Others\\baise-Cloud.mdl",facing,5,1,1,100,100,100,0,0,n0,0,facing)
call EffectCreateAndMove(true,"Others\\jjhd.mdl",facing,3,0.85,0.6,100,100,100,0,300,n0,150,facing)
set n0=null
endif
if time==0.5 then
call EffectCreateAndMove90(true,"Others\\BY_Wood_Eff_Wid_XuanFeng.mdl",facing,2.5,15,1,100,100,100,0,250,LoadUnitHandle(HH,id,20),0,facing)
call UnitSpeed(LoadUnitHandle(HH,id,21),0)
call UnitSpeed(LoadUnitHandle(HH,id,22),0)
call UnitSpeed(LoadUnitHandle(HH,id,23),0)
endif
if time<0.5 then
call UnitColor(LoadUnitHandle(HH,id,20),100,100,100,100-time*200)
endif
if time>4 then
call UnitColor(LoadUnitHandle(HH,id,20),100,100,100,(time-5)*100)
endif
if time>0.5 and time<3 then
call GroupClear(G)
call GroupEnumUnitsInRange(G,PolX(x0,400,facing),PolY(y0,400,facing),500,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if IsUnitInGroup(n0,LoadGroupHandle(HH,id,4))==false and IsUnitEnemy(n0,GetOwningPlayer(caster))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(n0,'Avul')==0 then
call ScathachGTarget(caster,n0,x0,y0,facing,4-time)
call GroupAddUnit(LoadGroupHandle(HH,id,4),n0)
endif
call GroupRemoveUnit(G,n0)
endloop
call SaveGroupHandle(HH,id,4,LoadGroupHandle(HH,id,4))
call GroupClear(G)
call GroupEnumUnitsInRange(G,PolX(x0,800,facing),PolY(y0,800,facing),500,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if IsUnitInGroup(n0,LoadGroupHandle(HH,id,4))==false and IsUnitEnemy(n0,GetOwningPlayer(caster))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(n0,'Avul')==0 then
call ScathachGTarget(caster,n0,x0,y0,facing,4-time)
call GroupAddUnit(LoadGroupHandle(HH,id,4),n0)
endif
call GroupRemoveUnit(G,n0)
endloop
call SaveGroupHandle(HH,id,4,LoadGroupHandle(HH,id,4))
call GroupClear(G)
call GroupEnumUnitsInRange(G,PolX(x0,1200,facing),PolY(y0,1200,facing),500,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if IsUnitInGroup(n0,LoadGroupHandle(HH,id,4))==false and IsUnitEnemy(n0,GetOwningPlayer(caster))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(n0,'Avul')==0 then
call ScathachGTarget(caster,n0,x0,y0,facing,4-time)
call GroupAddUnit(LoadGroupHandle(HH,id,4),n0)
endif
call GroupRemoveUnit(G,n0)
endloop
call SaveGroupHandle(HH,id,4,LoadGroupHandle(HH,id,4))
call GroupClear(G)
endif
if time==3 then
call SetUnitAnimationByIndex(LoadUnitHandle(HH,id,20),4)
endif
if time==4 then
call EffectCreateAndMoveAn(true,"Others\\AFB_hudie.mdl",GetRandomReal(0,360),1,2.5,0.6,100,100,100,0,300,LoadUnitHandle(HH,id,20),150,facing,1)
call EffectCreateAndMove(true,"Others\\az-ziwu-yumao.mdl",facing,1,5,0.6,100,100,100,0,300,LoadUnitHandle(HH,id,20),150,facing)
endif
endif
set caster=null
endfunction


function ScathachGChoice_Act takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit caster=GetTriggerUnit()
local real x0=GetUnitX(caster)
local real y0=GetUnitY(caster)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real facing=Angle2(x0,y0,x1,y1)
call SaveUnitHandle(HH,id,1,caster)




call SaveReal(HH,id,11,PolX(x1,-600,facing) )
call SaveReal(HH,id,12,PolY(y1,-600,facing) )
call SaveReal(HH,id,3,facing)
call SetUnitAnimationByIndex(caster,4)
call TimerStart(t,0.02,true,function ScathachGAct)
set t=null
set caster=null
endfunction

function ScathachGChoice_Cond takes nothing returns boolean
if GetSpellAbilityId()=='ScaG' then
return true
else
return false
endif
endfunction


function InitTrig_ScathachG takes nothing returns nothing
local trigger ScathachGChoice=CreateTrigger()
local integer index
set index=0
loop
call TriggerRegisterPlayerUnitEvent(ScathachGChoice,Player(index),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set index=index+1
exitwhen index==bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddCondition(ScathachGChoice,Condition(function ScathachGChoice_Cond))
call TriggerAddAction(ScathachGChoice,function ScathachGChoice_Act)
set ScathachGChoice=null
set index=0
endfunction











