call UnitRemoveAbility(E,'Arav')
call SetUnitFlyHeight(E,750,1000)
call SetControlToUnit(E,E,1.6,"heavystun")
endloop
call DestroyGroupTimed(g2,3)
call SaveGroupHandle(h,id,1,g)
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveReal(h,id,5,40.)
call SaveUnitHandle(h,id,0,u)
call SetUnitInvulnerable(u,true)
if GetUnitAbilityLevel(u,'A25O')>0 then
call UnitRemoveAbility(u,'A25O')
call SaveBoolean(h,id,7,true)
endif
call UnitApplyTimedLife(CreateUnit(p,'e0YF',x,y,GetRandomReal(0,359)),'BTLF',0.5)
call UnitApplyTimedLife(CreateUnit(p,'e0YG',x,y,GetRandomReal(0,359)),'BTLF',0.5)
set n=CreateUnit(p,'e0RV',x,y,0)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,0.3)
set i=0
loop
exitwhen i>=8
set sc=GetRandomReal(0.5,1.2)
set x1=x+GetRandomReal(-400,400)
set y1=y+GetRandomReal(-400,400)
set n=CreateUnit(p,'e0OZ',x1,y1,GetRandomReal(0,359))
call SetUnitFlyHeight(n,4000,1000)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitPathing(n,false)
call SetUnitScale(n,sc,sc,sc)
set i=i+1
endloop
set soundplay=SndN(2464) // Sound\Music\mp3Music\Fujitora4.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.025,true,function GravitaZeroCast2)
set u=null
call DestroyBoolExpr(b)
set b=null
set g=null
set g2=null
set t=null
endfunction
