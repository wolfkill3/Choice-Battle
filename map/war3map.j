function EOrihimeCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit d1=LoadUnitHandle(h,id,2)
local unit d2=LoadUnitHandle(h,id,3)
local unit d3=LoadUnitHandle(h,id,4)
local real x=GetUnitX(c)
local real y=GetUnitY(c)
local real x1=GetUnitX(d1)
local real y1=GetUnitY(d1)
local real x2=GetUnitX(d2)
local real y2=GetUnitY(d2)
local real x3=GetUnitX(d3)
local real y3=GetUnitY(d3)
local integer idd=GetHandleId(c)
local player p=GetOwningPlayer(u)
local real a=0
if SR(x,y,x1,y1)>90 then
set a=Atan2(y-y1,x-x1)
set x1=x1+65*Cos(a)
set y1=y1+65*Sin(a)
call SetUnitX(d1,x1)
call SetUnitY(d1,y1)
set a=Atan2(y-y2,x-x2)-0.35
set x2=x2+70*Cos(a)
set y2=y2+70*Sin(a)
call SetUnitX(d2,x2)
call SetUnitY(d2,y2)
set a=Atan2(y-y3,x-x3)+0.35
set x3=x3+70*Cos(a)
set y3=y3+70*Sin(a)
call SetUnitX(d3,x3)
call SetUnitY(d3,y3)
else
set a=GetUnitFacing(c)*bj_DEGTORAD
set n=CreateUnit(p,'e16Q',x+100*Cos(a),y+100*Sin(a),a*bj_RADTODEG)
call SaveUnitHandle(h,id,13,n)
call SaveUnitHandle(h,GetHandleId(u),'A1HB',n)
call SaveUnitHandle(h,GetHandleId(u),'A1HB'+1,c)
call SetUnitVertexColor(n,255,155,155,155)
set n=CreateUnit(p,'e16G',x,y,0)
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitFlyHeight(d1,4000,0)
call SetUnitFlyHeight(d2,4000,0)
call SetUnitFlyHeight(d3,4000,0)
call UnitAddAbility(c,'A1HG')
call UnitMakeAbilityPermanent(c,true,'A1HG')
call SaveReal(h,idd,SH_ore1,(GetUnitAbilityLevel(u,'A1HB')+2)*GetHeroInt(u,true)+0.2*GetUnitState(c,UNIT_STATE_MAX_LIFE))
call SaveReal(h,idd,SH_ore3,(GetUnitAbilityLevel(u,'A1HB')+2)*GetHeroInt(u,true)+0.2*GetUnitState(c,UNIT_STATE_MAX_LIFE))
call SaveUnitHandle(h,idd,SH_ore2,u)
// длительность щита в статус-баре
call CreateModeIndicatorFormDispellable(c, "ReplaceableTextures\\CommandButtons\\BTNOrihimeE.blp", 10, 'A1HG')
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\InoueHeal.mdx",c,"origin"))
call SaveReal(h,id,10,10)
call PauseTimer(t)
call TimerStart(t,0.02,true,function EOrihimeCast3)
endif
set p=null
set d1=null
set d2=null
set d3=null
set c=null
set u=null
set t=null
endfunction
function EOrihimeCast takes nothing returns nothing
local timer t=CreateTimer()
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local real x2=0
local real y2=0
