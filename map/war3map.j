call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.025,true,function BlackChidoriCast2)
set u=null
set t=null
endfunction
function KagutsuchiCond takes nothing returns boolean
return GetSpellAbilityId()=='A12T' and udg_B==true
endfunction
function KagutsuchiCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local player p=GetOwningPlayer(u)
local integer idu=GetPlayerId(p)
local real x=LoadReal(h,id,3)
local real y=LoadReal(h,id,4)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,8)
local real dmg=GetHeroAgi(u,true)*13
local real Range=LoadReal(h,id,9)
local real speed=LoadReal(h,id,11)
local real time=LoadReal(h,id,12)
local integer i=0
call SaveReal(h,id,12,time+0.02)
if time<0.3 then
    if time==0.02 then
        call SetUnitAnimation(LoadUnitHandle(h,GetHandleId(u),SusanoCnst),"spell two")
    endif
    if time==0.28 then
        call PauseUnit(u,false)
        set n=CreateUnit(p,'e0WJ',GetUnitX(u),GetUnitY(u),a*bj_RADTODEG)
        call SaveUnitHandle(h,id,1,n)
    endif
else
if SR(x,y,x1,y1)>75 and UnitIsAlive(l__d) and udg_B==true and DU2==true and time<2 then
set x1=x1+speed*Cos(a)
set y1=y1+speed*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
call SetUnitFlyHeight(l__d,GetUnitFlyHeight(l__d)-LoadReal(h,id,15),0)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SaveReal(h,id,9,Range+speed)
else
call GroupEnumUnitsInRange(G,x,y,500,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(G,E)
endloop
set soundplay=SndN(2294) // war3mapImported\SasukeT2SFX.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call UnitRemoveAbility(LoadUnitHandle(h,GetHandleId(u),SusanoCnst),'S00B')
call UnitAddAbility(LoadUnitHandle(h,GetHandleId(u),SusanoCnst),'S009')
call UnitApplyTimedLife(CreateUnit(p,'e0C4',x1,y1,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0C5',x1,y1,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0CC',x1,y1,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0CD',x1,y1,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0C6',x1,y1,(a*bj_RADTODEG)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e0C7',x1,y1,(a*bj_RADTODEG)),'BTLF',6)
call UnitApplyTimedLife(CreateUnit(p,'e0IP',x1,y1,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0IS',x1,y1,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0IV',x1,y1,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0IR',x1,y1,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0IT',x1,y1,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e086',x1,y1,GetRandomReal(0,359)),'BTLF',2)
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
endif
endif
set u=null
set p=null
set t=null
set l__d=null
endfunction
function KagutsuchiCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local player p=GetOwningPlayer(u)
local integer idu=GetPlayerId(p)
local real x=LoadReal(h,id,3)
local real y=LoadReal(h,id,4)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,8)
local real dmg=GetHeroAgi(u,true)*9
local real Range=LoadReal(h,id,9)
local real speed=LoadReal(h,id,11)
local real time=LoadReal(h,id,12)
local integer i=0
call SaveReal(h,id,12,time+0.02)
if time<0.24 then
    if time==0.04 then
        call SetUnitAnimation(LoadUnitHandle(h,GetHandleId(u),SusanoCnst),"spell two")
    endif
    if time==0.22 then
        call PauseUnit(u,false)
        set n=CreateUnit(GetOwningPlayer(u),'e0WI',GetUnitX(u),GetUnitY(u),a*bj_RADTODEG)
        call SaveUnitHandle(h,id,1,n)
    endif
else
if SR(x,y,x1,y1)>75 and UnitIsAlive(l__d) and udg_B==true and DU2==true and time<2 then
set x1=x1+speed*Cos(a)
set y1=y1+speed*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,GetUnitFlyHeight(l__d)-LoadReal(h,id,15),0)
call SaveReal(h,id,9,Range+speed)
else
call GroupEnumUnitsInRange(G,x,y,500,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call PoisonDamage3(u,E,GetHeroAgi(u,true)*4,8,"war3mapImported\\amaterasu2.mdx","origin")
endif
call GroupRemoveUnit(G,E)
endloop
set n=CreateUnit(p,'h019',x1,y1,0)
call UnitApplyTimedLife(n,'BTLF',1)
call UnitAddAbility(n,'A00B')
call IssuePointOrder(n,"flamestrike",x1,y1)
call DestroyEffect(AddSpecialEffect("war3mapImported\\Death Release.mdx",x1,y1))
call DestroyEffect(AddSpecialEffect("war3mapImported\\NetherStrike.mdx",x1,y1))
call DestroyEffect(AddSpecialEffect("war3mapImported\\DarkNova.mdx",x1,y1))
call UnitApplyTimedLife(CreateUnit(p,'e04G',x1,y1,0),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e04E',x1,y1,0),'BTLF',1)
call DestroyEffect(AddSpecialEffect("war3mapImported\\DarkNova.mdx",x1,y1))
call UnitApplyTimedLife(CreateUnit(p,'e04E',x1,y1,0),'BTLF',2)
call DestroyEffect(AddSpecialEffect("war3mapImported\\DarkNova.mdx",x1,y1))
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.2,1.2,1.2)
call SetUnitTimeScale(n,0.6)
call SetUnitVertexColor(n,255,230,100,50)
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitTimeScale(n,0.6)
call SetUnitVertexColor(n,255,230,100,50)
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.7,1.7,1.7)
call SetUnitTimeScale(n,0.6)
call SetUnitVertexColor(n,255,230,100,50)
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.9,1.9,1.9)
call SetUnitTimeScale(n,0.6)
call SetUnitVertexColor(n,255,230,100,50)
call UnitApplyTimedLife(CreateUnit(p,'e0C7',x1,y1,(a*bj_RADTODEG)),'BTLF',6)
call DestroyEffect(AddSpecialEffect("war3mapImported\\SuperBigExplosion.mdx",x1,y1))
call UnitRemoveAbility(LoadUnitHandle(h,GetHandleId(u),SusanoCnst),'S009')
call UnitAddAbility(LoadUnitHandle(h,GetHandleId(u),SusanoCnst),'S00A')
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
endif
endif
set u=null
set p=null
set t=null
set l__d=null
endfunction
function CastKagutsuchi takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
call SaveUnitHandle(h,id,0,u)
if GetUnitAbilityLevel(GetTriggerUnit(),'A12O')==1 then
    call SaveReal(h,id,3,x1)
    call SaveReal(h,id,4,y1)
    call SaveReal(h,id,8,a)
    call SaveReal(h,id,11,SR(x,y,x1,y1)/30)
    call SaveReal(h,id,15,500/30)
    call UnitAddAbility(LoadUnitHandle(h,GetHandleId(u),SusanoCnst),'S009')
    set soundplay=SndN(2297) // Sound\Music\mp3Music\Enton Susanoo Kagatsuchi.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call PauseUnit(u,true)
    call TimerStart(t,0.02,true,function KagutsuchiCast2)
elseif GetUnitAbilityLevel(GetTriggerUnit(),'A12P')==1 then
    call SaveReal(h,id,3,x1)
    call SaveReal(h,id,4,y1)
    call SaveReal(h,id,8,a)
    call SaveReal(h,id,11,SR(x,y,x1,y1)/30)
    call SaveReal(h,id,15,600/30)
    call UnitAddAbility(LoadUnitHandle(h,GetHandleId(u),SusanoCnst),'S00B')
    set soundplay=SndN(2299) // war3mapImported\SasukeT2.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call PauseUnit(u,true)
    call TimerStart(t,0.02,true,function KagutsuchiCast3)
endif
set u=null
set p=null
set t=null
endfunction
function KatonGoruukaFly2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
local real dist=LoadReal(h,id,6)
local real mh=LoadReal(h,id,5)
local real rad=LoadReal(h,id,7)
local real rd=SR(x,y,x1,y1)
local real dmg=LoadReal(h,id,8)
local real dmg2=LoadReal(h,id,9)
local integer m=LoadInteger(h,id,13)
local player p=GetOwningPlayer(l__d)
local integer idu=GetPlayerId(p)
local real to=GetUnitFlyHeight(l__d)*0.01
if to*2<speed then
set speed=speed-to/2
else
set speed=speed-to/8
endif
if rd>30+speed and IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,ParabolaZ(mh,dist,rd),0)
if m!=1 and dist/2>rd then
call SaveInteger(h,id,13,1)
call SetUnitAnimationByIndex(l__d,1)
endif
else
call GroupEnumUnitsInRange(G,x1,y1,rad,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
call GroupRemoveUnit(G,E)
if Condition_Base(p,E)then
call myCustomDamage(Hero[idu],E,dmg,false,false,null,null,null)
call PoisonDamage3(Hero[idu],E,dmg2,14,"war3mapImported\\amaterasu2.mdx","origin")
endif
endloop
call UnitApplyTimedLife(CreateUnit(p,'e048',x1,y1,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e03W',x1,y1,0),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e06O',x1,y1,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e06N',x1,y1,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0RH',x1,y1,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0RK',x1,y1,(a*bj_RADTODEG)),'BTLF',3)
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.2,1.2,1.2)
call SetUnitTimeScale(n,0.6)
call SetUnitVertexColor(n,255,230,100,50)
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitTimeScale(n,0.6)
call SetUnitVertexColor(n,255,230,100,50)
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.7,1.7,1.7)
call SetUnitTimeScale(n,0.6)
call SetUnitVertexColor(n,255,230,100,50)
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.9,1.9,1.9)
call SetUnitTimeScale(n,0.6)
call SetUnitVertexColor(n,255,230,100,50)
call UnitApplyTimedLife(CreateUnit(p,'e0C7',x1,y1,(a*bj_RADTODEG)),'BTLF',6)
call DestroyEffect(AddSpecialEffect("war3mapImported\\SuperBigExplosion.mdx",x1,y1))
call KillUnit(l__d)
call AddUnitAnimationProperties(l__d,"dragon",false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set l__d=null
set t=null
endfunction
function KatonGoruukaFly takes unit l__d,real speed,real angle,real x,real y,real mh,real r,real dmg,real dmg2 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,mh)
call SaveReal(h,id,6,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,7,r)
call SaveReal(h,id,8,dmg)
call SaveReal(h,id,9,dmg2)
call SaveInteger(h,id,13,0)
call AddUnitAnimationProperties(l__d,"dragon",true)
call TimerStart(t,0.02,true,function KatonGoruukaFly2)
set t=null
endfunction
function KatonGoruukaCond takes nothing returns boolean
return GetSpellAbilityId()=='A006' and GetUnitAbilityLevel(GetTriggerUnit(),'A40X')>0
endfunction
function KatonGoruukaCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x1=GetSpellTargetX()+1.0
local real y1=GetSpellTargetY()+1.0
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x2=0
local real y2=0
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroAgi(u,true)*(1+GetUnitAbilityLevel(u,'A006'))+75*GetUnitAbilityLevel(u,'A006')
local real dmg2=GetHeroAgi(u,true)*(1+GetUnitAbilityLevel(u,'A006')*0.5)
local integer i=0
if SR(x,y,x1,y1)<800 then
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
set x=x-800*Cos(a)
set y=y-800*Sin(a)
call SetUnitXY_1(u,x,y, false)
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
endif
if SR(x,y,x1,y1)>1500 then
set x1=x+1500*Cos(a)
set y1=y+1500*Sin(a)
endif
set n=CreateUnit(p,'e0WG',x,y,a*bj_RADTODEG)
call SetUnitScale(n,1.5,1.5,1.5)
set x2=x1-500*Cos(a)
set y2=y1-500*Sin(a)
call KatonGoruukaFly(n,SR(x,y,x2,y2)/60,0,x2,y2,1250,300,dmg,dmg2)
set n=CreateUnit(p,'e0WG',x,y,a*bj_RADTODEG)
call SetUnitScale(n,1.5,1.5,1.5)
set x2=x1+500*Cos(a)
set y2=y1+500*Sin(a)
call KatonGoruukaFly(n,SR(x,y,x2,y2)/60,0,x2,y2,1250,300,dmg,dmg2)
set n=CreateUnit(p,'e0WG',x,y,a*bj_RADTODEG)
call SetUnitScale(n,1.5,1.5,1.5)
call KatonGoruukaFly(n,SR(x,y,x1,y1)/60,0,x1,y1,1250,300,dmg,dmg2)
set soundplay=SndN(2301) // Sound\Music\mp3Music\Sasuke Katon Gouryuuka no Jutsu.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set u=null
set p=null
endfunction
function Trig_Katon_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A006' and GetUnitAbilityLevel(GetTriggerUnit(),'A40X')==0
endfunction
function Trig_Katon_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local unit d1=LoadUnitHandle(h,id,6)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local group g=LoadGroupHandle(h,id,4)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,5)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroAgi(u,true)*GetUnitAbilityLevel(u,'A006')+75*GetUnitAbilityLevel(u,'A006')
local real dmg2=(0.75+0.25*GetUnitAbilityLevel(u,'A006'))*GetHeroAgi(u,true)
if SR(x,y,x1,y1)<=2250 then
set x1=x1+52*Cos(a)
set y1=y1+52*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
call SetUnitX(d1,x1)
call SetUnitY(d1,y1)
call GroupEnumUnitsInRange(g,x1,y1,250,Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
call PoisonDamage3(u,E,dmg2,7,"Environment\\LargeBuildingFire\\LargeBuildingFire1.mdl","origin")
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
call UnitApplyTimedLife(CreateUnit(p,0x65304657,x1,y1,a*bj_RADTODEG),'BTLF',1)
else
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,GetHandleId(g))
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
call RemoveUnit(l__d)
call RemoveUnit(d1)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
set d1=null
endfunction
function Trig_Katon_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,CreateUnit(GetOwningPlayer(u),'e0FV',x+120*Cos(a),y+120*Sin(a),a*bj_RADTODEG))
call SaveGroupHandle(h,id,4,CreateGroup())
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveReal(h,id,5,a)
set soundplay=SndN(2303) // Sound\Music\mp3Music\Sasuke Katon Goukakyuu no Jutsu.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SaveUnitHandle(h,id,6,CreateUnit(GetOwningPlayer(u),0x65303052,x+120*Cos(a),y+120*Sin(a),a*bj_RADTODEG))
call TimerStart(t,0.04,true,function Trig_Katon_Actions2)
set u=null
set t=null
endfunction
function InitTrig_Katon takes nothing returns nothing
set gg_trg_Katon=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Katon,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_Katon,Condition(function Trig_Katon_Conditions))
call TriggerAddAction(gg_trg_Katon,function Trig_Katon_Actions)
endfunction
function AmaterasuSasuke2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit c=LoadUnitHandle(h,id,1)
local unit u=LoadUnitHandle(h,id,4)
local integer idc=GetHandleId(c)
local real per=LoadReal(h,idc,2)
local real dmg=LoadReal(h,idc,1)/LoadReal(h,idc,3)
if per>0 then
call myCustomDamage(u,c,dmg,false,false,null,null,null)
call SaveReal(h,idc,2,per-0.5)
else
call UnitRemoveAbility(c,'A12N')
call PauseTimer(t)
call DestroyTimer(t)
call DestroyEffect(LoadEffectHandle(h,id,0))
call FlushChildHashtable(h,id)
endif
set c=null
set u=null
set t=null
endfunction
function AmaterasuSasuke takes unit u,unit c,real dmg,real per,string l__s,string s2 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local integer idc=GetHandleId(c)
call SaveUnitHandle(h,id,1,c)
call SaveUnitHandle(h,id,4,u)
call SaveEffectHandle(h,id,0,AddSpecialEffectTarget(l__s,c,s2))
call SaveReal(h,idc,1,dmg)
call SaveReal(h,idc,2,per)
call SaveReal(h,idc,3,per)
call TimerStart(t,0.5,true,function AmaterasuSasuke2)
set t=null
endfunction
function SusanoSasukeCond takes nothing returns boolean
return GetSpellAbilityId()=='A12Q'
endfunction
function SusanoSasukeCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real time=LoadReal(h,id,5)
local real dmg=GetHeroAgi(u,true)*2
local real dmg2=GetHeroAgi(u,true)*0.4*0.03
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
if time>0 and UnitIsAlive(u)then
call SetUnitXY_1(l__d,x,y, false)
if CheckUnitInvisible(u) then
    call UnitAddAbility(l__d,'Ao7S')
else
    call UnitRemoveAbility(l__d,'Ao7S')
endif
call SetUnitFacing(l__d,GetUnitFacing(u))
call SetUnitFlyHeight(l__d,GetUnitFlyHeight(u),0)
if IsUnitPaused(u)==false and IsUnitHidden(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
call SaveReal(h,id,5,time-0.03)
endif
if GetUnitAbilityLevel(u,'A12O')>0 then
call GroupEnumUnitsInRange(G,x,y,150,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
set ide=GetHandleId(E)
if Condition_Base(p,E)then
if GetUnitAbilityLevel(E,'A12N')>0 then
call SaveReal(h,ide,1,LoadReal(h,ide,1)+dmg2)
call SaveReal(h,ide,2,10)
else
call UnitAddAbility(E,'A12N')
call AmaterasuSasuke(u,E,dmg,10,"null","origin")
endif
endif
call GroupRemoveUnit(G,E)
endloop
elseif GetUnitAbilityLevel(u,'A12P')>0 then
call GroupEnumUnitsInRange(G,x,y,220,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
set ide=GetHandleId(E)
if Condition_Base(p,E)then
if GetUnitAbilityLevel(E,'A12N')>0 then
call SaveReal(h,ide,1,LoadReal(h,ide,1)+dmg2)
call SaveReal(h,ide,2,10)
else
call UnitAddAbility(E,'A12N')
call AmaterasuSasuke(u,E,dmg,10,"null","origin")
endif
endif
call GroupRemoveUnit(G,E)
endloop
endif
else
set soundplay=SndN(1611) // Sound\Music\mp3Music\SharinganEnd.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call UnitRemoveAbility(u,'A12O')
