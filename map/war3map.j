call SetUnitTimeScale(n,0.8)
call UnitApplyTimedLife(l__d,1,0.2)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
call DestroyTimer(t)
call DestroyGroup(g)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
