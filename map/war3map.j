function SaphireCond takes nothing returns boolean
return GetSpellAbilityId()=='A1GK' and GetUnitTypeId(GetTriggerUnit())!='H007'  and GetUnitAbilityLevel(GetTriggerUnit(),'GIE1')==0 and GetUnitTypeId(GetTriggerUnit())!='H04U'
endfunction
function NewSaphireCast4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,1)
local integer idu=GetHandleId(u)
local boolean bPaused=false
set bPaused=false
if IsUnitPaused(u) then
    set bPaused=true
    call PauseUnit(u, false)
endif
call IssueImmediateOrder(u,"manashieldoff")
call IssueImmediateOrder(u,"unimmolation")
call UnitRemoveAbility(u,'A1GL')
call UnitRemoveAbility(u,'WAE1')
call UnitRemoveAbility(u,'A1WT')
call UnitRemoveBuffs(u,true,false)
if UnitHasItemOfTypeBJ(u, 'I03A') and GetWidgetLife(u)>0 and IsUnitIllusion(u)==false then
    set AlastorPos=0
    loop
    exitwhen AlastorPos==6 or GetItemTypeId(UnitItemInSlot(u,AlastorPos)) == 'I03A'
    set AlastorPos=AlastorPos+1
    endloop
    if IsAbilityEnabled(GetUnitAbility(u,'AInv'))==true then
        set Alastor=GetItemOfTypeFromUnitBJ(u,'I03A')
        call UnitRemoveItem(u,Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(u, 'I03A',AlastorPos)
    else
        call EnableUnitAbility2(u,'AInv',false,true)
        set Alastor=GetItemOfTypeFromUnitBJ(u,'I03A')
        call UnitRemoveItem(u,Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(u, 'I03A',AlastorPos)    
        call DisableUnitAbility2(u,'AInv',false,true)
    endif
endif
call UnitAddItemById(u,'I06B')
if LoadReal(h, idu, StringHash("ShieldBelfF"))>0 then   // Щит Бельфегора
    call SaveReal(h, idu, StringHash("ShieldBelfF"), 0)
else
    call SaveReal(h, idu, StringHash("ShieldBelfF"), 0)
    call RemoveSavedReal(h, idu, StringHash("ShieldBelfF"))
endif
if LoadReal(h, idu, StringHash("YujiE_Shield"))>0 then  // Щит Юджи
    call SaveReal(h, idu, StringHash("YujiE_Shield"), 0)
else
    call RemoveSavedReal(h, idu, StringHash("YujiE_Shield"))
endif
if GetUnitAbilityLevel(u,'A1DF')>=1 then                  // Щит Шилдер Q
    call UnitRemoveAbility(u,'A1DF')
    call SaveReal(h,idu, StringHash("shi1"), 0)
    call SaveReal(h,idu, StringHash("shi2"), 0)
endif
if GetUnitAbilityLevel(u,'A1DG')>=1 then                  // Щит Шилдер E
    call UnitRemoveAbility(u, 'A1DG')
endif
if GetUnitAbilityLevel(u,'A10G')>=1 then                  // Щит Луизы
    call UnitRemoveAbility(u, 'A10G')
endif
if GetUnitAbilityLevel(u, 'A2DF')>0 then                      // Щит Броли
    call SaveReal(h,idu,StringHash("BroEtime"),9)
endif
if GetUnitAbilityLevel(u, 'A0VJ')>0 then                  // Гроза Вонголы
    call UnitRemoveAbility(u, 'A0VJ')
endif
if GetUnitAbilityLevel(u, 'A1HG')>0 then                  // Щит Орехи
    call UnitRemoveAbility(u, 'A1HG')
endif
if GetUnitAbilityLevel(u, 'A3DF')>0 then                  // Щит Waver
    call UnitRemoveAbility(u, 'A3DF')
endif
if GetUnitAbilityLevel(u, 'A1H1')>=1 then                 // Щит от Ульты Жанны Рулер
    call UnitRemoveAbility(u, 'A1H1')
endif
if GetUnitAbilityLevel(u, 'A0VV')>=1 then                 // Броня бороса
    call UnitRemoveAbility(u, 'A0VV')
endif
if GetUnitAbilityLevel(u, 'A28W')>=1 then                 // Броня бороса
    call UnitRemoveAbility(u, 'A28W')
endif
if GetUnitAbilityLevel(u, 'AcF1')>=1 then                 // F Эйса
    call SaveBoolean(HH,idu,SST,false)
    call ShowAbility2('A315',false)
    call ShowAbility2('A015',true)
    call UnitRemoveAbility(u,'AcF1')
endif
if GetUnitAbilityLevel(u, 'ItV1')>=1 then                 // G itachi
    call SaveBoolean(HH,idu,SST,false)
    call ShowAbility2('A30C',false)
    call ShowAbility2('A00C',true)
    call UnitRemoveAbility(u,'ItV1')
endif
if GetUnitAbilityLevel(u, 'GaT1')>=1 then                 // T Gamma
    call SaveBoolean(HH,idu,SST,false)
    call ShowAbility2('A41C',false)
    call ShowAbility2('A0GV',true)
    call UnitRemoveAbility(u,'GaT1')
endif
if GetUnitAbilityLevel(u, 'MgT1')>=1 then                 // T Magnus
    call SaveBoolean(HH,idu,SST,false)
    call ShowAbility2('A42C',false)
    call ShowAbility2('A15C',true)
    call UnitRemoveAbility(u,'MgT1')
endif
if bPaused then
    call PauseUnit(u, true)
endif
call UnitRemoveAbility(u, 'YatB')
call UnitRemoveAbility(u, 'OniC')
call DestroyEffect(AddSpecialEffect("war3mapImported\\Blue Lightning.mdx", GetUnitX(u),GetUnitY(u)))
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
set u=null
set t=null
endfunction
function NewSaphireCast3 takes unit u returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(HH,id,1,u)
call TimerStart(t,2,false,function NewSaphireCast4)
set t=null
endfunction
function NewSaphireCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit l__d=LoadUnitHandle(HH,id,1)
local real x=LoadReal(HH,id,2)
local real y=LoadReal(HH,id,3)
local group g=LoadGroupHandle(HH,id,11)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(HH,id,5)
local integer idg2=GetHandleId(g)
local player p=GetOwningPlayer(u)
local real dmg=(GetHeroAgi(u,true)+GetHeroStr(u,true)+GetHeroInt(u,true))*2
local real dist = LoadReal(HH,id,7)
if dist<=2000 then
call SaveReal(HH,id,7,dist+65)
set x1=x1+65*Cos(a)
set y1=y1+65*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
call GroupEnumUnitsInRange(g,x1,y1,225,Base)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set ide=GetHandleId(E)
        if Condition_Base(p,E) and E!=LoadUnitHandle(HH,idg2,ide) and GetUnitAbilityLevel(E,'B05G') != 1 then
                call SaveUnitHandle(HH,idg2,ide,E)
        call NewSaphireCast3(E)
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\BlackKeeperMissile\\BlackKeeperMissile.mdl",E,"head"))
        elseif IsUnitAlly(E,p) and E!=LoadUnitHandle(HH,idg2,ide) and E!=u then
                call UnitRemoveAbility(E, 'IHYs')
                call UnitRemoveAbility(E, 'IHYb')
                call UnitRemoveAbility(E, 'IOb3')
                call UnitRemoveAbility(E, 'IO3b')
        call SetUnitState(E,UNIT_STATE_LIFE,GetWidgetLife(E)+0.05*GetUnitState(E,UNIT_STATE_MAX_LIFE))
        call SaveUnitHandle(HH,idg2,ide,E)
                call DestroyEffect(AddSpecialEffect("war3mapImported\\Blue Lightning.mdx", GetUnitX(E),GetUnitY(E)))
        endif
call GroupRemoveUnit(g,E)
endloop
else
call RemoveUnit(l__d)
call FlushChildHashtable(HH,idg2)
call FlushChildHashtable(HH,id)
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function NewSaphireCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
call SaveUnitHandle(HH,id,0,u)
set n=CreateUnit(GetOwningPlayer(u),0x65303449,x+60*Cos(a),y+60*Sin(a),a*bj_RADTODEG)
call SetUnitVertexColor(n,155,75,255,255)
call SetUnitAnimation(n,"spell two")
call SetUnitScale(n,1.2,1.2,1.2)
call SetUnitTimeScale(n,3)
call SaveUnitHandle(HH,id,1,n)
call SaveGroupHandle(HH,id,11,CreateGroup())
call SaveReal(HH,id,2,x)
call SaveReal(HH,id,3,y)
call SaveReal(HH,id,5,a)
call SaveReal(HH,id,7,0)
call TimerStart(t,0.02,true,function NewSaphireCast2)
set u=null
set t=null
endfunction
