function DanzaiMissleFly2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
local real dist=LoadReal(h,id,6)
local real mh=LoadReal(h,id,5)
local real rad=LoadReal(h,id,7)
local real rd=SR(x,y,x1,y1)
local real dmg=LoadReal(h,id,8)
local real he=0
local player p=GetOwningPlayer(l__d)
local integer idu=GetPlayerId(p)
if rd>speed+30 then
call SetUnitFacing(l__d,a*bj_RADTODEG)
set he=ParabolaZ(mh,dist,rd)
call SetUnitFlyHeight(l__d,he,0)
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
else
call GroupEnumUnitsInRange(DG,x1,y1,rad,Base)
loop
set E=FirstOfGroup(DG)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(Hero[idu],E,dmg,false,false,null,null,null)
call SetControlToUnit(Hero[idu],E, 1, "stun")
endif
call GroupRemoveUnit(DG,E)
endloop
call UnitApplyTimedLife(CreateUnit(p,'e0LG',x1,y1,GetRandomReal(0,359)),'BHwe',1)
call UnitApplyTimedLife(CreateUnit(p,'e0G3',x1,y1,GetRandomReal(0,359)),'BHwe',1)
call UnitApplyTimedLife(CreateUnit(p,'e0LF',x1,y1,GetRandomReal(0,359)),'BHwe',1)
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set l__d=null
set t=null
endfunction
function DanzaiMissleFly takes unit l__d,real speed,real angle,real x,real y,real mh,real r,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,mh)
call SaveReal(h,id,6,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,7,r)
call SaveReal(h,id,8,dmg)
call TimerStart(t,0.03,true,function DanzaiMissleFly2)
set t=null
endfunction
function DanzaiCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local real x=LoadReal(HH,id,1)
local real y=LoadReal(HH,id,2)
local group g=LoadGroupHandle(HH,id,3)
local real x2=0
local real y2=0
local integer i=0
local real r=0
local real l__d
local real dmg=(0.15+0.05*GetUnitAbilityLevel(u,'A08S'))*GetHeroAgi(u,true)+10
call SetUnitAnimation(u,"spell five")
call PauseUnit(u,false)
set i=0
loop
set E=FirstOfGroup(g)
set l__d=11*i
set r=r+20*bj_DEGTORAD
set x2=x+l__d*Cos(r)
set y2=y+l__d*Sin(r)
set i=i+1
exitwhen E==null
call DanzaiMissleFly(E,SquareRoot((SR(GetUnitX(E),GetUnitY(E),x2,y2)/30-i/2)*(SR(GetUnitX(E),GetUnitY(E),x2,y2)/30-i/2))+10,GetRandomReal(-1,1),x2,y2,4000,200,dmg)
call GroupRemoveUnit(g,E)
endloop
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
set g=null
set u=null
set t=null
endfunction
function DanzaiCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real x2=0
local real y2=0
local integer i=0
local real r=0
local real l__d
local real a=Atan2(y-y1,x-x1)*bj_DEGTORAD
local group g=CreateGroup()
loop
exitwhen i>=37
set n=CreateUnit(p,'e0M1',x1+GetRandomReal(-150,150),y1+GetRandomReal(-150,150),a+GetRandomReal(-1,1))
call SetUnitScale(n,0.3,0.3,0.3)
call SetUnitFlyHeight(n,GetRandomReal(90,200),0)
call GroupAddUnit(g,n)
set i=i+1
endloop
call PauseUnit(u,true)
set soundplay=SndN(960) // Sound\Music\mp3Music\Shana2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SaveUnitHandle(HH,id,0,u)
call SaveReal(HH,id,1,x)
call SaveReal(HH,id,2,y)
call SaveGroupHandle(HH,id,3,g)
call TimerStart(t,0.4,false,function DanzaiCast2)
set t=null
set p=null
set u=null
endfunction
