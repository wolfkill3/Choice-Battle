function ImmitadeBodyCond takes nothing returns boolean
return GetIssuedOrderId()==OrderId("manashieldon")and GetUnitTypeId(GetTriggerUnit())=='H03N'
endfunction
function ImmitadeBodyCast2 takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(h,id,0)
        local unit l__d=LoadUnitHandle(h,id,1)
        local real m=GetWidgetMana(u)
        local real mm=GetUnitState(u,UNIT_STATE_MAX_MANA)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        local real r
        local real f=GetUnitFacing(u)*bj_DEGTORAD
        local real x1
        local real X1=GetUnitX(l__d)
        local real Y1=GetUnitY(l__d)
        local real y1
        local real x2=0
        local real y2=0
        local player p=GetOwningPlayer(u)
        if GetUnitAbilityLevel(u,'B047')>0 and m>mm*0.05 and GetUnitAbilityLevel(u,'cbc9')==0 then
                set x1=X1
                set y1=Y1
                set x2=x+250*Cos(f+deg90)
                set y2=y+250*Sin(f+deg90)
        if RectContainsUnit(gg_rct_UBW2,u)==true then
            call UnitAddAbility(l__d,'A0IH')
        else
            call UnitRemoveAbility(l__d,'A0IH')
        endif
		if GetUnitCurrentOrder(l__d)==OrderId("stop") then
			call SetUnitFacingInstant(l__d,GetUnitFacing(u)*bj_DEGTORAD)
		endif
		if SR1(x,y,x1,y1)<800 and GetUnitCurrentOrder(u)!=OrderId("channel") and GetUnitCurrentOrder(u)!=OrderId("avatar")and GetUnitCurrentOrder(u)!=OrderId("absorb") and GetUnitCurrentOrder(u)!=OrderId("berserk") and IsUnitPaused(u)==false then
			if SR1(x2,y2,x1,y1)>250 and GetUnitCurrentOrder(l__d)!=OrderId("move") and GetUnitCurrentOrder(u)!=OrderId("attack")and not(x2-30<X1 and X1<x2+30)and not(y2-30<Y1 and Y1<y2+30)then
				call IssuePointOrder(l__d,"move",x2,y2)
			elseif GetUnitCurrentOrder(l__d)==OrderId("stop") and GetUnitCurrentOrder(u)!=OrderId("attack") then
				call IssuePointOrder(l__d,"attack",x2,y2)
			endif
		elseif GetUnitCurrentOrder(l__d)!=OrderId("move")and SR1(x,y,x1,y1)>800 then
			call SetUnitX(l__d,x2)
			call SetUnitY(l__d,y2)
			call IssueImmediateOrder(l__d,"stop")
		endif
		call SetUnitState(u,UNIT_STATE_MANA,m-mm*0.005*0.06)
	else
		set n=CreateUnit(p, 'dR54', X1, Y1, GetRandomInt(0, 360))
		call SetUnitScale(n, 1.55, 1.55, 1.55)
		call MyRemoveUnit(n, 2.0)
		set n=CreateUnit(p, 'dR54', X1, Y1, GetRandomInt(0, 360))
		call SetUnitScale(n, 2, 2, 2)
		call MyRemoveUnit(n, 2.0)
		set n=CreateUnit(p, 'dH05', X1, Y1, GetRandomInt(0, 360))
		call SetUnitScale(n, 2.35, 2.35, 2.35)
		call MyRemoveUnit(n, 2.0)
		call PauseTimer(t)
		call DestroyTimer(t)
		call RemoveSavedHandle(h,GetHandleId(u),SH_clone)
		call FlushChildHashtable(h,id)
        call RemoveUnit(l__d)
        // call ShowUnit(l__d, false)
		// call MyRemoveUnit(l__d, 2.0)
		if GetUnitAbilityLevel(u,'cbc9')==0 then
			call IssueImmediateOrder(u,"manashieldoff")
		endif
		call UnitRemoveAbility(u,'B047')
		set soundplay=SndN(1732) // Sound\Music\mp3Music\VergilT2.mp3
		call StartSound(soundplay)
		//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        call SetAbilityIntegerLevelField(GetUnitAbility(u,'A0PI'), ABILITY_ILF_MANA_COST,GetUnitAbilityLevel(u,'A0PI')-1,GetAbilityBaseIntegerLevelFieldById(String2Id( "A0PI" ),ABILITY_ILF_MANA_COST,GetUnitAbilityLevel(u,'A0PI')-1))
        call SetAbilityIntegerLevelField(GetUnitAbility(u,'VerW'), ABILITY_ILF_MANA_COST,GetUnitAbilityLevel(u,'VerW')-1,GetAbilityBaseIntegerLevelFieldById(String2Id( "VerW" ),ABILITY_ILF_MANA_COST,GetUnitAbilityLevel(u,'VerW')-1))
        call SetAbilityIntegerLevelField(GetUnitAbility(u,'A0PM'), ABILITY_ILF_MANA_COST,GetUnitAbilityLevel(u,'A0PI')-1,GetAbilityBaseIntegerLevelFieldById(String2Id( "A0PM" ),ABILITY_ILF_MANA_COST,GetUnitAbilityLevel(u,'A0PM')-1))
        call SetAbilityIntegerLevelField(GetUnitAbility(u,'A0PN'), ABILITY_ILF_MANA_COST,GetUnitAbilityLevel(u,'A0PN')-1,GetAbilityBaseIntegerLevelFieldById(String2Id( "A0PN" ),ABILITY_ILF_MANA_COST,GetUnitAbilityLevel(u,'A0PN')-1))
	endif
	set u=null
	set l__d=null
	set t=null
endfunction
function ImmitadeBodyCast takes nothing returns nothing
	local timer t=CreateTimer()
	local integer id=GetHandleId(t)
	local unit u=GetTriggerUnit()
	local real point_x = GetUnitX(u)+200*Cos(GetUnitFacing(u)*bj_DEGTORAD)
	local real point_y = GetUnitY(u)
		set n=CreateUnit(GetOwningPlayer(u), 'dH63', point_x, point_y, GetRandomInt(0, 360))
		call SetUnitScale(n, 0.5, 0.5, 0.5)
		call MyRemoveUnit(n, 2.0)
		set n=CreateUnit(GetOwningPlayer(u), 'dR67', point_x, point_y, GetRandomInt(0, 360))
		call SetUnitScale(n, 0.4, 0.4, 0.4)
		call MyRemoveUnit(n, 2.0)
		set n=CreateUnit(GetOwningPlayer(u), 'dH05', point_x, point_y, GetRandomInt(0, 360))
		call SetUnitScale(n, 1.65, 1.65, 1.65)
		call MyRemoveUnit(n, 2.0)
	call SaveUnitHandle(h,id,0,u)
	set n=CreateUnit(GetOwningPlayer(u),'H03O',point_x,point_y,GetUnitFacing(u))
    call SaveUnitHandle(HH, GetHandleId(u), SH_Vergil,u)
	call SetUnitVertexColor(n, 255, 255, 255, 160)
	call SaveUnitHandle(h,id,1,n)
	call SaveUnitHandle(h,GetHandleId(u),SH_clone,n)
	call SetHeroLevel(n,GetHeroLevel(u),false)
    // Q Vergil
	call UnitAddAbility(n, 'A0PI')
	call SetUnitAbilityLevel(n,'A0PI',GetUnitAbilityLevel(u,'A0PI'))
    call SetAbilityIntegerLevelField(GetUnitAbility(u,'A0PI'), ABILITY_ILF_MANA_COST,GetUnitAbilityLevel(u,'A0PI')-1,R2I(GetAbilityIntegerLevelField(GetUnitAbility(u,'A0PI'),ABILITY_ILF_MANA_COST,GetUnitAbilityLevel(u,'A0PI')-1)*2))
    // W Vergil
	call UnitAddAbility(n, 'VerW')
	call SetUnitAbilityLevel(n, 'VerW', GetUnitAbilityLevel(u, 'VerW'))
    call SetAbilityIntegerLevelField(GetUnitAbility(u,'VerW'), ABILITY_ILF_MANA_COST,GetUnitAbilityLevel(u,'VerW')-1,R2I(GetAbilityIntegerLevelField(GetUnitAbility(u,'VerW'),ABILITY_ILF_MANA_COST,GetUnitAbilityLevel(u,'VerW')-1)*2))
    // E Vergil
	call UnitAddAbility(n, 'A0PM')
	call SetUnitAbilityLevel(n,'A0PM',GetUnitAbilityLevel(u,'A0PM'))
    call SetAbilityIntegerLevelField(GetUnitAbility(u,'A0PM'), ABILITY_ILF_MANA_COST,GetUnitAbilityLevel(u,'A0PM')-1,R2I(GetAbilityIntegerLevelField(GetUnitAbility(u,'A0PM'),ABILITY_ILF_MANA_COST,GetUnitAbilityLevel(u,'A0PM')-1)*2))
    // R Vergil
	call UnitAddAbility(n, 'A0PN')
	call SetUnitAbilityLevel(n, 'A0PN', GetUnitAbilityLevel(u, 'A0PN'))
    call SetAbilityIntegerLevelField(GetUnitAbility(u,'A0PN'), ABILITY_ILF_MANA_COST,GetUnitAbilityLevel(u,'A0PN')-1,R2I(GetAbilityIntegerLevelField(GetUnitAbility(u,'A0PN'),ABILITY_ILF_MANA_COST,GetUnitAbilityLevel(u,'A0PN')-1)*2))
    // T Vergil
	call UnitAddAbility(n, 'A0PJ')

	call SetHeroAgi(n,R2I(GetHeroAgi(u,true)*1),true)
	call SetHeroInt(n,R2I(GetHeroInt(u,true)*1),true)
	call SetHeroStr(n,R2I(GetHeroStr(u,true)*1),true)
	call SetUnitMoveSpeed(n,550)
	call SetUnitTurnSpeed(n,9999)
	call SetUnitPathing(n,false)
	set soundplay=SndByPath("Sound\\Music\\mp3Music\\VergilT_Voice"+I2S(GetRandomInt(1, 2))+".mp3")
	call StartSound(soundplay)
	//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
	set soundplay=SndN(1739) // Sound\Music\mp3Music\VergilT1.mp3
	call StartSound(soundplay)
	//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
	call TimerStart(t,0.06,true,function ImmitadeBodyCast2)

	set u=null
	set t=null
endfunction
function ImmitadeBodyInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_ISSUED_ORDER,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function ImmitadeBodyCast)
call TriggerAddCondition(t,Condition(function ImmitadeBodyCond))
set t=null
endfunction
function CuttingSawSlash2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local player p=GetOwningPlayer(l__d)
local unit u=Hero[GetPlayerId(p)]
local real speed=LoadReal(h,id,1)
local real x=LoadReal(h,id,3)
local real y=LoadReal(h,id,4)
local group g=LoadGroupHandle(h,id,5)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,2)
local real dmg=LoadReal(h,id,6)
local real Range=LoadReal(h,id,9)
local real time2=LoadReal(h,id,12)
if SR(x,y,x1,y1)<=Range and time2<1.5 then
call SaveReal(h,id,12,time2+0.01)
call SetUnitXY_1(l__d,x1+speed*Cos(a),y1+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call GroupEnumUnitsInRange(g,x1,y1,LoadReal(h,id,10),Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E, E, 0.2, "stun")
call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",GetUnitX(E),GetUnitY(E)))
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
else
if LoadReal(h,id,11)==0.2 then
// call PauseUnit(u,false)
// call SetUnitInvulnerable(u,false)
set n=LoadUnitHandle(h,GetHandleId(u),SH_clone)
if n!=null then
call PauseUnit(n,false)
call SetUnitInvulnerable(n,false)
call IssueImmediateOrder(n,"stop")
endif
endif
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,idg)
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function CuttingSawSlash takes unit l__d,real speed,real dmg,real angle,real range,real mas,real x,real y,real x1,real y1, real time returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle)
call SaveGroupHandle(h,id,5,CreateGroup())
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,6,dmg)
call SaveReal(h,id,9,range)
call SaveReal(h,id,10,mas)
call SaveReal(h,id,11,time)
call SaveReal(h,id,12,0)
call TimerStart(t,0.01,true,function CuttingSawSlash2)
set t=null
endfunction
function CuttingSawCond takes nothing returns boolean
return GetSpellAbilityId()=='A0PN'
endfunction
function CuttingSawCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local real r=GetRandomReal(-0.15,0.15)
local real a=0
local player p=GetOwningPlayer(u)
local real time=LoadReal(h,id,4)
if time<0.3 then
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SaveReal(h,id,4,time+0.1)
set a=Atan2(y1-y,x1-x)+r
set n=CreateUnit(p,'e0O2',x,y,a*bj_RADTODEG)
call SetUnitAnimation(u,"Spell One")
call CuttingSawSlash(n,35,2*GetHeroAgi(u,true),a,1500,125,x,y,x1,y1,time)
        if GetUnitTypeId(u)=='H03N' then
                set n=LoadUnitHandle(h,GetHandleId(u),SH_clone)
                if n!=null then
                        call IssuePointOrder(n,"channel",x1,y1)
                endif
        endif
else
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call SetUnitTimeScale(u,1)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set t=null
endfunction
function CuttingSawCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SetUnitTimeScale(u,4)
call SaveReal(h,id,2,GetSpellTargetX())
call SaveReal(h,id,3,GetSpellTargetY())
call SaveReal(h,id,4,0)
set n=LoadUnitHandle(h,GetHandleId(u),SH_clone)
if n!=null then
call SetUnitX(n,GetUnitX(u)+85*Cos(Atan2(GetSpellTargetY()-GetUnitY(u),GetSpellTargetX()-GetUnitX(u))+deg90))
call SetUnitY(n,GetUnitY(u)+85*Sin(Atan2(GetSpellTargetY()-GetUnitY(u),GetSpellTargetX()-GetUnitX(u))+deg90))
call UnitResetCooldown(n)
call SetUnitState(n,UNIT_STATE_MANA,GetUnitState(n,UNIT_STATE_MAX_MANA))
call SetUnitFacingInstant(n,Atan2(GetSpellTargetY()-GetUnitY(n),GetSpellTargetX()-GetUnitX(n)))
call IssuePointOrder(n,"channel",GetSpellTargetX(),GetSpellTargetY())
endif
//set soundplay=CreateSound("Sound\\Music\\mp3Music\\VergilR.mp3",false,false,true,12700,12700,"")
set soundplay=SndN(1741) // Sound\war3mapImported\VergilRTrue.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
	if GetUnitTypeId(u)!='H03O' then
		set soundplay=SndByPath("Sound\\war3mapImported\\VergilR"+I2S(GetRandomInt(1,2))+".mp3")
		call StartSound(soundplay)
		//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
		call PauseUnit(u,true)
		call SetUnitInvulnerable(u,true)
		set n=LoadUnitHandle(HH, GetHandleId(u), SH_VergilD)
		call RemoveUnit(n)
		set n=CreateUnit(GetOwningPlayer(u), 'd081', 0.0, 0.0, 0.0)
		call SaveUnitHandle(HH, GetHandleId(u), SH_VergilD, n)
		call MyRemoveUnit(n, 3)
	endif
call TimerStart(t,0.1,true,function CuttingSawCast2)
set u=null
set t=null
endfunction
function InitCuttingSaw takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function CuttingSawCast)
call TriggerAddCondition(t,Condition(function CuttingSawCond))
set t=null
endfunction
function UpperSlashCond takes nothing returns boolean
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
return GetSpellAbilityId()=='A0PM' and udg_B==true
endfunction
function UpperSlashMissleFly2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
local real dist=LoadReal(h,id,6)
local real mh=LoadReal(h,id,5)
local real rad=LoadReal(h,id,7)
local real time=LoadReal(h,id,9)
local real rd=SR(x,y,x1,y1)
local player p=GetOwningPlayer(l__d)
local integer idu=GetPlayerId(p)
local real dmg=0.0
local real cof=rd/dist
if rd>speed+30 and time<2 then
call SaveReal(h,id,9,time+0.015)
set n=CreateUnit(p,'e0O1',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.20)
call SetUnitVertexColor(n,170,170,170,70)
call SetUnitTimeScale(n,2)
call SetUnitAnimation(n,"Spell Two")
call SetUnitAnimation(l__d,"Spell Two")
call SetUnitFlyHeight(n,mh*cof,0)
set x=x+speed*Cos(a)
set y=y+speed*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SaveReal(h,id,1,speed*1.02)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,mh*cof,0)
else
if GetUnitTypeId(l__d)=='H03N' then
        set dmg=(GetUnitAbilityLevel(l__d,'A0PM')+2)*GetHeroAgi(l__d,true)
        set n=LoadUnitHandle(h,GetHandleId(l__d),SH_clone)
        if n!=null then
                set dmg=dmg*1.6
        endif
endif
call GroupEnumUnitsInRange(DG,x,y,350,Base)
loop
set E=FirstOfGroup(DG)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(l__d,E,dmg,false,false,null,null,null)
call SetControlToUnit(l__d,E, 2, "stun")
endif
call GroupRemoveUnit(DG,E)
endloop
call UnitRemoveAbility(l__d,'A0GN')
call SetUnitInvulnerable(l__d,false)
call UnitApplyTimedLife(CreateUnit(p,'e03X',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03W',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e08R',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03Y',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e08N',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e09L',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e09M',x,y,GetRandomReal(0,359)),'BTLF',1)
        set n=CreateUnit(p, 'd001', x, y, GetRandomInt(0, 360))
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call SetUnitFlyHeight(n, 20, 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(p, 'd003', x, y, GetRandomInt(0, 360))
        call SetUnitScale(n, 2, 2, 2)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(p, 'd003', x, y, GetRandomInt(0, 360))
        call SetUnitScale(n, 2, 2, 2)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(p, 'd032', x, y, GetRandomInt(0, 360))
        call SetUnitScale(n, 2.5, 2.5, 2.5)
        call SetUnitFlyHeight(n, 200, 0)
        call MyRemoveUnit(n, 1.5)
call PauseUnit(l__d,false)
call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,false)
call UnitRemoveAbility(l__d,'A0IX')
call UnitRemoveAbility(l__d,'B03A')
call SetUnitFlyHeight(l__d,0,0)
call GroupClear(DG)
call GroupClear(G)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set l__d=null
set t=null
endfunction
function UpperSlashMissleFly takes unit l__d,real speed,real angle,real x,real y,real mh,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,mh)
call SaveReal(h,id,6,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,8,dmg)
call SaveReal(h,id,9,0)
call TimerStart(t,0.015,true,function UpperSlashMissleFly2)
set t=null
endfunction
function UpperSlashCast4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
