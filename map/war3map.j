function CondPSR takes nothing returns boolean
return GetSpellAbilityId()==0x41304341 and udg_B==true
endfunction
function CastPSR takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real x2=0
local real y2=0
local integer i=0
local real r
local real l__d
local real pd=-300
local real a=Atan2(y-y1,x-x1)
local real a2=0
local real dmg=(0.8+0.2*GetUnitAbilityLevel(u,0x41304341))*GetHeroAgi(u,true)
if GetUnitTypeId(u)!='H06N' and GetUnitTypeId(u)!='H06O' then
loop
exitwhen i>7
set l__d=GetRandomReal(-500,500)
set r=GetRandomReal(0,7)
set n=CreateUnit(p,'e0F0',x1,y1,0)
call SetUnitScale(n,4,4,4)
call KidMissleFly(n,50,GetRandomReal(-1,1),x+l__d*Cos(r),y+l__d*Sin(r),900,350,dmg)
set i=i+1
endloop
set soundplay=SndN(1089) // Sound\Music\mp3Music\KidFourSpell.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
elseif GetUnitTypeId(u)=='H06N' or GetUnitTypeId(u)=='H06O' then
loop
exitwhen i>7
set l__d=GetRandomReal(-500,500)
set r=GetRandomReal(0,7)
set x2=x1+(pd+100*i)*Cos(a+deg90)
set y2=y1+(pd+100*i)*Sin(a+deg90)
set n=CreateUnit(p,'e13U',x2,y2,0)
set a2=Atan2(y-y2,x-x2)
call SetUnitScale(n,2,2,2)
call DrakeMissleFly(n,50,0,x+l__d*Cos(r),y+l__d*Sin(r),200,350,dmg)
set n=CreateUnit(p,'e13R',x2,y2,(a2*bj_RADTODEG))
call SetUnitAnimation(n,"Attack")
call UnitApplyTimedLife(n,'BTLF',2)
set i=i+1
endloop
set soundplay=SndN(1091) // Sound\Music\mp3Music\DrakeR.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
set p=null
set u=null
endfunction
function PSRInit takes nothing returns nothing
set gg_trg_PSR=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_PSR,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddAction(gg_trg_PSR,function CastPSR)
call TriggerAddCondition(gg_trg_PSR,Condition(function CondPSR))
endfunction
function KASCond takes nothing returns boolean
return GetSpellAbilityId()=='A0CV' and udg_B==true
endfunction
function KASCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroInt(u,true)*0.5
if UnitIsAlive(l__d)then
call UnitApplyTimedLife(CreateUnit(p,'e07Q',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e07R',x+900*Cos(a),y+900*Sin(a),a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e07R',x+1100*Cos(a),y+1100*Sin(a),a*bj_RADTODEG),'BTLF',1)
call GroupEnumUnitsInRange(G,x1,y1,600,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SlowUnit(u,E,0.7,0.7,5,0,false)
endif
call GroupRemoveUnit(G,E)
endloop
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set l__d=null
set t=null
endfunction
function KASCast takes nothing returns nothing
