function BlackStarBigWaveCast4 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,11)
    local unit c=LoadUnitHandle(h,id,12)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetUnitX(c)
    local real y1=GetUnitY(c)
    local real a=Atan2(y1-y,x1-x)
    local player p=GetOwningPlayer(u)
    if SR(x,y,x1,y1)>50 and GetWidgetLife(c)>0 and GetUnitAbilityLevel(u,'A3IH')==0 and GetUnitAbilityLevel(c,'A3IH')==0 and ((GetUnitAbilityLevel(u,'A0IH')==0 and GetUnitAbilityLevel(c,'A0IH')==0) or (GetUnitAbilityLevel(u,'A0IH')>0 and GetUnitAbilityLevel(c,'A0IH')>0)) then
    set x=x+60*Cos(a)
    set y=y+60*Sin(a)
    call SetUnitXY_1(u,x,y, false)
    call SetUnitFacing(u,a*bj_RADTODEG)
    set n=CreateUnit(p,'e069',x,y,a*bj_RADTODEG)
    call UnitApplyTimedLife(n,'BTLF',0.25)
    call SetUnitVertexColor(n,170,170,170,255)
    call SetUnitTimeScale(n,2)
    call SetUnitAnimation(n,"Spell Channel One")
    call SetUnitAnimation(u,"Spell Channel One")
    else
    call PauseTimer(t)
    call DestroyTimer(t)
    call UnitRemoveAbility(u,'A0BX')
    call SetUnitTimeScale(u,1)
    call FlushChildHashtable(h,id)
    call myCustomDamage(Hero[GetPlayerId(p)],c,GetHeroStr(Hero[GetPlayerId(p)],true),false,false,null,null,null)
    call UnitApplyTimedLife(u,'BTLF',0.02)
    endif
    set p=null
    set u=null
    set c=null
    set t=null
endfunction
function BlackStarBigWaveCast3 takes unit l__d, unit c returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local real x=GetUnitX(l__d)
    local real y=GetUnitY(l__d)
    local real x1=GetUnitX(c)
    local real y1=GetUnitY(c)
    local real a=Atan2(y1-y,x1-x)
    local player p=GetOwningPlayer(l__d)
    call SaveUnitHandle(h,id,11,l__d)
    call SaveUnitHandle(h,id,12,c)
    call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(l__d),'e06H',x,y,GetRandomReal(0,359)),'BTLF',1)
    call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(l__d),'e06I',x,y,GetRandomReal(0,359)),'BTLF',1)
    call SetUnitTimeScale(l__d,5)
    call SetUnitInvulnerable(l__d,true)
    call TimerStart(t,0.025,true,function BlackStarBigWaveCast4)
    set p=null
    set l__d=null
    set c=null
    set t=null
endfunction
function BlackStarBigWaveCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local real a2=LoadReal(h,id,9)
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>50 and GetWidgetLife(c)>0 and GetUnitAbilityLevel(u,'A3IH')==0 and GetUnitAbilityLevel(c,'A3IH')==0 and ((GetUnitAbilityLevel(u,'A0IH')==0 and GetUnitAbilityLevel(c,'A0IH')==0) or (GetUnitAbilityLevel(u,'A0IH')>0 and GetUnitAbilityLevel(c,'A0IH')>0)) then
set x=x+60*Cos(a)
set y=y+60*Sin(a)
call SetUnitXY_1(u,x,y,false)
call SetUnitFacing(u,a*bj_RADTODEG)
set n=CreateUnit(p,'e069',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.25)
call SetUnitVertexColor(n,170,170,170,255)
call SetUnitTimeScale(n,2)
call SetUnitAnimation(n,"Spell Channel One")
call SetUnitAnimation(u,"Spell Channel One")
else
call UnitApplyTimedLife(CreateUnit(p,'e066',x,y,a*bj_RADTODEG),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e067',x,y,a*bj_RADTODEG),'BTLF',0.5)
call UnitApplyTimedLife(CreateUnit(p,'e068',x,y,a*bj_RADTODEG),'BTLF',1)
call myCustomDamage(u,c,((2+GetUnitAbilityLevel(u,'A0BW'))*GetHeroStr(u,true)),false,false,null,null,null)
call SetControlToUnit(u,c, 3, "silence")
call SlowUnit(u,c,0.3,0.3,3,0,false)
call Push(c,50,a2,300)
call PauseTimer(t)
call DestroyTimer(t)
call UnitRemoveAbility(u,'A0BX')
call SetUnitTimeScale(u,1)
call SetUnitPathing(u,true)
call PauseUnit(u,false)
call FlushChildHashtable(h,id)
call SetUnitInvulnerable(u,false)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function BlackStarBigWaveCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
call SaveUnitHandle(h,id,0,u)
call SetUnitPathing(u,false)
call SetUnitAnimation(u,"Spell Channel One")
call UnitAddAbility(u,'A0BX')
call PauseUnit(u,true)
set soundplay=SndN(1071) // Sound\Music\mp3Music\BlackStar.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SaveReal(h,id,9,Atan2(GetUnitY(c)-y,GetUnitX(c)-x))
call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e06H',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e06I',x,y,GetRandomReal(0,359)),'BTLF',1)
call SetUnitTimeScale(u,5)
call SetUnitInvulnerable(u,true)
call SaveUnitHandle(h,id,1,c)
call TimerStart(t,0.025,true,function BlackStarBigWaveCast2)
call GroupEnumUnitsInRange(G,x,y,600,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if GetUnitAbilityLevel(E,'B02A')>0 and IsUnitAlly(E,GetOwningPlayer(u)) then
    call BlackStarBigWaveCast3(E,c)
endif
call GroupRemoveUnit(G,E)
endloop
set c=null
set u=null
set t=null
endfunction
