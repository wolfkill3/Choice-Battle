set u=null
set p=null
set c=null
endfunction
function InitGalacticDonut takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function GalacticDonutCast)
call TriggerAddCondition(t,Condition(function GalacticDonutCond))
set t=null
endfunction
function ValleyballCond takes nothing returns boolean
return GetSpellAbilityId()=='A0NX' and udg_B==true
endfunction
function ValleyballMissleFly2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local unit d1=LoadUnitHandle(h,id,9)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
local real dist=LoadReal(h,id,6)
local real mh=LoadReal(h,id,5)
local real rad=LoadReal(h,id,7)
local real range=LoadReal(h,id,10)
local real rd=SR(x,y,x1,y1)
local player p=GetOwningPlayer(d1)
local integer idu=GetPlayerId(p)
local real dmg=(GetUnitAbilityLevel(Hero[idu],'A0NX')+5)*GetHeroAgi(Hero[idu],true)
local real cof=rd/dist
if rd>speed+30 and range>0 and UnitIsAlive(l__d)then
call PauseUnit(l__d,true)
call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,true)
call SetUnitInvulnerable(l__d,true)
set n=CreateUnit(p,'e0L5',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitFlyHeight(n,(mh*cof)-50,0)
set x=x+speed*Cos(a)
set y=y+speed*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SaveReal(h,id,1,speed*1.02)
call SaveReal(h,id,10,range-speed*1.02)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,(mh*cof)-50,0)
call SetUnitX(d1,x)
call SetUnitY(d1,y)
call SetUnitFacing(d1,a*bj_RADTODEG)
call SetUnitFlyHeight(d1,(mh*cof)-50,0)
else
call SetUnitInvulnerable(l__d,false)
call PauseUnit(l__d,false)
call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,false)
call myCustomDamage(Hero[idu],l__d,dmg,false,false,null,null,null)
call SetControlToUnit(Hero[idu],l__d,3,"stun")
set soundplay=SndN(1628) // Sound\Music\mp3Music\SuperBuuvVolleyball4.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call ShakeCamera(0.5,20)
call UnitApplyTimedLife(CreateUnit(p,'e0LA',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0L8',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0L9',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0C7',x,y,(a*bj_RADTODEG)),'BTLF',6)
call SetUnitFlyHeight(l__d,0,0)
call RemoveUnit(d1)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set d1=null
set p=null
set l__d=null
set t=null
endfunction
function ValleyballMissleFly takes unit l__d,unit d1,real speed,real angle,real x,real y,real mh,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveUnitHandle(h,id,9,d1)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,mh)
call SaveReal(h,id,6,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,8,dmg)
call SaveReal(h,id,10,900)
call TimerStart(t,0.03,true,function ValleyballMissleFly2)
set t=null
endfunction
function ValleyballCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,11)
local real y=LoadReal(h,id,12)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real x2=LoadReal(h,id,5)
local real y2=LoadReal(h,id,6)
local integer i=LoadInteger(h,id,7)
local real a=LoadReal(h,id,4)
local real a2=Atan2(y2-y1,x2-x1)
local real he=LoadReal(h,id,9)
local real he2=LoadReal(h,id,10)
local player p=GetOwningPlayer(u)
local real dist=SR(x1,y1,x2,y2)
local real time=LoadReal(h,id,13)
call SaveReal(h,id,13,time+0.03)
if i<4 and GetWidgetLife(c)>0 and GetWidgetLife(u)>0 and udg_B==true and DU2==true then
    call PauseUnit(u,true)
    call PauseUnit(c,true)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
    call SetUnitInvulnerable(u,true)
    call SetUnitInvulnerable(c,true)
    if time<1.5 then
        call SetUnitXY_1(c,x1+18*Cos(a2),y1+18*Sin(a2), false)
        if time==0.18 then 
            set bjLCU=CreateUnit(p, 'dH41', x, y, GetRandomInt(0, 360))
            call SetUnitFlyHeight(bjLCU, he2, 0)
            call MyRemoveUnit(bjLCU, 1)
            set bjLCU=CreateUnit(p, 'dH41', x2, y2, GetRandomInt(0, 360))
            call SetUnitFlyHeight(bjLCU, he, 0)
            call MyRemoveUnit(bjLCU, 1)
            call SetUnitXY_1(u,x2,y2, false)
            call SetUnitAnimation(u,"stand")
        endif
        if time<0.18 then
            call SetUnitFacingInstant(u,a2*bj_RADTODEG)
        else
            call SetUnitFacingInstant(u,a2*bj_RADTODEG+180)
        endif
        call SetUnitFlyHeight(c,ParabolaZ2(he,he2,he+SR(x,y,x2,y2),SR(x,y,x2,y2),dist),0)
        call SetUnitFacingInstant(c,a2*bj_RADTODEG+180)
        if SR(x1,y1,x2,y2)>450 then
            set bjLCU=CreateUnit(p, 'dH41', x1, y1, GetRandomInt(0, 360))
            call SetUnitFlyHeight(bjLCU, he, 0)
            call MyRemoveUnit(bjLCU, 1)
            set bjLCU=CreateUnit(p, 'dH41', x2, y2, GetRandomInt(0, 360))
            call SetUnitFlyHeight(bjLCU, he, 0)
            call MyRemoveUnit(bjLCU, 1)
            call SetUnitXY_1(u,x1,y1, false)
        endif
        if time==0.33 then
            call SetUnitAnimationByIndex(u,GetRandomInt(32,34))
        endif
        if time>0.21 then
            if SR(x1,y1,x2,y2)<=35 or SR(x1,y1,x2,y2)>470 then
                call SaveReal(h,id,13,2)
                call SaveReal(h,id,4,(GetUnitFacing(u))*bj_DEGTORAD)
            endif
        endif
    else
        set bjLCU=CreateUnit(p, 'dR58', x1, y1, GetRandomInt(0, 360))
        call SetUnitFlyHeight(bjLCU, he, 0)
        call MyRemoveUnit(bjLCU, 1)
        call SaveReal(h,id,13,0)
        call SaveInteger(h,id,7,i+1)
        set x=GetUnitX(u)
        set y=GetUnitY(u)
        set x2=x+420*Cos(a)
        set y2=y+420*Sin(a)
        call SaveReal(h,id,11,x)
        call SaveReal(h,id,12,y)
        call SaveReal(h,id,5,x2)
        call SaveReal(h,id,6,y2)
        call SaveReal(h,id,10,he)
        call SaveReal(h,id,9,he+150)
        call SetUnitFlyHeight(u,he+15,0)
        call SetUnitXY_1(c,x1-25*Cos(a2),y1-25*Sin(a2), false)
    endif
else
    if i>=3 then
        if time<1.11 then
        call SetUnitXY_1(u,x1-20*Cos(a2),y1-20*Sin(a2), false)
        call SetUnitFacingInstant(c,a2*bj_RADTODEG+GetRandomInt(-15,15))
        call SetUnitFacingInstant(u,a2*bj_RADTODEG)
        call PauseUnit(u,true)
        call PauseUnit(c,true)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
        call SetUnitInvulnerable(u,true)
        call SetUnitInvulnerable(c,true)
        endif
        if time==0.03 then
            call SetUnitAnimationByIndex(u,35)
            call SetUnitFlyHeight(c,GetUnitFlyHeight(c)+100,100)
            call SetUnitTimeScale(u,0.7)
        endif
        if time==1.11 then
            set n=CreateUnit(GetOwningPlayer(u), 'dR58', GetUnitX(c), GetUnitY(c), 0)
            call SetUnitFlyHeight(n, GetUnitFlyHeight(c)+10, 0)
            call MyRemoveUnit(n, 1.5)
            set n=CreateUnit(GetOwningPlayer(u), 'dM45', GetUnitX(c), GetUnitY(c), a2*bj_RADTODEG)
            call SetUnitFlyHeight(n, GetUnitFlyHeight(c)+10, 0)
            call MyRemoveUnit(n, 1.5)
            call SetUnitTimeScale(u,1)
            call ValleyballMissleFly(c,n,45,0,x+900*Cos(a2),y+900*Sin(a2),GetUnitFlyHeight(c),0)
        endif
        if time==1.26 then
            call SetUnitFlyHeight(u,0,1500)
        endif
        if time==1.5 then
            call PauseTimer(t)
            call SetUnitInvulnerable(u,false)
            call PauseUnit(u,false)
        endif
    else
        call SetUnitTimeScale(u,1)
        call SetUnitInvulnerable(u,false)
        call SetUnitInvulnerable(c,false)
        call PauseUnit(u,false)
        call PauseUnit(c,false)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
        call SetUnitFlyHeight(u,0,0)
        call SetUnitFlyHeight(c,0,0)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
    endif
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function MissleMoveValleyball takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real x2=LoadReal(h,id,11)
local real y2=LoadReal(h,id,12)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(l__d)
local real dist=SR(x,y,x1,y1)
local real he=0
local real time=LoadReal(h,id,15)
if SR(x,y,x1,y1)>60 and UnitIsAlive(c) and time<3 then
set he=ParabolaZ2(85,0,400,SR(x,y,x2,y2),dist)
call SetUnitFlyHeight(c,he,0)
call SetUnitX(c,x1-40*Cos(a))
call SetUnitY(c,y1-40*Sin(a))
call SaveReal(h,id,15,time+0.025)
else
if time>=3 and time<4 then
call SetUnitX(c,x+20*Cos(a))
call SetUnitY(c,y+20*Sin(a))
call SaveReal(h,id,15,5)
endif
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(1631) // Sound\Music\mp3Music\SuperBuuvVolleyball3.mp3
else
set soundplay=SndN(1634) // Sound\Music\mp3Music\Gotenks\SuperBuuvVolleyball3-jap.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SetUnitAnimationByIndex(l__d,32)
call SaveReal(h,id,11,x)
call SaveReal(h,id,12,y)
call SaveReal(h,id,5,x+500*Cos(a))
call SaveReal(h,id,6,y+500*Sin(a))
call SaveInteger(h,id,7,0)
call SaveReal(h,id,8,Atan2(y2-LoadReal(h,id,6),x2-LoadReal(h,id,5)))
call SaveReal(h,id,4,Atan2(y2-LoadReal(h,id,6),x2-LoadReal(h,id,5)))
call SaveReal(h,id,9,375)
call SaveReal(h,id,10,0)
call SaveReal(h,id,13,0)
call SetUnitFlyHeight(l__d,300,0)

call PauseTimer(t)
call TimerStart(t,0.03,true,function ValleyballCast3)
endif
set p=null
set c=null
set l__d=null
set t=null
endfunction
function ValleyballCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit l__d=LoadUnitHandle(h,id,5)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local real time=LoadReal(h,id,13)
local real x2=GetUnitX(c)
local real y2=GetUnitY(c)
local real f=GetUnitFacing(u)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroAgi(u,true)*12
local real dist=SR(x,y,x2,y2)
local real a=Atan2(y2-y,x2-x)
local real he=0
if time<0.7 then
if time==0.3 then
call SetUnitAnimationByIndex(u,30)
endif
if time==0.65 then
call SaveUnitHandle(h,id,5,CreateUnit(p,'e0M3',x1+50*Cos(a),y1+50*Sin(a),f))
endif
call SaveReal(h,id,13,time+0.025)
else
if dist>73.00 and udg_B==true and UnitIsAlive(c)then
call SetUnitX(l__d,x+66*Cos(a))
call SetUnitY(l__d,y+66*Sin(a))
call SetUnitFacingInstant(l__d,a*bj_RADTODEG)
set n=CreateUnit(p,'e0M3',x,y,a*bj_RADTODEG)
call SetUnitFacingInstant(n,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.15)
else
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false and IsUnitHidden(c)==false then
set soundplay=SndN(1637) // Sound\Music\mp3Music\SuperBuuvVolleyball2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call RemoveUnit(l__d)
set n=CreateUnit(p,'h019',x,y,0)
call UnitAddAbility(n,'A0NW')
call UnitApplyTimedLife(n,'BTLF',1)
call IssueTargetOrder(n,"polymorph",c)
call SetControlToUnit(c,c, 0.1, "stun")
call UnitApplyTimedLife(CreateUnit(p,'e0AX',x2,y2,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0AW',x2,y2,GetRandomReal(0,359)),'BTLF',0.01)
call UnitApplyTimedLife(CreateUnit(p,'e0B1',x2,y2,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0B4',x2,y2,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0AZ',x2,y2,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0B3',x2,y2,GetRandomReal(0,359)),'BTLF',1)
call SetUnitFlyHeight(u,0,0)
call SetUnitTimeScale(u,1)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call SetUnitInvulnerable(c,true)
call SaveReal(h,id,11,x2)
call SaveReal(h,id,12,y2)
call PauseTimer(t)
call TimerStart(t,0.025,true,function MissleMoveValleyball)
else
call RemoveUnit(l__d)
call SetUnitTimeScale(u,1)
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==true then
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
call SetUnitFlyHeight(u,0,0)
call SetUnitFlyHeight(c,0,0)
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
endif
endif
set l__d=null
set c=null
set u=null
set t=null
set p=null
endfunction
function ValleyballCast takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real f=GetUnitFacing(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local player p=GetOwningPlayer(u)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call UnitRemoveAbility(c,'B03Z')
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
if GetRandomInt(1,2)==1 then
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(1640) // Sound\Music\mp3Music\SuperBuuvVolleyball1.mp3
else
set soundplay=SndN(1642) // Sound\Music\mp3Music\Gotenks\SuperBuuvVolleyball1-jap.mp3
endif
else
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(1644) // Sound\Music\mp3Music\SuperBuuvVolleyball11.mp3
else
set soundplay=SndN(1642) // Sound\Music\mp3Music\Gotenks\SuperBuuvVolleyball1-jap.mp3
endif
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveReal(h,id,7,0)
call SaveReal(h,id,4,Atan2(y1-y,x1-x))
call UnitAddAbility(c,'Arav')
call UnitRemoveAbility(c,'Arav')
call UnitRemoveAbility(c,'A2VJ')
call UnitAddAbility(u,'Arav')
call UnitRemoveAbility(u,'Arav')
call SaveReal(h,id,13,0)
call TimerStart(t,0.025,true,function ValleyballCast2)
set u=null
set t=null
set p=null
set c=null
endfunction
function ValleyballInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function ValleyballCast)
call TriggerAddCondition(t,Condition(function ValleyballCond))
set t=null
endfunction
function SlashSplittingHeadache2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local player p=GetOwningPlayer(l__d)
local unit u=Hero[GetPlayerId(p)]
local real speed=LoadReal(h,id,1)
local real x=LoadReal(h,id,3)
local real y=LoadReal(h,id,4)
local group g=LoadGroupHandle(h,id,5)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,2)
local real dmg=LoadReal(h,id,6)
local real Range=LoadReal(h,id,9)
if SR(x,y,x1,y1)<=Range and IsTerrainPathable(GetUnitX(l__d),GetUnitY(l__d),PATHING_TYPE_FLYABILITY)==false then
call SetUnitXY_1(l__d,x1+speed*Cos(a),y1+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call GroupEnumUnitsInRange(g,x1,y1,LoadReal(h,id,10),Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
else
call UnitApplyTimedLife(CreateUnit(p,'e0LG',x1,y1,GetRandomReal(0,359)),'BHwe',1)
call UnitApplyTimedLife(CreateUnit(p,'e0G3',x1,y1,GetRandomReal(0,359)),'BHwe',1)
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,GetHandleId(g))
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function SlashSplittingHeadache takes unit l__d,real speed,real dmg,real angle,real range,real mas,real x,real y,real x1,real y1 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle)
call SaveGroupHandle(h,id,5,CreateGroup())
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,6,dmg)
call SaveReal(h,id,9,range)
call SaveReal(h,id,10,mas)
call TimerStart(t,0.03,true,function SlashSplittingHeadache2)
set t=null
endfunction
function SplittingHeadacheCond takes nothing returns boolean
return GetSpellAbilityId()=='A0NR' and udg_B==true
endfunction
function SplittingHeadacheCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local real dmg=10*GetHeroAgi(u,true)
local player p=GetOwningPlayer(u)
local real time=LoadReal(h,id,7)
local real mt=LoadReal(h,id,8)
local real sm=GetRandomReal(-75,75)
if mt>0 and UnitIsAlive(c)then
set x1=x1-40*Cos(a)
set y1=y1-40*Sin(a)
call SetUnitXY_1(u,x1,y1, false)
if time<0 then
set x1=x1+53*Cos(a)
set y1=y1+53*Sin(a)
call SetUnitXY_1(c,x1,y1, false)
call UnitApplyTimedLife(CreateUnit(p,'e0M0',x1,y1,a*bj_RADTODEG),'BTLF',0.8)
set n=CreateUnit(p,'e0M1',x1+sm*Cos(a+deg90),y1+sm*Sin(a+deg90),a*bj_RADTODEG)
call SlashSplittingHeadache(n,55,0,a,600,0,x,y,x1,y1)
set n=CreateUnit(p,'e0LZ',x+sm*Cos(a+deg90),y+sm*Sin(a+deg90),a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.3)
call SetUnitAnimationByIndex(n,27)
call SetUnitVertexColor(n,255,255,255,100)
call SaveReal(h,id,7,mt)
call SaveReal(h,id,8,mt-0.5)
endif
call SetUnitFacing(u,a*bj_RADTODEG)
if GetUnitAnimationOffsetPercent(u)<0.7 then
    call SetUnitAnimationOffsetPercent(u,0.4)
endif
call PauseUnit(u,true)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call SaveReal(h,id,7,LoadReal(h,id,7)-3)
else
call SetUnitInvulnerable(u,false)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call PauseUnit(u,false)
call myCustomDamage(u,c,dmg,false,false,null,null,null)
call Push3(c,35,a,1000,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitVertexColor(u,255,255,255,255)
call FlushChildHashtable(h,id)
call SetUnitTimeScale(u,1)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
