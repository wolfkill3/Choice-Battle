call SetUnitAnimationByIndex(caster,2)
else
call SetUnitAnimationByIndex(caster,1)
endif
set soundplay=SndN(3541) // war3mapimported\MadaraE2.mp3
                        call StartSound(soundplay)
                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call EffectCreateAndMove(true,"Madara\\az_siwen2.mdl",facing,1,1.25,0.5,100,100,100,30,100,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\HakenSaber2.mdl",facing,1,1.5,0.5,100,100,100,30,0,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\WindNewFaw4.mdl",facing,1,1.25,0.5,100,100,100,30,0,caster,0,facing)
endif
endif
set t=null
set caster=null
endfunction

