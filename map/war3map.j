function MissleMovePointLariat2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
local real dist=LoadReal(h,id,6)
local real mh=LoadReal(h,id,5)
local real rad=LoadReal(h,id,7)
local real rd=SR(x,y,x1,y1)
local real he=LoadReal(h,id,8)
local player p=GetOwningPlayer(l__d)
local integer idu=GetPlayerId(p)
if rd>30+speed and IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,ParabolaZ2(he,0,mh,dist,rd),0)
else
if IsUnitType(l__d,UNIT_TYPE_HERO)==false then
call KillUnit(l__d)
endif
call SetUnitFlyHeight(l__d,0,0)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set l__d=null
set t=null
endfunction
function MissleMovePointLariat takes unit l__d,real speed,real angle,real x,real y,real mh,real r,real he returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,mh)
call SaveReal(h,id,6,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,7,r)
call SaveReal(h,id,8,he)
call TimerStart(t,0.03,true,function MissleMovePointLariat2)
set t=null
endfunction
function LariatCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,22)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=LoadReal(h,id,11)
local real dmg=GetHeroAgi(u,true)*10
local player p=GetOwningPlayer(u)
local real l__d=0
local real r=0
local real dist=LoadReal(h,id,2)
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
if dist<1000 then
if IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
set x=x+60*Cos(a)
set y=y+60*Sin(a)
else
set x=x-10*Cos(a)
set y=y-10*Sin(a)
endif
call SetUnitXY_1(u,x,y, false)
set n=CreateUnit(p,'e0GZ',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,0.25)
call SetUnitTimeScale(n,2)
call SetUnitVertexColor(n,255,255,255,125)
call SetUnitAnimation(n,"spell channel")
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,0.65,0.65,0.65)
call SetUnitVertexColor(n,255,230,100,50)
set n=CreateUnit(p,'e0RE',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitVertexColor(n,255,230,100,50)
call SaveReal(h,id,2,dist+60)
else
set n=CreateUnit(p,0x65305543,x1,y1,GetRandomReal(0,359))
set l__d=GetRandomReal(100,400)
set r=GetRandomReal(0,7)
call MissleMovePointLariat(n,GetRandomReal(6,9),0,x+l__d*Cos(r),y+l__d*Sin(r),GetRandomReal(350,600),0,GetRandomReal(0,359))
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),1,2)
call UnitApplyTimedLife(CreateUnit(p,'e04D',x1,y1,GetRandomReal(0,359)),1,2)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),1,2)
call UnitApplyTimedLife(CreateUnit(p,'e04D',x1,y1,GetRandomReal(0,359)),1,2)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),1,2)
call UnitApplyTimedLife(CreateUnit(p,'e04D',x1,y1,GetRandomReal(0,359)),1,2)
call UnitApplyTimedLife(CreateUnit(p,'e0HM',x1,y1,GetRandomReal(0,359)),1,1.4)
call PauseUnit(u,false)
call SetUnitAnimation(u,"Spell Throw")
call UnitRemoveAbility(u,'A0O2')
call SetUnitInvulnerable(u,false)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call SetUnitInvulnerable(c,false)
call myCustomDamage(u,c,dmg,false,false,null,null,null)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
else
call PauseUnit(u,false)
call Push3(u,60,a,400,"")
call RemoveUnit(LoadUnitHandle(h,id,16))
call UnitRemoveAbility(u,'A0O2')
call SetUnitInvulnerable(u,false)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
call SetUnitInvulnerable(c,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set c=null
set u=null
set t=null
endfunction
function LariatCast2 takes nothing returns nothing
