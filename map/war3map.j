function FlamingArrowsMissleFly2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
local real dist=LoadReal(h,id,6)
local real mh=LoadReal(h,id,5)
local real rad=LoadReal(h,id,7)
local real rd=SR(x,y,x1,y1)
local real dmg=LoadReal(h,id,8)
local player p=GetOwningPlayer(l__d)
local integer idu=GetPlayerId(p)
if rd>30+speed and IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,ParabolaZ2(95,0,mh,dist,rd),0)
else
call GroupEnumUnitsInRange(G,x1,y1,rad,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(Hero[idu],E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(G,E)
endloop
call UnitApplyTimedLife(CreateUnit(p,0x65304854,x1,y1,GetRandomReal(0,359)),1,1.5)
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set l__d=null
set t=null
endfunction
function FlamingArrowsMissleFly takes unit l__d,real speed,real angle,real x,real y,real mh,real r,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,mh)
call SaveReal(h,id,6,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,7,r)
call SaveReal(h,id,8,dmg)
call TimerStart(t,0.03,true,function FlamingArrowsMissleFly2)
set t=null
endfunction
function CondFlamingArrows takes nothing returns boolean
return GetSpellAbilityId()=='A0QC'
endfunction
function CastFlamingArrows takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local integer i=0
local real r
local real l__d
local real a=Atan2(y-y1,x-x1)*bj_DEGTORAD
local real dmg=1*GetHeroInt(u,true)
loop
exitwhen i>(2+GetUnitAbilityLevel(u,'A0QC'))*2
set l__d=GetRandomReal(-350,350)
set r=GetRandomReal(0,7)
set n=CreateUnit(p,0x65304853,x1,y1,0)
call SetUnitScale(n,0.7,0.7,0.7)
call SetUnitVertexColor(n,0,0,0,255)
call SetUnitFlyHeight(n,95,0)
call FlamingArrowsMissleFly(n,GetRandomReal(35,40),GetRandomReal(-1,1),x+l__d*Cos(r),y+l__d*Sin(r),GetRandomReal(150,350),250,dmg)
set i=i+1
endloop
set p=null
set u=null
endfunction
