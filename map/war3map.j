function SlashRaven2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local player p=GetOwningPlayer(l__d)
local unit u=Hero[GetPlayerId(p)]
local real speed=LoadReal(h,id,1)
local real x=LoadReal(h,id,3)
local real y=LoadReal(h,id,4)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,2)
local real Range=LoadReal(h,id,9)
if Range>0 then
call SetUnitXY_1(l__d,x1+speed*Cos(a),y1+speed*Sin(a), false)
call SaveReal(h,id,9,Range-speed)
call SetUnitFacingInstant(l__d,a*bj_RADTODEG)
if GetRandomInt(1,15)==1 then
call DestroyEffect(AddSpecialEffect("feathercrow.mdx",x1,y1))
endif
else
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
endif
set u=null
set p=null
set t=null
set l__d=null
endfunction
function SlashRaven takes unit l__d,real speed,real angle,real range returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle)
call SaveReal(h,id,3,GetUnitX(l__d))
call SaveReal(h,id,4,GetUnitY(l__d))
call SaveReal(h,id,9,range)
call TimerStart(t,0.03,true,function SlashRaven2)
set t=null
endfunction
function GungnirCond takes nothing returns boolean
return GetSpellAbilityId()==0x41305858 and GetUnitTypeId(GetTriggerUnit())!='H007'  and GetUnitAbilityLevel(GetTriggerUnit(),'GIE1')==0
endfunction
function SlashGungnir2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local player p=GetOwningPlayer(l__d)
local unit u=Hero[GetPlayerId(p)]
local real speed=LoadReal(h,id,1)
local real x=LoadReal(h,id,3)
local real y=LoadReal(h,id,4)
local group g=LoadGroupHandle(h,id,5)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,2)
local real dmg=LoadReal(h,id,6)
local real Range=LoadReal(h,id,9)
if Range>0 then
call SetUnitXY_1(l__d,x1+speed*Cos(a),y1+speed*Sin(a), false)
call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",x1,y1))
call SaveReal(h,id,9,Range-speed)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call GroupEnumUnitsInRange(g,x1,y1,LoadReal(h,id,10),Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
else
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,GetHandleId(g))
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function SlashGungnir takes unit l__d,real speed,real dmg,real angle,real range,real mas returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle)
call SaveGroupHandle(h,id,5,CreateGroup())
call SaveReal(h,id,3,GetUnitX(l__d))
call SaveReal(h,id,4,GetUnitY(l__d))
call SaveReal(h,id,6,dmg)
call SaveReal(h,id,9,range)
call SaveReal(h,id,10,mas)
call TimerStart(t,0.03,true,function SlashGungnir2)
set t=null
endfunction
function GungnirCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local unit c=LoadUnitHandle(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real f=GetUnitFacing(u)
local string dmgtext=""
local integer i
local real dmg=0
local real tdamage=0
if(SR(x,y,x1,y1)>26.00)then
call SetUnitXY_1(l__d,x+47*Cos(a),y+47*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
else
call SlashGungnir(CreateUnit(p,'e04D',x1,y1,0),30,0,0,500,100)
call SlashGungnir(CreateUnit(p,'e04D',x1,y1,60),30,0,60*bj_DEGTORAD,500,100)
call SlashGungnir(CreateUnit(p,'e04D',x1,y1,120),30,0,120*bj_DEGTORAD,500,100)
call SlashGungnir(CreateUnit(p,'e04D',x1,y1,180),30,0,180*bj_DEGTORAD,500,100)
call SlashGungnir(CreateUnit(p,'e04D',x1,y1,240),30,0,240*bj_DEGTORAD,500,100)
call SlashGungnir(CreateUnit(p,'e04D',x1,y1,300),30,0,300*bj_DEGTORAD,500,100)
set dmg=5*GetHeroStr(u,true)
if dmg>GetWidgetLife(c)then
call SetUnitInvulnerable(c,false)
call UnitRemoveBuffs(c,true,true)
if UnitHasItemOfTypeBJ(c, 'I03A') and GetWidgetLife(c)>0 and IsUnitIllusion(c)==false then
    set AlastorPos=0
    loop
    exitwhen AlastorPos==6 or GetItemTypeId(UnitItemInSlot(c,AlastorPos)) == 'I03A'
    set AlastorPos=AlastorPos+1
    endloop
    if IsAbilityEnabled(GetUnitAbility(c,'AInv'))==true then
        set Alastor=GetItemOfTypeFromUnitBJ(c,'I03A')
        call UnitRemoveItem(c,Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(c, 'I03A',AlastorPos)
    else
        call EnableUnitAbility2(c,'AInv',false,true)
        set Alastor=GetItemOfTypeFromUnitBJ(c,'I03A')
        call UnitRemoveItem(c,Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(c, 'I03A',AlastorPos)    
        call DisableUnitAbility2(c,'AInv',false,true)
    endif
endif
call UnitAddAbility(c,'A0WR')
call SetUnitState(c,UNIT_STATE_LIFE,1)
call DamageIndicatorFunction(u,c,dmg)
call myCustomDamage(u,c,dmg,false,false,null,DAMAGE_TYPE_UNIVERSAL,null)
call UnitRemoveAbility(c,'A0WR')
else
if GetUnitTypeId(u) == 'H02L' and DU==true then
    set bDamage = bDamage + dmg
    if bDamage >= 30*GetHeroStr(u,true) then
        
        set bDamage = bDamage - (30*GetHeroStr(u,true))
        if bDamage < 0 then
            set bDamage = 0
        endif
        call SetHeroStr(u, GetHeroStr(u,false) + 1,true)
        set bState = bState + 1
        call StopSound(soundStr[7],false,false)
        call StopSound(soundStr[8],false,false)
        call StopSound(soundStr[9],false,false)
        call StopSound(soundStr[10],false,false)
        call StopSound(soundStr[11],false,false)
        call StopSound(soundStr[12],false,false)
        call StopSound(soundStr[13],false,false)
        call StopSound(soundStr[14],false,false)      
        if bState!=10 then
            set BrolyRandom=GetRandomInt(1,3)
            if BrolyRandom == 1 then
                if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
                    call StartSound(soundStr[7])
                else
                    call StartSound(soundStr[8])
                endif
            elseif BrolyRandom == 2 then
                if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
                    call StartSound(soundStr[9])
                else
                    call StartSound(soundStr[10])
                endif
            elseif BrolyRandom == 3 then
                if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
                    call StartSound(soundStr[11])
                else
                    call StartSound(soundStr[12])
                endif
            endif
        else
            set BrolySTRTransform[GetPlayerId(p)]=true
            if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
                call StartSound(soundStr[13])
            else
                call StartSound(soundStr[14])
            endif
        endif
        if BrolySTRCond[GetPlayerId(p)]==null and bState>=10 then
            set BrolySTRCond[GetPlayerId(p)]=CreateUnit(p,'h23J',RX,RY,0)
        endif
    endif
endif
if LoadBoolean(HH,GetHandleId( u ),StringHash("BGRageBool"))==false and GetUnitTypeId(u) == 'HBGN' and LoadBoolean(HH,GetHandleId( u ),StringHash("BGG"))==false and DU==true then
    set tdamage=LoadReal(HH,GetHandleId( u ),BGRageHash)-dmg


    if tdamage <=0 then


        call DestroyEffect(AddSpecialEffectTarget("BlackGoku\\byakuya-7.mdl", c ,"origin"))
        call HealTextTag(c,c,  GetUnitState( u ,UNIT_STATE_MAX_LIFE)*0.05*myCustomHeal2(c,1),"HealthRes")
        call SetUnitState( u ,UNIT_STATE_LIFE,GetUnitState( u ,UNIT_STATE_LIFE)+GetUnitState( u ,UNIT_STATE_MAX_LIFE)*0.05)
        call SaveInteger(HH,GetHandleId( u ),BGRageIHash,  LoadInteger(HH,GetHandleId( u ),BGRageIHash)+1 )
        call SaveReal(HH,GetHandleId( u ),BGRageHash,  LoadReal(HH,GetHandleId( u ),BGRageBHash)  )
        set tdamage=LoadReal(HH,GetHandleId( u ),BGRageBHash)
    else
        call SaveReal(HH,GetHandleId( u ),BGRageHash,tdamage)
    endif
    if LoadInteger(HH,GetHandleId( u ),BGRageIHash)==4 then
        set tdamage=0
        call SaveBoolean(HH,GetHandleId( u ),StringHash("BGRageBool"),true)
        if LoadBoolean(HH,GetHandleId( GetLocalPlayer() ),SOUND_LANGUAGE)==true then 
            set soundplay=CreateSound("Sound\\Music\\mp3Music\\SoundEng\\BlackGokuRage_eng.mp3",false,false,true,12700,12700,"")
            call StartSound(soundplay)
            call KillSoundWhenDone(soundplay)
        else
            set soundplay=CreateSound("Sound\\Music\\mp3Music\\SoundJap\\BlackGokuRage.mp3",false,false,true,12700,12700,"")
            call StartSound(soundplay)
            call KillSoundWhenDone(soundplay)
        endif
    endif
endif
call SetUnitState(c,UNIT_STATE_LIFE,GetWidgetLife(c)-dmg)
endif
call SaveInteger(HH,GetHandleId(c),TextDamageValueHash+GetPlayerId(GetOwningPlayer(u)),LoadInteger(HH,GetHandleId(c),TextDamageValueHash+GetPlayerId(GetOwningPlayer(u)))+R2I(dmg))
if LoadInteger(HH,GetHandleId(c),TextDamageValueHash+GetPlayerId(GetOwningPlayer(u)))==0 then
    call SaveStr(HH,GetHandleId(c),GetPlayerId(GetOwningPlayer(u))+TextDmgValueTextHash,"")
else
    call SaveStr(HH,GetHandleId(c),GetPlayerId(GetOwningPlayer(u))+TextDmgValueTextHash,Color[GetPlayerId(GetOwningPlayer(u))]+I2S( LoadInteger(HH,GetHandleId(c),TextDamageValueHash+GetPlayerId(GetOwningPlayer(u))))+"|r  ")
endif
set i=0
loop
exitwhen i>=17
    if Hero[i]!=null then
    set dmgtext=dmgtext+LoadStr(HH,GetHandleId(c),GetPlayerId(GetOwningPlayer(Hero[i]))+TextDmgValueTextHash)
    endif
    set i=i+1
endloop
//call BJDebugMsg(dmgtext)
call AllTextTag2(dmgtext,c)
set dmgtext=""

call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
endif

set u=null
set l__d=null
set t=null
set c=null
endfunction
function GungnirCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real f=GetUnitFacing(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,CreateUnit(GetOwningPlayer(u),0x65305555,x+50.*Cos(a),y+50.*Cos(a),a*bj_RADTODEG))
call SaveUnitHandle(h,id,2,c)
call TimerStart(t,0.025,true,function GungnirCast2)
set u=null
set t=null
endfunction
