function Hado54HaienCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local real l__d=LoadReal(h,id,8)
local player p=GetOwningPlayer(u)
local real f
if SR(x,y,x1,y1)>32 and UnitIsAlive(c)then
set x=x+30*Cos(a)
set y=y+30*Sin(a)
set n=CreateUnit(p,'e0E3',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.08)
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call UnitApplyTimedLife(CreateUnit(p,'e0DC',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0DF',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0DE',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0DD',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0C7',x,y,(a*bj_RADTODEG)),'BTLF',6)
set soundplay=SndN(1354) // Sound\Music\mp3Music\bzzzz.wav
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
if 20>GetUnitLifePercent(c)and GetUnitTypeId(c)!='H075' then
call SetUnitInvulnerable(c,false)
call UnitRemoveBuffs(c,true,true)
call UnitAddAbility(c,'A0WR')
call myCustomDamage(u,c,1000000,false,false,null,null,null)
call DamageIndicatorFunction(u, c, (3+GetUnitAbilityLevel(u,'A0J9'))*GetHeroAgi(u,true))
call UnitRemoveAbility(c,'A0WR')
else
call myCustomDamage(u,c,(3+GetUnitAbilityLevel(u,'A0J9'))*GetHeroAgi(u,true),false,false,null,null,null)
endif
endif
set p=null
set u=null
set c=null
set t=null
endfunction
