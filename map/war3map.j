if SR(GetUnitX(GetEnumUnit()),GetUnitY(GetEnumUnit()),GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)))<300 or SR(GetUnitX(GetEnumUnit()),GetUnitY(GetEnumUnit()),GetUnitX(LoadUnitHandle(HH,id,21)),GetUnitY(LoadUnitHandle(HH,id,21)))<300 or SR(GetUnitX(GetEnumUnit()),GetUnitY(GetEnumUnit()),GetUnitX(LoadUnitHandle(HH,id,22)),GetUnitY(LoadUnitHandle(HH,id,22)))<300 or SR(GetUnitX(GetEnumUnit()),GetUnitY(GetEnumUnit()),GetUnitX(LoadUnitHandle(HH,id,23)),GetUnitY(LoadUnitHandle(HH,id,23)))<300 or SR(GetUnitX(GetEnumUnit()),GetUnitY(GetEnumUnit()),GetUnitX(LoadUnitHandle(HH,id,24)),GetUnitY(LoadUnitHandle(HH,id,24)))<300 then
call SetUnitModel(GetEnumUnit(),"Madara\\Madara-huitu-36.mdl")
call DamageAoeOneTime1(LoadUnitHandle(HH,id,1),GetUnitX(GetEnumUnit()),GetUnitY(GetEnumUnit()),300,GetHeroInt(LoadUnitHandle(HH,id,1),true)*4,LoadGroupHandle(HH,id,40))
call GroupRemoveUnit(LoadGroupHandle(HH,GetHandleId(LoadUnitHandle(HH,id,1)),SH_MadWGroup),GetEnumUnit())
