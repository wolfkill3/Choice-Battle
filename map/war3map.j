local group g=LoadGroupHandle(h,id,1)
local real dmg=(GetUnitAbilityLevel(u,'A0J8')*0.05+0.65)*GetHeroAgi(u,true)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
loop
set E=FirstOfGroup(g)
exitwhen E==null
call Slash_Benihiko(E,45,dmg,GetUnitFacing(E)*bj_DEGTORAD,1200,55)
call GroupRemoveUnit(g,E)
endloop
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set u=null
set g=null
set t=null
