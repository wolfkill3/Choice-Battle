function VisibityOfHeroesCast takes nothing returns nothing
local integer i
local real x
local real y
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local fogmodifier f
// if udg_B==true then
// set TestString=I2S(S2I(TestString)+1)
// set n=CreateUnit(Player(0),'ogru',0,0,1)
// call SlowUnit(n,n,0.5,0.5,2,2,false)
// call SlowUnit(n,n,0.5,0.5,3,2,false)
// call SlowUnit(n,n,0.5,0.5,4,2,false)
// call UnitApplyTimedLife(n,1,GetRandomReal(1,5))
// call CreateModeIndicatorForm(n, TestString+".blp", 3)
// set n=null
// endif
set i=0
loop
exitwhen i>=12
if UnitIsAlive(Hero[i])==false or AllIsVisible==true then
    if FFAMode==true or AllIsVisible==true then
        set f=CreateFogModifierRadius(Player(i),FOG_OF_WAR_VISIBLE,GetUnitX(Hero[i]),GetUnitY(Hero[i]),99999,true,true)
        call SaveFogModifierHandle(HH,id,i,f)
        call FogModifierStart(f)
    endif
elseif GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING and Hero[i]!=null and UnitIsAlive(Hero[i])then
    if GetUnitData( Hero[i], "combo4" ) <= 1 and GetUnitAbilityLevel(Hero[i],'B01L')>0 then
        call UnitRemoveAbility(Hero[i], 'A2VJ')
        call UnitRemoveAbility(Hero[i], 'B01L')
    endif
        if GetUnitAbilityLevel(Hero[i],'cb10')==0 and GetUnitAbilityLevel(Hero[i],'cb11')==0 then
            if GetUnitAbilityLevel(Hero[i],'B15A')>0 then
                set f=CreateFogModifierRadius(Player(i),FOG_OF_WAR_VISIBLE,GetUnitX(Hero[i]),GetUnitY(Hero[i]),2500,true,true)
            else
                set f=CreateFogModifierRadius(Player(i),FOG_OF_WAR_VISIBLE,GetUnitX(Hero[i]),GetUnitY(Hero[i]),1500,true,true)
            endif
        else
            if GetUnitAbilityLevel(Hero[i],'cb10')==1 or GetUnitAbilityLevel(Hero[i],'cb11')==1 then
                set f=CreateFogModifierRadius(Player(i),FOG_OF_WAR_VISIBLE,GetUnitX(Hero[i]),GetUnitY(Hero[i]),100,true,true)
            endif
        endif   
call SaveFogModifierHandle(HH,id,i,f)
call FogModifierStart(f)
endif
set i=i+1
endloop
if GetFrameText(SpectacleTeamSelectText)=="Full Map Vision" then
    set f=CreateFogModifierRadius(Player(10),FOG_OF_WAR_VISIBLE,500,-240,99999,true,true)
    call SaveFogModifierHandle(HH,id,10,f)
    call FogModifierStart(f)
endif
if GetFrameText(SpectacleTeamSelect1Text)=="Full Map Vision" then
    set f=CreateFogModifierRadius(Player(11),FOG_OF_WAR_VISIBLE,500,-240,99999,true,true)
    call SaveFogModifierHandle(HH,id,11,f)
    call FogModifierStart(f)
endif
call ShowFrame( SpectacleTeamSelect, GetPlayerId(GetLocalPlayer())==10 )
call ShowFrame( SpectacleTeamSelect1, GetPlayerId(GetLocalPlayer())==11 )
call TimerStart(t,1,false,function VisibityOfHeroesCast2)
set t=null
set f=null
endfunction
