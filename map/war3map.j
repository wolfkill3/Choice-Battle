function InitTrig_IndicatorDamage takes nothing returns nothing
        local trigger t
        local integer i=0
        set i=0
        set t=CreateTrigger()
        loop
        exitwhen i>=13
                call TriggerRegisterPlayerChatEvent(t,Player(i),"-damage",true)
        set i=i+1
        endloop
        call TriggerAddAction(t,function callDamageIndicator)
        
        set i=0
        set t=CreateTrigger()
        loop
        exitwhen i>=13
                call TriggerRegisterPlayerChatEvent(t,Player(i),"-tdamage",true)
        set i=i+1
        endloop
        call TriggerAddAction(t,function DamageIndicatorForAll)

        set i=0
        set t=CreateTrigger()
        loop
        exitwhen i>=13
                call TriggerRegisterPlayerChatEvent(t,Player(i),"-theal",true)
        set i=i+1
        endloop
        call TriggerAddAction(t,function HealIndicatorForAll)
        set t=null
endfunction
function Trig_Gold_Actions takes nothing returns nothing
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=12
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
call AdjustPlayerStateBJ(1000000,ConvertedPlayer(GetForLoopIndexA()),PLAYER_STATE_RESOURCE_GOLD)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endfunction
