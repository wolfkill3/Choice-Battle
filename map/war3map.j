call UnitApplyTimedLife(CreateUnit(p,'e07M',x1,y1,GetRandomReal(0,359)),1,4)
call UnitApplyTimedLife(CreateUnit(p,'e07N',x1,y1,GetRandomReal(0,359)),1,4)
