function MistEnergyCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local integer level=LoadInteger(h,id,0)
local group g=LoadGroupHandle(h,id,1)
local group g2
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local real dur=LoadReal(h,id,4)+0.05
local real speed=LoadReal(h,id,5)
local real dist=LoadReal(h,id,6)+speed
local real tx
local real ty
local real a
if dur<1.7 then
set g2=CopyGroup(g)
loop
set E=FirstOfGroup(g2)
exitwhen E==null
set tx=GetUnitX(E)
set ty=GetUnitY(E)
set a=Atan2(ty-y,tx-x)
if GetUnitState(E,UNIT_STATE_LIFE)>0.405 and not IsTerrainPathable(tx+speed*Cos(a),ty+speed*Sin(a),PATHING_TYPE_FLYABILITY)then
call SetUnitX(E,tx+speed*Cos(a))
call SetUnitY(E,ty+speed*Sin(a))
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl",tx,ty))
else
call GroupRemoveUnit(g,E)
endif
call GroupRemoveUnit(g2,E)
endloop
call DestroyGroupTimed(g2,3)
call SaveReal(h,id,4,dur)
call SaveReal(h,id,5,speed-1)
call SaveReal(h,id,6,dist)
else
call GroupClear(g)
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set t=null
set g2=null
set g=null
endfunction
