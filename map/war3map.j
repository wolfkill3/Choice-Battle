else
set n=CreateUnit(p,'e0P7',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,4)
call SetUnitFlyHeight(n,350,0)
set n=CreateUnit(p,'e0P6',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,4)
call SetUnitFlyHeight(n,350,0)
set n=CreateUnit(p,'e0P5',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,4)
call SetUnitFlyHeight(n,350,0)
set n=CreateUnit(p,'e0P4',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,4)
call SetUnitFlyHeight(n,350,0)
set n=CreateUnit(p,'e0P8',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,4)
call SetUnitFlyHeight(n,350,0)
set n=CreateUnit(p,'e0P5',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,4)
call SetUnitFlyHeight(n,350,0)
set n=CreateUnit(p,'e0P5',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,4)
call SetUnitFlyHeight(n,350,0)
set n=CreateUnit(p,'e0P8',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,4)
call SetUnitFlyHeight(n,350,0)
set n=CreateUnit(p,'e0P8',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,4)
call SetUnitFlyHeight(n,350,0)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call UnitRemoveAbility(c,'Pet1')
call myCustomDamage(u,c,dmg,false,false,null,null,null)
call SetUnitFlyHeight(c,0,350)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set c=null
set p=null
set t=null
endfunction
function TelekinezCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
    call SaveUnitHandle(h,id,0,u)
    call SaveUnitHandle(h,id,1,c)
    call SaveReal(h,id,2,0)
    call PauseUnit(u,true)
    call SetUnitInvulnerable(u,true)
    call SetUnitAnimation(u,"Spell Channel")
    call SetUnitFlyHeight(c,350,1000)
    if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
    set soundplay=CreateSound("Sound\\Music\\mp3Music\\FriezaKillsKrillin.mp3",false,false,true,12700,12700,"")
    else
    set soundplay=CreateSound("Sound\\Music\\mp3Music\\Frieza\\FriezaKillsKrillin-jap.mp3",false,false,true,12700,12700,"")
    endif
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    call UnitAddAbility(c,'Pet1')
    call SetControlToUnit(c,c,2.1,"heavystun")
    call TimerStart(t,0.1,true,function TelekinezCast2)
else
    call PauseUnit(u,false)
    call SetUnitInvulnerable(u,false)
    call SetUnitAnimation(u,"Spell Channel")
    call PauseUnit(c,false)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
    call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
    call PauseTimer(t)
    call DestroyTimer(t)
    call SetUnitVertexColor(u,255,255,255,255)
    call FlushChildHashtable(h,id)
endif
set u=null
set t=null
set p=null
endfunction
function InitTrig_Telekinez takes nothing returns nothing
set gg_trg_Telekinez=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Telekinez,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_Telekinez,Condition(function TelekinezCond))
call TriggerAddAction(gg_trg_Telekinez,function TelekinezCast)
endfunction

function FriezaW_StopOrders2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    call IssueImmediateOrder(u,"stop")
    //call SetUnitAnimationByIndex(u, 17)
    call FlushChildHashtable(h,id)
    call DestroyTimer(t)
    set t=null
    set u=null
endfunction

function FriezaW_StopOrders takes nothing returns nothing
    local unit u=GetOrderedUnit()
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    call SaveUnitHandle(h,id,0,u)
    if GetOrderTargetUnit()==null then
        call SaveReal(h,id,2,GetOrderPointX())
        call SaveReal(h,id,1,GetOrderPointY())
    else
        call SaveReal(h,id,2,GetUnitX(GetOrderTargetUnit()))
        call SaveReal(h,id,1,GetUnitY(GetOrderTargetUnit()))
    endif
    call SaveReal(HH,GetHandleId(u),FriezaWX,LoadReal(h,id,2))
    call SaveReal(HH,GetHandleId(u),FriezaWY,LoadReal(h,id,1))
    call TimerStart(t,0.001,false,function FriezaW_StopOrders2)
    set u=null
    set t=null
endfunction
function MissleMoveFriezaCombo2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit l__d=LoadUnitHandle(h,id,2)
local real speed=LoadReal(h,id,4)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real x2=GetUnitX(u)
local real y2=GetUnitY(u)
local real a=LoadReal(h,id,3)
local player p=GetOwningPlayer(u)
local real dist=LoadReal(h,id,8)
local real time=LoadReal(h,id,9)
local group g=LoadGroupHandle(h,id,10)
local integer l__idg=GetHandleId(g)
if time>=0 then
call SaveReal(h,id,9,time-1)
elseif dist>0 then
if IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
set x=x+speed*Cos(a)
set y=y+speed*Sin(a)
else
set x=x-speed*Cos(a)
set y=y-speed*Sin(a)
endif
if dist<700 then
set x2=x2+speed*Cos(a)
set y2=y2+speed*Sin(a)
call SetUnitAnimation(u,"walk")
call SetUnitFacing(u,a*bj_RADTODEG)
if GetUnitTypeId(u)=='H248' then
set n=CreateUnit(p,'e1QV',x2,y2,a*bj_DEGTORAD)
else
set n=CreateUnit(p,'e0QV',x2,y2,a*bj_DEGTORAD)
endif
call UnitApplyTimedLife(n,1,0.14)
call SetUnitVertexColor(n,255,255,255,50)
call SetUnitAnimation(n,"walk")
endif
call SetUnitXY_1(l__d,x,y, false)
call SetUnitXY_1(c,x,y, false)
call SetUnitXY_1(u,x2,y2, false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SaveReal(h,id,8,dist-speed)
call SetUnitTurnSpeed(u,1)
set n=CreateUnit(p,'e0TI',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,1)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,255,230,100,100)
call GroupEnumUnitsInRange(g,x1,y1,220,Base)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E) and E!=c then
if E!=LoadUnitHandle(h,l__idg,ide) then
call myCustomDamage(u,E,LoadReal(h,id,5)*0.2,false,false,null,null,null)
endif
call Push(E,20,Atan2(GetUnitY(E)-y1,GetUnitX(E)-x1),40)
call SaveUnitHandle(h,l__idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
else
call PauseUnit(u,false)
call SetUnitTimeScale(u,1)
call SetUnitInvulnerable(u,false)
call SetUnitAnimation(u,"Stand")
call UnitApplyTimedLife(CreateUnit(p,'e0NJ',x1,y1,GetRandomReal(0,359)),1,3)
//call UnitApplyTimedLife(CreateUnit(p,'e0NK',x1,y1,GetRandomReal(0,359)),1,6)
call UnitApplyTimedLife(CreateUnit(p,'e0NI',x1,y1,GetRandomReal(0,359)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0NL',x1,y1,GetRandomReal(0,359)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0NM',x1,y1,GetRandomReal(0,359)),1,3)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call SetUnitInvulnerable(c,false)
call myCustomDamage(u,c,LoadReal(h,id,5),false,false,null,null,null)
call SetControlToUnit(u,c,3, "stun")
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
call KillUnit(l__d)
endif
set p=null
set l__d=null
set c=null
set t=null
set u=null
set g=null
endfunction
function MissleMoveFriezaCombo takes unit u,unit c,unit l__d,real speed,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveUnitHandle(h,id,2,l__d)
call SaveReal(h,id,3,Atan2(GetUnitY(l__d)-GetUnitY(u),GetUnitX(l__d)-GetUnitX(u)))
call SaveReal(h,id,4,speed)
call SaveReal(h,id,5,dmg)
call SaveReal(h,id,8,1200)
call SaveReal(h,id,9,25)
call SaveGroupHandle(h,id,10,CreateGroup())
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\FriezaW2.mp3",false,false,true,12700,12700,"")
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Frieza\\FriezaW2-jap.mp3",false,false,true,12700,12700,"")
endif
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.02,true,function MissleMoveFriezaCombo2)
set t=null
endfunction
function Push_FriezaCombo2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local unit u=LoadUnitHandle(h,id,5)
local real speed=LoadReal(h,id,1)
local real a=LoadReal(h,id,2)
local real a2=a
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real dist=LoadReal(h,id,3)
local player p=GetOwningPlayer(u)
local real dmg=(2+GetUnitAbilityLevel(u,'A0SS'))*GetHeroInt(u,true)
local trigger newTrigger
if dist>0 then
    if IsTerrainPathable(x+speed*5*Cos(a),y+speed*5*Sin(a),PATHING_TYPE_FLYABILITY)==false then
        call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
        call SetUnitFacing(l__d,a*bj_RADTODEG)
    elseif IsTerrainPathable(x+speed*4*Cos(a),y+speed*4*Sin(a),PATHING_TYPE_FLYABILITY)==true then
        call SetUnitXY_1(l__d,x-speed*Cos(a),y-speed*Sin(a), false)
    endif
    if dist>160 then
        call SetControlToUnit(u,u,0.04,"doom")
        call SetUnitFacing(u,a*bj_RADTODEG)
    else
        call SetUnitFacingInstant(u,(a2*bj_RADTODEG)-180)
    endif
    call SaveReal(h,id,3,dist-speed)
    call SaveReal(h,id,1,speed-speed*0.03)
    call DestroyEffect(AddSpecialEffect(LoadStr(h,id,4),x,y))
    if dist<200 and dist>=160 then
        set newTrigger = LoadTriggerHandle(h, id, 99)
        call TriggerClearActions(newTrigger)
        call DestroyTrigger(newTrigger)
        call UnitRemoveAbility(u, 'A1FU') //Slow
        call UnitRemoveAbility(u, 'Pet1')
        call SetUnitAcquireRange(u, 600)
        call UnitRemoveAbility(u, 'B00A')
        call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x1,y1))
        if IsTerrainPathable(x+speed*6*Cos(a),y+speed*6*Sin(a),PATHING_TYPE_FLYABILITY)==false then
            set a2=Atan2(LoadReal(HH,GetHandleId(u),FriezaWY)-(y+200*Sin(a)),LoadReal(HH,GetHandleId(u),FriezaWX)-(x+200*Cos(a)))
            call SetUnitFacingInstant(u,(a2*bj_RADTODEG)-180)
            call SetUnitX(u,x+200*Cos(a)-220*Cos(a2))
            call SetUnitY(u,y+200*Sin(a)-220*Sin(a2))
        else
            set a2=Atan2(LoadReal(HH,GetHandleId(u),FriezaWY)-y,LoadReal(HH,GetHandleId(u),FriezaWX)-x)
            call SetUnitFacingInstant(u,(a2*bj_RADTODEG)-180)
            call SetUnitX(u,x-45*Cos(a2))
            call SetUnitY(u,y-45*Sin(a2))
        endif
        call PauseUnit(u,true)
        if IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==true then
            loop
            exitwhen IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false
                call SetUnitX(u,x-20*Cos(a))
                call SetUnitY(u,y-20*Sin(a))
            endloop
        endif
        call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",GetUnitX(u),GetUnitY(u)))
    endif
else
    set n=CreateUnit(p,'e0QQ',x,y,a*bj_RADTODEG)
    call SetUnitScale(n,1.13,1.13,1.13)
    call SetUnitAnimation(u,"Portrait")
    call MissleMoveFriezaCombo(u,l__d,n,40,dmg)
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set l__d=null
set t=null
endfunction
function Push_FriezaCombo takes unit l__d,real speed,real angle,real dist,string l__s,unit u returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local trigger newTrigger= CreateTrigger()
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle)
call SaveReal(h,id,3,dist)
call SaveStr(h,id,4,l__s)
call SaveUnitHandle(h,id,5,u)
call SetUnitAcquireRange(u, 51)
call UnitAddAbility(u, 'A1FU') //Slow
call UnitAddAbility(u, 'Pet1')
call SetControlToUnit(u,u,0.04,"doom")
call TriggerRegisterUnitEvent(newTrigger, u, EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterUnitEvent(newTrigger, u, EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerAddAction(newTrigger,function FriezaW_StopOrders)
call SaveTriggerHandle(h, id, 99, newTrigger)
call TimerStart(t,0.03,true,function Push_FriezaCombo2)
set t=null
endfunction
function FriezaComboCond takes nothing returns boolean
return GetSpellAbilityId()=='A0SS' and udg_B==true
endfunction
function FriezaComboAct2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real x2=0
local real y2=0
local integer i=LoadInteger(h,id,2)
local player p=GetOwningPlayer(u)
local real a=Atan2(y1-y,x1-x)
local real f
local real dist=SR(x,y,x1,y1)
if dist>120 and UnitIsAlive(u)and UnitIsAlive(c)then
set x=x+40*Cos(a)
set y=y+40*Sin(a)
call SetUnitXY_1(u,x,y, false)
call SetUnitInvulnerable(u,true)
call PauseUnit(u,true)
call SetUnitFacing(u,a*bj_RADTODEG)
if GetUnitTypeId(u)=='H248' then
set n=CreateUnit(p,'e1QV',x,y,a*bj_DEGTORAD)
else
set n=CreateUnit(p,'e0QV',x,y,a*bj_DEGTORAD)
endif
call UnitApplyTimedLife(n,1,0.14)
call SetUnitVertexColor(n,255,255,255,50)
call SetUnitAnimation(n,"walk")
if dist<240 then
call SetUnitAnimation(u,"Attack Cinematic")
else
call SetUnitAnimation(u,"walk")
endif
elseif UnitIsAlive(c) then
    if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\BrolyHit.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        call DestroyTimer(t)
        call PauseUnit(c,true)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
        call PauseUnit(u,false)
        call SetUnitInvulnerable(c,true)
        call SetUnitInvulnerable(u,true)
        call Push_FriezaCombo(c,50,a,800,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",u)
        call FlushChildHashtable(h,id)
    else
        call PauseUnit(u,false)
        call SetUnitInvulnerable(u,false)
        call PauseUnit(c,false)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
        call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
        call PauseTimer(t)
        call DestroyTimer(t)
        call SetUnitVertexColor(u,255,255,255,255)
        call FlushChildHashtable(h,id)
    endif
else
call SetUnitTimeScale(u,1)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function FriezaComboAct takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
local player p=GetOwningPlayer(u)
call SetUnitAnimation(u,"walk")
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call UnitAddAbility(u,'Arav')
call UnitRemoveAbility(u,'Arav')
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\FriezaW1.mp3",false,false,true,12700,12700,"")
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Frieza\\FriezaW1-jap.mp3",false,false,true,12700,12700,"")
endif
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call SetUnitTurnSpeed(u,5000.00)
call SetUnitTimeScale(u,2)
call TimerStart(t,0.03,true,function FriezaComboAct2)
