set gg_trg_EchoRitm=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_EchoRitm,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_EchoRitm,Condition(function EchoRitmCond))
