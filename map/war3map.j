    local unit hashic=LoadUnitHandle(h,id,16)
    local unit tobic=LoadUnitHandle(h,id,15)
    local player p=GetOwningPlayer(u)
    local real x=LoadReal(h,id,1)
    local real y=LoadReal(h,id,2)
    local real x1=LoadReal(h,id,3)
    local real y1=LoadReal(h,id,4)
    local real x2=GetUnitX(hashic)
    local real y2=GetUnitY(hashic)
    local real x3=GetUnitX(tobic)
    local real y3=GetUnitY(tobic)
    local real he=GetUnitFlyHeight(tobic)
    local real he2=GetUnitFlyHeight(hashic)
    local real rg=550
    local real a2=Atan2(y1-y2,x1-x2)
    local real a3=Atan2(y1-y3,x1-x3)
    local group g=LoadGroupHandle(h,id,6)
    local real a=LoadReal(h,id,5)
    local real time=LoadReal(h,id,13)
    local real dmg=GetHeroInt(u,true)*12
    local integer i=0
    if time>0 then
    set x3=x3-150*Cos(a3)
    set y3=y3-150*Sin(a3)
    set n=CreateUnit(p,'or30',x3,y3,GetRandomReal(0,359))
    call UnitApplyTimedLife(n,'BTLF',0.6)
    call SetUnitFlyHeight(n,he,0)
    call SetUnitFlyHeight(hashic,he2-80,0)
    call SetUnitFlyHeight(tobic,he-60,0)
    call SaveReal(h,id,13,time-0.03)
    else
    set n=CreateUnit(p,'or40',x1,y1,0)
    call UnitApplyTimedLife(n,'BTLF',3)
    set n=CreateUnit(p,'or40',x1,y1,60)
    call UnitApplyTimedLife(n,'BTLF',3)
    set n=CreateUnit(p,'or40',x1,y1,120)
    call UnitApplyTimedLife(n,'BTLF',3)
    set n=CreateUnit(p,'or40',x1,y1,180)
    call UnitApplyTimedLife(n,'BTLF',3)
    set n=CreateUnit(p,'or40',x1,y1,240)
    call UnitApplyTimedLife(n,'BTLF',3)
    set n=CreateUnit(p,'or40',x1,y1,300)
    call UnitApplyTimedLife(n,'BTLF',3)
    call UnitApplyTimedLife(n,'BTLF',3)
    set n=CreateUnit(p,'or16',x1,y1,0)
    call SetUnitTimeScale(n,1)
    call UnitApplyTimedLife(n,'BTLF',0.01)
    set n=CreateUnit(p,'or17',x1,y1,0)
    call SetUnitTimeScale(n,1)
    call UnitApplyTimedLife(n,'BTLF',0.01)
    set n=CreateUnit(p,'or18',x1,y1,0)
    call SetUnitTimeScale(n,1)
    call UnitApplyTimedLife(n,'BTLF',0.01)
    loop
    exitwhen i>=12
    set n=CreateUnit(p,0x6F723338,x1+700*Cos(30*i*bj_DEGTORAD),y1+700*Sin(30*i*bj_DEGTORAD),GetRandomReal(0,359))
    call UnitApplyTimedLife(n,'BTLF',0.01)
    set i=i+1
    endloop
    call ShakeCamera(0.8,35)
    call GroupEnumUnitsInRange(G,x1,y1,1100,Base)
    loop
    set E=FirstOfGroup(G)
    exitwhen E==null
    if Condition_Base(p,E)then
    call myCustomDamage(u,E,dmg,false,false,null,null,null)
    endif
    call GroupRemoveUnit(G,E)
    endloop
    call PauseTimer(t)
    call TimerStart(t,0.4,false,function OrochimaruTCast9)
    endif
    set hashic=null
    set tobic=null
    set p=null
    set u=null
    set t=null
    set g=null
endfunction
