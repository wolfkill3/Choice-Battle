function Trig_Electro_Wawe_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A01S'
endfunction
function Trig_Electro_Wawe_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=LoadReal(h,id,1)
local real y=LoadReal(h,id,2)
local real a=Atan2(LoadReal(h,id,4)-y,LoadReal(h,id,3)-x)
local real l__d=LoadReal(h,id,5)
local group g=LoadGroupHandle(h,id,6)
local integer l__idg=GetHandleId(g)
local player p=GetOwningPlayer(u)
local integer l__ide
local real dmg=50+25*GetUnitAbilityLevel(u,'A01S')+(GetUnitAbilityLevel(u,'A01S')+1)*GetHeroInt(u,true)
if l__d<2000 then
set n=CreateUnit(p,'e013',x+l__d*Cos(a),y+l__d*Sin(a),GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.55)
call SaveReal(h,id,5,l__d+80)
call UnitAddAbility(n,'Arav')
set n=CreateUnit(p,'e01A',x+l__d*Cos(a),y+l__d*Sin(a),a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.55)
call UnitAddAbility(n,'Arav')
call GroupEnumUnitsInRange(g,x+l__d*Cos(a),y+l__d*Sin(a),200,Base)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set l__ide=GetHandleId(E)
if Condition_Base(p,E)and IsUnitType(E,UNIT_TYPE_STRUCTURE)==false and E!=LoadUnitHandle(h,l__idg,l__ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,l__idg,l__ide,E)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\Purge\\PurgeBuffTarget.mdl",E,"chest"))
endif
call GroupRemoveUnit(g,E)
endloop
else
call DestroyTimer(t)
call DestroyGroup(g)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
set p=null
set u=null
set g=null
set t=null
endfunction
