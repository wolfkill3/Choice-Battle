function Trig_MoveHeroes_Conditions takes nothing returns boolean
return IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO)and cmb!=true
endfunction
function HealthClean takes nothing returns nothing
local unit u=GetTriggerUnit()
call UnitRemoveAbility(u,0x4230324E)
call UnitRemoveAbility(u,0x4230344A)
set u=null
endfunction
function Trig_MoveHeroes_Func009A takes nothing returns nothing
if GetOwningPlayer(GetEnumUnit())==GetOwningPlayer(GetTriggerUnit())and IsUnitType(GetEnumUnit(),UNIT_TYPE_HERO)==false and cmb!=true then
call RemoveUnit(GetEnumUnit())
endif
endfunction
function Trig_MoveHeroes_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p
local playercolor c
local real x=GetRectCenterX(gg_rct_Rect1)
local real y=GetRectCenterY(gg_rct_Rect1)
local trigger tt=CreateTrigger()
local integer id=GetPlayerId(GetOwningPlayer(u))
local integer i=0
local integer i2=0
local integer l__s=1
local boolean b=false
local integer ty=GetUnitTypeId(u)
local timer t=CreateTimer()
if cmb!=true and u!=null then
    call GroupEnumUnitsInRange(G,x,y,700,null)
    if pick==1 or pick==2 then
        call SetUnitOwner(u,Player(pick1),true)
    endif
    if rfhpick then
        call PickPreloadSystem(u)
    endif
    if pick!=3 then
        loop
        if GetUnitTypeId(u)==udg_RH[i2] then
            set udg_RH[i2]=0
        endif
        set i2=i2+1
        exitwhen i2==135
        endloop
        call SetUnitPosition(u,GetRectCenterX(gg_rct_Resp7),GetRectCenterY(gg_rct_Resp7))
        set p=GetOwningPlayer(u)
        set c=GetPlayerColor(p)
        set udg_Hero[GetPlayerId(p)+1]=null
        set Hero[GetPlayerId(p)]=null
        set udg_Hero[GetPlayerId(p)+1]=u
        set Hero[GetPlayerId(p)]=u
        call W3MMD_Lite_Set_Integer(p,"Picked_hero",HeroSkin(udg_Hero[GetPlayerId(p)+1]))
        call RemoveUnitFromAllStock(GetUnitTypeId(u))
        set udg_ExtraH[GetPlayerId(p)+1]=u
        if FFAMode==false then
            if GetPlayerColor(Player(0))==c or GetPlayerColor(Player(1))==c or GetPlayerColor(Player(2))==c or GetPlayerColor(Player(3))==c or GetPlayerColor(Player(4))==c then
                call GroupAddUnit(udg_CG[1],u)
            elseif GetPlayerColor(Player(8))==c or GetPlayerColor(Player(9))==c or GetPlayerColor(Player(5))==c or GetPlayerColor(Player(6))==c or GetPlayerColor(Player(7))==c then
                call GroupAddUnit(udg_CG[2],u)
            endif
        else
            call GroupAddUnit(udg_CG[4],u)
        endif
    endif
    call TriggerRegisterUnitStateEvent(tt,u,UNIT_STATE_LIFE,LESS_THAN,100)
    call TriggerAddAction(tt,function HealthClean)
    loop
        set E=FirstOfGroup(G)
        exitwhen E==null
        if GetOwningPlayer(u)==GetOwningPlayer(E)and IsUnitType(E,UNIT_TYPE_HERO)==false then
            call RemoveUnit(E)
        endif
        call GroupRemoveUnit(G,E)
    endloop
    if pick==1 then
        set TavernPlayerPickAllow[5]=false
        set TavernPlayerPickAllow[0]=true
        if GetLocalPlayer()==Player(0) then
            call SetFrameColourEx( TavernHeroPick,0, 0xFFFF2020 )
            call SetFrameColourEx( TavernHeroPick,1, 0xFFFF2020 )
            call SetFrameColourEx( TavernHeroPick,2, 0xFFFF2020 )
        endif
        if GetLocalPlayer()==Player(5) then
            call SetFrameColourEx( TavernHeroPick,0, 0xFF902020 )
            call SetFrameColourEx( TavernHeroPick,1, 0xFF902020 )
            call SetFrameColourEx( TavernHeroPick,2, 0xFF902020 )
        endif
    endif
    if pick==2 then
        set TavernPlayerPickAllow[0]=false
        set TavernPlayerPickAllow[5]=true
        if GetLocalPlayer()==Player(5) then
            call SetFrameColourEx( TavernHeroPick,0, 0xFFFF2020 )
            call SetFrameColourEx( TavernHeroPick,1, 0xFFFF2020 )
            call SetFrameColourEx( TavernHeroPick,2, 0xFFFF2020 )
        endif
        if GetLocalPlayer()==Player(0) then
            call SetFrameColourEx( TavernHeroPick,0, 0xFF902020 )
            call SetFrameColourEx( TavernHeroPick,1, 0xFF902020 )
            call SetFrameColourEx( TavernHeroPick,2, 0xFF902020 )
        endif
    endif
    if ty=='H04Z' then
        call TimerStart(t,0.1,false,function InitKakineAct)
    else
        call DestroyTimer(t)
    endif
    loop
    exitwhen i>11
        call SetPlayerTechMaxAllowed(Player(i),ty,0)
        set i=i+1
    endloop
endif
set tt=null
set t=null
set u=null
set c=null
endfunction
function InitTrig_MoveHeroes takes nothing returns nothing
set gg_trg_MoveHeroes=CreateTrigger()
call TriggerRegisterEnterRectSimple(gg_trg_MoveHeroes,gg_rct_Rect1)
call TriggerAddCondition(gg_trg_MoveHeroes,Condition(function Trig_MoveHeroes_Conditions))
call TriggerAddAction(gg_trg_MoveHeroes,function Trig_MoveHeroes_Actions)
endfunction
function Trig_SelectPlayerStatus_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p=GetTriggerPlayer()
local player p2=GetOwningPlayer(u)
local integer i=0
if IsPlayerAlly(p,p2) or GetPlayerId(p)==10 or GetPlayerId(p)==11 then
    loop
        exitwhen i>=12
        set P=p
        if GetPlayerId(p2)!=i then
            call HandleListForEach(StatusBarFrameList[i],function HideStatus)
        else
            call HandleListForEach(StatusBarFrameList[i],function ShowStatus)
        endif
        set i=i+1
    endloop
endif
if GetLocalPlayer()==p then
call ShowFrame( ClassBarFrame, true)
if IsPlayerAlly(p,p2) and p2!=Player(PLAYER_NEUTRAL_PASSIVE) then
call ShowFrame(GetFrameByName( "CustomLeaderboard", 0 ),false)
endif
set i=0
loop
call ShowFrame(GetFrameByName( "AbilityVarBarIcon", i ),false)
call ShowFrame( GetFrameByName( "AbilityBarIcon", i ), false)
set i=i+1
exitwhen i>12
endloop

set i=0
if GetUnitAbilityLevel(u,'Wome')>0 then
call ShowFrame(GetFrameByName( "ClassBarIcon", i ),true)
call ShowFrame( GetFrameByName( "ClassBarTooltip", i ), false)
call SetFrameTexture(GetFrameByName( "ClassBarIcon", i ), "ReplaceableTextures\\CommandButtons\\BTNLady.blp",0,false)
call SetFrameTexture(GetFrameByName( "ClassBarIcon", i ), "ReplaceableTextures\\CommandButtons\\BTNLady.blp",1,false)
call SetFrameTexture(GetFrameByName( "ClassBarIcon", i ), "ReplaceableTextures\\CommandButtons\\BTNLady.blp",2,false)
call SetFrameText( GetFrameByName("ClassBarTooltipText",i), GetAbilityBaseStringFieldById( String2Id( "Wome" ), ABILITY_SF_NAME )+", \n\n"+GetAbilityBaseStringFieldById( String2Id( "Wome" ), ABILITY_SLF_TOOLTIP_NORMAL_EXTENDED ))
call SetFrameSize( GetFrameByName("ClassBarTooltip",i), .16, GetFrameHeight( GetFrameByName("ClassBarTooltipText",i))+0.03)
