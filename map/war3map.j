function BigBangBeamCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local unit c=LoadUnitHandle(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local real f=GetUnitFacing(u)
local real speed=LoadReal(h,id,5)
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>speed+30 then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SaveReal(h,id,5,speed+0.8)
call SetUnitFacing(l__d,a*bj_RADTODEG)
set n=CreateUnit(p,'e0C0',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,1)
call UnitApplyTimedLife(CreateUnit(p,'e0C2',x,y,GetRandomReal(0,359)),1,1)
else
call UnitApplyTimedLife(CreateUnit(p,'e0C4',x,y,(a*bj_RADTODEG)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0C5',x,y,(a*bj_RADTODEG)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0CC',x,y,(a*bj_RADTODEG)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0CD',x,y,(a*bj_RADTODEG)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0C6',x,y,(a*bj_RADTODEG)),1,4)
call UnitApplyTimedLife(CreateUnit(p,'e0C7',x,y,(a*bj_RADTODEG)),1,6)
call StartSound(soundStr[47])
call myCustomDamage(u,c,(GetUnitAbilityLevel(u,'A0RE')+1)*GetHeroAgi(u,true)+50,false,false,null,null,null)
call SetControlToUnit(u,c,2, "stun")
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
endif
set p=null
set u=null
set l__d=null
set t=null
set c=null
endfunction
function BigBangBeamCast takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real f=GetUnitFacing(u)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,5,37)
call SaveUnitHandle(h,id,1,CreateUnit(GetOwningPlayer(u),'e0C1',GetUnitX(u)+50.*Cos(f*bj_DEGTORAD),GetUnitY(u)+50.*Cos(f*bj_DEGTORAD),f))
call SaveUnitHandle(h,id,2,GetSpellTargetUnit())
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
    set soundplay=CreateSound("Sound\\Music\\mp3Music\\BigBangBeam.mp3",false,false,true,12700,12700,"")
else
    set soundplay=CreateSound("Sound\\Music\\mp3Music\\Vegitto\\BigBangBeam-jap.mp3",false,false,true,12700,12700,"")
endif
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.025,true,function BigBangBeamCast2)
set u=null
set t=null
endfunction
