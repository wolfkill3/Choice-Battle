function KickPlayerTimedAct takes nothing returns nothing
local integer ip=GetPlayerId(GetTriggerPlayer())
local integer id=GetHandleId(Hero[ip])
local integer p = S2I(SubString(GetEventPlayerChatString(), 5, 6))-1
local real waiting_time = S2R(SubString(GetEventPlayerChatString(), 7, 15))
call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "Player: "+I2S(p))
call BJDebugMsg(R2S(waiting_time))
if p>=0 and p<10 then
        set bjLCT = CreateTimer()
        set id = GetHandleId(bjLCT)
        call SaveInteger(h, id, StringHash("PlayerID"), p)
        call SavePlayerHandle(h, id, StringHash("TriggerPlayer"), GetTriggerPlayer())
        call SaveReal(h, GetHandleId(Player(p)), StringHash("WaitingTime"), waiting_time)
        call TimerStart(bjLCT, 0.5, true, function KickPlayerTimedAct2)
endif
set bjLCT=null
endfunction
function KickPlayerTimedOffAct takes nothing returns nothing
local integer ip=GetPlayerId(GetTriggerPlayer())
local integer id=GetHandleId(Hero[ip])
local integer p = S2I(SubString(GetEventPlayerChatString(), 5, 6))-1
local real waiting_time = S2R(SubString(GetEventPlayerChatString(), 7, 15))
local integer i=0
loop
exitwhen i>=10
        call SaveReal(h, GetHandleId(Player(i)), StringHash("WaitingTime"), -99)
        set i=i+1
endloop
call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "KPT clear")
endfunction
function RemoveTransformation takes unit u returns nothing
if GetUnitTypeId(u)=='H04B' then
    call PauseUnit(u,false)
    call UnitRemoveBuffs(u,false,true)
    call ShowAbility2('A23V',false)
    call ShowAbility2Timed('A13V',true,0.1)
    call UnitAddAbility(u,'S005')
    call IssueImmediateOrder(u, "bearform")
    call UnitRemoveAbility(u,'S005')
    call SetUnitAbilityLevel(u,'A0U8',1)
endif
if GetUnitTypeId(u) == 'HMaG' then      // Madoka Goddess обратно в обычную 
    call PauseUnit(u, false)
    call ShowAbility2( 'MaT1' , true)
    call ShowAbility2( 'MaE1' , true)
    call ShowAbility2( 'MadR' , true)
    call UnitRemoveAbility(u, 'MaE2')
    call UnitRemoveAbility(u, 'MaR2')
    call UnitAddAbility(u, 'MaF4')
    call IssueImmediateOrder(u, "bearform")
    call UnitRemoveAbility(u, 'MaF4')
    call SetUnitInvulnerable(u, true)
    if LoadInteger(HH,GetPlayerId(GetOwningPlayer(u)),10)!=1  and LoadUnitHandle(HH,GetPlayerId(GetOwningPlayer(u)),StringHash("kyubei"))==null then
        set bjLCT=CreateTimer()
        call SaveInteger(HH,GetHandleId(bjLCT),0,GetPlayerId(GetOwningPlayer(u)))
        call SaveInteger(HH,GetPlayerId(GetOwningPlayer(u)),10,1)
        call SaveUnitHandle(HH,GetPlayerId(GetOwningPlayer(u)),StringHash("kyubei"),CreateUnit(GetOwningPlayer(u),'dM57',GetUnitX(u)+GetRandomReal(-100,100),GetUnitY(u)+GetRandomReal(-100,100),GetRandomReal(6.28,0)))
        call TimerStart(bjLCT,0.1,true,function MadokaKyubei2)
        set bjLCT=null
    endif
endif

