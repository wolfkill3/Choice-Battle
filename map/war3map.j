function Trig_Katon_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local unit d1=LoadUnitHandle(h,id,6)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local group g=LoadGroupHandle(h,id,4)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,5)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroAgi(u,true)*GetUnitAbilityLevel(u,'A006')+75*GetUnitAbilityLevel(u,'A006')
local real dmg2=(0.75+0.25*GetUnitAbilityLevel(u,'A006'))*GetHeroAgi(u,true)
if SR(x,y,x1,y1)<=2250 then
set x1=x1+52*Cos(a)
set y1=y1+52*Sin(a)
