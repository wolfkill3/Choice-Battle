local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local boolean bPaused=false
local real damage=75+((1+GetUnitAbilityLevel(u,'A16F'))*GetHeroStr(u,true))
set soundplay=SndN(2474) // Sound\Music\mp3Music\Touma1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SetControlToUnit(u,c,2, "stun")
call Push(c,50,LoadReal(h,id,9),300)
call UnitApplyTimedLife(CreateUnit(p,'e0SA',x1,y1,a*bj_RADTODEG),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0SB',x1,y1,a*bj_RADTODEG),'BTLF',2)
