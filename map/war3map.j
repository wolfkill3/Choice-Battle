local real y1=GetUnitY(LoadUnitHandle(HH,id,20))
local group gr=null
set time=time+0.02
call SaveReal(HH,id,5,time)
if time==6.3 then
if LoadGroupHandle(HH,id,4)!=null then
call DestroyGroup(LoadGroupHandle(HH,id,4))
call SaveGroupHandle(HH,id,4,null)
endif
call RemoveUnit(LoadUnitHandle(HH,id,20))
call RemoveUnit(LoadUnitHandle(HH,id,21))
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else
if time==0.02 then
call SaveInteger(HH,id,17,GetHeroStr(caster,true))
call SaveGroupHandle(HH,id,4,CreateGroup())
set soundplay=SndN(3933) // Sound\Music\mp3Music\AizenE1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",facing,1.5,0.8+0.006*LoadInteger(HH,id,17),1,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\WindNewFaw4.mdl",facing,1.5,0.6+0.0045*LoadInteger(HH,id,17),0.75,100,100,100,0,0,caster,0,facing)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
call SetUnitModel(n0,"Others\\HakkeStart2.mdl")
call UnitSize(n0,0.6+0.006*LoadInteger(HH,id,17),1,1)
call UnitSpeed(n0,0.75)
call UnitColor(n0,100,100,100,40)
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call SetUnitFlyHeight(n0,0,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=null
call UnitSpeed(caster,1)
if GetUnitTypeId(caster)=='H12M' then
call SetUnitAnimationByIndex(caster,17)
else
call SetUnitAnimationByIndex(caster,14)
endif
endif
if time>0.02 and time<0.3 then
call PauseUnit(caster,true)
endif
if time==0.3 then
call PauseUnit(caster,false)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',x1,y1,facing)
call SetUnitModel(n0,"Aizen\\bankaimess-XunHuan.mdl")
call UnitSize(n0,0.14+0.002*LoadInteger(HH,id,17),1,1)
call UnitSpeed(n0,0.75)
call UnitColor(n0,100,100,100,0)
call SetUnitFlyHeight(n0,0,0)
call SaveUnitHandle(HH,id,21,n0)
set n0=null
endif
if time==0.5 then
call UnitSpeed(LoadUnitHandle(HH,id,20),0)
endif
if time>0.3 and time<=6.3 then
call MoveUnit(caster,LoadUnitHandle(HH,id,20),0,facing)
call MoveUnit(caster,LoadUnitHandle(HH,id,21),0,facing)
set gr=LoadGroupHandle(HH,id,4)
call GroupClear(G)
call GroupEnumUnitsInRange(G,x1,y1,300+LoadInteger(HH,id,17)*3,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if IsUnitInGroup(n0,gr)==false and IsUnitEnemy(n0,GetOwningPlayer(caster))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false then
call UnitAddAbility(n0,'ASE3')
call GroupAddUnit(gr,n0)
endif
call GroupRemoveUnit(G,n0)
endloop
call SaveGroupHandle(HH,id,4,gr)
call ForGroup(gr,function AizenESlow)
call GroupClear(G)
endif
if time==2 then
call ChangeAbilityTime(caster,4.3,'ASE1','ASE2')
endif
endif
set caster=null
set gr=null
set casterOriginal=null
endfunction
function AizenE2Act takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit target=LoadUnitHandle(HH,id,2)
local unit casterOriginal=LoadUnitHandle(HH,id,30)
local real x0=GetUnitX(caster)
local real y0=GetUnitY(caster)
local real x1=GetUnitX(target)
local real y1=GetUnitY(target)
local real facing=Angle2(x0,y0,x1,y1)
local real time=LoadReal(HH,id,5)
local real distance=LoadReal(HH,id,8)
local real facingNew=0
local real facingNew1=0
local real damage=LoadReal(HH,id,15)
local integer HogCond=LoadInteger(HH,id,16)
local group gr=null
set time=time+0.02
call SaveReal(HH,id,5,time)
if time==1 then
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else
if time==0.02 then
set soundplay=SndN(3936) // Sound\Music\mp3Music\AizenE3.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call UnitSpeed(caster,1)
call SetUnitAnimationByIndex(caster,15)
endif
if time==0.2 then
call UnitRemoveAbility(caster,'ASE2')
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),'ASE1',true)
set soundplay=SndN(3939) // Sound\Music\mp3Music\AizenE2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SetUnitAnimationByIndex(caster,16)
call UnitSpeed(caster,1.5)
call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",facing,1,0.5,1.25,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"Others\\BlackBlink1.mdl",facing,1,1,1,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"Others\\HakkeStart2.mdl",facing,1.5,0.5,0.5,100,100,100,60,0,caster,0,facing)
call MoveUnit(target,caster,-150,facing)
call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",facing,1,1,1.25,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"Others\\HakkeStart2.mdl",facing,1.5,1.5,0.5,100,100,100,60,0,caster,0,facing)
set n0=CreateUnit(GetOwningPlayer(caster),'270e',GetUnitX(caster),GetUnitY(caster),facing+90)
call SetUnitModel(n0,"BlackGoku\\AnimeSlashFinal.mdl")
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call UnitSize(n0,1.5,1,1)
call UnitSpeed(n0,0.5)
call UnitColor(n0,100,70,70,0)
call SetUnitFlyHeight(n0,200,0)
call MyRemoveUnit(n0,1)
set n0=null
endif
if time>0.2 and time<0.5 then
call MoveUnit(target,caster,-150,facing)
if LoadBoolean(HH,GetHandleId(target),ANTITARGET_ABILITY)==false then
call PauseUnit(target,true)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
call SetUnitInvulnerable(target,true)
else
call SetUnitPathing(caster,true)
call UnitSpeed(caster,1)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
call SaveBoolean(HH,GetHandleId(caster),DASH_USER,false)
call SaveUnitHandle(HH,GetHandleId(target),REVERSE_TARGET,caster)
endif
endif
if time<0.5 then
call SetUnitPathing(caster,false)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
endif
if time==0.5 then
call UnitSpeed(caster,1)
call SetUnitPathing(caster,true)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
call PauseUnit(target,false)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
call SetUnitInvulnerable(target,false)
if HogCond==1 then



call myCustomDamage(casterOriginal,target,damage,false,false,null,null,null)


call EffectCreateAndMove(true,"Sabrac\\File00003933.mdl",facing,1,1.25,1.25,100,100,100,0,50,target,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",facing,1.5,1.25,1.25,100,100,100,0,50,target,0,facing)
