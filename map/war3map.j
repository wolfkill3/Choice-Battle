call UnitApplyTimedLife(n,'BTLF',0.1)
set i=i+1
endloop
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
if f>=5 then
call SetControlToUnit(u,E,1.5,"stun")
endif
call myCustomDamage(u,E,(8+f)*GetHeroInt(u,true),false,false,null,null,null)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\LightningWrath.mdx",E,"origin"))
call DestroyEffect(AddSpecialEffect(" ",GetUnitX(E),GetUnitY(E)))
endif
call GroupRemoveUnit(G,E)
endloop
call DestroyLightning(l)
call DestroyTimer(t)
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
endif
set l=null
set u=null
set l__d=null
set p=null
    set t=null
endfunction
