function QShikiThreeCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=LoadUnitHandle(HH,GetHandleId(u),SH_SKQ)
local real dmg=GetHeroAgi(u,true)*(0.95+0.15*GetUnitAbilityLevel(u,'A1BR'))+20
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local integer idu=GetHandleId(u)
local integer idp=GetHandleId(p)
local real x1=0
local real y1=0
local real sc=0
local real a=GetUnitFacing(u)*bj_DEGTORAD
if c==null then
    set c=LoadUnitHandle(HH,GetHandleId(u),SH_SKR)
endif
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
    call SaveUnitHandle(HH,idu,SH_Q3,c)
    if GetUnitAbilityLevel(u,'A2CM')>0 then
        call UnitRemoveAbility(u,'A2CM')
        call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A23W',false)
        call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1BU',true)
        call RemoveSavedHandle(HH,idu,SH_SKE)
    endif
    set x1=x+100*Cos(a)
    set y1=y+100*Sin(a)
    set n=CreateUnit(p,'e116',x1,y1,GetRandomReal(0,359))
    call SetUnitVertexColor(n,255,255,255,GetRandomInt(50,255))
    set sc=GetRandomReal(0.5,3)
    call SetUnitScale(n,sc,sc,sc)
    call UnitApplyTimedLife(n,'BTLF',0.7)
    call SetUnitTimeScale(n,2.5)
    set n=CreateUnit(p,'e116',x1,y1,GetRandomReal(0,359))
    call SetUnitVertexColor(n,255,255,255,GetRandomInt(50,255))
    set sc=GetRandomReal(0.5,3)
    call SetUnitScale(n,sc,sc,sc)
    call UnitApplyTimedLife(n,'BTLF',0.7)
    call SetUnitTimeScale(n,2.5)
    set n=CreateUnit(p,'e116',x1,y1,GetRandomReal(0,359))
    call SetUnitVertexColor(n,255,255,255,GetRandomInt(50,255))
    set sc=GetRandomReal(0.5,3)
    call SetUnitScale(n,sc,sc,sc)
    call UnitApplyTimedLife(n,'BTLF',0.7)
    call SetUnitTimeScale(n,2.5)
    set n=CreateUnit(p,'e116',x1,y1,GetRandomReal(0,359))
    call SetUnitVertexColor(n,255,255,255,GetRandomInt(50,255))
    set sc=GetRandomReal(0.5,3)
    call SetUnitScale(n,sc,sc,sc)
    call UnitApplyTimedLife(n,'BTLF',0.7)
    call SetUnitTimeScale(n,2.5)
    set n=CreateUnit(p,'e11H',x,y,a*bj_RADTODEG)
    call SetUnitVertexColor(n,255,255,255,155)
    call UnitApplyTimedLife(n,'BTLF',0.4)
    call SetUnitTimeScale(n,2)
    set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG-30)
    call SetUnitVertexColor(n,255,255,255,155)
    call UnitApplyTimedLife(n,'BTLF',0.4)
    call SetUnitTimeScale(n,3)
    set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+30)
    call SetUnitVertexColor(n,255,255,255,155)
    call UnitApplyTimedLife(n,'BTLF',0.4)
    call SetUnitTimeScale(n,3)
    set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG)
    call SetUnitVertexColor(n,255,255,255,155)
    call UnitApplyTimedLife(n,'BTLF',0.4)
    call SetUnitTimeScale(n,3)
    call SaveUnitHandle(HH,id,0,u)
    call SaveUnitHandle(HH,id,1,c)
    call SaveReal(HH,id,2,0)
    call SaveReal(HH,id,4,0)
    call SaveReal(HH,id,8,0)
    call SaveReal(HH,id,3,a)
    call UnitAddAbility(u,'A1BI')
    call UnitMakeAbilityPermanent(u,true,'A1BI')
    call SaveReal(HH,idu,ComboTimerHash,2)
    call SetUnitTimeScale(LoadUnitHandle(HH,idp,ComboBarHash),1000000)
    call ComboBar(u,0)
    call SaveInteger(HH,idu,ComboCounterHash,LoadInteger(HH,idu,ComboCounterHash)+1)
    call UnitAddAbility(c,'A1BJ')
    call UnitAddAbility(u,'A1BK')
    call UnitAddAbility(u,'Arav')
    call UnitRemoveAbility(u,'Arav')
    call SetControlToUnit(u,c,0.3, "stun")
    if LoadInteger(HH,idu,ComboCounterHash)>5 and LoadInteger(HH,idu,ComboCounterHash)<8 then
        call SetUnitColor(LoadUnitHandle(HH,idp,ComboBarHash),PLAYER_COLOR_PURPLE)
    elseif LoadInteger(HH,idu,ComboCounterHash)>7 then
        call SetUnitColor(LoadUnitHandle(HH,idp,ComboBarHash),PLAYER_COLOR_RED)
        if LoadUnitHandle(HH,idu,SH_CST)==null then
            call SaveUnitHandle(HH,idu,SH_CST,CreateUnit(p,'h06A',x,y,0))
        endif
    endif
    call PauseUnit(c,true)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
    if LoadInteger(HH,idu,ComboCounterHash)>5 and GetUnitAbilityLevel(u,'A1BN')==0 then
        call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1BU',false)
        call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1BV',true)
    endif
    if LoadInteger(HH,idu,ComboCounterHash)>2 then
        call SetAbilityIntegerLevelField(GetUnitAbility(u,'A1BZ'), ABILITY_ILF_TARGET_TYPE,0,1)
        call SetAbilityRealLevelField(GetUnitAbility(u,'A1BZ'), ABILITY_RLF_CAST_RANGE,0,1400)
    endif
    call TimerStart(t,0.02,true,function QShikiThreeCast2)
    set soundplay=SndN(2611) // Sound\Music\mp3Music\NanayaQ2.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call SetWidgetMana(u, GetWidgetMana(u)-GetWidgetMaxMana(u)*LoadInteger(HH,idu,ComboCounterHash)*0.005)
    call PauseUnit(u,true)
    call SetUnitInvulnerable(u,true)
    call SetUnitAnimation(u,"Spell six")
else
    call PauseUnit(u,false)
    call SetUnitInvulnerable(u,false)
    call PauseUnit(c,false)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
    call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
    call SaveReal(HH,idu,ComboTimerHash,0)
    call SaveInteger(HH,idu,ComboCounterHash,0)
    call SetUnitTimeScale(LoadUnitHandle(HH,idp,ComboBarHash),-10000000)
    call SetUnitTurnSpeed(u,1.00)
    call SetUnitTimeScale(u,1)
    call PauseTimer(t)
    call DestroyTimer(t)
    call SetUnitVertexColor(u,255,255,255,255)
    call UnitRemoveAbility(u,'A1BK')
    call SetUnitFlyHeight(c,0,0)
    call SetUnitFlyHeight(u,0,0)
    call FlushChildHashtable(HH,id)
endif
set c=null
set u=null
set p=null
set t=null
endfunction
function InitTrig_QShikiThree takes nothing returns nothing
set gg_trg_QShikiThree=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_QShikiThree,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_QShikiThree,Condition(function QShikiThreeCond))
call TriggerAddAction(gg_trg_QShikiThree,function QShikiThreeCast)
endfunction
function SlashNanayaCond takes nothing returns boolean
return GetSpellAbilityId()=='A1BS'
endfunction
function MissleMoveNanayaSlash2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local unit u=LoadUnitHandle(h,id,7)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
local real dist=LoadReal(h,id,6)
local real time=LoadReal(h,id,8)
local real mh=LoadReal(h,id,5)
local real rd=SR(x,y,x1,y1)
local player p=GetOwningPlayer(u)
local integer idu=GetPlayerId(p)
if rd>20+speed and udg_B==true and rd<601 and GetUnitAbilityLevel(l__d,'A1BL')==0 and time<2 then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,ParabolaZ(mh,dist,rd),0)
call SaveReal(h,id,8,time+0.03)
else
if GetUnitAbilityLevel(l__d,'A1BL')==0 then
call SetUnitFlyHeight(l__d,0,0)
endif
call SetUnitPathing(l__d,true)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set p=null
set l__d=null
set t=null
endfunction
function MissleMoveNanayaSlash takes unit l__d,real speed,real angle,real x,real y,real mh,unit u returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SetUnitPathing(l__d,false)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,mh)
call SaveReal(h,id,6,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveUnitHandle(h,id,7,u)
call SaveReal(h,id,8,0)
call TimerStart(t,0.03,true,function MissleMoveNanayaSlash2)
set t=null
endfunction
function SlashNanayaCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(HH,id,0)
    local unit l__d=LoadUnitHandle(HH,id,1)
    local integer idu=GetHandleId(u)
    local real dmg=GetHeroAgi(u,true)*(1.5+0.5*GetUnitAbilityLevel(u,'A1BS'))*0.05
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real a=LoadReal(HH,id,3)
    local real cb=LoadInteger(HH,id,4)
    local real dist=LoadReal(HH,id,2)
    local group g=LoadGroupHandle(HH,id,5)
    local group g2
    local group g3=CreateGroup()
    local player p=GetOwningPlayer(u)
    local integer idp=GetHandleId(p)
    if dist>0 and LoadBoolean(HH,GetHandleId(u),DASH_USER)==true then
        if LoadReal(HH,id,6)==0 then
            if IsTerrainPathable(GetUnitX(u),GetUnitY(u),PATHING_TYPE_FLYABILITY)==false  then
                set x=x+25*Cos(a)
                set y=y+25*Sin(a)
            endif
        else
            if IsTerrainPathable(GetUnitX(u),GetUnitY(u),PATHING_TYPE_FLYABILITY)==false  then
                set x=x+53*Cos(a)
                set y=y+53*Sin(a)
            endif
        endif
        call PauseUnit(u,true)
        set n=CreateUnit(p,'e11F',x,y,a*bj_RADTODEG)
        call SetUnitVertexColor(n,255,255,255,75)
        call UnitApplyTimedLife(n,'BTLF',0.2)
        call SetUnitAnimation(n,"spell two")
        call SetUnitFacing(u,a*bj_RADTODEG)
        call SetUnitXY_1(l__d,x,y, false)
        call SetUnitXY_1(u,x,y, false)
        if LoadReal(HH,id,6)==0 then
            set n=CreateUnit(p,'e0ZG',x+GetRandomReal(73,77)*Cos(a+bj_PI/2),y+GetRandomReal(73,77)*Sin(a+bj_PI/2),a*bj_RADTODEG+GetRandomReal(-5,5))
            call SetUnitVertexColor(n,155,75,255,255)
            call SetUnitFlyHeight(n,GetRandomReal(190,210),0)
            call UnitApplyTimedLife(n,'BTLF',0.2)
            call SetUnitScale(n,1.2,1.2,1.2)
            call SetUnitTimeScale(n,3)
            set n=CreateUnit(p,'e0ZF',x+GetRandomReal(73,77)*Cos(a+bj_PI/2),y+GetRandomReal(73,77)*Sin(a+bj_PI/2),a*bj_RADTODEG+GetRandomReal(-5,5))
            call SetUnitVertexColor(n,155,75,255,255)
            call SetUnitFlyHeight(n,GetRandomReal(90,110),0)
            call UnitApplyTimedLife(n,'BTLF',0.2)
            call SetUnitScale(n,1.2,1.2,1.2)
            call SetUnitTimeScale(n,3)
        else
            call SetUnitTimeScale(u,0.4)
            set soundplay=SndN(2525) // Sound\Music\mp3Music\ShikiSlash2.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            if dist==0.1 or dist==0.3 then
                set n=CreateUnit(p,'e0ZF',x+GetRandomReal(73,77)*Cos(a+bj_PI/2),y+GetRandomReal(73,77)*Sin(a+bj_PI/2),a*bj_RADTODEG+GetRandomReal(-5,5))
                call SetUnitVertexColor(n,155,75,255,255)
                call SetUnitFlyHeight(n,GetRandomReal(90,110),0)
                call UnitApplyTimedLife(n,'BTLF',0.2)
                call SetUnitScale(n,1.2,1.2,1.2)
                call SetUnitTimeScale(n,3)
            else
                if dist==0.2 or dist==0.4 then
                    set n=CreateUnit(p,'e0ZG',x+GetRandomReal(73,77)*Cos(a+bj_PI/2),y+GetRandomReal(73,77)*Sin(a+bj_PI/2),a*bj_RADTODEG+GetRandomReal(-5,5))
                    call SetUnitVertexColor(n,155,75,255,255)
                    call SetUnitFlyHeight(n,GetRandomReal(190,210),0)
                    call UnitApplyTimedLife(n,'BTLF',0.2)
                    call SetUnitScale(n,1.2,1.2,1.2)
                    call SetUnitTimeScale(n,3)
                endif
            endif
        endif
        call SaveReal(HH,id,2,dist-0.05)
        call GroupEnumUnitsInRange(G,x+140*Cos(a),y+140*Sin(a),210,Base)
        loop
            set E=FirstOfGroup(G)
            exitwhen E==null
            if Condition_Base(p,E)then
                if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
                    call GroupAddUnit(g3,E)
                    if IsUnitInvulnerable(E)==false then
                        call IssueImmediateOrder(E,"stop")
                    endif
                    if LoadReal(HH,id,6)==0 then
                        if IsTerrainPathable(GetUnitX(E)+28*Cos(a),GetUnitY(E)+28*Sin(a),PATHING_TYPE_FLYABILITY)==false  then
                            call SetUnitPathing(E,false)
                            call SetUnitXY_1(E,GetUnitX(E)+28*Cos(a),GetUnitY(E)+28*Sin(a), false)
                        endif
                    else
                        if IsTerrainPathable(GetUnitX(E)+59*Cos(a),GetUnitY(E)+59*Sin(a),PATHING_TYPE_FLYABILITY)==false  then
                            call SetUnitPathing(E,false)
                            call SetUnitXY_1(E,GetUnitX(E)+59*Cos(a),GetUnitY(E)+59*Sin(a), false)
                        endif
                    endif
                    if GetUnitAbilityLevel(E,'A1BJ')==0 then
                        call UnitAddAbility(E,'A1BJ')
                        call GroupAddUnit(g,E)
                    endif
                    if LoadReal(HH,id,6)==0 then
                        call EffectToRandomBone("war3mapImported\\SlashEffectRed by Deckai.mdx",E)
                        call SetControlToUnit(E,E, 0.5, "stun")
                        if GetUnitFlyHeight(E)>50 and GetHeroLevel(u)>=6 then
                            if GetUnitAbilityLevel(E,'A1BJ')>0 and IsUnitPaused(E)==true then
                                call PauseUnit(E,false)
                                call myCustomDamage(u,E,dmg*1.25,false,false,null,null,null)
                                call PauseUnit(E,true)
                            else
                                call myCustomDamage(u,E,dmg*1.25,false,false,null,null,null)
                            endif
                        else
                            if GetUnitAbilityLevel(E,'A1BJ')>0 and IsUnitPaused(E)==true then
                                call PauseUnit(E,false)
                                call myCustomDamage(u,E,dmg,false,false,null,null,null)
                                call PauseUnit(E,true)
                            else
                                call myCustomDamage(u,E,dmg,false,false,null,null,null)
                            endif
                        endif
                    else
                        if dist==0.1 or dist==0.2 or dist==0.3 or dist==0.4 then
                            call SetControlToUnit(E,E, 1, "stun")
                            call SaveUnitHandle(HH,id,3,E)
                            call SaveUnitHandle(HH,idp,SH_EW,E)
                            if GetUnitAbilityLevel(u,'A34Z')==0 then
                                call UnitAddAbility(u,'A34Z')
                                call UnitRemoveAbilityTimedPause(u,'A34Z',0.6)
                            endif
                            call EffectToRandomBone("war3mapImported\\SlashEffectRed by Deckai.mdx",E)
                            if GetUnitFlyHeight(E)>50 and GetHeroLevel(u)>=6 then
                                if GetUnitAbilityLevel(E,'A1BJ')>0 and IsUnitPaused(E)==true then
                                    call PauseUnit(E,false)
                                    call myCustomDamage(u,E,2*dmg*1.25,false,false,null,null,null)
                                    call PauseUnit(E,true)
                                else
                                    call myCustomDamage(u,E,2*dmg*1.25,false,false,null,null,null)
                                endif
                            else
                                if GetUnitAbilityLevel(E,'A1BJ')>0 and IsUnitPaused(E)==true then
                                    call PauseUnit(E,false)
                                    call myCustomDamage(u,E,2*dmg,false,false,null,null,null)
                                    call PauseUnit(E,true)
                                else
                                    call myCustomDamage(u,E,2*dmg,false,false,null,null,null)
                                endif
                            endif
                        endif
                    endif
                    if cb==0 then
                        call UnitAddAbility(u,'A1BI')
                        call SaveReal(HH,idu,ComboTimerHash,2)
                        call SaveInteger(HH,idu,ComboCounterHash,LoadInteger(HH,idu,ComboCounterHash)+1)
                        call TextTagFull2(I2S(LoadInteger(HH,idu,ComboCounterHash))+" x COMBO!",x,y,175,75,255,255,p,0.023+0.001*LoadInteger(HH,idu,ComboCounterHash))
                        call SaveInteger(HH,id,4,1)
                        set cb=1
                        call SetUnitTimeScale(LoadUnitHandle(HH,idp,ComboBarHash),1000000)
                        call ComboBar(u,0)
                        if LoadInteger(HH,idu,ComboCounterHash)>5 and GetUnitAbilityLevel(u,'A1BN')==0 then
                            call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1BU',false)
                            call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1BV',true)
                        endif
                        if LoadInteger(HH,idu,ComboCounterHash)>2 then
                            call SetAbilityIntegerLevelField(GetUnitAbility(u,'A1BZ'), ABILITY_ILF_TARGET_TYPE,0,1)
                            call SetAbilityRealLevelField(GetUnitAbility(u,'A1BZ'), ABILITY_RLF_CAST_RANGE,0,1400)
                        endif
                        if LoadInteger(HH,idu,ComboCounterHash)>5 and LoadInteger(HH,idu,ComboCounterHash)<8 then
                            call SetUnitColor(LoadUnitHandle(HH,idp,ComboBarHash),PLAYER_COLOR_PURPLE)
                        elseif LoadInteger(HH,idu,ComboCounterHash)>7 then
                            call SetUnitColor(LoadUnitHandle(HH,idp,ComboBarHash),PLAYER_COLOR_RED)
                            if LoadUnitHandle(HH,idu,SH_CST)==null then
                                call SaveUnitHandle(HH,idu,SH_CST,CreateUnit(p,'h06A',x,y,0))
                            endif
                        endif
                    endif
                else
                    call SaveBoolean(HH,GetHandleId(u),DASH_USER,false)
                    call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,u)
                    call SaveReal(HH,idu,ComboTimerHash,0)
                    call SaveInteger(HH,idu,ComboCounterHash,0)
                    call SetUnitTimeScale(LoadUnitHandle(HH,idp,ComboBarHash),-10000000)
                endif
            endif
            call GroupRemoveUnit(G,E)
        endloop
        set g2=CopyGroup(g)
        loop
            set E=FirstOfGroup(g2)
            exitwhen E==null
            if IsUnitInGroup(E,g3)==false and IsUnitInGroup(E,g2)==true then
                call UnitRemoveAbility(E,'A1BJ')
                call SetUnitPathing(E,true)
                call GroupRemoveUnit(g,E)
            endif
            call GroupRemoveUnit(g2,E)
        endloop
        call DestroyGroupTimed(g2,3)
        call GroupClear(g3)
    else
        call SaveBoolean(HH,GetHandleId(u),DASH_USER,false)
        loop
            set E=FirstOfGroup(g)
            exitwhen E==null
            call UnitRemoveAbility(E,'A1BJ')
            call SetUnitPathing(E,true)
            call GroupRemoveUnit(g,E)
        endloop
        call SetUnitTimeScale(u,1)
        call UnitRemoveAbility(u,'A195')
        call UnitRemoveAbility(u,'A1BI')
        call ComboBar(u,-0.5)
        call RemoveUnit(l__d)
        call DestroyGroup(g3)
        call DestroyGroup(g)
        call PauseUnit(u,false)
        call IssueImmediateOrder(u,"stop")
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(HH,id)
    endif
    set g=null
    set g2=null
    set g3=null
    set l__d=null
    set u=null
    set p=null
    set t=null
    endfunction
function SlashNanayaCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local integer idu=GetHandleId(u)
local integer idp=GetHandleId(p)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local real time=0
call SaveBoolean(HH,GetHandleId(u),DASH_USER,true)
call SaveGroupHandle(HH,id,5,CreateGroup())
call SaveUnitHandle(HH,id,0,u)
if GetUnitAbilityLevel(GetTriggerUnit(),'A23Z')>0 then
call UnitAddAbility(u,'A33Z')
call UnitRemoveAbilityTimed(u,'A33Z',0.7)
set time=0.4
call SaveReal(HH,id,6,1)
set soundplay=SndN(2613) // Sound\Music\mp3Music\NanayaEW.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
call SaveReal(HH,id,6,0)
if 0.5+LoadInteger(HH,idu,ComboCounterHash)*0.5>2 then
set time=2
set soundplay=SndN(2616) // Sound\Music\mp3Music\Hattenshou.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
set time=0.5+LoadInteger(HH,idu,ComboCounterHash)*0.5
set soundplay=SndN(2619) // Sound\Music\mp3Music\HattenshouMini.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
endif
call SetWidgetMana(u, GetWidgetMana(u)-GetWidgetMaxMana(u)*LoadInteger(HH,idu,ComboCounterHash)*0.005)
call SaveReal(HH,id,2,time)
call SaveReal(HH,id,3,a)
call SaveInteger(HH,id,4,0)
call PauseUnit(u,true)
call UnitAddAbility(u,'A2BM')
call UnitRemoveAbilityTimed(u,'A2BM',5)
set n=CreateUnit(p,'e0RV',x,y,a*bj_RADTODEG)
call SaveUnitHandle(HH,id,1,n)
call SetUnitVertexColor(n,255,255,255,255)
call SetUnitTimeScale(n,0.7)
call SetUnitAnimation(u,"spell two")
call UnitAddAbility(u,'A195')
call TimerStart(t,0.05,true,function SlashNanayaCast2)
set u=null
set p=null
set t=null
endfunction
function InitTrig_SlashNanaya takes nothing returns nothing
set gg_trg_SlashNanaya=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_SlashNanaya,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_SlashNanaya,Condition(function SlashNanayaCond))
call TriggerAddAction(gg_trg_SlashNanaya,function SlashNanayaCast)
endfunction
function LearnEShikiCond takes nothing returns boolean
return GetLearnedSkill()=='A1BT'
endfunction
function EShikiPause takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local integer idu=GetHandleId(u)
local real time=LoadReal(HH,GetHandleId(GetOwningPlayer(u)),SH_CE)
if time>0 and GetUnitAbilityLevel(u,'A1BN')>0 then
call SaveReal(HH,GetHandleId(GetOwningPlayer(u)),SH_CE,time-0.1)
//call ConsolePrint(R2S(time)+"\n")
elseif time<=0.2 and GetUnitAbilityLevel(u,'A1BN')>0 then
//call ConsolePrint("end\n")
call UnitRemoveAbility(u,'A1BN')
endif
set u=null
set t=null
endfunction
function LearnEShikiCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local integer idu=GetHandleId(u)
local integer idp=GetHandleId(p)
local integer lvl=GetUnitAbilityLevel(u,'A1BT')
local timer tc
if lvl==1 and u==Hero[GetPlayerId(p)] then
call SaveReal(HH,GetHandleId(GetOwningPlayer(u)),SH_CE,0)
call SaveUnitHandle(HH,id,0,u)
call UnitAddAbility(u,'A1BU')
call UnitMakeAbilityPermanent(u,true,'A1BU')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1BU',true)
call UnitAddAbility(u,'A1BV')
call UnitMakeAbilityPermanent(u,true,'A1BV')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1BV',false)
call UnitAddAbility(u,'A23W')
call UnitMakeAbilityPermanent(u,true,'A23W')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A23W',false)
call TimerStart(t,0.1,true,function EShikiPause)
if LoadUnitHandle(HH,idp,ComboBarHash)==null then
set n=CreateUnit(p,'e11G',GetUnitX(u),GetUnitY(u),GetUnitFacing(u))
call SetUnitFlyHeight(n,GetUnitFlyHeight(u)+300,0)
call UnitAddAbility(n,'A0A1')
call SetUnitColor(n,PLAYER_COLOR_LIGHT_GRAY)
call SetUnitTimeScale(n,10000)
call SaveUnitHandle(HH,idp,ComboBarHash,n)
call ComboBar(u,-.5)
// Отдельный таймер: раньше здесь перезапускался t, и EShikiPause не работал вовсе,
// если E изучали, пока у игрока нет полоски (первой способностью или после -rfh).
// Тогда пауза E2 (A1BN) не снималась, и вариация E после 6-й комбы больше не открывалась.
set tc=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(tc),0,u)
call TimerStart(tc,0.02,true,function ShikiComboStarter)
set tc=null
endif
else
call SetUnitAbilityLevel(u,'A1BU',lvl)
call SetUnitAbilityLevel(u,'A1BV',lvl)
call DestroyTimer(t)
endif
set p=null
set t=null
set u=null
endfunction
function InitTrig_LearnEShiki takes nothing returns nothing
set gg_trg_LearnEShiki=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_LearnEShiki,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(gg_trg_LearnEShiki,Condition(function LearnEShikiCond))
call TriggerAddAction(gg_trg_LearnEShiki,function LearnEShikiCast)
endfunction
function EShikiOneCond takes nothing returns boolean
return GetSpellAbilityId()=='A1BU'
endfunction
function EShikiOneCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local integer idu=GetHandleId(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(HH,id,2)
local real y1=LoadReal(HH,id,4)
local real x2=LoadReal(HH,id,6)
local real y2=LoadReal(HH,id,7)
local real dist=LoadReal(HH,id,5)
local real a=LoadReal(HH,id,3)
local player p=GetOwningPlayer(u)
set n=CreateUnit(p,'e10N',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,155,75,255,155)
call SetUnitScale(n,0.7,0.7,0.7)
call UnitApplyTimedLife(n,'BTLF',0.5)
call SetUnitTimeScale(n,2)
set n=CreateUnit(p,'e11J',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,155,75,255,155)
call UnitApplyTimedLife(n,'BTLF',0.5)
call SetUnitTimeScale(n,1)
if dist>850 then
set x1=x2+850*Cos(a)
set y1=y2+850*Sin(a)
call SetUnitXY_1(u,x1,y1, false)
else
call SetUnitXY_1(u,x1,y1, false)
endif
if LoadInteger(HH,idu,ComboCounterHash)>0 then
call UnitRemoveAbility(u,'A1BI')
endif
call UnitRemoveAbility(u,'A195')
set n=CreateUnit(p,'e11J',x1,y1,a*bj_RADTODEG)
call SetUnitVertexColor(n,155,75,255,155)
call UnitApplyTimedLife(n,'BTLF',0.5)
call SetUnitTimeScale(n,1)
call SetUnitAnimation(u,"spell slam five")
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
set u=null
set p=null
set t=null
endfunction
function EShikiOneCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local integer idu=GetHandleId(u)
local integer idp=GetHandleId(p)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
call SaveUnitHandle(HH,id,0,u)
call SaveReal(HH,id,2,x1)
call SaveReal(HH,id,4,y1)
call SaveReal(HH,id,5,SR(x,y,x1,y1))
call SaveReal(HH,id,6,x)
call SaveReal(HH,id,7,y)
call SaveReal(HH,id,3,a)
call SetUnitAnimation(u,"spell slam one")
call SetUnitTimeScale(n,2)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG-30)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+30)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
call UnitAddAbility(u,'A195')
if LoadInteger(HH,idu,ComboCounterHash)>0 then
call SaveReal(HH,idu,ComboTimerHash,2)
call SetUnitTimeScale(LoadUnitHandle(HH,idp,ComboBarHash),100000)
call ComboBar(u,-.5)
if LoadInteger(HH,idu,ComboCounterHash)>5 and LoadInteger(HH,idu,ComboCounterHash)<8 then
    call SetUnitColor(LoadUnitHandle(HH,idp,ComboBarHash),PLAYER_COLOR_PURPLE)
elseif LoadInteger(HH,idu,ComboCounterHash)>7 then
    call SetUnitColor(LoadUnitHandle(HH,idp,ComboBarHash),PLAYER_COLOR_RED)
    if LoadUnitHandle(HH,idu,SH_CST)==null then
        call SaveUnitHandle(HH,idu,SH_CST,CreateUnit(p,'h06A',x,y,0))
    endif
endif
call UnitAddAbility(u,'A1BI')
if LoadInteger(HH,idu,ComboCounterHash)>5 and GetUnitAbilityLevel(u,'A1BN')==0 then
    call SetPlayerAbilityAvailable(p,'A1BU',false)
    call SetPlayerAbilityAvailable(p,'A1BV',true)
endif
if LoadInteger(HH,idu,ComboCounterHash)>2 then
    call SetAbilityIntegerLevelField(GetUnitAbility(u,'A1BZ'), ABILITY_ILF_TARGET_TYPE,0,1)
    call SetAbilityRealLevelField(GetUnitAbility(u,'A1BZ'), ABILITY_RLF_CAST_RANGE,0,1400)
endif
endif
call UnitAddAbility(u,'A23Z')
call UnitRemoveAbilityTimed(u,'A23Z',0.85)
set soundplay=SndN(2622) // Sound\Music\mp3Music\NanayaE1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.15,false,function EShikiOneCast2)
set u=null
set p=null
set t=null
endfunction
function InitTrig_EShikiOne takes nothing returns nothing
set gg_trg_EShikiOne=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_EShikiOne,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_EShikiOne,Condition(function EShikiOneCond))
call TriggerAddAction(gg_trg_EShikiOne,function EShikiOneCast)
endfunction
