endloop
call TriggerAddAction(t,function RestronationCast)
call TriggerAddCondition(t,Condition(function RestronationCond))
set t=null
endfunction
function LaserCond takes nothing returns boolean
return GetSpellAbilityId()=='A0QD'
endfunction
function LaserCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x2=LoadReal(h,id,2)
local real y2=LoadReal(h,id,3)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real a=Atan2(y2-y1,x2-x1)
local real l__s=LoadReal(h,id,4)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroInt(u,true)*(GetUnitAbilityLevel(u,'A0QD')+2)
if SR(x1,y1,x2,y2)>26.00 then
set n=CreateUnit(p,'e0OT',x1,y1,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitScale(n,l__s,l__s,l__s)
set x1=x1+47*Cos(a)
set y1=y1+47*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
call SetUnitScale(l__d,l__s+0.5,l__s+0.5,l__s+0.5)
call SaveReal(h,id,4,l__s+0.03)
else
call UnitApplyTimedLife(CreateUnit(p,'e048',x1,y1,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e03W',x1,y1,0),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e06O',x1,y1,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e06N',x1,y1,0),'BTLF',3)
call DestroyEffect(AddSpecialEffect("war3mapImported\\explode.mdx",x1,y1))
call DestroyEffect(AddSpecialEffect("war3mapImported\\SuperBigExplosion.mdx",x1,y1))
call GroupEnumUnitsInRange(G,x1,y1,400,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SlowUnit(u,E,0.5,0,5,0,false)
endif
call GroupRemoveUnit(G,E)
endloop
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call RemoveUnit(l__d)
endif
set l__d=null
set p=null
set u=null
set t=null
endfunction
