else
        set soundplay=SndN(1924) // Sound\war3mapImported\Misaka T.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
// set soundplay=CreateSound("Sound\\Music\\mp3Music\\Railgun.mp3",false,false,true,12700,12700,"")
// call StartSound(soundplay)
// call KillSoundWhenDone(soundplay)
call TimerStart(t,0.035,true,function RailgunCast2)
set p=null
set u=null
set t=null
endfunction
function LightningBarrierCond takes nothing returns boolean
return GetSpellAbilityId()=='A0RP'
endfunction
function LightningBarrierCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local group g=LoadGroupHandle(h,id,1)
local integer idu=GetHandleId(u)
local integer i=1
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local real dist
local real dmg2=LoadReal(h,id,10)
local real dmg=(GetUnitAbilityLevel(u,'A0RP')+4)*GetHeroAgi(u,true)+dmg2
local integer l__idg=GetHandleId(g)
local real f
local player p=GetOwningPlayer(u)
local integer l__ide
loop
exitwhen i>15
set dist=LoadReal(h,id,StringHash("dist"+I2S(i)))+200
call SaveReal(h,id,StringHash("dist"+I2S(i)),dist)
set f=(24*i)*bj_DEGTORAD
call DestroyEffect(AddSpecialEffect(" ",x+dist*Cos(f),y+dist*Sin(f)))
call DestroyEffect(AddSpecialEffect("war3mapImported\\lightning boom.mdl",x+dist*Cos(f),y+dist*Sin(f)))
set i=i+1
endloop
call GroupEnumUnitsInRange(g,x,y,dist,Base)
set n=CreateUnit(p,0x65305058,x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',1)
call UnitScale(n,0.01,5.0,0.75)
if dmg2>0 then
call UnitApplyTimedLife(CreateUnit(p,'e0F5',x+GetRandomReal(-dist/2,dist/2),y+GetRandomReal(-dist/2,dist/2),0),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0F3',x+GetRandomReal(-dist/2,dist/2),y+GetRandomReal(-dist/2,dist/2),0),'BTLF',1)
endif
loop
set E=FirstOfGroup(g)
set l__ide=GetHandleId(E)
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,l__ide)then
// call myCustomDamage(u,E,dmg,false,false,null,null,null)
call MisakaAddElectrification(u, E, dmg)
call SaveUnitHandle(h,l__idg,l__ide,E)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
call PauseUnit(u,true)
if dist>=1000 then
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
set u=null
set g=null
set t=null
set p=null
endfunction
