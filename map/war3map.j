function CastVectoriesCarge2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real x2=LoadReal(h,id,4)
local real y2=LoadReal(h,id,5)
local real a=LoadReal(h,id,1)
local group g=LoadGroupHandle(h,id,3)
local integer l__idg=GetHandleId(g)
local real dmg=50+GetHeroAgi(u,true)*(1+GetUnitAbilityLevel(u,'A0G7'))
local player p=GetOwningPlayer(u)
local integer l__ide
local real x3=x2+1250*Cos(a)
local real y3=y2+1250*Sin(a)
local real dist=LoadReal(h,id,100)
if dist<1250 and LoadBoolean(HH,GetHandleId(u),DASH_USER)==true then
call SaveReal(h,id,100,dist+50)
call SetUnitX(u,x1+50*Cos(a))
call SetUnitY(u,y1+50*Sin(a))
call SetUnitFacing(u,a*bj_RADTODEG)
set n=CreateUnit(p,'e09K',x1,y1,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.25)
call SetUnitVertexColor(n,255,255,255,125)
call SetUnitTimeScale(n,2)
call SetUnitAnimation(n,"spell three")
call SetUnitAnimation(u,"spell three")
call GroupEnumUnitsInRange(G,x1,y1,100,Base)
loop
set E=FirstOfGroup(G)
set l__ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,l__idg,l__ide)!=E then
if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
call SaveUnitHandle(h,l__idg,l__ide,E)
call Push(E,90,Atan2(y3-GetUnitY(E),x3-GetUnitX(E)),SR(x3,y3,GetUnitX(E),GetUnitY(E)))
call SetControlToUnit(E,E, 2, "stun")
else
call SaveBoolean(HH,GetHandleId(u),DASH_USER,false)
call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,u)
endif
endif
call GroupRemoveUnit(G,E)
exitwhen E==null
endloop
else
call SaveBoolean(HH,GetHandleId(u),DASH_USER,false)
call GroupEnumUnitsInRange(G,x1,y1,350,Base)
loop
set E=FirstOfGroup(G)
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call Push(E,50,Atan2(GetUnitY(E)-y1,GetUnitX(E)-x1),400)
call SetControlToUnit(E,E, 3, "stun")
endif
call GroupRemoveUnit(G,E)
exitwhen E==null
endloop
call UnitApplyTimedLife(CreateUnit(p,'e03X',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03W',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e08R',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03Y',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e08N',x1,y1,a*bj_RADTODEG),'BTLF',1)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
call DestroyTimer(t)
call DestroyGroup(g)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call SetUnitTimeScale(u,1)
endif
set u=null
set p=null
set t=null
set g=null
endfunction
