exitwhen E==null
if(GetUnitTypeId(E)=='fSDL' or GetUnitTypeId(E)=='e0ZY' or GetUnitTypeId(E)=='e0ZV')and GetUnitAbilityLevel(E,'A1C3')==0 then
call UnitAddAbility(E,'A1C3')
call UnitApplyTimedLife(E,'BTLF',0.06)
endif
if Condition_Base(p,E)and GetUnitTypeId(E)!='e0ZY' then
call myCustomDamage(u,E,GetHeroInt(Hero[ip],true)*0.4+30+GetWidgetLife(E)*0.01,false,false,null,null,null)
endif
call GroupRemoveUnit(g,E)
endloop
call DestroyGroup(g)
set u=null
set g=null
endfunction
