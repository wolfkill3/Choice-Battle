call TriggerRegisterAnyUnitEventBJ(gg_trg_GKazuma,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_GKazuma,Condition(function GKazumaCond))
call TriggerAddAction(gg_trg_GKazuma,function GKazumaCast)
endfunction
function QKazumaCond takes nothing returns boolean
return GetSpellAbilityId()=='Ao7N'
endfunction
function QKazumaCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit c=LoadUnitHandle(HH,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local real time=LoadReal(HH,id,2)-0.1
local player p=GetOwningPlayer(u)
local integer i=0
local integer l__s=0
local integer ls=0
local integer item_id= 0
local integer max_iteration= 30
local integer random_slot= 0
if time>0 then
call PauseUnit(u,true)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call SaveReal(HH,id,2,time)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\SpiritOfVengeance\\SpiritOfVengeanceBirthMissile.mdl",u,"right hand"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\SpiritOfVengeance\\SpiritOfVengeanceBirthMissile.mdl",u,"left hand"))
call EffectToRandomBone("Abilities\\Spells\\NightElf\\SpiritOfVengeance\\SpiritOfVengeanceBirthMissile.mdl",c)
call SetUnitXY_1(u,LoadReal(HH,id,3),LoadReal(HH,id,4),false)
call SetUnitXY_1(c,LoadReal(HH,id,5),LoadReal(HH,id,6),false)
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,155,200,255,75)
call SetUnitTimeScale(n,2)
call SetUnitScale(n,0.5,0.5,0.5)
call UnitApplyTimedLife(n,'BTLF',1)
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,155,200,255,75)
call SetUnitTimeScale(n,2)
call SetUnitScale(n,0.75,0.75,0.75)
call UnitApplyTimedLife(n,'BTLF',1)
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,155,200,255,75)
call SetUnitTimeScale(n,2)
call SetUnitScale(n,1,1,1)
call UnitApplyTimedLife(n,'BTLF',1)
else
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call PauseUnit(u,false)
call SetUnitTimeScale(u,1)
if GetWidgetMaxMana(c)>0 then
call HealTextTag(u,u,GetWidgetMaxMana(c)*(0.10+0.01*GetUnitAbilityLevel(u,'Ao7N'))*0.5*myCustomMana2(u,1),"ManaRes")
call SetWidgetMana(u,GetWidgetMana(u)+GetWidgetMaxMana(c)*(0.10+0.01*GetUnitAbilityLevel(u,'Ao7N'))*0.5)
call SetWidgetMana(c,GetWidgetMana(c)-GetWidgetMaxMana(c)*(0.10+0.01*GetUnitAbilityLevel(u,'Ao7N')))
call myCustomDamage(u,c,(1+0.5*GetUnitAbilityLevel(u,'Ao7N'))*(GetWidgetMaxMana(c)*(0.10+0.01*GetUnitAbilityLevel(u,'Ao7N'))),false,false,null,null,null)
if GetWidgetMana(c)<GetWidgetMaxMana(c)*0.5 then
call SetControlToUnit(u,c,2,"stun")
endif
endif
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set p=null
set c=null
set u=null
set t=null
endfunction
function QKazumaCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit c=LoadUnitHandle(HH,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>150 then
set x=x+50*Cos(a)
set y=y+50*Sin(a)
call SetUnitXY_1(u,x,y, false)
set n=CreateUnit(p,'kaD1',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.2)
call SetUnitVertexColor(n,255,255,255,75)
call SetUnitTimeScale(n,0.05)
call SetUnitAnimation(n,"Spell Four")
else
    if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
        set soundplay=SndN(3061) // Sound\Music\mp3Music\KazumaQ.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        set x=x-80*Cos(a)
        set y=y-80*Sin(a)
        call SetUnitXY_1(u,x,y, false)
        set n=CreateUnit(p,'kaD2',x,y,a*bj_RADTODEG)
        call UnitApplyTimedLife(n,'BTLF',2)
        call SaveReal(HH,id,2,1)
        call SaveReal(HH,id,3,GetUnitX(u))
        call SaveReal(HH,id,4,GetUnitY(u))
        call SaveReal(HH,id,5,GetUnitX(c))
        call SaveReal(HH,id,6,GetUnitY(c))
        call PauseUnit(c,true)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
        call SetUnitTimeScale(u,2)
        call SetUnitAnimationByIndex(u,15)
        call TimerStart(t,0.1,true,function QKazumaCast3)
    else
        call PauseUnit(u,false)
        call SetUnitInvulnerable(u,false)
        call SetUnitVertexColor(u,255,255,255,255)
        call SetUnitTimeScale(u,1)
        call PauseTimer(t)
        call SetUnitFlyHeight(u,0,0)
        call DestroyTimer(t)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
        call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
        call FlushChildHashtable(HH,id)
    endif
endif
set p=null
set c=null
set u=null
set t=null
endfunction
function QKazumaCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
call SaveUnitHandle(HH,id,0,u)
call SaveUnitHandle(HH,id,1,c)
call PauseUnit(u,true)
call SetUnitAnimation(u,"Spell Four")
call SetUnitTimeScale(u,0.05)
set n=CreateUnit(p,'eo8A',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1)
set n=CreateUnit(p,'eo0N',x,y,a*bj_RADTODEG-45)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'eo0N',x,y,a*bj_RADTODEG+45)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'eo0N',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
call TimerStart(t,0.02,true,function QKazumaCast2)
set u=null
set t=null
set c=null
set p=null
endfunction
function InitTrig_QKazuma takes nothing returns nothing
set gg_trg_QKazuma=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_QKazuma,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_QKazuma,Condition(function QKazumaCond))
call TriggerAddAction(gg_trg_QKazuma,function QKazumaCast)
endfunction
function WKazumaCond takes nothing returns boolean
return GetSpellAbilityId()=='Ao7T'
endfunction
function WKazumaCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=LoadReal(h,id,1)
local real y=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
call GroupEnumUnitsInRange(G,x,y,400,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if IsUnitAlly(E,p)then
call HealTextTag(u,E,GetUnitState(E,UNIT_STATE_MAX_LIFE)*(0.10+0.02*GetUnitAbilityLevel(u,'Ao7T'))*myCustomHeal2(E,1),"HealthRes")
call SetUnitState(E,UNIT_STATE_LIFE,GetWidgetLife(E)+GetUnitState(E,UNIT_STATE_MAX_LIFE)*(0.10+0.02*GetUnitAbilityLevel(u,'Ao7T')))
endif
call GroupRemoveUnit(G,E)
endloop
if SR(x,y,GetUnitX(LoadUnitHandle(HH,GetHandleId(u),SH_dark)),GetUnitY(LoadUnitHandle(HH,GetHandleId(u),SH_dark)))<400 then
if GetUnitAbilityLevel(LoadUnitHandle(HH,GetHandleId(u),SH_dark),'Ao8U')==0 then
call SaveReal(HH,GetHandleId(LoadUnitHandle(HH,GetHandleId(u),SH_dark)),SH_darkHP,LoadReal(HH,GetHandleId(LoadUnitHandle(HH,GetHandleId(u),SH_dark)),SH_darkHP)+LoadReal(HH,GetHandleId(LoadUnitHandle(HH,GetHandleId(u),SH_dark)),SH_darkMaxHP)*(0.10+0.02*GetUnitAbilityLevel(u,'Ao7T')))
else
call SaveReal(HH,GetHandleId(LoadUnitHandle(HH,GetHandleId(u),SH_dark)),SH_revivetime,LoadReal(HH,GetHandleId(LoadUnitHandle(HH,GetHandleId(u),SH_dark)),SH_revivetime)+10)
endif
endif
call UnitRemoveAbilityTimed(LoadUnitHandle(HH,GetHandleId(u),SH_aqua),'Ao7U',0.8)
call SetUnitAnimationByIndex(LoadUnitHandle(HH,GetHandleId(u),SH_aqua),16)
set n=CreateUnit(p,'kaW3',x,y,0)
call UnitApplyTimedLife(n,'BTLF',1)
set n=CreateUnit(p,'kaW4',x,y,0)
call UnitApplyTimedLife(n,'BTLF',1)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set p=null
set u=null
set t=null
endfunction
function WKazumaCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local player p=GetOwningPlayer(u)
local unit l__d=LoadUnitHandle(HH,GetHandleId(u),SH_aqua)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,x)
call SaveReal(h,id,2,y)
call IssueImmediateOrder(l__d,"stop")
call SetUnitFacing(l__d,Atan2(y-GetUnitY(l__d),x-GetUnitX(l__d))*bj_RADTODEG)
call UnitRemoveAbility(l__d,'Ao2E')
call DestroyEffect(AddSpecialEffect("war3mapImported\\az_lina(2)_t2_blast.mdl",GetUnitX(l__d),GetUnitY(l__d)))
call SetUnitAnimationByIndex(l__d,14)
call UnitAddAbility(l__d,'Ao7U')
set n=CreateUnit(p,'d243',x,y,0)
call SetUnitTimeScale(n,0.8)
call UnitApplyTimedLife(n,'BTLF',2.5)
set n=CreateUnit(p,'kaW2',x,y,0)
call SetUnitTimeScale(n,0.3)
call UnitApplyTimedLife(n,'BTLF',2.5)
set soundplay=SndN(3064) // Sound\Music\mp3Music\KazumaW.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,1.7,false,function WKazumaCast2)
set p=null
set u=null
set l__d=null
set t=null
endfunction
function InitTrig_WKazuma takes nothing returns nothing
set gg_trg_WKazuma=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_WKazuma,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_WKazuma,Condition(function WKazumaCond))
call TriggerAddAction(gg_trg_WKazuma,function WKazumaCast)
endfunction
function Trig_E2Kazuma_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='Ao8V'
endfunction
function Trig_E2Kazuma_Actions takes nothing returns nothing
local real x=GetUnitX(GetTriggerUnit())
local real y=GetUnitY(GetTriggerUnit())
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
call SetUnitFacingInstant(GetTriggerUnit(),a*bj_RADTODEG)
call SaveReal(h,GetHandleId(GetTriggerUnit()),SH_KazumaTime,10)
endfunction
function InitTrig_E2Kazuma takes nothing returns nothing
set gg_trg_E2Kazuma=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_E2Kazuma,EVENT_PLAYER_UNIT_SPELL_CHANNEL)
call TriggerAddCondition(gg_trg_E2Kazuma,Condition(function Trig_E2Kazuma_Conditions))
call TriggerAddAction(gg_trg_E2Kazuma,function Trig_E2Kazuma_Actions)
endfunction
function EKazumaStopOrders2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
call IssueImmediateOrder(u,"stop")
call SetUnitFacing(u,Atan2(LoadReal(h,id,1)-GetUnitY(u),LoadReal(h,id,2)-GetUnitX(u))*bj_RADTODEG)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
set t=null
set u=null
endfunction
function EKazumaStopOrders takes nothing returns nothing
local unit u=GetOrderedUnit()
local timer t
local integer id
if GetIssuedOrderId()!=OrderId("controlmagic") and GetIssuedOrderId()!=OrderId("etherealform") and GetIssuedOrderId()!=OrderId("hex") and GetIssuedOrderId()!=OrderId("farsight") then
set t=CreateTimer()
set id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
if GetOrderTargetUnit()==null then
call SaveReal(h,id,2,GetOrderPointX())
call SaveReal(h,id,1,GetOrderPointY())
else
call SaveReal(h,id,2,GetUnitX(GetOrderTargetUnit()))
call SaveReal(h,id,1,GetUnitY(GetOrderTargetUnit()))
endif
call TimerStart(t,0.001,false,function EKazumaStopOrders2)
endif
set u=null
set t=null
endfunction
function EKazumaCond takes nothing returns boolean
return GetSpellAbilityId()=='Ao6V'
endfunction
function EKazumaMissles2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real f=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real a=LoadReal(h,id,5)
local real dist=LoadReal(h,id,7)
local group g=LoadGroupHandle(h,id,10)
local player p=GetOwningPlayer(l__d)
local real dmg=LoadReal(h,id,9)
local integer idp=GetPlayerId(p)
local integer l__ide=0
local integer l__idg=GetHandleId(g)
local real time=LoadReal(h,id,10)
if dist>speed and l__d!=null and IsTerrainPathable(GetUnitX(l__d),GetUnitY(l__d),PATHING_TYPE_FLYABILITY)==false  then
call SaveReal(h,id,10,time+1)
if ModuloReal(time,3)<1 then
set n=CreateUnit(p,'e238',x,y,a*bj_RADTODEG)
call SetUnitFlyHeight(n,125,0)
call SetUnitTimeScale(n,2)
call UnitApplyTimedLife(n,'BTLF',0.5)
endif
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SaveReal(h,id,7,dist-speed)
call GroupEnumUnitsInRange(g,x,y,110,Base)
loop
set E=FirstOfGroup(g)
set l__ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,l__ide)then
call SaveUnitHandle(h,l__idg,l__ide,E)
call SetControlToUnit(E,E, 2, "stun")
call AtalantaPush(E,50,a,350)
call myCustomDamage(Hero[idp],E,dmg,false,false,null,null,null)
call SaveReal(h,id,7,speed)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",E,"chest"))
set n=CreateUnit(p,'e131',GetUnitX(E),GetUnitY(E),a*bj_RADTODEG)
call SetUnitTimeScale(n,2)
call UnitApplyTimedLife(n,'BTLF',3)
endif
call GroupRemoveUnit(g,E)
endloop
else
call UnitApplyTimedLife(l__d,'BTLF',0.1)
call PauseTimer(t)
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set p=null
set g=null
set t=null
endfunction
function EKazumaMissles takes unit l__d,real speed,real a,real dist,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,GetUnitFlyHeight(l__d))
call SaveReal(h,id,3,GetUnitX(l__d))
call SaveReal(h,id,4,GetUnitY(l__d))
call SaveReal(h,id,5,a)
call SaveReal(h,id,7,dist)
call SaveReal(h,id,10,0)
call SaveReal(h,id,9,dmg)
call SaveGroupHandle(h,id,10,CreateGroup())
call TimerStart(t,0.014,true,function EKazumaMissles2)
set t=null
endfunction
function EKazumaCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=GetUnitFacing(u)*bj_DEGTORAD
local real dmgInc=LoadReal(h,id,3)
local real dmg=LoadReal(h,id,4)
local real range=LoadReal(h,id,5)
local player p=GetOwningPlayer(u)
local trigger tt=LoadTriggerHandle(h,id,1)
local real time=LoadReal(h,GetHandleId(u),SH_KazumaTime)
if GetUnitAbilityLevel(u,'A1FU')>0 and time<10 and GetUnitState(u,UNIT_STATE_LIFE)>0.405 and IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'CBC2')==0 and GetUnitAbilityLevel(u,'cbc3')==0  and GetUnitAbilityLevel(u,'cbc5')==0  and GetUnitAbilityLevel(u, 'cbc7')==0 and GetUnitAbilityLevel(u, 'cbc8')==0 and GetUnitAbilityLevel(u, 'cbc9')==0 and UnitIsAlive(u) and udg_B and DU2 then
call SetUnitAnimation(u,"Spell One")
call SaveReal(h,id,4,dmg+dmgInc)
call SaveReal(h,id,5,range+10)
call SaveReal(h,GetHandleId(u),SH_KazumaTime,time+0.05)
else
set soundplay=SndN(3066) // Sound\Music\mp3Music\KazumaE2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set n=CreateUnit(p,'e22Y',x+50*Cos(a),y+50*Sin(a),a*bj_RADTODEG)
call SetUnitTimeScale(n,2.5)
call SetUnitFlyHeight(n,125,0)
call EKazumaMissles(n,(range/60),a,range,dmg)
set n=CreateUnit(p,'dM04',x,y,a*bj_RADTODEG)
call SetUnitTimeScale(n, 0.8)
call MyRemoveUnit(n, 1.5)
call UnitRemoveAbility(u,'A1FU')
call UnitRemoveAbility(u,'A2DU')
call UnitRemoveAbility(u,'Ao8V')
call ShowAbility2('Ao6V',true)
call SetUnitAnimation(u,"Spell Two")
call UnitRemoveAbility(u,'B00A')
call SetUnitAcquireRange(u,600)
call TriggerClearActions(tt)
call DestroyTrigger(tt)
call IssueImmediateOrder(u,"stop")
call FlushChildHashtable(h,id)
call DestroyTimer(t)
endif
set p=null
set tt=null
set u=null
set t=null
endfunction
function EKazumaCast takes nothing returns nothing
local timer t=CreateTimer()
local trigger tt=CreateTrigger()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
call SaveUnitHandle(h,id,0,u)
call SaveTriggerHandle(h,id,1,tt)
call SaveReal(h,id,3,(0.015+GetUnitAbilityLevel(u,'Ao6V')*0.005)*GetHeroAgi(u,true))
call SaveReal(h,id,4,(GetUnitAbilityLevel(u,'Ao6V')+2)*GetHeroAgi(u,true))
call SaveReal(h,id,5,3000)
call SaveReal(h,GetHandleId(u),SH_KazumaTime,0)
call SetUnitTurnSpeed(u,400000)
call SetUnitAcquireRange(u,51)
set soundplay=SndN(3069) // Sound\Music\mp3Music\KazumaE.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call ShowAbility2('Ao6V',false)
call UnitAddAbility(u,'Ao8V')
call UnitAddAbility(u,'A1FU') //Slow
call UnitAddAbility(u,'A2DU') 
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerAddAction(tt,function EKazumaStopOrders)
call TimerStart(t,0.05,true,function EKazumaCast2)
set u=null
set t=null
set p=null
set tt=null
endfunction
function InitTrig_EKazuma takes nothing returns nothing
set gg_trg_EKazuma=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_EKazuma,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_EKazuma,Condition(function EKazumaCond))
call TriggerAddAction(gg_trg_EKazuma,function EKazumaCast)
endfunction
