local real y=GetUnitY(u)
local real x1=GetUnitX(d1)
local real y1=GetUnitY(d1)
local integer idd=GetHandleId(c)
local real a=0
local player p=GetOwningPlayer(u)
if UnitIsAlive(d1)or UnitIsAlive(d2)or UnitIsAlive(d3)then
if SR(x,y,x1,y1)>90 and UnitIsAlive(d1)and UnitIsAlive(u)then
set a=Atan2(y-y1,x-x1)-0.25
set x1=x1+70*Cos(a)
set y1=y1+70*Sin(a)
call SetUnitX(d1,x1)
call SetUnitY(d1,y1)
elseif UnitIsAlive(d1)then
call KillUnit(d1)
endif
set x1=GetUnitX(d2)
set y1=GetUnitY(d2)
if SR(x,y,x1,y1)>90 and UnitIsAlive(d2)and UnitIsAlive(u)then
set a=Atan2(y-y1,x-x1)+0.25
set x1=x1+70*Cos(a)
set y1=y1+70*Sin(a)
call SetUnitX(d2,x1)
call SetUnitY(d2,y1)
elseif UnitIsAlive(d2)then
call KillUnit(d2)
endif
set x1=GetUnitX(d3)
set y1=GetUnitY(d3)
if SR(x,y,x1,y1)>90 and UnitIsAlive(d3)and UnitIsAlive(u)then
set a=Atan2(y-y1,x-x1)
set x1=x1+65*Cos(a)
set y1=y1+65*Sin(a)
call SetUnitX(d3,x1)
call SetUnitY(d3,y1)
elseif UnitIsAlive(d3)then
call KillUnit(d3)
endif
else
call RemoveSavedHandle(h,GetHandleId(u),'A1HB')
call RemoveSavedHandle(h,GetHandleId(u),'A1HB'+1)
call UnitRemoveAbility(c,'A1HG')
call RemoveSavedHandle(h,idd,StringHash("ore2"))
call RemoveSavedReal(h,idd,StringHash("ore1"))
call RemoveSavedReal(h,idd,StringHash("ore3"))
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set c=null
set d2=null
set d3=null
set d1=null
set t=null
