            call SetFrameTexture( GetFrameByName("TavernAbility",2), GetAbilityBaseStringFieldById( String2Id( "A0DC" ), ABILITY_SF_ICON_NORMAL ), 2, true )
            call SetFrameTexture( GetFrameByName("TavernAbility",3), GetAbilityBaseStringFieldById( String2Id( "A0DK" ), ABILITY_SF_ICON_NORMAL ), 0, true )
            call SetFrameTexture( GetFrameByName("TavernAbility",3), GetAbilityBaseStringFieldById( String2Id( "A0DK" ), ABILITY_SF_ICON_NORMAL ), 1, true )
            call SetFrameTexture( GetFrameByName("TavernAbility",3), GetAbilityBaseStringFieldById( String2Id( "A0DK" ), ABILITY_SF_ICON_NORMAL ), 2, true )
            call SetFrameTexture( but, GetAbilityBaseStringFieldById( String2Id( "A0CZ" ), ABILITY_SF_ICON_ACTIVATED ), 0, true )
            call SetFrameTexture( but, GetAbilityBaseStringFieldById( String2Id( "A0CZ" ), ABILITY_SF_ICON_ACTIVATED ), 1, true )
            call SetFrameTexture( but, GetAbilityBaseStringFieldById( String2Id( "A0CZ" ), ABILITY_SF_ICON_ACTIVATED ), 2, true )            
            set j=0
            loop
                call AddFrameText( GetFrameByName("TavernAbilityTooltipText",0), "|cffffcc00"+I2S(GetAbilityBaseIntegerLevelFieldById( String2Id( "A0D8" ), ABILITY_ILF_MANA_COST, j ))+"|r")
                exitwhen j==GetAbilityBaseIntegerFieldById(String2Id( "A0D8" ), ABILITY_IF_LEVELS)-1
                call AddFrameText( GetFrameByName("TavernAbilityTooltipText",0), "/")
                set j=j+1
            endloop
            set j=0
            loop
                call AddFrameText( GetFrameByName("TavernAbilityTooltipText",1), "|cffffcc00"+I2S(GetAbilityBaseIntegerLevelFieldById( String2Id( "A0DA" ), ABILITY_ILF_MANA_COST, j ))+"|r")
                exitwhen j==GetAbilityBaseIntegerFieldById(String2Id( "A0DA" ), ABILITY_IF_LEVELS)-1
                call AddFrameText( GetFrameByName("TavernAbilityTooltipText",1), "/")
                set j=j+1
            endloop
            set j=0
            loop
                call AddFrameText( GetFrameByName("TavernAbilityTooltipText",2), "|cffffcc00"+I2S(GetAbilityBaseIntegerLevelFieldById( String2Id( "A0DC" ), ABILITY_ILF_MANA_COST, j ))+"|r")
                exitwhen j==GetAbilityBaseIntegerFieldById(String2Id( "A0DC" ), ABILITY_IF_LEVELS)-1
                call AddFrameText( GetFrameByName("TavernAbilityTooltipText",2), "/")
                set j=j+1
            endloop
            set j=0
            loop
                call AddFrameText( GetFrameByName("TavernAbilityTooltipText",3), "|cffffcc00"+I2S(GetAbilityBaseIntegerLevelFieldById( String2Id( "A0DK" ), ABILITY_ILF_MANA_COST, j ))+"|r")
                exitwhen j==GetAbilityBaseIntegerFieldById(String2Id( "A0DK" ), ABILITY_IF_LEVELS)-1
                call AddFrameText( GetFrameByName("TavernAbilityTooltipText",3), "/")
                set j=j+1
            endloop
            call AddFrameText( GetFrameByName("TavernAbilityTooltipText",0), "\n\n"+GetAbilityBaseStringFieldById( String2Id( "A0D8" ), ABILITY_SF_NAME )+", (|cffffcc00Q|r)\n\n"+GetAbilityBaseStringFieldById( String2Id( "A0D8" ), ABILITY_SLF_TOOLTIP_LEARN_EXTENDED ))
            call AddFrameText( GetFrameByName("TavernAbilityTooltipText",1), "\n\n"+GetAbilityBaseStringFieldById( String2Id( "A0DA" ), ABILITY_SF_NAME )+", (|cffffcc00W|r)\n\n"+GetAbilityBaseStringFieldById( String2Id( "A0DA" ), ABILITY_SLF_TOOLTIP_LEARN_EXTENDED ))
            call AddFrameText( GetFrameByName("TavernAbilityTooltipText",2), "\n\n"+GetAbilityBaseStringFieldById( String2Id( "A0DC" ), ABILITY_SF_NAME )+", (|cffffcc00E|r)\n\n"+GetAbilityBaseStringFieldById( String2Id( "A0DC" ), ABILITY_SLF_TOOLTIP_LEARN_EXTENDED ))
            call AddFrameText( GetFrameByName("TavernAbilityTooltipText",3), "\n\n"+GetAbilityBaseStringFieldById( String2Id( "A0DK" ), ABILITY_SF_NAME )+", (|cffffcc00T|r)\n\n"+GetAbilityBaseStringFieldById( String2Id( "A0DK" ), ABILITY_SLF_TOOLTIP_LEARN_EXTENDED ))

        endif
        call SetFrameTextAlignment( GetFrameByName("TavernAbilityTooltipText",0), TEXT_JUSTIFY_LEFT, TEXT_JUSTIFY_LEFT )
        call SetFrameTextAlignment( GetFrameByName("TavernAbilityTooltipText",1), TEXT_JUSTIFY_LEFT, TEXT_JUSTIFY_LEFT )
        call SetFrameTextAlignment( GetFrameByName("TavernAbilityTooltipText",2), TEXT_JUSTIFY_LEFT, TEXT_JUSTIFY_LEFT )
        call SetFrameTextAlignment( GetFrameByName("TavernAbilityTooltipText",3), TEXT_JUSTIFY_LEFT, TEXT_JUSTIFY_LEFT )
        call SetFrameTextAlignment( GetFrameByName("TavernAbilityTooltipText",4), TEXT_JUSTIFY_LEFT, TEXT_JUSTIFY_LEFT )
        call SetFrameTextAlignment( GetFrameByName("TavernAbilityTooltipText",5), TEXT_JUSTIFY_LEFT, TEXT_JUSTIFY_LEFT )
        call SetFrameTextAlignment( GetFrameByName("TavernAbilityTooltipText",6), TEXT_JUSTIFY_LEFT, TEXT_JUSTIFY_LEFT )
        call SetFrameRelativePoint( GetFrameByName("TavernAbilityTooltip",0), FRAMEPOINT_CENTER, GetFrameByName("TavernAbility",0), FRAMEPOINT_CENTER,  .13, (-0.5*GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",0)))-.02  )
        call SetFrameRelativePoint( GetFrameByName("TavernAbilityTooltip",1), FRAMEPOINT_CENTER, GetFrameByName("TavernAbility",1), FRAMEPOINT_CENTER,  .13, (-0.5*GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",1)))-.02  )
        call SetFrameRelativePoint( GetFrameByName("TavernAbilityTooltip",2), FRAMEPOINT_CENTER, GetFrameByName("TavernAbility",2), FRAMEPOINT_CENTER,  .13, (-0.5*GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",2)))-.02  )
        call SetFrameRelativePoint( GetFrameByName("TavernAbilityTooltip",3), FRAMEPOINT_CENTER, GetFrameByName("TavernAbility",3), FRAMEPOINT_CENTER,  .13, (-0.5*GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",3)))-.02  )
        call SetFrameRelativePoint( GetFrameByName("TavernAbilityTooltip",4), FRAMEPOINT_CENTER, GetFrameByName("TavernAbility",4), FRAMEPOINT_CENTER,  .13, (-0.5*GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",4)))-.02  )
        call SetFrameRelativePoint( GetFrameByName("TavernAbilityTooltip",5), FRAMEPOINT_CENTER, GetFrameByName("TavernAbility",5), FRAMEPOINT_CENTER,  .13, (-0.5*GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",5)))-.02  )
        call SetFrameRelativePoint( GetFrameByName("TavernAbilityTooltip",6), FRAMEPOINT_CENTER, GetFrameByName("TavernAbility",6), FRAMEPOINT_CENTER,  .13, (-0.5*GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",6)))-.02  )     
        call SetFrameSize( GetFrameByName("TavernAbilityTooltip",0), .26, GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",0))+0.03)
        call SetFrameSize( GetFrameByName("TavernAbilityTooltip",1), .26, GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",1))+0.03)
        call SetFrameSize( GetFrameByName("TavernAbilityTooltip",2), .26, GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",2))+0.03)
        call SetFrameSize( GetFrameByName("TavernAbilityTooltip",3), .26, GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",3))+0.03)
        call SetFrameSize( GetFrameByName("TavernAbilityTooltip",4), .26, GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",4))+0.03)
        call SetFrameSize( GetFrameByName("TavernAbilityTooltip",5), .26, GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",5))+0.03)
        call SetFrameSize( GetFrameByName("TavernAbilityTooltip",6), .26, GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",6))+0.03)
    endif
    set p = null
    set but = null
endfunction

function OnButtonSelectHero takes nothing returns nothing
    local player p = GetTriggerPlayer( )
    local integer pHid = GetHandleId( p )
    local integer buttonId = LoadInteger( HH, pHid, '+bId' )
    local framehandle but = GetTriggerFrame()
    local framehandle selector = GetCFrameByName( "HeroPickSelector", 0 )
    local string abilList 
    local string abilList2 
    local string s = ""
    local integer i=0
    local integer j=0
    local integer len = 0

    if buttonId == -1 then
        return
    endif
    if udg_test then
    set TestModeHeroId[GetPlayerId(p)]=GetFrameContext(but)
    else
    set TavernHeroId[GetPlayerId(p)]=GetFrameContext(but)
    set TavernPickedHeroFrame[GetPlayerId(p)]=GetFrameByName("TavernBarHero",GetFrameContext(but))
    set TavernPickedHeroFrame2[GetPlayerId(p)]=GetFrameByName("TavernBarHeroTitle",GetFrameContext(but))
    set abilList=GetUnitBaseStringFieldById( RH_Force[GetFrameContext(but)], UNIT_SF_HERO_ABILITY_LIST )
    set abilList2=GetUnitBaseStringFieldById( RH_Force[GetFrameContext(but)], UNIT_SF_ABILITY_LIST )
    
    endif
    if p==GetLocalPlayer() then
        call ShowFrame( GetFrameByName("TavernAbilityBorderOpenable",0), false )
        call ShowFrame( GetFrameByName("TavernAbilityBorderOpenable",1), false )
        call ShowFrame( GetFrameByName("TavernAbilityBorderOpenable",2), false )
        call ShowFrame( GetFrameByName("TavernAbilityBorderOpenable",3), false )
        call ShowFrame( GetFrameByName("TavernAbilityBorderOpenable",4), false )
        call ShowFrame( GetFrameByName("TavernAbilityBorderOpenable",5), false )
        call ShowFrame( GetFrameByName("TavernAbilityBorderOpenable",6), false )
        set j=0
        loop
        call ShowFrame( GetFrameByName("TavernAdditionalAbilityBorderOpenable",j), false )
        set j=j+1
        exitwhen j>35
        endloop
        if Condition_AbilityString(String2Id( s )) then
        endif
        call ClearFrameAllPoints( selector )
        if udg_test==false then
        set abilList = StringReplace( abilList, ",", "", true )
        set abilList2 = StringReplace( abilList2, ",", "", true )
        set len = StringLength( abilList2 )
        endif
        call SetFrameRelativePoint( selector, FRAMEPOINT_BOTTOMLEFT, but, FRAMEPOINT_BOTTOMLEFT, -.001, -.001 )
        call ShowFrame( selector, true )
        call ShowFrame( InfoTavernText, true )
        call ShowFrame( GetFrameByName("TavernBarAdditionalAbilityList",0), false )
        if udg_test==false then
            call SetFrameText( InfoTavernText, GetUnitBaseStringFieldById(RH_Force[GetFrameContext(but)],UNIT_SF_TOOLTIP_EXTENDED))
            if GetUnitBaseIntegerFieldById(RH_Force[GetFrameContext(but)],UNIT_IF_PRIMARY_ATTRIBUTE)==1 then
                call AddFrameText( InfoTavernText, "|cffffcc00STR: "+I2S(GetUnitBaseIntegerFieldById(RH_Force[GetFrameContext(but)],UNIT_IF_STRENGTH_BASE))+" +"+R2SW(GetUnitBaseRealFieldById(RH_Force[GetFrameContext(but)],UNIT_RF_STRENGTH_PER_LEVEL),1,1)+"|r   AGI: "+I2S(GetUnitBaseIntegerFieldById(RH_Force[GetFrameContext(but)],UNIT_IF_AGILITY_BASE))+" +"+R2SW(GetUnitBaseRealFieldById(RH_Force[GetFrameContext(but)],UNIT_RF_AGILITY_PER_LEVEL),1,1)+"   INT: "+I2S(GetUnitBaseIntegerFieldById(RH_Force[GetFrameContext(but)],UNIT_IF_INTELLIGENCE_BASE))+" +"+R2SW(GetUnitBaseRealFieldById(RH_Force[GetFrameContext(but)],UNIT_RF_INTELLIGENCE_PER_LEVEL),1,1)+"\n")
            elseif GetUnitBaseIntegerFieldById(RH_Force[GetFrameContext(but)],UNIT_IF_PRIMARY_ATTRIBUTE)==2 and RH_Force[GetFrameContext(but)]!='H04O' then
                call AddFrameText( InfoTavernText, "STR: "+I2S(GetUnitBaseIntegerFieldById(RH_Force[GetFrameContext(but)],UNIT_IF_STRENGTH_BASE))+" +"+R2SW(GetUnitBaseRealFieldById(RH_Force[GetFrameContext(but)],UNIT_RF_STRENGTH_PER_LEVEL),1,1)+"   AGI: "+I2S(GetUnitBaseIntegerFieldById(RH_Force[GetFrameContext(but)],UNIT_IF_AGILITY_BASE))+" +"+R2SW(GetUnitBaseRealFieldById(RH_Force[GetFrameContext(but)],UNIT_RF_AGILITY_PER_LEVEL),1,1)+"   |cffffcc00INT: "+I2S(GetUnitBaseIntegerFieldById(RH_Force[GetFrameContext(but)],UNIT_IF_INTELLIGENCE_BASE))+" +"+R2SW(GetUnitBaseRealFieldById(RH_Force[GetFrameContext(but)],UNIT_RF_INTELLIGENCE_PER_LEVEL),1,1)+"|r\n")
            elseif GetUnitBaseIntegerFieldById(RH_Force[GetFrameContext(but)],UNIT_IF_PRIMARY_ATTRIBUTE)==3 then
                call AddFrameText( InfoTavernText, "STR: "+I2S(GetUnitBaseIntegerFieldById(RH_Force[GetFrameContext(but)],UNIT_IF_STRENGTH_BASE))+" +"+R2SW(GetUnitBaseRealFieldById(RH_Force[GetFrameContext(but)],UNIT_RF_STRENGTH_PER_LEVEL),1,1)+"   |cffffcc00AGI: "+I2S(GetUnitBaseIntegerFieldById(RH_Force[GetFrameContext(but)],UNIT_IF_AGILITY_BASE))+" +"+R2SW(GetUnitBaseRealFieldById(RH_Force[GetFrameContext(but)],UNIT_RF_AGILITY_PER_LEVEL),1,1)+"|r   INT: "+I2S(GetUnitBaseIntegerFieldById(RH_Force[GetFrameContext(but)],UNIT_IF_INTELLIGENCE_BASE))+" +"+R2SW(GetUnitBaseRealFieldById(RH_Force[GetFrameContext(but)],UNIT_RF_INTELLIGENCE_PER_LEVEL),1,1)+"\n")
            else
                call AddFrameText( InfoTavernText, "|cffffcc00STR: "+I2S(GetUnitBaseIntegerFieldById(RH_Force[GetFrameContext(but)],UNIT_IF_STRENGTH_BASE))+" +"+R2SW(GetUnitBaseRealFieldById(RH_Force[GetFrameContext(but)],UNIT_RF_STRENGTH_PER_LEVEL),1,1)+"   AGI: "+I2S(GetUnitBaseIntegerFieldById(RH_Force[GetFrameContext(but)],UNIT_IF_AGILITY_BASE))+" +"+R2SW(GetUnitBaseRealFieldById(RH_Force[GetFrameContext(but)],UNIT_RF_AGILITY_PER_LEVEL),1,1)+"   INT: "+I2S(GetUnitBaseIntegerFieldById(RH_Force[GetFrameContext(but)],UNIT_IF_INTELLIGENCE_BASE))+" +"+R2SW(GetUnitBaseRealFieldById(RH_Force[GetFrameContext(but)],UNIT_RF_INTELLIGENCE_PER_LEVEL),1,1)+"|r\n")
            endif
            call AddFrameText( InfoTavernText, "Base Attack: " + I2S( GetUnitBaseWeaponIntegerFieldById( RH_Force[GetFrameContext(but)], UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE,0 ) + GetUnitBaseWeaponIntegerFieldById( RH_Force[GetFrameContext(but)], UNIT_WEAPON_IF_ATTACK_DAMAGE_NUMBER_OF_DICE,0 ) )+" - "+ I2S( GetUnitBaseWeaponIntegerFieldById( RH_Force[GetFrameContext(but)], UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE,0 ) + GetUnitBaseWeaponIntegerFieldById( RH_Force[GetFrameContext(but)], UNIT_WEAPON_IF_ATTACK_DAMAGE_NUMBER_OF_DICE,0 ) * GetUnitBaseWeaponIntegerFieldById( RH_Force[GetFrameContext(but)], UNIT_WEAPON_IF_ATTACK_DAMAGE_SIDES_PER_DIE,0 ) )+"    " )
            call AddFrameText( InfoTavernText, "Attack Range: " + R2SW( GetUnitBaseWeaponRealFieldById( RH_Force[GetFrameContext(but)], UNIT_WEAPON_RF_ATTACK_RANGE, 0 ),1,0 ) +"\n" )
            call AddFrameText( InfoTavernText, "Attack Speed: " + R2SW( GetUnitBaseWeaponRealFieldById( RH_Force[GetFrameContext(but)], UNIT_WEAPON_RF_ATTACK_BASE_COOLDOWN, 0 ),1,2 ) +"    Movement Speed: "+R2SW( GetUnitBaseRealFieldById( RH_Force[GetFrameContext(but)], UNIT_RF_SPEED_BASE ),0,1 )+"\n")
            call AddFrameText( InfoTavernText, "DEF: " + R2SW( MathRound( GetUnitBaseRealFieldById( RH_Force[GetFrameContext(but)], UNIT_RF_DEFENSE )),0,1 ) +"\n" )
            call AddFrameText( InfoTavernText, "Cast Time: " + R2SW( GetUnitBaseRealFieldById( RH_Force[GetFrameContext(but)], UNIT_RF_CAST_POINT ),1,2 ) +"   Backswing Cast Time: "+R2SW( GetUnitBaseRealFieldById( RH_Force[GetFrameContext(but)], UNIT_RF_CAST_BACK_SWING ),1,0 )+"\n")
            call SetFrameSpriteModel( TavernHeroPortrait, GetUnitBaseStringFieldById(RH_Force[GetFrameContext(but)],UNIT_SF_PORTRAIT) )
            if GetFrameContext(but)!=7 then
                call SetFrameText( GetFrameByName("TavernAbilityTooltipText",0), "     " )
                call SetFrameText( GetFrameByName("TavernAbilityTooltipText",1), "     " )
                call SetFrameText( GetFrameByName("TavernAbilityTooltipText",2), "     " )
                call SetFrameText( GetFrameByName("TavernAbilityTooltipText",3), "     " )
                call SetFrameText( GetFrameByName("TavernAbilityTooltipText",4), "     " )
                call ShowFrame(GetFrameByName("TavernAbility",5),true)
                call ShowFrame(GetFrameByName("TavernAbility",6),true)
                loop
                exitwhen i>=5 //TavernHeroAbilityIcon
                    set s = SubString( abilList, i * 4, i * 4 + 4 )
                    if GetAbilityBaseIntegerFieldById( String2Id( s ), ABILITY_IF_BUTTON_HOTKEY_RESEARCH )=='Q' then
                        call SetFrameTexture( GetFrameByName("TavernAbility",0), GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_ICON_NORMAL ), 0, true )
                        call SetFrameTexture( GetFrameByName("TavernAbility",0), GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_ICON_NORMAL ), 1, true )
                        call SetFrameTexture( GetFrameByName("TavernAbility",0), GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_ICON_NORMAL ), 2, true )
                        call ShowFrame( GetFrameByName("TavernAbilityBorderOpenable",0), Condition_AbilityString(String2Id( s )) )
                        set j=0
                        loop
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",0), "|cffffcc00"+I2S(GetAbilityBaseIntegerLevelFieldById( String2Id( s ), ABILITY_ILF_MANA_COST, j ))+"|r")
                        exitwhen j==GetAbilityBaseIntegerFieldById(String2Id( s ), ABILITY_IF_LEVELS)-1
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",0), "/")
                        set j=j+1
                        endloop
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",0), "\n\n"+GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_NAME )+", (|cffffcc00"+IntToChar(GetAbilityBaseIntegerFieldById( String2Id( s ), ABILITY_IF_BUTTON_HOTKEY_RESEARCH ))+"|r)\n\n"+GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SLF_TOOLTIP_LEARN_EXTENDED ))
                    elseif GetAbilityBaseIntegerFieldById( String2Id( s ), ABILITY_IF_BUTTON_HOTKEY_RESEARCH )=='W' then
                        call SetFrameTexture( GetFrameByName("TavernAbility",1), GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_ICON_NORMAL ), 0, true )
                        call SetFrameTexture( GetFrameByName("TavernAbility",1), GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_ICON_NORMAL ), 1, true )
                        call SetFrameTexture( GetFrameByName("TavernAbility",1), GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_ICON_NORMAL ), 2, true )
                        call ShowFrame( GetFrameByName("TavernAbilityBorderOpenable",1), Condition_AbilityString(String2Id( s )) )
                        set j=0
                        loop
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",1), "|cffffcc00"+I2S(GetAbilityBaseIntegerLevelFieldById( String2Id( s ), ABILITY_ILF_MANA_COST, j ))+"|r")
                        exitwhen j==GetAbilityBaseIntegerFieldById(String2Id( s ), ABILITY_IF_LEVELS)-1
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",1), "/")
                        set j=j+1
                        endloop
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",1), "\n\n"+GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_NAME )+", (|cffffcc00"+IntToChar(GetAbilityBaseIntegerFieldById( String2Id( s ), ABILITY_IF_BUTTON_HOTKEY_RESEARCH ))+"|r)\n\n"+GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SLF_TOOLTIP_LEARN_EXTENDED ))
                    elseif GetAbilityBaseIntegerFieldById( String2Id( s ), ABILITY_IF_BUTTON_HOTKEY_RESEARCH )=='E' then
                        call SetFrameTexture( GetFrameByName("TavernAbility",2), GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_ICON_NORMAL ), 0, true )
                        call SetFrameTexture( GetFrameByName("TavernAbility",2), GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_ICON_NORMAL ), 1, true )
                        call SetFrameTexture( GetFrameByName("TavernAbility",2), GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_ICON_NORMAL ), 2, true )
                        call ShowFrame( GetFrameByName("TavernAbilityBorderOpenable",2), Condition_AbilityString(String2Id( s )) )
                        set j=0
                        loop
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",2), "|cffffcc00"+I2S(GetAbilityBaseIntegerLevelFieldById( String2Id( s ), ABILITY_ILF_MANA_COST, j ))+"|r")
                        exitwhen j==GetAbilityBaseIntegerFieldById(String2Id( s ), ABILITY_IF_LEVELS)-1
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",2), "/")
                        set j=j+1
                        endloop                        
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",2), "\n\n"+GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_NAME )+", (|cffffcc00"+IntToChar(GetAbilityBaseIntegerFieldById( String2Id( s ), ABILITY_IF_BUTTON_HOTKEY_RESEARCH ))+"|r)\n\n"+GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SLF_TOOLTIP_LEARN_EXTENDED ))
                    elseif GetAbilityBaseIntegerFieldById( String2Id( s ), ABILITY_IF_BUTTON_HOTKEY_RESEARCH )=='R' then
                        call SetFrameTexture( GetFrameByName("TavernAbility",3), GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_ICON_NORMAL ), 0, true )
                        call SetFrameTexture( GetFrameByName("TavernAbility",3), GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_ICON_NORMAL ), 1, true )
                        call SetFrameTexture( GetFrameByName("TavernAbility",3), GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_ICON_NORMAL ), 2, true )
                        call ShowFrame( GetFrameByName("TavernAbilityBorderOpenable",3), Condition_AbilityString(String2Id( s )) )
                        set j=0
                        loop
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",3), "|cffffcc00"+I2S(GetAbilityBaseIntegerLevelFieldById( String2Id( s ), ABILITY_ILF_MANA_COST, j ))+"|r")
                        exitwhen j==GetAbilityBaseIntegerFieldById(String2Id( s ), ABILITY_IF_LEVELS)-1
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",3), "/")
                        set j=j+1
                        endloop                        
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",3), "\n\n"+GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_NAME )+", (|cffffcc00"+IntToChar(GetAbilityBaseIntegerFieldById( String2Id( s ), ABILITY_IF_BUTTON_HOTKEY_RESEARCH ))+"|r)\n\n"+GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SLF_TOOLTIP_LEARN_EXTENDED ))
                    elseif GetAbilityBaseIntegerFieldById( String2Id( s ), ABILITY_IF_BUTTON_HOTKEY_RESEARCH )=='T' then
                        call SetFrameTexture( GetFrameByName("TavernAbility",4), GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_ICON_NORMAL ), 0, true )
                        call SetFrameTexture( GetFrameByName("TavernAbility",4), GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_ICON_NORMAL ), 1, true )
                        call SetFrameTexture( GetFrameByName("TavernAbility",4), GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_ICON_NORMAL ), 2, true )
                        call ShowFrame( GetFrameByName("TavernAbilityBorderOpenable",4), Condition_AbilityString(String2Id( s )) )
                        set j=0
                        loop
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",4), "|cffffcc00"+I2S(GetAbilityBaseIntegerLevelFieldById( String2Id( s ), ABILITY_ILF_MANA_COST, j ))+"|r")
                        exitwhen j==GetAbilityBaseIntegerFieldById(String2Id( s ), ABILITY_IF_LEVELS)-1
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",4), "/")
                        set j=j+1
                        endloop                        
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",4), "\n\n"+GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_NAME )+", (|cffffcc00"+IntToChar(GetAbilityBaseIntegerFieldById( String2Id( s ), ABILITY_IF_BUTTON_HOTKEY_RESEARCH ))+"|r)\n\n"+GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SLF_TOOLTIP_LEARN_EXTENDED ))
                    endif
                    set i=i+1
                endloop
                call SetFrameTexture( GetFrameByName("TavernAbility",5), "UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp", 0, true )
                call SetFrameTexture( GetFrameByName("TavernAbility",5), "UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp", 1, true )
                call SetFrameTexture( GetFrameByName("TavernAbility",5), "UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp", 2, true )
                call SetFrameTexture( GetFrameByName("TavernAbility",6), "UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp", 0, true )
                call SetFrameTexture( GetFrameByName("TavernAbility",6), "UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp", 1, true )
                call SetFrameTexture( GetFrameByName("TavernAbility",6), "UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp", 2, true )

                set i=0
                loop
                exitwhen i * 4 >= len //TavernHeroAbilityIcon
                    set s = SubString( abilList2, i * 4, i * 4 + 4 )
                    if (GetAbilityBaseIntegerFieldById( String2Id( s ), ABILITY_IF_BUTTON_POSITION_NORMAL_X )==1 or GetAbilityBaseIntegerFieldById( String2Id( s ), ABILITY_IF_BUTTON_POSITION_NORMAL_X )==0) and GetAbilityBaseIntegerFieldById( String2Id( s ), ABILITY_IF_BUTTON_POSITION_NORMAL_Y )==1 then
                        call SetFrameText( GetFrameByName("TavernAbilityTooltipText",5), "     " )
                        call SetFrameTexture( GetFrameByName("TavernAbility",5), GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_ICON_NORMAL ), 0, true )
                        call SetFrameTexture( GetFrameByName("TavernAbility",5), GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_ICON_NORMAL ), 1, true )
                        call SetFrameTexture( GetFrameByName("TavernAbility",5), GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_ICON_NORMAL ), 2, true )
                        call ShowFrame( GetFrameByName("TavernAbilityBorderOpenable",5), Condition_AbilityString(String2Id( s )) )
                        set j=0
                        loop
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",5), "|cffffcc00"+I2S(GetAbilityBaseIntegerLevelFieldById( String2Id( s ), ABILITY_ILF_MANA_COST, j ))+"|r")
                        exitwhen j==GetAbilityBaseIntegerFieldById(String2Id( s ), ABILITY_IF_LEVELS)-1
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",5), "/")
                        set j=j+1
                        endloop   
                        if String2Id( s )=='A105' or String2Id( s )=='A0RS' or String2Id( s )=='A0IR' then
                            call AddFrameText( GetFrameByName("TavernAbilityTooltipText",5), "\n\n"+GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_NAME )+", (|cffffcc00"+IntToChar(GetAbilityBaseIntegerFieldById( String2Id( s ), ABILITY_IF_BUTTON_HOTKEY_NORMAL ))+"|r)\n\n"+GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SLF_TOOLTIP_LEARN_EXTENDED )) 
                        else                  
                            call AddFrameText( GetFrameByName("TavernAbilityTooltipText",5), "\n\n"+GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_NAME )+", (|cffffcc00"+IntToChar(GetAbilityBaseIntegerFieldById( String2Id( s ), ABILITY_IF_BUTTON_HOTKEY_NORMAL ))+"|r)\n\n"+GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SLF_TOOLTIP_NORMAL_EXTENDED ))
                        endif
                    elseif GetAbilityBaseIntegerFieldById( String2Id( s ), ABILITY_IF_BUTTON_POSITION_NORMAL_X )==2 and GetAbilityBaseIntegerFieldById( String2Id( s ), ABILITY_IF_BUTTON_POSITION_NORMAL_Y )==1 then
                        call SetFrameText( GetFrameByName("TavernAbilityTooltipText",6), "     " )
                        call SetFrameTexture( GetFrameByName("TavernAbility",6), GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_ICON_NORMAL ), 0, true )
                        call SetFrameTexture( GetFrameByName("TavernAbility",6), GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_ICON_NORMAL ), 1, true )
                        call SetFrameTexture( GetFrameByName("TavernAbility",6), GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_ICON_NORMAL ), 2, true )
                        call ShowFrame( GetFrameByName("TavernAbilityBorderOpenable",6), Condition_AbilityString(String2Id( s )) )
                        set j=0
                        loop
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",6), "|cffffcc00"+I2S(GetAbilityBaseIntegerLevelFieldById( String2Id( s ), ABILITY_ILF_MANA_COST, j ))+"|r")
                        exitwhen j==GetAbilityBaseIntegerFieldById(String2Id( s ), ABILITY_IF_LEVELS)-1
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",6), "/")
                        set j=j+1
                        endloop                        
                        if String2Id( s )=='A105' or String2Id( s )=='A0RS' or String2Id( s )=='A0IR' then
                            call AddFrameText( GetFrameByName("TavernAbilityTooltipText",6), "\n\n"+GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_NAME )+", (|cffffcc00"+IntToChar(GetAbilityBaseIntegerFieldById( String2Id( s ), ABILITY_IF_BUTTON_HOTKEY_NORMAL ))+"|r)\n\n"+GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SLF_TOOLTIP_LEARN_EXTENDED )) 
                        else                  
                            call AddFrameText( GetFrameByName("TavernAbilityTooltipText",6), "\n\n"+GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SF_NAME )+", (|cffffcc00"+IntToChar(GetAbilityBaseIntegerFieldById( String2Id( s ), ABILITY_IF_BUTTON_HOTKEY_NORMAL ))+"|r)\n\n"+GetAbilityBaseStringFieldById( String2Id( s ), ABILITY_SLF_TOOLTIP_NORMAL_EXTENDED ))
                        endif
                    endif
                    set i=i+1
                endloop
                call SetFrameSize( GetFrameByName("TavernAbilityTooltip",0), .26, GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",0))+0.03)
                call SetFrameSize( GetFrameByName("TavernAbilityTooltip",1), .26, GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",1))+0.03)
                call SetFrameSize( GetFrameByName("TavernAbilityTooltip",2), .26, GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",2))+0.03)
                call SetFrameSize( GetFrameByName("TavernAbilityTooltip",3), .26, GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",3))+0.03)
                call SetFrameSize( GetFrameByName("TavernAbilityTooltip",4), .26, GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",4))+0.03)
                call SetFrameSize( GetFrameByName("TavernAbilityTooltip",5), .26, GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",5))+0.03)
                call SetFrameSize( GetFrameByName("TavernAbilityTooltip",6), .26, GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",6))+0.03)
                if GetFrameTexture( GetFrameByName("TavernAbility",5),0)=="UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp" then
                    call ShowFrame(GetFrameByName("TavernAbility",5),false)
                else
                    call ShowFrame(GetFrameByName("TavernAbility",5),true)
                    call ShowFrame( GetFrameByName("TavernAbilityTooltip",5), false )
                endif
                if GetFrameTexture( GetFrameByName("TavernAbility",6),0)=="UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp" then
                    call ShowFrame(GetFrameByName("TavernAbility",6),false)
                else
                    call ShowFrame(GetFrameByName("TavernAbility",6),true)
                    call ShowFrame( GetFrameByName("TavernAbilityTooltip",6), false )
                endif
            else
                if RH_Force[GetFrameContext(but)]=='H01A' then
                    call SetFrameText( GetFrameByName("TavernAbilityTooltipText",0), "     " )
                    call SetFrameText( GetFrameByName("TavernAbilityTooltipText",1), "     " )
                    call SetFrameText( GetFrameByName("TavernAbilityTooltipText",2), "     " )
                    call SetFrameText( GetFrameByName("TavernAbilityTooltipText",3), "     " )
                    call SetFrameText( GetFrameByName("TavernAbilityTooltipText",4), "     " )
                    call SetFrameText( GetFrameByName("TavernAbilityTooltipText",5), "     " )
                    call ShowFrame(GetFrameByName("TavernAbility",5),true)
                    set j=0
                    loop
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",0), "|cffffcc00"+I2S(GetAbilityBaseIntegerLevelFieldById( String2Id( "A0A3" ), ABILITY_ILF_MANA_COST, j ))+"|r")
                        exitwhen j==GetAbilityBaseIntegerFieldById(String2Id( "A0A3" ), ABILITY_IF_LEVELS)-1
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",0), "/")
                        set j=j+1
                    endloop
                    set j=0
                    loop
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",1), "|cffffcc00"+I2S(GetAbilityBaseIntegerLevelFieldById( String2Id( "A01E" ), ABILITY_ILF_MANA_COST, j ))+"|r")
                        exitwhen j==GetAbilityBaseIntegerFieldById(String2Id( "A01E" ), ABILITY_IF_LEVELS)-1
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",1), "/")
                        set j=j+1
                    endloop
                    set j=0
                    loop
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",2), "|cffffcc00"+I2S(GetAbilityBaseIntegerLevelFieldById( String2Id( "A0A6" ), ABILITY_ILF_MANA_COST, j ))+"|r")
                        exitwhen j==GetAbilityBaseIntegerFieldById(String2Id( "A0A6" ), ABILITY_IF_LEVELS)-1
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",2), "/")
                        set j=j+1
                    endloop
                    set j=0
                    loop
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",3), "|cffffcc00"+I2S(GetAbilityBaseIntegerLevelFieldById( String2Id( "A0B9" ), ABILITY_ILF_MANA_COST, j ))+"|r")
                        exitwhen j==GetAbilityBaseIntegerFieldById(String2Id( "A0B9" ), ABILITY_IF_LEVELS)-1
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",3), "/")
                        set j=j+1
                    endloop
                    set j=0
                    loop
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",4), "|cffffcc00"+I2S(GetAbilityBaseIntegerLevelFieldById( String2Id( "A02J" ), ABILITY_ILF_MANA_COST, j ))+"|r")
                        exitwhen j==GetAbilityBaseIntegerFieldById(String2Id( "A02J" ), ABILITY_IF_LEVELS)-1
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",4), "/")
                        set j=j+1
                    endloop
                    set j=0
                    loop
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",5), "|cffffcc00"+I2S(GetAbilityBaseIntegerLevelFieldById( String2Id( "A0A2" ), ABILITY_ILF_MANA_COST, j ))+"|r")
                        exitwhen j==GetAbilityBaseIntegerFieldById(String2Id( "A0A2" ), ABILITY_IF_LEVELS)-1
                        call AddFrameText( GetFrameByName("TavernAbilityTooltipText",5), "/")
                        set j=j+1
                    endloop
                    call SetFrameTexture( GetFrameByName("TavernAbility",0), GetAbilityBaseStringFieldById( String2Id( "A0A3" ), ABILITY_SF_ICON_NORMAL ), 0, true )
                    call SetFrameTexture( GetFrameByName("TavernAbility",0), GetAbilityBaseStringFieldById( String2Id( "A0A3" ), ABILITY_SF_ICON_NORMAL ), 1, true )
                    call SetFrameTexture( GetFrameByName("TavernAbility",0), GetAbilityBaseStringFieldById( String2Id( "A0A3" ), ABILITY_SF_ICON_NORMAL ), 2, true )
                    call SetFrameTexture( GetFrameByName("TavernAbility",1), GetAbilityBaseStringFieldById( String2Id( "A01E" ), ABILITY_SF_ICON_NORMAL ), 0, true )
                    call SetFrameTexture( GetFrameByName("TavernAbility",1), GetAbilityBaseStringFieldById( String2Id( "A01E" ), ABILITY_SF_ICON_NORMAL ), 1, true )
                    call SetFrameTexture( GetFrameByName("TavernAbility",1), GetAbilityBaseStringFieldById( String2Id( "A01E" ), ABILITY_SF_ICON_NORMAL ), 2, true )
                    call SetFrameTexture( GetFrameByName("TavernAbility",2), GetAbilityBaseStringFieldById( String2Id( "A0A6" ), ABILITY_SF_ICON_NORMAL ), 0, true )
                    call SetFrameTexture( GetFrameByName("TavernAbility",2), GetAbilityBaseStringFieldById( String2Id( "A0A6" ), ABILITY_SF_ICON_NORMAL ), 1, true )
                    call SetFrameTexture( GetFrameByName("TavernAbility",2), GetAbilityBaseStringFieldById( String2Id( "A0A6" ), ABILITY_SF_ICON_NORMAL ), 2, true )
                    call SetFrameTexture( GetFrameByName("TavernAbility",3), GetAbilityBaseStringFieldById( String2Id( "A0B9" ), ABILITY_SF_ICON_NORMAL ), 0, true )
                    call SetFrameTexture( GetFrameByName("TavernAbility",3), GetAbilityBaseStringFieldById( String2Id( "A0B9" ), ABILITY_SF_ICON_NORMAL ), 1, true )
                    call SetFrameTexture( GetFrameByName("TavernAbility",3), GetAbilityBaseStringFieldById( String2Id( "A0B9" ), ABILITY_SF_ICON_NORMAL ), 2, true )
                    call SetFrameTexture( GetFrameByName("TavernAbility",4), GetAbilityBaseStringFieldById( String2Id( "A02J" ), ABILITY_SF_ICON_NORMAL ), 0, true )
                    call SetFrameTexture( GetFrameByName("TavernAbility",4), GetAbilityBaseStringFieldById( String2Id( "A02J" ), ABILITY_SF_ICON_NORMAL ), 1, true )
                    call SetFrameTexture( GetFrameByName("TavernAbility",4), GetAbilityBaseStringFieldById( String2Id( "A02J" ), ABILITY_SF_ICON_NORMAL ), 2, true )
                    call SetFrameTexture( GetFrameByName("TavernAbility",5), GetAbilityBaseStringFieldById( String2Id( "A0A2" ), ABILITY_SF_ICON_NORMAL ), 0, true )
                    call SetFrameTexture( GetFrameByName("TavernAbility",5), GetAbilityBaseStringFieldById( String2Id( "A0A2" ), ABILITY_SF_ICON_NORMAL ), 1, true )
                    call SetFrameTexture( GetFrameByName("TavernAbility",5), GetAbilityBaseStringFieldById( String2Id( "A0A2" ), ABILITY_SF_ICON_NORMAL ), 2, true )
                    call SetFrameTexture( GetFrameByName("TavernAbility",6), "UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp", 0, true )
                    call SetFrameTexture( GetFrameByName("TavernAbility",6), "UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp", 1, true )
                    call SetFrameTexture( GetFrameByName("TavernAbility",6), "UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp", 2, true )
                    call AddFrameText( GetFrameByName("TavernAbilityTooltipText",0), "\n\n"+GetAbilityBaseStringFieldById( String2Id( "A0A3" ), ABILITY_SF_NAME )+", (|cffffcc00Q|r)\n\n"+GetAbilityBaseStringFieldById( String2Id( "A0A3" ), ABILITY_SLF_TOOLTIP_LEARN_EXTENDED ))
                    call AddFrameText( GetFrameByName("TavernAbilityTooltipText",1), "\n\n"+GetAbilityBaseStringFieldById( String2Id( "A01E" ), ABILITY_SF_NAME )+", (|cffffcc00W|r)\n\n"+GetAbilityBaseStringFieldById( String2Id( "A01E" ), ABILITY_SLF_TOOLTIP_LEARN_EXTENDED ))
                    call AddFrameText( GetFrameByName("TavernAbilityTooltipText",2), "\n\n"+GetAbilityBaseStringFieldById( String2Id( "A0A6" ), ABILITY_SF_NAME )+", (|cffffcc00E|r)\n\n"+GetAbilityBaseStringFieldById( String2Id( "A0A6" ), ABILITY_SLF_TOOLTIP_LEARN_EXTENDED ))
                    call AddFrameText( GetFrameByName("TavernAbilityTooltipText",3), "\n\n"+GetAbilityBaseStringFieldById( String2Id( "A0B9" ), ABILITY_SF_NAME )+", (|cffffcc00R|r)\n\n"+GetAbilityBaseStringFieldById( String2Id( "A0B9" ), ABILITY_SLF_TOOLTIP_LEARN_EXTENDED ))
                    call AddFrameText( GetFrameByName("TavernAbilityTooltipText",4), "\n\n"+GetAbilityBaseStringFieldById( String2Id( "A02J" ), ABILITY_SF_NAME )+", (|cffffcc00T|r)\n\n"+GetAbilityBaseStringFieldById( String2Id( "A02J" ), ABILITY_SLF_TOOLTIP_LEARN_EXTENDED ))
                    call AddFrameText( GetFrameByName("TavernAbilityTooltipText",5), "\n\n"+GetAbilityBaseStringFieldById( String2Id( "A0A2" ), ABILITY_SF_NAME )+", (|cffffcc00F|r)\n\n"+GetAbilityBaseStringFieldById( String2Id( "A0A2" ), ABILITY_SLF_TOOLTIP_NORMAL_EXTENDED ))
                    call ShowFrame( GetFrameByName("TavernAbilityBorderOpenable",5), true )
                    call SetFrameText( GetFrameByName("TavernAbilityTooltipText",6), "Описание способностей" )
                    call SetFrameSize( GetFrameByName("TavernAbilityTooltip",0), .26, GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",0))+0.03)
                    call SetFrameSize( GetFrameByName("TavernAbilityTooltip",1), .26, GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",1))+0.03)
                    call SetFrameSize( GetFrameByName("TavernAbilityTooltip",2), .26, GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",2))+0.03)
                    call SetFrameSize( GetFrameByName("TavernAbilityTooltip",3), .26, GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",3))+0.03)
                    call SetFrameSize( GetFrameByName("TavernAbilityTooltip",4), .26, GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",4))+0.03)
                    call SetFrameSize( GetFrameByName("TavernAbilityTooltip",5), .26, GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",5))+0.03)
                    call SetFrameSize( GetFrameByName("TavernAbilityTooltip",6), .26, GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",6))+0.03)
                    call ShowFrame(GetFrameByName("TavernAbility",6),false)
                endif
            endif
            set j=0
            loop
                call SetFrameTextAlignment( GetFrameByName("TavernAbilityTooltipText",j), TEXT_JUSTIFY_LEFT, TEXT_JUSTIFY_LEFT )
                call SetFrameRelativePoint( GetFrameByName("TavernAbilityTooltip",j), FRAMEPOINT_CENTER, GetFrameByName("TavernAbility",j), FRAMEPOINT_CENTER,  .13, (-0.5*GetFrameHeight( GetFrameByName("TavernAbilityTooltipText",j)))-.02  )
                exitwhen j>7
                set j=j+1
            endloop
        endif
    endif
    set p = null
    set but = null
    set selector = null
endfunction

function Trig_Table2_Actions takes nothing returns nothing
call TriggerExecute(gg_trg_Dialog2)
endfunction
function Trig_Table_Actions2 takes nothing returns nothing
if udg_button2==false then
call DialogDisplay(Player(0),udg_Dialog, false )
call DialogClear(udg_Dialog)
set udg_button2=true
call TriggerExecute(gg_trg_Dialog2)
endif
endfunction
function Trig_Table_Actions takes nothing returns nothing
set udg_Dialog=DialogCreate()
call DialogClear(udg_Dialog)
call DialogSetMessage(udg_Dialog,"Choice Mode")
set udg_Button[5]=DialogAddButton(udg_Dialog,"FFA: OFF",0)
set udg_Button[1]=DialogAddButton(udg_Dialog,"Standard Mode",0)
set udg_Button[4]=DialogAddButton(udg_Dialog,"Ban Mode",0)
set udg_Button[2]=DialogAddButton(udg_Dialog,"Random Mode",0)
if maxplayers==10 then
set udg_Button[3]=DialogAddButton(udg_Dialog,"Captain Mode",0)
endif
if udg_test==false then
call DialogDisplay(Player(0),udg_Dialog,true)
call TriggerRegisterDialogEvent(gg_trg_Dialog2,udg_Dialog)
call TriggerRegisterDialogEvent(gg_trg_Dialog3,udg_Dialog)
call DestroyTrigger(GetTriggeringTrigger())
endif
call GroupEnumUnitsInRange(G,0,0,99999999,null)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if GetUnitTypeId(E)=='htow' then
call SetUnitVertexColor(E,255,255,255,0)
endif
call GroupRemoveUnit(G,E)
endloop
if udg_test==false then
call TimerStart(CreateTimer(), 15, false, function Trig_Table_Actions2 )
endif        
endfunction
function InitTrig_Table takes nothing returns nothing
set gg_trg_Table=CreateTrigger()
call TriggerRegisterTimerEventSingle(gg_trg_Table,10)
if ValidHLC() then
call TriggerAddAction(gg_trg_Table,function Trig_Table2_Actions)
else
call TriggerAddAction(gg_trg_Table,function Trig_Table_Actions)
endif
endfunction
function Trig_Dialog3_Conditions takes nothing returns boolean
return GetClickedButton()==udg_Button[5]
endfunction
function Trig_Dialog3_Actions takes nothing returns nothing
if FFAMode==false then
set udg_Dialog=DialogCreate()
call DialogClear(udg_Dialog)
call DialogSetMessage(udg_Dialog,"Choice Mode")
set udg_Button[5]=DialogAddButton(udg_Dialog,"FFA: ON",0)
set udg_Button[1]=DialogAddButton(udg_Dialog,"Standard Mode",0)
set udg_Button[4]=DialogAddButton(udg_Dialog,"Ban Mode",0)
set udg_Button[2]=DialogAddButton(udg_Dialog,"Random Mode",0)
//set udg_Button[3]=DialogAddButton(udg_Dialog,"Captain Mode",0)
call DialogDisplay(Player(0),udg_Dialog,true)
call TriggerRegisterDialogEvent(gg_trg_Dialog2,udg_Dialog)
call TriggerRegisterDialogEvent(gg_trg_Dialog3,udg_Dialog)
set FFAMode=true
//set DamageOff=false
else
set udg_Dialog=DialogCreate()
call DialogClear(udg_Dialog)
call DialogSetMessage(udg_Dialog,"Choice Mode")
set udg_Button[5]=DialogAddButton(udg_Dialog,"FFA: OFF",0)
set udg_Button[1]=DialogAddButton(udg_Dialog,"Standard Mode",0)
set udg_Button[4]=DialogAddButton(udg_Dialog,"Ban Mode",0)
set udg_Button[2]=DialogAddButton(udg_Dialog,"Random Mode",0)
if maxplayers==10 then
set udg_Button[3]=DialogAddButton(udg_Dialog,"Captain Mode",0)
endif
call DialogDisplay(Player(0),udg_Dialog,true)
call TriggerRegisterDialogEvent(gg_trg_Dialog2,udg_Dialog)
call TriggerRegisterDialogEvent(gg_trg_Dialog3,udg_Dialog)
set FFAMode=false
//set DamageOff=true
endif
endfunction
function InitTrig_Dialog3 takes nothing returns nothing
set gg_trg_Dialog3=CreateTrigger()
call TriggerAddCondition(gg_trg_Dialog3,Condition(function Trig_Dialog3_Conditions))
call TriggerAddAction(gg_trg_Dialog3,function Trig_Dialog3_Actions)
endfunction
function Trig_Dialog2_Conditions takes nothing returns boolean
return GetClickedButton()==udg_Button[1]or GetClickedButton()==udg_Button[2]or GetClickedButton()==udg_Button[3]or GetClickedButton()==udg_Button[4]
endfunction
function Trig_Dialog2_Actions takes nothing returns nothing
local integer i
local integer id
local real x1=GetRectCenterX(gg_rct_Rect1)
local real y1=GetRectCenterY(gg_rct_Rect1)
local group g=CreateGroup()
local group g2=CreateGroup()
local unit e
local unit array u
local integer typ1=0
local button bu
local framehandle gameUI=GetOriginFrame( ORIGIN_FRAME_GAME_UI, 0 )
local framehandle consoleUI=GetOriginFrame( ORIGIN_FRAME_CONSOLE_UI, 0 )
local framehandle UIFiller
local framehandle TavernHeroGrid
// local framehandle TavernHeroGridText
local framehandle TavernHeroAbilityGrid
local framehandle TavernHeroAdditionalAbilityGrid
// local framehandle TavernHeroAbilityGridText
local framehandle TavernHeroAbilityIcon
local framehandle TavernHeroAbilityTooltip
local framehandle TavernHeroAbilityTooltipIcon
local framehandle TavernHeroAbilityTooltipText
local framehandle TavernHeroAdditionalAbilityIcon
local framehandle TavernHeroAdditionalAbilityTooltip
local framehandle TavernHeroAdditionalAbilityTooltipIcon
local framehandle TavernHeroAdditionalAbilityTooltipText
// local framehandle TavernCMIcon
local framehandle TavernCMIconTooltip
// local framehandle TavernCMText
local framehandle TavernCMGrid
local framehandle TavernCMHero
local framehandle TavernCMStatus
local framehandle SelectedHeroGrid
local framehandle SelectedHeroIcon
local framehandle HeroTavernIcon
local framehandle HeroTavernIconStats
local framehandle HeroTavernIconOpenable
local framehandle HoverHeroTavernIcon
local framehandle HoverHeroTavernIconText
local trigger tOnPress = null
local trigger tOnUnPress = null 
local trigger tOnClick = null
local trigger toggleStatus = null
local trigger tOnHover = null
local trigger tOnUnHover = null 
local integer x=0
local integer y=0
local integer GrX=0
local integer GrY=0

if udg_test==false then
    call EditBlackBorders( .0, .0 ) // -.02, .13 | to return to default 
    call HideOriginFrames( true )
    call ShowFrame( StatusBarFrame, false)
    call ShowFrame( CloseStatusButton, false)
    call ShowFrame( OpenStatusButton, false)
    // call SetFramePriority( StatusBarFrame, 1 )
    // call SetFramePriority( CloseStatusButton, 1 )
    // call SetFramePriority( OpenStatusButton, 1 )
    call ShowFrame( GetOriginFrame( ORIGIN_FRAME_MULTIBOARD, 0 ), false )   
    set TavernHeroFrame=CreateFrameByType("SIMPLEFRAME", "TavernBar", null, "", 0)
    call ClearFrameAllPoints( TavernHeroFrame )
    call SetFrameRelativePoint( TavernHeroFrame, FRAMEPOINT_CENTER, gameUI, FRAMEPOINT_CENTER,  0, 0  )
    call SetFrameSize( TavernHeroFrame, 0.815, .615)
    call SetFrameTexture(TavernHeroFrame, "StatsBackGround.tga",0,true)
    call SetFrameTexture(TavernHeroFrame, "StatsBackGround.tga",1,true)
    call SetFrameTexture(TavernHeroFrame, "StatsBackGround.tga",2,true)
