set soundplay=SndN(2305) // Sound\Music\mp3Music\SasukeSusano.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SaveUnitHandle(h,GetHandleId(u),SusanoCnst,n)
call TimerStart(t,0.03,true,function SusanoSasukeCast2)
set u=null
set t=null
endfunction
