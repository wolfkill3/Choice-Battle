set x0=PolX(x0,350,facing)
set y0=PolY(y0,350,facing)
call DamageAoeOneTime(casterOriginal,x0,y0,aoe,damage,LoadGroupHandle(HH,id,4))
endif
//if(GetLocalPlayer()==GetOwningPlayer(caster))then
//call DisplayTextToPlayer(GetLocalPlayer(),0,0,"time left"+R2S(time))
//endif
if time==0.42 then
call ForGroup(LoadGroupHandle(HH,id,4),function SabracEPassiveActR)
endif
call GroupClear(LoadGroupHandle(HH,id,4))
endif
call SaveReal(HH,id,6,time1)
endif
if time==2.02 then
call SetUnitAnimationByIndex(caster,8)
call DestroyGroup(LoadGroupHandle(HH,id,4))
call UnitSpeed(caster,1)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
set caster=null
set casterOriginal=null
endfunction







function CloneAddCD takes unit caster,unit n000 returns nothing
local integer i=0
local integer itemId=0
local real abilCd=0
local ability itemid2
//local integer i0=0
call SetUnitFlyHeight(n000,GetUnitFlyHeight(caster),0)
call UnitAddAbility(n000,'SaT2')
call SetHeroLevel(n000,GetHeroLevel(caster),false)
call SetUnitPathing(n000,true)

//call SetUnitBaseDamageByIndex(n00,0,GetHeroStr(caster,false)+20+LoadInteger(HH,GetHandleId(caster),SabracSwordsHash)*5)
//call SetUnitBaseDamageByIndex(n00,0,GetHeroStr(caster,false)+20+LoadInteger(HH,GetHandleId(caster),SabracSwordsHash)*5)
//call SetUnitBaseDamageByIndex(n,0,100+GetHeroInt(udg_Hero[ip+1],true)*2)
set i=GetHeroStr(caster,false)+LoadInteger(HH,GetHandleId( (GetOwningPlayer( caster )) ),SabracSwordsHash)*3


call SetUnitBaseDamageByIndex(n000,0,i)




call SetHeroAgi(n000,GetHeroAgi(caster,false),true)
call SetHeroStr(n000,GetHeroStr(caster,false),true)
call SetHeroInt(n000,GetHeroInt(caster,false),true)
set i=0
loop
exitwhen i>=6

//and GetItemTypeId(UnitItemInSlot(caster,i))!='I02R'  and GetItemTypeId(UnitItemInSlot(caster,i))!='I02S'  and GetItemTypeId(UnitItemInSlot(caster,i))!='I02T'

if GetItemTypeId(UnitItemInSlot(caster,i))!='Io39'   then
