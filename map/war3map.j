function ShadowSlashAct2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local group ng=LoadGroupHandle(h,id,1)
local integer i=1
local real x=LoadReal(h,id,50)
local real y=LoadReal(h,id,51)
local real x1=0
local real y1=9
local real f
local real dist
local real dmg=GetHeroAgi(u,true)*9
local integer l__idg=GetHandleId(ng)
local player p=GetOwningPlayer(u)
call UnitApplyTimedLife(CreateUnit(p,'e08J',x,y,GetRandomReal(0,359)),'BTLF',2)
loop
exitwhen i>12
set n=LoadUnitHandle(h,id,1+i)
set dist=LoadReal(h,id,StringHash("dist"+I2S(i)))+60
call SaveReal(h,id,StringHash("Dist"+I2S(i)),dist)
set f=GetUnitFacing(n)*bj_DEGTORAD
set x1=x+dist*Cos(f)
set y1=y+dist*Sin(f)
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UndeadDissipate\\UndeadDissipate.mdl",x1,y1))
call SetUnitX(n,x1)
call SetUnitY(n,y1)
set i=i+1
endloop
call GroupEnumUnitsInRange(ng,x,y,dist,Base)
loop
set E=FirstOfGroup(ng)
exitwhen E==null
set ide=GetHandleId(E)
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,ide)then
call myCustomDamage(ks,E,dmg,false,false,null,null,null)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\CarrionSwarm\\CarrionSwarmDamage.mdl",E,"chest"))
call SaveUnitHandle(h,l__idg,ide,E)
endif
call GroupRemoveUnit(ng,E)
endloop
if dist>=700 then
call UnitApplyTimedLife(CreateUnit(p,'e029',x,y,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e029',x,y,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e029',x,y,GetRandomReal(0,359)),'BTLF',2)
call DestroyGroup(ng)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
set p=null
set ng=null
set u=null
set t=null
endfunction
function ShadowSlashAct takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real r=0.
local player p=GetOwningPlayer(u)
local integer i=1
loop
exitwhen i>12
set r=i*30.
set n=CreateUnit(p,0x65303846,x,y,r)
call UnitApplyTimedLife(n,'BTLF',0.5)
call SaveUnitHandle(h,id,1+i,n)
set i=i+1
endloop
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,1,CreateGroup())
call SaveReal(h,id,50,x)
call SaveReal(h,id,51,y)
call UnitApplyTimedLife(CreateUnit(p,'e08K',x,y,GetRandomReal(0,359)),'BTLF',2)
call TimerStart(t,.03,true,function ShadowSlashAct2)
set u=null
set t=null
set p=null
endfunction
