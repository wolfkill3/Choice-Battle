local real f
local real dist=SR(x,y,x1,y1)
local real time=LoadReal(h,id,3)
local real dmg=(3+GetUnitAbilityLevel(u,'Ad9R'))*GetHeroAgi(u,true)*0.5
if time<2.3 then
    call SaveReal(h,id,3,time+0.03)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
    if time>1.8 and time<2 then
        call SetUnitXY_1(c,x1+11*Cos(a),y1+11*Sin(a), false)
    endif
    if time!=0.9 then
        call PauseUnit(u,true)
        call SetUnitInvulnerable(u,true)
        call PauseUnit(c,true)
        call SetUnitInvulnerable(c,true)
    endif
    if time==1.95 then
        set EFF=AddSpecialEffect("tx_huoyandaji_blue.mdl",x1,y1)
        call SetSpecialEffectScale(EFF , 0.85)
        call RemoveEffect(EFF,0.5,true,CreateTimer())
        set n=CreateUnit(p,'e168',x1,y1,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,1,0.01)
        call SetUnitFlyHeight(n,0,220)
        call SetUnitScale(n,3,3,3)
        call SetUnitVertexColor(n,255,255,255,165)
        call SetUnitTimeScale(n,1.6)
        set EFF=AddSpecialEffect("chushou_by_wood_effect_earth_sandycrack_fag.mdl",x1,y1)
        //call SetSpecialEffectScale(EFF , 1.)
        call RemoveEffect(EFF,0.8,false,CreateTimer())
    endif
    if time==0.9 or time==1.05 or time==1.2 or time==1.35 then
        set n=CreateUnit(p,'e2DM',x1,y1,GetRandomReal(0,359))
        call UnitEnableAutoOrientation(n,false)
        call SetUnitOrientation(n,GetRandomReal(-180,180),90,0)
        call UnitApplyTimedLife(n,1,0.3)
        if time!=1.35 and time!=1.2 and time!=1.05 then
        set EFF=AddSpecialEffect("tx_huoyandaji_blue.mdl",x1,y1)
        call SetSpecialEffectScale(EFF , 0.85)
        call RemoveEffect(EFF,0.6,true,CreateTimer())
        set EFF=AddSpecialEffect("tx_huoyandaji_blue.mdl",x1,y1)
        call SetSpecialEffectScale(EFF , 0.85)
        call SetSpecialEffectZ(EFF , 250)
        call RemoveEffect(EFF,0.6,true,CreateTimer())
        set n=CreateUnit(p,'e168',x1,y1,GetRandomReal(0,359))
        call SetUnitModel(n,"Others\\JeanneDark1mt_baozha1.mdl")
        call UnitApplyTimedLife(n,1,0.03)
        call SetUnitScale(n,0.7,0.7,0.7)
        call SetUnitVertexColor(n,255,255,255,165)
        call SetUnitTimeScale(n,1.6)
        set n=CreateUnit(p,'e168',x1,y1,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,1,0.01)
        call SetUnitFlyHeight(n,0,220)
        call SetUnitScale(n,2,2,2)
        call SetUnitVertexColor(n,255,255,255,165)
        call SetUnitTimeScale(n,3)
        endif
        set n=CreateUnit(p,'e166',x1,y1,GetRandomReal(0,359))
        call UnitEnableAutoOrientation(n,false)
        call SetUnitOrientation(n,GetRandomReal(-180,180),GetRandomReal(-45,45),GetRandomReal(-45,45))
        call SetUnitFlyHeight(n,0,220)
        call UnitApplyTimedLife(n,1,0.6)
        call SetUnitScale(n,2.5,2.5,2.5)
        call SetUnitTimeScale(n,1.2)
        set n=CreateUnit(p,'e166',x1,y1,GetRandomReal(0,359))
        call UnitEnableAutoOrientation(n,false)
        call SetUnitOrientation(n,GetRandomReal(-180,180),GetRandomReal(-45,45),GetRandomReal(-45,45))
        call SetUnitFlyHeight(n,0,220)
        call UnitApplyTimedLife(n,1,0.6)
        call SetUnitScale(n,2.5,2.5,2.5)
        call SetUnitTimeScale(n,1.2)
    endif
    if time==1.35 then
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\DantesR3.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
    endif
    if time==1.8 then
        call SetUnitAnimationByIndex(u,4)
        call SetUnitOrientation(u,GetUnitFacing(u),-35,0)
        call SetUnitOrientation(c,GetUnitFacing(u),-90,0)
        call SetUnitFlyHeight(c,0,800)
        call SetUnitXY_1(u,x+30*Cos(a),y+30*Sin(a), false)
        call UnitEnableAutoOrientation(c,false)
        set EFF=AddSpecialEffect("DantesRSlash.mdx", x+30*Cos(a), y+30*Sin(a))
        call SetSpecialEffectScale(EFF , 2.7)
        call SetSpecialEffectTimeScale(EFF , 0.7)
        call SetSpecialEffectZ(EFF , 90)
        call SetSpecialEffectOrientation(EFF , a * bj_RADTODEG,0,90)
        call SetSpecialEffectVertexColour(EFF , 100 , 100 , 255 , 250)
        call DestroyEffect(EFF)
