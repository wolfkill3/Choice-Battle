if GetUnitAbilityLevel(caster,'BHK3')>0 then
call UnitRemoveAbility(caster,'BHK3')
endif
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
set caster=null
endfunction
