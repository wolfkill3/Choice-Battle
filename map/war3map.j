function Trig_Bone_Wawe_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A018'
endfunction
function Trig_Bone_Wawe_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=LoadReal(h,id,1)
local real y=LoadReal(h,id,2)
local real a=Atan2(LoadReal(h,id,4)-y,LoadReal(h,id,3)-x)
local real l__d=LoadReal(h,id,5)
local group g=LoadGroupHandle(h,id,6)
local integer l__idg=GetHandleId(g)
local player p=GetOwningPlayer(u)
local integer l__ide
local real dmg=100*GetUnitAbilityLevel(u,'A018')+GetUnitAbilityLevel(u,'A018')*GetHeroAgi(u,true)
if l__d<1500 then
set x=x+l__d*Cos(a)
set y=y+l__d*Sin(a)
if l__d<1300 then
set n=CreateUnit(p,'e338',x,y,a*bj_RADTODEG)
call SetUnitFlyHeight(n,65,0)
call SetUnitTimeScale(n,2)
call UnitApplyTimedLife(n,'BTLF',0.3)
endif
call SetUnitXY_1(LoadUnitHandle(h,id,5),x,y,false)
call SaveReal(h,id,5,l__d+75)
call GroupEnumUnitsInRange(g,x,y,200,Base)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set l__ide=GetHandleId(E)
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,l__ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,l__idg,l__ide,E)
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",E,"chest"))
call SlowUnit(u,E,0.5,0,5,0,false)
endif
call GroupRemoveUnit(g,E)
endloop
else
call UnitApplyTimedLife(LoadUnitHandle(h,id,5),'BTLF',0.02)
call DestroyTimer(t)
call DestroyGroup(g)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
set p=null
set u=null
set g=null
set t=null
endfunction
function Trig_Bone_Wawe_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveGroupHandle(h,id,6,CreateGroup())
call SaveReal(h,id,5,100)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,GetUnitX(u))
call SaveReal(h,id,2,GetUnitY(u))
call SaveReal(h,id,3,GetSpellTargetX())
call SaveReal(h,id,4,GetSpellTargetY())
set n=CreateUnit(GetOwningPlayer(u),'e1SS',GetSpellTargetX(),GetSpellTargetY(),Atan2(GetSpellTargetY()-GetUnitY(u),GetSpellTargetX()-GetUnitX(u))*bj_RADTODEG)
call SetUnitFlyHeight(n,65,0)
call SetUnitTimeScale(n,3)
call SaveUnitHandle(h,id,5,n)
set soundplay=SndN(852) // Sound\Music\mp3Music\KimimaroQ.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
