local real time=LoadReal(HH,idu,StringHash("yamatotime"))
local player p=GetOwningPlayer(u)
if time<10 and LoadReal(HH,idu,StringHash("yamato"))==1 then
if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
call SaveReal(HH,idu,StringHash("yamatotime"),time+0.05)
endif
else
call SaveReal(HH,idu,StringHash("yamatotime"),10)
