call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
call SetUnitTimeScale(u,1.5)
set soundplay=SndN(2756) // Sound\Music\mp3Music\AtalantaR.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.7,true,function RAtalantaCast2)
set u=null
set p=null
set c=null
set t=null
