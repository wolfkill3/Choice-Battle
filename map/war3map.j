endfunction
function SkyMareCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real time=LoadReal(h,id,2)
if time>0 and GetUnitAbilityLevel(u,'cbc5')==0 then
        call SaveReal(h,id,2,time-0.1)
        call DestroyEffect(AddSpecialEffect("war3mapImported\\BlinkCaster.mdx",x,y))
        call UnitRemoveAbility(u,'A0J4')
        call UnitRemoveAbility(u,'A128')
        call UnitRemoveAbility(u,'A15F')
        call UnitRemoveAbility(u,'A224')
        //call UnitRemoveAbility(u, 'cbc3')
        //call UnitRemoveAbility(u, 'CBC2')
        call UnitRemoveBuffs(u,false,true)
        call UnitRemoveAbility(u, 'A1VJ')
        call UnitRemoveAbility(u, 'IHYs')
        call UnitRemoveAbility(u, 'IOb3')
    call UnitRemoveAbility(u, 'CBC1')
else
call SaveReal(h,id,2,11)
    call UnitRemoveAbility(u, 'CE04')
    call UnitRemoveAbility(u, 'CB03')
    call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set t=null
set u=null
endfunction
function SkyMareCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local real x=GetUnitX(c)
local real y=GetUnitY(c)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,1,c)
call SaveReal(h,id,2,2)
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlinkCaster.mdx",x,y))
call UnitRemoveAbility(c,'A0J4')
call UnitRemoveAbility(c,'A128')
call UnitRemoveAbility(c,'A15F')
call UnitRemoveAbility(c, 'cbc3')
call UnitRemoveAbility(c, 'cbc7')
call UnitRemoveAbility(c, 'CBC1')
call UnitRemoveAbility(c, 'CBC2')
call UnitRemoveAbility(c, 'A1VJ')
call UnitRemoveAbility(c, 'IHYs')
call UnitRemoveAbility(c, 'IOb3')
call UnitAddAbility(c,'CE04')
call UnitRemoveAbility(c, 'A2VJ')
call UnitRemoveAbility(c, 'AoSV')
call UnitRemoveAbility(c, 'A1SV')
// call SaveBoolean(h, GetHandleId(u), StringHash("GinT_Boolean"), false)
call HealTextTag(u,c,GetUnitState(c,UNIT_STATE_MAX_LIFE)*0.12*myCustomHeal2(c,1),"HealthRes")
call SetUnitState(c,UNIT_STATE_LIFE,GetWidgetLife(c)+GetUnitState(c,UNIT_STATE_MAX_LIFE)*0.12)
call TimerStart(t,0.1,true,function SkyMareCast2)
set t=null
set u=null
set c=null
endfunction
