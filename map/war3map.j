call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,GetSpellTargetX())
call SaveReal(h,id,2,GetSpellTargetY())
call SaveReal(h,id,6,0)
set soundplay=SndN(2286) // Sound\Music\mp3Music\Amaterasu.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SaveUnitHandle(h,id,3,CreateUnit(GetOwningPlayer(u),0x65303448,GetUnitX(u),GetUnitY(u),GetUnitFacing(u)))
call TimerStart(t,0.1,true,function Trig_Amaterasu_Actions2)
set t=null
set u=null
endfunction
