function SetNameAct takes nothing returns nothing
local integer ip=GetPlayerId(GetTriggerPlayer())
local integer id=GetHandleId(Hero[ip])
local string  s = SubString(GetEventPlayerChatString(), 9, 25)
call SetPlayerName(GetTriggerPlayer(), s)
set AdminNickname=s
call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "New Name: "+s)
call UpdateMultiboard()
endfunction
function SetPlayerNameCond takes nothing returns boolean
set P=GetTriggerPlayer()
return GetPlayerName(GetTriggerPlayer())=="knowyourplace" or GetPlayerName(GetTriggerPlayer())=="WorldEdit" or GetPlayerName(GetTriggerPlayer())==AdminNickname
endfunction
function SetPlayerNameAct takes nothing returns nothing
local integer ip=GetPlayerId(GetTriggerPlayer())
local integer id=GetHandleId(Hero[ip])
local integer p = S2I(SubString(GetEventPlayerChatString(), 15, 16))-1
local string  s = SubString(GetEventPlayerChatString(), 17, 40)
call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "Player: "+I2S(p))
call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "NewNick: "+s)
if p>=0 and p<10 then
        if GetPlayerName(Player(p))==AdminNickname or GetPlayerName(Player(p))=="WorldEdit" then
                call SetPlayerName(Player(p), s)
                set AdminNickname=s
        else
                call SetPlayerName(Player(p), s)
        endif
endif
call UpdateMultiboard()
endfunction
