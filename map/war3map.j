call SaveReal(h,id,3,GetSpellTargetY())

if LoadBoolean(HH,GetHandleId(u),SH_XanFBuff)==true then
call SaveBoolean(HH,GetHandleId(u),SH_XanFBuff,false)
call SaveReal(h,id,15,GetHeroAgi(u,true)*(GetUnitAbilityLevel(u,'A110')+3)+75+(GetHeroAgi(u,true)*(GetUnitAbilityLevel(u,'A110')+3)+75)*GetUnitAbilityLevel(u,'B05E')*0.3)
else
call SaveReal(h,id,15,GetHeroAgi(u,true)*(GetUnitAbilityLevel(u,'A110')+2)+75+(GetHeroAgi(u,true)*(GetUnitAbilityLevel(u,'A110')+2)+75)*GetUnitAbilityLevel(u,'B05E')*0.3)
endif

