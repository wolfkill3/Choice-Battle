call UnitRemoveAbility(u,'B02Z')
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call PauseTimer(t)
call SaveReal(h,id,11,a)
call TimerStart(t,0.01,true,function RedHawkCast3)
else
call SetUnitAnimation(u,"Spell Four Two")
set n=CreateUnit(p,'e043',x+75*Cos(a),y+75*Sin(a),a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitScale(n,1.3,1.3,1.3)
call SaveUnitHandle(h,id,7,CreateUnit(p,'e045',x+65*Cos(a),y+65*Sin(a),a*bj_RADTODEG))
call UnitRemoveAbility(u,'A1FU')
call UnitRemoveAbility(u,'Pet1')
call TriggerClearActions(tt)
call DestroyTrigger(tt)
call UnitRemoveAbility(u,'B00A')
call UnitRemoveAbility(u,'B02Z')
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call PauseTimer(t)
call SaveReal(h,id,11,a)
call TimerStart(t,0.01,true,function ThorElephantCast3)
endif
endif
set p=null
set u=null
set t=null
endfunction
function RedHawkCast takes nothing returns nothing //red
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=GetUnitFacing(u)*bj_DEGTORAD
local trigger tt=CreateTrigger()
call SaveUnitHandle(h,id,0,u)
call SaveTriggerHandle(h,id,1,tt)
call SaveReal(h,id,10,0.75)
call SaveReal(h,id,13,0.4)
call SaveReal(h,id,14,100)
call SaveReal(h,id,15,0.3)
call SaveReal(h,id,11,a)
call SaveReal(h,id,17,2)
call SetUnitInvulnerable(u,true)
call SetUnitAcquireRange(u,51)
call SaveGroupHandle(h,id,12,CreateGroup())
if GetUnitAbilityLevel(u,'LuG3')==0 then
call SaveReal(h,id,2,1000)
call SaveReal(h,id,4,(GetUnitAbilityLevel(u,'A0ZJ')+3)*GetHeroAgi(u,true)+100)
call SetUnitTimeScale(u,0.1)
set soundplay=SndN(868) // Sound\Music\mp3Music\RedHawk.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call UnitAddAbility(u,'A0ZI')
else
call SaveReal(h,id,2,1500)
call SaveReal(h,id,4,(((GetUnitAbilityLevel(u,'A0ZJ')+3)*GetHeroAgi(u,true))+100)*1.25)
call SetUnitAnimation(u,"Spell One Two")
set soundplay=SndN(870) // Sound\Music\mp3Music\One Piece Luffy Thor Elephant Gun.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call UnitAddAbility(u,'A1FU') //Slow
call UnitAddAbility(u,'Pet1')
call StartAbilityCooldown(GetUnitAbility(u,'A0ZJ'),GetAbilityRemainingCooldown(GetUnitAbility(u,'A0ZJ')))
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerAddAction(tt,function LuffyRedStopOrders)
call TimerStart(t,0.1,true,function RedHawkCast2)
set u=null
set p=null
set t=null
endfunction
function NejiWCond takes nothing returns boolean
return GetSpellAbilityId()=='A34E'
endfunction
function NejiWCast4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,44)
local unit nj=LoadUnitHandle(h,id,46)
local real time=LoadReal(h,id,33)
// бьём по самому врагу: точка — где он сейчас, а не где стоял в момент атаки
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(nj)
local real y1=GetUnitY(nj)
local real a=Atan2(y-y1,x-x1)
// own: паузу врагу ставит стойка (враг не был в паузе) — тогда она же её и снимает.
// Чужую паузу (враг в своей способности) и неуязвимость врага не трогаем.
local boolean own=LoadBoolean(h,id,47)
local boolean hit=false
local real dmg=GetUnitTotalDamage(nj)+(1+GetUnitAbilityLevel(nj,'A34E'))*GetHeroAgi(nj,true)
call SaveReal(h,id,33,time+0.02)
if u==null or UnitIsAlive(u)==false or UnitIsAlive(nj)==false or udg_B==false then
    // враг пропал или умер, Неджи умер, конец раунда — отпускаем без удара
    set hit=false
elseif SR(x1,y1,x,y)<80 and time>=0.5 then
    set hit=true
else
    if time<0.5 then
        call IssueImmediateOrder(u,"stop")
        if own then
            call PauseUnit(u,true)
        endif
        call UnitRemoveAbility(u,'BHds')
        call UnitRemoveAbility(u,'B02T')
        call UnitRemoveAbility(u,'B039')
    endif
    if time>=0.5 and time<3 then
        if own then
            call PauseUnit(u,true)
        endif
        call SetUnitTimeScale(nj,0.3*time)
        call SetUnitFacing(nj,a*bj_RADTODEG)
        call SetUnitXY_1(nj,x1+80*Cos(a),y1+80*Sin(a), false)
        set n=CreateUnit(GetOwningPlayer(nj),'e1GZ',x1,y1,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',0.15)
        call SetUnitVertexColor(n,190,255,255,60)
        call ShikiCloneEffect(n,1.5,1.05,1.25,150)
        call SetUnitAnimation(n,"attack")
    endif
    if time>=3 then
        call SetUnitXY_1(nj,x-40*Cos(a),y-40*Sin(a), false)
    endif
    set t=null
    set u=null
    set nj=null
    return
endif
// ---- конец контратаки (удар или обрыв)
if own and u!=null then
    // сначала снять паузу, потом урон: по юниту в паузе урон режется вдвое
    call PauseUnit(u,false)
    call SaveBoolean(HH,GetHandleId(u),TARGET_ABILITY,false)
endif
call UnitRemoveAbility(nj,'A0GN')
call SetUnitInvulnerable(nj,false)
call SetUnitTimeScale(nj,1)
call PauseUnit(nj,false)
if hit then
    call SetUnitXY_1(nj,x-40*Cos(a),y-40*Sin(a), false)
    if LoadAbilityHandle(h,id,45)!=null then
        call StartAbilityCooldown(LoadAbilityHandle(h,id,45),10)
    endif
    call UnitRemoveAbility(u,'BHds')
    call UnitRemoveAbility(u,'B02T')
    call UnitRemoveAbility(u,'B039')
    if LoadBoolean(HH,GetHandleId(u),ANTITARGET_ABILITY)==false then
        call myCustomDamage(nj,u,dmg,false,false,null,null,null)
        call SetControlToUnit(nj,u, 0.5+GetUnitAbilityLevel(nj,'A34E')*0.5, "silenceTE")
        call Push3(u,40,a,400,"")
    else
        // враг разворачивает чужие умения — отдаём ему Неджи, без урона
        call SaveUnitHandle(HH,GetHandleId(u),REVERSE_TARGET,nj)
    endif
    set EFF=AddSpecialEffect("NejiWJuiken.mdx", x, y)
    call SetSpecialEffectFacing(EFF , a* bj_RADTODEG)
    call SetSpecialEffectZ(EFF , 100)
    call SetSpecialEffectScale(EFF , 0.6)
    call SetSpecialEffectVertexColour(EFF,255,255,255,120)
    call RemoveEffect(EFF,1,true,CreateTimer())
    set EFF=AddSpecialEffect("WindVectorPush.mdx", x, y)
    call SetSpecialEffectFacing(EFF , a* bj_RADTODEG)
    call SetSpecialEffectZ(EFF , 40)
    call SetSpecialEffectScale(EFF , 0.6)
    call SetSpecialEffectVertexColour(EFF,255,255,255,220)
    call RemoveEffect(EFF,1,true,CreateTimer())
endif
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
set t=null
set u=null
set nj=null
endfunction
function NejiWCast31 takes nothing returns nothing
local unit u=GetAttacker()
local trigger tt=GetTriggeringTrigger()
local unit nj=LoadUnitHandle(h,GetHandleId(tt),0)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,44,u)
call SaveUnitHandle(h,id,46,nj)
// паузу ставим и снимаем сами, только если враг не был в паузе от своей способности
call SaveBoolean(h,id,47,IsUnitPaused(u)==false)
call IssueImmediateOrder(u,"stop")
call PauseUnit(nj,true)
call SetUnitInvulnerable(nj,true)
call SaveReal(h,id,33,0)
set soundplay=SndN(872) // Sound\Music\mp3Music\NejiW2.mp3
call StartSound(soundplay)
call SetUnitAnimation(nj,"Spell Two")
call UnitAddAbility(nj,'A0GN')
call UnitRemoveAbility(u,'BHds')
call UnitRemoveAbility(u,'B02T')
call UnitRemoveAbility(u,'B039')
call IssueImmediateOrder(u,"stop")
call SetUnitTimeScale(nj,2)
// триггер только выключаем: удаляет оба триггера таймер стойки (NejiWCast2).
// Раньше он удалялся тут и второй раз там — второе удаление било по чужому триггеру с тем же номером.
call DisableTrigger(tt)
call TimerStart(t,0.02,true,function NejiWCast4)
set u=null
set nj=null
set t=null
set tt=null
endfunction
function NejiWCast3 takes nothing returns nothing
local unit u=GetTriggerUnit()
local trigger tt=GetTriggeringTrigger()
local unit nj=LoadUnitHandle(h,GetHandleId(tt),0)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,44,u)
call SaveUnitHandle(h,id,46,nj)
// паузу ставим и снимаем сами, только если враг не был в паузе от своей способности
call SaveBoolean(h,id,47,IsUnitPaused(u)==false)
call SaveAbilityHandle(h,id,45,GetSpellAbility())
call IssueImmediateOrder(u,"stop")
call PauseUnit(nj,true)
call SetUnitInvulnerable(nj,true)
call SaveReal(h,id,33,0)
set soundplay=SndN(872) // Sound\Music\mp3Music\NejiW2.mp3
call StartSound(soundplay)
call SetUnitAnimation(nj,"Spell Two")
call UnitAddAbility(nj,'A0GN')
call UnitRemoveAbility(u,'BHds')
call UnitRemoveAbility(u,'B02T')
call UnitRemoveAbility(u,'B039')
call IssueImmediateOrder(u,"stop")
// триггер только выключаем: удаляет оба триггера таймер стойки (NejiWCast2).
// Раньше он удалялся тут и второй раз там — второе удаление било по чужому триггеру с тем же номером.
call DisableTrigger(tt)
call TimerStart(t,0.02,true,function NejiWCast4)
set u=null
set nj=null
set t=null
set tt=null
endfunction
function NejiWCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit nj=LoadUnitHandle(h,id,7)
local trigger tt=LoadTriggerHandle(h,id,5)
local trigger tt2=LoadTriggerHandle(h,id,6)
if GetUnitCurrentOrder(nj)!=OrderId("channel")then
if nj!=null then
call SetUnitTimeScale(nj,1)
call SetUnitAnimation(nj,"Stand")
if GetUnitAbilityLevel(nj,'A0GN')==0 then
    call SetControlToUnit(nj , nj , 0.5 , "doomdebug")
endif
endif
// оба триггера удаляются только здесь и один раз
call FlushChildHashtable(h,GetHandleId(tt))
call FlushChildHashtable(h,GetHandleId(tt2))
call TriggerClearActions(tt)
call DestroyTrigger(tt)
call TriggerClearActions(tt2)
call DestroyTrigger(tt2)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set nj=null
set t=null
set tt=null
set tt2=null
endfunction
function NejiWCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local trigger tt=CreateTrigger()
local trigger tt2=CreateTrigger()
local unit nj=GetTriggerUnit()
// общий Neji больше не используется стойкой: каждый каст хранит своего Неджи в триггерах и таймерах
set Neji=nj
call SetUnitTimeScale(nj,0.3)
set soundplay=SndN(874) // Sound\Music\mp3Music\NejiW1.mp3
call StartSound(soundplay)
call SaveUnitHandle(h,GetHandleId(tt),0,nj)
call SaveUnitHandle(h,GetHandleId(tt2),0,nj)
call TriggerRegisterAnyUnitEventBJ(tt2,EVENT_PLAYER_UNIT_SPELL_CHANNEL)
call TriggerRegisterAnyUnitEventBJ(tt2,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(tt2,Condition(function NejiWCond3))
call TriggerAddAction(tt2,function NejiWCast3)
call SaveTriggerHandle(h,id,6,tt2)
call TriggerRegisterUnitEvent(tt,nj,EVENT_UNIT_ATTACKED)
call TriggerAddAction(tt,function NejiWCast31)
call TriggerAddCondition(tt,Condition(function NejiWCond2))
call SaveTriggerHandle(h,id,5,tt)
call SaveUnitHandle(h,id,7,nj)
call TimerStart(t,0.005,true,function NejiWCast2)
set nj=null
set t=null
set tt=null
set tt2=null
endfunction
function InitTrig_NejiW takes nothing returns nothing
set gg_trg_NejiW=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_NejiW,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_NejiW,Condition(function NejiWCond))
call TriggerAddAction(gg_trg_NejiW,function NejiWCast)
endfunction
function GatlingGunCond takes nothing returns boolean
return GetSpellAbilityId()=='A0RX'
endfunction
function Slash_GatlingGun2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local player p=GetOwningPlayer(l__d)
local unit u=Hero[GetPlayerId(p)]
local real speed=LoadReal(h,id,1)
local real x=LoadReal(h,id,3)
local real y=LoadReal(h,id,4)
local group g=LoadGroupHandle(h,id,5)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,2)
local real dmg=LoadReal(h,id,6)
local real Range=LoadReal(h,id,9)
if SR(x,y,x1,y1)<=Range then
call SetUnitXY_1(l__d,x1+speed*Cos(a),y1+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call GroupEnumUnitsInRange(g,x1,y1,LoadReal(h,id,10),Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetUnitX(E,GetUnitX(E)+17*Cos(a))
call SetUnitY(E,GetUnitY(E)+17*Sin(a))
call SetControlToUnit(E,E, 0.12, "stun")
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
else
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,GetHandleId(g))
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function Slash_GatlingGun takes unit l__d,real speed,real dmg,real angle,real range,real mas,real x,real y,real x1,real y1 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle)
call SaveGroupHandle(h,id,5,CreateGroup())
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,6,dmg)
call SaveReal(h,id,9,range)
call SaveReal(h,id,10,mas)
call TimerStart(t,0.025,true,function Slash_GatlingGun2)
set t=null
endfunction
function GatlingGunCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local real x2
local real y2
local real he
local real r
local real r2=GetRandomReal(-50,50)
local real angle=(GetUnitFacing(u)+90)*bj_DEGTORAD
local real a=Atan2(y1-y,x1-x)
local real a2=GetRandomReal(-0.5,0.5)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroAgi(u,true)*(0.3+0.1*GetUnitAbilityLevel(u,'A0RX'))
if GetUnitCurrentOrder(u)==OrderId("channel")then
if GetUnitAbilityLevel(u,'LuG3')==0 then
set r=GetRandomReal(-135,135)
set x2=x+r*Cos(a+deg90)
set y2=y+r*Sin(a+deg90)
set n=CreateUnit(p,'e0H9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.7)
call SetUnitVertexColor(n,200,200,200,70)
set n=CreateUnit(p,'e0QD',x2,y2,(a)*bj_RADTODEG)
call SetUnitFlyHeight(n,GetRandomReal(45,110),0)
call Slash_GatlingGun(n,65,dmg,(a),GetRandomReal(900,1200),50,x2,y2,x1,y1)
else
set r=GetRandomReal(-135,135)
set x2=x+r*Cos(a+deg90)
set y2=y+r*Sin(a+deg90)
set n=CreateUnit(p,'e0QD',x2,y2,(a+a2)*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,0)
set he=GetRandomReal(45,110)
call SetUnitFlyHeight(n,he,0)
call Slash_GatlingGun(n,85,dmg*1.25,(a+a2),800,80,x2,y2,x1,y1)
set n=CreateUnit(p,'e0QE',x2,y2,(a+a2)*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.35)
call SetUnitTimeScale(n,2.5)
call SetUnitFlyHeight(n,he,0)
set x2=x+50*Cos(a)
set y2=y+50*Sin(a)
set n=CreateUnit(p,'e043',x2+r2*Cos(a+deg90),y2+r2*Sin(a+deg90),(a+a2)*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.40)
endif
else
call SetUnitInvulnerable(u,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set t=null
endfunction
