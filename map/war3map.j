local real y=GetSpellTargetY()
local real x1=0
local real y1=0
local real r=0
local real a=0
local real a1=0
local integer i=0
local real dmg=(0.05+(0.05*GetUnitAbilityLevel(u,'A0GG')))*GetHeroAgi(u,true)+5
loop
exitwhen i>=24
set a=15*i*bj_DEGTORAD
set r=GetRandomReal(500,700)
