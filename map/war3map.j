function PoisonDamage6Mukuro takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local real per=LoadReal(h,id,3)
local real i=LoadReal(h,id,5)
local unit u=LoadUnitHandle(h,id,4)
local unit c=LoadUnitHandle(h,id,1)
local real dmg=LoadReal(h,id,2)
local real dmg2=LoadReal(h,id,6)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(c)
local real y=GetUnitY(c)
local group g
if i<per then
    if IsUnitPaused(c)==false and GetUnitAbilityLevel(c,'Pet1')==0 then
        call SaveReal(h,id,5,i+0.1)
        if ModuloReal(i,0.5)<0.1 then
            call myCustomDamage(u,c,dmg/per,false,false,null,null,null)
            call EffectToRandomBone("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",c)
            call DestroyEffect(AddSpecialEffectTarget("feathercrow.mdx",c,"chest"))
        endif
    endif
else
    //call DestroyEffect(AddSpecialEffect("war3mapImported\\explode.mdx",x,y))
    set EFF=AddSpecialEffect("AZ_anyemoW_R.mdx",x,y)
    call SetSpecialEffectScale(EFF,0.2)
    call SetSpecialEffectZ(EFF,50)
    call DestroyEffect(EFF)
    set EFF=AddSpecialEffect("Others\\[A]BY_Wood_Kong.mdl",x,y)
    call SetSpecialEffectScale(EFF,0.7)
    call SetSpecialEffectZ(EFF,100)
    call DestroyEffect(EFF)
    call DestroyEffect(AddSpecialEffect("Others\\[A]BY_Wood_FenShenDaBaoPo_2.mdl",x,y))
    set EFF=AddSpecialEffect("by_wood_effect_yuzhiboyou_unusual_fenshendabaopo_1.mdx",x,y)
    call SetSpecialEffectScale(EFF,1.3)
    call SetSpecialEffectZ(EFF,100)
    call DestroyEffect(EFF)
    set g=CreateGroup()
    call GroupEnumUnitsInRange(g,x,y,250,Base)
    loop
    set E=FirstOfGroup(g)
    exitwhen E==null
    if Condition_Base(p,E) then
    call myCustomDamage(u,E,dmg2,false,false,null,null,null)
    endif
    call GroupRemoveUnit(g,E)
    endloop
    call DestroyGroup(g)
	call DestroyEffect(LoadEffectHandle(h,id,0))
    call DestroyEffect(LoadEffectHandle(h,id,7))
    call DestroyEffect(LoadEffectHandle(h,id,8))
	call FlushChildHashtable(h,id)
	call PauseTimer(GetExpiredTimer())
	call DestroyTimer(GetExpiredTimer())
endif
set g=null
set p=null
set c=null
set u=null
endfunction
