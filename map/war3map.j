call MissleMoveSabakuKyuE(u,c,CreateUnit(p,'e0FJ',x,y,f),110,GetRandomReal(-1,1),0)
call MissleMoveSabakuKyuE(u,c,CreateUnit(p,'e0FJ',x,y,f),110,GetRandomReal(-1,1),0)
call MissleMoveSabakuKyuE(u,c,CreateUnit(p,'e0FJ',x,y,f),110,GetRandomReal(-1,1),0)
call MissleMoveSabakuKyuE(u,c,CreateUnit(p,'e0FJ',x,y,f),110,GetRandomReal(-1,1),0)
