call SetSoundVolumeBJ(soundplay,100)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call TimerStart(t,0.1,true,function ArchersBowCast2)
set u=null
set p=null
set t=null
endfunction
function MissleMoveKatsuya2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,4)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local integer ip=GetPlayerId(GetOwningPlayer(l__d))
local real a=Atan2(y1-y,x1-x)+angle
local group g=LoadGroupHandle(h,GetHandleId(Hero[ip]),SH_kuchiyose)
if SR(x,y,x1,y1)>30 then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
else
call UnitAddAbility(c,'A149')
call UnitMakeAbilityPermanent(c,true,'A149')
call GroupAddUnit(g,c)
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set c=null
set l__d=null
set t=null
endfunction
function MissleMoveKatsuya takes unit l__d,real speed,real angle,unit target,string l__s,real dmg,unit damager returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveStr(h,id,3,l__s)
call SaveUnitHandle(h,id,4,target)
call SaveReal(h,id,5,dmg)
call SaveUnitHandle(h,id,6,damager)
call TimerStart(t,0.035,true,function MissleMoveKatsuya2)
set t=null
endfunction
function KatsuyaFly2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
local real dist=LoadReal(h,id,6)
local real mh=LoadReal(h,id,5)
local real rad=LoadReal(h,id,7)
local real rd=SR(x,y,x1,y1)
local real dmg=LoadReal(h,id,8)
local player p=GetOwningPlayer(l__d)
local integer idu=GetPlayerId(p)
if rd>30+speed and IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,ParabolaZ(mh,dist,rd),0)
else
call GroupEnumUnitsInRange(G,x1,y1,rad,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(Hero[idu],E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(G,E)
endloop
call UnitApplyTimedLife(CreateUnit(p,'e0EB',x,y,GetRandomReal(0,359)),'BHwe',3)
call UnitApplyTimedLife(CreateUnit(p,'e0EA',x,y,GetRandomReal(0,359)),'BHwe',3)
call UnitApplyTimedLife(CreateUnit(p,'e0EM',x1,y1,GetRandomReal(0,359)),'BHwe',5)
call UnitApplyTimedLife(CreateUnit(p,'e0EN',x1,y1,GetRandomReal(0,359)),'BHwe',3)
call KillUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set l__d=null
set t=null
endfunction
function KatsuyaFly takes unit l__d,real speed,real angle,real x,real y,real mh,real r,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,mh)
call SaveReal(h,id,6,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,7,r)
call SaveReal(h,id,8,dmg)
call TimerStart(t,0.02,true,function KatsuyaFly2)
set t=null
endfunction
function KatsuyaCond takes nothing returns boolean
return GetSpellAbilityId()=='A148'
endfunction
function KatsuyaCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local real x=LoadReal(HH,id,1)
local real y=LoadReal(HH,id,2)
local real x1=LoadReal(HH,id,3)
local real y1=LoadReal(HH,id,4)
local integer idu=GetHandleId(u)
local unit l__d=LoadUnitHandle(HH,id,6)
local real a=LoadReal(HH,id,5)
local real x2=0
local real y2=0
local integer i=0
local player p=GetOwningPlayer(u)
set x2=x-500*Cos(a)
set y2=y-500*Sin(a)
set n=CreateUnit(p,'e0XT',x2,y2,a*bj_RADTODEG)
call SetUnitScale(n,1.5,1.5,1.5)
call KatsuyaFly(n,40,0,x1,y1,GetRandomReal(300,500),600,GetHeroStr(u,true)*(5+GetUnitAbilityLevel(u,'A148')))
loop
exitwhen i>=6
set n=CreateUnit(p,'e0XT',x2,y2,a*bj_RADTODEG)
call SetUnitScale(n,1.5,1.5,1.5)
call KatsuyaFly(n,GetRandomReal(35,45),GetRandomReal(-1.6,1.6),x1+GetRandomReal(-300,300),y1+GetRandomReal(-300,300),GetRandomReal(300,500),0,0)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\ChimaeraAcidMissile\\ChimaeraAcidMissile.mdl",l__d,"head"))
set i=i+1
endloop
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
set t=null
set l__d=null
set u=null
set p=null
endfunction
function KatsuyaCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local integer idu=GetHandleId(u)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real x2=0
local real y2=0
local integer i=0
local unit l__d
local group g
set x2=x-500*Cos(a)
set y2=y-500*Sin(a)
set E=CreateUnit(p,'e0KF',x+35*Cos(a),y+35*Sin(a),GetRandomReal(0,359))
call UnitApplyTimedLife(E,'BTLF',0.25)
call SetUnitTimeScale(E,0.65)
call SetUnitAnimation(E,"Birth")
if LoadInteger(h,idu,SH_kuchiyose)!=1 then
call SaveInteger(h,idu,SH_kuchiyose,1)
call SaveGroupHandle(h,idu,SH_katsuya,CreateGroup())
endif
set g=LoadGroupHandle(h,idu,SH_katsuya)
call GroupEnumUnitsInRange(G,x,y,10000,Base)
call GroupRemoveUnit(G,u)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if UnitIsAlive(E)==true and IsUnitType(E,UNIT_TYPE_HERO)and IsUnitAlly(E,p)and GetUnitAbilityLevel(E,'A149')==0 then
set n=CreateUnit(p,'e0XS',x,y,0)
call MissleMoveKatsuya(n,20,0,E,"",0,u)
call GroupAddUnit(g,E)
call SetUnitScale(n,0.75,0.75,0.75)
endif
call GroupRemoveUnit(G,E)
endloop
call UnitApplyTimedLife(CreateUnit(p,'e0KE',x2,y2,GetRandomReal(0,359)),'BTLF',0.3)
call UnitApplyTimedLife(CreateUnit(p,'e0KG',x2,y2,GetRandomReal(0,359)),'BTLF',0.5)
set l__d=CreateUnit(p,'e0XS',x2,y2,a*bj_RADTODEG)

call SetUnitModel(l__d,"Katsuya1.mdl")
call SetUnitAnimation(l__d,"Spell")
call UnitApplyTimedLife(l__d,'BTLF',3)
call SetUnitTimeScale(l__d,3)
if GetUnitTypeId(u)=='H05D' then
set soundplay=SndN(2376) // Sound\Others\SakuraR.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
call SetUnitAnimation(u,"Spell Slam")
set soundplay=SndN(2378) // Sound\Music\mp3Music\TsunadeR2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call SaveUnitHandle(HH,id,0,u)
call SaveReal(HH,id,1,x)
call SaveReal(HH,id,2,y)
call SaveReal(HH,id,3,x1)
call SaveReal(HH,id,4,y1)
call SaveReal(HH,id,5,a)
call SaveUnitHandle(HH,id,6,l__d)
call TimerStart(t,1,false,function KatsuyaCast2)
set t=null
set l__d=null
set g=null
set u=null
set p=null
endfunction
function ByakugoCond takes nothing returns boolean
return GetSpellAbilityId()=='A141'
endfunction
function ByakugoCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real time=LoadReal(h,id,5)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real l=GetWidgetLife(u)
local real m=GetWidgetMana(u)
local real lm=GetUnitState(u,UNIT_STATE_MAX_LIFE)
local real mm=GetUnitState(u,UNIT_STATE_MAX_MANA)
local group g=LoadGroupHandle(h,GetHandleId(u),SH_katsuya)
local group g2
if time<25 and UnitIsAlive(u) and udg_B then
if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
call SaveReal(h,id,5,time+0.1)
call HealTextTag(u,u,lm*0.0025*myCustomHeal2(u,1),"HealthRes")
call SetUnitState(u,UNIT_STATE_LIFE,l+lm*0.0025)
call HealTextTag(u,u,mm*0.0025*myCustomMana2(u,1),"ManaRes")
call SetUnitState(u,UNIT_STATE_MANA,m+mm*0.0025)
set g2=CopyGroup(g)
loop
set E=FirstOfGroup(g2)
exitwhen E==null
if IsUnitAlly(E,p) and IsUnitAlive(E) then
if GetUnitAbilityLevel(u,'A143')>0 then
call HealTextTag(u,E,GetUnitState(E,UNIT_STATE_MAX_LIFE)*0.00125*myCustomHeal2(E,1),"HealthRes")
call SetUnitState(E,UNIT_STATE_LIFE,GetWidgetLife(E)+GetUnitState(E,UNIT_STATE_MAX_LIFE)*0.00125)
endif
if GetUnitAbilityLevel(u,'A147')>0 then
call HealTextTag(u,E,GetUnitState(E,UNIT_STATE_MAX_MANA)*0.00125*myCustomMana2(E,1),"ManaRes")
call SetUnitState(E,UNIT_STATE_MANA,GetWidgetMana(E)+GetUnitState(E,UNIT_STATE_MAX_MANA)*0.00125)
endif
call HealTextTag(u,E,GetUnitState(E,UNIT_STATE_MAX_LIFE)*0.0025*myCustomHeal2(E,1),"HealthRes")
call SetUnitState(E,UNIT_STATE_LIFE,GetWidgetLife(E)+GetUnitState(E,UNIT_STATE_MAX_LIFE)*0.0025)
call HealTextTag(u,E,GetUnitState(E,UNIT_STATE_MAX_MANA)*0.0025*myCustomMana2(E,1),"ManaRes")
call SetUnitState(E,UNIT_STATE_MANA,GetWidgetMana(E)+GetUnitState(E,UNIT_STATE_MAX_MANA)*0.0025)
endif
call GroupRemoveUnit(g2,E)
endloop
call DestroyGroupTimed(g2,3)
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DevourMagic\\DevourMagicBirthMissile.mdl",u,"head"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DevourMagic\\DevourMagicBirthMissile.mdl",u,"left hand"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DevourMagic\\DevourMagicBirthMissile.mdl",u,"right hand"))
else
call UnitRemoveAbility(u,'A144')
call UnitRemoveAbility(u,'A18U')
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call AddUnitAnimationProperties(u,"alternate",false)
endif
set g=null
set g2=null
set u=null
set t=null
endfunction
