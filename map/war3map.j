function MadaraERinneganAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real dmg=LoadReal(HH,id,35)
set time=time+0.02
call SaveReal(HH,id,5,time)
if time==0.5 then


call GroupClear(G)
call GroupEnumUnitsInRange(G,LoadReal(HH,id,11),LoadReal(HH,id,12),400,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if Condition_Base(GetOwningPlayer(caster),n0)  then
call myCustomDamage(caster,n0,dmg,false,false,null,null,null)
call SetControlToUnit(caster,n0, 1, "stun")
call EffectCreateAndMove(true,"Madara\\EffecthPush.mdl",Angle2(GetUnitX(n0),GetUnitY(n0),LoadReal(HH,id,11),LoadReal(HH,id,12))-180,1,0.5,0.75,100,60,60,0,100,n0,0,facing)
call EffectCreateAndMove(true,"Madara\\afbcronoseffect1.mdl",Angle2(GetUnitX(n0),GetUnitY(n0),LoadReal(HH,id,11),LoadReal(HH,id,12))-180,1,1.5,0.5,100,100,100,0,100,n0,0,facing)
call EffectCreateAndMove(true,"Madara\\RimboHit.mdl",Angle2(GetUnitX(n0),GetUnitY(n0),LoadReal(HH,id,11),LoadReal(HH,id,12))-180,1,3,0.5,100,100,100,0,100,n0,0,facing)
endif
if IsUnitAlly(n0,GetOwningPlayer(caster))==false then
call PushTimedMadara(n0,Angle2(GetUnitX(n0),GetUnitY(n0),LoadReal(HH,id,11),LoadReal(HH,id,12)),800,LoadReal(HH,id,11),LoadReal(HH,id,12),-40)
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)

call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
else
if time<0.3 then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
endif
if time==0.3 then
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
endif
if time==0.02 then
set n0=CreateUnit(GetOwningPlayer(caster),'e200',LoadReal(HH,id,11),LoadReal(HH,id,12),GetUnitFacing(caster))
call SetUnitModel(n0,"Madara\\AOE2m.mdl")
