set gg_trg_EnkiduF=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_EnkiduF,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_EnkiduF,Condition(function EnkiduFCond))
call TriggerAddAction(gg_trg_EnkiduF,function EnkiduFCast)
endfunction

function QDantesCond takes nothing returns boolean
return GetSpellAbilityId()=='Ad6Q'
endfunction
function QDantesCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=LoadReal(h,id,1)
local real y=LoadReal(h,id,2)
local real a=Atan2(LoadReal(h,id,4)-y,LoadReal(h,id,3)-x)
local real l__d=LoadReal(h,id,5)
local group g=LoadGroupHandle(h,id,6)
local group g2=LoadGroupHandle(h,id,16)
local player p=GetOwningPlayer(u)
local real dmg=(2+GetUnitAbilityLevel(u,'Ad6Q'))*GetHeroAgi(u,true)
local real l__s=LoadReal(h,id,8)
local real speed=LoadReal(h,id,14)
local real time=LoadReal(h,id,15)
local integer l__idg=GetHandleId(g)
local integer l__ide
if l__d<2500 then
if GetUnitAbilityLevel(u, 'CB01') > 0 then
        set dmg = dmg * 1.15
endif
set x=x+l__d*Cos(a)
set y=y+l__d*Sin(a)
set n=CreateUnit(p,'ed7X',x,y,(a*bj_RADTODEG))
call SetUnitScale(n,l__s+0.5,l__s+0.5,l__s+0.5)
call SetUnitTimeScale(n,0.15)
call UnitApplyTimedLife(n, 'BTLF', 1)
call GroupAddUnit(g2,n)
call SaveReal(h,id,15,time+speed)
if time>50 then
set n=CreateUnit(p,'ed9T',x,y,(a*bj_RADTODEG))
call SetUnitTimeScale(n,3)
call UnitApplyTimedLife(n, 'BTLF', 1)
call GroupAddUnit(g2,n)
call SaveReal(h,id,15,0)
endif
if l__s<0.9 then
call SaveReal(h,id,8,l__s+0.18)
endif
call SaveReal(h,id,14,speed+1.5)
call UnitApplyTimedLife(n,1,1.5)
call SaveReal(h,id,5,l__d+speed)
call GroupEnumUnitsInRange(g,x,y,150+15*l__s,Base)
set l__idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set l__ide=GetHandleId(E)
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,l__ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,l__idg,l__ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
else
loop
set E=FirstOfGroup(g2)
exitwhen E==null
call SetUnitTimeScale(E,2)
call GroupRemoveUnit(g2,E)
endloop
if GetUnitAbilityLevel(u, 'CB01') > 0 then
        call UnitRemoveAbility(u, 'CE01')
        call UnitRemoveAbility(u, 'CB01')
endif
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call SetUnitTimeScale(u,1)
set l__idg=GetHandleId(g)
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
call DestroyGroup(g2)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
set p=null
set g=null
set g2=null
set u=null
set g=null
set t=null
endfunction
function QDantesCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
local player p=GetOwningPlayer(u)
set x=x+75*Cos(a)
set y=y+75*Sin(a)
        set soundplay=CreateSound("Sound\\war3mapImported\\EdmondQ.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
call SaveGroupHandle(h,id,6,CreateGroup())
call SaveGroupHandle(h,id,16,CreateGroup())
call SaveUnitHandle(h,id,0,u)
call SetUnitTimeScale(u,1.5)
call SaveReal(h,id,1,x)
call SaveReal(h,id,8,0.15)
call SaveReal(h,id,14,45)
call SaveReal(h,id,2,y)
call SaveReal(h,id,5,150)
call SaveReal(h,id,15,0)
call SaveReal(h,id,3,GetSpellTargetX())
call SaveReal(h,id,4,GetSpellTargetY())
if GetUnitTypeId(u)=='Ho0M' then
call SaveInteger(h,id,15,0)
else
call SaveInteger(h,id,15,1)
endif
set n=CreateUnit(p,'ed97',x,y,(a*bj_RADTODEG))
call SetUnitScale(n,2,2,2)
call SetUnitTimeScale(n,1)
call UnitApplyTimedLife(n, 'BTLF', 1)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SetUnitAnimationByIndex(u,8)
call SetUnitTimeScale(u,2)
call TimerStart(t,0.01,true,function QDantesCast2)
set p=null
set u=null
set t=null
endfunction
