function RulerTCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local group g=LoadGroupHandle(h,id,1)
local player p=GetOwningPlayer(u)
local real time=LoadReal(h,id,1)
if time<4 then
call SaveReal(h,id,1,time+0.1)
call SetUnitInvulnerable(u,true)
call PauseUnit(u,true)
call GroupEnumUnitsInRange(G,x,y,400,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if IsUnitAlly(E,p)and SR(x,y,GetUnitX(E),GetUnitY(E))<400 then
call SetUnitInvulnerable(E,true)
if GetUnitAbilityLevel(E,'A1H1')==0 then
call UnitAddAbility(E,'A1H1')
call UnitRemoveAbilityTimedPause(E,'A1H1',15)
call UnitMakeAbilityPermanent(E,true,'A1H1')
call HealRuler(u,E,5)
endif
if IsUnitInGroup(E,g)==false then
call GroupAddUnit(g,E)
endif
endif
call GroupRemoveUnit(G,E)
endloop
loop
    set E=GroupForEachUnit(g)
    exitwhen E==null
    if IsUnitAlly(E,p)and SR(x,y,GetUnitX(E),GetUnitY(E))>400 then
        call SetUnitInvulnerable(E,false)
    endif
endloop
else
loop
set E=FirstOfGroup(g)
exitwhen E==null
call SetUnitInvulnerable(E,false)
call GroupRemoveUnit(g,E)
endloop
call PauseUnit(u,false)
call GroupClear(g)
call DestroyGroup(g)
call SetUnitInvulnerable(u,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set g=null
set u=null
set t=null
endfunction
