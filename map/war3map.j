set x1=LoadReal(h,idt,0)
set y1=LoadReal(h,idt,1)
if x1!=0 and y1!=0 then
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SetUnitAnimation(u,"Spell Two")
call SetUnitTimeScale(u,200)
call SaveReal(h,id,4,Atan2(y1-y,x1-x))
call SaveReal(h,id,5,1500+300*time)
call SaveReal(h,id,7,(1500+300*time)*0.04)
call SaveReal(h,id,6,1.05+time/20)
call SetUnitFacing(u,Atan2(y1-y,x1-x)*bj_RADTODEG)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Scathach1.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.01,true,function QScatachCast3)
call FlushChildHashtable(h,idt)
call DestroyTrigger(tt)
else
call SetUnitTurnSpeed(u,1)
call SetUnitTimeScale(u,1)
call UnitRemoveAbility(u,'A1F6')
call DestroyTrigger(tt)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,idt)
endif
endif
set u=null
set tt=null
set p=null
set t=null
endfunction
function QScatachCast takes nothing returns nothing
local timer t=CreateTimer()
