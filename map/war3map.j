//=========== Фэнг - Feng
function FengPassive_Conditions takes nothing returns boolean
return (UnitHasItemOfTypeBJ(GetAttacker(),'I01U') or GetUnitAbilityLevel(GetAttacker(),'KI20')>0) and (GetUnitTypeId(GetAttacker())!='H059' and GetUnitTypeId(GetAttacker())!='H06S' and GetUnitTypeId(GetAttacker())!='H070') and(GetAttacker()==Hero[GetPlayerId(GetOwningPlayer(GetAttacker()))]or GetUnitAbilityLevel(GetAttacker(),'A14Y')>0) and (GetRandomIntMem(0,100)<=25 or GetUnitAbilityLevel(GetAttacker(),'A06K')>0) and IsUnitType(GetAttacker(), UNIT_TYPE_HERO) and IsUnitIllusion(GetAttacker())==false and udg_B==true
endfunction

function FengPassive_Actions takes nothing returns nothing
	local unit u=GetAttacker()
	local integer id_caster = GetHandleId(u)
	if Condition_Base(GetOwningPlayer(u), GetTriggerUnit()) then
		call PoisonDamage5(u,GetTriggerUnit(),2.5*GetHeroInt(u,true),6,"Abilities\\Weapons\\PoisonSting\\PoisonStingTarget.mdl","chest")
		call SlowUnit(u,GetTriggerUnit(),0.5,0.5,1,1,false)
    endif
	set u=null
endfunction

function InitTrig_FengPassive takes nothing returns nothing
        set Trig_FengPassive=CreateTrigger()
        call TriggerRegisterAnyUnitEventBJ(Trig_FengPassive,EVENT_PLAYER_UNIT_ATTACKED)
        call TriggerAddCondition(Trig_FengPassive,Condition(function FengPassive_Conditions))
        call TriggerAddAction(Trig_FengPassive,function FengPassive_Actions)
endfunction
