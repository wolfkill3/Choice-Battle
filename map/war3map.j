                call SetFrameSize( GetFrameByName("AbilityVarBarTooltip", 10), .24, GetFrameHeight( GetFrameByName("AbilityVarBarTooltipText", 10))+0.03)
                call SetFrameTextAlignment( GetFrameByName("AbilityVarBarTooltipText", 10), TEXT_JUSTIFY_LEFT, TEXT_JUSTIFY_LEFT )
                call SetFrameRelativePoint( GetFrameByName("AbilityVarBarTooltip", 10), FRAMEPOINT_CENTER, GetFrameByName("AbilityVarBarIcon", 10), FRAMEPOINT_CENTER,  -.06, (0.5*GetFrameHeight( GetFrameByName("AbilityVarBarTooltipText", 10)))+.02  )
            endif
        elseif LoadReal(HH,pHid,VariationEHash)==1 then
            call SaveReal(HH,pHid,VariationEHash,2)
            call ShowAbility2('GKE2',false)
            call ShowAbility2('GKE3',true)
            if GetLocalPlayer()==p then
                call SetFrameTexture( GetFrameByName( "AbilityVarBarIcon", 10 ), GetAbilityBaseStringFieldById( String2Id( "GKE2" ), ABILITY_SF_ICON_NORMAL ), 0, true )
                call SetFrameTexture( GetFrameByName( "AbilityVarBarIcon", 10 ), GetAbilityBaseStringFieldById( String2Id( "GKE2" ), ABILITY_SF_ICON_NORMAL ), 1, true )
                call SetFrameTexture( GetFrameByName( "AbilityVarBarIcon", 10 ), GetAbilityBaseStringFieldById( String2Id( "GKE2" ), ABILITY_SF_ICON_NORMAL ), 2, true )                
                call SetFrameText( GetFrameByName("AbilityVarBarTooltipText", 10), GetAbilityBaseStringFieldById( String2Id( "GKE2" ), ABILITY_SF_NAME )+", \n\n"+GetAbilityBaseStringLevelFieldById( String2Id( "GKE2" ), ABILITY_SLF_TOOLTIP_NORMAL_EXTENDED, GetUnitAbilityLevel(Goku,'GKE2')-1 ))
                call SetFrameSize( GetFrameByName("AbilityVarBarTooltip", 10), .24, GetFrameHeight( GetFrameByName("AbilityVarBarTooltipText", 10))+0.03)
                call SetFrameTextAlignment( GetFrameByName("AbilityVarBarTooltipText", 10), TEXT_JUSTIFY_LEFT, TEXT_JUSTIFY_LEFT )
                call SetFrameRelativePoint( GetFrameByName("AbilityVarBarTooltip", 10), FRAMEPOINT_CENTER, GetFrameByName("AbilityVarBarIcon", 10), FRAMEPOINT_CENTER,  -.06, (0.5*GetFrameHeight( GetFrameByName("AbilityVarBarTooltipText", 10)))+.02  )
            endif
        endif
    endif
    if (p==GetOwningPlayer(Goku) or GetPlayerAlliance(GetOwningPlayer(Goku),p,ALLIANCE_SHARED_CONTROL)) and but==GetFrameByName( "AbilityVarBarIcon", 7 ) and IsUnitPaused(Goku)==false and GetUnitAbilityLevel(Goku,'Pet1')==0 then
        set pHid=GetHandleId(GetOwningPlayer(Goku))
        if LoadReal(HH,pHid,VariationTHash)==0 then
            call SaveReal(HH,pHid,VariationTHash,1)
            call SetAbilityIntegerLevelField(GetUnitAbility(Goku,'GKT1'), ABILITY_ILF_TARGET_TYPE,0,1)
            call SetAbilityRealLevelField(GetUnitAbility(Goku,'GKT1'), ABILITY_RLF_CAST_RANGE,0,900)
            if GetLocalPlayer()==p then
                call SetFrameTexture( GetFrameByName( "AbilityVarBarIcon", 7 ), "ReplaceableTextures\\CommandButtons\\BTNDragonFist2.blp", 0, true )
                call SetFrameTexture( GetFrameByName( "AbilityVarBarIcon", 7 ), "ReplaceableTextures\\CommandButtons\\BTNDragonFist2.blp", 1, true )
                call SetFrameTexture( GetFrameByName( "AbilityVarBarIcon", 7 ), "ReplaceableTextures\\CommandButtons\\BTNDragonFist2.blp", 2, true )
                call SetFrameText( GetFrameByName("AbilityVarBarTooltipText", 7), GetAbilityBaseStringFieldById( String2Id( "GKT3" ), ABILITY_SF_NAME )+", \n\n"+GetAbilityBaseStringFieldById( String2Id( "GKT3" ), ABILITY_SLF_TOOLTIP_NORMAL_EXTENDED ))
                call SetFrameSize( GetFrameByName("AbilityVarBarTooltip", 7), .24, GetFrameHeight( GetFrameByName("AbilityVarBarTooltipText", 7))+0.03)
                call SetFrameTextAlignment( GetFrameByName("AbilityVarBarTooltipText", 7), TEXT_JUSTIFY_LEFT, TEXT_JUSTIFY_LEFT )
                call SetFrameRelativePoint( GetFrameByName("AbilityVarBarTooltip", 7), FRAMEPOINT_CENTER, GetFrameByName("AbilityVarBarIcon", 7), FRAMEPOINT_CENTER,  -.1, (0.5*GetFrameHeight( GetFrameByName("AbilityVarBarTooltipText", 7)))+.02  )
            endif
        else
            call SaveReal(HH,pHid,VariationTHash,0)
            call SetAbilityIntegerLevelField(GetUnitAbility(Goku,'GKT1'), ABILITY_ILF_TARGET_TYPE,0,2)
            call SetAbilityRealLevelField(GetUnitAbility(Goku,'GKT1'), ABILITY_RLF_CAST_RANGE,0,99999)
            if GetLocalPlayer()==p then
                call SetFrameTexture( GetFrameByName( "AbilityVarBarIcon", 7 ), "ReplaceableTextures\\CommandButtons\\BTNDragonFist1.blp", 0, true )
                call SetFrameTexture( GetFrameByName( "AbilityVarBarIcon", 7 ), "ReplaceableTextures\\CommandButtons\\BTNDragonFist1.blp", 1, true )
                call SetFrameTexture( GetFrameByName( "AbilityVarBarIcon", 7 ), "ReplaceableTextures\\CommandButtons\\BTNDragonFist1.blp", 2, true )
                call SetFrameText( GetFrameByName("AbilityVarBarTooltipText", 7), GetAbilityBaseStringFieldById( String2Id( "GKT2" ), ABILITY_SF_NAME )+", \n\n"+GetAbilityBaseStringFieldById( String2Id( "GKT2" ), ABILITY_SLF_TOOLTIP_NORMAL_EXTENDED ))
                call SetFrameSize( GetFrameByName("AbilityVarBarTooltip", 7), .24, GetFrameHeight( GetFrameByName("AbilityVarBarTooltipText", 7))+0.03)
                call SetFrameTextAlignment( GetFrameByName("AbilityVarBarTooltipText", 7), TEXT_JUSTIFY_LEFT, TEXT_JUSTIFY_LEFT )
                call SetFrameRelativePoint( GetFrameByName("AbilityVarBarTooltip", 7), FRAMEPOINT_CENTER, GetFrameByName("AbilityVarBarIcon", 7), FRAMEPOINT_CENTER,  -.1, (0.5*GetFrameHeight( GetFrameByName("AbilityVarBarTooltipText", 7)))+.02  )
            endif
        endif
    endif
    set p = null
    set but = null
endfunction

function AbilityModeClick takes nothing returns nothing
    local player p = GetTriggerPlayer( )
    local integer pHid = GetHandleId( p )
    local integer i=0
    if GetTriggerPlayerKey()==OSKEY_Q then
        if p==GetLocalPlayer() and IsFrameVisible(GetFrameByName( "AbilityVarBarIcon", 8 )) then
            call ClickFrame(GetFrameByName( "AbilityVarBarIcon", 8 ))
        endif
    elseif GetTriggerPlayerKey()==OSKEY_W then
        if p==GetLocalPlayer() and IsFrameVisible(GetFrameByName( "AbilityVarBarIcon", 9 )) then
            call ClickFrame(GetFrameByName( "AbilityVarBarIcon", 9 ))
        endif
    elseif GetTriggerPlayerKey()==OSKEY_E then
        if p==GetLocalPlayer() and IsFrameVisible(GetFrameByName( "AbilityVarBarIcon", 10 )) then
            call ClickFrame(GetFrameByName( "AbilityVarBarIcon", 10 ))
        endif
    elseif GetTriggerPlayerKey()==OSKEY_R then
        if p==GetLocalPlayer() and IsFrameVisible(GetFrameByName( "AbilityVarBarIcon", 11 )) then
            call ClickFrame(GetFrameByName( "AbilityVarBarIcon", 11 ))
        endif
    elseif GetTriggerPlayerKey()==OSKEY_T then
        if p==GetLocalPlayer() and IsFrameVisible(GetFrameByName( "AbilityVarBarIcon", 7 )) then
            call ClickFrame(GetFrameByName( "AbilityVarBarIcon", 7 ))
        endif
    elseif GetTriggerPlayerKey()==OSKEY_F then
        if p==GetLocalPlayer() and IsFrameVisible(GetFrameByName( "AbilityVarBarIcon", 5 )) then
            call ClickFrame(GetFrameByName( "AbilityVarBarIcon", 5 ))
        endif
    elseif GetTriggerPlayerKey()==OSKEY_G then
        if p==GetLocalPlayer() and IsFrameVisible(GetFrameByName( "AbilityVarBarIcon", 6 )) then
            call ClickFrame(GetFrameByName( "AbilityVarBarIcon", 6 ))
        endif
    endif
    set p = null
endfunction

function OnButtonCloseTavern takes nothing returns nothing
    local player p = GetTriggerPlayer( )
    local integer pHid = GetHandleId( p )
    local integer buttonId = LoadInteger( HH, pHid, '+bId' )
    local framehandle but = null
    local integer butHid = 0
    local integer itemTypeId = 0
    local integer freeSlotId = 0
    local integer j=0
    local item it = null

    if buttonId == -1 then
        return
    endif
    if p==GetLocalPlayer() then
        call ClearFrameAllPoints( GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ) )
        call SetFrameSize( GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ), 1, 2 )
        call SetFrameRelativePoint( GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ), FRAMEPOINT_TOP, FrameTop, FRAMEPOINT_CENTER, 0.000, 0.2 )
        call SetFrameRelativePoint( GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ), FRAMEPOINT_BOTTOM, GetOriginFrame( ORIGIN_FRAME_CONSOLE_UI, 0 ), FRAMEPOINT_BOTTOM, 0, 0.205 )
        call SetFrameRelativePoint( GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ), FRAMEPOINT_LEFT, GetOriginFrame( ORIGIN_FRAME_CONSOLE_UI, 0 ), FRAMEPOINT_LEFT, 0.006, 0 )
        call SetFrameRelativePoint( GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ), FRAMEPOINT_RIGHT, GetOriginFrame( ORIGIN_FRAME_CONSOLE_UI, 0 ), FRAMEPOINT_RIGHT, -0.02, 0 )
        call SetFrameFont( GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ), "Fonts\\FRIZQT__.TTF", .0115, 0 )
        call ShowFrame( TavernHeroFrame, false )
        call ShowFrame( StatusBarFrame, false)
        call ShowFrame( CloseStatusButton, false)
        call ShowFrame( OpenStatusButton, true)
        call ShowFrame( TavernHeroPortrait, false )
        call ShowFrame( SelectTavernHeroCheck, false )
        call ShowFrame( GetFrameByName("TavernAbilityBorderOpenable",0), false )
        call ShowFrame( GetFrameByName("TavernAbilityBorderOpenable",1), false )
        call ShowFrame( GetFrameByName("TavernAbilityBorderOpenable",2), false )
        call ShowFrame( GetFrameByName("TavernAbilityBorderOpenable",3), false )
        call ShowFrame( GetFrameByName("TavernAbilityBorderOpenable",4), false )
        call ShowFrame( GetFrameByName("TavernAbilityBorderOpenable",5), false )
        call ShowFrame( GetFrameByName("TavernAbilityBorderOpenable",6), false )
        call ClickFrame(OpenStatusButton)
        set j=0
        loop
        call ShowFrame( GetFrameByName("TavernAdditionalAbilityBorderOpenable",j), false )
        set j=j+1
        exitwhen j>35
        endloop
        call EditBlackBorders( -.02, .13 ) // -.02, .13 | to return to default 
        call HideOriginFrames( false )
        call ShowFrame( ClassBarFrame, false)
        call ShowFrame( GetOriginFrame(ORIGIN_FRAME_TIME_OF_DAY_INDICATOR,0), false )
        call ShowFrame( OpenTavernButton, true )
        call ShowFrame( GetOriginFrame( ORIGIN_FRAME_MULTIBOARD, 0 ), true )
    endif
    set TavernHeroId[GetPlayerId(p)]=0
    set TavernPickedHeroFrame[GetPlayerId(p)]=null
    set TavernPickedHeroFrame2[GetPlayerId(p)]=null
    set p = null
    set but = null
endfunction

function OnButtonOpenTavern takes nothing returns nothing
    local player p = GetTriggerPlayer( )
    local integer pHid = GetHandleId( p )
    local integer buttonId = LoadInteger( HH, pHid, '+bId' )
    local framehandle but = null
    local integer butHid = 0
    local integer itemTypeId = 0
    local integer freeSlotId = 0
    local item it = null
    local integer i=0

    if buttonId == -1 then
        return
    endif
    if p==GetLocalPlayer() then
        call ShowFrame( TavernHeroFrame, true )
        call ShowFrame( TavernHeroPortrait, true )
        call ShowFrame( StatusBarFrame, false)
        call ShowFrame( CloseStatusButton, false)
        call ShowFrame( OpenStatusButton, false)
        call ShowFrame( GetFrameByName("TavernBarAdditionalAbilityList",0), false )
        call SetFrameSpriteModel( TavernHeroPortrait, "Default_Portrait.mdx" )
        loop
        exitwhen i>=8 //TavernHeroAbilityIcon
            call SetFrameTexture( GetFrameByName("TavernAbility",i), "UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp", 0, true )
            call SetFrameTexture( GetFrameByName("TavernAbility",i), "UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp", 1, true )
            call SetFrameTexture( GetFrameByName("TavernAbility",i), "UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp", 2, true )
            call SetFrameRelativePoint( GetFrameByName("TavernAbilityTooltip",i), FRAMEPOINT_CENTER, GetFrameByName("TavernAbility",i), FRAMEPOINT_CENTER,  3.13, -.1  )
            set i=i+1
        endloop
        set i=0
        loop
        exitwhen i>=35 //TavernHeroAbilityIcon
            call SetFrameTexture( GetFrameByName("TavernAdditionalAbility",i), "UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp", 0, true )
            call SetFrameTexture( GetFrameByName("TavernAdditionalAbility",i), "UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp", 1, true )
            call SetFrameTexture( GetFrameByName("TavernAdditionalAbility",i), "UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp", 2, true )
            call SetFrameRelativePoint( GetFrameByName("TavernAdditionalAbilityTooltip",i), FRAMEPOINT_CENTER, GetFrameByName("TavernAdditionalAbility",i), FRAMEPOINT_CENTER,  3.13, -.1  )
            set i=i+1
        endloop
        call SetFrameText( InfoTavernText, " ")
        // call SetFramePriority( StatusBarFrame, 1 )
        // call SetFramePriority( CloseStatusButton, 1 )
        // call SetFramePriority( OpenStatusButton, 1 )
        call ShowFrame( OpenTavernButton, false )
        call ShowFrame( ClassBarFrame, false)
        call EditBlackBorders( 0, 0 ) // -.02, .13 | to return to default 
        call HideOriginFrames( true )
        call ShowFrame( GetOriginFrame( ORIGIN_FRAME_MULTIBOARD, 0 ), false )
    endif
    set P=p
    set i=0
    loop
    exitwhen i>=12
        if p==GetLocalPlayer() then  
            if GetFrameTexture(TavernChangeStats,0)=="TitleTavernIcon.blp" then
                call SetFrameTexture( TavernHeroFrame, "StatsBackGround.tga", 0, true )
                call SetFrameTexture( TavernHeroFrame, "StatsBackGround.tga", 1, true )
                call SetFrameTexture( TavernHeroFrame, "StatsBackGround.tga", 2, true )
                call ShowFrame( TavernHeroFrameTitles, false )
                call ShowFrame( TavernHeroFrameStats, true )
            elseif GetFrameTexture(TavernChangeStats,0)=="StatsTavernIcon.blp" then
                call SetFrameTexture( TavernHeroFrame, "TavernBackGround.tga", 0, true )
                call SetFrameTexture( TavernHeroFrame, "TavernBackGround.tga", 1, true )
                call SetFrameTexture( TavernHeroFrame, "TavernBackGround.tga", 2, true )
                call ShowFrame( TavernHeroFrameStats, false )
                call ShowFrame( TavernHeroFrameTitles, true )
            endif
                
            call ClearFrameAllPoints( GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ) )
            call SetFrameRelativePoint( GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ), FRAMEPOINT_CENTER, TavernHeroFrame, FRAMEPOINT_LEFT, 0.1, -0.105 )
            call SetFrameSize( GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ), .165, .117 )
            call SetFrameFont( GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ), "Fonts\\FRIZQT__.TTF", .011, 0 )
            // if GetFrameText(GameMsgText)=="Chat and Info: OFF" then
            //     call SetFramePriority(GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ),0)
            //     call SetFramePriority(GetOriginFrame( ORIGIN_FRAME_UNIT_MSG, 0 ),0)
            //     call ShowFrame( GameMsgBackGround, false )
            // elseif GetFrameText(GameMsgText)=="Chat and Info: ON" then
            //     call SetFramePriority(GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ),7)
            //     call SetFramePriority(GetOriginFrame( ORIGIN_FRAME_UNIT_MSG, 0 ),7)
            //     call ShowFrame( GameMsgBackGround, true )
            // endif
        endif
        if GetPlayerId(p)!=i then
            call HandleListForEach(TavernHeroFrameList[i],function HideId)
        endif
        set i=i+1
    endloop
    set P=null
    set p = null
    set but = null
endfunction

function ToggleOpenTavern takes nothing returns nothing
    local player p = GetTriggerPlayer( )
    local integer pHid = GetHandleId( p )
    local integer i=0
    local integer j=0
    if udg_test==false then
        if p==GetLocalPlayer() then
            if IsFrameVisible(OpenTavernButton)==true then
                call ShowFrame( TavernHeroFrame, true )
                call ShowFrame( TavernHeroPortrait, true )
                call ClearFrameAllPoints( GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ) )
                call SetFrameRelativePoint( GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ), FRAMEPOINT_CENTER, TavernHeroFrame, FRAMEPOINT_LEFT, 0.1, -0.105 )
                call SetFrameSize( GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ), .165, .117 )
                call SetFrameFont( GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ), "Fonts\\FRIZQT__.TTF", .011, 0 )
                call SetFrameSpriteModel( TavernHeroPortrait, "Default_Portrait.mdx" )
                loop
                exitwhen i>=8 //TavernHeroAbilityIcon
                    call SetFrameTexture( GetFrameByName("TavernAbility",i), "UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp", 0, true )
                    call SetFrameTexture( GetFrameByName("TavernAbility",i), "UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp", 1, true )
                    call SetFrameTexture( GetFrameByName("TavernAbility",i), "UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp", 2, true )
                    call SetFrameRelativePoint( GetFrameByName("TavernAbilityTooltip",i), FRAMEPOINT_CENTER, GetFrameByName("TavernAbility",i), FRAMEPOINT_CENTER,  3.13, -.1  )
                    set i=i+1
                endloop
                set i=0
                loop
                exitwhen i>=35 //TavernHeroAbilityIcon
                    call SetFrameTexture( GetFrameByName("TavernAdditionalAbility",i), "UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp", 0, true )
                    call SetFrameTexture( GetFrameByName("TavernAdditionalAbility",i), "UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp", 1, true )
                    call SetFrameTexture( GetFrameByName("TavernAdditionalAbility",i), "UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp", 2, true )
                    call SetFrameRelativePoint( GetFrameByName("TavernAdditionalAbilityTooltip",i), FRAMEPOINT_CENTER, GetFrameByName("TavernAdditionalAbility",i), FRAMEPOINT_CENTER,  3.13, -.1  )
                    set i=i+1
                endloop
                call SetFrameText( InfoTavernText, " ")
                call ShowFrame( OpenTavernButton, false )
                call ShowFrame( ClassBarFrame, false)
                call ShowFrame( CloseTavernButton, true )
                call ShowFrame( StatusBarFrame, false)
                call ShowFrame( CloseStatusButton, false)
                call ShowFrame( OpenStatusButton, false)
                call ShowFrame( GetFrameByName("TavernBarAdditionalAbilityList",0), false )
                call EditBlackBorders( 0, 0 ) // -.02, .13 | to return to default 
                call HideOriginFrames( true )
                call ShowFrame( GetOriginFrame( ORIGIN_FRAME_MULTIBOARD, 0 ), false )
                if GetFrameTexture(TavernChangeStats,0)=="TitleTavernIcon.blp" then
                    call SetFrameTexture( TavernHeroFrame, "StatsBackGround.tga", 0, true )
                    call SetFrameTexture( TavernHeroFrame, "StatsBackGround.tga", 1, true )
                    call SetFrameTexture( TavernHeroFrame, "StatsBackGround.tga", 2, true )
                    call ShowFrame( TavernHeroFrameTitles, false )
                    call ShowFrame( TavernHeroFrameStats, true )
                elseif GetFrameTexture(TavernChangeStats,0)=="StatsTavernIcon.blp" then
                    call SetFrameTexture( TavernHeroFrame, "TavernBackGround.tga", 0, true )
                    call SetFrameTexture( TavernHeroFrame, "TavernBackGround.tga", 1, true )
                    call SetFrameTexture( TavernHeroFrame, "TavernBackGround.tga", 2, true )
                    call ShowFrame( TavernHeroFrameStats, false )
                    call ShowFrame( TavernHeroFrameTitles, true )
                endif
                // if GetFrameText(GameMsgText)=="Chat and Info: OFF" then
                //     call SetFramePriority(GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ),0)
                //     call SetFramePriority(GetOriginFrame( ORIGIN_FRAME_UNIT_MSG, 0 ),0)
                //     call ShowFrame( GameMsgBackGround, false )
                // elseif GetFrameText(GameMsgText)=="Chat and Info: ON" then
                //     call SetFramePriority(GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ),7)
                //     call SetFramePriority(GetOriginFrame( ORIGIN_FRAME_UNIT_MSG, 0 ),7)
                //     call ShowFrame( GameMsgBackGround, true )
                // endif
            else
                call ClearFrameAllPoints( GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ) )
                call SetFrameSize( GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ), 1, 2 )
                call SetFrameRelativePoint( GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ), FRAMEPOINT_TOP, FrameTop, FRAMEPOINT_CENTER, 0.000, 0.2 )
                call SetFrameRelativePoint( GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ), FRAMEPOINT_BOTTOM, GetOriginFrame( ORIGIN_FRAME_CONSOLE_UI, 0 ), FRAMEPOINT_BOTTOM, 0, 0.205 )
                call SetFrameRelativePoint( GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ), FRAMEPOINT_LEFT, GetOriginFrame( ORIGIN_FRAME_CONSOLE_UI, 0 ), FRAMEPOINT_LEFT, 0.006, 0 )
                call SetFrameRelativePoint( GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ), FRAMEPOINT_RIGHT, GetOriginFrame( ORIGIN_FRAME_CONSOLE_UI, 0 ), FRAMEPOINT_RIGHT, -0.02, 0 )
                call SetFrameFont( GetOriginFrame( ORIGIN_FRAME_CHAT_MSG, 0 ), "Fonts\\FRIZQT__.TTF", .0115, 0 )

                call ShowFrame( TavernHeroFrame, false )
                call ShowFrame( TavernHeroPortrait, false )
                call ShowFrame( StatusBarFrame, false)
                call ShowFrame( CloseStatusButton, false)
                call ShowFrame( OpenStatusButton, true)
                call EditBlackBorders( -.02, .13 ) // -.02, .13 | to return to default 
                call HideOriginFrames( false )
                call ShowFrame( GetFrameByName( "TimeOfDayIndicator", 0 ), false ) 
                call ShowFrame( GetOriginFrame(ORIGIN_FRAME_TIME_OF_DAY_INDICATOR,0), false )
                call ShowFrame( OpenTavernButton, true )
                call ShowFrame( CloseTavernButton, false )
                call ShowFrame( ClassBarFrame, false)
                call ShowFrame( GetOriginFrame( ORIGIN_FRAME_MULTIBOARD, 0 ), true )
                call ShowFrame( GetFrameByName("TavernAbilityBorderOpenable",0), false )
                call ShowFrame( GetFrameByName("TavernAbilityBorderOpenable",1), false )
                call ShowFrame( GetFrameByName("TavernAbilityBorderOpenable",2), false )
                call ShowFrame( GetFrameByName("TavernAbilityBorderOpenable",3), false )
                call ShowFrame( GetFrameByName("TavernAbilityBorderOpenable",4), false )
                call ShowFrame( GetFrameByName("TavernAbilityBorderOpenable",5), false )
                call ShowFrame( GetFrameByName("TavernAbilityBorderOpenable",6), false )
                set j=0
                loop
                call ShowFrame( GetFrameByName("TavernAdditionalAbilityBorderOpenable",j), false )
                set j=j+1
                exitwhen j>35
                endloop
            endif
        endif
        set P=p
        set i=0
        loop
        exitwhen i>=12
            if GetPlayerId(p)!=i then
                call HandleListForEach(TavernHeroFrameList[i],function HideId)
            endif
            set i=i+1
        endloop
    else
        call DestroyTrigger(GetTriggeringTrigger())
    endif
    set P=null
    set p = null
endfunction




function OnButtonPickHeroId takes nothing returns nothing
    local player p = GetTriggerPlayer( )
    local integer pHid = GetHandleId( p )
    local integer buttonId = LoadInteger( HH, pHid, '+bId' )
    local framehandle but = null
    local integer butHid = 0
    local integer itemTypeId = 0
    local integer freeSlotId = 0
    local framehandle selector1 = GetCFrameByName( "PlayerPickSelector", 0 )
    local framehandle selector2 = GetCFrameByName( "HeroPickSelector", 0 )

    if buttonId == -1 then
        return
    endif
    if udg_test then
        if TestModeHeroId[GetPlayerId(p)]!=0 and TestModePlayerId[GetPlayerId(p)]!=13 then
            if p==GetLocalPlayer() then
                call ShowFrame( selector1, false )
                call ShowFrame( selector2, false )
            endif
            //call SetPlayerAlliance(Player(TestModePlayerId[GetPlayerId(p)]),Player(0), ALLIANCE_SHARED_VISION, true )
            //call SetPlayerAlliance(Player(TestModePlayerId[GetPlayerId(p)]),Player(0), ALLIANCE_SHARED_CONTROL, true )
            //call SetPlayerAlliance(Player(TestModePlayerId[GetPlayerId(p)]),Player(1), ALLIANCE_SHARED_VISION, true )
            //call SetPlayerAlliance(Player(TestModePlayerId[GetPlayerId(p)]),Player(1), ALLIANCE_SHARED_CONTROL, true )
            //call SetPlayerAlliance(Player(TestModePlayerId[GetPlayerId(p)]),Player(2), ALLIANCE_SHARED_VISION, true )
            //call SetPlayerAlliance(Player(TestModePlayerId[GetPlayerId(p)]),Player(2), ALLIANCE_SHARED_CONTROL, true )
            //call SetPlayerAlliance(Player(TestModePlayerId[GetPlayerId(p)]),Player(3), ALLIANCE_SHARED_VISION, true )
            //call SetPlayerAlliance(Player(TestModePlayerId[GetPlayerId(p)]),Player(3), ALLIANCE_SHARED_CONTROL, true )
            //call SetPlayerAlliance(Player(TestModePlayerId[GetPlayerId(p)]),Player(4), ALLIANCE_SHARED_VISION, true )
            //call SetPlayerAlliance(Player(TestModePlayerId[GetPlayerId(p)]),Player(4), ALLIANCE_SHARED_CONTROL, true )
            //call SetPlayerAlliance(Player(TestModePlayerId[GetPlayerId(p)]),Player(5), ALLIANCE_SHARED_VISION, true )
            //call SetPlayerAlliance(Player(TestModePlayerId[GetPlayerId(p)]),Player(5), ALLIANCE_SHARED_CONTROL, true )
            //call SetPlayerAlliance(Player(TestModePlayerId[GetPlayerId(p)]),Player(6), ALLIANCE_SHARED_VISION, true )
            //call SetPlayerAlliance(Player(TestModePlayerId[GetPlayerId(p)]),Player(6), ALLIANCE_SHARED_CONTROL, true )
            //call SetPlayerAlliance(Player(TestModePlayerId[GetPlayerId(p)]),Player(7), ALLIANCE_SHARED_VISION, true )
            //call SetPlayerAlliance(Player(TestModePlayerId[GetPlayerId(p)]),Player(7), ALLIANCE_SHARED_CONTROL, true )
            //call SetPlayerAlliance(Player(TestModePlayerId[GetPlayerId(p)]),Player(8), ALLIANCE_SHARED_VISION, true )
            //call SetPlayerAlliance(Player(TestModePlayerId[GetPlayerId(p)]),Player(8), ALLIANCE_SHARED_CONTROL, true )
            //call SetPlayerAlliance(Player(TestModePlayerId[GetPlayerId(p)]),Player(9), ALLIANCE_SHARED_VISION, true )
            //call SetPlayerAlliance(Player(TestModePlayerId[GetPlayerId(p)]),Player(9), ALLIANCE_SHARED_CONTROL, true )
            set Hero[TestModePlayerId[GetPlayerId(p)]]=CreateUnit(Player(TestModePlayerId[GetPlayerId(p)]),RH_Force[TestModeHeroId[GetPlayerId(p)]],GetRectCenterX(gg_rct_Rect1),GetRectCenterY(gg_rct_Rect1),0)
            set udg_Hero[TestModePlayerId[GetPlayerId(p)]+1]=Hero[TestModePlayerId[GetPlayerId(p)]]
            call W3MMD_Lite_Set_Integer(p,"Picked_hero",HeroSkin(udg_Hero[TestModePlayerId[GetPlayerId(p)]+1]))
            call SetHeroLevelBJ(Hero[TestModePlayerId[GetPlayerId(p)]],35,false)
            call UnitAddItemById(Hero[TestModePlayerId[GetPlayerId(p)]],'I03R')
            call UnitAddItemById(Hero[TestModePlayerId[GetPlayerId(p)]],'I02W')
            call UnitAddItemById(Hero[TestModePlayerId[GetPlayerId(p)]],'I01E')
            call UnitAddItemById(Hero[TestModePlayerId[GetPlayerId(p)]],'I01D')
            call UnitAddItemById(Hero[TestModePlayerId[GetPlayerId(p)]],'I043')
            call UnitAddItemById(Hero[TestModePlayerId[GetPlayerId(p)]],'I04T')
            if FFAMode==false then
                if Player(TestModePlayerId[GetPlayerId(p)])==Player(0)or Player(TestModePlayerId[GetPlayerId(p)])==Player(1)or Player(TestModePlayerId[GetPlayerId(p)])==Player(2)or Player(TestModePlayerId[GetPlayerId(p)])==Player(3)or Player(TestModePlayerId[GetPlayerId(p)])==Player(4)then
                    call GroupAddUnit(udg_CG[1],Hero[TestModePlayerId[GetPlayerId(p)]])
                    elseif Player(TestModePlayerId[GetPlayerId(p)])==Player(5)or Player(TestModePlayerId[GetPlayerId(p)])==Player(6)or Player(TestModePlayerId[GetPlayerId(p)])==Player(7)or Player(TestModePlayerId[GetPlayerId(p)])==Player(8)or Player(TestModePlayerId[GetPlayerId(p)])==Player(9)then
                    call GroupAddUnit(udg_CG[2],Hero[TestModePlayerId[GetPlayerId(p)]])
                endif
            else
                call GroupAddUnit(udg_CG[4],Hero[TestModePlayerId[GetPlayerId(p)]])
            endif
            set TestModeHeroId[GetPlayerId(p)]=0
        endif
    else
        if udg_RH[TavernHeroId[GetPlayerId(p)]]!=null and TavernPlayerPickAllow[GetPlayerId(p)]==true and GetPlayerId(p)<10 then
            if p==GetLocalPlayer() then
                call ShowFrame( SelectTavernHeroCheck, false )
                if pick==3 or cmb==true then
                    call SetFrameColourEx( TavernHeroPick,0, 0xFF902020 )
                    call SetFrameColourEx( TavernHeroPick,1, 0xFF902020 )
                    call SetFrameColourEx( TavernHeroPick,2, 0xFF902020 )
                else
                    if pick!=1 and pick!=2 then
                        call ClickFrame(CloseTavernButton)
                        call ClickFrame(OpenStatusButton)
                    endif
                    call SetFrameColourEx( TavernHeroPick,0, 0xFF404040 )
                    call SetFrameColourEx( TavernHeroPick,1, 0xFF404040 )
                    call SetFrameColourEx( TavernHeroPick,2, 0xFF404040 )
                    call SetFrameColourEx( TavernHeroRandom,0, 0xFF404040 )
                    call SetFrameColourEx( TavernHeroRandom,1, 0xFF404040 )
                    call SetFrameColourEx( TavernHeroRandom,2, 0xFF404040 )
                endif
            endif //
            //call SetFrameEnabled( GetCFrameByName( "TavernBarHero", TavernHeroId[GetPlayerId(p)] ),false)
            if pick==3 or cmb==true then
                call SetFrameColourEx( TavernPickedHeroFrame[GetPlayerId(p)],0, 0xFFFF5050 )
                call SetFrameColourEx( TavernPickedHeroFrame[GetPlayerId(p)],1, 0xFFFF5050 )
                call SetFrameColourEx( TavernPickedHeroFrame[GetPlayerId(p)],2, 0xFFFF5050 )
                call SetFrameColourEx( TavernPickedHeroFrame2[GetPlayerId(p)],0, 0xFFFF5050 )
                call SetFrameColourEx( TavernPickedHeroFrame2[GetPlayerId(p)],1, 0xFFFF5050 )
                call SetFrameColourEx( TavernPickedHeroFrame2[GetPlayerId(p)],2, 0xFFFF5050 )
                call SetFrameTexture( GetFrameByName("TavernCMHero",Globalpick), GetFrameTexture(TavernPickedHeroFrame[GetPlayerId(p)],0), 0, true ) 
                call SetFrameTexture( GetFrameByName("TavernCMHero",Globalpick), GetFrameTexture(TavernPickedHeroFrame[GetPlayerId(p)],0), 1, true ) 
                call SetFrameTexture( GetFrameByName("TavernCMHero",Globalpick), GetFrameTexture(TavernPickedHeroFrame[GetPlayerId(p)],0), 2, true )
                if cmb==false then
                call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,GetUnitBaseStringFieldById(RH_Force[TavernHeroId[GetPlayerId(p)]],UNIT_SF_NAME)+" был забанен "+GetPlayerName(p)+"!")
                else
                call CreateUnit(Player(GetPlayerId(p)),udg_RH[TavernHeroId[GetPlayerId(p)]],GetRectCenterX(gg_rct_Rect1),GetRectCenterY(gg_rct_Rect1),0)
                endif
                set bonus_repick[GetPlayerId(p)]=0
                set udg_RH[TavernHeroId[GetPlayerId(p)]]=0
            else
                if pick==1 or pick==2 then
                    call SetFrameTexture( GetFrameByName("SelectedHeroPlayer",GetPlayerId(Player(pick1))), GetFrameTexture(TavernPickedHeroFrame[GetPlayerId(p)],0), 0, true ) 
                    call SetFrameTexture( GetFrameByName("SelectedHeroPlayer",GetPlayerId(Player(pick1))), GetFrameTexture(TavernPickedHeroFrame[GetPlayerId(p)],0), 1, true ) 
                    call SetFrameTexture( GetFrameByName("SelectedHeroPlayer",GetPlayerId(Player(pick1))), GetFrameTexture(TavernPickedHeroFrame[GetPlayerId(p)],0), 2, true ) 
                else
                    call SetFrameTexture( GetFrameByName("SelectedHeroPlayer",GetPlayerId(p)), GetFrameTexture(TavernPickedHeroFrame[GetPlayerId(p)],0), 0, true ) 
                    call SetFrameTexture( GetFrameByName("SelectedHeroPlayer",GetPlayerId(p)), GetFrameTexture(TavernPickedHeroFrame[GetPlayerId(p)],0), 1, true ) 
                    call SetFrameTexture( GetFrameByName("SelectedHeroPlayer",GetPlayerId(p)), GetFrameTexture(TavernPickedHeroFrame[GetPlayerId(p)],0), 2, true ) 
                endif
                call SetFrameTexture( GetFrameByName("TavernCMHero",Globalpick), GetFrameTexture(TavernPickedHeroFrame[GetPlayerId(p)],0), 0, true ) 
                call SetFrameTexture( GetFrameByName("TavernCMHero",Globalpick), GetFrameTexture(TavernPickedHeroFrame[GetPlayerId(p)],0), 1, true ) 
                call SetFrameTexture( GetFrameByName("TavernCMHero",Globalpick), GetFrameTexture(TavernPickedHeroFrame[GetPlayerId(p)],0), 2, true ) 
                call SetFrameColourEx( TavernPickedHeroFrame[GetPlayerId(p)],0, 0xFF505050 )
                call SetFrameColourEx( TavernPickedHeroFrame[GetPlayerId(p)],1, 0xFF505050 )
                call SetFrameColourEx( TavernPickedHeroFrame[GetPlayerId(p)],2, 0xFF505050 )
                call SetFrameColourEx( TavernPickedHeroFrame2[GetPlayerId(p)],0, 0xFF505050 )
                call SetFrameColourEx( TavernPickedHeroFrame2[GetPlayerId(p)],1, 0xFF505050 )
                call SetFrameColourEx( TavernPickedHeroFrame2[GetPlayerId(p)],2, 0xFF505050 )
                set Hero[GetPlayerId(p)]=CreateUnit(Player(GetPlayerId(p)),udg_RH[TavernHeroId[GetPlayerId(p)]],GetRectCenterX(gg_rct_Rect1),GetRectCenterY(gg_rct_Rect1),0)
                set udg_Hero[GetPlayerId(p)+1]=Hero[GetPlayerId(p)]
                call W3MMD_Lite_Set_Integer(p,"Picked_hero",HeroSkin(udg_Hero[GetPlayerId(p)+1]))
            endif
            if FFAMode==false then
                if Player(GetPlayerId(p))==Player(0)or Player(GetPlayerId(p))==Player(1)or Player(GetPlayerId(p))==Player(2)or Player(GetPlayerId(p))==Player(3)or Player(GetPlayerId(p))==Player(4)then
                    call GroupAddUnit(udg_CG[1],Hero[GetPlayerId(p)])
                    elseif Player(GetPlayerId(p))==Player(5)or Player(GetPlayerId(p))==Player(6)or Player(GetPlayerId(p))==Player(7)or Player(GetPlayerId(p))==Player(8)or Player(GetPlayerId(p))==Player(9)then
                    call GroupAddUnit(udg_CG[2],Hero[GetPlayerId(p)])
                endif
            else
                call GroupAddUnit(udg_CG[4],Hero[GetPlayerId(p)])
            endif
            set udg_RH[TavernHeroId[GetPlayerId(p)]]=0
            set TavernPlayerPickAllow[GetPlayerId(p)]=false
            set TavernHeroId[GetPlayerId(p)]=0
            set TavernPickedHeroFrame[GetPlayerId(p)]=null
            set TavernPickedHeroFrame2[GetPlayerId(p)]=null
        endif
    endif
    set p = null
    set but = null
endfunction


function OnButtonRandom takes nothing returns nothing
    local player p = GetTriggerPlayer( )
    local integer pHid = GetHandleId( p )
    local integer buttonId = LoadInteger( HH, pHid, '+bId' )
    local framehandle but = null
    local integer butHid = 0
    local integer itemTypeId = 0
    local integer freeSlotId = 0
    local integer id
    local integer i=GetPlayerId(p)
    local unit array u

    if buttonId == -1 then
        return
    endif
    if randcond==true and TavernPlayerPickAllow[i]==true then
        set rand[i]=true
        set udg_Repick[i+1]=0
        if bonus_repick[i]==2 then
                set udg_Repick[i+1]=-2
        endif
        loop
        set id=GetRandomInt(0,134)
        if udg_RH[id]!=0 then
        set u[i+1]=CreateUnit(Player(i),udg_RH[id],GetRectCenterX(gg_rct_Rect1),GetRectCenterY(gg_rct_Rect1),0)
        set udg_RH[id]=0
        call DisplayChatMessageEx(null,CHAT_RECIPIENT_UNKNOWN,10,true,"Игроку "+udg_Color[i+1]+GetPlayerName(Player(i))+"|r выпал "+GetUnitName(u[i+1]))
        // call AddFrameText(TavernChat,"Игроку "+udg_Color[i+1]+GetPlayerName(Player(i))+"|r выпал "+GetUnitName(u[i+1]))
        call SetFrameTexture( GetFrameByName("SelectedHeroPlayer",i), GetFrameTexture(GetFrameByName("TavernBarHero",id),0), 0, true ) 
        call SetFrameTexture( GetFrameByName("SelectedHeroPlayer",i), GetFrameTexture(GetFrameByName("TavernBarHero",id),1), 1, true )
        call SetFrameTexture( GetFrameByName("SelectedHeroPlayer",i), GetFrameTexture(GetFrameByName("TavernBarHero",id),2), 2, true )
        call SetFrameTexture( GetFrameByName("TavernCMHero",Globalpick), GetFrameTexture(GetFrameByName("TavernBarHero",id),0), 0, true ) 
        call SetFrameTexture( GetFrameByName("TavernCMHero",Globalpick), GetFrameTexture(GetFrameByName("TavernBarHero",id),1), 1, true ) 
        call SetFrameTexture( GetFrameByName("TavernCMHero",Globalpick), GetFrameTexture(GetFrameByName("TavernBarHero",id),2), 2, true )         
        call SetFrameColourEx( GetFrameByName("TavernBarHero",id),0, 0xFF505050 )
        call SetFrameColourEx( GetFrameByName("TavernBarHero",id),1, 0xFF505050 )
        call SetFrameColourEx( GetFrameByName("TavernBarHero",id),2, 0xFF505050 )
        call SetFrameColourEx( GetFrameByName("TavernBarHeroTitle",id),0, 0xFF505050 )
        call SetFrameColourEx( GetFrameByName("TavernBarHeroTitle",id),1, 0xFF505050 )
        call SetFrameColourEx( GetFrameByName("TavernBarHeroTitle",id),2, 0xFF505050 )
        if FFAMode==false then
        if Player(i)==Player(0)or Player(i)==Player(1)or Player(i)==Player(2)or Player(i)==Player(3)or Player(i)==Player(4)then
        call GroupAddUnit(udg_CG[1],u[i+1])
        elseif Player(i)==Player(5)or Player(i)==Player(6)or Player(i)==Player(7)or Player(i)==Player(8)or Player(i)==Player(9)then
        call GroupAddUnit(udg_CG[2],u[i+1])
        endif
        else
        call GroupAddUnit(udg_CG[4],u[i+1])
        endif
        endif
        exitwhen u[i+1]!=null
        endloop
        if GetLocalPlayer()==p then
            call SetFrameColourEx( TavernHeroPick,0, 0xFF404040 )
            call SetFrameColourEx( TavernHeroPick,1, 0xFF404040 )
            call SetFrameColourEx( TavernHeroPick,2, 0xFF404040 )
            call SetFrameColourEx( TavernHeroRandom,0, 0xFF404040 )
            call SetFrameColourEx( TavernHeroRandom,1, 0xFF404040 )
            call SetFrameColourEx( TavernHeroRandom,2, 0xFF404040 )
            call ClickFrame(CloseTavernButton)
            call ClickFrame(OpenStatusButton)
        endif
        call ExecuteFunc("UpdateMultiboard")
        set TavernPlayerPickAllow[i]=false
        set TavernHeroId[i]=0
        set TavernPickedHeroFrame[i]=null
        set TavernPickedHeroFrame2[i]=null
    endif
    set p = null
    set but = null
endfunction

