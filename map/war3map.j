call TriggerAddCondition(gg_trg_RLi,Condition(function RLiCond))
call TriggerAddAction(gg_trg_RLi,function RLiCast)
endfunction
function LearnQLiCond takes nothing returns boolean
return GetLearnedSkill()=='A1CU'
endfunction
function LiHidden takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local integer idu=GetHandleId(u)
local real he=(40-I2R(GetHeroLevel(u)))/40
local real time=LoadReal(HH,idu,StringHash("NoSecond"))
if time>0 then
call SetUnitVertexColor(u,255,255,255,255)
call SaveReal(HH,idu,StringHash("NoSecond"),time-0.1)
else
call SetUnitVertexColor(u,255,255,255,R2I(he*255))
if IsPlayerAlly(GetLocalPlayer(),GetOwningPlayer(u))then
call SetUnitVertexColor(u,255,255,255,255)
endif
endif
set u=null
set t=null
endfunction
