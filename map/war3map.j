local unit u=GetTriggerUnit()
if GetSpellAbilityId()=='A0SK' then
call SaveUnitHandle(h,id,0,u)
call ShowAbility2Timed('A0SK',false,0.3)
call ShowAbility2Timed('A1SK',true,0.32)
call UnitAddAbility(u,'BuF1')
call SaveBoolean(HH,GetHandleId(u),SST,true)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\ActualRegen.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
else
call SaveBoolean(HH,GetHandleId(u),SST,false)
call ShowAbility2('A1SK',false)
call ShowAbility2('A0SK',true)
call UnitRemoveAbility(u,'BuF1')
endif
if LoadBoolean(HH,GetHandleId(u),SS)==false then
    call SaveBoolean(HH,GetHandleId(u),SS,true)
    call TimerStart(t,0.03,true,function RegenerationAuraCast2)
endif
set u=null
set t=null
endfunction
