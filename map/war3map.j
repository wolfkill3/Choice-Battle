set gg_trg_Gyokutenhou=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Gyokutenhou,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_Gyokutenhou,Condition(function GyokutenhouCond))
call TriggerAddAction(gg_trg_Gyokutenhou,function GyokutenhouCast)
endfunction
function TamamoCatCond takes nothing returns boolean
return GetSpellAbilityId()=='A1B6' and udg_B
endfunction
function TamamoCatCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,2)
local integer idu=GetHandleId(u)
local real x=LoadReal(h,idu,SH_hramx)
local real y=LoadReal(h,idu,SH_hramy)
local real x1=0
local real y1=0
local real x2=GetUnitX(l__d)
local real y2=GetUnitY(l__d)
local real a=0
local integer r=0
local real dmg=GetHeroInt(u,true)*0.8
local player p=GetOwningPlayer(u)
local real time=LoadReal(h,id,4)
local real timef=LoadReal(h,id,5)
local unit c
if LoadBoolean(h,idu,SH_hramb)and udg_B==true and DU2==true then
set c=LoadUnitHandle(h,id,1)
call SetUnitXY_1(u,x2,y2, false)
call GroupEnumUnitsInRange(GTamamo,x,y,2000,BaseCat)
loop
set E=FirstOfGroup(GTamamo)
exitwhen E==null
if GetUnitAbilityLevel(E,'B02Z')==0 then
call SetControlToUnit(E,E,0.5,"doomdebug")
call SlowUnit(u,E,0.75,0.75,0.5,0,false)
endif
call GroupRemoveUnit(GTamamo,E)
endloop
call GroupEnumUnitsInRange(GTamamo,x,y,2000,BaseCat)
if c!=null and GetUnitAbilityLevel(c,'Aloc')==0 then
set x1=GetUnitX(c)
set y1=GetUnitY(c)
set a=Atan2(y1-y2,x1-x2)
if SR(x2,y2,x1,y1)>150 then
set x2=x2+75*Cos(a)
set y2=y2+75*Sin(a)
call SetUnitX(l__d,x2)
call SetUnitY(l__d,y2)
call SetUnitFacing(l__d,a*bj_RADTODEG)
set n=CreateUnit(p,'e10Q',x2,y2,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,55)
call UnitApplyTimedLife(n,'BTLF',0.2)
call SetUnitTimeScale(n,1.5)
call SetUnitAnimation(n,"attack")
call SetUnitAnimation(l__d,"attack")
else
call SaveReal(h,id,5,timef+0.02)
if timef<4 and UnitIsAlive(c)and SR(x,y,x1,y1)<2000 then
call SaveReal(h,id,4,time+0.02)
if time>0.1 then
call SetUnitAnimation(l__d,"attack")
set n=CreateUnit(p,'e10Q',x2,y2,GetUnitFacing(l__d))
call SetUnitVertexColor(n,255,255,255,55)
call UnitApplyTimedLife(n,'BTLF',0.3)
call SetUnitTimeScale(n,1.5)
call SetUnitAnimation(n,"attack")
set r=GetRandomInt(1,4)
set soundplay=SndN(2592) // Sound\Music\mp3Music\Tamamo Cat Slash.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
if r==1 then
call EffectToRandomBone("war3mapImported\\SlashEffectRed by Deckai.mdx",c)
elseif r==2 then
call EffectToRandomBone("war3mapImported\\AkihaClaw.mdx",c)
elseif r==3 then
call EffectToRandomBone("war3mapImported\\BasicStrike.mdx",c)
elseif r==4 then
call EffectToRandomBone("war3mapImported\\BloodEX.mdx",c)
endif
call myCustomDamage(u,c,dmg,false,false,null,null,null)
call SaveReal(h,id,4,0)
endif
else
call SaveReal(h,id,5,0)
call RemoveSavedHandle(h,id,1)
endif
endif
else
if FirstOfGroup(GTamamo)!=null then
set E=GetRandomUnitFromGroup(GTamamo)
//call BJDebugMsg(GetUnitName(E))
if IsUnitAlly(E,p)and NumberOfEnemiesInEachGroup(GTamamo,p)>0 then
set E=GetRandomEnemyUnitFromGroup(GTamamo,p)
endif
//call BJDebugMsg(GetUnitName(E))
call SaveUnitHandle(h,id,1,E)
set n=CreateUnit(p,'e10N',x2,y2,Atan2(GetUnitY(E)-y2,GetUnitX(E)-x2)*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.5)
call SetUnitTimeScale(n,2)
else
call RemoveSavedHandle(h,id,1)
if GetUnitCurrentOrder(l__d)==null then
call IssuePointOrder(l__d,"move",x+GetRandomReal(-1500,1500),y+GetRandomReal(-1500,1500))
endif
endif
endif
else
call RemoveUnit(l__d)
set soundplay=SndN(2597) // Sound\Music\mp3Music\Tamamo Cat Phantasm 2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call UnitRemoveAbility(u,'A1AZ')
call HealTextTag(u,u,0.15*GetUnitState(u,UNIT_STATE_MAX_LIFE)*myCustomHeal2(u,1),"HealthRes")
call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+0.15*GetUnitState(u,UNIT_STATE_MAX_LIFE))
call UnitApplyTimedLife(CreateUnit(p,'e01O',x2,y2,0),'BTLF',1.1)
call UnitApplyTimedLife(CreateUnit(p,'e0AX',x2,y2,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0AW',x2,y2,GetRandomReal(0,359)),'BTLF',0.01)
call UnitApplyTimedLife(CreateUnit(p,'e0B1',x2,y2,GetRandomReal(0,359)),'BTLF',0.4)
call UnitApplyTimedLife(CreateUnit(p,'e0B4',x2,y2,GetRandomReal(0,359)),'BTLF',0.4)
call UnitApplyTimedLife(CreateUnit(p,'e0AZ',x2,y2,GetRandomReal(0,359)),'BTLF',0.4)
call UnitApplyTimedLife(CreateUnit(p,'e0B3',x2,y2,GetRandomReal(0,359)),'BTLF',0.4)
call SetUnitXY_1(u,x2,y2, false)
call PauseUnit(u,false)
call ShowUnit(u,true)
call SetUnitInvulnerable(u,false)
if udg_B==true then
call SetControlToUnit(u,u,2,"stun")
endif
call SetUnitAnimation(u,"Dissipate")
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set u=null
set p=null
set t=null
    set c=null
endfunction
function TamamoCatCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real dist=LoadReal(h,id,4)
local player p=GetOwningPlayer(u)
if dist<2 then
call SaveReal(h,id,4,dist+0.1)
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,25,25,120)
call SetUnitScale(n,4,4,4)
call SetUnitTimeScale(n,0.7)
call UnitApplyTimedLife(n,'BTLF',2)
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitScale(n,2,2,2)
call SetUnitVertexColor(n,255,25,25,100)
call SetUnitTimeScale(n,0.7)
call UnitApplyTimedLife(n,'BTLF',2)
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,25,25,80)
call SetUnitScale(n,3,3,3)
call SetUnitTimeScale(n,0.7)
call PauseUnit(u,true)
call UnitApplyTimedLife(n,'BTLF',2)
else
call CinematicFadeBJCustom(bj_CINEFADETYPE_FADEIN,4.00,"war3mapImported\\TamaCatMask.blp",100,100,100,0)
call SaveReal(h,id,4,0)
call PauseTimer(t)
call TimerStart(t,0.02,true,function TamamoCatCast3)
endif
set l__d=null
set u=null
set p=null
set t=null
endfunction
function TamamoCatCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
call SaveUnitHandle(h,id,0,u)
set n=CreateUnit(p,'e10Q',x,y,GetUnitFacing(u))
call SaveUnitHandle(h,id,2,n)
call SetUnitTimeScale(n,1.5)
call SetUnitAnimation(n,"stand ready")
set n=CreateUnit(p,'e10S',x,y,GetUnitFacing(u))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitVertexColor(n,255,0,0,255)
call SetUnitTimeScale(n,0.25)
set n=CreateUnit(p,'e11E',x,y,GetUnitFacing(u))
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,0.5)
set n=CreateUnit(p,'e11D',x,y,GetUnitFacing(u))
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,0.5)
set n=CreateUnit(p,'e11C',x,y,GetUnitFacing(u))
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,0.25)
call PauseUnit(u,true)
call ShowUnit(u,false)
call SetUnitInvulnerable(u,true)
call SaveReal(h,id,4,0)
call SaveReal(h,id,5,0)
set soundplay=SndN(2600) // Sound\Music\mp3Music\Tamamo Cat Phantasm 1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call UnitAddAbility(u,'A1AZ')
call TimerStart(t,0.1,true,function TamamoCatCast2)
set p=null
set u=null
set t=null
endfunction
