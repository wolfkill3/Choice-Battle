call SaveReal(HH,id,15,damage0)
call SaveUnitHandle(HH,id,20,dragon)
call TimerStart(t,0.02,true,function MadaraEMokutonDragon1)
call SetUnitAnimationByIndex(dragon,1)
set caster1=null
set dragon=null
set targetD=null
set t=null
endfunction

function MadaraESharinganAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real distance=SR(GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),GetUnitX(LoadUnitHandle(HH,id,2)),GetUnitY(LoadUnitHandle(HH,id,2)))
local real time=LoadReal(HH,id,5)
set time=time+0.02
call SaveReal(HH,id,5,time)
if time>1 and distance<40 then
set soundplay=SndN(3556) // war3mapimported\MadaraE_Sound.mp3
                        call StartSound(soundplay)
                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call MadaraEMokutonDragon(caster,LoadUnitHandle(HH,id,20),LoadUnitHandle(HH,id,2),LoadReal(HH,id,35),LoadReal(HH,id,11))
call UnitAddAbility(LoadUnitHandle(HH,id,2),'AMUD')
call UnitRemoveAbility(LoadUnitHandle(HH,id,2),'AMUD')
//set n=CreateUnit(GetOwningPlayer(caster),'h019',GetUnitX(LoadUnitHandle(HH,id,2)),GetUnitY(LoadUnitHandle(HH,id,2)),0)
//call UnitAddAbility(n,'MUER')
//call UnitApplyTimedLife(n,'BTLF',1)
//call IssueTargetOrder(n,"ensnare",LoadUnitHandle(HH,id,2))

call EffectCreateAndMove(true,"Madara\\az_slb.mdl",GetRandomReal(0,360),1,1,1,100,100,100,30,0,LoadUnitHandle(HH,id,2),0,facing)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
else
if time<1 then
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
endif
if time==0.02 then
call SetUnitPathing(caster,true)
if GetRandomInt(1,2)==1 then
set soundplay=SndN(3559) // war3mapimported\MadaraEv1.mp3
                        call StartSound(soundplay)
                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
set soundplay=SndN(3562) // war3mapimported\MadaraEv2.mp3
                        call StartSound(soundplay)
                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
//call SetUnitAnimationByIndex(caster,8)
if LoadBoolean(HH,GetHandleId(caster),SH_MadaraSusT2)==true then
call SetUnitAnimationByIndex(caster,2)
else
call SetUnitAnimationByIndex(caster,7)
endif
endif
if time==0.02 or time==0.4 or time==0.8 then
call EffectCreateAndMove(true,"Madara\\[A]az_axe_ef1.mdl",facing,1,1,0.5,100,100,100,30,0,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\WindNewFaw4.mdl",facing,1,1,0.5,100,100,100,30,0,caster,0,facing)
endif
if time==1 then
call EffectCreateAndMove(true,"Madara\\BY_Wood_GongChengSiPai_6.mdl",facing,1,1.5,1,100,100,100,30,0,caster,0,facing)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
set n0=CreateUnit(GetOwningPlayer(caster),'e222',GetUnitX(caster),GetUnitY(caster),facing)
call UnitSize(n0,1.25,1,1)
call MoveUnit(n0,n0,100,facing)
call SetUnitAnimationByIndex(n0,0)
call SetUnitFlyHeight(n0,100,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=null
endif
if time>1 then
set n0=LoadUnitHandle(HH,id,20)
set facing=Angle2(GetUnitX(n0),GetUnitY(n0),GetUnitX(LoadUnitHandle(HH,id,2)),GetUnitY(LoadUnitHandle(HH,id,2)))
call SetUnitFacingInstant(n0,facing)
call MoveUnit(n0,n0,40,facing)
set n0=null
endif
endif
set t=null
set caster=null
endfunction

//Мадара Т Шаринган
function MadaraTSharinganAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real distance=LoadReal(HH,id,8)
local unit dummyUnit=LoadUnitHandle(HH,id,20)
local real time1
local real damage= GetUnitState(caster,UNIT_STATE_MAX_MANA)*0.7
set time=time+0.02
call SaveReal(HH,id,5,time)
if distance>6000 then
if LoadGroupHandle(HH,id,4)!=null then
call DestroyGroup(LoadGroupHandle(HH,id,4))
call SaveGroupHandle(HH,id,4,null)
endif
call MyRemoveUnit(LoadUnitHandle(HH,id,20),3)
call UnitColor(LoadUnitHandle(HH,id,20),100,100,100,100)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
else
set n0=LoadUnitHandle(HH,id,20)
if time==0.02 then
call EffectCreateAndMove(true,"Madara\\WindCircleFaster.mdl",facing,1.5,2,0.8,100,100,100,0,50,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\wind4.mdl",facing,1,1.5,0.5,60,60,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\[A]RinRfire1.mdl",GetRandomInt(0,360),1.25,2,2,100,100,100,60,0,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\az_siwen.mdl",GetRandomInt(0,360),1.5,3,0.3,100,100,100,30,100,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\blue-blink.mdl",GetRandomInt(0,360),1.5,5,0.3,100,100,100,0,0,caster,0,facing)
call SaveGroupHandle(HH,id,4,CreateGroup())
call SaveBoolean(HH,GetHandleId(caster),SH_MadaraSusT2,true)
set soundplay=SndN(3565) // war3mapimported\MadaraT1.mp3
                        call StartSound(soundplay)
                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
if time==2 then
call EffectCreateAndMove(true,"Madara\\az_siwen.mdl",GetRandomInt(0,360),1.5,3,0.3,100,100,100,30,100,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\blue-blink.mdl",GetRandomInt(0,360),1.5,5,0.3,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\az_fireringblue.mdl",facing,1,4,0.6,100,100,100,0,150,caster,0,facing)
endif
if time==0.04 then
call SetUnitAnimationByIndex(caster,5)
call UnitSpeed(caster,0.43)
endif
if time<3 then
set time1=LoadReal(HH,id,6)
set time1=time1+0.02
if time1==0.3 or time==0.04 then
set time1=0
call EffectCreateAndMove(true,"Madara\\[A]az_axe_ef1.mdl",GetRandomInt(0,360),1,GetRandomReal(2,2.8),GetRandomReal(0.3,0.6),100,100,100,60,0,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\HakenSaber2.mdl",GetRandomInt(0,360),1,GetRandomReal(1.75,2.2),GetRandomReal(0.5,1),100,100,100,60,0,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\WindNewFaw4.mdl",GetRandomInt(0,360),1,GetRandomReal(1.75,2.2),GetRandomReal(0.5,1),100,100,100,60,100,caster,0,facing)
endif
call SaveReal(HH,id,6,time1)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
endif
if time==3 then
call UnitSpeed(caster,3)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
endif
if time==2.5 then
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
call SetUnitModel(n0,"Madara\\File00000528.mdl")
call UnitSize(n0,1,1,1)
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call SaveUnitHandle(HH,id,20,n0)
call SetUnitFlyHeight(n0,300,0)
set n0=null
endif
if time>2.5 then
set time1=LoadReal(HH,id,9)
call SaveReal(HH,id,8,distance+60)
set dummyUnit=LoadUnitHandle(HH,id,20)
call MoveUnit(dummyUnit,dummyUnit,60,facing)
if time<2.8 then
call DamageAoeOneTime3(caster,GetUnitX(dummyUnit),GetUnitY(dummyUnit),200+(time-2.5)*300,damage,LoadGroupHandle(HH,id,4),R2I((3.9-time)*25+10),40,facing)
else
call DamageAoeOneTime3(caster,GetUnitX(dummyUnit),GetUnitY(dummyUnit),200+(time-2.5)*300,damage,LoadGroupHandle(HH,id,4),40,40,facing)
endif
set time1=time1+0.02
call UnitSize(LoadUnitHandle(HH,id,20),1+(time-2.5)*1.5,1,1)
if time1==0.02 or time==2.52 then
call EffectCreateAndMove(true,"Madara\\File00002270.mdl",facing,1.75-(time-2.5),1.75+(time-2.5)*3.7,0.6,100,100,100,40,-150,LoadUnitHandle(HH,id,20),150,facing)
call EffectCreateAndMove(true,"Madara\\[A]RinRfire2-90.mdl",facing+90,1.75-(time-2.5),1+(time-2.5)*1.25,0.6,100,100,100,40,-200,LoadUnitHandle(HH,id,20),150,facing)
endif
if time1==0.06 or time==2.52 then
set time1=0
call EffectCreateAndMove(true,"Madara\\az_yine(nosmoke).mdl",facing,1.75-(time-2.5),0.6+(time-2.5)*1.15,1,80,80,100,0,-200,LoadUnitHandle(HH,id,20),0,facing)
call EffectCreateAndMove(true,"Madara\\az_goods_force staff(3).mdl",facing,1.75-(time-2.5),2+(time-2.5)*5,0.8,100,100,100,40,-200,LoadUnitHandle(HH,id,20),0,facing)
call EffectCreateAndMove(true,"Madara\\groundshock1.mdl",facing+90,1.75-(time-2.5),1+(time-2.5)*2,2,100,100,100,0,-100,LoadUnitHandle(HH,id,20),150+(time-2.5)*350,facing+90)
call EffectCreateAndMove(true,"Madara\\groundshock1.mdl",facing-90,1.75-(time-2.5),1+(time-2.5)*2,2,100,100,100,0,-100,LoadUnitHandle(HH,id,20),150+(time-2.5)*350,facing-90)
endif
call SaveReal(HH,id,9,time1)
set dummyUnit=null
endif
set n0=null
endif
set dummyUnit=null
set caster=null
set t=null
endfunction

//

function MadaraChoice_Act takes nothing returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local unit caster=GetTriggerUnit()
    local unit c=GetSpellTargetUnit()
    local real facing
    call SaveUnitHandle(HH,id,1,caster)
    if c==null then
        set facing=Angle2(GetUnitX(caster),GetUnitY(caster),SpellTargetLocX(),SpellTargetLocY())
        call SaveReal(HH,id,11,SpellTargetLocX())
        call SaveReal(HH,id,12,SpellTargetLocY())
    else
        call SaveUnitHandle(HH,id,2,c)
        set facing=Angle2(GetUnitX(caster),GetUnitY(caster),GetUnitX(c),GetUnitY(c))
    endif
    call SaveReal(HH,id,3,facing)

   //MadaraQ
    if GetSpellAbilityId()=='MUQ1' then
        call PauseUnit(caster,true)
            call SetUnitInvulnerable(caster,true)
        call SaveReal(HH,id,35,25*(GetUnitAbilityLevel(caster,'MUQ1'))+(1+GetUnitAbilityLevel(caster,'MUQ1'))*GetHeroInt(caster,true))
        call TimerStart(t,0.02,true,function MadaraQSharinganAct)
    endif
        
    if GetSpellAbilityId()=='MUQ2' then
        call SaveReal(HH,id,35,(2+GetUnitAbilityLevel(caster,'MUQ2'))*GetHeroInt(caster,true))
        call TimerStart(t,0.02,true,function MadaraQRinneganAct)
    endif        
   //MadaraW
    if GetSpellAbilityId()=='MUW1' then
        call PauseUnit(caster,true)
            call SetUnitInvulnerable(caster,true)
        call SaveReal(HH,id,35,GetUnitAbilityLevel(caster,'MUW1')*50+(GetUnitAbilityLevel(caster,'MUW1')+1)*GetHeroInt(caster,true))
        call TimerStart(t,0.02,true,function MadaraWSharinganAct)
    endif
    if GetSpellAbilityId()=='MUW2' then
        if LoadGroupHandle(HH,GetHandleId(caster),SH_MadWGroup)!=null then
            call ForGroup(LoadGroupHandle(HH,GetHandleId(caster),SH_MadWGroup),function RemoveUnitGroup)
            call DestroyGroup(LoadGroupHandle(HH,GetHandleId(caster),SH_MadWGroup))
            call RemoveSavedHandle(HH,GetHandleId(caster),SH_MadWGroup)
        endif
        if LoadGroupHandle(HH,GetHandleId(caster),SH_MadWGroup1)!=null then
            call ForGroup(LoadGroupHandle(HH,GetHandleId(caster),SH_MadWGroup1),function RemoveUnitGroup)
            call DestroyGroup(LoadGroupHandle(HH,GetHandleId(caster),SH_MadWGroup1))
            call RemoveSavedHandle(HH,GetHandleId(caster),SH_MadWGroup1)
        endif
        if LoadBoolean(HH,GetHandleId(caster),SH_MadaraSusT2)==false then
            call SetUnitAnimationByIndex(caster,7)
        else
            call SetUnitAnimationByIndex(caster,2)
        endif
        call SaveGroupHandle(HH,id,4,CreateGroup())
        call SaveGroupHandle(HH,GetHandleId(caster),SH_MadWGroup,CreateGroup())
        call SaveGroupHandle(HH,GetHandleId(caster),SH_MadWGroup1,CreateGroup())
        call PauseUnit(caster,false)
        call SetUnitPathing(caster,true)
                    set soundplay=SndN(3568) // war3mapimported\MadaraW2.mp3
                            call StartSound(soundplay)
                            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        call EffectCreateAndMove(true,"Madara\\az_slb.mdl",GetRandomReal(0,360),1.5,2,0.8,100,100,100,0,-50,caster,0,facing)
        call EffectCreateAndMove(true,"Madara\\WindCircleFaster.mdl",facing,1,1.5,0.75,100,100,100,40,0,caster,0,facing)
        call EffectCreateAndMove(true,"Madara\\ShockWaveBlack.mdl",facing,1,2.5,0.75,100,100,100,0,0,caster,0,facing)
        set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
        call MoveUnit(n0,n0,200,facing)
        call SaveUnitHandle(HH,id,20,n0)
        set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
        call MoveUnit(n0,n0,200,facing)
        call MoveUnit(n0,n0,150,facing+90)
        call SaveUnitHandle(HH,id,21,n0)
        set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
        call MoveUnit(n0,n0,200,facing)
        call MoveUnit(n0,n0,150,facing-90)
        call SaveUnitHandle(HH,id,22,n0)
        set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
        call MoveUnit(n0,n0,200,facing)
        call MoveUnit(n0,n0,300,facing+90)
        call SaveUnitHandle(HH,id,23,n0)
        set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
        call MoveUnit(n0,n0,200,facing)
        call MoveUnit(n0,n0,300,facing-90)
        call SaveUnitHandle(HH,id,24,n0)
        set n0=null
        call SaveReal(HH,id,36,GetUnitAbilityLevel(caster,'MUW2'))
        call SaveReal(HH,id,35,GetHeroInt(caster,true)*(1+GetUnitAbilityLevel(caster,'MUW2')))
        call TimerStart(t,0.02,true,function MadaraWRinneganAct)
    endif
        
//MadaraE
    if GetSpellAbilityId()=='MUE2' then
        call PauseUnit(caster,true)
            call SetUnitInvulnerable(caster,true)
        call SaveReal(HH,id,35,(GetUnitAbilityLevel(caster,'MUE2')+3)*GetHeroInt(caster,true))
        call TimerStart(t,0.02,true,function MadaraERinneganAct)
    endif
    
    if GetSpellAbilityId()=='MUE1' then
        call PauseUnit(caster,true)
            call SetUnitInvulnerable(caster,true)
        call SaveReal(HH,id,11,GetUnitAbilityLevel(caster,'MUE1'))
        call SaveReal(HH,id,35,(GetUnitAbilityLevel(caster,'MUE1')+3)*0.35*GetHeroInt(caster,true))
        call TimerStart(t,0.02,true,function MadaraESharinganAct)
    endif
//
         
//MadaraT
    if GetSpellAbilityId()=='MUT2' then
        call PauseUnit(caster,true)
        call SetUnitInvulnerable(caster,true)
        call TimerStart(t,0.02,true,function MadaraTRinneganAct)
    endif
    
    if GetSpellAbilityId()=='MUT1' then
        call UnitAddAbility(caster, 'AMUN')
        call IssueImmediateOrder(caster,"bearform")
        call UnitRemoveAbility(caster, 'AMUN')
        call CheckUnitBonusRange(caster)
            call UnitRemoveBuffs(caster,false,true)
        call MadaraSusanoAct(caster,3)
        call TimerStart(t,0.02,true,function MadaraTSharinganAct)
    endif
//
        
    if GetSpellAbilityId()=='AMUG' then
        call PauseUnit(caster,true)
        call SaveBoolean(HH,GetHandleId(caster),SH_MadaraG,true)
        call SaveBoolean(HH,GetHandleId(caster),ANTITARGET_ABILITY,true)
        call TimerStart(t,0.02,true,function MadaraGAct)
    endif
        
    if GetSpellAbilityId()=='AMUR' then
        call MadaraSusanoAct(caster,1)
        call PauseUnit(caster,true)
        call TimerStart(t,0.02,true,function MadaraRAct)
    endif        
        //madaraF
    if GetSpellAbilityId()=='A0N1' then
        
        if LoadBoolean(HH,GetHandleId(caster),SH_MadaraF)==true then
        //A0N1
            call SaveBoolean(HH,GetHandleId(caster),SH_MadaraF,false)
            call SetUnitAbilityLevel(caster,'A2D4',1)
            set n0=CreateUnit(GetOwningPlayer(caster),'e12W',GetUnitX(caster),GetUnitY(caster),facing)
            call SetUnitModel(n0,"Madara\\SusanooBonesMadara.mdl")
            call SaveUnitHandle(HH,GetHandleId(caster),SH_MadaraBone,n0)
            call UnitSize(n0,1,1,1)
            call UnitSpeed(n0,1.5)
            call SaveUnitHandle(HH,id,20,n0)
            set n0=CreateUnit(GetOwningPlayer(caster),'e12W',GetUnitX(caster),GetUnitY(caster),facing)
            call SetUnitModel(n0,"Madara\\Madara-huitu-30.mdl")
            call UnitSize(n0,1.5,1,1)
            call SaveUnitHandle(HH,id,2,n0)
            set n0=null
            call TimerStart(t,0.02,true,function MadaraFBoneAct)
        else
                
            call SaveBoolean(HH,GetHandleId(caster),SH_MadaraF,true)
            call SetUnitAbilityLevel(caster,'A2D4',2)
            if LoadUnitHandle(HH,GetHandleId(caster),SH_MadaraBone)!=null then
            call RemoveUnit(LoadUnitHandle(HH,GetHandleId(caster),SH_MadaraBone))
            endif
            set n0=CreateUnit(GetOwningPlayer(caster),'e12W',GetUnitX(caster),GetUnitY(caster),facing)
            call SetUnitModel(n0,"Madara\\Rinnegan.mdl")
            call UnitSize(n0,1.5,1,1)
            call SaveUnitHandle(HH,id,2,n0)
            set n0=null
            call TimerStart(t,0.02,true,function MadaraFRinneganAct)
            call UnitStop(caster)
                
        endif   
        
    endif
        
        
    set t=null
    set c=null
    set caster=null
endfunction
function MadaraChoice_Cond takes nothing returns boolean
        local boolean cond1=GetSpellAbilityId()=='AMUG' or GetSpellAbilityId()=='AMUR' or GetSpellAbilityId()=='A0N1' or GetSpellAbilityId()=='MUQ1' or GetSpellAbilityId()=='MUQ2' or GetSpellAbilityId()=='MUW1' or GetSpellAbilityId()=='MUW2' or GetSpellAbilityId()=='MUE1' or GetSpellAbilityId()=='MUE2' or GetSpellAbilityId()=='MUT1' or GetSpellAbilityId()=='MUT2'
        if cond1 then
                return true
        else
                return false
        endif
endfunction
function InitTrig_MadaraChoice takes nothing returns nothing
        local trigger trig=CreateTrigger()
        local integer index
        set index=0
        loop
        call TriggerRegisterPlayerUnitEvent(trig,Player(index),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
        set index=index+1
        exitwhen index==bj_MAX_PLAYER_SLOTS
        endloop
        call TriggerAddCondition(trig,Condition(function MadaraChoice_Cond))
        call TriggerAddAction(trig,function MadaraChoice_Act)
        set trig=null
        set index=0
endfunction

//========== Madara END

//===========
//==============================================================================
//========= Hashirama Start
//==============================================================================
function HashiramaQCasttimeCond takes nothing returns boolean
return (GetIssuedOrderId()==OrderId("charm")and (GetUnitTypeId(GetTriggerUnit())=='HHSN' or GetUnitTypeId(GetTriggerUnit())=='HHSG')) or (GetIssuedOrderId()==OrderId("absorb") and GetUnitTypeId(GetTriggerUnit())=='HJi1')
endfunction
function HashiramaQCasttimeCast takes nothing returns nothing
    local unit u=GetTriggerUnit()
    if GetIssuedOrderId()==OrderId("charm") then
        if GetOrderTargetUnit()==u then
            call SetAbilityRealLevelField(GetUnitAbility(u,'HSQ1'),ABILITY_RLF_CASTING_TIME,0,0.3)
            call SetAbilityRealLevelField(GetUnitAbility(u,'HSQ1'),ABILITY_RLF_CASTING_TIME,1,0.3)
            call SetAbilityRealLevelField(GetUnitAbility(u,'HSQ1'),ABILITY_RLF_CASTING_TIME,2,0.3)
            call SetAbilityRealLevelField(GetUnitAbility(u,'HSQ1'),ABILITY_RLF_CASTING_TIME,3,0.3)
            call SetAbilityRealLevelField(GetUnitAbility(u,'HSQ1'),ABILITY_RLF_CASTING_TIME,4,0.3)
        else
            call SetAbilityRealLevelField(GetUnitAbility(u,'HSQ1'),ABILITY_RLF_CASTING_TIME,0,0)
            call SetAbilityRealLevelField(GetUnitAbility(u,'HSQ1'),ABILITY_RLF_CASTING_TIME,1,0)
            call SetAbilityRealLevelField(GetUnitAbility(u,'HSQ1'),ABILITY_RLF_CASTING_TIME,2,0)
            call SetAbilityRealLevelField(GetUnitAbility(u,'HSQ1'),ABILITY_RLF_CASTING_TIME,3,0)
            call SetAbilityRealLevelField(GetUnitAbility(u,'HSQ1'),ABILITY_RLF_CASTING_TIME,4,0)
        endif
    elseif GetIssuedOrderId()==OrderId("absorb") then
        if GetOrderTargetUnit()==u then
            call SetAbilityRealLevelField(GetUnitAbility(u,'JNQ1'),ABILITY_RLF_CASTING_TIME,0,0.2)
            call SetAbilityRealLevelField(GetUnitAbility(u,'JNQ1'),ABILITY_RLF_CASTING_TIME,1,0.2)
            call SetAbilityRealLevelField(GetUnitAbility(u,'JNQ1'),ABILITY_RLF_CASTING_TIME,2,0.2)
            call SetAbilityRealLevelField(GetUnitAbility(u,'JNQ1'),ABILITY_RLF_CASTING_TIME,3,0.2)
            call SetAbilityRealLevelField(GetUnitAbility(u,'JNQ1'),ABILITY_RLF_CASTING_TIME,4,0.2)
        else
            call SetAbilityRealLevelField(GetUnitAbility(u,'JNQ1'),ABILITY_RLF_CASTING_TIME,0,0.2)
            call SetAbilityRealLevelField(GetUnitAbility(u,'JNQ1'),ABILITY_RLF_CASTING_TIME,1,0.2)
            call SetAbilityRealLevelField(GetUnitAbility(u,'JNQ1'),ABILITY_RLF_CASTING_TIME,2,0.2)
            call SetAbilityRealLevelField(GetUnitAbility(u,'JNQ1'),ABILITY_RLF_CASTING_TIME,3,0.2)
            call SetAbilityRealLevelField(GetUnitAbility(u,'JNQ1'),ABILITY_RLF_CASTING_TIME,4,0.2)
        endif
    endif
    set u=null
endfunction
function HashiramaQCasttimeInit takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
call TriggerAddCondition(t,Condition(function HashiramaQCasttimeCond))
call TriggerAddAction(t,function HashiramaQCasttimeCast)
set t=null
endfunction
function UnitCreateAndMove1 takes unit l__a1,integer name1,unit l__b1,real d1,real life,real size,real speed,real red,real green,real blue,real visible,real high,unit l__a2,real distance,real d2,integer animID returns nothing
set n=CreateUnit(GetOwningPlayer(l__a1),name1,GetUnitX(l__b1),GetUnitY(l__b1),d1)
//call UnitLife2(n,0,life)
call MyRemoveUnit(n,life)
call UnitSize(n,size,size,size)
call UnitSpeed(n,speed)
call UnitColor(n,red,green,blue,visible)
call SetUnitFlyHeight(n,(GetUnitFlyHeight(l__a2)+high),0)
call MoveUnit(l__a2,n,distance,d2)
call SetUnitAnimationByIndex(n,animID)
set l__a1=null
set name1=0
set l__b1=null
set d1=0
set life=0
set size=0
set speed=0
set red=0
set green=0
set blue=0
set visible=0
set high=0
set l__a2=null
set distance=0
set d2=0
endfunction

function DamageAoeOneTime2Hashirama takes unit damager,real x0,real y0,real range,real damage,group gr1 returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
call GroupClear(G)
call GroupEnumUnitsInRange(G,x0,y0,range,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if  Condition_Base(GetOwningPlayer(damager),n0) and n0!=damager then
if IsUnitInGroup(n0,gr1)==false then
call myCustomDamage(damager,n0,damage,false,false,null,null,null)
call GroupAddUnit(gr1,n0)
endif
if GetUnitAbilityLevel(n0, 'CE04')==0 then
call CC_UnitEx( n0, n0, 0., 1.05, "root", false, "Hashirama\\MokutonRootStun.mdl", "origin", 0,0 )
endif
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
call SaveGroupHandle(HH,id,4,gr1)
set damager=null
set gr1=null
set t=null


endfunction

function DamageAoeOneTime41 takes unit damager,real x0,real y0,real range,real damage,group gr1 returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
call GroupClear(G)
call GroupEnumUnitsInRange(G,x0,y0,range,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if Condition_Base(GetOwningPlayer(damager),n0) and IsUnitInGroup(n0,gr1)==false then
call myCustomDamage(damager,n0,damage,false,false,null,null,null)
call GroupAddUnit(gr1,n0)
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
call SaveGroupHandle(HH,id,41,gr1)
set damager=null
set gr1=null
set t=null
endfunction

function DamageAoeOneTime01 takes unit damager,real x0,real y0,real range,real damage returns nothing
call GroupClear(G)
call GroupEnumUnitsInRange(G,x0,y0,range,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if  Condition_Base(GetOwningPlayer(damager),n0)  then
call myCustomDamage(damager,n0,damage,false,false,null,null,null)
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
set damager=null        
endfunction

function StopAoeOneTime takes unit damager,real x0,real y0,real range returns nothing
call GroupClear(G)
call GroupEnumUnitsInRange(G,x0,y0,range,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if  Condition_Base(GetOwningPlayer(damager),n0) and IsUnitInvulnerable(n0)==false and GetUnitAbilityLevel(n0,'B05G') == 0  then
call UnitStop(n0)
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
set damager=null        
endfunction
