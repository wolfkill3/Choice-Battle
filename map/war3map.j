function SenpoChoOdamaRasenTarenganMissleFly2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
local real dist=LoadReal(h,id,6)
local real mh=LoadReal(h,id,5)
local real rad=LoadReal(h,id,7)
local real rd=SR(x,y,x1,y1)
local real dmg=LoadReal(h,id,8)
local player p=GetOwningPlayer(l__d)
local integer idu=GetPlayerId(p)
local real speed=LoadReal(h,id,1)-.032*GetUnitFlyHeight(l__d)
if rd>20 then
call SetUnitX(l__d,x+1.25*speed*Cos(a))
call SetUnitY(l__d,y+1.25*speed*Sin(a))
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,ParabolaZ(mh,dist,rd),0)
else
call GroupEnumUnitsInRange(G,x1,y1,rad,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(Hero[idu],E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E,0.5,"stun")
endif
call GroupRemoveUnit(G,E)
endloop
call UnitApplyTimedLife(CreateUnit(p,'e06V',x1,y1,GetRandomReal(0,359)),'BHwe',1)
// эффектов взрыва 4 вместо 7 (22 клона x 7 = 154 юнита разом): убраны мелкие e06W, e06U и ветер e071
//call UnitApplyTimedLife(CreateUnit(p,'e06W',x1,y1,GetRandomReal(0,359)),'BHwe',1)
//call UnitApplyTimedLife(CreateUnit(p,'e06U',x1,y1,GetRandomReal(0,359)),'BHwe',1)
//call UnitApplyTimedLife(CreateUnit(p,'e06Z',x1,y1,GetRandomReal(0,359)),'BHwe',1)
//call UnitApplyTimedLife(CreateUnit(p,'e06X',x1,y1,GetRandomReal(0,359)),'BHwe',1)
call UnitApplyTimedLife(CreateUnit(p,'e06Y',x1,y1,GetRandomReal(0,359)),'BHwe',1)
call UnitApplyTimedLife(CreateUnit(p,'e070',x1,y1,GetRandomReal(0,359)),'BHwe',1)
//call UnitApplyTimedLife(CreateUnit(p,'e071',x1,y1,GetRandomReal(0,359)),'BHwe',1)
call UnitApplyTimedLife(CreateUnit(p,'e07C',x1,y1,GetRandomReal(0,359)),'BHwe',1)
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set l__d=null
set t=null
endfunction
function SenpoChoOdamaRasenTarenganMissleFly takes unit l__d,real speed,real angle,real x,real y,real mh,real r,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,mh)
call SaveReal(h,id,6,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,7,r)
call SaveReal(h,id,8,dmg)
call TimerStart(t,0.05,true,function SenpoChoOdamaRasenTarenganMissleFly2)
set t=null
endfunction
function SenpoChoOdamaRasenTarenganCond takes nothing returns boolean
return GetSpellAbilityId()==0x41305647 and udg_B==true
endfunction
function CastSenpoChoOdamaRasenTarengan takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local integer i=0
local real r
local real l__d
local real a=Atan2(y-y1,x-x1)
local real dmg=2*GetHeroStr(u,true)
local group g=CreateGroup()
loop
exitwhen i>21
set n=CreateUnit(p,'e0S9',x1+GetRandomReal(-750,750),y1+GetRandomReal(-750,750),a*bj_RADTODEG)
call DestroyEffect(AddSpecialEffect("war3mapImported\\shadowclone.mdl",GetUnitX(n),GetUnitY(n)))
call GroupAddUnit(g,n)
set i=i+1
endloop
set soundplay=SndN(2094) // Sound\Music\mp3Music\SenpoChoOdamaRasenTarengan.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SetUnitAnimation(u,"spell one")
loop
set E=FirstOfGroup(g)
set l__d=GetRandomReal(-1000,1000)
set r=GetRandomReal(0,7)
exitwhen E==null
call SetUnitAnimation(E,"Spell Five")
call SenpoChoOdamaRasenTarenganMissleFly(E,30,0,x+l__d*Cos(r),y+l__d*Sin(r),GetRandomReal(300,700),400,dmg)
call GroupRemoveUnit(g,E)
endloop
set p=null
set u=null
endfunction
function InitTrig_SenpoChoOdamaRasenTarengan takes nothing returns nothing
set gg_trg_SenpoChoOdamaRasenTarengan=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_SenpoChoOdamaRasenTarengan,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_SenpoChoOdamaRasenTarengan,Condition(function SenpoChoOdamaRasenTarenganCond))
call TriggerAddAction(gg_trg_SenpoChoOdamaRasenTarengan,function CastSenpoChoOdamaRasenTarengan)
endfunction
