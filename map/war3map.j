function ThunderMareCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local integer ids=GetSpellAbilityId()
local player p=GetOwningPlayer(u)
local real mana_burn = 0.0
call SaveUnitHandle(h,id,1,u)
if ids==0x41313837 and GetUnitTypeId(GetTriggerUnit())!='H007'  and GetUnitAbilityLevel(GetTriggerUnit(),'GIE1')==0 then
set n=CreateUnit(p,0x65304135,x,y,GetRandomReal(0,359))
call SetUnitScale(n,10,10,10)
call SetUnitTimeScale(n,6)
call UnitApplyTimedLife(n,1,0.5)
set n=CreateUnit(p,0x65304135,x,y,GetRandomReal(0,359))
call SetUnitScale(n,10,10,10)
call SetUnitTimeScale(n,6)
call UnitApplyTimedLife(n,1,0.5)
set n=CreateUnit(p,0x65304135,x,y,GetRandomReal(0,359))
call SetUnitScale(n,10,10,10)
call SetUnitTimeScale(n,6)
call UnitApplyTimedLife(n,1,0.5)
set n=CreateUnit(p,0x65303046,x,y,GetRandomReal(0,359))
call SetUnitScale(n,4,4,4)
call SetUnitTimeScale(n,0.25)
call UnitApplyTimedLife(n,1,2)
call GroupEnumUnitsInRange(DG,x,y,1100,Base)
loop
set E=FirstOfGroup(DG)
exitwhen E==null
if Condition_Base(p,E) then
    set mana_burn = GetWidgetMana(E)*0.1 + GetWidgetMaxMana(E)*0.05
    if IsUnitInvulnerable(E)!=true then
        call SetUnitState(E,UNIT_STATE_MANA,GetUnitState(E,UNIT_STATE_MANA)-mana_burn)
        //call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)+GetUnitState(E,UNIT_STATE_MAX_MANA)*0.085)
        if GetUnitState(E,UNIT_STATE_MANA)<100 then
            call SetControlToUnit(E,E, 2, "stun")
        endif
    else
        call SetUnitState(E,UNIT_STATE_MANA,GetUnitState(E,UNIT_STATE_MANA)-mana_burn*0.5)
        //call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)+(GetUnitState(E,UNIT_STATE_MAX_MANA)*0.085)/2)
        if GetUnitState(E,UNIT_STATE_MANA)<100 then
            call SetControlToUnit(E,E, 2, "silenceTE")
        endif
    endif
endif
call GroupRemoveUnit(DG,E)
endloop
elseif ids=='A18G' then
call SaveInteger(h,id,2,R2I(GetHeroAgi(u,true)*0.20))
call SaveInteger(h,id,3,R2I(GetHeroStr(u,true)*0.20))
call SaveReal(h,id,4,0)
call UnitAddAbility(u,'A18I')
call UnitMakeAbilityPermanent(u,true,'A18I')
call SetHeroAgi(u,GetHeroAgi(u,false)+R2I(GetHeroAgi(u,true)*0.20),false)
call SetHeroStr(u,GetHeroStr(u,false)+R2I(GetHeroStr(u,true)*0.20),false)
call CreateModeIndicatorWithPauseForm(u, "ReplaceableTextures\\CommandButtons\\BTNMare_Rain_Ring.blp", 15)
call TimerStart(t,0.05,true,function RainMareCast2)
elseif ids=='A189' and GetUnitTypeId(GetTriggerUnit())!='H007'  and GetUnitAbilityLevel(GetTriggerUnit(),'GIE1')==0 then
call UnitAddAbility(u,'A18B')
call UnitMakeAbilityPermanent(u,true,'A18B')
call CreateModeIndicatorForm(u, "ReplaceableTextures\\CommandButtons\\BTNMare_Sun_Ring.blp", 10)
call TimerStart(t,10,false,function SunMareCast2)
elseif ids=='A18K' and GetUnitTypeId(GetTriggerUnit())!='H007'  and GetUnitAbilityLevel(GetTriggerUnit(),'GIE1')==0 then
call UnitAddAbility(u,'A18L')
call UnitMakeAbilityPermanent(u,true,'A18L')
call UnitRemoveAbilityTimedPause(u,'A18L',6)
call CreateModeIndicatorWithPauseForm(u, "ReplaceableTextures\\CommandButtons\\BTNMare_Mist_Ring.blp", 6)
elseif ids==0x41313846 and GetUnitTypeId(GetTriggerUnit())!='H007'  and GetUnitAbilityLevel(GetTriggerUnit(),'GIE1')==0 then
set n=CreateUnit(p,0x65304C54,x,y,GetRandomReal(0,359))
call SetUnitScale(n,5,5,5)
call SetUnitTimeScale(n,6)
call UnitApplyTimedLife(n,1,0.5)
set n=CreateUnit(p,0x65304C54,x,y,GetRandomReal(0,359))
call SetUnitScale(n,5,5,5)
call SetUnitTimeScale(n,6)
call UnitApplyTimedLife(n,1,0.5)
set n=CreateUnit(p,0x65304C54,x,y,GetRandomReal(0,359))
call SetUnitScale(n,5,5,5)
call SetUnitTimeScale(n,6)
call UnitApplyTimedLife(n,1,0.5)
set n=CreateUnit(p,0x65304A42,x,y,GetRandomReal(0,359))
call SetUnitScale(n,5,5,5)
call SetUnitTimeScale(n,6)
call UnitApplyTimedLife(n,1,0.5)
set n=CreateUnit(p,0x65304A42,x,y,GetRandomReal(0,359))
call SetUnitScale(n,5,5,5)
call SetUnitTimeScale(n,6)
call UnitApplyTimedLife(n,1,0.5)
set n=CreateUnit(p,0x65304A42,x,y,GetRandomReal(0,359))
call SetUnitScale(n,5,5,5)
call SetUnitTimeScale(n,6)
call UnitApplyTimedLife(n,1,0.5)
call GroupEnumUnitsInRange(DG,x,y,450,Base)
loop
set E=FirstOfGroup(DG)
exitwhen E==null
if Condition_Base(p,E)then
call Push3(E,50,Atan2(GetUnitY(E)-y,GetUnitX(E)-x),400,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
call myCustomDamage(u,E,GetUnitState(E,UNIT_STATE_MAX_LIFE)*0.3,false,false,null,null,null)
endif
call GroupRemoveUnit(DG,E)
endloop
endif
set t=null
set p=null
set u=null
endfunction
