function AmaNoMurakamaCond takes nothing returns boolean
return GetUnitAbilityLevel(GetTriggerUnit(),'B02Z')==0 and GetIssuedOrderId()==OrderId("smart") and GetUnitTypeId(GetTriggerUnit())=='H02T'
endfunction
function AmaNoMurakamaCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local integer idu=GetHandleId(u)
local integer str=SH_lightwalk
local integer str2=SH_distlightwalk
local integer str3=SH_lightwalkcond
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,idu,str)
local real y1=LoadReal(h,idu,str+1)
local real a=Atan2(y1-y,x1-x)
local real dist=LoadReal(h,idu,str2)
local real speed=7+(GetHeroAgi(u,true)/20)
local player p=GetOwningPlayer(u)
if OrderId2String(GetUnitCurrentOrder(u))=="smart"and GetUnitTypeId(u)=='H02T' and SR(x,y,x1,y1)>speed+10 and GetUnitAbilityLevel(u, 'CBC2')==0 and GetUnitAbilityLevel(u, 'CBC1')==0 and GetUnitAbilityLevel(u, 'cbc4')==0 and GetUnitAbilityLevel(u, 'cbc6')==0 and GetUnitAbilityLevel(u, 'cbc5')==0  and GetUnitAbilityLevel(u, 'cbc7')==0 and GetUnitAbilityLevel(u, 'cbc8')==0 and GetUnitAbilityLevel(u, 'cbc9')==0 and IsUnitPaused(u)==false then
set x=x+speed*(1+SpeedRes*0.01)*Cos(a)
set y=y+speed*(1+SpeedRes*0.01)*Sin(a)
call SetUnitXY_1(u,x,y, false)
call SetUnitFacingInstant(u,a*bj_RADTODEG)
call SaveReal(h,idu,str2,dist+speed)
if dist>speed*2 then
call SaveReal(h,idu,str2,0)
endif
else
call SaveBoolean(h,idu,str3,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,idu)
endif
set p=null
set u=null
set t=null
endfunction
function AmaNoMurakamaCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local real x=GetOrderPointX()
local real y=GetOrderPointY()
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local integer idu=GetHandleId(u)
local integer str=SH_lightwalk
local integer str3=SH_lightwalkcond
if x!=0 and y!=0 and x1!=x and y1!=y then
call SaveReal(h,idu,str,x)
call SaveReal(h,idu,str+1,y)
if LoadBoolean(h,idu,str3)==false then
call SaveUnitHandle(h,id,0,u)
call SaveBoolean(h,idu,str3,true)
call TimerStart(t,0.01,true,function AmaNoMurakamaCast2)
endif
endif
set u=null
set t=null
endfunction
