                        call myCustomDamage(u,E,dmg,false,false,null,null,null)
                        call DestroyEffect(AddSpecialEffectTarget("Afb (1050).mdx",E,"chest"))
            call EffectToRandomBone("Minato-37.mdx", E)
            set soundplay=SndN(1155) // Sound\Music\mp3Music\EffectE v2 -03.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                        call SetControlToUnit(E,E, 0.6, "stun")
                endif
                call GroupRemoveUnit(g,E)
                exitwhen E==null
                endloop
        call UnitRemoveAbility(u,'A2CR')
                call SetUnitInvulnerable(u, false)
                call DestroyGroup(g)
                call SetUnitTimeScale(u,1)
                call PauseTimer(t)
                call DestroyTimer(t)
                call FlushChildHashtable(h,id)
        endif
set p=null
set u=null
set t=null
set g=null
endfunction
function ShredderCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,x+100*Cos(a))
call SaveReal(h,id,3,y+100*Sin(a))
call SetUnitTimeScale(u,0.8)
call SaveGroupHandle(h,id,4,CreateGroup())
call SetUnitInvulnerable(u,true)
call SetUnitAnimationByIndex(u,17)
call UnitAddAbility(u,'A2CR')
if GetUnitTypeId(u)=='H01M' then
set soundplay=SndN(1157) // Sound\Music\mp3Music\DanteE.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
elseif GetUnitTypeId(u)=='H21M' then
set soundplay=SndN(1159) // Sound\Music\mp3Music\DTDanteE.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call TimerStart(t,0.33,true,function ShredderCast2)
set u=null
set t=null
endfunction
