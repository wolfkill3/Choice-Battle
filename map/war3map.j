function Trig_Pistol_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A01H'
endfunction
function Trig_Pistol_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real l__s=LoadReal(h,id,2)
local real x=GetUnitX(c)
local real y=GetUnitY(c)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real a=LoadReal(h,id,3)
if UnitIsAlive(c)and l__s>0 then
call SetUnitXY_1(c,x+l__s*Cos(a),y+l__s*Sin(a), false)
call DestroyEffect(AddSpecialEffect("war3mapImported\\Slam.mdx",x,y))
call SaveReal(h,id,2,l__s-1)
else
call UnitRemoveAbility(c,'A0O5')
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set c=null
set t=null
endfunction
function Trig_Pistol_Actions takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
if GetUnitAbilityLevel(u,'LuG3')>0 then
set soundplay=SndN(882) // Sound\Music\mp3Music\GrizzlyMagnum.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set n=CreateUnit(p,'e043',x+25*Cos(a+deg90),y+25*Sin(a+deg90),a*bj_RADTODEG)
call SetUnitVertexColor(n,255,150,150,255)
call UnitApplyTimedLife(n,'BTLF',0.8)
set n=CreateUnit(p,'e043',x-25*Cos(a+deg90),y-25*Sin(a+deg90),a*bj_RADTODEG)
call SetUnitVertexColor(n,255,150,150,255)
call UnitApplyTimedLife(n,'BTLF',0.8)
call Push3(u,55,a+180*bj_DEGTORAD,500,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
call myCustomDamage(u,c,(GetHeroAgi(u,true)*GetUnitAbilityLevel(u,'A01H')+0.1*GetUnitState(c,UNIT_STATE_MAX_LIFE))*1.25,false,false,null,null,null)
else
call Push3(u,35,a+180*bj_DEGTORAD,500,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
set soundplay=SndN(884) // Sound\Music\mp3Music\JetBazooka.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call UnitApplyTimedLife(CreateUnit(p,'e03Z',x+25*Cos(a+deg90),y+25*Sin(a+deg90),a*bj_RADTODEG),'BTLF',0.8)
call UnitApplyTimedLife(CreateUnit(p,'e03Z',x-25*Cos(a+deg90),y-25*Sin(a+deg90),a*bj_RADTODEG),'BTLF',0.8)
call myCustomDamage(u,c,(GetHeroAgi(u,true)*GetUnitAbilityLevel(u,'A01H')+0.1*GetUnitState(c,UNIT_STATE_MAX_LIFE)),false,false,null,null,null)
endif
call SetControlToUnit(u,c,2, "stun")
call UnitApplyTimedLife(CreateUnit(p,'e040',x+25*Cos(a),y+25*Sin(a),a*bj_RADTODEG),'BTLF',1.5)
call UnitApplyTimedLife(CreateUnit(p,'e03W',x1,y1,0),'BTLF',1.5)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveReal(h,id,2,40)
call SaveReal(h,id,3,a)
call UnitAddAbility(c,'A0O5')
call TimerStart(t,0.04,true,function Trig_Pistol_Actions2)
else
call SetUnitPathing(u,true)
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitVertexColor(u,255,255,255,255)
call FlushChildHashtable(h,id)
call SetUnitTimeScale(u,1)
endif
set c=null
set t=null
set u=null
set p=null
endfunction
