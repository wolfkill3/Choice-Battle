if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveReal(h,id,2,x1)
call SaveReal(h,id,3,y1)
call SaveReal(h,id,4,Atan2(y1-y,x1-x))
call SetUnitX(u,GetUnitX(c))
call SetUnitY(u,GetUnitY(c))
call SetUnitAnimation(u,"Spell slam one")
call PauseUnit(u,true)
call SaveReal(h,id,100,0)
set soundplay=SndN(1666) // Sound\Music\mp3Music\SanjiR.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.020,true,function SanjiComboCast2)
else
call SetUnitX(u,GetUnitX(c))
call SetUnitY(u,GetUnitY(c))
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitVertexColor(u,255,255,255,255)
call FlushChildHashtable(h,id)
endif
set t=null
set u=null
set p=null
set c=null
endfunction
function DiableJambe3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real time=LoadReal(h,GetHandleId(u),SH_SSR)
if GetUnitAbilityLevel(u,'A0O1')>0 then
call SaveReal(h,GetHandleId(u),SH_SSR,time-0.1)
endif
if udg_B == false then
call SaveReal(h,GetHandleId(u),SH_SSR,time-15)
endif
if time<=0 or GetUnitAbilityLevel(u,'A0O1')==0 then
call SaveBoolean(HH,GetHandleId(u),SS,false)
call UnitRemoveAbility(u,'A0O1')
call RemoveUnit(LoadUnitHandle(h,id,25))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set t=null
set u=null
endfunction
function DiableJambeCond takes nothing returns boolean
return GetSpellAbilityId()=='A0O3' and udg_B==true
endfunction
function DiableJambeCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local timer tt=CreateTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real time=LoadReal(h,id,1)
local real speed=LoadReal(h,id,2)+0.15+0.005*GetHeroLevel(u)
if GetUnitCurrentOrder(u)==OrderId("dispel")and time<1.4-0.03*GetHeroLevel(u)then
call SaveReal(h,id,1,time+0.1)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitVertexColor(n,255,230,100,100)
call SetUnitScale(n,0.5,0.5,0.5)
call SaveReal(h,id,2,speed)
call SetUnitTimeScale(u,speed)
call UnitApplyTimedLife(CreateUnit(p,'e0MB',x,y,GetRandomReal(0,359)),'BTLF',0.8)
else
if time>1.4-0.03*GetHeroLevel(u)and GetHeroLevel(u)>=5 then
if GetUnitAbilityLevel(u,'A0O1')==0 then
call UnitAddAbility(u,'A0O1')
call SetUnitAbilityLevel(u,'A0O1',2)
call UnitMakeAbilityPermanent(u,true,'A0O1')
call UnitApplyTimedLife(CreateUnit(p,'e0MD',x,y,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0MC',x,y,GetRandomReal(0,359)),'BTLF',2)
endif
if LoadBoolean(HH,GetHandleId(u),SS)==false then
call SaveReal(h,GetHandleId(u),SH_SSR,15+GetHeroLevel(u))
call SaveUnitHandle(h,GetHandleId(tt),25,CreateUnit(p,0x68303431,RX,RY,0))
call SaveUnitHandle(h,GetHandleId(tt),0,u)
call SaveBoolean(HH,GetHandleId(u),SS,true)
call TimerStart(tt,0.1,true,function DiableJambe3)
call IssueImmediateOrder(u,"stop")
set soundplay=SndN(1668) // Sound\Music\mp3Music\DiableJumble.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
endif
call SetUnitTimeScale(u,1)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set tt=null
set u=null
set t=null
endfunction
function DiableJambeCast takes nothing returns nothing
