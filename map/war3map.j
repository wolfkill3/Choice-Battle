local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
call PauseUnit(u,true)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveReal(h,id,7,10)
call SetUnitInvulnerable(u,true)
call SaveReal(h,id,8,1000)
call SaveReal(h,id,5,Atan2(y1-y,x1-x))
call SetUnitVertexColor(u,255,255,255,125)
call SetUnitTimeScale(u,1.5)
call SetUnitAnimation(u,"attack")
call UnitRemoveAbility(u,'A2VJ')
set soundplay=SndN(2226) // Sound\Music\mp3Music\Fire Dragon's Sword Horn.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.1,true,function SwordHornNatsuCast2)
set t=null
set u=null
set p=null
set c=null
endfunction
function CrimsonLotusFireDragonFistCond takes nothing returns boolean
return GetSpellAbilityId()=='A10U'
endfunction
function CrimsonLotusFireDragonFistLightningCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=LoadReal(h,id,5)
local real dmg=(4+GetUnitAbilityLevel(u,'A10U'))*GetHeroStr(u,true)
local player p=GetOwningPlayer(u)
local real time=LoadReal(h,id,7)
local real ang=0
local real mt=LoadReal(h,id,8)
local real dist=GetRandomReal(-100,100)
local real a2=a+90*bj_DEGTORAD
if mt>0 and UnitIsAlive(u)then
set x1=x1-40*Cos(a)
set y1=y1-40*Sin(a)
call SetUnitXY_1(u,x1,y1, false)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call PauseUnit(u,true)
if time<0 then
set x1=x1+53*Cos(a)
set y1=y1+53*Sin(a)
call SetUnitXY_1(c,x1,y1, false)
set ang=GetRandomReal(-1,1)
call Slash(CreateUnit(p,'e0VQ',x1,y1,(a+ang)*bj_RADTODEG),30,0,(a+ang),GetRandomReal(800,1200),30,x,y,x,y)
call UnitApplyTimedLife(CreateUnit(p,'e0VM',x1,y1,GetRandomReal(0,359)),'BTLF',0.4)
call UnitApplyTimedLife(CreateUnit(p,'e0RK',x1,y1,GetRandomReal(0,359)),'BTLF',0.4)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,255,230,100,50)
set n=CreateUnit(p,'e0QG',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,0.75,0.75,0.75)
call SetUnitVertexColor(n,255,255,255,75)
set n=CreateUnit(p,'e0VP',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.5)
call SetUnitScale(n,2,2,2)
call SetUnitFlyHeight(n,75,0)
call SaveReal(h,id,7,mt)
call SaveReal(h,id,8,mt-0.4)
endif
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitAnimation(u,"attack")
call SaveReal(h,id,7,LoadReal(h,id,7)-3)
else
call Push3(c,35,a,600,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
call UnitApplyTimedLife(CreateUnit(p,'e0AX',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0AW',x1,y1,GetRandomReal(0,359)),'BTLF',0.01)
call UnitApplyTimedLife(CreateUnit(p,'e0B1',x1,y1,GetRandomReal(0,359)),'BTLF',0.4)
call UnitApplyTimedLife(CreateUnit(p,'e0B4',x1,y1,GetRandomReal(0,359)),'BTLF',0.4)
call UnitApplyTimedLife(CreateUnit(p,'e0AZ',x1,y1,GetRandomReal(0,359)),'BTLF',0.4)
call UnitApplyTimedLife(CreateUnit(p,'e0B3',x1,y1,GetRandomReal(0,359)),'BTLF',0.4)
call UnitApplyTimedLife(CreateUnit(p,'e0VN',x1,y1,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0VL',x1,y1,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0VM',x1,y1,GetRandomReal(0,359)),'BTLF',2)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call PauseUnit(u,false)
call myCustomDamage(u,c,dmg,false,false,null,null,null)
call SetControlToUnit(u,c,3, "stun")
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitVertexColor(u,255,255,255,255)
call FlushChildHashtable(h,id)
call UnitRemoveAbility(u,'A10V')
call SetUnitTimeScale(u,1)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
