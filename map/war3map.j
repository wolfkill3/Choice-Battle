function ShunshinJumpCond takes nothing returns boolean
return OrderId2String(GetIssuedOrderId())=="smart"and udg_B==true and GetUnitAbilityLevel(GetOrderedUnit(),'A0GI')>0
endfunction
function ShunshinJumpCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x1=GetOrderPointX()
local real y1=GetOrderPointY()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=Atan2(y1-y,x1-x)
if IsTerrainPathable(x1,y1,PATHING_TYPE_FLYABILITY)==false and LoadInteger(HH,GetHandleId(u),SH_HakuW)>0 then
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
call SaveInteger(HH,GetHandleId(u),SH_HakuW,LoadInteger(HH,GetHandleId(u),SH_HakuW)-1)
if SR(x,y,x1,y1)<250 then
call SetUnitXY_1(u,x1,y1, false)
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x1,y1))
else
call SetUnitXY_1(u,x+250*Cos(a),y+250*Sin(a), false)
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x+250*Cos(a),y+250*Sin(a)))
endif
call SetUnitFacing(u,a*bj_RADTODEG)
set soundplay=SndN(1225) // Sound\Music\mp3Music\NarutoFastStep.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
set u=null
endfunction
