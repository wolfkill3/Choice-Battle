function Trig_Steal_Shadow_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A066'
endfunction
function Trig_Steal_Shadow_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit c=LoadUnitHandle(h,id,0)
local group g=LoadGroupHandle(h,id,1)
local integer i=1
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local unit u
local real dist
local real dmg=(GetUnitAbilityLevel(c,'A066')+3)*GetHeroInt(c,true)
local integer l__idg=GetHandleId(g)
local real f
local player p=GetOwningPlayer(c)
local integer idu
loop
exitwhen i>15
set dist=LoadReal(h,id,StringHash("dist"+I2S(i)))+80
call SaveReal(h,id,StringHash("dist"+I2S(i)),dist)
set i=i+1
endloop
call UnitApplyTimedLife(CreateUnit(p,'e029',x,y,GetRandomReal(0,359)),'BTLF',2)
call DestroyEffect(AddSpecialEffect("war3mapImported\\DarkNova.mdx",x,y))
call GroupEnumUnitsInRange(g,x,y,dist,Base)
loop
set u=FirstOfGroup(g)
set idu=GetHandleId(u)
if IsUnitEnemy(u,p)and u!=LoadUnitHandle(h,l__idg,idu)and IsUnitType(u,UNIT_TYPE_STRUCTURE)==false then
call myCustomDamage(c,u,dmg,false,false,null,null,null)
call SaveUnitHandle(h,l__idg,idu,u)
call UnitApplyTimedLife(CreateUnit(p,'e025',GetUnitX(u),GetUnitY(u),GetRandomReal(0,359)),'BHwe',2)
call SlowUnit(c,u,0.3,0.3,3,2,false)
call SetControlToUnit(c,u,3, "Silence")
endif
call GroupRemoveUnit(g,u)
exitwhen u==null
endloop
if dist>=600 then
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
set c=null
set g=null
set u=null
set t=null
set p=null
endfunction
function Trig_Steal_Shadow_Actions takes nothing returns nothing
