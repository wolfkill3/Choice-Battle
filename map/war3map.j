set u=null
set t=null
endfunction
function Trig_Bone_Stomp_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A01A'
endfunction
function Stomp_Filter takes nothing returns boolean
return IsPlayerEnemy(GetOwningPlayer(GetTriggerUnit()),GetOwningPlayer(GetFilterUnit()))and GetWidgetLife(GetFilterUnit())>0.405 and not IsUnitType(GetFilterUnit(),UNIT_TYPE_STRUCTURE)and not IsUnitType(GetFilterUnit(),UNIT_TYPE_FLYING)
endfunction
function Bone_Stomp_Move takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local integer level=LoadInteger(h,id,0)
local group g=LoadGroupHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local real dur=LoadReal(h,id,4)+0.05
local real speed=LoadReal(h,id,5)
local real dist=LoadReal(h,id,6)+speed
local group l__n=CopyGroup(g)
local real tx
local real ty
local real a
local unit e
if dur<1 then
loop
set e=FirstOfGroup(l__n)
exitwhen e==null
set tx=GetUnitX(e)
set ty=GetUnitY(e)
set a=Atan2(ty-y,tx-x)
if GetUnitState(e,UNIT_STATE_LIFE)>0.405 and not IsTerrainPathable(tx+speed*Cos(a),ty+speed*Sin(a),PATHING_TYPE_FLYABILITY)then
call SetUnitX(e,tx+speed*Cos(a))
call SetUnitY(e,ty+speed*Sin(a))
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl",tx,ty))
else
call GroupRemoveUnit(g,e)
endif
call GroupRemoveUnit(l__n,e)
endloop
call SaveReal(h,id,4,dur)
call SaveReal(h,id,5,speed-(1.2-0.2*level))
call SaveReal(h,id,6,dist)
else
call GroupClear(g)
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
call DestroyGroup(l__n)
set l__n=null
set e=null
set t=null
set g=null
endfunction
function Trig_Bone_Stomp_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local integer level=GetUnitAbilityLevel(u,'A01A')
local boolexpr b=Condition(function Stomp_Filter)
local group g=CreateGroup()
local group l__n
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real dmg=100*GetUnitAbilityLevel(u,'A01A')+3*GetHeroAgi(u,true)
local integer i=0
local unit l__d
call GroupEnumUnitsInRange(g,x,y,300,b)
set l__n=CopyGroup(g)
loop
set E=FirstOfGroup(l__n)
exitwhen E==null
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",E,"chest"))
call SlowUnit(u,E,0.5,0,5,0,false)
endloop
call UnitApplyTimedLife(CreateUnit(p,'e007',x,y,0),'BTLF',0.5)
call UnitApplyTimedLife(CreateUnit(p,'e00U',x,y,0),'BTLF',0.5)
call SaveInteger(h,id,0,level)
call SaveGroupHandle(h,id,1,g)
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveReal(h,id,5,30.)
call TimerStart(t,0.05,true,function Bone_Stomp_Move)
set u=null
call DestroyBoolExpr(b)
set b=null
set g=null
call DestroyGroup(l__n)
set l__n=null
set t=null
set l__d=null
endfunction
function Trig_Bone_Nova_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A01D'
endfunction
function Trig_Bone_Nova_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit c=LoadUnitHandle(h,id,0)
local group g=LoadGroupHandle(h,id,1)
local integer i=1
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local unit u
local real dist
local real dmg=11*GetHeroAgi(c,true)
local integer l__idg=GetHandleId(g)
local real f
local player p=GetOwningPlayer(c)
local integer idu
loop
exitwhen i>15
set dist=LoadReal(h,id,StringHash("dist"+I2S(i)))+100
call SaveReal(h,id,StringHash("dist"+I2S(i)),dist)
set f=GetUnitFacing(c)+24*i
call UnitApplyTimedLife(CreateUnit(p,'e00S',x+dist*Cos(f*bj_DEGTORAD),y+dist*Sin(f*bj_DEGTORAD),GetRandomReal(0,359)),'BHwe',0.1)
set i=i+1
endloop
call GroupEnumUnitsInRange(g,x,y,dist,Base)
loop
set u=FirstOfGroup(g)
set idu=GetHandleId(u)
if IsUnitEnemy(u,p)and u!=LoadUnitHandle(h,l__idg,idu)and IsUnitType(u,UNIT_TYPE_STRUCTURE)==false then
call myCustomDamage(c,u,dmg,false,false,null,null,null)
call SetControlToUnit(c,u,1,"stun")
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",u,"chest"))
call SaveUnitHandle(h,l__idg,idu,u)
endif
call GroupRemoveUnit(g,u)
exitwhen u==null
endloop
if dist>=1200 then
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
set c=null
set g=null
set u=null
set t=null
set p=null
endfunction
