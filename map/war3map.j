function RemoveSaveHashTimedShikiE2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local real time=LoadReal(HH,id,4)
    if time<LoadReal(HH,id,3)then
    if GetUnitAbilityLevel(LoadUnitHandle(HH,LoadInteger(HH,id,1),LoadInteger(HH,id,2)),'A1BJ')==0 and GetUnitAbilityLevel(LoadUnitHandle(HH,id,5),'A1BI')==0 then
    call SaveReal(HH,id,4,time+0.02)
    endif
    else
    set n=LoadUnitHandle(HH,id,5)
    call SetPlayerAbilityAvailable(GetOwningPlayer(n),'A23W',false)
    call SetPlayerAbilityAvailable(GetOwningPlayer(n),'A1BU',true)
    call RemoveSavedHandle(HH,LoadInteger(HH,id,1),LoadInteger(HH,id,2))
    call DestroyTimer(t)
    call FlushChildHashtable(HH,id)
    endif
    set t=null
endfunction
function RemoveSaveHashTimedShikiE takes real time,integer id,integer ip,unit u returns nothing
    local timer t=CreateTimer()
