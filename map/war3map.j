call UnitSize(n0,1.25,1,1)
call MoveUnit(n0,n0,100,facing)
call SetUnitAnimationByIndex(n0,0)
call SetUnitFlyHeight(n0,100,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=null
endif
if time>1 then
set n0=LoadUnitHandle(HH,id,20)
set facing=Angle2(GetUnitX(n0),GetUnitY(n0),GetUnitX(LoadUnitHandle(HH,id,2)),GetUnitY(LoadUnitHandle(HH,id,2)))
call SetUnitFacingInstant(n0,facing)
call MoveUnit(n0,n0,40,facing)
set n0=null
endif
endif
