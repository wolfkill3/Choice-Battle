function MACCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local integer i=LoadInteger(h,id,2)
local real f=GetRandomReal(0,359)*bj_DEGTORAD
if i<1+GetUnitAbilityLevel(u,'A0B4')and GetWidgetLife(c)>0 then
call SetUnitX(u,x1+100*Cos(f))
call SetUnitY(u,y1+100*Sin(f))
call SetUnitFacingInstant(u,Atan2(y1-y,x1-x))
call IssueTargetOrder(u,"attack",c)
call myCustomDamage(u,c,0.3*GetHeroInt(u,true)*CambioXDmg(u),false,false,null,null,null)
call SaveInteger(h,id,2,i+1)
call DestroyEffect(AddSpecialEffect("war3mapImported\\Slam.mdl",x,y))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl",x,y))
else
call SetUnitTurnSpeed(u,0.60)
call SetUnitInvulnerable(u,false)
call UnitRemoveAbility(u,'A06I')
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set t=null
set c=null
endfunction
