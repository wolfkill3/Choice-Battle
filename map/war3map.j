call UnitApplyTimedLife(n,'BTLF',2.5)
call LiCloneEffect(n,1.5,4,2.5,155)
set n=CreateUnit(p,'eo9R',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',1.5)
endif
set g=null
set l__d=null
set u=null
set p=null
set t=null
endfunction
