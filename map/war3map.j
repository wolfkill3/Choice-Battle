function W2DeidaraCond takes nothing returns boolean
return GetSpellAbilityId()=='Ad12' and udg_B==true
endfunction
function W2DeidaraCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit l__d=LoadUnitHandle(HH,GetHandleId(u),SH_DeiW)
local player p=GetOwningPlayer(u)
local integer dmg=(3+GetUnitAbilityLevel(u,'Ad02'))*GetHeroInt(u,true)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
if UnitIsAlive(l__d)then
    call SetUnitPathing(u,true)
    call GroupEnumUnitsInRange(G,x,y,400,Base)
    call DestroyEffect(AddSpecialEffect("war3mapImported\\newmassiveex.mdx",x,y))
    call DestroyEffect(AddSpecialEffect("war3mapImported\\blast2.mdx",x,y))
    call DestroyEffect(AddSpecialEffect("war3mapImported\\LW10.mdx",x,y))
    set soundplay=SndN(2999) // Sound\war3mapImported\DeidaraW2.mp3
    call StartSound(soundplay)
    call SetSoundVolume(soundplay,250)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    loop
        set E=FirstOfGroup(G)
        if Condition_Base(p,E)then
            call myCustomDamage(u,E,dmg,false,false,null,null,null)
        endif
        call GroupRemoveUnit(G,E)
        exitwhen E==null
    endloop
    call UnitApplyTimedLife(l__d,'BTLF',0.02)
    call SaveReal(HH,GetHandleId(l__d),TextTagTimeHash,-0.03)
    call SaveReal(HH,GetHandleId(l__d),TextTagHealTimeHash,-0.03)
    call RemoveSavedHandle(HH,GetHandleId(u),SH_DeiW)
endif
if IsAbilityVisible(GetUnitAbility(u,'Ad12'))==true then
    call ShowAbility2('Ad12',false)
    call ShowAbility2('Ad02',true)
endif
set u=null
set l__d=null
set p=null
endfunction
