                call SetUnitScale(n, 1, 1, 1)
                call MyRemoveUnit(n, 1.5)
                call SetUnitX(caster, GetUnitX(target)+170*Cos(angle))
                call SetUnitY(caster, GetUnitY(target)+170*Sin(angle))
                set angle=AU(caster, target)
                set n=CreateUnit(GetOwningPlayer(caster), 'd042', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
                call SetUnitScale(n, 1, 1, 1)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'd020', GetUnitX(target), GetUnitY(target), angle*bj_RADTODEG)
                call SetUnitFlyHeight(n, 5, 0)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'd010', GetUnitX(target), GetUnitY(target), angle*bj_RADTODEG)
                call SetUnitFlyHeight(n, 5, 0)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'd014', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG)
                call SetUnitScale(n, 1, 1, 1)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'd066', GetUnitX(target), GetUnitY(target), angle*bj_RADTODEG)
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call SetUnitTimeScale(n, 0.75)
                call SetUnitFlyHeight(n, 100, 0)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'dM04', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG)
                call SetUnitTimeScale(n, 0.7)
                call SetUnitFlyHeight(n, 150, 0)
                call MyRemoveUnit(n, 1.5)
        
                set n=CreateUnit(GetOwningPlayer(caster), 'd036', GetUnitX(target), GetUnitY(target), angle*bj_RADTODEG)
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call SetUnitFlyHeight(n, 150, 0)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(caster), 'd073', GetUnitX(target), GetUnitY(target), angle*bj_RADTODEG)
                call SetUnitScale(n, 1.8, 1.8, 1.8)
                call SetUnitFlyHeight(n, 0, 0)
                call SaveUnitHandle(h, id, 20, n)
                call SetUnitFacingInstant(caster, AU(caster, target)*bj_RADTODEG)
                call SetUnitAnimationByIndex(caster, 7)
                call RemoveEffect(AddSpecialEffectTarget("supershinythingyhg2.mdl", caster, "hand left"), 2.5, true, CreateTimer())
                call Push3(target , 20 , AU(caster, target) , 350 , "")
                call ShakeCamera(0.2, 10)
            else
                set n=CreateUnit(GetOwningPlayer(caster), 'd042', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
                call SetUnitScale(n, 1, 1, 1)
                call MyRemoveUnit(n, 1.5)
                call SetUnitX(caster, GetUnitX(target)+170*Cos(angle))
                call SetUnitY(caster, GetUnitY(target)+170*Sin(angle))
                set n=CreateUnit(GetOwningPlayer(caster), 'd042', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
                call SetUnitScale(n, 1, 1, 1)
                call MyRemoveUnit(n, 1.5)
                call SetUnitPathing(caster,true)
                call SetUnitInvulnerable(caster,false)
                call PauseUnit(caster,false)
                call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
                call SaveUnitHandle(HH,GetHandleId(target),REVERSE_TARGET,caster)
                call PauseTimer(newTimer)
                call DestroyTimer(newTimer)
                call SetUnitVertexColor(caster,255,255,255,255)
                call FlushChildHashtable(h,id)
                call SetUnitTimeScale(caster,1)
            endif
		endif
		if time==1.4 then
			set n=CreateUnit(GetOwningPlayer(caster), 'd042', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
			call SetUnitScale(n, 1, 1, 1)
			call MyRemoveUnit(n, 1.5)
			call SetUnitX(caster, GetUnitX(target)+170*Cos(angle))
			call SetUnitY(caster, GetUnitY(target)+170*Sin(angle))
			set angle=AU(caster, target)
			set n=CreateUnit(GetOwningPlayer(caster), 'd042', GetUnitX(caster), GetUnitY(caster), GetRandomInt(0, 360))
			call SetUnitScale(n, 1, 1, 1)
			call MyRemoveUnit(n, 1.5)
			set n=CreateUnit(GetOwningPlayer(caster), 'd020', GetUnitX(target), GetUnitY(target), angle*bj_RADTODEG)
			call SetUnitFlyHeight(n, 5, 0)
			call MyRemoveUnit(n, 1.5)
			call SetUnitAnimationByIndex(caster, 7)
			call RemoveEffect(AddSpecialEffectTarget("supershinythingyhg2.mdl", caster, "hand left"), 1.5, true, CreateTimer())
		endif
		if time==1.4 then
			set n=CreateUnit(GetOwningPlayer(caster), 'd014', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG)
			call SetUnitScale(n, 1, 1, 1)
			call MyRemoveUnit(n, 1.5)
			set n=CreateUnit(GetOwningPlayer(caster), 'd045', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG)
			call SetUnitScale(n, 2.5, 2.5, 2.5)
			call SetUnitFlyHeight(n, 100, 0)
			call MyRemoveUnit(n, 1.5)
			set n=CreateUnit(GetOwningPlayer(caster), 'd046', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG)
			call SetUnitScale(n, 2.5, 2.5, 2.5)
			call SetUnitFlyHeight(n, 200, 0)
			call MyRemoveUnit(n, 1.5)
			set n=CreateUnit(GetOwningPlayer(caster), 'd009', GetUnitX(target), GetUnitY(target), angle*bj_RADTODEG)
			call SetUnitScale(n, 2.5, 2.5, 2.5)
			call SetUnitFlyHeight(n, 10, 0)
			call MyRemoveUnit(n, 1.5)
		endif
		if time==1.7 then
			call KillUnit(LoadUnitHandle(h, id, 20))
			call MyRemoveUnit(LoadUnitHandle(h, id, 20), 1.5)
			set n=CreateUnit(GetOwningPlayer(caster), 'd036', GetUnitX(target), GetUnitY(target), angle*bj_RADTODEG)
			call SetUnitScale(n, 1.7, 1.7, 1.7)
			call SetUnitFlyHeight(n, 150, 0)
			call MyRemoveUnit(n, 1.5)
			set n=CreateUnit(GetOwningPlayer(caster), 'd037', GetUnitX(target), GetUnitY(target), angle*bj_RADTODEG)
			//call SetUnitScale(n, 1.7, 1.7, 1.7)
			//call SetUnitFlyHeight(n, 150, 0)
			call MyRemoveUnit(n, 1.5)
			set n=CreateUnit(GetOwningPlayer(caster), 'd018', GetUnitX(target), GetUnitY(target), angle*bj_RADTODEG)
			call SetUnitScale(n, 2.7, 2.7, 2.7)
			call MyRemoveUnit(n, 1.5)
			set n=CreateUnit(GetOwningPlayer(caster), 'd010', GetUnitX(target), GetUnitY(target), angle*bj_RADTODEG)
			call SetUnitScale(n, 2.7, 2.7, 2.7)
			call MyRemoveUnit(n, 1.5)
			set n=CreateUnit(GetOwningPlayer(caster), 'd075', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG)
			call SetUnitFlyHeight(n, 5, 0)
			call SetUnitScale(n, 0.8, 0.8, 0.8)
			call SaveUnitHandle(h, id, 5, n)
			set n=CreateUnit(GetOwningPlayer(caster), 'd076', GetUnitX(caster), GetUnitY(caster), angle*bj_RADTODEG)
			call SetUnitFlyHeight(n, 200, 0)
			call SetUnitScale(n, 3, 3, 3)
			call SaveUnitHandle(h, id, 6, n)
			call Push3(target , 30 , AU(caster, target) , 250 , "")
			call PauseUnit(caster, false)
			call SetUnitInvulnerable(caster, false)
			call myCustomDamage(caster, target, LoadReal(h, id, 9), false,false,null,null,null)
			call SetControlToUnit(target, target, 2.0, "stun")
		endif
		if time>1.7 then
			call SetUnitX(target, GetUnitX(target)+35*Cos(angle))
			call SetUnitY(target, GetUnitY(target)+35*Sin(angle))
			call SetUnitX(LoadUnitHandle(h, id, 5), GetUnitX(target)-150*Cos(angle))
			call SetUnitY(LoadUnitHandle(h, id, 5), GetUnitY(target)-150*Sin(angle))
			call SetUnitX(LoadUnitHandle(h, id, 6), GetUnitX(target)-150*Cos(angle))
			call SetUnitY(LoadUnitHandle(h, id, 6), GetUnitY(target)-150*Sin(angle))
			if eff_period<=0 then
				if time<1.9 then
					set n=CreateUnit(GetOwningPlayer(caster), 'd045', GetUnitX(target)-50*Cos(angle), GetUnitY(target)-50*Sin(angle), angle*bj_RADTODEG)
					call SetUnitScale(n, 2.8, 2.8, 2.8)
					call SetUnitFlyHeight(n, 125, 0)
					call MyRemoveUnit(n, 1.0)
				endif
				set n=CreateUnit(GetOwningPlayer(caster), 'd010', GetUnitX(target), GetUnitY(target), angle*bj_RADTODEG)
				call SetUnitScale(n, 2.5, 2.5, 2.5)
				call SetUnitFlyHeight(n, 5, 0)
				call MyRemoveUnit(n, 1.5)
				call SaveInteger(h, id, 4, 4)
			else
				call SaveInteger(h, id, 4, eff_period-1)
			endif
		endif
	else
		set n=CreateUnit(GetOwningPlayer(caster), 'd020', GetUnitX(target), GetUnitY(target), angle*bj_RADTODEG)
		call SetUnitFlyHeight(n, 5, 0)
		call MyRemoveUnit(n, 1.5)
		call UnitApplyTimedLife(LoadUnitHandle(h, id, 5), 1, 0.3)
		call UnitApplyTimedLife(LoadUnitHandle(h, id, 6), 1, 0.3)
		call MyRemoveUnit(LoadUnitHandle(h, id, 5), 2)
		call MyRemoveUnit(LoadUnitHandle(h, id, 6), 2)
		call FlushChildHashtable(h, id)
		call PauseTimer(newTimer)
		call DestroyTimer(newTimer)
	endif
	set newTimer=null
	set caster=null
	set target=null
endfunction

function IchigoBankaiW_Counter takes unit newCaster, unit newTarget returns nothing
        local timer newTimer = CreateTimer()
        local integer id     = GetHandleId(newTimer)
        local real caster_x  = GetUnitX(newCaster)
        local real caster_y  = GetUnitY(newCaster)
        local real angle     =  AU(newCaster, newTarget)
        local real damage    = GetHeroStr(newCaster, true)*6
        call SaveBoolean(HH,GetHandleId(newCaster),ANTITARGET_ABILITY,false)               
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd001', caster_x, caster_y, GetRandomInt(0, 360))
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd047', caster_x+200*Cos(angle), caster_y+200*Sin(angle), GetRandomInt(0, 360))
        call SetUnitScale(n, 3, 3, 3)
        call SetUnitFlyHeight(n, 100, 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd032', caster_x+200*Cos(angle), caster_y+200*Sin(angle), GetRandomInt(0, 360))
        call SetUnitScale(n, 2, 2, 2)
        call SetUnitFlyHeight(n, 100, 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'd074', caster_x+200*Cos(angle), caster_y+200*Sin(angle), angle*bj_RADTODEG)
        call SetUnitScale(n, 2, 2, 2)
        call SetUnitFlyHeight(n, 75, 0)
        call UnitApplyTimedLife(n, 1, 0.2)
        call MyRemoveUnit(n, 1.5)
        call UnitRemoveAbility(newCaster, 'IcB1')
        call PauseUnit(newCaster, true)
        call SetUnitInvulnerable(newCaster, true)
        call SetUnitAnimationByIndex(newCaster, 3)
        call SaveUnitHandle(h, id, 0, newCaster)
        call SaveUnitHandle(h, id, 1, newTarget)
        call SaveReal      (h, id, 2, 0.0)
        call SaveReal      (h, id, 3, angle)
        call SaveReal      (h, id, 9, damage)
        call TimerStart(newTimer, 0.02, true, function IchigoBankaiW_CounterPeriodic)
        set newTimer=null
endfunction
//function AnimeRandom
function CheckAngleDummyCond takes nothing returns boolean
return GetUnitAbilityLevel(GetTriggerUnit(),'Pet2')>0 and GetIssuedOrderId()==OrderId("smart") 
endfunction

function CheckAngleDummyCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetOrderPointX()
local real y=GetOrderPointY()
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local integer idu=GetHandleId( (GetOwningPlayer( u )) )
local real facing=Angle2(x1,y1,x,y)

call SaveReal(HH,idu,StringHash("DummyFacing"),facing)
//call DisplayTextToPlayer(GetLocalPlayer(),0,0,"facing:"+R2S( facing ))

set u=null

endfunction


function CheckAngleDummyInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER,null)
set i=i+1
exitwhen i==bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function CheckAngleDummyCast)
call TriggerAddCondition(t,Condition(function CheckAngleDummyCond))
set t=null
endfunction

function PolX takes real px,real distance,real l__a returns real
return px+distance*Cos(l__a*bj_DEGTORAD)
endfunction
function PolY takes real py,real distance,real l__a returns real
return py+distance*Sin(l__a*bj_DEGTORAD)
endfunction
function MoveAoe takes location l,unit u1,real distance,real l__degrees returns nothing
local real x=PolX(GetLocationX(l),distance,l__degrees)
local real y=PolY(GetLocationY(l),distance,l__degrees)
if IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
call SetUnitX(u1,x)
call SetUnitY(u1,y)
endif
set x=0
set y=0
set l=null
set u1=null
set distance=0
set l__degrees=0
endfunction
function MoveUnit takes unit u,unit u1,real distance,real l__degrees returns nothing
local real x=PolX(GetUnitX(u),distance,l__degrees)
local real y=PolY(GetUnitY(u),distance,l__degrees)
if IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
call SetUnitX(u1,x)
call SetUnitY(u1,y)
endif
set u=null
set u1=null
endfunction
function UnitSpeed takes unit u,real speed returns nothing
call SetUnitTimeScale(u,speed)
set u=null
set speed=0
endfunction
function UnitSize takes unit u,real size,real size1,real size2 returns nothing
call SetUnitScale(u,size,size1,size2)
set u=null
set size=0.0
set size1=0.0
set size2=0.0
endfunction
function ColorPercentT takes real percentage,integer max returns integer
local integer result=R2I(percentage*I2R(max)*0.01)
if(result<0)then
set result=0
elseif(result>max)then
set result=max
endif
set max=0
set percentage=0.0
return result
endfunction
function UnitColor takes unit u,real red,real green,real blue,real visible returns nothing
call SetUnitVertexColor(u,ColorPercentT(red,255),ColorPercentT(green,255),ColorPercentT(blue,255),ColorPercentT((100-visible),255))
set u=null
set red=0.0
set green=0.0
set blue=0.0
set visible=0.0
endfunction
function UnitCreateAndMove takes unit l__a1,integer name1,unit l__b1,real d1,real life,real size,real speed,real red,real green,real blue,real visible,real high,unit l__a2,real distance,real d2 returns nothing
set n=CreateUnit(GetOwningPlayer(l__a1),name1,GetUnitX(l__b1),GetUnitY(l__b1),d1)
//call UnitLife2(n,0,life)

call MyRemoveUnit(n,life)
call UnitSize(n,size,size,size)
call UnitSpeed(n,speed)
call UnitColor(n,red,green,blue,visible)
call SetUnitFlyHeight(n,(GetUnitFlyHeight(l__a2)+high),0)
call MoveUnit(l__a2,n,distance,d2)
set l__a1=null
set name1=0
set l__b1=null
set d1=0
set life=0
set size=0
set speed=0
set red=0
set green=0
set blue=0
set visible=0
set high=0
set l__a2=null
set distance=0
set d2=0
endfunction

function JanneAlterDecreaseDef1 takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit target=LoadUnitHandle(HH,id,1)
local real time=LoadReal(HH,id,5)

if IsUnitPaused(target)==false then
set time=time+0.1
call SaveReal(HH,id,5,time)
endif

if GetUnitAbilityLevel(target,'JAGd')==0 then
call UnitAddAbility(target,'JAGd')
call SetUnitAbilityLevel(target,'JAGd',LoadInteger(HH,id,10) )
endif
if time==5 or GetUnitAbilityLevel(target,'BJAd')==0 then
call UnitRemoveAbility(target,'JAGd')
call UnitRemoveAbility(target,'BJAd')
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
set target=null
endfunction
function JanneAlterDecreaseDef takes unit target0, integer levels0 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call UnitAddAbility(target0,'JAG2')
call UnitRemoveAbility(target0,'JAG2')
call SaveUnitHandle(HH,id,1,target0)
call SaveInteger(HH,id,10,levels0)
call TimerStart(t,0.1,true,function JanneAlterDecreaseDef1)
set target0=null
set t=null
endfunction






