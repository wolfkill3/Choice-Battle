    call TriggerRegisterFrameEvent( tOnUnPress, OpenIdButton, FRAMEEVENT_MOUSE_UP )
    call TriggerRegisterFrameEvent( tOnClick, OpenIdButton, FRAMEEVENT_CONTROL_CLICK )
    
    call TriggerAddAction( tOnPress, function OnButtonPress )
    call TriggerAddAction( tOnUnPress, function OnButtonUnpress )
    call TriggerAddAction( tOnClick, function OnButtonOpenId )
    //call BJDebugMsg(B2S_EXD(IsOperationLimitEnabled())
    loop
        exitwhen x>=12
        set toggleStatus = CreateTrigger( )  
        call TriggerRegisterPlayerKeyEvent( toggleStatus, Player(x), OSKEY_I, 1 ,true )
        call TriggerAddAction( toggleStatus, function ToggleOpenId )
        set x=x+1
    endloop
    
    set InfoIdText=CreateFrameByType( "SIMPLETEXT", "TestBarInfoText", IdHeroFrame, "", 0 )
