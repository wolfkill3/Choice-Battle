call SaveReal(h,id,3,angle)
call SaveReal(h,id,4,speed)
call SaveReal(h,id,5,dmg)
call TimerStart(t,0.04,true,function MissleMoveSabakuKyuE2)
set t=null
endfunction
function GaaraQSand1 takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit target=LoadUnitHandle(HH,id,2)
local unit Dummy=LoadUnitHandle(HH,id,21)
local real facing=GetUnitFacing(target)
local real time=LoadReal(HH,id,5)
set time=time+0.02
call SaveReal(HH,id,5,time)

if time==1 then
call UnitSpeed(Dummy,0)
endif

call MoveUnit(target,Dummy,0,facing)

if LoadBoolean(HH,GetHandleId( caster ),StringHash("GaaraGQactB"))==true then
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif



if time==7 or LoadInteger(HH,GetHandleId( caster ),StringHash("GaaraGtype"))==2 or LoadInteger(HH,GetHandleId( caster ),StringHash("GaaraGtype"))==3 or LoadInteger(HH,GetHandleId( caster ),StringHash("GaaraGtype"))==4 then
//call SaveInteger(HH,GetHandleId( caster ),StringHash("GaaraGtype"),0)
call SaveUnitHandle(HH,GetHandleId(caster),StringHash("GaaraQUDummy"),null)
call RemoveUnit(Dummy)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif

set Dummy=null
set caster=null
set target=null
endfunction


function GaaraQSand takes unit caster0 , unit target0 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(HH,id,1,caster0)
call SaveUnitHandle(HH,id,2,target0)

set n0=CreateUnit(GetOwningPlayer(caster0),'e200',GetUnitX(target0),GetUnitY(target0),GetUnitFacing(caster0) )
call SetUnitModel(n0,"Gaara\\[NL]GaaraEffect_SandBall2.mdl")
call UnitSize(n0,1,1,1)
call SetUnitFlyHeight(n0,0,0)
call UnitSpeed(n0,0.5)
call SaveUnitHandle(HH,id,21,n0)
call SetUnitAnimationByIndex(n0,1)
call SaveUnitHandle(HH,GetHandleId(caster0),StringHash("GaaraQUDummy"),n0)


//call SaveUnitHandle(HH,GetHandleId(caster),StringHash("GaaraRU"),n0)


call TimerStart(t,0.02,true,function GaaraQSand1)

set n0=null

set t=null
set caster0=null
set target0=null
endfunction


function MissleMoveSabakuKyu2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit l__d=LoadUnitHandle(h,id,2)
local real speed=LoadReal(h,id,4)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)+LoadReal(h,id,3)
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>speed+40 then
set x=x+speed*Cos(a)
set y=y+speed*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call DestroyEffect(AddSpecialEffect("war3mapImported\\GaaraMissile.mdl", GetUnitX(c) , GetUnitY(c) ))
else
call UnitApplyTimedLife(CreateUnit(p,'e0FG', GetUnitX(c) , GetUnitY(c) ,GetRandomReal(0,359)),1,4.2)
call UnitApplyTimedLife(CreateUnit(p,'e0FI', GetUnitX(c) , GetUnitY(c) ,GetRandomReal(0,359)),1,4.2)
call UnitApplyTimedLife(CreateUnit(p,'e0FF', GetUnitX(c) , GetUnitY(c) ,GetRandomReal(0,359)),1,4.2)
//set n=CreateUnit(p,0x65304648,x,y,GetRandomReal(0,359))
//call UnitApplyTimedLife(n,1,4.2)
//call UnitScale(n,0.1,1,1)

set soundplay=CreateSound("Sound\\Music\\mp3Music\\GaaraQ2.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)

call UnitApplyTimedLife(CreateUnit(p,'e0FE',x,y,GetRandomReal(0,359)),1,4.2)
call myCustomDamage(u,c,LoadReal(h,id,5),false,false,null,null,null)
call SetControlToUnit(u,c,2,"stun")

call SaveUnitHandle(HH,GetHandleId( u ),StringHash("GaaraQU"), c)


call GaaraQSand( u , c)
call SaveInteger(HH,GetHandleId( u ),StringHash("GaaraGtype"),1)


call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
call RemoveUnit(l__d)
endif
set p=null
set l__d=null
set c=null
set t=null
set u=null
endfunction
function MissleMoveSabakuKyu takes unit u,unit c,unit l__d,real speed,real angle,real dmg returns nothing
