endfunction
function Trig_RyuseiDamag_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real dmg=GetHeroStr(udg_Hero[GetPlayerId(p)+1],true)*2
local real x=GetUnitX(u)
local real y=GetUnitY(u)
if GetUnitTypeId(GetTriggerUnit())==0x65303248 then
call UnitApplyTimedLife(CreateUnit(p,'e02G',x,y,0),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e02I',x,y,0),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e02J',x,y,0),1,1)
call GroupEnumUnitsInRange(G,x,y,320,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(udg_Hero[GetPlayerId(p)+1],E,dmg*1.5,false,false,null,null,null)
call SetControlToUnit(E,E, 0.5, "stun")
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Flameshock.mdx",E,"chest"))
endif
call GroupRemoveUnit(G,E)
endloop
else
set dmg=GetHeroStr(udg_Hero[GetPlayerId(p)+1],true)
call GroupEnumUnitsInRange(G,x,y,300,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(udg_Hero[GetPlayerId(p)+1],E,dmg,false,false,null,null,null)
call SetUnitManaPercentBJ(E,GetUnitManaPercent(E)-5)
endif
call GroupRemoveUnit(G,E)
endloop
endif
call RemoveUnit(u)
set u=null
endfunction
function GintokiBikeStopOrders takes nothing returns nothing
if GetOrderTargetUnit()==null then
call SaveReal(HH,GetHandleId(GetOrderedUnit()),StringHash("GinAnge"),Atan2(GetOrderPointY()-GetUnitY(GetOrderedUnit()),GetOrderPointX()-GetUnitX(GetOrderedUnit()))*bj_RADTODEG)
else
call SaveReal(HH,GetHandleId(GetOrderedUnit()),StringHash("GinAnge"),Atan2(GetUnitY(GetOrderTargetUnit())-GetUnitY(GetOrderedUnit()),GetUnitX(GetOrderTargetUnit())-GetUnitX(GetOrderedUnit()))*bj_RADTODEG)
endif
call IssueImmediateOrder(GetOrderedUnit(),"stop")
endfunction
function GintokiKamehamehaStopOrders2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
call IssueImmediateOrder(u,"stop")
call SetUnitFacing(u,Atan2(LoadReal(h,id,1)-GetUnitY(u),LoadReal(h,id,2)-GetUnitX(u))*bj_RADTODEG)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
set t=null
set u=null
endfunction
function GintokiKamehamehaStopOrders takes nothing returns nothing
local unit u=GetOrderedUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
if GetOrderTargetUnit()==null then
call SaveReal(h,id,2,GetOrderPointX())
call SaveReal(h,id,1,GetOrderPointY())
else
call SaveReal(h,id,2,GetUnitX(GetOrderTargetUnit()))
call SaveReal(h,id,1,GetUnitY(GetOrderTargetUnit()))
endif
//call SetUnitAnimation(u,"Spell Channel One")
call TimerStart(t,0.001,false,function GintokiKamehamehaStopOrders2)
set u=null
set t=null
endfunction
function GintokiKamehamehaCond takes nothing returns boolean
return GetSpellAbilityId()=='A0UZ' and udg_B==true
endfunction
function GintokiKamehamehaCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real a=LoadReal(h,id,11)
local real dist=LoadReal(h,id,2)
local real x=GetUnitX(l__d)+40*Cos(a)
local real y=GetUnitY(l__d)+40*Sin(a)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real dmg=LoadReal(h,id,4)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,12)
if dist>0 and RectContainsUnit(GetWorldBounds(),l__d)and UnitIsAlive(l__d)then
call SetUnitInvulnerable(u,true)
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitXY_1(l__d,x,y, false)
set n=CreateUnit(p,'e0B2',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,40,180,255,50)
set n=CreateUnit(p,'e0B2',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitVertexColor(n,30,200,255,35)
set n=CreateUnit(p,'e0B2',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,2,2,2)
call SetUnitVertexColor(n,20,220,255,20)
set n=CreateUnit(p,'e0C0',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,2)
call SetUnitTimeScale(n,60)
set n=CreateUnit(p,'e0CT',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,2)
call GroupEnumUnitsInRange(g,x,y,150,Base)
set idg=GetHandleId(g)
call SaveReal(h,id,2,dist-40)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
else
call GroupEnumUnitsInRange(g,x,y,450,Base)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
call UnitApplyTimedLife(CreateUnit(p,'e0C4',x,y,(a*bj_RADTODEG)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0C5',x,y,(a*bj_RADTODEG)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0CC',x,y,(a*bj_RADTODEG)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0CD',x,y,(a*bj_RADTODEG)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0C6',x,y,(a*bj_RADTODEG)),1,4)
call UnitApplyTimedLife(CreateUnit(p,'e0C7',x,y,(a*bj_RADTODEG)),1,6)
call ShakeCamera(0.5,20)
call SetUnitTimeScale(u,1)
call StartSound(soundStr[47])
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
call RemoveUnit(l__d)
call FlushChildHashtable(h,GetHandleId(g))
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
function GintokiKamehamehaCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
//local real x1=LoadReal(h,id,5)
//local real y1=LoadReal(h,id,6)
local real a=GetUnitFacing(u)*bj_DEGTORAD
local player p=GetOwningPlayer(u)
local real dmg=LoadReal(h,id,4)
local real dist=LoadReal(h,id,2)
local real scale=LoadReal(h,id,10)
local real time=LoadReal(h,id,13)+0.1
local trigger tt=LoadTriggerHandle(h,id,1)
if time<3 then
call SetUnitInvulnerable(u,true)
call SetControlToUnit(u,u,0.11,"doom")
call SetUnitTimeScale(u,0.1)
set n=CreateUnit(p,'e0B2',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,40,100,255,50)
set n=CreateUnit(p,'e0B2',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitVertexColor(n,40,100,255,50)
set n=CreateUnit(p,'e0B2',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,2,2,2)
call SetUnitVertexColor(n,40,100,255,50)
call SetUnitX(l__d,x+25*Cos(a-deg90))
call SetUnitY(l__d,y+25*Sin(a-deg90))
call SaveReal(h,id,13,time)
call SetUnitAnimation(u,"spell portrait")
else
//call UnitRemoveAbility(u,'A0NP')
call SetUnitTimeScale(u,1)
call RemoveUnit(l__d)
call SaveUnitHandle(h,id,7,CreateUnit(p,'e0C1',x+35*Cos(a),y+35*Sin(a),a*bj_RADTODEG))
set n=CreateUnit(p,'e0R6',x+115*Cos(a),y+115*Sin(a),a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,2)
call SetUnitTimeScale(n,2)
//call StopSound(LoadSoundHandle(h,id,16),true,true)
call PauseUnit(u,true)
call SetUnitX(l__d,x+100*Cos(a))
call SetUnitY(l__d,y+100*Sin(a))
call UnitAddAbility(l__d,'A0SR')
call UnitRemoveAbility(u,'A1FU')
call UnitRemoveAbility(u,'Pet1')
call SetUnitAnimation(u,"spell portrait")
call SetUnitScale(l__d,0.8,0.8,0.8)
call PauseTimer(t)
call TriggerClearActions(tt)
call DestroyTrigger(tt)
call SaveReal(h,id,11,a)
call UnitRemoveAbility(u,'B00A')
call SetUnitAcquireRange(u,600)
call TimerStart(t,0.02,true,function GintokiKamehamehaCast3)
endif
set l__d=null
set p=null
set u=null
set t=null
endfunction
function GintokiKamehamehaCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local trigger tt=CreateTrigger()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
//local real x1=GetSpellTargetX()
//local real y1=GetSpellTargetY()
local real a=GetUnitFacing(u)*bj_DEGTORAD
local real ang=150*bj_DEGTORAD
call SetUnitAcquireRange(u,51)
call SaveUnitHandle(h,id,0,u)
call SaveTriggerHandle(h,id,1,tt)
//call SaveReal(h,id,5,x1)
//call SaveReal(h,id,6,y1)
call SaveReal(h,id,4,(GetUnitAbilityLevel(u,'A0UZ')+5)*GetHeroAgi(u,true))
call SaveReal(h,id,2,3500)
call SaveReal(h,id,10,1.25)
call SaveReal(h,id,13,0)
call SetUnitTimeScale(u,0)
call SetUnitInvulnerable(u,true)
call SaveGroupHandle(h,id,12,CreateGroup())
call SetUnitAnimation(u,"spell portrait")
set soundplay=CreateSound("Sound\\Music\\mp3Music\\GintokiKamehameha.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call SaveUnitHandle(h,id,7,CreateUnit(p,0x65304259,x+30*Cos(a-deg90),y+30*Sin(a-deg90),a*bj_RADTODEG))
call UnitAddAbility(u,'A1FU') //Slow
call UnitAddAbility(u,'Pet1')
call StartAbilityCooldown(GetUnitAbility(u,'A0UZ'),GetAbilityRemainingCooldown(GetUnitAbility(u,'A0UZ')))
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_POINT_ORDER)
//call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_ORDER)
call TriggerAddAction(tt,function GintokiKamehamehaStopOrders)
call TimerStart(t,0.1,true,function GintokiKamehamehaCast2)
set u=null
set p=null
set t=null
endfunction
function Trig_Charge_Conditions takes nothing returns boolean
return GetSpellAbilityId()==0x41303731
endfunction
function Trig_Charge_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local real f=(GetUnitFacing(c)+180)*bj_DEGTORAD
local real dmg=(2+GetUnitAbilityLevel(u,0x41303731))*GetHeroAgi(u,true)
local unit l__dm
call SetUnitX(u,GetUnitX(c)+100*Cos(f))
call SetUnitY(u,GetUnitY(c)+100*Sin(f))
if GetUnitAbilityLevel(u,'B014')>0 then
call myCustomDamage(u,c,dmg*1.15,false,false,null,null,null)
else
call myCustomDamage(u,c,dmg,false,false,null,null,null)
endif
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodySplat Missile.mdx",c,"chest"))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodySplat Missile.mdx",c,"right hand"))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodySplat Missile.mdx",c,"left hand"))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodySplat Missile.mdx",c,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",c,"chest"))
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",c,"right hand"))
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",c,"left hand"))
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",c,"origin"))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",c,"origin"))
call SetControlToUnit(u,c,2, "stun")
set soundplay=CreateSound("Sound\\Music\\mp3Music\\GintokiCharge.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
set c=null
set u=null
set l__dm=null
endfunction
function Trig_Bike_Conditions takes nothing returns boolean
return GetSpellAbilityId()==0x41303732 and udg_B==true
endfunction
function IsUnitBack_Bike takes unit uF,unit uWhichBack returns boolean
local real r1=bj_RADTODEG*Atan2(GetUnitY(uWhichBack)-GetUnitY(uF),GetUnitX(uWhichBack)-GetUnitX(uF))+360
local real r2=GetUnitFacing(uWhichBack)+360
return r1<=(r2+60)and r1>=(r2-60)
endfunction
function Trig_Bike_Actions3 takes nothing returns nothing
local unit e=GetEnumUnit()
local integer l__ide=GetHandleId(e)
local real dist=LoadReal(h,l__ide,1)
local real x=GetUnitX(e)
local real y=GetUnitY(e)
local real a=LoadReal(h,l__ide,0)
if dist<500 then
if IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
call SetUnitX(e,x+30*Cos(a))
call SetUnitY(e,y+30*Sin(a))
else
call SetUnitX(e,x+40*Cos(a/2))
call SetUnitY(e,y+40*Sin(a/2))
endif
call SaveReal(h,l__ide,1,dist+30)
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",x,y))
else
call GroupRemoveUnit(udg_Bike,e)
call RemoveSavedReal(h,l__ide,1)
call RemoveSavedReal(h,l__ide,0)
endif
set e=null
endfunction
function Trig_Bike_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,1)
local unit u=LoadUnitHandle(h,id,0)
