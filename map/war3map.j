        call RemoveUnit(LoadUnitHandle(HH,idu,StringHash("dc")))
        call RemoveSavedReal(HH,idu,StringHash("hpc"))
        call RemoveSavedReal(HH,idu,StringHash("mpc"))
        call RemoveSavedReal(HH,idu,StringHash("xc"))
        call RemoveSavedReal(HH,idu,StringHash("yc"))
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
endif
set u=null
set t=null
