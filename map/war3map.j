function SoruSoundCast takes nothing returns nothing
local integer i=GetRandomInt(1,3)
if i==1 then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Soru.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
elseif i==2 then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Soru2.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
elseif i==3 then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Sonido.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
endfunction
