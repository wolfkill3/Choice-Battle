endfunction
function ShredderCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real dmg=0.66*GetHeroStr(u,true)
local real l__d=GetRandomReal(-30,30)
local group g=LoadGroupHandle(h,id,4)
// if GetUnitAbilityLevel(u,'A28U')>0 and GetUnitState(u,UNIT_STATE_LIFE)<=GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.25 then
        // set dmg=dmg+dmg*.2
// else
if GetUnitAbilityLevel(u,'A28U')>0 then
        set dmg=dmg+dmg*.1
endif
        if GetUnitCurrentOrder(u)==OrderId("channel")then
                //call SetUnitInvulnerable(u, true)
        if IsTerrainPathable(x+30*Cos(a),y+30*Sin(a),PATHING_TYPE_FLYABILITY)==false then
        call SetUnitXY_1(u,x+30*Cos(a),y+30*Sin(a),false)
        call SaveReal(h,id,2,x1+30*Cos(a))
        call SaveReal(h,id,3,y1+30*Sin(a))
        endif
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\EffectE-0"+I2S(GetRandomInt(1,3))+".mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
                call GroupEnumUnitsInRange(g,x+50*Cos(a),y+50*Sin(a),200,Base)
                loop
                set E=FirstOfGroup(g)
                if Condition_Base(p,E)then
                        call myCustomDamage(u,E,dmg,false,false,null,null,null)
                        call DestroyEffect(AddSpecialEffectTarget("Afb (1050).mdx",E,"chest"))
                        call EffectToRandomBone("Minato-37.mdx", E)
            call Push(E,30,a,30)
                        call SetControlToUnit(E,E, 0.4, "stun")
                endif
                call GroupRemoveUnit(g,E)
                exitwhen E==null
                endloop
        else
                call GroupEnumUnitsInRange(g,x1,y1,200,Base)
                loop
                set E=FirstOfGroup(g)
                if Condition_Base(p,E)then
                        call myCustomDamage(u,E,dmg,false,false,null,null,null)
                        call DestroyEffect(AddSpecialEffectTarget("Afb (1050).mdx",E,"chest"))
            call EffectToRandomBone("Minato-37.mdx", E)
            set soundplay=CreateSound("Sound\\Music\\mp3Music\\EffectE v2 -03.mp3",false,false,true,12700,12700,"")
            call StartSound(soundplay)
            call KillSoundWhenDone(soundplay)
                        call SetControlToUnit(E,E, 0.6, "stun")
                endif
                call GroupRemoveUnit(g,E)
                exitwhen E==null
                endloop
        call UnitRemoveAbility(u,'A2CR')
                call SetUnitInvulnerable(u, false)
                call DestroyGroup(g)
                call SetUnitTimeScale(u,1)
                call PauseTimer(t)
                call DestroyTimer(t)
                call FlushChildHashtable(h,id)
        endif
set p=null
set u=null
set t=null
set g=null
endfunction
