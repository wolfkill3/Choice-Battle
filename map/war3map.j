    loop
    exitwhen is>39
        if LoadUnitHandle(h,id,is) != null then
        //call RemoveUnit(LoadUnitHandle(h,id,is))
        call RemoveSavedHandle(h,id,is)
        endif
        set is = is + 1
    endloop
    if GetUnitAbilityLevel(u, 'CB01') > 0 then
        call UnitRemoveAbility(u, 'CE01')
        call UnitRemoveAbility(u, 'CB01')
    endif
    call SetUnitInvulnerable(u,false)
