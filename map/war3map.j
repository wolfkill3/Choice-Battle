function MadaraTSharinganAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real distance=LoadReal(HH,id,8)
local unit dummyUnit=LoadUnitHandle(HH,id,20)
local real time1
local real damage= GetUnitState(caster,UNIT_STATE_MAX_MANA)*0.6
set time=time+0.02
call SaveReal(HH,id,5,time)
if distance==4020 then
call DestroyGroup(LoadGroupHandle(HH,id,4))
call MyRemoveUnit(LoadUnitHandle(HH,id,20),3)
call UnitColor(LoadUnitHandle(HH,id,20),100,100,100,100)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
else
set n0=LoadUnitHandle(HH,id,20)
if time==0.02 then
call EffectCreateAndMove(true,"Madara\\WindCircleFaster.mdl",facing,1.5,2,0.8,100,100,100,0,50,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\wind4.mdl",facing,1,1.5,0.5,60,60,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\[A]RinRfire1.mdl",GetRandomInt(0,360),1.25,2,2,100,100,100,60,0,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\az_siwen.mdl",GetRandomInt(0,360),1.5,3,0.3,100,100,100,30,100,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\blue-blink.mdl",GetRandomInt(0,360),1.5,5,0.3,100,100,100,0,0,caster,0,facing)
call SaveGroupHandle(HH,id,4,CreateGroup())
call SaveBoolean(HH,GetHandleId(caster),StringHash("MadaraSusT2"),true)
set soundplay=CreateSound("war3mapimported\\MadaraT1.mp3",false,false,true,12700,12700,"")
                        call StartSound(soundplay)
                        call KillSoundWhenDone(soundplay)
endif
if time==2 then
call EffectCreateAndMove(true,"Madara\\az_siwen.mdl",GetRandomInt(0,360),1.5,3,0.3,100,100,100,30,100,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\blue-blink.mdl",GetRandomInt(0,360),1.5,5,0.3,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\az_fireringblue.mdl",facing,1,4,0.6,100,100,100,0,150,caster,0,facing)
endif
if time==0.04 then
call SetUnitAnimationByIndex(caster,5)
call UnitSpeed(caster,0.43)
endif
if time<3 then
set time1=LoadReal(HH,id,6)
set time1=time1+0.02
if time1==0.3 or time==0.04 then
set time1=0
call EffectCreateAndMove(true,"Madara\\[A]az_axe_ef1.mdl",GetRandomInt(0,360),1,GetRandomReal(2,2.8),GetRandomReal(0.3,0.6),100,100,100,60,0,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\HakenSaber2.mdl",GetRandomInt(0,360),1,GetRandomReal(1.75,2.2),GetRandomReal(0.5,1),100,100,100,60,0,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\WindNewFaw4.mdl",GetRandomInt(0,360),1,GetRandomReal(1.75,2.2),GetRandomReal(0.5,1),100,100,100,60,100,caster,0,facing)
endif
call SaveReal(HH,id,6,time1)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
endif
if time==3 then
call UnitSpeed(caster,3)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
endif
if time==2.5 then
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(caster),GetUnitY(caster),facing)
call SetUnitModel(n0,"Madara\\File00000528.mdl")
call UnitSize(n0,1,1,1)
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call SaveUnitHandle(HH,id,20,n0)
call SetUnitFlyHeight(n0,300,0)
set n0=null
endif
if time>2.5 then
set time1=LoadReal(HH,id,9)
call SaveReal(HH,id,8,distance+60)
set dummyUnit=LoadUnitHandle(HH,id,20)
call MoveUnit(dummyUnit,dummyUnit,60,facing)
call DamageAoeOneTime3(caster,GetUnitX(dummyUnit),GetUnitY(dummyUnit),200+(time-2.5)*300,damage,LoadGroupHandle(HH,id,4),R2I((3.9-time)*25+10),40,facing)
set time1=time1+0.02
call UnitSize(LoadUnitHandle(HH,id,20),1+(time-2.5)*1.5,1,1)
if time1==0.02 or time==2.52 then
call EffectCreateAndMove(true,"Madara\\File00002270.mdl",facing,1.75-(time-2.5),1.75+(time-2.5)*3.7,0.6,100,100,100,40,-150,LoadUnitHandle(HH,id,20),150,facing)
call EffectCreateAndMove(true,"Madara\\[A]RinRfire2-90.mdl",facing+90,1.75-(time-2.5),1+(time-2.5)*1.25,0.6,100,100,100,40,-200,LoadUnitHandle(HH,id,20),150,facing)
endif
if time1==0.06 or time==2.52 then
set time1=0
call EffectCreateAndMove(true,"Madara\\az_yine(nosmoke).mdl",facing,1.75-(time-2.5),0.6+(time-2.5)*1.15,1,80,80,100,0,-200,LoadUnitHandle(HH,id,20),0,facing)
call EffectCreateAndMove(true,"Madara\\az_goods_force staff(3).mdl",facing,1.75-(time-2.5),2+(time-2.5)*5,0.8,100,100,100,40,-200,LoadUnitHandle(HH,id,20),0,facing)
call EffectCreateAndMove(true,"Madara\\groundshock1.mdl",facing+90,1.75-(time-2.5),1+(time-2.5)*2,2,100,100,100,0,-100,LoadUnitHandle(HH,id,20),150+(time-2.5)*350,facing+90)
call EffectCreateAndMove(true,"Madara\\groundshock1.mdl",facing-90,1.75-(time-2.5),1+(time-2.5)*2,2,100,100,100,0,-100,LoadUnitHandle(HH,id,20),150+(time-2.5)*350,facing-90)
endif
call SaveReal(HH,id,9,time1)
set dummyUnit=null
endif
set n0=null
endif
set dummyUnit=null
set caster=null
set t=null
endfunction

