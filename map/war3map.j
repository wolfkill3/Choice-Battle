exitwhen E==null
endloop
call UnitApplyTimedLife(CreateUnit(p,0x65304657,x1,y1,a*bj_RADTODEG),'BTLF',1)
else
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,GetHandleId(g))
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
call RemoveUnit(l__d)
call RemoveUnit(d1)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
set d1=null
endfunction
