function Sema3Cast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
call SaveUnitHandle(h,id,0,u)
if SR(x,y,x1,y1)<600 then
set x=x1-600*Cos(a)
set y=y1-600*Sin(a)
endif
set n=CreateUnit(p,'e0PP',x1,y1,a*bj_RADTODEG)
call SetUnitAnimation(n,"Spell")
call SetUnitScale(n,2,2,2)
call SetUnitFlyHeight(n,2000,0)
call SetUnitTimeScale(n,0.1)
call SaveUnitHandle(h,id,1,n)
call SaveReal(h,id,2,0)
call SaveReal(h,id,3,a)
call SaveReal(h,id,4,x1)
call SaveReal(h,id,5,y1)
call SaveReal(h,id,6,0)
call SaveReal(h,id,7,0)
call SaveReal(h,id,8,SR(x,y,x1,y1))
set n=CreateUnit(p,'e0RV',x1,y1,a*bj_RADTODEG)
call SaveUnitHandle(h,id,2,n)
call SetUnitScale(n,3,3,3)
call SetUnitVertexColor(n,255,255,255,255)
call SetUnitTimeScale(n,0.3)
set n=CreateUnit(p,'e100',x1,y1,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,255)
call SetUnitTimeScale(n,1)
call SetUnitFlyHeight(n,1000,0)
call SetTerrainFogExBJ(0,0.00,9000,0,0.3,0.3,0.7)
call UnitApplyTimedLife(n,0,3)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Sema.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.05,true,function Sema3Cast2)
set u=null
set p=null
set t=null
endfunction
