function AizenGCheckGroup takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit Dummy=LoadUnitHandle(HH,id,21)
local group gr=LoadGroupHandle(HH,id,4)
if SR(GetUnitX(GetEnumUnit()),GetUnitY(GetEnumUnit()),GetUnitX(Dummy),GetUnitY(Dummy))>400 or LoadReal(HH,id,5)==11 then
call GroupRemoveUnit(gr,GetEnumUnit())
call SaveGroupHandle(HH,id,4,gr)
call UnitRemoveAbility(GetEnumUnit(),'ASG2')
call UnitRemoveAbility(GetEnumUnit(),'BASG')
endif
set gr=null
set Dummy=null
endfunction

function AizenGAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit casterOriginal=LoadUnitHandle(HH,id,30)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real distance=LoadReal(HH,id,8)
local real x1=LoadReal(HH,id,11)
local real y1=LoadReal(HH,id,12)
local real damage=LoadReal(HH,id,15)
local group gr=LoadGroupHandle(HH,id,4)
set time=time+0.02
call SaveReal(HH,id,5,time)

if time==6.4+LoadReal(HH,id,14) or LoadInteger(HH,GetHandleId(aizen),SH_AizenGI)<=0 or udg_B==false then
if LoadEffectHandle(HH,id,24)!=null then
call DestroyEffect(LoadEffectHandle(HH,id,24))
call SaveEffectHandle(HH,id,24,null)
endif
call SaveReal(HH,id,5,11)
call ForGroup(gr,function AizenGCheckGroup)
call SetUnitAnimationByIndex(LoadUnitHandle(HH,id,20),2)
call MyRemoveUnit(LoadUnitHandle(HH,id,20),2)
call RemoveUnit(LoadUnitHandle(HH,id,21))
call RemoveUnit(LoadUnitHandle(HH,id,22))
if LoadGroupHandle(HH,id,4)!=null then
call DestroyGroup(LoadGroupHandle(HH,id,4))
call SaveGroupHandle(HH,id,4,null)
endif
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else


if time==0.02 then
call SaveGroupHandle(HH,id,4,CreateGroup())
call SaveEffectHandle(HH,id,24,AddSpecialEffectTarget("Aizen\\GlowCharge.mdl",caster,"hand left"))
set n0=CreateUnit(GetOwningPlayer(caster),'e200',x1,y1,facing)
call SetUnitModel(n0,"Aizen\\aizen-4.mdl")
call MoveUnit(n0,n0,400,facing)
call SetUnitAnimationByIndex(n0,0)
call UnitSize(n0,1.5,1,1)
call UnitSpeed(n0,1)
call UnitColor(n0,100,100,100,0)
call SetUnitFlyHeight(n0,100,0)
call SaveUnitHandle(HH,id,20,n0)

call EffectCreateAndMove(true,"BlackGoku\\dustwaveanimate2.mdl",GetRandomReal(0,360),1.5,1.5,1,100,100,100,60,0,caster,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\dustwaveanimate2.mdl",GetRandomReal(0,360),1.5,2,1.25,100,100,100,60,0,caster,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\dustwaveanimate2.mdl",GetRandomReal(0,360),1.5,2.5,1.5,100,100,100,60,0,caster,0,facing)
call EffectCreateAndMove(true,"Others\\HakkeStart2.mdl",facing,1.5,1,1,100,100,100,60,0,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\ShockWaveBlack.mdl",facing,1.5,0.5,0.5,100,100,100,60,0,caster,0,facing)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',x1,y1,facing)
call SetUnitModel(n0,"Others\\HakkeStart2.mdl")
call MoveUnit(n0,n0,400,facing)
call UnitSize(n0,2,1,1)
call UnitSpeed(n0,1.75)
call UnitColor(n0,100,100,100,40)
call SetUnitFlyHeight(n0,0,0)
call SaveUnitHandle(HH,id,22,n0)
call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",GetRandomReal(0,360),1.5,1.5,1.25,100,100,100,0,0,n0,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\wind3.mdl",GetRandomReal(0,360),1.5,2.5,1.25,100,100,100,0,0,n0,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",GetRandomReal(0,360),1.5,1,1.25,100,100,100,0,0,n0,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\wind3.mdl",GetRandomReal(0,360),1.5,1.5,1.25,100,100,100,0,0,n0,0,facing)
set n0=null
call UnitSpeed(caster,1)
if GetUnitTypeId(caster)=='H12M' then
call SetUnitAnimationByIndex(caster,17)
else
call SetUnitAnimationByIndex(caster,9)
endif
endif
if time==0.4 then
set n0=CreateUnit(GetOwningPlayer(caster),'e200',x1,y1,facing)
call SetUnitModel(n0,"Aizen\\aizen-73.mdl")
call UnitSize(n0,0.4,1,1)
call UnitSpeed(n0,1)
call UnitColor(n0,100,100,100,0)
call SetUnitFlyHeight(n0,0,0)
call SaveUnitHandle(HH,id,21,n0)
set n0=null
call UnitSpeed(LoadUnitHandle(HH,id,22),0)
endif
if time>0.4 then
call GroupClear(G)
set x1=PolX(GetUnitX(LoadUnitHandle(HH,id,20)),0,facing)
set y1=PolY(GetUnitY(LoadUnitHandle(HH,id,20)),0,facing)
call GroupEnumUnitsInRange(G,x1,y1,300,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
set facing=Angle2(x1,y1,GetUnitX(n0),GetUnitY(n0))
if SR(x1,y1,GetUnitX(n0),GetUnitY(n0))<200 then
if SR(x1,y1,GetUnitX(n0),GetUnitY(n0))>100 then
call MoveUnit(n0,n0,60,facing)
endif
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
set facing=LoadReal(HH,id,3)
set x1=PolX(GetUnitX(LoadUnitHandle(HH,id,20)),200,facing+90)
set y1=PolY(GetUnitY(LoadUnitHandle(HH,id,20)),200,facing+90)
call GroupClear(G)
call GroupEnumUnitsInRange(G,x1,y1,300,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
set facing=Angle2(x1,y1,GetUnitX(n0),GetUnitY(n0))
if SR(x1,y1,GetUnitX(n0),GetUnitY(n0))<200 then
if SR(x1,y1,GetUnitX(n0),GetUnitY(n0))>100 then
call MoveUnit(n0,n0,60,facing)
endif
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
set facing=LoadReal(HH,id,3)
set x1=PolX(GetUnitX(LoadUnitHandle(HH,id,20)),200,facing-90)
set y1=PolY(GetUnitY(LoadUnitHandle(HH,id,20)),200,facing-90)
call GroupClear(G)
call GroupEnumUnitsInRange(G,x1,y1,300,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
set facing=Angle2(x1,y1,GetUnitX(n0),GetUnitY(n0))
if SR(x1,y1,GetUnitX(n0),GetUnitY(n0))<200 then
if SR(x1,y1,GetUnitX(n0),GetUnitY(n0))>100 then
call MoveUnit(n0,n0,60,facing)
endif
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
endif
if time>0.4 then
call GroupClear(G)
call GroupEnumUnitsInRange(G,GetUnitX(LoadUnitHandle(HH,id,21)),GetUnitY(LoadUnitHandle(HH,id,21)),400,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if IsUnitInGroup(n0,gr)==false and GetUnitAbilityLevel(n0,'Avul')==0 and IsUnitAlly(n0,GetOwningPlayer(caster))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false then
call GroupAddUnit(gr,n0)
call UnitAddAbility(n0,'ASG2')
endif
call GroupRemoveUnit(G,n0)
endloop
call ForGroup(gr,function AizenGCheckGroup)
call SaveGroupHandle(HH,id,4,gr)
call GroupClear(G)
endif
if time==1 then
call SetUnitAnimationByIndex(LoadUnitHandle(HH,id,20),1)
endif












endif
set caster=null
set casterOriginal=null
set gr=null
endfunction
