                        call PauseTimer(t)
                        call DestroyTimer(t)
                        call FlushChildHashtable(HH,id)
                endif
        endif
        set t=null
        set c=null
        set u=null
endfunction
function RobLucciTMove takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(HH,id,1)
        local unit c=LoadUnitHandle(HH,id,2)
        local real time=LoadReal(HH,id,5)
        local player p=GetOwningPlayer(u)
        local integer cjlocgn_00000000
        local group cjlocgn_00000001
        set time=time+0.02
        call SaveReal(HH,id,5,time)
        if LoadBoolean(HH,id,11)==true then
                if time==0.02 then
                        call UnitSpeed(u,1)
                        call SetUnitAnimationByIndex(u,5)
                        set soundplay=SndN(3511) // Sound\Music\mp3Music\SaidairinRokougan.mp3
                        call StartSound(soundplay)
                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                        call UnitSpeed(c,1)
                        call SetUnitAnimation(c,"stand")
                        call EffectCreateAndMove1(false,"war3mapImported\\HakenSaber2.mdl",LoadReal(HH,id,3),1,0.5,0.8,100,100,100,20,0,0,u,0,LoadReal(HH,id,3))
                        call EffectCreateAndMove1(false,"war3mapImported\\BlackBlink1.mdl",LoadReal(HH,id,3),0.5,1,1,100,100,100,20,0,0,u,0,LoadReal(HH,id,3))
                        call MoveUnit(c,u,-120,LoadReal(HH,id,3))
                        call EffectCreateAndMove1(false,"war3mapImported\\HakenSaber2.mdl",LoadReal(HH,id,3),1,0.5,0.8,100,100,100,20,0,0,u,0,LoadReal(HH,id,3))
                endif
                if time==0.2 or time==0.8 or time==1.2 or time==1.8 then
                        call EffectCreateAndMove1(false,"war3mapImported\\[A]az_axe_ef1.mdl",GetRandomReal(0,360),1,GetRandomReal(0.75,1.25),GetRandomReal(0.4,0.6),100,100,100,GetRandomInt(30,40),50,0,c,0,LoadReal(HH,id,3))
                        call EffectCreateAndMove1(false,"war3mapImported\\HakenSaber2.mdl",GetRandomReal(0,360),1,GetRandomReal(0.75,1.25),GetRandomReal(0.4,0.6),100,100,100,GetRandomInt(30,40),50,0,c,0,LoadReal(HH,id,3))
                endif
                if time==1 then
                        call EffectCreateAndMove1(false,"war3mapImported\\ChargeWhite.mdl",LoadReal(HH,id,3)+180,2,1.25,0.6,100,100,100,20,100,0,c,150,LoadReal(HH,id,3))
                endif
                if time==1.2 then
                        set soundplay=SndN(3514) // Sound\Music\mp3Music\SaidairinRokougan01.mp3
                        call StartSound(soundplay)
                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                endif
                if time<2 then
                        call SaveReal(HH,id,3,Angle2(GetUnitX(u),GetUnitY(u),GetUnitX(c),GetUnitY(c)))
                        call SetUnitFacing(u,LoadReal(HH,id,3))
                        call MoveUnit(c,u,-120,LoadReal(HH,id,3))
                        call SetUnitPathing(u,false)
                        call PauseUnit(u,true)
                        call SetUnitInvulnerable(u,true)
                        call SetUnitPathing(c,false)
                        call SetUnitFacing(c,LoadReal(HH,id,3)+180)
                        call PauseUnit(c,true)
                        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
                        //call SetUnitInvulnerable(c,true)
                endif
                if time==2 then
                        set soundplay=SndN(3517) // Sound\Music\mp3Music\SaidairinRokougan02.mp3
                        call StartSound(soundplay)
                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                        set soundplay=SndN(3520) // Sound\Music\mp3Music\SaidairinRokougan2.mp3
                        call StartSound(soundplay)
                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                        call SetUnitAnimation(c,"death")
                        call UnitSpeed(u,1)
                        call UnitSpeed(c,1)
                        call SetUnitPathing(u,true)
                        call PauseUnit(u,false)
                        call PauseUnit(c,false)
                        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
                        call SetUnitInvulnerable(u,false)
                        call SetUnitInvulnerable(c,false)
                        call ShakeCamera(0.2, 15)
                        call myCustomDamage(u,c,12*GetHeroAgi(u,true),false,false,null,null,null)
                        call SetControlToUnit(c,c,1.0,"stun")
                        call SaveUnitHandle(HH,id,20,CreateUnit(GetOwningPlayer(u),'e200',GetUnitX(c),GetUnitY(c),LoadReal(HH,id,3)))
                        call MoveUnit(LoadUnitHandle(HH,id,20),LoadUnitHandle(HH,id,20),100,LoadReal(HH,id,3))
                        call EffectCreateAndMove1(false,"war3mapImported\\DustWindFaster3.mdl",LoadReal(HH,id,3)+180,1,1.35,1.25,100,100,100,50,150,0,c,0,LoadReal(HH,id,3))
                        call EffectCreateAndMove1(false,"war3mapImported\\EffecthPush.mdl",LoadReal(HH,id,3),1,1,0.5,100,100,100,60,50,0,c,-50,LoadReal(HH,id,3))
                        call EffectCreateAndMove1(false,"war3mapImported\\BY_Wood_GongChengSiPai_1.mdx",LoadReal(HH,id,3)+180,1.5,2.5,0.5,100,100,100,50,150,0,c,0,LoadReal(HH,id,3))
                        call EffectCreateAndMove1(false,"war3mapImported\\BY_Wood_GongChengSiPai_1.mdx",LoadReal(HH,id,3),1.5,3,0.5,100,100,100,50,150,0,c,0,LoadReal(HH,id,3))
                        call EffectCreateAndMove1(false,"war3mapImported\\CF2.mdl",LoadReal(HH,id,3)+180,1,0.8,0.4,100,100,100,50,150,0,c,0,LoadReal(HH,id,3))
                        call EffectCreateAndMove21(false,"war3mapImported\\wind3.mdl",LoadReal(HH,id,3),1,1.75,1,100,100,100,50,150,c,0,LoadReal(HH,id,3))
                        call EffectCreateAndMove21(false,"war3mapImported\\BY_Wood_GongChengSiPai_2.mdl",LoadReal(HH,id,3),1,3,0.5,100,100,100,60,150,c,0,LoadReal(HH,id,3))
                        call EffectCreateAndMove21(false,"war3mapImported\\az_pafeathermoon_b.mdl",LoadReal(HH,id,3),1,2.5,0.5,100,100,100,0,100,c,0,LoadReal(HH,id,3))
                        set EFF=AddSpecialEffectTarget("war3mapImported\\File00000820.mdl",LoadUnitHandle(HH,id,20),"origin")
                        call SaveEffectHandle(HH,id,23,EFF)
                        call UnitColor(LoadUnitHandle(HH,id,20),100,100,100,50)
                        call UnitSize(LoadUnitHandle(HH,id,20),3,1,1)
                        call UnitAddAbility(LoadUnitHandle(HH,id,20),'Amrf')
                        call UnitRemoveAbility(LoadUnitHandle(HH,id,20),'Amrf')
                        call SetUnitFlyHeight(LoadUnitHandle(HH,id,20),150,0)
                endif
                if time>2 and time<=3.6 then
                        if time<2.1 then
                                call MoveUnit(c,c,10,LoadReal(HH,id,3))
                        endif
                        call MoveUnit(LoadUnitHandle(HH,id,20),LoadUnitHandle(HH,id,20),60,LoadReal(HH,id,3))
                        call MoveEffect(LoadUnitHandle(HH,id,20),LoadEffectHandle(HH,id,23),25,LoadReal(HH,id,3))
                        set cjlocgn_00000000=LoadInteger(HH,id,6)
                        set cjlocgn_00000000=cjlocgn_00000000+1
                        if cjlocgn_00000000==2 or cjlocgn_00000000==4 or cjlocgn_00000000==6 then
                                call EffectCreateAndMove21(false,"war3mapImported\\WhiteGlow.mdl",LoadReal(HH,id,3),1-(time-2)*0.01,GetRandomReal(0.2,0.35),1,100,100,100,GetRandomInt(60,80),150,LoadUnitHandle(HH,id,20),50,LoadReal(HH,id,3))
                                //set n=CreateUnit(GetOwningPlayer(u), 'e201', GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),LoadReal(HH,id,3)*bj_RADTODEG)
                                //call SetUnitFlyHeight(n, 50, 0)
                                //call SetUnitScale(n, 0.5, 0.5, 0.5)
                                //call MyRemoveUnit(n, 1.5)
                        endif
                        if cjlocgn_00000000==6 then
                                call EffectCreateAndMove21(false,"war3mapImported\\wind3.mdl",LoadReal(HH,id,3),1-(time-2)*0.01,GetRandomReal(0.75,1),GetRandomReal(1.4,1.75),100,100,100,GetRandomInt(20,40),150,LoadUnitHandle(HH,id,20),100,LoadReal(HH,id,3))
                                set cjlocgn_00000000=0
                        endif
                        call SaveInteger(HH,id,6,cjlocgn_00000000)
                        set cjlocgn_00000001=LoadGroupHandle(HH,id,4)
                        if time>2.1 then
                                call GroupEnumUnitsInRange(cjlocgn_00000001,GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),200,Base)
                        else
                                call GroupEnumUnitsInRange(cjlocgn_00000001,GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),300,Base)
                        endif
                        set idg=GetHandleId(cjlocgn_00000001)
                        loop
                                set E=FirstOfGroup(cjlocgn_00000001)
                                set ide=GetHandleId(E)
                                if E!=c and Condition_Base(p,E)and E!=LoadUnitHandle(HH,idg,ide)then
                                        call myCustomDamage(u,E,10*GetHeroAgi(u,true),false,false,null,null,null)
                                        call SetControlToUnit(E,E,0.5,"stun")
                                        call UnitStop(E)
                                        call LucciTPush(E,LoadUnitHandle(HH,id,20),time,LoadReal(HH,id,3))
                                        call SaveUnitHandle(HH,idg,ide,E)
                                endif
                                call GroupRemoveUnit(cjlocgn_00000001,E)
                        exitwhen E==null
                        endloop
                        set cjlocgn_00000001=null
                endif
                if time==3.6 then
                        if LoadEffectHandle(HH,id,23)!=null then
                        call DestroyEffect(LoadEffectHandle(HH,id,23))
                        call SaveEffectHandle(HH,id,23,null)
                        endif
                endif
                if time==4.1 then
                        call RemoveUnit(LoadUnitHandle(HH,id,20))
                        set cjlocgn_00000001=LoadGroupHandle(HH,id,4)
                        call FlushChildHashtable(HH,id)
                        call FlushChildHashtable(HH,GetHandleId(cjlocgn_00000001))
                        call PauseTimer(t)
                        call DestroyTimer(t)
                        call DestroyGroup(cjlocgn_00000001)
                        set cjlocgn_00000001=null
                endif
        else
                if time==0.02 then
                        call UnitSpeed(u,1)
