call SetControlToUnit(E,E, 2, "stun")
endif
call SaveUnitHandle(h,l__idg,ide,E)
endif
call GroupRemoveUnit(G,E)
endloop
else
call SetUnitTimeScale(u,1)
call PauseTimer(t)
if IsUnitEnemy(c,p)then
call myCustomDamage(u,c,dmg*0.75,false,false,null,null,null)
endif
if c==u then
endif
call DestroyGroup(g)
call UnitRemoveAbility(c,0x41314148)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call KillUnit(l__d)
call RemoveSavedHandle(h,GetHandleId(u),StringHash("par"))
