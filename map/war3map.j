call SaveInteger(h,id,3,i+1)
else
call PauseTimer(t)
call DestroyTimer(t)
call DestroyEffect(LoadEffectHandle(h,id,0))
call FlushChildHashtable(h,id)
endif
set u=null
set t=null
endfunction
function HealCast takes unit u,real heal,integer time returns nothing
