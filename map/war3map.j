return GetSpellAbilityId()=='Ao8W'
endfunction
function RKazumaCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit c=LoadUnitHandle(HH,id,1)
local unit l__d=LoadUnitHandle(HH,GetHandleId(u),SH_dark)
