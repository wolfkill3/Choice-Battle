function RecallNarutoCond takes nothing returns boolean
return GetSpellAbilityId()=='A0X6' and udg_B==true and DU==true
endfunction
function RecallNarutoCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local integer id=GetHandleId(u)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)+GetRandomReal(-200,200)
local real y=GetUnitY(u)+GetRandomReal(-200,200)
local integer re=LoadInteger(HH,id,SH_recall)
if re>0 and IsAbilityOnCooldown(GetUnitAbility(u,'A0VE'))==true then //IsAbilityOnCooldown
call SetAbilityRemainingCooldown(GetUnitAbility(u,'A0VE'),0.01)
call SaveInteger(HH,id,SH_recall,re-1)
set n=CreateUnit(p,'e0S9',x,y,0)
call UnitApplyTimedLife(n,'BTLF',0.25)
call SetUnitTimeScale(n,2)
call SetUnitVertexColor(n,255,255,255,255)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,0.65,0.65,0.65)
call SetUnitVertexColor(n,150,200,255,200)
set n=CreateUnit(p,'e0RR',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitVertexColor(n,255,255,255,50)
call DisplayTextToPlayer(GetOwningPlayer(u),0,0,Lng("Осталось "+I2S(re-1)+"зарядов.",I2S(re-1)+" charges left."))
endif
set soundplay=SndN(2092) // Sound\Music\mp3Music\NarutoG.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set u=null
endfunction
