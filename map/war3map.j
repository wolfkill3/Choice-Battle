function JokerHealing takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local integer ty=LoadInteger(HH,id,1)
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(p)
local real hel=0
if GetUnitTypeId(Hero[ip])==ty and u==Hero[ip] then
set hel=(GetUnitState(u,UNIT_STATE_MAX_LIFE)-GetUnitState(u,UNIT_STATE_LIFE))*0.015
if doffyh[ip]>20 and GetUnitState(u,UNIT_STATE_MAX_LIFE)!=GetWidgetLife(u)and hel>1 and GetHeroLevel(u)>=6 then
call HealTextTag(u,u,hel*myCustomHeal2(u,1),"HealthRes")
call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+hel)
else
set doffyh[ip]=doffyh[ip]+0.5
endif
else
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set p=null
set t=null
set u=null
endfunction
function Trig_LearnParasite_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local integer lvl=GetUnitAbilityLevel(u,'A1AJ')
local timer t=CreateTimer()
local integer id=GetHandleId(t)
if lvl==1 then
call UnitAddAbility(u,'A1AK')
call UnitMakeAbilityPermanent(u,true,'A1AK')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1AK',true)
call UnitAddAbility(u,'A1AL')
call UnitMakeAbilityPermanent(u,false,'A1AL')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1AL',false)
set doffyh[GetPlayerId(GetOwningPlayer(u))]=0
call SaveUnitHandle(HH,id,0,u)
call SaveInteger(HH,id,1,GetUnitTypeId(u))
call TimerStart(t,0.5,true,function JokerHealing)
else
call DestroyTimer(t)
call SetUnitAbilityLevel(u,'A1AK',lvl)
call SetUnitAbilityLevel(u,'A1AL',lvl)
endif
set t=null
set u=null
endfunction
function InitTrig_LearnParasite takes nothing returns nothing
set gg_trg_LearnParasite=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_LearnParasite,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(gg_trg_LearnParasite,Condition(function Trig_LearnParasite_Conditions))
call TriggerAddAction(gg_trg_LearnParasite,function Trig_LearnParasite_Actions)
endfunction
function TorikagoCond takes nothing returns boolean
return GetSpellAbilityId()==0x41314150
endfunction
function TorikagoCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=0
local real y1=0
local real a=0
local real dmg=GetHeroInt(u,true)*0.15
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,3)
local group g2
local real time=LoadReal(h,id,4)
local real dtime=LoadReal(h,id,5)
local real coef=1-time/5.2
// урон о стенку клетки — раз в 5 тиков (0.1 с) x5: тот же урон, обработчик урона в 5 раз реже (раньше 50 раз в секунду на цель)
local boolean hit=ModuloInteger(R2I(time/0.02+0.5),5)==0
if time>=0.3 and time<0.32 then
call PauseUnit(u,false)
endif
if time<4.8 then
// копия списка целей — в одну группу на всю способность (раньше каждый тик новая группа + таймер на её удаление)
set g2=LoadGroupHandle(h,id,6)
call GroupAddGroupEx(g2,g)
loop
    set E=FirstOfGroup(g2)
    set x1=GetUnitX(E)
    set y1=GetUnitY(E)
    exitwhen E==null
    if SR(x,y,x1,y1)>(2000-dtime)*coef and SR(x,y,x1,y1)<200+(2000-dtime)*coef then
    set a=Atan2(y1-y,x1-x)
    call SetUnitX(E,x+(1975-dtime)*coef*Cos(a))
    call SetUnitY(E,y+(1975-dtime)*coef*Sin(a))
    if hit then
    call myCustomDamage(u,E,dmg*5.,false,false,null,null,null)
    endif
    // call BenchmarkStart()
    call SaveBoolean(HH,GetHandleId(E),DoflaTHash,true)
    // call BenchmarkEnd()
    // call BJDebugMsg(BenchmarkGetElapsed(2))
    // call BenchmarkReset()
    endif
    if SR(x,y,x1,y1)>200+(2000-dtime)*coef and SR(x,y,x1,y1)<800+(2000-dtime)*coef then
        if IsUnitInvulnerable(E)==true then
            call SetUnitInvulnerable(E,false)
            call UnitAddAbility(E, 'A0WR')
            call RemoveEffect(AddSpecialEffectTarget("1232.mdl", E, "chest"), 1.5, true, CreateTimer())
            call DamageIndicatorFunction(u,E,GetUnitState(E,UNIT_STATE_MAX_LIFE)*0.25)
            call myCustomDamage(u,E,GetUnitState(E,UNIT_STATE_MAX_LIFE)*0.25,false,false,null,DAMAGE_TYPE_UNIVERSAL,null)
            call SaveBoolean(HH,GetHandleId(E),DoflaTHash,false)
            call UnitRemoveAbility(E, 'A0WR')
            call GroupRemoveUnit(g,E)
            call SetUnitInvulnerable(E,true)
        else
            call UnitAddAbility(E, 'A0WR')
            call RemoveEffect(AddSpecialEffectTarget("1232.mdl", E, "chest"), 1.5, true, CreateTimer())
            call DamageIndicatorFunction(u,E,GetUnitState(E,UNIT_STATE_MAX_LIFE)*0.25)
            call myCustomDamage(u,E,GetUnitState(E,UNIT_STATE_MAX_LIFE)*0.25,false,false,null,DAMAGE_TYPE_UNIVERSAL,null)
            call SaveBoolean(HH,GetHandleId(E),DoflaTHash,false)
            call UnitRemoveAbility(E, 'A0WR')
            call GroupRemoveUnit(g,E)
        endif
    endif
    if GetUnitAbilityLevel(E,'IMDc')>0 or SR(x,y,x1,y1)>800+(2000-dtime)*coef then
    call SaveBoolean(HH,GetHandleId(E),DoflaTHash,false)
    call GroupRemoveUnit(g,E)
    endif
    call GroupRemoveUnit(g2,E)
endloop
call SaveReal(h,id,4,time+0.02)
call SaveReal(h,id,5,dtime+5)
else
loop
set E=FirstOfGroup(g)
exitwhen E==null
call SaveBoolean(HH,GetHandleId(E),DoflaTHash,false)
call GroupRemoveUnit(g,E)
endloop
call RemoveUnit(l__d)
call GroupClear(g)
call DestroyGroup(g)
call DestroyGroup(LoadGroupHandle(h,id,6))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set g=null
set g2=null
set u=null
set p=null
set t=null
endfunction
function TorikagoCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local group g=CreateGroup()
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,3,g)
call SaveGroupHandle(h,id,6,CreateGroup())
call PauseUnit(u,true)
call SetUnitAnimation(u,"Spell One")
call SaveReal(h,id,4,0)
call SaveReal(h,id,5,0)
set n=CreateUnit(p,'e10L',x,y,0)
call SaveUnitHandle(h,id,1,n)
call SetUnitAnimation(n,"death")
call GroupEnumUnitsInRange(G,x,y,2000,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call GroupAddUnit(g,E)
endif
call GroupRemoveUnit(G,E)
endloop
set soundplay=SndN(2568) // Sound\Music\mp3Music\Doflamingo5.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set soundplay=SndN(2570) // Sound\Music\mp3Music\DoflamingoT.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.02,true,function TorikagoCast2)
set g=null
set p=null
set u=null
set t=null
endfunction
