            call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(c),0x65305442,x,y,(a*bj_RADTODEG)),1,3)
            call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(c),0x65305441,x,y,(a*bj_RADTODEG)),1,3)
