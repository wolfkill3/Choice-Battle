call UnitApplyTimedLife(CreateUnit(p,'e03I',x,y,0),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e03K',x,y,0),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e04B',x,y,0),1,3)
