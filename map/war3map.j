endfunction
function HardLine takes unit l__A returns real
local real AC
local real AM
local real AD
local real KB
local real Kx
local real Ky
local real DO
local real BO
local real x=GetUnitX(l__A)
local real y=GetUnitY(l__A)
local real x1=GetRectMaxX(gg_rct_GameZone)
local real x2=GetRectMinX(gg_rct_GameZone)
local real y1=GetRectMaxY(gg_rct_GameZone)
local real y2=GetRectMinY(gg_rct_GameZone)
local real a=Atan2(-y,-x)
if y>y1 then
set BO=y1
set DO=y
set AM=DO-BO
set AD=SR1(x,y,y,0)
set Kx=BO*Cos(a)
set Ky=BO*Sin(a)
set KB=SR1(Kx,Ky,y1,0)
elseif x>x1 then
set BO=x1
set DO=x
set AM=DO-BO
set AD=SR1(x,y,0,x)
set Kx=BO*Cos(a)
set Ky=BO*Sin(a)
set KB=SR1(Kx,Ky,0,x1)
elseif y<y2 then
set BO=y2
set DO=y
set AM=DO-BO
set AD=SR1(x,y,y2,0)
set Kx=BO*Cos(a)
set Ky=BO*Sin(a)
set KB=SR1(Kx,Ky,y2,0)
elseif x<x2 then
set BO=x2
set DO=x
set AM=DO-BO
set AD=SR1(x,y,0,x2)
set Kx=BO*Cos(a)
set Ky=BO*Sin(a)
set KB=SR1(Kx,Ky,0,x2)
endif
set AC=SquareRoot(AM*AM+AD-SquareRoot((KB*DO/BO)*(KB*DO/BO)-AM*AM))
return AC
endfunction
function Trig_LeaveArea1_Actions takes nothing returns nothing
local real x=GetUnitX(GetTriggerUnit())
local real y=GetUnitY(GetTriggerUnit())
local real a=Atan2(-y,-x)
call SetUnitXY_1(GetTriggerUnit(),x+(150+HardLine(GetTriggerUnit()))*Cos(a),y+(150+HardLine(GetTriggerUnit()))*Sin(a),false)
endfunction
