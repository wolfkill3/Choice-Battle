set g2=CopyGroup(g)
set r=0
loop
set E=FirstOfGroup(g2)
exitwhen E==null and IsUnitType(E,UNIT_TYPE_DEAD)==false
if r==i then
set n10=E
endif
set r=r+1
call GroupRemoveUnit(g2,E)
endloop
call DestroyGroupTimed(g2,3)
set g2=null
return n10
endfunction
function GetAngle takes real x,real y,real x1,real y1,real a,real fa,real fd returns real
local real X1=x1+fd*Cos(a+90*bj_DEGTORAD)
local real Y1=y1+fd*Sin(a+90*bj_DEGTORAD)
local real X2=x1+fd*Cos(a-90*bj_DEGTORAD)
local real Y2=y1+fd*Sin(a-90*bj_DEGTORAD)
local real dist1=SR(x,y,X1,Y1)
local real dist2=SR(x,y,X2,Y2)
local real r
if dist1-dist2>fa or dist1-dist2<-1*fa then
if dist1>dist2 then
set r=Atan2(Y2-y,X2-x)
else
set r=Atan2(Y1-y,X1-x)
endif
else
set r=a-180*bj_DEGTORAD
endif
return r
endfunction
