function GuraGuraCond takes nothing returns boolean
return((GetSpellAbilityId()=='A18V' or GetSpellAbilityId()=='A18T' or GetSpellAbilityId()=='A18S')or GetSpellAbilityId()=='A18Y' or GetSpellAbilityId()=='A18X')and GetHeroLevel(GetTriggerUnit())>5
endfunction
function GuraGuraCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real dist=0
local integer i=0
local player p=GetOwningPlayer(u)
call GroupEnumUnitsInRange(G,x,y,1500,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
if GetWidgetLife(E)>GetUnitState(E,UNIT_STATE_MAX_LIFE)*0.04 then
call myCustomDamage(u,E,GetUnitState(E,UNIT_STATE_MAX_LIFE)*0.04,false,false,null,null,null)
else
call SetUnitState(E,UNIT_STATE_LIFE,1)
endif
call SetControlToUnit(E,E, 0.5, "stun")
endif
call GroupRemoveUnit(G,E)
endloop
set p=null
set u=null
endfunction
function InitTrig_GuraGura takes nothing returns nothing
set gg_trg_GuraGura=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_GuraGura,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_GuraGura,Condition(function GuraGuraCond))
call TriggerAddAction(gg_trg_GuraGura,function GuraGuraCast)
endfunction
function KabutowariCond takes nothing returns boolean
return GetSpellAbilityId()=='A18V' and udg_B==true
endfunction
function KabutowariCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local real x2=GetUnitX(c)
local real y2=GetUnitY(c)
local real f=GetUnitFacing(u)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroStr(u,true)*(GetUnitAbilityLevel(u,'A18V')+2)
local real dist=SR(x,y,x2,y2)
local real time=LoadReal(h,id,5)
local real a=Atan2(y2-y,x2-x)
local real he=0
if time<2.5 then
    call PauseUnit(u,true)
    call SetUnitInvulnerable(u,true)
    call PauseUnit(c,true)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
    call SetUnitInvulnerable(c,true)
    call SaveReal(h,id,5,time+0.25)
    set n=CreateUnit(p,'e0Y9',x,y,GetRandomReal(0,359))
    call UnitApplyTimedLife(n,'BTLF',3)
    call SetUnitScale(n,time,time,time)
    set n=CreateUnit(p,'e0YA',x,y,GetRandomReal(0,359))
    call UnitApplyTimedLife(n,'BTLF',3)
    call SetUnitTimeScale(n,0.75)
    call SetUnitVertexColor(n,255,255,255,125)
    call SetUnitScale(n,time,time,time)
else
    call SetUnitInvulnerable(u,false)
    call SetUnitInvulnerable(c,false)
    call PauseUnit(c,false)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
    call PauseUnit(u,false)
    call SetControlToUnit(u,c,2, "stun")
    call GroupEnumUnitsInRange(G,x2,y2,400,Base)
    loop
        set E=FirstOfGroup(G)
        exitwhen E==null
        if Condition_Base(p,E)then
            call myCustomDamage(u,E,dmg,false,false,null,null,null)
        endif
        call GroupRemoveUnit(G,E)
    endloop
    call SetUnitFlyHeight(u,0,0)
    call SetUnitTimeScale(u,1)
    call DestroyEffect(AddSpecialEffect("war3mapImported\\Slam.mdl",x,y))
    set n=CreateUnit(p,'e0Y9',x,y,GetRandomReal(0,359))
    call UnitApplyTimedLife(n,'BTLF',2)
    call SetUnitTimeScale(n,1)
    call SetUnitScale(n,1,1,1)
    set n=CreateUnit(p,'e0ZB',x,y,GetRandomReal(0,359))
    call UnitApplyTimedLife(n,'BTLF',2)
    call SetUnitTimeScale(n,1)
    call SetUnitScale(n,2,2,2)
    set n=CreateUnit(p,'e0ZB',x,y,GetRandomReal(0,359))
    call UnitApplyTimedLife(n,'BTLF',2)
    call SetUnitTimeScale(n,1)
    call SetUnitScale(n,2,2,2)
    set n=CreateUnit(p,'e0YA',x,y,GetRandomReal(0,359))
    call UnitApplyTimedLife(n,'BTLF',2)
    call SetUnitTimeScale(n,1)
    call SetUnitScale(n,1,1,1)
    set n=CreateUnit(p,'e0Y9',x,y,GetRandomReal(0,359))
    call UnitApplyTimedLife(n,'BTLF',2)
    call SetUnitTimeScale(n,1)
    call SetUnitScale(n,2,2,2)
    set n=CreateUnit(p,'e0YA',x,y,GetRandomReal(0,359))
    call UnitApplyTimedLife(n,'BTLF',2)
    call SetUnitTimeScale(n,1)
    call SetUnitScale(n,2,2,2)
    set n=CreateUnit(p,'e0Y9',x,y,GetRandomReal(0,359))
    call UnitApplyTimedLife(n,'BTLF',2)
    call SetUnitTimeScale(n,1)
    call SetUnitScale(n,3,3,3)
    set n=CreateUnit(p,'e0YA',x,y,GetRandomReal(0,359))
    call UnitApplyTimedLife(n,'BTLF',2)
    call SetUnitTimeScale(n,1)
    call SetUnitScale(n,3,3,3)
    call DestroyEffect(LoadEffectHandle(h,id,6))
    call FlushChildHashtable(h,id)
    call PauseTimer(t)
    call DestroyTimer(t)
endif
set c=null
set u=null
set t=null
set p=null
endfunction
function KabutowariCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local real x2=GetUnitX(c)
local real y2=GetUnitY(c)
local real f=GetUnitFacing(u)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroInt(u,true)*(GetUnitAbilityLevel(u,'A0LV')+2)
local real dist=SR(x,y,x2,y2)
local real a=Atan2(y2-y,x2-x)
local real time=LoadReal(h,id,5)
local real he=0
local real he2=GetUnitFlyHeight(u)
if dist>32.00 and time<3 then
    call PauseUnit(u,true)
    call SetUnitInvulnerable(u,true)
    call SetUnitX(u,x+(65-he2*0.05)*Cos(a))
    call SetUnitY(u,y+(65-he2*0.05)*Sin(a))
    call SetUnitFacing(u,a*bj_RADTODEG)
    set he=ParabolaZ(600,SR(x1,y1,x2,y2),dist)
    call SetUnitFlyHeight(u,he,0)
    call SaveReal(h,id,5,time+0.02)
else
    if time>=2 then
        call SetUnitXY_1(u,x2,y2, false)
    endif
    if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
        call SetUnitTimeScale(u,0.1)
        call PauseUnit(c,true)
