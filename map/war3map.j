endfunction
function CastCS2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local integer num=LoadInteger(h,id,2)
local player p=GetOwningPlayer(u)
if num<5+GetUnitAbilityLevel(u,0x4130414E)then
call SaveInteger(h,id,2,num+1)
else
call RemoveSavedBoolean(h,GetHandleId(u),StringHash("bullet"))
call DestroyGroup(LoadGroupHandle(h,GetHandleId(u),StringHash("GB")))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set t=null
set p=null
endfunction
function CastCS takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local group g=CreateGroup()
local player p=GetOwningPlayer(u)
local group l__n=CreateGroup()
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
call SaveUnitHandle(h,id,0,u)
call GroupEnumUnitsInRange(g,x,y,455,Base)
loop
set E=FirstOfGroup(g)
if Condition_Base(p,E)then
call GroupAddUnit(l__n,E)
call SavePlayerHandle(h,GetHandleId(E),StringHash("CS"),GetOwningPlayer(E))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\s_ShadowEruption_Rain.mdx",E,"chest"))
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Mukuro2Form.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call UnitApplyTimedLife(CreateUnit(p,'e029',x,y,GetRandomReal(0,360)),1,1)
call SaveGroupHandle(h,GetHandleId(u),StringHash("GB"),l__n)
call SaveBoolean(h,GetHandleId(u),StringHash("bullet"),true)
call TimerStart(t,1,true,function CastCS2)
call DestroyGroup(g)
set p=null
set g=null
set u=null
set t=null
endfunction
