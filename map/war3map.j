local integer i=GetRandomInt(1,4)
local real di
local real r
local integer b=0
local integer lvl=GetUnitAbilityLevel(u,0x41304D4B)
local real dmg=150+GetHeroInt(u,true)*(lvl+2)
if dist>26.00 then
call SetUnitX(l__d,x+25*Cos(a))
call SetUnitY(l__d,y+25*Sin(a))
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,ParabolaZ(400,LoadReal(h,id,4),dist),0)
else
call UnitApplyTimedLife(CreateUnit(p,0x65304A4C,x1,y1,GetRandomReal(0,359)),1,2)
call UnitApplyTimedLife(CreateUnit(p,0x65304A50,x1,y1,GetRandomReal(0,359)),1,2)
call UnitApplyTimedLife(CreateUnit(p,0x65304A50,x1,y1,GetRandomReal(0,359)),1,2)
