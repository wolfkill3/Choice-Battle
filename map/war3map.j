function CastGekishin2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local unit l__d=LoadUnitHandle(h,id,1)
local real a=LoadReal(h,id,4)
local real dist=LoadReal(h,id,10)
local real x=GetUnitX(l__d)+50*Cos(a)
local real y=GetUnitY(l__d)+50*Sin(a)
local real dmg=(1+GetUnitAbilityLevel(u,'A18S'))*GetHeroStr(u,true)+75
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,3)
local real time=LoadReal(h,id,6)
if time<0.425 then
call SaveReal(h,id,6,time+0.025)
if time==0.4 then
call PauseUnit(u,false)
call UnitApplyTimedLife(CreateUnit(p,'e0Z8',x1+75*Cos(a),y1+75*Sin(a),a*bj_RADTODEG),1,1)
call DestroyEffect(LoadEffectHandle(h,id,5))
//call SetUnitInvulnerable(u,false)
call SetUnitTimeScale(u,1)
set n=CreateUnit(GetOwningPlayer(u),'e0Z7',x1+35*Cos(a),y1+35*Sin(a),a*bj_RADTODEG)
call SetUnitFlyHeight(n,90,0)
call SaveUnitHandle(h,id,1,n)
call SetUnitScale(n,0.6,0.6,0.6)
endif
else
if dist>0 then
call SetUnitXY_1(l__d,x,y, false)
set n=CreateUnit(p,'e0YE',x+200*Cos(a-bj_PI/2),y+200*Sin(a-deg90),(a+120*bj_DEGTORAD)*bj_RADTODEG)
call UnitApplyTimedLife(n,1,1)
set n=CreateUnit(p,'e0YE',x+200*Cos(a+bj_PI/2),y+200*Sin(a+deg90),(a-60*bj_DEGTORAD)*bj_RADTODEG)
call UnitApplyTimedLife(n,1,1)
call DestroyEffect(AddSpecialEffect("war3mapImported\\EarthSmash.mdx",x+GetRandomReal(-150,150),y+GetRandomReal(-150,150)))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\EarthQuake\\EarthQuakeTarget.mdl",x+GetRandomReal(-150,150),y+GetRandomReal(-150,150)))
call GroupEnumUnitsInRange(g,x,y,250,Base)
set idg=GetHandleId(g)
call SaveReal(h,id,10,dist-50)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call Push(E,30,a,500)
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
else
call RemoveUnit(l__d)
call FlushChildHashtable(h,GetHandleId(g))
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,idg)
endif
endif
set g=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
function CastGekishin takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local effect e
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,3,CreateGroup())
call SaveReal(h,id,4,a)
//call SetUnitInvulnerable(u,true)
call SaveReal(h,id,10,2500)
call PauseUnit(u,true)
call SetUnitTimeScale(u,0.7)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Whitebeard1.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call SetUnitAnimation(u,"Spell Three")
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\dash sfx.mdl",u,"origin"))
call SaveEffectHandle(h,id,5,AddSpecialEffectTarget("GuraGuraAttack.mdx",u,"left hand"))
call TimerStart(t,0.025,true,function CastGekishin2)
set u=null
set e=null
set p=null
set t=null
endfunction
