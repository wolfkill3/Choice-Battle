    call SetUnitInvulnerable(u,false)
    call myCustomDamage(u,c,dmg,false,false,null,null,null)
    call SetControlToUnit(u,c,1,"stun")
    call UnitApplyTimedLife(l__d,1,0.2)
    call SetUnitVertexColor(u,255,255,255,255)
    call SetUnitTimeScale(u,1)
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(h,id)
    set p=null
    set l__d=null
    set u=null
    set c=null
    set t=null
endfunction
function OrochimaruFCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit c=LoadUnitHandle(h,id,1)
    local unit l__d=LoadUnitHandle(h,id,12)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetUnitX(c)
    local real y1=GetUnitY(c)
    local real a=Atan2(y1-y,x1-x)
    local real time=LoadReal(h,id,2)+0.03
    local real rd=LoadReal(h,id,3)
    local real f=GetUnitFacing(u)
    local player p=GetOwningPlayer(u)
    if SR(x,y,x1,y1)>150 then
        set x=x+40*Cos(a+rd)
        set y=y+40*Sin(a+rd)
        call SetUnitXY_1(u,x,y, false)
        call SetUnitX(l__d,x)
        call SetUnitY(l__d,y)
        call SaveReal(h,id,2,time)
        if time>0.35 then
            call SaveReal(h,id,2,0)
            call SaveReal(h,id,3,rd*(-1))
        endif
        call PauseUnit(u,true)
        call SetUnitInvulnerable(u,true)
        call SetUnitFacing(l__d,a*bj_RADTODEG)
        set n=CreateUnit(p,'or00',x,y,f)
        call SetUnitAnimationByIndex(n,12)
        call SetUnitVertexColor(n,255,255,255,125)
        call UnitApplyTimedLife(n,1,0.2)
        set n=CreateUnit(p,'eo0N',x,y,a*bj_RADTODEG)
        call SetUnitVertexColor(n,255,255,255,75)
        call UnitApplyTimedLife(n,1,0.2)
    else
        if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
            call UnitRemoveAbility(l__d,'ore2')
            call SetUnitTimeScale(l__d,1)
            call PauseUnit(c,true)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
            call SetUnitAnimationByIndex(l__d,25)
            call PauseTimer(t)
            call TimerStart(t,0.75,false,function OrochimaruFCast3)
        else
            call UnitApplyTimedLife(l__d,1,0.05)
            call PauseUnit(u,false)
            call PauseUnit(c,false)
            call SetUnitTimeScale(u,1)
            call SetUnitTimeScale(c,1)
            call SetUnitPathing(u,true)
            call SetUnitPathing(c,true)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
            call SetUnitInvulnerable(u,false)
            call SetUnitInvulnerable(c,false)
            call SetUnitVertexColor(u,255,255,255,255)
            call PauseTimer(t)
            call SetUnitFlyHeight(u,0,0)
            call DestroyTimer(t)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
            call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
            call FlushChildHashtable(h,id)
        endif
    endif
    set l__d=null
    set p=null
    set u=null
    set c=null
    set t=null
endfunction
