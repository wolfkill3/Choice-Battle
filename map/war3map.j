call DestroyEffect(AddSpecialEffectTarget(LoadStr(h,id,3),c,"origin"))
call myCustomDamage(u,c,(1+GetUnitAbilityLevel(u,'A0JP'))*GetHeroInt(u,true)+75,false,false,null,null,null)
