call GroupRemoveUnit(g,E)
endloop
else
set idg=GetHandleId(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,idg)
call DestroyGroup(g)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set g=null
set t=null
endfunction
