function SwitchHeroAct takes nothing returns nothing
local integer ip=GetPlayerId(GetTriggerPlayer())
local integer id=GetHandleId(Hero[ip])
local integer p1 = S2I(SubString(GetEventPlayerChatString(), 12, 13))-1
local integer p2 = S2I(SubString(GetEventPlayerChatString(), 14, 15))-1
call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "Player 1: "+I2S(p1)+", Hero: "+GetUnitName(udg_Hero[p1]))
call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "Player 2: "+I2S(p2)+", Hero: "+GetUnitName(udg_Hero[p2]))
if p1>=0 and p1<10 and  p2>=0 and p2<10 then
        
endif
endfunction
