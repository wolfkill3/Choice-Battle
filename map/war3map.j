call SaveReal(h,id,23,a)
endif
call GroupEnumUnitsInRange(G,x1,y1,700,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)and IsUnitInGroup(E,g)==false then
call myCustomDamage(u,E,dmg1,false,false,null,null,null)
call SetControlToUnit(E,E, 0.025, "stun")
call GroupAddUnit(g,E)
elseif Condition_Base(p,E)and IsUnitInGroup(E,g)then
call myCustomDamage(u,E,dmg1*0.03,false,false,null,null,null)
if time<0.97 then
call SetControlToUnit(E,E, 0.015, "stun")
else
call SetControlToUnit(E,E, 1, "stun")
endif
call GroupAddUnit(g,E)
endif
call GroupRemoveUnit(G,E)
endloop
else
call UnitRemoveAbility(u,'Ad8O')
call UnitRemoveAbilityTimed(u,'Ad93',0.3)
call SetUnitX(d1,x)
call SetUnitY(d1,y)
call SetUnitX(d2,x)
call SetUnitY(d2,y)
call RemoveUnit(d1)
call RemoveUnit(d2)
call DestroyGroup(g)
call PauseTimer(t)
call TimerStart(t,0.03,false,function TDantesCast)
endif
set u=null
set d1=null
set d2=null
set g=null
set p=null
set t=null
endfunction
