function BlackStarTMove takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local real d2=LoadReal(HH,id,3)
local integer i=LoadInteger(HH,id,5)
local unit u=LoadUnitHandle(HH,id,1)
local unit c=LoadUnitHandle(HH,id,2)
set i=i+1
call SaveInteger(HH,id,5,i)
if i==1 then
call SetUnitAnimationByIndex(u,2)
set soundplay=SndN(2712) // Sound\Music\mp3Music\BlackStarT0.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call UnitSpeed(u,0.5)
endif
