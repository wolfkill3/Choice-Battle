return GetSpellAbilityId()=='A0YZ'
endfunction

//kurapika G
function KurapikaPingDummyAct takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local real time=LoadReal(HH,id,5)
set time=time+0.02
call SaveReal(HH,id,5,time)
call MoveUnit(LoadUnitHandle(HH,id,2),LoadUnitHandle(HH,id,20),0,0)

if time==2 then
call RemoveUnit(LoadUnitHandle(HH,id,20))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif

set t=null
endfunction

function  KurapikaPingDummy takes unit caster1,unit target1 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)

//call SaveUnitHandle(HH,id,1,caster1)
call SaveUnitHandle(HH,id,2,target1)


set n0=CreateUnit(GetOwningPlayer(caster1),'e300',GetUnitX(target1),GetUnitY(target1),0)
call SaveUnitHandle(HH,id,20,n0)

set n0=null
call TimerStart(t,0.02,true,function KurapikaPingDummyAct)
set caster1=null
set target1=null
set t=null
endfunction
//kurapika G

function Trig_DowsingChain_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local integer i=0
set n=CreateUnit(p,'e0FB',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,3.4)
call SetUnitTimeScale(n,0.3)
call UnitScale(n,0.1,20,3.4)
loop
exitwhen i>=10
call KurapikaPingDummy(u,Hero[i])
if GetLocalPlayer()==p then
if i==0 and IsUnitType(Hero[i],UNIT_TYPE_DEAD)==false and GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING then
call PingMinimapEx(GetUnitX(Hero[i]),GetUnitY(Hero[i]),3,255,0,0,true)
elseif i==1 and IsUnitType(Hero[i],UNIT_TYPE_DEAD)==false and GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING then
call PingMinimapEx(GetUnitX(Hero[i]),GetUnitY(Hero[i]),3,0,0,255,true)
elseif i==2 and IsUnitType(Hero[i],UNIT_TYPE_DEAD)==false and GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING then
call PingMinimapEx(GetUnitX(Hero[i]),GetUnitY(Hero[i]),3,0,255,255,true)
elseif i==3 and IsUnitType(Hero[i],UNIT_TYPE_DEAD)==false and GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING then
call PingMinimapEx(GetUnitX(Hero[i]),GetUnitY(Hero[i]),3,127,0,128,true)
elseif i==4 and IsUnitType(Hero[i],UNIT_TYPE_DEAD)==false and GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING then
call PingMinimapEx(GetUnitX(Hero[i]),GetUnitY(Hero[i]),3,255,255,0,true)
elseif i==5 and IsUnitType(Hero[i],UNIT_TYPE_DEAD)==false and GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING then
call PingMinimapEx(GetUnitX(Hero[i]),GetUnitY(Hero[i]),3,255,144,15,true)
elseif i==6 and IsUnitType(Hero[i],UNIT_TYPE_DEAD)==false and GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING then
call PingMinimapEx(GetUnitX(Hero[i]),GetUnitY(Hero[i]),3,33,192,0,true)
elseif i==7 and IsUnitType(Hero[i],UNIT_TYPE_DEAD)==false and GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING then
call PingMinimapEx(GetUnitX(Hero[i]),GetUnitY(Hero[i]),3,229,91,177,true)
elseif i==8 and IsUnitType(Hero[i],UNIT_TYPE_DEAD)==false and GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING then
call PingMinimapEx(GetUnitX(Hero[i]),GetUnitY(Hero[i]),3,128,128,128,true)
elseif i==9 and IsUnitType(Hero[i],UNIT_TYPE_DEAD)==false and GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING then
call PingMinimapEx(GetUnitX(Hero[i]),GetUnitY(Hero[i]),3,175,234,239,true)
endif
endif
set i=i+1
endloop
set u=null
set p=null
endfunction
function ChainJailCond takes nothing returns boolean
return GetSpellAbilityId()=='A0Z0' and udg_B==true
endfunction
function ChainJailCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local player p=GetOwningPlayer(u)
local integer idu=GetPlayerId(p)
local real x=LoadReal(h,id,3)
local real y=LoadReal(h,id,4)
local real time=LoadReal(h,id,12)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real x2=0
local real y2=0
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,8)
local lightning l=LoadLightningHandle(h,id,4)
local real dmg=GetHeroAgi(u,true)*(2.5+GetUnitAbilityLevel(u,'A0Z0')*0.5)
local real Range=LoadReal(h,id,9)
local real speed=LoadReal(h,id,11)
local integer i=0
if Range<1800 and UnitIsAlive(l__d)then
set x1=x1+speed*Cos(a)
set y1=y1+speed*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
call SaveReal(h,id,3,x1)
call SaveReal(h,id,4,y1)
call MoveLightningEx(l,true,GetUnitX(u),GetUnitY(u),GetUnitZ(u)+75,x1,y1,GetUnitZ(l__d))
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SaveReal(h,id,9,Range+90)
call GroupEnumUnitsInRange(G,x1,y1,120,Base)
loop
set E=FirstOfGroup(G)
set x2=GetUnitX(E)
set y2=GetUnitY(E)
exitwhen E==null
if Condition_Base(p,E)then
call KillUnit(l__d)
//call UnitApplyTimedLife(CreateUnit(p,'e0V0',x2,y2,GetRandomReal(0,359)),1,3)
set n0=CreateUnit(p,'e0V0',x2,y2,GetRandomReal(0,359))
call SaveUnitHandle(h,id,20,n0)
call MyRemoveUnit(n0,3)
set n0=null

call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A0Z0',false)
call UnitAddAbility(u,'A0YX')

call SetControlToUnit(E,E, 3, "stun")
call UnitAddAbility(E,'A0ZF')
call SaveUnitHandle(h,GetHandleId(u),TargetHash,E)
endif
call GroupRemoveUnit(G,E)
endloop

else
if UnitIsAlive(l__d)==false then




set n=LoadUnitHandle(h,GetHandleId(u),TargetHash)

call MoveUnit(n,LoadUnitHandle(h,id,20),0,0)

call MoveLightningEx(l,true,GetUnitX(u),GetUnitY(u),GetUnitZ(u)+75,GetUnitX(n),GetUnitY(n),GetUnitZ(n)+75)
call SaveReal(h,id,12,time+0.05)
if GetUnitAbilityLevel(u,'A1A6')>0 or GetUnitAbilityLevel(u,'A1AD')>0 then
set dmg=(GetHeroAgi(u,true)*5) / 3
elseif GetUnitAbilityLevel(u,'A1A7')>0 or GetUnitAbilityLevel(u,'A1AF')>0 then
set dmg=(GetHeroInt(u,true)*5) / 3
elseif GetUnitAbilityLevel(u,'A1A8')>0 or GetUnitAbilityLevel(u,'A1AE')>0 then
set dmg=(GetHeroStr(u,true)*5) / 3
endif
call myCustomDamage(u,n,dmg*0.05,false,false,null,null,null)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",n,"chest"))
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",n,"chest"))
if time>3 then


call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A0Z0',true)
call UnitRemoveAbility(u,'A0YX')

call DestroyLightning(l)
call RemoveUnit(l__d)
call UnitRemoveAbility(n,'A0ZF')
call RemoveSavedHandle(h,GetHandleId(u),TargetHash)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
endif
else
call DestroyLightning(l)
call RemoveUnit(l__d)
call RemoveSavedHandle(h,GetHandleId(u),TargetHash)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
endif
endif
set l=null
set u=null
set p=null
set t=null
set l__d=null
endfunction
function ChainJailCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,8,a)
call SaveReal(h,id,11,90)
call SaveReal(h,id,12,0)
set x=x+80*Cos(a)
set y=y+80*Sin(a)
set n=CreateUnit(GetOwningPlayer(u),0x6530555A,x,y,a*bj_RADTODEG)
call SetUnitScale(n,3,3,3)
call SaveUnitHandle(h,id,1,n)
if GetUnitTypeId(u)=='H04O' then
call SaveLightningHandle(h,id,4,AddLightningEx("DRAL",true,x,y,GetUnitZ(u)+75,GetUnitX(n),GetUnitY(n),GetUnitZ(n)))
else
call SaveLightningHandle(h,id,4,AddLightningEx("DRAA",true,x,y,GetUnitZ(u)+75,GetUnitX(n),GetUnitY(n),GetUnitZ(n)))
endif
if GetUnitTypeId(u)=='H04O' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\ChainJail.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\ArcueidR.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
call TimerStart(t,0.05,true,function ChainJailCast2)
set u=null
set p=null
set t=null
endfunction
function HolyChainCond takes nothing returns boolean
return GetSpellAbilityId()=='A0YU'
endfunction
function HolyChainCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real l=LoadReal(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real heal=LoadReal(h,id,2)
local real time=LoadReal(h,id,3)
local integer i=1
local player p=GetOwningPlayer(u)



if time==0.01 and LoadBoolean(h,id,19)==true then
call StartAbilityCooldown(GetUnitAbility(u, 'A0YU'), 15)
endif

if time<1+GetUnitAbilityLevel(u,'A0YU')then
call SaveReal(h,id,3,time+0.01)
if l>GetWidgetLife(u)then
call HealTextTag(u,u,heal*myCustomHeal2(u,1),"HealthRes")
call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+heal)
call SaveReal(h,id,3,15)
if GetUnitTypeId(u)=='H04O' then
call UnitApplyTimedLife(CreateUnit(p,'e01O',x,y,0),1,1.1)
call UnitApplyTimedLife(CreateUnit(p,'e0AW',x,y,GetRandomReal(0,359)),1,0.01)
call UnitApplyTimedLife(CreateUnit(p,'e0AX',x,y,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e04Y',x,y,GetRandomReal(0,359)),1,1)
else
call DestroyEffect(AddSpecialEffectTarget("EclipseCaster.MDX",u,"origin"))
endif
endif
else
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set p=null
set t=null
endfunction


function HolyChainCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real heal=(GetUnitState(u,UNIT_STATE_MAX_LIFE)-GetWidgetLife(u))*(0.20+0.02*GetUnitAbilityLevel(u,'A0YU'))
local real heal1=0
set n0=LoadUnitHandle(HH,GetHandleId(u),StringHash("KurapRTarg"))
if GetUnitTypeId(u)=='H04O' then


if n0!=u and IsUnitAlly( n0  ,p )==true then 
call UnitApplyTimedLife(CreateUnit(p,'e01O',GetUnitX(n0),GetUnitY(n0),0),1,1.1)
call UnitApplyTimedLife(CreateUnit(p,'e0AW',GetUnitX(n0),GetUnitY(n0),GetRandomReal(0,359)),1,0.01)
call UnitApplyTimedLife(CreateUnit(p,'e0AX',GetUnitX(n0),GetUnitY(n0),GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e04Y',GetUnitX(n0),GetUnitY(n0),GetRandomReal(0,359)),1,1)
endif

call UnitApplyTimedLife(CreateUnit(p,'e01O',x,y,0),1,1.1)
call UnitApplyTimedLife(CreateUnit(p,'e0AW',x,y,GetRandomReal(0,359)),1,0.01)
call UnitApplyTimedLife(CreateUnit(p,'e0AX',x,y,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e04Y',x,y,GetRandomReal(0,359)),1,1)
else

if n0!=u and IsUnitAlly( n0  ,p )==true then //єффект на союзнике
call DestroyEffect(AddSpecialEffectTarget("EclipseCaster.MDX",n0,"origin"))
endif

call DestroyEffect(AddSpecialEffectTarget("EclipseCaster.MDX",u,"origin"))
endif
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,GetWidgetLife(u))
call SaveReal(h,id,2,heal)
call SaveReal(h,id,3,0)





if GetUnitTypeId(u)=='H04O' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\HolyChain.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\ArcueidW.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif

//kurapika Wbuff
if GetUnitAbilityLevel(u,'A1A6')>0 or GetUnitAbilityLevel(u,'A1AD')>0 then// ловкость
set heal1=(GetUnitState(u,UNIT_STATE_MAX_MANA)-GetUnitState(u,UNIT_STATE_MANA))*0.4

    call HealTextTag(u,u,heal*myCustomHeal2(u,1),"HealthRes")
    call HealTextTag(u,u,heal1*myCustomMana2(u,1),"ManaRes")
    call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+heal)
    call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)+heal1)

if n0!=u and IsUnitAlly( n0  ,p )==true then 

    call HealTextTag(u,n0,heal*0.75*myCustomHeal2(n0,1),"HealthRes")
    call HealTextTag(u,n0,heal1*0.75*myCustomMana2(n0,1),"ManaRes")
    call SetUnitState(n0,UNIT_STATE_LIFE,GetWidgetLife(n0)+heal*0.75)
    call SetUnitState(n0,UNIT_STATE_MANA,GetUnitState(n0,UNIT_STATE_MANA)+heal1*0.75)

endif



elseif GetUnitAbilityLevel(u,'A1A7')>0 or GetUnitAbilityLevel(u,'A1AF')>0 then//инта

call HealTextTag(u,u,heal*myCustomHeal2(u,1),"HealthRes")
call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+heal)
call UnitAddAbility(u,'A5WT')
call UnitRemoveAbilityTimed(u,'A5WT',5)

if n0!=u and IsUnitAlly( n0  ,p )==true then 
call HealTextTag(u,n0,heal*0.75*myCustomHeal2(n0,1),"HealthRes")
call SetUnitState(n0,UNIT_STATE_LIFE,GetWidgetLife(n0)+heal*0.75)
call UnitAddAbility(n0,'A5WT')
call UnitRemoveAbilityTimed(n0,'A5WT',5)
endif



elseif GetUnitAbilityLevel(u,'A1A8')>0 or GetUnitAbilityLevel(u,'A1AE')>0 then//сила

call HealTextTag(u,u,heal*myCustomHeal2(u,1),"HealthRes")
call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+heal)
if n0!=u and IsUnitAlly( n0  ,p )==true then 
call HealTextTag(u,n0,heal*0.75*myCustomHeal2(n0,1),"HealthRes")
call SetUnitState(n0,UNIT_STATE_LIFE,GetWidgetLife(n0)+heal*0.75)
endif

//call StartUnitAbilityCooldown(u, 'A0YU', 5)
//call StartUnitAbilityCooldown(u, 'A0YU', 0.1)
call SaveBoolean(h,id,19,true)


endif
//kurapika W buff


call TimerStart(t,0.01,true,function HolyChainCast2)
set n0=null
set u=null
set t=null
set p=null
endfunction





function JujmentChainCond takes nothing returns boolean
	return GetSpellAbilityId()=='A0YX'
endfunction
function JujmentChainCast2 takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(h,id,0)
        local real l=LoadReal(h,id,1)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        local integer i=1
        local player p=GetOwningPlayer(u)
        call DestroyTimer(t)
        call UnitRemoveAbility(u,'A0YY')
        call UnitRemoveAbility(u,'A1AC')
        call FlushChildHashtable(h,id)
        set u=null
        set p=null
        set t=null
endfunction
function JujmentChainCast takes nothing returns nothing
        local unit u=GetTriggerUnit()
        local timer t=CreateTimer()
        local integer id=GetHandleId(t)
        local player p=GetOwningPlayer(u)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        set Kurapika=u
        set n=LoadUnitHandle(h,GetHandleId(u),TargetHash)
        call SaveUnitHandle(h,id,0,n)
        call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",n,"chest"))
        call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",n,"chest"))
        if GetUnitTypeId(u)=='H04O' then
                call UnitAddAbility(n,'A0YY')
                set soundplay=CreateSound("Sound\\Music\\mp3Music\\JujumentChain.mp3",false,false,true,12700,12700,"")
                call StartSound(soundplay)
                call KillSoundWhenDone(soundplay)
        else
                call UnitAddAbility(n,'A1AC')
                set soundplay=CreateSound("Sound\\Music\\mp3Music\\ArcueidUlt.mp3",false,false,true,12700,12700,"")
                call StartSound(soundplay)
                call KillSoundWhenDone(soundplay)
        endif
        call TimerStart(t,6,false,function JujmentChainCast2)
        set u=null
        set t=null
        set p=null
endfunction
function EnchantedFistCond takes nothing returns boolean
return GetSpellAbilityId()=='A0YQ'
endfunction
function EnchantedFistCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real dmg=0
local integer idd=0
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>50 and GetWidgetLife(c)>0 then
set x=x+60*Cos(a)
set y=y+60*Sin(a)
call SetUnitXY_1(u,x,y,false)
if GetUnitTypeId(u)=='H04O' then
set idd='e0UV'
else
set idd='e10C'
endif
call SetUnitFacing(u,a*bj_RADTODEG)
set n=CreateUnit(p,idd,x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'B000',0.25)
call SetUnitVertexColor(n,170,170,170,255)
call SetUnitTimeScale(n,2)
call SetUnitAnimation(n,"attack")
call SetUnitAnimation(u,"attack")
else
call Push(c,50,LoadReal(h,id,9),300)
if GetUnitTypeId(u)=='H04O' then
call UnitApplyTimedLife(CreateUnit(p,'e0SA',x1,y1,a*bj_RADTODEG),1,2)
call UnitApplyTimedLife(CreateUnit(p,'e0SB',x1,y1,a*bj_RADTODEG),1,2)
set n=CreateUnit(p,'e0SC',x1,y1,a*bj_RADTODEG)
call SetUnitAnimation(n,"death")
call UnitApplyTimedLife(n,1,1)
set n=CreateUnit(p,'e0SD',x1,y1,a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,2)
call SetUnitTimeScale(n,2)
call UnitApplyTimedLife(CreateUnit(p,'e0SE',x1,y1,a*bj_RADTODEG),1,2)
call UnitApplyTimedLife(CreateUnit(p,'e0SF',x1,y1,a*bj_RADTODEG),1,2)
else
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e03D',x1,y1,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e03D',x1,y1,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e03D',x1,y1,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e06F',x1,y1,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e06F',x1,y1,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e06F',x1,y1,GetRandomReal(0,359)),1,1)
endif









//kurapikaQ Buff
if GetUnitAbilityLevel(u,'A1A6')>0 or GetUnitAbilityLevel(u,'A1AD')>0 then//ловкость

set dmg=((2+GetUnitAbilityLevel(u,'A0YQ'))*GetHeroAgi(u,true))
elseif GetUnitAbilityLevel(u,'A1A7')>0 or GetUnitAbilityLevel(u,'A1AF')>0 then//инта

call UnitAddAbility(c,'AKKQ')
call UnitRemoveAbility(c,'AKKQ')

set dmg=((2+GetUnitAbilityLevel(u,'A0YQ'))*GetHeroInt(u,true))
elseif GetUnitAbilityLevel(u,'A1A8')>0 or GetUnitAbilityLevel(u,'A1AE')>0 then//сила

set dmg=((4+GetUnitAbilityLevel(u,'A0YQ'))*GetHeroStr(u,true))
endif
//KurapikaQ buff end



if GetUnitAbilityLevel(c,'A0ZF')==0 and GetUnitAbilityLevel(c,'KkR3')==0 then
call myCustomDamage(u,c,dmg,false,false,null,null,null)
else
call myCustomDamage(u,c,dmg*1.5,false,false,null,null,null)
endif

if GetUnitAbilityLevel(u,'A1A6')>0 or GetUnitAbilityLevel(u,'A1AD')>0 then
call SetControlToUnit(u,c,2.5, "stun")
else
call SetControlToUnit(u,c,1, "stun")
endif


call PauseTimer(t)
call DestroyTimer(t)
call UnitRemoveAbility(u,'A0BX')
call SetUnitTimeScale(u,1)
call SetUnitPathing(u,true)
call PauseUnit(u,false)
call FlushChildHashtable(h,id)
call SetUnitInvulnerable(u,false)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function EnchantedFistCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
call SaveUnitHandle(h,id,0,u)
call SetUnitPathing(u,false)
call SetUnitAnimation(u,"spell two")
call UnitAddAbility(u,'A0BX')
call PauseUnit(u,true)
if GetUnitTypeId(u)=='H04O' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\EnchantedFist.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\ArcueidQ.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
call SaveReal(h,id,9,Atan2(GetUnitY(c)-y,GetUnitX(c)-x))
call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e06H',x,y,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e06I',x,y,GetRandomReal(0,359)),1,1)
call SetUnitTimeScale(u,5)
call SetUnitInvulnerable(u,true)
call SaveUnitHandle(h,id,1,c)
call TimerStart(t,0.025,true,function EnchantedFistCast2)
set c=null
set u=null
set t=null
endfunction
function DestructoDiskCond takes nothing returns boolean
return GetSpellAbilityId()=='A10B' or GetSpellAbilityId()=='A20B' or GetSpellAbilityId()=='A30B'
endfunction
function DestructoDiskCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local group g=LoadGroupHandle(h,id,4)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,5)
local integer l__idg=GetHandleId(g)
local player p=GetOwningPlayer(u)
local real dmg=LoadReal(h,id,10)
if SR(x,y,x1,y1)<=2450 then
call SetUnitX(l__d,x1+68*Cos(a))
call SetUnitY(l__d,y1+68*Sin(a))
set n=CreateUnit(p,'e0B2',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitVertexColor(n,200,40,255,30)
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl",x1,y1))
call GroupEnumUnitsInRange(g,x1,y1,150,Base)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 1, "stun")
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",GetUnitX(E),GetUnitY(E)))
call SaveUnitHandle(h,l__idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
else
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
call DestroyTimer(t)
call DestroyGroup(g)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function DestructoDiskCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
local real dmg=GetHeroInt(u,true)*(1.25+GetUnitAbilityLevel(u,'A10A')*0.75)+50
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,CreateUnit(p,0x65305157,x+80*Cos(a),y+80*Sin(a),f))
call SaveGroupHandle(h,id,4,CreateGroup())
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveReal(h,id,5,a)
//if GetSpellAbilityId()=='A10B' then
//set soundplay=CreateSound("Sound\\Music\\mp3Music\\DestructoDisks.mp3",false,false,true,12700,12700,"")
//call StartSound(soundplay)
//call KillSoundWhenDone(soundplay)
//endif
set soundplay=CreateSound("Sound\\Music\\mp3Music\\ThrowDisc.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call SaveReal(h,id,10,dmg)
if GetSpellAbilityId()=='A10B' then
call ShowUnitAbilityTimed(u,'A10B',false,0.76)
call ShowUnitAbilityTimed(u,'A20B',true,0.77)
elseif GetSpellAbilityId()=='A20B' then
call ShowUnitAbilityTimed(u,'A20B',false,0.76)
call ShowUnitAbilityTimed(u,'A30B',true,0.77)
elseif GetSpellAbilityId()=='A30B' then
call ShowUnitAbilityTimed(u,'A30B',false,0.76)
call ShowUnitAbilityTimed(u,'A10B',true,0.77)
endif
call SetUnitFacing(LoadUnitHandle(h,id,1),a*bj_RADTODEG)
call TimerStart(t,0.03,true,function DestructoDiskCast2)
set u=null
set p=null
set t=null
endfunction
