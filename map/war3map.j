function Trig_RainMare_Conditions takes nothing returns boolean
return UnitHasItemOfTypeBJ(GetTriggerUnit(),'I05O')or UnitHasItemOfTypeBJ(GetTriggerUnit(),'I05P')or UnitHasItemOfTypeBJ(GetTriggerUnit(),'I05Q')or UnitHasItemOfTypeBJ(GetTriggerUnit(),'I05R')or UnitHasItemOfTypeBJ(GetTriggerUnit(),'I05S')or UnitHasItemOfTypeBJ(GetTriggerUnit(),'I05T') or GetUnitAbilityLevel(GetTriggerUnit(), 'KIT8')>0 or GetUnitAbilityLevel(GetTriggerUnit(), 'KIU0')>0 or GetUnitAbilityLevel(GetTriggerUnit(), 'KIU2')>0 or GetUnitAbilityLevel(GetTriggerUnit(), 'KIU4')>0 or GetUnitAbilityLevel(GetTriggerUnit(), 'KIU6')>0 or GetUnitAbilityLevel(GetTriggerUnit(), 'KIU8')>0 
endfunction
function RainMare_Actions takes unit u, unit c returns nothing
local player p=GetOwningPlayer(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
if UnitHasItemOfTypeBJ(GetTriggerUnit(),'I05O') or GetUnitAbilityLevel(GetTriggerUnit(), 'KIT8')>0 then
call SlowUnit(u,c,0.0,0.3,2,3,false)
elseif UnitHasItemOfTypeBJ(GetTriggerUnit(),'I05P') or GetUnitAbilityLevel(GetTriggerUnit(), 'KIU0')>0 then
call SlowUnit(u,c,0.0,0.6,2,3,false)
elseif UnitHasItemOfTypeBJ(GetTriggerUnit(),'I05Q') or GetUnitAbilityLevel(GetTriggerUnit(), 'KIU2')>0 then
call SlowUnit(u,c,0.0,0.9,2,3,false)
elseif UnitHasItemOfTypeBJ(GetTriggerUnit(),'I05R') or GetUnitAbilityLevel(GetTriggerUnit(), 'KIU4')>0 then
call SlowUnit(u,c,0.0,1.2,2,3,false)
elseif UnitHasItemOfTypeBJ(GetTriggerUnit(),'I05S') or GetUnitAbilityLevel(GetTriggerUnit(), 'KIU6')>0 then
call SlowUnit(u,c,0.0,1.5,2,3,false)
elseif UnitHasItemOfTypeBJ(GetTriggerUnit(),'I05T') or GetUnitAbilityLevel(GetTriggerUnit(), 'KIU8')>0 then
call SlowUnit(u,c,0.0,2.3,2,3,false)
endif
set u=null
set c=null
endfunction
function Trig_RainMare_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetAttacker()
call RainMare_Actions(u,c)
set u=null
set c=null
endfunction
function InitTrig_RainMare takes nothing returns nothing
set gg_trg_RainMare=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_RainMare,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddCondition(gg_trg_RainMare,Condition(function Trig_RainMare_Conditions))
call TriggerAddAction(gg_trg_RainMare,function Trig_RainMare_Actions)
endfunction
function Trig_666_Conditions takes nothing returns boolean
return (UnitHasItemOfTypeBJ(GetAttacker(),'I04E')==true or GetUnitAbilityLevel(GetAttacker(),'KIN4') > 0) and  IsUnitIllusion(GetAttacker()) == false
endfunction
function Trig_666_Actions takes nothing returns nothing
local unit u=GetAttacker()
local unit c=GetTriggerUnit()
    if GetRandomIntMem(0,100)<=40 then
        call ComboChecker(u,2,0.45, false )
        call SetControlToUnit(u,c, 0.06,"stunbkb") //"stunbkb"
    endif
//else
//    call SetControlToUnit(c, 0.06,"stun") //"stunbkb"
set u=null
set c=null
endfunction
function InitTrig_666 takes nothing returns nothing
set gg_trg_666=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_666,EVENT_PLAYER_UNIT_ATTACKED)
