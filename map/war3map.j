call SaveBoolean(HH,GetHandleId( target ),TARGET_ABILITY,true)

//Проверка на паузу
call SetUnitInvulnerable(target,true)
call SaveReal(HH,id,15,(2+GetUnitAbilityLevel(caster,'SiW1'))*GetHeroAgi(caster,true))
