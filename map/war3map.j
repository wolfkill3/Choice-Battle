function WorldDoorCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,5)
local real y1=LoadReal(h,id,6)
local real a=Atan2(y1-y,x1-x)
local real time=LoadReal(h,id,4)
local unit c
local integer i=0
local player p=GetOwningPlayer(u)
local trigger tr=CreateTrigger()
if GetUnitCurrentOrder(u)==OrderId("root") and time<SR(x,y,x1,y1)*0.00025 then
call SaveReal(h,id,4,time+0.1)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl",x1,y1))
else
if time>=SR(x,y,x1,y1)*0.00025 then
set n=CreateUnit(p,'e0VE',x+100*Cos(a),y+100*Sin(a),a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',10)
call SetUnitInvulnerable(n,true)
call UnitRemoveAbility(n,'Amrf')
call SetUnitMoveSpeed(n,0)
call SetUnitTurnSpeed(n,0)
set c=CreateUnit(p,'e0VE',x1,y1,a*bj_RADTODEG)
call UnitApplyTimedLife(c,'BTLF',10)
call SetUnitInvulnerable(c,true)
call UnitRemoveAbility(c,'Amrf')
call SetUnitMoveSpeed(c,0)
call SetUnitTurnSpeed(c,0)
call SaveUnitHandle(h,GetHandleId(n),SH_door,c)
call SaveUnitHandle(h,GetHandleId(c),SH_door,n)
endif
call IssueImmediateOrder(u,"stop")
call UnitRemoveAbility(u,'A10H')
loop
exitwhen i>=10
call TriggerRegisterPlayerUnitEvent(tr,Player(i),EVENT_PLAYER_UNIT_SELECTED,null)
set i=i+1
endloop
call TriggerAddAction(tr,function SelectWorldDoor)
call PauseTimer(t)
call SaveTriggerHandle(h,id,10,tr)
call TimerStart(t,10,true,function WorldDoorCast3)
endif
set tr=null
set c=null
set p=null
set u=null
set t=null
endfunction
