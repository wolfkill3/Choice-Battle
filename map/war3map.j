function IceCannonCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real a=LoadReal(h,id,11)
local real dist=LoadReal(h,id,2)
local real x=GetUnitX(l__d)+60*Cos(a)
local real y=GetUnitY(l__d)+60*Sin(a)
local real dmg=LoadReal(h,id,4)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,12)
if dist>0 and RectContainsUnit(GetWorldBounds(),l__d)and UnitIsAlive(l__d)then
call SetUnitXY_1(l__d,x,y, false)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitVertexColor(n,25,100,255,50)
set n=CreateUnit(p,'e0UI',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,0.1)
call SetUnitVertexColor(n,50,100,255,125)
call GroupEnumUnitsInRange(g,x,y,150,Base)
set idg=GetHandleId(g)
call SaveReal(h,id,2,dist-45)
if GetUnitAbilityLevel(u,'B06U')>0 then
set dmg=dmg+2*GetHeroAgi(u,true)
endif
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call KillUnit(l__d)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
else
if GetUnitAbilityLevel(u,'B06U')>0 then
set dmg=dmg+2*GetHeroAgi(u,true)
endif
call GroupEnumUnitsInRange(g,x,y,450,Base)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
if GetHeroLevel(u)==35 then
    call SlowUnit(u,E,0.5,0,5,0,false)
endif
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
call UnitApplyTimedLife(CreateUnit(p,'e0UF',x,y,(a*bj_RADTODEG)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0UE',x,y,(a*bj_RADTODEG)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0UG',x,y,(a*bj_RADTODEG)),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e0UH',x,y,(a*bj_RADTODEG)),1,3)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,1.2,1.2,1.2)
call SetUnitTimeScale(n,0.6)
call SetUnitVertexColor(n,25,100,255,50)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitTimeScale(n,0.6)
call SetUnitVertexColor(n,25,100,255,50)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,1.7,1.7,1.7)
call SetUnitTimeScale(n,0.6)
call SetUnitVertexColor(n,25,100,255,50)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,1.9,1.9,1.9)
call SetUnitTimeScale(n,0.6)
call SetUnitVertexColor(n,25,200,255,50)
call RemoveUnit(l__d)
call FlushChildHashtable(h,GetHandleId(g))
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
