function Trig_White_Finger_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__n=LoadUnitHandle(h,id,DummyHash)
local unit u=LoadUnitHandle(h,id,CasterHash)
local unit c=LoadUnitHandle(h,id,TargetHash)
local real x=GetUnitX(LoadUnitHandle(h,id,DummyHash))
local real y=GetUnitY(LoadUnitHandle(h,id,DummyHash))
local real x1=GetUnitX(LoadUnitHandle(h,id,TargetHash))
local real y1=GetUnitY(LoadUnitHandle(h,id,TargetHash))
local real a=Atan2(y-y1,x-x1)
local integer dist=LoadInteger(h,id,StringHash("dist"))
local real r
call SetUnitPathing(c,false)
if SR(x,y,x1,y1)>30 and dist<1 then
        call SetUnitX(l__n,x-24*Cos(a))
        call SetUnitY(l__n,y-24*Sin(a))
        set n=CreateUnit(GetOwningPlayer(u),0x65303057,x,y,a*bj_RADTODEG+180)
        call UnitApplyTimedLife(n,1,0.30)
        call UnitAddAbility(n,'Arav')
        call SetUnitTimeScale(n,0)
        call UnitAddAbility(l__n,'Arav')
        call SetUnitTimeScale(l__n,0)
else
    if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
        if dist<1000 and IsTerrainPathable(GetUnitX(c),GetUnitY(c),PATHING_TYPE_FLYABILITY)==false then
            call SaveInteger(h,id,StringHash("dist"),dist+24)
            set r=Atan2(GetUnitY(c)-GetUnitY(u),GetUnitX(c)-GetUnitX(u))
            call SetUnitXY_1(c,GetUnitX(c)+24*Cos(r),GetUnitY(c)+24*Sin(r), false)
            call IssueImmediateOrder(c, "stop")
            if SR(x,y,x1,y1)>30 then
                call SetUnitX(l__n,x+24*Cos(r))
                call SetUnitY(l__n,y+24*Sin(r))
                set n=CreateUnit(GetOwningPlayer(u),0x65303057,x,y,r*bj_RADTODEG+180)
                call UnitApplyTimedLife(n,1,0.30)
                call UnitAddAbility(n,'Arav')
                call SetUnitTimeScale(n,0)
                call UnitAddAbility(l__n,'Arav')
                call SetUnitTimeScale(l__n,0)
            endif
        else
            call KillUnit(l__n)
            call RemoveUnit(l__n)
            call myCustomDamage(u,c,(2+GetUnitAbilityLevel(u,0x4130314E))*GetHeroInt(u,true),false,false,null,null,null)
            call SlowUnit(u,c,0.3,0.3,3,2,false)
            call SetUnitPathing(c,true)
            call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e0NJ',x1,y1,GetRandomReal(0,359)),1,3)
            call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e0NK',x1,y1,GetRandomReal(0,359)),1,6)
            call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e0NI',x1,y1,GetRandomReal(0,359)),1,3)
            call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e0NL',x1,y1,GetRandomReal(0,359)),1,3)
            call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e0NM',x1,y1,GetRandomReal(0,359)),1,3)
            call RemoveSavedHandle(h,id,CasterHash)
            call RemoveSavedHandle(h,id,TargetHash)
            call RemoveSavedHandle(h,id,DummyHash)
            call PauseTimer(t)
            call DestroyTimer(t)
            call FlushChildHashtable(h,id)
        endif
    else
        call KillUnit(l__n)
        call RemoveUnit(l__n)
        call SetUnitPathing(u,true)
        call SetUnitInvulnerable(u,false)
        call PauseUnit(u,false)
        call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
        call PauseTimer(t)
        call DestroyTimer(t)
        call SetUnitVertexColor(u,255,255,255,255)
        call FlushChildHashtable(h,id)
        call SetUnitTimeScale(u,1)
    endif
endif
set c=null
set u=null
set l__n=null
set t=null
endfunction
