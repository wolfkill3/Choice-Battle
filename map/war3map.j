local integer i=0
loop
call TriggerRegisterPlayerChatEvent(t,Player(i),"-rfh",true)
set i=i+1
exitwhen i>=10
endloop
call TriggerAddAction(t,function CastRFH)
call TriggerAddCondition(t,Condition(function CondRFH))
set t=null
endfunction
