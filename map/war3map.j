if time<0.3 then
    if time==0.02 then
        call SetUnitAnimation(LoadUnitHandle(h,GetHandleId(u),SusanoCnst),"spell two")
    endif
    if time==0.28 then
        call PauseUnit(u,false)
        set n=CreateUnit(p,'e0WJ',GetUnitX(u),GetUnitY(u),a*bj_RADTODEG)
        call SaveUnitHandle(h,id,1,n)
