    local integer id_caster= GetHandleId(newCaster)
    local real caster_x= GetUnitX(newCaster)
    local real caster_y= GetUnitY(newCaster)
    local boolean RengokuF_Pass_bool= LoadBoolean(HH, id_caster, RengokuF_Pass)
    if RengokuF_Pass_bool == false then
        set soundplay=CreateSound("Sound\\war3mapImported\\RengokuF.mp3", false, false, true, 12700, 12700, "")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        //call RemoveEffect(AddSpecialEffectTarget("az_coco_t2_2.mdl", newCaster, "origin") , 1.5 , true , CreateTimer())
        
                // set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR96', caster_x, caster_y, 45)
