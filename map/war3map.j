local group g=LoadGroupHandle(h,GetHandleId(u),SH_vg)
call SaveUnitHandle(h,id,0,u)
call GroupRemoveUnit(g,u)
call SetUnitAnimation(u,"Spell Two")
set n=GetRandomUnitFromGroup(g)
call GroupRemoveUnit(g,n)
if n!=null and n!=u and GetUnitTypeId(n)==0x65304F30 then
call UnitAddAbility(n,'A08I')
call SaveUnitHandle(h,id,1,n)
call SaveGroupHandle(h,id,4,CreateGroup())
call SaveReal(h,id,2,GetUnitX(n))
call SaveReal(h,id,3,GetUnitY(n))
call SaveReal(h,id,5,GetUnitFacing(n)*bj_DEGTORAD)
if GetRandomInt(0, 1)==0 then
        set soundplay=SndN(1753) // Sound\Music\mp3Music\VergilF.mp3
else
        set soundplay=SndByPath("Sound\\war3mapImported\\VergilW_Sound"+I2S(GetRandomInt(1,2))+".mp3")
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.01,true,function ThrowSwordCast2)
set n=LoadUnitHandle(h,GetHandleId(u),SH_clone)
if n!=null then
call UnitResetCooldown(n)
call SetUnitState(n,UNIT_STATE_MANA,GetUnitState(n,UNIT_STATE_MAX_MANA))
call IssueImmediateOrder(n,"divineshield")
endif
endif
set u=null
set g=null
set t=null
endfunction
