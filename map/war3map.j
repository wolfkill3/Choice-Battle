function GokaMekkaykuCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local integer i=6
local real f=0
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local group g=LoadGroupHandle(h,id,4)
local real dist=LoadReal(h,id,StringHash("dist"))
local real x1=0
local real y1=0
local integer l__idg=GetHandleId(g)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroInt(u,true)*(1+GetUnitAbilityLevel(u,'A0MU'))+75*GetUnitAbilityLevel(u,'A0MU')
loop
set n=LoadUnitHandle(h,id,i)
set f=GetUnitFacing(n)*bj_DEGTORAD
set x1=GetUnitX(n)
set y1=GetUnitY(n)
exitwhen i>=9
if dist<=1500 then
set x1=x1+30*Cos(f)
set y1=y1+30*Sin(f)
call SetUnitX(n,x1)
call SetUnitY(n,y1)
call GroupEnumUnitsInRange(g,x1,y1,250,Base)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,l__idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitVertexColor(n,255,230,100,100)
else
call RemoveUnit(LoadUnitHandle(h,id,6))
call RemoveUnit(LoadUnitHandle(h,id,7))
call RemoveUnit(LoadUnitHandle(h,id,8))
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
call DestroyTimer(t)
call DestroyGroup(g)
endif
set i=i+1
endloop
call SaveReal(h,id,StringHash("dist"),dist+25)
set u=null
set p=null
set t=null
set g=null
endfunction
function GokaMekkaykuCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)*bj_RADTODEG
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,6,CreateUnit(p,'e0K8',x+80*Cos(a*bj_DEGTORAD),y+80*Sin(a*bj_DEGTORAD),a))
call SaveUnitHandle(h,id,7,CreateUnit(p,'e0K8',x+80*Cos((a+15)*bj_DEGTORAD),y+80*Sin((a+15)*bj_DEGTORAD),a+15))
call SaveUnitHandle(h,id,8,CreateUnit(p,'e0K8',x+80*Cos((a-15)*bj_DEGTORAD),y+80*Sin((a-15)*bj_DEGTORAD),a-15))
call SaveGroupHandle(h,id,4,CreateGroup())
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\KatonMadara.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.03,true,function GokaMekkaykuCast2)
set p=null
set u=null
set t=null
endfunction
function GokaMekkaykuInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function GokaMekkaykuCast)
call TriggerAddCondition(t,Condition(function GokaMekkaykuCond))
set t=null
endfunction
function PowerDownGotenks takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
if GetUnitAbilityLevel(u,'A17A')>0 then
    call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.0003)
endif
if GetUnitAbilityLevel(u,'A17C')>0 then
    call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.0008)
endif
endif
if GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.1>GetUnitState(u,UNIT_STATE_LIFE) or GetUnitState(u,UNIT_STATE_MAX_MANA)*0.04>GetUnitState(u,UNIT_STATE_MANA) or LoadBoolean(HH,GetHandleId(u),SST)==true then
if GetUnitAbilityLevel(u,'A17C')>0 then
call ShowAbility2Timed('GTBB',false,4.95)
call ShowAbility2Timed('A17D',true,5)
endif
call SaveBoolean(HH,GetHandleId(u),SS,false)
call SaveBoolean(HH,GetHandleId(u),SST,false)
call UnitRemoveAbility(u,'A17A')
call UnitRemoveAbility(u,'A17C')
call UnitAddAbility(u,'A179')
call SetUnitAbilityLevel(u,'A178',1)
call UnitMakeAbilityPermanent(u,true,'A179')
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set t=null
set u=null
endfunction
function PowerUpGotenksCond takes nothing returns boolean
return (GetSpellAbilityId()=='GTBS' or GetSpellAbilityId()=='GTBB' or GetSpellAbilityId()=='GTSS' or GetSpellAbilityId()=='GTS3') and udg_B==true
endfunction
function PowerUpGotenksCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local timer tt=CreateTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local player p=GetOwningPlayer(u)
    local real time=LoadReal(h,id,1)
    if time<0.1 then
        call PauseUnit(u,true)
        call SaveReal(h,id,1,time+0.025)
    else
        call PauseUnit(u,false)
        call SetUnitTimeScale(u,1)
        call SetUnitAbilityLevel(u,'A178',LoadInteger(h,id,3)+1)
        if LoadInteger(h,id,3)==1 and GetUnitAbilityLevel(u,'A17A')==0 then //ss
            set EFF=AddSpecialEffect("Yellow--zhendi.mdl", x, y)
            call DestroyEffect(EFF)
            call UnitRemoveAbility(u,'A179')
            call UnitRemoveAbility(u,'A17A')
            call UnitRemoveAbility(u,'A17C')
            call UnitAddAbility(u,'A17A')
            call UnitMakeAbilityPermanent(u,true,'A17A')
            call StartSound(soundStr[90])
        elseif LoadInteger(h,id,3)==2 then //ss3
            call UnitRemoveAbility(u,'A179')
            call UnitRemoveAbility(u,'A17A')
            call UnitRemoveAbility(u,'A17C')
            call UnitAddAbility(u,'A17C')
            call FrozenMinusManaSS3Cast(u)
            set EFF=AddSpecialEffect("Yellow--zhendi.mdl", x, y)
            call DestroyEffect(EFF)
            call ShowAbility2('A17D',false)
            call ShowAbility2('GTBB',true)
            call UnitMakeAbilityPermanent(u,true,'A17C')
            call StartSound(soundStr[90])
        endif
        if LoadInteger(h,id,3)==0 and GetUnitAbilityLevel(u,'A179')==0 then
            call StartSound(soundStr[89])
        endif
        if LoadBoolean(HH,GetHandleId(u),SS)==false then
            call SaveUnitHandle(h,GetHandleId(tt),0,u)
            call SaveBoolean(HH,GetHandleId(u),SS,true)
            call TimerStart(tt,0.1,true,function PowerDownGotenks)
        endif
        if LoadInteger(h,id,3)==0 then
            call SaveBoolean(HH,GetHandleId(u),SST,true)
        endif
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
    endif
    set p=null
    set tt=null
    set u=null
    set t=null
endfunction
function PowerUpGotenksCast takes nothing returns nothing
    local unit u=GetTriggerUnit()
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local player p=GetOwningPlayer(u)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    call SaveUnitHandle(h,id,0,u)
    if (GetSpellAbilityId()=='GTSS' and GetUnitAbilityLevel(u,'A17A')==0) or GetSpellAbilityId()=='GTS3' then
        call ShowAbility2('A17D',false)
        call ShowAbility2Timed('A17D',true,0.025)
        call SaveReal(h,id,1,0.075)
        //call UnitApplyTimedLife(CreateUnit(p,'e0LK',x,y,0),1,0.3)
        call UnitApplyTimedLife(CreateUnit(p,'e0LM',x,y,0),1,0.35)
        elseif GetSpellAbilityId()=='GTBS' or GetSpellAbilityId()=='GTBB' then
        call SaveReal(h,id,1,0.075)
        call SaveInteger(h,id,3,0)
    else
        call ShowAbility2('A17D',false)
        call ShowAbility2Timed('A17D',true,0.02)
        call SaveReal(h,id,1,0.1)
    endif
    if GetSpellAbilityId()=='GTSS' then
        // set soundplay=CreateSound("Sound\\Music\\mp3Music\\trunks ss1.mp3",false,false,true,12700,12700,"")
        call SaveInteger(h,id,3,1)
    elseif GetSpellAbilityId()=='GTS3' then
        // set soundplay=CreateSound("Sound\\Music\\mp3Music\\trunks ss2.mp3",false,false,true,12700,12700,"")
        call SaveInteger(h,id,3,2)
    endif
    call SetUnitTimeScale(u,0.5)
    call TimerStart(t,0.025,true,function PowerUpGotenksCast2)
    set u=null
    set p=null
    set t=null
endfunction
function MissleMoveGalacticDonut2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit l__d=LoadUnitHandle(h,id,2)
local real speed=LoadReal(h,id,4)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)+LoadReal(h,id,3)
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>speed+10 then
set x=x+speed*Cos(a)
set y=y+speed*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
set n=CreateUnit(p,0x65304D32,x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,125)
call UnitApplyTimedLife(n,1,0.5)
else
call myCustomDamage(u,c,GetHeroAgi(u,true)*2,false,false,null,null,null)
call SetControlToUnit(u,c,1, "stun")
call CC_UnitEx( u,c, 0., 4, "root", false, "war3mapImported\\gotenksring.mdx", "chest", 0,0 )
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
call RemoveUnit(l__d)
endif
set p=null
set l__d=null
set c=null
set t=null
set u=null
endfunction
function MissleMoveGalacticDonut takes unit u,unit c,unit l__d,real speed,real angle,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveUnitHandle(h,id,2,l__d)
call SaveReal(h,id,3,angle)
call SaveReal(h,id,4,speed)
call SaveReal(h,id,5,dmg)
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\GalakticDonut.mp3",false,false,true,12700,12700,"")
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Gotenks\\GalakticDonut-jap.mp3",false,false,true,12700,12700,"")
endif
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.02,true,function MissleMoveGalacticDonut2)
set t=null
endfunction
function GalacticDonutCond takes nothing returns boolean
return GetSpellAbilityId()=='A0NV' and udg_B==true
endfunction
function GalacticDonutCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real f=GetUnitFacing(u)
