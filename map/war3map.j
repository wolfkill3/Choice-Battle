// set soundplay=CreateSound("Sound\\Music\\mp3Music\\MisakaR.mp3",false,false,true,12700,12700,"")
// call StartSound(soundplay)
// call KillSoundWhenDone(soundplay)
call TimerStart(t,.15,true,function LightningBarrierCast2)
set p=null
set u=null
set t=null
endfunction
function IronSand2Cond takes nothing returns boolean
return GetSpellAbilityId()=='A0RN' and udg_B
endfunction
function IronSand2Cast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local group g=LoadGroupHandle(h,id,5)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real x2
local real y2
local real f=GetUnitFacing(l__d)
local real a=Atan2(y-y1,x-x1)
local real a2
local player p=GetOwningPlayer(u)
local real dmg2=LoadReal(h,id,10)
local real dmg=GetHeroAgi(u,true)*0.0875+dmg2*0.01
local real lvl=3.0
local boolean b=LoadBoolean(h,id,8)
local real time=LoadReal(h,id,7)
if SR(x,y,x1,y1)>34 then
call SetUnitX(l__d,x1+31*Cos(a))
call SetUnitY(l__d,y1+31*Sin(a))
elseif SR(x,y,x1,y1)<34 and time<lvl then
if b==false then
        call UnitApplyTimedLife(CreateUnit(p,'e0PZ',x,y,a*bj_RADTODEG),1,lvl)
        call UnitApplyTimedLife(CreateUnit(p,'e0Q0',x,y,a*bj_RADTODEG),1,lvl)
        call SaveBoolean(h,id,8,true)
        call SetUnitScale(l__d,1.5,1.5,1.5)
        set soundplay=CreateSound("Sound\\war3mapImported\\Misaka E2.mp3", false, false, true, 12700, 12700, "")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
endif
call GroupEnumUnitsInRange(G,x1,y1,350,Base)
set n=CreateUnit(p,'e08J',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'B001',0.5)
call SetUnitTimeScale(n,1.5)
call SetUnitVertexColor(n,0,0,0,125)
call SaveReal(h,id,7,time+0.05)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
set x2=GetUnitX(E)
set y2=GetUnitY(E)
set a2=Atan2(y2-y1,x2-x1)+1.35
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(u,E,0.11, "silenceTE")
call SetUnitX(E,x2-19*Cos(a2))
call SetUnitY(E,y2-19*Sin(a2))
call SetUnitX(E,GetUnitX(E)+10*Cos(AU(E, l__d)))
call SetUnitY(E,GetUnitY(E)+10*Sin(AU(E, l__d)))
//call IssueImmediateOrder(E,"stop")
if GetUnitFlyHeight(E)<500 then
call SetUnitFlyHeight(E,GetUnitFlyHeight(E)+1.3,0)
endif
if IsUnitInGroup(E,g)==false then
call UnitAddAbility(E,'Arav')
call UnitRemoveAbility(E,'Arav')
call GroupAddUnit(g,E)
call SetUnitPathing(E,false)
endif
endif
call GroupRemoveUnit(G,E)
endloop
elseif time>lvl then
loop
set E=FirstOfGroup(g)
exitwhen E==null
call SetUnitFlyHeight(E,0,GetUnitFlyHeight(E))
call GroupRemoveUnit(g,E)
call SetUnitPathing(E,true)
endloop
call FlushChildHashtable(h,id)
call DestroyTimer(t)
call DestroyGroup(g)
call RemoveUnit(l__d)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function IronSand2Cast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
set n=CreateUnit(GetOwningPlayer(u),'e0PZ',x+80*Cos(a),y+80*Sin(a),f)
call SetUnitScale(n,0.5,0.5,0.5)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,n)
call SaveReal(h,id,2,GetSpellTargetX())
call SaveReal(h,id,3,GetSpellTargetY())
call SaveReal(h,id,5,a)
call SaveGroupHandle(h,id,5,CreateGroup())
call SaveReal(h,id,7,0)
call SaveBoolean(h,id,8,false)
call SaveReal(h,id,10,0)
if GetUnitAbilityLevel(u,0x42303541)>0 then
        call SaveReal(h,id,10,GetHeroInt(u,true)*2)
        set soundplay=CreateSound("Sound\\war3mapImported\\Misaka EF.mp3", false, false, true, 12700, 12700, "")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
else
        set soundplay=CreateSound("Sound\\war3mapImported\\Misaka E1.mp3", false, false, true, 12700, 12700, "")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
endif
// set soundplay=CreateSound("Sound\\Music\\mp3Music\\IronSand.mp3",false,false,true,12700,12700,"")
// call StartSound(soundplay)
// call KillSoundWhenDone(soundplay)
call TimerStart(t,0.05,true,function IronSand2Cast2)
set u=null
set t=null
set d=null
endfunction
