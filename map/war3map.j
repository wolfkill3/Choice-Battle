call GroupAddUnit(udg_CG[2],u[i+1])
endif
else
call GroupAddUnit(udg_CG[4],u[i+1])
endif
endif
call TriggerSleepAction(0.5)
exitwhen u[i+1]!=null
endloop
endif
set i=i+1
