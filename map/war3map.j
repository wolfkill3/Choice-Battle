endfunction
function OverMutePeriodic takes nothing returns nothing
        local integer id=GetHandleId(GetExpiredTimer())
        local force f=CreateForce()
        call ForceAddPlayer(f, Player(0))
        call ForceAddPlayer(f, Player(1))
        call ForceAddPlayer(f, Player(2))
        call ForceAddPlayer(f, Player(3))
        call ForceAddPlayer(f, Player(4))
        call ForceAddPlayer(f, Player(5))
        call ForceAddPlayer(f, Player(6))
        call ForceAddPlayer(f, Player(7))
        call ForceAddPlayer(f, Player(8))
        call ForceAddPlayer(f, Player(9))
        if IsPlayerInForce(GetLocalPlayer(),f) then
                call EnableUserControl(true)
        endif
        call DestroyForce(f)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
        set f=null
endfunction
function OverMuteAct takes nothing returns nothing
local integer ip=GetPlayerId(GetTriggerPlayer())
local integer id=GetHandleId(Hero[ip])
local integer p = S2I(SubString(GetEventPlayerChatString(), 10, 12))-1
local timer newTimer=null
local force f=CreateForce()
call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "Player: "+I2S(p))
call ForceAddPlayer(f, Player(p))
if p>=0 and p<10 then
        if IsPlayerInForce(GetLocalPlayer(),f) then
                call EnableUserControl(false)
        endif
        set newTimer=CreateTimer()
        call SavePlayerHandle(h, GetHandleId(newTimer), SH_Player, Player(p))
        call TimerStart(newTimer, 15, false, function OverMutePeriodic)
        call DisplayTextToPlayer(Player(p),0,0, Lng("Вы получили overall mute на 15 секунд.","You have received an overall mute for 15 seconds."))
endif
call DestroyForce(f)
set newTimer=null
set f=null
endfunction
function OverUnmuteAct takes nothing returns nothing 
        call EnableUserControl(true)
endfunction
