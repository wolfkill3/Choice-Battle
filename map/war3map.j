    call IssueImmediateOrder(u, "bearform")
    call UnitRemoveAbility(u, 'S171')
endif
if GetUnitTypeId(u) == 'H01E' then
    call UnitAddAbility(u, 'S181')
    call IssueImmediateOrder(u, "bearform")
    call UnitRemoveAbility(u, 'S181')
endif
