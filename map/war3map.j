local real d2=Angle2(GetUnitX(LoadUnitHandle(HH,id,1)),GetUnitY(LoadUnitHandle(HH,id,1)),GetLocationX(LoadLocationHandle(HH,id,7)),GetLocationY(LoadLocationHandle(HH,id,7)))
