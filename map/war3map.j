function GatlingGunCond takes nothing returns boolean
return GetSpellAbilityId()=='A0RX'
endfunction
function Slash_GatlingGun2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local player p=GetOwningPlayer(l__d)
local unit u=Hero[GetPlayerId(p)]
local real speed=LoadReal(h,id,1)
local real x=LoadReal(h,id,3)
local real y=LoadReal(h,id,4)
local group g=LoadGroupHandle(h,id,5)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,2)
local real dmg=LoadReal(h,id,6)
local real Range=LoadReal(h,id,9)
if SR(x,y,x1,y1)<=Range then
call SetUnitXY_1(l__d,x1+speed*Cos(a),y1+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call GroupEnumUnitsInRange(g,x1,y1,LoadReal(h,id,10),Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetUnitX(E,GetUnitX(E)+17*Cos(a))
call SetUnitY(E,GetUnitY(E)+17*Sin(a))
call SetControlToUnit(E,E, 0.12, "stun")
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
else
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,GetHandleId(g))
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function Slash_GatlingGun takes unit l__d,real speed,real dmg,real angle,real range,real mas,real x,real y,real x1,real y1 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle)
call SaveGroupHandle(h,id,5,CreateGroup())
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,6,dmg)
call SaveReal(h,id,9,range)
call SaveReal(h,id,10,mas)
call TimerStart(t,0.025,true,function Slash_GatlingGun2)
set t=null
endfunction
function GatlingGunCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local real x2
local real y2
local real he
local real r
local real r2=GetRandomReal(-50,50)
local real angle=(GetUnitFacing(u)+90)*bj_DEGTORAD
local real a=Atan2(y1-y,x1-x)
local real a2=GetRandomReal(-0.5,0.5)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroAgi(u,true)*(0.3+0.1*GetUnitAbilityLevel(u,'A0RX'))
if GetUnitCurrentOrder(u)==OrderId("channel")then
if GetUnitAbilityLevel(u,'LuG3')==0 then
set r=GetRandomReal(-135,135)
set x2=x+r*Cos(a+deg90)
set y2=y+r*Sin(a+deg90)
set n=CreateUnit(p,'e0H9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.7)
call SetUnitVertexColor(n,200,200,200,70)
set n=CreateUnit(p,'e0QD',x2,y2,(a)*bj_RADTODEG)
call SetUnitFlyHeight(n,GetRandomReal(45,110),0)
call Slash_GatlingGun(n,65,dmg,(a),GetRandomReal(900,1200),50,x2,y2,x1,y1)
else
set r=GetRandomReal(-135,135)
set x2=x+r*Cos(a+deg90)
set y2=y+r*Sin(a+deg90)
set n=CreateUnit(p,'e0QD',x2,y2,(a+a2)*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,0)
set he=GetRandomReal(45,110)
call SetUnitFlyHeight(n,he,0)
call Slash_GatlingGun(n,85,dmg*1.25,(a+a2),800,80,x2,y2,x1,y1)
set n=CreateUnit(p,'e0QE',x2,y2,(a+a2)*bj_RADTODEG)
call UnitApplyTimedLife(n,0,0.35)
call SetUnitTimeScale(n,2.5)
call SetUnitFlyHeight(n,he,0)
set x2=x+50*Cos(a)
set y2=y+50*Sin(a)
set n=CreateUnit(p,'e043',x2+r2*Cos(a+deg90),y2+r2*Sin(a+deg90),(a+a2)*bj_RADTODEG)
call UnitApplyTimedLife(n,1,0.40)
endif
else
call SetUnitInvulnerable(u,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set t=null
endfunction
function GatlingGunCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real f=Atan2(y1-y,x1-x)
call SaveUnitHandle(h,id,0,u)
call SetUnitInvulnerable(u,true)
call SaveReal(h,id,2,x1)
call SaveReal(h,id,3,y1)
if GetUnitAbilityLevel(u,'LuG3')==0 then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\LuffyGatling.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Gomu Gomu No Elephant Gatling.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
call TimerStart(t,0.03,true,function GatlingGunCast2)
set u=null
set t=null
endfunction
function InitTrig_GatlingGun takes nothing returns nothing
set gg_trg_GatlingGun=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_GatlingGun,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_GatlingGun,Condition(function GatlingGunCond))
call TriggerAddAction(gg_trg_GatlingGun,function GatlingGunCast)
endfunction
function HakiCond takes nothing returns boolean
return GetSpellAbilityId()==0x41305257
endfunction
function HakiCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local group g=LoadGroupHandle(h,id,1)
local integer idu=GetHandleId(u)
local integer i=1
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local real dist
local integer l__idg=GetHandleId(g)
local real f
local player p=GetOwningPlayer(u)
local integer l__ide
local integer po=GetHeroAgi(u,true)+GetHeroInt(u,true)+GetHeroStr(u,true)
loop
exitwhen i>15
set dist=LoadReal(h,id,StringHash("dist"+I2S(i)))+200
call SaveReal(h,id,StringHash("dist"+I2S(i)),dist)
set f=(24*i)*bj_DEGTORAD
set i=i+1
endloop
call GroupEnumUnitsInRange(g,x,y,dist,Base)
loop
set E=FirstOfGroup(g)
set l__ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,l__ide)then
	call IssueImmediateOrder(E, "stop")
    call SaveUnitHandle(h,l__idg,l__ide,E)
	if IsUnitInvulnerable(E)==false then
	    call SetControlToUnit(E,E,4,"sleep")
		call SetUnitAnimation(E,"Death")
	endif
	call SetControlToUnit(E,E,3,"silenceTE")
	call SetUnitState(E,UNIT_STATE_MANA,GetWidgetMana(E)-GetUnitState(E,UNIT_STATE_MAX_MANA)*0.13)
endif
call GroupRemoveUnit(g,E)
endloop
call PauseUnit(u,true)
if dist>=1000 then
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
set u=null
set g=null
set t=null
set p=null
endfunction
function HakiCast takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=0
local real y1=0
local real sc
local real dmg=0
local integer idu=GetHandleId(u)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveGroupHandle(h,id,1,CreateGroup())
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
set n=CreateUnit(p,'e0ON',x,y,0)
call SetUnitVertexColor(n,125,175,255,255)
call UnitApplyTimedLife(n,1,1)
call UnitScale(n,0.01,2.6,1)
set n=CreateUnit(p,'e0ON',x,y,0)
call SetUnitVertexColor(n,125,175,255,255)
call UnitApplyTimedLife(n,1,1)
call UnitScale(n,0.01,2.6,1)
set n=CreateUnit(p,'e0ON',x,y,0)
call SetUnitVertexColor(n,125,175,255,255)
call UnitApplyTimedLife(n,1,1)
