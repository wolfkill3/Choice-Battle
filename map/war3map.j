call SetUnitVertexColor(n,100,100,255,255)
call SaveUnitHandle(h,id,9,n)
set n=CreateUnit(p,'kaT7',x+500*Cos(a),y+500*Sin(a),a*bj_RADTODEG+180)
call SaveUnitHandle(h,id,13,n)
call SaveGroupHandle(h,id,20,g)
