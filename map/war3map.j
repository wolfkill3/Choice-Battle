function OrochimaruF3Cast takes nothing returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local unit u=GetDyingUnit()
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local player p=GetOwningPlayer(u)
    local real f=GetUnitFacing(u)
    if GetHeroLevel(u)>5 then
        set n=CreateUnit(p,'or01',x,y,f)
        call SetUnitAbilityLevel(n,'OM16',GetHeroLevel(u)/5)
        call SetUnitScaleTimed(n,0.01,2,1)
        call SetUnitBaseDamageByIndex(n,0,100+GetHeroInt(u,true))
        call SetUnitMoveSpeed(n,300+GetHeroLevel(u)*15)
        call SetUnitMaxLife(n,3400+GetHeroLevel(u)*80)
        call SaveUnitHandle(h,id,0,n)
        call SetUnitInvulnerable(n,true)
        call UnitApplyTimedLife(n,'BTLF',30)
        if p==GetLocalPlayer()then
        call ClearSelection()
        call SelectUnit(n,true)
        endif
        call TimerStart(t,1.0,false,function OrochimaruF3Cast12)
        call SetUnitTimeScale(n,1.5)
    endif
    set t=null
    set u=null
    set p=null
endfunction
function InitTrig_OrochimaruF3 takes nothing returns nothing
