    call ShowFrame( OpenIdButtonText, true )
    call SetFrameRelativePoint( OpenIdButtonText, FRAMEPOINT_CENTER, OpenIdButton, FRAMEPOINT_CENTER, .00011, .0 )

    set tOnPress = CreateTrigger( )
    set tOnUnPress = CreateTrigger( )
    set tOnClick = CreateTrigger( )       
