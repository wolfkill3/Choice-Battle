function OrochimaruRCast takes nothing returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local unit u=GetTriggerUnit()
    local player p=GetOwningPlayer(u)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetSpellTargetX()
    local real y1=GetSpellTargetY()
    local real a=Atan2(y1-y,x1-x)
    local integer i=0
    call SaveUnitHandle(h,id,0,u)
    call SaveReal(h,id,1,x1)
    call SaveReal(h,id,2,y1)
    set n=CreateUnit(p,'or15',x+75*Cos(a),y+75*Sin(a),0)
    call SetUnitTimeScale(n,1)
    call UnitApplyTimedLife(n,'BTLF',0.01)
    call PauseUnit(u,true)
    call SetUnitAnimationByIndex(u,5)
    set soundplay=SndN(4795) // Sound\Music\mp3Music\OrochimaruR.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call TimerStart(t,0.3,false,function OrochimaruRCast2)
    set p=null
    set t=null
    set u=null
endfunction
function InitTrig_OrochimaruR takes nothing returns nothing
    set gg_trg_OrochimaruR=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_OrochimaruR,EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_OrochimaruR,Condition(function OrochimaruRCond))
    call TriggerAddAction(gg_trg_OrochimaruR,function OrochimaruRCast)
endfunction
function OrochimaruTCond takes nothing returns boolean
    return GetSpellAbilityId()=='OM11'
endfunction
function KillGroupOrochimaru takes nothing returns nothing
    set E=GetEnumUnit()
    call KillUnit(E)
    if GetUnitTypeId(E)=='orT4' then
    call SetUnitTimeScale(E,-1)
    endif
endfunction
function OrochimaruTCast9 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit hashic=LoadUnitHandle(h,id,16)
    local unit tobic=LoadUnitHandle(h,id,15)
    local player p=GetOwningPlayer(u)
    local real x=LoadReal(h,id,1)
    local real y=LoadReal(h,id,2)
    local real x1=LoadReal(h,id,3)
    local real y1=LoadReal(h,id,4)
    local real x2=GetUnitX(hashic)
    local real y2=GetUnitY(hashic)
    local real x3=GetUnitX(tobic)
    local real y3=GetUnitY(tobic)
    local real he=GetUnitFlyHeight(tobic)
    local real he2=GetUnitFlyHeight(hashic)
    local real rg=550
    local real a2=Atan2(y1-y2,x1-x2)
    local real a3=Atan2(y1-y3,x1-x3)
    local group g=LoadGroupHandle(h,id,6)
    local integer i=1
    local real a=LoadReal(h,id,5)
    local real time=LoadReal(h,id,13)
    local integer l__s=SH_block
    call RemoveUnit(hashic)
    call RemoveUnit(tobic)
    set E=LoadUnitHandle(h,id,10)
    set n=CreateUnit(p,0x6F723334,GetUnitX(E),GetUnitY(E),GetUnitFacing(E))
    call UnitApplyTimedLife(n,'BTLF',2)
    call SetUnitTimeScale(n,0.3)
    call RemoveUnit(E)
    set E=LoadUnitHandle(h,id,11)
    set n=CreateUnit(p,0x6F723334,GetUnitX(E),GetUnitY(E),GetUnitFacing(E))
    call UnitApplyTimedLife(n,'BTLF',2)
    call SetUnitTimeScale(n,0.3)
    call RemoveUnit(E)
    call ForGroup(g,function KillGroupOrochimaru)
    loop
    exitwhen i>=61
    call RemoveDestructable(LoadDestructableHandle(h,id,l__s+i))
    set i=i+1
    endloop
    call DestroyGroup(g)
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(h,id)
    set hashic=null
    set tobic=null
    set p=null
    set u=null
    set t=null
    set g=null
endfunction
function OrochimaruTCast8 takes nothing returns nothing
    local timer t=GetExpiredTimer()
