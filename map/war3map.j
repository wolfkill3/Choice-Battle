function HramCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local integer idu=GetHandleId(u)
local player p=GetOwningPlayer(u)
if LoadBoolean(h,idu,StringHash("hramb"))!=true then
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,3,0)
call SaveReal(h,id,4,0)
call SaveReal(h,id,5,0)
call SaveReal(h,id,7,x)
call SaveReal(h,id,8,y)
call SaveReal(h,idu,StringHash("hramx"),x)
call SaveReal(h,idu,StringHash("hramy"),y)
call SaveBoolean(h,idu,StringHash("hramb"),true)
call SaveInteger(h,id,14,0)
call UnitAddAbility(u,'Arav')
call UnitAddAbility(u,'A0QL')
call UnitMakeAbilityPermanent(u,true,'A0QL')
call UnitRemoveAbility(u,'Arav')
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
set n=LoadUnitHandle(HH,GetHandleId(u),StringHash("tama"))
call UnitAddAbility(n,'A1AV')
call UnitRemoveAbility(n,'A0A1')
call SetUnitX(n,x)
call SetUnitY(n,y)
call SetUnitAnimation(n,"stand channel")
call SetUnitFlyHeight(n,1000,1000)
set n=CreateUnit(p,'e10Y',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,25)
call SetUnitTimeScale(n,0.5)
call SetUnitFlyHeight(n,150,0)
call SetUnitScale(n,1.5,1.5,1.5)
call UnitApplyTimedLife(n,1,3)
set n=CreateUnit(p,'e0RV',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,155)
call SetUnitTimeScale(n,0.02)
call SetUnitFlyHeight(n,-175,0)
call SetUnitScale(n,4,4,4)
call UnitApplyTimedLife(n,1,30)
set n=CreateUnit(p,'e10Y',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,25)
call SetUnitTimeScale(n,0.5)
call SetUnitFlyHeight(n,100,0)
call SetUnitScale(n,2.5,2.5,2.5)
call UnitApplyTimedLife(n,1,3)
set n=CreateUnit(p,'e10Y',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,25)
call SetUnitTimeScale(n,0.5)
call SetUnitFlyHeight(n,50,0)
call SetUnitScale(n,3.5,3.5,3.5)
call UnitApplyTimedLife(n,1,3)
set n=CreateUnit(p,'e10S',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,3)
set n=CreateUnit(p,'e10T',x,y,GetRandomReal(0,359))
call SetUnitTimeScale(n,0.25)
call UnitApplyTimedLife(n,1,26.5)
call SaveUnitHandle(h,idu,StringHash("hramd"),n)
call SaveGroupHandle(h,id,6,CreateGroup())
call SaveGroupHandle(h,id,12,CreateGroup())
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Tamamo Noble Phantasm.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.05,true,function HramCast2)
else
call DestroyTimer(t)
endif
set p=null
set u=null
set t=null
endfunction
