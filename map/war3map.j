function WitchHuntCond takes nothing returns boolean
return GetSpellAbilityId()=='A0L6'
endfunction
function WitchHuntCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local unit d1=LoadUnitHandle(h,id,6)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local group g=LoadGroupHandle(h,id,4)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,5)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroInt(u,true)*(4+GetUnitAbilityLevel(u,'A0L6'))
if SR(x,y,x1,y1)<=2000 then
set x1=x1+59*Cos(a)
set y1=y1+59*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
call SetUnitX(d1,x1)
call SetUnitY(d1,y1)
call GroupEnumUnitsInRange(g,x1,y1,250,Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
if GetUnitAbilityLevel(E,'B03I')==0 then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
else
call myCustomDamage(u,E,dmg*1.2,false,false,null,null,null)
endif
call SetControlToUnit(E,E, 2, "stun")
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
call UnitApplyTimedLife(CreateUnit(p,'e0GR',x1,y1,a*bj_RADTODEG),'BTLF',0.3)
call UnitApplyTimedLife(CreateUnit(p,'e0GS',x1,y1,a*bj_RADTODEG),'BTLF',0.3)
call UnitApplyTimedLife(CreateUnit(p,'e0GQ',x1,y1,a*bj_RADTODEG),'BTLF',0.5)
else
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,GetHandleId(g))
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
call RemoveUnit(l__d)
call RemoveUnit(d1)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
set d1=null
endfunction
