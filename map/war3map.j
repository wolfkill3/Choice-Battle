        if GetUnitTypeId(u)=='H074' then
            set oreha=u
        endif
        if GetUnitTypeId(u)=='H02H' then
            set Goku=u
        endif
        set nowpick=1
        if FFAMode==false then
            if GetHeroLevel(u)==1 then
                call SetHeroLevel(u,(round*3)+2,true)
            endif
        else
            if GetHeroLevel(u)==1 then
                call SetHeroLevel(u,(round*3)+8,true)
            endif
        endif
        call SaveGroupHandle(h,id,StringHash("SpellGroup"),CreateGroup())
        call SetUnitTurnSpeed(u,2)
        call SaveInteger(h,GetHandleId(u),StringHash("expl"),0)
        call RemoveUnitFromAllStock(GetUnitTypeId(u))
        if GetUnitTypeId(u)=='H04A' then
            set Gon=u
        endif
        if GetUnitTypeId(u)=='H02L' then
            set Broly=u
        endif
        if udg_RM==false then
            set i=0
            call GroupAddUnit(lrg,u)
            loop
                if GetUnitTypeId(u)==udg_RH[i] then
                    set udg_RH[i]=0
                endif
                set i=i+1
                exitwhen i>=135
            endloop
        endif
        call SaveInteger(h,GetHandleId(u),'A1GS',0)
        if pick==1 or pick==2 then
        set soundplay=CreateSound("Voice\\"+InitVoice(ty),false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        else
        set soundplay=CreateSound("Voice\\"+InitVoice(ty),false,false,true,12700,12700,"")
        if GetLocalPlayer()==p then
        call StartSound(soundplay)
        endif
        call KillSoundWhenDone(soundplay)
        endif
    endif
