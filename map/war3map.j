call SetUnitAnimation(u,"Spell four")
call Push3(n,7,a,200,"null")
call ShakeCamera(0.5,20)
call SetUnitTimeScale(n,0.5)
set n=CreateUnit(p,'e0RQ',x1+100*Cos(a),y1+100*Sin(a),(a*bj_RADTODEG))
call UnitApplyTimedLife(n,'BTLF',6)
call Push3(n,7,a,200,"null")
call SetUnitTimeScale(n,0.5)
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.2,1.2,1.2)
call SetUnitTimeScale(n,0.6)
call SetUnitVertexColor(n,255,230,100,50)
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitTimeScale(n,0.6)
call SetUnitVertexColor(n,255,230,100,50)
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.7,1.7,1.7)
call SetUnitTimeScale(n,0.6)
call SetUnitVertexColor(n,255,230,100,50)
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.9,1.9,1.9)
call SetUnitTimeScale(n,0.6)
call SetUnitVertexColor(n,255,230,100,50)
call UnitApplyTimedLife(CreateUnit(p,'e0C7',x1,y1,(a*bj_RADTODEG)),'BTLF',6)
call myCustomDamage(u,c,GetUnitState(c,UNIT_STATE_MAX_MANA)*0.8,false,false,null,null,null)
call FrozenMinusManaCast(c,7)
call SetUnitState(c,UNIT_STATE_MANA,GetUnitState(c,UNIT_STATE_MANA)-GetUnitState(c,UNIT_STATE_MAX_MANA)*0.35)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call PauseTimer(t)
call DestroyTimer(t)
call SaveReal(h,id,6,0)
call FlushChildHashtable(h,id)
endif
set p=null
set t=null
set u=null
set c=null
endfunction
