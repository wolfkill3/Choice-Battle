if u==c then
set x=x+155*Cos(a)
set y=y+155*Sin(a)
call SaveUnitHandle(h,id,2,CreateUnit(p,'e0G4',x,y,a*bj_RADTODEG))
set a=Atan2(y1-y,x1-x)
set n=CreateUnit(p,'e145',x,y,a*bj_RADTODEG)
