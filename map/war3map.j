function FKazumaCond takes nothing returns boolean
return GetSpellAbilityId()=='Ao7V'
endfunction
function FKazumaCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit c=LoadUnitHandle(HH,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local real time=LoadReal(HH,id,2)
local player p=GetOwningPlayer(u)
local integer i=0
local integer l__s=0
if IsUnitHidden(c)==false and GetUnitAbilityLevel(c,'cbc9')==0 then
    call SaveReal(HH,id,2,time + 0.05)
endif
if udg_B==false then
    call SaveReal(HH,id,2,time + 3)
endif
if time > 10 then
    call RemoveItem(UnitItemInSlot(c, LoadInteger(HH, id, SH_StolenItemSlot)))
    if UnitIsAlive(c) and LoadBoolean(HH,id,13)==true then
        if GetUnitAbilityLevel(c,'cbc5')>0 then
            call EnableUnitAbility2(c,'AInv',false,true)
        endif
        //call BJDebugMsg("Item returned: " + I2S(LoadInteger(HH, id, StringHash("BrokenItemId"))) + ", slot: " + I2S(LoadInteger(h, id, StringHash("BrokenItemSlot"))))
        if IsUnitPaused(c)==false then
            call UnitAddItemToSlotById(c, LoadInteger(HH, id, SH_StolenItemId), LoadInteger(HH, id, SH_StolenItemSlot))
        else
            call PauseUnit(c,false)
            call UnitAddItemToSlotById(c, LoadInteger(HH, id, SH_StolenItemId), LoadInteger(HH, id, SH_StolenItemSlot))
            call PauseUnit(c,true)
        endif
        if GetUnitAbilityLevel(c,'cbc5')>0 then
            call DisableUnitAbility2(c,'AInv',false,true)
        endif
        call FlushChildHashtable(HH, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    call CheckUnitBonusRange(c)
endif
set p=null
set c=null
set u=null
set t=null
endfunction
function FKazumaCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit c=LoadUnitHandle(HH,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local real time=LoadReal(HH,id,2)-0.1
local player p=GetOwningPlayer(u)
local integer i=0
local integer l__s=0
local integer ls=0
local integer item_id= 0
local integer max_iteration= 30
local integer random_slot= 0
if SR(x,y,x1,y1)<1400 and IsUnitHidden(c)==false then
    if time>0 then
        call SaveReal(HH,id,2,time)
        call SetUnitFacing(u,a*bj_RADTODEG)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Invisibility\\InvisibilityTarget.mdl",u,"right hand"))
        call EffectToRandomBone("war3mapImported\\Spear.mdx",c)
        call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Fuzets By Deckai.mdx",u,"right hand"))
        set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
        call SetUnitVertexColor(n,155,200,255,75)
        call SetUnitTimeScale(n,2)
        call SetUnitScale(n,0.5,0.5,0.5)
        call UnitApplyTimedLife(n,'BTLF',1)
        set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
        call SetUnitVertexColor(n,155,200,255,75)
        call SetUnitTimeScale(n,2)
        call SetUnitScale(n,0.75,0.75,0.75)
        call UnitApplyTimedLife(n,'BTLF',1)
        set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
        call SetUnitVertexColor(n,155,200,255,75)
        call SetUnitTimeScale(n,2)
        call SetUnitScale(n,1,1,1)
        call UnitApplyTimedLife(n,'BTLF',1)
    else
        call PauseUnit(u,false)
        call SetUnitInvulnerable(u,false)
        if IsUnitType(c, UNIT_TYPE_HERO) and IsUnitIllusion(c)==false and GetUnitTypeId(c)!='H007' and GetUnitTypeId(c)!='Ho13' and GetUnitTypeId(c)!='H34X' and GetUnitTypeId(c)!='H14F' then
            call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Blue Spark by Deckai2.mdx",c,"chest"))
            call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\ArcaneExplosion_Blue.mdx",c,"chest"))
            call ShowAbility2('Ao7V',false)
            call ShowAbility2Timed('Ao7V',true,10.1)
            if GetUnitTypeId(c)=='H00Q' then
                set c=Hero[GetPlayerId(GetOwningPlayer(c))]
                call SaveUnitHandle(HH,id,1,c)
            endif
            loop
            exitwhen max_iteration <= 0
                set max_iteration=max_iteration - 1
                set random_slot=GetRandomInt(0, 5)
                if GetItemTypeId(UnitItemInSlot(c, random_slot)) != 0 and AlbedoBreakCond(c, random_slot) then
                    set item_id=GetItemTypeId(UnitItemInSlot(c, random_slot))
                    call FKazumaList(u,item_id)
                    if UnitIsAlive(c)==true then
                        call RemoveItem(UnitItemInSlot(c, random_slot))
                        call SaveBoolean(HH,id,13,true)
                    else
                        call SaveBoolean(HH,id,13,false)
                    endif
                    set max_iteration=0
                endif
            endloop
            if item_id != 0 and UnitIsAlive(c)==true then
                if GetUnitAbilityLevel(c,'cbc5')>0 then
                    call EnableUnitAbility2(c,'AInv',false,true)
                endif
                if IsUnitPaused(c)==false then
                    call UnitAddItemToSlotById(c, 'Istl', random_slot)
                else
                    call PauseUnit(c,false)
                    call UnitAddItemToSlotById(c, 'Istl', random_slot)
                    call PauseUnit(c,true)
                endif
                if GetUnitAbilityLevel(c,'cbc5')>0 then
                    call DisableUnitAbility2(c,'AInv',false,true)
                endif
                set bj_lastCreatedItem = UnitItemInSlot(c, random_slot)
                call SetItemDroppable(bj_lastCreatedItem,false)
                call SaveItemHandle(HH, id, SH_StolenItem, bj_lastCreatedItem)
                call SaveInteger(HH, id, SH_StolenItemSlot, random_slot)
                call SaveInteger(HH, id, SH_StolenItemId, item_id)
                call SaveReal(HH,id,2,0)
                call TimerStart(t,0.05,true,function FKazumaCast3)
                else
                call DestroyTimer(t)
                call FlushChildHashtable(HH,id)
            endif
        else
            call DestroyTimer(t)
            call FlushChildHashtable(HH,id)
        endif
    endif
else
    call SetUnitInvulnerable(u,false)
    call PauseUnit(u,false)
    call DestroyTimer(t)
    call FlushChildHashtable(HH,id)
endif
set p=null
set c=null
set u=null
set t=null
endfunction
function FKazumaCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
call SaveUnitHandle(HH,id,0,u)
call SaveUnitHandle(HH,id,1,c)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SetUnitAnimation(u,"Spell Four")
call SetUnitTimeScale(u,0.05)
set n=CreateUnit(p,'eo8A',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1)
set n=CreateUnit(p,'eo0N',x,y,a*bj_RADTODEG-45)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'eo0N',x,y,a*bj_RADTODEG+45)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'eo0N',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set soundplay=SndN(3071) // Sound\Music\mp3Music\KazumaF.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SaveReal(HH,id,2,1.5)
call SetUnitTimeScale(u,1)
call SetUnitAnimationByIndex(u,3)
call TimerStart(t,0.1,true,function FKazumaCast2)
set u=null
set t=null
set c=null
set p=null
endfunction
function InitTrig_FKazuma takes nothing returns nothing
set gg_trg_FKazuma=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_FKazuma,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_FKazuma,Condition(function FKazumaCond))
call TriggerAddAction(gg_trg_FKazuma,function FKazumaCast)
endfunction
