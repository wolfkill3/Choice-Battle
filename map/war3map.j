function KireiQMissles2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local unit u=LoadUnitHandle(h,id,11)
local real speed=LoadReal(h,id,1)
local real sm=LoadReal(h,id,9)
local real dmg=LoadReal(h,id,10)
local real f=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real a=LoadReal(h,id,5)
local real dist=LoadReal(h,id,7)
local player p=GetOwningPlayer(u)
if dist>speed and UnitIsAlive(l__d)then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
if sm>speed then
call SaveReal(h,id,1,speed+speed*0.04)
endif
call GroupEnumUnitsInRange(G,x,y,95,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call EffectToRandomBone("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",E)
if GetUnitAbilityLevel(E,0x416F3634)==0 and LoadBoolean(h,id,13)==false then
call KireiQPush(E,40,a,200)
call UnitAddAbility(E,0x416F3634)
call UnitRemoveAbilityTimed(E,0x416F3634,1)
elseif GetUnitAbilityLevel(E,0x416F3634)!=0 and LoadBoolean(h,id,13)==true then
call SetControlToUnit(E,E, 2, "stun")
endif
call KillUnit(l__d)
endif
call GroupRemoveUnit(G,E)
