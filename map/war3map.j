call SetUnitTimeScale(caster,1)
endif
call EffectCreateAndMove(true,"Madara\\az_siwen.mdl",GetRandomInt(0,360),1.5,2.5,0.3,100,100,100,30,100,caster,0,facing)
call EffectCreateAndMove(true,"Madara\\blue-blink.mdl",GetRandomInt(0,360),1.5,4,0.3,100,100,100,0,0,caster,0,facing)
call MadaraRSlashesh(caster,LoadReal(HH,id,3)+45,3*GetHeroInt(caster,true))
call MadaraRSlashesh(caster,LoadReal(HH,id,3)-45,3*GetHeroInt(caster,true))
call MadaraRSlashesh(caster,LoadReal(HH,id,3)+135,3*GetHeroInt(caster,true))
