if IsUnitAlly(c,p)==false then
call UnitRemoveAbility(c,'Pet1')
call myCustomDamage(u,c,(GetUnitAbilityLevel(u,'A0KX')+3)*GetHeroInt(u,true),false,false,null,null,null)
else
