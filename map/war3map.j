function ArchetypeTChoice_Act takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit caster=GetTriggerUnit()
local real x0=GetUnitX(caster)
local real y0=GetUnitY(caster)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real facing=Angle2(x0,y0,x1,y1)
call SaveUnitHandle(HH,id,1,caster)
call SaveReal(HH,id,11,x0)
call SaveReal(HH,id,12,y0)
call SaveReal(HH,id,3,facing)
if GetRandomInt(1,2)==1 then
set soundplay=SndN(4068) // Sound\Music\mp3Music\ArchetypeT1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
set soundplay=SndN(4070) // Sound\Music\mp3Music\ArchetypeT2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call SetUnitAnimationByIndex(caster,4)
call UnitSpeed(caster,0.5)
call SaveReal(HH,id,15,8*GetHeroStr(caster,true))
call TimerStart(t,0.02,true,function ArchetypeTAct)
set t=null
set caster=null
endfunction

function ArchetypeTChoice_Cond takes nothing returns boolean
if GetSpellAbilityId()=='ArcT' then
return true
else
return false
endif
endfunction


function InitTrig_ArchetypeT takes nothing returns nothing
local trigger ArchetypeTChoice=CreateTrigger()
local integer index
set index=0
loop
call TriggerRegisterPlayerUnitEvent(ArchetypeTChoice,Player(index),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set index=index+1
exitwhen index==bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddCondition(ArchetypeTChoice,Condition(function ArchetypeTChoice_Cond))
call TriggerAddAction(ArchetypeTChoice,function ArchetypeTChoice_Act)
set ArchetypeTChoice=null
set index=0
endfunction




