function PrettySongCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real cof=LoadReal(h,id,5)
local real heal=0.1*GetHeroInt(u,true)*cof+2.5
local sound l__s=LoadSoundHandle(h,id,4)
local player p=GetOwningPlayer(u)
if(OrderId2String(GetUnitCurrentOrder(u))!="channel")or GetUnitState(u,UNIT_STATE_MANA)<20 then
