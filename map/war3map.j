function UroborasCond takes nothing returns boolean
return GetSpellAbilityId()=='A166'
endfunction
function UroborasCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit c=LoadUnitHandle(h,id,0)
local group g=LoadGroupHandle(h,id,1)
local integer i=0
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local real dist
local real dmg=8*GetHeroInt(c,true)
local integer l__idg=GetHandleId(g)
local real f
local player p=GetOwningPlayer(c)
local integer idu
set dist=LoadReal(h,id,SH_dist)+200
call SaveReal(h,id,SH_dist,dist)
loop
exitwhen i>15
set f=24*i
call UnitApplyTimedLife(CreateUnit(p,'e0YM',x+dist*Cos(f*bj_DEGTORAD),y+dist*Sin(f*bj_DEGTORAD),f+GetRandomReal(-90,90)),'BTLF',2)
set i=i+1
endloop
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,0.65,0.65,0.65)
call SetUnitVertexColor(n,0,0,0,100)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,0,0,0,100)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitVertexColor(n,0,0,0,100)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,2,2,2)
call SetUnitVertexColor(n,0,0,0,100)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,2.5,2.5,2.5)
call SetUnitVertexColor(n,0,0,0,100)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,3,3,3)
call SetUnitVertexColor(n,0,0,0,100)
call GroupEnumUnitsInRange(g,x,y,dist,Base)
loop
set E=FirstOfGroup(g)
set idu=GetHandleId(E)
if IsUnitEnemy(E,p)and E!=LoadUnitHandle(h,l__idg,idu)and IsUnitType(E,UNIT_TYPE_STRUCTURE)==false then
call myCustomDamage(c,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,l__idg,idu,E)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
if dist>=1000 then
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
set c=null
set g=null
set t=null
set p=null
endfunction
function UroborasCast takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveReal(h,id,2,GetUnitX(u))
call SaveReal(h,id,3,GetUnitY(u))
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,1,CreateGroup())
set soundplay=SndN(989) // Sound\Music\mp3Music\ViperF.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,.06,true,function UroborasCast2)
set u=null
set t=null
