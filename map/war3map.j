                        call EffectCreateAndMove1(false,"war3mapImported\\[A]az_axe_ef1.mdl",GetRandomReal(0,360),1,GetRandomReal(0.5,1),GetRandomReal(0.5,0.7),70,70,100,GetRandomInt(10,20),50,0,c,0,LoadReal(HH,id,3))
