function GogetaECast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real a=LoadReal(h,id,11)
local real dist=LoadReal(h,id,2)
local real x=GetUnitX(l__d)+75*Cos(a)
local real y=GetUnitY(l__d)+75*Sin(a)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real dmg=LoadReal(h,id,4)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,12)
local real s1=LoadReal(h,id,10)
local real time=LoadReal(h,id,15)
local integer i=-8
if dist>0 and IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false and UnitIsAlive(l__d)then
if time<9 then
call SaveReal(h,id,15,time+1)
else
loop
    set EFF=AddSpecialEffect("nitu.mdx", x1 + 170 * Cos(a-( i * 30 ) * bj_DEGTORAD), y1 + 170 * Sin(a-( i * 30 ) * bj_DEGTORAD))
    call SetSpecialEffectScale(EFF , 1.1)
    call SetSpecialEffectFacing(EFF , a* bj_RADTODEG -( i * 30 ) + 180)
    call SetSpecialEffectTimeScale(EFF , 0.7)
    call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 170 , 2)
    call DestroyEffect(EFF)
    set i=i + 1
    exitwhen i == -3
endloop
call SaveReal(h,id,15,0)
endif
call SetUnitXY_1(l__d,x,y, false)
call SetUnitScale(l__d,0.05+s1,0.05+s1,0.05+s1)
call SaveReal(h,id,10,s1+0.115)
set EFF=AddSpecialEffect("GogetaAura_New.mdx", x, y)
call SetSpecialEffectOrientation(EFF , a* bj_RADTODEG,-90,0)
call SetSpecialEffectScale(EFF , 1+s1*1.15)
call SetSpecialEffectZ(EFF , 105+s1*10)
if LoadReal(h,id,17)==0 then
call SetSpecialEffectVertexColour(EFF, 180,180,255,120-R2I(s1*2))
else
call SetSpecialEffectVertexColour(EFF, 25,25,255,220-R2I(s1*2.1))
endif
call RemoveEffect(EFF,0.4+(dist / 3850),false,CreateTimer())
set EFF=AddSpecialEffect("war3mapImported\\YellowBlueExplosion2.mdx", x, y)
call SetSpecialEffectOrientation(EFF , a* bj_RADTODEG,-90,0)
call SetSpecialEffectScale(EFF , 0.1+s1*0.75)
call SetSpecialEffectZ(EFF , 130+s1*30)
call RemoveEffect(EFF,0.4+(dist / 3850),false,CreateTimer())
if LoadReal(h,id,17)==1 and ModuloReal(dist,200)<1 then
    set EFF=AddSpecialEffect("KiritoWind.mdx", x, y)
    call SetSpecialEffectScale(EFF , 0.1+s1*0.65)
    call SetSpecialEffectTimeScale(EFF , 0.6)
    call SetSpecialEffectFacing(EFF , a* bj_RADTODEG)
    call RemoveEffect(EFF,0.4,true,CreateTimer())
endif
if (dist==700 or dist == 1400 or dist == 2100 or dist == 2800) and IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
call UnitApplyTimedLife(CreateUnit(p,'dumm',x,y,a*bj_RADTODEG),'BTLF',0.05) 
endif
call GroupEnumUnitsInRange(g,x,y,150+(3000-dist)*0.18,Base)
set idg=GetHandleId(g)
call SaveReal(h,id,2,dist-50)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
else
//call UnitRemoveAbility(u,'A17E')
call SetUnitTimeScale(u,1)
call RemoveUnit(l__d)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call FlushChildHashtable(h,GetHandleId(g))
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
function GogetaECast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,5)
local real y1=LoadReal(h,id,6)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real dmg=LoadReal(h,id,4)
local real dist=LoadReal(h,id,2)
local real scale=LoadReal(h,id,10)
local real time=LoadReal(h,id,16)
local integer i=-8
if time<1.2 then
if ModuloReal(time,0.3)<0.01 then
set EFF=AddSpecialEffect("boros-19.mdx", x+55*Cos(a),y+55*Sin(a))
call SetSpecialEffectScale(EFF , 1.45)
call SetSpecialEffectFacing(EFF , a* bj_RADTODEG)
call RemoveEffect(EFF,1.3,true,CreateTimer())
endif
call UnitApplyTimedLife(CreateUnit(p,'e18S',x+55*Cos(a),y+55*Sin(a),a*bj_RADTODEG+90),'BTLF',0.15) 
if time==0.0 then
loop
set EFF=AddSpecialEffect("nitu.mdx", x + 150 * Cos(a-( i * 30 ) * bj_DEGTORAD), y + 150 * Sin(a-( i * 30 ) * bj_DEGTORAD))
call SetSpecialEffectScale(EFF , 0.6)
call SetSpecialEffectFacing(EFF , a* bj_RADTODEG -( i * 30 ) + 180)
call SetSpecialEffectTimeScale(EFF , 0.5)
call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 190 , 2)
call DestroyEffect(EFF)
set i=i + 1
exitwhen i == -3
endloop
call SetUnitTimeScale(u,0.9)
if GetUnitAbilityLevel(u,'A170')>0 then
call SaveReal(h,id,4,(GetUnitAbilityLevel(u,'A0P7')+3)*GetHeroStr(u,true)*1.5)
call SaveReal(h,id,17,1)
call SetUnitAnimationByIndex(u,57)
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(2866) // Sound\Music\mp3Music\GogetaE2.mp3
else
set soundplay=SndN(2869) // Sound\Music\mp3Music\Gogeta\GogetaE2-jap.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set EFF=AddSpecialEffect("supershinythingyR.mdl", x+70*Cos(a),y+70*Sin(a))
call SaveEffectHandle(h,id,SH_Effect3,EFF)
call SetSpecialEffectVertexColour(EFF, 50,100,250,150)
call SetSpecialEffectOrientation(EFF , a* bj_RADTODEG,-90,0)
call SetSpecialEffectScale(EFF , 0.6)
call SetSpecialEffectZ(EFF , 150)
call DestroyEffect(EFF)
else
call SaveReal(h,id,17,0)
call SetUnitAnimationByIndex(u,12)
call SaveReal(h,id,4,(GetUnitAbilityLevel(u,'A0P7')+3)*GetHeroStr(u,true))
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(2872) // Sound\Music\mp3Music\GogetaE1.mp3
else
set soundplay=SndN(2875) // Sound\Music\mp3Music\Gogeta\GogetaE1-jap.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
endif
if time>0.3 then
if LoadReal(h,id,17)==0 then
set n=CreateUnit(p,'e2XZ',x+55*Cos(a),y+55*Sin(a),a*bj_RADTODEG) 
call UnitApplyTimedLife(n,'BTLF',1.15)
call SetUnitScale(n,0.26-time / 5,0.26-time / 5 ,0.26-time / 5)
else
set n=CreateUnit(p,'e2XZ',x+55*Cos(a),y+55*Sin(a),a*bj_RADTODEG) 
call UnitApplyTimedLife(n,'BTLF',1.15)
call SetUnitScale(n,0.35-time / 4,0.35-time / 4 ,0.35-time / 4)
endif
else
set n=CreateUnit(p,'e0NQ',x+5*Cos(a),y+5*Sin(a),a*bj_RADTODEG) 
call UnitApplyTimedLife(n,'BTLF',1.15)
call SetUnitScale(n,0.47-time / 4,0.47-time / 4 ,0.47-time / 4)
endif
call SaveReal(h,id,16,time+0.1)
else
//call UnitRemoveAbility(u,'A0IW')
if LoadReal(h,id,17)==1 then
call DestroyEffect(LoadEffectHandle(h,id,SH_Effect3))
endif
call RemoveUnit(l__d)
call SaveUnitHandle(h,id,7,CreateUnit(p,'e0UI',x+5*Cos(a),y+5*Sin(a),a*bj_RADTODEG))
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call PauseTimer(t)
call TimerStart(t,0.02,true,function GogetaECast3)
endif
set l__d=null
set p=null
set u=null
set t=null
endfunction
function GogetaECast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,5,x1)
call SaveReal(h,id,6,y1)
call SaveReal(h,id,10,0.05)
call SaveReal(h,id,13,0.4)
call SaveReal(h,id,14,100)
call SaveReal(h,id,15,0)
call SaveReal(h,id,16,0)
call SaveReal(h,id,11,a)
call SetUnitInvulnerable(u,true)
call SaveGroupHandle(h,id,12,CreateGroup())
//call UnitAddAbility(u,'A0IW')
call SaveReal(h,id,2,3000)
call PauseUnit(u,true)
call TimerStart(t,0.1,true,function GogetaECast2)
set u=null
set p=null
set t=null
endfunction
