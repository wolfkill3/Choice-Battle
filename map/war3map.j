return GetSpellAbilityId()=='A033' and udg_B
endfunction
function ShishiSonsonCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit l__d=LoadUnitHandle(h,id,16)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=LoadReal(h,id,3)
local real dmg=1.7*GetHeroStr(u,true)
local player p=GetOwningPlayer(u)
call GroupEnumUnitsInRange(G,x,y,800,Base)
call CinematicFadeBJCustom(bj_CINEFADETYPE_FADEIN,1,"ReplaceableTextures\\CameraMasks\\White_mask.blp",255,25,25,0)
call DisplayCineFilter(false)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)and IsUnitType(E,UNIT_TYPE_HERO)and GetUnitTypeId(E)!='H02A' then
if GetLocalPlayer()==GetOwningPlayer(E)then
call DisplayCineFilter(true)
endif
endif
call GroupRemoveUnit(G,E)
endloop
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e04D',x1,y1,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e04D',x1,y1,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e04D',x1,y1,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0HM',x1,y1,GetRandomReal(0,359)),'BTLF',1.4)
call UnitApplyTimedLife(CreateUnit(p,'e0MA',x1,y1,0),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0MA',x1,y1,60),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0MA',x1,y1,120),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0MA',x1,y1,180),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0MA',x1,y1,240),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0MA',x1,y1,300),'BTLF',1)
call SlashShishiSonson(CreateUnit(p,'e0M8',x1,y1,0),30,0,0,500,100)
call SlashShishiSonson(CreateUnit(p,'e0M8',x1,y1,60),30,0,60*bj_DEGTORAD,500,100)
call SlashShishiSonson(CreateUnit(p,'e0M8',x1,y1,120),30,0,120*bj_DEGTORAD,500,100)
call SlashShishiSonson(CreateUnit(p,'e0M8',x1,y1,180),30,0,180*bj_DEGTORAD,500,100)
call SlashShishiSonson(CreateUnit(p,'e0M8',x1,y1,240),30,0,240*bj_DEGTORAD,500,100)
call SlashShishiSonson(CreateUnit(p,'e0M8',x1,y1,300),30,0,300*bj_DEGTORAD,500,100)
call SetUnitX(u,GetUnitX(l__d))
call SetUnitY(u,GetUnitY(l__d))
call ShowUnit(u,true)
call PauseUnit(u,false)
if GetLocalPlayer()==p then
call ClearSelection()
call SelectUnit(u,true)
endif
call RemoveUnit(LoadUnitHandle(h,id,16))
call UnitRemoveAbility(u,'A0O2')
call SetUnitInvulnerable(u,false)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call SetUnitInvulnerable(c,false)
call myCustomDamage(u,c,11*GetHeroStr(u,true),false,false,null,null,null)
call SetControlToUnit(u,c,1, "stun")
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set p=null
set c=null
set u=null
set t=null
endfunction
function ShishiSonsonCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit l__d=LoadUnitHandle(h,id,16)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a2=Atan2(y1-y,x1-x)
local real a=LoadReal(h,id,3)
local real dmg=2*GetHeroAgi(u,true)
local player p=GetOwningPlayer(u)
local real dist=LoadReal(h,id,7)
local real time=LoadReal(h,id,8)
call SaveReal(h,id,8,time+0.01)
if time>2 then
    if SR(x,y,x1,y1)>400 and time<4 and LoadBoolean(h,id,12)==false then
        call PauseUnit(c,true)
        call SetUnitInvulnerable(c,true)
        set x=x+80*Cos(a2)
        set y=y+80*Sin(a2)
        call SetUnitXY_1(u,x,y, false)
        call SetUnitXY_1(l__d,x,y, false)
        call SetUnitFacingInstant(l__d,a2*bj_RADTODEG)
        set n=CreateUnit(p,'e01S',x,y,a2*bj_RADTODEG)
        call UnitApplyTimedLife(n,'BTLF',0.25)
        call UnitAddAbility(n,'A0O2')
        call SetUnitTimeScale(n,2)
        call SetUnitVertexColor(n,255,255,255,125)
        call SetUnitAnimation(n,"attack")
    else
        if time<4 then
            if LoadBoolean(h,id,12)==false then
                call SaveReal(h,id,3,Atan2(y1-y,x1-x))
                call SaveBoolean(h,id,12,true)
                set soundplay=SndN(1525) // Sound\Music\mp3Music\ShishiSonson.mp3
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            endif
            if dist<1000 then
                call PauseUnit(c,true)
                call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
                call SetUnitInvulnerable(c,true)
                call SetUnitXY_1(u,x+60*Cos(a),y+60*Sin(a), false)
                call SetUnitXY_1(l__d,x+60*Cos(a),y+60*Sin(a), false)
                set n=CreateUnit(p,'e01S',x,y,a*bj_RADTODEG)
                call UnitApplyTimedLife(n,'BTLF',0.25)
                call UnitAddAbility(n,'A0O2')
                call SetUnitTimeScale(n,2)
                call SetUnitVertexColor(n,255,255,255,125)
                call SetUnitAnimation(n,"attack")
                call SaveReal(h,id,7,dist+60)
                if SR(x,y,x1,y1)<200 and LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==true then
                    call ShowUnit(u,true)
                    call PauseUnit(u,false)
                    if GetLocalPlayer()==p then
                        call ClearSelection()
                        call SelectUnit(u,true)
                    endif
                    call RemoveUnit(LoadUnitHandle(h,id,16))
                    call UnitRemoveAbility(u,'A0O2')
                    call SetUnitInvulnerable(u,false)
                    call PauseUnit(c,false)
                    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
                    call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
                    call SetUnitInvulnerable(c,false)
                    call PauseTimer(t)
                    call DestroyTimer(t)
                    call FlushChildHashtable(h,id)
                endif
            else
                call PauseUnit(c,true)
                call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
                call SetUnitInvulnerable(c,true)
                call SetUnitAnimation(l__d,"Spell Slam Two")
                call SetUnitTimeScale(l__d,0.1)
                call PauseTimer(t)
                call TimerStart(t,2.9,false,function ShishiSonsonCast3)
            endif
        else
            call ShowUnit(u,true)
            call PauseUnit(u,false)
            if GetLocalPlayer()==p then
                call ClearSelection()
                call SelectUnit(u,true)
            endif
            call RemoveUnit(LoadUnitHandle(h,id,16))
            call UnitRemoveAbility(u,'A0O2')
            call SetUnitInvulnerable(u,false)
            call PauseUnit(c,false)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
            call SetUnitInvulnerable(c,false)
            call PauseTimer(t)
            call DestroyTimer(t)
            call FlushChildHashtable(h,id)
        endif
    endif
endif
set l__d=null
set p=null
set c=null
set u=null
set t=null
endfunction
function ShishiSonsonCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local integer i=0
local player p=GetOwningPlayer(u)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
set soundplay=SndN(1528) // Sound\Music\mp3Music\IttoryuIai.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set n=CreateUnit(p,'e06G',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.2)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call SetUnitInvulnerable(c,true)
call ShowUnit(u,false)
set n=CreateUnit(p,'e0XO',x,y,a*bj_RADTODEG)
call UnitAddAbility(n,'A0O2')
call SaveUnitHandle(h,id,16,n)
call SetUnitAnimation(n,"Spell Slam One")
call SetUnitTimeScale(n,0.4)
call SaveReal(h,id,3,Atan2(GetUnitY(c)-y,GetUnitX(c)-x))
call TimerStart(t,0.01,true,function ShishiSonsonCast2)
set u=null
set c=null
set p=null
set t=null
endfunction
function ShishiSonsonInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function ShishiSonsonCast)
call TriggerAddCondition(t,Condition(function ShishiSonsonCond))
set t=null
endfunction
function NigoriZakeCond takes nothing returns boolean
return GetSpellAbilityId()=='A030' and udg_B==true
endfunction
function NigoriZakeCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local integer i=1
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local real dmg=(2+GetUnitAbilityLevel(u,'A030'))*GetHeroStr(u,true)
call SetUnitXY_1(u,x1,y1, false)
call UnitApplyTimedLife(CreateUnit(p,'e0FA',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0HL',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0HM',x1,y1,a*bj_RADTODEG),'BTLF',1)
set soundplay=SndN(1530) // Sound\Music\mp3Music\NigoriZake.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call ShakeCamera(0.5,20)
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
call Push3(c,35,a,800,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",c,"chest"))
call UnitRemoveAbility(u,'A0LR')
call PauseUnit(u,false)
call SetUnitTimeScale(u,1)
call SetUnitInvulnerable(u,false)
call myCustomDamage(u,c,dmg,false,false,null,null,null)
call SetControlToUnit(u,c,2, "stun")
else
call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
call UnitRemoveAbility(u,'A0LR')
call PauseUnit(u,false)
call SetUnitTimeScale(u,1)
call SetUnitInvulnerable(u,false)
endif
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set u=null
set p=null
set t=null
set c=null
endfunction
