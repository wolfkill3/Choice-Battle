local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>150 then
set x1=x1+70*Cos(a)
set y1=y1+70*Sin(a)
call SetUnitAnimation(l__d,"walk")
call SetUnitFacingInstant(l__d,a*bj_RADTODEG)
call IssueImmediateOrder(l__d,"stop")
call SetUnitXY_1(l__d,x1,y1, false)
set n=CreateUnit(p,'kaR2',x1,y1,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.2)
call SetUnitVertexColor(n,255,255,255,75)
call SetUnitTimeScale(n,0.05)
call SetUnitAnimation(n,"walk")
else
call SetUnitAnimation(l__d,"stand")
call UnitRemoveAbility(l__d,'Ao7U')
set DarknessTarget[GetPlayerId(p)]=c
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set l__d=null
set c=null
set p=null
set u=null
set t=null
endfunction
