set lvl25[pid]=1
endif
if GetHeroLevel(u)>=26 and lvl26[pid]!=1 then
call CreateUnit(GetOwningPlayer(u),'h106',RX,RY,0)
set lvl26[pid]=1
endif
if GetHeroLevel(u)>=29 and lvl29[pid]!=1 then
call CreateUnit(GetOwningPlayer(u),'h107',RX,RY,0)
set lvl29[pid]=1
endif
if GetHeroLevel(u)>=32 and lvl32[pid]!=1 then
call CreateUnit(GetOwningPlayer(u),'h108',RX,RY,0)
set lvl32[pid]=1
endif
if GetHeroLevel(u)>=35 and lvl35[pid]!=1 then
call CreateUnit(GetOwningPlayer(u),'h109',RX,RY,0)
set lvl35[pid]=1
endif
if GetUnitTypeId(u)=='H045' and LoadInteger(HH,idu,StringHash("HSR"))!=1 and GetHeroLevel(u)>=6 then
set cjlocgn_00000000=CreateTimer()
call SaveInteger(HH,idu,StringHash("HSR"),1)
call UnitMakeAbilityPermanent(u,true,'A0RS')
call SaveUnitHandle(HH,GetHandleId(cjlocgn_00000000),0,u)
call TimerStart(cjlocgn_00000000,0.1,true,function HighSpeedRegenerationCast2)
set cjlocgn_00000000=null
endif
if(GetUnitTypeId(u)=='H05A' or GetUnitTypeId(u)=='H05B')and LoadInteger(HH,idu,StringHash("AVL"))!=1 and GetHeroLevel(u)>=6 then
call SaveInteger(HH,idu,StringHash("AVL"),1)
set cjlocgn_00000000=CreateTimer()
call UnitMakeAbilityPermanent(u,true,'A134')
call SaveUnitHandle(HH,GetHandleId(cjlocgn_00000000),0,u)
call TimerStart(cjlocgn_00000000,1,true,function AvalonCast2)
set cjlocgn_00000000=null
endif
if GetHeroLevel(u)>=25 then
call CreateUnit(GetOwningPlayer(u),'h03J',RX,RY,0)
endif
if GetHeroLevel(u)>=25 and (GetUnitTypeId(u)=='H02G' or GetUnitTypeId(u)=='H12G') then
loop
exitwhen i>=10
if GetUnitTypeId(Hero[i])=='H054' and IsUnitAlly(Hero[i],GetOwningPlayer(u))then
call UnitAddAbility(u,'A139')
endif
set i=i+1
endloop
endif
set i=0
if GetUnitTypeId(u)=='H047' and GetHeroLevel(u)>=6 then
call SetUnitAbilityLevel(u,'A0S1',(GetHeroLevel(u)-2)/4)
//call SetUnitAbilityLevel(u,'LaxD',(GetHeroLevel(u)-2)/4)
endif
if GetUnitTypeId(u)=='H03P' and GetHeroLevel(u)>=6 then
call SetUnitAbilityLevel(u,'A0X8',(GetHeroLevel(u)-2)/4)
endif
if GetUnitTypeId(u)=='H052' then
    if GetHeroLevel(u)>=6 then
        call SetUnitAbilityLevel(u,'A105',(GetHeroLevel(u)-2)/4)
    endif
    if LoadInteger(HH,idu,StringHash("ABS"))!=1 then
        set cjlocgn_00000000=CreateTimer()
        call SaveInteger(HH,idu,StringHash("ABS"),1)
        call SaveUnitHandle(HH,GetHandleId(cjlocgn_00000000),0,u)
        call TimerStart(cjlocgn_00000000,0.1,true,function CellRegeneration)
    endif
endif
if GetUnitTypeId(u)=='H02I' and GetHeroLevel(u)>=6 then
    if GetHeroLevel(u)>=6 then
        call SetUnitAbilityLevel(u,'A0IR',(GetHeroLevel(u)-2) / 4)
    endif
    if LoadInteger(HH,idu,StringHash("VSP"))!=1 then
        set cjlocgn_00000000=CreateTimer()
        call SaveInteger(HH,idu,StringHash("VSP"),1)
        call SaveUnitHandle(HH,GetHandleId(cjlocgn_00000000),0,u)
        call TimerStart(cjlocgn_00000000,0.1,true,function MajinVegeta)
    endif
endif
if GetUnitTypeId(u)=='H05N' and GetHeroLevel(u)>=6 then
call SetUnitAbilityLevel(u,'A14W',(GetHeroLevel(u)-2) / 4)
endif
if GetUnitTypeId(u)=='H054' and GetHeroLevel(u)>=6 then
call SetUnitAbilityLevel(u,'A10T',(GetHeroLevel(u)-2) / 4)
endif
if GetUnitTypeId(u)=='H058' then
call SetUnitAbilityLevel(u,'A12A',(GetHeroLevel(u)) / 3)
call SetUnitAbilityLevel(u,'A11S',(GetHeroLevel(u)) / 3)
endif
if GetHeroLevel(u)>=6 and(GetUnitTypeId(u)=='H02U' or GetUnitTypeId(u)=='H05X')and LoadInteger(HH,idu,StringHash("hie"))!=1 then
set cjlocgn_00000000=CreateTimer()
call SaveUnitHandle(HH,GetHandleId(cjlocgn_00000000),0,Hero[pid])
call SaveInteger(HH,idu,StringHash("hie"),1)
call TimerStart(cjlocgn_00000000,16-GetHeroLevel(u) / 3,true,function HieHieNoMi)
call SaveBoolean(HH,GetHandleId(u),StringHash("heal"),true)
set cjlocgn_00000000=null
endif
if GetUnitTypeId(u)=='H058' and GetHeroLevel(u)>=6 then
call SetUnitAbilityLevel(u,'A11O',(GetHeroLevel(u)-2) / 4)
endif
if GetUnitTypeId(u)=='H058' and GetHeroLevel(u)>=6 then
call SetUnitAbilityLevel(u,'A11M',(GetHeroLevel(u)-2) / 4)
endif
if GetUnitTypeId(u)=='H058' and GetHeroLevel(u)>=6 then
call SetUnitAbilityLevel(u,'A11X',(GetHeroLevel(u)-2) / 4)
endif
set u=null
endfunction
function InitTrig_LevelUp takes nothing returns nothing
set gg_trg_LevelUp=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_LevelUp,EVENT_PLAYER_HERO_LEVEL)
call TriggerAddCondition(gg_trg_LevelUp,Condition(function Trig_LevelUp_Conditions))
call TriggerAddAction(gg_trg_LevelUp,function Trig_LevelUp_Actions)
endfunction

function Trig_StatusBar_Actions takes nothing returns nothing
    local framehandle gameUI=GetOriginFrame( ORIGIN_FRAME_GAME_UI, 0 )
    local framehandle consoleUI=GetOriginFrame( ORIGIN_FRAME_CONSOLE_UI, 0 )
    local framehandle CustomClassFrame
    local framehandle CustomClassTooltip
    local framehandle CustomClassTooltipText
    local framehandle CustomAbilityVarFrame
    local framehandle CustomAbilityVarTooltip
    local framehandle CustomAbilityVarTooltipText
    local framehandle CustomAbilityFrame
    local framehandle CustomAbilityTooltip
    local framehandle CustomAbilityTooltipText
    local framehandle CustomGlobalAbilityFrame
    local framehandle CustomGlobalAbilityTooltip
    local framehandle CustomGlobalAbilityTooltipText
    local framehandle CustomLeaderboard
    local framehandle CustomLeaderboardText
    local trigger tOnPress = null
    local trigger tOnUnPress = null
    local trigger tOnClick = null
    local trigger tOnHover = null
    local trigger tOnUnHover = null 
    local trigger toggleStatus = null
    local trigger AbilityModeHotkey = null
    local integer x=0
    local integer i
    local integer j
    set i=0
    loop
    exitwhen(i>12)
    set j=0
    loop
    exitwhen(j>12)
    call SaveInteger(HPlayer,i,j,0)
    call SaveInteger(HPlayer,i+20,j+20,0)
    set j=j+1
    endloop
    set i=i+1
    endloop
    //call ClearFrameAllPoints( GetOriginFrame(ORIGIN_FRAME_TIME_OF_DAY_INDICATOR,0))
    //call ShowFrame( GetOriginFrame(ORIGIN_FRAME_TIME_OF_DAY_INDICATOR,0), false )
    //call ClearFrameAllPoints( GetFrameByName("SimpleClassValue",0))
    //call ClearFrameAllPoints( GetFrameByName("SimpleNameValue",0))
    //call SetFrameRelativePoint( GetFrameByName("SimpleHeroLevelBar",0), FRAMEPOINT_CENTER, consoleUI, FRAMEPOINT_BOTTOM,  -.0013, -.1  )
    set SpectacleTeamSelect=CreateFrameByType( "SIMPLEBUTTON", "SpectacleTeamSelect", null, "", 0 )
    call ClearFrameAllPoints( SpectacleTeamSelect )
    call SetFrameTexture( SpectacleTeamSelect, "checkbox-depressed2.blp", 0, true )
    call SetFrameTexture( SpectacleTeamSelect, "checkbox-depressed2.blp", 1, true )
    call SetFrameTexture( SpectacleTeamSelect, "checkbox-depressed2.blp", 2, true )
    call SetFrameSize( SpectacleTeamSelect, .12, .035 )
    call SetFrameParent( SpectacleTeamSelect, null )
    call ShowFrame( SpectacleTeamSelect, GetPlayerId(GetLocalPlayer())==10 )
    call SetFramePriority( SpectacleTeamSelect, 1 )
    call SetFrameRelativePoint( SpectacleTeamSelect, FRAMEPOINT_CENTER, consoleUI, FRAMEPOINT_BOTTOM, -0.155, .165  )

    set SpectacleTeamSelectText=CreateFrameByType( "SIMPLETEXT", "TavernBarCloseText", SpectacleTeamSelect, "", 0 )
    call ClearFrameAllPoints( SpectacleTeamSelectText )
    call SetFrameBlendMode( SpectacleTeamSelectText, 0, BLEND_MODE_BLEND )
    call SetFrameFont( SpectacleTeamSelectText, "Fonts\\FRIZQT__.TTF", .01, 0 )
    call SetFrameTextAlignment( SpectacleTeamSelectText, TEXT_JUSTIFY_CENTER, TEXT_JUSTIFY_MIDDLE )
    call SetFrameTextColour( SpectacleTeamSelectText, 0xFFFFA500 )
    call SetFrameParent( SpectacleTeamSelectText, SpectacleTeamSelect )
    call SetFrameText( SpectacleTeamSelectText, "Current team: All")
    call ShowFrame( SpectacleTeamSelectText, GetPlayerId(GetLocalPlayer())==10 )
    call SetFrameRelativePoint( SpectacleTeamSelectText, FRAMEPOINT_CENTER, SpectacleTeamSelect, FRAMEPOINT_CENTER, .00011, .0 ) 

    set tOnPress = CreateTrigger( )
    set tOnUnPress = CreateTrigger( )
    set tOnClick = CreateTrigger( )
    call TriggerRegisterFrameEvent( tOnPress, SpectacleTeamSelect, FRAMEEVENT_MOUSE_DOWN )
    call TriggerRegisterFrameEvent( tOnUnPress, SpectacleTeamSelect, FRAMEEVENT_MOUSE_UP )
    call TriggerRegisterFrameEvent( tOnClick, SpectacleTeamSelect, FRAMEEVENT_CONTROL_CLICK )

    call TriggerAddAction( tOnPress, function OnButtonPress )
    call TriggerAddAction( tOnUnPress, function OnButtonUnpress )
    call TriggerAddAction( tOnClick, function OnButtonChangeTeam )
    
    set SpectacleTeamSelect1=CreateFrameByType( "SIMPLEBUTTON", "SpectacleTeamSelect1", null, "", 0 )
    call ClearFrameAllPoints( SpectacleTeamSelect1 )
    call SetFrameTexture( SpectacleTeamSelect1, "checkbox-depressed2.blp", 0, true )
    call SetFrameTexture( SpectacleTeamSelect1, "checkbox-depressed2.blp", 1, true )
    call SetFrameTexture( SpectacleTeamSelect1, "checkbox-depressed2.blp", 2, true )
    call SetFrameSize( SpectacleTeamSelect1, .12, .035 )
    call ShowFrame( SpectacleTeamSelect1, GetPlayerId(GetLocalPlayer())==11 )
    call SetFramePriority( SpectacleTeamSelect1, 1 )
    call SetFrameRelativePoint( SpectacleTeamSelect1, FRAMEPOINT_CENTER, consoleUI, FRAMEPOINT_BOTTOM, -0.155, .165 )

    set SpectacleTeamSelect1Text=CreateFrameByType( "SIMPLETEXT", "TavernBarCloseText", SpectacleTeamSelect1, "", 0 )
