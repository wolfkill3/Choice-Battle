endfunction
function Trig_Alastor_Flame_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit u=LoadUnitHandle(HH,GetHandleId(t),0)
local real dmg=(0.5+GetUnitAbilityLevel(u,0x41303854)*0.1)*GetHeroAgi(u,true)*0.5
local player p=GetOwningPlayer(u)
if UnitIsAlive(u)then
call GroupEnumUnitsInRange(G,GetUnitX(u),GetUnitY(u),700,Base)
loop
