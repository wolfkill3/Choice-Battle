call SetPlayerAbilityAvailable(Player(i),'GKW5',false)
call SetPlayerAbilityAvailable(Player(i),'A1SK',false)
call SetPlayerAbilityAvailable(Player(i),'A315',false)
call SetPlayerAbilityAvailable(Player(i),'A2HX',false)
call SetPlayerAbilityAvailable(Player(i),'A30C',false)
call SetPlayerAbilityAvailable(Player(i),'A40C',false)
call SetPlayerAbilityAvailable(Player(i),'A41C',false)
call SetPlayerAbilityAvailable(Player(i),'A42C',false)
call ForceAddPlayer(all[0],Player(i))
if i!=10 and i!=11 then
    if GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING then
        set maxplayers=maxplayers+1
        set idpl[ipl]=i
        set ipl=ipl+1
        set playedplayers=playedplayers+1
    endif
endif
set i=i+1
endloop
call ForceAddPlayer(all[1],Player(0))
call ForceAddPlayer(all[1],Player(1))
call ForceAddPlayer(all[1],Player(2))
call ForceAddPlayer(all[1],Player(3))
call ForceAddPlayer(all[1],Player(4))
call ForceAddPlayer(all[2],Player(5))
call ForceAddPlayer(all[2],Player(6))
call ForceAddPlayer(all[2],Player(7))
call ForceAddPlayer(all[2],Player(8))
call ForceAddPlayer(all[2],Player(9))
call GroupEnumUnitsInRect(G,gg_rct_Base,null)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if GetUnitTypeId(E)=='n008' and GetPlayerSlotState(GetOwningPlayer(E))!=PLAYER_SLOT_STATE_PLAYING then
call UnitRemoveAbility(E,'Alnv')
endif
call GroupRemoveUnit(G,E)
endloop
