function RapidSlashCond takes nothing returns boolean
return GetSpellAbilityId()=='A0B1' and udg_B==true
endfunction
function RapidSlashCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=LoadReal(h,id,4)
local real time=LoadReal(h,id,5)
if SR(x,y,x1,y1)<800 and time<4 then
call SaveReal(h,id,5,time+0.2)
call SetUnitXY_1(c,x1+25*Cos(a),y1+25*Sin(a), false)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",x1,y1))
call SetUnitXY_1(u,x1,y1, false)
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitAnimation(u,"attack")
// копия Мукуро в шлейф — на каждом 2-м шаге
if ModuloInteger(R2I(time/0.2+0.5),2)==0 then
set n=CreateUnit(GetOwningPlayer(u),'e05A',x1,y1,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.2)
call SetUnitTimeScale(n,2)
call SetUnitAnimation(n,"attack")
endif
else
call DestroyEffect(LoadEffectHandle(h,id,6))
call DestroyEffect(LoadEffectHandle(h,id,7))
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call myCustomDamage(u,c,GetHeroInt(u,true)*(3+GetUnitAbilityLevel(u,'A0B1'))*CambioXDmg(u),false,false,null,null,null)
call SetControlToUnit(u,c, 3, "stun")
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call SetUnitTimeScale(u,2)
endif
set u=null
set c=null
set t=null
endfunction
function RapidSlashCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real f=GetUnitFacing(u)
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveReal(h,id,2,x1)
call SaveReal(h,id,3,y1)
call SaveReal(h,id,5,0)
call SaveReal(h,id,4,Atan2(y1-y,x1-x))
call SaveEffectHandle(h,id,6,AddSpecialEffectTarget("Abilities\\Weapons\\PhoenixMissile\\Phoenix_Missile_mini.mdl",u,"left hand"))
call SaveEffectHandle(h,id,7,AddSpecialEffectTarget("Abilities\\Weapons\\PhoenixMissile\\Phoenix_Missile_mini.mdl",u,"right hand"))
call SetUnitX(u,GetUnitX(c))
call SetUnitY(u,GetUnitY(c))
call SetUnitAnimation(u,"attack")
call DestroyEffect(AddSpecialEffect("war3mapImported\\Dimension Slash.mdx",x1,y1))
set soundplay=SndN(1019) // Sound\Music\mp3Music\Mukuro4Form.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.020,true,function RapidSlashCast2)
else
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
call SetUnitInvulnerable(c,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set t=null
set u=null
set p=null
set c=null
endfunction
function RapidSlashInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function RapidSlashCast)
call TriggerAddCondition(t,Condition(function RapidSlashCond))
set t=null
endfunction
