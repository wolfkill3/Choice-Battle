endfunction
function CastBuildingStrike2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real a=LoadReal(h,id,4)
local real speed=LoadReal(h,id,5)
local real x2=GetUnitX(u)+200*Cos(a)
local real y2=GetUnitY(u)+200*Sin(a)
local real x=GetUnitX(l__d)+speed*Cos(a)
local real y=GetUnitY(l__d)+speed*Sin(a)
local real x1
local real ab
local real y1
local real dmg=(50+GetHeroAgi(u,true))*(1+GetUnitAbilityLevel(u,'A0G8'))
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,3)
local integer idg2=GetHandleId(g)
local real time=LoadReal(h,id,6)
if time<0.5 then
call SaveReal(h,id,6,time+0.03)
call SetUnitZ(l__d,MathRealFloor(GetUnitZCustom(l__d)+17))
if time==0.48 then
call SetUnitAnimation(u,"spell one")
call DestroyEffect(AddSpecialEffect("war3mapImported\\NewDirtEXNofire.mdx",x2,y2))
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
endif
else
if speed>6 and udg_B then
        call SetUnitXY_1(l__d,x,y, false)
        call SetUnitFlyHeight(l__d,0,0)
        call DestroyEffect(AddSpecialEffect("Hashirama\\az_HitHeavy.mdx",x+100*Cos(a),y+100*Sin(a)))
        call DestroyEffect(AddSpecialEffect("Hashirama\\zhendi-sand.mdx",x,y))
        call UnitApplyTimedLife(CreateUnit(p,'e0AC',x,y,GetRandomReal(0,359)),'BTLF',0.5)
        call GroupEnumUnitsInRange(g,x,y,250,Base)
        loop
        set E=FirstOfGroup(g)
        exitwhen E==null
        set ide=GetHandleId(E)
        if Condition_Base(p,E)then
                if LoadUnitHandle(h,idg2,ide)!=E then
                        set x1=GetUnitX(E)
                        set y1=GetUnitY(E)
                        call myCustomDamage(u,E,dmg,false,false,null,null,null)
                        call SaveUnitHandle(h,idg2,ide,E)
                        endif
                call SetControlToUnit(E,E, 1, "stun")
                call Push3(E,speed+5,a,125,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
        endif
        call GroupRemoveUnit(g,E)
        endloop
        call SaveReal(h,id,5,LoadReal(h,id,5)-0.40)
else
        call DestroyEffect(AddSpecialEffect("war3mapImported\\NewDirtEXNofire.mdx",x,y))
        call DestroyEffect(AddSpecialEffect("war3mapImported\\explode.mdx",x,y))
        call DestroyEffect(AddSpecialEffect("war3mapImported\\LW10.mdx",x,y))
        call PauseTimer(t)
        call DestroyTimer(t)
        call RemoveUnit(l__d)
        call FlushChildHashtable(h,id)
        call FlushChildHashtable(h,idg2)
        call DestroyGroup(g)
endif
endif
set g=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
