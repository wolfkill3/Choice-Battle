call SetUnitFlyHeight(n,310,0)
call UnitApplyTimedLife(n,'BTLF',0.20)
set n=CreateUnit(p,'e0HH',x1,y1,GetRandomReal(0,359))
call SetUnitScale(n,1.25,1.25,1.20)
call SetUnitFlyHeight(n,465,0)
call UnitApplyTimedLife(n,'BTLF',0.20)
call GroupEnumUnitsInRange(G,x1,y1,250,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
set x2=GetUnitX(E)
set y2=GetUnitY(E)
set a2=Atan2(y2-y1,x2-x1)+0.7
call myCustomDamage(u,E,dmg,false,false,null,null,null)
if IsTerrainPathable(x2-69*Cos(a2),y2-69*Sin(a2), PATHING_TYPE_FLYABILITY)==false then
call SetUnitPosition(E,x2-69*Cos(a2),y2-69*Sin(a2))
else
call SetUnitPosition(E,x2,y2)
endif
call SetUnitFlyHeight(E,GetUnitFlyHeight(E)+2.6,0)
if IsUnitInGroup(E,g)==false then
call UnitAddAbility(E,'Arav')
call UnitRemoveAbility(E,'Arav')
call GroupAddUnit(g,E)
call SetUnitPathing(E,false)
endif
endif
call GroupRemoveUnit(G,E)
endloop
set n=CreateUnit(p,'e007',x1,y1,GetUnitFacing(u))
call UnitApplyTimedLife(n,'BTLF',0.5)
call SetUnitVertexColor(n,155,155,155,80)
call SetUnitScale(n,2,2,2)
else
loop
set E=FirstOfGroup(g)
exitwhen E==null
call SetUnitFlyHeight(E,0,GetUnitFlyHeight(E))
call GroupRemoveUnit(g,E)
call SetUnitPathing(E,true)
endloop
call DestroyTimer(t)
call DestroyGroup(g)
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
