function Trig_RyuseiDamag_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real dmg=GetHeroStr(udg_Hero[GetPlayerId(p)+1],true)*2
local real x=GetUnitX(u)
local real y=GetUnitY(u)
if GetUnitTypeId(GetTriggerUnit())=='e02H' then
call UnitApplyTimedLife(CreateUnit(p,'e02G',x,y,0),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e02I',x,y,0),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e02J',x,y,0),'BTLF',1)
call GroupEnumUnitsInRange(G,x,y,300,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(udg_Hero[GetPlayerId(p)+1],E,dmg*1.25,false,false,null,null,null)
call SetControlToUnit(E,E, 0.5, "stun")
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Flameshock.mdx",E,"chest"))
endif
call GroupRemoveUnit(G,E)
endloop
else
set dmg=GetHeroStr(udg_Hero[GetPlayerId(p)+1],true)
call GroupEnumUnitsInRange(G,x,y,300,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(udg_Hero[GetPlayerId(p)+1],E,dmg,false,false,null,null,null)
call SetUnitManaPercentBJ(E,GetUnitManaPercent(E)-5)
endif
call GroupRemoveUnit(G,E)
endloop
endif
call RemoveUnit(u)
set u=null
endfunction
function GintokiBikeStopOrders takes nothing returns nothing
if GetOrderTargetUnit()==null then
call SaveReal(HH,GetHandleId(GetOrderedUnit()),SH_GinAnge,Atan2(GetOrderPointY()-GetUnitY(GetOrderedUnit()),GetOrderPointX()-GetUnitX(GetOrderedUnit()))*bj_RADTODEG)
else
call SaveReal(HH,GetHandleId(GetOrderedUnit()),SH_GinAnge,Atan2(GetUnitY(GetOrderTargetUnit())-GetUnitY(GetOrderedUnit()),GetUnitX(GetOrderTargetUnit())-GetUnitX(GetOrderedUnit()))*bj_RADTODEG)
endif
call IssueImmediateOrder(GetOrderedUnit(),"stop")
endfunction
function GintokiKamehamehaStopOrders2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
call IssueImmediateOrder(u,"stop")
call SetUnitFacing(u,Atan2(LoadReal(h,id,1)-GetUnitY(u),LoadReal(h,id,2)-GetUnitX(u))*bj_RADTODEG)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
set t=null
set u=null
endfunction
function GintokiKamehamehaStopOrders takes nothing returns nothing
local unit u=GetOrderedUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
if GetOrderTargetUnit()==null then
call SaveReal(h,id,2,GetOrderPointX())
call SaveReal(h,id,1,GetOrderPointY())
else
call SaveReal(h,id,2,GetUnitX(GetOrderTargetUnit()))
call SaveReal(h,id,1,GetUnitY(GetOrderTargetUnit()))
endif
//call SetUnitAnimation(u,"Spell Channel One")
call TimerStart(t,0.001,false,function GintokiKamehamehaStopOrders2)
set u=null
set t=null
endfunction
