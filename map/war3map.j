call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitVertexColor(n,40,100,255,50)
set n=CreateUnit(p,'e0B2',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,2,2,2)
call SetUnitVertexColor(n,40,100,255,50)
call SetUnitX(l__d,x+25*Cos(a-deg90))
call SetUnitY(l__d,y+25*Sin(a-deg90))
call SaveReal(h,id,13,time)
call SetUnitAnimation(u,"spell portrait")
else
//call UnitRemoveAbility(u,'A0NP')
call SetUnitTimeScale(u,1)
call RemoveUnit(l__d)
call SaveUnitHandle(h,id,7,CreateUnit(p,'e0C1',x+35*Cos(a),y+35*Sin(a),a*bj_RADTODEG))
set n=CreateUnit(p,'e0R6',x+115*Cos(a),y+115*Sin(a),a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,2)
//call StopSound(LoadSoundHandle(h,id,16),true,true)
call PauseUnit(u,true)
call SetUnitX(l__d,x+100*Cos(a))
call SetUnitY(l__d,y+100*Sin(a))
call UnitAddAbility(l__d,'A0SR')
call UnitRemoveAbility(u,'A1FU')
call UnitRemoveAbility(u,'Pet1')
call SetUnitAnimation(u,"spell portrait")
call SetUnitScale(l__d,0.8,0.8,0.8)
call PauseTimer(t)
call TriggerClearActions(tt)
call DestroyTrigger(tt)
call SaveReal(h,id,11,a)
call UnitRemoveAbility(u,'B00A')
call SetUnitAcquireRange(u,600)
call TimerStart(t,0.02,true,function GintokiKamehamehaCast3)
endif
set l__d=null
set p=null
set u=null
set t=null
endfunction
function GintokiKamehamehaCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local trigger tt=CreateTrigger()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
//local real x1=GetSpellTargetX()
//local real y1=GetSpellTargetY()
local real a=GetUnitFacing(u)*bj_DEGTORAD
local real ang=150*bj_DEGTORAD
call SetUnitAcquireRange(u,51)
call SaveUnitHandle(h,id,0,u)
call SaveTriggerHandle(h,id,1,tt)
//call SaveReal(h,id,5,x1)
//call SaveReal(h,id,6,y1)
call SaveReal(h,id,4,(GetUnitAbilityLevel(u,'A0UZ')+5)*GetHeroAgi(u,true))
call SaveReal(h,id,2,3500)
call SaveReal(h,id,10,1.25)
call SaveReal(h,id,13,0)
call SetUnitTimeScale(u,0)
call SetUnitInvulnerable(u,true)
call SaveGroupHandle(h,id,12,CreateGroup())
call SetUnitAnimation(u,"spell portrait")
set soundplay=SndN(896) // Sound\Music\mp3Music\GintokiKamehameha.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SaveUnitHandle(h,id,7,CreateUnit(p,0x65304259,x+30*Cos(a-deg90),y+30*Sin(a-deg90),a*bj_RADTODEG))
call UnitAddAbility(u,'A1FU') //Slow
call UnitAddAbility(u,'Pet1')
call StartAbilityCooldown(GetUnitAbility(u,'A0UZ'),GetAbilityRemainingCooldown(GetUnitAbility(u,'A0UZ')))
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_POINT_ORDER)
//call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_ORDER)
call TriggerAddAction(tt,function GintokiKamehamehaStopOrders)
call TimerStart(t,0.1,true,function GintokiKamehamehaCast2)
set u=null
set p=null
set t=null
endfunction
