function RJeanneMissles2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real f=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,5)
local real y1=LoadReal(h,id,6)
local real a=Atan2(y1-y,x1-x)
local real sr=SR(x,y,x1,y1)
local real fl=sr/LoadReal(h,id,7)
local real dist=LoadReal(h,id,3)
if SR(x,y,x1,y1)>100 and l__d!=null then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,f*fl,0)
else
set n=CreateUnit(GetOwningPlayer(l__d),'e12J',x1,y1,GetRandomReal(0,359))
call SetUnitTimeScale(n,1)
call UnitApplyTimedLife(n,'BTLF',0.8)
call SetUnitFlyHeight(l__d,35,0)
call UnitRemoveAbility(l__d,'A1DB')
call UnitApplyTimedLife(l__d,'BTLF',LoadReal(h,id,8))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set t=null
endfunction
function RJeanneMissles takes unit l__d,real speed,real a,real x,real y,real time returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,GetUnitFlyHeight(l__d))
call SaveReal(h,id,3,GetUnitX(l__d))
call SaveReal(h,id,4,GetUnitY(l__d))
call SaveReal(h,id,5,x)
call SaveReal(h,id,6,y)
call SaveReal(h,id,7,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,8,time)
call TimerStart(t,0.014,true,function RJeanneMissles2)
set t=null
endfunction
function RJeanneCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real dmg=GetHeroInt(u,true)*(1.5+0.5*GetUnitAbilityLevel(u,'A1D9'))*0.12
local real x=LoadReal(h,id,6)
local real y=LoadReal(h,id,7)
local real x1=LoadReal(h,id,4)
local real y1=LoadReal(h,id,5)
local real x2=0
local real y2=0
local real sr2=0
local real a=LoadReal(h,id,3)
local real dist=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
if dist<1.5 then
call SaveReal(h,id,2,dist+0.07)
set x2=x1+GetRandomReal(-450,450)
set y2=y1+GetRandomReal(-450,450)
set sr2=SR(x2,y2,x,y)
set n=CreateUnit(p,'e12M',x2-(sr2+900)*Cos(a),y2-(sr2+900)*Sin(a),a*bj_RADTODEG)
call SetUnitFlyHeight(n,GetRandomReal(550,800)+sr2/4,0)
call SetUnitTimeScale(n,2.5)
call RJeanneMissles(n,85,a,x2,y2,1.5-dist)
set x2=x1+GetRandomReal(-450,450)
set y2=y1+GetRandomReal(-450,450)
set sr2=SR(x2,y2,x,y)
set n=CreateUnit(p,'e12M',x2-(sr2+900)*Cos(a),y2-(sr2+900)*Sin(a),a*bj_RADTODEG)
call SetUnitFlyHeight(n,GetRandomReal(550,800)+sr2/4,0)
call SetUnitTimeScale(n,2.5)
call RJeanneMissles(n,85,a,x2,y2,1.5-dist)
set x2=x1+GetRandomReal(-450,450)
set y2=y1+GetRandomReal(-450,450)
set sr2=SR(x2,y2,x,y)
set n=CreateUnit(p,'e12M',x2-(sr2+900)*Cos(a),y2-(sr2+900)*Sin(a),a*bj_RADTODEG)
call SetUnitFlyHeight(n,GetRandomReal(550,800)+sr2/4,0)
call SetUnitTimeScale(n,2.5)
call RJeanneMissles(n,85,a,x2,y2,1.5-dist)
call GroupEnumUnitsInRange(G,x1,y1,700,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call EffectToRandomBone("war3mapImported\\SlashEffectRed by Deckai.mdx",E)
call SetUnitAnimation(E,"death")
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(G,E)
endloop
else
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set p=null
set t=null
endfunction
