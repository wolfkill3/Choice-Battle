set i=i+1
call StartSound(soundStr[i])
exitwhen i>96
endloop
call TriggerSleepAction(0)
set i=0
loop
set i=i+1
call StopSound(soundStr[i],false,false)
exitwhen i>96
endloop
endfunction
function InitTrig_VoicePreload takes nothing returns nothing
set gg_trg_VoicePreload=CreateTrigger()
call TriggerRegisterTimerEventSingle(gg_trg_VoicePreload,1.1)
call TriggerAddAction(gg_trg_VoicePreload,function Trig_VoicePreload_Actions)
endfunction
function InitVoice takes integer id returns string
local string l__s="sdf.mp3"
if id=='H02M' or id=='H12M' then
set l__s="Aizen.mp3"
elseif id=='HIc1' then
set l__s="Ichigo.mp3"
elseif id=='H012' then
set l__s="HIchigo_Summon.mp3"
elseif id=='H03L' then
set l__s="Nell.mp3"
elseif id=='H01L' then
set l__s="Mayri.mp3"
elseif id=='H045' then
set l__s="Ulqa.mp3"
elseif id=='H02J' then
set l__s="Gin.mp3"
elseif id=='H018' then
set l__s="Ishida.mp3"
elseif id=='H054' then
set l__s="NatsuSummon.mp3"
elseif id=='H00D' then
set l__s="PickAce.mp3"
elseif id=='H048' then
set l__s="FriezaPick.mp3"
elseif id=='H047' then
set l__s="LaxusSummon.mp3"
elseif id=='H066' then
set l__s="DoflamingoSummon.mp3"
