// ===== Звуки способностей и озвучки массивом soundStr, как у Джирена =====
// Каждый путь создаётся один раз при загрузке (2 копии, у звуков периодических способностей и Гарпа/Баррагана 3),
// в коде звук берётся готовым: SndN(индекс) или SndByPath(путь). CreateSound на каждый каст больше нет —
// нет утечки звуков без KillSoundWhenDone и звуки не создаются внутри веток GetLocalPlayer.
// Звуки из массива НЕЛЬЗЯ удалять (KillSoundWhenDone, StopSound(..,true,..)).
function SND_Add takes integer sai,integer san,string sap,integer saf returns nothing
    local integer sak=0
    loop
        exitwhen sak>=san
        set soundStr[sai+sak]=CreateSound(sap,false,false,true,12700,saf,"")
        set sak=sak+1
    endloop
    set SND_Cnt[sai]=san
    call SaveInteger(SND_IX,StringHash(sap),0,sai)
endfunction
