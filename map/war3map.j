function GetUnitTotalDamage takes unit u returns integer
return GetUnitBonusDamageByIndex(u,0)+GetUnitBaseDamageByIndex(u,0)
endfunction
function ShikiCloneEffect2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local real time=LoadReal(h,id,1)
    local unit u=LoadUnitHandle(h,id,0)
    local real sc=LoadReal(h,id,2)
    local real nsc=LoadReal(h,id,3)
    local integer al=LoadInteger(h,id,4)
    local integer nal=LoadInteger(h,id,5)
    if time>0 then
    call SaveReal(h,id,1,time-0.02)
    call SetUnitScale(u,sc+nsc,sc+nsc,sc+nsc)
    call SaveReal(h,id,2,sc+nsc)
    call SetUnitVertexColor(u,255,255,255,al)
    call SaveInteger(h,id,4,al-nal)
    else
    call RemoveUnit(u)
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(h,id)
    endif
    set u=null
    set t=null
endfunction
function ShikiCloneEffect takes unit u,real time,real sc1,real sc2,integer alpha returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local real a=0.02*(sc2-sc1)
    call SaveUnitHandle(h,id,0,u)
    call SaveReal(h,id,1,time)
    call SaveReal(h,id,2,sc1)
    call SaveReal(h,id,3,a/time)
    call SaveInteger(h,id,4,alpha)
    call SaveInteger(h,id,5,R2I(0.02*(I2R(alpha)/time)))
    call SetUnitVertexColor(u,255,255,255,alpha)
    call TimerStart(t,0.02,true,function ShikiCloneEffect2)
    set t=null
endfunction
function CopyHero takes unit u returns unit
local integer id=GetUnitTypeId(u)
local integer i=0
set CU=CreateUnit(GetOwningPlayer(u),'H05O',0,0,0)
//set CU=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE),'H05O',0,0,0)
//call SetUnitOwner(CU,GetOwningPlayer(u),false)
call UnitAddAbility(CU,'A14Y')
call UnitAddAbility(CU,'A14Z')
call UnitAddAbility(CU,'Aloc')
call SetHeroLevel(CU,GetHeroLevel(u),false)
call SetHeroAgi(CU,GetHeroAgi(u,false),false)
call SetHeroStr(CU,GetHeroStr(u,false),false)
call SetHeroInt(CU,GetHeroInt(u,false),false)
call SetUnitTurnSpeed(CU,1000)
call SetUnitVertexColor(CU,0,0,0,0)
loop
exitwhen i>=6
call UnitAddItemById(CU,GetItemTypeId(UnitItemInSlot(u,i)))
set i=i+1
endloop
call SetUnitBaseDamageByIndex(CU,0,GetUnitBaseDamageByIndex(u,0))
call SetUnitBonusDamageByIndex(CU,0,GetUnitBonusDamageByIndex(u,0))
return CU
endfunction
function CopyHero2 takes unit u returns unit
local integer id=GetUnitTypeId(u)
local integer i=0
set CU=CreateUnit(GetOwningPlayer(u),'H15O',0,0,0)
//set CU=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE),'H05O',0,0,0)
//call SetUnitOwner(CU,GetOwningPlayer(u),false)
call UnitAddAbility(CU,'A14Y')
call UnitAddAbility(CU,'A14Z')
call UnitAddAbility(CU,'Aloc')
call SetHeroLevel(CU,GetHeroLevel(u),false)
call SetHeroAgi(CU,GetHeroAgi(u,false),false)
call SetHeroStr(CU,GetHeroStr(u,false),false)
call SetHeroInt(CU,GetHeroInt(u,false),false)
call SetUnitTurnSpeed(CU,1000)
loop
exitwhen i>=6
call UnitAddItemById(CU,GetItemTypeId(UnitItemInSlot(u,i)))
set i=i+1
endloop
call SetUnitBaseDamageByIndex(CU,0,GetUnitBaseDamageByIndex(u,0))
call SetUnitBonusDamageByIndex(CU,0,GetUnitBonusDamageByIndex(u,0))
return CU
endfunction
function FrozenMinusManaIchigoCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,1)
local real life=LoadReal(h,id,0)
local real life2=GetWidgetMana(u)
local real dmg=0
if not(LoadBoolean(HH, GetHandleId(u), 9595)) and GetWidgetLife(u)>0 and udg_B==true and DU2==true then
