function HibariGQ1Act takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real damage=LoadReal(HH,id,15)
local real time=LoadReal(HH,id,5)
local real x0=GetUnitX(LoadUnitHandle(HH,id,20))
local real y0=GetUnitY(LoadUnitHandle(HH,id,20))
local real x1=LoadReal(HH,id,11)
local real y1=LoadReal(HH,id,12)
local real distance=SR(x0,y0,x1,y1)
local integer HibariGtype=LoadInteger(HH,id,19)




if distance<=45 or IsTerrainPathable(PolX(x0,50,facing),PolY(y0,50,facing),PATHING_TYPE_FLYABILITY)==true then
//call UnitSpeed(n0,0.1)
if HibariGtype==3 then
call EffectCreateAndMove(true,"Others\\DarkNova.mdl",facing,1,1,1,100,100,100,0,-100,LoadUnitHandle(HH,id,20),0,facing)
call EffectCreateAndMove(true,"Others\\Death Release.mdl",facing,1,3,1.5,100,100,100,0,-100,LoadUnitHandle(HH,id,20),0,facing)
endif

if HibariGtype==1 then
if LoadBoolean(HH,id,21)==true then
call EffectCreateAndMove(true,"Others\\Death Release.mdl",facing,1,2.25,1.25,100,100,100,0,-100,LoadUnitHandle(HH,id,20),0,facing)
else
call EffectCreateAndMove(true,"Others\\Death Release.mdl",facing,1,1.75,1.25,100,100,100,0,-100,LoadUnitHandle(HH,id,20),0,facing)
endif
endif

if HibariGtype==2 then
//
call SetUnitAnimationByIndex(LoadUnitHandle(HH,id,20),0)
//
call EffectCreateAndMove(true,"Others\\s_ShadowEruption_Rain.mdl",facing,1,2,1,100,100,100,0,-100,LoadUnitHandle(HH,id,20),0,facing)
endif

call EffectCreateAndMove(true,"Others\\az_slb.mdl",facing,1,2,1.5,100,100,100,50,0,LoadUnitHandle(HH,id,20),0,facing)
call EffectCreateAndMove(true,"Others\\HakkeStart2.mdl",facing,1,1,1.5,100,100,100,50,0,LoadUnitHandle(HH,id,20),0,facing)
call GroupClear(G)
if HibariGtype!=3 then
if LoadBoolean(HH,id,21)==true then
call GroupEnumUnitsInRange(G,GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),500,Base)
else
call GroupEnumUnitsInRange(G,GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),400,Base)
endif
endif
if HibariGtype==3 then
call GroupEnumUnitsInRange(G,GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),600,Base)
endif
loop
set n0=FirstOfGroup(G)
exitwhen n0==null

if  Condition_Base(GetOwningPlayer(caster),n0)   then

call myCustomDamage(caster,n0,damage,false,false,null,null,null)

if HibariGtype==1 then

call SetControlToUnit(n0,n0, 2, "stun")

if LoadBoolean(HH,id,21)==true then
call PushTimedHibari(n0,Angle2(GetUnitX(n0),GetUnitY(n0),x0,y0),40,400)
else
call PushTimedHibari(n0,Angle2(GetUnitX(n0),GetUnitY(n0),x0,y0),20,200)
endif

endif

if HibariGtype==2 then

call SetControlToUnit(n0,n0, 2, "stun")
endif




endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
if HibariGtype==2 then
call UnitAddAbility(LoadUnitHandle(HH,id,20),'KHQ3')
call MyRemoveUnit(LoadUnitHandle(HH,id,20),5)
call UnitSpeed(LoadUnitHandle(HH,id,20),1.5)
call EffectCreateAndMove(true,"Others\\HakkeStart2.mdl",facing,5,1,0.2,100,100,100,50,0,LoadUnitHandle(HH,id,20),0,facing)
endif
if HibariGtype==1 then
if LoadBoolean(HH,id,21)==true then
call UnitScale(LoadUnitHandle(HH,id,20),1.5,8,0.25)
else
call UnitScale(LoadUnitHandle(HH,id,20),1,6,0.25)
endif
call MyRemoveUnit(LoadUnitHandle(HH,id,20),1.5)
endif
if HibariGtype==3 then
call UnitScale(LoadUnitHandle(HH,id,20),1.5,12,0.25)
call HibariQBlockMove(LoadUnitHandle(HH,id,20))
call MyRemoveUnit(LoadUnitHandle(HH,id,20),5)
call UnitColor(LoadUnitHandle(HH,id,20),100,100,100,60)
call EffectCreateAndMove(true,"Others\\HakkeStart2.mdl",facing,5,1.5,0.2,100,100,100,50,0,LoadUnitHandle(HH,id,20),0,facing)
endif
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else
set time=time+0.02
if time==0.1 then
set time=0
call EffectCreateAndMove(true,"Others\\s_ShadowEruption_Rain.mdl",facing,0.5,0.5,1,100,100,100,0,0,LoadUnitHandle(HH,id,20),0,facing)
endif
call SaveReal(HH,id,5,time)
call MoveUnit(LoadUnitHandle(HH,id,20),LoadUnitHandle(HH,id,20),40,facing)
endif
set caster=null
endfunction


