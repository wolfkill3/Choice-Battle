function CastYotonYokaiNoJutsu4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x1=LoadReal(h,id,1)
local real y1=LoadReal(h,id,2)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local integer str=StringHash("number")
local real time=LoadReal(h,id,4)
local real dmg=GetHeroInt(u,true)*0.4
local player p=GetOwningPlayer(u)
local integer idu=GetPlayerId(p)
local integer idun=GetHandleId(Hero[idu])
local integer i=0
if time>0 then
        call SaveReal(h,id,4,time-0.2)
        call GroupEnumUnitsInRange(G,x1,y1,999999,Base)
        loop
        set E=FirstOfGroup(G)
        exitwhen E==null
                if SR(GetUnitX(E), GetUnitY(E), x1, y1)<=500 then
                        if Condition_Base(p,E)then
                                call myCustomDamage(u,E,dmg,false,false,null,null,null)
                                call SetControlToUnit(E,E, 0.5, "silenceTE")
                                call SlowUnit(u,E,0.85,0.85,0.2,2,false)
                        else
                                call SaveBoolean(h, GetHandleId(E), StringHash("MeiT_Shield"), true)
                        endif
                else
                        call SaveBoolean(h, GetHandleId(E), StringHash("MeiT_Shield"), false)
                endif
                call GroupRemoveUnit(G,E)
        endloop
        if SR(x,y,x1,y1)<400 then
                call SetUnitInvulnerable(u,true)
        else
                call SetUnitInvulnerable(u,false)
        endif
else
        loop
                exitwhen i>=31
                call RemoveDestructable(LoadDestructableHandle(h,idun,i))
                set i=i+1
        endloop
        call GroupEnumUnitsInRange(G,x1,y1,999999,Base)
        loop
        set E=FirstOfGroup(G)
        exitwhen E==null
                call SaveBoolean(h, GetHandleId(E), StringHash("MeiT_Shield"), false)
                call GroupRemoveUnit(G,E)
        endloop
        call DestroyGroup(LoadGroupHandle(h, id, GroupHash))
        call SetUnitInvulnerable(u,false)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set t=null
endfunction
