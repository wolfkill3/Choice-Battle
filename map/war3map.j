function FireFingerCond takes nothing returns boolean
return GetSpellAbilityId()==0x4130394B and udg_B==true
endfunction
function FireFingerCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local real l__d=LoadReal(h,id,8)
local player p=GetOwningPlayer(u)
local real f
if SR1(x,y,x1,y1)>32 and LoadBoolean(h,id,7)==false then
set x=x+60*Cos(a)
set y=y+60*Sin(a)
set n=CreateUnit(p,'e04J',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.75)
call UnitApplyTimedLife(CreateUnit(p,'e04A',x,y,a*bj_RADTODEG),'BTLF',1)
call SetUnitTimeScale(n,0)
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
else
call SaveBoolean(h,id,7,true)
call SaveReal(h,id,6,Atan2(y1-GetUnitY(u),x1-GetUnitX(u)))
endif
if l__d<500 and LoadBoolean(h,id,7)==true then
set a=LoadReal(h,id,6)
set x=x+60*Cos(a)
set y=y+60*Sin(a)
set n=CreateUnit(p,'e04J',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.75)
call UnitAddAbility(n,'Arav')
call UnitApplyTimedLife(CreateUnit(p,'e04A',x,y,a*bj_RADTODEG),'BTLF',1)
call SetUnitTimeScale(n,0)
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SetUnitXY_1(c,x,y, false)
call SaveReal(h,id,8,l__d+60)
elseif LoadBoolean(h,id,7)==true then
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call UnitApplyTimedLife(CreateUnit(p,'e01Z',x1,y1,GetRandomReal(0,359)),'BHwe',1)
call UnitApplyTimedLife(CreateUnit(p,'e048',x1,y1,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e03W',x1,y1,0),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e04C',x1,y1,0),'BTLF',4)
call DestroyEffect(AddSpecialEffect("war3mapImported\\SuperBigExplosion.mdx",x1,y1))
call myCustomDamage(u,c,(4+GetUnitAbilityLevel(u,0x4130394B))*GetHeroAgi(u,true),false,false,null,null,null)
call SlowUnit(u,c,0.4,0.4,5,2,false)
call SetControlToUnit(u,c,1, "stun")
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function FireFingerCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveReal(h,id,5,100)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,GetSpellTargetUnit())
call SaveReal(h,id,2,GetUnitX(u))
call SaveReal(h,id,3,GetUnitY(u))
set soundplay=SndN(983) // Sound\Music\mp3Music\TobuShiganBachi2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.03,true,function FireFingerCast2)
set u=null
set t=null
endfunction
function FireFingerInit takes nothing returns nothing
endfunction
