return GetSpellAbilityId()=='A0U4' and udg_B==true
endfunction
function GonPaperStopOrders2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
call IssueImmediateOrder(u,"stop")
call SetUnitFacing(u,Atan2(LoadReal(h,id,1)-GetUnitY(u),LoadReal(h,id,2)-GetUnitX(u))*bj_RADTODEG)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
set t=null
set u=null
endfunction
function GonPaperStopOrders takes nothing returns nothing
local unit u=GetOrderedUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
if GetOrderTargetUnit()==null then
call SaveReal(h,id,2,GetOrderPointX())
call SaveReal(h,id,1,GetOrderPointY())
else
call SaveReal(h,id,2,GetUnitX(GetOrderTargetUnit()))
call SaveReal(h,id,1,GetUnitY(GetOrderTargetUnit()))
endif
//call SetUnitAnimation(u,"Spell Channel One")
call TimerStart(t,0.001,false,function GonPaperStopOrders2)
set u=null
set t=null
endfunction
function PaperCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real a=LoadReal(h,id,11)
local real dist=LoadReal(h,id,2)
local real x=GetUnitX(l__d)+45*Cos(a)
local real y=GetUnitY(l__d)+45*Sin(a)
local real dmg=LoadReal(h,id,4)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,12)
local integer idg2=GetHandleId(g)
if dist>0 and IsTerrainPathable(GetUnitX(l__d),GetUnitY(l__d),PATHING_TYPE_FLYABILITY)==false and UnitIsAlive(l__d)then
call SetUnitXY_1(l__d,x,y, false)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitVertexColor(n,255,230,100,50)
set n=CreateUnit(p,'e0RE',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitVertexColor(n,255,230,100,50)
set n=CreateUnit(p,'e0RG',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitTimeScale(n,3)
call GroupEnumUnitsInRange(g,x,y,150,Base)
call SaveReal(h,id,2,dist-45)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg2,ide)!=E then
call KillUnit(l__d)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
else
call GroupEnumUnitsInRange(g,x,y,450,Base)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg2,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg2,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
call UnitApplyTimedLife(CreateUnit(p,'e0RH',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0RK',x,y,(a*bj_RADTODEG)),'BTLF',3)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.2,1.2,1.2)
call SetUnitTimeScale(n,0.6)
call SetUnitVertexColor(n,255,230,100,50)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitTimeScale(n,0.6)
call SetUnitVertexColor(n,255,230,100,50)
