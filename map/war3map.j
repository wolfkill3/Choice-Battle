call SaveInteger(h,id,6,0)
call SaveReal(h, id, StringHash("PointX"), GetSpellTargetX())
call SaveReal(h, id, StringHash("PointY"), GetSpellTargetY())
call SaveReal(h,id,3,Atan2(GetSpellTargetY()-GetUnitY(GetTriggerUnit()),GetSpellTargetX()-GetUnitX(GetTriggerUnit())))
