function HikenCond takes nothing returns boolean
return GetSpellAbilityId()=='A014' and udg_B==true
endfunction
function HikenCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local unit d1=LoadUnitHandle(h,id,6)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local group g=LoadGroupHandle(h,id,4)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,5)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroStr(u,true)*(1+GetUnitAbilityLevel(u,'A014'))+100
if SR(x,y,x1,y1)<=2000 and IsTerrainPathable(GetUnitX(l__d),GetUnitY(l__d),PATHING_TYPE_FLYABILITY)==false then
set x1=x1+62*Cos(a)
set y1=y1+62*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
call SetUnitX(d1,x1)
call SetUnitY(d1,y1)
call GroupEnumUnitsInRange(g,x1,y1,300,Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
if GetUnitAbilityLevel(u,'AcF1')>0 then
call PoisonDamage3Ace(u,E,GetHeroStr(u,true),4,"Environment\\LargeBuildingFire\\LargeBuildingFire1.mdl","origin")
endif
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
call UnitApplyTimedLife(CreateUnit(p,'e0IC',x1,y1,a*bj_RADTODEG),'BTLF',0.5)
call UnitApplyTimedLife(CreateUnit(p,'e0ID',x1,y1,a*bj_RADTODEG),'BTLF',0.5)
else
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
call RemoveUnit(l__d)
call RemoveUnit(d1)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,GetHandleId(g))
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
set d1=null
endfunction
function HikenCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,CreateUnit(GetOwningPlayer(u),'e0IE',x+80*Cos(a*bj_RADTODEG),y+80*Sin(a*bj_RADTODEG),a*bj_RADTODEG))
call SaveGroupHandle(h,id,4,CreateGroup())
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveReal(h,id,5,a)
call SaveUnitHandle(h,id,6,CreateUnit(GetOwningPlayer(u),'e0IB',x+80*Cos(a*bj_RADTODEG),y+80*Sin(a*bj_RADTODEG),a*bj_RADTODEG))
call TimerStart(t,0.04,true,function HikenCast2)
set soundplay=SndN(1555) // Sound\Music\mp3Music\Hiken.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set u=null
set t=null
endfunction
function HikenInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function HikenCast)
call TriggerAddCondition(t,Condition(function HikenCond))
set t=null
endfunction
