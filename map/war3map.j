function AltarisCond takes nothing returns boolean
return GetSpellAbilityId()=='A0I2'
endfunction
function AltarisCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local group g=LoadGroupHandle(h,id,5)
local group g2=LoadGroupHandle(h,id,6)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real x2
local integer ip=0
local real y2
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,5)
local real a2
local player p=GetOwningPlayer(u)
local real dmg=GetHeroInt(u,true)*0.09
local real dist=LoadReal(h,id,4)
// урон раз в 5 тиков (0.35 с) x5 — тот же урон в секунду, но обработчик урона в 5 раз реже (раньше 14 раз в секунду на цель)
local boolean hit=ModuloInteger(R2I(dist/20.+0.5),5)==0
if dist<=3000 then
call SaveReal(h,id,4,dist+20)
if IsTerrainPathable(x1+20*Cos(a),y1+20*Sin(a),PATHING_TYPE_FLYABILITY)==false then
call SetUnitX(l__d,x1+20*Cos(a))
call SetUnitY(l__d,y1+20*Sin(a))
endif
call GroupEnumUnitsInRange(g2,x1,y1,650,Base)
if ModuloReal(SR(x,y,x1,y1),14)<2 then
set EFF=AddSpecialEffect("war3mapImported\\SuperShinyThingy2.mdl", x1,y1)
call SetSpecialEffectScale(EFF , 2)
call SetSpecialEffectZ(EFF , 350)
call DestroyEffect(EFF)
endif
loop
set E=FirstOfGroup(g2)
set ip=GetPlayerId(GetOwningPlayer(E))
exitwhen E==null
if Condition_Base(p,E) then
if hit then
call myCustomDamage(u,E,dmg*5.,false,false,null,null,null)
endif
if LoadBoolean(HH,GetHandleId(E),DoflaTHash)==false then
set x2=GetUnitX(E)
set y2=GetUnitY(E)
set a2=Atan2(y2-y1,x2-x1)+1.35
call SetUnitX(E,x2-70*Cos(a2))
call SetUnitY(E,y2-70*Sin(a2))
endif
// «стоп» только если у цели есть приказ: каждый приказ запускает все триггеры приказов карты
if GetUnitCurrentOrder(E)!=0 then
call IssueImmediateOrder(E,"stop")
endif
if GetUnitFlyHeight(E)<500 then
call SetUnitFlyHeight(E,GetUnitFlyHeight(E)+2.6,0)
endif
if IsUnitInGroup(E,g)==false then
call UnitAddAbility(E,'Arav')
call UnitRemoveAbility(E,'Arav')
call GroupAddUnit(g,E)
call SetUnitPathing(E,false)
endif
endif
call GroupRemoveUnit(g2,E)
endloop
else
loop
set E=FirstOfGroup(g)
exitwhen E==null
call SetUnitFlyHeight(E,0,GetUnitFlyHeight(E))
call GroupRemoveUnit(g,E)
call SetUnitPathing(E,true)
endloop
call UnitApplyTimedLife(CreateUnit(p,'e0BT',x1,y1,a*bj_RADTODEG),'BTLF',1)
//call UnitApplyTimedLife(CreateUnit(p,0x65304256,x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0BU',x1,y1,a*bj_RADTODEG),'BTLF',1)
call DestroyTimer(t)
call DestroyGroup(g)
call DestroyGroup(g2)
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
endif
set u=null
set p=null
set t=null
set g=null
set g2=null
set l__d=null
endfunction
function AltarisCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
local unit l__d=CreateUnit(GetOwningPlayer(u),'e0BS',x+80*Cos(f*bj_RADTODEG),y+80*Sin(f*bj_RADTODEG),f)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,l__d)
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveReal(h,id,4,0)
call SaveReal(h,id,5,a)
call SaveGroupHandle(h,id,5,CreateGroup())
// группа для поиска целей — одна на всю способность (раньше создавалась каждый тик)
call SaveGroupHandle(h,id,6,CreateGroup())
set soundplay=SndN(1276) // Sound\Music\mp3Music\Altaris.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.07,true,function AltarisCast2)
set u=null
set t=null
set l__d=null
endfunction
function MissleMoveHeavenlyArrows2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit l__d=LoadUnitHandle(h,id,2)
local real speed=LoadReal(h,id,4)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)+LoadReal(h,id,3)
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>60 then
set x=x+speed*Cos(a)
set y=y+speed*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
set n=CreateUnit(p,'e0BP',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.25)
call SetUnitTimeScale(n,0)
else
call UnitApplyTimedLife(CreateUnit(p,0x6530424A,x,y,a*bj_RADTODEG),'BTLF',0.5)
call UnitApplyTimedLife(CreateUnit(p,0x6530424B,x,y,a*bj_RADTODEG),'BTLF',1)
call myCustomDamage(u,c,LoadReal(h,id,5),false,false,null,null,null)
call SetControlToUnit(u,c,0.08, "stun")
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
call KillUnit(l__d)
endif
set p=null
set l__d=null
set c=null
set t=null
set u=null
endfunction
function MissleMoveHeavenlyArrows takes unit u,unit c,unit l__d,real speed,real angle,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveUnitHandle(h,id,2,l__d)
call SaveReal(h,id,3,angle)
call SaveReal(h,id,4,speed)
call SaveReal(h,id,5,dmg)
call TimerStart(t,0.03,true,function MissleMoveHeavenlyArrows2)
set t=null
endfunction
function HeavenlyArrowsCond takes nothing returns boolean
return GetSpellAbilityId()=='A0HY'
endfunction
function HeavenlyArrowsCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real r=GetUnitFacing(u)*bj_DEGTORAD
if GetUnitCurrentOrder(u)==OrderId("channel")and UnitIsAlive(c)then
    if GetUnitTypeId(u)=='H12G' and GetUnitCurrentAnimationId(u)!=16 then
        call SetUnitAnimationByIndex(u,16)
    endif
    if GetUnitTypeId(u)=='H02G' then
        call SetUnitAnimationOffsetPercent(u,0.7)
        if GetUnitCurrentAnimationId(u)!=18 then
            call SetUnitAnimationByIndex(u,18)
        endif
    endif
    set n=CreateUnit(p,'e0BP',x+100*Cos(r),y+100*Sin(r),a*bj_RADTODEG)
    call MissleMoveHeavenlyArrows(u,c,n,70,GetRandomReal(-0.7,0.7),GetHeroInt(u,true)*0.5+15)
    call UnitApplyTimedLife(CreateUnit(p,'e0BM',x,y,a*bj_RADTODEG),'BTLF',0.5)
else
call SetUnitTimeScale(u,1)
call PauseTimer(t)
call DestroyTimer(t)
call RemoveUnit(LoadUnitHandle(h,id,2))
call RemoveUnit(LoadUnitHandle(h,id,3))
call FlushChildHashtable(h,id)
endif
set c=null
set p=null
set u=null
set t=null
endfunction
function HeavenlyArrowsCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,GetSpellTargetUnit())
call SaveUnitHandle(h,id,2,CreateUnit(GetOwningPlayer(u),'e0BH',GetUnitX(u),GetUnitY(u),0))
call SaveUnitHandle(h,id,3,CreateUnit(GetOwningPlayer(u),'e0BG',GetUnitX(u),GetUnitY(u),0))
set soundplay=SndN(1278) // Sound\Music\mp3Music\JellalQ.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.2,true,function HeavenlyArrowsCast2)
set u=null
set t=null
endfunction
function InitHeavenlyArrows takes nothing returns nothing
endfunction
function MissleMoveLucoraGun2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit c=LoadUnitHandle(h,id,1)
    local unit l__d=LoadUnitHandle(h,id,2)
    local real speed=LoadReal(h,id,4)
    //local real ux=GetUnitX(u)
    //local real uy=GetUnitY(u)
    local real x=GetUnitX(l__d)
    local real y=GetUnitY(l__d)
    local real x1=GetUnitX(c)
    local real y1=GetUnitY(c)
    local real x2=x1+LoadReal(h,id,6)
    local real y2=y1+LoadReal(h,id,7)
    local integer direct=LoadInteger(h,id,8)
    local real a=Atan2(y1-y,x1-x)+LoadReal(h,id,3)
    local real a2=Atan2(y2-y,x2-x)+LoadReal(h,id,3)
    local player p=GetOwningPlayer(u)
    if direct!=1 then
        if SR(x,y,x1,y1)>speed+5 then
            set x=x+speed*Cos(a)
            set y=y+speed*Sin(a)
            call SetUnitX(l__d,x)
            call SetUnitY(l__d,y)
            call SetUnitFacing(l__d,a*bj_RADTODEG)
            //set n=CreateUnit(p,'e0BP',x,y,a*bj_RADTODEG)
            //call UnitApplyTimedLife(n,'BTLF',0.25)
            //call SetUnitTimeScale(n,0)
        else
            call UnitApplyTimedLife(CreateUnit(p,'e0LG',x,y,GetRandomReal(0,359)),'BHwe',3)
            call UnitApplyTimedLife(CreateUnit(p,'e0QJ',x,y,GetRandomReal(0,359)),'BHwe',3)
            call UnitApplyTimedLife(CreateUnit(p,'e0LF',x,y,GetRandomReal(0,359)),'BHwe',3)
            //set soundplay=CreateSound("Sound\\Music\\mp3Music\\PunchStrike.mp3",false,false,true,12700,12700,"")
            //call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay)
            call myCustomDamage(u,c,LoadReal(h,id,5),false,false,null,null,null)
            call SetControlToUnit(u,c,0.06,"stun")
            call SlowUnit(u,c,0.5,0,5,0,false)
            call FlushChildHashtable(h,id)
            call PauseTimer(t)
            call DestroyTimer(t)
            call KillUnit(l__d)
        endif
    else
        if SR(x,y,x2,y2)>=speed+5 then
            set x=x+speed*Cos(a2)
            set y=y+speed*Sin(a2)
            call SetUnitX(l__d,x)
            call SetUnitY(l__d,y)
            call SetUnitFacing(l__d,a2*bj_RADTODEG)
            //set n=CreateUnit(p,'e0BP',x,y,a2*bj_RADTODEG)
            //call UnitApplyTimedLife(n,'BTLF',0.25)
            //call SetUnitTimeScale(n,0)
        else
            call GroupEnumUnitsInRange(DG,x,y,130,Base)
            loop
                set E=FirstOfGroup(DG)
                exitwhen E==null
                if Condition_Base(p,E)then
                    call myCustomDamage(u,E,LoadReal(h,id,5),false,false,null,null,null)
                    call SetControlToUnit(u,E,0.07,"stun")
                    call SlowUnit(u,E,0.5,0,5,0,false)
                endif
                call GroupRemoveUnit(DG,E)
            endloop
            call UnitApplyTimedLife(CreateUnit(p,'e0LG',x,y,GetRandomReal(0,359)),'BHwe',1)
            call UnitApplyTimedLife(CreateUnit(p,'e0G3',x,y,GetRandomReal(0,359)),'BHwe',1)
            call UnitApplyTimedLife(CreateUnit(p,'e0LF',x,y,GetRandomReal(0,359)),'BHwe',1)
            set soundplay=SndN(1280) // Sound\Music\mp3Music\PunchStrike.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            call PauseTimer(t)
            call DestroyTimer(t)
            call FlushChildHashtable(h,id)
            call KillUnit(l__d)
        endif
    endif
    set p=null
    set l__d=null
    set c=null
    set t=null
    set u=null
endfunction
function MissleMoveLucoraGun takes unit u,unit c,unit l__d,real speed,real angle,real dmg,real x,real y,integer rand returns nothing
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    call SaveUnitHandle(h,id,0,u)
    call SaveUnitHandle(h,id,1,c)
    call SaveUnitHandle(h,id,2,l__d)
    call SaveReal(h,id,3,angle)
    call SaveReal(h,id,4,speed)
    call SaveReal(h,id,5,dmg)
    call SaveReal(h,id,6,x)
    call SaveReal(h,id,7,y)
    call SaveInteger(h,id,8,rand)    
    call TimerStart(t,0.03,true,function MissleMoveLucoraGun2)
    set t=null
endfunction
function LucoraGunCond takes nothing returns boolean //Vegeta E
    return GetSpellAbilityId()=='A2HY'
endfunction
function LucoraGunCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local unit c=LoadUnitHandle(h,id,1)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetUnitX(c)
    local real y1=GetUnitY(c)
    local real a=Atan2(y1-y,x1-x)
    local player p=GetOwningPlayer(u)
    local real r=GetUnitFacing(u)*bj_DEGTORAD
    local real dmg=GetHeroStr(u,true)*0.4+30
    if GetUnitCurrentOrder(u)==OrderId("channel")and UnitIsAlive(c)then
    call SetUnitFacing(u,a*bj_RADTODEG)
    // в SSG урон снарядов +10%, в SSGSS +15%
    if GetUnitAbilityLevel(u,'VGH5')>0 then
        set dmg=dmg*1.1
    elseif GetUnitAbilityLevel(u,'VGH6')>0 then
        set dmg=dmg*1.15
    endif
    set n=CreateUnit(p,'e0BP',x+GetRandomReal(120,140)*Cos(r),y+GetRandomReal(120,140)*Sin(r),a*bj_RADTODEG)
    call MissleMoveLucoraGun(u,c,n,80,GetRandomReal(-0.3,0.3),dmg,GetRandomReal(-0.20*SR(x,y,x1,y1),0.20*SR(x,y,x1,y1)),GetRandomReal(-0.20*SR(x,y,x1,y1),0.20*SR(x,y,x1,y1)),GetRandomInt(0,2))
    call UnitApplyTimedLife(CreateUnit(p,'e1BQ',x+GetRandomReal(40,90)*Cos(r),y+GetRandomReal(40,90)*Sin(r),a*bj_RADTODEG-180),'BTLF',0.5)
    else
    call SetUnitTimeScale(u,1)
    call PauseTimer(t)
    call DestroyTimer(t)
    //call RemoveUnit(LoadUnitHandle(h,id,2))
    //call RemoveUnit(LoadUnitHandle(h,id,3))
    call FlushChildHashtable(h,id)
    endif
    set c=null
    set p=null
    set u=null
    set t=null
endfunction
function LucoraGunCast takes nothing returns nothing
    local unit u=GetTriggerUnit()
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    call SaveUnitHandle(h,id,0,u)
    call SaveUnitHandle(h,id,1,GetSpellTargetUnit())
    //call SaveUnitHandle(h,id,2,CreateUnit(GetOwningPlayer(u),'e0BH',GetUnitX(u),GetUnitY(u),0))
    //call SaveUnitHandle(h,id,3,CreateUnit(GetOwningPlayer(u),'e0BG',GetUnitX(u),GetUnitY(u),0))
    if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
        set soundplay=SndN(1283) // Sound\Music\mp3Music\VegetaE.mp3
    else
        set soundplay=SndN(1285) // Sound\Music\mp3Music\Vegeta\VegetaE-jap.mp3
    endif
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    call TimerStart(t,0.15,true,function LucoraGunCast2)
    set u=null
    set t=null
endfunction
function InitLucoraGun takes nothing returns nothing
endfunction
function MeteorFuncCond takes nothing returns boolean
return GetSpellAbilityId()=='A0HX' or GetSpellAbilityId()=='A2HX'
endfunction
function MeteorFuncCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real m=GetUnitState(u,UNIT_STATE_MANA)
local real mx=GetUnitState(u,UNIT_STATE_MAX_MANA)
if m>mx*.02 and GetUnitAbilityLevel(u,'JlF1')>0 and GetWidgetLife(u)>0.5 and LoadBoolean(HH,GetHandleId(u),SST)==true then
if IsUnitPaused(u)==false and IsUnitHidden(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
call SetUnitState(u,UNIT_STATE_MANA,m-mx*0.0018)
endif
else
call SaveBoolean(HH,GetHandleId(u),SS,false)
call SaveBoolean(HH,GetHandleId(u),SST,false)
call UnitRemoveType(u,UNIT_TYPE_FLYING)
call UnitRemoveAbility(u,'A0HW')
call SetUnitPathing(u,true)
call UnitRemoveAbility(u,'A0IX')
call UnitRemoveAbility(u,'B03A')
call UnitRemoveAbility(u,'B005')
call UnitRemoveAbility(u,'B035')
call SetUnitFlyHeight(u,0,0)
call ShowAbility2('A2HX',false)
call ShowAbility2('A0HX',true)
call StartAbilityCooldown(GetUnitAbility(u,'A0HX'),5)
call UnitRemoveAbility(u,'JlF1')
call FlushChildHashtable(h,id)
call SetUnitTimeScale(u,1)
call PauseTimer(t)
call DestroyTimer(t)
endif
set u=null
set t=null
endfunction
function MeteorFuncCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
if GetSpellAbilityId()=='A0HX' then
call SaveUnitHandle(h,id,0,u)
call SetUnitPathing(u,false)
call UnitAddType(u,UNIT_TYPE_FLYING)
call UnitAddAbility(u,'Arav')
call UnitRemoveAbility(u,'Arav')
call UnitAddAbility(u,'A0HW')
call SetUnitFlyHeight(u,GetRandomReal(50,200),0)
call UnitAddAbility(u,'A0IX')
call SetUnitTimeScale(u,2)
call UnitApplyTimedLife(CreateUnit(p,'e0BF',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0BD',x,y,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0BR',x,y,GetRandomReal(0,359)),'BTLF',0.4)
set n=CreateUnit(p,'e0BC',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.45)
call SetUnitTimeScale(n,3)
call ShowAbility2Timed('A0HX',false,0.01)
call ShowAbility2Timed('A2HX',true,0.03)
call StartAbilityCooldown(GetUnitAbility(u,'A2HX'),1)
call UnitAddAbility(u,'JlF1')
call SaveBoolean(HH,GetHandleId(u),SST,true)
if LoadInteger(h,GetHandleId(u),GokuUIMusicHash)==0 then
set soundplay=SndN(1287) // Sound\Music\mp3Music\Meteor.mp3
call StartSound(soundplay)
// call KillSoundWhenDone(soundplay)
call SaveInteger(h,GetHandleId(u),GokuUIMusicHash,1)
call RemoveSaveHashTimed(4,GetHandleId(u),GokuUIMusicHash)
endif
else
call SaveBoolean(HH,GetHandleId(u),SST,false)
call ShowAbility2Timed('A2HX',false,0.01)
call ShowAbility2Timed('A0HX',true,0.03)
call UnitRemoveAbility(u,'JlF1')
endif
if LoadBoolean(HH,GetHandleId(u),SS)==false then
    call SaveBoolean(HH,GetHandleId(u),SS,true)
    call TimerStart(t,0.03,true,function MeteorFuncCast2)
endif
set u=null
set t=null
endfunction
function MeteorFuncInit takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function MeteorFuncCond))
call TriggerAddAction(t,function MeteorFuncCast)
set t=null
endfunction
function MeteorCond takes nothing returns boolean
return GetIssuedOrderId()==OrderId("smart")and GetUnitAbilityLevel(GetTriggerUnit(),'JlF1')>0
endfunction
function MeteorCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local integer idu=GetHandleId(u)
local integer str=SH_firewalk
local integer str3=SH_firewalkcond
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,idu,str)
local real y1=LoadReal(h,idu,str+1)
local real a=Atan2(y1-y,x1-x)+LoadReal(h,idu,str+2)
local real speed=30
local player p=GetOwningPlayer(u)
if OrderId2String(GetUnitCurrentOrder(u))=="smart"and GetUnitAbilityLevel(u,'JlF1')>0 and SR(x,y,x1,y1)>speed+10 and GetUnitAbilityLevel(u, 'CBC2')==0 and GetUnitAbilityLevel(u, 'CBC1')==0 and GetUnitAbilityLevel(u, 'cbc4')==0 and GetUnitAbilityLevel(u, 'cbc6')==0 and GetUnitAbilityLevel(u, 'cbc5')==0  and GetUnitAbilityLevel(u, 'cbc7')==0 and GetUnitAbilityLevel(u, 'cbc8')==0 and GetUnitAbilityLevel(u, 'cbc9')==0 and IsUnitPaused(u)==false then
set x=x+speed*(1+SpeedRes*0.01)*Cos(a)
set y=y+speed*(1+SpeedRes*0.01)*Sin(a)
call SetUnitXY_1(u,x,y, false)
call SetUnitFacing(u,a*bj_RADTODEG)
set n=CreateUnit(p,'e0BI',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.6)
call SetUnitFlyHeight(n,GetUnitFlyHeight(u)+95,0)
call SetUnitPathing(n,false)
call SetUnitTimeScale(n,0)
call SetUnitX(n,x)
call SetUnitY(n,y)
else
call SaveBoolean(h,idu,str3,false)
call RemoveSavedReal(h,idu,str+2)
call RemoveSavedReal(h,idu,str+1)
call RemoveSavedReal(h,idu,str)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set t=null
endfunction
function MeteorCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local real x=GetOrderPointX()
local real y=GetOrderPointY()
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local integer idu=GetHandleId(u)
local integer str=SH_firewalk
local integer str3=SH_firewalkcond
if x!=0 and y!=0 and x1!=x and y1!=y then
call SaveReal(h,idu,str,x)
call SaveReal(h,idu,str+1,y)
call SaveReal(h,idu,str+2,GetRandomReal(-0.75,0.75))
if LoadBoolean(h,idu,str3)==false then
call SaveUnitHandle(h,id,0,u)
call SaveBoolean(h,idu,str3,true)
set soundplay=SndN(1289) // Sound\Music\mp3Music\Wink.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.02,true,function MeteorCast2)
endif
endif
set u=null
set t=null
endfunction
function MeteorInit takes nothing returns nothing
endfunction
function ChariotMissleFly2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)+angle
local real dist=LoadReal(h,id,6)
local real mh=LoadReal(h,id,5)
local real rad=LoadReal(h,id,7)
local real rd=SR(x,y,x1,y1)
local real dmg=LoadReal(h,id,8)
local player p=GetOwningPlayer(l__d)
local integer idu=GetPlayerId(p)
local integer ip=GetHandleId(Hero[GetPlayerId(p)])
local group g=LoadGroupHandle(h,ip,SH_jg)
local real cof=rd/dist
if rd>speed+30 then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SaveReal(h,id,1,speed*1.06)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,mh*cof+50,0)
else
set idg=GetHandleId(g)
call GroupEnumUnitsInRange(G,x1,y1,400,Base)
loop
set E=FirstOfGroup(G)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
call myCustomDamage(Hero[GetPlayerId(p)],E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(G,E)
endloop
call UnitApplyTimedLife(CreateUnit(p,'e0LA',x1,y1,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0L8',x1,y1,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0L9',x1,y1,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0C7',x1,y1,(a*bj_RADTODEG)),'BTLF',6)
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set l__d=null
set t=null
    set g=null
endfunction
function ChariotMissleFly takes unit l__d,real speed,real angle,real x,real y,real mh,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle*bj_DEGTORAD)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,mh)
call SaveReal(h,id,6,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,8,dmg)
call TimerStart(t,0.03,true,function ChariotMissleFly2)
set t=null
endfunction
function CondGrandChariot takes nothing returns boolean
return GetSpellAbilityId()=='A0HZ'
endfunction
function GrandChariotCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local integer ip=GetHandleId(Hero[GetPlayerId(GetOwningPlayer(LoadUnitHandle(h,id,0)))])
call DestroyGroup(LoadGroupHandle(h,ip,SH_jg))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set t=null
endfunction
function CastGrandChariot2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local group g=LoadGroupHandle(h,id,2)
local real x1
local real y1
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x2=LoadReal(h,id,6)
local real y2=LoadReal(h,id,7)
local real sr=SR(x,y,x2,y2)
local real f
local real a=LoadReal(h,id,3)
local real a2=a*bj_RADTODEG
local real a3=a-deg90
local integer i=10
local real he
local real dmg=GetHeroInt(u,true)*(6+GetUnitAbilityLevel(u,'A0HZ'))
local player p=GetOwningPlayer(u)
call RemoveUnit(LoadUnitHandle(h,id,4))
loop
exitwhen i>=16
call RemoveLightning(LoadLightningHandle(h,id,i),1.5)
set i=i+1
endloop
loop
set E=FirstOfGroup(g)
exitwhen E==null
call UnitApplyTimedLife(E,'BTLF',1.5)
call GroupRemoveUnit(g,E)
endloop
set n=CreateUnit(p,'e0BQ',x-430*Cos(a3),y-430*Sin(a3),a2)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitFlyHeight(n,1500,0)
set n=CreateUnit(p,'e0BE',x-430*Cos(a3),y-430*Sin(a3),a2)
call SetUnitFlyHeight(n,1500,0)
set x1=GetUnitX(n)
set y1=GetUnitY(n)
call ChariotMissleFly(n,25,0,x1+sr*Cos(a),y1+sr*Sin(a),1500,dmg)
set n=CreateUnit(p,'e0BQ',x-100*Cos(a3),y-100*Sin(a3),a2)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitFlyHeight(n,1500,0)
set n=CreateUnit(p,'e0BE',x-100*Cos(a3),y-100*Sin(a3),a2)
call SetUnitFlyHeight(n,1500,0)
set x1=GetUnitX(n)
set y1=GetUnitY(n)
call ChariotMissleFly(n,25,0,x1+sr*Cos(a),y1+sr*Sin(a),1500,dmg)
set n=CreateUnit(p,'e0BQ',x+200*Cos(a3),y+200*Sin(a3),a2)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitFlyHeight(n,1640,0)
set n=CreateUnit(p,'e0BE',x+200*Cos(a3),y+200*Sin(a3),a2)
call SetUnitFlyHeight(n,1640,0)
set x1=GetUnitX(n)
set y1=GetUnitY(n)
call ChariotMissleFly(n,25,0,x1+(sr+100)*Cos(a),y1+(sr+100)*Sin(a),1640,dmg)
set n=CreateUnit(p,'e0BQ',x+350*Cos(a3),y+350*Sin(a3),a2)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitFlyHeight(n,1880,0)
set n=CreateUnit(p,'e0BE',x+350*Cos(a3),y+350*Sin(a3),a2)
call SetUnitFlyHeight(n,1880,0)
set x1=GetUnitX(n)
set y1=GetUnitY(n)
call ChariotMissleFly(n,25,0,x1+(sr+300)*Cos(a),y1+(sr+300)*Sin(a),1880,dmg)
set n=CreateUnit(p,'e0BQ',x+330*Cos(a3),y+330*Sin(a3),a2)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitFlyHeight(n,2150,0)
set n=CreateUnit(p,'e0BE',x+330*Cos(a3),y+330*Sin(a3),a2)
call SetUnitFlyHeight(n,2150,0)
set x1=GetUnitX(n)
set y1=GetUnitY(n)
call ChariotMissleFly(n,25,0,x1+(sr+450)*Cos(a),y1+(sr+450)*Sin(a),2150,dmg)
set n=CreateUnit(p,'e0BQ',x+330*Cos(a3),y+330*Sin(a3),a2)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitFlyHeight(n,2400,0)
set n=CreateUnit(p,'e0BE',x+330*Cos(a3),y+330*Sin(a3),a2)
call SetUnitFlyHeight(n,2400,0)
set x1=GetUnitX(n)
set y1=GetUnitY(n)
call ChariotMissleFly(n,25,0,x1+(sr+700)*Cos(a),y1+(sr+700)*Sin(a),2400,dmg)
set n=CreateUnit(p,'e0BQ',x+700*Cos(a3),y+700*Sin(a3),a2)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitFlyHeight(n,2150,0)
set n=CreateUnit(p,'e0BE',x+700*Cos(a3),y+700*Sin(a3),a2)
call SetUnitFlyHeight(n,2150,0)
set x1=GetUnitX(n)
set y1=GetUnitY(n)
call ChariotMissleFly(n,25,0,x1+(sr+450)*Cos(a),y1+(sr+450)*Sin(a),2150,dmg)
call UnitRemoveAbility(u,'A0QL')
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
call SetUnitFlyHeight(u,0,GetUnitFlyHeight(u))
call DestroyGroup(g)
call CambugTimed(6)
call PauseTimer(t)
call TimerStart(t,3,false,function GrandChariotCast3)
set g=null
set p=null
set t=null
set u=null
endfunction
function CastGrandChariot takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real f=GetUnitFacing(u)*bj_DEGTORAD
local real a=Atan2(y-y1,x-x1)
local real a2=a*bj_RADTODEG
local group g=CreateGroup()
call SaveReal(h,id,3,a)
call SaveReal(h,id,6,x)
call SaveReal(h,id,7,y)
call SaveGroupHandle(h,GetHandleId(u),SH_jg,CreateGroup())
call SaveUnitHandle(h,id,4,CreateUnit(p,0x6530424F,x1,y1,a*bj_RADTODEG))
call UnitAddAbility(u,'Arav')
call UnitRemoveAbility(u,'Arav')
call SetUnitFlyHeight(u,1700,0)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
set a=a-90*bj_DEGTORAD
call SaveUnitHandle(h,id,0,u)
set n=CreateUnit(p,'e0BN',x1-430*Cos(a),y1-430*Sin(a),a2)
call GroupAddUnit(g,n)
call SetUnitFlyHeight(n,1500,0)
set d=CreateUnit(p,'e0BN',x1-100*Cos(a),y1-100*Sin(a),a2)
call GroupAddUnit(g,d)
call SetUnitFlyHeight(d,1500,0)
call SaveLightningHandle(h,id,10,AddLightningEx("HWSB",true,GetUnitX(n),GetUnitY(n),GetUnitFlyHeight(n)-25,GetUnitX(d),GetUnitY(d),GetUnitFlyHeight(d)-25))
set n=CreateUnit(p,'e0BN',x1+200*Cos(a),y1+200*Sin(a),a2)
call GroupAddUnit(g,n)
call SetUnitFlyHeight(n,1640,0)
call SaveLightningHandle(h,id,11,AddLightningEx("HWSB",true,GetUnitX(d),GetUnitY(d),GetUnitFlyHeight(d)-25,GetUnitX(n),GetUnitY(n),GetUnitFlyHeight(n)-25))
set d=CreateUnit(p,'e0BN',x1+350*Cos(a),y1+350*Sin(a),a2)
call GroupAddUnit(g,d)
call SetUnitFlyHeight(d,1880,0)
call SaveLightningHandle(h,id,12,AddLightningEx("HWSB",true,GetUnitX(n),GetUnitY(n),GetUnitFlyHeight(n)-25,GetUnitX(d),GetUnitY(d),GetUnitFlyHeight(d)-25))
set n=CreateUnit(p,'e0BN',x1+100*Cos(a),y1+100*Sin(a),a2)
call GroupAddUnit(g,n)
call SetUnitFlyHeight(n,2150,0)
call SaveLightningHandle(h,id,13,AddLightningEx("HWSB",true,GetUnitX(d),GetUnitY(d),GetUnitFlyHeight(d)-25,GetUnitX(n),GetUnitY(n),GetUnitFlyHeight(n)-25))
set d=CreateUnit(p,'e0BN',x1+330*Cos(a),y1+330*Sin(a),a2)
call GroupAddUnit(g,d)
call SetUnitFlyHeight(d,2400,0)
call SaveLightningHandle(h,id,14,AddLightningEx("HWSB",true,GetUnitX(n),GetUnitY(n),GetUnitFlyHeight(n)-25,GetUnitX(d),GetUnitY(d),GetUnitFlyHeight(d)-25))
set n=CreateUnit(p,'e0BN',x1+700*Cos(a),y1+700*Sin(a),a2)
call GroupAddUnit(g,n)     
call SetUnitFlyHeight(n,2150,0)
call SaveLightningHandle(h,id,15,AddLightningEx("HWSB",true,GetUnitX(d),GetUnitY(d),GetUnitFlyHeight(d)-25,GetUnitX(n),GetUnitY(n),GetUnitFlyHeight(n)-25))
call SaveGroupHandle(h,id,2,g)
set soundplay=SndN(1291) // Sound\Music\mp3Music\GrandChariot.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call UnitAddAbility(u,'A0QL')
call TimerStart(t,2,false,function CastGrandChariot2)
set g=null
set p=null
set u=null
set t=null
endfunction
function GrandChariotInit takes nothing returns nothing
endfunction
function PowerDownGoku takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local player p=GetOwningPlayer(u)
    local integer idp=GetHandleId(p)
    local real time=LoadReal(h,id,1)
    call SaveReal(h,id,1,time+0.1)
    if GetUnitAbilityLevel(u,'GkH7')>0 then
        if ModuloReal(time,5)<0.1 and LoadInteger(HH,idp,UIDodgeHash)<LoadInteger(HH,idp,UIMaxDodgeHash) then
        call SaveInteger(HH,idp,UIDodgeHash,LoadInteger(HH,idp,UIDodgeHash)+1)
        endif
    endif
    if GetUnitAbilityLevel(u,'GkH8')>0 then
        if ModuloReal(time,1)<0.1 and LoadInteger(HH,idp,UIDodgeHash)<LoadInteger(HH,idp,UIMaxDodgeHash) then
        call SaveInteger(HH,idp,UIDodgeHash,LoadInteger(HH,idp,UIDodgeHash)+1)
        endif
    endif
    if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
        if GetUnitAbilityLevel(u,'GkH1')>0 then
            call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.0003)
        endif
        if GetUnitAbilityLevel(u,'GkH2')>0 then
            call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.0005)
        endif
        if GetUnitAbilityLevel(u,'GkH3')>0 then
            call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.0008)
        endif
        if GetUnitAbilityLevel(u,'GkH4')>0 then
            call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.001)
        endif
        if GetUnitAbilityLevel(u,'GkH5')>0 then
            call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.0009)
        endif
        if GetUnitAbilityLevel(u,'GkH6')>0 then
            call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.00135)
        endif
        if GetUnitAbilityLevel(u,'GkH7')>0 then
            call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.00225)
        endif
        if GetUnitAbilityLevel(u,'GkH8')>0 then
            call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.003)
        endif
    else
        if GetUnitState(u,UNIT_STATE_MAX_MANA)*0.05>GetUnitState(u,UNIT_STATE_MANA) then
            if GetUnitAbilityLevel(u,'GkH1')>0 then
                call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.00015)
            endif
            if GetUnitAbilityLevel(u,'GkH2')>0 then
                call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.00025)
            endif
            if GetUnitAbilityLevel(u,'GkH3')>0 then
                call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.0004)
            endif
            if GetUnitAbilityLevel(u,'GkH4')>0 then
                call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.0005)
            endif
            if GetUnitAbilityLevel(u,'GkH5')>0 then
                call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.00045)
            endif
            if GetUnitAbilityLevel(u,'GkH6')>0 then
                call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.000675)
            endif
            if GetUnitAbilityLevel(u,'GkH7')>0 then
                call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.001125)
            endif
            if GetUnitAbilityLevel(u,'GkH8')>0 then
                call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.0015)
            endif
        endif
    endif
    if GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.1>GetUnitState(u,UNIT_STATE_LIFE) or GetUnitState(u,UNIT_STATE_MAX_MANA)*0.04>GetUnitState(u,UNIT_STATE_MANA) or LoadBoolean(HH,GetHandleId(u),SST)==true then
        if GetUnitModel(u)=="GokuSS4.mdx" then 
            call SetUnitModel(u,"GokuLow.mdx")
        endif
        if GetUnitAbilityLevel(u,'GkH7')>0 then
            call StartAbilityCooldown(GetUnitAbility(u,'GKUI'),50)
            call StartAbilityCooldown(GetUnitAbility(u,'GKMI'),50)
            call StartAbilityCooldown(GetUnitAbility(u,'GKW1'),GetAbilityRemainingCooldown(GetUnitAbility(u,'GKW5')))
        endif
        if GetUnitAbilityLevel(u,'GkH8')>0 then
            if GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.1>GetUnitState(u,UNIT_STATE_LIFE) or GetUnitState(u,UNIT_STATE_MAX_MANA)*0.04>GetUnitState(u,UNIT_STATE_MANA) then
                call SaveBoolean(HH,GetHandleId(u),SS,false)
                call SaveBoolean(HH,GetHandleId(u),SST,false)
                call SetControlToUnit(u,u,1,"heavystun")
                call SetControlToUnit(u,u,4,"SilenceTE")
                call SlowUnit(u,u,0.5,0.5,7,2,false)
                call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",GetUnitX(u),GetUnitY(u)))
                call StartAbilityCooldown(GetUnitAbility(u,'GKUI'),75)
                call StartAbilityCooldown(GetUnitAbility(u,'GKMI'),75)
                call StartAbilityCooldown(GetUnitAbility(u,'GKW1'),GetAbilityRemainingCooldown(GetUnitAbility(u,'GKW5')))
                call SaveInteger(HH,idp,UIDodgeHash,0)
                call SaveInteger(HH,idp,UIMaxDodgeHash,0)
                call UnitRemoveAbility(u,'GkH1')
                call UnitRemoveAbility(u,'GkH2')
                call UnitRemoveAbility(u,'GkH3')
                call UnitRemoveAbility(u,'GkH4')
                call UnitRemoveAbility(u,'GkH5')
                call UnitRemoveAbility(u,'GkH6')
                call UnitRemoveAbility(u,'GkH7')
                call UnitRemoveAbility(u,'GkH8')
                call UnitRemoveAbility(u,'A4AU')
                call ShowAbility2('GKSS',true)
                call ShowAbility2('GKS2',true)
                call ShowAbility2('GKS3',true)
                call ShowAbility2('GKS4',true)
                call ShowAbility2('GKSR',true)
                call ShowAbility2('GKSB',true)
                call ShowAbility2('GKUI',true)
                call ShowAbility2('GKBB',false)
                call ShowAbility2('GKBI',false)
                call ShowAbility2('GKF1',true)
                call ShowAbility2('GKG6',false)
                call ShowAbility2('GKG7',false)
                call ShowAbility2('GKG1',true)
                call ShowAbility2('GKW5',false)
                call ShowAbility2('GKW1',true)
                call UnitAddAbility(u,'GkH0')
                call SetUnitAbilityLevel(u,'A0NM',1)
                call UnitMakeAbilityPermanent(u,true,'GkH0')
                if LoadReal(HH,GetHandleId(GetOwningPlayer(Goku)),VariationQHash)==2 or LoadReal(HH,GetHandleId(GetOwningPlayer(Goku)),VariationQHash)==3 or LoadReal(HH,GetHandleId(GetOwningPlayer(Goku)),VariationQHash)==4 then
                    call SaveReal(HH,GetHandleId(GetOwningPlayer(Goku)),VariationQHash,0)
                    call SetAbilityIntegerLevelField(GetUnitAbility(Goku,'GKQ1'), ABILITY_ILF_MANA_COST,GetUnitAbilityLevel(Goku,'GKQ1')-1,30*GetUnitAbilityLevel(Goku,'GKQ1'))
                endif
                call SaveReal(HH,GetHandleId(GetOwningPlayer(Goku)),VariationWHash,0)
                call PauseTimer(t)
                call DestroyTimer(t)
                call FlushChildHashtable(h,id)
            else
                call SaveBoolean(HH,GetHandleId(u),SS,true)
                if LoadInteger(HH,idp,UIDodgeHash)>10 then
                    call SaveInteger(HH,idp,UIDodgeHash,10)
                endif
                call SaveInteger(HH,idp,UIMaxDodgeHash,10)
                call ShowAbility2('GKSS',false)
                call ShowAbility2('GKS2',false)
                call ShowAbility2('GKS3',false)
                call ShowAbility2('GKS4',false)
                call ShowAbility2('GKSR',false)
                call ShowAbility2('GKSB',false)
                call ShowAbility2('GKUI',false)
                call ShowAbility2('GKG1',false)
                call ShowAbility2('GKG6',false)
                call ShowAbility2('GKG7',true)
                call ShowAbility2('GKW1',false)
                call ShowAbility2('GKW5',true)
                call UnitRemoveAbilityTimed(u,'GkH8',0.2)
                call UnitAddAbility(u,'GkH7')
                call UnitMakeAbilityPermanent(u,true,'GkH7')
                call ShowAbility2('GKBI',false)
                call ShowAbility2('GKF1',true)
                call StartAbilityCooldown(GetUnitAbility(u,'GKMI'),25)
                set EFF=AddSpecialEffect("rasengan_eff4.mdx", GetUnitX(u),GetUnitY(u))
                call SetSpecialEffectZ(EFF , 15)
                call SetSpecialEffectScale(EFF , 1.4)
                call SetSpecialEffectTimeScale(EFF , 0.6)
                call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 1)
                // call BJDebugMsg("Test")
                call SaveBoolean(HH,GetHandleId(u),SST,false)
            endif
        else
            call SaveBoolean(HH,GetHandleId(u),SS,false)
            call SaveBoolean(HH,GetHandleId(u),SST,false)
            call SaveInteger(HH,idp,UIDodgeHash,0)
            call SaveInteger(HH,idp,UIMaxDodgeHash,0)
            call UnitRemoveAbility(u,'GkH1')
            call UnitRemoveAbility(u,'GkH2')
            call UnitRemoveAbility(u,'GkH3')
            call UnitRemoveAbility(u,'GkH4')
            call UnitRemoveAbility(u,'GkH5')
            call UnitRemoveAbility(u,'GkH6')
            call UnitRemoveAbility(u,'GkH7')
            call UnitRemoveAbility(u,'GkH8')
            call UnitRemoveAbility(u,'A4AU')
            call ShowAbility2('GKSS',true)
            call ShowAbility2('GKS2',true)
            call ShowAbility2('GKS3',true)
            call ShowAbility2('GKS4',true)
            call ShowAbility2('GKSR',true)
            call ShowAbility2('GKSB',true)
            call ShowAbility2('GKUI',true)
            call ShowAbility2('GKBB',false)
            call ShowAbility2('GKBI',false)
            call ShowAbility2('GKF1',true)
            call ShowAbility2('GKG6',false)
            call ShowAbility2('GKG7',false)
            call ShowAbility2('GKG1',true)
            call ShowAbility2('GKW5',false)
            call ShowAbility2('GKW1',true)
            call UnitAddAbility(u,'GkH0')
            call SetUnitAbilityLevel(u,'A0NM',1)
            call UnitMakeAbilityPermanent(u,true,'GkH0')
            if LoadReal(HH,GetHandleId(GetOwningPlayer(Goku)),VariationQHash)==2 or LoadReal(HH,GetHandleId(GetOwningPlayer(Goku)),VariationQHash)==3 or LoadReal(HH,GetHandleId(GetOwningPlayer(Goku)),VariationQHash)==4 then
                call SaveReal(HH,GetHandleId(GetOwningPlayer(Goku)),VariationQHash,0)
                call SetAbilityIntegerLevelField(GetUnitAbility(Goku,'GKQ1'), ABILITY_ILF_MANA_COST,GetUnitAbilityLevel(Goku,'GKQ1')-1,30*GetUnitAbilityLevel(Goku,'GKQ1'))
            endif
            call SaveReal(HH,GetHandleId(GetOwningPlayer(Goku)),VariationWHash,0)
            call PauseTimer(t)
            call DestroyTimer(t)
            call FlushChildHashtable(h,id)
        endif
    endif
    set t=null
    set u=null
    set p=null
endfunction
function PowerUpGokuCond takes nothing returns boolean
return (GetSpellAbilityId()=='GKBS' or GetSpellAbilityId()=='GKBB' or GetSpellAbilityId()=='GKBI' or GetSpellAbilityId()=='GKSS' or GetSpellAbilityId()=='GKS2' or GetSpellAbilityId()=='GKS3' or GetSpellAbilityId()=='GKS4' or GetSpellAbilityId()=='GKSR' or GetSpellAbilityId()=='GKSB' or GetSpellAbilityId()=='GKUI' or GetSpellAbilityId()=='GKMI') and udg_B==true and IsAbilityEnabled(GetUnitAbility(GetTriggerUnit(),'GKF1'))
endfunction
function PowerUpGokuCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local timer tt=null
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local player p=GetOwningPlayer(u)
    local integer idp=GetHandleId(p)
    local real time=LoadReal(h,id,1)
    local integer i=0
    // облегчение: фоновые волны/пыль трансформации — каждый 3-й тик (0.075 c), а не каждый
    local boolean sp=ModuloInteger(R2I(LoadReal(h,id,1)*40.+0.5),3)==0
    if time<6 then
        call PauseUnit(u,true)
        call SaveReal(h,id,1,time+0.025)
        if GetUnitCurrentAnimationId(u)!=169 then
            if GetUnitCurrentAnimationId(u)!=171 then
                call SetUnitAnimationByIndex(u,169)
            endif
        endif
        if LoadInteger(h,id,3)==7 then
            if LoadBoolean(HH,GetHandleId(GetOwningPlayer(Goku)),SpecUIHash)==true then
                call SetUnitInvulnerable(u,true)
                if time==1 then
                    call StartSound(soundStr[99])
                endif
                if time<6 and sp then
                    set EFF=AddSpecialEffect("BY_Wood_Eff_Ord_DanGe_Wav_Kuosan_1_2_0.25s.mdx", x, y)
                    call SetSpecialEffectScale(EFF , GetRandomReal(1.5, 2.5))
                    call SetSpecialEffectTimeScale(EFF , GetRandomReal(0.5, 1.5))
                    call SetSpecialEffectOrientation(EFF , GetRandomReal(0, 359),0,0)
                    call SetSpecialEffectZ(EFF , GetRandomReal(0, 50))
                    call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 155 , 5)
                    set EFF=AddSpecialEffect("rasengan_eff4.mdx", x, y)
                    call SetSpecialEffectScale(EFF , GetRandomReal(1.5, 2.5))
                    call SetSpecialEffectTimeScale(EFF , GetRandomReal(0.5, 1.5))
                    call SetSpecialEffectOrientation(EFF , GetRandomReal(0, 359),0,0)
                    call SetSpecialEffectZ(EFF , GetRandomReal(0, 10))
                    call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 155 , 5)
                    if time>1 and time<5 and ModuloReal(time,0.075)<0.025 then
                        set EFF=AddSpecialEffect(EffectID[1038], x+GetRandomReal(-400,400)*Cos(GetRandomReal(0,359)), y+GetRandomReal(-400,400)*Sin(GetRandomReal(0,359)))
                        call SetSpecialEffectScale(EFF , GetRandomReal(1, 2))
                        call SetSpecialEffectTimeScale(EFF , GetRandomReal(0.5, 1.5))
