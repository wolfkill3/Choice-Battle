endfunction
function MitenaDiVongolaCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real r=LoadReal(h,id,1)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real st=LoadReal(h,GetHandleId(u),SH_mantello)
if GetUnitAbilityLevel(u,'B00C')==0 then
        call FlushChildHashtable(h,id)
        call DestroyTimer(t)
        call SaveReal(h,GetHandleId(u),SH_mantello,0)
elseif GetUnitAbilityLevel(u,'B00C')>0 and st<0 then
