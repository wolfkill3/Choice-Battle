function ThrowSwordCond takes nothing returns boolean
return GetSpellAbilityId()==0x4130504B
endfunction
function ThrowSwordCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local group g=LoadGroupHandle(h,id,4)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,5)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroAgi(u,true)*(0.75+GetUnitAbilityLevel(u,0x4130504A)*.5)
if SR(x,y,x1,y1)<=1500 and IsTerrainPathable(GetUnitX(l__d),GetUnitY(l__d),PATHING_TYPE_FLYABILITY)==false then
set x1=x1+52*Cos(a)
set y1=y1+52*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
call GroupEnumUnitsInRange(g,x1,y1,90,Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",GetUnitX(E),GetUnitY(E)))
call SetControlToUnit(E,E, 0.08, "stun")
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
else
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,GetHandleId(g))
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
call RemoveUnit(l__d)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function ThrowSwordCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local group g=LoadGroupHandle(h,GetHandleId(u),StringHash("vg"))
call SaveUnitHandle(h,id,0,u)
call GroupRemoveUnit(g,u)
call SetUnitAnimation(u,"Spell Two")
set n=GetRandomUnitFromGroup(g)
call GroupRemoveUnit(g,n)
if n!=null and n!=u and GetUnitTypeId(n)==0x65304F30 then
call UnitAddAbility(n,0x41303849)
call SaveUnitHandle(h,id,1,n)
call SaveGroupHandle(h,id,4,CreateGroup())
call SaveReal(h,id,2,GetUnitX(n))
call SaveReal(h,id,3,GetUnitY(n))
call SaveReal(h,id,5,GetUnitFacing(n)*bj_DEGTORAD)
if GetRandomInt(0, 1)==0 then
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\VergilF.mp3",false,false,true,12700,12700,"")
else
        set soundplay=CreateSound("Sound\\war3mapImported\\VergilW_Sound"+I2S(GetRandomInt(1,2))+".mp3",false,false,true,12700,12700,"")
endif
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.01,true,function ThrowSwordCast2)
set n=LoadUnitHandle(h,GetHandleId(u),StringHash("clone"))
if n!=null then
call UnitResetCooldown(n)
call SetUnitState(n,UNIT_STATE_MANA,GetUnitState(n,UNIT_STATE_MAX_MANA))
call IssueImmediateOrder(n,"divineshield")
endif
endif
set u=null
set g=null
set t=null
endfunction
