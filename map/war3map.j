call Slash_IceSenbon(n,GetRandomReal(35,45),dmg,a1,1200,55)
set i=i+1
endloop
set soundplay=CreateSound("Sound\\Music\\mp3Music\\IceSenbons.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
set p=null
set u=null
endfunction
