call GroupRemoveUnit(g2,E)
endloop
call DestroyGroupTimed(g2,3)
call SaveReal(h,id,3,dist)
else
call SaveReal(h,id,3,1000)
call PauseTimer(t)
call TimerStart(t,0.02,true,function WRulerCast4)
endif
set g=null
set g2=null
set t=null
set u=null
endfunction
function WRulerCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,1)
local real y1=LoadReal(h,id,2)
local real a=Atan2(y1-y,x1-x)
local real dist=LoadReal(h,id,3)-40
local group g=LoadGroupHandle(h,id,4)
local player p=GetOwningPlayer(u)
if dist>0 then
set x=x+40*Cos(a)
set y=y+40*Sin(a)
call SetUnitXY_1(u,x,y, false)
call SaveReal(h,id,3,dist)
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl",x,y))
else
set n=CreateUnit(p,'rUW1',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitVertexColor(n,255,255,255,255)
set n=CreateUnit(p,'rUW2',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitVertexColor(n,255,255,255,255)
set soundplay=SndN(2932) // Sound\Music\mp3Music\JeanneW.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call GroupEnumUnitsInRange(G,x,y,400,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
call GroupAddUnit(g,E)
call PauseUnit(E,true)
call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,true)
call UnitAddAbility(E,'Arav')
call UnitRemoveAbility(E,'Arav')
else
call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,u)
endif
endif
call GroupRemoveUnit(G,E)
endloop
call PauseUnit(u,false)
call SaveReal(h,id,3,1000)
call PauseTimer(t)
call TimerStart(t,0.02,true,function WRulerCast3)
endif
set g=null
set t=null
set u=null
endfunction
