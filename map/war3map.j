function Trig_Killme_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local integer i=LoadInteger(HH,id,0)
//sabrac9start
call SaveBoolean(HH,GetHandleId( Hero[i] ),StringHash("SabracKillme"),true)
//sabrac9end
if udg_B==true and IsUnitAlive(Hero[i]) and GetUnitAbilityLevel(Hero[i],'A1CE')==0 and IsUnitVisible(Hero[i],GetOwningPlayer(Hero[i])) then
    if DU==false and(Hero[i]==fi[1]or Hero[i]==fi[2]) then
        if Hero[i]==fi[1] then
            call SetUnitInvulnerable(Hero[i],false)
            call UnitRemoveBuffs(Hero[i],true,true)
            call UnitAddAbility(Hero[i],'A0WR')
            call myCustomDamage(fi[2],Hero[i],100000,false,false,null,null,null)
            call UnitRemoveAbility(Hero[i],'A0WR')
        elseif Hero[i]==fi[2] then
            call SetUnitInvulnerable(Hero[i],false)
            call UnitRemoveBuffs(Hero[i],true,true)
            call UnitAddAbility(Hero[i],'A0WR')
            call myCustomDamage(fi[1],Hero[i],100000,false,false,null,null,null)
            call UnitRemoveAbility(Hero[i],'A0WR')
        endif
        call DisplayTextToPlayer(Player(i),0,0,"Вы умерли и теряете 100 ед. золота")
        call SetPlayerState(Player(i),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(i),PLAYER_STATE_RESOURCE_GOLD)-100)
    elseif DU==true then
        call RemoveTransformation(Hero[i])
        call KillUnit(Hero[i])
        call DisplayTextToPlayer(Player(i),0,0,"Вы умерли и теряете 100 ед. золота")
        call SetPlayerState(Player(i),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(i),PLAYER_STATE_RESOURCE_GOLD)-100)
    endif
endif
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
set t=null
endfunction
