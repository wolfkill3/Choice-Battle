local integer hId = GetPlayerId(GetTriggerPlayer())
local integer id = NewTimer(hId)
if GetUnitTypeId(a)=='H012' or GetUnitTypeId(a)=='H06D' or GetUnitTypeId(a)=='H00P' or GetUnitTypeId(a)=='H02Y' or GetUnitTypeId(a)=='H02X' or GetUnitTypeId(a)=='A03N' or GetUnitTypeId(a)=='H00I' or GetUnitTypeId(a)=='H01J' or GetUnitTypeId(a)=='H10L' or GetUnitTypeId(a)=='H06G' or GetUnitTypeId(a)=='H018' then
    call SaveInteger(HH,id,TIME_HASH, 250)
    call SaveInteger(HH,id,StringHash("Time2"), 250)
else
    if GetUnitTypeId(a)=='H031' then
        call SaveInteger(HH,id,StringHash("Time2"), 100)
        call SaveInteger(HH,id,TIME_HASH, 100)
    else
        if GetUnitTypeId(a)=='H055' or GetUnitTypeId(a)=='H03L' then
            call SaveInteger(HH,id,StringHash("Time2"), 300)
            call SaveInteger(HH,id,TIME_HASH, 300)
        else
            if GetUnitTypeId(a)=='H02B' or GetUnitTypeId(a)=='H04C' or GetUnitTypeId(a)=='H02K' or GetUnitTypeId(a)=='H00A' then
                call SaveInteger(HH,id,StringHash("Time2"), 150)
                call SaveInteger(HH,id,TIME_HASH, 150)
            else
                if GetUnitTypeId(a)=='H02S' then
                    call SaveInteger(HH,id,StringHash("Time2"), 120)
                    call SaveInteger(HH,id,TIME_HASH, 120)
                else
                    if GetUnitTypeId(a)=='H04L' or GetUnitTypeId(a)=='H06V' then
                        call SaveInteger(HH,id,StringHash("Time2"), 200)
                        call SaveInteger(HH,id,TIME_HASH, 200)
                    else
                        if GetUnitTypeId(a)=='H06N' or GetUnitTypeId(a)=='H01H' or GetUnitTypeId(a)=='H01F' or  GetUnitTypeId(a)=='H01D' or GetUnitTypeId(a)=='H03P' then
                            call SaveInteger(HH,id,StringHash("Time2"), (2+GetUnitAbilityLevel(a,'A0C8')+GetUnitAbilityLevel(a,'A1EG')+GetUnitAbilityLevel(a,'A0BZ')+GetUnitAbilityLevel(a,'A0BT')+GetUnitAbilityLevel(a,'A0PR'))*10)
                            call SaveInteger(HH,id,TIME_HASH, (2+GetUnitAbilityLevel(a,'A0C8')+GetUnitAbilityLevel(a,'A1EG')+GetUnitAbilityLevel(a,'A0BZ')+GetUnitAbilityLevel(a,'A0BT')+GetUnitAbilityLevel(a,'A0PR'))*10)
                        else
                            if GetUnitTypeId(a)=='H00J' then
                                call SaveInteger(HH,id,StringHash("Time2"), 130)
                                call SaveInteger(HH,id,TIME_HASH, 130)
                            else
                                call SaveInteger(HH,id,StringHash("Time2"), 0)
                                call SaveInteger(HH,id,TIME_HASH, 0)
                            endif
                        endif
                    endif
                endif
            endif
        endif
    endif
endif
call SaveAgentHandle(HH,id,CasterHash,a)
call TimerStart(LoadTimer(hId),.1,true,function TransformationStartLoop)
endfunction

function EDantesLoop takes nothing returns nothing
local integer id = GetHandleID()
local integer time = LoadInt("Time")
local unit u=LoadUnitHandle(HH,MUIHandle(),CasterHash)
local real x= GetUnitX(u)
local real y= GetUnitY(u)
local real ang = LoadFloat("ang")
local integer ids = GetHandleId(G)
local integer idt
local real dmg = (1.5+(0.5 * GetUnitAbilityLevel(u,'CS01')))* GetHeroAgi(u,true)
if GetUnitAbilityLevel(u, 'CB01') > 0 then
set dmg = dmg * 1.15
endif
if time < 22 and GetWidgetLife(u) > 0.405 and LoadBoolean(HH,GetHandleId(u),DASH_USER)==true then
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SaveInteger(HH,id,TIME_HASH, time + 1)
set n = CreateUnit(GetOwningPlayer(u), 'ed7X', x, y, (ang * bj_RADTODEG))
call SetUnitScale(n, 2, 2, 2)
call SetUnitTimeScale(n,3)
call UnitApplyTimedLife(n,'BTLF', 1)
call SetUnitX(u, x - 50 * Cos(ang))
call SetUnitY(u, y - 50 * Sin(ang))
call GroupClear(G)
call GroupEnumUnitsInRange(G,x,y,120,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
set idt = GetHandleId(G)
if Condition_Base(GetOwningPlayer(u),E)and E!=LoadUnitHandle(HH,ids,idt)then
    if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
        call SaveUnitHandle(HH,ids,idt,E)
        call myCustomDamage(u,E,dmg,false,false,null,null,null)
        call SaveBoolean(HH,id,StringHash("IsDamaged"),false)
    else
        call SaveBoolean(HH,GetHandleId(u),DASH_USER,false)
        call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,u)
    endif
endif
call GroupRemoveUnit(G,E)
endloop
endif

if time >= 22 then
if DantesData == 0 then
set DantesData = 1
call IssueImmediateOrder(u, "stop")
call UnitRemoveAbility(u, 'CS01')
call UnitAddAbility(u, 'CS01')
call SetUnitAbilityLevel(u,'CS01', LoadInt("lvl"))
endif
call PauseUnit(u,false)
if GetUnitAbilityLevel(u, 'CB01') > 0 and LoadBoolean(HH,id,StringHash("IsDamaged")) == false then
call UnitRemoveAbility(u, 'CE01')
call UnitRemoveAbility(u, 'CB01')
endif
call SetUnitInvulnerable(u,false)
call SaveBoolean(HH,GetHandleId(u),DASH_USER,false)
call FlushChildHashtable(HH,ids)
call Clear(id)
endif
set u=null
endfunction


function EdmondResetData takes nothing returns nothing
set DantesData = 0
call PauseTimer(GetExpiredTimer())
call DestroyTimer(GetExpiredTimer())
endfunction

function EDantesStart takes unit a returns nothing
local integer hId = GetPlayerId(GetTriggerPlayer())
local integer id = NewTimer(hId)
local real ang = Atan2(GetUnitY(GetTriggerUnit())-GetSpellTargetY(),GetUnitX(GetTriggerUnit())-GetSpellTargetX())
if DantesData == 1 then
set DantesData = 2
set soundplay=CreateSound("Sound\\war3mapImported\\EdmondE1.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(CreateTimer(), 28 - (2 * GetUnitAbilityLevel(a,'CS01')),false, function EdmondResetData)
else
set soundplay=CreateSound("Sound\\war3mapImported\\EdmondE.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
call SaveAgentHandle(HH,id,CasterHash,a)
call SaveInteger(HH,id,TIME_HASH, 0)
call SaveInteger(HH,id,StringHash("lvl"), GetUnitAbilityLevel(a,'CS01'))
call SaveBoolean(HH,id,StringHash("IsDamaged"),true)
call SaveReal(HH,id, StringHash("ang"), ang)
set n = CreateUnit(GetTriggerPlayer(), 'ed97', GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), (ang * bj_RADTODEG)+180)
call SetUnitScale(n, 2, 2, 2)
call SetUnitTimeScale(n,1)
call UnitApplyTimedLife(n,'BTLF', 1)
set n = CreateUnit(GetTriggerPlayer(), 'e0ZH', GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), ((ang * bj_RADTODEG)+180)-70)
call SetUnitScale(n, 2, 2, 2)
call SetUnitTimeScale(n,2)
call SetUnitVertexColor(n,255,255,255,50)
call UnitApplyTimedLife(n,'BTLF', 1)
set n = CreateUnit(GetTriggerPlayer(), 'e0ZH', GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), ((ang * bj_RADTODEG)+180))
call SetUnitScale(n, 2, 2, 2)
call SetUnitTimeScale(n,2)
call SetUnitVertexColor(n,255,255,255,50)
call UnitApplyTimedLife(n,'BTLF', 1)
set n = CreateUnit(GetTriggerPlayer(), 'e0ZH', GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), ((ang * bj_RADTODEG)+180)+70)
call SetUnitScale(n, 2, 2, 2)
call SetUnitTimeScale(n,2)
call SetUnitVertexColor(n,255,255,255,50)
call UnitApplyTimedLife(n,'BTLF', 1)
call SetUnitAnimation(GetTriggerUnit(), "walk")
call SaveBoolean(HH,GetHandleId(a),DASH_USER,true)
call TimerStart(LoadTimer(hId),.01,true,function EDantesLoop)
endfunction

function EdmondBuffLoop takes nothing returns nothing
local integer id = GetHandleID()
local integer time = LoadInt("Time")
call UnitRemoveAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'CE01')
call UnitRemoveAbility(LoadUnitHandle(HH,MUIHandle(),CasterHash), 'CB01')
call Clear(id)
endfunction

function EdmondBuffStart takes unit a returns nothing
local integer hId = GetPlayerId(GetOwningPlayer(a))
local integer id = NewTimer(hId)
call UnitAddAbility(a, 'CE01')
call SaveAgentHandle(HH,id,CasterHash,a)
call SaveInteger(HH,id,TIME_HASH, 300)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\DantesF.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(LoadTimer(hId),15.,false,function EdmondBuffLoop)
endfunction

function EdmondBuff2Loop takes nothing returns nothing
local integer id = GetHandleID()
local integer time = LoadInt("Time")
local real mm=GetUnitState(LoadUnitHandle(HH,MUIHandle(),CasterHash), UNIT_STATE_MAX_MANA)
local real cm=GetUnitState(LoadUnitHandle(HH,MUIHandle(),CasterHash), UNIT_STATE_MANA)
if cm < mm and GetWidgetLife(LoadUnitHandle(HH,MUIHandle(),CasterHash)) > 0.405 and udg_B==true and DU2==true then
call HealTextTag(LoadUnitHandle(HH,MUIHandle(),CasterHash),LoadUnitHandle(HH,MUIHandle(),CasterHash),mm * 0.01*myCustomMana2(LoadUnitHandle(HH,MUIHandle(),CasterHash),1),"ManaRes")
call SetUnitState(LoadUnitHandle(HH,MUIHandle(),CasterHash), UNIT_STATE_MANA, cm + (mm * 0.01))
endif
if LoadUnitHandle(HH,MUIHandle(),CasterHash)==null then
call Clear(id)
set cDantesRegen = 0
endif
endfunction

function EdmondBuff2Start takes unit a returns nothing
local integer hId = GetPlayerId(GetOwningPlayer(a))
local integer id = NewTimer(hId)
call SaveAgentHandle(HH,id,CasterHash,a)
call SaveInteger(HH,id,TIME_HASH, 300)
call TimerStart(LoadTimer(hId),1.,true,function EdmondBuff2Loop)
endfunction

function SpellAct takes nothing returns nothing
local integer id = GetSpellAbilityId()
if id == 'AFUP' then
call GoldenFriezaStart(GetTriggerUnit())
elseif id == 'A07U' or id == 'A1D2' or id == 'A068' or id == 'A0LY' or id == 'A1OX' or id == 'A0OX' or id == 'A03N' or id == 'A119' or id == 'A0GE' or id == 'A0PD' or id == 'A0KP' or id == 'A0CI' or id == 'LCE1' or id == 'A1DX' or id == 'A0UN' or id == 'A1EF' or id == 'A0PR' or id == 'A0BT' or id == 'A0BZ' or id == 'A1EG' or id == 'A0C8' or id=='A0JA' or id=='A0TF' or id=='A01O' or id=='A168' then
call TransformationStart(GetTriggerUnit())
elseif id == 'CS01' then
call EDantesStart(GetTriggerUnit())
elseif id == 'CS02' then
call EdmondBuffStart(GetTriggerUnit())
endif
endfunction

function Level_Event takes nothing returns nothing
local integer AID = GetPlayerId( GetOwningPlayer( GetLevelingUnit( ) ) )
local integer LVL = GetUnitLevel( GetLevelingUnit( ) )
local integer UID = GetUnitTypeId( GetLevelingUnit( ) )
//call BJDebugMsg(I2S(cDantesRegen))
if LVL >= 6 and cDantesRegen == 0 and UID == 'Ho0Z' then
set cDantesRegen = 1
call EdmondBuff2Start(GetLevelingUnit( ))
endif
endfunction

function BelfegorStormDamage_Periodic takes nothing returns nothing
        local integer id=GetHandleId(GetExpiredTimer())
        local integer time=LoadInteger(h,id,3)
        if time<=6 and GetWidgetLife(LoadUnitHandle(h,id,1))>1 then
                call myCustomDamage(LoadUnitHandle(h,id,0),LoadUnitHandle(h,id,1),(LoadReal(h,id,2)*0.5),false,false,null,null,null)
                call SaveInteger(h,id,3,time+1)
        else
                call RemoveEffect(LoadEffectHandle(h,id,4),0,false,CreateTimer())
                call RemoveEffect(LoadEffectHandle(h,id,5),0,false,CreateTimer())
                call RemoveEffect(LoadEffectHandle(h,id,6),0,false,CreateTimer())
                call FlushChildHashtable(h,id)
                call DestroyTimer(GetExpiredTimer())
        endif
endfunction

function BelfegorStormDamage takes unit newCaster,unit newTarget,real newDamage returns nothing
        local integer id=0
        local integer CasterId=GetHandleId(newCaster)
        local integer TargetId=GetHandleId(newTarget)
        local real x=GetUnitX(newTarget)
        local real y=GetUnitY(newTarget)
        set bjLCT=CreateTimer()
        set id=GetHandleId(bjLCT)
        set bjLCE=AddSpecialEffect("explosion23.mdl",x,y)
        call SetSpecialEffectScale(bjLCE,0.6)
        call DestroyEffect(bjLCE)
        
        set bjLCE=AddSpecialEffectTarget("Abilities\\Spells\\Other\\Doom\\DoomTarget.mdl",newTarget,"origin")
        call SaveEffectHandle(h,id,4,bjLCE)
        set bjLCE=AddSpecialEffectTarget("Environment\\LargeBuildingFire\\LargeBuildingFire0.mdl",newTarget,"chest")
        call SaveEffectHandle(h,id,5,bjLCE)
        set bjLCE=AddSpecialEffectTarget("Abilities\\Spells\\Other\\Doom\\DoomTarget.mdl",newTarget,"chest")
        call SaveEffectHandle(h,id,6,bjLCE)
        
        call SaveUnitHandle(h,id,0,newCaster)
        call SaveUnitHandle(h,id,1,newTarget)
        call SaveReal(h,id,2,newDamage)
        call SaveInteger(h,id,3,0)
        call TimerStart(bjLCT,0.5,true,function BelfegorStormDamage_Periodic)
        set bjLCT = null
endfunction

function UnitHaveBelfegorMark takes unit newCaster,unit newTarget,boolean doClean returns boolean
        local integer CasterId=GetHandleId(newCaster)
        local integer TargetId=GetHandleId(newTarget)
        local boolean bBelfegorMark=LoadBoolean(h,TargetId,StringHash("BelfegorMark"))
        if bBelfegorMark==false then
                call RemoveSavedBoolean(h,TargetId,StringHash("BelfegorMark"))
                return false
        else
                if doClean==true then
                        set bj_lastCreatedGroup=LoadGroupHandle(HH,CasterId,StringHash("BelfegorMarkGroup"))
                        call SaveBoolean(h,TargetId,StringHash("BelfegorMark"),false)
                        call RemoveSavedBoolean(h,TargetId,StringHash("BelfegorMark"))
                        call GroupRemoveUnit(bj_lastCreatedGroup,newTarget)
                endif
        return true
        endif
endfunction

// ClearGroupBelfegorMark  смотри 21374


function UnitRemoveBelfegorMark takes unit newCaster,unit newTarget returns nothing
        local integer CasterId=GetHandleId(newCaster)
        local integer TargetId=GetHandleId(newTarget)
        set bj_lastCreatedGroup=LoadGroupHandle(HH,CasterId,StringHash("BelfegorMarkGroup"))
        call SaveBoolean(h,TargetId,StringHash("BelfegorMark"),false)
        call RemoveSavedBoolean(h,TargetId,StringHash("BelfegorMark"))
        call GroupRemoveUnit(bj_lastCreatedGroup,newTarget)
        set bj_lastCreatedGroup=null
endfunction

function UnitAddBelfegorMark takes unit newCaster,unit newTarget returns nothing
        local boolean bBelfegorMark=LoadBoolean(h,GetHandleId(newTarget),StringHash("BelfegorMark"))
        if bBelfegorMark==false then
                set bj_lastCreatedGroup=LoadGroupHandle(HH,GetHandleId(newCaster),StringHash("BelfegorMarkGroup"))
                if bj_lastCreatedGroup==null then
                        set bj_lastCreatedGroup=CreateGroup()
                        call SaveGroupHandle(HH,GetHandleId(newCaster),StringHash("BelfegorMarkGroup"),bj_lastCreatedGroup)
                endif
                call SaveBoolean(h,GetHandleId(newTarget),StringHash("BelfegorMark"),true)
                call GroupAddUnit(bj_lastCreatedGroup,newTarget)
                set bj_lastCreatedGroup=null
        endif
endfunction

function StartBelfegorDCooldown_Periodic takes nothing returns nothing
        local integer id=GetHandleId(GetExpiredTimer())
        local integer itar=GetHandleId(LoadUnitHandle(HH,id,c_TARGET))
        local integer BelfegorDTime=LoadInteger(HH,itar,StringHash("BelfegorD_Time"))
        if BelfegorDTime>0 then
                call SaveInteger(HH,itar,StringHash("BelfegorD_Time"),BelfegorDTime-1)
        else
                call SaveInteger(HH,itar,StringHash("BelfegorD_Time"),0)
                call RemoveSavedInteger(HH,itar,StringHash("BelfegorD_Time"))
                call FlushChildHashtable(HH,id)
                call DestroyTimer(GetExpiredTimer())
        endif
endfunction

function StartBelfegorDCooldown takes unit newTarget,timer newTimer returns nothing
        local integer id=0
        local integer itar=0
        set id=GetHandleId(newTimer)
        set itar=GetHandleId(newTarget)
        call SaveUnitHandle(HH,id,c_TARGET,newTarget)
        call SaveInteger(HH,itar,StringHash("BelfegorD_Time"),15)
        call TimerStart(newTimer,1,true,function StartBelfegorDCooldown_Periodic)
endfunction

function Belf_CritDamage takes unit newCaster,unit newTarget,unit newKnife,real newDamage returns nothing
        local real x=GetUnitX(newTarget)
        local real y=GetUnitY(newTarget)
        local real a=GetUnitFacing(newKnife)
        local boolean bBelfegorMark=UnitHaveBelfegorMark(newCaster,newTarget,true)
        set newDamage=newDamage+GetWidgetMaxLife(newTarget)*0.04
        if LoadBoolean(h,GetHandleId(newCaster),StringHash("BelfStormVaria"))==true then
                set newDamage=newDamage+GetWidgetMaxLife(newTarget)*0.03
                call BelfegorStormDamage(newCaster,newTarget,newDamage*0.20)
        endif
        call MyRemoveUnit(CreateUnit(GetOwningPlayer(newCaster), 'dAlb', x, y, 0), 1.2)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH09', x, y, a+170)
        call SetUnitScale(n, 1.35, 1.35, 1.35)
        call SetUnitFlyHeight(n, 100, 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH09', x, y, a+190)
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call SetUnitFlyHeight(n, 100, 0)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH02', x, y, a+190)
        call SetUnitScale(n, 1.35, 1.35, 1.35)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH02', x, y, a+190)
        call SetUnitScale(n, 1.4, 1.4, 1.4)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH22', x, y, a+190)
        call SetUnitScale(n, 1.05, 1.05, 1.05)
        call MyRemoveUnit(n, 1.5)

        call myCustomDamage(newCaster,newTarget,newDamage,false,false,null,null,null)
        call SetControlToUnit(newCaster, newTarget, 0.15, "stun")
        call StartBelfegorDCooldown(newTarget,CreateTimer())
endfunction
function Belf_BackDummy_Periodic takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local real cX=GetUnitX(LoadUnitHandle(h,id,CasterHash))
local real cY=GetUnitY(LoadUnitHandle(h,id,CasterHash))
local real dX=GetUnitX(LoadUnitHandle(h,id,DummyHash))
local real dY=GetUnitY(LoadUnitHandle(h,id,DummyHash))
local real a=AtanPoint(dX,dY,cX,cY)+LoadReal(h,id,AngleHash)
local integer time=LoadInteger(h,id,TIME_HASH)
local integer overtime=LoadInteger(h,id,StringHash("Overtime"))
call SaveInteger(h,id,TIME_HASH,time+1)
if time>overtime then
if SquareRootUnit(LoadUnitHandle(h,id,DummyHash),LoadUnitHandle(h,id,CasterHash))>30 then
set dX=dX+25*Cos(a)
set dY=dY+25*Sin(a)
call SetUnitX(LoadUnitHandle(h,id,DummyHash),dX)
call SetUnitY(LoadUnitHandle(h,id,DummyHash),dY)
call SetUnitFacing(LoadUnitHandle(h,id,DummyHash),a*bj_RADTODEG)
else
call RemoveUnit(LoadUnitHandle(h,id,DummyHash))
call FlushChildHashtable(h,id)
call DestroyTimer(GetExpiredTimer())
endif
endif
endfunction
function Belf_BackDummy takes unit newCaster,unit newDummy,integer overtime,timer newTimer returns nothing
        local integer id=GetHandleId(newTimer)
        call SaveUnitHandle(h,id,CasterHash,newCaster)
        call SaveUnitHandle(h,id,DummyHash,newDummy)
        if GetRandomInt(0,1)==1 then
                call SaveReal(h,id,AngleHash,GetRandomReal(-0.4,-0.8))
        else
                call SaveReal(h,id,AngleHash,GetRandomReal(0.4,0.8))
        endif
        call SaveInteger(h,id,StringHash("Overtime"),overtime)
        call TimerStart(newTimer,0.015,true,function Belf_BackDummy_Periodic)
endfunction

function BelfF_AOEdamage_Periodic takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local real x=GetUnitX(LoadUnitHandle(h,id,DummyHash))
local real y=GetUnitY(LoadUnitHandle(h,id,DummyHash))
local real tX=LoadReal(h,id,StringHash("TargetX"))
local real tY=LoadReal(h,id,StringHash("TargetY"))
local real speed=35
local real dmg=0
local real a=Atan2(tY-y,tX-x)+LoadReal(h,id,AngleHash)
if SquareRoot((tX-x)*(tX-x)+(tY-y)*(tY-y))>35 then
set x=x+speed*Cos(a)
set y=y+speed*Sin(a)
call SetUnitX(LoadUnitHandle(h,id,DummyHash),x)
call SetUnitY(LoadUnitHandle(h,id,DummyHash),y)
call SetUnitFacing(LoadUnitHandle(h,id,DummyHash),a*bj_RADTODEG)
else
set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)),'dBel',tX,tY,a*bj_RADTODEG)
call UnitApplyTimedLife(bjLCU,1,3)
set bjLCE=AddSpecialEffect("by_wood_effect_yuzhiboyou_fire_babangouyu_2_di_.mdl",tX,tY)
call SetSpecialEffectScale(bjLCE,1)
call SetSpecialEffectTimeScale(bjLCE,0.13)
call SetSpecialEffectZ(bjLCE,50)
call DestroyEffect(bjLCE)
set bj_forLoopAIndex=0
loop
exitwhen bj_forLoopAIndex==6
set bjLCE=AddSpecialEffect("qiangdairchannelred.mdl",tX+200*Cos(a+(bj_forLoopAIndex*60)*bj_DEGTORAD),tY+200*Sin(a+(bj_forLoopAIndex*60)*bj_DEGTORAD))
call SetSpecialEffectScale(bjLCE,0.7)
call SetSpecialEffectTimeScale(bjLCE,0.4)
call SetSpecialEffectZ(bjLCE,50)
call RemoveEffect(bjLCE,2.2,false,CreateTimer())
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call Belf_BackDummy(LoadUnitHandle(h,id,CasterHash),LoadUnitHandle(h,id,DummyHash),85,CreateTimer())
set bjLCG=CreateGroup()
call GroupEnumUnitsInRange(bjLCG,tX,tY,350,Base)
loop
set bjLCU=FirstOfGroup(bjLCG)
exitwhen bjLCU==null
if Condition_Base(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)),bjLCU)==true then
if GetWidgetLife(bjLCU)<=GetWidgetMaxLife(bjLCU)*0.3 then
set dmg=GetWidgetMaxLife(bjLCU)*0.2
else
set dmg=GetWidgetMaxLife(bjLCU)*0.05
set dmg=dmg+(GetWidgetMaxLife(bjLCU)*0.15-(GetWidgetLife(bjLCU)-GetWidgetMaxLife(bjLCU)*0.7)/(GetWidgetMaxLife(bjLCU)/100)*GetWidgetMaxLife(bjLCU)*0.00214285)
endif
call myCustomDamage(LoadUnitHandle(h,id,CasterHash),bjLCU,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(bjLCG,bjLCU)
endloop
call DestroyGroup(bjLCG)
set bjLCG=null
call FlushChildHashtable(h,id)
call DestroyTimer(GetExpiredTimer())
endif
endfunction
function BelfF_AOEdamage takes unit newCaster,real TargetX,real TargetY returns nothing
local integer id=0
local real a=AtanPoint(GetUnitX(newCaster),GetUnitY(newCaster),TargetX,TargetY)
local real dmg=GetHeroInt(newCaster,true)*5
set bjLCT=CreateTimer()
set id=GetHandleId(bjLCT)
set soundplay=CreateSound("Sound\\war3mapImported\\Belf_F1.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
set bjLCE=AddSpecialEffect("cf2.mdl",GetUnitX(newCaster),GetUnitY(newCaster))
call SetSpecialEffectFacing(bjLCE,a*bj_RADTODEG)
call SetSpecialEffectZ(bjLCE,50)
call SetSpecialEffectAlpha(bjLCE,150)
call SetSpecialEffectScale(bjLCE,0.55)
call DestroyEffect(bjLCE)
set bjLCE=AddSpecialEffect("Ikarice2_FAW34.mdl",GetUnitX(newCaster)+50*Cos(a),GetUnitY(newCaster)+50*Sin(a))
call SetSpecialEffectZ(bjLCE,150)
call SetSpecialEffectAlpha(bjLCE,95)
call SetSpecialEffectScale(bjLCE,1.25)
call SetSpecialEffectRoll(bjLCE,90)
call SetSpecialEffectOrientation(bjLCE , a* bj_RADTODEG,-90,0)
call RemoveEffect(bjLCE,0.3,false,CreateTimer())
set a=GetRandomReal(0.4,0.8)
if GetRandomInt(0,1)==1 then
set a=GetRandomReal(-0.4,-0.8)
endif
set bjLCU=CreateUnit(GetOwningPlayer(newCaster),'dB02',GetUnitX(newCaster),GetUnitY(newCaster),AtanPoint(GetUnitX(newCaster),GetUnitY(newCaster),TargetX,TargetY)*bj_RADTODEG)
call SetUnitFlyHeight(bjLCU,175,0)
call SetUnitAnimation(bjLCU,"walk")
call SetUnitScale(bjLCU,0.75,0.75,0.75)
call SaveUnitHandle(h,id,CasterHash,newCaster)
call SaveUnitHandle(h,id,DummyHash,bjLCU)
call SaveReal(h,id,StringHash("TargetX"),TargetX)
call SaveReal(h,id,StringHash("TargetY"),TargetY)
call SaveReal(h,id,AngleHash,a)
call TimerStart(bjLCT,0.015,true,function BelfF_AOEdamage_Periodic)
set bjLCT=null
endfunction
function BelfF_Shield_Periodic takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local integer itar=GetHandleId(LoadUnitHandle(h,id,TargetHash))
local integer act=LoadInteger(h,id,StringHash("Act"))
local real x=GetUnitX(LoadUnitHandle(h,id,DummyHash))
local real y=GetUnitY(LoadUnitHandle(h,id,DummyHash))
local real tX=GetUnitX(LoadUnitHandle(h,id,TargetHash))
local real tY=GetUnitY(LoadUnitHandle(h,id,TargetHash))
local real a=AtanPoint(x,y,tX,tY)
local real time=LoadReal(h,id,TIME_HASH)
local real full_s=LoadReal(h,id,StringHash("BelfF_Shield"))
local real shield=LoadReal(h,id,StringHash("Shield"))
local real TShield=LoadReal(h,itar,StringHash("ShieldBelfF"))
if act==0 then
if SquareRoot((tX-x)*(tX-x)+(tY-y)*(tY-y))>40 then
set x=x+35*Cos(a)
set y=y+35*Sin(a)
call SetUnitX(LoadUnitHandle(h,id,DummyHash),x)
call SetUnitY(LoadUnitHandle(h,id,DummyHash),y)
call SetUnitFacing(LoadUnitHandle(h,id,DummyHash),a*bj_RADTODEG)
else
set shield=(GetHeroInt(LoadUnitHandle(h,id,CasterHash),true)*3)+(GetWidgetMaxLife(LoadUnitHandle(h,id,TargetHash))-GetWidgetLife(LoadUnitHandle(h,id,TargetHash)))*0.35
call SaveReal(h,id,StringHash("Shield"),shield)
call SaveReal(h,id,StringHash("BelfF_Shield"),shield)
call SaveReal(h,itar,StringHash("ShieldBelfF"),shield)
call ShowUnit(LoadUnitHandle(h,id,DummyHash),false)
set bjLCE=AddSpecialEffectTarget("Burning_Cage_1.mdl",LoadUnitHandle(h,id,TargetHash),"original")
call SaveEffectHandle(h,id,StringHash("EffectShield1"),bjLCE)
set bjLCE=AddSpecialEffectTarget("Abilities\\Spells\\Other\\ImmolationRed\\ImmolationREDTarget.mdl",LoadUnitHandle(h,id,TargetHash),"chest")
call SaveEffectHandle(h,id,StringHash("EffectShield2"),bjLCE)
call SaveInteger(h,id,StringHash("Act"),1)
call SaveReal(h,id,TIME_HASH,3)
endif
elseif act==1 then
if time>0 and TShield>0 then
    if IsUnitPaused(LoadUnitHandle(h,id,TargetHash))==false and IsUnitHidden(LoadUnitHandle(h,id,TargetHash))==false and GetUnitAbilityLevel(LoadUnitHandle(h, id, TargetHash),'Pet1')==0 then
        call SaveReal(h,id,TIME_HASH,time-0.015)
    endif
else
set bjLCG=CreateGroup()
call GroupEnumUnitsInRange(bjLCG,tX,tY,350,Base)
loop
set bjLCU=FirstOfGroup(bjLCG)
exitwhen bjLCU==null
if Condition_Base(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)),bjLCU)==true then
call BelfegorStormDamage(LoadUnitHandle(h,id,CasterHash),bjLCU,(full_s-TShield+5)/6)
endif
call GroupRemoveUnit(bjLCG,bjLCU)
endloop
call DestroyGroup(bjLCG)
call SaveReal(h,itar,StringHash("ShieldBelfF"),0)
set bjLCE=AddSpecialEffect("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl",tX,tY)
call SetSpecialEffectScale(bjLCE,2.5)
call DestroyEffect(bjLCE)
set bjLCE=AddSpecialEffect("az_cocoguanyu_t2_death.mdl",tX,tY)
call SetSpecialEffectScale(bjLCE,2.5)
call DestroyEffect(bjLCE)
set bjLCE=AddSpecialEffect("by_wood_effect_yuzhiboyou_fire_babangouyu_2_di_.mdl",tX,tY)
call SetSpecialEffectScale(bjLCE,1.5)
call DestroyEffect(bjLCE)
set bjLCE=AddSpecialEffect("by_wood_effect_yuzhiboyou_fire_babangouyu_1_kong.mdl",tX,tY)
call SetSpecialEffectScale(bjLCE,1.2)
call SetSpecialEffectZ(bjLCE,75)
call DestroyEffect(bjLCE)
call SaveInteger(h,id,StringHash("Act"),2)
endif
else
call SaveReal(h,itar,StringHash("ShieldBelfF"),0)
call ShowUnit(LoadUnitHandle(h,id,DummyHash),true)
call UnitRemoveAbility(LoadUnitHandle(h,id,DummyHash),'Aloc')
call UnitAddAbility(LoadUnitHandle(h,id,DummyHash),'Aloc')
call SetUnitX(LoadUnitHandle(h,id,DummyHash),tX)
call SetUnitY(LoadUnitHandle(h,id,DummyHash),tY)
call DestroyEffect(LoadEffectHandle(h,id,StringHash("EffectShield1")))
call DestroyEffect(LoadEffectHandle(h,id,StringHash("EffectShield2")))
call Belf_BackDummy(LoadUnitHandle(h,id,CasterHash),LoadUnitHandle(h,id,DummyHash),10,CreateTimer())
call FlushChildHashtable(h,id)
call DestroyTimer(GetExpiredTimer())
endif
endfunction
function BelfF_Shield takes unit newCaster,unit newTarget returns nothing
local integer id=0
local real cX=GetUnitX(newCaster)
local real cY=GetUnitY(newCaster)
local real tX=GetUnitX(newTarget)
local real tY=GetUnitY(newTarget)
set bjLCT=CreateTimer()
set id=GetHandleId(bjLCT)
set soundplay=CreateSound("Sound\\war3mapImported\\Belf_F.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
set soundplay=CreateSound("Sound\\war3mapImported\\Belf_RShield.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
set bjLCU=CreateUnit(GetOwningPlayer(newCaster),'dB02',cX,cY,AtanPoint(cX,cY,tX,tY)*bj_RADTODEG)
call SetUnitFlyHeight(bjLCU,175,0)
call SetUnitAnimation(bjLCU,"walk")
call SetUnitScale(bjLCU,0.75,0.75,0.75)
call SaveUnitHandle(h,id,CasterHash,newCaster)
call SaveUnitHandle(h,id,TargetHash,newTarget)
call SaveUnitHandle(h,id,DummyHash,bjLCU)
call SaveInteger(h,id,StringHash("Act"),0)
call TimerStart(bjLCT,0.015,true,function BelfF_Shield_Periodic)
set bjLCT=null
endfunction

function BelfQ_Damage takes unit newCaster,unit newTarget,unit newKnife,real newDamage,boolean stormvaria returns nothing
    local real x=GetUnitX(newTarget)
    local real y=GetUnitY(newTarget)
    local real a=GetUnitFacing(newKnife)
    local integer BelfegorDTime=LoadInteger(HH,GetHandleId(newTarget),StringHash("BelfegorD_Time"))
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",newTarget,"chest"))
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",newTarget,"head"))
    if(GetUnitFacing(newTarget)-a)<=75 and(GetUnitFacing(newTarget)-a)>=-75 and BelfegorDTime==0 and GetHeroLevel(newCaster)>=6 then
        call Belf_CritDamage(newCaster,newTarget,newKnife,newDamage)
    // elseif UnitHaveBelfegorMark(newCaster,newTarget,true)and BelfegorDTime==0 and GetHeroLevel(newCaster)>=6 then
    //     call Belf_CritDamage(newCaster,newTarget,newKnife,newDamage)
    else
        set bjLCE=AddSpecialEffectTarget("re2.mdl",newTarget,"chest")
        call SetSpecialEffectTimeScale(bjLCE,0.7)
        call DestroyEffect(bjLCE)
        set bjLCE=AddSpecialEffect("re2.mdl",x,y)
        call SetSpecialEffectZ(bjLCE,100)
        call SetSpecialEffectScale(bjLCE,1.3)
        call SetSpecialEffectTimeScale(bjLCE,0.8)
        call SetSpecialEffectFacing(bjLCE,a)
        call DestroyEffect(bjLCE)
        if stormvaria then
            call BelfegorStormDamage(newCaster,newTarget,newDamage*0.10)
        endif
        call myCustomDamage(newCaster,newTarget,newDamage,false,false,null,null,null)
    endif
endfunction

function BelfQ_FastCD2 takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local integer ic=GetHandleId(LoadUnitHandle(h,id,CasterHash))
    call SaveBoolean(h,ic,StringHash("BelfegorQ_FastCD"),false)
    call FlushChildHashtable(h,id)
    call DestroyTimer(GetExpiredTimer())
endfunction

function BelfQ_FastCD takes unit newCaster,timer newTimer returns nothing
    local integer ic=GetHandleId(newCaster)
    if LoadBoolean(h,ic,StringHash("BelfegorQ_FastCD"))==false then
        call SaveBoolean(h,ic,StringHash("BelfegorQ_FastCD"),true)
        call StartAbilityCooldown(GetUnitAbility(newCaster,'BelQ'),0.1)
        call SaveUnitHandle(h,GetHandleId(newTimer),CasterHash,newCaster)
        call TimerStart(newTimer,17,false,function BelfQ_FastCD2)
    endif
endfunction

function BelfQ_KnifeGround_Periodic takes nothing returns nothing
	local integer id=GetHandleId(GetExpiredTimer())
	local unit caster=LoadUnitHandle(HH, id, 0)
	local unit dummy=LoadUnitHandle(HH, id, 1)
	local real dummy_x=GetUnitX(dummy)
	local real dummy_y=GetUnitY(dummy)
	local real time=LoadReal(HH, id, 3)-0.05
	local boolean b_act=false
	call SaveReal(HH, id, 3, time)
    set bjLCG = LoadGroupHandle(HH, id, 10)
	if SquareRootUnit(caster, dummy)<200 and GetAbilityRemainingCooldown(GetUnitAbility(caster, 'BelQ'))>1.0 then
		set b_act=true
		call StartAbilityCooldown(GetUnitAbility(caster, 'BelQ'), 0.1)
		call DestroyEffect(AddSpecialEffectTarget("WindCirclefaster.mdl", caster, "origin"))
	else
		if time<=0 then
			set b_act=true
		endif
	endif
    call GroupEnumUnitsInRange(bjLCG, dummy_x, dummy_y, 100, Base)
    loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E==null
        if Condition_Base(GetOwningPlayer(caster), E) and IsUnitPaused(E)==false then
            set b_act = true
        endif
        call GroupRemoveUnit(bjLCG, E)
    endloop
	if b_act then
		call RemoveUnit(dummy)
		call DestroyEffect(LoadEffectHandle(HH, id, 4))
		call DestroyEffect(LoadEffectHandle(HH, id, 5))
        call DestroyGroup(bjLCG)
		call FlushChildHashtable(HH, id)
		call PauseTimer(GetExpiredTimer())
		call DestroyTimer(GetExpiredTimer())
	endif
	set caster=null
	set dummy=null
    set bjLCG=null
endfunction

function BelfQ_KnifeGround takes unit newCaster, unit newKnife, boolean stormvaria returns nothing
	local timer newTimer = CreateTimer()
	local integer id     = GetHandleId(newTimer)
	set n=CreateUnit(GetOwningPlayer(newCaster), 'dM82', GetUnitX(newKnife), GetUnitY(newKnife), GetUnitFacing(newKnife))
	call SetUnitAnimationByIndex(n, 1)
	call SetUnitScale(n,1.5,1.5,1.5)
	//call SetUnitVertexColor(n,255,50,50,255)
	
	call SaveUnitHandle(HH, id, 0, newCaster)
	call SaveUnitHandle(HH, id, 1, n)
	
	if stormvaria then
		set n=CreateUnit(GetOwningPlayer(newCaster), 'dH69', GetUnitX(newKnife), GetUnitY(newKnife), GetUnitFacing(newKnife))
		call SetUnitFlyHeight(n, 50, 0)
		call UnitScale(n, 0.2, 0.05, 0.45)
		call MyRemoveUnit(n, 0.5)
	endif
	
	call SaveReal(HH, id, 3, 10.0)
	
	set bjLCE=AddSpecialEffect("CirclePulse_Blue.mdl", GetUnitX(newKnife), GetUnitY(newKnife))
	call SaveEffectHandle(HH, id, 4, bjLCE)
	set bjLCE=AddSpecialEffect("CirclePulse_Blue.mdl", GetUnitX(newKnife), GetUnitY(newKnife))
	call SaveEffectHandle(HH, id, 5, bjLCE)
	call SaveGroupHandle(HH, id, 10, CreateGroup())
	call TimerStart(newTimer, 0.05, true, function BelfQ_KnifeGround_Periodic)
	set newTimer=null
endfunction

function BelfQ_Periodic takes nothing returns nothing
        local integer id=GetHandleId(GetExpiredTimer())
        local real a=LoadReal(h,id,AngleHash)
        local real speed=25
        local integer act=LoadInteger(h,id,StringHash("Act"))
        local integer time=LoadInteger(h,id,TIME_HASH)
        local real newX=0
        local real newY=0
        local real dmg=LoadReal(h,id,StringHash("Damage"))
        local integer success=LoadInteger(h,id,StringHash("Success"))
        local boolean QFastCD=LoadBoolean(h,GetHandleId(LoadUnitHandle(h,id,CasterHash)),StringHash("BelfegorQ_FastCD"))
        local boolean stormvaria=LoadBoolean(h,id,StringHash("StormVaria"))
        local integer QLevel=GetUnitAbilityLevel(LoadUnitHandle(h,id,CasterHash),'BelQ')
        local real range=85
        if stormvaria then
                set range=130
        endif
        set speed=speed+time*0.2
        if speed>75 then
                set speed=75
        endif
        if act==1 then
                if LoadReal(h,id,StringHash("Dist"))<1100+200*QLevel then
                        set bjLCG=CreateGroup()
                        set bjLCU=LoadUnitHandle(h,id,DummyHash)
                        set newX=GetUnitX(bjLCU)+speed*Cos(a)
                        set newY=GetUnitY(bjLCU)+speed*Sin(a)
                        call SetUnitX(bjLCU,newX)
                        call SetUnitY(bjLCU,newY)
            if IsTerrainPathable(newX+60*Cos(a),newY+60*Sin(a),PATHING_TYPE_FLYABILITY)==false then
                            call SaveReal(h,id,StringHash("Dist"),LoadReal(h,id,StringHash("Dist"))+speed)
            else
                call SaveReal(h,id,StringHash("Dist"),4000)
            endif
                        if stormvaria then
                                set bjLCE=LoadEffectHandle(h,id,StringHash("EffectStorm"))
                                call SetSpecialEffectX(bjLCE,newX)
                                call SetSpecialEffectY(bjLCE,newY)
                                set bjLCE=null
                        endif
                        call GroupEnumUnitsInRange(bjLCG,newX,newY,range,Base)
                        loop
                        set bjLCU=FirstOfGroup(bjLCG)
                        exitwhen bjLCU==null
                                if Condition_Base(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)),bjLCU)==true and IsUnitInGroup(bjLCU,LoadGroupHandle(h,id,StringHash("GroupDummy")))==false and IsUnitInGroup(bjLCU,LoadGroupHandle(h,id,StringHash("GroupMark")))==false then
                                        if UnitHaveBelfegorMark(LoadUnitHandle(h,id,CasterHash),bjLCU,false)then
                                                call GroupAddUnit(LoadGroupHandle(h,id,StringHash("GroupMark")),bjLCU)
                                        else
                                        call GroupAddUnit(LoadGroupHandle(h,id,StringHash("GroupDummy")),bjLCU)
                                endif
                                call BelfQ_Damage(LoadUnitHandle(h,id,CasterHash),bjLCU,LoadUnitHandle(h,id,DummyHash),dmg,stormvaria)
                                call BelfQ_FastCD(LoadUnitHandle(h,id,CasterHash),CreateTimer())
                                endif
                                call GroupRemoveUnit(bjLCG,bjLCU)
                        endloop
                        call DestroyGroup(bjLCG)
                        set bjLCG=null
                        call SaveInteger(h,id,TIME_HASH,time+1)
                else
                        call SaveInteger(h,id,StringHash("Act"),2)
                endif
        elseif act==2 then
                call SaveInteger(h,id,TIME_HASH,time+1)
                set bjLCG=LoadGroupHandle(HH,GetHandleId(LoadUnitHandle(h,id,CasterHash)),StringHash("BelfegorMarkGroup"))
                if success==0 then
                        set bjLCU=FirstOfGroup(bjLCG)
                        if bjLCU!=null then
                                call SaveUnitHandle(h,id,TargetHash,bjLCU)
                                call SaveInteger(h,id,StringHash("Success"),1)
                                call UnitRemoveBelfegorMark(LoadUnitHandle(h,id,CasterHash),bjLCU)
                                set soundplay=CreateSound("Sound\\war3mapImported\\Belf_Q2.mp3",false,false,true,12700,12700,"")
                                call StartSound(soundplay)
                                call KillSoundWhenDone(soundplay)
                        else
                                call SaveInteger(h,id,StringHash("Act"),3)
                        endif
                elseif GetWidgetLife(LoadUnitHandle(h,id,TargetHash))<1 then
                        call SaveUnitHandle(h,id,TargetHash,null)
                        call SaveInteger(h,id,StringHash("Success"),0)
                else
                if SquareRootUnit(LoadUnitHandle(h,id,DummyHash),LoadUnitHandle(h,id,TargetHash))>75 and LoadReal(h,id,StringHash("Dist"))<2200+400*QLevel then
                        set bjLCU=LoadUnitHandle(h,id,DummyHash)
                        set a=AtanPoint(GetUnitX(bjLCU),GetUnitY(bjLCU),GetUnitX(LoadUnitHandle(h,id,TargetHash)),GetUnitY(LoadUnitHandle(h,id,TargetHash)))
                        set newX=GetUnitX(bjLCU)+speed*Cos(a)
                        set newY=GetUnitY(bjLCU)+speed*Sin(a)
                        call SetUnitX(bjLCU,newX)
                        call SetUnitY(bjLCU,newY)
                        if IsTerrainPathable(newX+60*Cos(a),newY+60*Sin(a),PATHING_TYPE_FLYABILITY)==false then
                            call SaveReal(h,id,StringHash("Dist"),LoadReal(h,id,StringHash("Dist"))+speed)
            else
                call SaveReal(h,id,StringHash("Dist"),4000)
            endif
                        if stormvaria then
                                set bjLCE=LoadEffectHandle(h,id,StringHash("EffectStorm"))
                                call SetSpecialEffectX(bjLCE,newX)
                                call SetSpecialEffectY(bjLCE,newY)
                                set bjLCE=null
                        endif
                        call SetUnitFacingInstant(bjLCU,a*bj_RADTODEG)
                        set bjLCG=CreateGroup()
                        call GroupEnumUnitsInRange(bjLCG,newX,newY,range,Base)
                        loop
                        set bjLCU=FirstOfGroup(bjLCG)
                        exitwhen bjLCU==null
                                if Condition_Base(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)),bjLCU)==true and IsUnitInGroup(bjLCU,LoadGroupHandle(h,id,StringHash("GroupDummy")))==false and IsUnitInGroup(bjLCU,LoadGroupHandle(h,id,StringHash("GroupMark")))==false and UnitIsAlive(bjLCU)==true then
                                call GroupAddUnit(LoadGroupHandle(h,id,StringHash("GroupMark")),bjLCU)
                                call BelfQ_Damage(LoadUnitHandle(h,id,CasterHash),bjLCU,LoadUnitHandle(h,id,DummyHash),dmg,stormvaria)
                                endif
                                call GroupRemoveUnit(bjLCG,bjLCU)
                        endloop
                        call DestroyGroup(bjLCG)
                        set bjLCG=null
                else
                        if SquareRootUnit(LoadUnitHandle(h,id,DummyHash),LoadUnitHandle(h,id,TargetHash))<=75 and LoadReal(h,id,StringHash("Dist"))<2200+400*QLevel and UnitIsAlive(LoadUnitHandle(h,id,TargetHash))==true then
                                call BelfQ_Damage(LoadUnitHandle(h,id,CasterHash),LoadUnitHandle(h,id,TargetHash),LoadUnitHandle(h,id,DummyHash),dmg,stormvaria)
                                call SetUnitX(LoadUnitHandle(h,id,DummyHash),GetUnitX(LoadUnitHandle(h,id,TargetHash)))
                                call SetUnitY(LoadUnitHandle(h,id,DummyHash),GetUnitY(LoadUnitHandle(h,id,TargetHash)))
                        endif
                        call RemoveSavedHandle(h,id,TargetHash)
                        call SaveInteger(h,id,StringHash("Success"),0)
                endif
        endif
        else
                set bjLCG=LoadGroupHandle(h,id,StringHash("GroupDummy"))
                loop
                set bjLCU=FirstOfGroup(bjLCG)
                exitwhen bjLCU==null
                        if UnitHaveBelfegorMark(LoadUnitHandle(h,id,CasterHash),bjLCU,false)==false and UnitIsAlive(bjLCU) then
                                call UnitAddBelfegorMark(LoadUnitHandle(h,id,CasterHash),bjLCU)
                        endif
                        call GroupRemoveUnit(bjLCG,bjLCU)
                endloop
                call DestroyGroup(bjLCG)
                if stormvaria then
                        set bjLCE=LoadEffectHandle(h,id,StringHash("EffectStorm"))
                        call RemoveEffect(bjLCE,0,false,CreateTimer())
                        set bjLCE=null
                endif
                set bjLCG=LoadGroupHandle(h,id,StringHash("GroupMark"))
                call DestroyGroup(bjLCG)
                if GetHeroLevel(LoadUnitHandle(h,id,CasterHash))>=6 then
                        call BelfQ_KnifeGround(LoadUnitHandle(h,id,CasterHash), LoadUnitHandle(h,id,DummyHash), stormvaria)
                endif
                call MyRemoveUnit(LoadUnitHandle(h,id,DummyHash), 0.05)
                call FlushChildHashtable(h,id)
                call DestroyTimer(GetExpiredTimer())
        endif
endfunction
function BelfQ_Cast takes unit newCaster,real newAngle returns nothing
        local integer id=0
        local real x=GetUnitX(newCaster)
        local real y=GetUnitY(newCaster)
        local real a=newAngle
        local integer lvl=GetUnitAbilityLevel(newCaster,'BelQ')
        local real dmg=GetHeroInt(newCaster,true)*(1.5+(lvl*0.5))+50
        set bjLCT=CreateTimer()
        set id=GetHandleId(bjLCT)
        if GetRandomInt(0,1)==1 then
        set soundplay=CreateSound("Sound\\war3mapImported\\Belf_Q.mp3",false,false,true,12700,12700,"")
        else
        set soundplay=CreateSound("Sound\\war3mapImported\\Belf_Q1.mp3",false,false,true,12700,12700,"")
        endif
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        set bjLCE=AddSpecialEffect("cf2.mdl",x,y)
        call SetSpecialEffectFacing(bjLCE,a*bj_RADTODEG)
        call SetSpecialEffectZ(bjLCE,50)
        call SetSpecialEffectAlpha(bjLCE,150)
        call SetSpecialEffectScale(bjLCE,0.45)
        call DestroyEffect(bjLCE)
        set bjLCE=AddSpecialEffect("gnaden_air.mdl",x,y)
        call SetSpecialEffectScale(bjLCE,2)
        call DestroyEffect(bjLCE)
        if LoadBoolean(h,GetHandleId(newCaster),StringHash("BelfStormVaria"))==true then
        call SaveBoolean(h,id,StringHash("StormVaria"),true)
        set bjLCE=AddSpecialEffect("qiangdairchannelred.mdl",x,y)
        call SetSpecialEffectZ(bjLCE,100)
        call SetSpecialEffectScale(bjLCE,0.05)
        call SaveEffectHandle(h,id,StringHash("EffectStorm"),bjLCE)
        endif
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster),'dB03',x+25*Cos(a),y+25*Sin(a),a*bj_RADTODEG)
        call SetUnitFlyHeight(bjLCU,125,0)
        call SetUnitScale(bjLCU,1.5,1.5,1.5)
        call SetUnitVertexColor(bjLCU,255,50,50,255)
        call SaveUnitHandle(h,id,DummyHash,bjLCU)
        set bjLCU=newCaster
        call SaveUnitHandle(h,id,CasterHash,bjLCU)
        call SaveReal(h,id,AngleHash,a)
        call SaveReal(h,id,StringHash("Damage"),dmg)
        call SaveInteger(h,id,StringHash("Act"),1)
        call SaveInteger(h,id,TIME_HASH,0)
        call SaveGroupHandle(h,id,StringHash("GroupDummy"),CreateGroup())
        call SaveGroupHandle(h,id,StringHash("GroupMark"),CreateGroup())
        call TimerStart(bjLCT,0.009,true,function BelfQ_Periodic)
        set bjLCT=null
endfunction
function BelfW_Push_Periodic takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local real x=GetUnitX(LoadUnitHandle(h,id,CasterHash))
local real y=GetUnitY(LoadUnitHandle(h,id,CasterHash))
local real TargetX=LoadReal(h,id,StringHash("TargetX"))
local real TargetY=LoadReal(h,id,StringHash("TargetY"))
local real a=AtanPoint(x,y,TargetX,TargetY)
local real time = LoadReal(h, id, TIME_HASH)
if SquareRoot((TargetX-x)*(TargetX-x)+(TargetY-y)*(TargetY-y))>50 and udg_B==true and time<2.5 then
call SetUnitX(LoadUnitHandle(h,id,CasterHash),x+70*Cos(a))
call SetUnitY(LoadUnitHandle(h,id,CasterHash),y+70*Sin(a))
call SaveReal(h, id, TIME_HASH, time+0.01)
else
call SetUnitX(LoadUnitHandle(h,id,CasterHash),TargetX)
call SetUnitY(LoadUnitHandle(h,id,CasterHash),TargetY)
call FlushChildHashtable(h,id)
call DestroyTimer(GetExpiredTimer())
endif
endfunction
function BelfW_Push takes unit newCaster,real newX,real newY returns nothing
local integer id=0
set bjLCT=CreateTimer()
set id=GetHandleId(bjLCT)
call SaveUnitHandle(h,id,CasterHash,newCaster)
call SaveReal(h,id,StringHash("TargetX"),newX)
call SaveReal(h,id,StringHash("TargetY"),newY)
call TimerStart(bjLCT,0.01,true,function BelfW_Push_Periodic)
set bjLCT=null
endfunction
function BelfW_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local real a=LoadReal(h,id,AngleHash)
    local real speed=18.75
    local integer act=LoadInteger(h,id,StringHash("Act"))
    local integer time=LoadInteger(h,id,TIME_HASH)
    local real newX=0
    local real newY=0
    local real dmg=0
    local integer effect_period=LoadInteger(h,id,EffectPeriodHash)
    local boolean stormvaria=LoadBoolean(h,id,StringHash("StormVaria"))
    if time<120 then
        if time<=40 then
            if time==40 then
                set bjLCU=LoadUnitHandle(h,id,DummyHash)
                set newX=GetUnitX(bjLCU)+50*Cos(a)
                set newY=GetUnitY(bjLCU)+50*Sin(a)
                set bjLCE=AddSpecialEffect("cf2.mdl",newX,newY)
                call SetSpecialEffectFacing(bjLCE,a*bj_RADTODEG)
                call SetSpecialEffectZ(bjLCE,75)
                call SetSpecialEffectScale(bjLCE,0.7)
                call DestroyEffect(bjLCE)
            endif
        else
            set bjLCG=CreateGroup()
            set bjLCU=LoadUnitHandle(h,id,DummyHash)
            set newX=GetUnitX(bjLCU)+speed*Cos(a)
            set newY=GetUnitY(bjLCU)+speed*Sin(a)
            if(IsTerrainPathable(newX,newY,PATHING_TYPE_FLYABILITY)==false)then
                call SetUnitX(bjLCU,newX)
                call SetUnitY(bjLCU,newY)
            endif
            call GroupEnumUnitsInRange(bjLCG,newX,newY,200,Base)
            loop
            set bjLCU=FirstOfGroup(bjLCG)
            exitwhen bjLCU==null
            if Condition_Base(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)),bjLCU)==true and IsUnitInGroup(bjLCU,LoadGroupHandle(h,id,StringHash("GroupDummy")))==false then
                set dmg=GetHeroInt(LoadUnitHandle(h,id,CasterHash), true)*I2R(GetUnitAbilityLevel(LoadUnitHandle(h,id,CasterHash),'BelW')+2)
                call myCustomDamage(LoadUnitHandle(h,id,CasterHash),bjLCU,dmg,false,false,null,null,null)
                call UnitAddBelfegorMark(LoadUnitHandle(h,id,CasterHash),bjLCU)
                if stormvaria then
                    set dmg=GetHeroInt(LoadUnitHandle(h,id,CasterHash), true)*2
                    call BelfegorStormDamage(LoadUnitHandle(h,id,CasterHash),bjLCU,dmg)
                endif
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",bjLCU,"chest"))
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",bjLCU,"head"))
                set bjLCE=AddSpecialEffect("akiha_claw_red.mdl",GetUnitX(bjLCU),GetUnitY(bjLCU))
                call SetSpecialEffectZ(bjLCE,GetUnitFlyHeight(bjLCU)+50)
                call SetSpecialEffectTimeScale(bjLCE,1.1)
                call SetSpecialEffectScale(bjLCE,0.6)
                call SetSpecialEffectFacing(bjLCE,a*bj_RADTODEG+GetRandomInt(65,135))
                call DestroyEffect(bjLCE)
                set bjLCE=AddSpecialEffect("blood-4.mdl",GetUnitX(bjLCU),GetUnitY(bjLCU))
                call SetSpecialEffectZ(bjLCE,GetUnitFlyHeight(bjLCU)+50)
                call SetSpecialEffectScale(bjLCE,1.4)
                call SetSpecialEffectFacing(bjLCE,a*bj_RADTODEG+GetRandomInt(65,135))
                call DestroyEffect(bjLCE)
                call GroupAddUnit(LoadGroupHandle(h,id,StringHash("GroupDummy")),bjLCU)
            endif
            call GroupRemoveUnit(bjLCG,bjLCU)
            endloop
            call DestroyGroup(bjLCG)
            set bjLCG=null
            if effect_period==0 then
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)),'dB04',newX,newY,a*bj_RADTODEG)
                call SetUnitAnimation(bjLCU,"birth")
                call SetUnitVertexColor(bjLCU,255,255,255,135)
                call SetUnitScale(bjLCU,1.75,1.75,1)
                call SetUnitFlyHeight(bjLCU, 1, 0)
                call UnitApplyTimedLife(bjLCU,0,1.2)
                call SaveInteger(h,id,EffectPeriodHash,10)
            else
                call SaveInteger(h,id,EffectPeriodHash,effect_period-1)
            endif
        endif
        call SaveInteger(h,id,TIME_HASH,time+1)
    else
        if GetUnitCurrentOrder(LoadUnitHandle(h,id,CasterHash))==OrderId("charm")then
            set bjLCU=LoadUnitHandle(h,id,DummyHash)
            call BelfW_Push(LoadUnitHandle(h,id,CasterHash),GetUnitX(bjLCU),GetUnitY(bjLCU))
            call IssueImmediateOrder(LoadUnitHandle(h,id,CasterHash),"stop")
            call SetUnitAnimationByIndex(LoadUnitHandle(h,id,CasterHash),14)
        else
            call UnitAddAbilityTimed(LoadUnitHandle(h,id,CasterHash),1.5,'A27K')
        endif
        set newX=GetUnitX(LoadUnitHandle(h,id,DummyHash))
        set newY=GetUnitY(LoadUnitHandle(h,id,DummyHash))
        set bjLCE=AddSpecialEffect("blinkcaster.mdl",newX,newY)
        call SetSpecialEffectZ(bjLCE,60)
        call SetSpecialEffectFacing(bjLCE,90)
        call SetSpecialEffectScale(bjLCE,0.7)
        call DestroyEffect(bjLCE)
        set bjLCE=AddSpecialEffect("blinkcaster.mdl",newX,newY)
        call SetSpecialEffectZ(bjLCE,60)
        call SetSpecialEffectFacing(bjLCE,45)
        call SetSpecialEffectScale(bjLCE,1.2)
        call DestroyEffect(bjLCE)
        set bjLCE=AddSpecialEffect("BY_Wood_Eff_Ord_DanGe_Wav_Kuosan_1_4_1s.mdl",newX,newY)
        call SetSpecialEffectScale(bjLCE,0.3)
        call SetSpecialEffectAlpha(bjLCE,155)
        call DestroyEffect(bjLCE)
        set soundplay=CreateSound("Sound\\war3mapImported\\Belf_W1.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        set soundplay=CreateSound("Sound\\war3mapImported\\Belf_W2.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        call RemoveUnit(LoadUnitHandle(h,id,DummyHash))
        call FlushChildHashtable(h,id)
        call DestroyTimer(GetExpiredTimer())
    endif
endfunction
function BelfW_Cast takes unit newCaster,real newAngle returns nothing
    local integer id=0
    local real x=GetUnitX(newCaster)
    local real y=GetUnitY(newCaster)
    local real a=newAngle
    set bjLCT=CreateTimer()
    set id=GetHandleId(bjLCT)
    set soundplay=CreateSound("Sound\\war3mapImported\\Belf_W.mp3",false,false,true,12700,12700,"")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster),'dBel',x,y,GetRandomReal(0,359))
    call UnitAddAbility(bjLCU,'BelI')
    call UnitApplyTimedLife(bjLCU,1,2)
    call IssueTargetOrder(bjLCU,"invisibility",newCaster)
    if LoadBoolean(h,GetHandleId(newCaster),StringHash("BelfStormVaria"))==true then
        call SaveBoolean(h,id,StringHash("StormVaria"),true)
    endif
    set bjLCE=AddSpecialEffect("az_pa_b1.mdl",x+100*Cos(a),y+100*Sin(a))
    call DestroyEffect(bjLCE)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster),'cBel',x+100*Cos(a),y+100*Sin(a),a*bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU,0,0)
    call SetUnitScale(bjLCU,1.2,1.2,1.2)
    call SetUnitAnimationByIndex(bjLCU,4)
    call SetUnitVertexColor(bjLCU,GetRandomInt(50,150),GetRandomInt(50,150),GetRandomInt(100,250),200)
    call SaveUnitHandle(h,id,DummyHash,bjLCU)
    call SaveUnitHandle(h,id,CasterHash,newCaster)
    call SaveReal(h,id,AngleHash,a)
    call SaveInteger(h,id,StringHash("Act"),1)
    call SaveInteger(h,id,TIME_HASH,0)
    call SaveInteger(h,id,EffectPeriodHash,10)
    call SaveGroupHandle(h,id,StringHash("GroupDummy"),CreateGroup())
    call TimerStart(bjLCT,0.007,true,function BelfW_Periodic)
    set bjLCT=null
endfunction
function BelfE_Act2_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local integer act=LoadInteger(h,id,StringHash("Act"))
    local real x=GetUnitX(LoadUnitHandle(h,id,CasterHash))
    local real y=GetUnitY(LoadUnitHandle(h,id,CasterHash))
    local real TargetX=GetUnitX(LoadUnitHandle(h,id,TargetHash))
    local real TargetY=GetUnitY(LoadUnitHandle(h,id,TargetHash))
    local real a=AtanPoint(x,y,TargetX,TargetY)
    local integer time=LoadInteger(h,id,TIME_HASH)
    local integer effect_period=LoadInteger(h,id,StringHash("Effect_Period"))
    local real dmg=GetHeroInt(LoadUnitHandle(h,id,CasterHash),true)*(3+GetUnitAbilityLevel(LoadUnitHandle(h,id,CasterHash),'BelE'))
    local boolean stormvaria=LoadBoolean(h,id,StringHash("StormVaria"))
    call SaveInteger(h,id,TIME_HASH,time+1)
    if act==1 then
        if time==50 then
            set bjLCE=AddSpecialEffect("cf2.mdl",GetUnitX(LoadUnitHandle(h,id,CasterHash)),GetUnitY(LoadUnitHandle(h,id,CasterHash)))
            call SetSpecialEffectFacing(bjLCE,a*bj_RADTODEG)
            call SetSpecialEffectZ(bjLCE,50)
            call SetSpecialEffectAlpha(bjLCE,150)
            call SetSpecialEffectScale(bjLCE,0.55)
            call DestroyEffect(bjLCE)
            call SetUnitAnimationByIndex(LoadUnitHandle(h,id,CasterHash),4)
        endif
        if time>70 then
            if SquareRoot((TargetX-x)*(TargetX-x)+(TargetY-y)*(TargetY-y))>60 and GetWidgetLife(LoadUnitHandle(h,id,TargetHash))>0.1 then
                set x=x+30*Cos(a)
                set y=y+30*Sin(a)
                call PauseUnit(LoadUnitHandle(h,id,CasterHash),true)
                call PauseUnit(LoadUnitHandle(h,id,TargetHash),true)
                call SetUnitInvulnerable(LoadUnitHandle(h,id,TargetHash),true)
                call SetUnitInvulnerable(LoadUnitHandle(h,id,CasterHash),true)
                call SetUnitX(LoadUnitHandle(h,id,CasterHash),x)
                call SetUnitY(LoadUnitHandle(h,id,CasterHash),y)
                call SetUnitFacingInstant(LoadUnitHandle(h,id,CasterHash),a*bj_RADTODEG)
            else
                set soundplay=CreateSound("Sound\\war3mapImported\\Belf_E1.mp3",false,false,true,12700,12700,"")
                call StartSound(soundplay)
                call KillSoundWhenDone(soundplay)
                call SetUnitTimeScale(LoadUnitHandle(h,id,CasterHash),2)
                call SaveInteger(h,id,TIME_HASH,0)
                call SaveInteger(h,id,StringHash("Act"),2)
            endif
        endif
    elseif act==2 then
        if time<180 then
            set TargetX=GetUnitX(LoadUnitHandle(h,id,TargetHash))
            set TargetY=GetUnitY(LoadUnitHandle(h,id,TargetHash))
            set a=AtanPoint(x,y,TargetX,TargetY)
            set TargetX=TargetX+4*Cos(a)
            set TargetY=TargetY+4*Sin(a)
            call PauseUnit(LoadUnitHandle(h,id,CasterHash),true)
            call PauseUnit(LoadUnitHandle(h,id,TargetHash),true)
            call SetUnitInvulnerable(LoadUnitHandle(h,id,TargetHash),true)
            call SetUnitInvulnerable(LoadUnitHandle(h,id,CasterHash),true)
            call SetUnitX(LoadUnitHandle(h,id,CasterHash),TargetX-60*Cos(a))
            call SetUnitY(LoadUnitHandle(h,id,CasterHash),TargetY-60*Sin(a))
            call SetUnitX(LoadUnitHandle(h,id,TargetHash),TargetX)
            call SetUnitY(LoadUnitHandle(h,id,TargetHash),TargetY)
            call SetUnitFacingInstant(LoadUnitHandle(h,id,CasterHash),a*bj_RADTODEG)
            call SaveInteger(h,id,TIME_HASH,time+1)
            if effect_period<=0 then
                call SetUnitAnimation(LoadUnitHandle(h,id,CasterHash),"attack")
                if GetRandomInt(0,3)==0 then
                    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",LoadUnitHandle(h,id,TargetHash),"chest"))
                    if GetRandomInt(0,1)==0 then
                        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",LoadUnitHandle(h,id,TargetHash),"head"))
                    else
                        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",LoadUnitHandle(h,id,TargetHash),"hand left"))
                        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",LoadUnitHandle(h,id,TargetHash),"hand right"))
                    endif
                endif
                set bjLCE=AddSpecialEffect("az_dz20190202_a.mdl",x+60*Cos(a),y+60*Sin(a))
                call SetSpecialEffectScale(bjLCE,GetRandomReal(0.45,0.75))
                call SetSpecialEffectAlpha(bjLCE,160)
                call SetSpecialEffectFacing(bjLCE,a*bj_RADTODEG+GetRandomInt(-60,60))
                call RemoveEffect(bjLCE,0.40,true,CreateTimer())
                if stormvaria then
                    call SetSpecialEffectVertexColour(bjLCE,255,55,55,255)
                endif
                call SaveInteger(h,id,StringHash("Effect_Period"),5)
            else
                call SaveInteger(h,id,StringHash("Effect_Period"),effect_period-1)
            endif
        else
            set TargetX=GetUnitX(LoadUnitHandle(h,id,TargetHash))+25*Cos(a)
            set TargetY=GetUnitY(LoadUnitHandle(h,id,TargetHash))+25*Sin(a)
            set a=AtanPoint(x,y,TargetX,TargetY)
            set bjLCE=AddSpecialEffect("by_wood_effect_order_dange_liangyishi_zhisizhimoyanzhanji.mdl",TargetX,TargetY)
            call SetSpecialEffectZ(bjLCE,120)
            call SetSpecialEffectFacing(bjLCE,a*bj_RADTODEG)
            call SetSpecialEffectScale(bjLCE,1.75)
            call DestroyEffect(bjLCE)
            set bjLCE=AddSpecialEffect("blood-4.mdl",TargetX,TargetY)
            call SetSpecialEffectZ(bjLCE,50)
            call SetSpecialEffectScale(bjLCE, 2)
            call SetSpecialEffectFacing(bjLCE,a*bj_RADTODEG+GetRandomInt(65,135))
            call DestroyEffect(bjLCE)
            set bjLCE=AddSpecialEffect("blood-boom.mdl",TargetX,TargetY)
            call SetSpecialEffectZ(bjLCE,50)
            call SetSpecialEffectScale(bjLCE, 2)
            call SetSpecialEffectFacing(bjLCE,a*bj_RADTODEG+GetRandomInt(65,135))
            call DestroyEffect(bjLCE)
            set bjLCE=AddSpecialEffect("az_hitheavy.mdl",TargetX,TargetY)
            call SetSpecialEffectZ(bjLCE,55)
            call SetSpecialEffectScale(bjLCE,1.7)
            call SetSpecialEffectFacing(bjLCE,a*bj_RADTODEG)
            call DestroyEffect(bjLCE)
            call SetUnitTimeScale(LoadUnitHandle(h,id,CasterHash),2)
            call Push(LoadUnitHandle(h,id,TargetHash),50,a,600)
            if GetWidgetLife(LoadUnitHandle(h,id,CasterHash))<=GetWidgetMaxLife(LoadUnitHandle(h,id,CasterHash))*0.35 and GetUnitAbilityLevel(LoadUnitHandle(h,id,CasterHash),'BelE')!=0 then
                set dmg=dmg+(GetWidgetMaxLife(LoadUnitHandle(h,id,CasterHash))-GetWidgetLife(LoadUnitHandle(h,id,CasterHash)))*0.1
            endif
            call PauseUnit(LoadUnitHandle(h,id,TargetHash),false)
            call SaveBoolean(HH,GetHandleId(LoadUnitHandle(h,id,TargetHash)),TARGET_ABILITY,false)
            call SetUnitInvulnerable(LoadUnitHandle(h,id,TargetHash),false)
            call myCustomDamage(LoadUnitHandle(h,id,CasterHash),LoadUnitHandle(h,id,TargetHash),dmg/2,false,false,null,null,null)
            call SetControlToUnit(LoadUnitHandle(h,id,CasterHash),LoadUnitHandle(h,id,TargetHash),2,"stun")
            if stormvaria then
                call BelfegorStormDamage(LoadUnitHandle(h,id,CasterHash),LoadUnitHandle(h,id,TargetHash),dmg*0.1)
            endif
            call SaveInteger(h,id,StringHash("Act"),3)
        endif
    elseif act==3 then
        call SetUnitTimeScale(LoadUnitHandle(h,id,CasterHash),1)
        call PauseUnit(LoadUnitHandle(h,id,CasterHash),false)
        call SetUnitInvulnerable(LoadUnitHandle(h,id,CasterHash),false)
        call FlushChildHashtable(h,id)
        call DestroyTimer(GetExpiredTimer())
    endif
endfunction
function BelfE_Act2 takes unit newCaster,unit newTarget,real newDMG,timer newT returns nothing
local integer id=GetHandleId(newT)
local real x=GetUnitX(newCaster)
local real y=GetUnitY(newCaster)
local real TargetX=GetUnitX(newTarget)
local real TargetY=GetUnitY(newTarget)
local real a=AtanPoint(x,y,TargetX,TargetY)
call IssueImmediateOrder(newTarget,"stop")
call PauseUnit(newTarget,true)
call SaveBoolean(HH,GetHandleId(newTarget),TARGET_ABILITY,true)
call SetUnitInvulnerable(newTarget,true)
call SetUnitInvulnerable(newCaster,true)
if LoadBoolean(h,GetHandleId(newCaster),StringHash("BelfStormVaria"))==true then
call SaveBoolean(h,id,StringHash("StormVaria"),true)
endif
call SaveUnitHandle(h,id,CasterHash,newCaster)
call SaveUnitHandle(h,id,TargetHash,newTarget)
call SaveReal(h,id,AngleHash,a)
call SaveInteger(h,id,EffectPeriodHash,3)
call SaveInteger(h,id,StringHash("Act"),1)
call TimerStart(newT,0.01,true,function BelfE_Act2_Periodic)
endfunction
function BelfE_Periodic takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local real a=LoadReal(h,id,AngleHash)
local real x=GetUnitX(LoadUnitHandle(h,id,CasterHash))
local real y=GetUnitY(LoadUnitHandle(h,id,CasterHash))
local real dist=LoadReal(h,id,StringHash("Distance"))
local integer effect_period=LoadInteger(h,id,StringHash("Effect_Period"))
local integer time=LoadInteger(h,id,TIME_HASH)
local integer act=LoadInteger(h,id,StringHash("Act"))
local real TargetX=0
local real TargetY=0
local real dmg=GetHeroInt(LoadUnitHandle(h,id,CasterHash),true)*(3+GetUnitAbilityLevel(LoadUnitHandle(h,id,CasterHash),'BelE'))
local boolean stormvaria=LoadBoolean(h,id,StringHash("StormVaria"))
if GetWidgetLife(LoadUnitHandle(h,id,CasterHash))<=GetWidgetMaxLife(LoadUnitHandle(h,id,CasterHash))*0.35 and GetUnitAbilityLevel(LoadUnitHandle(h,id,CasterHash),'BelE')!=0 then
    set dmg=dmg+(GetWidgetMaxLife(LoadUnitHandle(h,id,CasterHash))-GetWidgetLife(LoadUnitHandle(h,id,CasterHash)))*0.1
endif
if act==0 then
    if dist<1000 and LoadBoolean(HH,GetHandleId(LoadUnitHandle(h,id,CasterHash)),DASH_USER)==true then
        set x=x+30*Cos(a)
        set y=y+30*Sin(a)
        call PauseUnit(LoadUnitHandle(h,id,CasterHash),true)
        call SetUnitX(LoadUnitHandle(h,id,CasterHash),x)
        call SetUnitY(LoadUnitHandle(h,id,CasterHash),y)
        call SaveReal(h,id,StringHash("Distance"),dist+30)
        if effect_period<=0 then
            set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)),'dR45',x,y,a*bj_RADTODEG)
            // call SetUnitModel(bjLCU,"sand.mdl")
            call SetUnitScale(bjLCU,0.85,0.85,0.85)
            call UnitApplyTimedLife(bjLCU,1,2)
            call SaveInteger(h,id,StringHash("Effect_Period"),3)
        else
            call SaveInteger(h,id,StringHash("Effect_Period"),effect_period-1)
        endif
        set bjLCG=CreateGroup()
        call GroupEnumUnitsInRange(bjLCG,x,y,125,Base)
        loop
        set bjLCU=FirstOfGroup(bjLCG)
        exitwhen bjLCU==null or act!=0
        if Condition_Base(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)),bjLCU)==true and IsUnitInGroup(bjLCU,LoadGroupHandle(h,id,StringHash("GroupDummy")))==false and IsUnitInvulnerable(bjLCU)==false then
            if LoadBoolean(HH,GetHandleId(bjLCU),ANTITARGET_ABILITY)==false then    
                call IssueImmediateOrder(bjLCU,"stop")
                call myCustomDamage(LoadUnitHandle(h,id,CasterHash),bjLCU,dmg/2,false,false,null,null,null)
                set bjLCE = AddSpecialEffect("blood-4.mdl", GetUnitX(bjLCU), GetUnitY(bjLCU))
                call SetSpecialEffectZ(bjLCE, 50)
                call SetSpecialEffectScale(bjLCE, 1.4)
                call SetSpecialEffectFacing(bjLCE, a*bj_RADTODEG+GetRandomInt(65, 135))
                call DestroyEffect(bjLCE)
                set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)),'dH01',GetUnitX(bjLCU),GetUnitY(bjLCU),a*bj_RADTODEG)
                call SetUnitScale(n,1.4,1.4,1.4)
                call SetUnitFlyHeight(n,55,0)
                call UnitApplyTimedLife(n,1,2)
                call Push(bjLCU,50,a,500)
                call BelfE_Act2(LoadUnitHandle(h,id,CasterHash),bjLCU,dmg/2,CreateTimer())
                call SaveInteger(h,id,StringHash("Act"),1)
                call GroupClear(bjLCG)
            else
                call SaveBoolean(HH,GetHandleId(LoadUnitHandle(h,id,CasterHash)),DASH_USER,false)
                call SaveUnitHandle(HH,GetHandleId(bjLCU),REVERSE_TARGET,LoadUnitHandle(h,id,CasterHash))
            endif
        endif
        call GroupRemoveUnit(bjLCG,bjLCU)
        endloop
        call DestroyGroup(bjLCG)
        set bjLCG=null
    else
        call SaveBoolean(HH,GetHandleId(LoadUnitHandle(h,id,CasterHash)),DASH_USER,false)
        call SaveInteger(h,id,StringHash("Act"),3)
        call PauseUnit(LoadUnitHandle(h,id,CasterHash),false)
        call IssueImmediateOrder(LoadUnitHandle(h,id,CasterHash), "stop")
        call StartAbilityCooldown(GetUnitAbility(LoadUnitHandle(h,id,CasterHash),'BelE'), 12.5)
    endif
else
    if act==3 then
        call PauseUnit(LoadUnitHandle(h,id,CasterHash),false)
        call SetUnitInvulnerable(LoadUnitHandle(h,id,CasterHash),false)
    endif
        call FlushChildHashtable(h,id)
        call DestroyTimer(GetExpiredTimer())
    endif
endfunction
function BelfE_Cast takes unit newCaster,real TargetX,real TargetY returns nothing
local integer id=0
local real x=GetUnitX(newCaster)
local real y=GetUnitY(newCaster)
local real a=AtanPoint(x,y,TargetX,TargetY)
set bjLCT=CreateTimer()
set id=GetHandleId(bjLCT)
set soundplay=CreateSound("Sound\\war3mapImported\\Belf_E.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call IssueImmediateOrder(newCaster,"stop")
call SaveBoolean(HH,GetHandleId(newCaster),DASH_USER,true)
call PauseUnit(newCaster,true)
call SetUnitInvulnerable(newCaster,true)
call SetUnitAnimationByIndex(newCaster,9)
set bjLCE=AddSpecialEffect("cf2.mdl",GetUnitX(newCaster),GetUnitY(newCaster))
call SetSpecialEffectFacing(bjLCE,a*bj_RADTODEG)
call SetSpecialEffectZ(bjLCE,50)
//call SetSpecialEffectAlpha(bjLCE,150)
call SetSpecialEffectScale(bjLCE,0.55)
call DestroyEffect(bjLCE)
set bjLCE=AddSpecialEffect("Ikarice2_FAW34.mdl",GetUnitX(newCaster)+50*Cos(a),GetUnitY(newCaster)+50*Sin(a))
call SetSpecialEffectZ(bjLCE,150)
//call SetSpecialEffectAlpha(bjLCE,95)
call SetSpecialEffectScale(bjLCE,1.25)
call SetSpecialEffectRoll(bjLCE,90)
call SetSpecialEffectOrientation(bjLCE , a* bj_RADTODEG,-90,0)
call RemoveEffect(bjLCE,0.3,false,CreateTimer())
call DestroyEffect(bjLCE)
if LoadBoolean(h,GetHandleId(newCaster),StringHash("BelfStormVaria"))==true then
call SaveBoolean(h,id,StringHash("StormVaria"),true)
endif
call SaveUnitHandle(h,id,CasterHash,newCaster)
call SaveReal(h,id,AngleHash,a)
call SaveInteger(h,id,StringHash("Effect_Period"),3)
call SaveInteger(h,id,StringHash("Act"),0)
call SaveInteger(h,id,TIME_HASH,0)
call SaveInteger(h,id,StringHash("Distance"),0)
call TimerStart(bjLCT,0.01,true,function BelfE_Periodic)
set bjLCT=null
endfunction
function BelfR_Periodic takes nothing returns nothing
	local integer id=GetHandleId(GetExpiredTimer())
	local integer time=LoadInteger(h,id,TIME_HASH)
	local real x=GetUnitX(LoadUnitHandle(h,id,CasterHash))
	local real y=GetUnitY(LoadUnitHandle(h,id,CasterHash))
	local real newX=0
	local real newY=0
	local integer lvl=GetUnitAbilityLevel(LoadUnitHandle(h,id,CasterHash),'BelR')
	if time==0 then
        call DisableUnitAbility2(LoadUnitHandle(h,id,CasterHash),'BelR',false,true)
    endif
    if time<(4+lvl*2)*100 and GetWidgetLife(LoadUnitHandle(h,id,CasterHash))>0.1 and udg_B and DU2 then
        if CheckUnitInvisible(LoadUnitHandle(h,id,CasterHash)) then
            call UnitAddAbility(LoadUnitHandle(h,id,Effect1Hash),'Ao7S')
        else
            call UnitRemoveAbility(LoadUnitHandle(h,id,Effect1Hash),'Ao7S')
        endif
                set bjLCU=LoadUnitHandle(h,id,Effect1Hash)
                set newX=GetUnitX(LoadUnitHandle(h,id,CasterHash))
                set newY=GetUnitY(LoadUnitHandle(h,id,CasterHash))
                call SetUnitX(bjLCU,newX)
                call SetUnitY(bjLCU,newY)
        call SaveBoolean(h,GetHandleId(LoadUnitHandle(h,id,CasterHash)),StringHash("BelfStormVaria"),true)
                call SetUnitFlyHeight(bjLCU,GetUnitFlyHeight(LoadUnitHandle(h,id,CasterHash))+70,0)
                if GetUnitAbilityLevel(LoadUnitHandle(h,id,CasterHash),'Binv')!=0 then
                        if GetUnitAbilityLevel(bjLCU,'A0A1')==0 then
                                call UnitAddAbility(bjLCU,'A0A1')
                        endif
                elseif GetUnitAbilityLevel(LoadUnitHandle(h,id,CasterHash),'B00V')!=0 then
                        if GetUnitAbilityLevel(bjLCU,'A0A1')==0 then
                                call UnitAddAbility(bjLCU,'A0A1')
                        endif
                else
                        if GetUnitAbilityLevel(bjLCU,'A0A1')==1 then
                                call UnitRemoveAbility(bjLCU,'A0A1')
                        endif
                endif
        if IsUnitPaused(LoadUnitHandle(h,id,CasterHash))==false and IsUnitHidden(LoadUnitHandle(h,id,CasterHash))==false and GetUnitAbilityLevel(LoadUnitHandle(h, id, CasterHash),'Pet1')==0 then
                    call SaveInteger(h,id,TIME_HASH,time+1)
        endif
	else
		call SaveBoolean(h,GetHandleId(LoadUnitHandle(h,id,CasterHash)),StringHash("BelfStormVaria"),false)
		call RemoveUnit(LoadUnitHandle(h,id,Effect1Hash))
        call EnableUnitAbility2(LoadUnitHandle(h,id,CasterHash),'BelR',false,true)
		call FlushChildHashtable(h,id)
		call DestroyTimer(GetExpiredTimer())
	endif
endfunction

function BelfR_Cast takes unit newCaster returns nothing
        local integer id=0
        local real x=GetUnitX(newCaster)
        local real y=GetUnitY(newCaster)
        set bjLCT=CreateTimer()
        set id=GetHandleId(bjLCT)
        set soundplay=CreateSound("Sound\\war3mapImported\\Belf_R.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        set bjLCE=AddSpecialEffect("az_cocoguanyu_t2_death.mdl",x,y)
        call SetSpecialEffectScale(bjLCE,2)
        call DestroyEffect(bjLCE)
        set bjLCE=AddSpecialEffect("az_cocoguanyu_t2_death.mdl",x,y)
        call SetSpecialEffectScale(bjLCE,3.5)
        call SetSpecialEffectZ(bjLCE,-250)
        call DestroyEffect(bjLCE)
        set bjLCE=AddSpecialEffect("by_wood_bashenan_juqi_2.mdl",x,y)
        call SetSpecialEffectZ(bjLCE,170)
        call DestroyEffect(bjLCE)
        call SaveBoolean(h,GetHandleId(newCaster),StringHash("BelfStormVaria"),true)
    call CreateModeIndicatorWithPauseForm(newCaster, "ReplaceableTextures\\CommandButtons\\BTNBelfR.blp", 4+GetUnitAbilityLevel(newCaster,'BelR')*2)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster),'dH69',x,y,0)
        call SetUnitScale(bjLCU,0.25,0.25,0.25)
        call SaveUnitHandle(h,id,Effect1Hash,bjLCU)
        call SaveUnitHandle(h,id,CasterHash,newCaster)
        call SaveInteger(h,id,TIME_HASH,0)
        call TimerStart(bjLCT,0.01,true,function BelfR_Periodic)
        set bjLCT=null
endfunction
function BelfTClone_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local real a=LoadReal(h,id,AngleHash)
    local integer time=LoadInteger(h,id,StringHash("Time"))
    local real newX=0
    local real newY=0
    local unit EBel
	local integer effect_period=LoadInteger(h,id,EffectPeriodHash)
    //local group g2=CreateGroup()
	if time<60 then
		if time<=30 then
			if time==30 then
				set bjLCU=LoadUnitHandle(h,id,DummyHash)
				set newX=GetUnitX(bjLCU)+50*Cos(a)
				set newY=GetUnitY(bjLCU)+50*Sin(a)
				set bjLCE=AddSpecialEffect("cf2.mdl",newX,newY)
				call SetSpecialEffectFacing(bjLCE,a*bj_RADTODEG)
				call SetSpecialEffectZ(bjLCE,75)
				call SetSpecialEffectScale(bjLCE,0.7)
				call DestroyEffect(bjLCE)
			endif
		else
			set bjLCU=LoadUnitHandle(h,id,DummyHash)
			set newX=GetUnitX(bjLCU)+25*Cos(a)
			set newY=GetUnitY(bjLCU)+25*Sin(a)
			if(IsTerrainPathable(newX,newY,PATHING_TYPE_FLYABILITY)==false)then
				call SetUnitX(bjLCU,newX)
				call SetUnitY(bjLCU,newY)
			endif
			// call GroupEnumUnitsInRange(g2,newX,newY,200,Base)
			// loop
			// set EBel=FirstOfGroup(g2)
			// exitwhen EBel==null
			// if Condition_Base(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)),EBel)==true and IsUnitInGroup(EBel,LoadGroupHandle(h,id,StringHash("GroupDummy")))==false then
			// call UnitAddBelfegorMark(LoadUnitHandle(h,id,CasterHash),EBel)
			// //call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",EBel,"head"))
			// set bjLCE=AddSpecialEffect("akiha_claw_red.mdl",GetUnitX(EBel),GetUnitY(EBel))
			// call SetSpecialEffectZ(bjLCE,GetUnitFlyHeight(EBel)+50)
			// call SetSpecialEffectTimeScale(bjLCE,1.1)
			// call SetSpecialEffectScale(bjLCE,0.6)
			// call SetSpecialEffectFacing(bjLCE,a*bj_RADTODEG+GetRandomInt(65,135))
			// call DestroyEffect(bjLCE)
			// set bjLCE=AddSpecialEffect("blood-4.mdl",GetUnitX(EBel),GetUnitY(EBel))
			// call SetSpecialEffectZ(bjLCE,GetUnitFlyHeight(EBel)+50)
			// call SetSpecialEffectScale(bjLCE,1.4)
			// call SetSpecialEffectFacing(bjLCE,a*bj_RADTODEG+GetRandomInt(65,135))
			// call DestroyEffect(bjLCE)
			// call GroupAddUnit(LoadGroupHandle(h,id,StringHash("GroupDummy")),EBel)
			// endif
			// call GroupRemoveUnit(g2,EBel)
			// endloop
			// call DestroyGroup(g2)
			if effect_period==0 then
				set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)),'dB04',newX,newY,a*bj_RADTODEG)
				call SetUnitAnimation(bjLCU,"birth")
				call SetUnitVertexColor(bjLCU,255,255,255,135-R2I((time-30)*0.85))
				call SetUnitScale(bjLCU,1.35-(time-30)*0.02,1.35-(time-30)*0.02,1)
				call SetUnitFlyHeight(bjLCU, 15, 0)
				call UnitApplyTimedLife(bjLCU,0,1.75)
				call SaveInteger(h,id,EffectPeriodHash,10)
			else
				call SaveInteger(h,id,EffectPeriodHash,effect_period-1)
			endif
		endif
		call SaveInteger(h,id,StringHash("Time"),time+1)
	else
		set newX=GetUnitX(LoadUnitHandle(h,id,DummyHash))
		set newY=GetUnitY(LoadUnitHandle(h,id,DummyHash))
		set bjLCE=AddSpecialEffect("blinkcaster.mdl",newX,newY)
		call SetSpecialEffectZ(bjLCE,60)
		call SetSpecialEffectFacing(bjLCE,90)
		call SetSpecialEffectScale(bjLCE,0.7)
		call DestroyEffect(bjLCE)
		set bjLCE=AddSpecialEffect("blinkcaster.mdl",newX,newY)
		call SetSpecialEffectZ(bjLCE,60)
		call SetSpecialEffectFacing(bjLCE,45)
		call SetSpecialEffectScale(bjLCE,1.2)
		call DestroyEffect(bjLCE)
		set bjLCE=AddSpecialEffect("BY_Wood_Eff_Ord_DanGe_Wav_Kuosan_1_4_1s.mdl",newX,newY)
		call SetSpecialEffectScale(bjLCE,0.3)
		call SetSpecialEffectAlpha(bjLCE,155)
		call DestroyEffect(bjLCE)
		call RemoveUnit(LoadUnitHandle(h,id,DummyHash))
		call FlushChildHashtable(h,id)
		call DestroyTimer(GetExpiredTimer())
	endif
    //set g2=null
    set EBel=null
endfunction
function BelfTClone_Cast takes unit newCaster,real newX,real newY,real newAngle returns nothing
	local integer id=0
	local real x=GetUnitX(newCaster)
	local real y=GetUnitY(newCaster)
	local real a=AtanPoint(newX+750*Cos(newAngle),newY+750*Sin(newAngle),newX,newY)
	set bjLCT=CreateTimer()
	set id=GetHandleId(bjLCT)
	set bjLCE=AddSpecialEffect("az_pa_b1.mdl",newX+750*Cos(a),newY+750*Sin(a))
	call DestroyEffect(bjLCE)
	set bjLCU=CreateUnit(GetOwningPlayer(newCaster),'cBel',newX+750*Cos(a),newY+750*Sin(a),(a-180*bj_DEGTORAD)*bj_RADTODEG)
	call SetUnitFlyHeight(bjLCU,0,0)
	call SetUnitScale(bjLCU,1.2,1.2,1.2)
	call SetUnitAnimationByIndex(bjLCU,4)
	call SetUnitVertexColor(bjLCU,GetRandomInt(50,150),GetRandomInt(50,150),GetRandomInt(100,250),200)
	call SaveUnitHandle(h,id,DummyHash,bjLCU)
	call SaveUnitHandle(h,id,CasterHash,newCaster)
	call SaveReal(h,id,AngleHash,a-180*bj_DEGTORAD)
	call SaveInteger(h,id,StringHash("Time"),0)
	call SaveInteger(h,id,EffectPeriodHash,10)
	//call SaveGroupHandle(h,id,StringHash("GroupDummy"),CreateGroup())
	call TimerStart(bjLCT,0.02,true,function BelfTClone_Periodic)
	set bjLCT=null
endfunction

function BelfT_KnifeWaltz_Periodic takes nothing returns nothing
	local integer id=GetHandleId(GetExpiredTimer())
    local effect newEffect = LoadEffectHandle(h,id,StringHash("Knife"))
    local unit   caster    = LoadUnitHandle(h,id,CasterHash)
	call SaveInteger(h,id,StringHash("Time"),LoadInteger(h,id,StringHash("Time"))+1)
	if LoadInteger(h,id,StringHash("Time"))<115 then
		if LoadInteger(h,id,StringHash("Time"))<95 then
			call SetSpecialEffectZ(newEffect,GetSpecialEffectZ(newEffect)+9)
			call SetSpecialEffectFacing(newEffect,AtanPoint(GetUnitX(caster),GetUnitY(caster),GetSpecialEffectX(newEffect),GetSpecialEffectY(newEffect))*bj_RADTODEG)
		else
			call SetSpecialEffectFacing(newEffect,AtanPoint(GetUnitX(caster),GetUnitY(caster),GetSpecialEffectX(newEffect),GetSpecialEffectY(newEffect))*bj_RADTODEG+10)
		endif
		call SetSpecialEffectX(newEffect,GetUnitX(caster)+200*Cos(AtanPoint(GetUnitX(caster),GetUnitY(caster),GetSpecialEffectX(newEffect),GetSpecialEffectY(newEffect))+5.5*bj_DEGTORAD))
		call SetSpecialEffectY(newEffect,GetUnitY(caster)+200*Sin(AtanPoint(GetUnitX(caster),GetUnitY(caster),GetSpecialEffectX(newEffect),GetSpecialEffectY(newEffect))+5.5*bj_DEGTORAD))
	elseif LoadInteger(h,id,StringHash("Time"))<400 then
		call SetSpecialEffectZ(newEffect,GetSpecialEffectZ(newEffect)-6)
		call SetSpecialEffectX(newEffect,GetSpecialEffectX(newEffect)+30*Cos(AtanPoint(GetSpecialEffectX(newEffect),GetSpecialEffectY(newEffect),LoadReal(h,id,StringHash("TargetX")),LoadReal(h,id,StringHash("TargetY")))-70*bj_DEGTORAD))
		call SetSpecialEffectY(newEffect,GetSpecialEffectY(newEffect)+30*Sin(AtanPoint(GetSpecialEffectX(newEffect),GetSpecialEffectY(newEffect),LoadReal(h,id,StringHash("TargetX")),LoadReal(h,id,StringHash("TargetY")))-70*bj_DEGTORAD))
		call SetSpecialEffectFacing(newEffect,AtanPoint(GetSpecialEffectX(newEffect),GetSpecialEffectY(newEffect),LoadReal(h,id,StringHash("TargetX")),LoadReal(h,id,StringHash("TargetY")))*bj_RADTODEG-75)
	else
		call DestroyEffect(newEffect)
		call FlushChildHashtable(h,id)
		call DestroyTimer(GetExpiredTimer())
	endif
    set newEffect = null
    set caster = null
endfunction

function BelfT_KnifeWaltz takes unit newCaster,real newX,real newY,timer newT returns nothing
        local integer id=GetHandleId(newT)
        local real x=GetUnitX(newCaster)
        local real y=GetUnitY(newCaster)
        local real a=AtanPoint(x,y,newX,newY)
        set bjLCE=AddSpecialEffect("knife.mdl",x,y)
        call SetSpecialEffectScale(bjLCE,0.7)
        call SetSpecialEffectFacing(bjLCE,a*bj_RADTODEG)
        call SetSpecialEffectVertexColour(bjLCE,255,50,50,255)
        call SaveEffectHandle(h,id,StringHash("Knife"),bjLCE)
        call SaveUnitHandle(h,id,CasterHash,newCaster)
        call SaveReal(h,id,StringHash("TargetX"),newX)
        call SaveReal(h,id,StringHash("TargetY"),newY)
        call TimerStart(newT,0.01,true,function BelfT_KnifeWaltz_Periodic)
endfunction

function BelfT_HeroAct_Periodic takes nothing returns nothing
	local integer id=GetHandleId(GetExpiredTimer())
    local unit caster=LoadUnitHandle(h,id,CasterHash)
	local real x=GetUnitX(caster)
	local real y=GetUnitY(caster)
	local real tX=LoadReal(h,id,StringHash("TargetX"))
	local real tY=LoadReal(h,id,StringHash("TargetY"))
	local integer time=LoadInteger(h,id,StringHash("Time"))
	local real a=AtanPoint(x,y,tX,tY)
	local real height=GetUnitFlyHeight(caster)
	local real dist=LoadReal(h,id,StringHash("Dist"))
	if time<500 then
		if time<200 then
			call SetUnitFlyHeight(caster,height+3.3,0)
			if 750-dist>0 then
				call SetUnitX(caster,x-(850-dist)/200*Cos(a))
				call SetUnitY(caster,y-(850-dist)/200*Sin(a))
			endif
		elseif time==200 then
			call SetUnitAnimationByIndex(caster,11)
			call SetUnitTimeScale(caster,0.5)
			set bjLCE=AddSpecialEffect("cf2.mdl",x,y)
			call SetSpecialEffectZ(bjLCE,height)
			call SetSpecialEffectFacing(bjLCE,a*bj_RADTODEG-180)
			call SetSpecialEffectRoll(bjLCE,-45)
			call DestroyEffect(bjLCE)
		elseif time==270 then
			call SetUnitFlyHeight(caster,0,800)
		else
			call SetUnitX(caster,x-1.8*Cos(a))
			call SetUnitY(caster,y-1.8*Sin(a))
		endif
		call SaveInteger(h,id,StringHash("Time"),time+1)
	else
		call SetUnitTimeScale(caster,1)
		call PauseUnit(caster,false)
		call SetUnitInvulnerable(caster,false)
		call FlushChildHashtable(h,id)
		call DestroyTimer(GetExpiredTimer())
	endif
    set caster = null
endfunction

function BelfT_HeroAct takes unit newCaster,real newX,real newY returns nothing
        local integer id=0
        local real x=GetUnitX(newCaster)
        local real y=GetUnitY(newCaster)
        set bjLCT=CreateTimer()
        set id=GetHandleId(bjLCT)
        set bjLCE=AddSpecialEffect("sand.mdl",x,y)
        call SetSpecialEffectScale(bjLCE,2)
        call DestroyEffect(bjLCE)
        call UnitAddAbility(newCaster,'Arav')
        call UnitRemoveAbility(newCaster,'Arav')
        call PauseUnit(newCaster,true)
        call SetUnitInvulnerable(newCaster,true)
        call SetUnitAnimationByIndex(newCaster,10)
        call SaveUnitHandle(h,id,CasterHash,newCaster)
        call SaveReal(h,id,StringHash("TargetX"),newX)
        call SaveReal(h,id,StringHash("TargetY"),newY)
        call SaveReal(h,id,StringHash("Dist"),SquareRoot((newX-x)*(newX-x)+(newY-y)*(newY-y)))
        call TimerStart(bjLCT,0.005,true,function BelfT_HeroAct_Periodic)
        set bjLCT=null
endfunction


function BelfT_EnemyAttraction2 takes nothing returns nothing
    local timer newTimer = GetExpiredTimer()
    local integer id = GetHandleId(newTimer)
    local unit target = LoadUnitHandle(h, id, 1)
    local real duration = LoadReal(h, id, 3)-0.02
    local real point_x = LoadReal(h, id, 4)
    local real point_y = LoadReal(h, id, 5)
    local real angle = AtanPoint(GetUnitX(target), GetUnitY(target), point_x, point_y)
    local real distance = SquareRootPoint(GetUnitX(target), GetUnitY(target), point_x, point_y)
    call SaveReal(h, id, 3, duration)
    if duration>=0.0 then
        if distance<=750 then
            if distance>100 then
                call SetUnitXY(target, GetUnitX(target)+15*Cos(angle), GetUnitY(target)+15*Sin(angle))
            endif
            if LoadInteger(h, id, 10)<=0 then
                call SaveInteger(h, id, 10, 5)
                call myCustomDamage(LoadUnitHandle(h, id, 0), target, LoadReal(h, id, 2)*0.1,false,false,null,null,null)
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", target, "chest"))
                set bjLCE=AddSpecialEffect("akiha_claw_red.mdl",GetUnitX(target),GetUnitY(target))
                call SetSpecialEffectZ(bjLCE,GetUnitFlyHeight(target)+50)
                call SetSpecialEffectTimeScale(bjLCE,1.1)
                call SetSpecialEffectScale(bjLCE,0.6)
                call SetSpecialEffectFacing(bjLCE,angle*bj_RADTODEG+GetRandomInt(65,135))
                call DestroyEffect(bjLCE)
                set bjLCE=AddSpecialEffect("blood-4.mdl",GetUnitX(target),GetUnitY(target))
                call SetSpecialEffectZ(bjLCE,GetUnitFlyHeight(target)+50)
                call SetSpecialEffectScale(bjLCE,1.4)
                call SetSpecialEffectFacing(bjLCE,angle*bj_RADTODEG+GetRandomInt(65,135))
                call DestroyEffect(bjLCE)
            else
                call SaveInteger(h, id, 10, LoadInteger(h,id,10)-1)
            endif
        endif
    else
        call FlushChildHashtable(h, id)
        call DestroyTimer(newTimer)
    endif
    set newTimer = null
    set target = null
endfunction

function BelfT_EnemyAttraction takes unit caster, unit target, real point_x, real point_y, real duration returns nothing
    local timer newTimer = CreateTimer()
    local integer id = GetHandleId(newTimer)
    local real    damage = GetHeroInt(caster, true)*10
    local real    max_duration = 1.0

    call SaveUnitHandle(h, id, 0, caster)
    call SaveUnitHandle(h, id, 1, target)
    call SaveReal(h, id, 2, damage)
    call SaveReal(h, id, 3, duration)
    call SaveReal(h, id, 4, point_x)
    call SaveReal(h, id, 5, point_y)
    call TimerStart(newTimer, 0.02, true, function BelfT_EnemyAttraction2)
    set newTimer = null
endfunction

function BelfT_Periodic takes nothing returns nothing
	local integer id=GetHandleId(GetExpiredTimer())
	local integer time=LoadInteger(h,id,StringHash("Time"))
    local unit caster    = LoadUnitHandle(h,id,CasterHash)
	local real dmg_spell = (GetHeroInt(caster,true)*10)*0.05
    local real point_x = LoadReal(h,id,StringHash("TargetX"))
    local real point_y = LoadReal(h,id,StringHash("TargetY"))
	if time<=25 then
		if time<15 and LoadInteger(h,id,StringHash("Period"))==0 then
			call BelfT_KnifeWaltz(caster,point_x,point_y,CreateTimer())
			call SaveInteger(h,id,StringHash("Period"),3)
		else
			call SaveInteger(h,id,StringHash("Period"),LoadInteger(h,id,StringHash("Period"))-1)
		endif
		if time==15 then
			set bjLCE=AddSpecialEffect("AZ_D0801.mdl",point_x,point_y)
			call SetSpecialEffectScale(bjLCE,6)
			call SaveEffectHandle(h,id,Effect1Hash,bjLCE)
			set bjLCE=AddSpecialEffect("AZ_D0801.mdl",point_x,point_y)
			call SetSpecialEffectScale(bjLCE,7)
			call SaveEffectHandle(h,id,Effect2Hash,bjLCE)
			set bjLCE=AddSpecialEffect("AZ_DD029.mdl",point_x,point_y)
			call SetSpecialEffectScale(bjLCE,2)
			call SaveEffectHandle(h,id,StringHash("Effect3"),bjLCE)
			set bjLCE=AddSpecialEffect("AZ_DD029.mdl",point_x,point_y)
			call SetSpecialEffectScale(bjLCE,3)
			call SaveEffectHandle(h,id,StringHash("Effect4"),bjLCE)
			set bjLCE=AddSpecialEffect("AZ_DD029.mdl",point_x,point_y)
			call SetSpecialEffectScale(bjLCE,4)
			call SaveEffectHandle(h,id,StringHash("Effect5"),bjLCE)
		elseif time>=15 then
			set bjLCG=LoadGroupHandle(h,id,GroupHash)
			call GroupEnumUnitsInRange(bjLCG,point_x,point_y,750,Base)
			loop
			set bjLCU=FirstOfGroup(bjLCG)
			exitwhen bjLCU==null
			if Condition_Base(GetOwningPlayer(caster),bjLCU)==true and IsUnitInGroup(bjLCU, LoadGroupHandle(h,id,StringHash("Group2")))==false then
				// call SetUnitXY_1(bjLCU,GetUnitX(bjLCU)-22*Cos(Atan2(GetUnitY(bjLCU)-point_y,GetUnitX(bjLCU)-point_x)),GetUnitY(bjLCU)-22*Sin(Atan2(GetUnitY(bjLCU)-point_y,GetUnitX(bjLCU)-point_x)),true)
				// call myCustomDamage(caster,bjLCU, dmg_spell,false,false,null,null,null)
				// call UnitAddBelfegorMark(caster,bjLCU)
                call BelfT_EnemyAttraction(caster, bjLCU, point_x, point_y, 1.0-(1.5-time*0.1))
                call GroupAddUnit(LoadGroupHandle(h,id,StringHash("Group2")), bjLCU)
			endif
			call GroupRemoveUnit(bjLCG,bjLCU)
			endloop
			call GroupClear(bjLCG)
		endif
			call SaveInteger(h,id,StringHash("Time"),time+1)
	else
		set bjLCE=LoadEffectHandle(h,id,Effect1Hash)
		call DestroyEffect(bjLCE)
		set bjLCE=LoadEffectHandle(h,id,Effect2Hash)
		call DestroyEffect(bjLCE)
		set bjLCE=LoadEffectHandle(h,id,StringHash("Effect3"))
		call DestroyEffect(bjLCE)
		set bjLCE=LoadEffectHandle(h,id,StringHash("Effect4"))
		call DestroyEffect(bjLCE)
		set bjLCE=LoadEffectHandle(h,id,StringHash("Effect5"))
		call DestroyEffect(bjLCE)
		set bjLCE=AddSpecialEffect("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl",point_x,point_y)
		call SetSpecialEffectScale(bjLCE,2.5)
		call DestroyEffect(bjLCE)
		set bjLCE=AddSpecialEffect("az_cocoguanyu_t2_death.mdl",point_x,point_y)
		call SetSpecialEffectScale(bjLCE,2.5)
		call DestroyEffect(bjLCE)
		set bjLCE=AddSpecialEffect("by_wood_effect_yuzhiboyou_fire_babangouyu_2_di_.mdl",point_x,point_y)
		call SetSpecialEffectScale(bjLCE,1.5)
		call DestroyEffect(bjLCE)
		set bjLCE=AddSpecialEffect("by_wood_effect_yuzhiboyou_fire_babangouyu_1_kong.mdl",point_x,point_y)
		call SetSpecialEffectScale(bjLCE,1.2)
		call SetSpecialEffectZ(bjLCE,75)
		call DestroyEffect(bjLCE)
		set bjLCE=AddSpecialEffect("firetrap.mdl",point_x,point_y)
		call SetSpecialEffectScale(bjLCE,4)
		call SetSpecialEffectZ(bjLCE,75)
		call DestroyEffect(bjLCE)
		set bjLCG=LoadGroupHandle(h,id,GroupHash)
		call GroupEnumUnitsInRange(bjLCG,point_x,point_y,350,Base)
		loop
		set bjLCU=FirstOfGroup(bjLCG)
		exitwhen bjLCU==null
			if Condition_Base(GetOwningPlayer(caster),bjLCU)==true then
				call BelfegorStormDamage(caster,bjLCU,(GetHeroInt(caster,true)*3))
				//call UnitAddBelfegorMark(caster,bjLCU)
			endif
		call GroupRemoveUnit(bjLCG,bjLCU)
		endloop
		call GroupClear(bjLCG)
		call DestroyGroup(bjLCG)
		call DestroyGroup(LoadGroupHandle(h,id,StringHash("Group2")))
		call FlushChildHashtable(h,id)
		call DestroyTimer(GetExpiredTimer())
	endif
endfunction

function BelfT_Cast takes unit newCaster,real newX,real newY returns nothing
	local integer id=0
	local real a=0
	set bjLCT=CreateTimer()
	set id=GetHandleId(bjLCT)
	set bjLCE=AddSpecialEffect("[spell]hakkestart.mdl",newX,newY)
	call SetSpecialEffectScale(bjLCE,2)
	call SetSpecialEffectAlpha(bjLCE,150)
	call RemoveEffect(bjLCE,3.5,true,CreateTimer())
	call SaveUnitHandle(h,id,CasterHash,newCaster)
	call SaveReal(h,id,StringHash("TargetX"),newX)
	call SaveReal(h,id,StringHash("TargetY"),newY)
	call SaveGroupHandle(h,id,GroupHash,CreateGroup())
	call SaveGroupHandle(h,id,StringHash("Group2"),CreateGroup())
	call TimerStart(bjLCT,0.10,true,function BelfT_Periodic)
	call BelfT_HeroAct(newCaster,newX,newY)
	loop
	exitwhen a>=360
		call BelfTClone_Cast(newCaster,newX,newY,a*bj_DEGTORAD)
		set a=a+360/10
	endloop
	set soundplay=CreateSound("Sound\\war3mapImported\\Belf_T1.mp3",false,false,true,12700,12700,"")
	call StartSound(soundplay)
	call KillSoundWhenDone(soundplay)
	set soundplay=CreateSound("Sound\\war3mapImported\\Belf_T2.mp3",false,false,true,12700,12700,"")
	call StartSound(soundplay)
	call KillSoundWhenDone(soundplay)
	set bjLCT=null
endfunction
function Trig_BelfegorInt_Cond takes nothing returns boolean
return udg_B==true
endfunction
function Trig_BelfegorInt_Actions takes nothing returns nothing
local real Angle=0
local real x=GetUnitX(GetSpellAbilityUnit())
local real y=GetUnitY(GetSpellAbilityUnit())
local integer id=GetHandleId(GetSpellAbilityUnit())
if GetSpellAbilityId()=='BelF' then
if GetSpellTargetUnit()==null then
call BelfF_AOEdamage(GetSpellAbilityUnit(),GetSpellTargetX(),GetSpellTargetY())
elseif Condition_Base(GetOwningPlayer(GetSpellAbilityUnit()),GetSpellTargetUnit())then
call BelfF_AOEdamage(GetSpellAbilityUnit(),GetUnitX(GetSpellTargetUnit()),GetUnitY(GetSpellTargetUnit()))
else
call BelfF_Shield(GetSpellAbilityUnit(),GetSpellTargetUnit())
endif
endif
if GetSpellAbilityId()=='BelQ' then
set Angle=AtanPoint(x,y,GetSpellTargetX(),GetSpellTargetY())
call BelfQ_Cast(GetSpellAbilityUnit(),Angle)
endif
if GetSpellAbilityId()=='BelW' then
set Angle=AtanPoint(x,y,GetSpellTargetX(),GetSpellTargetY())
call BelfW_Cast(GetSpellAbilityUnit(),Angle)
endif
if GetSpellAbilityId()=='BelE' then
call BelfE_Cast(GetSpellAbilityUnit(),GetSpellTargetX(),GetSpellTargetY())
endif
if GetSpellAbilityId()=='BelR' then
call BelfR_Cast(GetSpellAbilityUnit())
endif
if GetSpellAbilityId()=='BelT' then
call BelfT_Cast(GetSpellAbilityUnit(),GetSpellTargetX(),GetSpellTargetY())
endif
endfunction
function InitTrig_BelfegorInt takes nothing returns nothing
local trigger trig=CreateTrigger()
local integer index=0
loop
call TriggerRegisterPlayerUnitEvent(trig,Player(index),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set index=index+1
exitwhen index==bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddCondition(trig,Condition(function Trig_BelfegorInt_Cond))
call TriggerAddAction(trig,function Trig_BelfegorInt_Actions)
set trig=null
endfunction

function AlbedoD_Point takes nothing returns nothing
    local integer id= GetHandleId(GetTriggeringTrigger())
    local integer id_caster= GetHandleId(LoadUnitHandle(h, id, CasterHash))
    local real angle= 0.0
    if GetOrderTargetUnit() == null then
        call SaveReal(h, id_caster, StringHash("AlbedoD_X"), GetOrderPointX())
        call SaveReal(h, id_caster, StringHash("AlbedoD_Y"), GetOrderPointY())
    else
        set angle=AP(GetUnitX(LoadUnitHandle(h, id, CasterHash)) , GetUnitY(LoadUnitHandle(h, id, CasterHash)) , GetUnitX(GetOrderTargetUnit()) , GetUnitY(GetOrderTargetUnit()))
        call SaveReal(h, id_caster, StringHash("AlbedoD_X"), GetUnitX(GetOrderTargetUnit()) - 50 * Cos(angle))
        call SaveReal(h, id_caster, StringHash("AlbedoD_Y"), GetUnitY(GetOrderTargetUnit()) - 50 * Sin(angle))
    endif
    call FlushChildHashtable(h, id)
    call TriggerClearActions(GetTriggeringTrigger())
    call DestroyTrigger(GetTriggeringTrigger())
endfunction

function AlbedoD_Periodic takes nothing returns nothing
    local integer id= GetHandleId(GetExpiredTimer())
    local integer id_caster= GetHandleId(LoadUnitHandle(h, id, CasterHash))
    local real angle= 0.0
    local real time= LoadReal(h, id, TIME_HASH)
    if time <= 3.0 then
        if LoadReal(h, id_caster, StringHash("AlbedoD_X")) != 0 then
            call SaveReal(h, id, TIME_HASH, 4)
        else
            if IsUnitPaused(LoadUnitHandle(h, id, CasterHash)) == false then
                call SaveReal(h, id, TIME_HASH, time + 0.01)
            endif
        endif
    else
        if LoadReal(h, id_caster, StringHash("AlbedoD_X")) != 0 then
            set bjLCE=AddSpecialEffect("canying.mdl", GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)))
            call SetSpecialEffectScale(bjLCE , 1.1)
            call SetSpecialEffectFacing(bjLCE , GetRandomInt(0, 360))
            call DestroyEffect(bjLCE)
            set bjLCE=AddSpecialEffect("1feng_932.mdl", GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)))
            call SetSpecialEffectScale(bjLCE , 0.8)
            call SetSpecialEffectFacing(bjLCE , GetRandomInt(0, 360))
            call DestroyEffect(bjLCE)
            set bjLCE=AddSpecialEffect("az_magina[2]_b.mdx", GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)))
            call SetSpecialEffectScale(bjLCE , 1.6)
            call SetSpecialEffectFacing(bjLCE , GetRandomInt(0, 360))
            call DestroyEffect(bjLCE)
            set bjLCE=AddSpecialEffect("blinkcasterLulu.mdl", GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)))
            call SetSpecialEffectScale(bjLCE , 1.3)
            call SetSpecialEffectFacing(bjLCE , GetRandomInt(0, 360))
            call DestroyEffect(bjLCE)
            set bjLCE=AddSpecialEffect("WindCirclefaster.mdl", GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)))
            call SetSpecialEffectScale(bjLCE , 1.1)
            call SetSpecialEffectFacing(bjLCE , GetRandomInt(0, 360))
            call DestroyEffect(bjLCE)
            set angle=AP(GetUnitX(LoadUnitHandle(h, id, CasterHash)) , GetUnitY(LoadUnitHandle(h, id, CasterHash)) , LoadReal(h, id_caster, StringHash("AlbedoD_X")) , LoadReal(h, id_caster, StringHash("AlbedoD_Y")))
            if SquareRootPoint(GetUnitX(LoadUnitHandle(h, id, CasterHash)) , GetUnitY(LoadUnitHandle(h, id, CasterHash)) , LoadReal(h, id_caster, StringHash("AlbedoD_X")) , LoadReal(h, id_caster, StringHash("AlbedoD_Y"))) > 700 then
                call SaveReal(h, id_caster, StringHash("AlbedoD_X"), GetUnitX(LoadUnitHandle(h, id, CasterHash)) + 700 * Cos(angle))
                call SaveReal(h, id_caster, StringHash("AlbedoD_Y"), GetUnitY(LoadUnitHandle(h, id, CasterHash)) + 700 * Sin(angle))
            endif
            loop
            exitwhen ( IsTerrainPathable(LoadReal(h, id_caster, StringHash("AlbedoD_X")), LoadReal(h, id_caster, StringHash("AlbedoD_Y")), PATHING_TYPE_FLYABILITY) == false )
                call SaveReal(h, id_caster, StringHash("AlbedoD_X"), LoadReal(h, id_caster, StringHash("AlbedoD_X")) - 10 * Cos(angle))
                call SaveReal(h, id_caster, StringHash("AlbedoD_Y"), LoadReal(h, id_caster, StringHash("AlbedoD_Y")) - 10 * Sin(angle))
            endloop
            call SetUnitX(LoadUnitHandle(h, id, CasterHash), LoadReal(h, id_caster, StringHash("AlbedoD_X")) - 10 * Cos(angle))
            call SetUnitY(LoadUnitHandle(h, id, CasterHash), LoadReal(h, id_caster, StringHash("AlbedoD_Y")) - 10 * Sin(angle))
            call SetUnitFacingInstant(LoadUnitHandle(h, id, CasterHash) , angle * bj_RADTODEG)
            set bjLCE=AddSpecialEffect("canying.mdl", GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)))
            call SetSpecialEffectScale(bjLCE , 1.1)
            call SetSpecialEffectFacing(bjLCE , GetRandomInt(0, 360))
            call DestroyEffect(bjLCE)
            set bjLCE=AddSpecialEffect("1feng_932.mdl", GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)))
            call SetSpecialEffectScale(bjLCE , 0.8)
            call SetSpecialEffectFacing(bjLCE , GetRandomInt(0, 360))
            call DestroyEffect(bjLCE)
            set bjLCE=AddSpecialEffect("az_magina[2]_b.mdx", GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)))
            call SetSpecialEffectScale(bjLCE , 1.6)
            call SetSpecialEffectFacing(bjLCE , GetRandomInt(0, 360))
            call DestroyEffect(bjLCE)
            set bjLCE=AddSpecialEffect("blinkcasterLulu.mdl", GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)))
            call SetSpecialEffectScale(bjLCE , 1.3)
            call SetSpecialEffectFacing(bjLCE , GetRandomInt(0, 360))
            call DestroyEffect(bjLCE)
            set bjLCE=AddSpecialEffect("WindCirclefaster.mdl", GetUnitX(LoadUnitHandle(h, id, CasterHash)), GetUnitY(LoadUnitHandle(h, id, CasterHash)))
            call SetSpecialEffectScale(bjLCE , 1.1)
            call SetSpecialEffectFacing(bjLCE , GetRandomInt(0, 360))
            call DestroyEffect(bjLCE)
            set soundplay=CreateSound("Sound\\Music\\mp3Music\\Soru2.mp3", false, false, true, 12700, 12700, "")
            call StartSound(soundplay)
            call KillSoundWhenDone(soundplay)
        endif
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
endfunction

function AlbedoD_Cast takes unit newCaster,real point_x,real point_y,timer newTimer returns nothing
    local integer id= GetHandleId(newTimer)
    local integer id_caster= GetHandleId(newCaster)
    local real caster_x= GetUnitX(newCaster)
    local real caster_y= GetUnitY(newCaster)
    local real angle= AP(caster_x , caster_y , point_x , point_y)
    local trigger newTrigger= CreateTrigger()
    call SaveReal(h, id_caster, StringHash("AlbedoD_X"), 0)
    call SaveReal(h, id_caster, StringHash("AlbedoD_Y"), 0)
    call SaveUnitHandle(h, GetHandleId(newTrigger), CasterHash, newCaster)
    call TriggerRegisterUnitEvent(newTrigger, newCaster, EVENT_UNIT_ISSUED_POINT_ORDER)
    call TriggerRegisterUnitEvent(newTrigger, newCaster, EVENT_UNIT_ISSUED_TARGET_ORDER)
    call TriggerAddAction(newTrigger, function AlbedoD_Point)
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call TimerStart(newTimer, 0.01, true, function AlbedoD_Periodic)
endfunction

function AlbedoChangeF takes unit newCaster,integer newMod returns nothing
local integer id_caster=GetHandleId(newCaster)
local integer get_mod=LoadInteger(HH,id_caster,StringHash("AlbedoF_Mod"))
call SaveInteger(HH,id_caster,StringHash("AlbedoF_Mod"),newMod)
if newMod==1 and(newMod!=get_mod or GetUnitAbilityLevel(newCaster,'AlbF')==1)then
call UnitAddAbility(newCaster,'AlbF')
else
if get_mod==1 and newMod!=get_mod then
call UnitRemoveAbility(newCaster,'AlbF')
endif
endif
endfunction
function AlbedoQ_AnimEnd takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
call SetUnitTimeScale(LoadUnitHandle(h,id,CasterHash),1)
call PauseUnit(LoadUnitHandle(h,id,CasterHash),false)
call SetUnitInvulnerable(LoadUnitHandle(h,id,CasterHash),false)
call FlushChildHashtable(h,id)
call DestroyTimer(GetExpiredTimer())
endfunction
function AlbedoQ_Animation takes unit newCaster,timer newTimer returns nothing
local integer id=GetHandleId(newTimer)
call SaveUnitHandle(h,id,CasterHash,newCaster)
call SetUnitAnimationByIndex(newCaster,12)
call SetUnitTimeScale(newCaster,1.9)
call PauseUnit(newCaster,true)
call SetUnitInvulnerable(newCaster,true)
call TimerStart(newTimer,0.5,false,function AlbedoQ_AnimEnd)
endfunction
function AlbedoQ_Act1 takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local real time=LoadReal(h,id,TIME_HASH)+0.01
local real angle=LoadReal(h,id,AngleHash)
local real xT=GetUnitX(LoadUnitHandle(h,id,CasterHash))+250*Cos(angle)
local real yT=GetUnitY(LoadUnitHandle(h,id,CasterHash))+250*Sin(angle)
local real add_dmg=GetHeroStr(LoadUnitHandle(h,id,CasterHash),true)*1.5*0.01
local real full_dmg=LoadReal(h,id,StringHash("Damage"))+add_dmg
local real stun_dur=LoadReal(h,id,StringHash("StunDur"))+1.25*0.01
local integer eff_period=LoadInteger(h,id,StringHash("EffPeriod"))
call SaveReal(h,id,StringHash("StunDur"),stun_dur)
if time<=2.0 and GetUnitCurrentOrder(LoadUnitHandle(h,id,CasterHash))==OrderId("channel")then
call SaveReal(h,id,TIME_HASH,time)
call SaveReal(h,id,StringHash("Damage"),full_dmg)
set bjLCE=LoadEffectHandle(h,id,Effect1Hash)
call SetSpecialEffectX(bjLCE,GetUnitX(LoadUnitHandle(h,id,CasterHash)))
call SetSpecialEffectY(bjLCE,GetUnitY(LoadUnitHandle(h,id,CasterHash)))
call SetSpecialEffectScale(bjLCE,time*0.7)
if time==0.60 then
call SetUnitTimeScale(LoadUnitHandle(h,id,CasterHash),0.015)
elseif time==1.75 then
call SetUnitTimeScale(LoadUnitHandle(h,id,CasterHash),0.5)
endif
if eff_period==0 then
set bjLCE=AddSpecialEffect("kaizokusfxbyvalk4.mdl",GetUnitX(LoadUnitHandle(h,id,CasterHash)),GetUnitY(LoadUnitHandle(h,id,CasterHash)))
call SetSpecialEffectFacing(bjLCE,GetRandomInt(0,360))
call SetSpecialEffectScale(bjLCE,0.3+time*0.12)
call SetSpecialEffectVertexColour(bjLCE,220,170,255,200)
call DestroyEffect(bjLCE)
call SaveInteger(h,id,StringHash("EffPeriod"),20-R2I(time*6))
else
call SaveInteger(h,id,StringHash("EffPeriod"),eff_period-1)
endif
else
call AlbedoQ_Animation(LoadUnitHandle(h,id,CasterHash),CreateTimer())
call ShakeCamera(0.5,time*10)
set soundplay=CreateSound("Sound\\war3mapImported\\AlbedoQ2.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)),'dAlb',xT,yT,0)
call MyRemoveUnit(bjLCU,0.1)
set bjLCE=AddSpecialEffect("az_hitheavy.mdl",xT,yT)
call SetSpecialEffectZ(bjLCE,25)
call SetSpecialEffectPitch(bjLCE,90)
call SetSpecialEffectScale(bjLCE,3)
call DestroyEffect(bjLCE)
set bjLCE=AddSpecialEffect("az_slb.mdl",xT,yT)
call SetSpecialEffectZ(bjLCE,0)
call SetSpecialEffectScale(bjLCE,1.5)
call DestroyEffect(bjLCE)
set bjLCE=AddSpecialEffect("123 (136)1.mdl",xT,yT)
call SetSpecialEffectScale(bjLCE,0.35+time/3)
call SetSpecialEffectZ(bjLCE,20)
call DestroyEffect(bjLCE)
if time>=0.8 then
set bjLCE=AddSpecialEffect("amx (138).mdl",xT,yT)
call SetSpecialEffectZ(bjLCE,0)
call SetSpecialEffectScale(bjLCE,1.5)
call DestroyEffect(bjLCE)
endif
if time>=1.8 then
set bjLCE=AddSpecialEffect("dls1.mdl",xT,yT)
call SetSpecialEffectZ(bjLCE,0)
call SetSpecialEffectScale(bjLCE,1.65)
call SetSpecialEffectFacing(bjLCE,angle*bj_RADTODEG)
call RemoveEffect(bjLCE,0.8,true,CreateTimer())
endif
set bjLCG=CreateGroup()
call GroupEnumUnitsInRange(bjLCG,xT,yT,350+time*60,Base)
loop
set bjLCU=FirstOfGroup(bjLCG)
exitwhen bjLCU==null
if Condition_Base(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)),bjLCU)==true then
call myCustomDamage(LoadUnitHandle(h,id,CasterHash),bjLCU,full_dmg,false,false,null,null,null)
call SetControlToUnit(LoadUnitHandle(h,id,CasterHash),bjLCU,stun_dur,"stun")
set bjLCE=AddSpecialEffect("blood-boom.mdl",GetUnitX(bjLCU),GetUnitY(bjLCU))
call SetSpecialEffectZ(bjLCE,GetUnitFlyHeight(bjLCU))
call SetSpecialEffectScale(bjLCE,1+time*0.5)
call DestroyEffect(bjLCE)
set bjLCE=AddSpecialEffect("blood-4.mdl",GetUnitX(bjLCU),GetUnitY(bjLCU))
call SetSpecialEffectZ(bjLCE,GetUnitFlyHeight(bjLCU))
call SetSpecialEffectScale(bjLCE,1+time*0.5)
call DestroyEffect(bjLCE)
set bjLCE=AddSpecialEffect("wslight2.mdl",GetUnitX(bjLCU),GetUnitY(bjLCU))
call SetSpecialEffectZ(bjLCE,GetUnitFlyHeight(bjLCU))
call SetSpecialEffectScale(bjLCE,1+time*0.5)
call DestroyEffect(bjLCE)
endif
call GroupRemoveUnit(bjLCG,bjLCU)
endloop
call DestroyEffect(LoadEffectHandle(h,id,Effect1Hash))
call DestroyGroup(bjLCG)
call FlushChildHashtable(h,id)
call DestroyTimer(GetExpiredTimer())
endif
endfunction
function AlbedoQ_Cast takes unit newCaster,real newX,real newY,real newA,timer newTimer returns nothing
local integer id=GetHandleId(newTimer)
local real spell_dmg=GetHeroStr(newCaster,true)*(GetUnitAbilityLevel(newCaster,'AlbQ')+2)
local real stun_dur=0.5
set soundplay=CreateSound("Sound\\war3mapImported\\AlbedoQ1.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
set newA=AtanPoint(GetUnitX(newCaster),GetUnitY(newCaster),newX,newY)
call SetUnitAnimationByIndex(newCaster,12)
call SetUnitTimeScale(newCaster,0.8)
set bjLCE=AddSpecialEffect("1028.mdl",GetUnitX(newCaster),GetUnitY(newCaster))
call SetSpecialEffectPitch(bjLCE,90)
call SetSpecialEffectScale(bjLCE,0.4)
call SetSpecialEffectAlpha(bjLCE,200)
call SaveEffectHandle(h,id,Effect1Hash,bjLCE)
call SaveUnitHandle(h,id,CasterHash,newCaster)
call SaveReal(h,id,AngleHash,newA)
call SaveReal(h,id,TIME_HASH,0)
call SaveReal(h,id,StringHash("Damage"),spell_dmg)
call SaveReal(h,id,StringHash("StunDur"),stun_dur)
call TimerStart(newTimer,0.01,true,function AlbedoQ_Act1)
endfunction
function AlbedoW_LastHit_periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local real angle=LoadReal(h,id,AngleHash)
    local real dist=LoadReal(h,id,StringHash("Dist"))
    local real speed=10
    local real target_x=GetUnitX(LoadUnitHandle(h,id,TargetHash))
    local real target_y=GetUnitY(LoadUnitHandle(h,id,TargetHash))
    local real target_z=GetUnitFlyHeight(LoadUnitHandle(h,id,TargetHash))
    local boolean eff_bool=LoadBoolean(h,id,StringHash("EffectBool"))
    if dist>0 then
        call SetUnitX(LoadUnitHandle(h,id,TargetHash),target_x+speed*Cos(angle))
        call SetUnitY(LoadUnitHandle(h,id,TargetHash),target_y+speed*Sin(angle))
        if target_z>20 then
            call SetUnitFlyHeight(LoadUnitHandle(h,id,TargetHash),target_z-LoadReal(h,id,StringHash("Fall")),2000)
        elseif eff_bool==false then
            call ShakeCamera(0.5,20)
            call SetUnitFlyHeight(LoadUnitHandle(h,id,TargetHash),0,0)
            call SaveBoolean(h,id,StringHash("EffectBool"),true)
            set bjLCE=AddSpecialEffect("newdirtex.mdl",target_x,target_y)
            call SetSpecialEffectScale(bjLCE,2)
            call DestroyEffect(bjLCE)
            set bjLCE=AddSpecialEffect("blood-boom.mdl",target_x,target_y)
            call SetSpecialEffectScale(bjLCE,2)
            call DestroyEffect(bjLCE)
            set bjLCE=AddSpecialEffect("warstompcaster1234.mdl",target_x,target_y)
            call SetSpecialEffectScale(bjLCE,2)
            call SetSpecialEffectTimeScale(bjLCE,0.7)
            call DestroyEffect(bjLCE)
        endif
        call SaveReal(h,id,StringHash("Dist"),dist-speed)
    else
        if eff_bool==false then
            call ShakeCamera(0.5,20)
            call SetUnitFlyHeight(LoadUnitHandle(h,id,TargetHash),0,0)
            call SaveBoolean(h,id,StringHash("EffectBool"),true)
            set bjLCE=AddSpecialEffect("newdirtex.mdl",target_x,target_y)
            call SetSpecialEffectScale(bjLCE,2)
            call DestroyEffect(bjLCE)
            set bjLCE=AddSpecialEffect("blood-boom.mdl",target_x,target_y)
            call SetSpecialEffectScale(bjLCE,2)
            call DestroyEffect(bjLCE)
            set bjLCE=AddSpecialEffect("warstompcaster1234.mdl",target_x,target_y)
            call SetSpecialEffectScale(bjLCE,2)
            call SetSpecialEffectTimeScale(bjLCE,0.7)
            call DestroyEffect(bjLCE)
        endif
        call FlushChildHashtable(h,id)
        call DestroyTimer(GetExpiredTimer())
    endif
endfunction
function AlbedoW_LastHit takes unit newCaster,unit newTarget,real newAngle,timer newTimer returns nothing
local integer id=GetHandleId(newTimer)
local real full_dmg=50+GetHeroStr(newCaster,true)*(2+GetUnitAbilityLevel(newCaster,'AlbW'))
set bjLCU=CreateUnit(GetOwningPlayer(newCaster),'dH07',GetUnitX(newCaster)+100*Cos(newAngle),GetUnitY(newCaster)+100*Sin(newAngle),newAngle*bj_RADTODEG)
call SetUnitTimeScale(bjLCU,0.6)
call SetUnitFlyHeight(bjLCU,GetUnitFlyHeight(newCaster),0)
call MyRemoveUnit(bjLCU,1.2)
set bjLCU=CreateUnit(GetOwningPlayer(newCaster),'dH08',GetUnitX(newCaster)+100*Cos(newAngle),GetUnitY(newCaster)+100*Sin(newAngle),newAngle*bj_RADTODEG)
call SetUnitTimeScale(bjLCU,0.6)
call SetUnitScale(bjLCU,2.5,2.5,2.5)
call SetUnitFlyHeight(bjLCU,GetUnitFlyHeight(newCaster),0)
call MyRemoveUnit(bjLCU,1.2)
set bjLCU=CreateUnit(GetOwningPlayer(newCaster),'dH70',GetUnitX(newCaster)+100*Cos(newAngle),GetUnitY(newCaster)+100*Sin(newAngle),newAngle*bj_RADTODEG-180)
call SetUnitScale(bjLCU,2.5,2.5,2.5)
call SetUnitFlyHeight(bjLCU,GetUnitFlyHeight(newCaster),0)
call MyRemoveUnit(bjLCU,1.2)
set bjLCE=AddSpecialEffect("hero_skeletonking_n2s_e_star.mdl",GetUnitX(newTarget),GetUnitY(newTarget))
call SetSpecialEffectFacing(bjLCE,newAngle*bj_RADTODEG)
call SetSpecialEffectScale(bjLCE,2)
call SetSpecialEffectZ(bjLCE,GetUnitFlyHeight(newTarget))
call DestroyEffect(bjLCE)
call PauseUnit(newTarget,false)
call SaveBoolean(HH,GetHandleId(newTarget),TARGET_ABILITY,false)
call SetUnitInvulnerable(newTarget,false)
call myCustomDamage(newCaster,newTarget,full_dmg,false,false,null,null,null)
call SetControlToUnit(newCaster,newTarget,2.6,"stun")
call SetUnitAnimation(newTarget,"death")
call SaveUnitHandle(h,id,TargetHash,newTarget)
call SaveReal(h,id,StringHash("Dist"),300)
call SaveReal(h,id,StringHash("Fall"),GetUnitFlyHeight(newTarget)/10)
call SaveReal(h,id,AngleHash,newAngle)
call SaveBoolean(h,id,StringHash("EffectBool"),false)
call TimerStart(newTimer,0.01,true,function AlbedoW_LastHit_periodic)
endfunction
function AlbedoW_hit_periodic takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local real angle=LoadReal(h,id,AngleHash)
local real dist=LoadReal(h,id,StringHash("Dist"))
local real speed=3
local real target_x=GetUnitX(LoadUnitHandle(h,id,TargetHash))
local real target_y=GetUnitY(LoadUnitHandle(h,id,TargetHash))
if dist>0 then
call SetUnitX(LoadUnitHandle(h,id,TargetHash),target_x+speed*Cos(angle))
call SetUnitY(LoadUnitHandle(h,id,TargetHash),target_y+speed*Sin(angle))
call SaveReal(h,id,StringHash("Dist"),dist-speed)
else
call FlushChildHashtable(h,id)
call DestroyTimer(GetExpiredTimer())
endif
endfunction
function AlbedoW_hit takes unit newTarget,real newAngle,timer newTimer returns nothing
local integer id=GetHandleId(newTimer)
set bjLCE=AddSpecialEffect("az_hitheavy.mdl",GetUnitX(newTarget),GetUnitY(newTarget))
call SetSpecialEffectZ(bjLCE,125)
call SetSpecialEffectScale(bjLCE,1.8)
call SetSpecialEffectFacing(bjLCE,newAngle*bj_RADTODEG)
call DestroyEffect(bjLCE)
set bjLCU=CreateUnit(GetOwningPlayer(newTarget),'dAl2',GetUnitX(newTarget),GetUnitY(newTarget),newAngle*bj_RADTODEG)
call SetUnitModel(bjLCU,"Ikarice2_FAW34.mdl")
call SetUnitFlyHeight(bjLCU,150,0)
call SetSpecialEffectScale(bjLCE,2.4)
call SetUnitVertexColor(bjLCU,255,255,255,150)
call MyRemoveUnit(bjLCU,0.8)
set bjLCE=AddSpecialEffect("nitu.mdl",GetUnitX(newTarget)+150*Cos(newAngle+30*bj_DEGTORAD),GetUnitY(newTarget)+150*Sin(newAngle+30*bj_DEGTORAD))
call SetSpecialEffectFacing(bjLCE,newAngle*bj_RADTODEG+220)
call SetSpecialEffectScale(bjLCE,2)
call SetSpecialEffectAlpha(bjLCE,100)
call DestroyEffect(bjLCE)
set bjLCE=AddSpecialEffect("nitu.mdl",GetUnitX(newTarget)+150*Cos(newAngle-30*bj_DEGTORAD),GetUnitY(newTarget)+150*Sin(newAngle-30*bj_DEGTORAD))
call SetSpecialEffectFacing(bjLCE,newAngle*bj_RADTODEG+140)
call SetSpecialEffectScale(bjLCE,2)
call SetSpecialEffectAlpha(bjLCE,100)
call DestroyEffect(bjLCE)
set bjLCE=AddSpecialEffect("nitu.mdl",GetUnitX(newTarget)+170*Cos(newAngle),GetUnitY(newTarget)+170*Sin(newAngle))
call SetSpecialEffectFacing(bjLCE,newAngle*bj_RADTODEG+180)
call SetSpecialEffectScale(bjLCE,2)
call SetSpecialEffectAlpha(bjLCE,100)
call DestroyEffect(bjLCE)
call ShakeCamera(0.1,3)
call PauseUnit(newTarget,true)
call SaveBoolean(HH,GetHandleId(newTarget),TARGET_ABILITY,true)
call SetUnitInvulnerable(newTarget, true)
call SaveUnitHandle(h,id,TargetHash,newTarget)
call SaveReal(h,id,StringHash("Dist"),180)
call SaveReal(h,id,AngleHash,newAngle)
call TimerStart(newTimer,0.01,true,function AlbedoW_hit_periodic)
endfunction
function AlbedoW_SecondAct_Periodic takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local real caster_x=GetUnitX(LoadUnitHandle(h,id,CasterHash))
local real caster_y=GetUnitY(LoadUnitHandle(h,id,CasterHash))
local real target_x=GetUnitX(LoadUnitHandle(h,id,TargetHash))
local real target_y=GetUnitY(LoadUnitHandle(h,id,TargetHash))
local real angle=AU(LoadUnitHandle(h,id,CasterHash),LoadUnitHandle(h,id,TargetHash))
local real sq_unit=SquareRootUnit(LoadUnitHandle(h,id,CasterHash),LoadUnitHandle(h,id,TargetHash))
local real time=LoadReal(h,id,TIME_HASH)
if time<3.6 then
call SaveReal(h,id,TIME_HASH,time+0.01)
set sq_unit=SquareRootUnit(LoadUnitHandle(h,id,CasterHash),LoadUnitHandle(h,id,TargetHash))
set bjLCE=LoadEffectHandle(h,id,StringHash("EffectHakke"))
call SetSpecialEffectX(bjLCE,target_x)
call SetSpecialEffectY(bjLCE,target_y)
if time<2.0 or(time>2.6 and time<3)then
call SetUnitFacingInstant(LoadUnitHandle(h,id,CasterHash),angle*bj_RADTODEG)
call SetUnitX(LoadUnitHandle(h,id,TargetHash),target_x+3*Cos(angle))
call SetUnitY(LoadUnitHandle(h,id,TargetHash),target_y+3*Sin(angle))
if sq_unit>250 then
call SetUnitX(LoadUnitHandle(h,id,CasterHash),caster_x+sq_unit/10*Cos(angle))
call SetUnitY(LoadUnitHandle(h,id,CasterHash),caster_y+sq_unit/10*Sin(angle))
else
call SetUnitX(LoadUnitHandle(h,id,CasterHash),caster_x+4*Cos(angle))
call SetUnitY(LoadUnitHandle(h,id,CasterHash),caster_y+4*Sin(angle))
endif
endif
if time==0.35 then
call AlbedoW_hit(LoadUnitHandle(h,id,TargetHash),angle,CreateTimer())
elseif time==0.75 then
call AlbedoW_hit(LoadUnitHandle(h,id,TargetHash),angle,CreateTimer())
elseif time==1.4 then
call AlbedoW_hit(LoadUnitHandle(h,id,TargetHash),angle,CreateTimer())
elseif time==1.8 then
call AlbedoW_hit(LoadUnitHandle(h,id,TargetHash),angle,CreateTimer())
elseif time==2 then
call UnitAddAbility(LoadUnitHandle(h,id,CasterHash),'Arav')
call UnitRemoveAbility(LoadUnitHandle(h,id,CasterHash),'Arav')
call UnitAddAbility(LoadUnitHandle(h,id,TargetHash),'Arav')
call UnitRemoveAbility(LoadUnitHandle(h,id,TargetHash),'Arav')
call SetUnitFlyHeight(LoadUnitHandle(h,id,TargetHash),600,1900)
set bjLCE=AddSpecialEffect("purpleeq.mdl",target_x,target_y)
call SetSpecialEffectScale(bjLCE,0.7)
call DestroyEffect(bjLCE)
set bjLCE=AddSpecialEffect("123 (136)1.mdl",target_x,target_y)
call SetSpecialEffectScale(bjLCE,0.85)
call SetSpecialEffectAnimationByIndex(bjLCE,0)
call RemoveEffect(bjLCE,0.5,false,CreateTimer())
set bjLCE=AddSpecialEffect("Ikarice2_FAW34.mdl",target_x,target_y)
call SetSpecialEffectScale(bjLCE,2)
call SetSpecialEffectFacing(bjLCE,GetRandomInt(0,360))
call SetSpecialEffectZ(bjLCE,125)
call RemoveEffect(bjLCE,0.9,false,CreateTimer())
set bjLCE=AddSpecialEffect("warstompcaster1234.mdl",target_x,target_y)
call SetSpecialEffectScale(bjLCE,1.6)
call DestroyEffect(bjLCE)
call ShakeCamera(0.3,30)
elseif time==2.6 then
call SetUnitFlyHeight(LoadUnitHandle(h,id,CasterHash),600,2000)
call SetUnitX(LoadUnitHandle(h,id,CasterHash),target_x-200*Cos(angle))
call SetUnitY(LoadUnitHandle(h,id,CasterHash),target_y-200*Sin(angle))
elseif time==3 then
call AlbedoW_LastHit(LoadUnitHandle(h,id,CasterHash),LoadUnitHandle(h,id,TargetHash),angle,CreateTimer())
endif
else
call DestroyEffect(LoadEffectHandle(h,id,StringHash("EffectHakke")))
call SetUnitFlyHeight(LoadUnitHandle(h,id,CasterHash),0,2000)
call PauseUnit(LoadUnitHandle(h,id,CasterHash),false)
call SetUnitInvulnerable(LoadUnitHandle(h,id,CasterHash),false)
call FlushChildHashtable(h,id)
call DestroyTimer(GetExpiredTimer())
endif
endfunction
function AlbedoW_SecondAct takes unit newCaster,unit newTarget,timer newTimer returns nothing
local integer id=GetHandleId(newTimer)
set bjLCE=AddSpecialEffect("[spell]hakkestart.mdl",GetUnitX(newTarget),GetUnitY(newTarget))
call SetSpecialEffectScale(bjLCE,2)
call SetSpecialEffectAlpha(bjLCE,150)
call SetSpecialEffectZ(bjLCE,20)
call SaveEffectHandle(h,id,StringHash("EffectHakke"),bjLCE)
call PauseUnit(newTarget,true)
call SaveBoolean(HH,GetHandleId(newTarget),TARGET_ABILITY,true)
call SetUnitInvulnerable(newTarget,true)
call SetUnitAnimationByIndex(newCaster,15)
call SaveUnitHandle(h,id,CasterHash,newCaster)
call SaveUnitHandle(h,id,TargetHash,newTarget)
call TimerStart(newTimer,0.01,true,function AlbedoW_SecondAct_Periodic)
endfunction
function AlbedoW_FirstAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local real caster_x=GetUnitX(LoadUnitHandle(h,id,CasterHash))
local real caster_y=GetUnitY(LoadUnitHandle(h,id,CasterHash))
local real angle=AU(LoadUnitHandle(h,id,CasterHash),LoadUnitHandle(h,id,TargetHash))
local integer eff_period=LoadInteger(h,id,EffectPeriodHash)
if SquareRootUnit(LoadUnitHandle(h,id,CasterHash),LoadUnitHandle(h,id,TargetHash))>150 then
call SetUnitX(LoadUnitHandle(h,id,CasterHash),caster_x+30*Cos(angle))
call SetUnitY(LoadUnitHandle(h,id,CasterHash),caster_y+30*Sin(angle))
if eff_period==0 then
call SaveInteger(h,id,EffectPeriodHash,4)
else
call SaveInteger(h,id,EffectPeriodHash,eff_period-1)
endif
else
if LoadBoolean(HH,GetHandleId(LoadUnitHandle(h,id,TargetHash)),ANTITARGET_ABILITY)==false then
call SetUnitVertexColor(LoadUnitHandle(h,id,CasterHash),255,255,255,255)
call AlbedoW_SecondAct(LoadUnitHandle(h,id,CasterHash),LoadUnitHandle(h,id,TargetHash),CreateTimer())
call FlushChildHashtable(h,id)
call DestroyTimer(GetExpiredTimer())
else
call SetUnitVertexColor(LoadUnitHandle(h,id,CasterHash),255,255,255,255)
call SaveUnitHandle(HH,GetHandleId(LoadUnitHandle(h,id,TargetHash)),REVERSE_TARGET,LoadUnitHandle(h,id,CasterHash))
call FlushChildHashtable(h,id)
call DestroyTimer(GetExpiredTimer())
endif
endif
endfunction
function AlbedoW_Cast takes unit newCaster,unit newTarget,timer newTimer returns nothing
local integer id=GetHandleId(newTimer)
set soundplay=CreateSound("Sound\\war3mapImported\\AlbedoW.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
set bjLCE=AddSpecialEffect("cf2.mdl",GetUnitX(newCaster),GetUnitY(newCaster))
call SetSpecialEffectScale(bjLCE,0.7)
call SetSpecialEffectFacing(bjLCE,AU(newCaster,newTarget)*bj_RADTODEG)
call SetSpecialEffectZ(bjLCE,120)
call DestroyEffect(bjLCE)
call PauseUnit(newCaster,true)
call SetUnitInvulnerable(newCaster,true)
call SetUnitAnimationByIndex(newCaster,3)
call SetUnitVertexColor(newCaster,150,150,150,150)
call SaveUnitHandle(h,id,CasterHash,newCaster)
call SaveUnitHandle(h,id,TargetHash,newTarget)
call TimerStart(newTimer,0.01,true,function AlbedoW_FirstAct)
endfunction
function AlbedoE_Periodic takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local real dmg_hp=0
local real x=GetUnitX(LoadUnitHandle(h,id,CasterHash))
local real y=GetUnitY(LoadUnitHandle(h,id,CasterHash))
local real z=GetUnitFlyHeight(LoadUnitHandle(h,id,CasterHash))
local group g=LoadGroupHandle(h,id,GroupHash)
if GetUnitAbilityLevel(LoadUnitHandle(h,id,CasterHash),'AlEp')>=1 then
set bjLCU=LoadUnitHandle(h,id,Effect1Hash)
call SetUnitX(bjLCU,x)
call SetUnitY(bjLCU,y)
call SetUnitFlyHeight(bjLCU,z-50,0)
set bjLCU=LoadUnitHandle(h,id,Effect2Hash)
call SetUnitX(bjLCU,x)
call SetUnitY(bjLCU,y)
call SetUnitFlyHeight(bjLCU,z-50,0)
if GetUnitAbilityLevel(LoadUnitHandle(h,id,CasterHash),'B00V')!=0 then
if GetUnitAbilityLevel(LoadUnitHandle(h,id,Effect1Hash),'A0A1')==0 then
call UnitAddAbility(LoadUnitHandle(h,id,Effect1Hash),'A0A1')
call UnitAddAbility(LoadUnitHandle(h,id,Effect2Hash),'A0A1')
endif
else
if GetUnitAbilityLevel(LoadUnitHandle(h,id,Effect1Hash),'A0A1')==1 then
call UnitRemoveAbility(LoadUnitHandle(h,id,Effect1Hash),'A0A1')
call UnitRemoveAbility(LoadUnitHandle(h,id,Effect2Hash),'A0A1')
endif
endif
if LoadReal(h,id,TIME_HASH)==0.5 then
call GroupEnumUnitsInRange(g,x,y,GetUnitAbilityLevel(LoadUnitHandle(h,id,CasterHash),'AlbE')*50+550,Base)
loop
set bjLCU=FirstOfGroup(g)
exitwhen bjLCU==null
if Condition_Base(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)),bjLCU)==true then
set dmg_hp=GetWidgetMaxLife(bjLCU)*0.0025
call HealTextTag(LoadUnitHandle(h,id,CasterHash),LoadUnitHandle(h,id,CasterHash),dmg_hp*myCustomHeal2(LoadUnitHandle(h,id,CasterHash),1),"HealthRes")
call AddWidgetLife(LoadUnitHandle(h,id,CasterHash),dmg_hp)
set bjLCE=AddSpecialEffect("Abilities\\Spells\\Items\\VampiricPotion\\VampPotionCaster.mdl",GetUnitX(bjLCU),GetUnitY(bjLCU))
call SetSpecialEffectScale(bjLCE,0.7)
call SetSpecialEffectZ(bjLCE,1)
call SetSpecialEffectTimeScale(bjLCE,25)
call RemoveEffect(bjLCE,0.6,true,CreateTimer())
call myCustomDamage(LoadUnitHandle(h,id,CasterHash),bjLCU,dmg_hp,false,false,null,DAMAGE_TYPE_UNIVERSAL,null)
endif
call GroupRemoveUnit(g,bjLCU)
endloop
call SaveReal(h,id,TIME_HASH,0)
else
call SaveReal(h,id,TIME_HASH,LoadReal(h,id,TIME_HASH)+0.02)
endif
else
call GroupClear(g)
call DestroyGroup(g)
call KillUnit(LoadUnitHandle(h,id,Effect1Hash))
call KillUnit(LoadUnitHandle(h,id,Effect2Hash))
call MyRemoveUnit(LoadUnitHandle(h,id,Effect1Hash),1.5)
call MyRemoveUnit(LoadUnitHandle(h,id,Effect2Hash),1.5)
call FlushChildHashtable(h,id)
call DestroyTimer(GetExpiredTimer())
set g=null
endif
endfunction
function AlbedoE_Cast takes unit newCaster,timer newTimer returns nothing
local integer id=GetHandleId(newTimer)
set soundplay=CreateSound("Sound\\war3mapImported\\AlbedoE.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
set bjLCE=AddSpecialEffect("az_cocoguanyu_t2_death.mdl",GetUnitX(newCaster),GetUnitY(newCaster))
call SetSpecialEffectScale(bjLCE,2)
call RemoveEffect(bjLCE,1,false,CreateTimer())
set bjLCE=AddSpecialEffect("BY_Wood_Eff_Ord_DanGe_Wav_Kuosan_1_2_0.25s.mdl",GetUnitX(newCaster),GetUnitY(newCaster))
call SetSpecialEffectScale(bjLCE,3)
call SetSpecialEffectVertexColour(bjLCE,255,200,200,200)
call RemoveEffect(bjLCE,1.5,false,CreateTimer())
set bjLCU=CreateUnit(GetOwningPlayer(newCaster),'dAlb',GetUnitX(newCaster),GetUnitY(newCaster),GetRandomInt(0,360))
call SetUnitModel(bjLCU,"bymutou_huozhu_hongse3.mdl")
call SetUnitScale(bjLCU,0.9,0.9,0.9)
call SaveUnitHandle(h,id,Effect1Hash,bjLCU)
set bjLCU=CreateUnit(GetOwningPlayer(newCaster),'dAlb',GetUnitX(newCaster),GetUnitY(newCaster),GetRandomInt(0,360))
call SetUnitModel(bjLCU,"model (471).mdl")
call SetUnitScale(bjLCU,1.3,1.3,1.3)
call SaveUnitHandle(h,id,Effect2Hash,bjLCU)
call SetUnitAnimationByIndex(newCaster,16)
call SaveUnitHandle(h,id,CasterHash,newCaster)
call SaveReal(h,id,TIME_HASH,0)
call SaveGroupHandle(h,id,GroupHash,CreateGroup())
call TimerStart(newTimer,0.02,true,function AlbedoE_Periodic)
endfunction
function AlbedoR_SideAct_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    if LoadInteger(h,id,StringHash("Iteration"))>0 then
        call SetUnitX(LoadUnitHandle(h,id,TargetHash),GetUnitX(LoadUnitHandle(h,id,TargetHash))+(15+LoadInteger(h,id,StringHash("Iteration"))/3)*Cos(LoadReal(h,id,AngleHash)))
        call SetUnitY(LoadUnitHandle(h,id,TargetHash),GetUnitY(LoadUnitHandle(h,id,TargetHash))+(15+LoadInteger(h,id,StringHash("Iteration"))/3)*Sin(LoadReal(h,id,AngleHash)))
        if LoadInteger(h,id,EffectPeriodHash)==0 then
            call DestroyEffect(AddSpecialEffect("sand.mdl",GetUnitX(LoadUnitHandle(h,id,TargetHash)),GetUnitY(LoadUnitHandle(h,id,TargetHash))))
            call SaveInteger(h,id,EffectPeriodHash,7)
        else
            call SaveInteger(h,id,EffectPeriodHash,LoadInteger(h,id,EffectPeriodHash)-1)
        endif
        call SaveInteger(h,id,StringHash("Iteration"),LoadInteger(h,id,StringHash("Iteration"))-1)
    else
        call MyRemoveUnit(CreateUnit(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)),'dAlb',GetUnitX(LoadUnitHandle(h,id,TargetHash)),GetUnitY(LoadUnitHandle(h,id,TargetHash)),0), 2)
        call FlushChildHashtable(h,id)
        call DestroyTimer(GetExpiredTimer())
    endif
endfunction
function AlbedoR_SideAct takes unit newCaster,unit newTarget,unit newDummy,timer newTimer returns nothing
local integer id=GetHandleId(newTimer)
local integer full_dmg=GetHeroStr(newCaster,true)*(GetUnitAbilityLevel(newCaster,'AlbR')+4)
local real newAngle=AU(newCaster,newTarget)
set bjLCE=AddSpecialEffect("az_hitheavy.mdl",GetUnitX(newTarget),GetUnitY(newTarget))
call SetSpecialEffectFacing(bjLCE,AU(newCaster,newTarget)*bj_RADTODEG)
call SetSpecialEffectScale(bjLCE,2.5)
call SetSpecialEffectZ(bjLCE,100)
call DestroyEffect(bjLCE)
set bjLCE=AddSpecialEffect("az_slb.mdl",GetUnitX(newTarget),GetUnitY(newTarget))
call SetSpecialEffectScale(bjLCE,1.5)
call DestroyEffect(bjLCE)
set bjLCE=AddSpecialEffect("blood-boom.mdl",GetUnitX(newTarget),GetUnitY(newTarget))
call SetSpecialEffectFacing(bjLCE,AU(newCaster,newTarget)*bj_RADTODEG)
call SetSpecialEffectScale(bjLCE,1.5)
call SetSpecialEffectZ(bjLCE,75)
call DestroyEffect(bjLCE)
set bjLCU=CreateUnit(GetOwningPlayer(newCaster),'dAl2',GetUnitX(newTarget),GetUnitY(newTarget),AU(newCaster,newTarget)*bj_RADTODEG)
call SetUnitModel(bjLCU,"BY_Wood_Eff_Ord_DanGe_Wav_Kuosan_1_3_1s.mdl")
call SetUnitScale(bjLCU,0.4,0.4,0.4)
call SetUnitFlyHeight(bjLCU,175,0)
call SetUnitVertexColor(bjLCU,255,200,255,50)
call MyRemoveUnit(bjLCU,1.5)
set bjLCU=CreateUnit(GetOwningPlayer(newCaster),'dAl2',GetUnitX(newTarget),GetUnitY(newTarget),AU(newCaster,newTarget)*bj_RADTODEG)
call SetUnitModel(bjLCU,"Ikarice2_FAW34.mdl")
call SetUnitScale(bjLCU,1.4,1.4,1.4)
call SetUnitFlyHeight(bjLCU,155,0)
call SetUnitVertexColor(bjLCU,255,255,255,180)
call MyRemoveUnit(bjLCU,0.7)
set bjLCE=AddSpecialEffect("newdirtex.mdl",GetUnitX(newTarget),GetUnitY(newTarget))
call SetSpecialEffectScale(bjLCE,3)
call DestroyEffect(bjLCE)
set bjLCE=AddSpecialEffect("cf2.mdl",GetUnitX(newCaster),GetUnitY(newCaster))
call SetSpecialEffectScale(bjLCE,1)
call SetSpecialEffectZ(bjLCE,125)
call SetSpecialEffectFacing(bjLCE,newAngle*bj_RADTODEG)
call DestroyEffect(bjLCE)
set bjLCE=AddSpecialEffect("nitu.mdl",GetUnitX(newTarget)+180*Cos(newAngle+30*bj_DEGTORAD),GetUnitY(newTarget)+180*Sin(newAngle+30*bj_DEGTORAD))
call SetSpecialEffectFacing(bjLCE,newAngle*bj_RADTODEG+220)
call SetSpecialEffectScale(bjLCE,2.2)
call SetSpecialEffectAlpha(bjLCE,150)
call DestroyEffect(bjLCE)
set bjLCE=AddSpecialEffect("nitu.mdl",GetUnitX(newTarget)+180*Cos(newAngle-30*bj_DEGTORAD),GetUnitY(newTarget)+180*Sin(newAngle-30*bj_DEGTORAD))
call SetSpecialEffectFacing(bjLCE,newAngle*bj_RADTODEG+140)
call SetSpecialEffectScale(bjLCE,2.2)
call SetSpecialEffectAlpha(bjLCE,150)
call DestroyEffect(bjLCE)
set bjLCE=AddSpecialEffect("nitu.mdl",GetUnitX(newTarget)+190*Cos(newAngle),GetUnitY(newTarget)+190*Sin(newAngle))
call SetSpecialEffectFacing(bjLCE,newAngle*bj_RADTODEG+180)
call SetSpecialEffectScale(bjLCE,2.2)
call SetSpecialEffectAlpha(bjLCE,150)
call DestroyEffect(bjLCE)
call SaveUnitHandle(h,id,CasterHash,newCaster)
call SaveUnitHandle(h,id,TargetHash,newTarget)
call SaveInteger(h,id,StringHash("Iteration"),50)
call SaveReal(h,id,AngleHash,AU(newCaster,newTarget))
call SlowUnit(newCaster,newTarget,0.9,0,5,2,false)
call myCustomDamage(newCaster,newTarget,full_dmg,false,false,null,null,null)
call SetControlToUnit(newCaster,newTarget,0.5,"stun")
call TimerStart(newTimer,0.02,true,function AlbedoR_SideAct_Periodic)
call ShakeCamera(0.2,15)
endfunction
function AlbedoR_SecondAct_Periodic takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local real caster_x=GetUnitX(LoadUnitHandle(h,id,CasterHash))
local real caster_y=GetUnitY(LoadUnitHandle(h,id,CasterHash))
local real angle=0
if LoadReal(h,id,StringHash("PrepareTime"))<=0 then
    if LoadUnitHandle(h,id,TargetHash)==null then
        set bjLCG=LoadGroupHandle(h,id,GroupHash)
        set bjLCU=FirstOfGroup(bjLCG)
        if bjLCU==null then
            if SquareRootUnit(LoadUnitHandle(h,id,CasterHash),LoadUnitHandle(h,id,StringHash("MainTarget")))>=125 then
                set angle=AU(LoadUnitHandle(h,id,CasterHash),LoadUnitHandle(h,id,StringHash("MainTarget")))
                call SetUnitX(LoadUnitHandle(h,id,CasterHash),caster_x+60*Cos(angle))
                call SetUnitY(LoadUnitHandle(h,id,CasterHash),caster_y+60*Sin(angle))
                call SetUnitFacingInstant(LoadUnitHandle(h,id,CasterHash),angle*bj_RADTODEG)
                call SetSpecialEffectX(LoadEffectHandle(h,id,Effect1Hash),caster_x)
                call SetSpecialEffectY(LoadEffectHandle(h,id,Effect1Hash),caster_y)
                call SetSpecialEffectZ(LoadEffectHandle(h,id,Effect1Hash),GetUnitFlyHeight(LoadUnitHandle(h,id,CasterHash))+50)
            else
                call RemoveEffect(LoadEffectHandle(h,id,Effect1Hash),1,true,CreateTimer())
                call PauseUnit(LoadUnitHandle(h,id,CasterHash),false)
                call SetUnitInvulnerable(LoadUnitHandle(h,id,CasterHash),false)
                call AlbedoR_SideAct(LoadUnitHandle(h,id,CasterHash),LoadUnitHandle(h,id,StringHash("MainTarget")),null,CreateTimer())
                call DestroyGroup(bjLCG)
                call FlushChildHashtable(h,id)
                call DestroyTimer(GetExpiredTimer())
            endif
        else
            call SaveUnitHandle(h,id,TargetHash,bjLCU)
        endif
    else
        if SquareRootUnit(LoadUnitHandle(h,id,CasterHash),LoadUnitHandle(h,id,TargetHash))>=60 then
            set angle=AU(LoadUnitHandle(h,id,CasterHash),LoadUnitHandle(h,id,TargetHash))
            call SetUnitX(LoadUnitHandle(h,id,CasterHash),caster_x+50*Cos(angle))
            call SetUnitY(LoadUnitHandle(h,id,CasterHash),caster_y+50*Sin(angle))
            call SetUnitFacingInstant(LoadUnitHandle(h,id,CasterHash),angle*bj_RADTODEG)
            call SetSpecialEffectX(LoadEffectHandle(h,id,Effect1Hash),caster_x)
            call SetSpecialEffectY(LoadEffectHandle(h,id,Effect1Hash),caster_y)
            call SetSpecialEffectZ(LoadEffectHandle(h,id,Effect1Hash),GetUnitFlyHeight(LoadUnitHandle(h,id,CasterHash))+50)
        else
            if LoadBoolean(HH,GetHandleId(LoadUnitHandle(h,id,TargetHash)),ANTITARGET_ABILITY)==false then
                call GroupRemoveUnit(LoadGroupHandle(h,id,GroupHash),LoadUnitHandle(h,id,TargetHash))
                call AlbedoR_SideAct(LoadUnitHandle(h,id,CasterHash),LoadUnitHandle(h,id,TargetHash),null,CreateTimer())
                call RemoveSavedHandle(h,id,TargetHash)
            else
                call RemoveEffect(LoadEffectHandle(h,id,Effect1Hash),1,true,CreateTimer())
                call PauseUnit(LoadUnitHandle(h,id,CasterHash),false)
                call SaveUnitHandle(HH,GetHandleId(LoadUnitHandle(h,id,TargetHash)),REVERSE_TARGET,LoadUnitHandle(h,id,CasterHash))
                call SetUnitInvulnerable(LoadUnitHandle(h,id,CasterHash),false)
                call DestroyGroup(bjLCG)
                call FlushChildHashtable(h,id)
                call DestroyTimer(GetExpiredTimer())
            endif
        endif
    endif
else
    call SaveReal(h,id,StringHash("PrepareTime"),LoadReal(h,id,StringHash("PrepareTime"))-0.01)
endif
endfunction
function AlbedoR_SecondAct takes unit newCaster,group newGroup,timer newTimer,unit closest_unit returns nothing
local integer id=GetHandleId(newTimer)
set bjLCE=AddSpecialEffect("[dz.spell]006-1.mdl",GetUnitX(newCaster),GetUnitY(newCaster))
call SetSpecialEffectScale(bjLCE,1.2)
call DestroyEffect(bjLCE)
set bjLCE=AddSpecialEffect("amx (345).mdl",GetUnitX(newCaster),GetUnitY(newCaster))
call SetSpecialEffectZ(bjLCE,50)
call SetSpecialEffectScale(bjLCE,3)
call DestroyEffect(bjLCE)
set bjLCE=AddSpecialEffect("BY_Wood_Eff_Ord_DanGe_Wav_Kuosan_1_3_1s.mdl",GetUnitX(newCaster),GetUnitY(newCaster))
call SetSpecialEffectZ(bjLCE,50)
call SetSpecialEffectScale(bjLCE,0.75)
call SetSpecialEffectVertexColour(bjLCE,255,200,255,170)
call DestroyEffect(bjLCE)
set bjLCE=AddSpecialEffect("Keyesdevilslamita.mdl",GetUnitX(newCaster),GetUnitY(newCaster))
call SetSpecialEffectScale(bjLCE,2)
call DestroyEffect(bjLCE)
set bjLCE=AddSpecialEffect("Keyesdt1white.mdl",GetUnitX(newCaster),GetUnitY(newCaster))
call SetSpecialEffectScale(bjLCE,2)
call SetSpecialEffectZ(bjLCE,25)
call RemoveEffect(bjLCE,1.5,false,CreateTimer())
set bjLCE=AddSpecialEffect("3DMGslash_Red.mdl",GetUnitX(newCaster),GetUnitY(newCaster))
call SetSpecialEffectScale(bjLCE,5)
call SetSpecialEffectZ(bjLCE,GetUnitFlyHeight(newCaster)+50)
call SaveEffectHandle(h,id,Effect1Hash,bjLCE)
set bjLCG=CreateGroup()
set closest_unit=FirstOfGroup(newGroup)
loop
set bjLCU=FirstOfGroup(newGroup)
exitwhen bjLCU==null
call GroupAddUnit(bjLCG,bjLCU)
if SquareRootUnit(newCaster,bjLCU)<SquareRootUnit(newCaster,closest_unit)then
set closest_unit=bjLCU
endif
call GroupRemoveUnit(newGroup,bjLCU)
endloop
call GroupRemoveUnit(bjLCG,closest_unit)
call DestroyGroup(newGroup)
call PauseUnit(newCaster,true)
call SetUnitInvulnerable(newCaster,true)
call SaveUnitHandle(h,id,CasterHash,newCaster)
call SaveUnitHandle(h,id,StringHash("MainTarget"),closest_unit)
call SaveGroupHandle(h,id,GroupHash,bjLCG)
call SaveReal(h,id,StringHash("PrepareTime"),0.2)
call TimerStart(newTimer,0.01,true,function AlbedoR_SecondAct_Periodic)
endfunction
function AlbedoR_FirstAct_Periodic takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local real time=LoadReal(h,id,TIME_HASH)
local integer eff_period=LoadInteger(h,id,EffectPeriodHash)
if time<1.25 then
call SaveReal(h,id,TIME_HASH,time+0.01)
if eff_period==0 then
set bjLCE=LoadEffectHandle(h,id,Effect1Hash)
call SetSpecialEffectX(bjLCE,GetUnitX(LoadUnitHandle(h,id,CasterHash)))
call SetSpecialEffectY(bjLCE,GetUnitY(LoadUnitHandle(h,id,CasterHash)))
set bjLCE=LoadEffectHandle(h,id,Effect2Hash)
call SetSpecialEffectX(bjLCE,GetUnitX(LoadUnitHandle(h,id,CasterHash)))
call SetSpecialEffectY(bjLCE,GetUnitY(LoadUnitHandle(h,id,CasterHash)))
set bjLCE=AddSpecialEffect("DustWaveAnimate.mdl",GetUnitX(LoadUnitHandle(h,id,CasterHash)),GetUnitY(LoadUnitHandle(h,id,CasterHash)))
call SetSpecialEffectScale(bjLCE,2.1)
call SetSpecialEffectAnimationByIndex(bjLCE,0)
call SetSpecialEffectFacing(bjLCE,time*(-180))
call SetSpecialEffectVertexColour(bjLCE,205,50,235,150)
call DestroyEffect(bjLCE)
if time<1.25 then
set bjLCE=AddSpecialEffect("AFB (1888).mdl",GetUnitX(LoadUnitHandle(h,id,CasterHash)),GetUnitY(LoadUnitHandle(h,id,CasterHash)))
call SetSpecialEffectScale(bjLCE,1.75)
call SetSpecialEffectFacing(bjLCE,time*(-180))
call RemoveEffect(bjLCE,0.7,false,CreateTimer())
endif
set bjLCG=LoadGroupHandle(h,id,GroupHash)
call GroupEnumUnitsInRange(bjLCG,GetUnitX(LoadUnitHandle(h,id,CasterHash)),GetUnitY(LoadUnitHandle(h,id,CasterHash)),800,Base)
loop
set bjLCU=FirstOfGroup(bjLCG)
exitwhen bjLCU==null
if Condition_Base(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)),bjLCU)==true then
call IssueImmediateOrder(bjLCU,"stop")
set bjLCE=AddSpecialEffect("white-qiquan-juhuang.mdl",GetUnitX(bjLCU),GetUnitY(bjLCU))
call SetSpecialEffectFacing(bjLCE,GetRandomInt(0,360))
call SetSpecialEffectZ(bjLCE,0)
call SetSpecialEffectScale(bjLCE,0.35)
call RemoveEffect(bjLCE,1,true,CreateTimer())
set bjLCE=AddSpecialEffect("tx_paomo2213.mdl",GetUnitX(bjLCU),GetUnitY(bjLCU))
call SetSpecialEffectFacing(bjLCE,GetRandomInt(0,360))
call SetSpecialEffectZ(bjLCE,125)
call SetSpecialEffectScale(bjLCE,0.3)
call RemoveEffect(bjLCE,0.35,true,CreateTimer())
if IsUnitInGroup(bjLCU,LoadGroupHandle(h,id,StringHash("SecondActGroup")))==false then
call GroupAddUnit(LoadGroupHandle(h,id,StringHash("SecondActGroup")),bjLCU)
endif
endif
call GroupRemoveUnit(bjLCG,bjLCU)
endloop
call SaveInteger(h,id,EffectPeriodHash,10)
else
call SaveInteger(h,id,EffectPeriodHash,eff_period-1)
endif
else
call DestroyEffect(LoadEffectHandle(h,id,Effect1Hash))
call DestroyEffect(LoadEffectHandle(h,id,Effect2Hash))
call DestroyGroup(LoadGroupHandle(h,id,GroupHash))
if FirstOfGroup(LoadGroupHandle(h,id,StringHash("SecondActGroup")))==null then
call PauseUnit(LoadUnitHandle(h,id,CasterHash),false)
//call SetUnitInvulnerable(LoadUnitHandle(h,id,CasterHash),false)
call SetUnitAnimationByIndex(LoadUnitHandle(h,id,CasterHash),14)
call DestroyGroup(LoadGroupHandle(h,id,StringHash("SecondActGroup")))
else
call AlbedoR_SecondAct(LoadUnitHandle(h,id,CasterHash),LoadGroupHandle(h,id,StringHash("SecondActGroup")),CreateTimer(),null)
endif
call FlushChildHashtable(h,id)
call DestroyTimer(GetExpiredTimer())
endif
endfunction
function AlbedoR_FirstAct takes unit newCaster,timer newTimer returns nothing
local integer id=GetHandleId(newTimer)
set soundplay=CreateSound("Sound\\war3mapImported\\AlbedoR.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
set bjLCE=AddSpecialEffect("1028.mdl",GetUnitX(newCaster),GetUnitY(newCaster))
call SetSpecialEffectPitch(bjLCE,90)
call SetSpecialEffectScale(bjLCE,2.2)
call SetSpecialEffectAlpha(bjLCE,100)
call SaveEffectHandle(h,id,Effect1Hash,bjLCE)
set bjLCE=AddSpecialEffect("[spell]hakkestart.mdl",GetUnitX(newCaster),GetUnitY(newCaster))
call SetSpecialEffectScale(bjLCE,1.7)
call SetSpecialEffectAlpha(bjLCE,120)
call SetSpecialEffectZ(bjLCE,20)
call SetSpecialEffectAnimationByIndex(bjLCE,0)
call SaveEffectHandle(h,id,Effect2Hash,bjLCE)
call PauseUnit(newCaster,true)
//call SetUnitInvulnerable(newCaster,true)
call SetUnitAnimationByIndex(newCaster,13)
call SaveUnitHandle(h,id,CasterHash,newCaster)
call SaveReal(h,id,TIME_HASH,0)
call SaveGroupHandle(h,id,GroupHash,CreateGroup())
call SaveGroupHandle(h,id,StringHash("SecondActGroup"),CreateGroup())
call TimerStart(newTimer,0.01,true,function AlbedoR_FirstAct_Periodic)
endfunction
function AlbedoT_Attraction_periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    if LoadInteger(h,id,StringHash("Iteration"))>0 then
        if SquareRootUnit(LoadUnitHandle(h,id,CasterHash),LoadUnitHandle(h,id,TargetHash))>160 and SquareRootUnit(LoadUnitHandle(h,id,CasterHash),LoadUnitHandle(h,id,TargetHash))<1000 then
            call SetUnitX(LoadUnitHandle(h,id,TargetHash),GetUnitX(LoadUnitHandle(h,id,TargetHash))+(SquareRootUnit(LoadUnitHandle(h,id,CasterHash),LoadUnitHandle(h,id,TargetHash))/25)*Cos(AU(LoadUnitHandle(h,id,TargetHash),LoadUnitHandle(h,id,CasterHash))))
            call SetUnitY(LoadUnitHandle(h,id,TargetHash),GetUnitY(LoadUnitHandle(h,id,TargetHash))+(SquareRootUnit(LoadUnitHandle(h,id,CasterHash),LoadUnitHandle(h,id,TargetHash))/25)*Sin(AU(LoadUnitHandle(h,id,TargetHash),LoadUnitHandle(h,id,CasterHash))))
        endif
        if LoadInteger(h,id,EffectPeriodHash)==0 then
            call DestroyEffect(AddSpecialEffect("sand.mdl",GetUnitX(LoadUnitHandle(h,id,TargetHash)),GetUnitY(LoadUnitHandle(h,id,TargetHash))))
            call SaveInteger(h,id,EffectPeriodHash,10)
        else
            call SaveInteger(h,id,EffectPeriodHash,LoadInteger(h,id,EffectPeriodHash)-1)
        endif
        call SaveInteger(h,id,StringHash("Iteration"),LoadInteger(h,id,StringHash("Iteration"))-1)
    else
        call MyRemoveUnit(CreateUnit(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)),'dAlb',GetUnitX(LoadUnitHandle(h,id,TargetHash)),GetUnitY(LoadUnitHandle(h,id,TargetHash)),0), 2)
        call FlushChildHashtable(h,id)
        call DestroyTimer(GetExpiredTimer())
    endif
endfunction

function AlbedoT_Attraction takes unit newCaster,unit newTarget,unit newDummy,timer newTimer returns nothing
	local integer id=GetHandleId(newTimer)
	call SaveUnitHandle(h,id,CasterHash,newCaster)
	call SaveUnitHandle(h,id,TargetHash,newTarget)
	call SaveInteger(h,id,StringHash("Iteration"),125)
    call SlowUnit(newCaster,newTarget,0.9,0,5,2,false)
	call TimerStart(newTimer,0.02,true,function AlbedoT_Attraction_periodic)
endfunction

function AlbedoT_Periodic takes nothing returns nothing
        local integer id=GetHandleId(GetExpiredTimer())
        local real time=LoadReal(h,id,TIME_HASH)
        local real caster_x=GetUnitX(LoadUnitHandle(h,id,CasterHash))
        local real caster_y=GetUnitY(LoadUnitHandle(h,id,CasterHash))
        if time<2.5 then
        call PauseUnit(LoadUnitHandle(h,id,CasterHash),true)
                call SaveReal(h,id,TIME_HASH,time+0.01)
                //call SetUnitInvulnerable(LoadUnitHandle(h,id,CasterHash), true)
                set bjLCE=LoadEffectHandle(h,id,Effect1Hash)
                call SetSpecialEffectX(bjLCE,caster_x)
                call SetSpecialEffectY(bjLCE,caster_y)
                call SetSpecialEffectZ(bjLCE,GetUnitFlyHeight(LoadUnitHandle(h,id,CasterHash))+200)
                set bjLCE=LoadEffectHandle(h,id,Effect2Hash)
                call SetSpecialEffectX(bjLCE,caster_x)
                call SetSpecialEffectY(bjLCE,caster_y)
                call SetSpecialEffectZ(bjLCE,GetUnitFlyHeight(LoadUnitHandle(h,id,CasterHash))+150-time*50)
                call SetSpecialEffectScale(bjLCE,0.5+time/4)
                set bjLCE=LoadEffectHandle(h,id,StringHash("Effect3"))
                call SetSpecialEffectX(bjLCE,caster_x)
                call SetSpecialEffectY(bjLCE,caster_y)
                call SetSpecialEffectAlpha(bjLCE,75+R2I(time*20))
                set bjLCE=LoadEffectHandle(h,id,StringHash("Effect5"))
                call SetSpecialEffectX(bjLCE,caster_x)
                call SetSpecialEffectY(bjLCE,caster_y)
                if LoadInteger(h,id,EffectPeriodHash)==0 then
                        call SaveInteger(h,id,EffectPeriodHash,10)
                        set bjLCG=LoadGroupHandle(h,id,StringHash("SecondGroup"))
                        call GroupEnumUnitsInRange(bjLCG,caster_x,caster_y,1000,Base)
                        loop
                                set bjLCU=FirstOfGroup(bjLCG)
                                exitwhen bjLCU==null
                                if Condition_Base(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)),bjLCU)==true and IsUnitInGroup(bjLCU,LoadGroupHandle(h,id,StringHash("FirstGroup")))==false then
                                        call AlbedoT_Attraction(LoadUnitHandle(h,id,CasterHash),bjLCU,null,CreateTimer())
                    call GroupAddUnit(LoadGroupHandle(h,id,StringHash("FirstGroup")),bjLCU)
                                endif
                                call GroupRemoveUnit(bjLCG,bjLCU)
                        endloop
                else
                        call SaveInteger(h,id,EffectPeriodHash,LoadInteger(h,id,EffectPeriodHash)-1)
                endif
        else
                call ShakeCamera(0.5,35)
                set bjLCE=AddSpecialEffect("az_baozhaf2.mdl",caster_x,caster_y)
                call SetSpecialEffectScale(bjLCE,0.8)
                call RemoveEffect(bjLCE,2.3,false,CreateTimer())
                set bjLCE=AddSpecialEffect("Keyesdevilslamita.mdl",caster_x,caster_y)
                call SetSpecialEffectScale(bjLCE,3.8)
                call SetSpecialEffectTimeScale(bjLCE,0.4)
                call DestroyEffect(bjLCE)
                set bjLCE=AddSpecialEffect("Keyesdevilslamita.mdl",caster_x,caster_y)
                call SetSpecialEffectScale(bjLCE,4.8)
                call SetSpecialEffectTimeScale(bjLCE,0.4)
                call DestroyEffect(bjLCE)
                set bjLCE=AddSpecialEffect("123 (136)1.mdl",caster_x,caster_y)
                call SetSpecialEffectScale(bjLCE,1.8)
                call SetSpecialEffectTimeScale(bjLCE,0.4)
                call DestroyEffect(bjLCE)
                set bjLCE=AddSpecialEffect("123 (136)1.mdl",caster_x,caster_y)
                call SetSpecialEffectScale(bjLCE,4.8)
                call SetSpecialEffectTimeScale(bjLCE,0.4)
                call DestroyEffect(bjLCE)
                set bjLCE=AddSpecialEffect("123 (136)1.mdl",caster_x,caster_y)
                call SetSpecialEffectScale(bjLCE,6.8)
                call SetSpecialEffectTimeScale(bjLCE,0.4)
                call DestroyEffect(bjLCE)
                set bjLCE=AddSpecialEffect("purpleeq.mdl",caster_x,caster_y)
                call SetSpecialEffectScale(bjLCE,1.8)
                call SetSpecialEffectTimeScale(bjLCE,0.4)
                call DestroyEffect(bjLCE)
        call GroupClear(LoadGroupHandle(h,id,StringHash("FirstGroup")))
                set bjLCG=CreateGroup()
                call GroupEnumUnitsInRange(bjLCG,caster_x,caster_y,1000,Base)
                loop
                set bjLCU=FirstOfGroup(bjLCG)
                exitwhen bjLCU==null
                if IsUnitIllusion(bjLCU)==false and UnitIsAlive(bjLCU) and IsUnitType(bjLCU,UNIT_TYPE_HERO) and Condition_Base(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)), bjLCU) then
                        call GroupAddUnit(LoadGroupHandle(h,id,StringHash("FirstGroup")),bjLCU)
                endif
                call GroupRemoveUnit(bjLCG,bjLCU)
                endloop
                call DestroyGroup(bjLCG)
                set bjLCG=CreateGroup()
                call GroupEnumUnitsInRange(bjLCG,caster_x,caster_y,1000,Base)
                loop
                set bjLCU=FirstOfGroup(bjLCG)
                exitwhen bjLCU==null
                if Condition_Base(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)),bjLCU)==true then
                        call myCustomDamage(LoadUnitHandle(h,id,CasterHash),bjLCU,LoadReal(h,id,StringHash("Damage"))+LoadReal(h,id,StringHash("Damage"))*(CountUnitsInGroup(LoadGroupHandle(h,id,StringHash("FirstGroup")))-1)*0.15,false,false,null,null,null)
                        call SetControlToUnit(LoadUnitHandle(h,id,CasterHash),bjLCU,0.25,"stun")
                endif
                call GroupRemoveUnit(bjLCG,bjLCU)
                endloop
                call DestroyGroup(bjLCG)
                call DestroyGroup(LoadGroupHandle(h,id,StringHash("FirstGroup")))
                call DestroyGroup(LoadGroupHandle(h,id,StringHash("SecondGroup")))
                call UnitRemoveAbility(LoadUnitHandle(h,id,CasterHash), 'AP08')
                call PauseUnit(LoadUnitHandle(h,id,CasterHash),false)
                call SetUnitTargetable(LoadUnitHandle(h,id,CasterHash), true)
                //call SetUnitInvulnerable(LoadUnitHandle(h,id,CasterHash),false)
                call DestroyEffect(LoadEffectHandle(h,id,Effect1Hash))
                call DestroyEffect(LoadEffectHandle(h,id,Effect2Hash))
                call DestroyEffect(LoadEffectHandle(h,id,StringHash("Effect3")))
                call DestroyEffect(LoadEffectHandle(h,id,StringHash("Effect5")))
                call FlushChildHashtable(h,id)
                call DestroyTimer(GetExpiredTimer())
        endif
endfunction

function AlbedoT_Cast takes unit newCaster,group newGroup,timer newTimer returns nothing
        local integer id=GetHandleId(newTimer)
        local real caster_x=GetUnitX(newCaster)
        local real caster_y=GetUnitY(newCaster)
        set soundplay=CreateSound("Sound\\war3mapImported\\AlbedoT.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        set bjLCE=AddSpecialEffect("Keyesdevilslamita.mdl",caster_x,caster_y)
        call SetSpecialEffectScale(bjLCE,3)
        call SetSpecialEffectVertexColour(bjLCE,255,200,200,200)
        call RemoveEffect(bjLCE,1.5,false,CreateTimer())
        set bjLCE=AddSpecialEffect("amx (144).mdl",caster_x,caster_y)
        call SetSpecialEffectScale(bjLCE,2.8)
        call SetSpecialEffectTimeScale(bjLCE,0.235)
        call DestroyEffect(bjLCE)
        set bjLCE=AddSpecialEffect("nanohacast123.mdl",caster_x,caster_y)
        call SetSpecialEffectZ(bjLCE,200)
        call SetSpecialEffectScale(bjLCE,2)
        call SaveEffectHandle(h,id,Effect1Hash,bjLCE)
        set bjLCE=AddSpecialEffect("shadowtrap-ny.mdl",caster_x,caster_y)
        call SetSpecialEffectZ(bjLCE,150)
        call SetSpecialEffectScale(bjLCE,0.5)
        call SaveEffectHandle(h,id,Effect2Hash,bjLCE)
        set bjLCE=AddSpecialEffect("[spell]hakkestart.mdl",caster_x,caster_y)
        call SetSpecialEffectScale(bjLCE,2.5)
        call SetSpecialEffectAlpha(bjLCE,50)
        call SetSpecialEffectZ(bjLCE,20)
        call SaveEffectHandle(h,id,StringHash("Effect3"),bjLCE)
        set bjLCE=AddSpecialEffect("effect_mythic_VoidRiftPurple.mdl",caster_x,caster_y)
        call SetSpecialEffectScale(bjLCE,1.65)
        call SetSpecialEffectTimeScale(bjLCE,0.65)
        call SaveEffectHandle(h,id,StringHash("Effect5"),bjLCE)
        call DestroyGroup(bjLCG)
        call SetUnitTargetable(newCaster, false)
        call UnitAddAbility(newCaster, 'AP08')
        call UnitMakeAbilityPermanent(newCaster, true, 'AP08')
        call PauseUnit(newCaster,true)
        //call SetUnitInvulnerable(newCaster,true)
        call SetUnitAnimationByIndex(newCaster,5)
        call SaveUnitHandle(h,id,CasterHash,newCaster)
        call SaveReal(h,id,TIME_HASH,0)
        call SaveReal(h,id,StringHash("Damage"),11*GetHeroStr(newCaster,true))
        call SaveGroupHandle(h,id,StringHash("FirstGroup"),CreateGroup())
        call SaveGroupHandle(h,id,StringHash("SecondGroup"),CreateGroup())
        call TimerStart(newTimer,0.01,true,function AlbedoT_Periodic)
endfunction
function Trig_AlbedoInt_Actions takes nothing returns nothing
local real Angle=0
local real x=GetUnitX(GetSpellAbilityUnit())
local real y=GetUnitY(GetSpellAbilityUnit())
local integer id=GetHandleId(GetSpellAbilityUnit())
if GetSpellAbilityId() == 'AlDl' then // Альбедо new D: Unholy Leap
        call AlbedoD_Cast(GetSpellAbilityUnit() , GetSpellTargetX() , GetSpellTargetY() , CreateTimer())
endif
if GetSpellAbilityId()=='AlF1' then
call AlbedoChangeF(GetSpellAbilityUnit(),1)
endif
if GetSpellAbilityId()=='AlF2' then
call AlbedoChangeF(GetSpellAbilityUnit(),2)
endif
if GetSpellAbilityId()=='AlF3' then
call AlbedoChangeF(GetSpellAbilityUnit(),3)
endif
if GetSpellAbilityId()=='AlbQ' then
call AlbedoQ_Cast(GetSpellAbilityUnit(),GetSpellTargetX(),GetSpellTargetY(),0,CreateTimer())
endif
if GetSpellAbilityId()=='AlbW' then
call AlbedoW_Cast(GetSpellAbilityUnit(),GetSpellTargetUnit(),CreateTimer())
endif
if GetSpellAbilityId()=='AlbE' then
call AlbedoE_Cast(GetSpellAbilityUnit(),CreateTimer())
endif
if GetSpellAbilityId()=='AlbR' then
call AlbedoR_FirstAct(GetSpellAbilityUnit(),CreateTimer())
endif
if GetSpellAbilityId()=='AlbT' then
call AlbedoT_Cast(GetSpellAbilityUnit(),CreateGroup(),CreateTimer())
endif
endfunction
function InitTrig_AlbedoInt takes nothing returns nothing
local trigger trig=CreateTrigger()
local integer index=0
loop
call TriggerRegisterPlayerUnitEvent(trig,Player(index),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set index=index+1
exitwhen index==bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(trig,function Trig_AlbedoInt_Actions)
set trig=null
endfunction

