function BlackGokuQGAct takes nothing returns nothing

local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit Dummy=LoadUnitHandle(HH,id,20)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real damage=LoadReal(HH,id,15)
local real x1=LoadReal(HH,id,11)
local real y1=LoadReal(HH,id,12)
local real x0=GetUnitX(Dummy)
local real y0=GetUnitY(Dummy)
local real dist=LoadReal(HH,id,8)
local real rd=SR(x0,y0,x1,y1)


local real x2=PolX(x0,40,facing)
local real y2=PolY(y0,40,facing)

set time=time+0.02
call SaveReal(HH,id,5,time)




 



if time>1 and rd<=50 or time==6 or IsTerrainPathable(x2,y2,PATHING_TYPE_FLYABILITY)==true  then 
call EffectCreateAndMove(true,"BlackGoku\\CarolAFBTohka-R.mdl",facing,1.5,1.5,1.5,100,100,100,0,0,Dummy,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\WindCircleFaster.mdl",facing,1.5,2,1,100,100,100,0,0,Dummy,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\az_siwen2.mdl",facing,1.5,1.5,0.6,100,100,100,30,0,Dummy,0,facing)

set soundplay=CreateSound("Sound\\Music\\mp3Music\\SoundJap\\BlackGokuQG2.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)

call GroupClear(G)
call GroupEnumUnitsInRange(G,x0,y0,500,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if Condition_Base(GetOwningPlayer(caster),n0) then

call myCustomDamage(caster,n0,damage,false,false,null,null,null)

endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
call UnitColor(LoadUnitHandle(HH,id,20),0,0,0,100)
call MyRemoveUnit(LoadUnitHandle(HH,id,20),3)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else
if time==0.02 then
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\SoundEng\\BlackGokuQG1-1eng.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)

else

set soundplay=CreateSound("Sound\\Music\\mp3Music\\SoundJap\\BlackGokuQG1-1.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)


endif
call UnitSpeed(caster,0.4)
call SetUnitAnimationByIndex(caster,46)
call UnitAddAbility(caster,'Amrf')
call UnitRemoveAbility(caster,'Amrf')
call SetUnitFlyHeight(caster,600,0)
call EffectCreateAndMove(true,"BlackGoku\\tohkaenergy.mdl",facing,1.5,0.75,1,100,100,100,0,0,caster,0,facing)
endif
if time==0.5 then
