call EffectCreateAndMove(true,"BlackGoku\\WindNewFaw4.mdl",facing,1,1,0.5,100,100,100,40,-GetUnitFlyHeight(caster),caster,0,facing)
call EffectCreateAndMove(true,"BlackGoku\\HakenSaber22.mdl",facing,1,1,0.5,100,100,100,40,-GetUnitFlyHeight(caster),caster,0,facing)
endif
