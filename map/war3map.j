function HramCond takes nothing returns boolean
return GetSpellAbilityId()=='A1B5' and udg_B
endfunction
function HramCast7 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=LoadReal(h,id,7)
local real y=LoadReal(h,id,8)
local real x1=0
local real y1=0
local integer idu=GetHandleId(u)
local real dist=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,12)
local group g2=LoadGroupHandle(h,id,6)
local group g3=LoadGroupHandle(h,id,17)
local group g4
if dist<20 then
call SaveReal(h,id,2,dist+0.1)
if udg_B==false or (DU==false and u!=fi[1]and u!=fi[2]) then
call SaveReal(h,id,2,25)
endif
set g4=CopyGroup(g3)
loop
set E=FirstOfGroup(g4)
set x1=GetUnitX(E)
set y1=GetUnitY(E)
exitwhen E==null
if SR(x,y,x1,y1)>2000 then
call SetUnitState(E,UNIT_STATE_LIFE,GetWidgetLife(E)-GetWidgetLife(E)*0.002)
else
call SetUnitState(E,UNIT_STATE_MANA,GetUnitState(E,UNIT_STATE_MANA)-GetUnitState(E,UNIT_STATE_MANA)*0.002)
endif
call GroupRemoveUnit(g4,E)
endloop
call DestroyGroupTimed(g4,3)
call GroupEnumUnitsInRange(G,x,y,2000,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if IsUnitAlly(E,p)then
call HealTextTag(u,E,  0.001*GetUnitState(E,UNIT_STATE_MAX_LIFE)*myCustomHeal2(E,1),"HealthRes")
call HealTextTag(u,E,  0.001*GetUnitState(E,UNIT_STATE_MAX_MANA)*myCustomMana2(E,1),"ManaRes")
call SetUnitState(E,UNIT_STATE_LIFE,GetWidgetLife(E)+0.001*GetUnitState(E,UNIT_STATE_MAX_LIFE))
call SetUnitState(E,UNIT_STATE_MANA,GetWidgetMana(E)+0.001*GetUnitState(E,UNIT_STATE_MAX_MANA))
endif
call GroupRemoveUnit(G,E)
endloop
else
call ForGroup(g,function KillGroup)
call ForGroup(g2,function KillGroup)
call DestroyGroup(g)
call DestroyGroup(g2)
call DestroyGroup(g3)
call RemoveSavedReal(h,idu,SH_hramx)
call RemoveSavedReal(h,idu,SH_hramy)
call RemoveSavedHandle(h,idu,SH_hramd)
call SaveBoolean(h,idu,SH_hramb,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set g2=null
set g3=null
set g4=null
set u=null
set p=null
set t=null
endfunction
function HramCast6 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(HH,GetHandleId(u),SH_tama)
local real x1=0
local real y1=0
local real x=LoadReal(h,id,7)
local real y=LoadReal(h,id,8)
local real a=0
local integer ra=0
local real dmg=GetHeroInt(u,true)*(3.5+(GetUnitAbilityLevel(u,'A1B5')*0.5))*0.25
local player p=GetOwningPlayer(u)
local real time=LoadReal(h,id,2)
if time<2 then
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DevourMagic\\DevourMagicBirthMissile.mdl",u,"right hand"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DevourMagic\\DevourMagicBirthMissile.mdl",u,"left hand"))
set n=CreateUnit(p,'e10Z',x,y,GetRandomReal(0,359))
call SetUnitFlyHeight(n,0,0)
call UnitApplyTimedLife(n,'BTLF',1)
set n=CreateUnit(p,'e10Y',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,255,255,25)
call SetUnitTimeScale(n,0.5)
call SetUnitFlyHeight(n,50,0)
call SetUnitScale(n,3.5,3.5,3.5)
call UnitApplyTimedLife(n,'BTLF',1)
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,75,155,40)
call SetUnitScale(n,5.5,5.5,5.5)
call SetUnitTimeScale(n,0.5)
call SetUnitFlyHeight(n,150,0)
call UnitApplyTimedLife(n,'BTLF',2)
set n=CreateUnit(p,'e0ZP',x,y,GetRandomReal(0,359))
call SetUnitVertexColor(n,255,75,155,30)
call SetUnitScale(n,6,6,6)
call SetUnitTimeScale(n,0.5)
call SetUnitFlyHeight(n,150,0)
call UnitApplyTimedLife(n,'BTLF',2)
set ra=GetRandomInt(1,30)
set x1=x+1000*Cos(0.215*ra)
set y1=y+1000*Sin(0.215*ra)
set n=CreateUnit(p,'e10X',x1,y1,Atan2(y-y1,x-x1)*bj_RADTODEG)
call SetUnitVertexColor(n,255,25,125,255)
call SetUnitScale(n,0.75,0.75,0.75)
call SetUnitTimeScale(n,0.5)
call UnitApplyTimedLife(n,'BTLF',2)
set ra=GetRandomInt(1,30)
set x1=x+1000*Cos(0.215*ra)
set y1=y+1000*Sin(0.215*ra)
set n=CreateUnit(p,'e10X',x1,y1,Atan2(y-y1,x-x1)*bj_RADTODEG)
call SetUnitVertexColor(n,255,25,125,255)
call SetUnitScale(n,0.75,0.75,0.75)
call SetUnitTimeScale(n,0.5)
call UnitApplyTimedLife(n,'BTLF',2)
set x1=x+1000*Cos(0.215*ra)
set y1=y+1000*Sin(0.215*ra)
set n=CreateUnit(p,'e10X',x1,y1,Atan2(y-y1,x-x1)*bj_RADTODEG)
call SetUnitVertexColor(n,255,25,125,255)
call SetUnitScale(n,0.75,0.75,0.75)
call SetUnitTimeScale(n,0.5)
call UnitApplyTimedLife(n,'BTLF',2)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\RoaSet.mdx",l__d,"origin"))
call GroupEnumUnitsInRange(G,x,y,1000,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\OrbOfDeath\\AnnihilationMissile.mdl",E,"chest"))
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(G,E)
endloop
call SaveReal(h,id,2,time+0.25)
else
set bj_lastCreatedGroup=CreateGroup()
call GroupEnumUnitsInRange(G,x,y,2000,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call GroupAddUnit(bj_lastCreatedGroup,E)
endif
call GroupRemoveUnit(G,E)
endloop
call SaveGroupHandle(h,id,17,bj_lastCreatedGroup)
call PauseTimer(t)
call PauseUnit(u,false)
call SaveReal(h,id,2,0)
call SetUnitFlyHeight(u,0,750)
call SetUnitFlyHeight(l__d,25,750)
call SetUnitInvulnerable(u,false)
call UnitRemoveAbility(l__d,'A1AV')
call UnitRemoveAbility(u,'A0QL')
call UnitAddAbility(l__d,'A0A1')
call CreateModeIndicatorForm(u, "ReplaceableTextures\\CommandButtons\\BTNTama4.blp", 20)
if GetUnitAbilityLevel(u,'A1B6')>0 then
    if GetUnitAbilityLevel(u,'A0IH')>0 then
        call StartAbilityCooldown(GetUnitAbility(u, 'A1B6'), 30)
    else
        call StartAbilityCooldown(GetUnitAbility(u, 'A1B6'), 3)
    endif
endif
call TimerStart(t,0.1,true,function HramCast7)
endif
set l__d=null
set u=null
set p=null
set t=null
endfunction
