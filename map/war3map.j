                                set cjlocgn_00000003=LoadReal(HH,id,3)-GetRandomInt(15,30)
                        else
                                set cjlocgn_00000002=LoadReal(HH,id,3)+90
                                set cjlocgn_00000003=LoadReal(HH,id,3)+GetRandomInt(15,30)
                        endif
                        set EFF=AddSpecialEffect("war3mapImported\\AZ_Jugg_E1.mdl",GetUnitX(c),GetUnitY(c))
