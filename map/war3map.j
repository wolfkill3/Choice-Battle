function CycloneStartCond takes nothing returns boolean
return GetBuffTypeId(GetTriggerBuff())=='cbc9'
endfunction
function CycloneStartCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local effect EffT=LoadEffectHandle(HH,id,1)
if GetUnitAbilityLevel(u,'cbc9')>0 then
    call UnitAddAbility(u,'Avul')
    call SetUnitFacingInstant(u,GetUnitFacing(u)+15)
    call SetSpecialEffectScale(EffT,0.6)
    call SetSpecialEffectX(EffT,x)
    call SetSpecialEffectY(EffT,y)
    call SetSpecialEffectZ(EffT,GetUnitZ(u)-200)
else
    call UnitRemoveAbility(u,'Avul')
    call SetUnitZ(u,GetUnitZ(u)-200)
    call ResetUnitZ(u)
    call RemoveEffect(EffT,0,false,CreateTimer())
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(HH,id)
endif
set t=null
set u=null
set EffT=null
endfunction
