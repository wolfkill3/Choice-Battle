function MashStartCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(HH,id,1)
local player p=GetOwningPlayer(l__d)
local integer idu=GetPlayerId(p)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local integer lvl=GetUnitAbilityLevel(Hero[idu],'A0X8')
local real dmg=1.75*GetHeroAgi(Hero[idu],true)+lvl*0.25*GetHeroAgi(Hero[idu],true)
if UnitIsAlive(l__d) and udg_B and DU2 then
call GroupEnumUnitsInRange(G,x,y,150,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call KillUnit(l__d)
endif
call GroupRemoveUnit(G,E)
endloop
else
if udg_B==false or DU2==false then
call KillUnit(l__d)
else
call GroupEnumUnitsInRange(G,x,y,350,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call SlowUnit(Hero[idu],E,0.2+lvl*0.05,0,4,0,false)
if lvl==5 then
call CC_UnitEx( E,E , 0., 1, "root", false, "Abilities\\Weapons\\ChimaeraAcidMissile\\ChimaeraAcidMissile.mdl", "chest", 0,0 )
endif
call myCustomDamage(Hero[idu],E,GetHeroAgi(Hero[idu],true),false,false,null,null,null)
call MashDamage(Hero[idu],E,dmg,4,"Environment\\LargeBuildingFire\\LargeBuildingFire1.mdl","origin")
endif
call GroupRemoveUnit(G,E)
endloop
endif
call DestroyEffect(AddSpecialEffect("war3mapImported\\Acid Ex.mdx",x,y))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set p=null
set t=null
    set l__d=null
endfunction
