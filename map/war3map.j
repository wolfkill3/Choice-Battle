function ChargeShotCond takes nothing returns boolean
return GetSpellAbilityId()=='A0DJ'
endfunction
function ChargeShotCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local integer level=LoadInteger(h,id,0)
local unit u=LoadUnitHandle(h,id,1)
local player p=GetOwningPlayer(u)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local real a=LoadReal(h,id,5)
local real dist=LoadReal(h,id,StringHash("dist"))
local real dmg=(GetUnitAbilityLevel(u,'A0DJ')+3)*GetHeroStr(u,true)
local group g=LoadGroupHandle(h,id,10)
local integer i=6
local real f=0
local real dur=LoadReal(h,id,4)+0.03
local integer l__idg=GetHandleId(g)
local real x1
local real y1
call SaveReal(h,id,4,dur)
if dur==0.03 then
call SetUnitTimeScale(u,2.3)
call SetUnitAnimationByIndex(u,4) 
endif
if dur==0.3 then
    set soundplay=CreateSound("Sound\\Music\\mp3Music\\EffectEE.mp3",false,false,true,12700,12700,"")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    if GetUnitTypeId(u)=='H01N' then
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\DanteEE.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
    elseif GetUnitTypeId(u)=='H21N' then
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\DTDanteEE.mp3",false,false,true,12700,12700,"")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
    endif
    call SaveUnitHandle(h,id,6,CreateUnit(p,'e1K8',x+80*Cos(a*bj_DEGTORAD),y+80*Sin(a*bj_DEGTORAD),a))
    call SaveUnitHandle(h,id,7,CreateUnit(p,'e1K8',x+80*Cos((a+10)*bj_DEGTORAD),y+80*Sin((a+10)*bj_DEGTORAD),a+10))
    call SaveUnitHandle(h,id,8,CreateUnit(p,'e1K8',x+80*Cos((a-10)*bj_DEGTORAD),y+80*Sin((a-10)*bj_DEGTORAD),a-10))
    call PauseUnit(u,false)
    call SetUnitTimeScale(u,1)
elseif dur>0.3 then
if GetUnitAbilityLevel(u,'A28U')>0 then
    set dmg=dmg+dmg*.1
endif
loop
    set n=LoadUnitHandle(h,id,i)
    set f=GetUnitFacing(n)*bj_DEGTORAD
    set x1=GetUnitX(n)
    set y1=GetUnitY(n)
    exitwhen i>=9
    if dist<=1300 then
        set x1=x1+100*Cos(f)
        set y1=y1+100*Sin(f)
        call SetUnitX(n,x1)
        call SetUnitY(n,y1)
        if i==6 then
        set n=CreateUnit(p,'e1K8',x1+GetRandomReal(-150,150)*(dist / 300)*Cos(GetRandomReal(0,359)*bj_DEGTORAD),y1+GetRandomReal(-150,150)*(dist / 300)*Sin(GetRandomReal(0,359)*bj_DEGTORAD),GetRandomReal(0,359))
        call UnitApplyTimedLife(n,1,0.4)
        set n=CreateUnit(p,'e1K8',x1+GetRandomReal(-150,150)*(dist / 300)*Cos(GetRandomReal(0,359)*bj_DEGTORAD),y1+GetRandomReal(-150,150)*(dist / 300)*Sin(GetRandomReal(0,359)*bj_DEGTORAD),GetRandomReal(0,359))
        call UnitApplyTimedLife(n,1,0.4)
        set n=CreateUnit(p,'e1K8',x1+GetRandomReal(-150,150)*(dist / 300)*Cos(GetRandomReal(0,359)*bj_DEGTORAD),y1+GetRandomReal(-150,150)*(dist / 300)*Sin(GetRandomReal(0,359)*bj_DEGTORAD),GetRandomReal(0,359))
        call UnitApplyTimedLife(n,1,0.4)         
        endif
        call GroupEnumUnitsInRange(g,x1,y1,200,Base)
        loop
            set E=FirstOfGroup(g)
            set ide=GetHandleId(E)
            exitwhen E==null
            if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,ide)then
                call myCustomDamage(u,E,dmg,false,false,null,null,null)
                call Push3(E,60,f,600,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
                call SaveUnitHandle(h,l__idg,ide,E)
            endif
            call GroupRemoveUnit(g,E)
        endloop
    else
        call AddUnitAnimationProperties(u,"alternate",true)
        call RemoveUnit(LoadUnitHandle(h,id,6))
        call RemoveUnit(LoadUnitHandle(h,id,7))
        call RemoveUnit(LoadUnitHandle(h,id,8))
        call FlushChildHashtable(h,id)
        call FlushChildHashtable(h,l__idg)
        call DestroyTimer(t)
        call DestroyGroup(g)
    endif
    set i=i+1
endloop
call SaveReal(h,id,StringHash("dist"),dist+100)
endif
set p=null
set g=null
set t=null
set u=null
endfunction
function ChargeShotCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1
local real y1
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real i=1
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)*bj_RADTODEG
// if GetUnitAbilityLevel(u,'A28U')>0 and GetUnitState(u,UNIT_STATE_LIFE)<=GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.25 then
// set dmg=dmg+dmg*.2
// else
call PauseUnit(u,true)
call SaveUnitHandle(h,id,1,u)
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveReal(h,id,5,a)
call SaveGroupHandle(h,id,10,CreateGroup())
call TimerStart(t,0.03,true,function ChargeShotCast2)
set u=null
set t=null
