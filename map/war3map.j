call SetUnitAbilityLevel(u,LSP[ip],R2I(GetHeroAgi(u,true)/25))
endif
if l__Q+l__Q+l__E==id then
set LSP2[ip]=LSP[ip]
set LSP[ip]='A11X'
call SetPlayerAbilityAvailable(p,LSP[ip],true)
endif
if l__W+l__W+l__W==id then
set LSP2[ip]=LSP[ip]
set LSP[ip]='A11O'
call SetPlayerAbilityAvailable(p,LSP[ip],true)
endif
if l__W+l__W+l__Q==id then
set LSP2[ip]=LSP[ip]
set LSP[ip]='A11M'
call SetPlayerAbilityAvailable(p,LSP[ip],true)
endif
if l__W+l__W+l__E==id then
set LSP2[ip]=LSP[ip]
set LSP[ip]='A11L'
call SetPlayerAbilityAvailable(p,LSP[ip],true)
endif
if l__E+l__E+l__E==id then
set LSP2[ip]=LSP[ip]
set LSP[ip]='A11V'
call SetPlayerAbilityAvailable(p,LSP[ip],true)
endif
if l__E+l__E+l__W==id then
set LSP2[ip]=LSP[ip]
set LSP[ip]='A11S'
call SetPlayerAbilityAvailable(p,LSP[ip],true)
endif
if l__E+l__E+l__Q==id then
set LSP2[ip]=LSP[ip]
set LSP[ip]='A11Y'
call SetPlayerAbilityAvailable(p,LSP[ip],true)
endif
if l__Q+l__W+l__E==id then
set LSP2[ip]=LSP[ip]
set LSP[ip]='A11N'
call SetPlayerAbilityAvailable(p,LSP[ip],true)
endif
