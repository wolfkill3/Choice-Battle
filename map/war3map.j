        call SetUnitAnimationByIndex(newCaster, 10)
        call SaveUnitHandle(h, id, c_CASTER, newCaster)
        call TimerStart(newTimer, 0.01, true, function RengokuF_Periodic)
    else
        call IssueImmediateOrder(newCaster, "stop")
