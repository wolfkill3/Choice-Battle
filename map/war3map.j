endfunction
function SabracHeroDieCond takes nothing returns boolean
return   LoadBoolean(HH,GetHandleId( Hero[ GetPlayerId( GetOwningPlayer( GetTriggerUnit() )  )  ] ), SH_SabracKillme ) ==false and GetOwningPlayer( GetTriggerUnit() )!= Player(14) and IsUnitIllusion( GetTriggerUnit() )==false and GetUnitAbilityLevel(GetTriggerUnit(),'A1EA')>0 and    sabrac!=GetKillingUnit() and  sabrac!=GetTriggerUnit() and IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO) and UnitIsAlive(sabrac) and GetUnitTypeId(GetTriggerUnit())!='HSaC' and GetUnitTypeId(GetTriggerUnit())!='HASC' and GetUnitTypeId(GetTriggerUnit())!='HAST'
endfunction
function InitTrig_SabracHeroDie takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function SabracHeroDieCond))
call TriggerAddAction(t,function Trig_SabracHeroDie_Actions)
set t=null
endfunction


