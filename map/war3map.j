call TriggerRegisterAnyUnitEventBJ(gg_trg_RulerF,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_RulerF,Condition(function Trig_RulerF_Conditions))
call TriggerAddAction(gg_trg_RulerF,function Trig_RulerF_Actions)
endfunction
function WRulerCond takes nothing returns boolean
return GetSpellAbilityId()=='A1HN'
endfunction
function WRulerCast4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real dmg=GetHeroInt(u,true)*(1+GetUnitAbilityLevel(u,'A1HN'))+50
local real x=0
local real y=0
local real x1=LoadReal(h,id,1)
local real y1=LoadReal(h,id,2)
local real a=Atan2(y1-y,x1-x)
local group g=LoadGroupHandle(h,id,4)
local group g2
local real dist=LoadReal(h,id,3)-50
if dist>0 then
set g2=CopyGroup(g)
loop
set E=FirstOfGroup(g2)
exitwhen E==null
call SetUnitFlyHeight(E,GetUnitFlyHeight(E)-50,0)
call GroupRemoveUnit(g2,E)
endloop
call DestroyGroupTimed(g2,3)
call SaveReal(h,id,3,dist)
else
loop
set E=FirstOfGroup(g)
set x=GetUnitX(E)
set y=GetUnitY(E)
exitwhen E==null
call SetUnitFlyHeight(E,0,GetUnitFlyHeight(E))
call PauseUnit(E,false)
call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,false)
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call DestroyEffect(AddSpecialEffect("war3mapImported\\WarStompCaster.mdx",x,y))
call DestroyEffect(AddSpecialEffect("war3mapImported\\SandPoff.mdx",x,y))
call DestroyEffect(AddSpecialEffect("war3mapImported\\Slam.mdx",x,y))
call GroupRemoveUnit(g,E)
endloop
call GroupClear(g)
call DestroyGroup(g)
call PauseTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set g2=null
set t=null
set u=null
endfunction
function WRulerCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
