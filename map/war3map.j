function TScatachCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local real sc=0
local real is=0
local real ig=30*bj_DEGTORAD
call ShowUnit(u,false)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call UnitAddAbility(c,'Arav')
call UnitRemoveAbility(c,'Arav')
set n=CreateUnit(p,'e154',x,y,a*bj_RADTODEG)
call SetUnitModel(n,GetUnitModel(u))
call SaveUnitHandle(h,id,2,n)
call UnitAddAbility(n,'A1F7')
call SetUnitAnimation(n,"Spell Four")
loop
exitwhen is>=13
set n=CreateUnit(p,'e0ZH',x+150*Cos(ig*is),y+150*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,255,255,255,55)
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,1.2)
set is=is+1
endloop
set n=CreateUnit(p,'e0RV',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,0.7)
call SetUnitVertexColor(n,255,255,255,125)
call SaveReal(h,id,7,0)
call SaveReal(h,id,8,0)
call SaveReal(h,id,9,1)
call SaveReal(h,id,3,a)
set soundplay=SndN(2845) // Sound\Music\mp3Music\Scathach5.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.5,true,function TScatachCast12)
set c=null
set p=null
set u=null
set t=null
endfunction
function InitTrig_TScatach takes nothing returns nothing
set gg_trg_TScatach=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_TScatach,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_TScatach,Condition(function TScatachCond))
call TriggerAddAction(gg_trg_TScatach,function TScatachCast)
endfunction
function RScatachCond takes nothing returns boolean
return GetSpellAbilityId()=='A1FF'
endfunction
function RScatachMissles2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real f=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,5)
local real y1=LoadReal(h,id,6)
local real a=Atan2(y1-y,x1-x)
local real sr=SR(x,y,x1,y1)
local real fl=sr/LoadReal(h,id,7)
local real dist=LoadReal(h,id,3)
if SR(x,y,x1,y1)>100 and l__d!=null then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,f*fl,0)
else
call SetUnitFlyHeight(l__d,50,0)
call UnitRemoveAbility(l__d,'A1DB')
call UnitApplyTimedLife(l__d,'BTLF',LoadReal(h,id,8))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set t=null
endfunction
function RScatachMissles takes unit l__d,real speed,real a,real x,real y,real time returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,GetUnitFlyHeight(l__d))
call SaveReal(h,id,3,GetUnitX(l__d))
call SaveReal(h,id,4,GetUnitY(l__d))
call SaveReal(h,id,5,x)
call SaveReal(h,id,6,y)
call SaveReal(h,id,7,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,8,time)
call TimerStart(t,0.014,true,function RScatachMissles2)
set t=null
endfunction
function RScatachCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real dmg=GetHeroAgi(u,true)*(5+GetUnitAbilityLevel(u,'A1FF'))*0.1
local unit l__d=LoadUnitHandle(h,id,9)
local real x=LoadReal(h,id,6)
local real y=LoadReal(h,id,7)
local real x1=LoadReal(h,id,4)
local real y1=LoadReal(h,id,5)
local real x2=0
local real y2=0
local real sr2=0
local real a=LoadReal(h,id,3)
local real dist=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
local integer i=0
if dist<0.5 then
call SaveReal(h,id,2,dist+0.05)
loop
exitwhen i>=10
set x2=x1+GetRandomReal(-500,500)*Cos(GetRandomReal(0,6.28))
set y2=y1+GetRandomReal(-500,500)*Sin(GetRandomReal(0,6.28))
set sr2=SR(x2,y2,x,y)
set n=CreateUnit(p,'e155',x+100*Cos(a),y+100*Sin(a),a*bj_RADTODEG)
call SetUnitFlyHeight(n,1000+sr2/4,0)
call SetUnitTimeScale(n,2.5)
call RScatachMissles(n,GetRandomReal(1,25)+sr2*0.025,a,x2,y2,1.5-dist)
set i=i+1
endloop
call GroupEnumUnitsInRange(G,x1,y1,600,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call EffectToRandomBone("war3mapImported\\SlashEffectRed by Deckai.mdx",E)
call SetUnitAnimation(E,"death")
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(G,E)
endloop
else
call UnitRemoveAbility(u,'A1F8')
call ShowUnit(u,true)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call SetUnitTimeScale(l__d,1)
call RemoveUnit(l__d)
if GetLocalPlayer()==p then
call ClearSelection()
call SelectUnit(u,true)
endif
call SetUnitTimeScale(u,1)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set u=null
set p=null
set t=null
endfunction
function RScatachCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,9)
local real dist=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
call PauseTimer(t)
call SetUnitTimeScale(l__d,0.1)
call TimerStart(t,0.10,true,function RScatachCast3)
set u=null
set p=null
set t=null
set l__d=null
endfunction
function RScatachCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local real sc=0
local real is=0
local real ig=30*bj_DEGTORAD
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,0)
call SaveReal(h,id,3,a)
call SaveReal(h,id,4,x1)
call SaveReal(h,id,5,y1)
call SaveReal(h,id,6,x)
call SaveReal(h,id,7,y)
call PauseUnit(u,true)
call ShowUnit(u,false)
call SetUnitInvulnerable(u,true)
set n=CreateUnit(p,'e154',x,y,a*bj_RADTODEG)
call SetUnitModel(n,GetUnitModel(u))
call SetUnitAnimation(n,"spell slam")
call SetUnitTimeScale(n,1.25)
call SaveUnitHandle(h,id,9,n)
call SetUnitFlyHeight(n,600,1200)
loop
exitwhen is>=13
set n=CreateUnit(p,'e0ZH',x+150*Cos(ig*is),y+150*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,255,255,255,55)
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,1.2)
set is=is+1
endloop
set n=CreateUnit(p,'e0RV',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,0.7)
call SetUnitVertexColor(n,255,255,255,125)
call ShakeCamera(3.5,15)
set soundplay=SndN(2847) // Sound\Music\mp3Music\Scathach4.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,1,false,function RScatachCast2)
set u=null
set p=null
set t=null
endfunction
