function Ini_effects_random_Act takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())

local integer time=LoadInteger(HH,id,5)

set time=time+1
call SaveInteger(HH,id,5,time)


if time==1 then
call Effect_Ini_1()
endif

if time==2 then
call Effect_Ini_2()
endif

if time==3 then
call Effect_Ini_3()
endif

if time==4 then
call Effect_Ini_4()
endif


if time==5 then
call Effect_Ini_5()
endif



if time>=5 then

call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif

endfunction
function Ini_effects_random takes nothing returns nothing
local timer t=CreateTimer()
call TimerStart(t,1,true,function Ini_effects_random_Act)
set t=null
endfunction

function Trig_mult_Actions takes nothing returns nothing
local multiboarditem mbitem
local integer y=0
local integer x=0
loop
exitwhen x>=10
if GetPlayerSlotState(Player(x))==PLAYER_SLOT_STATE_PLAYING then
call ShowFrame( OpenStatusButton, false )
set nick[x]=udg_Color[x+1]+GetPlayerName(Player(x))+"["+I2S(x+1)+"]"
set y=y+1
set row[x]=y
set udg_lvl[x]=1
set ingame[x]=true
set row[11]=y+1
set row[12]=y+2
set row[13]=y+3
set row[14]=y+4
endif
set x=x+1
endloop
set mbg=CreateMultiboard()
call MultiboardSetTitleText(mbg,"|cffc3dbffRound|r - 1, |cffc3dbffTime -|r "+I2S(ours)+":"+I2S(minutes)+":"+I2S(seconds))
call MultiboardSetRowCount(mbg,y+5)
call MultiboardSetColumnCount(mbg,8)
set mbitem=MultiboardGetItem(mbg,0,0)
call MultiboardSetItemValue(mbitem,"|cFF37FB04Players")
call MultiboardSetItemStyle(mbitem,true,true)
call MultiboardSetItemWidth(mbitem,.1)
call MultiboardSetItemIcon(mbitem,"ReplaceableTextures\\WorldEditUI\\Editor-MultipleUnits.blp")
call MultiboardReleaseItem(mbitem)
set mbitem=MultiboardGetItem(mbg,0,1)
call MultiboardSetItemValue(mbitem,"|cFFFF004DK")
call MultiboardSetItemStyle(mbitem,true,false)
call MultiboardSetItemWidth(mbitem,.02)
call MultiboardReleaseItem(mbitem)
set mbitem=MultiboardGetItem(mbg,0,2)
call MultiboardSetItemValue(mbitem,"|cFFFF3200D")
call MultiboardSetItemStyle(mbitem,true,false)
call MultiboardSetItemWidth(mbitem,.02)
call MultiboardReleaseItem(mbitem)
set mbitem=MultiboardGetItem(mbg,0,3)
call MultiboardSetItemValue(mbitem,"|c00FFFFA8A")
call MultiboardSetItemStyle(mbitem,true,false)
call MultiboardSetItemWidth(mbitem,.03)
call MultiboardReleaseItem(mbitem)
set mbitem=MultiboardGetItem(mbg,0,4)
call MultiboardSetItemValue(mbitem,"|cffffcc00L")
call MultiboardSetItemStyle(mbitem,true,false)
call MultiboardSetItemWidth(mbitem,.02)
call MultiboardReleaseItem(mbitem)
set mbitem=MultiboardGetItem(mbg,0,5)
call MultiboardSetItemValue(mbitem,"|cffffcc00W")
call MultiboardSetItemStyle(mbitem,true,false)
call MultiboardSetItemWidth(mbitem,.02)
call MultiboardReleaseItem(mbitem)
set mbitem=MultiboardGetItem(mbg,0,6)
call MultiboardSetItemValue(mbitem,"|cFFFF6CFFRepicks")
call MultiboardSetItemStyle(mbitem,true,false)
call MultiboardSetItemWidth(mbitem,.040)
call MultiboardReleaseItem(mbitem)
set mbitem=MultiboardGetItem(mbg,0,7)
call MultiboardSetItemValue(mbitem,"|cFFFF004DStreak") //streak
call MultiboardSetItemStyle(mbitem,true,false)
call MultiboardSetItemWidth(mbitem,.035)
call MultiboardReleaseItem(mbitem)
set x=0
loop
exitwhen x>=10
if GetPlayerSlotState(Player(x))==PLAYER_SLOT_STATE_PLAYING then
set mbitem=MultiboardGetItem(mbg,row[x],0)
call MultiboardSetItemIcon(mbitem,"UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp")
call MultiboardSetItemValue(mbitem,nick[x])
call MultiboardSetItemStyle(mbitem,true,true)
call MultiboardSetItemWidth(mbitem,.1)
call MultiboardReleaseItem(mbitem)
set mbitem=MultiboardGetItem(mbg,row[x],1)
call MultiboardSetItemStyle(mbitem,true,false)
call MultiboardSetItemValue(mbitem,I2S(udg_kill[x]))
call MultiboardSetItemWidth(mbitem,.02)
call MultiboardReleaseItem(mbitem)
set mbitem=MultiboardGetItem(mbg,row[x],2)
call MultiboardSetItemStyle(mbitem,true,false)
call MultiboardSetItemValue(mbitem,I2S(udg_death[x]))
call MultiboardSetItemWidth(mbitem,.02)
call MultiboardReleaseItem(mbitem)
set mbitem=MultiboardGetItem(mbg,row[x],3)
call MultiboardSetItemStyle(mbitem,true,false)
call MultiboardSetItemValue(mbitem,I2S(udg_assist[x]))
call MultiboardSetItemWidth(mbitem,.03)
call MultiboardReleaseItem(mbitem)
set mbitem=MultiboardGetItem(mbg,row[x],4)
call MultiboardSetItemStyle(mbitem,true,false)
call MultiboardSetItemValue(mbitem,I2S(GetHeroLevel(udg_Hero[x+1])))
call MultiboardSetItemWidth(mbitem,.02)
call MultiboardReleaseItem(mbitem)
set mbitem=MultiboardGetItem(mbg,row[x],5)
call MultiboardSetItemStyle(mbitem,true,false)
call MultiboardSetItemValue(mbitem,I2S(GetPlayerState(Player(y),PLAYER_STATE_RESOURCE_LUMBER)))
call MultiboardSetItemWidth(mbitem,.02)
call MultiboardReleaseItem(mbitem)
set mbitem=MultiboardGetItem(mbg,row[x],6)
call MultiboardSetItemStyle(mbitem,true,false)
call MultiboardSetItemValue(mbitem,"0")
call MultiboardSetItemWidth(mbitem,.015)
call MultiboardReleaseItem(mbitem)
set mbitem=MultiboardGetItem(mbg,row[x],7) //streak
call MultiboardSetItemStyle(mbitem,true,false)
call MultiboardSetItemValue(mbitem,"0")
call MultiboardSetItemWidth(mbitem,.025)
call MultiboardReleaseItem(mbitem)
endif
set x=x+1
endloop
call MultiboardDisplay(mbg,true)
call MultiboardMinimize(mbg,true)
call MultiboardMinimize(mbg,false)
set mbitem=null
call UpdateMultiboard()

call Ini_effects_random()
endfunction
function InitTrig_mult takes nothing returns nothing
set gg_trg_mult=CreateTrigger()
call TriggerRegisterTimerEventSingle(gg_trg_mult,1.01)
call TriggerAddAction(gg_trg_mult,function Trig_mult_Actions)
endfunction
function BuuPassiveRegenCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,1)
local real life=LoadReal(h,id,0)
local real life2=GetWidgetLife(u)
local real dmg=0
if GetHeroLevel(u)>5 and GetWidgetLife(u)>0 and udg_B==true and DU2==true then
    if life2>life then
        set dmg=GetWidgetLife(u)-LoadReal(h,id,0)
        if LoadInteger(h,GetHandleId(u),HRHash)!=1 then
            call SaveReal(h,id,3,LoadReal(h,id,3)+(dmg*(0.049+(GetUnitState(u,UNIT_STATE_MANA) / GetUnitState(u,UNIT_STATE_MAX_MANA))*0.201)))
            call SetWidgetLife(u, GetWidgetLife(u)+MathRealFloor(dmg*(0.049+(GetUnitState(u,UNIT_STATE_MANA) / GetUnitState(u,UNIT_STATE_MAX_MANA))*0.201))+MathRealFloor(LoadReal(h,id,3)))
            if LoadReal(h,id,3)>1 then
                call SaveReal(h,id,3,LoadReal(h,id,3)-MathRealFloor(LoadReal(h,id,3)))
            endif
        endif
    endif
    call SaveReal(h,id,0,GetWidgetLife(u))
else
    call SaveInteger(HH,GetHandleId(u),SH_BuuPassive,0)
    call DestroyTimer(t)
    call FlushChildHashtable(h,id)
endif
set t=null
set u=null
endfunction
function BuuPassiveRegenCast takes unit u returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,1,u)
call SaveReal(h,id,0,GetWidgetLife(u))
call SaveInteger(HH,GetHandleId(u),SH_BuuPassive,1)
call TimerStart(t,0.01,true,function BuuPassiveRegenCast2)
set t=null
set u=null
endfunction
function MoriaDoppelCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,1)
local real life=LoadReal(h,id,0)
local real life2=GetWidgetLife(u)
local real dmg=0
if GetWidgetLife(u)>0 and udg_B==true and DU2==true then
    if life2>life then
        set dmg=GetWidgetLife(u)-LoadReal(h,id,0)
        call SaveReal(h,id,3,LoadReal(h,id,3)+(dmg*0.5))
        call SetWidgetLife(u, GetWidgetLife(u)+MathRealFloor(dmg*0.5)+MathRealFloor(LoadReal(h,id,3)))
        if LoadReal(h,id,3)>1 then
            call SaveReal(h,id,3,LoadReal(h,id,3)-MathRealFloor(LoadReal(h,id,3)))
        endif
    endif
    call SaveReal(h,id,0,GetWidgetLife(u))
else
    call SaveInteger(HH,GetHandleId(u),SH_MoriaDoppel,0)
    call DestroyTimer(t)
    call FlushChildHashtable(h,id)
endif
set t=null
set u=null
endfunction
