function SkyMareCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local real x=GetUnitX(c)
local real y=GetUnitY(c)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
if GetAbilityIntegerLevelField(GetUnitAbility(u,'A10Q'), ABILITY_ILF_TARGET_TYPE,0)==0 then
set c=u
set x=GetUnitX(u)
set y=GetUnitY(u)
endif
call SaveUnitHandle(h,id,1,c)
call SaveReal(h,id,2,2)
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlinkCaster.mdx",x,y))
call UnitRemoveAbility(c,'A0J4')
call UnitRemoveAbility(c,'A128')
call UnitRemoveAbility(c,'A15F')
call UnitRemoveAbility(c, 'cbc3')
call UnitRemoveAbility(c, 'cbc7')
call UnitRemoveAbility(c, 'CBC1')
call UnitRemoveAbility(c, 'CBC2')
call UnitRemoveAbility(c, 'A1VJ')
call UnitRemoveAbility(c, 'IHYs')
call UnitRemoveAbility(c, 'IOb3')
call UnitAddAbility(c,'CE04')
call UnitRemoveAbility(c, 'A2VJ')
call UnitRemoveAbility(c, 'AoSV')
call UnitRemoveAbility(c, 'A1SV')
// call SaveBoolean(h, GetHandleId(u), StringHash("GinT_Boolean"), false)
call HealTextTag(u,c,GetUnitState(c,UNIT_STATE_MAX_LIFE)*0.12*myCustomHeal2(c,1),"HealthRes")
call SetUnitState(c,UNIT_STATE_LIFE,GetWidgetLife(c)+GetUnitState(c,UNIT_STATE_MAX_LIFE)*0.12)
call TimerStart(t,0.1,true,function SkyMareCast2)
set t=null
set u=null
set c=null
endfunction
