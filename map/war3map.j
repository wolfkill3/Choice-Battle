endfunction
function Killself2Cast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real time=LoadReal(h,id,2)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real ms=0
local real mn=0
if UnitIsAlive(u)and udg_B==false then
call GroupEnumUnitsInRange(G,x,y,1000,Base)
call GroupRemoveUnit(G,u)
call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)-0.05*GetUnitState(u,UNIT_STATE_MAX_LIFE))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\IllidanMissile\\IllidanMissile.mdl",u,"chest"))
loop
set E=FirstOfGroup(G)
set ms=GetUnitState(E,UNIT_STATE_MAX_LIFE)
set mn=GetUnitState(E,UNIT_STATE_MAX_MANA)
exitwhen E==null
if IsUnitAlly(E,p)==false and IsUnitIllusion(E)==false and IsUnitType(E,UNIT_TYPE_HERO)then
call SetUnitState(E,UNIT_STATE_MANA,GetWidgetMana(E)-0.05*mn)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BluefireBolt.mdx",E,"chest"))
else
call SetUnitState(E,UNIT_STATE_LIFE,GetWidgetLife(E)+0.05*ms)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Unleash the power.mdx",E,"chest"))
endif
call GroupRemoveUnit(G,E)
endloop
else
call SetTerrainFogExBJ(0,6000.00,10000,0,1,1,1)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set t=null
set u=null
endfunction
function Killself2Cast takes nothing returns nothing // Сфера Крови
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real ms=0
local real mu=GetWidgetLife(u)
local player p=GetOwningPlayer(u)
local real heal=0.0
call GroupEnumUnitsInRange(G,x,y,1750,Base)
call GroupRemoveUnit(G,u)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x,y,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x,y,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x,y,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x,y,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x,y,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x,y,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x,y,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x,y,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x,y,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x,y,GetRandomReal(0,359)),1,1)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\IllidanMissile\\IllidanMissile.mdl",u,"chest"))
loop
set E=FirstOfGroup(G)
set ms=GetWidgetLife(E)
exitwhen E==null
if IsUnitAlly(E,p)==false and IsUnitIllusion(E)==false and IsUnitType(E,UNIT_TYPE_HERO)then
call SetUnitState(E,UNIT_STATE_LIFE,ms-0.08*ms)
set heal = heal + ms*0.08
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BluefireBolt.mdx",E,"chest"))
endif
call GroupRemoveUnit(G,E)
endloop
call HealTextTag(u,u,heal*myCustomHeal2(u,1),"HealthRes")
call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+heal)
set p=null
set u=null
endfunction
