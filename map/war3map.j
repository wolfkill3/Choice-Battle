function EnelE_FastCD_Periodic takes nothing returns nothing
        local integer id=GetHandleId(GetExpiredTimer())
        local unit caster=LoadUnitHandle(HH, id, 0)
        local real time=LoadReal(HH, id, 2)+0.01
        
        if UnitIsAlive(LoadUnitHandle(HH, id, 1))==false then
                call StartAbilityCooldown(GetUnitAbility(caster, 'A01V'), 0.1)
        endif
        
        if time>=0.5 or UnitIsAlive(LoadUnitHandle(HH, id, 1))==false or GetAbilityRemainingCooldown(GetUnitAbility(caster, 'A01V'))<5 then
                call FlushChildHashtable(HH, id)
                call PauseTimer(GetExpiredTimer())
                call DestroyTimer(GetExpiredTimer())
        endif
        set caster=null
endfunction

function EnelE_FastCD takes unit newCaster, unit newTarget returns nothing
        local timer newTimer=CreateTimer()
        local integer id = GetHandleId(newTimer)
        call SaveUnitHandle(HH, id, 0, newCaster)
        call SaveUnitHandle(HH, id, 1, newTarget)
        call SaveReal(HH, id, 2, 0.0)
        call TimerStart(newTimer, 0.01, true, function EnelE_FastCD_Periodic)
        set newTimer=null
endfunction

function Trig_M100_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local player p=GetOwningPlayer(u)
local integer i=0
local real dmg=(3+GetUnitAbilityLevel(u,'A01V'))*GetHeroInt(u,true)
call DestroyEffect(AddSpecialEffect("war3mapImported\\LightningWrath.mdx",x,y))
call DestroyEffect(AddSpecialEffect(" ",x,y))
call GroupEnumUnitsInRange(DG,x,y,400,Base)
call UnitApplyTimedLife(CreateUnit(p,'e087',x,y,GetRandomReal(0,359)),'BTLF',1)
loop
exitwhen i>=7
call UnitApplyTimedLife(CreateUnit(p,'e086',x,y,GetRandomReal(0,359)),'BTLF',1)
set n=CreateUnit(p,'e016',x,y,GetRandomReal(0,359))
call UnitAddAbility(n,'Arav')
call UnitApplyTimedLife(n,'BTLF',0.1)
set i=i+1
endloop
loop
set E=FirstOfGroup(DG)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(DG,E)
endloop
set soundplay=SndN(1569) // Sound\Music\mp3Music\100MVOLT.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SetUnitXY_1(u,x,y, false)
set u=null
set p=null
endfunction
function InitTrig_M100 takes nothing returns nothing
set gg_trg_M100=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_M100,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_M100,Condition(function Trig_M100_Conditions))
call TriggerAddAction(gg_trg_M100,function Trig_M100_Actions)
endfunction
function Trig_M60_Conditions takes nothing returns boolean
return GetSpellAbilityId()==0x41303155 and udg_B==true
endfunction
function Trig_M60_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local unit c=LoadUnitHandle(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real l__s=LoadReal(h,id,6)
local real a2=LoadReal(h,id,7)
local real a=Atan2(y1-y,x1-x)+a2
local real f=GetUnitFacing(u)
local player p=GetOwningPlayer(u)
local integer i=0
if(SR(x,y,x1,y1)>50.00 and GetWidgetLife(c)>0.5)then
set x=x+50*Cos(a)
set y=y+50*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SaveReal(h,id,6,l__s+0.035)
if l__s>0.4 then
call SaveReal(h,id,6,0)
call SaveReal(h,id,7,a2*(-1))
endif
set n=CreateUnit(p,'e013',x,y,GetRandomReal(0,359))
call UnitAddAbility(n,'Arav')
call SetUnitTimeScale(n,2.5)
call UnitApplyTimedLife(n,'BTLF',0.5)
call SetUnitFacing(l__d,a*bj_RADTODEG)
else
call UnitApplyTimedLife(CreateUnit(p,'e087',x1,y1,GetRandomReal(0,359)),'BTLF',1)
loop
exitwhen i>=7
call UnitApplyTimedLife(CreateUnit(p,'e086',x1,y1,GetRandomReal(0,359)),'BTLF',1)
set n=CreateUnit(p,'e016',x,y,GetRandomReal(0,359))
call UnitAddAbility(n,'Arav')
call UnitApplyTimedLife(n,'BTLF',0.1)
set i=i+1
endloop
set soundplay=SndN(1437) // Sound\Music\mp3Music\LightningExplode.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call myCustomDamage(u,c,(2+GetUnitAbilityLevel(u,0x41303155))*GetHeroInt(u,true),false,false,null,null,null)
call SetControlToUnit(u,c,2, "stun")
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
endif
set p=null
set u=null
set l__d=null
set t=null
set c=null
endfunction
