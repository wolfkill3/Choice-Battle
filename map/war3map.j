call RemoveUnit(n)
set n=LoadUnitHandle(HH,id,3)
call RemoveUnit(n)
set n=LoadUnitHandle(HH,id,4)
call RemoveUnit(n)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set u=null
set p=null
set t=null
endfunction
function FrostArrowsLearnCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local integer lvl=GetUnitAbilityLevel(u,'A1B1')
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=GetUnitFacing(u)*bj_DEGTORAD
local real f=bj_PI/2
local player p=GetOwningPlayer(u)
if lvl==1 then
call SaveUnitHandle(HH,id,0,u)
set n=CreateUnit(p,'e113',x+150*Cos(a),y+150*Sin(a),0)
call SetUnitAnimation(n,"Birth")
call SetUnitFlyHeight(n,75,755)
call SetUnitScale(n,.5,.5,.5)
call UnitAddAbility(n,'A0A1')
call SaveUnitHandle(HH,GetHandleId(u),StringHash("tamafrost")+1,n)
call SaveUnitHandle(HH,id,1,n)
set n=CreateUnit(p,'e113',x+150*Cos(a+f),y+150*Sin(a+f),0)
call SetUnitAnimation(n,"Birth")
call SetUnitFlyHeight(n,75,755)
call SetUnitScale(n,.5,.5,.5)
call UnitAddAbility(n,'A0A1')
call SaveUnitHandle(HH,GetHandleId(u),StringHash("tamafrost")+2,n)
call SaveUnitHandle(HH,id,2,n)
set n=CreateUnit(p,'e113',x+150*Cos(a+f*2),y+150*Sin(a+f*2),0)
call SetUnitAnimation(n,"Birth")
call SetUnitFlyHeight(n,75,755)
call SetUnitScale(n,.5,.5,.5)
call UnitAddAbility(n,'A0A1')
call SaveUnitHandle(HH,GetHandleId(u),StringHash("tamafrost")+3,n)
call SaveUnitHandle(HH,id,3,n)
set n=CreateUnit(p,'e113',x+150*Cos(a+f*3),y+150*Sin(a+f*3),0)
call SetUnitAnimation(n,"Birth")
call SetUnitFlyHeight(n,75,755)
call SetUnitScale(n,.5,.5,.5)
call UnitAddAbility(n,'A0A1')
call SaveUnitHandle(HH,GetHandleId(u),StringHash("tamafrost")+4,n)
call SaveUnitHandle(HH,id,4,n)
call SaveReal(HH,id,2,0)
call SaveReal(HH,id,3,0)
call SaveReal(HH,id,4,0)
call SaveInteger(HH,id,5,0)
call UnitAddAbility(u,'A1B2')
call UnitMakeAbilityPermanent(u,true,'A1B2')
call SetPlayerAbilityAvailable(GetOwningPlayer(u),'A1B2',true)
call TimerStart(t,0.02,true,function FrostArrowsLearnCast2)
else
call DestroyTimer(t)
call SetUnitAbilityLevel(u,'A1B2',lvl)
endif
set u=null
set p=null
set t=null
endfunction
