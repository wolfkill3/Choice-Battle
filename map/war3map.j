function HellSpiritMissleFly2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local unit d1=LoadUnitHandle(h,id,9)
local real speed=LoadReal(h,id,1)
local real angle=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=angle
local real dist=LoadReal(h,id,6)
local real mh=LoadReal(h,id,5)
local real rad=LoadReal(h,id,7)
local real rd=SR(x,y,x1,y1)
local player p=GetOwningPlayer(d1)
local integer idu=GetPlayerId(p)
local real dmg=12*GetHeroStr(Hero[idu],true)
local real cof=rd/dist
local real a2=(a-3.14)
local real time=LoadReal(h,id,11)
if rd>speed+30 and udg_B==true and UnitIsAlive(l__d)and time<dist then
set n=CreateUnit(p,0x65305538,x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'B000',1)
call SetUnitFlyHeight(n,mh*cof,0)
set x=x+speed*Cos(a)
set y=y+speed*Sin(a)
call SaveReal(h,id,11,time+speed)
call SetUnitXY_1(l__d,x,y, false)
call SaveReal(h,id,1,speed*1.02)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,mh*cof,0)
call SetUnitX(d1,x)
call SetUnitY(d1,y)
call SetUnitFacing(d1,a*bj_RADTODEG)
call SetUnitFlyHeight(d1,mh*cof,0)
else
call UnitApplyTimedLife(CreateUnit(p,'e06C',x,y,a2*bj_RADTODEG),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e06D',x,y,a2*bj_RADTODEG),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e06B',x,y,a2*bj_RADTODEG),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e06J',x,y,a2*bj_RADTODEG),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e06I',x,y,a2*bj_RADTODEG),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e067',x,y,a2*bj_RADTODEG),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e06H',x,y,a2*bj_RADTODEG),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e06I',x,y,a2*bj_RADTODEG),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e06H',x,y,a2*bj_RADTODEG),1,1)
call PauseUnit(l__d,false)
call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,false)
call myCustomDamage(Hero[idu],l__d,dmg,false,false,null,null,null)
call SetControlToUnit(Hero[idu],l__d,2,"stun")
call SetUnitX(Hero[idu],x+100*Cos(a))
call SetUnitY(Hero[idu],y+100*Sin(a))
call SetUnitFacing(Hero[idu],a2*bj_RADTODEG)
call SetUnitAnimation(Hero[idu],"attack")
call Push(l__d,60,a2,1000)
call ShakeCamera(0.5,20)
call SetUnitFlyHeight(l__d,0,0)
call RemoveUnit(d1)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set d1=null
set p=null
set l__d=null
set t=null
endfunction
function HellSpiritMissleFly takes unit l__d,unit d1,real speed,real angle,real x,real y,real mh,real dmg returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveUnitHandle(h,id,9,d1)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle)
call SaveReal(h,id,3,x)
call SaveReal(h,id,4,y)
call SaveReal(h,id,5,mh)
call SaveReal(h,id,6,SR(x,y,GetUnitX(l__d),GetUnitY(l__d)))
call SaveReal(h,id,8,dmg)
call SaveReal(h,id,11,0)
call TimerStart(t,0.03,true,function HellSpiritMissleFly2)
