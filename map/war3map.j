call EffectCreateAndMove(true,"Madara\\HakenSaber2.mdl",GetRandomReal(0,360),1,0.75,0.4,100,100,100,40,0,n0,0,GetRandomReal(0,360))
call EffectCreateAndMove(true,"Madara\\BlackBlink1.mdl",GetRandomReal(0,360),1,2,0.4,100,100,100,0,0,n0,0,GetRandomReal(0,360))
