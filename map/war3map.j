function RShikiAlterCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(HH,id,0)
    local unit c=LoadUnitHandle(HH,id,1)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetUnitX(c)
    local real y1=GetUnitY(c)
    local real a=Atan2(y1-y,x1-x)
    local integer idu=GetHandleId(u)
    local player p=GetOwningPlayer(u)
    set soundplay=CreateSound("sound\\Music\\mp3Music\\NanayaRAlt.mp3",false,false,true,12700,12700,"")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    call SetUnitX(u,x1-350*Cos(a))
    call SetUnitY(u,y1-350*Sin(a))
    call SaveReal(HH,id,5,Atan2(y1-GetUnitY(u),x1-GetUnitX(u)))
    call UnitAddAbility(u,'A1BI')
    call UnitMakeAbilityPermanent(u,true,'A1BI')
    call PauseTimer(t)
    call TimerStart(t,0.01,true,function RShikiAlterCast3)
    set u=null
    set c=null
    set p=null
    set t=null
endfunction
function RShikiWCast3 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(HH,id,0)
    local unit l__d=LoadUnitHandle(HH,id,1)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local integer idu=GetHandleId(u)
    local real dmg=GetHeroAgi(u,true)*(2.5+0.25*GetUnitAbilityLevel(u,'A1BX'))*(1-LoadInteger(HH,idu,ComboCounterHash)*0.045)
    local real x1=GetUnitX(l__d)
    local real y1=GetUnitY(l__d)
    local real x2=LoadReal(HH,id,7)
    local real y2=LoadReal(HH,id,8)
    local real a=LoadReal(HH,id,5)
    local real dist=SR(x1,y1,x2,y2)
    local real time=LoadReal(HH,id,6)
    local player p=GetOwningPlayer(u)
    if time<0.4 and GetWidgetLife(l__d)>0 then
    call SaveReal(HH,id,6,time+0.01)
    call SaveReal(HH,id,11,LoadReal(HH,id,11)+4.9)
    call SetUnitFlyHeight(l__d, ParabolaZ(250,330,dist), 0)
    if GetUnitTypeId(l__d)!='HMUS' then
    call SetUnitOrientation(l__d,GetUnitFacing(u),LoadReal(HH,id,11),0)
    endif
    call SetUnitXY_1(l__d,x1-9*Cos(a),y1-9*Sin(a),false)
    call SetUnitXY_1(u,x-3*Cos(a),y-3*Sin(a),false)
    if SR(x,y,x1,y1)>450 then
    call SetUnitXY_1(u,x1,y1,false)
    call SaveReal(HH,id,6,5)
    endif
    else
    call ShakeCamera(0.25,15)
    call DestroyEffect(AddSpecialEffect("war3mapImported\\WarStompCaster.mdx",x1,y1))
    call DestroyEffect(AddSpecialEffect("war3mapImported\\SandPoff.mdx",x1,y1))
    call PauseUnit(u,false)
    call PauseUnit(l__d,false)
    call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,false)
    call ComboBar(u,-.5)
    call SetUnitInvulnerable(u,false)
    if dmg>GetHeroAgi(u,true)*(2.5+0.25*GetUnitAbilityLevel(u,'A1BX'))*0.1 then
    call myCustomDamage(u,l__d,dmg,false,false,null,null,null)
    else
    call myCustomDamage(u,l__d,GetHeroAgi(u,true)*(2.5+0.25*GetUnitAbilityLevel(u,'A1BX'))*0.1,false,false,null,null,null)
    endif
    call SetControlToUnit(u,l__d,0.3, "stun")
    call StartAbilityCooldown(GetUnitAbility(u, 'A1BX'), 1.3)
    call SaveInteger(HH,idu,ComboCounterHash,LoadInteger(HH,idu,ComboCounterHash)+1)
    call TextTagFull2(I2S(LoadInteger(HH,idu,ComboCounterHash))+" x COMBO!",x,y,175,75,255,255,p,0.023+0.001*LoadInteger(HH,idu,ComboCounterHash))
    if LoadInteger(HH,idu,ComboCounterHash)>5 and GetUnitAbilityLevel(u,'A1BN')==0 then
        call SetPlayerAbilityAvailable(p,'A1BU',false)
        call SetPlayerAbilityAvailable(p,'A1BV',true)
    endif
    if LoadInteger(HH,idu,ComboCounterHash)>2 then
        call SetAbilityIntegerLevelField(GetUnitAbility(u,'A1BZ'), ABILITY_ILF_TARGET_TYPE,0,1)
        call SetAbilityRealLevelField(GetUnitAbility(u,'A1BZ'), ABILITY_RLF_CAST_RANGE,0,1400)
    endif
    call UnitRemoveAbility(u,'A1BI')
    call SaveReal(HH,idu,ComboTimerHash,2)
    call PauseTimer(t)
    call DestroyTimer(t)
    call UnitEnableAutoOrientation(l__d,true)
    call FlushChildHashtable(HH,id)
    call PauseTimer(t)
    call SetUnitTimeScale(u,1)
    endif
    set l__d=null
    set u=null
    set p=null
    set t=null
endfunction
function RShikiWCast2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(HH,id,0)
    local unit c=LoadUnitHandle(HH,id,1)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetUnitX(c)
    local real y1=GetUnitY(c)
    local real a=Atan2(y1-y,x1-x)
    local integer idu=GetHandleId(u)
    local player p=GetOwningPlayer(u)
    call SetUnitX(u,x1-130*Cos(a))
    call SetUnitY(u,y1-130*Sin(a))
    call SaveReal(HH,id,5,Atan2(y1-GetUnitY(u),x1-GetUnitX(u)))
    call SaveReal(HH,id,6,0)
    call SaveReal(HH,id,7,x1-330*Cos(Atan2(y1-GetUnitY(u),x1-GetUnitX(u))))
    call SaveReal(HH,id,8,y1-330*Sin(Atan2(y1-GetUnitY(u),x1-GetUnitX(u))))
    call UnitAddAbility(u,'A1BI')
    call UnitMakeAbilityPermanent(u,true,'A1BI')
    call UnitRemoveAbility(c,'A1BJ')
    call SetUnitFlyHeight(c, 50, 0)
    call SetUnitAnimation(u,"Spell Throw Gold")
    call SetUnitTimeScale(u,2.4)
    call UnitEnableAutoOrientation(c,false)
    call PauseTimer(t)
    call TimerStart(t,0.01,true,function RShikiWCast3)
    set u=null
    set c=null
    set p=null
    set t=null
endfunction
function RShikiOneCast4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit c=LoadUnitHandle(HH,id,1)
local integer idu=GetHandleId(u)
local real dmg=GetHeroAgi(u,true)*(2.5+0.25*GetUnitAbilityLevel(u,'A1BX'))*(1-LoadInteger(HH,idu,ComboCounterHash)*0.045)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local real he=GetUnitFlyHeight(c)-LoadReal(HH,id,2)*0.12
local real dist=LoadReal(HH,id,3)
local real sc=0
local real is=0
local real ig=30*bj_DEGTORAD
local boolean b=false
local real hp=0
local player p=GetOwningPlayer(u)
if dist>0 then
set x=x1-75*Cos(a)
set y=y1-75*Sin(a)
call SetUnitXY_1(u,x,y, false)
call SetUnitFlyHeight(c,he,0)
call SetUnitFlyHeight(u,he,0)
call SetUnitFacing(u,a*bj_RADTODEG)
call IssueImmediateOrder(c,"stop")
call SetUnitAnimation(u,"stand gold")
call SetUnitAnimation(c,"death")
call SaveReal(HH,id,3,dist-0.03)
if GetUnitAbilityLevel(c,0x42505345)==0 then
call SetControlToUnit(u,c, 0.3, "stun")
endif
call EffectToRandomBone("war3mapImported\\SlashEffectRed by Deckai.mdx",c)
call EffectToRandomBone("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",c)
else
call UnitRemoveAbility(u,'A195')
call UnitRemoveAbility(c,'A1BL')
call UnitRemoveAbility(u,'A1BI')
call SetPlayerAbilityAvailable(p,'A01B',false)
call SetPlayerAbilityAvailable(p,'A1BP',true)
call SetPlayerAbilityAvailable(p,'A1BX',false)
call SetPlayerAbilityAvailable(p,'A1BY',true)
call SetUnitFlyHeight(u,0,0)
call SetUnitFlyHeight(c,0,0)
loop
exitwhen is>=13
set n=CreateUnit(p,'e0ZH',x+300*Cos(ig*is),y+300*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,255,255,255,75)
call UnitApplyTimedLife(n,1,1)
call SetUnitTimeScale(n,1)
set is=is+1
endloop
call RemoveSaveHashTimedShikiR(1.15,idu,StringHash("SKR"),u)
call ShakeCamera(0.25,15)
call DestroyEffect(AddSpecialEffect("war3mapImported\\WarStompCaster.mdx",x1,y1))
call DestroyEffect(AddSpecialEffect("war3mapImported\\SandPoff.mdx",x1,y1))
call PauseUnit(u,false)
call ComboBar(u,-.5)
call SetUnitInvulnerable(u,false)
if dmg>GetHeroAgi(u,true)*(2.5+0.25*GetUnitAbilityLevel(u,'A1BX'))*0.1 then
call myCustomDamage(u,c,dmg,false,false,null,null,null)
else
call myCustomDamage(u,c,GetHeroAgi(u,true)*(2.5+0.25*GetUnitAbilityLevel(u,'A1BX'))*0.1,false,false,null,null,null)
endif
call SetControlToUnit(u,c,0.3, "stun")
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
call PauseTimer(t)
endif
set c=null
set u=null
set p=null
set t=null
endfunction
function RShikiOneCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit c=LoadUnitHandle(HH,id,1)
local integer idu=GetHandleId(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local real he=LoadReal(HH,id,2)
local real dist=LoadReal(HH,id,3)
local real sc=0
local player p=GetOwningPlayer(u)
if dist<0.7 then
set x=x1-100*Cos(a)
set y=y1-100*Sin(a)
call SetUnitXY_1(u,x,y, false)
call SetUnitFlyHeight(c,he,0)
call SetUnitFlyHeight(u,he,0)
call SetUnitFacing(u,a*bj_RADTODEG)
call IssueImmediateOrder(c,"stop")
set n=CreateUnit(p,'e0ZG',x+75*Cos(a+bj_PI/2),y+75*Sin(a+bj_PI/2),a*bj_RADTODEG)
call SetUnitVertexColor(n,155,75,255,255)
call UnitApplyTimedLife(n,1,0.2)
call SetUnitFlyHeight(n,he+400,0)
call SetUnitScale(n,1.2,1.2,1.2)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZF',x+75*Cos(a+bj_PI/2),y+75*Sin(a+bj_PI/2),a*bj_RADTODEG)
call SetUnitVertexColor(n,155,75,255,255)
call UnitApplyTimedLife(n,1,0.2)
call SetUnitFlyHeight(n,he+150,0)
call SetUnitScale(n,1.2,1.2,1.2)
set n=CreateUnit(p,'e11M',x1,y1,GetRandomReal(0,359))
call SetUnitVertexColor(n,155,75,255,255)
call SetUnitFlyHeight(n,he+50,0)
set sc=GetRandomReal(0.75,1.5)
call SetUnitScale(n,sc,sc,sc)
call UnitApplyTimedLife(n,1,0.7)
call SaveReal(HH,id,3,dist+0.03)
if GetUnitAbilityLevel(c,0x42505345)==0 then
call SetControlToUnit(u,c,0.5, "stun")
endif
call EffectToRandomBone("war3mapImported\\SlashEffectRed by Deckai.mdx",c)
else
call SaveReal(HH,id,3,0.25)
set x=x1-75*Cos(a)
set y=y1-75*Sin(a)
call SetUnitAnimation(u,"stand gold")
call SetUnitAnimation(c,"death")
call SetUnitXY_1(u,x,y, false)
call PauseTimer(t)
call TimerStart(t,0.03,true,function RShikiOneCast4)
endif
set c=null
set u=null
set p=null
set t=null
endfunction
function RShikiOneCast2 takes nothing returns nothing
