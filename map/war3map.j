set l__s=GetHeroInt(E,false)
call SetHeroInt(E,l__s-i,false)
call GroupRemoveUnit(g,E)
endif
call GroupRemoveUnit(g2,E)
endloop
call DestroyGroupTimed(g2,3)
else
set g2=CopyGroup(g)
loop
set E=FirstOfGroup(g2)
exitwhen E==null
set ide=GetHandleId(E)
if IsUnitEnemy(E,p)then
set i=LoadInteger(HH,ide,StringHash("makaagi"))
set l__s=GetHeroAgi(E,false)
call SetHeroAgi(E,l__s+i,false)
set i=LoadInteger(HH,ide,StringHash("makastr"))
set l__s=GetHeroStr(E,false)
call SetHeroStr(E,l__s+i,false)
set i=LoadInteger(HH,ide,StringHash("makaint"))
set l__s=GetHeroInt(E,false)
call SetHeroInt(E,l__s+i,false)
call GroupRemoveUnit(g,E)
elseif IsUnitAlly(E,p)then
set i=LoadInteger(HH,ide,StringHash("makaagi"))
set l__s=GetHeroAgi(E,false)
call SetHeroAgi(E,l__s-i,false)
set i=LoadInteger(HH,ide,StringHash("makastr"))
set l__s=GetHeroStr(E,false)
call SetHeroStr(E,l__s-i,false)
set i=LoadInteger(HH,ide,StringHash("makaint"))
set l__s=GetHeroInt(E,false)
call SetHeroInt(E,l__s-i,false)
call GroupRemoveUnit(g,E)
endif
call GroupRemoveUnit(g2,E)
endloop
call DestroyGroupTimed(g2,3)
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
endif
set g=null
set g2=null
