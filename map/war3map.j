function NumberOfEnemiesInEachGroup takes group g,player p returns integer
local integer r
local group g2
set g2=CopyGroup(g)
set r=0
loop
set E1=FirstOfGroup(g2)
exitwhen E1==null
if IsUnitEnemy(E1,p)then
set r=r+1
endif
call GroupRemoveUnit(g2,E1)
endloop
call DestroyGroupTimed(g2,3)
set g2=null
return r
endfunction
function NumberOfEnemiesInEachGroupHeroes takes group g,player p returns integer
local integer r
local group g2
set g2=CopyGroup(g)
set r=0
loop
set E=FirstOfGroup(g2)
exitwhen E==null
if Condition_Base(p,E) and IsUnitType(E,UNIT_TYPE_HERO)==true and IsUnitIllusion(E)==false and IsUnitType(E,UNIT_TYPE_DEAD)==false then
set r=r+1
endif
call GroupRemoveUnit(g2,E)
endloop
call DestroyGroupTimed(g2,3)
set g2=null
return r
endfunction
function GetRandomEnemyUnitFromGroup2 takes group g,player p returns unit
local integer i
local integer r
local group g2
set i=GetRandomInt(1,CountUnitsInGroup(g))
set r=1
set g2=CopyGroup(g)
loop
set E1=FirstOfGroup(g2)
exitwhen E1==null 
if r==i and Condition_Base(p,E1) and IsUnitType(E1,UNIT_TYPE_HERO)==true and IsUnitIllusion(E1)==false and IsUnitType(E1,UNIT_TYPE_DEAD)==false then
set n10=E1
elseif r==i and (Condition_Base(p,E1)==false or IsUnitType(E1,UNIT_TYPE_HERO)==false or IsUnitIllusion(E1)==true) then
set i=GetRandomInt(1,CountUnitsInGroup(g))
set r=1
endif
set r=r+1
call GroupRemoveUnit(g2,E1)
endloop
call DestroyGroupTimed(g2,3)
set g2=null
return n10
endfunction
function GetRandomEnemyUnitFromGroup takes group g,player p returns unit
local integer i=GetRandomInt(1,CountUnitsInGroup(g))
local integer r=1
local group g2
set g2=CopyGroup(g)
loop
set E1=FirstOfGroup(g2)
exitwhen E==null
if r==i and IsUnitEnemy(E1,p) and IsUnitType(E1,UNIT_TYPE_DEAD)==false then
set n10=E1
elseif r==i and IsUnitEnemy(E1,p)==false then
set i=GetRandomInt(1,CountUnitsInGroup(g))
set r=1
endif
set r=r+1
call GroupRemoveUnit(g2,E1)
endloop
call DestroyGroupTimed(g2,3)
set g2=null
return n10
endfunction
function TextTagFull2 takes string l__s,real x,real y,integer r,integer g,integer b,integer l__v,player p,real size returns nothing
set sysTextTag=CreateTextTag()
call SetTextTagText(sysTextTag,l__s,size)
call SetTextTagVisibility(sysTextTag,false)
if GetLocalPlayer()==p then
call SetTextTagVisibility(sysTextTag,true)
endif
call SetTextTagPos(sysTextTag,x,y,120)
call SetTextTagColor(sysTextTag,r,g,b,l__v)
call SetTextTagVelocity(sysTextTag,0.05*Cos(1.571),0.05*Sin(1.571))
call SetTextTagFadepoint(sysTextTag,.75)
call SetTextTagLifespan(sysTextTag,3)
call SetTextTagPermanent(sysTextTag,false)
set sysTextTag=null
endfunction
function UnitRemoveTransformTimedPause2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
if LoadReal(HH,id,3)<LoadReal(HH,id,2) and GetUnitAbilityLevel(LoadUnitHandle(HH,id,0),LoadInteger(HH,id,1))>0 and udg_B then
    if IsUnitPaused(LoadUnitHandle(HH,id,0))==false and GetUnitAbilityLevel(LoadUnitHandle(HH,id,0),'Pet1')==0 then
        call SaveReal(HH,id,3,LoadReal(HH,id,3)+0.05)
    endif
else
    if LoadBoolean(HH,GetHandleId(LoadUnitHandle(HH,id,0)),SST)==false then
        call SaveBoolean(HH,GetHandleId(LoadUnitHandle(HH,id,0)),SST,true)
    endif
    call FlushChildHashtable(HH,id)
    call PauseTimer(t)
    call DestroyTimer(t)
endif
set t=null
endfunction
function UnitRemoveTransformTimedPause takes unit u,integer id,real time returns nothing
