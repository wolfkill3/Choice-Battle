endfunction
function CastDrunkRollsAttack2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real r=GetRandomReal(-7,7)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real dist=LoadReal(h,id,5)
local real x=x1+dist*Cos(r)
local real y=y1+dist*Sin(r)
local integer num=LoadInteger(h,id,2)
local real he=0
local player p=GetOwningPlayer(u)
local integer i=0
local real dmg=GetHeroAgi(u,true)*2
if num<30 then
call SaveReal(h,id,5,dist+30)
call UnitApplyTimedLife(CreateUnit(p,'e0D4',x,y,GetRandomReal(0,360)),'BTLF',1)
call GroupEnumUnitsInRange(G,x,y,GetRandomReal(100,250),Base)
loop
set E=FirstOfGroup(G)
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call Push(E,10,Atan2(GetUnitY(E)-y,GetUnitX(E)-x),GetRandomReal(50,100))
endif
call GroupRemoveUnit(G,E)
exitwhen E==null
endloop
set n=CreateUnit(p,'e0D1',x,y,GetRandomReal(0,360))
call UnitScale(n,1,GetRandomReal(2.5,6),GetRandomReal(1,3))
call SetUnitFlyHeight(n,GetRandomReal(0,200),0)
call UnitApplyTimedLife(n,'BTLF',5)
set r=GetRandomReal(-7,7)
set x=x1+dist*Cos(r)
set y=y1+dist*Sin(r)
call UnitApplyTimedLife(CreateUnit(p,'e0D4',x,y,GetRandomReal(0,360)),'BTLF',1)
call GroupEnumUnitsInRange(G,x,y,GetRandomReal(100,250),Base)
loop
set E=FirstOfGroup(G)
if Condition_Base(p,E)then
call Push(E,10,Atan2(GetUnitY(E)-y,GetUnitX(E)-x),GetRandomReal(50,100))
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(G,E)
exitwhen E==null
endloop
set n=CreateUnit(p,'e0D1',x,y,GetRandomReal(0,360))
call UnitScale(n,1,GetRandomReal(2.5,6),GetRandomReal(1,3))
call SetUnitFlyHeight(n,GetRandomReal(0,200),0)
call UnitApplyTimedLife(n,'BTLF',5)
call SaveInteger(h,id,2,num+1)
set r=GetRandomReal(-7,7)
set x=x1+dist*Cos(r)
set y=y1+dist*Sin(r)
call UnitApplyTimedLife(CreateUnit(p,'e0D4',x,y,GetRandomReal(0,360)),'BTLF',1)
call GroupEnumUnitsInRange(G,x,y,GetRandomReal(100,250),Base)
loop
set E=FirstOfGroup(G)
if Condition_Base(p,E)then
call Push(E,10,Atan2(GetUnitY(E)-y,GetUnitX(E)-x),GetRandomReal(50,100))
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(G,E)
exitwhen E==null
endloop
set n=CreateUnit(p,'e0D1',x,y,GetRandomReal(0,360))
call UnitScale(n,1,GetRandomReal(2.5,6),GetRandomReal(1,3))
call SetUnitFlyHeight(n,GetRandomReal(0,200),0)
call UnitApplyTimedLife(n,'BTLF',5)
call SaveInteger(h,id,2,num+1)
else
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set t=null
set l__d=null
set p=null
endfunction
function CastDrunkRollsAttack takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
set n=CreateUnit(GetOwningPlayer(u),'e0CU',GetSpellTargetX(),GetSpellTargetY(),GetRandomReal(0,360))
call UnitScale(n,1,6,2)
call SaveUnitHandle(h,id,1,n)
call SaveReal(h,id,5,100)
set soundplay=SndN(920) // Sound\Music\mp3Music\HibarysRollsGoesBerserk.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.1,true,function CastDrunkRollsAttack2)
set u=null
set t=null
endfunction
function DrunkRollsAttackInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function CastDrunkRollsAttack)
call TriggerAddCondition(t,Condition(function CondDrunkRollsAttack))
set t=null
endfunction
