function InitTrig_RegenMana takes nothing returns nothing
set gg_trg_RegenMana=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_RegenMana,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_RegenMana,Condition(function Trig_RegenMana_Conditions))
call TriggerAddAction(gg_trg_RegenMana,function Trig_RegenMana_Actions)
endfunction
function Trig_Storm_Ring_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A04Y' and GetUnitTypeId(GetTriggerUnit())!='H007'  and GetUnitAbilityLevel(GetTriggerUnit(),'GIE1')==0
endfunction
function SR_Storm_Ring takes real xa,real ya,real xb,real yb returns real
return SquareRoot((xa-xb)*(xa-xb)+(ya-yb)*(ya-yb))
endfunction
function Trig_Storm_Ring_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit l__d=LoadUnitHandle(HH,id,1)
local unit c=LoadUnitHandle(HH,id,2)
local real a
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real f=GetUnitFacing(u)
if(SR_Storm_Ring(x,y,x1,y1)>47.00)then
set a=Atan2(y1-y,x1-x)
call SetUnitX(l__d,x+49*Cos(a))
call SetUnitY(l__d,y+49*Sin(a))
call SetUnitFacing(l__d,a*bj_RADTODEG)
call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e021',x,y,a*bj_RADTODEG),'BTLF',1.1)
else
call myCustomDamage(u,c,3*GetHeroAgi(u,true)+3*GetHeroInt(u,true),false,false,null,null,null)
if IsUnitInvulnerable(c)==false and UnitIsAlive(c) then
call ComboChecker(c,5,5, false )
endif
call RemoveUnit(l__d)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
set u=null
set l__d=null
set t=null
set c=null
endfunction
function Trig_Storm_Ring_Actions takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real f=GetUnitFacing(u)
call SaveUnitHandle(HH,id,0,u)
call SaveUnitHandle(HH,id,1,CreateUnit(GetOwningPlayer(u),'e021',GetUnitX(u)+50.*Cos(f*bj_DEGTORAD),GetUnitY(u)+50.*Cos(f*bj_DEGTORAD),f))
call SaveUnitHandle(HH,id,2,GetSpellTargetUnit())
call TimerStart(t,0.04,true,function Trig_Storm_Ring_Actions2)
set u=null
set t=null
endfunction
function InitTrig_Storm_Ring takes nothing returns nothing
set gg_trg_Storm_Ring=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Storm_Ring,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_Storm_Ring,Condition(function Trig_Storm_Ring_Conditions))
call TriggerAddAction(gg_trg_Storm_Ring,function Trig_Storm_Ring_Actions)
endfunction
function Trig_Thunder_Ring2_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A0WU' and GetUnitTypeId(GetTriggerUnit())!='H007'
endfunction
function Trig_Thunder_Ring2_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local integer ty=GetUnitTypeId(u)
local real time=LoadReal(h,id,1)
local real time2=LoadReal(h,id,2)
local player p=GetOwningPlayer(u)
//if ty=='H014' or ty=='H01B' or ty=='H01C' or ty=='H00C' or ty=='H06F' then
//call UnitRemoveAbility(u,'B00Y')
//call DisplayTextToPlayer(GetOwningPlayer(u),0,0,"Способность этого предмета, недоступна для этого персонажа.")
//endif
if time2<time and GetUnitAbilityLevel(u, 'A0VJ')>=1 then
        if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
                call SaveReal(h,id,2,time2+0.03)
        endif
        set n=CreateUnit(p,'e00E',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',0.5)
        call SetUnitTimeScale(n,5)
        set n=CreateUnit(p,'e023',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',0.5)
        call SetUnitTimeScale(n,55)
else
        call UnitRemoveAbility(u,'A0VJ')
        call FlushChildHashtable(h,id)
        call DestroyTimer(t)
endif
set u=null
set p=null
set t=null
endfunction
function Trig_Thunder_Ring2_Actions takes nothing returns nothing
local timer t=CreateTimer()
local unit u=GetTriggerUnit()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,3)
call SaveReal(h,id,2,0)
call UnitAddAbility(u,'A0VJ')
call UnitMakeAbilityPermanent(u,true,'A0VJ')
// Гроза Вонголы в статус-баре: 3 с, как таймер (стоит в паузе), пропадает со снятием A0VJ
call CreateModeIndicatorWithPauseFormDispellable(u,"war3mapImported\\BTNThunderRing.blp",3,'A0VJ')
call TimerStart(t,0.03,true,function Trig_Thunder_Ring2_Actions2)
set u=null
set t=null
endfunction
function InitTrig_Thunder_Ring2 takes nothing returns nothing
set gg_trg_Thunder_Ring2=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Thunder_Ring2,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_Thunder_Ring2,Condition(function Trig_Thunder_Ring2_Conditions))
call TriggerAddAction(gg_trg_Thunder_Ring2,function Trig_Thunder_Ring2_Actions)
endfunction
function Trig_Yamato_Conditions takes nothing returns boolean
return GetSpellAbilityId()=='A0HO' and GetUnitTypeId(GetTriggerUnit())!='H007'
endfunction
function Trig_Yamato_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local integer idu=GetHandleId(u)
local real time=LoadReal(HH,idu,SH_yamatotime)
local player p=GetOwningPlayer(u)
if time<10 and LoadReal(HH,idu,SH_yamato)==1 then
if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
call SaveReal(HH,idu,SH_yamatotime,time+0.05)
endif
else
call SaveReal(HH,idu,SH_yamatotime,10)
call SaveReal(HH,idu,SH_yamato,0)
call DestroyEffect(LoadEffectHandle(HH,idu,SH_yamatoEffect2))
call DestroyEffect(LoadEffectHandle(HH,idu,SH_yamatoEffect3))
call PauseTimer(t)
endif
set u=null
set p=null
set t=null
endfunction
function Trig_Yamato_Actions takes nothing returns nothing
local unit u=GetTriggerUnit()
local integer iu=GetPlayerId(GetOwningPlayer(u))
local integer id=GetHandleId(yamato[iu])
local integer idu=GetHandleId(u)
call SaveUnitHandle(h,id,0,u)
if LoadReal(HH,idu,SH_yamato)==1 then
call DestroyEffect(LoadEffectHandle(HH,idu,SH_yamatoEffect2))
call DestroyEffect(LoadEffectHandle(HH,idu,SH_yamatoEffect3))
endif
call SaveEffectHandle(HH,idu,SH_yamatoEffect2,AddSpecialEffectTarget("Abilities\\Weapons\\ZigguratMissile\\ZigguratMissile.mdl",u,"right hand"))
call SaveEffectHandle(HH,idu,SH_yamatoEffect3,AddSpecialEffectTarget("Abilities\\Weapons\\WaterElementalMissile\\WaterElementalMissile.mdl",u,"right hand"))
call SaveReal(HH,idu,SH_yamatotime,0)
call SaveReal(HH,idu,SH_yamato,1)
call TimerStart(yamato[iu],0.05,true,function Trig_Yamato_Actions2)
set u=null
endfunction
function InitTrig_Yamato takes nothing returns nothing
set gg_trg_Yamato=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Yamato,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_Yamato,Condition(function Trig_Yamato_Conditions))
call TriggerAddAction(gg_trg_Yamato,function Trig_Yamato_Actions)
endfunction
// летящие юниты T Мукуро: все двигает один общий таймер 0.03 с (раньше — свой таймер на каждый юнит)
function SlashRaven_Move takes nothing returns nothing
local unit l__d=GetEnumUnit()
local integer id=GetHandleId(l__d)
local real speed=LoadReal(MkMove_HT,id,1)
local real a=LoadReal(MkMove_HT,id,2)
local real Range=LoadReal(MkMove_HT,id,9)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
if Range>0 and GetUnitTypeId(l__d)!=0 then
call SetUnitXY_1(l__d,x1+speed*Cos(a),y1+speed*Sin(a), false)
call SaveReal(MkMove_HT,id,9,Range-speed)
call SetUnitFacingInstant(l__d,a*bj_RADTODEG)
if GetRandomInt(1,15)==1 then
call DestroyEffect(AddSpecialEffect("feathercrow.mdx",x1,y1))
endif
else
call GroupRemoveUnit(SlashRaven_G,l__d)
set SlashRaven_N=SlashRaven_N-1
call FlushChildHashtable(MkMove_HT,id)
call RemoveUnit(l__d)
endif
set l__d=null
endfunction
function SlashRaven2 takes nothing returns nothing
call ForGroup(SlashRaven_G,function SlashRaven_Move)
if SlashRaven_N<=0 then
set SlashRaven_N=0
call PauseTimer(SlashRaven_T)
set SlashRaven_On=false
endif
endfunction
function SlashRaven takes unit l__d,real speed,real angle,real range returns nothing
local integer id=GetHandleId(l__d)
call SaveReal(MkMove_HT,id,1,speed)
call SaveReal(MkMove_HT,id,2,angle)
call SaveReal(MkMove_HT,id,9,range)
if IsUnitInGroup(l__d,SlashRaven_G)==false then
call GroupAddUnit(SlashRaven_G,l__d)
set SlashRaven_N=SlashRaven_N+1
endif
if SlashRaven_On==false then
set SlashRaven_On=true
call TimerStart(SlashRaven_T,0.03,true,function SlashRaven2)
endif
endfunction
function GungnirCond takes nothing returns boolean
return GetSpellAbilityId()=='A0XX' and GetUnitTypeId(GetTriggerUnit())!='H007'  and GetUnitAbilityLevel(GetTriggerUnit(),'GIE1')==0
endfunction
function SlashGungnir2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local player p=GetOwningPlayer(l__d)
local unit u=Hero[GetPlayerId(p)]
local real speed=LoadReal(h,id,1)
local real x=LoadReal(h,id,3)
local real y=LoadReal(h,id,4)
local group g=LoadGroupHandle(h,id,5)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,2)
local real dmg=LoadReal(h,id,6)
local real Range=LoadReal(h,id,9)
if Range>0 then
call SetUnitXY_1(l__d,x1+speed*Cos(a),y1+speed*Sin(a), false)
call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",x1,y1))
call SaveReal(h,id,9,Range-speed)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call GroupEnumUnitsInRange(g,x1,y1,LoadReal(h,id,10),Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
else
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,GetHandleId(g))
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function SlashGungnir takes unit l__d,real speed,real dmg,real angle,real range,real mas returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle)
call SaveGroupHandle(h,id,5,CreateGroup())
call SaveReal(h,id,3,GetUnitX(l__d))
call SaveReal(h,id,4,GetUnitY(l__d))
call SaveReal(h,id,6,dmg)
call SaveReal(h,id,9,range)
call SaveReal(h,id,10,mas)
call TimerStart(t,0.03,true,function SlashGungnir2)
set t=null
endfunction
function GungnirCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local unit c=LoadUnitHandle(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real f=GetUnitFacing(u)
local string dmgtext=""
local integer i
local real dmg=0
local real tdamage=0
if(SR(x,y,x1,y1)>26.00)then
call SetUnitXY_1(l__d,x+47*Cos(a),y+47*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
else
call SlashGungnir(CreateUnit(p,'e04D',x1,y1,0),30,0,0,500,100)
call SlashGungnir(CreateUnit(p,'e04D',x1,y1,60),30,0,60*bj_DEGTORAD,500,100)
call SlashGungnir(CreateUnit(p,'e04D',x1,y1,120),30,0,120*bj_DEGTORAD,500,100)
call SlashGungnir(CreateUnit(p,'e04D',x1,y1,180),30,0,180*bj_DEGTORAD,500,100)
call SlashGungnir(CreateUnit(p,'e04D',x1,y1,240),30,0,240*bj_DEGTORAD,500,100)
call SlashGungnir(CreateUnit(p,'e04D',x1,y1,300),30,0,300*bj_DEGTORAD,500,100)
set dmg=5*GetHeroStr(u,true)
if dmg>GetWidgetLife(c)then
call SetUnitInvulnerable(c,false)
call UnitRemoveBuffs(c,true,true)
if UnitHasItemOfTypeBJCustom(c, 'I03A') and GetWidgetLife(c)>0 and IsUnitIllusion(c)==false then
    set AlastorPos=0
    loop
    exitwhen AlastorPos==10 or GetItemTypeId(UnitItemInSlot(c,AlastorPos)) == 'I03A'
    set AlastorPos=AlastorPos+1
    endloop
    if IsAbilityEnabled(GetUnitAbility(c,'AInv'))==true then
        set Alastor=GetItemOfTypeFromUnitBJCustom(c,'I03A')
        call UnitRemoveItem(c,Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(c, 'I03A',AlastorPos)
    else
        call EnableUnitAbility2(c,'AInv',false,true)
        set Alastor=GetItemOfTypeFromUnitBJCustom(c,'I03A')
        call UnitRemoveItem(c,Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(c, 'I03A',AlastorPos)    
        call DisableUnitAbility2(c,'AInv',false,true)
    endif
endif
call UnitAddAbility(c,'A0WR')
call SetUnitState(c,UNIT_STATE_LIFE,1)
call DamageIndicatorFunction(u,c,dmg)
call myCustomDamage(u,c,dmg,false,false,null,DAMAGE_TYPE_UNIVERSAL,null)
call UnitRemoveAbility(c,'A0WR')
else
if GetUnitTypeId(u) == 'H02L' and DU==true then
    set bDamage = bDamage + dmg
    if bDamage >= (20+bState)*GetHeroStr(u,true) then
        
        set bDamage = bDamage - ((20+bState)*GetHeroStr(u,true))
        if bDamage < 0 then
            set bDamage = 0
        endif
        call SetHeroStr(u, GetHeroStr(u,false) + 1,true)
        set bState = bState + 1
        call StopSound(soundStr[7],false,false)
        call StopSound(soundStr[8],false,false)
        call StopSound(soundStr[9],false,false)
        call StopSound(soundStr[10],false,false)
        call StopSound(soundStr[11],false,false)
        call StopSound(soundStr[12],false,false)
        call StopSound(soundStr[13],false,false)
        call StopSound(soundStr[14],false,false)      
        if bState!=10 then
            set BrolyRandom=GetRandomInt(1,3)
            if BrolyRandom == 1 then
                if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
                    call StartSound(soundStr[7])
                else
                    call StartSound(soundStr[8])
                endif
            elseif BrolyRandom == 2 then
                if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
                    call StartSound(soundStr[9])
                else
                    call StartSound(soundStr[10])
                endif
            elseif BrolyRandom == 3 then
                if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
                    call StartSound(soundStr[11])
                else
                    call StartSound(soundStr[12])
                endif
            endif
        else
            set BrolySTRTransform[GetPlayerId(p)]=true
            if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
                call StartSound(soundStr[13])
            else
                call StartSound(soundStr[14])
            endif
        endif
        if BrolySTRCond[GetPlayerId(p)]==null and bState>=10 then
            set BrolySTRCond[GetPlayerId(p)]=CreateUnit(p,'h23J',RX,RY,0)
        endif
    endif
endif
if LoadBoolean(HH,GetHandleId( u ),SH_BGRageBool)==false and GetUnitTypeId(u) == 'HBGN' and LoadBoolean(HH,GetHandleId( u ),SH_BGG)==false and DU==true then
    set tdamage=LoadReal(HH,GetHandleId( u ),BGRageHash)-dmg


    if tdamage <=0 then


        call DestroyEffect(AddSpecialEffectTarget("BlackGoku\\byakuya-7.mdl", c ,"origin"))
        call HealTextTag(c,c,  GetUnitState( u ,UNIT_STATE_MAX_LIFE)*0.05*myCustomHeal2(c,1),"HealthRes")
        call SetUnitState( u ,UNIT_STATE_LIFE,GetUnitState( u ,UNIT_STATE_LIFE)+GetUnitState( u ,UNIT_STATE_MAX_LIFE)*0.05)
        call SaveInteger(HH,GetHandleId( u ),BGRageIHash,  LoadInteger(HH,GetHandleId( u ),BGRageIHash)+1 )
        call SaveReal(HH,GetHandleId( u ),BGRageHash,  LoadReal(HH,GetHandleId( u ),BGRageBHash)  )
        set tdamage=LoadReal(HH,GetHandleId( u ),BGRageBHash)
    else
        call SaveReal(HH,GetHandleId( u ),BGRageHash,tdamage)
    endif
    if LoadInteger(HH,GetHandleId( u ),BGRageIHash)==4 then
        set tdamage=0
        call SaveBoolean(HH,GetHandleId( u ),SH_BGRageBool,true)
        if LoadBoolean(HH,GetHandleId( GetLocalPlayer() ),SOUND_LANGUAGE)==true then 
            set soundplay=SndN(793) // Sound\Music\mp3Music\SoundEng\BlackGokuRage_eng.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        else
            set soundplay=SndN(796) // Sound\Music\mp3Music\SoundJap\BlackGokuRage.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        endif
    endif
endif
call SetUnitState(c,UNIT_STATE_LIFE,GetWidgetLife(c)-dmg)
endif
call SaveInteger(HH,GetHandleId(c),TextDamageValueHash+GetPlayerId(GetOwningPlayer(u)),LoadInteger(HH,GetHandleId(c),TextDamageValueHash+GetPlayerId(GetOwningPlayer(u)))+R2I(dmg))
call AST_AddDmg(GetPlayerId(GetOwningPlayer(u)),c,dmg)
if LoadInteger(HH,GetHandleId(c),TextDamageValueHash+GetPlayerId(GetOwningPlayer(u)))==0 then
    call SaveStr(HH,GetHandleId(c),GetPlayerId(GetOwningPlayer(u))+TextDmgValueTextHash,"")
else
    call SaveStr(HH,GetHandleId(c),GetPlayerId(GetOwningPlayer(u))+TextDmgValueTextHash,Color[GetPlayerId(GetOwningPlayer(u))]+I2S( LoadInteger(HH,GetHandleId(c),TextDamageValueHash+GetPlayerId(GetOwningPlayer(u))))+"|r  ")
endif
set i=0
loop
exitwhen i>=17
    if Hero[i]!=null then
    set dmgtext=dmgtext+LoadStr(HH,GetHandleId(c),GetPlayerId(GetOwningPlayer(Hero[i]))+TextDmgValueTextHash)
    endif
    set i=i+1
endloop
//call BJDebugMsg(dmgtext)
call AllTextTag2(dmgtext,c)
set dmgtext=""

call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
endif

set u=null
set l__d=null
set t=null
set c=null
endfunction
function GungnirCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real f=GetUnitFacing(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,CreateUnit(GetOwningPlayer(u),'e0UU',x+50.*Cos(a),y+50.*Cos(a),a*bj_RADTODEG))
call SaveUnitHandle(h,id,2,c)
call TimerStart(t,0.025,true,function GungnirCast2)
set u=null
set t=null
endfunction
function InitTrig_Gungnir takes nothing returns nothing
set gg_trg_Gungnir=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Gungnir,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_Gungnir,Condition(function GungnirCond))
call TriggerAddAction(gg_trg_Gungnir,function GungnirCast)
endfunction
function FireWalk2Cond takes nothing returns boolean
return GetSpellAbilityId()=='A0HR' and GetUnitTypeId(GetTriggerUnit())!='H007'
endfunction
function FireWalk2Cast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
if GetUnitAbilityLevel(u,'B033')==0 then
call SetUnitPathing(GetTriggerUnit(),true)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
endif
set u=null
set t=null
endfunction
function FireWalk2Cast takes nothing returns nothing
local timer t=CreateTimer()
local unit u=GetTriggerUnit()
call SaveUnitHandle(h,GetHandleId(t),0,u)
call SetUnitPathing(u,false)
call TimerStart(t,0.025,true,function FireWalk2Cast2)
set t=null
endfunction
function FireWalk2Init takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function FireWalk2Cast)
call TriggerAddCondition(t,Condition(function FireWalk2Cond))
set t=null
endfunction
function FireWalkCond takes nothing returns boolean
return GetIssuedOrderId()==OrderId("smart")and GetUnitAbilityLevel(GetTriggerUnit(),'B033')>0 and GetUnitTypeId(GetTriggerUnit())!='H007' and GetUnitTypeId(GetTriggerUnit())!='H04U'
endfunction
function FireWalkCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local integer idu=GetHandleId(u)
local integer str=SH_firewalk
local integer str2=SH_distfirewalk
local integer str3=SH_firewalkcond
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,idu,str)
local real y1=LoadReal(h,idu,str+1)
local real a=Atan2(y1-y,x1-x)
local real dist=LoadReal(h,idu,str2)
local real speed=GetHeroAgi(u,true)/10
local player p=GetOwningPlayer(u)
if RectContainsUnit(gg_rct_HibariFight,u)==false and OrderId2String(GetUnitCurrentOrder(u))=="smart"and GetUnitAbilityLevel(u,'B033')>0 and SR(x,y,x1,y1)>speed+10 and GetUnitAbilityLevel(u,'B00O')==0 and GetUnitAbilityLevel(u, 'CBC2')==0 and GetUnitAbilityLevel(u, 'CBC1')==0 and GetUnitAbilityLevel(u, 'cbc4')==0 and GetUnitAbilityLevel(u, 'cbc6')==0 and GetUnitAbilityLevel(u, 'cbc7')==0 and GetUnitAbilityLevel(u, 'cbc8')==0 and GetUnitAbilityLevel(u, 'cbc9')==0 and GetUnitAbilityLevel(u, 'cbc5')==0 and IsUnitPaused(u)==false then
set x=x+speed*(1+SpeedRes*0.01)*Cos(a)
set y=y+speed*(1+SpeedRes*0.01)*Sin(a)
call SetUnitXY_1(u,x,y, false)
call SetUnitFacing(u,a*bj_RADTODEG)
call SaveReal(h,idu,str2,dist+speed)
if dist>speed*2 then
call SaveReal(h,idu,str2,0)
call UnitApplyTimedLife(CreateUnit(p,'e0B6',x,y,(a*bj_RADTODEG)),'BTLF',5)
endif
else
call SaveBoolean(h,idu,str3,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set t=null
endfunction
function FireWalkCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local real x=GetOrderPointX()
local real y=GetOrderPointY()
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local integer idu=GetHandleId(u)
local integer str=SH_firewalk
local integer str3=SH_firewalkcond
if x!=0 and y!=0 and x1!=x and y1!=y then
call SaveReal(h,idu,str,x)
call SaveReal(h,idu,str+1,y)
if LoadBoolean(h,idu,str3)==false then
call SaveUnitHandle(h,id,0,u)
call SaveBoolean(h,idu,str3,true)
call TimerStart(t,0.01,true,function FireWalkCast2)
endif
endif
set u=null
set t=null
endfunction
function FireWalkInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function FireWalkCast)
call TriggerAddCondition(t,Condition(function FireWalkCond))
set t=null
endfunction
function GyuudonTargetCond takes nothing returns boolean
return GetSpellAbilityId()=='A00R' and udg_B==true
endfunction
function GyuudonTargetCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit l__d=LoadUnitHandle(HH,id,1)
local unit c=LoadUnitHandle(HH,id,2)
local unit c1
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real a=Atan2(y1-y,x1-x)
local real f=GetUnitFacing(u)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(HH,id,5)
local group g2=CreateGroup()
local real l__s=LoadReal(HH,id,4)
local real dmg=1.5*GetHeroStr(u,true)
local integer count=LoadInteger(HH,id,6)
local boolean b=false
if GetUnitAbilityLevel(u,'LamS')>0 then
set dmg=1.45*dmg
endif
if SR1(x,y,x1,y1)>l__s+44.00 and UnitIsAlive(c)then
call SetUnitXY_1(l__d,x+(10+l__s)*Cos(a),y+(10+l__s)*Sin(a), false)
call SaveReal(HH,id,4,l__s+0.3)
if l__s>700 then
call RemoveUnit(l__d)
call DestroyGroup(g)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
endif
call SetUnitFacing(l__d,a*bj_RADTODEG)
call UnitApplyTimedLife(CreateUnit(p,'e0BB',x,y,GetRandomReal(0,359)),'BTLF',0.3)
else
call UnitApplyTimedLife(CreateUnit(p,'e03S',x,y,GetRandomReal(0,359)),'BTLF',0.5)
call Push3(c,45,a,250,"")
call myCustomDamage(u,c,dmg,false,false,null,null,null)
call SetControlToUnit(c,c,2, "stun")
call SaveInteger(HH,id,6,count+1)
if count>=3+GetUnitAbilityLevel(u,'A00R')then
call RemoveUnit(l__d)
call DestroyGroup(g)
call DestroyGroup(g2)
call FlushChildHashtable(HH,id)
call DestroyTimer(t)
else
call GroupClear(g)
call GroupEnumUnitsInRange(g,x,y,1000,BaseGyudon)
loop
    set E=GroupForEachUnit(g)
    exitwhen E==null
    if Condition_Base(p,E)then
    call GroupAddUnit(g2,E)
    endif
endloop
call GroupClear(g)
if GroupGetCount(g2)>0 then
set c1=GroupGetUnitByIndex(g2,GetRandomInt(0,GroupGetCount(g2)-1))
call SaveUnitHandle(HH,id,2,c1)
call GroupClear(g2)
call DestroyGroup(g2)
else
call SaveInteger(HH,id,6,count+10)
endif
endif
endif
set u=null
set l__d=null
set p=null
set g=null
set g2=null
set t=null
set c=null
set c1=null
endfunction
function GyuudonTargetCast takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real f=Atan2(y1-y,x1-x)
call SaveReal(HH,id,4,0)
call SaveInteger(HH,id,6,0)
call SaveGroupHandle(HH,id,5,CreateGroup())
call SaveUnitHandle(HH,id,0,u)
call SaveUnitHandle(HH,id,1,CreateUnit(GetOwningPlayer(u),'e00H',x+50.*Cos(f),y+50.*Sin(f),f*bj_RADTODEG))
call SaveUnitHandle(HH,id,2,GetSpellTargetUnit())
set soundplay=SndN(818) // Sound\Music\mp3Music\LamboR.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.04,true,function GyuudonTargetCast2)
set u=null
set t=null
endfunction
