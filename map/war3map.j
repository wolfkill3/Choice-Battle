function DanzoGPassive1 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit caster=LoadUnitHandle(HH,id,1)
local real facing=LoadReal(HH,id,3)
local real distance=LoadReal(HH,id,8)
local real time=LoadReal(HH,id,5)
set time=time+0.02
if distance>=1500 then
call UnitCreateAndMove(caster,'e200',caster,GetRandomReal(0,360),2,1,1,100,100,100,0,0,LoadUnitHandle(HH,id,20),0,facing)
call UnitSize(LoadUnitHandle(HH,id,20),0.1,1,1)
call MyRemoveUnit(LoadUnitHandle(HH,id,20),2)
call RemoveUnit(LoadUnitHandle(HH,id,21))
call RemoveUnit(LoadUnitHandle(HH,id,22))
call RemoveUnit(LoadUnitHandle(HH,id,23))
call RemoveUnit(LoadUnitHandle(HH,id,24))
call RemoveUnit(LoadUnitHandle(HH,id,25))
call RemoveUnit(LoadUnitHandle(HH,id,26))
call RemoveUnit(LoadUnitHandle(HH,id,27))
call DestroyGroup(LoadGroupHandle(HH,id,4))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
else
if time==0.2 then
call SetUnitAnimationByIndex(LoadUnitHandle(HH,id,26),0)
call SetUnitAnimationByIndex(LoadUnitHandle(HH,id,27),0)
set time=0
endif
call SaveReal(HH,id,5,time)
call MoveUnit(LoadUnitHandle(HH,id,20),LoadUnitHandle(HH,id,20),LoadReal(HH,id,9),facing)
call MoveUnit(LoadUnitHandle(HH,id,20),LoadUnitHandle(HH,id,21),0,facing)
call MoveUnit(LoadUnitHandle(HH,id,20),LoadUnitHandle(HH,id,22),0,facing)
call MoveUnit(LoadUnitHandle(HH,id,20),LoadUnitHandle(HH,id,23),0,facing)
call MoveUnit(LoadUnitHandle(HH,id,20),LoadUnitHandle(HH,id,24),0,facing)
call MoveUnit(LoadUnitHandle(HH,id,20),LoadUnitHandle(HH,id,25),0,facing)
call MoveUnit(LoadUnitHandle(HH,id,20),LoadUnitHandle(HH,id,26),0,facing)
call MoveUnit(LoadUnitHandle(HH,id,20),LoadUnitHandle(HH,id,27),0,facing)
call DamageAoeOneTimeDanzoQET(caster,GetUnitX(LoadUnitHandle(HH,id,20)),GetUnitY(LoadUnitHandle(HH,id,20)),250,LoadReal(HH,id,15),LoadGroupHandle(HH,id,4))
call SaveReal(HH,id,8,distance+LoadReal(HH,id,9))
endif
set t=null
set caster=null
endfunction
