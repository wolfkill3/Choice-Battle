endfunction
function FuiuchiCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real x2=LoadReal(HH,id,4)
local real y2=LoadReal(HH,id,5)
local real a=LoadReal(HH,id,1)
local group g=LoadGroupHandle(HH,id,3)
local integer l__idg=GetHandleId(g)
local player p=GetOwningPlayer(u)
local real dist=LoadReal(HH,id,100)
local real dmg=50+GetHeroAgi(u,true)*(2+GetUnitAbilityLevel(u,0x41313755))
if dist<1500 then
set x1=x1+40*Cos(a)
set y1=y1+40*Sin(a)
call SetUnitXY_1(u,x1,y1, false)
call SaveReal(HH,id,100,dist+40)
set n=CreateUnit(p,'e0Z4',x1,y1,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.3)
call SetUnitTimeScale(n,1.5)
call SetUnitVertexColor(n,255,125,255,150)
call UnitApplyTimedLife(CreateUnit(p,'e0Z3',x1,y1,a*bj_RADTODEG),'BTLF',0.3)
call GroupEnumUnitsInRange(g,x1,y1,180,Base)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)and LoadUnitHandle(HH,l__idg,ide)!=E then
if GetUnitAbilityLevel(u,'A182')==0 then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
else
call myCustomDamage(u,E,dmg+(1.5+GetUnitAbilityLevel(u,'A17X')*0.5)*GetHeroAgi(u,true),false,false,null,null,null)
call SetControlToUnit(E,E, 1.5, "stun")
endif
call SaveUnitHandle(HH,l__idg,ide,E)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",E,"chest"))
endif
call GroupRemoveUnit(g,E)
endloop
else
if GetUnitAbilityLevel(u,'A182')>0 then
call SabrackE_RemoveAbil(u,'A182')
endif
call FlushChildHashtable(HH,l__idg)
call FlushChildHashtable(HH,id)
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call SetUnitTimeScale(u,1)
call SetUnitVertexColor(u,255,255,255,255)
endif
set u=null
set p=null
set t=null
set g=null
endfunction
