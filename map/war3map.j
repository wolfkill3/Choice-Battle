function SaberNeroRCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local trigger tt=CreateTrigger()
local unit u=GetTriggerUnit()
call SaveUnitHandle(h,id,0,u)
call UnitAddAbility(u,'A1CE')
call UnitAddAbility(u,'A1CF')
call UnitMakeAbilityPermanent(u,true,'A1CE')
call UnitMakeAbilityPermanent(u,true,'A1CF')
call SaveTriggerHandle(h,id,2,tt)
call SaveTimerHandle(h,GetHandleId(tt),0,t)
call SaveReal(h,id,3,0)
call TriggerRegisterUnitStateEvent(tt,u,UNIT_STATE_LIFE,LESS_THAN,0.405)
call TriggerAddAction(tt,function SaberNeroReincornation)
if GetUnitTypeId(u)=='H26B' then
set soundplay=SndN(2657) // Sound\Music\mp3Music\NeroSaberR.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
elseif GetUnitTypeId(u)=='H16B' then
set soundplay=SndN(2659) // Sound\Music\mp3Music\NeroSaber1R.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
set soundplay=SndN(2657) // Sound\Music\mp3Music\NeroSaberR.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call TimerStart(t,0.25,true,function SaberNeroRCast2)
set u=null
set t=null
set tt=null
endfunction
