local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real x2
local real y2
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,5)
local real dist=LoadReal(h,id,6)
local real a2
local player p=GetOwningPlayer(u)
local real dmg=GetHeroStr(u,true)*0.018*(GetUnitAbilityLevel(u,0x41304C51)+5)
if dist<=2500 then
set x1=x1+35*Cos(a)
set y1=y1+35*Sin(a)
call SaveReal(h,id,6,dist+35)
if IsTerrainPathable(x1,y1,PATHING_TYPE_FLYABILITY)==false then
call SetUnitXY_1(l__d,x1,y1, false)
endif
set n=CreateUnit(p,0x65304848,x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.20)
set n=CreateUnit(p,0x65304848,x1,y1,GetRandomReal(0,359))
call SetUnitScale(n,0.75,0.75,0.75)
call SetUnitFlyHeight(n,155,0)
call UnitApplyTimedLife(n,1,0.20)
set n=CreateUnit(p,0x65304848,x1,y1,GetRandomReal(0,359))
call SetUnitScale(n,1,1,1)
call SetUnitFlyHeight(n,310,0)
call UnitApplyTimedLife(n,1,0.20)
set n=CreateUnit(p,0x65304848,x1,y1,GetRandomReal(0,359))
call SetUnitScale(n,1.25,1.25,1.20)
call SetUnitFlyHeight(n,465,0)
call UnitApplyTimedLife(n,1,0.20)
call GroupEnumUnitsInRange(G,x1,y1,250,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
set x2=GetUnitX(E)
set y2=GetUnitY(E)
set a2=Atan2(y2-y1,x2-x1)+0.7
call myCustomDamage(u,E,dmg,false,false,null,null,null)
if IsTerrainPathable(x2-69*Cos(a2),y2-69*Sin(a2), PATHING_TYPE_FLYABILITY)==false then
call SetUnitPosition(E,x2-69*Cos(a2),y2-69*Sin(a2))
else
call SetUnitPosition(E,x2,y2)
endif
call SetUnitFlyHeight(E,GetUnitFlyHeight(E)+2.6,0)
if IsUnitInGroup(E,g)==false then
call UnitAddAbility(E,'Arav')
call UnitRemoveAbility(E,'Arav')
call GroupAddUnit(g,E)
call SetUnitPathing(E,false)
endif
endif
call GroupRemoveUnit(G,E)
endloop
set n=CreateUnit(p,'e007',x1,y1,GetUnitFacing(u))
call UnitApplyTimedLife(n,'B001',0.5)
call SetUnitVertexColor(n,155,155,155,80)
call SetUnitScale(n,2,2,2)
else
loop
