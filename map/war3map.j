function CondBenizakuraWaveSlash takes nothing returns boolean
return GetSpellAbilityId()=='A0PV' and udg_B==true
endfunction
function CastBenizakuraWaveSlash2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real x2=LoadReal(h,id,4)
local real y2=LoadReal(h,id,5)
local real a=LoadReal(h,id,1)
local group g=LoadGroupHandle(h,id,3)
local integer l__idg=GetHandleId(g)
local integer lvl=GetUnitAbilityLevel(u,'A0PV')
local real dmg=GetHeroAgi(u,true)*(lvl+1)+50
local player p=GetOwningPlayer(u)
local integer l__ide
local real dist
local real x3
local real y3
local real ml=0
local real dist2=LoadReal(h,id,100)
if dist2<1250 and LoadBoolean(HH,GetHandleId(u),DASH_USER)==true then
call SaveReal(h,id,100,dist2+65)
call SetUnitXY_1(u,x1+65*Cos(a),y1+65*Sin(a), false)
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitAnimation(u,"attack")
if GetUnitTypeId(u)=='H03R' then
set n=CreateUnit(p,0x65304F43,x1,y1,a*bj_RADTODEG)
else
set n=CreateUnit(p,0x65313042,x1,y1,a*bj_RADTODEG)
endif
call UnitApplyTimedLife(n,'B000',0.25)
call SetUnitVertexColor(n,170,170,170,140)
call SetUnitAnimation(n,"attack")
set dist=GetRandomReal(-70,70)
set x3=x1+dist*Cos(a+deg90)
set y3=y1+dist*Sin(a+deg90)
set n=CreateUnit(p,0x65304F44,x3,y3,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'B000',0.25)
set dist=GetRandomReal(-70,70)
set x3=x1+dist*Cos(a+deg90)
set y3=y1+dist*Sin(a+deg90)
set n=CreateUnit(p,0x65304F46,x3,y3,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'B000',0.25)
call GroupEnumUnitsInRange(G,x1,y1,175,Base)
loop
set E=FirstOfGroup(G)
set ml=GetUnitState(E,UNIT_STATE_MAX_LIFE)
set l__ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,l__idg,l__ide)!=E then
if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
if GetUnitAbilityLevel(E,'A13O')==3 then
call myCustomDamage(u,E,dmg+ml*(0.03+0.001*GetHeroLevel(u)),false,false,null,null,null)
call UnitRemoveAbility(E,'A13O')
call UnitRemoveAbility(E,'A13U')
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",E,"chest"))
elseif GetUnitAbilityLevel(E,'A13O')<3 then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
if UnitIsAlive(E) then
if GetUnitAbilityLevel(E,'A13O')==0 then
call UnitAddAbility(E,'A13O')
call UnitMakeAbilityPermanent(E,true,'A13O')
call UnitAddAbility(E,'A13S')
call UnitMakeAbilityPermanent(E,true,'A13S')
elseif GetUnitAbilityLevel(E,'A13O')<3 then
if GetUnitAbilityLevel(E,'A13O')==1 then
call UnitRemoveAbility(E,'A13S')
call UnitAddAbility(E,'A13T')
call UnitMakeAbilityPermanent(E,true,'A13T')
elseif GetUnitAbilityLevel(E,'A13O')==2 then
call UnitRemoveAbility(E,'A13T')
call UnitAddAbility(E,'A13U')
call UnitMakeAbilityPermanent(E,true,'A13U')
endif
call SetUnitAbilityLevel(E,'A13O',GetUnitAbilityLevel(E,'A13O')+1)
endif
endif
endif
call SaveUnitHandle(h,l__idg,l__ide,E)
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\BloodEX.mdx",E,"chest"))
call DestroyEffect(AddSpecialEffectTarget("YoumuSlash.mdx",E,"chest"))
call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",E,"chest"))
else
call SaveBoolean(HH,GetHandleId(u),DASH_USER,false)
call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,u)
endif
endif
call GroupRemoveUnit(G,E)
exitwhen E==null
endloop
else
call SaveBoolean(HH,GetHandleId(u),DASH_USER,false)
call UnitRemoveAbility(u,'A0GN')
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
call DestroyTimer(t)
call DestroyGroup(g)
call SetUnitInvulnerable(u,false)
endif
set u=null
set p=null
set t=null
set g=null
endfunction
function CastBenizakuraWaveSlash takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,4,GetUnitX(u))
call SaveReal(h,id,5,GetUnitY(u))
call SaveReal(h,id,1,Atan2(GetSpellTargetY()-GetUnitY(u),GetSpellTargetX()-GetUnitX(u)))
call SaveGroupHandle(h,id,3,CreateGroup())
call SetUnitInvulnerable(u,true)
call SaveBoolean(HH,GetHandleId(u),DASH_USER,true)
call UnitAddAbility(u,'A0GN')
call SaveReal(h,id,100,0)
if GetUnitTypeId(u)!='H03R' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\SaberSakura2.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\YomuW.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
call TimerStart(t,0.015,true,function CastBenizakuraWaveSlash2)
set u=null
set t=null
endfunction
function BenizakuraWaveSlashInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
