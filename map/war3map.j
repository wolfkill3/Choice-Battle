function OrochimaruF4Cast takes nothing returns nothing
    local unit u=GetTriggerUnit()
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local unit c=GetSpellTargetUnit()
    local real x=GetUnitX(c)
    local real y=GetUnitY(c)
    local player p=GetOwningPlayer(u)
    local integer ip=GetPlayerId(p)
    if GetUnitAbilityLevel(c,'ore3')>0 and LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
        call PauseUnit(u,true)
        call PauseUnit(c,true)
        call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
        call SaveUnitHandle(h,id,12,u)
        call UnitAddAbility(u,'Aloc')
        call SetUnitXY_1(u,x,y, false)
        call SetUnitAnimation(u,"death")
        call SaveReal(HH,GetHandleId(u),TextTagTimeHash,-0.03)
        call SaveReal(HH,GetHandleId(u),TextTagHealTimeHash,-0.03)
        call UnitApplyTimedLife(u,'BTLF',1.2)
        call UnitAddAbility(c,'ore5')
        call UnitMakeAbilityPermanent(c,true,'ore5')
        call SaveInteger(h,id,0,ip)
        call SaveUnitHandle(h,id,1,c)
        call SaveReal(h,id,2,20)
        call TimerStart(t,1.0,false,function OrochimaruF4Cast12)
    else
        if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==true then
            call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
        else
            call IssueImmediateOrder(u,"stop")
        endif
    endif
    set u=null
    set c=null
    set t=null
    set p=null
endfunction
function InitTrig_OrochimaruF4 takes nothing returns nothing
    set gg_trg_OrochimaruF4=CreateTrigger()
