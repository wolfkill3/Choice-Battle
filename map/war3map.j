                call KillSoundWhenDone(soundplay)
                else
                set soundplay=CreateSound("Sound\\Music\\mp3Music\\GunhaE.mp3",false,false,true,12700,12700,"")
                call StartSound(soundplay)
                call KillSoundWhenDone(soundplay)
            endif
