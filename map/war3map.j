    call SetFrameTexture( CustomClassFrame, "UI\\Widgets\\Console\\Human\\human-inventory-slotfiller.blp", 2, true )
    call SetFrameSize( CustomClassFrame, .019, .019 )
    call ShowFrame( CustomClassFrame, false )
