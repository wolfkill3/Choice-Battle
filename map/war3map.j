function SoaceBBLevel100Cond takes nothing returns boolean
return GetSpellAbilityId()=='A0OQ'
endfunction
function SoaceBBLevel100Cast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real time=LoadReal(h,id,7)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)*bj_DEGTORAD
if time<8 and udg_B==true and UnitIsAlive(u)==true then
if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
call SaveReal(h,id,7,time+0.025)
endif
set E=LoadUnitHandle(h,id,1)
call SetUnitX(E,x+100*Cos(f+deg90))
call SetUnitY(E,y+100*Sin(f+deg90))
set E=LoadUnitHandle(h,id,2)
call SetUnitX(E,x-100*Cos(f+deg90))
call SetUnitY(E,y-100*Sin(f+deg90))
set E=LoadUnitHandle(h,id,3)
call SetUnitX(E,x+130*Cos(f+deg90))
call SetUnitY(E,y+130*Sin(f+deg90))
set E=LoadUnitHandle(h,id,4)
call SetUnitX(E,x-130*Cos(f+deg90))
call SetUnitY(E,y-130*Sin(f+deg90))
set E=LoadUnitHandle(h,id,5)
call SetUnitX(E,x+100*Cos(f+deg90))
call SetUnitY(E,y+100*Sin(f+deg90))
set E=LoadUnitHandle(h,id,6)
call SetUnitX(E,x-100*Cos(f+deg90))
call SetUnitY(E,y-100*Sin(f+deg90))
else
call SaveInteger(HH,GetHandleId(u),SH_KuukoQ,0)
call RemoveUnit(LoadUnitHandle(h,id,1))
call RemoveUnit(LoadUnitHandle(h,id,2))
call RemoveUnit(LoadUnitHandle(h,id,3))
call RemoveUnit(LoadUnitHandle(h,id,4))
call RemoveUnit(LoadUnitHandle(h,id,5))
call RemoveUnit(LoadUnitHandle(h,id,6))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set t=null
endfunction
function SoaceBBLevel100Cast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)*bj_DEGTORAD
local player p=GetOwningPlayer(u)
local integer ty=0
if GetUnitAbilityLevel(u,'A0OQ')==1 then
set ty='h03C'
elseif GetUnitAbilityLevel(u,'A0OQ')==2 then
set ty='h03D'
elseif GetUnitAbilityLevel(u,'A0OQ')==3 then
set ty='h03E'
elseif GetUnitAbilityLevel(u,'A0OQ')==4 then
set ty='h03F'
elseif GetUnitAbilityLevel(u,'A0OQ')==5 then
set ty='h03G'
endif
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,CreateUnit(p,ty,x+100*Cos(f+deg90),y+100*Sin(f+deg90),f*bj_RADTODEG))
call SaveUnitHandle(h,id,2,CreateUnit(p,ty,x-100*Cos(f+deg90),y-100*Sin(f+deg90),f*bj_RADTODEG))
set n=CreateUnit(p,ty,x+130*Cos(f+deg90),y+130*Sin(f+deg90),f*bj_RADTODEG)
call SetUnitFlyHeight(n,120,0)
call SaveUnitHandle(h,id,3,n)
set n=CreateUnit(p,ty,x-130*Cos(f+deg90),y-130*Sin(f+deg90),f*bj_RADTODEG)
call SetUnitFlyHeight(n,120,0)
call SaveUnitHandle(h,id,4,n)
set n=CreateUnit(p,ty,x+100*Cos(f+deg90),y+100*Sin(f+deg90),f*bj_RADTODEG)
call SetUnitFlyHeight(n,180,0)
call SaveUnitHandle(h,id,5,n)
set n=CreateUnit(p,ty,x-100*Cos(f+deg90),y-100*Sin(f+deg90),f*bj_RADTODEG)
call SetUnitFlyHeight(n,180,0)
call SaveUnitHandle(h,id,6,n)
call SaveReal(h,id,7,0)
call SaveInteger(HH,GetHandleId(u),SH_KuukoQ,1)
call CreateModeIndicatorWithPauseForm(u, "war3mapImported\\BTNSpaceBBLevel100.blp", 8)
set soundplay=SndN(1688) // Sound\Music\mp3Music\Kuuko1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.025,true,function SoaceBBLevel100Cast2)
set u=null
set t=null
set p=null
endfunction
function SoaceBBLevel100Init takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function SoaceBBLevel100Cast)
call TriggerAddCondition(t,Condition(function SoaceBBLevel100Cond))
set t=null
endfunction
function PowerDownGogeta takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
    if GetUnitAbilityLevel(u,'A16Y')>0 then
        call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.0003)
    endif
    if GetUnitAbilityLevel(u,'A170')>0 then
        call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.00105)
    endif
    if GetUnitAbilityLevel(u,'A171')>0 then
        call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.00115)
    endif
else
    if GetUnitState(u,UNIT_STATE_MAX_MANA)*0.05>GetUnitState(u,UNIT_STATE_MANA) then
        if GetUnitAbilityLevel(u,'A16Y')>0 then
            call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.00015)
        endif
        if GetUnitAbilityLevel(u,'A170')>0 then
            call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.000525)
        endif
        if GetUnitAbilityLevel(u,'A171')>0 then
            call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.000575)
        endif
    endif
endif
if GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.1>GetUnitState(u,UNIT_STATE_LIFE) or GetUnitState(u,UNIT_STATE_MAX_MANA)*0.04>GetUnitState(u,UNIT_STATE_MANA) or LoadBoolean(HH,GetHandleId(u),SST)==true then
if GetUnitAbilityLevel(u,'A171')>0 or GetUnitAbilityLevel(u,'A170')>0 then
call ShowAbility2Timed('GGBB',false,4.95)
call ShowAbility2Timed('A172',true,4.97)
endif
call SaveBoolean(HH,GetHandleId(u),SS,false)
call SaveBoolean(HH,GetHandleId(u),SST,false)
call UnitRemoveAbility(u,'A170')
call UnitRemoveAbility(u,'A16Y')
call UnitRemoveAbility(u,'A171')
call UnitAddAbility(u,'A16X')
call AddUnitAnimationProperties(u,"alternate",false)
call SetUnitAbilityLevel(u,'A2NM',1)
call UnitMakeAbilityPermanent(u,true,'A16X')
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set t=null
set u=null
endfunction
function PowerUpGogetaCond takes nothing returns boolean
return (GetSpellAbilityId()=='GGSS' or GetSpellAbilityId()=='GGBS' or GetSpellAbilityId()=='GGBB' or GetSpellAbilityId()=='GGSG' or GetSpellAbilityId()=='GGS4') and udg_B==true
endfunction
function PowerUpGogetaCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local timer tt=CreateTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real time=LoadReal(h,id,1)
if time<0.1 then
call PauseUnit(u,true)
call SaveReal(h,id,1,time+0.025)
else
call PauseUnit(u,false)
call SetUnitTimeScale(u,1)
call SetUnitAbilityLevel(u,'A2NM',LoadInteger(h,id,3)+1)
if LoadInteger(h,id,3)==1 and GetUnitAbilityLevel(u,'A16Y')==0 then //ss
set EFF=AddSpecialEffect("Yellow--zhendi.mdl", x, y)
call DestroyEffect(EFF)
call UnitRemoveAbility(u,'A16X')
call UnitRemoveAbility(u,'A16Y')
call UnitRemoveAbility(u,'A170')
call UnitRemoveAbility(u,'A171')
call UnitAddAbility(u,'A16Y')
call AddUnitAnimationProperties(u,"alternate",false)
call UnitMakeAbilityPermanent(u,true,'A16Y')
call StartSound(soundStr[90])
elseif LoadInteger(h,id,3)==2 then //ss4
call UnitRemoveAbility(u,'A16X')
call UnitRemoveAbility(u,'A16Y')
call UnitRemoveAbility(u,'A170')
call UnitRemoveAbility(u,'A171')
call UnitAddAbility(u,'A170')
set EFF=AddSpecialEffect("Orange--zhendi.mdl", x, y)
call DestroyEffect(EFF)
call AddUnitAnimationProperties(u,"alternate",true)
call ShowAbility2('A172',false)
call ShowAbility2('GGBB',true)
call UnitMakeAbilityPermanent(u,true,'A170')
call StartSound(soundStr[90])
elseif LoadInteger(h,id,3)==3 then //ssgss
call AddUnitAnimationProperties(u,"alternate",false)
set EFF=AddSpecialEffect("Blue--zhendi.mdl", x, y)
call DestroyEffect(EFF)
call UnitRemoveAbility(u,'A16X')
call UnitRemoveAbility(u,'A16Y')
call UnitRemoveAbility(u,'A170')
call UnitRemoveAbility(u,'A171')
call UnitAddAbility(u,'A171')
call UnitMakeAbilityPermanent(u,true,'A171')
call ShowAbility2('A172',false)
call ShowAbility2('GGBB',true)
call StartSound(soundStr[90])
endif
if LoadInteger(h,id,3)==0 and GetUnitAbilityLevel(u,'A16X')==0 then
call StartSound(soundStr[89]) 
endif
if LoadBoolean(HH,GetHandleId(u),SS)==false then
call SaveUnitHandle(h,GetHandleId(tt),0,u)
call SaveBoolean(HH,GetHandleId(u),SS,true)
call TimerStart(tt,0.1,true,function PowerDownGogeta)
endif
if LoadInteger(h,id,3)==0 then
call SaveBoolean(HH,GetHandleId(u),SST,true)
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set tt=null
set u=null
set t=null
endfunction
function PowerUpGogetaCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
call SaveUnitHandle(h,id,0,u)
if (GetSpellAbilityId()=='GGSS' and GetUnitAbilityLevel(u,'A16Y')==0) or GetSpellAbilityId()=='GGS4' or GetSpellAbilityId()=='GGSG' then
    call SaveReal(h,id,1,0)
    call ShowAbility2('A172',false)
    call ShowAbility2Timed('A172',true,0.025)
    //call UnitApplyTimedLife(CreateUnit(p,'e0LK',x,y,0),'BTLF',0.3)
    call UnitApplyTimedLife(CreateUnit(p,'e0LM',x,y,0),'BTLF',0.35)
elseif GetSpellAbilityId()=='GGBS' or GetSpellAbilityId()=='GGBB' then
    call SaveReal(h,id,1,0.075)
    call SaveInteger(h,id,3,0)
else
    call ShowAbility2('A172',false)
    call ShowAbility2Timed('A172',true,0.02)
    call SaveReal(h,id,1,0.1)
endif
if GetSpellAbilityId()=='GGSS' then
call SaveInteger(h,id,3,1)
elseif GetSpellAbilityId()=='GGS4' then
call SaveInteger(h,id,3,2)
elseif GetSpellAbilityId()=='GGSG' then
call SaveInteger(h,id,3,3)
endif
call SetUnitTimeScale(u,0.5)
call TimerStart(t,0.025,true,function PowerUpGogetaCast2)
set u=null
set p=null
set t=null
endfunction
function CondBigBangKamehameha takes nothing returns boolean
return GetSpellAbilityId()=='A0P9' and udg_B==true
endfunction
function CastBigBangKamehameha2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real a=LoadReal(h,id,4)
local real dist=LoadReal(h,id,10)
local real x=GetUnitX(l__d)+60*Cos(a)
local real y=GetUnitY(l__d)+60*Sin(a)
local real dmg=LoadReal(h,id,11)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,3)
if dist>0 and IsTerrainPathable(GetUnitX(l__d),GetUnitY(l__d),PATHING_TYPE_FLYABILITY)==false then
call SetUnitXY_1(l__d,x,y, false)
set n=CreateUnit(p,0x65304E52,x,y,a*bj_RADTODEG)
call SetUnitTimeScale(n,0)
call UnitApplyTimedLife(n,'BTLF',1)
set n=CreateUnit(p,0x65304E4F,x,y,a*bj_RADTODEG)
call SetUnitTimeScale(n,5)
call SetUnitScale(n,2.3,2.3,2.3)
call UnitApplyTimedLife(n,'BTLF',0.2)
call GroupEnumUnitsInRange(g,x,y,250,Base)
set idg=GetHandleId(g)
call SaveReal(h,id,10,dist-30)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
else
call GroupEnumUnitsInRange(g,x,y,750,Base)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
call ShakeCamera(0.5,20)
call UnitApplyTimedLife(CreateUnit(p,'e0DL',x,y,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0DK',x,y,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0DJ',x,y,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0KO',x,y,GetRandomReal(0,359)),'BTLF',4)
call StartSound(soundStr[47])
call RemoveUnit(l__d)
call FlushChildHashtable(h,GetHandleId(g))
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
function CastBigBangKamehameha takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real dmg=14*GetHeroAgi(u,true)
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,3,CreateGroup())
call SaveReal(h,id,4,a)
call SaveReal(h,id,10,5500)
call SetUnitInvulnerable(u,true)
call UnitApplyTimedLife(CreateUnit(p,'e0DG',x+50*Cos(a),y+50*Sin(a),GetRandomReal(0,359)),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,0x65304259,x+50*Cos(a),y+50*Sin(a),GetRandomReal(0,359)),'BTLF',4)
if GetUnitAbilityLevel(u,'A171')==0 then
call SetUnitAnimation(u,"Spell Throw")
else
call SetUnitAnimation(u,"Spell Throw Alternate")
endif
call SetUnitTimeScale(u,0.1)
call PauseUnit(u,true)
set soundplay=SndN(1690) // Sound\Music\mp3Music\BigBangkamehameha.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call UnitAddAbility(u,'A0NP')
call PolledWait(3.7)
call UnitRemoveAbility(u,'A0NP')
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call SetUnitTimeScale(u,1)
call UnitApplyTimedLife(CreateUnit(p,0x65304F4B,x+50*Cos(a),y+50*Sin(a),a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,0x65304E4E,x+50*Cos(a),y+50*Sin(a),a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,0x65304E50,x,y,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,0x65304E51,x,y,a*bj_RADTODEG),'BTLF',1)
set n=CreateUnit(p,0x65304E4F,x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitTimeScale(n,2)
set n=CreateUnit(p,'e0DG',x,y,a*bj_RADTODEG)
call SaveUnitHandle(h,id,1,n)
call SetUnitScale(n,15,15,15)
if GetUnitAbilityLevel(u,'B044')>0 then
set dmg=dmg+(1.75+GetUnitAbilityLevel(u,'A0P8')*0.50)*GetHeroAgi(u,true)+(1.75+GetUnitAbilityLevel(u,'A0P8')*0.50)*GetHeroStr(u,true)
endif
call UnitRemoveAbility(u,'B044')
call SaveReal(h,id,11,dmg)
call TimerStart(t,0.017,true,function CastBigBangKamehameha2)
set u=null
set p=null
set t=null
endfunction
