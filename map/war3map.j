native MergeUnits       takes integer qty, integer a, integer b, integer make returns boolean   // reserved native for call 4 integer function and return BOOLEAN value
native ConvertUnits takes integer qty, integer id returns boolean                                                       // reserved native for call 2 integer function and return BOOLEAN value (can be converted to int!)
native IgnoredUnits takes integer unitid returns integer                                                                        // reserved native for call 1 integer function and return integer value

function GetCommandString takes nothing returns string
return HLCcommand
endfunction
function ValidHLC takes nothing returns boolean
return GetCommandString()=="a" or GetCommandString()=="b" or GetCommandString()=="c" or GetCommandString()=="d" or GetCommandString()=="e" or GetCommandString()=="f" or GetCommandString()=="g" or GetCommandString()=="h" or GetCommandString()=="i" or GetCommandString()=="j" or GetCommandString()=="k" or GetCommandString()=="l" or GetCommandString()=="m" or GetCommandString()=="n"
endfunction

function CinematicFadeCommonBJCustom takes real red, real green, real blue, real duration, string tex, real startTrans, real endTrans returns nothing
    if (duration == 0) then
        // If the fade is instant, use the same starting and ending values,
        // so that we effectively do a set rather than a fade.
        set startTrans = endTrans
    endif
    call SetCineFilterTexture(tex)
    call SetCineFilterBlendMode(BLEND_MODE_BLEND)
    call SetCineFilterTexMapFlags(TEXMAP_FLAG_NONE)
    call SetCineFilterStartUV(0, 0, 1, 1)
    call SetCineFilterEndUV(0, 0, 1, 1)
    call SetCineFilterStartColor(PercentTo255(red), PercentTo255(green), PercentTo255(blue), PercentTo255(100-startTrans))
    call SetCineFilterEndColor(PercentTo255(red), PercentTo255(green), PercentTo255(blue), PercentTo255(100-endTrans))
    call SetCineFilterDuration(duration)
    call DisplayCineFilter(true)
endfunction

function FinishCinematicFadeBJCustom takes nothing returns nothing
    call DestroyTimer(bj_cineFadeFinishTimer)
    set bj_cineFadeFinishTimer = null
    call DisplayCineFilter(false)
endfunction
function FinishCinematicFadeAfterBJCustom takes real duration returns nothing
    // Create a timer to end the cinematic fade.
    set bj_cineFadeFinishTimer = CreateTimer()
    call TimerStart(bj_cineFadeFinishTimer, duration, false, function FinishCinematicFadeBJ)
endfunction
function ContinueCinematicFadeBJCustom takes nothing returns nothing
    call DestroyTimer(bj_cineFadeContinueTimer)
    set bj_cineFadeContinueTimer = null
    call CinematicFadeCommonBJCustom(bj_cineFadeContinueRed, bj_cineFadeContinueGreen, bj_cineFadeContinueBlue, bj_cineFadeContinueDuration, bj_cineFadeContinueTex, bj_cineFadeContinueTrans, 100)
endfunction
function ContinueCinematicFadeAfterBJCustom takes real duration, real red, real green, real blue, real trans, string tex returns nothing
    set bj_cineFadeContinueRed = red
    set bj_cineFadeContinueGreen = green
    set bj_cineFadeContinueBlue = blue
    set bj_cineFadeContinueTrans = trans
    set bj_cineFadeContinueDuration = duration
    set bj_cineFadeContinueTex = tex

    // Create a timer to continue the cinematic fade.
    set bj_cineFadeContinueTimer = CreateTimer()
    call TimerStart(bj_cineFadeContinueTimer, duration, false, function ContinueCinematicFadeBJCustom)
endfunction
function CinematicFadeBJCustom takes integer fadetype, real duration, string tex, real red, real green, real blue, real trans returns nothing
    if (fadetype == bj_CINEFADETYPE_FADEOUT) then
        // Fade out to the requested color.
        call AbortCinematicFadeBJ()
        call CinematicFadeCommonBJCustom(red, green, blue, duration, tex, 100, trans)
    elseif (fadetype == bj_CINEFADETYPE_FADEIN) then
        // Fade in from the requested color.
        call AbortCinematicFadeBJ()
        call CinematicFadeCommonBJCustom(red, green, blue, duration, tex, trans, 100)
        call FinishCinematicFadeAfterBJCustom(duration)
    elseif (fadetype == bj_CINEFADETYPE_FADEOUTIN) then
        // Fade out to the requested color, and then fade back in from it.
        if (duration > 0) then
            call AbortCinematicFadeBJ()
            call CinematicFadeCommonBJCustom(red, green, blue, duration * 0.5, tex, 100, trans)
            call ContinueCinematicFadeAfterBJCustom(duration * 0.5, red, green, blue, trans, tex)
            call FinishCinematicFadeAfterBJCustom(duration)
        endif
    else
        // Unrecognized fadetype - ignore the request.
    endif
endfunction

        function ShowAbility2 takes integer aid,boolean flag returns nothing
                local integer i
                set i=0
                loop
                        call SetPlayerAbilityAvailable(Player(i), aid, flag)
                        set i = i + 1
                        exitwhen i>=11
                endloop
        endfunction
        
function CheckUnitInvisible2 takes unit newUnit returns boolean
        local integer id_player = GetPlayerId(GetOwningPlayer(newUnit))
        local boolean bInvis = false
        local integer i
        if FFAMode==false then
            if id_player>4 then
                if IsUnitInvisible(newUnit, Player(0)) and IsUnitInvisible(newUnit, Player(1)) and IsUnitInvisible(newUnit, Player(2)) and IsUnitInvisible(newUnit, Player(3)) and IsUnitInvisible(newUnit, Player(4)) then
                    set bInvis = true
                endif
            else
                if IsUnitInvisible(newUnit, Player(5)) and IsUnitInvisible(newUnit, Player(6)) and IsUnitInvisible(newUnit, Player(7)) and IsUnitInvisible(newUnit, Player(8)) and IsUnitInvisible(newUnit, Player(9)) then
                    set bInvis = true
                endif
            endif
        else
            set i=0
            loop
                if IsUnitInvisible(newUnit, Player(i)) and Player(i)!=GetOwningPlayer(newUnit) then
                    set bInvis = true
                endif
                exitwhen i>=9
                set i=i+1
            endloop
        endif
        return bInvis
endfunction

function CheckUnitInvisible takes unit newUnit returns boolean
    local integer id_player = GetPlayerId(GetOwningPlayer(newUnit))
    local boolean bInvis = false
    if GetUnitAbilityLevel(newUnit, 'A0A1')>0 then 
        set bInvis = true
    endif
    if GetUnitAbilityLevel(newUnit, 'B00V')>0 then 
        set bInvis = true
    endif
    if GetUnitAbilityLevel(newUnit, 'B06M')>0 then 
        set bInvis = true
    endif
    if GetUnitAbilityLevel(newUnit, 'SaTI')>0 then 
        set bInvis = true
    endif
    if GetUnitAbilityLevel(newUnit, 'DanI')>0 then 
        set bInvis = true
    endif
    if GetUnitAbilityLevel(newUnit, 'B02H')>0 then 
        set bInvis = true
    endif
    if GetUnitAbilityLevel(newUnit, 'A0GI')>0 then 
        set bInvis = true
    endif
    if GetUnitAbilityLevel(newUnit, 'A27K')>0 then 
        set bInvis = true
    endif
    if GetUnitAbilityLevel(newUnit, 'Ao7S')>0 then 
        set bInvis = true
    endif
    if GetUnitAbilityLevel(newUnit, 'A0O1')>0 then 
        set bInvis = true
    endif
    if GetUnitAbilityLevel(newUnit, 'B001')>0 then 
        set bInvis = true
    endif
    if GetUnitAbilityLevel(newUnit, 'A2A1')>0 then 
        set bInvis = true
    endif
    if GetUnitAbilityLevel(newUnit, 'A0MM')>0 then 
        set bInvis = true
    endif
    if GetUnitAbilityLevel(newUnit, 'A17K')>0 then 
        set bInvis = true
    endif
    if GetUnitAbilityLevel(newUnit, 'B01O')>0 then 
        set bInvis = true
    endif
    if GetUnitAbilityLevel(newUnit, 'Ao8S')>0 then 
        set bInvis = true
    endif
    return bInvis
endfunction

function DummyAutoInvisible takes unit dummy, unit owner returns nothing
	if CheckUnitInvisible(owner) then
		if GetUnitAbilityLevel(dummy, 'A0A1')==0 then
			call UnitAddAbility(dummy, 'A0A1')
		endif
	else
		if GetUnitAbilityLevel(dummy, 'A0A1')==1 then
			call UnitRemoveAbility(dummy, 'A0A1')
		endif
	endif
endfunction

function IsItemInInventory takes unit u,integer it returns integer
    local integer i
    local item ti
    local integer count=0
    set i=0
    loop
        set ti=UnitItemInSlot(u,i)
        exitwhen i>6
        if GetItemTypeId(ti)==it then
            set count=count+1
        endif
        set i=i+1
    endloop
    set ti=null
    set u =null
    return count
endfunction

function Trig_Remove_Conditions takes nothing returns boolean
    set n=GetTriggerUnit()
    return GetUnitTypeId(n)=='e06F' or GetUnitTypeId(n)==0x6F723237 or GetUnitTypeId(n)==0x6F723431 or GetUnitTypeId(n)==0x6F723430 or GetUnitTypeId(n)=='or30' or GetUnitTypeId(n)==0x6F723037 or GetUnitTypeId(n)==0x6F723039 or GetUnitTypeId(n)==0x6F723038 or GetUnitTypeId(n)==0x6F723035 or GetUnitTypeId(n)=='or00' or  GetUnitTypeId(n)=='edR2' or GetUnitTypeId(n)=='eo9T' or GetUnitTypeId(n)=='ed9T' or GetUnitTypeId(n)=='kaD1' or GetUnitTypeId(n)=='eo9E' or GetUnitTypeId(n)=='e17L' or GetUnitTypeId(n)=='e17K' or GetUnitTypeId(n)=='e17H' or GetUnitTypeId(n)=='dBel' or GetUnitTypeId(n)=='e17J'
endfunction
function Trig_Remove_Actions takes nothing returns nothing
    call RemoveUnit(GetTriggerUnit())
endfunction
function InitTrig_Remove takes nothing returns nothing
    set gg_trg_Remove=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Remove,EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_Remove,Condition(function Trig_Remove_Conditions))
    call TriggerAddAction(gg_trg_Remove,function Trig_Remove_Actions)
endfunction
function AllTextTag takes string l__s,unit u returns nothing
        set sysTextTag=CreateTextTag()
        call SetTextTagVisibility(sysTextTag,true)
        call SetTextTagText(sysTextTag,l__s,0.023)
        call SetTextTagPosUnit(sysTextTag,u,20)
        call SetTextTagVelocity(sysTextTag,0.1*Cos(1.571),0.1*Sin(1.571))
        call SetTextTagFadepoint(sysTextTag,.75)
        call SetTextTagLifespan(sysTextTag,2)
        call SetTextTagPermanent(sysTextTag,false)
        set sysTextTag=null
endfunction
function AllTextTag3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local integer idu=GetHandleId(u)
local real time=LoadReal(HH,idu,TextTagTimeHash)
local texttag textdmg=LoadTextTagHandle(HH,idu,TextTagTargetHash)
local integer i
if IsUnitHidden(u)==false and IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
call SaveReal(HH,idu,TextTagTimeHash,time-0.03)
endif
call SetTextTagPosUnit(LoadTextTagHandle(HH,idu,TextTagTargetHash),u,200)
//if CheckUnitInvisible(u)==false then
//call SetTextTagPosUnit(textdmg,u,200)
//endif
if IsUnitInvisible(u, GetLocalPlayer()) or (GetUnitTypeId(u)=='H16C' and IsPlayerEnemy(GetLocalPlayer(),GetOwningPlayer(u))) then
    call SetTextTagVisibility(LoadTextTagHandle(HH,idu,TextTagTargetHash),false)
else
    call SetTextTagVisibility(LoadTextTagHandle(HH,idu,TextTagTargetHash),true)
endif
if time<0 or u==null then
    set i=0
    loop
    exitwhen i>15
    call SaveInteger(HH,idu,TextDamageValueHash+i,0)
    call SaveStr(HH,idu,i+TextDmgValueTextHash,"")
    set i=i+1
    endloop
    call SetTextTagVelocity(textdmg,0.2*Cos(1.571),0.2*Sin(1.571))
    call SetTextTagFadepoint(textdmg,0.5)
    call SetTextTagLifespan(textdmg,0.2)
    call RemoveSavedHandle(HH,idu,TextTagTargetHash)
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(HH,id)
endif
set t=null
set textdmg=null
set u=null
endfunction
function AllTextTag2 takes string l__s,unit u returns nothing
    local texttag textdmg
    local integer idu=GetHandleId(u)
    local timer t
    if LoadTextTagHandle(HH,idu,TextTagTargetHash)==null then
        set textdmg=CreateTextTag()
        if IsUnitInvisible(u, GetLocalPlayer()) or (GetUnitTypeId(u)=='H16C' and IsPlayerEnemy(GetLocalPlayer(),GetOwningPlayer(u))) then
            call SetTextTagVisibility(LoadTextTagHandle(HH,idu,TextTagTargetHash),false)
        else
            call SetTextTagVisibility(LoadTextTagHandle(HH,idu,TextTagTargetHash),true)
        endif
        call SaveTextTagHandle(HH,idu,TextTagTargetHash,textdmg)
        call SaveReal(HH,idu,TextTagTimeHash,4)
        call SetTextTagText(LoadTextTagHandle(HH,idu,TextTagTargetHash),l__s,0.023)
        call SetTextTagPosUnit(LoadTextTagHandle(HH,idu,TextTagTargetHash),u,200)
        call SetTextTagPermanent(LoadTextTagHandle(HH,idu,TextTagTargetHash),false)
        set t=CreateTimer()
        call SaveUnitHandle(HH,GetHandleId(t),0,u)
        call TimerStart(t,0.03,true, function AllTextTag3)
    else
        call SetTextTagText(LoadTextTagHandle(HH,idu,TextTagTargetHash),l__s,0.023)
        call SetTextTagPosUnit(LoadTextTagHandle(HH,idu,TextTagTargetHash),u,200)
        call SetTextTagPermanent(LoadTextTagHandle(HH,idu,TextTagTargetHash),false)
        if IsUnitInvisible(u, GetLocalPlayer()) or (GetUnitTypeId(u)=='H16C' and IsPlayerEnemy(GetLocalPlayer(),GetOwningPlayer(u))) then
            call SetTextTagVisibility(LoadTextTagHandle(HH,idu,TextTagTargetHash),false)
        else
            call SetTextTagVisibility(LoadTextTagHandle(HH,idu,TextTagTargetHash),true)
        endif
        call SaveReal(HH,idu,TextTagTimeHash,4)
    endif
    set t=null
    set textdmg=null
endfunction

function DamageTextTag takes unit source, unit target, real damage returns nothing
    local string damage_text = ""
    local integer t_id  = GetHandleId(target)
    local integer sp_id = GetPlayerId(GetOwningPlayer(source))
    local integer tp_id = GetPlayerId(GetOwningPlayer(target))
    local integer i = 0

    call SaveInteger(HH, t_id, TextDamageValueHash+sp_id, LoadInteger(HH, t_id, TextDamageValueHash+sp_id)+R2I(damage))
    if LoadInteger(HH, t_id, TextDamageValueHash+sp_id)==0 then
        call SaveStr(HH, t_id, sp_id+TextDmgValueTextHash,"")
    else
        call SaveStr(HH, t_id, sp_id+TextDmgValueTextHash, Color[sp_id]+I2S(LoadInteger(HH,t_id,TextDamageValueHash+sp_id))+"|r  ")
    endif
    set i=0
    loop
    exitwhen i>=17
        if Hero[i]!=null then
        set damage_text = damage_text+LoadStr(HH,t_id,GetPlayerId(GetOwningPlayer(Hero[i]))+TextDmgValueTextHash)
        endif
        set i=i+1
    endloop
    //call BJDebugMsg(damage_text)
    call AllTextTag2(damage_text, target)
    set damage_text=""
endfunction
function HealIndicatorFunction takes unit source, integer indicator ,real heal returns nothing
        local integer id          = GetHandleId(GetOwningPlayer(source))
        local real fullheal                 = LoadReal(HH, id, indicator)
        call SaveReal(HH, id, indicator, fullheal+heal)
endfunction
function MadokaCalculate takes unit source, unit target, real damage returns nothing
local integer tp_id = GetPlayerId(GetOwningPlayer(target))
local integer ap_id = GetPlayerId(GetOwningPlayer(source))
call SaveReal(HH,GetHandleId(source),MadokaHHash,LoadReal(HH,GetHandleId(source),MadokaHHash)+damage)
if LoadReal(HH,GetHandleId(source),MadokaHHash)>=LoadReal(HH,GetHandleId(source),MadokaTHHash) and LoadInteger(HH,GetHandleId(source),MadokaMHash)==0 then
call SaveInteger(HH,GetHandleId(source),MadokaMHash,1)
call SaveReal(HH,GetHandleId(source),MadokaTHHash,LoadReal(HH,GetHandleId(source),MadokaTHHash)*2)
endif
if LoadReal(HH,GetHandleId(source),MadokaHHash)>=LoadReal(HH,GetHandleId(source),MadokaTHHash) and LoadInteger(HH,GetHandleId(source),MadokaMHash)==1 then
call SaveInteger(HH,GetHandleId(source),MadokaMHash,2)
endif
if LoadReal(HH,GetHandleId(source),MadokaDHash)>=LoadReal(HH,GetHandleId(source),MadokaTDHash) and LoadInteger(HH,GetHandleId(source),MadokaMHash)==2 then
call SaveInteger(HH,GetHandleId(source),MadokaMHash,3)
endif
endfunction
function AllTextTagHeal3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local integer idu=GetHandleId(u)
local real time=LoadReal(HH,idu,TextTagHealTimeHash)
local texttag textdmg=LoadTextTagHandle(HH,idu,TextTagHealTargetHash)
local integer i
if IsUnitHidden(u)==false and IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
call SaveReal(HH,idu,TextTagHealTimeHash,time-0.03)
endif
call SetTextTagPosUnit(LoadTextTagHandle(HH,idu,TextTagHealTargetHash),u,300)
//if CheckUnitInvisible(u)==false then
//call SetTextTagPosUnit(textdmg,u,200)
//endif
if IsUnitInvisible(u, GetLocalPlayer()) or (GetUnitTypeId(u)=='H16C' and IsPlayerEnemy(GetLocalPlayer(),GetOwningPlayer(u))) then
    call SetTextTagVisibility(LoadTextTagHandle(HH,idu,TextTagHealTargetHash),false)
else
    call SetTextTagVisibility(LoadTextTagHandle(HH,idu,TextTagHealTargetHash),true)
endif
if time<0 or u==null then
    set i=0
    loop
    exitwhen i>15
    call SaveInteger(HH, idu, TextHealAllyValueHash+StringHash("HealthRes")+i, 0)
    call SaveInteger(HH, idu, TextHealAllyValueHash+StringHash("ManaRes")+i, 0)
    set i=i+1
    endloop
    call SaveInteger(HH,idu,TextHealValueHash+StringHash("HealthRes"),0)
    call SaveStr(HH,idu,StringHash("HealthRes")+TextHealValueTextHash,"")
    call SaveInteger(HH,idu,TextHealValueHash+StringHash("ManaRes"),0)
    call SaveStr(HH,idu,StringHash("ManaRes")+TextHealValueTextHash,"")
    call SetTextTagVelocity(textdmg,0.2*Cos(1.571),0.2*Sin(1.571))
    call SetTextTagFadepoint(textdmg,0.5)
    call SetTextTagLifespan(textdmg,0.2)
    call RemoveSavedHandle(HH,idu,TextTagHealTargetHash)
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(HH,id)
endif
set t=null
set textdmg=null
set u=null
endfunction
function AllTextTagHeal2 takes string l__s,unit u returns nothing
    local texttag textdmg
    local integer idu=GetHandleId(u)
    local timer t
    if LoadTextTagHandle(HH,idu,TextTagHealTargetHash)==null then
        set textdmg=CreateTextTag()
        if IsUnitInvisible(u, GetLocalPlayer()) or (GetUnitTypeId(u)=='H16C' and IsPlayerEnemy(GetLocalPlayer(),GetOwningPlayer(u))) then
            call SetTextTagVisibility(LoadTextTagHandle(HH,idu,TextTagHealTargetHash),false)
        else
            call SetTextTagVisibility(LoadTextTagHandle(HH,idu,TextTagHealTargetHash),true)
        endif
        call SaveTextTagHandle(HH,idu,TextTagHealTargetHash,textdmg)
        call SaveReal(HH,idu,TextTagHealTimeHash,2.5)
        call SetTextTagText(LoadTextTagHandle(HH,idu,TextTagHealTargetHash),l__s,0.023)
        call SetTextTagPosUnit(LoadTextTagHandle(HH,idu,TextTagHealTargetHash),u,300)
        call SetTextTagPermanent(LoadTextTagHandle(HH,idu,TextTagHealTargetHash),false)
        set t=CreateTimer()
        call SaveUnitHandle(HH,GetHandleId(t),0,u)
        call TimerStart(t,0.03,true, function AllTextTagHeal3)
    else
        if IsUnitInvisible(u, GetLocalPlayer()) or (GetUnitTypeId(u)=='H16C' and IsPlayerEnemy(GetLocalPlayer(),GetOwningPlayer(u))) then
            call SetTextTagVisibility(LoadTextTagHandle(HH,idu,TextTagHealTargetHash),false)
        else
            call SetTextTagVisibility(LoadTextTagHandle(HH,idu,TextTagHealTargetHash),true)
        endif
        call SetTextTagText(LoadTextTagHandle(HH,idu,TextTagHealTargetHash),l__s,0.023)
        call SetTextTagPosUnit(LoadTextTagHandle(HH,idu,TextTagHealTargetHash),u,300)
        call SetTextTagPermanent(LoadTextTagHandle(HH,idu,TextTagHealTargetHash),false)
        call SaveReal(HH,idu,TextTagHealTimeHash,2.5)
    endif
    set t=null
    set textdmg=null
endfunction

function HealTextTag takes unit source, unit target, real damage, string HealType returns nothing
    local string Heal_text = ""
    local integer t_id  = GetHandleId(target)
    local integer sp_id = StringHash(HealType)
    local integer tp_id = GetPlayerId(GetOwningPlayer(target))
    local integer ap_id = GetPlayerId(GetOwningPlayer(source))
    if HealType=="HealthRes" then
        if GetUnitState(target,UNIT_STATE_LIFE)+damage>=GetUnitState(target,UNIT_STATE_MAX_LIFE) then
            set damage=GetUnitState(target,UNIT_STATE_MAX_LIFE)-GetUnitState(target,UNIT_STATE_LIFE)
        endif
        if damage>0 then
            if GetOwningPlayer(source)!=GetOwningPlayer(target) then
                call HealIndicatorFunction(source,TAH_INDICATOR,damage)
                if FFAMode==false and GetUnitTypeId(Hero[ap_id])=='HMad' and target==Hero[tp_id] then
                    call MadokaCalculate(source,target,damage)
                endif
            else
                call HealIndicatorFunction(source,TSH_INDICATOR,damage)
                if FFAMode==true and GetUnitTypeId(Hero[ap_id])=='HMad' and target==Hero[tp_id] then
                    call MadokaCalculate(source,target,damage)
                endif
            endif
        endif
    elseif HealType=="ManaRes" then
        if GetUnitState(target,UNIT_STATE_MANA)+damage>=GetUnitState(target,UNIT_STATE_MAX_MANA) then
            set damage=GetUnitState(target,UNIT_STATE_MAX_MANA)-GetUnitState(target,UNIT_STATE_MANA)
        endif
        if damage>0 then
            if GetOwningPlayer(source)!=GetOwningPlayer(target) then
                call HealIndicatorFunction(source,TAM_INDICATOR,damage)
            else
                call HealIndicatorFunction(source,TSM_INDICATOR,damage)
            endif
        endif
    endif
    if damage>0 then
        call SaveInteger(HH, t_id, TextHealAllyValueHash+sp_id+ap_id, LoadInteger(HH, t_id, TextHealAllyValueHash+sp_id+ap_id)+R2I(damage))
        call SaveInteger(HH, t_id, TextHealValueHash+sp_id, LoadInteger(HH, t_id, TextHealValueHash+sp_id)+R2I(damage))
        if LoadInteger(HH, t_id, TextHealValueHash+sp_id)==0 then
            call SaveStr(HH, t_id, sp_id+TextHealValueTextHash,"")
        else
            if HealType=="HealthRes" then
                call SaveStr(HH, t_id, sp_id+TextHealValueTextHash, Color[13]+"+"+I2S(LoadInteger(HH,t_id,TextHealValueHash+sp_id))+"|r  ")
            elseif HealType=="ManaRes" then
                call SaveStr(HH, t_id, sp_id+TextHealValueTextHash, Color[12]+"+"+I2S(LoadInteger(HH,t_id,TextHealValueHash+sp_id))+"|r  ")
            endif
        endif
        set Heal_text = Heal_text+LoadStr(HH,t_id,StringHash("HealthRes")+TextHealValueTextHash)
        set Heal_text = Heal_text+LoadStr(HH,t_id,StringHash("ManaRes")+TextHealValueTextHash)
        //call BJDebugMsg(damage_text)
        call AllTextTagHeal2(Heal_text, target)
    endif
    set Heal_text=""
endfunction

function Check_GaeDearg takes unit target returns boolean
        local integer id=GetHandleId(target)
        local boolean rBool=false
        if LoadBoolean(HH, GetHandleId(target), GAE_DEARG_CONDITION) then
                set rBool=true
        else
                set rBool=false
                call RemoveSavedBoolean(HH, GetHandleId(target), GAE_DEARG_CONDITION)
        endif
        return rBool
endfunction

function SquareRootUnit takes unit a,unit b returns real
        return SquareRoot((GetUnitX(b)-GetUnitX(a))*(GetUnitX(b)-GetUnitX(a))+(GetUnitY(b)-GetUnitY(a))*(GetUnitY(b)-GetUnitY(a)))
endfunction

function myCustomDamage takes unit whichUnit, unit target, real amount, boolean attack, boolean ranged, attacktype attackType, damagetype damageType, weapontype weaponType returns nothing
    local real currentDmg = amount
    local real classic_res = 0.0
    local real minusres
    local integer idTar=GetHandleId(target)
    if GetUnitAbilityLevel(target,'GDSV') == 1 then
        set minusres=0.6
    else
        if GetUnitAbilityLevel(target,'RiSV') == 1 then
            set minusres=0.7
        else
            set minusres=1
        endif
    endif
    if GetUnitAbilityLevel(target,'SNT2') == 1 then  // Хрупкость Синон
        set minusres = minusres - 0.15
    endif
    //~ конец модификации увеличения урона
    if GetUnitState(target,UNIT_STATE_LIFE)==GetUnitState(target,UNIT_STATE_MAX_LIFE) and IsUnitType(target,UNIT_TYPE_HERO) then
        call SetUnitState(target,UNIT_STATE_LIFE,GetUnitState(target,UNIT_STATE_LIFE)-1)
    endif
    if attackType != ATTACK_TYPE_HERO and damageType!=DAMAGE_TYPE_UNIVERSAL then
    //~ Увеличение НЕ хаос урона
        if passedTime < 0 then
            set currentDmg = currentDmg*(1.00+(0.05*passedTime)*minusres)
        endif
        // Калейдожезл Руби
        if GetUnitAbilityLevel(target,'B072') > 0 then
            set currentDmg = currentDmg * 1.10
        endif
                
        // if GetUnitAbilityLevel(whichUnit,'A0U5') > 0 then
            // set currentDmg = currentDmg * (1.1+0.05*GetUnitAbilityLevel(whichUnit,'A0U5'))
        // endif
                
        // F Wendy усиление
        if GetUnitAbilityLevel(whichUnit,'BW01') > 0 then
            set currentDmg = currentDmg * 1.10
        endif
        if GetUnitAbilityLevel(whichUnit,'A171') > 0 then
            set currentDmg = currentDmg * 1.15
        endif  
		if GetUnitAbilityLevel(whichUnit,'A176') > 0 then
            set currentDmg = currentDmg * 1.05
        endif  
        if GetUnitAbilityLevel(whichUnit,'GkH5') > 0 or GetUnitAbilityLevel(whichUnit,'GkH8') > 0 then
            set currentDmg = currentDmg * 1.05
        endif
        if GetUnitAbilityLevel(whichUnit,'GkH6') > 0 then
            set currentDmg = currentDmg * 1.1
        endif
        //T Waver   
        if GetUnitAbilityLevel(target,'WaT1') > 0 then
            set currentDmg = currentDmg * 1.20
        endif   
                
        // W Kiyohime ослабление
        if GetUnitAbilityLevel(whichUnit,'B17Y') > 0 then
            set currentDmg = currentDmg * 0.65
        endif
                
                // Брейкер уменьшение наносимого урона
        if GetUnitAbilityLevel(whichUnit,'A15H') > 0 then
            set currentDmg = currentDmg * 0.9
        endif   
                
                // T Gin уменьшение маг реза -> увеличение урона по нему
        if GetUnitAbilityLevel(target,'BGiT') > 0 then
            set currentDmg = currentDmg + amount*(I2R(GetUnitAbilityLevel(target, 'BGiT'))*0.05)
        endif
		
		
		// Клон Вергилия - Vergil T
		if GetUnitTypeId(whichUnit)=='H03O' then	
			set currentDmg = currentDmg * 0.6
		endif
		
		// Увеличение урона на 10% от наличия шторма маре
		//if (UnitHasItemOfTypeBJ(whichUnit, 'I05N') or GetUnitAbilityLevel(whichUnit,'KIT6') > 0) and SquareRootUnit(whichUnit, target)<=1500 then
		//	set currentDmg = currentDmg * 1.10
		//endif
		
		//======= Ичиго Блют Артерие
		if GetUnitAbilityLevel(whichUnit, 'IcF3') > 0 then
			set currentDmg=currentDmg * 1.20
			// if GetRandomInt(1, 100) < 20 then
			// 	set currentDmg=currentDmg * 1.25
			// 	call AllTextTag("|c00FF0080CRIT!|r" , target)
			// 	call DestroyEffect(AddSpecialEffectTarget("1232.mdl", target, "chest"))
			// endif
		endif
		if GetUnitAbilityLevel(target, 'IcF3') > 0 then
			set currentDmg=currentDmg * 1.15
		endif
		
		//===== Laxus F Истощение
		if GetUnitAbilityLevel(whichUnit, 'AP01') > 0 then
			set currentDmg=currentDmg * 0.8
		endif
		if GetUnitAbilityLevel(target, 'AP01') > 0 then
			set currentDmg=currentDmg * 1.2
		endif
		
        // Увеличение урона от прошедшего времени после 6ой минуты.
        if passedTime > 0 then
            set currentDmg = currentDmg*(1.00+(0.05*passedTime))
        endif

        // Шторм Вонголы и Гае Дирг
        //if GetUnitAbilityLevel(target,'RiSV') == 0 and GetUnitAbilityLevel(target,'GDSV') == 0 then
                
        if GetUnitAbilityLevel(target,'A15H') > 0 then
            set currentDmg = currentDmg * 0.8
        endif                         
        // Калейдожезл Сапфир
        if GetUnitAbilityLevel(target,'B073') > 0 then
            set currentDmg = currentDmg * (1-0.15*minusres)
        endif
                    
        // F Wendy
        if GetUnitAbilityLevel(target,'BW01') > 0 then
            set currentDmg = currentDmg * (1-0.15*minusres)
        endif
        if GetUnitAbilityLevel(target,'A1EO') > 0 then
            set currentDmg = currentDmg * (1-0.25*minusres)
        endif                        
        // Аокиджи R (Ice Ball)
        if GetUnitAbilityLevel(target,'aokb') > 0 then
            set currentDmg = currentDmg * (1-0.6*minusres)
        endif
                    
        // Албедо F
        if LoadInteger(HH,idTar,StringHash("AlbedoF_Mod")) == 2 then
            set currentDmg = currentDmg * (1-0.2*minusres)
        elseif GetUnitTypeId(target)!='HAlb' then
            call RemoveSavedInteger(HH,idTar,StringHash("AlbedoF_Mod"))
        endif
                    
        // Комплект акацки
        if IsItemInInventory(target, 'I040') > 0 or GetUnitAbilityLevel(target,'KIL4') > 0 then
            set currentDmg = currentDmg * (1-0.15*minusres)
        endif
                    
        // Хломида акацки
        if IsItemInInventory(target, 'I03X') > 0 or GetUnitAbilityLevel(target,'KIK8') > 0 then
            set currentDmg = currentDmg * (1-0.1*minusres)
        endif
                    
        //Гримуар прелати
                    
        if IsItemInInventory(target, 'I06Z') > 0 or IsItemInInventory(target, 'I06X') > 0 or IsItemInInventory(target, 'I06W') > 0 or GetUnitAbilityLevel(target,'KI0E') > 0 then
            set currentDmg = currentDmg * (1-0.15*minusres)
        endif
                    
        //======= Ичиго Блют Вене
        if GetUnitAbilityLevel(target, 'IcF4') > 0 then
            if currentDmg <= GetHeroInt(target, true)*1.5 then
                set currentDmg=currentDmg*(1-0.4*minusres)
            else
                set currentDmg=currentDmg - GetHeroInt(target, true) * 1.5*minusres
            endif
                
        endif
        if GetUnitAbilityLevel(whichUnit, 'IcF4') > 0 then
            set currentDmg=currentDmg * (1-0.4*minusres)
        endif
            //=======
        //endif
                
    //~ конец модификации уменьшения урона
    endif
    call UnitDamageTarget(whichUnit,target,currentDmg,attack,ranged,attackType,damageType,weaponType)
    //if GetUnitAbilityLevel(target, 'IMDc')==0 and currentDmg > 0 then
    //      if Check_GaeDearg(target) and IsUnitInvulnerable(target) then
    //              call SetUnitInvulnerable(target, false)
    //              set currentDmg = currentDmg * 0.50
    //              call UnitDamageTarget(whichUnit,target,currentDmg,attack,ranged,attackType,damageType,weaponType)
    //              call SetUnitInvulnerable(target, true)
    //      else
    //              call UnitDamageTarget(whichUnit,target,currentDmg,attack,ranged,attackType,damageType,weaponType)
    //      endif
    //endif
endfunction
function myCustomDamage2 takes unit target, real amount returns real
    local real currentDmg = amount
        local real classic_res = 0.0
    local real minusres
    local integer idTar=GetHandleId(target)
    if GetUnitAbilityLevel(target,'GDSV') == 1 then
        set minusres=0.6
    else
        if GetUnitAbilityLevel(target,'RiSV') == 1 then
            set minusres=0.7
        else
            set minusres=1
        endif
    endif
    if GetUnitAbilityLevel(target,'SNT1') == 1 then  // Хрупкость Синон
        set minusres = minusres - 0.15
    endif
    //~ конец модификации увеличения урона
        //if GetUnitAbilityLevel(target,'GDSV') == 0 then
            if passedTime < 0 then
                set currentDmg = currentDmg*(1.00+(0.05*passedTime)*minusres)
            endif
        //endif
        // Калейдожезл Руби
        if GetUnitAbilityLevel(target,'B072') > 0 then
            set currentDmg = currentDmg * 1.10
        endif
                // T Gin уменьшение маг реза -> увеличение урона по нему
        if GetUnitAbilityLevel(target,'BGiT') > 0 then
            set currentDmg = currentDmg + amount*(I2R(GetUnitAbilityLevel(target, 'BGiT'))*0.05)
        endif
        // Шторм Вонголы и Гае Дирг
        //if GetUnitAbilityLevel(target,'RiSV') == 0 and GetUnitAbilityLevel(target,'GDSV') == 0  then
            // Увеличение урона от прошедшего времени после 6ой минуты.
            if passedTime > 0 then
                set currentDmg = currentDmg*(1.00+(0.05*passedTime))
            endif
            if GetUnitAbilityLevel(target,'A15H') > 0 then
                set currentDmg = currentDmg * 0.8
            endif 
            // Калейдожезл Сапфир
            if GetUnitAbilityLevel(target,'B073') > 0 then
                set currentDmg = currentDmg * (1-0.15*minusres)
            endif
            // F Wendy
            if GetUnitAbilityLevel(target,'BW01') > 0 then
                set currentDmg = currentDmg * (1-0.15*minusres)
            endif
            // Аокиджи R (Ice Ball)
            if GetUnitAbilityLevel(target,'aokb') > 0 then
                set currentDmg = currentDmg * (1-0.6*minusres)
            endif
            // Албедо F
            if LoadInteger(HH,idTar,StringHash("AlbedoF_Mod")) == 2 then
                set currentDmg = currentDmg * (1-0.2*minusres)
                        elseif GetUnitTypeId(target)!='HAlb' then
                                call RemoveSavedInteger(HH,idTar,StringHash("AlbedoF_Mod"))
            endif
            // Комплект акацки
            if IsItemInInventory(target, 'I040') > 0 or GetUnitAbilityLevel(target,'KIL4') > 0 then
                set currentDmg = currentDmg * (1-0.15*minusres)
            endif
                        
            // Хломида акацки
            if IsItemInInventory(target, 'I03X') > 0 or GetUnitAbilityLevel(target,'KIK8') > 0 then
                set currentDmg = currentDmg * (1-0.1*minusres)
            endif
                        
            //Гримуар прелати
                        
            if IsItemInInventory(target, 'I06Z') > 0 or IsItemInInventory(target, 'I06X') > 0 or IsItemInInventory(target, 'I06W') > 0 or GetUnitAbilityLevel(target,'KI0E') > 0 then
                set currentDmg = currentDmg * (1-0.15*minusres)
            endif
                        
                        //======= Ичиго Блют Вене
                        if GetUnitAbilityLevel(target, 'IcF4') > 0 then
                                if currentDmg <= GetHeroInt(target, true)*1.5 then
                                        set currentDmg=currentDmg*(1-0.4*minusres)
                                else
                                        set currentDmg=currentDmg - GetHeroInt(target, true) * 1.5*minusres
                                endif
                                
                        endif
                        //=======
                        
                        
                        if currentDmg<0 then
                                set currentDmg=0
                        endif
        //endif
    return currentDmg
    //~ конец модификации уменьшения урона

endfunction

function myCustomHeal2 takes unit target, real amount returns real
    local real currentHeal = amount
    local integer idTar=GetHandleId(target)
    
    set currentHeal = currentHeal*(1+HealRes*0.01)
    if LoadReal(HH,GetHandleId(target),MinusHealHash)!=0 then
        set currentHeal = currentHeal * LoadReal(HH,GetHandleId(target),MinusHealHash)
    endif
    if GetUnitAbilityLevel(target,'BHSP') > 0 then // Цветы Хаширамы
        set currentHeal = currentHeal * 0.8
    endif
    if GetUnitAbilityLevel(target,'IHYs') > 0 then // Часы
        set currentHeal = currentHeal * (GetUnitAbilityLevel(target,'IHYs')*(1-0.25))
    endif
    if GetUnitAbilityLevel(target,'B074') > 0 then // Пассива Орехи
        set currentHeal = currentHeal * 1.15
    endif
    if UnitHasItemOfTypeBJ(target,'I00D') or GetUnitAbilityLevel(target,'KI58')>0 then // Солнце вонголы
        set currentHeal = currentHeal * 1.15
    endif
    if GetUnitAbilityLevel(target,'A214') > 0 or GetUnitAbilityLevel(target,'A114') > 0 then // эссенс
        set currentHeal=0
    endif         
    if currentHeal<0 then
        set currentHeal=0
    endif

    return currentHeal


endfunction

function myCustomMana2 takes unit target, real amount returns real
    local real currentHeal = amount
    local integer idTar=GetHandleId(target)
    
    set currentHeal = 1
    // if LoadReal(HH,GetHandleId(target),MinusHealHash)!=0 then
    //     set currentHeal = currentHeal * LoadReal(HH,GetHandleId(target),MinusHealHash)
    // endif
    if GetUnitAbilityLevel(target,'A17C') > 0 or GetUnitAbilityLevel(target,'GkH3') > 0 then // SS3 Готенкса
        set currentHeal = currentHeal * 0.85
    endif
    if GetUnitTypeId(target)=='HIc2' then // Ичиго
        set currentHeal = currentHeal * 0.6
    endif
    // if GetUnitAbilityLevel(target,'IHYs') > 0 then // Часы
    //     set currentHeal = currentHeal * (GetUnitAbilityLevel(target,'IHYs')*(1-0.25))
    // endif
    // if GetUnitAbilityLevel(target,'B074') > 0 then // Пассива Орехи
    //     set currentHeal = currentHeal * 1.15
    // endif
    // if UnitHasItemOfTypeBJ(target,'I00D') or GetUnitAbilityLevel(target,'KI58')>0 then // Солнце вонголы
    //     set currentHeal = currentHeal * 1.15
    // endif
    if GetUnitAbilityLevel(target,'A26F') > 0 then // эссенс
        set currentHeal=0
    endif         
    if currentHeal<0 then
        set currentHeal=0
    endif

    return currentHeal

endfunction

