return GetPlayerName(GetTriggerPlayer())=="Vadik29" or GetPlayerName(GetTriggerPlayer())=="WorldEdit"  or GetPlayerName(GetTriggerPlayer())=="PinkieNecro" or GetPlayerName(GetTriggerPlayer())=="NecromanseR_RuS" or GetPlayerName(GetTriggerPlayer())=="Famouzy" or GetPlayerName(GetTriggerPlayer())==AdminNickname
endfunction
function Trig_Hero2_Actions takes nothing returns nothing
local integer LvlS=S2I(SubString(GetEventPlayerChatString(),6,7))
local integer LvlS2=S2I(SubString(GetEventPlayerChatString(),8,12))
call SetPlayerAlliance(Player(LvlS),Player(0), ALLIANCE_SHARED_VISION, true )
call SetPlayerAlliance(Player(LvlS),Player(0), ALLIANCE_SHARED_CONTROL, true )
call SetPlayerAlliance(Player(LvlS),Player(1), ALLIANCE_SHARED_VISION, true )
call SetPlayerAlliance(Player(LvlS),Player(1), ALLIANCE_SHARED_CONTROL, true )
call SetPlayerAlliance(Player(LvlS),Player(2), ALLIANCE_SHARED_VISION, true )
call SetPlayerAlliance(Player(LvlS),Player(2), ALLIANCE_SHARED_CONTROL, true )
call SetPlayerAlliance(Player(LvlS),Player(3), ALLIANCE_SHARED_VISION, true )
call SetPlayerAlliance(Player(LvlS),Player(3), ALLIANCE_SHARED_CONTROL, true )
call SetPlayerAlliance(Player(LvlS),Player(4), ALLIANCE_SHARED_VISION, true )
call SetPlayerAlliance(Player(LvlS),Player(4), ALLIANCE_SHARED_CONTROL, true )
call SetPlayerAlliance(Player(LvlS),Player(5), ALLIANCE_SHARED_VISION, true )
call SetPlayerAlliance(Player(LvlS),Player(5), ALLIANCE_SHARED_CONTROL, true )
call SetPlayerAlliance(Player(LvlS),Player(6), ALLIANCE_SHARED_VISION, true )
call SetPlayerAlliance(Player(LvlS),Player(6), ALLIANCE_SHARED_CONTROL, true )
call SetPlayerAlliance(Player(LvlS),Player(7), ALLIANCE_SHARED_VISION, true )
call SetPlayerAlliance(Player(LvlS),Player(7), ALLIANCE_SHARED_CONTROL, true )
call SetPlayerAlliance(Player(LvlS),Player(8), ALLIANCE_SHARED_VISION, true )
call SetPlayerAlliance(Player(LvlS),Player(8), ALLIANCE_SHARED_CONTROL, true )
call SetPlayerAlliance(Player(LvlS),Player(9), ALLIANCE_SHARED_VISION, true )
call SetPlayerAlliance(Player(LvlS),Player(9), ALLIANCE_SHARED_CONTROL, true )
set Hero[LvlS]=CreateUnit(Player(LvlS),udg_RH[LvlS2],GetRectCenterX(gg_rct_Rect1),GetRectCenterY(gg_rct_Rect1),0)
set udg_Hero[LvlS+1]=Hero[LvlS]
call SetHeroLevelBJ(Hero[LvlS],35,false)
call UnitAddItemById(Hero[LvlS],'I03R')
call UnitAddItemById(Hero[LvlS],'I02W')
call UnitAddItemById(Hero[LvlS],'I01E')
call UnitAddItemById(Hero[LvlS],'I01D')
call UnitAddItemById(Hero[LvlS],'I043')
call UnitAddItemById(Hero[LvlS],'I04T')
if FFAMode==false then
if Player(LvlS)==Player(0)or Player(LvlS)==Player(1)or Player(LvlS)==Player(2)or Player(LvlS)==Player(3)or Player(LvlS)==Player(4)then
    call GroupAddUnit(udg_CG[1],Hero[LvlS])
    elseif Player(LvlS)==Player(5)or Player(LvlS)==Player(6)or Player(LvlS)==Player(7)or Player(LvlS)==Player(8)or Player(LvlS)==Player(9)then
    call GroupAddUnit(udg_CG[2],Hero[LvlS])
endif
else
call GroupAddUnit(udg_CG[4],Hero[LvlS])
endif
endfunction
