function KurapikaR2Act takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit target=LoadUnitHandle(HH,id,2)
local real facing=Angle2(GetUnitX(target),GetUnitY(target),LoadReal(HH,id,11),LoadReal(HH,id,12))+LoadInteger(HH,id,19)
local real time=LoadReal(HH,id,5)
local real dist=SR(GetUnitX(target),GetUnitY(target),LoadReal(HH,id,11),LoadReal(HH,id,12))
local lightning l=LoadLightningHandle(HH,id,16)
local real x0=0
local real y0=0
set time=time+0.02
call SaveReal(HH,id,5,time)
if time>0.02 then




call MoveUnit(target,LoadUnitHandle(HH,id,20),0,facing)

call SetUnitFlyHeight(LoadUnitHandle(HH,id,20),GetUnitFlyHeight(target)+100,0)
call MoveLightningEx(l,true,GetUnitX(caster),GetUnitY(caster),GetUnitFlyHeight(caster)+75,GetUnitX(target),GetUnitY(target),GetUnitFlyHeight(target)+75)
endif




if time>0.2 and dist<=100 or time>10+LoadReal(HH,id,24) then


if GetUnitTypeId(caster)=='H04O' then

set soundplay=CreateSound("Sound\\Music\\mp3Music\\KurapikaR2Hit.mp3",false,false,true,12700,12700,"")
