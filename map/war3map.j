function KireiTCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local integer idu=0
local real x=0
local real y=0
local group g=LoadGroupHandle(HH,id,2)
local group g2
local player p=GetOwningPlayer(u)
set g2=CopyGroup(g)
loop
set E=FirstOfGroup(g2)
set idu=GetHandleId(E)
set x=GetUnitX(E)
set y=GetUnitY(E)
exitwhen E==null
call SetUnitAnimation(E,"Spell One")
call SetUnitPathing(E,false)
call DestroyEffect(AddSpecialEffect("war3mapImported\\27.hy1.mdl",GetUnitX(E),GetUnitY(E)))
set n=CreateUnit(p,'eo2F',x,y,0)
call SetUnitTimeScale(n,1.5)
call SetUnitInvulnerable(n,true)
call UnitApplyTimedLife(n,'BTLF',0.5)
call KireiTSpy(u,LoadUnitHandle(HH,idu,0),E,GetRandomReal(500,900),0.5)
call GroupRemoveUnit(g2,E)
endloop
call DestroyGroupTimed(g2,3)
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(HH,id)
set p=null
set t=null
set g=null
set g2=null
set u=null
endfunction
