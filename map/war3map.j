function MesHeartKillCond takes nothing returns boolean
return GetUnitTypeId(GetTriggerUnit())=='h02Q' and udg_B
endfunction
function MesHeartKillAct takes nothing returns nothing
local unit u=GetKillingUnit()
local unit c=GetTriggerUnit()
local integer idc=GetPlayerId(GetOwningPlayer(c))
local integer idu=GetPlayerId(GetOwningPlayer(u))
if u!=null then
	call SaveBoolean(h,GetHandleId(c),SH_cond,true)
	call SetUnitInvulnerable(Hero[idc],false)
	call UnitRemoveBuffs(Hero[idc],true,false)
    if UnitHasItemOfTypeBJCustom(Hero[idc], 'I03A') and GetWidgetLife(Hero[idc])>0 and IsUnitIllusion(Hero[idc])==false then
        set AlastorPos=0
        loop
        exitwhen AlastorPos==10 or GetItemTypeId(UnitItemInSlot(Hero[idc],AlastorPos)) == 'I03A'
        set AlastorPos=AlastorPos+1
        endloop
        if IsAbilityEnabled(GetUnitAbility(Hero[idc],'AInv'))==true then
            set Alastor=GetItemOfTypeFromUnitBJCustom(Hero[idc],'I03A')
            call UnitRemoveItem(Hero[idc],Alastor)
            call RemoveItem(Alastor)
            call UnitAddItemToSlotById(Hero[idc], 'I03A',AlastorPos)
        else
            call EnableUnitAbility2(Hero[idc],'AInv',false,true)
            set Alastor=GetItemOfTypeFromUnitBJCustom(Hero[idc],'I03A')
            call UnitRemoveItem(Hero[idc],Alastor)
            call RemoveItem(Alastor)
            call UnitAddItemToSlotById(Hero[idc], 'I03A',AlastorPos)    
            call DisableUnitAbility2(Hero[idc],'AInv',false,true)
        endif
    endif
	call UnitAddAbility(Hero[idc],'A0WR')
	if GetUnitAbilityLevel(Hero[idc],'A18L')==0 then
        call CustomTrueDamage(u,Hero[idc], GetWidgetMaxLife(Hero[idc])*0.4)
	else
		call UnitRemoveAbility(Hero[idc],'A18L')
		call UnitRemoveAbility(Hero[idc],'A0WR')
		call SetUnitState(Hero[idc],UNIT_STATE_LIFE,1)
		call SetUnitState(Hero[idc],UNIT_STATE_MANA,0)
		call myCustomDamage(u,Hero[idc],100,false,false,null,null,null)
        call DamageIndicatorFunction(u, Hero[idc], GetWidgetMaxLife(Hero[idc])*0.4)
        call DamageTextTag(u, Hero[idc], GetWidgetMaxLife(Hero[idc])*0.4)
	endif
	call UnitRemoveAbility(Hero[idc],'A0WR')
endif
call RemoveSavedHandle(h,GetHandleId(u),SH_h)
set u=null
set c=null
endfunction
function MesHeartKillInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_DEATH,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function MesHeartKillAct)
call TriggerAddCondition(t,Condition(function MesHeartKillCond))
set t=null
endfunction
function MesCond takes nothing returns boolean
return GetSpellAbilityId()=='A0KB' and GetUnitTypeId(GetTriggerUnit())!='H03S' and GetUnitTypeId(GetTriggerUnit())!='H03W' and GetUnitTypeId(GetTriggerUnit())!='H03X' and GetUnitTypeId(GetTriggerUnit())!='H03V' and GetUnitTypeId(GetTriggerUnit())!='H03U' and udg_B==true
endfunction
function MesCast2 takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(h,id,0)
        local unit c=LoadUnitHandle(h,id,1)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        local real x1=GetUnitX(c)
        local real y1=GetUnitY(c)
        local real a=Atan2(y1-y,x1-x)
        local player p=GetOwningPlayer(u)
        local real time=LoadReal(h,id,2)
        if SR(x,y,x1,y1)>50 and time<3 and GetWidgetLife(c)>0 then
            call SaveReal(h,id,2,time+0.02)
            set x=x+60*Cos(a)
            set y=y+60*Sin(a)
            call SetUnitXY_1(u,x,y,false)
            call SetUnitFacing(u,a*bj_RADTODEG)
            set n=CreateUnit(p,'e0F7',x,y,a*bj_RADTODEG)
            call UnitApplyTimedLife(n,'BTLF',0.25)
            call SetUnitVertexColor(n,170,170,170,170)
            call SetUnitTimeScale(n,2)
            call SetUnitAnimation(n,"attack")
            call SetUnitAnimation(u,"attack")
        else
            if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
                if time>=2.96 then
                    call SetUnitXY_1(u,x1,y1,false)
                endif
                set n=CreateUnit(GetOwningPlayer(c),'h02Q',x1,y1,0)
                if RectContainsUnit(gg_rct_UBW2,c)==true then
                    call UnitAddAbility(n,'A0IH')
                endif
                call Push(n,50,LoadReal(h,id,9),400)
                call SaveUnitHandle(h,GetHandleId(u),SH_h,n)
                call UnitApplyTimedLife(n,'BTLF',10)
                call SaveUnitHandle(h,GetHandleId(c),SH_heart,n)
                if GetWidgetLife(c)>GetWidgetMaxLife(c)*0.2 then
                        call SetWidgetLife(c, GetWidgetLife(c)-GetWidgetMaxLife(c)*0.2)
                else
                        call SetWidgetLife(c, 1)
                endif
                call DamageIndicatorFunction(u, c, GetWidgetMaxLife(c)*0.2)
                call DamageTextTag(u, c, GetWidgetMaxLife(c)*0.2)
                call SetUnitState(n,UNIT_STATE_LIFE,GetWidgetMaxLife(c)*0.4)
                call SetUnitMaxLife(n,GetWidgetMaxLife(c)*0.4)
                call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",x1,y1))
                call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",x1,y1))
                call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",x1,y1))
                call PauseTimer(t)
                call DestroyTimer(t)
                call UnitRemoveAbility(u,'A0BX')
                call SetUnitTimeScale(u,1)
                call SetUnitPathing(u,true)
                call PauseUnit(u,false)
                call FlushChildHashtable(h,id)
                call SetUnitInvulnerable(u,false)
            else
                call SetUnitTimeScale(u,1)
                call SetUnitInvulnerable(u,false)
                call PauseUnit(u,false)
                call UnitRemoveAbility(u,'A0BX')
                call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
                call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
                call SetUnitFlyHeight(u,0,0)
                call SetUnitFlyHeight(c,0,0)
                call PauseTimer(t)
                call DestroyTimer(t)
                call FlushChildHashtable(h,id)
            endif
        endif
        set p=null
        set u=null
        set c=null
        set t=null
endfunction
function MesCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local integer id_caster=GetHandleId(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real Room_X = LoadReal(h, id_caster, SH_Room_X)
local real Room_Y = LoadReal(h, id_caster, SH_Room_Y)
local boolean bRoom = LoadBoolean(h, id_caster, SH_RoomBoolean)
local boolean bMassiveRoom = LoadBoolean(h, id_caster, SH_MassiveRoomBoolean)
local boolean bPullOut = false
if bMassiveRoom then
        set bPullOut = true
else
        if SquareRootPoint(GetUnitX(c), GetUnitY(c), Room_X, Room_Y)<=1000 and bRoom then
                set bPullOut = true
        endif
endif
if c==Hero[GetPlayerId(GetOwningPlayer(c))] and bPullOut then
        call SaveUnitHandle(h,id,0,u)
        call SetUnitPathing(u,false)
        call SetUnitAnimation(u,"spell two")
        call UnitAddAbility(u,'A0BX')
        call PauseUnit(u,true)
        call SaveReal(h,id,9,Atan2(GetUnitY(c)-y,GetUnitX(c)-x))
        call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e06H',x,y,GetRandomReal(0,359)),'BTLF',1)
        call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(u),'e06I',x,y,GetRandomReal(0,359)),'BTLF',1)
        call SetUnitTimeScale(u,5)
        call SetUnitInvulnerable(u,true)
        call SaveUnitHandle(h,id,1,c)
        set soundplay=SndN(1433) // Sound\Music\mp3Music\LawMes.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        call TimerStart(t,0.020,true,function MesCast2)
else
        call IssueImmediateOrder(u, "stop")
        call StartAbilityCooldown(GetUnitAbility(u, 'A0KB'), 0.5)
        call SetWidgetMana(u, GetWidgetMana(u)+350)
endif
set c=null
set u=null
set t=null
endfunction
function MesInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function MesCast)
call TriggerAddCondition(t,Condition(function MesCond))
set t=null
endfunction
