call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_HERO_SKILL)
call TriggerAddCondition(t,Condition(function LearnKiMasteryCond))
call TriggerAddAction(t,function LearnKiMasteryCast)
set t=null
endfunction
function CondInstantTransmissionGoku takes nothing returns boolean
return GetSpellAbilityId()=='GKR1' and udg_B==true
endfunction
function CastInstantTransmissionGoku2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local unit c=LoadUnitHandle(h,id,11)
local real a=LoadReal(h,id,4)
local real x1=GetUnitX(c)+70*Cos(a)
local real y1=GetUnitY(c)+70*Sin(a)
local real x2=GetUnitX(u)
local real y2=GetUnitY(u)
local real x3=GetUnitX(c)
local real y3=GetUnitY(c)
local real dmg=(1.5+GetUnitAbilityLevel(u,'GKR1')*0.5)*GetHeroStr(u,true)
local player p=GetOwningPlayer(u)
local real time=LoadReal(h,id,5)
local real starttime=LoadReal(h,id,6)
local real timeEnd=LoadReal(h,id,15)
if time<0.630 and GetAbilityIntegerLevelField(GetUnitAbility(u,'GKR1'), ABILITY_ILF_TARGET_TYPE,GetUnitAbilityLevel(u,'GKR1')-1)!=1 then
    call SaveReal(h,id,5,time+0.01)
    if time==starttime+0.02 then
        call SetUnitAnimationByIndex(u,199)
        call DisableUnitAbility2(u,'GKQ1',false,true)
        call DisableUnitAbility2(u,'GKW1',false,true)
        call DisableUnitAbility2(u,'GKW5',false,true)
        call DisableUnitAbility2(u,'GKE2',false,true)
        call DisableUnitAbility2(u,'GKE3',false,true)
        call DisableUnitAbility2(u,'GKE4',false,true)
        call DisableUnitAbility2(u,'GKE5',false,true)
        call DisableUnitAbility2(u,'GKE6',false,true)
        call DisableUnitAbility2(u,'GKT1',false,true)
        call DisableUnitAbility2(u,'GKF1',false,true)
        call DisableUnitAbility2(u,'GKG1',false,true)
        call DisableUnitAbility2(u,'GKG6',false,true)
        call DisableUnitAbility2(u,'GKG7',false,true)
        call UnitEnableInventoryCustom(u,false,false )
    endif
    if time==starttime+0.2 and starttime<-0.7 then
        call SetAbilityStringField(GetUnitAbility(u,'GKR1'),ABILITY_SF_ICON_NORMAL,"ReplaceableTextures\\CommandButtons\\BTNCancel1.blp")
        call SetAbilityRemainingCooldown(GetUnitAbility(u,'GKR1'),0.01)
    endif
    if time==starttime+1 and starttime<-0.7 then
        call SetUnitTimeScale(u,0)
    endif
    if time<0 then
        call SetUnitFacingInstant(u,a*bj_RADTODEG)
        if not(GetUnitState(u,UNIT_STATE_LIFE)>0.405 and IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'CBC2')==0 and GetUnitAbilityLevel(u,'cbc3')==0  and GetUnitAbilityLevel(u,'cbc5')==0  and GetUnitAbilityLevel(u, 'cbc7')==0 and GetUnitAbilityLevel(u, 'cbc8')==0 and GetUnitAbilityLevel(u, 'cbc9')==0 and UnitIsAlive(u) and udg_B and DU2 and timeEnd<1) then
            call SaveReal(h,id,5,20)
            call SetUnitAcquireRange(u,600)
        endif
        if IsUnitVisible(c,p) then
            call SaveReal(h,id,15,0)
        else
            call SaveReal(h,id,15,timeEnd+0.01)
        endif
    endif
    if time==0.01 then
        call UnitRemoveAbility(u,'A1FU') //Slow
        call UnitRemoveAbility(u,'B00A')
        call SetUnitAcquireRange(u,600)
        call SetUnitInvulnerable(u,true)
        call PauseUnit(u,true)
    endif
    if IsUnitEnemy(c,p) then
        if time==0.31 then
            call SetUnitInvulnerable(u,true)
            call PauseUnit(u,true)
            call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x2,y2))
            call SetUnitXY_1(u,x3+300*Cos(a),y3+300*Sin(a), false)
            call SetControlToUnit(u,c, 0.19, "heavystun")
            call SetUnitFlyHeight(u,GetUnitFlyHeight(c)+450,0)
            set EFF=AddSpecialEffect("war3mapImported\\BlackBlink.mdx", GetUnitX(u), GetUnitY(u))
            call SetSpecialEffectZ(EFF, GetUnitFlyHeight(u))
            call DestroyEffect(EFF)
            call StartSound(soundStr[54])
            set a=Atan2(GetUnitY(u)-y3,GetUnitX(u)-x3)
            call SaveReal(h,id,4,a)
            call SetUnitFacingInstant(u,a*bj_RADTODEG)
            call SetUnitTimeScale(u,2)
            call SetUnitAnimationByIndex(u,107)
        endif
        if time>0.36 and time<0.51 then
            call SetUnitInvulnerable(u,true)
            call PauseUnit(u,true) 
            set a=Atan2(GetUnitY(c)-GetUnitY(u),GetUnitX(c)-GetUnitX(u))
            call SaveReal(h,id,4,a)
            call SetUnitFacingInstant(u,a*bj_RADTODEG)
            call SetUnitXY_1(u,x2+(SR(x2,y2,x3,y3)/38)*Cos(a),y2+(SR(x2,y2,x3,y3)/38)*Sin(a), false)
            call SetUnitFlyHeight(u,GetUnitFlyHeight(u)-26,0)
        endif
        if time==0.51 or (time>0.36 and time<0.51 and GetUnitFlyHeight(u)+30<GetUnitFlyHeight(c)) then
            if IsUnitInvulnerable(c)==false and LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
                call SetUnitXY_1(u,GetUnitX(c)-65*Cos(a),GetUnitY(c)-65*Sin(a), false)
                call SaveReal(h,id,5,0.52)
                call SetUnitInvulnerable(u,true)
                call PauseUnit(u,true)
                call SetUnitTimeScale(u,1)
                if IsUnitInvulnerable(c)==false then
                    call myCustomDamage(u,c,dmg,false,false,null,null,null)
                    call SetControlToUnit(u,c, 0.5, "stun")
                    call Push9(c,55,a,1100)
                endif
                set EFF=AddSpecialEffect("chushou_by_wood_effect_earth_sandycrack_fag.mdl",x3,y3)
                call SetSpecialEffectScale(EFF , 0.6)
                call SetSpecialEffectZ(EFF, GetUnitFlyHeight(c))
                call RemoveEffect(EFF,1.5,false,CreateTimer())
                set EFF=AddSpecialEffect("war3mapImported\\CF2.mdl", x3,y3)
                call SetSpecialEffectOrientation(EFF,a*bj_RADTODEG,-45,0)
                call SetSpecialEffectZ(EFF, GetUnitFlyHeight(c))
                call SetSpecialEffectScale(EFF , 1)
                call DestroyEffect(EFF)
                set EFF=AddSpecialEffect("Minato-37.mdx", x3,y3)
                call SetSpecialEffectFacing(EFF , a* bj_RADTODEG)
                call SetSpecialEffectZ(EFF, GetUnitFlyHeight(c)+30)
                call SetSpecialEffectScale(EFF , 3)
                call DestroyEffect(EFF)
                set EFF=AddSpecialEffect("WindVectorPush.mdx", x1, y1)
                call SetSpecialEffectOrientation(EFF,a*bj_RADTODEG,-45,0)
                call SetSpecialEffectZ(EFF , GetUnitFlyHeight(c)+40)
                call SetSpecialEffectVertexColour(EFF,255,255,255,120)
                call RemoveEffect(EFF,1,true,CreateTimer())
            else
                if IsUnitInvulnerable(c)==true then
                    call SaveReal(h,id,5,20)
                    call SetUnitInvulnerable(u,false)
                    call PauseUnit(u,false)
                    call Push9(u,10,a,30)
                    call SetUnitAnimationByIndex(u,26)
                elseif LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==true then
                    call SaveReal(h,id,5,20)
                    call SetUnitInvulnerable(u,false)
                    call PauseUnit(u,false)
                    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
                    call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
                    call Push9(u,10,a,30)
                    call SetUnitAnimationByIndex(u,26)
                endif
            endif
        endif
        if time==0.55 then
            call SetUnitAnimationByIndex(u,68)
            call SetUnitFlyHeight(u,0,3000)
        endif
        if time==0.61 then
            call SetUnitInvulnerable(u,false)
            call PauseUnit(u,false)
            call UnitEnableInventoryCustom(u,true,false )
            set a=Atan2(y3-y2,x3-x2)
            call SaveReal(h,id,4,a)
            call SetUnitFacingInstant(u,a*bj_RADTODEG)
            if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
            //set soundplay=CreateSound("Sound\\Music\\mp3Music\\Warpkamehameha.mp3",false,false,true,12700,12700,"")
            else
            //set soundplay=CreateSound("Sound\\Music\\mp3Music\\Goku\\Warpkamehameha-jap.mp3",false,false,true,12700,12700,"")
            endif
            //call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay)
        endif
    else
        if time==0.31 then
            call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x2,y2))
            call SetUnitXY_1(u,x1,y1, false)
            set EFF=AddSpecialEffect("war3mapImported\\BlackBlink.mdx", GetUnitX(u), GetUnitY(u))
            call SetSpecialEffectZ(EFF, GetUnitFlyHeight(u))
            call DestroyEffect(EFF)
            call StartSound(soundStr[54])
            set a=Atan2(GetUnitY(u)-y3,GetUnitX(u)-x3)
            call SaveReal(h,id,4,a)
            call SetUnitFacingInstant(u,a*bj_RADTODEG)
            call SetUnitTimeScale(u,1)
            call SetUnitInvulnerable(u,false)
            call PauseUnit(u,false)
            call UnitEnableInventoryCustom(u,true,false )
            call SaveReal(h,id,5,20)
        endif
    endif
else
    if GetAbilityIntegerLevelField(GetUnitAbility(u,'GKR1'), ABILITY_ILF_TARGET_TYPE,GetUnitAbilityLevel(u,'GKR1')-1)!=1 and timeEnd<1 then
        call SetAbilityRemainingCooldown(GetUnitAbility(u,'GKR1'),GetAbilityBaseRealLevelFieldById('GKR1',ABILITY_RLF_COOLDOWN,GetUnitAbilityLevel(u,'GKR1')-1))
        if LoadBoolean(HH,GetHandleId(u),ITRangeHash) then
            if GetUnitState(u,UNIT_STATE_MANA)>GetUnitState(u,UNIT_STATE_MAX_MANA)*0.05 then
                call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.05)
            else
                call SetUnitState(u,UNIT_STATE_MANA,1)
            endif
        else
            if GetUnitState(u,UNIT_STATE_MANA)>GetUnitState(u,UNIT_STATE_MAX_MANA)*0.1 then
                call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.1)
            else
                call SetUnitState(u,UNIT_STATE_MANA,1)
            endif
        endif
    else
        call SetAbilityRemainingCooldown(GetUnitAbility(u,'GKR1'),5)
    endif
    call PauseTimer(t)
    call DestroyTimer(t)
    call EnableUnitAbility2(u,'GKQ1',false,true)
    call EnableUnitAbility2(u,'GKW1',false,true)
    call EnableUnitAbility2(u,'GKW5',false,true)
    call EnableUnitAbility2(u,'GKE2',false,true)
    call EnableUnitAbility2(u,'GKE3',false,true)
    call EnableUnitAbility2(u,'GKE4',false,true)
    call EnableUnitAbility2(u,'GKE5',false,true)
    call EnableUnitAbility2(u,'GKE6',false,true)
    call EnableUnitAbility2(u,'GKT1',false,true)
    call EnableUnitAbility2(u,'GKF1',false,true)
    call EnableUnitAbility2(u,'GKG1',false,true)
    call EnableUnitAbility2(u,'GKG6',false,true)
    call EnableUnitAbility2(u,'GKG7',false,true)
    call UnitEnableInventoryCustom(u,true,false )
    call UnitRemoveAbility(u,'A1FU')
    call UnitRemoveAbility(u,'B00A')
    call SetAbilityStringField(GetUnitAbility(u,'GKR1'),ABILITY_SF_ICON_NORMAL,"ReplaceableTextures\\CommandButtons\\BTNInstant_transmission.blp")
    call SetAbilityStringLevelField(GetUnitAbility(u,'GKR1'),ABILITY_SLF_TOOLTIP_NORMAL,GetUnitAbilityLevel(u,'GKR1')-1,GetAbilityBaseStringLevelFieldById('GKR1',ABILITY_SLF_TOOLTIP_NORMAL,GetUnitAbilityLevel(u,'GKR1')-1))
    call SetAbilityStringLevelField(GetUnitAbility(u,'GKR1'),ABILITY_SLF_TOOLTIP_NORMAL_EXTENDED,GetUnitAbilityLevel(u,'GKR1')-1,GetAbilityBaseStringLevelFieldById('GKR1',ABILITY_SLF_TOOLTIP_NORMAL_EXTENDED,GetUnitAbilityLevel(u,'GKR1')-1))
    call SetAbilityIntegerLevelField(GetUnitAbility(u,'GKR1'), ABILITY_ILF_TARGET_TYPE,GetUnitAbilityLevel(u,'GKR1')-1,1)
    call SetUnitAnimation(u,"stand")
    call SetUnitTimeScale(u,1)
    call FlushChildHashtable(h,id)
endif
set u=null
set c=null
set t=null
set p=null
    set l__d=null
endfunction
function CastInstantTransmissionGoku takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1
local real y1
local real a
local player p=GetOwningPlayer(u)
if GetAbilityIntegerLevelField(GetUnitAbility(u,'GKR1'), ABILITY_ILF_TARGET_TYPE,GetUnitAbilityLevel(u,'GKR1')-1)==1 then
    set c=GetSpellTargetUnit()
    set x1=GetUnitX(c)
    set y1=GetUnitY(c)
    set a=Atan2(y1-y,x1-x)
    if SquareRootUnit(u,c)<1000 then
        call SaveBoolean(HH,GetHandleId(u),ITRangeHash,true)
    else
        call SaveBoolean(HH,GetHandleId(u),ITRangeHash,false)
    endif
    if GetUnitAbilityLevel(u,'Pet1')==0 then
        call SetAbilityIntegerLevelField(GetUnitAbility(u,'GKR1'), ABILITY_ILF_TARGET_TYPE,GetUnitAbilityLevel(u,'GKR1')-1,0)
        call SaveUnitHandle(h,id,0,u)
        call SaveUnitHandle(h,id,11,c)
        call SaveReal(h,id,4,a)
        call UnitAddAbility(u,'A1FU') //Slow
        call SetUnitAcquireRange(u,51)
        if SquareRootUnit(u,c)<1000 then
            call SaveReal(h,id,5,0)
            call SetUnitInvulnerable(u,true)
            call PauseUnit(u,true)
        else
            call SetAbilityStringLevelField(GetUnitAbility(u,'GKR1'),ABILITY_SLF_TOOLTIP_NORMAL,GetUnitAbilityLevel(u,'GKR1')-1,GetAbilityBaseStringLevelFieldById('GKR2',ABILITY_SLF_TOOLTIP_NORMAL,0))
            call SetAbilityStringLevelField(GetUnitAbility(u,'GKR1'),ABILITY_SLF_TOOLTIP_NORMAL_EXTENDED,GetUnitAbilityLevel(u,'GKR1')-1,GetAbilityBaseStringFieldById('GKR2',ABILITY_SLF_TOOLTIP_NORMAL_EXTENDED))
            if SquareRootUnit(u,c)<8000 then
                call SaveReal(h,id,5,-0.001*((SquareRootUnit(u,c)-1000-ModuloReal(SquareRootUnit(u,c),10))))
                call SaveReal(h,id,6,-0.001*((SquareRootUnit(u,c)-1000-ModuloReal(SquareRootUnit(u,c),10))))
            else
                call SaveReal(h,id,5,-7)
                call SaveReal(h,id,6,-7)
            endif
        endif
        call TimerStart(t,0.01,true,function CastInstantTransmissionGoku2)
    else
        call DestroyTimer(t)
        call SaveBoolean(HH,GetHandleId(p),WarpKamehamehaHash,true)
        call SaveUnitHandle(HH,GetHandleId(p),WarpKamehamehaTargetHash,c)
    endif
else
    call DestroyTimer(t)
    call EnableUnitAbility2(u,'GKQ1',false,true)
    call EnableUnitAbility2(u,'GKW1',false,true)
    call EnableUnitAbility2(u,'GKW5',false,true)
    call EnableUnitAbility2(u,'GKE2',false,true)
    call EnableUnitAbility2(u,'GKE3',false,true)
    call EnableUnitAbility2(u,'GKE4',false,true)
    call EnableUnitAbility2(u,'GKE5',false,true)
    call EnableUnitAbility2(u,'GKE6',false,true)
    call EnableUnitAbility2(u,'GKT1',false,true)
    call EnableUnitAbility2(u,'GKF1',false,true)
    call EnableUnitAbility2(u,'GKG1',false,true)
    call EnableUnitAbility2(u,'GKG6',false,true)
    call EnableUnitAbility2(u,'GKG7',false,true)
    call SetAbilityStringLevelField(GetUnitAbility(u,'GKR1'),ABILITY_SLF_TOOLTIP_NORMAL,GetUnitAbilityLevel(u,'GKR1')-1,GetAbilityBaseStringLevelFieldById('GKR1',ABILITY_SLF_TOOLTIP_NORMAL,GetUnitAbilityLevel(u,'GKR1')-1))
    call SetAbilityStringLevelField(GetUnitAbility(u,'GKR1'),ABILITY_SLF_TOOLTIP_NORMAL_EXTENDED,GetUnitAbilityLevel(u,'GKR1')-1,GetAbilityBaseStringLevelFieldById('GKR1',ABILITY_SLF_TOOLTIP_NORMAL_EXTENDED,GetUnitAbilityLevel(u,'GKR1')-1))
    call SetAbilityIntegerLevelField(GetUnitAbility(u,'GKR1'), ABILITY_ILF_TARGET_TYPE,GetUnitAbilityLevel(u,'GKR1')-1,1)
endif
set u=null
set c=null
set p=null
set t=null
endfunction
function InstantTransmissionGokuInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function CastInstantTransmissionGoku)
call TriggerAddCondition(t,Condition(function CondInstantTransmissionGoku))
set t=null
endfunction
function CondFusionDance takes nothing returns boolean
return GetSpellAbilityId()=='A0P3' and udg_B==true and GetUnitTypeId(GetSpellTargetUnit())=='H02H' or GetUnitTypeId(GetSpellTargetUnit())=='H02I' and(GetUnitAbilityLevel(GetTriggerUnit(),'VGH4')>0 and GetUnitAbilityLevel(GetSpellTargetUnit(),'A0NJ')>0) or (GetUnitAbilityLevel(GetTriggerUnit(),'A0NJ')>0 or GetUnitAbilityLevel(GetSpellTargetUnit(),'VGH4')>0)
endfunction
function FusionDanceYes2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local unit l__d=LoadUnitHandle(h,id,3)
local real time=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
if UnitIsAlive(l__d)and time>0 and udg_B==true and DU2==true then
call SaveReal(h,id,2,time-0.1)
call PauseUnit(u,true)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call ShowUnit(c,false)
call ShowUnit(u,false)
else
call PauseUnit(u,false)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call ShowUnit(c,true)
call ShowUnit(u,true)
call SetUnitInvulnerable(u,false)
call SetUnitInvulnerable(c,false)
call SetUnitXY_1(u,x,y, false)
call SetUnitXY_1(c,x,y, false)
call SetUnitState(u,UNIT_STATE_MANA,GetWidgetMana(u)*0.5)
call SetUnitState(c,UNIT_STATE_MANA,GetWidgetMana(c)*0.5)
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
endif
set t=null
set u=null
set c=null
set l__d=null
endfunction
function FusionDanceYes takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local timer tt=CreateTimer()
local integer idt=GetHandleId(tt)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real x2=0
local real y2=0
local real a=Atan2(y1-y,x1-x)
local real dist=SR(x,y,x1,y1)
local player p=GetOwningPlayer(u)
call SaveUnitHandle(h,idt,0,u)
call SaveUnitHandle(h,idt,1,c)
call SaveReal(h,idt,2,35)
set x2=x1+dist*0.5*Cos(a)
set y2=y1+dist*0.5*Sin(a)
set n=CreateUnit(GetOwningPlayer(u),'H03K',x2,y2,GetUnitFacing(u)+90)
call SetHeroLevel(n,R2I((GetHeroLevel(u)+GetHeroLevel(c))*0.5),false)
call SetHeroStr(n,GetHeroStr(u,true)+GetHeroStr(c,true),true)
call SetHeroAgi(n,GetHeroAgi(u,true)+GetHeroAgi(c,true),true)
call SetHeroInt(n,GetHeroInt(u,true)+GetHeroInt(c,true),true)
call SetUnitState(n,UNIT_STATE_LIFE,GetWidgetLife(u)+GetWidgetLife(c))
call SetUnitState(n,UNIT_STATE_MANA,GetWidgetMana(u)+GetWidgetMana(c))
call SaveUnitHandle(h,idt,3,n)
call SaveUnitHandle(h,GetHandleId(n),SH_Goku,u)
call SaveUnitHandle(h,GetHandleId(n),SH_Vegeta,c)
call UnitApplyTimedLife(n,'BTLF',25)
call AddUnitAnimationProperties(n,"alternate",true)
call UnitRemoveAbility(n,'A16X')
call UnitAddAbility(n,'A171')
call UnitMakeAbilityPermanent(n,true,'A171')
call SetUnitAbilityLevel(n,'A0P9',5)
call SetUnitAbilityLevel(n,'A0P8',5)
call SetUnitAbilityLevel(n,'A0P7',5)
call SetUnitAbilityLevel(n,'A0P6',5)
call SetUnitAbilityLevel(n,'A0P5',5)
set n=CreateUnit(p,'e0NB',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,0.7)
set n=CreateUnit(p,'e0NC',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',2)
set n=CreateUnit(p,'e0NE',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,0.8)
set n=CreateUnit(p,'e0ND',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,0.8)
set n=CreateUnit(p,'e0NB',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,0.8)
set n=CreateUnit(p,'e0NF',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,0.7)
call DialogDestroy(LoadDialogHandle(h,id,2))
call FlushChildHashtable(h,id)
call TriggerClearActions(t)
call DestroyTrigger(t)
call TimerStart(tt,0.1,true,function FusionDanceYes2)
call ShowUnit(c,false)
call ShowUnit(u,false)
call SetUnitInvulnerable(u,true)
call SetUnitInvulnerable(c,true)
set t=null
set p=null
set c=null
set u=null
set d=null
set tt=null
endfunction
function FusionDanceNo takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer id=GetHandleId(t)
call DialogDestroy(LoadDialogHandle(h,id,2))
call PauseUnit(LoadUnitHandle(h,id,0),false)
call PauseUnit(LoadUnitHandle(h,id,1),false)
set t=null
endfunction
function CastFusionDance takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local dialog l__d=DialogCreate()
local trigger t=CreateTrigger()
local trigger t2=CreateTrigger()
local integer id=GetHandleId(t)
local button array b
call DialogClear(l__d)
call PauseUnit(u,true)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call DialogSetMessage(l__d,"Transformation to Gogeta?")
set b[1]=DialogAddButton(l__d,"Yes",0)
set b[2]=DialogAddButton(l__d,"No",0)
call TriggerRegisterDialogButtonEvent(t,b[1])
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveDialogHandle(h,id,2,l__d)
call TriggerRegisterDialogButtonEvent(t2,b[2])
call DialogDisplay(GetOwningPlayer(c),l__d,true)
call TriggerAddAction(t,function FusionDanceYes)
call TriggerAddAction(t2,function FusionDanceNo)
set u=null
set c=null
set t=null
set t2=null
set b[1]=null
set b[2]=null
set l__d=null
endfunction
function FusionDanceInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function CastFusionDance)
call TriggerAddCondition(t,Condition(function CondFusionDance))
set t=null
endfunction
function PowerDownVegeta takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
    if GetUnitAbilityLevel(u,'VGH1')>0 then
        call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.0003)
    endif
    if GetUnitAbilityLevel(u,'VGH2')>0 then
        call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.0005)
    endif
    if GetUnitAbilityLevel(u,'VGH3')>0 then
        call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.0008)
    endif
    if GetUnitAbilityLevel(u,'VGH4')>0 then
        call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.001)
    endif
    if GetUnitAbilityLevel(u,'VGH5')>0 then
        call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.0009)
    endif
    if GetUnitAbilityLevel(u,'VGH6')>0 then
        call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.00135)
    endif
else
    if GetUnitState(u,UNIT_STATE_MAX_MANA)*0.05>GetUnitState(u,UNIT_STATE_MANA) then
        if GetUnitAbilityLevel(u,'VGH1')>0 then
            call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.00015)
        endif
        if GetUnitAbilityLevel(u,'VGH2')>0 then
            call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.00025)
        endif
        if GetUnitAbilityLevel(u,'VGH3')>0 then
            call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.0004)
        endif
        if GetUnitAbilityLevel(u,'VGH4')>0 then
            call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.0005)
        endif
        if GetUnitAbilityLevel(u,'VGH5')>0 then
            call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.00045)
        endif
        if GetUnitAbilityLevel(u,'VGH6')>0 then
            call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-GetUnitState(u,UNIT_STATE_MAX_MANA)*0.000675)
        endif
    endif
endif
if GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.1>GetUnitState(u,UNIT_STATE_LIFE) or GetUnitState(u,UNIT_STATE_MAX_MANA)*0.04>GetUnitState(u,UNIT_STATE_MANA) or LoadBoolean(HH,GetHandleId(u),SST)==true then
if GetUnitAbilityLevel(u,'VGH4')>0 then
call ShowAbility2Timed('VGBB',false,4.95)
call ShowAbility2Timed('VGF1',true,4.97)
endif
call SaveBoolean(HH,GetHandleId(u),SS,false)
call SaveBoolean(HH,GetHandleId(u),SST,false)
call UnitRemoveAbility(u,'VGH0')
call UnitRemoveAbility(u,'VGH1')
call UnitRemoveAbility(u,'VGH2')
call UnitRemoveAbility(u,'VGH3')
call UnitRemoveAbility(u,'VGH4')
call UnitRemoveAbility(u,'VGH5')
call UnitRemoveAbility(u,'VGH6')
call ShowAbility2('VGSS',true)
call ShowAbility2('VGS2',true)
call ShowAbility2('VGS3',true)
call ShowAbility2('VGS4',true)
call UnitAddAbility(u,'VGH0')
call AddUnitAnimationProperties(u,"alternate",false)
call SetUnitAbilityLevel(u,'A3NM',1)
call UnitMakeAbilityPermanent(u,true,'VGH0')
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set t=null
set u=null
endfunction
function PowerUpVegetaCond takes nothing returns boolean
return (GetSpellAbilityId()=='VGBS' or GetSpellAbilityId()=='VGBB' or GetSpellAbilityId()=='VGSS' or GetSpellAbilityId()=='VGS2' or GetSpellAbilityId()=='VGS3' or GetSpellAbilityId()=='VGSR' or GetSpellAbilityId()=='VGSB' or GetSpellAbilityId()=='VGS4') and udg_B==true
endfunction
function PowerUpVegetaCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local timer tt=CreateTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real time=LoadReal(h,id,1)
if time<0.1 then
call PauseUnit(u,true)
call SaveReal(h,id,1,time+0.025)
else
call PauseUnit(u,false)
call SetUnitTimeScale(u,1)
call SetUnitAbilityLevel(u,'A3NM',LoadInteger(h,id,3)+1)
if LoadInteger(h,id,3)==1 and GetUnitAbilityLevel(u,'VGH1')==0 then //ss
    set EFF=AddSpecialEffect("Yellow--zhendi.mdl", x, y)
    call DestroyEffect(EFF)
    call UnitRemoveAbility(u,'VGH0')
    call UnitRemoveAbility(u,'VGH1')
    call UnitRemoveAbility(u,'VGH2')
    call UnitRemoveAbility(u,'VGH3')
    call UnitRemoveAbility(u,'VGH4')
    call UnitRemoveAbility(u,'VGH5')
    call UnitRemoveAbility(u,'VGH6')
    call UnitAddAbility(u,'VGH1')
    call UnitMakeAbilityPermanent(u,true,'VGH1')
    call StartSound(soundStr[90])
elseif LoadInteger(h,id,3)==2 and GetUnitAbilityLevel(u,'VGH2')==0 then //ss2
    set EFF=AddSpecialEffect("Yellow--zhendi.mdl", x, y)
    call DestroyEffect(EFF)
    call UnitRemoveAbility(u,'VGH0')
    call UnitRemoveAbility(u,'VGH1')
    call UnitRemoveAbility(u,'VGH2')
    call UnitRemoveAbility(u,'VGH3')
    call UnitRemoveAbility(u,'VGH4')
    call UnitRemoveAbility(u,'VGH5')
    call UnitRemoveAbility(u,'VGH6')
    call UnitAddAbility(u,'VGH2')
    call UnitMakeAbilityPermanent(u,true,'VGH2')
    call StartSound(soundStr[90])
elseif LoadInteger(h,id,3)==3 and GetUnitAbilityLevel(u,'VGH3')==0 then //ss3
    call FrozenMinusManaSS3Cast(u)
    set EFF=AddSpecialEffect("Yellow--zhendi.mdl", x, y)
    call DestroyEffect(EFF)
    call UnitRemoveAbility(u,'VGH0')
    call UnitRemoveAbility(u,'VGH1')
    call UnitRemoveAbility(u,'VGH2')
    call UnitRemoveAbility(u,'VGH3')
    call UnitRemoveAbility(u,'VGH4')
    call UnitRemoveAbility(u,'VGH5')
    call UnitRemoveAbility(u,'VGH6')
    call UnitAddAbility(u,'VGH3')
    call UnitMakeAbilityPermanent(u,true,'VGH3')
    call StartSound(soundStr[90])
elseif LoadInteger(h,id,3)==4 and GetUnitAbilityLevel(u,'VGH4')==0 then //ss4
    set EFF=AddSpecialEffect("Orange--zhendi.mdl", x, y)
    call DestroyEffect(EFF)
    call UnitRemoveAbility(u,'VGH0')
    call UnitRemoveAbility(u,'VGH1')
    call UnitRemoveAbility(u,'VGH2')
    call UnitRemoveAbility(u,'VGH3')
    call UnitRemoveAbility(u,'VGH4')
    call UnitRemoveAbility(u,'VGH5')
    call UnitRemoveAbility(u,'VGH6')
    call UnitAddAbility(u,'VGH4')
    call UnitMakeAbilityPermanent(u,true,'VGH4')
    call AddUnitAnimationProperties(u,"alternate",true)
    call ShowAbility2('VGF1',false)
    call ShowAbility2('VGBB',true)
    call StartSound(soundStr[90])
elseif LoadInteger(h,id,3)==5 and GetUnitAbilityLevel(u,'VGH5')==0 then //ssg
    set EFF=AddSpecialEffect("red-zhendi.mdx", x, y)
    call DestroyEffect(EFF)
    call UnitRemoveAbility(u,'VGH0')
    call UnitRemoveAbility(u,'VGH1')
    call UnitRemoveAbility(u,'VGH2')
    call UnitRemoveAbility(u,'VGH3')
    call UnitRemoveAbility(u,'VGH4')
    call UnitRemoveAbility(u,'VGH5')
    call UnitRemoveAbility(u,'VGH6')
    call UnitAddAbility(u,'VGH5')
    call UnitMakeAbilityPermanent(u,true,'VGH5')
    call ShowAbility2('VGSS',false)
    call ShowAbility2('VGS2',false)
    call ShowAbility2('VGS3',false)
    call ShowAbility2('VGS4',false)
    call StartSound(soundStr[90])
elseif LoadInteger(h,id,3)==6 and GetUnitAbilityLevel(u,'VGH6')==0 then //ssgss
    set EFF=AddSpecialEffect("Blue--zhendi.mdx", x, y)
    call DestroyEffect(EFF)
    call UnitRemoveAbility(u,'VGH0')
    call UnitRemoveAbility(u,'VGH1')
    call UnitRemoveAbility(u,'VGH2')
    call UnitRemoveAbility(u,'VGH3')
    call UnitRemoveAbility(u,'VGH4')
    call UnitRemoveAbility(u,'VGH5')
    call UnitRemoveAbility(u,'VGH6')
    call UnitAddAbility(u,'VGH6')
    call UnitMakeAbilityPermanent(u,true,'VGH6')
    call ShowAbility2('VGSS',false)
    call ShowAbility2('VGS2',false)
    call ShowAbility2('VGS3',false)
    call ShowAbility2('VGS4',false)
    call StartSound(soundStr[90])
endif
if LoadInteger(h,id,3)==0 and GetUnitAbilityLevel(u,'VGH0')==0 then
call StartSound(soundStr[89]) 
endif
if LoadBoolean(HH,GetHandleId(u),SS)==false then
call SaveUnitHandle(h,GetHandleId(tt),0,u)
call SaveBoolean(HH,GetHandleId(u),SS,true)
call TimerStart(tt,0.1,true,function PowerDownVegeta)
endif
if LoadInteger(h,id,3)==0 then
call SaveBoolean(HH,GetHandleId(u),SST,true)
endif
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set tt=null
set u=null
set t=null
endfunction
function PowerUpVegetaCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
call SaveUnitHandle(h,id,0,u)
if (GetSpellAbilityId()=='VGSS' and GetUnitAbilityLevel(u,'VGH1')==0) or (GetSpellAbilityId()=='VGS2' and GetUnitAbilityLevel(u,'VGH2')==0) or (GetSpellAbilityId()=='VGS3' and GetUnitAbilityLevel(u,'VGH3')==0) or GetSpellAbilityId()=='VGS4' or (GetSpellAbilityId()=='VGSR' and GetUnitAbilityLevel(u,'VGH5')==0) or (GetSpellAbilityId()=='VGSB' and GetUnitAbilityLevel(u,'VGH6')==0) then
    call SaveReal(h,id,1,0)
    call ShowAbility2('VGF1',false)
    call ShowAbility2Timed('VGF1',true,0.025)
    //call UnitApplyTimedLife(CreateUnit(p,'e0LK',x,y,0),'BTLF',0.3)
    call UnitApplyTimedLife(CreateUnit(p,'e0LM',x,y,0),'BTLF',0.35)
elseif GetSpellAbilityId()=='VGBS' or GetSpellAbilityId()=='VGBB' then
    call SaveReal(h,id,1,0.075)
    call SaveInteger(h,id,3,0)
else
    call ShowAbility2('VGF1',false)
    call ShowAbility2Timed('VGF1',true,0.02)
    call SaveReal(h,id,1,0.1)
endif
if GetSpellAbilityId()=='VGSS' then
    call SaveInteger(h,id,3,1)
elseif GetSpellAbilityId()=='VGS2' then
    call SaveInteger(h,id,3,2)
elseif GetSpellAbilityId()=='VGS3' then
    call SaveInteger(h,id,3,3)
elseif GetSpellAbilityId()=='VGS4' then
    call SaveInteger(h,id,3,4)
elseif GetSpellAbilityId()=='VGSR' then
    call SaveInteger(h,id,3,5)
elseif GetSpellAbilityId()=='VGSB' then
    call SaveInteger(h,id,3,6)
endif
call SetUnitTimeScale(u,0.5)
call TimerStart(t,0.025,true,function PowerUpVegetaCast2)
set u=null
set p=null
set t=null
endfunction
function PowerUpVegetaInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function PowerUpVegetaCast)
call TriggerAddCondition(t,Condition(function PowerUpVegetaCond))
set t=null
endfunction
function FinalKamehamehaCond takes nothing returns boolean
return GetSpellAbilityId()=='A0IV'
endfunction
function FinalKamehamehaCircle2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local integer idu=GetHandleId(u)
local unit uHero=LoadUnitHandle(HH,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(HH,idu,3)
local real y1=LoadReal(HH,idu,4)
local real a=Atan2(y1-y,x1-x)
if LoadReal(HH,idu,TIME_HASH)<1.5 then
    if SquareRootPoint(x,y,x1,y1)>85 then
        call IssueImmediateOrder(u,"stop")
        call SetUnitXY_1(u,x+80*Cos(a),y+80*Sin(a),false)
    else
        call SetUnitXY_1(u,x1,y1,false)
        call SaveBoolean(HH,idu,2,false)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(HH,id)
    endif
else
    call SaveBoolean(HH,idu,2,false)
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(HH,id)
endif
set t=null
set u=null
set uHero=null
endfunction
function FinalKamehamehaCircle takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local integer idu=GetHandleId(u)
local unit uHero=LoadUnitHandle(HH,idu,VegitoT_Circle)
local real time=LoadReal(HH,idu,TIME_HASH)
if time<1.5 then
    if LoadBoolean(HH,idu,2)==false then
        call SaveBoolean(HH,idu,2,true)
        call SaveUnitHandle(HH,id,0,u)
        call SaveUnitHandle(HH,id,1,uHero)
        if GetOrderTargetUnit()==null then
            call SaveReal(HH,idu,3,GetOrderPointX())
            call SaveReal(HH,idu,4,GetOrderPointY())
        else
            call SaveReal(HH,idu,3,GetUnitX(GetOrderTargetUnit()))
            call SaveReal(HH,idu,4,GetUnitY(GetOrderTargetUnit()))
        endif
        if SquareRootPoint(GetUnitX(uHero), GetUnitY(uHero), LoadReal(HH,idu,3), LoadReal(HH,idu,4))>1100 then
            call SaveReal(HH,idu,3,GetUnitX(uHero)+1100*Cos(AP(GetUnitX(uHero), GetUnitY(uHero), LoadReal(HH,idu,3), LoadReal(HH,idu,4))))
            call SaveReal(HH,idu,4,GetUnitY(uHero)+1100*Sin(AP(GetUnitX(uHero), GetUnitY(uHero), LoadReal(HH,idu,3), LoadReal(HH,idu,4))))
        endif
        call TimerStart(t,0.05,true,function FinalKamehamehaCircle2)
    else
        if GetOrderTargetUnit()==null then
            call SaveReal(HH,idu,3,GetOrderPointX())
            call SaveReal(HH,idu,4,GetOrderPointY())
        else
            call SaveReal(HH,idu,3,GetUnitX(GetOrderTargetUnit()))
            call SaveReal(HH,idu,4,GetUnitY(GetOrderTargetUnit()))
        endif
        if SquareRootPoint(GetUnitX(uHero), GetUnitY(uHero), LoadReal(HH,idu,3), LoadReal(HH,idu,4))>1100 then
            call SaveReal(HH,idu,3,GetUnitX(uHero)+1100*Cos(AP(GetUnitX(uHero), GetUnitY(uHero), LoadReal(HH,idu,3), LoadReal(HH,idu,4))))
            call SaveReal(HH,idu,4,GetUnitY(uHero)+1100*Sin(AP(GetUnitX(uHero), GetUnitY(uHero), LoadReal(HH,idu,3), LoadReal(HH,idu,4))))
        endif
        call DestroyTimer(t)
    endif
else
    call SaveReal(HH,idu,3,GetUnitX(u))
    call SaveReal(HH,idu,4,GetUnitY(u))
    call DestroyTimer(t)
endif
set t=null
set u=null
set uHero=null
endfunction
function FinalKamehamehaCast3 takes nothing returns nothing
local timer t2=GetExpiredTimer()
local integer id1=GetHandleId(t2)
local unit u=LoadUnitHandle(h,id1,0)
call UnitEnableAutoOrientation(u,true)
call SetUnitInvulnerable(u,false)
call SetUnitFlyHeight(u,0,2000)
call SetUnitTimeScale(u,1)
call PauseUnit(u,false)
call DestroyTimer(t2)
call FlushChildHashtable(h,id1)
set u=null
endfunction
function FinalKamehamehaCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local timer t2=CreateTimer()
local integer id=GetHandleId(t)
local integer id1=GetHandleId(t2)
local unit u=LoadUnitHandle(h,id,0)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real z=GetUnitZCustom(u)
local unit l__d=LoadUnitHandle(h,id,2)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real dist=SR3D(x,y,z,x1,y1,0)
local real dist2=SR(x,y,x1,y1)
local real PitchA=Atan2(dist,z)
local real is=0
local real ig=30*bj_DEGTORAD
local real a=Atan2(y1-y,x1-x)
local real dmg=11*GetHeroStr(u,true)
local real time=LoadReal(h,id,3)
local trigger tt=LoadTriggerHandle(h,id,11)
if time<2 then
call SaveReal(h,id,3,time+0.05)
call SaveReal(HH,GetHandleId(l__d),TIME_HASH,time+0.05)
if (GetLocalPlayer()==p or GetPlayerAlliance(p,GetLocalPlayer(),ALLIANCE_SHARED_CONTROL)) and GetUnitSelected(GetLocalPlayer())==u and time<1.5 then
    call ClearSelection()
    call SelectUnit(l__d,true)
endif
call SetUnitFacing(u, a*bj_RADTODEG)
if time==0.05 then
call SetUnitAnimationByIndex(u,36)
set bjLCE=AddSpecialEffect("[spell]hakkestart.mdl",x,y)
call SetSpecialEffectScale(bjLCE,2)
call SetSpecialEffectAlpha(bjLCE,230)
call SetSpecialEffectZ(bjLCE,10)
call RemoveEffect(bjLCE,2.5,true,CreateTimer())
endif
if time==0.15 then
    set soundplay=SndN(1293) // Sound\Music\mp3Music\VegitoTBG1.mp3
    call StartSound(soundplay)
    //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
if time==1.5 then
    if (GetLocalPlayer()==p or GetPlayerAlliance(p,GetLocalPlayer(),ALLIANCE_SHARED_CONTROL)) and GetUnitSelected(GetLocalPlayer())==l__d then
        call ClearSelection()
        call SelectUnit(u,true)
    endif
endif
if time==1.2 then
call RemoveEffect(AddSpecialEffectTarget("war3mapImported\\Ball2.mdx", u, "hand left"), 2, true, CreateTimer())
call RemoveEffect(AddSpecialEffectTarget("war3mapImported\\Ball2.mdx", u, "hand right"), 2, true, CreateTimer())
call RemoveEffect(AddSpecialEffectTarget("VegitoTCharge.mdl", u, "hand right"), 0.6, true, CreateTimer())
call UnitAddAbility(u,'Arav')
call UnitRemoveAbility(u,'Arav')
if dist2<100 then
call SetUnitFlyHeight(u,850,1800)
else
call SetUnitFlyHeight(u,550,1200)
endif
loop
exitwhen is>=13
set n=CreateUnit(p,'e0ZH',x+400*Cos(ig*is),y+400*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,255,255,255,35)
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitTimeScale(n,1)
set is=is+1
endloop
endif
call SetUnitOrientation(u,a*bj_RADTODEG,(PitchA*bj_RADTODEG)-90,0)
else
set soundplay=SndN(1296) // Sound\Music\mp3Music\VegitoTBG2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set EFF=AddSpecialEffect("FinalKamehamehaEff.mdx",x+95*Cos(PitchA*a),y+95*Sin(PitchA*a))
call SetSpecialEffectOrientation(EFF,a*bj_RADTODEG,(PitchA*0.9*bj_RADTODEG)-90,0)
call SetSpecialEffectScale(EFF , 0.3)
call SetSpecialEffectZ(EFF,z+40-PitchA*bj_RADTODEG*0.25)
call SetSpecialEffectTimeScale(EFF,2)
call RemoveEffect(EFF,0.7,true,CreateTimer())
// ВЗРЫВ из 4.5 (Vegitto_T_Act2): восемь слоёв на невидимом якоре.
// EffectCreateAndMove вешает эффект на юнит, поэтому в точке попадания
// ставим такой же якорь e000, как там: размер 2.5, высота 150.
set n=CreateUnit(p,'e200',x1,y1,a*bj_RADTODEG)
call UnitSize(n,2.5,1,1)
call SetUnitFlyHeight(n,150,0)
call UnitColor(n,100,100,100,0)
call MyRemoveUnit(n,1.3)
call EffectCreateAndMove(true,EffectID[48],GetRandomReal(0,360),1,5,1,100,100,100,40,50,n,0,a*bj_RADTODEG)
call EffectCreateAndMove(true,EffectID[44],GetRandomReal(0,360),1,3.25,1,100,100,100,40,0,n,0,a*bj_RADTODEG)
call EffectCreateAndMove(true,EffectID[23],GetRandomReal(0,360),1,2,1,60,60,100,20,0,n,0,a*bj_RADTODEG)
call EffectCreateAndMove(true,EffectID[292],GetRandomReal(0,360),1,6,0.8,100,100,100,0,30,n,0,a*bj_RADTODEG)
call EffectCreateAndMoveAn(true,EffectID[870],GetRandomReal(0,360),1.5,5,1,100,100,100,100,0,n,0,a*bj_RADTODEG,2)
call EffectCreateAndMoveAn(true,EffectID[753],a*bj_RADTODEG,1,4.5,0.5,100,100,100,70,30,n,0,a*bj_RADTODEG,1)
call EffectCreateAndMove(true,EffectID[1416],a*bj_RADTODEG,1,2,0.75,80,80,100,60,0,n,0,a*bj_RADTODEG)
call EffectCreateAndMove(true,EffectID[574],GetRandomInt(0,360),1,4,2,100,100,100,60,30,n,0,GetRandomInt(0,360))
call GroupEnumUnitsInRange(DG,x1,y1,700,Base)
loop
set E=FirstOfGroup(DG)
call GroupRemoveUnit(DG,E)
exitwhen E==null
if Condition_Base(p,E) then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
endloop
call SaveUnitHandle(h,id1,0,u)
call RemoveUnit(l__d)
call TriggerClearActions(tt)
call DestroyTrigger(tt)
call TimerStart(t2,0.7,false,function FinalKamehamehaCast3)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set p=null
set t=null
set l__d=null
set tt=null
    set t2=null
endfunction
function FinalKamehamehaCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real z=GetUnitZCustom(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real dist=SR(x,y,x1,y1)
local real a=Atan2(y1-y,x1-x)
local trigger tt=CreateTrigger()
call SaveUnitHandle(h,id,0,u)
call SetUnitTimeScale(u,1.85)
call RemoveEffect(AddSpecialEffectTarget("war3mapImported\\LightningblastVegito.mdx", u, "hand right"), 0.3, true, CreateTimer())
call RemoveEffect(AddSpecialEffectTarget("war3mapImported\\LightningblastVegito.mdx", u, "hand left"), 0.3, true, CreateTimer())
//call RemoveEffect(AddSpecialEffectTarget("VegitoAura.mdx", u, "chest"), 2, true, CreateTimer())
set n=CreateUnit(p,'e21Q',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitVertexColor(n,255,255,255,70)
call SetUnitColor(n,PLAYER_COLOR_LIGHT_GRAY)
call SetUnitTimeScale(n,1.8)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call UnitEnableAutoOrientation(u,false)
set n = CreateUnit(p, 'd222', x1, y1, 0)
call SetUnitStringField(n,UNIT_SF_NAME,"Final Kamehameha")
call UnitScale(n, 3, 5.0, 0.5)
call SaveUnitHandle(h,id,2,n)
call SaveUnitHandle(HH,GetHandleId(n),VegitoT_Circle,u)
call SaveReal(HH,GetHandleId(n),TIME_HASH,0)
call SaveBoolean(HH,GetHandleId(n),2,false)
call TriggerRegisterUnitEvent(tt,n,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterUnitEvent(tt,n,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerAddAction(tt,function FinalKamehamehaCircle)
call SaveTriggerHandle(h,id,11,tt)
if GetRandomInt(0,100) < 50 then
    if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
        set soundplay=SndN(1299) // Sound\Music\mp3Music\FinalKamehameha2-2.mp3
    else
        set soundplay=SndN(1301) // Sound\Music\mp3Music\Vegitto\FinalKamehameha2-2-jap.mp3
    endif
else
    if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
        set soundplay=SndN(1303) // Sound\Music\mp3Music\FinalKamehameha2-1.mp3
    else
        set soundplay=SndN(1305) // Sound\Music\mp3Music\Vegitto\FinalKamehameha2-1-jap.mp3
    endif
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.05,true,function FinalKamehamehaCast2)
set u=null
set t=null
set p=null
set tt=null
endfunction
function FinalKamehamehaInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function FinalKamehamehaCast)
call TriggerAddCondition(t,Condition(function FinalKamehamehaCond))
set t=null
endfunction
function FinalExplosionCond takes nothing returns boolean
return GetSpellAbilityId()=='A0IQ'
endfunction
function FinalExplosionCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local integer i=1
local player p=GetOwningPlayer(u)
local effect ef = null
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real dmg=((GetUnitState(u,UNIT_STATE_MAX_LIFE)-GetWidgetLife(u))*(GetUnitAbilityLevel(u,'A0IQ')*0.1+0.25))+3*GetHeroStr(u,true)
if GetUnitAbilityLevel(u,'VGH6')>0 then
    set dmg=dmg+2*GetHeroStr(u,true)
endif
set ef=AddSpecialEffect("war3mapImported\\[DoFT]Natsu_Fire_Ball_n.mdl",x1,y1)
call SetSpecialEffectScale(ef , 1.6)
call SetSpecialEffectTimeScale(ef , 1.7)
call SetSpecialEffectVertexColour(ef,255,255,255,165)
call SetSpecialEffectZ(ef,350)
call DestroyEffect(ef)
set n=CreateUnit(p,'e0P7',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',4)
call SetUnitFlyHeight(n,350,0)
set n=CreateUnit(p,'e0P6',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',4)
call SetUnitFlyHeight(n,350,0)
set n=CreateUnit(p,'e0P5',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',4)
call SetUnitFlyHeight(n,350,0)
set n=CreateUnit(p,'e0P8',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',4)
call SetUnitFlyHeight(n,350,0)
set n=CreateUnit(p,'e0P5',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',4)
call SetUnitFlyHeight(n,350,0)
set n=CreateUnit(p,'e0P5',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',4)
call SetUnitFlyHeight(n,350,0)
set n=CreateUnit(p,'e0P8',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',4)
call SetUnitFlyHeight(n,350,0)
set n=CreateUnit(p,'e0P8',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',4)
call SetUnitFlyHeight(n,350,0)
call SetUnitInvulnerable(u,false)
call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)-GetWidgetLife(u)*0.15)
call GroupEnumUnitsInRange(DG,x1,y1,1250,Base)
call SetUnitAnimation(u,"Death")
loop
set E=FirstOfGroup(DG)
call GroupRemoveUnit(DG,E)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
endloop
call SetUnitFlyHeight(u,0,300)
call SetUnitTimeScale(u,1)
call PauseUnit(u,false)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set u=null
set p=null
set t=null
set ef=null
endfunction
function FinalExplosionCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
call UnitAddAbility(u,'Arav')
call UnitRemoveAbility(u,'Arav')
call SetUnitFlyHeight(u,300,300)
call SaveUnitHandle(h,id,0,u)
call SetUnitTimeScale(u,0.3)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
if GetUnitAbilityLevel(u,'VGH4')==0 then
call SetUnitAnimation(u,"Spell Channel")
else
call SetUnitAnimation(u,"Spell Channel Alternate")
endif
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(806) // Sound\Music\mp3Music\FinalExplosion.mp3
else
set soundplay=SndN(808) // Sound\Music\mp3Music\Vegeta\FinalExplosion-jap.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set n=CreateUnit(p,'e3E6',GetUnitX(u),GetUnitY(u),0)
call SetUnitFlyHeight(n,0,0)
call SetUnitFlyHeight(n,350,350)
call SetUnitScale(n,1.5,1.5,1.5)
call UnitApplyTimedLife(n,'BTLF',2)
set EFF = AddSpecialEffect("Hashirama\\SmokeFuzzy.mdl",GetUnitX(u),GetUnitY(u))
call SetSpecialEffectScale(EFF, 3.3)
call SetSpecialEffectTimeScale(EFF , 1.6)
call DestroyEffect(EFF)
set EFF=AddSpecialEffect("war3mapImported\\WindCircleFaster.mdl", GetUnitX(u),GetUnitY(u))
call SetSpecialEffectScale(EFF , 2)
call SetSpecialEffectTimeScale(EFF , 0.25)
call SetSpecialEffectAlphaTimed(EFF , 255 , 255 , 255 , 255 , 4)
call TimerStart(t,2,false,function FinalExplosionCast2)
set u=null
set t=null
set p=null
endfunction
function FinalExplosionInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function FinalExplosionCast)
call TriggerAddCondition(t,Condition(function FinalExplosionCond))
set t=null
endfunction
function CondGalickGun takes nothing returns boolean
return GetSpellAbilityId()=='A0IM' and udg_B==true
endfunction
function CastGalickGun2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real a=LoadReal(h,id,4)
local real dist=LoadReal(h,id,10)
local real x=GetUnitX(l__d)+30*Cos(a)
local real y=GetUnitY(l__d)+30*Sin(a)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real dmg=(2+GetUnitAbilityLevel(u,'A0IM'))*GetHeroStr(u,true)+75
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,3)
local real time=LoadReal(h,id,5)
if time<0.8 then
call SaveReal(h,id,5,time+0.017)
if time==0.799 then
if GetUnitAbilityLevel(u,'VGH4')==0 then
set soundplay=SndN(1307) // Sound\Music\mp3Music\GalickGun.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call DestroyEffect(LoadEffectHandle(h,id,7))
call DestroyEffect(LoadEffectHandle(h,id,8))
call SetUnitTimeScale(u,1)
call UnitApplyTimedLife(CreateUnit(p,'e0DA',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0DB',x1+45*Cos(a),y1+45*Sin(a),a*bj_RADTODEG),'BTLF',1)
set n=CreateUnit(GetOwningPlayer(u),'e0D9',x1+35*Cos(a),y1+35*Sin(a),a*bj_RADTODEG)
call SaveUnitHandle(h,id,1,n)
call SetUnitColor(n,PLAYER_COLOR_PINK)
else
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call DestroyEffect(LoadEffectHandle(h,id,7))
call SetUnitTimeScale(u,1)
set n=CreateUnit(GetOwningPlayer(u),'e0E5',x1+35*Cos(a),y1+35*Sin(a),a*bj_RADTODEG)
call SaveUnitHandle(h,id,1,n)
call SetUnitColor(n,PLAYER_COLOR_GREEN)
endif
endif
else
if dist>0 and IsTerrainPathable(GetUnitX(l__d),GetUnitY(l__d),PATHING_TYPE_FLYABILITY)==false then
call SetUnitXY_1(l__d,x,y, false)
if GetUnitAbilityLevel(u,'VGH0')>0 then
set n=CreateUnit(p,'e0HN',x,y,a*bj_RADTODEG)
call SetUnitTimeScale(n,0)
call SetUnitColor(n,PLAYER_COLOR_PINK)
call UnitApplyTimedLife(n,'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0D8',x,y,GetRandomReal(0,359)),'BTLF',1)
elseif GetUnitAbilityLevel(u,'VGH1')>0 then
set dmg=dmg+GetHeroStr(u,true)
set n=CreateUnit(p,'e0HN',x,y,a*bj_RADTODEG)
call SetUnitTimeScale(n,0)
call SetUnitColor(n,PLAYER_COLOR_PINK)
call UnitApplyTimedLife(n,'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0D8',x,y,GetRandomReal(0,359)),'BTLF',1)
elseif GetUnitAbilityLevel(u,'VGH2')>0 then
set dmg=dmg+1*GetHeroStr(u,true)
set n=CreateUnit(p,'e0HN',x,y,a*bj_RADTODEG)
call SetUnitTimeScale(n,0)
call SetUnitColor(n,PLAYER_COLOR_PINK)
call UnitApplyTimedLife(n,'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0D8',x,y,GetRandomReal(0,359)),'BTLF',1)
elseif GetUnitAbilityLevel(u,'VGH3')>0 then
set dmg=dmg+2*GetHeroStr(u,true)
set n=CreateUnit(p,'e0HN',x,y,a*bj_RADTODEG)
call SetUnitTimeScale(n,0)
call SetUnitColor(n,PLAYER_COLOR_PINK)
call UnitApplyTimedLife(n,'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0D8',x,y,GetRandomReal(0,359)),'BTLF',1)
elseif GetUnitAbilityLevel(u,'VGH4')>0 then
set dmg=dmg+4*GetHeroStr(u,true)
set n=CreateUnit(p,'e0R8',x,y,a*bj_RADTODEG)
call SetUnitTimeScale(n,0)
call SetUnitColor(n,PLAYER_COLOR_GREEN)
call UnitApplyTimedLife(n,'BTLF',1.2)
call UnitApplyTimedLife(CreateUnit(p,'e0R9',x,y,GetRandomReal(0,359)),'BTLF',1.2)
elseif GetUnitAbilityLevel(u,'VGH5')==0 or GetUnitAbilityLevel(u,'VGH6')==0 then
set dmg=dmg+2*GetHeroStr(u,true)
set n=CreateUnit(p,'e0HN',x,y,a*bj_RADTODEG)
call SetUnitTimeScale(n,0)
call SetUnitColor(n,PLAYER_COLOR_PINK)
call UnitApplyTimedLife(n,'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0D8',x,y,GetRandomReal(0,359)),'BTLF',1)
endif
call GroupEnumUnitsInRange(g,x,y,150,Base)
set idg=GetHandleId(g)
call SaveReal(h,id,10,dist-30)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
else
call GroupEnumUnitsInRange(g,x,y,400,Base)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
call ShakeCamera(0.5,20)
call UnitApplyTimedLife(CreateUnit(p,'e0DC',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0DF',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0DE',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0DD',x,y,(a*bj_RADTODEG)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0C7',x,y,(a*bj_RADTODEG)),'BTLF',6)
call StartSound(soundStr[47])
call RemoveUnit(l__d)
call FlushChildHashtable(h,GetHandleId(g))
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
endif
set g=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
function CastGalickGun takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local effect e
local effect e1
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,3,CreateGroup())
call SaveReal(h,id,4,a)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
if GetUnitAbilityLevel(u,'VGH4')==0 then
if GetUnitAbilityLevel(u,'VGH5')==0 and GetUnitAbilityLevel(u,'VGH6')==0 then
call SaveReal(h,id,10,3500)
else
call SaveReal(h,id,10,5500)
endif
call UnitApplyTimedLife(CreateUnit(p,'e0D7',x-25*Cos(a+90*bj_DEGTORAD),y-25*Sin(a+90*bj_DEGTORAD),GetRandomReal(0,359)),'BTLF',1)
call SetUnitTimeScale(u,0.58)
set e=AddSpecialEffectTarget("war3mapImported\\gallit gun.mdx",u,"chest")
set e1=AddSpecialEffectTarget("war3mapImported\\PurpleMissile.mdl",u,"hand")
call SaveEffectHandle(h,id,7,e)
call SaveEffectHandle(h,id,8,e1)
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(1310) // Sound\Music\mp3Music\GalickGun2.mp3
else
set soundplay=SndN(1312) // Sound\Music\mp3Music\Vegeta\GalickGun2-jap.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SetUnitAnimation(u,"Spell Two")
else
call SaveReal(h,id,10,5500)
call SetUnitTimeScale(u,0.7)
set e=AddSpecialEffectTarget("war3mapImported\\GreenChakra.mdx",u,"origin")
call SaveEffectHandle(h,id,7,e)
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(1314) // Sound\Music\mp3Music\FinalShineAttack.mp3
else
set soundplay=SndN(1316) // Sound\Music\mp3Music\Vegeta\FinalShineAttack-jap.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
if GetUnitAbilityLevel(u,'VGH4')>0 then
call SetUnitAnimation(u,"Spell One Alternate")
else
call SetUnitAnimation(u,"Spell One")
endif
endif
call TimerStart(t,0.017,true,function CastGalickGun2)
set u=null
set p=null
set e=null
set e1=null
set t=null
endfunction
function GalickGunInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function CastGalickGun)
call TriggerAddCondition(t,Condition(function CondGalickGun))
set t=null
endfunction
function BigBangAttackCond takes nothing returns boolean
return GetSpellAbilityId()=='A0IO'
endfunction
function BigBangAttackCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x2=LoadReal(h,id,2)
local real y2=LoadReal(h,id,3)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real a=Atan2(y2-y1,x2-x1)
local real a2
local player p=GetOwningPlayer(u)
local real dmg=150+GetHeroStr(u,true)*(GetUnitAbilityLevel(u,'A0IO')+1)
if SR(x1,y1,x2,y2)>26.00 then
set x1=x1+45*Cos(a)
set y1=y1+45*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
else
call UnitApplyTimedLife(CreateUnit(p,'e048',x1,y1,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e03W',x1,y1,0),'BTLF',4)
call UnitApplyTimedLife(CreateUnit(p,'e06O',x1,y1,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e06N',x1,y1,0),'BTLF',3)
call DestroyEffect(AddSpecialEffect("war3mapImported\\explode.mdx",x1,y1))
call DestroyEffect(AddSpecialEffect("war3mapImported\\SuperBigExplosion.mdx",x1,y1))
call StartSound(soundStr[47])
call GroupEnumUnitsInRange(DG,x1,y1,400,Base)
loop
set E=FirstOfGroup(DG)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 2, "stun")
endif
call GroupRemoveUnit(DG,E)
endloop
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call RemoveUnit(l__d)
endif
set l__d=null
set p=null
set u=null
set t=null
endfunction
function BigBangAttackCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
if GetUnitAbilityLevel(u,'VGH4')==0 then
call SetUnitAnimation(u,"Spell One")
else
call SetUnitAnimation(u,"Spell One Alternate")
endif
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,x1)
call SaveReal(h,id,3,y1)
call SaveUnitHandle(h,id,1,CreateUnit(p,'e0DG',x,y,a*bj_RADTODEG))
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(1318) // Sound\Music\mp3Music\BigBandAttack.mp3
else
set soundplay=SndN(1320) // Sound\Music\mp3Music\Vegeta\BigBandAttack-jap.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call UnitApplyTimedLife(CreateUnit(p,'e0DH',x+25*Cos(a),y+25*Sin(a),a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0DI',x+25*Cos(a),y+25*Sin(a),a*bj_RADTODEG),'BTLF',1)
call TimerStart(t,0.03,true,function BigBangAttackCast2)
set u=null
set p=null
set t=null
endfunction
function InitBigBangAttack takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function BigBangAttackCast)
call TriggerAddCondition(t,Condition(function BigBangAttackCond))
set t=null
endfunction



function GinD_Periodic takes nothing returns nothing
        local integer id = GetHandleId(GetExpiredTimer())
        local real point_x = LoadReal(h, id, SH_PointX)
        local real point_y = LoadReal(h, id, SH_PointY)
        local real time = LoadReal(h, id, TIME_HASH)
        local boolean bTeleport = LoadBoolean(h, id, SH_TeleportBoolean)
        if GetUnitCurrentOrder(LoadUnitHandle(h,id,CasterHash))==OrderId("acidbomb") then
                call SaveReal(h, id, TIME_HASH, time+0.05)
                set bjLCU = LoadUnitHandle(h, id, SH_EffectUnit1)
                call SetUnitX(bjLCU, GetUnitX(LoadUnitHandle(h,id,CasterHash)))
                call SetUnitY(bjLCU, GetUnitY(LoadUnitHandle(h,id,CasterHash)))
                if time<1 then
                        if LoadInteger(h, id, EffectPeriodHash)==0 then
                                set bjLCU = CreateUnit(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)),'e0DT',GetUnitX(LoadUnitHandle(h,id,CasterHash)),GetUnitY(LoadUnitHandle(h,id,CasterHash)),GetRandomInt(0,360))
                                call UnitApplyTimedLife(bjLCU,'BTLF',1)
                                call SetUnitVertexColor(bjLCU, 255, 255, 255, 100)
                                call MyRemoveUnit(bjLCU, 2)
                                call SaveInteger(h, id, EffectPeriodHash, 2)
                        else
                                call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash)-1)
                        endif
                else
                        call IssueImmediateOrder(LoadUnitHandle(h,id,CasterHash), "stop")
                        call SaveBoolean(h, id, SH_TeleportBoolean, true)
                endif
        else
                set bjLCG = LoadGroupHandle(h, id, GroupHash)
                if bTeleport then
                        set soundplay=SndN(1322) // Sound\war3mapImported\GinD_2.mp3
                        call StartSound(soundplay)
                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dH18', GetUnitX(LoadUnitHandle(h,id,CasterHash)),GetUnitY(LoadUnitHandle(h,id,CasterHash)), GetRandomInt(0, 360))
                        call SetUnitScale(n, 1.5, 1.5, 1.5)
                        call MyRemoveUnit(n, 1.5)
                        call GroupEnumUnitsInRange(bjLCG, GetUnitX(LoadUnitHandle(h,id,CasterHash)), GetUnitY(LoadUnitHandle(h,id,CasterHash)), 300, Base)
                        loop
                        set E=FirstOfGroup(bjLCG)
                        exitwhen E==null
                                if FilterA(LoadUnitHandle(h,id,CasterHash), E) then
                                        call SetUnitX(E, point_x+100*Cos(GetRandomReal(0.0, 6.28)))
                                        call SetUnitY(E, point_y+100*Sin(GetRandomReal(0.0, 6.28)))
                                endif
                                call GroupRemoveUnit(bjLCG, E)
                        endloop
                        call SetUnitX(LoadUnitHandle(h,id,CasterHash), point_x)
                        call SetUnitY(LoadUnitHandle(h,id,CasterHash), point_y)
                        set bjLCU = CreateUnit(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)),'e0DT', point_x, point_y,GetRandomInt(0,360))
                        call UnitApplyTimedLife(bjLCU,'BTLF',1)
                        call SetUnitVertexColor(bjLCU, 255, 255, 255, 130)
                        call MyRemoveUnit(bjLCU, 2)
                        set bjLCU = CreateUnit(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)),'e0DS', point_x, point_y,GetRandomInt(0,360))
                        call UnitApplyTimedLife(bjLCU,'BTLF',1)
                        call SetUnitTimeScale(bjLCU, 0.75)
                        call MyRemoveUnit(bjLCU, 2)
                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dH18', point_x, point_y, GetRandomInt(0, 360))
                        call SetUnitScale(n, 1.5, 1.5, 1.5)
                        call MyRemoveUnit(n, 1.5)
                endif
                call KillUnit(LoadUnitHandle(h, id, SH_EffectUnit1))
                call MyRemoveUnit(LoadUnitHandle(h, id, SH_EffectUnit1), 2)
                call DestroyGroup(bjLCG)
                call FlushChildHashtable(h, id)
                call DestroyTimer(GetExpiredTimer())
        endif
endfunction

function GinD_Cast takes unit newCaster, real point_x, real point_y, timer newTimer returns nothing
        local integer id = GetHandleId(newTimer)
        local real caster_x = GetUnitX(newCaster)
        local real caster_y = GetUnitY(newCaster)
        set soundplay=SndN(1325) // Sound\Music\mp3Music\GinW.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        set bjLCU = CreateUnit(GetOwningPlayer(newCaster),'e0DS',caster_x,caster_y,GetRandomInt(0,360))
        call SetUnitTimeScale(bjLCU, 0.75)
        call SaveUnitHandle(h, id, SH_EffectUnit1, bjLCU)
        set bjLCU = CreateUnit(GetOwningPlayer(newCaster),'e0DT',caster_x,caster_y,GetRandomInt(0,360))
        call UnitApplyTimedLife(bjLCU,'BTLF',1)
        call MyRemoveUnit(bjLCU, 2)
        call SaveUnitHandle(h, id, CasterHash, newCaster)
        call SaveReal(h, id, SH_PointX, point_x)
        call SaveReal(h, id, SH_PointY, point_y)
        call SaveGroupHandle(h, id, GroupHash, CreateGroup())
        call TimerStart(newTimer, 0.05, true, function GinD_Periodic)
endfunction


function GinW_Act2_Periodic takes nothing returns nothing
        local integer id = GetHandleId(GetExpiredTimer())
        local real angle = LoadReal(h, id, AngleHash)
        local real time = LoadReal(h, id, TIME_HASH)
        local real damage = 150 + GetHeroAgi(LoadUnitHandle(h, id, CasterHash), true)*GetUnitAbilityLevel(LoadUnitHandle(h, id, CasterHash), 'GinW')
        if time<2 then
                call SaveReal(h, id, TIME_HASH, time+0.01)
                call SetUnitX(LoadUnitHandle(h, id, TargetHash), GetUnitX(LoadUnitHandle(h, id, TargetHash))+4*Cos(angle))
                call SetUnitY(LoadUnitHandle(h, id, TargetHash), GetUnitY(LoadUnitHandle(h, id, TargetHash))+4*Sin(angle))
                call SetUnitX(LoadUnitHandle(h, id, CasterHash), GetUnitX(LoadUnitHandle(h, id, TargetHash))-45*Cos(angle))
                call SetUnitY(LoadUnitHandle(h, id, CasterHash), GetUnitY(LoadUnitHandle(h, id, TargetHash))-45*Sin(angle))
                call SetUnitInvulnerable(LoadUnitHandle(h, id, CasterHash), true)
                call SetUnitInvulnerable(LoadUnitHandle(h, id, TargetHash), true)
                call PauseUnit(LoadUnitHandle(h, id, TargetHash), true)
                call SaveBoolean(HH,GetHandleId(LoadUnitHandle(h, id, TargetHash)),TARGET_ABILITY,true)
                call PauseUnit(LoadUnitHandle(h, id, CasterHash), true)
                if LoadInteger(h, id, EffectPeriodHash)==0 then
                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dH34', GetUnitX(LoadUnitHandle(h, id, TargetHash))+60*Cos(angle), GetUnitY(LoadUnitHandle(h, id, TargetHash))+60*Sin(angle), angle*bj_RADTODEG+GetRandomInt(-45, 45))
                        call SetUnitFlyHeight(n, 75, 0)
                        call SetUnitScale(n, 0.75, 0.75, 0.75)
                        call MyRemoveUnit(n, 1)
                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dH35', GetUnitX(LoadUnitHandle(h, id, TargetHash))+60*Cos(angle), GetUnitY(LoadUnitHandle(h, id, TargetHash))+60*Sin(angle), angle*bj_RADTODEG+GetRandomInt(-45, 45)+180)
                        call SetUnitFlyHeight(n, 75, 0)
                        call SetUnitScale(n, 1.5, 1.5, 1.5)
                        call MyRemoveUnit(n, 1)
                        call SaveInteger(h, id, EffectPeriodHash, 9)
                else
                        call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash)-1)
                endif
        else
                call SetUnitTimeScale(LoadUnitHandle(h, id, CasterHash), 1)
                call ShakeCamera(0.2, 5)
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dR64', GetUnitX(LoadUnitHandle(h, id, TargetHash)) + 50 * Cos(angle), GetUnitY(LoadUnitHandle(h, id, TargetHash)) + 50 * Sin(angle), angle * bj_RADTODEG)
                call SetUnitFlyHeight(bjLCU, 160, 0)
                call SetUnitScale(bjLCU, 1.2, 1.2, 1.2)
                call MyRemoveUnit(bjLCU , 1.5)
                set bjLCU=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dH34', GetUnitX(LoadUnitHandle(h, id, TargetHash)) + 100 * Cos(angle), GetUnitY(LoadUnitHandle(h, id, TargetHash)) + 100 * Sin(angle), angle * bj_RADTODEG)
                call SetUnitFlyHeight(bjLCU, 75, 0)
                call SetUnitScale(bjLCU, 1.25, 1.25, 1.25)
                call SetUnitTimeScale(bjLCU, 0.7)
                call MyRemoveUnit(bjLCU , 1.5)
                set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dH02', GetUnitX(LoadUnitHandle(h, id, TargetHash)), GetUnitY(LoadUnitHandle(h, id, TargetHash)), angle*bj_RADTODEG)
                call SetUnitFlyHeight(n, 75, 0)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dR37', GetUnitX(LoadUnitHandle(h, id, TargetHash)), GetUnitY(LoadUnitHandle(h, id, TargetHash)), angle*bj_RADTODEG)
                call SetUnitFlyHeight(n, 75, 0)
                call SetUnitScale(n, 2, 2, 2)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dH02', GetUnitX(LoadUnitHandle(h, id, TargetHash)), GetUnitY(LoadUnitHandle(h, id, TargetHash)), angle*bj_RADTODEG)
                call SetUnitFlyHeight(n, 75, 0)
                call SetUnitScale(n, 2, 2, 2)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dR42', GetUnitX(LoadUnitHandle(h, id, TargetHash)), GetUnitY(LoadUnitHandle(h, id, TargetHash)), angle*bj_RADTODEG)
                call SetUnitFlyHeight(n, 75, 0)
                call SetUnitScale(n, 0.6, 0.6, 0.6)
                call SetUnitTimeScale(n, 0.6)
                call MyRemoveUnit(n, 1.5)
                
                call SetUnitInvulnerable(LoadUnitHandle(h, id, CasterHash), false)
                call PauseUnit(LoadUnitHandle(h, id, CasterHash), false)
                call SetUnitAnimationByIndex(LoadUnitHandle(h, id, CasterHash), 9)
                call SetUnitInvulnerable(LoadUnitHandle(h, id, TargetHash), false)
                call PauseUnit(LoadUnitHandle(h, id, TargetHash), false)
                call SaveBoolean(HH,GetHandleId(LoadUnitHandle(h, id, TargetHash)),TARGET_ABILITY,false)
                call GinT_AddStack(LoadUnitHandle(h, id, CasterHash), LoadUnitHandle(h, id, TargetHash))
                call myCustomDamage(LoadUnitHandle(h, id, CasterHash), LoadUnitHandle(h, id, TargetHash), damage, false , false , null , null , null)
                call SetControlToUnit(LoadUnitHandle(h, id, CasterHash), LoadUnitHandle(h, id, TargetHash), 1.0, "stun")
                call Push(LoadUnitHandle(h, id, CasterHash), 60, angle-180*bj_DEGTORAD, 750)
                call Push(LoadUnitHandle(h, id, TargetHash), 60, angle, 350)
                call IssueImmediateOrder(LoadUnitHandle(h, id, CasterHash), "stop")
                call FlushChildHashtable(h, id)
                call DestroyTimer(GetExpiredTimer())
        endif
endfunction

function GinW_Periodic takes nothing returns nothing
        local integer id = GetHandleId(GetExpiredTimer())
        local real distance = LoadReal(h, id, SH_Distance)
        local real caster_x = GetUnitX(LoadUnitHandle(h, id, CasterHash))
        local real caster_y = GetUnitY(LoadUnitHandle(h, id, CasterHash))
        local real angle = LoadReal(h, id, AngleHash)
        if distance<1000 then
            call PauseUnit(LoadUnitHandle(h, id, CasterHash), true)
            call SetUnitX(LoadUnitHandle(h, id, CasterHash), caster_x+35*Cos(angle))
            call SetUnitY(LoadUnitHandle(h, id, CasterHash), caster_y+35*Sin(angle))
            call SaveReal(h, id, SH_Distance, distance+35)
            if LoadInteger(h, id, EffectPeriodHash)<=0 then
                set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dR88', caster_x, caster_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 0.7, 0.7, 0.7)
                call MyRemoveUnit(n, 1.3)
                set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dR45', caster_x, caster_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 0.7, 0.7, 0.7)
                call MyRemoveUnit(n, 1.3)
                call SaveInteger(h, id, EffectPeriodHash, 7)
            else
                call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash)-1)
            endif
            set bjLCG = LoadGroupHandle(h, id, GroupHash)
            call GroupEnumUnitsInRange(bjLCG, caster_x, caster_y, 125, Base)
            loop
            set bjLCU = FirstOfGroup(bjLCG)
            exitwhen bjLCU==null
                if Condition_Base(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), bjLCU) and IsUnitInvulnerable(bjLCU)==false then
                    call SaveReal(h, id, SH_Distance, 99999)
                    if LoadBoolean(HH,GetHandleId(bjLCU),ANTITARGET_ABILITY)==false then
                        call SaveUnitHandle(h, id, TargetHash, bjLCU)
                    else
                        call SaveBoolean(HH,GetHandleId(LoadUnitHandle(h, id, CasterHash)),DASH_USER,false)
                        call SaveUnitHandle(HH,GetHandleId(bjLCU),REVERSE_TARGET,LoadUnitHandle(h, id, CasterHash))
                    endif
                    call GroupClear(bjLCG)
                endif
                call GroupRemoveUnit(bjLCG, bjLCU)
            endloop
        else
            if LoadUnitHandle(h, id, TargetHash)==null then
                call PauseUnit(LoadUnitHandle(h, id, CasterHash), false)
                call IssueImmediateOrder(LoadUnitHandle(h, id, CasterHash), "stop")
                call SetUnitAnimationByIndex(LoadUnitHandle(h, id, CasterHash), 9)
                call StartAbilityCooldown(GetUnitAbility(LoadUnitHandle(h, id, CasterHash), 'GinW'), 12)
                
                set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dH18', caster_x, caster_y, GetRandomInt(0, 360))
                call SetUnitScale(n, 0.85, 0.85, 0.85)
                call SetUnitVertexColor(n, 255, 255, 255, 200)
                call MyRemoveUnit(n, 1.5)
                set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dR88', caster_x, caster_y, GetRandomInt(0, 360))
                call MyRemoveUnit(n, 1.5)
            else
                call SetUnitInvulnerable(LoadUnitHandle(h, id, CasterHash), true)
                call SetUnitInvulnerable(LoadUnitHandle(h, id, TargetHash), true)
                call PauseUnit(LoadUnitHandle(h, id, TargetHash), true)
                call SaveBoolean(HH,GetHandleId(LoadUnitHandle(h, id, TargetHash)),TARGET_ABILITY,true)
                call SetUnitAnimationByIndex(LoadUnitHandle(h, id, CasterHash), 8)
                call SetUnitTimeScale(LoadUnitHandle(h, id, CasterHash), 3)
                set bjLCT = CreateTimer()
                call SaveReal(h, GetHandleId(bjLCT), AngleHash, angle)
                call SaveUnitHandle(h, GetHandleId(bjLCT), CasterHash, LoadUnitHandle(h, id, CasterHash))
                call SaveUnitHandle(h, GetHandleId(bjLCT), TargetHash, LoadUnitHandle(h, id, TargetHash))
                call TimerStart(bjLCT, 0.01, true, function GinW_Act2_Periodic)
                set bjLCT = null
                set soundplay=SndByPath("Sound\\war3mapImported\\GinW"+I2S(GetRandomInt(1,3))+".mp3")
                call StartSound(soundplay)
                //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            endif
            call SetUnitVertexColor(LoadUnitHandle(h, id, CasterHash), 255, 255, 255, 255)
            call DestroyGroup(LoadGroupHandle(h, id, GroupHash))
            call FlushChildHashtable(h, id)
            call DestroyTimer(GetExpiredTimer())
        endif
endfunction

function GinW_Cast takes unit newCaster, real point_x, real point_y, timer newTimer returns nothing
        local integer id = GetHandleId(newTimer)
        local real caster_x = GetUnitX(newCaster)
        local real caster_y = GetUnitY(newCaster)
        local real angle = AtanPoint(caster_x, caster_y, point_x, point_y)
        // set soundplay=CreateSound("Sound\\Music\\mp3Music\\Soru2.mp3", false, false, true, 12700, 12700, "")
        set soundplay=SndN(1333) // Sound\war3mapImported\GinWRush.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH18',  caster_x, caster_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 0.85, 0.85, 0.85)
        call SetUnitVertexColor(n, 255, 255, 255, 200)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dR88',  caster_x, caster_y, GetRandomInt(0, 360))
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dR42',  caster_x, caster_y, angle*bj_RADTODEG)
        call SetUnitFlyHeight(n, 50, 0)
        call SetUnitScale(n, 0.55, 0.55, 0.55)
        call MyRemoveUnit(n, 1.5)
        
        call SetUnitVertexColor(newCaster, 255, 255, 255, 100)
        call PauseUnit(newCaster, true)
        call SaveUnitHandle(h, id, CasterHash, newCaster)
        call SetUnitAnimationByIndex(newCaster, 1)
        call SaveReal(h, id, AngleHash, angle)
        call SaveGroupHandle(h, id, GroupHash, CreateGroup())
        call TimerStart(newTimer, 0.007, true, function GinW_Periodic)
endfunction

function GinT_Execute takes unit newCaster, unit newTarget returns nothing
        local real target_x = GetUnitX(newTarget)
        local real target_y = GetUnitY(newTarget)
        local real angle = GetRandomInt(0, 360)
        local integer loop_index = 0
        call ShakeCamera(0.2, 15)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH29', target_x, target_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 2, 2, 2)
        call SetUnitTimeScale(n, 0.65)
        call UnitApplyTimedLife(n,'BTLF', 1)
        call MyRemoveUnit(n, 2.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dR90', target_x, target_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 3, 3, 3)
        call MyRemoveUnit(n, 2.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH02', target_x, target_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 3, 3, 3)
        call MyRemoveUnit(n, 2.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH30', target_x, target_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 3, 3, 3)
        call MyRemoveUnit(n, 2.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH30', target_x, target_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call MyRemoveUnit(n, 2.5)
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH22', target_x, target_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 2, 2, 2)
        call MyRemoveUnit(n, 2.5)
        
        loop
        exitwhen loop_index==6
                set n=CreateUnit(GetOwningPlayer(newCaster), 'dR37', target_x, target_y, angle)
                call SetUnitScale(n, 3, 3, 3)
                call SetUnitFlyHeight(n, 50, 0)
                call MyRemoveUnit(n, 2.5)
                set n=CreateUnit(GetOwningPlayer(newCaster), 'dR37', target_x, target_y, angle)
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call SetUnitFlyHeight(n, 50, 0)
                call MyRemoveUnit(n, 2.5)
                set n=CreateUnit(GetOwningPlayer(newCaster), 'dH30', target_x+30*Cos(angle*bj_DEGTORAD), target_y+30*Sin(angle*bj_DEGTORAD), angle)
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call MyRemoveUnit(n, 2.5)
        set loop_index = loop_index + 1
        set angle = angle + 60
        endloop
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dH31', target_x, target_y, GetRandomInt(0, 360))
        call SetUnitScale(n, 3, 3, 3)
        call UnitApplyTimedLife(n,'BTLF', 2)
        call MyRemoveUnit(n, 2.7)
endfunction

function GinT_Periodic takes nothing returns nothing
	local integer id = GetHandleId(GetExpiredTimer())
	local integer id_target = GetHandleId(LoadUnitHandle(HH, id, TargetHash))
	local boolean bGinT = LoadBoolean(HH, id_target, SH_GinT_Boolean)
	local real damage = LoadReal(HH, id, SH_Damage)/10
	local real duration = LoadReal(HH, id, SH_Duration)
	local boolean bExecute = LoadBoolean(HH, id, SH_Execute)
    local unit caster = LoadUnitHandle(HH, id, CasterHash)
    local unit target = LoadUnitHandle(HH, id, TargetHash)
	if duration>=0 and bGinT and GetWidgetLife(target)>0.1 then
		call SaveReal(HH, id, SH_Duration, duration-0.1)
		if GetWidgetLife(target)<GetWidgetMaxLife(target)*0.125 and bExecute then
			call SaveBoolean(HH, id_target, SH_GinT_Boolean, false)
			call SetUnitInvulnerable(target, false)
			call GinT_Execute(caster, target)
            call CustomTrueDamage(caster, target, GetWidgetMaxLife(target)*0.15)
            call DamageIndicatorFunction(caster, target, GetWidgetMaxLife(target)*0.15)
		else
		    call CustomTrueDamage(caster, target, damage)
		endif
	else
		call DestroyEffect(LoadEffectHandle(HH, id, Effect1Hash))
		call SaveBoolean(HH, id_target, SH_GinT_Boolean, false)
		call FlushChildHashtable(HH, id)
		call DestroyTimer(GetExpiredTimer())
	endif
    set caster = null
    set target = null
endfunction


function GinT_Cast takes unit newCaster, unit newTarget, timer newTimer returns nothing
	local integer id = GetHandleId(newTimer)
	local integer id_target = GetHandleId(newTarget)
	local integer GinTStack = LoadInteger(HH, id_target, SH_GinT_Stack)
	local boolean bGinT = LoadBoolean(HH, id_target, SH_GinT_Boolean)
	local real full_damage = 0
	local real full_duration = 4
	if GinTStack>0 and bGinT==false then
		if GinTStack>=4 then
			set soundplay=SndN(1335) // Sound\war3mapImported\GinT_Voice.mp3
			call StartSound(soundplay)
			//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
			set soundplay=SndN(1337) // Sound\war3mapImported\GinT_Sound.mp3
			call StartSound(soundplay)
			//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
		else
			set soundplay=SndN(1339) // Sound\war3mapImported\GinT_VoiceShort.mp3
			call StartSound(soundplay)
			//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
			set soundplay=SndN(1341) // Sound\war3mapImported\GinT_SoundShort.mp3
			call StartSound(soundplay)
			//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
		endif
		set n=CreateUnit(GetOwningPlayer(newCaster), 'dR56', GetUnitX(newTarget), GetUnitY(newTarget), GetRandomInt(0, 360))
		call SetUnitScale(n, 1.25+GinTStack/5, 1.25+GinTStack/5, 1.25+GinTStack/5)
		call MyRemoveUnit(n, 2.5)
		set n=CreateUnit(GetOwningPlayer(newCaster), 'dH28', GetUnitX(newTarget), GetUnitY(newTarget), GetRandomInt(0, 360))
		call SetUnitScale(n, 1.25, 1.25, 1.25)
		call SetUnitFlyHeight(n, 75, 0)
		call SetUnitTimeScale(n, 0.65)
		call MyRemoveUnit(n, 2.5)
		if GinTStack>3 then
			call ShakeCamera(0.2, 10)
			set n=CreateUnit(GetOwningPlayer(newCaster), 'dH29', GetUnitX(newTarget), GetUnitY(newTarget), GetRandomInt(0, 360))
			call SetUnitScale(n, 2, 2, 2)
			call SetUnitTimeScale(n, 0.65)
			call UnitApplyTimedLife(n,'BTLF', 1)
			call MyRemoveUnit(n, 2.7)
			set n=CreateUnit(GetOwningPlayer(newCaster), 'dR90', GetUnitX(newTarget), GetUnitY(newTarget), GetRandomInt(0, 360))
			call SetUnitScale(n, 3, 3, 3)
			call MyRemoveUnit(n, 2.5)
			set n=CreateUnit(GetOwningPlayer(newCaster), 'dR56', GetUnitX(newTarget), GetUnitY(newTarget), GetRandomInt(0, 360))
			call SetUnitScale(n, 1.5, 1.5, 1.255)
			call MyRemoveUnit(n, 2.5)
		endif
		//set bjLCU = CreateUnit(GetOwningPlayer(newCaster), 'dAlb', GetUnitX(newTarget), GetUnitY(newTarget), 0)
		//call UnitAddAbility(bjLCU, 'GiTs')
		//call SetUnitAbilityLevel(bjLCU, 'GiTs', GinTStack)
		//call IssueTargetOrder(bjLCU, "slow", newTarget)
        call SlowUnit(newTarget,newTarget,GinTStack*0.07,GinTStack*0.07,1.8+GinTStack*0.7,2,false)
		call MyRemoveUnit(bjLCU, 1)
		call SaveEffectHandle(HH, id, Effect1Hash, AddSpecialEffectTarget("war3mapImported\\AuraLightBlue.mdx", newTarget, "origin"))
		call SaveInteger(HH, id_target, SH_GinT_Stack, 0)
		set full_damage = GetWidgetMaxLife(newTarget)*0.1 + GetWidgetMaxLife(newTarget)*(I2R(GinTStack-1)/16)
		set full_duration = 2.5 + GinTStack/2
		call SetControlToUnit(newCaster, newTarget, 1.5, "stun")
		if SquareRootUnit(newCaster, newTarget)<=800 then
			call SaveBoolean(HH, id, SH_Execute, true)
			set n=CreateUnit(GetOwningPlayer(newCaster), 'dR56', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
			call SetUnitScale(n, 0.85, 0.85, 0.85)
			call MyRemoveUnit(n, 2.5)
			set n=CreateUnit(GetOwningPlayer(newCaster), 'dH28', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
			call SetUnitScale(n, 0.85, 0.85, 0.85)
			call SetUnitFlyHeight(n, 75, 0)
			call SetUnitTimeScale(n, 0.65)
			call MyRemoveUnit(n, 2.5)
		endif
		call SaveUnitHandle(HH, id, CasterHash, newCaster)
		call SaveUnitHandle(HH, id, TargetHash, newTarget)
		call SaveReal(HH, id, SH_Damage, full_damage/full_duration)
		call SaveReal(HH, id, SH_Duration, full_duration)
		call SaveBoolean(HH, id_target, SH_GinT_Boolean, true)
		call TimerStart(newTimer, 0.1, true, function GinT_Periodic)
	else
		call IssueImmediateOrder(newCaster, "stop")
		call StartAbilityCooldown(GetUnitAbility(newCaster, 'GinT'), 3)
		call SetWidgetMana(newCaster, GetWidgetMana(newCaster)+150)
	endif
endfunction

function GinR2_CD_Periodic takes nothing returns nothing
        local integer id = GetHandleId(GetExpiredTimer())
        local integer id_caster = GetHandleId(LoadUnitHandle(h, id, CasterHash))
        local integer cd = LoadInteger(h, id_caster, SH_ButoRenjin)
        if cd>0 then
                call SaveInteger(h, id_caster, SH_ButoRenjin, cd-1)
        else
                call SaveInteger(h, id_caster, SH_ButoRenjin, 0)
                call FlushChildHashtable(h, id)
                call DestroyTimer(GetExpiredTimer())
        endif
endfunction

function GinR2_CD takes unit newCaster, timer newTimer returns nothing
        local integer id = GetHandleId(newTimer)
        local integer id_caster = GetHandleId(newCaster)
        call SaveInteger(h, id_caster, SH_ButoRenjin, 15)
        call SaveUnitHandle(h, id, CasterHash, newCaster)
        call TimerStart(newTimer, 1, true, function GinR2_CD_Periodic)
endfunction

function GinNewR_Periodic takes nothing returns nothing
        local integer id = GetHandleId(GetExpiredTimer())
        local real point_x = GetUnitX(LoadUnitHandle(h, id, CasterHash))
        local real point_y = GetUnitY(LoadUnitHandle(h, id, CasterHash))
        local real angle = LoadReal(h, id, AngleHash)
        local real time = LoadReal(h, id, TIME_HASH)
        local real dmg=(5+GetUnitAbilityLevel(LoadUnitHandle(h, id, CasterHash),'GinR'))*GetHeroAgi(LoadUnitHandle(h, id, CasterHash),true)
        local integer EffectPeriod = LoadInteger(h, id, SH_EffectButo)
        local boolean second_act = LoadBoolean(h, id, SH_SecondAct)
        if time<=1.1 then
                call SaveReal(h, id, TIME_HASH, time+0.005)
                if time<=1 then
                        call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash)-1)
                        if LoadInteger(h, id, EffectPeriodHash)<=0 then
                                set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h,id,CasterHash)), 'dR52', point_x, point_y, GetRandomInt(0,360))
                                call SetUnitScale(n, 1.25, 1.25, 1.25)
                                call SetUnitVertexColor(n, 255, 255, 255, 90)
                                call MyRemoveUnit(n, 1.5)
                                call SaveInteger(h, id, EffectPeriodHash, 32)
                        endif
                else
                        set soundplay=SndN(1343) // Sound\war3mapImported\GinR2_Sound.mp3
                        call StartSound(soundplay)
                        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
                        call UnitApplyTimedLife(CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)),'e0DX', point_x, point_y,GetRandomReal(0,359)),'BTLF',1.5)
                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dR42', point_x, point_y, angle*bj_RADTODEG)
                        call SetUnitScale(n, 1.25, 1.25, 1.25)
                        call SetUnitTimeScale(n, 0.55)
                        call MyRemoveUnit(n, 1.5)
                        
                        call SaveReal(h, id, TIME_HASH, 12)
                        call SaveBoolean(h, id, SH_SecondAct, true)
                        set bjLCU = CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'e0DY', point_x, point_y, angle*bj_RADTODEG)
                        call SetUnitScale(bjLCU,5,5,5)
                        call SaveUnitHandle(h, id, DummyHash, bjLCU)
                        call PauseUnit(LoadUnitHandle(h, id, CasterHash), false)
                        //call SetUnitInvulnerable(LoadUnitHandle(h, id, CasterHash), false)
                        call IssueImmediateOrder(LoadUnitHandle(h, id, CasterHash), "stop")
                endif
        else
                if second_act then
                        set bjLCU = LoadUnitHandle(h, id, DummyHash)
                        set point_x = GetUnitX(bjLCU)+65*Cos(angle)
                        set point_y = GetUnitY(bjLCU)+65*Sin(angle)
                        if IsTerrainPathable(point_x, point_y, PATHING_TYPE_FLYABILITY)==false then
                                call SetUnitX(bjLCU, point_x)
                                call SetUnitY(bjLCU, point_y)
                                call SaveInteger(h, id, SH_EffectButo, EffectPeriod - 1)
                                if EffectPeriod == 0 then
                                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dR99', point_x+50*Cos(angle+90*bj_DEGTORAD), point_y+50*Sin(angle+90*bj_DEGTORAD), angle*bj_RADTODEG-120)
                                        call UnitApplyTimedLife(n,'BTLF', 1.5)
                                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dR99', point_x+50*Cos(angle-90*bj_DEGTORAD), point_y+50*Sin(angle-90*bj_DEGTORAD), angle*bj_RADTODEG+120)
                                        call UnitApplyTimedLife(n,'BTLF', 1.5)
                                        
                                        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dR42', point_x, point_y, angle*bj_RADTODEG)
                                        call SetUnitScale(n, 0.25, 0.25, 0.25)
                                        call SetUnitTimeScale(n, 0.6)
                                        call UnitApplyTimedLife(n,'BTLF', 1.5)
                                        call SaveInteger(h, id, SH_EffectButo, 1)
                                endif
                                set n=CreateUnit(GetOwningPlayer(bjLCU),'e0DY', point_x, point_y,(angle*bj_RADTODEG))
                                call SetUnitScale(n,3.75,3.6,75.75)
                                call UnitApplyTimedLife(n,'BTLF',1)
                                call MyRemoveUnit(n, 1.5)
                                set bjLCG=LoadGroupHandle(h, id, GroupHash)
                                call GroupEnumUnitsInRange(bjLCG, point_x, point_y, 200, Base)
                                loop
                                set E=FirstOfGroup(bjLCG)
                                exitwhen E==null
                                set ide=GetHandleId(E)
                                if Condition_Base(GetOwningPlayer(bjLCU),E)and E!=LoadUnitHandle(h, GetHandleId(bjLCG),ide)then
                                        call GinT_AddStack(LoadUnitHandle(h, id, CasterHash), E)
                                        call myCustomDamage(LoadUnitHandle(h, id, CasterHash),E,dmg,false,false,null,null,null)
                                        call SetControlToUnit(LoadUnitHandle(h, id, CasterHash),E, 1.0, "stun")
                                        call SaveUnitHandle(h,GetHandleId(bjLCG),ide,E)
                                endif
                                call GroupRemoveUnit(bjLCG,E)
                                endloop
                        else
                                call KillUnit(bjLCU)
                                call MyRemoveUnit(bjLCU, 1)
                                call SaveBoolean(h, id, SH_SecondAct, false)
                        endif
                else
                        call UnitRemoveAbility(LoadUnitHandle(h, id, CasterHash), 'GinR')
                        call ShowAbility2('A0J5', true)
                        call KillUnit(LoadUnitHandle(h, id, SH_Effect0))
                        call MyRemoveUnit(LoadUnitHandle(h, id, SH_Effect0), 1.5)
                        //call SaveBoolean(h, GetHandleId(LoadUnitHandle(h, id, CasterHash)), StringHash("GinBankai"), false)
                        call GinR2_CD(LoadUnitHandle(h, id, CasterHash), CreateTimer())
                        call FlushChildHashtable(h, GetHandleId(LoadGroupHandle(h, id, GroupHash)))
                        call DestroyGroup(LoadGroupHandle(h, id, GroupHash))
                        call FlushChildHashtable(h, id)
                        call DestroyTimer(GetExpiredTimer())
                endif
        endif
endfunction


function GinNewR_Cast takes unit newCaster, real point_x, real point_y, timer newTimer returns nothing
        local integer id = GetHandleId(newTimer)
        local integer id_caster = GetHandleId(newCaster)
        local real angle = AtanPoint(GetUnitX(newCaster), GetUnitY(newCaster), point_x, point_y)
        set soundplay=SndN(1346) // Sound\war3mapImported\GinR2_Voice.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        set n=CreateUnit(GetOwningPlayer(newCaster), 'dR20', GetUnitX(newCaster), GetUnitY(newCaster), 0)
        call SetUnitVertexColor(n, 255, 255, 255, 100)
        call SetUnitScale(n, 2, 2, 2)
        call SaveUnitHandle(h, id, SH_Effect0, n)
        
        call PauseUnit(newCaster, true)
        //call SetUnitInvulnerable(newCaster, true)
        call SetUnitAnimationByIndex(newCaster, 5)
        call SaveUnitHandle(h, id, CasterHash, newCaster)
        call SaveReal(h, id, AngleHash, angle)
        call SaveGroupHandle(h, id, GroupHash, CreateGroup())
        call TimerStart(newTimer, 0.005, true, function GinNewR_Periodic)
endfunction


function ReginCond takes nothing returns boolean
        return GetSpellAbilityId()=='A0J5' and udg_B==true
endfunction
function ReginCast2 takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(h,id,0)
        local real x=LoadReal(h,id,1)
        local real y=LoadReal(h,id,2)
        local real a=Atan2(LoadReal(h,id,4)-y,LoadReal(h,id,3)-x)
        local real l__d=LoadReal(h,id,5)
        local group g=LoadGroupHandle(h,id,6)
        local player p=GetOwningPlayer(u)
        local real dmg=(3+GetUnitAbilityLevel(u,'A0J5'))*GetHeroAgi(u,true)
        local real l__s=LoadReal(h,id,8)
        local integer lvl=GetUnitAbilityLevel(u,'A0J3')
        if l__d<GetHeroAgi(u,true)*10.0+2000 then
                set x=x+l__d*Cos(a)
                set y=y+l__d*Sin(a)
                set n=CreateUnit(p,'e0DY',x,y,(a*bj_RADTODEG))
                call SetUnitScale(n,l__s,l__s,l__s)
                call SaveReal(h,id,8,l__s+0.03)
                call UnitApplyTimedLife(n,'BTLF',1)
                call SaveReal(h,id,5,l__d+60)
                call GroupEnumUnitsInRange(g,x,y,175,Base)
                set idg=GetHandleId(g)
                loop
                set E=FirstOfGroup(g)
                exitwhen E==null
                set ide=GetHandleId(E)
                if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
                        call GinT_AddStack(u, E)
                        call UnitAddAbility(E,'A15G')
                        call myCustomDamage(u,E,dmg,false,false,null,null,null)
                        call UnitRemoveAbility(E,'A15G')
                        call SaveUnitHandle(h,idg,ide,E)
                        if lvl>0 then
                        endif
                endif
                call GroupRemoveUnit(g,E)
                endloop
        else
                if LoadBoolean(h, GetHandleId(u), SH_GinBankai) and LoadInteger(h, GetHandleId(u), SH_ButoRenjin)==0 then
                        call ShowAbility2('A0J5', false)
                        call UnitAddAbility(u, 'GinR')
                        call SetUnitAbilityLevel(u, 'GinR', GetUnitAbilityLevel(u, 'A0J5'))
                endif
                set idg=GetHandleId(g)
                call PauseTimer(t)
                call DestroyTimer(t)
                call DestroyGroup(g)
                call FlushChildHashtable(h,id)
                call FlushChildHashtable(h,idg)
        endif
        set p=null
        set u=null
        set g=null
        set t=null
endfunction
function ReginCast takes nothing returns nothing
        local unit u=GetTriggerUnit()
        local timer t=CreateTimer()
        local integer id=GetHandleId(t)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
        local player p=GetOwningPlayer(u)
        call SaveGroupHandle(h,id,6,CreateGroup())
        call SaveUnitHandle(h,id,0,u)
        call SaveReal(h,id,1,x)
        call SaveReal(h,id,8,2)
        call SaveReal(h,id,2,y)
        call SaveReal(h,id,3,GetSpellTargetX())
        call SaveReal(h,id,4,GetSpellTargetY())
        call UnitApplyTimedLife(CreateUnit(p,'e0DX',x,y,GetRandomReal(0,359)),'BTLF',1)
        set soundplay=SndN(1348) // Sound\Music\mp3Music\GinButo.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        call TimerStart(t,0.01-0.0001*GetHeroLevel(u),true,function ReginCast2)
        set p=null
        set u=null
        set t=null
endfunction
function ReginInit takes nothing returns nothing
        local trigger t=CreateTrigger()
        local integer i=0
        loop
        call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
        set i=i+1
        exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function ReginCast)
call TriggerAddCondition(t,Condition(function ReginCond))
set t=null
endfunction
function BankaiGinCond takes nothing returns boolean
return GetSpellAbilityId()=='A0J2' and udg_B==true
endfunction

function GinBankai_Timer takes nothing returns nothing
        local integer id = GetHandleId(GetExpiredTimer())
        local integer id_caster = GetHandleId(LoadUnitHandle(h, id, CasterHash))
        local real time = LoadReal(h, id, TIME_HASH)
        local boolean bGinBankai = LoadBoolean(h, id_caster, SH_GinBankai)
        if time<10 and bGinBankai and udg_B then
                call SaveReal(h, id, TIME_HASH, time+1)
        else
                if GetUnitAbilityLevel(LoadUnitHandle(h, id, CasterHash), 'GinR')>0 then
                        call UnitRemoveAbility(LoadUnitHandle(h, id, CasterHash), 'GinR')
                endif
                call ShowAbility2('A0J5', true)
                call SaveBoolean(h, id_caster, SH_GinBankai, false)
                call FlushChildHashtable(h, id)
                call DestroyTimer(GetExpiredTimer())
        endif
endfunction

function BankaiGinCast2 takes nothing returns nothing
        local timer t=GetExpiredTimer()
        local integer id=GetHandleId(t)
        local unit u=LoadUnitHandle(h,id,0)
        local integer i=1
        local player p=GetOwningPlayer(u)
        local real x=GetUnitX(u)
        local real y=GetUnitY(u)
        local integer lvl=GetUnitAbilityLevel(u,'A0J2')
        local real dmg=(lvl+2)*GetHeroAgi(u,true)
        local real angle=LoadReal(h, id, AngleHash)
    local real time=LoadReal(h,id,3)
        local real ai = 0
    if time<4 then
        call SaveReal(h,id,3,time+0.1)
        call PauseUnit(u,true)
        call SetUnitInvulnerable(u,true)
    else
        call SetUnitFacing(u, angle*bj_RADTODEG)
        set n=CreateUnit(p,'e0DU',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',1)
        call SetUnitTimeScale(n,1)
        set n=CreateUnit(p,'e0DX',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',1)
        call SetUnitTimeScale(n,2)
        set n=CreateUnit(p,'e0DX',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',1)
        call SetUnitTimeScale(n,2)
        set n=CreateUnit(p,'e0DX',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',1)
        call SetUnitTimeScale(n,2)
        call CinematicFadeBJCustom(bj_CINEFADETYPE_FADEIN,1,"ReplaceableTextures\\CameraMasks\\White_mask.blp",255,255,255,0)
        call GroupEnumUnitsInRange(DG,x,y,2000+400*lvl,Base)
        loop
            set E=FirstOfGroup(DG)
            exitwhen E==null
            if Condition_Base(p,E) and (Rad2Deg(AU(u,E)-angle)<=75 and Rad2Deg(AU(u,E)-angle)>=-75) then
                call UnitAddAbility(E,'A15G')
                call GinT_AddStack(u, E)
                call myCustomDamage(u,E,dmg,false,false,null,null,null)
                call UnitRemoveAbility(E,'A15G')
                call SetUnitAnimation(E,"Death")
                call SetControlToUnit(E,E, 2, "stun")
                call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",GetUnitX(E),GetUnitY(E)))
            endif
            call GroupRemoveUnit(DG,E)
        endloop
        call PauseUnit(u,false)
        call SetUnitInvulnerable(u,false)
        call SetUnitAnimationByIndex(u, 11)
        if GetUnitAbilityLevel(u, 'A0J5')>0 then
            if GetAbilityRemainingCooldown(GetUnitAbility(u, 'A0J5'))>0 and LoadInteger(h, GetHandleId(u), SH_ButoRenjin)==0 then
                call UnitAddAbility(u, 'GinR')
                call SetUnitAbilityLevel(u, 'GinR', GetUnitAbilityLevel(u, 'A0J5'))
                call ShowAbility2('A0J5', false)
            endif
            set bjLCT = CreateTimer()
            call SaveBoolean(h, GetHandleId(u), SH_GinBankai, true)
            call SaveUnitHandle(h, GetHandleId(bjLCT), CasterHash, u)
            call TimerStart(bjLCT, 1, true, function GinBankai_Timer)
            set bjLCT = null
        endif
        set ai = angle*bj_RADTODEG-60
        loop
            exitwhen ai > angle*bj_RADTODEG+60
            set n=CreateUnit(GetOwningPlayer(u), 'dR99', x+400*Cos(ai*bj_DEGTORAD), y+400*Sin(ai*bj_DEGTORAD), ai+180)
            call SetUnitScale(n, 3, 3, 3)
            call SetUnitTimeScale(n, 0.9)
            call MyRemoveUnit(n, 1.5)
            set ai = ai + 60
        endloop
        set ai = angle*bj_RADTODEG-60
        loop
            exitwhen ai > angle*bj_RADTODEG+60
            set n=CreateUnit(GetOwningPlayer(u), 'dR99', x+1000*Cos(ai*bj_DEGTORAD), y+1000*Sin(ai*bj_DEGTORAD), ai+180)
            call SetUnitScale(n, 3, 3, 3)
            call SetUnitTimeScale(n, 0.9)
            call MyRemoveUnit(n, 1.5)
            set n=CreateUnit(GetOwningPlayer(u), 'dR99', x+1500*Cos(ai*bj_DEGTORAD), y+1500*Sin(ai*bj_DEGTORAD), ai+180)
            call SetUnitScale(n, 3, 3, 3)
            call SetUnitTimeScale(n, 0.9)
            call MyRemoveUnit(n, 1.5)
            set n=CreateUnit(GetOwningPlayer(u), 'dR99', x+1850*Cos(ai*bj_DEGTORAD), y+1850*Sin(ai*bj_DEGTORAD), ai+180)
            call SetUnitScale(n, 3.2, 3.2, 3.2)
            call SetUnitTimeScale(n, 0.9)
            call MyRemoveUnit(n, 1.5)
            set ai = ai + 30
        endloop
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
    endif
        set u=null
        set p=null
        set t=null
endfunction
function BankaiGinCast takes nothing returns nothing
        local unit u=GetTriggerUnit()
        local timer t=CreateTimer()
        local integer id=GetHandleId(t)
        local player p=GetOwningPlayer(u)
        call SaveUnitHandle(h,id,0,u)
        call SaveReal(h,id,3,0)
        call SaveReal(h, id, AngleHash, AtanPoint(GetUnitX(u), GetUnitY(u), GetSpellTargetX(), GetSpellTargetY()))
        call PauseUnit(u,true)
        call SetUnitInvulnerable(u,true)
        call SetUnitAnimationByIndex(u, 10)
        set n=CreateUnit(p,'e06G',GetUnitX(u),GetUnitY(u),GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',2)
        call SetUnitTimeScale(n,0.25)
        set n=CreateUnit(p,'e0DW',GetUnitX(u),GetUnitY(u),GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',2)
        call SetUnitVertexColor(n,255,255,255,70)
        call SetUnitColor(n,PLAYER_COLOR_LIGHT_GRAY)
        call SetUnitTimeScale(n,0.8)
        // set n=CreateUnit(p,0x65304456,GetUnitX(u),GetUnitY(u),GetRandomReal(0,359))
        // call UnitApplyTimedLife(n,'BTLF',2)
        // call SetUnitTimeScale(n,0.25)
        set n=CreateUnit(p,'e0DU',GetUnitX(u),GetUnitY(u),GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',2)
        call SetUnitTimeScale(n,0.25)
        set n=CreateUnit(p,'dH27',GetUnitX(u),GetUnitY(u),GetRandomReal(0,360))
        call SetUnitFlyHeight(n, 50, 0)
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call MyRemoveUnit(n, 1.5)
        set n=CreateUnit(p,'dH27',GetUnitX(u),GetUnitY(u),GetRandomReal(0,360))
        call SetUnitFlyHeight(n, 50, 0)
        call SetUnitScale(n, 2, 2, 2)
        call MyRemoveUnit(n, 1.5)
        
        set soundplay=SndN(1350) // Sound\Music\mp3Music\GinBankaiKami.mp3
        call StartSound(soundplay)
        call SetSoundVolumeBJ(soundplay,140)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        call TimerStart(t,0.1,true,function BankaiGinCast2)
        set u=null
        set t=null
        set p=null
endfunction
function BankaiGinInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function BankaiGinCast)
call TriggerAddCondition(t,Condition(function BankaiGinCond))
set t=null
endfunction
function ShinsoCond takes nothing returns boolean
return GetSpellAbilityId()=='A0IZ' and udg_B==true
endfunction
function ShinsoCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=LoadReal(h,id,1)
local real y=LoadReal(h,id,2)
local real a=Atan2(LoadReal(h,id,4)-y,LoadReal(h,id,3)-x)
local real l__d=LoadReal(h,id,5)
local group g=LoadGroupHandle(h,id,6)
local player p=GetOwningPlayer(u)
local integer l__s=SH_chain
local integer ss=SH_chain2
local integer numb=LoadInteger(h,id,10)
local real dmg=(2+GetUnitAbilityLevel(u,'A0IZ'))*GetHeroAgi(u,true)+100
local integer l__idg=GetHandleId(g)
local integer lvl=GetUnitAbilityLevel(u,'A0J3')
if l__d<GetHeroAgi(u,true)*5.0+2000 then
set x=x+l__d*Cos(a)
set y=y+l__d*Sin(a)
set n=CreateUnit(p,'e0DR',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',30)
call SaveReal(h,id,5,l__d+30+0.25*GetHeroLevel(u))
call SaveUnitHandle(h,id,ss+numb,n)
call SaveInteger(h,id,10,numb+1)
call SaveDestructableHandle(h,id,l__s+numb,CreateDestructable('B003',x,y,a*bj_RADTODEG,1,1))
call GroupEnumUnitsInRange(g,x,y,85,Base)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set ide=GetHandleId(E)
if Condition_Base(p,E)then
if E!=LoadUnitHandle(h,l__idg,ide)then
call GinT_AddStack(u, E)
call UnitAddAbility(E,'A15G')
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call UnitRemoveAbility(E,'A15G')
call SaveUnitHandle(h,l__idg,ide,E)
call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",GetUnitX(E),GetUnitY(E)))
if lvl>0 then
endif
endif
call Push3(E,30+0.5*GetHeroLevel(u),a,100+GetHeroLevel(u),"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
endif
call GroupRemoveUnit(g,E)
endloop
else
if numb>=0 then
call RemoveUnit(LoadUnitHandle(h,id,ss+numb))
call RemoveDestructable(LoadDestructableHandle(h,id,l__s+numb))
call SaveInteger(h,id,10,numb-1)
else
set l__idg=GetHandleId(g)
call PauseUnit(u,false)
call SetUnitTimeScale(u,1)
call UnitRemoveAbility(u,'A15G')
call SetUnitInvulnerable(u,false)
if IsAbilityOnCooldown(GetUnitAbility(u,'A0IZ'))==false then
call IssueImmediateOrder(u,"stop")
endif
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
endif
set p=null
set u=null
set g=null
set t=null
endfunction
function ShinsoCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)+90*bj_DEGTORAD
local player p=GetOwningPlayer(u)
local boolean bGinBankai = LoadBoolean(h, GetHandleId(u), SH_GinBankai)
call SaveGroupHandle(h,id,6,CreateGroup())
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,x-25*Cos(a))
call SaveReal(h,id,8,2)
call SaveReal(h,id,2,y-25*Sin(a))
call SaveReal(h,id,3,GetSpellTargetX())
call SaveReal(h,id,4,GetSpellTargetY())
call SaveInteger(h,id,10,0)
call PauseUnit(u,true)
call SetUnitTimeScale(u,0)
call SetUnitInvulnerable(u,true)
set soundplay=SndN(1352) // Sound\Music\mp3Music\GinIchimaruShinso.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call UnitAddAbility(u,'A15G')
if bGinBankai then
        call TimerStart(t,0.001,true,function ShinsoCast2)
else
        call TimerStart(t,0.007-0.00005*GetHeroLevel(u),true,function ShinsoCast2)
endif
set p=null
set u=null
set t=null
endfunction
function ShinsoInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function ShinsoCast)
call TriggerAddCondition(t,Condition(function ShinsoCond))
set t=null
endfunction
function SentenHakujaCond takes nothing returns boolean
return GetSpellAbilityId()=='A0J1' and udg_B==true or DU==false
endfunction
function SentenHakujaCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
set soundplay=SndN(1325) // Sound\Music\mp3Music\GinW.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
if RectContainsCoords(gg_rct_GameZone,x1,y1)and DU==true then
call UnitApplyTimedLife(CreateUnit(p,'e0DS',x,y,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0DT',x,y,a*bj_RADTODEG),'BTLF',1)
call SetUnitXY_1(u,x1,y1, false)
call GroupEnumUnitsInRange(G,x,y,300,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)==false then
call SetUnitX(E,x1)
call SetUnitY(E,y1)
endif
call GroupRemoveUnit(G,E)
endloop
call UnitApplyTimedLife(CreateUnit(p,'e0DS',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0DT',x1,y1,a*bj_RADTODEG),'BTLF',1)
elseif RectContainsCoords(gg_rct_Arena,x1,y1)and DU==false then
call UnitApplyTimedLife(CreateUnit(p,'e0DS',x,y,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0DT',x,y,a*bj_RADTODEG),'BTLF',1)
call SetUnitXY_1(u,x1,y1, false)
call GroupEnumUnitsInRange(G,x,y,300,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)==false then
call SetUnitX(E,x1)
call SetUnitY(E,y1)
endif
call GroupRemoveUnit(G,E)
endloop
call UnitApplyTimedLife(CreateUnit(p,'e0DS',x1,y1,a*bj_RADTODEG),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e0DT',x1,y1,a*bj_RADTODEG),'BTLF',1)
endif
set p=null
set u=null
endfunction
function SentenHakujaInit takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set i=i+1
exitwhen i>=bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(t,function SentenHakujaCast)
call TriggerAddCondition(t,Condition(function SentenHakujaCond))
set t=null
endfunction

function GinNewSpellsCast takes nothing returns nothing
        if GetSpellAbilityId()=='GinD' then
                call GinD_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY(), CreateTimer())
        endif
        if GetSpellAbilityId()=='GinW' then
                call GinW_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY(), CreateTimer())
        endif
        if GetSpellAbilityId()=='GinR' then
                call GinNewR_Cast(GetSpellAbilityUnit(), GetSpellTargetX(), GetSpellTargetY(), CreateTimer())
        endif
        if GetSpellAbilityId()=='GinT' then
                call GinT_Cast(GetSpellAbilityUnit(), GetSpellTargetUnit(), CreateTimer())
        endif
endfunction

function GinNewSpellsInit takes nothing returns nothing
        local trigger t=CreateTrigger()
        local integer i=0
        loop
                call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
                set i=i+1
                exitwhen i>=bj_MAX_PLAYER_SLOTS
        endloop
        call TriggerAddAction(t,function GinNewSpellsCast)
        set t=null
endfunction

