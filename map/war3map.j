function CondBrolyLariat takes nothing returns boolean
return GetSpellAbilityId()=='A0JD'
endfunction
function CastBrolyLariat2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(HH,id,0)
local unit u1=LoadUnitHandle(HH,id,11)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real x2=LoadReal(HH,id,4)
local real y2=LoadReal(HH,id,5)
local real a=LoadReal(HH,id,1)
local group g=LoadGroupHandle(HH,id,3)
local integer l__idg=GetHandleId(g)
local real dmg=GetHeroStr(u,true)*(0.875+(1.125*(GetUnitAbilityLevel(u,'A0JD'))))
local player p=GetOwningPlayer(u)
local integer l__ide
local real x3=x2+1100*Cos(a)
local real y3=y2+1100*Sin(a)
local real dist=LoadReal(HH,id,100)
local boolean Hit=LoadBoolean(HH,id,6)
if dist<1100 and IsTerrainPathable(x1,y1,PATHING_TYPE_FLYABILITY)==false and LoadBoolean(HH,GetHandleId(u),DASH_USER)==true then
call SaveReal(HH,id,100,dist+45)
call SetUnitXY_1(u,x1+45*Cos(a),y1+45*Sin(a), false)
call SetUnitXY_1(u1,x1+45*Cos(a),y1+45*Sin(a), false)
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitAnimation(u,"walk")
set n=CreateUnit(GetOwningPlayer(u),'e1E6',x1-45*Cos(a),y1-45*Sin(a),a*bj_RADTODEG) 
call SetUnitScale(n,0.9,0.9,0.9)
call UnitApplyTimedLife(n,1,0.15)
call SetUnitTimeScale(n,2)
call GroupEnumUnitsInRange(G,x1+20*Cos(a),y1+20*Sin(a),180,Base)
loop
set E=FirstOfGroup(G)
set l__ide=GetHandleId(E)
if Condition_Base(p,E) then
    if LoadBoolean(HH,GetHandleId(E),ANTITARGET_ABILITY)==false then
        call Push3(E,25,Atan2(y3-GetUnitY(E),x3-GetUnitX(E)),50,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
        if LoadUnitHandle(HH,l__idg,l__ide)!=E then
            call SaveUnitHandle(HH,l__idg,l__ide,E)
            call SaveBoolean(HH,id,6,false)
            call SetControlToUnit(E,E, 1, "stun")
        endif
    else
        call SaveBoolean(HH,GetHandleId(u),DASH_USER,false)
        call SaveUnitHandle(HH,GetHandleId(E),REVERSE_TARGET,u)
    endif
endif
call GroupRemoveUnit(G,E)
exitwhen E==null
endloop
else
call GroupEnumUnitsInRange(G,x1+40*Cos(a),y1+40*Sin(a),210,Base)
loop
set E=FirstOfGroup(G)
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 0.2, "stun")
call Push3(E,25,Atan2((y3+380*Sin(a))-GetUnitY(E),(x3+380*Cos(a))-GetUnitX(E)),300,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
if Hit==false then
call SlowUnit(u,E,0.5,0.5,5,2,false)
call SetUnitAnimation(u,"attack 4")
set n=CreateUnit(p,'e1E7',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.4)
call SetUnitScale(n,0.6,0.6,0.6)
call SetUnitTimeScale(n,0.6)
call SetUnitVertexColor(n,105,250,100,150)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\BrolyHit.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call SaveBoolean(HH,id,6,true)
endif
endif
call GroupRemoveUnit(G,E)
exitwhen E==null
endloop
call SaveBoolean(HH,GetHandleId(u),DASH_USER,false)
call UnitApplyTimedLife(u1,'BHwe',0.15)
call SaveInteger(h,GetHandleId(u),StringHash("BrolyQ"),1)
call RemoveSaveHashTimed(2,GetHandleId(u),StringHash("BrolyQ"))
call FlushChildHashtable(HH,id)
call FlushChildHashtable(HH,l__idg)
call DestroyTimer(t)
call DestroyGroup(g)
call PauseUnit(u,false)
call SetUnitTimeScale(u,1)
endif
set u=null
set p=null
set t=null
set g=null
endfunction
function CastBrolyLariat takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local boolean Hit
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
call SaveUnitHandle(HH,id,0,u)
call SaveReal(HH,id,4,x)
call SaveReal(HH,id,5,y)
call SaveBoolean(HH,id,6,true)
call SaveReal(HH,id,1,a)
call SaveGroupHandle(HH,id,3,CreateGroup())
call PauseUnit(u,true)
call SaveBoolean(HH,GetHandleId(u),DASH_USER,true)
call SetUnitTimeScale(u,3)
call SaveReal(HH,id,100,0)
call SetUnitAnimation(u,"attack")
set n=CreateUnit(GetOwningPlayer(u),'e1E8',x,y,LoadReal(HH,id,1)*bj_RADTODEG) 
call SaveUnitHandle(HH,id,11,n)
call SetUnitScale(n,1.8,1.8,1.8)
call SetUnitVertexColor(n,160,255,160,225)
call SetUnitTimeScale(n,1)
set n=CreateUnit(p,'e11T',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,75)
call UnitApplyTimedLife(n,1,0.35)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+45)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,1,0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG-45)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,1,0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,1,0.4)
call SetUnitTimeScale(n,3)
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\BrolyDash.mp3",false,false,true,12700,12700,"")
else
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Broly\\BrolyDash-jap.mp3",false,false,true,12700,12700,"")
endif
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.02,true,function CastBrolyLariat2)
set u=null
set p=null
set t=null
endfunction
function BrolyLariatInit takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddAction(t,function CastBrolyLariat)
call TriggerAddCondition(t,Condition(function CondBrolyLariat))
set t=null
endfunction
