function ArcueidRCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local unit l__d
local player p=GetOwningPlayer(u)
local player pc=GetOwningPlayer(c)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real x2=0
local real y2=0
local real a=Atan2(y1-y,x1-x)
local real an=a*bj_RADTODEG+90
local force f=CreateForce()
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
call SetUnitZ(c,-3100)
call SetUnitFacing(c,a*bj_RADTODEG+180)
call SaveForceHandle(h,id,17,f)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveReal(h,id,2,0)
call SaveReal(h,id,3,a)
call SaveInteger(h,id,11,0)
call UnitAddAbility(u,'Arav')
call UnitRemoveAbility(u,'Arav')
call UnitAddAbility(c,'Arav')
call UnitRemoveAbility(c,'Arav')
call UnitAddAbility(c,'A3IH')
call UnitAddAbility(c,'A0QL')
call SetUnitInvulnerable(c,true)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call SetUnitTargetable(c,false)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG-30)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+30)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set l__d=CreateUnit(p,'e15D',x1-800*Cos(a),y1-800*Sin(a),a*bj_RADTODEG)
call SetUnitVertexColor(l__d,255,255,255,220)
call SetUnitZ(l__d,-4000)
call SetUnitTimeScale(l__d,0.75)
call SetUnitAnimation(l__d,"Spell Slam Four")
call SaveUnitHandle(h,id,4,l__d)
set x1=x1-300*Cos(a)
set y1=y1-300*Sin(a)
if IsUnitIllusion(c)==false and IsUnitType(c, UNIT_TYPE_HERO)==true then
if GetLocalPlayer()==pc then
call ForceAddPlayer(f,pc)
set x2=GetCameraEyePositionX()
set y2=GetCameraEyePositionY()
call PanCameraToTimedWithZ(x1-1500*Cos(an*bj_DEGTORAD),y1-1500*Sin(an*bj_DEGTORAD),-1000,0)
call SetCameraFieldForPlayer(pc,CAMERA_FIELD_ZOFFSET,-3500,0)
call SetCameraFieldForPlayer(pc,CAMERA_FIELD_TARGET_DISTANCE,4000, 0.1)
call SetCameraFieldForPlayer(pc,CAMERA_FIELD_ANGLE_OF_ATTACK,350.00,0)
call SetCameraFieldForPlayer(pc,CAMERA_FIELD_ROTATION,an,0)
endif
set archR=true
endif
if(IsPlayerInForce(GetLocalPlayer(),f))then
call EnableUserControl(false)
endif
call SaveReal(h,id,31,x2)
call SaveReal(h,id,32,y2)
call TimerStart(t,2.5,false,function ArcueidRCast2)
else
call PauseTimer(t)
call DestroyTimer(t)
call SetUnitVertexColor(u,255,255,255,255)
call FlushChildHashtable(h,id)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
call SetUnitTimeScale(u,1)
endif
set u=null
set l__d=null
set f=null
set p=null
set t=null
set pc=null
endfunction
function ArcueidTCond takes nothing returns boolean
