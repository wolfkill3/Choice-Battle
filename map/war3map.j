function MadokaR_Buff_Delete takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local unit caster=LoadUnitHandle(h, id, CasterHash)
    call UnitRemoveAbility(caster, 'MaRb')
    call FlushChildHashtable(h, id)
    call DestroyTimer(GetExpiredTimer())
endfunction

function MadokaR_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local real distance=LoadReal(h, id, StringHash("Distance"))
    local real angle=LoadReal(h, id, AngleHash)
    local unit caster=LoadUnitHandle(h, id, CasterHash)
    local timer bjTTT=GetExpiredTimer()
    if distance < 800 then
        call SetUnitX(caster, GetUnitX(caster) + 36 * Cos(angle))
        call SetUnitY(caster, GetUnitY(caster) + 36 * Sin(angle))
        call SaveReal(h, id, StringHash("Distance"), distance + 36)
        if LoadInteger(h, id, EffectPeriodHash) == 0 then
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dM11', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
            call SetUnitFlyHeight(bjLCU, 150, 0)
            call SetUnitVertexColor(bjLCU, 255, 255, 255, 140)
            call SetUnitScale(bjLCU, 0.6, 0.6, 0.6)
            call MyRemoveUnit(bjLCU , 1.5)
            set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dM29', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
            call SetUnitVertexColor(bjLCU, 255, 255, 255, 180)
            call MyRemoveUnit(bjLCU , 1.5)
            call SaveInteger(h, id, EffectPeriodHash, 8)
        else
            call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash) - 1)
        endif
    else
        set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dM30', GetUnitX(caster), GetUnitY(caster), angle * bj_RADTODEG)
        call SetUnitScale(bjLCU, 0.85, 0.85, 0.85)
        call SetUnitVertexColor(bjLCU, 255, 255, 255, 200)
        call MyRemoveUnit(bjLCU , 1.5)
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
        call SetUnitVertexColor(caster, 255, 255, 255, 255)
        call UnitAddAbility(caster, 'MaR1')
        call UnitRemoveAbilityTimed_ExD(caster , 'MaR1' , 10.0)
        if GetAbilityRemainingCooldown(GetUnitAbility(caster , 'MaQ1')) > 0.5 then
            call StartAbilityCooldown(GetUnitAbility(caster , 'MaQ1' ), 0.5)
        endif
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
        set bjLCT=CreateTimer()
        call SaveUnitHandle(h, GetHandleId(bjLCT), CasterHash, caster)
        call TimerStart(bjLCT, 10, false, function MadokaR_Buff_Delete)
        set bjLCT=null
    endif
    set caster=null
endfunction

function MadokaR_Cast takes unit newCaster,real point_x,real point_y,timer newTimer returns nothing
    local integer id=GetHandleId(newTimer)
    local real caster_x=GetUnitX(newCaster)
    local real caster_y=GetUnitY(newCaster)
    local real angle=AtanPoint(caster_x , caster_y , point_x , point_y)
        local real distance=0
        if SquareRootPoint(caster_x, caster_y, point_x, point_y)<1000 then
                set distance=1000-SquareRootPoint(caster_x, caster_y, point_x, point_y)
        endif
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM04', caster_x, caster_y, angle * bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 150, 0)
    call SetUnitScale(bjLCU, 0.8, 0.8, 0.8)
    call MyRemoveUnit(bjLCU , 1.5)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM11', caster_x, caster_y, angle * bj_RADTODEG)
    call SetUnitFlyHeight(bjLCU, 150, 0)
    call MyRemoveUnit(bjLCU , 1.5)
    set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dM30', caster_x, caster_y, angle * bj_RADTODEG)
    call SetUnitScale(bjLCU, 0.85, 0.85, 0.85)
    call SetUnitVertexColor(bjLCU, 255, 255, 255, 200)
    call MyRemoveUnit(bjLCU , 1.5)
    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, 3)
    call SetUnitVertexColor(newCaster, 255, 255, 255, 110)
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call SaveReal(h, id, AngleHash, angle)
        call SaveReal(h, id, StringHash("Distance"), distance)
    set soundplay=CreateSound("Sound\\war3mapImported\\MadokaR.mp3", false, false, true, 12700, 12700, "")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    call TimerStart(newTimer, 0.01, true, function MadokaR_Periodic)
endfunction


function MadokaT1_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local real time=LoadReal(h, id, TIME_HASH)
    local unit caster=LoadUnitHandle(h, id, CasterHash)
    local unit seal=LoadUnitHandle(h, id, Dummy1Hash)
    local real angle=0.0
    local real damage=LoadReal(h, id, StringHash("Damage"))
    if time < 4.5 then
        call SaveReal(h, id, TIME_HASH, time + 0.1)
        
        if time == 1.0 then
            set angle=AU(caster , seal)
            set n=CreateUnit(GetOwningPlayer(caster), 'dM79', GetUnitX(caster) + 50 * Cos(angle), GetUnitY(caster) + 50 * Sin(angle), angle * bj_RADTODEG)
            call SaveUnitHandle(h, id, StringHash("Dummy3"), n)
        endif
        if time == 1.3 then
            call ShakeCamera(0.2 , 10)
            call PauseUnit(caster, false)
            call SetUnitInvulnerable(caster, false)
            set angle=0.0
            loop
            exitwhen angle == 360 * bj_DEGTORAD
                set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM40', GetUnitX(caster) + 330 * Cos(angle), GetUnitY(caster) + 330 * Sin(angle), angle * bj_RADTODEG + 180)
                call SetUnitScale(n, 1.5, 1.5, 1.5)
                call SetUnitVertexColor(n, 255, 255, 255, 110)
                call MyRemoveUnit(n , 1.5)
            set angle=angle + 30 * bj_DEGTORAD
            endloop
            call SetUnitFlyHeight(LoadUnitHandle(h, id, StringHash("Dummy3")), 3000, 2500)
            call Push3(LoadUnitHandle(h, id, StringHash("Dummy3")) , 60 , AU(caster , seal) , 1300 , "")
            set n=CreateUnit(GetOwningPlayer(caster), 'dM80', GetUnitX(caster), GetUnitY(caster), AU(caster , seal) * bj_RADTODEG)
            call SetUnitScale(n, 0.8, 0.8, 0.8)
            call SetUnitTimeScale(n, 0.6)
            call MyRemoveUnit(n , 1.5)
        endif
        if time == 1.8 then
            call KillUnit(LoadUnitHandle(h, id, StringHash("Dummy3")))
            call RemoveUnit(LoadUnitHandle(h, id, StringHash("Dummy3")))
            set soundplay=CreateSound("Sound\\war3mapImported\\MadokaT1_Sound2.mp3", false, false, true, 12700, 12700, "")
            call StartSound(soundplay)
            call KillSoundWhenDone(soundplay)
            set n=CreateUnit(GetOwningPlayer(caster), 'dM52', GetUnitX(seal), GetUnitY(seal), GetRandomInt(0, 360))
            call SetUnitScale(n, 4.5, 4.5, 4.5)
            call SetUnitVertexColor(n, 255, 155, 155, 255)
            call SetUnitFlyHeight(n, 1200, 0)
            call MyRemoveUnit(n , 1.5)
                        call RemoveUnit(seal)
                        set n=CreateUnit(GetOwningPlayer(caster), 'dM50', GetUnitX(seal), GetUnitY(seal), GetRandomInt(0, 360))
                        call SetUnitScale(n, 7, 7, 7)
                        call SetUnitFlyHeight(n, 1200, 0)
                        set seal=n
                        call SaveUnitHandle(h, id, Dummy1Hash, n)
                        set n=CreateUnit(GetOwningPlayer(caster), 'dM50', GetUnitX(seal), GetUnitY(seal), GetRandomInt(0, 360))
                        call SetUnitScale(n, 7, 7, 7)
                        call SetUnitFlyHeight(n, 1200, 0)
                        call SaveUnitHandle(h, id, Dummy2Hash, n)
        endif
        if time == 2.0 then
            call ShakeCamera(2.5 , 10)
            set soundplay=CreateSound("Sound\\war3mapImported\\MadokaT1_Sound3.mp3", false, false, true, 12700, 12700, "")
            call StartSound(soundplay)
            call KillSoundWhenDone(soundplay)
            set n=CreateUnit(GetOwningPlayer(caster), 'dM72', GetUnitX(seal), GetUnitY(seal), GetRandomInt(0, 360))
            call SetUnitScale(n, 1.5, 1.5, 1.5)
            call SetUnitFlyHeight(n, 1200, 0)
            call MyRemoveUnit(n , 1.5)
            set n=CreateUnit(GetOwningPlayer(caster), 'dM81', GetUnitX(seal), GetUnitY(seal), GetRandomInt(0, 360))
            call SetUnitVertexColor(n, 255, 255, 155, 125)
            call SetUnitScale(n, 5, 5, 5)
            call SetUnitTimeScale(n, 2)
            call SetUnitFlyHeight(n, 200, 0)
            call UnitApplyTimedLife(n, 1, 2.5)
            call MyRemoveUnit(n , 4)
        endif
        if time > 2.0 then
            set bj_forLoopAIndex=0
            loop
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
            exitwhen bj_forLoopAIndex == 5
                set n=CreateUnit(GetOwningPlayer(caster), 'dM78', GetUnitX(seal) + GetRandomInt(- 750, 750), GetUnitY(seal) + GetRandomInt(- 750, 750), GetRandomInt(0, 360))
                call SetUnitFlyHeight(n, 0, GetRandomInt(3500, 5000))
                call SetUnitScale(n, 1.6, 1.6, 1.6)
                call SetUnitTimeScale(n, 1.6)
                call UnitApplyTimedLife(n, 1, 0.5)
                call MyRemoveUnit(n , 1.5)
            endloop
            set bjLCG=LoadGroupHandle(h, id, GroupHash)
            call GroupEnumUnitsInRange(bjLCG, GetUnitX(seal), GetUnitY(seal), 1000, Base)
            loop
            set E=FirstOfGroup(bjLCG)
            exitwhen E == null
                if Condition_Base(GetOwningPlayer(caster) , E) then
                    call myCustomDamage(caster , E , damage , false , false , null , null , null)
                elseif IsUnitAlly(E, GetOwningPlayer(caster)) and LoadBoolean(h, id, StringHash("Heal")) then
                    call HealTextTag(caster,E,  damage*0.40*myCustomHeal2(E,1),"HealthRes")
                    call SetWidgetLife(E, GetWidgetLife(E)+damage*0.40)
                endif
            call GroupRemoveUnit(bjLCG, E)
            endloop
        endif
    else
        set n=CreateUnit(GetOwningPlayer(caster), 'dM52', GetUnitX(seal), GetUnitY(seal), GetRandomInt(0, 360))
        call SetUnitScale(n, 3, 3, 3)
        call SetUnitVertexColor(n, 255, 155, 155, 255)
        call SetUnitFlyHeight(n, 1000, 0)
        call MyRemoveUnit(n , 1.5)
        call SetUnitAnimation(seal, "Birth")
        call SetUnitAnimation(LoadUnitHandle(h, id, Dummy2Hash), "Birth")
        call MyRemoveUnit(seal , 0.25)
        call MyRemoveUnit(LoadUnitHandle(h, id, Dummy2Hash) , 0.25)
        call DestroyGroup(LoadGroupHandle(h, id, GroupHash))
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
    set seal=null
endfunction

function MadokaT1_Cast takes unit newCaster,real point_x,real point_y,timer newTimer returns nothing
    local integer id=GetHandleId(newTimer)
    set soundplay=CreateSound("Sound\\war3mapImported\\MadokaT1_Sound1.mp3", false, false, true, 12700, 12700, "")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
        set soundplay=CreateSound("Sound\\war3mapImported\\MadokaT1_Voice1.mp3", false, false, true, 12700, 12700, "")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
        if GetUnitTypeId(newCaster)=='HMad' then
                call SetUnitAnimationByIndex(newCaster, 7)
        else
                call SetUnitAnimationByIndex(newCaster, 9)
        endif
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call DestroyEffect(AddSpecialEffectTarget("yx_xiaoyuanxuli2.mdl", newCaster, "weapon"))
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM32', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    call SetUnitScale(n, 3, 3, 3)
    call SetUnitVertexColor(n, 255, 255, 255, 150)
    call UnitApplyTimedLife(n, 1, 3)
    call MyRemoveUnit(n , 3.7)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dAlb', point_x, point_y, GetRandomInt(0, 360))
        call SetUnitFlyHeight(n, 1200, 0)
        call SaveUnitHandle(h, id, Dummy1Hash, n)
    call SaveBoolean(h, id, StringHash("Heal"), LoadBoolean(h, GetHandleId(newCaster), StringHash("MadokaW")))
    call SaveReal(h, id, StringHash("Damage"), ( GetHeroInt(newCaster, true) * 5 ) * ( 1 + MadokaD_UseStacks(newCaster , 0.25) ) * 0.1)
    call SaveGroupHandle(h, id, GroupHash, CreateGroup())
    call TimerStart(newTimer, 0.1, true, function MadokaT1_Periodic)
endfunction

function MadokaT2_Single_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local real time=LoadReal(h, id, TIME_HASH) + 0.02
    local unit target=LoadUnitHandle(h, id, TargetHash)
    call SaveReal(h, id, TIME_HASH, time)
    if time < 3.0 then
        call SetUnitX(LoadUnitHandle(h, id, Dummy1Hash), GetUnitX(target))
        call SetUnitY(LoadUnitHandle(h, id, Dummy1Hash), GetUnitY(target))
        if time == 2.0 then
            set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM72', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
            call SetUnitScale(n, 1.4, 1.4, 1.4)
            call SetUnitTimeScale(n, 0.5)
            call SaveUnitHandle(h, id, Dummy2Hash, n)
        endif
        if time > 2.0 then
            call SetUnitX(LoadUnitHandle(h, id, Dummy2Hash), GetUnitX(target))
            call SetUnitY(LoadUnitHandle(h, id, Dummy2Hash), GetUnitY(target))
        endif
    else
        set bjLCG=CreateGroup()
        call GroupEnumUnitsInRange(bjLCG, GetUnitX(target), GetUnitY(target), 450, Base)
        loop
        set E=FirstOfGroup(bjLCG)
        exitwhen E == null
            if Condition_Base(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)) , E) then
                call myCustomDamage(LoadUnitHandle(h, id, CasterHash) , E , GetHeroInt(LoadUnitHandle(h, id, CasterHash), true) * 7 + ( GetWidgetMaxLife(E) - GetWidgetLife(E) ) * 0.6 , false , false , null , null , null)
            endif
        call GroupRemoveUnit(bjLCG, E)
        endloop
        call DestroyGroup(bjLCG)
        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM71', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
        call SetUnitScale(n, 0.3, 0.3, 0.3)
        call MyRemoveUnit(n , 1.5)
        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM73', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
        call SetUnitScale(n, 0.5, 0.5, 0.5)
        call MyRemoveUnit(n , 1.5)
        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM28', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
        call SetUnitScale(n, 1.5, 1.5, 1.5)
        call MyRemoveUnit(n , 1.5)
        set n=CreateUnit(GetOwningPlayer(LoadUnitHandle(h, id, CasterHash)), 'dM74', GetUnitX(target), GetUnitY(target), GetRandomInt(0, 360))
        call SetUnitScale(n, 0.25, 0.25, 0.25)
        call MyRemoveUnit(n , 3.5)
        call KillUnit(LoadUnitHandle(h, id, Dummy1Hash))
        call MyRemoveUnit(LoadUnitHandle(h, id, Dummy1Hash) , 1.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, Dummy2Hash) , 1.5)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set target=null
endfunction

function MadokaT2_Single takes unit newCaster,unit newTarget,timer newTimer returns nothing
    local integer id=GetHandleId(newTimer)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM61', GetUnitX(newTarget), GetUnitY(newTarget), GetRandomInt(0, 360))
    call SetUnitVertexColor(n, 255, 255, 255, 150)
    call UnitScale(n , 2.0 , 0.7 , 1.8)
    call SaveUnitHandle(h, id, Dummy1Hash, n)
    //set n=CreateUnit(GetOwningPlayer(newCaster), 'dM65', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    //call UnitScale(n, 1, 3.8, 3)
    //call SaveUnitHandle(h, id, Dummy2Hash, n)
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call SaveUnitHandle(h, id, TargetHash, newTarget)
    call TimerStart(newTimer, 0.02, true, function MadokaT2_Single_Periodic)
endfunction

function MadokaT2_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local unit caster=LoadUnitHandle(h, id, CasterHash)
    local real time=LoadReal(h, id, TIME_HASH) + 0.05
    local real angle=0.0
    call SaveReal(h, id, TIME_HASH, time)
    if time < 6.0 then
        call SetUnitX(LoadUnitHandle(h, id, Dummy1Hash), GetUnitX(caster))
        call SetUnitY(LoadUnitHandle(h, id, Dummy1Hash), GetUnitY(caster))
        call SetUnitX(LoadUnitHandle(h, id, Dummy2Hash), GetUnitX(caster))
        call SetUnitY(LoadUnitHandle(h, id, Dummy2Hash), GetUnitY(caster))
        if time == 3.0 then
            call SetUnitAnimationByIndex(caster, 13)
            call DestroyEffect(AddSpecialEffectTarget("supershinythingy fire5.mdl", caster, "weapon"))
            set soundplay=CreateSound("Sound\\war3mapImported\\MadokaT2_Channel.mp3", false, false, true, 12700, 12700, "")
            call StartSound(soundplay)
            call KillSoundWhenDone(soundplay)
            set bjLCG=CreateGroup()
                        call GroupEnumUnitsInRange(bjLCG, 0, 0, 99999, Base)
            loop
            set E=FirstOfGroup(bjLCG)
            exitwhen E == null
                if Condition_Base(GetOwningPlayer(caster) , E) and IsUnitType(E, UNIT_TYPE_HERO) then
                    call MadokaT2_Single(caster , E , CreateTimer())
                endif
                call GroupRemoveUnit(bjLCG, E)
            endloop
            call DestroyGroup(bjLCG)
        endif
        if time == 5.6 then
            call SetUnitAnimationByIndex(caster, 14)
        endif
    else
        call ShakeCamera(0.3 , 20)
        set angle=0.0
        loop
        exitwhen angle == 360 * bj_DEGTORAD
            set n=CreateUnit(GetOwningPlayer(caster), 'dM40', GetUnitX(caster) + 330 * Cos(angle), GetUnitY(caster) + 330 * Sin(angle), angle * bj_RADTODEG + 180)
            call SetUnitScale(n, 1.5, 1.5, 1.5)
            call SetUnitVertexColor(n, 255, 255, 255, 180)
            call MyRemoveUnit(n , 1.5)
        set angle=angle + 30 * bj_DEGTORAD
        endloop
        call KillUnit(LoadUnitHandle(h, id, Dummy1Hash))
        call KillUnit(LoadUnitHandle(h, id, Dummy2Hash))
        call MyRemoveUnit(LoadUnitHandle(h, id, Dummy1Hash) , 1.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, Dummy2Hash) , 1.5)
        set soundplay=CreateSound("Sound\\war3mapImported\\MadokaT2_Blast.mp3", false, false, true, 12700, 12700, "")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        call PauseUnit(caster, false)
        call SetUnitInvulnerable(caster, false)
                call IssueImmediateOrder(caster, "stop")
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
endfunction

function MadokaT2_Cast takes unit newCaster,timer newTimer returns nothing
    local integer id=GetHandleId(newTimer)
        if GetRandomInt(0,1)==0 or GetPlayerName(GetOwningPlayer(newCaster))=="Uriska" then
                set soundplay=CreateSound("Sound\\war3mapImported\\MadokaT2_Voice2.mp3", false, false, true, 12700, 12700, "")
        else
                set soundplay=CreateSound("Sound\\war3mapImported\\MadokaT2_Voice1.mp3", false, false, true, 12700, 12700, "")
        endif
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    call PauseUnit(newCaster, true)
    call SetUnitInvulnerable(newCaster, true)
    call SetUnitAnimationByIndex(newCaster, 11)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM65', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    call UnitScale(n , 1 , 3.8 , 3)
    call SaveUnitHandle(h, id, Dummy1Hash, n)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM61', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    call SetUnitVertexColor(n, 255, 255, 255, 150)
    call UnitScale(n , 0.7 , 2.1 , 3)
    call SaveUnitHandle(h, id, Dummy2Hash, n)
    call SaveUnitHandle(h, id, CasterHash, newCaster)
    call TimerStart(newTimer, 0.05, true, function MadokaT2_Periodic)
endfunction

function Trig_MadokaInt_Actions takes nothing returns nothing
    if GetSpellAbilityId() == 'MadD' and udg_B then
        call MadokaD_Cast(GetSpellAbilityUnit())
    endif
    if GetSpellAbilityId() == 'MaQ1' then
        call MadokaQ_Switcher(GetSpellAbilityUnit() , GetSpellTargetX() , GetSpellTargetY())
    endif
    if GetSpellAbilityId() == 'MadW' then
        call MadokaW_Cast(GetSpellAbilityUnit() , GetSpellTargetUnit() , CreateTimer())
    endif
    if GetSpellAbilityId() == 'MadR' then
        call MadokaR_Cast(GetSpellAbilityUnit() , GetSpellTargetX() , GetSpellTargetY() , CreateTimer())
    endif
    if GetSpellAbilityId() == 'MaE1' then
        call MadokaE_Switcher(GetSpellAbilityUnit() , GetSpellTargetUnit())
    endif
    if GetSpellAbilityId() == 'MaE2' then
        call MadokaE2_Cast(GetSpellAbilityUnit() , GetSpellTargetUnit() , CreateTimer())
    endif
    if GetSpellAbilityId() == 'MaT1' or GetSpellAbilityId() == 'MaR2' then
        call MadokaT1_Cast(GetSpellAbilityUnit() , GetSpellTargetX() , GetSpellTargetY() , CreateTimer())
    endif
    if GetSpellAbilityId() == 'MaT2' then
        call MadokaT2_Cast(GetSpellAbilityUnit() , CreateTimer())
    endif
endfunction

//===========================================================================
function InitTrig_MadokaInt takes nothing returns nothing
    local trigger trig= CreateTrigger()
    local integer index= 0
    loop
        call TriggerRegisterPlayerUnitEvent(trig, Player(index), EVENT_PLAYER_UNIT_SPELL_EFFECT, null)
        set index=index + 1
        exitwhen index == bj_MAX_PLAYER_SLOTS
    endloop
    call TriggerAddAction(trig, function Trig_MadokaInt_Actions)
    set trig=null
endfunction

//===========================================================================
// Trigger: MadokaDDeath
//===========================================================================
function MadokaE1_Death_Periodic takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local unit caster=LoadUnitHandle(h, id, CasterHash)
        local real caster_x=LoadReal(h, id, StringHash("PointX"))
        local real caster_y=LoadReal(h, id, StringHash("PointY"))
    local real time=LoadReal(h, id, TIME_HASH)
    if time < 5.0 and udg_B then
        call SaveReal(h, id, TIME_HASH, time + 0.1)
        if time < 1.0 then
            set n=CreateUnit(GetOwningPlayer(caster), 'dM42', caster_x, caster_y, GetRandomInt(0, 360))
            call SetUnitScale(n, 1.0 + time * 0.8, 1.0 + time * 0.8, 1.0 + time * 0.8)
            call SetUnitVertexColor(n, 255, 255, 255, 80)
            call SetUnitFlyHeight(n, 10, 0)
            call MyRemoveUnit(n , 1.5)
        endif
        if time == 0.1 then
            call ShakeCamera(0.2 , 5)
            set n=CreateUnit(GetOwningPlayer(caster), 'dM54', caster_x, caster_y, GetRandomInt(0, 360))
            call SetUnitScale(n, 1.1, 1.1, 1.1)
            call SetUnitFlyHeight(n, 150, 0)
            call SetUnitTimeScale(n, 0.6)
            call MyRemoveUnit(n , 2.5)
            set n=CreateUnit(GetOwningPlayer(caster), 'dM55', caster_x, caster_y, GetRandomInt(0, 360))
            call SetUnitScale(n, 1.8, 1.8, 1.8)
            call MyRemoveUnit(n , 2.5)
        endif
        if time == 1.0 then
            call ShakeCamera(1 , 5)
            set soundplay=CreateSound("Sound\\war3mapImported\\MadokaE1_DeathSound.mp3", false, false, true, 12700, 12700, "")
            call StartSound(soundplay)
            call KillSoundWhenDone(soundplay)
            call KillUnit(LoadUnitHandle(h, id, Dummy2Hash))
            call MyRemoveUnit(LoadUnitHandle(h, id, Dummy2Hash) , 1.5)
            set n=CreateUnit(GetOwningPlayer(caster), 'dM56', caster_x, caster_y, GetRandomInt(0, 360))
            call SetUnitScale(n, 1.8, 1.8, 1.8)
            call SaveUnitHandle(h, id, Dummy2Hash, n)
        endif
        if time > 1.0 then
            set bjLCG=LoadGroupHandle(h, id, GroupHash)
            call GroupEnumUnitsInRange(bjLCG, caster_x, caster_y, 600, Base)
            loop
            set E=FirstOfGroup(bjLCG)
            exitwhen E == null
                call myCustomDamage(caster , E , GetWidgetMaxLife(caster) * 0.025 , false , false , null , null , null)
                                if SquareRootPoint(caster_x, caster_y, GetUnitX(E), GetUnitY(E))>100 then
                                        call Push3(E,30,AtanPoint(GetUnitX(E),GetUnitY(E),caster_x, caster_y),30,"")
                                endif
                call GroupRemoveUnit(bjLCG, E)
            endloop
        endif
    else
        call SetUnitTimeScale(LoadUnitHandle(h, id, Dummy2Hash), 0.5)
        call KillUnit(LoadUnitHandle(h, id, Dummy1Hash))
        call KillUnit(LoadUnitHandle(h, id, Dummy2Hash))
        call MyRemoveUnit(LoadUnitHandle(h, id, Dummy1Hash) , 1.5)
        call MyRemoveUnit(LoadUnitHandle(h, id, Dummy2Hash) , 1.5)
        
        call DestroyGroup(LoadGroupHandle(h, id, GroupHash))
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
    endif
    set caster=null
endfunction

function MadokaE1_Death takes unit newCaster,timer newTimer returns nothing
    local integer id=GetHandleId(newTimer)
    set soundplay=CreateSound("Sound\\war3mapImported\\MadokaE1_DeathVoice.mp3", false, false, true, 12700, 12700, "")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM32', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    call SetUnitScale(n, 1.9, 1.9, 1.9)
    call SetUnitVertexColor(n, 255, 255, 255, 100)
    call SaveUnitHandle(h, id, Dummy1Hash, n)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM53', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    call UnitScale(n , 0.5 , 1.0 , 4)
    call SetUnitFlyHeight(n, 50, 0)
        call UnitAddAbility(n, 'MaF5')
    call SaveUnitHandle(h, id, Dummy2Hash, n)
    call SaveUnitHandle(h, id, CasterHash, Hero[GetPlayerId(GetOwningPlayer(newCaster))])
        call SaveReal(h, id, StringHash("PointX"), GetUnitX(newCaster))
        call SaveReal(h, id, StringHash("PointY"), GetUnitY(newCaster))
    call SaveGroupHandle(h, id, GroupHash, CreateGroup())
    call TimerStart(newTimer, 0.1, true, function MadokaE1_Death_Periodic)
endfunction

function MadokaE2_Death takes unit newCaster returns nothing
    set soundplay=CreateSound("Sound\\war3mapImported\\MadokaE2_Death.mp3", false, false, true, 12700, 12700, "")
    call StartSound(soundplay)
    call KillSoundWhenDone(soundplay)
    set bjLCG=CreateGroup()
    call GroupEnumUnitsInRange(bjLCG, GetUnitX(newCaster), GetUnitY(newCaster), 1000, Base)
    loop
    set E=FirstOfGroup(bjLCG)
    exitwhen E == null
        if IsUnitAlly(E, GetOwningPlayer(E)) and UnitIsAlive(E) and E != newCaster then
            call SetWidgetLife(E, GetWidgetLife(E) + GetWidgetMaxLife(newCaster) * 0.1)
        endif
    call GroupRemoveUnit(bjLCG, E)
    endloop
    call DestroyGroup(bjLCG)
    set n=CreateUnit(GetOwningPlayer(newCaster), 'dM66', GetUnitX(newCaster), GetUnitY(newCaster), GetRandomInt(0, 360))
    call UnitScale(n , 0.5 , 1.5 , 1)
    call UnitApplyTimedLife(n, 1, 4)
    call MyRemoveUnit(n , 6)
    call RemoveEffect(AddSpecialEffectTarget("az_20200523153.mdl", newCaster, "origin") , 1 , true , CreateTimer())
endfunction


function Trig_MadokaDDeath_Actions takes nothing returns nothing
    if IsUnitType(GetDyingUnit(), UNIT_TYPE_HERO) and IsUnitIllusion(GetDyingUnit())==false and GetKillingUnit()!=null then
        set bjLCG=CreateGroup()
                call GroupEnumUnitsInRect(bjLCG, bj_mapInitialPlayableArea, Base)
                loop
                set E=FirstOfGroup(bjLCG)
                exitwhen E == null
            if GetUnitAbilityLevel(E, 'MaDs') > 0 and GetHeroLevel(E)>5 and udg_B then
                                call DisplayTimedTextToPlayer(GetOwningPlayer(E), 0, 0, 3, "|c00FF80C0Получен самоцвет души!|r")
                                //call DisplayTimedTextToPlayer(GetOwningPlayer(E), 0, 0, 3, "DebugMSG || Убитый герой: "+GetUnitName(GetDyingUnit()))
                call SetUnitAbilityLevel(E, 'MaDs', GetUnitAbilityLevel(E, 'MaDs') + 1)
                call HealTextTag(E,E,GetWidgetMaxMana(E) * 0.1*myCustomMana2(E,1),"ManaRes")
                call SetWidgetMana(E , GetWidgetMana(E) + GetWidgetMaxMana(E) * 0.1)
            endif
        call GroupRemoveUnit(bjLCG, E)
                endloop
                call DestroyGroup(bjLCG)
    endif
    if GetUnitAbilityLevel(GetDyingUnit(), 'MaE3') > 0 then
        call MadokaE1_Death(GetDyingUnit() , CreateTimer())
    endif
    if GetUnitAbilityLevel(GetDyingUnit(), 'MaE4') > 0 then
        call MadokaE2_Death(GetDyingUnit())
    endif
endfunction

//===========================================================================
function InitTrig_MadokaDDeath takes nothing returns nothing
    local trigger trig= CreateTrigger()
    local integer index= 0
    loop
        call TriggerRegisterPlayerUnitEvent(trig, Player(index), EVENT_PLAYER_UNIT_DEATH, null)
        set index=index + 1
        exitwhen index == bj_MAX_PLAYER_SLOTS
    endloop
    call TriggerAddAction(trig, function Trig_MadokaDDeath_Actions)
    set trig=null
endfunction


