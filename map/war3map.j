function ChangeAbilityTime01Act takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
if GetUnitAbilityLevel(caster,LoadInteger(HH,id,22))>0 then
call UnitRemoveAbility(caster,LoadInteger(HH,id,22))
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),LoadInteger(HH,id,21),true)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
set caster=null
endfunction
function ChangeAbilityTime01 takes unit caster0,real time0,integer idAbil,integer idAbil2 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(HH,id,1,caster0)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster0),idAbil,false)
call UnitAddAbility(caster0,idAbil2)
call SaveInteger(HH,id,21,idAbil)
call SaveInteger(HH,id,22,idAbil2)
call TimerStart(t,time0,false,function ChangeAbilityTime01Act)
set caster0=null
set t=null
endfunction




function Trig_Tempa_Josai_Actions2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real i=LoadReal(h,id,1)
local real dmg=GetUnitState(u,UNIT_STATE_MAX_LIFE)*2

call SaveReal(h,id,1,i+1)
if i>=160 then


//if(GetLocalPlayer()==p)then
//call DisplayTextToPlayer(p,0,0,"tenpa off" )
//endif


call UnitRemoveAbility( u ,'ASST')
call SetPlayerAbilityAvailable(GetOwningPlayer( u ),'A08V',true)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif

if i<138 then
if(OrderId2String(GetUnitCurrentOrder(u))!="channel") then
call SaveReal(h,id,1,148)
call SaveReal(HH,GetHandleId( u ),StringHash("ShanaTR"),i*0.025)

//if(GetLocalPlayer()==p)then
//call DisplayTextToPlayer(p,0,0,"time:"+R2S( i*0.025  ) )
//endif



if i>136 and udg_B then

call SaveReal(HH,GetHandleId( u ),StringHash("ShanaTR"),0)

call GroupEnumUnitsInRange(DG,x,y,900,Base)
loop
set E=FirstOfGroup(DG)
call GroupRemoveUnit(DG,E)
exitwhen E==null
if Condition_Base(p,E)then
call SetUnitInvulnerable(E,false)
call UnitRemoveBuffs(E,true,true)
if UnitHasItemOfTypeBJ(E, 'I03A') and GetWidgetLife(E)>0 and IsUnitIllusion(E)==false then
    set AlastorPos=0
    loop
    exitwhen AlastorPos==6 or GetItemTypeId(UnitItemInSlot(E,AlastorPos)) == 'I03A'
    set AlastorPos=AlastorPos+1
    endloop
    if IsAbilityEnabled(GetUnitAbility(E,'AInv'))==true then
        set Alastor=GetItemOfTypeFromUnitBJ(E,'I03A')
        call UnitRemoveItem(E,Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(E, 'I03A',AlastorPos)
    else
        call EnableUnitAbility2(E,'AInv',false,true)
        set Alastor=GetItemOfTypeFromUnitBJ(E,'I03A')
        call UnitRemoveItem(E,Alastor)
        call RemoveItem(Alastor)
        call UnitAddItemToSlotById(E, 'I03A',AlastorPos)    
        call DisableUnitAbility2(E,'AInv',false,true)
    endif
endif
call UnitAddAbility(E,'A0WR')
call myCustomDamage(u,E,dmg,false,false,null,DAMAGE_TYPE_UNIVERSAL,null)
call DamageIndicatorFunction(u,E,dmg)
call DamageTextTag(u,E,dmg)
call UnitRemoveAbility(E,'A0WR')
endif
endloop




set soundplay=CreateSound("Sound\\Music\\mp3Music\\TenpaJyosai.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call UnitApplyTimedLife(CreateUnit(p,'e03H',x,y,0),1,5)
call UnitApplyTimedLife(CreateUnit(p,'e03I',x,y,0),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e03K',x,y,0),1,3)
call UnitApplyTimedLife(CreateUnit(p,'e04B',x,y,0),1,3)
if GetWidgetLife(u)<GetWidgetMaxLife(u)*0.3 then
	call SetUnitInvulnerable(u,false)
	call UnitAddAbility(u,'A0WR')
	call myCustomDamage(u,u,dmg,false,false,null,DAMAGE_TYPE_UNIVERSAL,null)
	call UnitRemoveAbility(u,'A0WR')
    call DamageTextTag(u,u,dmg)
else
	call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)-GetUnitState(u,UNIT_STATE_LIFE)*0.75)
    call DamageTextTag(u,u,GetUnitState(u,UNIT_STATE_LIFE)*0.75)
endif



endif




call SetUnitInvulnerable(u,false)
call RemoveUnit(LoadUnitHandle(h,id,2))

else






if i>=136 then 
    call IssueImmediateOrder(u,"stop")
endif
if ModuloReal(i,12)<1 then
call UnitApplyTimedLife(CreateUnit(p,0x65303347,x,y,0),1,1)
endif



endif

endif

set p=null
set u=null

endfunction

