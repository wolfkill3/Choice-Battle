function QAtalanta3Cond takes nothing returns boolean
return GetSpellAbilityId()=='A1DT' and GetUnitAbilityLevel(GetTriggerUnit(),'A1DV')>0 and GetUnitTypeId(GetTriggerUnit())=='H06G'
endfunction
function QAtalanta3Cast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real dmg=GetHeroAgi(u,true)*((2+GetUnitAbilityLevel(u,'A1DR'))+(0.5+0.5*GetUnitAbilityLevel(u,'A1DW')))+50
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,6)
local real y1=LoadReal(h,id,7)
local real a=Atan2(y1-y,x1-x)
local real he=LoadReal(h,id,5)
local real dist=LoadReal(h,id,8)
local real sr=SR(x,y,x1,y1)
local real nh=he*sr/dist
local player p=GetOwningPlayer(u)
local integer i=0
local real is=0
local real ig=30*bj_DEGTORAD
if sr>80 and GetWidgetLife(l__d)>0 then
set x=x+75*Cos(a)
set y=y+75*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,nh,0)
call SaveReal(h,id,2,dist+75)
set n=CreateUnit(p,'e135',x,y,a*bj_RADTODEG)
call SetUnitFlyHeight(n,nh,0)
call SetUnitTimeScale(n,2)
call UnitApplyTimedLife(n,'BTLF',0.3)
else
set n=CreateUnit(p,'e137',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',1.5)
call SetUnitTimeScale(n,0.3)
set n=CreateUnit(p,'e138',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,0.5)
call GroupEnumUnitsInRange(G,x1,y1,300,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 2, "stun")
endif
call GroupRemoveUnit(G,E)
endloop
loop
exitwhen is>=13
set n=CreateUnit(p,'e0ZH',x1+350*Cos(ig*is),y1+350*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,200,255,200,55)
call UnitApplyTimedLife(n,'BTLF',0.75)
call SetUnitTimeScale(n,1.5)
set is=is+1
endloop
loop
exitwhen i>=4
set n=CreateUnit(p,'e139',x1,y1,GetRandomReal(0,359))
call SetUnitVertexColor(n,155,255,155,125)
call UnitApplyTimedLife(n,'BTLF',2.4)
call SetUnitTimeScale(n,1.5)
call SetUnitFlyHeight(n,200*i,0)
set i=i+1
endloop
call RemoveSavedHandle(h,GetHandleId(u),SH_arrow)
call SetUnitTimeScale(u,1)
call RemoveUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set u=null
set p=null
set t=null
endfunction
function QAtalanta3Cast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,6)
local real y1=LoadReal(h,id,7)
local real he=GetUnitFlyHeight(u)
local player p=GetOwningPlayer(u)
local real a=LoadReal(h,id,3)
local real time=LoadReal(h,id,4)
if time<0.35 then
set n=LoadUnitHandle(h,id,1)
call SetUnitFlyHeight(n,he+90,0)
call SetUnitX(n,x+75*Cos(a))
call SetUnitY(n,y+75*Sin(a))
set n=LoadUnitHandle(h,id,2)
call SetUnitFlyHeight(n,he+90,0)
call SetUnitX(n,x+150*Cos(a))
call SetUnitY(n,y+150*Sin(a))
call SaveReal(h,id,4,time+0.02)
else
call PauseUnit(u,false)
call StartAbilityCooldown(GetUnitAbility(u,'A1DS'),12)
call SaveReal(h,id,5,he+90)
call SaveReal(h,id,8,SR(x,y,x1,y1))
call PauseTimer(t)
call UnitRemoveAbility(u,'A1DU')
call UnitRemoveAbility(u,'A00D')
call UnitRemoveAbility(u,'Basl')
call ShakeCamera(0.5,25)
call TimerStart(t,0.01,true,function QAtalanta3Cast3)
endif
set u=null
set p=null
set t=null
endfunction
function QAtalanta3Cast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real he=GetUnitFlyHeight(u)
local real a=Atan2(y1-y,x1-x)
call SaveUnitHandle(h,id,0,u)
call PauseUnit(u,true)
set n=CreateUnit(p,'e12Y',x+75*Cos(a),y+75*Sin(a),a*bj_RADTODEG)
call SaveUnitHandle(h,id,1,n)
call SetUnitFlyHeight(n,he+90,0)
call SaveUnitHandle(h,GetHandleId(u),SH_arrow,n)
call SaveReal(h,id,4,0)
call SaveReal(h,id,5,he+90)
call SaveReal(h,id,3,a)
call SaveReal(h,id,6,x1)
call SaveReal(h,id,7,y1)
call SetUnitTimeScale(u,3)
set n=CreateUnit(p,'e118',x+150*Cos(a),y+150*Sin(a),a*bj_RADTODEG+180)
call SaveUnitHandle(h,id,2,n)
call SetUnitVertexColor(n,155,255,155,155)
call SetUnitFlyHeight(n,he+90,0)
call UnitApplyTimedLife(n,'BTLF',0.5)
call SetUnitTimeScale(n,1.5)
call SetUnitAnimation(u,"Spell four")
set soundplay=SndN(2742) // Sound\Music\mp3Music\AtalantaQ2.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.02,true,function QAtalanta3Cast2)
set u=null
set p=null
set t=null
endfunction
