endfunction
function GigantoThorAxeCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local group g=LoadGroupHandle(h,id,1)
local integer i=1
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local real dist
local real dmg=12*GetHeroAgi(u,true)
local integer l__idg=GetHandleId(g)
local real f
local player p=GetOwningPlayer(u)
local integer l__ide
local real time=LoadReal(h,id,4)
if time<1.02 then
call SaveReal(h,id,4,time+0.03)
call SetUnitXY_1(u,x,y, false)
if time==0.69 then
call SetUnitAnimation(u,"Spell Three Two")
endif
if time==0.99 then
call UnitApplyTimedLife(CreateUnit(p,'e03X',x,y,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e03W',x,y,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e08R',x,y,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e03Y',x,y,GetRandomReal(0,359)),1,1)
call UnitApplyTimedLife(CreateUnit(p,'e08N',x,y,GetRandomReal(0,359)),1,1)
call SlashThorGigantoAxe(CreateUnit(p,'e0TF',x,y,0),50,0,0,1000,100)
call SlashThorGigantoAxe(CreateUnit(p,'e0TF',x,y,60),50,0,60*bj_DEGTORAD,1000,100)
call SlashThorGigantoAxe(CreateUnit(p,'e0TF',x,y,120),50,0,120*bj_DEGTORAD,1000,100)
call SlashThorGigantoAxe(CreateUnit(p,'e0TF',x,y,180),50,0,180*bj_DEGTORAD,1000,100)
call SlashThorGigantoAxe(CreateUnit(p,'e0TF',x,y,240),50,0,240*bj_DEGTORAD,1000,100)
call SlashThorGigantoAxe(CreateUnit(p,'e0TF',x,y,300),50,0,300*bj_DEGTORAD,1000,100)
endif
else
loop
exitwhen i>15
set dist=LoadReal(h,id,StringHash("dist"+I2S(i)))+50
call SaveReal(h,id,StringHash("dist"+I2S(i)),dist)
set f=GetRandomReal(0,6.28)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\EarthQuake\\EarthQuakeTarget.mdl",x+dist*Cos(f),y+dist*Sin(f)))
set i=i+1
endloop
set n=CreateUnit(p,'e0QI',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,0.5,0.5,.5)
set n=CreateUnit(p,'e0QI',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,1,1,1)
set n=CreateUnit(p,'e0QI',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,1.5,1.5,1.5)
set n=CreateUnit(p,'e0QI',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,2,2,2)
set n=CreateUnit(p,'e0QI',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,2.5,2.5,2.5)
call GroupEnumUnitsInRange(g,x,y,dist,Base)
loop
set E=FirstOfGroup(g)
set l__ide=GetHandleId(E)
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,l__ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,l__idg,l__ide,E)
call SetControlToUnit(E,E, 4, "stun")
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
if dist>=1000 then
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
call SetUnitAnimation(u,"stand")
endif
endif
set u=null
set g=null
set t=null
set p=null
endfunction
