    call SaveReal(h,id,10,LoadReal(h,id,10)+0.05)
else
    loop
    exitwhen is>=25
    set n=CreateUnit(p,'eo0N',x+750*Cos(ig*is),y+750*Sin(ig*is),180+is*15)
    call SetUnitVertexColor(n,255,255,255,55)
