function SacredSongCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real x2=0
local real y2=0
local real a2=0
local real dist
local real r=GetRandomReal(0,359)
local real a=Atan2(y1-y,x1-x)
local group g=CreateGroup()
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,0)
call SaveReal(h,id,3,a)
call SaveReal(h,id,4,x1)
call SaveReal(h,id,5,y1)
call SaveReal(h,id,6,0)
call SaveReal(h,id,7,0)
call SaveReal(h,id,35,r)
call SaveReal(h,id,8,SR(x,y,x1,y1))
if GetHeroLevel(u)<35 then
set dist=400
else
set dist=700
endif
call SaveReal(h,id,36,dist)
set n=CreateUnit(p,'e0RV',x1,y1,a*bj_RADTODEG)
if dist==400 then
call SetUnitScale(n,1,1,1)
else
call SetUnitScale(n,1.5,1.5,1.5)
endif
call SetUnitVertexColor(n,255,255,255,255)
call SetUnitTimeScale(n,0.15)
call UnitApplyTimedLife(n,'BTLF',2)
set n=CreateUnit(p,'e107',x1,y1,a*bj_RADTODEG)
call SetUnitTimeScale(n,4)
call SaveUnitHandle(h,id,2,n)
call SetUnitTimeScale(n,0.1)
set x2=x1+dist*CosBJ(r)
set y2=y1+dist*SinBJ(r)
call SaveReal(h,id,20,x2)
call SaveReal(h,id,21,y2)
set a2=Atan2(y1-y2,x1-x2)
set n=CreateUnit(p,'e102',x2,y2,a2*bj_RADTODEG)
call SetUnitFlyHeight(n,800,0)
call GroupAddUnit(g,n)
call SaveUnitHandle(h,id,30,n)
set x2=x1+dist*CosBJ(72+r)
set y2=y1+dist*SinBJ(72+r)
call SaveReal(h,id,22,x2)
call SaveReal(h,id,23,y2)
set x2=x1+dist*CosBJ(144+r)
set y2=y1+dist*SinBJ(144+r)
call SaveReal(h,id,28,x2)
call SaveReal(h,id,29,y2)
set x2=x1+dist*CosBJ(216+r)
set y2=y1+dist*SinBJ(216+r)
call SaveReal(h,id,26,x2)
call SaveReal(h,id,27,y2)
set x2=x1+dist*CosBJ(288+r)
set y2=y1+dist*SinBJ(288+r)
call SaveReal(h,id,24,x2)
call SaveReal(h,id,25,y2)
call SaveGroupHandle(h,id,10,g)
set soundplay=SndN(1270) // Sound\Music\mp3Music\Mikagura3.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.02,true,function SacredSongStandCast)
set u=null
set g=null
set p=null
set t=null
endfunction
