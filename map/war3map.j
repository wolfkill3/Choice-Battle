function ARoarCond takes nothing returns boolean
return GetSpellAbilityId()=='A0WA'
endfunction
function ARoarCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=LoadReal(h,id,1)
local real y=LoadReal(h,id,2)
local real a=Atan2(LoadReal(h,id,4)-y,LoadReal(h,id,3)-x)
local real l__d=LoadReal(h,id,5)
local group g=LoadGroupHandle(h,id,6)
local player p=GetOwningPlayer(u)
local real ml=0
local real x1=0
local real y1=0
local integer lvl=GetUnitAbilityLevel(u,'A0WA')
local real k
local real di
if l__d<1500 then
set x=x+l__d*Cos(a)
set y=y+l__d*Sin(a)
set n=CreateUnit(p,'e0T2',x,y,(a*bj_RADTODEG))
call UnitApplyTimedLife(n,'BTLF',2)
call SetUnitTimeScale(n,0.5)
set n=CreateUnit(p,'e0T3',x,y,(a*bj_RADTODEG))
if GetUnitTypeId(u)=='H14H' then
call SetUnitVertexColor(n,150,GetRandomInt(180, 255),GetRandomInt(130, 160),115)
else
call SetUnitVertexColor(n,225,GetRandomInt(10, 255),GetRandomInt(143, 255),115)
endif
call SetUnitTimeScale(n,0.5)
call SetUnitAnimation(n,"Death")
call UnitApplyTimedLife(n,'BTLF',1)
call SaveReal(h,id,5,l__d+75)
call GroupEnumUnitsInRange(g,x,y,350,Base)
set idg=GetHandleId(g)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set ide=GetHandleId(E)
if Condition_Base(p,E)and E!=LoadUnitHandle(h,idg,ide)then
set ml=GetUnitState(E,UNIT_STATE_MAX_LIFE)
set x1=GetUnitX(E)
set y1=GetUnitY(E)
set di=SR1(x+150*Cos(a),y+150*Cos(a),x1,y1)
set k=(350-di)/350
call myCustomDamage(u,E,ml*(0.15+0.04*lvl),false,false,null,null,null)
call Push(E,20,a,300)
call SaveUnitHandle(h,idg,ide,E)
if di<200 then
set k=(210-di)/200
call SetControlToUnit(u,E,k*3,"stun")
else
set k=(350-di)/350
set n=CreateUnit(p,'h019',x,y,a*bj_RADTODEG)
call UnitAddAbility(n,'A0WC')
call SetUnitAbilityLevel(n,'A0WC',R2I(k*10))
call UnitApplyTimedLife(n,'BHwe',1)
call IssueTargetOrder(n,"drunkenhaze",E)
endif
endif
call GroupRemoveUnit(g,E)
endloop
else
set idg=GetHandleId(g)
call PauseTimer(t)
call DestroyTimer(t)
call DestroyGroup(g)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,idg)
endif
set p=null
set u=null
set g=null
set t=null
endfunction
function ARoarCast1 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=LoadReal(h,id,1)
local real y=LoadReal(h,id,2)
local real x1=LoadReal(h,id,3)
local real y1=LoadReal(h,id,4)
local real a=Atan2(y1-y,x1-x)
set n=CreateUnit(GetOwningPlayer(u),'e0T4',x+100*Cos(a),y+100*Sin(a),a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitTimeScale(u,1.)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,x)
call SaveReal(h,id,2,y)
call SaveReal(h,id,3,x1)
call SaveReal(h,id,4,y1)
call SaveGroupHandle(h,id,6,CreateGroup())
call PauseTimer(t)
call TimerStart(t,.035,true,function ARoarCast2)
set u=null
set t=null
endfunction
function ARoarCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,1,x+50*Cos(a))
call SaveReal(h,id,2,y+50*Sin(a))
call SaveReal(h,id,3,GetSpellTargetX())
call SaveReal(h,id,4,GetSpellTargetY())
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
if GetUnitTypeId(u)=='H14H' then
set soundplay=SndN(2125) // Sound\Music\mp3Music\MidoriyaQ.mp3
