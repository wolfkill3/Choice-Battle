function UroborasCond takes nothing returns boolean
return GetSpellAbilityId()==0x41313636
endfunction
function UroborasCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit c=LoadUnitHandle(h,id,0)
local group g=LoadGroupHandle(h,id,1)
local integer i=0
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local real dist
local real dmg=8*GetHeroInt(c,true)
local integer l__idg=GetHandleId(g)
local real f
local player p=GetOwningPlayer(c)
local integer idu
set dist=LoadReal(h,id,StringHash("dist"))+200
call SaveReal(h,id,StringHash("dist"),dist)
loop
exitwhen i>15
set f=24*i
call UnitApplyTimedLife(CreateUnit(p,0x6530594D,x+dist*Cos(f*bj_DEGTORAD),y+dist*Sin(f*bj_DEGTORAD),f+GetRandomReal(-90,90)),1,2)
set i=i+1
endloop
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,0.65,0.65,0.65)
call SetUnitVertexColor(n,0,0,0,100)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,0,0,0,100)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitVertexColor(n,0,0,0,100)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,2,2,2)
call SetUnitVertexColor(n,0,0,0,100)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,2.5,2.5,2.5)
call SetUnitVertexColor(n,0,0,0,100)
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,3,3,3)
call SetUnitVertexColor(n,0,0,0,100)
call GroupEnumUnitsInRange(g,x,y,dist,Base)
loop
set E=FirstOfGroup(g)
set idu=GetHandleId(E)
if IsUnitEnemy(E,p)and E!=LoadUnitHandle(h,l__idg,idu)and IsUnitType(E,UNIT_TYPE_STRUCTURE)==false then
call myCustomDamage(c,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,l__idg,idu,E)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
if dist>=1000 then
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
set c=null
set g=null
set t=null
set p=null
endfunction
