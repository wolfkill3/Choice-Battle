local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
local string dmgtext=""
local string Healtext=""
local unit l__d
local integer i=0
call SetUnitPathing(u,false)
set l__d=CreateUnit(GetOwningPlayer(u),'Ho13',x,y,f)
call SetUnitPathing(l__d,false)
call SetUnitXY_1(l__d,x,y, false)
call SetUnitFacing(l__d,f)
call SetHeroLevel(l__d,GetHeroLevel(u),false)
call SetUnitPathing(l__d,true)
call IssuePointOrder(l__d,"move",x+800*Cos(f*bj_DEGTORAD),y+800*Sin(f*bj_DEGTORAD))
call SetHeroAgi(l__d,GetHeroAgi(u,false),true)
call SetHeroStr(l__d,GetHeroStr(u,false),true)
call SetHeroInt(l__d,GetHeroInt(u,false),true)
loop
exitwhen i>=6
if GetItemTypeId(UnitItemInSlot(u,i))!='Io39' then
set bj_lastCreatedItem=UnitAddItemById(l__d,GetItemTypeId(UnitItemInSlot(u,i)))
call SetItemDroppable(bj_lastCreatedItem,false)
endif
set i=i+1
endloop
set i=0
loop
exitwhen i>=17
    if Hero[i]!=null then
    call SaveInteger(HH,GetHandleId(l__d),TextDamageValueHash+GetPlayerId(GetOwningPlayer(Hero[i])),LoadInteger(HH,GetHandleId(u),TextDamageValueHash+GetPlayerId(GetOwningPlayer(Hero[i]))))
    if LoadInteger(HH,GetHandleId(l__d),TextDamageValueHash+GetPlayerId(GetOwningPlayer(Hero[i])))==0 then
        call SaveStr(HH,GetPlayerId(GetOwningPlayer(Hero[i])),GetHandleId(l__d)+TextDmgValueTextHash,"")
    else
        call SaveStr(HH,GetPlayerId(GetOwningPlayer(Hero[i])),GetHandleId(l__d)+TextDmgValueTextHash,Color[GetPlayerId(GetOwningPlayer(Hero[i]))]+I2S( LoadInteger(HH,GetHandleId(l__d),TextDamageValueHash+GetPlayerId(GetOwningPlayer(Hero[i]))))+"|r  ")
    endif
    set dmgtext=dmgtext+LoadStr(HH,GetPlayerId(GetOwningPlayer(Hero[i]))+GetHandleId(u),TextDmgValueTextHash)    
    endif
    set i=i+1
endloop
call SaveInteger(HH,GetHandleId(l__d),TextHealValueHash+StringHash("HealthRes"),LoadInteger(HH,GetHandleId(u),TextHealValueHash+StringHash("HealthRes")))
if LoadInteger(HH,GetHandleId(l__d),TextHealValueHash+StringHash("HealthRes"))==0 then
    call SaveStr(HH,GetHandleId(l__d),StringHash("HealthRes")+TextHealValueTextHash,"")
else
    call SaveStr(HH,GetHandleId(l__d),StringHash("HealthRes")+TextHealValueTextHash,Color[13]+"+"+I2S( LoadInteger(HH,GetHandleId(l__d),TextHealValueHash+StringHash("HealthRes")))+"|r  ")
endif
set Healtext=Healtext+LoadStr(HH,GetHandleId(u),StringHash("HealthRes")+TextHealValueTextHash)    
call SaveInteger(HH,GetHandleId(l__d),TextHealValueHash+StringHash("ManaRes"),LoadInteger(HH,GetHandleId(u),TextHealValueHash+StringHash("ManaRes")))
if LoadInteger(HH,GetHandleId(l__d),TextHealValueHash+StringHash("ManaRes"))==0 then
    call SaveStr(HH,GetHandleId(l__d),StringHash("ManaRes")+TextHealValueTextHash,"")
else
    call SaveStr(HH,GetHandleId(l__d),StringHash("ManaRes")+TextHealValueTextHash,Color[12]+"+"+I2S( LoadInteger(HH,GetHandleId(l__d),TextHealValueHash+StringHash("ManaRes")))+"|r  ")
endif
set Healtext=Healtext+LoadStr(HH,GetHandleId(u),StringHash("ManaRes")+TextHealValueTextHash) 
call AllTextTag2(dmgtext,l__d)
call AllTextTagHeal2(Healtext,l__d)
set dmgtext=""
set Healtext=""
call SaveReal(HH,GetHandleId(u),TextTagTimeHash,-0.03)
call SaveReal(HH,GetHandleId(u),TextTagHealTimeHash,-0.03)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,l__d)
call SetUnitState(l__d,UNIT_STATE_LIFE,GetWidgetLife(u))
call SetUnitState(l__d,UNIT_STATE_MANA,GetWidgetMana(u))
call UnitEnableInventory(l__d,false,false)
call SaveUnitHandle(HH,GetHandleId(u),StringHash("DeiW"),l__d)
call TimerStart(t,2.5,false,function WDeidaraCast2)
set u=null
set l__d=null
set t=null
endfunction
