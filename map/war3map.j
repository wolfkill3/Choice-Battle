function TDantesCast03 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit d1=LoadUnitHandle(h,id,19)
local unit d2=LoadUnitHandle(h,id,20)
local real dmg1=2*GetHeroAgi(u,true)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,4)
local real y1=LoadReal(h,id,5)
local real x2=0
local real y2=0
local real r=0
local real he=0
local real a=LoadReal(h,id,17)
local real a2=LoadReal(h,id,22)
local real a3=LoadReal(h,id,23)
local real time=LoadReal(h,id,2)
local real dist=LoadReal(h,id,16)
local group g=LoadGroupHandle(h,id,10)
local player p=GetOwningPlayer(u)
local real sc=0
if LoadBoolean(h,id,8) == true then
    set dmg1 = dmg1 * 1.15
endif
if time<1 then
call SaveReal(h,id,2,time+0.03)
set x=x+195*Cos(a)
set y=y+195*Sin(a)
call SetUnitXY_1(u,x,y, false)
set x=GetUnitX(d1)
set y=GetUnitY(d1)
set x=x+195*Cos(a2)
set y=y+195*Sin(a2)
call SetUnitX(d1,x)
call SetUnitY(d1,y)
set x=GetUnitX(d2)
set y=GetUnitY(d2)
set x=x+195*Cos(a3)
set y=y+195*Sin(a3)
call SetUnitX(d2,x)
call SetUnitY(d2,y)
call SaveReal(h,id,16,dist-195)
if dist<0 then
set a=GetRandomReal(0,6.28)
set x=x1-650*Cos(a)
set y=y1-650*Sin(a)
call SetUnitXY_1(u,x,y, false)
set a=Atan2(y1-y,x1-x)
set n=CreateUnit(p,'edR4',x1,y1,(a*bj_RADTODEG))
call UnitApplyTimedLife(n,'BTLF',1.5-time)
call SetUnitTimeScale(n,1)
set n=CreateUnit(p,'ed97',x,y,(a*bj_RADTODEG))
call SetUnitScale(n,2,2,2)
call UnitApplyTimedLife(n,'BTLF',0.5)
call SetUnitTimeScale(n,1)
call SetUnitFacing(u,a)
call SaveReal(h,id,16,1500)
call SaveReal(h,id,17,a)
set a=GetRandomReal(0,6.28)
set x=x1-650*Cos(a)
set y=y1-650*Sin(a)
call SetUnitX(d1,x)
call SetUnitY(d1,y)
set a=Atan2(y1-y,x1-x)
set n=CreateUnit(p,'edR4',x1,y1,(a*bj_RADTODEG))
call UnitApplyTimedLife(n,'BTLF',1.5-time)
call SetUnitTimeScale(n,1)
set n=CreateUnit(p,'ed97',x,y,(a*bj_RADTODEG))
call SetUnitScale(n,2,2,2)
call UnitApplyTimedLife(n,'BTLF',0.5)
call SetUnitTimeScale(n,1)
call SetUnitFacing(d1,a)
call SaveReal(h,id,22,a)
set a=GetRandomReal(0,6.28)
set x=x1-650*Cos(a)
set y=y1-650*Sin(a)
call SetUnitX(d2,x)
call SetUnitY(d2,y)
set a=Atan2(y1-y,x1-x)
set n=CreateUnit(p,'edR4',x1,y1,(a*bj_RADTODEG))
call UnitApplyTimedLife(n,'BTLF',1.5-time)
call SetUnitTimeScale(n,1)
set n=CreateUnit(p,'ed97',x,y,(a*bj_RADTODEG))
call SetUnitScale(n,2,2,2)
call UnitApplyTimedLife(n,'BTLF',0.5)
call SetUnitTimeScale(n,1)
call SetUnitFacing(d2,a)
call SaveReal(h,id,23,a)
endif
call GroupEnumUnitsInRange(G,x1,y1,700,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)and IsUnitInGroup(E,g)==false then
call myCustomDamage(u,E,dmg1,false,false,null,null,null)
call SetControlToUnit(E,E, 0.025, "stun")
call GroupAddUnit(g,E)
elseif Condition_Base(p,E)and IsUnitInGroup(E,g)then
call myCustomDamage(u,E,dmg1*0.03,false,false,null,null,null)
if time<0.97 then
call SetControlToUnit(E,E, 0.015, "stun")
else
call SetControlToUnit(E,E, 1, "stun")
endif
call GroupAddUnit(g,E)
endif
call GroupRemoveUnit(G,E)
endloop
else
call UnitRemoveAbility(u,'Ad8O')
call UnitRemoveAbilityTimed(u,'Ad93',0.3)
call SetUnitX(d1,x)
call SetUnitY(d1,y)
