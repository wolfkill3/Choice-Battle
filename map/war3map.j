function GilACond takes nothing returns boolean
set P=GetTriggerPlayer()
return BaseSkinBuffCond(P) or GetPlayerName(P)=="Slaikee" or GetPlayerName(P)=="KamaBr" or GetPlayerName(P)=="[OSV] Kama" or GetPlayerName(P)=="Annieh" or GetPlayerName(P)=="zld6334" or GetPlayerName(P)=="PinkieNecro" or GetPlayerName(P)=="DBFag" or GetPlayerName(P)=="NecromanseR_RuS" or GetPlayerName(P)=="DBFag" or GetPlayerName(P)=="Starheart" or GetPlayerName(P)=="Wolfkill" or GetPlayerName(P)=="xxNu-13xx" or GetPlayerName(P)=="Denamesh"and GetUnitTypeId(Hero[GetPlayerId(P)])!='H02H'
endfunction
function GilA takes nothing returns nothing
local integer ip=GetPlayerId(GetTriggerPlayer())
local integer id=GetHandleId(Hero[ip])
call DestroyEffect(LoadEffectHandle(HH,id,SH_ss))
set EFF=AddSpecialEffectTarget("GilAura.mdx",Hero[ip],"origin")
call SaveEffectHandle(HH,id,SH_ss,EFF)
call DestroyEffect(LoadEffectHandle(HH,id,SH_ss2))
call UnitRemoveAbility(Hero[ip],'A1AU')
call UnitRemoveAbility(Hero[ip],'A2AU')
call UnitRemoveAbility(Hero[ip],'A3AU')
endfunction
