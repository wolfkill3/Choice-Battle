call UnitApplyTimedLife(CreateUnit(p,'e0TA',x,y,(a*bj_RADTODEG)),'BTLF',3)
endif
call UnitApplyTimedLife(CreateUnit(p,'e0C7',x,y,(a*bj_RADTODEG)),'BTLF',6)
call ShakeCamera(0.5,20)
set n=CreateUnit(p,'e0TD',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',4)
call SetUnitTimeScale(n,0.3)
if GetUnitTypeId(u)=='H14H' then
    call SetUnitVertexColor(n,255,100,100,50)
endif
set n=CreateUnit(p,'e0TD',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',4)
call SetUnitTimeScale(n,0.3)
if GetUnitTypeId(u)=='H14H' then
    call SetUnitVertexColor(n,255,100,100,50)
endif
set n=CreateUnit(p,'e0TD',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',4)
call SetUnitTimeScale(n,0.3)
if GetUnitTypeId(u)=='H14H' then
    call SetUnitVertexColor(n,255,100,100,50)
endif
set n=CreateUnit(p,'e0K9',x,y,GetRandomReal(0,359))
