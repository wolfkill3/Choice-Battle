call SetUnitTimeScale(n,0.5)
set is=is+1
endloop
call SaveReal(h,id,2,2)
call SaveReal(h,id,4,0)
call PauseTimer(t)
call SetUnitTimeScale(u,1)
call TimerStart(t,1.6,false,function StarBastCast7)
