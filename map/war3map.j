call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
set caster=null
set target=null
set Dummy=null
endfunction

function AizenTPassiveAct takes unit caster0,unit target0,unit dummy0 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit caster=caster0
local unit target=target0
local real facing=GetUnitFacing(target)
call SaveReal(HH,id,3,facing)
call SaveUnitHandle(HH,id,1,caster)
call SaveUnitHandle(HH,id,20,dummy0)
call SaveUnitHandle(HH,id,30,caster)
call SetUnitFacing(caster,facing)
call PauseUnit(target,true)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
call SetUnitInvulnerable(target,true)
call SaveUnitHandle(HH,id,2,target)
call MoveUnit(target,caster,-150,GetUnitFacing(target))
call SaveBoolean(HH,GetHandleId(caster),StringHash("AizenTAct"),false)
call SaveReal(HH,id,15,5*GetHeroInt(caster,true))
call TimerStart(t,0.02,true,function AizenT2PassiveAct)
set caster=null
set caster0=null
set target=null
set target0=null
set t=null
endfunction





function AizenT1Act takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
