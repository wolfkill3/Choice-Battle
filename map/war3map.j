local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)>60 then
set x=x+speed*Cos(a)
set y=y+speed*Sin(a)
call SetUnitXY_1(l__d,x,y, false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
set n=CreateUnit(p,'e0BP',x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,0.25)
call SetUnitTimeScale(n,0)
else
call UnitApplyTimedLife(CreateUnit(p,0x6530424A,x,y,a*bj_RADTODEG),1,0.5)
call UnitApplyTimedLife(CreateUnit(p,0x6530424B,x,y,a*bj_RADTODEG),1,1)
call myCustomDamage(u,c,LoadReal(h,id,5),false,false,null,null,null)
call SetControlToUnit(u,c,0.08, "stun")
call FlushChildHashtable(h,id)
call PauseTimer(t)
call DestroyTimer(t)
call KillUnit(l__d)
endif
set p=null
set l__d=null
set c=null
set t=null
set u=null
endfunction
