endloop
call UnitRemoveAbility(u,'A0GN')
call PauseUnit(u,false)
call SetUnitFlyHeight(u,0,0)
call SetUnitTimeScale(u,1)
call UnitRemoveAbility(u, 'cbc3')
call DestroyGroup(g)
