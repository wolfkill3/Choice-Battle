function TWaverCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local integer i=LoadInteger(h,id,3)
local real x=LoadReal(h,id,1)
local real y=LoadReal(h,id,2)
local real a=LoadReal(h,id,4)
local real a2=45*i*bj_DEGTORAD
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,7)
call SaveInteger(h,id,3,i+1)
if i<8 then
set x=x+400*Cos(a+a2)
set y=y+400*Sin(a+a2)
set n=CreateUnit(p,0x656F3832,x,y,GetRandomReal(0,359))
call SetUnitFlyHeight(n,3000,0)
call SetUnitFlyHeight(n,0,7000)
call GroupAddUnit(g,n)
endif
if i==8 then
set n=CreateUnit(p,0x656F3833,x,y,a*bj_RADTODEG)
call SetUnitFlyHeight(n,3000,0)
call SetUnitFlyHeight(n,475,6000)
call GroupAddUnit(g,n)
endif
if i==14 then
set EFF = AddSpecialEffect("az_juli01.mdx",x,y)
call SetSpecialEffectScale(EFF, 2.4)
call RemoveEffect(EFF,0.7,true,CreateTimer())
set EFF=AddSpecialEffect("AZ_DD021.mdx", x, y)
call SetSpecialEffectScale(EFF , 2.2)
call RemoveEffect(EFF,0.7,true,CreateTimer())
endif
if i==16 then
set EFF=AddSpecialEffect("war3mapImported\\blast2.mdx", x, y)
call SetSpecialEffectScale(EFF , 2.8)
call RemoveEffect(EFF,1.5,true,CreateTimer())
call GroupEnumUnitsInRange(G,x,y,600,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,100,false,false,null,null,null)
call SetControlToUnit(E,E, 4, "stun")
call WaverTPoison(u,E)
call UnitAddAbility(E,'WaT1')
call UnitRemoveAbilityTimedPause(E,'WaT1',10)
call UnitAddAbility(E,'WaT2')
call UnitRemoveAbilityTimedPause(E,'WaT2',10)
endif
call GroupRemoveUnit(G,E)
endloop
endif
if i==18 then
call ForGroup(g,function KillGroup)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set t=null
set u=null
endfunction
function TWaverCast takes nothing returns nothing
