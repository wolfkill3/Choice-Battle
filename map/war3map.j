loop
exitwhen is>=13
set n=CreateUnit(p,'e0ZH',x+250*Cos(ig*is),y+250*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,200,255,200,55)
call UnitApplyTimedLife(n,1,0.75)
call SetUnitTimeScale(n,1.5)
