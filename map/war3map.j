        set soundplay=SndN(2888) // Sound\Music\mp3Music\OriT2.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        call ReviveHero(n,x,y,false)
        call SetUnitControlCount(n, 11,0)
        call SetUnitTargetable(n,true)
        call SetUnitState(n,UNIT_STATE_LIFE,1)
        call SetUnitState(n,UNIT_STATE_MANA,1)
        call HealTextTag(u,n,GetUnitState(n,UNIT_STATE_MAX_LIFE)*0.4*myCustomHeal2(n,1),"HealthRes")
        call SetUnitState(n,UNIT_STATE_LIFE,GetUnitState(n,UNIT_STATE_MAX_LIFE)*0.4)
        call HealTextTag(u,n,GetUnitState(n,UNIT_STATE_MAX_MANA)*0.3*myCustomMana2(n,1),"ManaRes")
        call SetUnitState(n,UNIT_STATE_MANA,GetUnitState(n,UNIT_STATE_MAX_MANA)*0.3)
        call RemoveTransformation(n)
        call SaveInteger(HH,GetHandleId(n),SH_VegetaDeath,1)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectCaster.mdl",n,"origin"))
// endif
call KillUnit(LoadUnitHandle(h,GetHandleId(c),1))
call KillUnit(c)
set t=null
set p=null
set u=null
set c=null
endfunction
