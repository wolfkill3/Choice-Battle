call MoveUnit(caster,caster,35,facing)
endif
endif
set caster=null
set casterOriginal=null
endfunction

function AizenFBlockAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit casterOriginal=LoadUnitHandle(HH,id,30)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real distance=LoadReal(HH,id,8)
local real x1=LoadReal(HH,id,11)
local real y1=LoadReal(HH,id,12)
local real damage=LoadReal(HH,id,15)
if IsUnitPaused(caster)==false or time>5 then
set time=time+0.02
call SaveReal(HH,id,5,time)
endif
if time==5 then
//if caster!=casterOriginal then



//call StartAbilityCooldown(GetUnitAbility(casterOriginal, 'ASF1'), 25)






//endif

call StartAbilityCooldown(GetUnitAbility(caster, 'ASF1'), 25)
