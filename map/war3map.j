function ArcueidQMissles2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local unit u=LoadUnitHandle(h,id,11)
local real speed=LoadReal(h,id,1)
local real sm=LoadReal(h,id,9)
local real dmg=LoadReal(h,id,10)
local unit Elocal
local real f=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real a=LoadReal(h,id,5)
local real dist=LoadReal(h,id,7)
local player p=GetOwningPlayer(u)
local group g=CreateGroup()
if dist>speed and UnitIsAlive(l__d)then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
if sm>speed then
call SaveReal(h,id,1,speed+speed*0.05)
endif
call GroupEnumUnitsInRange(g,x,y,115,Base)
loop
set Elocal=FirstOfGroup(g)
exitwhen Elocal==null
if Condition_Base(p,Elocal)then
if GetUnitAbilityLevel(Elocal,'A1FB')==0 then
call myCustomDamage(u,Elocal,dmg,false,false,null,null,null)
call UnitAddAbility(Elocal,'A1FB')
call UnitRemoveAbilityTimed(Elocal,'A1FB',5)
else
if GetUnitAbilityLevel(Elocal,'A1FB')<7 then
call SetUnitAbilityLevel(Elocal,'A1FB',GetUnitAbilityLevel(Elocal,'A1FB')+1)
endif
call myCustomDamage(u,Elocal,dmg*(1-0.10*GetUnitAbilityLevel(Elocal,'A1FB')),false,false,null,null,null)
endif
call KillUnit(l__d)
endif
call GroupRemoveUnit(g,Elocal)
endloop
call SaveReal(h,id,7,dist-speed)
else
call UnitApplyTimedLife(l__d,1,LoadReal(h,id,8))
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call DestroyGroup(g)
endif
set g=null
set u=null
set p=null
set Elocal=null
set l__d=null
set t=null
endfunction
function ArcueidQMissles takes unit l__d,real speed,real a,real dist,real time,real dmg,unit u returns nothing
