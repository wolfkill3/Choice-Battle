function CandelsAttackCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local group g=LoadGroupHandle(h,id,60)
local group gn=LoadGroupHandle(h,id,61)
local integer i=0
local real x=LoadReal(h,id,50)
local real y=LoadReal(h,id,51)
local real x1=0
local real y1=0
local real x2=GetUnitX(u)
local real y2=GetUnitY(u)
local real dist=LoadReal(h,id,5)
local real f=0
local real dmg=11*GetHeroAgi(u,true)
local integer l__idg=GetHandleId(g)
local player p=GetOwningPlayer(u)
call SaveReal(h,id,5,dist+250)
set n=CreateUnit(p,'e0K9',x2,y2,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,0.65,0.65,0.65)
call SetUnitVertexColor(n,0,0,0,100)
set n=CreateUnit(p,'e0K9',x2,y2,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,0,0,0,100)
set n=CreateUnit(p,'e0K9',x2,y2,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitVertexColor(n,0,0,0,100)
set n=CreateUnit(p,'e0K9',x2,y2,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,2,2,2)
call SetUnitVertexColor(n,0,0,0,100)
set n=CreateUnit(p,'e0K9',x2,y2,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,2.5,2.5,2.5)
call SetUnitVertexColor(n,0,0,0,100)
set n=CreateUnit(p,'e0K9',x2,y2,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,3,3,3)
call SetUnitVertexColor(n,0,0,0,100)
set n=CreateUnit(p,'e0K9',x2,y2,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,3.2,3.2,3.2)
call SetUnitVertexColor(n,0,0,0,100)
call GroupEnumUnitsInRange(g,x,y,1000,Base)
loop
set E=FirstOfGroup(g)
exitwhen E==null
set ide=GetHandleId(E)
if Condition_Base(p,E)and E!=LoadUnitHandle(h,l__idg,ide)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E,2,"stun")
set n=CreateUnit(p,'e1V0',RX,RY,0)
call UnitApplyTimedLife(n,'BTLF',5)
call SaveUnitHandle(h,l__idg,ide,E)
endif
call GroupRemoveUnit(g,E)
endloop
if dist>=1000 then
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call DestroyGroup(g)
call DestroyGroup(gn)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
set gn=null
set u=null
set g=null
set t=null
set p=null
endfunction
