function CheckRandMem takes integer value returns boolean
local integer i=0
loop
exitwhen i>=RandMemSize
if value==RandMem[i] then
return false
endif
set i=i+1
endloop
return true
endfunction
function SaveRandMem takes integer value returns boolean
if RandMemSize>RandMemMax then
return false
endif
set RandMem[RandMemSize]=value
set RandMemSize=RandMemSize+1
return true
endfunction
function ClearRandomIntMem takes nothing returns nothing
set RandMemSize=0
endfunction
function GetRandomIntMem takes integer lowBound,integer highBound returns integer
local integer r
local integer simple=0
if highBound<=lowBound or(highBound-lowBound)>RandMemMax then
return highBound
endif
set simple=GetRandomInt(lowBound,highBound)
set r=simple
loop
exitwhen CheckRandMem(r)
if r<highBound and r>=simple then
set r=r+1
elseif r==highBound and simple>lowBound then
set r=simple-1
elseif r>lowBound and r<simple then
set r=r-1
elseif r<=lowBound then
set r=lowBound
exitwhen true
endif
endloop
if SaveRandMem(r)then
return r
else
call ClearRandomIntMem()
call SaveRandMem(r)
return r
endif
endfunction
function KickPlayerTimedAct2 takes nothing returns nothing
local integer id = GetHandleId(GetExpiredTimer())
local integer p = LoadInteger(h, id, SH_PlayerID)
local integer id_player = GetHandleId(Player(p))
local integer i=0
local real waiting_time = LoadReal(h, id_player, SH_WaitingTime)
if waiting_time>0 then
        call SaveReal(h, id_player, SH_WaitingTime, waiting_time-0.5)
        call DisplayTextToPlayer(Player(p),0,0, "Tick-tack: "+R2S(waiting_time))
        call DisplayTextToPlayer(LoadPlayerHandle(h, id, SH_TriggerPlayer),0,0, "Tick-tack: "+R2S(waiting_time))
else
        if waiting_time<=0.0 or waiting_time>=-1.0 then
                call CustomDefeatBJ(Player(p),Lng("Ты провинился","You are guilty"))
        else
                call DisplayTextToPlayer(Player(p),0,0, "KPT is Disabled")
                call DisplayTextToPlayer(LoadPlayerHandle(h, id, SH_TriggerPlayer),0,0, "KPT is Disabled")
        endif
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
endif
endfunction
function ShowUnitAbilityTimed2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local integer abid=LoadInteger(h,id,1)
    local boolean AState=LoadBoolean(h,id,2)
    if IsUnitHidden(u)==true or IsUnitPaused(u)==true then
        if IsUnitHidden(u)==true then
            call ShowUnit(u,true)
            call ShowUnitAbility(u, abid, AState)
            call ShowUnit(u,false)
        endif
        if IsUnitPaused(u)==true then
            call PauseUnit(u,false)
            call ShowUnitAbility(u, abid, AState)
            call PauseUnit(u,true)
        endif
        call FlushChildHashtable(h,id)
        call DestroyTimer(t)
    else
        call ShowUnitAbility(u, abid, AState)
        call FlushChildHashtable(h,id)
        call DestroyTimer(t)
    endif
    set u=null
    set t=null
endfunction
function ShowUnitAbilityTimed takes unit u, integer aid,boolean flag, real time returns nothing
    local timer t=CreateTimer()
    local integer idt=GetHandleId(t)
    call SaveUnitHandle(h,idt,0,u)
    call SaveInteger(h,idt,1,aid)
    call SaveBoolean(h,idt,2,flag)
    call TimerStart(t,time,false,function ShowUnitAbilityTimed2)
    set t=null
endfunction
function ShowAbility2Timed2 takes nothing returns nothing
    local integer i
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    set i=0
    loop
        call SetPlayerAbilityAvailable(Player(i), LoadInteger(HH,id,1), LoadBoolean(HH,id,2))
        set i = i + 1
        exitwhen i>=11
    endloop
    call FlushChildHashtable(HH,id)
    call DestroyTimer(t)
    set t=null
endfunction
function ShowAbility2Timed takes integer aid,boolean flag, real time returns nothing
    local timer t=CreateTimer()
    local integer idt=GetHandleId(t)
    call SaveInteger(HH,idt,1,aid)
    call SaveBoolean(HH,idt,2,flag)
    call TimerStart(t,time,false,function ShowAbility2Timed2)
    set t=null
endfunction
