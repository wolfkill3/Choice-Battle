set x1=GetUnitX(n)
set y1=GetUnitY(n)
call ChariotMissleFly(n,25,0,x1+(sr+100)*Cos(a),y1+(sr+100)*Sin(a),1640,dmg)
set n=CreateUnit(p,0x65304251,x+350*Cos(a3),y+350*Sin(a3),a2)
call UnitApplyTimedLife(n,1,2)
call SetUnitFlyHeight(n,1880,0)
set n=CreateUnit(p,0x65304245,x+350*Cos(a3),y+350*Sin(a3),a2)
