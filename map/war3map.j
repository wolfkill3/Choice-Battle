    local integer id_caster= GetHandleId(LoadUnitHandle(h, id, c_CASTER))
    local boolean RengokuF_Pass_bool= LoadBoolean(HH, id_caster, RengokuF_Pass)
    if GetUnitAbilityLevel(LoadUnitHandle(h, id, c_CASTER), 'ReFP') >= 1 and RengokuF_Pass_bool == false and udg_B then
    
    
    else
        if GetUnitAbilityLevel(LoadUnitHandle(h, id, c_CASTER), 'ReFP') >= 1 then
            call UnitRemoveAbility(LoadUnitHandle(h, id, c_CASTER), 'ReFP')
        endif
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
        
    endif
endfunction

