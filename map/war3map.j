local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local real a=LoadReal(h,id,4)
local real time=LoadReal(h,id,5)+0.15
local real time2=LoadReal(h,id,6)
local real ang=150*bj_DEGTORAD
local player p=GetOwningPlayer(u)
local real dmg=GetHeroAgi(u,true)*0.6
if time2<0.5 then
call SaveReal(h,id,6,time2+0.15)
if time2==0.45 then
set n=CreateUnit(p,'e0V2',x+25*Cos(a),y+25*Sin(a),a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',4)
set n=CreateUnit(p,'e0V3',x+25*Cos(a+ang),y+25*Sin(a+ang),(a+ang)*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',4)
set n=CreateUnit(p,'e0V3',x+25*Cos(a-ang),y+25*Sin(a-ang),(a-ang)*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',4)
set soundplay=SndN(826) // Sound\Music\mp3Music\TsunaT.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
else
if time<=4 then
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,255,230,100,50)
set n=CreateUnit(p,'e0RE',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitVertexColor(n,255,230,100,50)
call SetUnitScale(n,1,1,1)
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitVertexColor(n,255,230,100,50)
set n=CreateUnit(p,'e0RE',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitVertexColor(n,255,230,100,50)
call SetUnitScale(n,1.5,1.5,1.5)
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,2,2,2)
call SetUnitVertexColor(n,255,230,100,50)
set n=CreateUnit(p,'e0RE',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitVertexColor(n,255,230,100,50)
call SetUnitScale(n,2,2,2)
set n=CreateUnit(p,'e0V4',x+30*Cos(a),y+30*Sin(a),a*bj_RADTODEG)
call UnitApplyTimedLife(n,'BTLF',0.3)
call SetUnitTimeScale(n,2)
call DestroyEffect(AddSpecialEffect("war3mapImported\\LW10.mdl",x1,y1))
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SaveReal(h,id,5,time)
call GroupEnumUnitsInRange(G,x1,y1,450,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 1, "stun")
endif
call GroupRemoveUnit(G,E)
endloop
else
call SetUnitFlyHeight(u,0,400)
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
endif
set p=null
set u=null
set t=null
endfunction
function XXBurnerCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local player p=GetOwningPlayer(u)
local real a=Atan2(y1-y,x1-x)
call SaveUnitHandle(h,id,0,u)
set x=x1-400*Cos(a)
set y=y1-400*Sin(a)
call SetUnitXY_1(u,x,y, false)
call SaveReal(h,id,2,x+400*Cos(a))
call SaveReal(h,id,3,y+400*Sin(a))
call SaveReal(h,id,4,a)
call SaveReal(h,id,5,0)
call UnitAddAbility(u,'Arav')
call UnitRemoveAbility(u,'Arav')
call SetUnitInvulnerable(u,true)
call PauseUnit(u,true)
call SetUnitFlyHeight(u,250,400)
set n=CreateUnit(p,'e06G',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',5)
call SetUnitTimeScale(n,0.1)
set n=CreateUnit(p,'e0DP',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',5)
call SetUnitTimeScale(n,0.1)
set n=CreateUnit(p,'e0DQ',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',5)
call SetUnitTimeScale(n,0.1)
set n=CreateUnit(p,'e0DO',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',5)
call SetUnitTimeScale(n,2)
call UnitAddAbility(n,'A0KM')
call UnitAddAbility(n,'A0KN')
call TimerStart(t,0.15,true,function XXBurnerCast2)
set u=null
set p=null
set t=null
endfunction
