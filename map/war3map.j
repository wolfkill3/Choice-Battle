function PlasmaOrbCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,3)
local group g=LoadGroupHandle(h,id,22)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,8)
local real y1=LoadReal(h,id,9)
local real time=LoadReal(h,id,10)
local real a=Atan2(y1-y,x1-x)
local real dmg=LoadReal(h,id,6)+(0.8+0.2*GetUnitAbilityLevel(u,'A0GB'))*GetHeroAgi(u,true)*0.1
local real dmg2=5*GetHeroAgi(u,true)
local real l__s=LoadReal(h,id,7)+0.06
local player p=GetOwningPlayer(u)
local integer l__idg=GetHandleId(g)
local integer l__ide
if time<2.5 then
call SaveReal(h,id,10,time+0.05)
call SetUnitScale(l__d,l__s,l__s,l__s)
call SaveReal(h,id,6,dmg)
call SaveReal(h,id,7,l__s)
call GroupEnumUnitsInRange(g,x,y,450,Base)
loop
set E=FirstOfGroup(g)
set l__ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E)then
if E!=LoadUnitHandle(h,l__idg,l__ide)then
call myCustomDamage(u,E,dmg2,false,false,null,null,null)
call SaveUnitHandle(h,l__idg,l__ide,E)
endif
call Push(E,50,Atan2(GetUnitY(E)-y,GetUnitX(E)-x),300)
endif
call GroupRemoveUnit(g,E)
endloop
call UnitApplyTimedLife(CreateUnit(p,0x65305046,x,y,GetRandomReal(0,359)),'BTLF',0.5)
call UnitApplyTimedLife(CreateUnit(p,0x65305045,x,y,GetRandomReal(0,359)),'BTLF',0.5)
else
call MissleMovePlasmaOrb(u,x1,y1,l__d,40,0,dmg)
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
call PauseTimer(t)
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
endif
set g=null
set l__d=null
set u=null
set p=null
set t=null
endfunction
