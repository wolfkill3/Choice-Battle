function KiyoRage2 takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local real time=LoadReal(h,id,3)
    if time>0 and GetWidgetLife(LoadUnitHandle(h,id,4))>0 and GetUnitAbilityLevel(LoadUnitHandle(h,id,4),'A224')>0 and udg_B==true and DU2==true then
                call SaveReal(h,id,3,time-0.01)
    else
                call UnitRemoveAbility(LoadUnitHandle(h,id,4),'A224')
                call FlushChildHashtable(h,id)
                call DestroyTimer(GetExpiredTimer())
    endif
endfunction
function KiyoRage takes unit c,real per returns nothing
    local integer id=0
        set sysTimer=CreateTimer()
        set id=GetHandleId(sysTimer)
    call SaveUnitHandle(h,id,4,c)
    call UnitAddAbility(c,'A224')
    call SaveReal(h,id,3,per)
    call TimerStart(sysTimer,0.01,true,function KiyoRage2)
    set sysTimer=null
endfunction
function Essence2 takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local unit c=LoadUnitHandle(h,id,4)
    local real time=LoadReal(h,id,3)
    local real dmg=0
    if time>0 and GetWidgetLife(c)>0 and udg_B==true and DU2==true and LoadInteger(HH,GetHandleId(c),StringHash("cold"))!=1 then
                if IsUnitPaused(c)==false and IsUnitHidden(c)==false and GetUnitAbilityLevel(c,'Pet1')==0 then
        call SaveReal(h,id,3,time-0.01)
        endif
                call UnitAddAbility(c,'A214')
                if GetWidgetLife(c)>LoadReal(h,id,0) then
                        set dmg=GetWidgetLife(c)-LoadReal(h,id,0)
                        if dmg<GetWidgetLife(c) then
                                call SetUnitState(c,UNIT_STATE_LIFE,GetWidgetLife(c)-dmg)
                        else
                                call SetUnitState(c,UNIT_STATE_LIFE,50)
                        endif
                endif
                call SaveReal(h,id,0,GetWidgetLife(c))
    else
                call UnitRemoveAbility(c,'A214')
                call SaveInteger(HH,GetHandleId(c),StringHash("cold"),0)
                call FlushChildHashtable(h,id)
                call DestroyTimer(GetExpiredTimer())
    endif
    set c=null
endfunction
function Essence takes unit u,unit c,real per returns nothing
    local integer id=0
        set sysTimer=CreateTimer()
        set id=GetHandleId(sysTimer)
    call SaveUnitHandle(h,id,1,u)
    call SaveInteger(HH,GetHandleId(c),StringHash("cold"),0)
    call SaveUnitHandle(h,id,4,c)
    call SaveReal(h,id,0,GetWidgetLife(c))
    call UnitAddAbility(c,'A214')
    call UnitMakeAbilityPermanent(c,true,'A214')
    call SaveReal(h,id,3,per)
    call TimerStart(sysTimer,0.01,true,function Essence2)
    set sysTimer=null
endfunction

//==   Reducing the effectiveness of healing
function ReduceHeal2 takes nothing returns nothing
    local integer id=GetHandleId(GetExpiredTimer())
    local real time=LoadReal(h,id,3)
    local real dmg=0
    local unit target=LoadUnitHandle(h,id,4)
    if time>0 and GetWidgetLife(target)>0 and udg_B==true and DU2==true then
                call SaveReal(h,id,3,time-0.01)
                if GetWidgetLife(target)>LoadReal(h,id,0) then
                        set dmg=GetWidgetLife(target)-LoadReal(h,id,0)
                        call SetWidgetLife(target, GetWidgetLife(target)-dmg*LoadReal(h,id,5))
                endif
                call SaveReal(h,id,0,GetWidgetLife(target))
    else
                call SaveInteger(HH,GetHandleId(LoadUnitHandle(h,id,4)),StringHash("cold"),0)
                call SaveReal(HH,GetHandleId(target),MinusHealHash,LoadReal(HH,GetHandleId(target),MinusHealHash)/(1-LoadReal(h,id,5)))
                call FlushChildHashtable(h,id)
                call DestroyTimer(GetExpiredTimer())
    endif
        set target=null
endfunction
function ReduceHeal takes unit u,unit c, real effectiveness, real per returns nothing
    local integer id=0
    set sysTimer=CreateTimer()
    set id=GetHandleId(sysTimer)
    call SaveUnitHandle(h,id,1,u)
    call SaveUnitHandle(h,id,4,c)
    call SaveReal(h,id,5,effectiveness)
    call SaveReal(h,id,0,GetWidgetLife(c))
    call SaveReal(h,id,3,per)
    if LoadReal(HH,GetHandleId(c),MinusHealHash)==0 then
        call SaveReal(HH,GetHandleId(c),MinusHealHash,1)
    endif
    call SaveReal(HH,GetHandleId(c),MinusHealHash,LoadReal(HH,GetHandleId(c),MinusHealHash)*(1-effectiveness))
    call TimerStart(sysTimer,0.01,true,function ReduceHeal2)
    set sysTimer=null
endfunction

function GlobalReduceHeal2 takes nothing returns nothing
    local integer id=0
        local integer i=0
        local real dmg=0.0
        if HealRes!=0 then
                if udg_B and DU2==true then
                
                        loop
                        exitwhen i>=10
                        
                                set id=GetHandleId(GetOwningPlayer(Hero[i]))
                                
                                if UnitIsAlive(Hero[i]) and Hero[i]!=null then
                                
                                        if GetWidgetLife(Hero[i])>LoadReal(HH,id,GLOBAL_RH_HP) then
                                        
                                                set dmg=GetWidgetLife(Hero[i])-LoadReal(HH, id, GLOBAL_RH_HP)
                                                call SetWidgetLife(Hero[i], GetWidgetLife(Hero[i])-dmg*(-1*HealRes*0.01))
                                                
                                        endif
                                        
                                        call SaveReal(HH,id,GLOBAL_RH_HP,GetWidgetLife(Hero[i]))
                                        
                                elseif Hero[i]!=null then
                                
                                        call SaveReal(HH, id, GLOBAL_RH_HP, GetWidgetMaxLife(Hero[i]))
                                        
                                endif
                                
                        set i=i+1
                        endloop
                        
                else
                        call PauseTimer(GetExpiredTimer())
                        call DestroyTimer(GetExpiredTimer())
                endif
        endif
endfunction

function GlobalReduceHeal takes nothing returns nothing
    local integer id=0
        local integer i=0
        loop
        exitwhen i>=10
                set id=GetHandleId(Player(i))
                call SaveReal(HH, id, GLOBAL_RH_HP, 10000)
        set i=i+1
        endloop
        set sysTimer=CreateTimer()
        set id=GetHandleId(sysTimer)
    call TimerStart(sysTimer,0.01,true,function GlobalReduceHeal2)
    set sysTimer=null
endfunction

function HY_ReduceHeal_Periodic takes nothing returns nothing
        local integer id=GetHandleId(GetExpiredTimer())
        local unit target=LoadUnitHandle(h, id, 1)
        local integer lvl=GetUnitAbilityLevel(target, 'IHYs')
        local real time=LoadReal(HH, GetHandleId(target), HYUKIRIN_CONDITION)
        local real antiheal=0.0
        
        if IsUnitPaused(target)==false then
                call SaveReal(HH, GetHandleId(target), HYUKIRIN_CONDITION, time-0.01)
        endif
        
        if lvl>0 and time>0 and DU2==true then
                if GetWidgetLife(target)>LoadReal(h,id,2) then
                        set antiheal=(GetWidgetLife(target)-LoadReal(h,id,2)) * (I2R(lvl)*0.25)
                        call SetWidgetLife(target, GetWidgetLife(target)-antiheal)
                endif
                call SaveReal(h, id, 2, GetWidgetLife(target))
                if lvl==3 then
                        call SetWidgetLife(LoadUnitHandle(h,id,0), GetWidgetLife(LoadUnitHandle(h,id,0))+antiheal*0.5)
                        call HealTextTag(LoadUnitHandle(h,id,0),LoadUnitHandle(h,id,0),antiheal*0.5*myCustomHeal2(LoadUnitHandle(h,id,0),1),"HealthRes")
                endif
        else
                call UnitRemoveAbility(target, 'IHYs')
                call UnitRemoveAbility(target, 'IHYb')
                call RemoveSavedReal(HH, GetHandleId(target), HYUKIRIN_CONDITION)
                call FlushChildHashtable(h, id)
                call PauseTimer(GetExpiredTimer())
                call DestroyTimer(GetExpiredTimer())
        endif
        set target=null
endfunction

function HourglassYukirin_ReduceHeal takes unit newCaster, unit newTarget returns nothing
        local timer newTimer=null
        local integer id    = 0
        local integer get_stack = GetUnitAbilityLevel(newTarget, 'IHYs')
        local integer lvl       = get_stack+1
        //call DisplayTimedTextToPlayer(Player(0),0,0,3, I2S(get_stack))
        
                
        if GetUnitAbilityLevel(newTarget, 'IHYp')==0 then
                call UnitAddAbility(newTarget, 'IHYp')
                call UnitMakeAbilityPermanent(newTarget, true, 'IHYp')
                call UnitRemoveAbilityTimed_ExD(newTarget, 'IHYp', 0.5)
        
                if get_stack==0 then
                        call DestroyEffect(AddSpecialEffectTarget("moon_texiao_yanxindaji_01b.mdl", newTarget, "chest"))
                        set newTimer=CreateTimer()
                        set id=GetHandleId(newTimer)
                        call UnitAddAbility(newTarget, 'IHYs')
                        call UnitMakeAbilityPermanent(newTarget, true, 'IHYs')
                        call SaveUnitHandle(h, id, 0, newCaster)
                        call SaveUnitHandle(h, id, 1, newTarget)
                        call SaveReal      (h, id, 2, GetWidgetLife(newTarget))
                        call TimerStart(newTimer, 0.01, true, function HY_ReduceHeal_Periodic)
                endif
                
                if get_stack==2 then            // Эффект 3 стаков
                        set n=CreateUnit(GetOwningPlayer(newCaster), 'dM75', GetUnitX(newTarget), GetUnitY(newTarget), GetRandomInt(0, 360))
                        call MyRemoveUnit(n, 1.5)
                endif
                
        else
                set lvl=get_stack
        endif
        
        if lvl>=3 then
                set lvl=3
        else
                call UnitRemoveAbility(newTarget, 'IHYb')
        endif
        
        call SaveReal(HH, GetHandleId(newTarget), HYUKIRIN_CONDITION, 5.0)
        call SetUnitAbilityLevel(newTarget,'IHYs', lvl)
        
        set newTimer=null
endfunction


function OS_ReduceHeal_Periodic takes nothing returns nothing
        local integer id=GetHandleId(GetExpiredTimer())
        local unit target=LoadUnitHandle(h, id, 1)
        local integer lvl=GetUnitAbilityLevel(target, 'IOb3')
        local real time=LoadReal(HH, GetHandleId(target), ONIZUKASET_CONDITION)
        local real antiheal=0.0
        
        if IsUnitPaused(target)==false then
                call SaveReal(HH, GetHandleId(target), ONIZUKASET_CONDITION, time-0.01)
        endif
        
        if lvl>0 and time>0 and DU2==true then
                if GetWidgetLife(target)>LoadReal(h,id,2) then
                        set antiheal=(GetWidgetLife(target)-LoadReal(h,id,2)) * (I2R(lvl)*0.25)
                        call SetWidgetLife(target, GetWidgetLife(target)-antiheal)
                endif
                call SaveReal(h, id, 2, GetWidgetLife(target))
        else
                call SaveReal(HH,GetHandleId(target),MinusHealHash,LoadReal(HH,GetHandleId(target),MinusHealHash)/0.75)
