//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set damage=(1+GetUnitAbilityLevel(casterOriginal,'ASW1'))*GetHeroInt(caster,true)
if caster!=casterOriginal then
set damage=damage*0.8


//call StartAbilityCooldown(GetUnitAbility(casterOriginal, 'ASW1'), 20 )



endif
call SaveReal(HH,id,15,damage)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',x1,y1,facing+180)
call SetUnitModel(n0,"Aizen\\byakuya-17.mdl")
call UnitSize(n0,0.5,1,1)
call UnitSpeed(n0,1.75)
call UnitColor(n0,100,100,100,0)
call SetUnitFlyHeight(n0,100,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=null
call TimerStart(t,0.02,true,function AizenWAct)
endif

if GetSpellAbilityId()=='ASW2' or GetSpellAbilityId()=='ASW3' then
set damage=2*GetHeroInt(caster,true)
if caster!=casterOriginal then
set damage=damage*0.8
endif
call SaveReal(HH,id,15,damage)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',x0,y0,facing)
call MoveUnit(n0,n0,100,facing)

if GetSpellAbilityId()=='ASW2' then
set soundplay=SndN(3985) // Sound\Music\mp3Music\AizenW2.mp3
call SetUnitModel(n0,"Aizen\\xtyBall.mdl")
call UnitSize(n0,0.5,1,1)
call SaveBoolean(HH,id,16,true)
else
set soundplay=SndN(3987) // Sound\Music\mp3Music\AizenW2-3.mp3
call SetUnitModel(n0,"Aizen\\[A]AZ_chongci-blue.mdl")
call UnitSize(n0,1,1,1)
call SaveBoolean(HH,id,16,false)
endif

call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call UnitSpeed(n0,1.75)
call UnitColor(n0,100,100,100,0)
call SetUnitFlyHeight(n0,100,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=null
call TimerStart(t,0.02,true,function AizenW2Act)
endif
///AizenW End



//AizenE start
if GetSpellAbilityId()=='ASE1' then
if caster!=casterOriginal then



//call StartAbilityCooldown(GetUnitAbility(casterOriginal, 'ASE1'), 30-GetUnitAbilityLevel(casterOriginal,'ASE1')*2 )


endif
call PauseUnit(caster,true)
//call SaveInteger(HH,id,16,GetRandomInt(1,2))
call TimerStart(t,0.02,true,function AizenEAct)
endif

if GetSpellAbilityId()=='ASE2' then
set damage=50+GetHeroInt(caster,true)*(3+GetUnitAbilityLevel(casterOriginal,'ASE1'))
if caster!=casterOriginal then
set damage=damage*0.8
endif
call SaveReal(HH,id,15,damage)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call SaveUnitHandle(HH,id,2,target)
call TimerStart(t,0.02,true,function AizenE2Act)
endif

//AizenE end


//AizenR start
if GetSpellAbilityId()=='ASR1' then
if target==caster then



if LoadReal(HH, GetHandleId(GetOwningPlayer(casterOriginal)) , TD_INDICATOR)>100000 then
call SaveBoolean(HH,id,16,true)

if(GetLocalPlayer()==GetOwningPlayer(caster))then
    call DisplayTextToPlayer(GetLocalPlayer(),0,0,"R Up")
endif

endif


call SaveReal(HH,id,15,(3+GetUnitAbilityLevel(casterOriginal,'ASR1'))*GetHeroInt(casterOriginal,true))
call SetUnitState(caster,UNIT_STATE_MANA,GetUnitState(caster,UNIT_STATE_MANA)-GetUnitState(caster,UNIT_STATE_MAX_MANA)*0.2)
call TimerStart(t,0.02,true,function AizenRChargeAct)
else
call PauseUnit(caster,true)
set damage=(3+GetUnitAbilityLevel(casterOriginal,'ASR1'))*GetHeroInt(caster,true)

if caster!=casterOriginal then
set damage=damage*0.8

//call StartAbilityCooldown(GetUnitAbility(casterOriginal, 'ASR1'), 25 )
//call StartAbilityCooldown(GetUnitAbility(aizen, 'ASR1'), 25 )


endif

//call StartAbilityCooldown(GetUnitAbility(Hero[GetPlayerId(GetOwningPlayer(caster))], 'ASR1'), 25 )

call SaveReal(HH,id,15,damage)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',x1,y1,facing)
call SetUnitModel(n0,"Aizen\\aizen-5.mdl")
call SetUnitAnimationByIndex(n0,1)
call UnitSize(n0,1.5,1,1)
call UnitSpeed(n0,1.5)
call UnitColor(n0,100,100,100,0)
call SetUnitFlyHeight(n0,100,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=null
call TimerStart(t,0.02,true,function AizenRAct)
endif

endif


if GetSpellAbilityId()=='ASR2' then
call PauseUnit(caster,true)
call SaveReal(HH,id,17,LoadReal(HH,GetHandleId(casterOriginal),SH_AizenR))
set damage=(LoadReal(HH,id,17)*0.3+3+GetUnitAbilityLevel(casterOriginal,'ASR1'))*GetHeroInt(caster,true)+LoadReal(HH,id,17)*75

if caster!=casterOriginal then
set damage=damage*0.8
endif

if GetUnitAbilityLevel(caster,'ASR2')==5 then

call SaveBoolean(HH,id,35,false)

else

call SaveBoolean(HH,id,35,true)


endif


call SaveReal(HH,id,15,damage)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',x1,y1,facing)
call SetUnitModel(n0,"Aizen\\aizen-5.mdl")
call SetUnitAnimationByIndex(n0,1)
call UnitSize(n0,1.5+LoadReal(HH,id,17)*0.2,1,1)
call UnitSpeed(n0,1.75)
call UnitColor(n0,100,100,100,0)
call SetUnitFlyHeight(n0,100,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=null

call SetUnitState(caster,UNIT_STATE_MANA,GetUnitState(caster,UNIT_STATE_MANA)-GetUnitState(caster,UNIT_STATE_MAX_MANA)*0.2)

call TimerStart(t,0.02,true,function AizenRChargeExpAct)
endif
//AizenR end


//AizenT start
if GetSpellAbilityId()=='AST1' then
if GetUnitTypeId(caster)=='H02M' then
set n0=CreateUnit(GetOwningPlayer(caster),'HASC',GetUnitX(caster),GetUnitY(caster),facing)
elseif GetUnitTypeId(caster)=='H12M' then
set n0=CreateUnit(GetOwningPlayer(caster),'HAST',GetUnitX(caster),GetUnitY(caster),facing)
endif
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call SaveUnitHandle(HH,id,20,n0)
//call SetUnitState(n0,UNIT_STATE_LIFE,1)
call UnitInventorySetSize(n0,10)
call SaveUnitHandle(HH,GetHandleId(caster),SH_AizenTU,n0)
call SaveBoolean(HH,GetHandleId(caster),SH_AizenTAct,true)
call IssuePointOrder(n0,"attack",x1,y1)



call SaveUnitHandle(HH,id,21,CreateUnit(GetOwningPlayer(caster),'e203',GetUnitX(caster),GetUnitY(caster),facing))
call CreateModeIndicatorWithPauseAizen(n0 ,caster, "ReplaceableTextures\\CommandButtons\\BTNAizenT.blp", 10)
call TimerStart(t,0.02,true,function AizenT1Act)
call CloneAddCDAizen(caster,n0)
set n0=null
endif



if GetSpellAbilityId()=='AST2' then
call SaveReal(HH,GetHandleId(caster),SH_AizenTR,0)
call SaveUnitHandle(HH,id,1,casterOriginal)
call PauseUnit(casterOriginal,true)
call SetUnitInvulnerable(casterOriginal,true)

if target==caster then
call SaveBoolean(HH,GetHandleId(casterOriginal),SH_AizenTAct,false)
set damage=7*GetHeroInt(caster,true)
call PauseUnit(target,true)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
call SetUnitInvulnerable(target,true)
call SaveReal(HH,id,15,damage)
call SetUnitAnimationByIndex(casterOriginal,13)
call MoveUnit(caster,casterOriginal,-150,GetUnitFacing(caster))
call SetUnitFacingInstant(casterOriginal,GetUnitFacing(caster))
call TimerStart(t,0.02,true,function AizenT2AoeAct)
else
call SaveUnitHandle(HH,id,31,caster)
set damage=9*GetHeroInt(caster,true)
call SaveUnitHandle(HH,id,2,target)
call SaveReal(HH,id,15,damage)
call TimerStart(t,0.02,true,function AizenT2Act)
endif

endif

//AizenT end


set t=null
set caster=null
set target=null
set casterOriginal=null
endfunction

function AizenChoice_Cond takes nothing returns boolean
if GetSpellAbilityId()=='ASQ1' or GetSpellAbilityId()=='ASQ2' or GetSpellAbilityId()=='ASW1' or GetSpellAbilityId()=='ASW2' or GetSpellAbilityId()=='ASW3' or GetSpellAbilityId()=='ASE1' or GetSpellAbilityId()=='ASE2' or GetSpellAbilityId()=='ASR1' or GetSpellAbilityId()=='ASR2' or GetSpellAbilityId()=='AST1' or GetSpellAbilityId()=='AST2' or GetSpellAbilityId()=='ASF1' or GetSpellAbilityId()=='ASG1' then
return true
else
return false
endif
endfunction


function InitTrig_AizenChoice takes nothing returns nothing
local trigger AizenChoice=CreateTrigger()
local integer index
set index=0
loop
call TriggerRegisterPlayerUnitEvent(AizenChoice,Player(index),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set index=index+1
exitwhen index==bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddCondition(AizenChoice,Condition(function AizenChoice_Cond))
call TriggerAddAction(AizenChoice,function AizenChoice_Act)
set AizenChoice=null
endfunction




