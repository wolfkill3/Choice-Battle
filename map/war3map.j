call SetUnitFlyHeight(LoadUnitHandle(HH,id,22),GetUnitFlyHeight(target)+100,0)
call SetUnitFlyHeight(LoadUnitHandle(HH,id,25),GetUnitFlyHeight(target)+100,0)
