local real y2=LoadReal(h,id,3)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real a=Atan2(y2-y1,x2-x1)
local real a2
local player p=GetOwningPlayer(u)
local real dmg=(GetHeroAgi(u,true)+50)*(GetUnitAbilityLevel(u,'A06A'))+100
if SR(x1,y1,x2,y2)>38.00 then
set x1=x1+62*Cos(a)
set y1=y1+62*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
call UnitApplyTimedLife(CreateUnit(p,'e0D0',x1,y1,a*bj_RADTODEG),'BTLF',1)
else
call UnitApplyTimedLife(CreateUnit(p,'e0CW',x1,y1,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0CV',x1,y1,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0CX',x1,y1,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0CY',x1,y1,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0CZ',x1,y1,0),'BTLF',3)
set n=CreateUnit(p,'e0D1',x1,y1,0)
call UnitApplyTimedLife(n,'BTLF',2)
call UnitScale(n,1,8,0.25)
call GroupEnumUnitsInRange(G,x1,y1,400,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call Push(E,50,Atan2(GetUnitY(E)-y2,GetUnitX(E)-x2),500)
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 2, "stun")
endif
call GroupRemoveUnit(G,E)
endloop
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
call RemoveUnit(l__d)
endif
set l__d=null
set p=null
set u=null
set t=null
endfunction
function RollExplCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,GetSpellTargetX())
call SaveReal(h,id,3,GetSpellTargetY())
set n=CreateUnit(GetOwningPlayer(u),'e0CU',GetUnitX(u),GetUnitY(u),GetUnitFacing(u))
call SetUnitAnimation(n,"attack")
call SetUnitTimeScale(n,0.5)
call SaveUnitHandle(h,id,1,n)
set soundplay=SndN(922) // Sound\Music\mp3Music\HibariQ.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.03,true,function RollExplCast2)
set u=null
set t=null
endfunction
