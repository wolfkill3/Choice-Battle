call UnitApplyTimedLife(CreateUnit(p,'e0N0',x,y,0),'BTLF',5)
call UnitApplyTimedLife(CreateUnit(p,'e0N1',x,y,0),'BTLF',5)
call UnitApplyTimedLife(CreateUnit(p,'e0N2',x,y,0),'BTLF',5)
