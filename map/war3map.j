return BaseSkinBuffCond(P)or GetPlayerName(P)=="Annieh" or GetPlayerName(P)=="KamaBr" or GetPlayerName(P)=="[OSV] Kama" or GetPlayerName(P)=="Slaikee" or GetPlayerName(P)=="zld6334" or GetPlayerName(P)=="xxNu-13xx" or GetPlayerName(P)=="Denamesh" or GetPlayerName(P)=="zelim9" or GetPlayerName(P)=="MoonX3" or GetPlayerName(P)=="Kuzeyuta" or GetPlayerName(P)=="Kakaroto228" or GetPlayerName(P)=="[Nirvash][Neo]" or GetPlayerName(P)=="KazuneReyes" or GetPlayerName(P)=="X53Arcan" or GetPlayerName(P)=="terin000" or GetPlayerName(P)=="Motorka3" or GetPlayerName(P)=="Gin_-_Ichimaru" or GetPlayerName(GetTriggerPlayer())=="Lord_Orochimaru" or GetPlayerName(GetTriggerPlayer())=="BERKUNT" or GetPlayerName(P)=="Faimon" or GetPlayerName(P)=="Oma_Kurotsu" or GetPlayerName(P)=="xFyntuk" or GetPlayerName(P)=="Uchiha.sasuke01" or GetPlayerName(P)=="PinkieNecro" or GetPlayerName(P)=="DBFag" or GetPlayerName(P)=="NecromanseR_RuS" or GetPlayerName(P)=="DBFag" or GetPlayerName(P)=="Wolfkill" or GetPlayerName(P)=="Vadik29" or GetPlayerName(P)=="Anwa_Abdul" or GetPlayerName(P)=="antonpoganui" or GetPlayerName(P)=="Wasteriomind" or GetPlayerName(P)=="bkmz008" or GetPlayerName(P)=="ttashhanov1" or GetPlayerName(P)=="Wolkern" or GetPlayerName(P)=="WorldEdit" or GetPlayerName(P)=="PinkieNecro" or GetPlayerName(P)=="DBFag" or GetPlayerName(P)=="NecromanseR_RuS" or GetPlayerName(P)=="DBFag" or GetPlayerName(P)=="Hirako321"and GetUnitTypeId(Hero[GetPlayerId(P)])!='H02H'
