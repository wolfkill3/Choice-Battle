//Kiyohime start
function KiyohimeGAct takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit target=LoadUnitHandle(HH,id,2)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local real x0=GetUnitX(target)
local real y0=GetUnitY(target)
local real damage=LoadReal(HH,id,15)
set time=time+0.02
call SaveReal(HH,id,5,time)

if time==2 then
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
else

if time==1 or time==1.1  or time==1.2 or time==1.3 or time==1.4 or time==1.5 or time==1.6 or time==1.7 or time==1.8 or time==1.9 then
call DamageAoeOneTime0(caster,x0,y0,300,damage*0.1)
call StopAoeOneTime(caster,x0,y0,300)
endif

if time==0.2 then
if LoadBoolean(HH,GetHandleId(target),ANTITARGET_ABILITY)==false then
call EffectCreateAndMove(true,"Others\\BlackBlink1.mdl",facing,1,1,1,100,100,100,0,0,caster,0,facing)
call EffectCreateAndMove(true,"Others\\WindWeak(Thicker).mdl",facing,1,0.5,1,100,100,100,0,0,caster,0,facing)
else
call MoveAoe1(x0,y0,caster,-150,Angle2(GetUnitX(caster),GetUnitY(caster),x0,y0) )
call UnitSpeed(caster,1)
call PauseUnit(target,false)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
call SetUnitInvulnerable(target,false)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
call SaveUnitHandle(HH,GetHandleId(target),REVERSE_TARGET,caster)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
endif

if time>=0.2 and time<1 then
call MoveAoe1(x0,y0,caster,-150,Angle2(GetUnitX(caster),GetUnitY(caster),x0,y0) )
endif

if time==0.24 then
call EffectCreateAndMove(true,"Others\\HakkeStart2.mdl",facing,2,1,0.5,100,100,100,50,0,caster,0,facing)
call EffectCreateAndMove(true,"Others\\file00001412.mdl",facing,1,0.5,1.5,100,100,100,0,0,caster,100,facing)
endif

if time==0.5 then
call SetUnitAnimationByIndex(caster,7)
endif

if time>0.2 and time<1 then
call PauseUnit(target,true)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
call SetUnitInvulnerable(target,true)
call SetUnitPathing(target,false)
endif

if time<1 then
call SetUnitPathing(caster,false)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
endif

if time==1 then
call EffectCreateAndMove(true,"Others\\file00004805.mdl",facing,1,1.75,1.5,100,100,100,0,100,caster,0,facing)
call UnitSpeed(caster,1)
call SetUnitPathing(caster,true)
call SetUnitPathing(target,true)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
call PauseUnit(target,false)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
call SetUnitInvulnerable(target,false)

call DamageAoeAndStun(caster,x0,y0,300,damage,0.5)


if udg_B==true then
call SaveInteger(HH, GetHandleId(caster) ,StringHash("BonusSTR"),LoadInteger(HH, GetHandleId(caster) ,StringHash("BonusSTR"))+2)
call SetHeroStr(caster,GetHeroStr(caster,false)+2,true)
call SaveInteger(HH, GetHandleId(caster) ,StringHash("BonusAGI"),LoadInteger(HH, GetHandleId(caster) ,StringHash("BonusAGI"))+1)
call SetHeroAgi(caster,GetHeroAgi(caster,false)+1,true)
endif



endif



endif

set caster=null
set target=null
endfunction

function KiyohimeGChoice_Act takes nothing returns nothing
local timer t=null
local integer id=0
local unit caster=GetTriggerUnit()
local unit target=null
local real x0=GetUnitX(caster)
local real y0=GetUnitY(caster)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real facing=Angle2(x0,y0,x1,y1)


if GetSpellAbilityId()=='KiyG' then

set t=CreateTimer()
set id=GetHandleId(t)
set target=GetSpellTargetUnit()

call SaveUnitHandle(HH,id,1,caster)
call SaveUnitHandle(HH,id,2,target)
//call SaveReal(HH,id,11,x1)
//call SaveReal(HH,id,12,y1)
call SaveReal(HH,id,3,facing)

set soundplay=CreateSound("Sound\\Music\\mp3Music\\KiyohimeGAttack.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\KiyohimeGAtp.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call SetUnitAnimationByIndex(caster,2)
call UnitSpeed(caster,0.5)
call SaveReal(HH,id,15,2*GetUnitTotalDamage(caster) )
call TimerStart(t,0.02,true,function KiyohimeGAct)
else


endif
if GetSpellAbilityId()=='Ao7D' then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\KiyohimeW.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif

set t=null
set caster=null
set target=null
endfunction

function KiyohimeGChoice_Cond takes nothing returns boolean
if GetSpellAbilityId()=='KiyG' or GetSpellAbilityId()=='Ao7D' then
return true
else
return false
endif
endfunction

