function ElectricVolpiCond takes nothing returns boolean
return GetSpellAbilityId()=='A0GV' or GetSpellAbilityId()=='A41C'
endfunction
function ElectricVolpiCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local unit d1=LoadUnitHandle(h,id,2)
local real m=GetWidgetMana(u)
local real mm=GetUnitState(u,UNIT_STATE_MAX_MANA)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real r
local real f
local real x1
local real y1
local player p=GetOwningPlayer(u)
if GetUnitAbilityLevel(u,'GaT1')>0 and m>mm*0.02 and UnitIsAlive(u) then
        set x1=GetUnitX(l__d)
        set y1=GetUnitY(l__d)
    if RectContainsUnit(gg_rct_UBW2,u)==true then
        call UnitAddAbility(l__d,'A0IH')
    else
        call UnitRemoveAbility(l__d,'A0IH')
    endif
        call UnitApplyTimedLife(CreateUnit(p,0x65304133,x1,y1,GetRandomReal(0,359)),'BTLF',0.5)
        if SR(x,y,x1,y1)<1600 then
                if GetUnitCurrentOrder(l__d)!=OrderId("attack")then
                        set f=GetRandomReal(0,6.3)
                        set r=GetRandomReal(-1500,1500)
                        call IssuePointOrder(l__d,"attack",x+r*Cos(f),y+r*Sin(f))
                endif
        elseif GetUnitCurrentOrder(l__d)!=OrderId("move")then
                set f=GetRandomReal(0,6.3)
                set r=GetRandomReal(-1500,1500)
                call IssuePointOrder(l__d,"move",x+r*Cos(f),y+r*Sin(f))
        endif
        set x1=GetUnitX(d1)
        set y1=GetUnitY(d1)
    if RectContainsUnit(gg_rct_UBW2,u)==true then
        call UnitAddAbility(d1,'A0IH')
    else
        call UnitRemoveAbility(d1,'A0IH')
    endif
        call UnitApplyTimedLife(CreateUnit(p,0x65304133,x1,y1,GetRandomReal(0,359)),'BTLF',0.5)
        if SR(x,y,x1,y1)<1600 then
                if GetUnitCurrentOrder(d1)!=OrderId("attack")then
                        set f=GetRandomReal(0,6.3)
                        set r=GetRandomReal(-1500,1500)
                        call IssuePointOrder(d1,"attack",x+r*Cos(f),y+r*Sin(f))
                endif
        elseif GetUnitCurrentOrder(d1)!=OrderId("move")then
                set f=GetRandomReal(0,6.3)
                set r=GetRandomReal(-1500,1500)
                call IssuePointOrder(d1,"move",x+r*Cos(f),y+r*Sin(f))
        endif
        call SetUnitState(u,UNIT_STATE_MANA,m-mm*0.01*0.06)
else
        call PauseTimer(t)
        call DestroyTimer(t)
    call SaveBoolean(HH,GetHandleId(u),SS,false)
    call SaveBoolean(HH,GetHandleId(u),SST,false)
    call ShowAbility2('A41C',false)
    call ShowAbility2('A0GV',true)
    call UnitRemoveAbility(u,'GaT1')
        call FlushChildHashtable(h,id)
        call RemoveUnit(l__d)
        call RemoveUnit(d1)
endif
set u=null
set l__d=null
set d1=null
set t=null
endfunction
function ElectricVolpiCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
if GetSpellAbilityId()=='A0GV' then
call SaveUnitHandle(h,id,0,u)
call ShowAbility2Timed('A0GV',false,0.3)
call ShowAbility2Timed('A41C',true,0.32)
call UnitAddAbility(u,'GaT1')
call SaveBoolean(HH,GetHandleId(u),SST,true)
if LoadInteger(h,GetHandleId(u),GokuUIMusicHash)==0 then
set soundplay=SndN(1235) // Sound\Music\mp3Music\Gamma_5.mp3
call StartSound(soundplay)
// call KillSoundWhenDone(soundplay)
call SaveInteger(h,GetHandleId(u),GokuUIMusicHash,1)
call RemoveSaveHashTimed(6,GetHandleId(u),GokuUIMusicHash)
endif
else
call SaveBoolean(HH,GetHandleId(u),SST,false)
call ShowAbility2('A41C',false)
call ShowAbility2('A0GV',true)
call UnitRemoveAbility(u,'GaT1')
endif
if LoadBoolean(HH,GetHandleId(u),SS)==false then
    set n=CreateUnit(GetOwningPlayer(u),'h02E',GetUnitX(u),GetUnitY(u),GetUnitFacing(u))
    call SetUnitVertexColor(n,255,255,255,150)
    call SetUnitColor(n,PLAYER_COLOR_AQUA)
    call SaveUnitHandle(h,GetHandleId(u),SH_volpi1,n)
    call SaveUnitHandle(h,id,1,n)
    set n=CreateUnit(GetOwningPlayer(u),'h02E',GetUnitX(u),GetUnitY(u),GetUnitFacing(u))
    call SetUnitVertexColor(n,255,255,255,150)
    call SetUnitColor(n,PLAYER_COLOR_AQUA)
    call SaveUnitHandle(h,id,2,n)
    call SaveUnitHandle(h,GetHandleId(u),SH_volpi2,n)
    call TimerStart(t,0.06,true,function ElectricVolpiCast2)
endif
set u=null
set t=null
endfunction
function ElectricVolpiInit takes nothing returns nothing
endfunction
