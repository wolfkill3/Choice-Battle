function TimeSealCond takes nothing returns boolean
return GetSpellAbilityId()==0x41305442
endfunction
function TimeSealCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real time=LoadReal(h,id,2)
local real x=LoadReal(h,id,5)
local real y=LoadReal(h,id,6)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local boolean yuin=LoadBoolean(h,id,7)
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(p)
if time<4 then
if SR(y1,x1,y,x)<1200 then
call SaveBoolean(h,id,7,true)
set yuin=true
elseif SR(y1,x1,y,x)>=1200 and yuin==true then
call SetUnitInvulnerable(u,false)
call SaveBoolean(h,id,7,false)
set yuin=false
elseif SR(y1,x1,y,x)>=1200 and yuin==false then
call SaveBoolean(h,id,7,false)
set yuin=false
endif
call GroupEnumUnitsInRange(G,x,y,1200,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if E!=u then
call SetControlToUnit(E,E,0.5,"stun")
elseif IsUnitInvulnerable(E)==false and yuin==true then
call SetUnitInvulnerable(E,true)
endif
call GroupRemoveUnit(G,E)
endloop
call SaveReal(h,id,2,time+0.1)
else
call SetUnitInvulnerable(u,false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set t=null
set u=null
endfunction
function TimeSealCast takes nothing returns nothing
local timer t=CreateTimer()
local unit u=GetTriggerUnit()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(p)
local real a=0
local integer i=0
local real x1
local real y1
local real f=(3.6)*bj_DEGTORAD
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,0)
set n=CreateUnit(p,'e06G',x,y,0)
call UnitApplyTimedLife(n,1,7)
call SetUnitTimeScale(n,0.1)
call UnitApplyTimedLife(CreateUnit(p,0x65305233,x,y,0),1,5)
call UnitApplyTimedLife(CreateUnit(p,0x65305233,x,y,0),1,5)
call UnitApplyTimedLife(CreateUnit(p,0x65305235,x,y,0),1,5)
loop
exitwhen i>=100
set x1=x+1100*Cos((i*f))
set y1=y+1100*Sin((i*f))
set a=Atan2(y-y1,x-x1)
call UnitApplyTimedLife(CreateUnit(p,0x65305234,x1,y1,0),1,5)
set i=i+1
endloop
set soundplay=CreateSound("Sound\\Music\\mp3Music\\YujiUltimate.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call UnitAddAbility(u,0x41305854)
call SaveReal(h,id,5,x)
call SaveReal(h,id,6,y)
call SaveBoolean(h,id,7,true)
call TimerStart(t,0.1,true,function TimeSealCast2)
set t=null
set p=null
set u=null
endfunction
