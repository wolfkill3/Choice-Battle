function SabracCloneDie1 takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster0=LoadUnitHandle(HH,id,1)
local real time=LoadReal(HH,id,5)
set time=time+0.02
call SaveReal(HH,id,5,time)
call PauseUnit(caster0,true)
call SetUnitInvulnerable(caster0,true)
call UnitColor(caster0,100,100,100,time*32)
if time==2 then
call UnitAddAbility(caster0,'Aloc')
endif

if time==3 then
call RemoveUnit(caster0)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif


set caster0=null
endfunction

function SabracCloneDie takes unit caster0 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call PauseUnit(caster0,true)
call SetUnitInvulnerable(caster0,true)
call SaveUnitHandle(HH,id,1,caster0)
call TimerStart(t,0.02,true,function SabracCloneDie1)
set caster0=null
set t=null
endfunction


function SabracEPassiveAct1 takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit target=LoadUnitHandle(HH,id,2)
local real time=LoadReal(HH,GetHandleId(target),StringHash("SabracEtime"))
local real HpMax=GetUnitState(target,UNIT_STATE_MAX_LIFE)
local real HpCur=GetUnitState(target,UNIT_STATE_LIFE)
local integer AbilLvl=0
local real time1=LoadReal(HH,id,6)
call MoveUnit(target,LoadUnitHandle(HH,id,20),0,GetUnitFacing(target))
if CheckUnitInvisible(target)==true then
   
   if GetUnitAbilityLevel( LoadUnitHandle(HH,id,20) ,'A0A1')==0 then
      call UnitAddAbility( LoadUnitHandle(HH,id,20) ,'A0A1')
   endif

else

  if GetUnitAbilityLevel( LoadUnitHandle(HH,id,20) ,'A0A1')==1 then
     call UnitRemoveAbility( LoadUnitHandle(HH,id,20) ,'A0A1')
   endif

endif


if GetUnitAbilityLevel(target,'SaP1')>0 then
set AbilLvl=1
endif
if GetUnitAbilityLevel(target,'SaP2')>0 then
set AbilLvl=2
endif
if GetUnitAbilityLevel(target,'SaP3')>0 then
set AbilLvl=3
endif
if GetUnitAbilityLevel(target,'SaP4')>0 then
set AbilLvl=4
endif
if GetUnitAbilityLevel(target,'SaP5')>0 then
set AbilLvl=5
endif
if HpCur>HpMax*(1-0.05*AbilLvl)then
call SetUnitState(target,UNIT_STATE_LIFE,HpMax*(1-0.05*AbilLvl))
endif
if IsUnitPaused(target)==false then
if time1==1 then
set time1=0
//if(GetLocalPlayer()==GetOwningPlayer(caster))then
//call DisplayTextToPlayer(GetLocalPlayer(),0,0,"time left"+I2S(R2I(time)))
//endif
endif
set time1=time1+0.02
call SaveReal(HH,id,6,time1)
set time=time-0.02
call SaveReal(HH,GetHandleId(target),StringHash("SabracEtime"),time)
endif
if   GetUnitAbilityLevel(target,'B05G') > 0 or  time<=0 or UnitIsAlive(target)==false  or udg_B==false or DU2==false then
call RemoveUnit(LoadUnitHandle(HH,id,20))
call UnitRemoveAbility(target,'SaP1')
call UnitRemoveAbility(target,'SaP2')
call UnitRemoveAbility(target,'SaP3')
call UnitRemoveAbility(target,'SaP4')
call UnitRemoveAbility(target,'SaP5')
call UnitRemoveAbility(target,'BSa1')
call UnitRemoveAbility(target,'BSa2')
call UnitRemoveAbility(target,'BSa3')
call UnitRemoveAbility(target,'BSa4')
call UnitRemoveAbility(target,'BSa5')
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
set target=null
set caster=null
endfunction



function SabracEPassiveAct takes unit caster0,unit target0 returns nothing
local timer t=null
local integer id=0
local unit caster=caster0
local unit target=target0
local integer AbilLvl=0

if GetHeroLevel(caster)>=6 then 
call SaveReal(HH,GetHandleId(target),StringHash("SabracEtime"),30)
if GetUnitAbilityLevel(target,'SaP5')>0 then
//if(GetLocalPlayer()==GetOwningPlayer(caster))then
//call DisplayTextToPlayer(GetLocalPlayer(),0,0,"lvl 5")
//endif
endif
if GetUnitAbilityLevel(target,'SaP5')==0 then
call EffectCreateAndMove(true,"Sabrac\\hit-blood-special.mdl",GetUnitFacing(target),1,2,0.8,100,100,100,0,100,target,0,0)
endif
if GetUnitAbilityLevel(target,'SaP4')>0 then
call UnitMakeAbilityPermanent(target,false,'SaP4')
call UnitRemoveAbility(target,'SaP4')
call UnitAddAbility(target,'SaP5')
call UnitMakeAbilityPermanent(target,true,'SaP5')
//if(GetLocalPlayer()==GetOwningPlayer(caster))then
//call DisplayTextToPlayer(GetLocalPlayer(),0,0,"lvl 5")
//endif
call UnitRemoveAbility(target,'BSa4')
endif
if GetUnitAbilityLevel(target,'SaP3')>0 then
call UnitMakeAbilityPermanent(target,false,'SaP3')
call UnitRemoveAbility(target,'SaP3')
call UnitAddAbility(target,'SaP4')
call UnitMakeAbilityPermanent(target,true,'SaP4')
//if(GetLocalPlayer()==GetOwningPlayer(caster))then
//call DisplayTextToPlayer(GetLocalPlayer(),0,0,"lvl 4")
//endif
call UnitRemoveAbility(target,'BSa3')
endif
if GetUnitAbilityLevel(target,'SaP2')>0 then
call UnitMakeAbilityPermanent(target,false,'SaP2')
call UnitRemoveAbility(target,'SaP2')
call UnitAddAbility(target,'SaP3')
call UnitMakeAbilityPermanent(target,true,'SaP3')
//if(GetLocalPlayer()==GetOwningPlayer(caster))then
//call DisplayTextToPlayer(GetLocalPlayer(),0,0,"lvl 3")
//endif
call UnitRemoveAbility(target,'BSa2')
endif
if GetUnitAbilityLevel(target,'SaP1')>0 then
call UnitMakeAbilityPermanent(target,false,'SaP1')
call UnitRemoveAbility(target,'SaP1')
call UnitAddAbility(target,'SaP2')
call UnitMakeAbilityPermanent(target,true,'SaP2')
//if(GetLocalPlayer()==GetOwningPlayer(caster))then
//call DisplayTextToPlayer(GetLocalPlayer(),0,0,"lvl 2")
//endif
call UnitRemoveAbility(target,'BSa1')
endif
if GetUnitAbilityLevel(target,'SaP1')==0 and GetUnitAbilityLevel(target,'SaP2')==0 and GetUnitAbilityLevel(target,'SaP3')==0 and GetUnitAbilityLevel(target,'SaP4')==0 and GetUnitAbilityLevel(target,'SaP5')==0 then
set t=CreateTimer()
set id=GetHandleId(t)
call UnitAddAbility(target,'SaP1')
call UnitMakeAbilityPermanent(target,true,'SaP1')
set n0=CreateUnit(GetOwningPlayer(target),0x65303030,GetUnitX(target),GetUnitY(target),GetUnitFacing(target))
call SetUnitModel(n0,"Sabrac\\az_lumiya_smoke03.mdl")
call UnitSize(n0,2,1,1)
call UnitSpeed(n0,1)
call UnitColor(n0,100,100,100,0)
call SetUnitFlyHeight(n0,0,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=null
call SaveUnitHandle(HH,id,1,caster)
call SaveUnitHandle(HH,id,2,target)
call TimerStart(t,0.02,true,function SabracEPassiveAct1)
endif
if GetUnitAbilityLevel(target,'SaP1')>0 then
set AbilLvl=1
endif
if GetUnitAbilityLevel(target,'SaP2')>0 then
set AbilLvl=2
endif
if GetUnitAbilityLevel(target,'SaP3')>0 then
set AbilLvl=3
endif
if GetUnitAbilityLevel(target,'SaP4')>0 then
set AbilLvl=4
endif
if GetUnitAbilityLevel(target,'SaP5')>0 then
set AbilLvl=5
endif
if GetUnitState(target,UNIT_STATE_LIFE)>GetUnitState(target,UNIT_STATE_MAX_LIFE)*(1-0.05*AbilLvl)then
call SetUnitState(target,UNIT_STATE_LIFE,GetUnitState(target,UNIT_STATE_MAX_LIFE)*(1-0.05*AbilLvl))
endif
set caster=null
set caster0=null
set target=null
set target0=null
set t=null

endif


endfunction


function SabracStackOneTime takes unit damager,real x0,real y0,real range returns nothing
local integer id=GetHandleId(GetExpiredTimer())
call GroupClear(G)
call GroupEnumUnitsInRange(G,x0,y0,range,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
call GroupRemoveUnit(G,n0)
if UnitIsAlive(n0)and IsUnitEnemy(n0,GetOwningPlayer(damager))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(n0,'Avul')==0 then
call SabracEPassiveAct(damager,n0)
endif
endloop
call GroupClear(G)
set damager=null
endfunction
function DamageAoeOneTimeSabracE takes unit damager,real x0,real y0,real range,real damage,group gr1 returns nothing
local integer id=GetHandleId(GetExpiredTimer())
call GroupClear(G)
call GroupEnumUnitsInRange(G,x0,y0,range,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if IsUnitEnemy(n0,GetOwningPlayer(damager))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false and IsUnitInGroup(n0,gr1)==false and GetUnitAbilityLevel(n0,'Avul')==0 then
call GroupAddUnit(gr1,n0)
call myCustomDamage(damager,n0,damage,false,false,null,null,null)
call SabracEPassiveAct(damager,n0)


//call myCustomDamage(damager,n0,damage,false,false,null,null,null)
//call DamageU(false,damager,n0,damage)
endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
call SaveGroupHandle(HH,id,4,gr1)
set damager=null
set gr1=null
endfunction


function SabracT2Act takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit casterOriginal=LoadUnitHandle(HH,id,30)
local unit target=LoadUnitHandle(HH,id,2)
local real facing=LoadReal(HH,id,3)
local real time=LoadReal(HH,id,5)
local unit SabrackFU=LoadUnitHandle(HH,GetHandleId(casterOriginal),StringHash("SabracZoneU"))
local real damage=LoadReal(HH,id,15)
set time=time+0.02
call SaveReal(HH,id,5,time)
if time==0.02 or time==0.2 or time==0.4 then
call EffectCreateAndMove(true,"Sabrac\\[A]az_axe_ef1.mdl",facing,1,1,GetRandomReal(0.4,0.8),100,60,60,40,0,target,0,facing)
endif
if time==0.02 then
call EffectCreateAndMove(true,"Sabrac\\HakkeStart2.mdl",facing,2.5,0.75,0.75,100,100,100,60,0,target,0,facing)
call UnitSpeed(caster,0.5)
if LoadInteger(HH,id,16)==0 then
call SetUnitAnimationByIndex(caster,8)
endif
if LoadInteger(HH,id,16)==1 then
call SetUnitAnimationByIndex(caster,3)
endif
if LoadInteger(HH,id,16)==2 then
call SetUnitAnimationByIndex(caster,4)
endif
endif
if time<0.5 then
call SetUnitPathing(target,false)
call PauseUnit(target,true)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
call SetUnitInvulnerable(target,true)
call MoveUnit(target,caster,-120,facing)
if time>0.1 then
call MoveUnit(caster,LoadUnitHandle(HH,id,20),0,facing)
endif
call SetUnitPathing(caster,false)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
endif
if time==0.5 then
call RemoveUnit(LoadUnitHandle(HH,id,20))
if LoadInteger(HH,id,16)!=0 then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\SabracT22.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
endif
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
call UnitSpeed(caster,1)
call UnitStop(target)
call SetUnitPathing(caster,true)
call PauseUnit(caster,false)
call SetUnitInvulnerable(caster,false)
call UnitSpeed(caster,1)
call SetUnitPathing(target,true)
call PauseUnit(target,false)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
call SetUnitInvulnerable(target,false)
if LoadInteger(HH,id,16)==1 then
call EffectCreateAndMove(true,"Sabrac\\File00003933.mdl",facing,2,1.25,1,100,100,100,0,100,target,0,facing)
call EffectCreateAndMove(true,"Sabrac\\tg_animeslashfinal_2.mdl",facing,2,2,0.8,100,60,60,0,100,target,-150,facing)
endif
if LoadInteger(HH,id,16)==2 then
call EffectCreateAndMove(true,"Sabrac\\File00003933.mdl",facing,2,1.25,1,100,100,100,0,100,target,0,facing)
call EffectCreateAndMove(true,"Sabrac\\tg_animeslashfinal_1.mdl",facing,2,2,0.8,100,60,60,0,100,target,-150,facing)
endif
if LoadInteger(HH,id,16)==0 then
call EffectCreateAndMove(true,"Sabrac\\blood-rou.mdl",facing,2,1,1.5,100,100,100,0,100,target,0,facing)
call EffectCreateAndMove(true,"Sabrac\\LXY_tx-shqy10-E.mdl",facing,2,0.7,1,100,100,100,0,100,target,30,facing+90)
call EffectCreateAndMove(true,"Sabrac\\LXY_tx-shqy10-E.mdl",facing,2,0.7,1,100,100,100,0,100,target,30,facing-90)
call EffectCreateAndMove(true,"Sabrac\\bloodex1.mdl",facing,2,2.25,1.5,100,100,100,0,100,target,0,facing)
endif
call EffectCreateAndMove(true,"Sabrac\\red-lizi-shunjian.mdl",facing,2,2,1,100,100,100,0,100,target,0,facing)
call SabracEPassiveAct(caster,target)
if SabrackFU!=null and SR(GetUnitX(caster),GetUnitY(caster),GetUnitX(SabrackFU),GetUnitY(SabrackFU))<1500 then
set damage=GetHeroStr(casterOriginal,true)*6


call myCustomDamage(casterOriginal,target,damage,false,false,null,null,null)

call SetControlToUnit(caster, target, 2, "stun")


else


call myCustomDamage(casterOriginal,target,damage,false,false,null,null,null)


endif
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
set caster=null
set casterOriginal=null
set target=null
set SabrackFU=null
endfunction






function SabracTPassiveAct takes unit caster0,unit target0 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit caster=caster0
local unit target=target0
local real facing=GetUnitFacing(target)
call SaveReal(HH,id,3,facing)
call SaveUnitHandle(HH,id,1,caster)
call SaveUnitHandle(HH,id,30,caster)
call SetUnitFacing(caster,facing)
call PauseUnit(target,true)
call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,true)
call SetUnitInvulnerable(target,true)
call SaveUnitHandle(HH,id,2,target)
call SaveBoolean(HH,GetHandleId(caster),StringHash("SabracTBool"),false)
set n0=CreateUnit(GetOwningPlayer(caster),0x65303030,GetUnitX(caster),GetUnitY(caster),facing)
call SetUnitModel(n0,"Sabrac\\buffeffectRed.mdl")
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call SaveUnitHandle(HH,id,20,n0)
set n0=null
call SaveInteger(HH,id,16,GetRandomInt(1,2))
call SaveReal(HH,id,15,5*GetHeroStr(caster,true))
call TimerStart(t,0.02,true,function SabracT2Act)
set caster=null
set caster0=null
set target=null
set target0=null
set t=null
endfunction



