call SetUnitScale(n,1.8,1.8,1.8)
call UnitApplyTimedLife(n,'BTLF',0.01)
set n=CreateUnit(p,'e0YK',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,65)
call SetUnitScale(n,2.1,2.1,2.1)
call UnitApplyTimedLife(n,'BTLF',0.01)
call SaveReal(h,id,5,time+0.1)
else
call UnitRemoveAbility(u,0x4131355A)
call SetUnitFlyHeight(u,0,0)
call SetUnitX(u,x1+150*Cos(a))
call SetUnitY(u,y1+150*Sin(a))
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03D',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03D',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03V',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03D',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e06F',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e06F',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e06F',x1,y1,GetRandomReal(0,359)),'BTLF',1)
call SetUnitInvulnerable(u,false)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call PauseUnit(u,false)
call myCustomDamage(u,c,(4+GetUnitAbilityLevel(u,'A0C3'))*GetHeroStr(u,true),false,false,null,null,null)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set t=null
set c=null
set u=null
endfunction
