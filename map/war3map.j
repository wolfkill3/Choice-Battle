function EndGameCond takes nothing returns boolean
set P=GetTriggerPlayer()
return GetPlayerName(GetTriggerPlayer())=="knowyourplace" or GetPlayerName(GetTriggerPlayer())=="WorldEdit" or GetPlayerName(GetTriggerPlayer())==AdminNickname
endfunction
function EndGameAct takes nothing returns nothing
local integer ip=GetPlayerId(GetTriggerPlayer())
local integer id=GetHandleId(Hero[ip])
local integer i=0
loop
exitwhen i>=10
        call CustomDefeatBJ(Player(i),"GAME OVER")
        set i=i+1
endloop
endfunction
function ScumCond takes nothing returns boolean
