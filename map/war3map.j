function RDantesCast4 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real z=GetUnitFlyHeight(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real z1=GetUnitFlyHeight(c)
local player p=GetOwningPlayer(u)
local real a=Atan2(y1-y,x1-x)
local real f
local real dist=SR3D(x,y,z,x1,y1,z1)
local real PitchA=Atan2(dist,z)
local real time=LoadReal(h,id,3)
local real he=GetUnitFlyHeight(u)
local boolean DMGBool=LoadBoolean(h,id,4)
local real dmg=(3+GetUnitAbilityLevel(u,'Ad9R'))*GetHeroAgi(u,true)*0.25
if time>0 then
    call SaveReal(h,id,3,time-0.03)
    call SetUnitOrientation(u,a*bj_RADTODEG,(PitchA*bj_RADTODEG)-80,0)
    if time>=1.8 then
        set x=x-4*time*Cos(a)
        set y=y-4*time*Sin(a)
        call SetUnitXY_1(u,x,y, false)
        call SetUnitFlyHeight(u,he+8*time,0)
    elseif time>=1.4 and time<1.8 then
        set x=x-2*time*Cos(a)
        set y=y-2*time*Sin(a)
        call SetUnitXY_1(u,x,y, false)
        call SetUnitFlyHeight(u,he+2*time,0)
        if time==1.7 then
            call SetUnitAnimationByIndex(u,7)
        endif
        if time==1.55 then
            set soundplay=SndN(2960) // Sound\Music\mp3Music\DantesBGR5.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        endif
    elseif (time>=1.15 and time<1.4) or time<0.8 then
        set x=x-6*Cos(a)
        set y=y-6*Sin(a)
        call SetUnitXY_1(u,x,y, false)
        if time>0.3 then
            call SetUnitFlyHeight(u,he+5*time,0)
        else
            call SetUnitFlyHeight(u,he-3,0)
        endif
    elseif time>=0.8 and time<1.15 then
        set x=x+2*time*Cos(a)
        set y=y+2*time*Sin(a)
        call SetUnitXY_1(u,x,y, false)
        call SetUnitFlyHeight(u,he-2*time,0)
        if time==0.95 then
            call SetUnitAnimationByIndex(u,9)
        endif
    endif
    if time==0.8 then
        set soundplay=SndN(2963) // Sound\Music\mp3Music\DantesBGR6.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    endif
else
    call SetUnitAnimation(n,"stand")
    call PauseUnit(u,false)
    call SetUnitInvulnerable(u,false)
    call PauseUnit(c,false)
    call SetUnitInvulnerable(c,false)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
    call UnitEnableAutoOrientation(c,true)
    call UnitEnableAutoOrientation(u,true)
    call SetControlToUnit(c,c, 1, "stun")
    if GetUnitAbilityLevel(u, 'CB01') > 0 then
        call UnitRemoveAbility(u, 'CE01')
        call UnitRemoveAbility(u, 'CB01')
    endif
    call SetUnitFlyHeight(u,0,2300)
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(h,id)
endif
if time==0.8 or time==1.4 then
    set n=CreateUnit(p,'e1DM',x+5*Cos(a),y+5*Sin(a),a*bj_RADTODEG)
    call UnitEnableAutoOrientation(n,false)
    call SetUnitFlyHeight(n,GetUnitFlyHeight(u)-80+PitchA*bj_RADTODEG*0.3,0)
    call SetUnitOrientation(n,a*bj_RADTODEG,(PitchA*0.5*bj_RADTODEG)-90,0)
    call UnitApplyTimedLife(n,'BHwe',0.2)
    call SetUnitTimeScale(n,1)
    call PauseUnit(c,false)
    call SetUnitInvulnerable(c,false)
    set n=CreateUnit(p,'e168',x1,y1,GetRandomReal(0,359))
    call SetUnitModel(n,"DantesExplosion1R.mdx")
    call UnitApplyTimedLife(n,'BTLF',0.03)
    call SetUnitScale(n,0.9,0.9,0.9)
    call SetUnitVertexColor(n,255,255,255,125)
    call SetUnitTimeScale(n,1.3)
    set EFF=AddSpecialEffect("war3mapImported\\blue-guagnzhu-special.mdl",x1,y1)
    call SetSpecialEffectScale(EFF , 1.7)
    call SetSpecialEffectTimeScale(EFF, 4)
    call RemoveEffect(EFF,0.5,true,CreateTimer())
    set EFF=AddSpecialEffect("tx_huoyandaji_blue.mdl",x1,y1)
    call SetSpecialEffectScale(EFF , 2.4)
    call RemoveEffect(EFF,0.9,true,CreateTimer())
    if DMGBool then
        set dmg = dmg * 1.15
    endif
    call GroupEnumUnitsInRange(DG,x1,y1,400,Base)
    loop
        set E=FirstOfGroup(DG)
        exitwhen E==null
        if Condition_Base(p,E) then
            call myCustomDamage(u,E,dmg,false,false,null,null,null)
        endif
        call GroupRemoveUnit(DG,E)
    endloop
    call PauseUnit(c,true)
    call SetUnitInvulnerable(c,true)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function RDantesCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local player p=GetOwningPlayer(u)
local real a=Atan2(y1-y,x1-x)
local real f
local real dist=SR(x,y,x1,y1)
local real time=LoadReal(h,id,3)
local real dmg=(3+GetUnitAbilityLevel(u,'Ad9R'))*GetHeroAgi(u,true)*0.5
if time<2.3 then
    call SaveReal(h,id,3,time+0.03)
    call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
    if time>1.8 and time<2 then
        call SetUnitXY_1(c,x1+11*Cos(a),y1+11*Sin(a), false)
    endif
    if time!=0.9 then
        call PauseUnit(u,true)
        call SetUnitInvulnerable(u,true)
        call PauseUnit(c,true)
        call SetUnitInvulnerable(c,true)
    endif
    if time==1.95 then
        set EFF=AddSpecialEffect("tx_huoyandaji_blue.mdl",x1,y1)
        call SetSpecialEffectScale(EFF , 0.85)
        call RemoveEffect(EFF,0.5,true,CreateTimer())
        set n=CreateUnit(p,'e168',x1,y1,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',0.01)
        call SetUnitFlyHeight(n,0,220)
        call SetUnitScale(n,3,3,3)
        call SetUnitVertexColor(n,255,255,255,165)
        call SetUnitTimeScale(n,1.6)
        set EFF=AddSpecialEffect("chushou_by_wood_effect_earth_sandycrack_fag.mdl",x1,y1)
        //call SetSpecialEffectScale(EFF , 1.)
        call RemoveEffect(EFF,0.8,false,CreateTimer())
    endif
    if time==0.9 or time==1.05 or time==1.2 or time==1.35 then
        set n=CreateUnit(p,'e2DM',x1,y1,GetRandomReal(0,359))
        call UnitEnableAutoOrientation(n,false)
        call SetUnitOrientation(n,GetRandomReal(-180,180),90,0)
        call UnitApplyTimedLife(n,'BTLF',0.3)
        if time!=1.35 and time!=1.2 and time!=1.05 then
        set EFF=AddSpecialEffect("tx_huoyandaji_blue.mdl",x1,y1)
        call SetSpecialEffectScale(EFF , 0.85)
        call RemoveEffect(EFF,0.6,true,CreateTimer())
        set EFF=AddSpecialEffect("tx_huoyandaji_blue.mdl",x1,y1)
        call SetSpecialEffectScale(EFF , 0.85)
        call SetSpecialEffectZ(EFF , 250)
        call RemoveEffect(EFF,0.6,true,CreateTimer())
        set n=CreateUnit(p,'e168',x1,y1,GetRandomReal(0,359))
        call SetUnitModel(n,"Others\\JeanneDark1mt_baozha1.mdl")
        call UnitApplyTimedLife(n,'BTLF',0.03)
        call SetUnitScale(n,0.7,0.7,0.7)
        call SetUnitVertexColor(n,255,255,255,165)
        call SetUnitTimeScale(n,1.6)
        set n=CreateUnit(p,'e168',x1,y1,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',0.01)
        call SetUnitFlyHeight(n,0,220)
        call SetUnitScale(n,2,2,2)
        call SetUnitVertexColor(n,255,255,255,165)
        call SetUnitTimeScale(n,3)
        endif
        set n=CreateUnit(p,'e166',x1,y1,GetRandomReal(0,359))
        call UnitEnableAutoOrientation(n,false)
        call SetUnitOrientation(n,GetRandomReal(-180,180),GetRandomReal(-45,45),GetRandomReal(-45,45))
        call SetUnitFlyHeight(n,0,220)
        call UnitApplyTimedLife(n,'BTLF',0.6)
        call SetUnitScale(n,2.5,2.5,2.5)
        call SetUnitTimeScale(n,1.2)
        set n=CreateUnit(p,'e166',x1,y1,GetRandomReal(0,359))
        call UnitEnableAutoOrientation(n,false)
        call SetUnitOrientation(n,GetRandomReal(-180,180),GetRandomReal(-45,45),GetRandomReal(-45,45))
        call SetUnitFlyHeight(n,0,220)
        call UnitApplyTimedLife(n,'BTLF',0.6)
        call SetUnitScale(n,2.5,2.5,2.5)
        call SetUnitTimeScale(n,1.2)
    endif
    if time==1.35 then
        set soundplay=SndN(2966) // Sound\Music\mp3Music\DantesR3.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    endif
    if time==1.8 then
        call SetUnitAnimationByIndex(u,4)
        call SetUnitOrientation(u,GetUnitFacing(u),-35,0)
        call SetUnitOrientation(c,GetUnitFacing(u),-90,0)
        call SetUnitFlyHeight(c,0,800)
        call SetUnitXY_1(u,x+30*Cos(a),y+30*Sin(a), false)
        call UnitEnableAutoOrientation(c,false)
        set EFF=AddSpecialEffect("DantesRSlash.mdx", x+30*Cos(a), y+30*Sin(a))
        call SetSpecialEffectScale(EFF , 2.7)
        call SetSpecialEffectTimeScale(EFF , 0.7)
        call SetSpecialEffectZ(EFF , 90)
        call SetSpecialEffectOrientation(EFF , a * bj_RADTODEG,0,90)
        call SetSpecialEffectVertexColour(EFF , 100 , 100 , 255 , 250)
        call DestroyEffect(EFF)
        set soundplay=SndN(2969) // Sound\Music\mp3Music\DantesBGR8.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    endif
    if time==0.9 then
        set soundplay=SndN(2972) // Sound\Music\mp3Music\DantesBGR4.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        call PauseUnit(c,false)
        call SetUnitInvulnerable(c,false)
        if GetUnitAbilityLevel(u, 'CB01') > 0 then
            set dmg = dmg * 1.15
        endif
        call myCustomDamage(u,c,dmg,false,false,null,null,null)
        call PauseUnit(c,true)
        call SetUnitInvulnerable(c,true)
        set n=CreateUnit(p,'eo9E',x1,y1,a*bj_RADTODEG)
        call SetUnitFlyHeight(n,15,0)
        call SetUnitScale(n,1.2,1.2,1.2)
        call UnitApplyTimedLife(n,'BTLF',1.2)
    endif
    if time==0.3 then
        set soundplay=SndN(2975) // Sound\Music\mp3Music\DantesBGR3.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
        set EFF = AddSpecialEffect("az_juli01_Blue.mdx",x1,y1)
        call SetSpecialEffectScale(EFF, 1.2)
        call SetSpecialEffectZ(EFF, GetUnitFlyHeight(c)+60)
        call SetSpecialEffectTimeScale(EFF,0.2)
        call RemoveEffect(EFF,0.4,true,CreateTimer())
    endif
else
    call SetUnitAnimation(u,"Stand Ready")
    call PauseTimer(t)
    call SaveReal(h,id,3,2.3)

    call TimerStart(t,0.03,true,function RDantesCast4)
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function RDantesCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local real x2=0
local real y2=0
local integer i=LoadInteger(h,id,2)
local integer is=0
local real ig=30*bj_DEGTORAD
local player p=GetOwningPlayer(u)
local real a=Atan2(y1-y,x1-x)
local real f
local real dist=SR(x,y,x1,y1)
local real time=LoadReal(h,id,3)
if time==0.03 then
call SetUnitAnimation(u,"Stand Ready")
set EFF=AddSpecialEffect("AuraExplBlue.mdl", x, y)
call SetSpecialEffectScale(EFF , 0.8)
call DestroyEffect(EFF)
loop
exitwhen is>=13
set n=CreateUnit(p,'e0ZH',x+400*Cos(ig*is),y+400*Sin(ig*is),180+is*30)
call SetUnitVertexColor(n,255,255,255,35)
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitTimeScale(n,1)
set is=is+1
endloop
endif
call SaveReal(h,id,3,time+0.03)
if time<1.1 then
    call PauseUnit(u,true)
    call SetUnitInvulnerable(u,true)
else
    if time==1.11 then
        set soundplay=SndN(2978) // Sound\Music\mp3Music\DantesBGR7.mp3
        call StartSound(soundplay)
        //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
    endif
    if dist>120 and UnitIsAlive(u)and UnitIsAlive(c) and time<6 then
        set x=x+65*Cos(a)
        set y=y+65*Sin(a)
        call SetUnitXY_1(u,x,y, false)
        call SetUnitFacing(u,a*bj_RADTODEG)
        set n=CreateUnit(p,'e3QV',x,y,a*bj_DEGTORAD)
        call UnitApplyTimedLife(n,'BTLF',0.14)
        call SetUnitVertexColor(n,255,255,255,50)
        call SetUnitAnimation(n,"walk")
        if dist<240 then
            call SetUnitAnimation(u,"Spell Four")
        else
            call SetUnitAnimation(u,"walk")
        endif
    elseif UnitIsAlive(c) then
        if time>=6 then
            call SetUnitXY_1(u,x1,y1, false)
        endif
        if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
            call PauseUnit(c,true)
            call SetUnitInvulnerable(c,true)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
            call SaveReal(h,id,3,0)
            //call UnitAddAbility(c,'A1US')
            call UnitEnableAutoOrientation(u,false)
            call SetUnitOrientation(u,GetUnitFacing(u),25,0)
            call SetUnitFlyHeight(c,115,0)
            set soundplay=SndN(2981) // Sound\Music\mp3Music\DantesR2.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            set soundplay=SndN(2984) // Sound\Music\mp3Music\DantesBGR2.mp3
            call StartSound(soundplay)
            //call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
            call PauseTimer(t)
            set n=CreateUnit(p,'ed0O',x1,y1,a*bj_RADTODEG)
            call SetUnitTimeScale(n,0.3)
            call UnitApplyTimedLife(n,'BTLF',3)
            call SetUnitScale(n,1.1,1.1,1.1)
            call SetUnitVertexColor(n,255,255,255,170)
            call TimerStart(t,0.03,true,function RDantesCast3)
        else
            call PauseUnit(u,false)
            call SetUnitInvulnerable(u,false)
            call SetUnitVertexColor(u,255,255,255,255)
            call SetUnitTimeScale(u,1)
            call PauseTimer(t)
            call SetUnitFlyHeight(u,0,0)
            call DestroyTimer(t)
            call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
            call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
            call FlushChildHashtable(h,id)
        endif
    else
        call SetUnitTimeScale(u,1)
        call PauseUnit(u,false)
        call SetUnitInvulnerable(u,false)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
    endif
endif
set p=null
set u=null
set c=null
set t=null
endfunction
function RDantesCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
local player p=GetOwningPlayer(u)
if GetUnitAbilityLevel(u, 'CB01') > 0 then
    call SaveBoolean(h,id,4,true)
else
    call SaveBoolean(h,id,4,false)
endif
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call SaveReal(h,id,3,0)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call UnitAddAbility(u,'Arav')
call UnitRemoveAbility(u,'Arav')
set soundplay=SndN(2987) // Sound\Music\mp3Music\DantesR1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set soundplay=SndN(2989) // Sound\Music\mp3Music\DantesBGR1.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SetUnitTurnSpeed(u,5000.00)
call SetUnitTimeScale(u,2)
call TimerStart(t,0.03,true,function RDantesCast2)
set p=null
set u=null
set t=null
endfunction
function InitTrig_RDantes takes nothing returns nothing
set gg_trg_RDantes=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_RDantes,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_RDantes,Condition(function RDantesCond))
call TriggerAddAction(gg_trg_RDantes,function RDantesCast)
endfunction
function TDantesCond takes nothing returns boolean
return GetSpellAbilityId()=='Ad8T'
endfunction

function RemoveUnitTimedLoop takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer id = GetHandleId(t)
    if LoadUnit("unit") != null then
          call RemoveUnit(LoadUnit("unit"))
    endif
    call RemoveSavedHandle(HH,id,SH_unit)
    call FlushChildHashtable(HH,id)
    call DestroyTimer(t)
    set t = null
endfunction

function RemoveUnitTimed takes unit a, real time returns nothing
    local integer hId = GetPlayerId(GetTriggerPlayer())
    local timer t=CreateTimer()
    local integer id = GetHandleId(t)
    if a != null and not IsUnitType(a, UNIT_TYPE_HERO) then
        call SaveAgentHandle(HH,id,SH_unit,a)
    endif
    call SaveReal(HH,id,TIME_HASH, time)
    call TimerStart(t,time,false,function RemoveUnitTimedLoop)
    set t = null
endfunction

function TDantesCast8 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local real x=LoadReal(h,id,6)
local real y=LoadReal(h,id,7)
local real x1=LoadReal(h,id,4)
local real y1=LoadReal(h,id,5)
local real time=LoadReal(h,id,3)
local real a=Atan2(y-y1,x-x1)
local real f=0
local player p=GetOwningPlayer(u)
local group G3=LoadGroupHandle(h,id,6)
local integer is = 9
call PauseUnit(u,false)
call ShowUnit(u,true)
if p==GetLocalPlayer()then
call ClearSelection()
call SelectUnit(u,true)
endif
call SetUnitAnimation(u,"stand")
set n=CreateUnit(p,'edT6',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.5)
call SetUnitTimeScale(n,1)
call GroupClear(G3)
        loop
        exitwhen is>19
                if LoadUnitHandle(h,id,is) != null then
                //call RemoveUnit(LoadUnitHandle(h,id,is))
                call RemoveSavedHandle(h,id,is)
                endif
                set is = is + 1
        endloop
if GetUnitAbilityLevel(u, 'CB01') > 0 then
        call UnitRemoveAbility(u, 'CE01')
        call UnitRemoveAbility(u, 'CB01')
endif
call SetUnitInvulnerable(u,false)
call SetUnitXY_1(u,x,y, false)
call UnitRemoveAbility(u,'Ao93')
call UnitRemoveAbility(u,'Ao94')
call SetUnitVertexColor(u,255,255,255,255)
call SetUnitTurnSpeed(u,3)
call DestroyGroup(G3)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set u=null
set p=null
set G3=null
set t=null
endfunction
