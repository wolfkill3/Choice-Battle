function WDeidara2Push2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real a=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real sc=0
local real y=GetUnitY(l__d)
local real dist=LoadReal(h,id,3)
local player p=GetOwningPlayer(l__d)
if dist>0 and IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false and l__d!=null then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SaveReal(h,id,3,dist-speed)
call SaveReal(h,id,1,speed-speed*0.05)
else
set n=CreateUnit(p,'eo0N',x,y,a*bj_RADTODEG-225)
call SetUnitVertexColor(n,200,255,200,0)
if p==GetLocalPlayer()then
call SetUnitVertexColor(n,200,255,200,55)
endif
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'eo0N',x,y,a*bj_RADTODEG+225)
call SetUnitVertexColor(n,200,255,200,0)
if p==GetLocalPlayer()then
call SetUnitVertexColor(n,200,255,200,55)
endif
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'eo0N',x,y,a*bj_RADTODEG+180)
call SetUnitVertexColor(n,200,255,200,0)
if p==GetLocalPlayer()then
call SetUnitVertexColor(n,200,255,200,55)
endif
call UnitApplyTimedLife(n,'BTLF',0.4)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set l__d=null
set t=null
endfunction
