function CastSpectraNodibranca takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local player p=GetOwningPlayer(u)
local real x=GetUnitX(c)
local real y=GetUnitY(c)
local real x1=0
local real y1=0
local real r=0
local real a=0
local integer i=0
local real dmg=((GetUnitAbilityLevel(u,'A0LU')+2)*GetHeroInt(u,true)/18)+5
set soundplay=SndN(1545) // Sound\Music\mp3Music\GenkshiSpectroSpada.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
loop
exitwhen i>=19
set a=15*i*bj_DEGTORAD
set r=GetRandomReal(600,800)
set x1=x+r*Cos(a)
set y1=y+r*Sin(a)
set a=Atan2(y-y1,x-x1)
set n=CreateUnit(p,'e0HS',x1,y1,a*bj_RADTODEG)
call MissleMoveSpectraNodibranca(u,c,n,47,GetRandomReal(-0.4,0.4),dmg)
set i=i+1
endloop
set c=null
set p=null
set u=null
endfunction
function SpectraNodibrancaInit takes nothing returns nothing
endfunction
function IllusionStrikeFade2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local integer per=LoadInteger(h,id,1)
local integer i=LoadInteger(h,id,2)
local real alf=LoadReal(h,id,3)
local real up=LoadReal(h,id,4)
if i<per then
call SaveInteger(h,id,2,i+1)
call SetUnitVertexColor(u,255,255,255,R2I(alf-up))
call SaveReal(h,id,3,alf-up)
else
call SetUnitVertexColor(u,255,255,255,255)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set u=null
set t=null
endfunction
function IllusionStrikeFade takes unit u,real time returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
call SaveInteger(h,id,1,R2I(time*10))
call SaveInteger(h,id,2,0)
call SaveReal(h,id,3,255)
call SaveReal(h,id,4,255/(time*10))
call TimerStart(t,0.05,true,function IllusionStrikeFade2)
set t=null
endfunction
function IllusionStrikeCond takes nothing returns boolean
return GetSpellAbilityId()=='A0LS' and udg_B==true
endfunction
function IllusionStrikeCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,1)
local integer ip=GetPlayerId(GetOwningPlayer(u))
local player p=GetOwningPlayer(u)
local real x=GetUnitX(c)
local real y=GetUnitY(c)
local real r=GetRandomReal(75,125)
local real a=GetRandomReal(0,7)
local integer i=0
call SaveUnitHandle(h,GetHandleId(Hero[ip]),SH_IMR,c)
call UnitApplyTimedLife(CreateUnit(p,'e0HQ',x,y,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0HO',x,y,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0HP',x,y,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0HR',x,y,GetRandomReal(0,359)),'BTLF',2)
loop
set n=CreateIllusionFromUnit(u)
call SetUnitFacingInstant(n,GetUnitFacing(u))
call UnitCancelTimedLife(n)
call SetUnitCurrentSight(n,600)
call SetUnitUseFood(n,true)
call UnitApplyTimedLife(n,'B03O',10)
call SetIllusionDamageDealt(n,0.3)
call SetIllusionDamageReceived(n,2.5)
// set n=CreateUnit(p,'h019',x,y,GetRandomReal(0,359))
// call UnitAddAbility(n,'A0LT')
// call UnitApplyTimedLife(n,'BTLF',2)
// call IssueTargetOrderById(n,852274,u)
set i=i+1
exitwhen i>=GetUnitAbilityLevel(u,'A0LS')
endloop
if IsUnitEnemy(c,p)then
if LoadBoolean(HH,GetHandleId(c),ANTITARGET_ABILITY)==false then
call myCustomDamage(u,c,GetHeroInt(u,true)*(GetUnitAbilityLevel(u,'A0LS')+1),false,false,null,null,null)
call SetControlToUnit(u,c,2, "stun")
else
call SaveUnitHandle(HH,GetHandleId(c),REVERSE_TARGET,u)
endif
endif
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call SetUnitXY_1(u,x+r*Cos(a),y+r*Sin(a), false)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set u=null
set c=null
set t=null
endfunction
function IllusionStrikeCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(p)
local integer i=0
call RemoveSavedHandle(h,GetHandleId(Hero[ip]),SH_IMR)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,c)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call IllusionStrikeFade(u,3)
call UnitApplyTimedLife(CreateUnit(p,'e0HQ',x,y,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0HO',x,y,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0HP',x,y,GetRandomReal(0,359)),'BTLF',2)
call UnitApplyTimedLife(CreateUnit(p,'e0HR',x,y,GetRandomReal(0,359)),'BTLF',2)
if GetRandomInt(0, 1)==0 then
        set soundplay=SndN(1547) // Sound\Music\mp3Music\GenkshiQ.mp3
else
        set soundplay=SndN(1549) // Sound\Music\mp3Music\GenkshiQ2.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,1.3,false,function IllusionStrikeCast2)
set u=null
set p=null
set c=null
set t=null
endfunction
function InitIllusionStrike takes nothing returns nothing
endfunction
function IllusionStrike2Cond takes nothing returns boolean
return(GetUnitTypeId(GetTriggerUnit())=='H02Y' or GetUnitTypeId(GetTriggerUnit())=='H02Z')and GetUnitAbilityLevel(GetTriggerUnit(),'B03O')>0
endfunction
function IllusionStrike2 takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local integer ip=GetPlayerId(p)
local integer i=0
local real r=GetRandomReal(75,125)
local real a=GetRandomReal(0,7)
local unit c=LoadUnitHandle(h,GetHandleId(Hero[ip]),SH_IMR)
call SetUnitX(u,GetUnitX(c)+r*Cos(a))
call SetUnitY(u,GetUnitY(c)+r*Sin(a))
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",GetUnitX(u),GetUnitY(u)))
if IsUnitEnemy(c,p)then
call IssueTargetOrder(u,"attack",c)
endif
set u=null
set c=null
set p=null
endfunction
function InitIllusionStrike2 takes nothing returns nothing
endfunction
function DaiEnakaiEnteiCond takes nothing returns boolean
return GetSpellAbilityId()=='A017' and udg_B==true
endfunction
function DaiEnakaiEnteiCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local group g=LoadGroupHandle(h,id,6)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real x2
local real y2
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,5)
local real a2
local player p=GetOwningPlayer(u)
local real dmg=GetHeroStr(u,true)*14
local real time=LoadReal(h,id,7)
if time<1.52 then
call SaveReal(h,id,7,time+0.02)
if time<1.5 then
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
endif
if time==1.5 then
call GroupEnumUnitsInRange(G,x,y,400,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call SetUnitX(E,x)
call SetUnitY(E,y)
endif
call GroupRemoveUnit(G,E)
endloop
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
endif
else
if SR(x,y,x1,y1)<=2750 and IsTerrainPathable(GetUnitX(l__d),GetUnitY(l__d),PATHING_TYPE_FLYABILITY)==false then
set x1=x1+35*Cos(a)
set y1=y1+35*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
set n=CreateUnit(p,'e0K9',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',0.01)
call SetUnitScale(n,1.7,1.7,1.7)
call SetUnitVertexColor(n,255,230,100,70)
call UnitApplyTimedLife(CreateUnit(p,'e01Z',x1,y1,GetRandomReal(0,359)),'BHwe',1)
call GroupEnumUnitsInRange(G,x1,y1,250,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
set x2=GetUnitX(E)
set y2=GetUnitY(E)
set a2=Atan2(y2-y1,x2-x1)
call SetUnitPosition(E,x2-58*Cos(a2),y2-58*Sin(a2))
if IsUnitInGroup(E,g)==false then
call GroupAddUnit(g,E)
call PauseUnit(E,true)
call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,true)
call SetUnitPathing(E,false)
endif
endif
call GroupRemoveUnit(G,E)
endloop
else
loop
set E=FirstOfGroup(g)
exitwhen E==null
call SetUnitFlyHeight(E,0,GetUnitFlyHeight(E))
call GroupRemoveUnit(g,E)
call PauseUnit(E,false)
call SaveBoolean(HH,GetHandleId(E),TARGET_ABILITY,false)
call SetUnitPathing(E,true)
endloop
call UnitApplyTimedLife(CreateUnit(p,'e0DL',x1,y1,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0DK',x1,y1,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0DJ',x1,y1,GetRandomReal(0,359)),'BTLF',3)
call GroupEnumUnitsInRange(G,x1,y1,750,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
if GetUnitAbilityLevel(u,'AcF1')>0 then
call PoisonDamage3Ace(u,E,GetHeroStr(u,true),4,"Environment\\LargeBuildingFire\\LargeBuildingFire1.mdl","origin")
endif
endif
call GroupRemoveUnit(G,E)
endloop
call DestroyTimer(t)
call DestroyGroup(g)
call RemoveUnit(l__d)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,id)
endif
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function DaiEnakaiEnteiCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
local unit l__d=CreateUnit(GetOwningPlayer(u),'e000',x,y,f)
local player p=GetOwningPlayer(u)
local group g=CreateGroup()
call SetUnitAnimation(u,"spell channel two")
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,l__d)
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
call SaveReal(h,id,5,a)
call SaveGroupHandle(h,id,6,CreateGroup())
call GroupEnumUnitsInRange(g,x,y,350,Base)
loop
set E=FirstOfGroup(g)
exitwhen E==null
if Condition_Base(p,E)then
call SlowUnit(u,E,0.5,0,5,0,false)
endif
call GroupRemoveUnit(g,E)
endloop
call DestroyGroup(g)
set n=CreateUnit(p,'e0IH',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.25)
set n=CreateUnit(p,'e0IO',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,1.5)
set n=CreateUnit(p,'e0IG',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.5)
call SetUnitScale(n,2.5,2.5,2.5)
set n=CreateUnit(p,'e0IG',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.5)
call SetUnitScale(n,3.5,3.5,3.5)
set n=CreateUnit(p,'e0IG',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.5)
call SetUnitScale(n,5,5,5)
set n=CreateUnit(p,'e0IG',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.5)
call SetUnitScale(n,6.5,6.5,6.5)
set n=CreateUnit(p,'e0II',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitTimeScale(n,0.25)
call SetUnitInvulnerable(u,true)
call PauseUnit(u,true)
set soundplay=SndN(1551) // Sound\Music\mp3Music\DaiEnkaiEntei.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,0.02,true,function DaiEnakaiEnteiCast2)
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function InitTrig_DaiEnakaiEntei takes nothing returns nothing
set gg_trg_DaiEnakaiEntei=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_DaiEnakaiEntei,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_DaiEnakaiEntei,Condition(function DaiEnakaiEnteiCond))
call TriggerAddAction(gg_trg_DaiEnakaiEntei,function DaiEnakaiEnteiCast)
endfunction
function EnkaiHibashiraCond takes nothing returns boolean
