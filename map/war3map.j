//Aizen2start
function StunAoeOneTime takes unit damager,real x0,real y0,real range,real damage returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
call GroupClear(G)
call GroupEnumUnitsInRange(G,x0,y0,range,Base)
loop
set n0=FirstOfGroup(G)
exitwhen n0==null
if UnitIsAlive(n0)and IsUnitEnemy(n0,GetOwningPlayer(damager))==true and IsUnitType(n0,UNIT_TYPE_STRUCTURE)==false and GetUnitAbilityLevel(n0,'Avul')==0 then


call SetControlToUnit(n0,n0,damage, "stun")


endif
call GroupRemoveUnit(G,n0)
endloop
call GroupClear(G)
set damager=null
set t=null
endfunction




function ChangeAbilityTime1 takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
if GetUnitAbilityLevel(caster,LoadInteger(HH,id,22))>0 then
call UnitRemoveAbility(caster,LoadInteger(HH,id,22))
call SetPlayerAbilityAvailable(GetOwningPlayer(caster),LoadInteger(HH,id,21),true)
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
set caster=null
endfunction
function ChangeAbilityTime takes unit caster0,real time0,integer idAbil,integer idAbil2 returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(HH,id,1,caster0)
call SetPlayerAbilityAvailable(GetOwningPlayer(caster0),idAbil,false)
call UnitAddAbility(caster0,idAbil2)
call SaveInteger(HH,id,21,idAbil)
call SaveInteger(HH,id,22,idAbil2)
call TimerStart(t,time0,false,function ChangeAbilityTime1)
set caster0=null
set t=null
endfunction
