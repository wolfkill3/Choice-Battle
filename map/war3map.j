function GKCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local integer idu=GetHandleId(u)
local real x=LoadReal(h,id,1)
local real y=LoadReal(h,id,2)
local real life=LoadReal(h,id,3)
local real mana=LoadReal(h,id,4)
local real time=LoadReal(h,id,10)
if IsUnitPaused(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
        call SaveReal(h,id,10,time+0.1)
endif
if time>10 then
        if GetUnitAbilityLevel(u,'A185')>0 then
                call SetUnitXY_1(u,x,y, false)
                call SetUnitState(u,UNIT_STATE_LIFE,life)
                call SetUnitState(u,UNIT_STATE_MANA,mana)
                call PauseUnit(u,false)
                call SetUnitInvulnerable(u,false)
                if GetUnitAbilityLevel(u,'A182')==0 then
                        call UnitAddAbility(u,'A182')
                endif
        call SaveReal(HH, GetHandleId(LoadFrameHandle(HH, GetHandleId(GetOwningPlayer(u)),SH_ReplaceableTextures_CommandButtons_BTNSabrac3_blp)), c_DURATION, 0)
        endif
        call UnitRemoveAbility(u,'A185')
        call RemoveUnit(LoadUnitHandle(h,id,11))
        call RemoveUnit(LoadUnitHandle(HH,idu,SH_dc))
        call RemoveSavedReal(HH,idu,SH_hpc)
        call RemoveSavedReal(HH,idu,SH_mpc)
        call RemoveSavedReal(HH,idu,SH_xc)
        call RemoveSavedReal(HH,idu,SH_yc)
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(h,id)
endif
set u=null
set t=null
endfunction
