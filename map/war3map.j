function AtalantaPush2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local real speed=LoadReal(h,id,1)
local real a=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real sc=0
local real y=GetUnitY(l__d)
local real dist=LoadReal(h,id,3)
local player p=GetOwningPlayer(l__d)
if dist>0 and l__d!=null then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SaveReal(h,id,3,dist-speed)
call SaveReal(h,id,1,speed-speed*0.05)
else
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG-225)
call SetUnitVertexColor(n,200,255,200,55)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+225)
call SetUnitVertexColor(n,200,255,200,55)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+180)
call SetUnitVertexColor(n,200,255,200,55)
call UnitApplyTimedLife(n,'BTLF',0.4)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set l__d=null
set t=null
endfunction
function AtalantaPush takes unit l__d,real speed,real angle,real dist returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,l__d)
call SaveReal(h,id,1,speed)
call SaveReal(h,id,2,angle)
call SaveReal(h,id,3,dist)
call TimerStart(t,0.02,true,function AtalantaPush2)
set t=null
endfunction
function QAtalantaCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local player p=GetOwningPlayer(u)
local real fl=LoadReal(h,id,1)
if fl<2 and GetUnitAbilityLevel(u,'A1DU')>0 and GetUnitAbilityLevel(u,'B06S')==0 then
call SaveReal(h,id,1,fl+0.02)
call SaveReal(h,GetHandleId(u),SH_QRng,fl+0.02)
call SetUnitXY_1(l__d,x,y, false)
call SetUnitFlyHeight(l__d,GetUnitFlyHeight(u),0)
else
if GetUnitAbilityLevel(u,'A1DU')==0 then
call ShowAbility2('A1DS',true)
call ShowAbility2('A1DT',false)
else
call UnitRemoveAbility(u,'A00D')
call UnitRemoveAbility(u,'A1DU')
call ShowAbility2('A1DT',false)
call StartAbilityCooldown(GetUnitAbility(u,'A1DS'),2)
call ShowAbility2('A1DS',true)
endif
call RemoveSavedReal(h,GetHandleId(u),SH_QRng)
call UnitRemoveAbility(u,'Basl')
call SetUnitScale(l__d,0.5+fl/2,0.5+fl/2,0.5)
call SetUnitTimeScale(l__d,1.5)
call KillUnit(l__d)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set l__d=null
set p=null
set u=null
set t=null
endfunction
