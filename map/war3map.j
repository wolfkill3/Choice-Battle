call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+GetUnitState(u,UNIT_STATE_MAX_LIFE)*0.2)
call PauseUnit(u,true)

if GetUnitTypeId(u)=='H15C' then
        set soundplay=CreateSound("Sound\\Music\\mp3Music\\ArthurR.mp3",false,false,true,12700,12700,"")
        call SetUnitAnimationByIndex(u, 14)
