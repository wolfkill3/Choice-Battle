if IsTerrainPathable(x1,y1,PATHING_TYPE_FLYABILITY)==false and LoadInteger(HH,GetHandleId(u),StringHash("HakuW"))>0 then
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
call SaveInteger(HH,GetHandleId(u),StringHash("HakuW"),LoadInteger(HH,GetHandleId(u),StringHash("HakuW"))-1)
if SR(x,y,x1,y1)<250 then
call SetUnitXY_1(u,x1,y1, false)
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x1,y1))
else
call SetUnitXY_1(u,x+250*Cos(a),y+250*Sin(a), false)
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x+250*Cos(a),y+250*Sin(a)))
endif
call SetUnitFacing(u,a*bj_RADTODEG)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\NarutoFastStep.mp3",false,false,true,12700,12700,"")
