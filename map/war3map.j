function ShanaEndCond takes nothing returns boolean
return GetSpellAbilityId()=='A08R' and udg_B==true
endfunction
function ShanaEndCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,3)
local real f=GetUnitFacing(u)
local player p=GetOwningPlayer(u)
local real dmg=GetHeroAgi(u,true)*(GetUnitAbilityLevel(u,'A08R')+2)
local real dist=SR(x,y,x1,y1)
local real a=Atan2(y1-y,x1-x)
local real he=0
local real dist2=LoadReal(h,id,100)
local real mxd=LoadReal(h,id,4)
local real time=LoadReal(h,id,8)
local real time2=LoadReal(h,id,9)
if time2<0.5 then
call SaveReal(h,id,9,time2+0.035)
if time2==0.49 then
call SetUnitFlyHeight(u,0,450)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
endif
else
if dist2>50.00 and udg_B==true and DU2==true then
call SaveReal(h,id,100,dist2-mxd/30)
set x=x+mxd/30*Cos(a)
set y=y+mxd/30*Sin(a)
call SetUnitFacing(u,a*bj_RADTODEG)
call SetUnitFlyHeight(l__d,550*(dist/mxd),0)
call SetUnitXY_1(l__d,x,y, false)
call SetUnitAnimation(u,"Spell Three")
else
call SaveReal(h,id,8,time+0.03)
if time<0.5 then
call GroupEnumUnitsInRange(G,x1,y1,500,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg/16,false,false,null,null,null)
call SetControlToUnit(E,E, 2, "stun")
endif
call GroupRemoveUnit(G,E)
endloop
call UnitApplyTimedLife(CreateUnit(p,'e0VM',x1,y1,GetRandomReal(0,359)),1,0.5)
if ModuloReal(time,0.06)<0.01 then
call DestroyEffect(AddSpecialEffect("war3mapImported\\LW10.mdx",x1,y1))
endif
else
call KillUnit(l__d)
call UnitApplyTimedLife(CreateUnit(p,'e0VN',x1,y1,GetRandomReal(0,359)),1,2)
call UnitApplyTimedLife(CreateUnit(p,'e0VL',x1,y1,GetRandomReal(0,359)),1,2)
call UnitApplyTimedLife(CreateUnit(p,'e0VM',x1,y1,GetRandomReal(0,359)),1,2)
call FlushChildHashtable(h,id)
call PauseTimer(t)
call UnitRemoveAbility(u,'A10V')
call DestroyTimer(t)
endif
endif
endif
set u=null
set t=null
set l__d=null
set p=null
endfunction
function ShanaEndCast takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real f=GetUnitFacing(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
if SR(x,y,x1,y1)<600 then
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
set x=x-600*Cos(a)
set y=y-600*Sin(a)
call SetUnitXY_1(u,x,y, false)
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
endif
if SR(x,y,x1,y1)<101 then
call SaveReal(h,id,100,600)
call SaveReal(h,id,4,600)
else
call SaveReal(h,id,100,SR(x,y,x1,y1))
call SaveReal(h,id,4,SR(x,y,x1,y1))
endif
call DestroyEffect(AddSpecialEffect("war3mapImported\\Slam.mdl",x,y))
call UnitAddAbility(u,'Arav')
call UnitRemoveAbility(u,'Arav')
call SaveUnitHandle(h,id,0,u)
call SetUnitInvulnerable(u,true)
call SaveReal(h,id,2,x1)
call SaveReal(h,id,3,y1)
call SaveReal(h,id,8,0)
call PauseUnit(u,true)
call SetUnitFlyHeight(u,450,0)
set n=CreateUnit(p,'e0GL',x,y,a*bj_RADTODEG)
call SetUnitScale(n,6,6,6)
call SetUnitFlyHeight(n,550,0)
call SaveUnitHandle(h,id,7,n)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Shana4.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.035,true,function ShanaEndCast2)
set u=null
set p=null
set t=null
endfunction
