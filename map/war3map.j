local real dmg2=GetHeroAgi(u,true)*0.4*0.03
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
if time>0 and UnitIsAlive(u)then
call SetUnitXY_1(l__d,x,y, false)
if CheckUnitInvisible(u) then
    call UnitAddAbility(l__d,'Ao7S')
else
    call UnitRemoveAbility(l__d,'Ao7S')
endif
call SetUnitFacing(l__d,GetUnitFacing(u))
call SetUnitFlyHeight(l__d,GetUnitFlyHeight(u),0)
if IsUnitPaused(u)==false and IsUnitHidden(u)==false and GetUnitAbilityLevel(u,'Pet1')==0 then
call SaveReal(h,id,5,time-0.03)
endif
if GetUnitAbilityLevel(u,'A12O')>0 then
