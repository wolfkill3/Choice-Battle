set u=null
set c=null
set p=null
set t=null
endfunction
function CastKoykaSuigetsu takes nothing returns nothing
local unit u=GetTriggerUnit()
local unit c=GetSpellTargetUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetUnitX(c)
local real y1=GetUnitY(c)
local player p=GetOwningPlayer(u)
local integer i=1
local real f=GetUnitFacing(u)
local real r=0
call ShowUnit(u,false)
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,2,c)
call SaveReal(h,id,1,x1)
call SaveReal(h,id,2,y1)
loop
exitwhen i>=13
set r=30*i*bj_DEGTORAD
if GetUnitTypeId(u)=='H02M' then
set n=CreateUnit(p,'e0EV',x1+600*Cos(r),y1+600*Sin(r),f)
else
set n=CreateUnit(p,'e1EV',x1+600*Cos(r),y1+600*Sin(r),f)
endif
call UnitAddAbility(n,'A031')
call SetUnitTimeScale(n,4)
call MissleMoveKoykaSuigetsu(n,50,0,c,"Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl",0,u)
set i=i+1
endloop
set soundplay=CreateSound("Sound\\Music\\mp3Music\\KyokaSuigetsu.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call TimerStart(t,0.6,false,function CastKoykaSuigetsu2)
set t=null
set p=null
set u=null
set c=null
endfunction
