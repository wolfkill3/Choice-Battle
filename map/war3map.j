set u=null
set t=null
endfunction
function AndroidBarrierCond takes nothing returns boolean
return GetSpellAbilityId()=='A108' and udg_B==true
endfunction
function AndroidBarrierCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local group g=LoadGroupHandle(h,id,1)
local integer i=1
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local real dmg=GetHeroInt(u,true)*.375
local real dmg2=GetHeroInt(u,true)*8
local player p=GetOwningPlayer(u)
local real r=GetRandomReal(0.,6.283185)
local real sc=LoadReal(h,id,4)
local real cof=LoadReal(h,id,5)
local real dist=LoadReal(h,id,6)
local real time=LoadReal(h,id,7)
set idg=GetHandleId(g)
call SaveReal(h,id,7,time+0.05)
if time<=2 then
call SaveReal(h,id,5,cof+cof*0.062)
call SaveReal(h,id,4,sc*(1.042-cof))
call SetUnitScale(LoadUnitHandle(h,id,8),3.2,3.2,3.2)
call SetUnitScale(LoadUnitHandle(h,id,9),10-sc,10-sc,10-sc)
call SetUnitVertexColor(LoadUnitHandle(h,id,8),250,120,100,R2I(100*(sc-1.6)))
call SetUnitVertexColor(LoadUnitHandle(h,id,9),250,R2I(140-4*sc),R2I(170-3*sc),R2I(9*sc))
call GroupEnumUnitsInRange(G,x,y,300,Base)
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\FarseerMissile\\FarseerMissile.mdl",x+GetRandomReal(-140,140)*Cos(GetRandomReal(0,359)*bj_DEGTORAD) ,y+GetRandomReal(-140,140)*Sin(GetRandomReal(0,359)*bj_DEGTORAD)))
//if sc>8 then
//call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\FarseerMissile\\FarseerMissile.mdl",x+GetRandomReal(-65*sc,65*sc)*Cos(GetRandomReal(0,359)*bj_DEGTORAD) ,y+GetRandomReal(-65*sc,65*sc)*Sin(GetRandomReal(0,359)*bj_DEGTORAD)))
//endif
set n=CreateUnit(p,'e0IT',x,y,GetRandomReal(0,359))
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitVertexColor(n,250,225,100,140)
call SetUnitTimeScale(n,3)
call UnitApplyTimedLife(n,'BTLF',.25)
if dist>=3 then
set n=CreateUnit(p,'e0B2',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',.25)
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitVertexColor(n,250,255,255,30)
call SaveReal(h,id,6,0)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E) then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 0.5, "stun")
endif
call GroupRemoveUnit(G,E)
endloop
else
call SaveReal(h,id,6,dist+1)
endif
elseif time>=2 and time<3.5 then
call SetUnitTimeScale(u,0.27)
call SaveReal(h,id,4,sc*1.027)
call GroupEnumUnitsInRange(g,x,y,80*(sc-5),Base)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
exitwhen E==null
if Condition_Base(p,E) and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg2,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
call SetControlToUnit(E,E, 0.8, "stun")
call Push3(E,50,Atan2(GetUnitY(E)-y,GetUnitX(E)-x),200,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
elseif Condition_Base(p,E) then
call Push3(E,50,Atan2(GetUnitY(E)-y,GetUnitX(E)-x),200,"Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
call SetControlToUnit(E,E, 0.8, "stun")
endif
call GroupRemoveUnit(g,E)
endloop
call SetUnitScale(LoadUnitHandle(h,id,8),sc-4,sc-4,sc-4)
if dist>=3 then
set n=CreateUnit(p,'e0B2',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',.02)
call SetUnitScale(n,sc-6.3,sc-6.3,sc-6.3)
call SetUnitVertexColor(n,250,255,255,30)
call SaveReal(h,id,6,0)
endif
set n=CreateUnit(p,'e0IT',x,y,GetRandomReal(0,359))
call SetUnitScale(n,sc-6,sc-6,sc-6)
call SetUnitVertexColor(n,250,225,100,170)
call SetUnitTimeScale(n,3)
call UnitApplyTimedLife(n,'BTLF',.25)
call SetUnitVertexColor(LoadUnitHandle(h,id,8),250,120,100,R2I(210/(sc*0.08)))
call SaveReal(h,id,6,dist+1)
endif
if time>=3.5 then
call SetUnitFlyHeight(u,0,0)
call DestroyGroup(g)
call RemoveUnit(LoadUnitHandle(h,id,8))
call RemoveUnit(LoadUnitHandle(h,id,9))
call DestroyTimer(t)
call SetUnitTimeScale(u,1)
call SetUnitAnimation(u,"stand")
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,idg)
endif
set g=null
set u=null
set t=null
set p=null
endfunction
function AndroidBarrierCast takes nothing returns nothing
local unit u=GetSpellAbilityUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=0
local real y1=0
local real a=0
local player p=GetOwningPlayer(u)
local group g=CreateGroup()
call SaveReal(h,id,2,x)
call SaveReal(h,id,3,y)
set n=CreateUnit(p,'e0VA',x,y,0)
call SetUnitVertexColor(n,250,50,120,10)
call SaveReal(h,id,4,2.2)
call SaveReal(h,id,5,0.002)
call SetUnitScale(n,3.,3.,3.)
call SaveUnitHandle(h,id,8,n)
set n=CreateUnit(p,'e0VA',x,y,0)
call SetUnitVertexColor(n,250,50,120,8)
call UnitApplyTimedLife(n,'BTLF',2)
call SaveUnitHandle(h,id,9,n)
call SaveReal(h,id,6,3)
call SaveReal(h,id,7,0)
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(2162) // Sound\Music\mp3Music\PerfectBarrier.mp3
else
set soundplay=SndN(2165) // Sound\Music\mp3Music\Perfect Cell\PerfectBarrier-jap.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SetUnitTimeScale(u,0.04)
call SetUnitInvulnerable(u,true)
call PauseUnit(u,true)
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,1,g)
call SetUnitAnimation(u,"spell slam")
call TimerStart(t,.05,true,function AndroidBarrierCast2)
set p=null
set u=null
set t=null
endfunction
function SuperKamehamehaCond takes nothing returns boolean
return GetSpellAbilityId()=='A106' and udg_B==true
endfunction
function SuperKamehamehaCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,12)
local real speed=40
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=LoadReal(h,id,5)
local real y1=LoadReal(h,id,6)
local real a=Atan2(y1-y,x1-x)
local real dist=LoadReal(h,id,11)
local real mh=425
local real rd=SR(x,y,x1,y1)
local real dmg=LoadReal(h,id,4)
local player p=GetOwningPlayer(l__d)
local integer idu=GetPlayerId(p)
local real cof=rd/dist
local real sc=LoadReal(h,id,10)
local real hei=0
if rd>30+speed and udg_B==true and DU2==true then
call SetUnitX(l__d,x+30*Cos(a))
call SetUnitY(l__d,y+30*Sin(a))
call SetUnitFacing(l__d,a*bj_RADTODEG)
set hei=mh*cof+50
set n=CreateUnit(p,'e0CT',x,y,a*bj_RADTODEG)
call SetUnitScale(n,sc+5,sc+5,sc+5)
call UnitApplyTimedLife(n,'BTLF',1.5)
call SetUnitFlyHeight(n,hei,0)
call SetUnitFlyHeight(l__d,hei,0)
call UnitAddAbility(u,'A107')
call UnitRemoveAbility(u,'A107')
else
call GroupEnumUnitsInRange(DG,x1,y1,700,Base)
loop
set E=FirstOfGroup(DG)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 2, "stun")
endif
call GroupRemoveUnit(DG,E)
endloop
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call SetUnitFlyHeight(u,0,350)
set n=CreateUnit(p,'e0C4',x,y,(a*bj_RADTODEG))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitScale(n,4.5,4.5,4.5)
set n=CreateUnit(p,'e0C5',x,y,(a*bj_RADTODEG))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitScale(n,4.5,4.5,4.5)
set n=CreateUnit(p,'e0CC',x,y,(a*bj_RADTODEG))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitScale(n,2.25,2.25,2.25)
set n=CreateUnit(p,'e0CD',x,y,(a*bj_RADTODEG))
call UnitApplyTimedLife(n,'BTLF',3)
call SetUnitScale(n,3,3,3)
set n=CreateUnit(p,'e0C6',x,y,(a*bj_RADTODEG))
call UnitApplyTimedLife(n,'BTLF',4)
call SetUnitScale(n,1.5,1.5,1.5)
set n=CreateUnit(p,'e0C7',x,y,(a*bj_RADTODEG))
call UnitApplyTimedLife(n,'BTLF',6)
call SetUnitScale(n,0.375,0.375,0.375)
call StartSound(soundStr[47])
call RemoveUnit(l__d)
//call UnitRemoveAbility(u,'A0NP')
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set l__d=null
set t=null
    set u=null
endfunction
function CellKamehamehaStopOrders2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
call IssueImmediateOrder(u,"stop")
call SetUnitAnimation(u,"Cinematic Channel")
call SetUnitFacing(u,Atan2(LoadReal(h,id,1)-GetUnitY(u),LoadReal(h,id,2)-GetUnitX(u))*bj_RADTODEG)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
set t=null
set u=null
endfunction
function CellKamehamehaStopOrders takes nothing returns nothing
local unit u=GetOrderedUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
if GetOrderTargetUnit()==null then
call SaveReal(h,id,2,GetOrderPointX())
call SaveReal(h,id,1,GetOrderPointY())
call SaveReal(h,GetHandleId(GetTriggeringTrigger()), SH_PointX, GetOrderPointX())
call SaveReal(h,GetHandleId(GetTriggeringTrigger()), SH_PointY, GetOrderPointY())
else
call SaveReal(h,id,2,GetUnitX(GetOrderTargetUnit()))
call SaveReal(h,id,1,GetUnitY(GetOrderTargetUnit()))
call SaveReal(h,GetHandleId(GetTriggeringTrigger()), SH_PointX, GetUnitX(GetOrderTargetUnit()))
call SaveReal(h,GetHandleId(GetTriggeringTrigger()), SH_PointY, GetUnitY(GetOrderTargetUnit()))
endif
if SquareRootPoint(GetUnitX(u), GetUnitY(u), LoadReal(h,id,2), LoadReal(h,id,1))>2000 then
        call SaveReal(h,GetHandleId(GetTriggeringTrigger()), SH_PointX, GetUnitX(u)+2000*Cos(AP(GetUnitX(u), GetUnitY(u), LoadReal(h,id,2), LoadReal(h,id,1))))
        call SaveReal(h,GetHandleId(GetTriggeringTrigger()), SH_PointY, GetUnitY(u)+2000*Sin(AP(GetUnitX(u), GetUnitY(u), LoadReal(h,id,2), LoadReal(h,id,1))))
endif
call TimerStart(t,0.001,false,function CellKamehamehaStopOrders2)
set u=null
set t=null
endfunction

function SuperKamehamehaCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,5)
local real y1=LoadReal(h,id,6)
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
local real dmg=LoadReal(h,id,4)
local real dist=LoadReal(h,id,2)
local real scale=LoadReal(h,id,10)
local real mdist=LoadReal(h,id,12)
local real time=LoadReal(h,id,13)+0.1
local real tm=GetWidgetMana(u)
local real deg=75*bj_DEGTORAD
local trigger tt=LoadTriggerHandle(h, id, SH_OrderTrigger)
if time<=4 then
        call SetControlToUnit(u, u, 0.13, "doomdebug")
        set n=CreateUnit(p,'e0B2',x,y,GetRandomReal(0,359))
        call SetUnitScale(n,0.5,0.5,0.5)
        call UnitApplyTimedLife(n,'BTLF',0.01)
        call SetUnitVertexColor(n,40,150,255,70)
        call SetUnitFlyHeight(n,350,0)
        set n=CreateUnit(p,'e0B2',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',0.01)
        call SetUnitVertexColor(n,40,150,255,60)
        call SetUnitScale(n,1,1,1)
        call SetUnitFlyHeight(n,350,0)
        set n=CreateUnit(p,'e0B2',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',0.01)
        call SetUnitVertexColor(n,40,150,255,50)
        call SetUnitFlyHeight(n,350,0)
        call SetUnitScale(n,1.5,1.5,1.5)
        set n=CreateUnit(p,'e0B2',x,y,GetRandomReal(0,359))
        call UnitApplyTimedLife(n,'BTLF',0.01)
        call SetUnitVertexColor(n,40,150,255,40)
        call SetUnitFlyHeight(n,350,0)
        call SetUnitScale(n,2,2,2)
        call SetUnitX(l__d,x+mdist*Cos(a-deg))
        call SetUnitY(l__d,y+mdist*Sin(a-deg))
        call SaveReal(h,id,10,scale+0.007)
        call SaveReal(h,id,12,mdist+1)
        call SetUnitScale(l__d,scale,scale,scale)
        call UnitAddAbility(u,'A107')
        call UnitRemoveAbility(u,'A107')
        call SaveReal(h,id,13,time)
        call SaveReal(h, id, 5, LoadReal(h, GetHandleId(tt), SH_PointX))
        call SaveReal(h, id, 6, LoadReal(h, GetHandleId(tt), SH_PointY))
else
        call SaveReal(h, id, 5, LoadReal(h, GetHandleId(tt), SH_PointX))
        call SaveReal(h, id, 6, LoadReal(h, GetHandleId(tt), SH_PointY))
        call PauseUnit(u,true)
        call SetUnitInvulnerable(u,true)
        call SaveReal(h,id,11,SR(x,y,x1,y1))
        call SetUnitTimeScale(u,1)
        call SetUnitX(l__d,x+100*Cos(a))
        call SetUnitY(l__d,y+100*Sin(a))
        call RemoveUnit(l__d)
        set n=CreateUnit(p,'e0R6',x+35*Cos(a),y+35*Sin(a),a*bj_RADTODEG)
        call SetUnitScale(n,scale+1.5,scale+1.5,scale+1.5)
        call SaveUnitHandle(h,id,12,n)
        call SetUnitAnimation(u,"Cinematic Throw")
        call SetUnitScale(l__d,0.8,0.8,0.8)
        call PauseTimer(t)
        call TimerStart(t,0.02,true,function SuperKamehamehaCast3)
        call FlushChildHashtable(h, GetHandleId(tt))
        call TriggerClearActions(tt)
        call DestroyTrigger(tt)
        call SetUnitAcquireRange(u, 600)
        call UnitRemoveAbility(u, 'A1FU')
    call UnitRemoveAbility(u,'Pet1')
        call UnitRemoveAbility(u,'B00A')
        call UnitRemoveAbility(u,'B02Z')
endif
set l__d=null
set p=null
set u=null
set t=null
set tt=null
endfunction
function SuperKamehamehaCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local real ang=120*bj_DEGTORAD
local trigger tt=CreateTrigger()
if SR(x,y,x1,y1)<600 then
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
set x=x-600*Cos(a)
set y=y-600*Sin(a)
call SetUnitXY_1(u,x,y, false)
call DestroyEffect(AddSpecialEffect("war3mapImported\\BlackBlink.mdx",x,y))
endif
call SetUnitFlyHeight(u,350,0)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,5,x1)
call SaveReal(h,id,6,y1)
call SaveReal(h,id,4,(GetUnitAbilityLevel(u,'A106')+5)*GetHeroInt(u,true))
call SaveReal(h,id,2,2700)
call SaveReal(h,id,10,0.05)
call SaveReal(h,id,11,a)
call SaveReal(h,id,12,55)
call SaveReal(h,id,13,0)
call SetUnitTimeScale(u,0.2)
call SaveGroupHandle(h,id,12,CreateGroup())
call SetUnitInvulnerable(u,true)
call PauseUnit(u,false)
call SetUnitAcquireRange(u, 51)
call UnitAddAbility(u, 'A1FU')
call UnitAddAbility(u,'Pet1')
call SetUnitAnimation(u,"Cinematic Channel")
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(2194) // Sound\Music\mp3Music\CellSuperKamehameha.mp3
else
set soundplay=SndN(2196) // Sound\Music\mp3Music\Perfect Cell\CellSuperKamehameha-jap.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
set n=CreateUnit(p,0x6530425A,x+75*Cos(a-ang),y+75*Sin(a-ang),a*bj_RADTODEG)
call SaveUnitHandle(h,id,7,n)
call SetUnitVertexColor(n,125,200,255,180)
call SetUnitFlyHeight(n,425,0)
//call UnitAddAbility(u,'A0NP')
call TimerStart(t,0.1,true,function SuperKamehamehaCast2)
call SaveTriggerHandle(h, id, SH_OrderTrigger, tt)
call SaveReal(h,GetHandleId(tt), SH_PointX, GetSpellTargetX())
call SaveReal(h,GetHandleId(tt), SH_PointY, GetSpellTargetY())
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_POINT_ORDER)
call TriggerAddAction(tt,function CellKamehamehaStopOrders)
set u=null
set p=null
set t=null
set tt=null
endfunction
function GulickGunCond takes nothing returns boolean
return GetSpellAbilityId()=='A104'
endfunction
function CastGulickGun2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real a=LoadReal(h,id,4)
local real dist=LoadReal(h,id,10)
local real x=GetUnitX(l__d)+40*Cos(a)
local real y=GetUnitY(l__d)+40*Sin(a)
local real dmg=(2+GetUnitAbilityLevel(u,'A104'))*GetHeroInt(u,true)+75
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,3)
local real time=LoadReal(h,id,5)
if time<0.8 then
call SaveReal(h,id,5,time+0.017)
if time==0.799 then
call UnitAddAbility(u,'A107')
call UnitRemoveAbility(u,'A107')
call SetUnitInvulnerable(u,false)
call PauseUnit(u,false)
call SetUnitTimeScale(u,1)
set n=CreateUnit(GetOwningPlayer(u),'e0PP',GetUnitX(u)+35*Cos(a),GetUnitY(u)+35*Sin(a),a*bj_RADTODEG)
call SetUnitFlyHeight(n,90,0)
call SaveUnitHandle(h,id,1,n)
call SetUnitScale(n,0.3,0.3,0.3)
endif
else
if dist>0 and IsTerrainPathable(GetUnitX(l__d),GetUnitY(l__d),PATHING_TYPE_FLYABILITY)==false then
call SetUnitXY_1(l__d,x,y, false)
set n=CreateUnit(p,0x6530595A,x,y,a*bj_RADTODEG)
call SetUnitTimeScale(n,0)
call SetUnitFlyHeight(n,90,0)
call UnitApplyTimedLife(n,'BTLF',1)
call GroupEnumUnitsInRange(g,x,y,150,Base)
set idg=GetHandleId(g)
call SaveReal(h,id,10,dist-40)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
else
call GroupEnumUnitsInRange(g,x,y,400,Base)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
call ShakeCamera(0.5,20)
call UnitApplyTimedLife(CreateUnit(p,'e0NJ',x,y,GetRandomReal(0,359)),'BTLF',3)
//call UnitApplyTimedLife(CreateUnit(p,'e0NK',x,y,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0NI',x,y,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0NL',x,y,GetRandomReal(0,359)),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,'e0NM',x,y,GetRandomReal(0,359)),'BTLF',3)
call StartSound(soundStr[47])
call RemoveUnit(l__d)
call FlushChildHashtable(h,GetHandleId(g))
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
endif
set g=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
function CastGulickGun takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local player p=GetOwningPlayer(u)
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,3,CreateGroup())
call SaveReal(h,id,4,a)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
call SaveReal(h,id,10,3500)
call SetUnitTimeScale(u,0.7)
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then
set soundplay=SndN(2198) // Sound\Music\mp3Music\Cell Special Beam Cannon.mp3
else
set soundplay=SndN(2200) // Sound\Music\mp3Music\Perfect Cell\Cell Special Beam Cannon-jap.mp3
endif
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SetUnitAnimation(u,"Spell Swim Two")
call UnitAddAbility(u,'A107')
call UnitRemoveAbility(u,'A107')
call TimerStart(t,0.017,true,function CastGulickGun2)
set u=null
set p=null
set t=null
endfunction
function LightningOrbCond takes nothing returns boolean
return GetSpellAbilityId()=='A10M' and udg_B
endfunction
function LightningOrbCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local group g=LoadGroupHandle(h,id,5)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real x2
local real y2
local real f=GetUnitFacing(l__d)
local real a=Atan2(y-y1,x-x1)
local real a2
local player p=GetOwningPlayer(u)
local real dmg=3*GetHeroInt(u,true)
local integer lvl=2+GetUnitAbilityLevel(u,'A10M')
local boolean b=LoadBoolean(h,id,8)
local real time=LoadReal(h,id,7)
local real tim=LoadReal(h,id,9)
if SR(x,y,x1,y1)>80 then
        call SetUnitX(l__d,x1+110*Cos(a))
        call SetUnitY(l__d,y1+110*Sin(a))
elseif time<lvl then
        if b==false then
                call SaveBoolean(h,id,8,true)
                call SetUnitScale(l__d,5,5,5)
                call SetUnitFlyHeight(l__d,250,0)
        endif
        call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\FarseerMissile\\FarseerMissile.mdl",x+GetRandomReal(-475,475),y+GetRandomReal(-475,475)))
        call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\FarseerMissile\\FarseerMissile.mdl",x+GetRandomReal(-475,475),y+GetRandomReal(-475,475)))
        call SaveReal(h,id,9,tim+0.06)
        call SaveReal(h,id,7,time+0.06)
        if tim>1 then
                call GroupEnumUnitsInRange(G,x1,y1,1000,Base)
                set n=CreateUnit(p,'e0QI',x1,y1,GetRandomReal(0,359))
                call UnitApplyTimedLife(n,'BTLF',0.01)
                call SetUnitScale(n,0.5,0.5,0.5)
                call SetUnitVertexColor(n,255,255,255,200)
                set n=CreateUnit(p,'e0QI',x1,y1,GetRandomReal(0,359))
                call UnitApplyTimedLife(n,'BTLF',0.01)
                call SetUnitScale(n,1,1,1)
                call SetUnitVertexColor(n,255,255,255,150)
                call SaveReal(h,id,9,0)
                loop
                set E=FirstOfGroup(G)
                exitwhen E==null
                if Condition_Base(p,E)then
                        call myCustomDamage(u,E,dmg,false,false,null,null,null)
                        call SetControlToUnit(E,E, 0.65, "stun")
                endif
                call GroupRemoveUnit(G,E)
                endloop
        endif
elseif time>lvl then
        call FlushChildHashtable(h,id)
        call DestroyTimer(t)
        call DestroyGroup(g)
        call RemoveUnit(l__d)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
function LightningOrbCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real f=GetUnitFacing(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real a=Atan2(GetSpellTargetY()-y,GetSpellTargetX()-x)
set n=CreateUnit(GetOwningPlayer(u),'e0VH',x+80*Cos(a),y+80*Sin(a),f)
call SetUnitScale(n,1,1,1)
call SetUnitFlyHeight(n,75,0)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,1,n)
call SaveReal(h,id,2,GetSpellTargetX())
call SaveReal(h,id,3,GetSpellTargetY())
call SaveReal(h,id,5,a)
call SaveGroupHandle(h,id,5,CreateGroup())
call SaveReal(h,id,7,0)
call SaveReal(h,id,9,0)
call SaveBoolean(h,id,8,false)
if GetUnitTypeId(u)=='H053' then
set soundplay=SndN(2202) // Sound\Music\mp3Music\LouiseLightningOrb.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
set soundplay=SndN(2204) // Sound\Music\mp3Music\RMomonga.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call TimerStart(t,0.06,true,function LightningOrbCast2)
set u=null
set t=null
set d=null
endfunction
