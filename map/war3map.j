    return BaseSkinPetCond(P) or GetPlayerName(P)=="KamaBr" or GetPlayerName(P)=="[OSV] Kama" or GetPlayerName(P)=="Annieh" or GetPlayerName(P)=="zld6334" or GetPlayerName(P)=="Sylphiette" or GetPlayerName(P)=="AkazaThree" or GetPlayerName(P)=="Alastart" or GetPlayerName(P)=="Denamesh" or GetPlayerName(P)=="PIROMANI9K" or GetPlayerName(P)=="Chevalier" or GetPlayerName(P)=="offstay" or GetPlayerName(P)=="PrideEnvy" or GetPlayerName(P)=="SerLanse" or GetPlayerName(P)=="Antitilt" or GetPlayerName(P)=="dadadacer777" or GetPlayerName(P)=="lzphae"
endfunction
function SUS2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(HH,id,0)
    local integer ip=GetPlayerId(GetOwningPlayer(u))
    local unit l__d=LoadUnitHandle(HH,StringHash(I2S(ip)),1)
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=GetUnitX(l__d)
    local real y1=GetUnitY(l__d)
    local real time=LoadReal(HH,id,2)
    call SaveReal(HH,id,2,time+0.1)
    if CheckUnitInvisible(u) then
        call UnitAddAbility(l__d,'Ao7S')
    else
        call UnitRemoveAbility(l__d,'Ao7S')
    endif
    if UnitIsAlive(l__d)then
    if SR(x,y,x1,y1)>400 then
    call IssuePointOrder(l__d,"move",x+GetRandomReal(-300,300),y+GetRandomReal(-300,300))
    endif
    if SR(x,y,x1,y1)>1000 and UnitIsAlive(u)  then
    call SetUnitPosition(l__d,x+GetRandomReal(-300,300),y+GetRandomReal(-300,300))
    endif
    if time>12 then
    call IssuePointOrder(l__d,"move",x+GetRandomReal(-300,300),y+GetRandomReal(-300,300))
    call SaveReal(HH,id,2,0)
    endif
    else
    call PauseTimer(t)
    call DestroyTimer(t)
    call FlushChildHashtable(HH,id)
    call RemoveUnit(l__d)
    endif
    set u=null
    set t=null
    set l__d=null
endfunction
function SUS takes nothing returns nothing
    local integer ip=GetPlayerId(GetTriggerPlayer())
    local timer t=CreateTimer()
    local integer id=GetHandleId(t)
    local unit l__d=LoadUnitHandle(HH,StringHash(I2S(ip)),1)
    if l__d==null then
    call SaveUnitHandle(HH,id,0,Hero[ip])
    call SaveReal(HH,id,2,0)
    call SaveUnitHandle(HH,StringHash(I2S(ip)),1,CreateUnit(GetOwningPlayer(Hero[ip]),'e25J',GetUnitX(Hero[ip])+GetRandomReal(-100,100),GetUnitY(Hero[ip])+GetRandomReal(-100,100),GetRandomReal(6.28,0)))
    call TimerStart(t,0.1,true,function SUS2)
    else
    call KillUnit(l__d)
    endif
    set l__d=null
    set t=null
endfunction
