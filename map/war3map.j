set n=LoadUnitHandle(HH,idu,str+2)
if UnitIsAlive(n)then
call SetUnitVertexColor(n,255,255,255,0)
call SetUnitFlyHeight(n,5000,0)
endif
set n=LoadUnitHandle(HH,idu,str+3)
if UnitIsAlive(n)then
call SetUnitVertexColor(n,255,255,255,0)
call SetUnitFlyHeight(n,5000,0)
endif
