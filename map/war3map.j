function Trig_KingOfHill_Enter_Actions takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local integer TotalPlayerCount=0
local integer MaxPoints=3000
local framehandle TeamText=null
local integer i=0
local integer j=0
if FFAMode==false then
    set TeamCount[0]=0
    set TeamCount[1]=0
    call GroupEnumUnitsInRect(G, gg_rct_KingOfHillRect, Base)
    loop
        set E=FirstOfGroup(G)
        exitwhen E==null
        if E==Hero[GetPlayerId(GetOwningPlayer(E))] and IsUnitType(E,UNIT_TYPE_HERO) then
            if GetPlayerId(GetOwningPlayer(E))>4 then
                set TeamCount[1]=TeamCount[1]+1
            else
                set TeamCount[0]=TeamCount[0]+1
            endif
        endif
        call GroupRemoveUnit(G,E)
    endloop
    set TeamPoints[0]=TeamPoints[0]+TeamCount[0]*5
    set TeamPoints[1]=TeamPoints[1]+TeamCount[1]*5
    if TeamCount[1]>TeamCount[0] then
        call SetSpecialEffectVertexColour(KingOfHill,50,50,255,255)
        set TeamPoints[1]=TeamPoints[1]+10
        set TeamCount[1]=TeamCount[1]+2
    elseif TeamCount[0]>TeamCount[1] then
        call SetSpecialEffectVertexColour(KingOfHill,255,50,50,255)
        set TeamPoints[0]=TeamPoints[0]+10
        set TeamCount[0]=TeamCount[0]+2
    elseif TeamCount[0]==TeamCount[1] then
        call SetSpecialEffectVertexColour(KingOfHill,255,255,255,255)
    endif
    if LoadFrameHandle(HH, id,0)==null then
        set TeamBar[0] = CreateFrameByType( "SPRITE", "HPBar", KingOfHillContainer, "", 0 )
        call ClearFrameAllPoints( TeamBar[0] )
        call SetFrameSize( TeamBar[0], .0002, .0002 )
        call SetFrameSpriteModel( TeamBar[0], "HPbar1.mdx" )
        call SetFrameSpriteOrientation( TeamBar[0], 0., 90, 90. )
        call SetFrameSpriteColour( TeamBar[0], Colour[0] )
        call SetFrameSpriteScale( TeamBar[0], .0016)
        call SetFramePriority( TeamBar[0], 6 )
        call SetFrameSpriteAnimation(TeamBar[0],"birth")
        //call TriggerSleepAction(0.001)
        call SetFrameSpriteTimeScale(TeamBar[0],0)
        call SaveFrameHandle(HH,id,0,TeamBar[0])
        set TeamText=CreateFrameByType( "TEXT", "Team0", TeamBar[0], "", 0 )
        call ClearFrameAllPoints( TeamText )
        call SetFrameBlendMode( TeamText, 0, BLEND_MODE_BLEND )
        call SetFrameFont( TeamText, "Fonts\\FRIZQT__.TTF", .011, 0 )
        call SetFrameTextAlignment( TeamText, TEXT_JUSTIFY_CENTER, TEXT_JUSTIFY_CENTER )
        call SetFrameText( TeamText, I2S(TeamPoints[0])+"(+"+I2S(TeamCount[0]*5)+") / "+I2S(MaxPoints) )
        call SetFrameTextColour( TeamText, ConvertColour(255,255,255,0) )
        call SaveFrameHandle(HH,id,1,TeamText)
    else
        set TeamText=LoadFrameHandle(HH,id,1)
        call SetFrameSpriteAnimationOffsetPercent(TeamBar[0],I2R(TeamPoints[0]) / I2R(MaxPoints))
        call SetFrameText( TeamText, I2S(TeamPoints[0])+"(+"+I2S(TeamCount[0]*5)+") / "+I2S(MaxPoints) )
    endif
    if LoadFrameHandle(HH, id,2)==null then
        set TeamBar[1] = CreateFrameByType( "SPRITE", "HPBar", KingOfHillContainer, "", 1 )
        call ClearFrameAllPoints( TeamBar[1] )
        call SetFrameSize( TeamBar[1], .0002, .0002 )
        call SetFrameSpriteModel( TeamBar[1], "HPbar1.mdx" )
        call SetFrameSpriteOrientation( TeamBar[1], 0., 90, 90. )
        call SetFrameSpriteColour( TeamBar[1], Colour[1] )
        call SetFrameSpriteScale( TeamBar[1], .0016)
        call SetFramePriority( TeamBar[1], 6 )
        call SetFrameSpriteAnimation(TeamBar[1],"birth")
        //call TriggerSleepAction(0.001)
        call SetFrameSpriteTimeScale(TeamBar[1],0)
        call SaveFrameHandle(HH,id,2,TeamBar[1])
        set TeamText=CreateFrameByType( "TEXT", "Team1", TeamBar[1], "", 0 )
        call ClearFrameAllPoints( TeamText )
        call SetFrameBlendMode( TeamText, 0, BLEND_MODE_BLEND )
        call SetFrameFont( TeamText, "Fonts\\FRIZQT__.TTF", .011, 0 )
        call SetFrameTextAlignment( TeamText, TEXT_JUSTIFY_CENTER, TEXT_JUSTIFY_CENTER )
        call SetFrameText( TeamText, I2S(TeamPoints[1])+"(+"+I2S(TeamCount[1]*5)+") / "+I2S(MaxPoints) )
        call SetFrameTextColour( TeamText, ConvertColour(255,255,255,0) )
        call SaveFrameHandle(HH,id,3,TeamText)
    else
        set TeamText=LoadFrameHandle(HH,id,3)
        call SetFrameSpriteAnimationOffsetPercent(TeamBar[1],I2R(TeamPoints[1]) / I2R(MaxPoints))
        call SetFrameText( TeamText, I2S(TeamPoints[1])+"(+"+I2S(TeamCount[1]*5)+") / "+I2S(MaxPoints) )
    endif
    call SetFrameRelativePoint( TeamBar[0], FRAMEPOINT_CENTER, KingOfHillContainer, FRAMEPOINT_TOP, 0, -.01 )
    call SetFrameRelativePoint( TeamBar[1], FRAMEPOINT_CENTER, KingOfHillContainer, FRAMEPOINT_TOP, 0, -.0265 )
    call SetFrameRelativePoint( LoadFrameHandle(HH,id,1), FRAMEPOINT_CENTER, TeamBar[0], FRAMEPOINT_CENTER, 0, 0 )
    call SetFrameRelativePoint( LoadFrameHandle(HH,id,3), FRAMEPOINT_CENTER, TeamBar[1], FRAMEPOINT_CENTER, 0, 0 )
    if TeamPoints[0]!=TeamPoints[1] then
        if TeamPoints[0]>=MaxPoints and TeamPoints[0]>TeamPoints[1] then
            set i=5
            loop
            exitwhen i>10
            call KillUnit(Hero[i])
            set i=i+1
            endloop
        endif
        if TeamPoints[1]>=MaxPoints and TeamPoints[1]>TeamPoints[0] then
            loop
            exitwhen i>5
            call KillUnit(Hero[i])
            set i=i+1
            endloop
        endif
    elseif TeamPoints[0]==TeamPoints[1] and TeamPoints[0]>=MaxPoints then
        set TC=true
        loop
        exitwhen i>10
        call KillUnit(Hero[i])
        set i=i+1
        endloop
    endif
else
    set i=0
    loop
    set TeamCount[i]=0
    set i=i+1
    exitwhen i>9
    endloop
    call GroupEnumUnitsInRect(G, gg_rct_KingOfHillRect, Base)
    loop
        set E=FirstOfGroup(G)
        exitwhen E==null
        if E==Hero[GetPlayerId(GetOwningPlayer(E))] and IsUnitType(E,UNIT_TYPE_HERO) then
            set TeamCount[GetPlayerId(GetOwningPlayer(E))]=TeamCount[GetPlayerId(GetOwningPlayer(E))]+1
            set TotalPlayerCount=TotalPlayerCount+1
        endif
        call GroupRemoveUnit(G,E)
    endloop
    set i=0
    loop
    set TeamPoints[i]=TeamPoints[i]+TeamCount[i]*5
    set i=i+1
    exitwhen i>9
    endloop
    
    if TotalPlayerCount==1 then
        set i=0
        loop
            if TeamCount[i]>0 then
                call SetSpecialEffectColour(KingOfHill,Colour[i])
                set TeamPoints[i]=TeamPoints[i]+10
                set TeamCount[i]=TeamCount[i]+2
            endif
            set i=i+1
        exitwhen i>9
        endloop
    elseif TotalPlayerCount!=1 then
        call SetSpecialEffectVertexColour(KingOfHill,255,255,255,255)
    endif

    set i=0
    set j=0
    loop
        if TeamBar[j]==null then
            set TeamBar[j] = CreateFrameByType( "SPRITE", "HPBar", KingOfHillContainer, "", j )
            call ClearFrameAllPoints( TeamBar[j] )
            call SetFrameSize( TeamBar[j], .0002, .0002 )
            call SetFrameSpriteModel( TeamBar[j], "HPbar1.mdx" )
            call SetFrameSpriteOrientation( TeamBar[j], 0., 90, 90. )
            call SetFrameSpriteColour( TeamBar[j], Colour[j] )
            call SetFrameSpriteScale( TeamBar[j], .0016)
            call SetFramePriority( TeamBar[j], 6 )
            call SetFrameSpriteAnimation(TeamBar[j],"birth")
            //call TriggerSleepAction(0.001)
            call SetFrameSpriteTimeScale(TeamBar[j],0)
            call SaveFrameHandle(HH,id,i,TeamBar[j])
            set TeamText=CreateFrameByType( "TEXT", "Team"+I2S(j), TeamBar[j], "", 0 )
            call ClearFrameAllPoints( TeamText )
            call SetFrameBlendMode( TeamText, 0, BLEND_MODE_BLEND )
            call SetFrameFont( TeamText, "Fonts\\FRIZQT__.TTF", .011, 0 )
            call SetFrameTextAlignment( TeamText, TEXT_JUSTIFY_CENTER, TEXT_JUSTIFY_CENTER )
            call SetFrameText( TeamText, I2S(TeamPoints[j])+"(+"+I2S(TeamCount[j]*5)+") / "+I2S(MaxPoints) )
            call SetFrameTextColour( TeamText, ConvertColour(255,255,255,0) )
            call SaveFrameHandle(HH,id,i+1,TeamText)
        else
            set TeamText=LoadFrameHandle(HH,id,i+1)
            call SetFrameSpriteAnimationOffsetPercent(TeamBar[j],I2R(TeamPoints[j]) / I2R(MaxPoints))
            call SetFrameText( TeamText, I2S(TeamPoints[j])+"(+"+I2S(TeamCount[j]*5)+") / "+I2S(MaxPoints) )
        endif
        call SetFrameRelativePoint( TeamBar[j], FRAMEPOINT_CENTER, KingOfHillContainer, FRAMEPOINT_TOP, 0, -.01-j*0.0165 )
        call SetFrameRelativePoint( LoadFrameHandle(HH,id,i+1), FRAMEPOINT_CENTER, TeamBar[j], FRAMEPOINT_CENTER, 0, 0 )
        set i=i+2
        set j=j+1
    exitwhen i>18
    endloop

    set i=0
    loop
        if TeamPoints[i]>=MaxPoints and TeamCount[i]>1 then
            set j=0
            loop
            exitwhen j>10
            if Hero[j]!=Hero[i] then
                call KillUnit(Hero[j])
            endif
            set j=j+1
            endloop
        endif
        set i=i+1
    exitwhen i>9
    endloop
endif
set TeamText=null
set t=null
endfunction
function InitTrig_KingOfHill_Enter takes nothing returns nothing
set gg_trg_KingOfHill_Enter=CreateTrigger()
call TriggerRegisterTimerEvent(gg_trg_KingOfHill_Enter,0.5,true)
call TriggerAddAction(gg_trg_KingOfHill_Enter,function Trig_KingOfHill_Enter_Actions)
endfunction
function Trig_Fountain_Enter_Actions takes nothing returns nothing
local integer TotalPlayerCount=0
local integer i=0
if FFAMode==false then
    set TeamCountFountain[0]=0
    set TeamCountFountain[1]=0
    call GroupEnumUnitsInRect(G, gg_rct_FountainRect, Base)
    loop
        set E=FirstOfGroup(G)
        exitwhen E==null
        if E==Hero[GetPlayerId(GetOwningPlayer(E))] and IsUnitType(E,UNIT_TYPE_HERO) then
            if GetPlayerId(GetOwningPlayer(E))>4 then
                set TeamCountFountain[1]=TeamCountFountain[1]+1
            else
                set TeamCountFountain[0]=TeamCountFountain[0]+1
            endif
        endif
        call GroupRemoveUnit(G,E)
    endloop
    if TeamCountFountain[1]>TeamCountFountain[0] then
        call SetSpecialEffectVertexColour(Fountain,50,50,255,255)
        call SetUnitOwner(FountainUnit,Player(5),false)
    elseif TeamCountFountain[0]>TeamCountFountain[1] then
        call SetSpecialEffectVertexColour(Fountain,255,50,50,255)
        call SetUnitOwner(FountainUnit,Player(0),false)
    elseif TeamCountFountain[0]==TeamCountFountain[1] then
        call SetSpecialEffectVertexColour(Fountain,255,255,255,255)
        call SetUnitOwner(FountainUnit,Player(PLAYER_NEUTRAL_PASSIVE),false)
    endif
else
    set i=0
    loop
    set TeamCountFountain[i]=0
    set i=i+1
    exitwhen i>9
    endloop
    call GroupEnumUnitsInRect(G, gg_rct_FountainRect, Base)
    loop
        set E=FirstOfGroup(G)
        exitwhen E==null
        if E==Hero[GetPlayerId(GetOwningPlayer(E))] and IsUnitType(E,UNIT_TYPE_HERO) then
            set TeamCountFountain[GetPlayerId(GetOwningPlayer(E))]=TeamCountFountain[GetPlayerId(GetOwningPlayer(E))]+1
            set TotalPlayerCount=TotalPlayerCount+1
        endif
        call GroupRemoveUnit(G,E)
    endloop
    
    if TotalPlayerCount==1 then
        set i=0
        loop
            if TeamCountFountain[i]>0 then
                call SetSpecialEffectColour(Fountain,Colour[i])
                call SetUnitOwner(FountainUnit,Player(i),false)
            endif
            set i=i+1
        exitwhen i>9
        endloop
    elseif TotalPlayerCount!=1 then
        call SetSpecialEffectVertexColour(Fountain,255,255,255,255)
        call SetUnitOwner(FountainUnit,Player(PLAYER_NEUTRAL_PASSIVE),false)
    endif
endif
endfunction
