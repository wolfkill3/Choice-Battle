    local real x=GetUnitX(u)
    local real y=GetUnitY(u)
    local real x1=LoadReal(h,id,1)
    local real y1=LoadReal(h,id,2)
    local group g1=LoadGroupHandle(h,id,14)
    local real x2=0
    local real y2=0
    local real time=LoadReal(h,id,3)
    local boolean b=LoadBoolean(h,id,6)
    local real sc=0
    local integer i=1
    local group g=LoadGroupHandle(h,id,4)
    local real dmg=GetHeroInt(u,true)*(1+GetUnitAbilityLevel(u,'ore8'))
    local real a=LoadReal(h,id,5)
    local player p=GetOwningPlayer(u)
    call SaveReal(h,id,3,time+0.1)
    if time<0.5 then
    loop
    exitwhen i>=11
    set x2=x1+600*Cos((a*bj_RADTODEG+GetRandomReal(28,40)*i)*bj_DEGTORAD)
    set y2=y1+600*Sin((a*bj_RADTODEG+GetRandomReal(28,40)*i)*bj_DEGTORAD)
    set n=CreateUnit(p,'or07',x2,y2,Atan2(y1-y2,x1-x2)*bj_RADTODEG)
    set sc=GetRandomReal(0.6,0.8)
    call SetUnitScale(n,sc,sc,sc)
    call IssuePointOrder(n,"move",x1,y1)
    call SetUnitVertexColor(n,255,255,255,0)
    call SaveInteger(h,GetHandleId(n),0,0)
    call SetUnitMoveSpeed(n,400+200*time)
    call UnitApplyTimedLife(n,'BTLF',1.8)
    call GroupAddUnit(g,n)
    set i=i+1
    endloop
    else
    call SaveBoolean(h,id,6,false)
    call ShowUnit(u,true)
    if p==GetLocalPlayer()then
    call ClearSelection()
    call SelectUnit(u,true)
    endif
    call SetUnitX(u,x1)
    call SetUnitY(u,y1)
    set n=CreateUnit(p,'or08',x1,y1,a*bj_RADTODEG)
    call SetUnitTimeScale(n,0.5)
