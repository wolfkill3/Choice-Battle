function GroupAliveUnit takes group g returns unit
local group g2
set g2=CopyGroup(g)
loop
set E=FirstOfGroup(g2)
exitwhen E==null
if UnitIsAlive(E)then
set EAlive=E
endif
call GroupRemoveUnit(g2,E)
endloop
call DestroyGroupTimed(g2,3)
set g2=null
return EAlive
endfunction
function GroupAlive takes group g returns integer
local integer b=0
local group g2
set g2=CopyGroup(g)
loop
set E=FirstOfGroup(g2)
exitwhen E==null
if UnitIsAlive(E)then
set b=b+1
endif
call GroupRemoveUnit(g2,E)
endloop
call DestroyGroup(g2)
set g2=null
return b
endfunction
function GroupIsDeath takes group g returns boolean
local boolean b=true
local group g2
set g2=CopyGroup(g)
loop
set E=FirstOfGroup(g2)
exitwhen E==null
if UnitIsAlive(E)then
set b=false
endif
call GroupRemoveUnit(g2,E)
endloop
call DestroyGroupTimed(g2,3)
set g2=null
return b
endfunction
function GetRandomUnitFromGroup2 takes group g returns unit
local integer i=GetRandomInt(1,CountUnitsInGroup(g))
local integer r
local group g2
set g2=CopyGroup(g)
set r=1
loop
set E=FirstOfGroup(g2)
exitwhen E==null and IsUnitType(E,UNIT_TYPE_DEAD)==false
if r==i then
set n10=E
endif
set r=r+1
call GroupRemoveUnit(g2,E)
endloop
call DestroyGroupTimed(g2,3)
set g2=null
return n10
endfunction
function GetRandomUnitFromGroup takes group g returns unit
