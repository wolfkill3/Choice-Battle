function CastBenihiko2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local group g=LoadGroupHandle(h,id,1)
local real dmg=(GetUnitAbilityLevel(u,'A0J8')*0.05+0.65)*GetHeroAgi(u,true)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
loop
set E=FirstOfGroup(g)
exitwhen E==null
call Slash_Benihiko(E,45,dmg,GetUnitFacing(E)*bj_DEGTORAD,1200,55)
call GroupRemoveUnit(g,E)
endloop
call DestroyGroup(g)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
set u=null
set g=null
set t=null
endfunction
function CastBenihiko takes nothing returns nothing
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x=GetSpellTargetX()
local real y=GetSpellTargetY()
local real x1=0
local real y1=0
local real x2=GetUnitX(u)
local real y2=GetUnitY(u)
local real r=0
local real f=GetUnitFacing(u)-90
local real a=Atan2(y-y2,x-x2)*bj_RADTODEG-90
local integer i=0
local group g=CreateGroup()
loop
exitwhen i>=30
set r=(a+6*i)*bj_DEGTORAD
set x1=x2+50*Cos(r)
set y1=y2+50*Sin(r)
set n=CreateUnit(p,0x65304532,x1,y1,r*bj_RADTODEG)
call GroupAddUnit(g,n)
set i=i+1
endloop
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Benihiko.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call SaveUnitHandle(h,id,0,u)
call SaveGroupHandle(h,id,1,g)
call TimerStart(t,0.5,false,function CastBenihiko2)
set g=null
set t=null
set p=null
set u=null
endfunction
