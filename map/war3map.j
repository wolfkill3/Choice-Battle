return GetSpellAbilityId()=='A0PZ' and udg_B==true
endfunction
function IllusionBenizkuraStrikeCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit c=LoadUnitHandle(h,id,100)
local group g=LoadGroupHandle(h,id,60)
local group gn=LoadGroupHandle(h,id,61)
local integer i=0
local real x=LoadReal(h,id,50)
local real y=LoadReal(h,id,51)
local real x1=0
local real y1=0
local real x2=GetUnitX(c)
local real y2=GetUnitY(c)
local real dist
local real dist1=LoadReal(h,id,20)
local real B3=0
local real dmg=GetHeroAgi(u,true)*12
local integer l__idg=GetHandleId(g)
local player p=GetOwningPlayer(u)
local real Dd=GetUnitState(c,UNIT_STATE_MAX_LIFE)
call SaveReal(h,id,20,dist1+25)
if dist1<=800 then
call PauseUnit(c,true)
loop
set i=i+1
exitwhen i>6
set n=LoadUnitHandle(h,id,1+i)
set B3=(GetUnitFacing(n)+7.5)*bj_DEGTORAD
set dist=LoadReal(h,id,StringHash("dist"+I2S(i)))+25
call SaveReal(h,id,StringHash("Dist"+I2S(i)),dist)
set x1=x+dist*Cos(B3)
set y1=y+dist*Sin(B3)
call SetUnitFacing(n,B3*bj_RADTODEG)
call SetUnitX(n,x1)
call SetUnitY(n,y1)
endloop
endif
if dist1>=700 then
loop
set E=FirstOfGroup(gn)
exitwhen E==null
if GetUnitAbilityLevel(c,'A13O')<3 then
call MissleMoveKoykaSuigetsu(E,50,0,c,"Objects\\Spawnmodels\\Human\\Humannood\\noodElfSpellThiefnood.mdl",GetHeroAgi(u,true)*2,u)
elseif GetUnitAbilityLevel(c,'A13O')==3 then
call MissleMoveKoykaSuigetsu(E,50,0,c,"Objects\\Spawnmodels\\Human\\Humannood\\noodElfSpellThiefnood.mdl",GetHeroAgi(u,true)*2+Dd*(.03+.001*GetHeroLevel(u)),u)
call UnitRemoveAbility(c,'A13O')
call UnitRemoveAbility(c,'A13U')
endif
call GroupRemoveUnit(gn,E)
endloop
endif
if dist1>=1225 then
call UnitApplyTimedLife(CreateUnit(p,'e03V',x2,y2,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e03D',x2,y2,GetRandomReal(0,359)),'BTLF',1)
call UnitApplyTimedLife(CreateUnit(p,'e06F',x2,y2,GetRandomReal(0,359)),'BTLF',1)
call PauseUnit(c,false)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,false)
call PauseUnit(u,false)
call ShowUnit(u,true)
call SetUnitX(u,GetUnitX(c))
call SetUnitY(u,GetUnitY(c))
if GetLocalPlayer()==p then
call ClearSelection()
call SelectUnit(u,true)
endif
call FlushChildHashtable(h,id)
call FlushChildHashtable(h,l__idg)
call DestroyGroup(g)
call DestroyGroup(gn)
call DestroyTimer(t)
set gn=null
set c=null
set u=null
set g=null
set t=null
set p=null
endif
endfunction
function IllusionBenizkuraStrikeCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit c=GetSpellTargetUnit()
local real x=GetUnitX(c)
local real y=GetUnitY(c)
local real r=0.
local integer i=1
local group g=CreateGroup()
local player p=GetOwningPlayer(u)
loop
exitwhen i>6
set r=i*60.
if GetUnitTypeId(u)=='H03R' then
set n=CreateUnit(p,'e0OC',x,y,r)
else
set n=CreateUnit(p,'e10B',x,y,r)
endif
call SetUnitAnimation(n,"attack")
call UnitAddAbility(n,'A031')
call GroupAddUnit(g,n)
call SaveUnitHandle(h,id,1+i,n)
set i=i+1
endloop
call PauseUnit(c,true)
call SaveBoolean(HH,GetHandleId(c),TARGET_ABILITY,true)
call PauseUnit(u,true)
call ShowUnit(u,false)
call SaveUnitHandle(h,id,0,u)
call SaveUnitHandle(h,id,100,c)
call SaveGroupHandle(h,id,60,CreateGroup())
call SaveGroupHandle(h,id,61,g)
call SaveReal(h,id,50,x)
call SaveReal(h,id,51,y)
set n=CreateUnit(p,'e0OL',x,y,0)
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitTimeScale(n,2)
if GetUnitTypeId(u)!='H03R' then
set soundplay=SndN(1796) // Sound\Music\mp3Music\SaberSakura5.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
else
set soundplay=SndN(1798) // Sound\Music\mp3Music\YomuT.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
call TimerStart(t,.03,true,function IllusionBenizkuraStrikeCast2)
set u=null
set t=null
set c=null
set p=null
endfunction
