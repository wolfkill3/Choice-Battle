set n=CreateUnit(p,'edT5',GetUnitX(E),GetUnitY(E),a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,0.5)
call SetUnitTimeScale(n,1)
call SetUnitFlyHeight(n,GetUnitFlyHeight(E),0)
call SetUnitVertexColor(E,155,75,255,0)
call SetUnitX(E,x)
call SetUnitY(E,y)
call SetUnitFlyHeight(E,0,0)
call GroupRemoveUnit(g2,E)
endif
endloop
call DestroyGroupTimed(g2,3)
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
