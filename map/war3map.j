call SaveUnitHandle(h,id,1,u)
call SaveInteger(HH,GetHandleId(u),SH_cold3,0)
call SaveReal(h,id,0,GetWidgetMana(u))
call TimerStart(t,0.01,true,function FrozenMinusManaCast4)
set t=null
set u=null
endfunction
