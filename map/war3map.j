function SabracChoice_Cond takes nothing returns boolean
if GetSpellAbilityId()=='SaQ1' or GetSpellAbilityId()=='SaW1' or GetSpellAbilityId()=='SaW2' or GetSpellAbilityId()=='SaE1' or GetSpellAbilityId()=='SaE2' or GetSpellAbilityId()=='SaR1' or GetSpellAbilityId()=='SaR2' or GetSpellAbilityId()=='SaT1' or GetSpellAbilityId()=='SaT2' or GetSpellAbilityId()=='SaF1' or GetSpellAbilityId()=='SaG1' then
return true
else
return false
endif
endfunction

function InitTrig_SabracChoice takes nothing returns nothing
local trigger SabracChoice=CreateTrigger()
local integer index
set index=0
loop
call TriggerRegisterPlayerUnitEvent(SabracChoice,Player(index),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set index=index+1
exitwhen index==bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddCondition(SabracChoice,Condition(function SabracChoice_Cond))
call TriggerAddAction(SabracChoice,function SabracChoice_Act)
set SabracChoice=null
set index=0
endfunction















function SabracHeroSwordLife takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit caster=LoadUnitHandle(HH,id,1)
local unit Dummy=LoadUnitHandle(HH,id,20)
local real time=0
local integer swords=0
local integer HeroSwords=LoadInteger(HH,id,25)
//call SaveReal(HH,id,5,time)
if SR(GetUnitX(caster),GetUnitY(caster),GetUnitX(Dummy),GetUnitY(Dummy))<100 and udg_B==true then
set soundplay=CreateSound("Sound\\Music\\mp3Music\\SabracG_Sword"+I2S(GetRandomInt(1,4))+".mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
set swords=LoadInteger(HH,GetHandleId( (GetOwningPlayer( caster )) ),SabracSwordsHash)+HeroSwords
call SaveInteger(HH,GetHandleId( (GetOwningPlayer( caster )) ),SabracSwordsHash,swords)


call SetUnitBaseDamageByIndex(caster,0,GetHeroStr(caster,false)+swords*3)


//if(GetLocalPlayer()==GetOwningPlayer(caster))then
//call DisplayTextToPlayer(GetLocalPlayer(),0,0,"Swords take")
//endif

//if(GetLocalPlayer()==GetOwningPlayer(caster))then
//call DisplayTextToPlayer(GetLocalPlayer(),0,0,"Swords "+I2S(swords))
//endif

set time=1
endif
if time>=1 or udg_B==false or DU2==false or UnitIsAlive(caster)==false then
call RemoveUnit(Dummy)
call RemoveUnit(LoadUnitHandle(HH,id,21))
call PauseTimer(GetExpiredTimer())
call FlushChildHashtable(HH,id)
call DestroyTimer(GetExpiredTimer())
endif
set caster=null
set Dummy=null
endfunction
function Trig_SabracHeroDie_Actions takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local integer HeroSwords=1
local unit caster=sabrac
local unit target=GetTriggerUnit()
local real facing=GetUnitFacing(target)
call SaveReal(HH,id,3,facing)
call SaveUnitHandle(HH,id,1,caster)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(target),GetUnitY(target),facing)
call SetUnitModel(n0,"Sabrac\\file00006399.mdl")
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call UnitSize(n0,1.5,1,1)
call SetUnitFlyHeight(n0,20,0)
call SaveUnitHandle(HH,id,20,n0)
set n0=CreateUnit(GetOwningPlayer(caster),'e200',GetUnitX(target),GetUnitY(target),facing)
call UnitAddAbility(n0,'Amrf')
call UnitRemoveAbility(n0,'Amrf')
call UnitSize(n0,1.25,1,1)
call SetUnitFlyHeight(n0,20,0)
call SaveUnitHandle(HH,id,21,n0)
// 'H06M' - xex
//'H017' 'H06W' -shana 2
//'H02F' 'H05Y'-kirito 2
//'H03R' 'H064'-yomu 2

//'H00M'-zoro 3
//'H02Y' 'H02Z' -genkshi 4
//'H016'- yamamoto 5
//'HYuj'-yuji 5                'H049' 
//'H02X'-bee 7

if  GetUnitTypeId(target)=='H06M' or GetUnitTypeId(target)=='H017' or GetUnitTypeId(target)=='H06W' or  GetUnitTypeId(target)=='H02F' or  GetUnitTypeId(target)=='H05Y' or  GetUnitTypeId(target)=='H03R' or  GetUnitTypeId(target)=='H064' then
set HeroSwords=1
endif

if GetUnitTypeId(target)=='H00M' then
set HeroSwords=1
endif

if GetUnitTypeId(target)=='H02Y' or GetUnitTypeId(target)=='H02Z' then
set HeroSwords=1
endif


if GetUnitTypeId(target)=='HYuj' or GetUnitTypeId(target)=='H016' then
set HeroSwords=1
endif

if GetUnitTypeId(target)=='H02X' or GetUnitTypeId(target)=='H03I' then
set HeroSwords=1
endif
call SaveInteger(HH,id,25,HeroSwords)











if GetRandomInt(1,4)==1 then
call SetUnitModel(n0,"Sabrac\\file00001518.mdl")
else
if GetRandomInt(1,3)==1 then
call SetUnitModel(n0,"Sabrac\\file00001524.mdl")
else
if GetRandomInt(1,2)==1 then
call SetUnitModel(n0,"Sabrac\\file00001525.mdl")
else
call SetUnitModel(n0,"Sabrac\\file00001527.mdl")
endif
endif
endif
set n0=null
call TimerStart(t,0.02,true,function SabracHeroSwordLife)
set caster=null
set target=null
set t=null
endfunction
function SabracHeroDieCond takes nothing returns boolean
return   LoadBoolean(HH,GetHandleId( Hero[ GetPlayerId( GetOwningPlayer( GetTriggerUnit() )  )  ] ), StringHash("SabracKillme") ) ==false and GetOwningPlayer( GetTriggerUnit() )!= Player(14) and IsUnitIllusion( GetTriggerUnit() )==false and GetUnitAbilityLevel(GetTriggerUnit(),'A1EA')>0 and    sabrac!=GetKillingUnit() and  sabrac!=GetTriggerUnit() and IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO) and UnitIsAlive(sabrac) and GetUnitTypeId(GetTriggerUnit())!='HSaC' and GetUnitTypeId(GetTriggerUnit())!='HASC' and GetUnitTypeId(GetTriggerUnit())!='HAST'
endfunction
function InitTrig_SabracHeroDie takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function SabracHeroDieCond))
call TriggerAddAction(t,function Trig_SabracHeroDie_Actions)
set t=null
endfunction


