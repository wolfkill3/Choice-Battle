set g=null
set p=null
set t=null
endfunction
function RGilCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local real sc=0
local real is=0
local real ig=30*bj_DEGTORAD
local integer idu=GetHandleId(u)
local integer str=StringHash("gil1")
local integer st=LoadInteger(HH,idu,str)
if st+3<=(8+R2I(GetHeroLevel(u)/5))*2 then
call SaveInteger(HH,idu,str,st+3)
else
call SaveInteger(HH,idu,str,(8+R2I(GetHeroLevel(u)/5))*2)
endif
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,0)
call SaveReal(h,id,3,a)
call SaveReal(h,id,4,x1)
call SaveReal(h,id,5,y1)
call SaveReal(h,id,6,x)
call SaveReal(h,id,7,y)
call SaveGroupHandle(h,id,10,CreateGroup())
set n=CreateUnit(p,'e0RV',x,y,a*bj_RADTODEG)
