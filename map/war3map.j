local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,1)
local real x=LoadReal(h,id,2)
local real y=LoadReal(h,id,3)
local group g=LoadGroupHandle(h,id,5)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real x2
local real y2
local real f=GetUnitFacing(l__d)
local real a=LoadReal(h,id,5)
local real a2
local player p=GetOwningPlayer(u)
local real dmg=GetHeroInt(u,true)*GetUnitAbilityLevel(u,'A11N')*0.08
if SR(x,y,x1,y1)<=GetHeroAgi(u,true)*10+1000 then
call SetUnitX(l__d,x1+15*Cos(a))
call SetUnitY(l__d,y1+15*Sin(a))
call GroupEnumUnitsInRange(G,x1,y1,450,Base)
loop
set E=FirstOfGroup(G)
exitwhen E==null
if Condition_Base(p,E)then
set x2=GetUnitX(E)
set y2=GetUnitY(E)
set a2=Atan2(y2-y1,x2-x1)+1.4
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetUnitPosition(E,x2-58*Cos(a2),y2-58*Sin(a2))
call SetUnitFlyHeight(E,GetUnitFlyHeight(E)+2.6,0)
if IsUnitInGroup(E,g)==false then
call UnitAddAbility(E,'Arav')
call UnitRemoveAbility(E,'Arav')
call GroupAddUnit(g,E)
call SetUnitPathing(E,false)
endif
endif
call GroupRemoveUnit(G,E)
endloop
set n=CreateUnit(p,'e007',x1,y1,GetUnitFacing(u))
call UnitApplyTimedLife(n,'BTLF',0.5)
call SetUnitVertexColor(n,155,155,155,80)
call SetUnitScale(n,2,2,2)
else
loop
set E=FirstOfGroup(g)
exitwhen E==null
call SetUnitFlyHeight(E,0,GetUnitFlyHeight(E))
call GroupRemoveUnit(g,E)
call SetUnitPathing(E,true)
endloop
call FlushChildHashtable(h,id)
call DestroyTimer(t)
call DestroyGroup(g)
call RemoveUnit(l__d)
endif
set u=null
set p=null
set t=null
set g=null
set l__d=null
endfunction
