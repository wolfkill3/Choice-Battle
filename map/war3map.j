function Push_FrendaCombo2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit l__d=LoadUnitHandle(h,id,0)
local unit u=LoadUnitHandle(h,id,5)
local real speed=LoadReal(h,id,1)
local real a=LoadReal(h,id,2)
local real x=GetUnitX(l__d)
local real y=GetUnitY(l__d)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real dist=LoadReal(h,id,3)
local player p=GetOwningPlayer(u)
local real dmg=(3+GetUnitAbilityLevel(u,'A19S'))*GetHeroInt(u,true)
local group g=LoadGroupHandle(h,id,6)
if dist>0 and IsTerrainPathable(x,y,PATHING_TYPE_FLYABILITY)==false then
call SetUnitXY_1(l__d,x+speed*Cos(a),y+speed*Sin(a), false)
call SetUnitFacing(l__d,a*bj_RADTODEG)
call SaveReal(h,id,3,dist-speed)
call SaveReal(h,id,1,speed-speed*0.03)
call DestroyEffect(AddSpecialEffect(LoadStr(h,id,4),x,y))
else
call PauseUnit(l__d,false)
call SaveBoolean(HH,GetHandleId(l__d),TARGET_ABILITY,false)
call SetUnitInvulnerable(l__d,false)
call GroupEnumUnitsInRange(g,x,y,400,BaseFrenda)
loop
set E=FirstOfGroup(g)
exitwhen E==null
if(GetUnitTypeId(E)=='e0ZY' or GetUnitTypeId(E)=='e0ZV')and GetUnitAbilityLevel(E,'A1C3')==0 then
call UnitAddAbility(E,'A1C3')
call UnitApplyTimedLife(E,0,0.06)
endif
if Condition_Base(p,E) then 
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(u,E,1,"stun")
endif
call GroupRemoveUnit(g,E)
endloop
call UnitRemoveAbility(l__d,'A1US')
set n=CreateUnit(p,'eo9K',x,y,GetRandomReal(0,359))
call SetUnitScale(n,1,1,1)
call UnitApplyTimedLife(n,1,3)
set n=CreateUnit(p,'eo9L',x,y,GetRandomReal(0,359))
call SetUnitScale(n,1.5,1.5,1.5)
call UnitApplyTimedLife(n,1,3)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set p=null
set u=null
set g=null
set l__d=null
set t=null
endfunction
function Push_FrendaCombo takes unit l__d,real speed,real angle,real dist,string l__s,unit u returns nothing
