function LawMassiveRoomEnd takes nothing returns nothing
        local integer i = GetHandleId(GetExpiredTimer())
        local integer ic = GetHandleId(LoadUnitHandle(h, i, CasterHash))
        call SaveBoolean(h, ic, SH_MassiveRoomBoolean, false)
        call FlushChildHashtable(h, i)
        call DestroyTimer(GetExpiredTimer())
endfunction

function LawMassiveRoomActive takes unit newU, timer newT returns nothing
        local integer i  = GetHandleId(newT)
        local integer ic = GetHandleId(newU)
    call CreateModeIndicatorForm(newU, "ReplaceableTextures\\CommandButtons\\BTNLawR.blp", 10)
        call SaveBoolean(h, ic, SH_MassiveRoomBoolean, true)
        call SaveUnitHandle(h, i, CasterHash, newU)
        call TimerStart(newT, 10, false, function LawMassiveRoomEnd)
endfunction

function MassiveCutCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local integer i=1
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real dmg=(3+GetUnitAbilityLevel(u,'A0KA'))*GetHeroInt(u,true)
set n=CreateUnit(p,'e0FA',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitTimeScale(n,1)
set n=CreateUnit(p,0x65304643,x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',1)
call SetUnitTimeScale(n,2)
call UnitScale(n,0.1,10,1)
call CinematicFadeBJCustom(bj_CINEFADETYPE_FADEIN,1,"ReplaceableTextures\\CameraMasks\\White_mask.blp",155,155,255,0)
call GroupEnumUnitsInRange(DG,x,y,99999999,Base)
loop
set E=FirstOfGroup(DG)
exitwhen E==null
if Condition_Base(p,E)then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call DestroyEffect(AddSpecialEffect("war3mapImported\\BloodEX.mdx",GetUnitX(E),GetUnitY(E)))
call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\Rasengan6.mdx",E,"chest"))
endif
call GroupRemoveUnit(DG,E)
endloop
call SetUnitTimeScale(u,1)
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call LawMassiveRoomActive(u, CreateTimer())
call FlushChildHashtable(h,id)
call DestroyTimer(t)
set u=null
set p=null
set t=null
endfunction
function MassiveCutCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local integer loop_index = 0
call SaveUnitHandle(h,id,0,u)
call PauseUnit(u,true)
call SetUnitInvulnerable(u,true)
set n=CreateUnit(p,'e06G',GetUnitX(u),GetUnitY(u),GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3.4)
call SetUnitTimeScale(n,0.3)
set n=CreateUnit(p,'e0FB',GetUnitX(u),GetUnitY(u),GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3.4)
call SetUnitTimeScale(n,0.3)
call UnitScale(n,0.1,20,3.4)
set n=CreateUnit(p,'e0FD',GetUnitX(u),GetUnitY(u),GetRandomReal(0,359))
call UnitApplyTimedLife(n,'BTLF',3.4)
call UnitScale(n,0.1,20,3.4)
call SetUnitTimeScale(u,0.05)
        set n=CreateUnit(p,'dH37',GetUnitX(u),GetUnitY(u),GetRandomReal(0,359))
        call SetUnitScale(n, 3.2, 3.2, 3.2)
        call SetUnitFlyHeight(n, 20, 0)
        call MyRemoveUnit(n, 1.5)
        loop
        exitwhen loop_index==12
                set bjLCU = CreateUnit(GetOwningPlayer(u), 'e007', GetUnitX(u),GetUnitY(u), GetRandomInt(0, 360))
                call SetUnitFlyHeight(bjLCU, 20, 0)
                call SetUnitScale(bjLCU, 0.5+I2R(loop_index)*0.55, 0.5+I2R(loop_index)*0.55, 0.5+I2R(loop_index)*0.55)
                call SetUnitVertexColor(bjLCU, 255, 255, 255, 110)
                call SetUnitTimeScale(bjLCU, 0.9)
                call SetUnitAnimationByIndex(bjLCU, 0)
                call MyRemoveUnit(bjLCU, 1)
                set loop_index = loop_index + 1
        endloop
set soundplay=SndN(1435) // Sound\Music\mp3Music\LawMassiveCut.mp3
if GetLocalPlayer()==p then
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
endif
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call TimerStart(t,3.6,false,function MassiveCutCast2)
set u=null
set t=null
set p=null
endfunction
