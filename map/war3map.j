call SaveReal(h,id,2,angle)
call SaveReal(h,id,3,dist)
call SaveStr(h,id,4,l__s)
call SaveUnitHandle(h,id,5,u)
call SaveGroupHandle(h,id,6,CreateGroup())
call TimerStart(t,0.03,true,function Push_FrendaCombo2)
set t=null
endfunction
