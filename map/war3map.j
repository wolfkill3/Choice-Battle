call SaveReal(h,id,4,time+0.05)
endif
else
call UnitMakeAbilityPermanent(u,false,'A0PC')
call UnitRemoveAbility(u,'A0PC')
call PauseUnit(u,false)
call SetUnitTimeScale(u,1)
call SaveReal(h,idu,StringHash("nell"),10.0)
