local timer t=CreateTimer()
local integer id=GetHandleId(t)
local real x0
local real y0
local real x1
local real y1
local real facing
local unit caster
set caster=GetTriggerUnit()
set x0=GetUnitX(caster)
set y0=GetUnitY(caster)
set x1=GetSpellTargetX()
set y1=GetSpellTargetY()
set facing=Angle2(x0,y0,x1,y1)
call SaveUnitHandle(HH,id,1,caster)
call SaveReal(HH,id,11,x1)
call SaveReal(HH,id,12,y1)
call SaveReal(HH,id,3,facing)
if GetSpellAbilityId()=='XanE' then
call UnitCreateAndMove(caster,0x78613033,caster,GetRandomReal(0,360),1.5,1.25,1,100,100,100,60,0,caster,0,facing)
call UnitAddAbility(caster,'Amrf')
call UnitRemoveAbility(caster,'Amrf')
if SR(x0,y0,x1,y1)>600 then
call SaveReal(HH,id,8,0.2*SR(x0,y0,x1,y1)/30)
else
call SaveReal(HH,id,8,SR(x0,y0,x1,y1)/30)
call MoveAoe1(x1,y1,caster,-600,facing)
endif
call SetUnitFlyHeight(caster,600,0)
call PauseUnit(caster,true)
call SetUnitInvulnerable(caster,true)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\XanxusGExp.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)




if LoadBoolean(HH,GetHandleId(caster),StringHash("XanFBuff"))==true then
call SaveBoolean(HH,GetHandleId(caster),StringHash("XanFBuff"),false)
call SaveReal(HH,id,15,(4+GetUnitAbilityLevel(caster,'XanE'))*GetHeroAgi(caster,true)+GetHeroAgi(caster,true)*(4+GetUnitAbilityLevel(caster,'XanE'))*GetUnitAbilityLevel(caster,'B05E')*0.3)
else
call SaveReal(HH,id,15,(3+GetUnitAbilityLevel(caster,'XanE'))*GetHeroAgi(caster,true)+GetHeroAgi(caster,true)*(3+GetUnitAbilityLevel(caster,'XanE'))*GetUnitAbilityLevel(caster,'B05E')*0.3)
endif
call SaveEffectHandle(HH,id,23,AddSpecialEffectTarget("Other\\MeteorGlow.mdl",caster,"hand left"))
call SaveEffectHandle(HH,id,24,AddSpecialEffectTarget("Other\\MeteorGlow.mdl",caster,"hand right"))
call TimerStart(t,0.02,true,function XanxusEAct)
endif
if GetSpellAbilityId()=='XanF' then
call SetUnitAnimationByIndex(caster,1)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\XanxusF.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call SaveBoolean(HH,GetHandleId(caster),StringHash("XanFBuff"),true)
call SaveEffectHandle(HH,id,23,AddSpecialEffectTarget("other\\[A]supershinythingyGon.mdl",caster,"hand left"))
call SaveEffectHandle(HH,id,24,AddSpecialEffectTarget("other\\[A]supershinythingyGon.mdl",caster,"hand right"))
call TimerStart(t,0.02,true,function XanxusFAct)
endif
set t=null
set caster=null
endfunction
function XanxusChoice_Cond takes nothing returns boolean
if GetSpellAbilityId()=='XanE' or GetSpellAbilityId()=='XanF' then
return true
else
return false
endif
endfunction
function InitTrig_Xanxus takes nothing returns nothing
local trigger XanxusChoice=CreateTrigger()
local integer index
set index=0
loop
call TriggerRegisterPlayerUnitEvent(XanxusChoice,Player(index),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set index=index+1
exitwhen index==bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddCondition(XanxusChoice,Condition(function XanxusChoice_Cond))
call TriggerAddAction(XanxusChoice,function XanxusChoice_Act)
set XanxusChoice=null
set index=0
endfunction





