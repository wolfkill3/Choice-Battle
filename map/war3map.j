function ByakuranFMove takes nothing returns nothing
local integer id=GetHandleId(GetExpiredTimer())
local unit u=LoadUnitHandle(h,id,1)
local real a=LoadReal(h,id,3)
local integer i=LoadInteger(h,id,5)
local integer i1=LoadInteger(h,id,6)
local unit c=LoadUnitHandle(h,id,2)
local group gr=LoadGroupHandle(h,id,4)
local player p=GetOwningPlayer(u)
call SaveInteger(h,id,5,i+1)
if udg_B==false or DU2==false then
call SaveInteger(h,id,5,99999)
endif
if i==1 then
    set n=CreateUnit(GetOwningPlayer(u),'11GH',LoadReal(h, id, StringHash("PointX")),LoadReal(h, id, StringHash("PointY")),a*bj_RADTODEG)
    call UnitSize(n,1.5,1,1)
    // call MoveUnit(u,n,100,a*bj_RADTODEG)   
        call UnitAddAbility(n, 'Amrf')
        call UnitRemoveAbility(n, 'Amrf')
        call SetUnitInvulnerable(n, true)
    call SaveUnitHandle(h,id,2,n) 
    call SetUnitAnimationByIndex(n,1)
    call SaveGroupHandle(h,id,4,CreateGroup())
    call SaveEffectHandle(h,id,21,AddSpecialEffectTarget("GhostLighthin3.mdl",n,"chest"))
    call SaveEffectHandle(h,id,22,AddSpecialEffectTarget("GhostLighthin.mdl",n,"head"))
    set n=CreateUnit(GetOwningPlayer(u),'12GH',GetUnitX(u),GetUnitY(u),a)
    call UnitSize(n,2,1,1)
    call SaveUnitHandle(h,id,18,n) 
    call SetUnitFlyHeight(n,150,0)
    set n=CreateUnit(GetOwningPlayer(u),'13GH',GetUnitX(u),GetUnitY(u),a)
    call UnitSize(n,1,1,1)
    call SaveUnitHandle(h,id,19,n) 
    call SaveReal(h,GetHandleId(u),StringHash("ByakuranGhost"),0)
    call SaveReal(h,GetHandleId(u),StringHash("ByakuranGhost2"),0)
endif
  if i>1 and i<300+GetUnitAbilityLevel(u,'BGaR')*50 and udg_B and DU2 then
        call SetUnitInvulnerable(c, true)
    call MoveUnit(c,c,5,GetUnitFacing(c))
    call MoveUnit(c,LoadUnitHandle(h,id,18),0,GetUnitFacing(c))
    call MoveUnit(c,LoadUnitHandle(h,id,19),0,GetUnitFacing(c))
    set i1=i1+1
    if i1==25 then
        set i1=0
        call UnitCreateAndMove(u,'suT2',c,a,1,0.7,0.35,0,100,0,30,0,c,0,a)
    endif
    call SaveInteger(h,id,6,i1)
    call GroupEnumUnitsInRange(G,GetUnitX(c),GetUnitY(c),600,Base)
    loop
    set E = FirstOfGroup(G)
    exitwhen  E == null
    if IsUnitInGroup(E,gr)==false and Condition_Base(p,E) and UnitIsAlive(E) == true then
    call GroupAddUnit(gr,E)
    call ByakuranGhost(u,c,E,gr)
    endif
    call GroupRemoveUnit(G,E)
    endloop
    call GroupClear(G)
    call SaveGroupHandle(h,id,4,gr)
    set c=null
    set gr=null
    endif
    if i>=300+GetUnitAbilityLevel(u,'BGaR')*50 or udg_B==false or DU2==false then
    call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)+LoadReal(h,GetHandleId(u),StringHash("ByakuranGhost")))
    call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_LIFE)+LoadReal(h,GetHandleId(u),StringHash("ByakuranGhost2")))
    call RemoveSavedHandle(h,GetHandleId(u),StringHash("ByakuranGhost"))
    call RemoveSavedHandle(h,GetHandleId(u),StringHash("ByakuranGhost2"))
    call DestroyEffect(LoadEffectHandle(h,id,21))
    call DestroyEffect(LoadEffectHandle(h,id,22))
    call RemoveUnit(LoadUnitHandle(h,id,2))
    call RemoveUnit(LoadUnitHandle(h,id,18))
    call RemoveUnit(LoadUnitHandle(h,id,19))
    call DestroyGroup(LoadGroupHandle(h,id,4))
    call PauseTimer(GetExpiredTimer())
    call FlushChildHashtable(h,id)
    call DestroyTimer(GetExpiredTimer())        
    endif
set u=null
endfunction
