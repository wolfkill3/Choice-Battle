function LaxusD_Act2_Periodic takes nothing returns nothing
	local integer id = GetHandleId(GetExpiredTimer())
    local unit caster = LoadUnitHandle(h, id, CasterHash)
    local unit target = LoadUnitHandle(h, id, TargetHash)
	local real angle = LoadReal(h, id, AngleHash)
	local real time = LoadReal(h, id, TIME_HASH)
	local real damage = 150 + GetHeroStr(caster, true)*(GetUnitAbilityLevel(caster, 'LaxD')+2)
	local integer loop_index = 1
	if time<1 then
		call SaveReal(h, id, TIME_HASH, time+0.01)
		call SetUnitX(target, GetUnitX(target)+10*Cos(angle))
		call SetUnitY(target, GetUnitY(target)+10*Sin(angle))
		call SetUnitX(caster, GetUnitX(target)-60*Cos(angle))
		call SetUnitY(caster, GetUnitY(target)-60*Sin(angle))
		if time==0.6 then
			call UnitAddAbility(caster, 'Arav')
			call UnitRemoveAbility(caster, 'Arav')
			call SetUnitFlyHeight(caster, 600, 3000)
		endif
		if time==0.85 then
			call SetUnitFlyHeight(caster, 0, 3000)
			call SetUnitAnimationByIndex(caster, 8)
		endif
		if LoadInteger(h, id, EffectPeriodHash)==0 then
			set n=CreateUnit(GetOwningPlayer(caster),'e0QG',GetUnitX(caster), GetUnitY(caster),GetRandomReal(0,359))
			call UnitApplyTimedLife(n,1,0.01)
			call SetUnitScale(n,0.75,0.75,0.75)
			call SetUnitVertexColor(n,255,255,255,25)
			call MyRemoveUnit(n, 1)
			set n=CreateUnit(GetOwningPlayer(caster),'e0QG',GetUnitX(caster), GetUnitY(caster),GetRandomReal(0,359))
			call UnitApplyTimedLife(n,1,0.01)
			call SetUnitScale(n,1.2,1.2,1.2)
			call SetUnitVertexColor(n,255,255,255,50)
			call MyRemoveUnit(n, 1)
			set n=CreateUnit(GetOwningPlayer(caster),'e0QH',GetUnitX(caster), GetUnitY(caster),GetRandomReal(0,359))
			call UnitApplyTimedLife(n,1,0.5)
			call SetUnitScale(n,1.2,1.2,1.2)
			call SetUnitFlyHeight(n,75,0)
			call MyRemoveUnit(n, 1)
			set n=CreateUnit(GetOwningPlayer(caster),'dR45',GetUnitX(caster), GetUnitY(caster),GetRandomReal(0,359))
			call SetUnitScale(n, 0.7, 0.7, 0.7)
			call MyRemoveUnit(n, 1.5)
			if GetRandomInt(0, 4)==0 then
				set n=CreateUnit(GetOwningPlayer(caster),'d054',GetUnitX(caster)+GetRandomInt(-200, 200), GetUnitY(caster)+GetRandomInt(-200, 200),GetRandomReal(0,359))
				call SetUnitScale(n, 0.5, 0.5, 0.5)
				call UnitApplyTimedLife(n, 1, 0.3)
				call MyRemoveUnit(n, 1.5)
			endif
			call SaveInteger(h, id, EffectPeriodHash, 2)
		else
			call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash)-1)
		endif
	else
		call SetUnitTimeScale(caster, 1)
		call ShakeCamera(0.2, 15)
		// set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dAl2', GetUnitX(target) + 50 * Cos(angle), GetUnitY(target) + 50 * Sin(angle), angle * bj_RADTODEG)
		// call SetUnitModel(bjLCU , "white-qiquan-new.mdl")
		// call SetUnitFlyHeight(bjLCU, 160, 0)
		// call SetUnitScale(bjLCU, 1.2, 1.2, 1.2)
		// call MyRemoveUnit(bjLCU , 1.5)
		loop
		exitwhen loop_index==3
			set bjLCU=CreateUnit(GetOwningPlayer(caster), 'e0QG', GetUnitX(target) + 50 * Cos(angle), GetUnitY(target) + 50 * Sin(angle), angle * bj_RADTODEG)
			call SetUnitScale(bjLCU, 1.0+loop_index/1.5, 1.0+loop_index/1.5, 1.0+loop_index/1.5)
			call UnitApplyTimedLife(bjLCU,1,0.05)
			call SetUnitTimeScale(bjLCU, 0.90)
			call SetUnitFlyHeight(bjLCU, 50, 0)
			call SetUnitVertexColor(bjLCU,255,255,255,50)
			call MyRemoveUnit(bjLCU, 1.5)
			set bjLCU=CreateUnit(GetOwningPlayer(caster), 'e0QI', GetUnitX(target) + 50 * Cos(angle), GetUnitY(target) + 50 * Sin(angle), angle * bj_RADTODEG)
			call SetUnitScale(bjLCU, 0.6+loop_index/1.5, 0.6+loop_index/1.5, 0.6+loop_index/1.5)
			call UnitApplyTimedLife(bjLCU,1,0.05)
			call SetUnitTimeScale(bjLCU, 0.90)
			call SetUnitFlyHeight(bjLCU, 50, 0)
			call SetUnitVertexColor(bjLCU,255,255,255,50)
			call MyRemoveUnit(bjLCU, 1.5)
		set loop_index = loop_index + 1
		endloop
		set bjLCU=CreateUnit(GetOwningPlayer(caster), 'e0QH', GetUnitX(target) + 50 * Cos(angle), GetUnitY(target) + 50 * Sin(angle), angle * bj_RADTODEG)
		call SetUnitScale(bjLCU, 2.2, 2.2, 2.2)
		call UnitApplyTimedLife(bjLCU,1,0.1)
		call SetUnitVertexColor(bjLCU,255,255,255,50)
		call MyRemoveUnit(bjLCU, 1.5)
		
		set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH21', GetUnitX(target), GetUnitY(target), angle * bj_RADTODEG)
		call SetUnitScale(bjLCU, 1.35, 1.35, 1.35)
		call SetUnitFlyHeight(bjLCU, 75, 0)
		call MyRemoveUnit(bjLCU, 1.5)
		set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH02', GetUnitX(target), GetUnitY(target), angle * bj_RADTODEG)
		call SetUnitFlyHeight(bjLCU, 75, 0)
		call MyRemoveUnit(bjLCU, 1.5)
		set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dR37', GetUnitX(target), GetUnitY(target), angle * bj_RADTODEG)
		call SetUnitFlyHeight(bjLCU, 75, 0)
		call SetUnitScale(bjLCU, 2, 2, 2)
		call MyRemoveUnit(bjLCU, 1.5)
		set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH02', GetUnitX(target), GetUnitY(target), angle * bj_RADTODEG)
		call SetUnitFlyHeight(bjLCU, 75, 0)
		call SetUnitScale(bjLCU, 3, 3, 3)
		call MyRemoveUnit(bjLCU, 1.5)
		set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH22', GetUnitX(target), GetUnitY(target), angle * bj_RADTODEG)
		call SetUnitFlyHeight(bjLCU, 50, 0)
		call SetUnitScale(bjLCU, 1.5, 1.5, 1.5)
		call MyRemoveUnit(bjLCU, 1.5)
		set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH23', GetUnitX(target), GetUnitY(target), angle * bj_RADTODEG)
		call SetUnitFlyHeight(bjLCU, 75, 0)
		call SetUnitScale(bjLCU, 1.6, 1.6, 1.6)
		call MyRemoveUnit(bjLCU, 1.5)
		set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH24', GetUnitX(target), GetUnitY(target), angle * bj_RADTODEG)
		call SetUnitFlyHeight(bjLCU, 25, 0)
		call SetUnitScale(bjLCU, 3.1, 3.1, 3.1)
		call SetUnitTimeScale(bjLCU, 0.85)
		call MyRemoveUnit(bjLCU, 1.5)
		set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH25', GetUnitX(target), GetUnitY(target), angle * bj_RADTODEG)
		call SetUnitFlyHeight(bjLCU, 75, 0)
		call SetUnitScale(bjLCU, 1.1, 1.1, 1.1)
		call SetUnitTimeScale(bjLCU, 0.85)
		call MyRemoveUnit(bjLCU, 1.5)
		set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH26', GetUnitX(target), GetUnitY(target), angle * bj_RADTODEG)
		call SetUnitFlyHeight(bjLCU, 75, 0)
		call SetUnitScale(bjLCU, 2.5, 2.5, 2.5)
		call SetUnitTimeScale(bjLCU, 0.85)
		call MyRemoveUnit(bjLCU, 1.5)
		set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH13', GetUnitX(target), GetUnitY(target), angle * bj_RADTODEG)
		call SetUnitScale(bjLCU, 1.65, 1.65, 1.65)
		call SetUnitVertexColor(bjLCU, 255, 255, 255, 150)
		call UnitApplyTimedLife(bjLCU, 1, 0.6)
		call MyRemoveUnit(bjLCU, 1.5)
		set bjLCU=CreateUnit(GetOwningPlayer(caster), 'd054', GetUnitX(target)+GetRandomInt(-300, 300), GetUnitY(target)+GetRandomInt(-300, 300), angle * bj_RADTODEG)
		call SetUnitScale(bjLCU, 1.1, 1.1, 1.1)
		call UnitApplyTimedLife(bjLCU, 1, 0.9)
		call SetUnitFlyHeight(bjLCU, 25, 0)
		call MyRemoveUnit(bjLCU, 1.5)
		set bjLCU=CreateUnit(GetOwningPlayer(caster), 'd054', GetUnitX(target)+GetRandomInt(-300, 300), GetUnitY(target)+GetRandomInt(-300, 300), angle * bj_RADTODEG)
		call SetUnitScale(bjLCU, 1.1, 1.1, 1.1)
		call SetUnitFlyHeight(bjLCU, 25, 0)
		call UnitApplyTimedLife(bjLCU, 1, 0.8)
		call MyRemoveUnit(bjLCU, 1.5)
		set bjLCU=CreateUnit(GetOwningPlayer(caster), 'd054', GetUnitX(target)+GetRandomInt(-300, 300), GetUnitY(target)+GetRandomInt(-300, 300), angle * bj_RADTODEG)
		call SetUnitScale(bjLCU, 1.1, 1.1, 1.1)
		call SetUnitFlyHeight(bjLCU, 25, 0)
		call UnitApplyTimedLife(bjLCU, 1, 0.8)
		call MyRemoveUnit(bjLCU, 1.5)
		
		call SetUnitInvulnerable(caster, false)
		call PauseUnit(caster, false)
		call SetUnitFlyHeight(caster, 0, 0)
		call SetUnitInvulnerable(target, false)
		call PauseUnit(target,false)
        call SaveBoolean(HH,GetHandleId(target),TARGET_ABILITY,false)
		call myCustomDamage(caster, target, damage, false , false , null , null , null)
		call SetControlToUnit(caster, target, 1, "silenceTE")
		// call Push(caster, 60, angle-180*bj_DEGTORAD, 750)
		// call Push(target, 60, angle, 350)
		call IssueImmediateOrder(caster, "stop")
		call FlushChildHashtable(h, id)
		call DestroyTimer(GetExpiredTimer())
	endif
    set caster = null
    set target = null
endfunction

function LaxusD_Periodic takes nothing returns nothing
	local integer id = GetHandleId(GetExpiredTimer())
    local unit caster   = LoadUnitHandle(h, id, CasterHash)
	local real distance = LoadReal(h, id, StringHash("Distance"))
	local real caster_x = GetUnitX(caster)
	local real caster_y = GetUnitY(caster)
	local real angle = LoadReal(h, id, AngleHash)
	if distance<1000 then
		call SetUnitX(caster, caster_x+35*Cos(angle))
		call SetUnitY(caster, caster_y+35*Sin(angle))
		call SaveReal(h, id, StringHash("Distance"), distance+35)
		if LoadInteger(h, id, EffectPeriodHash)<=0 then
			set bjLCU = CreateUnit(GetOwningPlayer(caster), 'dH17', caster_x, caster_y, angle*bj_RADTODEG)
			call SetUnitVertexColor(bjLCU, 255, 255, 255, 85)
			call SetUnitAnimationByIndex(bjLCU, 6)
			call SetUnitTimeScale(bjLCU, 2)
			call MyRemoveUnit(bjLCU, 0.11)
			set bjLCU = CreateUnit(GetOwningPlayer(caster), 'dR45', caster_x, caster_y, angle*bj_RADTODEG)
			call SetUnitScale(bjLCU, 0.7, 0.7, 0.7)
			call MyRemoveUnit(bjLCU, 1)
			call SaveInteger(h, id, EffectPeriodHash, 1)
		else
			call SaveInteger(h, id, EffectPeriodHash, LoadInteger(h, id, EffectPeriodHash)-1)
		endif
		set bjLCG = LoadGroupHandle(h, id, GroupHash)
		call GroupEnumUnitsInRange(bjLCG, caster_x, caster_y, 125, Base)
		loop
		set bjLCU = FirstOfGroup(bjLCG)
		exitwhen bjLCU==null
			if Condition_Base(GetOwningPlayer(caster), bjLCU) and IsUnitInvulnerable(bjLCU)==false then
				call SaveReal(h, id, StringHash("Distance"), 9999)
                if LoadBoolean(HH,GetHandleId(bjLCU),ANTITARGET_ABILITY)==false then
                    call SaveUnitHandle(h, id, TargetHash, bjLCU)
                else
                    call SaveBoolean(HH,GetHandleId(LoadUnitHandle(h, id, CasterHash)),DASH_USER,false)
                    call SaveUnitHandle(HH,GetHandleId(bjLCU),REVERSE_TARGET,LoadUnitHandle(h, id, CasterHash))
                endif
				call GroupClear(bjLCG)
			endif
			call GroupRemoveUnit(bjLCG, bjLCU)
		endloop
	else
		set n=CreateUnit(GetOwningPlayer(caster), 'd053', caster_x, caster_y, angle*bj_RADTODEG)
		call UnitApplyTimedLife(n, 1, 0.4)
		call MyRemoveUnit(n, 1.5)
		if LoadUnitHandle(h, id, TargetHash)==null then
			call SetUnitInvulnerable(caster, false)
			call PauseUnit(caster, false)
			call IssueImmediateOrder(caster, "stop")
			if GetUnitAbilityLevel(caster, 'LaxD')==5 then
				call StartAbilityCooldown(GetUnitAbility(caster, 'LaxD'), 12)
			endif
			set bjLCU=CreateUnit(GetOwningPlayer(caster), 'dH18', caster_x, caster_y, GetRandomInt(0, 360))
			call SetUnitScale(bjLCU, 0.85, 0.85, 0.85)
			call SetUnitVertexColor(bjLCU, 255, 255, 255, 300)
			call MyRemoveUnit(bjLCU, 1.5)
		else

			call SetUnitInvulnerable(LoadUnitHandle(h, id, TargetHash), true)
			call PauseUnit(LoadUnitHandle(h, id, TargetHash), true)
			call SaveBoolean(HH,GetHandleId(LoadUnitHandle(h, id, TargetHash)),TARGET_ABILITY,true)
			set bjLCU = CreateUnit(GetOwningPlayer(caster), 'dH01', caster_x+100*Cos(angle), caster_y+100*Sin(angle), angle*bj_RADTODEG)
			call SetUnitFlyHeight(bjLCU, 75, 0)
			call SetUnitScale(bjLCU, 1.75, 1.75, 1.75)
			call MyRemoveUnit(bjLCU, 2)
			set bjLCU = CreateUnit(GetOwningPlayer(caster), 'dH20', caster_x+100*Cos(angle), caster_y+100*Sin(angle), angle*bj_RADTODEG)
			call SetUnitFlyHeight(bjLCU, 75, 0)
			call SetUnitScale(bjLCU, 1.90, 1.90, 1.90)
			call SetUnitTimeScale(bjLCU, 2)
			call MyRemoveUnit(bjLCU, 2)
			set bjLCU = CreateUnit(GetOwningPlayer(caster), 'dH20', caster_x+100*Cos(angle), caster_y+100*Sin(angle), angle*bj_RADTODEG)
			call SetUnitFlyHeight(bjLCU, 75, 0)
			call SetUnitScale(bjLCU, 1.75, 1.75, 1.75)
			call SetUnitTimeScale(bjLCU, 2)
			call MyRemoveUnit(bjLCU, 2)
			set bjLCU = CreateUnit(GetOwningPlayer(caster), 'dR42', caster_x, caster_y, angle*bj_RADTODEG)
			call SetUnitFlyHeight(bjLCU, 100, 0)
			call SetUnitTimeScale(bjLCU, 0.65)
			call MyRemoveUnit(bjLCU, 1.5)
		
			set bjLCT = CreateTimer()
			call SaveReal(h, GetHandleId(bjLCT), AngleHash, angle)
			call SaveUnitHandle(h, GetHandleId(bjLCT), CasterHash, caster)
			call SaveUnitHandle(h, GetHandleId(bjLCT), TargetHash, LoadUnitHandle(h, id, TargetHash))
			call TimerStart(bjLCT, 0.01, true, function LaxusD_Act2_Periodic)
			set bjLCT = null
			set soundplay=CreateSound("Sound\\war3mapImported\\LaxusD_Target"+I2S(GetRandomInt(1,2))+".mp3", false, false, true, 12700, 12700, "")
			call StartSound(soundplay)
			call KillSoundWhenDone(soundplay)
		endif
		if GetUnitAbilityLevel(caster,'LAE1')>0 then
			call SetUnitVertexColor(caster,255,255,25,255)
		else
			call SetUnitVertexColor(caster,255,255,255,255)
		endif
		call SetUnitTimeScale(caster, 1)
		call DestroyGroup(LoadGroupHandle(h, id, GroupHash))
		call FlushChildHashtable(h, id)
		call DestroyTimer(GetExpiredTimer())
	endif
    set caster = null
endfunction

function LaxusD_Cast takes unit newCaster, real point_x, real point_y, timer newTimer returns nothing
        local integer id = GetHandleId(newTimer)
        local real caster_x = GetUnitX(newCaster)
        local real caster_y = GetUnitY(newCaster)
        local real angle = AtanPoint(caster_x, caster_y, point_x, point_y)
        call ShakeCamera(0.1, 5)
        set soundplay=CreateSound("Sound\\war3mapImported\\LaxusD_Voice"+I2S(GetRandomInt(1,3))+".mp3", false, false, true, 12700, 12700, "")
        call StartSound(soundplay)
        call KillSoundWhenDone(soundplay)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR64', GetUnitX(newCaster) + 50 * Cos(angle), GetUnitY(newCaster) + 50 * Sin(angle), angle * bj_RADTODEG)
        call SetUnitFlyHeight(bjLCU, 160, 0)
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dH19', GetUnitX(newCaster) + 50 * Cos(angle), GetUnitY(newCaster) + 50 * Sin(angle), angle * bj_RADTODEG)
        call SetUnitFlyHeight(bjLCU, 160, 0)
        call SetUnitScale(bjLCU, 0.75, 0.75, 0.75)
        call SetUnitVertexColor(bjLCU, 255, 255, 255, 140)
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dH18', GetUnitX(newCaster), GetUnitY(newCaster), angle * bj_RADTODEG)
        call SetUnitScale(bjLCU, 0.85, 0.85, 0.85)
        call SetUnitVertexColor(bjLCU, 255, 255, 255, 200)
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR88', GetUnitX(newCaster), GetUnitY(newCaster), angle * bj_RADTODEG)
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'dR42', GetUnitX(newCaster), GetUnitY(newCaster), angle * bj_RADTODEG)
        call SetUnitScale(bjLCU, 0.75, 0.75, 0.75)
        call SetUnitFlyHeight(bjLCU, 0.75, 0)
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'd053', GetUnitX(newCaster), GetUnitY(newCaster), angle * bj_RADTODEG+45)
        call UnitApplyTimedLife(bjLCU, 1, 0.4)
        call SetUnitFlyHeight(bjLCU, 50, 0)
        call MyRemoveUnit(bjLCU , 1.5)
        set bjLCU=CreateUnit(GetOwningPlayer(newCaster), 'd053', GetUnitX(newCaster), GetUnitY(newCaster), angle * bj_RADTODEG-45)
        call UnitApplyTimedLife(bjLCU, 1, 0.4)
        call SetUnitFlyHeight(bjLCU, 50, 0)
        call MyRemoveUnit(bjLCU , 1.5)
        if GetUnitAbilityLevel(newCaster,'LAE1')>0 then
                call SetUnitVertexColor(newCaster,255,255,25,100)
        else
                call SetUnitVertexColor(newCaster,255,255,255,100)
        endif
        call SetUnitInvulnerable(newCaster, true)
        call PauseUnit(newCaster, true)
        call SaveUnitHandle(h, id, CasterHash, newCaster)
        call SetUnitAnimationByIndex(newCaster, 6)
        call SetUnitTimeScale(newCaster, 1.75)
        call SaveReal(h, id, AngleHash, angle)
        call SaveGroupHandle(h, id, GroupHash, CreateGroup())
        call TimerStart(newTimer, 0.01, true, function LaxusD_Periodic)
endfunction

function LaxusRStopOrders2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
call IssueImmediateOrder(u,"stop")
call SetUnitFacing(u,Atan2(LoadReal(h,id,1)-GetUnitY(u),LoadReal(h,id,2)-GetUnitX(u))*bj_RADTODEG)
call FlushChildHashtable(h,id)
call DestroyTimer(t)
set t=null
set u=null
endfunction
function LaxusRStopOrders takes nothing returns nothing
local unit u=GetOrderedUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
call SaveUnitHandle(h,id,0,u)
if GetOrderTargetUnit()==null then
call SaveReal(h,id,2,GetOrderPointX())
call SaveReal(h,id,1,GetOrderPointY())
else
call SaveReal(h,id,2,GetUnitX(GetOrderTargetUnit()))
call SaveReal(h,id,1,GetUnitY(GetOrderTargetUnit()))
endif
//call SetUnitAnimation(u,"Spell Channel One")
call TimerStart(t,0.001,false,function LaxusRStopOrders2)
set u=null
set t=null
endfunction

function DragonRoarCond takes nothing returns boolean
return GetSpellAbilityId()=='A0SG' and udg_B==true
endfunction
function DragonRoarCast3 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real a=LoadReal(h,id,11)
local real dist=LoadReal(h,id,2)
local real x=GetUnitX(l__d)+45*Cos(a)
local real y=GetUnitY(l__d)+45*Sin(a)
local real x1=GetUnitX(u)
local real y1=GetUnitY(u)
local real dmg=LoadReal(h,id,4)
local player p=GetOwningPlayer(u)
local group g=LoadGroupHandle(h,id,12)
local real s1=LoadReal(h,id,13)
local real s2=LoadReal(h,id,10)
local real s3=LoadReal(h,id,14)
local real s4=LoadReal(h,id,15)
if dist>0 and RectContainsUnit(GetWorldBounds(),l__d)and UnitIsAlive(l__d)then
call SetUnitXY_1(l__d,x,y, false)
call SetUnitScale(l__d,s2,s2,s2)
call SaveReal(h,id,10,s2+0.09)
call SaveReal(h,id,13,s1+0.05)
call SaveReal(h,id,14,s3+5.45)
call SaveReal(h,id,15,s4+0.05)
set n=CreateUnit(p,'e0QG',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,255,255,255,75)
set n=CreateUnit(p,'e0QG',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitVertexColor(n,255,255,255,50)
set n=CreateUnit(p,'e0QG',x1,y1,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,2,2,2)
call SetUnitVertexColor(n,255,255,255,25)
set n=CreateUnit(p,'e0QO',x1,y1,GetRandomReal(0,359))
call SetUnitTimeScale(n,3)
call UnitApplyTimedLife(n,1,0.1)
set n=CreateUnit(p,0x6530535A,x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,2)
call SetUnitTimeScale(n,0.35)
call SetUnitAnimation(n,"death")
call SetUnitScale(n,s1,s1,s1)
set n=CreateUnit(p,'e0QH',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,2)
call SetUnitScale(n,s2,s2,s2)
set n=CreateUnit(p,0x65305430,x,y,a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,1)
call SetUnitScale(n,s4,s4,s4)
if GetRandomInt(0, 4)==0 then
        set n=CreateUnit(p,'d054',x,y,GetRandomInt(0, 360))
        call UnitApplyTimedLife(n,1,1.2)
        call SetUnitFlyHeight(n, 50, 0)
        call SetUnitScale(n,s4/2,s4/2,s4/2)
        call MyRemoveUnit(n, 2)
endif
call GroupEnumUnitsInRange(g,x,y,s3,Base)
set idg=GetHandleId(g)
call SaveReal(h,id,2,dist-45)
loop
set E=FirstOfGroup(g)
set ide=GetHandleId(E)
if Condition_Base(p,E)and LoadUnitHandle(h,idg,ide)!=E then
call myCustomDamage(u,E,dmg,false,false,null,null,null)
call SetControlToUnit(E,E, 2, "stun")
call SaveUnitHandle(h,idg,ide,E)
endif
call GroupRemoveUnit(g,E)
exitwhen E==null
endloop
else
call SetUnitTimeScale(u,1)
call RemoveUnit(l__d)
call FlushChildHashtable(h,GetHandleId(g))
call DestroyGroup(g)
call PauseTimer(t)
call DestroyTimer(t)
call FlushChildHashtable(h,id)
endif
set g=null
set u=null
set t=null
set l__d=null
set p=null
endfunction
function DragonRoarCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local unit l__d=LoadUnitHandle(h,id,7)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,5)
local real y1=LoadReal(h,id,6)
local real a=GetUnitFacing(u)*bj_DEGTORAD
local player p=GetOwningPlayer(u)
local real dmg=LoadReal(h,id,4)
local real dist=LoadReal(h,id,2)
local real scale=LoadReal(h,id,10)
local real tm=GetWidgetMana(u)
local real mana=GetUnitState(u,UNIT_STATE_MAX_MANA)*0.01
local real time=LoadReal(h,id,18)+0.1
local trigger tt=LoadTriggerHandle(h, id, 20)
call SaveReal(h,id,11,GetUnitFacing(u)*bj_DEGTORAD)
if time<=2 then
call SetControlToUnit(u, u, 0.11, "doom")
set n=CreateUnit(p,'e0QG',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,1,1,1)
call SetUnitVertexColor(n,255,255,255,75)
set n=CreateUnit(p,'e0QG',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,1.5,1.5,1.5)
call SetUnitVertexColor(n,255,255,255,50)
set n=CreateUnit(p,'e0QG',x,y,GetRandomReal(0,359))
call UnitApplyTimedLife(n,1,0.01)
call SetUnitScale(n,2,2,2)
call SetUnitVertexColor(n,255,255,255,25)
set n=CreateUnit(p,'e0QO',x,y,GetRandomReal(0,359))
call SetUnitTimeScale(n,3)
call UnitApplyTimedLife(n,1,0.1)
call SetUnitXY_1(l__d,x,y, false)
call SetUnitInvulnerable(u,true)
call SaveReal(h,id,18,time)
else
//call UnitRemoveAbility(u,'A0NP')
call SetUnitTimeScale(u,3)
call UnitRemoveAbility(u,'A1FU')
call UnitRemoveAbility(u,'Pet1')
call UnitRemoveAbility(u,'B00A')
call UnitRemoveAbility(u,'B02Z')
call SetUnitAcquireRange(u, 600)
call IssueImmediateOrder(u, "stop")
call RemoveUnit(l__d)
call SaveUnitHandle(h,id,7,CreateUnit(p,'e0QH',x+65*Cos(a),y+65*Sin(a),a*bj_RADTODEG))
set n=CreateUnit(p,0x65305359,x+75*Cos(a),y+75*Sin(a),a*bj_RADTODEG)
call UnitApplyTimedLife(n,1,1.5)
call SetUnitTimeScale(n,2)
call SetUnitInvulnerable(u,false)
call TriggerClearActions(tt)
call DestroyTrigger(tt)
call PauseTimer(t)
call TimerStart(t,0.02,true,function DragonRoarCast3)
endif
set l__d=null
set p=null
set u=null
set t=null
set tt=null
endfunction
function DragonRoarCast takes nothing returns nothing
local unit u=GetTriggerUnit()
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
local trigger tt=CreateTrigger()
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,5,x1)
call SaveReal(h,id,6,y1)
call SaveReal(h,id,4,(GetUnitAbilityLevel(u,'A0SG')+3)*GetHeroStr(u,true))
call SaveReal(h,id,2,2000)
call SaveReal(h,id,10,0.75)
call SaveReal(h,id,13,0.4)
call SaveReal(h,id,14,150)
call SaveReal(h,id,15,0.3)
call SaveReal(h,id,11,a)
call SaveReal(h,id,18,0)
call SetUnitTimeScale(u,0)
call SetUnitInvulnerable(u,true)
//call PauseUnit(u,true)
call SaveGroupHandle(h,id,12,CreateGroup())
call SetUnitAnimation(u,"spell two")
call SetUnitTimeScale(u,0.1)
set soundplay=CreateSound("Sound\\Music\\mp3Music\\Laxus Roar Fire.mp3",false,false,true,12700,12700,"")
call StartSound(soundplay)
call KillSoundWhenDone(soundplay)
call SaveUnitHandle(h,id,7,CreateUnit(p,'e0SX',x,y,a*bj_RADTODEG))
//call UnitAddAbility(u,'A0NP')
call UnitAddAbility(u,'A1FU') //Slow
call UnitAddAbility(u,'Pet1')
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_TARGET_ORDER)
call TriggerRegisterUnitEvent(tt,u,EVENT_UNIT_ISSUED_POINT_ORDER)
call SaveTriggerHandle(h, id, 20, tt)
call SetUnitAcquireRange(u, 51)
call TriggerAddAction(tt,function LaxusRStopOrders)
call TimerStart(t,0.1,true,function DragonRoarCast2)
set u=null
set p=null
set t=null
set tt=null
endfunction
