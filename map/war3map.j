    local unit c=LoadUnitHandle(h,id,1)
    local group g=LoadGroupHandle(h,id,2)
    local real time=LoadReal(h,id,3)
    call SaveReal(h,id,3,time+0.2)
    if time<2 then
    call AddSpecialEffectToAllBones(c,"Abilities\\Spells\\Other\\BlackArrow\\BlackArrowMissile.mdl")
    call ForGroup(g,function ForGroupOrochimaruECast)
    call SetUnitAnimation(c,"death")
    if LoadBoolean(h,id,9)==false then
    call PauseUnit(u,false)
    call SetUnitTimeScale(u,1)
    call SaveBoolean(h,id,9,true)
    endif
    else
    call SaveReal(h,id,3,0)
    call SaveReal(h,id,12,GetUnitState(c,UNIT_STATE_MANA))
    call ForGroup(g,function KillGroup)
    call UnitAddAbility(c,0x6f726531)
    call UnitMakeAbilityPermanent(c,true,0x6f726531)
    call GroupClear(g)
    call DestroyGroup(g)
    call PauseTimer(t)
    call TimerStart(t,0.05,true,function OrochimaruECast4)
    endif
    set g=null
    set c=null
    set u=null
    set t=null
endfunction
