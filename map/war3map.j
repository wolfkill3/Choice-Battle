call MoveUnit(LoadUnitHandle(HH,id,20),LoadUnitHandle(HH,id,21),0,facing)


if LoadUnitHandle(HH,GetHandleId(Dummy),StringHash("AizenTKillU"))!=null then
call AizenTPassiveAct(caster,LoadUnitHandle(HH,GetHandleId(Dummy),StringHash("AizenTKillU")),Dummy)
