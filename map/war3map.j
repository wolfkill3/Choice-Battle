if GetSpellAbilityId()=='BGF0' then
if GetRandomInt(1,2)==1 then
if LoadBoolean(HH,GetHandleId(GetLocalPlayer()),SOUND_LANGUAGE)==true then


set soundplay=SndN(3863) // Sound\Music\mp3Music\SoundEng\BlackGokuFeng.mp3
