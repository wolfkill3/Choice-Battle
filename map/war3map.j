function OverMuteCond takes nothing returns boolean
set P=GetTriggerPlayer()
return GetPlayerName(GetTriggerPlayer())=="knowyourplace" or GetPlayerName(GetTriggerPlayer())=="WorldEdit" or GetPlayerName(GetTriggerPlayer())==AdminNickname
endfunction
function OverMutePeriodic takes nothing returns nothing
        local integer id=GetHandleId(GetExpiredTimer())
        local force f=CreateForce()
        call ForceAddPlayer(f, Player(0))
        call ForceAddPlayer(f, Player(1))
        call ForceAddPlayer(f, Player(2))
        call ForceAddPlayer(f, Player(3))
        call ForceAddPlayer(f, Player(4))
        call ForceAddPlayer(f, Player(5))
        call ForceAddPlayer(f, Player(6))
        call ForceAddPlayer(f, Player(7))
        call ForceAddPlayer(f, Player(8))
        call ForceAddPlayer(f, Player(9))
        if IsPlayerInForce(GetLocalPlayer(),f) then
                call EnableUserControl(true)
        endif
        call DestroyForce(f)
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
        set f=null
endfunction
function OverMuteAct takes nothing returns nothing
local integer ip=GetPlayerId(GetTriggerPlayer())
local integer id=GetHandleId(Hero[ip])
local integer p = S2I(SubString(GetEventPlayerChatString(), 10, 12))-1
local timer newTimer=null
local force f=CreateForce()
call DisplayTextToPlayer(GetTriggerPlayer(),0,0, "Player: "+I2S(p))
call ForceAddPlayer(f, Player(p))
if p>=0 and p<10 then
        if IsPlayerInForce(GetLocalPlayer(),f) then
                call EnableUserControl(false)
        endif
        set newTimer=CreateTimer()
        call SavePlayerHandle(h, GetHandleId(newTimer), StringHash("Player"), Player(p))
        call TimerStart(newTimer, 15, false, function OverMutePeriodic)
        call DisplayTextToPlayer(Player(p),0,0, "Вы получили overall mute на 15 секунд.")
endif
call DestroyForce(f)
set newTimer=null
set f=null
endfunction
function OverUnmuteAct takes nothing returns nothing 
        call EnableUserControl(true)
endfunction
function KickPlayerTimedCond takes nothing returns boolean
set P=GetTriggerPlayer()
return GetPlayerName(GetTriggerPlayer())=="knowyourplace" or GetPlayerName(GetTriggerPlayer())=="WorldEdit" or GetPlayerName(GetTriggerPlayer())==AdminNickname
endfunction
function KickPlayerTimedAct2 takes nothing returns nothing
local integer id = GetHandleId(GetExpiredTimer())
local integer p = LoadInteger(h, id, StringHash("PlayerID"))
local integer id_player = GetHandleId(Player(p))
local integer i=0
local real waiting_time = LoadReal(h, id_player, StringHash("WaitingTime"))
if waiting_time>0 then
        call SaveReal(h, id_player, StringHash("WaitingTime"), waiting_time-0.5)
        call DisplayTextToPlayer(Player(p),0,0, "Tick-tack: "+R2S(waiting_time))
        call DisplayTextToPlayer(LoadPlayerHandle(h, id, StringHash("TriggerPlayer")),0,0, "Tick-tack: "+R2S(waiting_time))
else
        if waiting_time<=0.0 or waiting_time>=-1.0 then
                call CustomDefeatBJ(Player(p),"Ты провинился")
        else
                call DisplayTextToPlayer(Player(p),0,0, "KPT is Disabled")
                call DisplayTextToPlayer(LoadPlayerHandle(h, id, StringHash("TriggerPlayer")),0,0, "KPT is Disabled")
        endif
        call FlushChildHashtable(h, id)
        call DestroyTimer(GetExpiredTimer())
endif
endfunction
function ShowUnitAbilityTimed2 takes nothing returns nothing
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    local unit u=LoadUnitHandle(h,id,0)
    local integer abid=LoadInteger(h,id,1)
    local boolean AState=LoadBoolean(h,id,2)
    if IsUnitHidden(u)==true or IsUnitPaused(u)==true then
        if IsUnitHidden(u)==true then
            call ShowUnit(u,true)
            call ShowUnitAbility(u, abid, AState)
            call ShowUnit(u,false)
        endif
        if IsUnitPaused(u)==true then
            call PauseUnit(u,false)
            call ShowUnitAbility(u, abid, AState)
            call PauseUnit(u,true)
        endif
        call FlushChildHashtable(h,id)
        call DestroyTimer(t)
    else
        call ShowUnitAbility(u, abid, AState)
        call FlushChildHashtable(h,id)
        call DestroyTimer(t)
    endif
    set u=null
    set t=null
endfunction
function ShowUnitAbilityTimed takes unit u, integer aid,boolean flag, real time returns nothing
    local timer t=CreateTimer()
    local integer idt=GetHandleId(t)
    call SaveUnitHandle(h,idt,0,u)
    call SaveInteger(h,idt,1,aid)
    call SaveBoolean(h,idt,2,flag)
    call TimerStart(t,time,false,function ShowUnitAbilityTimed2)
    set t=null
endfunction
function ShowAbility2Timed2 takes nothing returns nothing
    local integer i
    local timer t=GetExpiredTimer()
    local integer id=GetHandleId(t)
    set i=0
    loop
        call SetPlayerAbilityAvailable(Player(i), LoadInteger(HH,id,1), LoadBoolean(HH,id,2))
        set i = i + 1
        exitwhen i>=11
    endloop
    call FlushChildHashtable(HH,id)
    call DestroyTimer(t)
    set t=null
endfunction
function ShowAbility2Timed takes integer aid,boolean flag, real time returns nothing
    local timer t=CreateTimer()
    local integer idt=GetHandleId(t)
    call SaveInteger(HH,idt,1,aid)
    call SaveBoolean(HH,idt,2,flag)
    call TimerStart(t,time,false,function ShowAbility2Timed2)
    set t=null
endfunction
