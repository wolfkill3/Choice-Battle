local unit l__d=LoadUnitHandle(h,id,1)
local real x2=LoadReal(h,id,2)
local real y2=LoadReal(h,id,3)
local real x1=GetUnitX(l__d)
local real y1=GetUnitY(l__d)
local real a=Atan2(y2-y1,x2-x1)
local real a2
local player p=GetOwningPlayer(u)
local lightning l=LoadLightningHandle(h,id,4)
local real dmg=GetHeroInt(u,true)*(1+GetUnitAbilityLevel(u,'A0JN'))+75
if SR(x1,y1,x2,y2)>26.00 then
set x1=x1+47*Cos(a)
set y1=y1+47*Sin(a)
call SetUnitXY_1(l__d,x1,y1, false)
call MoveLightningEx(l,true,GetUnitX(u),GetUnitY(u),GetUnitZCustom(u)+75,x1,y1,GetUnitZCustom(l__d))
else
call UnitApplyTimedLife(CreateUnit(p,0x65304554,x1,y1,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,0x65304553,x1,y1,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,0x65304552,x1,y1,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,0x65304551,x1,y1,0),'BTLF',3)
call UnitApplyTimedLife(CreateUnit(p,0x65304550,x1,y1,0),'BTLF',3)
