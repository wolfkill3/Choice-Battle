call SetUnitY(l__d,y+100*Sin(a))
call SetUnitAnimation(u,"Spell two")
call SetUnitScale(l__d,1.4,1.4,1.4)
call UnitRemoveAbility(u,'A1FU')
call UnitRemoveAbility(u,'Pet1')
