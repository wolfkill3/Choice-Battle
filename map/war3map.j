function QLiCast2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer id=GetHandleId(t)
local unit u=LoadUnitHandle(h,id,0)
local integer idu=GetHandleId(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=LoadReal(h,id,2)
local real y1=LoadReal(h,id,4)
local real x2=0
local real y2=0
local real dist=LoadReal(h,id,5)
local real a=LoadReal(h,id,3)
local integer i=0
local player p=GetOwningPlayer(u)
local player pl=GetLocalPlayer()
set n=CreateUnit(p,'e11J',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,155,75,255,155)
call UnitApplyTimedLife(n,'BTLF',0.5)
call SetUnitTimeScale(n,1)
if dist>1000 then
set x1=x+1000*Cos(a)
set y1=y+1000*Sin(a)
call SetUnitXY_1(u,x1,y1, false)
loop
exitwhen i>10
set x2=x+100*i*Cos(a)
set y2=y+100*i*Sin(a)
set n=CreateUnit(p,'e125',x2,y2,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,0)
if pl==p then
call SetUnitVertexColor(n,255,255,255,105)
endif
call UnitApplyTimedLife(n,'BTLF',0.05+0.01*i)
call SetUnitTimeScale(n,2)
set i=i+1
endloop
else
loop
exitwhen i*100>dist-100
set x2=x+100*i*Cos(a)
set y2=y+100*i*Sin(a)
set n=CreateUnit(p,'e125',x2,y2,a*bj_RADTODEG)
call SetUnitVertexColor(n,155,75,255,0)
if pl==p then
call SetUnitVertexColor(n,255,255,255,105)
endif
call UnitApplyTimedLife(n,'BTLF',0.05+0.012*i)
call SetUnitTimeScale(n,2)
set i=i+1
endloop
call SetUnitXY_1(u,x1,y1, false)
endif
set n=CreateUnit(p,'e11J',x1,y1,a*bj_RADTODEG)
call SetUnitVertexColor(n,155,75,255,0)
if GetLocalPlayer()==p then
call SetUnitVertexColor(n,155,75,255,155)
endif
call UnitApplyTimedLife(n,'BTLF',0.5)
call SetUnitTimeScale(n,1)
call SetUnitAnimation(u,"Walk")
call PauseUnit(u,false)
call SetUnitInvulnerable(u,false)
call UnitRemoveAbility(u,'A0A1')
call SetPlayerAbilityAvailable(p,0x4131434D,true)
call IssueImmediateOrder(u,"windwalk")
call PauseTimer(t)
call TimerStart(t,0.01,false,function QLiCast3)
set u=null
set pl=null
set p=null
set t=null
endfunction
function QLiCast takes nothing returns nothing
local timer t=CreateTimer()
local integer id=GetHandleId(t)
local unit u=GetTriggerUnit()
local integer idu=GetHandleId(u)
local player p=GetOwningPlayer(u)
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real x1=GetSpellTargetX()
local real y1=GetSpellTargetY()
local real a=Atan2(y1-y,x1-x)
call SaveUnitHandle(h,id,0,u)
call SaveReal(h,id,2,x1)
call SaveReal(h,id,4,y1)
call SaveReal(h,id,5,SR(x,y,x1,y1))
call SaveReal(h,id,3,a)
call SetUnitInvulnerable(u,true)
call PauseUnit(u,true)
call UnitAddAbility(u,'A0A1')
call SetUnitAnimation(u,"Walk")
call SetUnitTimeScale(n,2)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG-30)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG+30)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
set n=CreateUnit(p,'e0ZH',x,y,a*bj_RADTODEG)
call SetUnitVertexColor(n,255,255,255,155)
call UnitApplyTimedLife(n,'BTLF',0.4)
call SetUnitTimeScale(n,3)
if GetUnitAbilityLevel(u,0x4131434D)==0 then
call UnitAddAbility(u,0x4131434D)
call UnitMakeAbilityPermanent(u,true,0x4131434D)
call SetPlayerAbilityAvailable(p,0x4131434D,false)
endif
set soundplay=SndN(2683) // Sound\Music\mp3Music\ShuwenInvise.mp3
call StartSound(soundplay)
//call KillSoundWhenDone(soundplay) // звук из массива soundStr — не удалять
call SaveReal(HH,GetHandleId(u),SH_NoSecond,5)
call TimerStart(t,0.15,false,function QLiCast2)
set u=null
set p=null
set t=null
endfunction
